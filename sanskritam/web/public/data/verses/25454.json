[{"id": 7005454000, "chapter_id": 25454, "verse_number": "१-२४-१", "content_sanskrit": "सूत उवाच ।\nक्रोष्टोरेकोऽभवत् पुत्रो वज्रवानिति विश्रुतः ।\nतस्य पुत्रोऽभवतच्छान्तिः कुशिकस्तत्सुतोऽभवत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005454001, "chapter_id": 25454, "verse_number": "१-२४-२", "content_sanskrit": "उशद्‌गोरभवत् पुत्रो नाम्ना चित्ररथो बली ।\nअथ चैत्ररथिर्लोके शशबिन्दुरिति स्मृतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005454002, "chapter_id": 25454, "verse_number": "१-२४-३", "content_sanskrit": "तस्य पुत्रः पृथुयशा राजाऽभूद् धर्मतत्परः ।\nपृथुकर्मा च तत्पुत्रस्तस्मात् पृथुजयोऽभवत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005454003, "chapter_id": 25454, "verse_number": "१-२४-४", "content_sanskrit": "पृथुकीर्तिरभूत् तस्मात् पृथुदानस्ततोऽभवत् ।\nपृथुश्रवास्तस्य पुत्रस्तस्यासीत् पृथुसत्तमः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005454004, "chapter_id": 25454, "verse_number": "१-२४-५", "content_sanskrit": "उशनास्तस्य पुत्रोऽभूच्छतेषुस्तत्सुतोऽभवत् ।\nतस्याभूद् रुक्मकवचः परावृतश्च तत्सुतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005454005, "chapter_id": 25454, "verse_number": "१-२४-६", "content_sanskrit": "परावृतः सुतो जज्ञे यामघो लोकविश्रुतः ।\nतस्माद् विदर्भः संजज्ञे विदर्भात् क्रथकैशिकौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005454006, "chapter_id": 25454, "verse_number": "१-२४-७", "content_sanskrit": "रोमपादस्तृतीयस्तु बभ्रुस्तस्यात्मजो नृपः ।\nधृतिस्तस्याभवत् पुत्रः संन्तस्तस्याप्यभूत् सुतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005454007, "chapter_id": 25454, "verse_number": "१-२४-८", "content_sanskrit": "संन्तस्य पुत्रो बलवान् नाम्ना विश्वसहः स्मृतः ।\nतस्य पुत्रो महावीर्यः प्रजावान् कौशिक स्मृतः ।८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005454008, "chapter_id": 25454, "verse_number": "१-२४-९", "content_sanskrit": "अभूत् तस्य सुतो धीमान् सुमन्तुस्तत्सुतोऽनलः ।\nकैशिकस्य सुतश्चेदिश्चैद्यास्तस्याभवन् सुताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005454009, "chapter_id": 25454, "verse_number": "१-२४-१०", "content_sanskrit": "तेषां प्रधानो द्युतिमान् वपुष्मांस्तत्सुतोऽभवत् ।\nवपुष्मतो बृहन्मेधा श्रीदेवस्तत्सुतोऽभवत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005454010, "chapter_id": 25454, "verse_number": "१-२४-११", "content_sanskrit": "तस्य वीतरथो विप्रा रुद्रभक्तो महाबलः ।\nक्रथस्याप्यभवत् कुन्ती वृष्णी तस्याभवत् सुतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005454011, "chapter_id": 25454, "verse_number": "१-२४-१२", "content_sanskrit": "तस्मान्नवरथो नाम बभुव सुमहाबलः । ।\nकदाचिन्मृगयां यातो दृष्ट्वा राक्षसमूर्जितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005454012, "chapter_id": 25454, "verse_number": "१-२४-१३", "content_sanskrit": "दुद्राव महातविष्टो भयेन मुनिपुंगवाः ।\nअन्वधावत संक्रुद्धो राक्षसस्तं महाबलः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005454013, "chapter_id": 25454, "verse_number": "१-२४-१४", "content_sanskrit": "दुर्योधनोऽग्निसंकाशः शूलासक्तमहाकरः ।\nराजा नवरथो भीत्या नातिदूरादवस्थितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005454014, "chapter_id": 25454, "verse_number": "१-२४-१५", "content_sanskrit": "अपश्यत् परमं स्थानं सरस्वत्या सुगोपितम् ।\nस तद्वेगेन महता संप्राप्य मतिमान् नृपः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005454015, "chapter_id": 25454, "verse_number": "१-२४-१६", "content_sanskrit": "ववन्दे शिरसा दृष्ट्वा साक्षाद् देवीं सरस्वतीम् ।\nतुष्टाव वाग्भिरिष्टाभिर्बद्धाञ्जलिरमित्रजित् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005454016, "chapter_id": 25454, "verse_number": "१-२४-१७", "content_sanskrit": "पपात दण्डवद् भूमौ त्वामहं शरणं गतः ।\nनमस्यामि महादेवीं साक्षाद् देवीं सरस्वतीम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005454017, "chapter_id": 25454, "verse_number": "१-२४-१८", "content_sanskrit": "वाग्देवतामनाद्यन्तामीश्वरीं ब्रह्मचारिणीम् ।\nनमस्ये जगतां योनिं योगिनीं परमां कलाम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005454018, "chapter_id": 25454, "verse_number": "१-२४-१९", "content_sanskrit": "हिरण्यगर्भमहिषीं त्रिनेत्रां चन्द्रशेखराम् ।\nनमस्ये परमानन्दां चित्कलां ब्रह्मरूपिणीम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005454019, "chapter_id": 25454, "verse_number": "१-२४-२०", "content_sanskrit": "पाहि मां परमेशानि भीतं शरणमागतम् ।\nएतस्मिन्नन्तरे क्रुद्धो राजानं राक्षसेश्वरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005454020, "chapter_id": 25454, "verse_number": "१-२४-२१", "content_sanskrit": "हन्तुं समागतः स्थानं यत्र देवी सरस्वती ।\nसमुद्यम्य तदा शूलं प्रवेष्टुं बलदर्पितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005454021, "chapter_id": 25454, "verse_number": "१-२४-२२", "content_sanskrit": "त्रिलोकमातुस्तत्स्थानं शशाङ्कादित्यसंन्निभम् ।\nतदन्तरे महद्भूतं युगान्तादित्यसन्निभम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005454022, "chapter_id": 25454, "verse_number": "१-२४-२३", "content_sanskrit": "शूलेनोरसि निर्भिद्य पातयामास तं भुवि ।\nगच्छेत्याह महाराज न स्थातव्यं त्वया पुनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005454023, "chapter_id": 25454, "verse_number": "१-२४-२४", "content_sanskrit": "इदानीं निर्भयस्तूर्णं स्थानेऽस्मिन् राक्षसो हतः ।\nततः प्रणम्य हृष्टात्मा राजा नवरथः पराम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005454024, "chapter_id": 25454, "verse_number": "१-२४-२५", "content_sanskrit": "पुरीं जगाम विप्रेन्द्राः पुरंदरपुरोपमाम् ।\nस्थापयामास देवेशीं तत्र भक्तिसमन्वितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005454025, "chapter_id": 25454, "verse_number": "१-२४-२६", "content_sanskrit": "ईजे च विविधैर्यज्ञैर्होमैर्देवीं सरस्वतीम् ।\nतस्य चासीद् दशरथः पुत्रः परमधार्मिकः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005454026, "chapter_id": 25454, "verse_number": "१-२४-२७", "content_sanskrit": "देव्या भक्तो महातेजाः शकुनिस्तस्य चात्मजः ।\nतस्मात् करम्भः संभूतो देवरातोऽभवत् ततः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005454027, "chapter_id": 25454, "verse_number": "१-२४-२८", "content_sanskrit": "ईजे स चाश्वमेधेन देवक्षत्रश्च तत्सुतः ।\nमधुस्तस्य तु दायादस्तस्मात् कुरुवशोऽभवत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005454028, "chapter_id": 25454, "verse_number": "१-२४-२९", "content_sanskrit": "पुत्रद्वयमभूत् तस्य सुत्रामा चानुरेव च ।\nअनोस्तु पुरुकुत्सोऽभूदंशुस्तस्य च रिक्थभाक् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005454029, "chapter_id": 25454, "verse_number": "१-२४-३०", "content_sanskrit": "अथांशोःरन्धको नाम विष्णुभक्तः प्रतापवान् ।\nमहात्मा दाननिरतो धनुर्वेदविदां वरः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005454030, "chapter_id": 25454, "verse_number": "१-२४-३१", "content_sanskrit": "स नारदस्य वचनाद् वासुदेवार्चने रतः ।\nशास्त्रं प्रवर्तयामास कुण्डगोलादिभिः श्रुतम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005454031, "chapter_id": 25454, "verse_number": "१-२४-३२", "content_sanskrit": "तस्य नाम्ना तु विख्यातं सात्त्वतं नाम शोभनम् ।\nप्रवर्तते महाशास्त्रं कुण्डादीनां हितावहम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005454032, "chapter_id": 25454, "verse_number": "१-२४-३३", "content_sanskrit": "सात्त्वतस्तस्य पुत्रोऽभूत् सर्वशास्त्रविशारदः ।\nपुण्यश्लोको महाराजस्तेन वै तत्प्रवर्तितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005454033, "chapter_id": 25454, "verse_number": "१-२४-३४", "content_sanskrit": "सात्त्वतः सत्त्वसंपन्नः कौशल्यां सुषुवे सुतान् ।\nअन्धकं वै महाभोजं वृष्णिं देवावृधं नृपम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005454034, "chapter_id": 25454, "verse_number": "१-२४-३५", "content_sanskrit": "ज्येष्ठं च भजमानाख्यं धनुर्वेदविदां वरम् ।\nतेषां देवावृधो राजा चचार परमं तपः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005454035, "chapter_id": 25454, "verse_number": "१-२४-३६", "content_sanskrit": "पुत्रः सर्वगुणोपेतो मम भूयादिति प्रभुः ।\nतस्य बभ्रुरिति ख्यातः पुण्यश्लोकोऽभवन्नृपः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005454036, "chapter_id": 25454, "verse_number": "१-२४-३७", "content_sanskrit": "धार्मिको रूपसंपन्नस्तत्त्वज्ञानरतः सदा ।\nभजमानस्य मृञ्जय्यां भजमानाद्विजज्ञिरे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005454037, "chapter_id": 25454, "verse_number": "१-२४-३८", "content_sanskrit": "तेषां प्रधानौ विख्यातौ निमिः कृकण एव च ।\nमहाभोजकुले जाता भोजा वैमातृकास्तथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005454038, "chapter_id": 25454, "verse_number": "१-२४-३९", "content_sanskrit": "वृष्णेः सुमित्रो बलवाननमित्रस्तिमिस्तथा ।\nअनमित्रादभून्निघ्नो निघ्नस्य द्वौ बभूवतुः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005454039, "chapter_id": 25454, "verse_number": "१-२४-४०", "content_sanskrit": "प्रसेनस्तु महाभागः सत्राजिन्नाम चोत्तमः ।\nअनमित्राच्छिनिर्जज्ञे कनिष्ठाद् वृष्णिनन्दनात् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005454040, "chapter_id": 25454, "verse_number": "१-२४-४१", "content_sanskrit": "सत्यवान् सत्यसंपन्नः सत्यकस्तत्सुतोऽभवत् ।\nसात्यकिर्युयुधानस्तु तस्यासङ्गोऽभवत् सुतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005454041, "chapter_id": 25454, "verse_number": "१-२४-४२", "content_sanskrit": "कुणिस्तस्य सुतो धीमांस्तस्य पुत्रो युगंधरः ।\nमाद्र्या वृष्णेः सुतो जज्ञे वृष्णेर्वै यदुनन्दनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005454042, "chapter_id": 25454, "verse_number": "१-२४-४३", "content_sanskrit": "जज्ञाते तनयौ पृश्नेः श्वफल्कश्चित्रकश्च हि ।\nश्वफल्कः काशिराजस्यसुतां भार्यामविन्दत ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005454043, "chapter_id": 25454, "verse_number": "१-२४-४४", "content_sanskrit": "तस्यामजनयत् पुत्रमक्रूरं नाम धार्मिकम् ।\nउपमङ्‌गुस्तथा मङ्‌गुरन्ये च बहवः सुताः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005454044, "chapter_id": 25454, "verse_number": "१-२४-४५", "content_sanskrit": "अक्रूरस्य स्मृतः पुत्रो देववानिति विश्रुतः ।\nउपदेवश्च पुण्यात्मा तयोर्विश्वप्रमाथिनौ ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005454045, "chapter_id": 25454, "verse_number": "१-२४-४६", "content_sanskrit": "चित्रकस्याभवत् पुत्रः पृथुर्विपृथुरेव च ।\nअश्वग्रीवः सुबाहुश्च सुपार्श्वकगवेषणौ ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005454046, "chapter_id": 25454, "verse_number": "१-२४-४७", "content_sanskrit": "अन्धकात् कास्यदुहिता लेभे च चतुरः सुतान् ।\nकुकुरं भजमानं च शमीकं बलगर्वितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005454047, "chapter_id": 25454, "verse_number": "१-२४-४८", "content_sanskrit": "कुकुरस्य सुतो वृष्णिर्वृष्णेस्तु तनयोऽभवत् ।\nकपोतरोमा विपुलस्तस्य पुत्रो विलोमकः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005454048, "chapter_id": 25454, "verse_number": "१-२४-४९", "content_sanskrit": "तस्यासीत् तुम्बुरुसखा विद्वान् पुत्रस्तलः किल ।\nस्थीयते तस्यनाम्नातु तयोरानकदुन्दुभिः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005454049, "chapter_id": 25454, "verse_number": "१-२४-५०", "content_sanskrit": "स गोवर्धनमासाद्य तताप विपुलं तपः ।\nवरं तस्मै ददौ देवो ब्रह्मा लोकमहेश्वरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005454050, "chapter_id": 25454, "verse_number": "१-२४-५१", "content_sanskrit": "वंशस्य चाक्षयां कीर्ति ज्ञानयोगमनुत्तमम् ।\nगुरोरप्यधिकं विप्राः कामरूपित्वमेव च ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005454051, "chapter_id": 25454, "verse_number": "१-२४-५२", "content_sanskrit": "स लब्ध्वा वरमव्यग्रो वरेण्यं वृषवाहनम् ।\nपूजयामास गानेन स्थाणुं त्रिदशपूजितम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005454052, "chapter_id": 25454, "verse_number": "१-२४-५३", "content_sanskrit": "तस्य गानरतस्याथ भगवानम्बिकापतिः ।\nकन्यारत्नं ददौ देवो दुर्लभं त्रिदशैरपि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005454053, "chapter_id": 25454, "verse_number": "१-२४-५४", "content_sanskrit": "तया स सङ्गतो राजा गानयोगमनुत्तमम् ।\nअशिक्षयदमित्रघ्नः प्रियां तां भ्रान्तलोचनाम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005454054, "chapter_id": 25454, "verse_number": "१-२४-५५", "content_sanskrit": "तस्यामुत्पादयामास सुभुजं नाम शोभनम् ।\nरूपलावण्यसंपन्नां ह्रीमतीमपि कन्यकाम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005454055, "chapter_id": 25454, "verse_number": "१-२४-५६", "content_sanskrit": "ततस्तं जननी पुत्रं बाल्ये वयसि शोभनम् ।\nशिक्षयामास विधिवद् गानविद्यां च कन्यकाम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005454056, "chapter_id": 25454, "verse_number": "१-२४-५७", "content_sanskrit": "कृतोपनयनो वेदानधीत्य विधिवद् गुरोः ।\nउद्ववाहात्मजां कन्यां गन्धर्वाणां तु मानसीम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005454057, "chapter_id": 25454, "verse_number": "१-२४-५८", "content_sanskrit": "तस्यामुत्पादयामास पञ्च पुत्राननुत्तमान् ।\nवीणावादनतत्त्वज्ञान् गानशास्त्रविशारदान् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005454058, "chapter_id": 25454, "verse_number": "१-२४-५९", "content_sanskrit": "पुत्रैः पौत्रैः सपत्नीको राजा गानविशारदः ।\nपूजयामास गानेन देवं त्रिपुरनाशनम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005454059, "chapter_id": 25454, "verse_number": "१-२४-६०", "content_sanskrit": "ह्रीमती चापि या कन्या श्रीरिवायतलोचना ।\nसुबाहुर्नाम गन्धर्वस्तामादाय ययौ पुरीम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005454060, "chapter_id": 25454, "verse_number": "१-२४-६१", "content_sanskrit": "तस्यामप्यभवन् पुत्रा गन्धर्वस्य सुतेजसः ।\nसुषेणधीरसुग्रीवसुभोजनरवाहनाः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005454061, "chapter_id": 25454, "verse_number": "१-२४-६२", "content_sanskrit": "अथासीदभिजित् पुत्रो वीरस्त्वानकदुन्दुभेः ।\nपुनर्वसुश्चाभिजितः संबभूवाहुकस्ततः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005454062, "chapter_id": 25454, "verse_number": "१-२४-६३", "content_sanskrit": "आहुकस्योग्रसेनश्च देवकश्च द्विजोत्तमाः ।\nदेवकस्य सुता वीरा जज्ञिरे त्रिदशोपमाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005454063, "chapter_id": 25454, "verse_number": "१-२४-६४", "content_sanskrit": "देववानुपदेवश्च सुदेवो देवरक्षितः ।\nतेषां स्वसारः सप्तासन् वसुदेवाय ता ददौ ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005454064, "chapter_id": 25454, "verse_number": "१-२४-६५", "content_sanskrit": "वृकदेवोपदेवा च तथान्या देवरक्षिता ।\nश्रीदेवा शान्तिदेवा च सहदेवा च सुव्रता ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005454065, "chapter_id": 25454, "verse_number": "१-२४-६६", "content_sanskrit": "देवकी चापि तासां तु वरिष्ठाऽभूत् सुमध्यमा ।\nउग्रसेनस्य पुत्रोऽभून्न्यग्रोधः कंस एव च ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005454066, "chapter_id": 25454, "verse_number": "१-२४-६७", "content_sanskrit": "सुभूमी राष्ट्रपालश्च तुष्टिमाञ्छङ्‌कुरेव च ।\nभजमानादबूत् पुत्रः प्रख्यातोऽसौ विदूरथः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005454067, "chapter_id": 25454, "verse_number": "१-२४-६८", "content_sanskrit": "तस्य सूरसमस्तस्मात् प्रतिक्षत्रस्ततोऽभवत् ।\nस्वयंभोजस्ततस्तस्माद् हृदिकः शत्रुतापनः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005454068, "chapter_id": 25454, "verse_number": "१-२४-६९", "content_sanskrit": "कृतवर्माऽथ तत्पुत्रो देवलस्तत्सुतः स्मृतः ।\nस शूरस्तत्सुतो धीमान् वसुदेवोऽथ तत्सुतः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005454069, "chapter_id": 25454, "verse_number": "१-२४-७०", "content_sanskrit": "वसुदेवावन्महाबाहुर्वासुदेवो जगद्‌गुरुः ।\nबभूव देवकीपुत्रो देवैरभ्यर्थितो हरिः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005454070, "chapter_id": 25454, "verse_number": "१-२४-७१", "content_sanskrit": "रोहिणी च महाभागा वसुदेवस्य शोभना ।\nअसूत पत्नी संकर्षं रामं ज्येष्ठं हलायुधम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005454071, "chapter_id": 25454, "verse_number": "१-२४-७२", "content_sanskrit": "स एव परमात्माऽसौ वासुदेवो जगन्मयः ।\nहलायुधः स्वयं साक्षाच्छेषः संकर्षणः प्रभुः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005454072, "chapter_id": 25454, "verse_number": "१-२४-७३", "content_sanskrit": "भृगुशापच्छलेनैव मानयन् मानुषीं तनुम् ।\nबभूत तस्यां देवक्यां रोहिण्यामपि माधवः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005454073, "chapter_id": 25454, "verse_number": "१-२४-७४", "content_sanskrit": "उमादेहसमुद्‌भूता योगनिद्रा च कौशीकी ।\nनियोगाद् वासुदेवस्य यशोदातनया ह्यभूत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005454074, "chapter_id": 25454, "verse_number": "१-२४-७५", "content_sanskrit": "ये चान्ये वसुदेवस्य वासुदेवाग्रजाः सुताः ।\nप्रागेव कंसस्तान् सर्वान् जघान मुनिपुंगवाः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005454075, "chapter_id": 25454, "verse_number": "१-२४-७६", "content_sanskrit": "सुषेणश्च तथोदायी भद्रसेनो महाबलः ।\nऋजुदासो भद्रदासः कीर्तिमानपि पूर्वजः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005454076, "chapter_id": 25454, "verse_number": "१-२४-७७", "content_sanskrit": "हतेष्वेतेषु सर्वेषु रोहिणी वसुदेवतः ।\nअसूत रामं लोकेशं बलभद्रं हलायुधम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005454077, "chapter_id": 25454, "verse_number": "१-२४-७८", "content_sanskrit": "जातेऽथ रामे देवानामादिमात्मानमच्युतम् ।\nअसूत देवकी कृष्णं श्रीवत्साङ्कितवक्षसम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005454078, "chapter_id": 25454, "verse_number": "१-२४-७९", "content_sanskrit": "रेवती नाम रामस्य भार्यासीत् सुगुणान्विता ।\nतस्यामुत्पादयामास पुत्रौ द्वौ निशितोल्मुकौ ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005454079, "chapter_id": 25454, "verse_number": "१-२४-८०", "content_sanskrit": "षोडशस्त्रीसहस्त्राणि कृष्णस्याक्लिष्टकर्मणः ।\nबभूवुरात्मजास्तासु शतशोऽथ सहस्त्रशः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005454080, "chapter_id": 25454, "verse_number": "१-२४-८१", "content_sanskrit": "चारुदेष्णः सुचारुश्च चारुवेषो यशोधरः ।\nचारुश्रवाश्चारुयशाः प्रद्युम्नः शंख एव च ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005454081, "chapter_id": 25454, "verse_number": "१-२४-८२", "content_sanskrit": "रुक्मिण्यां वासुदेवस्य महाबलपराक्रमाः ।\nविशिष्टाः सर्वपुत्राणां संबभूवुरिमे सुताः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005454082, "chapter_id": 25454, "verse_number": "१-२४-८३", "content_sanskrit": "तान् दृष्ट्वा तनयान् वीरान् रौक्मिणेयाञ्जनार्दनात् ।\nजाम्बवत्यब्रवीत् कृष्णं भार्या तस्य शुचिस्मिता ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005454083, "chapter_id": 25454, "verse_number": "१-२४-८४", "content_sanskrit": "मम त्वं पुण्डरीकाक्ष विशिष्टं गुणवत्तमम् ।\nसुरेशसदृशं पुत्रं देहि दानवसूदन ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005454084, "chapter_id": 25454, "verse_number": "१-२४-८५", "content_sanskrit": "जात्बवत्या वचः श्रुत्वा जगन्नाथः स्वयं हरिः ।\nसमारेभे तपः कर्त्तुं तपोनिधिररिंदमः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005454085, "chapter_id": 25454, "verse_number": "१-२४-८६", "content_sanskrit": "तच्छृणुध्वं मुनिश्रेष्ठा यथाऽसौ देवकीसुतः ।\nदृष्ट्वा लेभे सुतं रुद्रं तप्त्वा तीव्रं महत् तपः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]