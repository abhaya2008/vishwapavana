[{"id": 6000012000, "chapter_id": 10012, "verse_number": null, "content_sanskrit": "अथ द्वादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000012001, "chapter_id": 10012, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.001.m4a", "display_order": 2}, {"id": 6000012002, "chapter_id": 10012, "verse_number": "१-१२-१", "content_sanskrit": "विदुरस्तीर्थयात्रायां मैत्रेयादात्मनो गतिम्।\nज्ञात्वाऽऽगाद्धस्तिनपुरं तयाऽवाप्‍तविवित्सितः॥ १/१२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.002.m4a", "display_order": 3, "topics": [{"text": "तीर्थयात्राकाले मैत्रेयादधिगतभगवज्ज्ञानेन विदुरेण दुर्योधनवधानन्तरं हास्तिनपुरं प्रत्यागमनम्", "range": "१–७"}]}, {"id": 6000012003, "chapter_id": 10012, "verse_number": "१-१२-२", "content_sanskrit": "यावतः कृतवान्प्रश्नान्क्षत्ता कौषारवाग्रतः।\nजातैकभक्‍तिर्गोविन्दे तेभ्यश्‍चोपरराम ह॥ १/१२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.003.m4a", "display_order": 4}, {"id": 6000012004, "chapter_id": 10012, "verse_number": "१-१२-३", "content_sanskrit": "तं बन्धुमागतं दृष्‍ट्वा धर्मपुत्रः सहानुजः।\nधृतराष्‍ट्रो युयुत्सुश्‍च सूतः शारद्वतः पृथा॥ १/१२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.004.m4a", "display_order": 5}, {"id": 6000012005, "chapter_id": 10012, "verse_number": "१-१२-४", "content_sanskrit": "गान्धारी द्रौपदी ब्रह्मन् सुभद्रा चोत्तरा कृपी।\nअन्याश्‍च जामयः पाण्डोर्ज्ञातयः ससुताः स्‍त्रियः॥ १/१२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.005.m4a", "display_order": 6}, {"id": 6000012006, "chapter_id": 10012, "verse_number": "१-१२-५", "content_sanskrit": "प्रत्युज्जग्मुः प्रहर्षेण प्राणांस्तन्व इवागतान्।\nअभिसङ्गम्य विधिवत्परिष्वङ्गाभिवन्दनैः॥ १/१२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.006.m4a", "display_order": 7}, {"id": 6000012007, "chapter_id": 10012, "verse_number": "१-१२-६", "content_sanskrit": "मुमुचुः प्रेमबाष्पौघं मिथ औत्कण्ठ्यकातराः।\nराजा तमर्हयाञ्चक्रे कृतासनपरिग्रहम्॥ १/१२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.007.m4a", "display_order": 8}, {"id": 6000012008, "chapter_id": 10012, "verse_number": "१-१२-७", "content_sanskrit": "तं भुक्‍तवन्तमासीनं विश्रान्तं सुखमासने।\nप्रश्रयावनतो राजा प्राह स्वानां ‍च शृण्वताम्॥ १/१२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.008.m4a", "display_order": 9}, {"id": 6000012009, "chapter_id": 10012, "verse_number": null, "content_sanskrit": "युधिष्‍ठिर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.009.m4a", "display_order": 10}, {"id": 6000012010, "chapter_id": 10012, "verse_number": "१-१२-८", "content_sanskrit": "अपि स्मरथ नो युष्मत्पक्षच्छायासमेधितान्।\nविपद्गणाद्विषाग्न्यादेर्मोचिता यत्समातृकाः॥ १/१२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.010.m4a", "display_order": 11, "topics": [{"text": "युधिष्‍ठिरेण द्वारकाजनकुशलं पृष्‍टेन विदुरेण तं प्रति यदुकुलक्षयं विना सकलवृत्तान्तकथनम्", "range": "८–१८"}]}, {"id": 6000012011, "chapter_id": 10012, "verse_number": "१-१२-९", "content_sanskrit": "कया वृत्त्या वर्तितं वै चरद्भिः क्षितिमण्डलम्।\nतीर्थानि क्षेत्रमुख्यानि सेवितानीह भूतले॥ १/१२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.011.m4a", "display_order": 12}, {"id": 6000012012, "chapter_id": 10012, "verse_number": "१-१२-१०", "content_sanskrit": "भवद्विधा भागवतास्तीर्थभूतास्स्वयं प्रभो।\nतीर्थीकुर्वन्ति तीर्थानि स्वात्मस्थेन गदाभृता॥ १/१२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.012.m4a", "display_order": 13}, {"id": 6000012013, "chapter_id": 10012, "verse_number": "१-१२-११", "content_sanskrit": "अपि नः सुहृदस्तात बान्धवाः कृष्णदैवताः।\nदृष्‍टाः श्रुता वा यदवः स्वपुर्यां सुखमासते॥ १/१२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.013.m4a", "display_order": 14}, {"id": 6000012014, "chapter_id": 10012, "verse_number": "१-१२-१२", "content_sanskrit": "इत्युक्‍तो धर्मराजेन सर्वं तत्समवर्णयत्।\nयथाऽनुभूतं भ्रमता विना यदुकुलक्षयम्॥ १/१२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.014.m4a", "display_order": 15}, {"id": 6000012015, "chapter_id": 10012, "verse_number": "१-१२-१३", "content_sanskrit": "तत्त्वप्रियं दुर्विषयं नृणां स्वयमुपस्थितम्।\nनावेदयत्सुकरणो दुःखितान्द्रष्‍टुमक्षमः॥ १/१२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.015.m4a", "display_order": 16}, {"id": 6000012016, "chapter_id": 10012, "verse_number": "१-१२-१४", "content_sanskrit": "कञ्चित्कालमथावात्सीत्सत्कृतो देववत्स्वकैः।\nभ्रातुर्ज्येष्‍ठस्य श्रेयस्कृत्सर्वेषां प्रीतिमावहन्॥ १/१२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.016.m4a", "display_order": 17}, {"id": 6000012017, "chapter_id": 10012, "verse_number": "१-१२-१५", "content_sanskrit": "अबिभ्रदर्यमा दण्डं यथाऽघमघकारिषु।\nयावद्बभार शूद्रत्वं शापाद्वर्षशतं यमः॥ १/१२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.017.m4a", "display_order": 18}, {"id": 6000012018, "chapter_id": 10012, "verse_number": "१-१२-१६", "content_sanskrit": "युधिष्‍ठिरो लब्धराज्यो दृष्‍ट्वा पौत्रं कुलन्धरम्।\nभ्रातृभिर्लोकपालाभैर्मुमुदे परया श्रिया॥ १/१२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.018.m4a", "display_order": 19}, {"id": 6000012019, "chapter_id": 10012, "verse_number": "१-१२-१७", "content_sanskrit": "अथामन्त्र्याच्युतो बन्धून्निवर्त्यानुगतान्विभुः।\nअर्जुनोद्धवशैनेयैर्ययौ द्वारवतीं हयैः॥ १/१२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.019.m4a", "display_order": 20}, {"id": 6000012020, "chapter_id": 10012, "verse_number": "१-१२-१८", "content_sanskrit": "एवं गृहेषु सक्‍तानां प्रमत्तानां गृहेहया।\nअत्यक्रामदविज्ञातः कालः परमदुस्तरः॥ १/१२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.020.m4a", "display_order": 21}, {"id": 6000012021, "chapter_id": 10012, "verse_number": "१-१२-१९", "content_sanskrit": "विदुरस्तदभिप्रेत्य धृतराष्‍ट्रमभाषत।\nराजन्निर्गम्यतां शीघ्रं पश्येदं भयमागतम्॥ १/१२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.021.m4a", "display_order": 22, "topics": [{"text": "विदुरबोधनाज्जातवैराग्येण धृतराष्‍ट्रेण हिमालयगमनम्", "range": "१९–३०"}]}, {"id": 6000012022, "chapter_id": 10012, "verse_number": "१-१२-२०", "content_sanskrit": "प्रतिक्रिया न यस्येह कुतश्‍चित्कर्हिचित् प्रभो।\nस एष भगवान्कालः सर्वेषां नः समागतः॥ १/१२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.022.m4a", "display_order": 23}, {"id": 6000012023, "chapter_id": 10012, "verse_number": "१-१२-२१", "content_sanskrit": "येन चेहाभिपन्नोऽयं प्राणैः प्रियतमैरपि।\nजनः सद्यो वियुज्येत किमुतान्यैर्धनादिभिः॥ १/१२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.023.m4a", "display_order": 24}, {"id": 6000012024, "chapter_id": 10012, "verse_number": "१-१२-२२", "content_sanskrit": "पितृभ्रातृसुहृत्पुत्रा हतास्ते विगतं वयः।\nआत्मा च जरया ग्रस्तः परगेहमुपाससे॥ १/१२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.024.m4a", "display_order": 25}, {"id": 6000012025, "chapter_id": 10012, "verse_number": "१-१२-२३", "content_sanskrit": "अहो महीयसी जन्तोर्जीविताशा यया भवान्।\nभीमापवर्जितं पिण्डमादत्से गृहपालवत्॥ १/१२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.025.m4a", "display_order": 26}, {"id": 6000012026, "chapter_id": 10012, "verse_number": "१-१२-२४", "content_sanskrit": "अग्निर्निसृष्‍टो दत्तश्‍च गरो दाराश्‍च दूषिताः।\nहृतं क्षेत्रं धनं येषां तदन्नैरसुभिः कियत्॥ १/१२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.026.m4a", "display_order": 27}, {"id": 6000012027, "chapter_id": 10012, "verse_number": "१-१२-२५", "content_sanskrit": "तस्यापि तव देहोऽयं कृपणस्य जिजीविषोः।\nपरेत्यनिच्छतो जीर्णो जरया वाससी इव॥ १/१२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.027.m4a", "display_order": 28}, {"id": 6000012028, "chapter_id": 10012, "verse_number": "१-१२-२६", "content_sanskrit": "गतस्वार्थमिमं देहं वियुक्‍तो मुक्‍तबन्धनः।\nअविज्ञातगतिर्जह्यात्स वै धीर उदाहृतः॥ १/१२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.028.m4a", "display_order": 29}, {"id": 6000012029, "chapter_id": 10012, "verse_number": "१-१२-२७", "content_sanskrit": "यः स्वतः परतो वेह जातनिर्वेद आत्मवान्।\nहृदि कृत्वा हरिं गेहात्प्रव्रजेत्स नरोत्तमः॥ १/१२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.029.m4a", "display_order": 30}, {"id": 6000012030, "chapter_id": 10012, "verse_number": "१-१२-२८", "content_sanskrit": "अथोदीचीं दिशं यातु स्वैरज्ञातगतिर्भवान्।\nइतोऽर्वाक्प्रायशः कालः पुंसां गुणविकर्षणः॥ १/१२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.030.m4a", "display_order": 31}, {"id": 6000012031, "chapter_id": 10012, "verse_number": "१-१२-२९", "content_sanskrit": "एवं राजा विदुरेणानुजेन प्रज्ञाचक्षुर्बोधित आजमीढः।\nछित्त्वा स्वेषु स्नेहपाशान्द्रढिम्नो निश्‍चक्राम भ्रातृसन्दर्शिताध्वा॥ १/१२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.031.m4a", "display_order": 32}, {"id": 6000012032, "chapter_id": 10012, "verse_number": "१-१२-३०", "content_sanskrit": "पतिं प्रयान्तं सुबलस्य पुत्री पतिव्रता चानुजगाम साध्वी।\nहिमालयं न्यस्तदण्डप्रहर्षं मनस्विनामवसत्संविहारम्॥ १/१२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.032.m4a", "display_order": 33}, {"id": 6000012033, "chapter_id": 10012, "verse_number": "१-१२-३१", "content_sanskrit": "अजातशत्रुः कृतमैत्रो हुताग्निर्विप्रान् नत्वा तिलगोवस्‍त्ररुग्मैः।\nगृहान् प्रविष्‍टो गुरुवन्दनाय न चापश्यत्पितरौ सौबलीं ‍च॥ १/१२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.033.m4a", "display_order": 34, "topics": [{"text": "प्रातर्धृतराष्‍ट्रवन्दनाय तद्गृहं प्रविष्‍टे युधिष्‍ठिरे तत्र तददर्शनेन दूयमाने तदा यदृच्छासमागतेन नारदेन तं प्रति धृतराष्‍ट्रादीनां हिमालयगमनस्य ततः पञ्चमेऽहनि भविष्यतः तेषां देहत्यागस्य च कथनम्", "range": "३१–६०"}]}, {"id": 6000012034, "chapter_id": 10012, "verse_number": "१-१२-३२", "content_sanskrit": "तत्र सञ्जयमासीनं पप्रच्छोद्विग्नमानसः। गावद्गणे क्‍व नस्तातो वृद्धो हीनश्‍च नेत्रयोः।\nअम्बा वा हतपुत्रार्ता पितृव्यः क्‍व गतः सुहृत्॥ १/१२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.034.m4a", "display_order": 35}, {"id": 6000012035, "chapter_id": 10012, "verse_number": "१-१२-३३", "content_sanskrit": "अपि मय्यकृतप्रज्ञे हतबन्धुः स्वभार्यया।\nआशंसमानः शमलं गङ्गायां दुःखितोऽपतत्॥ १/१२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.035.m4a", "display_order": 36}, {"id": 6000012036, "chapter_id": 10012, "verse_number": "१-१२-३४", "content_sanskrit": "पितर्युपरते पाण्डौ सर्वान् नः सुहृदः शिशून्।\nअरक्षतां व्यसनतः पितृव्यौ क्‍व गतावितः॥ १/१२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.036.m4a", "display_order": 37}, {"id": 6000012037, "chapter_id": 10012, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.037.m4a", "display_order": 38}, {"id": 6000012038, "chapter_id": 10012, "verse_number": "१-१२-३५", "content_sanskrit": "कृपया स्नेहवैक्लव्यात्सूतो विरहकर्शितः।\nआत्मेश्‍वरमचक्षाणो न प्रत्याहातिपीडितः॥ १/१२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.038.m4a", "display_order": 39}, {"id": 6000012039, "chapter_id": 10012, "verse_number": "१-१२-३६", "content_sanskrit": "विसृज्याश्रूणि पाणिभ्यां विष्‍टभ्यात्मानमात्मना।\nअजातशत्रुं प्रत्यूचे प्रभोः पादावनुस्मरन्॥ १/१२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.039.m4a", "display_order": 40}, {"id": 6000012040, "chapter_id": 10012, "verse_number": null, "content_sanskrit": "सञ्जय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.040.m4a", "display_order": 41}, {"id": 6000012041, "chapter_id": 10012, "verse_number": "१-१२-३७", "content_sanskrit": "अहं ‍च व्यंसितो राजन् पित्रोर्वः कुलनन्दन।\nन वेद साध्व्या गान्धार्या मुषितोऽस्मि महात्मभिः॥ १/१२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.041.m4a", "display_order": 42}, {"id": 6000012042, "chapter_id": 10012, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.042.m4a", "display_order": 43}, {"id": 6000012043, "chapter_id": 10012, "verse_number": "१-१२-३८", "content_sanskrit": "एतस्मिन्नन्तरे विप्रा नारदः प्रत्यदृश्यत।\nवीणां त्रितन्त्रीं ध्वनयन्भगवान्सहतुम्बुरुः॥ १/१२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.043.m4a", "display_order": 44}, {"id": 6000012044, "chapter_id": 10012, "verse_number": "१-१२-३९", "content_sanskrit": "राज्ञादरोपनीतार्घ्यं प्रत्युत्थानाभिवन्दितम्।\nपरमासन आसीनं कौरवेन्द्रोऽभ्यभाषत॥ १/१२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.044.m4a", "display_order": 45}, {"id": 6000012045, "chapter_id": 10012, "verse_number": null, "content_sanskrit": "युधिष्‍ठिर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.045.m4a", "display_order": 46}, {"id": 6000012046, "chapter_id": 10012, "verse_number": "१-१२-४०", "content_sanskrit": "नाहं वेद गतिं पित्रोर्भगवान् क्‍व गतावितः।\nकर्णधार इवापारे सीदतां पारदर्शनः॥ १/१२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.046.m4a", "display_order": 47}, {"id": 6000012047, "chapter_id": 10012, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.047.m4a", "display_order": 48}, {"id": 6000012048, "chapter_id": 10012, "verse_number": "१-१२-४१", "content_sanskrit": "मा कञ्चन शुचो राजन्यदीश्‍वरवशं जगत्।\nस संयुनक्‍ति भूतानि स एव वियुनक्‍ति च॥ १/१२/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.048.m4a", "display_order": 49}, {"id": 6000012049, "chapter_id": 10012, "verse_number": "१-१२-४२", "content_sanskrit": "यथा गावो नसि प्रोतास्तन्त्यां बद्धाः स्वदामभिः।\nवाक्‍तन्त्यां नामभिर्बद्धा वहन्ति बलिमीशितुः॥ १/१२/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.049.m4a", "display_order": 50}, {"id": 6000012050, "chapter_id": 10012, "verse_number": "१-१२-४३", "content_sanskrit": "यथा क्रीडोपस्कराणां संयोगविगमाविह।\nइच्छया क्रीडितुः स्यातां तथैवेशेच्छया नृणाम्॥ १/१२/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.050.m4a", "display_order": 51}, {"id": 6000012051, "chapter_id": 10012, "verse_number": "१-१२-४४", "content_sanskrit": "यन्मन्यसे ध्रुवं लोकमध्रुवं ‍चाथवोभयम्।\nसर्वथा हि न शोच्यास्ते स्नेहादन्यत्र मोहजात्॥ १/१२/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.051.m4a", "display_order": 52}, {"id": 6000012052, "chapter_id": 10012, "verse_number": "१-१२-४५", "content_sanskrit": "तस्माज्जह्यङ्ग वैक्लव्यमज्ञानकृतमात्मनः।\nकथं त्वनाथाः कृपणा वर्तेरन् बत मामृते॥ १/१२/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.052.m4a", "display_order": 53}, {"id": 6000012053, "chapter_id": 10012, "verse_number": "१-१२-४६", "content_sanskrit": "कालकर्मगुणाधीनो देहोऽयं पाञ्चभौतिकः।\nकथमन्यांस्तु गोपायेत् सर्पग्रस्तो यथा परम्॥ १/१२/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.053.m4a", "display_order": 54}, {"id": 6000012054, "chapter_id": 10012, "verse_number": "१-१२-४७", "content_sanskrit": "अहस्तानि सहस्तानाम् अपदो द्विचतुष्पदाम्।\nअणूनि तात महतां जीवो जीवस्य जीवनम्॥ १/१२/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.054.m4a", "display_order": 55}, {"id": 6000012055, "chapter_id": 10012, "verse_number": "१-१२-४८", "content_sanskrit": "तदिदं भगवान्राजन्नेक आत्माऽऽत्मनां स्वदृक्।\nअन्तरोऽनन्तरो भाति पश्य त्वं माययोरुताम्॥ १/१२/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.055.m4a", "display_order": 56}, {"id": 6000012056, "chapter_id": 10012, "verse_number": "१-१२-४९", "content_sanskrit": "सोऽयमद्य महाराज भगवान्भूतभावनः।\nकालरूपोऽवतीर्णोऽस्याम् अभावाय सुरद्विषाम्॥ १/१२/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.056.m4a", "display_order": 57}, {"id": 6000012057, "chapter_id": 10012, "verse_number": "१-१२-५०", "content_sanskrit": "निष्पादितं देवकृत्यमवशेषं प्रतीक्षते।\nतावद्यूयमवेक्षध्वं भवेद्यावदिहेश्‍वरः॥ १/१२/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.057.m4a", "display_order": 58}, {"id": 6000012058, "chapter_id": 10012, "verse_number": "१-१२-५१", "content_sanskrit": "धृतराष्‍ट्रः सह भ्रात्रा गान्धार्या च स्वभार्यया।\nदक्षिणेन हिमवता ऋषीणामाश्रमं गतः॥ १/१२/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.058.m4a", "display_order": 59}, {"id": 6000012059, "chapter_id": 10012, "verse_number": "१-१२-५२", "content_sanskrit": "स्रोतोभिः सप्‍तभिर्यत्र स्वर्धुनी सप्‍तधाऽभ्यगात्।\nसप्‍तानां प्रीतये नाम्ना सप्‍तस्रोतः प्रचक्षते॥ १/१२/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.059.m4a", "display_order": 60}, {"id": 6000012060, "chapter_id": 10012, "verse_number": "१-१२-५३", "content_sanskrit": "स्नात्वा त्रिषवणं तस्मिन्हुत्वा चाग्नीन्यथाविधि।\nअब्भक्ष उपशान्तात्मा स आस्तेऽविगतेक्षणः॥ १/१२/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.060.m4a", "display_order": 61}, {"id": 6000012061, "chapter_id": 10012, "verse_number": "१-१२-५४", "content_sanskrit": "जितासनो जितश्‍वासः प्रत्याहृतषडिन्द्रियः।\nहरिभावनया ध्वस्तरजःसत्त्वतमोमलः॥ १/१२/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.061.m4a", "display_order": 62}, {"id": 6000012062, "chapter_id": 10012, "verse_number": "१-१२-५५", "content_sanskrit": "विज्ञानात्मनि संयोज्य क्षेत्रज्ञे प्रविलाप्य तम्।\nब्रह्मण्यात्मानमाधारे घटाम्बरमिवाम्बरे॥ १/१२/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.062.m4a", "display_order": 63}, {"id": 6000012063, "chapter_id": 10012, "verse_number": "१-१२-५६", "content_sanskrit": "ध्वस्तमायागुणोद्रेको निरुद्धकरणाशयः। निवर्तिताखिलाहार आस्ते स्थाणुरिवाधुना।\nतस्यान्तरायो नैवाभूत् संन्यस्ताखिलकर्मणः॥ १/१२/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.063.m4a", "display_order": 64}, {"id": 6000012064, "chapter_id": 10012, "verse_number": "१-१२-५७", "content_sanskrit": "स वा अद्यतनाद्रजा परतः पञ्चमेऽहनि।\nकलेवरं हास्यति ह तच्च भस्मीभविष्यति॥ १/१२/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.064.m4a", "display_order": 65}, {"id": 6000012065, "chapter_id": 10012, "verse_number": "१-१२-५८", "content_sanskrit": "दह्यमानेऽग्निभिर्देहे पत्युः पत्नी सहोटजे।\nबहिःस्थित्वा पतिं साध्वी तमग्निमनुवेक्ष्यति॥ १/१२/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.065.m4a", "display_order": 66}, {"id": 6000012066, "chapter_id": 10012, "verse_number": "१-१२-५९", "content_sanskrit": "विदुरस्तु तदाश्‍चर्यं निशाम्य कुरुनन्दन।\nहर्षशोकयुतस्तस्माद्गन्ता तीर्थनिषेवकः॥ १/१२/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.066.m4a", "display_order": 67}, {"id": 6000012067, "chapter_id": 10012, "verse_number": "१-१२-६०", "content_sanskrit": "इत्युक्‍त्वाऽथारुहत्स्वर्गं नारदः सहतुम्बुरुः।\nयुधिष्‍ठिरो वचस्तस्य हृदि कृत्वाऽजहाच्छुचः॥ १/१२/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_012/BhP_01.012.067.m4a", "display_order": 68}, {"id": 6000012068, "chapter_id": 10012, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे द्वादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]