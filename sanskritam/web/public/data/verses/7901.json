[{"id": 33000527, "chapter_id": 7901, "verse_number": "1", "content_sanskrit": "भावे कर्मणि सर्वसम्माद् धातोः स्याद् आत्मनेपदम् । ङिद्भ्यस्तथाऽनुदात्तेद्‌भ्यो भूयतेऽप्यायतेऽयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 33000528, "chapter_id": 7901, "verse_number": "2", "content_sanskrit": "क्रियाव्यतिहृतौ तद्वद् व्यतिस्ते व्यतिषिञ्चते । शब्दार्थहसअ(वहहृ)गतिहिंसाऽर्थकान्न तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 33000529, "chapter_id": 7901, "verse_number": "3", "content_sanskrit": "व्यतिभ्यां जल्पति हसत्येति हन्तीत्यमूर्दशः । नाऽत्र सम्प्रवहन्ते सम्प्रप्रहरन्ते निषेधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 33000530, "chapter_id": 7901, "verse_number": "4", "content_sanskrit": "परस्परेतरान्योन्योपपदान्नाऽऽत्मनेपदम् । अन्योन्यस्य व्यतिलुनन्त्येषा दिङ् निपराद् विशेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 33000531, "chapter_id": 7901, "verse_number": "5", "content_sanskrit": "परिव्यवेष्यः क्रीणातेः जयतेर्विपरापरात् । आङो दाञो विकासस्वास्यप्रसारणयोर्न हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 33000532, "chapter_id": 7901, "verse_number": "6", "content_sanskrit": "गमेः क्षमायां णेराङि नुपृच्छयोः क्रीडतेरनोः । पर्याङ्भ्याम् च समोऽकुजेः जिज्ञासायां शकेः सनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 33000533, "chapter_id": 7901, "verse_number": "7", "content_sanskrit": "अपस्किरोऽथो हरतेर्गतिताच्छील्य आशिषि । नाथः शपेस्तु शपथे स्थो निर्णीतौ प्रकाशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 33000534, "chapter_id": 7901, "verse_number": "8", "content_sanskrit": "प्रतिज्ञायाम् आवसंविप्राद्उदोऽनूर्ध्वचेष्टने । देवाऽर्चासङ्गतिकृतिमैत्रीषु पथिकर्तृके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 33000535, "chapter_id": 7901, "verse_number": "9", "content_sanskrit": "धात्वर्थे मन्त्रकरणेऽकर्मके चोपपूर्वकात् । वा लिप्सायां समः प्रच्छिगम्यृच्छिस्वॄश्रुवेत्तितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 33000536, "chapter_id": 7901, "verse_number": "10", "content_sanskrit": "दृशोऽर्तेश्चकर्मकेभ्य आङ्पूर्वाभ्याम् यमेर्हेनः । उद्विभ्यां तपतेः स्वाऽङ्गकर्मकेभ्यो ऽप्यथाऽस्यतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 33000537, "chapter_id": 7901, "verse_number": "11", "content_sanskrit": "ऊहश्च सोपसर्गाद् वा ह्वो निसंव्युपपूर्वकात् । आङ्स्तु स्पर्धने सूचनाऽवक्षेपणसेवने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 33000538, "chapter_id": 7901, "verse_number": "12", "content_sanskrit": "प्रतियत्ने प्रकथणोपयोगे साधने कृञः । अधेः प्रसहने वेस्तु शब्दकर्मण्यकर्मकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 33000539, "chapter_id": 7901, "verse_number": "13", "content_sanskrit": "पूजाऽऽचार्यकृतिज्ञानोत्सञ्जनेषु भृतौ व्यये । नीञो विगणने कर्तृस्थिते चाऽमूर्तकर्मणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 33000540, "chapter_id": 7901, "verse_number": "14", "content_sanskrit": "वृत्त्युत्साहस्फीततासु क्रमे स्तद्वत्परोपयोः । ज्योतिरुद्गमने त्वाङो वेः पादविहृताऽर्थकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 33000541, "chapter_id": 7901, "verse_number": "15", "content_sanskrit": "आरम्भणाऽर्थे प्रोपाभ्यां विभाषाऽनुपमसर्गकात् । अपह्नवेऽकर्मकाच्च ज्ञो ऽनाध्याने प्रतेः समः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 33000542, "chapter_id": 7901, "verse_number": "16", "content_sanskrit": "यत्नोपसान्त्वनज्ञानभासनेषूपनिमन्त्रणे । विमतौ चाऽपि वदतेः समनुभ्यां त्वकर्मकात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 33000543, "chapter_id": 7901, "verse_number": "17", "content_sanskrit": "व्यक्तवाचां सहोक्तौ च विप्रलापे विभाषया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 33000544, "chapter_id": 7901, "verse_number": "18", "content_sanskrit": "सृजेः श्रद्धावति शयंश्च यथा मालां हि सृज्यते । ग्रोऽवात् समः प्रतिज्ञाने चरेरुदि सकर्मकात ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 33000545, "chapter_id": 7901, "verse_number": "19", "content_sanskrit": "समस्तृतीयायुक्तात् स्वीकरणे तूपयच्छते । तृतीया चेच्चतुर्थ्यर्थे दाणः शिति शदेर् मृङः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 33000546, "chapter_id": 7901, "verse_number": "20", "content_sanskrit": "लुङि्लङोश्च कृञि प्राग्वदामो यस्तु प्रयुज्यते । मनो ज्ञाश्रुस्मृदृशिभ्यो नानोर्ज्ञ आङ्प्रतेः श्रुव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 33000547, "chapter_id": 7901, "verse_number": "21", "content_sanskrit": "अयज्ञपात्रेषु युजेरजाद्यन्तोपसर्गतः । समः क्षणैतेर् अनवने भुजेर् अपि च णेरणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 33000548, "chapter_id": 7901, "verse_number": "22", "content_sanskrit": "यत्कर्म णौ स कर्ता चेद् भवेद् अध्यानवर्जिते । यथाऽऽरोहयते हस्त्ती स्वयं दर्शयते नुपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 33000549, "chapter_id": 7901, "verse_number": "23", "content_sanskrit": "भीम्स्मयोः प्रयोजकाद् भीतिसमययोर् वञ्चतेर्गृधः । प्रलम्भने लियः पूजान्यक्कृत्योर्वञ्चनेऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 33000550, "chapter_id": 7901, "verse_number": "24", "content_sanskrit": "मिथ्याशब्दोपपदतः पौन्ःपुण्ये कृञो णिचः । फले च कर्त्रभिप्राये स्वरितेतो ञितो णिचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 33000551, "chapter_id": 7901, "verse_number": "25", "content_sanskrit": "पचते कुरुते स्नानं कटं कारयते यथा । चुरादेरपि लक्षेर्यः स्वरितेत्त्वम् अनार्षकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 33000552, "chapter_id": 7901, "verse_number": "26", "content_sanskrit": "अपाद् वदः समाङुद्भ्यो यमेरग्रन्थगोचरे । ज्ञश्चोपसर्गरहितात् शब्दाऽन्तरगतौ तु वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 33000553, "chapter_id": 7901, "verse_number": "27", "content_sanskrit": "णिजर्थे च यजेर्नित्यं सामान्योक्तौ न तत् स्मृतम् । यथा धरित्रीं दुदुहुः कृञोऽप्यनुपरापरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 33000554, "chapter_id": 7901, "verse_number": "28", "content_sanskrit": "क्षिपोऽभिप्रत्यतिभ्यः प्रा्द्वहेर् मृषिवहोः परेः । व्याङ्परिभ्यो रम * उपाद् विभाषा चेद् अकर्मकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}, {"id": 33000555, "chapter_id": 7901, "verse_number": "29", "content_sanskrit": "आहारचलनाऽर्था ये गण्यन्ते ये त्वकर्मकाः । चित्तवत्कर्तृकास्तद्वत् तोषयत्येष पार्थिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29, "avatarnika": ""}, {"id": 33000556, "chapter_id": 7901, "verse_number": "30", "content_sanskrit": "प्रदुस्रुबुधजनयुधेङ्नशिभ्यश्च णिचो यतः । न पादमि+आङ्यमाऽऽङ्यसपरिमुहरुचिवद् वसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30, "avatarnika": ""}, {"id": 33000557, "chapter_id": 7901, "verse_number": "31", "content_sanskrit": "नृतिधेटपिबतिभ्यश्च क्यषन्तात् तु विभाषया । द्युतादेर्लुङि वृद्भ्यः स्यसनोर् लुटि च कल्पतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31, "avatarnika": ""}, {"id": 33000558, "chapter_id": 7901, "verse_number": "32", "content_sanskrit": "परस्मैपदम् अन्यस्मात् तथा शिष्टप्रयोगतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32, "avatarnika": ""}]