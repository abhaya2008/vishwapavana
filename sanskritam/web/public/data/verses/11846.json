[{"id": 50024290, "chapter_id": 11846, "verse_number": "1", "content_sanskrit": "॥ मेधातिथिः काण्वः। ऋतवः। अपिच, १ - इन्द्रः, २ - मरुतः, ३ - विष्णुरिन्द्रोऽग्निस्त्वष्टा च, ४ - अग्निः, ५ - इन्द्रः, ६ - मित्रावरुणौ, ७-१० - द्रविणोदाः, ११ - अश्विनौ, १२ - अग्निः। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024291, "chapter_id": 11846, "verse_number": "2", "content_sanskrit": "इन्द्र॒ सोमं॒ पिब॑ ऋ॒तुना त्वा॑ विश॒न्त्विन्द॑वः। म॒त्स॒रास॒स्तदो॑कसः॥ १५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024292, "chapter_id": 11846, "verse_number": "3", "content_sanskrit": "मरु॑त॒ः पिब॑त ऋ॒तुना॑ पो॒त्राद्य॒ज्ञं पु॑नीतन। यू॒यं हि ष्ठा सु॑दानवः॥ १५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024293, "chapter_id": 11846, "verse_number": "4", "content_sanskrit": "अ॒भि य॒ज्ञं गृ॑णीहि नो॒ ग्नावो॒ नेष्ट॒ः पिब॑ ऋ॒तुना॑। त्वं हि र॑त्न॒धा असि॑॥ १५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024294, "chapter_id": 11846, "verse_number": "5", "content_sanskrit": "अग्ने॑ दे॒वाँ इ॒हा व॑ह सा॒दया॒ योनि॑षु त्रि॒षु। परि॑ भूष॒ पिब॑ ऋ॒तुना॑॥ १५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024295, "chapter_id": 11846, "verse_number": "6", "content_sanskrit": "ब्राह्म॑णादिन्द्र॒ राध॑स॒ः पिबा॒ सोम॑मृ॒तूँरनु॑। तवेद्धि स॒ख्यमस्तृ॑तम्॥१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024296, "chapter_id": 11846, "verse_number": "7", "content_sanskrit": "यु॒वं दक्षं॑ धृतव्रत॒ मित्रा॑वरुण दू॒ळभ॑म्। ऋ॒तुना॑ य॒ज्ञमा॑शाथे॥ १५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024297, "chapter_id": 11846, "verse_number": "8", "content_sanskrit": "द्र॒वि॒णो॒दा द्रवि॑णसो॒ ग्राव॑हस्तासो अध्व॒रे। य॒ज्ञेषु॑ दे॒वमी॑ळते॥ १५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024298, "chapter_id": 11846, "verse_number": "9", "content_sanskrit": "द्र॒वि॒णो॒दा द॑दातु नो॒ वसू॑नि॒ यानि॑ शृण्वि॒रे। दे॒वेषु॒ ता व॑नामहे॥ १५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024299, "chapter_id": 11846, "verse_number": "10", "content_sanskrit": "द्र॒वि॒णो॒दाः पि॑पीषति जु॒होत॒ प्र च॑ तिष्ठत। ने॒ष्ट्रादृ॒तुभि॑रिष्यत॥ १५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024300, "chapter_id": 11846, "verse_number": "11", "content_sanskrit": "यत्त्वा॑ तु॒रीय॑मृ॒तुभि॒र्द्रवि॑णोदो॒ यजा॑महे। अध॑ स्मा नो द॒दिर्भ॑व॥ १५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50024301, "chapter_id": 11846, "verse_number": "12", "content_sanskrit": "अश्वि॑ना॒ पिब॑तं॒ मधु॒ दीद्य॑ग्नी शुचिव्रता। ऋ॒तुना॑ यज्ञवाहसा॥ १५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50024302, "chapter_id": 11846, "verse_number": "13", "content_sanskrit": "गार्ह॑पत्येन सन्त्य ऋ॒तुना॑ यज्ञ॒नीर॑सि। दे॒वान्दे॑वय॒ते य॑ज॥ १५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]