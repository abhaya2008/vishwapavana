[{"id": 40010772, "chapter_id": 9097, "verse_number": "1", "content_sanskrit": "विशेषेण तु सुग्रीवो हनूमत्यर्थमुक्तवान्। स हि तस्मिन्हरिश्रेष्ठे निश्चितार्थोऽर्थसाधने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40010773, "chapter_id": 9097, "verse_number": "2", "content_sanskrit": "अब्रवीच्च हनूमन्तं विक्रान्तमनिलात्मजम्। सुग्रीवः परमप्रीतः प्रभु स्सर्ववनौकसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40010774, "chapter_id": 9097, "verse_number": "3", "content_sanskrit": "न भूमौ नान्तरिक्षे वा नाम्बरे नामरालये। नाप्सु वा गतिसङ्गं ते पश्यामि हरिपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40010775, "chapter_id": 9097, "verse_number": "4", "content_sanskrit": "सासुरास्सहगन्धर्वास्सनागनरदेवताः। विदिता स्सर्वलोकास्ते ससागरधराधराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40010776, "chapter_id": 9097, "verse_number": "5", "content_sanskrit": "गतिर्वेगश्च तेजश्च लाघवं च महाकपे। पितुस्ते सदृशं वीर मारुतस्य महौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40010777, "chapter_id": 9097, "verse_number": "6", "content_sanskrit": "तेजसा वापि ते भूतं न समं भुवि न विद्यते। तद्यथा लभ्यते सीता तत्त्वमेवोपपादय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40010778, "chapter_id": 9097, "verse_number": "7", "content_sanskrit": "त्वय्येव हनुम न्नस्ति बलं बुद्धिः पराक्रमः। देशकालानुवृत्तिश्च नयश्च नयपण्डित ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40010779, "chapter_id": 9097, "verse_number": "8", "content_sanskrit": "ततः कार्यसमासङ्गमवगम्य हनूमति। विदित्वा हनुमन्तं च चिन्तयामास राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40010780, "chapter_id": 9097, "verse_number": "9", "content_sanskrit": "सर्वथा निश्चितार्थोऽयं हनूमति हरीश्वरः। निश्चितार्थकरश्चापि हनूमान्कार्यसाधने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40010781, "chapter_id": 9097, "verse_number": "10", "content_sanskrit": "तदेवं प्रस्थितस्यास्य परिज्ञातस्य कर्मभिः। भर्त्रा परिगृहीतस्य ध्रुवः कार्यफलोदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40010782, "chapter_id": 9097, "verse_number": "11", "content_sanskrit": "तं समीक्ष्य महातेजा व्यवसायोत्तरं हरिम्। कृतार्थ इव संवृत्तः प्रहृष्टेन्द्रियमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40010783, "chapter_id": 9097, "verse_number": "12", "content_sanskrit": "ददौ तस्य ततः प्रीतस्स्वनामाङ्कोपशोभितम्। अङ्गुलीयमभिज्ञानं राजपुत्र्याः परन्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40010784, "chapter_id": 9097, "verse_number": "13", "content_sanskrit": "अनेन त्वां हरिश्रेष्ठ चिह्नेन जनकात्मजा। मत्सकाशादनुप्राप्तमनुद्विग्नाऽनुपश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40010785, "chapter_id": 9097, "verse_number": "14", "content_sanskrit": "व्यवसायश्च ते वीर सत्त्वयुक्तश्च विक्रमः। सुग्रीवस्य च सन्देशस्सिद्धिं कथयतीव मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40010786, "chapter_id": 9097, "verse_number": "15", "content_sanskrit": "स तद्गृह्य हरिश्रेष्ठः स्थाप्य मूर्ध्नि कृताञ्जलिः। वन्दित्वा चरणौ चैव प्रस्थितः प्लवगोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40010787, "chapter_id": 9097, "verse_number": "16", "content_sanskrit": "स तत्प्रकर्षन् हरीणां महद्बलं बभूव वीरः पवनात्मजः कपिः। गताम्बुदे व्योम्नि विशुद्धमण्डलः शशीव नक्षत्रगणोपशोभितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40010788, "chapter_id": 9097, "verse_number": "17", "content_sanskrit": "अतिबल बलमाश्रितस्तवाहं हरिवरविक्रम विक्रमैरनल्पैः। पवनसुत यथाऽभिगम्यते सा जनकसुता हनुमं स्तथा कुरुष्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]