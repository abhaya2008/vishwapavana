[{"id": 5000097000, "chapter_id": 9097, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000097001, "chapter_id": 9097, "verse_number": "२-२०-१", "content_sanskrit": "तस्मिंस्तु पुरुषव्याघ्रे निष्क्रामति कृताञ्जलौ।\nआर्तशब्दो महान् जज्ञे स्त्रीणामन्तःपुरे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000097002, "chapter_id": 9097, "verse_number": "२-२०-२", "content_sanskrit": "कृत्येष्वचोदितः पित्रा सर्वस्यान्तःपुरस्य च।\nगतिश्च शरणं चासीत् स रामोऽद्य प्रवत्स्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000097003, "chapter_id": 9097, "verse_number": "२-२०-३", "content_sanskrit": "कौसल्यायां यथा युक्तो जनन्यां वर्तते सदा।\nतथैव वर्ततेऽस्मासु जन्मप्रभृति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000097004, "chapter_id": 9097, "verse_number": "२-२०-४", "content_sanskrit": "न क्रुध्यत्यभिशप्तोऽपि क्रोधनीयानि वर्जयन्।\nक्रुद्धान् प्रसादयन् सर्वान् स इतोऽद्य प्रवत्स्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000097005, "chapter_id": 9097, "verse_number": "२-२०-५", "content_sanskrit": "अबुद्धिर्बत नो राजा जीवलोकं चरत्ययम्।\nयो गतिं सर्वभूतानां परित्यजति राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000097006, "chapter_id": 9097, "verse_number": "२-२०-६", "content_sanskrit": "इति सर्वा महिष्यस्ता विवत्सा इव धेनवः।\nपतिमाचुक्रुशुश्चापि सस्वनं चापि चुक्रुशुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000097007, "chapter_id": 9097, "verse_number": "२-२०-७", "content_sanskrit": "स हि चान्तःपुरे घोरमार्तशब्दं महीपतिः।\nपुत्रशोकाभिसंतप्तः श्रुत्वा व्यालीयतासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000097008, "chapter_id": 9097, "verse_number": "२-२०-८", "content_sanskrit": "रामस्तु भृशमायस्तो निःश्वसन्निव कुञ्जरः।\nजगाम सहितो भ्रात्रा मातुरन्तःपुरं वशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000097009, "chapter_id": 9097, "verse_number": "२-२०-९", "content_sanskrit": "सोऽपश्यत् पुरुषं तत्र वृद्धं परमपूजितम्।\nउपविष्टं गृहद्वारि तिष्ठतश्चापरान् बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000097010, "chapter_id": 9097, "verse_number": "२-२०-१०", "content_sanskrit": "दृष्ट्वैव तु तदा रामं ते सर्वे समुपस्थिताः।\nजयेन जयतां श्रेष्ठं वर्धयन्ति स्म राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000097011, "chapter_id": 9097, "verse_number": "२-२०-११", "content_sanskrit": "प्रविश्य प्रथमां कक्ष्यां द्वितीयायां ददर्श सः।\nब्राह्मणान् वेदसम्पन्नान् वृद्धान् राज्ञाभिसत्कृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000097012, "chapter_id": 9097, "verse_number": "२-२०-१२", "content_sanskrit": "प्रणम्य रामस्तान् वृद्धांस्तृतीयायां ददर्श सः।\nस्त्रियो बालाश्च वृद्धाश्च द्वाररक्षणतत्पराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000097013, "chapter_id": 9097, "verse_number": "२-२०-१३", "content_sanskrit": "वर्धयित्वा प्रहृष्टास्ताः प्रविश्य च गृहं स्त्रियः।\nन्यवेदयन्त त्वरितं राममातुः प्रियं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000097014, "chapter_id": 9097, "verse_number": "२-२०-१४", "content_sanskrit": "कौसल्यापि तदा देवी रात्रिं स्थित्वा समाहिता।\nप्रभाते चाकरोत् पूजां विष्णोः पुत्रहितैषिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000097015, "chapter_id": 9097, "verse_number": "२-२०-१५", "content_sanskrit": "सा क्षौमवसना हृष्टा नित्यं व्रतपरायणा।\nअग्निं जुहोति स्म तदा मन्त्रवत् कृतमङ्गला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000097016, "chapter_id": 9097, "verse_number": "२-२०-१६", "content_sanskrit": "प्रविश्य तु तदा रामो मातुरन्तःपुरं शुभम्।\nददर्श मातरं तत्र हावयन्तीं हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000097017, "chapter_id": 9097, "verse_number": "२-२०-१७", "content_sanskrit": "देवकार्यनिमित्तं च तत्रापश्यत् समुद्यतम्।\nदध्यक्षतघृतं चैव मोदकान् हविषस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000097018, "chapter_id": 9097, "verse_number": "२-२०-१८", "content_sanskrit": "लाजान् माल्यानि शुक्लानि पायसं कृसरं तथा।\nसमिधः पूर्णकुम्भांश्च ददर्श रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000097019, "chapter_id": 9097, "verse_number": "२-२०-१९", "content_sanskrit": "तां शुक्लक्षौमसंवीतां व्रतयोगेन कर्शिताम्।\nतर्पयन्तीं ददर्शाद्भिर्देवतां वरवर्णिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000097020, "chapter_id": 9097, "verse_number": "२-२०-२०", "content_sanskrit": "सा चिरस्यात्मजं दृष्ट्वा मातृनन्दनमागतम्।\nअभिचक्राम संहृष्टा किशोरं वडवा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000097021, "chapter_id": 9097, "verse_number": "२-२०-२१", "content_sanskrit": "स मातरमुपक्रान्तामुपसंगृह्य राघवः।\nपरिष्वक्तश्च बाहुभ्यामवघ्रातश्च मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000097022, "chapter_id": 9097, "verse_number": "२-२०-२२", "content_sanskrit": "तमुवाच दुराधर्षं राघवं सुतमात्मनः।\nकौसल्या पुत्रवात्सल्यादिदं प्रियहितं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000097023, "chapter_id": 9097, "verse_number": "२-२०-२३", "content_sanskrit": "वृद्धानां धर्मशीलानां राजर्षीणां महात्मनाम्।\nप्राप्नुह्यायुश्च कीर्तिं च धर्मं चाप्युचितं कुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000097024, "chapter_id": 9097, "verse_number": "२-२०-२४", "content_sanskrit": "सत्यप्रतिज्ञं पितरं राजानं पश्य राघव।\nअद्यैव त्वां स धर्मात्मा यौवराज्येऽभिषेक्ष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000097025, "chapter_id": 9097, "verse_number": "२-२०-२५", "content_sanskrit": "दत्तमासनमालभ्य भोजनेन निमन्त्रितः।\nमातरं राघवः किंचित् प्रसार्याञ्जलिमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000097026, "chapter_id": 9097, "verse_number": "२-२०-२६", "content_sanskrit": "स स्वभावविनीतश्च गौरवाच्च तथानतः।\nप्रस्थितो दण्डकारण्यमाप्रष्टुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000097027, "chapter_id": 9097, "verse_number": "२-२०-२७", "content_sanskrit": "देवि नूनं न जानीषे महद् भयमुपस्थितम्।\nइदं तव च दुःखाय वैदेह्या लक्ष्मणस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000097028, "chapter_id": 9097, "verse_number": "२-२०-२८", "content_sanskrit": "गमिष्ये दण्डकारण्यं किमनेनासनेन मे।\nविष्टरासनयोग्यो हि कालोऽयं मामुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000097029, "chapter_id": 9097, "verse_number": "२-२०-२९", "content_sanskrit": "चतुर्दश हि वर्षाणि वत्स्याम विजने वने।\nकन्दमूलफलैर्जीवन् हित्वा मुनिवदामिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000097030, "chapter_id": 9097, "verse_number": "२-२०-३०", "content_sanskrit": "भरताय महाराजो यौवराज्यं प्रयच्छति।\nमां पुनर्दण्डकारण्यं विवासयति तापसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000097031, "chapter_id": 9097, "verse_number": "२-२०-३१", "content_sanskrit": "स षट् चाष्टौ च वर्षाणि वत्स्यामि विजने वने।\nआसेवमानो वन्यानि फलमूलैश्च वर्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000097032, "chapter_id": 9097, "verse_number": "२-२०-३२", "content_sanskrit": "सा निकृत्तेव सालस्य यष्टिः परशुना वने।\nपपात सहसा देवी देवतेव दिवश्च्युता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000097033, "chapter_id": 9097, "verse_number": "२-२०-३३", "content_sanskrit": "तामदुःखोचितां दृष्ट्वा पतितां कदलीमिव।\nरामस्तूत्थापयामास मातरं गतचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000097034, "chapter_id": 9097, "verse_number": "२-२०-३४", "content_sanskrit": "उपावृत्योत्थितां दीनां वडवामिव वाहिताम्।\nपांसुगुण्ठितसर्वाङ्गीं विममर्श च पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000097035, "chapter_id": 9097, "verse_number": "२-२०-३५", "content_sanskrit": "सा राघवमुपासीनमसुखार्ता सुखोचिता।\nउवाच पुरुषव्याघ्रमुपशृण्वति लक्ष्मणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000097036, "chapter_id": 9097, "verse_number": "२-२०-३६", "content_sanskrit": "यदि पुत्र न जायेथा मम शोकाय राघव।\nन स्म दुःखमतो भूयः पश्येयमहमप्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000097037, "chapter_id": 9097, "verse_number": "२-२०-३७", "content_sanskrit": "एक एव हि वन्ध्यायाः शोको भवति मानसः।\nअप्रजास्मीति संतापो न ह्यन्यः पुत्र विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000097038, "chapter_id": 9097, "verse_number": "२-२०-३८", "content_sanskrit": "न दृष्टपूर्वं कल्याणं सुखं वा पतिपौरुषे।\nअपि पुत्रे विपश्येयमिति रामास्थितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000097039, "chapter_id": 9097, "verse_number": "२-२०-३९", "content_sanskrit": "सा बहून्यमनोज्ञानि वाक्यानि हृदयच्छिदाम्।\nअहं श्रोष्ये सपत्नीनामवराणां परा सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000097040, "chapter_id": 9097, "verse_number": "२-२०-४०", "content_sanskrit": "अतो दुःखतरं किं नु प्रमदानां भविष्यति।\nमम शोको विलापश्च यादृशोऽयमनन्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000097041, "chapter_id": 9097, "verse_number": "२-२०-४१", "content_sanskrit": "त्वयि संनिहितेऽप्येवमहमासं निराकृता।\nकिं पुनः प्रोषिते तात ध्रुवं मरणमेव हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000097042, "chapter_id": 9097, "verse_number": "२-२०-४२", "content_sanskrit": "अत्यन्तं निगृहीतास्मि भर्तुर्नित्यमसम्मता।\nपरिवारेण कैकेय्याः समा वाप्यथवावरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000097043, "chapter_id": 9097, "verse_number": "२-२०-४३", "content_sanskrit": "यो हि मां सेवते कश्चिदपि वाप्यनुवर्तते।\nकैकेय्याः पुत्रमन्वीक्ष्य स जनो नाभिभाषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000097044, "chapter_id": 9097, "verse_number": "२-२०-४४", "content_sanskrit": "नित्यक्रोधतया तस्याः कथं नु खरवादि तत्।\nकैकेय्या वदनं द्रष्टुं पुत्र शक्ष्यामि दुर्गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000097045, "chapter_id": 9097, "verse_number": "२-२०-४५", "content_sanskrit": "दश सप्त च वर्षाणि जातस्य तव राघव।\nअतीतानि प्रकांक्षन्त्या मया दुःखपरिक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000097046, "chapter_id": 9097, "verse_number": "२-२०-४६", "content_sanskrit": "तदक्षयं महद्दुःखं नोत्सहे सहितुं चिरात्।\nविप्रकारं सपत्नीनामेवं जीर्णापि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000097047, "chapter_id": 9097, "verse_number": "२-२०-४७", "content_sanskrit": "अपश्यन्ती तव मुखं परिपूर्णशशिप्रभम्।\nकृपणा वर्तयिष्यामि कथं कृपणजीविका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000097048, "chapter_id": 9097, "verse_number": "२-२०-४८", "content_sanskrit": "उपवासैश्च योगैश्च बहुभिश्च परिश्रमैः।\nदुःखसंवर्धितो मोघं त्वं हि दुर्गतया मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000097049, "chapter_id": 9097, "verse_number": "२-२०-४९", "content_sanskrit": "स्थिरं नु हृदयं मन्ये ममेदं यन्न दीर्यते।\nप्रावृषीव महानद्याः स्पृष्टं कूलं नवाम्भसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000097050, "chapter_id": 9097, "verse_number": "२-२०-५०", "content_sanskrit": "ममैव नूनं मरणं न विद्यते\nन चावकाशोऽस्ति यमक्षये मम।\nयदन्तकोऽद्यैव न मां जिहीर्षति\nप्रसह्य सिंहो रुदतीं मृगीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000097051, "chapter_id": 9097, "verse_number": "२-२०-५१", "content_sanskrit": "स्थिरं हि नूनं हृदयं ममायसं\nन भिद्यते यद् भुवि नो विदीर्यते।\nअनेन दुःखेन च देहमर्पितं\nध्रुवं ह्यकाले मरणं न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000097052, "chapter_id": 9097, "verse_number": "२-२०-५२", "content_sanskrit": "इदं तु दुःखं यदनर्थकानि मे\nव्रतानि दानानि च संयमाश्च हि।\nतपश्च तप्तं यदपत्यकाम्यया\nसुनिष्फलं बीजमिवोप्तमूषरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000097053, "chapter_id": 9097, "verse_number": "२-२०-५३", "content_sanskrit": "यदि ह्यकाले मरणं यदृच्छया\nलभेत कश्चिद् गुरुदुःखकर्शितः।\nगताहमद्यैव परेतसंसदं\nविना त्वया धेनुरिवात्मजेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000097054, "chapter_id": 9097, "verse_number": "२-२०-५४", "content_sanskrit": "अथापि किं जीवितमद्य मे वृथा\nत्वया विना चन्द्रनिभाननप्रभ।\nअनुव्रजिष्यामि वनं त्वयैव गौः\nसुदुर्बला वत्समिवाभिकांक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000097055, "chapter_id": 9097, "verse_number": "२-२०-५५", "content_sanskrit": "भृशमसुखममर्षिता तदा\nबहु विललाप समीक्ष्य राघवम्।\nव्यसनमुपनिशाम्य सा महत्\nसुतमिव बद्धमवेक्ष्य किंनरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000097056, "chapter_id": 9097, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे विंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]