[{"id": 2103048, "chapter_id": 3235, "verse_number": "१४-९१-१", "content_sanskrit": "जनमेजय उवाच।\nपितामहस्य मे यज्ञे धर्मराजस्य धीमतः।\nयदाश्चर्यमभूत्किञ्चित्तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2103049, "chapter_id": 3235, "verse_number": "१४-९१-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2103050, "chapter_id": 3235, "verse_number": "१४-९१-२", "content_sanskrit": "श्रूयतां राजशार्दूल महदाश्चर्यमुत्तमम्।\nअश्वमेधे महायज्ञे निवृत्ते यदभूत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2103051, "chapter_id": 3235, "verse_number": "१४-९१-३", "content_sanskrit": "तर्पितेषु द्विजाग्र्येषु ज्ञातिसम्बन्धिबन्धुषु।\nदीनान्धकृपणे वाऽपि तदा भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2103052, "chapter_id": 3235, "verse_number": "१४-९१-४", "content_sanskrit": "घुष्यमाणे महादाने दिक्षु सर्वासु भारत।\nपतत्सु पुष्पवर्षेषु धर्मराजस्य मूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2103053, "chapter_id": 3235, "verse_number": "१४-९१-५", "content_sanskrit": "बिलान्निस्सृत्य नकुलो रुक्मपार्श्वस्तदाऽनघः।\nवज्राशनिसमं नादममुञ्चद्वसुधाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2103054, "chapter_id": 3235, "verse_number": "१४-९१-६", "content_sanskrit": "सकृदुत्सृज्य तन्नादं त्रासयानो मृगद्विजान्।\nमानुपं वचनं प्राह पुष्पोपरिशयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2103055, "chapter_id": 3235, "verse_number": "१४-९१-७", "content_sanskrit": "सक्तुप्रस्थेन वो नायं यज्ञस्तुल्यो नराधिपाः।\nउच्छवृत्तेर्वदान्यस्य कुरुक्षेत्रनिवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2103056, "chapter_id": 3235, "verse_number": "१४-९१-८", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा नकुलस्य विशांपते।\nविस्मयं परमं जग्मुः सर्वे ते ब्राह्मणर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2103057, "chapter_id": 3235, "verse_number": "१४-९१-९", "content_sanskrit": "ततः समेत्य नकुलं पर्यपृच्छन्त ते द्विजाः॥\nकुतस्त्वं समनुप्राप्तो यज्ञं साधुसमागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2103058, "chapter_id": 3235, "verse_number": "१४-९१-१०", "content_sanskrit": "किं बलं परमं तुभ्यं श्रुतं किं परायणम्।\nकथं भवन्तं विद्याम यो नो यज्ञं विगर्हसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2103059, "chapter_id": 3235, "verse_number": "१४-९१-११", "content_sanskrit": "अविलुप्यागमं कृत्स्नं विविधैर्यज्ञियैः कृतम्।\nयथागमं यथान्यायं कर्तव्यं च तथा कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2103060, "chapter_id": 3235, "verse_number": "१४-९१-१२", "content_sanskrit": "पूजार्हाः पूजिताश्चात्र विधिवच्छास्त्रदर्शात्।\nमन्त्राहुतिहुतश्चाग्निर्दत्तं देयममत्सरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2103061, "chapter_id": 3235, "verse_number": "१४-९१-१३", "content_sanskrit": "तुष्टा द्विजातयश्चात्र दानैर्बहुविधैरपि।\nक्षत्रियाश्चि सुयुद्धेन श्राद्धैश्चापि पितामहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2103062, "chapter_id": 3235, "verse_number": "१४-९१-१४", "content_sanskrit": "पालनेन विशस्तुष्टाः कामैस्तुष्टा वरस्त्रियः।\nअनुक्रोशैस्तता शूद्रा दानशेषैः पृथग्जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2103063, "chapter_id": 3235, "verse_number": "१४-९१-१५", "content_sanskrit": "ज्ञातिसम्बन्धिनस्तुष्टाः शौचेन च नृपस्य नः।\nदेवा हविर्भिः पुण्यैस्च रक्षणैः शरणागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2103064, "chapter_id": 3235, "verse_number": "१४-९१-१६", "content_sanskrit": "यदत्र तथ्यं तद्ब्रूहि सत्यंसत्यं द्विजातिषु।\nयथाश्रुतं यथादृष्टं पृष्टो ब्राह्मणकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2103065, "chapter_id": 3235, "verse_number": "१४-९१-१७", "content_sanskrit": "श्रद्धेयवाक्यः प्राज्ञस्त्वं दिव्यं रूपं बिभर्षि च।\nसमागतश्च विप्रैस्त्वं तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2103066, "chapter_id": 3235, "verse_number": "१४-९१-१८", "content_sanskrit": "इति पृष्टो द्विजैस्तैः स प्रहसन्नकुलोऽब्रवीत्।\nनैषा मृषामया वाणी प्रोक्ता दर्पेण वा द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2103067, "chapter_id": 3235, "verse_number": "१४-९१-१९", "content_sanskrit": "यन्मयोक्तमिदं वाक्यं युष्माभिश्चाप्युपश्रुतम्।\nसक्तुप्रस्थेन वो नायं यज्ञस्तुल्यो द्विजर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2103068, "chapter_id": 3235, "verse_number": "१४-९१-२०", "content_sanskrit": "इत्यवश्यं मयैतद्वो वक्तव्यं द्विजसत्तमाः।\nशृणुताव्यग्रमनसः शंसतो मे यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2103069, "chapter_id": 3235, "verse_number": "१४-९१-२१", "content_sanskrit": "अनुभूतं च दृष्टं च यन्मयाऽद्भुतमुत्तमम्।\nउञ्छवृत्तेर्वदान्यस्य कुरुक्षेत्रनिवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2103070, "chapter_id": 3235, "verse_number": "१४-९१-२२", "content_sanskrit": "स्वर्गं येन द्विजाः प्राप्तः सभार्यः ससुतस्नुषः।\nयथा चार्धं शरीरस्य ममेदं काञ्चनीकृतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2103071, "chapter_id": 3235, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि एकनवतितमोऽध्यायः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]