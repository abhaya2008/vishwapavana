[{"id": 2015356, "chapter_id": 1323, "verse_number": "२-६४-१", "content_sanskrit": "शिशुपाल उवाच।\nबिभीषिकाभिर्बह्वीभिर्भीषयन्भीष्म पार्थिवान्।\nन व्यपत्रपसे कस्माद्वृद्धः सन्कुलपांसनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015357, "chapter_id": 1323, "verse_number": "२-६४-२", "content_sanskrit": "युक्तमेतत्तृतीयायां प्रकृतौ वर्तता त्वया।\nवक्तुं धर्मादपेतार्थं त्वं हि सर्वकुरूत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015358, "chapter_id": 1323, "verse_number": "२-६४-३", "content_sanskrit": "नावि नौरिव सम्बद्धा यथान्धो वान्धमन्वियात्।\nतथाभूता हि कौरव्या येषां भीष्म त्वमग्रणीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015359, "chapter_id": 1323, "verse_number": "२-६४-४", "content_sanskrit": "पूतनाघातपूर्वाणि कर्माण्यस्य विशेषतः।\nत्वया कीर्तयताऽस्माकं भूयः प्रव्यथितं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015360, "chapter_id": 1323, "verse_number": "२-६४-५", "content_sanskrit": "अवलिप्तस्य मूर्शस्य केशवं स्तोतुमिच्छतः।\nकथं भीष्म न ते जिह्वा शतधेयं विदीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015361, "chapter_id": 1323, "verse_number": "२-६४-६", "content_sanskrit": "यत्र कुत्सा प्रयोक्तव्या भीष्म बालतरैर्नरैः।\nतमिमं ज्ञानवृद्धः सन्गोपं संस्तोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015362, "chapter_id": 1323, "verse_number": "२-६४-७", "content_sanskrit": "यद्यनेन हता बाल्ये शकुनिश्चित्रमत्र किम्।\nतौ वाऽश्ववृषभौ भीष्ण यौ न युद्धविशारदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015363, "chapter_id": 1323, "verse_number": "२-६४-८", "content_sanskrit": "चेतनारहितं काष्ठं यद्यनेन निपातितम्।\nपादेन शकटं भीष्ण तत्र किं कृतमद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015364, "chapter_id": 1323, "verse_number": "२-६४-९", "content_sanskrit": "अर्कप्रमाणौ तौ वृक्षौ यद्यनेन निपातितौ।\nनागश्च दमितोऽनेन तत्र को विस्मयः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015365, "chapter_id": 1323, "verse_number": "२-६४-१०", "content_sanskrit": "वल्मीकमात्रः सप्ताहं यद्यनेन धृतोऽचलः।\nतदा गोवर्धनो भीष्म न तच्चित्रं मतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015366, "chapter_id": 1323, "verse_number": "२-६४-११", "content_sanskrit": "भुक्तमेतेन बह्वन्नं क्रीडता नगमूर्धनि।\nइति ते भीष्ण शृण्वानाः परे विस्मयमागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015367, "chapter_id": 1323, "verse_number": "२-६४-१२", "content_sanskrit": "यस्य चानेन धर्मज्ञ भुक्तमन्नं बलीयसः।\nस चानेन हतः कंस इत्येतत्तु बलीयसः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015368, "chapter_id": 1323, "verse_number": "२-६४-१३", "content_sanskrit": "स चानेन हतः कंस इत्येतत्तु महाद्भुतम्॥\nन ते श्रुतमिदं भीष्म नूनं कथयतां सताम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015369, "chapter_id": 1323, "verse_number": "२-६४-१४", "content_sanskrit": "यद्वक्ष्ये त्वामधर्मज्ञं वाक्यं कुरुकुलाधम॥\nस्त्रीषु गोषु न शस्त्राणि पातयेद्ब्राह्मणेषु च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015370, "chapter_id": 1323, "verse_number": "२-६४-१५", "content_sanskrit": "इति सन्तोऽनुशासन्ति सञ्जना धर्मिणः सदा।\nभीष्म लोके हि तत्सर्वं वितथं त्वयि दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015371, "chapter_id": 1323, "verse_number": "२-६४-१६", "content_sanskrit": "ज्ञानवृद्धं च वृद्धं च भूयांसं केशवं मम।\nअजानत इवाख्यासि संस्तुवन्कौरवाधम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015372, "chapter_id": 1323, "verse_number": "२-६४-१७", "content_sanskrit": "गोघ्रः स्त्रीघ्नश्च सन्भीष्म त्वद्वाक्याद्यदि पूज्यते।\nएवम्भूतश्च यो भीष्म कथं संस्तवमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015373, "chapter_id": 1323, "verse_number": "२-६४-१८", "content_sanskrit": "असौ मतिमतां श्रेष्ठो य एष जगतः प्रभुः।\nसम्भावयति चाप्येवं त्वद्वाक्याच्च जनार्दनः।\nएवमेतत्सर्वमिति तत्सर्वं वितथं ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015374, "chapter_id": 1323, "verse_number": "२-६४-१९", "content_sanskrit": "आत्मानमात्मनाऽऽधातुं यदि शक्तो जनार्दनः।\nअकामयन्तं तं भीष्म कथं साध्विव पश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015375, "chapter_id": 1323, "verse_number": "२-६४-२०", "content_sanskrit": "न गाथा गाथिनं शास्ति बहुचेदपि गायति।\nप्रकृतिं यान्ति भूतानि कुलिङ्गशकुनिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015376, "chapter_id": 1323, "verse_number": "२-६४-२१", "content_sanskrit": "नूनं प्रकृतिरेषा ते जघन्या नात्र संशयटः।\nनदीसुतत्वात्ते चित्तं चञ्चलं न स्थिरं स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015377, "chapter_id": 1323, "verse_number": "२-६४-२२", "content_sanskrit": "अतः पापीयसी चैषां पाण्डवानामपीष्यते।\nयेषामर्च्यतमः कृष्णस्त्वं च येषां प्रदर्शकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015378, "chapter_id": 1323, "verse_number": "२-६४-२३", "content_sanskrit": "धर्मवांस्त्वमधर्मज्ञः सतां मार्गादवप्लुतः।\nको हि धर्मिणमात्मानं जानञ्ज्ञानविदां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015379, "chapter_id": 1323, "verse_number": "२-६४-२४", "content_sanskrit": "कुर्याद्यथा त्वया भीषम कृतं धर्ममवेक्षता।\nचेत्त्वं धर्मं विजानासि यदि प्राज्ञा मतिस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015380, "chapter_id": 1323, "verse_number": "२-६४-२५", "content_sanskrit": "अन्यकामा हि धर्मज्ञा कन्यका प्राज्ञमानिना।\nअम्बा नामेति भद्रं ते कथं साऽपहृता त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015381, "chapter_id": 1323, "verse_number": "२-६४-२६", "content_sanskrit": "तां त्वयाऽपहृतां भीष्म कन्यां नैषितवान्नृपः।\nभ्राता विचित्रवीर्यस्ते सतां मार्गमनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015382, "chapter_id": 1323, "verse_number": "२-६४-२७", "content_sanskrit": "भार्ययोर्यस्य चान्येन मिषतः प्राज्ञमानिनः।\nतव जातान्यपत्यानि सज्जनाचरिते पथि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015383, "chapter_id": 1323, "verse_number": "२-६४-२८", "content_sanskrit": "को हि धर्मोऽस्ति ते भीषम ब्रह्मचर्यमिदं वृथा।\nयद्धारयसि मोहाद्वा क्लीबत्वाद्वा न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015384, "chapter_id": 1323, "verse_number": "२-६४-२९", "content_sanskrit": "न त्वं तव धर्मज्ञ पश्याम्युपचरं क्वचित्।\nन हि ते सेविता वृद्धा य एवं धर्ममब्रवीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015385, "chapter_id": 1323, "verse_number": "२-६४-३०", "content_sanskrit": "इष्टं दत्तमधीतं च यज्ञाश्च बहुदक्षिणाः।\nसर्वमेतदपत्यस्य कलां नार्हन्ति षोडशीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015386, "chapter_id": 1323, "verse_number": "२-६४-३१", "content_sanskrit": "व्रतोपवासैर्बहुभिः कृतं भवति भीष्म यत्।\nसर्वं तदनपत्यस्य मोघं भवति निश्चयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015387, "chapter_id": 1323, "verse_number": "२-६४-३२", "content_sanskrit": "सोऽनपत्यश्च वृद्धश्च मिथ्याधर्मानुशासनात्।\nहंसवत्त्वमपीदानीं ज्ञातिभ्यः प्राप्नुया वधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015388, "chapter_id": 1323, "verse_number": "२-६४-३३", "content_sanskrit": "एवं हि कथयन्त्यन्ये नरा ज्ञानविदः पुरा।\nभीष्म यत्तदहं सम्यग्वक्ष्यामि तव शृण्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015389, "chapter_id": 1323, "verse_number": "२-६४-३४", "content_sanskrit": "वृद्धः किल समुद्रान्ते कश्चिद्धंसोऽभवत्पुरा।\nधर्मवागन्यथावृत्तः पक्षिणः सोऽनुशास्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015390, "chapter_id": 1323, "verse_number": "२-६४-३५", "content_sanskrit": "धर्म चरत माऽधर्ममिति तस्य वचः किल।\nपक्षिणः शुश्रुवुर्भीष्म सततं धर्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2015391, "chapter_id": 1323, "verse_number": "२-६४-३६", "content_sanskrit": "हंसस्य तु वचः श्रुत्वा मुदिताः सर्वपक्षिणः।\nऊचुश्चैव स्वगा हंसं परिवार्य च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2015392, "chapter_id": 1323, "verse_number": "२-६४-३७", "content_sanskrit": "कथयस्व भवान्सर्वं पक्षिणां तु समासतः।\nको हि नाम द्विजश्रेष्ठ ब्रूहि नो धर्म उत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2015393, "chapter_id": 1323, "verse_number": "२-६४-३८x", "content_sanskrit": "हंस उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2015394, "chapter_id": 1323, "verse_number": "२-६४-३८", "content_sanskrit": "प्रजास्वहिंसा धर्मो वै हिंसाऽधर्मः खगव्रजाः।\nएतदेवानुबोद्धव्यं धर्माधर्मः समासतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2015395, "chapter_id": 1323, "verse_number": "२-६४-३९x", "content_sanskrit": "शिशुपाल उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2015396, "chapter_id": 1323, "verse_number": "२-६४-३९", "content_sanskrit": "वृद्धहंसवचः श्रुत्वा पक्षिणस्ते सुसंहिताः।\nऊचुश्च धर्मलुब्धास्ते स्मयमाना इवाण्डजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2015397, "chapter_id": 1323, "verse_number": "२-६४-४०", "content_sanskrit": "धर्मं यः कुरुते नित्यं लोके धीरतरोऽण्डजः।\nस यत्र गच्छेद्धर्मात्मा तन्मे ब्रूहीह तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2015398, "chapter_id": 1323, "verse_number": "२-६४-४१x", "content_sanskrit": "हंस उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2015399, "chapter_id": 1323, "verse_number": "२-६४-४१", "content_sanskrit": "बाला यूयं न जानीध्वं धर्मसूक्ष्मं विहङ्गमाः।\nधर्मं यः कुरुते लोके सततं शुभबुद्धिना।\nन चायुषोऽन्ते स्वं देहं त्यक्त्वा स्वर्गं स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2015400, "chapter_id": 1323, "verse_number": "२-६४-४२", "content_sanskrit": "तथाऽहमपि च त्यक्त्वा काले देहमिमं द्विजाः।\nस्वर्गलोकं गमिष्यामि इयं धर्मस्य वै गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2015401, "chapter_id": 1323, "verse_number": "२-६४-४३", "content_sanskrit": "एवं धर्मकथां चक्रे स हंसः पक्षिणां भृशम्।\nपक्षिणः शुश्रुवुर्भीष्म सततं धर्ममेव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2015402, "chapter_id": 1323, "verse_number": "२-६४-४४", "content_sanskrit": "अथास्य भक्ष्यमाजह्रुः समुद्रजलचारिणः।\nअण्डजा भीष्म तस्यान्ये धर्मार्थमिति शुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2015403, "chapter_id": 1323, "verse_number": "२-६४-४५", "content_sanskrit": "ते च तस्य समभ्याशे निक्षिप्याण्डानि सर्वशः।\nसमुद्राम्भस्यमोदन्त चरन्तो भीष्म पक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2015404, "chapter_id": 1323, "verse_number": "२-६४-४६", "content_sanskrit": "तेषामण्डानि सर्वेषां भक्षयामास पापकृत्।\nस हंसः सम्प्रमत्तानामप्रमत्तः स्वकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2015405, "chapter_id": 1323, "verse_number": "२-६४-४७", "content_sanskrit": "ततः प्रक्षीयमाणेषु तेषु तेष्वण्डजोऽपरः।\nअशङ्कत महाप्राज्ञः स कदाचिद्ददर्श ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2015406, "chapter_id": 1323, "verse_number": "२-६४-४८", "content_sanskrit": "ततः सङ्कथयामास दृष्ट्वा हंसस्य किल्बिषम्।\nतेषां परमदुःखार्तः स पक्षी सर्वपक्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2015407, "chapter_id": 1323, "verse_number": "२-६४-४९", "content_sanskrit": "ततः प्रत्यक्षतो दृष्ट्वा पक्षिणस्ते समीपगाः।\nनिजघ्नस्तं तदा हंसं मिथ्यावृत्तं कुरूद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2015408, "chapter_id": 1323, "verse_number": "२-६४-५०", "content_sanskrit": "एवं त्वां हंसधर्माणमपीमे वसुधाधिपाः।\nनिहन्युर्भीष्म सङ्क्रुद्धाः पक्षिणस्तं यथाण्डजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2015409, "chapter_id": 1323, "verse_number": "२-६४-५१", "content_sanskrit": "गाथामप्यत्र गायन्ति ये पुराणविदो जनाः।\nभीष्म यां तां च ते सम्यक्वथयिष्यामि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2015410, "chapter_id": 1323, "verse_number": "२-६४-५२", "content_sanskrit": "अन्तरात्मन्यभिहते रौषि पत्ररथाशुचि।\nअण्डभक्षणकर्मैतत्तव वाचमतीयते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2015411, "chapter_id": 1323, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि शिशुपालवधपर्वणि चतुःषष्टितोऽध्यायः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]