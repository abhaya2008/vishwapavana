[{"id": 2190160, "chapter_id": 5047, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2190161, "chapter_id": 5047, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nतुलाधारस्य वाक्यानि धर्मे जाजलिना सह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2190162, "chapter_id": 5047, "verse_number": "२", "content_sanskrit": "वने वनचरः कश्चिज्जाजलिर्नाम वै द्विजः ।\nसागरोद्देशमागम्य तपस्तेपे महातपाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2190163, "chapter_id": 5047, "verse_number": "३", "content_sanskrit": "नियतो नियताहारश्चीराजिनजटाधरः ।\nमलपङ्कधरो धीमान् बहून् वर्षगणान् मुनिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190164, "chapter_id": 5047, "verse_number": "४", "content_sanskrit": "स कदाचिन्महातेजा जलवासो महीपते ।\nचचार लोकान् विप्रर्षिः प्रेक्षमाणो मनोजवः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190165, "chapter_id": 5047, "verse_number": "५", "content_sanskrit": "स चिन्तयामास मुनिर्जलमध्ये कदाचन ।\nविप्रेक्ष्य सागरान्तां वै महीं सवनकाननाम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190166, "chapter_id": 5047, "verse_number": "६", "content_sanskrit": "न मया सदृशोऽस्तीह लोके स्थावरजङ्गमे ।\nअप्सु वैहायसं गच्छेन्मया योऽन्यः सहेति वै\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190167, "chapter_id": 5047, "verse_number": "७", "content_sanskrit": "स दृश्यमानो रक्षोभिर्जलमध्येऽवदत्ततः ।\nअब्रुवंश्च पिशाचास्तं नैवं त्वं वक्तुमर्हसि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190168, "chapter_id": 5047, "verse_number": "८", "content_sanskrit": "तुलाधारो वणिग्धर्मा वाराणस्यां महायशाः ।\nसोऽप्येवं नार्हते वक्तुं यथा त्वं द्विजसत्तम\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2190169, "chapter_id": 5047, "verse_number": "९", "content_sanskrit": "इत्युक्तो जाजलिर्भूतैः प्रत्युवाच महातपाः ।\nपश्येयं तमहं प्राज्ञं तुलाधारं यशस्विनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2190170, "chapter_id": 5047, "verse_number": "समाप्तिः", "content_sanskrit": "इति ब्रुवाणं तमृषिं रक्षांस्युद्धृत्य सागरात् ।\nअब्रुवन् गच्छ पन्थानमास्थायेमं द्विजोत्तम\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2190171, "chapter_id": 5047, "verse_number": "११", "content_sanskrit": "इत्युक्तो जाजलिर्भूतैर्जगाम विमनास्तदा ।\nवाराणस्यां तुलाधारं समासाद्याब्रवीद् वचः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2190172, "chapter_id": 5047, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2190173, "chapter_id": 5047, "verse_number": "१२", "content_sanskrit": "किं कृतं सुकृतं कर्म तात जाजलिना पुरा ।\nयेन सिद्धिं परां प्राप्तस्तन्नो व्याख्यातुमर्हसि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2190174, "chapter_id": 5047, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2190175, "chapter_id": 5047, "verse_number": "१३", "content_sanskrit": "अतीव तपसा युक्तो घोरेण स बभूव ह ।\nनद्युपस्पर्शनरतः सायं प्रातर्महातपाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2190176, "chapter_id": 5047, "verse_number": "१४", "content_sanskrit": "अग्नीन् परिचरन् सम्यक्स्वाध्यायपरमो द्विजः ।\nवानप्रस्थविधानज्ञो जाजलिर्ज्वलितः श्रिया\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2190177, "chapter_id": 5047, "verse_number": "१५", "content_sanskrit": "सत्ये तपसि तिष्ठन् स न च धर्ममवैक्षत ।\nवर्षास्वाकाशशायी स हेमन्ते जलसंश्रयः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2190178, "chapter_id": 5047, "verse_number": "१६", "content_sanskrit": "वातातपसहो ग्रीष्मे न च धर्ममविन्दत ।\nदुःखशय्याश्च विविधा भूमौ च परिवर्तनम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2190179, "chapter_id": 5047, "verse_number": "१७", "content_sanskrit": "ततः कदाचित्स मुनिर्वर्षास्वाकाशमास्थितः ।\nअन्तरिक्षाज्जलं मूर्ध्ना प्रत्यगृह्णान्मुहुर्मुहुः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2190180, "chapter_id": 5047, "verse_number": "१८", "content_sanskrit": "अथ तस्य जटाः क्लिन्ना बभूवुर्ग्रथिताः प्रभो ।\nअरण्यगमनान्नित्यं मलिनो मलसंयुताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2190181, "chapter_id": 5047, "verse_number": "१९", "content_sanskrit": "स कदाचिन्निराहारो वायुभक्षो महातपाः ।\nतस्थौ काष्ठवदव्यग्रो न चचाल च कर्हिचित्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2190182, "chapter_id": 5047, "verse_number": "२०", "content_sanskrit": "तस्य स्म स्थाणुभूतस्य निर्विचेष्टस्य भारत ।\nकुलिङ्गशकुनौ राजन्नीडं शिरसि चक्रतुः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2190183, "chapter_id": 5047, "verse_number": "२१", "content_sanskrit": "स तौ दयावान् विप्रर्षिरुपप्रैक्षत दम्पती ।\nकुर्वाणं नीडकं तत्र जटासु तृणतन्तुभिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2190184, "chapter_id": 5047, "verse_number": "२२", "content_sanskrit": "यदा स न चलत्येव स्थाणुभूतो महातपाः ।\nततस्तौ परिविश्वस्तौ सुखं तत्रोषतुस्तदा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2190185, "chapter_id": 5047, "verse_number": "२३", "content_sanskrit": "अतीतास्वथ वर्षासु शरत्काल उपस्थिते ।\nप्राजापत्येन विधिना विश्वासात् काममोहितौ\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2190186, "chapter_id": 5047, "verse_number": "२४", "content_sanskrit": "तत्रापातयतां राजन् शिरस्यण्डानि खेचरौ ।\nतान्यबुध्यत तेजस्वी स विप्रः संशितव्रतः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2190187, "chapter_id": 5047, "verse_number": "२५", "content_sanskrit": "बुद्ध्वा च स महातेजा न चचालैव जाजलिः ।\nधर्मे धृतमना नित्यं नाधर्मं स त्वरोचयत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2190188, "chapter_id": 5047, "verse_number": "२६", "content_sanskrit": "अहन्यहनि चागम्य ततस्तौ तस्य मूर्धनि ।\nआश्वासितौ वै वसतः सम्प्रहृष्टौ तदा विभो\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2190189, "chapter_id": 5047, "verse_number": "२७", "content_sanskrit": "अण्डेभ्यस्त्वथ पुष्टेभ्यः प्रजायन्त शकुन्तकाः ।\nव्यवर्धन्त च तत्रैव न चाकम्पत जाजलिः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2190190, "chapter_id": 5047, "verse_number": "२८", "content_sanskrit": "स रक्षमाणस्त्वण्डानि कुलिङ्गानां यतव्रतः ।\nतथैव तस्थौ धर्मात्मा निर्विचेष्टः समाहितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2190191, "chapter_id": 5047, "verse_number": "२९", "content_sanskrit": "ततस्तु कालसमये बभूवुस्तेऽथ पक्षिणः ।\nबुबुधे तांश्च स मुनिर्जातपक्षान् शकुन्तकान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2190192, "chapter_id": 5047, "verse_number": "३०", "content_sanskrit": "ततः कदाचित्तांस्तत्र पश्यन् पक्षीन्यतव्रतः ।\nबभूव परमप्रीतस्तदा मतिमतां वरः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2190193, "chapter_id": 5047, "verse_number": "३१", "content_sanskrit": "तथा तानभिसंवृद्धान्दृष्ट्वा चाप्नुवतां मुदम् ।\nशकुनौ निर्भयौ तत्र ऊषतुश्चात्मजैः सह\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2190194, "chapter_id": 5047, "verse_number": "", "content_sanskrit": "जातपक्षांश्च सोऽपश्यदुड्डीनान् पुनरागतान् ।\nसायं सायं द्विजान् विप्रो न चाकम्पत जाजलिः\t॥३२", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2190195, "chapter_id": 5047, "verse_number": "३३", "content_sanskrit": "कदाचित् पुनरभ्येत्य पुनर्गच्छन्ति सन्ततम् ।\nत्यक्ता मातृपितृभ्यां ते न चाकम्पत जाजलिः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2190196, "chapter_id": 5047, "verse_number": "३४", "content_sanskrit": "अथ ते दिवसं चारीं गत्वा सायं पुनर्नृप ।\nउपावर्तन्त तत्रैव निवासार्थं शकुन्तकाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2190197, "chapter_id": 5047, "verse_number": "३५", "content_sanskrit": "कदाचिद्दिवसान् पञ्च समुत्पत्य विहङ्गमाः ।\nषष्ठेऽहनि समाजग्मुर्न चाकम्पत जाजलिः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2190198, "chapter_id": 5047, "verse_number": "३६", "content_sanskrit": "क्रमेण च पुनः सर्वे दिवसानि बहून्यपि ।\nनोपावर्तन्त शकुना जातप्राणाः स्म ते यदा\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2190199, "chapter_id": 5047, "verse_number": "३७", "content_sanskrit": "कदाचिन्मासमात्रेण समुत्पत्य विहङ्गमाः ।\nनैवागच्छंस्ततो राजन् प्रातिष्ठत स जाजलिः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2190200, "chapter_id": 5047, "verse_number": "", "content_sanskrit": "ततस्तेषु प्रलीनेषु जाजलिर्जातविस्मयः ।\nसिद्धोऽस्मीति मतिं चक्रे ततस्तं मान आविशत्\t॥३८ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2190201, "chapter_id": 5047, "verse_number": "३९", "content_sanskrit": "स तथा निर्गतान्दृष्ट्वा शकुन्तान्नियतव्रतः ।\nसम्भावितात्मा सम्भाव्य भृशं प्रीतस्तदाभवन्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2190202, "chapter_id": 5047, "verse_number": "४०", "content_sanskrit": "स नद्यां समुपस्पृश्य तर्पयित्वा हुताशनम् ।\nउदयन्तमथादित्यमभ्यगच्छन्महातपाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2190203, "chapter_id": 5047, "verse_number": "४१", "content_sanskrit": "सम्भाव्य चटकान्मूर्ध्नि जाजलिर्जपतां वरः ।\nआस्फोटयत्तदाकाशे धर्मः प्राप्तो मयेति वै\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2190204, "chapter_id": 5047, "verse_number": "४२", "content_sanskrit": "अथान्तरिक्षे वागासीत्तां स शुश्राव जाजलिः ।\nधर्मेण न समस्त्वं वै तुलाधारस्य जाजले\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2190205, "chapter_id": 5047, "verse_number": "४३", "content_sanskrit": "वाराणस्यां महाप्राज्ञस्तुलाधारः प्रतिष्ठितः ।\nसोऽप्येवं नार्हते वक्तुं यथा त्वं भाषसे द्विज\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2190206, "chapter_id": 5047, "verse_number": "४४", "content_sanskrit": "सोऽमर्षवशमापन्नस्तुलाधारदिदृक्षया ।\nपृथिवीमचरद्राजन्यत्रसायङ्गृहो मुनिः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2190207, "chapter_id": 5047, "verse_number": "४५", "content_sanskrit": "कालेन महतागच्छत्स तु वाराणसीं पुरीम् ।\nविक्रीणन्तं च पण्यानि तुलाधारं ददर्श सः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2190208, "chapter_id": 5047, "verse_number": "४६", "content_sanskrit": "सोऽपि दृष्ट्वैव तं विप्रमायान्तं भाण्डजीवनः ।\nसमुत्थाय सुसंहृष्टः स्वागतेनाभ्यपूजयत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2190209, "chapter_id": 5047, "verse_number": "", "content_sanskrit": "तुलाधारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2190210, "chapter_id": 5047, "verse_number": "४७", "content_sanskrit": "आयानेवासि विदितो मम ब्रह्मन्न संशयः ।\nब्रवीमि यत्तु वचनं तच्छृणुष्व द्विजोत्तम\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2190211, "chapter_id": 5047, "verse_number": "४८", "content_sanskrit": "सागरानूपमाश्रित्य तपस्तप्तं त्वया महत् ।\nन च धर्मस्य सञ्ज्ञां त्वं पुरा वेत्थ कथञ्चन\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2190212, "chapter_id": 5047, "verse_number": "४९", "content_sanskrit": "ततः सिद्धस्य तपसा तव विप्र शकुन्तकाः ।\nक्षिप्रं शिरस्यजायन्त ते च सम्भावितास्त्वया\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2190213, "chapter_id": 5047, "verse_number": "५०", "content_sanskrit": "जातपक्षा यदा ते च गताश्चारीमितस्ततः ।\nमन्यमानस्ततो धर्मं चटकप्रभवं द्विज ।\nखे वाचं त्वमथाश्रौषीर्मां प्रति द्विजसत्तम\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2190214, "chapter_id": 5047, "verse_number": "५१", "content_sanskrit": "अमर्षवशमापन्नस्ततः प्राप्तो भवानिह ।\nकरवाणि प्रियं किं ते तद् ब्रूहि द्विजसत्तम\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2190215, "chapter_id": 5047, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे तुलाधारजाजलिसंवादो नाम षण्णवतितमोऽध्यायः ॥९६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]