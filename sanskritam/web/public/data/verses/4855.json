[{"id": 2181940, "chapter_id": 4855, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2181941, "chapter_id": 4855, "verse_number": "१", "content_sanskrit": "केन वृत्तेन वृत्तज्ञ वर्तमानो महीपतिः ।\nसुखेनार्थान् सुखोदर्कानिह च प्रेत्य चाप्नुयात्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2181942, "chapter_id": 4855, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2181943, "chapter_id": 4855, "verse_number": "२", "content_sanskrit": "इयं गुणानां षट्त्रिंशी षट्त्रिंशद् गुणसंयुता ।\nयान् गुणांस्तु गुणोपेतः कुर्वन् गुणमवाप्नुयात्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2181944, "chapter_id": 4855, "verse_number": "३", "content_sanskrit": "चरेद् धर्मानकटुको मुञ्चेत् स्नेहं न नास्तिकः ।\nअनृशंसश्चरेदर्थं चरेत् काममनुद्धतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2181945, "chapter_id": 4855, "verse_number": "४", "content_sanskrit": "प्रियं ब्रूयादकृपणः शूरः स्यादविकत्थनः ।\nदाता नापात्रवर्षी स्यात् प्रगल्भः स्यादनिष्ठुरः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2181946, "chapter_id": 4855, "verse_number": "५", "content_sanskrit": "सन्दधीत न चानार्यैर्विगृह्णीयान्न बन्धुभिः ।\nनानाप्तैः कारयेच्चारं कुर्यात् कार्यमपीडया\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2181947, "chapter_id": 4855, "verse_number": "६", "content_sanskrit": "अर्थान् ब्रूयान्न चारेषु गुणान् ब्रूयान्न चात्मनः ।\nआदद्यान्न च साधुभ्यो नासत्पुरुषमाश्रयेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2181948, "chapter_id": 4855, "verse_number": "७", "content_sanskrit": "नापरीक्ष्य नयेद् दण्डं नच मन्त्रं प्रकाशयेत् ।\nविसृजेन्नच लुब्धेभ्यो विश्वसेन्नापकारिषु\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2181949, "chapter_id": 4855, "verse_number": "८", "content_sanskrit": "अनीर्षर्ुगुप्तदारः स्याच्चोक्षः स्यादघृणी नृपः ।\nस्त्रियं सेवेत नात्यर्थं मृष्टं भुञ्जीत नाहितम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2181950, "chapter_id": 4855, "verse_number": "९", "content_sanskrit": "अस्तब्धः पूजयेन्मान्यान् गुरून् सेवेदमायया ।\nअर्चेद् देवान्न दम्भेन श्रियमिच्छेदकुत्सिताम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2181951, "chapter_id": 4855, "verse_number": "१०", "content_sanskrit": "सेवेत प्रणयं हित्वा दक्षः स्यान्न त्वकालवित् ।\nसान्त्वयेन्नच भोगार्थमनुगृह्णन्न चाक्षिपेत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2181952, "chapter_id": 4855, "verse_number": "११", "content_sanskrit": "प्रहरेन्न त्वविज्ञाय हत्वा शत्रून्न शेषयेत् ।\nक्रोधं कुर्यान्न चाकस्मान्मृदुः स्यान्नापकारिषु\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2181953, "chapter_id": 4855, "verse_number": "१२", "content_sanskrit": "एवं चरस्व राज्यस्थो यदि श्रेय इहेच्छसि ।\nअतोऽन्यथा नरपतिर्भयमृच्छत्यनुत्तमम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2181954, "chapter_id": 4855, "verse_number": "समाप्तिः", "content_sanskrit": "इति सर्वान् गुणानेतान् यथोक्तान् योऽनुवर्तते ।\nअनुभूयेह भद्राणि प्रेत्य स्वर्गे महीयते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2181955, "chapter_id": 4855, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2181956, "chapter_id": 4855, "verse_number": "१४", "content_sanskrit": "इदं वचः शान्तनवस्य शुश्रुवान्\nयुधिष्ठिरः पाण्डवमुख्यसंवृतः ।\nतदा ववन्दे च पितामहं नृपो\nयथोक्तमेतच्च चकार बुद्धिमान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2181957, "chapter_id": 4855, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे द्वासप्ततितमोऽध्यायः ॥ ७२ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]