[{"id": 7003977000, "chapter_id": 23977, "verse_number": "३-१-४०-१", "content_sanskrit": "श्रीसूत उवाच ।\nअथातः संप्रवक्ष्यामि मुनयो लोकपावनम् ।\nगायत्र्या च सरस्वत्या माहात्म्यं मुक्तिदं नृणाम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003977001, "chapter_id": 23977, "verse_number": "३-१-४०-२", "content_sanskrit": "शृण्वतां पठतां चैव महापातकनाशनम् ।\nमहापुण्यप्रदं पुंसा नरकक्लेशनाशनम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003977002, "chapter_id": 23977, "verse_number": "३-१-४०-३", "content_sanskrit": "गायत्र्यां च सरस्वत्यां ये स्नांति मनुजा मुदा ।\nन तेषां गर्भवासः स्यात्किं तु मुक्तिर्भवेद्ध्रुवम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003977003, "chapter_id": 23977, "verse_number": "३-१-४०-४", "content_sanskrit": "सरस्वत्याश्च गायत्र्या गन्धमादनपर्वते ।\nब्रह्मपत्न्योः सन्निधानात्तन्नाम्ना कथिते इमे॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003977004, "chapter_id": 23977, "verse_number": "३-१-४०-५", "content_sanskrit": "ऋषय ऊचुः ।\nगायत्र्याश्च सरस्वत्या गन्धमादनपर्वते ।\nकिमर्थं संनिधानं वै सूताभूत्तद्वदस्व नः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003977005, "chapter_id": 23977, "verse_number": "३-१-४०-६", "content_sanskrit": "सूत उवाच ।\nप्रजापतिः पुरा विप्राः स्वां वै दुहितरं मुदा ।\nवाङ्नाम्नीं कामुको भूत्वा स्पृहयामास मोहनः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003977006, "chapter_id": 23977, "verse_number": "३-१-४०-७", "content_sanskrit": "अथ प्रजापतेः पुत्री स्वस्मिन्वै तस्य कामिताम् ।\nविलोक्य लज्जिता भूत्वा रोहिद्रूप दधार सा॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003977007, "chapter_id": 23977, "verse_number": "३-१-४०-८", "content_sanskrit": "ब्रह्मापि हरिणो भूत्वा तया रन्तुमनास्तदा ।\nगच्छतीमनुयातिस्म हरिणीरूपधारिणीम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003977008, "chapter_id": 23977, "verse_number": "३-१-४०-९", "content_sanskrit": "तं दृष्ट्वा देवताः सर्वाः पुत्रीगमनसादरम् ।\nकरोत्यकार्यं ब्रह्मायं पुत्रीगमनलक्षणम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003977009, "chapter_id": 23977, "verse_number": "३-१-४०-१०", "content_sanskrit": "इति निन्दंति तं विप्राः स्रष्टारं जगतां पतिम् ।\nनिषिद्धकृत्यनिरतं तं दृष्ट्वा परमेष्ठिनम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003977010, "chapter_id": 23977, "verse_number": "३-१-४०-११", "content_sanskrit": "हरः पिनाकमादाय व्याधरूपधरः प्रभुः ।\nआकर्णपूर्ण कृष्टेन पिनाकधनुषा शरम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003977011, "chapter_id": 23977, "verse_number": "३-१-४०-१२", "content_sanskrit": "संयोज्य वेधसं तेन विव्याध निशितेन सः ।\nत्रिपुरांतक बाणेन विद्धोऽसौ न्यपतद्भुवि॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003977012, "chapter_id": 23977, "verse_number": "३-१-४०-१३", "content_sanskrit": "तस्य देहादथोत्थाय महज्ज्योतिर्महाप्रभम् ।\nआकाशे मृगशीर्षाख्यं नक्षत्रमभवत्तदा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003977013, "chapter_id": 23977, "verse_number": "३-१-४०-१४", "content_sanskrit": "आर्द्रानक्षत्ररूपी सन्हरोऽप्यनुजगाम तम् ।\nपीडयन्मृगशीर्षाख्यं नक्षत्रं ब्रह्मरूपिणम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003977014, "chapter_id": 23977, "verse_number": "३-१-४०-१५", "content_sanskrit": "अधुनापि मृगव्याधरूपेण त्रिपुरांतकः ।\nअंबरे दृश्यते स्पष्टं मृगशीर्षांतिके द्विजाः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003977015, "chapter_id": 23977, "verse_number": "३-१-४०-१६", "content_sanskrit": "एवं विनिहते तस्मिञ्च्छंभुना परमेष्ठिनि ।\nअनंतरं तु गायत्रीसरस्वत्यौ शुचार्पिते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003977016, "chapter_id": 23977, "verse_number": "३-१-४०-१७", "content_sanskrit": "भर्तृहीने मुनिश्रेष्ठा भर्तृजीवनकांक्षया ।\nकिं करिष्यावहे ह्यावामित्यन्योयं विचार्य तु॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003977017, "chapter_id": 23977, "verse_number": "३-१-४०-१८", "content_sanskrit": "स्वपतिप्राणसिद्ध्यर्थं गायत्री च सरस्वती ।\nसर्वोत्कृष्टं शिवस्थानं गन्धमादनपर्वतम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003977018, "chapter_id": 23977, "verse_number": "३-१-४०-१९", "content_sanskrit": "सर्वाभीष्टप्रदं पुंसां तपः कर्तुं समुद्यते ।\nजग्मतुर्नियमोपेतं तपः कर्तुं शिवं प्रति॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003977019, "chapter_id": 23977, "verse_number": "३-१-४०-२०", "content_sanskrit": "स्नानार्थमात्मनो विप्रा गायत्री च सरस्वती ।\nतीर्थद्वयं स्वनाम्ना वै चक्रतुः पापनाशनम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003977020, "chapter_id": 23977, "verse_number": "३-१-४०-२१", "content_sanskrit": "तत्र त्रिषवणस्नानं प्रत्यहं चक्रतुर्मुदा ।\nबहुकालमनाहारे कामक्रोधादिवर्जिते॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003977021, "chapter_id": 23977, "verse_number": "३-१-४०-२२", "content_sanskrit": "अत्युग्रनियमो पेते शिवध्यानपरायणे ।\nपंचाक्षरमहामन्त्रजपैकनियते शुभे॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003977022, "chapter_id": 23977, "verse_number": "३-१-४०-२३", "content_sanskrit": "स्वपतेर्जीवनार्थं वै गायत्री च सरस्वती ।\nमहादेवं समुद्दिश्य तप एवं प्रचक्रतुः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003977023, "chapter_id": 23977, "verse_number": "३-१-४०-२४", "content_sanskrit": "तयोरथ तपस्तुष्टो महादेवो महेश्वरः ।\nसन्निधत्ते महामूर्तिस्तपसां फलदित्सया॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003977024, "chapter_id": 23977, "verse_number": "३-१-४०-२५", "content_sanskrit": "ततः सन्निहितं शंभुं पार्वतीरमणं शिवम् ।\nगणेशकार्त्तिकेयाभ्यां पार्श्वयोः परिसेवितम॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003977025, "chapter_id": 23977, "verse_number": "३-१-४०-२६", "content_sanskrit": "दृष्ट्वा संतुष्टचित्ते ते गायत्री च सरस्वती ।\nस्तोत्रैस्तुष्टुवतुः स्तुत्यं महादेवं घृणा निधिम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003977026, "chapter_id": 23977, "verse_number": "३-१-४०-२७", "content_sanskrit": "गायत्रीसरस्वत्यावूचतुः ।\nनमो दुर्वारसंसारध्वांतध्वंसैकहेतवे ।\nज्वलज्ज्वालावलीभीमकालकूटविषादिने॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003977027, "chapter_id": 23977, "verse_number": "३-१-४०-२८", "content_sanskrit": "जगन्मोहन पंचास्त्रदेहनाथैकहेतवे ।\nजगदंतकरक्रूर यमांतक नमोऽस्तु ते॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003977028, "chapter_id": 23977, "verse_number": "३-१-४०-२९", "content_sanskrit": "गंगातरंगसंपृक्तजटामण्डलधारिणे ।\nनमस्तेस्तु विरूपाक्ष बाल शीतांशुधारिणे॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003977029, "chapter_id": 23977, "verse_number": "३-१-४०-३०", "content_sanskrit": "पिनाकभीमटंकारत्रासितत्रिपुरौकसे ।\nनमस्ते विविधाकारजगत्स्रष्टृशिरश्छिदे॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003977030, "chapter_id": 23977, "verse_number": "३-१-४०-३१", "content_sanskrit": "शांतामलकृपादृष्टिसंरक्षितमृ कण्डुज ।\nनमस्ते गिरिजानाथ रक्षावां शरणागते॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003977031, "chapter_id": 23977, "verse_number": "३-१-४०-३२", "content_sanskrit": "महादेव जगन्नाथ त्रिपुरांतक शंकर ।\nवामदेव महादेव रक्षावां शरणागते॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003977032, "chapter_id": 23977, "verse_number": "३-१-४०-३३", "content_sanskrit": "इति ताभ्यां स्तुतः शम्भुर्देवदेवो महेश्वरः ।\nअब्रवीत्प्रीतिसंयुक्तो गायत्रीं च सरस्वतीम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003977033, "chapter_id": 23977, "verse_number": "३-१-४०-३४", "content_sanskrit": "महादेव उवाच ।\nभोः सरस्वति गायत्रि प्रीतोऽस्मि युवयोरहम् ।\nवरं वरयतं मत्तो यद्वा मनसि वर्तते॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003977034, "chapter_id": 23977, "verse_number": "३-१-४०-३५", "content_sanskrit": "इत्युक्ते ते तु गायत्रीसरस्वत्यौ हरेण वै ।\nअब्रूतां पार्वतीकांतं महादेवं घृणानिधिम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003977035, "chapter_id": 23977, "verse_number": "३-१-४०-३६", "content_sanskrit": "गायत्रीसरस्वत्यावूचतुः ।\nभगन्नावयोर्देव भर्त्तारं चतुराननम् ।\nसप्राणं कुरु सर्वेश कृपया करुणाकर॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003977036, "chapter_id": 23977, "verse_number": "३-१-४०-३७", "content_sanskrit": "त्वमावयोः पिता देव तवाप्यावां सुते उभे ।\nरक्षावां पतिदानेन तस्मात्त्वं त्रिपुरांतक॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003977037, "chapter_id": 23977, "verse_number": "३-१-४०-३८", "content_sanskrit": "स एवं प्रार्थितः शम्भुस्ताभ्यां ब्राह्मणपुंगवाः ।\nएवमस्त्विति संप्रोच्य गायत्रीं च सरस्वतीम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003977038, "chapter_id": 23977, "verse_number": "३-१-४०-३९", "content_sanskrit": "तदेव वेधसः कायं शिरसा योक्तुमुत्सुकः ।\nतत्रैव वेधसः कायं शिरोभिः सहसुव्रताः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003977039, "chapter_id": 23977, "verse_number": "३-१-४०-४०", "content_sanskrit": "भूतैरानाययामास नंदिभृंगिमुखैस्तदा ।\nशिरांसि तान्यनेकानि कायेन सह शंकरः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003977040, "chapter_id": 23977, "verse_number": "३-१-४०-४१", "content_sanskrit": "क्षणात्संधारयामास वाणीगायत्रिसंनिधौ ।\nसंधितोऽथ हरेणासौ चतुर्वक्त्रो जगत्पतिः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003977041, "chapter_id": 23977, "verse_number": "३-१-४०-४२", "content_sanskrit": "उत्तस्थौ तत्क्षणादेव सुप्तोत्थित इव द्विजाः ।\nततः प्रजापतिर्दृष्ट्वा शंकरं शशिभूषणम् ।\nतुष्टाव वाग्भिरग्र्याभिर्भार्याभ्यां च समन्वितः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003977042, "chapter_id": 23977, "verse_number": "३-१-४०-४३", "content_sanskrit": "ब्रह्मोवाच ।\nनमस्ते देवदेवेश करुणाकर शंकर॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003977043, "chapter_id": 23977, "verse_number": "३-१-४०-४४", "content_sanskrit": "पाहि मां करुणासिंधो निषिद्धाचरणात्प्रभो ।\nमम त्वत्कृपया शंभो निषिद्धाचरणे क्वचित्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003977044, "chapter_id": 23977, "verse_number": "३-१-४०-४५", "content_sanskrit": "मा प्रवृत्तिर्भवेद्भूयो रक्ष मां त्वं तथा सदा ।\nतथैवास्त्विति संप्राह ब्रह्माणं गिरिजापतिः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003977045, "chapter_id": 23977, "verse_number": "३-१-४०-४६", "content_sanskrit": "इतः परं प्रमादं त्वं मा कुरुष्व विधे पुनः ।\nउत्पथं प्रतिपन्नानां पुंसां शास्तास्मि सर्वदा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003977046, "chapter_id": 23977, "verse_number": "३-१-४०-४७", "content_sanskrit": "एवमुक्त्वा चतुर्वक्त्रं महादेवो द्विजोत्तमाः ।\nसरस्वतीं च गायत्रीं प्रोवाच प्रीणयन्गिरा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003977047, "chapter_id": 23977, "verse_number": "३-१-४०-४८", "content_sanskrit": "महादेव उवाच ।\nयुवयोर्मत्प्रसादेन हे गायत्रि सरस्वति ।\nअयं भर्ता समायातः सप्राणश्चतुराननः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003977048, "chapter_id": 23977, "verse_number": "३-१-४०-४९", "content_sanskrit": "सहानेन ब्रह्मलोकं यातं मा भूद्विलंबता ।\nयुवयोः संनिधानेन सदा कुंडद्वयेऽत्र वै॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003977049, "chapter_id": 23977, "verse_number": "३-१-४०-५०", "content_sanskrit": "भविष्यति नृणां मुक्तिः स्नानात्सायुज्यरूपिणी ।\nयुष्मन्नाम्ना च गायत्रीसर स्वत्याविति द्वयम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003977050, "chapter_id": 23977, "verse_number": "३-१-४०-५१", "content_sanskrit": "इदं तीर्थं सर्वलोके ख्यातिं यास्यति शाश्वतीम् ।\nसर्वेषामपि तीर्थानामिदं तीर्थद्वयं सदा॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003977051, "chapter_id": 23977, "verse_number": "३-१-४०-५२", "content_sanskrit": "शुद्धिप्रदं तथा भूयान्महापातकनाशनम् ।\nमहाशांतिकरं पुंसां सर्वाभीष्टप्रदायकम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003977052, "chapter_id": 23977, "verse_number": "३-१-४०-५३", "content_sanskrit": "मम प्रसादजननं विष्णुप्रीतिकरं तथा ।\nएतत्तीर्थद्वयसमं न भूतं न भविष्यति॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003977053, "chapter_id": 23977, "verse_number": "३-१-४०-५४", "content_sanskrit": "अत्र स्नानाद्धि सर्वेषां सर्वाभीष्टं भविष्यति ।\nइदं कुंडद्वयं लोके भवतीभ्यां कृतं महत्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003977054, "chapter_id": 23977, "verse_number": "३-१-४०-५५", "content_sanskrit": "युष्मन्नाम्ना प्रसिद्धं च भविष्यति विमुक्तिदम् ।\nगायत्र्युपास्तिरहिता वेदाभ्यासविवर्जिताः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003977055, "chapter_id": 23977, "verse_number": "३-१-४०-५६", "content_sanskrit": "औपासनविहीनाश्च पंचयज्ञविवर्जिताः ।\nयुष्मत्कुंडद्वये स्नानात्तत्त त्फलमवाप्नुयुः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003977056, "chapter_id": 23977, "verse_number": "३-१-४०-५७", "content_sanskrit": "अन्ये च ये पातकिनो नित्यानुष्ठानवर्जिताः ।\nस्नात्वा कुंडद्वये तत्र शुद्धाः स्युर्द्विजसत्तमाः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003977057, "chapter_id": 23977, "verse_number": "३-१-४०-५८", "content_sanskrit": "सरस्वतीं च गाय त्रीमेवमुक्त्वा महेश्वरः ।\nक्षणादंतरधात्तत्र सर्वेषामेव पश्यताम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003977058, "chapter_id": 23977, "verse_number": "३-१-४०-५९", "content_sanskrit": "पतिं लब्ध्वाऽथ गायत्रीसरस्वत्यौ मुदान्विते ।\nतेन साकं ब्रह्मलोकं जग्म तुर्द्विजसत्तमाः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003977059, "chapter_id": 23977, "verse_number": "३-१-४०-६०", "content_sanskrit": "श्रीसूत उवाच ।\nएवं वः कथितं विप्रा गंधमादनपर्वते ।\nसंनिधानं सरस्वत्या गायत्र्याश्च सहेतुकम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003977060, "chapter_id": 23977, "verse_number": "३-१-४०-६१", "content_sanskrit": "यः शृणोतीममध्यायं पठते वा सभक्तिकम् ।\nएतत्तीर्थद्वयस्नानफलमाप्नोत्यसंशयः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]