[{"id": 2103352, "chapter_id": 3241, "verse_number": "१४-९७-१", "content_sanskrit": "वैशम्पायन उवाच।\nएवमात्मोद्भवं सर्वं यगदुद्दिश्य केशवः।\nधर्मान्धर्मात्मजस्याथ पुण्यानकथयत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2103353, "chapter_id": 3241, "verse_number": "१४-९७-२", "content_sanskrit": "शृणु पाण्डव तत्वेन पवित्रं पापनाशनम्।\nकथ्यमानं मया पुण्यं धर्मशास्त्रफलं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2103354, "chapter_id": 3241, "verse_number": "१४-९७-३", "content_sanskrit": "यः शृणोति शुचिर्भूत्वा एकचित्तस्तपोयुतः।\nस्वर्ग्यं यशस्यामायुष्यं धर्मं ज्ञेयं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2103355, "chapter_id": 3241, "verse_number": "१४-९७-४", "content_sanskrit": "श्रद्दधानस्य तस्येह यत्पापं पूर्वसंचितम्।\nविनश्यत्याशु तत्सर्वं मद्भक्तस्य विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2103356, "chapter_id": 3241, "verse_number": "१४-९७-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2103357, "chapter_id": 3241, "verse_number": "१४-९७-५", "content_sanskrit": "एवं श्रुत्वा वचः पुण्यं सत्यं केशवभाषितम्।\nप्रहृष्टमनसो भूत्वा चिन्तयन्तोऽद्भुतं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2103358, "chapter_id": 3241, "verse_number": "१४-९७-६", "content_sanskrit": "देवब्रह्मर्षयः सर्वे गन्धर्वाप्सरसस्तथा।\nभूता यक्षग्रहाश्चैव गुह्यका भुजगास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2103359, "chapter_id": 3241, "verse_number": "१४-९७-७", "content_sanskrit": "वालखिल्या महात्मानो योगिनस्तत्वदर्शिनः।\nतथा भागवताश्चापि पञ्चकालमुपासकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2103360, "chapter_id": 3241, "verse_number": "१४-९७-८", "content_sanskrit": "कौतूहलसमाविष्टाः प्रहृष्टैन्द्रियमानसाः।\nश्रोतुकामाः परं धर्मं वैष्णवं धर्मशासनम्।\nहृदि कर्तुं च तद्वाक्यं प्रणेमुः शिरसा नताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2103361, "chapter_id": 3241, "verse_number": "१४-९७-९", "content_sanskrit": "ततस्तान्वासुदेवेन दृष्टान्दिव्येन चक्षुषा।\nविमुक्तपापानालोक्य प्रणम्य शिरसा हरिम्।\nपप्रच्छ केशवं धर्मं धर्मपुत्रः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2103362, "chapter_id": 3241, "verse_number": "१४-९७-१०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2103363, "chapter_id": 3241, "verse_number": "१४-९७-१०", "content_sanskrit": "कीदृशी ब्राह्मणस्याथ क्षत्रियस्यापि कीदृशी।\nवैश्यस्य कीदृशी देव गतिः शूद्रस्य कीदृशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2103364, "chapter_id": 3241, "verse_number": "१४-९७-११", "content_sanskrit": "कथं बध्येत पाशेन ब्राह्मणस्तु यमालये।\nक्षत्रियो वाथ वैश्यो वा शूद्रो वा बध्यते कथम्।\nएतत्कर्मफलं ब्रूहि लोकनाथ नमोस्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2103365, "chapter_id": 3241, "verse_number": "१४-९७-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2103366, "chapter_id": 3241, "verse_number": "१४-९७-१२", "content_sanskrit": "पृष्टोऽथ केशवो ह्येवं धर्मपुत्रेण धीमता।\nउवाच संसारगतिं चातुर्वर्ण्यस्य कर्मजाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2103367, "chapter_id": 3241, "verse_number": "१४-९७-१३x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2103368, "chapter_id": 3241, "verse_number": "१४-९७-१३", "content_sanskrit": "शृणु वर्णक्रमेणैव धर्मं धर्मभृतां वर।\nनास्ति किंचिन्नरश्रेष्ठ ब्राह्मणस्य तु दुष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2103369, "chapter_id": 3241, "verse_number": "१४-९७-१४", "content_sanskrit": "शिखांयज्ञोपवीता ये सन्ध्यां ये चाप्युपासते।\nयैश्च पूर्णाहुतिः प्राप्ता विधिवज्जुह्वते च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2103370, "chapter_id": 3241, "verse_number": "१४-९७-१५", "content_sanskrit": "वैश्वदेवं च ये चक्रुः पूजयन्त्यतिथींश्च ये।\nनित्यं स्वाध्यायशीलाश्च जपयज्ञपराश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2103371, "chapter_id": 3241, "verse_number": "१४-९७-१६", "content_sanskrit": "सायंप्रातर्हुताशाश्च शूद्रभोजनवर्जिताः।\nडंभानृतविमुक्ताश्च स्वदारनिरताश्च ये।\nपञ्चयज्ञपरा ये च येऽग्निहोत्रमुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2103372, "chapter_id": 3241, "verse_number": "१४-९७-१७", "content_sanskrit": "दहन्ति दुष्कृतं येषां हूयमानास्त्रयोऽग्नयः।\nनष्टदुष्कृतकर्माणो ब्रह्मलोकं व्रजन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2103373, "chapter_id": 3241, "verse_number": "१४-९७-१८", "content_sanskrit": "ब्रह्मलोके पुनः कामं गन्धर्वैर्ब्रह्मगायकैः।\nउद्गीयमानाः प्रयतैः पूज्यमानाः स्वयंभुवा।\nब्रह्मिलोके प्रमोदन्ते यावदाभूतसंप्लुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2103374, "chapter_id": 3241, "verse_number": "१४-९७-१९", "content_sanskrit": "क्षत्रियोपि स्थितो राज्ये स्वधर्मपरिपालकः।\nसम्यक्प्रजाः पालयिता षड्भागनिरतः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2103375, "chapter_id": 3241, "verse_number": "१४-९७-२०", "content_sanskrit": "यज्ञदानरतो धीरः स्वदारनिरतः सदा।\nशास्त्रानुसारी तत्वज्ञः प्रजाकार्यपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2103376, "chapter_id": 3241, "verse_number": "१४-९७-२१", "content_sanskrit": "विप्रेभ्यः कामदो नित्यं भृत्यानां भरणे रतः।\nसत्यसन्धः शुचिर्नित्यं लोभडंभविवर्जितः।\nक्षत्रियोप्युत्तमां याति गतिं देवनिषेविताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2103377, "chapter_id": 3241, "verse_number": "१४-९७-२२", "content_sanskrit": "तत्र दिव्याप्सरोभिस्तु गन्धर्वैश्च विशेषतः।\nसेव्यमानो महातेजाः क्रीडते शक्रपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2103378, "chapter_id": 3241, "verse_number": "१४-९७-२३", "content_sanskrit": "चतुर्थगानि वै त्रिंशत्क्रीडित्वा तत्र देववत्।\nइह मानुष्यलोके तु चतुर्वेदी द्विजो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2103379, "chapter_id": 3241, "verse_number": "१४-९७-२४", "content_sanskrit": "कृषिगोपालनिरतो धर्मानवेषणतत्परः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2103380, "chapter_id": 3241, "verse_number": "१४-९७-२४", "content_sanskrit": "दानधर्मेपि निरतो विप्रशुश्रूषकस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2103381, "chapter_id": 3241, "verse_number": "१४-९७-२५", "content_sanskrit": "सत्यसन्धः शुचिर्नित्यं लोभडंभविवर्जितः।\nऋजुः स्वदारनिरतो हिंसाद्रोहविवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2103382, "chapter_id": 3241, "verse_number": "१४-९७-२६", "content_sanskrit": "वणिग्धर्मान्नमुञ्चन्वै देवब्राह्मणपूजकः।\nवैश्यः स्वर्गतिमाप्नोति पूज्यमानोप्सरोगणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2103383, "chapter_id": 3241, "verse_number": "१४-९७-२७", "content_sanskrit": "चतुर्युगानि वै त्रिंशत्क्रीडित्वा दश पञ्च च।\nइह मानुष्यलोके च राजा भवति वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2103384, "chapter_id": 3241, "verse_number": "१४-९७-२८", "content_sanskrit": "सुवर्णकोट्यः पञ्चाशद्रत्नानां च शतं तथा।\nहस्त्यश्वरश्वसंयुक्तो महाभोगांश्च सेवते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2103385, "chapter_id": 3241, "verse_number": "१४-९७-२९", "content_sanskrit": "त्रयाणामपि वर्णानां शुश्रूषानिरतः सदा।\nविशेषतस्तु विप्राणां दासवद्यस्तु तिष्टति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2103386, "chapter_id": 3241, "verse_number": "१४-९७-३०", "content_sanskrit": "अयाचितप्रदाता च सत्यशौचसमन्वितः।\nगुरुदेवार्चनरतः परदारविवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2103387, "chapter_id": 3241, "verse_number": "१४-९७-३१", "content_sanskrit": "परपीडामकृत्वैव भत्यवर्गं बिभर्ति यः।\nशूद्रोपि स्वर्गमाप्नोति जीवानामभयप्रदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2103388, "chapter_id": 3241, "verse_number": "१४-९७-३२", "content_sanskrit": "स स्वर्गकलोके क्रीडित्वा वर्षकोटिं महातपाः।\nइह मानुषलोके तु वैश्यो धनपतिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2103389, "chapter_id": 3241, "verse_number": "१४-९७-३३", "content_sanskrit": "एवं धर्मात्परं नास्ति महत्संसारमोक्षणम्।\nन च धर्मात्पर किंचित्पापकर्मव्यपोहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2103390, "chapter_id": 3241, "verse_number": "१४-९७-३४", "content_sanskrit": "तस्माद्धर्मः सदा कार्यो मानुष्यं प्राप्य दुर्लभम्।\nन हि धर्मानुरक्तानां लोके किंचन दुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2103391, "chapter_id": 3241, "verse_number": "१४-९७-३५", "content_sanskrit": "स्वयंभुविहितो धर्मो यो यस्येह नरेश्वर।\nस तेन क्षपयेत्पापं सम्यगाचरितेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2103392, "chapter_id": 3241, "verse_number": "१४-९७-३६", "content_sanskrit": "सहजं यद्भदेत्कर्म न तत्त्याज्यं हि केनचित्।\nस एव तस्य धर्मो हि तेन सिद्धिं स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2103393, "chapter_id": 3241, "verse_number": "१४-९७-३७", "content_sanskrit": "विगुणोपि स्वधर्मस्तु पापकर्म व्यपोहति।\nएवमेव तु धर्मोपि क्षीयते पापवर्धनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2103394, "chapter_id": 3241, "verse_number": "१४-९७-३८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2103395, "chapter_id": 3241, "verse_number": "१४-९७-३८", "content_sanskrit": "भगवन्देवदेवेश श्रोतुं कौतूहलं हि मे।\nशुभस्याप्यशुभस्यापि क्षयवृद्धी यथाक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2103396, "chapter_id": 3241, "verse_number": "१४-९७-३९x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2103397, "chapter_id": 3241, "verse_number": "१४-९७-३९", "content_sanskrit": "शृणु पार्थिव तत्सर्वं धर्मसूक्ष्मं सनातनम्।\nदुर्विज्ञेयतमं नित्यं यत्र मग्ना महाजनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2103398, "chapter_id": 3241, "verse_number": "१४-९७-४०", "content_sanskrit": "यथैव शीतमुदकमुष्णेन बहुना वृतम्।\nभवेत्तु तत्क्षणादुष्णं शीतत्वं च विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2103399, "chapter_id": 3241, "verse_number": "१४-९७-४१", "content_sanskrit": "यथोष्णं वा भवेदल्पं शीतेन बहुना वृतम्।\nशीतलं च भवेत्सर्वमुष्णत्वं च विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2103400, "chapter_id": 3241, "verse_number": "१४-९७-४२", "content_sanskrit": "एवं च यद्भवेद्भूरि सुकृतं वाऽपि दुष्कृतम्।\nतदल्पं क्षपयेच्छीघ्रं नात्र कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2103401, "chapter_id": 3241, "verse_number": "१४-९७-४३", "content_sanskrit": "समत्वे सति राजेन्द्र तयोः सुकृतपापयोः।\nगूहितस्य भवेद्वृद्धिः कीर्तितस्य भवेत्क्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2103402, "chapter_id": 3241, "verse_number": "१४-९७-४४", "content_sanskrit": "ख्यापनेनानुतापेन प्रायः पापं विनश्यति।\nतथा कृतस्तु राजेन्द्र धर्मो नश्यति मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2103403, "chapter_id": 3241, "verse_number": "१४-९७-४५", "content_sanskrit": "तावुभौ गूहितौ सम्यग्वृद्धिं यातो न संशयः।\nतस्मात्सर्वप्रयत्नेन न पापं गूहयेद्बुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2103404, "chapter_id": 3241, "verse_number": "१४-९७-४६", "content_sanskrit": "तस्मादेतत्प्रयत्नेनि कीर्तयेत्क्षयकारणात्।\nतस्मात्संकीर्तयेत्पापं नित्यं धर्मं च गूहयेत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2103405, "chapter_id": 3241, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि सप्तनवतितमोऽध्यायः॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]