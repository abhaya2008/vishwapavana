[{"id": 900001042, "chapter_id": 8205, "verse_number": "4.1", "content_sanskrit": "तदेतत् सत्यम् । यथा सुदीप्तात् पावकाद् विष्फुलिङ्गाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001043, "chapter_id": 8205, "verse_number": "4.2", "content_sanskrit": "दिव्यो ह्यमूर्तः पुरुषः स बाह्याभ्यन्तरो ह्यजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001044, "chapter_id": 8205, "verse_number": "4.3", "content_sanskrit": "एतस्माज्जायते प्राणो मनः सर्वेन्द्रियाणि च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001045, "chapter_id": 8205, "verse_number": "4.4", "content_sanskrit": "तस्मादग्निः समिधो यश्च सूर्य:", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001046, "chapter_id": 8205, "verse_number": "4.5", "content_sanskrit": "तस्मादृचः साम यजूंषि दीक्षा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001047, "chapter_id": 8205, "verse_number": "4.6", "content_sanskrit": "तस्माच्च देवा बहुधा सम्प्रसूताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001048, "chapter_id": 8205, "verse_number": "4.7", "content_sanskrit": "सप्त प्राणाः प्रभवन्ति तस्मात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001049, "chapter_id": 8205, "verse_number": "4.8", "content_sanskrit": "अतः समुद्रा गिरयश्च सर्वेऽस्मात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001050, "chapter_id": 8205, "verse_number": "4.9", "content_sanskrit": "पुरुष एवेदं विश्वं कर्म तपो ब्रह्म परामृतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001051, "chapter_id": 8205, "verse_number": "4.10", "content_sanskrit": "पुरुष एवेदं विश्वं कर्म तपो ब्रह्म परामृतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]