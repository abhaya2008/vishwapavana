[{"id": 2192260, "chapter_id": 5088, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2192261, "chapter_id": 5088, "verse_number": "१", "content_sanskrit": "एवमप्रतिबुद्धत्वादबुद्धजनसेवनात् ।\nसर्गकोटिसहस्राणि पतनान्तानि गच्छति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2192262, "chapter_id": 5088, "verse_number": "२", "content_sanskrit": "धाम्नाधामसहस्राणि मरणान्तानिगच्छति ।\nतिर्यग्योनौ मनुष्यत्वे देवलोके तथैव च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2192263, "chapter_id": 5088, "verse_number": "३", "content_sanskrit": "चन्द्रमा इव कोशानां पुनस्तत्र सहस्रशः ।\nलीयतेऽप्रतिबुद्धत्वादेवमेष ह्यबुद्धिमान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2192264, "chapter_id": 5088, "verse_number": "४", "content_sanskrit": "कलाः पञ्चदशा योनिस्तद्धाम इति पठ्यते।\nनित्यमेतद् विजानीहि सोमः षोडशमी कला॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2192265, "chapter_id": 5088, "verse_number": "५", "content_sanskrit": "कलायां जायतेऽजस्रं पुनः पुनरबुद्धिमान् ।\nधाम तस्योपयुञ्जन्ति भूय एव तु जायते॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2192266, "chapter_id": 5088, "verse_number": "६", "content_sanskrit": "षोडशी तु कला सूक्ष्मा स सोम उपधार्यताम् ।\nन तूपयुज्यतेदेवैर्देवानुपयुनक्ति सा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2192267, "chapter_id": 5088, "verse_number": "७", "content_sanskrit": "एतान्नक्षपयित्वा हि जायते नृपसत्तम ।\nसा ह्यस्यप्रकृतिर्दृष्टा तत्क्षयान्मोक्ष उच्यते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2192268, "chapter_id": 5088, "verse_number": "८", "content_sanskrit": "तदेवं षोडशकलं देहमव्यक्तसञ्ज्ञकम् ।\nममायमिति मन्वानस्तत्रैव परिवर्तते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2192269, "chapter_id": 5088, "verse_number": "९", "content_sanskrit": "पञ्चविंशस्तथैवात्मा तस्यैवा प्रतिबोधनात् ।\nविमलस्य विशुद्धस्य शुद्धानिलनिषेवणात्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2192270, "chapter_id": 5088, "verse_number": "१०", "content_sanskrit": "अशुद्ध एव शुद्धात्मातादृग्भवति पार्थिव ।\nअबुद्धसेवनाच्चापि बुद्धोऽप्यबुधतां व्रजेत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2192271, "chapter_id": 5088, "verse_number": "११", "content_sanskrit": "तथैवाप्रतिबुद्धोऽपि ज्ञेयो नृपतिसत्तम।\nप्रकृतेस्त्रिगुणायास्तुसेवनात् प्राकृतो भवेत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2192272, "chapter_id": 5088, "verse_number": "", "content_sanskrit": "करालजनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2192273, "chapter_id": 5088, "verse_number": "१२", "content_sanskrit": "अक्षरक्षरयोरेष द्वयोः सम्बन्ध इष्यते।\nस्त्रीपुंसोर्वापि भगवन् सम्बन्धस्तद्वदुच्यते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2192274, "chapter_id": 5088, "verse_number": "१३", "content_sanskrit": "ऋते न पुरुषेणेह स्त्री गर्भं धारयत्युत ।\nऋतेस्त्रियं न पुरुषोरूपं निर्वर्तयेत्तथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2192275, "chapter_id": 5088, "verse_number": "१४", "content_sanskrit": "अन्योन्यस्याभिसम्बन्धादन्योन्यगुणसंश्रयात्।\nरूपं निर्वर्तयत्येतदेवं सर्वासु योनिषु\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2192276, "chapter_id": 5088, "verse_number": "१५", "content_sanskrit": "रत्यर्थमभिसंरोधादन्योन्यगुणसंश्रयात् ।\nऋतौ निर्वर्तते रूपं तद् वक्ष्यामि निदर्शनम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2192277, "chapter_id": 5088, "verse_number": "१६", "content_sanskrit": "ये गुणाः पुरुषस्येह ये च मातृगुणास्तथा ।\nअस्थि स्नायु च मज्जा च जानीमः पितृतोद्विज\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2192278, "chapter_id": 5088, "verse_number": "१७", "content_sanskrit": "त्वङ्मांसं शोणितं चैव मातृजान्यपिशुश्रुम ।\nएवमेतद्द्विजश्रेष्ठ वेदशास्त्रेषु पठ्यते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2192279, "chapter_id": 5088, "verse_number": "१८", "content_sanskrit": "प्रमाणं यच्च वेदोक्तं शास्त्रोक्तं यच्च पठ्यते ।\nवेदशास्त्रप्रमाणं च प्रमाणं तत्सनातनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2192280, "chapter_id": 5088, "verse_number": "१९", "content_sanskrit": "एवमेवाभिसम्बद्धौ नित्यं प्रकृतिपूरुषौ ।\nपश्यामि भगवंस्तस्मान्मोक्षधर्मो न विद्यते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2192281, "chapter_id": 5088, "verse_number": "२०", "content_sanskrit": "अथ वानन्तरकृतं किञ्चिदेव निदर्शनम् ।\nतन्ममाचक्ष्व तत्त्वेन प्रत्यक्षो ह्यसि सर्वथा॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2192282, "chapter_id": 5088, "verse_number": "२१", "content_sanskrit": "मोक्षकामा वयं चापि काङ्क्षामो यदनामयम् ।\nअदेहमजरं दिव्यमतीन्द्रियमनीश्वरम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2192283, "chapter_id": 5088, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2192284, "chapter_id": 5088, "verse_number": "२२", "content_sanskrit": "यदेतदुक्तं भवतावेदशास्त्रनिदर्शनम् ।\nएवमेतद्यथा चैतन्न गृह्णाति तथा भवान्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2192285, "chapter_id": 5088, "verse_number": "२३", "content_sanskrit": "धार्यते हि त्वया ग्रन्थ उभयोर्वेदशास्त्रयोः ।\nन तु ग्रन्थस्य तत्त्वज्ञो यथावत्त्वं नरेश्वर॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2192286, "chapter_id": 5088, "verse_number": "२४", "content_sanskrit": "यो हि वेदे च शास्त्रे च ग्रन्थधारणतत्परः।\nन च ग्रन्थार्थतत्त्वज्ञस्तस्य तद्धारणं वृथा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2192287, "chapter_id": 5088, "verse_number": "२५", "content_sanskrit": "भारं स वहते तस्य ग्रन्थस्यार्थं न वेत्ति यः ।\nयस्तु ग्रन्थार्थतत्त्वज्ञो नास्य ग्रन्थागमोवृथा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2192288, "chapter_id": 5088, "verse_number": "२६", "content_sanskrit": "ग्रन्थस्यार्थं च पृष्टः संस्तादृशो वक्तुमर्हति ।\nयथा तत्त्वाभिगमनादर्थंतस्य स विन्दति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2192289, "chapter_id": 5088, "verse_number": "२७", "content_sanskrit": "यस्तु संसत्सु कथयेद्ग्रन्थार्थं स्थूलबुद्धिमान् ।\nस कथं मन्दविज्ञानोग्रन्थं वक्ष्यति निर्णयात्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2192290, "chapter_id": 5088, "verse_number": "२८", "content_sanskrit": "निर्णयं चापि छिद्रात्मान तं वक्ष्यति तत्त्वतः ।\nसोपहासात्मतामेति यस्माच्चैवात्मवानपि॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2192291, "chapter_id": 5088, "verse_number": "२९", "content_sanskrit": "तस्मात्त्वं शृणु राजेन्द्र यथैतदनुदृश्यते ।\nयाथातथ्येनसाङ्ख्येषु योगेषु च महात्मसु॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2192292, "chapter_id": 5088, "verse_number": "३०", "content_sanskrit": "यदेव योगाः पश्यन्ति साङ्ख्यैस्तदनुगम्यते ।\nएकं साङ्ख्यं च योगं च यः पश्यति स बुद्धिमान्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2192293, "chapter_id": 5088, "verse_number": "३१", "content_sanskrit": "त्वङ्मांसं रुधिरं मेदः पित्तं मज्जास्थि स्नायु च।\nएतदैन्द्रियकं तात यद्भवानिदमाह वै\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2192294, "chapter_id": 5088, "verse_number": "३२", "content_sanskrit": "द्रव्याद् द्रव्यस्य निष्पत्तिरिन्द्रियादिन्द्रियं तथा ।\nदेहाद् देहमवाप्नोति बीजाद् बीजं तथैव च\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2192295, "chapter_id": 5088, "verse_number": "३३", "content_sanskrit": "निरिन्द्रियस्य बीजस्य निर्द्रव्यस्यास्य देहिनः ।\nकथं गुणा भविष्यन्ति निर्गुणत्वान्महात्मनः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2192296, "chapter_id": 5088, "verse_number": "३४", "content_sanskrit": "गुणा गुणेषु जायन्तेतत्रैव निविशन्ति च ।\nएवं गुणाः प्रकृतितो जायन्ते च न सन्ति च\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2192297, "chapter_id": 5088, "verse_number": "३५", "content_sanskrit": "त्वङ्मांसं रुधिरं मेदः पित्तं मज्जास्थि स्नायु च ।\nअष्टौ तान्यथ शुक्रेण जानीहि प्राकृतानि वै\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2192298, "chapter_id": 5088, "verse_number": "३६", "content_sanskrit": "पुमांश्चैवापुमांश्चैव त्रैलिङ्ग्यंप्राकृतं स्मृतम् ।\nनैव पुमान् पुमांश्चैव स लिङ्गीत्यभिधीयते\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2192299, "chapter_id": 5088, "verse_number": "३७", "content_sanskrit": "अलिङ्गा प्रकृतिर्लिङ्गैरुपलभ्यति सात्मजैः।\nयथा पुष्पफलैर्नित्यमृतवो मूर्तयस्तथा\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2192300, "chapter_id": 5088, "verse_number": "३८", "content_sanskrit": "एवमप्यनुमानेन ह्यलिङ्गमुपलभ्यते ।\nपञ्चविंशतिमस्तात लिङ्गेषु नियतात्मकः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2192301, "chapter_id": 5088, "verse_number": "३९", "content_sanskrit": "अनादिनिधनोऽनन्तः सर्वदर्शी निरामयः ।\nकेवलं त्वभिमानित्वाद्गुणेष्वगुण उच्यते॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2192302, "chapter_id": 5088, "verse_number": "४०", "content_sanskrit": "गुणा गुणवतः सन्ति निर्गुणस्य कुतो गुणाः ।\nतस्मादेवं विजानन्ति ये जना गुणदर्शिनः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2192303, "chapter_id": 5088, "verse_number": "४१", "content_sanskrit": "यदा त्वेष गुणान् सर्वान् प्राकृतानभिमन्यते ।\nतदा स गुणवानेवपरमेणानुपश्यति\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2192304, "chapter_id": 5088, "verse_number": "४२", "content_sanskrit": "यत्तद् बुद्धेः परं प्राहुः साङ्ख्या योगाश्च सर्वशः ।\nबुद्ध्यमानं महाप्राज्ञमबुद्धपरिवर्जनात्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2192305, "chapter_id": 5088, "verse_number": "४३", "content_sanskrit": "अप्रबुद्धमथाव्यक्तं अगुणंप्राहुरीश्वरम् ।\nनिर्गुणं चेश्वरं नित्यमधिष्ठातारमेव च\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2192306, "chapter_id": 5088, "verse_number": "४४", "content_sanskrit": "प्रकृतेश्च गुणानां च पञ्चविंशतिकं बुधाः।\nसाङ्ख्ययोगे च कुशला बुद्ध्यन्ते परमैषिणः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2192307, "chapter_id": 5088, "verse_number": "४५", "content_sanskrit": "यदा प्रबुद्धास्त्वव्यक्तमवस्थाजन्मभीरवः ।\nबुद्ध्यमानं प्रबुद्ध्यन्तिगमयन्ति समं तदा\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2192308, "chapter_id": 5088, "verse_number": "४६", "content_sanskrit": "एतन्निदर्शनं सम्यगसम्यगनुदर्शनम् ।\nबुद्ध्यमानाप्रबुद्धाभ्यां पृथक्पृथगरिन्दम\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2192309, "chapter_id": 5088, "verse_number": "४७", "content_sanskrit": "परस्परेणैतदुक्तं क्षराक्षरनिदर्शनम् ।\nएकत्वमक्षरं प्राहुर्नानात्वं क्षरमुच्यते\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2192310, "chapter_id": 5088, "verse_number": "४८", "content_sanskrit": "पञ्चविंशतिनिष्ठोऽयं यदा सम्यक् प्रवर्तते।\nएकत्वं दर्शनं चास्य नानात्वं चाप्यदर्शनम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2192311, "chapter_id": 5088, "verse_number": "४९", "content_sanskrit": "तत्त्वनिस्तत्त्वयोरेतत् पृथगेव निदर्शनम् ।\nपञ्चविंशतिसर्गंतु तत्त्वमाहुर्मनीषिणः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2192312, "chapter_id": 5088, "verse_number": "५०", "content_sanskrit": "निस्तत्त्वं पञ्चविंशस्य परमाहुर्निदर्शनम् ।\nसर्गस्य वर्गमाधारं तत्त्वं तत्त्वात् सनातनम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2192313, "chapter_id": 5088, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे सप्तत्रिंशोत्तरशततमोऽध्यायः ॥१३७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]