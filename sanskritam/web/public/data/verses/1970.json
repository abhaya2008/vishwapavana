[{"id": 2043352, "chapter_id": 1970, "verse_number": "६-१९-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2043353, "chapter_id": 1970, "verse_number": "६-१९-१", "content_sanskrit": "अर्क्षांहिणीं दशैकां च व्यूढां दृष्ट्वा युधिष्ठिरः।\nकथमल्पेन सैन्येन प्रत्यव्यूहत पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2043354, "chapter_id": 1970, "verse_number": "६-१९-२", "content_sanskrit": "यो वेद मानुषं व्यूहं दैवं गान्धर्वमासुरम् ।\nकथं भीष्मं स कौन्तेयः प्रत्ययूहत सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2043355, "chapter_id": 1970, "verse_number": "६-१९-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2043356, "chapter_id": 1970, "verse_number": "६-१९-३", "content_sanskrit": "धार्तराष्ट्राण्यनीकानि दृष्ट्वा व्यूढानि पाण्डवः।\nअभ्यभाषत धर्मात्मा धर्मराजो धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2043357, "chapter_id": 1970, "verse_number": "६-१९-४", "content_sanskrit": "महर्षेर्वचनात्तात वेदयन्ति बृहस्पतेः ।\nसंहतान्योधयेदल्पान्कामं विस्तारयेद्बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2043358, "chapter_id": 1970, "verse_number": "६-१९-५", "content_sanskrit": "सूचीमुखमनीकं स्यादल्पानां बहुभिः सह।\nअस्माकं च तथा सैन्यमल्पीयः सुतरां परैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2043359, "chapter_id": 1970, "verse_number": "६-१९-६", "content_sanskrit": "एतद्वचनमाज्ञाय महर्षेर्व्यूह पाण्डव ।\nएतच्छ्रुत्वा धर्मराजं प्रत्यभाषत पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2043360, "chapter_id": 1970, "verse_number": "६-१९-७", "content_sanskrit": "एष व्यूहामि ते व्यूहं राजसत्तम दुर्जयम्।\nअचलं नाम वज्राख्यं विहितं वज्रपाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2043361, "chapter_id": 1970, "verse_number": "६-१९-८", "content_sanskrit": "यः स वात इवोद्भूतः समरे दुःसहः परैः।\nस नः पुरो योत्सयते वै भीमः प्रहरतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2043362, "chapter_id": 1970, "verse_number": "६-१९-९", "content_sanskrit": "तेजांसि रिपुसैन्यानां मृद्गन्पुरुषसत्तमः।\nअग्नेऽग्रणीर्योत्स्यति नो युद्धोपायविचक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2043363, "chapter_id": 1970, "verse_number": "६-१९-१०", "content_sanskrit": "यं दृष्ट्वा कुरवः सर्वे दुर्योधनपुरोगमाः।\nनिवर्तिष्यन्ति संत्रस्ताः सिंहं क्षुद्रमृगा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2043364, "chapter_id": 1970, "verse_number": "६-१९-११", "content_sanskrit": "तं सर्वे संश्रयिष्यामः प्राकारमकुतोभयाः ।\nभीमं प्रहरतां श्रेष्ठं देवाराजमिवामराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2043365, "chapter_id": 1970, "verse_number": "६-१९-१२", "content_sanskrit": "न हि सोऽस्ति पुमाँल्लोके यः संक्रुद्धं वृकोदरम्।\nद्रष्टुमत्युग्रकर्माणं विषहेत नरर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2043366, "chapter_id": 1970, "verse_number": "६-१९-१३", "content_sanskrit": "भीमसेनो गदां बिभ्रद्वज्रसारमयीं दृढाम् ।\nचरन्वेगेन महता समुद्रमपि शोषयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2043367, "chapter_id": 1970, "verse_number": "६-१९-१४", "content_sanskrit": "भीमसेनं तदा राजन्दर्शयस्व महाबलम् ।\nकेकया धृष्टकेतुश्च चेकितानश्च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2043368, "chapter_id": 1970, "verse_number": "६-१९-१५", "content_sanskrit": "एते गच्छन्तु सामात्याः प्रकर्षन्तो जनाधिप ।\nधृतराष्ट्रस्य दायादानिति बीभत्सुरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2043369, "chapter_id": 1970, "verse_number": "६-१९-१६", "content_sanskrit": "ब्रुवाणं तु तथा पार्थं सर्वसैन्यानि भारत ।\nअपूजयंस्तदा वाग्भिरनुकूलाभिराहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2043370, "chapter_id": 1970, "verse_number": "६-१९-१७", "content_sanskrit": "एवमुक्त्वा महाबाहुस्तथा चक्रे धनञ्जयः।\nव्यूह्य तानि बलान्याशु प्रययौ फल्गुनस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2043371, "chapter_id": 1970, "verse_number": "६-१९-१८", "content_sanskrit": "संप्रयातान्कुरून्दृष्ट्वा पाण्डंवानां महाचमूः।\nगङ्गेव पूर्णा स्तिमिता स्पन्दमाना व्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2043372, "chapter_id": 1970, "verse_number": "६-१९-१९", "content_sanskrit": "भीमसेनोऽग्रणीस्तेषां धृष्टद्युम्नश्च वीर्यवान् ।\nनकुलः सहदेवश्च धृष्टकेतुश्च पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2043373, "chapter_id": 1970, "verse_number": "६-१९-२०", "content_sanskrit": "विराटश्च ततः पश्चाद्राजाथाक्षौहिणीवृतः ।\nभ्रातृभिः सह पुत्रैश्च सोऽभ्यरक्षत पृष्ठतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2043374, "chapter_id": 1970, "verse_number": "६-१९-२१", "content_sanskrit": "चक्ररक्षौ तु भीमस्य माद्रीपुत्रौ महाद्युती।\nद्रौपदेयाः ससौभद्राः पृष्ठगोपास्तरस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2043375, "chapter_id": 1970, "verse_number": "६-१९-२२", "content_sanskrit": "धृष्टद्युम्नश्च पाञ्चाल्यस्तेषां गोप्ता महारथः ।\nसहितः पृतनाशूरैः रथमुख्यैः प्रभद्रकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2043376, "chapter_id": 1970, "verse_number": "६-१९-२३", "content_sanskrit": "शिखण्डी तु ततः पश्चादर्जुनेनाभिरक्षितः।\nयत्तो भीष्मविनाशाय प्रययौ भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2043377, "chapter_id": 1970, "verse_number": "६-१९-२४", "content_sanskrit": "पृष्ठतोऽप्यर्जुनस्यासीद्युयुधानो महाबलः ।\nचक्ररक्षौ तु पाञ्चाल्यौ युधामन्यूत्तमोजसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2043378, "chapter_id": 1970, "verse_number": "६-१९-२५", "content_sanskrit": "राजा तु मध्यमानीके कुन्तीपुत्रो युधिष्ठिरः ।\nबृहद्भीः कुञ्जरैर्मत्तैश्चलद्भिरचलैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2043379, "chapter_id": 1970, "verse_number": "६-१९-२६", "content_sanskrit": "अक्षौहिण्याथ पाञ्चाल्यो यज्ञसेनो महामनाः ।\nविराटमन्वयात्पश्चात्पाण्डवार्थं पराक्रमी ॥ ६-१९-२७aतेषामादित्यचन्द्राभाः कनकोत्तमभूषणाः ।\nनानाचिह्नधरा राजन्रथेष्वासन्महाध्वजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2043380, "chapter_id": 1970, "verse_number": "६-१९-२८", "content_sanskrit": "समुत्सार्य ततः पश्चाद्धृष्टद्युम्नो महारथः ।\nभ्रातृभिः सहपुत्रैश्च सोऽभ्यरक्षद्युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2043381, "chapter_id": 1970, "verse_number": "६-१९-२९", "content_sanskrit": "त्वदीयानां परेषां च रथेषु विपुलान्ध्वजान्।\nअभिभूयार्जुनस्यैको रथे तस्थौ महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2043382, "chapter_id": 1970, "verse_number": "६-१९-३०", "content_sanskrit": "पदातास्त्वग्रतोऽगच्छन्नसिशक्त्यृष्टिपाणयः।\nअनेकशतसाहस्रा भीमसेनस्य रक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2043383, "chapter_id": 1970, "verse_number": "६-१९-३१", "content_sanskrit": "वारणा दशसाहस्राः प्रभिन्नकरटामुखाः ।\nशूरा हेममयैर्जालैर्दीप्यमाना इवाचलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2043384, "chapter_id": 1970, "verse_number": "६-१९-३२", "content_sanskrit": "क्षरन्त इव जीमूता महार्हाः पद्मगन्धिनः।\nराजानमन्वयुः यश्चाज्जीमूता इव वार्षिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2043385, "chapter_id": 1970, "verse_number": "६-१९-३३", "content_sanskrit": "भीमसेनो गदां भीमां प्रकर्षन्परिघोपमाम्।\nप्रचकर्ष महासैन्यं दुराधर्षो महामनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2043386, "chapter_id": 1970, "verse_number": "६-१९-३४", "content_sanskrit": "तमर्कमिव दुष्प्रेक्ष्यं तपन्तमिव वाहिनीम् ।\nन शेकुः सर्वयोधास्ते प्रतिवीक्षितुमन्तिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2043387, "chapter_id": 1970, "verse_number": "६-१९-३५", "content_sanskrit": "वज्रो नामैष स व्यूहो निर्भयः सर्वतोमुखः।\nचापविद्युद्ध्वजो घोरो गुप्तो गाण्डीवधन्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2043388, "chapter_id": 1970, "verse_number": "६-१९-३६", "content_sanskrit": "यं प्रतिव्यूहय् तिष्ठन्ति पाण्डवास्तव वाहिनीम् ।\nअजेयो मानुषे लोके पाण्डवैरभिरक्षितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2043389, "chapter_id": 1970, "verse_number": "६-१९-३७", "content_sanskrit": "संध्यां तिष्ठत्सु सैन्येषु सूर्यस्योदयनं प्रति।\nप्रववौ पृष्ठतो वायुर्निरभ्रे स्तनयित्नुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2043390, "chapter_id": 1970, "verse_number": "६-१९-३८", "content_sanskrit": "विष्वग्वाताश्च विववुर्नीचैः शर्करकर्षिणः ।\nरजश्चोद्धूयत महत्तम आच्छादयञ्जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2043391, "chapter_id": 1970, "verse_number": "६-१९-३९", "content_sanskrit": "पपात महती चोल्का प्राङ्भुखी भरतर्षभ ।\nउद्यन्तं सूर्यमाहत्य व्यशीर्यत महास्वना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2043392, "chapter_id": 1970, "verse_number": "६-१९-४०", "content_sanskrit": "अथ संनह्यमानेषु सैन्येषु भरतर्षभ ।\nनिष्प्रभोऽभ्युद्ययौ सूर्यः सघोषं भूश्चचाल च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2043393, "chapter_id": 1970, "verse_number": "६-१९-४१", "content_sanskrit": "व्यशीर्यत सनादा च भूस्तदा भरतर्षभ ।\nनिर्घाता बहवो राजन्दिक्षु सर्वासु चाभवन् ।\nप्रादुरासीद्रजस्तीव्रं न प्राज्ञायत किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2043394, "chapter_id": 1970, "verse_number": "६-१९-४२", "content_sanskrit": "ध्वजानां धूयमानानां सहसा मातरिश्वना ।\nकिङ्किणीजालबद्धानां काञ्चनस्रग्वराम्बरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2043395, "chapter_id": 1970, "verse_number": "६-१९-४३", "content_sanskrit": "महतां सपताकानामादित्यसमतेजसाम् ।\nसर्वं झणझणीभूतमासीत्तालवनेष्विव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2043396, "chapter_id": 1970, "verse_number": "६-१९-४४", "content_sanskrit": "एवं ते पुरुषव्याघ्राः पाण्डवा युद्धनन्दिनः ।\nव्यवस्थिताः प्रतिव्यूह्य तव पुत्रस्य वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2043397, "chapter_id": 1970, "verse_number": "६-१९-४५", "content_sanskrit": "ग्रसन्त इव मञ्जानो योधानां भरतर्षभ ।\nदृष्ट्वाग्रतो भीमसेनं गदापाणिमवस्थितम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2043398, "chapter_id": 1970, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भगवद्गीतापर्वणि एकोनविंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]