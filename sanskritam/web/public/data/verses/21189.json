[{"id": 7001189000, "chapter_id": 21189, "verse_number": "२-३-३७-१", "content_sanskrit": "नारद उवाच ।\nतात प्राज्ञ वदेदानीं सप्तर्षिषु गतेषु च ।\nकिमकार्षीद्धिमगिरिस्तन्मे कृत्वा कृपां प्रभो॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001189001, "chapter_id": 21189, "verse_number": "२-३-३७-२", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nगतेषु तेषु मुनिषु सप्तस्वपि मुनीश्वर ।\nसारुन्धतीषु हिमवान् यदकार्षीद्ब्रवीमि ते॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001189002, "chapter_id": 21189, "verse_number": "२-३-३७-३", "content_sanskrit": "तत आमन्त्र्य स्वभ्रातॄन् मेर्वादीन् ससुतप्रियः ।\nमहामनास्स मुमुदे हिमवान् पर्वतेश्वरः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001189003, "chapter_id": 21189, "verse_number": "२-३-३७-४", "content_sanskrit": "तदाज्ञप्तस्ततः प्रीत्या हिमवान् लग्न पत्रिकाम् ।\nलेखयामास सुप्रीत्या गर्गेण स्वपुरोधसा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001189004, "chapter_id": 21189, "verse_number": "२-३-३७-५", "content_sanskrit": "अथ प्रस्थापयामास तां शिवाय स पत्रिकाम् ।\nनानाविधास्तु सामग्र्यः स्वजनैर्मुदितात्मभिः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001189005, "chapter_id": 21189, "verse_number": "२-३-३७-६", "content_sanskrit": "ते जनास्तत्र गत्वा च कैलासे शिवसन्निधिम् ।\nददुश्शिवाय तत्पत्रं तिलकं सम्विधाय च॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001189006, "chapter_id": 21189, "verse_number": "२-३-३७-७", "content_sanskrit": "सन्मानिता विशेषेण प्रभुणा च यथोचितम् ।\nसर्वे ते प्रीतिमनस आजग्मुश्शैलसन्निधिम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001189007, "chapter_id": 21189, "verse_number": "२-३-३७-८", "content_sanskrit": "सन्मानितान्विशेषेण महेशेनागताञ्जनान् ।\nदृष्ट्वा सुहर्षिताञ्च्छैलो मुमोदातीव चेतसि॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001189008, "chapter_id": 21189, "verse_number": "२-३-३७-९", "content_sanskrit": "ततो निमन्त्रणं चक्रे स्वबन्धूनां प्रमोदितः ।\nनानादेशस्थितानाञ्च निखिलानां सुखास्पदम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001189009, "chapter_id": 21189, "verse_number": "२-३-३७-१०", "content_sanskrit": "ततस्स कारयामास स्वर्णसंग्रहमादरात् ।\nनानाविधाश्च सामग्रीर्विवाहकरणोचिताः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001189010, "chapter_id": 21189, "verse_number": "२-३-३७-११", "content_sanskrit": "तण्डुलानां बहूञ्छैलान् पृथुकानां तथैव च ।\nगुडानां शर्कराणाञ्च लवणानां तथैव च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001189011, "chapter_id": 21189, "verse_number": "२-३-३७-१२", "content_sanskrit": "क्षीराणां च घृतानाञ्च दध्नां वापीश्चकार सः ।\nयवादिधान्यपिष्टानां लड्डुकानां तथैव च॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001189012, "chapter_id": 21189, "verse_number": "२-३-३७-१३", "content_sanskrit": "शष्कुलीनां स्वस्तिकानां शर्कराणां तथैव च ।\nअमृतेक्षुरसानां च तत्र वापीश्चकार सः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001189013, "chapter_id": 21189, "verse_number": "२-३-३७-१४", "content_sanskrit": "बह्वीर्हैयंगवानाञ्च ह्यासवानां तथैव च ।\nनाना पक्वान्नसंघांश्च महास्वादुरसांस्तथा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001189014, "chapter_id": 21189, "verse_number": "२-३-३७-१५", "content_sanskrit": "नाना व्यञ्जनवस्तूनि गणदेवहितानि च ।\nअमूल्यनानावस्त्राणि वह्निशौचानि यानि च॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001189015, "chapter_id": 21189, "verse_number": "२-३-३७-१६", "content_sanskrit": "मणिरत्नप्रकाराणि सुवर्णरजतानि च ।\nद्रव्याण्येतानि चान्यानि संगृह्य विधिपूर्वकम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001189016, "chapter_id": 21189, "verse_number": "२-३-३७-१७", "content_sanskrit": "मंगलं कर्तुमारेभे गिरिर्मंगलकृद्दिने ।\nसंस्कारं कारयामासुः पार्वत्याः पर्वतस्त्रियः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001189017, "chapter_id": 21189, "verse_number": "२-३-३७-१८", "content_sanskrit": "ता मंगलं मुदा चक्रुर्भूषिता भूषणैः स्वयम् ।\nपुरद्विजस्त्रियो दृष्ट्वा लोकाचारं प्रचक्रिरे॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001189018, "chapter_id": 21189, "verse_number": "२-३-३७-१९", "content_sanskrit": "सोत्सवं विविधं तत्र सुमंगलपुरस्सरम् ।\nहिमालयोऽपि हृष्टात्मा कृत्वाचारं सुमंगलम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001189019, "chapter_id": 21189, "verse_number": "२-३-३७-२०", "content_sanskrit": "सर्वभावेन सुप्रीतो बन्धुवर्गागमोत्सुकः ।\nएतस्मिन्नन्तरे तस्य बान्धवाश्च निमन्त्रिताः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001189020, "chapter_id": 21189, "verse_number": "२-३-३७-२१", "content_sanskrit": "आजग्मुस्सस्त्रियो हृष्टास्ससुतास्सपरिच्छदाः ।\nतदैव शृणु देवर्षे गिर्य्यागमनमादृतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001189021, "chapter_id": 21189, "verse_number": "२-३-३७-२२", "content_sanskrit": "वर्णयामि समासेन शिवप्रीतिविवृद्धये ।\nदेवालय गिरिर्यो हि दिव्यरूपधरो महान्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001189022, "chapter_id": 21189, "verse_number": "२-३-३७-२३", "content_sanskrit": "नानारत्नपरिभ्राजत्समाजस्सपरिच्छदः ।\nनानामणिमहारत्नसारमादाय यत्नतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001189023, "chapter_id": 21189, "verse_number": "२-३-३७-२४", "content_sanskrit": "सुवेषालंकृतः श्रीमान् जगाम स हिमालयम् ।\nमन्दरस्सर्वशोभाढ्यस्सनारीतनयो गिरिः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001189024, "chapter_id": 21189, "verse_number": "२-३-३७-२५", "content_sanskrit": "सूपायनानि संगृह्य जगाम विविधानि च ।\nअस्ताचलोपि दिव्यात्मा सोपायन उदारधीः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001189025, "chapter_id": 21189, "verse_number": "२-३-३७-२६", "content_sanskrit": "बहुशोभासमायुक्त आजगाम मुदान्वितः ।\nउदयाचल आदाय सद्रत्नानि मणीनपि॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001189026, "chapter_id": 21189, "verse_number": "२-३-३७-२७", "content_sanskrit": "अत्युत्कृष्टपरीवार आजगाम महासुखी ।\nमलयो गिरिराजो हि सपरीवार आदृतः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001189027, "chapter_id": 21189, "verse_number": "२-३-३७-२८", "content_sanskrit": "सुदिव्यरचनायुक्त आययौ बहुसद्बलः ।\nसद्यो दर्दुरनामा च मुदितस्सकलत्रकः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001189028, "chapter_id": 21189, "verse_number": "२-३-३७-२९", "content_sanskrit": "बहुशोभान्वितस्तातः ययौ हिमगिरेर्गृहम् ।\nनिषदोपि प्रहृष्टात्मा सपरिच्छद आययौ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001189029, "chapter_id": 21189, "verse_number": "२-३-३७-३०", "content_sanskrit": "ससुतस्त्रीगणः प्रीत्या ययौ हिमगिरेर्गृहम् ।\nआजगाम महाभाग्यो भूधरो गन्धमादनः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001189030, "chapter_id": 21189, "verse_number": "२-३-३७-३१", "content_sanskrit": "करवीरस्तथैवापि महाविभव संयुतः ।\nमहेन्द्रः पर्वतश्रेष्ठ आजगाम हिमालयम्॥३ ॥ ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001189031, "chapter_id": 21189, "verse_number": "२-३-३७-३२", "content_sanskrit": "सगणस्ससुतस्त्रीको बहुशोभासमन्वितः ।\nपारियात्रो हि हृष्टात्मा मणि रत्नाकरस्सयुत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001189032, "chapter_id": 21189, "verse_number": "२-३-३७-३३", "content_sanskrit": "सगणस्सपरीवार आययौ हिमभूधरम् ।\nक्रौञ्चः पर्वतराजो हि महाबलपरिच्छदः ।\nआजगाम गिरिश्रेष्ठस्स मुपायन आदृतः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001189033, "chapter_id": 21189, "verse_number": "२-३-३७-३४", "content_sanskrit": "पुरुषोत्तमशैलोपि सपरिच्छद आदृतः ।\nमहोपायनमादायाजगाम हिमभूधरम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001189034, "chapter_id": 21189, "verse_number": "२-३-३७-३५", "content_sanskrit": "नीलः सलीलस्स सुतस्सस्त्रीको द्रव्यसंयुतः ।\nआजगाम हिमागस्य गृहमानन्दसंयुतः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001189035, "chapter_id": 21189, "verse_number": "२-३-३७-३६", "content_sanskrit": "त्रिकूटश्चित्रकूटोपि वेंकटः श्रीगिरिस्तथा ।\nगोकामुखी नारदश्च हिमगेहमुपागमत्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001189036, "chapter_id": 21189, "verse_number": "२-३-३७-३७", "content_sanskrit": "विन्ध्यश्च पर्वतश्रेष्ठो नानासम्पत्समन्वितः ।\nआजगाम प्रहृष्टात्मा सदारतनयश्शुभः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001189037, "chapter_id": 21189, "verse_number": "२-३-३७-३८", "content_sanskrit": "कालंजरो महाशैलो बहुहर्षसमन्वितः ।\nबहुभस्सगणः प्रीत्याजगामहिमभूधरम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001189038, "chapter_id": 21189, "verse_number": "२-३-३७-३९", "content_sanskrit": "कैलासस्तु महाशैलो महाहर्षसमन्वितः ।\nआजगाम कृपां कृत्वा सर्वोपरि लसत्प्रभुः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001189039, "chapter_id": 21189, "verse_number": "२-३-३७-४०", "content_sanskrit": "अन्येपि भूभृतो ये हि द्वीपेष्वन्येष्वपि द्विज ।\nइहापि येऽचलास्सर्वे आययुस्ते हिमालयम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001189040, "chapter_id": 21189, "verse_number": "२-३-३७-४१", "content_sanskrit": "निमन्त्रिता नगास्तत्र तेन पूर्वं मुदा मुने ।\nआययुर्निखिलाः प्रीत्या विवाहश्शिवयोरिति॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001189041, "chapter_id": 21189, "verse_number": "२-३-३७-४२", "content_sanskrit": "तदा सर्वे समायाताश्शोणभद्रादयः खलु ।\nबहुशोभा महाप्रीत्या विवाहश्शिवयोरिति॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001189042, "chapter_id": 21189, "verse_number": "२-३-३७-४३", "content_sanskrit": "नद्यस्सर्वास्समायाता नानालंकारसंयुताः ।\nदिव्य रूपधराः प्रीत्या विवाहश्शिवयोरिति॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001189043, "chapter_id": 21189, "verse_number": "२-३-३७-४४", "content_sanskrit": "गोदावरी च यमुना ब्रह्मस्त्रीर्वेणिका तथा ।\nआययौ हिमशैलम्वै विवाहश्शिवयोरिति॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001189044, "chapter_id": 21189, "verse_number": "२-३-३७-४५", "content_sanskrit": "गंगा तु सुमहाप्रीत्या नानालंकारसंयुता ।\nदिव्यरूपा ययौ प्रीत्या विवाहश्शिवयोरिति॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001189045, "chapter_id": 21189, "verse_number": "२-३-३७-४६", "content_sanskrit": "नर्मदा तु महामोदा रुद्रकन्या सरिद्वरा ।\nमहाप्रीत्या जगामाशु विवाहश्शिवयोरिति॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001189046, "chapter_id": 21189, "verse_number": "२-३-३७-४७", "content_sanskrit": "आगतैस्तैस्ततः सर्वैस्सर्वतो हिमभूधरम् ।\nसंकुलासीत्पुरी दिव्या सर्वशोभासमन्विता॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001189047, "chapter_id": 21189, "verse_number": "२-३-३७-४८", "content_sanskrit": "महोत्सवा लसत्केतुध्वजातोरणकाधिका ।\nवितानविनिवृत्तार्का तथा नानालसत्प्रभा॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001189048, "chapter_id": 21189, "verse_number": "२-३-३७-४९", "content_sanskrit": "हिमालयोपि सुप्रीत्यादरेण विविधेन च ।\nतेषां चकार सन्मानं तासां चैव यथायथम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001189049, "chapter_id": 21189, "verse_number": "२-३-३७-५०", "content_sanskrit": "सर्वान्निवासयामास सुस्थानेषु पृथक् पृथक् ।\nसामग्रीभिरनेकाभिस्तोषयामास कृत्स्नशः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]