[{"id": 7001005000, "chapter_id": 21005, "verse_number": "४-११-१", "content_sanskrit": "श्रीपराशर उवाच\nअतः परं ययातेः प्रथमपुत्रस्य यदोर्वंशमहं कथयामि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001005001, "chapter_id": 21005, "verse_number": "४-११-२", "content_sanskrit": "यत्राशेषलोकनिवासो मनुष्यसिद्धगन्धर्वयक्षराक्षसगुह्यककिंपुरुषाप्सरोरगविहगदैत्यदानवादित्यरुद्रवस्वश्विमरुद्देवर्षिभिर्मुमुक्षुभिर्धर्मार्थकाममोक्षार्थिभिश्च तत्तत्फललाभाय सदाभिष्टुतोऽपरिच्छेद्यमाहात्म्यांशेन भगवाननादिनिधनो विष्णुरवततार ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001005002, "chapter_id": 21005, "verse_number": "४-११-३", "content_sanskrit": "अत्र श्लोकः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001005003, "chapter_id": 21005, "verse_number": "४-११-४", "content_sanskrit": "यदोर्वंशं नरः श्रुत्वा सर्वपापैः प्रमुच्यते ।\nयत्रावतीर्णं कृष्णाख्यंपरं ब्रह्मनराकृति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001005004, "chapter_id": 21005, "verse_number": "४-११-५", "content_sanskrit": "सहस्रजित्क्रोष्टुनलनहुषसंज्ञाश्चात्वारो यदुपुत्रा वभुवुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001005005, "chapter_id": 21005, "verse_number": "४-११-६", "content_sanskrit": "सहस्रजित्पुः शतजित् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001005006, "chapter_id": 21005, "verse_number": "४-११-७", "content_sanskrit": "तस्य हैहयहेहयवेणुहयास्त्रयः पुत्रा बभूवुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001005007, "chapter_id": 21005, "verse_number": "४-११-८", "content_sanskrit": "हैहयपुत्रो धर्मः तस्यापि धर्मनेत्रः ततः कुन्तिः कुन्तेः सहजित् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001005008, "chapter_id": 21005, "verse_number": "४-११-९", "content_sanskrit": "तत्तनयो महिष्मान् योऽसौ माहिष्मतों पुरीं निर्वापयामास ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001005009, "chapter_id": 21005, "verse_number": "४-११-१०", "content_sanskrit": "तस्माद्भद्रश्रेण्यस्ततो दुर्दमस्तस्माद्धनकः धनकस्य कृतवीर्यकृताग्निकृतधर्मकृतौजसश्चत्वारः पुत्रा बभूवुः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001005010, "chapter_id": 21005, "verse_number": "४-११-११", "content_sanskrit": "कृतवीर्यादर्जुःसप्तद्वीपाधिपतिर्बाहुसहस्रो जज्ञे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001005011, "chapter_id": 21005, "verse_number": "४-११-१२", "content_sanskrit": "योऽसौ भगवदंशमत्रिकुलप्रसूतं दत्तात्रेयाख्यमाराध्य बाहुसहस्रमधर्मसेवानिवारणं स्वधर्मसेवित्वं रणे पृथिवीजयं धर्मतश्चानुपालनमारातिभ्योऽपराजयमखिलजगत्प्रख्यातपुरुषाच्च मृत्युमित्येतान्वरानभिलषितवांल्लेभे च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001005012, "chapter_id": 21005, "verse_number": "४-११-१३", "content_sanskrit": "तेनेयमशेषद्वीपवती पृथिवी सम्यक्परीपालिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001005013, "chapter_id": 21005, "verse_number": "४-११-१४", "content_sanskrit": "दशयज्ञसहस्राण्यसावयजत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001005014, "chapter_id": 21005, "verse_number": "४-११-१५", "content_sanskrit": "तस्य च श्लोकोऽद्यापि गीयते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001005015, "chapter_id": 21005, "verse_number": "४-११-१६", "content_sanskrit": "न नूनं कार्तवीर्यस्य गातिं यास्यन्ति पार्थिवाः ।\nयज्ञैर्दानैस्तपोभिर्वा प्रश्रयेण श्रुतेन च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001005016, "chapter_id": 21005, "verse_number": "४-११-१७", "content_sanskrit": "अनष्टद्रव्यता च तस्य राज्येऽभवत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001005017, "chapter_id": 21005, "verse_number": "४-११-१८", "content_sanskrit": "एवं च पञ्चाशीतिवर्षसहस्रण्यव्याहतेरोग्यश्रीबलपराक्रमो राज्यमकरोत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001005018, "chapter_id": 21005, "verse_number": "४-११-१९", "content_sanskrit": "माहिष्मत्यां दिग्विजयाभ्यागतो स्थापितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001005019, "chapter_id": 21005, "verse_number": "४-११-२०", "content_sanskrit": "यश्च पञ्चाशीतिवर्शसहस्रोपलक्षणकालावसाने भगवन्नारायणांशेन परशुरामेणोपसंहृतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001005020, "chapter_id": 21005, "verse_number": "४-११-२१", "content_sanskrit": "तस्य च पुत्रशतप्रधानाः पञ्चपुत्रा बभूवुः शूरशूरसेनवृषसेनमधुजयध्वजसंज्ञाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001005021, "chapter_id": 21005, "verse_number": "४-११-२२", "content_sanskrit": "जयध्वजात्तालजङ्घः पुत्रोभवत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001005022, "chapter_id": 21005, "verse_number": "४-११-२३", "content_sanskrit": "तालजङ्घस्य तालजङ्घाख्यं पुत्रशतमासीत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001005023, "chapter_id": 21005, "verse_number": "४-११-२४", "content_sanskrit": "एषां ज्येष्ठे वीतिहोत्रस्तथान्यो भरतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001005024, "chapter_id": 21005, "verse_number": "४-११-२५", "content_sanskrit": "भरताद्वृषः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001005025, "chapter_id": 21005, "verse_number": "४-११-२६", "content_sanskrit": "वृषस्य पुत्रो मधुरभवत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001005026, "chapter_id": 21005, "verse_number": "४-११-२७", "content_sanskrit": "तस्यापि वृष्णिप्रमुखंपुत्रशतमासीत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001005027, "chapter_id": 21005, "verse_number": "४-११-२८", "content_sanskrit": "यतो वृष्णिसंज्ञामेतद्गोत्रमवाप ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001005028, "chapter_id": 21005, "verse_number": "४-११-२९", "content_sanskrit": "मधुसंज्ञाहेतुश्च मधुरभवत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001005029, "chapter_id": 21005, "verse_number": "४-११-३०", "content_sanskrit": "यादवाश्च यदुना