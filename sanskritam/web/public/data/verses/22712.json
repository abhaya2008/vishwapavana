[{"id": 7002712000, "chapter_id": 22712, "verse_number": "८-२३-१", "content_sanskrit": "सूत उवाच ।\nवैक्रमे राज्यविगते चतुष्षष्ट्युत्तरं मुने ।\nद्वाविंशदब्दशतकं भूतनन्दिस्तदा नृपः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002712001, "chapter_id": 22712, "verse_number": "८-२३-२", "content_sanskrit": "कुबेरयक्षकान्मौनान्धनधान्यसमन्वितान् ।\nसार्द्धलक्षान्कलैर्घोरैर्जित्वा तान्युद्धकारिणः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002712002, "chapter_id": 22712, "verse_number": "८-२३-३", "content_sanskrit": "किल्किलायां स्वयं राज्यं नागवंशैश्चकार ह ।\nआग्नेय्यां दिशि विख्याता पुण्डरीकेण निर्मिता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002712003, "chapter_id": 22712, "verse_number": "८-२३-४", "content_sanskrit": "पुरी किलकिला नाम तत्र राजा बभूव ह ।\nपुण्डरीकादयो नागास्तस्मिन्राज्यं प्रशासति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002712004, "chapter_id": 22712, "verse_number": "८-२३-५", "content_sanskrit": "गेहे गेहे जनैस्सर्वैः पूजनीया बभूविरे ।\nस्वाहा स्वधा वषट्कारो देवपूजा महीतले ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002712005, "chapter_id": 22712, "verse_number": "८-२३-६", "content_sanskrit": "त्यक्त्वा देवानुपागम्य संस्थिता मेरुमूर्द्धनि ।\nशक्राज्ञया कुबेरस्तु शूकधान्यं समन्ततः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002712006, "chapter_id": 22712, "verse_number": "८-२३-७", "content_sanskrit": "यक्षैः षडंशानादाय देवेभ्यः प्रददौ प्रभुः ।\nमणिस्वर्णादिवस्तूनि मौनराज्येषु यानि वै ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002712007, "chapter_id": 22712, "verse_number": "८-२३-८", "content_sanskrit": "दत्तानि तानि कोशेषु पुनर्देवश्चकार ह ।\nमण्डलीकं पदं तेन सत्कृतं भूतनन्दिना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002712008, "chapter_id": 22712, "verse_number": "८-२३-९", "content_sanskrit": "शतार्द्धं तु ततो राजा शिशुनन्दिर्बभूव ह ।\nनागपूजां पुरस्कृत्य तिरस्कृत्य सुरान्भुवि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002712009, "chapter_id": 22712, "verse_number": "८-२३-१०", "content_sanskrit": "चकार राज्यं विशाब्दं यशोनन्दिस्ततोऽनुजः ।\nभ्रात्रासनं स्वयं प्राप्तो नागपूजापरायणः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002712010, "chapter_id": 22712, "verse_number": "८-२३-११", "content_sanskrit": "पञ्चविंशतिवर्षाणि स च राज्यमचीकरत् ।\nततस्तत्तनयो राजा स बभूव प्रवीरकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002712011, "chapter_id": 22712, "verse_number": "८-२३-१२", "content_sanskrit": "एकादशाब्दं तद्राज्यं कर्मभूम्यां प्रकीर्तितम् ।\nकदाचित्स च बाह्लीके सेनया सार्द्धमागतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002712012, "chapter_id": 22712, "verse_number": "८-२३-१३", "content_sanskrit": "तत्र तैरभवद्युद्धं पैशाचैर्म्लेच्छदारुणैः ।\nमासमात्रान्तरे म्लेच्छा लक्षसंख्या मृतिं गताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002712013, "chapter_id": 22712, "verse_number": "८-२३-१४", "content_sanskrit": "तथा षष्टिसहस्राश्च नागभक्ता लयं गताः ।\nबादलो नाम तद्राजा रोमजस्थो महाबलः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002712014, "chapter_id": 22712, "verse_number": "८-२३-१५", "content_sanskrit": "यशोनन्दिनमाहूय ददौ जालवतीं सुताम् ।\nगृहीत्वा म्लेच्छराजस्य सुतां गेहमुपागतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002712015, "chapter_id": 22712, "verse_number": "८-२३-१६", "content_sanskrit": "गर्भो जातस्ततस्तस्यां बभूव तनयो बली ।\nबाह्लीको नाम विख्यातो नागपूजनतत्परः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002712016, "chapter_id": 22712, "verse_number": "८-२३-१७", "content_sanskrit": "तदन्वये नृपा जाता बाह्लीकाश्च त्रयोदश ।\nचतुश्शतानि वर्षाणि कृत्वा राज्यं मृतिं गताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002712017, "chapter_id": 22712, "verse_number": "८-२३-१८", "content_sanskrit": "अयोमुखे च बाह्लीके राज्यमत्र प्रशासति ।\nतदा पितृगणास्सर्वे कृष्णचैतन्यमाययुः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002712018, "chapter_id": 22712, "verse_number": "८-२३-१९", "content_sanskrit": "नत्वोचुर्वचनं तत्र भगवञ्छृणु मे वचः ।\nवयं पितृगणा भूपैर्नागवंश्यैर्निराकृताः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002712019, "chapter_id": 22712, "verse_number": "८-२३-२०", "content_sanskrit": "श्राद्धतर्पणकर्माणि तैर्वयं वर्द्धितास्सदा ।\nपितृवृद्धात्सोमवृद्धिस्ततो देवाश्च वर्द्धनाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002712020, "chapter_id": 22712, "verse_number": "८-२३-२१", "content_sanskrit": "देववृद्धाल्लोकवृद्धिस्तस्माद्ब्रह्मा प्रजापतिः ।\nब्रह्मवृद्धात्परं हर्षं गेहे गेहे जने जने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002712021, "chapter_id": 22712, "verse_number": "८-२३-२२", "content_sanskrit": "अतोऽस्मान्रक्ष भगवन्प्रजाः पाहि सनातनीः ।\nइति श्रुत्वा वचस्तेषां यज्ञांशो भगवान्हरिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002712022, "chapter_id": 22712, "verse_number": "८-२३-२३", "content_sanskrit": "पुष्यमित्रं धर्मपरमार्यवशविवर्द्धनम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002712023, "chapter_id": 22712, "verse_number": "८-२३-२४", "content_sanskrit": "जातमात्रः स वै बालः षोडशार्द्धवयोऽभवत् ।\nअयोनिर्योनिभूतांस्तानयोमुख पुरस्सरान् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002712024, "chapter_id": 22712, "verse_number": "८-२३-२५", "content_sanskrit": "जित्वा देशान्निराकृत्य स्वयं राज्यं गृहीतवान् ।\nयथा शिवांशतो जातो विक्रमो नाम भूपतिः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002712025, "chapter_id": 22712, "verse_number": "८-२३-२६", "content_sanskrit": "शकान्गन्धर्वपक्षीयाञ्जित्वा पूज्यो बभूव ह ।\nनागपक्षांस्तथा भूपान्गोलकास्यान्भयङ्करान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002712026, "chapter_id": 22712, "verse_number": "८-२३-२७", "content_sanskrit": "पुष्यमित्रस्तदा जित्वा सर्वपूज्योऽभवद्भुवि ।\nसप्तविंशच्छतं वर्षं द्विसप्तत्युत्तरं तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002712027, "chapter_id": 22712, "verse_number": "८-२३-२८", "content_sanskrit": "राज्यं विक्रमतो जातं समाप्तिमगमत्तदा ।\nपुष्यमित्रे राज्यपदं प्राप्ते समभवत्तदा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002712028, "chapter_id": 22712, "verse_number": "८-२३-२९", "content_sanskrit": "शतवर्षं राज्यपदं तेन धर्मात्मना धृतम् ।\nअयोध्या मथुरा माया काशी काञ्ची ह्यवन्तिका ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002712029, "chapter_id": 22712, "verse_number": "८-२३-३०", "content_sanskrit": "पुरी द्वारवती तेन राज्ञा च पुनरुद्धृताः ।\nकुरुसूकरपद्मानि क्षेत्राणि विविधानि च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002712030, "chapter_id": 22712, "verse_number": "८-२३-३१", "content_sanskrit": "नैमिषोत्पलवृन्दानां वनक्षेत्राणि भूतले ।\nनानातीर्थानि तेनैव स्थापितानि समन्ततः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002712031, "chapter_id": 22712, "verse_number": "८-२३-३२", "content_sanskrit": "तदा कलिः स गन्धर्वो देवतापितृदूषकः ।\nब्राह्मणं वपुरास्थाय पुष्यमित्रमुपागमत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002712032, "chapter_id": 22712, "verse_number": "८-२३-३३", "content_sanskrit": "नत्वोवाच प्रियं वाक्यं शृणु भूप दयापर ।\nआर्यदेशे पितृगणाः पूजार्हाः श्राद्धतर्पणैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002712033, "chapter_id": 22712, "verse_number": "८-२३-३४", "content_sanskrit": "अज्ञानमिति तज्ज्ञेय भुवि यत्पितृपूजनम् ।\nमृता ये तु नरा भूमौ पूर्वकर्मवशानुगाः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002712034, "chapter_id": 22712, "verse_number": "८-२३-३५", "content_sanskrit": "भवन्ति देहवन्तस्ते चतुराशीतिलक्षधा ।\nछद्मना मयदेवेन पितृपूजा विनिर्मिता ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002712035, "chapter_id": 22712, "verse_number": "८-२३-३६", "content_sanskrit": "वृथा श्रमं वृथा कर्म नृणां च पितृपूजनम् ।\nइति श्रुत्वा वचो घोरं विहस्याह महीपतिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002712036, "chapter_id": 22712, "verse_number": "८-२३-३७", "content_sanskrit": "भवान्मूर्खो महामूढो न जानीष परं फलम् ।\nभुवर्लोके न ये दृष्टाः शून्यभूताश्च भास्वराः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002712037, "chapter_id": 22712, "verse_number": "८-२३-३८", "content_sanskrit": "ये तु ते वै पितृगणाः पिण्डरूपविमानगाः ।\nसत्पुत्रैश्च विधानेन पिण्डदानं च यत्कृतम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002712038, "chapter_id": 22712, "verse_number": "८-२३-३९", "content_sanskrit": "तद्विमानं नभोजातं सर्वानन्दप्रदायकम् ।\nअब्दमात्रं स्थितिस्तेषां पिण्डपायसरूपिणाम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002712039, "chapter_id": 22712, "verse_number": "८-२३-४०", "content_sanskrit": "गीताष्टादशकाध्यायैः सप्तशत्याश्चरित्रकैः ।\nपावितं यत्तु वै पिण्डं त्रिशताब्दं च तत्स्थितिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002712040, "chapter_id": 22712, "verse_number": "८-२३-४१", "content_sanskrit": "श्राद्धतर्पणहीना ये दृश्यन्ते मानवा भुवि ।\nते सर्वे नारका ज्ञेयाः कुलमेकोत्तरं शतम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002712041, "chapter_id": 22712, "verse_number": "८-२३-४२", "content_sanskrit": "श्राद्धकर्म महान्धर्मः श्राद्धोऽयं सर्वकारणम् ।\nइति श्रुत्वा स गन्धर्वः कलीराजोऽत्र देहिनाम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002712042, "chapter_id": 22712, "verse_number": "८-२३-४३", "content_sanskrit": "नत्वोवाच नृपश्रेष्ठं प्रसन्नवदनो हि सः ।\nसदा भव ममाशु त्वं तवाहं नृप किङ्करः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002712043, "chapter_id": 22712, "verse_number": "८-२३-४४", "content_sanskrit": "कलिमित्रः पुष्यमित्रो भवान्भुवि भवेत्सदा ।\nयथा विक्रमराजस्य वैतालस्य च वै सखा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002712044, "chapter_id": 22712, "verse_number": "८-२३-४५", "content_sanskrit": "सर्वकार्यकरोऽहं वै तथा तव न संशयः ।\nइत्युक्त्या च नृपं धीरं समादाय स वै कलिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002712045, "chapter_id": 22712, "verse_number": "८-२३-४६", "content_sanskrit": "सप्तद्वीपांस्तथा खण्डान्नभोमार्गाननेकशः ।\nस्वपृष्ठस्थाय राज्ञे च दर्शयामास वीर्यवान् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002712046, "chapter_id": 22712, "verse_number": "८-२३-४७", "content_sanskrit": "आर्यधर्मं कलौ स्थाप्य नष्टभूतं स वै नृपः ।\nत्यक्त्वा प्राणांश्च यज्ञांशे तेजस्तस्य समागमत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002712047, "chapter_id": 22712, "verse_number": "८-२३-४८", "content_sanskrit": "आन्ध्रदेशोद्भवो राजा सुगदो नाम वीर्यवान् ।\nविना भूपं च तं देशं दृष्ट्वा राज्यमचीकरत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002712048, "chapter_id": 22712, "verse_number": "८-२३-४९", "content_sanskrit": "विंशदब्दं पदं तेन कर्मभूम्यां च सत्कृतम् ।\nतदन्वये षष्टिनृपा बभूवुर्बहुमार्गिणः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002712049, "chapter_id": 22712, "verse_number": "८-२३-५०", "content_sanskrit": "पुष्यमित्रगते राज्ये दशोत्तरशतत्रयम् ।\nतस्मिन्काले लयं जग्मुश्चान्ध्रदेशनिवासिनः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002712050, "chapter_id": 22712, "verse_number": "८-२३-५१", "content_sanskrit": "शतार्द्धाब्दं ततो भूमिर्विना राज्ञा बभूव ह ।\nतदा क्षुद्रा नरा लुब्धा लुण्ठिताश्चौरदारुणैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002712051, "chapter_id": 22712, "verse_number": "८-२३-५२", "content_sanskrit": "दारिद्रमगमन्घोरं विना स्वर्णं च भूरभूत् ।\nपुनर्देवश्च भगवान्प्रार्थितस्तानुवाच ह ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002712052, "chapter_id": 22712, "verse_number": "८-२३-५३", "content_sanskrit": "देशे कौशलके जातः सूर्य्यांशाच्य महीपतिः ।\nराक्षसारिरिति ख्यातो देवमार्गपरायणः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002712053, "chapter_id": 22712, "verse_number": "८-२३-५४", "content_sanskrit": "ममाज्ञया स वै राजा भविष्यति महीतले ।\nइत्युक्त्वान्तर्दधे विष्णुर्देवलोकानुपागमत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002712054, "chapter_id": 22712, "verse_number": "८-२३-५५", "content_sanskrit": "राक्षसारिमयोध्यायां स्थापयामासुरेव तम् ।\nआन्ध्रराष्ट्रे च यद्द्रव्यं राक्षसैश्च समाहृतम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002712055, "chapter_id": 22712, "verse_number": "८-२३-५६", "content_sanskrit": "तद्द्रव्यं राक्षसाञ्जित्वा ग्रामे ग्रामे चकार सः ।\nतारधातोरष्टमूल्यं सुवर्णं भुवि तत्कृतम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002712056, "chapter_id": 22712, "verse_number": "८-२३-५७", "content_sanskrit": "आरधा तोः शतं मूल्यं राजतं तेन वै कृतम् ।\nताम्रधातोः पञ्चमूल्यमारधातोश्च तत्कृतम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002712057, "chapter_id": 22712, "verse_number": "८-२३-५८", "content_sanskrit": "नागधातोः पञ्चमूल्यं भुवि तेनैव निर्मितम् ।\nताम्रं पवित्रमधिकं नागो वङ्गस्तथोत्तमः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002712058, "chapter_id": 22712, "verse_number": "८-२३-५९", "content_sanskrit": "लौहधातोः शतं मूल्यं वङ्गोऽसौ तेन सत्कृतः ।\nशतार्द्धाब्दं महीं भुक्त्वा सूर्यलोकमुपाययौ ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002712059, "chapter_id": 22712, "verse_number": "८-२३-६०", "content_sanskrit": "तदन्वये षष्टिनृपा जाता वेदपरायणाः ।\nपुष्यमित्रगते राज्ये चाब्दे सप्तशते गते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002712060, "chapter_id": 22712, "verse_number": "८-२३-६१", "content_sanskrit": "कौशलान्वयसम्भूता भूपाः स्वर्गमुपाययुः ।\nशतार्द्धाब्दं ततो भूमिर्मण्डलीकं नृपं विना ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002712061, "chapter_id": 22712, "verse_number": "८-२३-६२", "content_sanskrit": "क्षुद्रभूपाश्च बुभुजे देशे देशे च भार्गवः ।\nततो बैदरदेशीयो नाम्ना भूपो विशारदः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002712062, "chapter_id": 22712, "verse_number": "८-२३-६३", "content_sanskrit": "आर्यदेशमुपागम्य लक्षसैन्यसमन्वितः ।\nक्षुद्रभूपान्वशीकृत्य मण्डलीको बभूव ह ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002712063, "chapter_id": 22712, "verse_number": "८-२३-६४", "content_sanskrit": "नानाकलैश्च कर्माणि विचित्राणि महीतले ।\nग्रामे ग्रामे नराश्चकुर्वर्णसङ्करकारकाः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002712064, "chapter_id": 22712, "verse_number": "८-२३-६५", "content_sanskrit": "ब्रह्मक्षत्रमयो वर्णो नाममात्रेण दृश्यते ।\nवैश्यप्राया नरा आर्याः शूद्रप्रायाश्च कारिणः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002712065, "chapter_id": 22712, "verse_number": "८-२३-६६", "content_sanskrit": "तद्राष्ट्रे मनुजाश्चासन्नाममात्रं सुरार्चकाः ।\nषष्टिवर्षं पदं तेन कर्मभूम्यां च सत्कृतम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002712066, "chapter_id": 22712, "verse_number": "८-२३-६७", "content_sanskrit": "ततो नृपा महीं प्राप्ताः षट्सङ्ख्यास्तु तदन्वयाः ।\nपुष्यमित्रगते राष्ट्रे शतषोडशहायनी ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002712067, "chapter_id": 22712, "verse_number": "८-२३-६८", "content_sanskrit": "वैदूरा निधनं जग्मुः कलिकाले भयानके ।\nचतुश्शतानि वर्षाणि क्षुद्ररूपा च भूरभूत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002712068, "chapter_id": 22712, "verse_number": "८-२३-६९", "content_sanskrit": "तत्पश्चान्नैषधे राष्ट्रं कालमाली नृपोऽभवत् ।\nक्षुद्रभूपान्वशीकृत्य स्वयं राजा बभूव वै ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002712069, "chapter_id": 22712, "verse_number": "८-२३-७०", "content_sanskrit": "यमाभूया भुवि त्वष्ट्रा नगरी यमुनातटे ।\nनिर्मिता योजनायातु कालकालेति विश्रुता ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002712070, "chapter_id": 22712, "verse_number": "८-२३-७१", "content_sanskrit": "तत्रार्यदेश भूपानां पूज्यो राजा स चाभवत् ।\nदेवान्पितॄंस्तिरस्कृत्य प्रेतपूजां जने जने ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002712071, "chapter_id": 22712, "verse_number": "८-२३-७२", "content_sanskrit": "कालमाली च कृतवान्देशनैषधसंस्थितः ।\nद्वात्रिंशद्वर्षराज्यं तद्बभूव जनपीडनम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002712072, "chapter_id": 22712, "verse_number": "८-२३-७३", "content_sanskrit": "तदन्वये षष्टिनृपा बभूवुः प्रेतपूजकाः ।\nशताब्दांतमभूद्राज्यं तेषां नैषधदेशिनाम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002712073, "chapter_id": 22712, "verse_number": "८-२३-७४", "content_sanskrit": "सहस्राब्दं तु तत्पश्चात्क्षुद्रभूपा मही ह्यभूत् ।\nसुरार्चनं वेदमार्गः श्रुतमात्रश्च दृश्यते ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002712074, "chapter_id": 22712, "verse_number": "८-२३-७५", "content_sanskrit": "पुष्यमित्रगते राज्ये चैकत्रिंशच्छते कलौ ।\nद्वात्रिंशदुत्तरे चैव तदा देवाश्च दुःखिताः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002712075, "chapter_id": 22712, "verse_number": "८-२३-७६", "content_sanskrit": "कृष्णचैतन्यमागम्य नत्वोचुर्वचनं प्रियम् ।\nभगवन्कलिकालेऽद्य वर्णाश्चत्वारिभूतले ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002712076, "chapter_id": 22712, "verse_number": "८-२३-७७", "content_sanskrit": "भ्रष्टाचाराः प्रेतमयाः शतार्द्धाब्दप्रजीविनः ।\nदेवान्पितॄंस्तिरस्कृत्य पिशाचान्पूजयन्ति वै ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002712077, "chapter_id": 22712, "verse_number": "८-२३-७८", "content_sanskrit": "ग्रामे ग्रामे च कुघ्नानि पूजितानि नरैर्भुवि ।\nदृश्यन्तेऽस्माभिरद्यैव दुःखिताश्च नरा भृशम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002712078, "chapter_id": 22712, "verse_number": "८-२३-७९", "content_sanskrit": "भूतप्रेतपिशाचाश्च डाकिनीशाकिनीगणाः ।\nस्वपूजाभिर्मदान्धाश्च निन्दयन्ति सुरान्पितॄन् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002712079, "chapter_id": 22712, "verse_number": "८-२३-८०", "content_sanskrit": "अतोऽस्मान्दुर्बलान्विद्धि सबलान्भूतनायकान् ।\nकृपया पाहि नः स्वामिञ्छरणागतवत्सल ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002712080, "chapter_id": 22712, "verse_number": "८-२३-८१", "content_sanskrit": "इति श्रुत्वा स यज्ञांशो नदीहोपवने स्थितः ।\nनम्रभूतान्सुरान्प्राह मागधे तु महीपतिः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002712081, "chapter_id": 22712, "verse_number": "८-२३-८२", "content_sanskrit": "पुरञ्जयो ब्रह्मपरस्तस्य पत्नी पुरञ्जनी ।\nमदाज्ञया तयोः पुत्रो भविष्यति महाबलः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002712082, "chapter_id": 22712, "verse_number": "८-२३-८३", "content_sanskrit": "विश्वस्फूर्जिरिति ख्यातो ब्रह्ममार्गपरो गुणी ।\nइत्युक्तवचने तस्मिन्गर्भं धत्ते पुरञ्जनी ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002712083, "chapter_id": 22712, "verse_number": "८-२३-८४", "content_sanskrit": "दशमासान्तरे जातो विश्वस्फूर्जिर्महाबलः ।\nजातमात्रे सुते तस्मिन्वागुवाचाशरीरिणी ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002712084, "chapter_id": 22712, "verse_number": "८-२३-८५", "content_sanskrit": "पुष्यमित्रो यथा चासीद्वर्णधर्मप्रवर्तकः ।\nतथायं बालको जातो ब्रह्ममार्गपरो बली ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002712085, "chapter_id": 22712, "verse_number": "८-२३-८६", "content_sanskrit": "करिष्यति परो वर्णान्कलिन्दयदुमद्रकान् ।\nप्रजाश्च ब्रह्मभूयिष्ठाः स्थापयिष्यति दुर्मतिः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002712086, "chapter_id": 22712, "verse_number": "८-२३-८७", "content_sanskrit": "वीर्यवान्क्षत्रमुत्साद्य पद्मवत्याः स वै पुरम् ।\nइत्याकाशवचः श्रुत्वा स नृपस्तु पुरञ्जयः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002712087, "chapter_id": 22712, "verse_number": "८-२३-८८", "content_sanskrit": "ददौ दानं क्षुधार्तेभ्योऽतिथिभ्यस्सपरिच्छदः ।\nअष्टौ वर्षसहस्राणि चाष्टवर्षशतानि च ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002712088, "chapter_id": 22712, "verse_number": "८-२३-८९", "content_sanskrit": "कर्मभूम्यां कलौ प्राप्ते व्यतीतानि तदा मुने ।\nविश्वस्फूर्जिर्नृपश्चासीन्महाबुद्धो महाबलः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002712089, "chapter_id": 22712, "verse_number": "८-२३-९०", "content_sanskrit": "क्षुद्रभूपान्वशीकृत्य सर्ववर्णान्नरांस्तदा ।\nस्थापयामास वै ब्रह्मे वर्णे ब्रह्मपरायणे ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002712090, "chapter_id": 22712, "verse_number": "८-२३-९१", "content_sanskrit": "क्षत्रविट्च्छूद्रका वर्णाः पिशाचा वर्णसङ्कराः ।\nगुरुण्डाद्यास्तथा म्लेच्छा ब्राह्मणास्ते बभूविरे ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002712091, "chapter_id": 22712, "verse_number": "८-२३-९२", "content_sanskrit": "सन्ध्यातर्पणदेवानां पूजादिविविधाः क्रियाः ।\nचक्रुस्ते वेदविधिना तुल्यभोजनशीलिनः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002712092, "chapter_id": 22712, "verse_number": "८-२३-९३", "content_sanskrit": "षष्टिवर्षं कृतं राज्यं तेन सम्यक्कृता मुने ।\nतदन्वये नृपाश्चासन्सहस्रा भुवि विश्रुताः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002712093, "chapter_id": 22712, "verse_number": "८-२३-९४", "content_sanskrit": "अयुताब्दान्तरे जाता ब्रह्ममार्गपरायणाः ।\nतैश्च दत्तानि भागानि यज्ञमध्ये विधानतः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002712094, "chapter_id": 22712, "verse_number": "८-२३-९५", "content_sanskrit": "दैत्येभ्यश्च सुरेभ्यश्च तुल्यरूपाणि चागमन् ।\nविस्मिताश्च सुरास्सर्वे यज्ञांशं शरणं ययुः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002712095, "chapter_id": 22712, "verse_number": "८-२३-९६", "content_sanskrit": "तदुक्तं कारणं ज्ञात्वा शक्रपुत्र उवाच तान् ।\nवेदो नारायणः साक्षाद्विवेकी हंसरूपवान् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002712096, "chapter_id": 22712, "verse_number": "८-२३-९७", "content_sanskrit": "नृणां च युगभेदेन वर्णभेदं चकार ह ।\nतद्गुणो ब्राह्मणो वर्णः क्षत्रियस्तु रजोगुणः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002712097, "chapter_id": 22712, "verse_number": "८-२३-९८", "content_sanskrit": "तमोगुणस्तथा वैश्यो गुणसाम्यात्तु शूद्रकः ।\nतृप्तिं यान्ति पितुर्वृन्दा ब्राह्मणैः क्षत्रियैः सुराः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002712098, "chapter_id": 22712, "verse_number": "८-२३-९९", "content_sanskrit": "वैश्यैश्च यक्षरक्षांसि क्षुद्रैर्दैत्याश्च दानवाः ।\nएकवर्णे च चत्वारो वर्णाः कायस्थ एव सः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002712099, "chapter_id": 22712, "verse_number": "८-२३-१००", "content_sanskrit": "भूतप्रेतपिशाचाद्याः कायस्थैस्तर्पितास्सदा ।\nब्रह्मवर्णे तु वर्णाश्च स्थिताश्चत्वारि साम्प्रतम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7002712100, "chapter_id": 22712, "verse_number": "८-२३-१०१", "content_sanskrit": "ब्रह्मशङ्करवर्णोऽयं तेभ्यः पूर्वं हि दानवाः ।\nअर्द्धतृप्ता भविष्यन्ति तत्पश्चात्स्वर्गवासिनः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7002712101, "chapter_id": 22712, "verse_number": "८-२३-१०२", "content_sanskrit": "अतोऽहं च कलौ घोरे युष्मदर्थे महीतले ।\nसौराष्टनृपतेर्गेहं स्वांशाद्यास्यामि भोः सुराः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7002712102, "chapter_id": 22712, "verse_number": "८-२३-१०३", "content_sanskrit": "इत्युक्त्वा स च यज्ञांशः सोमनाथः कलैकया ।\nनाम्ना बभूव तद्गेहे सौराष्ट्रनगरीस्थितः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7002712103, "chapter_id": 22712, "verse_number": "८-२३-१०४", "content_sanskrit": "जित्वा भूपान्स्वयं राज्यं चकाराब्धितटे मुदा ।\nक्षत्रवर्णमयी भूमिस्तदा जाता कलौ युगे ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7002712104, "chapter_id": 22712, "verse_number": "८-२३-१०५", "content_sanskrit": "सोमनाथः स वै यज्ञैः सुरान्सर्वानतर्पयत् ।\nशताब्दं च कृतं राज्यं तेन देवप्रसादतः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7002712105, "chapter_id": 22712, "verse_number": "८-२३-१०६", "content_sanskrit": "तस्य राज्यमयं संवदभवल्लोकविश्रुतम् ।\nतदन्वये सार्द्धशतं भूपाश्चासन्सुरप्रियाः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7002712106, "chapter_id": 22712, "verse_number": "८-२३-१०७", "content_sanskrit": "अयुताब्दान्तरे किञ्चिदधिके च सुखप्रदाः ।\nकर्मभूम्यां कलौ प्राप्ते हायना अयुतत्रयम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7002712107, "chapter_id": 22712, "verse_number": "८-२३-१०८", "content_sanskrit": "व्यतीतं च ततो दैत्या दुःखिताः कलिमब्रुवन् ।\nपुरास्समाभिः शताब्दं च तपसा वै महेश्वरः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7002712108, "chapter_id": 22712, "verse_number": "८-२३-१०९", "content_sanskrit": "तुष्टीकृतस्तदास्मभ्यं भवान्दत्तो हितेन वै ।\nअर्धभागं वज्रमयमर्धभागं च कोमलम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7002712109, "chapter_id": 22712, "verse_number": "८-२३-११०", "content_sanskrit": "तवाङ्गं सुन्दरं देव कलेऽस्मान्रक्ष दुःखितान् ।\nइति श्रुत्वा च स कलिर्देत्यपक्षविवर्द्धनः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7002712110, "chapter_id": 22712, "verse_number": "८-२३-१११", "content_sanskrit": "स्वांशाज्जन्म कलौ प्राप्य गुर्जरे देशदारुणे ।\nआभीरी सिंहिका नाम सिहमांसाशना खला ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7002712111, "chapter_id": 22712, "verse_number": "८-२३-११२", "content_sanskrit": "तस्या योनौ समागम्य राहुर्नाम स चाभवत् ।\nयथा राहुर्नभोमार्गे दारुणो हि विधुन्तुदः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7002712112, "chapter_id": 22712, "verse_number": "८-२३-११३", "content_sanskrit": "तथा राहुः कलेरंशो भुवि जातः सुरन्तुदः ।\nजातमात्रे सुते तस्मिन्भूमिकम्पो महानभूत् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7002712113, "chapter_id": 22712, "verse_number": "८-२३-११४", "content_sanskrit": "विपरीता ग्रहाः सर्वे जनयन्ति महद्भयम् ।\nतद्भयात्सकला देवास्त्यक्त्वा मूर्तीः समन्ततः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7002712114, "chapter_id": 22712, "verse_number": "८-२३-११५", "content_sanskrit": "महेन्द्रं शरणं जग्मुः सुमेरुगिरिमूर्द्धनि ।\nतदर्थे भगवाञ्छक्रस्तुष्टाव जगदम्बिकाम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7002712115, "chapter_id": 22712, "verse_number": "८-२३-११६", "content_sanskrit": "कन्यामूर्तिमयी देवी सुरान्प्राह शिवङ्करी ।\nममाङ्गदर्शनाद्देवाः क्षुत्तृड्भ्यां च विना सदा ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7002712116, "chapter_id": 22712, "verse_number": "८-२३-११७", "content_sanskrit": "भवध्वं च ततो यूयं मद्विलोकनतत्पराः ।\nइति श्रुत्वा तु ते देवा हर्षिताः सम्बमूविरे ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7002712117, "chapter_id": 22712, "verse_number": "८-२३-११८", "content_sanskrit": "आभीरीतनयो राहुः कृत्वा राज्यं शतं समाः ।\nत्यक्त्वा प्राणान्कलौ लीनो बभूव मुनिसत्तम ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7002712118, "chapter_id": 22712, "verse_number": "८-२३-११९", "content_sanskrit": "तदन्वये सार्द्धशतमयुताब्दान्तरेभवत् ।\nमहामदमतं घोरं चिरकालाद्विनाशितम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7002712119, "chapter_id": 22712, "verse_number": "८-२३-१२०", "content_sanskrit": "तैः पुनश्चोद्धृतं भूमौ सर्वे म्लेच्छा बभूविरे ।\nन वेदाश्च न देवाश्च न वर्णाश्च कलौ युगे ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7002712120, "chapter_id": 22712, "verse_number": "८-२३-१२१", "content_sanskrit": "दृश्यन्ते न च मर्यादा कलिकाले तदन्वये ।\nद्विजशेषाः सहस्राश्च पुनरर्बुदमूर्द्धनि ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7002712121, "chapter_id": 22712, "verse_number": "८-२३-१२२", "content_sanskrit": "द्वादशाहं प्रयत्नेन देवानाराधितुं क्षमा ।\nअर्बुदाच्च समुद्भूतो राजन्यः खड्गचर्मधृक् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7002712122, "chapter_id": 22712, "verse_number": "८-२३-१२३", "content_sanskrit": "जित्वा म्लेच्छान्दुराधर्षान्नाम्ना चार्वबली ह्यभूत् ।\nपञ्चयोजनमाना स भूमिरात्मविवृद्धये ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7002712123, "chapter_id": 22712, "verse_number": "८-२३-१२४", "content_sanskrit": "निर्मिता तेन शुद्धेन नाम्ना चार्वपुरी स्मृता ।\nशनैः शनैरार्यकुलं पुनस्तत्र ववर्द्ध ह ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7002712124, "chapter_id": 22712, "verse_number": "८-२३-१२५", "content_sanskrit": "शतार्द्धाब्दं प्रयत्नेन तेन राज्यं महत्कृतम् ।\nतदन्वये सार्द्धशतं नृपाश्चासंस्तदा मुने ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7002712125, "chapter_id": 22712, "verse_number": "८-२३-१२६", "content_sanskrit": "अयुताब्दान्तरे वीरा म्लेच्छमित्राश्च सङ्कराः ।\nम्लेच्छकन्योद्वहा घोरा नाममात्रार्य्यमार्गगाः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7002712126, "chapter_id": 22712, "verse_number": "८-२३-१२७", "content_sanskrit": "तदा मलयदेशस्थैर्म्लेच्छैर्लक्षप्रमाणकैः ।\nआर्वुदार्यैः समं युद्धमभवल्लोमहर्षणम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7002712127, "chapter_id": 22712, "verse_number": "८-२३-१२८", "content_sanskrit": "वर्षमात्रान्तरे जित्वा मालवस्था महाबलाः ।\nमण्डलीकपदातैश्च मुक्तमार्यैः समन्ततः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7002712128, "chapter_id": 22712, "verse_number": "८-२३-१२९", "content_sanskrit": "चत्वारिंशत्सहस्राणि वर्षाणि जगतीतले ।\nम्लेच्छभूपाश्च शतशो बभूवुः स्वल्पजीविनः ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7002712129, "chapter_id": 22712, "verse_number": "८-२३-१३०", "content_sanskrit": "पंचविंशत्सहस्राणि तेषां संख्या च भूभुजाम् ।\nये तु पुण्या महीपालाः पूर्वजन्मतपोद्भवाः ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7002712130, "chapter_id": 22712, "verse_number": "८-२३-१३१", "content_sanskrit": "तेषां लीला च मुनिभिः पुराणेषु प्रकीर्तिता ।\nनानासंवत्कराः सर्वे पैशाचा धर्मदूषकाः ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7002712131, "chapter_id": 22712, "verse_number": "८-२३-१३२", "content_sanskrit": "नवत्यब्दसहस्राणि व्यतीतानि कलौ युगे ।\nजाता म्लेच्छमयी भूमिरलक्ष्मीस्तु जनेजने ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}]