[{"id": 2135532, "chapter_id": 3939, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135533, "chapter_id": 3939, "verse_number": "१", "content_sanskrit": "तथाऽऽसीनेषु सर्वेषु तेषु राजसु भारत ।\nकोटिकाश्यो जगामाशु सिन्धुराजनिवेशनम् ।\nयदुक्तं कृष्णया सार्धं तत्सर्वं प्रत्यवेदयत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135534, "chapter_id": 3939, "verse_number": "", "content_sanskrit": "सैन्धवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135535, "chapter_id": 3939, "verse_number": "२", "content_sanskrit": "यदा वाचं व्याहरन्त्यामस्यां मे रमते मनः ।\nसीमन्तिनीनां मुख्यायां विनिवृत्तः कथं भवान् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135536, "chapter_id": 3939, "verse_number": "३", "content_sanskrit": "एतां दृष्ट्वा स्त्रियो मेऽन्या यथा शाखामृगस्त्रियः ।\nप्रतिभान्ति महाबाहो सत्यमेतद् ब्रवीमि ते \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135537, "chapter_id": 3939, "verse_number": "४", "content_sanskrit": "दर्शनादेव हि मनस्तया मेऽपहृतं भृशम् ।\nतां समाचक्ष्व कल्याणीं यदि स्याच्छैब्य मानुषी \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135538, "chapter_id": 3939, "verse_number": "", "content_sanskrit": "कोटिकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135539, "chapter_id": 3939, "verse_number": "५", "content_sanskrit": "एषा वै द्रौपदी कृष्णा राजपुत्री यशस्विनी ।\nपञ्चानां पाण्डुपुत्राणां महिषी सम्मता भृशम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135540, "chapter_id": 3939, "verse_number": "६", "content_sanskrit": "सर्वेषां चैव पार्थानां प्रिया बहुमता सती ।\nतयाऽसमेत्य सौवीर सौवीराभिमुखो व्रज \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135541, "chapter_id": 3939, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135542, "chapter_id": 3939, "verse_number": "७", "content_sanskrit": "एवमुक्तः प्रत्युवाच पश्यामि द्रौपदीमिति ।\nपतिः सौवीरसिन्धूनां दुष्टभावो जयद्रथः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135543, "chapter_id": 3939, "verse_number": "८", "content_sanskrit": "स प्रविश्याश्रमं पुण्यं सिंहगोष्ठं वृको यथा ।\nआत्मना सप्तमः कृष्णामिदं वचनमब्रवीत् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135544, "chapter_id": 3939, "verse_number": "९", "content_sanskrit": "कुशलं ते वहारोहे भर्तारस्तेऽप्यनामयाः।\nयेषां कुशलकामासि तेऽपि कच्चिदनामयाः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135545, "chapter_id": 3939, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135546, "chapter_id": 3939, "verse_number": "१०", "content_sanskrit": "अपि ते कुशलं राजन् राष्ट्रे कोशे बले तथा ।\nकच्चिदेकः शिबीनाढ्यान् सौवीरान् सह सिन्धुभिः।\nअनुतिष्ठसि धर्मेण ये चान्ये विजितास्त्वया \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135547, "chapter_id": 3939, "verse_number": "११", "content_sanskrit": "कौरव्यः कुशली राजा कुन्तीपुत्रो युधिष्ठिरः ।\nअहं च भ्रातरश्चास्य यांश्चान्यान् परिपृच्छसि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135548, "chapter_id": 3939, "verse_number": "१२", "content_sanskrit": "पाद्यं प्रतिगृहाणेदमासनं च नृपात्मज ।\nमृगान्विता मृगीश्चैव प्रातराशं ददानि ते \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135549, "chapter_id": 3939, "verse_number": "१३", "content_sanskrit": "ऐणेयान् पृषतान् न्यङ्कून् हरिणान् शरभान् शशान् ।\nऋक्षान् रुरून् शम्बरांश्च गवयांश्च मृगान् बहून् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135550, "chapter_id": 3939, "verse_number": "१४", "content_sanskrit": "वराहान् महिषांश्चैव याश्चान्या मृगजातयः।\nप्रदास्यति स्वयं तुभ्यं कुन्तीपुत्रो युधिष्ठिरः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135551, "chapter_id": 3939, "verse_number": "", "content_sanskrit": "जयद्रथः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135552, "chapter_id": 3939, "verse_number": "१५", "content_sanskrit": "कुशलं प्रातराशस्य सर्वा मेऽपचितिः कृता ।\nएहि मे रथामारोह सुखमाप्नुहि केवलम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135553, "chapter_id": 3939, "verse_number": "१६", "content_sanskrit": "गतश्रीकान् हृतराज्यान् कृपणान् गतचेतसः ।\nअरण्यवासिनः पार्थान् नानुरोद्धुं त्वमर्हसि \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135554, "chapter_id": 3939, "verse_number": "१७", "content_sanskrit": "नैव प्राज्ञा गतश्रीकं भर्तारमुपयुञ्जते ।\nयुञ्जानमनुयुञ्जीत न श्रियः सङ्क्षये वसेत् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135555, "chapter_id": 3939, "verse_number": "१८", "content_sanskrit": "श्रिया विहीना राष्ट्राच्च विनष्टाः शाश्वतीः समाः ।\nअलं ते पाण्डुपुत्राणां भक्त्या क्लेशमुपासितुम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2135556, "chapter_id": 3939, "verse_number": "१९", "content_sanskrit": "भार्या मे भव सुश्रोणि त्यजैनान् सुखमाप्नुहि ।\nअखिलान् सिन्धुसौवीरानाप्नुहि त्वं मया सह \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2135557, "chapter_id": 3939, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2135558, "chapter_id": 3939, "verse_number": "२०", "content_sanskrit": "इत्युक्ता सिन्धुराजेन वाक्यं हृदयकम्पनम् ।\nकृष्णा तस्मादपाक्रामद् देशात् सभ्रुकुटीमुखी \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2135559, "chapter_id": 3939, "verse_number": "२१", "content_sanskrit": "अवमत्यास्य तद्वाक्यमाक्षिप्य च सुमध्यमा ।\nमैवमित्यब्रवीत् कृष्णा लज्जस्वेति च सैन्धवम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2135560, "chapter_id": 3939, "verse_number": "२२", "content_sanskrit": "सा काङ्क्षमाणा भर्तॄणामुपयातमनिन्दिता ।\nविलम्बयामास परं वाक्यैर्वाक्यानि युञ्जती\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2135561, "chapter_id": 3939, "verse_number": "२३", "content_sanskrit": "नैवं वद महाबाहो न्याय्यं त्वं न च मन्यसे ।\nपाण्डूनां धार्तराष्ट्राणां स्वसा चैव कनीयसी\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2135562, "chapter_id": 3939, "verse_number": "२४", "content_sanskrit": "दुःशला नाम तस्यास्त्वं भर्ता राजकुलोद्वह ।\nमम भ्राता च न्याय्येन त्वया रक्ष्या महारथ ।\nधर्मिष्ठानां कुले जातो न धर्मं त्वमवेक्षसे \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2135563, "chapter_id": 3939, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2135564, "chapter_id": 3939, "verse_number": "२५", "content_sanskrit": "इत्युक्तः सिन्धुराजोऽथ वाक्यमुत्तरमब्रवीत् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2135565, "chapter_id": 3939, "verse_number": "२६", "content_sanskrit": "राज्ञां धर्मं न जानीषे स्त्रियो रत्नानि चैव हि ।\nसाधारणानि लोकेऽस्मिन् प्रवदन्ति मनीषिणः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2135566, "chapter_id": 3939, "verse_number": "२७", "content_sanskrit": "स्वसा च स्वस्रिया चैव भ्रातृभार्या तथैव च ।\nसुखं गृह्णन्ति राजानस्ताश्च तत्र नृपोद्भवाः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2135567, "chapter_id": 3939, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि द्रौपदीहरणपर्वणि जयद्रथद्रौपदीसंवादे पञ्चपञ्चाशत्यधिकद्विशततमोऽध्यायः ॥२५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2135568, "chapter_id": 3939, "verse_number": "", "content_sanskrit": "द्रौपदीहरणपर्वणि पञ्चमोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]