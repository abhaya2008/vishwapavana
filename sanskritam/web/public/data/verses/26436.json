[{"id": 7006436000, "chapter_id": 26436, "verse_number": "२-९६-१", "content_sanskrit": "वैशम्पायन उवाच\nसत्रावसाने च मुनेः कश्यपस्यातितेजसः ।\nजग्मुर्देवासुराः स्वानि स्थानान्यमितविक्रमाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006436001, "chapter_id": 26436, "verse_number": "२-९६-२", "content_sanskrit": "वज्रनाभोऽपि निर्वृत्ते सत्रे कश्यपमभ्यगात् ।\nत्रैलोक्यविजयाकाङ्क्षी तमुवाचाथ कश्यपः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006436002, "chapter_id": 26436, "verse_number": "२-९६-३", "content_sanskrit": "वज्रनाभ निबोध त्वं श्रोतव्यं यदि चेन्मम ।\nवस वज्रपुरे पुत्र स्वजनेन समावृतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006436003, "chapter_id": 26436, "verse_number": "२-९६-४", "content_sanskrit": "तपसाभ्यधिकः शक्रः शक्तश्चैव स्वभावतः ।\nब्रह्मण्यश्च कृतज्ञश्च ज्येष्ठः श्रेष्ठतमो गुणैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006436004, "chapter_id": 26436, "verse_number": "२-९६-५", "content_sanskrit": "राजा कृत्स्नस्य जगतः पात्रभूतः सतां गतिः ।\nसम्प्राप्तो लोकराज्यं स सर्वभूतहिते रतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006436005, "chapter_id": 26436, "verse_number": "२-९६-६", "content_sanskrit": "नैव शक्यस्त्वया जेतुं वज्रनाभ विहन्यसे ।\nअहिं पदा व्युत्क्रमन्वै नचिराद् विनशिष्यसि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006436006, "chapter_id": 26436, "verse_number": "२-९६-७", "content_sanskrit": "वज्रनाभश्च तद्वाक्यं नाभिनन्दति भारत ।\nकालपाशपरीताङ्गो मर्तुकाम इवौषधम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006436007, "chapter_id": 26436, "verse_number": "२-९६-८", "content_sanskrit": "अभिवाद्य स दुर्बुद्धिः कश्यपं लोकभावनम् ।\nत्रैलोक्यविजयारम्भे मतिं चक्रे दुरासदः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006436008, "chapter_id": 26436, "verse_number": "२-९६-९", "content_sanskrit": "ज्ञातियोधान् समानीय मित्राणि सुबहूनि च ।\nप्रतस्थे स्वर्गमेवाग्रे विजिगीषन् विशाम्पते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006436009, "chapter_id": 26436, "verse_number": "२-९६-१०", "content_sanskrit": "एतस्मिन्नन्तरे देवौ कृष्णेन्द्रौ च महाबलौ ।\nप्रेषयामासतुर्हंसान् वज्रनाभवधं प्रति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006436010, "chapter_id": 26436, "verse_number": "२-९६-११", "content_sanskrit": "समागतास्तु तच्छ्रुत्वा यदुमुख्या महाबलाः ।\nमन्त्रयित्वा महात्मानश्चिन्तामापेदिरे तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006436011, "chapter_id": 26436, "verse_number": "२-९६-१२", "content_sanskrit": "वज्रनाभोऽद्य हन्तव्यः प्रद्युम्नेनेत्यसंशयम् ।\nतयोर्दुहितरो भार्या भक्त्या ताः सर्वभावनाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006436012, "chapter_id": 26436, "verse_number": "२-९६-१३", "content_sanskrit": "सर्वाः सगर्भास्ताश्चैव किं नु कार्यमनन्तरम् ।\nप्राप्तः प्रसवकालश्च तासां नातिचिरादिव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006436013, "chapter_id": 26436, "verse_number": "२-९६-१४", "content_sanskrit": "सम्मन्त्रयित्वैतदर्थं हंसानूचुर्महाबलाः ।\nआख्येयमर्थवत् कृत्स्नं शक्रकेशवयोस्तदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006436014, "chapter_id": 26436, "verse_number": "२-९६-१५", "content_sanskrit": "हंसैर्गत्वा तदाख्यातं देवयोस्तद् यथातथम् ।\nताभ्यां हंसास्तु संदिष्टा न भेतव्यमिति प्रभो ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006436015, "chapter_id": 26436, "verse_number": "२-९६-१६", "content_sanskrit": "उत्पत्स्यन्ति गुणैः श्लाघ्याः पुत्रा वः कामरूपिणः ।\nगर्भस्थाः सर्ववेदांश्च साङ्गान्वेत्स्यन्त्यनिन्दिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006436016, "chapter_id": 26436, "verse_number": "२-९६-१७", "content_sanskrit": "तथा चानागतं सर्वमस्त्राणि विविधानि च ।\nसद्य एव युवानश्च भविष्यन्ति सुपण्डिताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006436017, "chapter_id": 26436, "verse_number": "२-९६-१८", "content_sanskrit": "&nbsp;एवमुक्ता गता हंसाः पुनर्वज्रपुरं विभो ।\nशशंसुश्चैव भैमानां शक्रकेशवभाषितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006436018, "chapter_id": 26436, "verse_number": "२-९६-१९", "content_sanskrit": "प्रभावती तदा पुत्रं सुषुवे सदृशं पितुः ।\nसद्यो यौवनसम्प्राप्तं सर्वज्ञत्वं च भारत ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006436019, "chapter_id": 26436, "verse_number": "२-९६-२०", "content_sanskrit": "मासमात्रेण सुषुवे देवी चन्द्रवती नृप ।\nचन्द्रप्रभमिति ख्यातं तनयं सदृशं पितुः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006436020, "chapter_id": 26436, "verse_number": "२-९६-२१", "content_sanskrit": "सद्यश्च यौवनं प्राप्तं सर्वज्ञत्वं च भारत ।\nगुणवत्यपि पुत्रं च गुणवन्तमनिन्दिता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006436021, "chapter_id": 26436, "verse_number": "२-९६-२२", "content_sanskrit": "युवानावथ सद्यस्तौ सर्वशास्त्रार्थकोविदौ ।\nइन्द्रोपेन्द्रप्रसादेन संवृत्तौ युद्धवर्द्धनौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006436022, "chapter_id": 26436, "verse_number": "२-९६-२३", "content_sanskrit": "हर्म्यपृष्ठे वर्द्धमाना दृष्टास्ते यदुनन्दनाः ।\nइन्द्रोपेन्द्रेच्छया वीर नान्यथेत्यवधार्यताम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006436023, "chapter_id": 26436, "verse_number": "२-९६-२४", "content_sanskrit": "निवेदिताश्च सम्भ्रान्तैर्दैत्यैराकाशरक्षिभिः ।\nवज्रनाभाय वीराय त्रिविष्टपजयैषिणे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006436024, "chapter_id": 26436, "verse_number": "२-९६-२५", "content_sanskrit": "वधाय सर्वे गृह्यन्तां ममैते गृहधर्षकाः ।\nइत्युवाचासुरपतिर्वज्रनाभो महासुरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006436025, "chapter_id": 26436, "verse_number": "२-९६-२६", "content_sanskrit": "ततः सैन्यं समा्ज्ञप्तमसुरेन्द्रेण धीमता ।\nआवारयामास दिशः सर्वाः कुरुकुलोद्वह ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006436026, "chapter_id": 26436, "verse_number": "२-९६-२७", "content_sanskrit": "गृह्यन्तामाशु वध्यन्तामिति वाचस्ततस्ततः ।\nउच्चेरुरसुरेन्द्रस्य शासनादरिशासिनः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006436027, "chapter_id": 26436, "verse_number": "२-९६-२८", "content_sanskrit": "तच्छ्रुत्वा व्यथितास्तेषां मातरः पुत्रवत्सलाः ।\nरुरुदुस्ता रुदन्तीश्च प्रद्युम्नः प्रहसन् ब्रवीत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006436028, "chapter_id": 26436, "verse_number": "२-९६-२९", "content_sanskrit": "मा भैष्ट जीवमानेषु स्थितेष्वस्मासु सर्वथा ।\nकिं नो दैत्याः करिष्यन्ति सर्वथा भद्रमस्तु वः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006436029, "chapter_id": 26436, "verse_number": "२-९६-३०", "content_sanskrit": "प्रभावतीमथोवाच प्रद्युम्नो विप्लवां स्थिताम् ।\nपिता तव गदापाणिः पितृव्याश्च स्थितास्तव ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006436030, "chapter_id": 26436, "verse_number": "२-९६-३१", "content_sanskrit": "भ्रातरश्चैव ते देवि ज्ञातयश्च तथापरे ।\nएते पूज्याश्च मान्याश्च तवार्थे खलु सर्वथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006436031, "chapter_id": 26436, "verse_number": "२-९६-३२", "content_sanskrit": "भगिन्यौ पृच्छ भद्रं ते कालोऽयं खलु दारुणः ।\nमरणं सहमानानां युद्ध्यतां विजयो ध्रुवम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006436032, "chapter_id": 26436, "verse_number": "२-९६-३३", "content_sanskrit": "दानवेन्द्रादयो ह्येते योत्स्यन्तेऽस्मद्वधैषिणः ।\nकिमत्र कार्यमस्माभिः सर्वैश्चक्रान्तरस्थितैः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006436033, "chapter_id": 26436, "verse_number": "२-९६-३४", "content_sanskrit": "प्रभावती रुदन्ती तु प्रद्युम्नमिदमब्रवीत् ।\nशिरस्यञ्जलिमाधाय जानुभ्यां पतिता क्षितौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006436034, "chapter_id": 26436, "verse_number": "२-९६-३५", "content_sanskrit": "गृहाण शस्त्रमात्मानं रक्ष शत्रुनिबर्हण ।\nजीवन् पुत्रांश्च दारांश्च द्रष्टासि यदुनन्दन ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006436035, "chapter_id": 26436, "verse_number": "२-९६-३६", "content_sanskrit": "आर्यां नृवर वैदर्भीमनिरुद्धं च मानद ।\nस्मृत्वैतन्मोक्षयात्मानं व्यसनादरिमर्दन ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006436036, "chapter_id": 26436, "verse_number": "२-९६-३७", "content_sanskrit": "दुर्वाससा वरो दत्तो मुनिना मम धीमता ।\nवैधव्यरहिता हृष्टा जीवपुत्रा भविष्यसि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006436037, "chapter_id": 26436, "verse_number": "२-९६-३८", "content_sanskrit": "एष मे हृदयाश्वासो भविता न तदन्यथा ।\nसूर्याग्नितेजसो वाक्यं मुनेरिन्द्रानुजात्मज ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006436038, "chapter_id": 26436, "verse_number": "२-९६-३९", "content_sanskrit": "इत्युक्त्वाथासिमादाय सूपस्पृष्ट्वा मनस्विनी ।\nप्रददौ रौक्मिणेयाय जयस्वेति वरं वरा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006436039, "chapter_id": 26436, "verse_number": "२-९६-४०", "content_sanskrit": "स तं जग्राह धर्मात्मा प्रहृष्टेनान्तरात्मना ।\nप्रणम्य शिरसा दत्तं प्रियया भक्तियुक्तया ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006436040, "chapter_id": 26436, "verse_number": "२-९६-४१", "content_sanskrit": "चन्द्रवत्यपि निस्त्रिंशं गदाय प्रददौ मुदा ।\nतदा गुणवती चैव साम्बायासिं महात्मने ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006436041, "chapter_id": 26436, "verse_number": "२-९६-४२", "content_sanskrit": "हंसकेतुमथोवाच प्रद्युम्नः प्रणतं प्रभुः ।\nइहैव साम्बसहितो युध्यस्व सह यादवैः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006436042, "chapter_id": 26436, "verse_number": "२-९६-४३", "content_sanskrit": "आकाशे दिक्षु सर्वासु योत्स्याम्यहमरिंदम ।\nइत्युक्त्वाथ रथं चक्रे मायया मायिनां वरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006436043, "chapter_id": 26436, "verse_number": "२-९६-४४", "content_sanskrit": "सहस्रशिरसं नागं कृत्वा सारथिमात्मवान् ।\nअनन्तभोगं कौरव्य सर्वनागोत्तमोत्तमम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006436044, "chapter_id": 26436, "verse_number": "२-९६-४५", "content_sanskrit": "स तेन रथमुख्येन हर्षयन् वै प्रभावतीम् ।\nचचारासुरसैन्येषु तृणेष्विव हुताशनः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006436045, "chapter_id": 26436, "verse_number": "२-९६-४६", "content_sanskrit": "शरैराशीविषप्रख्यैरर्द्धचन्द्रानुकारिभिः ।\nभेदनैर्गाधनैश्चैव ततर्द दितिसम्भवान् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006436046, "chapter_id": 26436, "verse_number": "२-९६-४७", "content_sanskrit": "असुराश्च रणे मत्ताः कार्ष्णिं शस्त्रैरितस्ततः ।\nजघ्नुः कमलपत्राक्षं परं निश्चयमास्थिताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006436047, "chapter_id": 26436, "verse_number": "२-९६-४८", "content_sanskrit": "चिच्छेद बाहून् केषांचित्केयूरवलयोज्ज्वलान् ।\nसकुण्डलानि केषांचिच्छिरांस्यपि च चिच्छिदे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006436048, "chapter_id": 26436, "verse_number": "२-९६-४९", "content_sanskrit": "क्षुरच्छिन्नैः शिरोभिश्च कायैश्च शकलैरपि ।\nअसुराणां मही कीर्णा प्रद्युम्नेनातितेजसा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006436049, "chapter_id": 26436, "verse_number": "२-९६-५०", "content_sanskrit": "देवेश्वरो देवगणैः सहितः समितिंजयः ।\nददर्श मुदितो युद्धं भैमानां दितिजैः सह ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006436050, "chapter_id": 26436, "verse_number": "२-९६-५१", "content_sanskrit": "ये गदं चैव साम्बं च दैत्याः समभिदुद्रुवुः ।\nते ययुर्निधनं सर्वे यादांसीव महोदधौ ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006436051, "chapter_id": 26436, "verse_number": "२-९६-५२", "content_sanskrit": "विषमं तु तदा युद्धं दृष्ट्वा देवपतिर्हरिः ।\nगदाय प्रेषयामास स्वं रथं हरिवाहनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006436052, "chapter_id": 26436, "verse_number": "२-९६-५३", "content_sanskrit": "दिदेश मातलिसुतं यन्तारं च सुवर्चसम् ।\nसाम्बायैरावणं नागं प्रेषयामास चेश्वरः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006436053, "chapter_id": 26436, "verse_number": "२-९६-५४", "content_sanskrit": "जयन्तं रौक्मिणेयस्य सहायमददाद् विभुः ।\nऐरावणमधिष्ठातुं प्रवरं स नियुक्तवान् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006436054, "chapter_id": 26436, "verse_number": "२-९६-५५", "content_sanskrit": "देवपुत्रद्विजौ वीरावप्रमेयपराक्रमौ ।\nअनुज्ञाप्य सुराध्यक्षं ब्रह्माणं लोकभावनम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006436055, "chapter_id": 26436, "verse_number": "२-९६-५६", "content_sanskrit": "तं मातलिसुतं चैव गजमैरावणं तदा ।\nदेवः प्रेषितवाञ्छक्रो विधिज्ञो वरकर्मसु ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006436056, "chapter_id": 26436, "verse_number": "२-९६-५७", "content_sanskrit": "क्षीणमस्य तपो वध्यो यदूनामेष दुर्मतिः ।\nप्रवदन्ति तु भूतानि सर्वत्र तु यथेप्सितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006436057, "chapter_id": 26436, "verse_number": "२-९६-५८", "content_sanskrit": "प्रद्युम्नश्च जयन्तश्च प्राप्तौ हर्म्यं महाबलौ ।\nअसुराञ्च्छरजालौघैर्विक्राम्यन्तौ प्रणश्यतुः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006436058, "chapter_id": 26436, "verse_number": "२-९६-५९", "content_sanskrit": "गदं कार्ष्णिस्तदोवाच दुर्वार्यरणदुर्जयः ।\nउपेन्द्रानुज शक्रेण रथोऽयं प्रेषितस्तव ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006436059, "chapter_id": 26436, "verse_number": "२-९६-६०", "content_sanskrit": "हरियुङ्मातलिसुतो यन्ता चायं महाबलः ।\nप्रवराधिष्ठितश्चायं साम्बस्यैरावणो गजः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006436060, "chapter_id": 26436, "verse_number": "२-९६-६१", "content_sanskrit": "अद्योपहारो रुद्रस्य द्वारकायां महाबलः ।\nश्व एष्यति हृषीकेशस्तस्मिन् वृत्तेऽच्युतानुज ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006436061, "chapter_id": 26436, "verse_number": "२-९६-६२", "content_sanskrit": "तस्याज्ञया वधिष्यामो वज्रनाभं सबान्धवम् ।\nअभ्युत्थानकृतं पापं त्रिविष्टपजयं प्रति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006436062, "chapter_id": 26436, "verse_number": "२-९६-६३", "content_sanskrit": "करिष्यामि विधानं तु नैष शक्रं सुतान्वितम् ।\nविजेष्यत्यप्रमादस्तु कर्तव्य इति मे मतिः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006436063, "chapter_id": 26436, "verse_number": "२-९६-६४", "content_sanskrit": "कलत्ररक्षणं कार्यं सर्वोपायैर्नरैर्बुधैः ।\nकलत्रधर्षणं लोके मरणादतिरिच्यते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006436064, "chapter_id": 26436, "verse_number": "२-९६-६५", "content_sanskrit": "एवं संदिश्य भैमः स गदसाम्बौ महाबलः ।\nप्रद्युम्नकोट्यः ससृजे मायया दिव्यरूपया ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006436065, "chapter_id": 26436, "verse_number": "२-९६-६६", "content_sanskrit": "तमश्च नाशयामास दैत्यसृष्टं दुरासदम् ।\nजहृषे देवराजश्च तं दृष्ट्वा रिपुमर्दनम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006436066, "chapter_id": 26436, "verse_number": "२-९६-६७", "content_sanskrit": "ददृशुः सर्वभूतानि कार्ष्णिं सर्वेषु शत्रुषु ।\nअन्तरात्मनि वर्तन्तं क्षेत्रज्ञमिव तं विदुः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006436067, "chapter_id": 26436, "verse_number": "२-९६-६८", "content_sanskrit": "एवं व्यतीता रजनी रौक्मिणेयस्य युध्यतः ।\nअसुराणां त्रिभागश्च निहतश्चातितेजसा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006436068, "chapter_id": 26436, "verse_number": "२-९६-६९", "content_sanskrit": "यावद् वियोधयामास कार्ष्णिर्दैत्यान् रणाजिरे ।\nसंध्योपास्ता जयन्तेन तावद् विष्णुपदीजले ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006436069, "chapter_id": 26436, "verse_number": "२-९६-७०", "content_sanskrit": "अयोधयज्जयन्तश्च यावद् दैत्यान् महाबलः ।\nतावदाकाशगङ्गायां भैमः संध्यामुपास्तवान् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]