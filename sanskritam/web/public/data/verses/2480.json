[{"id": 2070495, "chapter_id": 2480, "verse_number": "११-१२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070496, "chapter_id": 2480, "verse_number": "११-१२-१", "content_sanskrit": "तत एनमुपातिष्ठञ्शौचार्थं परिचारकाः।\nकृतशौचं पुनश्चैनं ओवाच मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070497, "chapter_id": 2480, "verse_number": "११-१२-२", "content_sanskrit": "राजन्नधीता वेदास्ते शास्त्राणि विविधानि च।\nश्रुतानि च पुराणानि राजधर्माश्च केवलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070498, "chapter_id": 2480, "verse_number": "११-१२-३", "content_sanskrit": "एवं विद्वान्महाप्राज्ञः समर्थः सन्बलाबले।\nआत्मापराधात्कस्मात्त्वं कुरुषे कोपमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070499, "chapter_id": 2480, "verse_number": "११-१२-४", "content_sanskrit": "उक्तवांस्त्वां तदैवाहं भीष्मद्रोणौ च भारत।\nविदुरः सञ्जयश्चैव वाक्यं राजन्न तत्कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070500, "chapter_id": 2480, "verse_number": "११-१२-५", "content_sanskrit": "स वार्यमाणो नास्माकमकार्षीर्वचनं तदा।\nपाण्डवानधिकाञ्चानन्बले शौर्ये च कौरव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070501, "chapter_id": 2480, "verse_number": "११-१२-६", "content_sanskrit": "राजा हि यः स्थिरप्रज्ञः स्वयं दोषानवेक्षते।\nदेशकालविभागं च परं श्रयेः स विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070502, "chapter_id": 2480, "verse_number": "११-१२-७", "content_sanskrit": "उच्यमानस्तु यः श्रेयो गृह्णीते नो हिताहिते।\nआपदः समनुप्राप्य सोऽभ्येति विलयं किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070503, "chapter_id": 2480, "verse_number": "११-१२-८", "content_sanskrit": "ततोऽन्यवृत्तमात्मानं समवेक्षस्व भारत।\nराजंस्त्वं ह्यविधेयात्मा दुर्योधनवशे स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070504, "chapter_id": 2480, "verse_number": "११-१२-९", "content_sanskrit": "आत्मापराधादापन्नस्तत्किं भीमं जिघांससि।\nतस्मात्संयच्छ कोपं त्वं स्वमनुस्मृत्य दुष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070505, "chapter_id": 2480, "verse_number": "११-१२-१०", "content_sanskrit": "यस्तु तां स्पर्धया क्षुद्रः पाञ्चालीमानयत्समाम्।\nस हतो भीमसेनेन वैरं प्रतिजिहीर्षता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070506, "chapter_id": 2480, "verse_number": "११-१२-११", "content_sanskrit": "आत्मनोऽतिक्रमं पश्य पुंत्रस्य च दुरात्मनः।\nयदनागसि पाण्डूनां परित्यागस्त्वया कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070507, "chapter_id": 2480, "verse_number": "११-१२-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070508, "chapter_id": 2480, "verse_number": "११-१२-१२", "content_sanskrit": "एवमुक्तः स कृष्णेन सर्वं सत्यं जनाधिप।\nउवाच देवकीपुत्रं धृतराष्ट्रो महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070509, "chapter_id": 2480, "verse_number": "११-१२-१३", "content_sanskrit": "एवमेतन्महाबाहो यथा वदसि माधव।\nपुत्रस्नेहस्तु बलवान्धर्मान्मां समचालयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070510, "chapter_id": 2480, "verse_number": "११-१२-१४", "content_sanskrit": "दिष्ट्या तु पुरुषव्याघ्रो बलवान्सत्यक्त्रिमः।\nत्वद्गुप्तो नागमत्कृष्ण भीमो बाह्वन्तरं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070511, "chapter_id": 2480, "verse_number": "११-१२-१५", "content_sanskrit": "इदानीं त्वहमव्यग्रो गतमन्युर्गतज्वरः।\nमध्यमं पाण्डवं वीरं स्पष्टुमिच्छामि माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070512, "chapter_id": 2480, "verse_number": "११-१२-१६", "content_sanskrit": "हतेषु पारथिवेन्द्रेषु पुत्रेषु निहतेषु च।\nपाण्डुपुत्रेषु मे धर्मः प्रीतिश्चाप्यवतिष्ठते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070513, "chapter_id": 2480, "verse_number": "११-१२-१७", "content_sanskrit": "ततः स भीमं च धनञ्जयं च\nमाद्याश्च पुत्रौ पुरुषप्रवीरौ।\nपस्पर्श गात्रैः प्ररुदन्सुगात्रा--\nनाश्वास्य कल्याणमुवाच चैनान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070514, "chapter_id": 2480, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि द्वादशोऽध्यायः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]