[{"id": 2006542, "chapter_id": 1129, "verse_number": "१-१३०-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006543, "chapter_id": 1129, "verse_number": "१-१३०-१", "content_sanskrit": "धृतराष्ट्रस्य पुत्राणामादितः कथितं त्वया।\nऋषेः प्रसादात्तु शतं न च कन्या प्रकीर्तिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006544, "chapter_id": 1129, "verse_number": "१-१३०-२", "content_sanskrit": "वैश्यापुत्रो युयुत्सुश्च कन्या चैका शताधिका।\nगान्धारराजदुहिता शतपुत्रेति चानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006545, "chapter_id": 1129, "verse_number": "१-१३०-३", "content_sanskrit": "उक्ता महर्षिणा तेन व्यासेनामिततेजसा।\nकथं त्विदानीं भगवन्कन्यां त्वं तु ब्रवीषि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006546, "chapter_id": 1129, "verse_number": "१-१३०-४", "content_sanskrit": "यदि भागशतं पेशी कृता तेन महर्षिणा।\nन प्रजास्यति चेद्भूयः सौबलेयी कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006547, "chapter_id": 1129, "verse_number": "१-१३०-५", "content_sanskrit": "कथं तु संभवस्तस्या दुःशलाया वदस्व मे।\nयथावदिह विप्रर्षे परं मेऽत्र कुतूहलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006548, "chapter_id": 1129, "verse_number": "१-१३०-६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006549, "chapter_id": 1129, "verse_number": "१-१३०-६", "content_sanskrit": "साध्वयं प्रश्न उद्दिष्टः पाण्डवेय ब्रवीमि ते।\nतां मांसपेशीं भगवान्स्वयमेव महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006550, "chapter_id": 1129, "verse_number": "१-१३०-७", "content_sanskrit": "शीताभिरद्भिरासिच्य भागं भागमकल्पयत्।\nयो यथा कल्पितो भागस्तंत धात्र्या तथा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006551, "chapter_id": 1129, "verse_number": "१-१३०-८", "content_sanskrit": "घृतपूर्णेषु कुण्डेषु एकैकं प्राक्षिपत्तदा।\nएतस्मिन्नन्तरे साध्वी गान्धारी सुदृढव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006552, "chapter_id": 1129, "verse_number": "१-१३०-९", "content_sanskrit": "दुहितुः स्नेहसंयोगमनुध्याय वराङ्गना।\nनाब्रवीत्तमृषिं किंचिद्गौरवाच्च यशस्विनी।\nमनसा चिन्तयद्देवी एतत्पुत्रशतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006553, "chapter_id": 1129, "verse_number": "१-१३०-१०", "content_sanskrit": "भविष्यति न संदेहो न ब्रवीत्यन्यथा मुनिः।\nममेयं परमा तुष्टिर्दुहिता मे भवेद्यदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006554, "chapter_id": 1129, "verse_number": "१-१३०-११", "content_sanskrit": "एका शताधिका बाला भविष्यति कनीयसी।\nततो दौहित्रजाल्लोकादबाह्योऽसौ पतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006555, "chapter_id": 1129, "verse_number": "१-१३०-१२", "content_sanskrit": "अधिका किल नारीणां प्रीतिर्जामातृजा भवेत्।\nयदि नाम ममापि स्याद्दुहितैका शताधिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006556, "chapter_id": 1129, "verse_number": "१-१३०-१३", "content_sanskrit": "कृतकृत्या भवेयं वै पुत्रदौहित्रसंवृता।\nयदि सत्यं तपस्तप्तं दत्तं वाऽप्यथवा हुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006557, "chapter_id": 1129, "verse_number": "१-१३०-१४", "content_sanskrit": "गुरवस्तोषिता वापि तथाऽस्तु दुहिता मम।\nएतस्मिन्नेव काले तु कृष्णद्वैपायनः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006558, "chapter_id": 1129, "verse_number": "१-१३०-१५", "content_sanskrit": "व्यभजत्स तदा पेशीं भगवानृषिसत्तमः।\nगण्यमानेषु कुण्डेषु शते पूर्णे महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006559, "chapter_id": 1129, "verse_number": "१-१३०-१६", "content_sanskrit": "अभवच्चापरं खण्डं वामहस्ते तदा किल।\nगणयित्वा शतं पूर्णमंशानामाह सौबलीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006560, "chapter_id": 1129, "verse_number": "१-१३०-१७x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006561, "chapter_id": 1129, "verse_number": "१-१३०-१७", "content_sanskrit": "पूर्णं पुत्रशतं त्वेतन्न मिथ्या वागुदाहृता।\nदैवयोगाच्च भागैकः परिशिष्टः शतात्परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006562, "chapter_id": 1129, "verse_number": "१-१३०-१८", "content_sanskrit": "एषा ते सुभगा कन्या भविष्यति यतेप्सिता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006563, "chapter_id": 1129, "verse_number": "१-१३०-१८x", "content_sanskrit": "वैशम्पायन उवाच।\nततोऽन्यं घृतकुम्भं च समानाय्य महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006564, "chapter_id": 1129, "verse_number": "१-१३०-१९", "content_sanskrit": "तं चापि प्राक्षिपत्तत्र कन्याभागं तपोधनः।\nसंभूता चैव कालेन सर्वेषां च यवीयसी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006565, "chapter_id": 1129, "verse_number": "१-१३०-२०", "content_sanskrit": "ऐतत्ते कथितं राजन्दुःशलाजन्म भारत।\nब्रूहि राजेन्द्र किं भूयो वर्तयिष्यामि तेऽनघ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006566, "chapter_id": 1129, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि त्रिंशदधिकशततमोऽध्यायः॥ १३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]