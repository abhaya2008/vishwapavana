[{"id": 7000503000, "chapter_id": 20503, "verse_number": "३-५०-१", "content_sanskrit": "ऋषय ऊचुः ।\nभवता कथितं सर्वं यत्किंचित्पृष्टमेव च ।\nइदानीमपि पृच्छाम एकं वद महामते॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000503001, "chapter_id": 20503, "verse_number": "३-५०-२", "content_sanskrit": "एतेषां खलु तीर्थानां सेवनाद्यत्फलं लभेत् ।\nसर्वेषां किल कृत्वैकं कर्म केन च लभ्यते॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000503002, "chapter_id": 20503, "verse_number": "३-५०-३", "content_sanskrit": "एतन्नो ब्रूहि सर्वज्ञ कर्मैवं यदि वर्तते ।\nसूत उवाच ।\nकर्मयोगः किल प्रोक्तो वर्णानां द्विजपूर्वशः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000503003, "chapter_id": 20503, "verse_number": "३-५०-४", "content_sanskrit": "नानाविधो महाभागास्तत्र चैकं विशिष्यते ।\nहरिभक्तिः कृता येन मनसा वचसा गिरा॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000503004, "chapter_id": 20503, "verse_number": "३-५०-५", "content_sanskrit": "जितं तेन जितं तेन जितमेव न संशयः ।\nहरिरेव समाराध्यः सर्वदेवेश्वरेश्वरः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000503005, "chapter_id": 20503, "verse_number": "३-५०-६", "content_sanskrit": "हरिनाममहामंत्रैर्नश्येत्पापपिशाचकम् ।\nहरेः प्रदक्षिणं कृत्वा सकृदप्यमलाशयाः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000503006, "chapter_id": 20503, "verse_number": "३-५०-७", "content_sanskrit": "सर्वतीर्थसमाप्लावं लभंते यन्न संशयः ।\nप्रतिमां च हरेर्दृष्ट्वा सर्वतीर्थफलं लभेत्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000503007, "chapter_id": 20503, "verse_number": "३-५०-८", "content_sanskrit": "विष्णुनामपरं जप्त्वा सर्वमंत्रफलं लभेत् ।\nविष्णुप्रसादतुलसीमाघ्राय द्विजसत्तमाः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000503008, "chapter_id": 20503, "verse_number": "३-५०-९", "content_sanskrit": "प्रचंडं विकरालं तद्यमस्यास्यं न पश्यति ।\nसकृत्प्रणामी कृष्णस्य मातुः स्तन्यं पिबेन्नहि॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000503009, "chapter_id": 20503, "verse_number": "३-५०-१०", "content_sanskrit": "हरिपादे मनो येषां तेभ्यो नित्यं नमोनमः ।\nपुल्कसः श्वपचो वापि ये चान्ये म्लेच्छजातयः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000503010, "chapter_id": 20503, "verse_number": "३-५०-११", "content_sanskrit": "तेऽपि वंद्या महाभागा हरिपादैकसेवकाः ।\nकिं पुनर्ब्राह्मणाः पुण्या भक्ता राजर्षयस्तथा॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000503011, "chapter_id": 20503, "verse_number": "३-५०-१२", "content_sanskrit": "हरौ भक्तिं विधायैव गर्भवासं न पश्यति ।\nहरेरग्रे स्वनैरुच्चैर्नृत्यंस्तन्नामकृन्नरः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000503012, "chapter_id": 20503, "verse_number": "३-५०-१३", "content_sanskrit": "पुनाति भुवनं विप्रा गंगादि सलिलं यथा ।\nदर्शनात्स्पर्शनात्तस्य आलापादपि भक्तितः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000503013, "chapter_id": 20503, "verse_number": "३-५०-१४", "content_sanskrit": "ब्रह्महत्यादिभिः पापैर्मुच्यते नात्र संशयः ।\nहरेः प्रदक्षिणं कुर्वन्नुच्चैस्तन्नामकृन्नरः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000503014, "chapter_id": 20503, "verse_number": "३-५०-१५", "content_sanskrit": "करतालादिसंधानं सुस्वरं कलशब्दितम् ।\nब्रह्महत्यादिकं पापं तेनैव करतालितम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000503015, "chapter_id": 20503, "verse_number": "३-५०-१६", "content_sanskrit": "हरिभक्तिकथामुक्त्वा ख्यायिकां शृणुयाच्च यः ।\nतस्य संदर्शनादेव पूतो भवति मानवः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000503016, "chapter_id": 20503, "verse_number": "३-५०-१७", "content_sanskrit": "किं पुनस्तस्य पापानामाशंका मुनिपुंगवाः ।\nतीर्थानां च परं तीर्थं कृष्णनाम महर्षयः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000503017, "chapter_id": 20503, "verse_number": "३-५०-१८", "content_sanskrit": "तीर्थीकुर्वंति जगतीं गृहीतं कृष्णनाम यैः ।\nतस्मान्मुनिवराः पुण्यं नातः परतरं विदुः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000503018, "chapter_id": 20503, "verse_number": "३-५०-१९", "content_sanskrit": "विष्णुप्रसादनिर्माल्यं भुक्त्वा धृत्वा च मस्तके ।\nविष्णुरेव भवेन्मर्त्यो यमशोकविनाशनः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000503019, "chapter_id": 20503, "verse_number": "३-५०-२०", "content_sanskrit": "अर्चनीयो नमस्कार्यो हरिरेव न संशयः ।\nये महाविष्णुमव्यक्तं देवं वापि महेश्वरम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000503020, "chapter_id": 20503, "verse_number": "३-५०-२१", "content_sanskrit": "एकीभावेन पश्यंति न तेषां पुनरुद्भवः ।\nतस्मादनादिनिधनं विष्णुमात्मानमव्ययम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000503021, "chapter_id": 20503, "verse_number": "३-५०-२२", "content_sanskrit": "हरिं चैकं प्रपश्यध्वं पूजयध्वं तथैव हि ।\nये समानं प्रपश्यंति हरिं वै देवतांतरम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000503022, "chapter_id": 20503, "verse_number": "३-५०-२३", "content_sanskrit": "ते यांति नरकान्घोरांन्न तांस्तु गणयेद्धीरः ।\nमूर्खं वा पंडितं वापि ब्राह्मणं केशवप्रियम्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000503023, "chapter_id": 20503, "verse_number": "३-५०-२४", "content_sanskrit": "श्वपाकं वा मोचयति नारायणः स्वयं प्रभुः ।\nनारायणात्परो नास्ति पापराशि दवानलः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000503024, "chapter_id": 20503, "verse_number": "३-५०-२५", "content_sanskrit": "कृत्वापि पातकं घोरं कृष्णनाम्ना विमुच्यते ।\nस्वयं नारायणो देवः स्वनाम्नि जगतां गुरुः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000503025, "chapter_id": 20503, "verse_number": "३-५०-२६", "content_sanskrit": "आत्मनोऽभ्यधिकां शक्तिं स्थापयामास सुव्रताः ।\nअत्र ये विवदंते वै आयासलघुदर्शनात्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000503026, "chapter_id": 20503, "verse_number": "३-५०-२७", "content_sanskrit": "फलानां गौरवाच्चापि ते यांति नरकं बहु ।\nतस्माद्धरौ भक्तिमान्स्याद्धरिनामपरायणः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000503027, "chapter_id": 20503, "verse_number": "३-५०-२८", "content_sanskrit": "पूजकं पृष्ठतो रक्षेन्नामिनं वक्षसि प्रभुः ।\nहरिनाममहावज्रं पापपर्वतदारणे॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000503028, "chapter_id": 20503, "verse_number": "३-५०-२९", "content_sanskrit": "तस्य पादौ तु सफलौ तदर्थं गतिशालिनौ ।\nतावेव धन्यावाख्यातौ यौ तु पूजाकरौ करौ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000503029, "chapter_id": 20503, "verse_number": "३-५०-३०", "content_sanskrit": "उत्तमांगमुत्तमांगं तद्धरौ नम्रमेव यत् ।\nसा जिह्वा या हरिं स्तौति तन्मनस्तत्पदानुगम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000503030, "chapter_id": 20503, "verse_number": "३-५०-३१", "content_sanskrit": "तानि लोमानि चोच्यंते यानि तन्नाम्नि चोत्थितम् ।\nकुर्वंति तच्च नेत्रांबु यदच्युतप्रसंगतः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000503031, "chapter_id": 20503, "verse_number": "३-५०-३२", "content_sanskrit": "अहो लोका अतितरां दैवदोषेण वंचिताः ।\nनामोच्चारणमात्रेण मुक्तिदं न भजंति वै॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000503032, "chapter_id": 20503, "verse_number": "३-५०-३३", "content_sanskrit": "वंचितास्ते च कलुषाः स्त्रीणां संगप्रसंगतः ।\nप्रतिष्ठंति च लोमानि येषां नो कृष्णशब्दने॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000503033, "chapter_id": 20503, "verse_number": "३-५०-३४", "content_sanskrit": "ते मूर्खा ह्यकृतात्मानः पुत्रशोकादि विह्वलाः ।\nरुदंति बहुलालापैर्न कृष्णाक्षरकीर्तने॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000503034, "chapter_id": 20503, "verse_number": "३-५०-३५", "content_sanskrit": "जिह्वां लब्ध्वापि लोकेऽस्मिन्कृष्णनामजपेन्नहि ।\nलब्ध्वापि मुक्तिसोपानं हेलयैव च्यवंति ते॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000503035, "chapter_id": 20503, "verse_number": "३-५०-३६", "content_sanskrit": "तस्माद्यत्नेन वै विष्णुं कर्मयोगेन मानवः ।\nकर्मयोगार्च्चितो विष्णुः प्रसीदत्येव नान्यथा॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000503036, "chapter_id": 20503, "verse_number": "३-५०-३७", "content_sanskrit": "तीर्थादप्यधिकं तीर्थं विष्णोर्भजनमुच्यते ।\nसर्वेषां खलु तीर्थानां स्नानपानावगाहनैः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000503037, "chapter_id": 20503, "verse_number": "३-५०-३८", "content_sanskrit": "यत्फलं लभते मर्त्यस्तत्फलं कृष्णसेवनात् ।\nयजंते कर्मयोगेन धन्या एव नरा हरिम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000503038, "chapter_id": 20503, "verse_number": "३-५०-३९", "content_sanskrit": "तस्माद्भजध्वं मुनयः कृष्णं परममंगलम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]