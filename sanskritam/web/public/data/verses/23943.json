[{"id": 7003943000, "chapter_id": 23943, "verse_number": "३-१-६-१", "content_sanskrit": "ऋषय ऊचुः ।\nद्वैपायनविनेय त्वं सूत पौराणिकोत्तम ।\nदेवीपत्तनपर्यंतं चक्रतीर्थमनुत्तमम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003943001, "chapter_id": 23943, "verse_number": "३-१-६-२", "content_sanskrit": "इत्यब्रवीः पुरास्माकमतः पृच्छाम किंचन ।\nदेवीपुरं हि तत्कुत्र यदन्तं चक्रतीर्थकम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003943002, "chapter_id": 23943, "verse_number": "३-१-६-३", "content_sanskrit": "देवीपत्तन मित्याख्या कथं तस्याभवत्तथा ।\nश्रीरामसेतुमूले च स्नातानां पापिनामपिः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003943003, "chapter_id": 23943, "verse_number": "३-१-६-४", "content_sanskrit": "कीदृशं वा भवेत्पुण्यं चक्रतीर्थे तथैव च ।\nएतच्चान्यान्विशे षांश्च ब्रूहि पौराणिकोत्तम॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003943004, "chapter_id": 23943, "verse_number": "३-१-६-५", "content_sanskrit": "श्रीसूत उवाच ।\nसर्वमेतत्प्रवक्ष्यामि शृणुध्वं मुनिपुंगवाः ।\nपठतां शृण्वतां चैतदाख्यानं पापनाश नम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003943005, "chapter_id": 23943, "verse_number": "३-१-६-६", "content_sanskrit": "यत्र पाषाणनवकं स्थापयित्वा रघूद्वहः ।\nबबन्ध प्रथमं सेतुं समुद्रे मैथिलीपतिः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003943006, "chapter_id": 23943, "verse_number": "३-१-६-७", "content_sanskrit": "देवीपुरं तु तत्रैव यदन्तं चक्रतीर्थकम् ।\nदेवीपत्तनमित्याख्या यथा तस्य समागता॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003943007, "chapter_id": 23943, "verse_number": "३-१-६-८", "content_sanskrit": "तद्ब्रवीमि मुनिश्रेष्ठाः शृणुध्वं श्रद्धया सह ।\nपुरा देवासुरे युद्धे देवैर्नाशितपुत्रिणी ।\nदितिः प्रोवाच तनयामात्मनः शोकमोहिता॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003943008, "chapter_id": 23943, "verse_number": "३-१-६-९", "content_sanskrit": "दितिरुवाच ।\nयाहि पुत्रि तपः कर्तुं तपोवनमनुत्तमम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003943009, "chapter_id": 23943, "verse_number": "३-१-६-१०", "content_sanskrit": "पुत्रार्थं तव सुश्रोणि नियता नियतेन्द्रिया ।\nइन्द्रादयो न शिष्येरन्येन पुत्रेण वै सुराः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003943010, "chapter_id": 23943, "verse_number": "३-१-६-११", "content_sanskrit": "उदिता तनया चैवं जनन्या तां प्रणम्य सा ।\nस्वीकृत्य माहिषं रूपं वनं पञ्चाग्निमध्यगा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003943011, "chapter_id": 23943, "verse_number": "३-१-६-१२", "content_sanskrit": "तपोऽतप्यत सा घोरं तेन लोकाश्चकंपिरे ।\nतस्यां तपः प्रकुर्वंत्यां त्रिलोक्यासीद्भयातुरा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003943012, "chapter_id": 23943, "verse_number": "३-१-६-१३", "content_sanskrit": "इन्द्रादयः सुर गणा मोहमापुर्द्विजोत्तमाः ।\nसुपार्श्वस्तपसा तस्या मुनिः क्षुब्धोऽवदत्तु ताम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003943013, "chapter_id": 23943, "verse_number": "३-१-६-१४", "content_sanskrit": "सुपार्श्व उवाच ।\nपरितुष्टोऽस्मि सुश्रोणि पुत्रस्तव भविष्यति ।\nमुखेन महिषाकारो वपुषा नररूपवान्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003943014, "chapter_id": 23943, "verse_number": "३-१-६-१५", "content_sanskrit": "महिषो नामपुत्रस्ते भविष्यत्यतिवीर्यवान् ।\nपीडयिष्यति यः स्वर्गं देवेन्द्रं च ससैनिकम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003943015, "chapter_id": 23943, "verse_number": "३-१-६-१६", "content_sanskrit": "सुपार्श्वस्त्वेवमुक्त्वा तां विनिवार्य तपस्तथा ।\nआगच्छदात्मनो लोकमनुनीय तपस्विनीम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003943016, "chapter_id": 23943, "verse_number": "३-१-६-१७", "content_sanskrit": "अथ जज्ञे स महिषो यथोक्तं ब्रह्मणा पुरा ।\nव्यवर्द्धत महावीर्यः पर्वणीव महोदधिः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003943017, "chapter_id": 23943, "verse_number": "३-१-६-१८", "content_sanskrit": "ततः पुत्रो विप्रचित्तेर्विद्युन्माल्यसुराग्रणीः ।\nअन्येऽप्यसुरवर्यास्ते संति ये भूतले द्विजाः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003943018, "chapter_id": 23943, "verse_number": "३-१-६-१९", "content_sanskrit": "ते सर्वे महिषस्यास्य श्रुत्वा दत्तवरं मुदा ।\nसमागम्य मुनिश्रेष्ठाः प्रावदन्महिषासुरम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003943019, "chapter_id": 23943, "verse_number": "३-१-६-२०", "content_sanskrit": "स्वर्गाधिपत्यमस्माकं पूर्व मसीन्महामते ।\nदेवैर्विष्णुं समाश्रित्य राज्यं नो हृतमोजसा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003943020, "chapter_id": 23943, "verse_number": "३-१-६-२१", "content_sanskrit": "तद्राज्यमानय वलादस्माकं महिषासुर ।\nवीर्यं प्रकटयस्वाद्य प्रभावमपि चात्मनः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003943021, "chapter_id": 23943, "verse_number": "३-१-६-२२", "content_sanskrit": "अतुल्यबलवीर्यस्त्वं ब्रह्मदत्तवरोद्धतः ।\nपुलोमजापतिं युद्धे जहि देवगणैः सह॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003943022, "chapter_id": 23943, "verse_number": "३-१-६-२३", "content_sanskrit": "दनुजैरेवमुक्तोऽसौ योद्धुकामोऽमरैः सह ।\nमहा वीर्योऽथ महिषः प्रययावमरावतीम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003943023, "chapter_id": 23943, "verse_number": "३-१-६-२४", "content_sanskrit": "देवानामसुराणां च संवत्सरशतं रणम् ।\nपुरा बभूव विप्रेंद्रास्तुमुलं रोमहर्षणम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003943024, "chapter_id": 23943, "verse_number": "३-१-६-२५", "content_sanskrit": "देववृन्दं ततो भी त्या पुरस्कृत्य पुरन्दरम् ।\nकांदिशीकमभूद्विप्रा ब्रह्माणं च ययौ तदा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003943025, "chapter_id": 23943, "verse_number": "३-१-६-२६", "content_sanskrit": "ब्रह्मा तानमरासर्वान्समादाय ययौ पुनः ।\nनारायणशिवौ यत्र वर्तेते विश्वपालकौ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003943026, "chapter_id": 23943, "verse_number": "३-१-६-२७", "content_sanskrit": "तत्र गत्वा नमस्कृत्य स्तुत्वा स्तोत्रैरनेकशः ।\nब्रह्मा निवेदयामास महिषासुरचेष्टितम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003943027, "chapter_id": 23943, "verse_number": "३-१-६-२८", "content_sanskrit": "सुराणामसुरैः पीडां देवयोः शंभुकृष्णयोः ।\nइंद्राग्नियमसूर्येंदुकुबेरवरुणादिकान्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003943028, "chapter_id": 23943, "verse_number": "३-१-६-२९", "content_sanskrit": "निराकृत्याधिकारेषु तेषां तिष्ठत्ययं स्वयम् ।\nअन्येषां देववृंदानामधिकारेपि तिष्ठति॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003943029, "chapter_id": 23943, "verse_number": "३-१-६-३०", "content_sanskrit": "निरस्तं देववृंदं तत्स्वर्लोकादवनीतले ।\nमनुष्यवद्विचरते महिषासुरबाधितम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003943030, "chapter_id": 23943, "verse_number": "३-१-६-३१", "content_sanskrit": "एतज्ज्ञापयितुं देवौ युवयोरहमागतः ।\nसार्द्धं देव गणैरत्र रक्षतं तान्समागतान्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003943031, "chapter_id": 23943, "verse_number": "३-१-६-३२", "content_sanskrit": "ब्रह्मणो वचनं श्रुत्वा रमेश्वरमहेश्वरौ ।\nकोपात्करालवदनौ दुष्प्रेक्ष्यौ तौ बभूवतुः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003943032, "chapter_id": 23943, "verse_number": "३-१-६-३३", "content_sanskrit": "अत्यन्तकोपज्वलितान्मुखाद्विष्णोरथ द्विजाः ।\nनिश्चक्राम महत्तेजः शंभोः स्रष्टुस्तथैव च॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003943033, "chapter_id": 23943, "verse_number": "३-१-६-३४", "content_sanskrit": "अपरेषां सुराणां च देहादिंद्रशरीरतः ।\nतेजः समुदभूत्क्रूरं तदेकं समजायत॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003943034, "chapter_id": 23943, "verse_number": "३-१-६-३५", "content_sanskrit": "तेषां तु तेजसां राशिर्ज्वलत्पर्वतसंनिभः ।\nददृशे देववृंदैस्तैर्ज्वालाव्याप्तदिगंतरः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003943035, "chapter_id": 23943, "verse_number": "३-१-६-३६", "content_sanskrit": "तेजसां समुदायोऽसौ नारी काचि दभूत्तदा ।\nशिवतेजो मुखमभूद्विष्णुतेजो भुजौ द्विजाः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003943036, "chapter_id": 23943, "verse_number": "३-१-६-३७", "content_sanskrit": "ब्रह्मतेजस्तु चरणौ मध्यमैंद्रेण तेजसा ।\nयमस्य तेजसा केशाः कुचौ चंद्रस्य तेजसा॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003943037, "chapter_id": 23943, "verse_number": "३-१-६-३८", "content_sanskrit": "जंघोरू कल्पितौ विप्रा वरुणस्य तु तेजसा ।\nनितंबः पृथिवीतेजः पादांगुल्योऽर्कतेजसा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003943038, "chapter_id": 23943, "verse_number": "३-१-६-३९", "content_sanskrit": "करांगुल्यो वसूनां च तेजसा कल्पितास्तथा ।\nकुबेरतेजसा विप्रा नासिकापरिकल्पिता॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003943039, "chapter_id": 23943, "verse_number": "३-१-६-४०", "content_sanskrit": "नवप्रजापतीनां च तेजसा दंतपंक्तयः ।\nचक्षुर्द्वयं समजनि हव्यवाहनतेजसा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003943040, "chapter_id": 23943, "verse_number": "३-१-६-४१", "content_sanskrit": "उभे संध्ये भ्रुवौ जाते श्रवणे वायुतेजसा ।\nइतरेषां च देवानां तेजोभिरतिदारुणैः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003943041, "chapter_id": 23943, "verse_number": "३-१-६-४२", "content_sanskrit": "कृतान्यावयवा नारी दुर्गा परमभास्वरा ।\nबभूव दुर्धर्षतरा सर्वैरपि सुरासुरैः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003943042, "chapter_id": 23943, "verse_number": "३-१-६-४३", "content_sanskrit": "सर्ववृंदारकानीकतेजःसंघसमुद्भवा ।\nतां दृष्ट्वा प्रीतिमापुस्ते देवा महिषबाधिताः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003943043, "chapter_id": 23943, "verse_number": "३-१-६-४४", "content_sanskrit": "ततो रुद्रा दयो देवा विनिष्कृष्यायुधान्निजात् ।\nआयुधानि ददुस्तस्यै शूलादीनि द्विजोत्तमाः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003943044, "chapter_id": 23943, "verse_number": "३-१-६-४५", "content_sanskrit": "भूषणानि ददुस्तस्यै वस्त्रमाल्यानि चंदनम् ।\nसापि देवी तदा वस्त्रैर्भूषणैश्चंदनादिभिः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003943045, "chapter_id": 23943, "verse_number": "३-१-६-४६", "content_sanskrit": "कुसुमैरायुधैर्हारैर्भूषिता परिचारकैः ।\nसाट्टहासं प्रमुंचंती भैरवी भैरवस्वना॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003943046, "chapter_id": 23943, "verse_number": "३-१-६-४७", "content_sanskrit": "ननाद कंपयतीव रोदसी देवसेविता ।\nदेव्या भैरवनादेन चचाल सकलं जगत्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003943047, "chapter_id": 23943, "verse_number": "३-१-६-४८", "content_sanskrit": "सिंहवाहनमारूढां देवीं ताममरास्तदा ।\nमुनयः सिद्धगंधर्वास्तुष्टुवुर्जयश ब्दतः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003943048, "chapter_id": 23943, "verse_number": "३-१-६-४९", "content_sanskrit": "अतिभीषणनादेन देव्याः क्षुब्धं जगत्त्रयम् ।\nदृष्ट्वा देवारयो दैत्याः समुत्तस्थुरुदायुधाः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003943049, "chapter_id": 23943, "verse_number": "३-१-६-५०", "content_sanskrit": "महिषोऽपि महाक्रोधात्समुद्यत महायुधः ।\nतं शब्दमवलक्ष्याथ ययावसुरसंवृतः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003943050, "chapter_id": 23943, "verse_number": "३-१-६-५१", "content_sanskrit": "व्यलोकयत्ततो देवीं तेजोव्याप्तजगत्त्रयीम् ।\nसायुधानंतबाह्वाढयां नादकंपितभूतलाम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003943051, "chapter_id": 23943, "verse_number": "३-१-६-५२", "content_sanskrit": "क्षोभिताशेषशेषादिमहानागपरंपराम् ।\nविलोक्य देवीमसुराः समनह्यन्नुदायुधाः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003943052, "chapter_id": 23943, "verse_number": "३-१-६-५३", "content_sanskrit": "ततो देव्या तया सार्द्धमसुराणामभूद्रणः ।\nअस्त्रैः शस्त्रैः शरैश्चक्रैर्गदाभिर्मुसलैरपि॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003943053, "chapter_id": 23943, "verse_number": "३-१-६-५४", "content_sanskrit": "गजाश्वरथपादातैरसंख्येयैर्महावलः ।\nमहिषो युयुधे तत्र देव्या साकमरिंदमः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003943054, "chapter_id": 23943, "verse_number": "३-१-६-५५", "content_sanskrit": "लक्षको टिसहस्राणि प्रधानासुरयूथपाः ।\nएकैकस्य तु सेनायास्तेषां संख्या न विद्यते॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003943055, "chapter_id": 23943, "verse_number": "३-१-६-५६", "content_sanskrit": "ते सर्वे युगपद्देवीं शस्त्रैरावव्रुरोजसा ।\nसापि देवी ततो भीमा दैत्यमुक्तास्त्रसंचयम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003943056, "chapter_id": 23943, "verse_number": "३-१-६-५७", "content_sanskrit": "बिभेद लीलया बाणैः स्वकार्मुकविनिःसृतैः ।\nससर्ज दैत्यकायेषु बाणपूगान्यनेकशः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003943057, "chapter_id": 23943, "verse_number": "३-१-६-५८", "content_sanskrit": "देव्याश्रयबला द्देवा निर्भया दैत्ययूथपैः ।\nयुयुधुः संयुगे शस्त्रैरस्त्रैरप्यायुधांतरैः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003943058, "chapter_id": 23943, "verse_number": "३-१-६-५९", "content_sanskrit": "ततो देवा बलोत्सिक्ता देवीशक्त्युपबृंहिताः ।\nनिःशेषमसुरान्सर्वानायु धैर्निरमूलयन्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003943059, "chapter_id": 23943, "verse_number": "३-१-६-६०", "content_sanskrit": "स्वसैन्ये तु क्षयं याते संक्षुब्धो महिषासुरः ।\nचापमादाय वेगेन विकृष्य च महास्वनम्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003943060, "chapter_id": 23943, "verse_number": "३-१-६-६१", "content_sanskrit": "संधाय मुमुचे बाणान्देव सैन्येषु भूसुराः ।\nइंद्रे तु दशसाहस्रं यमे पंचसहस्रकम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003943061, "chapter_id": 23943, "verse_number": "३-१-६-६२", "content_sanskrit": "वरुणे चाष्टसाहस्रं कुबेरे षट्सहस्रकम् ।\nसूर्ये चंद्रे च वह्नौ च वायौ वसुषु चाश्विनोः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003943062, "chapter_id": 23943, "verse_number": "३-१-६-६३", "content_sanskrit": "अन्येष्वपि च देवेषु महिषो दानवेश्वरः ।\nप्रत्येकमयुतं बाणान्मुमुचे बलिनां वरः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003943063, "chapter_id": 23943, "verse_number": "३-१-६-६४", "content_sanskrit": "पलायंते ततो देवा महिषासुरमर्द्दिताः ।\nदेवीं शरणमाजग्मुस्त्राहित्राहीतिवादिनः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003943064, "chapter_id": 23943, "verse_number": "३-१-६-६५", "content_sanskrit": "ततो देवी गणान्स्वस्य भूतवेतालकादिकान् ।\nयूयं नाशयत क्षिप्रमासुरं बलमित्यशात्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003943065, "chapter_id": 23943, "verse_number": "३-१-६-६६", "content_sanskrit": "अहं तु महिषं युद्धे योधयामि वलोद्धतम् ।\nततो देव्या गणैः सर्वमासुरं क्षतमाशु वै॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003943066, "chapter_id": 23943, "verse_number": "३-१-६-६७", "content_sanskrit": "ततः सैन्यं क्षयं नीते गणै र्देवीप्रचोदितैः ।\nयोद्धुकामः स महिषो गणैः साकं व्यतिष्ठत॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003943067, "chapter_id": 23943, "verse_number": "३-१-६-६८", "content_sanskrit": "अत्रांतरे महानादः सुचक्षुश्च महाहनुः ।\nमहाचंडो महाभक्षो महोदरम होत्कटौ॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003943068, "chapter_id": 23943, "verse_number": "३-१-६-६९", "content_sanskrit": "पञ्चास्यः पादचूडश्च बहुनेत्रः प्रबाहुकः ।\nएकाक्षस्त्वेकपादश्च बहुपादोऽप्यपादकः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003943069, "chapter_id": 23943, "verse_number": "३-१-६-७०", "content_sanskrit": "एते चान्ये च बहवो महिषासुर मंत्रिणः ।\nयोद्धुकामा रणे देव्याः पुरतस्त्ववतस्थिरे॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003943070, "chapter_id": 23943, "verse_number": "३-१-६-७१", "content_sanskrit": "सिंहं वाहनमारुह्य ततो देवी मनोजवम् ।\nप्रलयांबुदनिर्घोषं चापमादाय भैरवम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003943071, "chapter_id": 23943, "verse_number": "३-१-६-७२", "content_sanskrit": "विस्फोट्य मुमुचे बाणान्वज्रवेगसमान्युधि ।\nदशलक्षगजैश्चापि शतलक्षैश्च वाजिभिः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003943072, "chapter_id": 23943, "verse_number": "३-१-६-७३", "content_sanskrit": "शतलक्षै रथैश्चापि लक्षायुतपदातिभिः ।\nयुक्तो महाहनुर्दैत्यो देव्या युधि निपातितः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003943073, "chapter_id": 23943, "verse_number": "३-१-६-७४", "content_sanskrit": "सैन्ये च तस्य निहता देव्या बाणैर्द्विजोत्तमाः ।\nलक्षकोटिसहस्राणि प्रधानासुरनायकाः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003943074, "chapter_id": 23943, "verse_number": "३-१-६-७५", "content_sanskrit": "महिषस्य हि विद्यन्ते महाबलपराक्रमाः ।\nएकैकस्य प्रधानस्य चतुरङ्गबलं तथा॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003943075, "chapter_id": 23943, "verse_number": "३-१-६-७६", "content_sanskrit": "महाहनोर्यथा विप्रास्तथैवास्ति महद्बलम् ।\nतत्सर्वं निहतं देव्या शरैः कांचनपुंखितैः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003943076, "chapter_id": 23943, "verse_number": "३-१-६-७७", "content_sanskrit": "याममात्रेण विप्रेंद्रास्तदद्भुतमिवाभवत्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]