[{"id": 7003187000, "chapter_id": 23187, "verse_number": "४-१२३-१", "content_sanskrit": "अथ त्रयोविंशत्यधिकशततमोऽध्यायः ।\nनारद उवाच ।\nगणेशपूजनाख्यानं पुराणेषु च दुर्लभम् ।\nश्रुतं तद्ब्रह्मणो वक्त्रात्सामान्यं च समासतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003187001, "chapter_id": 23187, "verse_number": "४-१२३-२", "content_sanskrit": "महिमानं गणपतेः सर्वबूज्येश्वरस्य च ।\nव्यासेन श्रोतुमिच्छामि योगीन्द्राणां गुरोर्गुरोः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003187002, "chapter_id": 23187, "verse_number": "४-१२३-३", "content_sanskrit": "सिद्धाश्रमे महापूज त्रैलोक्यस्थैः कृता पुरा ।\nराधामाधवयोस्तत्र पुनः संमीलरं पुरा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003187003, "chapter_id": 23187, "verse_number": "४-१२३-४", "content_sanskrit": "अतीते वर्षशतके श्रीदाम्नः शापमोक्षणे ।\nआदौ चकार पूजां च सा च राधा कथं मुने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003187004, "chapter_id": 23187, "verse_number": "४-१२३-५", "content_sanskrit": "स्थितेषु च सुरेन्द्रेषु ब्रह्मविष्णुशिवादिषु ।\nनागेन्द्रे च स्थिते शेषे नागेषु च महत्सु च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003187005, "chapter_id": 23187, "verse_number": "४-१२३-६", "content_sanskrit": "राजेन्द्रेषु च भूमौ च बलिष्ठेष्वसुरेषु च ।\nगन्धर्वेषु च रक्षःसु चान्येषु बलवत्सु च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003187006, "chapter_id": 23187, "verse_number": "४-१२३-७", "content_sanskrit": "विस्तरेण महाभाग तन्मे व्याख्यातुमर्हसि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003187007, "chapter_id": 23187, "verse_number": "४-१२३-८", "content_sanskrit": "नारायण उवाच ।\nत्रेलोक्ये पृथिवी धन्या मान्या पुण्यवती सती ।\nतत्र भारतवर्षं च कर्मणां फलदं शुभम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003187008, "chapter_id": 23187, "verse_number": "४-१२३-९", "content_sanskrit": "धन्यं यशस्यं पूज्यं च पुण्यक्षेत्रे च भारते ।\nसिद्धाश्रमं महापुण्यक्षेत्रं मोक्षप्रदं शुभम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003187009, "chapter_id": 23187, "verse_number": "४-१२३-१०", "content_sanskrit": "सनत्कुमारो भगवांस्तत्र सिद्धो बभूव ह ।\nस्वयं विधाता तत्रैव तप्त्वा सिद्धो बभूव ह ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003187010, "chapter_id": 23187, "verse_number": "४-१२३-११", "content_sanskrit": "योगीन्द्राश्च मुनीन्द्राश्च सिद्धेन्द्राः कपिलादयः ।\nशतक्रन्तून्महेन्द्रश्च तत्र कृत्वा बभूव ह ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003187011, "chapter_id": 23187, "verse_number": "४-१२३-१२", "content_sanskrit": "तेन सिद्धाश्रमं नाम सर्वेषामपि दुर्लभम् ।\nअधिष्ठानं गणेशस्य तत्रेव सततं मुने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003187012, "chapter_id": 23187, "verse_number": "४-१२३-१३", "content_sanskrit": "अमूल्यरत्ननिर्माणगणेशप्रतिमां शुभाम् ।\nवैशाख्यां पूर्णिमायां च पूजां कुर्वन्ति देवताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003187013, "chapter_id": 23187, "verse_number": "४-१२३-१४", "content_sanskrit": "नागाश्च मानवाश्चैव दैत्या गन्धर्वराक्षसाः ।\nसिद्धेन्द्राश्च मुनीन्द्राश्च योगीन्द्राः सनकादयाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003187014, "chapter_id": 23187, "verse_number": "४-१२३-१५", "content_sanskrit": "तत्राऽऽजगाम शंभुश्च पार्वत्वा सह शंकरः ।\nसगणः कार्तिकेयश्च स्वयं ब्रह्मा प्रजापतिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003187015, "chapter_id": 23187, "verse_number": "४-१२३-१६", "content_sanskrit": "तत्राऽऽजगाम शेषश्च नागेन्द्रैः सह सत्वरम् ।\nतज्ञाऽऽजग्मुः सुराः सर्वे मनवो मृनयस्तथा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003187016, "chapter_id": 23187, "verse_number": "४-१२३-१७", "content_sanskrit": "आजग्मुस्ते नृपाः सर्वे पूजार्थं हृष्टमानसाः ।\nआययौ भगवान्कृष्णो द्वारकावासिभिः सह ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003187017, "chapter_id": 23187, "verse_number": "४-१२३-१८", "content_sanskrit": "आजगाम तथा नन्दः सार्धं गोकुलवासिभिः ।\nगोपीत्रिशतकोटीभिर्गोलोकवासिभिः सह ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003187018, "chapter_id": 23187, "verse_number": "४-१२३-१९", "content_sanskrit": "गचेन्द्रकोटितुल्याभिर्बलिष्ठाभिः सहाऽऽलिभिः ।\nआययौ सुन्दरी राधा कृष्णप्राणाधिदेवता ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003187019, "chapter_id": 23187, "verse_number": "४-१२३-२०", "content_sanskrit": "रासेश्वरी सुरसिका शतवर्षे गते सति ।\nसुस्नाता मुदती शुद्धा धृत्वा धौते च वाससी ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003187020, "chapter_id": 23187, "verse_number": "४-१२३-२१", "content_sanskrit": "संयता सा निराहारा गत्वा च मणिमण्डपम् ।\nसुप्रक्षालितपादाब्जा कान्ता भुवनपावनी ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003187021, "chapter_id": 23187, "verse_number": "४-१२३-२२", "content_sanskrit": "श्रीकृष्णप्रीतिकामाऽथ सुसंकल्पं विधाय च ।\nगङ्गोदकेन हेरम्बं स्नापयामास भक्तितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003187022, "chapter_id": 23187, "verse_number": "४-१२३-२३", "content_sanskrit": "ध्यार्न च सामवेदोक्तं चकार शुक्लपुष्पतः ।\nमाता चतुर्णां वेदानां वसोश्च जगतामपि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003187023, "chapter_id": 23187, "verse_number": "४-१२३-२४", "content_sanskrit": "बुद्धिरूपा भगवती ज्ञानिनां जननी परा ।\nध्यानात्मकं स्वपुस्रं तं परं ध्यानं चकार सा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003187024, "chapter_id": 23187, "verse_number": "४-१२३-२५", "content_sanskrit": "शर्वं लम्बोदरं स्थूलं ज्वलन्तं ब्रह्मतेजसा ।\nगजवक्त्रं वह्निवर्णमेकदन्तमनन्तकम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003187025, "chapter_id": 23187, "verse_number": "४-१२३-२६", "content_sanskrit": "सिद्धानां योगिनामेव ज्ञानिनां च गुरोर्गुरुम् ।\nध्यातं मुनीन्द्रैर्देवेन्द्रैर्ब्रह्मेशशेषसंज्ञकैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003187026, "chapter_id": 23187, "verse_number": "४-१२३-२७", "content_sanskrit": "सिद्धेन्द्रैर्मुनिभिः सद्भिर्भगवन्तं सनातनम् ।\nब्रह्मस्वरूपं परमं मङ्गलं मङ्गलालयम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003187027, "chapter_id": 23187, "verse_number": "४-१२३-२८", "content_sanskrit": "सर्वविघ्नहरं शान्तं दातारं सर्वसंपदाम् ।\nभवाब्धिमायापोतेन कर्णधारं च कर्मिणाम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003187028, "chapter_id": 23187, "verse_number": "४-१२३-२९", "content_sanskrit": "शरणागतदीनार्तपरित्राणपरायणम् ।\nध्यायेद्ध्यानात्मकं साध्यं भक्तेशं भक्तवत्सलम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003187029, "chapter_id": 23187, "verse_number": "४-१२३-३०", "content_sanskrit": "इति ध्यात्वा स्वशिरसि दत्त्वा पुष्पं पुनः सती ।\nसर्वाङ्गशोधनं न्यासं वेदोक्तं च चकार सा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003187030, "chapter_id": 23187, "verse_number": "४-१२३-३१", "content_sanskrit": "पुनश्च ध्यात्वा ध्यानेन तेनैव शुभदायिना ।\nददौ पुष्पं पादपद्मे राधा लम्बोदरस्य च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003187031, "chapter_id": 23187, "verse_number": "४-१२३-३२", "content_sanskrit": "सप्ततीर्थोदकेनैव शीतेन वासितेन च ।\nददौ पाद्यं पादपद्मे तैः पद्मादिभिरर्चिते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003187032, "chapter_id": 23187, "verse_number": "४-१२३-३३", "content_sanskrit": "दूर्वाक्षतैः शुक्लपुष्पैः सुगन्धिचन्दनोदकैः ।\nअर्घ्यं ददौ तच्छिरसि स्वयं गोलोकवासिनी ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003187033, "chapter_id": 23187, "verse_number": "४-१२३-३४", "content_sanskrit": "सचन्दनं स्ग्धिमाल्यं पारिजातस्य सुन्दरम् ।\nददौ गले गणेशस्य स्वयं रासंश्वरी मुदा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003187034, "chapter_id": 23187, "verse_number": "४-१२३-३५", "content_sanskrit": "कस्तूरीकुङ्कुमाक्तं च सुगन्धि स्निग्धचन्दनम् ।\nसर्वाङ्गे प्रददौ तस्य वृन्दावनविनोदिनी ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003187035, "chapter_id": 23187, "verse_number": "४-१२३-३६", "content_sanskrit": "सुगन्धि शुक्लं पुष्पं च सुगन्ध चन्दनार्चितम् ।\nददौ तस्य पदाम्भोजे महापद्मलया सती ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003187036, "chapter_id": 23187, "verse_number": "४-१२३-३७", "content_sanskrit": "सुगन्धियुक्तं धूपं च पूतैर्वस्तुभिरन्वितम् ।\nददौ कृष्णप्रिया तस्मै जगतामीश्वराय च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003187037, "chapter_id": 23187, "verse_number": "४-१२३-३८", "content_sanskrit": "दीपं घृतप्रदीप्तं च ध्वान्तविध्वंसकारणम् ।\nददौ तस्मै सुरेशाय परमाद्या सनातनी ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003187038, "chapter_id": 23187, "verse_number": "४-१२३-३९", "content_sanskrit": "नैवेद्य विविधं रम्यं सुस्वादु सुमनोहरम् ।\nचोष्यं चर्व्यं लेह्यपेये सुधातुल्यं चतुर्विधम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003187039, "chapter_id": 23187, "verse_number": "४-१२३-४०", "content_sanskrit": "फलानि च सुपक्वानि त्रैलोक्ये दुर्लभानि च ।\nमधुराणि च मूलानि ग्राम्यारण्यानि नारद ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003187040, "chapter_id": 23187, "verse_number": "४-१२३-४१", "content_sanskrit": "तानि त्वन्यान्यसंख्यानि तिलानां लड्डुकानि च ।\nलड्डुकानि सुपक्वानि स्वादूनि सुरसानि च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003187041, "chapter_id": 23187, "verse_number": "४-१२३-४२", "content_sanskrit": "यवगोधूमचूर्णानां पक्वानि पिष्टकानि च ।\nघृताक्तानि च रम्याणि शर्करासहितानि च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003187042, "chapter_id": 23187, "verse_number": "४-१२३-४३", "content_sanskrit": "स्वास्तिकानां लड्डुकानि स्थूलानि सुन्दराणि च ।\nभृष्टद्रव्यं च विविधमक्षतं शर्करान्वितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003187043, "chapter_id": 23187, "verse_number": "४-१२३-४४", "content_sanskrit": "घृतकुल्यां दुग्धकुलयां मधुकुल्यं मनोहराम् ।\nगुडस्य दध्नः कुल्यां च पायसानां तथैव च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003187044, "chapter_id": 23187, "verse_number": "४-१२३-४५", "content_sanskrit": "पिष्टकानां स्वस्तिकानां रम्भाणां राशिरेव च ।\nमिष्टव्यञ्जनयुक्तानि शाल्यन्नानि शुभानि च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003187045, "chapter_id": 23187, "verse_number": "४-१२३-४६", "content_sanskrit": "ददौ तस्मै सुरेशाय कृष्णप्राणाधिदेवता ।\nअमूल्यरत्ननिर्माणं रम्यं सिंहासनं वरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003187046, "chapter_id": 23187, "verse_number": "४-१२३-४७", "content_sanskrit": "ददौ विघ्नपिनाशाय विराजतटवासिनी ।\nसूक्ष्मवस्त्रयुगं रम्यममूल्यं वह्निशुद्धकम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003187047, "chapter_id": 23187, "verse_number": "४-१२३-४८", "content_sanskrit": "ददौ शैलात्मजायैव शतशृङ्गनिवासिनी ।\nविशुद्धसर्पिषा युक्तं निर्मलं मधुरं मधु ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003187048, "chapter_id": 23187, "verse_number": "४-१२३-४९", "content_sanskrit": "मधुपर्कं ददौ तस्मै वृन्दावननिवासिनी ।\nताम्बूलं च वरं रम्यं कर्पूरादिसुवासितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003187049, "chapter_id": 23187, "verse_number": "४-१२३-५०", "content_sanskrit": "सर्वसंपत्प्रदात्रे च वृषभानसुता ददौ ।\nसप्ततीर्थोदकं शुद्धं सुसितं सुवासितम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003187050, "chapter_id": 23187, "verse_number": "४-१२३-५१", "content_sanskrit": "पानार्थ च जलं तस्मै ददौ गौपोश्वरी मुदा ।\nअमूल्यं दुर्लभं चैव विशुद्धं श्वेतचामरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003187051, "chapter_id": 23187, "verse_number": "४-१२३-५२", "content_sanskrit": "ददौ तस्मै परेशाय मूलप्रकृतिरीश्वरी ।\nअमूल्यरत्ननिर्माणं मुक्तामाणिक्यहीरकैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003187052, "chapter_id": 23187, "verse_number": "४-१२३-५३", "content_sanskrit": "परिष्कृतं सुतल्पं च पुष्पचन्दनचर्चितम् ।\nसितसूक्ष्माशुकेनैव परितश्च परिष्कृतम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003187053, "chapter_id": 23187, "verse_number": "४-१२३-५४", "content_sanskrit": "ददौ शिवात्मजायैव कृष्णवक्षःस्थलस्थिता ।\nदत्त्वा च कामधेनुं च सवत्सां वाञ्छितप्रदाम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003187054, "chapter_id": 23187, "verse_number": "४-१२३-५५", "content_sanskrit": "कृत्वाऽतीव परीहारं वृन्दा पुष्पाञ्जलिं ददौ ।\nदिव्येन मूल्मनुना सबीजेनोज्ज्वलेन च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003187055, "chapter_id": 23187, "verse_number": "४-१२३-५६", "content_sanskrit": "ददौ षोडशोपचारं कालिन्दीकुलवासिनी ।\nॐ गं गौं गणपतये विघ्नविनाशिने स्वाहा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003187056, "chapter_id": 23187, "verse_number": "४-१२३-५७", "content_sanskrit": "इत्येवमेव मन्त्रं च गाणेशं षोडशाक्षरम् ।\nसा जजाप सहस्रं च परं सल्पतरुं वरम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003187057, "chapter_id": 23187, "verse_number": "४-१२३-५८", "content_sanskrit": "तुष्टाव परया भक्त्या भक्तिनम्रात्मकंधरा ।\nसाश्रुनेत्रा पुलकिता स्तोत्रेण कौथुमेन च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003187058, "chapter_id": 23187, "verse_number": "४-१२३-५९", "content_sanskrit": "राधिकोवाच ।\nपरं धाम परं ब्रह्म परेशं परमेश्वरम् ।\nविघ्ननिघ्नकरं शान्तं पुष्टं कान्तमनन्तकम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003187059, "chapter_id": 23187, "verse_number": "४-१२३-६०", "content_sanskrit": "सुरासुरेन्द्रैः सिद्धेन्द्रैः स्तुतं स्तौमि परात्परम् ।\nसुरपद्मदिनेशं च गणेशं मङ्गलायनम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003187060, "chapter_id": 23187, "verse_number": "४-१२३-६१", "content_sanskrit": "इदं स्तोत्रं महापुण्यं विघ्नशोकहरं परम् ।\nयः पठेत्प्रातरुत्थाय सर्वविघ्नात्प्रमुच्यते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]