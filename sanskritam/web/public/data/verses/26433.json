[{"id": 7006433000, "chapter_id": 26433, "verse_number": "२-९३-१", "content_sanskrit": "वैशम्पायन उवाच\nततः सुपुरवासीनामसुराणां नराधिप ।\nददावाज्ञां वज्रनाभो दीयतां गृहमुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006433001, "chapter_id": 26433, "verse_number": "२-९३-२", "content_sanskrit": "आतिथ्यं क्रियतामेषां बहुरत्नमुपायनम् ।\nवासांसि सुविचित्राणि सुखाय जनरञ्जनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006433002, "chapter_id": 26433, "verse_number": "२-९३-३", "content_sanskrit": "भर्तुराज्ञां समालभ्य तथा चक्रुश्च सर्वशः ।\nपूर्वश्रुतो नटः प्राप्तः कौतूहलमजीजनत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006433003, "chapter_id": 26433, "verse_number": "२-९३-४", "content_sanskrit": "नटस्याथ ददुर्दैत्याः सत्कारं परया मुदा ।\nपर्यायार्थे ददुश्चापि रत्नानि सुबहून्यथ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006433004, "chapter_id": 26433, "verse_number": "२-९३-५", "content_sanskrit": "ततः स ननृते तत्र वरदत्तो नटस्तथा ।\nसुपुरे पुरवासीनां परं हर्षं समादधत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006433005, "chapter_id": 26433, "verse_number": "२-९३-६", "content_sanskrit": "रामायणं महाकाव्यमुद्दिश्य नाटकं कृतम् ।\nजन्म विष्णोरमेयस्य राक्षसेन्द्रवधेप्सया ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006433006, "chapter_id": 26433, "verse_number": "२-९३-७", "content_sanskrit": "लोमपादो दशरथ ऋष्यशृङ्गं महामुनिम् ।\nशान्तामप्यानयामास गणिकाभिः सहानघ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006433007, "chapter_id": 26433, "verse_number": "२-९३-८", "content_sanskrit": "रामलक्ष्यणशत्रुघ्ना भरतश्चैव भारत ।\nऋष्यशृङ्गश्च शान्ता च तथारूपैर्नटैः कृताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006433008, "chapter_id": 26433, "verse_number": "२-९३-९", "content_sanskrit": "तत्कालजीविनो वृद्धा दानवा विस्मये गताः ।\nआचचक्षुश्च तेषां वै रूपतुल्यत्वमच्युत ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006433009, "chapter_id": 26433, "verse_number": "२-९३-१०", "content_sanskrit": "संस्फाराभिनयौ तेषां प्रस्तावानां च धारणम् ।\nदृष्ट्वा सर्वे प्रवेशं च दानवा विस्मयं गताः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006433010, "chapter_id": 26433, "verse_number": "२-९३-११", "content_sanskrit": "ते रक्ता विस्मयं नेदुरसुराः परया मुदा ।\nउत्थायोत्थाय नाट्यस्य विषयेषु पुनः पुनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006433011, "chapter_id": 26433, "verse_number": "२-९३-१२", "content_sanskrit": "ददुर्वस्त्राणि तुष्टाश्च ग्रैवेयवलयानि च ।\nहारान् मनोहरांश्चैव हेमवैडूर्यभूषितान् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006433012, "chapter_id": 26433, "verse_number": "२-९३-१३", "content_sanskrit": "पृथगर्थेषु दत्तेषु लोकैस्ते तुष्टुवुर्नटाः ।\nअसुरांश्च मुनींश्चैव गोत्रैरभिजनैरपि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006433013, "chapter_id": 26433, "verse_number": "२-९३-१४", "content_sanskrit": "प्रेषितं वज्रनाभस्य शाखानगरवासिभिः ।\nनटस्य दिव्यरूपस्य नरेन्द्रागमनं तदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006433014, "chapter_id": 26433, "verse_number": "२-९३-१५", "content_sanskrit": "पुरा श्रुतार्थो दैत्येन्द्रः प्रेषयामास भारत ।\nआनीयतां वज्रपुरं नटोऽसाविति हर्षितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006433015, "chapter_id": 26433, "verse_number": "२-९३-१६", "content_sanskrit": "दानवेन्द्रवचः श्रुत्वा शाखानगरवासिभिः ।\nनीता वज्रपुरं रम्यं नटवेषेण यादवाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006433016, "chapter_id": 26433, "verse_number": "२-९३-१७", "content_sanskrit": "आवासश्च ततो दत्तः सुकृतो विश्वकर्मणा ।\nएष्टव्यं यश्च तत् सर्वं दत्तं शतगुणोत्तरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006433017, "chapter_id": 26433, "verse_number": "२-९३-१८", "content_sanskrit": "अथ कालोत्सवं चक्रे वज्रनाभो महासुरः ।\nकारयामास रम्यं च चमूवाटं प्रहृष्टवान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006433018, "chapter_id": 26433, "verse_number": "२-९३-१९", "content_sanskrit": "ततस्तान् परिविश्रान्तान् प्रेक्षार्थाय प्रचोदयत् ।\nदत्त्वा रत्नानि भूरीणि वज्रनाभो महाबलः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006433019, "chapter_id": 26433, "verse_number": "२-९३-२०", "content_sanskrit": "उपविष्टश्च तान् द्रष्टुं सह ज्ञातिभिरात्मवान् ।\nछन्ने चान्तःपुरं स्थाप्य चक्षुर्दृश्ये नराधिप ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006433020, "chapter_id": 26433, "verse_number": "२-९३-२१", "content_sanskrit": "भैमापि बद्धनेपथ्या नटवेषधरास्तथा ।\nकार्यार्थे भीमकर्माणो नृत्यार्थमुपचक्रमुः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006433021, "chapter_id": 26433, "verse_number": "२-९३-२२", "content_sanskrit": "ततो घनं ससुषिरं मुरजानकभूषितम् ।\nतन्त्रीस्वरगणैर्विद्धानातोद्यानन्ववादयन् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006433022, "chapter_id": 26433, "verse_number": "२-९३-२३", "content_sanskrit": "ततस्तु देवगान्धारं छालिक्यं श्रवणामृतम् ।\nभैमस्त्रियः प्रजगिरे मनःश्रोत्रसुखावहम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006433023, "chapter_id": 26433, "verse_number": "२-९३-२४", "content_sanskrit": "आगान्धारग्रामरागं गङ्गावतरणं तथा ।\nविद्धमासारितं रम्यं जगिरे स्वरसम्पदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006433024, "chapter_id": 26433, "verse_number": "२-९३-२५", "content_sanskrit": "लयतालसमं श्रुत्वा गङ्गावतरणं शुभम् ।\nअसुरांस्तोषयामासुरुत्थायोत्थाय भारत ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006433025, "chapter_id": 26433, "verse_number": "२-९३-२६", "content_sanskrit": "नान्दिं च वादयामासुः प्रद्युम्नो गद एव च ।\nसाम्बश्च वीर्यसम्पन्नः कार्यार्थं नटतां गतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006433026, "chapter_id": 26433, "verse_number": "२-९३-२७", "content_sanskrit": "नान्द्यन्ते च तदा श्लोकं गङ्गावतरणाश्रितम् ।\nरौक्मिणेयस्तदोवाच सम्यक् स्वभिनयान्वितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006433027, "chapter_id": 26433, "verse_number": "२-९३-२८", "content_sanskrit": "रम्भाभिसारं कौबेरं नाटकं ननृतुस्ततः ।\nशूरो रावणरूपेण रम्भावेषा मनोवती ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006433028, "chapter_id": 26433, "verse_number": "२-९३-२९", "content_sanskrit": "नलकूबरस्तु प्रद्युम्नः साम्बस्तस्य विदूषकः ।\nकैलासो रूपितश्चापि मायया यदुनन्दनैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006433029, "chapter_id": 26433, "verse_number": "२-९३-३०", "content_sanskrit": "शापश्च दत्तः क्रुद्धेन रावणस्य दुरात्मनः ।\nनलकूबरेण च यथा रम्भा चाप्यथ सान्त्विता ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006433030, "chapter_id": 26433, "verse_number": "२-९३-३१", "content_sanskrit": "एतत् प्रकरणं वीरा ननृतुर्यदुनन्दनाः ।\nनारदस्य मुनेः कीर्तिं सर्वज्ञस्य महात्मनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006433031, "chapter_id": 26433, "verse_number": "२-९३-३२", "content_sanskrit": "पादोद्धारेण नृत्येन तथैवाभिनयेन च ।\nतुष्ढुवुर्दानवा वीरा भैमानामतितेजसाम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006433032, "chapter_id": 26433, "verse_number": "२-९३-३३", "content_sanskrit": "ते ददुर्वस्त्रमुख्यानि रत्नान्याभरणानि च ।\nहारांस्तरलविद्धांश्च वैडूर्यमणिभूषितान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006433033, "chapter_id": 26433, "verse_number": "२-९३-३४", "content_sanskrit": "विमानानि विचित्राणि रथांश्चाकाशगामिनः ।\nगजानाकाशगांश्चैव दिव्यनागकुलोद्भवान् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006433034, "chapter_id": 26433, "verse_number": "२-९३-३५", "content_sanskrit": "चन्दनानि च दिव्यानि शीतानि रसवन्ति च ।\nगुरूण्यगुरुमुख्यानि गन्धाढ्यानि च भारत ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006433035, "chapter_id": 26433, "verse_number": "२-९३-३६", "content_sanskrit": "चिन्तामणीनुदारांश्च चिन्तिते सर्वकामदान् ।\nप्रेक्षासु तासु बह्वीषु ददन्तो दानवास्तथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006433036, "chapter_id": 26433, "verse_number": "२-९३-३७", "content_sanskrit": "धनरत्नैर्विरहिताः कृताः पुरुषसत्तम ।\nस्त्रियो दानवमुख्यानां तथैव च जनेश्वर ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006433037, "chapter_id": 26433, "verse_number": "२-९३-३८", "content_sanskrit": "ततो हंसी प्रभावत्याः सखी प्राह प्रभावतीम् ।\nगतास्मि द्वारकां रम्यां भैमगुप्तामनिन्दिते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006433038, "chapter_id": 26433, "verse_number": "२-९३-३९", "content_sanskrit": "प्रद्युम्नश्च मया दृष्टो विविक्ते चारुलोचने ।\nभक्तिश्च कथिता तस्य मया तव शुचिस्मिते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006433039, "chapter_id": 26433, "verse_number": "२-९३-४०", "content_sanskrit": "तेन हृष्टेन कालश्च कृतः कमललोचने ।\nअद्य प्रदोषसमये त्वया सह समागमे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006433040, "chapter_id": 26433, "verse_number": "२-९३-४१", "content_sanskrit": "तदद्य रुचिरश्रोणि तव प्रियसमागमः ।\nन ह्यात्मवति भाषन्ति मिथ्या भैमकुलोद्भवाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006433041, "chapter_id": 26433, "verse_number": "२-९३-४२", "content_sanskrit": "ततः प्रभावती हृष्टा हंसीं तामिदमब्रवीत् ।\nउषितासि ममावासे स्वप्तुमर्हसि सुन्दरि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006433042, "chapter_id": 26433, "verse_number": "२-९३-४३", "content_sanskrit": "त्वयाहं सहिताऽऽवासे द्रष्टुमिच्छामि कैशविम् ।\nनिःसाध्वसा भविष्यामि त्वया सह विहङ्गमे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006433043, "chapter_id": 26433, "verse_number": "२-९३-४४", "content_sanskrit": "हंसी तथेति चोवाच सखीं कमललोचनाम् ।\nआरुरोह च तद्धर्म्यं प्रभावत्या विहङ्गमा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006433044, "chapter_id": 26433, "verse_number": "२-९३-४५", "content_sanskrit": "विश्वकर्मकृते तत्र हर्म्यपृष्ठे प्रभावती ।\nसंविधानं चकाराशु प्रद्युम्नागमनक्षमम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006433045, "chapter_id": 26433, "verse_number": "२-९३-४६", "content_sanskrit": "तस्मिन् कृते संविधाने काममानयितुं ययौ ।\nप्रभावतीमनुज्ञाप्य हंसी वायुसमा गतौ ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006433046, "chapter_id": 26433, "verse_number": "२-९३-४७", "content_sanskrit": "नटवेषधरं कामं गत्वोवाच शुचिस्मिता ।\nअद्य भूतः स भगवन् समयो वर्तते निशि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006433047, "chapter_id": 26433, "verse_number": "२-९३-४८", "content_sanskrit": "तथेति प्राह तां कामः सा निवृत्ताथ पक्षिणी ।\nअभ्यागता च सा हंसी प्रभावतिमथाब्रवीत् ।\nअभ्येति रौक्मिणेयोऽसावाश्वसायतलोचने ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006433048, "chapter_id": 26433, "verse_number": "२-९३-४९", "content_sanskrit": "प्रद्युम्नो नीयमानं तु ददृशे माल्यमात्मवान् ।\nभ्रमरैरावृतं वीरः सुगन्धमरिमर्दनः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006433049, "chapter_id": 26433, "verse_number": "२-९३-५०", "content_sanskrit": "निलिल्ये तत्र माल्ये तु भूत्वा मधुकरस्तदा ।\nप्रभावत्या नीयमाने विदितार्थः प्रतापवान् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006433050, "chapter_id": 26433, "verse_number": "२-९३-५१", "content_sanskrit": "प्रवेशितं च तन्माल्यं स्त्रीभिर्मधुकरायुतम् ।\nउपनीतं प्रभावत्यै स्त्रीभिस्तद् भ्रमरावृतम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006433051, "chapter_id": 26433, "verse_number": "२-९३-५२", "content_sanskrit": "अविदूरे च विन्यस्तं प्रभावत्या जनाधिप ।\nभ्रमरास्ते ययुः सौम्य संध्याकाले ह्युपस्थिते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006433052, "chapter_id": 26433, "verse_number": "२-९३-५३", "content_sanskrit": "स भैमप्रवरो वीरस्तैः सहायैर्विहीनतः ।\nकर्णोत्पले प्रभावत्या निलिल्ये शनकैरिव ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006433053, "chapter_id": 26433, "verse_number": "२-९३-५४", "content_sanskrit": "ततः प्रभावती हंसीमुवाच वदतां वरा ।\nउद्यतं पूर्णचन्द्रं सा समीक्ष्यातिमनोहरम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006433054, "chapter_id": 26433, "verse_number": "२-९३-५५", "content_sanskrit": "सखि दह्यन्ति मेऽङ्गानि मुखं च परिशुष्यति ।\nऔत्सुक्यं हृदि चातीव कोऽयं व्याधिरनौषधः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006433055, "chapter_id": 26433, "verse_number": "२-९३-५६", "content_sanskrit": "दधद् द्विगुणमौत्सुक्यमसौ पूर्णनिशाकरः ।\nनवोदितः शीतरश्मिः सख्यं हरति च प्रियः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006433056, "chapter_id": 26433, "verse_number": "२-९३-५७", "content_sanskrit": "न दृष्टपूर्वो हि मया श्रुतमात्रेण काङ्क्षितः ।\nअहो धूमयतेऽङ्गानि स्त्रीस्वभावस्य धिक् खलु ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006433057, "chapter_id": 26433, "verse_number": "२-९३-५८", "content_sanskrit": "कल्पयामि यथाबुद्ध्या यदि नाभ्येति मे प्रियः ।\nकुमुद्वतीगतं मार्गं हा गमिष्याम्यकिंचना ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006433058, "chapter_id": 26433, "verse_number": "२-९३-५९", "content_sanskrit": "मदनाशीविषेणास्मि हा हा दष्टा मनस्विनी ।\nशीतवीर्याः प्रकृत्यैव जगतो ह्रादनाः सुखाः ।\nदहन्ति मम गात्राणि किं नु चन्द्रगभस्तयः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006433059, "chapter_id": 26433, "verse_number": "२-९३-६०", "content_sanskrit": "प्रकृत्या शीतलो वायुर्नानापुष्परजोवहः ।\nदावाग्निसदृशो मेऽद्य दन्दहीति शुभां तनुम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006433060, "chapter_id": 26433, "verse_number": "२-९३-६१", "content_sanskrit": "ततः संकल्पये एव स्थैर्यं कार्यमिवात्मनः ।\nनावतिष्ठति निर्वीर्यं मनः सकल्पधर्षितम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006433061, "chapter_id": 26433, "verse_number": "२-९३-६२", "content_sanskrit": "विमनस्कास्मि मुह्यामि वेपथुर्मे महान् हृदि ।\nबम्भ्रमीति च मे दृष्टिर्हा हा यामि ध्रुवं क्षयम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]