[{"id": 2145882, "chapter_id": 4144, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145883, "chapter_id": 4144, "verse_number": "१", "content_sanskrit": "तथोक्ते वासुदेवेन नित्यमन्युरमर्षणः ।\nसदश्ववत् समाधाय बभाषे तदनन्तरम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145884, "chapter_id": 4144, "verse_number": "२", "content_sanskrit": "अन्यथा मां चिकीर्षन्तमन्यथा मन्यसेऽच्युत ।\nप्रणीतभावमत्यर्थं युधि सत्यपराक्रमम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145885, "chapter_id": 4144, "verse_number": "३", "content_sanskrit": "वेत्सि दाशार्ह सत्वं मे दीर्घकालं सहोषितः ।\nउत वा मां न जानासि प्लवद् ह्रदमिवाप्लवम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145886, "chapter_id": 4144, "verse_number": "४", "content_sanskrit": "तस्मादनभिरूपाभिर्वाग्भिर्मां त्वं समार्च्छसि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145887, "chapter_id": 4144, "verse_number": "५", "content_sanskrit": "कथं हि भीमसेनं मां जानन् कश्चन माधव ।\nब्रूयादप्रतिरूपाणि यथा मां वक्तुमर्हसि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145888, "chapter_id": 4144, "verse_number": "६", "content_sanskrit": "तस्मादिदं प्रवक्ष्यामि वचनं वृष्णिनन्दन ।\nआत्मनः पौरुषं चैव बलं च न समं परैः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145889, "chapter_id": 4144, "verse_number": "७", "content_sanskrit": "सर्वथाऽनार्यकर्मैतत् प्रशंसा स्वयमात्मनः ।\nअतिवादापविद्धस्तु वक्ष्यामि बलमात्मनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145890, "chapter_id": 4144, "verse_number": "८", "content_sanskrit": "पश्येमे रोदसी कृष्ण ययोरासन्निमाः प्रजाः ।\nअचले चाप्रतिष्ठे चाप्यनन्ते सर्वमातरौ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145891, "chapter_id": 4144, "verse_number": "९", "content_sanskrit": "यदि मे सहसाऽऽकृष्टे समे यातां शिले इव ।\nअहमेते निगृह्णीयां बाहुभ्यां सचराचरे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145892, "chapter_id": 4144, "verse_number": "१०", "content_sanskrit": "पश्यैतदन्तरं बाह्वोर्महापरिघयोरिव ।\nय एतौ प्राप्य मुच्येत न तं पश्यामि पूरुषम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145893, "chapter_id": 4144, "verse_number": "११", "content_sanskrit": "हिमवांश्च समुद्रश्च वज्री वा बलभित् स्वयम् ।\nमयाऽभिपन्नं त्रायेरन् बलमास्थाय न त्रयः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145894, "chapter_id": 4144, "verse_number": "१२", "content_sanskrit": "युद्धार्हान् क्षत्रियान् सर्वान् पाण्डवेष्वाततायिनः ।\nअधः पादतळेनैतान् अधिष्ठास्यामि भूतळे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145895, "chapter_id": 4144, "verse_number": "१३", "content_sanskrit": "न हि त्वं नाभिजानासि मम विक्रममच्युत ।\nयथा मया विनिर्जित्य राजानो वशगाः कृताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145896, "chapter_id": 4144, "verse_number": "१४", "content_sanskrit": "अथ चेन्मां न जानासि यथा सूर्यमिवोदितम् ।\nविगाढे युधि सम्बाधे वेत्स्यसे मां जनार्दन\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145897, "chapter_id": 4144, "verse_number": "१५", "content_sanskrit": "किं माऽत्यधाक्षीः परुषैः व्रणं सूच्येव चानघ ।\nयथामति ब्रवीम्येतद् विद्धि मामधिकं ततः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145898, "chapter_id": 4144, "verse_number": "१६", "content_sanskrit": "द्रष्टासि युधि सम्बाधे प्रवृत्ते वैशसेऽहनि ।\nमया प्रणुन्नान् मातङ्गान् रथिनः सादिनस्तथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145899, "chapter_id": 4144, "verse_number": "१७", "content_sanskrit": "तथाऽन्तकमिव क्रुद्धं निघ्नन्तं क्षत्रियर्षभान् ।\nद्रष्टा मां त्वं च लोकश्च निकर्षन्तं परान् वरान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145900, "chapter_id": 4144, "verse_number": "१८", "content_sanskrit": "न मे सीदन्ति गात्राणि न च मे वेपते मनः ।\nसर्वलोकादभिक्रुद्धान्न भयं विद्यते मम\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145901, "chapter_id": 4144, "verse_number": "१९", "content_sanskrit": "किन्तु सौहृदमेवैतत् कृपया मधुसूदन ।\nसर्वांस्तितिक्षे सङ्क्लेशान् मा स्म नो भरता नशन्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2145902, "chapter_id": 4144, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् उद्योगपर्वणि पञ्चसप्ततितमोऽध्यायः ॥७५॥\nभगवद्यानपर्वणि षष्ठोऽध्यायः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]