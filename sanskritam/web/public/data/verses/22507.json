[{"id": 7002507000, "chapter_id": 22507, "verse_number": "१-१६९-१", "content_sanskrit": "सुमंतुरुवाच ।\nमृन्मयं दारुजं शैलं पक्वेष्टकमथापि वा ।\nकृत्वा मठं गृहं वापि यथा विभ वसंभवात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002507001, "chapter_id": 22507, "verse_number": "१-१६९-२", "content_sanskrit": "सर्वोपकरणोपेतं सर्वधान्यसमन्वितम् ।\nसूर्यायेत्थं गृहं दद्यात्सर्वान्कामानवाप्नुयात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002507002, "chapter_id": 22507, "verse_number": "१-१६९-३", "content_sanskrit": "कृत्वैकभक्तं हेमंते माघमासमतं द्रितः ।\nमासांतेन रथं कुर्याच्चित्रवस्त्रोपशोभितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002507003, "chapter_id": 22507, "verse_number": "१-१६९-४", "content_sanskrit": "श्वेतैश्चतुर्भिः संयुक्तं तुरगैः समलंकृतम् ।\nश्वेतध्वजपताकाभिश्छत्रचामरदर्पणैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002507004, "chapter_id": 22507, "verse_number": "१-१६९-५", "content_sanskrit": "तंडुलाढकपिष्टेन कृत्वा भानुं नराधिप ।\nविन्यस्य तं रथोपस्थे संज्ञया सह भूपते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002507005, "chapter_id": 22507, "verse_number": "१-१६९-६", "content_sanskrit": "तं रात्रौ राजमार्गेण शंखभेर्यादिनिस्वनैः ।\nभ्रमयित्वा शनैः पश्चात्सूर्यायतनमाविशेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002507006, "chapter_id": 22507, "verse_number": "१-१६९-७", "content_sanskrit": "तत्र जागरपूजाभिः प्रदीपावलिशोभितैः ।\nप्रेक्षणीयैः प्रदानैश्च क्षपयित्वा शनैः क्षपाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002507007, "chapter_id": 22507, "verse_number": "१-१६९-८", "content_sanskrit": "प्रभाते स्नपनं कृत्वा मधुक्षीरघृतेन च ।\nदीनांधकृपणेभ्योऽन्नं यथाशक्त्या च दक्षिणाम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002507008, "chapter_id": 22507, "verse_number": "१-१६९-९", "content_sanskrit": "रथं संवाहनोपेतं भास्कराय निवेदयेत् ।\nभुक्त्वा च बांधवैः सार्धं प्रणम्यार्कगृहं व्रजेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002507009, "chapter_id": 22507, "verse_number": "१-१६९-१०", "content_sanskrit": "सर्वव्रतानां प्रवरं मंत्रधर्मान्वितः सदा ।\nव्रतं सूर्यव्रतं नामसर्वकामार्थसिद्धये ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002507010, "chapter_id": 22507, "verse_number": "१-१६९-११", "content_sanskrit": "सर्वव्रतेषु यत्पुण्यं सर्वयज्ञेषु यत्फलम् ।\nसर्वं सूर्यरथेनेह तत्पुण्यं लभते नृप ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002507011, "chapter_id": 22507, "verse_number": "१-१६९-१२", "content_sanskrit": "सूर्यायुतप्रतीकाशैर्विमानैः सार्वकामिकैः ।\nत्रिसप्तकुलजैः सार्धं सूर्यलोके महीयते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002507012, "chapter_id": 22507, "verse_number": "१-१६९-१३", "content_sanskrit": "भुक्त्वा तु विपुलान्भोगान्सर्वलोकेष्वनुक्रमात् ।\nकल्पायुतशतं साग्रं ततो राजा भवेत्क्षितौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002507013, "chapter_id": 22507, "verse_number": "१-१६९-१४", "content_sanskrit": "पंचबलिसमायुक्तं मृदु षड्वास्तुकल्पितम् ।\nसर्वोपकरणोपेतं सूर्यं संज्ञां प्रकल्पयेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002507014, "chapter_id": 22507, "verse_number": "१-१६९-१५", "content_sanskrit": "संज्ञादेवीसमायुक्तं पैष्टाशाढ्यं निवेदयेत् ।\nसौरज्ञानार्थतत्त्वज्ञमाचार्यमुदयान्वितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002507015, "chapter_id": 22507, "verse_number": "१-१६९-१६", "content_sanskrit": "संपूज्य गंधपुष्पाद्यैर्वस्त्रालंकारचामरैः ।\nभक्ष्य भोज्यैरशेषैश्च ततः शय्यां निवेदयेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002507016, "chapter_id": 22507, "verse_number": "१-१६९-१७", "content_sanskrit": "तदूर्णातूलवस्त्राणां परिसंख्या तु यावती ।\nतावद्वर्षसहस्राणि सूर्यलोके महीयते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002507017, "chapter_id": 22507, "verse_number": "१-१६९-१८", "content_sanskrit": "सुरादिसर्वलोकेषु भुक्त्वा भोगानशेषतः ।\nकामादागत्य लोकेऽस्मिन्राजा भवति धार्मिकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002507018, "chapter_id": 22507, "verse_number": "१-१६९-१९", "content_sanskrit": "दश गोभिः सह वृषं ता वृषैकादशाः स्मृताः ।\nसूर्याय विनिवेद्येह यत्फलं लभते शृणु ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002507019, "chapter_id": 22507, "verse_number": "१-१६९-२०", "content_sanskrit": "द्वादशादित्यतुल्यात्मा अणिमादिगुणैर्युतः ।\nसर्वत्र मोदते राजन्सूर्यस्यानुचरो भवेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]