[{"id": 2027309, "chapter_id": 1587, "verse_number": "३-२२५-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027310, "chapter_id": 1587, "verse_number": "३-२२५-१", "content_sanskrit": "अग्नीनां विविधा वंशाः कीर्तितास्ते मयाऽनघ।\nशुणु जन्म तु कौरव्य कार्तिकेयस् धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027311, "chapter_id": 1587, "verse_number": "३-२२५-२", "content_sanskrit": "अद्भुतस्याद्भुतं पुत्रं प्रवक्ष्याम्यमितौजसम्।\nजातं सप्तर्षिभार्याभिर्ब्रह्मण्यं कीर्तिवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027312, "chapter_id": 1587, "verse_number": "३-२२५-३", "content_sanskrit": "देवासुराः पुरा यत्ता विनिघ्नन्तः परस्परम्।\nतत्राजयन्सदा देवान्दानवा घोररूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027313, "chapter_id": 1587, "verse_number": "३-२२५-४", "content_sanskrit": "वध्यमानं बलं दृष्ट्वा बहुशस्तैः पुरंदरः।\nस सैन्यनायकार्थाय चिन्तयामास वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027314, "chapter_id": 1587, "verse_number": "३-२२५-५", "content_sanskrit": "देवसेनां दानवैर्हि भग्नां दृष्ट्वा महाबलः।\nपालयेद्वीर्यमाश्रित्य स ज्ञेयः पुरुषो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027315, "chapter_id": 1587, "verse_number": "३-२२५-६", "content_sanskrit": "स शैलं मानसं गत्वा ध्यायन्नर्थमिमं भृशम्।\nशुश्रावार्तस्वरं घोरमथ मुक्तं स्त्रिया तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027316, "chapter_id": 1587, "verse_number": "३-२२५-७", "content_sanskrit": "अभिधावतु मां कश्चित्पुरुषस्त्रातु चैव ह।\nपतिं च मे प्रदिशतु स्वयं वा पतिरस्तु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027317, "chapter_id": 1587, "verse_number": "३-२२५-८", "content_sanskrit": "पुरंदरस्तु तामाह मा भैर्नास्ति भयं तव।\nएवमुक्त्वा ततोऽपश्यत्केशिनं स्थितमग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027318, "chapter_id": 1587, "verse_number": "३-२२५-९", "content_sanskrit": "किरीटिनं गदापाणिं धातुमन्तमिवाचलम्।\nहस्ते गृहीत्वा कन्यां तामथैनं वासवोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027319, "chapter_id": 1587, "verse_number": "३-२२५-१०", "content_sanskrit": "अनार्यकर्मन्कस्मात्त्वमिमां कन्यां जिहीर्षसि।\nवज्रिणं मांविजानीहि विरमास्याः प्रबाधनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027320, "chapter_id": 1587, "verse_number": "३-२२५-११x", "content_sanskrit": "केश्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027321, "chapter_id": 1587, "verse_number": "३-२२५-११", "content_sanskrit": "विसृजस्व त्वमेवैनां शक्रैषा प्रार्थिता मया।\nक्षमं तेजीवतो गनतुं स्वपुरं पाकशासन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027322, "chapter_id": 1587, "verse_number": "३-२२५-१२", "content_sanskrit": "एवमुक्त्वा गदां केशी चिक्षेपेन्द्रवधाय वै।\nतामापतन्तीं चिच्छेद मध्ये वज्रेण वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027323, "chapter_id": 1587, "verse_number": "३-२२५-१३", "content_sanskrit": "अथास्य शैलशिखरं केशी क्रुद्धो व्यवासृजत्।\n`महामेघप्रतीकाशं चलत्पावकसंकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027324, "chapter_id": 1587, "verse_number": "३-२२५-१४", "content_sanskrit": "तदापन्ततं संप्रेक्ष्य शैलशृङ्गं शतक्रतुः।\nबिभेद राजन्वज्रेण भुवि तन्निपपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027325, "chapter_id": 1587, "verse_number": "३-२२५-१५", "content_sanskrit": "पतता तु तदा केशी तेन शृङ्गेण ताडितः।\nहित्वा कन्यां महाभागां प्राद्रवद्भृशपीडितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027326, "chapter_id": 1587, "verse_number": "३-२२५-१६", "content_sanskrit": "अपयातेऽसुरे तस्मिंस्तां कन्यां वासवोऽब्रवीत्।\nकासि कस्यसि किंचेह कुरुषे त्वं शुभानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027327, "chapter_id": 1587, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि पञ्चविंसत्यधिकशततमोऽध्यायः ॥ २२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]