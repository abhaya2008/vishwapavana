[{"id": 5000225000, "chapter_id": 9225, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे एकोनत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000225001, "chapter_id": 9225, "verse_number": "३-२९-१", "content_sanskrit": "खरं तु विरथं रामो गदापाणिमवस्थितम्।\nमृदुपूर्वं महातेजाः परुषं वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000225002, "chapter_id": 9225, "verse_number": "३-२९-२", "content_sanskrit": "गजाश्वरथसम्बाधे बले महति तिष्ठता।\nकृतं ते दारुणं कर्म सर्वलोकजुगुप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000225003, "chapter_id": 9225, "verse_number": "३-२९-३", "content_sanskrit": "उद्वेजनीयो भूतानां नृशंसः पापकर्मकृत् ।\nत्रयाणामपि लोकानामीश्वरोऽपि न तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000225004, "chapter_id": 9225, "verse_number": "३-२९-४", "content_sanskrit": "कर्म लोकविरुद्धं तु कुर्वाणं क्षणदाचर।\nतीक्ष्णं सर्वजनो हन्ति सर्पं दुष्टमिवागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000225005, "chapter_id": 9225, "verse_number": "३-२९-५", "content_sanskrit": "लोभात् पापानि कुर्वाणः कामाद् वा यो न बुध्यते।\nहृष्टः पश्यति तस्यान्तं ब्राह्मणी करकादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000225006, "chapter_id": 9225, "verse_number": "३-२९-६", "content_sanskrit": "वसतो दण्डकारण्ये तापसान् धर्मचारिणः।\nकिं नु हत्वा महाभागान् फलं प्राप्स्यसि राक्षस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000225007, "chapter_id": 9225, "verse_number": "३-२९-७", "content_sanskrit": "न चिरं पापकर्माणः क्रूरा लोकजुगुप्सिताः।\nऐश्वर्यं प्राप्य तिष्ठन्ति शीर्णमूला इव द्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000225008, "chapter_id": 9225, "verse_number": "३-२९-८", "content_sanskrit": "अवश्यं लभते कर्ता फलं पापस्य कर्मणः।\nघोरं पर्यागते काले द्रुमः पुष्पमिवार्तवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000225009, "chapter_id": 9225, "verse_number": "३-२९-९", "content_sanskrit": "नचिरात् प्राप्यते लोके पापानां कर्मणां फलम्।\nसविषाणामिवान्नानां भुक्तानां क्षणदाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000225010, "chapter_id": 9225, "verse_number": "३-२९-१०", "content_sanskrit": "पापमाचरतां घोरं लोकस्याप्रियमिच्छताम्।\nअहमासादितो राज्ञा प्राणान् हन्तुं निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000225011, "chapter_id": 9225, "verse_number": "३-२९-११", "content_sanskrit": "अद्य भित्त्वा मया मुक्ताः शराः काञ्चनभूषणाः।\nविदार्यातिपतिष्यन्ति वल्मीकमिव पन्नगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000225012, "chapter_id": 9225, "verse_number": "३-२९-१२", "content_sanskrit": "ये त्वया दण्डकारण्ये भक्षिता धर्मचारिणः।\nतानद्य निहतः संख्ये ससैन्योऽनुगमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000225013, "chapter_id": 9225, "verse_number": "३-२९-१३", "content_sanskrit": "अद्य त्वां निहतं बाणैः पश्यन्तु परमर्षयः।\nनिरयस्थं विमानस्था ये त्वया निहताः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000225014, "chapter_id": 9225, "verse_number": "३-२९-१४", "content_sanskrit": "प्रहरस्व यथाकामं कुरु यत्नं कुलाधम।\nअद्य ते पातयिष्यामि शिरस्तालफलं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000225015, "chapter_id": 9225, "verse_number": "३-२९-१५", "content_sanskrit": "एवमुक्तस्तु रामेण क्रुद्धः संरक्तलोचनः।\nप्रत्युवाच ततो रामं प्रहसन् क्रोधमूर्च्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000225016, "chapter_id": 9225, "verse_number": "३-२९-१६", "content_sanskrit": "प्राकृतान् राक्षसान् हत्वा युद्धे दशरथात्मज।\nआत्मना कथमात्मानमप्रशस्यं प्रशंससि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000225017, "chapter_id": 9225, "verse_number": "३-२९-१७", "content_sanskrit": "विक्रान्ता बलवन्तो वा ये भवन्ति नरर्षभाः।\nकथयन्ति न ते किंचित् तेजसा चातिगर्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000225018, "chapter_id": 9225, "verse_number": "३-२९-१८", "content_sanskrit": "प्राकृतास्त्वकृतात्मानो लोके क्षत्रियपांसनाः।\nनिरर्थकं विकत्थन्ते यथा राम विकत्थसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000225019, "chapter_id": 9225, "verse_number": "३-२९-१९", "content_sanskrit": "कुलं व्यपदिशन् वीरः समरे कोऽभिधास्यति।\nमृत्युकाले तु सम्प्राप्ते स्वयमप्रस्तवे स्तवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000225020, "chapter_id": 9225, "verse_number": "३-२९-२०", "content_sanskrit": "सर्वथा तु लघुत्वं ते कत्थनेन विदर्शितम्।\nसुवर्णप्रतिरूपेण तप्तेनेव कुशाग्निना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000225021, "chapter_id": 9225, "verse_number": "३-२९-२१", "content_sanskrit": "न तु मामिह तिष्ठन्तं पश्यसि त्वं गदाधरम्।\nधराधरमिवाकम्प्यं पर्वतं धातुभिश्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000225022, "chapter_id": 9225, "verse_number": "३-२९-२२", "content_sanskrit": "पर्याप्तोऽहं गदापाणिर्हन्तुं प्राणान् रणे तव।\nत्रयाणामपि लोकानां पाशहस्त इवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000225023, "chapter_id": 9225, "verse_number": "३-२९-२३", "content_sanskrit": "कामं बह्वपि वक्तव्यं त्वयि वक्ष्यामि न त्वहम्।\nअस्तं प्राप्नोति सविता युद्धविघ्नस्ततो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000225024, "chapter_id": 9225, "verse_number": "३-२९-२४", "content_sanskrit": "चतुर्दश सहस्राणि राक्षसानां हतानि ते।\nत्वद्विनाशात् करोम्यद्य तेषामश्रुप्रमार्जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000225025, "chapter_id": 9225, "verse_number": "३-२९-२५", "content_sanskrit": "इत्युक्त्वा परमक्रुद्धः स गदां परमाङ्गदाम्।\nखरश्चिक्षेप रामाय प्रदीप्तामशनिं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000225026, "chapter_id": 9225, "verse_number": "३-२९-२६", "content_sanskrit": "खरबाहुप्रमुक्ता सा प्रदीप्ता महती गदा।\nभस्म वृक्षांश्च गुल्मांश्च कृत्वागात् तत्समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000225027, "chapter_id": 9225, "verse_number": "३-२९-२७", "content_sanskrit": "तामापतन्तीं महतीं मृत्युपाशोपमां गदाम्।\nअन्तरिक्षगतां रामश्चिच्छेद बहुधा शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000225028, "chapter_id": 9225, "verse_number": "३-२९-२८", "content_sanskrit": "सा विशीर्णा शरैर्भिन्ना पपात धरणीतले।\nगदा मन्त्रौषधिबलैर्व्यालीव विनिपातिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000225029, "chapter_id": 9225, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे एकोनत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]