[{"id": 2057301, "chapter_id": 2242, "verse_number": "७-१६९-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2057302, "chapter_id": 2242, "verse_number": "७-१६९-१", "content_sanskrit": "शतानीकं शरैस्तूर्णं निर्दहन्तं चमूं तव।\nचित्रसेनस्तव सुतो वारयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2057303, "chapter_id": 2242, "verse_number": "७-१६९-२", "content_sanskrit": "नाकुलिश्चित्रसेनं तु विद्ध्वा पञ्चभिराशुगैः।\nस तु तं प्रतिविव्याध दशभिर्निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2057304, "chapter_id": 2242, "verse_number": "७-१६९-३", "content_sanskrit": "चित्रसेनो महाराज शतानीकं पुनर्युधि।\nनवभिर्निशितैर्बाणैराजघान स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2057305, "chapter_id": 2242, "verse_number": "७-१६९-४", "content_sanskrit": "नाकुलिस्तस्य विशिखैर्वर्म सन्नतपर्वभिः।\nगात्रात्सञ्चावयामास तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2057306, "chapter_id": 2242, "verse_number": "७-१६९-५", "content_sanskrit": "सोपेतवर्मा पुत्रस्ते विरराज भृशं नृप।\nउत्सृज्य काले राजेन्द्र निर्मोकमिव पन्नगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2057307, "chapter_id": 2242, "verse_number": "७-१६९-६", "content_sanskrit": "ततोऽस्य निशितैर्बाणैर्ध्वजं चिच्छेद नाकुलिः।\nधनुश्चैव महाराज यतमानस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2057308, "chapter_id": 2242, "verse_number": "७-१६९-७", "content_sanskrit": "स च्छिन्नधन्वा समरे विवर्मा च महारथः।\nधनुरन्यन्महाराज जग्राहारिविदारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2057309, "chapter_id": 2242, "verse_number": "७-१६९-८", "content_sanskrit": "ततस्तूर्णं चित्रसेनो नाकुलिं नवभिः शरैः।\nविव्याध समरे क्रुद्धो भरतानां महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2057310, "chapter_id": 2242, "verse_number": "७-१६९-९", "content_sanskrit": "शतानीकोऽथ सङ्क्रुद्धश्चित्रसेनस्य मारिष।\nजघान चतुरो वाहान्सारथिं च नरोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2057311, "chapter_id": 2242, "verse_number": "७-१६९-१०", "content_sanskrit": "अवप्लुत्य रथात्तस्माच्चित्रसेनो महारथः।\nनाकुलिं पञ्चविंशत्या शराणामार्दयद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2057312, "chapter_id": 2242, "verse_number": "७-१६९-११", "content_sanskrit": "तस्य तत्कुर्वतः कर्म नकुलस्य सुतो रणे।\nअर्धचन्द्रेण चिच्छेद चापं रत्नविभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2057313, "chapter_id": 2242, "verse_number": "७-१६९-१२", "content_sanskrit": "स च्छिन्नधन्वा विरथो हताश्वो हतसारथिः।\nआरुरोह रथं तूर्णं हार्दिक्यस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2057314, "chapter_id": 2242, "verse_number": "७-१६९-१३", "content_sanskrit": "द्रुपदं तु सहानीकं द्रोणप्रेप्सुं महारथम्।\nवृषसेनोऽभ्ययात्तूर्णं किरञ्शरशतैस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2057315, "chapter_id": 2242, "verse_number": "७-१६९-१४", "content_sanskrit": "यज्ञसेनस्तु समरे कर्णपुत्रं महारथम्।\nषष्ट्या शराणां विव्याध बाह्वोरुरसि चानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2057316, "chapter_id": 2242, "verse_number": "७-१६९-१५", "content_sanskrit": "वृषसेनस्तु सङ्क्रुद्धो यज्ञसेनं रथे स्थितम्।\nबहुभिः सायकैस्तीक्ष्णैराजघान स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2057317, "chapter_id": 2242, "verse_number": "७-१६९-१६", "content_sanskrit": "तावुभौ शरनुन्नाङ्गौ शरकण्टकितौ रणे।\nव्यभ्राजेतां महाराज श्वाविधौ शललैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2057318, "chapter_id": 2242, "verse_number": "७-१६९-१७", "content_sanskrit": "रुक्मपुङ्खैः प्रसन्नाग्रैः शरैश्छिन्नतनुच्छदौ।\nरुधिरौघपरिक्लिन्नौ व्यभ्राजेतां महामृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2057319, "chapter_id": 2242, "verse_number": "७-१६९-१८", "content_sanskrit": "तपनीयनिभौ चित्रौ कल्पवृक्षाविवाद्भुतौ।\nकिंशुकाविव चोत्फुल्लौ व्यकाशेतां रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2057320, "chapter_id": 2242, "verse_number": "७-१६९-१९", "content_sanskrit": "वृषसेनस्ततो राजन्द्रुपदं नवभिः शरैः।\nविद्ध्वा विव्याध सप्तत्या पुनरन्यैस्त्रिभिस्त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2057321, "chapter_id": 2242, "verse_number": "७-१६९-२०", "content_sanskrit": "ततः शरसहस्राणि विमुञ्चन्विबभौ तदा।\nकर्णपुत्रो महाराज वर्षमाण इवाम्बुदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2057322, "chapter_id": 2242, "verse_number": "७-१६९-२१", "content_sanskrit": "[द्रुपदस्तु ततः क्रुद्धो वृषसेनस्य कार्मुकम्।\nद्विधा चिच्छेद भल्लेन पीतेन निशितेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2057323, "chapter_id": 2242, "verse_number": "७-१६९-२२", "content_sanskrit": "सोऽन्यत्कार्मुकमादाय रुक्मबद्धं नवं दृढम्।\nतूणादाकृष्य विमलं भल्लं पीतं शितं दृढम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2057324, "chapter_id": 2242, "verse_number": "७-१६९-२३", "content_sanskrit": "कार्मुके योजयित्वा तं द्रुपदं सन्निरीक्ष्य च।\nआकर्णपूर्णं मुमुचे त्रासयन्सर्वसोमकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2057325, "chapter_id": 2242, "verse_number": "७-१६९-२४", "content_sanskrit": "हृदयं तस्य भित्त्वा च जगाम वसुधातलम्।\nकश्मलं प्राविशद्राजा वृषसेनशराहतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2057326, "chapter_id": 2242, "verse_number": "७-१६९-२५", "content_sanskrit": "सारथिस्तमपोवाह स्मरन्सारथिचेष्टितम्।\nतस्मिन्प्रभग्ने राजेन्द्र पाञ्चालानां महारथे॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2057327, "chapter_id": 2242, "verse_number": "७-१६९-२६", "content_sanskrit": "ततस्तु द्रुपदानीकं शरैश्छिन्नतनुच्छदम्।\nसम्प्राद्रवद्रणाद्राजन्निशीथे भैरवे सति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2057328, "chapter_id": 2242, "verse_number": "७-१६९-२७", "content_sanskrit": "प्रदीपैरपरित्यक्तैर्ज्वलद्भिस्तैः समन्ततः।\nव्यराजद्वसुधा तत्र वीताभ्रा द्यौरिव ग्रहैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2057329, "chapter_id": 2242, "verse_number": "७-१६९-२८", "content_sanskrit": "तथाङ्गदैर्निपतितैर्व्यराजत वसुन्धरा।\nप्रावृट्काले महाराज विद्युद्भिरिव तोयदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2057330, "chapter_id": 2242, "verse_number": "७-१६९-२९", "content_sanskrit": "ततः कर्णसुतात्त्रस्ताः सोमका विप्रदुद्रुवुः।\nयथेन्द्रभयवित्रस्ता दानवास्तारकामये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2057331, "chapter_id": 2242, "verse_number": "७-१६९-३०", "content_sanskrit": "तेनार्द्यमानाः समरे द्रवमाणाश्च सोमकाः।\nव्यराजन्त महाराज प्रदीपैरवभासिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2057332, "chapter_id": 2242, "verse_number": "७-१६९-३१", "content_sanskrit": "तांस्तु निर्जित्य समरे कर्णपुत्रो व्यरोचत।\nमध्यन्दिनमनुप्राप्तो घर्मांशुरिव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2057333, "chapter_id": 2242, "verse_number": "७-१६९-३२", "content_sanskrit": "तेषु राजसहस्रेषु तावकेषु परेषु च।\nएक एव ज्वलंस्तस्थौ वृषसेनः प्रतापवान्॥।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2057334, "chapter_id": 2242, "verse_number": "७-१६९-३३", "content_sanskrit": "स विजित्य रणे शूरान्सोमकानां महारथान्।\nजगाम त्वरितस्तत्र यत्र राजा युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2057335, "chapter_id": 2242, "verse_number": "७-१६९-३४", "content_sanskrit": "प्रतिविन्ध्यमथ क्रुद्धं प्रदहन्तं रणे रिपून्।\nदुःशासनस्तव सुतः प्रत्यगच्छन्महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2057336, "chapter_id": 2242, "verse_number": "७-१६९-३५", "content_sanskrit": "तयोः समागमो राजंश्चित्ररूपो बभूव ह।\nव्यपेतजलदे व्योम्नि बुधभास्करयोरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2057337, "chapter_id": 2242, "verse_number": "७-१६९-३६", "content_sanskrit": "प्रतिविन्ध्यं तु समरे कुर्वाणां कर्म दुष्करम्।\n`अपूजयन्महाराज तव सैन्ये महारथाः।\nदुःशासनस्त्रिभिर्बाणैर्ललाटे समविध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2057338, "chapter_id": 2242, "verse_number": "७-१६९-३७", "content_sanskrit": "सोऽतिविद्धो बलवता तव पुत्रेण धन्विना।\nविरराज महाबाहुः सशृङ्ग इव पर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2057339, "chapter_id": 2242, "verse_number": "७-१६९-३८", "content_sanskrit": "दुःशासनं तु समरे प्रतिविन्ध्यो महारथः।\nनवभिः सायकैर्विद्धा पुनर्विव्याध सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2057340, "chapter_id": 2242, "verse_number": "७-१६९-३९", "content_sanskrit": "तत्र भारत पुत्रस्ते कृतवान्कर्म दुष्करम्।\nप्रतिविन्ध्यहयानुग्रैः पातयामास सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2057341, "chapter_id": 2242, "verse_number": "७-१६९-४०", "content_sanskrit": "सारथिं चास्य भल्लेन ध्वजं च समपातयत्।\nरथं च तिलशो राजन्व्यधमत्तस्य धन्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2057342, "chapter_id": 2242, "verse_number": "७-१६९-४१", "content_sanskrit": "पताकाश्च सतूणीरा रश्मीन्योक्राणि च प्रभो।\nचिच्छेद तिलशः क्रुद्धःशरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2057343, "chapter_id": 2242, "verse_number": "७-१६९-४२", "content_sanskrit": "विरथः स तु धर्मात्मा धनुष्पाणिरवस्थितः।\nअयोधयत्तव सुतं किरञ्शरशतान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2057344, "chapter_id": 2242, "verse_number": "७-१६९-४३", "content_sanskrit": "क्षुरप्रेण धनुस्तस्य चिच्छेद तनयस्तव।\nअथैनं दशभिर्बाणेश्छिन्नधन्वानमार्दयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2057345, "chapter_id": 2242, "verse_number": "७-१६९-४४", "content_sanskrit": "तं दृष्ट्वा विरथं तत्र भ्रातरोऽस्य महारथाः।\nअन्ववर्तन्त सङ्ग्रामे महत्या सेनया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2057346, "chapter_id": 2242, "verse_number": "७-१६९-४५", "content_sanskrit": "आप्लुतः स ततो यानं सुतसोमस्य भास्वरम्।\nधनुर्गृह्य महाराज विव्याध तनयं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2057347, "chapter_id": 2242, "verse_number": "७-१६९-४६", "content_sanskrit": "ततस्तु तावकाः सर्वे परिवार्य सुतं तव।\nअभ्यवर्तन्त वेगेन महत्या सेनया वृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2057348, "chapter_id": 2242, "verse_number": "७-१६९-४७", "content_sanskrit": "ततः प्रववृते युद्धं तव तेषां च भारत।\nनिशीथे दारुणे काले यमराष्ट्रविवर्धनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2057349, "chapter_id": 2242, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे एकोनसप्तत्यधिकशततमोऽध्यायः॥ १६९ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१६९-१ कुण्डलिताः पञ्च श्लोकाः घ.ङ.झ.पुस्तकेष्वेव सन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]