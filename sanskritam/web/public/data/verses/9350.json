[{"id": 5000350000, "chapter_id": 9350, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे एकादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000350001, "chapter_id": 9350, "verse_number": "५-११-१", "content_sanskrit": "अवधूय च तां बुद्धिं बभूवावस्थितस्तदा।\nजगाम चापरां चिन्तां सीतां प्रति महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000350002, "chapter_id": 9350, "verse_number": "५-११-२", "content_sanskrit": "न रामेण वियुक्ता सा स्वप्तुमर्हति भामिनी।\nन भोक्तुं नाप्यलंकर्तुं न पानमुपसेवितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000350003, "chapter_id": 9350, "verse_number": "५-११-३", "content_sanskrit": "नान्यं नरमुपस्थातुं सुराणामपि चेश्वरम्।\nन हि रामसमः कश्चिद् विद्यते त्रिदशेष्वपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000350004, "chapter_id": 9350, "verse_number": "५-११-४", "content_sanskrit": "अन्येयमिति निश्चित्य भूयस्तत्र चचार सः।\nपानभूमौ हरिश्रेष्ठः सीतासंदर्शनोत्सुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000350005, "chapter_id": 9350, "verse_number": "५-११-५", "content_sanskrit": "क्रीडितेनापराः क्लान्ता गीतेन च तथापराः।\nनृत्येन चापराः क्लान्ताः पानविप्रहतास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000350006, "chapter_id": 9350, "verse_number": "५-११-६", "content_sanskrit": "मुरजेषु मृदंगेषु चेलिकासु च संस्थिताः।\nतथाऽऽस्तरणमुख्येषु संविष्टाश्चापराः स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000350007, "chapter_id": 9350, "verse_number": "५-११-७", "content_sanskrit": "अंगनानां सहस्रेण भूषितेन विभूषणैः।\nरूपसंलापशीलेन युक्तगीतार्थभाषिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000350008, "chapter_id": 9350, "verse_number": "५-११-८", "content_sanskrit": "देशकालाभियुक्तेन युक्तवाक्याभिधायिना।\nरताधिकेन संयुक्तां ददर्श हरियूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000350009, "chapter_id": 9350, "verse_number": "५-११-९", "content_sanskrit": "अन्यत्रापि वरस्त्रीणां रूपसंलापशायिनाम्।\nसहस्रं युवतीनां तु प्रसुप्तं स ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000350010, "chapter_id": 9350, "verse_number": "५-११-१०", "content_sanskrit": "देशकालाभियुक्तं तु युक्तवाक्याभिधायि तत्।\nरताविरतसंसुप्तं ददर्श हरियूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000350011, "chapter_id": 9350, "verse_number": "५-११-११", "content_sanskrit": "तासां मध्ये महाबाहुः शुशुभे राक्षसेश्वरः।\nगोष्ठे महति मुख्यानां गवां मध्ये यथा वृषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000350012, "chapter_id": 9350, "verse_number": "५-११-१२", "content_sanskrit": "स राक्षसेन्द्रः शुशुभे ताभिः परिवृतः स्वयम्।\nकरेणुभिर्यथारण्ये परिकीर्णो महाद्विपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000350013, "chapter_id": 9350, "verse_number": "५-११-१३", "content_sanskrit": "सर्वकामैरुपेतां च पानभूमिं महात्मनः।\nददर्श कपिशार्दूलस्तस्य रक्षःपतेर्गृहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000350014, "chapter_id": 9350, "verse_number": "५-११-१४", "content_sanskrit": "मृगाणां महिषाणां च वराहाणां च भागशः।\nतत्र न्यस्तानि मांसानि पानभूमौ ददर्श सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000350015, "chapter_id": 9350, "verse_number": "५-११-१५", "content_sanskrit": "रौक्मेषु च विशालेषु भाजनेष्वप्यभक्षितान्।\nददर्श कपिशार्दूलो मयूरान् कुक्कुटांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000350016, "chapter_id": 9350, "verse_number": "५-११-१६", "content_sanskrit": "वराहवाध्रीणसकान् दधिसौवर्चलायुतान्।\nशल्यान् मृगमयूरांश्च हनुमानन्ववैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000350017, "chapter_id": 9350, "verse_number": "५-११-१७", "content_sanskrit": "कृकलान् विविधांश्छागान् शशकानर्धभक्षितान्।\nमहिषानेकशल्यांश्च मेषांश्च कृतनिष्ठितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000350018, "chapter_id": 9350, "verse_number": "५-११-१८", "content_sanskrit": "लेह्यानुच्चावचान् पेयान् भोज्यान्युच्चावचानि च।\nतथाम्ललवणोत्तंसैर्विविधै रागखाण्डवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000350019, "chapter_id": 9350, "verse_number": "५-११-१९", "content_sanskrit": "महानूपुरकेयूरैरपविद्धैर्महाधनैः।\nपानभाजनविक्षिप्तैः फलैश्च विविधैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000350020, "chapter_id": 9350, "verse_number": "५-११-२०", "content_sanskrit": "कृतपुष्पोपहारा भूरधिकां पुष्यति श्रियम्।\nतत्र तत्र च विन्यस्तैः सुश्लिष्टशयनासनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000350021, "chapter_id": 9350, "verse_number": "५-११-२१", "content_sanskrit": "पानभूमिर्विना वह्निं प्रदीप्तेवोपलक्ष्यते।\nबहुप्रकारैर्विविधैर्वरसंस्कारसंस्कृतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000350022, "chapter_id": 9350, "verse_number": "५-११-२२", "content_sanskrit": "मांसैः कुशलसंयुक्तैः पानभूमिगतैः पृथक्।\nदिव्याः प्रसन्ना विविधाः सुराः कृतसुरा अपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000350023, "chapter_id": 9350, "verse_number": "५-११-२३", "content_sanskrit": "शर्करासवमाध्वीकाः पुष्पासवफलासवाः।\nवासचूर्णैश्च विविधैर्मृष्टास्तैस्तैः पृथक् पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000350024, "chapter_id": 9350, "verse_number": "५-११-२४", "content_sanskrit": "संतता शुशुभे भूमिर्माल्यैश्च बहुसंस्थितैः।\nहिरण्मयैश्च कलशैर्भाजनैः स्फाटिकैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000350025, "chapter_id": 9350, "verse_number": "५-११-२५", "content_sanskrit": "जाम्बूनदमयैश्चान्यैः करकैरभिसंवृता।\nराजतेषु च कुम्भेषु जाम्बूनदमयेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000350026, "chapter_id": 9350, "verse_number": "५-११-२६", "content_sanskrit": "पानश्रेष्ठां तथा भूमिं कपिस्तत्र ददर्श सः।\nसोऽपश्यच्छातकुम्भानि सीधोर्मणिमयानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000350027, "chapter_id": 9350, "verse_number": "५-११-२७", "content_sanskrit": "तानि तानि च पूर्णानि भाजनानि महाकपिः।\nक्वचिदर्धावशेषाणि क्वचित् पीतान्यशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000350028, "chapter_id": 9350, "verse_number": "५-११-२८", "content_sanskrit": "क्वचिन्नैव प्रपीतानि पानानि स ददर्श ह।\nक्वचिद् भक्ष्यांश्च विविधान् क्वचित् पानानि भागशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000350029, "chapter_id": 9350, "verse_number": "५-११-२९", "content_sanskrit": "क्वचिदर्धावशेषाणि पश्यन् वै विचचार ह।\nशयनान्यत्र नारीणां शून्यानि बहुधा पुनः।\nपरस्परं समाश्लिष्य काश्चित् सुप्ता वरांगनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000350030, "chapter_id": 9350, "verse_number": "५-११-३०", "content_sanskrit": "काचिच्च वस्त्रमन्यस्या अपहृत्योपगुह्य च।\nउपगम्याबला सुप्ता निद्राबलपराजिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000350031, "chapter_id": 9350, "verse_number": "५-११-३१", "content_sanskrit": "तासामुच्छ्वासवातेन वस्त्रं माल्यं च गात्रजम्।\nनात्यर्थं स्पन्दते चित्रं प्राप्य मन्दमिवानिलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000350032, "chapter_id": 9350, "verse_number": "५-११-३२", "content_sanskrit": "चन्दनस्य च शीतस्य सीधोर्मधुरसस्य च।\nविविधस्य च माल्यस्य पुष्पस्य विविधस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000350033, "chapter_id": 9350, "verse_number": "५-११-३३", "content_sanskrit": "बहुधा मारुतस्तस्य गन्धं विविधमुद्वहन्।\nस्नानानां चन्दनानां च धूपानां चैव मूर्च्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000350034, "chapter_id": 9350, "verse_number": "५-११-३४", "content_sanskrit": "प्रववौ सुरभिर्गन्धो विमाने पुष्पके तदा।\nश्यामावदातास्तत्रान्याः काश्चित् कृष्णा वरांगनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000350035, "chapter_id": 9350, "verse_number": "५-११-३५", "content_sanskrit": "काश्चित् काञ्चनवर्णांग््यः प्रमदा राक्षसालये।\nतासां निद्रावशत्वाच्च मदनेन विमूर्च्छितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000350036, "chapter_id": 9350, "verse_number": "५-११-३६", "content_sanskrit": "पद्मिनीनां प्रसुप्तानां रूपमासीद् यथैव हि।\nएवं सर्वमशेषेण रावणान्तःपुरं कपिः।\nददर्श स महातेजा न ददर्श च जानकीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000350037, "chapter_id": 9350, "verse_number": "५-११-३७", "content_sanskrit": "निरीक्षमाणश्च ततस्ताः स्त्रियः स महाकपिः।\nजगाम महतीं शंकां धर्मसाध्वसशंकितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000350038, "chapter_id": 9350, "verse_number": "५-११-३८", "content_sanskrit": "परदारावरोधस्य प्रसुप्तस्य निरीक्षणम्।\nइदं खलु ममात्यर्थं धर्मलोपं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000350039, "chapter_id": 9350, "verse_number": "५-११-३९", "content_sanskrit": "न हि मे परदाराणां दृष्टिर्विषयवर्तिनी।\nअयं चात्र मया दृष्टः परदारपरिग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000350040, "chapter_id": 9350, "verse_number": "५-११-४०", "content_sanskrit": "तस्य प्रादुरभूच्चिन्ता पुनरन्या मनस्विनः।\nनिश्चितैकान्तचित्तस्य कार्यनिश्चयदर्शिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000350041, "chapter_id": 9350, "verse_number": "५-११-४१", "content_sanskrit": "कामं दृष्टा मया सर्वा विश्वस्ता रावणस्त्रियः।\nन तु मे मनसा किंचिद् वैकृत्यमुपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000350042, "chapter_id": 9350, "verse_number": "५-११-४२", "content_sanskrit": "मनो हि हेतुः सर्वेषामिन्द्रियाणां प्रवर्तने।\nशुभाशुभास्ववस्थासु तच्च मे सुव्यवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000350043, "chapter_id": 9350, "verse_number": "५-११-४३", "content_sanskrit": "नान्यत्र हि मया शक्या वैदेही परिमार्गितुम्।\nस्त्रियो हि स्त्रीषु दृश्यन्ते सदा सम्परिमार्गणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000350044, "chapter_id": 9350, "verse_number": "५-११-४४", "content_sanskrit": "यस्य सत्त्वस्य या योनिस्तस्यां तत् परिमार्गते।\nन शक्यं प्रमदा नष्टा मृगीषु परिमार्गितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000350045, "chapter_id": 9350, "verse_number": "५-११-४५", "content_sanskrit": "तदिदं मार्गितं तावच्छुद्धेन मनसा मया।\nरावणान्तःपुरं सर्वं दृश्यते न च जानकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000350046, "chapter_id": 9350, "verse_number": "५-११-४६", "content_sanskrit": "देवगन्धर्वकन्याश्च नागकन्याश्च वीर्यवान्।\nअवेक्षमाणो हनुमान् नैवापश्यत जानकीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000350047, "chapter_id": 9350, "verse_number": "५-११-४७", "content_sanskrit": "तामपश्यन् कपिस्तत्र पश्यंश्चान्या वरस्त्रियः।\nअपक्रम्य तदा वीरः प्रस्थातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000350048, "chapter_id": 9350, "verse_number": "५-११-४८", "content_sanskrit": "स भूयः सर्वतः श्रीमान् मारुतिर्यत्नमाश्रितः।\nआपानभूमिमुत्सृज्य तां विचेतुं प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000350049, "chapter_id": 9350, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे एकादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]