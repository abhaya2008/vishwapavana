": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001449, "chapter_id": 8236, "verse_number": "10.10", "content_sanskrit": "वर्षणाद् वृष्टिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900001450, "chapter_id": 8236, "verse_number": "10.11", "content_sanskrit": "अथातो निर्भुजप्रवादाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900001451, "chapter_id": 8236, "verse_number": "10.12", "content_sanskrit": "भञ्जनवर्जितत्वान्निर्भुजं संहिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900001452, "chapter_id": 8236, "verse_number": "10.13", "content_sanskrit": "थिवीस्थितपृथिवीनामक विष्ण्वायतनं पृथिव्यायतनमित्यादि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900001453, "chapter_id": 8236, "verse_number": "10.14", "content_sanskrit": "यद्धि सन्धिं विवर्तयति तन्निर्भुजस्य रूपम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900001454, "chapter_id": 8236, "verse_number": "10.15", "content_sanskrit": "न त्वेवान्यत्कुशलाद् ब्राह्मणं ब्रूयात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900001455, "chapter_id": 8236, "verse_number": "10.16", "content_sanskrit": "अथातोऽनुव्याहाराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900001456, "chapter_id": 8236, "verse_number": "10.17", "content_sanskrit": "सर्वाधारत्वतो वंश इत्युपासीत यो हरिम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900001457, "chapter_id": 8236, "verse_number": "10.18", "content_sanskrit": "स य एनं प्राणं वंशमुपवदेत् प्राणं प्रत्येनमुपासकमुपवदेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900001458, "chapter_id": 8236, "verse_number": "10.19", "content_sanskrit": "अथ खल्वाहुर्निर्भुजवक्त्राः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900001459, "chapter_id": 8236, "verse_number": "10.20", "content_sanskrit": "तदप्येतदृषिणोक्तं– बृहस्पते न परः साम्नो विदुरिति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900001460, "chapter_id": 8236, "verse_number": "10.21", "content_sanskrit": "निरामिणः रामस्य रमणरूपस्य पूर्णानन्दस्वरूपस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900001461, "chapter_id": 8236, "verse_number": "10.22", "content_sanskrit": "येषामेतत्सर्वोत्तमं वासुदेवाख्यं परं ब्रह्म ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900001462, "chapter_id": 8236, "verse_number": "10.23", "content_sanskrit": "ब्रह्मणस्पते ब्रह्मणो वेदस्य पते वायो", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900001463, "chapter_id": 8236, "verse_number": "10.24", "content_sanskrit": "वायुं विद्या समासाद्य सर्वासां पतिमूचिरे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900001464, "chapter_id": 8236, "verse_number": "10.25", "content_sanskrit": "बृहद्रथन्तरयो रूपेण संहिता सन्धीयत इति तार्क्ष्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900001465, "chapter_id": 8236, "verse_number": "10.26", "content_sanskrit": "वाक्प्राणेन संहितेति कौण्ठरव्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900001466, "chapter_id": 8236, "verse_number": "10.27", "content_sanskrit": "प्रथमायां द्वितीयायां विष्णुरेव परो मतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900001467, "chapter_id": 8236, "verse_number": "10.28", "content_sanskrit": "स यदि परेण वोपसृतः स्वेन वाऽर्थेनाभिव्याहरेत्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900001468, "chapter_id": 8236, "verse_number": "10.29", "content_sanskrit": "वाक्संहितेति पञ्चालचण्डः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900001469, "chapter_id": 8236, "verse_number": "10.30", "content_sanskrit": "अथातः प्रजापतिसंहिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900001470, "chapter_id": 8236, "verse_number": "10.31", "content_sanskrit": "स एव दिवि संस्थश्च द्युनामा क्रीडनात् प्रभुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900001471, "chapter_id": 8236, "verse_number": "10.32", "content_sanskrit": "प्रथश्च सप्रथश्चैव राजानौ मत्स्यदेशजौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900001472, "chapter_id": 8236, "verse_number": "10.33", "content_sanskrit": "चतूरूपं परं विष्णुं राजानौ प्रथसप्रथौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900001473, "chapter_id": 8236, "verse_number": "10.34", "content_sanskrit": "एवं चत्वार एव ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900001474, "chapter_id": 8236, "verse_number": "10.35", "content_sanskrit": "यस्य प्रथ इति नाम स च हविर्नाम्नो विष्णोर्हविर्यत् अयत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900001475, "chapter_id": 8236, "verse_number": "10.36", "content_sanskrit": "चतुः शिखण्डां तु रमां द्विरूपो भगवान् हरिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]