[{"id": 7002424000, "chapter_id": 22424, "verse_number": "१-८६-१", "content_sanskrit": "ब्रह्मोवाच ।\nपञ्चतारं भवेद्यत्र नक्षत्रं ते वृषध्वज ।\nवारे तु देवदेवस्य स वारः पुत्रदः स्मृतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002424001, "chapter_id": 22424, "verse_number": "१-८६-२", "content_sanskrit": "उपवासो भवेत्तत्र श्राद्धं कार्यं तथा भवेत् ।\nप्राशनं चापि पिण्डस्य मध्यमस्य प्रकीर्तितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002424002, "chapter_id": 22424, "verse_number": "१-८६-३", "content_sanskrit": "सोपवासस्तु यो भक्त्या पूजयेदत्र गोपतिम् ।\nधूपमाल्योपहारैस्तु दिव्यगन्धसमन्वितैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002424003, "chapter_id": 22424, "verse_number": "१-८६-४", "content_sanskrit": "एवं पूज्य विवस्वन्तं तस्यैव पुरतो निशि ।\nभूमौ स्वपिति वै वीर जपञ्छ्वेतां महामते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002424004, "chapter_id": 22424, "verse_number": "१-८६-५", "content_sanskrit": "प्रातरुत्थाय च स्नानं कृत्वा दत्त्वार्घ्यमुत्तमम् ।\nरक्तचन्दनसम्मिश्रैः करवीरैर्गणाधिप ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002424005, "chapter_id": 22424, "verse_number": "१-८६-६", "content_sanskrit": "प्रपूज्य ग्रहभूतेशमंशुमन्तं त्रिलोचन ।\nवीरं च पूजयित्वा तु ततः श्राद्धं प्रकल्पयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002424006, "chapter_id": 22424, "verse_number": "१-८६-७", "content_sanskrit": "पञ्चभिर्ब्राह्मणैर्देव दिव्यैभोमैश्च२ सुव्रत ।\nमगसंज्ञौ३ तत्र दिव्यौ ब्राह्मणौ परिकल्पयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002424007, "chapter_id": 22424, "verse_number": "१-८६-८", "content_sanskrit": "त्रीनत्र ब्राह्मणान्भीमान्प्रकल्प्यान्धकसूदन ।\nकुर्यादेवं ततः श्राद्धं पार्वणं भास्करप्रियम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002424008, "chapter_id": 22424, "verse_number": "१-८६-९", "content_sanskrit": "श्राद्धे त्वथ समाप्ते तु दद्यात्पिण्डं तु मध्यमम् ।\nपुरतो देवदेवस्य स्थित्वा मन्त्रेण सुव्रत ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002424009, "chapter_id": 22424, "verse_number": "१-८६-१०", "content_sanskrit": "स एष पिण्डो देवेश योऽभीष्टस्तव सर्वदा ।\nअश्नामि पश्यते तुभ्यं तेन मे सन्ततिर्भवेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002424010, "chapter_id": 22424, "verse_number": "१-८६-११", "content_sanskrit": "प्रसादात्तव देवेश इति मे भावितं मनः ।\nइत्थं सम्पूजितो ह्यत्र भास्करः पुत्रदो भवेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002424011, "chapter_id": 22424, "verse_number": "१-८६-१२", "content_sanskrit": "अतोऽयं पुत्रदो वारो देवस्य परिकीर्तितः ।\nएवमत्र सदा यस्तु भास्करं पूजयेन्नरः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002424012, "chapter_id": 22424, "verse_number": "१-८६-१३", "content_sanskrit": "उपवासपरः श्राद्धे स पुत्रं लभते ध्रुवम् ।\nधनं धान्यं हिरण्यं च आरोग्यं सुखदं तथा ।\nसूर्यलोकं च सम्प्राप्य ततो राजा भवेन्नृषु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002424013, "chapter_id": 22424, "verse_number": "१-८६-१४", "content_sanskrit": "प्रभया द्विजसंकाशः कान्त्या चाम्बुजसन्निभः ।\nवीर्येण गोपतेस्तुल्यो गाम्भीर्ये सागरोपमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002424014, "chapter_id": 22424, "verse_number": "१-८६-१५", "content_sanskrit": "ब्रह्मोवाच ।\nदक्षिणे त्वयने यः स्यात्स जयः परिकीर्तितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002424015, "chapter_id": 22424, "verse_number": "१-८६-१६", "content_sanskrit": "अत्रोपवासो नक्तं च स्नानं दानं जपस्तथा ।\nभवेच्छतगुणं देव भास्करप्रीतये कृतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002424016, "chapter_id": 22424, "verse_number": "१-८६-१७", "content_sanskrit": "तस्मान्नक्तादि कर्तव्यं यत्स्याच्छतगुणं विभो ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]