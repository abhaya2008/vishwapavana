[{"id": 2052807, "chapter_id": 2167, "verse_number": "७-९४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2052808, "chapter_id": 2167, "verse_number": "७-९४-१", "content_sanskrit": "ततः प्रविष्टे कौन्तेये सिन्धुराजजिघांसया।\nद्रोणानीकं विनिर्भिद्य भोजानीकं च दुस्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2052809, "chapter_id": 2167, "verse_number": "७-९४-२", "content_sanskrit": "काम्भोजस्य च दायादे हते राजन्सुदक्षिणे।\nश्रुतायुषि च विक्रान्ते निहते सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2052810, "chapter_id": 2167, "verse_number": "७-९४-३", "content_sanskrit": "विप्रद्रुतेष्वनीकेषु विध्वस्तेषु समन्ततः।\nप्रभग्नं स्वबलं दृष्ट्वा पुत्रस्ते द्रोणमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2052811, "chapter_id": 2167, "verse_number": "७-९४-४", "content_sanskrit": "त्वरन्नेकरथेनैव समेत्य द्रोणमब्रवीत्।\nगतः स पुरुषव्याघ्रः प्रमथ्यैतां महाचमूम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2052812, "chapter_id": 2167, "verse_number": "७-९४-५", "content_sanskrit": "अथ बुद्ध्या समीक्षस्व किन्नु कार्यमनन्तरम्।\nअर्जुनस्य विघाताय दारुणेऽस्मिञ्जनक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2052813, "chapter_id": 2167, "verse_number": "७-९४-६", "content_sanskrit": "यथा स पुरुषव्याघ्रो न हन्येत जयद्रथः।\nतथा विधत्स्व भद्रं ते त्वं हि नः परमा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2052814, "chapter_id": 2167, "verse_number": "७-९४-७", "content_sanskrit": "असौ धनञ्जयाग्निर्हि कोपमारुतचोदितः।\nसेनाकक्षं दहति मे वह्निः कक्षमिवोत्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2052815, "chapter_id": 2167, "verse_number": "७-९४-८", "content_sanskrit": "अतिक्रान्ते हि कौन्तेये भित्त्वा सैन्यं परन्तप।\nजयद्रथस्य गोप्तारः संशयं परमं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2052816, "chapter_id": 2167, "verse_number": "७-९४-९", "content_sanskrit": "स्थिरा बुद्धिर्नरेन्द्राणमासीद्ब्रह्मविदां वर।\nनातिक्रमिष्यति द्रोणं जातु जीवन्धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2052817, "chapter_id": 2167, "verse_number": "७-९४-१०", "content_sanskrit": "योऽसौ पाथो व्यतिक्रान्तो मिषतस्ते महाद्युते।\nसर्वं ह्यद्यातुरं मन्ये नेदमस्ति बलं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2052818, "chapter_id": 2167, "verse_number": "७-९४-११", "content_sanskrit": "जानामि त्वां महाभाग पाण्डवानां हिते रतम्।\nततो मुह्यामि च ब्रह्मन्कार्यवत्तां विचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2052819, "chapter_id": 2167, "verse_number": "७-९४-१२", "content_sanskrit": "यथाशक्ति च ते ब्रह्मन्वर्धयन्वृत्तिमुत्तमाम्।\nप्रीणामि च यथाशक्ति तच्च त्वं नावबुध्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2052820, "chapter_id": 2167, "verse_number": "७-९४-१३", "content_sanskrit": "अस्मान्न त्वं सदा भक्तानिच्छस्यमितविक्रम।\nपाण्डवान्सततं प्रीणास्यास्माकं विप्रिये रतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2052821, "chapter_id": 2167, "verse_number": "७-९४-१४", "content_sanskrit": "अस्मानेवोपजीवंस्त्वमस्माकं विप्रिये रतः।\nन ह्यहं त्वां विजानामि मधुदिग्धमिव क्षुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2052822, "chapter_id": 2167, "verse_number": "७-९४-१५", "content_sanskrit": "`नह्यहं त्वां विजानामि सर्वं मण्डूकराविणम्।\nनादास्यच्चेद्वरं मह्यं भवान्पाण्डवनिग्रहे।\nनावारयिष्यं गच्छन्तमहं सिन्धुपतिं गृहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2052823, "chapter_id": 2167, "verse_number": "७-९४-१६", "content_sanskrit": "मया त्वाशंसमानेन त्वत्तस्त्राणमबुद्धिना।\nआश्वासितः सिन्धुपतिर्मोहाद्दत्तश्च मृत्यवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2052824, "chapter_id": 2167, "verse_number": "७-९४-१७", "content_sanskrit": "यमदंष्ट्रान्तरं प्राप्तो मुच्येतापि हि मानवः।\nनार्जुनस्य वशं प्राप्तो मुच्येताजौ जयद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2052825, "chapter_id": 2167, "verse_number": "७-९४-१८", "content_sanskrit": "स तथा कुरु शोणश्व यथा मुच्येत सैन्धवः।\nमम चार्तप्रलापानां माक्रुधः पाहि सैन्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2052826, "chapter_id": 2167, "verse_number": "७-९४-१९x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2052827, "chapter_id": 2167, "verse_number": "७-९४-१९", "content_sanskrit": "नाभ्यसूयामि ते वाक्यमश्वत्थाम्नाऽसि मे समः।\nसत्यं तु ते प्रवक्ष्यामि तज्जुषस्व विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2052828, "chapter_id": 2167, "verse_number": "७-९४-२०", "content_sanskrit": "सारथिः प्रवरः कृष्णः शीघ्राश्चास्य हयोत्तमाः।\nअल्पं च विवरं कृत्वा पूर्णं याति धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2052829, "chapter_id": 2167, "verse_number": "७-९४-२१", "content_sanskrit": "किं न पश्यसि बाणौघान्क्रोशमात्रे किरीटिनः।\nपश्चाद्रथस्य पतितान्क्षिप्ताञ्शीघ्रं हि गच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2052830, "chapter_id": 2167, "verse_number": "७-९४-२२", "content_sanskrit": "न ताबं शीघ्रयानेऽद्य समर्थो वयसान्वितः।\nसेनामुखे च पार्थानामेतद्बलमुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2052831, "chapter_id": 2167, "verse_number": "७-९४-२३", "content_sanskrit": "युधिष्ठिरश्च मे ग्राह्यो मिषतां सर्वधन्विनाम्।\nएवं मया प्रतिज्ञातं क्षत्रमध्ये महाभुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2052832, "chapter_id": 2167, "verse_number": "७-९४-२४", "content_sanskrit": "धनञ्जयेन चोत्सृष्टो वर्तते प्रमुखे नृप।\nतस्माद्व्यूहमुखं हित्वा नाहं यास्यामि फल्गुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2052833, "chapter_id": 2167, "verse_number": "७-९४-२५", "content_sanskrit": "तुल्याभिजनकर्माणं शत्रुमेकं सहायवान्।\nगत्वा योधय मा भैस्त्वं त्वं ह्यस्य जगतः पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2052834, "chapter_id": 2167, "verse_number": "७-९४-२६", "content_sanskrit": "राजा शूरः कृती दक्षो वैरमुत्पाद्य पाण्डवैः।\nवीरः स्वयं प्रयाह्याशु यत्र पार्थो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2052835, "chapter_id": 2167, "verse_number": "७-९४-२७x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2052836, "chapter_id": 2167, "verse_number": "७-९४-२७", "content_sanskrit": "कथं त्वामप्यतिक्रान्तः सर्वशस्त्रभृतां वरम्।\nधनञ्जयो मया शक्य आचार्य प्रतिबाधितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2052837, "chapter_id": 2167, "verse_number": "७-९४-२८", "content_sanskrit": "अपि शक्यो रणे जेतुं वज्रहस्तः पुरन्दरः।\nनार्जुनः समरे शक्यो जेतुं परपुरञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2052838, "chapter_id": 2167, "verse_number": "७-९४-२९", "content_sanskrit": "येन भोजश्च हार्दिक्यो भवांश्च त्रिदशोपमः।\nअस्त्रप्रतापेन जितौ श्रुतायुश्च निबर्हितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2052839, "chapter_id": 2167, "verse_number": "७-९४-३०", "content_sanskrit": "सुदक्षिणश्च निहतः स च राजा श्रुतायुधः।\nश्रुतायुश्चाश्रुतायुश्च भ्लेच्छाश्चायुतशो हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2052840, "chapter_id": 2167, "verse_number": "७-९४-३१", "content_sanskrit": "तं कथं पाण्डवं युद्धे दहन्तमिव पावकम्।\nप्रतियोत्स्यामि दुर्धर्षं तन्ममाचक्ष्व सत्तम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2052841, "chapter_id": 2167, "verse_number": "७-९४-३२", "content_sanskrit": "क्षमं चेन्मन्यसे युद्धं मम तेनाद्य शाधि माम्।\nपरवानस्मि भवतः प्रेष्यवद्रक्ष मे यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2052842, "chapter_id": 2167, "verse_number": "७-९४-३३x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2052843, "chapter_id": 2167, "verse_number": "७-९४-३३", "content_sanskrit": "सत्यं वदसि कौरव्य दुराधर्षो धनञ्जयः।\nअहं तु तत्करिष्यामि यथैनं प्रसहिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2052844, "chapter_id": 2167, "verse_number": "७-९४-३४", "content_sanskrit": "अद्भुतं चाद्य पश्यन्तु लोके सर्वधनुर्धराः।\nविषक्तं त्वयि कौन्तेयं वासुदेवस्य पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2052845, "chapter_id": 2167, "verse_number": "७-९४-३५", "content_sanskrit": "एष ते कवचं राजंस्तथा बध्नामि काञ्चनम्।\nयथा न बाणा नास्त्राणि प्रहरिष्यन्ति ते रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2052846, "chapter_id": 2167, "verse_number": "७-९४-३६", "content_sanskrit": "यदि त्वां सासुरसुराः सयक्षोरगराक्षसाः।\nयोधयन्ति त्रयो लोकाः सनरा नास्ति ते भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2052847, "chapter_id": 2167, "verse_number": "७-९४-३७", "content_sanskrit": "न कृष्णो न च कौन्तेयो न चान्यः शस्त्रभृद्रणे।\nशरानर्पयितुं कश्चित्कवचे तव शक्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2052848, "chapter_id": 2167, "verse_number": "७-९४-३८", "content_sanskrit": "स त्वं कवचमास्थाय क्रुद्धमद्य रणेऽर्जुनम्।\nत्वरमाणः स्वयं याहि न त्वाऽसौ विषहिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2052849, "chapter_id": 2167, "verse_number": "७-९४-३९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2052850, "chapter_id": 2167, "verse_number": "७-९४-३९", "content_sanskrit": "एवमुक्त्वा त्वरन्द्रोणः स्पृष्ट्वाम्भो वर्म भास्वरम्।\nआबबन्धाद्भुततमं जपन्मन्त्रं यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2052851, "chapter_id": 2167, "verse_number": "७-९४-४०", "content_sanskrit": "रणे तस्मिन्सुमहति विजयस्य सुतस्य ते।\nविसिष्मापयिषुर्लोकान्विद्यया ब्रह्मवित्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2052852, "chapter_id": 2167, "verse_number": "७-९४-४१x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2052853, "chapter_id": 2167, "verse_number": "७-९४-४१", "content_sanskrit": "करोतु स्वस्ति ते ब्रह्मा स्वस्ति कुर्वन्तु ब्राह्मणाः।\nसरीसृपाश्च ये श्रेष्ठास्तेभ्यस्ते स्वस्ति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2052854, "chapter_id": 2167, "verse_number": "७-९४-४२", "content_sanskrit": "ययातिर्नहुषश्चैव धुन्धुमारो भगीरथः।\nतुभ्यं राजर्षयः सर्वे स्वस्ति कुर्वन्तु ते सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2052855, "chapter_id": 2167, "verse_number": "७-९४-४३", "content_sanskrit": "स्वस्ति तेऽस्त्वेकपादेभ्यो बहुपादेभ्य एव च।\nस्वस्त्यस्त्वपादकेभ्यश्च नित्यं तव महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2052856, "chapter_id": 2167, "verse_number": "७-९४-४४", "content_sanskrit": "स्वाहा स्वधा शची चैव स्वस्ति कुर्वन्तु ते सदा।\nलक्ष्मीररुन्धती चैव कुरुतां स्वस्ति तेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2052857, "chapter_id": 2167, "verse_number": "७-९४-४५", "content_sanskrit": "अमितो देवलश्चैव विश्वामित्रस्तथाङ्गिराः।\nवसिष्ठः कश्यपश्चैव स्वस्ति कुर्वन्तु ते नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2052858, "chapter_id": 2167, "verse_number": "७-९४-४६", "content_sanskrit": "धाता विधाता लोकेशो दिशश्च सदिगीश्वराः।\nस्वस्ति तेऽद्य प्रयच्छन्तु कार्तिकेयश्च षण्मुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2052859, "chapter_id": 2167, "verse_number": "७-९४-४७", "content_sanskrit": "`येन देवाः सकृद्भग्नाः सङ्ग्रमे तारकामये।\nधृताः स च हतः शूरो ह्यवध्यो देवतागणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2052860, "chapter_id": 2167, "verse_number": "७-९४-४८", "content_sanskrit": "विवस्वान्कुरुतां स्वस्ति तथा वैवस्वतो यमः।\nपार्षिदा वशगा यस्य स्वस्ति तुभ्यं प्रयच्छतु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2052861, "chapter_id": 2167, "verse_number": "७-९४-४९", "content_sanskrit": "दिग्गजाश्चैव चत्वारः क्षितिश्च गगनं ग्रहाः।\n`दिशश्च विदिशश्चैव सिद्धा लोकहिते रताः।\nस्वस्ति कुर्वन्तु ते नित्यं मन्त्रेणानेन रस्तुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2052862, "chapter_id": 2167, "verse_number": "७-९४-५०", "content_sanskrit": "अधस्ताद्धरणीं योऽसौ सदा धारयते नृप।\nशेषश्च पन्नगश्रेष्ठः स्वस्ति तुभ्यं प्रयच्छतु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2052863, "chapter_id": 2167, "verse_number": "७-९४-५१", "content_sanskrit": "गान्धारे युधि विक्रम्य निर्जिते पाकशासनेः।\nपुरा वृत्रेण दैत्येन भिन्नदेहाः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2052864, "chapter_id": 2167, "verse_number": "७-९४-५२", "content_sanskrit": "हृततेजोबलाः स्रवे तदा सेन्द्रा दिवौकसः।\nब्रह्माणं शरणं जग्मुर्वृत्राद्भीतां महासुरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2052865, "chapter_id": 2167, "verse_number": "७-९४-५३x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2052866, "chapter_id": 2167, "verse_number": "७-९४-५३", "content_sanskrit": "प्रमार्दितानां वृत्रेण देवानां देवसत्तम।\nगतिर्भव सुरश्रेष्ठ त्राहि नो महतो भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2052867, "chapter_id": 2167, "verse_number": "७-९४-५४", "content_sanskrit": "अथ पार्श्वे स्थितं विष्णुं शक्रादींश्च सुरोत्तमान्।\nप्राह पथ्यमिदं वाक्यं विषण्णान्सुरसत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2052868, "chapter_id": 2167, "verse_number": "७-९४-५५", "content_sanskrit": "रक्ष्या मे सततं देवाः सहेन्द्राः सद्विजातयः।\nत्वष्टुः सुदुर्धरं तेजो येन वृत्रो विनिर्मितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2052869, "chapter_id": 2167, "verse_number": "७-९४-५६", "content_sanskrit": "त्वष्ट्रा पुरा तपस्तप्त्वा वर्षायुतशतं तदा।\nवृत्रो विनिर्मितो देवाः प्राप्यानुज्ञां महेश्वरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2052870, "chapter_id": 2167, "verse_number": "७-९४-५७", "content_sanskrit": "शंकरस्य प्रसादाद्वै हन्याद्देवरिपुर्बली।\nनागत्वा शंकरस्थानं भगवान्दृश्यते हरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2052871, "chapter_id": 2167, "verse_number": "७-९४-५८", "content_sanskrit": "दृष्ट्वा जेष्यथ वृत्रं तं क्षिप्रं गच्छत मन्दरम्।\nयत्रास्ते तपसां योनिर्दक्षयज्ञविनाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2052872, "chapter_id": 2167, "verse_number": "७-९४-५९", "content_sanskrit": "पिनाकी सर्वभूतेशो भगनेत्रनिपातनः।\nते गत्वा सहिता देवा ब्रह्मणा सह मन्दरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2052873, "chapter_id": 2167, "verse_number": "७-९४-६०", "content_sanskrit": "अपश्यंस्तेजसां राशिं सूर्यकोटिसमप्रभम्।\nसोऽब्रवीत्स्वागतं देवा ब्रूत किं करवाण्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2052874, "chapter_id": 2167, "verse_number": "७-९४-६१", "content_sanskrit": "अमोघं दर्शनं मह्यं कामप्राप्तिरतोऽस्तु वः।\nएवमुक्तास्तु ते सर्वे प्रत्युचूस्तं दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2052875, "chapter_id": 2167, "verse_number": "७-९४-६२", "content_sanskrit": "हृतौजसां नो वृत्रेण गतिर्भव दिवौकसाम्।\nमूर्तीरीक्षस्व नो देव प्रहारैर्जर्जरीकृताः।\nशरणं त्वां प्रपन्नाः स्म गतिर्भव महेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2052876, "chapter_id": 2167, "verse_number": "७-९४-६३", "content_sanskrit": "शर्वे उवाच।\nविदितं वो यथा देवाः कृत्येयं सुमहाबला।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2052877, "chapter_id": 2167, "verse_number": "७-९४-६४", "content_sanskrit": "त्वष्टुस्तेजोभवा घोरा दुर्निवार्याऽकृतात्मभिः॥\nअवश्यं तु मया कार्यं साह्यं सर्वदिवौकसाम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2052878, "chapter_id": 2167, "verse_number": "७-९४-६५", "content_sanskrit": "ममेदं गात्रजं शक्र कवचं गृह्य भास्वरम्॥\nबधानानेन मन्त्रेण मानसेन सुरेश्वर।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2052879, "chapter_id": 2167, "verse_number": "७-९४-६६", "content_sanskrit": "वधायासुरमुख्यस्य वृत्रस्य सुरघातिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2052880, "chapter_id": 2167, "verse_number": "७-९४-६६x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2052881, "chapter_id": 2167, "verse_number": "७-९४-६६", "content_sanskrit": "इत्युक्त्वा वरदः प्रादाद्वर्म तन्मन्त्रमेव च।\nस तेन वर्मणा गुप्तः प्रायाद्वृत्रचमूं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2052882, "chapter_id": 2167, "verse_number": "७-९४-६७", "content_sanskrit": "नानाविधैश्च शस्त्रौघैः पात्यमानैर्महारणे।\nन सन्धिः शक्यते भेत्तुं वर्मबन्धस्य तस्य तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2052883, "chapter_id": 2167, "verse_number": "७-९४-६८", "content_sanskrit": "स तेन वर्मणा गुप्तो वृत्रं देवरिपुं तदा।\nजघान समरेऽभीतः शक्रो देवाग्रणीस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2052884, "chapter_id": 2167, "verse_number": "७-९४-६९", "content_sanskrit": "तं च मन्त्रमयं बन्धं वर्म चाङ्गिरसे ददौ।\nअङ्गिराः प्राह पुत्रस्य मन्त्रज्ञस्य बृहस्पतेः।\nबृहस्पतिरथोवाच अग्निवेश्याय धीमते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2052885, "chapter_id": 2167, "verse_number": "७-९४-७०", "content_sanskrit": "अग्निवेश्यो मम प्रादात्तेन बध्नामि वर्म ते।\nतवाह्य देहरक्षार्थं मन्त्रेण नृपसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2052886, "chapter_id": 2167, "verse_number": "७-९४-७१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2052887, "chapter_id": 2167, "verse_number": "७-९४-७१", "content_sanskrit": "एवमुक्त्वा ततो द्रोणस्तव पुत्रं महाद्युतिम्।\nपुनरे वचः प्राह शनैराचार्यपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2052888, "chapter_id": 2167, "verse_number": "७-९४-७२", "content_sanskrit": "ब्रह्मसूत्रेण बध्नामि कथचं तव भारत।\nहिरण्यगर्भेण यथा बद्धं विष्णोः पुरा रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2052889, "chapter_id": 2167, "verse_number": "७-९४-७३", "content_sanskrit": "यथा च ब्रह्मणा बद्धं सङ्ग्रामे तारकामये।\nशक्रस्य कवचं दिव्यं तथा बध्नाम्यहं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2052890, "chapter_id": 2167, "verse_number": "७-९४-७४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2052891, "chapter_id": 2167, "verse_number": "७-९४-७४", "content_sanskrit": "बद्धा तु कवचं तस्य मन्त्रेण विधिपूर्वकम्।\nप्रेषयामास राजानं युद्धाय महते द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2052892, "chapter_id": 2167, "verse_number": "७-९४-७५", "content_sanskrit": "स सन्नद्धो महाबाहुराचार्येण महात्मना।\n`प्रस्थितः सहसा राजन्यत्र यातो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2052893, "chapter_id": 2167, "verse_number": "७-९४-७६", "content_sanskrit": "रथानां च सहस्रेण त्रिगर्तानां प्रहारिणाम्।\nतथा दन्तिसहस्रेण मत्तानां वीर्यशालिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2052894, "chapter_id": 2167, "verse_number": "७-९४-७७", "content_sanskrit": "अश्वानां नियुतेनैव तथाऽन्यैश्च महारथैः।\nवृतः प्रायान्महाबाहुरर्जुनस्य रथं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2052895, "chapter_id": 2167, "verse_number": "७-९४-७८", "content_sanskrit": "नानावादित्रघोषेण यथा वैरोचनिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2052896, "chapter_id": 2167, "verse_number": "७-९४-७९", "content_sanskrit": "ततः शब्दो महानासीत्सैन्यानां तव भारत।\nअगाधं प्रस्थितं दृष्ट्वा समुद्रमिव कौरवम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2052897, "chapter_id": 2167, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे चतुर्नवतितमोऽध्यायः॥ ९४ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-९४-१० आतुरमनवस्पितम्॥ ५-९४-१२ नावबुध्यसे न स्मरसि॥ ५-९४-१३ नेच्छसि नानुरुध्यते॥ ५-९४-१४ वचसा ललितं सदा। हृदयेन भृशं तीक्ष्णं इति क. पाठः॥ ५-९४-३५ ते त्वाम्॥ ५-९४-४९ चत्वार ऐरावतवामनाञ्जनसार्वभौमाः॥ ५-९४-५६ अनुज्ञां वरम्॥ ५-९४-५७ हन्याद्धन्तुमर्हति॥ ५-९४-६५ मानसेन मनसोच्चारणीयेन॥ ५-९४-७२ ब्रह्मसूत्रेण ब्रह्मणा सूचितेनो पदेशेन॥ ५-९४-९४ चतुर्नवतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]