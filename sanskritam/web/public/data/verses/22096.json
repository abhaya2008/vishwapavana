[{"id": 7002096000, "chapter_id": 22096, "verse_number": "१४१-१", "content_sanskrit": "ईश्वर उवाच ।\nषट्त्रिंशत्पदसंस्थानामोषधीनां वदे फलं ।\nअमरीकरणं नृणां ब्रह्मरुद्रेन्द्रसेवितं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002096001, "chapter_id": 22096, "verse_number": "१४१-२", "content_sanskrit": "हरीतक्यक्ष्यधात्राश्च मरीचम्पिप्पलीशिफा ।\nवह्निः शुण्ठी पिप्पली च गुडूचीवचनिम्बकाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002096002, "chapter_id": 22096, "verse_number": "१४१-३", "content_sanskrit": "वासकः शतमूली च सैन्धवं सिन्धुवारकं ।\nकण्टकारी गोक्षुरका विल्वम्पौनर्नवं बला ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002096003, "chapter_id": 22096, "verse_number": "१४१-४", "content_sanskrit": "एरण्डमुण्डी रुचको भृङ्गः क्षारोऽथ पर्पटः ।\nधन्याको जीरकश्चैव शतपुष्यी जवानिका ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002096004, "chapter_id": 22096, "verse_number": "१४१-५", "content_sanskrit": "विडङ्गः खदिरश्चैव कृतमालो हरिद्रया ।\nवचा सिद्धार्थ एतानि षट्त्रिंशत्पदगानि हि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002096005, "chapter_id": 22096, "verse_number": "१४१-६", "content_sanskrit": "क्रमादेकादिसञ्ज्ञानि ह्यौपधानि महान्ति हि ।\nसर्वरोगहराणि स्युरमरीकरणानि च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002096006, "chapter_id": 22096, "verse_number": "१४१-७", "content_sanskrit": "बलीपलितभेत्तॄणि सर्वकोष्ठगतानि तु ।\nएषां चूर्णञ्च वटिका रसेन परिभाविता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002096007, "chapter_id": 22096, "verse_number": "१४१-८", "content_sanskrit": "अवलेहः कषायो वा मोदको गुडखण्डकः ।\nमधुतो धृततो वापि घृतन्तैलमथापि वा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002096008, "chapter_id": 22096, "verse_number": "१४१-९", "content_sanskrit": "सर्वात्मनोपयुक्तं हि मृतसञ्जीवनम्भवेत् ।\nकर्षार्धं कर्षमेकं वा पलार्धं पलमेककं ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002096009, "chapter_id": 22096, "verse_number": "१४१-१०", "content_sanskrit": "यथेष्टाचारनिरतो जीवेद्वर्षशतत्रयं ।\nमृतसञ्जीवनीकल्पे योगो नास्मात्परोऽस्ति हि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002096010, "chapter_id": 22096, "verse_number": "१४१-११", "content_sanskrit": "प्रथमान्नवकाद्योगात्सर्वरोगैः प्रमुच्यते ।\nद्वितीयाच्च तृतीयाच्च चतुर्थान्मुच्यते रुजः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002096011, "chapter_id": 22096, "verse_number": "१४१-१२", "content_sanskrit": "एवं षट्काच्च प्रथमाद्द्वितीयाच्च तृतीयतः ।\nचतुर्थात्पञ्चमात्षष्ठात्तथा नवचतुष्कतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002096012, "chapter_id": 22096, "verse_number": "१४१-१३", "content_sanskrit": "एकदित्रिचतुःपञ्चषट्सप्ताष्टमतोऽनिलात् ।\nअग्निभास्करषड्विंशसप्तविंशैश्च पित्ततः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002096013, "chapter_id": 22096, "verse_number": "१४१-१४", "content_sanskrit": "वाणर्तुशैलवसुभिस्तिथिभिर्मुच्यते कफात् ।\nवेदाग्निभिर्बाणगुणैः षद्गुणैः स्याद्वशे धृते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002096014, "chapter_id": 22096, "verse_number": "१४१-१५", "content_sanskrit": "ग्रहादिग्रहणान्तैश्च सर्वैरेव विमुच्यते ।\nएकद्वित्रिरसैः शैलैर्वसुग्रहशिवैः क्रमात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002096015, "chapter_id": 22096, "verse_number": "१४१-१६", "content_sanskrit": "द्वात्रिंशत्तिथिसूर्यैश्च नात्र कार्या विचारणा ।\nषट्त्रिंशत्पदकज्ञानं न देयं यस्य कस्य चित् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]