[{"id": 2019690, "chapter_id": 1410, "verse_number": "३-४८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019691, "chapter_id": 1410, "verse_number": "३-४८-१", "content_sanskrit": "तेषां तच्चरितं श्रुत्वा मनुष्यातीतमद्भुतम्।\nचिन्ताशोकपरीतात्मा मन्युनाभिपरिप्लुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019692, "chapter_id": 1410, "verse_number": "३-४८-२", "content_sanskrit": "दीर्घमुष्णं च निःश्वस्य धृतराष्ट्रोऽम्बिकासुतः।\nअब्रवीत्संजयं सूतमामन्त्र्य भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019693, "chapter_id": 1410, "verse_number": "३-४८-३", "content_sanskrit": "न रात्रौ न दिवा सूत शान्तिं प्राप्नोमि वैक्षणम्।\nसंचिन्त्य दुर्णयं घोरमतीतं द्यूतजं हि तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019694, "chapter_id": 1410, "verse_number": "३-४८-४", "content_sanskrit": "तेषामसह्यवीर्याणां शौर्यं धैर्यं धृतिं पराम्।\nअन्योन्यमनुरागं च भ्रातॄणामतिमानुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019695, "chapter_id": 1410, "verse_number": "३-४८-५", "content_sanskrit": "देवपुत्रौ महाभागौ देवराजसमद्युती।\nनकुलः सहदेवश्च पाण्डवौ युद्धदुर्मदौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019696, "chapter_id": 1410, "verse_number": "३-४८-६", "content_sanskrit": "दृढायुधौ दूरपातौ युद्धे च कृतनिश्चयौ।\nशीघ्रहस्तौ दृढक्रोधौ नित्ययुक्तौ रथे स्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019697, "chapter_id": 1410, "verse_number": "३-४८-७", "content_sanskrit": "भीमार्जुनौ पुरोधाय यदा तौ रणमूर्धनि।\nस्थास्येते सिंहविक्रान्तावश्विनाविव दुःसहौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019698, "chapter_id": 1410, "verse_number": "३-४८-८", "content_sanskrit": "निःशेषमिह पश्यामि मम सैन्यस्य संजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019699, "chapter_id": 1410, "verse_number": "३-४८-९", "content_sanskrit": "तौ ह्यप्रतिरथौ युद्धे देवपुत्रौ महारथौ।\nद्रौपद्यास्तं परिक्लेशं न क्षंस्येतेऽत्यमर्षिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019700, "chapter_id": 1410, "verse_number": "३-४८-१०", "content_sanskrit": "वृष्णयोऽथ महेष्वासाः पाञ्चाला वा महौजसः।\nयुधि सत्याभिसन्धेन वासुदेवेन रक्षिताः।\nप्रधक्ष्यन्ति रणे पार्थाः पुत्राणां मम वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019701, "chapter_id": 1410, "verse_number": "३-४८-११", "content_sanskrit": "रामकृष्णप्रणीतानां वृष्णीनां सूतनन्दन।\nन शक्यः सहितुं वेगः पर्वतैरपि दुःसहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019702, "chapter_id": 1410, "verse_number": "३-४८-१२", "content_sanskrit": "तेषां मध्ये महेष्वासो भीमो भीमपराक्रमः।\nशैक्यया वीरघातिन्या गदया विचरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019703, "chapter_id": 1410, "verse_number": "३-४८-१३", "content_sanskrit": "तथा गाण्डीवनिर्घोषं विस्फूर्जितमिवाशनेः।\nगदावेगं च भीमस्य नालं सोढुं नराधिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019704, "chapter_id": 1410, "verse_number": "३-४८-१४", "content_sanskrit": "ततोऽहं सुहृदां वाचो दुर्योधनवशानुगः।\nस्मरणीयाः स्मरिष्यामि मया या न कृताः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019705, "chapter_id": 1410, "verse_number": "३-४८-१५x", "content_sanskrit": "संजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019706, "chapter_id": 1410, "verse_number": "३-४८-१५", "content_sanskrit": "व्यतिक्रमोऽयं सुमहांस्त्वया राजन्नुपेक्षितः।\nसमर्थेनापि यन्मोहात्पुत्रस्ते न निवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019707, "chapter_id": 1410, "verse_number": "३-४८-१६", "content_sanskrit": "श्रुत्वाऽयं निर्जितान्द्यूते पाण्डवान्मधुसूदनः।\nत्वरितः कामय्के पार्थान्समभावयदच्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019708, "chapter_id": 1410, "verse_number": "३-४८-१७", "content_sanskrit": "द्रुपदस्य तथा पुत्रा धृष्टद्युम्नपुरोगमाः।\nविराटो धृष्टकेतुश्च केकयाश्च महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019709, "chapter_id": 1410, "verse_number": "३-४८-१८", "content_sanskrit": "तैश्च यत्कथितं राजन्दृष्ट्वा पार्थान्पराजितान्।\nचारेण विदितं सर्वं तन्मया वेदितं च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019710, "chapter_id": 1410, "verse_number": "३-४८-१९", "content_sanskrit": "समागम्य वृतस्तत्र पाण्डवैर्मधुसूदनः।\nसारथ्ये फल्गुनस्याजौ तथेत्याह च तान्हरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019711, "chapter_id": 1410, "verse_number": "३-४८-२०", "content_sanskrit": "अमर्षितो हि कृष्णोपि दृष्ट्वा पार्थांस्तदा गतान्।\nकृष्णाजिनोत्तरासङ्गानब्रवीच्च युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019712, "chapter_id": 1410, "verse_number": "३-४८-२१", "content_sanskrit": "या सा समृद्धिः पार्थानामिन्द्रप्रस्थे बभूव ह।\nराजसूये मया दृष्टा नृपैरन्यैः सुदुर्लभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019713, "chapter_id": 1410, "verse_number": "३-४८-२२", "content_sanskrit": "यत्रसर्वान्महीपालाञ्शस्त्रतेजोभयार्दितान्।\nसवङ्गाङ्गान्सपौण्ड्रौढ्रान्सचोलद्रविडान्ध्रकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019714, "chapter_id": 1410, "verse_number": "३-४८-२३", "content_sanskrit": "सागरानूपकांश्चैव ये च पत्तनवासिनः।\nसिंहलान्बर्बरान्म्लेच्छान्ये च लङ्कानिवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019715, "chapter_id": 1410, "verse_number": "३-४८-२४", "content_sanskrit": "पश्चिमानि चराष्ट्राणि शतशः सागरान्तिकान्।\nपह्लवान्दरदान्सर्वान्किरातान्यवनाञ्शकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019716, "chapter_id": 1410, "verse_number": "३-४८-२५", "content_sanskrit": "हारहूणांश्च चीनांश्च तुषारान्सैन्धवांस्तथा।\nजागुडान्रामठान्मुण्डान्स्त्रीराज्यमथ तङ्गणान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019717, "chapter_id": 1410, "verse_number": "३-४८-२६", "content_sanskrit": "केकयान्मालवांश्चैव तथा काश्मीरकानपि।\nअद्राक्षमहमाहूतान्यज्ञे ते परिवेषकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019718, "chapter_id": 1410, "verse_number": "३-४८-२७", "content_sanskrit": "सा ते समृद्धिर्यैरात्ता चपला प्रतिसारिणी।\nआदाय जीवितं तेषामाहरिष्यामि तामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019719, "chapter_id": 1410, "verse_number": "३-४८-२८", "content_sanskrit": "रामेण सह कौरव्य भीमार्जुनवयैस्तथा।\nअक्रूरगदसाम्बैश्च प्रद्युम्नेनाहुकेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019720, "chapter_id": 1410, "verse_number": "३-४८-२९", "content_sanskrit": "धृष्टद्युम्नेन वीरेण शिशुपालात्मजेन च।\nदुर्योधनं रणे हत्वा सद्यः कर्णं च भारत।\nदुःशासनं सौबलेयं यश्चान्यः प्रतियोत्स्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019721, "chapter_id": 1410, "verse_number": "३-४८-३०", "content_sanskrit": "ततस्त्वं हास्तिनपुरे भ्रातृभिः सहितो वसन्।\nधार्तराष्ट्रीं श्रियं प्राप्य प्रशाधि पृथिवीमिमां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019722, "chapter_id": 1410, "verse_number": "३-४८-३१", "content_sanskrit": "अथैनमब्रवीद्राजा तस्मिन्वीरसमागमे।\nशृण्वत्स्वेतेषु वीरेषु धृष्टद्युम्नमुखेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019723, "chapter_id": 1410, "verse_number": "३-४८-३२", "content_sanskrit": "प्रतिगृह्णामि ते वाचमिमां सत्यां जनार्दन।\nअमित्रान्मे महाबाहो सानुबन्धान्हनिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019724, "chapter_id": 1410, "verse_number": "३-४८-३३", "content_sanskrit": "वर्षात्रयोदशादूर्ध्वं सत्यं मां कुरु केशव।\nप्रतिज्ञातो वने वासो राज्ञांमध्ये मया ह्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2019725, "chapter_id": 1410, "verse_number": "३-४८-३४", "content_sanskrit": "धर्मराजस्य वचनं प्रतिश्रुत्य सभासदः।\nधृष्टद्युम्नपुरोगास्ते समयामासुऱञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2019726, "chapter_id": 1410, "verse_number": "३-४८-३५", "content_sanskrit": "केशवं मधुरैर्वाक्यैः कालयुक्तैरमर्षितम्।\nपाञ्चालीं प्राहुरक्लिष्टां वासुदेवस्य शृण्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2019727, "chapter_id": 1410, "verse_number": "३-४८-३६", "content_sanskrit": "दुर्योधनस्तव क्रोधाद्देवि त्यक्ष्यति जीवितम्।\nप्रतिजानीम ते सत्यं मा शुचो वरवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2019728, "chapter_id": 1410, "verse_number": "३-४८-३७", "content_sanskrit": "ये स्म ते कुरवः कृष्णे दृष्ट्वा त्वां प्राहसंस्तदा।\nमांसानि तेषां खादन्तो हरिष्यन्ति वृकद्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2019729, "chapter_id": 1410, "verse_number": "३-४८-३८", "content_sanskrit": "पास्यन्ति रुधिरं तेषां गृध्रा गोमायवस्तथा।\nउत्तमाङ्गानि कर्षन्तो यैः कृष्टाऽसि सभातले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2019730, "chapter_id": 1410, "verse_number": "३-४८-३९", "content_sanskrit": "तेषां द्रक्ष्यसि पाञ्चालि गात्राणि पृथिवीतले।\nक्रव्यादैः कृष्यमाणानि भक्ष्यमाणानि चासकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2019731, "chapter_id": 1410, "verse_number": "३-४८-४०", "content_sanskrit": "परिक्लिष्टाऽसियैस्तत्रयैश्चासि समुपेक्षिता।\nतेषामुत्कृत्तशिरसां भूमिः पास्यति शोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2019732, "chapter_id": 1410, "verse_number": "३-४८-४१", "content_sanskrit": "एवं बहुविधा वाचस्त ऊचुः पुरुषर्षभाः।\nसर्वेतेजस्विनः शूराः सर्वेचाहतलक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2019733, "chapter_id": 1410, "verse_number": "३-४८-४२", "content_sanskrit": "ते धर्मराजेन वृतावर्षादूर्ध्वं त्रयोदशात्।\nपुरस्कृत्योपयास्यन्ति वासुदेवं महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2019734, "chapter_id": 1410, "verse_number": "३-४८-४३", "content_sanskrit": "रामश्च कृष्णश्च धनंजयश्च\nप्रद्युम्नसाम्बौ युयुधानभीमौ।\nमाद्रीसुतौ केकयराजपुत्राः\nपाञ्चालपुत्राः सह मत्स्यराज्ञा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2019735, "chapter_id": 1410, "verse_number": "३-४८-४४", "content_sanskrit": "एतान्सर्वाल्लोँकवीरानजेया-\nन्महात्मनः सानुबन्धान्ससैन्यान्।\nको जीवितार्थी समरेऽभ्युदीया-\nत्क्रुद्धान्सिंहान्केसरिणो यथैव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2019736, "chapter_id": 1410, "verse_number": "३-४८-४५x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2019737, "chapter_id": 1410, "verse_number": "३-४८-४५", "content_sanskrit": "यन्माऽब्रवीद्विदुरो द्यूतकाले\nत्वं पाण्डवाञ्जेषय्सि चेन्नरेन्द्र।\nध्रुवं कुरूणामयमन्तकालो\nमहाभयो भविता शोणितौधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2019738, "chapter_id": 1410, "verse_number": "३-४८-४६", "content_sanskrit": "मन्ये यथा तद्भवितेति सूत\nयथा क्षत्ता प्राह वचः पुरा माम्।\nअसंशयं भविता युद्धमेत-\nद्गते काले पाण्डवानां यथोक्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2019739, "chapter_id": 1410, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि इन्द्रलोकाभिगमनपर्वणि अष्टचत्वारिंशोऽध्यायः ॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]