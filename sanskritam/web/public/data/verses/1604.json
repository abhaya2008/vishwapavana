[{"id": 2028035, "chapter_id": 1604, "verse_number": "३-२४२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028036, "chapter_id": 1604, "verse_number": "३-२४२-१", "content_sanskrit": "ततस्ते सहिताः सर्वे दुर्याधनमुपागमन्।\nअब्रुवंश्च महाराज यदूचुः कौरवं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028037, "chapter_id": 1604, "verse_number": "३-२४२-२", "content_sanskrit": "गन्धर्वैर्वारिते सैन्ये धार्तराष्ट्रः प्रतापवान्।\nअमर्षपूर्णः सैन्यानि प्रत्यभाषत भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028038, "chapter_id": 1604, "verse_number": "३-२४२-३", "content_sanskrit": "शासतैनानधर्मज्ञान्मम विप्रियकारिणः।\nयदि प्रक्रीडते सर्वैर्देवैः सह शचीपतिः।\n`वयमत्र यथा प्रीता क्रीडिष्यामो निरङ्कुशं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028039, "chapter_id": 1604, "verse_number": "३-२४२-४", "content_sanskrit": "दुर्योधनवचः श्रुत्वा धार्तराष्ट्रा महाबलाः।\nसर्व एवाभिसन्नद्धा योधाश्चापि सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028040, "chapter_id": 1604, "verse_number": "३-२४२-५", "content_sanskrit": "ततः प्रमथ्य सर्वांस्तांस्तद्वनं विविशुर्बलात्।\nसिंहनादेन महता पूरयन्तो दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028041, "chapter_id": 1604, "verse_number": "३-२४२-६", "content_sanskrit": "ततोऽपरैरवार्यन्त गन्धर्वैः कुरुसैनिकाः।\n`साम्नैव रतत्र विक्रान्ता मा साहसमिति प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028042, "chapter_id": 1604, "verse_number": "३-२४२-७", "content_sanskrit": "ते वार्यमाणा गन्धर्वैः साम्नैव वसुधायिप।\nताननादृत्य गन्धर्वांस्तद्वनं विविशुर्महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028043, "chapter_id": 1604, "verse_number": "३-२४२-८", "content_sanskrit": "यदि वाता न तिष्ठन्ति धार्तराष्ट्राः सराजकाः।\nततस्ते खेचराः सर्वे चित्रसेने न्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028044, "chapter_id": 1604, "verse_number": "३-२४२-९", "content_sanskrit": "गन्धर्वराजस्तान्सर्वानब्रवीत्कौरवान्प्रति।\nअनार्याञ्शासतेत्येतांश्चित्रसेनोऽत्यमर्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028045, "chapter_id": 1604, "verse_number": "३-२४२-१०", "content_sanskrit": "अनुज्ञाताश्च गन्धर्वाश्चित्रसेनेन भारत।\nप्रगृहीतायुधाः सर्वे धार्तराष्ट्रानभिद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028046, "chapter_id": 1604, "verse_number": "३-२४२-११", "content_sanskrit": "तान्दृष्ट्वाऽऽपततः शीघ्रान्गन्धर्वानुद्यतायुधान्।\nप्राद्रवंस्ते दिशः सर्वे धार्तराष्ट्रस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028047, "chapter_id": 1604, "verse_number": "३-२४२-१२", "content_sanskrit": "तान्दृष्ट्वा द्रवतः सर्वान्धार्तराष्ट्रान्पराङ्मुखान्।\nराधेयस्तु तदा वीरो नासीत्तत्रपराङ्मुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028048, "chapter_id": 1604, "verse_number": "३-२४२-१३", "content_sanskrit": "आपतन्तीं तु संप्रेक्ष्य गन्धर्वाणां महाचमूम्।\nमहता शरवर्षेण राधेयः प्रत्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028049, "chapter_id": 1604, "verse_number": "३-२४२-१४", "content_sanskrit": "क्षुरप्रैर्विशिखैर्भल्लैर्वत्सदन्तैस्तथाऽऽयसैः।\nगन्धर्वाञ्शतशोऽभिघ्नँल्लघुत्वात्सूतनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028050, "chapter_id": 1604, "verse_number": "३-२४२-१५", "content_sanskrit": "पातयन्नुत्तमाङ्गानि गन्धर्वाणां महारथः।\nक्षणएन व्यधमत्सर्वां चित्रसेनस्य वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028051, "chapter_id": 1604, "verse_number": "३-२४२-१६", "content_sanskrit": "ते वध्यमाना गन्धर्वाः सूतपुत्रेण धीमता।\nभूय एवाभ्यवर्तन्त शततशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028052, "chapter_id": 1604, "verse_number": "३-२४२-१७", "content_sanskrit": "गन्धर्वभूता पृथिवी क्षणेन समपद्यत।\nआपतद्भिर्महावेगैश्चित्रसेनस्य सैनिकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028053, "chapter_id": 1604, "verse_number": "३-२४२-१८", "content_sanskrit": "अथ दुर्योधनो राजा शकुनिश्चापि सौबलः।\nदुःशासनो विकर्णश्च ये चान्ये धृतराष्ट्रजाः।\nन्यहनंस्तत्तदा सैन्यं रथैर्गरुडनिःखनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028054, "chapter_id": 1604, "verse_number": "३-२४२-१९", "content_sanskrit": "सैन्यमायोधितं दृष्ट्वाकर्णो राजन्न मृष्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028055, "chapter_id": 1604, "verse_number": "३-२४२-२०", "content_sanskrit": "महता रथसङ्घेन रथचारेण चाप्युत।\nवैकर्तनं परीप्सन्तो गन्धर्वाः प्रत्यवारयन्।\nततः संन्यपतन्सर्वे गन्धर्वाः कौरवं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028056, "chapter_id": 1604, "verse_number": "३-२४२-२१", "content_sanskrit": "तदा सुतुमुलं युद्धमभवद्रोमहर्षणम्।\nततस्ते मृदवोऽभूवनगन्धर्वाः शरपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028057, "chapter_id": 1604, "verse_number": "३-२४२-२२", "content_sanskrit": "उच्चुक्रुशुश्च कौरव्यागन्धर्वान्प्रेक्ष्य पीडितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028058, "chapter_id": 1604, "verse_number": "३-२४२-२३", "content_sanskrit": "गन्धर्वांस्त्रासितान्दृष्ट्वा चित्रसेनो ह्यमर्षणः।\nउत्पपातासनात्क्रुद्धो वधे तेषां समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028059, "chapter_id": 1604, "verse_number": "३-२४२-२४", "content_sanskrit": "ततो मायास्त्रमास्थाय युयुधे चित्रमार्गवित्।\n`वियत्संछादयामास न ववौ तत्र मारुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028060, "chapter_id": 1604, "verse_number": "३-२४२-२५", "content_sanskrit": "हस्त्यारोहा हताः पेतुर्हस्तिभिः सह भारत।\nहयारोहाः सह हयै रथैश्च रथिनस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028061, "chapter_id": 1604, "verse_number": "३-२४२-२६", "content_sanskrit": "पत्तयश्च तथापेतुर्विशस्ताः शरवृष्टिभिः।\nतयाऽमुह्यन्त कौरव्याश्चित्रसेनस्य मायया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028062, "chapter_id": 1604, "verse_number": "३-२४२-२७", "content_sanskrit": "एकैको हि तदा योधो धार्तारष्ट्रस्य भारत।\nपर्यवार्यत गन्धर्वैर्दशभिर्दशभिर्युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028063, "chapter_id": 1604, "verse_number": "३-२४२-२८", "content_sanskrit": "ततः संपीड्यमानास्ते बलेन महता तदा।\nप्राद्रवन्त रणे भीता यत्रराजा युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028064, "chapter_id": 1604, "verse_number": "३-२४२-२९", "content_sanskrit": "भज्यमानेष्वनीकेषु धार्तराष्ट्रेषु सर्वशः।\nकर्णो वैकर्तनो राजंस्तस्थौ गिरिरिवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028065, "chapter_id": 1604, "verse_number": "३-२४२-३०", "content_sanskrit": "दुर्योधनश्च तेजस्वी शकुनिश्चापि सौबलः।\nगन्धर्वान्योधयामासुः समरे भृशविक्षताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028066, "chapter_id": 1604, "verse_number": "३-२४२-३१", "content_sanskrit": "सर्व एव तु गन्धर्वाः शतशोऽथ सहस्रशः।\nजिघांसमानाः संरब्धाः कर्णमभ्यद्रवत्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028067, "chapter_id": 1604, "verse_number": "३-२४२-३२", "content_sanskrit": "असिभिः पट्टसैः शूलैर्गदाभिश्च महाबलाः।\nसूतपुत्रं जिघांसन्तः समन्तात्पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2028068, "chapter_id": 1604, "verse_number": "३-२४२-३३", "content_sanskrit": "अन्येऽस्य युगमच्छिन्दन्ध्वजमन्ये न्यपातयन्।\nईषामन्ये हयानन्ये सूतमन्ये न्यपातयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2028069, "chapter_id": 1604, "verse_number": "३-२४२-३४", "content_sanskrit": "अन्ये च्छत्रं वरूथं च बन्धुरं च तथा परे।\n`अन्ये संचूर्णयामासुश्छत्रे चाक्षौ तथा परे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2028070, "chapter_id": 1604, "verse_number": "३-२४२-३५", "content_sanskrit": "गन्धर्वा बहुसाहस्रास्तिलशो व्यधमन्रथम् ॥\nततो रथादवप्लुत्य सूतपुत्रोऽसिचर्मभृत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2028071, "chapter_id": 1604, "verse_number": "३-२४२-३६", "content_sanskrit": "`अंसावलम्बितधनुर्धावमानो महाबलः।\nविकर्णरथमास्थाय मोक्षायाश्वानचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2028072, "chapter_id": 1604, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि द्विचत्वारिंशदधिकद्विशततमोऽध्यायः ॥ २४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]