[{"id": 2042684, "chapter_id": 1954, "verse_number": "६-३-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042685, "chapter_id": 1954, "verse_number": "६-३-१", "content_sanskrit": "खरा गोषु प्रजायन्ते रमन्ते मातृभिः सुताः।\nअनार्तवं पुष्पफलं दर्शयन्ति वनद्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042686, "chapter_id": 1954, "verse_number": "६-३-२", "content_sanskrit": "गर्भिण्योऽजातपुत्राश्च जनयन्ति विभीषणान् ।\nक्रव्यादाः पक्षिभिश्चापि सहा श्नन्ति परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042687, "chapter_id": 1954, "verse_number": "६-३-३", "content_sanskrit": "त्रिविषाणाश्चतुर्नेत्राः पञ्चपादा द्विमेहनाः ।\nद्विशीर्षाश्च द्विपुच्छाश्च दंष्ट्रिणः पशवोऽशिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042688, "chapter_id": 1954, "verse_number": "६-३-४", "content_sanskrit": "जायन्ते विवृतास्याश्च व्याहरन्तोऽशिवा गिरः ।\nत्रिपदाः शिखिनस्तार्क्ष्याश्चतुर्दंष्ट्रा विषाणिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042689, "chapter_id": 1954, "verse_number": "६-३-५", "content_sanskrit": "तथैवान्याश्च दृश्यन्ते स्त्रियो वै ब्रह्मवादिनाम् ।\nवैनतेयान्मयूरांश्च जनयन्ति पुरे तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042690, "chapter_id": 1954, "verse_number": "६-३-६", "content_sanskrit": "गोवत्सं वडवा सूते श्वा सृगालं महीपते ।\nकुक्कुरान्करभाश्चैव शुकाश्चाशुवादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042691, "chapter_id": 1954, "verse_number": "६-३-७", "content_sanskrit": "स्त्रियः काश्चित्प्रजायन्ते चतस्रः पञ्च कन्यकाः ।\nजातमात्राश्च नृत्यन्ति गायन्त च हसन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042692, "chapter_id": 1954, "verse_number": "६-३-८", "content_sanskrit": "पृथग्जनस्य सर्वस्य क्षुद्रकाः प्रहसन्ति च।\nनृत्यन्ति परिगायन्ति वेदयन्तो महद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042693, "chapter_id": 1954, "verse_number": "६-३-९", "content_sanskrit": "प्रतिमाश्चालिखन्त्येताः सशस्त्राः कालचोदिताः ।\nअन्योन्यमभिधावन्ति शिशवो दण्डपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042694, "chapter_id": 1954, "verse_number": "६-३-१०", "content_sanskrit": "अन्योन्यमभिमृद्गन्ति नगराणि युयुत्सवः ।\nपद्मोत्पलानि वृक्षेषु जायन्ते कुमुदानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042695, "chapter_id": 1954, "verse_number": "६-३-११", "content_sanskrit": "विष्व्वाताश्च वान्त्युग्रा रजो नाप्युपशाम्यति।\nअभीक्ष्णं कम्पते भूमिरर्कं राहुरुपैति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042696, "chapter_id": 1954, "verse_number": "६-३-१२", "content_sanskrit": "श्वेतो ग्रहस्तथा चित्रां समतिक्रम्य तिष्ठति ।\nअभावं हि विशेषेण कुरूणां तत्र पश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042697, "chapter_id": 1954, "verse_number": "६-३-१३", "content_sanskrit": "धूमकेतुर्महाघोरः पुष्यं चाक्रम्य तिष्ठति ।\nसेनयोरशिवं घोरं करिष्यति महाग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042698, "chapter_id": 1954, "verse_number": "६-३-१४", "content_sanskrit": "मघास्वङ्गारको वक्रः श्रवणे च बृहस्पतिः ।\nभगं नक्षत्रमाक्रम्य सूर्यपुत्रेण पीड्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042699, "chapter_id": 1954, "verse_number": "६-३-१५", "content_sanskrit": "शुक्रः प्रोष्ठपदे पूर्वे समारुह्य विरोचते ।\nउत्तरे तु परिक्रम्य सहितः समुदीक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042700, "chapter_id": 1954, "verse_number": "६-३-१६", "content_sanskrit": "श्यामो ग्रहः प्रज्वलितः सधूम इव पावकः ।\nऐन्द्रं तेजस्वि नक्षत्रं ज्येष्ठामाक्रम्य तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042701, "chapter_id": 1954, "verse_number": "६-३-१७", "content_sanskrit": "ध्रुवं प्रज्वलितो घोरमपसव्यं प्रवर्तते ।\nरोहिणीं पीडयत्येवमुभौ च शशिभास्करो ।\nचित्रास्वात्यन्तरे चैव विष्ठितः परुषग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042702, "chapter_id": 1954, "verse_number": "६-३-१८", "content_sanskrit": "वक्रानुवक्रं कृत्वा च श्रवणं पावकप्रभः ।\nब्रह्मराशिं समावृत्य लोहिताङ्गो व्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042703, "chapter_id": 1954, "verse_number": "६-३-१९", "content_sanskrit": "सर्वसस्यपरिच्छन्ना पृथिवी सस्यमालिनी ।\nपञ्चशीर्षा यवाश्चापि शतशीर्षाश्च शालयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042704, "chapter_id": 1954, "verse_number": "६-३-२०", "content_sanskrit": "प्रधानाः सर्वलोकस्य यास्वायत्तमिदं जगत् ।\nता गावः प्रस्नुता वत्सैः शोणितं प्रक्षरन्त्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042705, "chapter_id": 1954, "verse_number": "६-३-२१", "content_sanskrit": "निश्चेरुरर्चिषश्चापात्खङ्गाश्च ज्वलिता भृशम् ।\nव्यक्तं पश्यन्ति शस्त्राणि संग्रामं समुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042706, "chapter_id": 1954, "verse_number": "६-३-२२", "content_sanskrit": "अग्निवर्णा यथा भासः शस्त्राणामुदकस्य च।\nकवचानां ध्वजानां च भविष्यति महाक्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042707, "chapter_id": 1954, "verse_number": "६-३-२३", "content_sanskrit": "पृथिवी शोणितावर्ता ध्वजोडुपसमाकुला ।\nकुरूणां वैशसे राजन्पाण्डवैः सह भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042708, "chapter_id": 1954, "verse_number": "६-३-२४", "content_sanskrit": "दिक्षु प्रज्वलितास्याश्च व्याहरन्ति मृगद्विजाः ।\nअत्याहितं दर्शयन्तः क्षत्रियाणां महद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2042709, "chapter_id": 1954, "verse_number": "६-३-२५", "content_sanskrit": "एकपक्षाक्षिचरणाः शकुन्ताः खेचरा निशि।\nरौद्रं वदन्ति संरब्धाः शोणितं छर्दयन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2042710, "chapter_id": 1954, "verse_number": "६-३-२६", "content_sanskrit": "ग्रहौ ताम्रारुणनिभौ प्रज्वलन्ताविव स्थितौ ।\nसप्तर्षीणामुदाराणां समवच्छाद्य वै प्रभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2042711, "chapter_id": 1954, "verse_number": "६-३-२७", "content_sanskrit": "संवत्सरस्थायिनौ च ग्रहौ प्रज्वलितावुभौ ।\nविशाखयोः समीपस्थौ बृहस्पतिशनैश्चरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2042712, "chapter_id": 1954, "verse_number": "६-३-२८", "content_sanskrit": "चन्द्रादित्यावुभौ ग्रस्तावेकाह्ना हि त्रयोदशीम्।\nअपर्वमि ग्रहं यातौ प्रजासंक्षयमिच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2042713, "chapter_id": 1954, "verse_number": "६-३-२९", "content_sanskrit": "अशोभिता दिशः सर्वाः पांसुवर्षैः समन्ततः।\nउत्पातमेघा रौद्राश्च रात्रौ वर्षन्ति शोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2042714, "chapter_id": 1954, "verse_number": "६-३-३०", "content_sanskrit": "कृत्तिकां पीडयंस्तीक्ष्णैर्नक्षत्रं पृथिवीपते ।\nअभीक्ष्णवाता वायन्ते धूमकेतुमवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2042715, "chapter_id": 1954, "verse_number": "६-३-३१", "content_sanskrit": "विषमं जनयन्त्येत आक्रन्दजननं महत्।\nत्रिषु पूर्वेषु सर्वेषु नक्षत्रेषु विशांपते ।\nबुधः संपततेऽभीक्ष्णं जनयन्प्राणिनां भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2042716, "chapter_id": 1954, "verse_number": "६-३-३२", "content_sanskrit": "चतुर्दशीं पञ्चदशीं भूतपूर्वां च षोडशीम्।\nइमां तु नाभिजानामि अमावास्यां त्रयोदशीम् ।\nचन्द्रसूर्यावुभौ ग्रस्तावेकान्हा हि त्रयोदशीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2042717, "chapter_id": 1954, "verse_number": "६-३-३३", "content_sanskrit": "अपर्वणि ग्रहेणैतौ प्रजाः संक्षपयिष्यतः ।\nमांसवर्षं पुनस्तीव्रमासीत्कृष्णचतुर्दशीम् ।\nशोणितैर्वक्रसंपूर्णा अतृप्तास्तत्र राक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2042718, "chapter_id": 1954, "verse_number": "६-३-३४", "content_sanskrit": "प्रतिस्नोतोवहा नद्यः सरितः शोणितोदकाः ।\nफेनायमानाः कूपाश्च कूर्दन्ति वृषभा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2042719, "chapter_id": 1954, "verse_number": "६-३-३५", "content_sanskrit": "पतन्त्युल्काः सनिर्घाताः शक्राशनिसमप्रभाः ।\nअद्य चैव निशां व्युष्टामनयं समवाप्स्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2042720, "chapter_id": 1954, "verse_number": "६-३-३६", "content_sanskrit": "विनिःसृत्य महोल्काभिस्तिमिरं सर्वतो दिशम् ।\nअन्योन्यमुपतिष्ठद्भिस्तत्र चोक्तं महर्षिभिः ।\nभूमिपालसहस्राणां भूमिः पास्यति शोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2042721, "chapter_id": 1954, "verse_number": "६-३-३७", "content_sanskrit": "कैलासमन्दराभ्यां तु तथा हिमवतो विभो ।\nसहस्रशो महाशब्दं शिखराणि पतन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2042722, "chapter_id": 1954, "verse_number": "६-३-३८", "content_sanskrit": "महाभूता भूमिकम्पे चत्वारः सागराः पृथक् ।\nवेलामुद्वर्तयन्तीव क्षोभयन्तो वसुन्धराम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2042723, "chapter_id": 1954, "verse_number": "६-३-३९", "content_sanskrit": "वृक्षानुन्मथ्य वान्त्युग्रा वाताः शर्करकर्षिणः ।\nआभग्राः सुमहावातैरशनीभिः समाहताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2042724, "chapter_id": 1954, "verse_number": "६-३-४०", "content_sanskrit": "वृक्षाः पतन्ति चैत्याश्च ग्रामेषु नगरेषु च ।\nनीललोहितपीतश्च भवत्यग्निर्हुतो द्विजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2042725, "chapter_id": 1954, "verse_number": "६-३-४१", "content_sanskrit": "वामार्चिर्दुष्टगन्धश्च मुञ्चन्वै दारुणं स्वनम् ।\nस्पर्शा गन्धा रसाश्चैव विपरीता महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2042726, "chapter_id": 1954, "verse_number": "६-३-४२", "content_sanskrit": "धूमं ध्वजाः प्रमुञ्चन्ति कम्पमाना मुहुर्मुहुः ।\nमुञ्चन्त्यङ्गारवर्षं च भेर्यश्च पटहास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2042727, "chapter_id": 1954, "verse_number": "६-३-४३", "content_sanskrit": "शिखराणां समृद्धानामुपरिष्टात्समन्ततः ।\nवायसाश्च रुवन्त्युग्रं वामं मण्डलमाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2042728, "chapter_id": 1954, "verse_number": "६-३-४४", "content_sanskrit": "पक्वापक्वेऽतिसुभृशं वावाश्यन्ते वयांसि च।\nनिलीयन्ते ध्वजाग्रेषु क्षयाय पृथिवीक्षिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2042729, "chapter_id": 1954, "verse_number": "६-३-४५", "content_sanskrit": "ध्यायन्तः प्रकिरन्तश्च व्याला वेपथुसंयुताः ।\nदीनास्तुरंगमाः सर्वे वारणाः सलिलाश्रयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2042730, "chapter_id": 1954, "verse_number": "६-३-४६", "content_sanskrit": "`एवंविधं दुर्निमित्तं क्षयाय पृथीवीक्षिताम्।\nभौमं दिव्यं चान्तरिक्षं त्रिविधं जायतेऽनिशम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2042731, "chapter_id": 1954, "verse_number": "६-३-४७", "content_sanskrit": "एतच्छ्रुत्वा भवानत्र प्राप्तकालं व्यवस्यताम्।\nयथा लोकः समुच्छेदं नायं गच्छेत भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2042732, "chapter_id": 1954, "verse_number": "६-३-४८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2042733, "chapter_id": 1954, "verse_number": "६-३-४८", "content_sanskrit": "पितुर्वचो निशम्यैतद्धृतराष्ट्रोऽब्रवीदिदम् ।\nदिष्टमेतत्पुरा मन्ये भविष्यति नरक्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2042734, "chapter_id": 1954, "verse_number": "६-३-४९", "content_sanskrit": "राजानः क्षत्रधर्मेण यदि वध्यन्ति संयुगे।\nवीरलोकं समासाद्य सुखं प्राप्स्यन्ति केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2042735, "chapter_id": 1954, "verse_number": "६-३-५०", "content_sanskrit": "इह कीर्तिं परे लोके दीर्घकालं महत्सुखम् ।\nप्राप्स्यन्ति पुरुषव्याघ्राः प्राणांस्त्यक्त्वा महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2042736, "chapter_id": 1954, "verse_number": "६-३-५१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2042737, "chapter_id": 1954, "verse_number": "६-३-५१", "content_sanskrit": "एवं मुनिस्तथेत्सुक्त्वा कवीन्द्रो राजसत्तम।\nधृतराष्ट्रेण पुत्रेण ध्यानमन्वगमत्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2042738, "chapter_id": 1954, "verse_number": "६-३-५२", "content_sanskrit": "स मुहूर्तं तथा ध्यात्वा पुनरेवाब्रवीद्वचः ।\nअसंशयं पार्थिवेन्द्र कालः संक्षयते जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2042739, "chapter_id": 1954, "verse_number": "६-३-५३", "content_sanskrit": "सृजते च पुनर्लोकान्नेह विद्यति शाश्वतम्।\nज्ञातीनां वै कुरूणां च संबन्धिसुहृदां तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2042740, "chapter_id": 1954, "verse_number": "६-३-५४", "content_sanskrit": "धर्म्यं दर्शय पन्थानं समर्थो ह्यसि वारणे ।\nक्षुद्रं जातिवधं प्राहुर्मा कुरुष्व ममाप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2042741, "chapter_id": 1954, "verse_number": "६-३-५५", "content_sanskrit": "कालोऽयं पुत्ररूपेण तव जातो विशांपते ।\nन वधः पूज्यते वेदे हितं नैव कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2042742, "chapter_id": 1954, "verse_number": "६-३-५६", "content_sanskrit": "हन्यात्स एनं यो हन्यात्कुलधर्मं स्विकां तनुम् ।\nकालेनोत्पथगन्तसि शक्ये सति यथाऽऽपदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2042743, "chapter_id": 1954, "verse_number": "६-३-५७", "content_sanskrit": "कुलस्यास्य विनाशाय तथैव च महीक्षिताम् ।\nअनर्थो राज्यरूपेण तव जातो विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2042744, "chapter_id": 1954, "verse_number": "६-३-५८", "content_sanskrit": "लुप्तधर्मा परेणासि धर्मं दर्शय वै सुतान् ।\nकिं ते राज्येन दुर्धर्षयेन प्राप्तोऽसि किल्विषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2042745, "chapter_id": 1954, "verse_number": "६-३-५९", "content_sanskrit": "यशो धर्मं च कीर्तिं च पालयन्स्वर्गमाप्स्यसि ।\nलभन्तां पाण्डवा राज्यं शमं गच्छन्तु कौरवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2042746, "chapter_id": 1954, "verse_number": "६-३-६०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2042747, "chapter_id": 1954, "verse_number": "६-३-६०", "content_sanskrit": "एवं ब्रुवति विप्रेन्द्रे धृतराष्ट्रोऽम्बिकासुतः ।\nप्रशस्य वाक्यं वाक्यज्ञो वाक्यं चैवाब्रवीत्पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2042748, "chapter_id": 1954, "verse_number": "६-३-६१x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2042749, "chapter_id": 1954, "verse_number": "६-३-६१", "content_sanskrit": "यथा भवान्वेत्ति तथैव वेत्ता\nभावाभावौ विदितौ मे यथार्थौ ।\nस्वार्थे हि संमुह्यति तात लोको\nमां चापि लोकात्मकमेव विद्धि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2042750, "chapter_id": 1954, "verse_number": "६-३-६२", "content_sanskrit": "प्रसादये त्वामतुलप्रभावं\nत्वं नो गतिर्दर्शयिता च धीरः ।\nन चापि ते वशगा मे सुताश्च\nन चाधर्मं कर्तुमर्हा हि मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2042751, "chapter_id": 1954, "verse_number": "६-३-६३", "content_sanskrit": "त्वं हि धर्मः पवित्रं च यशः कीर्तिर्धृतिः स्मृतिः ।\nकुरूणां पाण्डवानां च मान्यश्चापि पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2042752, "chapter_id": 1954, "verse_number": "६-३-६४x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2042753, "chapter_id": 1954, "verse_number": "६-३-६४", "content_sanskrit": "वैचित्रवीर्य नृपते यत्ते मनसि वर्तते।\nअभिधत्स्व यथाकामं छेत्ताऽस्मि तव संशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2042754, "chapter_id": 1954, "verse_number": "६-३-६५x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2042755, "chapter_id": 1954, "verse_number": "६-३-६५", "content_sanskrit": "यानि लिङ्गानि संग्रामे भवन्ति विजयिष्यताम्।\nतानि सर्वाणि भगवञ्छ्रोतुमिच्छामि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2042756, "chapter_id": 1954, "verse_number": "६-३-६६x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2042757, "chapter_id": 1954, "verse_number": "६-३-६६", "content_sanskrit": "प्रसन्नभाः पावक ऊर्ध्वरश्मिः\nप्रदक्षिणावर्तशिखो विधूमः ।\nपुण्या गन्धाश्चाहुतीनां प्रवान्ति\nजयस्यैतद्भाविनो रूपमाहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2042758, "chapter_id": 1954, "verse_number": "६-३-६७", "content_sanskrit": "गम्भीरघोषाश्च महास्वनाश्च\nशङ्खा मृदङ्गाश्च नदन्ति यत्र।\nविशुद्धरश्मिस्तपनः शशी च\nजयस्येतद्भाविनो रूपमाहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2042759, "chapter_id": 1954, "verse_number": "६-३-६८", "content_sanskrit": "इष्टा वाचः प्रसृता वायसानां\nसंप्रस्थितानां च गमिष्यतां च।\nये पृष्ठतस्ते त्वरयन्ति राज-\nन्ये चाग्रतस्ते प्रतिषेधयन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2042760, "chapter_id": 1954, "verse_number": "६-३-६९", "content_sanskrit": "कल्याणवाचः शकुना राजहंसाः\nशुकाः क्रौञ्चाः शतपत्राश्च यत्र।\nप्रदक्षिणाश्चैव भवन्ति सङ्ख्ये\nध्रुवं जयस्तत्र वदन्ति विप्राः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2042761, "chapter_id": 1954, "verse_number": "६-३-७०", "content_sanskrit": "अलंकारैः कवचैः केतुभिश्च\nसुखप्रणादैर्हेषितैर्वा हयानाम्।\nभ्राजिष्मती दुष्प्रतिवीक्षणीया\nयेषां चमूस्ते विजयन्ति शत्रून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2042762, "chapter_id": 1954, "verse_number": "६-३-७१", "content_sanskrit": "हृष्टा वाचस्तथा सत्वं योधानां यत्र भारत।\nन म्लायन्ति स्रजश्चैव ते तरन्ति रणोदधिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2042763, "chapter_id": 1954, "verse_number": "६-३-७२", "content_sanskrit": "`प्रयाणे वायसो वामे दक्षिणे प्रविविक्षताम्।\nपश्चात्संसाधयत्यर्थं पुरस्तात्प्रतिषेधति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2042764, "chapter_id": 1954, "verse_number": "६-३-७३", "content_sanskrit": "शब्दरूपरसस्पर्शगन्धाश्चाविकृताः शुभाः ।\nसदा हर्षश्च योधानां जयतामिह लक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2042765, "chapter_id": 1954, "verse_number": "६-३-७४", "content_sanskrit": "अनुगा वायवो वान्ति तथाऽभ्राणि वयांसि च ।\nअनुप्लवन्ति मेघाश्च तथैवेन्द्रधनूंषि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2042766, "chapter_id": 1954, "verse_number": "६-३-७५", "content_sanskrit": "एतानि जयमानानां लक्षणानि विशांपते ।\nभवन्ति विपरीतानि मुमूर्षूणां जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2042767, "chapter_id": 1954, "verse_number": "६-३-७६", "content_sanskrit": "अल्पायां वा महत्यां वा सेनायामिति निश्चयः।\nहर्षो योधगणस्यैको जयलक्षणमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2042768, "chapter_id": 1954, "verse_number": "६-३-७७", "content_sanskrit": "एको दीर्णो दारयति सेनां सुमहतीमपि ।\nतां दीर्णामनुदीर्यन्ते योधाः शूरतरा अपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2042769, "chapter_id": 1954, "verse_number": "६-३-७८", "content_sanskrit": "दुर्निवर्त्या तदा चैव प्रभग्ना महती वमूः ।\nअपामिव महावेगा त्रस्ता मगगणा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2042770, "chapter_id": 1954, "verse_number": "६-३-७९", "content_sanskrit": "नैव शक्या समाधातुं सन्निपाते महाचमूः ।\nदीर्ण इत्येव दीर्यन्ते सुविद्वांसोऽपि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2042771, "chapter_id": 1954, "verse_number": "६-३-८०", "content_sanskrit": "भीतान्भग्नांश्च संप्रेक्ष्य भयं भूयोऽभिवर्धते।\nप्रभग्ना सहसा राजन्दिशो विद्रवते चमूः ।\nनैव स्थापयितुं शक्या शूरैरपि महाचमूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2042772, "chapter_id": 1954, "verse_number": "६-३-८१", "content_sanskrit": "सत्कृत्य महतीं सेनां चतुरङ्गां महीपतिः ।\nउपायपूर्वं मेधावी यतेत सततोत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2042773, "chapter_id": 1954, "verse_number": "६-३-८२", "content_sanskrit": "उपायविजयं श्रेष्ठमाहुर्भेदेन मध्यमम् ।\nजघन्य एष विजयो यो युद्धेन विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2042774, "chapter_id": 1954, "verse_number": "६-३-८३", "content_sanskrit": "महान्दोषः सन्निपातस्तस्याद्यः क्षय उच्यते ।\nपरस्परज्ञाः संहृष्टा व्यवधूताः सुनिश्चिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2042775, "chapter_id": 1954, "verse_number": "६-३-८४", "content_sanskrit": "अपि पञ्चाशतं शूरा मृद्गन्ति महतीं चमूम् ।\nअपि वा पञ्च षट् सप्त विजयन्त्यनिवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2042776, "chapter_id": 1954, "verse_number": "६-३-८५", "content_sanskrit": "न वैनतेयो गरुडः प्रशंसति महाजनम् ।\nदृष्ट्वा सुपर्णोऽपचितिं महत्या अपि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2042777, "chapter_id": 1954, "verse_number": "६-३-८६", "content_sanskrit": "न बाहुल्येन सेनाया जयो भवति नित्यशः ।\nअध्रुवो हि जयो नाम दैवं चात्र परायणम् ।\nजयवन्तो हि संग्रामे कृतकृत्या भवन्ति हि ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2042778, "chapter_id": 1954, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि जम्बूखण्डविनिर्माणपर्वणि तृतीयोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]