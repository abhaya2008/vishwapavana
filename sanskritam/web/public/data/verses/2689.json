[{"id": 2079322, "chapter_id": 2689, "verse_number": "१२-१९४-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079323, "chapter_id": 2689, "verse_number": "१२-१९४-१", "content_sanskrit": "चातुरात्रस्यनुक्तं ते राजधर्मास्तथैव च।\nनानाश्रयाश्च भगवन्नितिहासाः पृथग्विधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079324, "chapter_id": 2689, "verse_number": "१२-१९४-२", "content_sanskrit": "धुतास्त्वत्तः कथाश्चैव धर्मयुक्ता महामते।\nसंदेहोऽस्ति तु कश्चिन्मे तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079325, "chapter_id": 2689, "verse_number": "१२-१९४-३", "content_sanskrit": "जापकानां फलावाप्तिं श्रोतुमिच्छामि भारत।\nकिं फलं जपतामुक्तं क्व वा तिष्ठन्ति जापकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079326, "chapter_id": 2689, "verse_number": "१२-१९४-४", "content_sanskrit": "जपस्य च विधिं कृत्स्नं वक्तुमर्हसि सेऽनघ।\nजापका इति किंचैतत्साङ्ख्ययोगक्रियाविधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079327, "chapter_id": 2689, "verse_number": "१२-१९४-५", "content_sanskrit": "किं यज्ञविधिरेवैष किमेतज्जप्यमुच्यते।\nएतन्मे सर्वमाचक्ष्व सर्वज्ञो ह्यसि मे मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079328, "chapter_id": 2689, "verse_number": "१२-१९४-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079329, "chapter_id": 2689, "verse_number": "१२-१९४-६", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nयमस्य यत्पुरा वृत्तं कालस्य ब्राह्मणस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079330, "chapter_id": 2689, "verse_number": "१२-१९४-७", "content_sanskrit": "`इक्ष्वाकोश्चैव मृत्योश्च विवादे धर्मकारणात्।\nसंन्यास एव वेदान्ते वर्तते जपनं प्रति।\nवेदवादाङ्गनिर्वृत्ताः शान्ता ब्रह्मण्यवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079331, "chapter_id": 2689, "verse_number": "१२-१९४-८", "content_sanskrit": "साङ्ख्ययोगौ तु यावुक्तौ मुनिभिः समदर्शिभिः।\nमार्गौ तावप्युभावेतौ संश्रितौ न च संश्रितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079332, "chapter_id": 2689, "verse_number": "१२-१९४-९", "content_sanskrit": "यथा संश्रूयते राजन्कारणं चात्र वक्ष्यते।\n`क्रमेण चैव विहितो जपयज्ञविधिर्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079333, "chapter_id": 2689, "verse_number": "१२-१९४-१०", "content_sanskrit": "सालम्बनमिति ज्ञेयं जपयज्ञात्मकं शुभम्।\nमनः समाधिरेवात्र तथेन्द्रियजयः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079334, "chapter_id": 2689, "verse_number": "१२-१९४-११", "content_sanskrit": "सत्यमग्निपरीचारो विविक्तानां च सेवनम्।\nध्यानं तपो दमः क्षान्तिरनसूया मिताशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079335, "chapter_id": 2689, "verse_number": "१२-१९४-१२", "content_sanskrit": "विषयप्रतिसंहारो मितजल्पस्तथा शमः।\nएष प्रर्वाको धर्मो निवर्तकमथो शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079336, "chapter_id": 2689, "verse_number": "१२-१९४-१३", "content_sanskrit": "यथा निवर्तते धर्मो जपतो ब्रह्मचारिणः।\n`न जपो न च वै ध्यानं नेच्छा न द्वेषहर्षणौ।\nयुज्यते नृपशार्दूल सुसंवेद्यं हि तत्किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2079337, "chapter_id": 2689, "verse_number": "१२-१९४-१४", "content_sanskrit": "जपमावर्तयन्नित्यं जपन्वै ब्रह्मचारिकम्।\nतदर्थबुद्ध्या संयाति मनसा जापकः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2079338, "chapter_id": 2689, "verse_number": "१२-१९४-१५", "content_sanskrit": "यथा संश्रूयते जापो येन वै जापको भवेत्।\nसंहिताप्रणवेनैव सावित्री च परा मता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2079339, "chapter_id": 2689, "verse_number": "१२-१९४-१६", "content_sanskrit": "यदन्यदुचितं शुद्धं वेदस्मृत्युपपादितम्।\nएतत्सर्वमशेषेण यथोक्तं परिवर्तयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2079340, "chapter_id": 2689, "verse_number": "१२-१९४-१७", "content_sanskrit": "द्विविदं मार्गमासाद्य व्यक्ताव्यक्तमनामयम्।\nकुशोच्चयनिषष्णः सन्कुशहस्तः कुशैः शिख।\nकुशैः परिवृतस्तस्मिन्मध्ये छन्नः कुशैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2079341, "chapter_id": 2689, "verse_number": "१२-१९४-१८", "content_sanskrit": "विषयेभ्यो नमस्कुर्याद्विषयान्न च भावयेत्।\nसाम्यमुत्पाद्य मनसा मनस्येव मनो दधत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2079342, "chapter_id": 2689, "verse_number": "१२-१९४-१९", "content_sanskrit": "तद्धिया ध्यायति ब्रह्म जपन्वै संहितां हिताम्।\nसंन्यस्यत्यथवा तां वै समाधौ पर्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2079343, "chapter_id": 2689, "verse_number": "१२-१९४-२०", "content_sanskrit": "ध्यानमुत्पादयत्यत्र संहिताबलसंश्रयात्।\n`अथाभिमतमन्त्रेण प्रणवाद्यं जपेत्कृती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2079344, "chapter_id": 2689, "verse_number": "१२-१९४-२१", "content_sanskrit": "यस्मिन्नेवाभिपतितं मनस्तत्र निवेशयेत्।\nसमाधौ स हि मन्त्रे तु संहितां वा यथाविधि।\nशुद्धात्मा तपसा दान्तो निवृत्तद्वेषकामवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2079345, "chapter_id": 2689, "verse_number": "१२-१९४-२२", "content_sanskrit": "अरागमोहो निर्द्वन्द्वो न शोचति न सज्जते।\nन कर्ता करणीयानां नाकार्याणामिति स्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2079346, "chapter_id": 2689, "verse_number": "१२-१९४-२३", "content_sanskrit": "न चाहंकारयोगेन मनः प्रस्थाफ्येत्क्वचित्।\nन चार्थग्रहणे युक्तो नावमानी न चाक्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2079347, "chapter_id": 2689, "verse_number": "१२-१९४-२४", "content_sanskrit": "ध्यानक्रियापरो युक्तो ध्यानवान्ध्याननिश्चयः।\nध्याने समाधिमुत्पाद्य तदपि त्यजति क्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2079348, "chapter_id": 2689, "verse_number": "१२-१९४-२५", "content_sanskrit": "स वै तस्यामवस्थायां सर्वत्यागकृतः सुखी।\nनिरिच्छस्त्यजति प्राणान्ब्राह्मीं संश्रयते तनुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2079349, "chapter_id": 2689, "verse_number": "१२-१९४-२६", "content_sanskrit": "`निरालम्बो भवेत्स्मृत्वा मरणाय समाधिमान्।\nसर्वाल्लोँकान्समाक्रम्य क्रमात्प्राप्नोति वै परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2079350, "chapter_id": 2689, "verse_number": "१२-१९४-२७", "content_sanskrit": "अथवा नेच्छते तत्र ब्रह्मकायनिषेवणम्।\nउत्क्रामति च मार्गस्थो नैव क्वचन जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2079351, "chapter_id": 2689, "verse_number": "१२-१९४-२८", "content_sanskrit": "आत्मबुद्धिं समास्थाय शान्तीभूतो निरामयः।\nअमृतं विरजाः शुद्धमात्मानं प्रतिपद्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2079352, "chapter_id": 2689, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुर्नवत्यधिकशततमोऽध्यायः॥ १९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]