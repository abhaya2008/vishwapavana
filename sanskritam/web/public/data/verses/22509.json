[{"id": 7002509000, "chapter_id": 22509, "verse_number": "१-१७१-१", "content_sanskrit": "शतानीक उवाच ।\nमगानां ब्रूहि मे धर्मं समासव्यासयोगतः ।\nफलं च किं भवेद्ब्रह्मन्मगधर्मनिषेवणात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002509001, "chapter_id": 22509, "verse_number": "१-१७१-२", "content_sanskrit": "सुमंतुरुवाच ।\nय एष धर्मः सूर्येति तवाख्यातो मयानघ ।\nमगधर्मः स एवोक्तः सर्वपापभयापहः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002509002, "chapter_id": 22509, "verse_number": "१-१७१-३", "content_sanskrit": "सर्वेषामेव वर्णानां मगधर्मनिषेवणम् ।\nमगधर्मश्च संप्रोक्त एतेषां भवमुक्तये ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002509003, "chapter_id": 22509, "verse_number": "१-१७१-४", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः स्त्री शूद्रो वा मगाश्रमी ।\nयः पूजयति मार्तंडं स याति परमां गतिम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002509004, "chapter_id": 22509, "verse_number": "१-१७१-५", "content_sanskrit": "त्रिसंध्यमर्चयेद्भानुमग्निकार्यं च शक्तितः ।\nकुर्यान्मगो महाबाहो मुखमावृत्य यत्नतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002509005, "chapter_id": 22509, "verse_number": "१-१७१-६", "content_sanskrit": "त्रिसंध्यमेककालं वा पूजयेच्छद्धया रविम् ।\nअसंपूज्य रविं मोहान्न भुंजीत कदाचन ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002509006, "chapter_id": 22509, "verse_number": "१-१७१-७", "content_sanskrit": "एष धर्मः परो ज्ञेयः शेषो भवति मानवः ।\nअपूजयित्वा भुंजानो विष्ठां भुङ्क्ते च वै मगः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002509007, "chapter_id": 22509, "verse_number": "१-१७१-८", "content_sanskrit": "देवं समाश्रितैः पूजा कर्तव्येयं त्रिभिः सदा ।\nमनसा पूजयेद्योगी पुष्पैश्चारण्यसंभवैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002509008, "chapter_id": 22509, "verse_number": "१-१७१-९", "content_sanskrit": "देवार्थपुष्पहिंसायां न भवेत्तस्य हिंसकः ।\nयद्यल्पमपि चात्मार्थं निहन्याद्धिंसकस्तदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002509009, "chapter_id": 22509, "verse_number": "१-१७१-१०", "content_sanskrit": "मगश्चाग्निपरो नित्यं तद्भक्तोऽतिथिपूजकः ।\nमगी मैथुनवर्ज्यः स्याच्छ्रीमान्गृहमगाश्रमी ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002509010, "chapter_id": 22509, "verse_number": "१-१७१-११", "content_sanskrit": "देवाग्निस्वतिथौ भक्तं पचते चात्मकारणात् ।\nआत्मार्थे यः पचेन्मोहात्स मगो नरकं व्रजेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002509011, "chapter_id": 22509, "verse_number": "१-१७१-१२", "content_sanskrit": "देवार्थे पचनं येषां संतानार्थं तु मैथुनम् ।\nअर्थो दानार्थं उद्दिष्टो नरकं हि विपर्ययात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002509012, "chapter_id": 22509, "verse_number": "१-१७१-१३", "content_sanskrit": "जीवतृतीयभागेपि न प्रकुर्वीत वार्चनम् ।\nवित्तार्जने तदर्धेन यतो नित्यं हि जीवितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002509013, "chapter_id": 22509, "verse_number": "१-१७१-१४", "content_sanskrit": "न्यायोपार्जितवित्तः स्यादन्यायं परि वर्जयेत् ।\nअन्यायार्जितवित्तैस्तु कुर्वन्नरकमाप्नुयात् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002509014, "chapter_id": 22509, "verse_number": "१-१७१-१५", "content_sanskrit": "वाचोर्थे ब्रह्मचारी यः सूर्यपूजाग्नितत्परः ।\nभवेज्जितेंद्रियः शांतो नैष्ठिको भौति कोऽपि वा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002509015, "chapter_id": 22509, "verse_number": "१-१७१-१६", "content_sanskrit": "सर्वगंधविनिर्मुक्तः कंदमूलफलाशनः ।\nमम वैखानसो ज्ञेयः सूर्यपूजाग्नितत्परः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002509016, "chapter_id": 22509, "verse_number": "१-१७१-१७", "content_sanskrit": "निवृत्तः संगमेभ्यस्तु सूर्यध्यान रतः सदा ।\nज्ञेयः सौरयतींद्राय पूजानिष्ठो जितेंद्रियः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002509017, "chapter_id": 22509, "verse_number": "१-१७१-१८", "content_sanskrit": "मुंडोपनयनो व्यंगी शुक्लवासः समन्वितः ।\nज्ञेयं तदर्चनस्थानमेतत्कार्यं प्रयत्नतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002509018, "chapter_id": 22509, "verse_number": "१-१७१-१९", "content_sanskrit": "अथाव्यंगो महाराज धारयेद्यस्तु भोजकः ।\nअगम्यं सर्वसत्त्वानां सूर्यलोकं स गच्छति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002509019, "chapter_id": 22509, "verse_number": "१-१७१-२०", "content_sanskrit": "ध्वंसनं सर्वदुष्टानां सर्वपाप भयापहम् ।\nभावशुद्धेन सततमर्चनीयो दिवाकरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002509020, "chapter_id": 22509, "verse_number": "१-१७१-२१", "content_sanskrit": "गंधलेपविहीनोऽपि भावशुद्धो न दुष्यति ।\nभावेषु च चरेच्छौचं वस्त्रपूतं जलं पिबेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002509021, "chapter_id": 22509, "verse_number": "१-१७१-२२", "content_sanskrit": "दृष्टिपूतं न्यसेत्पादं सत्यपूतं वचो वदेत् ।\nसौरध्यानरताः शांताः सौरधर्मपरायणाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002509022, "chapter_id": 22509, "verse_number": "१-१७१-२३", "content_sanskrit": "सर्व एवाश्रमा ज्ञेया भास्करांगसमुद्भवाः ।\nभोजकाष्टव्रतं धार्यं रविणोक्तमनौपमम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002509023, "chapter_id": 22509, "verse_number": "१-१७१-२४", "content_sanskrit": "सर्वव्रतानां परमं धर्मालयमनुत्तमम् ।\nसौरभक्ते सदा क्षांतिरहिंसा सर्वदा शमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002509024, "chapter_id": 22509, "verse_number": "१-१७१-२५", "content_sanskrit": "संतोषः सत्यमस्तेयं ब्रह्मचर्यं तथाष्टमम् ।\nयथासंभवपूजाभिः कर्मणा मनसा गिरा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002509025, "chapter_id": 22509, "verse_number": "१-१७१-२६", "content_sanskrit": "सौरभक्तिः सदा कार्या भोजकेषु विशेषतः ।\nस्वदेहान्निर्विशेषं हि भोजकान्पालयेद्बुधः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002509026, "chapter_id": 22509, "verse_number": "१-१७१-२७", "content_sanskrit": "भयदारिद्र्यरोगेभ्यस्तेषां कुर्यात्प्रियाणि वै ।\nसूर्यस्य परिपूर्णस्य किं नाम क्रियते नरैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002509027, "chapter_id": 22509, "verse_number": "१-१७१-२८", "content_sanskrit": "यत्कृतं भोजकानां वै तत्कृतं स्याद्रवेर्नृप ।\nसुदूरमपि गंतव्यं मगानां यत्र वै गणः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002509028, "chapter_id": 22509, "verse_number": "१-१७१-२९", "content_sanskrit": "स च प्रयत्नाद्द्रष्टव्यस्तत्र संनिहितो रविः ।\nभोजकस्य तु भक्तस्य सूर्यपूजारतस्य च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002509029, "chapter_id": 22509, "verse_number": "१-१७१-३०", "content_sanskrit": "आज्ञां कृत्वा यथान्यायमश्वमेधफलं लभेत् ।\nदेवाश्रमगतो भक्त्या देवार्चां पूजयेन्नृप ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002509030, "chapter_id": 22509, "verse_number": "१-१७१-३१", "content_sanskrit": "स्वागतासनपाद्यार्घ्यमधुपर्काद्यनुक्रमात् ।\nभोजयित्वा यथान्यायं सूर्यलोके महीयते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002509031, "chapter_id": 22509, "verse_number": "१-१७१-३२", "content_sanskrit": "प्रतिश्रयप्रदानेन राजा भवति भारत ।\nदत्त्वा स्थानं तथा शौचं वारुणं लोकमाप्नुयात् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002509032, "chapter_id": 22509, "verse_number": "१-१७१-३३", "content_sanskrit": "श्वेतबिंदुपरीतांगं ध्यानश्रमविकर्शितम् ।\nसंवीज्य तालवृंत्तेन वायुलोके महीयते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002509033, "chapter_id": 22509, "verse_number": "१-१७१-३४", "content_sanskrit": "क्षुत्पिपासातुरं श्रांतं मलिनं रोगिणं तथा ।\nपालयित्वा यथा शक्त्या सर्वान्कामानवाप्नुयात् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002509034, "chapter_id": 22509, "verse_number": "१-१७१-३५", "content_sanskrit": "पतिताशस्तसंकीर्णचंडालादीनां पक्षिणाम् ।\nकारुण्यात्सर्वभूतानां देयमन्नं स्वशक्तितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002509035, "chapter_id": 22509, "verse_number": "१-१७१-३६", "content_sanskrit": "अत्यल्पमपि कारुण्याद्दत्तं भवति चाक्षयम् ।\nतस्मात्सर्वेषु भूतेषु देवकारुण्यमुच्यते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002509036, "chapter_id": 22509, "verse_number": "१-१७१-३७", "content_sanskrit": "अभावे तृणभूम्यन्नं पत्रं धनफलानि च ।\nदत्त्वाऽगताय प्रणतः स्वर्गं याति प्रियेण वा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002509037, "chapter_id": 22509, "verse_number": "१-१७१-३८", "content_sanskrit": "न हीदृक्स्वर्गयानाय यथा लोके प्रियं वचः ।\nइहामुत्र सुखं तेषां वाग्येषां मधुरा भवेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002509038, "chapter_id": 22509, "verse_number": "१-१७१-३९", "content_sanskrit": "अमृतस्यंदिनी वाचं चंदनस्पर्शशीतलाम् ।\nधर्माविरोधिनीमुक्त्वा सुखमक्षय्यमाप्नुयात् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002509039, "chapter_id": 22509, "verse_number": "१-१७१-४०", "content_sanskrit": "अलं दानेन राजेंद्र पूजयाध्यापनेन वा ।\nइदं स्वर्गस्य सोपानमचलं यत्प्रियं वचः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002509040, "chapter_id": 22509, "verse_number": "१-१७१-४१", "content_sanskrit": "पूजाभिभाषणं दृष्टिः प्रत्येकं स्वर्गहेतवः ।\nसंपृच्छेदा गतं भक्त्या कुशलं प्रश्नमादरात् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002509041, "chapter_id": 22509, "verse_number": "१-१७१-४२", "content_sanskrit": "गमने तस्य वक्तव्यं पंथानः संतु ते शिवाः ।\nसुखं भवतु ते नित्यं सर्वकार्यकरं भृशम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002509042, "chapter_id": 22509, "verse_number": "१-१७१-४३", "content_sanskrit": "आशीर्वादमिदं वाक्यं सर्वकालेषु सर्वदा ।\nनमस्कारादिवाक्येषु स्वस्ति मंगलवादने ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002509043, "chapter_id": 22509, "verse_number": "१-१७१-४४", "content_sanskrit": "शिवं भवतु ते नित्यं तं ब्रूयात्सर्वकर्मसु ।\nएवमादि च वाचारमनुष्ठाय सदाश्रमी ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002509044, "chapter_id": 22509, "verse_number": "१-१७१-४५", "content_sanskrit": "अशेषपाप निर्मुक्तः सूर्यलोके महीयते ।\nसूर्यभक्ते तु या भक्तिः सद्भक्तैः क्रियते नरैः ।\nसूर्ये भक्तिसमा नित्यं भक्ते भक्तिरनुष्ठिता ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002509045, "chapter_id": 22509, "verse_number": "१-१७१-४६", "content_sanskrit": "आक्रुष्टे ताडिते वापि यो नाक्रोशेन्न ताडयेत् ।\nवाक्यादधिकृतः स्वस्थः स दुःखात्परिमुच्यते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002509046, "chapter_id": 22509, "verse_number": "१-१७१-४७", "content_sanskrit": "सर्वेषामेव तीर्थानां क्षांतिः परमपूजिता ।\nतस्मात्पूर्व प्रयत्नेन क्षांतिः कार्या क्रियासु वै ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002509047, "chapter_id": 22509, "verse_number": "१-१७१-४८", "content_sanskrit": "ज्ञानयोगतपो यस्य यज्ञदानानि सत्क्रिया ।\nक्रोधनस्य वृथा यस्मात्तस्मात्क्रोधं विवर्जयेत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002509048, "chapter_id": 22509, "verse_number": "१-१७१-४९", "content_sanskrit": "मर्मास्थिप्राणहृदयं निर्दहेदप्रियंवचः ।\nन वचो ह्यप्रियं तस्माद्भोजकेषु विशेषतः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002509049, "chapter_id": 22509, "verse_number": "१-१७१-५०", "content_sanskrit": "क्षमा दानं त्विषः सत्यं क्षमाहिंसार्कसंभवाः ।\nन शक्या विस्तराद्वक्तुमपि वर्षशतैरपि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]