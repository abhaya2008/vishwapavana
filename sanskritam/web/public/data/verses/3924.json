[{"id": 2135069, "chapter_id": 3924, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135070, "chapter_id": 3924, "verse_number": "१", "content_sanskrit": "प्रायोपविष्टं राजानं दुर्योधनममर्षणम् ।\nउवाच सान्त्वयन् राजन् शकुनिः सौबलस्तदा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135071, "chapter_id": 3924, "verse_number": "२", "content_sanskrit": "सम्यगुक्तं हि कर्णेन तच्छ्रुतं कौरव त्वया ।\nमया हृतां श्रियं स्फीतां तां मोहादपहाय किम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135072, "chapter_id": 3924, "verse_number": "३", "content_sanskrit": "त्वं बुध्वा नृवर प्राणानुत्स्रष्टुमिह चेच्छसि ।\nअथवाप्यवगच्छामि न वृद्धाः सेवितास्त्वया \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135073, "chapter_id": 3924, "verse_number": "४", "content_sanskrit": "यः समुत्पतितं हर्षं दैन्यं वा न नियच्छति ।\nस नश्यति श्रियं प्राप्य पात्रमानमिवाम्भसि \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135074, "chapter_id": 3924, "verse_number": "५", "content_sanskrit": "यः शोकं समनुप्राप्तं न नियच्छति भारत ।\nतमीदृशं नरं न श्रीः कदाचिदपि सेवते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135075, "chapter_id": 3924, "verse_number": "६", "content_sanskrit": "अतिभीरुमतिक्लीबं दीर्घसूत्रं प्रमादिनम् ।\nव्यसनाद् विषयाक्रान्तं न भजन्ति नृपं प्रजाः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135076, "chapter_id": 3924, "verse_number": "७", "content_sanskrit": "सत्कृतस्य हि ते शोको विपरीतः कथं भवेत् ।\nमा कृतं शोभनं पार्थैः शोकमालम्ब्य नाशय \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135077, "chapter_id": 3924, "verse_number": "८", "content_sanskrit": "यत्र हर्षस्त्वया कार्यः सत्कर्तव्याश्च पाण्डवाः ।\nतत्र शोचसि राजेन्द्र विपरीतमिदं तव \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135078, "chapter_id": 3924, "verse_number": "९", "content_sanskrit": "प्रसीद मा त्यजात्मानं तुष्टश्च सुकृतं स्मर ।\nप्रयच्छ राज्यं पार्थानां यशो धर्ममवाप्नुहि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135079, "chapter_id": 3924, "verse_number": "१०", "content_sanskrit": "क्रियामेतां समाज्ञाय कृतज्ञस्त्वं भविष्यसि ।\nतेषां प्रतिकृतं कृत्वा यशो धर्ममवाप्नुहि \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135080, "chapter_id": 3924, "verse_number": "११", "content_sanskrit": "सौभ्रात्रं पाण्डवैः कृत्वा समवस्थाप्य चैव तान् ।\nपित्र्यं राज्यं प्रयच्छैषां ततः सुखमवाप्स्यसि \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135081, "chapter_id": 3924, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135082, "chapter_id": 3924, "verse_number": "१२", "content_sanskrit": "शकुनेस्तु वचः श्रुत्वा दुःशासनमवेक्ष्य च ।\nपादयोः पतितं वीरं विकृतं भ्रातृसौहृदात् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135083, "chapter_id": 3924, "verse_number": "१३", "content_sanskrit": "बाहुभ्यां साधुजाताभ्यां दुःशासनमरिन्दमम् ।\nउत्थाप्य सम्परिष्वज्य प्रीत्याजिघ्रत मूर्धनि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135084, "chapter_id": 3924, "verse_number": "१४", "content_sanskrit": "कर्णसौबलयोश्चापि संश्रुत्य वचनान्यसौ ।\nनिर्वेदं परमं गत्वा राजा दुर्योधनस्तदा \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135085, "chapter_id": 3924, "verse_number": "१५", "content_sanskrit": "व्रीडयाऽभिपरीतात्मा नैराश्यमगमत् परम् ।\nतच्छ्रुत्वा सुहृदश्चैव समन्युरिदमब्रवीत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135086, "chapter_id": 3924, "verse_number": "१६", "content_sanskrit": "न धर्मधनसौख्येन नैश्वर्येण न चाज्ञया ।\nनैव भोगैश्च मे कार्यं मा विहाय च गच्छत \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135087, "chapter_id": 3924, "verse_number": "१७", "content_sanskrit": "निश्चितेयं मम मतिः स्थिता प्रायोपवेशने ।\nगच्छध्वं नगरं सर्वे पूज्याश्च गुरवो मम \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135088, "chapter_id": 3924, "verse_number": "१८", "content_sanskrit": "त एवमुक्ताः प्रत्यूचू राजानमरिमर्दनम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135089, "chapter_id": 3924, "verse_number": "१९", "content_sanskrit": "या गतिस्तव राजेन्द्र साऽस्माकमपि भारत ।\nकथं वा सम्प्रवेक्ष्यामस्त्वद्विहीनाः पुरं वयम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135090, "chapter_id": 3924, "verse_number": "२०", "content_sanskrit": "स सुहृद्भिरमात्यैश्च भ्रातृभिः स्वजनेन च ।\nबहुप्रकारमप्युक्तो निश्चयान्न विचाल्यते \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135091, "chapter_id": 3924, "verse_number": "२१", "content_sanskrit": "दर्भास्तरणमास्तीर्य निश्चयाद् धृतराष्ट्रजः ।\nसंस्पृश्यापः शुचिर्भूत्वा भूतळे समुपस्थितः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135092, "chapter_id": 3924, "verse_number": "२२", "content_sanskrit": "कुशचीराम्बरधरः परं नियममास्थितः ।\nवाग्यतो राजशार्दूलः स स्वर्गगतिकाम्यया \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2135093, "chapter_id": 3924, "verse_number": "२३", "content_sanskrit": "मनसोपचितिं कृत्वा निरस्य च बहिष्क्रियाः ।\nतस्थौ प्रायोपवेशेऽथ मतिं कृत्वा सुनिश्चिताम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2135094, "chapter_id": 3924, "verse_number": "२४", "content_sanskrit": "अथ तं निश्चयं तस्य बुद्ध्वा दैतेयदानवाः ।\nपाताळवासिनो रौद्राः पूर्वं देवैर्विनिर्जिताः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2135095, "chapter_id": 3924, "verse_number": "२५", "content_sanskrit": "ते स्वपक्षक्षयं तं तु ज्ञात्वा दुर्योधनस्य वै ।\nआह्वानाय तदा चक्रुः कर्म वैतानसम्भवम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2135096, "chapter_id": 3924, "verse_number": "२६", "content_sanskrit": "बृहस्पत्युशनः प्रोक्तैः मन्त्रैर्मन्त्रविशारदाः ।\nअथर्ववेदप्रोक्तैश्च याश्चोपनिषदि क्रियाः ।\nमन्त्रजप्यसमायुक्तास्तास्तदा सम्प्रवर्तयन् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2135097, "chapter_id": 3924, "verse_number": "२७", "content_sanskrit": "जुह्वन्त्यग्नौ हविः क्षीरं मन्त्रवत्सुसमाहिताः ।\nब्राह्मणा वेदवेदाङ्गपारगाः सुदृढव्रताः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2135098, "chapter_id": 3924, "verse_number": "२८", "content_sanskrit": "अध्वर्यवो दानवानां कर्म प्रावर्तयंस्ततः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2135099, "chapter_id": 3924, "verse_number": "२९", "content_sanskrit": "कर्मसिद्धौ तदा तत्र जृम्भमाणा महाद्भुता ।\nकृत्या समुत्थिता राजन् किं करोमीति चाब्रवीत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2135100, "chapter_id": 3924, "verse_number": "३०", "content_sanskrit": "आहुर्दैत्याश्च तां तत्र सुप्रीतेनान्तरात्मना ।\nप्रायोपविष्टं राजानं धार्तराष्ट्रमिहानय \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2135101, "chapter_id": 3924, "verse_number": "", "content_sanskrit": "वैशम्पायनः-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2135102, "chapter_id": 3924, "verse_number": "३१", "content_sanskrit": "तथेति च प्रतिश्रुत्य सा कृत्या प्रययौ तदा ।\nनिमेषादगमच्चापि यत्र राजा सुयोधनः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2135103, "chapter_id": 3924, "verse_number": "३२", "content_sanskrit": "समादाय च राजानं प्रविवेश रसातळम् ।\nदानवानां मुहूर्ताच्च तमानीतं न्यवेदयत् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2135104, "chapter_id": 3924, "verse_number": "३३", "content_sanskrit": "तमानीतं नृपं दृष्ट्वा रात्रौ संहत्य दानवाः ।\nप्रहृष्टमनसः सर्वे कञ्चिदुत्फुल्ललोचनाः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2135105, "chapter_id": 3924, "verse_number": "३४", "content_sanskrit": "दृढमेनं परिष्वज्य पृष्ट्वा च कुशलं तदा ।\nसाभिमानमथो वाक्यं दुर्योधनमथाब्रुवन् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2135106, "chapter_id": 3924, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि घोषयात्रापर्वणि दुर्योधनप्रायोपवेशे एकचत्वारिंशदधिकद्विशततमोऽध्यायः ॥२४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2135107, "chapter_id": 3924, "verse_number": "", "content_sanskrit": "प्रायोपवेशपर्वणि षष्ठोऽध्यायः ॥६॥\n* * * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]