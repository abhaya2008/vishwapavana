[{"id": 5000064000, "chapter_id": 9064, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे चतुःषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000064001, "chapter_id": 9064, "verse_number": "१-६४-१", "content_sanskrit": "सुरकार्यमिदं रम्भे कर्तव्यं सुमहत् त्वया।\nलोभनं कौशिकस्येह काममोहसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000064002, "chapter_id": 9064, "verse_number": "१-६४-२", "content_sanskrit": "तथोक्ता साप्सरा राम सहस्राक्षेण धीमता।\nव्रीडिता प्राञ्जलिर्वाक्यं प्रत्युवाच सुरेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000064003, "chapter_id": 9064, "verse_number": "१-६४-३", "content_sanskrit": "अयं सुरपते घोरो विश्वामित्रो महामुनिः।\nक्रोधमुत्स्रक्ष्यते घोरं मयि देव न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000064004, "chapter_id": 9064, "verse_number": "१-६४-४", "content_sanskrit": "ततो हि मे भयं देव प्रसादं कर्तुुमर्हसि।\nएवमुक्तस्तया राम सभयं भीतया तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000064005, "chapter_id": 9064, "verse_number": "१-६४-५", "content_sanskrit": "तामुवाच सहस्राक्षो वेपमानां कृताञ्जलिम्।\nमा भैषी रम्भे भद्रं ते कुरुष्व मम शासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000064006, "chapter_id": 9064, "verse_number": "१-६४-६", "content_sanskrit": "कोकिलो हृदयग्राही माधवे रुचिरद्रुमे।\nअहं कन्दर्पसहितः स्थास्यामि तव पार्श्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000064007, "chapter_id": 9064, "verse_number": "१-६४-७", "content_sanskrit": "त्वं हि रूपं बहुगुणं कृत्वा परमभास्वरम्।\nतमृषिं कौशिकं भद्रे भेदयस्व तपस्विनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000064008, "chapter_id": 9064, "verse_number": "१-६४-८", "content_sanskrit": "सा श्रुत्वा वचनं तस्य कृत्वा रूपमनुत्तमम्।\nलोभयामास ललिता विश्वामित्रं शुचिस्मिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000064009, "chapter_id": 9064, "verse_number": "१-६४-९", "content_sanskrit": "कोकिलस्य तु शुश्राव वल्गु व्याहरतः स्वनम्।\nसम्प्रहृष्टेन मनसा स चैनामन्ववैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000064010, "chapter_id": 9064, "verse_number": "१-६४-१०", "content_sanskrit": "अथ तस्य च शब्देन गीतेनाप्रतिमेन च।\nदर्शनेन च रम्भाया मुनिः संदेहमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000064011, "chapter_id": 9064, "verse_number": "१-६४-११", "content_sanskrit": "सहस्राक्षस्य तत्सर्वं विज्ञाय मुनिपुंगवः।\nरम्भां क्रोधसमाविष्टः शशाप कुशिकात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000064012, "chapter_id": 9064, "verse_number": "१-६४-१२", "content_sanskrit": "यन्मां लोभयसे रम्भे कामक्रोधजयैषिणम्।\nदशवर्षसहस्राणि शैली स्थास्यसि दुर्भगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000064013, "chapter_id": 9064, "verse_number": "१-६४-१३", "content_sanskrit": "ब्राह्मणः सुमहातेजास्तपोबलसमन्वितः।\nउद्धरिष्यति रम्भे त्वां मत्क्रोधकलुषीकृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000064014, "chapter_id": 9064, "verse_number": "१-६४-१४", "content_sanskrit": "एवमुक्त्वा महातेजा विश्वामित्रो महामुनिः।\nअशक्नुवन् धारयितुं कोपं संतापमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000064015, "chapter_id": 9064, "verse_number": "१-६४-१५", "content_sanskrit": "तस्य शापेन महता रम्भा शैली तदाभवत्।\nवचः श्रुत्वा च कन्दर्पो महर्षेः स च निर्गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000064016, "chapter_id": 9064, "verse_number": "१-६४-१६", "content_sanskrit": "कोपेन च महातेजास्तपोऽपहरणे कृते।\nइन्द्रियैरजितै राम न लेभे शान्तिमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000064017, "chapter_id": 9064, "verse_number": "१-६४-१७", "content_sanskrit": "बभूवास्य मनश्चिन्ता तपोऽपहरणे कृते।\nनैवं क्रोधं गमिष्यामि न च वक्ष्ये कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000064018, "chapter_id": 9064, "verse_number": "१-६४-१८", "content_sanskrit": "अथवा नोच्छ्वसिष्यामि संवत्सरशतान्यपि।\nअहं हि शोषयिष्यामि आत्मानं विजितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000064019, "chapter_id": 9064, "verse_number": "१-६४-१९", "content_sanskrit": "तावद् यावद्धि मे प्राप्तं ब्राह्मण्यं तपसार्जितम्।\nअनुच्छ्वसन्नभुञ्जानस्तिष्ठेयं शाश्वतीः समाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000064020, "chapter_id": 9064, "verse_number": "१-६४-२०", "content_sanskrit": "नहि मे तप्यमानस्य क्षयं यास्यन्ति मूर्तयः।\nएवं वर्षसहस्रस्य दीक्षां स मुनिपुंगवः।\nचकाराप्रतिमां लोके प्रतिज्ञां रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000064021, "chapter_id": 9064, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे चतुःषष्ठितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]