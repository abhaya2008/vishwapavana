[{"id": 2210081, "chapter_id": 5494, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210082, "chapter_id": 5494, "verse_number": "१", "content_sanskrit": "समागतान् वेदविदो राज्ञश्च पृथिवीश्वरान् ।\nदृष्ट्वा युधिष्ठिरो राजा भीमसेनमथाब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210083, "chapter_id": 5494, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210084, "chapter_id": 5494, "verse_number": "२", "content_sanskrit": "उपयाता नरव्याघ्रा य इमे जगतीश्वराः ।\nएतेषां क्रियतां पूजा पूजार्हा हि नरेश्वराः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210085, "chapter_id": 5494, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210086, "chapter_id": 5494, "verse_number": "३", "content_sanskrit": "इत्युक्तः स तथा चक्रे नरेन्द्रेण यशस्विना ।\nभीमसेनो महाराज यमाभ्यां सह कौरव ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210087, "chapter_id": 5494, "verse_number": "४", "content_sanskrit": "अथाभ्यगच्छद् गोविन्दो वृष्णिभिः सह धर्मजम् ।\nबलदेवं पुरस्कृत्य सर्वप्राणभृतां वरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210088, "chapter_id": 5494, "verse_number": "५", "content_sanskrit": "युयुधानेन सहितः प्रद्युम्नेन गदेन च ।\nनिशठेनाथ साम्बेन तथैव कृतवर्मणा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210089, "chapter_id": 5494, "verse_number": "६", "content_sanskrit": "तेषामपि परां पूजां चक्रे भीमो महाभुजः ।\nविविशुस्ते च वेश्मानि रत्नवन्ति नरर्षभाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210090, "chapter_id": 5494, "verse_number": "७", "content_sanskrit": "युधिष्ठिरसमीपे तु कथान्ते मधुसूदनः ।\nअर्जुनं कथयामास बहुसङ्ग्रामकर्शितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210091, "chapter_id": 5494, "verse_number": "८", "content_sanskrit": "स तं पप्रच्छ कौन्तेयः पुनःपुनररन्दिमः ।\nधर्मराट् भ्रातरं जिष्णुं स चाचष्ट जगत्पतिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210092, "chapter_id": 5494, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210093, "chapter_id": 5494, "verse_number": "९", "content_sanskrit": "आगमद् द्वारकावासी समाप्तः पुरुषो नृप ।\nसोऽद्राक्षीत् पाण्डवश्रेष्ठं बहुसङ्ग्रामकर्शितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210094, "chapter_id": 5494, "verse_number": "१०", "content_sanskrit": "समीपे च महाबाहुमाचष्ट मम स प्रभो ।\nकुरु कार्याणि कौन्तेय हयमेधार्थसिद्धये ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210095, "chapter_id": 5494, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210096, "chapter_id": 5494, "verse_number": "११", "content_sanskrit": "इत्युक्तः प्रत्युवाचैनं धर्मराजो युधिष्ठिरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210097, "chapter_id": 5494, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210098, "chapter_id": 5494, "verse_number": "१२", "content_sanskrit": "दिष्ट्या स कुशली जिष्णुरुपयातः स माधव ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210099, "chapter_id": 5494, "verse_number": "१३", "content_sanskrit": "तव यत् सन्दिदेशासौ पाण्डवानां बलाग्रणीः ।\nतदाख्यातुमिहेच्छामि भवता कुरुनन्दन ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210100, "chapter_id": 5494, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2210101, "chapter_id": 5494, "verse_number": "१४", "content_sanskrit": "इत्युक्तो राजशार्दूल वृष्ण्यन्धकपतिस्तदा ।\nप्रोवाचेदं वचो वाग्मी धर्मात्मानं युधिष्ठिरम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2210102, "chapter_id": 5494, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2210103, "chapter_id": 5494, "verse_number": "१५", "content_sanskrit": "इदमाह महाराज पार्थवाक्यं नरेश्वर ।\nयद्वाच्यं भवता कष्ण काले वाक्यमिदं मम ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2210104, "chapter_id": 5494, "verse_number": "१६", "content_sanskrit": "आगमिष्यन्ति राजानः सर्वतः कौरवान् प्रति ।\nतेभ्य एकैकशः पूजा कार्येत्येतत् क्षमं हितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2210105, "chapter_id": 5494, "verse_number": "१७", "content_sanskrit": "इत्येतद् वचनाद् राजा विज्ञाप्यो मम मानद ।\nन तदाप्यायिकं न स्याद् यदर्घ्यानयने भवेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2210106, "chapter_id": 5494, "verse_number": "१८", "content_sanskrit": "कर्तुमर्हति तद् राजा भवांश्चाप्यनुमन्यताम् ।\nराजानो न विनश्येयुर्नेमा राजन् प्रजाः पुनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2210107, "chapter_id": 5494, "verse_number": "१९", "content_sanskrit": "इदमन्यच्च कौरव्य वचः स पुरुषोऽब्रवीत् ।\nधनञ्जयस्य नृपते तन्मे निगदतः शृणु ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2210108, "chapter_id": 5494, "verse_number": "२०", "content_sanskrit": "‘उपायास्यति यज्ञं नो मणलूरपतिर्नृपः ।\nपुत्रो मम महातेजा दयितो बभ्रुवाहनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2210109, "chapter_id": 5494, "verse_number": "२१", "content_sanskrit": "तं भवान् मदपेक्षार्थं विधिवत् प्रतिपूजयेत् ।\nस हि भक्तोऽनुरक्तश्च मम नित्यमि’ति प्रभो ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2210110, "chapter_id": 5494, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2210111, "chapter_id": 5494, "verse_number": "२२", "content_sanskrit": "इत्येतद् वचनं श्रुत्वा धर्मराजो युधिष्ठिरः ।\nअभिनन्द्य स तद्वाक्यमिदं वचनमब्रवीत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2210112, "chapter_id": 5494, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अर्जुनरहस्यवचनकथनं नाम अष्टाशीतितमोऽध्यायः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]