[{"id": 50012479, "chapter_id": 11493, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50012480, "chapter_id": 11493, "verse_number": "2", "content_sanskrit": "ऊचतुर्मृतकोपान्ते पतितं मृतकोपमम्। शोकाभिभूतं राजानं बोधयन्तौ सदुक्तिभिः॥ ६/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50012481, "chapter_id": 11493, "verse_number": "3", "content_sanskrit": "कोऽयं स्यात् तव राजेन्द्र भवान् यमनुशोचति। त्वं चास्य कतमः सृष्टौ पुरेदानीमतः परम्॥ ६/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50012482, "chapter_id": 11493, "verse_number": "4", "content_sanskrit": "यथा प्रयान्ति संयान्ति स्रोतोवेगेन वालुकाः। संयुज्यन्ते वियुज्यन्ते तथा कालेन देहिनः॥ ६/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50012483, "chapter_id": 11493, "verse_number": "5", "content_sanskrit": "यथा धानासु वै धाना भवन्ति न भवन्ति च। एवं भूतेषु भूतानि चोदितानीशमायया॥ ६/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50012484, "chapter_id": 11493, "verse_number": "6", "content_sanskrit": "वयं च त्वं च ये चेमे तुल्यकालाश्चराचराः। जन्ममृत्योर्यथा पश्चात् प्राक् चैवमधुना विभो॥ ६/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50012485, "chapter_id": 11493, "verse_number": "7", "content_sanskrit": "भूतैर्भूतानि भूतेशः सृजत्यवति हन्त्यजः। आत्मसृष्टैरस्वतन्त्रैरनपेक्षोऽपि बालवत्२॥ ६/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50012486, "chapter_id": 11493, "verse_number": "8", "content_sanskrit": "देहेन देहिनो राजन् देहाद् देहोऽभिजायते। बीजादेव यथा बीजं देह्यर्थ इव शाश्वतः॥ ६/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50012487, "chapter_id": 11493, "verse_number": "9", "content_sanskrit": "देहदेह्यविभागोऽयमविवेककृतः पुरा। जातिव्यक्तिविभागोऽयं यथा वस्तुनि कल्पितः॥ ६/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50012488, "chapter_id": 11493, "verse_number": "10", "content_sanskrit": "नानात्वं जन्म नाशश्च क्षयो वृद्धिः क्रियाफलम्। द्रष्टुश्च भान्त्यतद्धर्मा यथाऽग्नेर्दाह्यविक्रियाः३॥ ९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50012489, "chapter_id": 11493, "verse_number": "11", "content_sanskrit": "त इमे देहसंयोगादात्मन्याभान्त्यसद्ग्रहात्। स्वप्ने यथा तथा नान्यद् ध्यायेत् सर्वं भयं च यत्॥ ६/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50012490, "chapter_id": 11493, "verse_number": "12", "content_sanskrit": "प्रसुप्तस्यानहम्मानान्न घोरा भाति संसृतिः। जीवतोऽपि यथा तद्वद् विमुक्तस्यानहम्मतेः॥ ६/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50012491, "chapter_id": 11493, "verse_number": "13", "content_sanskrit": "तस्मादन्यन्मनोमात्रं जह्यहम्ममतां तमः४। वासुदेवे भगवति मनो धेह्यात्मनीश्वरे॥ ६/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50012492, "chapter_id": 11493, "verse_number": "14", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50012493, "chapter_id": 11493, "verse_number": "15", "content_sanskrit": "एवमाश्वासितो राजा चित्रकेतुर्द्विजोक्तिभिः। प्रमृज्य पाणिना वक्त्रमाधिम्लानमभाषत॥ ६/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50012494, "chapter_id": 11493, "verse_number": "16", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50012495, "chapter_id": 11493, "verse_number": "17", "content_sanskrit": "कौ युवां ज्ञानसम्पन्नौ महिष्ठौ च महीयसाम्। अवधूतेन वेषेण गूढाविह समागतौ॥ ६/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50012496, "chapter_id": 11493, "verse_number": "18", "content_sanskrit": "चरन्ति ह्यवनौ कामं ब्राह्मणा भगवत्प्रियाः। मादृशां ग्राम्यबुद्धीनां बोधायोन्मत्तलिङ्गिनः॥ ६/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50012497, "chapter_id": 11493, "verse_number": "19", "content_sanskrit": "कुमारो नारद ऋभुरङ्गिरा देवलोऽसितः। अपान्तरतमो व्यासो मार्कण्डेयोऽथ गौतमः॥ ६/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50012498, "chapter_id": 11493, "verse_number": "20", "content_sanskrit": "वसिष्ठो भगवान् रामः कपिलो बादरायणिः। दूर्वासा याज्ञवल्क्यश्च जातूकर्ण्यस्तथाऽऽरुणिः॥ ६/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50012499, "chapter_id": 11493, "verse_number": "21", "content_sanskrit": "रोमशश्च्यवनो दत्त आसुरिः सपतञ्जलिः। पराशरोऽथ मैत्रेयो भरद्वाजश्च आरुणः। ऋषिर्वेदशिरा बोध्यो मुनिः पञ्चशिखस्तथा॥ ६/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50012500, "chapter_id": 11493, "verse_number": "22", "content_sanskrit": "हिरण्यनाभः कौशल्यः श्रुतदेवः क्रतुध्वजः। एते परे च सिद्धेशाश्चरन्ति ज्ञानहेतवः॥ ६/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50012501, "chapter_id": 11493, "verse_number": "23", "content_sanskrit": "तस्माद् युवां ग्राम्यपशोर्मम मुग्धधियः प्रभू। अन्धे तमसि मग्नस्य ज्ञानदीप उदीर्यताम्॥ ६/१५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50012502, "chapter_id": 11493, "verse_number": "24", "content_sanskrit": "अङ्गिरा उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50012503, "chapter_id": 11493, "verse_number": "25", "content_sanskrit": "अहं ते पुत्रकामस्य पुत्रदोऽस्म्यङ्गिरा नृप। एष ब्रह्मसुतः साक्षान्नारदो भगवान् ऋषिः॥ ६/१५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50012504, "chapter_id": 11493, "verse_number": "26", "content_sanskrit": "इत्थं त्वां पुत्रशोकेन मग्नं तमसि दुस्तरे। अतदर्हमनुस्मृत्य महापुरुषगोचरम्॥ ६/१५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50012505, "chapter_id": 11493, "verse_number": "27", "content_sanskrit": "अनुग्रहाय भवतः प्राप्तावावामिह प्रभो। ब्रह्मण्यो भगवद्भक्तो नावसीदितुमर्हति॥ ६/१५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50012506, "chapter_id": 11493, "verse_number": "28", "content_sanskrit": "तदैव ते परं ज्ञानं ददामि गृहमागतः। ज्ञात्वाऽन्याभिनिवेशं ते पुत्रमेवाददामहम्॥ ६/१५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50012507, "chapter_id": 11493, "verse_number": "29", "content_sanskrit": "अधुना पुत्रिणां तापो भवतैवानुभूयते। एवं दारा गृहा रायो विविधैश्वर्यसम्पदः॥ ६/१५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50012508, "chapter_id": 11493, "verse_number": "30", "content_sanskrit": "शब्दादयश्च विषयाश्चला राजन् विभूतयः। राज्यं मही बलं कोशो भृत्यामात्यसुहृज्जनाः॥ ६/१५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50012509, "chapter_id": 11493, "verse_number": "31", "content_sanskrit": "सर्वेऽपि शूरसेनेमे शोकमोहभयार्तिदाः। गन्धर्वनगरप्रख्याः स्वप्नमायामनोरथाः॥ ६/१५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50012510, "chapter_id": 11493, "verse_number": "32", "content_sanskrit": "दृश्यमाना विनाऽर्थेन न दृश्यन्ते मनोभवाः। कर्माभिध्यायतो नाना कर्माणि मनसोऽभवन्॥ ६/१५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50012511, "chapter_id": 11493, "verse_number": "33", "content_sanskrit": "अयं हि देहिनो देहो द्रव्यज्ञानक्रियात्मकः। देहिनो विविधक्लेशसन्तापकृदुदाहृतः॥ ६/१५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50012512, "chapter_id": 11493, "verse_number": "34", "content_sanskrit": "तस्मात् स्वस्थेन मनसा विमृश्य गतिमात्मनः। द्वैते ध्रुवार्थविस्रम्भं त्यजोपशममाविश॥ ६/१५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50012513, "chapter_id": 11493, "verse_number": "35", "content_sanskrit": "भोजो नाम नृपः स्वप्ने शत्रुग्रस्तान्नभोजनः। दुःखं दुर्विषहं प्राप्तः शोकमोहभयार्तिदम्॥ ६/१५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50012514, "chapter_id": 11493, "verse_number": "36", "content_sanskrit": "केचिद् विलुलुपुर्भोगानपरेऽवधिषुः श्रितान्। पूर्ववैरग्रहैर्जाया अन्य आत्मशिरोऽहरन्॥ ६/१५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50012515, "chapter_id": 11493, "verse_number": "37", "content_sanskrit": "इत्थं दुरन्तदुःखौघादुत्थितस्तदनुस्मरन्। तावद् भृशं स निर्विण्णो निर्जगाम ततो गृहात्॥ ६/१५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50012516, "chapter_id": 11493, "verse_number": "38", "content_sanskrit": "दर्शयन्नात्मनाऽऽत्मानं निस्सङ्गः शान्तविग्रहः। प्रविष्टो ब्रह्म निर्वाणं कुलायं नाविदच्च तम्॥ ६/१५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50012517, "chapter_id": 11493, "verse_number": "39", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50012518, "chapter_id": 11493, "verse_number": "40", "content_sanskrit": "इमां मन्त्रोपनिषदं प्रतीच्छ प्रयतो मम। यां धारयन् सप्तरात्राद् द्रष्टा सङ्कर्षणं प्रभुम्॥ ६/१५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50012519, "chapter_id": 11493, "verse_number": "41", "content_sanskrit": "यत्पादमूलमुपसृत्य नरेन्द्र पूर्वे शर्वादयो भ्रममिमं द्वितयं विसृज्य। सद्यस्तदीयमतुलानधिकं महित्वं प्रापुर्भवानपि परं नचिरादुपैति॥ ६/१५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50012520, "chapter_id": 11493, "verse_number": "42", "content_sanskrit": "इति श्रीमद्भागवते षष्ठस्कन्धे पञ्चदशोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]