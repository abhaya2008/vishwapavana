[{"id": 2144717, "chapter_id": 4117, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2144718, "chapter_id": 4117, "verse_number": "१", "content_sanskrit": "एवं सनत्सुजातेन विदुरेण च धीमता ।\nसार्धं कथयतो राज्ञः सा व्यतीताय शर्वरी\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2144719, "chapter_id": 4117, "verse_number": "२", "content_sanskrit": "तस्यां रजन्यां व्युष्टायां राजानः सर्वपार्थिवाः ।\nसभामाविविशुर्हृष्टाः सूतस्योपदिदृक्षया\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2144720, "chapter_id": 4117, "verse_number": "३", "content_sanskrit": "शुश्रूषमाणाः पार्थानां वाचो धर्मार्थसंहिताः ।\nधृतराष्ट्रमुखाः सर्वे ययू राजन् सभां शुभाम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2144721, "chapter_id": 4117, "verse_number": "४", "content_sanskrit": "सुधावदातां सम्पूर्णकनकाजिरभूषणाम् ।\nचन्द्रप्रभां सुरुचिरां सिक्तां चन्दनवारिणा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2144722, "chapter_id": 4117, "verse_number": "५", "content_sanskrit": "रुचिरैरासनैः तीर्णां काञ्चनैर्दारवैरपि ।\nअश्मसारमयैर्दान्तैः स्वास्तीर्णैः सोत्तरच्छदैः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2144723, "chapter_id": 4117, "verse_number": "६", "content_sanskrit": "भीष्मो द्रोणः कृपः शल्यः कृतवर्मा जयद्रथः ।\nअश्वत्थामा विकर्णश्च सोमदत्तश्च बाह्लिकः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2144724, "chapter_id": 4117, "verse_number": "७", "content_sanskrit": "विदुरश्च महाप्राज्ञो युयुत्सुश्च महारथः ।\nसर्वे च सहिताः शूराः पार्थिवा भरतर्षभ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2144725, "chapter_id": 4117, "verse_number": "८", "content_sanskrit": "धृतराष्ट्रं पुरस्कृत्य विविशुस्तां सभां शुभाम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2144726, "chapter_id": 4117, "verse_number": "९", "content_sanskrit": "दुःशासनश्चित्रसेनः शकुनिश्चापि सौबलः ।\nदुर्मुखो दुःसहः कर्ण उलूकोऽथ विविंशतिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2144727, "chapter_id": 4117, "verse_number": "१०", "content_sanskrit": "एते चान्ये च बहवः पार्थिवा भरतर्षभ ।\nकुरुराजं पुरस्कृत्य दुर्योधनममर्षणम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2144728, "chapter_id": 4117, "verse_number": "११", "content_sanskrit": "विविशुस्तां सभां राजन् सुराः शक्रसदो यथा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2144729, "chapter_id": 4117, "verse_number": "१२", "content_sanskrit": "आविशद्भिस्तथा राजन् शूरैः परिघबाहुभिः ।\nशुशुभे सा सभा राजन् सिंहैरिव गिरेर्गुहा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2144730, "chapter_id": 4117, "verse_number": "१३", "content_sanskrit": "ते प्रविश्य महेष्वासाः सभां सर्वे महौजसः ।\nआसनानि विचित्राणि भेजिरे सूर्यवर्चसः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2144731, "chapter_id": 4117, "verse_number": "१४", "content_sanskrit": "आसनस्थेषु सर्वेषु तेषु राजसु भारत ।\nद्वाःस्थो निवेदयामास सूतपुत्रमुपस्थितम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2144732, "chapter_id": 4117, "verse_number": "१५", "content_sanskrit": "अयं स रथ आयाति योऽयासीत् पाण्डवान् प्रति ।\nदूतो नस्तूर्णमायातः सैन्धवैः साधुवाहिभिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2144733, "chapter_id": 4117, "verse_number": "१६", "content_sanskrit": "उपेयाय स तु क्षिप्रं रथात् प्रस्कन्द्य कुण्डली ।\nप्रविवेश सभां पूर्णां महीपालैर्महात्मभिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2144734, "chapter_id": 4117, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2144735, "chapter_id": 4117, "verse_number": "१७", "content_sanskrit": "प्राप्तोऽस्मि पाण्डवान् गत्वा मां विजानीत कौरवाः ।\nयथावयः कुरून् सर्वान् प्रतिनन्दन्ति पाण्डवाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2144736, "chapter_id": 4117, "verse_number": "१८", "content_sanskrit": "अभिवादयन्ति वृद्धांश्च वयस्यांश्च वयस्यवत् ।\nपुनश्चाभ्यवदन् पार्थाः प्रतिपूज्य यथावयः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2144737, "chapter_id": 4117, "verse_number": "१९", "content_sanskrit": "यथाऽहं धृतराष्ट्रेण शिष्टः पूर्वमितो गतः ।\nअब्रवं पाण्डवान् गत्वा तं निबोधत पार्थिवाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2144738, "chapter_id": 4117, "verse_number": "२०", "content_sanskrit": "अब्रूतां तत्र धर्मेण वासुदेवधनञ्जयौ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2144739, "chapter_id": 4117, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् उद्योगपर्वणि अष्टचत्वारिंशोऽध्यायः ॥४८॥\nव्यासाभिगमनपर्वणि प्रथमोऽध्यायः ॥१॥\n* * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]