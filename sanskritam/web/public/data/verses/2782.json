[{"id": 2083544, "chapter_id": 2782, "verse_number": "१२-२८७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083545, "chapter_id": 2782, "verse_number": "१२-२८७-१", "content_sanskrit": "अहो धर्मिष्ठता तस्य वृत्रस्यामिततेजसः।\nयस्य विज्ञानमतुलं विष्णोर्भक्तिश्च तादृशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083546, "chapter_id": 2782, "verse_number": "१२-२८७-२", "content_sanskrit": "दुर्विज्ञेयमिदं तस्य विष्णोरमिततेजसः।\nकथं वा राजशार्दूल पदं तु ज्ञातवानसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083547, "chapter_id": 2782, "verse_number": "१२-२८७-३", "content_sanskrit": "भवता कथितं ह्येतच्छ्रद्दधे चाहमच्युत।\nभूयश्च मे समुत्पन्ना बुद्धिरव्यक्तदर्शना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083548, "chapter_id": 2782, "verse_number": "१२-२८७-४", "content_sanskrit": "कथं विनिहतो वृत्रः शक्रेण भरतर्षभ।\nधार्मिको विष्णुभक्तश्च तत्त्वज्ञश्च तदन्वये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083549, "chapter_id": 2782, "verse_number": "१२-२८७-५", "content_sanskrit": "एतन्मे संशयं ब्रूहि पृच्छते भरतर्षभ।\nवृत्रः स राजशार्दूल यथा शक्रेण निर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083550, "chapter_id": 2782, "verse_number": "१२-२८७-६", "content_sanskrit": "यथा चैवाभवद्युद्धं तच्चाचक्ष्व पितामह।\nविस्तरेण महाबाहो परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083551, "chapter_id": 2782, "verse_number": "१२-२८७-७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083552, "chapter_id": 2782, "verse_number": "१२-२८७-७", "content_sanskrit": "रथेनेन्द्रः प्रयातो वै सार्धं सुरगणैः पुरा।\nददर्शाथाग्रतो वृत्रं धिष्ठितं पर्वतोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083553, "chapter_id": 2782, "verse_number": "१२-२८७-८", "content_sanskrit": "योजनानां शतान्यूर्ध्वं पञ्चोन्छ्रितमरिंदम्।\nशतानि विस्तरेणाथ त्रीणि चाभ्यधिकानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083554, "chapter_id": 2782, "verse_number": "१२-२८७-९", "content_sanskrit": "तत्प्रेक्ष्य तादृशं रूपं त्रैलोक्येनापि दुर्जयम्।\nवृत्रस्य देवाः संत्रस्ता न शान्तिमुपलेभिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083555, "chapter_id": 2782, "verse_number": "१२-२८७-१०", "content_sanskrit": "शक्रस्य तु तदा राजन्नूरुस्तम्भो व्यजायत।\nभयाद्वृत्रस्य सहसा दृष्ट्वा तद्रूपमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083556, "chapter_id": 2782, "verse_number": "१२-२८७-११", "content_sanskrit": "ततो नादः समभवद्वादित्राणां च निःस्वनः।\nदेवासुराणां सर्वेषां तस्मिन्युद्धे ह्युपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083557, "chapter_id": 2782, "verse_number": "१२-२८७-१२", "content_sanskrit": "अथ वृत्रस्य कौरव्य दृष्ट्वा शक्रमवस्थितम्।\nन संभ्रमो न भीः काचिदास्था वा समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083558, "chapter_id": 2782, "verse_number": "१२-२८७-१३", "content_sanskrit": "ततः समभवद्युद्धं त्रैलोक्यस्य भयंकरम्।\nशक्रस्य च सुरेन्द्रस्य वृत्रस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083559, "chapter_id": 2782, "verse_number": "१२-२८७-१४", "content_sanskrit": "असिभिः पट्टसैः शूलैः शक्तितोमरम्रुद्गरैः।\nशिलाभिर्विविधाभिश्च कार्मुकैश्च महास्वनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083560, "chapter_id": 2782, "verse_number": "१२-२८७-१५", "content_sanskrit": "अस्त्रैश्च विविर्धौर्दिव्यैः पावकोल्काभिरेव च।\nदेवासुरैस्ततः सैन्यैः सर्वमासीत्समाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2083561, "chapter_id": 2782, "verse_number": "१२-२८७-१६", "content_sanskrit": "पितामहपुरोगाश्च सर्वे देवगणास्तदा।\nऋषयश्च महाभागास्तद्युद्धं द्रष्टुमागमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2083562, "chapter_id": 2782, "verse_number": "१२-२८७-१७", "content_sanskrit": "विमानाग्र्यैर्महाराज सिद्धाश्च भरतर्षभ।\nगन्धर्वाश्च विमानाग्रैरप्सरोभिः समागमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2083563, "chapter_id": 2782, "verse_number": "१२-२८७-१८", "content_sanskrit": "ततोऽन्तरिक्षमावृत्य वृत्रो धर्मभूतां वरः।\nअश्मवर्षेण देवेन्द्रं सर्वतः समवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2083564, "chapter_id": 2782, "verse_number": "१२-२८७-१९", "content_sanskrit": "ततो देवगणाः क्रुद्धाः सर्वतः शरवृष्टिभिः।\nअश्मवर्षमपोहन्त वृत्रप्रेरितमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2083565, "chapter_id": 2782, "verse_number": "१२-२८७-२०", "content_sanskrit": "वृत्रस्तु कुरुशार्दूल महामायो महाबलः।\nमोहयामास देवेन्द्रं मायायुद्धेन सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2083566, "chapter_id": 2782, "verse_number": "१२-२८७-२१", "content_sanskrit": "तस्य वृत्रार्दितस्याथ मोह आसीच्छतक्रतोः।\nरथन्तरेण तं तत्र वसिष्ठः समबोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2083567, "chapter_id": 2782, "verse_number": "१२-२८७-२२x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2083568, "chapter_id": 2782, "verse_number": "१२-२८७-२२", "content_sanskrit": "देवश्रेष्ठोऽस्ति देवेन्द्र दैत्यासुरनिबर्हण।\nत्रैलोक्यबलसंयुक्तः कस्माच्छक्र विषीदसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2083569, "chapter_id": 2782, "verse_number": "१२-२८७-२३", "content_sanskrit": "एष ब्रह्मा च विष्णुश्च शिवश्चैव जगत्पतिः।\nसोमश्च भगवान्देवः सर्वे च परमर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2083570, "chapter_id": 2782, "verse_number": "१२-२८७-२४", "content_sanskrit": "`समुद्विग्नं समीक्ष्य त्वां स्वस्तीत्यूचुर्जयाय ते।\nमा कार्षीः कश्मलं शक्र कश्चिदेवेतरो यथा।\nआर्यां युद्धे मतिं कृत्वा जहि शत्रून्सुराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2083571, "chapter_id": 2782, "verse_number": "१२-२८७-२५", "content_sanskrit": "एष लोकगुरुस्त्र्यक्षः सर्वलोकनमस्कृतः।\nनिरीक्षते त्वां भगवांस्त्यज मोहं सुराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2083572, "chapter_id": 2782, "verse_number": "१२-२८७-२६", "content_sanskrit": "एते ब्रह्मर्षयश्चैव बृहस्पतिपुरोगमाः।\nस्तवेन शक्र दिव्येन स्तुवन्ति त्वां जयाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2083573, "chapter_id": 2782, "verse_number": "१२-२८७-२७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2083574, "chapter_id": 2782, "verse_number": "१२-२८७-२७", "content_sanskrit": "एवं संबोध्यमानस्य वसिष्ठेन महात्मना।\nअतीव वासवस्यासीद्बलमुत्तमतेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2083575, "chapter_id": 2782, "verse_number": "१२-२८७-२८", "content_sanskrit": "ततो बुद्धिमुपागम्य भगवान्पाकशासनः।\nयोगेन महता युक्तस्तां मायां व्यपकर्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2083576, "chapter_id": 2782, "verse_number": "१२-२८७-२९", "content_sanskrit": "ततोऽङ्गिरः सुतः श्रीमांस्ते चैव सुमहर्षयः।\nदृष्ट्वा वृत्रस्य विक्रान्तुमुपागम्य महेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2083577, "chapter_id": 2782, "verse_number": "१२-२८७-३०", "content_sanskrit": "ऊचुर्वृत्रविनाशार्थं लोकानां हितकाम्यया।\nततो भगवतस्तेजो ज्वरो भूत्वा जगत्पतेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2083578, "chapter_id": 2782, "verse_number": "१२-२८७-३१", "content_sanskrit": "समाविशत्तदा रौद्रं वृत्रं लोकपतिं तदा।\nविष्णुश्च भगवान्देवः सर्वलोकाभिपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2083579, "chapter_id": 2782, "verse_number": "१२-२८७-३२", "content_sanskrit": "ऐन्द्रं समाविशुद्वज्रं लोकसंरक्षणे रतः।\nततो बृहस्पतिर्धीमानुपागम्य शतक्रतुम्।\nवसिष्ठश्च महातेजाः सर्वे च परमर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2083580, "chapter_id": 2782, "verse_number": "१२-२८७-३३", "content_sanskrit": "ते समासाद्य वरदं वासवं लोकपूजितम्।\nऊचुरेकाग्रमनसो जहि वृत्रमिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2083581, "chapter_id": 2782, "verse_number": "१२-२८७-३४x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2083582, "chapter_id": 2782, "verse_number": "१२-२८७-३४", "content_sanskrit": "एष वृत्रो महाञ्शक्रे बलेन महता वृतः।\nविश्वात्मा सर्वगश्चैव बहुमायश्च विश्रुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2083583, "chapter_id": 2782, "verse_number": "१२-२८७-३५", "content_sanskrit": "तदेनमसुरश्रेष्ठं त्रैलोक्येनापि दुर्जयम्।\nजहि त्वं योगमास्थाय मावमंस्थाः सुरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2083584, "chapter_id": 2782, "verse_number": "१२-२८७-३६", "content_sanskrit": "अनेन हि तपस्तप्तं बलार्थममराधिप।\nषष्टिं वर्षसहस्राणि ब्रह्मा चास्मै वरं ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2083585, "chapter_id": 2782, "verse_number": "१२-२८७-३७", "content_sanskrit": "महत्त्वं योगिनां चैव महामायत्वमेव च।\nमहाबलत्वं च तथा तेजश्चाग्र्यं सुरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2083586, "chapter_id": 2782, "verse_number": "१२-२८७-३८", "content_sanskrit": "एतत्त्वां मामकं तेजः समाविशति वासव।\nवृत्रमेवं त्ववध्यं तं वज्रेण जहि दानवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2083587, "chapter_id": 2782, "verse_number": "१२-२८७-३९x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2083588, "chapter_id": 2782, "verse_number": "१२-२८७-३९", "content_sanskrit": "भगवंस्त्वत्प्रसादेन दितिजं सुदुरासदम्।\nवज्रेण निहनिष्यामि पश्यतस्ते सुरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2083589, "chapter_id": 2782, "verse_number": "१२-२८७-४०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2083590, "chapter_id": 2782, "verse_number": "१२-२८७-४०", "content_sanskrit": "आविश्यमाने दैत्ये तु ज्वरेणाथ महासुरे।\nदेवतानामृषीणां च हर्षान्नादो महानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2083591, "chapter_id": 2782, "verse_number": "१२-२८७-४१", "content_sanskrit": "ततो दुन्दुभयश्चैव शङ्ख्याश्च सुमहास्वनाः।\nमुरजा डिण्डिभाश्चैव प्रावाद्यन्त सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2083592, "chapter_id": 2782, "verse_number": "१२-२८७-४२", "content_sanskrit": "असुराणां तु सर्वेषां स्मृतिलोपो महानभूत्।\nमायानाशश्च बलवान्क्षणेन समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2083593, "chapter_id": 2782, "verse_number": "१२-२८७-४३", "content_sanskrit": "तमाविष्टमथो ज्ञात्वा ऋषयो देवतास्तथा।\nस्तुवन्तः शक्नमीशानं तथा प्राचोदयन्नपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2083594, "chapter_id": 2782, "verse_number": "१२-२८७-४४", "content_sanskrit": "रथस्थस्य हि शक्रस्य युद्धकाले महात्मनः।\nऋषिभिः स्तूयमानस्य रूपमासीन्सुदुर्दृशम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2083595, "chapter_id": 2782, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्ताशीत्यधिकद्विशततमोऽध्यायः॥ २८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]