[{"id": 7001727000, "chapter_id": 21727, "verse_number": "१-११३-१", "content_sanskrit": "सनातन उवाचग ।\nश्रृणु विप्र प्रवक्ष्यामि चतुर्थ्यास्ते व्रतान्यहम् ।\nयानि कृत्वा नरा नार्योऽभीष्टान्कामानवाप्नुयुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001727001, "chapter_id": 21727, "verse_number": "१-११३-२", "content_sanskrit": "चैत्रमासचतुर्थ्यां तु वासुदेवस्वरूपिणम् ।\nगणपं सम्यगभ्यर्च्य दत्त्वा कांचनदक्षिणाम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001727002, "chapter_id": 21727, "verse_number": "१-११३-३", "content_sanskrit": "विप्राय विष्णुलोकं तु गच्छेद्देवनमस्कृतः ।\nवैशाखस्य चतुर्थ्यां तु प्रार्थ्यं संकर्षणाह्वयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001727003, "chapter_id": 21727, "verse_number": "१-११३-४", "content_sanskrit": "गृहस्थद्विजमुख्येभ्यः शंखं दत्त्वा विधानवित् ।\nप्राप्य संकर्षणं लोकं मोदते बहुकल्पकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001727004, "chapter_id": 21727, "verse_number": "१-११३-५", "content_sanskrit": "ज्येष्ठमासचतुर्थ्यां तु प्रार्च्य प्रद्युम्नरूपिणम् ।\nफलं मूलं च युथेभ्यो दत्त्वा स्वर्गं लभेन्नरः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001727005, "chapter_id": 21727, "verse_number": "१-११३-६", "content_sanskrit": "आषाढस्य चतुर्थ्यां तु संप्रपूज्यानिरुद्धकम् ।\nयतिभ्योऽलाबुपात्राणि दत्त्वाभीष्टं लभेन्नरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001727006, "chapter_id": 21727, "verse_number": "१-११३-७", "content_sanskrit": "चतुर्मूर्तिव्रतान्येवं कृत्वा द्वादशवत्सरम् ।\nउद्यापनं विधानेन कर्तव्यं फलमिच्छता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001727007, "chapter_id": 21727, "verse_number": "१-११३-८", "content_sanskrit": "अन्यज्ज्येष्ठचतुर्थ्यां तु सतीव्रतमनुत्तमम् ।\nकृत्वा गणपतेर्मातुर्लोके मोदेत तत्समम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001727008, "chapter_id": 21727, "verse_number": "१-११३-९", "content_sanskrit": "तथाऽऽषाढचतुर्थ्यां तु व्रतमन्यच्छुभावहम् ।\nरथंतराह्वकल्पस्य ह्यादिभूतं दिनं यतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001727009, "chapter_id": 21727, "verse_number": "१-११३-१०", "content_sanskrit": "श्रद्धापूतेन मनसा गणेशं विधिना नरः ।\nपूजयित्वा लभेच्चापि फलं देवादिदुर्गमम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001727010, "chapter_id": 21727, "verse_number": "१-११३-११", "content_sanskrit": "श्रावणस्य चतुर्थ्यां तु जाति चंद्रोदये मुने ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001727011, "chapter_id": 21727, "verse_number": "१-११३-१२", "content_sanskrit": "गणेशाय प्रदद्याच्च ह्यर्घ्यं विधिविदांवरः ।\nलम्बोदरं चतुर्बाहुं त्रिनेत्रं रक्तवर्णकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001727012, "chapter_id": 21727, "verse_number": "१-११३-१३", "content_sanskrit": "नानारत्नविभूषाढ्यं प्रसन्नास्यं विचिंतयेत् ।\nआवाहनादिभिः सर्वैरुपचारैः समर्चयेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001727013, "chapter_id": 21727, "verse_number": "१-११३-१४", "content_sanskrit": "नैवेद्यं मोदकं दद्याद्गणेशप्रीतिदायकम् ।\nएवं व्रतं विधायाथ भुक्त्वा मोदकमेव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001727014, "chapter_id": 21727, "verse_number": "१-११३-१५", "content_sanskrit": "सुखं स्वप्यान्निशायां तु भूमावेव कृतार्चनः ।\nव्रतस्यास्य प्रभावेण कामान्मनसि चिंतितान् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001727015, "chapter_id": 21727, "verse_number": "१-११३-१६", "content_sanskrit": "लब्ध्वा लेके परं चापि गणेशपदमाप्नुयात् ।\nनानेन सदृशं चान्यद्व्रतमस्ति जगत्त्रये ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001727016, "chapter_id": 21727, "verse_number": "१-११३-१७", "content_sanskrit": "तस्मात्कार्यं प्रयत्नेन सर्वान्कामानभीप्सता ।\nअथास्मिन्नेव दिवसे दूर्वागणपति व्रतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001727017, "chapter_id": 21727, "verse_number": "१-११३-१८", "content_sanskrit": "केचिदिच्छंति देवर्षे तद्विधानं वदामि ते ।\nहैमं निर्माय गणपं ताम्रपात्रोपरि स्थितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001727018, "chapter_id": 21727, "verse_number": "१-११३-१९", "content_sanskrit": "वेष्टितं रक्तवस्त्रेण सर्वतोभद्रमंडले ।\nपूजयेद्रक्तकुसुमैः पत्रिकाभिश्च पंचभिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001727019, "chapter_id": 21727, "verse_number": "१-११३-२०", "content_sanskrit": "बिल्वपत्रमपामार्गं शमी दूर्वा हरिप्रिया ।\nआभिरन्यश्च कुसुमैरभ्यर्च्य फलमोदकैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001727020, "chapter_id": 21727, "verse_number": "१-११३-२१", "content_sanskrit": "आचार्याय विधिज्ञाय सत्कृत्य विनिवेदयेत् ।\nउपहारं प्रकल्प्याथ दद्यादर्घं समुद्यते ।\nततः संप्रारथ्य विघ्नेशमूर्तिं सोपस्करां मुने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001727021, "chapter_id": 21727, "verse_number": "१-११३-२२", "content_sanskrit": "आचार्याय विधिज्ञाय सत्कृत्य विनिवेदयेत् ।\nकृत्वैवं पंच वर्षाणि समुपास्य यथाविधि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001727022, "chapter_id": 21727, "verse_number": "१-११३-२३", "content_sanskrit": "भुक्त्वेह भोगानखिलान् लोकं गणपतेर्व्रजेत् ।\nअथ भाद्रचतुर्थ्यां तु बहुलाधेनुसंज्ञकम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001727023, "chapter_id": 21727, "verse_number": "१-११३-२४", "content_sanskrit": "पूजनी योऽत्र यत्नेन स्रग्गंधयवसादिभिः ।\nततः प्रदक्षिणीकृत्य शक्तश्चेद्दानमाचरेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001727024, "chapter_id": 21727, "verse_number": "१-११३-२५", "content_sanskrit": "अशक्तः पुरेतां तु नमस्कृत्य विसर्जयेत् ।\nपंचाब्दं वादशाब्दं वा षोडशाब्दमथापि वा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001727025, "chapter_id": 21727, "verse_number": "१-११३-२६", "content_sanskrit": "व्रतं कृत्वा समुद्याप्य धेनुं दद्यात्पयस्विनीम् ।\nप्रभावेण व्रतस्यास्य भुक्त्वा भोगान्मनोरमान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001727026, "chapter_id": 21727, "verse_number": "१-११३-२७", "content_sanskrit": "सत्कृतो देवतावृंदैर्गोलोकं समवाप्नुयात् ।\nअथ शुक्ल चतुर्थ्यां तु सिद्धवैनायकव्रतम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001727027, "chapter_id": 21727, "verse_number": "१-११३-२८", "content_sanskrit": "आवाहनादिभिः सर्वैरुपचारैः समर्चनम् ।\nएकाग्रमानसो भूत्वा ध्यायेत्सिद्धिविनायकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001727028, "chapter_id": 21727, "verse_number": "१-११३-२९", "content_sanskrit": "एकदंतं शूर्पकर्णं गजवक्त्रं चतुर्भुजम् ।\nपाशांकुशधरं देवं तप्तकांचनसन्निभम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001727029, "chapter_id": 21727, "verse_number": "१-११३-३०", "content_sanskrit": "एकविंशति पत्राणि चैकविंशतिनामभिः ।\nसमर्पयेद्भक्तियुक्तस्तानि नामानि वै श्रृणु ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001727030, "chapter_id": 21727, "verse_number": "१-११३-३१", "content_sanskrit": "सुमुखाय शमीपत्रं गणाधीशाय भृंगजम् ।\nउमापुत्राय बैल्वं तु दूर्वां गजमुखाय च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001727031, "chapter_id": 21727, "verse_number": "१-११३-३२", "content_sanskrit": "लंबोदराय बदरीं धत्तूरं हरसूनवे ।\nशूर्पकर्णाय तुलसीं वक्रतुंडाय शिंबिजम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001727032, "chapter_id": 21727, "verse_number": "१-११३-३३", "content_sanskrit": "गुहाग्रजायापामार्गमेकदंताय बार्हतम् ।\nहेरम्बाय तु सिंदूरं चतिर्होत्रे च पत्रजम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001727033, "chapter_id": 21727, "verse_number": "१-११३-३४", "content_sanskrit": "सर्वेश्वरायागस्त्यस्य पत्रं प्रीतिविवर्द्धनम् ।\nदूर्वायुग्मं ततो गृह्य गंधपुष्पाक्षतैर्युतम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001727034, "chapter_id": 21727, "verse_number": "१-११३-३५", "content_sanskrit": "पूजां निवेदयेद्भक्तियुक्तो मोदकपंचकम् ।\nआचमय्य नमस्कृत्य संप्रार्थ्य च विसर्ज्जयेत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001727035, "chapter_id": 21727, "verse_number": "१-११३-३६", "content_sanskrit": "विनायकस्य प्रतिमां हैमीं सोपस्करां मुने ।\nनिवेदयेच्च गुरवे द्विजेभ्यो दक्षिणां ददेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001727036, "chapter_id": 21727, "verse_number": "१-११३-३७", "content_sanskrit": "एवं कृतार्चनो भक्त्या पंच वर्षाणि नारद ।\nउपास्य लभते कामानैहिकामुष्मिकान् शुभान् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001727037, "chapter_id": 21727, "verse_number": "१-११३-३८", "content_sanskrit": "अस्यां चतुर्थ्यां शशिनं न पश्येच्च कदाचन ।\nपश्यन् मिथ्याभिशाप तु लभते नात्र संशयः ।\nअथ तद्दोषनाशाय मन्त्रं पौराणिकं पठेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001727038, "chapter_id": 21727, "verse_number": "१-११३-३९", "content_sanskrit": "सिंहः प्रसेनममधीत्सिंहो जांबवता हतः ।\nसकुमारक मा रोदीस्तव ह्येष स्यमंतकः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001727039, "chapter_id": 21727, "verse_number": "१-११३-४०", "content_sanskrit": "इषशुक्लचतुर्थ्यां तु कपर्द्दीशं विनायकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001727040, "chapter_id": 21727, "verse_number": "१-११३-४१", "content_sanskrit": "पौरुषेण तु सूक्तेन पूजयेदुपचारकैः ।\nअकारणान्मुष्टिगतांस्तंडुलान्सकपर्द्दिकान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001727041, "chapter_id": 21727, "verse_number": "१-११३-४२", "content_sanskrit": "विप्राय बटवे दद्याद्गंधपुष्पार्चिताय च ।\nतंडुला वैश्वदैवत्या हरदैवत्यमिश्रिताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001727042, "chapter_id": 21727, "verse_number": "१-११३-४३", "content_sanskrit": "कपर्दिगणनाथोऽसौ प्रीयतां तैः समर्पितैः ।\nचतुर्थ्यां कार्तिके कृष्णे करकाख्यं व्रतं स्मृतम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001727043, "chapter_id": 21727, "verse_number": "१-११३-४४", "content_sanskrit": "स्त्रीणामेवाधिकारोऽत्र तद्विधानमुदीर्यते ।\nपूजयेच्च गणाधीशं स्नाता स्त्रीसमलंकृता ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001727044, "chapter_id": 21727, "verse_number": "१-११३-४५", "content_sanskrit": "तदग्रे पूर्णपक्वान्नं विन्यसेत्करकान्दश ।\nसमर्प्य देवदेवाय भक्त्या प्रयतमानसा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001727045, "chapter_id": 21727, "verse_number": "१-११३-४६", "content_sanskrit": "देवो मे प्रीयतामेवमुच्चार्य्याथ समर्पयेत् ।\nसुवासिनीभ्यो विप्रेभ्यो यथाकामं च सादरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001727046, "chapter_id": 21727, "verse_number": "१-११३-४७", "content_sanskrit": "ततश्चंद्रोदये रात्रौ दत्त्वार्घं विधिपूर्वकम् ।\nभुञ्जीत मिष्टमन्नं च व्रतस्य परिपूर्तये ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001727047, "chapter_id": 21727, "verse_number": "१-११३-४८", "content_sanskrit": "यद्वा क्षीरेण करकं पूर्णं तोयेन वा मुने ।\nसपूगाक्षतरत्नाढ्यं द्विजाय प्रतिपादयेत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001727048, "chapter_id": 21727, "verse_number": "१-११३-४९", "content_sanskrit": "एतत्कृत्वा व्रतं नारी षोडशद्वादशाब्दकम् ।\nउपायनं विधायाथ व्रतमेतद्विसर्ज्जयेत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001727049, "chapter_id": 21727, "verse_number": "१-११३-५०", "content_sanskrit": "यावज्जीवं तु वा नार्या कार्य्यं सौभाग्यवांछया ।\nव्रतेनानेन सदृशं स्त्रीणां सौभाग्यदायकम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001727050, "chapter_id": 21727, "verse_number": "१-११३-५१", "content_sanskrit": "विद्यते भुवनेष्वन्यत्तस्मान्नित्यमिति स्थितिः ।\nऊर्ज्जशुक्लचतुर्थ्यां तु नागव्रतमुदाहृतम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001727051, "chapter_id": 21727, "verse_number": "१-११३-५२", "content_sanskrit": "प्रातर्व्रतं तु संकल्प्य धेनुशृंजगलं शुचि ।\nपीत्वा स्नात्वाथ मध्याह्ने शंखपालादिपन्नगान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001727052, "chapter_id": 21727, "verse_number": "१-११३-५३", "content_sanskrit": "शेषं चाह्वामपूर्वैस्तु पूजयेदुपचारकैः ।\nक्षीरेणाप्यायनं कुर्यादेतन्नागव्रतं स्मृतम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001727053, "chapter_id": 21727, "verse_number": "१-११३-५४", "content_sanskrit": "एवंकृते तु विप्रेंद्र नृभिर्नागव्रते शुभे ।\nविषाणि नश्यंत्यचिरान्न दशंति च पन्नगाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001727054, "chapter_id": 21727, "verse_number": "१-११३-५५", "content_sanskrit": "मार्गशुक्लचतुर्थ्यां तु वर्षं यावन्मुनीश्वरा ।\nक्षपयेदेकभक्तेन नक्तेनाथ द्वितीयकम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001727055, "chapter_id": 21727, "verse_number": "१-११३-५६", "content_sanskrit": "अयाचितोपवासाभ्यां तृतीयकचतुर्थके ।\nएवं क्रमेण विधिवच्चत्वार्यब्दानि मानवः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001727056, "chapter_id": 21727, "verse_number": "१-११३-५७", "content_sanskrit": "समाप्य च ततोऽस्यांते व्रतस्नातो महाव्रती ।\nकारयेद्धेमघटितं भूगणेर्मूषकं रथम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001727057, "chapter_id": 21727, "verse_number": "१-११३-५८", "content_sanskrit": "अशक्तो वर्णकैरेव शुभ्रं चाब्जं सुपत्रकम् ।\nतस्योपरि घटं स्थाप्य ताम्रपात्रेण संयुतम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001727058, "chapter_id": 21727, "verse_number": "१-११३-५९", "content_sanskrit": "पूरयेत्तंडलैः शुभ्रैस्तस्योपरि गणेश्वरम् ।\nन्यसेद्वस्त्रयुगाच्छन्नं गंधाद्यैः पूजयेच्च तम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001727059, "chapter_id": 21727, "verse_number": "१-११३-६०", "content_sanskrit": "नैवेद्यं मोदकं कल्प्यं गणेशः प्रीयतामिति ।\nजागरैर्शीतवाद्याद्यैः पुराणाख्यानकैश्चरेत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001727060, "chapter_id": 21727, "verse_number": "१-११३-६१", "content_sanskrit": "प्रभाते विमले स्नात्वा होमं कृत्वा विधानतः ।\nतिलव्रीहियवश्वेतसुर्षपाज्यैः सखंडकैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001727061, "chapter_id": 21727, "verse_number": "१-११३-६२", "content_sanskrit": "गणो गणाधिपश्चैव कूष्मांडस्त्रिपुरांतकः ।\nलंबोदरैकदंतौ च रुक्मदंष्ट्रश्च विघ्नपः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001727062, "chapter_id": 21727, "verse_number": "१-११३-६३", "content_sanskrit": "ब्रह्मा यमोऽथ वरुणः सोमसूर्यहुताशनाः ।\nगन्धमादी परमेष्ठीत्येवं षोडशनामभिः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001727063, "chapter_id": 21727, "verse_number": "१-११३-६४", "content_sanskrit": "प्रणवाद्यैर्ङेंनमोंऽतैः प्रत्येकं दहने हुनेत् ।\nवक्रतुंडेति ङेंतेन बर्मांतेनाष्टयुक्छतम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001727064, "chapter_id": 21727, "verse_number": "१-११३-६५", "content_sanskrit": "ततो व्याहृतिभिः शक्त्या हुत्वा पूर्णाहुतिं चरेत् ।\nदिक्पालान्पूजयित्वा च ब्राह्मणान्भोजयेत्ततः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001727065, "chapter_id": 21727, "verse_number": "१-११३-६६", "content_sanskrit": "चतुत्विंशतिसंख्याकान् मोदकैः पायसैस्तथा ।\nसवत्सां गां ततो दद्यादाचार्याय सदक्षिणाम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001727066, "chapter_id": 21727, "verse_number": "१-११३-६७", "content_sanskrit": "अन्योभ्योऽपि यथाशक्ति भूयसीं च ततो ददेत् ।\nप्रणम्य दक्षिणीकृत्य प्रविसृज्य द्विजोत्तमाम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001727067, "chapter_id": 21727, "verse_number": "१-११३-६८", "content_sanskrit": "बन्धुभिः सह भुंजीत स्वयं च प्रीतमानसः ।\nएतद्व्रतं नरः कृत्वा भुक्त्वा भोगानिहोत्तमान् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001727068, "chapter_id": 21727, "verse_number": "१-११३-६९", "content_sanskrit": "सायुज्यं लभते विष्णोर्गणेशस्य प्रसादतः ।\nकेचिद्वरव्रतं नाम प्राहुरेतस्य नारद ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001727069, "chapter_id": 21727, "verse_number": "१-११३-७०", "content_sanskrit": "विधानमेतदेवापि फलं चापीह तत्समम् ।\nपौषमासचतुर्थ्यां तु विघ्नेशं प्रार्थ्य भक्तितः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001727070, "chapter_id": 21727, "verse_number": "१-११३-७१", "content_sanskrit": "विप्रैकं भोजयेच्चैवं मोदकैर्दक्षिणां ददेत् ।\nएवं कृते मुने भूयाद्व्रती संपत्तिभाजनम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001727071, "chapter_id": 21727, "verse_number": "१-११३-७२", "content_sanskrit": "माघकृष्णचतुर्थ्यां तु संकष्टव्रतमुच्यते ।\nतत्रोपवासं संकल्प्य व्रती नियमपूर्वकम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001727072, "chapter_id": 21727, "verse_number": "१-११३-७३", "content_sanskrit": "चंद्रोदयमभिव्याप्य तिष्ठेत्प्रयतमानसः ।\nततश्चंद्रोदये प्राप्ते मृन्मयं गणनायकम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001727073, "chapter_id": 21727, "verse_number": "१-११३-७४", "content_sanskrit": "विधाय विन्यसेत्पीठे सायुधं च सवाहनम् ।\nउपचारैः षोडशभिः समभ्यर्च्य विधानतः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001727074, "chapter_id": 21727, "verse_number": "१-११३-७५", "content_sanskrit": "मोदकं चापि नैवेद्यं सगुडं तिलकुट्टकम् ।\nततोऽर्घ्यं ताम्रजे पात्रे रक्तचंदनमिश्रितम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001727075, "chapter_id": 21727, "verse_number": "१-११३-७६", "content_sanskrit": "सकुशं च सदूर्वं च पुष्पाक्षतसमन्वितम् ।\nसशमीपत्रदधि च कृत्वा चंद्राय दापयेत् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001727076, "chapter_id": 21727, "verse_number": "१-११३-७७", "content_sanskrit": "गगनार्णवमाणिक्य चंद्र दाक्षायणीपते ।\nगृहाणार्घ्यं मया दत्तं गणेशप्रतिरूपक ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001727077, "chapter_id": 21727, "verse_number": "१-११३-७८", "content_sanskrit": "एवं दत्त्वा गणेशाय दिव्यार्घ्यं पापनाशनम् ।\nशक्त्या संभोज्य विप्राग्र्यान्स्वयं भुंजीत चाज्ञया ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001727078, "chapter_id": 21727, "verse_number": "१-११३-७९", "content_sanskrit": "एवं कृत्वा व्रतं विप्र संकष्टाख्यं शूभावहम् ।\nसमृद्धो धनधान्यैः स्यान्न च संकष्टमाप्नुयात् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001727079, "chapter_id": 21727, "verse_number": "१-११३-८०", "content_sanskrit": "माघशुक्लचतुर्थ्यां तु गौरीव्रतमनुत्तमम् ।\nतस्यां तु गौरी संपूज्या संयुक्ता योगिनीगणैः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001727080, "chapter_id": 21727, "verse_number": "१-११३-८१", "content_sanskrit": "नरैः स्त्रीभिर्विशेषेण कुंदपुष्पैः सकुंकुमैः ।\nरक्तसूत्रे रक्तपुष्पैस्तथैवालक्तकेन च ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001727081, "chapter_id": 21727, "verse_number": "१-११३-८२", "content_sanskrit": "धूपैर्दीपंश्च बलिभिः सगुडैनार्द्रकेण च ।\nपयसा पायसेनापि लवणेन च पालकैः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001727082, "chapter_id": 21727, "verse_number": "१-११३-८३", "content_sanskrit": "पूज्याश्चाविधवा नार्यस्तथा विप्राः सुशोभनाः ।\nसौभाग्यवृद्धये देयो भोक्तव्यं बंधुभिः सह ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001727083, "chapter_id": 21727, "verse_number": "१-११३-८४", "content_sanskrit": "इदं गौरीव्रतं विप्र सौभाग्यारोग्यवर्द्धनम् ।\nप्रतिवर्षं प्रकर्त्तव्यं नारीभिश्च नरैस्तथा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001727084, "chapter_id": 21727, "verse_number": "१-११३-८५", "content_sanskrit": "ढुंढिव्रतं परैः प्रोक्तं कैश्चित्कुंडव्रतं स्मृतम् ।\nललिताव्रतमित्यन्यैः शांतिव्रतमथापरैः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001727085, "chapter_id": 21727, "verse_number": "१-११३-८६", "content_sanskrit": "स्नानं दानं जपो होमः सर्वमस्यां कृतं मुने ।\nभवेत्सह स्रगुणितं प्रसादाद्दंतिनः सदा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001727086, "chapter_id": 21727, "verse_number": "१-११३-८७", "content_sanskrit": "चतुर्थ्यां फाल्गुने मासि ढुंढिराजव्रतं शुभम् ।\nतिलषिष्टैर्द्विजान् भोज्य स्वयं चाश्नीत मानवः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001727087, "chapter_id": 21727, "verse_number": "१-११३-८८", "content_sanskrit": "गणेशाराधनपरो दानहोमप्रपूजनैः ।\nतिलैरेव कृतैः सिद्धिं प्राप्नुयात्तत्प्रसादतः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001727088, "chapter_id": 21727, "verse_number": "१-११३-८९", "content_sanskrit": "सौवर्णं गजवक्त्रं च कृत्वा संपूज्य यत्नतः ।\nद्विजाग्र्याय प्रदातव्यं सर्वसंपत्समृद्धये ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001727089, "chapter_id": 21727, "verse_number": "१-११३-९०", "content_sanskrit": "यस्मिन्कस्मिन्भवेन्मासि चतुर्थी रविवारयुक् ।\nसांगारका वा विप्रेंद्र सा विशेषफलप्रदा ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001727090, "chapter_id": 21727, "verse_number": "१-११३-९१", "content_sanskrit": "सर्वासु च चतुर्थीषु शुक्लास्वप्यसितासु च ।\nविघ्नेश एव देवेशः संपूज्यो भक्तितत्परैः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]