[{"id": 7005451000, "chapter_id": 25451, "verse_number": "१-२१-१", "content_sanskrit": "सूत उवाच ।\nत्रिधन्वा राजपुत्रस्तु धर्मेणापालयन्महीम् ।\nतस्य पुत्रोऽभवद् विद्वांस्त्रय्यारुण इति स्मृतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005451001, "chapter_id": 25451, "verse_number": "१-२१-२", "content_sanskrit": "तस्य सत्यव्रतो नाम कुमारोऽभून्महाबलः ।\nभार्या सत्यधना नाम हरिश्चन्द्रमजीजनत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005451002, "chapter_id": 25451, "verse_number": "१-२१-३", "content_sanskrit": "हरिश्चन्द्रस्य पुत्रोऽभूद् रोहितो नाम वीर्यवान् ।\nरोहितस्य वृकः पुत्रः तस्मात्बाहुरजायत ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005451003, "chapter_id": 25451, "verse_number": "१-२१-४", "content_sanskrit": "हरितो रोहितस्याथ धुन्धुस्तस्य सुतोऽभवत् ।\nविजयश्च सुदेवश्च धुन्धुपुत्रौ बभूवतुः ।\nविजयस्याभवत् पुत्रः कारुको नाम वीर्यवान् ।\nसगरस्तस्य पुत्रौऽभूद् राजा परमधार्मिकः ।\nद्वे भार्ये सगरस्यापि प्रभा भानुमती तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005451004, "chapter_id": 25451, "verse_number": "१-२१-५", "content_sanskrit": "ताभ्यामाराधितः वह्निः प्रादादौ वरमुत्तमम् ।\nएकं भानुमती पुत्रमगृह्णादसमञ्जसम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005451005, "chapter_id": 25451, "verse_number": "१-२१-६", "content_sanskrit": "प्रभा षष्टिसहस्त्रं तु पुत्राणां जगृहे शुभा ।\nअसमञ्सस्य तनयो ह्यंशुमान् नाम पार्थिवः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005451006, "chapter_id": 25451, "verse_number": "१-२१-७", "content_sanskrit": "तस्य पुत्रो दिलीपस्तु दिलीपात् तु भगीरथः ।\nयेन भागीरथी गङ्गा तपः कृत्वाऽवतारिता ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005451007, "chapter_id": 25451, "verse_number": "१-२१-८", "content_sanskrit": "प्रसादाद् देवदेवस्य महादेवस्य धीमतः ।\nभगीरथस्य तपसा देवः प्रीतमना हरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005451008, "chapter_id": 25451, "verse_number": "१-२१-९", "content_sanskrit": "बभार शिरसा गङ्गां सोमान्ते सोमभूषणः ।\nभगीरथसुतश्चापि श्रुतो नाम बभूव ह ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005451009, "chapter_id": 25451, "verse_number": "१-२१-१०", "content_sanskrit": "नाभागस्तस्य दायादः सिन्धुद्वीपस्ततोऽभवत् ।\nअयुतायुः सुतस्तस्य ऋतुपर्णस्तु तत्सुतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005451010, "chapter_id": 25451, "verse_number": "१-२१-११", "content_sanskrit": "ऋतुपर्णस्य पुत्रोऽभूत् सुदासो नाम धार्मिकाः ।\nसौदासस्तस्य तनयः ख्यातः कल्माषपादकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005451011, "chapter_id": 25451, "verse_number": "१-२१-१२", "content_sanskrit": "वसिष्ठस्तु महातेजाः क्षेत्रे कल्माषपादके ।\nअश्मकं जनयामसा तमिक्ष्वाकुकुलध्वजम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005451012, "chapter_id": 25451, "verse_number": "१-२१-१३", "content_sanskrit": "अश्मकस्योत्कलायां तु नकुलो नाम पार्थिवः ।\nस हि रामभयाद् राजा वनं प्राप सुदुः खितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005451013, "chapter_id": 25451, "verse_number": "१-२१-१४", "content_sanskrit": "विभ्रत् स नारीकवचं तस्माच्छतरथोऽभवत् ।\nतस्माद् बिलिबिलिः श्रीमान्‌वृद्धशर्माचतत्सुतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005451014, "chapter_id": 25451, "verse_number": "१-२१-१५", "content_sanskrit": "तस्माद् विश्वसहस्तस्मात् खट्वाङ्ग इति विश्रुतः ।\nदीर्घबाहुः सुतस्तस्य रघुस्तस्मादजायत ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005451015, "chapter_id": 25451, "verse_number": "१-२१-१६", "content_sanskrit": "रघोरजः समुत्पन्नो राजा दशरथस्ततः ।\nरामो दाशरथिर्वोरो धर्मज्ञो लोकविश्रुतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005451016, "chapter_id": 25451, "verse_number": "१-२१-१७", "content_sanskrit": "भरतो लक्ष्मणश्चैव शत्रुघ्नश्च महाबलः ।\nसर्वे शक्रसमा युद्धे विष्णुशक्तिसमन्विताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005451017, "chapter_id": 25451, "verse_number": "१-२१-१८", "content_sanskrit": "जज्ञे रावणनाशार्थं विष्णुरंशेन विश्वकृत् ।\nरामस्य सुभगा भार्या जनकस्यात्मजा शुभा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005451018, "chapter_id": 25451, "verse_number": "१-२१-१९", "content_sanskrit": "सीता त्रिलोकविख्याता शीलौदार्यगुणान्विता ।\nतपसा तोषिता देवी जनकेन गिरीन्द्रजा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005451019, "chapter_id": 25451, "verse_number": "१-२१-२०", "content_sanskrit": "प्रायच्छज्जानकीं सीतां राममेवाश्रितां पतिम् ।\nप्रीतश्च भगवानीशस्त्रिशूली नीललोहितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005451020, "chapter_id": 25451, "verse_number": "१-२१-२१", "content_sanskrit": "प्रददौ शत्रुनाशार्थं जनकायाद्‌भुतं धनुः ।\nस राजा जनको विद्वान् दातुकामः सुतामिमाम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005451021, "chapter_id": 25451, "verse_number": "१-२१-२२", "content_sanskrit": "अघोषयदमित्रघ्नो लोकेऽस्मिन् द्विजपुंगवाः ।\nइदं धनुः समादातुं यः शक्नोति जगत्त्रये ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005451022, "chapter_id": 25451, "verse_number": "१-२१-२३", "content_sanskrit": "देवो वा दानवो वाऽपि स सीतां लब्धुमर्हति ।\nविज्ञाय रामो बलवान् जनकस्य गृहं प्रभुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005451023, "chapter_id": 25451, "verse_number": "१-२१-२४", "content_sanskrit": "भञ्जयामास चादाय गत्वाऽसौ लीलयैव हि ।\nउद्ववाह च तां कन्यां पार्वतीमिव शंकरः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005451024, "chapter_id": 25451, "verse_number": "१-२१-२५", "content_sanskrit": "रामः परमधर्मात्मा सेनामिव च षण्मुखः ।\nततो बहुतिथे काले राजा दशरथः स्वयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005451025, "chapter_id": 25451, "verse_number": "१-२१-२६", "content_sanskrit": "रामं ज्येष्ठं सुतं वीरं राजानं कर्तुमारभत् ।\nतस्याथ पत्नी सुभगा कैकेयी चारुभाषिणी ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005451026, "chapter_id": 25451, "verse_number": "१-२१-२७", "content_sanskrit": "निवारयामास पतिं प्राह संभ्रान्तमानसा ।\nमत्सुतं भरतं वीरं राजानं कर्त्तुमर्हसि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005451027, "chapter_id": 25451, "verse_number": "१-२१-२८", "content_sanskrit": "पूर्वमेव वरो यस्माद् दत्तो मे भवता यतः ।\nस तस्या वचनं श्रुत्वा राजा दुःखितमानसः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005451028, "chapter_id": 25451, "verse_number": "१-२१-२९", "content_sanskrit": "बाढमित्यब्रवीद् वाक्यं तथा रामोऽपि धर्मवित् ।\nप्रणम्याथ पितुः पादौ लक्ष्मणेन सहाच्युतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005451029, "chapter_id": 25451, "verse_number": "१-२१-३०", "content_sanskrit": "ययौ वनं सपत्नीकः कृत्वा समयमात्मवान् ।\nसंवत्सराणां चत्वारि दश चैव महाबलः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005451030, "chapter_id": 25451, "verse_number": "१-२१-३१", "content_sanskrit": "उवास तत्र मतिमान् लक्ष्मणेन सह प्रभुः ।\nकदाचिद् वसतोऽरण्ये रावणो नाम राक्षसः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005451031, "chapter_id": 25451, "verse_number": "१-२१-३२", "content_sanskrit": "परिव्राजकवेषेण सीतां हृत्वा ययौ पुरीम् ।\nअदृष्ट्वा लक्ष्मणो रामः सीतामाकुलितेन्द्रियौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005451032, "chapter_id": 25451, "verse_number": "१-२१-३३", "content_sanskrit": "दुः खशोकाभिसंतप्तौ बभूवतुररिंदमौ ।\nततः कदाचित् कपिना सुग्रीवेण द्विजोत्तमाः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005451033, "chapter_id": 25451, "verse_number": "१-२१-३४", "content_sanskrit": "वानराणामभूत् सख्यं रामस्याक्लिष्टकर्मणः ।\nसुग्रीवस्यानुगो वीरो हनुमान्नाम वानरः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005451034, "chapter_id": 25451, "verse_number": "१-२१-३५", "content_sanskrit": "वायुपुत्रौ महातेजा रामस्यासीत् प्रियः सदा ।\nस कृत्वा परमं धैर्यं रामाय कृतनिश्चयः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005451035, "chapter_id": 25451, "verse_number": "१-२१-३६", "content_sanskrit": "आनयिष्यामि तां सीतामित्युक्त्वा विचचार ह ।\nमहीं सागरपर्यन्तां सीतादर्शनतत्परः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005451036, "chapter_id": 25451, "verse_number": "१-२१-३७", "content_sanskrit": "जगाम रावणपुरीं लङ्कां सागरसंस्थिताम् ।\nतत्राथ निर्जने देशे वृक्ष्मूले शुचिस्मिताम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005451037, "chapter_id": 25451, "verse_number": "१-२१-३८", "content_sanskrit": "अपश्यदमलां सीतां राक्षसीभिः समावृताम् ।\nअश्रुपूर्णेक्षणां हृद्यां संस्मरन्तीमनिन्दिताम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005451038, "chapter_id": 25451, "verse_number": "१-२१-३९", "content_sanskrit": "राममिन्दीवरश्यामं लक्ष्मणं चात्मसंस्थितम् ।\nनिवेदयित्वा चात्मानं सीतायै रहसि स्वयम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005451039, "chapter_id": 25451, "verse_number": "१-२१-४०", "content_sanskrit": "असंशयाय प्रददावस्यै रामाङ्‌गुलीयकम् ।\nदृष्ट्वाऽङ्‌गुलीयकं सीता पत्युः परमशोभनम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005451040, "chapter_id": 25451, "verse_number": "१-२१-४१", "content_sanskrit": "मेने समागतं रामं प्रीतिविस्फारितेक्षणा ।\nसमाश्वास्य तदा सीतां दृष्ट्वा रामस्य चान्तिकम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005451041, "chapter_id": 25451, "verse_number": "१-२१-४२", "content_sanskrit": "नयिष्ये त्वां महाबाहुरुक्त्वा रामं ययौ पुनः ।\nनिवेदयित्वा रामाय सीतादर्शनमात्मवान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005451042, "chapter_id": 25451, "verse_number": "१-२१-४३", "content_sanskrit": "तस्थौ रामेण पुरतो लक्ष्मणेन च पूजितः ।\nततः स रामो बलवान् सार्द्धं हनुमता स्वयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005451043, "chapter_id": 25451, "verse_number": "१-२१-४४", "content_sanskrit": "लक्ष्मणेन च युद्धाय बुद्धिं चक्रे हि रक्षसाम् ।\nकृत्वाऽथ वानरशतैर्लङ्कामार्गं महोदधेः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005451044, "chapter_id": 25451, "verse_number": "१-२१-४५", "content_sanskrit": "सेतुं परमधर्मात्मा रावणं हतवान् प्रभुः ।\nसपत्नीकं च ससुतं सभ्रातृकमरिन्दमः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005451045, "chapter_id": 25451, "verse_number": "१-२१-४६", "content_sanskrit": "आनयामास तां सीतां वायुपुत्रसहायवान् ।\nसेतुमध्ये महादेवमीशानं कृत्तिवाससम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005451046, "chapter_id": 25451, "verse_number": "१-२१-४७", "content_sanskrit": "स्थापयामास लिङ्गस्थं पूजयामास राघवः ।\nतस्य देवो महादेवः पार्वत्या सह शंकरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005451047, "chapter_id": 25451, "verse_number": "१-२१-४८", "content_sanskrit": "प्रत्यक्षमेव भगवान् दत्तवान् वरमुत्तमम् ।\nयत् त्वया स्थापितं लिङ्गं द्रक्ष्यन्तीह द्विजातयः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005451048, "chapter_id": 25451, "verse_number": "१-२१-४९", "content_sanskrit": "महापातकसंयुक्तास्तेषां पापं विनंक्ष्यति ।\nअन्यानि चैव पापानि स्नातस्यात्र महोदधौ ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005451049, "chapter_id": 25451, "verse_number": "१-२१-५०", "content_sanskrit": "दर्शनादेव लिङ्गस्य नाशं यान्ति न संशयः ।\nयावत् स्थास्यन्ति गिरयो यावदेषा च मेदिनी ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005451050, "chapter_id": 25451, "verse_number": "१-२१-५१", "content_sanskrit": "यावत् सेतुश्च तावच्च स्थास्याम्यत्र तिरोहितः ।\nस्नानं दानं जपः श्राद्धं भविष्यत्यक्षयं महत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005451051, "chapter_id": 25451, "verse_number": "१-२१-५२", "content_sanskrit": "स्मरणादेव लिङ्गस्य दिनपापं प्रणश्यति ।\nइत्युक्त्वा भगवाञ्छंभुः परिष्वज्य तु राघवम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005451052, "chapter_id": 25451, "verse_number": "१-२१-५३", "content_sanskrit": "सनन्दी सगणो रुद्रस्तत्रैवान्तरधीयत ।\nरामोऽपि पालयामास राज्यं धर्मपरायणः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005451053, "chapter_id": 25451, "verse_number": "१-२१-५४", "content_sanskrit": "अभिषिक्तो महातेजा भरतेन महाबलः ।\nविशेषाढ् ब्राह्मणान् सर्वान् पूजयामसचेश्वरम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005451054, "chapter_id": 25451, "verse_number": "१-२१-५५", "content_sanskrit": "यज्ञेन यज्ञहन्तारमश्वमेधेन शंकरम् ।\nरामस्य तनयो जज्ञे कुश इत्यभिविश्रुतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005451055, "chapter_id": 25451, "verse_number": "१-२१-५६", "content_sanskrit": "लवश्च सुमहाभागः सर्वतत्त्वार्थवित् सुधीः ।\nअतिथिस्तु कुशाज्जज्ञे निषधस्तत्सुतोऽभवत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005451056, "chapter_id": 25451, "verse_number": "१-२१-५७", "content_sanskrit": "नलस्तु निषधस्याभून्नभास्तमादजायत ।\nनभसः पुण्डरीकाक्षः क्षेमधन्वा च तत्सुतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005451057, "chapter_id": 25451, "verse_number": "१-२१-५८", "content_sanskrit": "तस्य पुत्रोऽभवद् वीरो देवानीकः प्रतापवान् ।\nअहीनगुस्तस्य सुतो सहस्वांस्तत्सुतोऽभवत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005451058, "chapter_id": 25451, "verse_number": "१-२१-५९", "content_sanskrit": "तस्माच्चन्द्रावलोकस्तु तारापीडस्तु तत्सुतः ।\nतारापीडाच्चन्द्रगिरिर्भानुवित्तस्ततोऽभवत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005451059, "chapter_id": 25451, "verse_number": "१-२१-६०", "content_sanskrit": "श्रुतायुरभवत् तस्मादेते इक्ष्वाकुवंशजाः ।\nसर्वे प्राधान्यतः प्रोक्ताः समासेन द्विजोत्तमाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005451060, "chapter_id": 25451, "verse_number": "१-२१-६१", "content_sanskrit": "य इमं श्रृणुयान्नित्यमिक्ष्वाकोर्वंशमुत्तमम् ।\nसर्वपापविनिर्मुक्तो स्वर्गलोके महीयते ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]