[{"id": 7000597000, "chapter_id": 20597, "verse_number": "५-५६-१", "content_sanskrit": "शेष उवाच ।\nप्रातर्नित्यं विधायासौ ब्राह्मणान्वेदवित्तमान् ।\nहिरण्यदानैः संतर्प्य विधिवत्संसदं ययौ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000597001, "chapter_id": 20597, "verse_number": "५-५६-२", "content_sanskrit": "लोकाः सर्वे नमस्कर्तुं रघुनाथं महीपतिम् ।\nपुत्रवत्स्वप्रजाः सर्वाः पालयंतं ययुः सभाम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000597002, "chapter_id": 20597, "verse_number": "५-५६-३", "content_sanskrit": "लक्ष्मणेनातपत्रं तु धृतं मूर्धनि भूपतेः ।\nतदा भरतशत्रुघ्नौ चामरद्वंद्व धारिणौ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000597003, "chapter_id": 20597, "verse_number": "५-५६-४", "content_sanskrit": "वसिष्ठप्रमुखास्तत्र मुनयः पर्युपासत ।\nसुमंत्रप्रमुखास्तत्र मंत्रिणो न्यायकर्तृकाः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000597004, "chapter_id": 20597, "verse_number": "५-५६-५", "content_sanskrit": "एवं प्रवृत्ते समये षट्चारास्ते स्वलंकृताः ।\nसमाजग्मुर्नरपतिं नमस्कर्तुं सभास्थितम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000597005, "chapter_id": 20597, "verse_number": "५-५६-६", "content_sanskrit": "तान्वक्तुकामान्संवीक्ष्य चारान्नृपतिसत्तमः ।\nसभायामंतरावेश्म रहः प्राविशदुत्सुकः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000597006, "chapter_id": 20597, "verse_number": "५-५६-७", "content_sanskrit": "एकांते तांश्चरान्सर्वान्पप्रच्छ सुमतिर्नृपः ।\nकथयंतु चरा मह्यं यथातथ्यमरिंदमाः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000597007, "chapter_id": 20597, "verse_number": "५-५६-८", "content_sanskrit": "लोका ब्रुवंति मां कीदृग्भार्याया मम कीदृशम् ।\nमंत्रिणां कीदृशं लोका वदंति चरितं कथम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000597008, "chapter_id": 20597, "verse_number": "५-५६-९", "content_sanskrit": "इति वाक्यं समाकर्ण्य चारा राममथाब्रुवन् ।\nमेघगंभीरया वाचा पृच्छंतं रघुनायकम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000597009, "chapter_id": 20597, "verse_number": "५-५६-१०", "content_sanskrit": "चारा ऊचुः ।\nनाथ कीर्तिर्जनान्सर्वान्पावयत्यधुना भुवि ।\nगृहेगृहे श्रुतास्माभिः पुरुषैः स्त्रीभिरीडिता॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000597010, "chapter_id": 20597, "verse_number": "५-५६-११", "content_sanskrit": "विवस्वतो महान्वंशो भवता परमेष्ठिना ।\nअलंकर्तुं गतं भूमौ कीर्तिर्विस्तारिता बहुः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000597011, "chapter_id": 20597, "verse_number": "५-५६-१२", "content_sanskrit": "अनेके सगराद्याश्च कीर्तिमंतो महाबलाः ।\nअभवंस्तादृशी कीर्तिस्तेषां नाभूद्यथा तव॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000597012, "chapter_id": 20597, "verse_number": "५-५६-१३", "content_sanskrit": "त्वया नाथेन सकलाः कृतार्थाश्च प्रजाः कृताः ।\nयासां नाकालमरणं न च रागाद्युपद्रुतिः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000597013, "chapter_id": 20597, "verse_number": "५-५६-१४", "content_sanskrit": "यादृशश्चंद्रमालोके यादृशी जाह्नवी सरित् ।\nतादृक्तव च सत्कीर्तिः प्रकाशयति भूतलम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000597014, "chapter_id": 20597, "verse_number": "५-५६-१५", "content_sanskrit": "ब्रह्मादिका भवत्कीर्तिमाकर्ण्य त्रपिता भृशम् ।\nनाथ सर्वत्र ते कीर्तिः पावयत्यधुना जनान्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000597015, "chapter_id": 20597, "verse_number": "५-५६-१६", "content_sanskrit": "वयं धन्यतमाः सर्वे ये चारास्तव भूपते ।\nक्षणेक्षणे तव मुखं लोकयाम मनोहरम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000597016, "chapter_id": 20597, "verse_number": "५-५६-१७", "content_sanskrit": "इत्यादिवाक्यं चाराणां पंचानां वीक्ष्य राघवः ।\nषष्ठं पप्रच्छ चारं तं विलक्षणमुखांकितम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000597017, "chapter_id": 20597, "verse_number": "५-५६-१८", "content_sanskrit": "राम उवाच ।\nसत्यं वद महाबुद्धे यच्छ्रुतं लोकसंकरे ।\nतादृक्प्रशंस मे सर्वमन्यथा पातकादिकृत्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000597018, "chapter_id": 20597, "verse_number": "५-५६-१९", "content_sanskrit": "पुनः पुनश्च तं रामः पप्रच्छाशु सविस्तरम् ।\nतथापि न ब्रवीत्येव रामं लौकिकभाषितम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000597019, "chapter_id": 20597, "verse_number": "५-५६-२०", "content_sanskrit": "तदा रामः प्रत्यवोचच्चारं मुखविलक्षितम् ।\nशपामि त्वां तु सत्येन शंस सर्वं यथातथम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000597020, "chapter_id": 20597, "verse_number": "५-५६-२१", "content_sanskrit": "तदा रामं प्रत्युवाच चारो वाक्यं शनैः शनैः ।\nअकथ्यमपि ते वाच्यं वाक्यं कारुजनोदितम्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000597021, "chapter_id": 20597, "verse_number": "५-५६-२२", "content_sanskrit": "चार उवाच ।\nस्वामिन्सर्वत्र ते कीर्तिर्दशाननवधादिका ।\nअन्यत्र राक्षसगृहे स्थितायास्ते स्त्रिया अहो॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000597022, "chapter_id": 20597, "verse_number": "५-५६-२३", "content_sanskrit": "कारुरेकस्तु रजको निशीथे महिलां स्वकाम् ।\nअन्यगेहोषितां दृष्ट्वा धिक्कुर्वन्समताडयत्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000597023, "chapter_id": 20597, "verse_number": "५-५६-२४", "content_sanskrit": "तन्माता प्रत्युवाचेमां कथं ताडयसेऽनघाम् ।\nगृहाण मा कृथा निंदां स्त्रियं मद्वाक्यमाचर॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000597024, "chapter_id": 20597, "verse_number": "५-५६-२५", "content_sanskrit": "तदावोचत्स रजको नाहं रामो महीपतिः ।\nयद्राक्षसगृहेध्युष्टां सीतामंगीचकार सः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000597025, "chapter_id": 20597, "verse_number": "५-५६-२६", "content_sanskrit": "सर्वं राज्ञः कृतं कर्म नीतिमद्भवति प्रभो ।\nअन्येषां पुण्यकर्तॄणामपि कृत्यमनीतिमत्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000597026, "chapter_id": 20597, "verse_number": "५-५६-२७", "content_sanskrit": "पुनः पुनरुवाचासौ नाहं रामो महीपतिः ।\nचुक्रुधे समये राजन्मया वाक्यं तव स्मृतम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000597027, "chapter_id": 20597, "verse_number": "५-५६-२८", "content_sanskrit": "तदानीं शिर आच्छिद्य पातयामि महीतले ।\nकृतः पुनर्विचारोमे क्व रामो रजकः क्व नु॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000597028, "chapter_id": 20597, "verse_number": "५-५६-२९", "content_sanskrit": "अयं दुष्टोऽनृतं वक्ति न हीदं तथ्यमुच्यते ।\nआज्ञापयसि चेद्राम सांप्रतं मारयामि तम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000597029, "chapter_id": 20597, "verse_number": "५-५६-३०", "content_sanskrit": "अवाच्यमपि ते प्रोक्तं त्वदाग्रहत उन्नयम् ।\nराजा प्रमाणमत्रेदं विचारयतु संगतम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000597030, "chapter_id": 20597, "verse_number": "५-५६-३१", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाकर्ण्य महावज्रनिभाक्षरम् ।\nनिःश्वसन्मुहुरुच्छ्वासमाचरन्मूर्च्छितोऽपतत्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000597031, "chapter_id": 20597, "verse_number": "५-५६-३२", "content_sanskrit": "तं मूर्च्छितं नृपं दृष्ट्वा चारा दुःखसमन्विताः ।\nवीजयामासुर्वासोग्रैर्दुःखापनय हेतवे॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000597032, "chapter_id": 20597, "verse_number": "५-५६-३३", "content_sanskrit": "स लब्धसंज्ञो नृपतिर्मुहूर्तेन जगाद तान् ।\nगच्छंतु भरतं शीघ्रं प्रेषयंतु च मां प्रति॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000597033, "chapter_id": 20597, "verse_number": "५-५६-३४", "content_sanskrit": "ते दुःखिताश्चरास्तूर्णं भरतस्य गृहं गताः ।\nकथयामासु रामस्य संदेशं नयहारकाः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000597034, "chapter_id": 20597, "verse_number": "५-५६-३५", "content_sanskrit": "भरतो रामसंदेशं श्रुत्वा धीमान्ययौ सदः ।\nरामं प्रति रहःसंस्थं श्रुत्वा तं त्वरया युतः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000597035, "chapter_id": 20597, "verse_number": "५-५६-३६", "content_sanskrit": "आगत्य तं प्रतीहारं प्रत्युवाच महामनाः ।\nकुत्रास्ते रामभद्रोऽसौ मम भ्राता कृपानिधिः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000597036, "chapter_id": 20597, "verse_number": "५-५६-३७", "content_sanskrit": "तन्निर्दिष्टं गृहं वीरो ययौ रत्नमनोहरम् ।\nरामं विलोक्य विक्लांतं भयमाप स मानसे॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000597037, "chapter_id": 20597, "verse_number": "५-५६-३८", "content_sanskrit": "किं वासौ कुपितो रामः किं वा दुःखमिदं विभोः ।\nतदा प्रोवाच नृपतिं निःश्वसंतं मुहुर्मुहुः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000597038, "chapter_id": 20597, "verse_number": "५-५६-३९", "content_sanskrit": "स्वामिन्सुखसमाराध्यं वक्त्रं ते कथमानतम् ।\nअश्रुभिर्लक्ष्यते राहुग्रस्तदेहः शशीव ते॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000597039, "chapter_id": 20597, "verse_number": "५-५६-४०", "content_sanskrit": "सर्वं मे कारणं तथ्यं ब्रूहि मां किं करोमि ते ।\nत्यज दुःखं महाराज कथं दुःखस्य भाजनम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000597040, "chapter_id": 20597, "verse_number": "५-५६-४१", "content_sanskrit": "एवं भ्रात्रा प्रोच्यमानो गद्गदस्वरया गिरा ।\nप्रोवाच भ्रातरं वीरो रामचंद्रश्च धार्मिकः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000597041, "chapter_id": 20597, "verse_number": "५-५६-४२", "content_sanskrit": "शृणु भ्रातर्वचो मह्यं मम दुःखस्य कारणम् ।\nतन्मार्जनं कुरुष्वाद्य भ्रातः प्रातर्महामते॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000597042, "chapter_id": 20597, "verse_number": "५-५६-४३", "content_sanskrit": "वंशे वैवस्वते राजा न कश्चिदयशः क्षतः ।\nमत्कीर्तिरद्य कलुषा गंगायमुनया गता॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000597043, "chapter_id": 20597, "verse_number": "५-५६-४४", "content_sanskrit": "येषां यशो नृणां भूमौ तेषामेव सुजीवितम् ।\nअपकीर्तिक्षतानां तु जीवितं मृतकैः समम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000597044, "chapter_id": 20597, "verse_number": "५-५६-४५", "content_sanskrit": "येषां यशो भवेद्भूमौ तेषां लोकाः सनातनाः ।\nअपकीर्त्युरगी दष्टास्तेषां भूयादधोगतिः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000597045, "chapter_id": 20597, "verse_number": "५-५६-४६", "content_sanskrit": "अद्य मे कलुषा कीर्तिः स्वर्धुनी लोकविश्रुता ।\nतच्छृणुष्व वचो मेऽद्य रजकेन यथोदितम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000597046, "chapter_id": 20597, "verse_number": "५-५६-४७", "content_sanskrit": "अस्मिन्पुरेऽद्य रजक उक्तवाञ्जानकीभवम् ।\nकिंचिद्वाच्यं ततो भ्रातः किं करोमि महीतले॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000597047, "chapter_id": 20597, "verse_number": "५-५६-४८", "content_sanskrit": "किमात्मानं जहाम्यद्य किमेनां जानकीं स्त्रियम् ।\nउभयोः किं मया कार्यं तत्तथ्यं ब्रूहि मे भवान्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000597048, "chapter_id": 20597, "verse_number": "५-५६-४९", "content_sanskrit": "इत्युक्त्वा निर्गलद्बाष्पो वेपथु क्षुभितांगकः ।\nपपात भूमौ विरजो धार्मिकाणां शिरोमणिः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000597049, "chapter_id": 20597, "verse_number": "५-५६-५०", "content_sanskrit": "भ्रातरं पतितं दृष्ट्वा भरतो दुःखसंयुतः ।\nसंवीक्ष्य शनकै रामं प्राप्तसंज्ञं चकार सः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000597050, "chapter_id": 20597, "verse_number": "५-५६-५१", "content_sanskrit": "संज्ञां प्राप्तं तु संवीक्ष्य रामचंद्रं सुदुःखितम् ।\nउवाच दुःखनाशाय वाक्यं तु सुमनोहरम्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000597051, "chapter_id": 20597, "verse_number": "५-५६-५२", "content_sanskrit": "कोऽयं वै रजकः किंतु वाच्यं वाक्यं यथाब्रवीत् ।\nजिह्वाच्छेदं करिष्यामि जानकीवाच्यकारिणः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000597052, "chapter_id": 20597, "verse_number": "५-५६-५३", "content_sanskrit": "तदा रामोऽब्रवीद्वाक्यं रजकस्य मुखोद्गतम् ।\nश्रुतं चारेण तत्सर्वं भरताय महात्मने॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000597053, "chapter_id": 20597, "verse_number": "५-५६-५४", "content_sanskrit": "तच्छ्रुत्वा भरतः प्राह भ्रातरं दुःखशोकिनम् ।\nजानकीवह्निशुद्धाभूल्लंकायां वीरपूजिता॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000597054, "chapter_id": 20597, "verse_number": "५-५६-५५", "content_sanskrit": "ब्रह्माब्रवीदियं शुद्धा पिता दशरथस्तव ।\nकथं सा रजकोक्तित्वाद्धातव्या लोकपूजिता॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000597055, "chapter_id": 20597, "verse_number": "५-५६-५६", "content_sanskrit": "ब्रह्मादिसंस्तुता कीर्तिस्तवलोकान्पुनाति हि ।\nसा कथं रजकोक्त्या वै कलुषाद्य भविष्यति॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000597056, "chapter_id": 20597, "verse_number": "५-५६-५७", "content_sanskrit": "तस्मात्त्यज महादुःखं सीतावाच्यसमुद्भवम् ।\nकुरु राज्यं तया सार्धमंतर्वत्न्या सुभाग्यया॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000597057, "chapter_id": 20597, "verse_number": "५-५६-५८", "content_sanskrit": "त्वं कथं स्वशरीरं तु हातुमिच्छसि शोभनम् ।\nवयं हताः स्म सर्वेऽद्य त्वां विना दुःखनाशकम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000597058, "chapter_id": 20597, "verse_number": "५-५६-५९", "content_sanskrit": "क्षणं सीता न जीवेत त्वां विना सुमहोदया ।\nतस्मात्पतिव्रता साकं भुनक्तु विपुलां श्रियम्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000597059, "chapter_id": 20597, "verse_number": "५-५६-६०", "content_sanskrit": "इति वाक्यं समाकर्ण्य भरतस्य च धार्मिकः ।\nपुनरेव जगादेमं वाक्यं वाक्यविदां वरः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000597060, "chapter_id": 20597, "verse_number": "५-५६-६१", "content_sanskrit": "यत्त्वं कथयसि भ्रातस्तत्सर्वं धर्मसंयुतम् ।\nपरं यद्वच्म्यहं वाक्यं तत्कुरुष्व ममाज्ञया॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000597061, "chapter_id": 20597, "verse_number": "५-५६-६२", "content_sanskrit": "जानाम्येनां वह्निशुद्धां पवित्रां लोकपूजिताम् ।\nलोकापवादाद्भीतोऽहं त्यजामि स्वां तु जानकीम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000597062, "chapter_id": 20597, "verse_number": "५-५६-६३", "content_sanskrit": "तस्मात्करे शितं धृत्वा करवालं सुदारुणम् ।\nशिरश्छिंध्यथवा जायां जानकीं मुंच वै वने॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]