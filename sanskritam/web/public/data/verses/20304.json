[{"id": 7000304000, "chapter_id": 20304, "verse_number": "१-५८-१", "content_sanskrit": "व्यास उवाच ।\nशाखिनामेव सर्वेषां फलं वक्ष्यामि यादृशम् ।\nतच्छृणुध्वं महाभागा रोपणे च पृथक्पृथक्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000304001, "chapter_id": 20304, "verse_number": "१-५८-२", "content_sanskrit": "यस्तु रोपयते तीरे पुण्यवृक्षान्समंततः ।\nतस्य पुण्यफलं ज्ञातुं कथितुं नैव शक्यते॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000304002, "chapter_id": 20304, "verse_number": "१-५८-३", "content_sanskrit": "अन्यत्र रोपणं कृत्वा शाखिनां यत्फलं लभेत् ।\nततो जलसमीपे तु लक्षकोटिगुणं भवेत्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000304003, "chapter_id": 20304, "verse_number": "१-५८-४", "content_sanskrit": "स्वयं पुष्करिणी तीरे त्वनंतं फलमश्नुते ।\nतस्माच्छतगुणं ब्रूमः शाखिनां पुण्यकारिणाम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000304004, "chapter_id": 20304, "verse_number": "१-५८-५", "content_sanskrit": "अश्वत्थरोपणं कृत्वा जलाशयसमीपतः ।\nयत्फलं लभते मर्त्यो न तत्क्रतुशतैरपि॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000304005, "chapter_id": 20304, "verse_number": "१-५८-६", "content_sanskrit": "पतंति यानि पत्राणि जले पर्वणि पर्वणि ।\nतानि पिंडसमानीह पितॄणामक्षयं ययुः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000304006, "chapter_id": 20304, "verse_number": "१-५८-७", "content_sanskrit": "खादंति पतगास्तत्र फलानि कामतो ध्रुवम् ।\nब्रह्मभक्ष्यसमं तस्य पुण्यं भवति चाक्षयम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000304007, "chapter_id": 20304, "verse_number": "१-५८-८", "content_sanskrit": "अश्वत्थेनैव भक्ष्येण रोपणेनैव यत्फलम् ।\nतद्वै क्रतुशतैर्नैव पुत्रैरेव शतैरपि॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000304008, "chapter_id": 20304, "verse_number": "१-५८-९", "content_sanskrit": "उष्णेच्छायां प्रगृह्णंति गावो देवद्विजातयः ।\nकर्तुः पितृगणानां च स्वर्गो भवति चाक्षयः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000304009, "chapter_id": 20304, "verse_number": "१-५८-१०", "content_sanskrit": "कर्तुं स्वस्थस्य वै विघ्नमक्षयत्वान्न शक्यते ।\nतस्मात्सर्वप्रयत्नेन रोपयेद्वृक्षमाधवम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000304010, "chapter_id": 20304, "verse_number": "१-५८-११", "content_sanskrit": "एकं वृक्षं समारोप्य नरः स्वर्गान्न हीयते ।\nतस्मादेव महावृक्षं रोपयध्वं द्विजोत्तमाः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000304011, "chapter_id": 20304, "verse_number": "१-५८-१२", "content_sanskrit": "जलानां निकटे रम्ये रसानां क्रयविक्रये ।\nमार्गे जलाशये वृक्षान्रोपयेद्यो महाशयः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000304012, "chapter_id": 20304, "verse_number": "१-५८-१३", "content_sanskrit": "अश्वत्थादीन्समारोप्य स्वर्गं याति मनोरमम् ।\nअर्चयित्वा तु यत्पुण्यं प्रवक्ष्यामि द्विजातयः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000304013, "chapter_id": 20304, "verse_number": "१-५८-१४", "content_sanskrit": "स्नात्वाश्वत्थं स्पृशेद्यस्तु सर्वपापैः प्रमुच्यते ।\nअस्नातो यः स्पृशेन्मर्त्यो लभते स्नानजं फलम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000304014, "chapter_id": 20304, "verse_number": "१-५८-१५", "content_sanskrit": "दृष्ट्वा च नाशयेत्पापं स्पृष्ट्वा लक्ष्मीं प्रपद्यते ।\nप्रदक्षिणे भवेदायुः सदाश्वत्थ नमोस्तु ते॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000304015, "chapter_id": 20304, "verse_number": "१-५८-१६", "content_sanskrit": "चलद्दलाय वृक्षाय सदा विष्णुस्थिताय च ।\nबोधिसत्वाय योग्याय सदाश्वत्थ नमोस्तु ते॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000304016, "chapter_id": 20304, "verse_number": "१-५८-१७", "content_sanskrit": "अश्वत्थाय तु हव्यं तु पयो नैवेद्यमेव च ।\nपुष्पं धूपं दीपकं च दत्वा स्वर्गान्न हीयते॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000304017, "chapter_id": 20304, "verse_number": "१-५८-१८", "content_sanskrit": "सपुत्रं चाक्षयं विद्धि धनवृद्धियशस्करम् ।\nविजयं मानदं भद्रमश्वत्थस्य प्रपूजनम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000304018, "chapter_id": 20304, "verse_number": "१-५८-१९", "content_sanskrit": "यज्जप्तं च हुतं स्तोत्रं यन्त्रमंत्रादिकं च यत् ।\nसर्वं कोटिगुणं प्रोक्तं मूले चलदलस्य च॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000304019, "chapter_id": 20304, "verse_number": "१-५८-२०", "content_sanskrit": "यस्य मूले स्थितो विष्णुर्मध्ये तिष्ठति शंकरः ।\nअग्रभागे स्थितो ब्रह्मा कस्तं जगति नार्चयेत्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000304020, "chapter_id": 20304, "verse_number": "१-५८-२१", "content_sanskrit": "सोमवारे त्वमायां च स्नानं यन्मौनिना कृतम् ।\nदानस्य गोसहस्रस्य फलं चाश्वत्थवंदने॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000304021, "chapter_id": 20304, "verse_number": "१-५८-२२", "content_sanskrit": "सप्तप्रदक्षिणेनैव गवामयुतजं फलम् ।\nप्रचुराल्लक्षकोटिश्च तस्मात्कार्या हि सा सदा॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000304022, "chapter_id": 20304, "verse_number": "१-५८-२३", "content_sanskrit": "यत्किंचिद्दीयते तत्र फलमूलजलादिकम् ।\nसर्वं तच्चाक्षयफलं जन्मजन्मसु जायते॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000304023, "chapter_id": 20304, "verse_number": "१-५८-२४", "content_sanskrit": "अहोश्वत्थसमो नास्ति वृक्षरूपी हरिर्भुवि ।\nयथा पूज्यो द्विजो लोके यथा गावो यथामराः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000304024, "chapter_id": 20304, "verse_number": "१-५८-२५", "content_sanskrit": "तथाश्वत्थवृक्षरूपी देवः पूज्यतमः स्मृतः ।\nरोपणे रक्षणे स्पर्शे पूजाकर्मणि वै सदा॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000304025, "chapter_id": 20304, "verse_number": "१-५८-२६", "content_sanskrit": "ददाति वित्तं पुत्रांश्च स्वर्गं मोक्षं पुनः क्रमात् ।\nकिंचिच्छेदं तु यः कुर्यादश्वत्थस्य तनौ नरः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000304026, "chapter_id": 20304, "verse_number": "१-५८-२७", "content_sanskrit": "कल्पैकं निरयं भुक्त्वा चांडालादौ प्रजायते ।\nमूलच्छेदेन तस्यैव स च यात्यपुनर्भवम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000304027, "chapter_id": 20304, "verse_number": "१-५८-२८", "content_sanskrit": "पुरुषास्तस्य तिष्ठंति रौरवे घोरदर्शने ।\nअश्वत्थस्यैकवृक्षस्य रोपणे यत्फलं भवेत्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000304028, "chapter_id": 20304, "verse_number": "१-५८-२९", "content_sanskrit": "तथैव चंपकेर्के च त्रयाणां रोपणेपि च ।\nअष्टौ बिल्वस्य वृक्षाश्च न्यग्रोधाश्चैव सप्त च॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000304029, "chapter_id": 20304, "verse_number": "१-५८-३०", "content_sanskrit": "निंबस्य दशवृक्षाश्च फलं चैषां समं भवेत् ।\nएकैकस्य फलं चोक्तं वृक्षाणां रोपणे द्विजाः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000304030, "chapter_id": 20304, "verse_number": "१-५८-३१", "content_sanskrit": "एवं बुध्वा तु धर्मात्मा यः कुर्यात्कृत्रिमं वनम् ।\nकल्पकोटिसहस्राणि कल्पकोटिशतानि च॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000304031, "chapter_id": 20304, "verse_number": "१-५८-३२", "content_sanskrit": "नाकमेति स चूतस्य समारोप्य सहस्रकम् ।\nततो द्वित्रिगुणेनैव न्यूने वा प्रचुरेपि वा॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000304032, "chapter_id": 20304, "verse_number": "१-५८-३३", "content_sanskrit": "भुंक्ते भुक्त्वा पुनः कुर्यान्नृपो वाथ सदीश्वरः ।\nस्वर्गं भोग्यं ततो राज्यं कल्याणं मंगलं शुभम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000304033, "chapter_id": 20304, "verse_number": "१-५८-३४", "content_sanskrit": "आरोग्यं शौर्यसंपन्नमारामादेव जायते ।\nफलानि यस्य खादंति जंतवोथ सहस्रशः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000304034, "chapter_id": 20304, "verse_number": "१-५८-३५", "content_sanskrit": "आश्रिता विहगाः कीटाः पतगाः शलभादयः ।\nछायाश्रिताश्च ये सत्वास्तत्संख्याताः पृथग्जनाः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000304035, "chapter_id": 20304, "verse_number": "१-५८-३६", "content_sanskrit": "तस्य किंकरतां यांति शतशो देवतार्चिताः ।\nये च वृक्षा महासत्वास्सर्वे ते देवरूपिणः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000304036, "chapter_id": 20304, "verse_number": "१-५८-३७", "content_sanskrit": "तदर्चा पितृवत्कार्या शुश्रूषां जलपिंडकम् ।\nमर्त्यलोके च ते पुत्रास्तस्य जन्मनि जन्मनि॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000304037, "chapter_id": 20304, "verse_number": "१-५८-३८", "content_sanskrit": "सुरूपाः सुविनीताश्च सदापुण्यक्रिया शुभाः ।\nएवं गणेशतां यांति जंतवश्चूतलग्नकाः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000304038, "chapter_id": 20304, "verse_number": "१-५८-३९", "content_sanskrit": "धात्री हरीतकी चान्ये कटुतिक्ताम्लसंभवाः ।\nसर्वे चारामतः शुद्धाः फलदाः शिवदाः सदा॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000304039, "chapter_id": 20304, "verse_number": "१-५८-४०", "content_sanskrit": "प्रासादा यत्र सौवर्णाः सर्वरत्नविभूषिताः ।\nसर्वाभरणसंयुक्ता विमानाश्चानिलोपमाः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000304040, "chapter_id": 20304, "verse_number": "१-५८-४१", "content_sanskrit": "शातकुंभमया वृक्षाः सदैव सर्वदायिनः ।\nसर्वर्तुसुखदाः सौम्यकन्यका अप्सरस्समाः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000304041, "chapter_id": 20304, "verse_number": "१-५८-४२", "content_sanskrit": "गीतनृत्यपराधीरास्तत्र तिष्ठंति वृक्षदाः ।\nपुष्करिण्यो विशेषेण खातान्यन्यानि यानि च॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000304042, "chapter_id": 20304, "verse_number": "१-५८-४३", "content_sanskrit": "शुद्धोपलांतरचिता नद्यः पायसकर्द्दमाः ।\nपुनर्दुग्धसफेनाश्च अन्नादिषड्रसान्विताः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000304043, "chapter_id": 20304, "verse_number": "१-५८-४४", "content_sanskrit": "मर्त्यलोके यथा भोग्यं पुनः स्वर्गे पुनर्भुवि ।\nपुनरेव तदभ्यासात्खातमारामकं पुनः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000304044, "chapter_id": 20304, "verse_number": "१-५८-४५", "content_sanskrit": "यथा पुण्यादिकं कृत्वा स्वर्गमर्त्याधिपः पुमान् ।\nअशक्तस्तु प्रपां कृत्वा पुष्करिण्याः फलं लभेत्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000304045, "chapter_id": 20304, "verse_number": "१-५८-४६", "content_sanskrit": "प्रपाया लक्षणं चात्र सर्वपापहरं परं ।\nसर्वभोगप्रदं शुद्धं स्वर्गापवर्गदं स्थिरं॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000304046, "chapter_id": 20304, "verse_number": "१-५८-४७", "content_sanskrit": "लक्षणं च प्रवक्ष्यामि प्रपायाः कीर्तिवर्धनम् ।\nनिर्जलेऽध्वनि पृक्ते च स्थाने कृत्वा च मंडपम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000304047, "chapter_id": 20304, "verse_number": "१-५८-४८", "content_sanskrit": "बहुपान्थे समायाते ग्रीष्मवर्षाशरत्स्वपि ।\nअगरुकादि सौगंध्यं जलं पूगं सचंद्रकम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000304048, "chapter_id": 20304, "verse_number": "१-५८-४९", "content_sanskrit": "आसनं चैव तांबूलं दत्वा स्वर्गान्न हीयते ।\nएवं वर्षत्रयेणैव पुष्करिण्याः फलं लभेत्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000304049, "chapter_id": 20304, "verse_number": "१-५८-५०", "content_sanskrit": "स्वर्गाच्चैवाच्युतो मर्त्यो देवैरपि प्रपूज्यते ।\nमासमेकं तु यो दद्यात्प्रपां ग्रीष्मेथ निर्जले॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000304050, "chapter_id": 20304, "verse_number": "१-५८-५१", "content_sanskrit": "कल्पैकं तु वसेत्स्वर्गे स्वर्गाद्भ्रष्टो महीयते ।\nप्रपादास्तत्र तिष्ठंति यत्र पुष्करिणीप्रदाः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000304051, "chapter_id": 20304, "verse_number": "१-५८-५२", "content_sanskrit": "नोचेद्धर्मघटो देयः पुण्यः पापक्षयाय च ।\nएष धर्मघटो ज्ञेयो ब्रह्मविष्णुशिवात्मकः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000304052, "chapter_id": 20304, "verse_number": "१-५८-५३", "content_sanskrit": "तवप्रसादात्सफलाः मम संतु मनोरथाः ।\nस्वर्णमाषं चतुर्भागं दक्षिणार्थं घटस्य च॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000304053, "chapter_id": 20304, "verse_number": "१-५८-५४", "content_sanskrit": "एवं वर्षत्रयेणैव प्रपादानफलं लभेत् ।\nयः पठेच्छ्रावयेद्वापि पुष्करिण्यादिजं फलम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000304054, "chapter_id": 20304, "verse_number": "१-५८-५५", "content_sanskrit": "साक्षात्पापाद्भवेन्मुक्तस्तत्प्रसादात्तु सद्गतिः ।\nजनेषु श्रावयेद्यस्तु पुण्याख्यानमिदं शुभम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000304055, "chapter_id": 20304, "verse_number": "१-५८-५६", "content_sanskrit": "कल्पकोटिसहस्राणि सुरलोके स तिष्ठति॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]