[{"id": 2026703, "chapter_id": 1572, "verse_number": "३-२१०-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026704, "chapter_id": 1572, "verse_number": "३-२१०-१", "content_sanskrit": "चिन्तयित्वा तदाश्चर्यं स्त्रिया प्रोक्तमशेपतः।\nविनिन्दन्स द्विजोऽऽत्मानमागस्कृत इवाबभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026705, "chapter_id": 1572, "verse_number": "३-२१०-२", "content_sanskrit": "चिन्तयानः स धर्मस्य सूक्ष्मां गतिमथाब्रवीत्।\nश्रद्दधानेन वै भाव्ये गच्छामि मिथिलामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026706, "chapter_id": 1572, "verse_number": "३-२१०-३", "content_sanskrit": "कृतात्मा धर्मवित्तस्यां व्याधो निवसते किल।\nतं गच्चाम्यहमद्यैव धर्मं प्रष्टुं तपोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026707, "chapter_id": 1572, "verse_number": "३-२१०-४", "content_sanskrit": "इतिसंचिन्त्य मनसा श्रद्दधानः स्त्रिया वचः।\nबलाकाप्रत्ययेनासौ धर्म्यैश्च वचनैः शुभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026708, "chapter_id": 1572, "verse_number": "३-२१०-५", "content_sanskrit": "संप्रतस्थे स मिथिलां कौतूहलसमन्वितः।\nअतिक्रामन्नरण्यानि ग्रामांश्च नगराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026709, "chapter_id": 1572, "verse_number": "३-२१०-६", "content_sanskrit": "ततो जगाम मिथिलां जनकेन सुरक्षिताम्।\nधर्मसेतुसमाकीर्णां यज्ञोत्सववतीं शुभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026710, "chapter_id": 1572, "verse_number": "३-२१०-७", "content_sanskrit": "गोपुराट्टालकवतीं हर्म्यप्राकारशोभनाम्।\nप्रविश्य नगरीं रम्यां विमानैर्बहुभिर्युताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026711, "chapter_id": 1572, "verse_number": "३-२१०-८", "content_sanskrit": "पण्यैश्च बहुभिर्युक्तां सुविभक्तमहापथाम्।\nअश्वै रथैस्तथा नागैर्योधैश्च बहुभिर्युताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026712, "chapter_id": 1572, "verse_number": "३-२१०-९", "content_sanskrit": "हृष्टपुष्टजनाकीर्णां नित्योत्सवसमाकुलाम्।\nसोऽपस्यद्बहुवृत्तान्तां ब्राह्मणः समतिक्रमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026713, "chapter_id": 1572, "verse_number": "३-२१०-१०", "content_sanskrit": "धर्मव्याधमपृच्छच्च स चास्य कथितो द्विजैः।\nअपश्यत्तत्रगत्वा तं सूनामध्ये व्यवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026714, "chapter_id": 1572, "verse_number": "३-२१०-११", "content_sanskrit": "मार्गमाहिपमांसानि विक्रीणन्तं तपस्विनम्।\nआकुलत्वाच्च क्रेतृणामेकान्ते संस्थितो द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026715, "chapter_id": 1572, "verse_number": "३-२१०-१२", "content_sanskrit": "स तु ज्ञाता द्विजं प्राप्तं सहसा संभ्रमोत्थितः।\nआजगाम यतो विप्रः स्थित एकान्तआसने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026716, "chapter_id": 1572, "verse_number": "३-२१०-१३x", "content_sanskrit": "व्याध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026717, "chapter_id": 1572, "verse_number": "३-२१०-१३", "content_sanskrit": "अभिवादये त्वां भगवन्स्वागतं ते द्विजोत्तम।\nअहं व्याधो हि भद्रं ते किं करोमि प्रशाधि माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026718, "chapter_id": 1572, "verse_number": "३-२१०-१४", "content_sanskrit": "एकपत्न्या यदुक्तोसि गच्छ त्वं मिथिलामिति।\nजानाम्येतदहं सर्वं यदर्थं त्वमिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026719, "chapter_id": 1572, "verse_number": "३-२१०-१५", "content_sanskrit": "श्रुत्वा च तस्य तद्वाक्यं स विप्रो भृशविस्मितः।\nद्वितीयमिदमाश्चर्यमित्यचिन्तयत द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026720, "chapter_id": 1572, "verse_number": "३-२१०-१६", "content_sanskrit": "अदेशस्थं हि ते स्तानमिति व्याघोऽब्रवीद्द्विजम्।\nगृहं गच्छाव भगवन्यदि ते रोचतेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026721, "chapter_id": 1572, "verse_number": "३-२१०-१७x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026722, "chapter_id": 1572, "verse_number": "३-२१०-१७", "content_sanskrit": "बाढमित्येव तं विप्रो हृष्टो वचनमब्रवीत्।\nअग्रतस्तु द्विजं कृत्वा स जगाम गृहं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026723, "chapter_id": 1572, "verse_number": "३-२१०-१८", "content_sanskrit": "प्रविश्य च गृहंरम्यमासनेनाभिपूजितः।\n`अर्ध्येण च स वै तेन व्याधेन द्विजसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026724, "chapter_id": 1572, "verse_number": "३-२१०-१९", "content_sanskrit": "पाद्यमाचमनीयं च प्रतिगृह्य द्विजोत्तमः।\nततः सुखोपविष्स्तं व्याधं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026725, "chapter_id": 1572, "verse_number": "३-२१०-२०", "content_sanskrit": "कर्मैतद्वै न सदृशं भवतः प्रतिभाति मे।\nअनुतप्ये भृशं तात तव घोरेण कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026726, "chapter_id": 1572, "verse_number": "३-२१०-२१x", "content_sanskrit": "व्याध उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026727, "chapter_id": 1572, "verse_number": "३-२१०-२१", "content_sanskrit": "कुलोचितमिदं कर्म पितृपैतामहं परम्।\nवर्तमानस्य मे धर्मे स्वे मन्युं मा कृथा द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026728, "chapter_id": 1572, "verse_number": "३-२१०-२२", "content_sanskrit": "विधात्रा विहितं पूर्वं कर्म स्वमनुपालयन्।\nप्रयत्नाच्च गुरू वृद्धौ शुश्रूषेऽहं द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026729, "chapter_id": 1572, "verse_number": "३-२१०-२३", "content_sanskrit": "सत्यं वदे नाभ्यसूये यथाशक्ति ददामि च।\nदेवतातिथिभृत्यानामवशिष्टेन वर्तये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2026730, "chapter_id": 1572, "verse_number": "३-२१०-२४", "content_sanskrit": "न कुत्सयाम्यहं किंचिन्न गर्हे बलवत्तरम्।\nकृतमन्वेति कर्तारं पुरा कर्म द्विजेत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2026731, "chapter_id": 1572, "verse_number": "३-२१०-२५", "content_sanskrit": "कृषिगोरक्ष्यवाणिज्यमिह लोकस्य जीवनम्।\nदण्डनीतिस्त्रयो विद्या तेन लोको भवत्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2026732, "chapter_id": 1572, "verse_number": "३-२१०-२६", "content_sanskrit": "कर्म शूद्रे कृषिर्वैश्ये संग्रामः क्षत्रिये स्मृतः।\nब्रह्मचर्यतपोमन्त्राः सत्यं च ब्राह्मणे सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2026733, "chapter_id": 1572, "verse_number": "३-२१०-२७", "content_sanskrit": "राजा प्रशास्ति धर्मेण स्वकर्मनिरताः प्रजाः।\nविकर्माणश्च ये केचित्तान्युनक्ति स्वकर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2026734, "chapter_id": 1572, "verse_number": "३-२१०-२८", "content_sanskrit": "भेतव्यं हि सदा राज्ञां प्रजानामधिपा हिते।\nमारयन्ति विकर्मस्थं लुब्धा मृगमिवेषुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2026735, "chapter_id": 1572, "verse_number": "३-२१०-२९", "content_sanskrit": "जनकस्येह विप्रर्षे विकर्मस्थो न विद्यते।\nस्वकर्मनिरता वर्णाश्चत्वारोपि द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2026736, "chapter_id": 1572, "verse_number": "३-२१०-३०", "content_sanskrit": "स एष जनको राजा दुर्वृत्तमपि चेत्सुतम्।\nदण्ड्यं दण्डे निक्षिपति यथा न ग्लाति धार्मिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2026737, "chapter_id": 1572, "verse_number": "३-२१०-३१", "content_sanskrit": "सुयुक्तचारो नृपतिः सर्वं धर्मेण पश्यति।\nश्रीश्च राज्यं च दण्डश्च क्षत्रियाणां द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2026738, "chapter_id": 1572, "verse_number": "३-२१०-३२", "content_sanskrit": "राजानो हि स्वधर्मेण श्रियमिच्छन्ति भूयसीम्।\nसर्वेषामेव वर्णानां त्राता राजा भवत्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2026739, "chapter_id": 1572, "verse_number": "३-२१०-३३", "content_sanskrit": "परेण हि हतान्ब्रह्मन्वराहमहिषानहम्।\nन स्वयं हन्मि विप्रर्षे विक्रीणामि सदा त्वहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2026740, "chapter_id": 1572, "verse_number": "३-२१०-३४", "content_sanskrit": "न भक्षयामि मांसानि ऋतुगामी तथाह्यहम्।\nसदोपवासी च तथा नक्तभोजी सदा द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2026741, "chapter_id": 1572, "verse_number": "३-२१०-३५", "content_sanskrit": "अशीलश्चापि पुरुषो भूत्वा भवति शीलवान्।\nप्राणिहिंसारतिश्चापि भवते धार्मिकः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2026742, "chapter_id": 1572, "verse_number": "३-२१०-३६", "content_sanskrit": "व्यभिचाराननरेन्द्राणां धर्मः संकीर्यते महान्।\nअधर्मो वर्तते चापि संकीर्यन्ते ततः प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2026743, "chapter_id": 1572, "verse_number": "३-२१०-३७", "content_sanskrit": "भेरुण्डा वामनाः कुब्जाः स्थूलशीर्षास्तथैव च।\nक्लीबाश्चान्धाश्च बधिरा जायन्तेऽत्युच्चलोचनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2026744, "chapter_id": 1572, "verse_number": "३-२१०-३८", "content_sanskrit": "पार्थिवानामधर्मत्वात्प्रजानामभवः सदा।\nस एष राजा जनकः प्रजा धर्मेण पश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2026745, "chapter_id": 1572, "verse_number": "३-२१०-३९", "content_sanskrit": "अनुगृह्णन्प्रजाः सर्वाः स्वधर्मनिरताः सदा।\n`पात्येष राजा जनकः पितृवद्द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2026746, "chapter_id": 1572, "verse_number": "३-२१०-४०", "content_sanskrit": "येचैव मां प्रशंसन्ति येच निन्दन्ति मानवाः।\nसर्वान्सुपरिणीतेन कर्माणा तोषयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2026747, "chapter_id": 1572, "verse_number": "३-२१०-४१", "content_sanskrit": "ये जीवन्ति स्वधर्मेण संयुञ्जन्ति च पार्थिवाः।\nन किंचिदुपजीवनति दान्ता उत्थानसीलिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2026748, "chapter_id": 1572, "verse_number": "३-२१०-४२", "content_sanskrit": "शक्त्याऽन्नदानं सततं तितिक्षा धर्मनित्यता।\nयथार्हं प्रतिपूजा च सर्वभूतेषु वै दया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2026749, "chapter_id": 1572, "verse_number": "३-२१०-४३", "content_sanskrit": "त्यागान्नान्यत्र मर्त्यानां गुणास्तिष्ठान्ति पूरुषे।\nमृषावादं परिहरेत्कुर्यात्प्रियमयाचितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2026750, "chapter_id": 1572, "verse_number": "३-२१०-४४", "content_sanskrit": "न च कामान्न संरम्भान्न द्वेषाद्धर्ममुत्सृजेत्।\nप्रिये नातिभृशं हृष्येदप्रिये न च संज्वरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2026751, "chapter_id": 1572, "verse_number": "३-२१०-४५", "content_sanskrit": "न मुह्येदर्थकृच्छ्रेषु न च धऱ्मं परित्यजेत्।\nकर्म चेत्किंचिदन्यत्स्यादितरन्न तदाचरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2026752, "chapter_id": 1572, "verse_number": "३-२१०-४६", "content_sanskrit": "यत्कल्याणमभिध्यायेत्तत्रात्मानं नियोजयेत्।\nन पापं प्रति पापः स्यात्साधुरेव सदा भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2026753, "chapter_id": 1572, "verse_number": "३-२१०-४७", "content_sanskrit": "आत्मनैव हतः पापो यः पापं कर्तुमिच्छति।\nकर्म चैतदसाधूनां वृजिनानामसाधुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2026754, "chapter_id": 1572, "verse_number": "३-२१०-४८", "content_sanskrit": "न धर्मोस्तीति मन्वानाः शुचीनवहसन्ति ये।\nअश्रद्दधाना धर्मस् ते नश्यन्ति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2026755, "chapter_id": 1572, "verse_number": "३-२१०-४९", "content_sanskrit": "महादृतिरिवाध्मातः पापो भवति नित्यदा।\n`साधुः सन्नतिमानेव सर्वत्रद्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2026756, "chapter_id": 1572, "verse_number": "३-२१०-५०", "content_sanskrit": "मूढानामवलिप्तानामसारं भाषितं भवेत्।\nदर्शयन्त्यन्तरात्मानं दिवा रूपमिवांशुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2026757, "chapter_id": 1572, "verse_number": "३-२१०-५१", "content_sanskrit": "न लोके राजते मूर्खः केवलात्मप्रशंसया।\nअपिचेह मृजाहीनः कृतविद्यः प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2026758, "chapter_id": 1572, "verse_number": "३-२१०-५२", "content_sanskrit": "अब्रुवन्कस्यचिन्निन्दामात्मपूजामवर्णयन्।\nन कश्चिद्गुणसंपन्नः प्रकाशो भुवि दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2026759, "chapter_id": 1572, "verse_number": "३-२१०-५३", "content_sanskrit": "विकर्मणा तप्यमानः पापाद्विपरिमुच्यते।\nन तत्कुर्यां पुनरिति द्वितीयात्परिमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2026760, "chapter_id": 1572, "verse_number": "३-२१०-५४", "content_sanskrit": "कर्मणा येन केनापि पापात्मा द्विजसत्तम।\nएवं श्रुतिरियं ब्रह्मन्धर्मेषु प्रतिदृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2026761, "chapter_id": 1572, "verse_number": "३-२१०-५५", "content_sanskrit": "पापनि बुद्ध्वेह पुरा कृतानि\nस्वधर्मशीलो विनिहन्ति पश्चात्।\nधर्मो ब्रह्मन्नुदते ब्राह्मणानां\nयत्कुर्वते पापमिह प्रमादात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2026762, "chapter_id": 1572, "verse_number": "३-२१०-५६", "content_sanskrit": "पापं कृत्वा हि मन्येत नाहमस्मीति पूरुषः।\n[तं तु देवाः प्रपश्यन्ति स्वस्यैवान्तरपूरुषः] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2026763, "chapter_id": 1572, "verse_number": "३-२१०-५७", "content_sanskrit": "चिकीर्षेदेव कल्यायणं श्रद्दधानोऽनसूयकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2026764, "chapter_id": 1572, "verse_number": "३-२१०-५८", "content_sanskrit": "वसनस्येव च्छिद्राणइ साधूनां विवृणोति यः।\n`अपश्यन्नात्मनो दोषान्स पापः प्रेत्य नश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2026765, "chapter_id": 1572, "verse_number": "३-२१०-५९", "content_sanskrit": "पापं चेत्पुरुषः कृत्वा कल्याणमभिपद्यते।\nमुच्यते सर्वपापेभ्यो महाभ्रेणेव चन्द्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2026766, "chapter_id": 1572, "verse_number": "३-२१०-६०", "content_sanskrit": "यथाऽऽदित्यः समुद्यन्वै तमः सर्वं व्यपोहति।\nएवं कल्याणमातिष्ठन्सर्वपापैः प्रमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2026767, "chapter_id": 1572, "verse_number": "३-२१०-६१", "content_sanskrit": "पापानां विद्ध्यधिष्ठानं लोभमोहौ द्विजोत्तम।\n`तस्मात्तौ विदुषा विप्र वर्जनीयौ विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2026768, "chapter_id": 1572, "verse_number": "३-२१०-६२", "content_sanskrit": "लुबधाः पापं व्यवस्यन्ति नरा नातिबहुश्रुताः।\nअधर्म्या धर्मरूपेण तृणैः कूपा इवावृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2026769, "chapter_id": 1572, "verse_number": "३-२१०-६३", "content_sanskrit": "येषां पञ् पवित्राणि प्रलापा धर्मसंश्रितः।\nसर्वं हि विद्यते तेषु शिष्टाचारः सुदुर्लभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2026770, "chapter_id": 1572, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि दशाधिकद्विशततमोऽध्यायः ॥ २१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]