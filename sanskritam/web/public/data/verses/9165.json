[{"id": 5000165000, "chapter_id": 9165, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे अष्टाशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000165001, "chapter_id": 9165, "verse_number": "२-८८-१", "content_sanskrit": "तत् श्रुत्वा निपुणम् सर्वम् भरतः सह मन्त्रिभिः ।\nइन्गुदी मूलम् आगम्य राम शय्याम् अवेक्ष्य ताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000165002, "chapter_id": 9165, "verse_number": "२-८८-२", "content_sanskrit": "अब्रवीद् जननीः सर्वा इह तेन महात्मना ।\nशर्वरी शयिता भूमाउ इदम् अस्य विमर्दितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000165003, "chapter_id": 9165, "verse_number": "२-८८-३", "content_sanskrit": "महा भाग कुलीनेन महा भागेन धीमता ।\nजातो दशरथेन ऊर्व्याम् न रामः स्वप्तुम् अर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000165004, "chapter_id": 9165, "verse_number": "२-८८-४", "content_sanskrit": "अजिन उत्तर सम्स्तीर्णे वर आस्तरण सम्चये ।\nशयित्वा पुरुष व्याघ्रः कथम् शेते मही तले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000165005, "chapter_id": 9165, "verse_number": "२-८८-५", "content_sanskrit": "प्रासाद अग्र विमानेषु वलभीषु च सर्वदा ।\nहैम राजत भौमेषु वर आस्त्ररण शालिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000165006, "chapter_id": 9165, "verse_number": "२-८८-६", "content_sanskrit": "पुष्प सम्चय चित्रेषु चन्दन अगरु गन्धिषु ।\nपाण्डुर अभ्र प्रकाशेषु शुक सम्घ रुतेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000165007, "chapter_id": 9165, "verse_number": "२-८८-७", "content_sanskrit": "प्रासादवरवर्येषु शीतवत्सु सुगन्धिषु ।\nउषित्वा मेरुकल्पेषु कृतकाम्चनभित्तिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000165008, "chapter_id": 9165, "verse_number": "२-८८-८", "content_sanskrit": "गीत वादित्र निर्घोषैर् वर आभरण निह्स्वनैः ।\nमृदन्ग वर शब्दैः च सततम् प्रतिबोधितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000165009, "chapter_id": 9165, "verse_number": "२-८८-९", "content_sanskrit": "बन्दिभिर् वन्दितः काले बहुभिः सूत मागधैः ।\nगाथाभिर् अनुरूपाभिः स्तुतिभिः च परम्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000165010, "chapter_id": 9165, "verse_number": "२-८८-१०", "content_sanskrit": "अश्रद्धेयम् इदम् लोके न सत्यम् प्रतिभाति मा ।\nमुह्यते खलु मे भावः स्वप्नो अयम् इति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000165011, "chapter_id": 9165, "verse_number": "२-८८-११", "content_sanskrit": "न नूनम् दैवतम् किम्चित् कालेन बलवत्तरम् ।\nयत्र दाशरथी रामो भूमाउ एवम् शयीत सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000165012, "chapter_id": 9165, "verse_number": "२-८८-१२", "content_sanskrit": "विदेह राजस्य सुता सीता च प्रिय दर्शना ।\nदयिता शयिता भूमौ स्नुषा दशरथस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000165013, "chapter_id": 9165, "verse_number": "२-८८-१३", "content_sanskrit": "इयम् शय्या मम भ्रातुर् इदम् हि परिवर्तितम् ।\nस्थण्डिले कठिने सर्वम् गात्रैर् विमृदितम् तृणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000165014, "chapter_id": 9165, "verse_number": "२-८८-१४", "content_sanskrit": "मन्ये साभरणा सुप्ता सीता अस्मिन् शयने तदा ।\nतत्र तत्र हि दृश्यन्ते सक्ताः कनक बिन्दवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000165015, "chapter_id": 9165, "verse_number": "२-८८-१५", "content_sanskrit": "उत्तरीयम् इह आसक्तम् सुव्यक्तम् सीतया तदा ।\nतथा ह्य् एते प्रकाशन्ते सक्ताः कौशेय तन्तवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000165016, "chapter_id": 9165, "verse_number": "२-८८-१६", "content_sanskrit": "मन्ये भर्तुः सुखा शय्या येन बाला तपस्विनी ।\nसुकुमारी सती दुह्खम् न विजानाति मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000165017, "chapter_id": 9165, "verse_number": "२-८८-१७", "content_sanskrit": "हा हन्तास्मि नृशम्सोऽहम् यत्सभार्यः कृतेमम ।\nईदृशीं राघवः शय्यामधिशेते ह्यानाथवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000165018, "chapter_id": 9165, "verse_number": "२-८८-१८", "content_sanskrit": "सार्वभौम कुले जातः सर्व लोक सुख आवहः ।\nसर्व लोक प्रियः त्यक्त्वा राज्यम् प्रियम् अनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000165019, "chapter_id": 9165, "verse_number": "२-८८-१९", "content_sanskrit": "कथम् इन्दीवर श्यामो रक्त अक्षः प्रिय दर्शनः ।\nसुख भागी च दुह्ख अर्हः शयितो भुवि राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000165020, "chapter_id": 9165, "verse_number": "२-८८-२०", "content_sanskrit": "धन्यः खलु महाभागो लक्ष्मणः शुभलक्षमणः ।\nभ्रातरम् विषमे काले यो राममनुवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000165021, "chapter_id": 9165, "verse_number": "२-८८-२१", "content_sanskrit": "सिद्ध अर्था खलु वैदेही पतिम् या अनुगता वनम् ।\nवयम् सम्शयिताः सर्वे हीनाः तेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000165022, "chapter_id": 9165, "verse_number": "२-८८-२२", "content_sanskrit": "अकर्ण धारा पृथिवी शून्या इव प्रतिभाति मा ।\nगते दशरथे स्वर्गे रामे च अरण्यम् आश्रिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000165023, "chapter_id": 9165, "verse_number": "२-८८-२३", "content_sanskrit": "न च प्रार्थयते कश्चिन् मनसा अपि वसुम्धराम् ।\nवने अपि वसतः तस्य बाहु वीर्य अभिरक्षिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000165024, "chapter_id": 9165, "verse_number": "२-८८-२४", "content_sanskrit": "शून्य सम्वरणा रक्षाम् अयन्त्रित हय द्विपाम् ।\nअपावृत पुर द्वाराम् राज धानीम् अरक्षिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000165025, "chapter_id": 9165, "verse_number": "२-८८-२५", "content_sanskrit": "अप्रहृष्ट बलाम् न्यूनाम् विषमस्थाम् अनावृताम् ।\nशत्रवो न अभिमन्यन्ते भक्ष्यान् विष कृतान् इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000165026, "chapter_id": 9165, "verse_number": "२-८८-२६", "content_sanskrit": "अद्य प्रभृति भूमौ तु शयिष्ये अहम् तृणेषु वा ।\nफल मूल अशनो नित्यम् जटा चीराणि धारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000165027, "chapter_id": 9165, "verse_number": "२-८८-२७", "content_sanskrit": "तस्य अर्थम् उत्तरम् कालम् निवत्स्यामि सुखम् वने ।\nतम् प्रतिश्रवम् आमुच्य न अस्य मिथ्या भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000165028, "chapter_id": 9165, "verse_number": "२-८८-२८", "content_sanskrit": "वसन्तम् भ्रातुर् अर्थाय शत्रुघ्नो मा अनुवत्स्यति ।\nलक्ष्मणेन सह तु आर्यो अयोध्याम् पालयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000165029, "chapter_id": 9165, "verse_number": "२-८८-२९", "content_sanskrit": "अभिषेक्ष्यन्ति काकुत्स्थम् अयोध्यायाम् द्विजातयः ।\nअपि मे देवताः कुर्युर् इमम् सत्यम् मनो रथम् ।\nप्रसाद्यमानः शिरसा मया स्वयम् ।\nबहु प्रकारम् यदि न प्रपत्स्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000165030, "chapter_id": 9165, "verse_number": "२-८८-३०", "content_sanskrit": "ततोन्रुवत्सयामि चिराय राघवम् ।\nवनेचरम् नह्रुति माम्रुपेक्षित्रुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000165031, "chapter_id": 9165, "verse_number": null, "content_sanskrit": "इति वाल्मीकि रामायणे आदि काव्ये अयोध्याकाण्डे अष्टाशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]