[{"id": 2087758, "chapter_id": 2865, "verse_number": "१२-३७०-०x", "content_sanskrit": "नाग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087759, "chapter_id": 2865, "verse_number": "१२-३७०-१", "content_sanskrit": "अथ ब्राह्मणरूपेण कं तं समनुपश्यसि।\nमानुषं केवलं विप्रं देवं वाऽथ शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087760, "chapter_id": 2865, "verse_number": "१२-३७०-२", "content_sanskrit": "को हि मां मानुषः शक्तो द्रष्टुकामो यशस्विनि।\nसंदर्शनरुचिर्वाक्यमाज्ञापूर्वं वदिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087761, "chapter_id": 2865, "verse_number": "१२-३७०-३", "content_sanskrit": "सुरासुरगणानां च देवर्षीनां च भामिनि।\nननु नागा महावीर्याः सौरभेयास्तरस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087762, "chapter_id": 2865, "verse_number": "१२-३७०-४", "content_sanskrit": "वन्दनीयाश्च वरदा वयमप्यनुयायिनः।\nमनुष्याणां विशेषेण नावेक्ष्या इति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087763, "chapter_id": 2865, "verse_number": "१२-३७०-५x", "content_sanskrit": "नारभार्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087764, "chapter_id": 2865, "verse_number": "१२-३७०-५", "content_sanskrit": "आर्जवेन विजानामि नासौ देवोऽनिलाशन।\nएकं तस्मिन्विजानामि भक्तिमानतिरोपण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087765, "chapter_id": 2865, "verse_number": "१२-३७०-६", "content_sanskrit": "स हि कार्यान्तराकाङ्क्षी जलेप्सुः स्तोकको यथा।\nवर्षं वर्षप्रियः पक्षी दर्शनं तव काङ्क्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087766, "chapter_id": 2865, "verse_number": "१२-३७०-७", "content_sanskrit": "हित्वा त्वद्दर्शनं किंचिद्विघ्नं न प्रतिपालयेत्।\nतुल्योप्यभिजने जातो न कश्चित्पर्युपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087767, "chapter_id": 2865, "verse_number": "१२-३७०-८", "content_sanskrit": "तद्रोषं सहजं त्यक्त्वा त्वमेनं द्रष्टुमर्हसि।\nआशाच्छेदेन तस्याद्य नात्मानं दरधुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087768, "chapter_id": 2865, "verse_number": "१२-३७०-९", "content_sanskrit": "आशया ह्यभिपन्नानामकृत्वाऽश्रुप्रमार्जनम्।\nराजा वा राजपुत्रो वा भ्रूणहत्यैव युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087769, "chapter_id": 2865, "verse_number": "१२-३७०-१०", "content_sanskrit": "मौने ज्ञानफलावाप्तिर्दानेन च यशो महत्।\nवाग्मित्वं सत्यवाक्येन परत्र च महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087770, "chapter_id": 2865, "verse_number": "१२-३७०-११", "content_sanskrit": "भूप्रदानेन च गतिं लभत्याश्रमसंमिताम्।\nन्याय्यस्यार्धस्य संप्राप्तिं कृत्वा फलमुपाश्रुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087771, "chapter_id": 2865, "verse_number": "१२-३७०-१२", "content_sanskrit": "अभिप्रेतामसंश्लिष्टां कृत्वा चात्महितां क्रियाम्।\nन याति निरयं कश्चिदिति धर्मविदो विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087772, "chapter_id": 2865, "verse_number": "१२-३७०-१३x", "content_sanskrit": "नाम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087773, "chapter_id": 2865, "verse_number": "१२-३७०-१३", "content_sanskrit": "अभिमानैर्न मानो मे जातिदोषेण वै महान्।\nरोषः संकल्पजः साध्वि दग्धो वागग्निना त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087774, "chapter_id": 2865, "verse_number": "१२-३७०-१४", "content_sanskrit": "न च रोषादहं साध्वि पश्येयमधिकं तमः।\nतस्य वक्तव्यतां याति विशेषेण भुजङ्गमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087775, "chapter_id": 2865, "verse_number": "१२-३७०-१५", "content_sanskrit": "रोषस्य हि वशं गत्वा दशग्नीवः प्रतापवान्।\nतथा शक्रप्रतिस्पर्धी हतो रामेण संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2087776, "chapter_id": 2865, "verse_number": "१२-३७०-१६", "content_sanskrit": "अन्तःपुरगतं वत्सं श्रुत्वा रामेण निर्हृतम्।\nधर्मणारोषसंविग्नाः कार्तवीर्यसुता हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2087777, "chapter_id": 2865, "verse_number": "१२-३७०-१७", "content_sanskrit": "जामदग्न्येन रामेण सहस्रनयनोपमः।\nसंयुगे निहतो रोषात्कार्तवीर्यो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2087778, "chapter_id": 2865, "verse_number": "१२-३७०-१८", "content_sanskrit": "तदेष तपसां शत्रुः श्रेयसां विनिपातकः।\nनिगृहीतो मया रोषः श्रुत्वैवं वचनं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2087779, "chapter_id": 2865, "verse_number": "१२-३७०-१९", "content_sanskrit": "आत्मानं च विशेषेण प्रशंसाम्यनपायिनि।\nयस्य मे त्वं विशालाक्षि भार्या गुणसमन्विता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2087780, "chapter_id": 2865, "verse_number": "१२-३७०-२०", "content_sanskrit": "एष तत्रैव गच्छामि यत्र तिष्ठत्यसौ द्विजः।\nसर्वथा चोक्तवान्वाक्यं स कृतार्थः प्रयास्यति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2087781, "chapter_id": 2865, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्तत्यधिकत्रिशततमोऽध्यायः॥ ३७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]