[{"id": 7005045000, "chapter_id": 25045, "verse_number": "७-१-२२८-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि मातृस्थानमनुत्तमम् ।\nभैरवेशेति विख्यातं सर्वभयविनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005045001, "chapter_id": 25045, "verse_number": "७-१-२२८-२", "content_sanskrit": "चतुर्दश्यां विधानेन कृष्णपक्षे यतात्मवान् ।\nपूजयेद्गन्धपुष्पैश्च बलिदानैस्तथोत्तमैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005045002, "chapter_id": 25045, "verse_number": "७-१-२२८-३", "content_sanskrit": "तं पुत्रमिव योगिन्यो रक्षंति भुवि मातरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]