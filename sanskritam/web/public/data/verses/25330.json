[{"id": 7005330000, "chapter_id": 25330, "verse_number": "८-२१-१", "content_sanskrit": "निर्गतोऽथ ततो नन्दी जगाम सरितां वराम् ।\nभुवनामिति विख्यातां सर्वलोकसुखावहाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005330001, "chapter_id": 25330, "verse_number": "८-२१-२", "content_sanskrit": "तां प्रविश्य ततो धीमानेकाग्रो हदमास्थितः ।\nस जजाप तदा रुद्रान्मृत्योर्भीतः समाहितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005330002, "chapter_id": 25330, "verse_number": "८-२१-३", "content_sanskrit": "जपता तेन तत्रैव तत्परेण तदाशिषा ।\nकोटिरेका यदा जप्ता तदा देवस्तुतोष ह ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005330003, "chapter_id": 25330, "verse_number": "८-२१-४", "content_sanskrit": "तमागत्याह भगवाञ्छर्व उग्रः कपर्दिमान् ।\nनन्दिंस्तुष्टोऽस्मि भद्रं ते वरं वृणु यथेप्सितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005330004, "chapter_id": 25330, "verse_number": "८-२१-५", "content_sanskrit": "उवाच प्रणतो भूत्वा प्रणतार्तिहरं हरम् ।\nद्वितीयां जप्तुमिच्छामि कोटिं भगवतां विभो ।\nएवमस्त्विति देवोऽपि प्रोच्यागच्छद्यथागतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005330005, "chapter_id": 25330, "verse_number": "८-२१-६", "content_sanskrit": "सनत्कुमार उवाच ।\nसोऽवतीर्य ततो भूयः प्रयतात्मा तथैव ह ।\nजजाप कोटिमन्यां तु रुद्रमेवानुचिन्तयन् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005330006, "chapter_id": 25330, "verse_number": "८-२१-७", "content_sanskrit": "द्वितीयायां ततः कोट्यां सम्पूर्णायां वृषध्वजः ।\nअभ्याजगाम तं चैव वरदोऽस्मीत्यभाषत ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005330007, "chapter_id": 25330, "verse_number": "८-२१-८", "content_sanskrit": "स प्राह भगवन्कोटिं तृतीयामपि कालहन् ।\nजप्तुमिच्छामि देवेश त्वत्प्रसादादहं विभो ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005330008, "chapter_id": 25330, "verse_number": "८-२१-९", "content_sanskrit": "एवमस्त्विति भूयोऽपि भगवान्प्रत्युवाच ह ।\nउक्त्वा जगाम स्वं वेश्म देव्या सह महाद्युतिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005330009, "chapter_id": 25330, "verse_number": "८-२१-१०", "content_sanskrit": "ततस्तृतीयां रुद्राणां कोटिमन्यां जजाप ह ।\nयुगान्तादित्यसंकाशस्ततः समभवद्द्विजः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005330010, "chapter_id": 25330, "verse_number": "८-२१-११", "content_sanskrit": "तस्य कोटीत्रये व्यास समाप्ते ज्वलनत्विषः ।\nसोमः सह गणैर्देवस्तं देशमुपचक्रमे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005330011, "chapter_id": 25330, "verse_number": "८-२१-१२", "content_sanskrit": "सतं करेण संगृह्य उद्धत्य सलिलाच्च ह ।\nसंमृजानोऽग्रहस्तेन नन्दिनं कालहाब्रवीत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005330012, "chapter_id": 25330, "verse_number": "८-२१-१३", "content_sanskrit": "देव उवाच ।\nशैलादे वरदोऽहं तपसानेन तोषितः ।\nसाधु जप्तं त्वया धीमन्ब्रूहि यत्ते मनोगतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005330013, "chapter_id": 25330, "verse_number": "८-२१-१४", "content_sanskrit": "शैलादिरुवाच ।\nजपेयं कोटिमन्यां तु भूयोऽपि तव तेजसा ।\nवरमेतं वृणे देव यदि तुष्टोऽसि मे विभो ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005330014, "chapter_id": 25330, "verse_number": "८-२१-१५", "content_sanskrit": "भगवानुवाच ।\nकिं ते जप्तेन भूयोऽपि तुष्टोऽस्मि तव सर्वथा ।\nयद्यत्त्वं वृणुषे कामं सर्वं तत्प्रददानि ते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005330015, "chapter_id": 25330, "verse_number": "८-२१-१६", "content_sanskrit": "ब्रह्मत्वमथ विष्णुत्वमिन्द्रत्वमथ वायुताम् ।\nआदित्यो भव रुद्रो वा ब्रूहि किं वा ददानि ते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005330016, "chapter_id": 25330, "verse_number": "८-२१-१७", "content_sanskrit": "सनत्कुमार उवाच ।\nस एवमुक्तो देवेन शिरसा पादयोर्नतः ।\nतुष्टाव पुरकामाङ्गक्रतुपर्वतनाशनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005330017, "chapter_id": 25330, "verse_number": "८-२१-१८", "content_sanskrit": "नन्द्युवाच ।\nनमो देवातिदेवाय महादेवाय वै नमः ।\nनमः कामाङ्गनाशाय नीलकण्ठाय वै नमः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005330018, "chapter_id": 25330, "verse_number": "८-२१-१९", "content_sanskrit": "नमस्तुषितनाशाय त्रैलोक्यदहनाय च ।\nनमः कालोग्रदण्डाय उग्रदण्डाय वै नमः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005330019, "chapter_id": 25330, "verse_number": "८-२१-२०", "content_sanskrit": "नमो नीलशिखण्डाय सहस्रशिरसे नमः ।\nसहस्रपाणये चैव सहस्रचरणाय च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005330020, "chapter_id": 25330, "verse_number": "८-२१-२१", "content_sanskrit": "सर्वतः पाणिपादाय सर्वतोक्षिमुखाय च ।\nसर्वतः श्रुतये चैव सर्वमावृत्य तिष्ठते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005330021, "chapter_id": 25330, "verse_number": "८-२१-२२", "content_sanskrit": "नमस्ते रुक्मवर्णाय तथैवातीन्द्रियाय च ।\nनमः कनकलिङ्गाय सर्वलिङ्गाय वै नमः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005330022, "chapter_id": 25330, "verse_number": "८-२१-२३", "content_sanskrit": "नमश्चन्द्रार्कवर्णाय योगेशायाजिताय च ।\nपिनाकपाणये चैव शूलमुद्गरपाणये ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005330023, "chapter_id": 25330, "verse_number": "८-२१-२४", "content_sanskrit": "गदिने खड्गिने चैव परश्वधधराय च ।\nरथिने वर्मिणे चैव महेष्वासाय वै नमः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005330024, "chapter_id": 25330, "verse_number": "८-२१-२५", "content_sanskrit": "नमस्त्रिशूलहस्ताय उग्रदण्डधराय च ।\nनमो गणाधिपतये रुद्राणां पतये नमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005330025, "chapter_id": 25330, "verse_number": "८-२१-२६", "content_sanskrit": "नमः सहस्रनेत्राय शतनेत्राय वै नमः ।\nआदित्यानां च पतये वसूनां पतये नमः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005330026, "chapter_id": 25330, "verse_number": "८-२१-२७", "content_sanskrit": "नमः पृथिव्याः पतये आकाशपतये नमः ।\nनमः स्वर्लोकपतये उमायाः पतये नमः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005330027, "chapter_id": 25330, "verse_number": "८-२१-२८", "content_sanskrit": "नमो योगाधिपतये सर्वयोगप्रदाय च ।\nध्यानिने ध्यायमानाय ध्यानिभिः संस्तुताय च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005330028, "chapter_id": 25330, "verse_number": "८-२१-२९", "content_sanskrit": "मृत्यवे कालदण्डाय यमाय च महात्मने ।\nदेवाधिपतये चैव दिव्यसंहननाय च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005330029, "chapter_id": 25330, "verse_number": "८-२१-३०", "content_sanskrit": "यज्ञाय वसुदानाय स्वर्गायाजन्मदाय च ।\nसवित्रे सर्वदेवानां धर्मायानेकरूपिणे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005330030, "chapter_id": 25330, "verse_number": "८-२१-३१", "content_sanskrit": "अमृताय वरेण्याय सर्वदेवस्तुताय च ।\nब्रह्मणश्च शिरोह यज्ञस्य च महात्मनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005330031, "chapter_id": 25330, "verse_number": "८-२१-३२", "content_sanskrit": "त्रिपुरघ्नाय चोग्राय सर्वाशुभहराय च ।\nउमादेहार्धरूपाय ललाटनयनाय च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005330032, "chapter_id": 25330, "verse_number": "८-२१-३३", "content_sanskrit": "महिषान्धकभेत्ताय स्रष्ट्रे वै परमेष्ठिने ।\nब्रह्मणो गुरवे चैव ब्रह्मणो जनकाय च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005330033, "chapter_id": 25330, "verse_number": "८-२१-३४", "content_sanskrit": "कुमारगुरवे चैव कुमारवरदाय च ।\nहलिने मुषलघ्नाय महाहासाय वै नमः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005330034, "chapter_id": 25330, "verse_number": "८-२१-३५", "content_sanskrit": "मृत्युपाशोग्रहस्ताय तक्षकब्रह्मसूत्रिणे ।\nसविद्युद्वनवाहाय तथैव वृषयायिने ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005330035, "chapter_id": 25330, "verse_number": "८-२१-३६", "content_sanskrit": "हिमवद्विन्ध्यवासाय मेरुपर्वतवासिने ।\nकैलासवासिने चैव धनेश्वरसखाय च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005330036, "chapter_id": 25330, "verse_number": "८-२१-३७", "content_sanskrit": "विष्णोर्देहार्धदत्ताय तस्यैव वरदाय च ।\nसर्वभूतासमज्ञाय सर्वभूतानुकम्पिने ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005330037, "chapter_id": 25330, "verse_number": "८-२१-३८", "content_sanskrit": "अन्तर्भूताधिभूताय प्राणिनां जीवदाय च ।\nमनसे मन्यमानाय प्रतिमानाय चैव हि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005330038, "chapter_id": 25330, "verse_number": "८-२१-३९", "content_sanskrit": "बुध्यमानाय बुद्धाय द्रष्ट्रे वै चक्षुषे नमः ।\nनमस्ते स्पर्शयित्रे च तथैव स्पर्शनाय च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005330039, "chapter_id": 25330, "verse_number": "८-२१-४०", "content_sanskrit": "नमस्ते रसयित्रे च तथैव रसनाय च ।\nनमो घ्राणाय घ्रात्रे च श्रोत्रे श्रोत्राय चैव हि ।\nहस्तिने चैव हस्ताय तथा पादाय पादिने ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005330040, "chapter_id": 25330, "verse_number": "८-२१-४१", "content_sanskrit": "नमोऽस्त्वानन्दकर्त्रे च श्रानन्दाय च वै नमः ।\nवाचेऽथ वाग्मिने चैव तन्मात्राय महात्मने ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005330041, "chapter_id": 25330, "verse_number": "८-२१-४२", "content_sanskrit": "सूक्ष्माय चैव स्थूलाय सत्त्वाय रजसे नमः ।\nनमश्च तमसे नित्यं क्षेत्रज्ञायाजिताय च ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005330042, "chapter_id": 25330, "verse_number": "८-२१-४३", "content_sanskrit": "विष्णवे लोकतन्त्राय प्रजानां पतये नमः ।\nमनवे सप्तऋषये तप्यमानाय तापिने ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005330043, "chapter_id": 25330, "verse_number": "८-२१-४४", "content_sanskrit": "ब्रह्मण्यायाथ शुद्धाय तथा दुर्वाससे नमः ।\nशिल्पिने शिल्पनाथाय विदुषे विश्वकर्मणे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005330044, "chapter_id": 25330, "verse_number": "८-२१-४५", "content_sanskrit": "अत्रये भृगवे चैव तथैवाङ्गिरसे नमः ।\nपुलहाय पुलस्त्याय क्रतुदक्षानलाय च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005330045, "chapter_id": 25330, "verse_number": "८-२१-४६", "content_sanskrit": "धर्माय रुचये चैव वसिष्ठाय नमोऽस्तु ते ।\nभूताय भूतनाथाय कुष्माण्डपतये नमः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005330046, "chapter_id": 25330, "verse_number": "८-२१-४७", "content_sanskrit": "तिष्ठते द्रवते चैव गायते नृत्यतेऽपि च ।\nअवश्यायाप्यवध्याय अजरायामराय च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005330047, "chapter_id": 25330, "verse_number": "८-२१-४८", "content_sanskrit": "अक्षयायाव्ययायैव तथाप्रतिहताय च ।\nअनावेश्याय सर्वेषां दृश्यायादृश्यरूपिणे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005330048, "chapter_id": 25330, "verse_number": "८-२१-४९", "content_sanskrit": "सूक्ष्मेभ्यश्चापि सूक्ष्माय सर्वगाय महात्मने ।\nनमस्ते भगवंस्त्र्यक्ष नमस्ते भगवञ्छिव ।\nनमस्ते सर्वलोकेश नमस्ते लोकभावन ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005330049, "chapter_id": 25330, "verse_number": "८-२१-५०", "content_sanskrit": "न मे देवाधिपत्येन ब्रह्मत्वेनाथवा पुनः ।\nन विष्णुत्वेन देवेश नापीन्द्रत्वेन भूतप ।\nइच्छाम्यहं तवेशान गणत्वं नित्यमव्ययम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005330050, "chapter_id": 25330, "verse_number": "८-२१-५१", "content_sanskrit": "नित्यं त्वां सगणं साम्बं प्रसन्नं सपरिच्छदम् ।\nद्रष्टमिच्छामि देवेश एष मे दीयतां वरः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005330051, "chapter_id": 25330, "verse_number": "८-२१-५२", "content_sanskrit": "त्वं नो गतिः पुरा देव त्वं चैवार्तायनं प्रभुः ।\nशरणं च त्वमेवाथ नान्यं पश्यामि कर्हिचित् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005330052, "chapter_id": 25330, "verse_number": "८-२१-५३", "content_sanskrit": "त्वया त्यक्तस्य चैवाशु विनाशो नात्र संशयः ।\nअन्यां गतिं न पश्यामि यस्या प्रात्यन्तिकं शुभम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005330053, "chapter_id": 25330, "verse_number": "८-२१-५४", "content_sanskrit": "अनुरक्तं च भक्तं च त्वत्परं त्वदपाश्रयम् ।\nप्रतीच्छ मां सदा देव एष मे दीयतां वरः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005330054, "chapter_id": 25330, "verse_number": "८-२१-५५", "content_sanskrit": "सनत्कुमार उवाच ।\nय इमं प्रातरुत्थाय पठेदविमना नरः ।\nस देहभेदमासाद्य नन्दीश्वरसमो भवेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005330055, "chapter_id": 25330, "verse_number": "८-२१-५६", "content_sanskrit": "यश्चेमं शृणुयान्नित्यं श्रावयेद्वा द्विजातिषु ।\nसोऽश्वमेधफलं प्राप्य रुद्रलोके महीयते ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005330056, "chapter_id": 25330, "verse_number": "८-२१-५७", "content_sanskrit": "श्रुत्वा सकृदपि ह्येतं स्तवं पापप्रणाशनम् ।\nयत्र तत्र मृतो व्यास न दुर्गतिमवाप्नुयात् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005330057, "chapter_id": 25330, "verse_number": "८-२१-५८", "content_sanskrit": "योऽधीत्य नित्यं स्तवमेतमग्रयं देवं सदाभ्यर्चयते यतात्मा ।\nकिं तस्य यज्ञैर्विविधैश्च दानैस्तीर्थैः सुतप्तैश्च तथा तपोभिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]