[{"id": 5000467000, "chapter_id": 9467, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे षष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000467001, "chapter_id": 9467, "verse_number": "६-६०-१", "content_sanskrit": "स प्रविश्य पुरीं लङ्कां रामबाणभयार्दितः।\nभग्नदर्पस्तदा राजा बभूव व्यथितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000467002, "chapter_id": 9467, "verse_number": "६-६०-२", "content_sanskrit": "मातंग इव सिंहेन गरुडेनेव पन्नगः।\nअभिभूतोऽभवद् राजा राघवेण महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000467003, "chapter_id": 9467, "verse_number": "६-६०-३", "content_sanskrit": "ब्रह्मदण्डप्रतीकानां विद्युच्चलितवर्चसाम्।\nस्मरन् राघवबाणानां विव्यथे राक्षसेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000467004, "chapter_id": 9467, "verse_number": "६-६०-४", "content_sanskrit": "स काञ्चनमयं दिव्यमाश्रित्य परमासनम्।\nविप्रेक्षमाणो रक्षांसि रावणो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000467005, "chapter_id": 9467, "verse_number": "६-६०-५", "content_sanskrit": "सर्वं तत् खलु मे मोघं यत् तप्तं परमं तपः।\nयत् समानो महेन्द्रेण मानुषेण विनिर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000467006, "chapter_id": 9467, "verse_number": "६-६०-६", "content_sanskrit": "इदं तद् ब्रह्मणो घोरं वाक्यं मामभ्युपस्थितम्।\nमानुषेभ्यो विजानीहि भयं त्वमिति तत्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000467007, "chapter_id": 9467, "verse_number": "६-६०-७", "content_sanskrit": "देवदानवगन्धर्वैर्यक्षराक्षसपन्नगैः।\nअवध्यत्वं मया प्रोक्तं मानुषेभ्यो न याचितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000467008, "chapter_id": 9467, "verse_number": "६-६०-८", "content_sanskrit": "तमिमं मानुषं मन्ये रामं दशरथात्मजम्।\nइक्ष्वाकुकुलजातेन अनरण्येन यत् पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000467009, "chapter_id": 9467, "verse_number": "६-६०-९", "content_sanskrit": "उत्पत्स्यति हि मद्वंशपुरुषो राक्षसाधम।\nयस्त्वां सपुत्रं सामात्यं सबलं साश्वसारथिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000467010, "chapter_id": 9467, "verse_number": "६-६०-१०", "content_sanskrit": "निहनिष्यति संग्रामे त्वां कुलाधम दुर्मते।\nशप्तोऽहं वेदवत्या च यथा सा धर्षिता पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000467011, "chapter_id": 9467, "verse_number": "६-६०-११", "content_sanskrit": "सेयं सीता महाभागा जाता जनकनन्दिनी।\nउमा नन्दीश्वरश्चापि रम्भा वरुणकन्यका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000467012, "chapter_id": 9467, "verse_number": "६-६०-१२", "content_sanskrit": "यथोक्तास्तन्मया प्राप्तं न मिथ्या ऋषिभाषितम्।\nएतदेव समागम्य यत्नं कर्तुमिहार्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000467013, "chapter_id": 9467, "verse_number": "६-६०-१३", "content_sanskrit": "राक्षसाश्चापि तिष्ठन्तु चर्यागोपुरमूर्धसु।\nस चाप्रतिमगाम्भीर्यो देवदानवदर्पहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000467014, "chapter_id": 9467, "verse_number": "६-६०-१४", "content_sanskrit": "ब्रह्मशापाभिभूतस्तु कुम्भकर्णो विबोध्यताम्।\nसमरे जितमात्मानं प्रहस्तं च निषूदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000467015, "chapter_id": 9467, "verse_number": "६-६०-१५", "content_sanskrit": "ज्ञात्वा रक्षोबलं भीममादिदेश महाबलः।\nद्वारेषु यत्नः क्रियतां प्राकारश्चाधिरुह्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000467016, "chapter_id": 9467, "verse_number": "६-६०-१६", "content_sanskrit": "निद्रावशसमाविष्टः कुम्भकर्णो विबोध्यताम्।\nसुखं स्वपिति निश्चिन्तः कामोपहतचेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000467017, "chapter_id": 9467, "verse_number": "६-६०-१७", "content_sanskrit": "नव सप्त दशाष्टौ च मासान् स्वपिति राक्षसः।\nमन्त्रं कृत्वा प्रसुप्तोऽयमितस्तु नवमेऽहनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000467018, "chapter_id": 9467, "verse_number": "६-६०-१८", "content_sanskrit": "तं तु बोधयत क्षिप्रं कुम्भकर्णं महाबलम्।\nस हि संख्ये महाबाहुः ककुदं सर्वरक्षसाम्।\nवानरान् राजपुत्रौ च क्षिप्रमेव हनिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000467019, "chapter_id": 9467, "verse_number": "६-६०-१९", "content_sanskrit": "एष केतुः परं संख्ये मुख्यो वै सर्वरक्षसाम्।\nकुम्भकर्णः सदा शेते मूढो ग्राम्यसुखे रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000467020, "chapter_id": 9467, "verse_number": "६-६०-२०", "content_sanskrit": "रामेणाभिनिरस्तस्य संग्रामेऽस्मिन् सुदारुणे।\nभविष्यति न मे शोकः कुम्भकर्णे विबोधिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000467021, "chapter_id": 9467, "verse_number": "६-६०-२१", "content_sanskrit": "किं करिष्याम्यहं तेन शक्रतुल्यबलेन हि।\nईदृशे व्यसने घोरे यो न साह्याय कल्पते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000467022, "chapter_id": 9467, "verse_number": "६-६०-२२", "content_sanskrit": "ते तु तद् वचनं श्रुत्वा राक्षसेन्द्रस्य राक्षसाः।\nजग्मुः परमसम्भ्रान्ताः कुम्भकर्णनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000467023, "chapter_id": 9467, "verse_number": "६-६०-२३", "content_sanskrit": "ते रावणसमादिष्टा मांसशोणितभोजनाः।\nगन्धं माल्यं महद्भक्ष्यमादाय सहसा ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000467024, "chapter_id": 9467, "verse_number": "६-६०-२४", "content_sanskrit": "तां प्रविश्य महाद्वारां सर्वतो योजनायताम्।\nकुम्भकर्णगुहां रम्यां पुष्पगन्धप्रवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000467025, "chapter_id": 9467, "verse_number": "६-६०-२५", "content_sanskrit": "कुम्भकर्णस्य निःश्वासादवधूता महाबलाः।\nप्रतिष्ठमानाः कृच्छ्रेण यत्नात् प्रविविशुर्गुहाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000467026, "chapter_id": 9467, "verse_number": "६-६०-२६", "content_sanskrit": "तां प्रविश्य गुहां रम्यां रत्नकाञ्चनकुट्टिमाम्।\nददृशुर्नैर्ऋतव्याघ्राः शयानं भीमविक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000467027, "chapter_id": 9467, "verse_number": "६-६०-२७", "content_sanskrit": "ते तु तं विकृतं सुप्तं विकीर्णमिव पर्वतम्।\nकुम्भकर्णं महानिद्रं समेताः प्रत्यबोधयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000467028, "chapter_id": 9467, "verse_number": "६-६०-२८", "content_sanskrit": "ऊर्ध्वलोमाञ्चिततनुं श्वसन्तमिव पन्नगम्।\nभ्रामयन्तं विनिःश्वासैः शयानं भीमविक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000467029, "chapter_id": 9467, "verse_number": "६-६०-२९", "content_sanskrit": "भीमनासापुटं तं तु पातालविपुलाननम्।\nशयने न्यस्तसर्वाङ्गं मेदोरुधिरगन्धिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000467030, "chapter_id": 9467, "verse_number": "६-६०-३०", "content_sanskrit": "काञ्चनाङ्गदनद्धाङ्गं किरीटेनार्कवर्चसम्।\nददृशुर्नैर्ऋतव्याघ्रं कुम्भकर्णमरिंदमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000467031, "chapter_id": 9467, "verse_number": "६-६०-३१", "content_sanskrit": "ततश्चक्रुर्महात्मानः कुम्भकर्णस्य चाग्रतः।\nभूतानां मेरुसंकाशं राशिं परमतर्पणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000467032, "chapter_id": 9467, "verse_number": "६-६०-३२", "content_sanskrit": "मृगाणां महिषाणां च वराहाणां च संचयान्।\nचक्रुर्नैर्ऋतशार्दूला राशिमन्नस्य चाद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000467033, "chapter_id": 9467, "verse_number": "६-६०-३३", "content_sanskrit": "ततः शोणितकुम्भांश्च मांसानि विविधानि च।\nपुरस्तात् कुम्भकर्णस्य चक्रुस्त्रिदशशत्रवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000467034, "chapter_id": 9467, "verse_number": "६-६०-३४", "content_sanskrit": "लिलिपुश्च परार्घ्येन चन्दनेन परंतपम्।\nदिव्यैराश्वासयामासुर्माल्यैर्गन्धैश्च गन्धिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000467035, "chapter_id": 9467, "verse_number": "६-६०-३५", "content_sanskrit": "धूपगन्धांश्च ससृजुस्तुष्टुवुश्च परंतपम्।\nजलदा इव चानेदुर्यातुधानास्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000467036, "chapter_id": 9467, "verse_number": "६-६०-३६", "content_sanskrit": "शङ्खांश्च पूरयामासुः शशाङ्कसदृशप्रभान्।\nतुमुलं युगपच्चापि विनेदुश्चाप्यमर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000467037, "chapter_id": 9467, "verse_number": "६-६०-३७", "content_sanskrit": "नेदुरास्फोटयामासुश्चिक्षिपुस्ते निशाचराः।\nकुम्भकर्णविबोधार्थं चक्रुस्ते विपुलं स्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000467038, "chapter_id": 9467, "verse_number": "६-६०-३८", "content_sanskrit": "सशङ्खभेरीपणवप्रणादं\nसास्फोटितक्ष्वेलितसिंहनादम्।\nदिशो द्रवन्तस्त्रिदिवं किरन्तः\nश्रुत्वा विहंगाः सहसा निपेतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000467039, "chapter_id": 9467, "verse_number": "६-६०-३९", "content_sanskrit": "यदा भृशं तैर्निनदैर्महात्मा\nन कुम्भकर्णो बुबुधे प्रसुप्तः।\nततो भुशुण्डीर्मुसलानि सर्वे\nरक्षोगणास्ते जगृहुर्गदाश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000467040, "chapter_id": 9467, "verse_number": "६-६०-४०", "content_sanskrit": "तं शैलशृङ्गैर्मुसलैर्गदाभि-\nर्वक्षःस्थले मुद‍्गरमुष्टिभिश्च।\nसुखप्रसुप्तं भुवि कुम्भकर्णं\nरक्षांस्युदग्राणि तदा निजघ्नुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000467041, "chapter_id": 9467, "verse_number": "६-६०-४१", "content_sanskrit": "तस्य निःश्वासवातेन कुम्भकर्णस्य रक्षसः।\nराक्षसाः कुम्भकर्णस्य स्थातुं शेकुर्न चाग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000467042, "chapter_id": 9467, "verse_number": "६-६०-४२", "content_sanskrit": "ततः परिहिता गाढं राक्षसा भीमविक्रमाः।\nमृदङ्गपणवान् भेरीः शङ्खकुम्भगणांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000467043, "chapter_id": 9467, "verse_number": "६-६०-४३", "content_sanskrit": "दश राक्षससाहस्रं युगपत्पर्यवारयत्।\nनीलाञ्जनचयाकारं ते तु तं प्रत्यबोधयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000467044, "chapter_id": 9467, "verse_number": "६-६०-४४", "content_sanskrit": "अभिघ्नन्तो नदन्तश्च न च सम्बुबुधे तदा।\nयदा चैनं न शेकुस्ते प्रतिबोधयितुं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000467045, "chapter_id": 9467, "verse_number": "६-६०-४५", "content_sanskrit": "ततो गुरुतरं यत्नं दारुणं समुपाक्रमन्।\nअश्वानुष्ट्रान् खरान् नागाञ्जघ्नुर्दण्डकशाङ्कुशैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000467046, "chapter_id": 9467, "verse_number": "६-६०-४६", "content_sanskrit": "भेरीशङ्खमृदङ्गांश्च सर्वप्राणैरवादयन्।\nनिजघ्नुश्चास्य गात्राणि महाकाष्ठकटंकरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000467047, "chapter_id": 9467, "verse_number": "६-६०-४७", "content_sanskrit": "मुद‍्गरैर्मुसलैश्चापि सर्वप्राणसमुद्यतैः।\nतेन नादेन महता लङ्का सर्वा प्रपूरिता।\nसपर्वतवना सर्वा सोऽपि नैव प्रबुध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000467048, "chapter_id": 9467, "verse_number": "६-६०-४८", "content_sanskrit": "ततो भेरीसहस्रं तु युगपत् समहन्यत।\nमृष्टकाञ्चनकोणानामसक्तानां समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000467049, "chapter_id": 9467, "verse_number": "६-६०-४९", "content_sanskrit": "एवमप्यतिनिद्रस्तु यदा नैव प्रबुध्यते।\nशापस्य वशमापन्नस्ततः क्रुद्धा निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000467050, "chapter_id": 9467, "verse_number": "६-६०-५०", "content_sanskrit": "ततः कोपसमाविष्टाः सर्वे भीमपराक्रमाः।\nतद् रक्षो बोधयिष्यन्तश्चक्रुरन्ये पराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000467051, "chapter_id": 9467, "verse_number": "६-६०-५१", "content_sanskrit": "अन्ये भेरीः समाजघ्नुरन्ये चक्रुर्महास्वनम्।\nकेशानन्ये प्रलुलुपुः कर्णानन्ये दशन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000467052, "chapter_id": 9467, "verse_number": "६-६०-५२", "content_sanskrit": "उदकुम्भशतानन्ये समसिञ्चन्त कर्णयोः।\nन कुम्भकर्णः पस्पन्दे महानिद्रावशं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000467053, "chapter_id": 9467, "verse_number": "६-६०-५३", "content_sanskrit": "अन्ये च बलिनस्तस्य कूटमुद‍्गरपाणयः।\nमूर्ध्नि वक्षसि गात्रेषु पातयन् कूटमुद‍्गरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000467054, "chapter_id": 9467, "verse_number": "६-६०-५४", "content_sanskrit": "रज्जुबन्धनबद्धाभिः शतघ्नीभिश्च सर्वतः।\nवध्यमानो महाकायो न प्राबुध्यत राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000467055, "chapter_id": 9467, "verse_number": "६-६०-५५", "content_sanskrit": "वारणानां सहस्रं च शरीरेऽस्य प्रधावितम्।\nकुम्भकर्णस्तदा बुद्‍ध्वा स्पर्शं परमबुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000467056, "chapter_id": 9467, "verse_number": "६-६०-५६", "content_sanskrit": "स पात्यमानैर्गिरिशृङ्गवृक्षै-\nरचिन्तयंस्तान् विपुलान् प्रहारान्।\nनिद्राक्षयात् क्षुद्भयपीडितश्च\nविजृम्भमाणः सहसोत्पपात ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000467057, "chapter_id": 9467, "verse_number": "६-६०-५७", "content_sanskrit": "स नागभोगाचलशृङ्गकल्पौ\nविक्षिप्य बाहू जितवज्रसारौ।\nविवृत्य वक्त्रं वडवामुखाभं\nनिशाचरोऽसौ विकृतं जजृम्भे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000467058, "chapter_id": 9467, "verse_number": "६-६०-५८", "content_sanskrit": "तस्य जाजृम्भमाणस्य वक्त्रं पातालसंनिभम्।\nददृशे मेरुशृङ्गाग्रे दिवाकर इवोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000467059, "chapter_id": 9467, "verse_number": "६-६०-५९", "content_sanskrit": "स जृम्भमाणोऽतिबलः प्रबुद्धस्तु निशाचरः।\nनिःश्वासश्चास्य संजज्ञे पर्वतादिव मारुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000467060, "chapter_id": 9467, "verse_number": "६-६०-६०", "content_sanskrit": "रूपमुत्तिष्ठतस्तस्य कुम्भकर्णस्य तद् बभौ।\nयुगान्ते सर्वभूतानि कालस्येव दिधक्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000467061, "chapter_id": 9467, "verse_number": "६-६०-६१", "content_sanskrit": "तस्य दीप्ताग्निसदृशे विद्युत्सदृशवर्चसी।\nददृशाते महानेत्रे दीप्ताविव महाग्रहौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000467062, "chapter_id": 9467, "verse_number": "६-६०-६२", "content_sanskrit": "ततस्त्वदर्शयन् सर्वान् भक्ष्यांश्च विविधान् बहून्।\nवराहान् महिषांश्चैव बभक्ष स महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000467063, "chapter_id": 9467, "verse_number": "६-६०-६३", "content_sanskrit": "आदद् बुभुक्षितो मांसं शोणितं तृषितोऽपिबत्।\nमेदःकुम्भांश्च मद्यांश्च पपौ शक्ररिपुस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000467064, "chapter_id": 9467, "verse_number": "६-६०-६४", "content_sanskrit": "ततस्तृप्त इति ज्ञात्वा समुत्पेतुर्निशाचराः।\nशिरोभिश्च प्रणम्यैनं सर्वतः पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000467065, "chapter_id": 9467, "verse_number": "६-६०-६५", "content_sanskrit": "निद्राविशदनेत्रस्तु कलुषीकृतलोचनः।\nचारयन् सर्वतो दृष्टिं तान् ददर्श निशाचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000467066, "chapter_id": 9467, "verse_number": "६-६०-६६", "content_sanskrit": "स सर्वान् सान्त्वयामास नैर्ऋतान् नैर्ऋतर्षभः।\nबोधनाद् विस्मितश्चापि राक्षसानिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000467067, "chapter_id": 9467, "verse_number": "६-६०-६७", "content_sanskrit": "किमर्थमहमादृत्य भवद्भिः प्रतिबोधितः।\nकच्चित् सुकुशलं राज्ञो भयं वा नेह किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000467068, "chapter_id": 9467, "verse_number": "६-६०-६८", "content_sanskrit": "अथवा ध्रुवमन्येभ्यो भयं परमुपस्थितम्।\nयदर्थमेव त्वरितैर्भवद्भिः प्रतिबोधितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000467069, "chapter_id": 9467, "verse_number": "६-६०-६९", "content_sanskrit": "अद्य राक्षसराजस्य भयमुत्पाटयाम्यहम्।\nदारयिष्ये महेन्द्रं वा शीतयिष्ये तथानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 5000467070, "chapter_id": 9467, "verse_number": "६-६०-७०", "content_sanskrit": "न ह्यल्पकारणे सुप्तं बोधयिष्यति मादृशम्।\nतदाख्यातार्थतत्त्वेन मत्प्रबोधनकारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 5000467071, "chapter_id": 9467, "verse_number": "६-६०-७१", "content_sanskrit": "एवं ब्रुवाणं संरब्धं कुम्भकर्णमरिंदमम्।\nयूपाक्षः सचिवो राज्ञः कृताञ्जलिरभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 5000467072, "chapter_id": 9467, "verse_number": "६-६०-७२", "content_sanskrit": "न नो देवकृतं किंचिद् भयमस्ति कदाचन।\nमानुषान्नो भयं राजंस्तुमुलं सम्प्रबाधते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 5000467073, "chapter_id": 9467, "verse_number": "६-६०-७३", "content_sanskrit": "न दैत्यदानवेभ्यो वा भयमस्ति न नः क्वचित्।\nयादृशं मानुषं राजन् भयमस्मानुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 5000467074, "chapter_id": 9467, "verse_number": "६-६०-७४", "content_sanskrit": "वानरैः पर्वताकारैर्लङ्केयं परिवारिता।\nसीताहरणसंतप्ताद् रामान्नस्तुमुलं भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 5000467075, "chapter_id": 9467, "verse_number": "६-६०-७५", "content_sanskrit": "एकेन वानरेणेयं पूर्वं दग्धा महापुरी।\nकुमारो निहतश्चाक्षः सानुयात्रः सकुञ्जरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 5000467076, "chapter_id": 9467, "verse_number": "६-६०-७६", "content_sanskrit": "स्वयं रक्षोधिपश्चापि पौलस्त्यो देवकण्टकः।\nव्रजेति संयुगे मुक्तो रामेणादित्यवर्चसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 5000467077, "chapter_id": 9467, "verse_number": "६-६०-७७", "content_sanskrit": "यन्न देवैः कृतो राजा नापि दैत्यैर्न दानवैः।\nकृतः स इह रामेण विमुक्तः प्राणसंशयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 5000467078, "chapter_id": 9467, "verse_number": "६-६०-७८", "content_sanskrit": "स यूपाक्षवचः श्रुत्वा भ्रातुर्युधि पराभवम्।\nकुम्भकर्णो विवृत्ताक्षो यूपाक्षमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 5000467079, "chapter_id": 9467, "verse_number": "६-६०-७९", "content_sanskrit": "सर्वमद्यैव यूपाक्ष हरिसैन्यं सलक्ष्मणम्।\nराघवं च रणे जित्वा ततो द्रक्ष्यामि रावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 5000467080, "chapter_id": 9467, "verse_number": "६-६०-८०", "content_sanskrit": "राक्षसांस्तर्पयिष्यामि हरीणां मांसशोणितैः।\nरामलक्ष्मणयोश्चापि स्वयं पास्यामि शोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 5000467081, "chapter_id": 9467, "verse_number": "६-६०-८१", "content_sanskrit": "तत् तस्य वाक्यं ब्रुवतो निशम्य\nसगर्वितं रोषविवृद्धदोषम्।\nमहोदरो नैर्ऋतयोधमुख्यः\nकृताञ्जलिर्वाक्यमिदं बभाषे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 5000467082, "chapter_id": 9467, "verse_number": "६-६०-८२", "content_sanskrit": "रावणस्य वचः श्रुत्वा गुणदोषौ विमृश्य च।\nपश्चादपि महाबाहो शत्रून् युधि विजेष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 5000467083, "chapter_id": 9467, "verse_number": "६-६०-८३", "content_sanskrit": "महोदरवचः श्रुत्वा राक्षसैः परिवारितः।\nकुम्भकर्णो महातेजाः सम्प्रतस्थे महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 5000467084, "chapter_id": 9467, "verse_number": "६-६०-८४", "content_sanskrit": "सुप्तमुत्थाप्य भीमाक्षं भीमरूपपराक्रमम्।\nराक्षसास्त्वरिता जग्मुर्दशग्रीवनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 5000467085, "chapter_id": 9467, "verse_number": "६-६०-८५", "content_sanskrit": "तेऽभिगम्य दशग्रीवमासीनं परमासने।\nऊचुर्बद्धाञ्जलिपुटाः सर्व एव निशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 5000467086, "chapter_id": 9467, "verse_number": "६-६०-८६", "content_sanskrit": "कुम्भकर्णः प्रबुद्धोऽसौ भ्राता ते राक्षसेश्वर।\nकथं तत्रैव निर्यातु द्रक्ष्यसे तमिहागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 5000467087, "chapter_id": 9467, "verse_number": "६-६०-८७", "content_sanskrit": "रावणस्त्वब्रवीद‍्धृष्टो राक्षसांस्तानुपस्थितान्।\nद्रष्टुमेनमिहेच्छामि यथान्यायं च पूज्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 5000467088, "chapter_id": 9467, "verse_number": "६-६०-८८", "content_sanskrit": "तथेत्युक्त्वा तु ते सर्वे पुनरागम्य राक्षसाः।\nकुम्भकर्णमिदं वाक्यमूचू रावणचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 5000467089, "chapter_id": 9467, "verse_number": "६-६०-८९", "content_sanskrit": "द्रष्टुं त्वां काङ्क्षते राजा सर्वराक्षसपुङ्गवः।\nगमने क्रियतां बुद्धिर्भ्रातरं सम्प्रहर्षय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 5000467090, "chapter_id": 9467, "verse_number": "६-६०-९०", "content_sanskrit": "कुम्भकर्णस्तु दुर्धर्षो भ्रातुराज्ञाय शासनम्।\nतथेत्युक्त्वा महावीर्यः शयनादुत्पपात ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 5000467091, "chapter_id": 9467, "verse_number": "६-६०-९१", "content_sanskrit": "प्रक्षाल्य वदनं हृष्टः स्नातः परमहर्षितः।\nपिपासुस्त्वरयामास पानं बलसमीरणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 5000467092, "chapter_id": 9467, "verse_number": "६-६०-९२", "content_sanskrit": "ततस्ते त्वरितास्तत्र राक्षसा रावणाज्ञया।\nमद्यं भक्ष्यांश्च विविधान् क्षिप्रमेवोपहारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 5000467093, "chapter_id": 9467, "verse_number": "६-६०-९३", "content_sanskrit": "पीत्वा घटसहस्रे द्वे गमनायोपचक्रमे।\nईषत्समुत्कटो मत्तस्तेजोबलसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 5000467094, "chapter_id": 9467, "verse_number": "६-६०-९४", "content_sanskrit": "कुम्भकर्णो बभौ रुष्टः कालान्तकयमोपमः।\nभ्रातुः स भवनं गच्छन् रक्षोबलसमन्वितः।\nकुम्भकर्णः पदन्यासैरकम्पयत मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 5000467095, "chapter_id": 9467, "verse_number": "६-६०-९५", "content_sanskrit": "स राजमार्गं वपुषा प्रकाशयन्\nसहस्ररश्मिर्धरणीमिवांशुभिः।\nजगाम तत्राञ्जलिमालया वृतः\nशतक्रतुर्गेहमिव स्वयंभुवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 5000467096, "chapter_id": 9467, "verse_number": "६-६०-९६", "content_sanskrit": "तं राजमार्गस्थममित्रघातिनं\nवनौकसस्ते सहसा बहिःस्थिताः।\nदृष्ट्वाप्रमेयं गिरिशृङ्गकल्पं\nवितत्रसुस्ते सह यूथपालैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 5000467097, "chapter_id": 9467, "verse_number": "६-६०-९७", "content_sanskrit": "केचिच्छरण्यं शरणं स्म रामं\nव्रजन्ति केचिद् व्यथिताः पतन्ति।\nकेचिद् दशश्च व्यथिताः पतन्ति\nकेचिद् भयार्ता भुवि शेरते स्म ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 5000467098, "chapter_id": 9467, "verse_number": "६-६०-९८", "content_sanskrit": "तमद्रिशृङ्गप्रतिमं किरीटिनं\nस्पृशन्तमादित्यमिवात्मतेजसा।\nवनौकसः प्रेक्ष्य विवृद्धमद्भुतं\nभयार्दिता दुद्रुविरे यतस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 5000467099, "chapter_id": 9467, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे षष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]