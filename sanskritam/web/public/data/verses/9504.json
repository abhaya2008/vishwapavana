[{"id": 5000504000, "chapter_id": 9504, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे सप्तनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000504001, "chapter_id": 9504, "verse_number": "६-९७-१", "content_sanskrit": "हन्यमाने बले तूर्णमन्योन्यं ते महामृधे।\nसरसीव महाघर्मे सूपक्षीणे बभूवतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000504002, "chapter_id": 9504, "verse_number": "६-९७-२", "content_sanskrit": "स्वबलस्य तु घातेन विरूपाक्षवधेन च।\nबभूव द्विगुणं क्रुद्धो रावणो राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000504003, "chapter_id": 9504, "verse_number": "६-९७-३", "content_sanskrit": "प्रक्षीणं स्वबलं दृष्ट्वा वध्यमानं वलीमुखैः।\nबभूवास्य व्यथा युद्धे दृष्ट्वा दैवविपर्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000504004, "chapter_id": 9504, "verse_number": "६-९७-४", "content_sanskrit": "उवाच च समीपस्थं महोदरमनन्तरम्।\nअस्मिन् काले महाबाहो जयाशा त्वयि मे स्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000504005, "chapter_id": 9504, "verse_number": "६-९७-५", "content_sanskrit": "जहि शत्रुचमूं वीर दर्शयाद्य पराक्रमम्।\nभर्तृपिण्डस्य कालोऽयं निर्वेष्टुं साधु युध्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000504006, "chapter_id": 9504, "verse_number": "६-९७-६", "content_sanskrit": "एवमुक्तस्तथेत्युक्त्वा राक्षसेन्द्रो महोदरः।\nप्रविवेशारिसेनां स पतङ्ग इव पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000504007, "chapter_id": 9504, "verse_number": "६-९७-७", "content_sanskrit": "ततः स कदनं चक्रे वानराणां महाबलः।\nभर्तृवाक्येन तेजस्वी स्वेन वीर्येण चोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000504008, "chapter_id": 9504, "verse_number": "६-९७-८", "content_sanskrit": "वानराश्च महासत्त्वाः प्रगृह्य विपुलाः शिलाः।\nप्रविश्यारिबलं भीमं जघ्नुस्ते सर्वराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000504009, "chapter_id": 9504, "verse_number": "६-९७-९", "content_sanskrit": "महोदरः सुसंक्रुद्धः शरैः काञ्चनभूषणैः।\nचिच्छेद पाणिपादोरु वानराणां महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000504010, "chapter_id": 9504, "verse_number": "६-९७-१०", "content_sanskrit": "ततस्ते वानराः सर्वे राक्षसैरर्दिता भृशम्।\nदिशो दश द्रुताः केचित् केचित् सुग्रीवमाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000504011, "chapter_id": 9504, "verse_number": "६-९७-११", "content_sanskrit": "प्रभग्नं समरे दृष्ट्वा वानराणां महाबलम्।\nअभिदुद्राव सुग्रीवो महोदरमनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000504012, "chapter_id": 9504, "verse_number": "६-९७-१२", "content_sanskrit": "प्रगृह्य विपुलां घोरां महीधरसमां शिलाम्।\nचिक्षेप च महातेजास्तद्वधाय हरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000504013, "chapter_id": 9504, "verse_number": "६-९७-१३", "content_sanskrit": "तामापतन्तीं सहसा शिलां दृष्ट्वा महोदरः।\nअसम्भ्रान्तस्ततो बाणैर्निर्बिभेद दुरासदाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000504014, "chapter_id": 9504, "verse_number": "६-९७-१४", "content_sanskrit": "रक्षसा तेन बाणौघैर्निकृत्ता सा सहस्रधा।\nनिपपात तदा भूमौ गृध्रचक्रमिवाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000504015, "chapter_id": 9504, "verse_number": "६-९७-१५", "content_sanskrit": "तां तु भिन्नां शिलां दृष्ट्वा सुग्रीवः क्रोधमूर्च्छितः।\nसालमुत्पाट्य चिक्षेप तं स चिच्छेद नैकधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000504016, "chapter_id": 9504, "verse_number": "६-९७-१६", "content_sanskrit": "शरैश्च विददारैनं शूरः परबलार्दनः।\nस ददर्श ततः क्रुद्धः परिघं पतितं भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000504017, "chapter_id": 9504, "verse_number": "६-९७-१७", "content_sanskrit": "आविध्य तु स तं दीप्तं परिघं तस्य दर्शयन्।\nपरिघेणोग्रवेगेन जघानास्य हयोत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000504018, "chapter_id": 9504, "verse_number": "६-९७-१८", "content_sanskrit": "तस्माद्धतहयाद् वीरः सोऽवप्लुत्य महारथात्।\nगदां जग्राह संक्रुद्धो राक्षसोऽथ महोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000504019, "chapter_id": 9504, "verse_number": "६-९७-१९", "content_sanskrit": "गदापरिघहस्तौ तौ युधि वीरौ समीयतुः।\nनर्दन्तौ गोवृषप्रख्यौ घनाविव सविद्युतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000504020, "chapter_id": 9504, "verse_number": "६-९७-२०", "content_sanskrit": "ततः क्रुद्धो गदां तस्मै चिक्षेप रजनीचरः।\nज्वलन्तीं भास्कराभासां सुग्रीवाय महोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000504021, "chapter_id": 9504, "verse_number": "६-९७-२१", "content_sanskrit": "गदां तां सुमहाघोरामापतन्तीं महाबलः।\nसुग्रीवो रोषताम्राक्षः समुद्यम्य महाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000504022, "chapter_id": 9504, "verse_number": "६-९७-२२", "content_sanskrit": "आजघान गदां तस्य परिघेण हरीश्वरः।\nपपात तरसा भिन्नः परिघस्तस्य भूतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000504023, "chapter_id": 9504, "verse_number": "६-९७-२३", "content_sanskrit": "ततो जग्राह तेजस्वी सुग्रीवो वसुधातलात्।\nआयसं मुसलं घोरं सर्वतो हेमभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000504024, "chapter_id": 9504, "verse_number": "६-९७-२४", "content_sanskrit": "स तमुद्यम्य चिक्षेप सोऽप्यस्य प्राक्षिपद् गदाम्।\nभिन्नावन्योन्यमासाद्य पेततुस्तौ महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000504025, "chapter_id": 9504, "verse_number": "६-९७-२५", "content_sanskrit": "ततो भिन्नप्रहरणौ मुष्टिभ्यां तौ समीयतुः।\nतेजोबलसमाविष्टौ दीप्ताविव हुताशनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000504026, "chapter_id": 9504, "verse_number": "६-९७-२६", "content_sanskrit": "जघ्नतुस्तौ तदान्योन्यं नदन्तौ च पुनः पुनः।\nतलैश्चान्योन्यमासाद्य पेततुश्च महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000504027, "chapter_id": 9504, "verse_number": "६-९७-२७", "content_sanskrit": "उत्पेततुस्तदा तूर्णं जघ्नतुश्च परस्परम्।\nभुजैश्चिक्षिपतुर्वीरावन्योन्यमपराजितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000504028, "chapter_id": 9504, "verse_number": "६-९७-२८", "content_sanskrit": "जग्मतुस्तौ श्रमं वीरौ बाहुयुद्धे परंतपौ।\nआजहार तदा खड्गमदूरपरिवर्तिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000504029, "chapter_id": 9504, "verse_number": "६-९७-२९", "content_sanskrit": "राक्षसश्चर्मणा सार्धं महावेगो महोदरः।\nतथैव च महाखड्गं चर्मणा पतितं सह।\nजग्राह वानरश्रेष्ठः सुग्रीवो वेगवत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000504030, "chapter_id": 9504, "verse_number": "६-९७-३०", "content_sanskrit": "ततो रोषपरीताङ्गौ नदन्तावभ्यधावताम्।\nउद्यतासी रणे हृष्टौ युधि शस्त्रविशारदौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000504031, "chapter_id": 9504, "verse_number": "६-९७-३१", "content_sanskrit": "दक्षिणं मण्डलं चोभौ सुतूर्णं सम्परीयतुः।\nअन्योन्यमभिसंक्रुद्धौ जये प्रणिहितावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000504032, "chapter_id": 9504, "verse_number": "६-९७-३२", "content_sanskrit": "स तु शूरो महावेगो वीर्यश्लाघी महोदरः।\nमहावर्मणि तं खड्गं पातयामास दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000504033, "chapter_id": 9504, "verse_number": "६-९७-३३", "content_sanskrit": "लग्नमुत्कर्षतः खड्गं खड्गेन कपिकुञ्जरः।\nजहार सशिरस्त्राणं कुण्डलोपगतं शिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000504034, "chapter_id": 9504, "verse_number": "६-९७-३४", "content_sanskrit": "निकृत्तशिरसस्तस्य पतितस्य महीतले।\nतद् बलं राक्षसेन्द्रस्य दृष्ट्वा तत्र न दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000504035, "chapter_id": 9504, "verse_number": "६-९७-३५", "content_sanskrit": "हत्वा तं वानरैः सार्धं ननाद मुदितो हरिः।\nचुक्रोध च दशग्रीवो बभौ हृष्टश्च राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000504036, "chapter_id": 9504, "verse_number": "६-९७-३६", "content_sanskrit": "विषण्णवदनाः सर्वे राक्षसा दीनचेतसः।\nविद्रवन्ति ततः सर्वे भयवित्रस्तचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000504037, "chapter_id": 9504, "verse_number": "६-९७-३७", "content_sanskrit": "महोदरं तं विनिपात्य भूमौ\nमहागिरेः कीर्णमिवैकदेशम्।\nसूर्यात्मजस्तत्र रराज लक्ष्म्या\nसूर्यः स्वतेजोभिरिवाप्रधृष्यः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000504038, "chapter_id": 9504, "verse_number": "६-९७-३८", "content_sanskrit": "अथ विजयमवाप्य वानरेन्द्रः\nसमरमुखे सुरसिद्धयक्षसङ्घैः।\nअवनितलगतैश्च भूतसङ्घै-\nर्हरुषसमाकुलितैर्निरीक्ष्यमाणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000504039, "chapter_id": 9504, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे सप्तनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]