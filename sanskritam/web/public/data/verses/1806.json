[{"id": 2037379, "chapter_id": 1806, "verse_number": "५-५१-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037380, "chapter_id": 1806, "verse_number": "५-५१-१", "content_sanskrit": "सर्व एते महोत्साहा ये त्वया परिकीर्तिताः।\nएकतस्त्वेव ते सर्वे समेता भीम एकतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037381, "chapter_id": 1806, "verse_number": "५-५१-२", "content_sanskrit": "भीमसेनाद्धि मे भूयो भयं सञ्जायते महत्।\nक्रुद्धादमर्षणात्तात व्याघ्रादिव महारुरोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037382, "chapter_id": 1806, "verse_number": "५-५१-३", "content_sanskrit": "जागर्मि रात्रयः सर्वा दीर्घमुष्णं च निःश्वसन्।\nभीतो वृकोदरात्तात सिंहात्पशुरिवापरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037383, "chapter_id": 1806, "verse_number": "५-५१-४", "content_sanskrit": "न हि तस्य महाबाहोः शक्रप्रतिमतेजसः।\nसैन्येऽस्मिन्प्रतिपश्यामि य एनं विषहेद्युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037384, "chapter_id": 1806, "verse_number": "५-५१-५", "content_sanskrit": "अमर्षणश्च कौन्तेयो दृढवैरश्च पाण्डवः ।\nअनर्महासी सोन्मादस्तिर्यक्प्रेक्षी महास्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037385, "chapter_id": 1806, "verse_number": "५-५१-६", "content_sanskrit": "महावेगो महोत्साहो महाबाहुर्महाबलः।\nमन्दानां मम पुत्राणां युद्धेनान्तं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037386, "chapter_id": 1806, "verse_number": "५-५१-७", "content_sanskrit": "उरुग्राहगृहीतानां गदां बिभ्रद्वृकोदरः।\nकुरूणामृषभो युद्धे दण्डपाणिरिवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037387, "chapter_id": 1806, "verse_number": "५-५१-८", "content_sanskrit": "अष्टाश्रिमायसीं घोरां गदां काञ्चनभूषणाम् ।\nमनसाहं प्रपश्यामि ब्रह्मदण्डमिवोद्यतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037388, "chapter_id": 1806, "verse_number": "५-५१-९", "content_sanskrit": "यथा मृगाणां यूथेषु सिंहो जातबलश्चरेत्।\nमामकेषु तथा भीमो बलेषु विचरिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037389, "chapter_id": 1806, "verse_number": "५-५१-१०", "content_sanskrit": "सर्वेषां मम पुत्राणां स एकः क्रूरविक्रमः ।\nबह्वाशी विप्रतीपश्च बाल्येपि रभसः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037390, "chapter_id": 1806, "verse_number": "५-५१-११", "content_sanskrit": "उद्वेपते मे हृदयं ये मे दुर्योधनादयः।\nबाल्येऽपि तेन युद्ध्यन्तो वारणेनेव मर्दिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037391, "chapter_id": 1806, "verse_number": "५-५१-१२", "content_sanskrit": "तस्य वीर्येण संक्लिष्टा नित्यमेव सुता मम।\nस एव हेतुर्भेदस्य भीमो भीमपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037392, "chapter_id": 1806, "verse_number": "५-५१-१३", "content_sanskrit": "ग्रसमानमनीकानि नरवारणवाजिनाम्।\nपश्यामीवाग्रतो भीमं क्रोधमूर्छितमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037393, "chapter_id": 1806, "verse_number": "५-५१-१४", "content_sanskrit": "अस्त्रे द्रोणार्जुनसमं वायुवेगसमं जवे।\nमहेश्वरसमं क्रोधे को हन्याद्भीममाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037394, "chapter_id": 1806, "verse_number": "५-५१-१५", "content_sanskrit": "सञ्जयाचक्ष्व मे शूरं भीमसेनममर्षणम् । ५-५१-१५b.......... येऽहं यत्तेन रिपुघातिना ।\n..... सर्वे पुत्राः मम मनस्विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037395, "chapter_id": 1806, "verse_number": "५-५१-१६", "content_sanskrit": "येन भीमबला यक्षा राक्षसाश्च पुरा हताः।\nकथं तस्य रणे वेगं मानुषः प्रसहिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037396, "chapter_id": 1806, "verse_number": "५-५१-१७", "content_sanskrit": "न स जातु वशे तस्थौ मम बाल्येऽपि सञ्जय ।\nकिं पुनर्मम दुष्पुत्रैः क्लिष्टः संप्रति पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037397, "chapter_id": 1806, "verse_number": "५-५१-१८", "content_sanskrit": "निष्ठुरो रोषणोऽत्यर्थं भज्येतापि न संनमेत्।\nतिर्यक्प्रेक्षीं संहतभ्रूः कथं शाम्येद्वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037398, "chapter_id": 1806, "verse_number": "५-५१-१९", "content_sanskrit": "शूरस्तथाऽप्रतिबलो गौरस्ताल इवोन्नतः।\nप्रमाणतो भीमसेनः प्रादेशेनाधिकोऽर्जुनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037399, "chapter_id": 1806, "verse_number": "५-५१-२०", "content_sanskrit": "जवेन वाजिनोऽत्येति बलेनान्त्येति कुञ्जरान् ।\nअव्यक्तजल्पी मध्वक्षो मध्यमः पाण्डवो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037400, "chapter_id": 1806, "verse_number": "५-५१-२१", "content_sanskrit": "इति बाल्ये श्रुतः पूर्वं मया व्यासमुखात्पुरा।\nरूपतो वीर्यतश्चैव याथातथ्येन पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2037401, "chapter_id": 1806, "verse_number": "५-५१-२२", "content_sanskrit": "आयसेन स दण्डेन रथन्नागान्नरान्हयान्।\nहनिष्यति रणे क्रुद्धो रौद्रः क्रूरपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2037402, "chapter_id": 1806, "verse_number": "५-५१-२३", "content_sanskrit": "अमर्षी नित्यसंरब्धो भीमः प्रहरतां वरः।\nमया तात प्रतीपानि कुर्वन्पूर्वं विमानितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2037403, "chapter_id": 1806, "verse_number": "५-५१-२४", "content_sanskrit": "निष्कर्णामायसीं स्थूलां सुपार्श्वां काञ्चनीं गदाम् ।\nशतघ्नीं शतनिर्हादां कथं शक्ष्यन्ति मे सुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2037404, "chapter_id": 1806, "verse_number": "५-५१-२५", "content_sanskrit": "अपारमप्लवागाधं समुद्रं शरवेधनम् ।\nभीमसेनमयं दुर्गं तात मन्दास्तितीर्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2037405, "chapter_id": 1806, "verse_number": "५-५१-२६", "content_sanskrit": "क्रोशतो मे न श्रृण्वन्ति बालाः पण्डितमानिनः ।\nविषमं न हि मन्यन्ते प्रापतं मधुदर्शिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2037406, "chapter_id": 1806, "verse_number": "५-५१-२७", "content_sanskrit": "संयुगे ये गमिष्यन्ति नररूपेण मृत्युना।\nनियतं चोदिता धात्रा सिंहेनेव महामृगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2037407, "chapter_id": 1806, "verse_number": "५-५१-२८", "content_sanskrit": "शैक्यां तात चतुष्किष्कुं षडश्रिममितौजसम्।\nप्रहितां दुःखसंस्पर्शां कथं शक्ष्यन्ति मे सुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2037408, "chapter_id": 1806, "verse_number": "५-५१-२९", "content_sanskrit": "गदां भ्रामयतस्तस्य भिन्दतो हस्तिमस्तकान्।\nसृक्किणी लेलिहानस्य बाष्पमुत्सृजतो मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2037409, "chapter_id": 1806, "verse_number": "५-५१-३०", "content_sanskrit": "उद्दिश्य नागान्पततः कुर्वतो भैरवान्रवान्।\nप्रतीपं पततो मत्तान्कुञ्जरान्प्रति गर्जतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2037410, "chapter_id": 1806, "verse_number": "५-५१-३१", "content_sanskrit": "विगाह्य रथमार्गेषु वरानुद्दिश्य निघ्नतः ।\nअग्नेः प्रज्वलितस्येव अपि मुच्येत मे प्रजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2037411, "chapter_id": 1806, "verse_number": "५-५१-३२", "content_sanskrit": "वीथीं कुर्वन्महाबाहुर्द्रावयन्मम वाहिनीम् ।\nनृत्यन्निव गदापाणिर्युगान्तं दर्शयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2037412, "chapter_id": 1806, "verse_number": "५-५१-३३", "content_sanskrit": "प्रभिन्न इव मातङ्गः प्रभञ्जन्पुष्पितान्द्रुमान्।\nप्रवेक्ष्यति रणे सेनां पुत्राणां मे वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2037413, "chapter_id": 1806, "verse_number": "५-५१-३४", "content_sanskrit": "कुर्वन्रथान्विपुरुषान्विसारथिहयध्वजान् ।\nआरुजन्पुरुषव्याघ्रो रथिनः सादिनस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2037414, "chapter_id": 1806, "verse_number": "५-५१-३५", "content_sanskrit": "गङ्गावेग इवानूपांस्तीरजान्विविधान्द्रुमान्।\nप्रभङ्क्ष्यति रणे सेनां पुत्राणां मम सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2037415, "chapter_id": 1806, "verse_number": "५-५१-३६", "content_sanskrit": "वधं नूनं गमिष्यन्ति भीमसेनभयार्दिताः ।\nमम पुत्राश्च भृत्याश्च राजानश्चैव सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2037416, "chapter_id": 1806, "verse_number": "५-५१-३७", "content_sanskrit": "येन राजा महावीर्यः प्रविश्यान्तःपुरं पुरा।\nवासुदेवसहायेन जरासन्धो निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2037417, "chapter_id": 1806, "verse_number": "५-५१-३८", "content_sanskrit": "कृत्स्नेयं पृथिवी देवी जरासन्धेन धीमता।\nमागधेन्द्रेण बलिना वशे कृत्वा प्रतापिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2037418, "chapter_id": 1806, "verse_number": "५-५१-३९", "content_sanskrit": "भीष्मप्रतापात्कुरवो नयेनान्धकवृष्णयः ।\nयन्न तस्य वशे जग्मुः केवलं दैवमेव तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2037419, "chapter_id": 1806, "verse_number": "५-५१-४०", "content_sanskrit": "स गत्वा पाण्डुपुत्रेण तरसा बाहुशालिना।\nअनायुधेन वीरेण निहतः किं ततोऽधिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2037420, "chapter_id": 1806, "verse_number": "५-५१-४१", "content_sanskrit": "दीर्घकालसमासक्तं विशमाशीविषो यथा।\nस मोक्ष्यति रणे तेजः पुत्रेषु मम सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2037421, "chapter_id": 1806, "verse_number": "५-५१-४२", "content_sanskrit": "महेन्द्र इव वज्रेण दानवान्देवसत्तमः ।\nभीमसेनो गदापाणिः सूदयिष्यति मे सुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2037422, "chapter_id": 1806, "verse_number": "५-५१-४३", "content_sanskrit": "अविषह्यमनावार्यं तीव्रवेगपराक्रमम् ।\nपश्यामीवातिताम्राक्षमापतन्तं वृकोदरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2037423, "chapter_id": 1806, "verse_number": "५-५१-४४", "content_sanskrit": "अगदस्याप्यधनुषो विरथस्य विवर्मणः ।\nबाहुभ्यां युध्यमानस्य कस्तिष्ठेदग्रतः पुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2037424, "chapter_id": 1806, "verse_number": "५-५१-४५", "content_sanskrit": "भीष्मो द्रोणश्च विप्रोऽयं कृपः शारद्वतस्तथा।\nजान्त्येते यथैवहं वीर्यज्ञस्तस्य धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2037425, "chapter_id": 1806, "verse_number": "५-५१-४६", "content_sanskrit": "आर्यव्रतं तु जानन्तः सङ्गरान्तं विधित्सवः ।\nसेनामुखेषु स्थास्यन्ति मामकानां नरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2037426, "chapter_id": 1806, "verse_number": "५-५१-४७", "content_sanskrit": "बलीयः सर्वतो दिष्टं पुरुषस्य विशेषतः।\nपश्यन्नपि जयं तेषां न नियच्छामि यत्सुतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2037427, "chapter_id": 1806, "verse_number": "५-५१-४८", "content_sanskrit": "ते पुराणं महेष्वासा मार्गमैन्द्रं समास्थिताः।\nत्यक्ष्यन्ति तुमुले प्राणान्रक्षन्तः पार्थिवं यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2037428, "chapter_id": 1806, "verse_number": "५-५१-४९", "content_sanskrit": "यथैषां मामकास्तात तथैषां पाण्डवा अपि।\nपौत्रा भीष्मस्य शिष्याश्च द्रोणस्य च कृपस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2037429, "chapter_id": 1806, "verse_number": "५-५१-५०", "content_sanskrit": "ये त्वस्मदाश्रयं किञ्चिद्दत्तमिष्टं च सञ्जय।\nतस्यापचितिमार्यत्वात्कर्तारः स्थविरास्त्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2037430, "chapter_id": 1806, "verse_number": "५-५१-५१", "content_sanskrit": "आददानस्य शस्त्रं हि क्षत्रधर्मं परीप्सतः।\nनिधनं क्षत्रियस्याजौ वरमेवाद्दुरुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2037431, "chapter_id": 1806, "verse_number": "५-५१-५२", "content_sanskrit": "स वै शोचामि सर्वान्वै ये युयुत्सन्ति पाण्डवैः ।\nविक्रुष्टं विदुरोणादौ तदेतद्भयमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2037432, "chapter_id": 1806, "verse_number": "५-५१-५३", "content_sanskrit": "न तु मन्ये विघाताय ज्ञानं दुःखस्य सञ्जय ।\nभवत्यतिबलं ह्येतज्ज्ञानस्याप्युपघातकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2037433, "chapter_id": 1806, "verse_number": "५-५१-५४", "content_sanskrit": "ऋषयो ह्यपि निर्मुक्ताः पश्यन्तो लोकसङ्ग्रहान्।\nसुखैर्भवन्ति सुखिनस्तथा दुःखेन दुःखिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2037434, "chapter_id": 1806, "verse_number": "५-५१-५५", "content_sanskrit": "किं पुनर्मोहमासक्तस्तत्र तत्र सहस्रधा।\nपुत्रेषु राज्यदारेषु पौत्रेष्वपि च बन्धुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2037435, "chapter_id": 1806, "verse_number": "५-५१-५६", "content_sanskrit": "संशये तु महत्यस्मिन्किं नु मे क्षममुत्तरम्।\nविनाशं ह्येव पश्यामि कुरूणामनुचिन्ततयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2037436, "chapter_id": 1806, "verse_number": "५-५१-५७", "content_sanskrit": "द्यूतप्रमुखमाभाति कुरूणां व्यसनं महत्।\nमन्देनैश्वर्यकामेन लोभात्पापमिदं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2037437, "chapter_id": 1806, "verse_number": "५-५१-५८", "content_sanskrit": "मन्ये पर्यायधर्मोऽयं कालस्यात्यन्तगामिनः।\nचक्रे प्रधिरिवासक्तो नास्य शक्यं पलायितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2037438, "chapter_id": 1806, "verse_number": "५-५१-५९", "content_sanskrit": "किं नु कुर्यां कथं कुर्यां क्व नु गच्छामि सञ्जय ।\nएते नश्यन्ति कुरवो मन्दाः कालवशं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2037439, "chapter_id": 1806, "verse_number": "५-५१-६०", "content_sanskrit": "अवशोऽहं तदा तात पुत्राणां निहते शते।\nश्रोष्यामि निनदं स्त्रीणां कथं मां मरणं स्पृशेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2037440, "chapter_id": 1806, "verse_number": "५-५१-६१", "content_sanskrit": "यथा निदाघे ज्वलनः समद्धो\nदहेत्कक्षं वायुना चोद्यमानः ।\nगदाहस्तः पाण्डवो वै तथैव\nहन्ता मदीयान्सहितोऽर्जुनेन ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2037441, "chapter_id": 1806, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि एकपञ्चाशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]