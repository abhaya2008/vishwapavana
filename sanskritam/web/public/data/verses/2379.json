[{"id": 2065058, "chapter_id": 2379, "verse_number": "८-९९-०x", "content_sanskrit": "[धृष्टराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2065059, "chapter_id": 2379, "verse_number": "८-९९-१", "content_sanskrit": "तस्मिंस्तु कर्णार्जुनयोर्विमर्दे\nदग्धस्य रौद्रेऽहनि विद्रुतस्य।\nबभूव कुरुसृञ्जयानां\nबलस्य बाणोन्मथितस्य कीदृक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2065060, "chapter_id": 2379, "verse_number": "८-९९-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2065061, "chapter_id": 2379, "verse_number": "८-९९-२", "content_sanskrit": "शृणु राजन्नवहितो यथा वृत्तो महाक्षयः।\nघोरो मनुष्यदेहानामाजौ च गजवाजिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2065062, "chapter_id": 2379, "verse_number": "८-९९-३", "content_sanskrit": "यत्र कर्णे हते पार्थः सिंहनादमथाकरोत्।\nतदा तव सुतान्राजन्नाविवेश महद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2065063, "chapter_id": 2379, "verse_number": "८-९९-४", "content_sanskrit": "न सन्धातुमनीकानि न चैवाशु पराक्रमे।\nआसीद्वुद्विर्हते कर्णे तव योधस्य कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2065064, "chapter_id": 2379, "verse_number": "८-९९-५", "content_sanskrit": "वणिजो नावि भिन्नायामगाधे विप्लुवे यथा।\nअपारे पारमिच्छन्तो हते द्वीपे किरीटिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2065065, "chapter_id": 2379, "verse_number": "८-९९-६", "content_sanskrit": "सूतपुत्रे हते राजन्वित्रस्ताः शस्त्रविक्षताः।\nअनाथा नाथमिच्छन्तो मृगाः सिंहैरिवार्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2065066, "chapter_id": 2379, "verse_number": "८-९९-७", "content_sanskrit": "भग्नशृङ्गा वृषा यद्वद्भग्नदंष्ट्रा इवोरगाः।\nप्रत्यपायाम सायाह्ने निर्जिताः सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2065067, "chapter_id": 2379, "verse_number": "८-९९-८", "content_sanskrit": "हतप्रवीरा विध्वस्ता निकृत्ता निशितैः शरैः।\nसूतपुत्रे हते राजन्पुत्रास्ते दुद्रुवुर्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2065068, "chapter_id": 2379, "verse_number": "८-९९-९", "content_sanskrit": "विस्रस्तयन्त्रकवचाः कान्दिग्भूता विचेतसः।\nअन्योन्यमवमृद्गन्तो वीक्षमाणा भयार्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2065069, "chapter_id": 2379, "verse_number": "८-९९-१०", "content_sanskrit": "मामेव नूनं बीभत्सुर्मामेव च वृकोदरः।\nअभियातीति मन्वानाः पेतुर्मम्लुश्च सम्भ्रमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2065070, "chapter_id": 2379, "verse_number": "८-९९-११", "content_sanskrit": "हयानन्ये गजानन्ये रथानन्ये महारथाः।\nआरुह्य जवसम्पन्नाः पदातीन्प्रजहुर्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2065071, "chapter_id": 2379, "verse_number": "८-९९-१२", "content_sanskrit": "कुञ्जरैः स्यन्दनाः क्षुण्णाः सादिनश्च महारथैः।\nपदातिसङ्घाश्चाश्वौधैः पलायद्भिर्भयार्दितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2065072, "chapter_id": 2379, "verse_number": "८-९९-१३", "content_sanskrit": "व्यालतस्करसङ्कीर्णे सार्थहीना यथा वने।\nसूतपुत्रे हते राजंस्तव योधास्तथाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2065073, "chapter_id": 2379, "verse_number": "८-९९-१४", "content_sanskrit": "हतारोहा यथा नागाश्छिन्नहस्ता यथा नराः।\nसर्वे पार्थमयं लोकं सम्पश्यन्तो भयार्दिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2065074, "chapter_id": 2379, "verse_number": "८-९९-१५", "content_sanskrit": "सम्प्रेक्ष्य द्रवतः सर्वान्भीमसेनभयार्दितान्।\nदुर्योधनोऽथ स्वं सूतं हाहाकृत्वेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2065075, "chapter_id": 2379, "verse_number": "८-९९-१६", "content_sanskrit": "नातिक्रमेच्च मां पार्थो धनुष्पाणिमवस्थितम्।\nजघने सर्वसैन्यानां शनैरश्वान्प्रचोदय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2065076, "chapter_id": 2379, "verse_number": "८-९९-१७", "content_sanskrit": "युध्यमानं हि कौन्तेयं हनिष्यामि न संशयः।\nनोत्सहेन्मामतिक्रान्तुं वेलामिव महोदधिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2065077, "chapter_id": 2379, "verse_number": "८-९९-१८", "content_sanskrit": "अद्यार्जुनं सगोविन्दं मानिनं च वृकोदरम्।\nअन्याञ्शिष्टांस्तथा शत्रून्कर्णस्यानृण्यमाप्नुयाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2065078, "chapter_id": 2379, "verse_number": "८-९९-१९", "content_sanskrit": "तच्छ्रुत्वा कुरुराजस्य शूरार्यसदृशं वचः।\nसूतो हेमपरिच्छन्नाञ्शनैरश्वानचोदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2065079, "chapter_id": 2379, "verse_number": "८-९९-२०", "content_sanskrit": "रथाश्वनागहीनास्तु पादातास्तव मारिष।\nपञ्चविंशतिसाहस्रा युद्वायैव व्यवस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2065080, "chapter_id": 2379, "verse_number": "८-९९-२१", "content_sanskrit": "तान्भीमसेनः सङ्क्रुद्धो धृष्ट्यद्युम्नश्च पार्षतः।\nबलेन चतुरङ्गेण संवृत्याजघ्नतुः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2065081, "chapter_id": 2379, "verse_number": "८-९९-२२", "content_sanskrit": "प्रत्ययुध्यन्त समरे भीमसेनं सपार्षतम्।\nपार्थपार्षतयोश्चान्ये जगृहुस्तत्र नामनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2065082, "chapter_id": 2379, "verse_number": "८-९९-२३", "content_sanskrit": "अक्रुध्यत रणे भीमस्तैस्तदा पर्यवस्थितैः।\nसोऽवतीर्य रथात्तूर्णं गदापाणिरयुध्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2065083, "chapter_id": 2379, "verse_number": "८-९९-२४", "content_sanskrit": "न तान्रथस्थो भूमिष्ठान्धर्मापेक्षी वृकोदरः।\nयोधयामास कौन्तेयो भुजवीर्यव्यपाश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2065084, "chapter_id": 2379, "verse_number": "८-९९-२५", "content_sanskrit": "जातरूपपरिच्छन्नां प्रगृह्य महतीं गदाम्।\nअवधीत्तावकान्सर्वान्दण्डपाणिरिवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2065085, "chapter_id": 2379, "verse_number": "८-९९-२६", "content_sanskrit": "पदातिनोऽपि सन्त्यक्त्वा प्रियं जीवितमात्मनः।\nभीममभ्यद्रवन्सङ्ख्ये पतङ्गा ज्वलनं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2065086, "chapter_id": 2379, "verse_number": "८-९९-२७", "content_sanskrit": "आसाद्य भीमसेनं तु संरब्धा युद्धदुर्मदाः।\nविनेशुः सहसा दृष्ट्वा भूतग्रामा इवान्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2065087, "chapter_id": 2379, "verse_number": "८-९९-२८", "content_sanskrit": "श्येनवद्विचरन्भीमो गदाहस्तो महाबलः।\nपञ्चविंशतिसाहस्रांस्तावकानवपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2065088, "chapter_id": 2379, "verse_number": "८-९९-२९", "content_sanskrit": "हत्वा तत्पुरुषानीकं भीमः सत्यपराक्रमः।\nधृष्टद्युम्नं पुरस्कृत्य तस्थौ तत्र महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2065089, "chapter_id": 2379, "verse_number": "८-९९-३०", "content_sanskrit": "धनञ्जयो रथानीकमभ्यवर्तत वीर्यवान्।\nमाद्रीपुत्रौ तु शकुनिं सात्यकिश्च महारथः।\nजवेनाभ्यपतन्हृष्टा घ्नन्तो दौर्योधनं बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2065090, "chapter_id": 2379, "verse_number": "८-९९-३१", "content_sanskrit": "तस्याश्वसादीन्सुबहूंस्ते निहत्य शितैः शरैः।\nसमभ्यधावंस्त्वरितास्तत्र युद्धमभून्महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2065091, "chapter_id": 2379, "verse_number": "८-९९-३२", "content_sanskrit": "धनञ्जयोऽपि चाभ्येत्य रथानीकं तव प्रभो।\nविश्रुतं त्रिषु लोकेषु गाण्डीवं विक्षिपन्धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2065092, "chapter_id": 2379, "verse_number": "८-९९-३३", "content_sanskrit": "कृष्णसारथिमायान्तं दृष्ट्वा श्वेतहयं रथम्।\nअर्जुनं चापि योद्वारं त्वदीयाः प्राद्रवन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2065093, "chapter_id": 2379, "verse_number": "८-९९-३४", "content_sanskrit": "विप्रहीणरथाश्चैव शरैश्च परिकर्शिताः।\nपञ्चविंशतिसाहस्राः कालमार्छन्पदातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2065094, "chapter_id": 2379, "verse_number": "८-९९-३५", "content_sanskrit": "हत्वा तान्पुरुषव्याघ्रः पाञ्चालानां महारथः।\nपुत्राः पाञ्चालराजस्य धृष्टद्युम्नो महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2065095, "chapter_id": 2379, "verse_number": "८-९९-३६", "content_sanskrit": "भीमसेनं पुरस्कृत्य नचिरात्प्रत्यदृश्यत।\nमहाधनुर्धरः श्रीमानमित्रगणतापनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2065096, "chapter_id": 2379, "verse_number": "८-९९-३७", "content_sanskrit": "पारावतसवर्णाश्वं कोविदारमयध्वजम्।\nधृष्टद्युम्नं रणे दृष्ट्वा त्वदीयाः प्राद्रवन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2065097, "chapter_id": 2379, "verse_number": "८-९९-३८", "content_sanskrit": "गान्धारराजं शीघ्रास्त्रमनुसृत्य यशस्विनौ।\nनचिरात्प्रत्यदृश्येतां माद्रीपुत्रौ ससात्यकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2065098, "chapter_id": 2379, "verse_number": "८-९९-३९", "content_sanskrit": "वेकितानः शिखण्डी च द्रौपदेयाश्च मारिष।\nहत्वा त्वदीयं सुमहत्सैन्यं शङ्खांस्तथाऽधमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2065099, "chapter_id": 2379, "verse_number": "८-९९-४०", "content_sanskrit": "ते सर्वे तावकान्प्रेक्ष्य द्रवतोऽपि पराङ्मुखान्।\nअभ्यवर्तन्त संरब्धान्वृषाञ्जित्वा यथा वृषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2065100, "chapter_id": 2379, "verse_number": "८-९९-४१", "content_sanskrit": "सेनावशेषं तं दृष्ट्वा तव सैन्यस्य पाण्डवः।\nव्यवस्थितः सव्यसाची चुक्रोध बलवान्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2065101, "chapter_id": 2379, "verse_number": "८-९९-४२", "content_sanskrit": "धनञ्जयो रथानीकमभ्यवर्तत वीर्यवान्।\nविश्रुतं त्रिषु लोकेषु व्याक्षिपद्गाण्डिवं धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2065102, "chapter_id": 2379, "verse_number": "८-९९-४३", "content_sanskrit": "तत एनाञ्शरव्रातैः सहसा समवाकिरत्।\nतमसा संवृतेनाथ न स्म किञ्चिद्वदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2065103, "chapter_id": 2379, "verse_number": "८-९९-४४", "content_sanskrit": "अन्धकारीकृते लोके रजोभूते महीतले।\nयोधाः सर्वे महाराज तावकाः प्राद्रावन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2065104, "chapter_id": 2379, "verse_number": "८-९९-४५", "content_sanskrit": "सम्भज्यमाने सैन्ये तु कुरुराजो विशाम्पते।\nपरानभिमुखांश्चैव सुतस्ते समुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2065105, "chapter_id": 2379, "verse_number": "८-९९-४६", "content_sanskrit": "ततो दुर्योधनः सर्वानाजुहावाथ पाण्डवान्।\nयुद्धाय भरतश्रेष्ठ देवानिव पुरा बलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2065106, "chapter_id": 2379, "verse_number": "८-९९-४७", "content_sanskrit": "त एनमभिगर्जन्तः सहिताः समुपाद्रवन्।\nनानाशस्त्रभृतः क्रुद्धा भर्त्सयन्तो मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2065107, "chapter_id": 2379, "verse_number": "८-९९-४८", "content_sanskrit": "दुर्योधनोऽप्यसम्भ्रान्तस्तान्रणे निशितैः शरैः।\nतत्रावधीत्ततः क्रुद्वः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2065108, "chapter_id": 2379, "verse_number": "८-९९-४९", "content_sanskrit": "तत्सैन्यं पाण्डवेयानां योधयामास सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2065109, "chapter_id": 2379, "verse_number": "८-९९-५०", "content_sanskrit": "तत्राद्भुतमपश्याम तव पुत्रस्य पौरुषम्।\nयदेकः सहितान्सर्वान्रणेऽयुध्यत पाण्डवान्।\nततोऽपश्यन्महात्मा स स्वसैन्यं भृशदुःखितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2065110, "chapter_id": 2379, "verse_number": "८-९९-५१", "content_sanskrit": "ततोऽवस्थाप्य राजेन्द्र कृतबुद्धिस्तवात्मजः।\nहर्षयन्निव तान्योधानिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2065111, "chapter_id": 2379, "verse_number": "८-९९-५२", "content_sanskrit": "न तं देशं प्रपश्यामि यत्र याता भयार्दिताः।\nगतानां यत्र वै मोक्षः पाण्डवात्किं गतेन वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2065112, "chapter_id": 2379, "verse_number": "८-९९-५३", "content_sanskrit": "अल्पं च बलमेतेषां कृष्णौ च भृशविक्षतौ।\nअद्य सर्वान्हनिष्यामिध्रुवो हि विजयो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2065113, "chapter_id": 2379, "verse_number": "८-९९-५४", "content_sanskrit": "विप्रयातांस्तु वो भिन्नान्पाण्डवाः कृतकिल्विषान्।\nअनुसृत्य वधिष्यन्ति श्रेयान्नः समरे वधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2065114, "chapter_id": 2379, "verse_number": "८-९९-५५", "content_sanskrit": "सुखं साङ्ग्रामिको मृत्युः क्षत्रधर्मेण युध्यताम्।\nमृतो दुःखं न जानीते प्रेत्य चानन्त्यमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2065115, "chapter_id": 2379, "verse_number": "८-९९-५६", "content_sanskrit": "शृणुध्वं क्षत्रियाः सर्वे यावन्तः स्थ समागताः।\nयदा शूरं च भीरुं च मारयत्यन्तको मयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2065116, "chapter_id": 2379, "verse_number": "८-९९-५७", "content_sanskrit": "को न मूढो न युध्येत मादृशः क्षत्रियव्रतः।\nद्विषतो भीमसेनस्य क्रद्धस्य वशमेष्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2065117, "chapter_id": 2379, "verse_number": "८-९९-५८", "content_sanskrit": "पितामहैराचरितं न धर्मं हातुमर्हथ।\nन ह्यधर्मोऽस्ति पापीयान्क्षत्रियस्य पलायनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2065118, "chapter_id": 2379, "verse_number": "८-९९-५९", "content_sanskrit": "न युद्धधर्माच्छ्रेयो हि पन्थाः स्वर्गस्य कौरवाः।\nअचिरेण हता लोकान्सद्यो योधाः समश्नुत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2065119, "chapter_id": 2379, "verse_number": "८-९९-६०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2065120, "chapter_id": 2379, "verse_number": "८-९९-६०", "content_sanskrit": "एवं ब्रुवति पुत्रे ते सैनिका भृशविक्षताः।\nअनवेक्ष्यैव तद्वाक्यं प्राद्रवन्सर्वतो दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2065121, "chapter_id": 2379, "verse_number": "८-९९-६१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2065122, "chapter_id": 2379, "verse_number": "", "content_sanskrit": "दृष्ट्वा तु सैन्यं परिवृत्यमानं\nपुत्रेण ते मद्रपतिस्तदानीम्।\nसन्त्रस्तरूपः परिमूढचेता\nदुर्योधनं वाक्यमिदं बभाषे]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]