[{"id": 7006154000, "chapter_id": 26154, "verse_number": "१-२-१५-१", "content_sanskrit": "सूत उवाच ।\nअधःप्रमाणमूर्द्ध्व च वक्ष्यमाणं निबोधत ।\nपृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006154001, "chapter_id": 26154, "verse_number": "१-२-१५-२", "content_sanskrit": "अनंता धातवो ह्येतं व्यापकास्तु प्रकीर्त्तिताः ।\nजननी सर्वभूतानां सर्वसत्त्वधरा धरा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006154002, "chapter_id": 26154, "verse_number": "१-२-१५-३", "content_sanskrit": "नानाजनपदाकीर्णा नानाधिष्ठानपत्तना ।\nनानानदनदीशैला नैकजातिसमाकुला ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006154003, "chapter_id": 26154, "verse_number": "१-२-१५-४", "content_sanskrit": "अनंता गीयते देवी पृथिवी बहुविस्तरा ।\nनदीनदससुद्रस्थास्तंथा क्षुद्राश्रयस्थिताः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006154004, "chapter_id": 26154, "verse_number": "१-२-१५-५", "content_sanskrit": "पर्वताकाशसंस्थाश्च अंतर्भूमिगाताश्च याः ।\nआपोऽनंता हि विज्ञेयास्तथाग्निः सर्वलोकगः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006154005, "chapter_id": 26154, "verse_number": "१-२-१५-६", "content_sanskrit": "अनंतः पठ्यते चैव व्यापकः सर्वसंभवः ।\nतथाकाशमनालेख्यं रम्यं नानाश्रयं स्मृतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006154006, "chapter_id": 26154, "verse_number": "१-२-१५-७", "content_sanskrit": "अनन्तं पठ्यते चैव वायुश्चाकाशसम्भवः ।\nआपः पृथिव्यामुदके पृथिव्युपरि संस्थिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006154007, "chapter_id": 26154, "verse_number": "१-२-१५-८", "content_sanskrit": "आकाशश्चापरमथ पुनर्भूमिः पुनर्जलम् ।\nएवं मतमनंतस्य भौतिकस्य न विद्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006154008, "chapter_id": 26154, "verse_number": "१-२-१५-९", "content_sanskrit": "परस्परैः सोपचिता भूमिश्चैव निबोधत ।\nभूमिर्जलमथा काशमिति या या परंपरा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006154009, "chapter_id": 26154, "verse_number": "१-२-१५-१०", "content_sanskrit": "स्थितिरेषा तु विख्याता सप्तमेऽस्मिन्नसातले ।\nदशयोजनसाहस्रमेकं भौमं रसातलम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006154010, "chapter_id": 26154, "verse_number": "१-२-१५-११", "content_sanskrit": "साधुभिः परिसंख्यातमेकैकेनैव विस्तरम् ।\nप्रथमं तत्वलं नाम सुतलं तु ततः परम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006154011, "chapter_id": 26154, "verse_number": "१-२-१५-१२", "content_sanskrit": "ततस्तलातलं विद्यादतलं बहुविस्तरम् ।\nततोऽर्वाक्च तलं नाम परतश्च रसातलम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006154012, "chapter_id": 26154, "verse_number": "१-२-१५-१३", "content_sanskrit": "एतेषामप्यधोभागे पातालं सप्तमं स्मृतम् ।\nकृष्णभौमश्च प्रथमो भूमिभागः प्रकीर्त्तितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006154013, "chapter_id": 26154, "verse_number": "१-२-१५-१४", "content_sanskrit": "पांडुभूमिर्द्वितीयस्तु तृतीयो नीलमृत्तिकः ।\nपीतभौमश्चतुर्थस्तु पंचमः शर्करामयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006154014, "chapter_id": 26154, "verse_number": "१-२-१५-१५", "content_sanskrit": "षष्ठः शिलामयो ज्ञेयः सौवर्णः सप्तमः स्मृतः ।\nप्रथमेऽस्मिंस्तले ख्यातमसुरेंद्रस्य मंदिरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006154015, "chapter_id": 26154, "verse_number": "१-२-१५-१६", "content_sanskrit": "नमुचेरिंद्रशत्रोश्च महानादस्य चालयम् ।\nपुरं च शंकुकर्णस्य कबंधस्य च मंदिरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006154016, "chapter_id": 26154, "verse_number": "१-२-१५-१७", "content_sanskrit": "निष्कुलादस्य च पुरं प्रहृष्टजनसंकुलम् ।\nराक्षसस्य च भीमस्य शूलदंतस्य चालयम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006154017, "chapter_id": 26154, "verse_number": "१-२-१५-१८", "content_sanskrit": "लोहिताक्षकलिंगानां नगरं श्वापदस्य च ।\nधनंजयस्य च पुरं नागेंद्रस्य महात्मनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006154018, "chapter_id": 26154, "verse_number": "१-२-१५-१९", "content_sanskrit": "कालियस्य च नागस्य नगरं कौशिकस्य च ।\nएवं पुरसहस्राणि नागदानवरक्षसाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006154019, "chapter_id": 26154, "verse_number": "१-२-१५-२०", "content_sanskrit": "तले ज्ञेयानि प्रथमे कृष्णभौमे न संशयः ।\nद्वितीये सुतले विप्रा दैत्येंद्रस्य च रक्षसः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006154020, "chapter_id": 26154, "verse_number": "१-२-१५-२१", "content_sanskrit": "महाजंभस्य तु तथा नगरं प्रथमस्य तु ।\nइयग्रीवस्य कृष्णस्य निकुम्भस्य च मंदिरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006154021, "chapter_id": 26154, "verse_number": "१-२-१५-२२", "content_sanskrit": "शंखख्यस्य च दैत्यस्य नगरं गोमुखस्य च ।\nराक्षसस्य च नीलस्य मेघस्य कथनस्य च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006154022, "chapter_id": 26154, "verse_number": "१-२-१५-२३", "content_sanskrit": "आलयं कुकुपादस्य महोष्णीषस्य चालयम् ।\nकंबलस्य च नागस्य पुरमश्वतरस्य च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006154023, "chapter_id": 26154, "verse_number": "१-२-१५-२४", "content_sanskrit": "कद्रूपुत्रस्य च पुरं तक्षकस्य महात्मनः ।\nएवं पुरसहस्राणि नागदानवरक्षसाम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006154024, "chapter_id": 26154, "verse_number": "१-२-१५-२५", "content_sanskrit": "द्वितीयेऽस्मिन् तले विप्राः पांडुभौमे न संशयः ।\nतृतीये तु तले ख्यातं प्रह्लादस्य महात्मनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006154025, "chapter_id": 26154, "verse_number": "१-२-१५-२६", "content_sanskrit": "अनुद्रादस्य च पुरं पुरमग्निमुखस्य च ।\nतारकाश्यस्य च पुरं पुरं त्रिशिरसस्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006154026, "chapter_id": 26154, "verse_number": "१-२-१५-२७", "content_sanskrit": "शिशुमारस्य च पुरं त्रिपुरस्य तथा पुरम् ।\nपुरंजनस्य दैत्यस्य हृष्टपुष्टजनाकुलम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006154027, "chapter_id": 26154, "verse_number": "१-२-१५-२८", "content_sanskrit": "च्यवनस्य तु विज्ञेयं राक्षसस्य च मंदिरम् ।\nराक्षसेंद्रस्य च पुरं कुम्भिलस्य खरस्य च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006154028, "chapter_id": 26154, "verse_number": "१-२-१५-२९", "content_sanskrit": "विराधस्य च क्रूरस्य पुरमुल्कासुखस्य च ।\nहेमकस्य च नागस्य तथा पांडुरकस्य च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006154029, "chapter_id": 26154, "verse_number": "१-२-१५-३०", "content_sanskrit": "मणिनागस्य च पुरं कपिलस्य च मंदिरम् ।\nनेदकस्योरगपतोर्विशालाक्षस्य मंदिरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006154030, "chapter_id": 26154, "verse_number": "१-२-१५-३१", "content_sanskrit": "एवं पुरसहस्राणि नागदानवरक्षसाम् ।\nतृतीयेऽस्मिंस्तले विप्रा नीलभौमे न संशयः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006154031, "chapter_id": 26154, "verse_number": "१-२-१५-३२", "content_sanskrit": "चतुर्थे दैत्यसिंहस्य कालनेमेर्महात्मनः ।\nगजकर्णस्य च पुरं नगरं कुञ्जरस्य च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006154032, "chapter_id": 26154, "verse_number": "१-२-१५-३३", "content_sanskrit": "राक्षसेंद्रस्य च पुरं सुमालेर्बहुविस्तरम् ।\nमुंजस्य लोकनाथस्य वृकवक्त्रस्य चालयम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006154033, "chapter_id": 26154, "verse_number": "१-२-१५-३४", "content_sanskrit": "बहुयोजनविस्तीर्णं बहुपक्षिसमाकुलम् ।\nनगलं वैनतेयस्य चतुर्थेऽस्मिन्नसातले ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006154034, "chapter_id": 26154, "verse_number": "१-२-१५-३५", "content_sanskrit": "पञ्चमे शर्कराभौमे बहुयोजनविस्तरम् ।\nविरोजनस्य नगरं दैत्यसिंहस्य धीमतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006154035, "chapter_id": 26154, "verse_number": "१-२-१५-३६", "content_sanskrit": "वैद्युतस्याग्निजि ह्वस्य हिरण्याक्षस्य चालयम् ।\nपुरं च विद्युज्जिह्वस्य राक्षसेन्द्रस्य धीमतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006154036, "chapter_id": 26154, "verse_number": "१-२-१५-३७", "content_sanskrit": "सहामेघस्य च पुरं राक्षसेंद्रस्य मालिनः ।\nकिर्मीरस्य च नागस्य स्वस्तिकस्य जयस्य च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006154037, "chapter_id": 26154, "verse_number": "१-२-१५-३८", "content_sanskrit": "एवं पुरसहस्राणि नागदानवरक्षसाम् ।\nपञ्चमेऽस्मिंस्तले ज्ञेयं शर्करानिचये सदा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006154038, "chapter_id": 26154, "verse_number": "१-२-१५-३९", "content_sanskrit": "षष्ठे तले दैत्यपतेः केसरे नगरोत्तमम् ।\nसुपर्वणः पुलोम्नश्च नगरं महिषस्य च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006154039, "chapter_id": 26154, "verse_number": "१-२-१५-४०", "content_sanskrit": "राक्षसेंद्रस्य च पुरं सुरोषस्य महात्मनः ।\nतत्रास्ते सुरमापुत्रः शतशीर्षो मुदा युतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006154040, "chapter_id": 26154, "verse_number": "१-२-१५-४१", "content_sanskrit": "महेंद्रस्य सखा श्रीमान्वासुकिनाम नागराट् ।\nएवं पुरसहस्राणि नागदानवरक्षसाम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006154041, "chapter_id": 26154, "verse_number": "१-२-१५-४२", "content_sanskrit": "षष्ठे तलेऽस्मिन्विख्याते शिलाभौमे रसातले ।\nसप्तमे तु तले ज्ञेयं पाताले सर्वपश्चिमे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006154042, "chapter_id": 26154, "verse_number": "१-२-१५-४३", "content_sanskrit": "पुरं बलेः प्रमुदितं नरना रीगणाकुलम् ।\nअसुराशीविषैः पूर्णं सुखितैर्देवशत्रुभिः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006154043, "chapter_id": 26154, "verse_number": "१-२-१५-४४", "content_sanskrit": "मुचुकुन्दस्य देत्यस्य तत्रैव नगरं महात् ।\nअनेकैर्दितिपुत्राणां समुदीर्णैर्महापुरैः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006154044, "chapter_id": 26154, "verse_number": "१-२-१५-४५", "content_sanskrit": "तथैव नागनगरैर्द्युतिमद्भिः सहस्रशः ।\nदैत्यानां दानवानां च समुदीर्णैर्महापुरैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006154045, "chapter_id": 26154, "verse_number": "१-२-१५-४६", "content_sanskrit": "उदीर्णै राक्षसावासैरनेकैश्च समाकुलम् ।\nपातालांते च विप्रेंद्रा विस्तीण बहुयोजने ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006154046, "chapter_id": 26154, "verse_number": "१-२-१५-४७", "content_sanskrit": "आस्ते रक्तारविंदाक्षो महात्मा ह्यजरामरः ।\nधौतशंखोदरवपुर्नील वासा महाबलः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006154047, "chapter_id": 26154, "verse_number": "१-२-१५-४८", "content_sanskrit": "विशालभोगो द्युतिमांश्चित्रमाल्यधरो बली ।\nरुक्मश्रृङ्गावदातेन दीप्तास्येन विराजता ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006154048, "chapter_id": 26154, "verse_number": "१-२-१५-४९", "content_sanskrit": "प्रभुर्मुख सहस्रेण शोभते चैककुण्डली ।\nस जिह्वामालया दीप्तो लोलज्ज्वालानलार्चिषा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006154049, "chapter_id": 26154, "verse_number": "१-२-१५-५०", "content_sanskrit": "ज्वालामालापरिक्षिप्तः कैलास इव लक्ष्य ते ।\nस तु नेत्रसहस्रेण द्विगुणेन विराजता ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006154050, "chapter_id": 26154, "verse_number": "१-२-१५-५१", "content_sanskrit": "बालसूर्याभिताम्रेण शरीरस्निग्धपांडुना ।\nतस्य कुंदेंदुवर्णस्य नेत्रमाला विराजते ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006154051, "chapter_id": 26154, "verse_number": "१-२-१५-५२", "content_sanskrit": "तरुणादित्यमालेव श्वेतपर्वतमूर्द्धनि ।\nविकरालोच्छ्रिततनुर्लक्ष्यते शयनासने ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006154052, "chapter_id": 26154, "verse_number": "१-२-१५-५३", "content_sanskrit": "विस्तीर्ण इव मेदिन्यां सहस्रशिखरो गिरिः ।\nमहानागैर्महाभोगैर्महाविज्ञैर्महात्मभिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006154053, "chapter_id": 26154, "verse_number": "१-२-१५-५४", "content_sanskrit": "उपास्यते महातेजा महानागपतिः स्वयम् ।\nस राजा सर्वनागानां शेषोऽनंतो महाद्युतिः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006154054, "chapter_id": 26154, "verse_number": "१-२-१५-५५", "content_sanskrit": "सा वैष्णवी व्यवहृतिर्मर्यादा या व्यवस्थिता ।\nसप्तैवमेते कथिता व्यवहार्या रसातलाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006154055, "chapter_id": 26154, "verse_number": "१-२-१५-५६", "content_sanskrit": "देवासुरम हानागराक्षसाध्युषिताः सदा ।\nअतः परमनालोकमगम्यं सिद्धसाधुभिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006154056, "chapter_id": 26154, "verse_number": "१-२-१५-५७", "content_sanskrit": "देवानामप्यविदितं व्यवहारविवक्षया ।\nपृथ्व्यंबुव ङ्निवायूनां नभसश्च द्विजोत्तमाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006154057, "chapter_id": 26154, "verse_number": "१-२-१५-५८", "content_sanskrit": "महत्त्वमृषिभिश्चैवं वर्ण्यते नात्र संशयः ।\nअत ऊर्द्ध्वं प्रवक्ष्यामि सूर्याचंद्रमसोर्गतिम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]