[{"id": 2207432, "chapter_id": 5423, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207433, "chapter_id": 5423, "verse_number": "१", "content_sanskrit": "ततस्तस्योपसङ्गृह्य पादौ स द्विजसत्तमः ।\nप्रश्नांश्चैतान् स धर्मात्मा प्राह धर्मभृतां वरः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207434, "chapter_id": 5423, "verse_number": "", "content_sanskrit": "काश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207435, "chapter_id": 5423, "verse_number": "१", "content_sanskrit": "कथं शरीराच्च्यवते कथं चैवोपपद्यते ।\nकथं कष्टाच्च संसारात् संसारी परिमुच्यते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207436, "chapter_id": 5423, "verse_number": "३", "content_sanskrit": "आत्मानं वा कथं युक्तं तच्छरीरं विमुच्यते ।\nशरीरे तच्च निर्मुक्तो कथमन्यत् प्रपद्यते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207437, "chapter_id": 5423, "verse_number": "४", "content_sanskrit": "कथं शुभाशुभे चायं कर्मणी स्वकृते नरः ।\nउपभुङ्क्ते क्व वा कर्म विदेहस्योपतिष्ठति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207438, "chapter_id": 5423, "verse_number": "५", "content_sanskrit": "एवं सञ्चोदितः सिद्धः प्रश्नांस्तान् प्रत्यभाषत ।\nआनुपूर्व्येण वार्ष्णेय यथा तन्मे वचः शृणु\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207439, "chapter_id": 5423, "verse_number": "", "content_sanskrit": "सिद्धः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207440, "chapter_id": 5423, "verse_number": "६", "content_sanskrit": "अस्मिन्नेवाशु फलदा आयुष्यास्तु क्रियाः स्मृताः ।\nआयुःकृत्यकराणीह यानि कर्माणि सेवते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207441, "chapter_id": 5423, "verse_number": "७", "content_sanskrit": "शरीरग्रहणेऽन्यस्मिन् तेषु क्षीणेषु सर्वशः ।\nआयुःक्षयपरीतात्मा विपरीतानि सेवते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207442, "chapter_id": 5423, "verse_number": "८", "content_sanskrit": "बुद्धिर्व्यावर्तते चास्य विनाशे प्रत्युपस्थिते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207443, "chapter_id": 5423, "verse_number": "९", "content_sanskrit": "सत्त्वं बलं च कालं चाप्यविदित्वाऽऽत्मनस्तथा ।\nअतिवेलमुपाश्नाति तैर्विरुद्धान्यनात्मवान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207444, "chapter_id": 5423, "verse_number": "१०", "content_sanskrit": "यदाऽयमतिकष्टानि सर्वाण्युपनिषेवते ।\nअत्यर्थमपि वा भुङ्क्ते न वा भुङ्क्ते कदाचन\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207445, "chapter_id": 5423, "verse_number": "११", "content_sanskrit": "दुष्टान्नं विषमान्नं वा सात्वतेन विरोधि च ।\nगुरु वाऽपि समं भुङ्क्ते नातिजीर्णेऽपि वा पुनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207446, "chapter_id": 5423, "verse_number": "१२", "content_sanskrit": "व्यायाममतिमात्रं वा व्यवायं वोपसेवते ।\nसततं कर्मलोभाद्वा प्राप्तवेगविधारणम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207447, "chapter_id": 5423, "verse_number": "१३", "content_sanskrit": "रसानुयुक्तमन्नं वा दिवा स्वप्नं निषेवते ।\nअपक्वान्नं गते काले स्वयं दोषान् प्रकोपयेत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207448, "chapter_id": 5423, "verse_number": "१४", "content_sanskrit": "स्वदोषकोपनाद् रोगं लभते मरणान्तिकम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207449, "chapter_id": 5423, "verse_number": "१५", "content_sanskrit": "अथ चेद्बन्धनादीनि परीतानि व्यवस्यति ।\nतस्य तैः कारणैर्जन्तोः शरीराच्च्यवते यथा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207450, "chapter_id": 5423, "verse_number": "१६", "content_sanskrit": "जीवितं प्रोच्यमानं तद् यथावदुपधारय\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207451, "chapter_id": 5423, "verse_number": "१७", "content_sanskrit": "ऊष्मा प्रकुपितः काये तीव्रवायुसमीरितः ।\nशरीरमनुपर्येत्य सर्वान् प्राणान् रुणद्धि च\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207452, "chapter_id": 5423, "verse_number": "१८", "content_sanskrit": "अत्यर्थं बलवानूष्मा शरीरे परिकोपितः ।\nभिनत्ति जीवस्थानानि तानि मर्माणि विद्धि च\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207453, "chapter_id": 5423, "verse_number": "१९", "content_sanskrit": "ततः सवेदनः सद्यो जीवः प्रच्यवते क्षरन् ।\nशरीरं त्यजते जन्तुश्छिद्यमानेषु मर्मसु\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207454, "chapter_id": 5423, "verse_number": "२०", "content_sanskrit": "वेदनाभिः परीतात्मा तद्विद्धि द्विजसत्तम\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207455, "chapter_id": 5423, "verse_number": "२१", "content_sanskrit": "जनीमरणसंविग्नान् सततं सर्वजन्तवः ।\nदृश्यन्ते सन्त्यजन्तश्च शरीराणि द्विजर्षभ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207456, "chapter_id": 5423, "verse_number": "२२", "content_sanskrit": "गर्भसङ्क्रमणे चापि गर्भाणामपसर्पणे ।\nतादृशीमेव लभते वेदनां मानवः पुनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207457, "chapter_id": 5423, "verse_number": "२३", "content_sanskrit": "भिन्नसन्धिरथ क्लेदमद्भिः स लभते नरः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207458, "chapter_id": 5423, "verse_number": "२४", "content_sanskrit": "अथ पञ्चसु भूतेषु संश्रितत्वं निगच्छति ।\nश्लेष्मा प्रकुपितः काये तीव्रवायुसमीरितः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207459, "chapter_id": 5423, "verse_number": "२५", "content_sanskrit": "यस्य पञ्चसु भूतेषु प्राणापानौ व्यवस्थितौ ।\nस गच्छत्यूर्ध्वगो वायुः कृच्छ्रान्मुक्त्वा शरीरिणम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207460, "chapter_id": 5423, "verse_number": "२६", "content_sanskrit": "शरीरं च जहात्येव निरुच्छ्वासश्च दृश्यते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207461, "chapter_id": 5423, "verse_number": "२७", "content_sanskrit": "स निरूष्मा निरुच्छ्वासो निःश्रीको गतचेतनः ।\nब्रह्मणा सम्परित्यक्तो मृत इत्युच्यते नरः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207462, "chapter_id": 5423, "verse_number": "२८", "content_sanskrit": "स्रोतोभिर्यैर्विजानाति त्विन्द्रियार्थान् शरीरभृत् ।\nतैरेव नाभिजानाति प्राणमाहारसम्भवम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207463, "chapter_id": 5423, "verse_number": "२९", "content_sanskrit": "तत्रैव कुरुते काये यः स जीवन् सनातनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207464, "chapter_id": 5423, "verse_number": "३०", "content_sanskrit": "तेषां यद्यद् भवेद्युक्तं सन्निपाते क्वचित् क्वचित् ।\nतत्तन्मर्म विजानीहि शास्त्रदृष्टं हि तत् तथा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207465, "chapter_id": 5423, "verse_number": "३१", "content_sanskrit": "तेषु मर्मसु भिन्नेषु ततः स समुदीरयन् ।\nआविश्य हृदयं जन्तोः सत्त्वं चाशु रुणद्धि वै\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207466, "chapter_id": 5423, "verse_number": "३२", "content_sanskrit": "ततः सचेतनो धातुं नाभिजानाति किञ्चन\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2207467, "chapter_id": 5423, "verse_number": "३३", "content_sanskrit": "तमसा संवृतज्ञानं संवृतेष्वथ मर्मसु ।\nस जीवो निरधिष्ठानश्चाल्यते मातरिश्वना\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2207468, "chapter_id": 5423, "verse_number": "३४", "content_sanskrit": "ततः स तं महोच्छ्वासं भृशमुच्छ्वस्य दारुणम् ।\nनिष्क्रामन् कम्पयत्याशु तच्छरीरमचेतनम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2207469, "chapter_id": 5423, "verse_number": "३५", "content_sanskrit": "स जीवः प्रच्युतः कायात् कर्मभिः स्वैः समावृतः ।\nअङ्कितः स्वैः शुभैः पुण्यैः पापैर्वाऽप्युपपद्यते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2207470, "chapter_id": 5423, "verse_number": "३६", "content_sanskrit": "ब्राह्मणा ज्ञानसम्पन्ना यथावच्छ्रुतनिश्चयाः ।\nइतरं कृतपुण्यं वा तं विजानन्ति लक्षणैः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2207471, "chapter_id": 5423, "verse_number": "३७", "content_sanskrit": "यथाऽन्धकारे खद्योतं दीप्यमानं ततस्ततः ।\nचक्षुष्मन्तः प्रपश्यन्ति तथा तं ज्ञानचक्षुषः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2207472, "chapter_id": 5423, "verse_number": "३८", "content_sanskrit": "पश्यन्त्येवंविधाः सिद्धा जीवं दिव्येन चक्षुषा ।\nक्षरन्तं जायमानं च योनिं चानुप्रवेशितम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2207473, "chapter_id": 5423, "verse_number": "३९", "content_sanskrit": "तस्य स्थानानि दृष्टानि विविधानीह शास्त्रतः ।\nकर्मभूमिरियं भूमिः यत्र तिष्ठन्ति जन्तवः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2207474, "chapter_id": 5423, "verse_number": "४०", "content_sanskrit": "इतः शुभाशुभं कृत्वा लभन्ते कर्म देहिनः ।\nइहैवोच्चावचान् भोगान् प्राप्नुवन्ति स्वकर्मभिः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2207475, "chapter_id": 5423, "verse_number": "४१", "content_sanskrit": "इहैवाशुभकर्मा तु कर्मभिर्निरयं गतः ।\nअवाक् स निरये पापो मानवः पात्यते भृशम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2207476, "chapter_id": 5423, "verse_number": "४२", "content_sanskrit": "तस्मात् सुदुर्लभो मोक्ष आत्मा रक्ष्यो भृशं ततः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2207477, "chapter_id": 5423, "verse_number": "४३", "content_sanskrit": "ऊर्ध्वं तु जन्तवो गत्वा येषु स्थानेष्ववस्थिताः ।\nकीर्त्यमानानि तानीह तत्त्वतः सन्निबोध मे\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2207478, "chapter_id": 5423, "verse_number": "४४", "content_sanskrit": "तच्छ्रुत्वा नैष्ठिकीं बुद्धिं बुद्ध्येथाः कर्मनिश्चयात्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2207479, "chapter_id": 5423, "verse_number": "४५", "content_sanskrit": "तारारूपाणि सर्वाणि यत्रैतच्चन्द्रमण्डलम् ।\nयच्च विभ्राजते लोके स्वभासा सूर्यमण्डलम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2207480, "chapter_id": 5423, "verse_number": "४६", "content_sanskrit": "स्थानान्येतानि जानीहि नराणां पुण्यकर्मणाम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2207481, "chapter_id": 5423, "verse_number": "४७", "content_sanskrit": "कर्मक्षयाच्च तेभ्यो हि च्यवन्ते वै पुनः पुनः ।\nतत्रापि च विशेषोऽस्ति दिवि नीचोच्चमध्यमः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2207482, "chapter_id": 5423, "verse_number": "४८", "content_sanskrit": "न तत्राप्यस्ति सन्तोषो दृष्ट्वा दीप्तां परश्रियम् ।\nइत्येता गतयः सर्वा पृथक् ते समुदीरिताः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2207483, "chapter_id": 5423, "verse_number": "४९", "content_sanskrit": "उपपत्तिं तु गर्भस्य वक्ष्याम्यहमतःपरम् ।\nयथावत् तां निगदतः शृणुष्वावहितो द्विज\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2207484, "chapter_id": 5423, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि\nगतिप्रकारकथनं नाम सप्तदशोऽध्यायः ॥१७॥\nअनुगीतापर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]