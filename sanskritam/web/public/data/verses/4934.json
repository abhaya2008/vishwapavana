[{"id": 2185432, "chapter_id": 4934, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2185433, "chapter_id": 4934, "verse_number": "१", "content_sanskrit": "बलिनः प्रत्यमित्रस्य नित्यमासन्नवर्तिनः ।\nउपकारापकाराभ्यां समर्थस्योद्यतस्य च\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2185434, "chapter_id": 4934, "verse_number": "२", "content_sanskrit": "मोहाद् विकत्थनामात्रैरसारोऽल्पबलो लघुः ।\nवाग्भिरप्रतिरूपाभिरभिद्रुह्य पितामह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2185435, "chapter_id": 4934, "verse_number": "३", "content_sanskrit": "आत्मनो बलमास्थाय कथं वर्तेत मानवः ।\nआगच्छतोऽतिक्रुद्धस्य तस्योद्धरणकाम्यया\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2185436, "chapter_id": 4934, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2185437, "chapter_id": 4934, "verse_number": "४", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nसंवादं भरतश्रेष्ठ शल्मलेः पवनस्य च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2185438, "chapter_id": 4934, "verse_number": "५", "content_sanskrit": "हिमवन्तं समासाद्य महानासीद् वनस्पतिः ।\nवर्षपूगाभिसंवृद्धः शाखास्कन्धपलाशवान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2185439, "chapter_id": 4934, "verse_number": "६", "content_sanskrit": "तत्र स्म मत्ता मातङ्गा घर्मार्ताः श्रमकर्शिताः ।\nविश्रमन्ति महाबाहो तथान्या मृगजातयः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2185440, "chapter_id": 4934, "verse_number": "७", "content_sanskrit": "नल्वमात्रपरीणाहो घनच्छायो वनस्पतिः ।\nशुकशारिकसङ्घुष्टः फलवान् पुष्पवानपि\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2185441, "chapter_id": 4934, "verse_number": "८", "content_sanskrit": "सार्थिका वणिजश्चापि तापसाश्च वनौकसः ।\nवसन्ति वासान् मार्गस्थाः सुरम्ये तरुसत्तमे\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2185442, "chapter_id": 4934, "verse_number": "९", "content_sanskrit": "तस्य ता विपुलाः शाखा दृष्ट्वा स्कन्धांश्च सर्वतः ।\nअभिगम्याब्रवीदेनं नारदो भरतर्षभ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2185443, "chapter_id": 4934, "verse_number": "१०", "content_sanskrit": "अहो नु रमणीयस्त्वमहो चासि मनोरमः ।\nप्रीयामहे त्वया नित्यं तरुप्रवर शल्मले\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2185444, "chapter_id": 4934, "verse_number": "११", "content_sanskrit": "सदैव शकुनास्तात मृगाश्चाधस्तथा गजाः ।\nवसन्ति तव संहृष्टा मनोहरतरास्तथा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2185445, "chapter_id": 4934, "verse_number": "१२", "content_sanskrit": "तव शाखा महाशाख स्कन्धं च विपुलं तथा ।\nन वै प्रभग्नान् पश्यामि मारुतेन कथञ्चन\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2185446, "chapter_id": 4934, "verse_number": "१३", "content_sanskrit": "किं नु ते मारुतस्तात प्रीतिमानथ वा सुहृत् ।\nत्वां रक्षति सदा येन वनेऽस्मिन् पवनो ध्रुवम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2185447, "chapter_id": 4934, "verse_number": "१४", "content_sanskrit": "विवान् हि पवनः स्थानाद्वृक्षानुच्चावचानपि ।\nपर्वतानां च शिखराण्याचालयति वेगवान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2185448, "chapter_id": 4934, "verse_number": "१५", "content_sanskrit": "शोषयत्येव पातालं विवान् गन्धवहः शुचिः ।\nह्रदांश्च सरितश्चैव सागरांश्च तथैव ह\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2185449, "chapter_id": 4934, "verse_number": "१६", "content_sanskrit": "त्वां संरक्षेत पवनः सखित्वेन न संशयः ।\nतस्माद् बहलशाखोऽसि पर्णवान् पुष्पवानपि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2185450, "chapter_id": 4934, "verse_number": "१७", "content_sanskrit": "इदं च रमणीयं ते प्रतिभाति वनस्पते ।\nयदिमे विहगास्तात रमन्ते मुदितास्त्वयि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2185451, "chapter_id": 4934, "verse_number": "१८", "content_sanskrit": "एषां पृथक्समस्तानां श्रूयते मधुरः स्वरः ।\nपुष्पसम्मोदने काले वाशतां सुमनोहरम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2185452, "chapter_id": 4934, "verse_number": "१९", "content_sanskrit": "तथेमे मुदिता नागाः स्वयूथकुलशोभिनः ।\nघर्मार्तास्त्वां समासाद्य सुखं विन्दन्ति शल्मले\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2185453, "chapter_id": 4934, "verse_number": "२०", "content_sanskrit": "तथैव मृगजातीभिरन्याभिरुपशोभसे ।\nतथा सार्थाधिवासैश्च शोभसे मेरुवद्द्रुम\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2185454, "chapter_id": 4934, "verse_number": "२१", "content_sanskrit": "ब्राह्मणैश्च तपःसिद्धैस्तापसैः श्रमणैरपि ।\nत्रिविष्टपसमं मन्ये तवायतनमेव ह\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2185455, "chapter_id": 4934, "verse_number": "२२", "content_sanskrit": "बन्धुत्वादथ वा सख्याच्छल्मले नात्र संशयः ।\nपालयत्येव सततं भीमः सर्वत्रगोऽनिलः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2185456, "chapter_id": 4934, "verse_number": "२३", "content_sanskrit": "न्यग्भावं परमं वायोः शल्मले त्वमुपागतः ।\nतवाहमस्मीति सदा येन रक्षति मारुतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2185457, "chapter_id": 4934, "verse_number": "२४", "content_sanskrit": "न तं पश्याम्यहं वृक्षं पर्वतं वापि तं दृढम् ।\nयो न वायुबलाद्भग्नः पृथिव्यामिति मे मतिः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2185458, "chapter_id": 4934, "verse_number": "२५", "content_sanskrit": "त्वं पुनः कारणैर्नूनं शल्मले रक्ष्यसे सदा ।\nवायुना सपरीवारस्तेन तिष्ठस्यसंशयम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2185459, "chapter_id": 4934, "verse_number": "", "content_sanskrit": "शल्मलिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2185460, "chapter_id": 4934, "verse_number": "२६", "content_sanskrit": "न मे वायुः सखा ब्रह्मन्न बन्धुर्न च मे सुहृत् ।\nपरमेष्ठी तथा नैव येन रक्षति मानिलः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2185461, "chapter_id": 4934, "verse_number": "२७", "content_sanskrit": "मम तेजोबलं वायोर्भीममपि हि नारद ।\nकलामष्टादशीं प्राणैर्न मे प्राप्नोति मारुतः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2185462, "chapter_id": 4934, "verse_number": "२८", "content_sanskrit": "आगच्छन् परमो वायुर्मया विष्टम्भितो बलात् ।\nरुजन् द्रुमान् पर्वतांश्च यच्चान्यदपि किञ्चन\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2185463, "chapter_id": 4934, "verse_number": "२९", "content_sanskrit": "स मया बहुशो भग्नः प्रभञ्जन् वै प्रभञ्जनः ।\nतस्मान्न बिभ्ये देवर्षे क्रुद्धादपि समीरणात्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2185464, "chapter_id": 4934, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2185465, "chapter_id": 4934, "verse_number": "३०", "content_sanskrit": "शल्मले विपरीतं ते दर्शनं नात्र संशयः ।\nन हि वायोर्बलेनास्ति भूतं तुल्यबलं क्वचित्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2185466, "chapter_id": 4934, "verse_number": "३१", "content_sanskrit": "इन्द्रो यमो वैश्रवणो वरुणश्च जलेश्वरः ।\nन तेऽपि तुल्या मरुतः किं पुनस्त्वं वनस्पते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2185467, "chapter_id": 4934, "verse_number": "३२", "content_sanskrit": "यद्धि किञ्चिदिह प्राणि शल्मले चेष्टते भुवि ।\nसर्वत्र भगवान् वायुश्चेष्टाप्राणकरः प्रभुः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2185468, "chapter_id": 4934, "verse_number": "३३", "content_sanskrit": "एष चेष्टयते सम्यक्प्राणिनः सम्यगायतः ।\nअसम्यगायतो भूयश्चेष्टते विकृतो नृषु\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2185469, "chapter_id": 4934, "verse_number": "३४", "content_sanskrit": "स त्वमेवंविधं वायुं सर्वसत्त्वभृतां वरम् ।\nन पूजयसि पूज्यं तं किमन्यद् बुद्धिलाघवात्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2185470, "chapter_id": 4934, "verse_number": "३५", "content_sanskrit": "असारश्चासि दुर्बुद्धे केवलं बहु भाषसे ।\nक्रोधादिभिरवच्छन्नो मिथ्या वदसि शल्मले\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2185471, "chapter_id": 4934, "verse_number": "३६", "content_sanskrit": "मम रोषः समुत्पन्नस्त्वय्येवं सम्प्रभाषति ।\nब्रवीम्येष स्वयं वायोस्तव दुर्भाषितं बहु\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2185472, "chapter_id": 4934, "verse_number": "३७", "content_sanskrit": "चन्दनैः स्पन्दनैः शालैः सरलैर्देवदारुभिः ।\nवेतसैर्बन्धनैश्चापि ये चान्ये बलवत्तराः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2185473, "chapter_id": 4934, "verse_number": "३८", "content_sanskrit": "तैश्चापि नैवं दुर्बुद्धे क्षिप्तो वायुर्दुरात्मभिः ।\nते हि जानन्ति वायोश्च बलमात्मन एव च\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2185474, "chapter_id": 4934, "verse_number": "३९", "content_sanskrit": "तस्मात् ते वै नमस्यन्ति श्वसनं द्रुमसत्तमाः ।\nत्वं तु मोहान्न जानीषे वायोर्बलमनन्तकम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2185475, "chapter_id": 4934, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे द्वाविंशोऽध्यायः ॥ २२ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]