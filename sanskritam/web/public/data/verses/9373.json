[{"id": 5000373000, "chapter_id": 9373, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे चतुस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000373001, "chapter_id": 9373, "verse_number": "५-३४-१", "content_sanskrit": "तस्यास्तद् वचनं श्रुत्वा हनूमान् हरिपुंगवः।\nदुःखाद् दुःखाभिभूतायाः सान्त्वमुत्तरमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000373002, "chapter_id": 9373, "verse_number": "५-३४-२", "content_sanskrit": "अहं रामस्य संदेशाद् देवि दूतस्तवागतः।\nवैदेहि कुशली रामः स त्वां कौशलमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000373003, "chapter_id": 9373, "verse_number": "५-३४-३", "content_sanskrit": "यो ब्राह्ममस्त्रं वेदांश्च वेद वेदविदां वरः।\nस त्वां दाशरथी रामो देवि कौशलमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000373004, "chapter_id": 9373, "verse_number": "५-३४-४", "content_sanskrit": "लक्ष्मणश्च महातेजा भर्तुस्तेऽनुचरः प्रियः।\nकृतवाञ्छोकसंतप्तः शिरसा तेऽभिवादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000373005, "chapter_id": 9373, "verse_number": "५-३४-५", "content_sanskrit": "सा तयोः कुशलं देवी निशम्य नरसिंहयोः।\nप्रतिसंहृष्टसर्वांगी हनूमन्तमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000373006, "chapter_id": 9373, "verse_number": "५-३४-६", "content_sanskrit": "कल्याणी बत गाथेयं लौकिकी प्रतिभाति मा।\nएति जीवन्तमानन्दो नरं वर्षशतादपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000373007, "chapter_id": 9373, "verse_number": "५-३४-७", "content_sanskrit": "तयोः समागमे तस्मिन् प्रीतिरुत्पादिताद्भुता।\nपरस्परेण चालापं विश्वस्तौ तौ प्रचक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000373008, "chapter_id": 9373, "verse_number": "५-३४-८", "content_sanskrit": "तस्यास्तद् वचनं श्रुत्वा हनूमान् मारुतात्मजः।\nसीतायाः शोकतप्तायाः समीपमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000373009, "chapter_id": 9373, "verse_number": "५-३४-९", "content_sanskrit": "यथा यथा समीपं स हनूमानुपसर्पति।\nतथा तथा रावणं सा तं सीता परिशङ्कते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000373010, "chapter_id": 9373, "verse_number": "५-३४-१०", "content_sanskrit": "अहो धिग् धिक्कृतमिदं कथितं हि यदस्य मे।\nरूपान्तरमुपागम्य स एवायं हि रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000373011, "chapter_id": 9373, "verse_number": "५-३४-११", "content_sanskrit": "तामशोकस्य शाखां तु विमुक्त्वा शोककर्शिता।\nतस्यामेवानवद्याङ्गी धरण्यां समुपाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000373012, "chapter_id": 9373, "verse_number": "५-३४-१२", "content_sanskrit": "अवन्दत महाबाहुस्ततस्तां जनकात्मजाम्।\nसा चैनं भयसंत्रस्ता भूयो नैनमुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000373013, "chapter_id": 9373, "verse_number": "५-३४-१३", "content_sanskrit": "तं दृष्ट्वा वन्दमानं च सीता शशिनिभानना।\nअब्रवीद् दीर्घमुच्छ्वस्य वानरं मधुरस्वरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000373014, "chapter_id": 9373, "verse_number": "५-३४-१४", "content_sanskrit": "मायां प्रविष्टो मायावी यदि त्वं रावणः स्वयम्।\nउत्पादयसि मे भूयः संतापं तन्न शोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000373015, "chapter_id": 9373, "verse_number": "५-३४-१५", "content_sanskrit": "स्वं परित्यज्य रूपं यः परिव्राजकरूपवान्।\nजनस्थाने मया दृष्टस्त्वं स एव हि रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000373016, "chapter_id": 9373, "verse_number": "५-३४-१६", "content_sanskrit": "उपवासकृशां दीनां कामरूप निशाचर।\nसंतापयसि मां भूयः संतापं तन्न शोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000373017, "chapter_id": 9373, "verse_number": "५-३४-१७", "content_sanskrit": "अथवा नैतदेवं हि यन्मया परिशङ्कितम्।\nमनसो हि मम प्रीतिरुत्पन्ना तव दर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000373018, "chapter_id": 9373, "verse_number": "५-३४-१८", "content_sanskrit": "यदि रामस्य दूतस्त्वमागतो भद्रमस्तु ते।\nपृच्छामि त्वां हरिश्रेष्ठ प्रिया रामकथा हि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000373019, "chapter_id": 9373, "verse_number": "५-३४-१९", "content_sanskrit": "गुणान् रामस्य कथय प्रियस्य मम वानर।\nचित्तं हरसि मे सौम्य नदीकूलं यथा रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000373020, "chapter_id": 9373, "verse_number": "५-३४-२०", "content_sanskrit": "अहो स्वप्नस्य सुखता याहमेव चिराहृता।\nप्रेषितं नाम पश्यामि राघवेण वनौकसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000373021, "chapter_id": 9373, "verse_number": "५-३४-२१", "content_sanskrit": "स्वप्नेऽपि यद्यहं वीरं राघवं सहलक्ष्मणम्।\nपश्येयं नावसीदेयं स्वप्नोऽपि मम मत्सरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000373022, "chapter_id": 9373, "verse_number": "५-३४-२२", "content_sanskrit": "नाहं स्वप्नमिमं मन्ये स्वप्ने दृष्ट्वा हि वानरम्।\nन शक्योऽभ्युदयः प्राप्तुं प्राप्तश्चाभ्युदयो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000373023, "chapter_id": 9373, "verse_number": "५-३४-२३", "content_sanskrit": "किं नु स्याच्चित्तमोहोऽयं भवेद् वातगतिस्त्वियम्।\nउन्मादजो विकारो वा स्यादयं मृगतृष्णिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000373024, "chapter_id": 9373, "verse_number": "५-३४-२४", "content_sanskrit": "अथवा नायमुन्मादो मोहोऽप्युन्मादलक्षणः।\nसम्बुध्ये चाहमात्मानमिमं चापि वनौकसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000373025, "chapter_id": 9373, "verse_number": "५-३४-२५", "content_sanskrit": "इत्येवं बहुधा सीता सम्प्रधार्य बलाबलम्।\nरक्षसां कामरूपत्वान्मेने तं राक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000373026, "chapter_id": 9373, "verse_number": "५-३४-२६", "content_sanskrit": "एतां बुद्धिं तदा कृत्वा सीता सा तनुमध्यमा।\nन प्रतिव्याजहाराथ वानरं जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000373027, "chapter_id": 9373, "verse_number": "५-३४-२७", "content_sanskrit": "सीताया निश्चितं बुद्‍ध्वा हनूमान् मारुतात्मजः।\nश्रोत्रानुकूलैर्वचनैस्तदा तां सम्प्रहर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000373028, "chapter_id": 9373, "verse_number": "५-३४-२८", "content_sanskrit": "आदित्य इव तेजस्वी लोककान्तः शशी यथा।\nराजा सर्वस्य लोकस्य देवो वैश्रवणो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000373029, "chapter_id": 9373, "verse_number": "५-३४-२९", "content_sanskrit": "विक्रमेणोपपन्नश्च यथा विष्णुर्महायशाः।\nसत्यवादी मधुरवाग् देवो वाचस्पतिर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000373030, "chapter_id": 9373, "verse_number": "५-३४-३०", "content_sanskrit": "रूपवान् सुभगः श्रीमान् कंदर्प इव मूर्तिमान्।\nस्थानक्रोधे प्रहर्ता च श्रेष्ठो लोके महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000373031, "chapter_id": 9373, "verse_number": "५-३४-३१", "content_sanskrit": "बाहुच्छायामवष्टब्धो यस्य लोको महात्मनः।\nअपक्रम्याश्रमपदान्मृगरूपेण राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000373032, "chapter_id": 9373, "verse_number": "५-३४-३२", "content_sanskrit": "शून्ये येनापनीतासि तस्य द्रक्ष्यसि तत्फलम्।\nअचिराद् रावणं संख्ये यो वधिष्यति वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000373033, "chapter_id": 9373, "verse_number": "५-३४-३३", "content_sanskrit": "क्रोधप्रमुक्तैरिषुभिर्ज्वलद्भिरिव पावकैः।\nतेनाहं प्रेषितो दूतस्त्वत्सकाशमिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000373034, "chapter_id": 9373, "verse_number": "५-३४-३४", "content_sanskrit": "त्वद्वियोगेन दुःखार्तः स त्वां कौशलमब्रवीत्।\nलक्ष्मणश्च महातेजाः सुमित्रानन्दवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000373035, "chapter_id": 9373, "verse_number": "५-३४-३५", "content_sanskrit": "अभिवाद्य महाबाहुः स त्वां कौशलमब्रवीत्।\nरामस्य च सखा देवि सुग्रीवो नाम वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000373036, "chapter_id": 9373, "verse_number": "५-३४-३६", "content_sanskrit": "राजा वानरमुख्यानां स त्वां कौशलमब्रवीत्।\nनित्यं स्मरति ते रामः ससुग्रीवः सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000373037, "chapter_id": 9373, "verse_number": "५-३४-३७", "content_sanskrit": "दिष्ट्या जीवसि वैदेहि राक्षसीवशमागता।\nनचिराद् द्रक्ष्यसे रामं लक्ष्मणं च महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000373038, "chapter_id": 9373, "verse_number": "५-३४-३८", "content_sanskrit": "मध्ये वानरकोटीनां सुग्रीवं चामितौजसम्।\nअहं सुग्रीवसचिवो हनूमान् नाम वानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000373039, "chapter_id": 9373, "verse_number": "५-३४-३९", "content_sanskrit": "प्रविष्टो नगरीं लङ्कां लङ्घयित्वा महोदधिम्।\nकृत्वा मूर्ध्नि पदन्यासं रावणस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000373040, "chapter_id": 9373, "verse_number": "५-३४-४०", "content_sanskrit": "त्वां द्रष्टुमुपयातोऽहं समाश्रित्य पराक्रमम्।\nनाहमस्मि तथा देवि यथा मामवगच्छसि।\nविशङ्का त्यज्यतामेषा श्रद्धत्स्व वदतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000373041, "chapter_id": 9373, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे चतुस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]