[{"id": 5000107000, "chapter_id": 9107, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000107001, "chapter_id": 9107, "verse_number": "२-३०-१", "content_sanskrit": "सान्त्व्यमाना तु रामेण मैथिली जनकात्मजा।\nवनवासनिमित्तार्थं भर्तारमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000107002, "chapter_id": 9107, "verse_number": "२-३०-२", "content_sanskrit": "सा तमुत्तमसंविग्ना सीता विपुलवक्षसम्।\nप्रणयाच्चाभिमानाच्च परिचिक्षेप राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000107003, "chapter_id": 9107, "verse_number": "२-३०-३", "content_sanskrit": "किं त्वामन्यत वैदेहः पिता मे मिथिलाधिपः।\nराम जामातरं प्राप्य स्त्रियं पुरुषविग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000107004, "chapter_id": 9107, "verse_number": "२-३०-४", "content_sanskrit": "अनृतं बत लोकोऽयमज्ञानाद् यदि वक्ष्यति।\nतेजो नास्ति परं रामे तपतीव दिवाकरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000107005, "chapter_id": 9107, "verse_number": "२-३०-५", "content_sanskrit": "किं हि कृत्वा विषण्णस्त्वं कुतो वा भयमस्ति ते।\nयत् परित्यक्तुकामस्त्वं मामनन्यपरायणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000107006, "chapter_id": 9107, "verse_number": "२-३०-६", "content_sanskrit": "द्युमत्सेनसुतं वीरं सत्यवन्तमनुव्रताम्।\nसावित्रीमिव मां विद्धि त्वमात्मवशवर्तिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000107007, "chapter_id": 9107, "verse_number": "२-३०-७", "content_sanskrit": "न त्वहं मनसा त्वन्यं द्रष्टास्मि त्वदृतेऽनघ।\nत्वया राघव गच्छेयं यथान्या कुलपांसनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000107008, "chapter_id": 9107, "verse_number": "२-३०-८", "content_sanskrit": "स्वयं तु भार्यां कौमारीं चिरमध्युषितां सतीम्।\nशैलूष इव मां राम परेभ्यो दातुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000107009, "chapter_id": 9107, "verse_number": "२-३०-९", "content_sanskrit": "यस्य पथ्यंचरामात्थ यस्य चार्थेऽवरुध्यसे।\nत्वं तस्य भव वश्यश्च विधेयश्च सदानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000107010, "chapter_id": 9107, "verse_number": "२-३०-१०", "content_sanskrit": "स मामनादाय वनं न त्वं प्रस्थितुमर्हसि।\nतपो वा यदि वारण्यं स्वर्गो वा स्यात् त्वया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000107011, "chapter_id": 9107, "verse_number": "२-३०-११", "content_sanskrit": "न च मे भविता तत्र कश्चित् पथि परिश्रमः।\nपृष्ठतस्तव गच्छन्त्या विहारशयनेष्विव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000107012, "chapter_id": 9107, "verse_number": "२-३०-१२", "content_sanskrit": "कुशकाशशरेषीका ये च कण्टकिनो द्रुमाः।\nतूलाजिनसमस्पर्शा मार्गे मम सह त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000107013, "chapter_id": 9107, "verse_number": "२-३०-१३", "content_sanskrit": "महावातसमुद्भूतं यन्मामवकरिष्यति।\nरजो रमण तन्मन्ये परार्घ्यमिव चन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000107014, "chapter_id": 9107, "verse_number": "२-३०-१४", "content_sanskrit": "शाद्वलेषु यदा शिश्ये वनान्तर्वनगोचरा।\nकुथास्तरणयुक्तेषु किं स्यात् सुखतरं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000107015, "chapter_id": 9107, "verse_number": "२-३०-१५", "content_sanskrit": "पत्रं मूलं फलं यत्तु अल्पं वा यदि वा बहु।\nदास्यसे स्वयमाहृत्य तन्मेऽमृतरसोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000107016, "chapter_id": 9107, "verse_number": "२-३०-१६", "content_sanskrit": "न मातुर्न पितुस्तत्र स्मरिष्यामि न वेश्मनः।\nआर्तवान्युपभुञ्जाना पुष्पाणि च फलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000107017, "chapter_id": 9107, "verse_number": "२-३०-१७", "content_sanskrit": "न च तत्र ततः किंचिद् द्रष्टुमर्हसि विप्रियम्।\nमत्कृते न च ते शोको न भविष्यामि दुर्भरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000107018, "chapter_id": 9107, "verse_number": "२-३०-१८", "content_sanskrit": "यस्त्वया सह स स्वर्गो निरयो यस्त्वया विना।\nइति जानन् परां प्रीतिं गच्छ राम मया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000107019, "chapter_id": 9107, "verse_number": "२-३०-१९", "content_sanskrit": "अथ मामेवमव्यग्रां वनं नैव नयिष्यसे।\nविषमद्यैव पास्यामि मा वशं द्विषतां गमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000107020, "chapter_id": 9107, "verse_number": "२-३०-२०", "content_sanskrit": "पश्चादपि हि दुःखेन मम नैवास्ति जीवितम्।\nउज्झितायास्त्वया नाथ तदैव मरणं वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000107021, "chapter_id": 9107, "verse_number": "२-३०-२१", "content_sanskrit": "इमं हि सहितुं शोकं मुहूर्तमपि नोत्सहे।\nकिं पुनर्दश वर्षाणि त्रीणि चैकं च दुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000107022, "chapter_id": 9107, "verse_number": "२-३०-२२", "content_sanskrit": "इति सा शोकसंतप्ता विलप्य करुणं बहु।\nचुक्रोश पतिमायस्ता भृशमालिङ्ग्य सस्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000107023, "chapter_id": 9107, "verse_number": "२-३०-२३", "content_sanskrit": "सा विद्धा बहुभिर्वाक्यैर्दिग्धैरिव गजाङ्गना।\nचिरसंनियतं बाष्पं मुमोचाग्निमिवारणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000107024, "chapter_id": 9107, "verse_number": "२-३०-२४", "content_sanskrit": "तस्याः स्फटिकसंकाशं वारि संतापसम्भवम्।\nनेत्राभ्यां परिसुस्राव पङ्कजाभ्यामिवोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000107025, "chapter_id": 9107, "verse_number": "२-३०-२५", "content_sanskrit": "तत्सितामलचन्द्राभं मुखमायतलोचनम्।\nपर्यशुष्यत बाष्पेण जलोद्‍धृतमिवाम्बुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000107026, "chapter_id": 9107, "verse_number": "२-३०-२६", "content_sanskrit": "तां परिष्वज्य बाहुभ्यां विसंज्ञामिव दुःखिताम्।\nउवाच वचनं रामः परिविश्वासयंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000107027, "chapter_id": 9107, "verse_number": "२-३०-२७", "content_sanskrit": "न देवि बत दुःखेन स्वर्गमप्यभिरोचये।\nनहि मेऽस्ति भयं किंचित् स्वयम्भोरिव सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000107028, "chapter_id": 9107, "verse_number": "२-३०-२८", "content_sanskrit": "तव सर्वमभिप्रायमविज्ञाय शुभानने।\nवासं न रोचयेऽरण्ये शक्तिमानपि रक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000107029, "chapter_id": 9107, "verse_number": "२-३०-२९", "content_sanskrit": "यत् सृष्टासि मया सार्धं वनवासाय मैथिलि।\nन विहातुं मया शक्या प्रीतिरात्मवता यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000107030, "chapter_id": 9107, "verse_number": "२-३०-३०", "content_sanskrit": "धर्मस्तु गजनासोरु सद्भिराचरितः पुरा।\nतं चाहमनुवर्तिष्ये यथा सूर्यं सुवर्चला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000107031, "chapter_id": 9107, "verse_number": "२-३०-३१", "content_sanskrit": "न खल्वहं न गच्छेयं वनं जनकनन्दिनि।\nवचनं तन्नयति मां पितुः सत्योपबृंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000107032, "chapter_id": 9107, "verse_number": "२-३०-३२", "content_sanskrit": "एष धर्मश्च सुश्रोणि पितुर्मातुश्च वश्यता।\nआज्ञां चाहं व्यतिक्रम्य नाहं जीवितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000107033, "chapter_id": 9107, "verse_number": "२-३०-३३", "content_sanskrit": "अस्वाधीनं कथं दैवं प्रकारैरभिराध्यते।\nस्वाधीनं समतिक्रम्य मातरं पितरं गुरुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000107034, "chapter_id": 9107, "verse_number": "२-३०-३४", "content_sanskrit": "यत्र त्रयं त्रयो लोकाः पवित्रं तत्समं भुवि।\nनान्यदस्ति शुभापाङ्गे तेनेदमभिराध्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000107035, "chapter_id": 9107, "verse_number": "२-३०-३५", "content_sanskrit": "न सत्यं दानमानौ वा यज्ञो वाप्याप्तदक्षिणाः।\nतथा बलकराः सीते यथा सेवा पितुर्मता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000107036, "chapter_id": 9107, "verse_number": "२-३०-३६", "content_sanskrit": "स्वर्गो धनं वा धान्यं वा विद्या पुत्राः सुखानि च।\nगुरुवृत्त्यनुरोधेन न किंचिदपि दुर्लभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000107037, "chapter_id": 9107, "verse_number": "२-३०-३७", "content_sanskrit": "देवगन्धर्वगोलोकान् ब्रह्मलोकांस्तथापरान्।\nप्राप्नुवन्ति महात्मानो मातापितृपरायणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000107038, "chapter_id": 9107, "verse_number": "२-३०-३८", "content_sanskrit": "स मा पिता यथा शास्ति सत्यधर्मपथे स्थितः।\nतथा वर्तितुमिच्छामि स हि धर्मः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000107039, "chapter_id": 9107, "verse_number": "२-३०-३९", "content_sanskrit": "मम सन्ना मतिः सीते नेतुं त्वां दण्डकावनम्।\nवसिष्यामीति सा त्वं मामनुयातुं सुनिश्चिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000107040, "chapter_id": 9107, "verse_number": "२-३०-४०", "content_sanskrit": "सा हि दिष्टानवद्याङ्गि वनाय मदिरेक्षणे।\nअनुगच्छस्व मां भीरु सहधर्मचरी भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000107041, "chapter_id": 9107, "verse_number": "२-३०-४१", "content_sanskrit": "सर्वथा सदृशं सीते मम स्वस्य कुलस्य च।\nव्यवसायमनुक्रान्ता कान्ते त्वमतिशोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000107042, "chapter_id": 9107, "verse_number": "२-३०-४२", "content_sanskrit": "आरभस्व शुभश्रोणि वनवासक्षमाः क्रियाः।\nनेदानीं त्वदृते सीते स्वर्गोऽपि मम रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000107043, "chapter_id": 9107, "verse_number": "२-३०-४३", "content_sanskrit": "ब्राह्मणेभ्यश्च रत्नानि भिक्षुकेभ्यश्च भोजनम्।\nदेहि चाशंसमानेभ्यः संत्वरस्व च मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000107044, "chapter_id": 9107, "verse_number": "२-३०-४४", "content_sanskrit": "भूषणानि महार्हाणि वरवस्त्राणि यानि च।\nरमणीयाश्च ये केचित् क्रीडार्थाश्चाप्युपस्कराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000107045, "chapter_id": 9107, "verse_number": "२-३०-४५", "content_sanskrit": "शयनीयानि यानानि मम चान्यानि यानि च।\nदेहि स्वभृत्यवर्गस्य ब्राह्मणानामनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000107046, "chapter_id": 9107, "verse_number": "२-३०-४६", "content_sanskrit": "अनुकूलं तु सा भर्तुर्ज्ञात्वा गमनमात्मनः।\nक्षिप्रं प्रमुदिता देवी दातुमेव प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000107047, "chapter_id": 9107, "verse_number": "२-३०-४७", "content_sanskrit": "ततः प्रहृष्टा प्रतिपूर्णमानसा\nयशस्विनी भर्तुरवेक्ष्य भाषितम्।\nधनानि रत्नानि च दातुमङ्गना\nप्रचक्रमे धर्मभृतां मनस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000107048, "chapter_id": 9107, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]