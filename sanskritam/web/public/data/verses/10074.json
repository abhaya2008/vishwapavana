[{"id": 6000074000, "chapter_id": 10074, "verse_number": null, "content_sanskrit": "अथ दशमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000074001, "chapter_id": 10074, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.001.m4a", "display_order": 2}, {"id": 6000074002, "chapter_id": 10074, "verse_number": "४-१०-१", "content_sanskrit": "त एवमुत्सन्नभया उरुक्रमे कृतप्रणामाः प्रययुस्‍त्रिविष्टपम्।\nसहस्रशीर्षाऽपि ततो गरुत्मता मधोर्वनं भृत्यदिदृक्षयाऽगतः॥ ४/१०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.002.m4a", "display_order": 3, "topics": [{"text": "ध्रुवतपसा तुष्टस्य भगवतो मधुवनगमनम्", "range": "१–५"}]}, {"id": 6000074003, "chapter_id": 10074, "verse_number": "४-१०-२", "content_sanskrit": "स वै धिया योगविपाकतीव्रया हृत्पद्मकोशे स्फुरितं तडित्प्रभम्।\nतिरोहितं सहसैवोपलक्ष्य बहिः स्थितं तदवस्थं ददर्श॥ ४/१०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.003.m4a", "display_order": 4}, {"id": 6000074004, "chapter_id": 10074, "verse_number": "४-१०-३", "content_sanskrit": "तद्दर्शनेनागतसाध्वसः क्षिताववन्दताङ्गं विनिमय्य दण्डवत्।\nदृग्भ्यां प्रपश्यन् प्रपिबन्निवार्भकश्चुम्बन्निवास्येन भुजेन चाश्लिषन्॥ ४/१०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.004.m4a", "display_order": 5}, {"id": 6000074005, "chapter_id": 10074, "verse_number": "४-१०-४", "content_sanskrit": "स तं विवक्षन्तमतद्विदं हरिर्ज्ञात्वाऽस्य सर्वस्य च हृद्यवस्थितः।\nकृताञ्जलिं ब्रह्ममयेन कम्बुना पस्पर्श बालं कृपया कपोले॥ ४/१०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.005.m4a", "display_order": 6}, {"id": 6000074006, "chapter_id": 10074, "verse_number": "४-१०-५", "content_sanskrit": "स वै तदैव प्रतिपद्य तां गिरं दैवीं परिज्ञातपरात्मनिर्णयः।\nतद्भक्तिभावोऽभ्यगृणादसत्वरं परिश्रितोरुश्रवसं ध्रुवक्षितिम्॥ ४/१०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.006.m4a", "display_order": 7}, {"id": 6000074007, "chapter_id": 10074, "verse_number": null, "content_sanskrit": "ध्रुव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.007.m4a", "display_order": 8}, {"id": 6000074008, "chapter_id": 10074, "verse_number": "४-१०-६", "content_sanskrit": "योऽन्तः प्रविश्य मम वाचमिमां प्रसुप्तां संजीवयत्यखिलशक्तिधरः स्वधाम्ना।\nअन्यांश्च हस्तचरणश्रवणत्वगादीन् प्राणान् नमो भगवते पुरुषाय तुभ्यम्॥ ४/१०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.008.m4a", "display_order": 9, "topics": [{"text": "ध्रुवकृतवासुदेवस्तोत्रम्", "range": "६–१७"}]}, {"id": 6000074009, "chapter_id": 10074, "verse_number": "४-१०-७", "content_sanskrit": "एकस्त्वमेव भगवन्निदमात्मशक्त्या मायाख्ययोरुगुणया महदाद्यशेषम्।\nसृष्ट्वाऽनुविश्य पुरुषस्तदसद्गुणेषु नानेव दारुषु विभावसुवद् विभासि॥ ४/१०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.009.m4a", "display_order": 10}, {"id": 6000074010, "chapter_id": 10074, "verse_number": "४-१०-८", "content_sanskrit": "त्वद्दत्तया वयुनयेदमचष्ट विश्वं सुप्तः प्रबुद्ध इव नाथ भवत्प्रपन्नः।\nतस्यापवर्ग्यशरणं तव पादमूलं विस्मर्यते कृतधिया कथमार्तबन्धो॥ ४/१०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.010.m4a", "display_order": 11}, {"id": 6000074011, "chapter_id": 10074, "verse_number": "४-१०-९", "content_sanskrit": "नूनं विमुष्टमतयस्तव मायया ते ये त्वां भवाप्ययविमोक्षणमन्यहेतोः।\nअर्चन्ति कल्पकतरुं कुणपोपभोग्यमिच्छन्ति यत् स्पर्शजं निरयेऽपि नॄणाम्॥ ४/१०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.011.m4a", "display_order": 12}, {"id": 6000074012, "chapter_id": 10074, "verse_number": "४-१०-१०", "content_sanskrit": "या निर्वृतिस्तनुभृतां तव पादपद्मध्यानाद् भवज्जनकथाश्रवणेन वा स्यात्।\nसा ब्रह्मणि स्वमहिमन्यपि नाथ मा भूत् किम्वन्तकासिलुलितात् पततां विमानात्॥ ४/१०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.012.m4a", "display_order": 13}, {"id": 6000074013, "chapter_id": 10074, "verse_number": "४-१०-११", "content_sanskrit": "भक्तिं मुहुः प्रवहतां त्वयि मे प्रसङ्गो भूयादनन्त महताममलाशयानाम्।\nयेनाञ्जसोल्बणमुरुव्यसनं भवाब्धिं नेष्ये भवज्‍जनकथामृतपानमत्तः॥ ४/१०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.013.m4a", "display_order": 14}, {"id": 6000074014, "chapter_id": 10074, "verse_number": "४-१०-१२", "content_sanskrit": "ते न स्मरन्त्यतितरां प्रियमीशमाद्यं स्वान् संपदः सुतसुहृद्गृहवित्तदारान्।\nये त्वब्जनाभ भवदीयपदारविन्दसौगन्ध्यलुब्धहृदयेषु कृतप्रसङ्गाः॥ ४/१०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.014.m4a", "display_order": 15}, {"id": 6000074015, "chapter_id": 10074, "verse_number": "४-१०-१३", "content_sanskrit": "तिर्यङ्नगद्विजसरीसृपदेवदैत्यमर्त्यादिभिर्विरचितं सदसद्विशेषम्।\nरूपं स्थविष्ठमज ते महदाद्यशेषं नातः परं परम वेद्मि न यत्र वाचः॥ ४/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.015.m4a", "display_order": 16}, {"id": 6000074016, "chapter_id": 10074, "verse_number": "४-१०-१४", "content_sanskrit": "कल्पान्त एतदखिलं जठरेण गृह्णन् शेते पुमान् स्वदृगनन्तसखस्तदङ्के।\nयन्नाभिसिन्धुरुहकाञ्चनलोकपद्मगर्भे द्युमान् भगवते प्रणतोऽस्मि तस्मै॥ ४/१०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.016.m4a", "display_order": 17}, {"id": 6000074017, "chapter_id": 10074, "verse_number": "४-१०-१५", "content_sanskrit": "त्वं नित्यमुक्तपरिशुद्धविबुद्ध आत्मा कूटस्थ आदिपुरुषो भगवांस्‍त्र्यधीशः।\nये बुद्ध्यवस्थितमखण्डितया स्वबुद्ध्या दृष्ट्वाऽऽस्थिता वधिमतो व्यतिरिक्त आस्से॥ ४/१०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.017.m4a", "display_order": 18}, {"id": 6000074018, "chapter_id": 10074, "verse_number": "४-१०-१६", "content_sanskrit": "यस्मिन् विरुद्धगतयोऽप्यनिशं पतन्ति विद्यादयो विविधशक्तय आनुपूर्व्या।\nतद् ब्रह्म विश्वभवमेकमविश्वमाद्यम् आनन्दमात्रमविकारमहं प्रपद्ये॥ ४/१०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.018.m4a", "display_order": 19}, {"id": 6000074019, "chapter_id": 10074, "verse_number": "४-१०-१७", "content_sanskrit": "सत्याशिषो हि भगवंस्तव पादमूलमाशिष्टयोऽनुभजतः पुरुषार्थमूर्तेः।\nअप्येवमार्य भगवान् परिपाति दीनान् वास्रेव वत्सकमनुग्रहकातरोऽस्मान्॥ ४/१०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.019.m4a", "display_order": 20}, {"id": 6000074020, "chapter_id": 10074, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.020.m4a", "display_order": 21}, {"id": 6000074021, "chapter_id": 10074, "verse_number": "४-१०-१८", "content_sanskrit": "अथाभिष्टुत एवं वै सत्संकल्पेन धीमता।\nभृत्यानुरक्तो भगवान् प्रतिनन्द्येदमब्रवीत्॥ ४/१०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.021.m4a", "display_order": 22, "topics": [{"text": "ध्रुवाय वरदानम्", "range": "१८–२५"}]}, {"id": 6000074022, "chapter_id": 10074, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.022.m4a", "display_order": 23}, {"id": 6000074023, "chapter_id": 10074, "verse_number": "४-१०-१९", "content_sanskrit": "वेदाहं ते व्यवसितं हृदि राजन्यबालक।\nतत् प्रयच्छामि भद्रं ते दुरापमपि भूयसाम्॥ ४/१०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.023.m4a", "display_order": 24}, {"id": 6000074024, "chapter_id": 10074, "verse_number": "४-१०-२०", "content_sanskrit": "नान्यैरधिष्ठितं भद्र यद् भ्राजिष्णु ध्रुवक्षिति।\nयत्र ग्रहर्क्षताराणां ज्योतिषां चक्रमाहितम्॥ ४/१०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.024.m4a", "display_order": 25}, {"id": 6000074025, "chapter_id": 10074, "verse_number": "४-१०-२१", "content_sanskrit": "मेढ्यां गोचक्रवत् स्थास्नु पुरस्तात् कल्पवासिनाम्। धर्मोऽग्निः कश्यपः शक्रो मुनयो ये वनौकसः।\nचरन्ति दक्षिणीकृत्य भ्रमन्तो वत्सतारकाः॥ ४/१०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.025.m4a", "display_order": 26}, {"id": 6000074026, "chapter_id": 10074, "verse_number": "४-१०-२२", "content_sanskrit": "प्रस्थिते तु वनं पित्रा दत्तां गां धर्मसंश्रयः।\nषट्त्रिंशद्वर्षसाहस्रं रक्षिताऽव्याहतेन्द्रियः॥ ४/१०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.026.m4a", "display_order": 27}, {"id": 6000074027, "chapter_id": 10074, "verse_number": "४-१०-२३", "content_sanskrit": "त्वद्भ्रातर्युत्तमे नष्टे मृगयायां तु तन्मनाः।\nअन्वेषती वनं माता दावाग्निं सा प्रवेक्ष्यति॥ ४/१०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.027.m4a", "display_order": 28}, {"id": 6000074028, "chapter_id": 10074, "verse_number": "४-१०-२४", "content_sanskrit": "इष्ट्वा मां यज्ञहृदयं यज्ञैः पुष्कलदक्षिणैः।\nभुक्त्वा चेहाशिषः सत्या अन्ते माऽनुस्मरिष्यसि॥ ४/१०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.028.m4a", "display_order": 29}, {"id": 6000074029, "chapter_id": 10074, "verse_number": "४-१०-२५", "content_sanskrit": "ततो गन्तासि मत्स्थानं सर्वलोकनमस्कृतम्।\nउपरिष्टाद् ऋषिभ्यस्त्वं यतो नावर्तते यतिः॥ ४/१०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.029.m4a", "display_order": 30}, {"id": 6000074030, "chapter_id": 10074, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.030.m4a", "display_order": 31}, {"id": 6000074031, "chapter_id": 10074, "verse_number": "४-१०-२६", "content_sanskrit": "इत्यर्चितः स भगवानतिसृज्यात्मनः पदम्।\nबालस्य पश्यतो धाम जगाम गरुडध्वजः॥ ४/१०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.031.m4a", "display_order": 32, "topics": [{"text": "ध्रुवस्य पश्चात्तापः", "range": "२६–३५"}]}, {"id": 6000074032, "chapter_id": 10074, "verse_number": "४-१०-२७", "content_sanskrit": "सोऽपि सङ्कल्पजं विष्णोः पादसेवोपसादितम्।\nप्राप्य सङ्कल्पनिर्वाणं नातिप्रीतोऽभ्यगात् पुरम्॥ ४/१०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.032.m4a", "display_order": 33}, {"id": 6000074033, "chapter_id": 10074, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.033.m4a", "display_order": 34}, {"id": 6000074034, "chapter_id": 10074, "verse_number": "४-१०-२८", "content_sanskrit": "सुदुर्लभं यत् परमं पदं हरेर्मायाविनस्तच्चरणार्चनार्जितम्।\nलब्ध्वाऽप्यसिद्धार्थमिवैकजन्मना कथं स्वमात्मानममन्यतार्थवित्॥ ४/१०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.034.m4a", "display_order": 35}, {"id": 6000074035, "chapter_id": 10074, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.035.m4a", "display_order": 36}, {"id": 6000074036, "chapter_id": 10074, "verse_number": "४-१०-२९", "content_sanskrit": "मातुः सपत्न्या वाग्बाणैर्हृदि विद्धस्तु तान् स्मरन्।\nनैच्छन्मुक्तिपतेर्मुक्तिं तस्मात् तापमुपेयिवान्॥ ४/१०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.036.m4a", "display_order": 37}, {"id": 6000074037, "chapter_id": 10074, "verse_number": null, "content_sanskrit": "ध्रुव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.037.m4a", "display_order": 38}, {"id": 6000074038, "chapter_id": 10074, "verse_number": "४-१०-३०", "content_sanskrit": "समाधिनाऽनेकभवेन यत्पदं विदुः सनन्दादय ऊर्ध्वरेतसः।\nमासैरहं षड्भिरमुष्य पादयोश्छायामुपेत्यापहतः पृथङ्मतिः॥ ४/१०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.038.m4a", "display_order": 39}, {"id": 6000074039, "chapter_id": 10074, "verse_number": "४-१०-३१", "content_sanskrit": "अहो बत ममानात्म्यं मन्दभाग्यस्य पश्यत।\nभवच्छिदः पादमूलं गत्वा याचे तदन्तवत्॥ ४/१०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.039.m4a", "display_order": 40}, {"id": 6000074040, "chapter_id": 10074, "verse_number": "४-१०-३२", "content_sanskrit": "मतिर्विदूषिता देवैर्यतद्भिरसहिष्णुभिः।\nयो नारदवचस्तथ्यं नाग्रहीषमसत्तमः॥ ४/१०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.040.m4a", "display_order": 41}, {"id": 6000074041, "chapter_id": 10074, "verse_number": "४-१०-३३", "content_sanskrit": "दैवीं मायामुपाश्रित्य प्रसुप्त इव भिन्नदृक्।\nतप्ये द्वितीयेऽप्यसति भ्रातृभ्रातृव्यहृद्रुजा॥ ४/१०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.041.m4a", "display_order": 42}, {"id": 6000074042, "chapter_id": 10074, "verse_number": "४-१०-३४", "content_sanskrit": "मयैतत् प्रार्थितं व्यर्थं चिकित्सेव गतायुषि।\nप्रसाद्य जगदात्मानं तपसा दुष्प्रसादनम्॥ ४/१०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.042.m4a", "display_order": 43}, {"id": 6000074043, "chapter_id": 10074, "verse_number": "४-१०-३५", "content_sanskrit": "भवच्छिदमयाचेऽहं भवं भाग्यविवर्जितः। तादात्म्यं यच्छतो मौढ्यान्मनो मे भिक्षितं बत।\nईश्वरात् क्षीणपुण्येन पुलकानिव चाधनः॥ ४/१०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.043.m4a", "display_order": 44}, {"id": 6000074044, "chapter_id": 10074, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.044.m4a", "display_order": 45}, {"id": 6000074045, "chapter_id": 10074, "verse_number": "४-१०-३६", "content_sanskrit": "न वै मुकुन्दस्य पदारविन्दयो रजोजुषस्तात भवादृशा जनाः।\nवाञ्छन्ति तद्दास्यमृतेऽर्थमात्मनो यदृच्छया लब्धमनःसमृद्धयः॥ ४/१०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.045.m4a", "display_order": 46, "topics": [{"text": "वनान्नगरमागतस्य ध्रुवस्य पित्रा उत्तानपादेन राज्ये पट्टाभिषेकः", "range": "३६–६७"}]}, {"id": 6000074046, "chapter_id": 10074, "verse_number": "४-१०-३७", "content_sanskrit": "आकर्ण्यात्मजमायान्तं सम्परेत्य यथागतम्।\nराजा न श्रद्दधे भद्रमभद्रस्य कुतो मम॥ ४/१०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.046.m4a", "display_order": 47}, {"id": 6000074047, "chapter_id": 10074, "verse_number": "४-१०-३८", "content_sanskrit": "श्रद्धाय वाक्यं देवर्षेर्हर्षवेगेन धर्षितः।\nवार्ताहर्तुरतिप्रीतो हारं प्रादान्महाधनम्॥ ४/१०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.047.m4a", "display_order": 48}, {"id": 6000074048, "chapter_id": 10074, "verse_number": "४-१०-३९", "content_sanskrit": "सदश्वं रथमारुह्य कार्तस्वरपरिष्कृतम्।\nब्राह्मणैः कुलवृद्धैश्च पर्यस्तोऽमात्यबन्धुभिः॥ ४/१०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.048.m4a", "display_order": 49}, {"id": 6000074049, "chapter_id": 10074, "verse_number": "४-१०-४०", "content_sanskrit": "शङ्खदुन्दुभिनादेन ब्रह्मघोषेण वेणुभिः।\nनिश्चक्राम पुरात् तूर्णमात्मजाभीक्षणोत्सुकः॥ ४/१०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.049.m4a", "display_order": 50}, {"id": 6000074050, "chapter_id": 10074, "verse_number": "४-१०-४१", "content_sanskrit": "सुनीतिः सुरुचिश्चास्य महिष्यौ रुग्मभूषिते।\nआरुह्य शिबिके सार्धमुत्तमेनाभिजग्मतुः॥ ४/१०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.050.m4a", "display_order": 51}, {"id": 6000074051, "chapter_id": 10074, "verse_number": "४-१०-४२", "content_sanskrit": "तं दृष्ट्वोपवनाभ्याश आयान्तं तरसा रथात्।\nअवरुह्य नृपस्तूर्णमासाद्य प्रेमविह्वलः॥ ४/१०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.051.m4a", "display_order": 52}, {"id": 6000074052, "chapter_id": 10074, "verse_number": "४-१०-४३", "content_sanskrit": "परिरेभेऽङ्गजं दोर्भ्यां दीर्घोत्कण्ठमनाः श्वसन्।\nविष्वक्सेनाङ्घ्रिसंस्पर्शहताशेषाघबन्धनम्॥ ४/१०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.052.m4a", "display_order": 53}, {"id": 6000074053, "chapter_id": 10074, "verse_number": "४-१०-४४", "content_sanskrit": "अथाजिघ्रन्मुहुर्मूर्ध्नि शान्तैर्नयनवारिभिः।\nस्नापयामास तनयमाप्तोद्दाममनोरथम्॥ ४/१०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.053.m4a", "display_order": 54}, {"id": 6000074054, "chapter_id": 10074, "verse_number": "४-१०-४५", "content_sanskrit": "अभिवन्द्य पितुः पादावाशीर्भिश्चानुमन्त्रितः।\nननाम मातरौ शीर्ष्णा सत्कृतः सज्जनाग्रणीः॥ ४/१०/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.054.m4a", "display_order": 55}, {"id": 6000074055, "chapter_id": 10074, "verse_number": "४-१०-४६", "content_sanskrit": "सुरुचिस्तं समुत्थाप्य पादावानतमर्भकम्।\nपरिष्वज्याह जीवेति बाष्पगद्गदया गिरा॥ ४/१०/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.055.m4a", "display_order": 56}, {"id": 6000074056, "chapter_id": 10074, "verse_number": "४-१०-४७", "content_sanskrit": "यस्य प्रसन्नो भगवान् गुणैर्मैत्र्यादिभिर्हरिः।\nतस्मै नमन्ति भूतानि निम्नमाप इव स्वयम्॥ ४/१०/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.056.m4a", "display_order": 57}, {"id": 6000074057, "chapter_id": 10074, "verse_number": "४-१०-४८", "content_sanskrit": "उत्तमश्च ध्रुवश्चोभावन्योन्यं प्रेमविह्वलौ।\nअङ्गसङ्गादुत्पुलकावस्रौघं मुहुरूहतुः॥ ४/१०/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.057.m4a", "display_order": 58}, {"id": 6000074058, "chapter_id": 10074, "verse_number": "४-१०-४९", "content_sanskrit": "सुनीतिरस्य जननी प्राणेभ्योऽपि प्रियं सुतम्।\nउपगुह्य जहावाधिं यदङ्गस्पर्शनिर्वृता॥ ४/१०/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.058.m4a", "display_order": 59}, {"id": 6000074059, "chapter_id": 10074, "verse_number": "४-१०-५०", "content_sanskrit": "पयः स्तनाभ्यां सुस्राव नेत्रजैः सलिलैः शिवैः।\nतदाऽभिषिच्यमानाया वीरे वीरसुवो मुहुः॥ ४/१०/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.059.m4a", "display_order": 60}, {"id": 6000074060, "chapter_id": 10074, "verse_number": "४-१०-५१", "content_sanskrit": "तां शशंसुर्जना राज्ञीं दिष्ट्या ते पुत्र आर्तिहा।\nप्रतिलब्धश्चिरं नष्टो रक्षिता मण्डलं भुवः॥ ४/१०/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.060.m4a", "display_order": 61}, {"id": 6000074061, "chapter_id": 10074, "verse_number": "४-१०-५२", "content_sanskrit": "अभ्यर्चितस्त्वया नूनं भगवान् प्रणतार्तिहा।\nयदनुध्यायिनो धीरा मृत्युं जिग्युः सुदुर्जयम्॥ ४/१०/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.061.m4a", "display_order": 62}, {"id": 6000074062, "chapter_id": 10074, "verse_number": "४-१०-५३", "content_sanskrit": "लाल्यमानं जनैरेवं ध्रुवं सभ्रातरं नृपः।\nआरोप्य करिणीं हृष्टः स्तूयमानोऽविशत् पुरम्॥ ४/१०/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.062.m4a", "display_order": 63}, {"id": 6000074063, "chapter_id": 10074, "verse_number": "४-१०-५४", "content_sanskrit": "तत्र तत्रोपसंकॢप्तैर्लसन्मकरतोरणैः।\nसंवृतैः कदलीस्तम्भैः पूगपोतैश्च तद्विधैः॥ ४/१०/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.063.m4a", "display_order": 64}, {"id": 6000074064, "chapter_id": 10074, "verse_number": "४-१०-५५", "content_sanskrit": "चूतपल्लववासःस्रङ्मुक्तादामविलम्बिभिः।\nउपस्कृतं प्रतिद्वारमपां कुम्भैः सदीपकैः॥ ४/१०/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.064.m4a", "display_order": 65}, {"id": 6000074065, "chapter_id": 10074, "verse_number": "४-१०-५६", "content_sanskrit": "प्राकारैर्गोपुराट्टालैः शातकुम्भपरिच्छदैः।\nसर्वतोऽलंकृतं श्रीमद्विमानशिखरद्युभिः॥ ४/१०/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.065.m4a", "display_order": 66}, {"id": 6000074066, "chapter_id": 10074, "verse_number": "४-१०-५७", "content_sanskrit": "मृष्टचत्वररथ्यादिमार्गं चन्दनचर्चितम्।\nलाजाक्षतैः पुष्पफलैस्तण्डुलैर्बलिभिर्युतम्॥ ४/१०/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.066.m4a", "display_order": 67}, {"id": 6000074067, "chapter_id": 10074, "verse_number": "४-१०-५८", "content_sanskrit": "ध्रुवाय पथि दृष्टाय तत्र तत्र पुरस्‍त्रियः।\nसिद्धार्थाक्षतदध्यम्बुदूर्वापुष्पफलानि च॥ ४/१०/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.067.m4a", "display_order": 68}, {"id": 6000074068, "chapter_id": 10074, "verse_number": "४-१०-५९", "content_sanskrit": "उपजह्रुः प्रयुञ्जाना वात्सल्यादाशिषः सतीः।\nशृण्वंस्तु वल्गुगीतानि प्राविशद् भवनं पितुः॥ ४/१०/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.068.m4a", "display_order": 69}, {"id": 6000074069, "chapter_id": 10074, "verse_number": "४-१०-६०", "content_sanskrit": "महामणिव्रातमये स तस्मिन् कशिपूत्तमे।\nलालितो नितरां पित्रा न्यवसद् दिवि देववत्॥ ४/१०/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.069.m4a", "display_order": 70}, {"id": 6000074070, "chapter_id": 10074, "verse_number": "४-१०-६१", "content_sanskrit": "पयःफेननिभाः शय्या दान्ता रुक्मपरिच्छदाः।\nआसनानि महार्हाणि यत्र रौग्मा उपस्कराः॥ ४/१०/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.070.m4a", "display_order": 71}, {"id": 6000074071, "chapter_id": 10074, "verse_number": "४-१०-६२", "content_sanskrit": "यत्र स्फटिककुड्येषु महामारकतेषु च।\nमणिप्रदीपा आभान्ति ललनारत्नसंयुताः॥ ४/१०/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.071.m4a", "display_order": 72}, {"id": 6000074072, "chapter_id": 10074, "verse_number": "४-१०-६३", "content_sanskrit": "उद्यानानि च रम्याणि विचित्रैरमरद्रुमैः।\nकूजद्विहङ्गमिथुनैर्गायन्मत्तमधुव्रतैः॥ ४/१०/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.072.m4a", "display_order": 73}, {"id": 6000074073, "chapter_id": 10074, "verse_number": "४-१०-६४", "content_sanskrit": "वाप्यो वैदूर्यसोपानाः पद्मोत्पलकुमुद्वतीः।\nहंसकारण्डबकुलैर्जुष्टाश्चक्राह्वसारसैः॥ ४/१०/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.073.m4a", "display_order": 74}, {"id": 6000074074, "chapter_id": 10074, "verse_number": "४-१०-६५", "content_sanskrit": "उत्तानपादो राजर्षिः प्रभावं तनयस्य तम्।\nश्रुत्वा दृष्ट्वाऽद्भुततमं प्रपेदे विस्मयं परम्॥ ४/१०/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.074.m4a", "display_order": 75}, {"id": 6000074075, "chapter_id": 10074, "verse_number": "४-१०-६६", "content_sanskrit": "वीक्ष्योढवयसं पुत्रं प्रकृतीनां च संमतम्।\nअनुरक्तप्रजं राजा ध्रुवं चक्रे भुवः पतिम्॥ ४/१०/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.075.m4a", "display_order": 76}, {"id": 6000074076, "chapter_id": 10074, "verse_number": "४-१०-६७", "content_sanskrit": "आत्मानं च प्रवयसमाकलय्य विशांपतिः।\nवनं विरक्तः प्रातिष्ठत् विमृशन्नात्मनो गतिम्॥ ४/१०/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_010/BhP_04.010.076.m4a", "display_order": 77}, {"id": 6000074077, "chapter_id": 10074, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे दशमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]