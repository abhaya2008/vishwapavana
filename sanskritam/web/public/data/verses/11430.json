[{"id": 50009756, "chapter_id": 11430, "verse_number": "1", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50009757, "chapter_id": 11430, "verse_number": "2", "content_sanskrit": "सनकाद्या नारदश्च ऋभुर्हंसोऽरुणो यतिः। नैते गृहान् ब्रह्मसुता अवसन्नूर्ध्वरेतसः॥ ४/९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50009758, "chapter_id": 11430, "verse_number": "3", "content_sanskrit": "मृषाऽधर्मस्य भार्याऽऽसीद् डम्भं मायां च शत्रुहन्। असूत मिथुनं तत्तु निऋर्तिर्जगृहेऽप्रजः॥ ४/९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50009759, "chapter_id": 11430, "verse_number": "4", "content_sanskrit": "तयोः समभवल्लोभो निकृतिश्च महामते। ताभ्यां क्रोधश्च हिंसा च दुरुक्तिश्च तयोः कलिः॥ ४/९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50009760, "chapter_id": 11430, "verse_number": "5", "content_sanskrit": "दुरुक्तौ कलिराधत्त भयं मृत्युं च सत्तम। तयोश्च मिथुनं जज्ञे यातना निरयस्तथा॥ ४/९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50009761, "chapter_id": 11430, "verse_number": "6", "content_sanskrit": "एते ह्यधर्मवृक्षस्य वंशाः संसृतिहेतवः। श्रेयस्कामो न सेवेत सुतरामाश्रमोत्तमी॥ ४/९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50009762, "chapter_id": 11430, "verse_number": "7", "content_sanskrit": "सङ्ग्रहेण मया ख्यातः अनुसर्गस्तवानघ। त्रिःश्रुत्वैतत् पुमान् पुण्यं विधुनोत्यात्मनो मलम्॥ ४/९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50009763, "chapter_id": 11430, "verse_number": "8", "content_sanskrit": "अथातः कीर्तये वंशं पुण्यकीर्तेः कुरूद्वह। स्वायम्भुवस्यापि मनोर्हरेरंशांशजन्मनः॥ ४/९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50009764, "chapter_id": 11430, "verse_number": "9", "content_sanskrit": "प्रियव्रतोत्तानपादौ शतरूपाऽलभत् सुतौ। वासुदेवस्य कलया रक्षायां जगति स्थितौ॥ ४/९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50009765, "chapter_id": 11430, "verse_number": "10", "content_sanskrit": "जाये उत्तानपादस्य सुनीतिः सुरुचिस्तयोः। सुरुचिः प्रेयसी पत्युर्नेतरा यत्सुतो ध्रुवः॥ ४/९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50009766, "chapter_id": 11430, "verse_number": "11", "content_sanskrit": "एकदा सुरुचेः पुत्रमङ्कमारोप्य लाळयन्। उत्तमं नारुरुक्षन्तं ध्रुवं राजाऽभ्यनन्दत॥ ४/९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50009767, "chapter_id": 11430, "verse_number": "12", "content_sanskrit": "तथा चिकार्षमाणं तं सपत्नयास्तनयं ध्रुवम्। सुरुचिः शृण्वतो राज्ञः सेर्ष्यमाहातिगर्विता॥ ४/९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50009768, "chapter_id": 11430, "verse_number": "13", "content_sanskrit": "न वत्स नृपतेर्धिष्ण्यं भवानारोढुमर्हति। न गृहीतो मया यत् त्वं कुक्षावसि नृपात्मज॥ ४/९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50009769, "chapter_id": 11430, "verse_number": "14", "content_sanskrit": "बालोऽसि बत नात्मानमन्यस्त्रीगर्भसम्भृतम्। नूनं वेद भवान् यस्य दुर्लभेऽर्थे मनोरथः॥ ४/९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50009770, "chapter_id": 11430, "verse_number": "15", "content_sanskrit": "तपसाऽऽराध्य पुरुषं तस्यैवानुग्रहेण मे। गर्भेऽऽस्मन् साधयात्मानं यदीच्छसि नृपासनम्॥ ४/९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50009771, "chapter_id": 11430, "verse_number": "16", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50009772, "chapter_id": 11430, "verse_number": "17", "content_sanskrit": "मातुः सपत्नयाः सुदुरुक्तिविद्धः श्वसन् रुषा दण्डहतो यथाऽहिः। हित्वा मिषन्तं पितरं सन्नवाचं जगाम मातुः प्ररुदन् सकाशम्॥ ४/९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50009773, "chapter_id": 11430, "verse_number": "18", "content_sanskrit": "तं निःश्वसन्तं स्फुरिताधरोष्ठं सुनीतिरुत्सङ्ग उदूह्य बालम्। निशम्य तत् पुत्रमुखान्नितान्तं सा विव्यथे यद् गदितं सपत्नया॥ ४/९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50009774, "chapter_id": 11430, "verse_number": "19", "content_sanskrit": "सोत्सृज्य धैर्यं विललाप शोकदावाग्निना दावलतेव बाला। वाक्यं सपत्नयाः स्मरती सरोजश्रिया दृशा बाष्पकळामुवाह॥ ४/९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50009775, "chapter_id": 11430, "verse_number": "20", "content_sanskrit": "दीर्घं श्वसन्ती व्रजिनस्य पारं न पश्यती बालकमाह बाला। माऽमङ्गलं तात परेषु मंस्था भुङ्क्ते जनो यत् परदुःखदस्तत्॥ ४/९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50009776, "chapter_id": 11430, "verse_number": "21", "content_sanskrit": "सत्यं सुरुच्याऽभिहितं भवान् मे यद् दुर्भगाया उदरे गृहीतः। स्तन्येन वृद्धश्च विलज्जते यां भार्येति वा वोढुमिडस्पतिर्माम्॥ ४/९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50009777, "chapter_id": 11430, "verse_number": "22", "content_sanskrit": "आतिष्ठ तत् तात विमत्सरस्त्वमुक्तं सुमात्राऽपि यदव्यळीकम्। आराधयाधोक्षजपादपद्मं यदीच्छसेऽध्यासनमुत्तमो यथा॥ ४/९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50009778, "chapter_id": 11430, "verse_number": "23", "content_sanskrit": "यत्पादपद्मं परिचर्य विश्वविभावनायात्तगुणाभिपत्तेः। अजोऽध्यतिष्ठत् खलु पारमेष्ठ्यं पदं जितात्मा श्वसनाभिवन्द्यम्॥ ४/९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50009779, "chapter_id": 11430, "verse_number": "24", "content_sanskrit": "तथा मनुर्वो भगवान् पितामहो यमेकभक्तिः पुरुदक्षिणैर्मखैः। इष्ट्वाऽभिपेदे दुरवापमन्यतो भौमं सुखं दिव्यमथापवर्ग्यम्॥ ४/९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50009780, "chapter_id": 11430, "verse_number": "25", "content_sanskrit": "तमेव वत्साश्रय भृत्यवत्सलं मुमुक्षुभिर्मृग्यपदाब्जपद्धतिम्। अनन्यभावे निजधर्मभाविते मनस्यवस्थाप्य भजस्व पूरुषम्॥ ४/९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50009781, "chapter_id": 11430, "verse_number": "26", "content_sanskrit": "नान्यं ततः पदम्पलाशलोचनाद् दुःखच्छिदं ते मृगयामि कञ्चन। यो मृग्यते हस्तगृहीतपदम्या श्रियेतरैरङ्ग विमृग्यमाणया॥ ४/९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50009782, "chapter_id": 11430, "verse_number": "27", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50009783, "chapter_id": 11430, "verse_number": "28", "content_sanskrit": "एवं सञ्जल्पितं मातुराकर्ण्यार्थागमं वचः। सन्नियम्यात्मनाऽऽत्मानं निश्चक्राम पितुः पुरात्॥ ४/९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50009784, "chapter_id": 11430, "verse_number": "29", "content_sanskrit": "नारदस्तदुपाकर्ण्य ज्ञात्वा चास्य चिकार्षितम्। स्पृष्ट्वा मूर्धन्यघघ्नेन पाणिना प्राह विस्मितः॥ ४/९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50009785, "chapter_id": 11430, "verse_number": "30", "content_sanskrit": "अहो तेजः क्षत्रियाणां मानभङ्गममृष्यताम्। बालोऽप्ययं हृदा धत्ते यत् समातुरसद्वचः॥ ४/९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50009786, "chapter_id": 11430, "verse_number": "31", "content_sanskrit": "नारद उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50009787, "chapter_id": 11430, "verse_number": "32", "content_sanskrit": "क्व यात्येको भवान् वत्स हित्वा स्वगृहमृद्धिमत्। लक्षये त्वाऽवमत्याऽङ्ग सन्तप्तं स्वजनोत्थया॥ ४/९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50009788, "chapter_id": 11430, "verse_number": "33", "content_sanskrit": "ध्रुव उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50009789, "chapter_id": 11430, "verse_number": "34", "content_sanskrit": "किं न ते ध्यानजातेन दृष्टं वा योगराधसा। नोत्सहे सुरुचेर्वाचा समाधातुं मनःक्षतम्॥ ४/९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50009790, "chapter_id": 11430, "verse_number": "35", "content_sanskrit": "नारद उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50009791, "chapter_id": 11430, "verse_number": "36", "content_sanskrit": "नाधुनाऽप्यवमानं ते सन्मानं चापि पुत्रक। लक्षयामः कुमारस्य सक्तस्य क्राडनादिषु॥ ४/९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50009792, "chapter_id": 11430, "verse_number": "37", "content_sanskrit": "विकल्पे विद्यमानेऽपि न ह्यसन्तोषहेतवः। पुंसो मोहमृते भिन्ना यल्लोका निजकर्मभिः॥ ४/९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50009793, "chapter_id": 11430, "verse_number": "38", "content_sanskrit": "परितुष्येत् ततस्तात तावन्मात्रेण पूरुषः। दैवोपसादितं यावद् वीक्ष्येश्वरगतिं बुधः॥ ४/९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50009794, "chapter_id": 11430, "verse_number": "39", "content_sanskrit": "अथ मात्रोपदिष्टेन योगेनावरुरुत्ससि। यत्प्रसादात् स वै पुंसां दुराराध्यो मतो मम॥ ४/९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50009795, "chapter_id": 11430, "verse_number": "40", "content_sanskrit": "मुनयः पदवीं यस्य निःसङ्गेनोरुजन्मभिः। न विदुर्मृगयन्तोऽपि तीव्रयोगसमाधिना॥ ४/९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50009796, "chapter_id": 11430, "verse_number": "41", "content_sanskrit": "अतो निवर्ततामेष निर्बन्धस्तव निष्फलः। यतिष्यति भवान् काले श्रेयसे समुपस्थिते॥ ४/९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50009797, "chapter_id": 11430, "verse_number": "42", "content_sanskrit": "यस्य यद् दैवविहितं स तेन सुखदुःखयोः। आत्मानं तोषयन् देही तमसः पारमृच्छति॥ ४/९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50009798, "chapter_id": 11430, "verse_number": "43", "content_sanskrit": "गुणाधिकान्मुदं लिप्सेदनुक्रोशं गुणाधमात्। मैत्रीं समानादन्विच्छेन्न तापैरभिभूयते॥ ४/९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50009799, "chapter_id": 11430, "verse_number": "44", "content_sanskrit": "ध्रुव उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50009800, "chapter_id": 11430, "verse_number": "45", "content_sanskrit": "सोऽयं शमो भगवता सुखदुःखहतात्मनाम्। दर्शितः कृपया पुंसां दुर्दर्शोऽस्मद्विधैस्तु यः॥ ४/९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50009801, "chapter_id": 11430, "verse_number": "46", "content_sanskrit": "अथापि मेऽविनीतस्य क्षात्रं घोरमुपेयुषः। सुरुच्या दुर्वचोबाणैर्न भिन्ने श्रयते हृदि॥ ४/९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50009802, "chapter_id": 11430, "verse_number": "47", "content_sanskrit": "पदं त्रिभुवनोत्कृष्टं जिगीषोः साधुवर्त्म मे। ब्रूह्यस्मत्पितृभिर्ब्रह्मन्नन्यैरप्यनधिष्ठितम्॥ ४/९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50009803, "chapter_id": 11430, "verse_number": "48", "content_sanskrit": "नूनं भवान् भगवतो योऽङ्गजः परमेष्ठिनः। वितुदन्नटते वीणां हितार्थं जगतोऽर्कवत्॥ ४/९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50009804, "chapter_id": 11430, "verse_number": "49", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50009805, "chapter_id": 11430, "verse_number": "50", "content_sanskrit": "इत्युदीरितमाकर्ण्य भगवान् नारदस्तदा। प्रीतः प्रत्याह तं बालं सद्वाक्यमनुकम्पया॥ ४/९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50009806, "chapter_id": 11430, "verse_number": "51", "content_sanskrit": "नारद उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50009807, "chapter_id": 11430, "verse_number": "52", "content_sanskrit": "जनन्याऽभिहितः पन्थाः स वै निःश्रेयसस्य ते। भगवान् वासुदेवस्तु भज तं प्रवणात्मना॥ ४/९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50009808, "chapter_id": 11430, "verse_number": "53", "content_sanskrit": "धर्मार्थकाममोक्षाख्यं य इच्छेच्छेरय आत्मनः। एकं ह्येव हरेस्तत्र कारणं पादसेवनम्॥ ४/९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50009809, "chapter_id": 11430, "verse_number": "54", "content_sanskrit": "तत् तात गच्छ भद्रं ते यमुनायास्तटं शुचि। पुण्यं मधुवनं यत्र सान्निध्यं नित्यदा हरेः॥ ४/९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50009810, "chapter_id": 11430, "verse_number": "55", "content_sanskrit": "स्नात्वाऽनुसवनं तस्मिन् काळिन्द्याः सलिले शिवे। कृत्वोचितानि निवसन्नात्मनः कल्पितासनः॥ ४/९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50009811, "chapter_id": 11430, "verse_number": "56", "content_sanskrit": "प्राणायामेन त्रिवृता प्राणेन्द्रियमनोमलम्। शनैर्व्युदस्याभिध्यायेन्मनसा गुरूणां गुरुम्॥ ४/९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50009812, "chapter_id": 11430, "verse_number": "57", "content_sanskrit": "प्रसादाभिमुखं शश्वत्प्रसन्नवदनेक्षणम्। सुनासं सुभ्रुवं चारुकपोलं सुन्दरं हरिम्॥ ४/९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50009813, "chapter_id": 11430, "verse_number": "58", "content_sanskrit": "तरुणं रमणीयाङ्गमरुणाम्बुरुहेक्षणम्। प्रणताश्रयणं कृष्णं शरण्यं करुणार्णवम्॥ ४/९/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50009814, "chapter_id": 11430, "verse_number": "59", "content_sanskrit": "श्रीवत्साङ्कं घनश्यामं पुरुषं वनमालिनम्। शङ्खचक्रगदापदम्‚रभिव्यक्तचतुर्भुजम्॥ ४/९/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50009815, "chapter_id": 11430, "verse_number": "60", "content_sanskrit": "किरीटिनं कुण्डलिनं केयूरवलयान्वितम्। कौस्तुभाभरणग्रीवं पीतकौशेयवाससम्॥ ४/९/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 50009816, "chapter_id": 11430, "verse_number": "61", "content_sanskrit": "काञ्चीकलापपर्यस्तं लसत्काञ्चननूपुरम्। दर्शनीयतमं शान्तं मनोनयनवर्धनम्॥ ४/९/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 50009817, "chapter_id": 11430, "verse_number": "62", "content_sanskrit": "पद्भ्यां नखमणिश्रेण्या विलसद्भ्यां समर्चताम्। हृत्पदम्कर्णिकाधिष्ण्यमाक्रम्यात्मन्यवस्थितम्॥ ४/९/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 50009818, "chapter_id": 11430, "verse_number": "63", "content_sanskrit": "स्मयमानमभिध्यायेत् सानुरागावलोकनम्। नियतेनैकभूतेन मनसा वरदर्षभम्॥ ४/९/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 50009819, "chapter_id": 11430, "verse_number": "64", "content_sanskrit": "एवं भगवतो रूपं सुभद्रं ध्यायतो मनः। निर्वृत्या परया पूर्णं सम्पन्नं न निवर्तते॥ ४/९/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 50009820, "chapter_id": 11430, "verse_number": "65", "content_sanskrit": "जप्यस्तु परमो गुह्यः श्रूयतां मे नृपात्मज। यं सप्तरात्रं प्रपठन् पुमान् पश्यति खेचरान्॥ ४/९/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 50009821, "chapter_id": 11430, "verse_number": "66", "content_sanskrit": "ॐ नमो भगवते वासुदेवायेति। मन्त्रेणानेन देवस्य कुर्याद् द्रव्यमयीं बुधः। सपर्यां विविधैर्द्रव्यैर्देशकालविभागवित्॥ ४/९/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 50009822, "chapter_id": 11430, "verse_number": "67", "content_sanskrit": "सलिलैः शुचिभिर्माल्यैर्वन्यैर्मूलफलादिभिः। शस्ताङ्कुरांशुकैश्चार्चेत् तुळस्या प्रियया प्रभुम्॥ ४/९/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 50009823, "chapter_id": 11430, "verse_number": "68", "content_sanskrit": "लब्ध्वा द्रव्यमयीमर्चां क्षित्यम्ब्वादिषु चार्चयेत्। आहृतात्मा मुनिः शान्तो यतवाङ् मितवन्यभुक्॥ ४/९/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 50009824, "chapter_id": 11430, "verse_number": "69", "content_sanskrit": "स्वेच्छावतारचरितैश्चरितं निजमायया। करिष्यत्युत्तमश्लोकस्तान् ध्यायेद् हृदयङ्गमान्॥ ४/९/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 50009825, "chapter_id": 11430, "verse_number": "70", "content_sanskrit": "परिचर्या भगवतो यावतीः पूर्वसेविताः। ता मन्त्रहृदयेनैव प्रयुञ्ज्यान्मन्त्रमूर्तये॥ ४/९/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 50009826, "chapter_id": 11430, "verse_number": "71", "content_sanskrit": "एवं कायेन मनसा वचसा च मनोगतः। परिचर्यमाणो भगवान् भक्तिमत्परिचर्यया॥ ४/९/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 50009827, "chapter_id": 11430, "verse_number": "72", "content_sanskrit": "पुंसाममायिनां सम्यग् भजतां भाववर्धनः। श्रेयो दिशत्यभिमतं यद् धर्मादिषु देहिनाम्॥ ४/९/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 50009828, "chapter_id": 11430, "verse_number": "73", "content_sanskrit": "विरक्तश्चेन्द्रियरतौ भक्तियोगेन भूयसा। तन्निरन्तरभावेन भजेताद्धा विमुक्तये॥ ४/९/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 50009829, "chapter_id": 11430, "verse_number": "74", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 50009830, "chapter_id": 11430, "verse_number": "75", "content_sanskrit": "इत्युक्तस्तं परिक्रम्य प्रणिपत्य नृपार्भकः। ययौ मधुवनं पुण्यं हरेश्चरणमर्चितुम्॥ ४/९/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 50009831, "chapter_id": 11430, "verse_number": "76", "content_sanskrit": "तपोवनं गते तस्मिन् प्रविष्टोऽन्तःपुरं मुनिः। अर्हितोऽर्हणया राज्ञा सुखासीन उवाच । तम्॥ ४/९/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 50009832, "chapter_id": 11430, "verse_number": "77", "content_sanskrit": "नारद उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 50009833, "chapter_id": 11430, "verse_number": "78", "content_sanskrit": "राजन् किं ध्यायसे दीर्घं मुखेन परिशुष्यता। किं वा न रिष्यते कामो धर्मो वाऽर्थेन संयुतः॥ ४/९/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 50009834, "chapter_id": 11430, "verse_number": "79", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 50009835, "chapter_id": 11430, "verse_number": "80", "content_sanskrit": "सुतो मे बालको ब्रह्मन् स्त्रैणेनाकरुणात्मना। निर्वासितः पञ्चवर्षः सह मात्रा महान् कविः॥ ४/९/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 50009836, "chapter_id": 11430, "verse_number": "81", "content_sanskrit": "अप्यनाथं वने ब्रह्मन् न स्मादन्त्यर्भकं वृकाः। श्रान्तं शयानं क्षुधितं परिम्लानमुखाम्बुजम्॥ ४/९/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 50009837, "chapter_id": 11430, "verse_number": "82", "content_sanskrit": "अहो मे बत दौरात्म्यं स्त्रीजितस्यावधारय। योऽङ्कं प्रेम्णाऽऽरुरुक्षन्तं नाभ्यनन्दमसत्तमः॥ ४/९/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 50009838, "chapter_id": 11430, "verse_number": "83", "content_sanskrit": "नारद उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 50009839, "chapter_id": 11430, "verse_number": "84", "content_sanskrit": "मामा शुचः स्वतनयं देवगुप्तं विशाम्पते। तत्प्रभावमविज्ञाय प्रावृङ्क्ते यद्यशो जगत्॥ ४/९/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 50009840, "chapter_id": 11430, "verse_number": "85", "content_sanskrit": "सुदुष्करं कर्म कृत्वा लोकपालैरपि प्रभुः। एष्यत्यचिरतो राजन् यशो विपुलयंस्तव॥ ४/९/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 50009841, "chapter_id": 11430, "verse_number": "86", "content_sanskrit": "मैत्रेय उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 50009842, "chapter_id": 11430, "verse_number": "87", "content_sanskrit": "इति देवर्षिणा प्रोक्तं विस्रभ्य जगतीपतिः। राज्यलक्ष्मीमनादृत्य पुत्रमेवान्वचिन्तयत्॥ ४/९/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 50009843, "chapter_id": 11430, "verse_number": "88", "content_sanskrit": "तत्राभिषिक्तः प्रयतस्तामुपोष्य विभावरीम्। समाहितः पर्यचरद् दृष्ट्याऽऽदेशेन पूरुषम्॥ ४/९/७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 50009844, "chapter_id": 11430, "verse_number": "89", "content_sanskrit": "त्रिरात्रान्तेत्रिरात्रान्ते कपित्थबदराशनः। आत्मवृत्त्यनुसारेण मासं निन्येऽर्चयन् हरिम्॥ ४/९/७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 50009845, "chapter_id": 11430, "verse_number": "90", "content_sanskrit": "द्वितीयं च तथा मासं षष्ठेषष्ठेऽर्भको दिने। तृणपर्णादिभिः शीर्णैः कृतान्नोऽभ्यर्चयद् विभुम्॥ ४/९/७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 50009846, "chapter_id": 11430, "verse_number": "91", "content_sanskrit": "तृतीयं चानयन्मासं नवमेनवमेऽहनि। अब्भक्ष उत्तमश्लोकमुपाधावत् समाधिना॥ ४/९/७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 50009847, "chapter_id": 11430, "verse_number": "92", "content_sanskrit": "चतुर्थमपि वै मासं द्वादशेद्वादशेऽहनि। वायुभक्षो जितश्वासो ध्यायन् देवमपारयत्॥ ४/९/७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 50009848, "chapter_id": 11430, "verse_number": "93", "content_sanskrit": "पञ्चमे मास्यनुप्राप्ते जितश्वासो नृपात्मजः। ध्यायन् ब्रह्म पदैकेन तस्थौ स्थाणुरिवाचलः॥ ४/९/७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 50009849, "chapter_id": 11430, "verse_number": "94", "content_sanskrit": "देवाश्चक्रुस्तपोविघ्नं त्रासयन्तः स्वमायया। सर्पेभसिंहकूष्माण्डैस्तान् नापश्यत् परं गतः॥ ४/९/८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 50009850, "chapter_id": 11430, "verse_number": "95", "content_sanskrit": "सर्वतो मन आकृष्य हृदि भूतेन्द्रियाश्रयम्। ध्यायन् भगवतो रूपं नाद्राक्षीत् किञ्चनापरम्॥ ४/९/८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 50009851, "chapter_id": 11430, "verse_number": "96", "content_sanskrit": "आधारं महदादीनां प्रधानपुरुषेश्वरम्। ब्रह्म धारयमाणस्य त्रयो लोकाश्चकम्पिरे॥ ४/९/८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 50009852, "chapter_id": 11430, "verse_number": "97", "content_sanskrit": "यदैकपादेन स पार्थिवात्मजस्तस्थौ तदङ्गुष्ठनिपीडिता मही। ननाम तत्रार्धमिभेन्द्रधिष्ठिता तरीव सव्येतरतः पदेपदे॥ ४/९/८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 50009853, "chapter_id": 11430, "verse_number": "98", "content_sanskrit": "तस्मिन्नभिध्यायति विश्वमात्मनो द्वारं निरुध्यासुमनन्यया धिया। लोका निरुच्छ्वासनिपीडिता भृशं सलोकपालाः शरणं ययुर्हरिम्॥ ४/९/८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 50009854, "chapter_id": 11430, "verse_number": "99", "content_sanskrit": "देवा ऊचुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 50009855, "chapter_id": 11430, "verse_number": "100", "content_sanskrit": "नैवं विदामो भगवन् प्राणरोधं चराचरस्याखिलसत्वधाम्नः। विधेहि तन्नो व्रजिनाद् विमोक्षं प्राप्ता वयं त्वां शरणं शरण्यम्॥ ४/९/८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 50009856, "chapter_id": 11430, "verse_number": "101", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 50009857, "chapter_id": 11430, "verse_number": "102", "content_sanskrit": "मा भैष्ट बालं तपसो दुरत्ययान्निवर्तयिष्ये प्रतियात स्वधाम। यतो हि वः प्राणनिरोध आसीदौत्तानपादिर्मयि सङ्गतात्मा॥ ४/९/८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 50009858, "chapter_id": 11430, "verse_number": "103", "content_sanskrit": "इति श्रीमद्भागवते चतुर्थस्कन्धे नवमोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]