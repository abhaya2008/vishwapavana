[{"id": 900002765, "chapter_id": 8270, "verse_number": "4.1", "content_sanskrit": "इमं विवस्वते योगं प्रोक्तवानहमव्यम् । विवस्वान्मनवे प्राह मनुरिक्ष्वाकवेऽब्रवीत् ।। १ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002766, "chapter_id": 8270, "verse_number": "4.2", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002767, "chapter_id": 8270, "verse_number": "4.3", "content_sanskrit": "एवं परम्पराप्राप्तमिमं राजर्षयो विदुः । स कालेनेह महता योगो नष्टः परन्तप ।। २ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002768, "chapter_id": 8270, "verse_number": "4.4", "content_sanskrit": "स एवायं मया तेऽद्य योगः प्रोक्तः पुरातनः । भक्तोऽसि मे सखा चेति रहस्यं ह्येतदुत्तमम् ।। ३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002769, "chapter_id": 8270, "verse_number": "4.5", "content_sanskrit": "अपरं भवतो जन्म परं जन्म विवस्वतः । कथमेतद्विजानीयां त्वमादौ प्रोक्तवानिति ।। बहूनि मे व्यतीतानि जन्मानि तव चार्जुन । तान्यहं वेद सर्वाणि न त्वं वेत्थ परन्तप ।। ५ ।।४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002770, "chapter_id": 8270, "verse_number": "4.6", "content_sanskrit": "अजोऽपि सन्नव्ययात्मा भूतानामीश्वरोऽपि सन् । प्रकृतिं स्वामधिष्ठाय सम्भवाम्यात्ममायया ।। ६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002771, "chapter_id": 8270, "verse_number": "4.7", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002772, "chapter_id": 8270, "verse_number": "4.8", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900002773, "chapter_id": 8270, "verse_number": "4.9", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900002774, "chapter_id": 8270, "verse_number": "4.10", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900002775, "chapter_id": 8270, "verse_number": "4.11", "content_sanskrit": "यदा यदा हि धर्मस्य ग्लानिर्भवति भारत । अभ्युत्थानमधर्मस्य तदाऽऽत्मानं सृजाम्यहम् ।। ७ ।। परित्राणाय साधूनां विनाशाय च दुष्कृताम् । धर्मसंस्थापनार्थाय सम्भवामि युगे युगे ।। ८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900002776, "chapter_id": 8270, "verse_number": "4.12", "content_sanskrit": "जन्म कर्म च मे दिव्यमेवं यो वेत्ति तत्त्वतः । त्यक्त्वा देहं पुनर्जन्म नैति मामेति सोऽर्जुन ।। ९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900002777, "chapter_id": 8270, "verse_number": "4.13", "content_sanskrit": "वीतरागभयक्रोधा मन्मया मामुपाश्रिताः । बहवो ज्ञानतपसा पूता मद्भावमागताः।। १० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900002778, "chapter_id": 8270, "verse_number": "4.14", "content_sanskrit": "ये यथा मां प्रपद्यन्ते तांस्तथैव भजाम्यहम् । मम वर्त्मानुवर्तन्ते मनुष्याः पार्थ सर्वशः ।। ११ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900002779, "chapter_id": 8270, "verse_number": "4.15", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900002780, "chapter_id": 8270, "verse_number": "4.16", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900002781, "chapter_id": 8270, "verse_number": "4.17", "content_sanskrit": "काङ्क्षन्तः कर्मणां सिद्धिं यजन्त इह देवताः । क्षिप्रं हि मानुषे लोके सिद्धिर्भवति कर्मजा ।। १२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900002782, "chapter_id": 8270, "verse_number": "4.18", "content_sanskrit": "चातुर्वर्ण्यं मया सृष्टं गुणकर्मविभागशः । तस्य कर्तारमपि मां विद्ध्यकर्तारमव्ययम् ।। १३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900002783, "chapter_id": 8270, "verse_number": "4.19", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900002784, "chapter_id": 8270, "verse_number": "4.20", "content_sanskrit": "न मां कर्माणि लिम्पन्ति न मे कर्मफले स्पृहा । इति मां योऽभिजानाति कर्मभिर्न स बद्ध्यते ।। १४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900002785, "chapter_id": 8270, "verse_number": "4.21", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900002786, "chapter_id": 8270, "verse_number": "4.22", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900002787, "chapter_id": 8270, "verse_number": "4.23", "content_sanskrit": "एवं ज्ञात्वा कृतं कर्म पूर्वैरपि मुमुक्षुभिः । कुरु कर्मैव तस्मात् त्वं पूर्वैः पूर्वतरं कृतम्।। १५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900002788, "chapter_id": 8270, "verse_number": "4.24", "content_sanskrit": "किं कर्म किमकर्मेति कवयोऽप्यत्र मोहिताः । तत्ते कर्म प्रवक्ष्यामि यज्ज्ञात्वा मोक्ष्यसेऽशुभात् ।। १६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900002789, "chapter_id": 8270, "verse_number": "4.25", "content_sanskrit": "कर्मणो ह्यपि बोद्धव्यं बोद्धव्यं च विकर्मणः । अकर्मणश्च बोद्धव्यं गहना कर्मणो गतिः ।। १७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900002790, "chapter_id": 8270, "verse_number": "4.26", "content_sanskrit": "कर्मण्यकर्म यः पश्येदकर्मणि च कर्म यः । स बुद्धिमान् मनुष्येषु स युक्तः कृत्स्नकर्मकृत् ।। १८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900002791, "chapter_id": 8270, "verse_number": "4.27", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900002792, "chapter_id": 8270, "verse_number": "4.28", "content_sanskrit": "यस्य सर्वे समारम्भाः कामसङ्कल्पवर्जिताः । ज्ञानाग्निदग्धकर्माणं तमाहुः पण्डितं बुधाः ।। १९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900002793, "chapter_id": 8270, "verse_number": "4.29", "content_sanskrit": "त्यक्त्वा कर्मफलाऽसङ्गं नित्यतृप्तो(ऽ)निराश्रयः । कर्मण्यभिप्रवृत्तोऽपि नैव किञ्चित् करोति सः।। २० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900002794, "chapter_id": 8270, "verse_number": "4.30", "content_sanskrit": "निराशीर्यतचित्तात्मा त्यक्तसर्वपरिग्रहः । शारीरं केवलं कर्म कुर्वन्नाऽप्नोति किल्बिषम् ।। २१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900002795, "chapter_id": 8270, "verse_number": "4.31", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900002796, "chapter_id": 8270, "verse_number": "4.32", "content_sanskrit": "यदृच्छालाभसन्तुष्टो द्वन्द्वातीतो विमत्सरः । समः सिद्धावसिद्धौ च कृत्वाऽपि न निबद्ध्यते ।। २२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900002797, "chapter_id": 8270, "verse_number": "4.33", "content_sanskrit": "गतसङ्गस्य मुक्तस्य ज्ञानावस्थितचेतसः । यज्ञायाऽचरतःकर्म समग्रं प्रविलीयते ।। २३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900002798, "chapter_id": 8270, "verse_number": "4.34", "content_sanskrit": "ब्रह्मार्पणं ब्रह्म हविर्ब्रह्माग्नौ ब्रह्मणा हुतम् । ब्रह्मैव तेन गन्तव्यं ब्रह्म कर्म समाधिना ।। २४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900002799, "chapter_id": 8270, "verse_number": "4.35", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900002800, "chapter_id": 8270, "verse_number": "4.36", "content_sanskrit": "दैवमेवापरे यज्ञं योगिनः पर्युपासते । ब्रह्माग्नावपरे यज्ञं यज्ञेनैवोपजुह्वति ।। २५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900002801, "chapter_id": 8270, "verse_number": "4.37", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900002802, "chapter_id": 8270, "verse_number": "4.38", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900002803, "chapter_id": 8270, "verse_number": "4.39", "content_sanskrit": "श्रोत्रादीनीन्द्रियाण्यन्ये संयमाग्निषु जुह्वति । शब्दादीन् विषयानन्ये इन्द्रियाग्निषु जुह्वति ।। २६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900002804, "chapter_id": 8270, "verse_number": "4.40", "content_sanskrit": "सर्वाणीन्द्रियकर्माणि प्राणकर्माणि चापरे । आत्मसंयमयोगाग्नौ जुह्वति ज्ञानदीपिते ।। २७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 900002805, "chapter_id": 8270, "verse_number": "4.41", "content_sanskrit": "द्रव्ययज्ञास्तपोयज्ञा योगयज्ञास्तथाऽपरे । स्वाध्यायज्ञानयज्ञाश्च यतयः संशितव्रताः ।। २८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 900002806, "chapter_id": 8270, "verse_number": "4.42", "content_sanskrit": "अपाने जुह्वति प्राणं प्राणेऽपानं तथाऽपरे । प्राणापानागती रुद्ध्वा प्राणायामपरायणाः ।। २९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 900002807, "chapter_id": 8270, "verse_number": "4.43", "content_sanskrit": "अपरे नियताऽहाराः प्राणान् प्राणेषु जुह्वति । सर्वेऽप्येते यज्ञविदो यज्ञक्षपितकल्मषाः ।। ३० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 900002808, "chapter_id": 8270, "verse_number": "4.44", "content_sanskrit": "यज्ञशिष्टामृतभुजो यान्ति ब्रह्म सनातनम् । नायं लोकोऽस्त्ययज्ञस्य कुतोऽन्यः कुरुसत्तम् ।। ३१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 900002809, "chapter_id": 8270, "verse_number": "4.45", "content_sanskrit": "एवं बहुविधा यज्ञा वितता ब्रह्मणो मुखे । कर्मजान् विद्धि तान् सर्वानेवं ज्ञात्वा विमोक्ष्यसे ।। ३२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 900002810, "chapter_id": 8270, "verse_number": "4.46", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 900002811, "chapter_id": 8270, "verse_number": "4.47", "content_sanskrit": "श्रेयान् द्रव्यमयाद्यज्ञाद् ज्ञानयज्ञः परन्तप । सर्वं कर्माखिलं पार्थ ज्ञाने परिसमाप्यते ।। ३३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 900002812, "chapter_id": 8270, "verse_number": "4.48", "content_sanskrit": "तद्विद्धि प्रणिपातेन परिप्रश्नेन सेवया । उपदेक्ष्यन्ति ते ज्ञानं ज्ञानिनस्तत्त्वदर्शिनः ।। ३४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 900002813, "chapter_id": 8270, "verse_number": "4.49", "content_sanskrit": "यज्ज्ञात्वा न पुनर्मोहमेवं यास्यसि पाण्डव । येन भूतान्यशेषेण द्रक्ष्यस्यात्मन्यथो मयि ।। ३५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 900002814, "chapter_id": 8270, "verse_number": "4.50", "content_sanskrit": "अपि चेदसि पापेभ्यः सर्वेभ्यः पापकृत्तमः । सर्वं ज्ञानल्पवेनैव वृजिनं सन्तरिष्यसि ।। ३६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 900002815, "chapter_id": 8270, "verse_number": "4.51", "content_sanskrit": "यथैधांसि समिद्धोऽग्निर्भस्मसात् कुरुतेऽर्जुन । ज्ञानाग्निः सर्वकर्माणि भस्मसात् कुरुते तथा ।। ३७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 900002816, "chapter_id": 8270, "verse_number": "4.52", "content_sanskrit": "न हि ज्ञानेन सदृशं पवित्रमिह विद्यते । तत्स्वयं योगसंसिद्धः कालेनाऽत्मनि विन्दति ।। ३८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 900002817, "chapter_id": 8270, "verse_number": "4.53", "content_sanskrit": "श्रद्धावान् लभते ज्ञानं मत्परः संयतेन्द्रियः । ज्ञानं लब्ध्वा परां शान्तिमचिरेणाधिगच्छति ।। ३९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 900002818, "chapter_id": 8270, "verse_number": "4.54", "content_sanskrit": "अज्ञश्चाश्रद्दधानश्च संशयात्मा विनश्यति । नायं लोकोऽस्ति न परो न सुखं संशयात्मनः ।। ४० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 900002819, "chapter_id": 8270, "verse_number": "4.55", "content_sanskrit": "योगसन्न्यस्तकर्माणं ज्ञानसञ्छिन्नसंशयम् । आत्मवन्तं न कर्माणि निबध्नन्ति धनञ्जय ।। ४१ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 900002820, "chapter_id": 8270, "verse_number": "4.56", "content_sanskrit": "तस्मादज्ञानसम्भूतं हृत्स्थं ज्ञानासिनाऽऽत्मनः । छित्वैनं संशयं योगमातिष्ठोत्तिष्ठ भारत।। ४२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]