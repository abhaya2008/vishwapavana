[{"id": 2058216, "chapter_id": 2258, "verse_number": "७-१८५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2058217, "chapter_id": 2258, "verse_number": "७-१८५-१", "content_sanskrit": "व्यासेनैवमथोक्तस्तु धर्मराजो युधिष्ठिरः।\nस्वयं कर्णवधाद्वीरो निवृत्तो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2058218, "chapter_id": 2258, "verse_number": "७-१८५-२", "content_sanskrit": "घटोत्कचे तु निहते सूतपुत्रेण ता निशाम्।\nदुःखामर्षवशं प्राप्तो धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2058219, "chapter_id": 2258, "verse_number": "७-१८५-३", "content_sanskrit": "दृष्ट्वा भीमेन महतीं वार्यमाणां चमूं तव।\nधृष्टद्युम्नमुवाचेदं कुम्भयोनिं निवारय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2058220, "chapter_id": 2258, "verse_number": "७-१८५-४", "content_sanskrit": "त्वं हि द्रोणविनाशाय समुत्पन्नो हुताशनात्।\nसशरः कवची खङ्गी धन्वी च परतापनः।\nअभिद्रव रणे हृष्टो मा च ते भीः कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2058221, "chapter_id": 2258, "verse_number": "७-१८५-५", "content_sanskrit": "जनमेजयः शिखण्डी च दौर्मुखिश्च यशोधरः।\nअभिद्रवन्तु संहृष्टाः कुम्भयोनिं समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2058222, "chapter_id": 2258, "verse_number": "७-१८५-६", "content_sanskrit": "नकुलः सहदेवश्च द्रौपदेयाः प्रभद्रकाः।\nद्रुपदश्च विराटश्च पुत्रभातृसमन्वितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2058223, "chapter_id": 2258, "verse_number": "७-१८५-७", "content_sanskrit": "सात्यकिः केकयाश्चैव पाण्डवश्च धनञ्जयः।\nअभिद्रवन्तु वेगेन कुम्भयोनिवधेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2058224, "chapter_id": 2258, "verse_number": "७-१८५-८", "content_sanskrit": "तथैव रथिनः सर्वे हस्त्यश्वं यच्च किञ्चन।\nपदाताश्च रणे द्रोणं पातयन्तु महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2058225, "chapter_id": 2258, "verse_number": "७-१८५-९", "content_sanskrit": "तथाऽऽज्ञप्तास्तु ते सर्वे पाण्डवेन महात्मना।\nअभ्यद्रवन्त वेगेन कुम्भयोनिवधेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2058226, "chapter_id": 2258, "verse_number": "७-१८५-१०", "content_sanskrit": "आगच्छतस्तान्सहसा सर्वोद्योगेन पाण्डवान्।\nप्रतिजग्राह समरे द्रोणः शस्त्रभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2058227, "chapter_id": 2258, "verse_number": "७-१८५-११", "content_sanskrit": "ततो दुर्योधनो राजा सर्वोद्योगेन पाण्डवान्।\nअभ्यद्रवत्सुसङ्क्रुद्ध इच्छन्द्रोणस्य जीवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2058228, "chapter_id": 2258, "verse_number": "७-१८५-१२", "content_sanskrit": "ततः प्रववृते युद्धं श्रान्तवाहनसैनिकम्।\nपाण्डवानां कुरूणां च गर्जतामितरेतरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2058229, "chapter_id": 2258, "verse_number": "७-१८५-१३", "content_sanskrit": "निद्रान्धास्ते महाराज परिश्रान्ताश्च संयुगे।\nनाभ्यपद्यन्त समरे काञ्चिच्चेष्टां महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2058230, "chapter_id": 2258, "verse_number": "७-१८५-१४", "content_sanskrit": "त्रियामा रजनी चैषा घोररूपा भयानका।\nसहस्रयामप्रतिमा बभूव प्राणहारिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2058231, "chapter_id": 2258, "verse_number": "७-१८५-१५", "content_sanskrit": "वध्यतां च तथा तेषां क्षतानां च विशेषतः।\nघोरा रात्रिः समाजज्ञे निद्रान्धानां विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2058232, "chapter_id": 2258, "verse_number": "७-१८५-१६", "content_sanskrit": "सर्वे ह्यासन्निरुत्साहाः क्षत्रिया दीनचेतसः।\nतव चैव परेषां च गतास्त्रा विगतेषवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2058233, "chapter_id": 2258, "verse_number": "७-१८५-१७", "content_sanskrit": "ते तदा पारयन्तश्च भ्रमन्तश्च विशेषतः।\nस्वधर्ममनुपश्यन्तो न जहुः स्वामनीकिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2058234, "chapter_id": 2258, "verse_number": "७-१८५-१८", "content_sanskrit": "अस्त्राण्यन्ये समुत्सृज्य निद्रान्धाः शेरते जनाः।\nरथेष्वन्ये गजेष्वन्ये हयेष्वन्ये च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2058235, "chapter_id": 2258, "verse_number": "७-१८५-१९", "content_sanskrit": "निद्रान्धा नो बुबुधिरे काञ्चिच्चेष्टां नराधिप।\nतानन्ये समरे योधाः प्रेषयन्ति यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2058236, "chapter_id": 2258, "verse_number": "७-१८५-२०", "content_sanskrit": "स्वप्नायमानांस्त्वपरे परानतिविचेतसः।\nआत्मानं समरे जघ्नुः स्वानेव च परानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2058237, "chapter_id": 2258, "verse_number": "७-१८५-२१", "content_sanskrit": "नानावाचो विमुञ्चन्तो निद्रान्धास्ते महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2058238, "chapter_id": 2258, "verse_number": "७-१८५-२२", "content_sanskrit": "अस्माकं च महाराज परेभ्यो बहवो जनाः।\nयोद्धव्यमिति तिष्ठन्तो निदासंरक्तलोचनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2058239, "chapter_id": 2258, "verse_number": "७-१८५-२३", "content_sanskrit": "संसर्पन्तो रणे केचिन्निद्रान्धास्ते तथापरान्।\nजघ्रुः शूरा रणे शूरांस्तस्मिंस्तमसि दारुणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2058240, "chapter_id": 2258, "verse_number": "७-१८५-२४", "content_sanskrit": "हन्यमानमथात्मावनं परैश्च बहवो जनाः।\nनाभ्यजानन्त समरे निद्रया मोहिता भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2058241, "chapter_id": 2258, "verse_number": "७-१८५-२५", "content_sanskrit": "तेषामेतादृशीं चेष्टां विज्ञाय पुरुषर्षभः।\nउवाच वाक्यं बीभत्सुरुच्चैः सन्नादयन्दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2058242, "chapter_id": 2258, "verse_number": "७-१८५-२६", "content_sanskrit": "श्रान्ता भवन्तो निद्रान्धाः सर्व एव सवाहनाः।\nतमसा च वृते सैन्ये रजसा बहुलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2058243, "chapter_id": 2258, "verse_number": "७-१८५-२७", "content_sanskrit": "ते यूयं यदि मन्यध्वमुपारमत सैनिकाः।\nनिमीलयत चात्रैव रणभूमौ मुहूर्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2058244, "chapter_id": 2258, "verse_number": "७-१८५-२८", "content_sanskrit": "ततो विनिद्रा विश्रान्ताश्चन्द्रमस्युदिते पुनः।\nसंसाधयिष्यथान्योन्यं स्वर्गाय कुरुपाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2058245, "chapter_id": 2258, "verse_number": "७-१८५-२९", "content_sanskrit": "तद्वचः सर्वधर्मज्ञा धार्मिकस्य विशाम्पते।\nअरोचयन्त सैन्यानि तथा चान्योन्यमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2058246, "chapter_id": 2258, "verse_number": "७-१८५-३०", "content_sanskrit": "चुक्रुशुः कर्णकर्णेनि तथा दुर्योधनेति च।\nउपारमत पाण्डूनां विरता हि वरूथिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2058247, "chapter_id": 2258, "verse_number": "७-१८५-३१", "content_sanskrit": "तथा विक्रोशमानस्य फल्गुनस्य ततस्ततः।\nउपारमत पाण्डूनां सेना तव च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2058248, "chapter_id": 2258, "verse_number": "७-१८५-३२", "content_sanskrit": "तामस्य वाचं देवाश्च ऋषयश्च महात्मनः।\nसर्वसैन्यानि चाक्षुद्रां प्रहृष्टाः प्रत्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2058249, "chapter_id": 2258, "verse_number": "७-१८५-३३", "content_sanskrit": "तत्सम्पूज्य वचोऽक्रूरं सर्वसैन्यानि भारत।\nमुहूर्तमस्वपन्राजञ्श्रान्तानि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2058250, "chapter_id": 2258, "verse_number": "७-१८५-३४", "content_sanskrit": "सा तु सम्प्राप्य विश्रामं ध्वजिनी तव भारत।\nसुखमाप्तवती वीरमर्जुनं प्रत्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2058251, "chapter_id": 2258, "verse_number": "७-१८५-३५", "content_sanskrit": "त्वयि वेदास्तथास्त्राणि त्वयि बुद्धिपराक्रमौ।\nधर्मस्त्वयि महाबाहो दया भूतेषु चानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2058252, "chapter_id": 2258, "verse_number": "७-१८५-३६", "content_sanskrit": "यच्चाश्वस्तास्तवेच्छामः शर्म पार्थ तदस्तु ते।\nमनसश्च प्रियानर्थान्वीर क्षिप्रमवाप्नुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2058253, "chapter_id": 2258, "verse_number": "७-१८५-३७", "content_sanskrit": "इति ते तं नरव्याघ्रं प्रशंसन्तो महारथाः।\nनिद्रया समवाक्षिप्तास्तूष्णीमासन्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2058254, "chapter_id": 2258, "verse_number": "७-१८५-३८", "content_sanskrit": "`वीरा वारणकुम्भेषु सुषुपुर्युद्धकर्शिताः।\nरात्रौ रतिपरिश्रान्ताः कामिनीनां कुचेष्विव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2058255, "chapter_id": 2258, "verse_number": "७-१८५-३९", "content_sanskrit": "अश्वपृष्ठेषु चाप्यन्ये रथनीडेषु चापरे।\nगजस्कन्धगताश्चान्ये शेरते चापरे क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2058256, "chapter_id": 2258, "verse_number": "७-१८५-४०", "content_sanskrit": "सायुधाः सगदाश्चैव सखङ्गाः सपरश्वथाः।\nसप्रासकवचाश्चान्ये नराः सुप्ताः पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2058257, "chapter_id": 2258, "verse_number": "७-१८५-४१", "content_sanskrit": "गजास्ते पन्नगाभोगैर्हस्तैर्भूरेणुगुण्ठितैः।\nनिद्रान्धा वसुधां चक्रुर्घ्राणनिः श्वासशीतलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2058258, "chapter_id": 2258, "verse_number": "७-१८५-४२", "content_sanskrit": "सुप्ताः शुशुभिरे तत्र निःश्वसन्तो महीतले।\nविकीर्णा गिरयो यद्वन्निःश्वसद्भिर्महोरगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2058259, "chapter_id": 2258, "verse_number": "७-१८५-४३", "content_sanskrit": "समां च विषमां चक्रुः खुराग्रैर्विकृतां महीम्।\nहयाः काञ्चनयोक्त्रास्ते केसरालम्बिभिर्युगैः।\nसुषुपुस्तत्र राजेन्द्र युक्ता वाहेषु सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2058260, "chapter_id": 2258, "verse_number": "७-१८५-४४", "content_sanskrit": "एवं हयाश्च नागाश्च योधाश्च भरतर्पभ।\nयुद्धाद्विरम्य सुषुपुः श्रमेण महताऽन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2058261, "chapter_id": 2258, "verse_number": "७-१८५-४५", "content_sanskrit": "तत्तथा निद्रया भग्नं तद्बभौ निःस्वनं बलम्।\nकुशलैः शिल्पिभिर्न्यस्तं पटे चित्रमिवाद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2058262, "chapter_id": 2258, "verse_number": "७-१८५-४६", "content_sanskrit": "ते क्षत्रियाः कुण्डलिनो युवानः\nपरस्परं सायकविक्षताङ्गाः।\nकुम्भेषु लीनाः सुषुपुर्गजानां\nकुचेषु लग्ना इव कामिनीनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2058263, "chapter_id": 2258, "verse_number": "७-१८५-४७", "content_sanskrit": "ततः कुमुदनाथेन कामिनीगण्डपाण्डुना।\nनेत्रानन्देन चन्द्रेण माहेन्द्री दिगलङ्कृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2058264, "chapter_id": 2258, "verse_number": "७-१८५-४८", "content_sanskrit": "दशशताक्षककुब्दरिनिःसृतः\nकिरणकेसरभासुरपिञ्जरः।\nतिमिरवारणवृथविदारणः\nसमुदियादुदयाचलकेसरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2058265, "chapter_id": 2258, "verse_number": "७-१८५-४९", "content_sanskrit": "हरवृषोत्तमगात्रसमद्युतिः\nस्मरशरासनपूर्णसमप्रभः।\nनववधृस्मितचारुमनोहरः\nप्रविसृतः कुमुदाकरबान्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2058266, "chapter_id": 2258, "verse_number": "७-१८५-५०", "content_sanskrit": "ततो मुहूर्ताद्भगवान्पुरस्ताच्छशलक्षणः।\nअरुणं दर्शयामास ग्रसञ्ज्योतिः प्रभां प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2058267, "chapter_id": 2258, "verse_number": "७-१८५-५१", "content_sanskrit": "अरुणस्य तु तस्यानु जातरूपसमप्रभम्।\nरश्मिजालं महच्चन्द्रो मन्दं मन्दमवासृजत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2058268, "chapter_id": 2258, "verse_number": "७-१८५-५२", "content_sanskrit": "उत्सारयन्तः प्रभया तमस्ते चन्द्ररश्मयः।\nपर्यगच्छञ्छनैः सर्वा दिशः खं च क्षितिं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2058269, "chapter_id": 2258, "verse_number": "७-१८५-५३", "content_sanskrit": "ततो मुहूर्ताद्भुवनं ज्योतिर्भूतमिवाभवत्।\nअप्रख्यमप्रकाशं च जगामाशु तमस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2058270, "chapter_id": 2258, "verse_number": "७-१८५-५४", "content_sanskrit": "प्रतिप्रकाशिते लोके दिवाभूते निशाकरे।\nविचेरुर्न विचेरुश्च राजन्नक्तञ्चरास्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2058271, "chapter_id": 2258, "verse_number": "७-१८५-५५", "content_sanskrit": "बोध्यमानं तु तत्सैन्यं राजंश्चन्द्रस्य रश्मिभिः।\nबुबुधे शतपत्राणां वनं सूर्यांशुभिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2058272, "chapter_id": 2258, "verse_number": "७-१८५-५६", "content_sanskrit": "यथा चन्द्रोदयोद्धूतः क्षुभितः सागरोऽभवत्।\nतथा चन्द्रोदयोद्धूतः क्षुभितश्च बलार्णवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2058273, "chapter_id": 2258, "verse_number": "७-१८५-५७", "content_sanskrit": "ततः प्रववृते युद्धं पुनरेव विशाम्पते।\nलोके लोकविनाशाय परं लोकमभीप्सताम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2058274, "chapter_id": 2258, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि द्रोणवधपर्वणि चतुर्दशरात्रियुद्धे पञ्चाशीत्यधिकशततमोऽध्यायः॥ १८५ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१८५-२८ सङ्ग्राममिति झ.पाठः॥ ५-१८५-१८५ पञ्चाशीत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]