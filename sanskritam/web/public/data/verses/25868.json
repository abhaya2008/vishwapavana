[{"id": 7005868000, "chapter_id": 25868, "verse_number": "१-५१-१", "content_sanskrit": "ब्रह्मोवाच ।\nअथातः संप्रवक्ष्यामि दानधर्ममनुत्तमम् ।\nअर्थानामुचिते पात्रे श्रद्धया प्रतिपादनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005868001, "chapter_id": 25868, "verse_number": "१-५१-२", "content_sanskrit": "दानं तु कथितं तज्ज्ञैर्भुक्तिमुक्तिफलप्रदम।\nन्यायेनोपार्जयेद्वित्तं दानभोगफलं च तत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005868002, "chapter_id": 25868, "verse_number": "१-५१-३", "content_sanskrit": "अध्यापनं याजनं च वृत्तमाहुः प्रतिग्रहम् ।\nकुसीदं कृषिवाणिज्यं क्षत्त्रवृत्तोऽथ वर्जयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005868003, "chapter_id": 25868, "verse_number": "१-५१-४", "content_sanskrit": "यद्दीयते तु पात्रेभ्यस्तद्दानं परिकीर्त्तिम्।\nनित्यं नैमित्तिकं काम्यं विमलं दानमीरितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005868004, "chapter_id": 25868, "verse_number": "१-५१-५", "content_sanskrit": "अहन्यहनि यत्किञ्चिद्दीयतेऽनुपकारिणे ।\nअनुद्दिश्य फलं तस्माद्ब्राह्मणाय तु नित्यशः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005868005, "chapter_id": 25868, "verse_number": "१-५१-६", "content_sanskrit": "यत्तु पापोपशान्त्यै च दीयते विदुषां करे ।\nनैमित्तिकं तदुद्दिष्टंदानं सद्भिरनुष्ठितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005868006, "chapter_id": 25868, "verse_number": "१-५१-७", "content_sanskrit": "अपत्यविजयैश्वर्य्यस्वर्गार्थं यत्प्रदीते।\nदानं तत्काम्यमाख्यातमृषिभिर्धर्माचिन्तकैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005868007, "chapter_id": 25868, "verse_number": "१-५१-८", "content_sanskrit": "ईश्वरप्रीणनार्थाय ब्रह्मावित्सुप्रदीयते ।\nचेतसा सत्त्वयुक्तेन दानं तद्विमलं शिवम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005868008, "chapter_id": 25868, "verse_number": "१-५१-९", "content_sanskrit": "इक्षुभिः सन्ततां भूमिं यवगोधूमशालिनीम्।\nददाति वेदविदुषे स न भूयोऽभिजायते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005868009, "chapter_id": 25868, "verse_number": "१-५१-१०", "content_sanskrit": "भूमिदानात्परं दानं न भूतं न भविष्यति ।\nविद्यां दत्त्वा ब्राह्मणाय ब्रह्मलोके महीयते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005868010, "chapter_id": 25868, "verse_number": "१-५१-११", "content_sanskrit": "दद्यादहरहस्तास्तु श्रद्धया ब्रह्मचारिणे ।\nसर्वपापविनिर्मुक्तो ब्रह्मस्थानमवाप्नुयात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005868011, "chapter_id": 25868, "verse_number": "१-५१-१२", "content_sanskrit": "वैशाख्यां पौर्णमास्यां तु ब्राह्मणान्सप्त पञ च।\nउपोष्याभ्यर्चयेद्विद्वान्मधुना तिलसर्पिषा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005868012, "chapter_id": 25868, "verse_number": "१-५१-१३", "content_sanskrit": "गन्धादिभिः समभ्यर्च्य वाचयेद्वा स्वयं वदत।\nप्रीयतां धर्मराजेति यथा मनसि वर्त्तते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005868013, "chapter_id": 25868, "verse_number": "१-५१-१४", "content_sanskrit": "यावज्जीवं कृतं पापं तत्क्षणादेव नश्यति ।\nकृष्णाजिने तिलान्कृत्वा हिरण्यमधुसर्पिषा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005868014, "chapter_id": 25868, "verse_number": "१-५१-१५", "content_sanskrit": "ददाति यस्तु विप्राय सर्वं तरति दुष्कम्।\nघृतान्नमुदकं चैव वैशाख्यां च विशेषतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005868015, "chapter_id": 25868, "verse_number": "१-५१-१६", "content_sanskrit": "निर्दिश्य धर्मराजाय विप्रेभ्यो मुच्यते भयत।\nद्वादश्यामर्चयेद्विष्णुमुपोष्याघप्रणाशनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005868016, "chapter_id": 25868, "verse_number": "१-५१-१७", "content_sanskrit": "सर्वपापविनिर्मुक्तो नरो भवति निश्चितम।\nयो हि यां देवतामिच्छेत्समाराधयितुं नरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005868017, "chapter_id": 25868, "verse_number": "१-५१-१८", "content_sanskrit": "ब्राह्मणान्पूजयेद्दत्नाद्भोजयेद्योषितः सुरान।\nसन्तानकामः सततं पूजयेद्वै पुरन्दरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005868018, "chapter_id": 25868, "verse_number": "१-५१-१९", "content_sanskrit": "ब्रह्मवर्चसकामस्तु ब्राह्मणान्ब्रह्मनशचयात्।\nआरोग्यकामोऽथ रविं धनकामो हुताशनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005868019, "chapter_id": 25868, "verse_number": "१-५१-२०", "content_sanskrit": "कर्मणां सिद्धिकामस्तु पूजयेद्वै विनायम।\nभोगकामो हि शशिनं बलकामः समीरणम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005868020, "chapter_id": 25868, "verse_number": "१-५१-२१", "content_sanskrit": "मुमुक्षुः सर्वसंसारात्प्रयत्नेनार्चयेद्धरिम।\nअकामः सर्वकामो वा पूजयेत्तु गदाधरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005868021, "chapter_id": 25868, "verse_number": "१-५१-२२", "content_sanskrit": "वारिदस्तृप्तिमाप्नोति सुखमक्षय्यमन्नदः ।\nतिलप्रदः प्रजामिष्टां दीपदश्चक्षुरुत्तमम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005868022, "chapter_id": 25868, "verse_number": "१-५१-२३", "content_sanskrit": "भूमिदः सर्वमाप्नोति दीर्घमायुर्हिरण्यदः ।\nगृहदोऽग्र्याणि वेश्मानि रूप्यदो रूपमुत्तमम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005868023, "chapter_id": 25868, "verse_number": "१-५१-२४", "content_sanskrit": "वासोदश्चान्द्रसालोक्यमश्विसालोक्यमश्वदः ।\nअनडुद्दः श्रियं पुष्टां गोदो ब्रध्नस्य विष्टपम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005868024, "chapter_id": 25868, "verse_number": "१-५१-२५", "content_sanskrit": "यानशय्याप्रदो भार्य्यामैश्वर्य्यमभयप्रदः ।\nधान्यदः शावतं सौख्यं ब्रह्मदो ब्रह्म शाश्वतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005868025, "chapter_id": 25868, "verse_number": "१-५१-२६", "content_sanskrit": "वेदवित्सु ददज्ज्ञानं स्वर्गलोके महीयते ।\nगवां घासप्रदानेन सर्वपापैः प्रमुच्यते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005868026, "chapter_id": 25868, "verse_number": "१-५१-२७", "content_sanskrit": "इन्धनानां प्रदानेन दीप्ताग्निर्जायते र।\nऔषधं स्नेहमाहारं रोगिरोगप्रशान्तये ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005868027, "chapter_id": 25868, "verse_number": "१-५१-२८", "content_sanskrit": "ददानो रोगरहितः सुखी दीर्घायुरेव च ।\nअसिपत्रवनं मार्गं क्षुरधारासमन्वितम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005868028, "chapter_id": 25868, "verse_number": "१-५१-२९", "content_sanskrit": "तीक्ष्णा तपं च तरतिच्छत्रोपानत्प्रदो नर।\nयद्यदिष्टतमं लोके यच्चास्य दयितं गृहे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005868029, "chapter_id": 25868, "verse_number": "१-५१-३०", "content_sanskrit": "तत्तद्गुणवते देयं तदेवाक्षयमिच्छता ।\nअयेन विषुवे चैव ग्रहणे चन्द्रसूर्य्ययोः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005868030, "chapter_id": 25868, "verse_number": "१-५१-३१", "content_sanskrit": "संक्रान्त्यादिषु कालेषु दत्तं भवति चाक्म्।\nप्रयागादिषु तीर्थेषु गयायां च विशेषतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005868031, "chapter_id": 25868, "verse_number": "१-५१-३२", "content_sanskrit": "दानधर्मात्परो धर्मो भूतानां नेह विद्यत।\nस्वर्गायुर्भूतिकामेन दानं पापोपशान्तये ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005868032, "chapter_id": 25868, "verse_number": "१-५१-३३", "content_sanskrit": "दीयमानं तु यो मोहाद्गोविप्राग्निसुरेषु च ।\nनिवारयति पापात्मा तिर्य्यग्योनिं व्रजेन्नरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005868033, "chapter_id": 25868, "verse_number": "१-५१-३४", "content_sanskrit": "यस्तु दुर्भिक्षवेलायामन्नाद्यं न प्रयच्छति ।\nम्रियमाणेषु विप्रेषु ब्रह्महा स तु गर्हितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]