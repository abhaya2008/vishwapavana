[{"id": 7000579000, "chapter_id": 20579, "verse_number": "५-३८-१", "content_sanskrit": "सूत उवाच ।\nएतदाख्यानकं श्रुत्वा वात्स्यायन उदारधीः ।\nपरमं हर्षमापेदे जगाद च फणीश्वरम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000579001, "chapter_id": 20579, "verse_number": "५-३८-२", "content_sanskrit": "वात्स्यायन उवाच ।\nकथां संशृण्वते मह्यं तृप्तिर्नास्ति फणीश्वर ।\nरघुनाथस्य भक्तार्तिहारिकीर्तिकरस्य वै॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000579002, "chapter_id": 20579, "verse_number": "५-३८-३", "content_sanskrit": "धन्य आरण्यको नाम मुनिर्वेदधरः परः ।\nरघुनाथं समालोक्य देहं तत्याज नश्वरम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000579003, "chapter_id": 20579, "verse_number": "५-३८-४", "content_sanskrit": "ततो राज्ञो हयः कुत्र गतः केन नियंत्रितः ।\nकथं तत्र रमानाथ कीर्तिर्जाता फणीश्वर॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000579004, "chapter_id": 20579, "verse_number": "५-३८-५", "content_sanskrit": "सर्वं कथय मे तथ्यं सर्वज्ञोऽस्ति यतो भवान् ।\nधराधरवपुर्धारी साक्षात्तस्य स्वरूपधृक्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000579005, "chapter_id": 20579, "verse_number": "५-३८-६", "content_sanskrit": "व्यास उवाच ।\nइति वाक्यं समाकर्ण्य प्रहृष्टेनांतरात्मना ।\nउवाच रामचारित्रं तत्तद्गुणकथोदयम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000579006, "chapter_id": 20579, "verse_number": "५-३८-७", "content_sanskrit": "शेष उवाच ।\nसाधु पृच्छसि विप्रर्षे रघुनाथगुणान्मुहुः ।\nश्रुता न श्रुतवत्कृत्वा तेषु लोलुपतां दधत्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000579007, "chapter_id": 20579, "verse_number": "५-३८-८", "content_sanskrit": "ततो निरगमद्वाहः सैनिकैर्बहुभिवृतः ।\nरेवातीरे मनोज्ञे तु मुनिवृंदनिषेविते॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000579008, "chapter_id": 20579, "verse_number": "५-३८-९", "content_sanskrit": "सेनाचरास्ततः सर्वे यत्र वाहस्ततस्ततः ।\nप्रसर्पंति निरीक्षंतस्तन्मार्गं रणकोविदाः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000579009, "chapter_id": 20579, "verse_number": "५-३८-१०", "content_sanskrit": "वाजी गतोऽथ रेवाया ह्रदेऽगाधजलान्विते ।\nभाले स्वर्णभवं पत्रं धारयन्पूजितांगकः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000579010, "chapter_id": 20579, "verse_number": "५-३८-११", "content_sanskrit": "ततो जले ममज्जासौ रामचंद्र हयो वरः ।\nतदा सर्वे महाशूरास्तत्र विस्मयमागताः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000579011, "chapter_id": 20579, "verse_number": "५-३८-१२", "content_sanskrit": "तैः परस्परमेवोचे कथं हयसमागमः ।\nकोऽत्र गंता जले वाहमानेतुं तं महोदयम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000579012, "chapter_id": 20579, "verse_number": "५-३८-१३", "content_sanskrit": "इति यावत्समुद्विग्ना मंत्रयंते परस्परम् ।\nतावद्वीरशतैः सार्धमाजगाम रघोः पतिः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000579013, "chapter_id": 20579, "verse_number": "५-३८-१४", "content_sanskrit": "तान्सर्वान्विमनस्कान्स दृष्ट्वा शत्रुघ्नसंज्ञितः ।\nपप्रच्छ मेघगंभीरवाचा वीरशिरोमणिः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000579014, "chapter_id": 20579, "verse_number": "५-३८-१५", "content_sanskrit": "किं स्थितं निखिलैरद्य युष्माभिः संघशो जले ।\nकुत्राश्वो रघुनाथस्य स्वर्णपत्रेण शोभितः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000579015, "chapter_id": 20579, "verse_number": "५-३८-१६", "content_sanskrit": "जले किं विनिमग्नोऽसौ हृतो वा केन मानिना ।\nतन्मे कथयत क्षिप्रं कथं यूयं विमोहिताः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000579016, "chapter_id": 20579, "verse_number": "५-३८-१७", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाकर्ण्य राज्ञो रघुवरस्य हि ।\nकथयामासुस्ते सर्वं वीराः शूरशिरोमणिम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000579017, "chapter_id": 20579, "verse_number": "५-३८-१८", "content_sanskrit": "जना ऊचुः ।\nस्वामिन्वयं न जानीमो मुहूर्तमभवज्जले ।\nनिममज्ज ततो नायाद्धयस्तव मनोहरः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000579018, "chapter_id": 20579, "verse_number": "५-३८-१९", "content_sanskrit": "त्वमेव तत्र गत्वेमं वाहमानय वेगतः ।\nअस्माभिस्तत्र गंतव्यं त्वया सार्द्धं महामते॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000579019, "chapter_id": 20579, "verse_number": "५-३८-२०", "content_sanskrit": "इति श्रुत्वा वचस्तेषां सैनिकानां रघूद्वहः ।\nखेदं प्राप जनान्पश्यञ्जलसंतरणोद्यतान्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000579020, "chapter_id": 20579, "verse_number": "५-३८-२१", "content_sanskrit": "उवाच मंत्रिमुख्यं स किं कर्तव्यमतः परम् ।\nकथं वाहस्य संप्राप्तिर्भविष्यति वदस्व तत्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000579021, "chapter_id": 20579, "verse_number": "५-३८-२२", "content_sanskrit": "के तत्र शूराः संयोज्या जलेऽन्वेषयितुं हयम् ।\nको वा नयिष्यते वाहं केनोपायेन तद्वद॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000579022, "chapter_id": 20579, "verse_number": "५-३८-२३", "content_sanskrit": "इति राज्ञोवचः श्रुत्वा सुमतिर्मंत्रिसत्तमः ।\nउवाच समये योग्यं शत्रुघ्नं हर्षयन्निव॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000579023, "chapter_id": 20579, "verse_number": "५-३८-२४", "content_sanskrit": "स्वामिन्नस्ति तव श्रीमञ्छक्तिरद्भुतकर्मणः ।\nपातालगमने शक्तिर्जलमध्यादिह स्फुटम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000579024, "chapter_id": 20579, "verse_number": "५-३८-२५", "content_sanskrit": "अन्यच्च पुष्कलस्यापि शक्तिरस्ति महात्मनः ।\nहनूमतोऽपि रामस्य पादसेवापरस्य च॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000579025, "chapter_id": 20579, "verse_number": "५-३८-२६", "content_sanskrit": "तस्माद्यूयं त्रयो गत्वा हयमानयत ध्रुवम् ।\nयतो भवेद्वाहमेधो रघुनाथस्य धीमतः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000579026, "chapter_id": 20579, "verse_number": "५-३८-२७", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाश्रुत्य शत्रुघ्नः परवीरहा ।\nस्वयं विवेश तोयांतर्हनुमत्पुष्कलान्वितः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000579027, "chapter_id": 20579, "verse_number": "५-३८-२८", "content_sanskrit": "यावज्जलं विवेशासौ तावत्पुरमदृश्यत ।\nअनेकोद्यानशोभाढ्यममेयं पुटभेदनम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000579028, "chapter_id": 20579, "verse_number": "५-३८-२९", "content_sanskrit": "तत्र माणिक्यरचिते स्तंभे स्वर्णमये हयम् ।\nबद्धं ददर्श रामस्य स्वर्णपत्रसुशोभितम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000579029, "chapter_id": 20579, "verse_number": "५-३८-३०", "content_sanskrit": "स्त्रियस्तत्र मनोहारि रूपधारिण्य उत्तमाः ।\nसेवंते सुंदरीमेकां पर्यंके सुखमास्थिताम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000579030, "chapter_id": 20579, "verse_number": "५-३८-३१", "content_sanskrit": "तान्दृष्ट्वा ताः स्त्रियः सर्वाः प्रावोचन्स्वामिनीं प्रति ।\nएतेऽल्पवर्ष्मवयसो मांसपुष्टकलेवराः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000579031, "chapter_id": 20579, "verse_number": "५-३८-३२", "content_sanskrit": "भविष्यंति तव श्रेष्ठमाहारस्य फलं महत् ।\nएतेषां शोणितं स्वादु पुरुषाणां गतायुषाम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000579032, "chapter_id": 20579, "verse_number": "५-३८-३३", "content_sanskrit": "एतद्वचः समाकर्ण्य सेवकीनां वरांगना ।\nजहास किंचिद्वदनं नर्तयंती भ्रुवानघा॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000579033, "chapter_id": 20579, "verse_number": "५-३८-३४", "content_sanskrit": "तावत्त्रयस्ते संप्राप्ताः सन्नाहश्री विशोभिताः ।\nशिरस्त्राणानि दधतः शौर्यवीर्यसमन्विताः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000579034, "chapter_id": 20579, "verse_number": "५-३८-३५", "content_sanskrit": "ता दृष्ट्वा महिलास्तत्र सौंदर्यश्रीसमन्विताः ।\nप्रोचुस्ते विस्मयं विप्र किमिदं दृश्यते महत्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000579035, "chapter_id": 20579, "verse_number": "५-३८-३६", "content_sanskrit": "नमश्चक्रुर्महात्मानः सर्वे देववरांगनाः ।\nकिरीटमणिविद्योतद्योतितांघ्रियुगास्ततः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000579036, "chapter_id": 20579, "verse_number": "५-३८-३७", "content_sanskrit": "सा तान्पप्रच्छ पुरुषान्सर्वश्रेष्ठा तु भामिनी ।\nके यूयमत्र संप्राप्ताः कथं चापधरा नराः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000579037, "chapter_id": 20579, "verse_number": "५-३८-३८", "content_sanskrit": "मत्स्थलं सर्वदेवानामगम्यं मोहनं महत् ।\nअत्र प्राप्तस्य तु क्वापि निवृत्तिर्न भवत्युत॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000579038, "chapter_id": 20579, "verse_number": "५-३८-३९", "content_sanskrit": "अश्वोऽयं कस्य राज्ञो वै कथं चामरवीजितः ।\nस्वर्णपत्रेण शोभाढ्यः कथयंतु ममाग्रतः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000579039, "chapter_id": 20579, "verse_number": "५-३८-४०", "content_sanskrit": "शेष उवाच ।\nइति तस्या वचः श्रुत्वा मोहनाचारसंयुतम् ।\nहनूमांस्तां प्रत्युवाच गतभीः प्रहसन्निव॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000579040, "chapter_id": 20579, "verse_number": "५-३८-४१", "content_sanskrit": "वयं वै किंकरा राज्ञस्त्रैलोक्यस्य शिखामणेः ।\nत्रिलोकीयं प्रणमते सर्वदेवशिरोमणिम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000579041, "chapter_id": 20579, "verse_number": "५-३८-४२", "content_sanskrit": "रामभद्रस्य जानीहि हयमेधप्रवर्तितुः ।\nप्रमुंच वाहमस्माकं कथं बद्धो वराङ्गने॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000579042, "chapter_id": 20579, "verse_number": "५-३८-४३", "content_sanskrit": "वयं सर्वास्त्रकुशलाः सर्वशस्त्रास्त्रकोविदाः ।\nनयिष्यामो बलाद्वाहं हत्वा तत्प्रतिरोधकान्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000579043, "chapter_id": 20579, "verse_number": "५-३८-४४", "content_sanskrit": "इति वाक्यं समाकर्ण्य प्लवङ्गस्य वराङ्गना ।\nविवरस्था प्रत्युवाच हसंती वाक्यकोविदा॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000579044, "chapter_id": 20579, "verse_number": "५-३८-४५", "content_sanskrit": "मयानीतमिमं वाहं न कोमोचयितुं क्षमः ।\nवर्षायुतेन निशितैर्बाणकोटिभिरुच्छिखैः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000579045, "chapter_id": 20579, "verse_number": "५-३८-४६", "content_sanskrit": "परं रामस्य पादाब्जसैवकी कर्मकारिणी ।\nन ग्रहीष्यामि तद्वाहं राजराजस्य धीमतः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000579046, "chapter_id": 20579, "verse_number": "५-३८-४७", "content_sanskrit": "महान विनयो जातो मम नेत्र्याः सुवाजिनः ।\nक्षमताद्रामचंद्रस्तच्छरण्यो भक्तवत्सलः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000579047, "chapter_id": 20579, "verse_number": "५-३८-४८", "content_sanskrit": "यूयं क्लिष्टास्तत्पुरुषा हयार्थं तस्य रक्षितुः ।\nयाचध्वं वरमप्राप्यं देवानामपि सत्तमाः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000579048, "chapter_id": 20579, "verse_number": "५-३८-४९", "content_sanskrit": "यथा मेमीवमत्युग्रं क्षमेत पुरुषोत्तमः ।\nव्रीडां त्यक्त्वाखिलां यूयं वृणुध्वं वरमुत्तमम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000579049, "chapter_id": 20579, "verse_number": "५-३८-५०", "content_sanskrit": "तस्या वचः परं श्रुत्वा हनूमान्नि जगाद ताम् ।\nरघुनाथप्रसादेन सर्वमस्माकमूर्जितम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000579050, "chapter_id": 20579, "verse_number": "५-३८-५१", "content_sanskrit": "तथापि याचे वरमेकमुत्तमं ।\nविधेहि तन्मे मनसः समीहितम् ।\nभवे भवे नो रघुनायकः पति ।\nर्वयं च तत्कर्मकराश्च किंकराः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000579051, "chapter_id": 20579, "verse_number": "५-३८-५२", "content_sanskrit": "एतद्वचनमाकर्ण्य प्लवगस्य तदांगना ।\nउवाच वाक्यं मधुरं प्रहस्य गुणपूजितम्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000579052, "chapter_id": 20579, "verse_number": "५-३८-५३", "content_sanskrit": "भवद्भिः प्रार्थितं यद्वै दुर्ल्लभं सर्वदैवतैः ।\nतद्भविष्यत्यसंदेहः सेवकास्तद्रघोः पतेः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000579053, "chapter_id": 20579, "verse_number": "५-३८-५४", "content_sanskrit": "अथापि वरमेकं वै दास्यामि कृतहेलना ।\nरघुनाथस्य तुष्ट्यर्थं तदृतं मे भवेद्वचः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000579054, "chapter_id": 20579, "verse_number": "५-३८-५५", "content_sanskrit": "अग्रे वीरमणिर्भूपो महावीरसमन्वितः ।\nग्रहीष्यति भवद्वाहं शिवेन परिरक्षितः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000579055, "chapter_id": 20579, "verse_number": "५-३८-५६", "content_sanskrit": "तज्जयार्थे महास्त्रं मे गृह्णीत सुमहाबलाः ।\nद्वैरथे स तु योद्धव्यः शत्रुघ्नेन त्वया महान्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000579056, "chapter_id": 20579, "verse_number": "५-३८-५७", "content_sanskrit": "इदमस्त्रं यदा त्वं तु क्षेपयिष्यसि संगरे ।\nअनेन पूतो रामस्य स्वरूपं ज्ञास्यते पुनः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000579057, "chapter_id": 20579, "verse_number": "५-३८-५८", "content_sanskrit": "ज्ञात्वा तं वाजिनं दत्वा चरणे प्रपतिष्यति ।\nतस्माद्गृह्णीध्वमस्त्रं तन्मम वैरिविदारणम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000579058, "chapter_id": 20579, "verse_number": "५-३८-५९", "content_sanskrit": "तच्छ्रुत्वा रघुनाथस्य भ्राता जग्राह चास्त्रकम् ।\nउदङ्मुखः पवित्रांगो योगिन्या दत्तमद्भुतम्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000579059, "chapter_id": 20579, "verse_number": "५-३८-६०", "content_sanskrit": "तत्प्राप्यास्त्रं महातेजा बभूव रिपुकर्शनः ।\nदुष्प्रधर्ष्यो दुराराध्यो वैरिवारणसत्सृणिः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000579060, "chapter_id": 20579, "verse_number": "५-३८-६१", "content_sanskrit": "तां नत्वा राघवश्रेष्ठः शत्रुघ्नो हयसत्तमम् ।\nगृहीत्वागाज्जलात्तस्माद्रेवातीरे सुखोचिते॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000579061, "chapter_id": 20579, "verse_number": "५-३८-६२", "content_sanskrit": "तं दृष्ट्वा सैनिकाः सर्वे प्रहृष्टांगा मुदान्विताः ।\nसाधुसाधु प्रशंसंतः पप्रच्छुर्हयनिर्गमम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000579062, "chapter_id": 20579, "verse_number": "५-३८-६३", "content_sanskrit": "हनूमान्कथयामास हयस्यागमनं महत् ।\nवरप्राप्तिं च ताभ्यो वै तेऽपि श्रुत्वा मुदं गताः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]