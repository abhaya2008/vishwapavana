[{"id": 40004479, "chapter_id": 8917, "verse_number": "1", "content_sanskrit": "प्रत्याश्वस्तो यदा राजा मोहात्प्रत्यागतं पुनः। अथाऽजुहाव तं सूतं रामवृत्तान्तकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40004480, "chapter_id": 8917, "verse_number": "2", "content_sanskrit": "अथ सूतो महाराजं कृताञ्जलिरुपस्थितः। राममेवानुशोचन्तं दुःखशोकसमन्वितम् ॥ वृद्धं परमसन्तप्तं नवग्रहमिव द्विपम्। विनिश्वसन्तं ध्यायन्तमस्वस्थ मिव कुङञरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40004481, "chapter_id": 8917, "verse_number": "3", "content_sanskrit": "अथ सूतो महाराजं कृताञ्जलिरुपस्थितः। राममेवानुशोचन्तं दुःखशोकसमन्वितम् ॥ वृद्धं परमसन्तप्तं नवग्रहमिव द्विपम्। विनिश्वसन्तं ध्यायन्तमस्वस्थ मिव कुङञरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40004482, "chapter_id": 8917, "verse_number": "4", "content_sanskrit": "राजा तु रजसा सूतं ध्वस्ताङ्गं समुपस्थितम्। अश्रुपूर्णमुखं दीनमुवाच परमार्तवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40004483, "chapter_id": 8917, "verse_number": "5", "content_sanskrit": "क्वनु वत्स्यति धर्मात्मा वृक्षमूलमुपाश्रितः। सोऽत्यन्तसुखित स्सूत किमशिष्यति राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40004484, "chapter_id": 8917, "verse_number": "6", "content_sanskrit": "दुःखस्यानुचितो दुःखं सुमन्त्र शयनोचितः। भूमिपालात्मजो भूमौ शेते कथमनाथवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40004485, "chapter_id": 8917, "verse_number": "7", "content_sanskrit": "यं यान्तमनुयान्ति स्म पदातिरथकुञ्जराः। स वत्स्यति कथं रामो विजनं वन माश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40004486, "chapter_id": 8917, "verse_number": "8", "content_sanskrit": "व्यालैर्मृगैराचरितं कृष्णसर्पनिषेवितम्। कथं कुमारौ वैदेह्या सार्धं वन मुपस्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40004487, "chapter_id": 8917, "verse_number": "9", "content_sanskrit": "सुकुमार्या तपस्विन्या सुमन्त्र सह सीतया। राजपुत्रौ कथं पादैरवरुह्य रथाद्गतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40004488, "chapter_id": 8917, "verse_number": "10", "content_sanskrit": "सिद्धार्थः खलु सूत त्वं येन दृष्टौ ममाऽत्मजौ। वनान्तं प्रविशन्तौ तावश्विनाविवमन्दरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40004489, "chapter_id": 8917, "verse_number": "11", "content_sanskrit": "किमुवाच वचो रामः किमुवाच च लक्ष्मणः। सुमन्त्र वनमासाद्य किमुवाच च मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40004490, "chapter_id": 8917, "verse_number": "12", "content_sanskrit": "आसितं शयितं भुक्तं सूत रामस्य कीर्तय। जीविष्यामहमेतेन ययातिरिव साधुषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40004491, "chapter_id": 8917, "verse_number": "13", "content_sanskrit": "इति सूतो नरेन्द्रेण बोधित स्सज्जमानया। उवाच वाचा राजानं स बाष्पपरिबद्धया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40004492, "chapter_id": 8917, "verse_number": "14", "content_sanskrit": "अब्रवीन्मां महाराज धर्ममेवानुपालयन्। अञ्जलिं राघवः कृत्वा शिरसाऽभिप्रणम्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40004493, "chapter_id": 8917, "verse_number": "15", "content_sanskrit": "सूत मद्वचनात्तस्य तातस्य विदितात्मनः। शिरसा वन्दनीयस्य वन्द्यौ पादौ महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40004494, "chapter_id": 8917, "verse_number": "16", "content_sanskrit": "सर्वमन्तःपुरं वाच्यं सूत मद्वचनात्त्वया। आरोग्यमविशेषेण यथार्हं चाभिवादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40004495, "chapter_id": 8917, "verse_number": "17", "content_sanskrit": "माता च मम कौसल्या कुशलं चाभिवादनम्। अप्रमादं च वक्तव्या ब्रूयाश्चैनामिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40004496, "chapter_id": 8917, "verse_number": "18", "content_sanskrit": "धर्मनित्या यथाकालमग्न्यगारपरा भव। देवि देवस्य पादौ च देववत्परिपालय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40004497, "chapter_id": 8917, "verse_number": "19", "content_sanskrit": "अभिमानं च मानं च त्यक्त्वा वर्तस्व मातृषु। अनु राजानमार्यां च कैकेयीमम्ब कारय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40004498, "chapter_id": 8917, "verse_number": "20", "content_sanskrit": "कुमारे भरते वृत्तिर्वर्तितव्या च राजवत्। अर्थज्येष्ठा हि राजानो राजधर्ममनुस्मर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40004499, "chapter_id": 8917, "verse_number": "21", "content_sanskrit": "भरतः कुशलं वाच्यो वाच्यो मद्वचनेन च। सर्वास्वेव यथान्यायं वृत्तिं वर्तस्व मातृषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40004500, "chapter_id": 8917, "verse_number": "22", "content_sanskrit": "वक्तव्यश्च महाबाहुरिक्ष्वाकुकुलनन्दनः। पितरं यौवराज्यस्थो राज्यस्थमनुपालय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40004501, "chapter_id": 8917, "verse_number": "23", "content_sanskrit": "अतिक्रान्तवया राजा मास्मैनं व्यवरोरुधः। कुमार राज्ये जीव त्वं तस्यैवाज्ञाप्रवर्तनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40004502, "chapter_id": 8917, "verse_number": "24", "content_sanskrit": "अब्रवीच्चापि मां भूयो भृशमश्रूणि वर्तयन्। मातेव मम माता ते द्रष्टव्या पुत्रगर्धिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40004503, "chapter_id": 8917, "verse_number": "25", "content_sanskrit": "इत्येवं मां महराज ब्रुवन्नेव महायशाः। रामो राजीवताम्राक्षो भृशमश्रूण्यवर्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40004504, "chapter_id": 8917, "verse_number": "26", "content_sanskrit": "लक्ष्मणस्तु सुसङ्कृद्धो निश्श्वसन्वाक्यमब्रवीत्। केनायमपराधेन राजपुत्रो विवासितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40004505, "chapter_id": 8917, "verse_number": "27", "content_sanskrit": "राज्ञा तु खलु कैकेय्या लघुत्वाश्रित्य शासनम्। कृतं कार्यमकार्यं वा वयं येनाभिपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40004506, "chapter_id": 8917, "verse_number": "28", "content_sanskrit": "यदि प्रव्राजितो रामो लोभकारणकारितम्। वरदाननिमित्तं वा सर्वथा दुष्कृतं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40004507, "chapter_id": 8917, "verse_number": "29", "content_sanskrit": "इदं तावद्यथाकाममीश्वरस्य कृते कृतम्। रामस्य तु परित्यागे न हेतु मुपलक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40004508, "chapter_id": 8917, "verse_number": "30", "content_sanskrit": "असमीक्षय समारब्धं विरुद्धं बुध्दिलाघवात्। जनयिष्यति सङ्क्रोशं राघवस्य विवासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40004509, "chapter_id": 8917, "verse_number": "31", "content_sanskrit": "अहं तावन्महाराजे पितृत्वं नोपलक्ष्ये। भ्राता भर्ता च बन्धुश्च पिता च मम राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40004510, "chapter_id": 8917, "verse_number": "32", "content_sanskrit": "सर्वर्लोकप्रियं त्यक्त्वा सर्वलोकहिते रतम्। सर्वलोकोऽनुरज्येत कथं त्वाऽनेनकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40004511, "chapter_id": 8917, "verse_number": "33", "content_sanskrit": "सर्वप्रजाभिरामं हि रामं प्रव्राज्य धार्मिकम्। सर्वलोकं विरुध्येमं कथं राजा भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40004512, "chapter_id": 8917, "verse_number": "34", "content_sanskrit": "जानकी तु महाराज निश्श्वसन्ती मनस्विनी। भूतोपहतचित्तेव विष्ठिता विस्मृता स्मिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40004513, "chapter_id": 8917, "verse_number": "35", "content_sanskrit": "अदृष्टपूर्वव्यसना राज्यपुत्री यशस्विनी। तेन दुःखेन रुदती नैव मां किञ्चिदब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40004514, "chapter_id": 8917, "verse_number": "36", "content_sanskrit": "उद्वीक्षमाणा भर्तारं मुखेन परिशुष्यता। मुमोच सहसा बाष्पं मां प्रयान्तमुदीक्ष्य सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40004515, "chapter_id": 8917, "verse_number": "37", "content_sanskrit": "तथैव रामोऽश्रुमुखः कृताञ्जलिः स्थितोऽभवल्लक्ष्मणबाहुपालितः। तथैव सीता रुदती तपस्विनी निरीक्षते राजरथं तथैव माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]