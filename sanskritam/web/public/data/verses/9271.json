[{"id": 40017830, "chapter_id": 9271, "verse_number": "1", "content_sanskrit": "राघवश्चापिविपुलंतंराक्षसवनौकसाम् । श्रुत्वासङ्ग्रामनिर्घोषंजाम्बवन्तमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017831, "chapter_id": 9271, "verse_number": "2", "content_sanskrit": "सौम्यनूनंहनुमताकृतंकर्मसुदुष्करम् । श्रूयते च यथाभीमस्सुमहावायुधस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017832, "chapter_id": 9271, "verse_number": "3", "content_sanskrit": "तद्गच्छकुरुसाहाय्यंस्वबलेनाभिसम्वृतः । क्षिप्रमक्षपतेतस्यकपिश्रेष्ठस्ययुध्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017833, "chapter_id": 9271, "verse_number": "4", "content_sanskrit": "ऋक्षराक्षस्तथोक्तस्तुस्वेनानीकेनसम्वृतः । आगच्छत्पश्चिमद्वारंहनूमान्यत्रवानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017834, "chapter_id": 9271, "verse_number": "5", "content_sanskrit": "अथायान्तंहनूमन्तंददर्शर्क्षपतिपथि । वानरैःकृतसङ्ग्रामैश्श्वसद्भिरभिसम्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017835, "chapter_id": 9271, "verse_number": "6", "content_sanskrit": "दृष्टापथिहनूमांश्चतदृक्षबलमुद्यतम् । नीलमेघनिभंभीमंसन्निवार्यन्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017836, "chapter_id": 9271, "verse_number": "7", "content_sanskrit": "स तेनसहसैन्येनसन्निकर्षंमहायशाः । शीघ्रमागम्यरामायदुःखितोवाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017837, "chapter_id": 9271, "verse_number": "8", "content_sanskrit": "समरेयुध्यमानानामस्माकंप्रेक्षतांपुरः । जघानरुदतींसीतामिन्द्रजिद्रावणात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017838, "chapter_id": 9271, "verse_number": "9", "content_sanskrit": "उद्भ्रान्तचित्तस्तांदृष्टवाविषण्णोऽहमरिन्दमः । तदहंभवतोवृतंविज्ञापयितुमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017839, "chapter_id": 9271, "verse_number": "10", "content_sanskrit": "तस्यतद्वचनंश्रुत्वाराघवश्शोकमूर्चितः । निपपाततदाभूमौछिन्नमूलंइवद्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017840, "chapter_id": 9271, "verse_number": "11", "content_sanskrit": "तंभूमौदेवसङ्काशंपतितंदृश्यराघवम् । अभिपेतुस्समुत्पत्यसर्वतःकपिसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017841, "chapter_id": 9271, "verse_number": "12", "content_sanskrit": "आसिञ्चन् सलिलैश्चैनंपद्मोत्पलसुगन्धिभिः । प्रदहन्तमानासाद्यंसहसाग्निमिवोद्यतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017842, "chapter_id": 9271, "verse_number": "13", "content_sanskrit": "तंलक्ष्मणोऽथबाहुभ्यांपरिष्वज्यसुदुःखितः । उवाचराममस्वस्थंवाक्यंहेत्वर्थसम्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017843, "chapter_id": 9271, "verse_number": "14", "content_sanskrit": "शुभेवर्त्मनितिष्ठन्तंत्वामार्यविजितेन्द्रियम् । अनर्थेभ्यो न शक्नोतित्रातुंधर्मोनिरर्थकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017844, "chapter_id": 9271, "verse_number": "15", "content_sanskrit": "भूतानांस्थावाराणां च जङ्गमानां च दर्शनम् । यथास्ति न तथाधर्मस्तेननास्तीतिमेमतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017845, "chapter_id": 9271, "verse_number": "16", "content_sanskrit": "यथैवस्थावरंव्यक्तंजङ्गमं न तथाविधम् । नायमर्थस्तथायुक्तस्त्वद्विधो न विपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017846, "chapter_id": 9271, "verse_number": "17", "content_sanskrit": "यद्यधर्मोभवेद्भूतोरावणोनरकंव्रजेत् । भवांश्चधर्मसम्युक्तोनैवंव्यसनमाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017847, "chapter_id": 9271, "verse_number": "18", "content_sanskrit": "तस्य च व्यसनाभावाद्व्यसनंचागतेत्वयि । धर्मोभवत्यधर्मश्चपरस्परविरोधिनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017848, "chapter_id": 9271, "verse_number": "19", "content_sanskrit": "धर्मेणोपलभेद्धर्ममधर्मंचाप्यधर्मतः । यद्यधर्मेणयुज्येयुर्येष्वधर्मःप्रतिष्ठितः ॥ यदिधर्मेणवियुज्येरन्नधर्मरुचयोजनाः । धर्मेणचरतांधर्मंचैषांधर्मफलंभवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017849, "chapter_id": 9271, "verse_number": "20", "content_sanskrit": "धर्मेणोपलभेद्धर्ममधर्मंचाप्यधर्मतः । यद्यधर्मेणयुज्येयुर्येष्वधर्मःप्रतिष्ठितः ॥ यदिधर्मेणवियुज्येरन्नधर्मरुचयोजनाः । धर्मेणचरतांधर्मंचैषांधर्मफलंभवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017850, "chapter_id": 9271, "verse_number": "21", "content_sanskrit": "यस्मादर्थाविवर्धन्तेयेष्वधर्मःप्रतिष्ठितः । क्लिश्यन्तेधर्मशीलाश्चतस्मादेतौनिरर्थकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017851, "chapter_id": 9271, "verse_number": "22", "content_sanskrit": "वध्यन्तेपापकर्माणोयद्यधर्मेणराघव । वधकर्महतोऽधर्मः स हतःकिंवधिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017852, "chapter_id": 9271, "verse_number": "23", "content_sanskrit": "अथवाविहितेनायंहन्यतेहन्तिवापरम् । विधिरालिप्यतेतेन न स पापेनकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40017853, "chapter_id": 9271, "verse_number": "24", "content_sanskrit": "अदृष्टप्रतिकारेणत्वव्यक्तेनासतासता । कथंशक्यंपरंप्राप्तुंधर्मेणारिविकर्षण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40017854, "chapter_id": 9271, "verse_number": "25", "content_sanskrit": "यदिसत्स्यात्सतांमुख्यनासत्स्यत्तवकिञ्चन । त्वयायदीदृशंप्राप्तंतस्मात्सन्नोपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40017855, "chapter_id": 9271, "verse_number": "26", "content_sanskrit": "अथवादुर्बलःक्लीबोबलंधर्मोऽनुवर्तते । दुर्बलोहृतमर्यादो न सेव्यइतिमेमतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40017856, "chapter_id": 9271, "verse_number": "27", "content_sanskrit": "बलस्ययदिचेद्धर्मोगुणभूतःपराक्रमे । धर्ममुत्सृज्यवर्तस्वयथाधर्मेतथाबले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40017857, "chapter_id": 9271, "verse_number": "28", "content_sanskrit": "अथचेत्सत्यवचनंधर्म: किलपरन्तप । अनृतस्त्वय्यकरुणःकिं न बद्धस्त्वयापिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40017858, "chapter_id": 9271, "verse_number": "29", "content_sanskrit": "यदिधर्मोभवेद्भूतअधर्मोवापरन्तप । न स्महत्वामुनिंवज्रीकुर्यादिज्यांशतक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40017859, "chapter_id": 9271, "verse_number": "30", "content_sanskrit": "अधर्मसंश्रितोधर्मोविनाशयतिराघव । सर्वमेतद्यथाकामंकाकुत्स्थकुरुतेनरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40017860, "chapter_id": 9271, "verse_number": "31", "content_sanskrit": "ममचेदंमतंतातधरोऽयमितिराघव । धर्ममूलंत्वयाछिन्नंराज्यमुत्सृजतातदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40017861, "chapter_id": 9271, "verse_number": "32", "content_sanskrit": "अर्थेभ्योहिप्रवृद्धेभ्यःसम्वृत्तेभ्यस्ततस्ततः । क्रियाःसर्वाःप्रवर्तन्तेपर्वतेभ्यःइवापगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40017862, "chapter_id": 9271, "verse_number": "33", "content_sanskrit": "अर्थेनहिविमुक्तस्यपुरुषस्याल्पचेतसः । विच्छिद्यन्तेक्रियास्सर्वाग्रीष्मेकुसरितोयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40017863, "chapter_id": 9271, "verse_number": "34", "content_sanskrit": "सोऽयमर्थंपरित्यज्यसुखकामःसुखैधितः । पापमारभतेकर्तुंतदादोषःप्रवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40017864, "chapter_id": 9271, "verse_number": "35", "content_sanskrit": "यस्यार्थास्तस्यमित्राणियस्यार्थास्यस्यबान्धवाः । यस्यार्थास्सपुमान्लोकेयस्यार्थाः स च पण्डितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40017865, "chapter_id": 9271, "verse_number": "36", "content_sanskrit": "यस्यार्थास्स च विक्रान्तोयस्यार्थास्स च बुद्धिमान् । यस्यार्थास्समहाभागोयस्यार्थास्समहागुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40017866, "chapter_id": 9271, "verse_number": "37", "content_sanskrit": "अर्थस्यैतेपरित्यागेदोषाःप्रव्याहृतामया । राज्यमुत्सृजतावीरयेनबुद्धिस्त्वयाकृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40017867, "chapter_id": 9271, "verse_number": "38", "content_sanskrit": "यस्यार्थाःधर्मकामार्थास्तस्यसर्वंप्रदक्षिणम् । अधनेनार्थकामेननार्थश्शक्योविचिन्वता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40017868, "chapter_id": 9271, "verse_number": "39", "content_sanskrit": "हर्षःकामश्चदर्पश्चधर्मःक्रोधश्शमोदमः । अर्थादेतानिसर्वाणिप्रवर्तन्तेनराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40017869, "chapter_id": 9271, "verse_number": "40", "content_sanskrit": "येषांनश्यत्ययंलोकश्चरतांधर्मचारिणाम् । तेऽर्थास्त्वयि न दृश्यन्तेदुर्दिनेषुयथाग्रहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40017870, "chapter_id": 9271, "verse_number": "41", "content_sanskrit": "त्वयिप्रव्रजितेवीरगुरोश्चवचनेस्थिते । रक्षसापहृताभार्याप्राणैःप्रियतरातव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40017871, "chapter_id": 9271, "verse_number": "42", "content_sanskrit": "तदद्यविपुलंवीरदुःखमिन्द्रजिताकृतम् । कर्मणाव्यपनेष्यामितस्मादुत्तिष्ठराघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40017872, "chapter_id": 9271, "verse_number": "43", "content_sanskrit": "उत्थिष्ठनरशार्दूलदीर्घबाहोधृतव्रत । किमात्मानंमहात्मानंमात्मानं न बुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]