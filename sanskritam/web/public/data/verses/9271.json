[{"id": 5000271000, "chapter_id": 9271, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे चतुःसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000271001, "chapter_id": 9271, "verse_number": "३-७४-१", "content_sanskrit": "तौ कबन्धेन तं मार्गं पम्पाया दर्शितं वने।\nआतस्थतुर्दिशं गृह्य प्रतीचीं नृवरात्मजौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000271002, "chapter_id": 9271, "verse_number": "३-७४-२", "content_sanskrit": "तौ शैलेष्वाचितानेकान् क्षौद्रपुष्पफलद्रुमान्।\nवीक्षन्तौ जग्मतुर्द्रष्टुं सुग्रीवं रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000271003, "chapter_id": 9271, "verse_number": "३-७४-३", "content_sanskrit": "कृत्वा तु शैलपृष्ठे तु तौ वासं रघुनन्दनौ।\nपम्पायाः पश्चिमं तीरं राघवावुपतस्थतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000271004, "chapter_id": 9271, "verse_number": "३-७४-४", "content_sanskrit": "तौ पुष्करिण्याः पम्पायास्तीरमासाद्य पश्चिमम्।\nअपश्यतां ततस्तत्र शबर्या रम्यमाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000271005, "chapter_id": 9271, "verse_number": "३-७४-५", "content_sanskrit": "तौ तमाश्रममासाद्य द्रुमैर्बहुभिरावृतम्।\nसुरम्यमभिवीक्षन्तौ शबरीमभ्युपेयतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000271006, "chapter_id": 9271, "verse_number": "३-७४-६", "content_sanskrit": "तौ दृष्ट्वा तु तदा सिद्धा समुत्थाय कृताञ्जलिः।\nपादौ जग्राह रामस्य लक्ष्मणस्य च धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000271007, "chapter_id": 9271, "verse_number": "३-७४-७", "content_sanskrit": "पाद्यमाचमनीयं च सर्वं प्रादाद् यथाविधि।\nतामुवाच ततो रामः श्रमणीं धर्मसंस्थिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000271008, "chapter_id": 9271, "verse_number": "३-७४-८", "content_sanskrit": "कच्चित्ते निर्जिता विघ्नाः कच्चित्ते वर्धते तपः।\nकच्चित्ते नियतः कोप आहारश्च तपोधने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000271009, "chapter_id": 9271, "verse_number": "३-७४-९", "content_sanskrit": "कच्चित्ते नियमाः प्राप्ताः कच्चित्ते मनसः सुखम्।\nकच्चित्ते गुरुशुश्रूषा सफला चारुभाषिणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000271010, "chapter_id": 9271, "verse_number": "३-७४-१०", "content_sanskrit": "रामेण तापसी पृष्टा सा सिद्धा सिद्धसम्मता।\nशशंस शबरी वृद्धा रामाय प्रत्यवस्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000271011, "chapter_id": 9271, "verse_number": "३-७४-११", "content_sanskrit": "अद्य प्राप्ता तपःसिद्धिस्तव संदर्शनान्मया।\nअद्य मे सफलं जन्म गुरवश्च सुपूजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000271012, "chapter_id": 9271, "verse_number": "३-७४-१२", "content_sanskrit": "अद्य मे सफलं तप्तं स्वर्गश्चैव भविष्यति।\nत्वयि देववरे राम पूजिते पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000271013, "chapter_id": 9271, "verse_number": "३-७४-१३", "content_sanskrit": "तवाहं चक्षुषा सौम्य पूता सौम्येन मानद।\nगमिष्याम्यक्षयांल्लोकांस्त्वत्प्रसादादरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000271014, "chapter_id": 9271, "verse_number": "३-७४-१४", "content_sanskrit": "चित्रकूटं त्वयि प्राप्ते विमानैरतुलप्रभैः।\nइतस्ते दिवमारूढा यानहं पर्यचारिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000271015, "chapter_id": 9271, "verse_number": "३-७४-१५", "content_sanskrit": "तैश्चाहमुक्ता धर्मज्ञैर्महाभागैर्महर्षिभिः।\nआगमिष्यति ते रामः सुपुण्यमिममाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000271016, "chapter_id": 9271, "verse_number": "३-७४-१६", "content_sanskrit": "स ते प्रतिग्रहीतव्यः सौमित्रिसहितोऽतिथिः।\nतं च दृष्ट्वा वरांल्लोकानक्षयांस्त्वं गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000271017, "chapter_id": 9271, "verse_number": "३-७४-१७", "content_sanskrit": "एवमुक्ता महाभागैस्तदाहं पुरुषर्षभ।\nमया तु संचितं वन्यं विविधं पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000271018, "chapter_id": 9271, "verse_number": "३-७४-१८", "content_sanskrit": "तवार्थे पुरुषव्याघ्र पम्पायास्तीरसम्भवम्।\nएवमुक्तः स धर्मात्मा शबर्या शबरीमिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000271019, "chapter_id": 9271, "verse_number": "३-७४-१९", "content_sanskrit": "राघवः प्राह विज्ञाने तां नित्यमबहिष्कृताम्।\nदनोः सकाशात् तत्त्वेन प्रभावं ते महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000271020, "chapter_id": 9271, "verse_number": "३-७४-२०", "content_sanskrit": "श्रुतं प्रत्यक्षमिच्छामि संद्रष्टुं यदि मन्यसे।\nएतत्तु वचनं श्रुत्वा रामवक्त्रविनिःसृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000271021, "chapter_id": 9271, "verse_number": "३-७४-२१", "content_sanskrit": "शबरी दर्शयामास तावुभौ तद्वनं महत्।\nपश्य मेघघनप्रख्यं मृगपक्षिसमाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000271022, "chapter_id": 9271, "verse_number": "३-७४-२२", "content_sanskrit": "मतङ्गवनमित्येव विश्रुतं रघुनन्दन।\nइह ते भावितात्मानो गुरवो मे महाद्युते।\nजुहवांचक्रिरे नीडं मन्त्रवन्मन्त्रपूजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000271023, "chapter_id": 9271, "verse_number": "३-७४-२३", "content_sanskrit": "इयं प्रत्यक्स्थली वेदी यत्र ते मे सुसत्कृताः।\nपुष्पोपहारं कुर्वन्ति श्रमादुद्वेपिभिः करैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000271024, "chapter_id": 9271, "verse_number": "३-७४-२४", "content_sanskrit": "तेषां तपःप्रभावेण पश्याद्यापि रघूत्तम।\nद्योतयन्ती दिशः सर्वाः श्रिया वेद्यतुलप्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000271025, "chapter_id": 9271, "verse_number": "३-७४-२५", "content_sanskrit": "अशक्नुवद्भिस्तैर्गन्तुमुपवासश्रमालसैः।\nचिन्तितेनागतान् पश्य समेतान् सप्त सागरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000271026, "chapter_id": 9271, "verse_number": "३-७४-२६", "content_sanskrit": "कृताभिषेकैस्तैर्न्यस्ता वल्कलाः पादपेष्विह।\nअद्यापि न विशुष्यन्ति प्रदेशे रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000271027, "chapter_id": 9271, "verse_number": "३-७४-२७", "content_sanskrit": "देवकार्याणि कुर्वद्भिर्यानीमानि कृतानि वै।\nपुष्पैः कुवलयैः सार्धं म्लानत्वं न तु यान्ति वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000271028, "chapter_id": 9271, "verse_number": "३-७४-२८", "content_sanskrit": "कृत्स्नं वनमिदं दृष्टं श्रोतव्यं च श्रुतं त्वया।\nतद् इच्छाम्य् अभ्यनुज्ञाता त्यक्ष्याम्य् एतत् कलेवरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000271029, "chapter_id": 9271, "verse_number": "३-७४-२९", "content_sanskrit": "तेषामिच्छाम्यहं गन्तुं समीपं भावितात्मनाम्।\nमुनीनामाश्रमो येषामहं च परिचारिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000271030, "chapter_id": 9271, "verse_number": "३-७४-३०", "content_sanskrit": "धर्मिष्ठं तु वचः श्रुत्वा राघवः सहलक्ष्मणः।\nप्रहर्षमतुलं लेभे आश्चर्यमिति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000271031, "chapter_id": 9271, "verse_number": "३-७४-३१", "content_sanskrit": "तामुवाच ततो रामः शबरीं संशितव्रताम्।\nअर्चितोऽहं त्वया भद्रे गच्छ कामं यथासुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000271032, "chapter_id": 9271, "verse_number": "३-७४-३२", "content_sanskrit": "इत्येवमुक्ता जटिला चीरकृष्णाजिनाम्बरा।\nअनुज्ञाता तु रामेण हुत्वाऽऽत्मानं हुताशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000271033, "chapter_id": 9271, "verse_number": "३-७४-३३", "content_sanskrit": "ज्वलत्पावकसंकाशा स्वर्गमेव जगाम ह।\nदिव्याभरणसंयुक्ता दिव्यमाल्यानुलेपना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000271034, "chapter_id": 9271, "verse_number": "३-७४-३४", "content_sanskrit": "दिव्याम्बरधरा तत्र बभूव प्रियदर्शना।\nविराजयन्ती तं देशं विद्युत्सौदामनी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000271035, "chapter_id": 9271, "verse_number": "३-७४-३५", "content_sanskrit": "यत्र ते सुकृतात्मानो विहरन्ति महर्षयः।\nतत् पुण्यं शबरी स्थानं जगामात्मसमाधिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000271036, "chapter_id": 9271, "verse_number": null, "content_sanskrit": "इति वाल्मीकि रामायणे आदि काव्ये अरण्यकाण्डे चतुःसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]