[{"id": 7001796000, "chapter_id": 21796, "verse_number": "२-५७-१", "content_sanskrit": "वसुरुवाच ।\nदेवान् ऋषीन्पितॄंश्चान्यान्संतर्प्याचम्य वाग्यतः ।\nहस्तमात्रं चतुष्कोणं चतुर्द्वारं सुशोभनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001796001, "chapter_id": 21796, "verse_number": "२-५७-२", "content_sanskrit": "पुरं विलिख्य विधिजेतीरे तस्य महोदधेः ।\nमध्ये तत्र लिखेत्पद्मष्टपत्रं सकर्णिकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001796002, "chapter_id": 21796, "verse_number": "२-५७-३", "content_sanskrit": "एवं मंडलमालिख्य पूजयेत्तत्र मोहिनि ।\nअष्टाक्षरविधानेन नारायणमजं विभुम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001796003, "chapter_id": 21796, "verse_number": "२-५७-४", "content_sanskrit": "अथ ते संप्रवक्ष्यामि कायशोधनमुत्तमम् ।\nक्षकारं हृदये चिंत्यं रक्तं रेफसमन्वितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001796004, "chapter_id": 21796, "verse_number": "२-५७-५", "content_sanskrit": "ज्वलंतं त्रिशिखं चैव दहंतं पापसंचयम् ।\nचंद्रमंडलमध्यस्थमेकारं मूर्ध्नि चिंतयेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001796005, "chapter_id": 21796, "verse_number": "२-५७-६", "content_sanskrit": "शुक्लवर्णं प्रवर्षंतममृतं प्लावयन्महीम् ।\nएवं निर्द्धूतपापस्तु दिव्यदेहस्ततो भवेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001796006, "chapter_id": 21796, "verse_number": "२-५७-७", "content_sanskrit": "अष्टाक्षरं ततो मंत्रं न्यसेद्देहात्मनेर्बुधः ।\nवामपादं समारभ्य क्रमशश्चैव विन्यसेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001796007, "chapter_id": 21796, "verse_number": "२-५७-८", "content_sanskrit": "पंचांगं वैष्णवं चैव चतुर्व्यूहं तथैव च ।\nकरशुद्धिं प्रकुर्वीत मूलमंत्रेण साधकः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001796008, "chapter_id": 21796, "verse_number": "२-५७-९", "content_sanskrit": "एकैकं चैव वर्णं तु अंगुलीषु पृथक् पृथक् ।\nॐकारं पृथिवी शुक्लं वामपादे तु विन्यसेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001796009, "chapter_id": 21796, "verse_number": "२-५७-१०", "content_sanskrit": "नकारस्तु भावः श्यामो दक्षिणे तु व्यवस्थितः ।\nमोकारं कालमेवाहुर्वामकट्यां निधापयेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001796010, "chapter_id": 21796, "verse_number": "२-५७-११", "content_sanskrit": "नाकारं पूर्वबीजं तु दक्षिणस्यां व्यवस्थितम् ।\nराकारस्तेज इत्याहुर्नाभिदेशे व्यवस्थितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001796011, "chapter_id": 21796, "verse_number": "२-५७-१२", "content_sanskrit": "वायव्योऽयं यकारस्तु वामस्कंधे समाश्रितः ।\nणाकारः सर्वदा ज्ञेयो दक्षिणांसे व्यवस्थितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001796012, "chapter_id": 21796, "verse_number": "२-५७-१३", "content_sanskrit": "यकारोऽयं शिरस्थश्च यत्र लोका व्यवस्थिताः ।\nॐकारं हृदये न्यस्य विकारं वा शिरस्यथ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001796013, "chapter_id": 21796, "verse_number": "२-५७-१४", "content_sanskrit": "ष्णकारं वै शिखायां तु वेकारं कवचे न्यसेत् ।\nनकारं नेत्रयोस्तु स्यान्मकारं चास्त्रमीरितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001796014, "chapter_id": 21796, "verse_number": "२-५७-१५", "content_sanskrit": "ललाटे वासुदेवस्तु शुक्लवर्णः समास्थितः ।\nरक्तः संकर्षणश्चैव मुखे वह्न्यकसन्निभः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001796015, "chapter_id": 21796, "verse_number": "२-५७-१६", "content_sanskrit": "प्रद्युम्नो हृदये पीतोऽनिरुद्धो मेहने स्थितः ।\nसर्वांगे सर्वशक्तिश्च चतुर्व्यूहार्चितो हरिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001796016, "chapter_id": 21796, "verse_number": "२-५७-१७", "content_sanskrit": "ममाग्रेऽवस्थितो विष्णुः पृष्ठतश्चापि केशवः ।\nगोविंदो दक्षिणे पार्श्वे वामे तु मधुसूदनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001796017, "chapter_id": 21796, "verse_number": "२-५७-१८", "content_sanskrit": "उपरिष्टात्तु वैंकुठो वाराहः पृथिवीतले ।\nअवांतरदिशो यास्तु तासु सर्वासु माधवः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001796018, "chapter_id": 21796, "verse_number": "२-५७-१९", "content_sanskrit": "गच्छतस्तिष्ठतो वापि जाग्रतः स्वपतोऽपि वा ।\nनरसिंहकृता गुप्तिर्वासुदेवमयो ह्यहम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001796019, "chapter_id": 21796, "verse_number": "२-५७-२०", "content_sanskrit": "एवं विष्णुमयो भूत्वा ततः कर्म समारभेत् ।\nयथा देहे तथा देवे सर्वतत्वानि योजयेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001796020, "chapter_id": 21796, "verse_number": "२-५७-२१", "content_sanskrit": "फकारांतं समुद्दिष्टं सर्वविघ्नहरं शुभम् ।\nतत्रार्कचंद्रवह्नीयनां मंडलानि विचिंतयेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001796021, "chapter_id": 21796, "verse_number": "२-५७-२२", "content_sanskrit": "पद्ममध्ये न्यसेद्विष्णुं भुवनस्यांतरस्य तु ।\nततो विचिंत्य हृदये प्रणवं ज्योतिरुत्तमम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001796022, "chapter_id": 21796, "verse_number": "२-५७-२३", "content_sanskrit": "कर्णिकायां समासीनं ज्योतीरूपं सनातनम् ।\nअष्टाक्षरं ततो मंत्रं न्यसेच्चैव यथाक्रमम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001796023, "chapter_id": 21796, "verse_number": "२-५७-२४", "content_sanskrit": "तेन व्यस्तसमस्तेन पूजनं परमं स्मृतम् ।\nद्वादशाक्षरमंत्रेण यजेद्देवं सनातनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001796024, "chapter_id": 21796, "verse_number": "२-५७-२५", "content_sanskrit": "ततोऽवधार्य हृदये कर्णिकायां बहिर्न्यसेत् ।\nचतुर्भुजं महासत्वं सूर्यकोटिसमप्रभम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001796025, "chapter_id": 21796, "verse_number": "२-५७-२६", "content_sanskrit": "चिंतयित्वा महायोगं ततश्चावाहयेत्क्रमात् ।\nमीनरूपावहश्चैव नरसिंहश्च वामनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001796026, "chapter_id": 21796, "verse_number": "२-५७-२७", "content_sanskrit": "आयांतु देवा वरदा मम नारायणाग्रतः ।\nसुमेरुः पादपीठं ते पद्मकल्पितमासनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001796027, "chapter_id": 21796, "verse_number": "२-५७-२८", "content_sanskrit": "सर्वतत्वहितार्थाय तिष्ठ त्वं मधुसूदन ।\nपाद्यं ते पादयोर्देव पद्मनाभ सनातन ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001796028, "chapter_id": 21796, "verse_number": "२-५७-२९", "content_sanskrit": "विष्णो कमलपत्राक्ष गृहाण मधुसूदन ।\nमधुपर्कं महादेव ब्रह्माद्यैः कल्पितं मया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001796029, "chapter_id": 21796, "verse_number": "२-५७-३०", "content_sanskrit": "निवेदितं च भक्त्यार्घं गृहाण पुरुषोत्तम ।\nमंदाकिन्यास्ततो वारि सर्वपापहरं शिवम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001796030, "chapter_id": 21796, "verse_number": "२-५७-३१", "content_sanskrit": "गृहाणाचमनीयं त्वं मया भक्त्या निवेदितम् ।\nत्वमापः पृथिवी चैव ज्योतिस्त्वं वायुरेव च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001796031, "chapter_id": 21796, "verse_number": "२-५७-३२", "content_sanskrit": "लोकसंधृतिमात्रेण वारिणा स्नापयाम्यहम् ।\nदेवतंतुसमायुक्ते यज्ञवर्णसमन्विते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001796032, "chapter_id": 21796, "verse_number": "२-५७-३३", "content_sanskrit": "स्वर्णवर्णप्रभे देव वाससी प्रतिगृह्यताम् ।\nशरीरं च न जानामि चेष्टां च तव केशव ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001796033, "chapter_id": 21796, "verse_number": "२-५७-३४", "content_sanskrit": "मया निवेदितं गंधं प्रतिगृह्य विलिप्यताम् ।\nऋग्यजुःसाममंत्रेण त्रिवृतं पद्मयोनिना ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001796034, "chapter_id": 21796, "verse_number": "२-५७-३५", "content_sanskrit": "सावित्रीग्रंथिसंयुक्तमुपवीतं तवार्प्यते ।\nदिव्यरत्नसमायुक्ता वह्निभानुसमप्रभाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001796035, "chapter_id": 21796, "verse_number": "२-५७-३६", "content_sanskrit": "गात्राणि शोभयिष्यंति अलंकारास्तु माधव ।\nसूर्याचंद्रसोमर्ज्योतिर्विद्युदग्न्योस्तथैव च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001796036, "chapter_id": 21796, "verse_number": "२-५७-३७", "content_sanskrit": "त्वमेव ज्योतिषां देव दीपोऽयं प्रतिगृह्यताम् ।\nवनस्पतिरसो दिव्यो गंधाढ्यः सुरभिश्च ते ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001796037, "chapter_id": 21796, "verse_number": "२-५७-३८", "content_sanskrit": "मया निवेदितो भक्त्या धूपोऽयं प्रतिगृह्यताम् ।\nअन्नं चतुर्विधं स्वादु रसैः षड्भिः समान्विताम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001796038, "chapter_id": 21796, "verse_number": "२-५७-३९", "content_sanskrit": "मया निवेदितं भक्त्या नैवेद्यं तव केशव ।\nपूर्वे दले वासुदेवं याम्ये संकीर्षणं न्यसेत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001796039, "chapter_id": 21796, "verse_number": "२-५७-४०", "content_sanskrit": "प्रद्युम्नं पश्चिमे कुर्यादनिरुद्धं तथोत्तरे ।\nवाराहं च तथाग्रेये नरसिंहं च नैर्ऋते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001796040, "chapter_id": 21796, "verse_number": "२-५७-४१", "content_sanskrit": "वायव्यां माधवं चैव तथैशाने त्रिविक्रमम् ।\nतथाष्टाक्षरदेवस्य गरुडं परितो न्यसेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001796041, "chapter_id": 21796, "verse_number": "२-५७-४२", "content_sanskrit": "वामपार्श्वे तथा चक्रं शंखं दक्षिणतो न्यसेत् ।\nतथा महागदां चैव न्यसेद्देवस्य दक्षिणे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001796042, "chapter_id": 21796, "verse_number": "२-५७-४३", "content_sanskrit": "ततः शार्ङ्गधनुर्विद्वान्न्यसेद्देवस्य वामतः ।\nदक्षिणे चेषुधी दिव्ये खङ्गं वामे च विन्यसत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001796043, "chapter_id": 21796, "verse_number": "२-५७-४४", "content_sanskrit": "श्रियं दक्षिणतः स्थाप्य पुष्टिमुत्तरतो न्यसेत् ।\nवनमालां च पुरतस्ततः श्रीवत्सकौस्तुभौ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001796044, "chapter_id": 21796, "verse_number": "२-५७-४५", "content_sanskrit": "विन्यसेद्धृदयादीनि पूर्वादिषु चतुर्ष्वपि ।\nततोऽस्त्रं देवदेवस्य कोणे चैव तु विन्यसेत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001796045, "chapter_id": 21796, "verse_number": "२-५७-४६", "content_sanskrit": "इंद्रमग्निं यमं चैव निर्ऋतिं वरुणं तथा ।\nवायुं धनदमीशानमनंतं ब्रह्मणा सह ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001796046, "chapter_id": 21796, "verse_number": "२-५७-४७", "content_sanskrit": "पूजयेत्तान्स्वकैर्मंत्रैरधश्चोर्ध्वं तथैव च ।\nएवं संपूज्य देवेशं मंडलस्थं जनार्दनम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001796047, "chapter_id": 21796, "verse_number": "२-५७-४८", "content_sanskrit": "लभेदभिमतान्कामान्नरो नास्त्यत्र संशयः ।\nअनेनैव विधानेन मंडलस्थं जनार्दनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001796048, "chapter_id": 21796, "verse_number": "२-५७-४९", "content_sanskrit": "पूजितं यस्तु पश्येत्स प्रविशेद्विष्णुमव्ययम् ।\nसकृदप्यर्चितो येन विधिनानेन केशवः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001796049, "chapter_id": 21796, "verse_number": "२-५७-५०", "content_sanskrit": "जन्ममृत्युजरास्तीर्त्वा विष्णोः पदमवाप्नुयात् ।\nयः स्मरेत्सततं भक्त्या नारायणमतंद्रितः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001796050, "chapter_id": 21796, "verse_number": "२-५७-५१", "content_sanskrit": "अन्वहं तस्य वासाय श्वेतद्वीपः प्रकीर्तितः ।\nॐकारादिसमायुक्तं नमस्कारं तदीयकम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001796051, "chapter_id": 21796, "verse_number": "२-५७-५२", "content_sanskrit": "सनाम सर्वतत्त्वानां मंत्र इत्यभिधीयते ।\nअनेनैव विधानेन गंधपुष्पं निवेदयेत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001796052, "chapter_id": 21796, "verse_number": "२-५७-५३", "content_sanskrit": "एकैकस्य प्रकुर्वीत यथोद्दिष्टं क्रमेण तु ।\nमुद्रास्ततो निबध्नीयाद्यथोक्तिक्रमवेदितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001796053, "chapter_id": 21796, "verse_number": "२-५७-५४", "content_sanskrit": "जपं चैव प्रकुवर्ति मूलमंत्रेण तत्ववित् ।\nअष्टाविंशतिमष्टौ वा शतमष्टोत्तरं तथा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001796054, "chapter_id": 21796, "verse_number": "२-५७-५५", "content_sanskrit": "काम्येषु च यथोक्तं स्याद्यथाशक्ति समाहितः ।\nपद्मं शंखं च श्रीवत्सं गदां गरुडमेव च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001796055, "chapter_id": 21796, "verse_number": "२-५७-५६", "content_sanskrit": "चक्रं खङ्गं च शार्ङ्गं च अष्टौ मुद्राः प्रकीर्तिताः ।\nगच्छ गच्छ परं स्थानं पुराणपुरुषोत्तम ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001796056, "chapter_id": 21796, "verse_number": "२-५७-५७", "content_sanskrit": "यन्न ब्रह्मादयो देवा विंदंति परमं पदम् ।\nअर्चनं ये न जानंति हरेर्मंत्रैर्यथोदितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001796057, "chapter_id": 21796, "verse_number": "२-५७-५८", "content_sanskrit": "ते त्वत्र मूलमंत्रेण पूजयंत्यच्युतं शुभे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]