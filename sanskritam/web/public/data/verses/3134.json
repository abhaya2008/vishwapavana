[{"id": 2099713, "chapter_id": 3134, "verse_number": "१३-२६४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nब्रूहि ब्राह्मणपूजायां व्युष्टिं त्वं मधुसूदन।\nवेत्ता त्वमस्य चार्थस्य वेद त्वां हि पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099714, "chapter_id": 3134, "verse_number": "१३-२६४-२x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099715, "chapter_id": 3134, "verse_number": "१३-२६४-२", "content_sanskrit": "शृणुष्वावहितो राजन्द्विजानां भरतर्षभ।\nयथातत्त्वेन वदतो गुणान्वै कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099716, "chapter_id": 3134, "verse_number": "१३-२६४-३", "content_sanskrit": "द्वारवत्यां समासीनं पुरा मां कुरुनन्दन।\nप्रद्युम्नः परिपप्रच्छ ब्राह्मणैः परिकोपितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099717, "chapter_id": 3134, "verse_number": "१३-२६४-४", "content_sanskrit": "किं फलं ब्राह्मणेष्वस्ति पूजायां मधुसूदन।\nईश्वरत्वं कुतस्तेषामिहैव च परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099718, "chapter_id": 3134, "verse_number": "१३-२६४-५", "content_sanskrit": "सदा द्विजातीन्सम्पूज्य किं फलं तत्र मानद।\nएतद्ब्रूहि स्फुटं सर्वं सुमहान्संशयोऽत्र मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099719, "chapter_id": 3134, "verse_number": "१३-२६४-६", "content_sanskrit": "इत्युक्ते वचने तस्मिन्प्रद्युम्नेन तथा त्वहम्।\nप्रत्यब्रवं महाराज यत्तच्छृणु समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099720, "chapter_id": 3134, "verse_number": "१३-२६४-७", "content_sanskrit": "व्युष्टिं ब्राह्मणपूजायां रौक्मिणेय निबोध मे।\nएते हि सोमराजान ईश्वराः सुखदुःखयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099721, "chapter_id": 3134, "verse_number": "१३-२६४-८", "content_sanskrit": "अस्मिँल्लोके रौक्मिणेय तथाऽमुष्मिंश्च पुत्रक।\nब्राह्मणप्रमुखं सौम्यं न मेऽत्रास्ति विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099722, "chapter_id": 3134, "verse_number": "१३-२६४-९", "content_sanskrit": "ब्राह्मणप्रभवं सौख्यमायुः कीर्तिर्यशो बलम्।\nलोका लोकेश्वराश्चैव सर्वे ब्राह्मणपूजकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099723, "chapter_id": 3134, "verse_number": "१३-२६४-१०", "content_sanskrit": "त्रिवर्गे चापवर्गे च यशःश्रीरोगशान्तिषु।\nदेवतापितृपूजासु सन्तोष्याश्चैव नो द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099724, "chapter_id": 3134, "verse_number": "१३-२६४-११", "content_sanskrit": "तान्कथं वै नाद्रियेयमीश्वरोस्मीति पुत्रक।\nमा ते मन्युर्महाबाहो भवत्वत्र द्विजान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099725, "chapter_id": 3134, "verse_number": "१३-२६४-१२", "content_sanskrit": "ब्राह्मणा हि महद्भूतमस्मिँल्लोके परत्र च।\nभस्म कुर्यर्जगदिदं क्रुद्धाः प्रत्यक्षदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099726, "chapter_id": 3134, "verse_number": "१३-२६४-१३", "content_sanskrit": "हन्युस्तेऽपि सृजेयुस्च लोकान्लोकेश्वरांस्तथा।\nकथं तेषु न वर्तेरन्सम्यग्ज्ञानात्सुतेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099727, "chapter_id": 3134, "verse_number": "१३-२६४-१४", "content_sanskrit": "अवसन्मद्गृहे तात ब्राह्मणो हरिपिङ्गलः।\nचीरवासा बिल्वदण्डी दीर्घश्मश्रुः कृशो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099728, "chapter_id": 3134, "verse_number": "१३-२६४-१५", "content_sanskrit": "दीर्घभ्यश्च मनुष्येभ्यः प्रमाणादधिको भुवि।\nस स्वैरं चरते लोकान्ये दिव्या ये च मानुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099729, "chapter_id": 3134, "verse_number": "१३-२६४-१६", "content_sanskrit": "इमां गाथां गायमानश्चत्वरेषु सभासु च।\nदुर्वाससं वासयेत्को ब्राह्मणं सत्कृतं गृहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099730, "chapter_id": 3134, "verse_number": "१३-२६४-१७", "content_sanskrit": "रोषणः सर्वभूतानां सूक्ष्मेऽप्यपकृते कृते।\nपरिभाषां च मे श्रुत्वा को नु दद्यात्प्रतिश्रयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099731, "chapter_id": 3134, "verse_number": "१३-२६४-१८", "content_sanskrit": "यो मां कश्चिद्वासयीत न स मां कोपयेदिति।\nयस्मान्नाद्रियते कश्चित्ततोऽहं समवासयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099732, "chapter_id": 3134, "verse_number": "१३-२६४-१९", "content_sanskrit": "स सम्भुङ्क्ते सहस्राणां बहूनामन्नमेकदा।\nएकदा सोल्पकं भुङ्क्ते नचैवैति पुनर्गृहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099733, "chapter_id": 3134, "verse_number": "१३-२६४-२०", "content_sanskrit": "अकस्माच्च प्रहसति तथाऽकस्मात्प्ररोदिति।\nन चास्य वयसा तुल्यः पृथिव्यामभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099734, "chapter_id": 3134, "verse_number": "१३-२६४-२१", "content_sanskrit": "अथ स्वावसथं गत्वा सशय्यास्तरणानि च।\nअदहत्स महातेजास्ततश्चाभ्यपतत्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099735, "chapter_id": 3134, "verse_number": "१३-२६४-२२", "content_sanskrit": "अथ मामब्रवीद्भूयः स मुनिः संशितव्रतः।\nकृष्ण पायसमिच्छामि भोक्तुमित्येव सत्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099736, "chapter_id": 3134, "verse_number": "१३-२६४-२३", "content_sanskrit": "तदैव तु मया तस्य चित्तज्ञेन गृहे जनः।\nसर्वाण्यन्नानि पानानि भक्ष्याश्चोच्चावचास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099737, "chapter_id": 3134, "verse_number": "१३-२६४-२४", "content_sanskrit": "भवन्तु सत्कृतानीह पूर्वमेव प्रयोचितः।\nततोऽहं ज्वलमानं वै पायसं प्रत्यवेदयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099738, "chapter_id": 3134, "verse_number": "१३-२६४-२५", "content_sanskrit": "तं भुक्त्वैव स तु क्षिप्रं ततो वचनमब्रवीत्।\nक्षिप्रमङ्गानि लिम्पस्व पायसेनेति स स्म ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099739, "chapter_id": 3134, "verse_number": "१३-२६४-२६", "content_sanskrit": "अविमृश्यैव च ततः कृतवानस्मि तत्तथा।\nतेनोच्छिष्टेन गात्राणि शरीरं च समालिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099740, "chapter_id": 3134, "verse_number": "१३-२६४-२७", "content_sanskrit": "स ददर्श तदाऽभ्याशे मातरं ते शुभाननाम्।\nतामपि स्मयमानां स पायसेनाभ्यलेपयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2099741, "chapter_id": 3134, "verse_number": "१३-२६४-२८", "content_sanskrit": "मुनिः पायसदिग्धाङ्गीं रथे तूर्णमयोजयत्।\nतमारुद्य रथं चैव निर्ययौ स गृहान्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2099742, "chapter_id": 3134, "verse_number": "१३-२६४-२९", "content_sanskrit": "अग्निवर्णो ज्वलन्धीमान्स द्विजो रथधुर्यवत्।\nप्रतोदेनातुदद्बालां रुक्मिणीं मम पश्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2099743, "chapter_id": 3134, "verse_number": "१३-२६४-३०", "content_sanskrit": "न च मे स्तोकमप्यासीद्दुः खमीर्ष्याकृतं तदा।\nतथा स राजमार्गेणि महता निर्ययौ बहिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2099744, "chapter_id": 3134, "verse_number": "१३-२६४-३१", "content_sanskrit": "तद्दृष्ट्वा महदाश्चर्यं दाशार्हा जातमन्यवः।\nतत्राजल्पन्मिथः केचित्समाभाष्य परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2099745, "chapter_id": 3134, "verse_number": "१३-२६४-३२", "content_sanskrit": "ब्राह्मणा एव जायेरन्नान्यो वर्णः कथञ्चन।\nको ह्येनां रथमास्थाय जीवेदन्य पुमानिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2099746, "chapter_id": 3134, "verse_number": "१३-२६४-३३", "content_sanskrit": "आशीविषविषं तीक्ष्णं ततस्तीक्ष्णतरो द्विजः।\nब्रह्माहिविषदिग्धस्य नास्ति कश्चिच्चिकित्सकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2099747, "chapter_id": 3134, "verse_number": "१३-२६४-३४", "content_sanskrit": "तस्मिन्व्रजति दुर्धर्षे प्रास्खलद्रुक्मिणी पथि।\nअमर्षयंस्तथा श्रीमान्स्मितपूर्वमचोदयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2099748, "chapter_id": 3134, "verse_number": "१३-२६४-३५", "content_sanskrit": "ततः परमसंक्रुद्धो रथात्प्रस्कन्द्य स द्विजः।\nपदातिरुत्पथेनैव प्राद्रवद्दक्षिणामुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2099749, "chapter_id": 3134, "verse_number": "१३-२६४-३६", "content_sanskrit": "तमुत्पथेन धावन्तमन्वधावं द्विजोत्तमम्।\nतथैव पायसादिग्धः प्रसीद भगवन्निति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2099750, "chapter_id": 3134, "verse_number": "१३-२६४-३७", "content_sanskrit": "ततो विलोक्य तेजस्वी ब्राह्मणो मामुवाच ह।\nजितः क्रोधस्त्वया कृष्ण प्रकृत्यैव महाभुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2099751, "chapter_id": 3134, "verse_number": "१३-२६४-३८", "content_sanskrit": "न तेऽपराधमिह वै दृष्टवानस्मि सुव्रत।\nप्रीतोस्मि तव गोविन्द वृणु कामान्यथेप्सितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2099752, "chapter_id": 3134, "verse_number": "१३-२६४-३९", "content_sanskrit": "प्रसन्नस्य च मे तात पश्य व्युष्टिं यथाविधाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2099753, "chapter_id": 3134, "verse_number": "१३-२६४-४०", "content_sanskrit": "यावदेव मनुष्याणामन्ने भावो भविष्यति।\nयथैवान्ने तथा तेषां त्वयि भावो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2099754, "chapter_id": 3134, "verse_number": "१३-२६४-४१", "content_sanskrit": "यावच्च पुण्या लोकेषु त्वयि कीर्तिर्भविष्यति।\nत्रिषु लोकेषु तावच्च वैशिष्ट्यं प्रतिपत्स्यसे।\nसुप्रियः सर्वलोकस्य भविष्यसि जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2099755, "chapter_id": 3134, "verse_number": "१३-२६४-४२", "content_sanskrit": "यत्ते भिन्नं च दग्धं च यच्च किञ्चिद्विनाशितम्।\nसर्वं तथैव द्रष्टासि विशिष्टं जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2099756, "chapter_id": 3134, "verse_number": "१३-२६४-४३", "content_sanskrit": "यावदेतत्प्रलिप्तं ते गात्रेषु मधुसूदन।\nअतो मृत्युभयं नास्ति यावदिच्छसि चाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2099757, "chapter_id": 3134, "verse_number": "१३-२६४-४४", "content_sanskrit": "न तु पादतले लिप्ते तस्मात्ते मृत्युरत्र वै।\nनैतन्मे प्रियमित्येवं स मां प्रीतोऽब्रवीत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2099758, "chapter_id": 3134, "verse_number": "१३-२६४-४५", "content_sanskrit": "इत्युक्तोऽहं शरीरं स्वं ददर्श श्रीसमायुतम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2099759, "chapter_id": 3134, "verse_number": "१३-२६४-४६", "content_sanskrit": "रुक्मिणीं चाब्रवीत्प्रीतः सर्वस्त्रीणां वरं यशः।\nकीर्तिं चानुत्तमां लोके समवाप्स्यसि शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2099760, "chapter_id": 3134, "verse_number": "१३-२६४-४७", "content_sanskrit": "न त्वां जरा वा रोगो वा वैवर्ण्यं चापि भामिनि।\nस्प्रक्ष्यन्ति पुण्यगन्धा च कृष्णमाराधयिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2099761, "chapter_id": 3134, "verse_number": "१३-२६४-४८", "content_sanskrit": "षोडशानां सहस्राणां बधूनां केशवस्य ह।\nवरिष्ठा च सलोक्या च केशवस्य भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2099762, "chapter_id": 3134, "verse_number": "१३-२६४-४९", "content_sanskrit": "तव मातरमित्युक्त्वा ततो मां पुनरब्रवीत्।\nप्रस्थितः सुमहातेजा दुर्वासाऽग्निरिव ज्वलन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2099763, "chapter_id": 3134, "verse_number": "१३-२६४-५०", "content_sanskrit": "एषैव ते बुद्धिरस्तु ब्राह्मणान्प्रति केशव।\nइत्युक्त्वा स तदा पुत्र तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2099764, "chapter_id": 3134, "verse_number": "१३-२६४-५१", "content_sanskrit": "तस्मिन्नन्तर्हिते चाहमुपांशु व्रतमाचरम्।\nयत्किञ्चिद्ब्राह्मणो ब्रूयात्सर्वं कुर्यामिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2099765, "chapter_id": 3134, "verse_number": "१३-२६४-५२", "content_sanskrit": "एतद्व्रतमहं कृत्वा मात्रा ते सह पुत्रक।\nततः परमहृष्टात्मा प्राविशं गृहमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2099766, "chapter_id": 3134, "verse_number": "१३-२६४-५३", "content_sanskrit": "प्रविष्टमात्रश्च गृहे सर्वं पश्यामि तन्नवम्।\nयद्भिन्नं यच्च वै दग्धं तेन विप्रेण पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2099767, "chapter_id": 3134, "verse_number": "१३-२६४-५४", "content_sanskrit": "ततोऽहं विस्मयं प्राप्तः सर्वं दृष्ट्वा नवं दृढम्।\nअपूजयं च मनसा रौक्मिणेय सदा द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2099768, "chapter_id": 3134, "verse_number": "१३-२६४-५५", "content_sanskrit": "इत्यहं रौक्मिणेयस्य पृच्छतो भरतर्षभ।\nमाहात्म्यं द्विजमुख्यस्य सर्वमाख्यातवांस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2099769, "chapter_id": 3134, "verse_number": "१३-२६४-५६", "content_sanskrit": "तथा त्वमपि कौन्तेय ब्राह्मणान्सततं प्रभो।\nपूजयस्व महाभागान्वाग्भिर्दानैश्च नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2099770, "chapter_id": 3134, "verse_number": "१३-२६४-५७", "content_sanskrit": "एवं व्युष्टिमहं प्राप्तो ब्राह्मणस्य प्रसादजाम्।\nयच्च मामाह भीष्मोऽयं तत्सत्यं भरतर्षभ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2099771, "chapter_id": 3134, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुःषष्ट्यधिकद्विशततमोऽध्यायः॥ २६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]