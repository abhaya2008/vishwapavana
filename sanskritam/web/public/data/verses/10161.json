[{"id": 6000161000, "chapter_id": 10161, "verse_number": null, "content_sanskrit": "अथ अष्टमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000161001, "chapter_id": 10161, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.001.m4a", "display_order": 2}, {"id": 6000161002, "chapter_id": 10161, "verse_number": "८-८-१", "content_sanskrit": "पीते गरे वृषाङ्केण प्रीतास्तेऽमरदानवाः।\nममन्थुस्तरसा सिन्धुं हविर्धानी ततोऽभवत्॥ ८/८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.002.m4a", "display_order": 3, "topics": [{"text": "कामधेन्वाद्युत्पत्तिः", "range": "१–६"}]}, {"id": 6000161003, "chapter_id": 10161, "verse_number": "८-८-२", "content_sanskrit": "तामग्निहोत्रीमृषयो जगृहुर्ब्रह्मवादिनः।\nयज्ञस्य देवपानस्य मेध्याय हविषे नृप॥ ८/८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.003.m4a", "display_order": 4}, {"id": 6000161004, "chapter_id": 10161, "verse_number": "८-८-३", "content_sanskrit": "तत उच्चैःश्रवा नाम हयोऽभूच्चन्द्रपाण्डुरः।\nतस्मिन् बलिः स्पृहां चक्रे नेन्द्र ईश्वरशिक्षया॥ ८/८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.004.m4a", "display_order": 5}, {"id": 6000161005, "chapter_id": 10161, "verse_number": "८-८-४", "content_sanskrit": "तत ऐरावतो नाम वारणेन्द्रो विनिर्गतः।\nदन्तैश्चतुर्भिः श्वेताद्रेर्हरन्भगवतो महम्॥ ८/८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.005.m4a", "display_order": 6}, {"id": 6000161006, "chapter_id": 10161, "verse_number": "८-८-५", "content_sanskrit": "ततोऽभवत् पारिजातः सुरलोकविभूषणः।\nपूरयत्यर्थिनो योऽर्थैः शश्वद् भुवि यथा भवान्॥ ८/८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.006.m4a", "display_order": 7}, {"id": 6000161007, "chapter_id": 10161, "verse_number": "८-८-६", "content_sanskrit": "ततश्चाप्सरसो जाता निष्ककण्ठ्यः सुवाससः।\nरमण्यः स्वर्गिणां वल्गुगतिलीलावलोकनैः॥ ८/८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.007.m4a", "display_order": 8}, {"id": 6000161008, "chapter_id": 10161, "verse_number": "८-८-७", "content_sanskrit": "ततश्चाऽविरभूत् साक्षाच्छ्रीरमा भगवत्प्रिया।\nरञ्जयन्ती दिशः कान्त्या विद्युत्सौदामनी यथा॥ ८/८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.008.m4a", "display_order": 9, "topics": [{"text": "महालक्ष्म्युत्पत्तिः तया इतरान्सर्वान्देवान् दोषिणो विज्ञाय निर्दोषस्य भगवतो वरणं च", "range": "७–२९"}]}, {"id": 6000161009, "chapter_id": 10161, "verse_number": "८-८-८", "content_sanskrit": "तस्यां चक्रुः स्पृहां सर्वे ससुरासुरमानवाः।\nरूपौदार्यवयोवर्णमहिमाक्षिप्तचेतसः॥ ८/८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.009.m4a", "display_order": 10}, {"id": 6000161010, "chapter_id": 10161, "verse_number": "८-८-९", "content_sanskrit": "तस्याश्चासनमानिन्ये महेन्द्रो महदद्भुतम्।\nमूर्तिमत्यः सरिच्छ्रेष्ठा हेमकुम्भैर्जलं शुचि॥ ८/८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.010.m4a", "display_order": 11}, {"id": 6000161011, "chapter_id": 10161, "verse_number": "८-८-१०", "content_sanskrit": "अभिषेचनिका भूमिराहरत् सकलौषधीः।\nगावः पञ्च पवित्राणि वसन्तो मधु माधवम्॥ ८/८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.011.m4a", "display_order": 12}, {"id": 6000161012, "chapter_id": 10161, "verse_number": "८-८-११", "content_sanskrit": "ऋषयः कल्पयाञ्चक्रुरभिषेकं यथाविधि।\nजगुर्भद्राणि गन्धर्वा नार्यश्च ननृतुर्जगुः॥ ८/८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.012.m4a", "display_order": 13}, {"id": 6000161013, "chapter_id": 10161, "verse_number": "८-८-१२", "content_sanskrit": "मेघा मृदङ्गपणवमुरजानकगोमुखान्।\nव्यनादयन् शङ्खवेणुवीणातुमुलनिःस्वनान्॥ ८/८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.013.m4a", "display_order": 14}, {"id": 6000161014, "chapter_id": 10161, "verse_number": "८-८-१३", "content_sanskrit": "ततोऽभिषिषिचुर्देवीं श्रियं पद्मकरां सतीम्।\nदिगिभाः पूर्णकलशैः सूक्तवाकैर्द्विजेरितैः॥ ८/८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.014.m4a", "display_order": 15}, {"id": 6000161015, "chapter_id": 10161, "verse_number": "८-८-१४", "content_sanskrit": "समुद्रः पीतकौशेयवाससी समुपाहरत्।\nवरुणः स्रजं वैजयन्तीं मधुना मत्तषट्‌पदाम्॥ ८/८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.015.m4a", "display_order": 16}, {"id": 6000161016, "chapter_id": 10161, "verse_number": "८-८-१५", "content_sanskrit": "भूषणानि विचित्राणि विश्वकर्मा प्रजापतिः।\nहारं सरस्वती पद्ममजो नागाश्च कुण्डले॥ ८/८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.016.m4a", "display_order": 17}, {"id": 6000161017, "chapter_id": 10161, "verse_number": "८-८-१६", "content_sanskrit": "ततः कृतस्वस्त्ययनोत्पलस्रजं नदद्द्विरेफां परिगृह्य पाणिना।\nचचाल वक्त्रं सुकपोलकुण्डलं सव्रीडहासं दधती सुशोभनम्॥ ८/८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.017.m4a", "display_order": 18}, {"id": 6000161018, "chapter_id": 10161, "verse_number": "८-८-१७", "content_sanskrit": "स्तनद्वयं चातिकृशोदरी समं निरन्तरं चन्दनकुङ्कुमोक्षितम्।\nततस्ततो नूपुरवल्गुसिञ्जितैर्विसर्पती हेमलतेव सा बभौ॥ ८/८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.018.m4a", "display_order": 19}, {"id": 6000161019, "chapter_id": 10161, "verse_number": "८-८-१८", "content_sanskrit": "विलोकयन्ती निरवद्यमात्मनः पदं ध्रुवं चाव्यभिचारिसद्गुणम्।\nगन्धर्वयक्षासुरसिद्धचारणत्रैविष्टपेयादिषु नान्वविन्दत॥ ८/८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.019.m4a", "display_order": 20}, {"id": 6000161020, "chapter_id": 10161, "verse_number": "८-८-१९", "content_sanskrit": "नूनं तपो यस्य न मन्युनिर्जयो ज्ञानं क्‍वचित् तच्च न सङ्गवर्जितम्।\nकश्चिन्महांस्तस्य न कामनिर्जयः स ईश्वरः किं परतो व्यपाश्रयः॥ ८/८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.020.m4a", "display_order": 21}, {"id": 6000161021, "chapter_id": 10161, "verse_number": "८-८-२०", "content_sanskrit": "धर्मः क्‍वचित् तस्य न भूतसौहृदं त्यागः क्‍वचित् तच्च न मुक्तिकारणम्।\nवीर्यं न पुंसोऽस्त्यजवेगनिष्कृतं न हि द्वितीयो गुणसङ्गवर्जितः॥ ८/८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.021.m4a", "display_order": 22}, {"id": 6000161022, "chapter_id": 10161, "verse_number": "८-८-२१", "content_sanskrit": "क्‍वचिच्चिरायुर्न हि शीलमङ्गलं क्‍वचित् तदप्यस्ति न वेद्यमायुषः।\nयत्रोभयं कुत्र च सोऽप्यमङ्गलः सुमङ्गलः कश्चन काङ्क्षते हि माम्॥ ८/८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.022.m4a", "display_order": 23}, {"id": 6000161023, "chapter_id": 10161, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.023.m4a", "display_order": 24}, {"id": 6000161024, "chapter_id": 10161, "verse_number": "८-८-२२", "content_sanskrit": "एवं विमृश्याव्यभिचारिसद्गुणं पदं निजैकाश्रयिसद्गुणाश्रयम्।\nवव्रे वरं सर्वगुणैरपेक्षितं रमा मुकुन्दं निरपेक्षमीप्सितम्॥ ८/८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.024.m4a", "display_order": 25}, {"id": 6000161025, "chapter_id": 10161, "verse_number": "८-८-२३", "content_sanskrit": "तस्यांसदेश उशतीं नवकञ्जमालां माद्यन्मधुव्रतवरूथगिरोपघुष्टाम्।\nतस्थौ निवीय निकटे तदुरः स्वधाम सव्रीडहासविकसन्नयनेन भीता॥ ८/८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.025.m4a", "display_order": 26}, {"id": 6000161026, "chapter_id": 10161, "verse_number": "८-८-२४", "content_sanskrit": "स्वस्याः स्‍त्रियस्‍त्रिजगतो जनको जनन्या वक्षो निवासमकरोत् परमं विभूतेः।\nश्रीः स्वाः प्रजाः सकरुणेन निरीक्षणेन यत्र स्थितैधयत साधिपतींस्‍त्रिलोकान्॥ ८/८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.026.m4a", "display_order": 27}, {"id": 6000161027, "chapter_id": 10161, "verse_number": "८-८-२५", "content_sanskrit": "शङ्खतूर्यमृदङ्गानां वादित्राणां पृथक् स्वनः।\nदेवानुगानां सस्‍त्रीणां नृत्यतां गायतामभूत्॥ ८/८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.027.m4a", "display_order": 28}, {"id": 6000161028, "chapter_id": 10161, "verse_number": "८-८-२६", "content_sanskrit": "ब्रह्मरुद्राङ्गिरोमुख्याः सर्वे विश्वसृजो विभुम्।\nईडिरेऽवितथैर्मन्त्रैस्तल्लिङ्गैः पुष्पवर्षिणः॥ ८/८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.028.m4a", "display_order": 29}, {"id": 6000161029, "chapter_id": 10161, "verse_number": "८-८-२७", "content_sanskrit": "श्रिया विलोकिता देवाः सप्रजापतयः प्रजाः।\nशीलादिगुणसंपन्ना लेभिरे निर्वृतिं पराम्॥ ८/८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.029.m4a", "display_order": 30}, {"id": 6000161030, "chapter_id": 10161, "verse_number": "८-८-२८", "content_sanskrit": "निस्सत्त्वा लोलुपा राजन् निरुद्योगा गतत्रपाः।\nयदा चोपेक्षिता लक्ष्म्या बभूवुर्दैत्यदानवाः॥ ८/८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.030.m4a", "display_order": 31}, {"id": 6000161031, "chapter_id": 10161, "verse_number": "८-८-२९", "content_sanskrit": "अथासीद् वारुणी देवी कन्या कमललोचना।\nअसुरा जगृहुस्तां वै हरेरनुमतेन ते॥ ८/८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.031.m4a", "display_order": 32}, {"id": 6000161032, "chapter_id": 10161, "verse_number": "८-८-३०", "content_sanskrit": "अथोदधेर्मथ्यमानात् काश्यपैरमृतार्थिभिः।\nउदतिष्ठन् महाराज पुरुषः परमाद्भुतः॥ ८/८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.032.m4a", "display_order": 33, "topics": [{"text": "अमृतकलशहस्तस्य धन्वन्तरेरुत्पत्तिः", "range": "३०–३४"}]}, {"id": 6000161033, "chapter_id": 10161, "verse_number": "८-८-३१", "content_sanskrit": "दीर्घपीवरदोर्दण्डः कम्बुग्रीवोऽरुणेक्षणः।\nश्यामलस्तरुणः स्रग्वी सर्वाभरणभूषितः॥ ८/८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.033.m4a", "display_order": 34}, {"id": 6000161034, "chapter_id": 10161, "verse_number": "८-८-३२", "content_sanskrit": "पीतवासा महोरस्कः सुमृष्टमणिकुण्डलः।\nनीलकुञ्चितकेशान्तः सुभगः सिंहविक्रमः॥ ८/८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.034.m4a", "display_order": 35}, {"id": 6000161035, "chapter_id": 10161, "verse_number": "८-८-३३", "content_sanskrit": "अमृतस्य पूर्णकलशं बिभ्रद् वलयभूषितः।\nस वै भगवतः साक्षाद् विष्णोरंशांशसम्भवः॥ ८/८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.035.m4a", "display_order": 36}, {"id": 6000161036, "chapter_id": 10161, "verse_number": "८-८-३४", "content_sanskrit": "धन्वन्तरिरिति ख्यात आयुर्वेददृगिज्यभाक्।\nतमालोक्यासुराः सर्वे कलशं चामृताहृतम्॥ ८/८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.036.m4a", "display_order": 37}, {"id": 6000161037, "chapter_id": 10161, "verse_number": null, "content_sanskrit": "लिप्सन्तः सर्ववस्तूनि कलशं तरसाऽहरन्।\nनीयमानेऽसुरैस्तस्मिन् कलशेऽमृतभाजने॥ ८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.037.m4a", "display_order": 38}, {"id": 6000161038, "chapter_id": 10161, "verse_number": "८-८-३५", "content_sanskrit": "विषण्णमनसो देवा हरिं शरणमाययुः॥ ८/८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.038.m4a", "display_order": 39, "topics": [{"text": "असुरैरमृते हृते तद्वञ्चनार्थं भगवता मोहिनीरूपस्वीकारः", "range": "३५–४०"}]}, {"id": 6000161039, "chapter_id": 10161, "verse_number": "८-८-३६", "content_sanskrit": "इति तद्दैन्यमालोक्य भगवान् भृत्यकामकृत्।\nमा खिद्यत मिथोऽर्थं वः साधयिष्ये स्वमायया॥ ८/८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.039.m4a", "display_order": 40}, {"id": 6000161040, "chapter_id": 10161, "verse_number": "८-८-३७", "content_sanskrit": "मिथः कलिरभूत् तेषां तदर्थे तर्षचेतसाम्।\nअहं पूर्वमहं पूर्वं न त्वं न त्वमिति प्रभो॥ ८/८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.040.m4a", "display_order": 41}, {"id": 6000161041, "chapter_id": 10161, "verse_number": "८-८-३८", "content_sanskrit": "देवाः स्वभागमर्हन्ति ये तुल्यायासहेतवः।\nसत्रयाग इवैतस्मिन्नेष धर्मः सनातनः॥ ८/८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.041.m4a", "display_order": 42}, {"id": 6000161042, "chapter_id": 10161, "verse_number": "८-८-३९", "content_sanskrit": "इति स्वान् प्रत्यषेधन् वै दैतेया जातमत्सराः।\nदुर्बलाः प्रबलान् राजन् गृहीतकलशान् मुहुः॥ ८/८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.042.m4a", "display_order": 43}, {"id": 6000161043, "chapter_id": 10161, "verse_number": "८-८-४०", "content_sanskrit": "एतस्मिन्नन्तरे विष्णुः सर्वोपायविदीश्वरः।\nयोषिद्रूपमनिर्देश्यं दधार परमाद्भुतम्॥ ८/८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.043.m4a", "display_order": 44}, {"id": 6000161044, "chapter_id": 10161, "verse_number": "८-८-४१", "content_sanskrit": "प्रेक्षणीयोत्पलश्यामं सर्वावयवसुन्दरम्।\nसमानकर्णाभरणं सुकपोलोन्नसाननम्॥ ८/८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.044.m4a", "display_order": 45, "topics": [{"text": "मोहिन्या रूपं दृष्ट्वा मोहितैर्दैत्यैर्मोहिनीहस्ते अमृतपात्रसमर्पणम्", "range": "४१–५६"}]}, {"id": 6000161045, "chapter_id": 10161, "verse_number": "८-८-४२", "content_sanskrit": "नवयौवननिष्पन्दस्तनभारकृशोदरम्।\nमुखामोदानुरक्तालिहुङ्कारोद्विग्नलोचनम्॥ ८/८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.045.m4a", "display_order": 46}, {"id": 6000161046, "chapter_id": 10161, "verse_number": "८-८-४३", "content_sanskrit": "बिभ्रत् स्वकेशभारेण मालामुत्फुल्लमल्लिकाम्।\nसुग्रीवकण्ठाभरणं सुभुजाङ्गदभूषितम्॥ ८/८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.046.m4a", "display_order": 47}, {"id": 6000161047, "chapter_id": 10161, "verse_number": "८-८-४४", "content_sanskrit": "विरजाम्बरसंवीतं चित्रं वध्वीयशोभया।\nकाञ्च्या प्रविलसद् वल्गुस्फुरच्चरणनूपुरम्॥ ८/८/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.047.m4a", "display_order": 48}, {"id": 6000161048, "chapter_id": 10161, "verse_number": "८-८-४५", "content_sanskrit": "सव्रीडस्मितविक्षिप्तभ्रूविलासावलोकनैः।\nदैत्ययूथपचेतस्सु काममुद्दीपयन्मुहुः॥ ८/८/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.048.m4a", "display_order": 49}, {"id": 6000161049, "chapter_id": 10161, "verse_number": "८-८-४६", "content_sanskrit": "तेऽन्योन्यतः सुधापात्रं हरन्तस्त्यक्तसौहृदाः।\nक्षिपन्तो दस्युधर्मेण आयान्तीं ददृशुः स्‍त्रियम्॥ ८/८/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.049.m4a", "display_order": 50}, {"id": 6000161050, "chapter_id": 10161, "verse_number": "८-८-४७", "content_sanskrit": "अहो रूपमहो धाम अहो अस्या नवं वयः।\nइति ते तामभिद्रुत्य पप्रच्छुर्जातहृच्छयाः॥ ८/८/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.050.m4a", "display_order": 51}, {"id": 6000161051, "chapter_id": 10161, "verse_number": "८-८-४८", "content_sanskrit": "का त्वं कञ्जपलाशाक्षि कुतो वा किं चिकीर्षसि।\nकस्यासि वद वामोरु मथ्नन्तीव मनांसि नः॥ ८/८/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.051.m4a", "display_order": 52}, {"id": 6000161052, "chapter_id": 10161, "verse_number": "८-८-४९", "content_sanskrit": "न वयं त्वाऽमरैर्दैत्यैः सिद्धगन्धर्वचारणैः।\nस्पृष्टपूर्वां तु जानीमो लोकेशैश्च कुतो नृभिः॥ ८/८/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.052.m4a", "display_order": 53}, {"id": 6000161053, "chapter_id": 10161, "verse_number": "८-८-५०", "content_sanskrit": "नूनं त्वं विधिना सुभ्रु प्रेषिताऽसि शरीरिणाम्।\nसर्वेन्द्रियमनःप्रीतिं विधातुं सघृणेन किम्॥ ८/८/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.053.m4a", "display_order": 54}, {"id": 6000161054, "chapter_id": 10161, "verse_number": "८-८-५१", "content_sanskrit": "सा त्वं नः स्पर्धमानानामेकवस्तुनि भामिनि।\nज्ञातीनां बद्धवैराणां शं विधत्स्व सुमध्यमे॥ ८/८/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.054.m4a", "display_order": 55}, {"id": 6000161055, "chapter_id": 10161, "verse_number": "८-८-५२", "content_sanskrit": "वयं कश्यपदायादा भ्रातरः कृतपौरुषाः।\nविभजस्व यथान्यायं नैव भेदो यथा भवेत्॥ ८/८/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.055.m4a", "display_order": 56}, {"id": 6000161056, "chapter_id": 10161, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.056.m4a", "display_order": 57}, {"id": 6000161057, "chapter_id": 10161, "verse_number": "८-८-५३", "content_sanskrit": "इत्युपामन्त्रितो दैत्यैर्मायायोषिद्वपुर्हरिः।\nप्रहस्य रुचिरापाङ्गैर्निरीक्षन्निदमब्रवीत्॥ ८/८/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.057.m4a", "display_order": 58}, {"id": 6000161058, "chapter_id": 10161, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.058.m4a", "display_order": 59}, {"id": 6000161059, "chapter_id": 10161, "verse_number": "८-८-५४", "content_sanskrit": "कथं कश्यपदायादाः पुंश्चल्यां मयि सङ्गताः।\nविश्वासं पण्डिता जातु कामिनीषु न यान्ति हि॥ ८/८/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.059.m4a", "display_order": 60}, {"id": 6000161060, "chapter_id": 10161, "verse_number": "८-८-५५", "content_sanskrit": "सालावृकाणां स्‍त्रीणां च स्वैरिणीनां सुरद्विषः।\nसख्यान्याहुरनित्यानि नूत्नं नूत्नं विचिन्वताम्॥ ८/८/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.060.m4a", "display_order": 61}, {"id": 6000161061, "chapter_id": 10161, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.061.m4a", "display_order": 62}, {"id": 6000161062, "chapter_id": 10161, "verse_number": "८-८-५६", "content_sanskrit": "इति ते क्ष्वेलितैस्तस्या आश्वस्तमनसोऽसुराः।\nजहसुर्भावगम्भीरं ददुश्चामृतभाजनम्॥ ८/८/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.062.m4a", "display_order": 63}, {"id": 6000161063, "chapter_id": 10161, "verse_number": "८-८-५७", "content_sanskrit": "ततो गृहीत्वाऽमृतभाजनं हरिर्बभाष ईषत्स्मितशोभया गिरा।\nयद्यभ्युपेतं क्‍व च साध्वसाधु वा कृतं मया वो विभजे सुधामिमाम्॥ ८/८/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.063.m4a", "display_order": 64, "topics": [{"text": "मोहिन्या दैत्यान् वञ्चयित्वा देवेभ्योऽमृतपरिवेषणम्", "range": "५७–७४"}]}, {"id": 6000161064, "chapter_id": 10161, "verse_number": "८-८-५८", "content_sanskrit": "इत्यभिव्याहृतं तस्या आकर्ण्यासुरपुङ्गवाः।\nअप्रमाणविदस्तस्यास्तत् तथेत्यन्वमंसत॥ ८/८/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.064.m4a", "display_order": 65}, {"id": 6000161065, "chapter_id": 10161, "verse_number": "८-८-५९", "content_sanskrit": "अथोपोष्य कृतस्नाना हुत्वा च हविषाऽनलम्।\nदत्त्वा गोविप्रभूतेभ्यः कृतस्वस्त्ययना द्विजैः॥ ८/८/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.065.m4a", "display_order": 66}, {"id": 6000161066, "chapter_id": 10161, "verse_number": "८-८-६०", "content_sanskrit": "यथोपजोषं वासांसि परिधायाहतानि ते।\nकुशेषु प्राविशन् सर्वे प्रागग्रेष्वभिभूषिताः॥ ८/८/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.066.m4a", "display_order": 67}, {"id": 6000161067, "chapter_id": 10161, "verse_number": "८-८-६१", "content_sanskrit": "प्राङ्मुखेषूपविष्टेषु सुरेषु दितिजेषु च।\nधूपामोदितशालायां जुष्टायां माल्यदीपकैः॥ ८/८/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.067.m4a", "display_order": 68}, {"id": 6000161068, "chapter_id": 10161, "verse_number": "८-८-६२", "content_sanskrit": "तस्यां नरेन्द्रकलभोरुलसद्दुकूलश्रोणीतटालसगतिर्मदविह्वलाक्षी।\nसा कूजती कनकनूपुरसिञ्जितेन कुम्भस्तनी कलशपाणिरथाविवेश॥ ८/८/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.068.m4a", "display_order": 69}, {"id": 6000161069, "chapter_id": 10161, "verse_number": "८-८-६३", "content_sanskrit": "तां श्रीमुखीं कनककुण्डलचारुकर्णनासाकपोलवदनां परदेवताख्याम्।\nसंवीक्ष्य संमुमुहुरुत्स्मितवीक्षणेन देवासुरा विगलितस्तनपट्टिकान्ताम्॥ ८/८/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.069.m4a", "display_order": 70}, {"id": 6000161070, "chapter_id": 10161, "verse_number": "८-८-६४", "content_sanskrit": "असुराणां सुधादानं सर्पाणामिव दुर्नयम्।\nमत्वा जातिनृंशसानां न तान् व्यभजदच्युतः॥ ८/८/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.070.m4a", "display_order": 71}, {"id": 6000161071, "chapter_id": 10161, "verse_number": "८-८-६५", "content_sanskrit": "कल्पयित्वा पृथक् पङ्क्तीरुभयेषां जगत्पतिः।\nतांश्चोपवेशयामास स्वासु स्वासु च पङ्क्तिषु॥ ८/८/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.071.m4a", "display_order": 72}, {"id": 6000161072, "chapter_id": 10161, "verse_number": "८-८-६६", "content_sanskrit": "दैत्यान् गृहीतकलशो वञ्चयन्नुपसञ्चरैः।\nदूरस्थान्पाययामास जरामृत्युहरां सुधाम्॥ ८/८/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.072.m4a", "display_order": 73}, {"id": 6000161073, "chapter_id": 10161, "verse_number": "८-८-६७", "content_sanskrit": "ते पालयन्तः समयमसुराः स्वकृतं नृप।\nतूष्णीमासन् कृतस्नेहाः स्‍त्रीविवादजुगुप्सया॥ ८/८/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.073.m4a", "display_order": 74}, {"id": 6000161074, "chapter_id": 10161, "verse_number": "८-८-६८", "content_sanskrit": "तस्यां कृतातिप्रणयाः प्रणयापायकातराः।\nबहुमानेन चाबद्धा नोचुः किञ्चन विप्रियम्॥ ८/८/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.074.m4a", "display_order": 75}, {"id": 6000161075, "chapter_id": 10161, "verse_number": "८-८-६९", "content_sanskrit": "देवलिङ्गप्रतिच्छन्नः स्वर्भानुर्देवसंसदि।\nप्रविश्य सोममपिबच्चन्द्रार्काभ्यां च सूचितः॥ ८/८/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.075.m4a", "display_order": 76}, {"id": 6000161076, "chapter_id": 10161, "verse_number": "८-८-७०", "content_sanskrit": "चक्रेण क्षुरधारेण जहार पिबतः शिरः।\nहरिस्तस्य कबन्धस्तु सुधया प्लावितोऽपतत्॥ ८/८/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.076.m4a", "display_order": 77}, {"id": 6000161077, "chapter_id": 10161, "verse_number": "८-८-७१", "content_sanskrit": "शिरस्त्वमरतां नीतमजो ग्रहमचीकॢपत्।\nयस्तु पर्वणि चन्द्रार्कावभिधावति वैरधीः॥ ८/८/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.077.m4a", "display_order": 78}, {"id": 6000161078, "chapter_id": 10161, "verse_number": "८-८-७२", "content_sanskrit": "पीतप्रायेऽमृते देवैर्भगवाल्‍ँलोकभावनः।\nपश्यतामसुरेन्द्राणां स्वरूपं जगृहे विभुः॥ ८/८/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.078.m4a", "display_order": 79}, {"id": 6000161079, "chapter_id": 10161, "verse_number": "८-८-७३", "content_sanskrit": "एवं सुरासुरगणाः समदेशकालहेत्वर्थयोगगतयो विफलैर्विकल्पाः।\nतत्रामृतं सुरगणाः फलमञ्जसाऽऽपुः यत्पादपङ्कजरजःश्रयणान्न दैत्याः॥ ८/८/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.079.m4a", "display_order": 80}, {"id": 6000161080, "chapter_id": 10161, "verse_number": "८-८-७४", "content_sanskrit": "यद्युद्यतेषु वसुकर्ममनोवचोभिर्देवात्मजादिषु नृभिस्तदसत् पुरस्तात्।\nतैरेव सद् भवति यत् क्रियते च तस्मिन् सर्वस्य तद् भवति मूलनिषेचनं यत्॥ ८/८/७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_008/BhP_08.008.080.m4a", "display_order": 81}, {"id": 6000161081, "chapter_id": 10161, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायाम् अष्टमस्कन्धेऽष्टमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}]