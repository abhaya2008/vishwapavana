[{"id": 40022274, "chapter_id": 9388, "verse_number": "1", "content_sanskrit": "तच्छ्रुत्वा भाषितं तस्य शत्रुघ्नस्य महात्मनः । क्रोधामाहारयत्तीव्रं तिष्ठ तिष्ठेति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022275, "chapter_id": 9388, "verse_number": "2", "content_sanskrit": "पाणौ पाणिं विनिष्पिष्य दन्तान्कटकटाय्य च । लवणो रघुशार्दूलमाह्वयामास चासकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022276, "chapter_id": 9388, "verse_number": "3", "content_sanskrit": "तं ब्रुवाणं तथा वाक्यं लवणं घोरदर्शनम् । शत्रुघ्नो देवशत्रुघ्न इदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022277, "chapter_id": 9388, "verse_number": "4", "content_sanskrit": "न शत्रुघ्नस्तथा जातो यथा ऽन्ये निर्जितास्त्वया । तदद्य बाणाभिहतो व्रज त्वं यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022278, "chapter_id": 9388, "verse_number": "5", "content_sanskrit": "ऋषयो ऽप्यद्य पापात्मन्मया त्वां निहतं रणे । पश्यन्तु विप्रा विद्वांसस्त्रिदशा इव रावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022279, "chapter_id": 9388, "verse_number": "6", "content_sanskrit": "त्वयि मद्बाणनिर्दग्धे पतिते ऽद्य निशाचर । पुरे जनपदे चापि क्षेममेव भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022280, "chapter_id": 9388, "verse_number": "7", "content_sanskrit": "अद्य मद्बाहुनिष्क्रान्तः शरो वज्रनिभाननः । प्रवेक्ष्यते ते हृदयं पद्ममंशुरिवार्कजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022281, "chapter_id": 9388, "verse_number": "8", "content_sanskrit": "एवमुक्तो महावृक्षं लवणः क्रोधमूर्च्छितः । शत्रुघ्नोरसि चिक्षेप स च तं शतधाच्छिनत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022282, "chapter_id": 9388, "verse_number": "9", "content_sanskrit": "तद्दृष्ट्वा विफलं कर्म राक्षसः पुनरेव तु । पादपान्सुबहून्गृह्य शत्रुघ्नायासृजद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022283, "chapter_id": 9388, "verse_number": "10", "content_sanskrit": "शत्रुघ्नश्चापि तेजस्वी वृक्षानापततो बहून् । त्रिभिश्चतुर्भिरेकैकं चिच्छेद नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022284, "chapter_id": 9388, "verse_number": "11", "content_sanskrit": "ततो बाणमयं वर्षं व्यसृजद्राक्षसोरसि । शत्रुघ्नो वीर्यसम्पन्नो विव्यथे न स राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022285, "chapter_id": 9388, "verse_number": "12", "content_sanskrit": "ततः प्रहस्य लवणो वृक्षमुद्यम्य वीर्यवान् । शिरस्यभ्यहनच्छूरं स्रस्ताङ्गः स मुमोह वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022286, "chapter_id": 9388, "verse_number": "13", "content_sanskrit": "तस्मिन्निपतिते वीरे हाहाकारो महानभूत् । ऋषीणां देवसङ्घानां गन्धर्वाप्सरसां तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022287, "chapter_id": 9388, "verse_number": "14", "content_sanskrit": "तमवज्ञाय तु हतं शत्रुघ्नं भुवि पातितम् । रक्षो लब्धान्तरमपि न विवेश स्वमालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022288, "chapter_id": 9388, "verse_number": "15", "content_sanskrit": "नापि शूलं प्रजग्राह तं दृष्ट्वा भुवि पातितम् । ततो हत इति ज्ञात्वा तान्भक्षान्समुदावहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022289, "chapter_id": 9388, "verse_number": "16", "content_sanskrit": "मुहूर्ताल्लब्धसञ्ज्ञस्तु पुनस्तस्थौ धृतायुधः । शत्रुघ्नो वै पुरद्वारि ऋषिभिः सम्प्रपूजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022290, "chapter_id": 9388, "verse_number": "17", "content_sanskrit": "ततो दिव्यममोघं तं जग्राह शरमुत्तमम् । ज्वलन्तं तेजसा घोरं पूरयन्तं दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022291, "chapter_id": 9388, "verse_number": "18", "content_sanskrit": "वज्राननं वज्रवेगं मेरुमन्दरसन्निभम् । नतं पर्वसु सर्वेषु संयुगेष्वपराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022292, "chapter_id": 9388, "verse_number": "19", "content_sanskrit": "असृक्चन्दनदिग्धाङ्गं चारुपत्रं पतत्रिणम् । दानवेन्द्राचलेन्द्राणामसुराणां च दारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022293, "chapter_id": 9388, "verse_number": "20", "content_sanskrit": "तं दीप्तमिव कालाग्निं युगान्ते समुपस्थिते । दृष्ट्वा सर्वाणि भूतानि परित्रासमुपागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022294, "chapter_id": 9388, "verse_number": "21", "content_sanskrit": "सदेवासुरगन्धर्वं मुनिभिः साप्सरोगणम् । जगद्धि सर्वमस्वस्थं पितामहमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022295, "chapter_id": 9388, "verse_number": "22", "content_sanskrit": "उवाच देवदेवेशं वरदं प्रपितामहम् । देवानां भयसंमोहो लोकानां सङ्क्षयं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40022296, "chapter_id": 9388, "verse_number": "23", "content_sanskrit": "नेदृशं दृष्टपूर्वं च न श्रुतं प्रपितामह । देवानां भयसम्मोहो लोकानां सङ्क्षयं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40022297, "chapter_id": 9388, "verse_number": "24", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा ब्रह्मा लोकपितामहः । भयकारणमाचष्ट लोकानामभयङ्करः । उवाच मधुरां वाणीं शृणुध्वं सर्वदेवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40022298, "chapter_id": 9388, "verse_number": "25", "content_sanskrit": "वधाय लवणस्याजौ शरः शत्रुघ्नधारितः । तेजसा तस्य सम्मूढाः सर्वे स्मः सुरसत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40022299, "chapter_id": 9388, "verse_number": "26", "content_sanskrit": "एष पूर्वस्य देवस्य लोककर्तुः सनातनः । शरस्तेजोमयो वत्सा येन वै भयमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40022300, "chapter_id": 9388, "verse_number": "27", "content_sanskrit": "एष वै कैटभस्यार्थे मधुनश्च महाशरः । सृष्टो महात्मना तेन वधार्थे दैत्ययोस्तयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40022301, "chapter_id": 9388, "verse_number": "28", "content_sanskrit": "एक एव प्रजानाति विष्णुस्तेजोमयं शरम् । एषा एव तनुः पूर्वा विष्णोस्तस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40022302, "chapter_id": 9388, "verse_number": "29", "content_sanskrit": "इतो गच्छत पश्यध्वं वध्यमानं महात्मना । रामानुजेन वीरेण लवणं राक्षसोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40022303, "chapter_id": 9388, "verse_number": "30", "content_sanskrit": "तस्य ते देवदेवस्य निशम्य वचनं सुराः । आजग्मुर्यत्र युध्येते शत्रुघ्नलवणावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40022304, "chapter_id": 9388, "verse_number": "31", "content_sanskrit": "तं शरं दिव्यसङ्काशं शत्रुघ्नकरधारितम् । ददृशुः सर्वभूतानि युगान्ताग्निमिवोत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40022305, "chapter_id": 9388, "verse_number": "32", "content_sanskrit": "अकाशमावृतं दृष्ट्वा देवैर्हि रघुनन्दनः । सिंहनादं भृशं कृत्वा ददर्श लक्षणं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40022306, "chapter_id": 9388, "verse_number": "33", "content_sanskrit": "आहूतश्च पुनस्तेन शत्रुघ्नेन महात्मना । लवणः क्रोधसंयुक्तो युद्धाय समुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40022307, "chapter_id": 9388, "verse_number": "34", "content_sanskrit": "आकर्णात्स विकृष्याथ तद्धनुर्धन्विनां वरः । तं मुमोच महाबाणं लवणस्य महोरसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40022308, "chapter_id": 9388, "verse_number": "35", "content_sanskrit": "उरस्तस्य विदार्याशु प्रविवेश रसातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40022309, "chapter_id": 9388, "verse_number": "36", "content_sanskrit": "गत्वा रसातलं दिव्यः शरो विबुधपूजितः । पुनरेवागमत्तूर्णमिक्ष्वाकुकुलनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40022310, "chapter_id": 9388, "verse_number": "37", "content_sanskrit": "शत्रुघ्नशरनिर्भिन्नो लवणः स निशाचरः । पपात सहसा भूमौ वज्राहत इवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40022311, "chapter_id": 9388, "verse_number": "38", "content_sanskrit": "तच्च शूलं महत्तेन हते लवणराक्षसे । पश्यतां सर्वदेवानां रुद्रस्य वशमन्वगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40022312, "chapter_id": 9388, "verse_number": "39", "content_sanskrit": "एकेषुपातेन भृशं निपात्य लोकत्रयस्यापि रघुप्रवीरः । विनिर्बभावुत्तमचापबाणस्तमः प्रणुद्येव सहस्ररश्मिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40022313, "chapter_id": 9388, "verse_number": "40", "content_sanskrit": "ततो हि देवा ऋषिपन्नगाश्च प्रपूजिरे ह्यप्सरसश्च सर्वाः । दिष्ट्या जयो दाशरथेरवाप्तस्त्यक्त्वा भयं सर्प इव प्रशान्तः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]