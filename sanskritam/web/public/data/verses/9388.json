[{"id": 5000388000, "chapter_id": 9388, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे एकोनपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000388001, "chapter_id": 9388, "verse_number": "५-४९-१", "content_sanskrit": "ततः स कर्मणा तस्य विस्मितो भीमविक्रमः।\nहनूमान् क्रोधताम्राक्षो रक्षोऽधिपमवैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000388002, "chapter_id": 9388, "verse_number": "५-४९-२", "content_sanskrit": "भ्राजमानं महार्हेण काञ्चनेन विराजता।\nमुक्ताजालवृतेनाथ मुकुटेन महाद्युतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000388003, "chapter_id": 9388, "verse_number": "५-४९-३", "content_sanskrit": "वज्रसंयोगसंयुक्तैर्महार्हमणिविग्रहैः।\nहैमैराभरणैश्चित्रैर्मनसेव प्रकल्पितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000388004, "chapter_id": 9388, "verse_number": "५-४९-४", "content_sanskrit": "महार्हक्षौमसंवीतं रक्तचन्दनरूषितम्।\nस्वनुलिप्तं विचित्राभिर्विविधाभिश्च भक्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000388005, "chapter_id": 9388, "verse_number": "५-४९-५", "content_sanskrit": "विचित्रं दर्शनीयैश्च रक्ताक्षैर्भीमदर्शनैः।\nदीप्ततीक्ष्णमहादंष्ट्रं प्रलम्बं दशनच्छदैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000388006, "chapter_id": 9388, "verse_number": "५-४९-६", "content_sanskrit": "शिरोभिर्दशभिर्वीरो भ्राजमानं महौजसम्।\nनानाव्यालसमाकीर्णैः शिखरैरिव मन्दरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000388007, "chapter_id": 9388, "verse_number": "५-४९-७", "content_sanskrit": "नीलाञ्जनचयप्रख्यं हारेणोरसि राजता।\nपूर्णचन्द्राभवक्त्रेण सबालार्कमिवाम्बुदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000388008, "chapter_id": 9388, "verse_number": "५-४९-८", "content_sanskrit": "बाहुभिर्बद्धकेयूरैश्चन्दनोत्तमरूषितैः।\nभ्राजमानाङ्गदैर्भीमैः पञ्चशीर्षैरिवोरगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000388009, "chapter_id": 9388, "verse_number": "५-४९-९", "content_sanskrit": "महति स्फाटिके चित्रे रत्नसंयोगचित्रिते।\nउत्तमास्तरणास्तीर्णे सूपविष्टं वरासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000388010, "chapter_id": 9388, "verse_number": "५-४९-१०", "content_sanskrit": "अलंकृताभिरत्यर्थं प्रमदाभिः समन्ततः।\nवालव्यजनहस्ताभिरारात्समुपसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000388011, "chapter_id": 9388, "verse_number": "५-४९-११", "content_sanskrit": "दुर्धरेण प्रहस्तेन महापार्श्वेन रक्षसा।\nमन्त्रिभिर्मन्त्रतत्त्वज्ञैर्निकुम्भेन च मन्त्रिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000388012, "chapter_id": 9388, "verse_number": "५-४९-१२", "content_sanskrit": "उपोपविष्टं रक्षोभिश्चतुर्भिर्बलदर्पितम्।\nकृत्स्नं परिवृतं लोकं चतुर्भिरिव सागरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000388013, "chapter_id": 9388, "verse_number": "५-४९-१३", "content_sanskrit": "मन्त्रिभिर्मन्त्रतत्त्वज्ञैरन्यैश्च शुभदर्शिभिः।\nआश्वास्यमानं सचिवैः सुरैरिव सुरेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000388014, "chapter_id": 9388, "verse_number": "५-४९-१४", "content_sanskrit": "अपश्यद् राक्षसपतिं हनूमानतितेजसम्।\nवेष्टितं मेरुशिखरे सतोयमिव तोयदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000388015, "chapter_id": 9388, "verse_number": "५-४९-१५", "content_sanskrit": "स तैः सम्पीड्यमानोऽपि रक्षोभिर्भीमविक्रमैः।\nविस्मयं परमं गत्वा रक्षोऽधिपमवैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000388016, "chapter_id": 9388, "verse_number": "५-४९-१६", "content_sanskrit": "भ्राजमानं ततो दृष्ट्वा हनुमान् राक्षसेश्वरम्।\nमनसा चिन्तयामास तेजसा तस्य मोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000388017, "chapter_id": 9388, "verse_number": "५-४९-१७", "content_sanskrit": "अहो रूपमहो धैर्यमहो सत्त्वमहो द्युतिः।\nअहो राक्षसराजस्य सर्वलक्षणयुक्तता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000388018, "chapter_id": 9388, "verse_number": "५-४९-१८", "content_sanskrit": "यद्यधर्मो न बलवान् स्यादयं राक्षसेश्वरः।\nस्यादयं सुरलोकस्य सशक्रस्यापि रक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000388019, "chapter_id": 9388, "verse_number": "५-४९-१९", "content_sanskrit": "अस्य क्रूरैर्नृशंसैश्च कर्मभिर्लोककुत्सितैः।\nसर्वे बिभ्यति खल्वस्माल्लोकाः सामरदानवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000388020, "chapter_id": 9388, "verse_number": "५-४९-२०", "content_sanskrit": "अयं ह्युत्सहते क्रुद्धः कर्तुमेकार्णवं जगत्।\nइति चिन्तां बहुविधामकरोन्मतिमान् कपिः।\nदृष्ट्वा राक्षसराजस्य प्रभावममितौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000388021, "chapter_id": 9388, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे एकोनपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]