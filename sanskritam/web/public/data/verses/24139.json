[{"id": 7004139000, "chapter_id": 24139, "verse_number": "४-८८-१", "content_sanskrit": "अगस्त्य उवाच ।\nशिवलोकं समासाद्य मुनिना ब्रह्मसूनुना ।\nकिं चक्रे ब्रूहि षड्वक्त्र कथां कौतुकशालिनीम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004139001, "chapter_id": 24139, "verse_number": "४-८८-२", "content_sanskrit": "स्कंद उवाच ।\nशृणु कुंभज वक्ष्यामि नारदेन महात्मना ।\nयत्कृतं तत्र गत्वाशु कैलासं शंकरालयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004139002, "chapter_id": 24139, "verse_number": "४-८८-३", "content_sanskrit": "मुनिर्गगनमार्गेण प्राप्य तद्धाम शांभवम् ।\nदृष्ट्वा शिवौ प्रणम्याथ शिवेन विहितादरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004139003, "chapter_id": 24139, "verse_number": "४-८८-४", "content_sanskrit": "तदुद्दिष्टासनं भेजे पश्यंस्तत्क्रीडनं परम् ।\nक्रीडंतौ तौ तु चाक्षाभ्यां यदा न च विरमेतुः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004139004, "chapter_id": 24139, "verse_number": "४-८८-५", "content_sanskrit": "तदौत्सुक्येन स मुनिः प्रेर्यमाण उवाच ह ।\nनारद उवाच ।\nदेवदेव तव क्रीडाखिलं ब्रह्मांडगोलकम् ।\nमासा द्वादश ये नाथ ते सारिफलके गृहाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004139005, "chapter_id": 24139, "verse_number": "४-८८-६", "content_sanskrit": "कृष्णाः कृष्णेतरा या वै तिथयस्ताश्च सारिकाः ।\nद्विपंचदशमासे यास्त्वक्षयुग्मं तथायने ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004139006, "chapter_id": 24139, "verse_number": "४-८८-७", "content_sanskrit": "सृष्टिप्रलय संज्ञौ द्वौ ग्लहौ जयपराजयौ ।\nदेवीजये भवेत्सृष्टिरसृष्टिर्धूर्जटेर्जये ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004139007, "chapter_id": 24139, "verse_number": "४-८८-८", "content_sanskrit": "भवतोः खेलसमयो यः सा स्थितिरुदाहृता ।\nइत्थं क्रीडैव सकलमेतद्ब्रह्मांडमीशयोः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004139008, "chapter_id": 24139, "verse_number": "४-८८-९", "content_sanskrit": "न देवी जेष्यति पतिं नेशः शक्तिं विजेष्यति ।\nकिंचिद्विज्ञप्तुकामोस्मि तन्मातरवधार्यताम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004139009, "chapter_id": 24139, "verse_number": "४-८८-१०", "content_sanskrit": "देवः सर्वज्ञनाथोपि न किंचिदवबुध्यति ।\nमानापमानयोर्यस्मादसौ दूरे व्यवस्थितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004139010, "chapter_id": 24139, "verse_number": "४-८८-११", "content_sanskrit": "लीलात्मा गुणवानेष विचारादतिनिर्गुणः ।\nकुर्वन्नपि हि कर्माणि बाध्यते नैव कर्मभिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004139011, "chapter_id": 24139, "verse_number": "४-८८-१२", "content_sanskrit": "मध्यस्थोपि हि सर्वस्य माध्यस्थ्यमवलंबतै ।\nसर्वत्रायं महेशानो मित्राऽमित्रसमानदृक् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004139012, "chapter_id": 24139, "verse_number": "४-८८-१३", "content_sanskrit": "त्वं शक्तिरस्य देवस्य सर्वेषां मान्यभूः परा ।\nदक्षस्यापि त्वया मानो दत्तो पत्यनिमित्तकः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004139013, "chapter_id": 24139, "verse_number": "४-८८-१४", "content_sanskrit": "परं त्वं सर्वजगतां जनयित्र्येकिका ध्रुवम् ।\nत्वत्त आविर्भवंत्येव धातृकेशववासवाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004139014, "chapter_id": 24139, "verse_number": "४-८८-१५", "content_sanskrit": "त्वमात्मानं न जानासि त्र्यक्षमायाविमोहिता ।\nअतएव हि मे चित्तं दुनोत्यतितरां सति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004139015, "chapter_id": 24139, "verse_number": "४-८८-१६", "content_sanskrit": "अन्या अपि हि याः सत्यः पातिव्रत्यपरायणाः ।\nता भर्तृचरणौ हित्वा किंचिदन्यन्न मन्वते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004139016, "chapter_id": 24139, "verse_number": "४-८८-१७", "content_sanskrit": "अथवास्तामियं वार्ता प्रस्तुतं प्रब्रवीम्यहम् ।\nअद्य नीलगिरेस्तस्माद्धरिद्वारसमीपतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004139017, "chapter_id": 24139, "verse_number": "४-८८-१८", "content_sanskrit": "अपूर्वमिव संवीक्ष्य परिप्राप्तस्तवांतिकम् ।\nअत्याश्चर्यविषादाभ्यां किचिद्वक्तुमिहोत्सुकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004139018, "chapter_id": 24139, "verse_number": "४-८८-१९", "content_sanskrit": "आश्चर्यहेतुरेवायं यत्पुंजातं त्रयीतले ।\nतद्दृष्टं सकलत्रं च दक्षस्याध्वरमंडपे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004139019, "chapter_id": 24139, "verse_number": "४-८८-२०", "content_sanskrit": "सालंकारं समानं च सानंदमुखपंकजम् ।\nविस्मृताखिलकार्यं च दक्षयज्ञप्रवर्तकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004139020, "chapter_id": 24139, "verse_number": "४-८८-२१", "content_sanskrit": "विषादे कारणं चैतद्यतो जातमिदं जगत् ।\nयस्मिन्प्रवर्तते यत्र लयमेष्यति च ध्रुवम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004139021, "chapter_id": 24139, "verse_number": "४-८८-२२", "content_sanskrit": "तदेव तत्र नो दृष्टं भवद्वंद्वं भवापहम् ।\nप्रायो विषादजनकं भवतोर्यददर्शनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004139022, "chapter_id": 24139, "verse_number": "४-८८-२३", "content_sanskrit": "तदेव नाभवत्तत्र समभूदन्यदेव हि ।\nतच्च वक्तुं न शक्येत तद्वक्ता दक्ष एव सः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004139023, "chapter_id": 24139, "verse_number": "४-८८-२४", "content_sanskrit": "तानि वाक्यानि चाकर्ण्य द्रुहिणेन ययेततः ।\nमहर्षिणा दधीचेन धिक्कृतो नितरां हि सः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004139024, "chapter_id": 24139, "verse_number": "४-८८-२५", "content_sanskrit": "शप्तश्च वीक्षमाणानां देवर्षीणां प्रजापतिः ।\nमया च कर्णौ पिहितौ श्रुत्वा तद्गर्हणा गिरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004139025, "chapter_id": 24139, "verse_number": "४-८८-२६", "content_sanskrit": "दधीचिना समं केचिद्दुर्वासः प्रमुखा द्विजाः ।\nभवनिंदां समाकर्ण्य कियतोपि विनिर्ययुः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004139026, "chapter_id": 24139, "verse_number": "४-८८-२७", "content_sanskrit": "प्रावर्तत महायागो हृष्टपुष्टमहाजनः ।\nतथा द्रष्टुं न शक्नोमि तत आगतवानिह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004139027, "chapter_id": 24139, "verse_number": "४-८८-२८", "content_sanskrit": "भगिन्योपि च या देवि तव तत्र सभर्तृकाः ।\nतासां गौरवमालोक्य न किंचिद्वक्तुमुत्सहे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004139028, "chapter_id": 24139, "verse_number": "४-८८-२९", "content_sanskrit": "इति देवी समाकर्ण्य सती दक्षकुमारिका ।\nकरादक्षौ समुत्सृज्य दध्यौ किंचित्क्षणं हृदि ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004139029, "chapter_id": 24139, "verse_number": "४-८८-३०", "content_sanskrit": "उवाच च भवत्वेवं शरणं भव एव मे ।\nसंप्रधार्येति मनसि सती दाक्षायणी ततः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004139030, "chapter_id": 24139, "verse_number": "४-८८-३१", "content_sanskrit": "द्रुतमेव समुत्तस्थौ प्रणनाम च शंकरम् ।\nमौलावंजलिमाधाय देवी देवं व्यजिज्ञपत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004139031, "chapter_id": 24139, "verse_number": "४-८८-३२", "content_sanskrit": "देव्युवाच ।\nविजयस्वांधकध्वंसिं त्र्यंबक त्रिपुरांतक ।\nचरणौ शरणं ते मे देह्यनुज्ञा सदाशिव ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004139032, "chapter_id": 24139, "verse_number": "४-८८-३३", "content_sanskrit": "मा निषेधीः प्रार्थयामि यास्यमि पितुरंतिकम् ।\nउक्त्वेति मौलिमदधादंधकारि पदांबुजे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004139033, "chapter_id": 24139, "verse_number": "४-८८-३४", "content_sanskrit": "अथोक्ता शंभुना देवी मृडान्युत्तिष्ठ भामिनि ।\nकिमपूर्णं तवास्त्यत्र वदसौ भाग्यसुंदरि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004139034, "chapter_id": 24139, "verse_number": "४-८८-३५", "content_sanskrit": "लक्ष्म्या अपि च सौभाग्यं ब्रह्माण्यै कांतिरुत्तमा ।\nशच्यै नित्यनवीनत्वं भवत्या दत्तमीश्वरि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004139035, "chapter_id": 24139, "verse_number": "४-८८-३६", "content_sanskrit": "त्वया च शक्तिमानस्मि महदैश्वर्यरक्षणे ।\nत्वां च शक्तिं समासाद्य स्वलीलारूपधारिणीम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004139036, "chapter_id": 24139, "verse_number": "४-८८-३७", "content_sanskrit": "एतत्सृजामि पाम्यद्मि त्वल्लीलाप्रेरितोंगने ।\nकुतो मां हातुमिच्छेस्त्वं मम वामार्धधारिणि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004139037, "chapter_id": 24139, "verse_number": "४-८८-३८", "content_sanskrit": "शिवा शिवोदितं चेति श्रुत्वाप्याह महेश्वरम् ।\nजीवितेश विहाय त्वां न क्वापि परियाम्यहम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004139038, "chapter_id": 24139, "verse_number": "४-८८-३९", "content_sanskrit": "मनो मे चरणद्वंद्वे तव स्थास्यति निश्चलम् ।\nक्रतुं द्रष्टुं पितुर्यामि नैक्षि यज्ञो मया क्वचित् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004139039, "chapter_id": 24139, "verse_number": "४-८८-४०", "content_sanskrit": "शंभुः कात्यायनीवाक्यामिति श्रुत्वा तदाब्रवीत् ।\nक्रतुस्त्वया नेक्षितश्चेदाहरामि ततः क्रतुम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004139040, "chapter_id": 24139, "verse_number": "४-८८-४१", "content_sanskrit": "मच्छक्ति धारिणी त्वं वा सृजैवान्यां क्रतुक्रियाम् ।\nअन्यो यज्ञपुमानस्तु संत्वन्ये लोकपालकाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004139041, "chapter_id": 24139, "verse_number": "४-८८-४२", "content_sanskrit": "अन्यानाशु विधेहि त्वमृषीनार्त्विज्यकर्मणि ।\nपुनर्जगाद देवीति श्रुत्वा शंभोरुदीरितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004139042, "chapter_id": 24139, "verse_number": "४-८८-४३", "content_sanskrit": "पितुर्यज्ञोत्सवो नाथ द्रष्टव्योऽत्र मया ध्रुवम् ।\nदेह्यनुज्ञां गमिष्यामि मा मे कार्षीर्वचोन्यथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004139043, "chapter_id": 24139, "verse_number": "४-८८-४४", "content_sanskrit": "कः प्रतीपयितुं शक्तश्चेतो वा जलमेव वा ।\nनिम्नायाभ्युद्यतं नाथ माद्य मां प्रतिषेधय ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004139044, "chapter_id": 24139, "verse_number": "४-८८-४५", "content_sanskrit": "निशम्येति पुनः प्राह सर्वज्ञो भूतनायकः ।\nमा याहि देवि मां हित्वा गता च न मिलिष्यसि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004139045, "chapter_id": 24139, "verse_number": "४-८८-४६", "content_sanskrit": "अद्य प्राचीं यियासुं त्वां वारयेत्पंगुवासरः ।\nनक्षत्रं च तथा ज्येष्ठा तिथिश्च नवमी प्रिये ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004139046, "chapter_id": 24139, "verse_number": "४-८८-४७", "content_sanskrit": "अद्य सप्तदशो योगो वियोगोद्य तनोऽशुभः ।\nधनिष्ठार्ध समुत्पन्ने तव ताराद्य पंचमी ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004139047, "chapter_id": 24139, "verse_number": "४-८८-४८", "content_sanskrit": "मा गा देवि गताद्य त्वं नहि द्रक्ष्यसि मां पुनः ।\nपुनर्देवी बभाषे सा यदि नाम्नाप्यहं सती ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004139048, "chapter_id": 24139, "verse_number": "४-८८-४९", "content_sanskrit": "तदा तन्वंतरेणापि करिष्ये तव दासताम् ।\nततो भवः पुनः प्राह को वा वारयितुं प्रभुः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004139049, "chapter_id": 24139, "verse_number": "४-८८-५०", "content_sanskrit": "परिक्षुब्धमनोवृत्तिं स्त्रियं वा पुरुषं तु वा ।\nपुनर्न दर्शनं देवि मया सत्यं ब्रवीम्यहम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004139050, "chapter_id": 24139, "verse_number": "४-८८-५१", "content_sanskrit": "परं न देवि गंतव्यं महामानधनेच्छुभिः ।\nअनाहूत तया कांते मातापितृगृहानपि ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004139051, "chapter_id": 24139, "verse_number": "४-८८-५२", "content_sanskrit": "यथा सिंधुगता सिंधुर्न पुनः परिवर्तते ।\nतथाद्य गंत्र्या नो जातु तवागमनमिष्यते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004139052, "chapter_id": 24139, "verse_number": "४-८८-५३", "content_sanskrit": "देव्युवाच ।\nअवश्यं यद्यहं रक्ता तव पादाबुंजद्वये ।\nतथा त्वमेव मे नाथो भविष्यसि भवांतरे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004139053, "chapter_id": 24139, "verse_number": "४-८८-५४", "content_sanskrit": "इत्युक्त्वा निर्ययौ देवी कोपांधीकृतलोचना ।\nयियासुभिश्च कार्यार्थं यत्कर्तव्यं न तत्कृतम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004139054, "chapter_id": 24139, "verse_number": "४-८८-५५", "content_sanskrit": "न ननाम महादेवं न च चक्रे प्रदक्षिणम् ।\nअतएव हि सा देवी न गता पुनरागता ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004139055, "chapter_id": 24139, "verse_number": "४-८८-५६", "content_sanskrit": "अप्रणम्य महेशानमकृत्वापि प्रदक्षिणम् ।\nअद्यापि न निवर्तंते गताः प्राग्वासरा इव ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004139056, "chapter_id": 24139, "verse_number": "४-८८-५७", "content_sanskrit": "तया चरणचारिण्या राज्ञ्या त्रिभुवनेशितुः ।\nअपि तत्पावनं वर्त्म मेनेति कठिनं बहु ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004139057, "chapter_id": 24139, "verse_number": "४-८८-५८", "content_sanskrit": "देवोपि तां सतीं यांतीं दृष्ट्वा चरणचारिणीम् ।\nअतीव विव्यथे चित्ते गणांश्चाथ समाह्वयत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004139058, "chapter_id": 24139, "verse_number": "४-८८-५९", "content_sanskrit": "गणा विमानं नयत मनःपवनचक्रिणम् ।\nपंचास्यायुतसंयुक्तं रत्नसानुध्वजोच्छ्रितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004139059, "chapter_id": 24139, "verse_number": "४-८८-६०", "content_sanskrit": "महावातपताकं च महाबुद्ध्यक्षलक्षितम् ।\nनर्मदालकनंदा च यत्रेषादंडतांगते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004139060, "chapter_id": 24139, "verse_number": "४-८८-६१", "content_sanskrit": "छत्रीभूतौ च यत्रस्तः सूर्याचंद्रमसावपि ।\nयस्मिन्मकरतुंडं च वाराहीशक्तिरुत्तमा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004139061, "chapter_id": 24139, "verse_number": "४-८८-६२", "content_sanskrit": "धूः स्वयं चापि गायत्री रज्जवस्तक्षकादयः ।\nसारथिः प्रणवो यत्र क्रेंकारः प्रणवध्वनिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004139062, "chapter_id": 24139, "verse_number": "४-८८-६३", "content_sanskrit": "अंगानि रक्षका यत्र वरूथश्छंदसां गणः ।\nइत्याज्ञप्ता गणास्तूर्णं रथं निन्युर्हराज्ञया ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004139063, "chapter_id": 24139, "verse_number": "४-८८-६४", "content_sanskrit": "देव्या सनाथं तं कृत्वा विमानं पार्षदा दिवि ।\nअनुजग्मुर्महादेवीं दिव्यां तेजोविजृंभिणीम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004139064, "chapter_id": 24139, "verse_number": "४-८८-६५", "content_sanskrit": "सा क्षणं त्र्यक्षरमणी वीक्ष्य दक्षसभांगणम् ।\nनभोंऽगणाद्विमानस्थानतो वेगादवातरत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004139065, "chapter_id": 24139, "verse_number": "४-८८-६६", "content_sanskrit": "अविशद् यज्ञवाटं च चकितंरक्षि वीक्षिता ।\nकृतमंगलनेपथ्यां प्रसूं दृष्ट्वा किरीटिनीम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004139066, "chapter_id": 24139, "verse_number": "४-८८-६७", "content_sanskrit": "सभर्तृकाश्च भगिनीर्नवालंकृतिशालिनीः ।\nसाश्चर्याश्च सगर्वाश्च सानंदाश्च ससाध्वसाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004139067, "chapter_id": 24139, "verse_number": "४-८८-६८", "content_sanskrit": "अचिंतिता त्वनाहूता विमानाद्धरवल्लभा ।\nकथमेषा परिप्राप्ता क्षणमित्थं प्रपश्यतीः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004139068, "chapter_id": 24139, "verse_number": "४-८८-६९", "content_sanskrit": "असंभाष्या पिताः सर्वा गता दक्षांतिकं सती ।\nपित्रा पृष्टा तु मात्रापि भद्रं जातं त्वदागमे ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004139069, "chapter_id": 24139, "verse_number": "४-८८-७०", "content_sanskrit": "सत्युवाच ।\nयदि भद्रं जनेतर्मे समागमनतो भवेत् ।\nकथं नाहं समाहूता यथैता मे सहोदराः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004139070, "chapter_id": 24139, "verse_number": "४-८८-७१", "content_sanskrit": "दक्ष उवाच ।\nअयि कन्ये महाधन्ये ह्यनन्ये सर्वमंगले ।\nअयं ते न मनाग्दोषो दोष एष ममैव हि ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004139071, "chapter_id": 24139, "verse_number": "४-८८-७२", "content_sanskrit": "तादृग्विधाय यत्पत्ये मया दत्ताज्ञबुद्धिना ।\nयदहं तं समाज्ञास्यमीश्वरोसौ निरीश्वरः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004139072, "chapter_id": 24139, "verse_number": "४-८८-७३", "content_sanskrit": "तदा कथमदास्यं त्वां तस्मै मायास्वरूपिणं ।\nअहं शिवाख्यया तुष्टो न जाने शिवरूपिणम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004139073, "chapter_id": 24139, "verse_number": "४-८८-७४", "content_sanskrit": "पितामहेन बहुधा वर्णितोसौ ममाग्रतः ।\nशंकरोयमयं शभुरसौ पशुपतिः शिवः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004139074, "chapter_id": 24139, "verse_number": "४-८८-७५", "content_sanskrit": "श्रीकंठोसौ महेशोऽसौ सर्वज्ञोसौ वृषध्वजः ।\nअस्मै कन्यां प्रयच्छ त्वं महादेवाय धन्विने ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004139075, "chapter_id": 24139, "verse_number": "४-८८-७६", "content_sanskrit": "वाक्याच्छतधृतेस्तस्मात्तस्मै दत्ता मयानघे ।\nन जाने तं विरूपाक्षमुक्षगं विषभक्षिणम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004139076, "chapter_id": 24139, "verse_number": "४-८८-७७", "content_sanskrit": "पितृकाननसंवासं शूलिनं च कपालिनम् ।\nद्विजिह्वसंगसुभगं जलाधारं कपर्दिनम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004139077, "chapter_id": 24139, "verse_number": "४-८८-७८", "content_sanskrit": "कलंकिकृतमौलिं च धूलिधूसरचर्चितम् ।\nक्वचित्कौपीनवसनं नग्नं वातूलवत्क्वचित् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004139078, "chapter_id": 24139, "verse_number": "४-८८-७९", "content_sanskrit": "क्वचिच्च चर्मवसनं क्वचिद्भिक्षाटनप्रियम् ।\nविटंकभूतानुचरं स्थाणुमुग्रं तमोगुणम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004139079, "chapter_id": 24139, "verse_number": "४-८८-८०", "content_sanskrit": "रुद्रं रौद्रपरीवारं महाकालवपुर्धरम् ।\nनृकरोटीपरिकरं जातिगोत्रविवर्जितम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004139080, "chapter_id": 24139, "verse_number": "४-८८-८१", "content_sanskrit": "न सम्यग्वेत्ति तं कश्चिज्जानानोपि प्रतारितः ।\nकिं बहूक्तेन तनये समस्त नयशालिनि ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004139081, "chapter_id": 24139, "verse_number": "४-८८-८२", "content_sanskrit": "क्व पांसुलपटच्छन्नो महाशंखविभूषणः ।\nप्रबद्धसर्पकेयूरः प्रलंबित जटासटः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004139082, "chapter_id": 24139, "verse_number": "४-८८-८३", "content_sanskrit": "डमड्डमरुकव्यग्र हस्ताग्रः खंडचंद्रभृत् ।\nतांडवाडंबररुचिः सर्वामंगल चेष्टितः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004139083, "chapter_id": 24139, "verse_number": "४-८८-८४", "content_sanskrit": "मृडानि सहरः क्वाऽयमध्वरो मंगलालयः ।\nअतएव समाहूता नेह त्वं सर्वमंगले ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004139084, "chapter_id": 24139, "verse_number": "४-८८-८५", "content_sanskrit": "दुकूलान्यनुकूलानि रत्नालंकृतयः शुभाः ।\nप्रागेव धारितास्तेत्र पश्यागत्य गृहाण च ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004139085, "chapter_id": 24139, "verse_number": "४-८८-८६", "content_sanskrit": "इह मंगलवेशेषु देवेंद्रेषु स शूलधृक् ।\nकथमर्हो भवेच्चेति मंगले विषमेक्षणः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004139086, "chapter_id": 24139, "verse_number": "४-८८-८७", "content_sanskrit": "इत्याकर्ण्य सती साध्वी जनेतुरुदितं तदा ।\nअत्यंतदूनहृदया वक्तुं समुपचक्रमे ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004139087, "chapter_id": 24139, "verse_number": "४-८८-८८", "content_sanskrit": "सत्युवाच ।\nनाकर्णितं मया किंचित्त्वयि प्रब्रुवति प्रभो ।\nपदद्वयीं समाकर्ण्य तां च ते कथयाम्यहम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004139088, "chapter_id": 24139, "verse_number": "४-८८-८९", "content_sanskrit": "न सम्यग्वेत्ति तं कश्चिज्जानानोपि प्रतारितः ।\nएतत्सम्यक्त्वयाख्यायि कस्तं वेत्ति सदाशिवम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004139089, "chapter_id": 24139, "verse_number": "४-८८-९०", "content_sanskrit": "त्वं तु प्रतारितः पूर्वमधुनापि प्रतारितः ।\nकृत्वा तेन च संबंधमसंबद्धप्रलापभाक् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004139090, "chapter_id": 24139, "verse_number": "४-८८-९१", "content_sanskrit": "यादृशं वक्षितं शंभुं तादृशं यद्यमन्यथाः ।\nकुतो मामददास्तस्मै यं च कश्च न वेद न ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004139091, "chapter_id": 24139, "verse_number": "४-८८-९२", "content_sanskrit": "अथवा तेन संबंधे न हेतुर्भवतो मतिः ।\nतत्र हेतुरभूत्तात मम पुण्यैकगौरवम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004139092, "chapter_id": 24139, "verse_number": "४-८८-९३", "content_sanskrit": "अथोक्त्वैवं बहुतरं त्वं जनेतास्य वर्ष्मणः ।\nश्रुतानेन च देहेन पत्युः परिविगर्हणा ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004139093, "chapter_id": 24139, "verse_number": "४-८८-९४", "content_sanskrit": "पुरश्चरणमेवैतद्यदस्यैव विसर्जनम् ।\nसुश्लाघ्यजन्मया तावत्प्राणितव्यं सुयोषिता ।\nयावज्जीवितनाथस्याश्रवणीया विगर्हणा ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004139094, "chapter_id": 24139, "verse_number": "४-८८-९५", "content_sanskrit": "इत्युक्त्वा क्रोधदीप्ताग्नौ महादेवस्वरूपिणि ।\nजुहाव देहसमिधं प्राणरोधविधानतः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004139095, "chapter_id": 24139, "verse_number": "४-८८-९६", "content_sanskrit": "ततो विवर्णतां प्राप्ताः सर्वे देवाः सवासवाः ।\nनाग्निर्जज्वाल च तथा यथाज्याहुतिभिः पुरा ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004139096, "chapter_id": 24139, "verse_number": "४-८८-९७", "content_sanskrit": "मंत्राः कुंठितसामर्थ्यास्तत्क्षणादेव चाभवन् ।\nअहो महानिष्टतरं किमेतत्समुपस्थितम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004139097, "chapter_id": 24139, "verse_number": "४-८८-९८", "content_sanskrit": "केचिदूचुर्द्विजवरा मिथः परियियासवः ।\nमहाझंझानिलः प्राप्तः पर्वतांदोलनक्षमः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004139098, "chapter_id": 24139, "verse_number": "४-८८-९९", "content_sanskrit": "मखमंडप भूस्तेन क्षणतः स्थपुटीकृता ।\nअकांडं तडिदापातो जातोभूद्भूप्रकपनः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004139099, "chapter_id": 24139, "verse_number": "४-८८-१००", "content_sanskrit": "दिवश्चोल्काः प्रपतिताः पिशाचा नृत्यमादधुः ।\nआतापिगृध्रैरुपरि गगने मंडलायितम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004139100, "chapter_id": 24139, "verse_number": "४-८८-१०१", "content_sanskrit": "रवेरधस्तादशिवं शिवास्तत्राप्यरारिषुः ।\nमेघारुधिरविपुड्भिस्तत्र वृष्टिं व्यधुः पराम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004139101, "chapter_id": 24139, "verse_number": "४-८८-१०२", "content_sanskrit": "निर्घातनिःस्वनो भूमेरुत्थितो हृत्प्रकंपनः ।\nदिव्यायुधानि च मिथो युध्यंति स्मातिभीषणम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004139102, "chapter_id": 24139, "verse_number": "४-८८-१०३", "content_sanskrit": "हवनीयं महद्रव्यं दूषितं क्रोष्टुभिः श्वभिः ।\nचकोराः करटास्तत्र विचेरुर्यज्ञमंडपे ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004139103, "chapter_id": 24139, "verse_number": "४-८८-१०४", "content_sanskrit": "श्मशानवाटवज्जातो यज्ञवाटः स वै क्षणात ।\nयद्यत्रावस्थितं सर्वं तत्तत्रैव परिष्ठितम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004139104, "chapter_id": 24139, "verse_number": "४-८८-१०५", "content_sanskrit": "चित्रन्यस्तमिवासीच्च वस्तुजातमशोभि च ।\nस्थगिता इव संवृत्तास्तत्र चक्रधरादयः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004139105, "chapter_id": 24139, "verse_number": "४-८८-१०६", "content_sanskrit": "दक्षोपि वदनग्लानिमवाप्य सपरिच्छदः ।\nपुनर्यथाकथंचिच्च यज्ञं प्रावर्तयन्द्विजाः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004139106, "chapter_id": 24139, "verse_number": "४-८८-१०७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां चतुर्थे काशीखंड उत्तरार्धे सतीदेहविसर्जनं नामाष्टाशीतितमोऽध्यायः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}]