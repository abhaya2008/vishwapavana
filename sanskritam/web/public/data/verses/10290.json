[{"id": 6000290000, "chapter_id": 10290, "verse_number": null, "content_sanskrit": "अथ चतुर्नवतितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000290001, "chapter_id": 10290, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.001.m4a", "display_order": 2}, {"id": 6000290002, "chapter_id": 10290, "verse_number": "१०-९४-१", "content_sanskrit": "देवासुरमनुष्येषु ये भजन्त्यशिवं शिवम्।\nप्रायस्ते धनिनो ब्रह्मन् न तु लक्ष्मीपतिं हरिम्॥ १०/९४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.002.m4a", "display_order": 3, "topics": [{"text": "शिवस्य क्षिप्रप्रसादविषये वृकासुरकथा", "range": "१–२२"}]}, {"id": 6000290003, "chapter_id": 10290, "verse_number": "१०-९४-२", "content_sanskrit": "एतद् वेदितुमिच्छामि सन्देहोऽत्र महान् हि नः।\nविरुद्धशीलयोः प्रभ्वोर्विरुद्धां भजतोर्गतिम्॥ १०/९४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.003.m4a", "display_order": 4}, {"id": 6000290004, "chapter_id": 10290, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.004.m4a", "display_order": 5}, {"id": 6000290005, "chapter_id": 10290, "verse_number": "१०-९४-३", "content_sanskrit": "शिवः शक्तियुतः शश्वत् त्रिलिङ्गो गुणसंवृतः।\nवैकारिकस्तैजसश्च तामसश्चेत्यहं त्रिधा॥ १०/९४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.005.m4a", "display_order": 6}, {"id": 6000290006, "chapter_id": 10290, "verse_number": "१०-९४-४", "content_sanskrit": "ततो विकारा अभवन् षोडशामीषु पञ्चसु।\nउपाधावन् विभूतीनां सर्वासामश्नुते गतिम्॥ १०/९४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.006.m4a", "display_order": 7}, {"id": 6000290007, "chapter_id": 10290, "verse_number": "१०-९४-५", "content_sanskrit": "हरिस्तु निर्गुणः साक्षात् पुरुषः प्रकृतेः परः।\nस सर्वदृगुपद्रष्टा तं भजन् निर्गुणो भवेत्॥ १०/९४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.007.m4a", "display_order": 8}, {"id": 6000290008, "chapter_id": 10290, "verse_number": "१०-९४-६", "content_sanskrit": "निवृत्तेष्वश्वमेधेषु राजा युष्मत्पितामहः।\nशृृण्वन् भगवतो धर्मानपृच्छदिदमच्युतम्॥ १०/९४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.008.m4a", "display_order": 9}, {"id": 6000290009, "chapter_id": 10290, "verse_number": "१०-९४-७", "content_sanskrit": "स चाह भगवांस्तस्मै प्रीतः शुश्रूषवे प्रभुः।\nनृणां निःश्रेयसार्थाय योऽवतीर्णो यदोः कुले॥ १०/९४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.009.m4a", "display_order": 10}, {"id": 6000290010, "chapter_id": 10290, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.010.m4a", "display_order": 11}, {"id": 6000290011, "chapter_id": 10290, "verse_number": "१०-९४-८", "content_sanskrit": "यस्याहमनुगृह्णामि हरिष्ये तद्धनं शनैः।\nततोऽधनं त्यजन्त्यस्य स्वजना दुःखदुःखितम्॥ १०/९४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.011.m4a", "display_order": 12}, {"id": 6000290012, "chapter_id": 10290, "verse_number": "१०-९४-९", "content_sanskrit": "स यदा वितथोद्योगो निर्विण्णः स्याद् धनेहया।\nमत्परैः कृतमैत्रस्य करिष्ये तदनुग्रहम्॥ १०/९४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.012.m4a", "display_order": 13}, {"id": 6000290013, "chapter_id": 10290, "verse_number": "१०-९४-१०", "content_sanskrit": "तद् ब्रह्म परमं सूक्ष्मं चिन्मात्रं सदनन्तकम्।\nअतो मां सुदुराराध्यं हित्वाऽन्यान् भजते पुनः॥ १०/९४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.013.m4a", "display_order": 14}, {"id": 6000290014, "chapter_id": 10290, "verse_number": "१०-९४-११", "content_sanskrit": "ततस्त आशुतोषेभ्यो लब्धराज्यश्रियोद्धताः।\nप्रमत्ता वरदान् देवान् विस्मरन्त्यवजानते॥ १०/९४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.014.m4a", "display_order": 15}, {"id": 6000290015, "chapter_id": 10290, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.015.m4a", "display_order": 16}, {"id": 6000290016, "chapter_id": 10290, "verse_number": "१०-९४-१२", "content_sanskrit": "शापप्रसादयोरीशा ब्रह्मविष्णुशिवादयः।\nसद्यः शापप्रसादोऽङ्ग शिवो ब्रह्मा च नाच्युतः॥ १०/९४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.016.m4a", "display_order": 17}, {"id": 6000290017, "chapter_id": 10290, "verse_number": "१०-९४-१३", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम्।\nवृकासुराय गिरिशो वरं दत्वाऽऽप सङ्कटम्॥ १०/९४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.017.m4a", "display_order": 18}, {"id": 6000290018, "chapter_id": 10290, "verse_number": "१०-९४-१४", "content_sanskrit": "वृको नामासुरः पुत्रः शकुनेः पथि नारदम्।\nदृष्ट्वाऽऽशुतोषं पप्रच्छ देवेषु त्रिषु दुर्मतिः॥ १०/९४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.018.m4a", "display_order": 19}, {"id": 6000290019, "chapter_id": 10290, "verse_number": "१०-९४-१५", "content_sanskrit": "स आदिदेश गिरिशमुपाधावस्व सिद्धये।\nसोऽल्पाभ्यां गुणदोषाभ्यामाशु तुष्यति कुप्यति॥ १०/९४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.019.m4a", "display_order": 20}, {"id": 6000290020, "chapter_id": 10290, "verse_number": "१०-९४-१६", "content_sanskrit": "दशास्यबाणयोस्तुष्टः स्तुवतोर्बन्दिनोरिव।\nऐश्वर्यमतुलं दत्त्वा तत आप सुसङ्कटम्॥ १०/९४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.020.m4a", "display_order": 21}, {"id": 6000290021, "chapter_id": 10290, "verse_number": "१०-९४-१७", "content_sanskrit": "इत्यादिष्टस्तमसुर उपाधावत् सुयन्त्रितः।\nकेदार आत्मक्रव्येण जुह्वन्नग्निमुखं हरम्॥ १०/९४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.021.m4a", "display_order": 22}, {"id": 6000290022, "chapter_id": 10290, "verse_number": "१०-९४-१८", "content_sanskrit": "देवोपलब्धिमप्राप्य निर्वेदात् सप्तमेऽहनि।\nशिरो जिहीर्षुरसिना स तीर्थक्लिन्नमूर्धजः॥ १०/९४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.022.m4a", "display_order": 23}, {"id": 6000290023, "chapter_id": 10290, "verse_number": "१०-९४-१९", "content_sanskrit": "तदा महाकारुणिकः स धूर्जटिर्यथाऽवयव्यग्निरिवोत्थितोऽनलात्।\nनिगृह्य दोर्भ्यां भुजयोर्न्यवारयत् तत्स्पर्शनाद् भूय उपाकृताकृतिः॥ १०/९४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.023.m4a", "display_order": 24}, {"id": 6000290024, "chapter_id": 10290, "verse_number": "१०-९४-२०", "content_sanskrit": "तमाह चाङ्गालमलं वृणीष्व मे यथानिकामं वितरामि ते वरम्।\nशिवेन जीवेन नृणां प्रपद्यतामहो त्वयाऽऽत्मा भृशमर्द्यते वृथा॥ १०/९४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.024.m4a", "display_order": 25}, {"id": 6000290025, "chapter_id": 10290, "verse_number": "१०-९४-२१", "content_sanskrit": "देवात् स वव्रे पापीयान् वरं भूतभयावहम्।\nयस्य पुंसः करं शीर्ष्णि धास्ये स म्रियतामिति॥ १०/९४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.025.m4a", "display_order": 26}, {"id": 6000290026, "chapter_id": 10290, "verse_number": "१०-९४-२२", "content_sanskrit": "तच्छ्रुत्वा भगवान् रुद्रो दुर्मना इव भारत।\nओमिति प्रहसंस्तस्मै ददौ वरमृतं तथा॥ १०/९४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.026.m4a", "display_order": 27}, {"id": 6000290027, "chapter_id": 10290, "verse_number": "१०-९४-२३", "content_sanskrit": "स तद्वरपरीक्षार्थं शम्भोः शीर्ष्णि वृकासुरः।\nस्वहस्तं दातुमारेभे सोऽबिभेत् स्वकृताच्छिवः॥ १०/९४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.027.m4a", "display_order": 28, "topics": [{"text": "भगवता शिवस्य सङ्कटान्मोचनम्", "range": "२३–४०"}]}, {"id": 6000290028, "chapter_id": 10290, "verse_number": "१०-९४-२४", "content_sanskrit": "तेनोपसृष्टः सन्त्रस्तः पराधावत् सवेपथुः।\nयावदन्तं दिवो भूमेः कोष्ठानामधरं भुवः॥ १०/९४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.028.m4a", "display_order": 29}, {"id": 6000290029, "chapter_id": 10290, "verse_number": "१०-९४-२५", "content_sanskrit": "अजानन्तः प्रतिविधिं तूष्णीमासन् सुरेश्वराः।\nततो वैकुण्ठमगमद् भास्वरं तमसः परम्॥ १०/९४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.029.m4a", "display_order": 30}, {"id": 6000290030, "chapter_id": 10290, "verse_number": "१०-९४-२६", "content_sanskrit": "यत्र नारायणः साक्षान्न्यासिनां परमा गतिः।\nशान्तानां न्यस्तदण्डानां यतो नावर्तते गतः॥ १०/९४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.030.m4a", "display_order": 31}, {"id": 6000290031, "chapter_id": 10290, "verse_number": "१०-९४-२७", "content_sanskrit": "तं तथा व्यसनं दृष्ट्वा भगवान् वृजिनार्दनः।\nदूरात् प्रत्युदितो भूप दारको योगमायया॥ १०/९४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.031.m4a", "display_order": 32}, {"id": 6000290032, "chapter_id": 10290, "verse_number": "१०-९४-२८", "content_sanskrit": "मेखलाजिनदण्डाद्यैस्तेजसाऽग्निरिव ज्वलन्।\nअभिवादयामास च तं कुशपाणिर्विनीतवत्॥ १०/९४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.032.m4a", "display_order": 33}, {"id": 6000290033, "chapter_id": 10290, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.033.m4a", "display_order": 34}, {"id": 6000290034, "chapter_id": 10290, "verse_number": "१०-९४-२९", "content_sanskrit": "शाकुनेय भवान् व्यक्तं श्रान्तः किं दूरमागतः।\nक्षणं विश्रम्यतां पुंस आत्माऽयं सर्वकामधुक्॥ १०/९४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.034.m4a", "display_order": 35}, {"id": 6000290035, "chapter_id": 10290, "verse_number": "१०-९४-३०", "content_sanskrit": "यदि नः श्रवणायालं युष्मद्व्यवसितं विभो।\nभण्यतां पुरुषः साधो पुम्भिः स्वार्थः समीहते॥ १०/९४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.035.m4a", "display_order": 36}, {"id": 6000290036, "chapter_id": 10290, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.036.m4a", "display_order": 37}, {"id": 6000290037, "chapter_id": 10290, "verse_number": "१०-९४-३१", "content_sanskrit": "एवं भगवता पृष्टो वचसाऽमृतवर्षिणा।\nगतक्लमोऽब्रवीत् तस्मै यथापूर्वमनुष्ठितम्॥ १०/९४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.037.m4a", "display_order": 38}, {"id": 6000290038, "chapter_id": 10290, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.038.m4a", "display_order": 39}, {"id": 6000290039, "chapter_id": 10290, "verse_number": "१०-९४-३२", "content_sanskrit": "एवं चेत् तर्हि तद्वाक्यं वयं न श्रद्दधीमहि।\nयो दक्षशापात् पैशाच्यं प्राप्तः प्रेतपिशाचराट्॥ १०/९४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.039.m4a", "display_order": 40}, {"id": 6000290040, "chapter_id": 10290, "verse_number": "१०-९४-३३", "content_sanskrit": "रुषाक्रान्तशरीरोऽसौ न सत्यं वदते हरः।\nक्रोधयुक्ते कुतः सत्यं मूढोऽसि त्वं महासुर॥ १०/९४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.040.m4a", "display_order": 41}, {"id": 6000290041, "chapter_id": 10290, "verse_number": "१०-९४-३४", "content_sanskrit": "यदि वस्तत्र विश्रम्भो दानवेन्द्र जगद्गुरौ।\nतर्ह्यङ्गापि स्वशिरसि हस्तन्यासः प्रदीयताम्॥ १०/९४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.041.m4a", "display_order": 42}, {"id": 6000290042, "chapter_id": 10290, "verse_number": "१०-९४-३५", "content_sanskrit": "यद्यसत्यं वचः शम्भोः कथञ्चिद् दानवर्षभ।\nतदैैनं जह्यसद्वाचं न च वक्ताऽनृतं पुनः॥ १०/९४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.042.m4a", "display_order": 43}, {"id": 6000290043, "chapter_id": 10290, "verse_number": "१०-९४-३६", "content_sanskrit": "इत्थं भगवतश्चित्रैर्वचोभिश्च सुपेशलैः।\nभिन्नधीर्विस्मृतः शीर्ष्णि स्वहस्तं कुमतिर्व्यधात्॥ १०/९४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.043.m4a", "display_order": 44}, {"id": 6000290044, "chapter_id": 10290, "verse_number": "१०-९४-३७", "content_sanskrit": "अथापतद् भिन्नशिरा वज्राहत इव क्षणात्।\nजयशब्दो नमःशब्दः साधुशब्दोऽभवत् भुवि॥ १०/९४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.044.m4a", "display_order": 45}, {"id": 6000290045, "chapter_id": 10290, "verse_number": "१०-९४-३८", "content_sanskrit": "मुमुचुः पुष्पवर्षाणि हते पापे वृकासुरे।\nदेवर्षिपितृगन्धर्वा मोचितः सङ्कटाच्छिवः॥ १०/९४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.045.m4a", "display_order": 46}, {"id": 6000290046, "chapter_id": 10290, "verse_number": "१०-९४-३९", "content_sanskrit": "मुक्तं गिरिशमप्याह भगवान् पुरुषोत्तमः।\nअहो देव महादेव पापोऽयं स्वेन पाप्मना॥ १०/९४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.046.m4a", "display_order": 47}, {"id": 6000290047, "chapter_id": 10290, "verse_number": "१०-९४-४०", "content_sanskrit": "हतः को नु कुतश्चापि जन्तुर्वै कृतकिल्बिषः।\nक्षेमी स्यात् किमु विश्वेशे कृतपापो जगद्गुरौ॥ १०/९४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.047.m4a", "display_order": 48}, {"id": 6000290048, "chapter_id": 10290, "verse_number": "१०-९४-४१", "content_sanskrit": "य एवमव्याकृतशक्त्युदन्वतः परस्य साक्षात् परमात्मनो हरेः।\nगिरीशमोक्षं कथयेत् शृणोति वा विमुच्यते संसृतिभिस्तथाऽरिभिः॥ १०/९४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_094/BhP_10.094.048.m4a", "display_order": 49}, {"id": 6000290049, "chapter_id": 10290, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे चतुर्नवतितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]