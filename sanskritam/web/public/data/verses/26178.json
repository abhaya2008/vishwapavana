[{"id": 7006178000, "chapter_id": 26178, "verse_number": "२-६-१", "content_sanskrit": "सूत उवाच अभवन्दनुपुत्रास्तु वंशे ख्याता महासुराः ।\nविप्रचित्तिप्रधा नास्तेऽचिन्तनीयपराक्रमाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006178001, "chapter_id": 26178, "verse_number": "२-६-२", "content_sanskrit": "सर्वे लब्धवराश्चैव ते तप्ततपसस्तथा ।\nसत्यसंधाः पराक्रान्ताः क्रूरा मायाविनश्च ते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006178002, "chapter_id": 26178, "verse_number": "२-६-३", "content_sanskrit": "महाबलास्ते जवना ब्रह्मिष्ठा ये च साग्नयः ।\nकीर्त्यमानान्मया सर्वान्प्राधान्येन निबोधत ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006178003, "chapter_id": 26178, "verse_number": "२-६-४", "content_sanskrit": "द्विमूर्द्धा शंबरश्चैव तथा शङ्कुरथो विभुः ।\nशङ्कुकर्णो विपादश्च गविष्ठो दुन्दुभिस्तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006178004, "chapter_id": 26178, "verse_number": "२-६-५", "content_sanskrit": "अयोमुखस्तु मघवान्कपिलो वामनो मयः ।\nमरीचिरसिपाश्चैव महा मायोऽशिरा भृशी ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006178005, "chapter_id": 26178, "verse_number": "२-६-६", "content_sanskrit": "विक्षोभश्च सुकेतुश्च केतुवीर्यशताह्वयौ ।\nइन्द्रजिद्विविदश्चैव तथा भद्रश्च देवजित् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006178006, "chapter_id": 26178, "verse_number": "२-६-७", "content_sanskrit": "एकचक्रो महा बाहुस्तारकश्च महाबलः ।\nवैश्वानरः पुलोमा च प्रापणोऽथ महाशिराः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006178007, "chapter_id": 26178, "verse_number": "२-६-८", "content_sanskrit": "स्वर्भानुर्वृषपर्वा च पुरुण्डश्च महासुरः ।\nधृतराष्ट्रश्च सूर्यश्चचन्द्रमा इन्द्रतापनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006178008, "chapter_id": 26178, "verse_number": "२-६-९", "content_sanskrit": "सूक्ष्मश्चैव निचन्द्रश्च चूर्णनाभो महागिरिः ।\nअसिलोमा सुकेशश्च शठश्च मूलकोदरः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006178009, "chapter_id": 26178, "verse_number": "२-६-१०", "content_sanskrit": "जम्भो गगनमूर्द्धा चकुंभमानो महोदकः ।\nप्रमदोऽद्मश्च कुपथो ह्यश्वग्रीवश्च वीर्यवान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006178010, "chapter_id": 26178, "verse_number": "२-६-११", "content_sanskrit": "वैमृगः सविरूपाक्षः सुपथश्च हला हलौ ।\nअक्षो हिरण्मयश्चैव शतग्रीवश्च शंबरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006178011, "chapter_id": 26178, "verse_number": "२-६-१२", "content_sanskrit": "शरभः श्वलभश्चैव सूर्याचन्द्रमसावुभौ ।\nअसुराणां स्मृतावेतौ सुराणां च प्रभाविणौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006178012, "chapter_id": 26178, "verse_number": "२-६-१३", "content_sanskrit": "इति पुत्रा दनोर्वंशप्रधानाः परिकीर्त्तिताः ।\nतेषामपरिसंख्येयं पुत्रपौत्रमनन्तकम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006178013, "chapter_id": 26178, "verse_number": "२-६-१४", "content_sanskrit": "इत्येत असुराः तक्रान्ता दैतेया दानवास्तथा ।\nसुत्वानस्तु स्मृता दैत्या असुत्वानो दनोः सुताः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006178014, "chapter_id": 26178, "verse_number": "२-६-१५", "content_sanskrit": "इमे च वंशानुगता दनोः पुत्रान्वयाः स्मृताः ।\nएकाक्षेश्वप्रभारिष्टः प्रलंबनरकावपि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006178015, "chapter_id": 26178, "verse_number": "२-६-१६", "content_sanskrit": "इन्द्रबाधनकेशी च पुरुषः शेषवानुरुः ।\nगरिष्ठश्च गवाक्षश्च तालकेतुश्च वीर्यवान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006178016, "chapter_id": 26178, "verse_number": "२-६-१७", "content_sanskrit": "एते मनुष्या वध्यास्तु दनुपुत्रान्वयाः स्मृताः ।\nदैत्यदानवसंयोगे जाता भीमपराक्रमाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006178017, "chapter_id": 26178, "verse_number": "२-६-१८", "content_sanskrit": "सिंहिकायामथोत्पन्ना विप्रचित्तेः सुता इमे ।\nसैंहिकेयाः समाख्याताश्चतुर्दश महासुराः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006178018, "chapter_id": 26178, "verse_number": "२-६-१९", "content_sanskrit": "शलश्च शलभश्चैव सव्यसिव्यस्तथैव च ।\nइल्वलो नमुचिश्चैव वातापिस्तु सुपुञ्जिकः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006178019, "chapter_id": 26178, "verse_number": "२-६-२०", "content_sanskrit": "रहकल्पः कालनाभो भौमश्च कनकस्तथा ।\nराहुर्ज्येष्ठस्तु तेषां वै सूर्यचन्द्रप्रमर्द्दनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006178020, "chapter_id": 26178, "verse_number": "२-६-२१", "content_sanskrit": "इत्योते सिंहिकापुत्रा देवैरपि दुरासदाः ।\nदारुणाभिजनाः क्रूराः सर्वे ब्रह्महणश्च ते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006178021, "chapter_id": 26178, "verse_number": "२-६-२२", "content_sanskrit": "दश तानि सहस्राणिसैंहिकेया गणाः स्मृताः ।\nनिहता जामदग्न्येन भार्गवेण बलीयसा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006178022, "chapter_id": 26178, "verse_number": "२-६-२३", "content_sanskrit": "स्वर्भानोस्तु प्रभा कन्या पुलोम्नस्तु शची सुता ।\nउपदानवी सदस्याथ शर्मिष्ठा वृषपर्वणः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006178023, "chapter_id": 26178, "verse_number": "२-६-२४", "content_sanskrit": "पुलोमा कालिका चैव वैश्वानरसुते उभे ।\nप्रभायां नहुषः पुत्रो जयन्तस्तु शचीसुतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006178024, "chapter_id": 26178, "verse_number": "२-६-२५", "content_sanskrit": "पुरुं जज्ञेऽथ शर्मिष्ठा दुष्यन्तसुपदानवी ।\nवैश्वानरसुते एते पुलोमा कालका तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006178025, "chapter_id": 26178, "verse_number": "२-६-२६", "content_sanskrit": "बह्वपत्ये उभे कन्ये मारीचस्य परिग्रहः ।\nतयोः पुत्रसहस्राणि षष्टिर्दानवपुङ्गवाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006178026, "chapter_id": 26178, "verse_number": "२-६-२७", "content_sanskrit": "चतुर्दश तथान्यानि हिरण्यपुरवासिनाम् ।\nपौलोमाः कालकेयाश्च दानवाः सुमरा बलाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006178027, "chapter_id": 26178, "verse_number": "२-६-२८", "content_sanskrit": "अवध्या देवतानां ते निहताः सव्यमाचिना ।\nमयस्य जाता रंभायां पुत्राः षट्च महाबलाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006178028, "chapter_id": 26178, "verse_number": "२-६-२९", "content_sanskrit": "मायावी दुन्दुभिश्चैव पुत्रश्च महिषस्तथा ।\nकालिकश्चाजकर्णश्चकन्या मन्दोदरी तथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006178029, "chapter_id": 26178, "verse_number": "२-६-३०", "content_sanskrit": "दैत्यानां दानवानां च सर्ग एष प्रकीर्त्तितः ।\nअनायुषायाः पुत्रास्ते स्मृताः पञ्च महाबलाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006178030, "chapter_id": 26178, "verse_number": "२-६-३१", "content_sanskrit": "अररुर्बलवृत्रौ च विज्वरश्च वृषस्तथा ।\nअररोस्तनयः क्रूरो धुन्धुर्नाम महासुरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006178031, "chapter_id": 26178, "verse_number": "२-६-३२", "content_sanskrit": "निहतः कुवलाश्वेन उत्तङ्कवचनाद्बिले ।\nबलपुत्रौ महावीर्यौं तेजसाप्रतिमावुभौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006178032, "chapter_id": 26178, "verse_number": "२-६-३३", "content_sanskrit": "निकुंभश्चक्रवर्मा च स कर्णः पूर्वजन्मनि ।\nविजरस्यापि पुत्रौ द्वौ कालकश्च खरश्च तौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006178033, "chapter_id": 26178, "verse_number": "२-६-३४", "content_sanskrit": "वृषस्य तु पुनः पुत्राश्चत्वारः क्रूरकर्मणः ।\nश्राद्धादो यज्ञहा चैव ब्रह्महा पशुहा तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006178034, "chapter_id": 26178, "verse_number": "२-६-३५", "content_sanskrit": "क्रान्ता ह्यनायुषः पुत्रा वृत्र स्यापि निबोधत ।\nजज्ञिरेऽसुमहाघोरा वृत्रस्येन्द्रेण युध्यता ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006178035, "chapter_id": 26178, "verse_number": "२-६-३६", "content_sanskrit": "बका नाम समाख्याता राक्षसाः सुमहाबलाः ।\nशतं तानि सहस्राणि महेन्द्रानुचराः स्मृताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006178036, "chapter_id": 26178, "verse_number": "२-६-३७", "content_sanskrit": "सर्वे ब्रह्मविदः सौम्या धार्मिकाः सूक्ष्ममूर्त्तयः ।\nप्रजास्वन्तर्गताः सर्वे निवसंति क्रुधावृताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006178037, "chapter_id": 26178, "verse_number": "२-६-३८", "content_sanskrit": "क्रोधा त्वप्रतिमान्पुत्रान् जज्ञे वै गायनोत्तमान् ।\nसिद्धः पूर्णश्च वह्वीच पूर्णाशश्चैव वीर्यवान् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006178038, "chapter_id": 26178, "verse_number": "२-६-३९", "content_sanskrit": "ब्रह्मचारी शतगुणः सुपर्णश्चैव मप्तमः ।\nविश्वावसुश्च भानुश्च सुचन्द्रो दशमस्तथा ।\nइत्येते देवगन्धर्वाः क्रोधायाः परिरीर्त्तिताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]