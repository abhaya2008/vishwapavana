[{"id": 5000546000, "chapter_id": 9546, "verse_number": "७-११-१", "content_sanskrit": "सुमाली वरलब्धांस्तु ज्ञात्वा चैतान्निशाचरान् ।\nउदतिष्ठद्भयं त्यक्त्वा सानुगः स रसातलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000546001, "chapter_id": 9546, "verse_number": "७-११-२", "content_sanskrit": "मारीचश्च प्रहस्तश्च विरूपाक्षो महोदरः ।\nउदतिष्ठन्सुसंरब्धाः सचिवास्तस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000546002, "chapter_id": 9546, "verse_number": "७-११-३", "content_sanskrit": "सुमाली सचिवैः सार्धं वृतो राक्षसपुङ्गवैः ।\nअभिगम्य दशग्रीवं परिष्वज्येदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000546003, "chapter_id": 9546, "verse_number": "७-११-४", "content_sanskrit": "दिष्ट्या ते वत्स सम्प्राप्तश्चिन्तितो ऽयं मनोरथः ।\nयस्त्वं त्रिभुवनश्रेष्ठाल्लब्धवान्वरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000546004, "chapter_id": 9546, "verse_number": "७-११-५", "content_sanskrit": "यत्कृते च वयं लङ्कां त्यकत्वा याता रसातलम् ।\nतद्गतं नो महाबाहो महद्विष्णुकृतं भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000546005, "chapter_id": 9546, "verse_number": "७-११-६", "content_sanskrit": "असकृत्तद्भयाद्भीताः परित्यज्य स्वमालयम् ।\nविद्रुताः सहिताः सर्वे प्रविष्टाः स्म रसातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000546006, "chapter_id": 9546, "verse_number": "७-११-७", "content_sanskrit": "अस्मदीया च लङ्केयं नगरी राक्षसोचिता ।\nनिवेशिता तव भ्रात्रा धनाध्यक्षेण धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000546007, "chapter_id": 9546, "verse_number": "७-११-८", "content_sanskrit": "यदि नामात्र शक्यं स्यात्साम्ना दानेन वानघ ।\nतरसा वा महाबाहो प्रत्यानेतुं कृतं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000546008, "chapter_id": 9546, "verse_number": "७-११-९", "content_sanskrit": "त्वं तु लङ्केश्वरस्तात भविष्यसि न संशयः ।\nत्वया राक्षसवंशो ऽयं निमग्नो ऽपि समुद्धृतः ।\nसर्वेषां नः प्रभुश्चैव भविष्यसि महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000546009, "chapter_id": 9546, "verse_number": "७-११-१०", "content_sanskrit": "अथाब्रवीद्दशग्रीवो मातामहमुपस्थितम् ।\nवित्तेशो गुरुरस्माकं नार्हसे वक्तुमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000546010, "chapter_id": 9546, "verse_number": "७-११-११", "content_sanskrit": "साम्नापि राक्षसेन्द्रेण प्रत्याख्यातो गरीयसा ।\nकिञ्चिन्नाह तदा रक्षो ज्ञात्वा तस्य चकीर्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000546011, "chapter_id": 9546, "verse_number": "७-११-१२", "content_sanskrit": "कस्यचित्त्वथ कालस्य वसन्तं रावणं ततः ।\nउक्तवन्तं तथा वाक्यं दशग्रीवं निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000546012, "chapter_id": 9546, "verse_number": "७-११-१३", "content_sanskrit": "प्रहस्तः प्रश्रितं वाक्यमिदमाह स कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000546013, "chapter_id": 9546, "verse_number": "७-११-१४", "content_sanskrit": "दशग्रीव महाबाहो नार्हस्त्वं वक्तुमीदृशम् ।\nसौभ्रात्रं नास्ति शूराणां शृणु चेदं वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000546014, "chapter_id": 9546, "verse_number": "७-११-१५", "content_sanskrit": "अदितिश्च दितिश्चैव भगिन्यौ सहिते हि ते ।\nभार्ये परमरूपिण्यौ कश्यपस्य प्रजापतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000546015, "chapter_id": 9546, "verse_number": "७-११-१६", "content_sanskrit": "अदितिर्जनयामास देवांस्त्रिभुवनेश्वरान् ।\nदितिस्त्वजनयत्पुत्रान्कश्यपस्यात्मसम्भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000546016, "chapter_id": 9546, "verse_number": "७-११-१७", "content_sanskrit": "दैत्यानां किल धर्मज्ञ पुरीयं सवनार्णवा ।\nसपर्वता मही वीर ते ऽभवन्प्रभविष्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000546017, "chapter_id": 9546, "verse_number": "७-११-१८", "content_sanskrit": "निहत्य तांस्तु समरे विष्णुना प्रभविष्णुना ।\nदेवानां वशमानीतं त्रैलोक्यमिदमव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000546018, "chapter_id": 9546, "verse_number": "७-११-१९", "content_sanskrit": "नैतदेको भवानेव करिष्यति विपर्ययम् ।\nसुरासुरैराचरितं तत्कुरुष्व वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000546019, "chapter_id": 9546, "verse_number": "७-११-२०", "content_sanskrit": "एवमुक्तो दशग्रीवः प्रहृष्टेनान्तरात्मना ।\nचिन्तयित्वा मुहूर्तं वै बाढमित्येव सो ऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000546020, "chapter_id": 9546, "verse_number": "७-११-२१", "content_sanskrit": "स तु तेनैव हर्षेण तस्मिन्नहनि वीर्यवान् ।\nवनं गतो दशग्रीवः सह तैः क्षणदाचरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000546021, "chapter_id": 9546, "verse_number": "७-११-२२", "content_sanskrit": "त्रिकूटस्थः स तु तदा दशग्रीवो निशाचरः ।\nप्रेषयामास दौत्येन प्रहस्तं वाक्यकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000546022, "chapter_id": 9546, "verse_number": "७-११-२३", "content_sanskrit": "प्रहस्त शीघ्रं गच्छ त्वं ब्रूहि नैर्ऋतपुङ्गवम् ।\nवचसा मम वित्तेशं सामपूर्वमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000546023, "chapter_id": 9546, "verse_number": "७-११-२४", "content_sanskrit": "इयं लङ्का पुरी राजन्राक्षसानां महात्मनाम् ।\nत्वया निवेशिता सौम्य नैतद्युक्तं तवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000546024, "chapter_id": 9546, "verse_number": "७-११-२५", "content_sanskrit": "तद्भवान्यदि नो ह्यद्य दद्यादतुलविक्रम ।\nकृता भवेन्मम प्रीतिर्धुर्मश्चैवानुपालितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000546025, "chapter_id": 9546, "verse_number": "७-११-२६", "content_sanskrit": "स तु गत्वा पुरीं लङ्कां धनदेन सुरक्षिताम् ।\nअब्रवीत्परमोदारं वित्तपालमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000546026, "chapter_id": 9546, "verse_number": "७-११-२७", "content_sanskrit": "प्रेषितो ऽहं तव भ्रात्रा दशग्रीवेण सुव्रत ।\nत्वत्समीपं महाबाहो सर्वशस्त्रभृतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000546027, "chapter_id": 9546, "verse_number": "७-११-२८", "content_sanskrit": "तच्छ्रूयतां महाप्राज्ञ सर्वशास्त्रविशारद ।\nवचनं मम वित्तेश यद्ब्रवीति दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000546028, "chapter_id": 9546, "verse_number": "७-११-२९", "content_sanskrit": "इयं किल पुरी रम्या सुमालिप्रमुखैः पुरा ।\nभुक्तपूर्वा विशालाक्ष राक्षसैर्भीमविक्रमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000546029, "chapter_id": 9546, "verse_number": "७-११-३०", "content_sanskrit": "तेन विज्ञाप्यते सो ऽयं साम्प्रतं विश्रवात्मज ।\nतदेषा दीयतां तात याचतस्तस्य सामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000546030, "chapter_id": 9546, "verse_number": "७-११-३१", "content_sanskrit": "प्रहस्तादभिसंश्रुत्य देवो वैश्रवणो वचः ।\nप्रत्युवाच प्रहस्तं तं वाक्यं वाक्यविशारदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000546031, "chapter_id": 9546, "verse_number": "७-११-३२", "content_sanskrit": "दत्ता ममेयं पित्रा तु लङ्का शून्या निशाचरैः ।\nनिवासिते च मे यक्षैर्दानमानादिभिर्गुणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000546032, "chapter_id": 9546, "verse_number": "७-११-३३", "content_sanskrit": "ब्रूहि गच्छ दशग्रीवं पुरं राज्यं च यन्मम ।\nतवाप्येतन्महाबाहो भुङ्क्ष्व राज्यमकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000546033, "chapter_id": 9546, "verse_number": "७-११-३४", "content_sanskrit": "एवमुक्त्वा धनाध्यक्षो जगाम पितुरन्तिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000546034, "chapter_id": 9546, "verse_number": "७-११-३५", "content_sanskrit": "अभिवाद्य गुरुं प्राह रावणस्य यदीप्सितम् ।\nएष तात दशग्रीवो दूतं प्रेषितवान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000546035, "chapter_id": 9546, "verse_number": "७-११-३६", "content_sanskrit": "दीयतां नगरी लङ्का पूर्वं रक्षोगणोषिता ।\nमयात्र यदनुष्ठेयं तन्ममाचक्ष्व सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000546036, "chapter_id": 9546, "verse_number": "७-११-३७", "content_sanskrit": "ब्रह्मर्षिस्त्वेवमुक्तो ऽसौ विश्रवा मुनिपुङ्गवः ।\nप्राञ्जलिं धनदं प्राह शृणु पुत्र वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000546037, "chapter_id": 9546, "verse_number": "७-११-३८", "content_sanskrit": "दशग्रीवो महाबाहुरुक्तवान्मम सन्निधौ ।\nमया निर्भर्त्सितश्चासीद्बहुशोक्तः सुदुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000546038, "chapter_id": 9546, "verse_number": "७-११-३९", "content_sanskrit": "स क्रोधेन मया चोक्तो ध्वंसते च पुनः पुनः ।\nश्रेयो ऽभियुक्तं धर्म्यं च शृणु पुत्र वचो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000546039, "chapter_id": 9546, "verse_number": "७-११-४०", "content_sanskrit": "वरप्रदानसम्मूढो मान्या ऽमान्यान् स दुर्मतिः ।\nन वेत्ति मम शापाच्च प्रकृतिं दारुणां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000546040, "chapter_id": 9546, "verse_number": "७-११-४१", "content_sanskrit": "तस्माद्गच्छ महाबाहो कैलासं धरणीधरम् ।\nनिवेशय निवासार्थं त्यक्त्वा लङ्कां सहानुगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000546041, "chapter_id": 9546, "verse_number": "७-११-४२", "content_sanskrit": "तत्र मन्दाकिनी रम्या नदीनामुत्तमा नदी ।\nकाञ्चनैः सूर्यसङ्काशैः पङ्कजैः संवृतोदका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000546042, "chapter_id": 9546, "verse_number": "७-११-४३", "content_sanskrit": "कुमुदैरुत्पलैश्चैव तथा ऽन्यैश्च सुगन्धिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000546043, "chapter_id": 9546, "verse_number": "७-११-४४", "content_sanskrit": "तत्र देवाः सगन्धर्वाः साप्सरोरगकिंनराः ।\nविहारशीलाः सततं रमन्ते सर्वदा ऽ ऽश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000546044, "chapter_id": 9546, "verse_number": "७-११-४५", "content_sanskrit": "न हि क्षमं तवानेन वैरं धनद रक्षसा ।\nजानीषे हि यथा ऽनेन लब्धः परमको वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000546045, "chapter_id": 9546, "verse_number": "७-११-४६", "content_sanskrit": "एवमुक्तो गृहीत्वा ऽ ऽशु तद्वचः पितृगौरवात् ।\nसदारपुत्रः सामान्यः सवाहनधनो गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000546046, "chapter_id": 9546, "verse_number": "७-११-४७", "content_sanskrit": "प्रहस्तो ऽथ दशग्रीवं गत्वा वचनमब्रवीत् ।\nप्रहृष्टात्मा महात्मानं सहामात्यं सहानुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000546047, "chapter_id": 9546, "verse_number": "७-११-४८", "content_sanskrit": "शून्या सा नगरी लङ्का त्यक्त्त्वैनां धनदो गतः ।\nप्रविश्य तां सहास्माभिः स्वधर्मं प्रतिपालय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000546048, "chapter_id": 9546, "verse_number": "७-११-४९", "content_sanskrit": "एवमुक्तो दशग्रीवः प्रहस्तेन महाबलः ।\nविवेश नगरीं लङ्कां भ्रातृभिः सबलानुगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000546049, "chapter_id": 9546, "verse_number": "७-११-५०", "content_sanskrit": "धनदेन परित्यक्तां सुविभक्तमहापथाम् ।\nआरुरोह स देवारिः स्वर्गं देवाधिपो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000546050, "chapter_id": 9546, "verse_number": "७-११-५१", "content_sanskrit": "स चाभिषिक्तः क्षणदाचरैस्तदा निवेशयामास पुरीं दशाननः ।\nनिकामपूर्णा च बभूव सा पुरी निशाचरैर्नीलबलाहकोपमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000546051, "chapter_id": 9546, "verse_number": "७-११-५२", "content_sanskrit": "धनेश्वरस्त्वथ पितृवाक्यगौरवान्न्यवेशयच्छशिविमले गिरौ पुरीम् ।\nस्वलङ्कृतैर्भवनवरैर्विभूषितां पुरन्दरस्वेव तदा ऽमरावतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000546052, "chapter_id": 9546, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे एकादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]