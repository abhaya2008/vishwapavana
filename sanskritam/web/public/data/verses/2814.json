[{"id": 2085233, "chapter_id": 2814, "verse_number": "१२-३१९-०x", "content_sanskrit": "याज्ञवल्क्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085234, "chapter_id": 2814, "verse_number": "१२-३१९-१", "content_sanskrit": "एते प्रधानस्य गुणास्त्रयः पुरुषसत्तम।\nकृत्स्नस्य चैव जगतस्तिष्ठन्त्यनपगाः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085235, "chapter_id": 2814, "verse_number": "१२-३१९-२", "content_sanskrit": "अव्यक्तरूपो भगवाञ्शतधा च सहस्रधा।\nशतधा सहस्रधा चैव तथा शतसहस्रधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085236, "chapter_id": 2814, "verse_number": "१२-३१९-३", "content_sanskrit": "कोटिशश्च करोत्येव प्रकृत्याऽऽत्मानमात्मना।\nसात्विकरणोत्तमं स्थानं राजसस्येह मध्यमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085237, "chapter_id": 2814, "verse_number": "१२-३१९-४", "content_sanskrit": "तामसस्वाधमं स्थानं प्राहुरध्यात्मचिन्तकाः।\nकेवलेनेह पुण्येन भतिभूर्ध्वामवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085238, "chapter_id": 2814, "verse_number": "१२-३१९-५", "content_sanskrit": "पुण्यपापेन मानुष्यमधर्मेणाप्यघोगतिम्।\nद्वन्द्वनेषां त्रयाणां तु सन्निपातं च तत्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085239, "chapter_id": 2814, "verse_number": "१२-३१९-६", "content_sanskrit": "सत्वस्य रजसश्चैव तमसश्च शृणुष्व मे।\nसत्वस्य तु रजो दृष्टं रजसश्च तमस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085240, "chapter_id": 2814, "verse_number": "१२-३१९-७", "content_sanskrit": "तमसश्च तथा सत्वं सत्वस्याव्यक्तमेव च।\nअध्यक्तः सत्वसंयुक्तो देवलोकमयाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085241, "chapter_id": 2814, "verse_number": "१२-३१९-८", "content_sanskrit": "रवासत्वसमायुक्तो मानुषेषु प्रपद्यते।\nरसस्तमोभ्यां संयुक्तस्तिर्यग्योनिषु जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085242, "chapter_id": 2814, "verse_number": "१२-३१९-९", "content_sanskrit": "राजसैस्तामसैः सत्वैर्युक्तो मानुषमाप्नुयात्।\nपुण्यपापवियुक्तानां स्थानमाहुर्महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085243, "chapter_id": 2814, "verse_number": "१२-३१९-१०", "content_sanskrit": "शाश्वतं चाव्ययं चैवमक्षयं चामृतं च तत्।\nज्ञानिनां संभवं श्रेष्ठं स्थानमव्रणमच्युतम्।\nअतीन्द्रियमबीजं च जन्ममृत्युतमोनुदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085244, "chapter_id": 2814, "verse_number": "१२-३१९-११", "content_sanskrit": "अव्यक्तस्थं परं यत्तत्पृष्टस्तेऽहं नराधिप।\nस एव प्रकृतिस्थो हि तत्स्थ इत्यभिधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085245, "chapter_id": 2814, "verse_number": "१२-३१९-१२", "content_sanskrit": "अचेतना चैव मता प्रकृतिश्चापि पार्थिव।\nएतेनाधिष्ठिता चैव सृजते संहरत्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085246, "chapter_id": 2814, "verse_number": "१२-३१९-१३x", "content_sanskrit": "जनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085247, "chapter_id": 2814, "verse_number": "१२-३१९-१३", "content_sanskrit": "अनादिनिधनावेतावुभावेव महामते।\nअमूर्तिमन्तावचलावप्रकम्प्यगुणागुणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085248, "chapter_id": 2814, "verse_number": "१२-३१९-१४", "content_sanskrit": "अग्राह्यावृषिशार्दूल कथमेको ह्यचेतनः।\nचेतनावांस्तथा चैकः क्षेत्रज्ञ इति भाषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085249, "chapter_id": 2814, "verse_number": "१२-३१९-१५", "content_sanskrit": "त्वं हि विप्रेन्द्र कार्त्स्न्येन र्मोक्षधर्ममुपाससे।\nसाकल्पं मोक्षधर्मस्य श्रोतुमिच्छामि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085250, "chapter_id": 2814, "verse_number": "१२-३१९-१६", "content_sanskrit": "निस्तत्वं केवलत्वं च विनाभावं तथैव च।\nदैवतानि च मे ब्रूहि देहं यान्याश्रितानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085251, "chapter_id": 2814, "verse_number": "१२-३१९-१७", "content_sanskrit": "तथैवोत्क्राणिणः स्थानं देहिनो वै विपद्यतः।\nकालेन यद्धि प्राप्नोति स्थानं तत्प्रब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085252, "chapter_id": 2814, "verse_number": "१२-३१९-१८", "content_sanskrit": "साङ्ख्यज्ञानं च तत्त्वेन पृथग्योगं तथैव च।\nअरिष्टानि च तत्त्वानि वक्तुमर्हसि सत्तम।\nविदितं सर्वमेतत्ते पाणावामलकं यथा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085253, "chapter_id": 2814, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकोनविंशत्यधिकत्रिशततमोऽध्यायः॥ ३१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]