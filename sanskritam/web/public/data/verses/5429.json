[{"id": 2207667, "chapter_id": 5429, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207668, "chapter_id": 5429, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nसुभगे सप्तहोतॄणां विधानमिह यादृशम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207669, "chapter_id": 5429, "verse_number": "२", "content_sanskrit": "घ्राणं चक्षुश्च जिह्वा च त्वक् श्रोत्रं चैव पञ्चमम् ।\nमनो बुद्धिश्च सप्तैते होतारः पृथगाश्रिताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207670, "chapter_id": 5429, "verse_number": "३", "content_sanskrit": "सूक्ष्मेऽवकाशे सन्तप्ते न पश्यन्तीतरेतरम् ।\nएषां च सप्तहोतॄणां विधानां विद्धि शोभने\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207671, "chapter_id": 5429, "verse_number": "", "content_sanskrit": "ब्राह्मणी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207672, "chapter_id": 5429, "verse_number": "४", "content_sanskrit": "सूक्ष्मेऽवकाशे सन्तप्ते कथं नान्योन्यदर्शिनः ।\nकथं स्वभावाद् भगवन् एतदाचक्ष्व मे विभो\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207673, "chapter_id": 5429, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207674, "chapter_id": 5429, "verse_number": "५", "content_sanskrit": "गुणज्ञानमभिज्ञानं गुणज्ञानामभिज्ञता ।\nपरस्परं गुणानेते न विजानन्ति कर्हिचित्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207675, "chapter_id": 5429, "verse_number": "६", "content_sanskrit": "जिह्वा चक्षुस्तथा श्रोत्रं त्वङ्मनो बुद्धिरेव च ।\nन गन्धानधिगच्छन्ति घ्राणस्तानधिगच्छति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207676, "chapter_id": 5429, "verse_number": "७", "content_sanskrit": "घ्राणं चैव च चक्षुः त्वक् श्रोत्रं च मन एव च ।\nन रसानधिगच्छन्ति विना जिह्वां तथैव च\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207677, "chapter_id": 5429, "verse_number": "८", "content_sanskrit": "घ्राणं जिह्वा तथा श्रोत्रं त्वङ्मनो बुद्धिरेव च ।\nन रूपाण्यधिगच्छन्ति चक्षुस्तदधिगच्छति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207678, "chapter_id": 5429, "verse_number": "९", "content_sanskrit": "घ्राणं जिह्वा च चक्षुश्च श्रोत्रं बुद्धिर्मनस्तथा ।\nन स्पर्शानधिगच्छन्ति त्वक्च तानधिगच्छति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207679, "chapter_id": 5429, "verse_number": "१०", "content_sanskrit": "घ्राणं जिह्वा च चक्षुश्च त्वङ्मनो बुद्धिरेव च ।\nन शब्दानधिगच्छन्ति श्रोत्रं तानधिगच्छति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207680, "chapter_id": 5429, "verse_number": "११", "content_sanskrit": "घ्राणं जिह्वा च चक्षुश्च त्वक् श्रोत्रं बुद्धिरेव च ।\nसङ्कल्पान्नाधिगच्छन्ति मनस्तानधिगच्छति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207681, "chapter_id": 5429, "verse_number": "१२", "content_sanskrit": "घ्राणं जिह्वा च चक्षुश्च त्वक् श्रोत्रं मन एव च ।\nन निष्ठामधिगच्छन्ति बुद्धिस्तामधिगच्छति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207682, "chapter_id": 5429, "verse_number": "१३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nइन्द्रियाणां च संवादं मनसश्चैव भामिनि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207683, "chapter_id": 5429, "verse_number": "", "content_sanskrit": "मनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207684, "chapter_id": 5429, "verse_number": "१४", "content_sanskrit": "नाघ्राति मामृते घ्राणं रसं जिह्वा न वेत्ति च ।\nरूपं चक्षुर्न गृह्णाति त्वक् स्पर्शं नावबुद्ध्यते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207685, "chapter_id": 5429, "verse_number": "१५", "content_sanskrit": "न श्रोत्रं श्रुणुयात् शब्दं मया हीनं कथञ्चन ।\nप्रवरं सर्वभूतानामहमस्मि सनातनम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207686, "chapter_id": 5429, "verse_number": "१६", "content_sanskrit": "अगाराणीव शून्यानि शान्तार्चिष इवाग्नयः ।\nइन्द्रियाणि न भासन्ते मया हीनानि नित्यशः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207687, "chapter_id": 5429, "verse_number": "१७", "content_sanskrit": "काष्ठानीवार्द्रशुष्कानि यतमानैरपीन्द्रियैः ।\nगुणार्थान्नाधिगच्छन्ति मामृते सर्वजन्तवः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207688, "chapter_id": 5429, "verse_number": "", "content_sanskrit": "इन्द्रियाणि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207689, "chapter_id": 5429, "verse_number": "१८", "content_sanskrit": "एवमेतद् भवेत् सत्यं यथैतन्मन्यते भवान् ।\nऋतेऽस्मानस्मदर्थांस्त्वं भोगान् भुङ्क्ते भवान् यदि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207690, "chapter_id": 5429, "verse_number": "१९", "content_sanskrit": "यद्यस्मासु प्रलीनेषु तर्पणं प्राणधारणम् ।\nभोगान् भुङ्क्ते भवान् सत्यं यथैतन्मन्यते तथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207691, "chapter_id": 5429, "verse_number": "२०", "content_sanskrit": "अथवाऽस्मासु लीनेषु तिष्ठत्सु विषयेषु च ।\nयदि सङ्कल्पमात्रेण भुङ्क्ते भोगान्यथार्थवत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207692, "chapter_id": 5429, "verse_number": "२१", "content_sanskrit": "अथ चेन्मन्यसे सिद्धिमस्मदर्थेषु नित्यदा ।\nघ्राणेन रूपमादत्स्व रसमादत्स्व चक्षुषा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207693, "chapter_id": 5429, "verse_number": "२२", "content_sanskrit": "श्रोत्रेण गन्धानादत्स्व स्पर्शानादत्स्व जिह्वया ।\nत्वचा च शब्दमादत्स्व बुद्ध्या स्पर्शमथापि च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207694, "chapter_id": 5429, "verse_number": "२३", "content_sanskrit": "बलवन्तो ह्यनियमा नियमा दुर्बलीयसाम् ।\nभोगानपूर्वानादत्स्व नोच्छिष्टं भोक्तुमर्हति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207695, "chapter_id": 5429, "verse_number": "२४", "content_sanskrit": "यथा हि शिष्यः शास्तारं श्रुत्यर्थमभिधावति ।\nततः श्रुतमुपादाय श्रुत्यर्थमुपतिष्ठति\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207696, "chapter_id": 5429, "verse_number": "२५", "content_sanskrit": "विषयानेवमस्माभिर्दर्शितानभिमन्यसे ।\nअनुभूतानतीतांश्च स्वप्ने जागरणे तथा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207697, "chapter_id": 5429, "verse_number": "२६", "content_sanskrit": "वैमनस्यं गतानां च जन्तूनामल्पचेतसाम् ।\nअस्मदर्थे कृते कार्ये दृश्यते प्राणधारणम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207698, "chapter_id": 5429, "verse_number": "२७", "content_sanskrit": "बहूनपि हि सङ्कल्पान्मत्वा स्वप्नानुपास्य च ।\nबुभुक्षया पीड्यमानो विषयानेव धावति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207699, "chapter_id": 5429, "verse_number": "२८", "content_sanskrit": "अगारमद्वारमिव प्रविश्य\nसङ्कल्पभोगान् विषयानविन्दन् ।\nप्राणक्षये शान्तिमुपैति नित्यं\nदारुक्षयेऽग्निर्ज्वलितो यथैव\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207700, "chapter_id": 5429, "verse_number": "२९", "content_sanskrit": "कामं तु स्वप्नेषु गुणेषु सङ्गः\nकामं च नान्योन्यगुणोपलब्धिः ।\nअस्मान् विना नास्ति तपोपलब्धिः\nतामप्यृते त्वां न भजेत् प्रहर्षः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207701, "chapter_id": 5429, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्वमेधिकपर्वणि त्रयोविंशोऽध्यायः ॥२३॥\nअनुगीतापर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]