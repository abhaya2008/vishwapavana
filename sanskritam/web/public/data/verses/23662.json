[{"id": 7003662000, "chapter_id": 23662, "verse_number": "१-२-४९-१", "content_sanskrit": "अर्जुन उवाच ।\nअत्यद्भुतानि तीर्थानि लिंगानि च महामुने ।\nश्रुत्वा तव मुखांभोजाद्भृशं मे हृष्यते मनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003662001, "chapter_id": 23662, "verse_number": "१-२-४९-२", "content_sanskrit": "महीनगरकस्यापि स्थापितस्य त्वया मुने ।\nयानि तीर्थानि मुख्यानि तानि वर्णय मे प्रभो ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003662002, "chapter_id": 23662, "verse_number": "१-२-४९-३", "content_sanskrit": "नारद उवाच ।\nश्रीमन्महीनगरके यानि तीर्थानि फाल्गुन ।\nतानि वक्ष्यामि यत्रास्ते जया दित्यो रविः प्रभुः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003662003, "chapter_id": 23662, "verse_number": "१-२-४९-४", "content_sanskrit": "जयादित्यस्य यो नाम कीर्तयेदिह मानवः ।\nसर्वरोगविनिर्मुक्तो लभेत्सोऽपि हृदीप्सितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003662004, "chapter_id": 23662, "verse_number": "१-२-४९-५", "content_sanskrit": "यस्य संदर्शनादेव कल्याणैरपि पूर्यते ।\nमुच्यते चाप्यकल्याणैः श्रद्धावान्पार्थ मानवः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003662005, "chapter_id": 23662, "verse_number": "१-२-४९-६", "content_sanskrit": "तस्य देवस्य चोत्पत्तिं शृणु पार्थ वदामि ते ।\nशृण्वन्वा कीर्तयन्वापि प्रसादं भास्कराल्लभेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003662006, "chapter_id": 23662, "verse_number": "१-२-४९-७", "content_sanskrit": "अहं संस्थाप्य संस्थानमेतत्कालेन केनचित् ।\nप्रयातो भास्करं लोकं दर्शनार्थी यदृच्छया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003662007, "chapter_id": 23662, "verse_number": "१-२-४९-८", "content_sanskrit": "स मां प्रणतमासीनमभ्यर्च्यार्घेण भास्करः ।\nप्रहसन्निव प्राहेदं देवो मधुरया गिरा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003662008, "chapter_id": 23662, "verse_number": "१-२-४९-९", "content_sanskrit": "कुत आगम्यते विप्र क्व च वा प्रतिगम्यते ।\nक्व चायं नारदमुने कालस्ते विहृतोऽभवत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003662009, "chapter_id": 23662, "verse_number": "१-२-४९-१०", "content_sanskrit": "नारद उवाच ।\nएवमुक्तो भास्करेण तं तदा प्राब्रवं वचः ।\nभारते विहृतः खण्डे महीनगरकादपि ।\nदर्शनार्थं तव विभो समायातोऽस्मि भास्कर ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003662010, "chapter_id": 23662, "verse_number": "१-२-४९-११", "content_sanskrit": "रविरुवाच ।\nयत्त्वया स्थापितं स्थानं तत्र ये संति ब्राह्मणाः ।\nतेषां गुणान्मम ब्रूहि किंगुणा ननु ते द्विजाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003662011, "chapter_id": 23662, "verse_number": "१-२-४९-१२", "content_sanskrit": "नारद उवाच ।\nएवं पृष्टो भगवता पुनरेवाब्रवं वचः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003662012, "chapter_id": 23662, "verse_number": "१-२-४९-१३", "content_sanskrit": "यदि तान्भोः प्रशंसामि स्वीयान्स्तौतीति वाच्यता ।\nनिंदाम्यनर्हान्कस्माद्वा कष्टमेवोभयत्र च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003662013, "chapter_id": 23662, "verse_number": "१-२-४९-१४", "content_sanskrit": "अथवा पारमाहात्म्ये सति तेषां महात्मनाम् ।\nअल्पे कृते वर्णने स्याद्दोष एव महान्मम ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003662014, "chapter_id": 23662, "verse_number": "१-२-४९-१५", "content_sanskrit": "मदर्चितद्विजेंद्राणां यदि स्याच्छ्रवणेप्सुता ।\nततः स्वयं विलोक्यास्ते गत्वेदं मे मतं रवे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003662015, "chapter_id": 23662, "verse_number": "१-२-४९-१६", "content_sanskrit": "इति श्रुत्वा मम वचो रविरासीत्सुविस्मितः ।\nस्वयं द्रक्ष्यामि चोवाच पुनःपुनरहर्पतिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003662016, "chapter_id": 23662, "verse_number": "१-२-४९-१७", "content_sanskrit": "सोऽथ विप्रतनुं कृत्वा मां विसर्ज्यैव भास्करः ।\nप्रतपन्दिवि योगाच्च प्रयातोर्णवरोधसि ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003662017, "chapter_id": 23662, "verse_number": "१-२-४९-१८", "content_sanskrit": "जटां त्रिषवणस्नानपिंगलां धारयन्नथ ।\nवृद्धद्विजो महातेजा ददृशे ब्राह्मणैर्मम ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003662018, "chapter_id": 23662, "verse_number": "१-२-४९-१९", "content_sanskrit": "ततो हारीतप्रमुखाः प्रहर्षोत्फुल्ललोचनाः ।\nउत्थाय ब्रह्मशालायास्ते द्विजा द्विजमाद्रवन् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003662019, "chapter_id": 23662, "verse_number": "१-२-४९-२०", "content_sanskrit": "नमस्कृत्य द्विजाग्र्यं ते प्रहर्षादिदमब्रुवन् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003662020, "chapter_id": 23662, "verse_number": "१-२-४९-२१", "content_sanskrit": "अद्य नो दिवसः पुण्यः स्थानमद्योत्तमं त्विदम् ।\nयत्त्वया विप्रप्रवर स्वयमागमनं कृतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003662021, "chapter_id": 23662, "verse_number": "१-२-४९-२२", "content_sanskrit": "धन्यस्य हि गृहस्थस्य कृपयैव द्विजोत्तमाः ।\nआतिथ्यवेषेणायांति पावनार्थं न संशयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003662022, "chapter_id": 23662, "verse_number": "१-२-४९-२३", "content_sanskrit": "तत्त्वं गेहानि चास्माकं पादचंक्रमणेन च ।\nदर्शनाद्भोजनात्स्थानादस्माभिः सह पावय ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003662023, "chapter_id": 23662, "verse_number": "१-२-४९-२४", "content_sanskrit": "अतिथिरुवाच ।\nभोजनं द्विविधं विप्रा प्राकृतं परमं तथा ।\nतदहं सम्यगिच्छामि दत्तं परमभोजनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003662024, "chapter_id": 23662, "verse_number": "१-२-४९-२५", "content_sanskrit": "इत्येतदतिथेः श्रुत्वा हारीतः पुत्रमब्रवीत् ।\nअष्टवर्षं तु कमठं वेत्सि पुत्र द्विजोदितम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003662025, "chapter_id": 23662, "verse_number": "१-२-४९-२६", "content_sanskrit": "कमठ उवात्र ।\nतात प्रणम्य त्वां वक्ष्ये तादृक्परमभोजनम् ।\nद्विजं च तर्पयिष्यामि दत्त्वा परमभोजनम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003662026, "chapter_id": 23662, "verse_number": "१-२-४९-२७", "content_sanskrit": "सुतेन किल जातेन जायते चानृणः पिता ।\nसत्यं करिष्ये तद्वाक्यं संतर्प्यातिथिमुत्तमम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003662027, "chapter_id": 23662, "verse_number": "१-२-४९-२८", "content_sanskrit": "भोजनं द्विप्रकारं च प्रविभागस्तयोरयम् ।\nप्राकृतं प्रोच्यते त्वेवमन्यत्परमभोजनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003662028, "chapter_id": 23662, "verse_number": "१-२-४९-२९", "content_sanskrit": "तत्र यत्प्राकृतं नाम प्रकृतिप्रमुखस्य तत् ।\nचतुर्विंशतितत्त्वानां गणस्योक्तं हि तर्पणम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003662029, "chapter_id": 23662, "verse_number": "१-२-४९-३०", "content_sanskrit": "षड्रसं भोजनं तच्च पंचभेदं वदंति च ।\nयेन भुक्तेन तृप्तं स्यात्क्षेत्रं यद्देहलक्षणम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003662030, "chapter_id": 23662, "verse_number": "१-२-४९-३१", "content_sanskrit": "यथापरं परंनाम प्रोक्तं परमभोजनम् ।\nपरमः प्रोच्यते चात्मा तस्य तद्भोजनं भवेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003662031, "chapter_id": 23662, "verse_number": "१-२-४९-३२", "content_sanskrit": "ततो नानाप्रकारस्य धर्मस्य श्रवणं हि यत् ।\nतदन्नं प्रोच्यते भोक्ता क्षेत्रज्ञः श्रवणौ मुखम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003662032, "chapter_id": 23662, "verse_number": "१-२-४९-३३", "content_sanskrit": "तद्दास्यामि द्विजाग्र्याय पृच्छ विप्र यदिच्छसि ।\nशक्तितस्तर्पयिष्यामि त्वामहं विप्रसंसदि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003662033, "chapter_id": 23662, "verse_number": "१-२-४९-३४", "content_sanskrit": "नारद उवाच ।\nकमठस्यैतदाकर्ण्य सोऽतिथिर्वचनं महत् ।\nमनसैव प्रशस्यामुं प्रश्नमेनमथाकरोत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003662034, "chapter_id": 23662, "verse_number": "१-२-४९-३५", "content_sanskrit": "कथं संजायते जंतुः कथं चापि प्रलीयते ।\nभस्मतामथ संप्राप्य क्व चायं प्रति पद्यते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003662035, "chapter_id": 23662, "verse_number": "१-२-४९-३६", "content_sanskrit": "कमठ उवाच ।\nगुरवे प्राङ्नमस्कृत्य धर्माय तदनंतरम् ।\nछंदोगीतममुं प्रश्नं शक्त्या वक्ष्यामि ते द्विज ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003662036, "chapter_id": 23662, "verse_number": "१-२-४९-३७", "content_sanskrit": "जनने त्रिविधं कर्म हेतुर्जंतोर्भवेत्किल ।\nपुण्यं पापं च मिश्रं च सत्त्वराजसतामसम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003662037, "chapter_id": 23662, "verse_number": "१-२-४९-३८", "content_sanskrit": "तत्र यः सात्त्विको नाम स स्वर्गं प्रतिपद्यते ।\nस्वर्गात्कालपरिभ्रष्टो धनी धर्मी सुखी भवेत् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003662038, "chapter_id": 23662, "verse_number": "१-२-४९-३९", "content_sanskrit": "तथा यस्तामसो नाम नरकं प्रतिपद्यते ।\nभुक्त्वा बह्वीर्यातनाश्च स्थावरत्वं प्रपद्यते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003662039, "chapter_id": 23662, "verse_number": "१-२-४९-४०", "content_sanskrit": "महतां दर्शनस्पर्शैरुपभोगसहासनैः ।\nमहता कालयोगेन संसरन्मानवो भवेत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003662040, "chapter_id": 23662, "verse_number": "१-२-४९-४१", "content_sanskrit": "सोऽपि दुःखदरिद्राद्यैर्वेष्टितो विकलेंद्रियः ।\nप्रत्यक्षः सर्व लोकानां पापस्यैतद्धि लक्षणम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003662041, "chapter_id": 23662, "verse_number": "१-२-४९-४२", "content_sanskrit": "अथ यो मिश्रकर्मा स्यात्तिर्यक्त्वं प्रतिपद्यते ।\nमहतामेव संसर्गात्संसरन्मानवो भवेत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003662042, "chapter_id": 23662, "verse_number": "१-२-४९-४३", "content_sanskrit": "यस्य पुण्यं पृथुतरं पापमल्पं हि जायते ।\nस पूर्वं दुःखितो भूत्वा पश्चात्सौख्यान्वितो भवेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003662043, "chapter_id": 23662, "verse_number": "१-२-४९-४४", "content_sanskrit": "पापं पृथुतरं यस्य पुण्यमल्पतरं भवेत् ।\nपूर्वं सुखी ततो दुःखी मिश्रस्यैतद्धि लक्षणम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003662044, "chapter_id": 23662, "verse_number": "१-२-४९-४५", "content_sanskrit": "तत्र मानुषसंभूतिं शृणु यादृगसौ भवेत् ।\nपुरुषस्य स्त्रियाश्चैव शुक्रशोणितसंगमे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003662045, "chapter_id": 23662, "verse_number": "१-२-४९-४६", "content_sanskrit": "सर्वदोषविनिर्मुक्तो जीवः संसरते स्फुटम् ।\nगुणान्वितमनोबुद्धिशुभाशुभसमन्वितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003662046, "chapter_id": 23662, "verse_number": "१-२-४९-४७", "content_sanskrit": "जीवः प्रविष्टो गर्भं तु कलले प्रतितिष्ठति ।\nमूढश्च कलले तत्र मासमात्रं च तिष्ठति ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003662047, "chapter_id": 23662, "verse_number": "१-२-४९-४८", "content_sanskrit": "द्वितीयं तु तथा मासं घनीभूतः स तिष्ठति ।\nतस्यावयवनिर्माणं तृतीये मासि जायते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003662048, "chapter_id": 23662, "verse_number": "१-२-४९-४९", "content_sanskrit": "अस्थीनि च तथा मासि जायंते च चतुर्थके ।\nत्वग्जन्म पंचमे मासि पष्ठे रोम्णां समुद्भवः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003662049, "chapter_id": 23662, "verse_number": "१-२-४९-५०", "content_sanskrit": "सप्तमे च तथा मासि प्रबोधश्चास्य जायते ।\nमातुराहारपीतं च सप्तमे मास्युपाश्नुते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003662050, "chapter_id": 23662, "verse_number": "१-२-४९-५१", "content_sanskrit": "अष्टमे नवमे मासि भृशमुद्विजते ततः ।\nजरायुणा वेष्टितांगो मुखे बद्धकरांगुलिः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003662051, "chapter_id": 23662, "verse_number": "१-२-४९-५२", "content_sanskrit": "मध्ये क्लीबस्तु वामे स्त्री दक्षिणे पुरुषस्तथा ।\nतिष्ठत्युदरभागे च पृष्ठेरग्निमुखः किल ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003662052, "chapter_id": 23662, "verse_number": "१-२-४९-५३", "content_sanskrit": "यस्यां तिष्ठत्यसौ योनौ तां च वेत्ति न संशयः ।\nसर्वं स्मरति वृत्तांतं बहूनां जन्मनामपि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003662053, "chapter_id": 23662, "verse_number": "१-२-४९-५४", "content_sanskrit": "अंधे तमसि किं दृश्यो गंधान्मोहं दृढं लभेत् ।\nशीते मात्रा जले पीते शीतमुष्णं तथोष्णके ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003662054, "chapter_id": 23662, "verse_number": "१-२-४९-५५", "content_sanskrit": "व्यायामे लभते मातुः क्लेशं व्याधेश्च वेदनाम् ।\nअलक्ष्याः पितृमातृभ्यां जायंते व्याधयः पराः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003662055, "chapter_id": 23662, "verse_number": "१-२-४९-५६", "content_sanskrit": "सौकुमार्याद्रुजं तीव्रां जनयंति च तस्य ते ।\nस्वल्पमप्यथ तं कालं वेत्ति वर्षशतोपमम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003662056, "chapter_id": 23662, "verse_number": "१-२-४९-५७", "content_sanskrit": "संतप्यते भृशं गर्भे कर्मभिश्च पुरातनैः ।\nमनोरथांश्च कुरुते सुकृतार्थं पुनःपुनः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003662057, "chapter_id": 23662, "verse_number": "१-२-४९-५८", "content_sanskrit": "जन्म चेदहमाप्स्यामि मानुष्ये जीवितं तथा ।\nततस्तत्प्रकरिष्यामि येन मोक्षो भवेत्स्फुटम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003662058, "chapter_id": 23662, "verse_number": "१-२-४९-५९", "content_sanskrit": "एवं तु चिंतयानस्य सीमंतोन्नयनादनु ।\nमासद्वयं तद्व्रजति पीडतस्त्रियुगाकृति ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003662059, "chapter_id": 23662, "verse_number": "१-२-४९-६०", "content_sanskrit": "ततः स्वकाले संपूर्णे सूतिमारुतचालितः ।\nभवत्यवाङ्मुखो जंतुः पीडामनुभवन्पराम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003662060, "chapter_id": 23662, "verse_number": "१-२-४९-६१", "content_sanskrit": "अधोमुखः संकटेन योनिद्वारेण निःसरेत् ।\nपीडया पीडमानोऽपि चर्मोत्कर्तनतुल्यया ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003662061, "chapter_id": 23662, "verse_number": "१-२-४९-६२", "content_sanskrit": "करपत्रसमस्पर्शं करसंस्पर्शनादिकम् ।\nअसौ जातो विजानाति मासमात्रं विमोहितः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003662062, "chapter_id": 23662, "verse_number": "१-२-४९-६३", "content_sanskrit": "प्राक्कर्मवशगस्यास्य गर्भज्ञानं च नश्यति ।\nततः करोति कर्माणि श्वेतरक्तासितानि च ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003662063, "chapter_id": 23662, "verse_number": "१-२-४९-६४", "content_sanskrit": "अस्थिपट्टतुलास्तंभस्नायुबंधेन यंत्रितम् ।\nरक्तमांसमृदालिप्तं विण्मूत्रद्रव्यभाजनम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003662064, "chapter_id": 23662, "verse_number": "१-२-४९-६५", "content_sanskrit": "सप्तभित्तिसुसंबद्धं छन्नं रोम तृणैरपि ।\nवदनैकमहाद्वारं गवाक्षाष्टविभूषितम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003662065, "chapter_id": 23662, "verse_number": "१-२-४९-६६", "content_sanskrit": "ओष्ठद्वयकपाटं च दंतार्गलविमुद्रितम् ।\nनाडीस्वेदप्रवाहं च कफपित्तपरिप्लुतम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003662066, "chapter_id": 23662, "verse_number": "१-२-४९-६७", "content_sanskrit": "जराशोकसमाविष्टं कालवक्त्रानलस्थितम् ।\nरागद्वेषादिभिर्ध्वस्तं षट्कौशिकसमुद्भवम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003662067, "chapter_id": 23662, "verse_number": "१-२-४९-६८", "content_sanskrit": "एवं संजायते पुंसो देहगेहमिदं द्विज ।\nयस्मिन्वसति क्षेत्रज्ञो गृहस्थो बुद्धिगेहिनी ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003662068, "chapter_id": 23662, "verse_number": "१-२-४९-६९", "content_sanskrit": "मोक्षं स्वर्गं च नरकमास्ते संसाधयन्नपि ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003662069, "chapter_id": 23662, "verse_number": "१-२-४९-७०", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीति साहस्र्यां संहितायां प्रथमे माहेश्वरखण्डे कौमारिकाखंडे कमठसूर्यसंवादे जीवस्य देहोत्पत्तिवर्णनंनामैकोनपञ्चाशत्तमोऽध्यायः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]