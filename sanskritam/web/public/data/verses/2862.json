[{"id": 2087705, "chapter_id": 2862, "verse_number": "१२-३६७-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087706, "chapter_id": 2862, "verse_number": "१२-३६७-१", "content_sanskrit": "स वनानि विचित्राणि तीर्थानि च सरांसि च।\nअभिगच्छन्क्रमेण स्म कंचिन्मुनिमुपस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087707, "chapter_id": 2862, "verse_number": "१२-३६७-२", "content_sanskrit": "तं स तेन यथोद्दिष्टं नागं विप्रेण ब्राह्मणः।\nपर्यपृच्छद्यथान्यायं श्रुत्वैव च जगाम सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087708, "chapter_id": 2862, "verse_number": "१२-३६७-३", "content_sanskrit": "सोऽभिगम्य यथान्यायं नागायतनमर्थवित्।\nप्रोक्तवानहमस्मीति भोःशब्दालंकृतं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087709, "chapter_id": 2862, "verse_number": "१२-३६७-४", "content_sanskrit": "तत्तस्य वचनं श्रुत्वा रूपिणी धर्मवत्सला।\nदर्शयामास तं विप्रं नागपत्नी पतिव्रता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087710, "chapter_id": 2862, "verse_number": "१२-३६७-५", "content_sanskrit": "सा तस्मै विधिवत्पूजां चक्रे धर्मपरायणा।\nस्वागतेनागतं कृत्वा किं करोमीति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087711, "chapter_id": 2862, "verse_number": "१२-३६७-६x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087712, "chapter_id": 2862, "verse_number": "१२-३६७-६", "content_sanskrit": "विश्रान्तोऽभ्यर्चिंतश्चास्मि भवत्या श्लक्ष्णया गिरा।\nद्रष्टुमिच्छामि भवति देवं नागमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087713, "chapter_id": 2862, "verse_number": "१२-३६७-७", "content_sanskrit": "एतद्धि परमं कार्यमेतन्मे परमप्सितम्।\nअनेन चार्थेनास्म्यद्य संप्राप्तः पन्नगाश्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087714, "chapter_id": 2862, "verse_number": "१२-३६७-८x", "content_sanskrit": "नागभार्योवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087715, "chapter_id": 2862, "verse_number": "१२-३६७-८", "content_sanskrit": "आर्यः सूर्यरथं वोढुं गतोऽसौ मासचारिकः।\nसप्ताष्टभिर्दिनैर्विप्र दर्शयिष्यत्यसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087716, "chapter_id": 2862, "verse_number": "१२-३६७-९", "content_sanskrit": "एतद्विदितमार्यस्य विवासकरणं तव।\nभर्तुर्भवतु किंचान्यत्क्रियतां तद्वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087717, "chapter_id": 2862, "verse_number": "१२-३६७-१०x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087718, "chapter_id": 2862, "verse_number": "१२-३६७-१०", "content_sanskrit": "अनेन निश्चयेनाहं साध्वि संप्राप्तवानिह।\nप्रतीक्षन्नागमं देवि वत्स्याम्यस्मिन्प्रहावने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087719, "chapter_id": 2862, "verse_number": "१२-३६७-११", "content_sanskrit": "संप्राप्तस्यैव चाव्यग्रमावेद्योऽहमिहागतः।\nमयाभिगमनं प्राप्तो वाच्यश्च वचनं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087720, "chapter_id": 2862, "verse_number": "१२-३६७-१२", "content_sanskrit": "अहमप्यत्र वत्स्यामि गोमत्याः पुलिने शुभे।\nकालं परिमिताहारो यथोक्तं परिपालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087721, "chapter_id": 2862, "verse_number": "१२-३६७-१३", "content_sanskrit": "ततः स विप्रस्तां नागीं समाधाय पुनःपुनः।\nवेदवित्पुलिनं नद्याः प्रययौ ब्राह्मणर्भषः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087722, "chapter_id": 2862, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्तषष्ट्यधिकत्रिशततमोऽध्यायः॥ ३६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]