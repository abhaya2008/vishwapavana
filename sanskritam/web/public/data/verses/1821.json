[{"id": 2037881, "chapter_id": 1821, "verse_number": "५-६६-०x", "content_sanskrit": "वैशंपायान उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037882, "chapter_id": 1821, "verse_number": "५-६६-१", "content_sanskrit": "दुर्योधने धार्तराष्ट्रे तद्वचो नाभिनन्दति।\nतूष्णींभूतेषु सर्वेषु समुत्तस्थुर्नरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037883, "chapter_id": 1821, "verse_number": "५-६६-२", "content_sanskrit": "उत्थितेषु महाराज पृथिव्यां सर्वराजसु।\nरहिते सञ्जयं राजा परिप्रष्टुं प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037884, "chapter_id": 1821, "verse_number": "५-६६-३", "content_sanskrit": "आशंसमानो विजयं तेषां पुत्रवशानुगः ।\nआत्मनश्च परेषां च पाण्डवानां च निश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037885, "chapter_id": 1821, "verse_number": "५-६६-४x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037886, "chapter_id": 1821, "verse_number": "५-६६-४", "content_sanskrit": "गावल्गणे ब्रूहि नः सारफल्गु\nस्वेसनायं यावदिहास्ति किंचित्।\nत्वं पाण्डवानां निपुणं वेत्थ सर्वं\nकिमेषां ज्यायः किमु तेषां कनीयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037887, "chapter_id": 1821, "verse_number": "५-६६-५", "content_sanskrit": "त्वमेतयोः सारवित्सर्वदर्शी\nधर्मार्थयोर्निपुणो निश्चयज्ञः।\nस मे पृष्टः सञ्जय ब्रूहि सर्वं\nयुध्यमानाः कतरेऽस्मिन्न सन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037888, "chapter_id": 1821, "verse_number": "५-६६-६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037889, "chapter_id": 1821, "verse_number": "५-६६-६", "content_sanskrit": "न त्वां ब्रूयां रहिते जातु किंचि-\nदसूया हि त्वां प्रविशेत राजन्।\nआनयस्व पितरं महाव्रतं\nगान्धारीं च महिषीमाजमीढ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037890, "chapter_id": 1821, "verse_number": "५-६६-७", "content_sanskrit": "तो तेऽसूयां विनयेतां नरेन्द्र\nधर्मज्ञौ तौ निपुणौ निश्चयज्ञौ ।\nतयोस्तु त्वां सन्निधौ तद्वदेयं\nकृत्स्नं मतं केशवपार्थयोर्यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037891, "chapter_id": 1821, "verse_number": "५-६६-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037892, "chapter_id": 1821, "verse_number": "५-६६-८", "content_sanskrit": "इत्युक्तेन च गान्धारी व्यासश्चात्राजगामह।\nआनीतौ विदुरेणेह सभां शीघ्रं प्रवेशितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037893, "chapter_id": 1821, "verse_number": "५-६६-९", "content_sanskrit": "ततस्तन्मतमाज्ञाय सञ्जयस्यात्मजस्य च।\nअभ्युपेत्य महाप्राज्ञः कृष्णद्वैपायनोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037894, "chapter_id": 1821, "verse_number": "५-६६-१०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037895, "chapter_id": 1821, "verse_number": "५-६६-१०", "content_sanskrit": "संपृच्छते धृतराष्ट्रय सञ्जय\nआचक्ष्व सर्वं यावदेषोऽनुयुङ्क्ते।\nसर्वं यावद्वेत्थ तस्मिन्यथाव-\nद्याथातथ्यं वासुदेवेऽर्जुने च ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037896, "chapter_id": 1821, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारतो उद्योगपर्वणि यानसन्धिपर्वणि षट्षष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]