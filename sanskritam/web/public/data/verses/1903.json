[{"id": 2040713, "chapter_id": 1903, "verse_number": "५-१४८-०x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040714, "chapter_id": 1903, "verse_number": "५-१४८-१", "content_sanskrit": "भीष्मेणोक्ते ततो द्रोणो दुर्योधनमभाषत ।\nमध्ये नृपाणां भद्रं ते वचनं वचनक्षमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040715, "chapter_id": 1903, "verse_number": "५-१४८-२", "content_sanskrit": "प्रातीपः शन्तनुस्तात कुलस्यार्थे यथा स्थितः ।\nयथा देवव्रतो भीष्मः कुलस्यार्थे स्थितोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040716, "chapter_id": 1903, "verse_number": "५-१४८-३", "content_sanskrit": "तथा पाण्डुर्नरपतिः सत्यसन्धो जितेन्द्रियः।\nराजा कुरूणां धर्मात्मा सुव्रतः सुसमाहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040717, "chapter_id": 1903, "verse_number": "५-१४८-४", "content_sanskrit": "ज्येष्ठाय राज्यमददद्धृतराष्ट्राय धीमते।\nयवीयसे तथा क्षत्रे कुरूणां वंशवर्धनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040718, "chapter_id": 1903, "verse_number": "५-१४८-५", "content_sanskrit": "ततः सिंहासने राजन्स्थापयित्वैनमच्युतम् ॥\nवनं जगाम कौरव्यो भार्याभ्यां सहितो नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040719, "chapter_id": 1903, "verse_number": "५-१४८-६", "content_sanskrit": "नीचैः स्थित्वा तु विदुर उपास्ते स्म विनीतवत्।\nप्रेष्यवत्पुरुषव्याघ्रो वालव्यजनमुत्क्षिपन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040720, "chapter_id": 1903, "verse_number": "५-१४८-७", "content_sanskrit": "ततः सर्वाः प्रजास्तात धृतराष्ट्रं जनेश्वरम् ।\nअन्वपद्यन्त विधिवद्यथा पाण्डुं जनाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040721, "chapter_id": 1903, "verse_number": "५-१४८-८", "content_sanskrit": "विसृज्य धृतराष्ट्राय राज्यं स विदुराय च।\nचचार पृथिवीं पाण्डुः सर्वां परपुरञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040722, "chapter_id": 1903, "verse_number": "५-१४८-९", "content_sanskrit": "कोशसंवनने दाने भृत्यानां चान्ववेक्षणे ।\nभरणे चैव सर्वस्य विदुरः सत्यसङ्गरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040723, "chapter_id": 1903, "verse_number": "५-१४८-१०", "content_sanskrit": "सन्धिविग्रहसंयुक्तो राज्ञां संवाहनक्रियाः ।\nअवैक्षत महातेजा भीष्मः परपुरञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040724, "chapter_id": 1903, "verse_number": "५-१४८-११", "content_sanskrit": "सिंहासनस्थो नृपतिर्धृतराष्ट्रो महाबलः ।\nअन्वास्यमानः सततं विदुरेण महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040725, "chapter_id": 1903, "verse_number": "५-१४८-१२", "content_sanskrit": "कथं तस्य कुले जातः कुलभेदं व्यवस्यसि।\nसंभूय भ्रातृभिः सार्धं भुङ्क्ष भोगाञ्जनाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040726, "chapter_id": 1903, "verse_number": "५-१४८-१३", "content_sanskrit": "ब्रवीम्यहं न कार्पण्यान्नार्थहेतोः कथञ्चन ।\nभीष्मेण दत्तमिच्छामि न त्वया राजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040727, "chapter_id": 1903, "verse_number": "५-१४८-१४", "content_sanskrit": "नाहं त्वत्तोऽभिकाङ्क्षिष्ये वृत्त्युपायं जनाधिप ।\nयतो भीष्मस्ततो द्रोणो यद्भीष्मस्त्वाह तत्कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040728, "chapter_id": 1903, "verse_number": "५-१४८-१५", "content_sanskrit": "दीयतां पाण्डुपुत्रेभ्यो राज्यार्धमरिकर्शन ।\nसममाचार्यकं तात तव तेषां च मे सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040729, "chapter_id": 1903, "verse_number": "५-१४८-१६", "content_sanskrit": "अश्वत्थामा यथा मह्यं तथा श्वेतहयो मम ।\nबहुना किं प्रलापेन यतो धर्मस्ततो जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040730, "chapter_id": 1903, "verse_number": "५-१४८-१७x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040731, "chapter_id": 1903, "verse_number": "५-१४८-१७", "content_sanskrit": "एवमुक्ते महाराज द्रोणेनामिततेजसा।\nव्याजहार ततो वाक्यं विदुरः सत्यसङ्गरः ।\nपितुर्वदनमन्वीक्ष्य परिवृत्त्य च धर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040732, "chapter_id": 1903, "verse_number": "५-१४८-१८x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040733, "chapter_id": 1903, "verse_number": "५-१४८-१८", "content_sanskrit": "देवव्रत निबोधेदं वचनं मम भाषतः।\nप्रनष्टः कौरवो वंशस्त्वयायं पुनरुद्धृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040734, "chapter_id": 1903, "verse_number": "५-१४८-१९", "content_sanskrit": "तन्मे विलपमानस्य वचनं समुपेक्षसे।\nकोयं दुर्योधनो नाम कुलेऽस्मिन्कुलपांसनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040735, "chapter_id": 1903, "verse_number": "५-१४८-२०", "content_sanskrit": "यस्य लोभाभिभूतस्य मतिं समनुवर्तसे ।\nअनार्यस्याकृतज्ञस्य लोभेन हृतचेतसः ।\nअतिक्रामति यः शास्त्रं पितुर्धर्मार्थदर्शिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040736, "chapter_id": 1903, "verse_number": "५-१४८-२१", "content_sanskrit": "एते नश्यन्ति कुरवो दुर्योधनकृतेन वै।\nयथा ते न प्रणश्येयुर्महाराज तथा कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040737, "chapter_id": 1903, "verse_number": "५-१४८-२२", "content_sanskrit": "मां चैव धृतराष्ट्रं च पूर्वमेव महामते।\nचित्रकार इवालेख्यं कृत्वा स्थापितवानसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040738, "chapter_id": 1903, "verse_number": "५-१४८-२३", "content_sanskrit": "प्रजापतिः प्रजाः सृष्ट्वा यथा संहरते तथा।\nनोपेक्षश्व महाबाहो पश्यमानः कुलक्षयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040739, "chapter_id": 1903, "verse_number": "५-१४८-२४", "content_sanskrit": "अथ तेऽद्य मतिर्नष्टा विनाशे प्रत्युपस्थिते ।\nवनं गच्छ मया सार्धं धृतराष्ट्रेण चैव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040740, "chapter_id": 1903, "verse_number": "५-१४८-२५", "content_sanskrit": "बद्ध्वा वा निकृतिप्रज्ञं धार्तराष्ट्रं सुदुर्मतिम् ।\nशाधीदं राज्यमद्याशु पाण्डवैरभिरक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040741, "chapter_id": 1903, "verse_number": "५-१४८-२६", "content_sanskrit": "प्रसीद राजशार्दूल विनाशो दृश्यते महान् ।\nपाण्डवानां कुरूणां च राज्ञाममिततेजसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040742, "chapter_id": 1903, "verse_number": "५-१४८-२७x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040743, "chapter_id": 1903, "verse_number": "५-१४८-२७", "content_sanskrit": "विररामैवमुक्त्वा तु विदुरो दीनमानसः ।\nप्रध्यायमानः स तदा निःश्वसंश्च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040744, "chapter_id": 1903, "verse_number": "५-१४८-२८", "content_sanskrit": "ततोऽस्य राज्ञः सुबलस्य पुत्री\nधर्मार्थयुक्तं कुलनाशमीता।\nदुर्योधनं पापमतिं नृशंसं\nराज्ञां समक्षं सुतमाह कोपात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040745, "chapter_id": 1903, "verse_number": "५-१४८-२९", "content_sanskrit": "ये पार्थिवा राजसभां प्रविष्टा\nब्रह्मर्षयो ये च सभासदोऽन्ये।\nश्रृण्वन्तु वक्ष्यामि तवापराधं\nपापस्य सामात्यपरिच्छदस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2040746, "chapter_id": 1903, "verse_number": "५-१४८-३०", "content_sanskrit": "राज्यं कुरूणामनुरूपभोज्यं\nक्रमागतो नः कुलधर्म एषः।\nत्वं पापबुद्धेऽतिनृशंसकर्मन्\nराज्यं कुरूणामनयाद्विहंसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2040747, "chapter_id": 1903, "verse_number": "५-१४८-३१", "content_sanskrit": "राज्ये स्थितो धृतराष्ट्रो मनीषी\nतस्यानुजो विदुरो दीर्घदर्शी ।\nएतावतिक्रम्य कथं नृपत्वं\nदुर्योधन प्रार्थयसेऽद्य मोहात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2040748, "chapter_id": 1903, "verse_number": "५-१४८-३२", "content_sanskrit": "राजा च क्षत्ता च महानुभावौ\nभीष्मे स्थिते परवन्तौ भवेताम् ।\nअयं तु धर्मज्ञतया महात्मा\nन राज्यकामो नृवरो नदीजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2040749, "chapter_id": 1903, "verse_number": "५-१४८-३३", "content_sanskrit": "राज्य तु पाण्डोरिदमप्रधृष्यं\nतस्याद्य पुत्राः प्रभवन्ति नान्ये।\nराज्यं तदेतन्निखिलं पाण्डवानां\nपैतामहं पुत्रपौत्रानुगामि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2040750, "chapter_id": 1903, "verse_number": "५-१४८-३४", "content_sanskrit": "यद्वै ब्रूते कुरुमुख्यो महात्मा\nदेवव्रतः सत्यसन्धो मनीषी ।\nसर्वं तदस्माभिरहत्य कार्यं\nराज्यं स्वधर्मान्परिपालयद्भिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2040751, "chapter_id": 1903, "verse_number": "५-१४८-३५", "content_sanskrit": "अनुज्ञया चाथ महाव्रतस्य\nब्रूयान्नृपोऽयं विदुरस्तथैव।\nकार्यं भवेत्तत्सुहृद्भिर्नियोज्यं\nधर्मं पुरस्कृत्य सुदीर्घकालम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2040752, "chapter_id": 1903, "verse_number": "५-१४८-३६", "content_sanskrit": "न्यायागतं राज्यमिदं कुरूणां\nयुधिष्ठिरः शास्तु वै धर्मपुत्रः ।\nप्रचोदितो धृतराष्ट्रेण राज्ञा\nपुरस्कृतः शान्तनवेन चैव ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2040753, "chapter_id": 1903, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि अष्टचत्वारिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]