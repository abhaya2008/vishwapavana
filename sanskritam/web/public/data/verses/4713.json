[{"id": 2175086, "chapter_id": 4713, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175087, "chapter_id": 4713, "verse_number": "१", "content_sanskrit": "उषित्वा तत्र रामस्तु सम्पूज्याश्रमवासिनः ।\nतदा मङ्कणके प्रीतिं परां चक्रे हलायुधः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175088, "chapter_id": 4713, "verse_number": "२", "content_sanskrit": "दत्त्वा दानं द्विजातिभ्यो रजनीं तामुपोष्य च ।\nपूजितो मुनिभिश्चैव प्रातरुत्थाय लाङ्गली\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175089, "chapter_id": 4713, "verse_number": "३", "content_sanskrit": "अनुज्ञाप्य मुनीन् सर्वान् स्पृष्ट्वा तोयं च भारत ।\nप्रययौ त्वरितं रामस्तीर्थहेतोर्महाबलः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175090, "chapter_id": 4713, "verse_number": "४", "content_sanskrit": "ततस्त्वौशनसं तीर्थमाजगाम हलायुधः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175091, "chapter_id": 4713, "verse_number": "५", "content_sanskrit": "कपालमोचनं नाम यत्र मुक्तो महामुनिः ।\nमहता शिरसा राजन् ग्रस्तजङ्घो महोदरः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175092, "chapter_id": 4713, "verse_number": "६", "content_sanskrit": "राक्षसस्य महाराज रामक्षिप्तस्य वै पुरा ।\nतत्र पूर्वं तपस्तप्तं काव्येन सुमहात्मना\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175093, "chapter_id": 4713, "verse_number": "७", "content_sanskrit": "यत्रास्य नीतिर्निखिला प्रादुर्भूता महात्मनः ।\nयत्र सञ्चिन्तयामास देवदानवविग्रहम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175094, "chapter_id": 4713, "verse_number": "८", "content_sanskrit": "तत् प्राप्य च बलो राजन् तीर्थप्रवरमुत्तमम् ।\nविधिवद्धि ददौ वित्तं ब्राह्मणानां महात्मनाम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175095, "chapter_id": 4713, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175096, "chapter_id": 4713, "verse_number": "९", "content_sanskrit": "कपालमोचनं ब्रह्मन् कथं प्राप्तो महामुनिः ।\nकथं चास्य शिरो लग्नं केन चैव तु हेतुना\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175097, "chapter_id": 4713, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175098, "chapter_id": 4713, "verse_number": "१०", "content_sanskrit": "पुरा वै दण्डकारण्ये राघवेण महात्मना ।\nवसता राजशार्दूल राक्षसास्तत्र हिंसिताः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2175099, "chapter_id": 4713, "verse_number": "११", "content_sanskrit": "जनस्थाने शिरश्छिन्नं राक्षसस्य दुरात्मनः ।\nक्षुरेण शितधारेण तत् पपात महावने\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2175100, "chapter_id": 4713, "verse_number": "१२", "content_sanskrit": "महोदरस्य तल्लग्नं जङ्घायां वै यदृच्छया ।\nवने विचरतो राजन्नस्थि भित्त्वाऽस्फुरत् तदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2175101, "chapter_id": 4713, "verse_number": "१३", "content_sanskrit": "स तेन लग्नेन तदा द्विजातिर्न शशाक ह ।\nअभिगन्तुं महाप्राज्ञ तीर्थान्यायतनानि च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2175102, "chapter_id": 4713, "verse_number": "१४", "content_sanskrit": "सपूतिना विस्रवता वेदनार्तो महामुनिः ।\nजगाम सर्वतीर्थानि पृथिव्यामिति नः श्रुतम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2175103, "chapter_id": 4713, "verse_number": "१५", "content_sanskrit": "स गत्वा सरितः सर्वाः समुद्रांश्च महातपाः ।\nकथयामास तत् सर्वमृषीणां भावितात्मनाम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2175104, "chapter_id": 4713, "verse_number": "१६", "content_sanskrit": "आप्लुतः सर्वतीर्थेषु न च मोक्षमवाप्तवान् ।\nस तु शुश्राव विप्रेन्द्रो मुनीनां वचनं महत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2175105, "chapter_id": 4713, "verse_number": "१७", "content_sanskrit": "सरस्वत्यां तीर्थवरं ख्यातमौशनसं तथा ।\nसर्वपापप्रशमनं सिद्धिक्षेत्रमनुत्तमम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2175106, "chapter_id": 4713, "verse_number": "१८", "content_sanskrit": "स तु गत्वा ततः तत्र तीर्थमौशनसं द्विजः ।\nततश्चौशनसं तीर्थं तस्योपस्पृशतस्तदा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2175107, "chapter_id": 4713, "verse_number": "१९", "content_sanskrit": "तच्छिरश्चरणं मुक्त्वा पपातान्तर्जले ततः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2175108, "chapter_id": 4713, "verse_number": "२०", "content_sanskrit": "ततः स विरुजो भूत्वा पूतात्मा वीतकल्मषः ।\nआजगमाश्रमं प्रीतः कृतकृत्यो महोदरः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2175109, "chapter_id": 4713, "verse_number": "२१", "content_sanskrit": "सोऽथ गत्वाऽश्रमं पुण्यं विप्रमुक्तो महातपाः ।\nकथयामास तत्सर्वम् ऋषीणां भावितात्मनाम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2175110, "chapter_id": 4713, "verse_number": "२२", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य तदा तीर्थस्य मानद ।\nकपालमोचनमिति नाम चक्रुः समागताः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2175111, "chapter_id": 4713, "verse_number": "२३", "content_sanskrit": "तत्र दत्वा बहून् देयान् विप्रान् सम्पूज्य सादरम् ।\nजगाम तत्र राजेन्द्र उशङ्गोराश्रमं प्रति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2175112, "chapter_id": 4713, "verse_number": "२४", "content_sanskrit": "यत्र तप्तं तपो घोरमार्ष्टिषेणेन भारत ।\nब्राह्मण्यं लब्धवान् यत्र विश्वामित्रो महातपाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2175113, "chapter_id": 4713, "verse_number": "२५", "content_sanskrit": "ततो हलायुधः श्रीमान् ब्राह्मणैः परिवारितः ।\nजगाम तत्र राजेन्द्र उशङ्गुस्तनुमत्यजत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2175114, "chapter_id": 4713, "verse_number": "२६", "content_sanskrit": "उशङ्गुर्ब्राह्मणो वृद्धः तपोनित्यश्च भारत ।\nदेहन्यासे कृतमना विचिन्त्य बहुधा नृप\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2175115, "chapter_id": 4713, "verse_number": "२७", "content_sanskrit": "ततः सर्वानुपादाय तनयान् वै महातपाः ।\nउशङ्गुरब्रवीत् तत्र नयध्वं मां पृथूदकम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2175116, "chapter_id": 4713, "verse_number": "२८", "content_sanskrit": "विज्ञायातीतवयसमुशङ्गुं तं तपोधनाः ।\nतद्वै तीर्थमुपानिन्युः सरस्वत्यास्तपोधनम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2175117, "chapter_id": 4713, "verse_number": "२९", "content_sanskrit": "स तैः पुत्रैस्तदा धीमानानीतो वै सरस्वतीम् ।\nपुण्यां तीर्थशतोपेतां विद्वत्सङ्घैर्निषेविताम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2175118, "chapter_id": 4713, "verse_number": "३०", "content_sanskrit": "स तत्र विधिना राजन्नाप्लुत्य सुमहातपाः ।\nज्ञात्वा तीर्थगुणं चैव प्राहेदं मुनिसत्तमः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2175119, "chapter_id": 4713, "verse_number": "३१", "content_sanskrit": "सुप्रीतः पुरुषव्याघ्रः सर्वान् पुत्रानिदं वचः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2175120, "chapter_id": 4713, "verse_number": "", "content_sanskrit": "उशङ्गुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2175121, "chapter_id": 4713, "verse_number": "३२", "content_sanskrit": "सरस्वत्युत्तरे तीरे यस्त्यजेदात्मनस्तनुम् ।\nपृथूदके जप्यपरो नैनं श्वो मरणं तपेत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2175122, "chapter_id": 4713, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2175123, "chapter_id": 4713, "verse_number": "३३", "content_sanskrit": "तत्राप्लुत्य स धर्मात्मा उपस्पृश्य हलायुधः ।\nदत्त्वा चैव बहून् देयान् विप्राणां विप्रवत्सलः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2175124, "chapter_id": 4713, "verse_number": "३४", "content_sanskrit": "ससर्ज यत्र भगवान् ब्रह्मा लोकपितामहः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2175125, "chapter_id": 4713, "verse_number": "३५", "content_sanskrit": "यत्रार्ष्टिषेणः कौरव्य ब्राह्मणः संशितव्रतः ।\nतपसा महता राजन् प्राप्तवान् सिद्धिमुत्तमाम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2175126, "chapter_id": 4713, "verse_number": "३६", "content_sanskrit": "सिन्धुद्वीपश्च राजर्षिर्देवापिश्च महातपाः ।\nसिन्धुद्वीपं च सम्प्राप्य ब्राह्मण्यँल्लब्धवान् पुरा ।\nब्राह्मण्यं लब्धवान् यत्र विश्वामित्रो महातपाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2175127, "chapter_id": 4713, "verse_number": "३७", "content_sanskrit": "तपस्वी भगवानुग्र उरुतेजा महायशाः ।\nतत्राजगाम बलवान् बलदेवः प्रतापवान्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2175128, "chapter_id": 4713, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां गदापर्वणि\nबलभद्रयात्रायां वृषघ्नचरितं नाम एकादशोऽध्यायः ॥११॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]