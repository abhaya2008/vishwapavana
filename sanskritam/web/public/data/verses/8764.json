[{"id": 900010011, "chapter_id": 8764, "verse_number": "1.1", "content_sanskrit": "सदमितगुणसिन्धुः सर्ववेदाभिधेयो विगतविमतिधामा हेयशून्यो रमेशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900010012, "chapter_id": 8764, "verse_number": "1.2", "content_sanskrit": "इतिहासपुराणाभ्यां वेदं समुपबृंहयेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900010013, "chapter_id": 8764, "verse_number": "1.3", "content_sanskrit": "विष्णुरेव विजिज्ञास्यः सर्वकर्ताऽगमोदितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900010014, "chapter_id": 8764, "verse_number": "1.4", "content_sanskrit": "अहं सर्वस्य प्रभवो मत्तः सर्व प्रवर्तते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900010015, "chapter_id": 8764, "verse_number": "1.5", "content_sanskrit": "मयाऽध्यक्षेणप्रकृतिः सूयते सचराचरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900010016, "chapter_id": 8764, "verse_number": "1.6", "content_sanskrit": "वेदैश्च सर्वैरहमेव वेद्य:", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900010017, "chapter_id": 8764, "verse_number": "1.7", "content_sanskrit": "मनसैवानुद्रष्टव्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900010018, "chapter_id": 8764, "verse_number": "1.8", "content_sanskrit": "ईश्वरः सर्वभूतानां हृद्देशेऽर्जुन तिष्ठति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]