[{"id": 2024796, "chapter_id": 1531, "verse_number": "३-१६९-०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024797, "chapter_id": 1531, "verse_number": "३-१६९-१", "content_sanskrit": "ततस्तामवसं प्रीतो रजनीं तत्र भारत।\nप्रसादाद्देवदेवस्यत्र्यम्बकस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024798, "chapter_id": 1531, "verse_number": "३-१६९-२", "content_sanskrit": "व्युषितो रजनीं चाहंकृत्वापौर्वाह्णिकीः क्रियाः।\nअपश्यं तं द्विजश्रेष्ठं दृष्टवानस्मि यं पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024799, "chapter_id": 1531, "verse_number": "३-१६९-३", "content_sanskrit": "तस्मै चाहं यथावृत्तं सर्वमेव न्यवेदयम्।\nभगवन्तं महादेवं समेतोस्मीति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024800, "chapter_id": 1531, "verse_number": "३-१६९-४", "content_sanskrit": "स मामुवाच राजेन्द्र प्रीयमाणो द्विजोत्तमः।\nदृष्टस्त्वया महादेवो यथा नान्येन केनचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024801, "chapter_id": 1531, "verse_number": "३-१६९-५", "content_sanskrit": "समेतं लोकपालैस्तु सर्वैर्वैवस्वतादिभिः।\nद्रष्टास्यनघ देवेन्द्रं स च तेऽस्त्राणि दास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024802, "chapter_id": 1531, "verse_number": "३-१६९-६", "content_sanskrit": "एवमुक्त्वा स मां राजन्नाश्लिष्य च पुनः पुनः।\nअगच्छत्स यथाकामं ब्राह्मणः सूर्यसन्निभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024803, "chapter_id": 1531, "verse_number": "३-१६९-७", "content_sanskrit": "अथापराह्णे तस्याह्नः प्रावात्पुण्यः समीरणः।\nपुनर्नवमिमं लोकं कुर्वन्निव सपत्नहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024804, "chapter_id": 1531, "verse_number": "३-१६९-८", "content_sanskrit": "दिव्यानि चैव माल्यानि सुगन्धीनि नवानि च।\nशैशिरस्य गिरे पादे प्रादुरासन्समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024805, "chapter_id": 1531, "verse_number": "३-१६९-९", "content_sanskrit": "वादित्राणिच दिव्यानि सुघोषाणि समन्ततः।\nस्तुतयश्चेन्द्रसंयुक्ता अश्रूयन्त मनोहराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024806, "chapter_id": 1531, "verse_number": "३-१६९-१०", "content_sanskrit": "गणाश्चाप्सरसां तत्रगन्धर्वाणां तथैव च।\nपुरस्ताद्देवदेवस्य जगुर्गीतानि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024807, "chapter_id": 1531, "verse_number": "३-१६९-११", "content_sanskrit": "मरुतां च गणास्तत्र देवयानैरुपागमन्।\nमहेन्द्रानुचरा ये च देवसद्मनिवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024808, "chapter_id": 1531, "verse_number": "३-१६९-१२", "content_sanskrit": "ततो मरुत्वानहरिभिर्युक्तैर्वाहैः स्वलंकृतैः।\nशचीसहायस्तत्रायात्सह सर्वैस्तदाऽमरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024809, "chapter_id": 1531, "verse_number": "३-१६९-१३", "content_sanskrit": "एतस्मिन्नैव काले तु कुबेरो नरवाहनः।\nदर्शयामास मां राजँल्लक्ष्म्या परमया युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024810, "chapter_id": 1531, "verse_number": "३-१६९-१४", "content_sanskrit": "दक्षिणस्यां दिशि यमं प्रत्यपश्यं व्यस्थितम्।\nवरुणं देवराजं च यथास्थानमवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024811, "chapter_id": 1531, "verse_number": "३-१६९-१५", "content_sanskrit": "ते मामूचुर्महाराज सान्त्वयित्वा सुरर्षभाः।\nसव्यसाचिन्निरीक्षास्माँल्लोकपालानवस्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024812, "chapter_id": 1531, "verse_number": "३-१६९-१६", "content_sanskrit": "सुरकार्यार्थसिद्ध्यर्थं दृष्टवानसि शंकरम्।\nअस्मत्तोऽपि गृहाण त्वमस्त्राणीति समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024813, "chapter_id": 1531, "verse_number": "३-१६९-१७", "content_sanskrit": "ततोऽहं प्रयतो भूत्वा प्रणिपत्य सुरर्षभान्।\nप्रत्यगृह्णां तदाऽस्त्राणि महान्ति विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024814, "chapter_id": 1531, "verse_number": "३-१६९-१८", "content_sanskrit": "गृहीतास्त्रस्ततो देवैरनुज्ञातोस्मि भारत।\nअथ देवा ययुः सर्वेयथागतमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024815, "chapter_id": 1531, "verse_number": "३-१६९-१९", "content_sanskrit": "मघवानपि मां देवो रथमारोप्य सुप्रभम्।\nउवाच भगवान्वाक्यं स्मयन्निव महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024816, "chapter_id": 1531, "verse_number": "३-१६९-२०", "content_sanskrit": "पुरैवागमनादस्माद्वेदाहं त्वां धनंजय।\nअतः परं त्वहं वै त्वां दर्शये भरत्रषभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024817, "chapter_id": 1531, "verse_number": "३-१६९-२१", "content_sanskrit": "त्वया हि तीर्थेषु पुरा समाप्लावः कृतोऽसकृत्।\nतपश्चेदं महत्त्प्तं स्वर्गं गन्तासि पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024818, "chapter_id": 1531, "verse_number": "३-१६९-२२", "content_sanskrit": "भूयश्चैव च तप्तव्यं तपश्चरणमुत्तमम्।\n`दुश्चरं घोरमस्त्राणां तपोबलकरं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024819, "chapter_id": 1531, "verse_number": "३-१६९-२३", "content_sanskrit": "स्वर्गस्त्ववश्यं गन्तव्यस्त्वया शत्रुनिषूदन।\nमातलिर्मन्नियोगात्त्वां त्रिदिवं प्रापयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024820, "chapter_id": 1531, "verse_number": "३-१६९-२४", "content_sanskrit": "विदितस्त्वंहि देवानां मुनीनां च महात्मनाम्।\n`इहस्थः पाण्डवश्रेष्ठ तपः कुर्वन्सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024821, "chapter_id": 1531, "verse_number": "३-१६९-२५", "content_sanskrit": "ततोऽहमब्रुवं शक्रं प्रसीद भगवन्मम।\nआचार्यं वरयेऽहं त्वामस्त्रार्थं त्रिदशेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024822, "chapter_id": 1531, "verse_number": "३-१६९-२६x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024823, "chapter_id": 1531, "verse_number": "३-१६९-२६", "content_sanskrit": "क्रूरकर्माऽस्त्रवित्तात भविष्यसि परंतप।\nयदर्थमस्त्राणीप्सुस्त्वं तं कामं पाण्डवाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2024824, "chapter_id": 1531, "verse_number": "३-१६९-२७", "content_sanskrit": "ततोऽहमब्रुवं नाहं दिव्यान्यस्त्राणि शत्रुहन्।\nमानुषेषु प्रयोक्ष्यामि विनाऽस्त्रप्रतिघातनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2024825, "chapter_id": 1531, "verse_number": "३-१६९-२८", "content_sanskrit": "तानि दिव्यानि मेऽस्त्राणि प्रयच्छ विबुधाधिप।\nलेकांश्चास्त्रजितान्पश्चाल्लभेयं सुरपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2024826, "chapter_id": 1531, "verse_number": "३-१६९-२९x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2024827, "chapter_id": 1531, "verse_number": "३-१६९-२९", "content_sanskrit": "परीक्षार्थं मयैतत्ते वाक्यमुक्तं धनंजय।\nममात्मजस्य वचनं सूपपन्नमिदं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2024828, "chapter_id": 1531, "verse_number": "३-१६९-३०", "content_sanskrit": "शिक्ष मे भवनं गत्वासर्वाण्यस्त्राणि भारत।\nवायोरग्नेर्वसुभ्योऽपि वरुणात्समरुद्गणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2024829, "chapter_id": 1531, "verse_number": "३-१६९-३१", "content_sanskrit": "साध्यं पैतामहं चैव गन्धर्वोरगरक्षसाम्।\nवैष्णवानि च सर्वाणि नैर्ऋतानि तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2024830, "chapter_id": 1531, "verse_number": "३-१६९-३२", "content_sanskrit": "मद्गतानि च जानीहि सर्वास्त्राणि कुरूद्वह।\nएवमुक्त्वा तु मां शक्रस्तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2024831, "chapter_id": 1531, "verse_number": "३-१६९-३३", "content_sanskrit": "अथापश्यं हरियुजं रथमैन्द्रमुपस्थितम्।\nदिव्यं मायामयं पुण्यं यत्तं मातलिना नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2024832, "chapter_id": 1531, "verse_number": "३-१६९-३४", "content_sanskrit": "लोकपालेषु यातेषु मामुवाचाथ मातलिः।\nद्रष्टुमिच्छति शक्रस्त्वां देवराजो महाद्युते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2024833, "chapter_id": 1531, "verse_number": "३-१६९-३५", "content_sanskrit": "संसिद्धस्त्वं महाबाहो कुरु कार्यमनुत्तमम्।\nपश्य पुण्यकृतां लोकान्सशरीरो दिवं व्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2024834, "chapter_id": 1531, "verse_number": "३-१६९-३६", "content_sanskrit": "देवराजः सहस्राक्षस्त्वां दिदृक्षति भारत।\nइत्युक्तोऽहं मातलिना गिरिमामन्त्र्य शैशिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2024835, "chapter_id": 1531, "verse_number": "३-१६९-३७", "content_sanskrit": "प्रदक्षिणमुपावृत्य समारोहं रथोत्तमम्।\nचोदयामास स हयान्मनोमारुतरंहसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2024836, "chapter_id": 1531, "verse_number": "३-१६९-३८", "content_sanskrit": "[मातलिर्हयतत्त्वज्ञो यथावद्भूरिदक्षिणः।\nअवैक्षत च मे वक्रृंस्तितस्याथ ससारथिः।\nतथा भ्रान्ते रथे राजन्विस्मितश्चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2024837, "chapter_id": 1531, "verse_number": "३-१६९-३९", "content_sanskrit": "अत्यद्भुतमिदं त्वद्यविचित्रं प्रतिभाति मे।\nयदास्थितो रथं दिव्यं पदान्न चलितः पदम् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2024838, "chapter_id": 1531, "verse_number": "३-१६९-४०", "content_sanskrit": "देवराजोऽपिहि मया नित्यमत्रोपलक्षितः।\nविचलन्प्रथमोत्पाते हयानां भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2024839, "chapter_id": 1531, "verse_number": "३-१६९-४१", "content_sanskrit": "त्वं पुनः स्थित एवात्ररथे भ्रान्ते कुरूद्वह।\nअतिशक्रमिदं सर्वं तवेति प्रतिभाति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2024840, "chapter_id": 1531, "verse_number": "३-१६९-४२", "content_sanskrit": "इत्युक्त्वाऽऽकाशमाविश्य मातलिर्विबुधालयान्।\nदर्शयामास मे राजन्विमानानि च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2024841, "chapter_id": 1531, "verse_number": "३-१६९-४३", "content_sanskrit": "[स रथो हरिभिर्युक्तो ह्यूर्ध्वमाचक्रमे ततः।\nऋषयो देवताश्चैव पूजयन्ति नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2024842, "chapter_id": 1531, "verse_number": "३-१६९-४४", "content_sanskrit": "ततः कामगमाँल्लोकानपश्यं वै सुरर्षिणाम्।\nगन्धर्वाप्सरसां चैव प्रभावममितौजसाम् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2024843, "chapter_id": 1531, "verse_number": "३-१६९-४५", "content_sanskrit": "नन्दनादीनि देवानां वनान्युपवनानि च।\nदर्शयामास मे शीघ्रं मातलिः शक्रसारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2024844, "chapter_id": 1531, "verse_number": "३-१६९-४६", "content_sanskrit": "ततः शक्रस्य भवनमपश्यभमरावतीम्।\nदिव्यैः कामफलैर्वृक्षै रत्नैश्च समलंकृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2024845, "chapter_id": 1531, "verse_number": "३-१६९-४७", "content_sanskrit": "न तां भासयते सूर्यो न शीतोष्णे न च क्लमः।\nन बाधते तत्ररजस्तत्रास्ति न जरा नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2024846, "chapter_id": 1531, "verse_number": "३-१६९-४८", "content_sanskrit": "न तत्रशोको दैन्यं वा वैवर्ण्यं चोपलक्ष्यते।\nदिवौकसां महाराज न ग्लानिररिमर्दन।\nन क्रोधलोभौ तत्रास्तामशुबं वा विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2024847, "chapter_id": 1531, "verse_number": "३-१६९-४९", "content_sanskrit": "नित्यं तुष्टाश् ते राजन्प्राणिनः सुरवेश्मनि।\nनित्यपुष्पफलास्तत्र पादपा हरितच्छदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2024848, "chapter_id": 1531, "verse_number": "३-१६९-५०", "content_sanskrit": "पुष्करिण्यश्च विविधाः पद्मसौगन्धिकायुताः।\nशीतस्तत्रववौ वायुः सुगन्धो वीजते शुभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2024849, "chapter_id": 1531, "verse_number": "३-१६९-५१", "content_sanskrit": "सर्वरत्नविचित्रा च भूमिः पुष्पविभूषिता।\nमृगद्विजाश्च बहवो रुचिरा मधुरस्वराः।\nविमानगामिनश्चात्रदृश्यन्ते बहवोऽमराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2024850, "chapter_id": 1531, "verse_number": "३-१६९-५२", "content_sanskrit": "ततोऽपश्यं वसून्रुद्रान्साध्यांश्च समरुद्गणान्।\nआदित्यानश्विनौ चैव तान्सर्वान्प्रत्यपूजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2024851, "chapter_id": 1531, "verse_number": "३-१६९-५३", "content_sanskrit": "ते मां वीर्येण यशसा तेजसा च बलेन च।\nअस्त्रैश्चाप्यन्वजानन्त संग्रामे विजयेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2024852, "chapter_id": 1531, "verse_number": "३-१६९-५४", "content_sanskrit": "प्रविश्य तां पुरीं दिव्यां देवगन्धर्वपूजिताम्।\nदेवराजं सहस्राक्षमुपातिष्ठं कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2024853, "chapter_id": 1531, "verse_number": "३-१६९-५५", "content_sanskrit": "ददावर्धासनं प्रीतः शक्रो मे ददतांवरः।\nबहुमानाच्च गात्राणि पस्पर्श मम वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2024854, "chapter_id": 1531, "verse_number": "३-१६९-५६", "content_sanskrit": "तत्राहं देवगन्धर्वैः सहितो भूरिदक्षिणैः।\nअस्त्रार्तमवसं स्वर्गे शिक्षाणोऽस्त्राणि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2024855, "chapter_id": 1531, "verse_number": "३-१६९-५७", "content_sanskrit": "विश्वावसोश्च वै पुत्रश्चित्रसेनोऽभवत्सखा।\nस च गान्धर्वमखिलं ग्राहयामास मां नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2024856, "chapter_id": 1531, "verse_number": "३-१६९-५८", "content_sanskrit": "तत्राहमवसं राजन्गृहीतास्त्रः सुपूजितः।\nसुखं शक्रस् भवने सर्वकामसमन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2024857, "chapter_id": 1531, "verse_number": "३-१६९-५९", "content_sanskrit": "शृण्वन्वै गीतशब्दं च तूर्यशब्दं च पुष्कलम्।\nपश्यंश्चाप्सरसः श्रेष्ठा नृत्यन्तीर्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2024858, "chapter_id": 1531, "verse_number": "३-१६९-६०", "content_sanskrit": "तत्सर्वमनवज्ञाय तथ्यं विज्ञाय भारत।\nअत्यर्थं प्रतिगृह्याहमस्त्रेष्वेव व्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2024859, "chapter_id": 1531, "verse_number": "३-१६९-६१", "content_sanskrit": "ततोऽतुष्यत्सहस्राक्षस्तेन कामेन मे विभुः।\nएवं मे वसतो राजन्नेष कालोऽत्यगाद्दिवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2024860, "chapter_id": 1531, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि निवातकवचयुद्धपर्वणि एकोनसप्तत्यधिकशततमोऽध्यायः ॥ १६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]