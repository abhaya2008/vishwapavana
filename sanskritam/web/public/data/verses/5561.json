[{"id": 2213547, "chapter_id": 5561, "verse_number": "", "content_sanskrit": "व्यासेन गान्धारीं प्रति समरहतानां दुर्योधनादीनां सर्वेषां रात्रौ प्रदर्शनप्रतिज्ञान-\nपूर्वकं धृतराष्ट्रादीनां विशिष्य गन्धर्वांशत्वकथनम् । धृतराष्ट्रादिभिः\nव्यासवचनात् गङ्गातीरमेत्य बन्धुदर्शनौत्कण्ठ्येन कृच्छ्रादहर्यापनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213548, "chapter_id": 5561, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213549, "chapter_id": 5561, "verse_number": "१", "content_sanskrit": "भद्रे द्रक्ष्यसि गान्धारि पुत्रान् भ्रातॄन् स्वकान् गणान् ।\nवधूश्च पतिभिः सार्धं निशि सुप्तोत्थिता इव\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213550, "chapter_id": 5561, "verse_number": "२", "content_sanskrit": "कर्णं द्रक्ष्यति कुन्ती च सौभद्रं चापि यादवी ।\nद्रौपदी पञ्चपुत्रांश्च पितृन् भ्रातॄंस्तथैव च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213551, "chapter_id": 5561, "verse_number": "३", "content_sanskrit": "पूर्वमेवैष हृदये व्यवसायोऽभवन्मम ।\nयदाऽस्मि चोदितो राज्ञा भवत्या पृथयैव च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213552, "chapter_id": 5561, "verse_number": "४", "content_sanskrit": "न ते शोच्या महात्मानः सर्व एव नरर्षभाः ।\nक्षत्रधर्मपराः सन्तस्तथा हि निधनं गताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213553, "chapter_id": 5561, "verse_number": "५", "content_sanskrit": "(भवितव्यमवश्यं तत्सुरकार्यमनिन्दिते ।\nअवतेरुस्ततः सर्वे देवा भागैर्महीतळम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213554, "chapter_id": 5561, "verse_number": "६", "content_sanskrit": "गन्धर्वाप्सरसश्चैव पिशाचा गुह्यराक्षसाः ।)\nतथा पुण्यजनाश्चैव सिद्धा देवर्षयोऽपि च\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213555, "chapter_id": 5561, "verse_number": "७", "content_sanskrit": "देवाश्च दानवाश्चैव तथा देवर्षयोऽमलाः ।\nत एते निधनं प्राप्ताः कुरुक्षेत्रे रणाजिरे\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213556, "chapter_id": 5561, "verse_number": "८", "content_sanskrit": "गन्धर्वराजो यो धीमान् धृतराष्ट्र इति श्रुतः ।\nस एव मानुषे लोके धृतराष्ट्रः पतिस्तव\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213557, "chapter_id": 5561, "verse_number": "९", "content_sanskrit": "पाण्डुं मरुद्गणाद् विद्धि विशिष्टतममच्युतम् ।\nधर्मस्यांशोऽभवत् क्षत्ता राजा चैव युधिष्ठिरः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213558, "chapter_id": 5561, "verse_number": "१०", "content_sanskrit": "कलिं दुर्योधनं विद्धि शकुनिं द्वापरं नृपम् ।\nदुःशासनादीन् विद्धि त्वं राक्षसान् शुभदर्शने\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213559, "chapter_id": 5561, "verse_number": "११", "content_sanskrit": "मरुद्गणाद् भीमसेनं बलवन्तमरिन्दमम् ।\nविद्धि त्वं तु नरमृषिमिमं पार्थं धनञ्जयम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213560, "chapter_id": 5561, "verse_number": "१२", "content_sanskrit": "नारायणं हृषीकेशमश्विनौ यमजौ तथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213561, "chapter_id": 5561, "verse_number": "१३", "content_sanskrit": "द्विधा कृत्वाऽऽत्मनो देहमादित्यं तपतांवरम् ।\nलोकांश्च तापयानं वै कर्णं विद्धि पृथासुतम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213562, "chapter_id": 5561, "verse_number": "१४", "content_sanskrit": "यः स वैरार्थमुद्भूतः सङ्घर्षजननस्तथा ।\nतं कर्णं विद्धि कल्याणि भास्करं शुभदर्शने\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213563, "chapter_id": 5561, "verse_number": "१५", "content_sanskrit": "यश्च पाण्डवदायादो हतः षड्भिर्महारथैः ।\nस सोम इह सौभद्रो योगादेवाभवद् द्विधा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213564, "chapter_id": 5561, "verse_number": "१६", "content_sanskrit": "द्रौपद्या सह सम्भूतं धृष्टद्युम्नं च पावकात् ।\nअग्नेर्भागं शुभं विद्धि राक्षसं तु शिखण्डिनम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213565, "chapter_id": 5561, "verse_number": "१७", "content_sanskrit": "द्रोणं बृहस्पतेर्भागं विद्धि द्रौणिं च रुद्रजम् ।\nगाङ्गेयो वसुवीर्येण देवो मानुषतां गतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213566, "chapter_id": 5561, "verse_number": "१८", "content_sanskrit": "एवमेते महाप्रज्ञे देवा मानुष्यमेत्य हि ।\nततः पुनर्गताः स्वर्गं कृते कर्मणि शोभने\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213567, "chapter_id": 5561, "verse_number": "१९", "content_sanskrit": "यच्च वै हृदि सर्वेषां दुःखमेतच्चिरं स्थितम् ।\nतदद्य व्यपनेष्यामि परलोककृताद् भयात्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213568, "chapter_id": 5561, "verse_number": "२०", "content_sanskrit": "सर्वे भवन्तो गच्छन्तु नदीं भागीरथीं प्रति ।\nतत्र द्रक्ष्यथ तान् सर्वान् ये हतास्तत्र संयुगे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213569, "chapter_id": 5561, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213570, "chapter_id": 5561, "verse_number": "समाप्तिः", "content_sanskrit": "इति व्यासस्य वचनं श्रुत्वा सर्वो जनस्तदा ।\nमहता सिंहनादेन गङ्गामभिमुखो ययौ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213571, "chapter_id": 5561, "verse_number": "२२", "content_sanskrit": "धृतराष्ट्रश्च सामात्यः प्रययौ सह पाण्डवैः ।\nसहितो मुनिशार्दूलैर्गन्धर्वैश्च समागतैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213572, "chapter_id": 5561, "verse_number": "२३", "content_sanskrit": "ततो गङ्गां समासाद्य क्रमेण स जनार्णवः ।\nनिवासमकरोत् सर्वो यथाप्रीति यथासुखम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2213573, "chapter_id": 5561, "verse_number": "२४", "content_sanskrit": "राजा च पाण्डवैः सार्धमिष्टे देशे सहानुगः ।\nनिवासमकरोद्धीमान् सस्त्रीवृद्धपुरःसरः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2213574, "chapter_id": 5561, "verse_number": "२५", "content_sanskrit": "जगाम तदहश्चापि तेषां वर्षशतं तथा ।\nनिशां प्रतीक्षमाणानां दिदृक्षूणां मृतान् नृपान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2213575, "chapter_id": 5561, "verse_number": "२६", "content_sanskrit": "अथ पुण्यं गिरिवरमस्तमभ्यगमद् रविः ।\nततः कृताभिषेकास्ते नैशं कर्म समाचरन्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2213576, "chapter_id": 5561, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि\nसप्तत्रिंशोऽध्यायः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2213577, "chapter_id": 5561, "verse_number": "", "content_sanskrit": "पुत्रदर्शनपर्वणि चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]