[{"id": 900000854, "chapter_id": 8187, "verse_number": "3.1", "content_sanskrit": "यदि मन्यसे सुवेदेति दहरमेवापि नूनं त्वं वेत्थ ब्रह्मणो रूपम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900000855, "chapter_id": 8187, "verse_number": "3.2", "content_sanskrit": "नाहमन्ये सुवेदेति नो न वेदेति वेद च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900000856, "chapter_id": 8187, "verse_number": "3.3", "content_sanskrit": "यस्यामतं तस्य मतं मतं यस्य न वेद सः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900000857, "chapter_id": 8187, "verse_number": "3.4", "content_sanskrit": "प्रतिबोधविदितं मतममृतत्वं हि विन्दते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900000858, "chapter_id": 8187, "verse_number": "3.5", "content_sanskrit": "इह चेदवेदीदथ सत्यमस्ति नचेदिहावेदीन्महती विनष्टिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]