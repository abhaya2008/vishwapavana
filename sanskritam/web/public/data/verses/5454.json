[{"id": 2208485, "chapter_id": 5454, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208486, "chapter_id": 5454, "verse_number": "१", "content_sanskrit": "सन्न्यासं तप इत्याहुर्वृद्धा निश्चितदर्शिनः ।\nब्राह्मणा ब्रह्मयोनिस्था ज्ञानं ब्रह्म परं विदुः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208487, "chapter_id": 5454, "verse_number": "२", "content_sanskrit": "अतिदूरात्मकं ब्रह्म वेदविद्याव्यपाश्रयम् ।\nनिर्द्वन्द्वं निर्गुणं नित्यमचिन्त्यं गुह्यमुत्तमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208488, "chapter_id": 5454, "verse_number": "३", "content_sanskrit": "ध्यानेन तपसा चैव धीराः पश्यन्ति तत्पदम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208489, "chapter_id": 5454, "verse_number": "४", "content_sanskrit": "निर्मुक्ततमसः पूता व्युत्क्रान्तरजसोऽमलाः ।\nतपसा क्षेममध्वानं गच्छन्तीति मनीषिणः ।\nसन्न्यासनिरता नित्यं ये च ब्रह्मविदो जनाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208490, "chapter_id": 5454, "verse_number": "५", "content_sanskrit": "तपः प्रदीप इत्याहुराचारो धर्मसाधकः ।\nज्ञानं त्वेव परं विद्मः सन्न्यासं तप उत्तमम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208491, "chapter_id": 5454, "verse_number": "६", "content_sanskrit": "यस्तु वेद निराबाधं ज्ञानं तत्त्वविनिश्चयात् ।\nसर्वभूतस्थमात्मानं स सर्वविदिहोच्यते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208492, "chapter_id": 5454, "verse_number": "७", "content_sanskrit": "यो विद्वान् सहवासं च विवासं चैव पश्यति ।\nतथैवैकत्वनानात्वे स दुःखात् प्रतिमुच्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208493, "chapter_id": 5454, "verse_number": "८", "content_sanskrit": "यो न कामयते किञ्चिन्न किञ्चिदिति मन्यते ।\nइह लोकस्थ एवैष ब्रह्मभूयाय कल्पते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208494, "chapter_id": 5454, "verse_number": "९", "content_sanskrit": "प्रधानगुणतत्त्वज्ञः सर्वभूतविधानवित् ।\nनिर्ममो निरहङ्कारो मुच्यते नात्र संशयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208495, "chapter_id": 5454, "verse_number": "१०", "content_sanskrit": "निर्द्वन्द्वो निर्नमस्कारो निःस्वधाकार एव च ।\nनिर्द्वन्द्वं निर्गुणं नित्यं प्रशमेनैव गच्छति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208496, "chapter_id": 5454, "verse_number": "११", "content_sanskrit": "हित्वा गुणमयं सर्वं कर्म जन्तुः शुभाशुभम् ।\nउभे सत्यानृते हित्वा मुच्यते नात्र संशयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208497, "chapter_id": 5454, "verse_number": "१२", "content_sanskrit": "अव्यक्तबुद्धिप्रभवो बुद्धिस्कन्धमयो महान् ।\nमहाहङ्कारविटप इन्द्रियान्तरकोटरः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208498, "chapter_id": 5454, "verse_number": "१३", "content_sanskrit": "महाभूतविशाखश्च विशेषप्रतिशाखवान् ।\nसदा पत्रः सदापुष्पः शुभाशुभफलोदयः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208499, "chapter_id": 5454, "verse_number": "१४", "content_sanskrit": "आजीव्यः सर्वभूतानां ब्रह्मवृक्षः सनातनः ।\nएनं छित्त्वा च भित्वा च तत्त्वज्ञानासिना बुधः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208500, "chapter_id": 5454, "verse_number": "१५", "content_sanskrit": "हित्वा सङ्गमयान् पाशान् मृत्युजन्मजरोदयान् ।\nनिर्ममो निरहङ्कारो मुच्यते नात्र संशयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208501, "chapter_id": 5454, "verse_number": "१६", "content_sanskrit": "द्वावेतौ पक्षिणौ नित्यौ सङ्क्षेपौ चाप्यचेतनौ ।\nएताभ्यां तु परो योऽन्यः चेतनावान् स उच्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208502, "chapter_id": 5454, "verse_number": "१७", "content_sanskrit": "अचेतनः सत्वसङ्घातयुक्तः\nसत्त्वात् परं चेतयतेऽन्तरात्मा ।\nस क्षेत्रज्ञः सत्वसङ्घातबुद्धिः\nगुणातिगो मुच्यते मृत्युपाशात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208503, "chapter_id": 5454, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु ब्रह्मवृक्षवर्णनं नाम अष्टचत्वारिंशोऽध्यायः ॥४८॥\nअनुगीतापर्वणि त्रयस्त्रिंशोऽध्यायः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]