[{"id": 7003680000, "chapter_id": 23680, "verse_number": "१-३-१-१", "content_sanskrit": "श्रीगणेशाय नमः ।\nअथ श्रीमदरुणाचलमाहात्म्यपूर्वार्धः प्रारभ्यते ।\nललाटे त्रैपुंड्री निटिलकृतकस्तूरितिलकः स्फुरन्मालाधारः स्फुरितकटिकौपीनवसनः ।\nदधानो दुस्तारं शिरसि फणिराजं शशिकलां प्रदीपः सर्वेषामरुणगिरियोगीविजयते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003680001, "chapter_id": 23680, "verse_number": "१-३-१-२", "content_sanskrit": "व्यास उवाच ।\nअथाहुर्मुनयः सूतं नैमिषारण्यवासिनः ।\nअरुणाचलमाहात्म्यं त्वत्तः शुश्रूषवो वयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003680002, "chapter_id": 23680, "verse_number": "१-३-१-३", "content_sanskrit": "तन्माहात्म्यं वदेत्युक्तः सूतः प्रोवाच तान्मुनीन् ।\nश्रीसूत उवाच ।\nएतदर्थं चतुर्वक्त्रं पप्रच्छ सनकः पुरा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003680003, "chapter_id": 23680, "verse_number": "१-३-१-४", "content_sanskrit": "शृणुतावहिता यूयं तद्वो वक्ष्यामि सांप्रतम् ।\nयदाकर्णयतां भक्त्या नराणां पापनाशनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003680004, "chapter_id": 23680, "verse_number": "१-३-१-५", "content_sanskrit": "सत्यलोके स्थितं पूर्वं ब्रह्माणं कमलासनम् ।\nसनकः परिपप्रच्छ प्रणतः प्रांजलिः स्थितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003680005, "chapter_id": 23680, "verse_number": "१-३-१-६", "content_sanskrit": "सनक उवाच ।\nभुवनाधार देवेश वेदवेद्य चतुर्मुख ।\nआसीदशेषविज्ञानं प्रसादाद्भवतो मम ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003680006, "chapter_id": 23680, "verse_number": "१-३-१-७", "content_sanskrit": "भवद्भक्तिविभूत्या मे शोधिते चित्तदर्पणे ।\nबिंबते सकलं ज्ञानं सकृदेवोपदेशतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003680007, "chapter_id": 23680, "verse_number": "१-३-१-८", "content_sanskrit": "सारार्थं वेदवेदानां शिवज्ञानमनाकुलम् ।\nलब्धवानहमत्यंतं कटाक्षैस्ते जगद्गुरोः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003680008, "chapter_id": 23680, "verse_number": "१-३-१-९", "content_sanskrit": "लिंगानि भुवि शैवानि दिव्यानि च कृपानिधे ।\nमानुषाणि च सैद्धानि भौतानि सुरनायक ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003680009, "chapter_id": 23680, "verse_number": "१-३-१-१०", "content_sanskrit": "नामस्मरणमात्रेण यत्पातकविनाशनम् ।\nशिवसारूप्यदं नित्यं मह्यं वद दयानिधे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003680010, "chapter_id": 23680, "verse_number": "१-३-१-११", "content_sanskrit": "अनादिजगदाधारं यत्तेजः शैवमव्ययम् ।\nयच्च दृष्ट्वा कृतार्थः स्यात्तन्मह्यमुपदिश्यताम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003680011, "chapter_id": 23680, "verse_number": "१-३-१-१२", "content_sanskrit": "इति भक्तिमतस्तस्य कौतूहलसमन्वितम् ।\nवाक्यमाकर्ण्य भगवान्प्रससाद तपोनिधिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003680012, "chapter_id": 23680, "verse_number": "१-३-१-१३", "content_sanskrit": "दध्यौ च सुचिरं शंभुं पंकजासनसंस्थितः ।\nअंतरंगसुखांभोधिमग्नचेताश्चतुर्मुखः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003680013, "chapter_id": 23680, "verse_number": "१-३-१-१४", "content_sanskrit": "दृष्ट्वा यदा पुरा दृष्टं तेजःस्तंभमयं शिवम् ।\nउत्तीर्णसकलाधारं न किंचित्प्रत्यबुध्यत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003680014, "chapter_id": 23680, "verse_number": "१-३-१-१५", "content_sanskrit": "पुनराज्ञां शिवाल्लब्धामनुपालयितुं प्रभुः ।\nनिर्वर्त्त्य हृदयं योगात्सस्मार सुतमानतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003680015, "chapter_id": 23680, "verse_number": "१-३-१-१६", "content_sanskrit": "शिवदर्शनसंजातपुलकांकितविग्रहः ।\nआनंदवाष्पवन्नेत्रः सगद्गदमभाषत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003680016, "chapter_id": 23680, "verse_number": "१-३-१-१७", "content_sanskrit": "ब्रह्मोवाच ।\nअतः संस्मारितः पुत्र भवताऽहं पुरातनम् ।\nशिवयोगमनुध्यायन्नस्मार्षं तव चादरात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003680017, "chapter_id": 23680, "verse_number": "१-३-१-१८", "content_sanskrit": "शिवभक्तिः परा जाता तपोभिर्बहुभिस्तव ।\nतया मदीयं हृदयं व्यावर्त्तितमिव क्षणात् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003680018, "chapter_id": 23680, "verse_number": "१-३-१-१९", "content_sanskrit": "पावयंति जगत्सर्वं चरितैस्ते निराकुले ।\nयेषां सदाशिवे भक्तिर्वर्द्धते सार्वकालिकी ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003680019, "chapter_id": 23680, "verse_number": "१-३-१-२०", "content_sanskrit": "संभाषणं सहावासः क्रीडा चैव विमिश्रणम् ।\nदर्शनं शिवभक्तानां स्मरणं चाघनाशनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003680020, "chapter_id": 23680, "verse_number": "१-३-१-२१", "content_sanskrit": "श्रूयतामद्भुतं शैवमाविर्भूतं यथा पुरा ।\nअव्याजकरुणापूर्णमरुणाद्र्यभिधं महः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003680021, "chapter_id": 23680, "verse_number": "१-३-१-२२", "content_sanskrit": "अहं नारायणश्चोभौ जातौ विश्वाधिकोदयात् ।\nबहु स्यामिति संकल्पं वितन्वानात्सदाशिवात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003680022, "chapter_id": 23680, "verse_number": "१-३-१-२३", "content_sanskrit": "स्वभावेन समुद्भूतौ विवदंतौ परस्परम् ।\nन च श्रांतौ नियुध्यंतौ साहंकारौ कदाचन ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003680023, "chapter_id": 23680, "verse_number": "१-३-१-२४", "content_sanskrit": "परस्परं रणोत्साहमावयोरतिभीषणम् ।\nआलोक्य करुणामूर्तिरचिंतयदथेश्वरः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003680024, "chapter_id": 23680, "verse_number": "१-३-१-२५", "content_sanskrit": "किमर्थमनयोर्युद्धं जायते लोकनाशनम् ।\nमया सृष्टमहं पातेति विवादमधितस्थुषोः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003680025, "chapter_id": 23680, "verse_number": "१-३-१-२६", "content_sanskrit": "समयेऽस्मिन्स्वयं लक्ष्यो मुग्धयोरनयोर्भृशम् ।\nयदि युद्धं न रोत्स्यामि तदा स्याद्भुवनक्षयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003680026, "chapter_id": 23680, "verse_number": "१-३-१-२७", "content_sanskrit": "वेदेषु मम माहात्म्यं विश्वाधिकतया श्रुतम् ।\nन जानाते इमौ मुग्धौ क्रोधतो गलितस्मृती ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003680027, "chapter_id": 23680, "verse_number": "१-३-१-२८", "content_sanskrit": "सर्वोपि जंतुरात्मानमधिकं मन्यते भृशम् ।\nअमतान्यसमाधिक्यस्त्वधः पतति दुर्मतिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003680028, "chapter_id": 23680, "verse_number": "१-३-१-२९", "content_sanskrit": "यद्यहं क्वापि भुवने दास्यामि मितिमात्मनः ।\nतदा तद्रूपविज्ञानात्स आत्मा सोपि मामियात् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003680029, "chapter_id": 23680, "verse_number": "१-३-१-३०", "content_sanskrit": "इति निश्चित्य मनसा स्वयमेव सदाशिवः ।\nआवयोर्युध्यतोर्मध्ये वह्निस्तंभः समुद्यतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003680030, "chapter_id": 23680, "verse_number": "१-३-१-३१", "content_sanskrit": "अतीत्य सकलांल्लोकान्सर्वतोऽग्निरिव ज्वलन् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003680031, "chapter_id": 23680, "verse_number": "१-३-१-३२", "content_sanskrit": "अनाद्यंततया चाथ दृगार्तौ संव्यतिष्ठताम् ।\nतेजःस्तंभं ज्वलंतं तमालोक्य शिथिलाशयौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003680032, "chapter_id": 23680, "verse_number": "१-३-१-३३", "content_sanskrit": "आवयोः पुरतो जाता वाणी चाप्यशरीरिणी ।\nकिमर्थं बालकौ युद्धं कल्प्यते मूढमानसौ ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003680033, "chapter_id": 23680, "verse_number": "१-३-१-३४", "content_sanskrit": "युवयोर्बलवैषम्यं शिव एव विवेक्ष्यते ।\nतेजःस्तभमयं रूपमिदं शंभोर्व्यवस्थितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003680034, "chapter_id": 23680, "verse_number": "१-३-१-३५", "content_sanskrit": "आद्यंतयोर्यदि युवामीक्षिषाथां बलाधिकौ ।\nइति तां गिरमाकर्ण्य नियुद्धाद्विरतौ तदा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003680035, "chapter_id": 23680, "verse_number": "१-३-१-३६", "content_sanskrit": "अहं विष्णुश्च गतिमान्विचेतुं तद्व्यवस्थितौ ।\nअग्निस्तंभमयं रूपं शंभोराद्यंतवर्जितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003680036, "chapter_id": 23680, "verse_number": "१-३-१-३७", "content_sanskrit": "आलोकितुं व्यवसितावावामाद्यंतभागतः ।\nबिंबितं व्योमगं चंद्रं यथा बालौ जिघृक्षतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003680037, "chapter_id": 23680, "verse_number": "१-३-१-३८", "content_sanskrit": "तथैवावां समुद्युक्तौ परिच्छेत्तुं च तन्महः ।\nअथ विष्णुर्महोत्साहात्क्रोडोऽभूत्सुमहावपुः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003680038, "chapter_id": 23680, "verse_number": "१-३-१-३९", "content_sanskrit": "तन्मूलविचयाऽयाच्च भूमिगर्भं व्यदारयत् ।\nअहं च हंसतां प्राप्तो महावेगं समुत्पतन् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003680039, "chapter_id": 23680, "verse_number": "१-३-१-४०", "content_sanskrit": "दिदृक्षुस्तच्छिरोभागं वियदूर्ध्वमगाहिषम् ।\nअधोधोदारयन्क्षोणिमशेषामपि माधवः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003680040, "chapter_id": 23680, "verse_number": "१-३-१-४१", "content_sanskrit": "आविर्भूतमिवाधस्तादग्निस्तंभमवैक्षत ।\nअनेककोटिवर्षाणि विचिन्वन्नपि तेजसः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003680041, "chapter_id": 23680, "verse_number": "१-३-१-४२", "content_sanskrit": "अपश्यन्नादिमक्षय्यमार्तरूपः स विह्वलः ।\nविशीर्णदंष्ट्रबलयो विगलत्संधिबंधनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003680042, "chapter_id": 23680, "verse_number": "१-३-१-४३", "content_sanskrit": "श्रमातुरस्तृषाक्रांतो नो यातुमशकद्धरिः ।\nवाराहं रूपमतुलं संधारयितुमक्षमः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003680043, "chapter_id": 23680, "verse_number": "१-३-१-४४", "content_sanskrit": "विहंतुमपि विश्रांतो विषसाद रमापतिः ।\nअचिंतयदमेयात्मा परिश्रांतशरीरवान् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003680044, "chapter_id": 23680, "verse_number": "१-३-१-४५", "content_sanskrit": "गलितश्रीः क्रियाश्रांतः शरण्यं शिवमाश्रयन् ।\nधिङ्ममेदं महन्मौग्ध्यमहंकारसमुद्भवम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003680045, "chapter_id": 23680, "verse_number": "१-३-१-४६", "content_sanskrit": "येनाहमात्मनो नाथमात्मानं नावबुद्धवान् ।\nअयं हि सर्ववेदानां देवानां जगतामपि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003680046, "chapter_id": 23680, "verse_number": "१-३-१-४७", "content_sanskrit": "मूलभूतः शिवः साक्षान्मूलमस्य कथं भवेत् ।\nअस्मादेव समुद्भूतोऽस्म्यहमाद्यंतवर्जितात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003680047, "chapter_id": 23680, "verse_number": "१-३-१-४८", "content_sanskrit": "यन्मयान्वेष्टुमारब्धं शिवं पशुवपुर्धृता ।\nअव्याजकरुणाबन्धोः पितुः शंभोः प्रसादतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003680048, "chapter_id": 23680, "verse_number": "१-३-१-४९", "content_sanskrit": "पुनरेवेदृशी लब्धा मतिर्मे स्वात्मबोधिना ।\nस्वयमेव महादेवः शंभुर्यं पातुमिच्छति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003680049, "chapter_id": 23680, "verse_number": "१-३-१-५०", "content_sanskrit": "तस्य सद्यो भवेज्ज्ञानमनहंकारमात्मजम् ।\nन शक्नोमि पुनः कर्तुं पूजामस्य जगद्गुरोः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003680050, "chapter_id": 23680, "verse_number": "१-३-१-५१", "content_sanskrit": "निवेदयामि चात्मानं शरणं यामि शंकरम् ।\nइति दध्यौ शिवं विष्णुः स्तुत्यामर्पितचेतनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003680051, "chapter_id": 23680, "verse_number": "१-३-१-५२", "content_sanskrit": "सत्प्रसादाद्भूतपतेः पुनरेवोद्धुतः क्षितौ ।\nअहं च गगनेऽभ्राम्यमनेकानपि वत्सरान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003680052, "chapter_id": 23680, "verse_number": "१-३-१-५३", "content_sanskrit": "आघूर्णमाननयनः श्लथपक्षः श्रमं गतः॥  ।\nउपर्युपरि चापश्यं ज्वलनं पुरतः स्थितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003680053, "chapter_id": 23680, "verse_number": "१-३-१-५४", "content_sanskrit": "तेजःस्तम्भं स्थूललिंगाभं शैवं तेजः सुरार्चितम् ।\nआहुः स्म केचिदालोक्य सिद्धास्तेजोंशसंभवाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003680054, "chapter_id": 23680, "verse_number": "१-३-१-५५", "content_sanskrit": "नित्यां शंभोः परां कोटिं दिदृक्षुं मां कृतोद्यमम् ।\nअहोऽयं सत्यमुग्धत्वमद्यापि च चिकीर्षति ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003680055, "chapter_id": 23680, "verse_number": "१-३-१-५६", "content_sanskrit": "आसन्नदेहपातोऽपि नाहंकारोऽस्य वै गतः ।\nविशीर्यमाणपक्षोऽयं श्रांत्वा विभ्रांतलोचनः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003680056, "chapter_id": 23680, "verse_number": "१-३-१-५७", "content_sanskrit": "अपारतेजसि व्यर्थो विमोहोऽयं भविष्यति ।\nएवं व्याकुलचित्तोऽयं क्रोडरूपी जनार्दनः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003680057, "chapter_id": 23680, "verse_number": "१-३-१-५८", "content_sanskrit": "व्यावर्त्तितः शिवेनैव निर्व्याजकरुणाजुषा ।\nईदृशां ब्रह्ममुख्यानां सुराणां कोटिसंभवः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003680058, "chapter_id": 23680, "verse_number": "१-३-१-५९", "content_sanskrit": "यत्तेजःपरमाणुभ्यस्तस्य पारं दिदृक्षते ।\nस्वात्मनो यो गतो ध्यात्वा समये भगवाञ्छिवः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003680059, "chapter_id": 23680, "verse_number": "१-३-१-६०", "content_sanskrit": "यदि बुद्धिं ददात्यस्मै तस्य नश्येदहंक्रिया ।\nइत्येवं वदतां तेषां सिद्धानां सदयं वचः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003680060, "chapter_id": 23680, "verse_number": "१-३-१-६१", "content_sanskrit": "आकर्ण्य शीर्णाहंकारो ह्यहमात्मन्यचिंतयम् ।\nन वेदराशिविज्ञानात्तपस्तीर्थनिषेवणात् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003680061, "chapter_id": 23680, "verse_number": "१-३-१-६२", "content_sanskrit": "संजायते शिवज्ञानमस्यैवानुग्रहादृते ।\nशीर्णेऽपि पक्षयुगले सीदत्यंगे ह्यचंचले ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003680062, "chapter_id": 23680, "verse_number": "१-३-१-६३", "content_sanskrit": "पुनरुत्सहते चेतः स्वाहंकारस्य संग्रहे ।\nधिङ्मामहं क्रियाक्रांतमनात्मबलवेदिनम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003680063, "chapter_id": 23680, "verse_number": "१-३-१-६४", "content_sanskrit": "शिवार्पितमनस्केभ्यः सिद्धेभ्यः सततं नमः ।\nयेषां संसर्गलब्धेन तपसा शोधिताशयः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003680064, "chapter_id": 23680, "verse_number": "१-३-१-६५", "content_sanskrit": "शिवमेनं विजानामि स्वात्महेतुं पुरःस्थितम् ।\nयत्प्रसादोपलब्धेन विभवेन समन्विताः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003680065, "chapter_id": 23680, "verse_number": "१-३-१-६६", "content_sanskrit": "देवाः सर्वे भविष्यंति सततं शमितारयः ।\nयस्य वेदा न जानंति परमार्थं महागमैः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003680066, "chapter_id": 23680, "verse_number": "१-३-१-६७", "content_sanskrit": "तमेव शरणं यामि शंभुं विश्वविलक्षणम् ।\nअवादिषमथाभाष्यं विष्णुं कमललोचनम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003680067, "chapter_id": 23680, "verse_number": "१-३-१-६८", "content_sanskrit": "लब्धदेहः शिवं भक्त्या संश्रितश्चन्द्रशेखरम् ।\nअहो किमिदमाश्चर्यमागतं शौर्यशालिनाम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003680068, "chapter_id": 23680, "verse_number": "१-३-१-६९", "content_sanskrit": "शंभुना यत्समुद्भूतमहंकारमुपाश्रितौ ।\nआवां परस्परं युद्धमाकर्ण्य विपुलं महत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003680069, "chapter_id": 23680, "verse_number": "१-३-१-७०", "content_sanskrit": "स एव शंकरः सर्वमहंकारमथावयोः ।\nअपाहरदमेयात्मा स्वमाहात्म्यप्रकाशनात् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003680070, "chapter_id": 23680, "verse_number": "१-३-१-७१", "content_sanskrit": "इममीश्वरमानतं सुरैरनलस्तम्भमयं सदाशिवम् ।\nअभिपूजयितुं प्रवर्तते स भवेद्वै भवसागरस्य नौः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003680071, "chapter_id": 23680, "verse_number": "१-३-१-७२", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां प्रथमे माहेश्वरखण्डेऽरुणाचलमाहात्म्ये पूर्वार्धे ब्रह्मसनकसंवादे लिंगप्रादुर्भाववर्णनंनाम प्रथमोऽध्यायः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]