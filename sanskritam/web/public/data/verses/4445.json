[{"id": 2158973, "chapter_id": 4445, "verse_number": "", "content_sanskrit": "स्थाणुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2158974, "chapter_id": 4445, "verse_number": "१", "content_sanskrit": "प्रजासर्गनिमित्तत्वात् कृतो यत्नस्त्वया प्रभो ।\nत्वया विसृष्टा वृद्धास्तु भूतग्रामाः पृथग्विधाः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2158975, "chapter_id": 4445, "verse_number": "२", "content_sanskrit": "तास्तथैवेह पुनः क्रोधात् प्रजा नश्यन्ति सर्वशः ।\nता दृष्ट्वा मम कारुण्यं प्रसीद भगवन् प्रभो\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2158976, "chapter_id": 4445, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2158977, "chapter_id": 4445, "verse_number": "३", "content_sanskrit": "न क्रुद्ध्ये न च मे काम एतदेवं भवेदिति ।\nपृथिव्या हितकामात् तु ततो मां मृत्युराविशत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2158978, "chapter_id": 4445, "verse_number": "४", "content_sanskrit": "इयं सन्ना सदा देवी भारार्ता मामचूचुदत् ।\nसंहारार्थं महादेव भारेणाभिहता सती\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2158979, "chapter_id": 4445, "verse_number": "५", "content_sanskrit": "ततो वै नाधिगच्छामि बुद्ध्या बहु विचारयन् ।\nसंहारमप्रमेयात्मन् ततो मां मन्युराविशत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2158980, "chapter_id": 4445, "verse_number": "", "content_sanskrit": "स्थाणुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2158981, "chapter_id": 4445, "verse_number": "६", "content_sanskrit": "संहारार्थं प्रसीदस्व मा क्रुधो विबुधाधिप ।\nमा प्रजाः स्थावराश्चैव जङ्गमाश्च व्यनीनशः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2158982, "chapter_id": 4445, "verse_number": "७", "content_sanskrit": "तव प्रसादाद् भगवन्निदं जातं त्रिधा जगत् ।\nअनागतमतीतं च यच्च सम्प्रति वर्तते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2158983, "chapter_id": 4445, "verse_number": "८", "content_sanskrit": "भगवन् क्रोधसन्दीप्तः क्रोधादग्निः समुत्थितः ।\nस दहत्यश्मकूटानि द्रुमांश्च सरितस्तथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2158984, "chapter_id": 4445, "verse_number": "९", "content_sanskrit": "पल्वलानि च सर्वाणि सर्वं चैव तृणोपलम् ।\nस्थावरं जङ्गमं चैव निःशेषं कुरुते जगत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2158985, "chapter_id": 4445, "verse_number": "१०", "content_sanskrit": "तदेतद् भस्मसाद्भूतं सर्वं जगदनाविलम् ।\nप्रसीद भगवन् देव रोषो न स्याद् वरो मम\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2158986, "chapter_id": 4445, "verse_number": "११", "content_sanskrit": "सर्वे विनष्टास्तप्यन्ते सर्वे देवाः कथञ्चन ।\nतस्मान्निवर्ततां तेजस्त्वयि वैतत् प्रलीयताम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2158987, "chapter_id": 4445, "verse_number": "१२", "content_sanskrit": "उपायमन्यं सम्पश्य प्रजानां हितकाम्यया ।\nयथेमे प्राणिनः सर्वे निवर्तेरंस्तथा कुरु\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2158988, "chapter_id": 4445, "verse_number": "१३", "content_sanskrit": "अभावं नैव गच्छेयुरुत्पन्नप्रजनाः प्रजाः ।\nभवता हि नियुक्तोऽहं प्रजानां पालने प्रभो\nदया तेन ममोत्पन्ना प्रजासु विबुधेश्वर\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2158989, "chapter_id": 4445, "verse_number": "१४", "content_sanskrit": "मा विनश्येद् जगन्नाथ जगत् स्थावरजङ्गमम् ।\nप्रपद्ये हि गुरुं देवं तस्मादेतद् ब्रवीम्यहम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2158990, "chapter_id": 4445, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2158991, "chapter_id": 4445, "verse_number": "१५", "content_sanskrit": "श्रुत्वा तु वचनं स्थाणोर्नित्यं निहतपाप्मनः ।\nतेजः संवेष्टयामास पुनरेवान्तरात्मनि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2158992, "chapter_id": 4445, "verse_number": "१६", "content_sanskrit": "ततोऽग्निमुपसंहृत्य भगवाँल्लोकसत्कृतः ।\nप्रवृत्तिं च निवृत्तिं च कल्पयामास वै प्रभुः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2158993, "chapter_id": 4445, "verse_number": "१७", "content_sanskrit": "उपसंहृतवान् ब्रह्मा तमग्निं रोषजं तथा ।\nप्रादुर्बभूव विश्वेभ्यः खेभ्यो नारी महामनाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2158994, "chapter_id": 4445, "verse_number": "१८", "content_sanskrit": "कृष्णरक्ताम्बरधरा रक्तजिह्वास्यलोचना ।\nकुण्डलाभ्यां च राजेन्द्र तप्ताभ्यां समलङ्कृता\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2158995, "chapter_id": 4445, "verse_number": "१९", "content_sanskrit": "सा विनिर्गत्य वै खेभ्यो दक्षिणां दिशमाश्रयत् ।\nस्मयमानेव चावैक्षद् देवौ विश्वेश्वरावुभौ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2158996, "chapter_id": 4445, "verse_number": "२०", "content_sanskrit": "तामाह्वयत् तदाऽचिन्त्यो लोकादिनिधनेश्वरः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2158997, "chapter_id": 4445, "verse_number": "२१", "content_sanskrit": "तां तु तत्र तदा देवीं ब्रह्मा लोकपितामहः\nउक्तवान् मधुरं वाक्यं सान्त्वयित्वा पुनःपुनः\nमृत्यो इति महीपाल जहि चेमाः प्रजा इति\t॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2158998, "chapter_id": 4445, "verse_number": "२२", "content_sanskrit": "प्रादुर्भूता मया रोषात् त्वं हि संहारबुद्धिना ।\nतस्मात् संहर सर्वास्त्वं प्रजाः सजडपण्डिताः\t॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2158999, "chapter_id": 4445, "verse_number": "२३", "content_sanskrit": "अविशेषेण चैव त्वं प्रजाः संहर भामिनि ।\nमम त्वं हि नियोगेन तत्र श्रेयो ह्यवाप्स्यसि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2159000, "chapter_id": 4445, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2159001, "chapter_id": 4445, "verse_number": "२४", "content_sanskrit": "एवमुक्ता तु सा तेन मृत्युः कमललोचना ।\nदध्यौ चात्यर्थमबला प्रापतंश्चाश्रुबिन्दवः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2159002, "chapter_id": 4445, "verse_number": "२५", "content_sanskrit": "पाणिभ्यां प्रतिजग्राह तान्यश्रूणि पितामहः ।\nसर्वभूतहितार्थाय तां चाप्यन्वनयद् भृशम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2159003, "chapter_id": 4445, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां द्रोणपर्वणि पञ्चाशोऽध्यायः ॥ ५० ॥\nअभिमन्युवधपर्वणि एकोनविंशोऽध्यायः ॥ १९ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]