[{"id": 900001182, "chapter_id": 8227, "verse_number": "1.1", "content_sanskrit": "एष पन्था एतत्कर्म एतद्ब्रह्मैतत्सत्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001183, "chapter_id": 8227, "verse_number": "1.2", "content_sanskrit": "एष इमं लोकमभ्यार्चत् पुरुषरूपेण य एष तपति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001184, "chapter_id": 8227, "verse_number": "1.3", "content_sanskrit": "ॐ यो ह वा आत्मानं पञ्चविधमुक्थं वेद यस्माद्धीदं सर्वमुत्तिष्ठति स सम्प्रतिवित्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001185, "chapter_id": 8227, "verse_number": "1.4", "content_sanskrit": "ॐ आत्मा वा इदमेक एवाग्र आसीत् नान्यत् किञ्चन मिषत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001186, "chapter_id": 8227, "verse_number": "1.5", "content_sanskrit": "ॐ पुरुषे ह वा अयमादितो गर्भो भवति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001187, "chapter_id": 8227, "verse_number": "1.6", "content_sanskrit": "ॐ कोऽयमात्मेति वयमुपास्महे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001188, "chapter_id": 8227, "verse_number": "1.7", "content_sanskrit": "ॐ वाङ्मे मनसि प्रतिष्ठिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]