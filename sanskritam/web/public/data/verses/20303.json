[{"id": 7000303000, "chapter_id": 20303, "verse_number": "१-५७-१", "content_sanskrit": "द्विजा ऊचुः ।\nकीर्तिर्धर्मोथ लोकेषु सर्वाणि प्रवराणि च ।\nवद नो मुनिशार्दूल यदि नोऽस्ति त्वनुग्रहः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000303001, "chapter_id": 20303, "verse_number": "१-५७-२", "content_sanskrit": "व्यास उवाच ।\nयस्य खाते वने गावस्तृप्यंति मासमेव च ।\nयद्वा सप्तदिनात्पूतः सर्वदेवैः स पूजितः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000303002, "chapter_id": 20303, "verse_number": "१-५७-३", "content_sanskrit": "पुष्करिण्या विशेषेण पूता या यज्ञकर्मणा ।\nयत्फलं जलदानेन सर्वमत्रास्यि तच्छृणु॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000303003, "chapter_id": 20303, "verse_number": "१-५७-४", "content_sanskrit": "हायने हायने चैव कल्पं कल्पं विधीयते ।\nदानात्स्वर्गमवाप्नोति तोयदः सर्वदो भुवि॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000303004, "chapter_id": 20303, "verse_number": "१-५७-५", "content_sanskrit": "मेघे वर्षति खाते च जायंते ये तु शीकराः ।\nतावद्वर्षसहस्राणि दिवमश्नाति मानवः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000303005, "chapter_id": 20303, "verse_number": "१-५७-६", "content_sanskrit": "तोयैरन्नादिपाकैश्च प्रसन्नो मानवो भवेत् ।\nप्राणानां च विनान्नैश्च धारणन्नैव जायते॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000303006, "chapter_id": 20303, "verse_number": "१-५७-७", "content_sanskrit": "पितॄणां तर्पणं शौचं रूपं वै गंध्यनाशनम् ।\nबीजं त्विहार्जितं सर्वं सर्वं तोये प्रतिष्ठितम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000303007, "chapter_id": 20303, "verse_number": "१-५७-८", "content_sanskrit": "वस्त्रस्य धावनं रुच्यं भाजनानां तथैव च ।\nतेनैव सर्वकार्यं च पानीयं मेध्यमेव च॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000303008, "chapter_id": 20303, "verse_number": "१-५७-९", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन वापीकूपतटाककम् ।\nकारयेच्च बलैः सर्वैस्तथा सर्वधनेन च॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000303009, "chapter_id": 20303, "verse_number": "१-५७-१०", "content_sanskrit": "ततो विनिर्जले देशो यो ददाति जलाशयम् ।\nवासरे वासरे तस्य कल्पं स्वर्गं विनिर्दिशेत्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000303010, "chapter_id": 20303, "verse_number": "१-५७-११", "content_sanskrit": "त्रिविष्टपाच्च्युतो विप्रो वेदशास्त्रार्थपारगः ।\nलोकबंधुः स धर्मात्मा तपस्तप्त्वा दिवं व्रजेत्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000303011, "chapter_id": 20303, "verse_number": "१-५७-१२", "content_sanskrit": "एवं जन्माष्टकं प्राप्य एकस्याक्षयमिष्यते ।\nक्षत्त्रियाणां कुले जातः सार्वभौमो भवेन्नृपः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000303012, "chapter_id": 20303, "verse_number": "१-५७-१३", "content_sanskrit": "विशोऽक्षयं धनं विद्याज्जन्मजन्मसु यत्प्रियम् ।\nशूद्रादयोन्त्यजाश्चान्ये लभंते स्वर्गतिं मुहुः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000303013, "chapter_id": 20303, "verse_number": "१-५७-१४", "content_sanskrit": "चतुर्हस्तप्रमाणं तु कूपं खनति यः पुमान् ।\nपरोपकारकं नित्यं कल्पं स्वर्गं तु हायने॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000303014, "chapter_id": 20303, "verse_number": "१-५७-१५", "content_sanskrit": "द्विगुणे द्विगुणं विद्याच्छतं चैव चतुर्गुणे ।\nविंशत्किष्कुप्रमाणां तु दद्यात्पुष्करिणीं तु यः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000303015, "chapter_id": 20303, "verse_number": "१-५७-१६", "content_sanskrit": "विष्णोर्धाम लभेत्सोपि दिव्यभोगं तथैव च ।\nअनंतरं नृपो जातो धनी वागीश्वरो भवेत्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000303016, "chapter_id": 20303, "verse_number": "१-५७-१७", "content_sanskrit": "एवं द्विस्त्रिश्चतुर्वापि गुणतो भोग्यमिष्यते ।\nविस्तीर्णे प्रचुरं विद्धि सहस्रेणाच्युतो दिवः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000303017, "chapter_id": 20303, "verse_number": "१-५७-१८", "content_sanskrit": "सहस्राद्द्विगुणेनैव सुरपूज्यो भवेन्नरः ।\nजंतवस्तत्र ये संति यावंतो जीवनं ययुः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000303018, "chapter_id": 20303, "verse_number": "१-५७-१९", "content_sanskrit": "तत्संख्याका जनास्तस्य किंकराः पृष्टलग्नकाः ।\nभवंति सततं गेहे पुरे जनपदेषु च॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000303019, "chapter_id": 20303, "verse_number": "१-५७-२०", "content_sanskrit": "विहाय पितरं भोग्या धने क्षीणे यथा वनम् ।\nपक्षिणस्सूकरश्चैव महिषी करिणी तथा॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000303020, "chapter_id": 20303, "verse_number": "१-५७-२१", "content_sanskrit": "उपदेष्टा च कर्त्ता च षडेते स्वर्गगामिनः ।\nदिव्यं च पक्षिणां चैव शतं स्वर्गं विनिर्दिशेत्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000303021, "chapter_id": 20303, "verse_number": "१-५७-२२", "content_sanskrit": "क्रोडो वर्षसहस्रं तु महिष्ययुतहायनम् ।\nदेवरूपं समास्थाय करिण्या लक्षमुच्यते॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000303022, "chapter_id": 20303, "verse_number": "१-५७-२३", "content_sanskrit": "कोट्येकमुपदेष्टुश्च कर्तुरक्षयमेव च ।\nपुरा धनिसुतेनैव कृतः ख्यातो जलाशयः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000303023, "chapter_id": 20303, "verse_number": "१-५७-२४", "content_sanskrit": "अयुतधनव्ययेनैव प्राणेनैव बलेन च ।\nसर्वसत्वोपकाराय शिवश्रद्धायुतेन च॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000303024, "chapter_id": 20303, "verse_number": "१-५७-२५", "content_sanskrit": "कालेन कियता चापि क्षीणवित्तोऽभवत्किल ।\nकश्चिदर्थी धनी तस्य मूल्यदानाय चोद्यतः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000303025, "chapter_id": 20303, "verse_number": "१-५७-२६", "content_sanskrit": "विमृश्य धनिना चोक्तं व्याहारं शृणुताधुना ।\nदीनारस्यायुतं वा ते दास्याम्यस्याश्च कारणात्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000303026, "chapter_id": 20303, "verse_number": "१-५७-२७", "content_sanskrit": "लब्धं ते पुष्करिण्याश्च पुण्यं लाभात्प्रमन्यसे ।\nशक्त्या दत्वाथ मूल्यं तां स्वीयां कर्तुं व्यवस्थितः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000303027, "chapter_id": 20303, "verse_number": "१-५७-२८", "content_sanskrit": "एवमुक्ते स तं प्राह वासरेप्ययुतं पुनः ।\nफलं भवति वै नित्यं पुण्यं पुण्यविदो विदुः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000303028, "chapter_id": 20303, "verse_number": "१-५७-२९", "content_sanskrit": "एतस्मिन्निर्जले देशे शिवं खातं कृतं च मे ।\nस्नानपानादिकं कर्म सर्वे कुर्वंत्यभीष्टतः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000303029, "chapter_id": 20303, "verse_number": "१-५७-३०", "content_sanskrit": "तस्मान्मेप्ययुतार्थस्य नैत्यकं फलमिष्यते ।\nततस्तस्याभवद्धास्यं तथैव च सभासदाम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000303030, "chapter_id": 20303, "verse_number": "१-५७-३१", "content_sanskrit": "ह्रिया च पीडितः सोपि वाक्यमेतदुवाच ह ।\nसत्यमेतद्वचोस्माकं परीक्षां कुरु धर्मतः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000303031, "chapter_id": 20303, "verse_number": "१-५७-३२", "content_sanskrit": "मत्सरात्स तु तं प्राह शृणु मे वचनं पितः ।\nदीनारायुत मे तत्ते दत्वा चानीय प्रस्तरम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000303032, "chapter_id": 20303, "verse_number": "१-५७-३३", "content_sanskrit": "पातयिष्यामि ते खाते यथायोगं प्रमज्जतु ।\nउन्मज्जति च यत्काले प्रस्तरः संतरत्यपि॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000303033, "chapter_id": 20303, "verse_number": "१-५७-३४", "content_sanskrit": "क्षयं यास्यति नो वित्तं नोचेन्मे धर्मतो हि सा ।\nबाढमुक्त्वायुतं तस्य गृहीत्वा स्वगृहं गतः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000303034, "chapter_id": 20303, "verse_number": "१-५७-३५", "content_sanskrit": "साक्षिणामग्रतस्तेन प्रस्तरः पातितस्तथा ।\nपुष्करिण्यां महत्यां च दृष्टं नरसुरासुरैः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000303035, "chapter_id": 20303, "verse_number": "१-५७-३६", "content_sanskrit": "ततो धर्मतुलायां तु तुलितं धर्मसाक्षिणा ।\nदीनारायुतदानस्य पुष्करिण्या जलस्य तु॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000303036, "chapter_id": 20303, "verse_number": "१-५७-३७", "content_sanskrit": "न समं तु दिनैकं तु जलस्य धर्मतो भृशम् ।\nधनिनो मानसं दुःखं मोघार्थं च परेऽहनि॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000303037, "chapter_id": 20303, "verse_number": "१-५७-३८", "content_sanskrit": "शिलोच्चयोऽभवत्तीर्णो द्वीपवच्च जलोपरि ।\nततः कोलाहलः शब्दो जनानां समुपस्थितः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000303038, "chapter_id": 20303, "verse_number": "१-५७-३९", "content_sanskrit": "तच्छ्रुत्वाद्भुतवाक्यं च मुदा तौ चागतौ ततः ।\nदृष्ट्वा शैलं तथाभूतं कृतं तेनायुतं तथा॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000303039, "chapter_id": 20303, "verse_number": "१-५७-४०", "content_sanskrit": "ततः खाताधिपेनैव शैलं दूरे निपातितम् ।\nपुण्यं खातस्य चोत्खाते प्रलुप्तस्य सुतेन हि॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000303040, "chapter_id": 20303, "verse_number": "१-५७-४१", "content_sanskrit": "सोपि नाकं समारुह्य जन्मजन्मसु निर्वृतः ।\nगोत्रमातृगणानां च नृपाणां सुहृदां तथा॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000303041, "chapter_id": 20303, "verse_number": "१-५७-४२", "content_sanskrit": "सखीनां चोपकर्तॄणां खातं खात्वाऽक्षयं फलम् ।\nतपस्विनामनाथानां ब्राह्मणानां विशेषतः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000303042, "chapter_id": 20303, "verse_number": "१-५७-४३", "content_sanskrit": "खातं तु जनयित्वा तु स्वर्गं चाक्षयमश्नुते ।\nतस्मात्खातादिकं विप्राः शक्तितो यः करिष्यति॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000303043, "chapter_id": 20303, "verse_number": "१-५७-४४", "content_sanskrit": "सर्वपापक्षयात्पुण्यं मोक्षं यायान्न संशयः ।\nय इदं श्रावयेल्लोके धर्माख्यानं महोत्कटम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000303044, "chapter_id": 20303, "verse_number": "१-५७-४५", "content_sanskrit": "सर्वखातप्रदानस्य फलमश्नाति धार्मिकः ।\nग्रहणे भास्करस्यैव भागीरथ्यां तटे वरे॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000303045, "chapter_id": 20303, "verse_number": "१-५७-४६", "content_sanskrit": "गवां कोटिप्रदानस्य फलं श्रुत्वा लभेन्नरः ।\nन च दारिद्रतामेति न शोकं व्याधिसंचयम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]