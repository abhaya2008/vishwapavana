[{"id": 2066426, "chapter_id": 2402, "verse_number": "९-२०-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2066427, "chapter_id": 2402, "verse_number": "९-२०-१", "content_sanskrit": "तस्मिंस्तु निहते शूरे साल्वे समितिशोभने।\nतवाभज्यद्बलं वेगाद्वातेनेव महाद्रुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2066428, "chapter_id": 2402, "verse_number": "९-२०-२", "content_sanskrit": "तत्प्रभग्नं बलं दृष्ट्वा कृतवर्मा महारथः।\nदधार समरे शूरः शत्रुसैन्यं महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2066429, "chapter_id": 2402, "verse_number": "९-२०-३", "content_sanskrit": "सन्निवृत्तास्तु ते शूरा दृष्ट्वा सात्वतमाहवे।\nशैलोपमं स्थिरं राजन्कीर्यमाणं शरैर्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2066430, "chapter_id": 2402, "verse_number": "९-२०-४", "content_sanskrit": "ततः प्रववृते युद्धं कुरूणां पाण्डवैः सह।\nनिवृत्तानां महाराज मृत्युं कृत्वा निवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2066431, "chapter_id": 2402, "verse_number": "९-२०-५", "content_sanskrit": "तत्राश्चर्यमभूद्युद्वं सात्वतस्य परैः सह।\nयदेको वारयामास पाण्डुसेनां दुरासदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2066432, "chapter_id": 2402, "verse_number": "९-२०-६", "content_sanskrit": "तेषामन्योन्यसुहृदां कृते कर्मणि दुष्करे।\nसिंहनादः प्रहृष्टानां दिविस्पृक्सुमहानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2066433, "chapter_id": 2402, "verse_number": "९-२०-७", "content_sanskrit": "तेन शब्देन वित्रस्तान्पाञ्चालान्भरतर्षभ।\nशिनेर्नप्ता महाबाहुरन्वपद्यत सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2066434, "chapter_id": 2402, "verse_number": "९-२०-८", "content_sanskrit": "स समासाद्य राजानं क्षेमधूर्तिं महाबलम्।\nसप्तभिर्निशितैर्बाणैरनयद्यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2066435, "chapter_id": 2402, "verse_number": "९-२०-९", "content_sanskrit": "तमायान्तं महाबाहुं प्रवपन्तं शिताञ्शरान्।\nजवेनाभ्यपतद्वीमान्हार्दिक्यः शिनिपुङ्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2066436, "chapter_id": 2402, "verse_number": "९-२०-१०", "content_sanskrit": "तौ सिंहाविव नर्दन्तौ धन्विनौ रथिनां वरौ।\nअन्योन्यमभिधावन्तौ शस्त्रप्रवरधारिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2066437, "chapter_id": 2402, "verse_number": "९-२०-११", "content_sanskrit": "पाण्डवाः सहपाञ्चाला योधाश्चान्ये नृपोत्तमाः।\nप्रेक्षकाः समपद्यन्त तयोः पुरुषसिंहयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2066438, "chapter_id": 2402, "verse_number": "९-२०-१२", "content_sanskrit": "नाराचैर्वत्सदन्तैश्च वृष्ण्यन्धकमहारथौ।\nअभिजघ्नतुरन्योन्यं प्रहृष्टाविव कुञ्चरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2066439, "chapter_id": 2402, "verse_number": "९-२०-१३", "content_sanskrit": "चरन्तौ विविधान्मार्गान्हार्दिक्यशिनिपुङ्गवौ।\nमुहुरन्तर्दधाते तौ बाणवृष्ट्या परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2066440, "chapter_id": 2402, "verse_number": "९-२०-१४", "content_sanskrit": "चापवेगबलोद्वूतान्मार्गणान्वृष्णिसिंहयोः।\nआकाशे समपश्याम पतङ्गानिव शीघ्रगान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2066441, "chapter_id": 2402, "verse_number": "९-२०-१५", "content_sanskrit": "तमेकं सत्यकर्माणमासाद्य हृदिकात्मजः।\nअविध्यन्निशितैर्बाणैश्चतुर्भिश्चतुरो हयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2066442, "chapter_id": 2402, "verse_number": "९-२०-१६", "content_sanskrit": "स दीर्घबाहुः सङ्क्रुद्धस्तोत्रार्दित इव द्विपः।\nअष्टभिः कृतवर्माणमविध्यत्परमेषुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2066443, "chapter_id": 2402, "verse_number": "९-२०-१७", "content_sanskrit": "ततः पूर्णायतोत्सृष्टैः कृतवर्मा शिलाशितैः।\nसात्यकिं त्रिभिराहत्य धनुरेकेन चिच्छिदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2066444, "chapter_id": 2402, "verse_number": "९-२०-१८", "content_sanskrit": "निकृत्तं तद्धनुःश्रेष्ठमपास्य शिनिपुङ्गवः।\nअन्यदादत्त वेगेन शैनेयः सशरं धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2066445, "chapter_id": 2402, "verse_number": "९-२०-१९", "content_sanskrit": "तदादाय धनुःश्रेष्ठं वरिष्ठः सर्वधन्विनाम्।\nआरोप्य च धनुः शीघ्रं महावीर्यो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2066446, "chapter_id": 2402, "verse_number": "९-२०-२०", "content_sanskrit": "अमृष्यमाणो धनुषश्छेदनं कृतवर्मणा।\nकुपितोऽतिरथः शीघ्रं कृतवर्माणमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2066447, "chapter_id": 2402, "verse_number": "९-२०-२१", "content_sanskrit": "ततः सुनिशितैर्बाणैर्दशभिः शिनिपुङ्गवः।\nजघान सूतं चाश्वांश्च ध्वजं च कृतवर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2066448, "chapter_id": 2402, "verse_number": "९-२०-२२", "content_sanskrit": "ततो राजन्महेष्वासः कृतवर्मा महारथः।\nहताश्वसूतं सम्प्रेक्ष्य रथं हेमपरिष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2066449, "chapter_id": 2402, "verse_number": "९-२०-२३", "content_sanskrit": "रोषेण महताऽऽविष्टः शूलमुद्यम्य मारिष।\nचिक्षेप भुजवेगेन जिघांसुः शिनि पुङ्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2066450, "chapter_id": 2402, "verse_number": "९-२०-२४", "content_sanskrit": "तच्छूलं सात्वतो ह्याजौ निर्भिद्य निशितैः शरैः।\nचूर्णितं पातयामास मोहयन्निव माधवम्।\nततोऽपरेण भल्लेन हृद्येनं समताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2066451, "chapter_id": 2402, "verse_number": "९-२०-२५", "content_sanskrit": "सुयुद्वे युयुधानेन हताश्वो हतसारथिः।\nकृतवर्मा कृतास्त्रेण धरमीमन्वपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2066452, "chapter_id": 2402, "verse_number": "९-२०-२६", "content_sanskrit": "तस्मिन्सात्यकिना वीरे द्वैरथे विरथीकृते।\nसमपद्यत सर्वेषां सैन्यानां सुमहद्भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2066453, "chapter_id": 2402, "verse_number": "९-२०-२७", "content_sanskrit": "पुत्राणां तव चात्यर्थं विषादः समजायत।\nहतसूते हताश्वे तु विरथे कृतवर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2066454, "chapter_id": 2402, "verse_number": "९-२०-२८", "content_sanskrit": "हताश्वं च समालक्ष्य हतसूतमरिन्दम।\nअभ्यधावत्कृपो राजञ्जिघांसुः शिनिपुङ्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2066455, "chapter_id": 2402, "verse_number": "९-२०-२९", "content_sanskrit": "तमारोप्य रथोपस्थे मिषतां सर्वधन्विनाम्।\nअपोवाह महाबाहुं तूर्णमायोधनादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2066456, "chapter_id": 2402, "verse_number": "९-२०-३०", "content_sanskrit": "शैनेयेऽधिष्ठिते राजन्विरथे कृतवर्मणि।\nदुर्योधनबलं सर्वं पुनरासीत्पराङ्मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2066457, "chapter_id": 2402, "verse_number": "९-२०-३१", "content_sanskrit": "तत्परे नान्वबुध्यन्त सैन्येन रजसा वृताः।\nतावकाः प्रद्रुता राजन्दुर्योधनमृते नृपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2066458, "chapter_id": 2402, "verse_number": "९-२०-३२", "content_sanskrit": "दुर्योधनस्तु सम्प्रेक्ष्य भग्नं स्वबलमन्तिकात्।\nजवेनाभ्यपतत्तूर्णं सर्वांश्चैको न्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2066459, "chapter_id": 2402, "verse_number": "९-२०-३३", "content_sanskrit": "पाण्डूंश्च सर्वान्सङ्क्रुद्धो धृष्टद्युम्नं च पार्षतम्।\nशिखण्डिनं द्रौपदेयान्पाञ्चालानां च ये गणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2066460, "chapter_id": 2402, "verse_number": "९-२०-३४", "content_sanskrit": "केकयान्सोमकांश्चैव सृञ्जयांश्चैव मारिष।\nअसम्भ्रमं दुराधर्षः शितैर्बाणैरवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2066461, "chapter_id": 2402, "verse_number": "९-२०-३५", "content_sanskrit": "अतिष्ठदाहवे यत्तः पुत्रस्तव महाबलः।\nयथा यज्ञे महानग्निर्मन्त्रपूतः प्रकाशते।\nतथा दुर्योधनो राजा सङ्ग्रामे सर्वतोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2066462, "chapter_id": 2402, "verse_number": "९-२०-३६", "content_sanskrit": "तं परे नाभ्यवर्तन्त मर्त्या मृत्युमिवाहवे।\nअथान्यं रथमास्थाय हार्दिक्यः समपद्यत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2066463, "chapter_id": 2402, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वमि शल्यवधपर्वणि अष्टादशदिवसयुद्धे विंशोऽध्यायः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]