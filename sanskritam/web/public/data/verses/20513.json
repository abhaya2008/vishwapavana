[{"id": 7000513000, "chapter_id": 20513, "verse_number": "३-६०-१", "content_sanskrit": "व्यास उवाच ।\nएवं त्वाश्रमनिष्ठानां यतीनां नियतात्मनाम् ।\nभैक्ष्येण वर्तनं प्रोक्तं फलमूलैरथापि वा॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000513001, "chapter_id": 20513, "verse_number": "३-६०-२", "content_sanskrit": "एककालं चरेद्भैक्ष्यं न प्रसज्येत विस्तरम् ।\nभैक्ष्ये प्रसक्तो हि यतिर्विषयेष्वपि सज्जति॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000513002, "chapter_id": 20513, "verse_number": "३-६०-३", "content_sanskrit": "सप्तागारं चरेद्भैक्ष्यमलाभे न पुनश्चरेत् ।\nगोदोहमात्रं तिष्ठेत कालं भिक्षुरधोमुखः॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000513003, "chapter_id": 20513, "verse_number": "३-६०-४", "content_sanskrit": "भिक्षेत्युक्त्वा सकृत्तूष्णीमादद्याद्वाग्यतः शुचिः ।\nप्रक्ष्याल्य पाणी पादौ च समाचम्य यथाविधि॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000513004, "chapter_id": 20513, "verse_number": "३-६०-५", "content_sanskrit": "आदित्यं दर्शयित्वान्नं भुंजीत प्राङ्मुखो नरः ।\nहुत्वा प्राणाहुतीः पंच ग्रासानष्टौ समाहितः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000513005, "chapter_id": 20513, "verse_number": "३-६०-६", "content_sanskrit": "आचम्य देवं ब्रह्माणं ध्यायेत परमेश्वरम् ।\nआलाबुदारुपात्रे च मृण्मयं वैणवं तथा॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000513006, "chapter_id": 20513, "verse_number": "३-६०-७", "content_sanskrit": "चत्वारि यतिपात्राणि मनुराह प्रजापतिः ।\nप्राग्रात्रे मध्यरात्रे च पररात्रे तथैव च॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000513007, "chapter_id": 20513, "verse_number": "३-६०-८", "content_sanskrit": "संध्यासूक्तिविशेषेण चिंतयेन्नित्यमीश्वरम् ।\nकृत्वा हृत्पद्मनिलये विश्वाख्यं विश्वसंभवम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000513008, "chapter_id": 20513, "verse_number": "३-६०-९", "content_sanskrit": "आत्मानं सर्वभूतानां परस्तात्तमसः स्थितम् ।\nसर्वस्याधारमव्यक्तमानंदं ज्योतिरव्ययम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000513009, "chapter_id": 20513, "verse_number": "३-६०-१०", "content_sanskrit": "प्रधानपुरुषातीतमाकाशं दहनं शिवम् ।\nतदंतं सर्वभावानामीश्वरं ब्रह्मरूपिणम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000513010, "chapter_id": 20513, "verse_number": "३-६०-११", "content_sanskrit": "ओंकारांतेथवात्मानं समाप्य परमात्मनि ।\nआकाशे देवमीशानं ध्यायीताकाशमध्यगम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000513011, "chapter_id": 20513, "verse_number": "३-६०-१२", "content_sanskrit": "कारणं सर्वभावानामानंदैकसमाश्रयम् ।\nपुराणपुरुषं विष्णुं ध्यायन्मुच्येत बंधनात्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000513012, "chapter_id": 20513, "verse_number": "३-६०-१३", "content_sanskrit": "यद्वा गुहादौ प्रकृतौ जगत्संमोहनालये ।\nविचिंत्य परमं व्योम सर्वभूतैककारणम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000513013, "chapter_id": 20513, "verse_number": "३-६०-१४", "content_sanskrit": "जीवनं सर्वभूतानां यत्र लोकः प्रलीयते ।\nआनंदं ब्रह्मणः सूक्ष्मं यत्पश्यंति मुमुक्षवः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000513014, "chapter_id": 20513, "verse_number": "३-६०-१५", "content_sanskrit": "तन्मध्ये निहितं ब्रह्म केवलं ज्ञानलक्षणम् ।\nअनंतं सत्यमीशानं विचिंत्यासीत वाग्यतः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000513015, "chapter_id": 20513, "verse_number": "३-६०-१६", "content_sanskrit": "गुह्याद्गुह्यतमं ज्ञानं यतीनामेतदीरितम् ।\nयोवतिष्ठेत्सदानेन सोश्नुते योगमैश्वरम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000513016, "chapter_id": 20513, "verse_number": "३-६०-१७", "content_sanskrit": "तस्माज्ज्ञानरतो नित्यमात्मविद्यापरायणः ।\nज्ञानं समभ्यसेद्ब्रह्म येन मुच्येत बंधनात्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000513017, "chapter_id": 20513, "verse_number": "३-६०-१८", "content_sanskrit": "मत्वा पृथक्त्वमात्मानं सर्वस्मादेव केवलम् ।\nआनंदमक्षरं ज्ञानं ध्यायेत च ततः परम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000513018, "chapter_id": 20513, "verse_number": "३-६०-१९", "content_sanskrit": "यस्माद्भवंति भूतानि यज्ज्ञात्वा नेह जायते ।\nस तस्मादीश्वरो देवः परस्ताद्योधितिष्ठति॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000513019, "chapter_id": 20513, "verse_number": "३-६०-२०", "content_sanskrit": "यदंतरे तद्गमनं शाश्वतं शिवमव्ययम् ।\nय इदं स्वपरोक्षस्तु स देवः स्यान्महेश्वरः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000513020, "chapter_id": 20513, "verse_number": "३-६०-२१", "content_sanskrit": "व्रतानि यानि भिक्षूणां तथैवायं व्रतानि च ।\nएकैकातिक्रमेणैव प्रायश्चित्तं विधीयते॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000513021, "chapter_id": 20513, "verse_number": "३-६०-२२", "content_sanskrit": "उपेत्य च स्त्रियं कामात्प्रायश्चित्तं समाहितः ।\nप्राणायामसमायुक्तं कुर्य्यात्सांतपनं शुचिः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000513022, "chapter_id": 20513, "verse_number": "३-६०-२३", "content_sanskrit": "ततश्चरेत नियमात्कृच्छ्रं संयतमानसः ।\nपुनराश्रममागम्य चरेद्भिक्षुरतंद्रितः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000513023, "chapter_id": 20513, "verse_number": "३-६०-२४", "content_sanskrit": "न धर्मयुक्तमनृतं हिनस्तीति मनीषिणः ।\nतथापि च न कर्तव्यः प्रसंगो ह्येष दारुणः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000513024, "chapter_id": 20513, "verse_number": "३-६०-२५", "content_sanskrit": "एकरात्रोपवासश्च प्राणायामशतं तथा ।\nउक्त्वानृतं प्रकर्तव्यं यतिना धर्मलिप्सुना॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000513025, "chapter_id": 20513, "verse_number": "३-६०-२६", "content_sanskrit": "परमापद्गतेनापि न कार्यं स्तेयमन्यतः ।\nस्तेयादभ्यधिकः कश्चिन्नास्त्यधर्म इति स्मृतिः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000513026, "chapter_id": 20513, "verse_number": "३-६०-२७", "content_sanskrit": "हिंसा चैवापरा तृष्णा याच्ञात्मज्ञाननाशिका ।\nयदेतद्द्रविणं नाम प्राणा ह्येते बहिश्चराः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000513027, "chapter_id": 20513, "verse_number": "३-६०-२८", "content_sanskrit": "स तस्य हरते प्राणान्यो यस्य हरते धनम् ।\nएवं कृत्वा स दुष्टात्मा भिन्नवृत्तो व्रतच्युतः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000513028, "chapter_id": 20513, "verse_number": "३-६०-२९", "content_sanskrit": "भूयो निर्वेदमापन्नश्चरेद्भिक्षुरतंद्रितः ।\nअकस्मादेव हिंसां तु यदि भिक्षुः समाचरेत्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000513029, "chapter_id": 20513, "verse_number": "३-६०-३०", "content_sanskrit": "कुर्यात्कृच्छ्रातिकृच्छ्रं तु चांद्रायणमथापि वा ।\nस्कंदेतेंद्रियदौर्बल्यात्स्त्रियं दृष्ट्वा यतिर्यदि॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000513030, "chapter_id": 20513, "verse_number": "३-६०-३१", "content_sanskrit": "तेन धारयितव्या वै प्राणायामास्तु षोडश ।\nदिवास्कंदे त्रिरात्रं स्यात्प्राणायामशतं बुधाः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000513031, "chapter_id": 20513, "verse_number": "३-६०-३२", "content_sanskrit": "एकान्ने मधुमांसे च नवश्राद्धे तथैव च ।\nप्रत्यक्षलवणे चोक्तं प्राजापत्यं विशोधनम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000513032, "chapter_id": 20513, "verse_number": "३-६०-३३", "content_sanskrit": "ध्याननिष्ठस्य सततं नश्यते सर्वपातकम् ।\nतस्मान्नारायणं ध्यात्वा तस्य ध्यानपरो भवेत्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000513033, "chapter_id": 20513, "verse_number": "३-६०-३४", "content_sanskrit": "यद्ब्रह्मणः परं ज्योतिः प्रविष्टाक्षरमव्ययम् ।\nयोंतरात्मा परं ब्रह्म स विज्ञेयो महेश्वरः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000513034, "chapter_id": 20513, "verse_number": "३-६०-३५", "content_sanskrit": "एष देवो महादेवः केवलः परमं शिवः ।\nतदेवाक्षरमद्वैतं तदा नित्यं परं पदम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000513035, "chapter_id": 20513, "verse_number": "३-६०-३६", "content_sanskrit": "तस्मान्महीयते देवे स्वधाम्नि ज्ञानसंज्ञिते ।\nआत्मयोगात्परे तत्वे महादेवस्ततः स्मृतः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000513036, "chapter_id": 20513, "verse_number": "३-६०-३७", "content_sanskrit": "नान्यं देवं महादेवाद्व्यतिरिक्तं प्रपश्यति ।\nतमेवात्मानमन्वेति यः स याति परं पदम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000513037, "chapter_id": 20513, "verse_number": "३-६०-३८", "content_sanskrit": "मन्यंते ये स्वमात्मानं विभिन्नं परमेश्वरात् ।\nन ते पश्यंति तं देवं वृथा तेषां परिश्रमः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000513038, "chapter_id": 20513, "verse_number": "३-६०-३९", "content_sanskrit": "एकमेव परं ब्रह्म विज्ञेयं तत्त्वमव्ययम् ।\nस देवस्तु महादेवो नैतद्विज्ञाय बध्यते॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000513039, "chapter_id": 20513, "verse_number": "३-६०-४०", "content_sanskrit": "तस्माद्यतेत नियतं यतिः संयतमानसः ।\nज्ञानयोगरतः शांतो महादेवपरायणः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000513040, "chapter_id": 20513, "verse_number": "३-६०-४१", "content_sanskrit": "एष वः कथितो विप्रा यतीनामाश्रमः शुभः ।\nपितामहेन मुनिना विभुना पूर्वमीरितः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000513041, "chapter_id": 20513, "verse_number": "३-६०-४२", "content_sanskrit": "नापुत्रशिष्ययोगिभ्यो दद्यादेवमनुत्तमम् ।\nज्ञानं स्वयंभुवा प्रोक्तं यतिधर्म्माश्रयं शिवम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000513042, "chapter_id": 20513, "verse_number": "३-६०-४३", "content_sanskrit": "इति यतिनियमानामेतदुक्तं विधानं सुरवरपरितोषे यद्भवेदेकहेतुः ।\nन भवति पुनरेषामुद्भवो वा विनाशः प्रतिहितमनसो ये नित्यमेवाचरंति॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]