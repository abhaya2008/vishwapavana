[{"id": 7002912000, "chapter_id": 22912, "verse_number": "९-१९७-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअतः परं प्रवक्ष्यामि गुडपर्वतमुत्तमम् ।\nयत्प्रदानान्नरः स्वर्गं प्राप्नोति सुरपूजितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002912001, "chapter_id": 22912, "verse_number": "९-१९७-२", "content_sanskrit": "उत्तमो दशभिर्भारैः मध्यमः पंचभिस्तथा ।\nत्रिभिर्भारैः कनिष्ठः स्यात्तदर्द्धेनाल्पको मतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002912002, "chapter_id": 22912, "verse_number": "९-१९७-३", "content_sanskrit": "तद्वदामंत्रणं पूजां हेमवृक्षसुरार्चनम् ।\nविष्कंभपर्वतास्तत्र सरांसि वनदेवताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002912003, "chapter_id": 22912, "verse_number": "९-१९७-४", "content_sanskrit": "होमं जागरणं तद्वल्लोकपालाधिवासनम् ।\nधान्यपर्वतवत्कुर्यादिमं मंत्रमुदीरयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002912004, "chapter_id": 22912, "verse_number": "९-१९७-५", "content_sanskrit": "यथा देवेषु विश्वात्मा प्रवरोयं जनार्दनः ।\nसामवेदस्तु वेदानां महादेवस्तु योगिनाम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002912005, "chapter_id": 22912, "verse_number": "९-१९७-६", "content_sanskrit": "प्रणवः सर्वमंत्राणां नारीणां पार्वती यथा ।\nतथा रसानां प्रवरः सदा चेक्षुरसो मतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002912006, "chapter_id": 22912, "verse_number": "९-१९७-७", "content_sanskrit": "मम तस्मात्परां लक्ष्मीं प्रयच्छ गुडपर्वत ।\nसुरासुराणां सर्वेषां नागयक्षर्क्षयंत्रिणाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002912007, "chapter_id": 22912, "verse_number": "९-१९७-८", "content_sanskrit": "विनाशश्चापि पार्वत्यास्तस्मान्मां पाहि सर्वदा ।\nअनेन विधिना यस्तु दद्याद्गुडमयं गिरिम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002912008, "chapter_id": 22912, "verse_number": "९-१९७-९", "content_sanskrit": "संपूज्यमानो गंधर्वैर्गौंरीलोके महीयते ।\nपुनः कल्पशतांते तु सप्तद्वीपाधिपो भवेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002912009, "chapter_id": 22912, "verse_number": "९-१९७-१०", "content_sanskrit": "आयुरारोग्यसंपन्नः शत्रुभिश्चापराजितः ।\nआसीद्राज्ञी महाभागा सुलभा नाम सुव्रता ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002912010, "chapter_id": 22912, "verse_number": "९-१९७-११", "content_sanskrit": "मरुत्तस्य प्रिया भार्या रूप यौवनशालिनी ।\nतस्य भार्या शतान्यासन्सप्त राज्ञो महात्मनः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002912011, "chapter_id": 22912, "verse_number": "९-१९७-१२", "content_sanskrit": "ता दास्य इव वाक्यानि कुर्युस्तस्याः सदैव हि ।\nमुखावलोकनकरो राजा तस्य च सा प्रिया ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002912012, "chapter_id": 22912, "verse_number": "९-१९७-१३", "content_sanskrit": "अथ कालेन महता दुर्वासा ऋषिसत्तमः ।\nआजगाम तदभ्याशं भ्रममाणो यदृच्छया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002912013, "chapter_id": 22912, "verse_number": "९-१९७-१४", "content_sanskrit": "तस्याथ सत्क्रियां कृत्त्वा दत्त्वा चार्घं यथाविधि ।\nपप्रच्छ सुलभा विप्रं दुर्वाससमकल्मषम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002912014, "chapter_id": 22912, "verse_number": "९-१९७-१५", "content_sanskrit": "सुलभोवाच ।\nकेन पुण्येन भगवन्मम राजा प्रियंकरः ।\nमुखावलोकनपरो वशे तिष्ठति सर्वदा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002912015, "chapter_id": 22912, "verse_number": "९-१९७-१६", "content_sanskrit": "सपत्न्यश्च मम ब्रह्मन्सदा प्रियहिते रताः ।\nएतदाचक्ष्व भगवन्परं कौतूहलं मम ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002912016, "chapter_id": 22912, "verse_number": "९-१९७-१७", "content_sanskrit": "दुर्वासा उवाच ।\nशृणुष्वावहिता सुभ्रूरात्मवृत्तं पुरातनम् ।\nजानामि सर्वं सुभगे तव वृत्तमशेषतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002912017, "chapter_id": 22912, "verse_number": "९-१९७-१८", "content_sanskrit": "त्वमासीर्वैश्य महिषी गिरिव्रजपुरे पुरा ।\nधार्मिका सत्यशीला च पतिव्रतपरायणा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002912018, "chapter_id": 22912, "verse_number": "९-१९७-१९", "content_sanskrit": "तत्र श्रुतस्त्वया वत्से ब्राह्मणानां समीपतः ।\nपुरा दानविधिः कृत्स्नः स्थितया पतिसंनिधौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002912019, "chapter_id": 22912, "verse_number": "९-१९७-२०", "content_sanskrit": "विशेषतस्तत्र विप्रैः कथितो गुडपर्वतः ।\nदत्तश्चापि त्वया पुत्रि संभृत्य विधिवत्तदा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002912020, "chapter_id": 22912, "verse_number": "९-१९७-२१", "content_sanskrit": "तस्य दानस्य माहात्म्यात्त्वया भुक्तं वरानने ।\nराज्यं जन्मानि चत्वारि निःसपत्नमनाकुलम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002912021, "chapter_id": 22912, "verse_number": "९-१९७-२२", "content_sanskrit": "अन्यानि सप्त जन्मानि तव राज्यं भविष्यति ।\nसौभाग्यमतुलं चैव रूपमारोग्यमेव च ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002912022, "chapter_id": 22912, "verse_number": "९-१९७-२३", "content_sanskrit": "भूतं चैवमवश्यं च गुडपर्वतदानजम् ।\nकथा तव वरारोहे यास्ये त्वं भव पु त्रिणी ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002912023, "chapter_id": 22912, "verse_number": "९-१९७-२४", "content_sanskrit": "तस्माद्देयमिदं दानं फलमुत्तममिच्छता ।\nगतिं च शाश्वतीं लेभे सौभाग्यं रूपमेव च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002912024, "chapter_id": 22912, "verse_number": "९-१९७-२५", "content_sanskrit": "दानमेतत्प्रशंसंति स्त्रीणां राज न्विशेषतः ।\nपूर्वोक्तं च फलं प्राप्य कृतकृत्योऽभिजायते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002912025, "chapter_id": 22912, "verse_number": "९-१९७-२६", "content_sanskrit": "कृष्णेष्टसुंदरदरीस्रवणाकुलेन गंधर्वसिद्धवनिताशतसेवितेन ।\nदत्तेन भारत विधानवता सदैव गौरी प्रसादमुपयाति गुडाचलेन ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]