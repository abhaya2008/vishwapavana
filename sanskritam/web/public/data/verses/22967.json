[{"id": 7002967000, "chapter_id": 22967, "verse_number": "२-१४-१", "content_sanskrit": "नारायण उवाच ।\nलक्ष्मीं तौ च समाराध्य चोग्रेण तपसा मुने ।\nप्रत्येकं वरमिष्टं च संप्रापतुरभीप्सितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002967001, "chapter_id": 22967, "verse_number": "२-१४-२", "content_sanskrit": "महालक्ष्म्या वरेणैव तौ पृध्वीशौ बभूवतुः ।\nधनवन्तौ पुत्रवन्तौ धर्मध्वजकुशध्वजौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002967002, "chapter_id": 22967, "verse_number": "२-१४-३", "content_sanskrit": "कुशध्वजस्य पत्नी च देवी मालावती सती ।\nसा सुषाव च कालेन कमलांशां सुतां सतीम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002967003, "chapter_id": 22967, "verse_number": "२-१४-४", "content_sanskrit": "सा च भूतलसम्बन्धाज्ज्ञानयुक्ता बभूव ह ।\nकृत्वा वेदध्वनिं स्पष्टमुत्तस्थौ सूतिकागृहे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002967004, "chapter_id": 22967, "verse_number": "२-१४-५", "content_sanskrit": "वेदध्वनिं सा चकार जातमात्रेण कन्यका ।\nतस्मात्तां ते वेदवतीं प्रवदन्ति मनीषिणः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002967005, "chapter_id": 22967, "verse_number": "२-१४-६", "content_sanskrit": "जातमात्रेण सुस्नाता जगाम तपसे वनम् ।\nसर्वैर्निषिद्धा यत्नेन नारायणपरायणा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002967006, "chapter_id": 22967, "verse_number": "२-१४-७", "content_sanskrit": "एकमन्वन्तरं चैव पुष्करे च तपस्विनी ।\nअत्युग्रां वै तपस्यां तु लीलया च चकार सा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002967007, "chapter_id": 22967, "verse_number": "२-१४-८", "content_sanskrit": "तथाऽपि पुष्टा न कृशा नवयौवनसंयुता ।\nशुश्राव खे च सहसा सा वाचमशरीरिणीम्॥ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002967008, "chapter_id": 22967, "verse_number": "२-१४-९", "content_sanskrit": "जन्मान्तरे ते भर्त्ता च भविष्यति हरिः स्वयम् ।\nब्रह्मादिभिर्दुराराध्यं पतिं लप्स्यसि सुन्दरि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002967009, "chapter_id": 22967, "verse_number": "२-१४-१०", "content_sanskrit": "इति श्रुत्वा तु सा रुष्टा चकार च पुनस्तपः ।\nअतीव निर्जनस्थाने पर्वते गन्धमादने ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002967010, "chapter_id": 22967, "verse_number": "२-१४-११", "content_sanskrit": "तत्रैवं सुचिरं तप्त्वा विश्वस्य समुवास सा ।\nददर्श पुरतस्तत्र रावणं दुर्निवारणम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002967011, "chapter_id": 22967, "verse_number": "२-१४-१२", "content_sanskrit": "दृष्ट्वा साऽतिथिभक्त्या च पाद्यं तस्मै ददौ किल ।\nसुस्वादु फलमूलं च जलं चापि सुशीतलम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002967012, "chapter_id": 22967, "verse_number": "२-१४-१३", "content_sanskrit": "तच्च भुक्त्वा स पापिष्ठश्चावात्सीत्तत्समीपतः ।\nचकार प्रश्नमिति तां का त्वं कल्याणि चेति च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002967013, "chapter_id": 22967, "verse_number": "२-१४-१४", "content_sanskrit": "तां च दृष्ट्वा वरारोहां पीनोन्नतपयोधराम् ।\nशरत्पद्मनिभास्यां च सस्मितां सुदतीं सतीम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002967014, "chapter_id": 22967, "verse_number": "२-१४-१५", "content_sanskrit": "मूर्च्छामवाप कृपणः कामबाणप्रपीडितः ।\nतां करेण समाकृष्य सम्भोगं कर्तुमुद्यतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002967015, "chapter_id": 22967, "verse_number": "२-१४-१६", "content_sanskrit": "सा सती कोपदृष्ट्या च स्तम्भितं तं चकार ह ।\nस जडो हस्तपादैश्च किंचिद्वक्तुं न च क्षमः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002967016, "chapter_id": 22967, "verse_number": "२-१४-१७", "content_sanskrit": "तुष्टाव मनसा देवीं पद्मांशां पद्मलोचनाम् ।\nसा तत्स्तवेन सन्तुष्टा प्राकृतं तं मुमोच ह ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002967017, "chapter_id": 22967, "verse_number": "२-१४-१८", "content_sanskrit": "शशाप च मदर्थे त्वं विनश्यसि सबान्धवः ।\nस्पृष्टाऽहं च त्वया कामाद्विसृजाम्यवलोकय ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002967018, "chapter_id": 22967, "verse_number": "२-१४-१९", "content_sanskrit": "इत्युक्त्वा सा च योगेन देहत्यागं चकार ह ।\nगंगायां तां च संन्यस्य स्व गृहं रावणो ययौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002967019, "chapter_id": 22967, "verse_number": "२-१४-२०", "content_sanskrit": "अहो किमद्भुतं दृष्टं किं कृतं वा मयाऽधुना ।\nइति संचिन्त्य संस्मृत्य विललाप पुनः पुनः॥ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002967020, "chapter_id": 22967, "verse_number": "२-१४-२१", "content_sanskrit": "सा च कालान्तरे साध्वी बभूव जनकात्मजा ।\nसीतादेवीति विख्याता यदर्थे रावणो हतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002967021, "chapter_id": 22967, "verse_number": "२-१४-२२", "content_sanskrit": "महातपस्विनी सा च तपसा पूर्वजन्मनः ।\nलेभे रामं च भर्त्तारं परिपूर्णतमं हरिम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002967022, "chapter_id": 22967, "verse_number": "२-१४-२३", "content_sanskrit": "संप्राप्य तपसाऽऽराध्य स्वामिनं च जगत्पतिम् ।\nसा रमा सुचिरं रेमे रामेण सह सुन्दरी ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002967023, "chapter_id": 22967, "verse_number": "२-१४-२४", "content_sanskrit": "जातिस्मरा स्म स्मरति तपसश्च क्रमं पुरा ।\nसुखेन तज्जहौ सर्वं दुःखं चापि सुखं लभेत्॥ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002967024, "chapter_id": 22967, "verse_number": "२-१४-२५", "content_sanskrit": "नानाप्रकारविभवं चकार सुचिरं सती ।\nसम्प्राप्य सुकुमारं तमतीव नवयौवनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002967025, "chapter_id": 22967, "verse_number": "२-१४-२६", "content_sanskrit": "गुणिनं रसिकं शान्तं कान्तवेषमनुत्तमम् ।\nस्त्रीणां मनोज्ञं रुचिरं तथा लेभे यथेप्सितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002967026, "chapter_id": 22967, "verse_number": "२-१४-२७", "content_sanskrit": "पितुर्वचःपालनार्थं सत्यसन्धो रघूत्तमः ।\nजगाम काननं पश्चात्कालेन च बलीयसा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002967027, "chapter_id": 22967, "verse_number": "२-१४-२८", "content_sanskrit": "तस्थौ समुद्रनिकटे सीतया लक्ष्मणेन च ।\nददर्श तत्र वह्निं च विप्ररूपधरं हरिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002967028, "chapter_id": 22967, "verse_number": "२-१४-२९", "content_sanskrit": "तं रामं दुःखितं दृष्ट्वा स च दुःखी बभूव ह ।\nउवाच किंचित्सत्येष्टं सत्यं सत्यपरायणः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002967029, "chapter_id": 22967, "verse_number": "२-१४-३०", "content_sanskrit": "वह्निरुवाच ।\nभगवञ्छ्रूयतां वाक्यं कालेन यदुपस्थितम् ।\nसीताहरणकालोऽयं तवैव समुपस्थितः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002967030, "chapter_id": 22967, "verse_number": "२-१४-३१", "content_sanskrit": "दैवं च दुर्निवार्य्यं वै न च दैवात्परं बलम् ।\nमत्प्रसू मयि संन्यस्य च्छायां रक्षान्तिकेऽधुना ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002967031, "chapter_id": 22967, "verse_number": "२-१४-३२", "content_sanskrit": "दास्यामि सीतां तुभ्यं च परीक्षासमये पुनः ।\nदेवैः प्रस्थापितोऽहं च न च विप्रो हुताशनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002967032, "chapter_id": 22967, "verse_number": "२-१४-३३", "content_sanskrit": "रामस्तद्वचनं श्रुत्वा न प्रकाश्य च लक्ष्मणम् ।\nस्वच्छन्दं स्वीचकारासौ हृदयेन विदूयता ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002967033, "chapter_id": 22967, "verse_number": "२-१४-३४", "content_sanskrit": "वह्निर्योगेन सीतावन्मायासीतां चकार ह ।\nतत्तुल्यगुणरूपां तां ददौ रामाय नारद ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002967034, "chapter_id": 22967, "verse_number": "२-१४-३५", "content_sanskrit": "सीतां गृहीत्वा स ययौ गोप्यं वक्तुं निषेध्य च ।\nलक्ष्मणो नैव बुबुधे गोप्यमन्यस्य का कथा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002967035, "chapter_id": 22967, "verse_number": "२-१४-३६", "content_sanskrit": "एतस्मिन्नन्तरे रामो ददर्श कनकं मृगम् ।\nसीता तं प्रेरयामास तदर्थे यत्नपूर्वकम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002967036, "chapter_id": 22967, "verse_number": "२-१४-३७", "content_sanskrit": "संन्यस्य लक्ष्मणं रामो जानक्या रक्षणे वने ।\nस्वयं जगाम हन्तुं तं विव्यधे सायकेन च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002967037, "chapter_id": 22967, "verse_number": "२-१४-३८", "content_sanskrit": "लक्ष्मणेति च शब्दं वै कृत्वा मायामृगस्तदा ।\nप्राणांस्तत्याज सहसा पुरो दृष्ट्वा हरिं स्मरन् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002967038, "chapter_id": 22967, "verse_number": "२-१४-३९", "content_sanskrit": "मृगरूपं परित्यज्य दिव्यरूपं विधाय च ।\nरत्ननिर्मितयानेन वैकुण्ठं स जगाम ह ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002967039, "chapter_id": 22967, "verse_number": "२-१४-४०", "content_sanskrit": "वैकुण्ठस्य महाद्वारं किङ्करो द्वारपालयोः ।\nजय विजययोश्चैव बलवांश्च जयाभिधः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002967040, "chapter_id": 22967, "verse_number": "२-१४-४१", "content_sanskrit": "शापेन सनकादीनां सम्प्राप्तो राक्षसीं तनुम् ।\nपुनर्जगाम तद्द्वारमादौ स द्वारपालयोः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002967041, "chapter_id": 22967, "verse_number": "२-१४-४२", "content_sanskrit": "अथ शब्दं च सा श्रुत्वा लक्ष्मणेति च विक्लवम् ।\nसीता तं प्रेरयामास लक्ष्मणं रामसन्निधौ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002967042, "chapter_id": 22967, "verse_number": "२-१४-४३", "content_sanskrit": "गते च लक्ष्मणे रामं रावणो दुर्निवारणः ।\nसीतां गृहीत्वा प्रययौ लङ्कामेव स्वलीलया ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002967043, "chapter_id": 22967, "verse_number": "२-१४-४४", "content_sanskrit": "विषसाद च रामश्च वने दृष्ट्वा च लक्ष्मणम् ।\nतूर्णं च स्वाश्रमं गत्वा सीतां नैव ददर्श सः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002967044, "chapter_id": 22967, "verse_number": "२-१४-४५", "content_sanskrit": "मूर्च्छां सम्प्राप्य सुचिरं विललाप भृशं पुनः ।\nपुनर्बभ्राम गहने तदन्वेषणपूर्वकम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002967045, "chapter_id": 22967, "verse_number": "२-१४-४६", "content_sanskrit": "काले संप्राप्य तद्वार्तां गृधद्वारा नदीतटे ।\nसहायं वानरं कृत्वा चाबध्नात्सागरं हरिः॥ ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002967046, "chapter_id": 22967, "verse_number": "२-१४-४७", "content_sanskrit": "लङ्कां गत्वा रघुश्रेष्ठश्चावधीत्सायकेन च ।\nसबान्धवं रावणं च सीतां सम्प्राप दुःखिताम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002967047, "chapter_id": 22967, "verse_number": "२-१४-४८", "content_sanskrit": "तां च वह्निपरीक्षां व कारयामास सत्वरम् ।\nहुताशनस्तत्र काले वास्तवीं जानकीं ददौ ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002967048, "chapter_id": 22967, "verse_number": "२-१४-४९", "content_sanskrit": "छाया चोवाच वह्निं च रामं च विनयान्विता ।\nकरिष्यामीति किमहं तदुपायं वदस्व मे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002967049, "chapter_id": 22967, "verse_number": "२-१४-५०", "content_sanskrit": "वह्निरुवाच ।\nत्वं गच्छ तपसे देवि पुष्करं च सुपुण्यदम् ।\nकृत्वा तपस्यां तत्रैव स्वर्गलक्ष्मीर्भविष्यसि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002967050, "chapter_id": 22967, "verse_number": "२-१४-५१", "content_sanskrit": "सा च तद्वचनं श्रुत्वा प्रतेपे पुष्करे तपः ।\nदिव्यं त्रिलक्षवर्ष च स्वर्गे लक्ष्मीर्बभूव ह ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002967051, "chapter_id": 22967, "verse_number": "२-१४-५२", "content_sanskrit": "सा च कालेन तपसा यज्ञकुण्डसमुद्भवा ।\nकामिनी पाण्डवानां च द्रौपदी द्रुपदात्मजा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002967052, "chapter_id": 22967, "verse_number": "२-१४-५३", "content_sanskrit": "कृते युगे वेदवती कुशध्वजसुता शुभा ।\nत्रेतायां रामपत्नी च सीतेति जनकात्मजा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002967053, "chapter_id": 22967, "verse_number": "२-१४-५४", "content_sanskrit": "तच्छाया द्रौपदी देवी द्वापरे द्रुपदात्मजा ।\nत्रिहायणीति सा प्रोक्ता विद्यमाना युगत्रये ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002967054, "chapter_id": 22967, "verse_number": "२-१४-५५", "content_sanskrit": "नारद उवाच ।\nप्रियाः पञ्च कथं तस्या बभूवुर्मुनिपुङ्गव ।\nइति वै चित्तसन्देहं दूरीकुरु महाप्रभो ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002967055, "chapter_id": 22967, "verse_number": "२-१४-५६", "content_sanskrit": "नारायण उवाच ।\nलङ्कायां वस्तुतः सीता रामं संप्राप नारद ।\nरूपयौवनसम्पन्ना छाया सा बहुविह्वला ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002967056, "chapter_id": 22967, "verse_number": "२-१४-५७", "content_sanskrit": "रामाग्न्योराज्ञया तप्त्वा ययाचे शङ्करं वरम् ।\nकामातुरा पतिव्यग्रा प्रार्थयन्ती पुनः पुनः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002967057, "chapter_id": 22967, "verse_number": "२-१४-५८", "content_sanskrit": "पतिं देहि पतिं देहि पतिं देहि त्रिलोचन ।\nपतिं देहि पतिं देहि पञ्चवारं पतिव्रता ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002967058, "chapter_id": 22967, "verse_number": "२-१४-५९", "content_sanskrit": "शिवस्तत्प्रार्थनां श्रुत्वा सस्मितो रसिकेश्वरः ।\nप्रिये तव प्रियाः पञ्च भवन्तीति वरं ददौ ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002967059, "chapter_id": 22967, "verse_number": "२-१४-६०", "content_sanskrit": "तेनासीत्पाण्डवानां च पञ्चानां कामिनी प्रिया ।\nइत्येवं कथितं सर्वं प्रस्तुतं वस्तुतः शृणु ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002967060, "chapter_id": 22967, "verse_number": "२-१४-६१", "content_sanskrit": "अथ संप्राप्य लङ्कायां सीतां रामो मनोहराम् ।\nविभीषणाय तां लङ्कां  दत्त्वाऽयोध्यां ययौ पुनः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002967061, "chapter_id": 22967, "verse_number": "२-१४-६२", "content_sanskrit": "एकादशसहस्राब्दं कृत्वा राज्यं च भारते ।\nजगाम सर्वैर्लोकैश्च सार्द्धं वैकुण्ठमेव च ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002967062, "chapter_id": 22967, "verse_number": "२-१४-६३", "content_sanskrit": "कमलांशा वेदवती कमलायां विवेश सा ।\nकथितं पुण्यमाख्यानं पुण्यदं पापनाशनम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002967063, "chapter_id": 22967, "verse_number": "२-१४-६४", "content_sanskrit": "सततं मूर्तिमन्तश्च वेदाश्चत्वार एव च ।\nसन्ति यस्याश्च जिह्वाग्रे सा च वेदवती स्मृता ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002967064, "chapter_id": 22967, "verse_number": "२-१४-६५", "content_sanskrit": "कुशध्वजसुताख्यानमुक्तं संक्षेपतस्तव ।\nधर्मध्वजसुताख्यानं निबोध कथयामि ते ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]