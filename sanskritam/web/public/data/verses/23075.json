[{"id": 7003075000, "chapter_id": 23075, "verse_number": "४-१०-१", "content_sanskrit": "श्रीनारायण उवाच ।\nअथ कंसः सभामध्ये स्वर्णसिंहासनस्थितः ।\nशुश्राव वाचं गगने सूनृतामशरीरिणीम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003075001, "chapter_id": 23075, "verse_number": "४-१०-२", "content_sanskrit": "किं करोषि महामूढ चिंतां स्वश्रेयसः कुरु ।\nजातः कालो धरण्यां ते तिष्ठोपाये नराधिप ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003075002, "chapter_id": 23075, "verse_number": "४-१०-३", "content_sanskrit": "नंदाय तनयं दत्त्वा वसुदेवस्तवांतकम् ।\nकन्यामादाय तुभ्यं च दत्त्वा संमायया स्थितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003075003, "chapter_id": 23075, "verse_number": "४-१०-४", "content_sanskrit": "मायांशा कन्यकेयं च वासुदेवः स्वयं हरिः ।\nतव हंता गोकुले च वर्द्धते नंदमंदिरे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003075004, "chapter_id": 23075, "verse_number": "४-१०-५", "content_sanskrit": "देवक्याः सप्तमो गर्भो वर्द्धते नंदमंदिरे ।\nदेवक्याः सप्तमो गर्भो न सुस्रावामृतं सुतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003075005, "chapter_id": 23075, "verse_number": "४-१०-६", "content_sanskrit": "स्थापयामास मायो तं रोहिणीजठरे किल ।\nतत्र जातश्च शेषांशो बलदेवो महाबलः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003075006, "chapter_id": 23075, "verse_number": "४-१०-७", "content_sanskrit": "गोकुले तौ च वर्धेते कालौ ते नंदमंदिरे ।\nश्रुत्वेति वचनं राजा बभूवानम्रकंधरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003075007, "chapter_id": 23075, "verse_number": "४-१०-८", "content_sanskrit": "चिंतामवाप सहसा तत्याजाहारमुन्मनाः ।\nपूतनां च समानीय प्राणेभ्यः प्रेयसीं सतीम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003075008, "chapter_id": 23075, "verse_number": "४-१०-९", "content_sanskrit": "उवाच भगिनीं राजा सभामध्ये च नीतिवित् ।\n॥कंस उवाच॥।\nपूतने गोकुलं गच्छ कार्यार्थं नंदमंदिरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003075009, "chapter_id": 23075, "verse_number": "४-१०-१०", "content_sanskrit": "विषाक्तं च स्तनं कृत्वा शिशवे देहि सत्वरम् ।\nत्वं मनोयायिनी वत्से मायाशास्त्रविशारदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003075010, "chapter_id": 23075, "verse_number": "४-१०-११", "content_sanskrit": "मायामानुषरूपं च विधाय व्रज योगिनि ।\nदुर्वाससो महामंत्रं प्राप्य सर्वत्रगामिनी ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003075011, "chapter_id": 23075, "verse_number": "४-१०-१२", "content_sanskrit": "सर्वरूपं विधातुं त्वं शक्तासि सुप्रतिष्ठिते ।\nइत्युक्त्वा तां महाराजस्तस्थौ संसदि नारद ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003075012, "chapter_id": 23075, "verse_number": "४-१०-१३", "content_sanskrit": "जगाम पूतना कंसं प्रणम्य कामचारिणी ।\nतप्तकांचनवर्णाभा नानालंकारभूषिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003075013, "chapter_id": 23075, "verse_number": "४-१०-१४", "content_sanskrit": "बिभ्रती कबरीभारं मालतीमाल्यसंयुतम् ।\nकस्तूरीबिंदुना युक्तं सिंदूरं दधती मुदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003075014, "chapter_id": 23075, "verse_number": "४-१०-१५", "content_sanskrit": "मंजीररशनाभ्यां च कलशब्दं प्रकुर्वती ।\nसंप्राप्य गोष्ठं दुर्दर्शं नंदालयमनोहरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003075015, "chapter_id": 23075, "verse_number": "४-१०-१६", "content_sanskrit": "परिखाभिर्गभीराभिर्दुर्लंघ्याभिश्च वेष्टितम् ।\nरचितं प्रस्तरैर्दिव्यैर्निर्मितं विश्वकर्मणा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003075016, "chapter_id": 23075, "verse_number": "४-१०-१७", "content_sanskrit": "इंद्रनीलैर्मरकतैः पद्मरागैश्च भूषितम् ।\nसुवर्णकलशैर्दिव्यैश्चित्रितैः शेखरोज्ज्वलैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003075017, "chapter_id": 23075, "verse_number": "४-१०-१८", "content_sanskrit": "प्राकारैर्गगनस्पर्शैश्चतुर्द्वारसमन्वितैः ।\nयुक्तं लोहकपाटैश्च द्वारपालसमन्वितैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003075018, "chapter_id": 23075, "verse_number": "४-१०-१९", "content_sanskrit": "वेष्टितं सुन्दरं रम्यं सुन्दरीगणवेष्टितम् ।\nमुक्तामाणिक्यपरशैः पूर्णरत्नादिभिर्धनैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003075019, "chapter_id": 23075, "verse_number": "४-१०-२०", "content_sanskrit": "स्वर्णपात्रवटाकीर्णं गवां कोटिभिरन्वितम्।\nभरणीयैः किंकरैश्च गोपलक्षैः समन्वितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003075020, "chapter_id": 23075, "verse_number": "४-१०-२१", "content_sanskrit": "दासीनां च सहस्रैश्च कर्मव्यग्रैः समन्वितम् ।\nप्रविवेशाश्रमं साध्वी सस्मिता सुमनोहरा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003075021, "chapter_id": 23075, "verse_number": "४-१०-२२", "content_sanskrit": "दृष्ट्वा तां प्रविशंतीं च गोप्यो दृष्ट्वानुमेनिरे ।\nकिं वा पद्मालया दुर्गा कृष्णं द्रष्टुं समागता ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003075022, "chapter_id": 23075, "verse_number": "४-१०-२३", "content_sanskrit": "प्रणेमुर्गोपिका गोपाः पप्रच्छुः कुशलं च ताम् ।\nददौ सिंहासनं पाद्यं वासयामास तत्र वै ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003075023, "chapter_id": 23075, "verse_number": "४-१०-२४", "content_sanskrit": "पप्रच्छ कुशलं सा च गोपानां बालकस्य च ।\nउवास सस्मिता साध्वी पाद्यं जग्राह सादरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003075024, "chapter_id": 23075, "verse_number": "४-१०-२५", "content_sanskrit": "तामूचुर्गोपिकाः सर्वाः का त्वमीश्वरि सांप्रतम् ।\nवासस्ते कुत्र किं नाम किं वात्र कर्म नो वद ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003075025, "chapter_id": 23075, "verse_number": "४-१०-२६", "content_sanskrit": "तासां च वचनं श्रुत्वा साप्युवाच मनोहरम् ।\nमथुरावसिनी गोपी सांप्रतं विप्रकामिनी ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003075026, "chapter_id": 23075, "verse_number": "४-१०-२७", "content_sanskrit": "श्रुतं वाचिकवक्त्रेण तत्त्वं मंगलसूचकम् ।\nबभूव स्थविरे काले नंदपुत्रो महानिति ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003075027, "chapter_id": 23075, "verse_number": "४-१०-२८", "content_sanskrit": "श्रुत्वागताहं तं द्रष्टुमाशिषं कर्तुमीप्सिताम्॥। ।\nपुत्रमानय तं दृष्ट्वा यामि कृत्वा तमाशिषम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003075028, "chapter_id": 23075, "verse_number": "४-१०-२९", "content_sanskrit": "ब्राह्मणीवचनं श्रुत्वा यशोदा हृष्टमानसा ।\nप्रणमय्य सुतं क्रोडे ददौ ब्राह्मणयोषितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003075029, "chapter_id": 23075, "verse_number": "४-१०-३०", "content_sanskrit": "कृत्वा क्रोडे तु तं साध्वी चुचुंब च पुनः पुनः ।\nस्तनं ददौ सुखासीना हरिं पुण्यवती सती ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003075030, "chapter_id": 23075, "verse_number": "४-१०-३१", "content_sanskrit": "अहोद्भुतोऽयं बालस्त सुन्दरो गोपसुन्दरि ।\nगुणैर्नारायणसमो बालोयमित्युवाच ह ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003075031, "chapter_id": 23075, "verse_number": "४-१०-३२", "content_sanskrit": "कृष्णो विषस्तनं पीत्वा जहास वक्षसि स्थितः ।\nतस्याः प्राणैः सह पपौ विषक्षीरं सुधामिव ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003075032, "chapter_id": 23075, "verse_number": "४-१०-३३", "content_sanskrit": "तत्याज बालकं साध्वी प्राणांस्त्यक्त्वा  पपात ह ।\nविकृताकारवदना चोत्तानवदना मुने ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003075033, "chapter_id": 23075, "verse_number": "४-१०-३४", "content_sanskrit": "स्थूलदेहं परित्यज्य सृक्ष्मदेहं विवेश सा ।\nआरुरोह रथं शीघ्रं रत्नसारविनिर्मितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003075034, "chapter_id": 23075, "verse_number": "४-१०-३५", "content_sanskrit": "पार्षदप्रवरैर्दिव्यैर्वेष्टितं सुमनोहरैः ।\nश्वेतचामरलक्षेण शोभितं लक्षदर्पणैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003075035, "chapter_id": 23075, "verse_number": "४-१०-३६", "content_sanskrit": "वह्निशौचेन वस्त्रेण सूक्ष्मेण भूषितं वरम् ।\nनानाचित्रविचित्रैश्च सद्रत्नकलशैर्युतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003075036, "chapter_id": 23075, "verse_number": "४-१०-३७", "content_sanskrit": "सुंदरं शतचक्रं च वलितं रत्नतेजसा ।\nपार्षदास्तां रथे कृत्वा जग्मुर्गोलोकमुत्तमम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003075037, "chapter_id": 23075, "verse_number": "४-१०-३८", "content_sanskrit": "दृष्ट्वा तमद्भुतं लोका गोपिकाश्चातिविस्मिताः ।\nकंसः श्रुत्वा च तत्सर्वं विस्मितश्च बभूव ह ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003075038, "chapter_id": 23075, "verse_number": "४-१०-३९", "content_sanskrit": "यशोदा बालकं नीत्वा क्रोडे कृत्वा स्तनं ददौ ।\nमंगलं कारयामास विप्रद्वारा शिशोर्मुने ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003075039, "chapter_id": 23075, "verse_number": "४-१०-४०", "content_sanskrit": "ददाह देहं तस्याश्च नंदः सानंदर्पूवकम् ।\nचंदनागुरुकस्तूरीसमं संप्राप्य सौरभम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003075040, "chapter_id": 23075, "verse_number": "४-१०-४१", "content_sanskrit": "नारद उवाच ।\nसा वा का राक्षसीरूपा कथं पुण्यवती सती ।\nकेन पुण्येन तं दृष्ट्वा जगाम कृष्णमंदिरम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003075041, "chapter_id": 23075, "verse_number": "४-१०-४२", "content_sanskrit": "श्रीनारायण उवाच ।\nबलियज्ञे वामनस्य दृष्ट्वा रूपं मनोहरम्।\nबलिकन्या रत्नमाला पुत्रस्नेहं चकार तम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003075042, "chapter_id": 23075, "verse_number": "४-१०-४३", "content_sanskrit": "मनसा मानसं चक्रे पुत्रस्य सदृशो मम ।\nपिबेद्यदि स्तनं कृष्णः करोमि तं च वक्षसि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003075043, "chapter_id": 23075, "verse_number": "४-१०-४४", "content_sanskrit": "हरिस्तन्मानसं ज्ञात्वा पपौ जन्मांतरे स्तनम् ।\nददौ मातृगतिं तस्यै कामपूरः कृपानिधिः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003075044, "chapter_id": 23075, "verse_number": "४-१०-४५", "content_sanskrit": "दत्त्वा विषस्तनं कृष्णं पूतना राक्षसी मुने ।\nभक्त्या मातृगतिं प्राप कं भजाम विना हरिम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003075045, "chapter_id": 23075, "verse_number": "४-१०-४६", "content_sanskrit": "इत्येवं कथितं विप्र श्रीकृष्ण गुणकीर्तनम् ।\nपदेपदे सुमधुरं प्रवरं कथयामि ते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]