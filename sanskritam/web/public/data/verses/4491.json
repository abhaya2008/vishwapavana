[{"id": 2161395, "chapter_id": 4491, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2161396, "chapter_id": 4491, "verse_number": "१", "content_sanskrit": "भारद्वाजं कथं युद्धे युयुधानो न्यवारयत् ।\nसञ्जयाचक्ष्व तत्त्वेन कौतूहलमतीव मे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2161397, "chapter_id": 4491, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2161398, "chapter_id": 4491, "verse_number": "२", "content_sanskrit": "शृणु राजन् महाश्चर्यं सङ्ग्रामं रोमहर्षणम् ।\nद्रोणस्य पाण्डवैः सार्धं युयुधानपुरोगमैः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2161399, "chapter_id": 4491, "verse_number": "३", "content_sanskrit": "वध्यमानं बलं दृष्ट्वा युयुधानेन मारिष ।\nअभ्यद्रवत् स्वयं द्रोणः सात्यकिं सत्यविक्रमः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2161400, "chapter_id": 4491, "verse_number": "४", "content_sanskrit": "तमापतन्तं सहसा भारद्वाजं महारथम् ।\nसात्यकिः पञ्चविंशत्या क्षुद्रकाणां समर्पयत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2161401, "chapter_id": 4491, "verse_number": "५", "content_sanskrit": "द्रोणोऽपि युधि विक्रान्तो युयुधानं समाहितम् ।\nअविद्ध्यत् पञ्चभिस्तूर्णं हेमपुङ्खैः शिलाशितैः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2161402, "chapter_id": 4491, "verse_number": "६", "content_sanskrit": "ते वर्म भित्त्वा सुदृढं द्विषद्रुधिरभोजनाः ।\nअभ्ययुर्धरिणीं राजन् श्वसन्त इव पन्नगाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2161403, "chapter_id": 4491, "verse_number": "७", "content_sanskrit": "तं दीर्घबाहुः सङ्क्रुद्धः तोत्रार्दित इव द्विपः ।\nद्रोणं पञ्चाशताऽविद्ध्यन्नाराचैरग्निसन्निभैः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2161404, "chapter_id": 4491, "verse_number": "८", "content_sanskrit": "भारद्वाजो रणे विद्धो युयुधानेन सत्वरम् ।\nसात्यकिं नवभिर्बाणैर्यतमानमविद्ध्यत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2161405, "chapter_id": 4491, "verse_number": "९", "content_sanskrit": "ततः क्रुद्धो महेष्वासो भूय एव महारथः ।\nसात्वतं पीडयामास व्रातेन नतपर्वणाम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2161406, "chapter_id": 4491, "verse_number": "१०", "content_sanskrit": "स वध्यमानः समरे भारद्वाजेन सात्यकिः ।\nनाभ्यपद्यत कर्तव्यं किञ्चिदेव विशांपते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2161407, "chapter_id": 4491, "verse_number": "११", "content_sanskrit": "विषण्णवदनश्चापि युयुधानोऽभवन्नृप ।\nभारद्वाजं रणे दृष्ट्वा विसृजन्तं शरान् शितान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2161408, "chapter_id": 4491, "verse_number": "१२", "content_sanskrit": "तं तु सम्प्रेक्ष्य ते पुत्राः सैनिकाश्च विशांपते ।\nप्रहृष्टमनसो भूत्वा सिंहवद् व्यनदन् मुहुः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2161409, "chapter_id": 4491, "verse_number": "१३", "content_sanskrit": "तं श्रुत्वा निनदं घोरं पीड्यमानं च माधवम् ।\nयुधिष्ठिरोऽब्रवीद् राजन् सर्वसैन्यानि भारत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2161410, "chapter_id": 4491, "verse_number": "१४", "content_sanskrit": "एष वृष्णिवरो वीरः सात्यकिः सत्यविक्रमः ।\nग्रस्यते युधि वीरेण आदित्य इव राहुणा\nआगच्छताभिद्रवत सात्यकिर्यत्र युद्ध्यते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2161411, "chapter_id": 4491, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2161412, "chapter_id": 4491, "verse_number": "१५", "content_sanskrit": "धृष्टद्युम्नं च पाञ्चाल्यमिदमाह जनाधिप \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2161413, "chapter_id": 4491, "verse_number": "", "content_sanskrit": "द्रोणं वारय सुक्षिप्रं सात्यकिं मा वधीद् द्विजः ।\nअभिद्रव द्रुतं द्रोणं किन्नु तिष्ठसि पार्षत\t॥१६॥\nन पश्यसि भयं घोरं द्रोणान्नः समुपस्थितम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2161414, "chapter_id": 4491, "verse_number": "१७", "content_sanskrit": "असौ द्रोणो महेष्वासो युयुधानेन संयुगे ।\nक्रीडते सूत्रबद्धेन पक्षिणा बालको यथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2161415, "chapter_id": 4491, "verse_number": "१८", "content_sanskrit": "तत्रैव सर्वे गच्छन्तु भीमसेनमुखा रथाः ।\nत्वयैव सहसा यत्ता युयुधानरथं प्रति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2161416, "chapter_id": 4491, "verse_number": "१९", "content_sanskrit": "पृष्ठतोऽनुगमिष्यामि त्वामहं सहसैनिकः ।\nसात्यकिं मोक्षयस्वाद्य यमदंष्ट्रान्तरं गतम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2161417, "chapter_id": 4491, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2161418, "chapter_id": 4491, "verse_number": "२०", "content_sanskrit": "एवमुक्त्वा ततो राजा सर्वसैन्येन पाण्डवः ।\nअभ्यद्रवद् रणे द्रोणं युयुधानस्य कारणात्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2161419, "chapter_id": 4491, "verse_number": "२१", "content_sanskrit": "तत्रारावो महानासीद् द्रोणमेकं युयुत्सताम् ।\nपाण्डवानां च भद्रं ते सृञ्जयानां च सर्वशः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2161420, "chapter_id": 4491, "verse_number": "२२", "content_sanskrit": "ते समेत्य नरव्याघ्रा भारद्वाजं महारथम् ।\nअभ्यवर्षन् शरैस्तीक्ष्णैः कङ्कबर्हणवाजितैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2161421, "chapter_id": 4491, "verse_number": "२३", "content_sanskrit": "स्मयन्नेव तु तान् वीरो द्रोणः प्रत्यग्रहीत् स्वयम् ।\nअतिथीनागतान् यद्वद् आसनेनोदकेन च\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2161422, "chapter_id": 4491, "verse_number": "२४", "content_sanskrit": "तर्षितास्ते शरैस्तस्य भारद्वाजस्य धन्विनः ।\nआतिथेयं गृहं प्राप्य तर्प्यन्तेऽतिथयो यथा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2161423, "chapter_id": 4491, "verse_number": "२५", "content_sanskrit": "भारद्वाजं च ते युद्धे नाशकन् प्रतिवीक्षितुम् ।\nमध्यन्दिनमनुप्राप्तं सहस्रांशुमिव प्रभो\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2161424, "chapter_id": 4491, "verse_number": "२६", "content_sanskrit": "तांस्तु सर्वान् महेष्वासान् द्रोणः शस्त्रभृतां वरः ।\nअतापयच्छरव्रातैर्गभस्तिभिरिवांशुमान्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2161425, "chapter_id": 4491, "verse_number": "२७", "content_sanskrit": "वध्यमाना रणे राजन् पाण्डवाः सृञ्जयास्तथा ।\nत्रातारं नाध्यगच्छन्त पङ्के मग्ना यथा गजाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2161426, "chapter_id": 4491, "verse_number": "२८", "content_sanskrit": "तस्य द्रोणस्य दृश्यन्ते प्रभवन्तो महाशराः ।\nगभस्तय इवार्कस्य प्रतपन्तः समन्ततः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2161427, "chapter_id": 4491, "verse_number": "२९", "content_sanskrit": "तस्मिन् द्रोणेन निहताः पाञ्चालाः पञ्चविंशतिः ।\nमहारथसमाख्याता धृष्टद्युम्नस्य सम्मताः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2161428, "chapter_id": 4491, "verse_number": "३०", "content_sanskrit": "पाण्डूनां सर्वसैन्येषु पाञ्चालानां तथैव च ।\nद्रोणं स्म ददृशुः शूरा विनिघ्नन्तं वरान् वरान्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2161429, "chapter_id": 4491, "verse_number": "३१", "content_sanskrit": "केकयानां शतं हत्वा विद्राव्य च समन्ततः ।\nद्रोणस्तस्थौ महाराज व्यात्तानन इवान्तकः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2161430, "chapter_id": 4491, "verse_number": "३२", "content_sanskrit": "पाञ्चालान् सृञ्जयान् मात्स्यान् केकयान् पाण्डवानपि ।\nद्रोणोऽजयन्महाबाहुः शतशोऽथ सहस्रशः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2161431, "chapter_id": 4491, "verse_number": "३३", "content_sanskrit": "तेषां समभवच्छब्दो वध्यतां द्रोणसायकैः ।\nवनौकसामिवारण्ये दह्यतां धूमकेतुना\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2161432, "chapter_id": 4491, "verse_number": "३४", "content_sanskrit": "तत्र देवाः सगन्धर्वाः पितरश्चाब्रुवन् नृप॥\nएते द्रवन्ति पाञ्चालाः पाण्डवाः सहसैनिकाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2161433, "chapter_id": 4491, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2161434, "chapter_id": 4491, "verse_number": "३५", "content_sanskrit": "तं तथा समरे द्रोणं निघ्नन्तं सोमकान् रणे ।\nतं चाप्यभिययुः केचिदपरे नैव विव्यधुः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2161435, "chapter_id": 4491, "verse_number": "३६", "content_sanskrit": "वर्तमाने तथा रौद्रे तस्मिन् वीरवरक्षये ।\nअशृणोत् सहसा पार्थः पाञ्चजन्यस्य निस्वनम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2161436, "chapter_id": 4491, "verse_number": "३७", "content_sanskrit": "पूरिते वासुदेवेन शङ्खराजे महात्मना ।\nयुद्ध्यमानेषु वीरेषु सैन्धवस्य च रक्षिषु\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2161437, "chapter_id": 4491, "verse_number": "३८", "content_sanskrit": "नदत्सु धार्तराष्ट्रेषु विजयस्य रथं प्रति ।\nगाण्डीवस्य च निर्घोषे विप्रनष्टे समन्ततः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2161438, "chapter_id": 4491, "verse_number": "३९", "content_sanskrit": "कश्मलाभिहतो राजा चिन्तयामास पाण्डवः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2161439, "chapter_id": 4491, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2161440, "chapter_id": 4491, "verse_number": "४०", "content_sanskrit": "न नूनं स्वस्ति पार्थस्य यथा नदति शङ्खराट् ।\nकौरवाश्च यथा हृष्टा विनदन्ति मुहुर्मुहुः\nव्यक्तमद्य विनश्यन्ते सर्वलोकमहारथाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2161441, "chapter_id": 4491, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2161442, "chapter_id": 4491, "verse_number": "४१", "content_sanskrit": "श्रुत्वा तु निनदं घोरं पाञ्चजन्यस्य मारिष ।\nचिन्तयित्वा भृशं राजा व्याकुलेनान्तरात्मना\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2161443, "chapter_id": 4491, "verse_number": "४२", "content_sanskrit": "अजातशत्रुः शैनेयमभ्यभाषत सात्यकिम् ।\nबाष्पगद्गदया वाचा मुह्यमानो मुहुर्मुहुः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2161444, "chapter_id": 4491, "verse_number": "४३", "content_sanskrit": "कृत्यस्यानन्तरापेक्षी शैनेयं शिनिपुङ्गवम् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2161445, "chapter_id": 4491, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2161446, "chapter_id": 4491, "verse_number": "४४", "content_sanskrit": "योऽयं धर्मः पुरा सृष्टः सद्भिः शैनेय शाश्वतः ।\nसाम्पराये सुहृत्कृत्ये तस्य कालोऽयमागतः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2161447, "chapter_id": 4491, "verse_number": "४५", "content_sanskrit": "सर्वेष्वपि च योधेषु चिन्तयन् शिनिपुङ्गव ।\nत्वत्तः सुहृत्तमं कञ्चिन्नाभिजानामि सात्त्वत\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2161448, "chapter_id": 4491, "verse_number": "४६", "content_sanskrit": "प्रियः प्रीतमना नित्यं यश्च नित्यमनुव्रतः ।\nस कार्ये साम्पराये वा नियोज्य इति मे मतिः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2161449, "chapter_id": 4491, "verse_number": "४७", "content_sanskrit": "यथा हि केशवो नित्यं पाण्डवानां परायणम् ।\nतथा त्वमपि वार्ष्णेय कृष्णतुल्यपराक्रमः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2161450, "chapter_id": 4491, "verse_number": "४८", "content_sanskrit": "त्वयि भारं समाधास्ये त्वं तं वोढुमिहार्हसि ।\nअभिप्रायं च मे नित्यं न मृषा कर्तुमर्हसि\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2161451, "chapter_id": 4491, "verse_number": "४९", "content_sanskrit": "स त्वं भ्रातुर्वयस्यस्य गुरोरपि च संयुगे ।\nकुरु कृच्छ्रे सहायार्थमर्जुनस्य महामृधे\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2161452, "chapter_id": 4491, "verse_number": "५०", "content_sanskrit": "त्वं हि सत्यव्रतः शूरो मित्राणामभयङ्करः ।\nलोके विख्यायसे शूर कर्मभिः सत्यवागिति\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2161453, "chapter_id": 4491, "verse_number": "५१", "content_sanskrit": "यो हि शैनेय मित्रार्थे युद्ध्यमानस्तनुं त्यजेत् ।\nपृथिवीं च द्विजातिभ्यो यो दद्यात् सममेव तत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2161454, "chapter_id": 4491, "verse_number": "५२", "content_sanskrit": "श्रुताश्च बहवोऽस्माभी राजानो ये दिवं गताः ।\nदत्वेमां पृथिवीं कृत्स्नां ब्राह्मणेभ्यो यथाविधि\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2161455, "chapter_id": 4491, "verse_number": "५३", "content_sanskrit": "दीयमाना च बहुभिर्दास्यते च मुहुर्मही ।\nनतु कश्चिद् रणे प्राणान् मित्रार्थे त्यक्तवानिह\nएवं त्वामपि धर्मात्मन् प्रयाचेऽहं कृताञ्जलिः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2161456, "chapter_id": 4491, "verse_number": "५४", "content_sanskrit": "पृथिवीदानतस्तुल्यमधिकं वा फलं विभो \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2161457, "chapter_id": 4491, "verse_number": "५५", "content_sanskrit": "एक एव सदा कृष्णो मित्राणामभयङ्करः ।\nरणे त्यजति च प्राणान् द्वितीयस्त्वं च सात्यके\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2161458, "chapter_id": 4491, "verse_number": "५६", "content_sanskrit": "शूरस्य युद्ध्यमानस्य युद्धात् प्रार्थयतो यशः ।\nशूर एव सहायः स्यान्नेतरः प्राकृतो जनः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2161459, "chapter_id": 4491, "verse_number": "५७", "content_sanskrit": "ईदृशे हि परामर्दे वर्तमाने च माधव ।\nत्वदन्यो हि रणे गोप्ता विजयस्य न विद्यते\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2161460, "chapter_id": 4491, "verse_number": "५८", "content_sanskrit": "श्लाघयन्नेव कर्माणि विजयस्तव माधव ।\nमम सञ्जनयन् हर्षं पुनः पुनरकीर्तयत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2161461, "chapter_id": 4491, "verse_number": "५९", "content_sanskrit": "लघ्वस्त्रश्चित्रयोधी च तथा लघुपराक्रमः ।\nप्राज्ञः सर्वास्त्रविच्छूरो न च मुह्यति संयुगे\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2161462, "chapter_id": 4491, "verse_number": "६०", "content_sanskrit": "महोरस्को महास्कन्धो महाबाहुर्महाधनुः ।\nमहाबलो महावीर्यो महात्मा स महारथः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2161463, "chapter_id": 4491, "verse_number": "६१", "content_sanskrit": "शिष्यो मम सखा चैव प्रियोस्याहं प्रियश्च मे ।\nयुयुधानः सहायो मे प्रमथिष्यति कौरवम्॥\nसत्यकेन सहायेन प्रमथिष्याम्यहं कुरून्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2161464, "chapter_id": 4491, "verse_number": "६२", "content_sanskrit": "अस्मदर्थं च राजेन्द्र सन्नह्येद् यदि केशवः ।\nरामो वाऽप्यनिरुद्धो वा प्रद्युम्नो वा महारथः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2161465, "chapter_id": 4491, "verse_number": "६३", "content_sanskrit": "गदो वा सारणो वाऽपि साम्बो वा सह वृष्णिभिः ।\nसहायार्थं महाराज सङ्ग्रामोत्तममूर्धनि\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2161466, "chapter_id": 4491, "verse_number": "", "content_sanskrit": "तथाऽप्येनं नरव्याघ्रं शैनेयं सत्यविक्रमम् ।\nसाहाय्ये विनियोक्ष्यामि नास्ति मेऽन्यो हि तत्समः ॥६४।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2161467, "chapter_id": 4491, "verse_number": "समाप्तिः", "content_sanskrit": "इति द्वैतवने तात मामुवाच धनञ्जयः ।\nपरोक्षांस्त्वद्गुणांस्तथ्यान् कथयामास संसदि\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2161468, "chapter_id": 4491, "verse_number": "६६", "content_sanskrit": "तस्य त्वमेवं सङ्कल्पं न वृथा कर्तुमर्हसि ।\nधनञ्जयस्य वार्ष्णेय मम भीमस्य चोभयोः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2161469, "chapter_id": 4491, "verse_number": "६७", "content_sanskrit": "यच्चापि तीर्थं विचरन्नगच्छद् द्वारकां प्रति ।\nतत्राहमपि ते भक्तिमर्जुनं प्रति दृष्टवान्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2161470, "chapter_id": 4491, "verse_number": "६८", "content_sanskrit": "तत् ते सौहार्दमस्मासु यथा शैनेय लक्षितम् ।\nतथा त्वमस्मान् भजसे वर्तमानानुपप्लवे\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2161471, "chapter_id": 4491, "verse_number": "६९", "content_sanskrit": "सौहार्दस्य च भक्तस्य सख्यस्याचार्यकस्य च ।\nसम्भावनायाः पार्थस्य कुलीनत्वस्य माधव\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2161472, "chapter_id": 4491, "verse_number": "७०", "content_sanskrit": "सत्त्वस्य च महाबाहो अनुकम्पार्थमेव च ।\nअनुरूपं महेष्वास कर्म कर्तुं त्वमर्हसि\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2161473, "chapter_id": 4491, "verse_number": "७१", "content_sanskrit": "सुयोधनो हि सहसा गतो द्रोणेन दंसितः ।\nपूर्वमेव च यातास्ते कौरवाणां महारथाः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2161474, "chapter_id": 4491, "verse_number": "७२", "content_sanskrit": "सुमहान् निनदश्चैव श्रूयते विजयं प्रति ।\nस शैनेय जवेनाशु गन्तुमर्हसि माधव\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2161475, "chapter_id": 4491, "verse_number": "७३", "content_sanskrit": "भीमसेनो वयं चैव समस्ताः सहसैनिकाः ।\nद्रोणमावारयिष्यामो यदि त्वां प्रतियोत्स्यते\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2161476, "chapter_id": 4491, "verse_number": "७४", "content_sanskrit": "पश्य शैनेय सैन्यानि द्रवमाणानि संयुगे ।\nमहांश्च तुमुलः शब्दो दीर्यमाणा च भारती\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2161477, "chapter_id": 4491, "verse_number": "७५", "content_sanskrit": "महावातसमुद्धूतः समुद्र इव पर्वसु ।\nधार्तराष्ट्रबलं तात विक्षिप्तं सव्यसाचिना\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2161478, "chapter_id": 4491, "verse_number": "७६", "content_sanskrit": "रथैश्च परिधावद्भिर्मनुष्यगजवाजिभिः ।\nसैन्यं रजः समुद्भूतमेतत् सम्प्रति दृश्यते\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2161479, "chapter_id": 4491, "verse_number": "७७", "content_sanskrit": "संवृतः सिन्धुसौवीरैर्नखरप्रासयोधिभिः ।\nअत्यन्तापचितैः शूरैः फल्गुनः परवीरहा\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2161480, "chapter_id": 4491, "verse_number": "७८", "content_sanskrit": "नैतद् बलमसंवार्य शक्यो जेतुं जयद्रथः ।\nएते हि सैन्धवस्यार्थे सर्वे सन्त्यक्तजीविताः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2161481, "chapter_id": 4491, "verse_number": "७९", "content_sanskrit": "शरशक्तिध्वजवरं हयनागसमाकुलम् ।\nपश्यैतद् धार्तराष्ट्राणामनीकं च दुरासदम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2161482, "chapter_id": 4491, "verse_number": "८०", "content_sanskrit": "शृणु दुन्दुभिनिर्घोषं शङ्खशब्दांश्च पुष्कळान् ।\nसिंहनादरवांश्चैव रथनेमिस्वनांस्तथा\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2161483, "chapter_id": 4491, "verse_number": "८१", "content_sanskrit": "नागानां शृणु शब्दांश्च पत्तीनां च सहस्रशः ।\nसादिनां द्रवतां शब्दं शृणु कम्पयतां महीम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2161484, "chapter_id": 4491, "verse_number": "८२", "content_sanskrit": "पुरस्तात् सैन्धवानीकं द्रोणानीकस्य पृष्ठतः ।\nबहुत्वं हि नरव्याघ्र देवेन्द्रमपि पीडयेत्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2161485, "chapter_id": 4491, "verse_number": "८३", "content_sanskrit": "अपर्यन्ते बले मग्नः प्रजह्यादपि जीवितम् ।\nतस्मिंश्च निहते युद्धे कथं जीवेत मादृशः\nसर्वथा समनुप्राप्तः सकृच्छ्रं बत जीवितम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2161486, "chapter_id": 4491, "verse_number": "८४", "content_sanskrit": "अभ्रश्यामो गुडाकेशो दर्शनीयश्च पाण्डवः ।\nलघ्वस्त्रश्चित्रयोधी च प्रविष्टस्त्वत्र भारतीम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2161487, "chapter_id": 4491, "verse_number": "८५", "content_sanskrit": "सूर्योदये महाबाहुर्दिवसश्चातिवर्तते \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2161488, "chapter_id": 4491, "verse_number": "८६", "content_sanskrit": "तन्न जानामि वार्ष्णेय यदि जीवति वा न वा ।\nकुरूणां सुमहत् सैन्यं सागरप्रतिमं महत्\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2161489, "chapter_id": 4491, "verse_number": "८७", "content_sanskrit": "एक एव च बीभत्सुः प्रविष्टस्तत्र भारतीम् ।\nअविषह्याँ महाबाहुः सुरैरपि महामृधे\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2161490, "chapter_id": 4491, "verse_number": "८८", "content_sanskrit": "न च मे वर्तते बुद्धिरद्य युद्धे कथञ्चन ।\nद्रोणो हि रभसो युद्धे मम पीडयते बलम्\nप्रत्यक्षं ते महाबाहो यथा स चरति द्विजः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2161491, "chapter_id": 4491, "verse_number": "८९", "content_sanskrit": "युगपत् समवेतानां कार्याणां त्वं विचक्षणः ।\nमहार्थं लघुसंयुक्तं कर्तुमर्हसि माधव\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2161492, "chapter_id": 4491, "verse_number": "९०", "content_sanskrit": "तस्य मे सर्वकार्येषु कार्यमेतन्मतं सदा ।\nअर्जुनस्य परित्राणं कर्तव्यमिति संयुगे\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2161493, "chapter_id": 4491, "verse_number": "९१", "content_sanskrit": "नाहं शोचामि दाशार्हं गोप्तारं जगतः प्रभुम् \t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2161494, "chapter_id": 4491, "verse_number": "९२", "content_sanskrit": "स हि शक्तो रणे तात त्रीँल्लोकानपि सङ्गतान् ।\nविजेतुं पुरुषव्याघ्र सत्यमेतद् ब्रवीमि ते\nकिं पुनर्धार्तराष्ट्रस्य बलमेतत् सुदुर्बलम्\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2161495, "chapter_id": 4491, "verse_number": "", "content_sanskrit": "अर्जुनस्त्वेष वार्ष्णेय पीडितो बहुभिर्युधि ।\nप्रजह्यात् समरे प्राणान् तस्माद् विन्दामि कश्मलम्\t ।९३।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2161496, "chapter_id": 4491, "verse_number": "९४", "content_sanskrit": "तस्य त्वं पदवीं गच्छ गच्छेयुस्त्वादृशा रथाः ।\nतादृशस्येदृशे काले मादृशैरभिचोदिताः\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2161497, "chapter_id": 4491, "verse_number": "९५", "content_sanskrit": "सुहृदो वै सुहृत्कृत्ये परमास्थाय विक्रमम् ।\nसुहृदः पदमन्विच्छन् न व्यथेत कथञ्चन\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2161498, "chapter_id": 4491, "verse_number": "९६", "content_sanskrit": "ननु सत्यक वृष्णीनां द्वावेवातिरथौ स्मृतौ ।\nप्रद्युम्नश्च महाबाहुस्त्वं च सात्वत विश्रुतः\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2161499, "chapter_id": 4491, "verse_number": "९७", "content_sanskrit": "अस्त्रे नारायणसमः सङ्कर्षणसमो बले ।\nवीरतायां नरव्याघ्र धनञ्जयसमो ह्यसि\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2161500, "chapter_id": 4491, "verse_number": "९८", "content_sanskrit": "भीष्मद्रोणावतिक्रान्तं सर्वयुद्धविशारदम् ।\nनासाध्यं विद्यते लोके सात्यकेरिति माधव । भीष्मद्रोणावतिक्रान्तं सर्वशस्त्रविशारदम्॥\nत्वामद्य पुरुषव्याघ्र लोके सन्तः प्रचक्षते\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2161501, "chapter_id": 4491, "verse_number": "९९", "content_sanskrit": "सदेवासुरगन्धर्वान् सकिन्नरमहोरगान् ।\nयोधयेत् स जगत् सर्वं विजयेत रिपून् बहून्\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2161502, "chapter_id": 4491, "verse_number": "समाप्तिः", "content_sanskrit": "इति ब्रुवन्ति लोकेषु जनास्तव गुणान् सदा \t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2161503, "chapter_id": 4491, "verse_number": "१०१", "content_sanskrit": "समागमेषु जल्पन्ति पृथगेव च सर्वदा ।\nनासाध्यं विद्यते लोके सत्यकस्येति माधव\nतत् त्वां यदिह वक्ष्यामि तत् कुरुष्व महाबल\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2161504, "chapter_id": 4491, "verse_number": "१०२", "content_sanskrit": "सम्भावना हि पार्थस्य मम भीमस्य चोभयोः ।\nनान्यथा तन्महाबाहो सम्प्रकर्तुमिहार्हसि\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2161505, "chapter_id": 4491, "verse_number": "१०३", "content_sanskrit": "परित्यज्य प्रियान् प्राणान् रणे विचर वीरवत् ।\nनहि शैनेय दाशार्हा रणे रक्षन्ति जीवितम्\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2161506, "chapter_id": 4491, "verse_number": "१०४", "content_sanskrit": "अयुद्धमनवस्थानं सङ्ग्रामे च पलायनम् ।\nएष भीरुगतो मार्गो नैव दाशार्हसेवितः\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2161507, "chapter_id": 4491, "verse_number": "१०५", "content_sanskrit": "तवार्जुनो गुरुस्तात धर्मात्मा शिनिपुङ्गव ।\nवासुदेवो गुरुश्चैव अर्जुनस्य तवैव च\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2161508, "chapter_id": 4491, "verse_number": "१०६", "content_sanskrit": "कारणद्वयमेतद्धि जानंस्त्वामहमब्रुवम् ।\nमाऽवमंस्था वचो मेऽद्य गुरोस्तव गुरुर्ह्यहम्\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2161509, "chapter_id": 4491, "verse_number": "१०७", "content_sanskrit": "वासुदेवमतं चैतन्मम चैवार्जुनस्य च ।\nसत्यमेतन्मयोक्तं ते याहि यत्र धनञ्जयः\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2161510, "chapter_id": 4491, "verse_number": "१०८", "content_sanskrit": "एतद् वचनमाज्ञाय मम सत्यपराक्रम ।\nप्रविशैतद् बलं तात धार्तराष्ट्रस्य दुर्मतेः\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2161511, "chapter_id": 4491, "verse_number": "१०९", "content_sanskrit": "प्रविश्य च यथान्यायं सङ्गम्य च महारथैः ।\nयथार्हमात्मनः कर्म रणे सत्यक दर्शय\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2161512, "chapter_id": 4491, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि षण्णवतितमोऽध्यायः ॥ ९६ ॥\nजयद्रथवधपर्वणि विंशोऽध्यायः ॥ २० ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}]