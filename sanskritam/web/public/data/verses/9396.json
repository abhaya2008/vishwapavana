[{"id": 5000396000, "chapter_id": 9396, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे सप्तपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000396001, "chapter_id": 9396, "verse_number": "५-५७-१", "content_sanskrit": "आप्लुत्य च महावेगः पक्षवानिव पर्वतः।\nभुजङ्गयक्षगन्धर्वप्रबुद्धकमलोत्पलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000396002, "chapter_id": 9396, "verse_number": "५-५७-२", "content_sanskrit": "स चन्द्रकुमुदं रम्यं सार्ककारण्डवं शुभम्।\nतिष्यश्रवणकादम्बमभ्रशैवलशाद्वलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000396003, "chapter_id": 9396, "verse_number": "५-५७-३", "content_sanskrit": "पुनर्वसुमहामीनं लोहिताङ्गमहाग्रहम्।\nऐरावतमहाद्वीपं स्वातीहंसविलासितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000396004, "chapter_id": 9396, "verse_number": "५-५७-४", "content_sanskrit": "वातसंघातजालोर्मिचन्द्रांशुशिशिराम्बुमत्।\nहनूमानपरिश्रान्तः पुप्लुवे गगनार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000396005, "chapter_id": 9396, "verse_number": "५-५७-५", "content_sanskrit": "ग्रसमान इवाकाशं ताराधिपमिवोल्लिखन्।\nहरन्निव सनक्षत्रं गगनं सार्कमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000396006, "chapter_id": 9396, "verse_number": "५-५७-६", "content_sanskrit": "अपारमपरिश्रान्तश्चाम्बुधिं समगाहत।\nहनूमान् मेघजालानि विकर्षन्निव गच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000396007, "chapter_id": 9396, "verse_number": "५-५७-७", "content_sanskrit": "पाण्डुरारुणवर्णानि नीलमाञ्जिष्ठकानि च।\nहरितारुणवर्णानि महाभ्राणि चकाशिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000396008, "chapter_id": 9396, "verse_number": "५-५७-८", "content_sanskrit": "प्रविशन्नभ्रजालानि निष्क्रमंश्च पुनः पुनः।\nप्रकाशश्चाप्रकाशश्च चन्द्रमा इव दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000396009, "chapter_id": 9396, "verse_number": "५-५७-९", "content_sanskrit": "विविधाभ्रघनापन्नगोचरो धवलाम्बरः।\nदृश्यादृश्यतनुर्वीरस्तथा चन्द्रायतेऽम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000396010, "chapter_id": 9396, "verse_number": "५-५७-१०", "content_sanskrit": "तार्क्ष््यायमाणो गगने स बभौ वायुनन्दनः।\nदारयन् मेघवृन्दानि निष्पतंश्च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000396011, "chapter_id": 9396, "verse_number": "५-५७-११", "content_sanskrit": "नदन् नादेन महता मेघस्वनमहास्वनः।\nप्रवरान् राक्षसान् हत्वा नाम विश्राव्य चात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000396012, "chapter_id": 9396, "verse_number": "५-५७-१२", "content_sanskrit": "आकुलां नगरीं कृत्वा व्यथयित्वा च रावणम्।\nअर्दयित्वा महावीरान् वैदेहीमभिवाद्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000396013, "chapter_id": 9396, "verse_number": "५-५७-१३", "content_sanskrit": "आजगाम महातेजाः पुनर्मध्येन सागरम्।\nपर्वतेन्द्रं सुनाभं च समुपस्पृश्य वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000396014, "chapter_id": 9396, "verse_number": "५-५७-१४", "content_sanskrit": "ज्यामुक्त इव नाराचो महावेगोऽभ्युपागमत्।\nस किंचिदारात् सम्प्राप्तः समालोक्य महागिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000396015, "chapter_id": 9396, "verse_number": "५-५७-१५", "content_sanskrit": "महेन्द्रं मेघसंकाशं ननाद स महाकपिः।\nस पूरयामास कपिर्दिशो दश समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000396016, "chapter_id": 9396, "verse_number": "५-५७-१६", "content_sanskrit": "नदन् नादेन महता मेघस्वनमहास्वनः।\nस तं देशमनुप्राप्तः सुहृद्दर्शनलालसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000396017, "chapter_id": 9396, "verse_number": "५-५७-१७", "content_sanskrit": "ननाद सुमहानादं लाङ्गूलं चाप्यकम्पयत्।\nतस्य नानद्यमानस्य सुपर्णाचरिते पथि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000396018, "chapter_id": 9396, "verse_number": "५-५७-१८", "content_sanskrit": "फलतीवास्य घोषेण गगनं सार्कमण्डलम्।\nये तु तत्रोत्तरे कूले समुद्रस्य महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000396019, "chapter_id": 9396, "verse_number": "५-५७-१९", "content_sanskrit": "पूर्वं संविष्ठिताः शूरा वायुपुत्रदिदृक्षवः।\nमहतो वायुनुन्नस्य तोयदस्येव निःस्वनम्।\nशुश्रुवुस्ते तदा घोषमूरुवेगं हनूमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000396020, "chapter_id": 9396, "verse_number": "५-५७-२०", "content_sanskrit": "ते दीनमनसः सर्वे शुश्रुवुः काननौकसः।\nवानरेन्द्रस्य निर्घोषं पर्जन्यनिनदोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000396021, "chapter_id": 9396, "verse_number": "५-५७-२१", "content_sanskrit": "निशम्य नदतो नादं वानरास्ते समन्ततः।\nबभूवुरुत्सुकाः सर्वे सुहृद्दर्शनकाङ्क्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000396022, "chapter_id": 9396, "verse_number": "५-५७-२२", "content_sanskrit": "जाम्बवान् स हरिश्रेष्ठः प्रीतिसंहृष्टमानसः।\nउपामन्त्र्य हरीन् सर्वानिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000396023, "chapter_id": 9396, "verse_number": "५-५७-२३", "content_sanskrit": "सर्वथा कृतकार्योऽसौ हनूमान् नात्र संशयः।\nन ह्यस्याकृतकार्यस्य नाद एवंविधो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000396024, "chapter_id": 9396, "verse_number": "५-५७-२४", "content_sanskrit": "तस्य बाहूरुवेगं च निनादं च महात्मनः।\nनिशम्य हरयो हृष्टाः समुत्पेतुर्यतस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000396025, "chapter_id": 9396, "verse_number": "५-५७-२५", "content_sanskrit": "ते नगाग्रान्नगाग्राणि शिखराच्छिखराणि च।\nप्रहृष्टाः समपद्यन्त हनूमन्तं दिदृक्षवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000396026, "chapter_id": 9396, "verse_number": "५-५७-२६", "content_sanskrit": "ते प्रीताः पादपाग्रेषु गृह्य शाखामवस्थिताः।\nवासांसि च प्रकाशानि समाविध्यन्त वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000396027, "chapter_id": 9396, "verse_number": "५-५७-२७", "content_sanskrit": "गिरिगह्वरसंलीनो यथा गर्जति मारुतः।\nएवं जगर्ज बलवान् हनूमान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000396028, "chapter_id": 9396, "verse_number": "५-५७-२८", "content_sanskrit": "तमभ्रघनसंकाशमापतन्तं महाकपिम्।\nदृष्ट्वा ते वानराः सर्वे तस्थुः प्राञ्जलयस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000396029, "chapter_id": 9396, "verse_number": "५-५७-२९", "content_sanskrit": "ततस्तु वेगवान् वीरो गिरेर्गिरिनिभः कपिः।\nनिपपात गिरेस्तस्य शिखरे पादपाकुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000396030, "chapter_id": 9396, "verse_number": "५-५७-३०", "content_sanskrit": "हर्षेणापूर्यमाणोऽसौ रम्ये पर्वतनिर्झरे।\nछिन्नपक्ष इवाकाशात् पपात धरणीधरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000396031, "chapter_id": 9396, "verse_number": "५-५७-३१", "content_sanskrit": "ततस्ते प्रीतमनसः सर्वे वानरपुङ्गवाः।\nहनूमन्तं महात्मानं परिवार्योपतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000396032, "chapter_id": 9396, "verse_number": "५-५७-३२", "content_sanskrit": "परिवार्य च ते सर्वे परां प्रीतिमुपागताः।\nप्रहृष्टवदनाः सर्वे तमागतमुपागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000396033, "chapter_id": 9396, "verse_number": "५-५७-३३", "content_sanskrit": "उपायनानि चादाय मूलानि च फलानि च।\nप्रत्यर्चयन् हरिश्रेष्ठं हरयो मारुतात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000396034, "chapter_id": 9396, "verse_number": "५-५७-३४", "content_sanskrit": "विनेदुर्मुदिताः केचित् केचित् किलकिलां तथा।\nहृष्टाः पादपशाखाश्च आनिन्युर्वानरर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000396035, "chapter_id": 9396, "verse_number": "५-५७-३५", "content_sanskrit": "हनूमांस्तु गुरून् वृद्धाञ्जाम्बवत्प्रमुखांस्तदा।\nकुमारमङ्गदं चैव सोऽवन्दत महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000396036, "chapter_id": 9396, "verse_number": "५-५७-३६", "content_sanskrit": "स ताभ्यां पूजितः पूज्यः कपिभिश्च प्रसादितः।\nदृष्टा देवीति विक्रान्तः संक्षेपेण न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000396037, "chapter_id": 9396, "verse_number": "५-५७-३७", "content_sanskrit": "निषसाद च हस्तेन गृहीत्वा वालिनः सुतम्।\nरमणीये वनोद्देशे महेन्द्रस्य गिरेस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000396038, "chapter_id": 9396, "verse_number": "५-५७-३८", "content_sanskrit": "हनूमानब्रवीत् पृष्टस्तदा तान् वानरर्षभान्।\nअशोकवनिकासंस्था दृष्टा सा जनकात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000396039, "chapter_id": 9396, "verse_number": "५-५७-३९", "content_sanskrit": "रक्ष्यमाणा सुघोराभी राक्षसीभिरनिन्दिता।\nएकवेणीधरा बाला रामदर्शनलालसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000396040, "chapter_id": 9396, "verse_number": "५-५७-४०", "content_sanskrit": "उपवासपरिश्रान्ता मलिना जटिला कृशा।\nततो दृष्टेति वचनं महार्थममृतोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000396041, "chapter_id": 9396, "verse_number": "५-५७-४१", "content_sanskrit": "निशम्य मारुतेः सर्वे मुदिता वानराभवन्।\nक्ष्वेडन्त्यन्ये नदन्त्यन्ये गर्जन्त्यन्ये महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000396042, "chapter_id": 9396, "verse_number": "५-५७-४२", "content_sanskrit": "चक्रुः किलकिलामन्ये प्रतिगर्जन्ति चापरे।\nकेचिदुच्छ्रितलाङ्गूलाः प्रहृष्टाः कपिकुञ्जराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000396043, "chapter_id": 9396, "verse_number": "५-५७-४३", "content_sanskrit": "आयताञ्चितदीर्घाणि लाङ्गूलानि प्रविव्यधुः।\nअपरे तु हनूमन्तं श्रीमन्तं वानरोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000396044, "chapter_id": 9396, "verse_number": "५-५७-४४", "content_sanskrit": "आप्लुत्य गिरिशृङ्गेषु संस्पृशन्ति स्म हर्षिताः।\nउक्तवाक्यं हनूमन्तमङ्गदस्तु तदाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000396045, "chapter_id": 9396, "verse_number": "५-५७-४५", "content_sanskrit": "सर्वेषां हरिवीराणां मध्ये वाचमनुत्तमाम्।\nसत्त्वे वीर्ये न ते कश्चित् समो वानर विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000396046, "chapter_id": 9396, "verse_number": "५-५७-४६", "content_sanskrit": "यदवप्लुत्य विस्तीर्णं सागरं पुनरागतः।\nजीवितस्य प्रदाता नस्त्वमेको वानरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000396047, "chapter_id": 9396, "verse_number": "५-५७-४७", "content_sanskrit": "त्वत्प्रसादात् समेष्यामः सिद्धार्था राघवेण ह।\nअहो स्वामिनि ते भक्तिरहो वीर्यमहो धृतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000396048, "chapter_id": 9396, "verse_number": "५-५७-४८", "content_sanskrit": "दिष्ट्या दृष्टा त्वया देवी रामपत्नी यशस्विनी।\nदिष्ट्या त्यक्ष्यति काकुत्स्थः शोकं सीतावियोगजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000396049, "chapter_id": 9396, "verse_number": "५-५७-४९", "content_sanskrit": "ततोऽङ्गदं हनूमन्तं जाम्बवन्तं च वानराः।\nपरिवार्य प्रमुदिता भेजिरे विपुलाः शिलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000396050, "chapter_id": 9396, "verse_number": "५-५७-५०", "content_sanskrit": "उपविष्टा गिरेस्तस्य शिलासु विपुलासु ते।\nश्रोतुकामाः समुद्रस्य लङ्घनं वानरोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000396051, "chapter_id": 9396, "verse_number": "५-५७-५१", "content_sanskrit": "दर्शनं चापि लङ्कायाः सीताया रावणस्य च।\nतस्थुः प्राञ्जलयः सर्वे हनूमद्वदनोन्मुखाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000396052, "chapter_id": 9396, "verse_number": "५-५७-५२", "content_sanskrit": "तस्थौ तत्राङ्गदः श्रीमान् वानरैर्बहुभिर्वृतः।\nउपास्यमानो विबुधैर्दिवि देवपतिर्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000396053, "chapter_id": 9396, "verse_number": "५-५७-५३", "content_sanskrit": "हनूमता कीर्तिमता यशस्विना\nतथाङ्गदेनाङ्गदनद्धबाहुना।\nमुदा तदाध्यासितमुन्नतं मह-\nन्महीधराग्रं ज्वलितं श्रियाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000396054, "chapter_id": 9396, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे सप्तपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]