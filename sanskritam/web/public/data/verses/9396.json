[{"id": 40022499, "chapter_id": 9396, "verse_number": "1", "content_sanskrit": "पुरा त्रेतायुगे राम बभूव बहुविस्तरम् । समन्ताद्योजनशतं विमृगं पक्षिवर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022500, "chapter_id": 9396, "verse_number": "2", "content_sanskrit": "तस्मिन्निर्मानुषे ऽरण्ये कुर्वाणस्तप उत्तमम् । अहमाक्रमितुं सौम्य तदरण्यमुपागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022501, "chapter_id": 9396, "verse_number": "3", "content_sanskrit": "तस्य रूपमरण्यस्य निर्देष्टुं न शशाक ह । फलमूलैः सुखास्वादैर्बहुरूपैश्च पादपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022502, "chapter_id": 9396, "verse_number": "4", "content_sanskrit": "तस्यारण्यस्य मध्ये तु सरो योजनमायतम् । हंसकारण्डवाकीर्णं चक्रवाकोपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022503, "chapter_id": 9396, "verse_number": "5", "content_sanskrit": "पद्मोत्पलसमाकीर्णं समतिक्रान्तशैवलम् । तदाश्चर्यमिवात्यर्थं सुखास्वादमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022504, "chapter_id": 9396, "verse_number": "6", "content_sanskrit": "अरजस्कं तथा ऽक्षोभ्यं श्रीमत्पक्षिगणायुतम् । समीपे तस्य सरसो महदद्भुतमाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022505, "chapter_id": 9396, "verse_number": "7", "content_sanskrit": "पुराणं पुण्यमत्यर्थं तपस्विजनवर्जितम् । तत्राहमवसं रात्रिं नैदाघीं पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022506, "chapter_id": 9396, "verse_number": "8", "content_sanskrit": "प्रभाते काल्यमुत्थाय सरस्तदुपचक्रमे । अथापश्यं शवं तत्र सुपुष्टमजरं क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022507, "chapter_id": 9396, "verse_number": "9", "content_sanskrit": "पङ्किभेदेन पुष्टाङ्गं समाश्रितसरोवरम् । तिष्ठन्तं परया लक्ष्म्या तस्मिंस्तोयाशये नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022508, "chapter_id": 9396, "verse_number": "10", "content_sanskrit": "तमर्थं चिन्तयानो ऽहं मुहूर्तं तत्र राघव । उषितो ऽस्मि सरस्तीरे किन्न्विदं स्यादिति प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022509, "chapter_id": 9396, "verse_number": "11", "content_sanskrit": "अथापश्यं मुहूर्तेन दिव्यमद्भुतदर्शनम् । विमानं परमोदारं हंसयुक्तं मनोजवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022510, "chapter_id": 9396, "verse_number": "12", "content_sanskrit": "अत्यर्थं स्वर्गिणं त विमाने रघुनन्दन । उपास्ते ऽप्सरसां वीर सहस्रं दिव्यभूषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022511, "chapter_id": 9396, "verse_number": "13", "content_sanskrit": "गायन्ति दिव्यगेयानि वादयन्ति तथा ऽपराः । क्ष्वेलयन्ति तथा चान्या नृत्यन्ति च तथा ऽपराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022512, "chapter_id": 9396, "verse_number": "14", "content_sanskrit": "अपराश्चन्द्ररश्म्याभैर्हेमदण्डैश्च चामरैः । दोधूयुर्वदनं तस्य पुण्डरीकनिभेक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022513, "chapter_id": 9396, "verse_number": "15", "content_sanskrit": "ततः सिंहासनं त्यक्त्वा मेरुकूटमिवांशुमान् । पश्यतो मे तदा राम विमानादवरुह्य च । तं शवं भक्षयामास स स्वर्गी रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022514, "chapter_id": 9396, "verse_number": "16", "content_sanskrit": "तथा भुक्त्वा यथाकामं मांसं बहु सुपीवरम् । अवतीर्य सरः स्वर्गी संस्प्रष्टुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022515, "chapter_id": 9396, "verse_number": "17", "content_sanskrit": "उपस्पृश्य यथान्यायं स स्वर्गी रघुपुङ्गव । आरोढुमुपचक्राम विमानवरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022516, "chapter_id": 9396, "verse_number": "18", "content_sanskrit": "तमहं देवसङ्काशमारोहन्तमुदीक्ष्य वै । अथाहमब्रुवं वाक्यं स्वर्गिणं पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022517, "chapter_id": 9396, "verse_number": "19", "content_sanskrit": "को भवान्देवसङ्काश आहारश्च विगर्हितः । त्वयेदं भुज्यते सौम्य किमर्थं वक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022518, "chapter_id": 9396, "verse_number": "20", "content_sanskrit": "कस्य स्यादीदृशो भाव आहारो देवसम्मतः । आश्चर्यं वर्तते सौम्य श्रोतुमिच्छामि तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022519, "chapter_id": 9396, "verse_number": "21", "content_sanskrit": "नाहमौपयिकं मन्ये तव भक्ष्यमिदं शवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022520, "chapter_id": 9396, "verse_number": "22", "content_sanskrit": "इत्येवमुक्तः स नरेन्द्र नाकी कौतूहलात्सूनृतया गिरा च । श्रुत्वा च वाक्यं मम सर्वमेतत्सर्वं तथा चाकथयन्ममेति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]