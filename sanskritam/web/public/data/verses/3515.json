[{"id": 2116806, "chapter_id": 3515, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2116807, "chapter_id": 3515, "verse_number": "१", "content_sanskrit": "तत आहूय पाञ्चालो राजपुत्रं युधिष्ठिरम् ।\nपरिग्रहेण ब्राह्मेण परिगृह्य महाद्युतिः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2116808, "chapter_id": 3515, "verse_number": "२", "content_sanskrit": "पर्यपृच्छददीनात्मा कुन्तीपुत्रं युधिष्ठिरम् ।\nकथं जानीम भवतः क्षत्रियान् ब्राह्मणानुत \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2116809, "chapter_id": 3515, "verse_number": "३", "content_sanskrit": "वैश्यान् वा गुणसम्पन्नानुत वा शूद्रयोनिजान् ।\nमायामास्थाय वा सिद्धांश्चरतः सर्वतोदिशम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2116810, "chapter_id": 3515, "verse_number": "४", "content_sanskrit": "कृष्णाहेतोरनुप्राप्तान् देवसन्दर्शनार्थिनः ।\nब्रवीतु नो भवान् सत्यं सन्देहोऽत्र च नोऽबलान् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2116811, "chapter_id": 3515, "verse_number": "५", "content_sanskrit": "अपि नः संशयस्यान्ते मनस्तुष्टिरिहाविशेत् ।\nअपि नो भागधेयानि शुभानि स्युः परन्तप \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2116812, "chapter_id": 3515, "verse_number": "६", "content_sanskrit": "कामयेयं ब्रूहि सत्यं सत्यं राजसु शोभते ।\nइष्टापूर्ते न च तथाऽवक्तव्यमनृतं भवेत् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2116813, "chapter_id": 3515, "verse_number": "७", "content_sanskrit": "श्रुत्वा ह्यमरसङ्काश तव वाक्यमरिन्दम ।\nध्रुवं विवाहकरणमास्थास्यामि विधानतः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2116814, "chapter_id": 3515, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2116815, "chapter_id": 3515, "verse_number": "८", "content_sanskrit": "मा राजन् विमना भूस्त्वं पाञ्चाल प्रीतिरस्तु ते ।\nईप्सितस्ते ध्रुवः कामः संवृत्तोऽयमसंशयम् \t॥ ८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2116816, "chapter_id": 3515, "verse_number": "९", "content_sanskrit": "वयं हि क्षत्रिया राजन् पाण्डोः पुत्रा महात्मनः ।\nज्येष्ठं मां विद्धि कौन्तेयं भीमसेनार्जुनाविमौ \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2116817, "chapter_id": 3515, "verse_number": "१०", "content_sanskrit": "आभ्यां तव सुता राजन् निर्जिता राजसंसदि ।\nइमे च ते वयं राजन् यत्र कृष्णा प्रतिष्ठिता \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2116818, "chapter_id": 3515, "verse_number": "११", "content_sanskrit": "व्येतु ते मानसं दुःखं क्षत्रियाः स्मो नराधिप ।\nपद्मिनीव सुतेयं ते ह्रदादन्यह्रदं गता \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2116819, "chapter_id": 3515, "verse_number": "समाप्तिः", "content_sanskrit": "इति तथ्यं महाराज सर्वमेतद् ब्रवीमि ते ।\nभवान् हि गुरुरस्माकं परमं च परायणम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2116820, "chapter_id": 3515, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2116821, "chapter_id": 3515, "verse_number": "१३", "content_sanskrit": "ततः स द्रुपदो राजा हर्षव्याकुललोचनः ।\nप्रतिवक्तुं न शक्तोऽभूद् धर्मसूनुं तदाऽनघम् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2116822, "chapter_id": 3515, "verse_number": "१४", "content_sanskrit": "यत्नेन तु स तं हर्षं सन्निगृह्य परन्तपः ।\nअनुरूपं ततो राजा प्रत्युवाच युधिष्ठिरम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2116823, "chapter_id": 3515, "verse_number": "१५", "content_sanskrit": "पर्यपृच्छददीनात्मा यथा ते प्रद्रुताः पुरा ।\nतथाऽस्मै सर्वमाचष्ट आनुपूर्व्येण पाण्डवः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2116824, "chapter_id": 3515, "verse_number": "१६", "content_sanskrit": "तच्छ्रुत्वा द्रुपदो राजा कुन्तीपुत्रस्य भाषितम् ।\nविगर्हयामास तदा धृतराष्ट्रं नरेश्वरम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2116825, "chapter_id": 3515, "verse_number": "१७", "content_sanskrit": "आश्वासयामास तदा कुन्तीपुत्रं युधिष्ठिरम् ।\nप्रतिजज्ञे स राज्याय द्रुपदो ददतां वरः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2116826, "chapter_id": 3515, "verse_number": "१८", "content_sanskrit": "ततः कुन्ती च कृष्णा च भीमसेनार्जुनावपि ।\nयमौ च राज्ञा सन्दिष्टा विविशुर्भवनं महत् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2116827, "chapter_id": 3515, "verse_number": "१९", "content_sanskrit": "तत्र ते न्यवसन् राजन् यज्ञसेनेन पूजिताः ।\nपर्याश्वस्तांस्तदा राजा सह पुत्रैरुवाच तान् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2116828, "chapter_id": 3515, "verse_number": "२०", "content_sanskrit": "गृह्णातु विधिवत् पाणिमद्यैव कुरुनन्दनः ।\nपुण्येऽहनि महाबाहुरर्जुनः कुरुतां क्षणम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2116829, "chapter_id": 3515, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2116830, "chapter_id": 3515, "verse_number": "२१", "content_sanskrit": "ततस्तमब्रवीद् राजा धर्मपुत्रो युधिष्ठिरः ।\nममापि दारसम्बन्धः कार्यस्तावद् विशाम्पते ।\nतस्मात् पूर्वं मया कार्यं तद् भवाननुमन्यताम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2116831, "chapter_id": 3515, "verse_number": "", "content_sanskrit": "द्रुपदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2116832, "chapter_id": 3515, "verse_number": "२२", "content_sanskrit": "भवान् वा विधिवत् पाणिं गुह्णातु दुहितुर्मम ।\nयस्य वा मन्यसे वीर तस्य कृष्णामुपादिश \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2116833, "chapter_id": 3515, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2116834, "chapter_id": 3515, "verse_number": "२३", "content_sanskrit": "सर्वेषां द्रौपदी राजन् महिषी नो भविष्यति ।\nएवं हि व्याहृतं पूर्वं मम मात्रा विशाम्पते \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2116835, "chapter_id": 3515, "verse_number": "२४", "content_sanskrit": "अहं चाप्यनिविष्टो वै भीमसेनश्च पाण्डवः ।\nपार्थेन विजिता चैषा रत्नभूता च ते सुता \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2116836, "chapter_id": 3515, "verse_number": "२५", "content_sanskrit": "एष नः समयो राजन् रत्नस्य सहभोजनम् ।\nन चैनं हातुमिच्छामः समयं राजसत्तम \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2116837, "chapter_id": 3515, "verse_number": "२६", "content_sanskrit": "अक्रमेण निवेशे च धर्मलोपो महान् भवेत् ।\nसर्वेषां धर्मतः कृष्णा महिषी नो भविष्यति ।\nआनुपूर्व्येण गृह्णन्तु सर्वेऽग्नौ ज्वलिते करम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2116838, "chapter_id": 3515, "verse_number": "", "content_sanskrit": "द्रुपदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2116839, "chapter_id": 3515, "verse_number": "२७", "content_sanskrit": "एकस्य बह्व्यो विहिता महिष्यः कुरुनन्दन ।\nनैकस्या बहवः पुंसो विधीयन्ते कदाचन \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2116840, "chapter_id": 3515, "verse_number": "२८", "content_sanskrit": "न चाप्याचरितः पूर्वैरयं धर्मो महात्मभिः ।\nनच धर्मो ह्यनेकस्थश्चरितव्यः सनातनः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2116841, "chapter_id": 3515, "verse_number": "२९", "content_sanskrit": "सोऽयं न लोके वेदे वा जातु धर्मः प्रशस्यते ।\nलोकवेदविरुद्धं च नाधर्मं धार्मिकः शुचिः ।\nकर्तुमर्हसि कौन्तेय कस्मात् ते बुद्धिरीदृशी\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2116842, "chapter_id": 3515, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2116843, "chapter_id": 3515, "verse_number": "३०", "content_sanskrit": "सूक्ष्मो धर्मो महाराज नास्य विद्मो गतिं वयम् ।\nलोकवेदाविरुद्धोऽयं धर्मो धर्मभृतां वर \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2116844, "chapter_id": 3515, "verse_number": "३१", "content_sanskrit": "सर्वेषामानुपूर्व्येण यातं तैरनुयामहे ।\nन मे वागनृतं प्राह नाधर्मे धीयते मतिः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2116845, "chapter_id": 3515, "verse_number": "३२", "content_sanskrit": "एवं चैव वदत्यम्बा ममापि च मनोगतम् ।\nआश्रमेषु विनिर्दिष्टाद् व्यासादेतन्मया श्रुतम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2116846, "chapter_id": 3515, "verse_number": "३३", "content_sanskrit": "धर्म एष ध्रुवो राजन् यस्मादेवं करोम्यहम् ।\nमा च तत्र विशङ्का भून्न ह्यधर्मे मतिर्मम \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2116847, "chapter_id": 3515, "verse_number": "", "content_sanskrit": "द्रुपदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2116848, "chapter_id": 3515, "verse_number": "३४", "content_sanskrit": "त्वं च कुन्ती च कौन्तेय धृष्टद्युम्नश्च मे सुतः ।\nकथयन्त्विह कर्तव्यं श्वः काल्ये करवामहे \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2116849, "chapter_id": 3515, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2116850, "chapter_id": 3515, "verse_number": "३५", "content_sanskrit": "ते समेत्य ततः सर्वे कथयन्ति स्म भारत ।\nअथ द्वैपायनो राजन्नाजगाम यदृच्छया \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2116851, "chapter_id": 3515, "verse_number": "१९४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुर्नवत्यधिकशततमोऽध्यायः ॥१९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2116852, "chapter_id": 3515, "verse_number": "३", "content_sanskrit": "॥ इति वैवाहिकपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2116853, "chapter_id": 3515, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]