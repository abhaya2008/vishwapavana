[{"id": 2003076, "chapter_id": 1064, "verse_number": "१-६५-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2003077, "chapter_id": 1064, "verse_number": "१-६५-१", "content_sanskrit": "य एते कीर्तिता ब्रह्मन्ये चान्ये नानुकीर्तिताः।\nसम्यक्ताञ्श्रोतुमिच्छामिराज्ञश्चान्यान्सहस्रशः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2003078, "chapter_id": 1064, "verse_number": "१-६५-२", "content_sanskrit": "यदर्थमिह संभूता देवकल्पा महारथाः।\nभुवि तन्मे महाभाग सम्यगाख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2003079, "chapter_id": 1064, "verse_number": "१-६५-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2003080, "chapter_id": 1064, "verse_number": "१-६५-३", "content_sanskrit": "रहस्यं खल्विदं राजन्देवानामिति नः श्रुतम्।\nतत्तु ते कथयिष्यामि नमस्कृत्वा स्वयंभुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2003081, "chapter_id": 1064, "verse_number": "१-६५-४", "content_sanskrit": "त्रिःसप्तकृत्वः पृथिवीं कृत्वा निःक्षित्रयां पुरा।\nजामदग्न्यस्तपस्तेपे महेन्द्रे पर्वतोत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2003082, "chapter_id": 1064, "verse_number": "१-६५-५", "content_sanskrit": "तदा निःक्षत्रिये लोके भार्गवेण कृते सति।\nब्राह्मणान्क्षत्रिया राजन्सुतार्थिन्योऽभिचक्रमुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2003083, "chapter_id": 1064, "verse_number": "१-६५-६", "content_sanskrit": "ताभिः सह समापेतुर्ब्राह्मणाः संशितव्रताः।\nऋतावृतौ नरव्याघ्र न कामान्नानृतौ तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2003084, "chapter_id": 1064, "verse_number": "१-६५-७", "content_sanskrit": "तेभ्यश्च तेभिरे गर्भं क्षत्रियास्ताः सहस्रशः।\nततः सुषुविरे राजन्क्षत्रियान्वीर्यवत्तरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2003085, "chapter_id": 1064, "verse_number": "१-६५-८", "content_sanskrit": "कुमारांश्च कुमारीश्च पुनः क्षत्राभिवृद्धये।\nएवं तद्ब्राह्मणैः क्षत्रं क्षत्रियासु तपस्विभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2003086, "chapter_id": 1064, "verse_number": "१-६५-९", "content_sanskrit": "जातं वृद्धं च धर्मेण सुदीर्गेणायुषान्वितम्।\nचत्वारोऽपि ततो वर्णा बभूवुर्ब्राह्मणोत्तराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2003087, "chapter_id": 1064, "verse_number": "१-६५-१०", "content_sanskrit": "अभ्यगच्छन्नृतौ नारीं न कामान्नानृतौ तथा।\nतथैवान्यानि भूतानि तिर्यग्योनिगतान्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2003088, "chapter_id": 1064, "verse_number": "१-६५-११", "content_sanskrit": "ऋतौ दारांश्च गच्छन्ति तत्तथा भरतर्षभ।\nततोऽवर्धन्त धर्मेण सहस्रशतजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2003089, "chapter_id": 1064, "verse_number": "१-६५-१२", "content_sanskrit": "ताः प्रजाः पृथिवीपाल धर्मव्रतपरायणाः।\nआधिभिर्व्याधिभिश्चैव विमुक्ताः सर्वशो नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2003090, "chapter_id": 1064, "verse_number": "१-६५-१३", "content_sanskrit": "अथेमां सागरोपान्तां गां गजेन्द्रगताखिलाम्।\nअध्यतिष्ठत्पुनः क्षत्रं सशैलवनपत्तनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2003091, "chapter_id": 1064, "verse_number": "१-६५-१४", "content_sanskrit": "प्रशासति पुनः क्षत्रे धर्मेणेमां वसुन्धराम्।\nब्राह्मणाद्यास्ततो वर्णा लेभिरे मुदमुत्तमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2003092, "chapter_id": 1064, "verse_number": "१-६५-१५", "content_sanskrit": "कामक्रोधोद्भवान्दोषान्निरस्य च नराधिपाः।\nधर्मेण दण्डं दण्डेषु प्रणयन्तोऽन्वपालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2003093, "chapter_id": 1064, "verse_number": "१-६५-१६", "content_sanskrit": "तथा धर्मपरे क्षत्रे सहस्राक्षः शतक्रतुः।\nस्वादु देशे च काले च ववर्षाप्याययन्प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2003094, "chapter_id": 1064, "verse_number": "१-६५-१७", "content_sanskrit": "न बाल एव म्रियते तदा कश्चिज्जनाधिप।\nन च स्त्रियं प्रजानाति कश्चिदप्राप्तयौवनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2003095, "chapter_id": 1064, "verse_number": "१-६५-१८", "content_sanskrit": "एवमायुष्मतीभिस्तु प्रजाभिर्भरतर्षभ।\nइयं सागरपर्यन्ता ससापूर्यत मेदिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2003096, "chapter_id": 1064, "verse_number": "१-६५-१९", "content_sanskrit": "ईजिरे च महायज्ञैः क्षत्रिया बहुदक्षिणैः।\nसाङ्गोपनिषदान्वेदान्विप्राश्चाधीयते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2003097, "chapter_id": 1064, "verse_number": "१-६५-२०", "content_sanskrit": "न च विक्रीणते ब्र्हम ब्राह्मणाश्च तदा नृप।\nन च शूद्रसमभ्याशे वेदानुच्चारयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2003098, "chapter_id": 1064, "verse_number": "१-६५-२१", "content_sanskrit": "कारयन्तः कृषिं गोभिस्तथा वैश्याः क्षिताविह।\nयुञ्जते धुरि नो गाश्च कृशाङ्गांश्चाप्यजीवयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2003099, "chapter_id": 1064, "verse_number": "१-६५-२२", "content_sanskrit": "फेनपांश्च तथा वत्सान्न दुहन्ति स्म मानवाः।\nन कूटमानैर्वणिजः पण्यं विक्रीणते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2003100, "chapter_id": 1064, "verse_number": "१-६५-२३", "content_sanskrit": "कर्माणि च नरव्याघ्र धर्मोपेतानि मानवाः।\nधर्ममेवानुपश्यन्तश्चक्रुर्धर्मपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2003101, "chapter_id": 1064, "verse_number": "१-६५-२४", "content_sanskrit": "स्वकर्मनिरताश्चासन्सर्वे वर्णा नराधिप।\nएवं तदा नरव्याघ्र धर्मो न ह्रसते क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2003102, "chapter_id": 1064, "verse_number": "१-६५-२५", "content_sanskrit": "काले गावः प्रसूयन्ते नार्यश्च भरतर्षभ।\nभवन्त्यृतुषु वृक्षाणां पुष्पाणि च फलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2003103, "chapter_id": 1064, "verse_number": "१-६५-२६", "content_sanskrit": "एवं कृतयुगे सम्यग्वर्तमाने तदा नृप।\nआपूर्यत मही कृत्स्ना प्राणिभिर्बहुभिर्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2003104, "chapter_id": 1064, "verse_number": "१-६५-२७", "content_sanskrit": "एवं समुदिते लोके मानुषे भरतर्षभ।\nअसुरा जज्ञिरे क्षेत्रे राज्ञां तु मनुजेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2003105, "chapter_id": 1064, "verse_number": "१-६५-२८", "content_sanskrit": "आदित्यैर्हि तदा दैत्या बहुशो निर्जिता युधि।\nऐश्वर्याद्धंशिताः स्वर्गात्संबभूवुः क्षिताविह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2003106, "chapter_id": 1064, "verse_number": "१-६५-२९", "content_sanskrit": "इह देवत्वमिच्छन्तो मानुषेषु तपस्विनः।\nजज्ञिरे भुवि भूतेषु तेषु तेष्वसुरा विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2003107, "chapter_id": 1064, "verse_number": "१-६५-३०", "content_sanskrit": "गोष्वश्वेषु च राजेन्द्र खरोष्ट्रमहिषेषु च।\nक्रव्यात्सु चैव भूतेषु गजेषु च मृगेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2003108, "chapter_id": 1064, "verse_number": "१-६५-३१", "content_sanskrit": "जातैरिह महीपाल जायमानैश्च तैर्मही।\nन शशाकात्मनात्मानमियं धारयितुं धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2003109, "chapter_id": 1064, "verse_number": "१-६५-३२", "content_sanskrit": "अथ जाता महीपालाः केचिद्बहुमदान्विताः।\nदितेः पुत्रा दनोश्चैव तदा लोकादिह च्युताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2003110, "chapter_id": 1064, "verse_number": "१-६५-३३", "content_sanskrit": "वीर्यवन्तोऽवलिप्तास्ते नानारूपधरा महीम्।\nइमां सागरपर्यन्तां परीयुररिमर्दनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2003111, "chapter_id": 1064, "verse_number": "१-६५-३४", "content_sanskrit": "ब्राह्मणान्क्षत्रियान्वैश्याञ्शूद्रांश्चैवाप्यपीडयन्।\nअन्यानि चैव सत्वानि पीडयामासुरोजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2003112, "chapter_id": 1064, "verse_number": "१-६५-३५", "content_sanskrit": "त्रासयन्तोऽभिनिघ्नन्तः सर्वभूतगणांश्च ते।\nविचेरुः सर्वशो राजन्महीं शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2003113, "chapter_id": 1064, "verse_number": "१-६५-३६", "content_sanskrit": "आश्रमस्थान्महर्षींश्च धर्षयन्तस्ततस्ततः।\nअब्रह्मण्या वीर्यमदा मत्ता मदबलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2003114, "chapter_id": 1064, "verse_number": "१-६५-३७", "content_sanskrit": "एवं वीर्यबलोत्सिक्तैर्भूरियं तैर्महासुरैः।\nपीड्यमाना मही राजन्ब्रह्माणमुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2003115, "chapter_id": 1064, "verse_number": "१-६५-३८", "content_sanskrit": "न ह्यमी भूतसत्वौघाः पन्नगाः सनगां महीम्।\nतदा धारयितुं शेकुराक्रान्तां दानवैर्बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2003116, "chapter_id": 1064, "verse_number": "१-६५-३९", "content_sanskrit": "ततो मही महीपाल भारार्ता भयपीडिता।\nजगाम शरणं देवं सर्वभूतपितामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2003117, "chapter_id": 1064, "verse_number": "१-६५-४०", "content_sanskrit": "सा संवृतं महाभागैर्देवद्विजमहर्षिभिः।\nददर्श देवं ब्रह्माणं लोककर्तारमव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2003118, "chapter_id": 1064, "verse_number": "१-६५-४१", "content_sanskrit": "गन्धर्वैरप्सरोभिश्च बन्दिकर्मसु निष्ठितैः।\nवन्द्यमानं मुदोपतैर्ववन्दे चैनमेत्य सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2003119, "chapter_id": 1064, "verse_number": "१-६५-४२", "content_sanskrit": "अथ विज्ञापयामास भूमिस्तं शरणार्थिनी।\nसन्निधौ लोकपालानां सर्वेषामेव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2003120, "chapter_id": 1064, "verse_number": "१-६५-४३", "content_sanskrit": "तत्प्रधानात्मनस्तस्य भूमेः कृत्यं स्वयंभुवः।\nपूर्वमेवाभवद्राजन्विदितं परमेष्ठिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2003121, "chapter_id": 1064, "verse_number": "१-६५-४४", "content_sanskrit": "स्रष्टा हि जगतः कस्मान्न संबुध्येत भारत।\nससुरासुरलोकानामशेषेण मनोगतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2003122, "chapter_id": 1064, "verse_number": "१-६५-४५", "content_sanskrit": "तामुवाच महाराज भूमिं भूमिपतिः प्रभुः।\nप्रभवः सर्वभूतानामीशः शंभुः प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2003123, "chapter_id": 1064, "verse_number": "१-६५-४६x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2003124, "chapter_id": 1064, "verse_number": "१-६५-४६", "content_sanskrit": "यदर्थमभिसंप्राप्ता मत्सकाशं वसुन्धरे।\nतदर्थं सन्नियोक्ष्यामि सर्वानेव दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2003125, "chapter_id": 1064, "verse_number": "१-६५-४७", "content_sanskrit": "उत्तिष्ठ गच्छ वसुधे स्वस्थानमिति साऽगमत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2003126, "chapter_id": 1064, "verse_number": "१-६५-४७x", "content_sanskrit": "वैशम्पायन उवाच।\nइत्युक्त्वा स महीं देवो ब्रह्मा राजन्विसृज्य च।\nआदिदेश तदा सर्वान्विबुधान्भूतकृत्स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2003127, "chapter_id": 1064, "verse_number": "१-६५-४८", "content_sanskrit": "अस्या भूमेर्निरसितुं भारं भागैः पृथक्पृथक्।\nअस्यामेव प्रसूयध्वं तिरोधायेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2003128, "chapter_id": 1064, "verse_number": "१-६५-४९", "content_sanskrit": "तथैव च समानीय गन्धर्वाप्सरसां गणान्।\nउवाच भगवान्सर्वानिदं वचनमर्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2003129, "chapter_id": 1064, "verse_number": "१-६५-५०x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2003130, "chapter_id": 1064, "verse_number": "१-६५-५०", "content_sanskrit": "स्वैः स्वैरंशैः प्रसूयध्वं यथेष्टं मानेषेषु च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2003131, "chapter_id": 1064, "verse_number": "१-६५-५०x", "content_sanskrit": "वैशम्पायन उवाच।\nअथ शक्रादयः सर्वे श्रुत्वा सुरगुरोर्वचः।\nतथ्यमर्थ्यं च पथ्यं च तस्य ते जगृहुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2003132, "chapter_id": 1064, "verse_number": "१-६५-५१", "content_sanskrit": "अथ ते सर्वशोंशैः स्वैर्गन्तुं भूमिं कृतक्षणाः।\nनारायणममित्रघ्नं वैकुण्ठमुपचक्रमुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2003133, "chapter_id": 1064, "verse_number": "१-६५-५२", "content_sanskrit": "यः स चक्रगदापाणिः पीतवासाः शितिप्रभः।\nपद्मनाभः सुरारिघ्नः पृथुचार्वञ्चितेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2003134, "chapter_id": 1064, "verse_number": "१-६५-५३", "content_sanskrit": "प्रजापतिपतिर्देवः सुरनाथो महाबलः।\nश्रीवत्साङ्को हृषीकेशः सर्वदैवतपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2003135, "chapter_id": 1064, "verse_number": "१-६५-५४", "content_sanskrit": "तं भुवः शोधनायेन्द्र उवाच पुरुषोत्तमम्।\nअंशेनावतरेत्येवं तथेत्याह च तं हरिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2003136, "chapter_id": 1064, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि अंशावतरणपर्वणि पञ्चषष्टितमोऽध्यायः॥ ६५ ॥ ॥ समाप्तमंशावतरणपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]