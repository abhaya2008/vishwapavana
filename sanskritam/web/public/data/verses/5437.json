[{"id": 2207929, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207930, "chapter_id": 5437, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nश्रुत्वा च तत् तथा कार्यं भवता द्विजसत्तम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207931, "chapter_id": 5437, "verse_number": "२", "content_sanskrit": "अलर्को नाम राजर्षिरभवत् सुमहातपाः ।\nधर्मज्ञः सत्यसन्धश्च महात्मा सुमहाव्रतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207932, "chapter_id": 5437, "verse_number": "३", "content_sanskrit": "स सागरान्तां धनुषा विनिर्जित्य महीमिमाम् ।\nकृत्वा सुदुष्करं कर्म मनः सूक्ष्मे समादधे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207933, "chapter_id": 5437, "verse_number": "४", "content_sanskrit": "स्थितस्य वृक्षमूलेऽथ तस्य चिन्ता बभूव ह ।\nउत्सृज्य सुमहद् राज्यं सूक्ष्मं प्रति महामते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207934, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "अलर्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207935, "chapter_id": 5437, "verse_number": "५", "content_sanskrit": "मनसो मे बलं जातं मनो जित्वा ध्रुवो जयः ।\nअन्यत्र बाणान् दास्यामि शत्रुभिः परिवारितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207936, "chapter_id": 5437, "verse_number": "६", "content_sanskrit": "यदिदं चापलात् कर्म सर्वमेतद् विकर्षति ।\nमनः प्रति सुतीक्ष्णाग्रान् अहं मोक्ष्यामि सायकान् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207937, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "मनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207938, "chapter_id": 5437, "verse_number": "७", "content_sanskrit": "नेमे बाणास्तरिष्यन्ति मामलर्क कथञ्चन ।\nतवैव मर्म भेत्स्यन्ति भिन्नमर्मा मरिष्यसि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207939, "chapter_id": 5437, "verse_number": "८", "content_sanskrit": "अन्यान् बाणान् समीक्षस्व यैस्त्वं मां सूदयिष्यसि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207940, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207941, "chapter_id": 5437, "verse_number": "९", "content_sanskrit": "तच्छ्रुत्वा स विचिन्त्याथ ततो वचनमब्रवीत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207942, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "अलर्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207943, "chapter_id": 5437, "verse_number": "१०", "content_sanskrit": "आघ्राय सुबहून् गन्धान् तानेव प्रति गृध्यति ।\nतस्माद् घ्राणं प्रति शरान् प्रतिमोक्षाम्यहं शितान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207944, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "घ्राणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207945, "chapter_id": 5437, "verse_number": "११", "content_sanskrit": "नेमे बाणास्तरिष्यन्ति मामलर्क कथञ्चन ।\nतवैव मर्म भेत्स्यन्ति भिन्नमर्मा मरिष्यसि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207946, "chapter_id": 5437, "verse_number": "१२", "content_sanskrit": "अन्यान् बाणान् समीक्षस्व यैस्त्वं मां सूदयिष्यसि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207947, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "अलर्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207948, "chapter_id": 5437, "verse_number": "१३", "content_sanskrit": "इयं स्वादून् रसान् भुक्त्वा तानेव प्रति गृध्यति ।\nतस्माज्जिह्वा प्रति शरान् प्रतिमोक्षाम्यहं शितान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207949, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "जिह्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207950, "chapter_id": 5437, "verse_number": "१४", "content_sanskrit": "नेमे बाणास्तरिष्यन्ति मामलर्क कथञ्चन ।\nतवैव मर्म भेत्स्यन्ति ततो हास्यसि जीवितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207951, "chapter_id": 5437, "verse_number": "१५", "content_sanskrit": "अन्यान् बाणान् समीक्षस्व यैस्त्वं मां सूदयिष्यसि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207952, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "अलर्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207953, "chapter_id": 5437, "verse_number": "१६", "content_sanskrit": "स्पृष्ट्वा त्वग् विविधान् स्पर्शान् तानेव प्रति गृध्यति ।\nतस्मात् तान् सूदयिष्येऽहं विविधैः कङ्कपत्रिभिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207954, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "त्वक्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207955, "chapter_id": 5437, "verse_number": "१७", "content_sanskrit": "नेमे बाणास्तरिष्यन्ति मामलर्क कथञ्चन ।\nतवैव मर्म भेत्स्यन्ति ततो हास्यसि जीवितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207956, "chapter_id": 5437, "verse_number": "१८", "content_sanskrit": "अन्यान् बाणान् समीक्षस्व यैस्त्वं मां सूदयिष्यसि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207957, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "अलर्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207958, "chapter_id": 5437, "verse_number": "१९", "content_sanskrit": "श्रुत्वा वै विविधान् शब्दान् तानेव प्रति गृध्यति ।\nतस्माच्छ्रोत्रं प्रति शरान् मोक्षयिष्याम्यहं शितान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207959, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "श्रोत्रम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207960, "chapter_id": 5437, "verse_number": "२०", "content_sanskrit": "नेमे बाणास्तरिष्यन्ति मामलर्क कथञ्चन ।\nतवैव मर्म भेत्स्यन्ति ततो हास्यसि जीवितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207961, "chapter_id": 5437, "verse_number": "२१", "content_sanskrit": "अन्यान् बाणान् समीक्षस्व यैस्त्वं मां सूदयिष्यसि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207962, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "अलर्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207963, "chapter_id": 5437, "verse_number": "२२", "content_sanskrit": "दृष्ट्वैव विविधान् भावान् तानेव प्रति गृध्यति ।\nतस्माच्चक्षुः प्रति शरान् मोक्षयिष्याम्यहं शितान् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2207964, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "चक्षुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2207965, "chapter_id": 5437, "verse_number": "२३", "content_sanskrit": "नेमे बाणास्तरिष्यन्ति मामलर्क कथञ्चन ।\nतवैव मर्म भेत्स्यन्ति भिन्नमर्मा मरिष्यसि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2207966, "chapter_id": 5437, "verse_number": "२४", "content_sanskrit": "अन्यान् बाणान् समीक्षस्व यैस्त्वं मां सूदयिष्यसि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2207967, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "अलर्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2207968, "chapter_id": 5437, "verse_number": "२५", "content_sanskrit": "इयं निष्ठा बहुविधाः प्रज्ञया त्वध्यवस्यति ।\nतस्मात् बुद्धिं प्रति शरान् प्रतिमोक्ष्याम्यहं शितान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2207969, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "बुद्धिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2207970, "chapter_id": 5437, "verse_number": "२६", "content_sanskrit": "नेमे बाणास्तरिष्यन्ति मामलर्क कथञ्चन ।\nतवैव मर्म भेत्स्यन्ति भिन्नमर्मा मरिष्यसि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2207971, "chapter_id": 5437, "verse_number": "२७", "content_sanskrit": "अन्यान् बाणान् समीक्षस्व यैस्त्वं मां सूदयिष्यसि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2207972, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2207973, "chapter_id": 5437, "verse_number": "२८", "content_sanskrit": "ततोऽलर्कस्तपो घोरमास्थाय तु सुदुष्करम् ।\nनाभ्यगच्छत् परं शक्त्या बाणमेतेषु सप्तसु ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2207974, "chapter_id": 5437, "verse_number": "२९", "content_sanskrit": "सुसमाहितचेतास्तु सततं चिन्तयत् प्रभुः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2207975, "chapter_id": 5437, "verse_number": "३०", "content_sanskrit": "स विचिन्त्य चिरं कालमलर्को द्विजसत्तम ।\nनाध्यगच्छत् परं श्रेयो योगान् मतिमतां वरः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2207976, "chapter_id": 5437, "verse_number": "३१", "content_sanskrit": "स एकाग्रं मनः कृत्वा निश्चलो योगमास्थितः ।\nइन्द्रियाणि जघानाशु बाणेनैकेन वीर्यवान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2207977, "chapter_id": 5437, "verse_number": "३२", "content_sanskrit": "योगेनात्मानमाविश्य स सिद्धिं परमं ययौ ।\nविस्मितश्चापि राजर्षिः इमां गाथां जगाद ह ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2207978, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "अलर्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2207979, "chapter_id": 5437, "verse_number": "३३", "content_sanskrit": "अहो कष्टं यदस्माभिः पूर्वं राज्यमनुष्ठितम् ।\nअतः पश्चान्मया ज्ञातं योगान्नास्ति परं सुखम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2207980, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2207981, "chapter_id": 5437, "verse_number": "समाप्तिः", "content_sanskrit": "इति त्वमपि जानीहि राम मा क्षत्रियान् वधीः ।\nतपो घोरमुपातिष्ठ ततः श्रेयोऽभिपत्स्यसे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2207982, "chapter_id": 5437, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2207983, "chapter_id": 5437, "verse_number": "३५", "content_sanskrit": "इत्युक्तः पितृभिः सोऽथ तपो घोरं समास्थितः ।\nजामदग्न्यो महाभागे सिद्धिं च परमां गतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2207984, "chapter_id": 5437, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्वमेधिकपर्वणि अनुगीतासु\nअलर्कचरित्रकथनं नाम एकत्रिंशोऽध्यायः ॥३१॥\nअनुगीतापर्वणि षोडशोऽध्यायः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]