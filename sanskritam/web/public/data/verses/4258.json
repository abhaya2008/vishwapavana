[{"id": 2150264, "chapter_id": 4258, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150265, "chapter_id": 4258, "verse_number": "१", "content_sanskrit": "ततस्ते तापसाः सर्वे तपसे धृतनिश्चयाम् ।\nदृष्ट्वा न्यवर्तयंस्तात किं कार्यमिति चासकृत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150266, "chapter_id": 4258, "verse_number": "२", "content_sanskrit": "तानुवाच ततः कन्या तपोवृद्धानृषींस्तदा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150267, "chapter_id": 4258, "verse_number": "३", "content_sanskrit": "निराकृताऽस्मि भीष्मेण भ्रंशिता पतिधर्मतः ।\nवधार्थं तस्य दीक्षा मे न लोकार्थं तपोधनाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150268, "chapter_id": 4258, "verse_number": "४", "content_sanskrit": "निहत्य भीष्मं गच्छेयं शान्तिमित्येव निश्चयः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150269, "chapter_id": 4258, "verse_number": "५", "content_sanskrit": "यत्कृते दुःखवसतिमिमां प्राप्ताऽस्मि शाश्वतीम् ।\nपतिलोकाद् विहीना च नैव स्त्री न पुमानिह\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150270, "chapter_id": 4258, "verse_number": "६", "content_sanskrit": "नाहत्वा युधि गाङ्गेयं निवर्तेयं तपोधनाः ।\nएष मे हृदि सङ्कल्पो यदर्थमिदमुद्यतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150271, "chapter_id": 4258, "verse_number": "७", "content_sanskrit": "स्त्रीभावे परिनिर्विण्णा पुंस्त्वार्थे कृतनिश्चया ।\nभीष्मे प्रतिचिकीर्षामि नास्मि वार्येति वै पुनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150272, "chapter_id": 4258, "verse_number": "८", "content_sanskrit": "तां देवो दर्शयामास शूलपाणिरुमापतिः ।\nमध्ये तेषां महर्षीणां स्वेन रूपेण भामिनीम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150273, "chapter_id": 4258, "verse_number": "९", "content_sanskrit": "छन्द्यमाना वरेणाथ सा वव्रे मत्पराजयम् ।\nहनिष्यसीति तां देवः प्रत्युवाच मनस्विनीम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150274, "chapter_id": 4258, "verse_number": "१०", "content_sanskrit": "ततः सा पुनरेवाथ कन्या रुद्रमुवाच ह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150275, "chapter_id": 4258, "verse_number": "११", "content_sanskrit": "उपपद्येत् कथं देव स्त्रिया युधि जयो मम\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150276, "chapter_id": 4258, "verse_number": "१२", "content_sanskrit": "स्त्रीभावेन च मे गाढं मनः शान्तमुमापते ।\nप्रतिश्रुतश्च भूतेश त्वया भीष्मपराजयः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150277, "chapter_id": 4258, "verse_number": "१३", "content_sanskrit": "यथा स सत्यो भवति तथा कुरु वृषध्वज ।\nयथा हन्यां समागम्य भीष्मं शान्तनवं युधि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150278, "chapter_id": 4258, "verse_number": "१४", "content_sanskrit": "तामुवाच महादेवः कन्यां किल वृषध्वजः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150279, "chapter_id": 4258, "verse_number": "१५", "content_sanskrit": "न मे वागनृतं प्राह सत्यं भद्रे भविष्यति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150280, "chapter_id": 4258, "verse_number": "१६", "content_sanskrit": "हनिष्यसि रणे भीष्मं पुरुषत्वं च लप्स्यसे ।\nस्मरिष्यसि च तत् सर्वं देहमन्यं गता सती\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150281, "chapter_id": 4258, "verse_number": "१७", "content_sanskrit": "द्रुपदस्य कुले जाता भविष्यसि महारथः ।\nशीघ्रास्त्रश्चित्रयोधी च भविष्यसि सुसम्मतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150282, "chapter_id": 4258, "verse_number": "१८", "content_sanskrit": "यथोक्तमेव कल्याणि सर्वमेतद् भविष्यति ।\nभविष्यसि पुमान् पश्चात् कस्माच्चित् कालपर्ययात्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150283, "chapter_id": 4258, "verse_number": "१९", "content_sanskrit": "एवमुक्त्वा महादेवः कपर्दी वृषभध्वजः ।\nपश्यतामेव विप्राणां तत्रैवान्तरधीयत\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150284, "chapter_id": 4258, "verse_number": "२०", "content_sanskrit": "ततः सा पश्यतां तेषां महर्षीणामनिन्दिता ।\nसमाहृत्य वनात् तस्मात् काष्ठानि वरवर्णिनी\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150285, "chapter_id": 4258, "verse_number": "२१", "content_sanskrit": "चितां कृत्वा सुमहतीं प्रदाय च हुताशनम् ।\nप्रदीप्तेऽग्नौ महाराज रोषदीप्तेन चेतसा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150286, "chapter_id": 4258, "verse_number": "२२", "content_sanskrit": "उक्त्वा भीष्मवधायेति प्रविवेश हुताशनम् ।\nज्येष्ठा काशिसुता राजन् यमुनामभितो नदीम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150287, "chapter_id": 4258, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोननवत्युत्तरशततमोऽध्यायः ॥१८९॥\nअम्बोपाख्यानपर्वणि एकोनविंशोऽध्यायः ॥१९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]