[{"id": 2049368, "chapter_id": 2084, "verse_number": "७-११-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049369, "chapter_id": 2084, "verse_number": "७-११-१", "content_sanskrit": "शृणु दिव्यानि कर्माणि वासुदेवस्य सञ्जय।\nकृतवान्यानि गोविन्दो यथा नान्याःपुमान्क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049370, "chapter_id": 2084, "verse_number": "७-११-२", "content_sanskrit": "संवर्धता गोपकुले बालेनैव महात्मना।\nविख्यापितं बलं बाह्वोस्त्रिषु लोकेषु सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049371, "chapter_id": 2084, "verse_number": "७-११-३", "content_sanskrit": "पूतनां शकटं हत्वा केशिनं चैव वाजिनम्।\nऋषभं धेनुकं चैव अरिष्टं च महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049372, "chapter_id": 2084, "verse_number": "७-११-४", "content_sanskrit": "दावान्मुक्त्वा महाबाहुर्धृत्वा गोवर्धनं निगिम्।\nचाणूरं मुष्टिकं चैव रङ्गमध्ये निहत्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049373, "chapter_id": 2084, "verse_number": "७-११-५", "content_sanskrit": "प्रलम्बं नरकं जम्भं पीठं चापि महासुरम्।\nमुरुं चान्तकसङ्काशमवधीत्पुष्करेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049374, "chapter_id": 2084, "verse_number": "७-११-६", "content_sanskrit": "तथा कंसो महातेजा जरासन्धेन पालितः।\nविक्रमेणैव कृष्णेन सगणः पातितो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049375, "chapter_id": 2084, "verse_number": "७-११-७", "content_sanskrit": "सुनामा रणविक्रान्तः समग्राक्षौहिणीपतिः।\nभोजराजस्य मध्यस्थो भ्राता कंसस्य वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049376, "chapter_id": 2084, "verse_number": "७-११-८", "content_sanskrit": "बलदेवद्वितीयेन कृष्णेनामित्रघातिना।\nतरस्वी समरे दग्धः ससैन्यः शूरसेनराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049377, "chapter_id": 2084, "verse_number": "७-११-९", "content_sanskrit": "दुर्वासा नाम विप्रर्षिस्तथा परमकोपनः।\nआराधितः सदारेण स चास्मै प्रददौ वरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049378, "chapter_id": 2084, "verse_number": "७-११-१०", "content_sanskrit": "तथा गान्धारराजस्य सुतां वीरः स्वयंवरे।\nनिर्जित्य पृथिवीपालानावहत्पुष्करेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049379, "chapter_id": 2084, "verse_number": "७-११-११", "content_sanskrit": "अमृष्यमाणा राजानो यस्य जात्या हया इव।\nरथे वैवाहिके युक्ताः प्रतोदेन कृतव्रणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049380, "chapter_id": 2084, "verse_number": "७-११-१२", "content_sanskrit": "जरासन्धं महाबाहुमुपायेन जनार्दनः।\nपरेण घातयामास समग्राक्षौहिणीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049381, "chapter_id": 2084, "verse_number": "७-११-१३", "content_sanskrit": "चेदिराजं च विक्रान्तं राजसेनापतिं बली।\nअर्घे विवदमानं च जघान पशुवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049382, "chapter_id": 2084, "verse_number": "७-११-१४", "content_sanskrit": "सौभं दैत्यपुरं खस्थं शाल्वगुप्तं दुरासदम्।\nसमुद्रकुक्षौ विक्रम्य पातयामास माधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049383, "chapter_id": 2084, "verse_number": "७-११-१५", "content_sanskrit": "अङ्गान्वङ्गान्कलिङ्गंश्च मागधान्काशिकोसलान्।\nवात्स्यगार्ग्यकरूषांश्च पौण्ड्रांश्चाप्यजयद्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049384, "chapter_id": 2084, "verse_number": "७-११-१६", "content_sanskrit": "आवन्त्यान्दाक्षिणात्यांश्च पार्वतीयान्दशेरकान्।\nकाश्मीरकानौरसिकान्पिशाचांश्च समुद्गलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049385, "chapter_id": 2084, "verse_number": "७-११-१७", "content_sanskrit": "काम्भोजान्वाटधानांश्च चोलान्पाण्ड्यांश्च सञ्जय।\nत्रिगर्तान्मालवांश्चैव दरदांश्च सुदुर्जयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2049386, "chapter_id": 2084, "verse_number": "७-११-१८", "content_sanskrit": "नानादिग्भ्यश्च सम्प्राप्तान्खशांश्चैव शकांस्तथा।\nजितवान्पुण्डरीकाक्षो यवनं च सहानुगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2049387, "chapter_id": 2084, "verse_number": "७-११-१९", "content_sanskrit": "प्रविश्य मकरावासं यादोगणनिषेवितम्।\nजिगाय वरुणं सङ्ख्ये सलिलान्तर्गतं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2049388, "chapter_id": 2084, "verse_number": "७-११-२०", "content_sanskrit": "युधि पञ्चजनं हत्वा दैत्यं पातालवासिनम्।\nपाञ्चजन्यं हृषीकेशो दिव्यं शङ्खमवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2049389, "chapter_id": 2084, "verse_number": "७-११-२१", "content_sanskrit": "खाण्डवे पार्थसहितस्तोषयित्वा हुताशनम्।\nआग्नेयमस्त्रं दुर्धर्षं चक्रं लेभे महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2049390, "chapter_id": 2084, "verse_number": "७-११-२२", "content_sanskrit": "वैनतेयं समारुह्य त्रासयित्वाऽमरावतीम्।\nमहेन्द्रभवनाद्वीरः पारिजातमुपानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2049391, "chapter_id": 2084, "verse_number": "७-११-२३", "content_sanskrit": "तच्च मर्षितवाञ्शक्रो जानंस्तस्य पराक्रमम्।\nराज्ञां चाप्यजितं कंचित्कृष्णेनेह न शुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2049392, "chapter_id": 2084, "verse_number": "७-११-२४", "content_sanskrit": "यच्च तन्महदाश्चर्यं सभायां मम सञ्जय।\nकृतवान्पुण्डरीकाक्षः कस्तदन्य इहार्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2049393, "chapter_id": 2084, "verse_number": "७-११-२५", "content_sanskrit": "यच्च भक्त्या प्रसन्नोऽहमद्राक्षं कृष्णमीश्वरम्।\nतन्मे सुविदितं सर्वं प्रत्यक्षमिव चागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2049394, "chapter_id": 2084, "verse_number": "७-११-२६", "content_sanskrit": "नान्तो विक्रमयुक्तस्य बुद्ध्या युक्तस्य वा पुनः।\nकर्मणां शक्यते गन्तुं हृषीकेशस्य सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2049395, "chapter_id": 2084, "verse_number": "७-११-२७", "content_sanskrit": "तथा गदश्च साम्बश्च प्रद्युम्नोऽथ विदूरथः।\nअगावहोऽनिरुद्धश्च चारुदेष्णः ससारणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2049396, "chapter_id": 2084, "verse_number": "७-११-२८", "content_sanskrit": "उल्मुको निशठश्चैव झिल्ली बभ्रुश्च वीर्यवान्।\nपृथुश्च विपृथुश्चैव शमीङ्कोऽथारिमेजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2049397, "chapter_id": 2084, "verse_number": "७-११-२९", "content_sanskrit": "एतेऽन्ये बलवन्तश्च वृष्णिवीराः प्रहारिणः।\nकथंचित्पाण्जवानीकं श्रयेयुः समरे स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2049398, "chapter_id": 2084, "verse_number": "७-११-३०", "content_sanskrit": "आहूता वृष्णिवीरेण केशवेन महात्मना।\nततः संशयितं सर्वे भवेदिति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2049399, "chapter_id": 2084, "verse_number": "७-११-३१", "content_sanskrit": "नागायुतबलो वीरः कैलासशिखरोपमः।\nवनमाली हली रामस्तत्र यत्र जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2049400, "chapter_id": 2084, "verse_number": "७-११-३२", "content_sanskrit": "यमाहुः सर्वपितरं वासुदेवं द्विजातयः।\nअपि वा ह्येष पाण्डूनां योत्स्यतेऽर्थाय सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2049401, "chapter_id": 2084, "verse_number": "७-११-३३", "content_sanskrit": "स यदा तात सन्नह्येत्पाण्डवार्थाय सञ्जय।\nन तदा प्रतिसंयोद्धा भविता तत्र कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2049402, "chapter_id": 2084, "verse_number": "७-११-३४", "content_sanskrit": "यदि स्म कुरवः सर्वे जयेयुर्नाम पाण्डवान्।\nवार्ष्णेयोऽर्थाय तेषां वै गृह्णीयाच्छस्त्रमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2049403, "chapter_id": 2084, "verse_number": "७-११-३५", "content_sanskrit": "ततः सर्वान्नरव्याघ्रो हत्वा नरपतीन्रणे।\nकौरवांश्च महाबाहुःकुन्त्यै दद्यात्स मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2049404, "chapter_id": 2084, "verse_number": "७-११-३६", "content_sanskrit": "यस्य यन्ता हृषीकेशो योद्धा यस्य धनञ्जयः।\nरथस्य तस्य कः सङ्ख्ये प्रत्यनीको भवेद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2049405, "chapter_id": 2084, "verse_number": "७-११-३७", "content_sanskrit": "न केनचिदुपायेन कुरूणां दृश्यते जयः।\nतस्मान्मे सर्वमाचक्ष्व यथा युद्धमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2049406, "chapter_id": 2084, "verse_number": "७-११-३८", "content_sanskrit": "अर्जुनः केशवस्यात्मा कृष्णोऽप्यात्मा किरीटिनः।\nअर्जुने विजयो नित्यं कृष्णे कीर्तिश्च शाश्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2049407, "chapter_id": 2084, "verse_number": "७-११-३९", "content_sanskrit": "सर्वेष्वपि च लोकेषु बीभत्सुरपराजितः।\nप्राधान्येनैव भूयिष्ठममेयाः केशवे गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2049408, "chapter_id": 2084, "verse_number": "७-११-४०", "content_sanskrit": "मोहाद्दुर्योधनः कृष्णं यो न वेत्तीह केशवम्।\nमोहितो दैवयोगेन मृत्युपाशपुरस्कृतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2049409, "chapter_id": 2084, "verse_number": "७-११-४१", "content_sanskrit": "न वेद कृष्णं दाशार्हमर्जुनं चैव पाण्डवम्।\nपूर्वदेवौ महात्मानौ नरनारायणावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2049410, "chapter_id": 2084, "verse_number": "७-११-४२", "content_sanskrit": "एकात्मानौ द्विधाभूतौ दृश्येते मानवैर्भुवि।\nमनसापि हि दुर्धर्षौ सेनामेतां यशस्विनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2049411, "chapter_id": 2084, "verse_number": "७-११-४३", "content_sanskrit": "नाशयेतामिहेच्छन्तौ मानुषत्वाच्च नेच्छतः।\nयुगस्येव विपर्यासो लोकानामिव मोहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2049412, "chapter_id": 2084, "verse_number": "७-११-४४", "content_sanskrit": "भीष्मस्य च वधस्तात द्रोणस्य च महात्मनः।\nन ह्येव ब्रह्मचर्येण न वेदाध्ययनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2049413, "chapter_id": 2084, "verse_number": "७-११-४५", "content_sanskrit": "न क्रियाभिर्न चास्त्रेण मृत्योः कश्चिन्निर्वायते।\nलोकसम्भावितौ वीरौ कृतास्त्रौ युद्धदुर्मदौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2049414, "chapter_id": 2084, "verse_number": "७-११-४६", "content_sanskrit": "भीष्मद्रोणौ हतौ श्रुत्वा किन्नु जीवामि सञ्जय।\nयां तां श्रियमसूयामः पुरा दृष्ट्वा युधिष्ठिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2049415, "chapter_id": 2084, "verse_number": "७-११-४७", "content_sanskrit": "अद्य तामनुजानीमो भीष्मद्रोणवधेन ह।\nमत्कृते चाप्यनुप्राप्तः कुरूणामेष सङ्क्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2049416, "chapter_id": 2084, "verse_number": "७-११-४८", "content_sanskrit": "पक्वानां हि वधे सूत वज्रायन्ते तृणान्युत।\nअनन्तमिदमैश्वर्यं लोके प्राप्तो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2049417, "chapter_id": 2084, "verse_number": "७-११-४९", "content_sanskrit": "यस्य कोपान्महात्मानौ भीष्मद्रोणौ निपातितौ।\nप्राप्तः प्रकृतितो धर्मो न धर्मो मामकान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2049418, "chapter_id": 2084, "verse_number": "७-११-५०", "content_sanskrit": "क्रूरः सर्वविनाशाय कालोऽसौ नातिवर्तते।\nअन्यथा चिन्तिता ह्यर्था नरैस्तात मनस्विभिः।\nअन्यथैव प्रपद्यन्ते दैवादिति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2049419, "chapter_id": 2084, "verse_number": "७-११-५१", "content_sanskrit": "तस्मादपरिहार्येऽर्थे सम्प्राप्ते कृच्छ्र उत्तमे।\nअपारणीये दुश्चिन्त्ये यथाभूतं प्रचक्ष्व मे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2049420, "chapter_id": 2084, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि द्रोणाभिषेकपर्वणि एकादशोऽध्यायः॥ ११ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-११-६ विक्रमेणैव अस्त्रं चिना॥ ५-११-१२ परेण भीमेन॥ ५-११-११ एकादशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]