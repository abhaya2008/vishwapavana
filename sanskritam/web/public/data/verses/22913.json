[{"id": 7002913000, "chapter_id": 22913, "verse_number": "९-१९८-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nअथ पापहरं वक्ष्ये सुवर्णाचलमुत्तमम् ।\nयस्य प्रसादाद्भवनं वैरिच्यं याति मानवः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002913001, "chapter_id": 22913, "verse_number": "९-१९८-२", "content_sanskrit": "उत्तमः पलसाहस्रो मध्यमः पञ्चभिः शतैः ।\nतदर्द्धेनावरस्तद्वदल्पवित्तोऽपि शक्तितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002913002, "chapter_id": 22913, "verse_number": "९-१९८-३", "content_sanskrit": "दद्यादेकपलादूर्ध्वं यथाशक्त्या विचक्षणः ।\nधान्यपर्वतवत्सर्वं विदध्यान्नृपसत्तम ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002913003, "chapter_id": 22913, "verse_number": "९-१९८-४", "content_sanskrit": "विष्कंभशैलांस्तद्वच्च कृत्वा मंत्रमुदीरयेत् ।\nनमस्ते ब्रह्मबीजाय ब्रह्मगर्भाय वै नमः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002913004, "chapter_id": 22913, "verse_number": "९-१९८-५", "content_sanskrit": "यस्मादनंतफलदस्तस्मात्पाहि शिलोच्चय ।\nयस्मादग्नेरपत्यं त्वं यस्मादुल्ब जगत्पतेः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002913005, "chapter_id": 22913, "verse_number": "९-१९८-६", "content_sanskrit": "हेमपर्वतरूपेण तस्मात्पाहि नगोत्तम ।\nअनेन विधिना यस्तु दद्यात्कनकपर्वतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002913006, "chapter_id": 22913, "verse_number": "९-१९८-७", "content_sanskrit": "स याति परमं स्थानं यत्र देवो महेश्वरः ।\nतत्र वर्षशतं तिष्ठेत्ततो याति परां गतिम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002913007, "chapter_id": 22913, "verse_number": "९-१९८-८", "content_sanskrit": "हेमाचलात्परं दानं न चान्यद्विद्यते क्वचित् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002913008, "chapter_id": 22913, "verse_number": "९-१९८-९", "content_sanskrit": "हैमं महींद्रमणिशृंगशतैरुपेतं लोकाधिपाष्टकयुतं सहितं मुनीन्द्रैः ।\nयः शक्तिमान्वितरतीह गणेशलोके कल्पं कुमारवदसौ कुरुपुंगवाऽस्ते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]