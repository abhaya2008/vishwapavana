[{"id": 7003297000, "chapter_id": 23297, "verse_number": "१-१००-१", "content_sanskrit": "ऋषयः ऊचुः  ।\nविजित्य विष्णुना सार्धं भगवान्परमेश्वरः  ।\nसर्वान्दधीचवचनात्कथं भेजे महेश्वरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003297001, "chapter_id": 23297, "verse_number": "१-१००-२", "content_sanskrit": "सूत उवाच  ।\nदक्षयज्ञे सुविपुले देवान् विष्णुपुरोगमान्  ।\nददाह सार्धं भगवान् रुद्रः सर्वान्मुनिगणानपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003297002, "chapter_id": 23297, "verse_number": "१-१००-३", "content_sanskrit": "भद्रो नाम गणस्तेन प्रेषितः परमेष्ठिना  ।\nविप्रयोगेन देव्या वै दुःसहेनैव सुव्रताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003297003, "chapter_id": 23297, "verse_number": "१-१००-४", "content_sanskrit": "सोसृजद्वीरभद्रश्च गणेशान्रोमजाञ्छुभान्  ।\nगणेश्वरैः समारुह्य रथं भद्रः प्रतावान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003297004, "chapter_id": 23297, "verse_number": "१-१००-५", "content_sanskrit": "गंतुं चक्रे मतिं यस्य सारथिर्भगवानजः  ।\nगणेश्वराश्च ते सर्वे विविधायुधपामयः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003297005, "chapter_id": 23297, "verse_number": "१-१००-६", "content_sanskrit": "विमानैर्विश्वतो भद्रैस्तमन्वयुरथो सुराः  ।\nहिमवच्छिखरे रम्ये हेमश्रृंगे सुशोभने ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003297006, "chapter_id": 23297, "verse_number": "१-१००-७", "content_sanskrit": "यज्ञवाटस्तथा तस्य गंगाद्वारसमीपतः  ।\nतद्देशे चैव विख्यातं शुभं कनखलं द्विजाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003297007, "chapter_id": 23297, "verse_number": "१-१००-८", "content_sanskrit": "दग्धुं वै प्रेषितश्चासौ भगवान् परमेष्ठिना  ।\nतदोत्पातो बभूवाथ लोकानां भयशंसनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003297008, "chapter_id": 23297, "verse_number": "१-१००-९", "content_sanskrit": "पर्वताश्च व्यशीर्यंत प्रचकंपे वसुंधरा  ।\nमरुतश्चाप्यघूर्णंत चुक्षुभे मकरालयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003297009, "chapter_id": 23297, "verse_number": "१-१००-१०", "content_sanskrit": "अग्नयो नैव दीप्यंति न च दीप्यति भास्करः  ।\nग्रहाश्च न प्रकाश्यंते न देवा न च दानवाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003297010, "chapter_id": 23297, "verse_number": "१-१००-११", "content_sanskrit": "ततः क्षणात् प्रविश्यैव यज्ञवाटं महात्मनः  ।\nरोमजैः सहितो भद्रः कालाग्निरिवचापरः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003297011, "chapter_id": 23297, "verse_number": "१-१००-१२", "content_sanskrit": "उवाच भद्रो भगवान् दक्षं चामिततेजसम्  ।\nसंपर्कादेव दक्षाद्यमुनीन्देवान् पिनाकिना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003297012, "chapter_id": 23297, "verse_number": "१-१००-१३", "content_sanskrit": "दग्धुं संप्रोषितश्चाहं भवंतं समुनीश्वरैः  ।\nइत्युक्त्वा यज्ञशालां तां ददाह गणपुंगवः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003297013, "chapter_id": 23297, "verse_number": "१-१००-१४", "content_sanskrit": "गणेश्वराश्च संक्रुद्धा यूपानुत्पाट्य चिक्षिपुः  ।\nप्रस्तोत्रा सह होत्रा च दग्धं चैव गणेश्वरैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003297014, "chapter_id": 23297, "verse_number": "१-१००-१५", "content_sanskrit": "गृहीत्वा गणपाः सर्वान् गंगास्रोतसि चिक्षिपुः  ।\nवीरभद्रो महातेजाः शक्रस्योद्यच्छतः करम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003297015, "chapter_id": 23297, "verse_number": "१-१००-१६", "content_sanskrit": "व्यष्टंभयददीनात्मा तथान्येषां दिवौकसाम्  ।\nभगस्य नेत्रे चोत्पाट्य करजाग्रेण लीलया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003297016, "chapter_id": 23297, "verse_number": "१-१००-१७", "content_sanskrit": "निहत्य मुष्टिना दंतान् पूष्णश्चैवं न्यपातयत्  ।\nतथा चंद्रमसंदेवं पादांगुष्ठेन लीलया ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003297017, "chapter_id": 23297, "verse_number": "१-१००-१८", "content_sanskrit": "घर्षयामास भगवान् वीरभद्रः प्रतापवान्  ।\nचिच्छेद च शिरस्तस्य शक्रस्य भगवान्प्रभोः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003297018, "chapter_id": 23297, "verse_number": "१-१००-१९", "content_sanskrit": "वह्नेर्हस्तद्वयं छित्त्वा जिह्वामुत्पाट्य लीलया  ।\nजघान मूर्ध्नि पादेन वीरभद्रो महाबलः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003297019, "chapter_id": 23297, "verse_number": "१-१००-२०", "content_sanskrit": "यमस्य दंडं भगवान् प्रचिच्छेद स्वयं प्रभुः  ।\nजघान देवमीशानं त्रिशूलेन महाबलम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003297020, "chapter_id": 23297, "verse_number": "१-१००-२१", "content_sanskrit": "त्रयस्त्रिंशत्सुरानेवं विनिहत्याप्रयत्नतः  ।\nत्रयश्च त्रिशतं तेषां त्रिसाहस्रं च लीलया ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003297021, "chapter_id": 23297, "verse_number": "१-१००-२२", "content_sanskrit": "त्रयं चैव सुरेंद्राणां जघान च मुनीश्वरान्  ।\nअन्यांश्च देवान्देवोसौ सर्वान्युद्धाय संस्थितान् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003297022, "chapter_id": 23297, "verse_number": "१-१००-२३", "content_sanskrit": "जघान भगवान्नुद्रः खड्गमुष्ट्यादिसायकैः  ।\nअथ विष्णुर्महातेजाश्चक्रमुद्यम्य मूर्च्छितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003297023, "chapter_id": 23297, "verse_number": "१-१००-२४", "content_sanskrit": "युयोध भगवांस्तेन रुद्रेण सह माधवः  ।\nतयोः समभवद्युद्धं सुघोरं रोमहर्षणम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003297024, "chapter_id": 23297, "verse_number": "१-१००-२५", "content_sanskrit": "विष्णोर्योगबलात्तस्य दिव्यदेहाः सुदारुणाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003297025, "chapter_id": 23297, "verse_number": "१-१००-२६", "content_sanskrit": "शंखचक्रगदाहस्ता असंख्याताश्च जज्ञिरे  ।\nतान्सर्वानपि देवोसौनारायणसमप्रभ्रान् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003297026, "chapter_id": 23297, "verse_number": "१-१००-२७", "content_sanskrit": "निहत्य गदया विष्णुं ताडयामास मूर्धनि  ।\nततश्चोरसि तं देवं लीलयैव रणाजिरे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003297027, "chapter_id": 23297, "verse_number": "१-१००-२८", "content_sanskrit": "पपात च तदा भूमौ विसंज्ञः पुरुषोत्तमः  ।\nपुनरुत्थाय तं हंतुं चक्रमुद्यम्य स प्रभुः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003297028, "chapter_id": 23297, "verse_number": "१-१००-२९", "content_sanskrit": "क्रोधरक्तेक्षमः श्रीमानतिष्ठत्पुरुषर्षभः  ।\nतस्य चक्रं च यद्रौद्रं कालादित्यसमप्रभम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003297029, "chapter_id": 23297, "verse_number": "१-१००-३०", "content_sanskrit": "व्यष्टंभयददीनात्मा करस्थं न चचाल सः  ।\nअतिष्ठत्स्तंभितस्तेन श्रृंगवानिव निश्चलः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003297030, "chapter_id": 23297, "verse_number": "१-१००-३१", "content_sanskrit": "त्रिभिश्च धर्षितं शार्ङ्गं त्रिधाभूतं प्रभोस्तदा  ।\nशार्ङ्गंकोटिप्रसंगाद्वै चिच्छेद च शिरः प्रभोः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003297031, "chapter_id": 23297, "verse_number": "१-१००-३२", "content_sanskrit": "छिन्नं च निपपातासु शिरस्तस्य रसातले  ।\nवायुना प्रेरितं चैव प्राणजेन पिनाकिना ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003297032, "chapter_id": 23297, "verse_number": "१-१००-३३", "content_sanskrit": "प्रविवेश तदा चैव तदीयाहवनीयकम्  ।\nतत्प्रतिध्वस्तकलशं भग्नयूपं सतोरणम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003297033, "chapter_id": 23297, "verse_number": "१-१००-३४", "content_sanskrit": "प्रदीपितमहाशालं दृष्ट्वा यज्ञोपि दुद्रुवे  ।\nते तदा मृगरूपेण धावंतं गगनं प्रति ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003297034, "chapter_id": 23297, "verse_number": "१-१००-३५", "content_sanskrit": "वीरभद्रः समाधाय विशिरस्कमथाकरोत्  ।\nततः प्रजापतिं धर्मं कश्यपं च जगद्गुरुम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003297035, "chapter_id": 23297, "verse_number": "१-१००-३६", "content_sanskrit": "अरिष्टनेमिनं वीरो बहुपुत्रं मुनीश्वरम्  ।\nमुनीमंगिरसं चैव कृष्णाश्वं च महाबलः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003297036, "chapter_id": 23297, "verse_number": "१-१००-३७", "content_sanskrit": "जघान मूर्ध्नि पादेन दक्षं चैव यशस्विनम्  ।\nचिच्छेद च शिरस्तस्य ददाहाग्नौ द्विजोत्तमाः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003297037, "chapter_id": 23297, "verse_number": "१-१००-३८", "content_sanskrit": "सरस्वत्यश्च नासाग्रं देवमातुस्तथैव च  ।\nनिकृत्य करजाग्रेण वरिभद्रः प्रतापवान् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003297038, "chapter_id": 23297, "verse_number": "१-१००-३९", "content_sanskrit": "तस्थौ श्रिया वृतो मध्ये प्रेतस्थाने यथा भवः  ।\nएतस्मिन्नेव काले तु भगवान्पद्मसंभवः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003297039, "chapter_id": 23297, "verse_number": "१-१००-४०", "content_sanskrit": "भद्रमाह महातेजाः प्रार्थयन्प्रणतः प्रभुः  ।\nअलं क्रोधेन वै भद्र नष्टाश्चैव दिवौकसः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003297040, "chapter_id": 23297, "verse_number": "१-१००-४१", "content_sanskrit": "प्रसीद क्षम्यतां सर्वं रोमजैः सह सुव्रत  ।\nसोपि भद्रः प्रभावेण ब्रह्मणः परमेष्ठिनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003297041, "chapter_id": 23297, "verse_number": "१-१००-४२", "content_sanskrit": "शमं जगाम शनकैः शांतस्तस्थौ तदाज्ञया  ।\nदेवोपि तत्र भगवानंरिक्षे वृषध्वजः ॥४२।।॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003297042, "chapter_id": 23297, "verse_number": "१-१००-४३", "content_sanskrit": "सगणः सर्वदः शर्वः सर्वलोकमहेश्वरः  ।\nप्रार्थितश्चैव देवेन ब्रह्मणा भगवान् भवः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003297043, "chapter_id": 23297, "verse_number": "१-१००-४४", "content_sanskrit": "हतानां च तदा तेषां प्रददौ पूर्ववत्तनुम्  ।\nइंद्रस्य च शिरस्तस्य विष्णोश्चैव महात्मनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003297044, "chapter_id": 23297, "verse_number": "१-१००-४५", "content_sanskrit": "दक्षस्य च मुनीन्द्रस्य तथान्येषां महेश्वरः  ।\nवागीश्याश्चैव नासाग्रं देवमातुस्तथैव च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003297045, "chapter_id": 23297, "verse_number": "१-१००-४६", "content_sanskrit": "नष्टानां जीवितं चैव वराणि विविधानि च  ।\nदक्षस्य ध्वस्त वक्त्रस्य शिरसा भगवान्प्रभुः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003297046, "chapter_id": 23297, "verse_number": "१-१००-४७", "content_sanskrit": "कल्पयामास वै वक्त्रं लीलया च महान् भवः  ।\nदक्षोपि लब्धसंज्ञश्च समुत्थाय कृतांजलिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003297047, "chapter_id": 23297, "verse_number": "१-१००-४८", "content_sanskrit": "तुष्टाव देवदेवेशं शंकरं वृषभध्वजम्  ।\nस्तुतस्तेन महातेजाः प्रदाय विविधान्वरान् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003297048, "chapter_id": 23297, "verse_number": "१-१००-४९", "content_sanskrit": "गाणपत्यं ददौ तस्मै दक्षायाक्लिष्टकर्मणे  ।\nदेवाश्च सर्वे देवेशं तुष्टुवुः परमेश्वरम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003297049, "chapter_id": 23297, "verse_number": "१-१००-५०", "content_sanskrit": "नारायणश्च भगवान् तुष्टाव च कृतांजलिः  ।\nब्रह्मा च मुनयः सर्वे पृथक्पृथगजोद्भवम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003297050, "chapter_id": 23297, "verse_number": "१-१००-५१", "content_sanskrit": "तुष्टुवुर्देवर्देवेशं नीलकंठं वृषध्वजम्  ।\nतान्दोवाननुगृह्यैव भवोप्यंतरधीयत ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]