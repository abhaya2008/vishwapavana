[{"id": 2059804, "chapter_id": 2281, "verse_number": "८-२-०x", "content_sanskrit": "`जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2059805, "chapter_id": 2281, "verse_number": "८-२-१", "content_sanskrit": "तच्छ्रुत्वा कर्णहननं पुत्रांश्चैव पलायितान्।\nधृतराष्ट्रो नृपश्चैव द्विजश्रेष्ठ किमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2059806, "chapter_id": 2281, "verse_number": "८-२-२", "content_sanskrit": "प्राप्तवान्व्यसनं घोरं पुत्रव्यसनजं महत्।\nकाले यदुक्तवांस्तस्मिंस्तन्ममाचक्ष्व तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2059807, "chapter_id": 2281, "verse_number": "८-२-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2059808, "chapter_id": 2281, "verse_number": "८-२-३", "content_sanskrit": "एतच्छ्रुत्वा महाराज धृतराष्ट्रोऽम्बिकासुतः।\nअब्रवीत्सञ्जयं सूतं शोकसंविग्नमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2059809, "chapter_id": 2281, "verse_number": "८-२-४", "content_sanskrit": "दुष्प्रणीतेन मे तात पुत्रस्यादीर्घजीविनः।\nहतं वैकर्तनं श्रुत्वा शोको मर्माणि कृन्तति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2059810, "chapter_id": 2281, "verse_number": "८-२-५", "content_sanskrit": "तस्य मे संशयं छिन्धि दुःखपारं तितीर्षतः।\nकुरूणां सृञ्जयानां च के जीवन्ति के मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2059811, "chapter_id": 2281, "verse_number": "८-२-६x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2059812, "chapter_id": 2281, "verse_number": "८-२-६", "content_sanskrit": "हतः शान्तनवो राजन्दुराधर्षः प्रतापवान्।\nहत्वा पाण्डवयोधानामर्बुदं दशभिर्दिनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2059813, "chapter_id": 2281, "verse_number": "८-२-७", "content_sanskrit": "तथा द्रोणो महेष्वासः पाञ्चालानां रथव्रजान्।\nनिहत्य युधि दुर्धर्षः पञ्चाद्रुक्मरथो हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2059814, "chapter_id": 2281, "verse_number": "८-२-८", "content_sanskrit": "हतशेषस्य भीष्मेण द्रोणेन च महात्मना।\nअर्धं निहत्य सैन्यस्य कर्णो वैकर्तनो हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2059815, "chapter_id": 2281, "verse_number": "८-२-९", "content_sanskrit": "विविंशतिर्महाराज राजपुत्रो महाबलः।\nआनर्तयोधाञ्शतशो निहत्य निहतो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2059816, "chapter_id": 2281, "verse_number": "८-२-१०", "content_sanskrit": "तथा पुत्रो विकर्णस्ते क्षत्रव्रतमनुस्मरन्।\nक्षीणबाणो हतः शूरः स्थितो ह्यभिमुखः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2059817, "chapter_id": 2281, "verse_number": "८-२-११", "content_sanskrit": "धोररूपान्परिक्लेशान्दुर्योधनकृतान्बहून्।\nप्रतिज्ञां स्मरता तेन भीमसेनेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2059818, "chapter_id": 2281, "verse_number": "८-२-१२", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ राजपुत्रौ महारथौ।\nकृत्वा स्वसुकरं कर्म गतौ वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2059819, "chapter_id": 2281, "verse_number": "८-२-१३", "content_sanskrit": "सिन्धुराष्ट्रमुखानीह दश राष्ट्राणि यानिह।\nयस्य तिष्ठन्ति वचने यः स्थितस्तव शासने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2059820, "chapter_id": 2281, "verse_number": "८-२-१४", "content_sanskrit": "अक्षौहिणीर्दशैकां च विनिर्जित्य शितैः शरैः।\nसोऽर्जुनेन हतो राजन्महावीर्यो जयद्रथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2059821, "chapter_id": 2281, "verse_number": "८-२-१५", "content_sanskrit": "तथा दुर्योधनसुतस्तरस्वी युद्धदुर्मदः।\nवर्तमानः पितुः शास्त्रे सौभद्रेण निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2059822, "chapter_id": 2281, "verse_number": "८-२-१६", "content_sanskrit": "तथा दौःशासनिः सूरो बाहुशाली रणोत्कटः।\nद्रौपदेयेन सङ्गम्य गमितो यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2059823, "chapter_id": 2281, "verse_number": "८-२-१७", "content_sanskrit": "किरातानामधिपतिः सागरानूपवासिनाम्।\nदेवराजस्य धर्मात्मा प्रियो बहुमतः सखा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2059824, "chapter_id": 2281, "verse_number": "८-२-१८", "content_sanskrit": "भगदत्तो महीपालः क्षत्रधर्मरतः सदा।\nधनञ्जयेन विक्रम्य गमितो यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2059825, "chapter_id": 2281, "verse_number": "८-२-१९", "content_sanskrit": "तथा कौरवदायादो न्यस्तशस्त्रो महायशाः।\nहतो भूरिश्रवा राजञ्शूरः सात्यकिना युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2059826, "chapter_id": 2281, "verse_number": "८-२-२०", "content_sanskrit": "श्रुतायुरपि चाम्बष्ठः क्षत्रियाणां धुरन्धरः।\nचरन्नभीतवत्सङ्ख्ये निहतः सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2059827, "chapter_id": 2281, "verse_number": "८-२-२१", "content_sanskrit": "तव पुत्रः सदामर्षी कृतास्त्रो युद्धदुर्मदः।\nदुःशासनो महाराज भीमसेनेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2059828, "chapter_id": 2281, "verse_number": "८-२-२२", "content_sanskrit": "यस्य राजन्गजानीकं बहुसाहस्रमद्भुतम्।\nसुदक्षिणः स सङ्ग्रामे निहतः सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2059829, "chapter_id": 2281, "verse_number": "८-२-२३", "content_sanskrit": "कोसलानामधिपतिर्हत्वा बहुमतान्परान्।\nसौभद्रेणेह विक्रम्य गमितो यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2059830, "chapter_id": 2281, "verse_number": "८-२-२४", "content_sanskrit": "बहुशो योधयित्वा तु भीमसेनं महारथम्।\nचित्रसेनस्तव सुतो भीमसेनेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2059831, "chapter_id": 2281, "verse_number": "८-२-२५", "content_sanskrit": "मद्रराजात्मजः शूरः परेषां भयवर्धनः।\nअसिचर्मधरः श्रीमान्सौभद्रेण निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2059832, "chapter_id": 2281, "verse_number": "८-२-२६", "content_sanskrit": "समः कर्णस्य समरे यः स कर्णस्य पश्यतः।\nवृषसेनो महातेजाः शीघ्रास्त्रो दृढविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2059833, "chapter_id": 2281, "verse_number": "८-२-२७", "content_sanskrit": "अभिमन्योर्वधं स्मृत्वा प्रतिज्ञामपि चात्मनः।\nधनञ्जयेन विक्रम्य गमितो यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2059834, "chapter_id": 2281, "verse_number": "८-२-२८", "content_sanskrit": "नित्यं प्रसक्तवैरो यः पाण्डवैः पृथिवीपतिः।\nविश्राव्य वैरं पार्थेन श्रुतायुः स निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2059835, "chapter_id": 2281, "verse_number": "८-२-२९", "content_sanskrit": "शल्यपुत्रस्तु विक्रान्तः सहदेवेन मारिष।\nहतो रुक्मरथो राजञ्श्यालो मातुलजो युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2059836, "chapter_id": 2281, "verse_number": "८-२-३०", "content_sanskrit": "राजा भागीरथो वृद्धो बृहत्क्षत्रश्च केकयः।\nपराक्रमन्तौ विक्रान्तौ निहतौ वीर्यवत्तरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2059837, "chapter_id": 2281, "verse_number": "८-२-३१", "content_sanskrit": "भगदत्तसुतो राजन्कृतप्रज्ञो मंहाबलः।\nश्येनवच्चरता सङ्ख्ये नकुलेन निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2059838, "chapter_id": 2281, "verse_number": "८-२-३२", "content_sanskrit": "पितामहस्तव तथा बाह्लीकः सह बाह्लिकैः।\nनिहतो भीमसेनेन महाबालपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2059839, "chapter_id": 2281, "verse_number": "८-२-३३", "content_sanskrit": "जयत्सेनस्तथा राजञ्जारासन्धिर्महाबलः।\nमागधो निहतः सङ्ख्ये सौभद्रेण महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2059840, "chapter_id": 2281, "verse_number": "८-२-३४", "content_sanskrit": "पुत्रस्ते दुर्मुखो राजन्दुःसहश्च महारथः।\nगदया भीमसेनेन निहतौ शूरमानिनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2059841, "chapter_id": 2281, "verse_number": "८-२-३५", "content_sanskrit": "दुर्मर्षणो दुर्विषहो दुर्जयश्च महारथः।\nकृत्वा त्वसुकरं कर्म गता वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2059842, "chapter_id": 2281, "verse_number": "८-२-३६", "content_sanskrit": "उभौ कलिङ्गवृषकौ भ्रातरौ युद्धदुर्मदौ।\nकृत्वा चासुकरं कर्म गतौ वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2059843, "chapter_id": 2281, "verse_number": "८-२-३७", "content_sanskrit": "सचिवो वृषपर्वा ते शूरः परमवीर्यवान्।\nभीमसेनेन विक्रम्य गमितो यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2059844, "chapter_id": 2281, "verse_number": "८-२-३८", "content_sanskrit": "तथैव पौरवो राजा नागायुतबलो महान्।\nसमरे पाण्डुपुत्रेण निहतः सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2059845, "chapter_id": 2281, "verse_number": "८-२-३९", "content_sanskrit": "वसातयो महाराज द्विसाहस्राः प्रहारिणः।\nशूरसेनाश्च विक्रान्ताः सर्वे युधि निपातिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2059846, "chapter_id": 2281, "verse_number": "८-२-४०", "content_sanskrit": "अभीषाहाः कवचिनः प्रहरन्तो रणोत्कटाः।\nशिबयश्च रथोदाराः कालिङ्गसहिता हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2059847, "chapter_id": 2281, "verse_number": "८-२-४१", "content_sanskrit": "गोकुले नित्यसंवृद्धा युद्धे परमकोपनाः।\nगोपालाः कृतवीरास्ते निहताः सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2059848, "chapter_id": 2281, "verse_number": "८-२-४२", "content_sanskrit": "श्रेणयो बहुसाहस्राः संशप्तकगणाश्च ये।\nते सर्वे पार्थमासाद्य गदा वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2059849, "chapter_id": 2281, "verse_number": "८-२-४३", "content_sanskrit": "श्यालौ तव महाराज राजानौ वृषकाचलौ।\nत्वदर्थमतिविक्रान्तौ निहतौ सव्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2059850, "chapter_id": 2281, "verse_number": "८-२-४४", "content_sanskrit": "उग्रकर्मा महेष्वासो नामतः कर्मतस्तथा।\nसाल्वराजो महाबाहुर्भीमसेनेन पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2059851, "chapter_id": 2281, "verse_number": "८-२-४५", "content_sanskrit": "ओघवांश्च महाराज बृहन्तः सहितौ रणे।\nपराक्रमन्तौ मित्रार्थे गतौ वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2059852, "chapter_id": 2281, "verse_number": "८-२-४६", "content_sanskrit": "तथैव रथिनां श्रेष्ठः क्षेमधूर्तिर्विशाम्पते।\nनिहतो गदया राजन्भीमसेनेन संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2059853, "chapter_id": 2281, "verse_number": "८-२-४७", "content_sanskrit": "तथा राजन्महेष्वासो जलसन्धौ महाबलः।\nसुमहत्कदनं कृत्वा हतः सात्यकिना रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2059854, "chapter_id": 2281, "verse_number": "८-२-४८", "content_sanskrit": "अलम्बुसो राक्षसेन्द्रः खरबन्धुरयानवान्।\nघटोत्कचेन विक्रम्य गमितो यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2059855, "chapter_id": 2281, "verse_number": "८-२-४९", "content_sanskrit": "राधेयः सूतपुत्रश्च भ्रातरश्च महारथाः।\nकेकयाः सर्वशश्चापि निहताः स्व्यसाचिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2059856, "chapter_id": 2281, "verse_number": "८-२-५०", "content_sanskrit": "मालवा मद्रकाश्चैव द्राविडाश्चोग्रकर्मिणः।\nयौधेयाश्च ललित्थाश्च क्षुद्रकाश्चाप्युशीनराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2059857, "chapter_id": 2281, "verse_number": "८-२-५१", "content_sanskrit": "मावेल्लकास्तुण्डिकेराः सावित्रीपुत्रकाश्च ये।\nप्राच्योदीच्याः प्रतीच्याश्च दाक्षिणात्याश्च मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2059858, "chapter_id": 2281, "verse_number": "८-२-५२", "content_sanskrit": "पत्तीनां निहताः सङ्घा हयानां प्रयुतानि च।\nरथव्रजाश्च निहता हताश्च वरवारणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2059859, "chapter_id": 2281, "verse_number": "८-२-५३", "content_sanskrit": "सध्वजाः सायुधाः शूराः सवर्माम्बरभूषणाः।\nकालेन महताऽऽयस्ताः कुशलैर्ये च वर्धिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2059860, "chapter_id": 2281, "verse_number": "८-२-५४", "content_sanskrit": "ते हताः समरे राजन्पार्थेनाक्लिष्टकर्मणा।\nअन्ये तथाऽमितबलाः परस्परवधैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2059861, "chapter_id": 2281, "verse_number": "८-२-५५", "content_sanskrit": "एते चान्ये च बहवो राजानः सगणा रणे।\nहताः सहस्रशो राजन्यन्मां त्वं परिपृच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2059862, "chapter_id": 2281, "verse_number": "८-२-५६", "content_sanskrit": "एवमेष क्षयो वृत्तः कर्णार्जुनसमागमे।\nमहेन्द्रेण यथा वृत्रो यथा रामेण रावणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2059863, "chapter_id": 2281, "verse_number": "८-२-५७", "content_sanskrit": "यथा कृष्णेन नरको मुरुश्च निहतो रणे।\nकार्तवीर्यश्च रामेण भार्गवेण यथा हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2059864, "chapter_id": 2281, "verse_number": "८-२-५८", "content_sanskrit": "सज्ञातिबान्धवः शूरः समरे युद्धदुर्मदः।\nरणे कृत्वा महद्युद्धं घोरं त्रैलोक्यमोहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2059865, "chapter_id": 2281, "verse_number": "८-२-५९", "content_sanskrit": "यथा स्कन्देन महिषो यथा रुद्रेण चान्धकः।\nतथाऽर्जुनेन स हतो द्वैरथे युद्धदुर्मदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2059866, "chapter_id": 2281, "verse_number": "८-२-६०", "content_sanskrit": "सामात्यबान्धवो राजन्कर्णः प्रहरतां वरः।\nजयाशा धार्तराष्ट्राणां वैरस्य च मुखं नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2059867, "chapter_id": 2281, "verse_number": "८-२-६१", "content_sanskrit": "तीर्णं तत्पाण्डवै राजन्यत्पुरा नावबुध्यसे।\nउच्यमानो महाराज बन्धुभिर्हितकाङ्क्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2059868, "chapter_id": 2281, "verse_number": "८-२-६२", "content_sanskrit": "`न कृतं च त्वया पूर्वं दैवेन विधिना बलात्।\nतदिदं समनुप्राप्तं व्यसनं सुमहात्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2059869, "chapter_id": 2281, "verse_number": "८-२-६३", "content_sanskrit": "गाणां राज्यकामानां त्वया राजन्हितैषिणा।\nअहितान्येव चीर्णानि तेषां ते फलमागतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2059870, "chapter_id": 2281, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि द्वितीयोऽध्यायः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]