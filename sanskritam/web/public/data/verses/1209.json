[{"id": 2010367, "chapter_id": 1209, "verse_number": "१-२१०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010368, "chapter_id": 1209, "verse_number": "१-२१०-१", "content_sanskrit": "तत आहूय पाञ्चाल्यो राजपुत्रं युधिष्ठिरम्।\nपरिग्रहेण ब्राह्मेण परिगृह्य महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010369, "chapter_id": 1209, "verse_number": "१-२१०-२", "content_sanskrit": "पर्यपृच्छददीनात्मा कुन्तीपुत्रं सुवर्चसम्।\nकथं जानीम भवतः क्षत्रियान्ब्राह्मणानुत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010370, "chapter_id": 1209, "verse_number": "१-२१०-३", "content_sanskrit": "वैश्यान्वा गुणसंपन्नानथ वा शूद्रयोनिजान्।\nमायामास्थाय वा सिद्धांश्चरतः सर्वतोदिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010371, "chapter_id": 1209, "verse_number": "१-२१०-४", "content_sanskrit": "कृष्णाहेतोरनुप्राप्ता देवाः संदर्शनार्थिनः।\nब्रवीतु नो भवान्सत्यं सन्देहो ह्यत्र नो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010372, "chapter_id": 1209, "verse_number": "१-२१०-५", "content_sanskrit": "अपि नः संशयस्यान्ते मनः संतुष्टिमावहेत्।\nअपि नो भागधेयानि शुभानि स्युः परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010373, "chapter_id": 1209, "verse_number": "१-२१०-६", "content_sanskrit": "इच्छया ब्रूहि तत्सत्यं सत्यं राजसु शोभते।\nइष्टापूर्तेन च तथा वक्तव्यमनृतं न तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010374, "chapter_id": 1209, "verse_number": "१-२१०-७", "content_sanskrit": "श्रुत्वा ह्यमरसङ्काश तव वाक्यमरिंदम।\nध्रुवं विवाहकरणमास्थास्यामि विधानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010375, "chapter_id": 1209, "verse_number": "१-२१०-८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010376, "chapter_id": 1209, "verse_number": "१-२१०-८", "content_sanskrit": "मा राजन्विमना भूस्त्वं पाञ्चाल्य प्रीतिरस्तु ते।\nईप्सितस्ते ध्रुवः कामः संवृत्तोऽयमसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010377, "chapter_id": 1209, "verse_number": "१-२१०-९", "content_sanskrit": "वयं हि क्षत्रिया राजन्पाण्डोः पुत्रा महात्मनः।\nज्येष्ठं मां विद्धि कौन्तेयं भीमसेनार्जुनाविमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010378, "chapter_id": 1209, "verse_number": "१-२१०-१०", "content_sanskrit": "आभ्यां तव सुता राजन्निर्जिता राजसंसदि।\nयमौ च तत्र कुन्ती च यत्र कृष्मा व्यवस्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010379, "chapter_id": 1209, "verse_number": "१-२१०-११", "content_sanskrit": "व्येतु ते मानसं दुःखं क्षत्रियाः स्मो नरर्षभ।\nपद्मिनीव सुतेयं ते ह्रदादन्यह्रदं गता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010380, "chapter_id": 1209, "verse_number": "१-२१०-१२", "content_sanskrit": "इति तथ्यं महाराज सर्वमेतद्ब्रवीमि ते।\nभवान्हि गुरुरस्माकं परमं च परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010381, "chapter_id": 1209, "verse_number": "१-२१०-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010382, "chapter_id": 1209, "verse_number": "१-२१०-१३", "content_sanskrit": "ततः स द्रुपदो राजा हर्षव्याकुललोचनः।\nप्रतिवक्तुं मुदा युक्तो नाशकत्तं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010383, "chapter_id": 1209, "verse_number": "१-२१०-१४", "content_sanskrit": "यत्नेन तु स तं हर्षं सन्निगृह्य परंतपः।\nअनुरूपं तदा वाचा प्रत्युवाच युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010384, "chapter_id": 1209, "verse_number": "१-२१०-१५", "content_sanskrit": "पप्रच्छ चैनं धर्मात्मा यथा ते प्रद्रुताः पुरात्।\nस तस्मै सर्वमाचख्यावानुपूर्व्येण पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010385, "chapter_id": 1209, "verse_number": "१-२१०-१६", "content_sanskrit": "तच्छ्रुत्वा द्रुपदो राजा कुन्तीपुत्रस्य भाषितम्।\nविगर्हयामास तदा धृतराष्ट्रं नरेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010386, "chapter_id": 1209, "verse_number": "१-२१०-१७", "content_sanskrit": "आश्वासयामास च तं कुन्तीपुत्रं युधिष्ठिरम्।\nप्रतिजज्ञे च राज्याय द्रुपदो वदतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010387, "chapter_id": 1209, "verse_number": "१-२१०-१८", "content_sanskrit": "ततः कुन्ती च कृष्णा च भीमसेनार्जुनावपि।\nयमौ च राज्ञा संदिष्टं विविशुर्भवनं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010388, "chapter_id": 1209, "verse_number": "१-२१०-१९", "content_sanskrit": "तत्र ते न्यवसन्राजन्यज्ञसेनेन पूजिताः।\nप्रत्याश्वस्तस्ततो राजा सह पुत्रैरुवाच तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010389, "chapter_id": 1209, "verse_number": "१-२१०-२०", "content_sanskrit": "गृह्णातु विधिवत्पाणिमद्यायं कुरुनन्दनः।\nपुण्येऽहनि महाबाहुरर्जुनः कुरुतां क्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010390, "chapter_id": 1209, "verse_number": "१-२१०-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010391, "chapter_id": 1209, "verse_number": "१-२१०-२१", "content_sanskrit": "तमब्रवीत्ततो राजा धर्मात्मा च युधिष्ठिरः।\nममापि दारसंबन्धः कार्यस्तावद्विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010392, "chapter_id": 1209, "verse_number": "१-२१०-२२", "content_sanskrit": "तस्मात्पूर्वं मया कार्यं तद्भवाननुमन्यताम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2010393, "chapter_id": 1209, "verse_number": "१-२१०-२२x", "content_sanskrit": "द्रुपद उवाच।\nभवान्वा विधिवत्पाणिं गृह्णातु दुहितुर्मम।\nयस्य वा मन्यसे वीर तस्य कृष्णामुपादिश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2010394, "chapter_id": 1209, "verse_number": "१-२१०-२३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2010395, "chapter_id": 1209, "verse_number": "१-२१०-२३", "content_sanskrit": "सर्वेषां महिषी राजन्द्रौपदी नो भविष्यति।\nएवं प्रव्याहृतं पूर्वं मम मात्रा विशांपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2010396, "chapter_id": 1209, "verse_number": "१-२१०-२४", "content_sanskrit": "अहं चाप्यनिविष्टो वै भीमसेनश्च पाण्डवः।\nपार्थेन विजिता चैषा रत्नभूता सुता तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2010397, "chapter_id": 1209, "verse_number": "१-२१०-२५", "content_sanskrit": "एष नः समयो राजँल्लब्धस्य सह भोजनम्।\nन च तं हातुमिच्छामः समयं राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2010398, "chapter_id": 1209, "verse_number": "१-२१०-२६", "content_sanskrit": "अक्रमेण निवेशे च धर्मलोपो महान्भवेत्।\nसर्वेषां धर्मतः कृष्णा महिषी नो भविष्यति।\nआनुपूर्व्येण सर्वेषां गृह्णातु ज्वलने करान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2010399, "chapter_id": 1209, "verse_number": "१-२१०-२७x", "content_sanskrit": "द्रुपद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2010400, "chapter_id": 1209, "verse_number": "१-२१०-२७", "content_sanskrit": "एकस्य बह्व्यो विहिता महिष्यः कुरुनन्दन।\nनैकस्या बहवः पुंसः श्रूयन्ते पतयः क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2010401, "chapter_id": 1209, "verse_number": "१-२१०-२८", "content_sanskrit": "सोऽयं न लोके वेदे वा जातु धर्मः प्रशस्ते।\nलोकवेदविरुद्धं त्वं नाधर्मं धर्मविच्छुचिः।\nकर्तुमर्हसि कौन्तेय कस्मात्ते बुद्धिरीदृशी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2010402, "chapter_id": 1209, "verse_number": "१-२१०-२९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2010403, "chapter_id": 1209, "verse_number": "१-२१०-२९", "content_sanskrit": "सूक्ष्मो धर्मो महाराज नास्य विद्मो वयं गतिम्।\nपूर्वेषामानुपूर्व्येण यातं वर्त्माऽनुयामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2010404, "chapter_id": 1209, "verse_number": "१-२१०-३०", "content_sanskrit": "न मे वागनृतं प्राह नाधर्मे धीयते मतिः।\nएवं चैव वदत्यम्बा मम चैतन्मनोगतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2010405, "chapter_id": 1209, "verse_number": "१-२१०-३१", "content_sanskrit": "आश्रमे रुद्रनिर्दिष्टाद्व्यासादेतन्मया श्रुतम्।\nएष धर्मो ध्रुवो राजंश्चरैनमविचारयन्।\nमा च शङ्का तत्र ते स्यात्कथंचिदपि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2010406, "chapter_id": 1209, "verse_number": "१-२१०-३२x", "content_sanskrit": "द्रुपद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2010407, "chapter_id": 1209, "verse_number": "१-२१०-३२", "content_sanskrit": "त्वं च कुन्ती च कौन्तय धृष्टद्युम्नश्च मे सुतः।\nकथयन्त्विति कर्तव्यं श्वः काल्ये करवामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2010408, "chapter_id": 1209, "verse_number": "१-२१०-३३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2010409, "chapter_id": 1209, "verse_number": "१-२१०-३३", "content_sanskrit": "ते समेत्य ततः सर्वे कथयन्ति स्म भारत।\nअथ द्वैपायनो राजन्नभ्यागच्छद्यदृच्छया॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2010410, "chapter_id": 1209, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि वैवाहिकपर्वणि दशाधिकद्विशततमोऽध्यायः॥ २१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]