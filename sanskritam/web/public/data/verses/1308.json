[{"id": 2014792, "chapter_id": 1308, "verse_number": "२-४९-१", "content_sanskrit": "भीष्म उवाच॥\nतथा भृगुकुले जन्म यदर्थं च महात्मनः।\nजामदग्न्य इति ख्यातः प्रादुर्भावश्च वैष्णवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014793, "chapter_id": 1308, "verse_number": "२-४९-२", "content_sanskrit": "जमदग्निसुतो राजन्त्रामो नाम स वीर्यवान्।\nहेहयान्तकरो राजन्स रामो बलिनां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014794, "chapter_id": 1308, "verse_number": "२-४९-३", "content_sanskrit": "कार्तावीर्यो महावीर्यो बलेनाप्रतिमस्तदा।\nरामेण जामदग्न्येन हतो विषममाचरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014795, "chapter_id": 1308, "verse_number": "२-४९-४", "content_sanskrit": "तं कार्तवीर्यं राजानं हेहयानामरिन्दमम्।\nरथस्थं पार्थिवं रामः पातयित्वाऽवधीद्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014796, "chapter_id": 1308, "verse_number": "२-४९-५", "content_sanskrit": "जम्भस्य यज्ञं हत्वा स ऋत्विजश्चैव संस्तरे।\nजम्भस्य मूर्ध्नि भेत्ता च हन्ता च शतदुन्दुभेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014797, "chapter_id": 1308, "verse_number": "२-४९-६", "content_sanskrit": "स एष कृष्णो गोविन्दो जातो भृगुषु वीर्यवान्।\nसहस्रबाहुमुद्धर्तुं सहस्रजितमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014798, "chapter_id": 1308, "verse_number": "२-४९-७", "content_sanskrit": "क्षत्रियाणां चतुष्पष्टिमयुतानि महायशाः।\nसरस्वत्यां समेतानि एष वै धनुषाऽजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014799, "chapter_id": 1308, "verse_number": "२-४९-८", "content_sanskrit": "ब्रह्मद्विषां धे तस्मिन्महस्राणि चतुर्दश।\nपुनर्जघान शूराणामतिक्रूरो रथर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014800, "chapter_id": 1308, "verse_number": "२-४९-९", "content_sanskrit": "ततो राज्ञां सहस्रं स भङ्क्ता पूर्वमरिन्दमः।\nसहस्रं मुसलेनाहन्सहस्रमुदकृन्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014801, "chapter_id": 1308, "verse_number": "२-४९-१०", "content_sanskrit": "चतुर्दशसहस्राणि कृणदूममपाययत्।\nशिष्टान्ब्रह्मद्विषो जित्वा ततोऽस्नायत भार्गवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014802, "chapter_id": 1308, "verse_number": "२-४९-११", "content_sanskrit": "रामरामेत्यमिक्रुष्टो ब्राह्मणैः क्षत्रियार्दितैः।\nनिघ्नञ्शतसहस्राणि रामः परशुनाभिभूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014803, "chapter_id": 1308, "verse_number": "२-४९-१२", "content_sanskrit": "न ह्यमृष्यत तां वाचमार्तैर्भृशमुदीरिताम्।\nभृगो रामाभिधावेति यदाऽक्रन्दन्द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014804, "chapter_id": 1308, "verse_number": "२-४९-१३", "content_sanskrit": "काश्मीरान्दरदान्कुन्तीन्क्षुद्रकान्मालवाञ्छवान्।\nचेदिकाशिकरूशांश्च ऋषिकान्क्रथकैशिकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014805, "chapter_id": 1308, "verse_number": "२-४९-१४", "content_sanskrit": "अङ्गान्वङ्गान्कलिङ्गांश्च मागधान्काशिकोसलान्।\nरात्रायणान्वीतिहोत्रान्किरातान्कार्तिकावतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014806, "chapter_id": 1308, "verse_number": "२-४९-१५", "content_sanskrit": "एतानन्यांश्च राजन्यान्देशेदेशे सहस्रशः।\nनिकृत्य निशितैर्बाणैः सम्प्रदाय विवस्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014807, "chapter_id": 1308, "verse_number": "२-४९-१६", "content_sanskrit": "कीर्णा क्षत्रियकोटीभिर्मेरुमन्दरभूषणा।\nत्रिः सप्तकृत्वः पृथिवी तेन निःक्षत्रिया कृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014808, "chapter_id": 1308, "verse_number": "२-४९-१७", "content_sanskrit": "कृत्वा निःक्षत्रियां चैव भार्गवः स महायशाः।\nइन्द्रगोपकवर्णस्य जीवञ्जीवनिभस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014809, "chapter_id": 1308, "verse_number": "२-४९-१८", "content_sanskrit": "पूरयित्वा च सरितः क्षतजस्य सरांसि च।\nचकार तर्पणं वीरः पितॄणां तासु तेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014810, "chapter_id": 1308, "verse_number": "२-४९-१९", "content_sanskrit": "सर्वानष्टादश द्वीपान्वशमानीय भार्गवः।\nसोऽश्वमेधसहस्राणि नरमेधशतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014811, "chapter_id": 1308, "verse_number": "२-४९-२०", "content_sanskrit": "इष्ट्वा सागरपर्यन्तां काश्यपाय महीं ददौ।\nतस्याग्रेणानुपर्येति भूमिं कृत्वा विपांसुलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014812, "chapter_id": 1308, "verse_number": "२-४९-२१", "content_sanskrit": "ततः कालकृतां सत्यां भार्गवाय महात्मने।\nगाधामप्यत्र गायन्ति ये पुराणविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014813, "chapter_id": 1308, "verse_number": "२-४९-२२", "content_sanskrit": "वेदिमष्टादशोत्सेधां हिरण्यस्यातिपौरुषीम्।\nरामेण जामदग्न्येन प्रतिजग्राह काश्यपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014814, "chapter_id": 1308, "verse_number": "२-४९-२३", "content_sanskrit": "एवमिष्ट्वा महाबाहुः क्रतुभिर्भूरिदक्षिणैः।\nअन्यद्वर्षशतं रामः सौभे साल्वमयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014815, "chapter_id": 1308, "verse_number": "२-४९-२४", "content_sanskrit": "ततः स भृगुशार्दूलस्तं सौभं योधयन्प्रभुः।\nसुबन्धुरं रथं राजन्नास्थाय भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014816, "chapter_id": 1308, "verse_number": "२-४९-२५", "content_sanskrit": "नग्निकानां कुमारीणां गायन्तीनामुपाशृणोत्।\nरामराम महाबाहो भृगूणां कीर्तिवर्धन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014817, "chapter_id": 1308, "verse_number": "२-४९-२६", "content_sanskrit": "त्यज शस्त्राणि सर्वाणि न त्वं सौभं वधिष्यसि।\nशङ्खचक्रगदापाणिर्देवानामभयङ्गरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014818, "chapter_id": 1308, "verse_number": "२-४९-२७", "content_sanskrit": "युधि प्रद्युम्नसाम्बाभ्यां कृष्णः सौभं वधिष्यति।\nतच्छ्रुत्वा पुरुषव्याघ्रस्तत एव वनं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014819, "chapter_id": 1308, "verse_number": "२-४९-२८", "content_sanskrit": "न्यस्य सर्वाणि शस्त्राणि कालकाङ्क्षी महायशाः।\nरथं सर्वायुधं चैव शरान्परशुमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014820, "chapter_id": 1308, "verse_number": "२-४९-२९", "content_sanskrit": "धनूंष्यप्सु प्रतिष्ठाप्य रामस्तेपे परं तपः।\nह्रियं प्रज्ञां श्रियं कीर्तिं लक्ष्मीं चामित्रकर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014821, "chapter_id": 1308, "verse_number": "२-४९-३०", "content_sanskrit": "पञ्चाधिष्ठाय धर्मात्मा तं रथं विससर्ज ह।\nआदिकाले प्रवृत्तं तु व्यभजत्करमीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014822, "chapter_id": 1308, "verse_number": "२-४९-३१", "content_sanskrit": "नाघ्नतं श्रद्धया सौभं न ह्यशक्तो महायशाः।\nजामदग्न्य इति ख्यातो यस्त्वयं भगवानुपिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014823, "chapter_id": 1308, "verse_number": "२-४९-३२", "content_sanskrit": "सोऽस्य भागस्तपस्तेपे भार्गवो लोकविश्रुतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2014824, "chapter_id": 1308, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि एकोनपञ्चाशोऽध्यायः॥ ४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]