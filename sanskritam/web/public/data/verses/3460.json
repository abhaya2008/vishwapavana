[{"id": 2114410, "chapter_id": 3460, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114411, "chapter_id": 3460, "verse_number": "१", "content_sanskrit": "द्रुपदस्यापि ब्रह्मर्षे श्रोतुमिच्छामि सम्भवम् ।\nकथं चापि समुत्पन्नः कथमस्त्राण्यवाप्तवान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114412, "chapter_id": 3460, "verse_number": "२", "content_sanskrit": "एतदिच्छामि भगवन् त्वत्तः श्रोतुं द्विजोत्तम ।\nकौतूहलं जन्मसु मे कथ्यमानेष्वतीव हि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114413, "chapter_id": 3460, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114414, "chapter_id": 3460, "verse_number": "३", "content_sanskrit": "राजा बभूव पाञ्चालः पुत्रार्थी पुत्रकारणात् ।\nवनं गतो महाराज तपस्तेपे सुदारुणम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114415, "chapter_id": 3460, "verse_number": "४", "content_sanskrit": "आराधयन् प्रयत्नेन तस्यापत्यस्य कारणात् ।\nतस्य सन्तप्यमानस्य वने मृगगणायुते \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114416, "chapter_id": 3460, "verse_number": "५", "content_sanskrit": "कालस्तु सुमहान् राजन् व्यत्ययात् सुतकारणात् ।\nस तु राजन् महातेजाः तपस्तीव्रं समाददे \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114417, "chapter_id": 3460, "verse_number": "६", "content_sanskrit": "कञ्चित्कालं वायुभक्षो निराहारस्तथैव च ।\nतस्यैवं सुमहाबाहोर्वर्तमानस्य भारत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114418, "chapter_id": 3460, "verse_number": "७", "content_sanskrit": "दशवर्षसहस्रान्ते तद्वने समभून्नृप ।\nवसन्तः सुखदः कालः स तु कामप्रदीपनः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114419, "chapter_id": 3460, "verse_number": "८", "content_sanskrit": "फुल्लाशोकवने चैव प्राणिनां सुमनोरमे ।\nनद्यास्तीरमथो गत्वा गङ्गायाः पद्मलोचनः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114420, "chapter_id": 3460, "verse_number": "९", "content_sanskrit": "नियमस्थश्च राजाऽऽसीत् तथा भरतसत्तम ।\nततो नातिचिरात् कालाद् वनं तन्मनुजेश्वर\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114421, "chapter_id": 3460, "verse_number": "१०", "content_sanskrit": "सम्प्राप्ता ह्यप्सरा राजन् मेनकेत्यभिविश्रुता ।\nनद्यास्तीरे चरन्ती वै क्रीडन्ती च पुनः पुनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114422, "chapter_id": 3460, "verse_number": "११", "content_sanskrit": "तस्यां च विलपन्त्यां वै राज्ञो दर्शनमागता ।\nददर्श सा तु राजनं तथा स्थानगतं नृपः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114423, "chapter_id": 3460, "verse_number": "१२", "content_sanskrit": "दृष्ट्वा चाप्सरसं तां तु शुक्रं राज्ञोऽपतद् भुवि ।\nतच्च राजा तु राजेन्द्र लज्जया नृपतिः स्वयम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114424, "chapter_id": 3460, "verse_number": "१३", "content_sanskrit": "पद्भ्यामाक्रमदायुष्मंस्तस्मात् तु द्रुपदोऽभवत् ।\nततस्तु तस्य तपसा राजर्षेर्भावितात्मनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114425, "chapter_id": 3460, "verse_number": "१४", "content_sanskrit": "पुत्रः समभवद् राज्ञः पादात् तस्यान्तरेण तु ।\nते तस्य ऋषयः सर्वे समागम्य तपोधनाः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114426, "chapter_id": 3460, "verse_number": "१५", "content_sanskrit": "नाम चक्रुर्हि विद्वांसो द्रुपदोऽस्त्विति भूमिप ।\nस तस्यैवाश्रमे राजन् भरद्वाजस्य भारत \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114427, "chapter_id": 3460, "verse_number": "१६", "content_sanskrit": "ववृधे च सुखं तत्र कामैः सर्वैर्नृपोत्तम ।\nपाञ्चालोऽपि हि राजेन्द्र स्वराज्यं गतवान् प्रभुः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114428, "chapter_id": 3460, "verse_number": "१७", "content_sanskrit": "भरद्वाजाय शिष्यार्थं सुतं दत्वा महात्मने ।\nस कुमारस्ततो राजन् द्रोणेन सहितो वने \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114429, "chapter_id": 3460, "verse_number": "१८", "content_sanskrit": "वेदांश्चाधिजगे साङ्गान् धनुर्वेदं च भारत ।\nपरया च मुदा युक्तो विचचार वने सुखम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114430, "chapter_id": 3460, "verse_number": "१९", "content_sanskrit": "तस्यैवं वर्तमानस्य वने वनचरैः सह ।\nकालान्नातिचिराद् राजन् पिता स्वर्गमुपेयिवान् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114431, "chapter_id": 3460, "verse_number": "२०", "content_sanskrit": "स समागम्य पाञ्चालैः पाञ्चालेष्वभिषेचितः ।\nप्राप्तश्च राज्यं राजेन्द्र सुहृदां प्रीतिवर्धनः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114432, "chapter_id": 3460, "verse_number": "२१", "content_sanskrit": "प्रजा ररक्ष धर्मेण यथा चेन्द्रस्त्रिविष्टपे ।\nएतन्मया ते राजेन्द्र यथावत् परिकीर्तितम् ।\nद्रुपदस्य जन्म राजर्षेर्धृष्टद्युम्नस्य चैव हि \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114433, "chapter_id": 3460, "verse_number": "१३९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोनचत्वारिंशत्यधिकशततमोऽध्यायः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114434, "chapter_id": 3460, "verse_number": "८७", "content_sanskrit": "॥ इति सम्भवपर्वणि सप्ताशीतितमोऽध्यायः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114435, "chapter_id": 3460, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]