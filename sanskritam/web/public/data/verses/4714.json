[{"id": 2175129, "chapter_id": 4714, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175130, "chapter_id": 4714, "verse_number": "१", "content_sanskrit": "आर्ष्टिषेणः कथं ब्रह्मन् विपुलं तप्तवांस्तपः ।\nसिन्धुद्वीपः कथं चापि ब्राह्मण्यँल्लब्धवान् पुरा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175131, "chapter_id": 4714, "verse_number": "२", "content_sanskrit": "देवापिश्च कथं राजन् विश्वामित्रश्च सत्तम\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175132, "chapter_id": 4714, "verse_number": "३", "content_sanskrit": "तन्ममाचक्ष्व भगवन् परं कौतूहलं हि मे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175133, "chapter_id": 4714, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175134, "chapter_id": 4714, "verse_number": "४", "content_sanskrit": "पुरा कृतयुगे राजन्नार्ष्टिषेणो द्विजोत्तमः ।\nवसन् गुरुकुले नित्यं नियमाध्ययने रतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175135, "chapter_id": 4714, "verse_number": "५", "content_sanskrit": "तस्य राजन् गुरुकुले वसतो नित्यमेव हि ।\nसमाप्तिं नागमन् विद्या नापि वेदा विशाम्पते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175136, "chapter_id": 4714, "verse_number": "६", "content_sanskrit": "स निर्विण्णस्ततो राजन् तपस्तेपे महातपाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175137, "chapter_id": 4714, "verse_number": "७", "content_sanskrit": "ततो वै तपसा तेन प्राप्य वेदाननुत्तमान् ।\nस विद्वान् वेदसंयुक्तः सिद्धश्चाप्यृषिसत्तमः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175138, "chapter_id": 4714, "verse_number": "८", "content_sanskrit": "तत्र तीर्थे वरान् प्रादात् त्रीनेव सुमहातपाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175139, "chapter_id": 4714, "verse_number": "", "content_sanskrit": "आर्ष्टिषेणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175140, "chapter_id": 4714, "verse_number": "९", "content_sanskrit": "अस्मिंस्तीर्थे महानद्या अद्यप्रभृति मानवः ।\nआप्लुतो वाजपेयस्य फलं प्राप्नोति पुष्कलम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175141, "chapter_id": 4714, "verse_number": "१०", "content_sanskrit": "अद्यप्रभृति व्यालेभ्यो न भयं भविता पुनः ।\nअपि चाल्पेन यत्नेन तपः प्राप्स्यति पुष्कलम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2175142, "chapter_id": 4714, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2175143, "chapter_id": 4714, "verse_number": "११", "content_sanskrit": "एवमुक्त्वा महातेजा जगाम त्रिदिवं मुनिः ।\nएवं स सिद्धो भगवान् आर्ष्टिषेणः प्रतापवान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2175144, "chapter_id": 4714, "verse_number": "१२", "content_sanskrit": "तस्मिन्नेव तदा तीर्थे सिन्धुद्वीपः प्रतापवान् ।\nदेवापिश्च महाराज ब्राह्मण्यं प्रापतुर्महत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2175145, "chapter_id": 4714, "verse_number": "१३", "content_sanskrit": "तथा कुशिकदायादस्तपोनित्यो जितेन्द्रियः ।\nतपसा वै सुतप्तेन ब्राह्मणत्वमवाप्तवान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2175146, "chapter_id": 4714, "verse_number": "१४", "content_sanskrit": "गाधिर्नाम महानासीत् क्षत्रियप्रवरो भुवि ।\nतस्य पुत्रस्त्वभूद् राजन् विश्वामित्रः प्रतापवान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2175147, "chapter_id": 4714, "verse_number": "१५", "content_sanskrit": "स राजा कौशिकस्तात महायोग्यभवत् किल ।\nस पुत्रमभिषिच्यैव विश्वामित्रं महातपाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2175148, "chapter_id": 4714, "verse_number": "१६", "content_sanskrit": "देहन्यासे मनश्चक्रे तमूचुः प्रणताः प्रजाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2175149, "chapter_id": 4714, "verse_number": "", "content_sanskrit": "प्रजाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2175150, "chapter_id": 4714, "verse_number": "१७", "content_sanskrit": "न गन्तव्यं महाप्राज्ञ त्राहि चास्मान् महाभयात्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2175151, "chapter_id": 4714, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2175152, "chapter_id": 4714, "verse_number": "१८", "content_sanskrit": "एवमुक्तः प्रत्युवाच ततो गाधिः प्रजास्ततः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2175153, "chapter_id": 4714, "verse_number": "", "content_sanskrit": "गाधिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2175154, "chapter_id": 4714, "verse_number": "१९", "content_sanskrit": "कृत्स्नस्य जगतो गोप्ता भविष्यति सुतो मम\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2175155, "chapter_id": 4714, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2175156, "chapter_id": 4714, "verse_number": "२०", "content_sanskrit": "इत्युक्त्वाऽथ ततो गाधिर्विश्वामित्रं निवेश्य च ।\nजगाम स तदा राजा पथि वै पुण्यकर्मणाम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2175157, "chapter_id": 4714, "verse_number": "२१", "content_sanskrit": "तदा गाधिसुतो राजा विश्वामित्रोऽप्यभून्नृपः ।\nन च शक्नोति पृथिवीं यत्नवानपि रक्षितुम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2175158, "chapter_id": 4714, "verse_number": "२२", "content_sanskrit": "ततः शुश्राव राजाऽसौ राक्षसेभ्यो महद् भयम् ।\nनिर्ययौ नगराच्चापि चतुरङ्गबलान्वितः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2175159, "chapter_id": 4714, "verse_number": "२३", "content_sanskrit": "स गत्वा दूरमध्वानं वसिष्ठाश्रममुत्तमम् ।\nततस्ते सैनिका राजन् जघ्नुस्तत्र बहून् मृगान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2175160, "chapter_id": 4714, "verse_number": "२४", "content_sanskrit": "ततस्तु भगवान् विप्रो वसिष्ठस्तु स्व आश्रमे ।\nददृशे तु ततः सर्वं वध्यमानं महावनम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2175161, "chapter_id": 4714, "verse_number": "२५", "content_sanskrit": "तस्य क्रुद्धो महाराज वसिष्ठो मुनिसत्तमः ।\nविसृजस्व बलं घोरमिति स्वां गामुवाच ह\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2175162, "chapter_id": 4714, "verse_number": "२६", "content_sanskrit": "तथोक्ता साऽसृजद् धेनुः पुरुषान् घोरदर्शनान् ।\nते च तद्बलमासाद्य बभञ्जुः सर्वतोदिशम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2175163, "chapter_id": 4714, "verse_number": "२७", "content_sanskrit": "तद् दृष्ट्वा विद्रुतं सैन्यं विश्वामित्रस्तु गाधिजः ।\nतपः परं मन्यमानः तपस्येव मनो दधे\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2175164, "chapter_id": 4714, "verse_number": "२८", "content_sanskrit": "सोऽस्मिंस्तीर्थवरे राजन् सरस्वत्यां समाहितः ।\nनियमैश्चोपवासैश्च क्षपयन् देहमात्मनः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2175165, "chapter_id": 4714, "verse_number": "२९", "content_sanskrit": "जलाहारो वायुभक्षः पर्णाहारश्च सोऽभवत् ।\nततः स्थण्डिलशायी च ये चान्ये नियमाः पृथक्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2175166, "chapter_id": 4714, "verse_number": "३०", "content_sanskrit": "असकृत् तस्य देवाश्च व्रतविघ्नं प्रचक्रिरे ।\nन तस्य नियमाद् बुद्धिरपयाति महात्मनः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2175167, "chapter_id": 4714, "verse_number": "३१", "content_sanskrit": "ततः परेण यत्नेन तप्त्वा बहुविधं तपः ।\nतेजसा भास्कराकारो गाधिजः समपद्यत\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2175168, "chapter_id": 4714, "verse_number": "३२", "content_sanskrit": "घृणया तु तदा युक्तो विश्वामित्रं पितामहः ।\nअमन्यत महातेजा वरदोऽदर्शयत् तदा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2175169, "chapter_id": 4714, "verse_number": "३३", "content_sanskrit": "स तु वव्रे वरं राजन् स्यामहं ब्राह्मणस्त्विति ।\nतथेति चाब्रवीद् ब्रह्मा सर्वलोकपितामहः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2175170, "chapter_id": 4714, "verse_number": "३४", "content_sanskrit": "स लब्ध्वा तपसोग्रेण ब्राह्मण्यं सुमहायशाः ।\nविचचार महीं कृत्स्नां कृतकामः सुरोपमः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2175171, "chapter_id": 4714, "verse_number": "३५", "content_sanskrit": "तस्मिंस्तीर्थवरे रामः प्रदाय विविधं वसु ।\nपयस्विनीस्तथा धेनूर्यानानि विविधानि च\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2175172, "chapter_id": 4714, "verse_number": "३६", "content_sanskrit": "तथा वस्त्राण्यलङ्कारं भक्ष्यं पेयं च शोभनम् ।\nअददान्मुदितो राजन् पूजयित्वा द्विजोत्तमान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2175173, "chapter_id": 4714, "verse_number": "३७", "content_sanskrit": "ययौ राजंस्ततो रामो बकस्याश्रममन्तिकात् ।\nयत्र तेपे तपस्तीव्रं बको दाल्भ्य इति श्रुतिः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2175174, "chapter_id": 4714, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि विश्वामित्रचरितं नाम द्वादशोऽध्यायः ॥१२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]