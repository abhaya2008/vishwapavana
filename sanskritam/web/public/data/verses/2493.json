[{"id": 2070897, "chapter_id": 2493, "verse_number": "११-२५-०x", "content_sanskrit": "गान्धार्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070898, "chapter_id": 2493, "verse_number": "११-२५-१", "content_sanskrit": "काम्भोजं पश्य दुर्धर्षं काम्भोजास्तरणोचितम्।\nशयानमृषभस्कन्धं हतं पांसुषु माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070899, "chapter_id": 2493, "verse_number": "११-२५-२", "content_sanskrit": "अस्य क्षतजसन्दिग्धौ बाहू चन्दनरूषितौ।\nअवेक्ष्य कृपणं भार्या विलपत्यतिदुःखिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070900, "chapter_id": 2493, "verse_number": "११-२५-३", "content_sanskrit": "इमौ तौ परिघप्रख्यौ बाहू चन्दनरूषितौ।\nययोर्विवरमापन्नां न रतिर्मां पुराऽजहात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070901, "chapter_id": 2493, "verse_number": "११-२५-४", "content_sanskrit": "कां गतिं तु गमिष्यामि त्वया हीना जनेश्वर।\nदूरबन्धुरनाथा च वेपन्ती मधुरस्वरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070902, "chapter_id": 2493, "verse_number": "११-२५-५", "content_sanskrit": "आतपे क्लाम्यमानानां विविधानामिव स्रुजाम्।\nक्लान्तानामपि नारीणां जहाति श्रीर्न वै तनूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070903, "chapter_id": 2493, "verse_number": "११-२५-६", "content_sanskrit": "शयानमभितः शूरं कालिङ्गं मधुसूदन।\nपश्य दीप्ताङ्गदयुतं प्रतिमानं धनुष्मताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070904, "chapter_id": 2493, "verse_number": "११-२५-७", "content_sanskrit": "मागधानामधिपतिं जयत्सेनं जनार्दन।\nपरिवार्य प्ररुदिता मागध्यः पश्य योषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070905, "chapter_id": 2493, "verse_number": "११-२५-८", "content_sanskrit": "हरिणायतनेत्राणां सुस्वराणां जनार्दन।\nमनः श्रुतिहरो नादो मनो मोहयतीव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070906, "chapter_id": 2493, "verse_number": "११-२५-९", "content_sanskrit": "प्रकीर्णवस्त्राभरणा रुदत्यः शोककर्शिताः।\nस्वास्तीर्णशयनोपेता मागध्यः शेरते भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070907, "chapter_id": 2493, "verse_number": "११-२५-१०", "content_sanskrit": "कोसलानामधिपतिं राजपुत्रं बृहद्बलम्।\nभर्तारं परिवार्यैताः पृथक्प्ररुदिताः स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070908, "chapter_id": 2493, "verse_number": "११-२५-११", "content_sanskrit": "अस्य गात्रगतान्बाणान्कार्ष्णिबाहुबलेरितान्।\nउद्धरन्त्यसुखाविष्टा मूर्च्छमानाः पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070909, "chapter_id": 2493, "verse_number": "११-२५-१२", "content_sanskrit": "आसां सर्वानवद्यानामातपेन परिश्रमात्।\nप्रम्लाननलिनाभानि भान्ति वक्त्राणि माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070910, "chapter_id": 2493, "verse_number": "११-२५-१३", "content_sanskrit": "द्रोणेन निहताः शूरा शेरते रुचिराङ्गदाः।\nधृष्टद्युम्नसुताः सर्वे शिशवो हेममालिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070911, "chapter_id": 2493, "verse_number": "११-२५-१४", "content_sanskrit": "रथाग्न्यगारं चापार्चिं शरशक्तिगदेन्धनम्।\nद्रोणमासाद्य निर्दग्धाः शलभा इव पावकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070912, "chapter_id": 2493, "verse_number": "११-२५-१५", "content_sanskrit": "तथैव निहताः शूराः शेरते रुचिराङ्गदाः।\nद्रोणेनाभिमुखाः सङ्ख्ये भ्रातरः पञ्च केकयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070913, "chapter_id": 2493, "verse_number": "११-२५-१६", "content_sanskrit": "तप्तकाञ्चनवर्माणस्तालध्वजस्थव्रजाः।\nभासयन्ति महीं भासा ज्वलिता इव पावकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070914, "chapter_id": 2493, "verse_number": "११-२५-१७", "content_sanskrit": "द्रोणेन द्रुपदं सङ्ख्ये पश्य माधव पातितम्।\nमहाद्विपमिवारण्ये सिंहेन महता हतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070915, "chapter_id": 2493, "verse_number": "११-२५-१८", "content_sanskrit": "पाञ्चालराज्ञो विमलं पुण्डरीकाक्ष पाण्डुरम्।\nआतपत्रं समाभाति शरदीव निशाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070916, "chapter_id": 2493, "verse_number": "११-२५-१९", "content_sanskrit": "एतास्तु द्रुपदं वृद्धं स्नुषा भार्याश्च दुःखिताः।\nदग्ध्वा गच्छन्ति पाञ्चालराजानमपसव्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070917, "chapter_id": 2493, "verse_number": "११-२५-२०", "content_sanskrit": "धृष्टकेतुं महात्मानं चेदिपुङ्गवमङ्गनाः।\nद्रोणेन निहतं शूरं हरन्ति हृतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070918, "chapter_id": 2493, "verse_number": "११-२५-२१", "content_sanskrit": "द्रोणास्त्रमभिहत्यैष विमर्दे मधुसूदन।\nमहेष्वासो हतः शेते वज्राहत इव द्रुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070919, "chapter_id": 2493, "verse_number": "११-२५-२२", "content_sanskrit": "एष चेदिपतिः शूरो धृष्टकेतुर्महारथः।\nशेते विनिहतः सङ्ख्ये हत्वा शत्रून्सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070920, "chapter_id": 2493, "verse_number": "११-२५-२३", "content_sanskrit": "वितुद्यमानं विहगैस्तं भार्याः पर्युपाश्रिताः।\nचेदिराजं हृषीकेश हतं सबलबान्धवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070921, "chapter_id": 2493, "verse_number": "११-२५-२४", "content_sanskrit": "दाशार्हपुत्रजं वीरं शयानं सत्यविक्रमम्।\nआरोप्याङ्के रुदन्त्येताश्चेदिराज वराङ्गनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2070922, "chapter_id": 2493, "verse_number": "११-२५-२५", "content_sanskrit": "अस्य पुत्रं हृषीकेश सुवक्त्रं चारुकुण्डलम्।\nद्रोणेन समरे पश्य निकृत्तं बहुधा शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2070923, "chapter_id": 2493, "verse_number": "११-२५-२६", "content_sanskrit": "पितरं नूनमाजिस्थं युध्यमानं परैः सह।\nनाजहात्पितरं वीरमद्यापि मधुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2070924, "chapter_id": 2493, "verse_number": "११-२५-२७", "content_sanskrit": "एवं ममापि पुत्रस्य पुत्रः पितरमन्वगात्।\nदुर्योधनं महाबाहो लक्ष्मणः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2070925, "chapter_id": 2493, "verse_number": "११-२५-२८", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ पतितौ पश्य माधव।\nहिमान्ते पुष्पितौ शालौ मरुता गलिताविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2070926, "chapter_id": 2493, "verse_number": "११-२५-२९", "content_sanskrit": "काञ्चनाङ्गदवर्माणौ बाणखङ्गधनुर्धरौ।\nऋषभप्रतिरूपाक्षौ शयानौ विमलस्रजौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2070927, "chapter_id": 2493, "verse_number": "११-२५-३०", "content_sanskrit": "अवध्याः पाण्डवाः कृष्ण सर्व एव त्वया सह।\nये मुक्ता द्रोणभीष्माभ्यां कर्णाद्वैकर्तनात्कृपात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2070928, "chapter_id": 2493, "verse_number": "११-२५-३१", "content_sanskrit": "दुर्योधनाद्द्रोणसुतात्सैन्धवाच्च जयद्रथात्।\nसोमदत्ताद्विकर्णाच्च शूराच्च कृतवर्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2070929, "chapter_id": 2493, "verse_number": "११-२५-३२", "content_sanskrit": "ये हन्युः शस्त्रवेगेन देवानपि नरर्षभाः।\nत इमे निहताः सङ्ख्ये पश्य कालस्य पर्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2070930, "chapter_id": 2493, "verse_number": "११-२५-३३", "content_sanskrit": "नातिभारोऽस्ति दैवस्य ध्रुवं माधव कश्चन।\nयदिमे निहताः शूराः क्षत्रियैः क्षत्रियर्षभाः।\n`शूराश्च कृतविद्याश्च मम पुत्रा मनस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2070931, "chapter_id": 2493, "verse_number": "११-२५-३४", "content_sanskrit": "तदैव निहताः कृष्ण मम पुत्रास्तरस्विनः।\nयदैवाकृतकामस्त्वमुपप्लाव्यं गतः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2070932, "chapter_id": 2493, "verse_number": "११-२५-३५", "content_sanskrit": "शन्तनोश्चैव पुत्रेण प्राज्ञेन विदुरेण च।\nतदैवोक्तास्मि मा स्नेहं कुरुष्वात्मसुतेष्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2070933, "chapter_id": 2493, "verse_number": "११-२५-३६", "content_sanskrit": "तयोर्हि दर्शनं नैतन्मिथ्या भवितुमर्हति।\nअचिरेणैव मे पुत्रा भस्मीभूता जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2070934, "chapter_id": 2493, "verse_number": "११-२५-३७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2070935, "chapter_id": 2493, "verse_number": "११-२५-३७", "content_sanskrit": "इत्युक्त्वा न्यपतद्भूमौ गान्धारी शोकमूर्च्छिता।\nदुःखोपहतविज्ञाना धैर्यमुत्सृज्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2070936, "chapter_id": 2493, "verse_number": "११-२५-३८", "content_sanskrit": "ततः कोपपरीताङ्गी पुत्रशोकपरिप्लुता।\nजगाद शौरिं दोषेण गान्धारी व्यथितेन्द्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2070937, "chapter_id": 2493, "verse_number": "११-२५-३९x", "content_sanskrit": "गान्धार्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2070938, "chapter_id": 2493, "verse_number": "११-२५-३९", "content_sanskrit": "पाण्डवाः धार्तराष्ट्राश्च क्रुद्धाः कृष्ण परस्परम्।\nउपेक्षिता विनश्यन्तस्त्वया कस्माज्जनार्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2070939, "chapter_id": 2493, "verse_number": "११-२५-४०", "content_sanskrit": "शक्तेन बहुभृत्येन विपुले तिष्ठता बले।\nउभयत्र समर्थेन श्रुतवाक्येन चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2070940, "chapter_id": 2493, "verse_number": "११-२५-४१", "content_sanskrit": "इच्छतोपेक्षितो नाशः कुरूणां मधुसूदन।\nयस्मात्त्वया महाबाहो फलं तस्मादवाप्नुहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2070941, "chapter_id": 2493, "verse_number": "११-२५-४२", "content_sanskrit": "पतिशुश्रूषया यन्मे तपः किञ्चिदुपार्जितम्।\nतेन त्वां दुरवापेन शपे चक्रगदाधरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2070942, "chapter_id": 2493, "verse_number": "११-२५-४३", "content_sanskrit": "यस्मात्परस्परं घ्नन्तो ज्ञातयः कुरुपाण्डवाः।\nउपेक्षितास्ते गोविन्द तस्माज्ज्ञातीन्वधिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2070943, "chapter_id": 2493, "verse_number": "११-२५-४४", "content_sanskrit": "त्वमप्युपस्थिते वर्षे षट्त्रिंशे मधुसूदन।\nहतज्ञातिर्हतामात्यो हतपुत्रो वनेचरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2070944, "chapter_id": 2493, "verse_number": "११-२५-४५", "content_sanskrit": "अनाथवदविज्ञातो लोकेष्वनभिलक्षितः।\nकुत्सितेनाभ्युपायेन निधनं समवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2070945, "chapter_id": 2493, "verse_number": "११-२५-४६", "content_sanskrit": "तवाप्येवं हतसुता निहतज्ञातिबान्धवाः।\nस्त्रियः परिपतिष्यन्ति यथैता भरतस्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2070946, "chapter_id": 2493, "verse_number": "११-२५-४७x", "content_sanskrit": "वैशम्पयन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2070947, "chapter_id": 2493, "verse_number": "११-२५-४७", "content_sanskrit": "तच्छ्रुत्वा वचनं घोरं वासुदेवो महामनाः।\nउवाच देवीं गान्धारीमीषदभ्युत्स्मयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2070948, "chapter_id": 2493, "verse_number": "११-२५-४८", "content_sanskrit": "जानेऽहमेतदप्येवं चीर्णं चरसि क्षत्रिये।\nदैवादेव विनश्यन्ति वृष्णयो नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2070949, "chapter_id": 2493, "verse_number": "११-२५-४९", "content_sanskrit": "संहर्ता वृष्णिचक्रस्य नान्यो मद्विद्यते शुभे।\nअवध्यास्ते नरैरन्यैरपि वा देवदानवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2070950, "chapter_id": 2493, "verse_number": "११-२५-५०", "content_sanskrit": "परस्परकृतं नाशं यतः प्राप्स्यन्ति यादवाः।\nइत्युक्तवति दाशार्हे पाण्डवास्त्रस्तचेतसः।\nबभूवुर्भृशसंविग्ना निराशाश्चापि जीविते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2070951, "chapter_id": 2493, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि स्त्रीविलापपर्वणि पञ्चविंशोऽध्यायः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]