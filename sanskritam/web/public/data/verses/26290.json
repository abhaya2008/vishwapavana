[{"id": 7006290000, "chapter_id": 26290, "verse_number": "३-४४-१", "content_sanskrit": "हयग्रीव उवाच प्रविश्य तु जपस्थानमानीय निजमासनम् ।\nअभ्युक्ष्य विधिवन्मन्त्रैर्गुरूक्तक्रमयोगतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006290001, "chapter_id": 26290, "verse_number": "३-४४-२", "content_sanskrit": "स्वात्मानं देवतामूर्तिं ध्यायंस्तत्राविशेषतः ।\nप्राङ्मुखो दृढमाबध्य पद्मासनमनन्यधीः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006290002, "chapter_id": 26290, "verse_number": "३-४४-३", "content_sanskrit": "त्रिखण्डामनुबध्नीयाद्गुर्वादीनभिवन्द्य च ।\nद्विरुक्तबालबीजानि मध्याद्यङ्गुलिषु क्रमात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006290003, "chapter_id": 26290, "verse_number": "३-४४-४", "content_sanskrit": "तलयोरपि विन्यस्य करशुद्धिपुरःसरम् ।\nअग्निप्राकारपर्यन्तं कुर्यात्स्वास्त्रेण मन्त्रवित् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006290004, "chapter_id": 26290, "verse_number": "३-४४-५", "content_sanskrit": "प्रतिलोमेन पादाद्यमनुलोमेन कादिकम् ।\nव्याप कन्यासमारोप्य व्यापयन्वाग्भवादिभिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006290005, "chapter_id": 26290, "verse_number": "३-४४-६", "content_sanskrit": "व्यक्तैः कारमसूक्ष्मस्थूलशरीराणि कल्पयेत् ।\nनाभौ हृदि भ्रुवोर्मध्ये बालाबीजान्यथ न्यसेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006290006, "chapter_id": 26290, "verse_number": "३-४४-७", "content_sanskrit": "मातृकां मूलपुटितां न्यसेन्नाभ्यादिषु क्रमात् ।\nबालाबीजानि तान्येव द्विरावृत्त्याथ विन्यसेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006290007, "chapter_id": 26290, "verse_number": "३-४४-८", "content_sanskrit": "मध्यादिकरशाखासु तलयोरपि नान्यथा ।\nनाभ्यादावथ विन्यस्य न्यसेदथ पदद्वये ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006290008, "chapter_id": 26290, "verse_number": "३-४४-९", "content_sanskrit": "जानूरुस्फिग्गुह्यमूलनाभि हृन्मूर्धसु क्रमात् ।\nनवासनानि ब्रह्माणं विष्णुं रुद्रं तथेश्वरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006290009, "chapter_id": 26290, "verse_number": "३-४४-१०", "content_sanskrit": "सदाशिवं च पूषाणं तूलिकां च प्रकाशकम् ।\nविद्यासनं च विन्यस्य हृदये दर्शयेत्ततः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006290010, "chapter_id": 26290, "verse_number": "३-४४-११", "content_sanskrit": "पद्मत्रिखण्डयोन्याख्यां मुद्रामोष्ठपुटेन च ।\nवायुमापूर्य हुं हुं हुं त्विति प्राबीध्य कुण्डलीम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006290011, "chapter_id": 26290, "verse_number": "३-४४-१२", "content_sanskrit": "मन्त्रशक्त्या समुन्नीय द्वादशान्ते शिवैकताम् ।\nभावयित्वा पुनस्तं च स्वस्थाने विनिवेश्य च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006290012, "chapter_id": 26290, "verse_number": "३-४४-१३", "content_sanskrit": "वाग्भवादीनि बीजानि मूलहृद्बाहुषु न्यसेत् ।\nसमस्तमूर्ध्नि दोर्मूलमध्याग्रेषु यथाक्रमम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006290013, "chapter_id": 26290, "verse_number": "३-४४-१४", "content_sanskrit": "हस्तौ विन्यस्य चाङ्गेषु ह्यङ्गुष्ठादितलावधि ।\nहृदयादौ च विन्यस्य कुङ्कुमं न्यासमाचरेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006290014, "chapter_id": 26290, "verse_number": "३-४४-१५", "content_sanskrit": "शुद्धा तृतीयबीजेन पुटितां मातृकां पुनः ।\nआद्यबीजद्वयं न्यस्य ह्यन्त्यबीजं न्यसेदिति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006290015, "chapter_id": 26290, "verse_number": "३-४४-१६", "content_sanskrit": "पुनर्भूतलविन्यासमाचरेन्नातिविस्तरम् ।\nवर्गाष्टकं न्यसेन्मूले नाभौ हृदयकण्ठयोः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006290016, "chapter_id": 26290, "verse_number": "३-४४-१७", "content_sanskrit": "प्रागाधायैषु शषसान्मूलहृन्मूर्द्धसु न्यसेत् ।\nकक्षकट्यंसवामांसकटिहृत्सु च विन्यसेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006290017, "chapter_id": 26290, "verse_number": "३-४४-१८", "content_sanskrit": "प्रभूताधः षडङ्गानि दादिवर्गैस्तु विन्यसेत् ।\nऋषिस्तु शब्दब्रह्मस्याच्छन्दो भूतलिपिर्मता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006290018, "chapter_id": 26290, "verse_number": "३-४४-१९", "content_sanskrit": "श्रीमूलप्रकृतिस्त्वस्य देवता कथिता मनोः ।\nअक्षस्रक्पुस्तके चोर्ध्वे पुष्पसायककार्मुके ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006290019, "chapter_id": 26290, "verse_number": "३-४४-२०", "content_sanskrit": "वराभीतिकराब्जैश्च धारयन्तीमनूपमाम् ।\nरक्षणाक्षमयीं मानां वहन्ती कण्ठदेशतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006290020, "chapter_id": 26290, "verse_number": "३-४४-२१", "content_sanskrit": "हारकेयूरकटकच्छन्नवीरविभूषणाम् ।\nदिव्याङ्गरागसंभिन्नमणिकुण्डलमण्डिताम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006290021, "chapter_id": 26290, "verse_number": "३-४४-२२", "content_sanskrit": "लिपिकल्पद्रुमस्याधो रूपिपङ्कजवासिनीम् ।\nसाक्षाल्लिपिमयीं ध्यायेद्भैरवीं भक्तवत्सलाम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006290022, "chapter_id": 26290, "verse_number": "३-४४-२३", "content_sanskrit": "अनेककोटिदूतीभिः समन्तात्समलङ्कृताम् ।\nएवं ध्यात्वा न्यसेद्भूयो भूतलेप्यक्षरान्क्रमात् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006290023, "chapter_id": 26290, "verse_number": "३-४४-२४", "content_sanskrit": "मूलाद्याज्ञावसानेषु वर्गाष्टकमथो न्यसेत् ।\nशषसान्मूर्ध्नि संन्यस्य स्वरानेष्वेव विन्यसेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006290024, "chapter_id": 26290, "verse_number": "३-४४-२५", "content_sanskrit": "हादिरूर्ध्वादिपञ्चास्येष्वग्रे मूले च मध्यमे ।\nअङ्गुलीमूलमणिबन्धयोर्देष्णोश्च पादयोः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006290025, "chapter_id": 26290, "verse_number": "३-४४-२६", "content_sanskrit": "जठरे पार्श्वयोर्दक्षवामयोर्नाभिपृष्ठयोः ।\nशषसान्मूलहृन्मूर्धस्वेतान्वा लादिकान्न्य सेत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006290026, "chapter_id": 26290, "verse_number": "३-४४-२७", "content_sanskrit": "ह्रस्वाः पञ्चाथ सन्ध्यर्णाश्चत्वारो हयरा वलौ ।\nअकौ खगेनगश्चादौ क्रमोयं शिष्टवर्गके ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006290027, "chapter_id": 26290, "verse_number": "३-४४-२८", "content_sanskrit": "शषसा इति विख्याता द्विचत्वारिंशदक्षराः ।\nआद्यः पञ्चाक्षरो वर्गो द्वितीयश्चतुरक्षरः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006290028, "chapter_id": 26290, "verse_number": "३-४४-२९", "content_sanskrit": "पञ्चाक्षरी तु षड्वर्गी त्रिवर्णो नवमो मतः ।\nब्रह्मा विष्णुश्च रुद्रश्च धनेशेन्द्रयमाः क्रमात् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006290029, "chapter_id": 26290, "verse_number": "३-४४-३०", "content_sanskrit": "वरुणश्चैव सोमश्च शक्तित्रयमिमे नव ।\nवर्णानामीश्वराः प्रोक्ताः क्रमो भूतलिपेरयम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006290030, "chapter_id": 26290, "verse_number": "३-४४-३१", "content_sanskrit": "एवं सृष्टौ पाठो विपरीतः संहृतावमुन्येव ।\nस्थानानि योजनीयौ विसर्गबिन्दू च वर्णान्तौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006290031, "chapter_id": 26290, "verse_number": "३-४४-३२", "content_sanskrit": "ध्यानपूर्वं ततः प्राज्ञो रत्यादिन्यासमाचरेत् ।\nजपाकुसुमसंकाशाः कुङ्कुमारुणविग्रहाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006290032, "chapter_id": 26290, "verse_number": "३-४४-३३", "content_sanskrit": "कामवामाधिरूढाङ्का ध्येयाः शरधनुर्धराः ।\nरतिप्रीतियुतः कामः कामिन्याः कान्तैष्यते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006290033, "chapter_id": 26290, "verse_number": "३-४४-३४", "content_sanskrit": "कान्तिमान्मोहिनीयुक्तकामाङ्गः कलहप्रियाम् ।\nअन्वेति कामचारैस्तु विलासिन्या समन्वितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006290034, "chapter_id": 26290, "verse_number": "३-४४-३५", "content_sanskrit": "कामः कल्पलता युक्तः कामुकः श्यामवर्णया ।\nशुचिस्मितान्वितः कामो बन्धको विस्मृतायुतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006290035, "chapter_id": 26290, "verse_number": "३-४४-३६", "content_sanskrit": "रमणो विस्मिताक्ष्या च रामोऽयं लेलिहानया ।\nरमण्या रतिनाथोपि दिग्वस्त्राढ्यो रतिप्रियः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006290036, "chapter_id": 26290, "verse_number": "३-४४-३७", "content_sanskrit": "वामया कुब्जया युक्तो रतिनाथो धरायुतः ।\nरमाकान्तो रमोपास्यो रममाणो निशाचरः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006290037, "chapter_id": 26290, "verse_number": "३-४४-३८", "content_sanskrit": "कल्याणो मोहिनीनाथो नन्दकश्चोत्तमान्वितः ।\nनन्दी सुरोत्तमाढ्यो नन्दनो नन्दयिता पुनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006290038, "chapter_id": 26290, "verse_number": "३-४४-३९", "content_sanskrit": "सुलावण्यान्वितः पञ्चबाणो बालनिधीश्वरः ।\nकलहप्रियया युक्तस्तथा रतिसखः पुनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006290039, "chapter_id": 26290, "verse_number": "३-४४-४०", "content_sanskrit": "एकाक्ष्या पुष्पधन्वापि सुमुखेशो महाधनुः ।\nनीली जडिल्यो भ्रमणः क्रमशः पालिनीपतिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006290040, "chapter_id": 26290, "verse_number": "३-४४-४१", "content_sanskrit": "भ्रममाणः शिवाकान्तो भ्रमो भ्रान्तश्च मुग्धया ।\nभ्रामको रमया प्राप्तो भ्रामितो भृङ्ग इष्यते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006290041, "chapter_id": 26290, "verse_number": "३-४४-४२", "content_sanskrit": "भ्रान्ताचारो लोचनया दीर्घजिह्विकया पुनः ।\nभ्रमावहं समन्वेति मोहनस्तु रतिप्रियाम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006290042, "chapter_id": 26290, "verse_number": "३-४४-४३", "content_sanskrit": "मोहकस्तु पलाशाक्ष्या गृहिण्यां मोह इष्यते ।\nविकटेशो मोहधरो वर्धनोयं धरायुतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006290043, "chapter_id": 26290, "verse_number": "३-४४-४४", "content_sanskrit": "मदनाथोऽनूपमस्तु मन्मथो मलयान्वितः ।\nमादकोह्लादिनीयुक्तः समिच्छन्विश्वतोमुखी ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006290044, "chapter_id": 26290, "verse_number": "३-४४-४५", "content_sanskrit": "नायको भृङ्गपूर्वस्तु गायको नन्दिनीयुतः ।\nगणकोऽनामया ज्ञेयः काल्या नर्तक इष्यते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006290045, "chapter_id": 26290, "verse_number": "३-४४-४६", "content_sanskrit": "क्ष्वेल्लकः कालकर्ण्यढ्यः कन्दर्पो मत्त इष्यते ।\nनर्तकः श्यामलाकान्तो विलासी झषयान्वितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006290046, "chapter_id": 26290, "verse_number": "३-४४-४७", "content_sanskrit": "उन्मत्तामुपसंगम्य मोदते कामवर्धनः ।\nध्यानपूर्वं ततः श्रीकण्ठादिविन्यासमाचरेत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006290047, "chapter_id": 26290, "verse_number": "३-४४-४८", "content_sanskrit": "सिंदूरकाञ्चनसमोभयभागमर्धनारीश्वरं गिरिसुताहरभूपचिह्नम् ।\nपाशद्वयाक्षवलयेष्टदहस्तमेव स्मृत्वा न्यसेल्लिपिपदेषु समीहितार्थम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006290048, "chapter_id": 26290, "verse_number": "३-४४-४९", "content_sanskrit": "श्रीकण्ठानन्तसूक्ष्मौ च त्रिमूर्तिरमरेश्वरः ।\nउर्वीशोभारभूतिश्चातिथीशः स्थाणुको हरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006290049, "chapter_id": 26290, "verse_number": "३-४४-५०", "content_sanskrit": "चण्डीशो भौतिकः सद्योजातश्चानुग्रहेश्वरः ।\nअक्रूरश्च महासेनः स्युरेते वरमूर्त्तयः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006290050, "chapter_id": 26290, "verse_number": "३-४४-५१", "content_sanskrit": "ततः क्रोधीशचण्डीशौ पञ्चान्तकशिवोत्तमौ ।\nतथैकरुद्रकूर्मैकनेत्राः सचतुरातनाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006290051, "chapter_id": 26290, "verse_number": "३-४४-५२", "content_sanskrit": "अजेशः शर्वसोमेशौ हरो लागलिदारुकौ ।\nअर्धनारीश्वरश्चोमाकान्तश्चापाढ्यदण्डिनौ ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006290052, "chapter_id": 26290, "verse_number": "३-४४-५३", "content_sanskrit": "अत्रिर्मीनश्च मेषश्च लोहितश्च शिखी तथा ।\nखड्गदण्डद्विदण्डौ च सुमहाकालव्या लिनौ ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006290053, "chapter_id": 26290, "verse_number": "३-४४-५४", "content_sanskrit": "भुजङ्गेशः पिनाकी च खड्गेशश्च बकस्तथा ।\nश्वेतो ह्यभ्रश्च लकुलीशिवः संवर्त्तकस्तथा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006290054, "chapter_id": 26290, "verse_number": "३-४४-५५", "content_sanskrit": "पूर्णोदरी च विरजा तृतीया शाल्म तथा ।\nलोलाक्षी वर्तुलाक्षी च दीर्घङ्घोणा तथैव च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006290055, "chapter_id": 26290, "verse_number": "३-४४-५६", "content_sanskrit": "सुदीर्घमुखिगो मुख्यौ नवमी दीर्घजिह्विका ।\nकुञ्जरी चौर्ध्वकेशा च द्विमुखी विकृतानना ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006290056, "chapter_id": 26290, "verse_number": "३-४४-५७", "content_sanskrit": "सत्यलीलाकलाविद्यामुख्याः स्युः स्वरशक्तयः ।\nमहाकाली सरस्वत्यौ सर्वसिद्धिसमन्विते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006290057, "chapter_id": 26290, "verse_number": "३-४४-५८", "content_sanskrit": "गौरी त्रैलोक्यविद्या च तथा मन्त्रात्मशक्तिका ।\nलंबोदरी भूतमता द्राविणी नागरी तथा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006290058, "chapter_id": 26290, "verse_number": "३-४४-५९", "content_sanskrit": "खेचरी मञ्जरी चैव रूपिणी वीरिणी तथा ।\nकोटरा पूतना भद्रा काली योगिन्य एव च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006290059, "chapter_id": 26290, "verse_number": "३-४४-६०", "content_sanskrit": "शङ्खिनीगर्जिनीकालरात्रिकूर्दिन्य एव च ।\nकपर्दिनी तथा वज्रा जया च सुमुखेश्वरी ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006290060, "chapter_id": 26290, "verse_number": "३-४४-६१", "content_sanskrit": "रेवती माधवी चैव वारुणी वायवी तथा ।\nरक्षावधारिणी चान्या तथा च सहजाह्वया ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006290061, "chapter_id": 26290, "verse_number": "३-४४-६२", "content_sanskrit": "लक्ष्मीश्च व्यापिनीमाये संख्याता वर्णशक्तयः ।\nद्विरुक्तवालाया वर्णै रङ्गं कृत्वाथ केवलैः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006290062, "chapter_id": 26290, "verse_number": "३-४४-६३", "content_sanskrit": "षोढा न्यासं प्रकुर्वीत देवतात्मत्वसिद्धये ।\nविघ्नेशादींस्तु तत्रादौ विन्यसेद्ध्यानपूर्वकम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006290063, "chapter_id": 26290, "verse_number": "३-४४-६४", "content_sanskrit": "तरुणारुणसंकाशान्गजवक्त्रांस्त्रिलोचनान् ।\nपाशाङ्कुशवराभीतिहस्ताञ्छक्तिसमन्वितान् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006290064, "chapter_id": 26290, "verse_number": "३-४४-६५", "content_sanskrit": "विघ्नेशो विघ्नराजश्च विनायकशिवोत्तमौ ।\nविघ्नकृद्विघ्नहन्ता च विघ्नराढ्गणनायकः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006290065, "chapter_id": 26290, "verse_number": "३-४४-६६", "content_sanskrit": "एकदन्तो द्विदन्तश्च गजवक्त्रो निरञ्जनः ।\nकपर्दवान्दीर्घमुखः शङ्कुकर्णो वृषध्वजः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006290066, "chapter_id": 26290, "verse_number": "३-४४-६७", "content_sanskrit": "गणनाथो गजेन्द्रास्यः शूर्पकर्णस्त्रिलोचनः ।\nलम्बोदरो महानादश्चतुर्मूर्तिः सदाशिवः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006290067, "chapter_id": 26290, "verse_number": "३-४४-६८", "content_sanskrit": "आमोदो दुर्मदश्चैव सुमुखश्च प्रमोदकः ।\nएकपादो द्विपादश्च शूरो वीरश्च षण्मुखः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006290068, "chapter_id": 26290, "verse_number": "३-४४-६९", "content_sanskrit": "वरदो नाम देवश्च वक्रतुण्डो द्विदन्तकः ।\nसेनानीर्ग्रामणीर्मत्तो मत्तमूषकवाहनः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006290069, "chapter_id": 26290, "verse_number": "३-४४-७०", "content_sanskrit": "जटी मुण्डी तथा खड्गी वरेण्यो वृषकेतनः ।\nभङ्यप्रियो गणेशश्च मेघनादो गणेश्वरः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006290070, "chapter_id": 26290, "verse_number": "३-४४-७१", "content_sanskrit": "एते गणेशा वर्णानामेकपञ्चाशतः क्रमात् ।\nश्रीश्च ह्रीश्चैव पुष्टिश्च शान्तिस्तुष्टिः सरस्वती ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006290071, "chapter_id": 26290, "verse_number": "३-४४-७२", "content_sanskrit": "रतिर्मेधा तथा कान्तिः कामिनी मोहिनी तथा ।\nतीव्रा च ज्वालिनी नन्दा सुयशाः कामरूपिणी ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006290072, "chapter_id": 26290, "verse_number": "३-४४-७३", "content_sanskrit": "उग्रा तेजोवती सत्या विघ्नेशानी स्वरूपिणी ।\nकामार्त्ता मदजिह्वा च विकटा घूर्णितानना ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006290073, "chapter_id": 26290, "verse_number": "३-४४-७४", "content_sanskrit": "भूतिर्भूमिर्द्विरम्या चामारूपा मकरध्वजा ।\nविकर्णभ्रुकुटी लज्जा दीर्घघोणा धनुर्धरी ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006290074, "chapter_id": 26290, "verse_number": "३-४४-७५", "content_sanskrit": "तथैव यामिनी रात्रिश्चन्द्रकान्ता शशिप्रभा ।\nलोलाक्षी चपला ऋज्वी दुर्भगा सुभगा शिवा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006290075, "chapter_id": 26290, "verse_number": "३-४४-७६", "content_sanskrit": "दुर्गा गुहप्रिया काली कालजिह्वा च शक्तयः ।\nग्रहन्यासं ततः कुर्याद्ध्यानपूर्वं समाहितः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006290076, "chapter_id": 26290, "verse_number": "३-४४-७७", "content_sanskrit": "वरदाभयहस्ताढ्याञ्छक्त्यालिङ्गितविग्रहान् ।\nकुङ्कुमक्षीररुधिरकुन्दकाञ्चनकंबुभिः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006290077, "chapter_id": 26290, "verse_number": "३-४४-७८", "content_sanskrit": "अम्भोदधूमतिमिरैः सूर्यादीन्सदृशान्स्मरेत् ।\nहृदयाधो रविं न्यस्य शीर्ष्णि सोमं दृशोः कुजम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006290078, "chapter_id": 26290, "verse_number": "३-४४-७९", "content_sanskrit": "हृदि शुक्रं च हृन्मध्ये बुधं कण्ठे बृहस्पतिम् ।\nनाभौ शनैश्चरं वक्त्रे राहुं केतुं पदद्वये ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006290079, "chapter_id": 26290, "verse_number": "३-४४-८०", "content_sanskrit": "ज्वलत्कालानलप्रख्या वरदाभयपाणयः ।\nतारा न्यसेत्ततो ध्यायन्सर्वाभरणभूषिताः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006290080, "chapter_id": 26290, "verse_number": "३-४४-८१", "content_sanskrit": "भाले नयनयोः कर्णद्वये नासापुडद्वये ।\nकण्ठे स्कन्धद्वये पश्चात्कूर्पयोर्मणिबन्धयोः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006290081, "chapter_id": 26290, "verse_number": "३-४४-८२", "content_sanskrit": "स्तनयोर्नाभिकट्यूरुजानुजङ्घापदद्वये ।\nयोगिनीन्यासमादध्या द्विशुद्धो हृदये तथा ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006290082, "chapter_id": 26290, "verse_number": "३-४४-८३", "content_sanskrit": "नाभौ स्वाधिष्ठिते मूले भ्रूमध्ये मूर्धनि क्रमात् ।\nपद्मेन्दुकर्णिकामध्ये वर्णशक्तीर्दलेष्वथ ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006290083, "chapter_id": 26290, "verse_number": "३-४४-८४", "content_sanskrit": "दलाग्रेषु तु पद्मस्य मूर्ध्नि सर्वाश्च विन्यसेत् ।\nअमृता नन्दिनीन्द्राणी त्वीशानी चात्युमा तथा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006290084, "chapter_id": 26290, "verse_number": "३-४४-८५", "content_sanskrit": "ऊर्ध्वकेशी ऋद्विदुषी ळकारिका तथैव च ।\nएकपादात्मिकैश्वर्यकारिणी चौषधात्मिका ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006290085, "chapter_id": 26290, "verse_number": "३-४४-८६", "content_sanskrit": "ततोंबिकाथो रक्षात्मिकेति षोडश शक्तयः ।\nकालिका खेचरी गायत्री घण्टाधारिणी तथा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006290086, "chapter_id": 26290, "verse_number": "३-४४-८७", "content_sanskrit": "नादात्मिका च चामुण्टा छत्रिका च जया तथा ।\nझङ्कारिणी च संज्ञा च टङ्कहस्ता ततः परम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006290087, "chapter_id": 26290, "verse_number": "३-४४-८८", "content_sanskrit": "टङ्कारिणी च विज्ञेयाः शक्तयो द्वादश क्रमात् ।\nडङ्कारी टङ्कारिणी च णामिनी तामसी तथा ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006290088, "chapter_id": 26290, "verse_number": "३-४४-८९", "content_sanskrit": "थङ्कारिणी दया धात्री नादिनी पार्वती तथा ।\nफट्कारिणी च विज्ञेयाः शक्तयो द्वयपन्नगाः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006290089, "chapter_id": 26290, "verse_number": "३-४४-९०", "content_sanskrit": "वर्धिनी च तथा भद्रा मज्जा चैव यशस्विनी ।\nरमा च लामिनी चेति षडेताः शक्तयः क्रमात् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006290090, "chapter_id": 26290, "verse_number": "३-४४-९१", "content_sanskrit": "नारदा श्रीस्तथा षण्ढाशश्वत्यपि च शक्तयः ।\nचतस्रोऽपि तथैव द्वे हाकिनी च क्षमा तथा ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006290091, "chapter_id": 26290, "verse_number": "३-४४-९२", "content_sanskrit": "ततः पादे च लिङ्गे च कुक्षौ हृद्दोःशिरस्मु च ।\nदक्षा दिवामपादान्तं राशीन्मेषादिकान्न्यसेत् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006290092, "chapter_id": 26290, "verse_number": "३-४४-९३", "content_sanskrit": "ततः पीठानि पञ्चाशदेकं चक्रं मनो न्यसेत् ।\nवाराणसी कामरूपं नेपालं पौण्ड्रवर्धनम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006290093, "chapter_id": 26290, "verse_number": "३-४४-९४", "content_sanskrit": "वरस्थिरं कान्यकुब्जं पूर्णशैलं तथार्बुदम् ।\nआम्रातकेश्वरैकाम्रं त्रिस्रोतः कामकोष्ठकम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006290094, "chapter_id": 26290, "verse_number": "३-४४-९५", "content_sanskrit": "कैलासं भृगुनगरं केदारं चन्द्रपुष्करम् ।\nश्रीपीठं चैकवीरां च जालन्ध्रं मालवं तथा ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006290095, "chapter_id": 26290, "verse_number": "३-४४-९६", "content_sanskrit": "कुलान्नं देविकोटं च गोकर्णं मारुतेश्वरम् ।\nअट्टहासं च विरजं राजवेश्म महापथम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006290096, "chapter_id": 26290, "verse_number": "३-४४-९७", "content_sanskrit": "कोलापुरकैलापुरकालेश्वरजयन्तिकाः ।\nउज्ज्यिन्यपि चित्रा च क्षीरकं हस्तिनापुरम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006290097, "chapter_id": 26290, "verse_number": "३-४४-९८", "content_sanskrit": "उडीरां च प्रयागं च षष्टिमायापुरं तथा ।\nगौरीशं सलयं चैव श्रीशैलं मरुमेव च ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006290098, "chapter_id": 26290, "verse_number": "३-४४-९९", "content_sanskrit": "पुनर्गिरिवरं पश्चान्महेन्द्रं वामनं गिरिम् ।\nस्याद्धिरण्यपुरं पश्चान्महालक्ष्मीपुरं तथा ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006290099, "chapter_id": 26290, "verse_number": "३-४४-१००", "content_sanskrit": "पुरोद्यानं तथा छायाक्षेत्रमाहुर्मनीषिणः ।\nलिपिक्रमसमायुक्तांल्लिपिस्थानेषु विन्यसेत् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006290100, "chapter_id": 26290, "verse_number": "३-४४-१०१", "content_sanskrit": "अन्यान्यथीक्तस्थानेषु संयुक्तांल्लिपिसङ्कमात् ।\nषोढा न्यासो मयाख्यातः साक्षादीश्वरभाषितः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006290101, "chapter_id": 26290, "verse_number": "३-४४-१०२", "content_sanskrit": "एवं विन्यस्तदेहस्तु देवताविग्रहो भवेत् ।\nततः षोढा पुरः कृत्वा श्रीचक्रन्यासमाचरेत् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006290102, "chapter_id": 26290, "verse_number": "३-४४-१०३", "content_sanskrit": "अंशाद्यानन्द्यमूर्त्यन्तं मन्त्रैस्तु व्यापकं चरेत् ।\nचक्रेश्वरीं चक्रसमर्पणमन्त्रान्हृदि न्यसेत् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006290103, "chapter_id": 26290, "verse_number": "३-४४-१०४", "content_sanskrit": "अन्यान्यथोक्तस्थानेषु गणपत्यादिकान्न्यसेत् ।\nदक्षिणोरुसमं वामं सर्वांश्च क्रमशो न्यसेत् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006290104, "chapter_id": 26290, "verse_number": "३-४४-१०५", "content_sanskrit": "गणेशं क्षेत्रपालं च योगिनीं बटुकं तथा ।\nआदाविन्द्रादयो न्यस्याः पदाङ्गुष्ठद्वयाग्रके ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006290105, "chapter_id": 26290, "verse_number": "३-४४-१०६", "content_sanskrit": "जानुपार्श्वंसमूर्धास्यपार्श्वजानुषु मूर्धनि ।\nमूलाधारेऽणिमादीनां सिद्धीनां दशकं ततः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006290106, "chapter_id": 26290, "verse_number": "३-४४-१०७", "content_sanskrit": "न्यस्तव्यमंसदोः पृष्ठवक्षस्सु प्रपदोः स्फिजि ।\nदोर्देशपृष्ठयोर्मूर्धपादद्वितययोः क्रमात् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7006290107, "chapter_id": 26290, "verse_number": "३-४४-१०८", "content_sanskrit": "अणिमा चैव लघिमा तृतीया महिमा तथा ।\nईशित्वं च वशित्वं च प्राकाम्यं प्राप्तिरेव च ।\nइच्छासिद्धी रससिद्धिर्मोक्षसिद्धिरिति स्मृताः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7006290108, "chapter_id": 26290, "verse_number": "३-४४-१०९", "content_sanskrit": "ततो विप्र न्यसेद्धीमान्मातृणामष्टकं क्रमात् ।\nपादाङ्गुष्ठयुगे दक्षपार्श्वे मूर्द्धनि वामतः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7006290109, "chapter_id": 26290, "verse_number": "३-४४-११०", "content_sanskrit": "वामजनौ दक्षजानौ दक्षवामांसयोस्तथा ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7006290110, "chapter_id": 26290, "verse_number": "३-४४-१११", "content_sanskrit": "ब्राह्मी माहेश्वरी चैव कौमारी वैष्णवी तथा ।\nवाराही च तथेन्द्राणी चामुण्डा चैव सप्तमी ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7006290111, "chapter_id": 26290, "verse_number": "३-४४-११२", "content_sanskrit": "महालक्ष्मीश्च विज्ञेया मातरो वै क्रमाद्बुधैः ।\nमुद्रादेवीर्न्यसेदष्टावेष्वेव द्वे च ते पुनः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7006290112, "chapter_id": 26290, "verse_number": "३-४४-११३", "content_sanskrit": "मूर्द्धार्न्ध्योरपि मुद्रास्तु सर्वसंक्षोभिणी तथा ।\nसर्वविद्राविणी पश्चात्सर्वार्थाकर्षणी तथा ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7006290113, "chapter_id": 26290, "verse_number": "३-४४-११४", "content_sanskrit": "सर्वाद्या वशकरिणी सर्वाद्या प्रियकारिणी ।\nमहाङ्कुशी च सर्वाद्या सर्वाद्या खेचरी तथा ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7006290114, "chapter_id": 26290, "verse_number": "३-४४-११५", "content_sanskrit": "त्रिखण्डा सर्वबीजा च मूद्रा सर्वप्रपीरिका ।\nयोनिमुद्रेति विज्ञेयास्तत्र चक्रेश्वरीं न्यसेत् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7006290115, "chapter_id": 26290, "verse_number": "३-४४-११६", "content_sanskrit": "त्रैलोक्य मोहनं चक्रं समर्प्य व्याप्य वर्ष्मणि ।\nततः कलानां नित्यानां क्रमात्षोडशकं न्यसेत् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7006290116, "chapter_id": 26290, "verse_number": "३-४४-११७", "content_sanskrit": "कामाकर्षणरूपा च शब्दाकर्षणरूपिणी ।\nअहङ्काराकर्षिणी च शब्दाकर्षणरूपिणी ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7006290117, "chapter_id": 26290, "verse_number": "३-४४-११८", "content_sanskrit": "स्पर्शाकर्षणरूपा च रूपाकर्षणरूपिणी ।\nरसाकर्षणरूपा च गन्धाकर्षणरूपिणी ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7006290118, "chapter_id": 26290, "verse_number": "३-४४-११९", "content_sanskrit": "चित्ताकर्षणरूपा च धैर्याकर्षणरूपिणी ।\nस्मृत्याकर्षणरूपा च हृदाकर्षणरूपिणी ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7006290119, "chapter_id": 26290, "verse_number": "३-४४-१२०", "content_sanskrit": "श्रद्धाकर्षणरूपा च ह्यात्माकर्षणरूपिणी ।\nअमृताकर्षिणी प्रोक्ता शरीराकर्षणी तथा ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7006290120, "chapter_id": 26290, "verse_number": "३-४४-१२१", "content_sanskrit": "स्थानानि दक्षिणं श्रोत्रं पृष्ठमंसश्च कूर्परः ।\nदक्षहस्त तलस्याथ पृष्ठं तत्स्फिक्च जानुनी ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7006290121, "chapter_id": 26290, "verse_number": "३-४४-१२२", "content_sanskrit": "तज्जङ्घाप्रपदे वामप्रपदादिविलोमतः ।\nचक्रेशीं न्यस्य चक्रं च समर्च्य व्याप्य वर्ष्मणि ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7006290122, "chapter_id": 26290, "verse_number": "३-४४-१२३", "content_sanskrit": "न्यसेदनङ्गकुसुमदेव्यादीनामथाष्टकम् ।\nशङ्खजत्रूरुजङ्घासु वामे तु प्रतिलोमतः ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7006290123, "chapter_id": 26290, "verse_number": "३-४४-१२४", "content_sanskrit": "अनङ्गकुसुमा पश्चाद्द्वितीयानङ्ग मेखला ।\nअनङ्गमदना पश्चादनङ्गमदनातुरा ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7006290124, "chapter_id": 26290, "verse_number": "३-४४-१२५", "content_sanskrit": "अनङ्गरेखा तत्पश्चाद्वेगाख्यानङ्गपूर्विका ।\nततोऽनङ्गाङ्कुशा पश्चादनङ्गाधारमालिनी ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7006290125, "chapter_id": 26290, "verse_number": "३-४४-१२६", "content_sanskrit": "चक्रेशीं न्यस्य चक्रं च समर्प्य व्याप्य वर्ष्मणि ।\nशक्तिदेवीर्न्यसेत्सर्वसंक्षोभिण्यादिका अथ ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7006290126, "chapter_id": 26290, "verse_number": "३-४४-१२७", "content_sanskrit": "ललाटगण्डयोरं से पादमूले च जानुनि ।\nउपर्यधश्च जङ्घायां तथा वामे विलोमतः ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7006290127, "chapter_id": 26290, "verse_number": "३-४४-१२८", "content_sanskrit": "सर्वसंक्षोभिणी शक्तिः सर्वविद्राविणी तथा ।\nसर्वाद्याकर्षणी शक्तिः सर्वप्रह्लादिनी तथा ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7006290128, "chapter_id": 26290, "verse_number": "३-४४-१२९", "content_sanskrit": "सर्वसंमोहिनी शक्तिः सर्वाद्या स्तंभिनी तथा ।\nसर्वाद्या जृंभिणी शक्तिः सर्वाद्या वशकारिणी ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7006290129, "chapter_id": 26290, "verse_number": "३-४४-१३०", "content_sanskrit": "सर्वाद्या रञ्जिनी शक्तिः सर्वाद्योन्मादिनी तथा ।\nसर्वार्थसाधिनी शक्तिस्सर्वाशापूरिणी तथा ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7006290130, "chapter_id": 26290, "verse_number": "३-४४-१३१", "content_sanskrit": "सर्वमन्त्रमयी शक्तिः सर्वद्वन्द्वक्षयङ्करा ।\nचक्रेशीं न्यस्य चक्रं च समर्प्य व्याप्य वर्ष्मणि ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7006290131, "chapter_id": 26290, "verse_number": "३-४४-१३२", "content_sanskrit": "सर्वसिद्धिप्रदादीनां दशकं चाथ विन्यसेत् ।\nदक्षनासापुटे दन्तमूले दक्षस्तने तथा ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7006290132, "chapter_id": 26290, "verse_number": "३-४४-१३३", "content_sanskrit": "कूर्परे मणिबन्धे च न्यस्येद्वामे विलोमतः ।\nसर्वसिद्धिप्रदा नित्यं सर्वसंपत्प्रदा तथा ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7006290133, "chapter_id": 26290, "verse_number": "३-४४-१३४", "content_sanskrit": "सर्वप्रियङ्करा देवी सर्वमङ्गलकारिणी ।\nसर्वाघमोचिनी शक्तिः सर्वदुःखविमोचिनी ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7006290134, "chapter_id": 26290, "verse_number": "३-४४-१३५", "content_sanskrit": "सर्व मृत्युप्रशमिनी सर्वविघ्नविनाशिनी ।\nसर्वाङ्गसुन्दरी चैव सर्वसौभाग्यदायिनी ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7006290135, "chapter_id": 26290, "verse_number": "३-४४-१३६", "content_sanskrit": "चक्रेशीं न्यस्य चक्रं च समर्प्य व्याप्य वर्ष्मणि ।\nसर्वज्ञाद्यान्न्यसेद्वक्षस्यपि दन्तस्थलेष्वथ ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7006290136, "chapter_id": 26290, "verse_number": "३-४४-१३७", "content_sanskrit": "सर्वज्ञा सर्वशक्तिश्च सर्वज्ञानप्रदा तथा ।\nसर्वज्ञानमयी देवी सर्वव्याधिविनाशिनी ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7006290137, "chapter_id": 26290, "verse_number": "३-४४-१३८", "content_sanskrit": "सर्वाधारस्वरूपा च सर्वपापहरा तथा ।\nसर्वानन्दमयी देवी सर्वरक्षास्वरूपिणी ।\nविज्ञेया दशमी चैव सर्वेप्सितफलप्रदा ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7006290138, "chapter_id": 26290, "verse_number": "३-४४-१३९", "content_sanskrit": "चक्रेशीं न्यस्य चक्रं च समर्प्य व्याप्य वर्ष्मणि ।\nप्राग्वामाद्याश्च विन्यस्य पक्षिण्याद्यास्ततः सुधीः ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7006290139, "chapter_id": 26290, "verse_number": "३-४४-१४०", "content_sanskrit": "दक्षे तु चिबुके कण्ठे स्तने नाभौ च पार्श्वयोः ।\nवामा विनोदिनी विद्या वशिता कामिकी मता ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7006290140, "chapter_id": 26290, "verse_number": "३-४४-१४१", "content_sanskrit": "कामेश्वरी परा ज्ञेया मोहिनी विमला तथा ।\nअरुणा जयिनी पश्चात्तथा सर्वेश्वरी मता ।\nकौलिनीति समुक्तानि तासां नामानि सूरिभिः ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7006290141, "chapter_id": 26290, "verse_number": "३-४४-१४२", "content_sanskrit": "चक्रेश्वरीं न्यसेच्चक्रं समर्प्य व्याप्य वर्ष्मणि ।\nहृदि त्रिकोणं संभाव्य दिक्षु प्रागादितः क्रमात् ॥१४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7006290142, "chapter_id": 26290, "verse_number": "३-४४-१४३", "content_sanskrit": "तद्बहिर्विन्न्यसेद्धीमानायुधानां चतुष्टयम् ।\nन्यसेदग्न्यादिकोणेषु मध्ये पीठचतुष्टयम् ॥१४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7006290143, "chapter_id": 26290, "verse_number": "३-४४-१४४", "content_sanskrit": "मध्यवृत्तंन्यसित्वा च नित्याषोडशकं न्यसेत् ।\nकामेश्वरी तथा नित्या नित्या च भगमालिनी ॥१४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7006290144, "chapter_id": 26290, "verse_number": "३-४४-१४५", "content_sanskrit": "नित्यक्लिन्ना तथा नित्या नित्या भेरुण्डिनी मता ।\nवह्निवासिनिका नित्या महावज्रेश्वरी तथा ॥१४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7006290145, "chapter_id": 26290, "verse_number": "३-४४-१४६", "content_sanskrit": "नित्या च दूती नित्या च त्वरिता तु ततः परम् ।\nकुलसुन्दरिका नित्या कुल्या नित्या ततः परम् ॥१४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7006290146, "chapter_id": 26290, "verse_number": "३-४४-१४७", "content_sanskrit": "नित्या नीलपताका च नित्या तु विजया परा ।\nततस्तु मङ्गला चैव नित्यपूर्वा प्रचक्ष्यते ॥१४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7006290147, "chapter_id": 26290, "verse_number": "३-४४-१४८", "content_sanskrit": "प्रभामालिनिका नित्या चित्रा नित्या तथैव च ।\nएतास्त्रिकोणान्तरेण पादतो हृदि विन्यसेत् ॥१४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7006290148, "chapter_id": 26290, "verse_number": "३-४४-१४९", "content_sanskrit": "नित्या प्रमोदिनी चैव नित्या त्रिपुरसुन्दरी ।\nतन्मध्ये विन्यसेद्देवीमखण्डजगदात्मिकाम् ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7006290149, "chapter_id": 26290, "verse_number": "३-४४-१५०", "content_sanskrit": "चक्रेश्वरीं हृदि न्यस्य कृत्वा चक्रं समुद्धृतम् ।\nप्रदर्श्य मुद्रां योन्याख्यां सर्वानन्दमनुं जपेत् ॥१५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7006290150, "chapter_id": 26290, "verse_number": "३-४४-१५१", "content_sanskrit": "इत्यात्मनस्तु चक्रस्य चक्रदेवी भविष्यति ॥१५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}]