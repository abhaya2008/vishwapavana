[{"id": 5000587000, "chapter_id": 9587, "verse_number": "७-५२-१", "content_sanskrit": "तत्र तां रजनीमुष्य केशिन्यां रघुनन्दनः ।\nप्रभाते पुनरुत्थाय लक्ष्मणः प्रययौ तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000587001, "chapter_id": 9587, "verse_number": "७-५२-२", "content_sanskrit": "ततो ऽर्धदिवसे प्राप्ते प्रविवेश महारथः ।\nअयोध्यां रत्नसम्पूर्णां हृष्टपुष्टजनावृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000587002, "chapter_id": 9587, "verse_number": "७-५२-३", "content_sanskrit": "सौमित्रिस्तु परं दैन्यं जगाम सुमहामतिः ।\nरामपादौ समासाद्य वक्ष्यामि किमहं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000587003, "chapter_id": 9587, "verse_number": "७-५२-४", "content_sanskrit": "तस्यैवं चिन्तयानस्य भवनं शशिसन्निभम् ।\nरामस्य परमोदारं पुरस्तान्समदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000587004, "chapter_id": 9587, "verse_number": "७-५२-५", "content_sanskrit": "राज्ञस्तु भवनद्वारि सो ऽवतीर्य रथोत्तमात् ।\nअवाङ्मुखो दीनमनाः प्रविवेशानिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000587005, "chapter_id": 9587, "verse_number": "७-५२-६", "content_sanskrit": "स दृष्ट्वा राघवं दीनमासीनं परमासने ।\nनेत्राभ्यामश्रुपूर्णाभ्यां ददर्शाग्रजमग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000587006, "chapter_id": 9587, "verse_number": "७-५२-७", "content_sanskrit": "जग्राह चरणौ तस्य लक्ष्मणो दीनचेतनः ।\nउवाच दीनया वाचा प्राञ्जलिः सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000587007, "chapter_id": 9587, "verse_number": "७-५२-८", "content_sanskrit": "आर्यस्याज्ञां पुरस्कृत्य विसृज्य जनकात्मजाम् ।\nगङ्गातीरे यथोद्दिष्टे वाल्मीकेराश्रमे शुचौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000587008, "chapter_id": 9587, "verse_number": "७-५२-९", "content_sanskrit": "तत्र तां च शुभाचारामाश्रमान्ते यशस्विनीम् ।\nपुनरप्यागतो वीर पादमूलमुपासितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000587009, "chapter_id": 9587, "verse_number": "७-५२-१०", "content_sanskrit": "मा शुचः पुरुषव्याघ्र कालस्य गतिरीदृशी ।\nत्वद्विधा न हि शोचन्ति बुद्धिमन्तो मनस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000587010, "chapter_id": 9587, "verse_number": "७-५२-११", "content_sanskrit": "सर्वे क्षयान्ता निचयाः पतनान्ताः समुच्छ्रयाः ।\nसंयोगा विप्रयोगान्ता मरणान्तं च जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000587011, "chapter_id": 9587, "verse_number": "७-५२-१२", "content_sanskrit": "तस्मात्पुत्रेषु दारेषु मित्रेषु च धनेषु च ।\nनातिप्रसङ्गः कर्तव्यो विप्रयोगो हि तैर्ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000587012, "chapter_id": 9587, "verse_number": "७-५२-१३", "content_sanskrit": "शक्तस्त्वमात्मना ऽ ऽत्मानं विनेतुं मनसैव हि ।\nलोकान्सर्वांश्च काकुत्स्थ किं पुनः शोकमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000587013, "chapter_id": 9587, "verse_number": "७-५२-१४", "content_sanskrit": "नेदृशेषु विमुह्यन्ति त्वद्विधाः पुरुषर्षभाः ।\nअपवादः स किल ते पुनरेष्यति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000587014, "chapter_id": 9587, "verse_number": "७-५२-१५", "content_sanskrit": "यदर्थं मैथिली त्यक्ता अपवादभयान्नृप ।\nसो ऽपवादः पुरे राजन्भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000587015, "chapter_id": 9587, "verse_number": "७-५२-१६", "content_sanskrit": "स त्वं पुरुषशार्दूल धैर्येण सुसमाहितः ।\nत्यजैनां दुर्बलां बुद्धिं सन्तापं मा कुरुष्व ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000587016, "chapter_id": 9587, "verse_number": "७-५२-१७", "content_sanskrit": "एवमुक्तः स काकुत्स्थो लक्ष्मणेन महात्मना ।\nउवाच परया प्रीत्या सौमित्रिं मित्रवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000587017, "chapter_id": 9587, "verse_number": "७-५२-१८", "content_sanskrit": "एवमेतन्नरश्रेष्ठ यथा वदसि लक्ष्मण ।\nपरितोषश्च मे वीर मम कार्यानुशासने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000587018, "chapter_id": 9587, "verse_number": "७-५२-१९", "content_sanskrit": "निवृत्तिश्चागता सौम्य सन्तापश्च निराकृतः ।\nभवद्वाक्यैः सुरुचिरैरनुनीतो ऽस्मि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000587019, "chapter_id": 9587, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे द्विपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]