    "display_order": 111,
    "avatarnika": ""
  },
  {
    "id": 20011102,
    "chapter_id": 6679,
    "verse_number": "7.112",
    "content_sanskrit": "यान्तमान्तरगारिक्यस्तरुण्यस्तं व्यलोकयन् । पूर्णवातायनच्छिद्रैरौपकर्ण्यविलोचनैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
