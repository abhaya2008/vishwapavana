    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20011082,
    "chapter_id": 6679,
    "verse_number": "7.92",
    "content_sanskrit": "परार्ध्यान्यपरार्ध्यानि मध्यानि च वणिज्जनः । वस्तूनि यत्र विक्रीणन्निपुणोभून्महाधनः ॥",
