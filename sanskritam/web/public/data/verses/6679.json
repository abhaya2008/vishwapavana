    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20011083,
    "chapter_id": 6679,
    "verse_number": "7.93",
    "content_sanskrit": "पितॄन् यत्रार्चयन् पौराः श्राद्धैश्शारदिकादिभिः । शौवस्तिकानि कार्याणि चिन्तयन्तो दिने दिने ॥",
