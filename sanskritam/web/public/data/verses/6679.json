    "avatarnika": ""
  },
  {
    "id": 20011088,
    "chapter_id": 6679,
    "verse_number": "7.98",
    "content_sanskrit": "अर्थाल्लब्धकृतक्रीतान् यत्रार्था माधुरा अनु । स्रौघ्नाश्च वणिजो यत्र कुशलानूरुजानुप ॥",
