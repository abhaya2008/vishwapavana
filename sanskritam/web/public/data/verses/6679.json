  },
  {
    "id": 20011067,
    "chapter_id": 6679,
    "verse_number": "7.77",
    "content_sanskrit": "विज्ञाय प्रकृतीस्सर्वाः कुर्वद्भिः प्रत्ययं परम् । यद्वैयाकरणै रेजे कार्यज्ञैस्सेवकैरिव ॥",
