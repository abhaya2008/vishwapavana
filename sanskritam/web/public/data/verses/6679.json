    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20011084,
    "chapter_id": 6679,
    "verse_number": "7.94",
    "content_sanskrit": "पूर्वाह्णेतनमप्यापराह्णिकं चैव यज्जनः । कृत्वादैवसिकं कर्म नैशं निरविशत्सुखम् ॥",
