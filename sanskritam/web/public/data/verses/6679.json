    "avatarnika": ""
  },
  {
    "id": 20011096,
    "chapter_id": 6679,
    "verse_number": "7.106",
    "content_sanskrit": "श्रुत्वा मृगाणां नैशानां वाशितानि निशात्यये । यत्रालिङ्ग्य प्रियान् गाढं शयनानि जहुः प्रियाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
