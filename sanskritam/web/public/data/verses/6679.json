    "avatarnika": ""
  },
  {
    "id": 20011099,
    "chapter_id": 6679,
    "verse_number": "7.109",
    "content_sanskrit": "अंसग्रैवेयमूर्धन्यकौशेयाभरणोज्वलम् । जुष्टं बान्धववर्गीणैर्मित्रवर्गैश्च राजभिः ॥",
