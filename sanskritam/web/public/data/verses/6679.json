    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20011068,
    "chapter_id": 6679,
    "verse_number": "7.78",
    "content_sanskrit": "आर्चादिभिर्नृपस्यार्च्यैः पैप्पलादैः कठैरपि । यत् कौषीतकिभिश्चाभात् ताण्डिभिश्चैतरेयिभिः ॥",
