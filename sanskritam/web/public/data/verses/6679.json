  },
  {
    "id": 20011089,
    "chapter_id": 6679,
    "verse_number": "7.99",
    "content_sanskrit": "शिथिलीकृतकौशेयाः कराग्रैरौपनीविकैः । सौधपृष्ठगता यत्र वरा नारीररीरमन् ॥",
