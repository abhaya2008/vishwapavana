  },
  {
    "id": 20011101,
    "chapter_id": 6679,
    "verse_number": "7.111",
    "content_sanskrit": "विकस्वरमुखाम्भोजं पाण्डवोपि ददर्श तम् । सत्कृतश्च यथान्यायं तेन तस्याविशद्गृहम् ॥",
