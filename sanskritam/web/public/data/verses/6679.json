    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20011073,
    "chapter_id": 6679,
    "verse_number": "7.83",
    "content_sanskrit": "सहपौराणिकाश्चेरुस्सदा यत्रैतिहासिकाः । आख्यायिकाचणाश्चैव काव्यनाटकचुञ्चवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20011074,
    "chapter_id": 6679,
    "verse_number": "7.84",
    "content_sanskrit": "देशादौदुंबराच्चैवाद्वैदिशाच्चागतैः पुरात् । साहस्रपरिखं पूर्णं यत् कौशांबीसमं जनैः ॥",
