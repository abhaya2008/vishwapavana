[
  {
    "id": 20010991,
    "chapter_id": 6679,
    "verse_number": "7.1",
    "content_sanskrit": "ततस्ततयशा गत्वामगलूरान्महीमणिः । दक्षिणो दाक्षिणात्यानि पार्थस्तीर्थान्यसेवत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20010992,
    "chapter_id": 6679,
    "verse_number": "7.2",
    "content_sanskrit": "तत्र दिव्याङ्गनाः पञ्चत्रितयादुज्जहार सः । नारदस्य मुनेश्शापात् ग्राहजातेरुदन्वतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20010993,
    "chapter_id": 6679,
    "verse_number": "7.3",
    "content_sanskrit": "तास्तेन कमनीयाङ्ग्यः स्मित्या वाचाच सत्कृताः । पीत्वा तं नयनैः कृत्वा हृदि चारुरुहुर्दिवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20010994,
    "chapter_id": 6679,
    "verse_number": "7.4",
    "content_sanskrit": "सौभद्रादिषु तीर्थेषु मिलितान् स महामुनीन् । प्राग्ग्राहभीत्या मुक्तेषु तदापश्यन्मुदाकुलान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20010995,
    "chapter_id": 6679,
    "verse_number": "7.5",
    "content_sanskrit": "वैश्वामित्रं महर्षिं स माधुच्छन्दसमैक्षत । जेतारं जितपाप्मानं माधुच्छन्दसमप्यृषिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20010996,
    "chapter_id": 6679,
    "verse_number": "7.6",
    "content_sanskrit": "मेधातिथिं तथा काण्वं सम्यगाराधितातिथिम् । आजीगर्तिं शुनश्शेफं वैश्वामित्रञ्च कृत्रिमम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20010997,
    "chapter_id": 6679,
    "verse_number": "7.7",
    "content_sanskrit": "मुनिमाङ्गिरसञ्चापि हिरण्यस्तूपसंज्ञकम् । घोरं कण्वं तथा काण्वं प्रस्कण्वं कण्ववर्जितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20010998,
    "chapter_id": 6679,
    "verse_number": "7.8",
    "content_sanskrit": "सव्यमाङ्गिरसञ्चैव सौधसञ्चापि गौतमम् । शाक्तं पराशरञ्चैव सराहूगणगौतमम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20010999,
    "chapter_id": 6679,
    "verse_number": "7.9",
    "content_sanskrit": "कुत्समाङ्गिरसञ्चैव मारीचमपि काश्यपम् । ऋजाश्वादीन् सुराधोन्तानपि वार्षागिरानृषीन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20011000,
    "chapter_id": 6679,
    "verse_number": "7.10",
    "content_sanskrit": "कक्षीवन्तं तथा दीर्घतमसं मुनिसत्तमम् । पितरं तस्य चौचथ्यं दृष्टसूक्तकदंबकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20011001,
    "chapter_id": 6679,
    "verse_number": "7.11",
    "content_sanskrit": "दैवोदासिं परुच्छेपं मैत्रावरुणिमप्यृषिम् । अगस्त्यमौर्वशेयं च वसिष्ठभ्रातरं विभुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20011002,
    "chapter_id": 6679,
    "verse_number": "7.12",
    "content_sanskrit": "ऋषिमाङ्गिरसञ्चापि शौनकं दृष्टमण्डलम् । कूर्मं गार्त्समदञ्चैव विश्वामित्रञ्च गाथिनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20011003,
    "chapter_id": 6679,
    "verse_number": "7.13",
    "content_sanskrit": "कुशिकं गाथिनं चर्षि विश्वामित्रांश्च विश्रुतान् । परमात्मविदामाद्यं वामदेवञ्च गौतमम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20011004,
    "chapter_id": 6679,
    "verse_number": "7.14",
    "content_sanskrit": "तपस्सलिलराशिञ्च भौममत्रिं सहात्रिभिः । दृष्टिंगुप्तेरभूद्यस्य सोममण्डलमौक्तिकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20011005,
    "chapter_id": 6679,
    "verse_number": "7.15",
    "content_sanskrit": "बार्हस्पत्यं भरद्वाजं भरद्वाजैस्तथा सह । वसिष्ठैस्सह कुंभोत्थं वसिष्ठञ्च महामुनिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20011006,
    "chapter_id": 6679,
    "verse_number": "7.16",
    "content_sanskrit": "मेधातिथिप्रधानांश्च सन्दृष्टाष्टममण्डलान् । मधुच्छन्दपुरोगांश्च सोममण्डलमण्डनान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20011007,
    "chapter_id": 6679,
    "verse_number": "7.17",
    "content_sanskrit": "अन्तिमं मण्डलं द्रष्टृनृग्वेदस्य महामुनीन् । त्रितादींश्च स तान् दृष्ट्वा भक्तिनम्रोऽभ्यवन्दत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20011008,
    "chapter_id": 6679,
    "verse_number": "7.18",
    "content_sanskrit": "क्रमेणर्ग्वेदसूक्तानि ददृशुर्ये महर्षयः । ते मयैवमनुक्रान्ताः पुण्यश्रवणकीर्तनाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20011009,
    "chapter_id": 6679,
    "verse_number": "7.19",
    "content_sanskrit": "द्वैपायनञ्च सोपश्यत्तत्रायातं पितामहम् । ऋर्षिं कथायाः कर्तारं भारत्यास्सन्ततेरपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20011010,
    "chapter_id": 6679,
    "verse_number": "7.20",
    "content_sanskrit": "जटालं जलदश्यामं कृष्णकृत्स्न्युपवीतिनम् । सनीवारं सशैवालं समृणालमिव ह्रदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20011011,
    "chapter_id": 6679,
    "verse_number": "7.21",
    "content_sanskrit": "सदण्डशाखं सुच्छायं साक्षमालाफलावलिम् । विद्यालताढ्यं सशुकं कल्पद्रुमिव जङ्गमम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20011012,
    "chapter_id": 6679,
    "verse_number": "7.22",
    "content_sanskrit": "दधानमायतं बाहुं व्याख्यायामौपजानुकम् । शोषेण धूसरं दर्भपवित्रं'चौपकर्णिकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20011013,
    "chapter_id": 6679,
    "verse_number": "7.23",
    "content_sanskrit": "आनन्दनमशेषाणां पावनञ्च शरीरिणाम् । सर्वावदातं गंभीरं भागीरथ्या इव ह्रदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20011014,
    "chapter_id": 6679,
    "verse_number": "7.24",
    "content_sanskrit": "पितामहस्य पाणिभ्यां स पादावभ्यवन्दत । स च तं मूर्ध्न्युपाघ्राय प्रेमार्द्रः परिषस्वजे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20011015,
    "chapter_id": 6679,
    "verse_number": "7.25",
    "content_sanskrit": "हितं प्रोवाच सर्वज्ञो यथाविध्यर्चितस्स तम् । वक्ति सूक्तमपृष्टो यस्तद्धि स्नेहस्य लक्षणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20011016,
    "chapter_id": 6679,
    "verse_number": "7.26",
    "content_sanskrit": "वने निवसता सत्यं दिष्ट्या संरक्षितं त्वया । सत्ये हि गुप्ते तन्मूलः प्रथते धर्मपादपः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20011017,
    "chapter_id": 6679,
    "verse_number": "7.27",
    "content_sanskrit": "सत्यमूलः क्रियातो यैर्धर्मवृक्षो विवर्धितः । कामार्थपुष्पितो मुक्तिं फलति द्विजसेवितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20011018,
    "chapter_id": 6679,
    "verse_number": "7.28",
    "content_sanskrit": "वृत्तं माहाकुल'त्वेधि वृत्ते माहाकुलीनता । कुलीनता च वृत्तञ्च'प्रेप्सनीये ततो बुधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20011019,
    "chapter_id": 6679,
    "verse_number": "7.29",
    "content_sanskrit": "आदृत्याय सदा सद्भिसदाचाराय कल्पते । पुरुषो बहुकुलयोपि किमु कौशेयकः पुमान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20011020,
    "chapter_id": 6679,
    "verse_number": "7.30",
    "content_sanskrit": "मनसा कर्मणा वाचा सर्वलोकस्य निग्रहः । दुष्कुलीने सदालक्ष्यस्सुकुलीने विपर्ययः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20011021,
    "chapter_id": 6679,
    "verse_number": "7.31",
    "content_sanskrit": "शरीरिणमशेषाणां चित्तादिभिरनुग्रहः । सदा महाकुलीनेस्ति दौष्कुलेये विपर्ययः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20011022,
    "chapter_id": 6679,
    "verse_number": "7.32",
    "content_sanskrit": "वर्तध्वं कुल्यवद्यूयं तत्सदा पाण्डुनन्दनाः । धार्तराष्ट्रास्तु वर्तन्तां मूर्खा नीचकुलीनवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20011023,
    "chapter_id": 6679,
    "verse_number": "7.33",
    "content_sanskrit": "राजन्यस्य हि जातस्य स्वं भवत्यखिला मही । विपक्षाः क्षत्रियास्सर्वे कुटुंबस्सकलाः प्रजाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20011024,
    "chapter_id": 6679,
    "verse_number": "7.34",
    "content_sanskrit": "अन्धो राजा पितृव्यो वः प्रज्ञाचक्षुः किमुच्यते ? युष्मान् करोति भ्रातृव्यान् भ्रातृव्यान् सुधियोपि यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20011025,
    "chapter_id": 6679,
    "verse_number": "7.35",
    "content_sanskrit": "स्वयं दुर्योधनः पापः स्वस्रीयश्शकुनैः किमु ? रूढः कारस्करस्कन्धे तिक्तो निंबतरुः कियत् ? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20011026,
    "chapter_id": 6679,
    "verse_number": "7.36",
    "content_sanskrit": "आ जन्मनस्सहमात्यैः कर्णदुश्शासनादिभिः । हन्तुमुत्सहते युष्मान् सविपाशीविषादिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20011027,
    "chapter_id": 6679,
    "verse_number": "7.37",
    "content_sanskrit": "हित्वा मातृष्वसेयान्वश्चैद्यो यात्युरगध्वजम् । पापस्वभावस्संबन्धादैकात्म्यं प्रेमकृत्तरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20011028,
    "chapter_id": 6679,
    "verse_number": "7.38",
    "content_sanskrit": "दैत्यांशा भूभुजस्सर्वे भुजगध्वजतः स्थिताः । आदित्यभागा भूपालाः पुनरादित्यपुत्रतः ॥",
    "padaccheda": "",
    "anvaya": "",
