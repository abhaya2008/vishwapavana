  },
  {
    "id": 20011098,
    "chapter_id": 6679,
    "verse_number": "7.108",
    "content_sanskrit": "श्रुत्वा नृपागतं पार्थं पार्थिवश्चित्रवाहनः । मुख्यामात्यवृतः प्रीतस्सम्भ्रान्तः प्रत्युदव्रजत् ॥",
