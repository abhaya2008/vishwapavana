    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20011071,
    "chapter_id": 6679,
    "verse_number": "7.81",
    "content_sanskrit": "यत् षोडशसु निष्णातैः प्रमाणादिष्वशोभत । नैयायिकैंस्तथा षट्सु निष्णैरर्थेषु पण्डितैः ॥",
