    "avatarnika": ""
  },
  {
    "id": 20011086,
    "chapter_id": 6679,
    "verse_number": "7.96",
    "content_sanskrit": "अपराह्णेतनस्नानशीतलैः स्तनमण्डलैः । आलिङ्गन्नङ्गना यत्र गाढं ग्रीष्मेषु वल्लभान् ॥",
