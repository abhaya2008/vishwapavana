    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20011075,
    "chapter_id": 6679,
    "verse_number": "7.85",
    "content_sanskrit": "अङ्गेभ्यः प्राच्यवङ्गेभ्यः कुरुभ्यश्च यदावसत् । जनो जनपदात् स्फीतं लोको ह्यतिशयप्रियः ॥",
