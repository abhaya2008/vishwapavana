    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20011076,
    "chapter_id": 6679,
    "verse_number": "7.86",
    "content_sanskrit": "वेतस्वद्भिः कुमुद्वद्भिः शाद्वलैरपि यद्वभौ । शीतानिलैर्महीभागैर्नीरन्ध्रोद्यानपङ्क्तिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20011077,
    "chapter_id": 6679,
    "verse_number": "7.87",
    "content_sanskrit": "अधिष्ठितं यद्ग्रामीणैर्मृगैः कौलेयकादिभिः । पञ्जरस्थैस्तथारण्यैस्सिंहव्याघ्रपुरस्सरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20011078,
    "chapter_id": 6679,
    "verse_number": "7.88",
    "content_sanskrit": "स्फुरत्किरणसौवर्णग्रैवेयकविभूषिताः । यत्रैक्षन्त कुरङ्गाक्ष्यः कौक्षेयकभृतो भटान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20011079,
    "chapter_id": 6679,
    "verse_number": "7.89",
    "content_sanskrit": "पौरस्त्याद्दाक्षिणात्याच्च पाश्चात्याच्च पयोनिधेः । उदीच्याच्चाहृतै रत्नैराढ्या यत्राभवन्विशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20011080,
    "chapter_id": 6679,
    "verse_number": "7.90",
    "content_sanskrit": "यत्राधश्चक्रुरुत्तुङ्गसौधशृङ्गजुषोऽङ्गनाः । सहाप्सरोमुखैर्दिव्यमिन्दुबिंबं निजाननैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20011081,
    "chapter_id": 6679,
    "verse_number": "7.91",
    "content_sanskrit": "कापिशायनसंभिन्नकान्ताधरसुधालिहः । राङ्कवाजिनपर्यङ्कान् पौरा यत्राध्यशेरत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
