    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20011097,
    "chapter_id": 6679,
    "verse_number": "7.107",
    "content_sanskrit": "रमण्यो रमणान् यत्र नैशिक्योऽरमयन्निशः । नैशान् कलाप्रयोगेषु शिक्षितान् साधु शिक्षिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
