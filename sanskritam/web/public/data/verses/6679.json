    "avatarnika": ""
  },
  {
    "id": 20011072,
    "chapter_id": 6679,
    "verse_number": "7.82",
    "content_sanskrit": "व्याख्यातृभिः कुशाग्रीयधीभिर्मीमांसकैरपि । यद्वैयाकरणैश्चैन्द्रचान्द्रादिनिपुणैर्बभौ ॥",
