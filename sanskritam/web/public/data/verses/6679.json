    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20011070,
    "chapter_id": 6679,
    "verse_number": "7.80",
    "content_sanskrit": "स्वयं भ्रान्तिमबिभ्राणान् कृत्रिमाकारमोहितः । कृशाश्विन इवापश्यद्यत्र कर्मन्दिनो जनः ॥",
