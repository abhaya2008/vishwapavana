  },
  {
    "id": 20011029,
    "chapter_id": 6679,
    "verse_number": "7.39",
    "content_sanskrit": "भ्रात्रीयो जनयित्र्या वस्तेषु कृष्णस्सुहृत्तमः । भूभारभूतभूपानां जिहीर्षुरपि मण्डलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20011030,
    "chapter_id": 6679,
    "verse_number": "7.40",
    "content_sanskrit": "तस्याग्रतो हली श्रीमान् जामातरि सुयोधने । समः पैतृष्वसेयेषु युष्मासु च महाबलः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20011031,
    "chapter_id": 6679,
    "verse_number": "7.41",
    "content_sanskrit": "पौतृष्वस्त्रीयवात्सल्याद्युष्मानेव सदाश्रितः । भ्रूलतावश्यनिश्शेषवृष्णिचक्रस्तु चक्रभृत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20011032,
    "chapter_id": 6679,
    "verse_number": "7.42",
    "content_sanskrit": "पैतृष्वसेयमप्यब्जनयनो दमघोषजम् । हन्ता विदधतं क्रोधादपराधान् परश्शतान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20011033,
    "chapter_id": 6679,
    "verse_number": "7.43",
    "content_sanskrit": "प्ररोहयन्महद्वैरं युष्मासु हृदि सात्यकेः । कृतवर्मा तु हार्दिक्यो नागकेतुं गमिष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20011034,
    "chapter_id": 6679,
    "verse_number": "7.44",
    "content_sanskrit": "वर्धमाने क्रमेणेत्थं वैरे सकलभूभृताम् । जेतुं जागृहि जिष्णो त्वं त्वय्यधीना हि पाण्डवाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20011035,
    "chapter_id": 6679,
    "verse_number": "7.45",
    "content_sanskrit": "नप्तारो धार्तराष्ट्राश्च पाण्डवाश्चोभयेपि मे । तदपीच्छामि वो भूतिं सन्तस्सतपक्षपातिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20011036,
    "chapter_id": 6679,
    "verse_number": "7.46",
    "content_sanskrit": "आर्याणां क्वापि संप्रीतिरिन्दुपादेन्दुकान्तवत् । अन्योन्यं प्रत्यनार्याणां तथोलूकान्धकारवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20011037,
    "chapter_id": 6679,
    "verse_number": "7.47",
    "content_sanskrit": "उत्तमो नम्रतामेति ज्ञानभारं वहन्निव । विभर्त्युत्तालतामेव तमविभ्रदिवेतरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20011038,
    "chapter_id": 6679,
    "verse_number": "7.48",
    "content_sanskrit": "अदर्शने प्रकाशन्ते न दृश्यन्ते प्रकाशने । धामराशेरधामानः खद्योताः खमणेरिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20011039,
    "chapter_id": 6679,
    "verse_number": "7.49",
    "content_sanskrit": "तपःकृशितसर्वाङ्गान् शास्त्राधीनान् सतस्तदा । 'प्रभिन्ना विविधैर्भागैर्निन्दन्त्यज्ञा निरङ्कुशाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20011040,
    "chapter_id": 6679,
    "verse_number": "7.50",
    "content_sanskrit": "नश्वरेणाऽविशुद्धेन दुःखानुभवहेतुना । विपरीतं यशःकायं कायेन क्रीणते' बुधाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20011041,
    "chapter_id": 6679,
    "verse_number": "7.51",
    "content_sanskrit": "अभ्यन्तरानरातींस्त्वं जय पूर्वं धनञ्जय ! इन्द्रियाणि दशैकञ्च षट् च कामपुरस्सरान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20011042,
    "chapter_id": 6679,
    "verse_number": "7.52",
    "content_sanskrit": "विजित्याभ्यन्तरानैतान् जय बाह्यानरीन् पुनः । सेवस्व दण्डनीतिञ्च पण्डितांश्चैधि शान्तिमान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20011043,
    "chapter_id": 6679,
    "verse_number": "7.53",
    "content_sanskrit": "निर्जित्य पृथिवीपालान् करदीकृत्य चाखिलान् । भ्रातृभिस्सह धीमन्तं सम्राट्कुरु युधिष्टिरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20011044,
    "chapter_id": 6679,
    "verse_number": "7.54",
    "content_sanskrit": "इत्युक्त्वान्तर्हिते व्यासे मुदितः श्वेतवाहनः । आमन्त्र्य तान्मुनीनुक्तो मणलूरपुरं ययौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20011045,
    "chapter_id": 6679,
    "verse_number": "7.55",
    "content_sanskrit": "प्रविश्य तत्पुरं पार्थो द्विजभृत्यजनान्वितः । ददर्श दर्शनीयाङ्गप्रोतनारीनरेक्षणः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20011046,
    "chapter_id": 6679,
    "verse_number": "7.56",
    "content_sanskrit": "पौंस्रेन जुष्टं माञ्जिष्ठहारिद्रांबरधारिणा । लाक्षिकांघ्रिप्रवालेन स्त्रैणेन परिभूषितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20011047,
    "chapter_id": 6679,
    "verse_number": "7.57",
    "content_sanskrit": "पुरोहितैश्चतुर्वेदै रक्षितं क्षपिताशुभैः । अमात्यैश्च कुशाग्रीयधिषणैर्धिषणोपमैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20011048,
    "chapter_id": 6679,
    "verse_number": "7.58",
    "content_sanskrit": "पौषमेतदहः पौषी रात्रिरेषाद्य रोहिणी । नृपतिं नित्यमित्यादि वदद्भिर्गणकैर्युतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20011049,
    "chapter_id": 6679,
    "verse_number": "7.59",
    "content_sanskrit": "कालेयवामदेव्यादिसामस्वृक्षु यजुष्षु च । दक्षिणैः क्षोणिगीर्वाणैरात्विजीनैरलङ्कृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20011050,
    "chapter_id": 6679,
    "verse_number": "7.60",
    "content_sanskrit": "पाण्डुकम्बलिभिर्जुष्टं द्वैपैरपि रथैस्सदा । आगत्य सेव्यमानानां गोपुरे पृतनाभृताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20011051,
    "chapter_id": 6679,
    "verse_number": "7.61",
    "content_sanskrit": "विस्रम्भयद्भिः कौमारीर्जाया लज्जाविभूषणाः । कौमारैः पतिभिर्जुष्टमनोज्ञशयनालयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20011052,
    "chapter_id": 6679,
    "verse_number": "7.62",
    "content_sanskrit": "शरावाद्यन्नपुष्टाङ्गसूदजुष्टमहानसम् । श्रितं विविक्तदेशस्थैर्व्रतिभिः स्थाण्डिलादिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20011053,
    "chapter_id": 6679,
    "verse_number": "7.63",
    "content_sanskrit": "श्राणाः पिबद्भिः क्षैरेयीर्गोमिभिर्नागरैर्वृतम् । भ्राष्ट्रानपूपानश्नद्भिः शूल्यानि पिशितानि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20011054,
    "chapter_id": 6679,
    "verse_number": "7.64",
    "content_sanskrit": "चैत्रिके मासि वैशाखे ज्यैष्ठे चापाढनाम्नि च । श्रावणाख्ये तथा भाद्र आश्विने कार्तिके तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20011055,
    "chapter_id": 6679,
    "verse_number": "7.65",
    "content_sanskrit": "आग्रहायणिके तैषमाघफाल्गुनिकेषु च । पुष्पितैः पादपैर्जुष्टं निष्कुटेषून्मदालिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20011056,
    "chapter_id": 6679,
    "verse_number": "7.66",
    "content_sanskrit": "जानता कायमुख्यानि सूक्तानि च हवींषि च । ऋतुस्वाध्यायपूतेन ब्रह्मण्येन विभूषितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20011057,
    "chapter_id": 6679,
    "verse_number": "7.67",
    "content_sanskrit": "शौकजुष्टतरूद्यानश्रितसामिकयौवनम् । स राजन्यकमुद्रिक्तराजपुत्रकराजितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20011058,
    "chapter_id": 6679,
    "verse_number": "7.68",
    "content_sanskrit": "नानार्थक्रीतिविक्रीतिव्यग्रमानुष्यकापणम् । सहास्तिकैभशालाढ्यं लसद्दश्वीयमन्दुरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20011059,
    "chapter_id": 6679,
    "verse_number": "7.69",
    "content_sanskrit": "क्रीडत्कापोतमायूरं सर्वतो जनताकुलम् । औष्ट्रकौरभ्रकोपेतां रथकट्यापरिष्कृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20011060,
    "chapter_id": 6679,
    "verse_number": "7.70",
    "content_sanskrit": "धैनुकैर्वात्सकोपैतैस्तृण्याकबलनाकुलैः । वृषस्य दौष्करारूढैर्भूषितोपवनान्तरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20011061,
    "chapter_id": 6679,
    "verse_number": "7.71",
    "content_sanskrit": "सहायतां महीपस्य बन्धुतां च समाश्रितैः । ग्रामतायां द्विजैः प्राप्तैः कार्यार्थिभिरलङ्कृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20011062,
    "chapter_id": 6679,
    "verse_number": "7.72",
    "content_sanskrit": "सुगन्धिसुमनोगर्भकैश्यवेश्याविभूषितैः । वेशैरलङ्कृतं कामिनिकायकलहाकुलैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20011063,
    "chapter_id": 6679,
    "verse_number": "7.73",
    "content_sanskrit": "शैवादिविषयोद्भूतैः पूर्णमापतितैर्जनैः । बार्हतादिप्रगाथज्ञैः श्रोत्रियैश्च द्विजातिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20011064,
    "chapter_id": 6679,
    "verse_number": "7.74",
    "content_sanskrit": "संघर्षभरितैर्जुष्टं स्रैणैः पौंस्नैर्महाहवैः । दाण्डामौष्टादिकामिश्च क्रीडाभिः कृतिनां नृणाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20011065,
    "chapter_id": 6679,
    "verse_number": "7.75",
    "content_sanskrit": "पीवरोरुभुजस्कन्धैर्व्यायामक्रशितोदरैः । कर्तृभिर्मृगया राज्ञश्यैनंपाता भटैर्नुतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20011066,
    "chapter_id": 6679,
    "verse_number": "7.76",
    "content_sanskrit": "यद्वैयाकरणै रेजे नरुक्तैश्शिक्षकैरपि । मौहूर्तैश्छान्दसैः प्राज्ञैः कल्पसूत्रादिमिस्तथा ॥",
