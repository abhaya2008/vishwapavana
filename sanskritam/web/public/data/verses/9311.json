[{"id": 40019389, "chapter_id": 9311, "verse_number": "1", "content_sanskrit": "प्रतिप्रयातेकाकुत्स्थेमहेन्द्रःपाकशासनः । अब्रवीत्परमप्रीतोराघवंप्राञ्जलिंस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40019390, "chapter_id": 9311, "verse_number": "2", "content_sanskrit": "अमोघंदर्शनंराम तवास्माकंनरर्षभ । प्रीतियुक्ताःस्मतेनत्वंब्रूहियन्मनसेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40019391, "chapter_id": 9311, "verse_number": "3", "content_sanskrit": "एवमुक्तोमहेन्द्रेणप्रसन्नेनमहात्मना । सुप्रसन्नमनाहृष्टोवचनंप्राहराघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40019392, "chapter_id": 9311, "verse_number": "4", "content_sanskrit": "यदिप्रीतिस्समुत्पन्नामयितेविबुधेश्वर । वक्ष्यामिकुरुमेसत्यंवचनंवदतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40019393, "chapter_id": 9311, "verse_number": "5", "content_sanskrit": "ममहेतोःपराक्रान्तायेगतायमसादनम् । तेसर्वेजीवितंप्राप्यसमुततिष्ठन्तुवानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40019394, "chapter_id": 9311, "verse_number": "6", "content_sanskrit": "मत्कृतेविप्रयुक्तायेपुत्रैर्दारैश्चवानराः । तान्प्रीतमनसःसर्वान्द्रष्टुमिच्छामिमानद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019395, "chapter_id": 9311, "verse_number": "7", "content_sanskrit": "विक्रान्ताश्चापिशूराश्च न मृत्युंगणयन्ति च । कृतयत्नाविपन्नाश्चजीवयैनान् पुरन्दर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019396, "chapter_id": 9311, "verse_number": "8", "content_sanskrit": "मत्प्रियेष्वभिरक्ताश्च न मृत्युंगणयन्तिये । त्वत्प्रसादात्समेयुस्तेवरमेतमहंवृणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019397, "chapter_id": 9311, "verse_number": "9", "content_sanskrit": "नीरुजोनिर्व्रणांश्चैवसम्पन्नबलपौरुषान् । गोलाङ्गूलांस्तथैवर्क्षांन्द्रष्टुमिच्छामिमानद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019398, "chapter_id": 9311, "verse_number": "10", "content_sanskrit": "अकालेचापिपुष्पाणिमूलानि च फलानि च । नद्यश्चविमलास्तत्रतिष्ठेयुर्यत्रवानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019399, "chapter_id": 9311, "verse_number": "11", "content_sanskrit": "श्रुत्वातुवचनंतस्यराघवस्यमहात्मनः । महेन्द्रःप्रत्युवाचेदंवचनंप्रीतिसंयुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019400, "chapter_id": 9311, "verse_number": "12", "content_sanskrit": "महानयंवरस्तातयस्त्वयोक्तोरघूत्तम । वदिर्मयानोक्तपूर्वं च तस्मादेतद्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019401, "chapter_id": 9311, "verse_number": "13", "content_sanskrit": "समुत्तिष्ठन्तुतेसर्वेहतायेयुधिराक्षसैः । ऋक्षाश्चसहगोपुच्छैर्निकृत्ताननबाहवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019402, "chapter_id": 9311, "verse_number": "14", "content_sanskrit": "नीरुजोनिर्व्रणाश्चैवसम्पन्नबलपौरुषाः । समुत्थास्यन्तिहरयस्सुप्तानिद्राक्ष्येयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019403, "chapter_id": 9311, "verse_number": "15", "content_sanskrit": "सुहृद्भिर्बान्धवैश्चैवज्ञातिभिःस्वजनेन च । सर्वएवसमेष्यन्तिसम्युक्ताःपरयामुदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019404, "chapter_id": 9311, "verse_number": "16", "content_sanskrit": "अकालेपुष्पशबलाःफलवन्तश्चपादपाः । भविष्यन्तिमहेष्वास नद्यश्चसलिलायुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019405, "chapter_id": 9311, "verse_number": "17", "content_sanskrit": "सव्रणैःप्रथमंगात्रैरिदानींनिर्व्रणैस्समैः । ततस्समुत्थितास्सर्वेसुप्त्वेवहरियूथपाः ॥ बभूवुर्वानरास्सर्वेकिंन्वेतदितिविस्मिताः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019406, "chapter_id": 9311, "verse_number": "18", "content_sanskrit": "काकुत्स्थंपरिपूर्णार्थंदृष्टवासर्वेसुरोत्तमाः ॥ अब्रुवन्परमप्रीतास्स्तुत्वारामंसलक्ष्मणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019407, "chapter_id": 9311, "verse_number": "19", "content_sanskrit": "गच्छायोध्यामितोराजन्विसर्जय च वानरान् ॥ मैथिलींसान्त्वयस्वैनामनुरक्तांयशस्विनीम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019408, "chapter_id": 9311, "verse_number": "20", "content_sanskrit": "भ्रारातरंभरतंपश्यत्वच्छोकाद्व्रतचारिणम् ॥ शत्रुघ्नं च महात्मानंमात्रूःसर्वाःपरन्तप । अभिषेचयचात्मानंपौरान्गत्वाप्रहर्षय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40019409, "chapter_id": 9311, "verse_number": "21", "content_sanskrit": "भ्रारातरंभरतंपश्यत्वच्छोकाद्व्रतचारिणम् ॥ शत्रुघ्नं च महात्मानंमात्रूःसर्वाःपरन्तप । अभिषेचयचात्मानंपौरान्गत्वाप्रहर्षय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40019410, "chapter_id": 9311, "verse_number": "22", "content_sanskrit": "एवमुक्त्वासहस्राक्षोरामंसौमित्रिणासह । विमानैःसूर्यसङ्काशैर्ययौहृष्टःसुरैःसह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40019411, "chapter_id": 9311, "verse_number": "23", "content_sanskrit": "अभिवाद्य च काकुत्स्थ: सर्वांस्तांस्त्रिदशोत्तमान् । लक्ष्मणेनसहभ्रात्रावासमाज्ञापयत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]