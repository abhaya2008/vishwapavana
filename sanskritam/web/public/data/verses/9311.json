[{"id": 5000311000, "chapter_id": 9311, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे एकोनचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000311001, "chapter_id": 9311, "verse_number": "४-३९-१", "content_sanskrit": "इति ब्रुवाणं सुग्रीवं रामो धर्मभृतां वरः।\nबाहुभ्यां सम्परिष्वज्य प्रत्युवाच कृताञ्जलिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000311002, "chapter_id": 9311, "verse_number": "४-३९-२", "content_sanskrit": "यदिन्द्रो वर्षते वर्षं न तच्चित्रं भविष्यति।\nआदित्योऽसौ सहस्रांशुः कुर्याद् वितिमिरं नभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000311003, "chapter_id": 9311, "verse_number": "४-३९-३", "content_sanskrit": "चन्द्रमा रजनीं कुर्यात् प्रभया सौम्य निर्मलाम्।\nत्वद्विधो वापि मित्राणां प्रीतिं कुर्यात् परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000311004, "chapter_id": 9311, "verse_number": "४-३९-४", "content_sanskrit": "एवं त्वयि न तच्चित्रं भवेद् यत् सौम्य शोभनम्।\nजानाम्यहं त्वां सुग्रीव सततं प्रियवादिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000311005, "chapter_id": 9311, "verse_number": "४-३९-५", "content_sanskrit": "त्वत्सनाथः सखे संख्ये जेतास्मि सकलानरीन्।\nत्वमेव मे सुहृन्मित्रं साहाय्यं कर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000311006, "chapter_id": 9311, "verse_number": "४-३९-६", "content_sanskrit": "जहारात्मविनाशाय मैथिलीं राक्षसाधमः।\nवञ्चयित्वा तु पौलोमीमनुह्लादो यथा शचीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000311007, "chapter_id": 9311, "verse_number": "४-३९-७", "content_sanskrit": "नचिरात् तं वधिष्यामि रावणं निशितैः शरैः।\nपौलोम्याः पितरं दृप्तं शतक्रतुरिवारिहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000311008, "chapter_id": 9311, "verse_number": "४-३९-८", "content_sanskrit": "एतस्मिन्नन्तरे चैव रजः समभिवर्तत।\nउष्णतीव्रां सहस्रांशोश्छादयद् गगने प्रभाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000311009, "chapter_id": 9311, "verse_number": "४-३९-९", "content_sanskrit": "दिशः पर्याकुलाश्चासंस्तमसा तेन दूषिताः।\nचचाल च मही सर्वा सशैलवनकानना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000311010, "chapter_id": 9311, "verse_number": "४-३९-१०", "content_sanskrit": "ततो नगेन्द्रसंकाशैस्तीक्ष्णदंष्ट्रैर्महाबलैः।\nकृत्स्ना संछादिता भूमिरसंख्येयैः प्लवंगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000311011, "chapter_id": 9311, "verse_number": "४-३९-११", "content_sanskrit": "निमेषान्तरमात्रेण ततस्तैर्हरियूथपैः।\nकोटीशतपरीवारैर्वानरैर्हरियूथपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000311012, "chapter_id": 9311, "verse_number": "४-३९-१२", "content_sanskrit": "नादेयैः पार्वतेयैश्च सामुद्रैश्च महाबलैः।\nहरिभिर्मेघनिर्ह्रादैरन्यैश्च वनवासिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000311013, "chapter_id": 9311, "verse_number": "४-३९-१३", "content_sanskrit": "तरुणादित्यवर्णैश्च शशिगौरैश्च वानरैः।\nपद्मकेसरवर्णैश्च श्वेतैर्हेमकृतालयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000311014, "chapter_id": 9311, "verse_number": "४-३९-१४", "content_sanskrit": "कोटीसहस्रैर्दशभिः श्रीमान् परिवृतस्तदा।\nवीरः शतबलिर्नाम वानरः प्रत्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000311015, "chapter_id": 9311, "verse_number": "४-३९-१५", "content_sanskrit": "ततः काञ्चनशैलाभस्ताराया वीर्यवान् पिता।\nअनेकैर्बहुसाहस्रैः कोटिभिः प्रत्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000311016, "chapter_id": 9311, "verse_number": "४-३९-१६", "content_sanskrit": "तथापरेण कोटीनां सहस्रेण समन्वितः।\nपिता रुमायाः सम्प्राप्तः सुग्रीवश्वशुरो विभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000311017, "chapter_id": 9311, "verse_number": "४-३९-१७", "content_sanskrit": "पद्मकेसरसंकाशस्तरुणार्कनिभाननः।\nबुद्धिमान् वानरश्रेष्ठः सर्ववानरसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000311018, "chapter_id": 9311, "verse_number": "४-३९-१८", "content_sanskrit": "अनेकैर्बहुसाहस्त्रैर्वानराणां समन्वितः।\nपिता हनुमतः श्रीमान् केसरी प्रत्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000311019, "chapter_id": 9311, "verse_number": "४-३९-१९", "content_sanskrit": "गोलाङ्गूलमहाराजो गवाक्षो भीमविक्रमः।\nवृतः कोटिसहस्रेण वानराणामदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000311020, "chapter_id": 9311, "verse_number": "४-३९-२०", "content_sanskrit": "ऋक्षाणां भीमवेगानां धूम्रः शत्रुनिबर्हणः।\nवृतः कोटिसहस्राभ्यां द्वाभ्यां समभिवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000311021, "chapter_id": 9311, "verse_number": "४-३९-२१", "content_sanskrit": "महाचलनिभैर्घोरैः पनसो नाम यूथपः।\nआजगाम महावीर्यस्तिसृभिः कोटिभिर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000311022, "chapter_id": 9311, "verse_number": "४-३९-२२", "content_sanskrit": "नीलाञ्जनचयाकारो नीलो नामैष यूथपः।\nअदृश्यत महाकायः कोटिभिर्दशभिर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000311023, "chapter_id": 9311, "verse_number": "४-३९-२३", "content_sanskrit": "ततः काञ्चनशैलाभो गवयो नाम यूथपः।\nआजगाम महावीर्यः कोटिभिः पञ्चभिर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000311024, "chapter_id": 9311, "verse_number": "४-३९-२४", "content_sanskrit": "दरीमुखश्च बलवान् यूथपोऽभ्याययौ तदा।\nवृतः कोटिसहस्रेण सुग्रीवं समवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000311025, "chapter_id": 9311, "verse_number": "४-३९-२५", "content_sanskrit": "मैन्दश्च द्विविदश्चोभावश्विपुत्रौ महाबलौ।\nकोटिकोटिसहस्रेण वानराणामदृश्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000311026, "chapter_id": 9311, "verse_number": "४-३९-२६", "content_sanskrit": "गजश्च बलवान् वीरस्तिसृभिः कोटिभिर्वृतः।\nआजगाम महातेजाः सुग्रीवस्य समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000311027, "chapter_id": 9311, "verse_number": "४-३९-२७", "content_sanskrit": "ऋक्षराजो महातेजा जाम्बवान्नाम नामतः।\nकोटिभिर्दशभिर्व्याप्तः सुग्रीवस्य वशे स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000311028, "chapter_id": 9311, "verse_number": "४-३९-२८", "content_sanskrit": "रुमणो नाम तेजस्वी विक्रान्तैर्वानरैर्वृतः।\nआगतो बलवांस्तूर्णं कोटीशतसमावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000311029, "chapter_id": 9311, "verse_number": "४-३९-२९", "content_sanskrit": "ततः कोटिसहस्राणां सहस्रेण शतेन च।\nपृष्ठतोऽनुगतः प्राप्तो हरिभिर्गन्धमादनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000311030, "chapter_id": 9311, "verse_number": "४-३९-३०", "content_sanskrit": "ततः पद्मसहस्रेण वृतः शङ्कुशतेन च।\nयुवराजोऽङ्गदः प्राप्तः पितुस्तुल्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000311031, "chapter_id": 9311, "verse_number": "४-३९-३१", "content_sanskrit": "ततस्ताराद्युतिस्तारो हरिभिर्भीमविक्रमैः।\nपञ्चभिर्हरिकोटीभिर्दूरतः पर्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000311032, "chapter_id": 9311, "verse_number": "४-३९-३२", "content_sanskrit": "इन्द्रजानुः कविर्वीरो यूथपः प्रत्यदृश्यत।\nएकादशानां कोटीनामीश्वरस्तैश्च संवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000311033, "chapter_id": 9311, "verse_number": "४-३९-३३", "content_sanskrit": "ततो रम्भस्त्वनुप्राप्तस्तरुणादित्यसंनिभः।\nअयुतेन वृतश्चैव सहस्रेण शतेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000311034, "chapter_id": 9311, "verse_number": "४-३९-३४", "content_sanskrit": "ततो यूथपतिर्वीरो दुर्मुखो नाम वानरः।\nप्रत्यदृश्यत कोटीभ्यां द्वाभ्यां परिवृतो बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000311035, "chapter_id": 9311, "verse_number": "४-३९-३५", "content_sanskrit": "कैलासशिखराकारैर्वानरैर्भीमविक्रमैः।\nवृतः कोटिसहस्रेण हनुमान् प्रत्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000311036, "chapter_id": 9311, "verse_number": "४-३९-३६", "content_sanskrit": "नलश्चापि महावीर्यः संवृतो द्रुमवासिभिः।\nकोटीशतेन सम्प्राप्तः सहस्रेण शतेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000311037, "chapter_id": 9311, "verse_number": "४-३९-३७", "content_sanskrit": "ततो दधिमुखः श्रीमान् कोटिभिर्दशभिर्वृतः।\nसम्प्राप्तोऽभिनदंस्तस्य सुग्रीवस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000311038, "chapter_id": 9311, "verse_number": "४-३९-३८", "content_sanskrit": "शरभः कुमुदो वह्निर्वानरो रंह एव च।\nएते चान्ये च बहवो वानराः कामरूपिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000311039, "chapter_id": 9311, "verse_number": "४-३९-३९", "content_sanskrit": "आवृत्य पृथिवीं सर्वां पर्वतांश्च वनानि च।\nयूथपाः समनुप्राप्ता येषां संख्या न विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000311040, "chapter_id": 9311, "verse_number": "४-३९-४०", "content_sanskrit": "आगताश्च निविष्टाश्च पृथिव्यां सर्ववानराः।\nआप्लवन्तः प्लवन्तश्च गर्जन्तश्च प्लवंगमाः।\nअभ्यवर्तन्त सुग्रीवं सूर्यमभ्रगणा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000311041, "chapter_id": 9311, "verse_number": "४-३९-४१", "content_sanskrit": "कुर्वाणा बहुशब्दांश्च प्रकृष्टा बाहुशालिनः।\nशिरोभिर्वानरेन्द्राय सुग्रीवाय न्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000311042, "chapter_id": 9311, "verse_number": "४-३९-४२", "content_sanskrit": "अपरे वानरश्रेष्ठाः संगम्य च यथोचितम्।\nसुग्रीवेण समागम्य स्थिताः प्राञ्जलयस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000311043, "chapter_id": 9311, "verse_number": "४-३९-४३", "content_sanskrit": "सुग्रीवस्त्वरितो रामे सर्वांस्तान् वानरर्षभान्।\nनिवेदयित्वा धर्मज्ञः स्थितः प्राञ्जलिरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000311044, "chapter_id": 9311, "verse_number": "४-३९-४४", "content_sanskrit": "यथासुखं पर्वतनिर्झरेषु\nवनेषु सर्वेषु च वानरेन्द्राः।\nनिवेशयित्वा विधिवद् बलानि\nबलं बलज्ञः प्रतिपत्तुमीष्टे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000311045, "chapter_id": 9311, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे एकोनचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]