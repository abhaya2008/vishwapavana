[{"id": 2005955, "chapter_id": 1117, "verse_number": "१-११८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005956, "chapter_id": 1117, "verse_number": "१-११८-१", "content_sanskrit": "धृतराष्ट्रे च पाण्डौ च विदुरे च महात्मनि।\nएषु त्रिषु कुमारेषु जातेषु कुरुजाङ्गलम्।\nकुरवोऽथ कुरुक्षेत्रं त्रयमेतदवर्धत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005957, "chapter_id": 1117, "verse_number": "१-११८-२", "content_sanskrit": "ऊर्ध्वसस्याऽभवद्भूमिः सस्यानि फलवन्ति च।\nयथर्तुवर्षी पर्जन्यो बहुपुष्पफला द्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005958, "chapter_id": 1117, "verse_number": "१-११८-३", "content_sanskrit": "वाहनानि प्रहृष्टानि मुदिता मृगपक्षिणः।\nगन्धवन्ति च माल्यानि रसवन्ति फलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005959, "chapter_id": 1117, "verse_number": "१-११८-४", "content_sanskrit": "वणिग्भिश्चान्वकीर्यन्त नगराण्यथ शिल्पिभिः।\nशूराश्च कृतविद्याश्च सन्तश्च सुखिनोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005960, "chapter_id": 1117, "verse_number": "१-११८-५", "content_sanskrit": "नाभवन्दस्यवः केचिन्नाधर्मरुचयो जनाः।\nप्रदेशेष्वपि राष्ट्राणां कृतं युगमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005961, "chapter_id": 1117, "verse_number": "१-११८-६", "content_sanskrit": "धर्मक्रिया यज्ञशीलाः सत्यव्रतपरायणाः।\nअन्योन्यप्रीतिसंयुक्ता व्यवर्धन्त प्रजास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005962, "chapter_id": 1117, "verse_number": "१-११८-७", "content_sanskrit": "मानक्रोधविहीनाश्च नरा लोभविवर्जिताः।\nअन्योन्यमभ्यनन्दन्त धर्मोत्तरमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005963, "chapter_id": 1117, "verse_number": "१-११८-८", "content_sanskrit": "तन्महोदधिवत्पूर्णं नगरं वै व्यरोचत।\nद्वारतोरणनिर्यूहैर्युक्तमभ्रचयोपमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005964, "chapter_id": 1117, "verse_number": "१-११८-९", "content_sanskrit": "प्रसादशतसंबाधं महेन्द्रपुरसन्निभम्।\nनदीषु वनखण्डेषु वापीपल्वलसानुषु।\nकाननेषु च रम्येषु विजह्रुर्मुदिता जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005965, "chapter_id": 1117, "verse_number": "१-११८-१०", "content_sanskrit": "उत्तरैः कुरुभिः सार्धं दक्षिणाः कुरवस्तथा।\nविस्पर्धमाना व्यचरंस्तथा देवर्षिचारणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005966, "chapter_id": 1117, "verse_number": "१-११८-११", "content_sanskrit": "नाभवत्कृपणः कश्चिन्नाभवन्विधवाः स्त्रियः।\nतस्मिञ्जनपदे रम्ये कुरुभिर्बहुलीकृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005967, "chapter_id": 1117, "verse_number": "१-११८-१२", "content_sanskrit": "कूपारामसभावाप्यो ब्राह्मणावसथास्तथा।\nबभूवुः सर्वर्द्धियुतास्तस्मिन्राष्ट्रे सदोत्सवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005968, "chapter_id": 1117, "verse_number": "१-११८-१३", "content_sanskrit": "भीष्मेण धर्मतो राजन्सर्वतः परिरक्षिते।\nबभूव रमणीयश्च चैत्ययूपशताङ्कितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005969, "chapter_id": 1117, "verse_number": "१-११८-१४", "content_sanskrit": "स देशः परराष्ट्राणि विमृज्याभिप्रवर्धितः।\nभीष्मेण विहितं राष्ट्रे धर्मचक्रमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005970, "chapter_id": 1117, "verse_number": "१-११८-१५", "content_sanskrit": "क्रियमाणेषु कृत्येषु कुमाराणां महात्मनाम्।\nपौरजानपदाः सर्वे बभूवुः परमोत्सुकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005971, "chapter_id": 1117, "verse_number": "१-११८-१६", "content_sanskrit": "गृहेषु कुरुमुख्यानां पौराणां च नराधिप।\nदीयतां भुज्यतां चेति वाचोऽश्रूयन्त सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005972, "chapter_id": 1117, "verse_number": "१-११८-१७", "content_sanskrit": "धृतराष्ट्रश्च पाण्डुश्च विदुरश्च महामतिः।\nजन्मप्रभृति भीष्मेण पुत्रवत्परिपालिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005973, "chapter_id": 1117, "verse_number": "१-११८-१८", "content_sanskrit": "संस्कारैः संस्कृतास्ते तु व्रताध्ययनसंयुताः।\nश्रमव्यायामकुशलाः समपद्यन्त यौवनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005974, "chapter_id": 1117, "verse_number": "१-११८-१९", "content_sanskrit": "धनुर्वेदे च वेदे च गदायुद्धेऽसिचर्मणि।\nतथैव गजशिक्षायां नीतिशास्त्रेषु पारगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005975, "chapter_id": 1117, "verse_number": "१-११८-२०", "content_sanskrit": "इतिहासपुराणेषु नानाशिक्षासु बोधिताः।\nवेदवेदाङ्गतत्त्वज्ञाः सर्वत्र कृतनिश्चयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005976, "chapter_id": 1117, "verse_number": "१-११८-२१", "content_sanskrit": "वैदिकाध्ययने युक्तो नीतिशास्त्रेषु पारगः।\nभीष्मेण राजा कौरव्यो धृतराष्ट्रोऽभिषेचितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005977, "chapter_id": 1117, "verse_number": "१-११८-२२", "content_sanskrit": "धनुर्वेदेऽश्वपृष्ठे च गदायुद्धेऽसिचर्मणि।\nतथैव गजशिक्षायामस्त्रेषु विविधेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005978, "chapter_id": 1117, "verse_number": "१-११८-२३", "content_sanskrit": "अर्थधर्मप्रधानासु विद्यासु विविधासु च।\nगतः पारं यदा पाण्डुस्तदा सेनापतिः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005979, "chapter_id": 1117, "verse_number": "१-११८-२४", "content_sanskrit": "पाण्डुर्धनुषि विक्रान्तो नरेष्वभ्यदिकोऽभवत्।\nअन्येभ्यो बलवानासीद्धृतराष्ट्रो महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005980, "chapter_id": 1117, "verse_number": "१-११८-२५", "content_sanskrit": "अमात्यो मनुजेन्द्रस्य बाल एव यशस्विनः।\nभीष्मेण सर्वधर्माणां प्रणेता विदुरः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005981, "chapter_id": 1117, "verse_number": "१-११८-२६", "content_sanskrit": "सर्वशास्त्रार्थतत्त्वज्ञो बुद्धिमेधापटुर्युवा।\nभावेनागमयुक्तेन सर्वं वेदयते जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005982, "chapter_id": 1117, "verse_number": "१-११८-२७", "content_sanskrit": "त्रिषु लोकेषु न त्वासीत्कश्चिद्विदुरसंमितः।\nधर्मनित्यस्तथा राजन्धर्मं च परमं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2005983, "chapter_id": 1117, "verse_number": "१-११८-२८", "content_sanskrit": "प्रनष्टं शान्तनोर्वंशं समीक्ष्य पुनरुद्धृतम्।\nततो निर्वचनं लोके सर्वराष्ट्रेष्ववर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2005984, "chapter_id": 1117, "verse_number": "१-११८-२९", "content_sanskrit": "वीरसूनां काशिसुते देशानां कुरुजाङ्गलम्।\nसर्वध्रमविदां भीष्मः पुराणां गजसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2005985, "chapter_id": 1117, "verse_number": "१-११८-३०", "content_sanskrit": "धृतराष्ट्रस्त्वचक्षुष्ट्वाद्रज्यं न प्रत्यपद्यत।\nपारसवत्वाद्विदुरो राजा पाण्डुर्बभूव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2005986, "chapter_id": 1117, "verse_number": "१-११८-३१", "content_sanskrit": "अथ शुश्राव विप्रेभ्यः कुन्तिभोजमहीपतेः।\nरूपयौवनसंपन्नां सुतां सागरगासुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2005987, "chapter_id": 1117, "verse_number": "१-११८-३२", "content_sanskrit": "सुबलस्य च कल्याणीं गान्धाराधिपतेः सुताम्।\nसुतां च मद्रराजस्य रूपेणाप्रतिमां भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2005988, "chapter_id": 1117, "verse_number": "१-११८-३३", "content_sanskrit": "कदाचिदथ गाङ्गेयः सर्वनीतिमतां वरः।\nविदुरं धर्मतत्त्वज्ञं वाक्यमाह यथोचितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2005989, "chapter_id": 1117, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि अष्टादशाधिकशततमोऽध्यायः॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]