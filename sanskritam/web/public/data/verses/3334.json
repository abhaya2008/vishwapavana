[{"id": 2107978, "chapter_id": 3334, "verse_number": "", "content_sanskrit": "शौनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2107979, "chapter_id": 3334, "verse_number": "१", "content_sanskrit": "किमर्थं मुनिशार्दूल स राजा जनमेजयः ।\nसर्पसत्रेण सर्पाणां गमितोऽन्तं वदस्व मे \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2107980, "chapter_id": 3334, "verse_number": "२", "content_sanskrit": "आस्तीकश्च द्विजश्रेष्ठः किमर्थं जपतां वरः ।\nमोक्षयामास भुजगान् घोरात् तस्माद्धुताशनात् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2107981, "chapter_id": 3334, "verse_number": "३", "content_sanskrit": "कस्य पुत्रः स राजासीत्सर्पसत्रं य आहरत् ।\nस च द्विजातिप्रवरः कस्य पुत्रो वदस्व तम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2107982, "chapter_id": 3334, "verse_number": "४", "content_sanskrit": "श्रोतुमिच्छाम्यशेषेण कथामेतां मनोहराम् ।\nआस्तीकस्य पुराणस्य ब्राह्मणस्य तपस्विनः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2107983, "chapter_id": 3334, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2107984, "chapter_id": 3334, "verse_number": "५", "content_sanskrit": "महदाख्यानमास्तीकं यत्रैतत् प्रोच्यते बुधैः ।\nसर्वमेतदशेषेण शृणु मे वदतां वर \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2107985, "chapter_id": 3334, "verse_number": "समाप्तिः", "content_sanskrit": "इतिहासमिमं वृद्धाः पुराणं परिचक्षते ।\nकृष्णद्वैपायनप्रोक्तं नैमिशारण्यवासिषु \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2107986, "chapter_id": 3334, "verse_number": "७", "content_sanskrit": "पूर्वं प्रचोदितः सूतः पिता मे रोमहर्षणः ।\nशिष्यो व्यासस्य मेधावी ब्राह्मणेष्विदमुक्तवान्\t ॥ ७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2107987, "chapter_id": 3334, "verse_number": "८", "content_sanskrit": "तस्मादहमुपश्रुत्य प्रवक्ष्यामि यथातथम् ।\nइदमास्तीकमाख्यानं शुभं शौनक पृच्छते \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2107988, "chapter_id": 3334, "verse_number": "९", "content_sanskrit": "कथयिष्याम्यशेषेण सर्वपापप्रणाशनम् ।\nआस्तीकस्य पिता ह्यासीत् प्रजापतिसमः प्रभुः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2107989, "chapter_id": 3334, "verse_number": "१०", "content_sanskrit": "ब्रह्मचारी यताहारस्तपस्युग्रे रतः सदा ।\nजरत्कारुरिति ख्यात ऊर्ध्वरेता महानृषिः\t ॥ १०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2107990, "chapter_id": 3334, "verse_number": "११", "content_sanskrit": "यायावराणां विप्राणां धर्मज्ञः संशितव्रतः ।\nअटमानः कदाचित् स स्वान्ददर्श पितामहान् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2107991, "chapter_id": 3334, "verse_number": "१२", "content_sanskrit": "लम्बमानान् महागर्ते पादैरूर्ध्वैरवाङ्मुखान् ।\nतानब्रवीत् स दृष्ट्वैव जरत्कारुः पितामहान् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2107992, "chapter_id": 3334, "verse_number": "", "content_sanskrit": "जरत्कारुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2107993, "chapter_id": 3334, "verse_number": "१३", "content_sanskrit": "के वै भवन्तो लम्बन्ते गर्तेऽस्मिन् वै ह्यधोमुखाः ।\nकस्य वै पितरो यूयं परिभ्रष्टाः कुतो दिवः\t ॥ १३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2107994, "chapter_id": 3334, "verse_number": "१४", "content_sanskrit": "वीरणस्तम्बके लग्नाः सर्वतः परिभक्षिते ।\nमूषकेण निगूढेन गर्तेऽस्मिन् नित्यवासिना \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2107995, "chapter_id": 3334, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2107996, "chapter_id": 3334, "verse_number": "१५", "content_sanskrit": "यायावरा नाम वयं ऋषयः संशितव्रताः ।\nसन्तानप्रक्षयाद् ब्रह्मन् अधो गच्छाम सन्ततम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2107997, "chapter_id": 3334, "verse_number": "१६", "content_sanskrit": "अस्माकं सन्ततिस्त्वेको जरत्कारुरिति श्रुतः ।\nमन्दभाग्योऽल्पभाग्यानां तप एव समास्थितः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2107998, "chapter_id": 3334, "verse_number": "१७", "content_sanskrit": "न स पुत्रान् जनयितुं दारान् मूढश्चिकीर्षति ।\nतेन लम्बामहे गर्ते सन्तानप्रक्षयादिह\t ॥ १७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2107999, "chapter_id": 3334, "verse_number": "१८", "content_sanskrit": "अनाथास्तेन नाथेन यथा दुष्कृतिनस्तथा ।\nकस्त्वं बन्धुरिवास्माकमनुशोचसि सत्तम\t ॥ १८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108000, "chapter_id": 3334, "verse_number": "१९", "content_sanskrit": "ज्ञातुमिच्छामहे ब्रह्मन् को भवानिह तिष्ठति ।\nकिमर्थं चैव नः शोच्यान् अनुशोचितुमर्हति\t ॥ १९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108001, "chapter_id": 3334, "verse_number": "", "content_sanskrit": "जरत्कारुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108002, "chapter_id": 3334, "verse_number": "२०", "content_sanskrit": "मम पूर्वे भवन्तो वै पितरः सपितामहाः ।\nब्रूत किं करवाण्यद्य जरत्कारुरहं स्वयम्\t ॥ २०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108003, "chapter_id": 3334, "verse_number": "", "content_sanskrit": "पितरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108004, "chapter_id": 3334, "verse_number": "२१", "content_sanskrit": "यतस्व यत्नवांस्तात सन्तानाय कुलस्य नः ।\nआत्मनोऽर्थेऽस्मदर्थे च धर्म इत्येव वा विभो \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108005, "chapter_id": 3334, "verse_number": "२२", "content_sanskrit": "न हि धर्मफलैस्तात न तपोभिः सुसञ्चितैः ।\nतां गतिं प्राप्नुवन्तीह पुत्रिणो यां व्रजन्ति ह \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108006, "chapter_id": 3334, "verse_number": "२३", "content_sanskrit": "तद् दारग्रहणे यत्नं सन्तत्यर्थे मनः कुरु ।\nपुत्रक त्वां नियोक्ष्याम एतन्नः परमं हितम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108007, "chapter_id": 3334, "verse_number": "", "content_sanskrit": "जरत्कारुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108008, "chapter_id": 3334, "verse_number": "२४", "content_sanskrit": "न दारान् वै करिष्येऽहं इति मे भावितं मनः ।\nभवतां तु हितार्थाय करिष्ये दारसङ्ग्रहम्\t ॥ २४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108009, "chapter_id": 3334, "verse_number": "२५", "content_sanskrit": "समयेन च कर्ताऽहमनेन विधिपूर्वकम् ।\nयथावदुपलप्स्यामि करिष्ये नान्यथा त्वहम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108010, "chapter_id": 3334, "verse_number": "२६", "content_sanskrit": "सनाम्नी या भवित्री मे दित्सिता चैव बन्धुभिः ।\nभैक्षवत् तामहं कन्यामुपयंस्ये विधानतः\t ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2108011, "chapter_id": 3334, "verse_number": "२७", "content_sanskrit": "दरिद्राय च मे कन्यां को दास्यति विशेषतः ।\nप्रतिग्रहीष्ये भिक्षां तु यदि कश्चित् प्रदास्यति\t ॥ २७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2108012, "chapter_id": 3334, "verse_number": "२८", "content_sanskrit": "एवं दारक्रियाहेतोः प्रयतिष्ये पितामहाः ।\nअनेन विधिना शश्वत् करिष्ये नाहमन्यथा\t ॥ २८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2108013, "chapter_id": 3334, "verse_number": "२९", "content_sanskrit": "तत्रोत्पत्स्यति चेज्जन्तुर्भवतां तारणाय वै ।\nशाश्वतं स्थानमासाद्य मोदन्तु पितरो मम \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2108014, "chapter_id": 3334, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2108015, "chapter_id": 3334, "verse_number": "३०", "content_sanskrit": "ततो निवेशाय तदा स विप्रः संशितव्रतः ।\nमहीं चचार दारार्थी न च दारानविन्दत \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2108016, "chapter_id": 3334, "verse_number": "३१", "content_sanskrit": "स कदाचिद् वनं गत्वा विप्रः पितृवचः स्मरन् ।\nचुक्रोश कन्याभिक्षार्थी तिस्रो वाचः शनैः शनैः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2108017, "chapter_id": 3334, "verse_number": "३२", "content_sanskrit": "तां वासुकिः प्रत्यगृह्णाद् उद्यम्य भगिनीं तदा ।\nन च तां प्रतिजग्राह न सनाम्नीति चिन्तयन् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2108018, "chapter_id": 3334, "verse_number": "३३", "content_sanskrit": "सनाम्नीमुद्यतां भार्यां गृह्णीयामिति तस्य हि ।\nमनो निविष्टमभवज्जरत्कारोर्महात्मनः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2108019, "chapter_id": 3334, "verse_number": "३४", "content_sanskrit": "तमुवाच महाप्राज्ञो जरत्कारुर्महातपाः ।\nकिंनाम्नी भगिनीयं ते ब्रूहि सत्यं भुजङ्गम\t ॥ ३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2108020, "chapter_id": 3334, "verse_number": "", "content_sanskrit": "वासुकिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2108021, "chapter_id": 3334, "verse_number": "३५", "content_sanskrit": "जरत्कारो जरत्कारुः स्वसेयमनुजा मम ।\nप्रतिगृहीष्व भद्रं ते मया दत्तां सुमध्यमाम् \t ॥ ३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2108022, "chapter_id": 3334, "verse_number": "३६", "content_sanskrit": "त्वदर्थं रक्षिता पूर्वं प्रतीच्छेमां द्विजोत्तम ।\nएवमुक्त्वा ततः प्रादाद् भार्यार्थे वरवर्णिनीम्\t ॥ ३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2108023, "chapter_id": 3334, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2108024, "chapter_id": 3334, "verse_number": "३७", "content_sanskrit": "मात्रा हि भुजगाः शप्ताः पूर्वं ब्रह्मविदां वर ।\nजनमेजयस्य वो यज्ञे धक्ष्यत्यनिलसारथिः\t ॥ ३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2108025, "chapter_id": 3334, "verse_number": "३८", "content_sanskrit": "तस्य शापस्य शान्त्यर्थं प्रददौ पन्नगोत्तमः ।\nस्वसारमृषये तस्मै सुवृताय महात्मने \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2108026, "chapter_id": 3334, "verse_number": "३९", "content_sanskrit": "स च तां प्रतिजग्राह विधिदृष्टेन कर्मणा ।\nआस्तीको नाम पुत्रश्च तस्यां जज्ञे महामनाः\t ॥ ३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2108027, "chapter_id": 3334, "verse_number": "४०", "content_sanskrit": "तपस्वी च महात्मा च वेदवेदाङ्गपारगः ।\nसमः सर्वस्य लोकस्य पितृमातृभयापहः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2108028, "chapter_id": 3334, "verse_number": "४१", "content_sanskrit": "अथ कालस्य महतः पाण्डवेयो नराधिपः ।\nआजहार महायज्ञं सर्पसत्रमिति श्रुतम् \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2108029, "chapter_id": 3334, "verse_number": "४२", "content_sanskrit": "तस्मिन् प्रवृत्ते सत्रे तु सर्पाणामन्तकाय वै ।\nमोचयामास तं शापं आस्तीकः सुमहातपाः \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2108030, "chapter_id": 3334, "verse_number": "४३", "content_sanskrit": "नागांश्च मातुलांश्चापि तथा सम्बन्धिबान्धवान् ।\nपितॄंश्च तारयामास सन्तत्या तपसा तथा\t ॥ ४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2108031, "chapter_id": 3334, "verse_number": "४४", "content_sanskrit": "व्रतैश्च विविधैर्ब्रह्मन् स्वाध्यायैश्चानृणोऽभवत् ।\nदेवांश्च तर्पयामास यज्ञैर्विविधदक्षिणैः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2108032, "chapter_id": 3334, "verse_number": "४५", "content_sanskrit": "ऋषींश्च ब्रह्मचर्येण सन्तत्या च पितामहान् ।\nअपहृत्य गुरुं भारं पितॄणां संशितव्रतः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2108033, "chapter_id": 3334, "verse_number": "४६", "content_sanskrit": "जरत्कारुर्गतः स्वर्गं सहितः स्वैः पितामहैः ।\nआस्तीकं च सुतं प्राप्य धर्मं चानुत्तमं मुनिः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2108034, "chapter_id": 3334, "verse_number": "४७", "content_sanskrit": "जरत्कारुः सुमहता कालेन स्वर्गमेयिवान् ।\nएतदाख्यानमास्तीकं यथावत् कीर्तितं मया ।\nप्रब्रूहि भृगुशार्दूल किं भूयः कथ्यतामिति \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2108035, "chapter_id": 3334, "verse_number": "१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि त्रयोदशोऽध्यायः ॥१३॥ ॥ आस्तीकपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]