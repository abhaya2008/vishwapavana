[{"id": 2094419, "chapter_id": 3017, "verse_number": "१३-१४७-१", "content_sanskrit": "`पुराशर उवाच।\nक्षत्रा आरम्भयज्ञास्तु वीर्ययज्ञा विशः स्मृताः।\nशूद्रा परिचरायज्ञा जपयज्ञास्तु ब्राह्मणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094420, "chapter_id": 3017, "verse_number": "१३-१४७-२", "content_sanskrit": "शुश्रूषाजीविनः शूद्रा वैश्या विपणिजीविनः।\nअनिष्टनिग्रहः क्षत्रा विप्राः स्वाध्यायजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094421, "chapter_id": 3017, "verse_number": "१३-१४७-३", "content_sanskrit": "तपसा शोभते विप्रो राजन्यः पालनादिभिः।\nआतिथ्येन तथा वैश्यः शूद्रो दास्येन शोभते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094422, "chapter_id": 3017, "verse_number": "१३-१४७-४", "content_sanskrit": "यतात्मना तु शूद्रेण शुश्रूषा नित्यमेव च।\nकर्तव्या त्रिषु वर्णेषु प्रायेणाश्रमवासिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094423, "chapter_id": 3017, "verse_number": "१३-१४७-५", "content_sanskrit": "अशक्तेन त्रिवर्गस्य सेव्या ह्याश्रमवासिनः।\nयथाशक्यं यथाप्रज्ञं यथाधर्मं यथाश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094424, "chapter_id": 3017, "verse_number": "१३-१४७-६", "content_sanskrit": "विशेषेणैव कर्तव्या शुश्रूषा भिक्षुकाश्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094425, "chapter_id": 3017, "verse_number": "१३-१४७-७", "content_sanskrit": "आश्रमाणां तु सर्वेषां चतुर्णां भिक्षुकाश्रमम्।\nप्रधानमिति वर्ण्यन्ते शिष्टाः शास्त्रविनिश्चये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094426, "chapter_id": 3017, "verse_number": "१३-१४७-८", "content_sanskrit": "यच्चोपदिश्यते शिष्टैः श्रुतिस्मृतिविधानतः।\nतथाऽऽस्थेयमशक्तेन स धर्म इति निश्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094427, "chapter_id": 3017, "verse_number": "१३-१४७-९", "content_sanskrit": "अतोऽन्यथा तु कुर्वाणः श्रेयो नाप्नोति मानवः।\nतस्माद्भिक्षुषु शूद्रेण कार्यमात्महितं सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094428, "chapter_id": 3017, "verse_number": "१३-१४७-१०", "content_sanskrit": "इह यत्कुरुते श्रेयस्तत्प्रेत्य समुपाश्नुते।\nतच्चानसूयता कार्यं कर्तव्यं यद्धि मन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094429, "chapter_id": 3017, "verse_number": "१३-१४७-११", "content_sanskrit": "असूयता तु तस्येह फलं दुःखादवाप्यते।\nप्रियवादी जितक्रोधो वीततन्द्रीरमत्सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094430, "chapter_id": 3017, "verse_number": "१३-१४७-१२", "content_sanskrit": "क्षमावाञ्शीलसम्पन्नः सत्यधर्मपरायणः।\nआपद्भावेन कुर्याद्धि शुश्रूषां भिक्षुकाश्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094431, "chapter_id": 3017, "verse_number": "१३-१४७-१३", "content_sanskrit": "अयं मे परमो धर्मस्त्वनेनेदं सुदुष्करम्।\nसंसारसागरं घोरं तरिष्यामि न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094432, "chapter_id": 3017, "verse_number": "१३-१४७-१४", "content_sanskrit": "विभयो देहमुत्सृज्य यास्यामि परमां गतिम्।\nनातः परं ममाप्यन्य एष धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094433, "chapter_id": 3017, "verse_number": "१३-१४७-१५", "content_sanskrit": "एवं सञ्चिन्त्य मनसा शूद्रो बुद्धिसमाधिना।\nकुर्यादविमना नित्यं शुश्रूषाधर्ममुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094434, "chapter_id": 3017, "verse_number": "१३-१४७-१६", "content_sanskrit": "शुश्रूषानियमेनेह भाव्यं शिष्टाशिना सदा।\nशमान्वितेन दान्तेन कार्याकार्यविदा सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094435, "chapter_id": 3017, "verse_number": "१३-१४७-१७", "content_sanskrit": "सर्वकार्येषु कृत्यानि कृतान्येव तु दुर्शयेत्।\nयथा प्रियो भवेद्भिक्षुस्तथा कार्यं प्रसाधयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094436, "chapter_id": 3017, "verse_number": "१३-१४७-१८", "content_sanskrit": "यदकल्प्यं भवेद्भिक्षोर्न तत्कार्यं समाचरेत्।\nयथाऽऽश्रमस्याविरुद्धं धर्ममात्राभिसंहितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094437, "chapter_id": 3017, "verse_number": "१३-१४७-१९", "content_sanskrit": "तत्कार्यमविचारेण नित्यमेव शुभार्थिना।\nमनसा कर्ममा वाचा नित्यमेव प्रसादयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094438, "chapter_id": 3017, "verse_number": "१३-१४७-२०", "content_sanskrit": "स्थातव्यं तिष्ठमानेषु गच्छमानाननुव्रजेत्।\nआसीनेष्वासितव्यं च नित्यमेवानुवर्तता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094439, "chapter_id": 3017, "verse_number": "१३-१४७-२१", "content_sanskrit": "धर्मलब्धेन स्नेहेन पादौ सम्पीडयेत्सदा।\nउद्वर्तनादींश्च तथा कुर्यादप्रतिचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094440, "chapter_id": 3017, "verse_number": "१३-१४७-२२", "content_sanskrit": "नैजकार्याणि कृत्वा तु नित्यं चैवानुचोदितः।\nयथाविधिरुपस्पृश्य संन्यस्य जलभाजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094441, "chapter_id": 3017, "verse_number": "१३-१४७-२३", "content_sanskrit": "भिक्षूणां निलयं गत्वा प्रणम्य विधिपूर्वकम्।\nब्रह्मपूर्वान्गुरूंस्तत्र प्रणम्यि नियतेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094442, "chapter_id": 3017, "verse_number": "१३-१४७-२४", "content_sanskrit": "तथाऽऽचार्यपुरोगाणामनुकुर्यान्नमस्क्रियाम्।\nस्वधर्मचारिणां चापि सुखं पृष्ट्वाऽभिवाद्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094443, "chapter_id": 3017, "verse_number": "१३-१४७-२५", "content_sanskrit": "यो भवेत्पूर्वसंसिद्धस्तुल्यकर्मा भवेत्सदा।\nतस्मै प्रणामः कर्तव्यो नेतरेषु कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094444, "chapter_id": 3017, "verse_number": "१३-१४७-२६", "content_sanskrit": "अनुक्त्वा तेषु चोत्थाय नित्यमेव यतव्रतः।\nसम्मार्जनमथो गत्वा कृत्वा चाप्युपलेपनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094445, "chapter_id": 3017, "verse_number": "१३-१४७-२७", "content_sanskrit": "ततः पुष्पबलिं दद्यापुष्पाण्यादाय धर्मतः।\nनिष्क्रम्यावसथात्तूर्णमन्यत्कर्म समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094446, "chapter_id": 3017, "verse_number": "१३-१४७-२८", "content_sanskrit": "यथोपघातो न भवेत्स्वाध्यायेऽऽश्रमिणां तथा।\nउपघातं तु कुर्वाण एनसा सम्प्रयुज्यते।\nतथाऽऽत्मा प्रणिधातव्यो यथा ते प्रीतिमाप्नुयुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094447, "chapter_id": 3017, "verse_number": "१३-१४७-२९", "content_sanskrit": "परिचारकोऽहं वर्णानां त्रयाणां धर्मतः स्मृतः।\nकिमुताश्रमवृद्धानां यथालब्धोपजीविनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094448, "chapter_id": 3017, "verse_number": "१३-१४७-३०", "content_sanskrit": "भिक्षूणां गतरागाणां केवलं ज्ञानदर्शिनम्।\nविशेषेण मया कार्या शुश्रूषा नियतात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094449, "chapter_id": 3017, "verse_number": "१३-१४७-३१", "content_sanskrit": "तेषां प्रसादात्तपसा प्राप्स्यामीष्टां शुभां गतिम्।\nएवमेतद्विनिश्चित्य यदि सेवेत भिक्षुकान्।\nविधिना स्वोपदिष्टेन प्राप्नोति परमां गतिम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2094450, "chapter_id": 3017, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तचत्वारिंशदधिकशततमोऽध्यायः॥ १४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]