[{"id": 2015985, "chapter_id": 1336, "verse_number": "२-७७-१", "content_sanskrit": "जनमेजय उवाच॥\nकथं समभवद्द्यूतं भ्रातॄणां तन्महात्ययम्।\nयत्र तद्व्यसनं प्राप्तं पाण्डवैर्मे पितामहैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015986, "chapter_id": 1336, "verse_number": "२-७७-२", "content_sanskrit": "के च तत्र समास्तारा राजानो ब्रह्मवित्तम।\nके चैनमन्वमोदन्त के चैनं प्रत्यषेधयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015987, "chapter_id": 1336, "verse_number": "२-७७-३", "content_sanskrit": "विस्तरेणैतदिच्छामि कथ्यमानं त्वया द्विज।\nमूलं ह्येतद्विनाशस्य पृथिव्या द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015988, "chapter_id": 1336, "verse_number": "२-७७-४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015989, "chapter_id": 1336, "verse_number": "२-७७-४", "content_sanskrit": "एवमुक्तस्ततो राज्ञा व्यासशिष्यः प्रतापवान्।\nआचचक्षेऽथ यद्वृत्तं तत्सर्वं वेदतत्त्वविद्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015990, "chapter_id": 1336, "verse_number": "२-७७-५x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015991, "chapter_id": 1336, "verse_number": "२-७७-५", "content_sanskrit": "एवमुक्तस्ततो राज्ञा व्यासशिष्यः प्रतापवान्।\nआचचक्षेऽथ यद्वृत्तं तत्सर्वं वेदतत्त्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015992, "chapter_id": 1336, "verse_number": "२-७७-६", "content_sanskrit": "विदुरस्य मतिं ज्ञात्वा धृतराष्ट्रोऽम्बिकासुतः।\nदुर्योधनमिदं वाक्यमुवाच विजने पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015993, "chapter_id": 1336, "verse_number": "२-७७-७", "content_sanskrit": "अलं द्यूतेन गान्धारे विदुरो न प्रशंसति।\nन ह्यसौ सुमहाबुद्धिरहितं नो वदिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015994, "chapter_id": 1336, "verse_number": "२-७७-८", "content_sanskrit": "हितं हि परमं मन्ये विदुरो यत्प्रभाषते।\nक्रियतां पुत्र तत्सर्वमेतन्मन्ये हितं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015995, "chapter_id": 1336, "verse_number": "२-७७-९", "content_sanskrit": "देवर्षिर्वासवागुरुर्देवराजाय धीमते।\nयत्प्राह शास्त्रं भगवान्बृहस्पतिरुदारधीः।\nतद्दे विदुरः सर्वं सरहस्यं महाकविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015996, "chapter_id": 1336, "verse_number": "२-७७-१०", "content_sanskrit": "स्थितस्तु वचने तस्य सदाऽहमपि पुत्रक।\nविदुरो वापि मेधावी कुरूणां प्रवरो मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015997, "chapter_id": 1336, "verse_number": "२-७७-११", "content_sanskrit": "उद्धवो वा महाबुद्धिर्वृष्णीनामर्चितो नृप।\nतदलं पुत्र द्यूतेन द्यूते भेदो हि दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015998, "chapter_id": 1336, "verse_number": "२-७७-१२", "content_sanskrit": "भेदे विनाशो राज्यस्य तत्पुत्र परिवर्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015999, "chapter_id": 1336, "verse_number": "२-७७-१३", "content_sanskrit": "पित्रा मात्रा च पुत्रस्य यद्वै कार्यं परं स्मृतम्।\nप्राप्तस्त्वमसि तन्नाम पितृपैतामहं पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2016000, "chapter_id": 1336, "verse_number": "२-७७-१४", "content_sanskrit": "अधीतवान्कृती शास्त्रे लालितः सततं गृहे।\nभ्रातृज्येष्ठः स्थितो राज्ये विन्दसरे किं न शोभनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2016001, "chapter_id": 1336, "verse_number": "२-७७-१५", "content_sanskrit": "पृथग्जनैरलभ्यं यद्भोजनाच्छादनं परम्।\nतत्प्राप्तोसि महाबाहो कस्माच्छोनसि पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2016002, "chapter_id": 1336, "verse_number": "२-७७-१६", "content_sanskrit": "स्फीतं राष्ट्रं महाबाहो पितृपैतामहं महत्।\nनित्यमाज्ञापयन्भासि दिवि देवेश्वरो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2016003, "chapter_id": 1336, "verse_number": "२-७७-१७", "content_sanskrit": "यादृशं च तवैश्वर्यं तदन्येषां सुदुर्लभम्।\nये चोपभोगास्ते राजन्मया ते परिकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2016004, "chapter_id": 1336, "verse_number": "२-७७-१८", "content_sanskrit": "तस्य ते विदितप्रज्ञ शोकमूलमिदं कथम्।\nसमुत्थितं दुःखकरं तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2016005, "chapter_id": 1336, "verse_number": "२-७७-१९x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2016006, "chapter_id": 1336, "verse_number": "२-७७-१९", "content_sanskrit": "अश्नाम्याच्छादयामीति प्रपश्यन्हीनपौरुषः।\nनामर्षं कुरुते यस्तु पुरुषः सोऽधमः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2016007, "chapter_id": 1336, "verse_number": "२-७७-२०", "content_sanskrit": "न मां प्रीणाति राजेन्द्र लक्ष्मीः साधारणी विभो।\nज्वलितामेव कौन्येये श्रियं दृष्ट्वा च विव्यथे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2016008, "chapter_id": 1336, "verse_number": "२-७७-२१", "content_sanskrit": "सर्वां च पृथिवीं चैव युधिष्ठिरवशानुगाम्।\nस्थिरोऽस्मि योऽहं जीवामि दुःखादेतद्ब्रवीमि ते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2016009, "chapter_id": 1336, "verse_number": "२-७७-२२", "content_sanskrit": "आवर्जिता इवाभान्ति नीपाश्चित्रककौकुराः।\nकारस्कारा लोहजङ्घा युधिष्ठिरनिवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2016010, "chapter_id": 1336, "verse_number": "२-७७-२३", "content_sanskrit": "हिमवत्सागरानुपाः सर्वे रत्नाकरास्तथा।\nअन्त्याः सर्वे पर्युदस्ता युधिष्ठिरनिवेशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2016011, "chapter_id": 1336, "verse_number": "२-७७-२४", "content_sanskrit": "ज्येष्ठोऽयमिति मां मत्वा श्रेष्ठश्चेति विशाम्पते।\nयुधिष्ठिरेण सत्कृत्य युक्तो रत्नपरिग्रहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2016012, "chapter_id": 1336, "verse_number": "२-७७-२५", "content_sanskrit": "उपस्थितानां रत्नानां श्रेष्ठानामर्घहारिणाम्।\nनादृश्यत परः पारो नापरस्तत्र भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2016013, "chapter_id": 1336, "verse_number": "२-७७-२६", "content_sanskrit": "न मे हस्तः समभवद्वसु तत्प्रतिगृह्णतः।\nअतिष्ठन्त मयि श्रान्ते गृग्य दूराहृतं वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2016014, "chapter_id": 1336, "verse_number": "२-७७-२७", "content_sanskrit": "कृतां बिन्दुसरोरत्नैर्मयेन स्फाटिकच्छदाम्।\nअपश्यं नलिनीं पूर्णामुदकस्येव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2016015, "chapter_id": 1336, "verse_number": "२-७७-२८", "content_sanskrit": "वस्त्रमुत्कर्षति मयि प्राहसत्स वृकोदरः।\nशत्रोर्ऋद्धिविशेषेण विमूढ रत्तवर्जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2016016, "chapter_id": 1336, "verse_number": "२-७७-२९", "content_sanskrit": "तत्र स्म यदि शक्तः स्यं पातयेऽहं वृकोदरम्।\nयदि कुर्यां समारम्भं भीमं हन्तुं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2016017, "chapter_id": 1336, "verse_number": "२-७७-३०", "content_sanskrit": "शिशुपाल इवास्माकं गतिः स्यान्नात्र संशयः।\nसपत्नेनावहासो मे स मां दहति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2016018, "chapter_id": 1336, "verse_number": "२-७७-३१", "content_sanskrit": "पुनश्च तादृशीमेव वापीं जलजशालिनीम्।\nमत्वा शिलासमां तोये पतितोऽस्मि नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2016019, "chapter_id": 1336, "verse_number": "२-७७-३२", "content_sanskrit": "तत्र मां प्राहसत्कृष्णः पार्थेन सह सुस्वरम्।\nद्रौपदी च सह स्त्रीभिर्व्यथयन्ती मनो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2016020, "chapter_id": 1336, "verse_number": "२-७७-३३", "content_sanskrit": "क्लिन्नवस्त्रस्य तु जले किङ्करा राजनोदिताः।\nददुर्वासांसि मेऽन्यानि तच्च दुःखं परं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2016021, "chapter_id": 1336, "verse_number": "२-७७-३४", "content_sanskrit": "प्रलम्भं च शृणुष्वान्यद्वदतो मे नराधिप।\nअद्वारेण विनिर्गच्छन्द्वारसंस्थानरूपिणा।\nअभिहत्य शिलां भूयो ललाटेनास्मि विक्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2016022, "chapter_id": 1336, "verse_number": "२-७७-३५", "content_sanskrit": "तत्र मां यमजौ दूरादालोक्याभिहतं तदा।\nबाहुभिः परिगृह्णीतां शोचन्तौ सहितावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2016023, "chapter_id": 1336, "verse_number": "२-७७-३६", "content_sanskrit": "उवाच सहदेवस्तु तत्र मां विस्मयन्निव।\nइद द्वारं धार्तराष्ट्र मा गच्छेति पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2016024, "chapter_id": 1336, "verse_number": "२-७७-३७", "content_sanskrit": "भीमसेनेन तत्रोक्तो धृतराष्ट्रात्मजेति च।\nसम्बोध्य प्रहसित्वा च इतो द्वारं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2016025, "chapter_id": 1336, "verse_number": "२-७७-३८", "content_sanskrit": "नामधेयानि रत्नानां पुरस्तान्न श्रुतानि मे।\nयानि दृष्टानि मे तस्यां मनस्तपति तच्च मे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2016026, "chapter_id": 1336, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि सप्तसप्ततितमोऽध्यायः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]