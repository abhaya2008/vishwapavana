[{"id": 2107770, "chapter_id": 3325, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2107771, "chapter_id": 3325, "verse_number": "१", "content_sanskrit": "रोमहर्षणपुत्र उग्रश्रवाः सूतः पौराणिको नैमिशारण्ये शौनकस्य कुलपतेः सत्रे वर्तमाने ऋषीनभ्यागतानुपतस्थे \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2107772, "chapter_id": 3325, "verse_number": "२", "content_sanskrit": "पौराणिकः पुराणे कृतश्रमः स तान् कृताञ्जलिरुवाच \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2107773, "chapter_id": 3325, "verse_number": "३", "content_sanskrit": "मयोदङ्कस्य चरितमशेषमुक्तं जनमेजयस्य सर्पसत्रान्तरमिद-मस्ति किं भवन्तः श्रोतुमिच्छन्तीति । किमहं ब्रुवाणि ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2107774, "chapter_id": 3325, "verse_number": "४", "content_sanskrit": "तमृषय ऊचुः । परं रोमहर्षणे प्रवक्ष्यामस्त्वां त्वं वक्ष्यसि प्रति वचः शुश्रूषतां कथायोगं नः कथायोगे भगवांश्च तावच्छौनकोऽ- ग्निशरण एवास्ते \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2107775, "chapter_id": 3325, "verse_number": "५", "content_sanskrit": "योऽसौ दिव्याः कथा वेद देवतासुरसम्भवाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2107776, "chapter_id": 3325, "verse_number": "६", "content_sanskrit": "मानुषीः देवगान्धर्वीः कथा वेद च सर्वशः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2107777, "chapter_id": 3325, "verse_number": "७", "content_sanskrit": "स चाप्यस्मिन्मखे सौते विद्वान्कुलपतिर्द्विजः । दक्षो धृतव्रतो धीमान् शास्त्रे चारण्यके गुरुः । सत्यवादी शमपरस्तपस्वी नियतव्रतः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2107778, "chapter_id": 3325, "verse_number": "८", "content_sanskrit": "सर्वेषामेव नो मान्यः स तावत्प्रतिपाल्यताम् । तस्मिन्न- ध्यासति गुरावासनं परमार्चितम् । ततो वक्ष्यसि यत्त्वां स पृच्छति द्विजसत्तमः \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2107779, "chapter_id": 3325, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2107780, "chapter_id": 3325, "verse_number": "९", "content_sanskrit": "एवमस्मि गुरौ तस्मिन्नुपविष्टे महात्मनि ।\nतेन पृष्टाः कथाः पुण्या वक्ष्यामि विविधाश्रयाः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2107781, "chapter_id": 3325, "verse_number": "१०", "content_sanskrit": "सोऽथ विप्रर्षभः कृत्वा कार्यं सर्वं यथाक्रमम् ।\nदेवान्वाग्भिः पितॄनद्भिस्तर्पयित्वाऽऽजगाम ह \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2107782, "chapter_id": 3325, "verse_number": "११", "content_sanskrit": "यत्र ब्रह्मर्षयः सिद्धास्त आसीरन् यतव्रताः ।\nयज्ञायतनमाश्रित्य सूतपुत्रपुरस्सराः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2107783, "chapter_id": 3325, "verse_number": "१२", "content_sanskrit": "ऋत्विक्षु च सदस्येषु स वै गृहपतिस्ततः ।\nउपविष्टेषूपविष्टः शौनकोऽथाब्रवीदिदम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2107784, "chapter_id": 3325, "verse_number": "४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आदिपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2107785, "chapter_id": 3325, "verse_number": "", "content_sanskrit": "॥ पौलोमपर्वणि प्रथमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]