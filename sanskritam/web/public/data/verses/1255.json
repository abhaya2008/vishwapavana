[{"id": 2012465, "chapter_id": 1255, "verse_number": "१-२५६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012466, "chapter_id": 1255, "verse_number": "१-२५६-१", "content_sanskrit": "ततः प्रज्वलिते वह्नौ शार्ङ्गकास्ते सुदुःखिताः।\nव्यथिताः परमोद्विग्ना नाधिजग्मुः परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012467, "chapter_id": 1255, "verse_number": "१-२५६-२", "content_sanskrit": "निशाम्य पुत्रकान्बालान्माता तेषां तपस्विनी।\nजरिता शोकदुःखार्ता विललाप सुदुःखिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012468, "chapter_id": 1255, "verse_number": "१-२५६-३x", "content_sanskrit": "जरितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012469, "chapter_id": 1255, "verse_number": "१-२५६-३", "content_sanskrit": "अयमग्निर्दहन्कक्षमित आयाति भीषणः।\nजगत्संदीपयन्भीमो मम दुःखविवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012470, "chapter_id": 1255, "verse_number": "१-२५६-४", "content_sanskrit": "इमे च मां कर्षयन्ति शिशवो मन्दचेतसः।\nअबर्हाश्चरणैर्हीनाः पूर्वेषां नः परायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012471, "chapter_id": 1255, "verse_number": "१-२५६-५", "content_sanskrit": "त्रासयंश्चायमायाति लेलिहानो महीरुहान्।\nअजातपक्षाश्च सुता न शक्ताः सरणे मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012472, "chapter_id": 1255, "verse_number": "१-२५६-६", "content_sanskrit": "आदाय च न शक्नोमि पुत्रांस्तरितुमात्मना।\nन च त्यक्तुमहं शक्ता हृदयं दूयतीव मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012473, "chapter_id": 1255, "verse_number": "१-२५६-७", "content_sanskrit": "कं तु जह्यामहं पुत्रं कमादाय व्रजाम्यहम्।\nकिंनु मे स्यात्कृतं कृत्वा मन्यध्वं पुत्रकाः कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012474, "chapter_id": 1255, "verse_number": "१-२५६-८", "content_sanskrit": "चिन्तयाना विमोक्षं वो नाधिगच्छामि किंचन।\nछादयिष्यामि वो गात्रैः करिष्ये मरणं सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012475, "chapter_id": 1255, "verse_number": "१-२५६-९", "content_sanskrit": "जरितारौ कुलं ह्येतज्ज्येष्ठत्वेन प्रतिष्ठितम्।\nसारिसृक्कः प्रजायेत पितॄणां कुलवर्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012476, "chapter_id": 1255, "verse_number": "१-२५६-१०", "content_sanskrit": "स्तम्बमित्रस्तपः कुर्याद्द्रोणो ब्रह्मविदां वरः।\nइत्येवमुक्त्वा प्रययौ पिता वो निर्घृणः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012477, "chapter_id": 1255, "verse_number": "१-२५६-११", "content_sanskrit": "कमुपादाय शक्येयं गन्तुं कष्टाऽऽपदुत्तमा।\nकिं नु कृत्वा कृतं कार्यं भवेदिति च विह्वला।\nनापश्यत्स्वधिया मोक्षं स्वसुतानां तदानलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012478, "chapter_id": 1255, "verse_number": "१-२५६-१२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012479, "chapter_id": 1255, "verse_number": "१-२५६-१२", "content_sanskrit": "एवं ब्रुवाणां शार्ङ्गास्ते प्रत्यूचुरथ मातरम्।\nस्नेहमुत्सृज्य मातस्त्वं पत यत्र न हव्यवाट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012480, "chapter_id": 1255, "verse_number": "१-२५६-१३", "content_sanskrit": "अस्मास्विह विनष्टेषु भवितारः सुतास्तव।\nत्वयि मातर्विनष्टायां न नः स्यात्कुलसन्ततिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012481, "chapter_id": 1255, "verse_number": "१-२५६-१४", "content_sanskrit": "अन्ववेक्ष्यैतदुभयं क्षेमं स्याद्यत्कुलस्य नः।\nतद्वै कर्तुं परः कालो मातरेष भवेत्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012482, "chapter_id": 1255, "verse_number": "१-२५६-१५", "content_sanskrit": "मा त्वं सर्वविनाशाय स्नेहं कार्षीः सुतेषु नः।\nन हीदं कर्म मोघं स्याल्लोककामस्य नः पितुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012483, "chapter_id": 1255, "verse_number": "१-२५६-१६x", "content_sanskrit": "जरितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012484, "chapter_id": 1255, "verse_number": "१-२५६-१६", "content_sanskrit": "इदमाखोर्बिलं भूमौ वृक्षस्यास्य समीपतः।\nतदाविशध्वं त्वरिता वह्नेरत्र न वो भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012485, "chapter_id": 1255, "verse_number": "१-२५६-१७", "content_sanskrit": "ततोऽहं पांसुना छिद्रमपिधास्यामि पुत्रकाः।\nएवं प्रतिकृतं मन्ये ज्वलतः कृष्णवर्त्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012486, "chapter_id": 1255, "verse_number": "१-२५६-१८", "content_sanskrit": "तत एष्याम्यतीतेऽग्नौ विहन्तुं पांसुशंचयम्।\nरोचतामेष वो वादो मोक्षार्थं च हुताशनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012487, "chapter_id": 1255, "verse_number": "१-२५६-१९x", "content_sanskrit": "शार्ङ्गका ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012488, "chapter_id": 1255, "verse_number": "१-२५६-१९", "content_sanskrit": "अबर्हान्मांसभूतान्नः क्रव्यादाखुर्विनाशयेत्।\nपश्यमाना भयमिदं प्रवेष्टुं नात्र शक्नुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012489, "chapter_id": 1255, "verse_number": "१-२५६-२०", "content_sanskrit": "कथमग्निर्न नो धक्ष्येत्कथमाखुर्न नाशयेत्।\nकथं न स्यात्पिता मोघः कथं माता ध्रियेत नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012490, "chapter_id": 1255, "verse_number": "१-२५६-२१", "content_sanskrit": "बिल आखोर्विनाशः स्यादग्नेराकाशचारिणाम्।\nअन्ववेक्ष्यैतदुभयं श्रेयान्दाहो न भक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012491, "chapter_id": 1255, "verse_number": "१-२५६-२२", "content_sanskrit": "गर्हितं मरणं नः स्यादाखुना भक्षिते बिले।\nशिष्टादिष्टः परित्यागः शरीरस्य हुताशनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012492, "chapter_id": 1255, "verse_number": "१-२५६-२३", "content_sanskrit": "अग्निदाहे तु नियतं ब्रह्मलोके ध्रुवा गतिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012493, "chapter_id": 1255, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि मयदर्शनपर्वणि षट्पञ्चाशदधिकद्विशततमोऽध्यायः॥ २५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]