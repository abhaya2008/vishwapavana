[{"id": 2014044, "chapter_id": 1290, "verse_number": "२-३१-१", "content_sanskrit": "वैशम्पायन उवाच।\nततः कुमारविषये श्रेणिमन्तमथाजयत्।\nकोसलाधिपतिं चैव बृहद्बलमरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014045, "chapter_id": 1290, "verse_number": "२-३१-२", "content_sanskrit": "अयोध्यायां तु धर्मज्ञं दीर्घयज्ञं महाबलम्।\nअजयत्णण्डवश्रेष्ठो नातितीव्रेण कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014046, "chapter_id": 1290, "verse_number": "२-३१-३", "content_sanskrit": "ततो गोपालकक्षं च सोत्तरानपि कोसलान्।\nमल्लानामधिपं चैव पार्थिवं चाजयत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014047, "chapter_id": 1290, "verse_number": "२-३१-४", "content_sanskrit": "ततो हिमवतः पार्श्वं समभ्येत्य जलोद्भवम्।\nसर्वमल्पेन कालेन देशं चक्रे वशं बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014048, "chapter_id": 1290, "verse_number": "२-३१-५", "content_sanskrit": "एवं बहुविधान्देशान्विजिग्ये भरतर्षभः।\nभल्लाटमभितो जिग्ये शुक्तिमन्तं च पर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014049, "chapter_id": 1290, "verse_number": "२-३१-६", "content_sanskrit": "पाण्डवः सुमहावीर्यो बलेन बलिनां वरः।\nस काशिराजं समरे सुबाहुमनिवर्तिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014050, "chapter_id": 1290, "verse_number": "२-३१-७", "content_sanskrit": "वशे चक्रे महाबाहुर्भीमो भीमपराक्रमः।\nततः सुपार्श्वमभितस्तथा राजपतिं क्रथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014051, "chapter_id": 1290, "verse_number": "२-३१-८", "content_sanskrit": "युध्यमानं बालत्सङ्ख्ये विजिग्ये पाण्डवर्षभः।\nततो मत्स्यान्महातेजा मलदांश्च महाबलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014052, "chapter_id": 1290, "verse_number": "२-३१-९", "content_sanskrit": "अनघानभयांश्चैव पशुभूमिं च सर्वशः।\nनिवृत्य च महाबाहुर्मदधारं महीधरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014053, "chapter_id": 1290, "verse_number": "२-३१-१०", "content_sanskrit": "सोमधेयांश्च निर्जित्य प्रत्ययावुत्तरामुखः।\nवत्सभूमिं च कौन्तेयो विजिग्ये बलवान्बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014054, "chapter_id": 1290, "verse_number": "२-३१-११", "content_sanskrit": "भर्गाणामधिपं चैव निषादाधिपतिं तथा।\nविजिग्ये भूमिपालांश्च ममिमत्प्रमुखान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014055, "chapter_id": 1290, "verse_number": "२-३१-१२", "content_sanskrit": "ततो दक्षिणमल्लांश्च भोगवन्तं च पर्वतम्।\nतरसैवाजयद्भीमो नातितीव्रेण कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014056, "chapter_id": 1290, "verse_number": "२-३१-१३", "content_sanskrit": "शर्मकान्वर्मकांश्चैव व्यजयत्सान्त्वपूर्वकम्।\nवैदेहकं च राजानं जनकं जगतीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014057, "chapter_id": 1290, "verse_number": "२-३१-१४", "content_sanskrit": "विजिग्ये पुरुषव्याघ्रो नातितीव्रेण कर्मणा।\nशकांश्च बर्बराश्चैव अजयच्छद्मपूर्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014058, "chapter_id": 1290, "verse_number": "२-३१-१५", "content_sanskrit": "वैदेहस्थस्तु कौन्तेय इन्द्रपर्वतमन्तिकात्।\nकिरातानामधिपतीनजयत्सप्त पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014059, "chapter_id": 1290, "verse_number": "२-३१-१६", "content_sanskrit": "ततः सुह्यान्प्रसुह्यांश्च सपक्षानतिवीर्यवान्।\nविजित्य युधि कौन्तेयो मागधानभ्यधाद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014060, "chapter_id": 1290, "verse_number": "२-३१-१७", "content_sanskrit": "दण्डं च दण्डधारं च विजित्य पृथिवीपतीन्।\nतैरेव सहितैः सर्वैर्गिरिव्रजमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014061, "chapter_id": 1290, "verse_number": "२-३१-१८", "content_sanskrit": "जारासन्धिं सान्त्वयित्वा करे च विनिवेश्य ह।\nतैरेव सहितैः सर्वैः कर्णमब्यद्रवद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014062, "chapter_id": 1290, "verse_number": "२-३१-१९", "content_sanskrit": "स कम्पयन्निव महीं बलेन चतुङ्गिणा।\nयुयुधे पाण्डवश्रेष्ठः कर्णेनामित्रघातिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014063, "chapter_id": 1290, "verse_number": "२-३१-२०", "content_sanskrit": "स कर्णं युधि निर्जित्य वशे कृत्वा च भारत।\nततो विजिग्ये बलवान्राज्ञः पर्वतवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014064, "chapter_id": 1290, "verse_number": "२-३१-२१", "content_sanskrit": "अथ मोदागिरौ चैव राजानं बलवत्तरम्।\nपाण्डवो बाहुवीर्येण निजघान महामृधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2014065, "chapter_id": 1290, "verse_number": "२-३१-२२", "content_sanskrit": "ततः पुण्ड्राधिपं वीरं वासुदेवं समाययौ।\nइदानीं वृष्णिवीरेण न योत्स्यामीति पौण्ड्रकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2014066, "chapter_id": 1290, "verse_number": "२-३१-२३", "content_sanskrit": "कृष्णस्य भुजसंत्रासात्करमाशु ददौ नृपः।\nकौशिकीकच्छनिलयं राजानं च महौजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2014067, "chapter_id": 1290, "verse_number": "२-३१-२४", "content_sanskrit": "उभौ बलभृतौ वीरावुमौ तीव्रपराक्रमौ।\nनिर्जित्याजौ महाराज वङ्गराजमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2014068, "chapter_id": 1290, "verse_number": "२-३१-२५", "content_sanskrit": "समुद्रसेन निर्जित्य चन्द्रसेनं च पार्थिवम्।\nताम्रलिप्तं च राजानं कर्वटाधिपतिं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2014069, "chapter_id": 1290, "verse_number": "२-३१-२६", "content_sanskrit": "सुह्यानामधिपं चैव ये च सागरवासिनः।\nसर्वान्म्लेच्छगणांश्चैव विजिग्ये भरतर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2014070, "chapter_id": 1290, "verse_number": "२-३१-२७", "content_sanskrit": "एवं बहुविधान्देशान्विजित्य पवनात्मजः।\nवसु तेभ्य उपादाय लौहित्यमगद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2014071, "chapter_id": 1290, "verse_number": "२-३१-२८", "content_sanskrit": "स सर्वान्म्लेच्छनृपतीन्सागरानूपवासिनः।\nकरमाहारयामास रत्नानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2014072, "chapter_id": 1290, "verse_number": "२-३१-२९", "content_sanskrit": "चन्दनागुरुवस्त्राणि मणिमौक्तिककम्बलम्।\nकाञ्चनं रजतं चैव विद्रुमं च महाधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2014073, "chapter_id": 1290, "verse_number": "२-३१-३०", "content_sanskrit": "ते कोटीशतसङ्ख्येन कौन्तेयं महता तदा।\nअभ्यवर्षन्महात्मानं धनवर्षेण पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2014074, "chapter_id": 1290, "verse_number": "२-३१-३१", "content_sanskrit": "इन्द्रप्रस्थमुपागम्य भीमो भीमपराक्रमः।\nनिवेदयामास तदा धर्मराजाय तद्धनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2014075, "chapter_id": 1290, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि दिग्विजयपर्वणि एकत्रिंशोऽध्यायः॥ ३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]