[{"id": 5000188000, "chapter_id": 9188, "verse_number": "२-१११-१", "content_sanskrit": "वसिष्ठस्तु तदा राममुक्त्वा राजपुरोऺहित: ।\nअब्रवीद्धर्मसंयुक्तं पुनरेवापरं वच: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000188001, "chapter_id": 9188, "verse_number": "२-१११-२", "content_sanskrit": "पुरुषस्येह जातस्य भवन्ति गुरवस्त्रय: ।\nआचार्य्यश्चैव काकुत्स्थ पिता माता च राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000188002, "chapter_id": 9188, "verse_number": "२-१११-३", "content_sanskrit": "पिता ह्येनं जनयति पुरुषं पुरुषर्षभ ।\nप्रज्ञां ददाति चाचार्यस्तस्मात्स गुरुरुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000188003, "chapter_id": 9188, "verse_number": "२-१११-४", "content_sanskrit": "सो ऽहं ते पितुराचार्य्यस्तव चैव परन्तप ।\nमम त्वं वचनं कुर्वन् नातिवर्त्ते: सताङ्गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000188004, "chapter_id": 9188, "verse_number": "२-१११-५", "content_sanskrit": "इमा हि ते परिषद: श्रेणयश्च द्विजास्तथा ।\nएषु तात चरन् धर्मं नातिवर्त्ते: सताङ्गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000188005, "chapter_id": 9188, "verse_number": "२-१११-६", "content_sanskrit": "वृद्धाया धर्मशीलाया मातुर्नार्हस्यवर्त्तितुम् ।\nअस्यास्तु वचनं कुर्वन् नातिवर्त्ते: सताङ्गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000188006, "chapter_id": 9188, "verse_number": "२-१११-७", "content_sanskrit": "भरतस्य वच: कुर्वन् याचमानस्य राघव ।\nआत्मानं नातिवर्त्तेस्त्वं सत्यधर्मपराक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000188007, "chapter_id": 9188, "verse_number": "२-१११-८", "content_sanskrit": "एवं मधुरमुक्तस्तु गुरुणा राघव: स्वयम् ।\nप्रत्युवाच समासीनं वसिष्ठं पुरुषर्षभ: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000188008, "chapter_id": 9188, "verse_number": "२-१११-९", "content_sanskrit": "यन्मातापितरौ वृत्तं तनये कुरुत: सदा ।\nन सुप्रतिकरं तत्तु मात्रा पित्रा च यत्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000188009, "chapter_id": 9188, "verse_number": "२-१११-१०", "content_sanskrit": "यथाशक्ति प्रदानेन स्नापनोच्छादनेन च ।\nनित्यं च प्रियवादेन तथा संवर्द्धनेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000188010, "chapter_id": 9188, "verse_number": "२-१११-११", "content_sanskrit": "स हि राजा जनयिता पिता दशरथो मम ।\nआज्ञातं यन्मया तस्य न तन्मिथ्या भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000188011, "chapter_id": 9188, "verse_number": "२-१११-१२", "content_sanskrit": "एवमुक्तस्तु रामेण भरत: प्रत्यनन्तरम् ।\nउवाच परमोदार: सूतं परमदुर्मना: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000188012, "chapter_id": 9188, "verse_number": "२-१११-१३", "content_sanskrit": "इह मे स्थण्डिले शीघ्रं कुशानास्तर सारथे ।\nआर्य्यं प्रत्युपवेक्ष्यामि यावन्मे न प्रसीदति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000188013, "chapter_id": 9188, "verse_number": "२-१११-१४", "content_sanskrit": "अनाहारो निरालोको धनहीनो यथा द्विज: ।\nशेष्ये पुरस्तात् शालाया यावन्न प्रतियास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000188014, "chapter_id": 9188, "verse_number": "२-१११-१५", "content_sanskrit": "स तु राममवेक्षन्तं सुमन्त्रं प्रेक्ष्य दुर्मना: ।\nकुशोत्तरमुपस्थाप्य भूमावेवास्तरत् स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000188015, "chapter_id": 9188, "verse_number": "२-१११-१६", "content_sanskrit": "तमुवाच महातेजा रामो राजर्षिसत्तम: ।\nकिं मां भरत कुर्वाणं तात प्रत्युपवेक्ष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000188016, "chapter_id": 9188, "verse_number": "२-१११-१७", "content_sanskrit": "ब्राह्मणो ह्येकपार्श्वेन नरान् रोद्धुमिहार्हति ।\nन तु मूर्द्धाभिषिक्तानां विधि: प्रत्युपवेशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000188017, "chapter_id": 9188, "verse_number": "२-१११-१८", "content_sanskrit": "उत्तिष्ठ नरशार्दूल हित्वैतद्दारुणं व्रतम् ।\nपुरवर्य्यामित: क्षिप्रमयोध्यां याहि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000188018, "chapter_id": 9188, "verse_number": "२-१११-१९", "content_sanskrit": "आसीनस्त्वेव भरत: पौरजानपदं जनम् ।\nउवाच सर्वत: प्रेक्ष्य किमार्यं नानुशासथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000188019, "chapter_id": 9188, "verse_number": "२-१११-२०", "content_sanskrit": "ते तमूचुर्महात्मानं पौरजानपदा जना: ।\nकाकुत्स्थमभिजानीम: सम्यग्वदति राघव: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000188020, "chapter_id": 9188, "verse_number": "२-१११-२१", "content_sanskrit": "एषो ऽपि हि महाभाग: पितुर्वचसि तिष्ठति ।\nअत एव न शक्ता: स्मो व्यावर्त्तयितुमञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000188021, "chapter_id": 9188, "verse_number": "२-१११-२२", "content_sanskrit": "तेषामाज्ञाय वचनं रामो वचनमब्रवीत् ।\nएवं निबोध वचनं सुहृदां धर्मचक्षुषाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000188022, "chapter_id": 9188, "verse_number": "२-१११-२३", "content_sanskrit": "एतच्चैवोभयं श्रुत्वा सम्यक् सम्पश्य राघव ।\nउत्तिष्ठ त्वं महाबाहो मां च स्पृश तथोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000188023, "chapter_id": 9188, "verse_number": "२-१११-२४", "content_sanskrit": "अथोत्थाय जलं स्पृष्ट्वा भरतो वाक्यमब्रवीत् ।\nश्रृण्वन्तु मे परिषदो मन्त्रिण: श्रेणयस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000188024, "chapter_id": 9188, "verse_number": "२-१११-२५", "content_sanskrit": "न याचे पितरं राज्यं नानुशासामि मातरम् ।\nआर्यं परमधर्मज्ञं नानुजानामि राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000188025, "chapter_id": 9188, "verse_number": "२-१११-२६", "content_sanskrit": "यदि त्ववश्यं वस्तव्यं कर्त्तव्यं च पितुर्वच: ।\nअहमेव निवत्स्यामि चतुर्दश समा वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000188026, "chapter_id": 9188, "verse_number": "२-१११-२७", "content_sanskrit": "धर्मात्मा तस्य तथ्येन भ्रातुर्वाक्येन विस्मित: ।\nउवाच राम: सम्प्रेक्ष्य पौरजानपदं जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000188027, "chapter_id": 9188, "verse_number": "२-१११-२८", "content_sanskrit": "विक्रीतमाहितं क्रीतं यत् पित्रा जीवता मम ।\nन तल्लोपयितुं शक्यं मया वा भरतेन वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000188028, "chapter_id": 9188, "verse_number": "२-१११-२९", "content_sanskrit": "अपधिर्न मया कार्य्यो वनवासे जुगुप्सित: ।\nयुक्तमुक्तं च कैकेय्या पित्रा मे सुकृतं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000188029, "chapter_id": 9188, "verse_number": "२-१११-३०", "content_sanskrit": "जानामि भरतं क्षान्तं गुरुसत्कारकारिणम् ।\nसर्वमेवात्र कल्याणं सत्यसन्धे महात्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000188030, "chapter_id": 9188, "verse_number": "२-१११-३१", "content_sanskrit": "अनेन धर्मशीलेन वनात् प्रत्यागत: पुन: ।\nभ्रात्रा सह भविष्यामि पृथिव्या: पतिरुत्तम: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000188031, "chapter_id": 9188, "verse_number": "२-१११-३२", "content_sanskrit": "वृतो राजा हि कैकेय्या मया तद्वचनं कृतम् ।\nअनृतन्मोचयानेन पितरं तं महीपतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000188032, "chapter_id": 9188, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे एकादशोत्तरशततम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]