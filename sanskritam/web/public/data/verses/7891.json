[{"id": 33000091, "chapter_id": 7891, "verse_number": "1", "content_sanskrit": "आचष्टे वक्ति वदति रपत्याख्याति भाषते । ब्रूतेऽभिधत्ते गदति व्याहरत्यपि जल्पति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 33000092, "chapter_id": 7891, "verse_number": "2", "content_sanskrit": "ब्रवीत्यभिदधाति व्याहरते कथयत्यपि । गृणात्युदीरयत्युक्तौ कीर्तयत्यालपत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 33000093, "chapter_id": 7891, "verse_number": "3", "content_sanskrit": "भणत्यपि वचत्येके वाचयत्यपि शंसति । पठत्यधीतेऽध्ययने चर्चयत्यपि चर्चति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 33000094, "chapter_id": 7891, "verse_number": "4", "content_sanskrit": "आमनत्युपयुङ्क्ते च गमयत्यपि शिक्षते । शिक्षणेऽध्यापयति च शिक्षयत्यनुशास्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 33000095, "chapter_id": 7891, "verse_number": "5", "content_sanskrit": "वेदम्‌ आचष्ट इत्यर्थे वेदापयति सम्मतम्‌ । संस्तौत्यभ्यस्यति परिचिनोतीत्यात्मनेऽप्यमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 33000096, "chapter_id": 7891, "verse_number": "6", "content_sanskrit": "स्युः शीलयति च गुणयत्याम्रेडयति शीलने । सत्यापयति सत्योक्तौ कुन्द्रयत्यनृतोदिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 33000097, "chapter_id": 7891, "verse_number": "7", "content_sanskrit": "असम्यगुक्तौ शठयत्येवं श्वठयति द्वयम्‌ । अपशब्दयति म्लेच्छत्यपभ्रंशयतीत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 33000098, "chapter_id": 7891, "verse_number": "8", "content_sanskrit": "म्लेच्छयत्यपशब्दे स्युरपभाषत इत्यमी । स्खलति भ्रेषति भ्लेषत्यन्यत्वेऽन्यथयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 33000099, "chapter_id": 7891, "verse_number": "9", "content_sanskrit": "मिथ्याकारयते त्वेतदन्यथात्वेऽसकृत्कृते । शपते शप्यति शपत्याक्रोशत्यपि शप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 33000100, "chapter_id": 7891, "verse_number": "10", "content_sanskrit": "वेटत्याक्रोशनेऽमी षड्‌ अथ मिथ्याऽभिशंसने । अभ्याख्यात्यप्यभिशपत्यभ्याचष्टेऽभिशंसति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 33000101, "chapter_id": 7891, "verse_number": "11", "content_sanskrit": "जुगुप्सते वाचयति प्रवदत्यपि गर्हते । त्रयः क्षिपत्यात्मनेऽपि चोपक्रोशति निन्दति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 33000102, "chapter_id": 7891, "verse_number": "12", "content_sanskrit": "निसः परेश्च वदति गल्हत्यपि च गल्हते । निन्दायां स्युः कुत्सयते क्षिपत्यपकरोत्यमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 33000103, "chapter_id": 7891, "verse_number": "13", "content_sanskrit": "भर्त्सयते तर्जयते सन्तर्जति लजति लाजति च । लञ्जति लाञ्जति तुल्याः तर्जयति च दृश्यते कविषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 33000104, "chapter_id": 7891, "verse_number": "14", "content_sanskrit": "प्रतिभिन्ते प्रतिभिनत्त्युपालभत इत्यपि । उपालम्भे सनिन्दे तु परिभाषत इत्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 33000105, "chapter_id": 7891, "verse_number": "15", "content_sanskrit": "स्तौति स्तुते नुवति नौति पनायतीट्टे | स्तुत्याम्‌ ऋचत्यपि पणायति च स्तवीति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 33000106, "chapter_id": 7891, "verse_number": "16", "content_sanskrit": "स्युर्वन्दतेऽर्कयति चेडयति प्रशंसत्येतानि पञ्चदश दीव्यति मन्दते च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 33000107, "chapter_id": 7891, "verse_number": "17", "content_sanskrit": "कत्थते स्तोमयति च श्लाघते शाडतेऽपि च | शीभते शल्भते शाठयते स्युः सप्त कत्थने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 33000108, "chapter_id": 7891, "verse_number": "18", "content_sanskrit": "कवते वर्णयति च कवित्वे कवयत्यपि | उपश्लोकयतीत्येतच्छलोकोपस्तवनार्थकम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 33000109, "chapter_id": 7891, "verse_number": "19", "content_sanskrit": "यज्ञेषु शंसतीत्यृग्भिः स्तुते स्तौतीति सामभिः। शास्त्रे प्रतिगृणातीति प्रोत्साहेऽनुगृणाति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 33000110, "chapter_id": 7891, "verse_number": "20", "content_sanskrit": "स्यात्‌ प्रत्यभिवदत्याशीर्वाद आशास्त इत्यपि । निबध्राति ग्रन्थति च ग्रथ्नाति श्रन्थयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 33000111, "chapter_id": 7891, "verse_number": "21", "content_sanskrit": "श्रथ्नाति वटयत्येवं पटयत्यपि गुम्फति । गुफत्येकादश ग्रन्थे दृभति ग्रन्थयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 33000112, "chapter_id": 7891, "verse_number": "22", "content_sanskrit": "समाहरति सङ्क्षेपे सङ्गृह्णाति समस्यति । सङिक्षपत्यात्मनेऽप्येते सङ्क्षिप्यति तनक्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}, {"id": 33000113, "chapter_id": 7891, "verse_number": "23", "content_sanskrit": "यन्त्रयत्यपि सङ्क्षिप्तावष्ट कूणयतेऽप्यमी । विस्तृणोति व्यस्यति च विस्तृणात्यातनोति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23, "avatarnika": ""}, {"id": 33000114, "chapter_id": 7891, "verse_number": "24", "content_sanskrit": "चत्वारस्त्वतिविस्तारे पञ्चते पञ्चयत्यपि । व्याकरोति व्याकुरुते व्याचष्टेऽर्थापयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24, "avatarnika": ""}, {"id": 33000115, "chapter_id": 7891, "verse_number": "25", "content_sanskrit": "व्याख्याति स्पष्टयति च व्यनक्ति व्यञ्जयत्यपि । करोति प्रादुराविर्भ्यां विवृणोत्यात्मनेऽप्ययम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25, "avatarnika": ""}, {"id": 33000116, "chapter_id": 7891, "verse_number": "26", "content_sanskrit": "प्रकाशने प्रकथयत्येते लक्षयतीत्यपि । तिष्ठते घोषयति च विशब्दयति घोषति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26, "avatarnika": ""}, {"id": 33000117, "chapter_id": 7891, "verse_number": "27", "content_sanskrit": "आकारयत्याह्वयति हूतौ निह्वयते त्रयम्‌ । स्यात्‌ संहूतौ संह्वयते स्पर्धया ह्वयते हवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27, "avatarnika": ""}, {"id": 33000118, "chapter_id": 7891, "verse_number": "28", "content_sanskrit": "अनुयुङ्क्ते प्रश्नयति प्रश्ने ज्ञीप्सति पृच्छति । आपृच्छते तु यात्रर्थे विप्रश्ने राध्यतीक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28, "avatarnika": ""}, {"id": 33000119, "chapter_id": 7891, "verse_number": "29", "content_sanskrit": "आभिमुख्येन वचने प्रवदत्यभिवक्ति च । प्रतिवक्त्युत्तरयति प्रत्याहेत्यादयोऽपि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29, "avatarnika": ""}, {"id": 33000120, "chapter_id": 7891, "verse_number": "30", "content_sanskrit": "अपह्नुतेऽपजानीते निह्नुतेऽपलपत्यमी । अपह्नवे निराचष्टे प्रत्याचष्टे निरस्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30, "avatarnika": ""}, {"id": 33000121, "chapter_id": 7891, "verse_number": "31", "content_sanskrit": "प्रत्यादिशत्यपनयत्यपोहति परास्यति । पराणुदति चाऽपास्यत्यात्मने स्युर्व्युदस्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31, "avatarnika": ""}, {"id": 33000122, "chapter_id": 7891, "verse_number": "32", "content_sanskrit": "नवैतेऽपाकरोतीति प्रत्याख्याति निराकृतौ । पराकरोत्योणति च दूषयत्यपि लुञ्चति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32, "avatarnika": ""}, {"id": 33000123, "chapter_id": 7891, "verse_number": "33", "content_sanskrit": "उपमन्त्रयते चोपवदते सान्त्वयत्यपि । चपत्युपच्छन्दयति सामयत्यपि सान्त्वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33, "avatarnika": ""}, {"id": 33000124, "chapter_id": 7891, "verse_number": "34", "content_sanskrit": "सप्ताऽनुनयतीत्येतदात्मनेऽप्यथ सूचने । सूचयत्यप्युत्कुरते त्रयः पिशुनयत्यमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34, "avatarnika": ""}]