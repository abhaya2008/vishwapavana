[{"id": 7001710000, "chapter_id": 21710, "verse_number": "१-९६-१", "content_sanskrit": "ब्रह्मोवाच ।\nमरीचे श्रृणु वक्ष्यामि वेदव्यासेन यत्कृतम् ।\nश्रीमद्भागवतं नाम पुराणं ब्रह्मसम्मितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001710001, "chapter_id": 21710, "verse_number": "१-९६-२", "content_sanskrit": "तदष्टादशसाहस्रं कीर्तितं पापनाशनम् ।\nसुरपादपरूपोऽयं स्कंधैर्द्वादशभिर्युतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001710002, "chapter_id": 21710, "verse_number": "१-९६-३", "content_sanskrit": "भगवानेव विप्रेंद्र विश्वरूपीसमीरितः ।\nतत्र तु प्रथमस्कंधे सूतर्षीणां समागमे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001710003, "chapter_id": 21710, "verse_number": "१-९६-४", "content_sanskrit": "व्यासस्य चरितं पुण्यं पांडवानां तथैव च ।\nपरीक्षितमुपाख्यानमितीदं समुदाहृतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001710004, "chapter_id": 21710, "verse_number": "१-९६-५", "content_sanskrit": "परीक्षिच्छुकसंवादे सृष्टिद्वयनिरूपणम् ।\nब्रह्मनारदसंवादे देवताचरितामृतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001710005, "chapter_id": 21710, "verse_number": "१-९६-६", "content_sanskrit": "पुराणलक्षणं चैव सृष्टिकारणसंभवः ।\nद्वितीयोऽयं समुदितः स्कंधो व्यासेन धीमता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001710006, "chapter_id": 21710, "verse_number": "१-९६-७", "content_sanskrit": "चरितं विदुरस्याथ मैत्रेयेणास्य संगमः ।\nसृष्टिप्रकरणं पश्चाद्बह्मणः परमात्मनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001710007, "chapter_id": 21710, "verse_number": "१-९६-८", "content_sanskrit": "कापिलं सांख्यमप्यत्र तृतीयोऽयमुदाहृतः ।\nसत्याश्चरितमादौ तु ध्रुवस्य चरितं ततः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001710008, "chapter_id": 21710, "verse_number": "१-९६-९", "content_sanskrit": "पृथोः पुण्यसमाख्यानं ततः प्राचीनबर्हिषम् ।\nइत्येष तुर्यो गदितो विसर्गे स्कंध उत्तमः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001710009, "chapter_id": 21710, "verse_number": "१-९६-१०", "content_sanskrit": "प्रियव्रतस्य चरितं तद्वंश्यानां च पुण्यदम् ।\nब्रह्मांडांतर्गतानां च लोकानां वर्णनं ततः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001710010, "chapter_id": 21710, "verse_number": "१-९६-११", "content_sanskrit": "नरकस्थितिरित्येष संस्थाने पंचमो मतः ।\nअजामिलस्य चरितं दक्षसृष्टिनिरूपणम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001710011, "chapter_id": 21710, "verse_number": "१-९६-१२", "content_sanskrit": "वृत्राख्यानं ततः पश्चान्मरुतां जन्म पुण्यदम् ।\nषष्ठोऽयमुदितः स्कंधोव्यासेन परिपोषणे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001710012, "chapter_id": 21710, "verse_number": "१-९६-१३", "content_sanskrit": "प्रह्लादचरितं पुण्यं वर्णाश्रमनिरूपणम् ।\nसप्तमो गदितो वत्स वासनाकर्मकीर्तने ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001710013, "chapter_id": 21710, "verse_number": "१-९६-१४", "content_sanskrit": "गजेंद्रमोक्षणाख्यानं मन्वंतरनिरूपणे ।\nसमुद्रमथनं चैव बलिवैभवबंधनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001710014, "chapter_id": 21710, "verse_number": "१-९६-१५", "content_sanskrit": "मत्स्याक्तारचरितमष्टमोऽयं प्रकीर्तितः ।\nसूर्यवंशसमाख्यानं सोमवंशनिरूपणम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001710015, "chapter_id": 21710, "verse_number": "१-९६-१६", "content_sanskrit": "वंश्यानुचरिते प्रोक्तो नवमोऽयं महामते ।\nकृष्णस्य बालचरितं कौमारं च व्रजस्थितिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001710016, "chapter_id": 21710, "verse_number": "१-९६-१७", "content_sanskrit": "कैशोरं मथुरास्थानं यौवनं द्वारकास्थितिः ।\nभूभारहरणं चात्र निरोधे दशमः स्मृतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001710017, "chapter_id": 21710, "verse_number": "१-९६-१८", "content_sanskrit": "नारदेन तु संवादो वसुदेवस्य कीर्तितः ।\nयदोश्च दत्तात्रेयेण श्रीकृष्णोनोद्धवस्य च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001710018, "chapter_id": 21710, "verse_number": "१-९६-१९", "content_sanskrit": "यादवानां मिथोंतश्च मुक्तावेकादशः स्मृतः ।\nभविष्यकलिनिर्द्देशो मोक्षो राज्ञः परीक्षितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001710019, "chapter_id": 21710, "verse_number": "१-९६-२०", "content_sanskrit": "वेदशाखाप्रणयनं मार्कंडेयतपःक्रिया ।\nसौरी विभूतिरुदिता सात्वती च ततः परम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001710020, "chapter_id": 21710, "verse_number": "१-९६-२१", "content_sanskrit": "पुराणसंख्याकथनमाश्रये द्वादशो ह्ययम् ।\nइत्येवं कथितं वत्स श्रीमद्भागवतं तव ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001710021, "chapter_id": 21710, "verse_number": "१-९६-२२", "content_sanskrit": "वक्तुः श्रोतुश्चोपदेष्टुरनुमोदितुरेव च ।\nसाहाय्यकर्तुर्गदितं भक्तिभुक्तिविमुक्तिदम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001710022, "chapter_id": 21710, "verse_number": "१-९६-२३", "content_sanskrit": "प्रौष्ठपद्यां पूर्णिमायां हेमसिंहसमन्वितम् ।\nदेयं भागवतायेदं द्विजायप्रीतिपूर्वकम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001710023, "chapter_id": 21710, "verse_number": "१-९६-२४", "content_sanskrit": "संपूज्य वस्त्रहेमाद्यैर्भगवद्भक्तिमिच्छता ।\nयोऽप्यनुक्रमणीमेतां श्रावयेच्छृणुयात्तथा ।\nस पुराणश्रवणजं प्राप्नोति फलमुत्तमम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]