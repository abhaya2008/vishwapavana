[{"id": 5000526000, "chapter_id": 9526, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकोनविंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000526001, "chapter_id": 9526, "verse_number": "६-११९-१", "content_sanskrit": "एतच्छ्रुत्वा शुभं वाक्यं राघवेणानुभाषितम्।\nततः शुभतरं वाक्यं व्याजहार महेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000526002, "chapter_id": 9526, "verse_number": "६-११९-२", "content_sanskrit": "पुष्कराक्ष महाबाहो महावक्षः परंतप।\nदिष्ट्या कृतमिदं कर्म त्वया धर्मभृतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000526003, "chapter_id": 9526, "verse_number": "६-११९-३", "content_sanskrit": "दिष्ट्या सर्वस्य लोकस्य प्रवृद्धं दारुणं तमः।\nअपवृत्तं त्वया संख्ये राम रावणजं भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000526004, "chapter_id": 9526, "verse_number": "६-११९-४", "content_sanskrit": "आश्वास्य भरतं दीनं कौसल्यां च यशस्विनीम्।\nकैकेयीं च सुमित्रां च दृष्ट्वा लक्ष्मणमातरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000526005, "chapter_id": 9526, "verse_number": "६-११९-५", "content_sanskrit": "प्राप्य राज्यमयोध्यायां नन्दयित्वा सुहृज्जनम्।\nइक्ष्वाकूणां कुले वंशं स्थापयित्वा महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000526006, "chapter_id": 9526, "verse_number": "६-११९-६", "content_sanskrit": "इष्ट्वा तुरगमेधेन प्राप्य चानुत्तमं यशः।\nब्राह्मणेभ्यो धनं दत्त्वा त्रिदिवं गन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000526007, "chapter_id": 9526, "verse_number": "६-११९-७", "content_sanskrit": "एष राजा दशरथो विमानस्थः पिता तव।\nकाकुत्स्थ मानुषे लोके गुरुस्तव महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000526008, "chapter_id": 9526, "verse_number": "६-११९-८", "content_sanskrit": "इन्द्रलोकं गतः श्रीमांस्त्वया पुत्रेण तारितः।\nलक्ष्मणेन सह भ्रात्रा त्वमेनमभिवादय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000526009, "chapter_id": 9526, "verse_number": "६-११९-९", "content_sanskrit": "महादेववचः श्रुत्वा राघवः सहलक्ष्मणः।\nविमानशिखरस्थस्य प्रणाममकरोत् पितुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000526010, "chapter_id": 9526, "verse_number": "६-११९-१०", "content_sanskrit": "दीप्यमानं स्वया लक्ष्म्या विरजोऽम्बरधारिणम्।\nलक्ष्मणेन सह भ्रात्रा ददर्श पितरं प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000526011, "chapter_id": 9526, "verse_number": "६-११९-११", "content_sanskrit": "हर्षेण महताऽऽविष्टो विमानस्थो महीपतिः।\nप्राणैः प्रियतरं दृष्ट्वा पुत्रं दशरथस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000526012, "chapter_id": 9526, "verse_number": "६-११९-१२", "content_sanskrit": "आरोप्याङ्के महाबाहुर्वरासनगतः प्रभुः।\nबाहुभ्यां सम्परिष्वज्य ततो वाक्यं समाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000526013, "chapter_id": 9526, "verse_number": "६-११९-१३", "content_sanskrit": "न मे स्वर्गो बहु मतः सम्मानश्च सुरर्षभैः।\nत्वया राम विहीनस्य सत्यं प्रतिशृणोमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000526014, "chapter_id": 9526, "verse_number": "६-११९-१४", "content_sanskrit": "अद्य त्वां निहतामित्रं दृष्ट्वा सम्पूर्णमानसम्।\nनिस्तीर्णवनवासं च प्रीतिरासीत् परा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000526015, "chapter_id": 9526, "verse_number": "६-११९-१५", "content_sanskrit": "कैकेय्या यानि चोक्तानि वाक्यानि वदतां वर।\nतव प्रव्राजनार्थानि स्थितानि हृदये मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000526016, "chapter_id": 9526, "verse_number": "६-११९-१६", "content_sanskrit": "त्वां तु दृष्ट्वा कुशलिनं परिष्वज्य सलक्ष्मणम्।\nअद्य दुःखाद् विमुक्तोऽस्मि नीहारादिव भास्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000526017, "chapter_id": 9526, "verse_number": "६-११९-१७", "content_sanskrit": "तारितोऽहं त्वया पुत्र सुपुत्रेण महात्मना।\nअष्टावक्रेण धर्मात्मा कहोलो ब्राह्मणो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000526018, "chapter_id": 9526, "verse_number": "६-११९-१८", "content_sanskrit": "इदानीं च विजानामि यथा सौम्य सुरेश्वरैः।\nवधार्थं रावणस्येह विहितं पुरुषोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000526019, "chapter_id": 9526, "verse_number": "६-११९-१९", "content_sanskrit": "सिद्धार्था खलु कौसल्या या त्वां राम गृहं गतम्।\nवनान्निवृत्तं संहृष्टा द्रक्ष्यते शत्रुसूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000526020, "chapter_id": 9526, "verse_number": "६-११९-२०", "content_sanskrit": "सिद्धार्थाः खलु ते राम नरा ये त्वां पुरीं गतम्।\nराज्ये चैवाभिषिक्तं च द्रक्ष्यन्ते वसुधाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000526021, "chapter_id": 9526, "verse_number": "६-११९-२१", "content_sanskrit": "अनुरक्तेन बलिना शुचिना धर्मचारिणा।\nइच्छेयं त्वामहं द्रष्टुं भरतेन समागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000526022, "chapter_id": 9526, "verse_number": "६-११९-२२", "content_sanskrit": "चतुर्दश समाः सौम्य वने निर्यातितास्त्वया।\nवसता सीतया सार्धं मत्प्रीत्या लक्ष्मणेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000526023, "chapter_id": 9526, "verse_number": "६-११९-२३", "content_sanskrit": "निवृत्तवनवासोऽसि प्रतिज्ञा पूरिता त्वया।\nरावणं च रणे हत्वा देवताः परितोषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000526024, "chapter_id": 9526, "verse_number": "६-११९-२४", "content_sanskrit": "कृतं कर्म यशः श्लाघ्यं प्राप्तं ते शत्रुसूदन।\nभ्रातृभिः सह राज्यस्थो दीर्घमायुरवाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000526025, "chapter_id": 9526, "verse_number": "६-११९-२५", "content_sanskrit": "इति ब्रुवाणं राजानं रामः प्राञ्जलिरब्रवीत्।\nकुरु प्रसादं धर्मज्ञ कैकय्या भरतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000526026, "chapter_id": 9526, "verse_number": "६-११९-२६", "content_sanskrit": "सपुत्रां त्वां त्यजामीति यदुक्ता कैकयी त्वया।\nस शापः कैकयीं घोरः सपुत्रां न स्पृशेत् प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000526027, "chapter_id": 9526, "verse_number": "६-११९-२७", "content_sanskrit": "तथेति स महाराजो राममुक्त्वा कृताञ्जलिम्।\nलक्ष्मणं च परिष्वज्य पुनर्वाक्यमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000526028, "chapter_id": 9526, "verse_number": "६-११९-२८", "content_sanskrit": "रामं शुश्रूषता भक्त्या वैदेह्या सह सीतया।\nकृता मम महाप्रीतिः प्राप्तं धर्मफलं च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000526029, "chapter_id": 9526, "verse_number": "६-११९-२९", "content_sanskrit": "धर्मं प्राप्स्यसि धर्मज्ञ यशश्च विपुलं भुवि।\nरामे प्रसन्ने स्वर्गं च महिमानं तथोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000526030, "chapter_id": 9526, "verse_number": "६-११९-३०", "content_sanskrit": "रामं शुश्रूष भद्रं ते सुमित्रानन्दवर्धन।\nरामः सर्वस्य लोकस्य हितेष्वभिरतः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000526031, "chapter_id": 9526, "verse_number": "६-११९-३१", "content_sanskrit": "एते सेन्द्रास्त्रयो लोकाः सिद्धाश्च परमर्षयः।\nअभिवाद्य महात्मानमर्चन्ति पुरुषोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000526032, "chapter_id": 9526, "verse_number": "६-११९-३२", "content_sanskrit": "एतत् तदुक्तमव्यक्तमक्षरं ब्रह्मसम्मितम्।\nदेवानां हृदयं सौम्य गुह्यं रामः परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000526033, "chapter_id": 9526, "verse_number": "६-११९-३३", "content_sanskrit": "अवाप्तधर्माचरणं यशश्च विपुलं त्वया।\nएवं शुश्रूषताव्यग्रं वैदेह्या सह सीतया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000526034, "chapter_id": 9526, "verse_number": "६-११९-३४", "content_sanskrit": "इत्युक्त्वा लक्ष्मणं राजा स्नुषां बद्धाञ्जलिं स्थिताम्।\nपुत्रीत्याभाष्य मधुरं शनैरेनामुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000526035, "chapter_id": 9526, "verse_number": "६-११९-३५", "content_sanskrit": "कर्तव्यो न तु वैदेहि मन्युस्त्यागमिमं प्रति।\nरामेणेदं विशुद्ध्यर्थं कृतं वै त्वद्धितैषिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000526036, "chapter_id": 9526, "verse_number": "६-११९-३६", "content_sanskrit": "सुदुष्करमिदं पुत्रि तव चारित्रलक्षणम्।\nकृतं यत् तेऽन्यनारीणां यशो ह्यभिभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000526037, "chapter_id": 9526, "verse_number": "६-११९-३७", "content_sanskrit": "न त्वं कामं समाधेया भर्तृशुश्रूषणं प्रति।\nअवश्यं तु मया वाच्यमेष ते दैवतं परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000526038, "chapter_id": 9526, "verse_number": "६-११९-३८", "content_sanskrit": "इति प्रतिसमादिश्य पुत्रौ सीतां च राघवः।\nइन्द्रलोकं विमानेन ययौ दशरथो नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000526039, "chapter_id": 9526, "verse_number": "६-११९-३९", "content_sanskrit": "विमानमास्थाय महानुभावः\nश्रिया च संहृष्टतनुर्नृपोत्तमः।\nआमन्त्र्य पुत्रौ सह सीतया च\nजगाम देवप्रवरस्य लोकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000526040, "chapter_id": 9526, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकोनविंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]