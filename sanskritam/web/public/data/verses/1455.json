[{"id": 2021922, "chapter_id": 1455, "verse_number": "३-९३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021923, "chapter_id": 1455, "verse_number": "३-९३-१", "content_sanskrit": "ने तथा सहिता वीरा वसन्तस्तत्रतत्र ह।\nक्रमेण पृथिवीपाल नैमिषारण्यमागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021924, "chapter_id": 1455, "verse_number": "३-९३-२", "content_sanskrit": "तत्स्तीर्थेषु पुण्येषु गोमत्याः पाण्डवा नृप।\nकृताभिषेकाः प्रददुर्गाश्च वित्तं च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021925, "chapter_id": 1455, "verse_number": "३-९३-३", "content_sanskrit": "तत्र देवान्पितॄन्विप्रांस्तर्पयित्वा पुनःपुनः।\nकन्यातीर्थेऽश्वतीर्थे च गवां तीर्थे च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021926, "chapter_id": 1455, "verse_number": "३-९३-४", "content_sanskrit": "कालकोट्यां विपप्रस्थे गिरावुष्य च कौरवाः।\nबाहुदायां महीपाल चक्रुः सर्वेऽभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021927, "chapter_id": 1455, "verse_number": "३-९३-५", "content_sanskrit": "प्रयागे देवयजने देवानां पृथिवीपते।\nऊषुगप्लुत्य गात्राणि तपश्चातस्थुरुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021928, "chapter_id": 1455, "verse_number": "३-९३-६", "content_sanskrit": "गङ्गायमुनयोश्चैव संगमे सत्यसंगराः।\nविपाप्मानो महात्मानो विप्रेभ्यः प्रददुर्वसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021929, "chapter_id": 1455, "verse_number": "३-९३-७", "content_sanskrit": "तपस्विजनजुष्टां च ततो वेदीं प्रजापतेः।\nजग्मुः पाण्डुसुता राजन्ब्राह्मणैः सह भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021930, "chapter_id": 1455, "verse_number": "३-९३-८", "content_sanskrit": "तत्र ते न्यवसन्वीरास्तपश्चातस्थुरुत्तमम्।\nसंतर्पयन्तः सततं वन्येन हविषा द्विजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021931, "chapter_id": 1455, "verse_number": "३-९३-९", "content_sanskrit": "ततो महीधरं जग्मुर्धर्मज्ञेनाभिसत्कृतम्।\nराजर्षिणा पुण्यकृता गयेनानुपमद्युते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021932, "chapter_id": 1455, "verse_number": "३-९३-१०", "content_sanskrit": "नगो गयशिरो यत्र पुण्या चैव महानदी।\nवानीरमालिनी रम्या नदी पुलिनशोभिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021933, "chapter_id": 1455, "verse_number": "३-९३-११", "content_sanskrit": "दिव्यं पवित्रकूटं च पवित्रधरणीधरम्।\nऋषिजुष्टं सुपुण्यं तत्तीर्थं ब्रह्मसरोतुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021934, "chapter_id": 1455, "verse_number": "३-९३-१२", "content_sanskrit": "अगस्त्यो भगवान्यत्र गतो वैवस्वतं प्रति।\nरउवास च स्वयं तत्र धर्मराजः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021935, "chapter_id": 1455, "verse_number": "३-९३-१३", "content_sanskrit": "सर्वासां सरितां चैव समुद्भेदो विशांपते।\nयत्रसंनिहितो नित्यं महादेवः पिनाकधृक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021936, "chapter_id": 1455, "verse_number": "३-९३-१४", "content_sanskrit": "`परिपूर्णः परंज्योतिः परमात्मा सनातनः।\nब्रह्मादिभिरुपास्योऽयं भगवान्परमेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021937, "chapter_id": 1455, "verse_number": "३-९३-१५", "content_sanskrit": "तं प्रणम्य महादेवं चतुर्वर्गफलप्रदम्।\nरसिद्धिक्षेत्रमिदं मत्वासर्वेषांमोक्षकाङ्क्षिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021938, "chapter_id": 1455, "verse_number": "३-९३-१६", "content_sanskrit": "तत्र ते पाण्डवा वीराश्चातुर्मास्यैस्तदेजिरे।\nऋषियज्ञेन महता यत्राक्षयवटो महान्।\nअक्षये देवयजने अक्षयं यत्रवै फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021939, "chapter_id": 1455, "verse_number": "३-९३-१७", "content_sanskrit": "ये तु तत्रोपवासांस्तु चक्रुर्निश्चितमानसाः।\nब्राह्मणास्तत्रशतशः समाजग्मुस्तपोधनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021940, "chapter_id": 1455, "verse_number": "३-९३-१८", "content_sanskrit": "चातुर्मास्येनायजन्त आर्षेण विधिना तदा।\nतत्र विद्यातपोवृद्धा ब्राह्मणा वेदपारगाः।\nकथां प्रचक्रिरे पुण्यां सदसिस्था महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2021941, "chapter_id": 1455, "verse_number": "३-९३-१९", "content_sanskrit": "तत्र विद्याव्रतस्नातः कौमारं व्रतमास्थितः।\nशमठोऽकथयद्राजन्नाधूर्तरजसं गयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2021942, "chapter_id": 1455, "verse_number": "३-९३-२०x", "content_sanskrit": "शमठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2021943, "chapter_id": 1455, "verse_number": "३-९३-२०", "content_sanskrit": "आधूर्तरजसः पुत्रो गयो राजर्षिसत्तमः।\nपुण्यानि तस्य कर्माणि तानि मे शृणु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2021944, "chapter_id": 1455, "verse_number": "३-९३-२१", "content_sanskrit": "यस्य यज्ञो बभूवेह बह्वन्नो बहुदक्षिणः।\nयत्रान्नपर्वता राजञ्शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2021945, "chapter_id": 1455, "verse_number": "३-९३-२२", "content_sanskrit": "घृतकुल्याश्च दध्नश्च नद्यो बहुशतास्तथा।\nव्यञ़्जनानां प्रवाहाश्च महार्हाणां सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2021946, "chapter_id": 1455, "verse_number": "३-९३-२३", "content_sanskrit": "अहन्यहनि चाप्येवं याचतां संप्रदीयते।\nअन्ये च ब्राह्मणा राजन्भुञ्जतेऽन्नं सुसंस्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2021947, "chapter_id": 1455, "verse_number": "३-९३-२४", "content_sanskrit": "तत्र वै दक्षिणाकाले ब्रह्मघोषो दिवं गतः।\nन च प्रज्ञायते किंचिद्ब्रह्मशब्देन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2021948, "chapter_id": 1455, "verse_number": "३-९३-२५", "content_sanskrit": "पुण्येन चरता राजन्भूर्दिशः खं नभस्तथा।\nआपूर्णमासीच्छब्देन तदप्यासीन्महाद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2021949, "chapter_id": 1455, "verse_number": "३-९३-२६", "content_sanskrit": "यत्रस्म गाथा गायन्ति मनुष्या मरतर्षभ।\nअन्नपानैः शुभैस्तृप्ता देशे देशे सुवर्चसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2021950, "chapter_id": 1455, "verse_number": "३-९३-२७", "content_sanskrit": "गयस्य यज्ञे के त्वद्य प्राणिनो भोक्तुमीप्सवः।\nतत्र भोजनशिष्टस्य पर्वताः पञ्चविंशतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2021951, "chapter_id": 1455, "verse_number": "३-९३-२८", "content_sanskrit": "न तत्पूर्वे जनाश्चक्रुर्न करिष्यन्ति चापरे।\nगयो यदकरोद्यज्ञे राजर्षिरमितद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2021952, "chapter_id": 1455, "verse_number": "३-९३-२९", "content_sanskrit": "कथं तु देवा हविषा गयेन परितर्पिताः।\nपुन शक्ष्यन्त्युपादातुमन्यैर्दत्तानि कानिचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2021953, "chapter_id": 1455, "verse_number": "३-९३-३०", "content_sanskrit": "सिकता वा यथा लोके यथा वा दिवि तारकाः।\nयथा वा वर्षतोधारा असंख्येयाः स्म केनचित्।\nतथा गणयितुं शक्या गययज्ञे न दक्षिणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2021954, "chapter_id": 1455, "verse_number": "३-९३-३१", "content_sanskrit": "एवंविधाः सुबहवस्तस्य यज्ञा महीपतेः।\nबभूवुरस्य सरसः समीपे कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2021955, "chapter_id": 1455, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि त्रिनवतितमोऽध्यायः ॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]