[{"id": 6000048000, "chapter_id": 10048, "verse_number": null, "content_sanskrit": "अथ अष्टादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000048001, "chapter_id": 10048, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.001.m4a", "display_order": 2}, {"id": 6000048002, "chapter_id": 10048, "verse_number": "३-१८-१", "content_sanskrit": "निशम्यात्मभुवा गीतं कारणं शङ्कयोज्झिताः।\nततः सर्वे न्यवर्तन्त त्रिदिवाय दिवौकसः॥ ३/१८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.002.m4a", "display_order": 3, "topics": [{"text": "दितेर्जठराद्वर्षशतावसाने हिरण्यकशिपुहिरण्याक्षयोरुत्पत्तिः, उत्पातनिरूपणम्, नामकरणं च", "range": "१–१८"}]}, {"id": 6000048003, "chapter_id": 10048, "verse_number": "३-१८-२", "content_sanskrit": "दितिस्तु भर्तुरादेशादपत्यपरिशङ्किनी।\nपूर्णे वर्षशते साध्वी पुत्रौ प्रसुषुवे यमौ॥ ३/१८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.003.m4a", "display_order": 4}, {"id": 6000048004, "chapter_id": 10048, "verse_number": "३-१८-३", "content_sanskrit": "उत्पाता बहवस्तत्र निपेतुर्जायमानयोः।\nदिवि भुव्यन्तरिक्षे च लोकस्य च भयावहाः॥ ३/१८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.004.m4a", "display_order": 5}, {"id": 6000048005, "chapter_id": 10048, "verse_number": "३-१८-४", "content_sanskrit": "सहाचला भुवश्चेलुर्दिशः सर्वाः प्रजज्वलुः।\nसोल्काश्चाशनयः पेतुः केतवश्चार्तिहेतवः॥ ३/१८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.005.m4a", "display_order": 6}, {"id": 6000048006, "chapter_id": 10048, "verse_number": "३-१८-५", "content_sanskrit": "ववौ वायुः सुदुःस्पर्शः फट्काररववान्मुहुः।\nउन्मूलयन् नगपतीन् वात्यानीको रजोध्वजः॥ ३/१८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.006.m4a", "display_order": 7}, {"id": 6000048007, "chapter_id": 10048, "verse_number": "३-१८-६", "content_sanskrit": "उल्लसत्तटिदम्भोदघटया नष्टभागणे।\nव्योम्नि प्रविष्टतमसा न स्म व्यादृश्यते पदम्॥ ३/१८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.007.m4a", "display_order": 8}, {"id": 6000048008, "chapter_id": 10048, "verse_number": "३-१८-७", "content_sanskrit": "चुक्रोश विमना वार्धिरुदूर्मिक्षुभितोदरः।\nसोदपानाश्च सरितश्चुक्षुभुः शुष्कपङ्कजाः॥ ३/१८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.008.m4a", "display_order": 9}, {"id": 6000048009, "chapter_id": 10048, "verse_number": "३-१८-८", "content_sanskrit": "मुहुः परिधयोऽभूवन् सराह्वोः शशिसूर्ययोः।\nनिर्घातरवनिर्ह्रादा विवरेभ्यः प्रजज्ञिरे॥ ३/१८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.009.m4a", "display_order": 10}, {"id": 6000048010, "chapter_id": 10048, "verse_number": "३-१८-९", "content_sanskrit": "अन्तर्ग्रामेषु मुखतो वमन्त्यो वह्निमुल्बणम्।\nसृगालाश्चापि टङ्कारैः प्रणेदुरशिवाः शिवाः॥ ३/१८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.010.m4a", "display_order": 11}, {"id": 6000048011, "chapter_id": 10048, "verse_number": "३-१८-१०", "content_sanskrit": "सङ्गीतवद् रोदनवदुन्नमय्य शिरोधरान्।\nव्यमुञ्चन् विविधा वाचो ग्रामसिंहास्ततस्ततः॥ ३/१८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.011.m4a", "display_order": 12}, {"id": 6000048012, "chapter_id": 10048, "verse_number": "३-१८-११", "content_sanskrit": "खरोष्ट्राः कर्कशैः क्षत्तः खुरैर्घ्नन्तो धरातलम्।\nखात्काररभसा मत्ताः पर्यधावन् वरूथशः॥ ३/१८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.012.m4a", "display_order": 13}, {"id": 6000048013, "chapter_id": 10048, "verse_number": "३-१८-१२", "content_sanskrit": "रुदन्तो रासभत्रस्ता नीडादुदपतन् खगाः।\nघोषेऽरण्ये च पशवः शकृन्मूत्रमकुर्वत॥ ३/१८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.013.m4a", "display_order": 14}, {"id": 6000048014, "chapter_id": 10048, "verse_number": "३-१८-१३", "content_sanskrit": "गावोऽत्रसन्नसृग्दोहास्तोयदाः पूयवर्षिणः।\nव्यरुदन् देवलिङ्गानि द्रुमाः पेतुर्विनाऽनिलम्॥ ३/१८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.014.m4a", "display_order": 15}, {"id": 6000048015, "chapter_id": 10048, "verse_number": "३-१८-१४", "content_sanskrit": "ग्रहान् पुण्यतमानन्ये भगणांश्चापि दीपिताः।\nअतिचेरुर्वक्रगत्या युयुधुश्च परस्परम्॥ ३/१८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.015.m4a", "display_order": 16}, {"id": 6000048016, "chapter_id": 10048, "verse_number": "३-१८-१५", "content_sanskrit": "दृष्ट्वाऽन्यांश्च महोत्पातान् न तत्तत्त्वविदः प्रजाः।\nब्रह्मपुत्रानृते भीता मेनिरे विश्वसम्प्लवम्॥ ३/१८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.016.m4a", "display_order": 17}, {"id": 6000048017, "chapter_id": 10048, "verse_number": "३-१८-१६", "content_sanskrit": "तावादिदैत्यौ सहसा व्यज्यमानात्मपौरुषौ।\nववृधातेऽश्मसारेण कायेनाद्रिपती इव॥ ३/१८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.017.m4a", "display_order": 18}, {"id": 6000048018, "chapter_id": 10048, "verse_number": "३-१८-१७", "content_sanskrit": "दिविस्पृशौ हेमकिरीटकोटिभिर्निरुद्धकाष्ठौ स्फुरदङ्गदैर्भुजैः।\nगां कम्पयन्तौ चरणैः पदे पदे कट्या सुकाञ्च्याऽर्कमतीत्य तस्थतुः॥ ३/१८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.018.m4a", "display_order": 19}, {"id": 6000048019, "chapter_id": 10048, "verse_number": "३-१८-१८", "content_sanskrit": "प्रजापतिर्नाम तयोरकार्षीद् यः प्राक् स्वदेहाद् यमयोरजायत।\nतं वै हिरण्यकशिपुं विदुः प्रजाः यं तं हिरण्याक्षमसूत साऽग्रतः॥ ३/१८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.019.m4a", "display_order": 20}, {"id": 6000048020, "chapter_id": 10048, "verse_number": "३-१८-१९", "content_sanskrit": "चक्रे हिरण्यकशिपुर्दोर्भ्यां ब्रह्मवरेण च।\nवशे सपालान् लोकांस्‍त्रीनकुतोमृत्युरुद्धतः॥ ३/१८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.020.m4a", "display_order": 21, "topics": [{"text": "हिरण्याक्षेण दिग्विजयार्थं निर्गतेन युद्धाय वरुणाह्वानम्", "range": "१९–२७"}]}, {"id": 6000048021, "chapter_id": 10048, "verse_number": "३-१८-२०", "content_sanskrit": "हिरण्याक्षोऽनुजस्तस्य प्रियः प्रीतिकृदन्वहम्।\nगदापाणिर्दिवं यातो युयुत्सुर्मृगयन् रणम्॥ ३/१८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.021.m4a", "display_order": 22}, {"id": 6000048022, "chapter_id": 10048, "verse_number": "३-१८-२१", "content_sanskrit": "तं वीक्ष्य दुस्तरजवं रणत्काञ्चननूपुरम्।\nवैजयन्त्या स्रजा जुष्टमंसन्यस्तमहागदम्॥ ३/१८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.022.m4a", "display_order": 23}, {"id": 6000048023, "chapter_id": 10048, "verse_number": "३-१८-२२", "content_sanskrit": "मनोवीर्यमदोत्सिक्तमधृष्यमकुतोभयम्।\nभीता निलिल्यिरे देवास्तार्क्ष्यत्रस्ता इवाहयः॥ ३/१८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.023.m4a", "display_order": 24}, {"id": 6000048024, "chapter_id": 10048, "verse_number": "३-१८-२३", "content_sanskrit": "स वै तिरोहितान् दृष्ट्वा महसा स्वेन दैत्यराट्।\nसेन्द्रान् देवगणान् क्लीबानपश्यद् व्यनदद् भृशम्॥ ३/१८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.024.m4a", "display_order": 25}, {"id": 6000048025, "chapter_id": 10048, "verse_number": "३-१८-२४", "content_sanskrit": "ततो निवृत्तः क्रीडिष्यन् गम्भीरं भीमनिस्वनः।\nविजगाहे महासत्त्वो वार्धिं मत्त इव द्विपः॥ ३/१८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.025.m4a", "display_order": 26}, {"id": 6000048026, "chapter_id": 10048, "verse_number": "३-१८-२५", "content_sanskrit": "तस्मिन् प्रविष्टे वरुणस्य सैनिकाः यादोगणाः सन्नधियः ससाध्वसाः।\nअहन्यमाना अपि तस्य वर्चसा प्रधर्षिता दूरतरं प्रदुद्रुवुः॥ ३/१८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.026.m4a", "display_order": 27}, {"id": 6000048027, "chapter_id": 10048, "verse_number": "३-१८-२६", "content_sanskrit": "स वर्षपूगानुदधौ महाबलश्चरन् महोर्मीः श्वसनेरिता मुहुः।\nगुर्व्याऽभिजघ्ने गदया विभावरीम् आसेदिवांस्तात पुरं प्रचेतसः॥ ३/१८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.027.m4a", "display_order": 28}, {"id": 6000048028, "chapter_id": 10048, "verse_number": "३-१८-२७", "content_sanskrit": "तत्रोपलभ्यासुरलोकपालको यादोगणानामृषभं प्रचेतसम्।\nस्मयन् प्रलब्धुं प्रणिपत्य नीचवत् जगाद मे देह्यधिराज सङ्गरम्॥ ३/१८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.028.m4a", "display_order": 29}, {"id": 6000048029, "chapter_id": 10048, "verse_number": "३-१८-२८", "content_sanskrit": "त्वं लोकपालाधिपतिर्बृहच्छ्रवाः वीर्यावहो दुर्मदवीरमानिनाम्।\nविजित्य लोकेऽखिलदैत्यदानवान् यद् राजसूयेन पुराऽयजत् प्रभो॥ ३/१८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.029.m4a", "display_order": 30, "topics": [{"text": "वरुणेन तं प्रति स्वस्य वृद्धत्वाद् युद्धाय नारायणं प्रति गमनचोदना", "range": "२८–३१"}]}, {"id": 6000048030, "chapter_id": 10048, "verse_number": "३-१८-२९", "content_sanskrit": "स एवमुत्सिक्तमदेन विद्विषा दृढं प्रलब्धो भगवानपांपतिः।\nरोषं समुत्थं शमयन् स्वया धिया व्यवोचदङ्गोपशमं गता वयम्॥ ३/१८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.030.m4a", "display_order": 31}, {"id": 6000048031, "chapter_id": 10048, "verse_number": "३-१८-३०", "content_sanskrit": "पश्यामि नान्यं पुरुषात् पुरातनाद् यः संयुगे त्वां रणमार्ग कोविदम्।\nआवारयिष्यत्यसुरर्षभाहितं मनस्विनो यं वृणुते भवादृशाः॥ ३/१८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.031.m4a", "display_order": 32}, {"id": 6000048032, "chapter_id": 10048, "verse_number": "३-१८-३१", "content_sanskrit": "तं वीरमारादभिपद्य विस्मयः शयिष्यसे वीरशये श्वभिर्वृतः।\nयस्त्वद्विधानामसतां प्रशान्तये रूपाणि धत्ते सदनुग्रहेच्छया॥ ३/१८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_018/BhP_03.018.032.m4a", "display_order": 33}, {"id": 6000048033, "chapter_id": 10048, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे अष्टादशध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]