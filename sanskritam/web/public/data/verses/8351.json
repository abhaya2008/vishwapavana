[{"id": 900004610, "chapter_id": 8351, "verse_number": "10.1", "content_sanskrit": "तान्यहं वेद सर्वाणि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004611, "chapter_id": 8351, "verse_number": "10.2", "content_sanskrit": "तत एवाभ्रान्तत्वान्न मुक्तस्यापि भेदनिवृत्तिः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004612, "chapter_id": 8351, "verse_number": "10.3", "content_sanskrit": "न चोपाधिभेदमात्रेणेश्वरस्य दुःखाभावः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004613, "chapter_id": 8351, "verse_number": "10.4", "content_sanskrit": "अतोऽनौपाधिकत्वादेव..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004614, "chapter_id": 8351, "verse_number": "10.5", "content_sanskrit": "‘इदं ज्ञानमुपाश्रित्य मम साधर्म्यमागताः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004615, "chapter_id": 8351, "verse_number": "10.6", "content_sanskrit": "एवं प्रत्यक्षानुमानागमविरुद्धत्वादभेदविषयवत् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004616, "chapter_id": 8351, "verse_number": "10.7", "content_sanskrit": "भेदाद्यनुभवस्य भ्रान्तित्वाङ्गीकारे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004617, "chapter_id": 8351, "verse_number": "10.8", "content_sanskrit": "एकजीववादपक्षे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004618, "chapter_id": 8351, "verse_number": "10.9", "content_sanskrit": "एकजीववादपक्षे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004619, "chapter_id": 8351, "verse_number": "10.10", "content_sanskrit": "न चैकजीवाज्ञानपरिकल्पिताः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004620, "chapter_id": 8351, "verse_number": "10.11", "content_sanskrit": "अतो मुक्तेभ्योऽप्यन्य एव ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004621, "chapter_id": 8351, "verse_number": "10.12", "content_sanskrit": "ब्रह्मेशानादिभिर्देवैर्यत्प्राप्तुं नैव शक्यते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004622, "chapter_id": 8351, "verse_number": "10.13", "content_sanskrit": "सत्यचिच्चेत्यपतये मुक्तामुक्तोत्तमाय ते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900004623, "chapter_id": 8351, "verse_number": "10.14", "content_sanskrit": "नमो नारायणायार्यवृन्दवन्दितपद्द्वय..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900004624, "chapter_id": 8351, "verse_number": "10.15", "content_sanskrit": "नमो नारायणायार्यवृन्दवन्दितपद्द्वय..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]