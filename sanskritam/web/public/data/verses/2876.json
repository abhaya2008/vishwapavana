[{"id": 2088175, "chapter_id": 2876, "verse_number": "१३-६-१", "content_sanskrit": "युधिष्ठिर उवाच।\nब्राह्मण्यं यदि दुष्प्राप्यं त्रिभिर्वर्णैर्नराधिप।\nकथं प्राप्तं महाराज क्षत्रियेण महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088176, "chapter_id": 2876, "verse_number": "१३-६-२", "content_sanskrit": "विश्वामित्रेण धर्मात्मन्ब्राह्मणत्वं नरर्षभ।\nश्रोतुमिच्छामि तत्त्वेन तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088177, "chapter_id": 2876, "verse_number": "१३-६-३", "content_sanskrit": "तेन ह्यमितवीर्येण वसिष्ठस्य महात्मनः।\nहतं पुत्रशतं सद्यस्तपसाऽपि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088178, "chapter_id": 2876, "verse_number": "१३-६-४", "content_sanskrit": "यातुधानाश्च बहवो राक्षसास्तिग्मतेजसः।\nमन्युनाऽऽविष्टदेहेन सृष्टाः कालान्तकोपमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088179, "chapter_id": 2876, "verse_number": "१३-६-५", "content_sanskrit": "महान्कुशिकवंशश्च ब्रह्मर्षिशतसंकुलः।\nस्थापितो नरलोकेऽस्मिन्विद्वद्ब्राह्मणसंकुलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088180, "chapter_id": 2876, "verse_number": "१३-६-६", "content_sanskrit": "ऋतीकस्यात्मजश्चैव शुनःशेपो महातपाः।\nविमोक्षितो महासत्रात्पशुतामप्युपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088181, "chapter_id": 2876, "verse_number": "१३-६-७", "content_sanskrit": "हरिश्चन्द्रक्रतौ देवांस्तोषयित्वाऽऽत्मतेजसा।\nपुत्रतामनुसंप्राप्तो विश्वामित्रस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088182, "chapter_id": 2876, "verse_number": "१३-६-८", "content_sanskrit": "नाभिवादयते ज्येष्ठं देवरातं नराधिप।\nपुत्राः पञ्चशतं चापि शप्ताः श्वपचतां गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088183, "chapter_id": 2876, "verse_number": "१३-६-९", "content_sanskrit": "त्रिशङ्कुर्बन्धुभिर्मुक्त ऐक्ष्वाकः प्रीतिपूर्वकम्।\nअवाक्शिरादिवं नीतो दक्षिणामाश्रितोदिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088184, "chapter_id": 2876, "verse_number": "१३-६-१०", "content_sanskrit": "विश्वामित्रस्य भगिनी नदी देवर्षिसेविता।\nकौशिकीति कृता पुण्या ब्रह्मर्षिसुरसेविता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088185, "chapter_id": 2876, "verse_number": "१३-६-११", "content_sanskrit": "तपोविघ्नकरी चैव पञ्चचूडा सुसंमता।\nरम्भा नामाप्सराः शापाद्यस्य शैलत्वमागता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088186, "chapter_id": 2876, "verse_number": "१३-६-१२", "content_sanskrit": "तथैवास्य भयाद्बद्ध्वा वसिष्ठः सलिले पुरा।\nआत्मानं मञ्जयञ्श्रीमान्विपाशः पुनरुत्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088187, "chapter_id": 2876, "verse_number": "१३-६-१३", "content_sanskrit": "तदाप्रभृति पुण्या हि विपाशाऽभून्महानदी।\nविख्याता कर्मणा तेन वसिष्ठस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088188, "chapter_id": 2876, "verse_number": "१३-६-१४", "content_sanskrit": "वश्यश्च भगवान्येन देवसेनाग्रगः प्रभुः।\nस्तुतः प्रीतमनाश्चासीच्छापाच्चैनममुञ्चत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088189, "chapter_id": 2876, "verse_number": "१३-६-१५", "content_sanskrit": "ध्रुवस्यौत्तानपादस्य ब्रह्मर्षीणां तथैव च।\nमध्ये ज्वलति यो नित्यमुदीचीमाश्रितो दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088190, "chapter_id": 2876, "verse_number": "१३-६-१६", "content_sanskrit": "तस्यैतानि च कर्माणि तथाऽन्यानि च कौरव।\nक्षत्रियस्येत्यतो जातमिदं कौहतूलं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088191, "chapter_id": 2876, "verse_number": "१३-६-१७", "content_sanskrit": "किमेतदिति तत्त्वेन प्रब्रूहि भरतर्षभ।\nदेहान्तरमनासाद्य कथं स ब्राह्मणोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088192, "chapter_id": 2876, "verse_number": "१३-६-१८", "content_sanskrit": "एतत्तत्वेन मे तात सर्वमाख्यातुमर्हसि।\nमतङ्गस्य यथातत्त्वं तथैवैतद्वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088193, "chapter_id": 2876, "verse_number": "१३-६-१९", "content_sanskrit": "स्थाने मतङ्गो ब्राह्मण्यं नालभद्भरतर्षभ।\nचण्डालयोनौजातो हि कथं ब्राह्मण्यमाप्तवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088194, "chapter_id": 2876, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानदर्मपर्वणि षष्ठोऽध्यायः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]