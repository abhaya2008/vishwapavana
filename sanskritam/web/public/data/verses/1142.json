[{"id": 2007365, "chapter_id": 1142, "verse_number": "१-१४३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007366, "chapter_id": 1142, "verse_number": "१-१४३-१", "content_sanskrit": "ततो धनञ्जयं द्रोणः स्मयमानोऽभ्यभाषत।\nत्वयेदानीं प्रहर्तव्यमेतल्लक्ष्यं विलोक्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007367, "chapter_id": 1142, "verse_number": "१-१४३-२", "content_sanskrit": "मद्वाक्यसमकालं ते मोक्तव्योऽत्र भवेच्छरः।\nवितत्य कार्मुकं पुत्र तिष्ठ तावन्मुहूर्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007368, "chapter_id": 1142, "verse_number": "१-१४३-३", "content_sanskrit": "एवमुक्तः सव्यसाची मण्डलीकृतकार्मुकः।\nतस्थौ भासं समुद्दिश्य गुरुवाक्यप्रचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007369, "chapter_id": 1142, "verse_number": "१-१४३-४", "content_sanskrit": "मुहूर्तादिव तं द्रोणस्तथैव समभाषत।\nपश्यस्येनं स्थितं भासं द्रुमं मामपि चार्जुन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007370, "chapter_id": 1142, "verse_number": "१-१४३-५", "content_sanskrit": "पश्याम्येकं भासमिति द्रोणं पार्थोऽभ्यभाषत।\nन तु वृक्षं भवन्तं वा पश्यामीति च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007371, "chapter_id": 1142, "verse_number": "१-१४३-६", "content_sanskrit": "ततः प्रीतमना द्रोणो मुहूर्तादिव तं पुनः।\nप्रत्यभाषत दुर्धर्षः पाण्डवानां महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007372, "chapter_id": 1142, "verse_number": "१-१४३-७", "content_sanskrit": "भासं पश्यसि यद्येनं तथा ब्रूहि पुनर्वचः।\nशिरः पश्यामि भासस्य न गात्रमिति सोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007373, "chapter_id": 1142, "verse_number": "१-१४३-८", "content_sanskrit": "अर्जुनेनैवमुक्तस्तु द्रोणो हृष्टतनूरुहः।\nमुञ्चस्वेत्यब्रवीत्पार्थं स मुमोचाविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007374, "chapter_id": 1142, "verse_number": "१-१४३-९", "content_sanskrit": "ततस्तस्य गस्थस्य क्षुरेण निशितेन च।\nशिर उत्कृत्य तरसा पातयामास पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007375, "chapter_id": 1142, "verse_number": "१-१४३-१०", "content_sanskrit": "तस्मिन्कर्मणि संसिद्धे पर्यष्वजत पाण्डवम्।\nमेने च द्रुपदं सङ्ख्ये सानुबन्धं पराजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007376, "chapter_id": 1142, "verse_number": "१-१४३-११", "content_sanskrit": "कस्य चित्त्वथ कालस्य सशिष्योऽङ्गिरसां वरः।\nजगाम गङ्गामभितो मज्जितुं भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007377, "chapter_id": 1142, "verse_number": "१-१४३-१२", "content_sanskrit": "अवगाढमथो द्रोणं सलिले सलिलेचरः।\nग्राहो जग्राह बलवाञ्जङ्घान्ते कालचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007378, "chapter_id": 1142, "verse_number": "१-१४३-१३", "content_sanskrit": "स समर्थोऽपि मोक्षाय शिष्यान्सर्वानचोदयत्।\nग्राहं हत्वा तु मोक्ष्यध्वं मामिति त्वरयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007379, "chapter_id": 1142, "verse_number": "१-१४३-१४", "content_sanskrit": "तद्वाक्यसमकालं तु बीभत्सुर्निशितैः शरैः।\nअवार्यैः पञ्चभिर्ग्राहं मग्नमम्भस्यताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007380, "chapter_id": 1142, "verse_number": "१-१४३-१५", "content_sanskrit": "इतरे त्वथ संमूढास्तत्रपत्र प्रपेदिरे।\nतं तु दृष्ट्वा क्रियोपेतं द्रोणोऽमन्यत पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007381, "chapter_id": 1142, "verse_number": "१-१४३-१६", "content_sanskrit": "विशिष्टं सर्वशिष्येभ्यः प्रीतिमांश्चाभवत्तदा।\nस पार्थबाणैर्बहुधा खण्डशः परिकल्पितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007382, "chapter_id": 1142, "verse_number": "१-१४३-१७", "content_sanskrit": "ग्राहः पञ्चत्वमापेदे जङ्घां त्यक्त्वा महात्मनः।\nसर्वक्रियाभ्यनुज्ञानात्तथा शिष्यान्समानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007383, "chapter_id": 1142, "verse_number": "१-१४३-१८", "content_sanskrit": "दुर्योधनं चित्रसेनं दुःशासनविविंशती।\nअर्जुनं च समानीय ह्यश्वत्थामानमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007384, "chapter_id": 1142, "verse_number": "१-१४३-१९", "content_sanskrit": "शिशुकं मृण्मयं कृत्वा द्रोणो गङ्गाजले ततः।\nशिष्याणां पश्यतां चैव क्षिपति स्म महाभुजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007385, "chapter_id": 1142, "verse_number": "१-१४३-२०", "content_sanskrit": "चक्षुषी वाससा चैव बद्ध्वा प्रादाच्छरासनम्।\nशिशुकं विद्ध्यतेमं वै जलस्थं बद्धचक्षुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007386, "chapter_id": 1142, "verse_number": "१-१४३-२१", "content_sanskrit": "तत्क्षणेनैव बीभत्सुरावापैर्दशभिर्वशी।\nपञ्चकैरनुविव्याध मग्नं शिशुकमम्भसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007387, "chapter_id": 1142, "verse_number": "१-१४३-२२", "content_sanskrit": "ताः स दृष्ट्वा क्रियाः सर्वा द्रोणोऽमन्यत पाण्डवम्।\nविशिष्टं सर्वशिष्येभ्यः प्रीतिमांश्चाभवत्तदा।\nतथाब्रवीन्महात्मानं भारद्वाजो महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007388, "chapter_id": 1142, "verse_number": "१-१४३-२३", "content_sanskrit": "गृहाणेदं महाबाहो विशिष्टमतिदुर्धरम्।\nअस्त्रं ब्रह्मशिरो नाम सप्रयोगनिवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007389, "chapter_id": 1142, "verse_number": "१-१४३-२४", "content_sanskrit": "न च ते मानुषेष्वेतत्प्रयोक्तव्यं कथंचन।\nजगद्विनिर्दहेदेतदल्पतेजसि पातितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007390, "chapter_id": 1142, "verse_number": "१-१४३-२५", "content_sanskrit": "असामान्यमिदं तात लोकेष्वस्त्रं निगद्यते।\nतद्धारयेथाः प्रयतः शृणु चेदं वचो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007391, "chapter_id": 1142, "verse_number": "१-१४३-२६", "content_sanskrit": "बाधेतामानुषः शत्रुर्यदि त्वां वीर कश्चन।\nतद्वधाय प्रयुञ्जीथास्तदस्त्रमिदमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007392, "chapter_id": 1142, "verse_number": "१-१४३-२७", "content_sanskrit": "तथेति संप्रतिश्रुत्य बीभत्सुः स कृताञ्जलिः।\nजग्राह परमास्त्रं तदाह चैनं पुनर्गुरुः।\nभविता त्वत्समो नान्यः पुमाँल्लोके धनुर्धरः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2007393, "chapter_id": 1142, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि त्रिचत्वारिंशदधिकशततमोऽध्यायः॥ १४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]