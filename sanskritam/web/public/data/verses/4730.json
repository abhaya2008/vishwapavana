[{"id": 2176262, "chapter_id": 4730, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2176263, "chapter_id": 4730, "verse_number": "१", "content_sanskrit": "समुदीर्णं ततो दृष्ट्वा सङ्ग्रामं कुरुमुख्ययोः ।\nअब्रवीदर्जुनस्तत्र वासुदेवं यशस्विनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2176264, "chapter_id": 4730, "verse_number": "२", "content_sanskrit": "अनयोर्वीरयोर्युद्धे को ज्यायान् भवतो मतः ।\nकस्य को वा गुणो ज्यायान् एतद् वद जनार्दन\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2176265, "chapter_id": 4730, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2176266, "chapter_id": 4730, "verse_number": "३", "content_sanskrit": "उपदेशोऽनयोस्तुल्यो भीमस्तु बलवांस्ततः ।\nकृती यत्नपरस्त्वेष धार्तराष्ट्रो वृकोदरात्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2176267, "chapter_id": 4730, "verse_number": "४", "content_sanskrit": "भीमसेनस्तु धर्मेण युध्यमानो न जेष्यति ।\nअन्यायेन तु युध्यन् वै हन्यादेष सुयोधनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2176268, "chapter_id": 4730, "verse_number": "५", "content_sanskrit": "मायया विजिता देवैरसुरा इति नः श्रुतम् ।\nवैरोचनिस्तु शक्रेण मायया विजितस्तु वै\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2176269, "chapter_id": 4730, "verse_number": "६", "content_sanskrit": "मायया चाक्षिपत् तेजो वृत्रस्य बलसूदनः ।\nतस्मान्मायामयं वीर आतिष्ठतु वृकोदरः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2176270, "chapter_id": 4730, "verse_number": "७", "content_sanskrit": "प्रतिज्ञातं हि भीमेन द्यूतकाले धनञ्जय ।\nऊरू भेत्स्यामि ते युद्धे गदयेति सुयोधनम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2176271, "chapter_id": 4730, "verse_number": "८", "content_sanskrit": "सोऽयं प्रतिज्ञां तां चापि पारयित्वाऽरिकर्शनः ।\nमायाविनं च राजानं माययैव निकृन्ततु\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2176272, "chapter_id": 4730, "verse_number": "९", "content_sanskrit": "यद्येष बलमास्थाय न्यायेन प्रहरिष्यति ।\nविषमस्थस्ततो राजा भविष्यति युधिष्ठिरः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2176273, "chapter_id": 4730, "verse_number": "१०", "content_sanskrit": "पुनरुक्तं च वक्ष्यामि पाण्डवैतन्निबोध मे ।\nधर्मराजापराधेन भयं नः समुपस्थितम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2176274, "chapter_id": 4730, "verse_number": "११", "content_sanskrit": "कृत्वा हि सुमहत् कर्म हत्वा भीष्ममुखान् रिपून् ।\nजयः प्राप्तो यशश्चाग्र्यं वैरं च प्रतियातितम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2176275, "chapter_id": 4730, "verse_number": "१२", "content_sanskrit": "तदेवं विजयः प्राप्तः पुनःसंशयितः कृतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2176276, "chapter_id": 4730, "verse_number": "१३", "content_sanskrit": "अबुद्धिरेषा महती धर्मराजस्य पाण्डव ।\nयदेकविजये वीर पणितं कृतमीदृशम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2176277, "chapter_id": 4730, "verse_number": "१४", "content_sanskrit": "सुयोधनः कृती वीर एकायनगतस्तथा ।\nअपि चोशनसा गीतः श्रूयते यः पुरातनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2176278, "chapter_id": 4730, "verse_number": "१५", "content_sanskrit": "श्लोकस्तत्त्वार्थसहितः तन्मे निगदतः शृणु\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2176279, "chapter_id": 4730, "verse_number": "१६", "content_sanskrit": "पुनरावर्तमानानां भग्नानां विजयैषिणाम् ।\nभेतव्यमरिशेषाणामेकायनगता हि ते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2176280, "chapter_id": 4730, "verse_number": "१७", "content_sanskrit": "सुयोधनमिमं भग्नं हतसैन्यं ह्रदं गतम् ।\nपराजितं वनप्रेप्सुं निराशं राज्यधारणे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2176281, "chapter_id": 4730, "verse_number": "१८", "content_sanskrit": "कोऽन्विष्य संयुगे प्राज्ञः पुनर्द्वन्द्वे समाह्वयेत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2176282, "chapter_id": 4730, "verse_number": "१९", "content_sanskrit": "अपि वो निर्जितं राज्यं न हरेत सुयोधनः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2176283, "chapter_id": 4730, "verse_number": "२०", "content_sanskrit": "यस्त्रयोदशवर्षाणि गदया कृतनिश्रमः ।\nचरत्यूर्ध्वं च तिर्यक् च भीमसेनजिघांसया\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2176284, "chapter_id": 4730, "verse_number": "२१", "content_sanskrit": "एनं चेन्न महाबाहुरन्यायेन हनिष्यति ।\nएष वः कौरवो राजा धार्तराष्ट्रो भविष्यति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2176285, "chapter_id": 4730, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2176286, "chapter_id": 4730, "verse_number": "२२", "content_sanskrit": "धनञ्जयस्तु श्रुत्वैवं केशवस्य महात्मनः ।\nप्रेक्षतो भीमसेनस्य हस्तेनोरुमताडयत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2176287, "chapter_id": 4730, "verse_number": "२३", "content_sanskrit": "गृह्य सञ्ज्ञां ततो भीमो गदया व्यचरद् रणे ।\nमण्डलानि विचित्राणि यमकानीतराणि च\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2176288, "chapter_id": 4730, "verse_number": "२४", "content_sanskrit": "दक्षिणं मण्डलं सव्यं गोमूत्रिकमथापि च ।\nव्यचरत् पाण्डवो राजन्नरिं सम्मोहयन्निव\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2176289, "chapter_id": 4730, "verse_number": "२५", "content_sanskrit": "तथैव तव पुत्रोऽपि गदामार्गविशारदः ।\nव्यचरल्लघु चित्रं च भीमसेनजिघांसया\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2176290, "chapter_id": 4730, "verse_number": "२६", "content_sanskrit": "आधुन्वन्तौ गदे घोरे चन्दनागरुरूषिते ।\nवैरस्यान्तं परीप्सन्तौ रणे क्रुद्धाविवान्तकौ\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2176291, "chapter_id": 4730, "verse_number": "२७", "content_sanskrit": "अन्योन्यं तौ जिघांसन्तौ प्रवीरौ पुरुषर्षभौ ।\nयुयुधाते गरुत्मन्तौ यथा नागामिषैषिणौ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2176292, "chapter_id": 4730, "verse_number": "२८", "content_sanskrit": "मण्डलानि विचित्राणि चरतोर्नृपभीमयोः ।\nगदासम्पातजास्तत्र जज्ञिरे पावकार्चिषः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2176293, "chapter_id": 4730, "verse_number": "२९", "content_sanskrit": "समं प्रहरतोस्तत्र शूरयोर्बलिनोर्मृधे ।\nक्षुब्धयोर्वायुना राजन् द्वयोरिव समुद्रयोः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2176294, "chapter_id": 4730, "verse_number": "३०", "content_sanskrit": "तयोः प्रहरतोस्तुल्यं मत्तकुञ्जरयोरिव ।\nमहानिर्घातसंह्रादः प्रहाराणामजायत\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2176295, "chapter_id": 4730, "verse_number": "३१", "content_sanskrit": "तस्मिंस्तथा वर्तमाने दारुणे सङ्कुले भृशम् ।\nउभावपि परिश्रान्तौ युध्यमानावरिन्दमौ\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2176296, "chapter_id": 4730, "verse_number": "३२", "content_sanskrit": "तौ मुहूर्तं समाश्वस्य पुनरेव परन्तपौ ।\nअभ्यहारयतां क्रुद्धौ प्रगृह्य महतीं गदाम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2176297, "chapter_id": 4730, "verse_number": "३३", "content_sanskrit": "तयोः समभवद् युद्धं घोररूपमसंवृतम् ।\nगदानिपातै राजेन्द्र तक्षतोर्वै परस्परम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2176298, "chapter_id": 4730, "verse_number": "३४", "content_sanskrit": "व्यायामप्रद्रुतौ तौ तु वृषभाक्षौ तरस्विनौ ।\nअन्योन्यं जघ्नतुर्वीरौ पङ्कस्थौ महिषाविव\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2176299, "chapter_id": 4730, "verse_number": "३५", "content_sanskrit": "जर्झरीकृतसर्वाङ्गौ रुधिरेण समुक्षितौ ।\nददृशाते हिमवतः पुष्पिताविव किंशुकौ\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2176300, "chapter_id": 4730, "verse_number": "३६", "content_sanskrit": "दुर्योधनस्तु पार्थेन विवरे सम्प्रदर्शिते ।\nईषदुत्स्मयमानस्तु सहसैवाभिवारितः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2176301, "chapter_id": 4730, "verse_number": "३७", "content_sanskrit": "तमभ्याशगतं प्राज्ञः क्षणे प्रेक्ष्य वृकोदरः ।\nअवाक्षिपद् गदां तस्मै वेगेन महता बली\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2176302, "chapter_id": 4730, "verse_number": "३८", "content_sanskrit": "अवक्षेपं तु तं दृष्ट्वा पुत्रस्तव विशाम्पते ।\nअपासर्पत् ततः स्थानात् सा मोघा न्यपतद् भुवि\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2176303, "chapter_id": 4730, "verse_number": "३९", "content_sanskrit": "मोक्षयित्वा प्रहारं तं पुत्रस्तव ससम्भ्रमम् ।\nभीमसेनं तु गदया प्राहरत् कुरुनन्दनः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2176304, "chapter_id": 4730, "verse_number": "४०", "content_sanskrit": "तस्य विस्यन्दमानेन रुधिरेणामितौजसः ।\nप्रहारगुरुघाताच्च मूर्च्छेव समजायत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2176305, "chapter_id": 4730, "verse_number": "४१", "content_sanskrit": "तन्नाबुध्यत पुत्रस्ते पीडितं पाण्डवं रणे ।\nधारयामास भीमोऽपि शरीरमतिपीडितम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2176306, "chapter_id": 4730, "verse_number": "४२", "content_sanskrit": "अमन्यत स्थितं वीरं प्रहरिष्यन्तमाहवे ।\nअतो न प्राहरत् तस्मै पुनरेव तवात्मजः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2176307, "chapter_id": 4730, "verse_number": "४३", "content_sanskrit": "ततो भीमो न जीवेद्धि राजा तव सुतो भवेत् ।\nतदवस्थं यदनृपो भीमं तु प्रहरेदपि\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2176308, "chapter_id": 4730, "verse_number": "४४", "content_sanskrit": "ततो मुहूर्तमाश्वास्य दुर्योधनमवस्थितम् ।\nवेगेनाभ्यद्रवद् राजन् गदामादाय पाण्डवः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2176309, "chapter_id": 4730, "verse_number": "४५", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य संरब्धममितौजसम् ।\nमोघमस्य प्रहारं तं चिकीर्षुर्भरतर्षभ\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2176310, "chapter_id": 4730, "verse_number": "४६", "content_sanskrit": "अवस्थाने मतिं कृत्वा पुत्रस्तव विशाम्पते ।\nइयेषोत्पतितुं राजन् वञ्चयिष्यन् वृकोदरम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2176311, "chapter_id": 4730, "verse_number": "४७", "content_sanskrit": "अबुध्यद् भीमसेनस्तु राज्ञस्तस्य चिकीर्षितम् ।\nअथास्य समभिद्रुत्य समुत्पत्य च सिंहवत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2176312, "chapter_id": 4730, "verse_number": "४८", "content_sanskrit": "धृत्या वञ्चयतो राजन् पुनरेवोत्पतिष्यतः ।\nऊरूभ्यां प्राहिणोद् वीर्याद् गदां वेगेन पाण्डवः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2176313, "chapter_id": 4730, "verse_number": "४९", "content_sanskrit": "सा वज्रनिष्पेषसमा प्रहिता भीमकर्मणा ।\nऊरू दुर्योधनस्याथ बभञ्ज प्रियदर्शनौ\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2176314, "chapter_id": 4730, "verse_number": "५०", "content_sanskrit": "स पपात नरव्याघ्रो वसुधामनुनादयन् ।\nभग्नोरुर्भीमसेनेन पुत्रस्तव विशाम्पते\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2176315, "chapter_id": 4730, "verse_number": "५१", "content_sanskrit": "ववुर्वाताः सनिर्घाताः पांसुवर्षं पपात च ।\nचचाल पृथिवी चापि सवृक्षवनपर्वता\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2176316, "chapter_id": 4730, "verse_number": "५२", "content_sanskrit": "तस्मिन् निपतिते वीरे पत्यौ सर्वमहीक्षिताम् ।\nमहास्वना पुनर्दीप्ता सनिर्घाता भयङ्करी\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2176317, "chapter_id": 4730, "verse_number": "५३", "content_sanskrit": "पपात चोल्का महती पतिते पृथिवीपतौ\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2176318, "chapter_id": 4730, "verse_number": "५४", "content_sanskrit": "अथ शोणितवर्षं च पांसुवर्षं च भारत ।\nववर्ष मघवांस्तत्र तव पुत्रे निपातिते\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2176319, "chapter_id": 4730, "verse_number": "५५", "content_sanskrit": "यक्षाणां राक्षसानां च पिशाचानां परन्तप ।\nअन्तरिक्षे महान् नादस्तत्र भारत शुश्रुवे\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2176320, "chapter_id": 4730, "verse_number": "५६", "content_sanskrit": "तेन शब्देन घोरेण मृगाणामथ पक्षिणाम् ।\nजज्ञे घोरतरः शब्दो बहूनां सर्वतोदिशम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2176321, "chapter_id": 4730, "verse_number": "५७", "content_sanskrit": "ये तत्र वाजिनः शेषा गजाश्च मनुजैः सह ।\nमुमुचुस्ते महानादं तव पुत्रे निपातिते\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2176322, "chapter_id": 4730, "verse_number": "५८", "content_sanskrit": "भेरीशङ्खनिनादानामभवच्च स्वनो महान् ।\nअन्तर्भूमिगतो राजन् तव पुत्रे निपातिते\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2176323, "chapter_id": 4730, "verse_number": "५९", "content_sanskrit": "ह्रदाः कूपाश्च रुधिरमुद्वमन्नृपसत्तम ।\nनद्यश्च सुमहावेगाः प्रतिस्रोतोवहा भवन्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2176324, "chapter_id": 4730, "verse_number": "६०", "content_sanskrit": "पुंलिङ्गा इव नार्यश्च स्त्रीलिङ्गाः पुरुषा भवन् ।\nदुर्योधने महाराज पतिते तनये तव\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2176325, "chapter_id": 4730, "verse_number": "६१", "content_sanskrit": "दृष्ट्वा तानद्भुतोत्पातान् पाञ्चालाः पाण्डवैः सह ।\nआविग्नमनसः सर्वे बभूवुर्नृपसत्तम\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2176326, "chapter_id": 4730, "verse_number": "६२", "content_sanskrit": "ययुर्देवा यथाकामं गन्धर्वाप्सरसस्तथा ।\nकथयन्तोऽद्भुतं युद्धमुभयोस्तत्र भारत\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2176327, "chapter_id": 4730, "verse_number": "६३", "content_sanskrit": "तथैव सिद्धा राजेन्द्र तथा यक्षाश्च चारणाः ।\nनरसिंहौ प्रशंसन्तौ विप्रजग्मुर्यथागतम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2176328, "chapter_id": 4730, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि दुर्योधनपातो नाम अष्टाविंशोऽध्यायः ॥२८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]