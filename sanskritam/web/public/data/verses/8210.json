[{"id": 900001093, "chapter_id": 8210, "verse_number": "9.1", "content_sanskrit": "ब्रह्मा देवानां प्रथमः सम्बभूव विश्वस्य कर्ता भुवनस्य गोप्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001094, "chapter_id": 8210, "verse_number": "9.2", "content_sanskrit": "तदेतत् सत्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001095, "chapter_id": 8210, "verse_number": "9.3", "content_sanskrit": "यथा सुदीप्तात् पावकाद् विष्फुलिङ्गा सहस्रशः प्रभवन्ते सरूपाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001096, "chapter_id": 8210, "verse_number": "9.4", "content_sanskrit": "पुरुष एवेदं विश्वं कर्म तपो ब्रह्म परामृतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001097, "chapter_id": 8210, "verse_number": "9.5", "content_sanskrit": "द्वा सुपर्णा सयुजा सखाया समानं वृक्षं परिषस्वजाते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001098, "chapter_id": 8210, "verse_number": "9.6", "content_sanskrit": "स वेदैतत् परमं ब्रह्मधाम यत्र विश्वं निहितं भाति शुभ्रम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]