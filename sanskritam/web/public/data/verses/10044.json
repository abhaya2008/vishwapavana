[{"id": 6000044000, "chapter_id": 10044, "verse_number": null, "content_sanskrit": "अथ चतुर्दशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "ब्रह्मणा प्रजासृष्टिमादिष्टेन स्वायंभुवेन तं प्रति सलिलनिमग्नधरणीसमुद्धरणप्रार्थना", "range": "१६–१५"}]}, {"id": 6000044001, "chapter_id": 10044, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.001.m4a", "display_order": 2}, {"id": 6000044002, "chapter_id": 10044, "verse_number": "३-१४-१", "content_sanskrit": "निशम्य वाचं वदतो मुनेः पुण्यतमां नृप।\nभूयः पप्रच्छ कौरव्यो वासुदेवकथादृतः॥ ३/१४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.002.m4a", "display_order": 3}, {"id": 6000044003, "chapter_id": 10044, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.003.m4a", "display_order": 4}, {"id": 6000044004, "chapter_id": 10044, "verse_number": "३-१४-२", "content_sanskrit": "स वै स्वायम्भुवः सम्राट् प्रियः पुत्रः स्वयम्भुवः।\nप्रतिलभ्य प्रियां पत्नीं किं चकार ततो मुने॥ ३/१४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.004.m4a", "display_order": 5}, {"id": 6000044005, "chapter_id": 10044, "verse_number": "३-१४-३", "content_sanskrit": "चरितं तस्य राजर्षेरादिराजस्य सत्तम।\nब्रूहि मे श्रद्दधानाय विष्वक्सेनाश्रयो ह्यसौ॥ ३/१४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.005.m4a", "display_order": 6}, {"id": 6000044006, "chapter_id": 10044, "verse_number": "३-१४-४", "content_sanskrit": "श्रुतस्य पुंसः सुचिरश्रमस्य नन्वञ्जसा सूरिभिरीडितोऽर्थः।\nयत् तद्गुणानुश्रवणं मुकुन्दपादारविन्दं हृदयेषु येषाम्॥ ३/१४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.006.m4a", "display_order": 7}, {"id": 6000044007, "chapter_id": 10044, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.007.m4a", "display_order": 8}, {"id": 6000044008, "chapter_id": 10044, "verse_number": "३-१४-५", "content_sanskrit": "इति ब्रुवाणं विदुरं विनीतं सहस्रशीर्ष्णश्चरणोपधानम्।\nप्रहृष्टरोमा भगवत्कथायां प्रणीयमानो मुनिरभ्यचष्ट॥ ३/१४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.008.m4a", "display_order": 9}, {"id": 6000044009, "chapter_id": 10044, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.009.m4a", "display_order": 10}, {"id": 6000044010, "chapter_id": 10044, "verse_number": "३-१४-६", "content_sanskrit": "यदा स्वभार्यया साकं जातः स्वायम्भुवो मनुः।\nप्राञ्जलिः प्रणतश्चेदं वेदगर्भमभाषत॥ ३/१४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.010.m4a", "display_order": 11}, {"id": 6000044011, "chapter_id": 10044, "verse_number": "३-१४-७", "content_sanskrit": "त्वमेकः सर्वभूतानां जन्मकृद् वृत्तिदः पिता।\nअथापि नः प्रजानां ते शुश्रूषा केन वा भवेत्॥ ३/१४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.011.m4a", "display_order": 12}, {"id": 6000044012, "chapter_id": 10044, "verse_number": "३-१४-८", "content_sanskrit": "तद् विधेहि नमस्तुभ्यं कर्मस्विज्यात्मशक्तिषु।\nयत् कृत्वेह यशो विष्वगमुत्र च भवेद् गतिः॥ ३/१४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.012.m4a", "display_order": 13}, {"id": 6000044013, "chapter_id": 10044, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.013.m4a", "display_order": 14}, {"id": 6000044014, "chapter_id": 10044, "verse_number": "३-१४-९", "content_sanskrit": "प्रीतस्तुभ्यमहं तात स्वस्ति स्याद् वां क्षितीश्वर।\nयन्निर्व्यलीकेन हृदा शाधि मेत्यात्मनाऽर्पितम्॥ ३/१४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.014.m4a", "display_order": 15}, {"id": 6000044015, "chapter_id": 10044, "verse_number": "३-१४-१०", "content_sanskrit": "एतावत्यात्मजैरेवं कार्या ह्यपचितिर्गुरौ।\nशक्त्याऽप्रमत्तैर्गृह्येत शासनं गतमत्सरैः॥ ३/१४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.015.m4a", "display_order": 16}, {"id": 6000044016, "chapter_id": 10044, "verse_number": "३-१४-११", "content_sanskrit": "स त्वमस्यामपत्यानि सदृशान्यात्मनो गुणैः।\nउत्पाद्य शाधि धर्मेण गां यज्ञैः पुरुषं यज॥ ३/१४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.016.m4a", "display_order": 17}, {"id": 6000044017, "chapter_id": 10044, "verse_number": "३-१४-१२", "content_sanskrit": "परं शुश्रूषणं मह्यं स्यात् प्रजारक्षया नृप।\nभगवांस्ते प्रजाभर्तुर्हृषीकेशोऽनुतुष्यति॥ ३/१४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.017.m4a", "display_order": 18}, {"id": 6000044018, "chapter_id": 10044, "verse_number": "३-१४-१३", "content_sanskrit": "येषां न तुष्टो भगवान् यज्ञलिङ्गो जनार्दनः।\nतेषां श्रमोऽप्यपार्थाय यदात्मा नादृतः स्वयम्॥ ३/१४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.018.m4a", "display_order": 19}, {"id": 6000044019, "chapter_id": 10044, "verse_number": null, "content_sanskrit": "मनुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.019.m4a", "display_order": 20}, {"id": 6000044020, "chapter_id": 10044, "verse_number": "३-१४-१४", "content_sanskrit": "आदेशेऽहं भगवतो वर्तयाम्यरिसूदन।\nस्थानं त्विहानुजानीहि प्रजानां मम च प्रभो॥ ३/१४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.020.m4a", "display_order": 21}, {"id": 6000044021, "chapter_id": 10044, "verse_number": "३-१४-१५", "content_sanskrit": "यदोकः सर्वसत्त्वानां मही मग्ना महाम्भसि।\nअस्या उद्धरणे यत्नो देव देव्या विधीयताम्॥ ३/१४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.021.m4a", "display_order": 22}, {"id": 6000044022, "chapter_id": 10044, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.022.m4a", "display_order": 23}, {"id": 6000044023, "chapter_id": 10044, "verse_number": "३-१४-१६", "content_sanskrit": "परमेष्ठी त्वपां मध्ये तथा सन्नामवेक्ष्य गाम्।\nकथमेनां समुन्नेष्य इति दध्यौ धिया चिरम्॥ ३/१४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.023.m4a", "display_order": 24, "topics": [{"text": "ब्रह्मणो नासाविवरान्निर्गतेन वराहरूपिणा हरिणा हिरण्याक्षहननपूर्वकं धरणीसमुद्धरणम्", "range": "१६–३४"}]}, {"id": 6000044024, "chapter_id": 10044, "verse_number": "३-१४-१७", "content_sanskrit": "पीतं मया जलं सर्वं पृथिवी च निवेशिता।\nतथाऽपि किमिदं साऽद्य प्लाव्यते पुनरम्बुभिः॥ ३/१४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.024.m4a", "display_order": 25}, {"id": 6000044025, "chapter_id": 10044, "verse_number": "३-१४-१८", "content_sanskrit": "प्रजा देवासुरपितृमनुष्यपशुपक्षिणः।\nसरीसृपान् नगान् नागान् भूतान्युच्चावचानि च॥ ३/१४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.025.m4a", "display_order": 26}, {"id": 6000044026, "chapter_id": 10044, "verse_number": "३-१४-१९", "content_sanskrit": "सृजतो मे क्षितिर्वार्भिः प्लाव्यमाना लयं गता।\nअथात्र किमनुष्ठेयमस्माभिः सर्गयोजितैः॥ ३/१४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.026.m4a", "display_order": 27}, {"id": 6000044027, "chapter_id": 10044, "verse_number": "३-१४-२०", "content_sanskrit": "यस्याहं हृदयादासं स ईशो विदधातु मे। इत्यभिध्यायतो नासाविवरात् सहसानघ।\nवराहतोको निरगादङ्गुष्ठपरिमाणतः॥ ३/१४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.027.m4a", "display_order": 28}, {"id": 6000044028, "chapter_id": 10044, "verse_number": "३-१४-२१", "content_sanskrit": "तस्याभिपश्यतः खस्थः क्षणेन किल भारत।\nगजमात्रः प्रववृधे तदद्भुतमभून्महत्॥ ३/१४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.028.m4a", "display_order": 29}, {"id": 6000044029, "chapter_id": 10044, "verse_number": "३-१४-२२", "content_sanskrit": "मरीचिमुख्यैर्विप्रैश्च कुमारैर्मनुना सह।\nदृष्ट्वा तत् सौकरं रूपं तर्कयामास चित्रधा॥ ३/१४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.029.m4a", "display_order": 30}, {"id": 6000044030, "chapter_id": 10044, "verse_number": "३-१४-२३", "content_sanskrit": "किमेतत् सौकरव्याजं सत्त्वं दिव्यमवस्थितम्।\nअहो बताश्चर्यमिदं नासाया मे विनिःसृतम्॥ ३/१४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.030.m4a", "display_order": 31}, {"id": 6000044031, "chapter_id": 10044, "verse_number": "३-१४-२४", "content_sanskrit": "दृष्टोऽङ्गुष्ठशिरोमात्रः क्षणाद् गण्डशिलोपमः।\nअपिस्विद् भगवानेष यज्ञो मे खेदयन्मनः॥ ३/१४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.031.m4a", "display_order": 32}, {"id": 6000044032, "chapter_id": 10044, "verse_number": "३-१४-२५", "content_sanskrit": "इति मीमांसतस्तस्य ब्रह्मणः सह सूनुभिः।\nभगवान् यज्ञपुरुषो जगर्जागेन्द्रसन्निभः॥ ३/१४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.032.m4a", "display_order": 33}, {"id": 6000044033, "chapter_id": 10044, "verse_number": "३-१४-२६", "content_sanskrit": "ब्रह्माणं हर्षयामास हरिस्तांश्च द्विजोत्तमान्।\nस्वगर्जितेन ककुभः प्रतिस्वनयता विदुः॥ ३/१४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.033.m4a", "display_order": 34}, {"id": 6000044034, "chapter_id": 10044, "verse_number": "३-१४-२७", "content_sanskrit": "निशम्य तद् घर्घरितं स्वखेदक्षयिष्णु मायामयसूकरस्य।\nजनस्तपःसत्यनिवासिनस्ते त्रिभिः पवित्रैर्मुनयोऽगृणन् स्म॥ ३/१४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.034.m4a", "display_order": 35}, {"id": 6000044035, "chapter_id": 10044, "verse_number": "३-१४-२८", "content_sanskrit": "तेषां सतां वेदवितानमूर्तिं ब्रह्मावधार्यात्मगुणानुवादम्।\nननर्द भूयो विबुधोदयाय गजेन्द्रलीलो जलमाविवेश॥ ३/१४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.035.m4a", "display_order": 36}, {"id": 6000044036, "chapter_id": 10044, "verse_number": "३-१४-२९", "content_sanskrit": "उत्क्षिप्तबालः खचरः कठोरसटा विधुन्वन् खररोमशत्वक्।\nखुराहताभ्रः सितशृङ्ग ईक्षाज्योतिर्विभासो भगवान् महीध्रः॥ ३/१४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.036.m4a", "display_order": 37}, {"id": 6000044037, "chapter_id": 10044, "verse_number": "३-१४-३०", "content_sanskrit": "घ्राणेन पृथ्व्याः पदवीं विजिघ्रन् क्रोडापदेशः स्वयमध्वराङ्गः।\nकरालदंष्ट्रोऽप्यकरालदृग्भ्याम् उद्वीक्ष्य विप्रान् गृणतोऽविशत् कम्॥ ३/१४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.037.m4a", "display_order": 38}, {"id": 6000044038, "chapter_id": 10044, "verse_number": "३-१४-३१", "content_sanskrit": "स वज्रकूटाङ्गनिपातवेगविशीर्णकुक्षिः स्तनयन्नुदन्वान्।\nउत्सृष्टदीर्घोर्मिकरैरिवार्तश्चुक्रोश यज्ञेश्वर पाहि मेति॥ ३/१४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.038.m4a", "display_order": 39}, {"id": 6000044039, "chapter_id": 10044, "verse_number": "३-१४-३२", "content_sanskrit": "खुरैः क्षुरप्रैर्दरयंस्तदाप उत्पारवारं त्रिवरू रसायाम्।\nददर्श गां तत्र सुषुप्सुरग्रे यां जीवधानीं स्वयमभ्यधत्त॥ ३/१४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.039.m4a", "display_order": 40}, {"id": 6000044040, "chapter_id": 10044, "verse_number": "३-१४-३३", "content_sanskrit": "स्वदंष्ट्रयोद्धृत्य महीं विलग्नां स उत्थितः संरुरुहे रसायाः।\nतत्रापि दैत्यं गदयाऽऽपतन्तं सुनाभसन्दीपिततीव्रमन्युः॥ ३/१४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.040.m4a", "display_order": 41}, {"id": 6000044041, "chapter_id": 10044, "verse_number": "३-१४-३४", "content_sanskrit": "जघान रुन्धानमसह्यविक्रमः सलीलयेभं मृगराडिवाम्भसि।\nतद्रक्तपङ्काङ्किततुण्डगण्डो यथा गजेन्द्रो जगतीं विभिन्दन्॥ ३/१४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.041.m4a", "display_order": 42}, {"id": 6000044042, "chapter_id": 10044, "verse_number": "३-१४-३५", "content_sanskrit": "तमालनीलं सितदन्तकोट्या क्ष्मामुत्क्षिपन्तं गजलीलयाऽङ्ग।\nप्रज्ञाय बद्धाञ्जलयोऽनुवाकैर्विरिञ्चमुख्या उपतस्थुरीशम्॥ ३/१४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.042.m4a", "display_order": 43, "topics": [{"text": "वराहस्तुतिः", "range": "३५–५२"}]}, {"id": 6000044043, "chapter_id": 10044, "verse_number": null, "content_sanskrit": "देवा ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.043.m4a", "display_order": 44}, {"id": 6000044044, "chapter_id": 10044, "verse_number": "३-१४-३६", "content_sanskrit": "जितं जितं तेऽजित यज्ञभावन त्रयीतनुं स्वां परिधुन्वते नमः।\nयल्लोमगर्तेषु निलिल्युरब्धयस्तस्मै नमः कारणसूकराय ते॥ ३/१४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.044.m4a", "display_order": 45}, {"id": 6000044045, "chapter_id": 10044, "verse_number": "३-१४-३७", "content_sanskrit": "रूपं तवैतन्ननु दुष्कृतात्मनां दुर्दर्शनं देव यदध्वरात्मकम्।\nछन्दांसि यस्य त्वचि बर्हिरोम स्वाज्यं दृशि त्वङ्घ्रिषु चातुर्होत्रम्॥ ३/१४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.045.m4a", "display_order": 46}, {"id": 6000044046, "chapter_id": 10044, "verse_number": "३-१४-३८", "content_sanskrit": "स्रुक् तुण्ड आसीत् स्रुव ईश नासयोरिडोदरे चमसः कर्णरन्ध्रे।\nप्राशित्रमास्ये रसने ग्रहास्तु यच्चर्वणं ते भगवन्नग्निहोत्रम्॥ ३/१४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.046.m4a", "display_order": 47}, {"id": 6000044047, "chapter_id": 10044, "verse_number": "३-१४-३९", "content_sanskrit": "दीक्षात्मजन्मोपसदः शिरोधस्त्वं प्रायणीयोदयनीयदंष्ट्रः।\nजिह्वा प्रवर्ग्यस्तव शीर्षणं क्रतुः सभ्यावसथ्यौ चितयोऽसवो हि ते॥ ३/१४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.047.m4a", "display_order": 48}, {"id": 6000044048, "chapter_id": 10044, "verse_number": "३-१४-४०", "content_sanskrit": "सोमस्तु रेतः सवनान्यवस्थितिः संस्थाविभेदास्तव देहधातवः।\nसत्राणि सर्वाणि शरीरसन्धिस्त्वं सर्वयज्ञक्रतुरिष्टिबन्धनः॥ ३/१४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.048.m4a", "display_order": 49}, {"id": 6000044049, "chapter_id": 10044, "verse_number": "३-१४-४१", "content_sanskrit": "नमो नमस्तेऽखिलमन्त्रदेवताद्रव्याय सर्वक्रतवे क्रियात्मने।\nवैराग्यभक्त्याऽऽत्मजयानुभावितज्ञानाय विद्यागुरवे नमो नमः॥ ३/१४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.049.m4a", "display_order": 50}, {"id": 6000044050, "chapter_id": 10044, "verse_number": "३-१४-४२", "content_sanskrit": "दंष्ट्राग्रकोट्या भगवंस्त्वया धृता विराजते भूधर भूः सभूधरा।\nयथा वनान्निस्सरतो दता धृता मतङ्गजेन्द्रस्य सपत्रपद्मिनी॥ ३/१४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.050.m4a", "display_order": 51}, {"id": 6000044051, "chapter_id": 10044, "verse_number": "३-१४-४३", "content_sanskrit": "त्रयीमयं रूपमिदं च सौकरं भूमण्डलं नाथ दता धृतेन ते।\nचकास्ति शृृङ्गोढघनेन भूयसा कुलाचलेन्द्रस्य यथैव विभ्रमः॥ ३/१४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.051.m4a", "display_order": 52}, {"id": 6000044052, "chapter_id": 10044, "verse_number": "३-१४-४४", "content_sanskrit": "संस्थापयैनां जगतां सतस्थुषां हिताय पत्नीमसि मातरं पिता।\nविधेम यस्यै नमसा सह त्वया यस्यां स्वतेजोऽग्निमिवारणावधाः॥ ३/१४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.052.m4a", "display_order": 53}, {"id": 6000044053, "chapter_id": 10044, "verse_number": "३-१४-४५", "content_sanskrit": "कः श्रद्धधीतान्यतमस्तव प्रभो रसां गताया भुव उद्विबर्हणम्।\nन विस्मयोऽसौ त्वयि विश्वविस्मये यो माययेदं ससृजेऽतिविस्मयः॥ ३/१४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.053.m4a", "display_order": 54}, {"id": 6000044054, "chapter_id": 10044, "verse_number": "३-१४-४६", "content_sanskrit": "विधुन्वता वेदमयं निजं वपुर्जनस्तपस्सत्यनिवासिनो वयम्।\nसटाशिखोद्धूतशिवाम्बुबिन्दुभिर्विमृज्यमाना भृशमीश पाविताः॥ ३/१४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.054.m4a", "display_order": 55}, {"id": 6000044055, "chapter_id": 10044, "verse_number": "३-१४-४७", "content_sanskrit": "स वै बत भ्रष्टमतिस्तवैषते यः कर्मणां पारमपारकर्मणः।\nत्वद्योगमायागुणमोहितात्मनां विस्रंसतां नो भगवन् विधेहि शम्॥ ३/१४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.055.m4a", "display_order": 56}, {"id": 6000044056, "chapter_id": 10044, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.056.m4a", "display_order": 57}, {"id": 6000044057, "chapter_id": 10044, "verse_number": "३-१४-४८", "content_sanskrit": "प्रत्युपस्थीयमानस्तैर्मुनिभिर्ब्रह्मवादिभिः।\nसलिले स्वखुराक्रान्त उपादत्ताविताऽवनिम्॥ ३/१४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.057.m4a", "display_order": 58}, {"id": 6000044058, "chapter_id": 10044, "verse_number": "३-१४-४९", "content_sanskrit": "स इत्थं भगवानुर्वीं विश्वक्सेनः प्रजापतिः।\nरसाया लीलयोन्नीतामप्सु न्यस्य ययौ हरिः॥ ३/१४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.058.m4a", "display_order": 59}, {"id": 6000044059, "chapter_id": 10044, "verse_number": "३-१४-५०", "content_sanskrit": "य एवमेतां हरिमेधसो हरेः कथां सुभद्रां कथनीयमायिनः।\nशृण्वीत भक्त्या श्रवयेत वोशतीं जनार्दनोऽस्याशु हृदि प्रसीदति॥ ३/१४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.059.m4a", "display_order": 60}, {"id": 6000044060, "chapter_id": 10044, "verse_number": "३-१४-५१", "content_sanskrit": "तस्मिन् प्रसन्ने सकलाशिषां प्रभौ किं दुर्लभं ताभिरलं लवात्मभिः।\nअनन्यभक्त्या भजतां गुहाशयः स्वयं विधत्ते स्वगतिं परः पुमान्॥ ३/१४/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.060.m4a", "display_order": 61}, {"id": 6000044061, "chapter_id": 10044, "verse_number": "३-१४-५२", "content_sanskrit": "को नाम लोके पुरुषार्थसारवित् पुराकथानां भगवत्कथासुधाम्।\nआपीय कर्णाञ्जलिभिर्भवापहामहो विरज्येत विना नरेतरम्॥ ३/१४/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_014/BhP_03.014.061.m4a", "display_order": 62}, {"id": 6000044062, "chapter_id": 10044, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे चतुर्दशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]