[{"id": 7000298000, "chapter_id": 20298, "verse_number": "१-५२-१", "content_sanskrit": "द्विज उवाच ।\nमांडव्यस्य मुनेर्विष्णोश्शूलाघातः कथं तनौ ।\nपत्यौ पतिव्रतायाश्च कथं कुष्ठं कलेवरे॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000298001, "chapter_id": 20298, "verse_number": "१-५२-२", "content_sanskrit": "हरिरुवाच ।\nशिशुभावाच्च मांडव्यो झिल्लिकायामभानतः ।\nवस्तिदेशे तृणं दत्वा मोहात्स च मुमोच ताम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000298002, "chapter_id": 20298, "verse_number": "१-५२-३", "content_sanskrit": "तेनापवाददोषेण धर्मस्याज्ञातुरेव च ।\nअहोरात्रं व्यथा कृच्छ्रा भुक्ता तेन द्विजन्मना॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000298003, "chapter_id": 20298, "verse_number": "१-५२-४", "content_sanskrit": "किंतु समाधिना तेन न ज्ञातं शूलसंभवम् ।\nकृच्छ्रं च मुनिना कृत्स्नं योगाभ्यासाद्भृशादपि॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000298004, "chapter_id": 20298, "verse_number": "१-५२-५", "content_sanskrit": "कुष्ठिनो ब्रह्मणो घातादजितेंद्रियकारणात् ।\nपूतिगंधं तनौ कुष्ठं संजातं द्विजसत्तम॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000298005, "chapter_id": 20298, "verse_number": "१-५२-६", "content_sanskrit": "पुरा विप्राय तेनैव दत्तं गौरीचतुष्टयम् ।\nकन्यकात्रितयं विप्र तेन तस्य पतिव्रता॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000298006, "chapter_id": 20298, "verse_number": "१-५२-७", "content_sanskrit": "अस्यास्तु कारणादेव स च मत्समतां व्रजेत् ।\nअत्र ते विस्मयः कुत्र वेदकर्मपुरातनम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000298007, "chapter_id": 20298, "verse_number": "१-५२-८", "content_sanskrit": "द्विज उवाच ।\nकृत्या नारी न यस्यैव तस्य स्वर्गो भवेद्ध्रुवम् ।\nयथैतच्चरितं नाथ सर्वेषां शिवमिष्यते॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000298008, "chapter_id": 20298, "verse_number": "१-५२-९", "content_sanskrit": "हरिरुवाच ।\nसंति कृत्याः स्त्रियः काश्चित्पुंसः सर्वस्वदस्य च ।\nतत्राप्यरक्षणीयां च मनसापि न धारयेत्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000298009, "chapter_id": 20298, "verse_number": "१-५२-१०", "content_sanskrit": "न स्त्रीणामप्रियः कश्चित्प्रियो वापि न विद्यते ।\nगावस्तृणमिवारण्ये प्रार्थयंति नवंनवम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000298010, "chapter_id": 20298, "verse_number": "१-५२-११", "content_sanskrit": "पुमांसं वित्तहीनं च विरूपं गुणवर्जितम् ।\nअकुलीनं च भृत्यं च कामिनी भजते ध्रुवम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000298011, "chapter_id": 20298, "verse_number": "१-५२-१२", "content_sanskrit": "भर्तारं च गुणोपेतं कुलीनं च महाधनम् ।\nसुंदरं रतिदक्षं च त्यक्त्वा नीचं भजेद्वधूः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000298012, "chapter_id": 20298, "verse_number": "१-५२-१३", "content_sanskrit": "उमानारदसंवादमाख्यानं विद्धि भूसुर ।\nयेन विद्यास्त्रियाश्चेष्टा विविधाः कृत्स्नशो द्विज॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000298013, "chapter_id": 20298, "verse_number": "१-५२-१४", "content_sanskrit": "स्वभावान्नारदो विप्र विश्वजिज्ञासको मुनिः ।\nस्वांते विमृश्याथ गतः कैलासं गिरिमुत्तमम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000298014, "chapter_id": 20298, "verse_number": "१-५२-१५", "content_sanskrit": "वृषकेतुसदाख्यान सप्रतिष्ठे हिमे गिरौ ।\nप्रणिपत्य महात्मा वै पप्रच्छ पार्वतीं मुनिः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000298015, "chapter_id": 20298, "verse_number": "१-५२-१६", "content_sanskrit": "देवि सीमंतिनीनांतु दुश्चेष्टां ज्ञातुमुत्सहे ।\nकौतुकेन त्वया चर्या वधूनां संप्रयुज्यते॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000298016, "chapter_id": 20298, "verse_number": "१-५२-१७", "content_sanskrit": "सर्वासामपि नारीणां स्वान्तं जानासि तत्त्वतः ।\nतन्मां कथय सर्वेषु विनीतमज्ञमत्र च॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000298017, "chapter_id": 20298, "verse_number": "१-५२-१८", "content_sanskrit": "देव्युवाच ।\nयुवतीनां सदा चित्तं पुंसु तिष्ठत्यसंशयम् ।\nअस्मिन्योनौ सुसंयोग्ये संगते वाप्यसंगते॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000298018, "chapter_id": 20298, "verse_number": "१-५२-१९", "content_sanskrit": "सुवेषं पुरुषं दृष्ट्वा भ्रातरं यदि वा सुतम् ।\nयोनिः क्लिद्यति नारीणां सत्यं सत्यं हि नारद॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000298019, "chapter_id": 20298, "verse_number": "१-५२-२०", "content_sanskrit": "स्थानं नास्ति क्षणं नास्ति नास्ति प्रार्थयिता नरः ।\nतेन नारद नारीणां सतीत्वमुपजायते॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000298020, "chapter_id": 20298, "verse_number": "१-५२-२१", "content_sanskrit": "घृतकुंभसमा नारी तप्तांगारसमः पुमान् ।\nतस्माद्घृतं च वह्निं च नैकस्थाने च धारयेत्॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000298021, "chapter_id": 20298, "verse_number": "१-५२-२२", "content_sanskrit": "यथैवमत्तमातंगं सृणिमुद्गरयोगतः ।\nस्ववशं कुरुते यंता तथा स्त्रीणां प्ररक्षकः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000298022, "chapter_id": 20298, "verse_number": "१-५२-२३", "content_sanskrit": "पिता रक्षति कौमारे भर्ता रक्षति यौवने ।\nपुत्राश्च स्थाविरे भावे न स्त्री स्वातंत्र्यमर्हति॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000298023, "chapter_id": 20298, "verse_number": "१-५२-२४", "content_sanskrit": "ततः स्वातंत्र्यभावाच्च स्वेच्छया च वरांगना ।\nपुरुषेणार्थिता धीरा प्रेरणादिचरी भवेत्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000298024, "chapter_id": 20298, "verse_number": "१-५२-२५", "content_sanskrit": "अरक्षणाद्यथा पाकः श्वकाकवशगो भवेत् ।\nतथैव युवती नारी स्वच्छंदाद्दुष्टतां व्रजेत्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000298025, "chapter_id": 20298, "verse_number": "१-५२-२६", "content_sanskrit": "पुनरेव कुलं दुष्टं तस्यास्संसर्गतो भवेत् ।\nपरबीजेन यो जातः स च स्याद्वर्णसंकरः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000298026, "chapter_id": 20298, "verse_number": "१-५२-२७", "content_sanskrit": "जारजः संकरः पापो नरके नियतं वसेत् ।\nकीटजातौ गता जाताः पुनः सर्वे महीतले॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000298027, "chapter_id": 20298, "verse_number": "१-५२-२८", "content_sanskrit": "ततो म्लेच्छमुपानीतं कुलं स्याद्द्विजनंदन ।\nकुलक्षयो भवेद्यस्मात्तस्माद्दुष्टां न धारयेत्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000298028, "chapter_id": 20298, "verse_number": "१-५२-२९", "content_sanskrit": "ज्ञात्वैव योषितां दोषं क्षमते यो नराधमः ।\nस तिष्ठेन्निरये घोरे रौरवे पितृभिः सह॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000298029, "chapter_id": 20298, "verse_number": "१-५२-३०", "content_sanskrit": "काचित्पातयते नारी काचिदुद्धरते कुलम् ।\nतस्मात्सर्वप्रयत्नेन कुलजामुद्वहेद्बुधः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000298030, "chapter_id": 20298, "verse_number": "१-५२-३१", "content_sanskrit": "कुलद्वयं समा नारी समयित्वा तु तिष्ठति ।\nसाध्वी तारयते वंशान्दुष्टा पातयति ध्रुवम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000298031, "chapter_id": 20298, "verse_number": "१-५२-३२", "content_sanskrit": "दारेष्वधीनं स्वर्गं च कुलं पंकं यशोऽयशः ।\nपुत्रं दुहितरं मित्रं संसारे कथयंति च॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000298032, "chapter_id": 20298, "verse_number": "१-५२-३३", "content_sanskrit": "तस्मादेकां द्वितीयां वा वामामुद्वाहयेद्बुधः ।\nसंतानार्थात्तु कामाच्च बहुदोषाश्रिता च सा॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000298033, "chapter_id": 20298, "verse_number": "१-५२-३४", "content_sanskrit": "रजस्वलां च वनितां नावगच्छति यः पतिः ।\nब्रह्महा भ्रूणहा सोपि दुर्गतिं चाधिगच्छति॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000298034, "chapter_id": 20298, "verse_number": "१-५२-३५", "content_sanskrit": "यो मोहाद्दुर्भगां कृत्वा साध्वीं त्यजति पापकृत् ।\nतस्या वधेन यत्पापं तद्भुक्त्वा नरकं व्रजेत्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000298035, "chapter_id": 20298, "verse_number": "१-५२-३६", "content_sanskrit": "वनिताहरणं कृत्वा चांडलकुलतां व्रजेत् ।\nतथैव वनिताहानात्पतितो जायते नरः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000298036, "chapter_id": 20298, "verse_number": "१-५२-३७", "content_sanskrit": "रामां विन्यस्य स्कंधे च चिरं यमपुरे वसेत् ।\nमलमूत्रं शिरोदेशे नित्यं तस्य च संपतेत्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000298037, "chapter_id": 20298, "verse_number": "१-५२-३८", "content_sanskrit": "एवं वर्षसहस्राणि भारं वहति दुर्मतिः ।\nपुनर्यावन्ति लोमानि तावत्स रौरवं व्रजेत्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000298038, "chapter_id": 20298, "verse_number": "१-५२-३९", "content_sanskrit": "पुनः कीटेषु संतीर्णस्तदा मानुषतां व्रजेत् ।\nततश्च कलहं शोकं प्राप्नोति पूर्वकल्मषात्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000298039, "chapter_id": 20298, "verse_number": "१-५२-४०", "content_sanskrit": "एवं जन्मत्रयं प्राप्य मुच्यते पातकान्नरः ।\nतत्कालं नरकं भुक्त्वा सा तु काकी तु वञ्चकी॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000298040, "chapter_id": 20298, "verse_number": "१-५२-४१", "content_sanskrit": "उच्छिष्टनरकं भुक्त्वा मानुषे विधवा भवेत् ।\nयः पुनश्चांत्यजां गच्छेन्म्लेछां वा पुल्कसां नरः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000298041, "chapter_id": 20298, "verse_number": "१-५२-४२", "content_sanskrit": "द्वित्रिचतुर्गुणं भुक्त्वा तत्र संचीर्णवंचकः ।\nमातरं गुरुभार्यां च ब्राह्मणीं महिषीं तथा॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000298042, "chapter_id": 20298, "verse_number": "१-५२-४३", "content_sanskrit": "अन्यां वा प्रभुपत्नीं च गत्वा यात्यपुनर्भवं ।\nभगिनीं तत्पुत्रभार्यां तथा दुहितरं स्नुषाम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000298043, "chapter_id": 20298, "verse_number": "१-५२-४४", "content_sanskrit": "पितृव्यां मातुलानीं तु तथैव च पितृष्वसाम् ।\nमातृष्वस्रादिकामन्यां गत्वा नास्ति च निष्कृतिः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000298044, "chapter_id": 20298, "verse_number": "१-५२-४५", "content_sanskrit": "ब्रह्महा स भवेदंधो वचसा जडतां व्रजेत् ।\nकर्णयोर्बधिरो जातश्च्यवते नास्ति निष्कृतिः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000298045, "chapter_id": 20298, "verse_number": "१-५२-४६", "content_sanskrit": "उक्त्वा अश्लीलमत्यर्थमखिलं स्त्रीकृतेन हि ।\nद्विज उवाच ।\nएवं दुष्कृतमासाद्य कथं मोक्षो भवेत्पुनः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000298046, "chapter_id": 20298, "verse_number": "१-५२-४७", "content_sanskrit": "तत्समाचक्ष्व भगवन्श्रोतुमिच्छामि तत्त्वतः ।\nश्रीभगवानुवाच ।\nतासां च गमनं कृत्वा तप्तां लोहस्य पुत्तलद्यं॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000298047, "chapter_id": 20298, "verse_number": "१-५२-४८", "content_sanskrit": "समालिंग्य त्यजेत्प्राणं शुचिर्लोकांतरं व्रजेत् ।\nयो वै गृहाश्रमं त्यक्त्वा मच्चित्तो जायते नरः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000298048, "chapter_id": 20298, "verse_number": "१-५२-४९", "content_sanskrit": "नित्यं स्मरति गोविंदं सर्वपापक्षयो भवेत् ।\nब्रह्महत्यायुतं तेन कृतं गुर्वंगनागमात्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000298049, "chapter_id": 20298, "verse_number": "१-५२-५०", "content_sanskrit": "शतं शतसहस्रं च पैष्टीमद्यस्य भक्षणात् ।\nस्वर्णादेर्हरणं कृत्वा तेषां संसर्गकं चिरं॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000298050, "chapter_id": 20298, "verse_number": "१-५२-५१", "content_sanskrit": "एतान्यन्यानि पापानि महान्ति पातकानि च ।\nअग्निं प्राप्य यथा तूलं तृणं शुष्कं प्रणश्यति॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000298051, "chapter_id": 20298, "verse_number": "१-५२-५२", "content_sanskrit": "तस्मान्मन्नामगोविंदं स्मृत्वा पूतो भवेन्नरः ।\nयो वा गृहाश्रमे तिष्ठेन्नित्यं गोविंदघोषणम्॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000298052, "chapter_id": 20298, "verse_number": "१-५२-५३", "content_sanskrit": "कृत्वा च पूजयित्वा च स पापात्सन्तरो भवेत् ।\nभागीरथी तटे रम्ये खगस्य ग्रहणे शिवे॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000298053, "chapter_id": 20298, "verse_number": "१-५२-५४", "content_sanskrit": "गवां कोटिप्रदानेन यत्फलं लभते नरः ।\nतत्फलं समवाप्नोति सहस्रं चाधिकं च यत्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000298054, "chapter_id": 20298, "verse_number": "१-५२-५५", "content_sanskrit": "गोविंदकीर्तने तात मत्पुरे चाक्षयं वसेत् ।\nकामात्स भवने स्थित्वा सार्वभौमो भवेन्नृपः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000298055, "chapter_id": 20298, "verse_number": "१-५२-५६", "content_sanskrit": "पुराणेमत्कथां श्रुत्वा मत्सादृश्यं लभेन्नरः ।\nकथयित्वा पुराणं च विष्णुसायुज्यतां व्रजेत्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000298056, "chapter_id": 20298, "verse_number": "१-५२-५७", "content_sanskrit": "तस्मान्नित्यं च श्रोतव्यं पुराणं धर्मसंचयं ।\nश्रावितव्यं प्रयत्नेन लोके विष्णुतनुं व्रजेत्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000298057, "chapter_id": 20298, "verse_number": "१-५२-५८", "content_sanskrit": "अन्यद्वा स्त्रीकृते दोषे यथायोगं भवेद्ध्रुवं ।\nनिशामय प्रवक्ष्यामि तत्वतो द्विजनंदन॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000298058, "chapter_id": 20298, "verse_number": "१-५२-५९", "content_sanskrit": "सर्वबीजस्य दानेन सांबुकुंभं महाफलम् ।\nदद्याद्विप्राय पुण्याहे सद्यःपूतो भवेत्क्षणात्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000298059, "chapter_id": 20298, "verse_number": "१-५२-६०", "content_sanskrit": "सर्वं धान्यादिकं बीजं काले दद्याद्द्विजातये ।\nसर्वपापक्षयं कृत्वा अक्षयं स्वर्गमश्नुते॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000298060, "chapter_id": 20298, "verse_number": "१-५२-६१", "content_sanskrit": "गुणं वक्ष्यामि विप्रर्षे सतीनां यादृशं दृढम् ।\nशुद्धवंशो भवेत्तस्या नित्यं लक्ष्मीः प्रवर्तते॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000298061, "chapter_id": 20298, "verse_number": "१-५२-६२", "content_sanskrit": "उभयोर्वंशयोः स्वर्गो भर्तुरात्मन एव च ।\nपतिव्रतागुणो विप्र विस्मृतः पृच्छतस्तव॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000298062, "chapter_id": 20298, "verse_number": "१-५२-६३", "content_sanskrit": "पुनर्वक्ष्यामि योषाणां सर्वलोकहितं शुभम् ।\nउषित्वा पूर्वकालं च पुण्यापुण्येन योषितः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000298063, "chapter_id": 20298, "verse_number": "१-५२-६४", "content_sanskrit": "पश्चात्पतिव्रतायाश्च ताश्च गच्छंति मद्गतिम् ।\nषण्मासं वाथ वर्षं वा अधिकं च प्रशस्यते॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000298064, "chapter_id": 20298, "verse_number": "१-५२-६५", "content_sanskrit": "पतिव्रता भवेद्या च यावत्पूता व्रजेद्दिवम् ।\nसुरापं विप्रहंतारं सर्वपापयुतं पतिम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000298065, "chapter_id": 20298, "verse_number": "१-५२-६६", "content_sanskrit": "पंकात्पूतं नयेत्स्वर्गं भर्त्तांरं यानुगच्छति ।\nकंदर्पसदृशो भर्ता सा रतीव मनोरमा॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000298066, "chapter_id": 20298, "verse_number": "१-५२-६७", "content_sanskrit": "जिष्णोरेवचिरं लोके भुंक्तेऽनंतमयं सुखम् ।\nपतिव्रता बलाद्या च विदूरे स्वामिपातने॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000298067, "chapter_id": 20298, "verse_number": "१-५२-६८", "content_sanskrit": "चिह्नं लब्ध्वामृता वह्नौ पापादुद्धरते पतिं ।\nपतिव्रता च या नारी देशांतरमृते पतौ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000298068, "chapter_id": 20298, "verse_number": "१-५२-६९", "content_sanskrit": "सा भर्तुश्चिह्नमादाय वह्नौ सुप्त्वा दिवं व्रजेत् ।\nया स्त्री ब्राह्मणजातीया मृतं पतिमनुव्रजेत्॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000298069, "chapter_id": 20298, "verse_number": "१-५२-७०", "content_sanskrit": "सा स्वर्गमात्मघातेन नात्मानं न पतिं नयेत् ।\nन म्रियेत समं गत्वा ब्राह्मणी ब्रह्मशासनात्॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000298070, "chapter_id": 20298, "verse_number": "१-५२-७१", "content_sanskrit": "प्रव्रज्यागतिमाप्नोति मरणादात्मघातिनी ।\nनरोत्तम उवाच ।\nसर्वासामपि जातीनां ब्राह्मणः शस्य इष्यते॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000298071, "chapter_id": 20298, "verse_number": "१-५२-७२", "content_sanskrit": "पुण्यं च द्विजमुख्येन अत्र किंवा विपर्ययः ।\nश्रीभगवानुवाच ।\nब्राह्मण्यास्साहसं कर्म नैव युक्तं कदाचन॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000298072, "chapter_id": 20298, "verse_number": "१-५२-७३", "content_sanskrit": "निःशेषेस्या वधं कृत्वा स नरो ब्रह्महा भवेत् ।\nतस्माद्ब्राह्मणजातीया विप्रया च व्रतं चरेत्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000298073, "chapter_id": 20298, "verse_number": "१-५२-७४", "content_sanskrit": "प्रवक्ष्यामि यथातथ्यं शृणु विप्र यथार्थतः ।\nआपणांतरमामिष्यं भक्षयेन्न कदाचन॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000298074, "chapter_id": 20298, "verse_number": "१-५२-७५", "content_sanskrit": "अश्वमेधसहस्राणां हायने फलमाप्नुयात् ।\nअर्हणं चेष्टदेवस्य हरेर्व्रतमनुत्तमम्॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000298075, "chapter_id": 20298, "verse_number": "१-५२-७६", "content_sanskrit": "स्वामिनोपि जलं पिंडं संप्रदद्यादमत्सरात् ।\nयुगकोटिसहस्राणि युगकोटिशतानि च॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000298076, "chapter_id": 20298, "verse_number": "१-५२-७७", "content_sanskrit": "पतिना सह सा साध्वी विष्णुलोके युता भवेत् ।\nततो महाव्रतं प्राप्य निरये ब्राह्मणी वधूः॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000298077, "chapter_id": 20298, "verse_number": "१-५२-७८", "content_sanskrit": "उद्धरेदुभयोर्वंशाञ्छतशोथ सहस्रशः ।\nअतो बंधुजनैरेव पुत्रैर्भ्रात्रादिभिर्बुधैः॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000298078, "chapter_id": 20298, "verse_number": "१-५२-७९", "content_sanskrit": "विनियम्य सदा तस्या व्रतलोपं न कारयेत् ।\nहरेश्चेद्वासरं प्राप्य विधवा न व्रतं चरेत्॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000298079, "chapter_id": 20298, "verse_number": "१-५२-८०", "content_sanskrit": "पुनर्वैधव्यतामेति जन्मजन्मनि दुर्भगा ।\nभोजनात्मत्स्यमांसस्य व्रतानां विप्रयोगतः॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000298080, "chapter_id": 20298, "verse_number": "१-५२-८१", "content_sanskrit": "चिरं निरयमासाद्य शुनी भवति निश्चितम् ।\nदुष्टाया मैथुनं गच्छेद्विधवाकुलनाशिनी॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000298081, "chapter_id": 20298, "verse_number": "१-५२-८२", "content_sanskrit": "नरकाननुभूयाथ गृध्रिणी दशजन्मसु ।\nद्विजन्मफेरवा भूत्वा ततो मानुषतां व्रजेत्॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000298082, "chapter_id": 20298, "verse_number": "१-५२-८३", "content_sanskrit": "तथैव बालवैधव्या दासीत्वमुपगच्छति ।\nद्विज उवाच ।\nकन्यादानफलं ब्रूहि वद दास्याः फलं च यत्॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000298083, "chapter_id": 20298, "verse_number": "१-५२-८४", "content_sanskrit": "विधानं च यथोक्तं च यदि मेनुग्रहः प्रभो ।\nश्रीभगवानुवाच ।\nरूपाढ्ये गुणसंपन्ने कुलीने यौवनान्विते॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000298084, "chapter_id": 20298, "verse_number": "१-५२-८५", "content_sanskrit": "समृद्धे वित्तसंपूर्णे कन्यादानफलं शृणु ।\nसर्वाभरणसंयुक्तां कन्यकां यो ददाति च॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000298085, "chapter_id": 20298, "verse_number": "१-५२-८६", "content_sanskrit": "तेन दत्ता धरा सर्वा सशैलवनकानना ।\nअर्द्धाभरणदानेन फलं दातुर्भवेद्ध्रुवम्॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000298086, "chapter_id": 20298, "verse_number": "१-५२-८७", "content_sanskrit": "अनाभरणकन्यायाः पादैकस्य फलं भवेत् ।\nयः पुनः शुल्कमश्नाति स याति नरके नरः॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000298087, "chapter_id": 20298, "verse_number": "१-५२-८८", "content_sanskrit": "विक्रीय चात्मजां मूढो नरकान्न निवर्त्तते ।\nलोभादसदृशे पुंसि कन्यां यस्तु प्रयच्छति॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000298088, "chapter_id": 20298, "verse_number": "१-५२-८९", "content_sanskrit": "रौरवं नरकं प्राप्य चांडालत्वं च गच्छति ।\nअतएव हि शुल्कं च जामातुर्न कदाचन॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000298089, "chapter_id": 20298, "verse_number": "१-५२-९०", "content_sanskrit": "गृह्णाति मनसा प्राज्ञो यद्दत्तं तस्य चाक्षयम् ।\nभूमिं गां च हिरण्यं च धनं वस्त्रं च धान्यकम्॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000298090, "chapter_id": 20298, "verse_number": "१-५२-९१", "content_sanskrit": "जामातुर्यौतकं दत्वा सर्वं भवति चाक्षयम् ।\nविवाहसमये वत्स सगोत्र परगोत्रजैः॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000298091, "chapter_id": 20298, "verse_number": "१-५२-९२", "content_sanskrit": "यौतकं दीयते किंचित्तत्सर्वं चाक्षयं भवेत् ।\nदाता न स्मरते दानं प्रतिग्राही न याचते॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000298092, "chapter_id": 20298, "verse_number": "१-५२-९३", "content_sanskrit": "उभौ तौ नरकं यातश्छिन्नरज्जुर्घटो यथा ।\nअवश्यं यौतकं दानं दातव्यं सात्विकेन हि॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000298093, "chapter_id": 20298, "verse_number": "१-५२-९४", "content_sanskrit": "अदत्वा नरकं प्राप्य दासीत्वमुपगच्छति ।\nअत्यासन्नेतिदूरस्थे चात्याढ्ये चाति दुर्गते॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000298094, "chapter_id": 20298, "verse_number": "१-५२-९५", "content_sanskrit": "कुलहीने च मूर्खे च षट्सु कन्या न दीयते ।\nअतिवृद्धे चातिदीने रोगिष्ठे देशवासिनि॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000298095, "chapter_id": 20298, "verse_number": "१-५२-९६", "content_sanskrit": "अतिक्रुद्धेप्यसन्तुष्टे षट्सु कन्या न दीयते ।\nएतेभ्यः कन्यकां दत्वा नरकं चाधिगच्छति॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000298096, "chapter_id": 20298, "verse_number": "१-५२-९७", "content_sanskrit": "लोभात्संमानलाभाच्च कन्यका परिवर्तनात् ।\nमुनीनां प्रेयसीं नारीं युवतीं रूपशालिनीम्॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000298097, "chapter_id": 20298, "verse_number": "१-५२-९८", "content_sanskrit": "सालंकारां सशय्यां च दत्वाऽनंतफलं लभेत् ।\nअनयोश्च फलं तुभ्यं युवती कन्ययोरपि॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000298098, "chapter_id": 20298, "verse_number": "१-५२-९९", "content_sanskrit": "एका वराय दातव्या अपरा ब्राह्मणाय तु ।\nक्रीता देवा यदातव्या धीरेणाकष्टकर्मणा॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000298099, "chapter_id": 20298, "verse_number": "१-५२-१००", "content_sanskrit": "कल्पकालं भवेत्स्वर्गं नृपो वा कौ महाधनी ।\nप्रतिजन्म लभेतैष सुपत्नीं वरवर्णिनीम्॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000298100, "chapter_id": 20298, "verse_number": "१-५२-१०१", "content_sanskrit": "य इदं शृणुयान्नित्यं पुण्याख्यानमनुत्तमम् ।\nसर्वपापक्षयस्तस्य सर्वशास्त्रार्थपारगः॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000298101, "chapter_id": 20298, "verse_number": "१-५२-१०२", "content_sanskrit": "लभेत सोऽक्षयं स्वर्गं नारीणां वल्लभो भवेत् ।\nक्षत्रियो विजयी चाथ लोकनाथो भवेद्ध्रुवम्॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000298102, "chapter_id": 20298, "verse_number": "१-५२-१०३", "content_sanskrit": "श्रुतं हरति पापानि जन्मजन्मकृतानि च ।\nसौभाग्यं लभते लोके तथैव च वरांगना॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}]