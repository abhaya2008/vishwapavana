[{"id": 2018206, "chapter_id": 1377, "verse_number": "३-१५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2018207, "chapter_id": 1377, "verse_number": "३-१५-१", "content_sanskrit": "वासुदेव महाबाहो विस्तरेण महामते।\nसौभस्य वधमाचक्ष्व न हि तृष्यामि कथ्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2018208, "chapter_id": 1377, "verse_number": "३-१५-२x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2018209, "chapter_id": 1377, "verse_number": "३-१५-२", "content_sanskrit": "हतं श्रुत्वा महाबाहौ मया श्रौतश्रवं नृप।\nउपायाद्भरतश्रेष्ठ साल्वो द्वारवतीं पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2018210, "chapter_id": 1377, "verse_number": "३-१५-३", "content_sanskrit": "अरुणत्तां सुदुष्टात्मा सर्वतः पाण्डुनन्दन।\nसाल्वो वैहायसं चापि तत्पुरं व्यूह्य धिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2018211, "chapter_id": 1377, "verse_number": "३-१५-४", "content_sanskrit": "तत्रस्थोऽथ महीपालो योधयामास तां पुरीम्।\nअभिसारेण सर्वेण तत्र युद्धमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2018212, "chapter_id": 1377, "verse_number": "३-१५-५", "content_sanskrit": "पुरी समन्ताद्विहिता सपताका सतोरणा।\nसचक्रा सहुडा चैव सयन्त्रखनका तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2018213, "chapter_id": 1377, "verse_number": "३-१५-६", "content_sanskrit": "सोपशल्यप्रतोलीका साट्टाट्टालकगोपुरा।\nसचक्रग्रहिणी चैव सोल्कालातावपोथिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2018214, "chapter_id": 1377, "verse_number": "३-१५-७", "content_sanskrit": "सोष्टिका भरतश्रेष्ठ सभेरीपणवानका।\nसतोमराङ्कुशा राजन्सशतघ्नीकलाङ्गला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2018215, "chapter_id": 1377, "verse_number": "३-१५-८", "content_sanskrit": "सभुशुण्ड्यश्मगुडका सायुधा सपरश्वधा।\nलोहचर्मवती चापि साग्निः सगुडशृङ्गिका।\nशास्त्रदृष्टेन विधिना सुयुक्ता भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2018216, "chapter_id": 1377, "verse_number": "३-१५-९", "content_sanskrit": "रथैरनेकैर्विविधैर्गदसाम्बोद्धवादिभिः।\nपुरुषैः कुरुशार्दूल समर्थैः प्रतिवारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2018217, "chapter_id": 1377, "verse_number": "३-१५-१०", "content_sanskrit": "अतिख्यातकुलैर्वीरैर्दृष्टवीर्यैश्च संयुगे।\nमध्यमेन च गुल्मेन रक्षिभिः सा सुरक्षिता।\nउत्क्षिप्तगुल्मैश्च तथा हयैश्च सपताकिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2018218, "chapter_id": 1377, "verse_number": "३-१५-११", "content_sanskrit": "आघोषितं च नगरे न पातव्या सुरेति वै।\nप्रमादं परिरक्षद्भिरुग्रसेनोद्धवादिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2018219, "chapter_id": 1377, "verse_number": "३-१५-१२", "content_sanskrit": "प्रमत्तेष्वभिघातं हि कुर्यात्साल्वो नराधिपः।\nइति कृत्वाऽप्रमत्तास्ते सर्वेवृष्ण्यन्धकाः स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2018220, "chapter_id": 1377, "verse_number": "३-१५-१३", "content_sanskrit": "आनर्ताश्च तथा सर्वे नटनर्तकगायकाः।\nबहिर्निर्वासिताः सर्वे रक्षद्भिर्वित्तसंचयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2018221, "chapter_id": 1377, "verse_number": "३-१५-१४", "content_sanskrit": "संक्रमा भेदिताः सर्वे नावश्च प्रतिषेधिताः।\nपरिखाश्चापि कौरव्य कीलैः सुनिचिताः कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2018222, "chapter_id": 1377, "verse_number": "३-१५-१५", "content_sanskrit": "उदपानाः कुरुश्रेष्ठ तथैवाप्यम्बरीषकाः।\nसमन्तात्क्रोशमात्रं च कारिता विषमा च भूः।\n`संक्रमा भेदिताः सर्वे प्राकाराश्च नवीकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2018223, "chapter_id": 1377, "verse_number": "३-१५-१६", "content_sanskrit": "प्रकृत्या विषमं दुर्गं प्रकृत्या च सुरक्षितम्।\nप्रकृत्या चायुधोपेतं विशेषेण तदाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2018224, "chapter_id": 1377, "verse_number": "३-१५-१७", "content_sanskrit": "सुरक्षितं सुगुप्तं च सर्वायुधसमन्वितम्।\nतत्पुरं भरतश्रेष्ठ यथेन्द्रभवनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2018225, "chapter_id": 1377, "verse_number": "३-१५-१८", "content_sanskrit": "न चामुद्रोऽभिनिर्याति न चामुद्रः प्रवेश्यते।\nवृष्ण्यन्धकपुरे राजंस्तदा सौभसमागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2018226, "chapter_id": 1377, "verse_number": "३-१५-१९", "content_sanskrit": "अनुरध्यासु सर्वासु चत्वरेषु च कौरव।\nबलं बभूव राजेन्द्र प्रभूतगजवाजिमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2018227, "chapter_id": 1377, "verse_number": "३-१५-२०", "content_sanskrit": "दत्तवेतनभक्तं च दत्तायुधपरिच्छदम्।\nकृतोपधानं च तदा बलमासीद्विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2018228, "chapter_id": 1377, "verse_number": "३-१५-२१", "content_sanskrit": "न कृप्यवेतनी कश्चिन्न चातिक्रान्तवेतनी।\nनानुग्रहभृतः कश्चिन्न चादृष्टपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2018229, "chapter_id": 1377, "verse_number": "३-१५-२२", "content_sanskrit": "एवं सुविहिता राजन्द्वारका भूरिदक्षिणैः।\nआहुकेन सुगुप्ता च राज्ञा राजीवलोचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2018230, "chapter_id": 1377, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि अर्जुनाभिगमनपर्वणि पञ्चदशोऽध्यायः ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]