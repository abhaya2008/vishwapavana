[{"id": 2130570, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2130571, "chapter_id": 3818, "verse_number": "१", "content_sanskrit": "ततस्तान् परिविश्वस्तान् वसतस्तत्र पाण्डवान् ।\nगतेषु तेषु रक्षःसु भीमसेनात्मजेऽपि च \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2130572, "chapter_id": 3818, "verse_number": "२", "content_sanskrit": "पर्वतेन्द्रे द्विजैः सार्धं पार्थागमनकाङ्क्षया ।\nआजगाम तदा रक्षो नाम्ना ख्यातो जटासुरः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2130573, "chapter_id": 3818, "verse_number": "३", "content_sanskrit": "रहितान् भीमसेनेन कदाचित् तान्यदृच्छया ।\nजहार धर्मराजानं यमौ कृष्णां च राक्षसः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2130574, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2130575, "chapter_id": 3818, "verse_number": "४", "content_sanskrit": "ब्रह्मन् कथं धर्मराजं यमौ कृष्णां च राक्षसः ।\nजगाम कुत्र भीमश्च गतो राक्षसकण्टकः ।\nवक्तुमर्हसि विप्राग्र्य वृत्तमेतन्ममानघ \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2130576, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2130577, "chapter_id": 3818, "verse_number": "५", "content_sanskrit": "ब्राह्मणो मन्त्रकुशलः सर्वशास्त्रविदुत्तमः ।\nइति ब्रुवन् पाण्डवेयान् पर्युपास्ते स्म नित्यदा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2130578, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "जामदग्न्यस्य शिष्योऽहं रामस्याक्लिष्टकर्मणः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2130579, "chapter_id": 3818, "verse_number": "६", "content_sanskrit": "परीप्समानः पार्थानां कलापाश्च(नि) धनूंषि च ।\nअन्तरं सम्परिप्रेप्सुर्द्रौपद्या हरणं प्रति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2130580, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "पोषणं तस्य राजेन्द्र चक्रे पाण्डवनन्दनः ।\nबुबुधे न च तं पापं भस्मच्छन्नमिवानलम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2130581, "chapter_id": 3818, "verse_number": "७", "content_sanskrit": "स भीमसेने निष्क्रान्ते मृगयार्थमरिन्दम ।\nअन्यद्रूपं समास्थाय विकृतं भैरवं महत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2130582, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "घटोत्कचं सानुचरं दृष्ट्वा विप्रद्रुतं दिशः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2130583, "chapter_id": 3818, "verse_number": "८", "content_sanskrit": "रो(लो)मशप्रभृतींस्तांस्तु महर्षींश्च समाहितान् ।\nस्नातुं विनिर्गतान् दृष्ट्वा पुष्पार्थं च तपोधनान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2130584, "chapter_id": 3818, "verse_number": "९", "content_sanskrit": "गृहीत्वा सर्वशस्त्राणि द्रौपदीं परिगृह्य च ।\nप्रातिष्ठत स दुष्टात्मा त्रीन् गृहीत्वा च पाण्डवान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2130585, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "सहदेवस्तु यत्नेन ततोऽपक्रम्य पाण्डव ।\nआक्रन्दद् भीमसेनं वै येन यातो महाबलः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2130586, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "विक्रम्य कौशिकं खड्गं मोक्षयित्वा ग्रहं रिपोः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2130587, "chapter_id": 3818, "verse_number": "१०", "content_sanskrit": "तमब्रवीद् धर्मराजो ह्रियमाणो युधिष्ठिरः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2130588, "chapter_id": 3818, "verse_number": "११", "content_sanskrit": "धर्मस्ते हीयते मूढ न तत्त्वं समवेक्षसे ।\nयेऽन्ये क्वचिन्मनुष्येषु तिर्यग्योनिगताश्च ये \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2130589, "chapter_id": 3818, "verse_number": "१२", "content_sanskrit": "गन्धर्वोरगरक्षांसि वयांसि पशवस्तथा ।\nमनुष्यानुपजीवन्ति ततस्त्वमपि जीवसि \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2130590, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "धर्मं ते समवेक्षन्ते रक्षांसि च विशेषतः ।\nधर्मस्य राक्षसा मूलं धर्मं ते विदुरुत्तमम् ।\nएतत्परीक्ष्य सर्वं त्वं समीपे स्थातुमर्हसि ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2130591, "chapter_id": 3818, "verse_number": "१३", "content_sanskrit": "समृद्ध्या ह्यस्य लोकस्य लोको युष्माकमृध्यति ।\nइमं तु(च) लोकं शोचन्तमनुशोचन्ति देवताः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2130592, "chapter_id": 3818, "verse_number": "१४", "content_sanskrit": "पूज्यमानाश्च वर्धन्ते हव्यकव्यैर्यथाविधि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2130593, "chapter_id": 3818, "verse_number": "१५", "content_sanskrit": "वयं राष्ट्रस्य गोप्तारो रक्षितारश्च राक्षस ।\nराष्ट्रस्यारक्ष्यमाणस्य कुतो भूतिः कुतः सुखम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2130594, "chapter_id": 3818, "verse_number": "१६", "content_sanskrit": "न च राजावमन्तव्यो रक्षसा जात्वनागसि ।\nअणुरप्यपचारश्च नास्त्यस्माकं नराशन\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2130595, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "विघसाशान्यथाशक्त्या कुर्महे देवतादिषु ।\nगुरूंश्च ब्राह्मणांश्चैव प्रणामप्रवणाः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2130596, "chapter_id": 3818, "verse_number": "१७", "content_sanskrit": "द्रोग्धव्यं न च मित्रेषु न विश्वस्तेषु कर्हिचित् ।\nयेषां चान्नानि भुञ्जीत यत्र च स्यात् प्रतिश्रयः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2130597, "chapter_id": 3818, "verse_number": "१८", "content_sanskrit": "स त्वं प्रतिश्रयेऽस्माकं पूज्यमानः सुखोषितः ।\nभुक्त्वा चान्नानि दुष्प्रज्ञ कथमस्मान् जिहीर्षसि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2130598, "chapter_id": 3818, "verse_number": "१९", "content_sanskrit": "एवमेव वृथाचारो वृथावृद्धो वृथामतिः ।\nवृथामरणमर्हश्च वृथाऽद्य न भविष्यसि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2130599, "chapter_id": 3818, "verse_number": "२०", "content_sanskrit": "अथ चेद् दुष्टबुद्धिस्त्वं सर्वैर्धर्मैर्विवर्जितः ।\nप्रदाय शस्त्राण्यस्माकं युद्धेन द्रौपदीं हर\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2130600, "chapter_id": 3818, "verse_number": "२१", "content_sanskrit": "अथ चेत् त्वमविज्ञानादिदं कर्म करिष्यसि ।\nअधर्मं चाप्यकीर्तिं च लोके प्राप्स्यसि केवलम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2130601, "chapter_id": 3818, "verse_number": "२२", "content_sanskrit": "एतामद्य परामृश्य स्त्रियं राक्षस मानुषीम् ।\nविषमेतत् समालोड्य कुम्भेन प्राशितं त्वया\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2130602, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2130603, "chapter_id": 3818, "verse_number": "२३", "content_sanskrit": "ततो युधिष्ठिरस्तस्य भारिकः समपद्यत ।\nस तु भाराभिभूतात्मा न तथा शीघ्रगोऽभवत् ।\nअथाब्रवीद् द्रौपदीं च नकुलं च युधिष्ठिरः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2130604, "chapter_id": 3818, "verse_number": "२४", "content_sanskrit": "मा भैष्ट राक्षसान् मूढाद् गतिरस्य मया हृता\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2130605, "chapter_id": 3818, "verse_number": "२५", "content_sanskrit": "नातिदूरे महाबाहुर्भविता पवनात्मजः ।\nअस्मिन् मुहूर्ते सम्प्राप्ते न भविष्यति राक्षसः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2130606, "chapter_id": 3818, "verse_number": "२६", "content_sanskrit": "सहदेवस्तु तं दृष्ट्वा राक्षसं मूढचेतस(न)म् ।\nउवाच वचनं राजन् कुन्तीपुत्रं युधिष्ठिरम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2130607, "chapter_id": 3818, "verse_number": "२७", "content_sanskrit": "राजन् किन्नाम सत्कृत्यं क्षत्रियस्यास्त्यतोऽधिकम् ।\nयद् युद्धेऽभिमुखः प्राणांस्त्यजेच्छत्रुं जयेत वा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2130608, "chapter_id": 3818, "verse_number": "२८", "content_sanskrit": "एष चास्मान् वयं चैनं युद्ध्यमानाः परन्तप ।\nसूदयेम महाबाहो देशकालो ह्ययं नृप\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2130609, "chapter_id": 3818, "verse_number": "२९", "content_sanskrit": "क्षत्रधर्मस्य सम्प्राप्तः कालः सत्यपराक्रम ।\nजयन्तो हन्यमाना वा प्राप्तुमर्हाम सद्गतिम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2130610, "chapter_id": 3818, "verse_number": "३०", "content_sanskrit": "राक्षसे जीवमानेऽद्य रविरस्तमियाद् यदि ।\nनाहं ब्रूयां पुनर्जातु क्षत्रियोऽस्मीति भारत\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2130611, "chapter_id": 3818, "verse_number": "३१", "content_sanskrit": "भो भो राक्षस तिष्ठस्व सहदेवोऽस्मि पाण्डवः ।\nहत्वा वा मां नयस्वैनां हतो वाऽद्येह स्वप्स्यसि\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2130612, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2130613, "chapter_id": 3818, "verse_number": "३२", "content_sanskrit": "तदा ब्रुवति माद्रेये भीमसेनो यदृच्छया ।\nप्रत्यदृश्यद् गदाहस्तः सवज्र इव वासवः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2130614, "chapter_id": 3818, "verse_number": "३३", "content_sanskrit": "सोऽपश्यद् भ्रातरौ तत्र द्रौपदीं च यशस्विनीम्।\nक्षितिस्थं सहदेवं च क्षिपन्तं राक्षसं तदा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2130615, "chapter_id": 3818, "verse_number": "३४", "content_sanskrit": "मार्गाच्च राक्षसं मूढं कालोपहतचेतसम् ।\nभ्रमन्तं तत्र तत्रैव देवेन विनिवारितम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2130616, "chapter_id": 3818, "verse_number": "३५", "content_sanskrit": "भ्रातॄंस्तान् ह्रियतो दृष्ट्वा द्रौपदीं च महाबलः ।\nक्रोधमाहारयद्भीमो राक्षसं चेदमब्रवीत् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2130617, "chapter_id": 3818, "verse_number": "३६", "content_sanskrit": "विज्ञातोऽसि मया पूर्वं पाप शस्त्रपरीक्षणे ।\nआस्थानं त्वयि मे नास्ति यतोऽसि न हतस्तदा\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2130618, "chapter_id": 3818, "verse_number": "३७", "content_sanskrit": "ब्रह्मरूपप्रतिच्छन्नो न नो वदसि चाप्रियम् ।\nप्रियेषु रममाणं त्वां न चैवाप्रियकारिणम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2130619, "chapter_id": 3818, "verse_number": "३८", "content_sanskrit": "अतिथिं ब्रह्मरूपं च कथं हन्यामनागसम् ।\nराक्षसं जानमानोऽपि यो हन्यान्नरकं व्रजेत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2130620, "chapter_id": 3818, "verse_number": "३९", "content_sanskrit": "अपक्वस्य च कालेन वधस्तव न विद्यते \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2130621, "chapter_id": 3818, "verse_number": "४०", "content_sanskrit": "ब्रह्मरूपेण विहितं नैव वाण्यामनागसम् ।\nनूनमद्यासि सम्पक्वो यथा ते मतिरीदृशी\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2130622, "chapter_id": 3818, "verse_number": "४१", "content_sanskrit": "दत्ता कृष्णापहरणे कालेनाद्भुतकर्मणा ।\nसोऽपि कालं समासाद्य तदाद्य न भविष्यति\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2130623, "chapter_id": 3818, "verse_number": "४२", "content_sanskrit": "बडिशोऽयं त्वया ग्रस्तः कालसूत्रेण लम्बितः ।\nमत्स्योऽम्भसीव स्यूतास्यः कथमद्य भविष्यसि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2130624, "chapter_id": 3818, "verse_number": "४३", "content_sanskrit": "यं चासि प्रस्थितो देशं मनःपूर्वं गतं च ते ।\nन तं गतासि गन्तासि मार्गं बकहिडिम्बयोः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2130625, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2130626, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "एवमुक्तस्तु भीमेन राक्षसः कालचोदितः ।\nभीत उत्सृज्य तान् सर्वान् युद्धाय समुपस्थितः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2130627, "chapter_id": 3818, "verse_number": "४४", "content_sanskrit": "अब्रवीच्च पुनर्भीमं रोषात् प्रस्फुरिताधरः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2130628, "chapter_id": 3818, "verse_number": "४५", "content_sanskrit": "न मे मूढा दिशः पाप त्वदर्थं मे विळम्बितम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2130629, "chapter_id": 3818, "verse_number": "४६", "content_sanskrit": "श्रुता मे राक्षसा ये ये त्वया विनिहता रणे ।\nतेषामद्य करिष्यामि तवास्रेणोदकक्रियाम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2130630, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2130631, "chapter_id": 3818, "verse_number": "४७", "content_sanskrit": "एवमुक्त्वा तदा भीमं राक्षसो योद्धुमाययौ ।\nस्मयमान इव क्रोधात् साक्षात् कालान्तकोपमः \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2130632, "chapter_id": 3818, "verse_number": "४८", "content_sanskrit": "ब्रुवन् वै तिष्ठ तिष्ठेति क्रोधसंरक्तलोचनः ।\nबाहुसंरम्भमेवेच्छन्नभिदुद्राव राक्षसम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2130633, "chapter_id": 3818, "verse_number": "४९", "content_sanskrit": "राक्षसोऽपि तदा भीमं युद्धार्थिनमवस्थितम् ।\nअभिदुद्राव संरब्धो बलिर्वज्रधरं यथा\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2130634, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "मुहुर्मुहुर्व्याददानः सृक्किणी परिसंलिहन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2130635, "chapter_id": 3818, "verse_number": "५०", "content_sanskrit": "भीमसेनोऽप्यवष्टब्धो नियुद्धायाभवत् स्थितः ।\nराक्षसोऽपि च विस्रब्धो बाहुयुद्धमकाङ्क्षत \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2130636, "chapter_id": 3818, "verse_number": "५१", "content_sanskrit": "वर्तमाने तदा ताभ्यां बाहुयुद्धे सुदारुणे ।\nमाद्रीपुत्रावतिक्रुद्धावुभावप्यभ्यधावताम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2130637, "chapter_id": 3818, "verse_number": "५३", "content_sanskrit": "न्यवारयत् तौ प्रहसन् कुन्तीपुत्रो वृकोदरः ।\nशक्तोऽहं राक्षसस्येति प्रेक्षध्वमिति चाब्रवीत्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2130638, "chapter_id": 3818, "verse_number": "५४", "content_sanskrit": "आत्मना भ्रातृभिश्चैव धर्मेण सुकृतेन च ।\nइष्टेन च शपे राजन् सूदयिष्यामि राक्षसम् \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2130639, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2130640, "chapter_id": 3818, "verse_number": "५५", "content_sanskrit": "इत्येवमुक्त्वा तौ वीरौ स्पर्धमानौ परस्परम् ।\nबाहुभ्यां समसज्जेतामुभौ रक्षोवृकोदरौ\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2130641, "chapter_id": 3818, "verse_number": "५६", "content_sanskrit": "तयोरासीत् सम्प्रहारः क्रुद्धयोर्भीमरक्षसोः ।\nअमृष्यमाणयोः सङ्ख्ये देवदानवयोरिव \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2130642, "chapter_id": 3818, "verse_number": "५७", "content_sanskrit": "आरुज्यारुज्य तौ वृक्षानन्योन्यमभिजघ्नतुः ।\nजीमूताविव गर्जन्तौ निनदन्तौ महाबलौ\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2130643, "chapter_id": 3818, "verse_number": "५८", "content_sanskrit": "बभञ्जतुर्महावृक्षानूरुभिर्बलिनां वरौ ।\nअन्योन्येनाभिसंरब्धौ परस्परवधैषिणौ\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2130644, "chapter_id": 3818, "verse_number": "५९", "content_sanskrit": "तद्वृक्षयुद्धमभवन्महीरुहविनाशनम् ।\nवालिसुग्रीवयोर्भ्रात्रोः पुरा स्त्रीकाङ्क्षिणोर्यथा\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2130645, "chapter_id": 3818, "verse_number": "६०", "content_sanskrit": "आविध्याविध्य तौ वृक्षान्मुहूर्तमितरेतरम् ।\nताडयामासतुरुभौ विनदन्तौ मुहुर्मुहुः \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2130646, "chapter_id": 3818, "verse_number": "६१", "content_sanskrit": "तस्मिन् देशे यदा वृक्षाः सर्व एव निपातिताः ।\nपुञ्जीकृताश्च शतशः परस्परवधेप्सया\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2130647, "chapter_id": 3818, "verse_number": "६२", "content_sanskrit": "ततः शिलाः समादाय मुहूर्तमिव भारत ।\nमहाभ्रैरिव शैलेन्द्रौ युयुधाते महाबलौ\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2130648, "chapter_id": 3818, "verse_number": "६३", "content_sanskrit": "शिलाभिरुग्ररूपाभिर्बृहतीभिः परस्परम् ।\nवज्रैरिव महावेगैराजघ्नतुरमर्षणौ\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2130649, "chapter_id": 3818, "verse_number": "६४", "content_sanskrit": "अभिद्रुत्य तु(च) भूयस्तावन्योन्यं बलदर्पितौ ।\nभुजाभ्यां परिगृह्याथ चकर्षाते गजाविव \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2130650, "chapter_id": 3818, "verse_number": "६५", "content_sanskrit": "मुष्टिभिश्च महाघोरैरन्योन्यमभिजघ्नतुः ।\nततः कटकटाशब्दो बभूव सुमहात्मनोः \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2130651, "chapter_id": 3818, "verse_number": "६६", "content_sanskrit": "ततः संहृत्य मुष्टिं तु पञ्चशीर्षमिवोरगम् ।\nवेगेनाभ्यहनद् भीमो राक्षसस्य शिरोधराम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2130652, "chapter_id": 3818, "verse_number": "६७", "content_sanskrit": "ततः श्रान्तं तु तद्रक्षो भीमसेनभुजाहतम् ।\nसुपरिश्रान्तमालक्ष्य भीमसेनोऽभ्यवर्तत\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2130653, "chapter_id": 3818, "verse_number": "६८", "content_sanskrit": "तत एनं महाबाहुर्बाहुभ्याममरोपमः ।\nसमुत्क्षिप्य बलाद् भीमो विनिष्पिष्य महीतळे\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2130654, "chapter_id": 3818, "verse_number": "६९", "content_sanskrit": "ततः सम्पीड्य बलबद्भुजाभ्यां क्रोधमूर्च्छितः ।\nतस्य गात्राणि सर्वाणि चूर्णयामास पाण्डवः \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2130655, "chapter_id": 3818, "verse_number": "७०", "content_sanskrit": "अरत्निना चाभिहत्य शिरः कायादपाहरत् ।\nसन्दष्टौष्ठं विवृत्ताक्षं फलं वृक्षादिव च्युतम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2130656, "chapter_id": 3818, "verse_number": "७१", "content_sanskrit": "जटासुरस्य तु शिरो भीमसेनबलाद्धतम् ।\nपपात रुधिरादिग्धं सन्दष्टदशनच्छदम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2130657, "chapter_id": 3818, "verse_number": "७२", "content_sanskrit": "तं निहत्य महेष्वासो युधिष्ठिरमुपागमत् ।\nस्तूयमानो द्विजाग्र्यैस्तु मरुद्भिरिव वासवः ।\nबभूव पुरुषव्याघ्रः प्रहृष्ट इव पाण्डवः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2130658, "chapter_id": 3818, "verse_number": "७३", "content_sanskrit": "ततो युधिष्ठिरो राजा धौम्यः कृष्णा यमौ तथा ।\nभीमसेनमुपायान्तं ददृशुस्ते च पाण्डवम्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2130659, "chapter_id": 3818, "verse_number": "७४", "content_sanskrit": "उपसङ्गत्य धौम्यं च पाण्डवं च युधिष्ठिरम् ।\nपर्यष्वजत दुर्धर्षो यमौ चापि वृकोदरः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2130660, "chapter_id": 3818, "verse_number": "७५", "content_sanskrit": "हतं जटासुरं दृष्ट्वा पाञ्चाली च वृकोदरम् ।\nमुदितं पूजयामास पौलोमीव पुरन्दरम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2130661, "chapter_id": 3818, "verse_number": "७६", "content_sanskrit": "सम्पूजितः स सद्भिर्ब्राह्मणानभिवाद्य च ।\nजितारिर्मुदितो भीमो बभूव भरतर्षभः\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2130662, "chapter_id": 3818, "verse_number": "१५३", "content_sanskrit": "॥ इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि त्रिपञ्चाशदधिकशततमोऽध्यायः ॥ १५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2130663, "chapter_id": 3818, "verse_number": "१", "content_sanskrit": "॥ इति जटासुरवधपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2130664, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "॥ समाप्तं जटासुरवधपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2130665, "chapter_id": 3818, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]