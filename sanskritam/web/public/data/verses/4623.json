[{"id": 2169223, "chapter_id": 4623, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2169224, "chapter_id": 4623, "verse_number": "१", "content_sanskrit": "ततः पुनर्महाराज मद्रराजमरिन्दमः ।\nअभ्यभाषत राधेयः सन्निवार्योत्तरं वचः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2169225, "chapter_id": 4623, "verse_number": "२", "content_sanskrit": "निर्भर्त्सनार्थं शल्य त्वं यत्तु जल्पितवानसि ।\nनाहं शक्यस्त्वया वाचा विभीषयितुमाहवे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2169226, "chapter_id": 4623, "verse_number": "३", "content_sanskrit": "यदि मां देवताः सर्वा योधयेयुः सवासवाः ।\nतथापि मे भयं न स्यात् किमु पार्थात् सकेशवात्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2169227, "chapter_id": 4623, "verse_number": "४", "content_sanskrit": "नाहं भीषयितुं शक्यः शुद्धकर्मा महाहवे ।\nअभिजानीहि शक्तस्त्वमन्यं भीषयितुं रणे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2169228, "chapter_id": 4623, "verse_number": "५", "content_sanskrit": "नीचस्य बलमेतावत् पारुष्यं यत्त्वमात्थ माम् ।\nअशक्तो हि गुणान् वक्तुं वल्गसे बहु दुर्मते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2169229, "chapter_id": 4623, "verse_number": "६", "content_sanskrit": "न हि कर्णः समुद्भूतो भयार्थमिह मारिष ।\nविक्रमार्थमहं जातो यशोर्थं च तथाऽऽत्मनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2169230, "chapter_id": 4623, "verse_number": "७", "content_sanskrit": "सहिष्णुत्वेन सौहार्दात् मित्रकार्यव्यपेक्षया ।\nकारणैस्त्रिभिरेतैस्त्वं शल्य जीवसि साम्प्रतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2169231, "chapter_id": 4623, "verse_number": "८", "content_sanskrit": "राज्ञश्च धार्तराष्ट्रस्य कार्यं सुमहदुद्यतम् ।\nमयि तच्चाहितं शल्य तेन जीवसि मे क्षणम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2169232, "chapter_id": 4623, "verse_number": "९", "content_sanskrit": "कृतश्च समयः पूर्वं क्षन्तव्यं विप्रियं तव ।\nसमयः परिपाल्यो मे तेन जीवसि मद्रक\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2169233, "chapter_id": 4623, "verse_number": "१०", "content_sanskrit": "ऋते शल्यसहस्रेण विजयेयमहं परान् ।\nमित्रद्रोहस्तु पापीयानिति जीवसि साम्प्रतम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2169234, "chapter_id": 4623, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2169235, "chapter_id": 4623, "verse_number": "११", "content_sanskrit": "ननु प्रलापाः कर्णैते यान् ब्रवीषि परान् प्रति ।\nऋते कर्णसहस्रेण शक्या जेतुं परा युधि\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2169236, "chapter_id": 4623, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2169237, "chapter_id": 4623, "verse_number": "१२", "content_sanskrit": "तथा ब्रुवन्तं परुषं कर्णो मद्राधिपं तदा ।\nपरुषं द्विगुणं भूयः प्रोवाचाप्रियदर्शनम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2169238, "chapter_id": 4623, "verse_number": "१३", "content_sanskrit": "इदं त्वमेकाग्रमनाः शृणु मद्रजनाधिप ।\nसन्निधौ धृतराष्ट्रस्य प्रोच्यमानं मया श्रुतम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2169239, "chapter_id": 4623, "verse_number": "१४", "content_sanskrit": "देशांश्च विविधांश्चित्रान् पूर्ववृत्तांश्च पार्थिवान् ।\nब्राह्मणाः कथयन्ति स्म धृतराष्ट्रनिवेशने\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2169240, "chapter_id": 4623, "verse_number": "१५", "content_sanskrit": "तत्र वृद्धः पुरावृत्ताः कथाः कश्चिद् द्विजोत्तमः ।\nबाह्लीकदेशं मद्रांश्च कुत्सयन् वाक्यमब्रवीत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2169241, "chapter_id": 4623, "verse_number": "१६", "content_sanskrit": "बहिष्कृता हिमवता गङ्गया च तिरस्कृताः ।\nसरस्वत्या यमुनया कुरुक्षेत्रेण चापि ये\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2169242, "chapter_id": 4623, "verse_number": "१७", "content_sanskrit": "पञ्चानां सिन्धुषष्ठानां नदीनां येऽन्तराश्रिताः ।\nतान् धर्मबाह्यान् अशुचीन् बाह्लीकानपि वर्जयेत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2169243, "chapter_id": 4623, "verse_number": "१८", "content_sanskrit": "गोवर्धनो नाम वटः सुभाण्डं नाम पत्तनम् ।\nएतद् राजन् कलिद्वारमाकुमारात् स्मराम्यहम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2169244, "chapter_id": 4623, "verse_number": "१९", "content_sanskrit": "कार्येणात्यर्थगूढेन बाह्लीकेषूषितं मया ।\nतत एषां समाचारः संवासाद् विदितो मया\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2169245, "chapter_id": 4623, "verse_number": "२०", "content_sanskrit": "शाकलं नाम नगरमापगानामनिम्नगा ।\nचण्डाला नाम बाह्लीकास्तेषां वृत्तं सुनिन्दितम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2169246, "chapter_id": 4623, "verse_number": "२१", "content_sanskrit": "पानं गुडासवं पीत्वा गोमांसं लशुनैः सह ।\nअपूपसक्तुमद्यानामाशिताः शीलवर्जिताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2169247, "chapter_id": 4623, "verse_number": "२२", "content_sanskrit": "गायन्त्यथ च नृत्यन्ति स्त्रियो मत्ता विवाससः ।\nनगरापणवेशेषु बहिर्माल्यानुलेपनाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2169248, "chapter_id": 4623, "verse_number": "२३", "content_sanskrit": "मत्ताः प्रगीतविरुतैः खरोष्ट्रनिनदोपमैः ।\nअनावृता मैथुने ताः कामाचाराश्च सर्वशः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2169249, "chapter_id": 4623, "verse_number": "२४", "content_sanskrit": "आहुरन्योन्यशुक्तानि प्रब्रुवाणा मदोत्कटाः ।\nहे हते हे हतेत्येवं स्वामिभर्तृहतेति च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2169250, "chapter_id": 4623, "verse_number": "२५", "content_sanskrit": "आक्रोशन्त्यः प्रनृत्यन्ति व्रात्याः पर्वस्वसंयताः ।\nतासां किलावलिप्तानां निवसन् कुरुजाङ्गले\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2169251, "chapter_id": 4623, "verse_number": "२६", "content_sanskrit": "कश्चिद् बाह्लीकदुष्टानां नातिहृष्टमना जगौ ।\nसा नूनं बृहती गौरी सूक्ष्मकम्बलवासिनी\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2169252, "chapter_id": 4623, "verse_number": "२७", "content_sanskrit": "मामनुस्मरती शेते बाह्लीकं कुरुवासिनम् ।\nशतद्रुं नु कदा तीर्त्वा तां च रम्यामिरावतीम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2169253, "chapter_id": 4623, "verse_number": "२८", "content_sanskrit": "गत्वा स्वदेशं द्रक्ष्यामि स्थूलशङ्खाः शुभाः स्त्रियः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2169254, "chapter_id": 4623, "verse_number": "२९", "content_sanskrit": "मनःशिलोज्ज्वलापाङ्गाः गौर्यस्त्रिककुदाञ्जनाः ।\nकम्बलाजिनसंवीता क्रीडन्त्यः प्रियदर्शनाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2169255, "chapter_id": 4623, "verse_number": "३०", "content_sanskrit": "मृदङ्गानकशङ्खानां मर्दलानां च निःस्वनैः ।\nखरोष्ट्राश्वतरैश्चैव मत्ता यास्यामहे सुखम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2169256, "chapter_id": 4623, "verse_number": "३१", "content_sanskrit": "शमीपीलुकरीराणां वनेषु सुखवर्त्मसु ।\nअपूपान् सक्तुपिण्डांश्च प्राश्नन्तो मदिरान्वितान्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2169257, "chapter_id": 4623, "verse_number": "३२", "content_sanskrit": "पथि प्रबला भूत्वा मैथुनं कुर्वतेऽधिकम् ।\nचेलापहारं कुर्वाणाः सम्भविष्याम भूरिशः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2169258, "chapter_id": 4623, "verse_number": "३३", "content_sanskrit": "एवंशीलेषु व्रात्येषु बाह्लीकेषु दुरात्मसु ।\nकश्चेतयानो निवसेन्मुहूर्तमपि मानवः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2169259, "chapter_id": 4623, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2169260, "chapter_id": 4623, "verse_number": "३४", "content_sanskrit": "ईदृशा ब्राह्मणेनोक्ता बाह्लीका मोघचारिणः ।\nयेषां षड्भागहर्ता त्वमुभयोः पुण्यपापयोः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2169261, "chapter_id": 4623, "verse_number": "३५", "content_sanskrit": "इत्युक्त्वा ब्राह्मणः साधुरुत्तरं पुनरुक्तवान् ।\nबाह्लीकेष्वविनीतेषु प्रोच्यमानं निबोध तत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2169262, "chapter_id": 4623, "verse_number": "३६", "content_sanskrit": "तत्र स्म राक्षसा गान्ति सदा कृष्णचतुर्दशीम् ।\nनगरे शाकले स्फीते आहत्य निशि दुन्दुभिम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2169263, "chapter_id": 4623, "verse_number": "३७", "content_sanskrit": "कदा च हैलिका गाथा पुनर्गास्यामि शाकले ।\nगव्यस्य तृप्ता मांसस्य पीत्वा गौडं सुरासवम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2169264, "chapter_id": 4623, "verse_number": "३८", "content_sanskrit": "गौरीभिः सह नारीभिर्बृहतीभिः स्वलङ्कृताः ।\nपलाण्डुगण्डूषयुताः खादन्तश्चेडकान् बहून्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2169265, "chapter_id": 4623, "verse_number": "३९", "content_sanskrit": "वाराहं कौक्कुटं मांसं गव्यं गार्दभमौष्ट्रकम् ।\nधानाश्च ये न खादन्ति तेषां जन्म निरर्थकम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2169266, "chapter_id": 4623, "verse_number": "४०", "content_sanskrit": "एवं गायन्ति ते मत्ताः शीधुना पीलुकावने ।\nसबालवृद्धाः क्रन्दन्ति तेषां धर्मः कथं भवेत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2169267, "chapter_id": 4623, "verse_number": "", "content_sanskrit": "(यत्र लोकेश्वरः कृष्णो देवदेवो जनार्दनः ।\nविस्मृतः पुरुषैरुग्रैस्तेषां धर्मः कथं भवेत्\t॥४१॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2169268, "chapter_id": 4623, "verse_number": "समाप्तिः", "content_sanskrit": "इति शल्य विजानीहि हन्त भूयो ब्रवीमि ते ।\nयदन्योप्युक्तवानस्मान् ब्राह्मणः कुरुसंसदि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2169269, "chapter_id": 4623, "verse_number": "४३", "content_sanskrit": "पञ्चनद्यो वहन्त्येता यत्र पीलुवनान्युत ।\nशतद्रुश्च विपाशा च तृतीयैरावती तथा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2169270, "chapter_id": 4623, "verse_number": "४४", "content_sanskrit": "चन्द्रभागा वितस्ता च सिन्धुषष्ठा महानदी\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2169271, "chapter_id": 4623, "verse_number": "४५", "content_sanskrit": "आरट्टा नाम बाह्लीका एतेष्वार्यो हि नो वसेत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2169272, "chapter_id": 4623, "verse_number": "४६", "content_sanskrit": "व्रात्यानां दासमीयानां वैदेहानामयज्वनाम् ।\nन देवाः प्रतिगृह्णन्ति पितरो ब्राह्मणास्तथा\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2169273, "chapter_id": 4623, "verse_number": "४७", "content_sanskrit": "तेषां प्रनष्टधर्माणां बाह्लीकानामिति श्रुतिः ।\nब्राह्मणेन यथा प्रोक्तं विदुषा साधुसंसदि\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2169274, "chapter_id": 4623, "verse_number": "४८", "content_sanskrit": "काष्ठकुण्डेषु बाह्लीका मृण्मयेषु च भुञ्जते ।\nसक्तुमद्यावलिप्तेषु श्वावलीढेषु निर्घृणाः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2169275, "chapter_id": 4623, "verse_number": "४९", "content_sanskrit": "आविकं चौष्ट्रिकं चैव क्षीरं गार्दभमेव च ।\nतद्विकारांश्च बाह्लीकाः खादन्ति च पिबन्ति च\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2169276, "chapter_id": 4623, "verse_number": "५०", "content_sanskrit": "पात्रसङ्करिणो जाल्माः सर्वान्नक्षीरभोजनाः ।\nआरट्टा नाम बाह्लीका वर्जनीया विपश्चिता\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2169277, "chapter_id": 4623, "verse_number": "समाप्तिः", "content_sanskrit": "इति शल्य विजानीहि हन्त भूयो ब्रवीमि ते ।\nयदन्योऽप्युक्तवान् मह्यं ब्राह्मणः कुरुसंसदि\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2169278, "chapter_id": 4623, "verse_number": "५२", "content_sanskrit": "युगन्धरे पयः पीत्वा प्रोष्य चाप्यच्युतस्थळे ।\nतद्वद्भूतिलये स्नात्वा कथं स्वर्गं गमिष्यति\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2169279, "chapter_id": 4623, "verse_number": "५३", "content_sanskrit": "पञ्चनद्यो वहन्त्येता यत्र निःसृत्य पर्वतात् ।\nआरट्टा नाम बाह्लीका न तेष्वार्यो द्व्यहं वसेत्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2169280, "chapter_id": 4623, "verse_number": "५४", "content_sanskrit": "बह्ली नाम बलीकश्च विपाशायां पिशाचकौ ।\nतयोरपत्यं बाह्लीका नैषा सृष्टिः प्रजापतेः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2169281, "chapter_id": 4623, "verse_number": "५५", "content_sanskrit": "ते कथं विविधान् धर्मान् ज्ञास्यन्ते हीनयोनयः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2169282, "chapter_id": 4623, "verse_number": "५६", "content_sanskrit": "कारस्करान् माहिषकान् करम्भान् कटकालिकान् ।\nकर्कोटवीरकाम्बष्टान् उन्मार्गांश्च विवर्जयेत्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2169283, "chapter_id": 4623, "verse_number": "समाप्तिः", "content_sanskrit": "इति तीर्थानुसर्तारं राक्षसी काचिदब्रवीत् ।\nएकरात्रमुषित्वेह महोलूखलमेखला\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2169284, "chapter_id": 4623, "verse_number": "५८", "content_sanskrit": "आरट्टा नाम ते देशा बाह्लीकं नाम तद्वनम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2169285, "chapter_id": 4623, "verse_number": "५९", "content_sanskrit": "ब्राह्मणापसदा यत्र जायन्ते चाधमात् कुलात् ।\nवेदा न तेषां वेद्यं च यज्ञा याजनमेव च\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2169286, "chapter_id": 4623, "verse_number": "६०", "content_sanskrit": "व्रात्यान्नं दासमीयानामन्नं देवा न भुञ्जते ।\nप्रस्थला मद्रगान्धारा आरट्टा नामतः शकाः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2169287, "chapter_id": 4623, "verse_number": "६१", "content_sanskrit": "वसातिसिन्धुसौवीरा इति प्रायोऽतिकुत्सिताः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2169288, "chapter_id": 4623, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2169289, "chapter_id": 4623, "verse_number": "समाप्तिः", "content_sanskrit": "इति शल्य विजानीहि हन्त भूयो ब्रवीमि ते ।\nउच्यमानं मया सम्यक्त्वमेकाग्रमनाः शृणु\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2169290, "chapter_id": 4623, "verse_number": "६३", "content_sanskrit": "ब्राह्मणः किल नो गेहमध्यगच्छत्पुराऽतिथिः ।\nआचारं तत्र सम्प्रेक्ष्य प्रीतो वचनमब्रवीत्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2169291, "chapter_id": 4623, "verse_number": "६४", "content_sanskrit": "मया हिमवतः शृङ्गमेकेनाध्युषितं चिरम् ।\nदृष्टाश्च बहवो देशा नानाधर्मसमावृताः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2169292, "chapter_id": 4623, "verse_number": "६५", "content_sanskrit": "न च केन च धर्मेण विरुद्ध्यन्ते प्रजा इमाः ।\nसर्वाश्चाप्याचरन् धर्मं यदुक्तं वेदपारगैः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2169293, "chapter_id": 4623, "verse_number": "६६", "content_sanskrit": "अटता तु मया देशान्नानाधर्मसमाकुलान् ।\nआगच्छता महाराज बाह्लीकेषु निशामितम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2169294, "chapter_id": 4623, "verse_number": "६७", "content_sanskrit": "तत्र वै ब्राह्मणो भूत्वा पुनर्भवति क्षत्रियः ।\nवैश्यः शूद्रश्च बाह्लीकस्ततो भवति नापितः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2169295, "chapter_id": 4623, "verse_number": "६८", "content_sanskrit": "नापितश्च ततो भूत्वा पुनर्भवति ब्राह्मणः ।\nद्विजो भूत्वा च तत्रैव पुनर्दासोऽभिजायते\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2169296, "chapter_id": 4623, "verse_number": "६९", "content_sanskrit": "भवन्त्येककुले विप्राः शिष्टा ये कामचारिणः ।\nगान्धारा मद्रकाश्चैव बाह्लीकाः केप्यचेतसः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2169297, "chapter_id": 4623, "verse_number": "७०", "content_sanskrit": "एतन्मया श्रुतं तत्र धर्मसङ्करकारकम् ।\nकृत्स्नामटित्वा पृथिवीं बाह्लीकेषु विपर्ययः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2169298, "chapter_id": 4623, "verse_number": "समाप्तिः", "content_sanskrit": "इति शल्य विजानीहि हन्त भूयो ब्रवीमि ते ।\nयदप्यन्योऽब्रवीद् वाक्यं बाह्लीकानां विकुत्सितम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2169299, "chapter_id": 4623, "verse_number": "७२", "content_sanskrit": "आनीयेहाक्षता काचिदारट्टैः किल दस्युभिः ।\nअधर्मतश्चोपयाता सा तानभ्यशपत् ततः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2169300, "chapter_id": 4623, "verse_number": "७३", "content_sanskrit": "बालां बन्धुमतीं यन्मामधर्मेणोपगच्छथ ।\nतस्मान्नार्यो भविष्यन्ति बन्धक्यो वै कुलेषु वः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2169301, "chapter_id": 4623, "verse_number": "७४", "content_sanskrit": "न चैवास्मात् प्रमोक्ष्यध्वं घोराच्छापान्नराधमाः ।\nतस्मात् तेषां भागहरः कथं धर्मान् वदिष्यसि\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2169302, "chapter_id": 4623, "verse_number": "७५", "content_sanskrit": "कुरवः सहपाञ्चालाः साल्वा मात्स्याः सनैमिशाः ।\nकोसलाः काशिपौण्ड्राश्च कालिङ्गा मागधास्तथा\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2169303, "chapter_id": 4623, "verse_number": "७६", "content_sanskrit": "चेदयश्च महाभागा धर्मं जानन्ति शाश्वतम् ।\nनानादेशेषु सन्तश्च प्रायो बाह्यालयादृते\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2169304, "chapter_id": 4623, "verse_number": "७७", "content_sanskrit": "आमत्स्येभ्यः कुरुपाञ्चालसाल्वा\nआनैमिशाच्चेदयो ये विशिष्टाः ।\nधर्मं पुराणमुपजीवन्ति सन्तो\nमद्रानृते पाञ्चनदांश्च जिह्मान्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2169305, "chapter_id": 4623, "verse_number": "७८", "content_sanskrit": "एवं विद्वान् धर्मकथासु राजन्\nतूष्णीम्भूतः जडवच्छल्य भूयाः ।\nत्वं तस्य गोप्ता च जनस्य राजा\nषड्भागहर्ता शुभदुष्कृतस्य\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2169306, "chapter_id": 4623, "verse_number": "७९", "content_sanskrit": "अथवा दुष्कृतस्य त्वं हर्ता तेषामरक्षिता ।\nरक्षिता पुण्यभाग् राजा प्रजानां त्वं ह्यपुण्यभाक्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2169307, "chapter_id": 4623, "verse_number": "८०", "content_sanskrit": "पूज्यमाने पुरा धर्मे सर्वदेशेषु शाश्वते ।\nव्रात्यानां दासमीयानां कृतेऽप्यशुभकारिणाम्\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2169308, "chapter_id": 4623, "verse_number": "८१", "content_sanskrit": "धर्मं पाञ्चनदं दृष्ट्वा धिगित्याह पितामहः ।\nब्रह्मणा निन्दिते धर्मे स त्वं लोकं किमब्रवीः \t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2169309, "chapter_id": 4623, "verse_number": "८२", "content_sanskrit": "इमं पाञ्चनदं धर्ममवमेने पितामहः ।\nस्वधर्मस्थेषु वर्णेषु सोऽप्येतान्नाभ्यपूजयत्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2169310, "chapter_id": 4623, "verse_number": "समाप्तिः", "content_sanskrit": "इति शल्य विजानीहि हन्त भूयो ब्रवीमि ते ।\nकल्माषपादः सरसि निमज्जन् राक्षसोऽब्रवीत्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2169311, "chapter_id": 4623, "verse_number": "८४", "content_sanskrit": "क्षत्रियस्य मलं भैक्ष्यं ब्राह्मणस्याश्रुतं मलम् ।\nमलं पृथिव्या बाह्लीकाः स्त्रीणां मद्रस्त्रियो मलम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2169312, "chapter_id": 4623, "verse_number": "८५", "content_sanskrit": "निमज्यमानमुद्धृत्य कश्चिद् राजा निशाचरम् ।\nअपृच्छत् तेन चाख्यातं तच्छृणुष्व नराधिप\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2169313, "chapter_id": 4623, "verse_number": "८६", "content_sanskrit": "मानुषाणां मलं म्लेच्छा म्लेच्छानामौष्ट्रिका मलम् ।\nमुष्टिकानां मलं षण्ढाः षण्ढानां राजयाजकाः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2169314, "chapter_id": 4623, "verse_number": "८७", "content_sanskrit": "राजयाजकयाज्यानां मद्रकाणां च यन्मलम् ।\nतद्भवेद् वै तव मलं यद्यस्मान्न विमुञ्चसि\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2169315, "chapter_id": 4623, "verse_number": "समाप्तिः", "content_sanskrit": "इति रक्षो विसृष्टेषु विषवीर्यहतेषु च ।\nरक्षसा भैषजं प्रोक्तं संसिद्धञ्च न चोत्तरम्\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2169316, "chapter_id": 4623, "verse_number": "८९", "content_sanskrit": "ब्राह्मं पाञ्चालाः कौरवेयास्तु धर्म्यं\nसत्यं मत्स्याः शूरसेनाश्च यज्ञम् ।\nप्राच्या दासा वृषला दाक्षिणात्याः\nस्तेना बाह्लीकाः सङ्करा वै सुराष्ट्राः\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2169317, "chapter_id": 4623, "verse_number": "९०", "content_sanskrit": "कृतघ्नता परवित्तापहारो\nमद्यपानं गुरुदारावमर्दः ।\nवाक्पारुष्यं गोवधो रात्रिचर्या\nबहिर्गेहं परवस्त्रोपभोगः\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2169318, "chapter_id": 4623, "verse_number": "९१", "content_sanskrit": "येषां धर्मस्तान् प्रति नास्त्यधर्मो\nआरदेजान् पाञ्चनदान् धिगस्तु ।\nआपाञ्चालाः कुरवो नैमिशाश्च\nशिष्टान् धर्मानुपजीवन्ति वृद्धाः\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2169319, "chapter_id": 4623, "verse_number": "९२", "content_sanskrit": "प्राचीं दिशं स्थिता देवा जातवेदःपुरोगमाः ।\nदक्षिणा पितृभिर्गुप्ता यमेन शुभकर्मणा\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2169320, "chapter_id": 4623, "verse_number": "९३", "content_sanskrit": "प्रतीचीं वरुणः पाति पालयन्नसुरान् बहून् ।\nउदीचीं भगवान् सोमो ब्रह्मा च ब्राह्मणैः सह\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2169321, "chapter_id": 4623, "verse_number": "९४", "content_sanskrit": "रक्षः पिशाचान् हिमवान् गुह्यकान् गन्धमादनः ।\nध्रुवं सर्वाणि भूतानि विष्णुः पाति सुरोत्तमः\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2169322, "chapter_id": 4623, "verse_number": "९५", "content_sanskrit": "इङ्गितज्ञाश्च मगधाः प्रेक्षितज्ञाश्च कोसलाः ।\nअर्धोक्ताः कुरुपाञ्चालाः सर्वोक्ता दाक्षिणापथाः\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2169323, "chapter_id": 4623, "verse_number": "९६", "content_sanskrit": "पार्वतीयाश्च विषमास्तथैव शिबयस्तथा ।\nसर्वज्ञा यवना राजन् शूराश्चैव विशेषतः\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2169324, "chapter_id": 4623, "verse_number": "९७", "content_sanskrit": "म्लेच्छाः स्वसञ्ज्ञानियता नानुक्तमितरे जनाः\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2169325, "chapter_id": 4623, "verse_number": "९८", "content_sanskrit": "प्रतिरब्धास्तु बाह्लीका न च केचन मद्रकाः ।\nस त्वमेतादृशः शल्य नोत्तरं वक्तुमर्हसि\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2169326, "chapter_id": 4623, "verse_number": "९९", "content_sanskrit": "एवं ज्ञात्वा जोषमास्स्व प्रतीपं\nमा स्म क्रुध्यः पापभृतां वरिष्ठः ।\nपूर्वं हत्वा त्वां सपुत्रं बलैश्च\nपश्चाद्धंस्ये वासुदेवार्जुनौ च\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2169327, "chapter_id": 4623, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2169328, "chapter_id": 4623, "verse_number": "१००", "content_sanskrit": "आतुराणां परित्यागः स्वदारसुतविक्रयः ।\nअङ्गे प्रवर्तते कर्ण येषामधिपतिर्भवान्\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2169329, "chapter_id": 4623, "verse_number": "१०१", "content_sanskrit": "रथातिरथसङ्ख्यायां यत्त्वां भीष्मस्तदाब्रवीत् ।\nतान् विदित्वाऽऽत्मनो दोषान्निर्मन्युर्भव मा क्रुधः\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2169330, "chapter_id": 4623, "verse_number": "१०२", "content_sanskrit": "सर्वत्र ब्राह्मणाः सन्ति सन्ति सर्वत्र क्षत्रियाः ।\nवैश्याः शूद्रास्तथा कर्ण स्त्रियः साध्व्यश्च सुव्रताः\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2169331, "chapter_id": 4623, "verse_number": "१०३", "content_sanskrit": "रमन्ते चोपहासेन पुरुषाः पुरुषैः सह ।\nअन्योन्येन रताः क्षीबा देशे देशे समैथुनाः\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2169332, "chapter_id": 4623, "verse_number": "१०४", "content_sanskrit": "परवाच्येषु निपुणः सर्वो भवति सर्वदा ।\nआत्मवाच्यं न जानीते जानन्नपि च मुह्यति\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2169333, "chapter_id": 4623, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2169334, "chapter_id": 4623, "verse_number": "१०५", "content_sanskrit": "कर्णोऽपि नोत्तरं प्राह शल्योऽप्यभिमुखः परान्\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2169335, "chapter_id": 4623, "verse_number": "१०६", "content_sanskrit": "सर्वत्र सन्ति राजानः स्वं स्वं धर्ममनुव्रताः ।\nदुर्मनुष्यान्निगृह्णन्ति सन्ति सर्वत्र धार्मिकाः\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2169336, "chapter_id": 4623, "verse_number": "१०७", "content_sanskrit": "न कर्ण देशसामान्यात् सर्वः पापं निषेवते ।\nयादृशाः स्वस्वभावेन देशा अपि न तादृशाः\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2169337, "chapter_id": 4623, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2169338, "chapter_id": 4623, "verse_number": "१०८", "content_sanskrit": "ततो दुर्योधनो राजा कर्णशल्याववारयत् ।\nसखिभावेन राधेयं शल्यं सौजन्यकेन च\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2169339, "chapter_id": 4623, "verse_number": "१०९", "content_sanskrit": "ततो निवारितः कर्णो धार्तराष्ट्रेण मारिष ।\nपुनः प्रहस्य राधेयः पुनर्याहीत्यचोदयत्\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2169340, "chapter_id": 4623, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nकर्णशल्यसंवादे त्रिचत्वारिंशोऽध्यायः ॥४३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}]