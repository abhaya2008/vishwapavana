[{"id": 2150890, "chapter_id": 4276, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150891, "chapter_id": 4276, "verse_number": "१", "content_sanskrit": "तेषामृद्धिर्बहुविधा दृश्यते दैवमानुषी ।\nअशक्या परिसङ्ख्यातुं श्रद्धेया तु बुभूषता ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150892, "chapter_id": 4276, "verse_number": "२", "content_sanskrit": "यां तु पृच्छसि मा राजन् दिव्यामेतां शशाकृतिम् ।\nपार्श्वे शशस्य द्वे वर्षे उभये दक्षिणोत्तरे ।\nकर्णौ तु नागद्वीपं च कश्यपद्वीपमेव च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150893, "chapter_id": 4276, "verse_number": "३", "content_sanskrit": "जम्बूद्वीपस्य सर्वस्य आकृतिं चन्द्रमण्डले ।\nस वै सुदर्शनद्वीपो दृश्यते शशवद् विधौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150894, "chapter_id": 4276, "verse_number": "४", "content_sanskrit": "तिस्रवर्णः शिरो राजन् श्रीमान् मलयपर्वतः ।\nएतद् द्वितीयं द्वीपस्य दृश्यते शशसंस्थितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150895, "chapter_id": 4276, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150896, "chapter_id": 4276, "verse_number": "५", "content_sanskrit": "मेरोरथोत्तरं पार्श्वं पूर्वं चाचक्ष्व सञ्जय ।\nनिखिलेन महाबुद्धे माल्यवन्तं च पर्वतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150897, "chapter_id": 4276, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150898, "chapter_id": 4276, "verse_number": "६", "content_sanskrit": "दक्षिणेन तु नीलस्य मेरोः पार्श्वे तथोत्तरे ।\nउत्तराः कुरवो राजन् पुण्याः सिद्धनिषेविताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150899, "chapter_id": 4276, "verse_number": "७", "content_sanskrit": "तत्र वृक्षा मधुफला नित्यपुष्पफलोपगाः ।\nपुष्पाणि च सुगन्धीनि रसवन्ति फलानि च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150900, "chapter_id": 4276, "verse_number": "८", "content_sanskrit": "सर्वकामफलास्तत्र केचिद् वृक्षा जनाधिप ।\nअपरे क्षीरिणो नाम वृक्षास्तत्र नराधिप ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150901, "chapter_id": 4276, "verse_number": "९", "content_sanskrit": "ये क्षरन्ति सदा क्षीरं षड्रसं ह्यमृतोपमम् ।\nवस्त्राणि च प्रसूयन्ते फलेष्वाभरणानि च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150902, "chapter_id": 4276, "verse_number": "१०", "content_sanskrit": "सर्वा मणिमयी भूमिः सूक्ष्मकाञ्चनवालुका ।\nसर्वत्र सुखसंस्पर्शा निष्पङ्का च जनाधिप ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150903, "chapter_id": 4276, "verse_number": "", "content_sanskrit": "मणिरत्ननिभं रम्यं वज्रवैडूर्यसन्निभम् ।\nभूभागो दृश्यते तत्र पद्मरागसमप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150904, "chapter_id": 4276, "verse_number": "११", "content_sanskrit": "देवलोकच्युताः सर्वे जायन्ते तत्र मानवाः ।\nतुल्यरूपगुणोपेताः समेषु विषमेषु च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150905, "chapter_id": 4276, "verse_number": "१२", "content_sanskrit": "मिथुनानि च जायन्ते स्त्रियश्चाप्सरसोपमाः ।\nतेषां ते क्षीरिणां क्षीरं पिबन्त्यमृतसन्निभम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150906, "chapter_id": 4276, "verse_number": "१३", "content_sanskrit": "मिथुनं जायमानं वै समं तच्च प्रवर्धते ।\nतुल्यरूपगुणोपेतं समवेषं तथैव च ।\nएकैकमनुरक्तं च चक्रवाकसमं विभो ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150907, "chapter_id": 4276, "verse_number": "१४", "content_sanskrit": "निरामया वीतशोका नित्यं मुदितमानसाः ।\nदश वर्षसहस्राणि दश वर्षशतानि च ।\nजीवन्ति ते महाराज न चान्योन्यं जहत्युत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150908, "chapter_id": 4276, "verse_number": "१५", "content_sanskrit": "भारुण्डा नाम शकुनास्तीक्ष्णतुण्डा महाबलाः ।\nते निर्हरन्ति हि मृतान् दरीषु प्रक्षिपन्ति च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150909, "chapter_id": 4276, "verse_number": "१६", "content_sanskrit": "उत्तराः कुरवो राजन् व्याख्यातास्ते समासतः ।\nमेरोः पार्श्वमहं पूर्वं वक्ष्याम्यथ यथातथम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150910, "chapter_id": 4276, "verse_number": "१७", "content_sanskrit": "तस्य मूर्द्धाभिषेकस्तु भद्राश्वस्य विशाम्पते ।\nभद्रसालवनं यत्र कालाम्रश्च महाद्रुमः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150911, "chapter_id": 4276, "verse_number": "१८", "content_sanskrit": "कामाम्रश्च महाराज नित्यपुष्पफलः शुभः ।\nद्वीपश्च योजनोत्सेधः सिद्धचारणसेवितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150912, "chapter_id": 4276, "verse_number": "१९", "content_sanskrit": "तत्र ते पुरुषाः श्वेतास्तेजोयुक्ता महाबलाः ।\nस्त्रियः कुमुदवर्णाश्च सुन्दर्यः प्रियदर्शनाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150913, "chapter_id": 4276, "verse_number": "२०", "content_sanskrit": "चन्द्रप्रभाश्चन्द्रवर्णाः पूर्णचन्द्रनिभाननाः ।\nचन्द्रशीतलगात्र्यश्च नृत्तगीतविशारदाः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150914, "chapter_id": 4276, "verse_number": "२१", "content_sanskrit": "दश वर्षसहस्राणि तत्रायुर्भरतर्षभ ।\nकामाम्ररसपीतास्ते नित्यं संस्थितयौवनाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150915, "chapter_id": 4276, "verse_number": "२२", "content_sanskrit": "दक्षिणेन तु नीलस्य निषधस्योत्तरेण तु ।\nसुदर्शनो नाम महान् जम्बूवृक्षः सनातनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2150916, "chapter_id": 4276, "verse_number": "२३", "content_sanskrit": "सर्वकामफलः पुण्यः सिद्धचारणसेवितः ।\nतस्य नाम्ना समाख्यातो जम्बूद्वीपः सनातनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2150917, "chapter_id": 4276, "verse_number": "२४", "content_sanskrit": "योजनानां सहस्रं च शतं च भरतर्षभ ।\nउत्सेधो वृक्षराजस्य दिवस्पृङ् मनुजेश्वर ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2150918, "chapter_id": 4276, "verse_number": "२५", "content_sanskrit": "अरत्नीनां सहस्रं च शतानि दश पञ्च च ।\nपरिणाहस्तु वृक्षस्य फलानां रसभेदिनाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2150919, "chapter_id": 4276, "verse_number": "२६", "content_sanskrit": "पतमानानि तान्युर्व्यां कुर्वन्ति विपुलं स्वनम् ।\nमुञ्चन्ति च रसं राजंस्तस्मिन् रजतसन्निभम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2150920, "chapter_id": 4276, "verse_number": "२७", "content_sanskrit": "तस्याः जम्ब्वाः फलरसो नदी भूत्वा जनाधिप ।\nमेरुं प्रदक्षिणं कृत्वा सम्प्रयात्युत्तरान् कुरून् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2150921, "chapter_id": 4276, "verse_number": "२८", "content_sanskrit": "पिबन्ति तद्रसं हृष्टा जना नित्यं जनाधिप ।\nतस्मिन् फलरसे पीते न जरा बाधते च तान् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2150922, "chapter_id": 4276, "verse_number": "२९", "content_sanskrit": "तत्र जाम्बूनदं नाम कनकं देवभूषणम् ।\nतरुणादित्यवर्णाश्च जायन्ते तत्र मानवाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2150923, "chapter_id": 4276, "verse_number": "३०", "content_sanskrit": "तथा माल्यवतः शृङ्गे दीप्यते तत्र हव्यवाट् ।\nनाम्ना संवर्तको नाम कालाग्निर्भरतर्षभ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2150924, "chapter_id": 4276, "verse_number": "३१", "content_sanskrit": "तथा माल्यवतः शृङ्गे पूर्वे पूर्वे तु गण्डका ।\nयोजनानां सहस्राणि पञ्चाशन्माल्यवान् स्थितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2150925, "chapter_id": 4276, "verse_number": "३२", "content_sanskrit": "महारजतसङ्काशा जायन्ते तत्र मानवाः ।\nब्रह्मलोकाच्च्युताः सर्वे सर्वे च ब्रह्मवादिनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2150926, "chapter_id": 4276, "verse_number": "३३", "content_sanskrit": "तपस्तु तप्यमानास्ते भवन्ति ह्यूर्ध्वरेतसः ।\nरक्षणार्थं तु भूतानां प्रविशन्ति दिवाकरम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2150927, "chapter_id": 4276, "verse_number": "३४", "content_sanskrit": "षष्टिस्तानि सहस्राणि षष्टिरेव शतानि च ।\nअरुणस्याग्रतो यान्ति परिवार्य दिवाकरम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2150928, "chapter_id": 4276, "verse_number": "", "content_sanskrit": "षष्टिं वर्षसहस्राणि षष्टिमेव शतानि च ।\nआदित्यतापतप्तास्ते विशन्ति शशिमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2150929, "chapter_id": 4276, "verse_number": "८", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां भीष्मपर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2150930, "chapter_id": 4276, "verse_number": "", "content_sanskrit": "॥ इति जम्बूखण्डनिर्माणपर्वणि अष्टमोऽध्यायः ॥८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]