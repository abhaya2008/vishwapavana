[{"id": 2094065, "chapter_id": 3012, "verse_number": "१३-१४२-१", "content_sanskrit": "भीष्म उवाच।\nअथात्रिप्रमुखा राजन्वने तस्मिन्महर्षयः।\nव्यचरन्भक्षयन्तो वै मूलानि च फलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094066, "chapter_id": 3012, "verse_number": "१३-१४२-२", "content_sanskrit": "अथापश्यन्सुपीनांसपाणिपादमुखोदरम्।\nपरिव्रजन्तं स्थूलाङ्गं परिव्राजं शुनस्सखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094067, "chapter_id": 3012, "verse_number": "१३-१४२-३", "content_sanskrit": "अरुन्धती तु तं दृष्ट्वा सर्वाङ्गोपचितं शुभम्।\nभवितारो भवन्तो वै नैवमित्यब्रवीदृषीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094068, "chapter_id": 3012, "verse_number": "१३-१४२-४x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094069, "chapter_id": 3012, "verse_number": "१३-१४२-४", "content_sanskrit": "नैतस्येह यथाऽस्माकमग्निहोत्रमनिर्हुतम्।\nसायं प्रातश्च होतव्यं तेन पीवाञ्शुनस्सखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094070, "chapter_id": 3012, "verse_number": "१३-१४२-५x", "content_sanskrit": "अत्रिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094071, "chapter_id": 3012, "verse_number": "१३-१४२-५", "content_sanskrit": "नैतस्येह यथाऽस्माकं क्षुधया वीर्यमाहतम्।\nकृच्छ्राधीतं प्रनष्टं च तेन पीवाञ्छुनस्सखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094072, "chapter_id": 3012, "verse_number": "१३-१४२-६x", "content_sanskrit": "विश्वामित्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094073, "chapter_id": 3012, "verse_number": "१३-१४२-६", "content_sanskrit": "नैतस्येह यथाऽस्माकं शश्वच्छास्त्रकृतो ज्वरः।\nअलसः क्षुत्परो मूर्खस्तेन पीवाञ्शुनस्सखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094074, "chapter_id": 3012, "verse_number": "१३-१४२-७x", "content_sanskrit": "जमदग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094075, "chapter_id": 3012, "verse_number": "१३-१४२-७", "content_sanskrit": "नैतस्येह यथाऽस्माकं भक्तमिन्धनमेव च।\nसञ्चित्यं वार्षिकं चित्ते तेन पीवाञ्शुनस्सखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094076, "chapter_id": 3012, "verse_number": "१३-१४२-८x", "content_sanskrit": "कश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094077, "chapter_id": 3012, "verse_number": "१३-१४२-८", "content_sanskrit": "नैतस्येह यथाऽस्माकं चत्वारश्च सहोदराः।\nदेहिदेहीति भिक्षन्ति तेन पीवाञ्शुनस्सखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094078, "chapter_id": 3012, "verse_number": "१३-१४२-९x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094079, "chapter_id": 3012, "verse_number": "१३-१४२-९", "content_sanskrit": "नैतस्येह यथाऽस्माकं ब्रह्मबन्धोरचेतसः।\nशोको भार्यापवादेन तेन पीवाञ्शुनस्सखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094080, "chapter_id": 3012, "verse_number": "१३-१४२-१०x", "content_sanskrit": "गौतम उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094081, "chapter_id": 3012, "verse_number": "१३-१४२-१०", "content_sanskrit": "नैतस्येह यथाऽस्माकं त्रिकौशेयं च राङ्कवम्।\nएकैकं वै त्रिवर्षीयं तेन पीवाञ्शुनस्सखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094082, "chapter_id": 3012, "verse_number": "१३-१४२-११x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094083, "chapter_id": 3012, "verse_number": "१३-१४२-११", "content_sanskrit": "अथ दृष्ट्वा परिव्राट् स तान्महर्षीञ्शुनस्सखः।\nअभिवाद्य यथान्यायं पाणिस्पर्शमथाचरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094084, "chapter_id": 3012, "verse_number": "१३-१४२-१२", "content_sanskrit": "परिचर्यां वने तां तु क्षुत्प्रतीकारकाङ्क्षिणः।\nअन्योन्येन निवेद्याथ प्रातिष्ठन्त सहैव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094085, "chapter_id": 3012, "verse_number": "१३-१४२-१३", "content_sanskrit": "एकनिश्चयकार्याश्च व्यचरन्त वनानि ते।\nआददानाः समुद्धृत्य मूलानि च फलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094086, "chapter_id": 3012, "verse_number": "१३-१४२-१४", "content_sanskrit": "कदाचिद्विचरन्तस्ते वृक्षैरविरलैर्वृताम्।\nशुचिपूर्णप्रसन्नोदां ददृशुः पद्मिनीं शुभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094087, "chapter_id": 3012, "verse_number": "१३-१४२-१५", "content_sanskrit": "बालादित्यवपुःप्रख्यैः पुष्करैरुपशोभिताम्।\nवैडूर्यवर्णसदृशैः पद्मपत्रैरथावृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094088, "chapter_id": 3012, "verse_number": "१३-१४२-१६", "content_sanskrit": "नानाविधैश्च विहगैर्जलप्रवरसेविभिः।\nएकद्वारामनादेयां सूपतीर्थामकर्दमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094089, "chapter_id": 3012, "verse_number": "१३-१४२-१७", "content_sanskrit": "वृषादर्भिप्रयुक्ता तु कृत्या विकृतदर्शना।\nयातुधानीति विख्याता पद्मिनीं तामरक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094090, "chapter_id": 3012, "verse_number": "१३-१४२-१८", "content_sanskrit": "शुनस्सखसहायास्तु बिसार्थं ते महर्षयः।\nपद्मिनीमभिजग्मुस्ते सर्वे कृत्याभिरक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094091, "chapter_id": 3012, "verse_number": "१३-१४२-१९", "content_sanskrit": "ततस्ते यातुधानीं तां दृष्ट्वा विकृतदर्शनाम्।\nस्थितां कमलिनीतीरे कृत्यामूचुर्महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094092, "chapter_id": 3012, "verse_number": "१३-१४२-२०", "content_sanskrit": "एका तिष्ठसि का च त्वं कस्यार्थे किं प्रयोजनम्।\nपद्मिनीतीरमाश्रित्य ब्रूहि त्वं किं चिकीर्षसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094093, "chapter_id": 3012, "verse_number": "१३-१४२-२१x", "content_sanskrit": "यातुधान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094094, "chapter_id": 3012, "verse_number": "१३-१४२-२१", "content_sanskrit": "याऽस्मि काऽस्म्यनुयोगो मे न कर्तव्यः कथञ्चन।\nआरक्षिणीं मा पद्मिन्या वित्त सर्वे तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094095, "chapter_id": 3012, "verse_number": "१३-१४२-२२x", "content_sanskrit": "ऋषय ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2094096, "chapter_id": 3012, "verse_number": "१३-१४२-२२", "content_sanskrit": "सर्व एव क्षुधार्ताः स्म न चान्यत्किंचिदस्ति नः।\nभवत्याः सम्मते सर्वे गृह्णीयाम बिसान्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2094097, "chapter_id": 3012, "verse_number": "१३-१४२-२३x", "content_sanskrit": "यातुधान्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2094098, "chapter_id": 3012, "verse_number": "१३-१४२-२३", "content_sanskrit": "समयेन बिसानीतो गृह्णीध्वं कामकारतः।\nएकैको नाम मे प्रोक्त्वा ततो गृह्णीत माचिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2094099, "chapter_id": 3012, "verse_number": "१३-१४२-२४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2094100, "chapter_id": 3012, "verse_number": "१३-१४२-२४", "content_sanskrit": "विज्ञाय यातुधानीं तां कृत्यमृषिवधैषिणीम्।\nअत्रिः क्षुधा परीतात्मा ततो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2094101, "chapter_id": 3012, "verse_number": "१३-१४२-२५x", "content_sanskrit": "अत्त्रिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2094102, "chapter_id": 3012, "verse_number": "१३-१४२-२५", "content_sanskrit": "अरात्त्रिरत्त्रिः सा रात्रिर