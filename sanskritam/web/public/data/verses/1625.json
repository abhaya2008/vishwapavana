[{"id": 2028748, "chapter_id": 1625, "verse_number": "३-२६३-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028749, "chapter_id": 1625, "verse_number": "३-२६३-१", "content_sanskrit": "वसत्स्वेवं वने तेषु पाण्डवेषु महात्मसु।\nरममाणएषु चित्राबिः कथाभिर्मुनिभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028750, "chapter_id": 1625, "verse_number": "३-२६३-२", "content_sanskrit": "सूर्यदत्ताक्षयान्नेन कृष्णाया भोजनावधि।\nब्राह्मणांस्तर्पमाणेषु ये चान्नार्थमुपागताः।\nआरण्यानां मृगाणां च मांसैर्नानाविधैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028751, "chapter_id": 1625, "verse_number": "३-२६३-३", "content_sanskrit": "धार्तराष्ट्रा दुरात्मानः सर्वे दुर्योधनादयः।\nकथं तेष्वन्ववर्तन्त पापाचारा महामुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028752, "chapter_id": 1625, "verse_number": "३-२६३-४", "content_sanskrit": "दःशासनस्य कर्णस्य शकुनेश्च मते स्थिताः।\nएतदाचक्ष्व भगवन्वैशम्पायन पृच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028753, "chapter_id": 1625, "verse_number": "३-२६३-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028754, "chapter_id": 1625, "verse_number": "३-२६३-५", "content_sanskrit": "श्रुत्वा तेषां तथा वृत्तिं नगरे वसतामिव।\nदुर्योधनो महाराज तेषु पापमरोचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028755, "chapter_id": 1625, "verse_number": "३-२६३-६", "content_sanskrit": "तथा तैर्निकृतिप्रज्ञैः कर्णदुःशासनादिभिः।\nनानोपायैरधं तेषु चिन्तयत्सु दुरात्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028756, "chapter_id": 1625, "verse_number": "३-२६३-७", "content_sanskrit": "अभ्यागच्छत्स धर्मात्मा तपस्वी कसुमहायशाः।\nशिष्यायुतसमोपेतो दुर्वासा नाम कामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028757, "chapter_id": 1625, "verse_number": "३-२६३-८", "content_sanskrit": "तमागतमभिप्रेक्ष्य मुनिं परमकोपनम्।\nसहितो भ्रातृभिः श्रीमानातिथ्येन न्यमन्त्रयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028758, "chapter_id": 1625, "verse_number": "३-२६३-९", "content_sanskrit": "विधिवत्पूजयामास स्वयं किंकरवत्स्थितः।\nअहानि कतिचित्तत्र तस्थौ स मुनिसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028759, "chapter_id": 1625, "verse_number": "३-२६३-१०", "content_sanskrit": "तं च पर्यचरद्राजा दिवारात्रमतन्द्रितः।\nदुर्योधनो महाराज शापात्तस्य विशङ्कितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028760, "chapter_id": 1625, "verse_number": "३-२६३-११", "content_sanskrit": "क्षुधितोऽस्मि ददस्वान्नं शीघ्रं मम नराधिप।\nइत्युक्त्वा गच्छति स्नातुं प्र्यागच्चति वै चिरात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028761, "chapter_id": 1625, "verse_number": "३-२६३-१२", "content_sanskrit": "न भोक्ष्याम्यद्यमे नास्ति क्षुधेत्युक्त्वैत्यदर्शनम्।\nअकस्मादेत्य च ब्रूते भोजनयास्मांस्त्वरान्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028762, "chapter_id": 1625, "verse_number": "३-२६३-१३", "content_sanskrit": "कदाचिच्च निशीथे स उत्थाय निकृतौ स्थितः।\nपूर्ववत्कारयित्वाऽन्नं न भुङ्क्ते गर्हयन्स्म सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028763, "chapter_id": 1625, "verse_number": "३-२६३-१४", "content_sanskrit": "वर्तमाने तथा तस्मिन्यदा दुर्योधनो नृपः।\nविकृतिं नैति न क्रोधं तदा तुष्टोऽभवन्मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028764, "chapter_id": 1625, "verse_number": "३-२६३-१५", "content_sanskrit": "आहचैनं दुराधर्षो वरदोऽस्मीति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028765, "chapter_id": 1625, "verse_number": "३-२६३-१६", "content_sanskrit": "वरं वरय भद्रं ते यत्ते मनसि वर्तते।\nमयि प्रीते तु यद्धर्म्यं नालभ्यं विद्यते तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028766, "chapter_id": 1625, "verse_number": "३-२६३-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028767, "chapter_id": 1625, "verse_number": "३-२६३-१७", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्य महर्षेर्भावितात्मनः।\nअमन्यत पुनर्जातमात्मानं स सुयोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028768, "chapter_id": 1625, "verse_number": "३-२६३-१८", "content_sanskrit": "प्रागेव मन्त्रितं चासीत्कर्णदुःशासनादिभिः।\nयाचनीयं मुनेस्तुष्टादिति निश्चित्य दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028769, "chapter_id": 1625, "verse_number": "३-२६३-१९", "content_sanskrit": "अतिहर्षान्वितो राजन्वरमेनमयाचत।\nशिष्यैः सह मम ब्रह्मन्यथा जातोऽतिथिर्भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028770, "chapter_id": 1625, "verse_number": "३-२६३-२०", "content_sanskrit": "अस्मत्कुले महाराजो ज्येष्ठः श्रेष्ठो युधिष्ठिरः।\nवने वसति धर्मात्मा भ्रातृभिः परिवारितः।\nगुणवाञ्शीलसंपन्नस्तस्य त्वमतिथिर्भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028771, "chapter_id": 1625, "verse_number": "३-२६३-२१", "content_sanskrit": "यदा च राजपुत्री सा सुकुमारी यशस्विनी।\nभोजयित्वा द्विजान्सर्वान्पतींश्च वरवर्णिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028772, "chapter_id": 1625, "verse_number": "३-२६३-२२", "content_sanskrit": "विश्रान्ता च स्वयं भुक्त्वा सुखासीना भवेद्यदा।\nतदा त्वं तत्रगच्छेथा यद्यनुग्राह्यता मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028773, "chapter_id": 1625, "verse_number": "३-२६३-२३", "content_sanskrit": "तथा करिष्ये त्वत्प्रीत्येत्येवमुक्त्वा सुयोधनम्।\nदुर्वासा अपिविप्रेन्द्रो यथागतमगात्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028774, "chapter_id": 1625, "verse_number": "३-२६३-२४", "content_sanskrit": "कृतार्थमपि चात्मानं तदा मेने सुयोधनः।\nकरेण च करं गृह्य कर्णस्य मुदितो भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028775, "chapter_id": 1625, "verse_number": "३-२६३-२५", "content_sanskrit": "कर्णोपि भ्रातृसहितमित्युवाच नृपं मुदा।\nदुष्ट्या कामः सुसंवृत्तोदिष्ट्या कौरव वर्धसे।\nदिष्ट्या ते शत्रवो मग्ना दुस्तरे व्यसनार्णवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028776, "chapter_id": 1625, "verse_number": "३-२६३-२६", "content_sanskrit": "दुर्वासःक्रोधजे वह्नौ पतिताः पाण्डुनन्दनाः।\nस्वैरेव ते महापापैर्गता वै दुस्तरं तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028777, "chapter_id": 1625, "verse_number": "३-२६३-२७x", "content_sanskrit": "वैशंपायु उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028778, "chapter_id": 1625, "verse_number": "३-२६३-२७", "content_sanskrit": "इत्थं ते निकृतिप्रज्ञा राजन्दुर्योधनादयः।\nहसन्तः प्रीतमनसो जग्मुः स्वंस्वं निकेतनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028779, "chapter_id": 1625, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि द्रौपदीहरणपर्वणि त्रिषष्ट्यधिकद्विशततमोऽध्यायः ॥ २६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]