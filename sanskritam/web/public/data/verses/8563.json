[{"id": 900007495, "chapter_id": 8563, "verse_number": "144.1", "content_sanskrit": "तद्यथेति श्रुतेश्चैव ततः कर्मक्षयो भवेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007496, "chapter_id": 8563, "verse_number": "144.2", "content_sanskrit": "यथैधांसि समिद्धोर्ग्निभस्मसात्कुरुतेऽर्जुन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007497, "chapter_id": 8563, "verse_number": "144.3", "content_sanskrit": "नित्यनैमित्तिकं कर्म कुर्वन्नन्यत्परित्यजन्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007498, "chapter_id": 8563, "verse_number": "144.4", "content_sanskrit": "एतदप्येतेन निराकृतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007499, "chapter_id": 8563, "verse_number": "144.5", "content_sanskrit": "विद्यैवेतीममेवार्थं स्वयमेवाह वेदराट्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007500, "chapter_id": 8563, "verse_number": "144.6", "content_sanskrit": "विना कर्म न मोक्षः स्याज्ज्ञानेनेत्यपि सा श्रुतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007501, "chapter_id": 8563, "verse_number": "144.7", "content_sanskrit": "अन्यथोपासनमपि तमेवमिति वादिनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007502, "chapter_id": 8563, "verse_number": "144.8", "content_sanskrit": "अन्धन्तमः प्रविशन्ति ये त्वविद्यामुपासते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900007503, "chapter_id": 8563, "verse_number