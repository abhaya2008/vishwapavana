[{"id": 6000232000, "chapter_id": 10232, "verse_number": null, "content_sanskrit": "अथ षट्त्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000232001, "chapter_id": 10232, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.001.m4a", "display_order": 2}, {"id": 6000232002, "chapter_id": 10232, "verse_number": "१०-३६-१", "content_sanskrit": "अक्रूरोऽपि च तां रात्रिं मधुपुर्यां महामतिः।\nउषित्वा रथमास्थाय प्रययौ नन्दगोकुलम्॥ १०/३६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.002.m4a", "display_order": 3, "topics": [{"text": "अक्रूरस्य नन्दगोकुलगमनम्", "range": "१–२५"}]}, {"id": 6000232003, "chapter_id": 10232, "verse_number": "१०-३६-२", "content_sanskrit": "गच्छन् पथि महाभागो भगवत्यम्बुजेक्षणे।\nभक्तिं परामुपगत एवमेतदचिन्तयत्॥ १०/३६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.003.m4a", "display_order": 4}, {"id": 6000232004, "chapter_id": 10232, "verse_number": null, "content_sanskrit": "अक्रूर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.004.m4a", "display_order": 5}, {"id": 6000232005, "chapter_id": 10232, "verse_number": "१०-३६-३", "content_sanskrit": "किं मयाऽऽचरितं भद्रं किं तप्तं परमं तपः।\nकिं वाऽथाप्यर्हते दत्तं यद् द्रक्ष्याम्यद्य केशवम्॥ १०/३६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.005.m4a", "display_order": 6}, {"id": 6000232006, "chapter_id": 10232, "verse_number": "१०-३६-४", "content_sanskrit": "ममैतद् दुर्लभं मन्ये उत्तमश्लोकदर्शनम्।\nविषयात्मनो यथा ब्रह्मकीर्तनं शूद्रजन्मनः॥ १०/३६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.006.m4a", "display_order": 7}, {"id": 6000232007, "chapter_id": 10232, "verse_number": "१०-३६-५", "content_sanskrit": "मैवं मामवमंस्यामि स्यादेवाच्युतदर्शनम्।\nह्रियमाणः कालनद्या क्‍वचित् तरति कश्चन॥ १०/३६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.007.m4a", "display_order": 8}, {"id": 6000232008, "chapter_id": 10232, "verse_number": "१०-३६-६", "content_sanskrit": "ममाद्यामङ्गलं नष्टं फलवांश्चैव मे भवः।\nयन्नमस्ये भगवतो योगिध्येयाङ्घ्रिपङ्कजम्॥ १०/३६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.008.m4a", "display_order": 9}, {"id": 6000232009, "chapter_id": 10232, "verse_number": "१०-३६-७", "content_sanskrit": "कंसो बताद्याकृत मेऽत्यनुग्रहं द्रक्ष्येऽङ्घ्रिपद्मं प्रहितोऽमुना हरेः।\nकृतावतारस्य दुरत्ययं तमः पूर्वेऽतरन् यन्नखमण्डलत्विषा॥ १०/३६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.009.m4a", "display_order": 10}, {"id": 6000232010, "chapter_id": 10232, "verse_number": "१०-३६-८", "content_sanskrit": "यदर्चितं ब्रह्मभवादिभिः सुरैः श्रिया च देव्या मुनिभिः ससात्वतैः।\nगोचारणायानुचरैश्चरद्वने यद् गोपिकानां कुचकुङ्कुमाङ्कितम्॥ १०/३६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.010.m4a", "display_order": 11}, {"id": 6000232011, "chapter_id": 10232, "verse_number": "१०-३६-९", "content_sanskrit": "द्रक्ष्यामि नूनं सुकपोलनासिकं स्मितावलोकारुणकञ्जलोचनम्।\nमुखं मुकुन्दस्य गुडालकावृतं प्रदक्षिणं मे प्रचरन्ति वै मृगाः॥ १०/३६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.011.m4a", "display_order": 12}, {"id": 6000232012, "chapter_id": 10232, "verse_number": "१०-३६-१०", "content_sanskrit": "अप्यद्य विष्णोर्मनुजत्वमीयुषो भारावताराय भुवो निजेच्छया।\nलावण्यधाम्नो भवितोपलम्भनं मह्यं ननु स्यात् फलमद्य सन्दृशः॥ १०/३६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.012.m4a", "display_order": 13}, {"id": 6000232013, "chapter_id": 10232, "verse_number": "१०-३६-११", "content_sanskrit": "य ईक्षिताऽहंरहितोऽप्यसत्सतोः स्वतेजसाऽपास्ततमोभिदाभ्रमः।\nस्वमाययाऽऽत्मन् रचितेषु तत् सन् प्राणादिभिर्जन्तुषु भाति चित्रधा॥ १०/३६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.013.m4a", "display_order": 14}, {"id": 6000232014, "chapter_id": 10232, "verse_number": "१०-३६-१२", "content_sanskrit": "यस्याखिलामीवहभिः सुमङ्गलैर्वाचो विमिश्रा गुणकर्मजन्मभिः।\nप्राणन्ति शुम्भन्ति पुनन्ति वै जगद् यास्तद्विरक्ताः स्युरशोभना मताः॥ १०/३६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.014.m4a", "display_order": 15}, {"id": 6000232015, "chapter_id": 10232, "verse_number": "१०-३६-१३", "content_sanskrit": "स चावतीर्णः किल सात्वतान्वये स्वसेतुपालामरवर्यशर्मकृत्।\nयशो वितन्वन् व्रज आस्त ईश्वरो गायन्ति देवास्तदशेषमङ्गलम्॥ १०/३६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.015.m4a", "display_order": 16}, {"id": 6000232016, "chapter_id": 10232, "verse_number": "१०-३६-१४", "content_sanskrit": "तं त्वद्य नूनं महतां गतिं गुरुं त्रैलोक्यकान्तं दृशिमन्महोत्सवम्।\nरूपं दधानं श्रिय ईप्सितास्पदं द्रक्ष्ये ममासन्नुषसः सुदर्शनाः॥ १०/३६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.016.m4a", "display_order": 17}, {"id": 6000232017, "chapter_id": 10232, "verse_number": "१०-३६-१५", "content_sanskrit": "अप्यङ्घ्रिमूले पतितस्य मे विभुः शिरस्यधास्यन्निजहस्तपङ्कजम्।\nदत्ताभयं कालभुजङ्गरंहसा प्रोद्वेजितानां शरणैषिणां नृणाम्॥ १०/३६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.017.m4a", "display_order": 18}, {"id": 6000232018, "chapter_id": 10232, "verse_number": "१०-३६-१६", "content_sanskrit": "समर्हणं यत्र निधाय कौशिकस्तथा बलिश्चाप जगत्त्रयेन्द्रताम्।\nयद् वा विहारे व्रजयोषितां श्रमं स्पर्शेन सौगन्धिकगन्ध्यपानुदत्॥ १०/३६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.018.m4a", "display_order": 19}, {"id": 6000232019, "chapter_id": 10232, "verse_number": "१०-३६-१७", "content_sanskrit": "न मय्युपैत्यप्रियबुद्धिमच्युतः कंसस्य भृत्यः प्रहितोऽपि विश्वदृक्।\nयोऽन्तर्बहिश्चेतस एतदीहितं क्षेत्रज्ञ ईक्षत्यमलेन चक्षुषा॥ १०/३६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.019.m4a", "display_order": 20}, {"id": 6000232020, "chapter_id": 10232, "verse_number": "१०-३६-१८", "content_sanskrit": "अप्यङ्घ्रिमूले पतितं कृताञ्जलिं मामीक्षते सस्मितमार्द्रया दृशा।\nसपद्यपध्वस्तसमस्तकिल्बिषो वोढा मुदं वीतविशङ्क ऊर्जिताम्॥ १०/३६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.020.m4a", "display_order": 21}, {"id": 6000232021, "chapter_id": 10232, "verse_number": "१०-३६-१९", "content_sanskrit": "सुहृत्तमं ज्ञातिमनन्यदैवतं दोर्भ्यां बृहद्भ्यां परिरप्स्यतेऽथ माम्।\nआत्मा हि तीर्थीक्रियते तदैव मे बन्धश्च कामात्मक उच्छ्वसित्यतः॥ १०/३६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.021.m4a", "display_order": 22}, {"id": 6000232022, "chapter_id": 10232, "verse_number": "१०-३६-२०", "content_sanskrit": "लब्धाङ्गसङ्गं प्रणतं कृताञ्जलिं मां वक्ष्यतेऽक्रूर ततेत्युरुश्रवाः।\nतदा वयं जन्मभृतो महीयसा नैवादृतो यो धिगमुष्य जन्म तत्॥ १०/३६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.022.m4a", "display_order": 23}, {"id": 6000232023, "chapter_id": 10232, "verse_number": "१०-३६-२१", "content_sanskrit": "न तस्य कश्चिद् दयितः सुहृत्तमो न वाऽप्रियो द्वेष्य उपेक्ष्य २एव च।\nतथापि भक्तान् भजते यथा यथा सुरद्रुमो यद्वदुपाश्रितार्थदः॥ १०/३६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.023.m4a", "display_order": 24}, {"id": 6000232024, "chapter_id": 10232, "verse_number": "१०-३६-२२", "content_sanskrit": "किञ्चाग्रजो माऽवनतं यदूत्तमः स्मयन् परिष्वज्य गृहीतसञ्चितौ।\nगृहं प्रवेश्याप्तसमस्तसत्कृतं सम्प्रक्ष्यते कंसकृतं स्वबन्धुषु॥ १०/३६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.024.m4a", "display_order": 25}, {"id": 6000232025, "chapter_id": 10232, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.025.m4a", "display_order": 26}, {"id": 6000232026, "chapter_id": 10232, "verse_number": "१०-३६-२३", "content_sanskrit": "इति सञ्चिन्तयन् कृष्णं श्वफल्कतनयोऽध्वनि।\nरथेन गोकुलं प्राप्तः सूर्यश्चास्तगिरिं नृप॥ १०/३६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.026.m4a", "display_order": 27}, {"id": 6000232027, "chapter_id": 10232, "verse_number": "१०-३६-२४", "content_sanskrit": "पदानि तस्याखिललोकपालकिरीटचूडामणिपादरेणोः।\nददर्श गोष्ठे क्षितिकौतुकानि विलिक्षितान्यब्जयवाङ्कुशाद्यैः॥ १०/३६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.027.m4a", "display_order": 28}, {"id": 6000232028, "chapter_id": 10232, "verse_number": "१०-३६-२५", "content_sanskrit": "तद्दर्शनाह्लादविवृद्धसम्भ्रमः प्रेम्णोत्थरोमाऽश्रुकलाकुलेक्षणः।\nरथादवस्कन्द्य स तेष्वचेष्टत प्रभोरिमान्यङ्घ्रिरजांस्यहो इति॥ १०/३६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.028.m4a", "display_order": 29}, {"id": 6000232029, "chapter_id": 10232, "verse_number": "१०-३६-२६", "content_sanskrit": "ददर्श कृष्णं रामं च व्रजे गोदोहनं गतौ।\nपीतनीलाम्बरधरौ शारदाम्बुरुहेक्षणौ॥ १०/३६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.029.m4a", "display_order": 30, "topics": [{"text": "बलरामकृष्णयोः दर्शनमम्", "range": "२६–३८"}]}, {"id": 6000232030, "chapter_id": 10232, "verse_number": "१०-३६-२७", "content_sanskrit": "किशोरौ श्यामलश्वेतौ श्रीनिकेतौ बृहद्भुजौ।\nसुसुखौ सुन्दरवरौ बालद्विरदविक्रमौ॥ १०/३६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.030.m4a", "display_order": 31}, {"id": 6000232031, "chapter_id": 10232, "verse_number": "१०-३६-२८", "content_sanskrit": "ध्वजवज्राङ्कुशाम्भोजैश्चिह्नितैरङ्घ्रिभिर्व्रजम्।\nशोभमानौ महात्मानौ सानुक्रोशस्मितेक्षणौ॥ १०/३६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.031.m4a", "display_order": 32}, {"id": 6000232032, "chapter_id": 10232, "verse_number": "१०-३६-२९", "content_sanskrit": "उदाररुचिरक्रीडौ स्रग्विणौ वनमालिनौ।\nपुण्यगन्धानुलिप्ताङ्गौ स्नातौ विरजवाससौ॥ १०/३६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.032.m4a", "display_order": 33}, {"id": 6000232033, "chapter_id": 10232, "verse_number": "१०-३६-३०", "content_sanskrit": "प्रधानपुरुषावाद्यौ जगद्धेतू जगत्पती।\nअवतीर्णौ जगत्यर्थे स्वांशेन बलकेशवौ॥ १०/३६/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.033.m4a", "display_order": 34}, {"id": 6000232034, "chapter_id": 10232, "verse_number": "१०-३६-३१", "content_sanskrit": "दिशो वितिमिरा राजन् कुर्वाणौ प्रभया स्वया।\nयथा मारकतः शैलो रौप्यश्च कनकाचितौ॥ १०/३६/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.034.m4a", "display_order": 35}, {"id": 6000232035, "chapter_id": 10232, "verse_number": "१०-३६-३२", "content_sanskrit": "रथात् तूर्णमवप्लुत्य सोऽक्रूरः स्नेहविह्वलः।\nपपात चरणोपान्ते दण्डवद् रामकृष्णयोः॥ १०/३६/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.035.m4a", "display_order": 36}, {"id": 6000232036, "chapter_id": 10232, "verse_number": "१०-३६-३३", "content_sanskrit": "भगवद्दर्शनाह्लादबाष्पपर्याकुलेक्षणः।\nपुलकाङ्कित औत्कण्ठ्यात् स्वाख्याने नाशकन्नृप॥ १०/३६/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.036.m4a", "display_order": 37}, {"id": 6000232037, "chapter_id": 10232, "verse_number": "१०-३६-३४", "content_sanskrit": "भगवांस्तदभिप्रेत्य रथाङ्गाङ्कितपाणिना।\nपरिरेभेऽभ्युपाकृष्य प्रीतः प्रणतवत्सलः॥ १०/३६/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.037.m4a", "display_order": 38}, {"id": 6000232038, "chapter_id": 10232, "verse_number": "१०-३६-३५", "content_sanskrit": "सङ्कर्षणश्च प्रणतमुपगुह्य महामनाः।\nगृहीत्वा पाणिना पाणिमनयत् सानुजो गृहम्॥ १०/३६/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.038.m4a", "display_order": 39}, {"id": 6000232039, "chapter_id": 10232, "verse_number": "१०-३६-३६", "content_sanskrit": "पृष्ट्वाऽथ स्वागतं तस्मै निवेद्य परमासनम्।\nप्रक्षाल्य विधिवत् पादौ मधुपर्कार्हमाहरत्॥ १०/३६/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.039.m4a", "display_order": 40}, {"id": 6000232040, "chapter_id": 10232, "verse_number": "१०-३६-३७", "content_sanskrit": "निवेद्य गां चातिथये संवाह्य श्रान्तमादृतः।\nअन्नं बहुगुणं मेध्यं श्रद्धयोपाहरद् विभुः॥ १०/३६/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.040.m4a", "display_order": 41}, {"id": 6000232041, "chapter_id": 10232, "verse_number": "१०-३६-३८", "content_sanskrit": "तस्मै भुक्तवते प्रीत्या रामः परमधर्मवित्।\nमुखवासैर्गन्धमाल्यैः परां प्रीतिं व्यधात् पुनः॥ १०/३६/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_036/BhP_10.036.041.m4a", "display_order": 42}, {"id": 6000232042, "chapter_id": 10232, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे षट्त्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]