[{"id": 7000244000, "chapter_id": 20244, "verse_number": "२४४-१", "content_sanskrit": "विद्याविद्ययोःस्वरूपकथनम् वसिष्ठ उवाच सांख्यदर्शनमेतावदुक्तं ते नृपसत्तम ।\nविद्याविद्ये त्विदानीं मे त्वं निबोधानुपूर्वशः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000244001, "chapter_id": 20244, "verse_number": "२४४-२", "content_sanskrit": "अभेद्यमाहुरव्यक्तं सर्गप्रलयधर्मिणः ।\nसर्गप्रलय इत्युक्तं विद्याविद्ये च विंशकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000244002, "chapter_id": 20244, "verse_number": "२४४-३", "content_sanskrit": "परस्परस्य विद्या वै तन्निबोधानुपूर्वशः ।\nयथोक्तमृषिभिस्तात सांख्यस्यातिनिदर्शनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000244003, "chapter_id": 20244, "verse_number": "२४४-४", "content_sanskrit": "कर्मेन्द्रियाणां सर्वेषां विद्या बुद्धीन्द्रियं स्मृतम् ।\nबुद्धीन्द्रियाणां च तथा विशषा इति नः श्रुतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000244004, "chapter_id": 20244, "verse_number": "२४४-५", "content_sanskrit": "विषयाणां मनस्तेषां विद्यामाहुर्मनीषिणः ।\nमनसः पञ्च भूतानि विद्या इत्यभिचक्षते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000244005, "chapter_id": 20244, "verse_number": "२४४-६", "content_sanskrit": "अहंकारस्तु भूतानां पञ्चानां नात्र संशयः ।\nअहंकारस्तथा विद्या बुद्धिर्विद्या नरेश्वर ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000244006, "chapter_id": 20244, "verse_number": "२४४-७", "content_sanskrit": "बुद्ध्या प्रकृतिरव्यक्तं तत्त्वानां परमेश्वरः ।\nविद्या ज्ञेया नरश्रेष्ठ विधिश्च परमः स्मृतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000244007, "chapter_id": 20244, "verse_number": "२४४-८", "content_sanskrit": "अव्यक्तमपरं प्राहुर्विद्या वै पञ्चविंशकः ।\nसर्वस्य सर्वमित्युक्तं ज्ञेयज्ञानस्य पारगः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000244008, "chapter_id": 20244, "verse_number": "२४४-९", "content_sanskrit": "ज्ञानमव्यक्तमित्युक्तं ज्ञेयं वै प़ञ्चविंसकम् ।\nतथैव ज्ञानमव्यक्तं विज्ञाता पञ्चविंशकः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000244009, "chapter_id": 20244, "verse_number": "२४४-१०", "content_sanskrit": "विद्याविद्ये तु तत्त्वेन मयोक्ते वै विशेषतः ।\nअक्षरं च क्षरं चैव यदुक्तं तन्निबोध मे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000244010, "chapter_id": 20244, "verse_number": "२४४-११", "content_sanskrit": "उभावेतौ क्षरावुक्तौ उभावेतावन(था)क्षरौ ।\nकारणं तु प्रवक्ष्यामि यथाज्ञानं तु ज्ञानतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000244011, "chapter_id": 20244, "verse_number": "२४४-१२", "content_sanskrit": "अनादिनिधनावेतौ उभावेवेश्वरौ मतौ ।\nतत्तवसंज्ञावुभावेव प्रोच्यते ज्ञानचिन्तकैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000244012, "chapter_id": 20244, "verse_number": "२४४-१३", "content_sanskrit": "सर्गप्रलयधर्मित्वादव्यक्तं प्राहुरव्ययम् ।\nतदेतद्‌गुणसर्गाय विकुर्वाणं पुनः पुनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000244013, "chapter_id": 20244, "verse_number": "२४४-१४", "content_sanskrit": "गुणानां महदादीनामुत्पद्यति परस्परम् ।\nअधिष्ठानं क्षेत्रमाहुरेतद्वै पञ्चविंशकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000244014, "chapter_id": 20244, "verse_number": "२४४-१५", "content_sanskrit": "यदन्तर्गुणजालं तु तद्‌व्यक्तात्मनि संक्षिपेत् ।\nतदहं तद्‌गुणैस्तस्तु पञ्चविंशे विलीयते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000244015, "chapter_id": 20244, "verse_number": "२४४-१६", "content_sanskrit": "गुणा गुणेषु लीयन्ते तदेका प्रकृतिर्भवेत् ।\nक्षेत्रज्ञोऽपि तदा तावत्क्षेत्रज्ञः संप्रणीयते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000244016, "chapter_id": 20244, "verse_number": "२४४-१७", "content_sanskrit": "यदाऽक्षरं प्रकृतिर्यं गच्छते गुणसंज्ञिता ।\nनिर्गुणत्वं च वै देहे गुणेषु परिवर्तनात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000244017, "chapter_id": 20244, "verse_number": "२४४-१८", "content_sanskrit": "एवमेव च क्षेत्रज्ञः क्षेत्रज्ञानपरिक्षयात् ।\nप्रकृत्या निर्गुणस्त्वेष इत्येवमनुशुश्रुम ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000244018, "chapter_id": 20244, "verse_number": "२४४-१९", "content_sanskrit": "क्षरो भवत्येष यदा गुणवती गुणेष्वथ ।\nप्रकृतिं त्वथ जनाति निर्गुणत्वं तथात्मनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000244019, "chapter_id": 20244, "verse_number": "२४४-२०", "content_sanskrit": "तथा विशुद्धो भवति प्रकृते परिवर्जनात् ।\nअन्योऽहमन्येयमिति यदा बुध्यति बुद्धिमान् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000244020, "chapter_id": 20244, "verse_number": "२४४-२१", "content_sanskrit": "तदैषोऽव्यथतामेति न च मिश्रत्वमाव्रजेत् ।\nप्रकृत्या चैष राजेन्द्र मिश्रोऽन्योऽन्यस्य दृश्यते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000244021, "chapter_id": 20244, "verse_number": "२४४-२२", "content_sanskrit": "यदा तु गुणजालं तत्प्राकृतं विजुगुप्सते ।\nपश्यते च परं पश्यंस्तदा पश्यंस्तदा पश्यन्नु संसृजेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000244022, "chapter_id": 20244, "verse_number": "२४४-२३", "content_sanskrit": "किं मया कृतमेतावद्योऽहं कालनिमज्जनः ।\nयथा मत्स्यो ह्यभिज्ञानादनुवर्तितवाञ्जलम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000244023, "chapter_id": 20244, "verse_number": "२४४-२४", "content_sanskrit": "अहमेव हि संमोहादन्यमन्यं जनाज्जनम् ।\nमत्स्यो यथोदकज्ञानादनुवर्तितवानिह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000244024, "chapter_id": 20244, "verse_number": "२४४-२५", "content_sanskrit": "मत्स्योऽन्यत्वमथाज्ञानादुदकान्नाभिमन्यते ।\nआत्मानं तदवज्ञानादन्यं चैव न वेद्‌म्यहम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000244025, "chapter_id": 20244, "verse_number": "२४४-२६", "content_sanskrit": "ममास्तु धिक्कुबुद्धस्य योऽहं मग्न इमं पुनः ।\nअनुवर्तितवान्मोहादन्यमन्यं जनाज्जनम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000244026, "chapter_id": 20244, "verse_number": "२४४-२७", "content_sanskrit": "अयमनुभवेद्‌बन्धुरनेन सह मे भयम् ।\nसाम्यमेकत्वातं यातो यादृशस्तादृशस्त्वहम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000244027, "chapter_id": 20244, "verse_number": "२४४-२८", "content_sanskrit": "तुल्यतामिह पश्यामि सदृशोऽहमनेन वै ।\nअयं हि विमलो व्यक्तमहमीदृशकस्तदा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000244028, "chapter_id": 20244, "verse_number": "२४४-२९", "content_sanskrit": "योऽहमज्ञानसंमोहादज्ञया संप्रवृत्तवान् ।\nसंसर्गादतिसंसर्गात्स्थितः कालमिमं त्वहम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000244029, "chapter_id": 20244, "verse_number": "२४४-३०", "content_sanskrit": "सोऽहमेवं वशीभूतः कालमेतं न बुद्धवान् ।\nउत्तमाधममध्यानां तामहं कथमावसे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000244030, "chapter_id": 20244, "verse_number": "२४४-३१", "content_sanskrit": "समानमायया चेह सहवासमहं कथम् ।\nगच्छाम्यबुद्धभावत्वादिहेदीनीं स्थिरो व ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000244031, "chapter_id": 20244, "verse_number": "२४४-३२", "content_sanskrit": "सहवासं न यास्यामि कालमेतं विवञ्चनात् ।\nवञ्चितो ह्यनया यद्धि निर्विकारो विकारया ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000244032, "chapter_id": 20244, "verse_number": "२४४-३३", "content_sanskrit": "न तत्तदपराद्दं स्यादपराधो ह्ययं मम ।\nयोऽहमत्रभवं सक्तः पराङ्मुखमुपस्थितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000244033, "chapter_id": 20244, "verse_number": "२४४-३४", "content_sanskrit": "ततोऽस्मिन्बहुरूपोऽथ स्थितो मूर्तिरमूर्तिमान् ।\nअमूर्तिश्चाप्यमूर्तात्मा ममत्वेन प्रधर्षितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000244034, "chapter_id": 20244, "verse_number": "२४४-३५", "content_sanskrit": "प्रकृत्या च तया तेन तासु तास्विह योनिषु ।\nनिर्ममस्य ममत्वेन विकृतं तासु तासु च ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000244035, "chapter_id": 20244, "verse_number": "२४४-३६", "content_sanskrit": "योनिषु वर्तमानेन नष्टसंज्ञेन चेतसा ।\nसमता न मया काचिदहंकारे कृता मया ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000244036, "chapter_id": 20244, "verse_number": "२४४-३७", "content_sanskrit": "आत्मानं बहुधा कृत्वा सोऽयं भूयो युनक्ति माम् ।\nइदानीमवबुद्धोऽस्मि निर्ममो निरहंकृतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000244037, "chapter_id": 20244, "verse_number": "२४४-३८", "content_sanskrit": "ममत्वं मनसा नित्यमहंकारकृतात्मकम् ।\nअपलग्नामिमां हित्वा संश्रयिष्ये निरामयम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000244038, "chapter_id": 20244, "verse_number": "२४४-३९", "content_sanskrit": "अनेन साम्यं यास्यामि नानयाऽहमचेतसा ।\nक्षेमं मम सहानेन नैवैकमनया सह ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000244039, "chapter_id": 20244, "verse_number": "२४४-४०", "content_sanskrit": "एवं परमसंबोधात्पञ्चविंशोऽनुबुद्धवान् ।\nअक्षरत्वं निगच्छति त्यक्त्वा क्षरमनामयम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000244040, "chapter_id": 20244, "verse_number": "२४४-४१", "content_sanskrit": "अव्यक्तं व्यक्तधर्माणं सगुणं निर्गुणं तथा ।\nनिर्गुणं प्रथमं दृष्ट्वा तादृग्भवति मैथिल ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000244041, "chapter_id": 20244, "verse_number": "२४४-४२", "content_sanskrit": "अक्षरक्षरयोरेतदुक्तं तव निदर्शनम् ।\nमयेह ज्ञानसंपन्नं यथा श्रुतिनिद्रशनात् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000244042, "chapter_id": 20244, "verse_number": "२४४-४३", "content_sanskrit": "निःसंदिग्धं च सूक्ष्मं च विशुद्धं विमलं तथा ।\nप्रवक्ष्यामि तु ते भूयस्तन्निबोध यथाश्रुतम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000244043, "chapter_id": 20244, "verse_number": "२४४-४४", "content_sanskrit": "सांख्ययोगो मया प्रोक्तः शास्त्रद्वयनिदर्शनात् ।\nयदेव सांक्यशास्त्रोक्तं योगदर्शनमेव तत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000244044, "chapter_id": 20244, "verse_number": "२४४-४५", "content_sanskrit": "प्रबोधनपरं ज्ञानं सांख्यानामवनीपते ।\nविस्पष्टं प्रोच्यते तत्र शिष्याणां हितकाम्यया ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000244045, "chapter_id": 20244, "verse_number": "२४४-४६", "content_sanskrit": "बृहच्चैवमिदं शास्त्रमित्याहुर्विदुषो जनाः ।\nअस्मिंश्च शास्त्रे योगानां पुनर्भवपुरःसरम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000244046, "chapter_id": 20244, "verse_number": "२४४-४७", "content_sanskrit": "पञ्चविंशात्परं तत्त्वं पठ्यते च नराधिप ।\nसांख्यानां तु परं तत्त्वं यथावदनुवर्णितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000244047, "chapter_id": 20244, "verse_number": "२४४-४८", "content_sanskrit": "बुद्धमप्रतिबुद्धं च बुध्यमानं च तत्त्वतः ।\nबुध्यमानं च बुद्धत्वं प्राहुर्योगनिदर्शनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000244048, "chapter_id": 20244, "verse_number": "२४४-४९", "content_sanskrit": "बुद्धमप्रतिबुद्धं च बुध्यमानं च तत्त्वतः ।\nबुध्यमानं च बुद्धत्वं प्राहुर्योगनिदर्शनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]