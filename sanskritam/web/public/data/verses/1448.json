[{"id": 2021720, "chapter_id": 1448, "verse_number": "३-८६-०x", "content_sanskrit": "धौम्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021721, "chapter_id": 1448, "verse_number": "३-८६-१", "content_sanskrit": "दक्षिणस्यां तु पुण्यानि शृणु तीर्थानि भारत।\nविस्तरेण यथाबुद्धि कीर्त्यमानानि तानि वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021722, "chapter_id": 1448, "verse_number": "३-८६-२", "content_sanskrit": "यस्यामाख्यायते पुण्या दिशि गोदावरी नदी।\nबह्वारामा बहुजला तापसाचरिता शिवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021723, "chapter_id": 1448, "verse_number": "३-८६-३", "content_sanskrit": "वेणा भीमरथी चैव नद्यौ पापभयापहे।\nमृगद्विजसमाकीर्णे तापसालयभूषिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021724, "chapter_id": 1448, "verse_number": "३-८६-४", "content_sanskrit": "राजर्षेस्तस् च सरिन्नृगस्य भरतर्षभ।\nरम्यतीर्था बहुजला पयोष्णी द्विजसेविता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021725, "chapter_id": 1448, "verse_number": "३-८६-५", "content_sanskrit": "अपि चात्र महायोगी मार्कण्डेयो महायशाः।\nअनुवंश्यां जगौ गाथां नृगस्य धरणीपतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021726, "chapter_id": 1448, "verse_number": "३-८६-६", "content_sanskrit": "नृगस् यजमानस्य प्रत्यक्षमिति नः श्रुतम्।\n`मरुतः परिवेष्टारः सदस्याश्च दिवौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021727, "chapter_id": 1448, "verse_number": "३-८६-७", "content_sanskrit": "पयोष्ण्यां यजमानस्य वाराहे तीर्थ उत्तमे।\nउद्धृतं भूतलस्थं वावायुना समुदीरितम्।\nपयोष्ण्या हरते तोयं पापमामरणान्तिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021728, "chapter_id": 1448, "verse_number": "३-८६-८", "content_sanskrit": "स्वर्गादुत्तुङ्गममलं विषाणं यत्र शूलिनः।\nस्वमात्मविहितं दृष्ट्वा मर्त्यः शिवपुरं व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021729, "chapter_id": 1448, "verse_number": "३-८६-९", "content_sanskrit": "एकतः सरितः सर्वा गङ्गाद्याः सलिलोच्चयाः।\nपयोष्णी चैकतः पुण्या तीर्थेभ्यो हि मता मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021730, "chapter_id": 1448, "verse_number": "३-८६-१०", "content_sanskrit": "माठरस्य वनं पुण्यं बहुमूलफलं शिवम्।\nयूपश्च भरतश्रेष्ठ वरुणस्रोतसे गिरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021731, "chapter_id": 1448, "verse_number": "३-८६-११", "content_sanskrit": "प्रवेण्युत्तरपार्स्वे तु पुण्ये कण्वाश्रमे तथा।\nतापसानामरण्यानि कीर्तितानि यथाश्रुति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021732, "chapter_id": 1448, "verse_number": "३-८६-१२", "content_sanskrit": "वेदी शूर्पारके तात जमदग्नेर्महात्मनः।\nरम्या पाषाणतीर्था च पुरश्चन्द्रा च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021733, "chapter_id": 1448, "verse_number": "३-८६-१३", "content_sanskrit": "अशोकतीर्थं तत्रैव कौन्ते य बहुलाश्रमम्।\nअगस्त्यतीर्थं पाण्ड्येषु वारुणं च युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021734, "chapter_id": 1448, "verse_number": "३-८६-१४", "content_sanskrit": "कुमार्यः कथिताः पुण्याः पाण्ड्येष्वेव नरर्षभ।\nताम्रपर्णी तु कौन्तेय कीर्तयिष्यामि तां शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021735, "chapter_id": 1448, "verse_number": "३-८६-१५", "content_sanskrit": "यत्र देवैस्तपस्तप्तं महदिच्छद्भिराश्रमे।\nगोकर्णमिति विख्यातं त्रिषु लोकेषु भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021736, "chapter_id": 1448, "verse_number": "३-८६-१६", "content_sanskrit": "शीततोयो बहुजलः पुण्यस्तात शिवश्च सः।\nह्रदः परमदुष्प्रापो मानुषैरकृतात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021737, "chapter_id": 1448, "verse_number": "३-८६-१७", "content_sanskrit": "तत्र वृक्षतृणाद्यैश्च संपन्नः फलमूलवान्।\nआश्रमोऽगस्त्यशिष्यस्य पुण्यो देवसहे गिरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021738, "chapter_id": 1448, "verse_number": "३-८६-१८", "content_sanskrit": "वैडूर्यपर्वतस्तत्र श्रीमान्मणिमयः शिवः।\nअगस्त्यस्याश्रमश्चैव बहुमूलफलोदकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2021739, "chapter_id": 1448, "verse_number": "३-८६-१९", "content_sanskrit": "सुराष्ट्रेष्वपि वक्ष्यामि पुण्यान्यायतनानि च।\nआश्रमान्सरितश्चैव सरांसि च नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2021740, "chapter_id": 1448, "verse_number": "३-८६-२०", "content_sanskrit": "चमसोद्भेदनं विप्रास्तत्रापि कथयन्त्युत।\nप्रभासं चोदधौ तीर्थं त्रिषु लोकेषु विश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2021741, "chapter_id": 1448, "verse_number": "३-८६-२१", "content_sanskrit": "तत्र पिण्डारकं नाम तापसाचरितं शिवम्।\nउज्जयन्तश्च शिखरी क्षिप्रं सिद्धिकरो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2021742, "chapter_id": 1448, "verse_number": "३-८६-२२", "content_sanskrit": "तत्र देवर्षिवीरेण नारदेनानुकीर्तितः।\nपुराणः श्रूयते श्लोकस्तं निबोध युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2021743, "chapter_id": 1448, "verse_number": "३-८६-२३", "content_sanskrit": "पुण्ये गिरौ सुराष्ट्रेषु मृगपक्षिनिषेविते।\nउज्जयन्ते स्म तप्ताङ्गो नाकपृष्ठे महीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2021744, "chapter_id": 1448, "verse_number": "३-८६-२४", "content_sanskrit": "`एष नारायणः श्रीमान्क्षीरार्णवनिकेतनः।\nनागपर्यङ्कमुत्सृज्यह्यागतो मधुरां पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2021745, "chapter_id": 1448, "verse_number": "३-८६-२५", "content_sanskrit": "पुण्या द्वारवती तत्रयत्रासौ मधुसूदनः।\nसाक्षाद्देवः पुराणोसौ स हि धर्मः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2021746, "chapter_id": 1448, "verse_number": "३-८६-२६", "content_sanskrit": "ये च कवेदविदो विप्रा ये चाध्यात्मविदो जनाः।\nते वदन्ति महात्मानं कृष्णं धर्मं सनातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2021747, "chapter_id": 1448, "verse_number": "३-८६-२७", "content_sanskrit": "पवित्राणां हि गोविन्दः पवित्रं परमुच्यते।\nपुण्यानामपि पुण्योसौ मङ्गालानां च मङ्गलम्।\nत्रैलोक्ये पुण्डरीकाक्षो देवदेवः सनातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2021748, "chapter_id": 1448, "verse_number": "३-८६-२८", "content_sanskrit": "अव्ययात्मा व्ययात्मा च क्षेत्रज्ञः परमेश्वरः।\nआस्ते हरिरचिन्त्यात्मा तत्रैव मधुसूदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2021749, "chapter_id": 1448, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि षडशीतितमोऽष्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]