[{"id": 2011509, "chapter_id": 1236, "verse_number": "१-२३७-०x", "content_sanskrit": "वर्गोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2011510, "chapter_id": 1236, "verse_number": "१-२३७-१", "content_sanskrit": "ततो वयं प्रव्यथिताः सर्वा भारतसत्तम।\nअयाम शरणं विप्रं तं तपोधनमच्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2011511, "chapter_id": 1236, "verse_number": "१-२३७-२", "content_sanskrit": "रूपेण वयसा चैव कन्दर्पेण च दर्पिताः।\nअयुक्तं कृतवत्यः स्म क्षन्तुमर्हसि नो द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2011512, "chapter_id": 1236, "verse_number": "१-२३७-३", "content_sanskrit": "एष एव वधोऽस्माकं स्वयं प्राप्तस्तपोधन।\nयद्वयं संशितात्मानं प्रलोब्धुं त्वामिहागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2011513, "chapter_id": 1236, "verse_number": "१-२३७-४", "content_sanskrit": "अवध्यास्तु स्त्रियः सृष्टा मन्यन्ते धर्मचारिणः।\nतस्माद्धर्मेण वर्ध त्वं नास्मन्हिंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2011514, "chapter_id": 1236, "verse_number": "१-२३७-५", "content_sanskrit": "सर्वभूतेषु धर्मज्ञ मैत्रो ब्राह्मण उच्यते।\nसत्यो भवतु कल्याण एष वादो मनीषिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2011515, "chapter_id": 1236, "verse_number": "१-२३७-६", "content_sanskrit": "शरणं च प्रपन्नानां शिष्टाः कुर्वन्ति पालनम्।\nशरणं त्वां प्रपन्नाः स्म तस्मात्त्वं क्षन्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2011516, "chapter_id": 1236, "verse_number": "१-२३७-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2011517, "chapter_id": 1236, "verse_number": "१-२३७-७", "content_sanskrit": "एवमुक्तः स धर्मात्मा ब्राह्मणः शुभकर्मकृत्।\nप्रसादं कृतवान्वीर रविसोमसमप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2011518, "chapter_id": 1236, "verse_number": "१-२३७-८x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2011519, "chapter_id": 1236, "verse_number": "१-२३७-८", "content_sanskrit": "शतं शतसहस्रं तु सर्वमक्षय्यवाचकम्।\nपरिमाणं शतं त्वेतन्नेदमक्षय्यवाचकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2011520, "chapter_id": 1236, "verse_number": "१-२३७-९", "content_sanskrit": "यदा च वो ग्राहभूता गृह्णन्तीः पुरुषाञ्जले।\nउत्कर्षति जलात्तस्मात्स्थलं पुरुषसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2011521, "chapter_id": 1236, "verse_number": "१-२३७-१०", "content_sanskrit": "तदा यूयं पुनः सर्वाः स्वं रूपं प्रतिपत्स्यथ।\nअनृतं नोक्तपूर्वं मे हसतापि कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2011522, "chapter_id": 1236, "verse_number": "१-२३७-११", "content_sanskrit": "तानि सर्वाणि तीर्थानि ततः प्रभृति चैव ह।\nनारीतीर्थानि नाम्नेह ख्यातिं यास्यन्ति सर्वशः।\nपुण्यानि च भविष्यन्ति पावनानि मनीषिणां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2011523, "chapter_id": 1236, "verse_number": "१-२३७-१२x", "content_sanskrit": "वर्गोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2011524, "chapter_id": 1236, "verse_number": "१-२३७-१२", "content_sanskrit": "ततोऽभिवाद्य तं विप्रं कृत्वा चापि प्रदक्षिणम्।\nअचिन्तयामोऽपसृत्य तस्माद्देशात्सुदुःखिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2011525, "chapter_id": 1236, "verse_number": "१-२३७-१३", "content_sanskrit": "क्व नु नाम वयं सर्वाः कालेनाल्पेन तं नरम्।\nसमागच्छेम यो नस्तद्रूपमापादयेत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2011526, "chapter_id": 1236, "verse_number": "१-२३७-१४", "content_sanskrit": "ता वयं चिन्तयित्वैव मुहूर्तादिव भारत।\nदृष्टवत्यो महाभागं देवर्षिमुत नारदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2011527, "chapter_id": 1236, "verse_number": "१-२३७-१५", "content_sanskrit": "संप्रहृष्टाः स्म तं दृष्ट्वा देवर्षिममितद्युतिम्।\nअभिवाद्य च तं पार्थ स्थिताः स्म व्रीडिताननाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2011528, "chapter_id": 1236, "verse_number": "१-२३७-१६", "content_sanskrit": "स नोऽपृच्छद्दुःखमूलमुक्तवत्यो वयं च तम्।\nश्रउत्वा तत्र यथावृत्तमिदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2011529, "chapter_id": 1236, "verse_number": "१-२३७-१७", "content_sanskrit": "दक्षिणे सागरानूपे पञ्च तीर्थानि सन्ति वै।\nपुण्यानि रमणीयानि तानि गच्छत मा चिरं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2011530, "chapter_id": 1236, "verse_number": "१-२३७-१८", "content_sanskrit": "तत्राशु पुरुषव्याघ्रः पाण्डवेयो धनञ्जयः।\nमोक्षयिष्यति शुद्धात्मा दुःखादस्मान्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2011531, "chapter_id": 1236, "verse_number": "१-२३७-१९", "content_sanskrit": "इत्युक्त्वा नारदः सर्वास्तत्रैवान्तरधीयत।\nतस्य सर्वा वयं वीर श्रुत्वा वाक्यमितो गताः।\nतदिदं सत्यमेवाद्य मोक्षिताहं त्वयाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2011532, "chapter_id": 1236, "verse_number": "१-२३७-२०", "content_sanskrit": "एतास्तु मम ताः सख्यश्चतस्रोऽन्या जले श्रिताः।\nकुरु कर्म शुभं वीर एताः सर्वा विमोक्षय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2011533, "chapter_id": 1236, "verse_number": "१-२३७-२१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2011534, "chapter_id": 1236, "verse_number": "१-२३७-२१", "content_sanskrit": "ततस्ताः पाण्डवश्रेष्ठः सर्वा एव विशांपते।\nअवगाह्य च तत्तीर्थं गृहीतो ग्राहिभिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2011535, "chapter_id": 1236, "verse_number": "१-२३७-२२", "content_sanskrit": "ग्राहीभिश्चोत्तताराशु तरयामास तत्क्षणात्।\nसा चाप्सरा बभूवाशु सर्वाभरणभूषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2011536, "chapter_id": 1236, "verse_number": "१-२३७-२३", "content_sanskrit": "एवं क्रमेण ताः सर्वा मोक्षयामास वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2011537, "chapter_id": 1236, "verse_number": "१-२३७-२४", "content_sanskrit": "उत्थाय च जलात्तस्मात्प्रतिलभ्य वपुः स्वकम्।\nतास्तदाऽप्सरसो राजन्नदृश्यन्त यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2011538, "chapter_id": 1236, "verse_number": "१-२३७-२५", "content_sanskrit": "तीर्थानि शोधयित्वा तु तथानुज्ञाय ताः प्रभुः।\nचित्राङ्गदां पुनर्द्रष्टुं मणलूरं पुनर्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2011539, "chapter_id": 1236, "verse_number": "१-२३७-२६", "content_sanskrit": "तस्यामजनयत्पुत्रं राजानं बभ्रुवाहनम्।\nतं दृष्ट्वा पाण्डवो राजंश्चित्रवाहनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2011540, "chapter_id": 1236, "verse_number": "१-२३७-२७", "content_sanskrit": "चित्राङ्गदायाः शुल्कं त्वं गृहाण बभ्रुवाहनम्।\nअनेन च भविष्यामि ऋणान्मुक्तो नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2011541, "chapter_id": 1236, "verse_number": "१-२३७-२८", "content_sanskrit": "चित्राङ्गदां पुनर्वाक्यमब्रवीत्पाण्डुनन्दनः।\nइहैव भव भद्रं ते वर्धेथा बभ्रुवाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2011542, "chapter_id": 1236, "verse_number": "१-२३७-२९", "content_sanskrit": "इन्द्रपस्थनिवासं मे त्वं तत्रागत्य रंस्यसि।\nकुन्ती युधिष्ठिरं भीमं भ्रातरौ मे कनीयसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2011543, "chapter_id": 1236, "verse_number": "१-२३७-३०", "content_sanskrit": "आगत्य तत्र पश्येथा अन्यानपि च बान्धवान्।\nबान्धवैः सहिताः सर्वैर्नन्दसे त्वमनिन्दिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2011544, "chapter_id": 1236, "verse_number": "१-२३७-३१", "content_sanskrit": "धर्मे स्थितः सत्यधृतिः कौन्तेयोऽथ युधिष्ठिरः।\nजित्वा तु पृथिवीं सर्वां राजसूयं करिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2011545, "chapter_id": 1236, "verse_number": "१-२३७-३२", "content_sanskrit": "तत्रागच्छन्ति राजानः पृथिव्यां नृपसंज्ञिताः।\nबहूनि रत्नान्यादाय आगमिष्यति ते पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2011546, "chapter_id": 1236, "verse_number": "१-२३७-३३", "content_sanskrit": "एकसार्थं प्रयातासि चित्रवाहनसेवया।\nद्रक्ष्यामि राजसूये त्वां पुत्रं पालय मा शुचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2011547, "chapter_id": 1236, "verse_number": "१-२३७-३४", "content_sanskrit": "बभ्रुवाहननाम्ना तु मम प्राणो बहिश्चरः।\nतस्माद्भरस्व पुत्रं वै पुरुषं वंशवर्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2011548, "chapter_id": 1236, "verse_number": "१-२३७-३५", "content_sanskrit": "चित्रावाहनदायादं धर्मात्पौरवनन्दनम्।\nपाण्डवानां प्रियं पुत्रं तस्मात्पालय सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2011549, "chapter_id": 1236, "verse_number": "१-२३७-३६", "content_sanskrit": "विप्रयोगेण संतापं मा कृथास्त्वमनिन्दिते।\nचित्राङ्गदामेवमुक्त्वा सागरानूपमाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2011550, "chapter_id": 1236, "verse_number": "१-२३७-३७", "content_sanskrit": "स्थानं दूरं समाप्लुत्य दत्त्वा बहुधनं तदा।\nकेरलान्समतिक्रम्य गोकर्णमभितोऽगमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2011551, "chapter_id": 1236, "verse_number": "१-२३७-३८", "content_sanskrit": "आद्यं पशुपतेः स्थानं दर्शनादेव मुक्तिदम्।\nयत्र पापोऽपि मनुजः प्राप्नोत्यभयदं पदम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2011552, "chapter_id": 1236, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि अर्जुनवनवासपर्वणि सप्तत्रिंशदधिकद्विशततमोऽध्यायः॥ २३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]