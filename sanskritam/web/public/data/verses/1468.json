[{"id": 2022328, "chapter_id": 1468, "verse_number": "३-१०६-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022329, "chapter_id": 1468, "verse_number": "३-१०६-१", "content_sanskrit": "एतच्छ्रुत्वान्तरिक्षाच्च स राजा राजसत्तमः।\nयथोक्तं तच्चराकाथ श्रद्दधद्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022330, "chapter_id": 1468, "verse_number": "३-१०६-२", "content_sanskrit": "[एकैकशस्ततः कृत्वा बीजं बीजं नराधिपः।\nघृतपूर्णेषु कुम्भेषु तान्भागान्विदधे ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022331, "chapter_id": 1468, "verse_number": "३-१०६-३", "content_sanskrit": "धात्रीश्चैकैकशः प्रादात्पुत्ररक्षणतत्परः।\nततः कालेन महता समुत्तस्थुर्महाबलाः ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022332, "chapter_id": 1468, "verse_number": "३-१०६-४", "content_sanskrit": "षष्टिः पुत्रसहस्रणि तस्याप्रतिमतेजसः।\nरुद्रप्रसादाद्राजर्षेः समजायन्त पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022333, "chapter_id": 1468, "verse_number": "३-१०६-५", "content_sanskrit": "ते घोराः क्रूरकर्माण आकाशपरिसर्पिणः।\nबहुत्वाच्चावजानन्तः सर्वाल्लोँकान्सहामरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022334, "chapter_id": 1468, "verse_number": "३-१०६-६", "content_sanskrit": "त्रिदशांश्चाप्यबाधन्त तथा गन्धर्वराक्षसान्।\nसर्वाणि चैव भूतानि शूरा समरशालिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022335, "chapter_id": 1468, "verse_number": "३-१०६-७", "content_sanskrit": "वध्यमानास्तदा लोकाः सागरैर्मन्दबुद्धिभिः।\nब्रह्माणं शरणं जग्मुः सहिताः सर्वदैवतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022336, "chapter_id": 1468, "verse_number": "३-१०६-८", "content_sanskrit": "तानुवाच महाभागः सर्वलोकपितामहः।\nगच्छध्वं त्रिदशाः सर्वे लोकैः सार्धं यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022337, "chapter_id": 1468, "verse_number": "३-१०६-९", "content_sanskrit": "नातिदीर्घेण कालेन सागराणां क्षयो महान्।\nविष्यति महाघोरः स्वकृतैः कर्मभिः सुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022338, "chapter_id": 1468, "verse_number": "३-१०६-१०", "content_sanskrit": "एवमुक्तास्तु ते देवा लोकाश् मनुजेश्वर।\nपितामहमनुज्ञाप्य विप्रजग्मुर्यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022339, "chapter_id": 1468, "verse_number": "३-१०६-११", "content_sanskrit": "ततः काले बहुतिथे व्यतीते भरतर्षभ।\nदीक्षितः सगरो राजा हयमेधेन वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022340, "chapter_id": 1468, "verse_number": "३-१०६-१२", "content_sanskrit": "तस्याश्वो व्यचरद्भूमिं पुत्रैः सुपरिरक्षितः।\n`सर्वैरेव महोत्साहैः स्वच्छन्दप्रचरो नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022341, "chapter_id": 1468, "verse_number": "३-१०६-१३", "content_sanskrit": "समुद्रं स समासाद्य निस्तोयं भीमदर्शनम्।\nरक्ष्यमाणः प्रयत्नेन तत्रैवान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022342, "chapter_id": 1468, "verse_number": "३-१०६-१४", "content_sanskrit": "ततस्ते सागरास्तात हृतं मत्वा हयोत्तमम्।\nआगम्य पितुराचख्युरदृश्यं तुरगं हृतम्।\nतेनोक्ता दिक्षु सर्वासु पुत्रा मार्गत वाजिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022343, "chapter_id": 1468, "verse_number": "३-१०६-१५", "content_sanskrit": "ततस्ते पितुराज्ञाय दिक्षु सर्वासु तं हयम्।\nअमार्गन्त महाराज सर्वंच पृथिवीतलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022344, "chapter_id": 1468, "verse_number": "३-१०६-१६", "content_sanskrit": "ततस्ते सागराः सर्वे समुपेत्य परस्परम्।\nनाध्यगच्छन्त तुरगमश्वहर्तारमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022345, "chapter_id": 1468, "verse_number": "३-१०६-१७", "content_sanskrit": "आगम्य पितरं चोचुस्ततः प्राञ्जलयोऽग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022346, "chapter_id": 1468, "verse_number": "३-१०६-१८", "content_sanskrit": "ससमुद्रवनद्वीपा सनदीनदकन्दरा।\nसपर्वतवनोद्देशा निखिलेन मही नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022347, "chapter_id": 1468, "verse_number": "३-१०६-१९", "content_sanskrit": "अस्माभिर्विचिता राजञ्शासनात्तव पार्थिव।\nन चाश्वमधिगच्छामो नाश्वहर्तारमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022348, "chapter_id": 1468, "verse_number": "३-१०६-२०", "content_sanskrit": "श्रुत्वा तु वचनं तेषां स राजा क्रोधमूर्चितः।\nउवाच वचनं सर्वांस्तदा दैववशान्नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022349, "chapter_id": 1468, "verse_number": "३-१०६-२१", "content_sanskrit": "अनागमाय गच्छध्वं भूयो मार्गत वाजिनम्।\nयाज्ञीयं तं विनाह्यश्वं नागन्तव्यं हि पुत्रकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022350, "chapter_id": 1468, "verse_number": "३-१०६-२२", "content_sanskrit": "प्रतिगृह्य तु संदेशं पितुस्ते सगरात्मजाः।\nभूय एव महीं कृत्स्नां विचेतुमुपचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022351, "chapter_id": 1468, "verse_number": "३-१०६-२३", "content_sanskrit": "अथापश्यन्त ते वीराः पृथिवीमवदारिताम्।\n`समुद्रे पृथिवीपाल पदं मार्गं च वाजिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022352, "chapter_id": 1468, "verse_number": "३-१०६-२४", "content_sanskrit": "समासाद्य बिलं तच्चाप्यखनन्सगरात्मजाः।\nकुद्दालैर्मुसलैश्चैव समुद्रं यत्नमास्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022353, "chapter_id": 1468, "verse_number": "३-१०६-२५", "content_sanskrit": "स खन्यमानः सहितैः सागरैर्वरुणालयः।\nअगच्छत्परमामार्तिं दीर्यमाणः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022354, "chapter_id": 1468, "verse_number": "३-१०६-२६", "content_sanskrit": "असुरोरगरक्षांसि सत्वानि विविधानि च।\nआर्तनादमकुर्वन्त वध्यमानानि सागरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022355, "chapter_id": 1468, "verse_number": "३-१०६-२७", "content_sanskrit": "छिन्नशीर्षा विदेहाश्च भिन्नजान्वस्थिमस्तकाः।\nप्राणिनः समदृश्यन्त शतशोथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022356, "chapter_id": 1468, "verse_number": "३-१०६-२८", "content_sanskrit": "एवं हि खनतां तेषां समुद्रं वरुणालयम्।\nव्यतीतः सुमहान्कालो न चाश्वः समदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022357, "chapter_id": 1468, "verse_number": "३-१०६-२९", "content_sanskrit": "ततः पूर्वोत्तरे देशे समुद्रस्य महीपते।\nविदार्य पातालमथ संक्रुद्धाः सगरात्मजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2022358, "chapter_id": 1468, "verse_number": "३-१०६-३०", "content_sanskrit": "अपश्यन्त हयं यत्र विचरन्तं महीतले।\nकपिलं च महात्मानं तेजोराशिमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2022359, "chapter_id": 1468, "verse_number": "३-१०६-३१", "content_sanskrit": "तेजसा दीप्यमानं तु ज्वालाभिरिव पावकम्।\n`दृष्ट्वा हि विस्मिताः सर्वे बभूवुः सगरात्मजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2022360, "chapter_id": 1468, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणइ षडधिकशततमोऽध्यायः ॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]