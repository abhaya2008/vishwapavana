[{"id": 7005478000, "chapter_id": 25478, "verse_number": "१-४८-१", "content_sanskrit": "सूत उवाच ।\nहेमकूटगिरेः श्रृङ्गे महाकूटैः सुशोभनम् ।\nस्फाटिकं देवदेवस्य विमानं परमेष्ठिनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005478001, "chapter_id": 25478, "verse_number": "१-४८-२", "content_sanskrit": "तत्र देवादिदेवस्य भूतेशस्य त्रिशूलिनः ।\nदेवाः सिद्धगणा यक्षाः पूजां नित्यं प्रकुर्वते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005478002, "chapter_id": 25478, "verse_number": "१-४८-३", "content_sanskrit": "स देवो गिरिशः सार्द्धं महादेव्या महेश्वरः ।\nभूतैः परिवृतो नित्यं भाति तत्र पिनाकधृक् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005478003, "chapter_id": 25478, "verse_number": "१-४८-४", "content_sanskrit": "विभक्तचारुशिखरः कैलासो यत्र पर्वतः ।\nनिवासः कोटियक्षाणां कुबेरस्य च धीमतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005478004, "chapter_id": 25478, "verse_number": "१-४८-५", "content_sanskrit": "तत्रापि देवदेवस्य भवस्यायतनं महत् ।\nमन्दाकिनी तत्र दिव्या रम्या सुविमलोदका ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005478005, "chapter_id": 25478, "verse_number": "१-४८-६", "content_sanskrit": "नदी नानाविधैः पद्मैरनेकैः समलंकृता ।\nदेवदानवगन्धर्वयक्षराक्षसकिन्नरैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005478006, "chapter_id": 25478, "verse_number": "१-४८-७", "content_sanskrit": "उपस्पृष्टजला नित्यं सुपुण्या सुमनोरमा ।\nअन्याश्च नद्यः शतशः स्वर्णपद्मैरलंकृताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005478007, "chapter_id": 25478, "verse_number": "१-४८-८", "content_sanskrit": "तासां कूले तु देवस्य स्थानानि परमेष्ठिनः ।\nदेवर्षिगणजुष्टानि तथा नारायणस्य तु ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005478008, "chapter_id": 25478, "verse_number": "१-४८-९", "content_sanskrit": "सितान्तशिखरे चापि पारिजातवनं शुभम् ।\nतत्र शक्रस्य विपुलं भवनं रत्नमण्डितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005478009, "chapter_id": 25478, "verse_number": "१-४८-१०", "content_sanskrit": "स्फाटिकस्तम्भसंयुक्तं हेमगोपुरसंयुतम् ।\nतत्राथ देवदेवस्य विष्णोर्विश्वात्मनः प्रभोः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005478010, "chapter_id": 25478, "verse_number": "१-४८-११", "content_sanskrit": "सुपुण्यं भवनं रम्यं सर्वरत्नोपशोभितम् ।\nतत्र नारायणः श्रीमान् लक्ष्म्या सह जगत्पतिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005478011, "chapter_id": 25478, "verse_number": "१-४८-१२", "content_sanskrit": "आस्ते सर्वामरश्रेष्ठः पूज्यमानः सनातनः ।\nतथा च वसुधारे तु वसूनां रत्नमण्डितम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005478012, "chapter_id": 25478, "verse_number": "१-४८-१३", "content_sanskrit": "स्थानानामुत्तमं पुण्यं दुराधर्षं सुरद्विषाम् ।\nरत्नधारे गिरिवरे सप्तरर्षीणां महात्मनाम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005478013, "chapter_id": 25478, "verse_number": "१-४८-१४", "content_sanskrit": "सप्ताश्रमाणि पुण्यानि सिद्धावासैर्युतानि च ।\nतत्र हैमं चतुर्द्वारं वज्रनीलादिमण्डितम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005478014, "chapter_id": 25478, "verse_number": "१-४८-१५", "content_sanskrit": "सुपुण्यं सुमहत् स्थानं ब्रह्मणोऽव्यक्तजन्मनः ।\nतत्र देवर्षयो विप्राः सिद्धा ब्रह्मर्षयोऽपरे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005478015, "chapter_id": 25478, "verse_number": "१-४८-१६", "content_sanskrit": "उपासते सदा देवं पितामहमजं परम् ।\nस तैः संपूजितो नित्यं देव्या सह चतुर्मुखः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005478016, "chapter_id": 25478, "verse_number": "१-४८-१७", "content_sanskrit": "आस्ते हिताय लोकानां शान्तानां परमा गतिः ।\nतस्यैकश्रृङ्गशिखरे महापद्मैरलङ्‌कृते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005478017, "chapter_id": 25478, "verse_number": "१-४८-१८", "content_sanskrit": "स्वच्छामृतजलं पुण्यं सुगन्धं सुमहत् सरः ।\nजैगीषव्याश्रमं तत्र योगीन्द्रैरुपशोभितम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005478018, "chapter_id": 25478, "verse_number": "१-४८-१९", "content_sanskrit": "तत्रासौ भगवान् नित्यमास्ते शिष्यैः समावृतः ।\nप्रशान्तदोषैरक्षुद्रैर्ब्रह्मविद्भिर्महात्मभिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005478019, "chapter_id": 25478, "verse_number": "१-४८-२०", "content_sanskrit": "शङ्खो मनोहरश्चैव कौशिकः कृष्ण एव च ।\nसुमना वेदनादश्च शिष्यास्तस्य प्रधानतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005478020, "chapter_id": 25478, "verse_number": "१-४८-२१", "content_sanskrit": "सर्वे योगरताः शान्ता भस्मोद्धूलितविग्रहाः ।\nउपासते महावीर्या ब्रह्मविद्यापरायणाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005478021, "chapter_id": 25478, "verse_number": "१-४८-२२", "content_sanskrit": "तेषामनुग्रहार्थाय यतीनां शान्तचेतसाम् ।\nसान्निध्यं कुरुते भूयो देव्या सह महेश्वरः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005478022, "chapter_id": 25478, "verse_number": "१-४८-२३", "content_sanskrit": "अन्यानिचाश्रमाणि स्युस्तस्मिन् गिरिवरोत्तमे ।\nमुनीनां युक्तमनसां सरांसि सरितस्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005478023, "chapter_id": 25478, "verse_number": "१-४८-२४", "content_sanskrit": "तेषु योगरता विप्रा जापकाः संयतेन्द्रियाः ।\nब्रह्मण्यासक्तमनसो रमन्ते ज्ञानतत्पराः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005478024, "chapter_id": 25478, "verse_number": "१-४८-२५", "content_sanskrit": "आत्मन्यात्मानमाधाय शिखान्तान्तरसंस्थितम् ।\nधायायन्ति देवमीशानं येन सर्वमिदं ततम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005478025, "chapter_id": 25478, "verse_number": "१-४८-२६", "content_sanskrit": "सुमेघे वासवस्थानं सहस्रादित्यसंनिभम् ।\nतत्रास्ते भगवानिन्द्रः शच्या सह सुरेश्वरः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005478026, "chapter_id": 25478, "verse_number": "१-४८-२७", "content_sanskrit": "गजशैले तु दुर्गाया भवनं मणितोरणम् ।\nआस्ते भगवती दुर्गा तत्र साक्षान्महेश्वरी ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005478027, "chapter_id": 25478, "verse_number": "१-४८-२८", "content_sanskrit": "उपास्यमाना विविधैः शक्तिभेदैरितस्ततः ।\nपीत्वा योगामृतं लब्ध्वा साक्षादानन्दमैश्वरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005478028, "chapter_id": 25478, "verse_number": "१-४८-२९", "content_sanskrit": "सुनीलस्य गिरेः श्रृङ्गे नानाधातुसमुज्ज्वले ।\nराक्षसानां पुराणि स्युः सरांसि शतशो द्विजाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005478029, "chapter_id": 25478, "verse_number": "१-४८-३०", "content_sanskrit": "तथा पुरशतं विप्राः शतश्रृङ्गे महाचले ।\nस्फाटिकस्तम्भसंयुक्तं यक्षाणाममितौजसाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005478030, "chapter_id": 25478, "verse_number": "१-४८-३१", "content_sanskrit": "श्वेतोदरगिरेः श्रृङ्गे सुपर्णस्य महात्मनः ।\nप्राकारगोपुरोपेतं मणितोरणमण्डितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005478031, "chapter_id": 25478, "verse_number": "१-४८-३२", "content_sanskrit": "स तत्र गरुडः श्रीमान् साक्षाद् विष्णुरिवापरः ।\nध्यात्वास्ते तत् परं ज्योतिरात्मानं विष्णुमव्ययम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005478032, "chapter_id": 25478, "verse_number": "१-४८-३३", "content_sanskrit": "अन्यच्च भवनं पुण्यं श्रीश्रृङ्गे मुनिपुंगवाः ।\nश्रीदेव्याः सर्वरत्नाढ्यं हैमं सुमणितोरणम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005478033, "chapter_id": 25478, "verse_number": "१-४८-३४", "content_sanskrit": "तत्र सा परमा शक्तिर्विष्णोरतिमनोरमा ।\nअनन्तविभवा लक्ष्मीर्जगत्संमोहनोत्सुका ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005478034, "chapter_id": 25478, "verse_number": "१-४८-३५", "content_sanskrit": "अध्यास्ते देवगन्धर्वसिद्धचारणवन्दिता ।\nविचिन्त्या जगतो योनिः स्वशक्तिकिरणोज्ज्वला ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005478035, "chapter_id": 25478, "verse_number": "१-४८-३६", "content_sanskrit": "तत्रैव देवदेवस्य विष्णोरायतनं महत् ।\nसरांसि तत्र चत्वारि विचित्रकमलाश्रया ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005478036, "chapter_id": 25478, "verse_number": "१-४८-३७", "content_sanskrit": "तथा सहस्रशिखरे विद्याधरपुराष्टकम् ।\nरत्नसोपानसंयुक्तं सरोभिश्चोपशोभितम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005478037, "chapter_id": 25478, "verse_number": "१-४८-३८", "content_sanskrit": "नद्यो विमलपानीयाश्चित्रनीलोत्पलाकराः ।\nकर्णिकारवनं द्विव्यं तत्रास्ते शंकरोऽम्बया ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005478038, "chapter_id": 25478, "verse_number": "१-४८-३९", "content_sanskrit": "परिपात्रे महाशैले महालक्ष्म्याः पुरं शुभम् ।\nरम्यप्रासादसंयुक्तं घण्टाचामरभूषितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005478039, "chapter_id": 25478, "verse_number": "१-४८-४०", "content_sanskrit": "नृत्यद्भिरप्सरः सङ्घैरितश्चेतश्च शोभितम् ।\nमृदङ्गपणवोद्‌घुष्टं वीणावेणुनिनादितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005478040, "chapter_id": 25478, "verse_number": "१-४८-४१", "content_sanskrit": "गन्धर्वकिन्नराकीर्णं संवृतं सिद्धपुंगवैः ।\nभास्वद्भित्तिसमाकीर्णं महाप्रासादसंकुलम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005478041, "chapter_id": 25478, "verse_number": "१-४८-४२", "content_sanskrit": "गणेश्वराङ्गनाजुष्टं धार्मिकाणां सुदर्शनम् ।\nतत्र सा वसते देवी नित्यं योगपरायणा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005478042, "chapter_id": 25478, "verse_number": "१-४८-४३", "content_sanskrit": "महालक्ष्मीर्महादेवी त्रिशूलवरधारिणी ।\nत्रिनेत्रा सर्वशक्त्यौघा संवृता सदसन्मया ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005478043, "chapter_id": 25478, "verse_number": "१-४८-४४", "content_sanskrit": "पश्यन्ति तत्र मुनयः सिद्धा ये ब्रह्मवादिनः ।\nसुपार्श्वस्योत्तरे भागे सरस्वत्याः पुरोत्तमम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005478044, "chapter_id": 25478, "verse_number": "१-४८-४५", "content_sanskrit": "सरांसि सिद्धजुष्टानि देवभोग्यानि सत्तमाः ।\nपाण्डुरस्य गिरेः श्रृङ्गे विचित्रद्रुमसंकुले ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005478045, "chapter_id": 25478, "verse_number": "१-४८-४६", "content_sanskrit": "गन्धर्वाणां पुरशतं दिव्यस्त्रीभिः समावृतम् ।\nतेषु नित्यं मदोत्सिक्ता नरानार्यस्तथैव च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005478046, "chapter_id": 25478, "verse_number": "१-४८-४७", "content_sanskrit": "क्रीडन्ति मुदिता नित्यं विलासैर्भोगतत्पराः ।\nअञ्जनस्य गिरेः श्रृङ्गे नारीणां पुरमुत्तमम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005478047, "chapter_id": 25478, "verse_number": "१-४८-४८", "content_sanskrit": "वसन्ति तत्राप्सरसो रम्भाद्या रतिलालसाः ।\nचित्रसेनादयो यत्र समायान्त्यर्थिनः सदा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005478048, "chapter_id": 25478, "verse_number": "१-४८-४९", "content_sanskrit": "सा पुरी सर्वरत्नाढ्या नैकप्रस्रवणैर्युता ।\nअनेकानि पुराणि स्युः कौमुदे चापि सुव्रताः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005478049, "chapter_id": 25478, "verse_number": "१-४८-५०", "content_sanskrit": "रुद्राणां शान्तरजसामीश्वरार्पितचेतसाम् ।\nतेषु रुद्रा महायोगा महेशान्तरचारिणः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005478050, "chapter_id": 25478, "verse_number": "१-४८-५१", "content_sanskrit": "समासते पुरं ज्योतिरारूढाः स्थानमुत्तमम् ।\nपिञ्जरस्य गिरेः श्रृङ्गे गणेशानां पुरत्रयम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005478051, "chapter_id": 25478, "verse_number": "१-४८-५२", "content_sanskrit": "नन्दीश्वरस्य कपिला तत्रास्ते समहामतिः ।\nतथा च जारुधेः श्रृङ्गे देवदेवस्य धीमतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005478052, "chapter_id": 25478, "verse_number": "१-४८-५३", "content_sanskrit": "दीप्तमायतनं पुण्यं भास्करस्यामितौजसः ।\nतस्यैवोत्तरदिग्भागे चन्द्रस्थानमनुत्तमम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005478053, "chapter_id": 25478, "verse_number": "१-४८-५४", "content_sanskrit": "रमते तत्र रम्योऽसौ भगवान् शीतदीधितिः ।\nअन्यच्च भवनं दिव्यं हंसशैले महर्षयः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005478054, "chapter_id": 25478, "verse_number": "१-४८-५५", "content_sanskrit": "सहस्रयोजनायामं सुवर्णमणितोरणम् ।\nतत्रास्ते भगवान् ब्रह्मा सिद्धसङ्घैरभिष्टुतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005478055, "chapter_id": 25478, "verse_number": "१-४८-५६", "content_sanskrit": "सावित्र्या सह विश्वात्मा वासुदेवादिभिर्युतः ।\nतस्य दक्षिणदिग्भागे सिद्धानां पुरमुत्तमम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005478056, "chapter_id": 25478, "verse_number": "१-४८-५७", "content_sanskrit": "सनन्दनादयो यत्र वसन्ति मुनिपुंगवाः ।\nपञ्चशैलस्य शिखरे दानवानां पुरत्रयम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005478057, "chapter_id": 25478, "verse_number": "१-४८-५८", "content_sanskrit": "नातिदूरेण तस्माच्च दैत्याचार्यस्य धीमतः ।\nसुगन्धशैलशिखरे सरिद्भिरुपशोभितम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005478058, "chapter_id": 25478, "verse_number": "१-४८-५९", "content_sanskrit": "कर्दमस्याश्रमं पुण्यं तत्रास्ते भगवानृषिः ।\nतस्यैव पूर्वदिग्भागे किञ्चिद् वै दक्षिणाश्रिते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005478059, "chapter_id": 25478, "verse_number": "१-४८-६०", "content_sanskrit": "सनत्कुमारो भगवांस्तत्रास्ते ब्रह्मवित्तमः ।\nसर्वेष्वेतेषु शैलेषु ततान्येषु मुनीश्वराः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005478060, "chapter_id": 25478, "verse_number": "१-४८-६१", "content_sanskrit": "सरांसि विमला नद्यो देवानामालयानि च ।\nसिद्धलिङ्गानि पुण्यानि मुनिभिः स्थापितानि तु ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005478061, "chapter_id": 25478, "verse_number": "१-४८-६२", "content_sanskrit": "वन्यान्याश्रमवर्याणि संख्यातुं नैव शक्यते ।\nएष संक्षेपतः प्रोक्तो जम्बूद्वीपस्य विस्तरः ।\nन शक्यं विस्तराद् वक्तुं मया वर्षशतैरपि ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]