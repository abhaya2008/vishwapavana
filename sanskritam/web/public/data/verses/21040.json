[{"id": 7001040000, "chapter_id": 21040, "verse_number": "५-२२-१", "content_sanskrit": "जरासन्घसुते कंस उपयेमे महाबलः ।\nअस्ति प्राप्तिञ्च मैत्रेय!तयोर्भर्त्तृहनं हरिम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001040001, "chapter_id": 21040, "verse_number": "५-२२-२", "content_sanskrit": "महाबलपरीवारो मगधाघिपतिर्बली ।\nहन्तुमभ्याययौ कोपाज्जरासन्धः सयादवम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001040002, "chapter_id": 21040, "verse_number": "५-२२-३", "content_sanskrit": "उपेत्य मथुरां सोऽथ रुरोध मगधेखरः ।\nअक्षौहिणीभिः सैन्यस्य त्रयोविंशतिभिर्वृतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001040003, "chapter_id": 21040, "verse_number": "५-२२-४", "content_sanskrit": "निष्कम्याल्पपरीवारावुभौ राम-जनार्द्दनौ ।\nयुयुधातौ समं तस्य बलिनौ बलिसैनिकैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001040004, "chapter_id": 21040, "verse_number": "५-२२-५", "content_sanskrit": "ततो बलश्व कृष्णश्व चक्राते मतिमुत्तमाम् ।\nआयुधानां पुराणानामादाने मुनिसत्तम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001040005, "chapter_id": 21040, "verse_number": "५-२२-६", "content_sanskrit": "अनन्तरं हरेः शाङ्ग तूणौ चाक्षयसायकौ ।\nआकाशादागतौ वीर!तथा कौमोदकी गदा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001040006, "chapter_id": 21040, "verse_number": "५-२२-७", "content_sanskrit": "हलञ्च बलभद्रस्य गगनादागतं कवे!\nमनसोऽभिमतं विप्र!सौनन्दं मुसलं तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001040007, "chapter_id": 21040, "verse_number": "५-२२-८", "content_sanskrit": "ततो युद्धे पराजित्य ससैन्यं मगधाधिपम् ।\nपुरीं विविशतुर्वीरावुभौ राम-जनार्द्दनौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001040008, "chapter_id": 21040, "verse_number": "५-२२-९", "content_sanskrit": "जते तस्मिन् सुदुर्वृत्ते जरासन्धे महामुने!\nजीवमाने गते कृष्णस्तं नामन्यत निर्ज्जितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001040009, "chapter_id": 21040, "verse_number": "५-२२-१०", "content_sanskrit": "पुनरप्याजगामाथ जरासन्धो बलान्वितः ।\nजितश्व राम-कृष्णाभ्यामपक्रान्तो द्रिजोत्तम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001040010, "chapter_id": 21040, "verse_number": "५-२२-११", "content_sanskrit": "दश चाष्टौ च संग्रामानेवमत्यन्तदुर्म्मदः ।\nयदुभिर्मागधो राजा चक्र कृष्णापुरोगमैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001040011, "chapter_id": 21040, "verse_number": "५-२२-१२", "content_sanskrit": "सर्व्वेष्वेतेषु युद्धेषु यादवैः स पराजितः ।\nअपक्रान्तो जरासन्धः स्वल्पसैन्यैर्बलाधिकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001040012, "chapter_id": 21040, "verse_number": "५-२२-१३", "content_sanskrit": "तदू बल यादवानां तैरर्ज्जितं यदनेकशः ।\nतत्तु सन्निधिमाहात्म्यं विष्णोरंशस्य चक्रिणः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001040013, "chapter_id": 21040, "verse_number": "५-२२-१४", "content_sanskrit": "मनुष्यधर्म्मशीलस्य लीला सा जगतः पतेः ।\nअस्त्रणयनेकरूपाणि यदरातिषु मुञ्चति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001040014, "chapter_id": 21040, "verse_number": "५-२२-१५", "content_sanskrit": "मनसैव जगत्सृष्टिं संहारञ्च करोति यः ।\nतस्यारिपक्षक्षपणे कोऽयमुद्यमविस्तरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001040015, "chapter_id": 21040, "verse_number": "५-२२-१६", "content_sanskrit": "तथापि यो मनुष्याणां धर्म्मस्तमनुवर्त्तते ।\nकुर्व्वने बलवता सन्धिं हीनैर्युद्धं करोत्यसौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001040016, "chapter_id": 21040, "verse_number": "५-२२-१७", "content_sanskrit": "साम चोपप्रदानञ्च तथा भेदं प्रदर्शयन् ।\nकरोति दण्डपातञ्च क्बचिदेव पलायनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001040017, "chapter_id": 21040, "verse_number": "५-२२-१८", "content_sanskrit": "मनुष्यदेहिनां चेष्टामित्येवमनुवर्त्ततः ।\nलीला जगतूपतेस्तस्य च्छन्दतः सम्प्रवर्त्तते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]