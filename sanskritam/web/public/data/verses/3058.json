[{"id": 2096262, "chapter_id": 3058, "verse_number": "१३-१८८-१", "content_sanskrit": "[*युधिष्ठिर उवाच।\nजन्म मानुष्यकं प्राप्य कर्मक्षेत्रं सुदुर्लभम्।\nश्रेयोर्थिना दरिद्रेण किं कर्तव्यं पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096263, "chapter_id": 3058, "verse_number": "१३-१८८-२", "content_sanskrit": "दानानामुत्तमं यच्च देयं यच्च यथायथा।\nमान्यान्पूज्यांश्च गाङ्गेय रहस्यं वक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096264, "chapter_id": 3058, "verse_number": "१३-१८८-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096265, "chapter_id": 3058, "verse_number": "१३-१८८-३", "content_sanskrit": "एवं पृष्टो नरेन्द्रेण पाण्डवेन यशस्विना।\nधर्माणां परमं गुह्यं भीष्मः प्रोवाच पार्थिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096266, "chapter_id": 3058, "verse_number": "१३-१८८-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096267, "chapter_id": 3058, "verse_number": "१३-१८८-४", "content_sanskrit": "शृणुष्वावहितो राजन्धर्मगुह्यानि भारत।\nयथाहि भगवान्व्यासः पुरा कथितवान्मयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096268, "chapter_id": 3058, "verse_number": "१३-१८८-५", "content_sanskrit": "देवगुह्यमिदं राजन्यमेनाक्लिष्टकर्मणा।\nनियमस्थेन युक्तेन तपसो महतः फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096269, "chapter_id": 3058, "verse_number": "१३-१८८-६", "content_sanskrit": "येन यः प्रीयते देवः प्रीयन्ते पितरस्तथा।\nऋषयः प्रमथाः श्रीश्च चित्रगुप्तो दिशां गजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096270, "chapter_id": 3058, "verse_number": "१३-१८८-७", "content_sanskrit": "ऋषिधर्मः स्मृतो यत्र सरहस्यो महाफलः।\nमहादानफलं चैव सर्वयज्ञफलं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096271, "chapter_id": 3058, "verse_number": "१३-१८८-८", "content_sanskrit": "यश्चैतदेवं जानीयाज्ज्ञात्वा वा कुरुतेऽनघ।\nसदोषोऽदोषवांश्चेह तैर्गुणैः सह युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096272, "chapter_id": 3058, "verse_number": "१३-१८८-९", "content_sanskrit": "दशसूनासमं चक्रं दशचक्रसमो ध्वजः।\nदशध्वजसमा वेश्या दशवेश्यासमो नृपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096273, "chapter_id": 3058, "verse_number": "१३-१८८-१०", "content_sanskrit": "अर्घेनैतानि सर्वाणि नृपतिः कथ्यतेऽधिकः।\nत्रिवर्गसहितं शास्त्रं पवित्रं पुण्यलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096274, "chapter_id": 3058, "verse_number": "१३-१८८-११", "content_sanskrit": "धर्मिव्याकरणं पुण्यं रहस्यश्रवणं महत्।\nश्रोतव्यं धर्मसंयुक्तं विहितं त्रिदशैः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096275, "chapter_id": 3058, "verse_number": "१३-१८८-१२", "content_sanskrit": "पितॄणां यत्र गुह्यानि प्रोच्यन्ते श्राद्धकर्मणि।\nदेवतानां च सर्वेषां रहस्यं कथ्यतेऽखिलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096276, "chapter_id": 3058, "verse_number": "१३-१८८-१३", "content_sanskrit": "ऋषिधर्मः स्मृतो यत्र सरहस्यो महाफलः।\nमहायज्ञफलं चैव सर्वदानफलं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096277, "chapter_id": 3058, "verse_number": "१३-१८८-१४", "content_sanskrit": "ये पठन्ति सदा मर्त्या येषां चैवोपतिष्ठति।\nश्रुत्वा च फलमाचष्टे स्वयं नारायणः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096278, "chapter_id": 3058, "verse_number": "१३-१८८-१५", "content_sanskrit": "गवां फलं तीर्थफलं यज्ञानां चैव यत्फलम्।\nएतत्फलमवाप्नोति यो नरोऽतिथिपूजकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096279, "chapter_id": 3058, "verse_number": "१३-१८८-१६", "content_sanskrit": "श्रोतारः श्रद्धधानाश्च येषां शुद्धं च मानसम्।\nतेषां व्यक्तं जिता लोकाः श्रद्दधानेन साधुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096280, "chapter_id": 3058, "verse_number": "१३-१८८-१७", "content_sanskrit": "मुच्यते किल्बिषाच्चैव न स पापेन लिप्यते।\nधर्मं च लभते नित्यं प्रेत्य लोकगतो नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096281, "chapter_id": 3058, "verse_number": "१३-१८८-१८", "content_sanskrit": "कस्यचित्त्वथ कालस्य देवदूतो यदृच्छया।\nस्थितो ह्यन्तर्हितो भूत्वा पर्यभाषत वासवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096282, "chapter_id": 3058, "verse_number": "१३-१८८-१९", "content_sanskrit": "यो तौ कामगुणोपेतावश्विनौ भिषजां वरौ।\nआज्ञयाऽहं तयोः प्राप्तः सनरान्पितृदैवतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096283, "chapter_id": 3058, "verse_number": "१३-१८८-२०", "content_sanskrit": "कस्माद्धि मैथुनं श्राद्धे दातुर्भोक्तुश्च वर्जितम्।\nकेमर्थं च त्रयः पिण्डाः प्रविभक्ताः पृथक्पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096284, "chapter_id": 3058, "verse_number": "१३-१८८-२१", "content_sanskrit": "प्रथमः कस्य दातव्यो मध्यमः क्व च गच्छति।\nउत्तरश्च स्मृतः कस्य एतदिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096285, "chapter_id": 3058, "verse_number": "१३-१८८-२२", "content_sanskrit": "श्रद्दधानेन दूतेन भाषितं धर्मसंहितम्।\nपूर्वस्थास्त्रिदशाः सर्वे पितरः पूज्य खेचरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096286, "chapter_id": 3058, "verse_number": "१३-१८८-२३x", "content_sanskrit": "पितर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096287, "chapter_id": 3058, "verse_number": "१३-१८८-२३", "content_sanskrit": "स्वागतं तेऽस्तु भद्रं ते श्रूयतां खेचरोत्तम।\nगूढार्थः परमः प्रश्नो भवता समुदीरितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096288, "chapter_id": 3058, "verse_number": "१३-१८८-२४", "content_sanskrit": "श्राद्धं दत्त्वा च भुक्त्वा च पुरुषो यः स्त्रियं व्रजेत्।\nपितरस्तस्य तं मासं तस्मिन्रेतसि शेरते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2096289, "chapter_id": 3058, "verse_number": "१३-१८८-२५", "content_sanskrit": "प्रविभागं तु पिण्डानां प्रवक्ष्याम्यनुपूर्वशः।\nपिण्डो ह्यधस्ताद्गच्छंस्तु अप आविश्य भावयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2096290, "chapter_id": 3058, "verse_number": "१३-१८८-२६", "content_sanskrit": "पिण्डं तु मध्यमं तत्र पत्नीत्वेका समश्नुते।\nपिण्डस्तृतीयो यस्तेषां तं दद्याज्जातवेदसि।\nएष श्राद्धविधिः प्रोक्तो यथा धर्मो न लुप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2096291, "chapter_id": 3058, "verse_number": "१३-१८८-२७", "content_sanskrit": "पितरस्तस्य तुष्यन्ति प्रहृष्टमनसः सदा।\nप्रजा विवर्धते चास्य अक्षयं चोपतिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2096292, "chapter_id": 3058, "verse_number": "१३-१८८-२८x", "content_sanskrit": "देवदूत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2096293, "chapter_id": 3058, "verse_number": "१३-१८८-२८", "content_sanskrit": "आनुपूर्व्येण पिण्डानां प्रविभागः पृथक्पृथक्।\nपितॄणां त्रिषु सर्वेषां निरुक्तं कथितं त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2096294, "chapter_id": 3058, "verse_number": "१३-१८८-२९", "content_sanskrit": "एकः समुद्धृतः पिण्डो ह्यधस्तात्कस्य गच्छति।\nकं वा प्रीणयते देवं कथं तारयते पितॄन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2096295, "chapter_id": 3058, "verse_number": "१३-१८८-३०", "content_sanskrit": "मध्यमं तु तदा पत्नी भुङ्क्तेऽनुज्ञातमेव हि।\nकिमर्थं पितरस्तस्य कव्यमेव च भुञ्जते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2096296, "chapter_id": 3058, "verse_number": "१३-१८८-३१", "content_sanskrit": "अत्र यस्त्वन्तिमः पिण्डो गच्छते जातवेदसम्।\nभवते का गतिस्तस्य कं वा समनुगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2096297, "chapter_id": 3058, "verse_number": "१३-१८८-३२", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं पिण्डेषु त्रिषु या गतिः।\nफलं वृत्तिं च मार्गं च यश्चैनं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2096298, "chapter_id": 3058, "verse_number": "१३-१८८-३३x", "content_sanskrit": "पितर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2096299, "chapter_id": 3058, "verse_number": "१३-१८८-३३", "content_sanskrit": "सुमहानेष प्रश्नो वै यस्त्वया समुदीरितः।\nरहस्यमद्भुतं चापि पृष्टाः स्म गगनेचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2096300, "chapter_id": 3058, "verse_number": "१३-१८८-३४", "content_sanskrit": "एतदेव प्रशंसन्ति देवाश्च मुनयस्तथा।\nतेऽप्येवं नाभिजानन्ति पितृकार्यविनिश्चयम्।\nवर्जयित्वा महात्मानं चिरजीविनमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2096301, "chapter_id": 3058, "verse_number": "१३-१८८-३५", "content_sanskrit": "पितृभक्तस्तु यो विप्रो वलब्धो महायशाः।\nत्रयाणामपि पिण्डानां श्रुत्वा भगवतो गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2096302, "chapter_id": 3058, "verse_number": "१३-१८८-३६", "content_sanskrit": "देवदूतेन यः पृष्टः श्राद्धस्य विदिनिश्चयः।\nगतिं त्रयाणां पिण्डानां शृणुष्वावहितो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2096303, "chapter_id": 3058, "verse_number": "१३-१८८-३७", "content_sanskrit": "अपो गच्छति यो ह्यत्र शशिनं ह्येष प्रीणयेत्।\nशशी प्रीणयते देवान्पितॄंश्चैव महामते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2096304, "chapter_id": 3058, "verse_number": "१३-१८८-३८", "content_sanskrit": "भुङ्क्ते तु पत्नीं यं चैषामनुज्ञाता तु मध्यमम्।\nपुत्रकामाय पुत्रं तु प्रयच्छन्ति पितामहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2096305, "chapter_id": 3058, "verse_number": "१३-१८८-३९", "content_sanskrit": "हव्यवाहे तु यः पिण्डो दीयते तन्निबोध मे।\nपितरस्तेन तृप्यन्ति प्रीताः कामान्दिशन्ति च।\nएतत्ते कथितं सर्वं त्रिषु पिण्डेषु या गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2096306, "chapter_id": 3058, "verse_number": "१३-१८८-४०", "content_sanskrit": "ऋत्विग्यो यजमानस्य पितृत्वमनुगच्छति।\nतस्मिन्नहनि मन्यन्ते परिहार्यं हि मैथुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2096307, "chapter_id": 3058, "verse_number": "१३-१८८-४१", "content_sanskrit": "शुचिना तु सदा श्राद्धं भोक्तव्यं खेचरोत्तम।\nये मया कथिता दोषास्ते तथा स्युर्न चान्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2096308, "chapter_id": 3058, "verse_number": "१३-१८८-४२", "content_sanskrit": "तस्मात्स्नातः शुचिः क्षान्तः श्राद्धं भुञ्जीत वै द्विजः।\nप्रजा विवर्दते चास्य चश्चैवं सम्प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2096309, "chapter_id": 3058, "verse_number": "१३-१८८-४३", "content_sanskrit": "ततो विद्युत्प्रभो नाम ऋषिराह महातपाः।\nआदित्यतेजसा तस्य तुल्यं रूपं प्रकाशते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2096310, "chapter_id": 3058, "verse_number": "१३-१८८-४४", "content_sanskrit": "स च धर्मरहस्यानि श्रुत्वा शक्रमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2096311, "chapter_id": 3058, "verse_number": "१३-१८८-४५", "content_sanskrit": "तिर्यग्योनिगतान्सत्वान्मर्त्या हिंसन्ति मोहिताः।\nकीटान्पिपीलिकान्सर्पान्मेषान्समृगपक्षिणः।\nकिल्बिषं सुबहु प्राप्ताः किंस्विदेषां प्रतिक्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2096312, "chapter_id": 3058, "verse_number": "१३-१८८-४६", "content_sanskrit": "ततो देवगणाः सर्वे ऋषयश्च तपोधनाः।\nपितरश्च महाभागाः पूजयन्ति स्म तं मुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2096313, "chapter_id": 3058, "verse_number": "१३-१८८-४७x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2096314, "chapter_id": 3058, "verse_number": "१३-१८८-४७", "content_sanskrit": "कुरुक्षेत्रं गयां गङ्गां प्रभासं पुष्कराणि च।\nएतानि मनसा ध्यात्वा अवगाहेत्ततो जलम्।\nतथा मुच्यति पापेनि राहुणा चन्द्रमा यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2096315, "chapter_id": 3058, "verse_number": "१३-१८८-४८", "content_sanskrit": "त्र्यहं स्नातः स भवति निराहारश्च वर्तते।\nस्पृशते यो गवां पृष्ठं वालधिं च नमस्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2096316, "chapter_id": 3058, "verse_number": "१३-१८८-४९", "content_sanskrit": "ततो विद्युत्प्रभो वाक्यमभ्यभाषत वासवम्।\nअयं सूक्ष्मतरो धर्मस्तं निबोध शतक्रतो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2096317, "chapter_id": 3058, "verse_number": "१३-१८८-५०", "content_sanskrit": "घृष्टो वटकषायेणि अनुलिप्तः प्रियङ्गुणा।\nक्षीरेण षष्टिकान्भुक्त्वा सर्वपापैः प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2096318, "chapter_id": 3058, "verse_number": "१३-१८८-५१", "content_sanskrit": "श्रूयतां चापरं गुह्यं रहस्यमृषिचिन्तितम्।\nश्रुतं मे भाषमाणस्य स्थाणोः स्थाने बृहस्पतेः।\nरुद्रेण सह देवेश तन्निबोध शचीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2096319, "chapter_id": 3058, "verse_number": "१३-१८८-५२", "content_sanskrit": "पर्वतारोहणं कृत्वा एकपादो विभावसुम्।\nनिरीक्षेत निराहार ऊर्ध्वबाहुः कृताञ्जलिः।\nतपसा महता युक्त उपवासफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2096320, "chapter_id": 3058, "verse_number": "१३-१८८-५३", "content_sanskrit": "रश्मिभिस्तापितोऽर्कस्य सर्वपापमपोहति।\nग्रीष्मकालेऽथवा शीते एवं पापमपोहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2096321, "chapter_id": 3058, "verse_number": "१३-१८८-५४", "content_sanskrit": "ततः पापात्प्रमुक्तस्य द्युतिर्भवति शाश्वती।\nतेजसा सूर्यवद्दीप्तो भ्राजते सोमवत्पनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2096322, "chapter_id": 3058, "verse_number": "१३-१८८-५४", "content_sanskrit": "मध्ये त्रिदशवर्गस्य देवराजः शतक्रतुः।\nउवाच मधुरं वाक्यं बृहस्पतिमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2096323, "chapter_id": 3058, "verse_number": "१३-१८८-५६", "content_sanskrit": "धर्मगुह्यं तु भगवन्मानुषाणां सुखावहम्।\nसरहस्याश्च ये दोषास्तान्यथावदुदीरथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2096324, "chapter_id": 3058, "verse_number": "१३-१८८-५७x", "content_sanskrit": "बृहस्पतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2096325, "chapter_id": 3058, "verse_number": "१३-१८८-५७", "content_sanskrit": "प्रतिमेहन्ति ये सूर्यमनिलं द्विषते च ये।\nहव्यवाहे प्रदीप्ते च समिधं ये न जुह्वति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2096326, "chapter_id": 3058, "verse_number": "१३-१८८-५८", "content_sanskrit": "बालवत्सां च ये धेनुं दुहन्ति क्षीरकारणात्।\nतेषां दोषान्प्रवक्ष्यामि तान्निबोध शचीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2096327, "chapter_id": 3058, "verse_number": "१३-१८८-५९", "content_sanskrit": "भानुमाननिलश्चैव हव्यवाहश्च वासव।\nलोकानां मातरश्चैव गावः सृष्टाः स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2096328, "chapter_id": 3058, "verse_number": "१३-१८८-६०", "content_sanskrit": "लोकांस्तारयितुं शक्ता मर्त्येष्वेतेषु देवताः।\nसर्वे भवन्तः शृणिवन्तु एकैकं धर्मनिश्चयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2096329, "chapter_id": 3058, "verse_number": "१३-१८८-६१", "content_sanskrit": "वर्षाणि षडशीतिं तु दुर्वृत्ताः कुलपांसनाः।\nस्त्रियः सर्वाश्च दुर्वृत्ताः प्रतिमेहन्ति या रविम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2096330, "chapter_id": 3058, "verse_number": "१३-१८८-६२", "content_sanskrit": "अनिलद्वेषिणः शक्र गर्भस्था च्यवते प्रजा।\nहव्यवाहस्य दीप्तस्य समिधं ये न जुह्वति।\nअग्निकार्येषु वै तेषां हव्यं नाश्नाति पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2096331, "chapter_id": 3058, "verse_number": "१३-१८८-६३", "content_sanskrit": "क्षीरं तु बालवत्सानां ये पिबन्तीह मानवाः।\nन तेषां क्षीरपाः केचिज्जायन्ते कुलवर्धनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2096332, "chapter_id": 3058, "verse_number": "१३-१८८-६४", "content_sanskrit": "प्रजाक्षयेण युज्यन्ते कुलवंशक्षयेण च।\nएवमेतत्पुरा दृष्टं कुलवृद्धैर्द्विजातिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2096333, "chapter_id": 3058, "verse_number": "१३-१८८-६५", "content_sanskrit": "तस्माद्वर्ज्यानि वर्ज्यानि कार्यं कार्यं च नित्यशः।\nभूतिकामेनि मर्त्येन सत्यमेतद्ब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2096334, "chapter_id": 3058, "verse_number": "१३-१८८-६६", "content_sanskrit": "ततः सर्वा महाभाग देवताः समरुद्गणाः।\nऋषयश्च महाभागाः पृच्छन्ति स्म पितॄंस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2096335, "chapter_id": 3058, "verse_number": "१३-१८८-६७", "content_sanskrit": "पितरः केन तुष्यन्ति मर्त्यानामल्पचेतसाम्।\nअक्षयं च कथं दानं भवेच्चैवौर्ध्वदेहिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2096336, "chapter_id": 3058, "verse_number": "१३-१८८-६८", "content_sanskrit": "आनृण्यं वा कथं मर्त्या गच्छेयुः केन कर्मणा।\nएतदिच्छामहे श्रोतुं परं कौतूहलं हि नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2096337, "chapter_id": 3058, "verse_number": "१३-१८८-६९x", "content_sanskrit": "पितर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2096338, "chapter_id": 3058, "verse_number": "१३-१८८-६९", "content_sanskrit": "न्यायतो वै महाभागाः संशयः समुदाहृतः।\nश्रूयतां येन तुष्यामो मर्त्यानां साधुकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2096339, "chapter_id": 3058, "verse_number": "१३-१८८-७०", "content_sanskrit": "नीलषण्डप्रमोक्षेण अणावास्यां तिलोदकैः।\nवर्षासु दीपकैश्चैव पितॄणामनृणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2096340, "chapter_id": 3058, "verse_number": "१३-१८८-७१", "content_sanskrit": "अक्षयं निर्व्यलीकं च दानमेतन्महाफलम्।\nअस्माकं परितोषश्च अक्षयः परिकीर्त्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2096341, "chapter_id": 3058, "verse_number": "१३-१८८-७२", "content_sanskrit": "श्रद्धधानाश्च ये मर्त्या आहरिष्यन्ति सन्ततिम्।\nदुर्गात्ते तारयिष्यन्ति नरकात्प्रपितामहान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2096342, "chapter_id": 3058, "verse_number": "१३-१८८-७३", "content_sanskrit": "पितॄणां भाषितं श्रुत्वा हृष्टरोमा तपोधनः।\nवृद्धगार्ग्यो महातेजास्तानेवं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2096343, "chapter_id": 3058, "verse_number": "१३-१८८-७४", "content_sanskrit": "के गुणा नीलषण्डस्य प्रमुक्तस्य तपोधनाः।\nवर्षासु दीपदानेन तथैव च तिलोदकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2096344, "chapter_id": 3058, "verse_number": "१३-१८८-७५x", "content_sanskrit": "पितर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2096345, "chapter_id": 3058, "verse_number": "१३-१८८-७५", "content_sanskrit": "नीलषण्डस्य लाङ्गूलं तोयमभ्युद्दरेद्यदि।\nषष्टिं वर्षसहस्राणि पितरस्तेन तर्पिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2096346, "chapter_id": 3058, "verse_number": "१३-१८८-७६", "content_sanskrit": "यस्तु शृङ्गगतं पङ्क्तं कूलादुद्धृत्य तिष्ठति।\nपितरस्तेन गच्छन्ति सोमलोकमसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2096347, "chapter_id": 3058, "verse_number": "१३-१८८-७७", "content_sanskrit": "वर्षासु दीपदानेन शशीवच्छोभते नरः।\nतमोरूपं न तस्यास्ति दीपकं यः प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2096348, "chapter_id": 3058, "verse_number": "१३-१८८-७८", "content_sanskrit": "अमावास्यां तु ये मर्त्याः प्रयच्छन्ति तिलोदकम्।\nपात्रमौदुम्बरं गृह्य मधुमिश्रं तपोधन।\nकृतं भवति तैः श्राद्धं सरहस्यं यथार्थवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2096349, "chapter_id": 3058, "verse_number": "१३-१८८-७९", "content_sanskrit": "हृष्टपुष्टमनास्तेषां प्रजा भवति नित्यदा।\nकुलवंशस्य वृद्धिस्तु पिण्डदस्य फलं भवेत्।\nश्रद्दधानस्तु यः कुर्यात्पितॄणामनृणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2096350, "chapter_id": 3058, "verse_number": "१३-१८८-८०", "content_sanskrit": "एवमेव समुद्दिष्टः श्राद्धकालक्रमस्तथा।\nविधिः पात्रं फलं चैव यथावदनुकीर्तितम्॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2096351, "chapter_id": 3058, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टाशीत्यधिकशततमोऽध्यायः॥ १८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}]