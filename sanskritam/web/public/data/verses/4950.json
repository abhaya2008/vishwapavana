[{"id": 2186053, "chapter_id": 4950, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2186054, "chapter_id": 4950, "verse_number": "१", "content_sanskrit": "अथ तत्र महार्चिष्माननलो वातसारथिः ।\nतस्याविदूरे रक्षार्थं खगेन्द्रेण कृतोऽभवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2186055, "chapter_id": 4950, "verse_number": "२", "content_sanskrit": "स चापि पार्श्वे सुष्वाप विश्वस्तो बकराट् तदा ।\nकृतघ्नस्तु स दुष्टात्मा तं जिघांसुरजागरत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2186056, "chapter_id": 4950, "verse_number": "३", "content_sanskrit": "ततोऽलातेन दीप्तेन विश्वस्तं निजघान तम् ।\nनिहत्य च मुदा युक्तः सोऽनुबन्धं न दृष्टवान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2186057, "chapter_id": 4950, "verse_number": "४", "content_sanskrit": "स तं विपक्षरोमाणं कृत्वा जीवपरस्तदा ।\nतं गृहीत्वा सुवर्णं च ययौ द्रुततरं द्विजः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2186058, "chapter_id": 4950, "verse_number": "५", "content_sanskrit": "ततोऽन्यस्मिन् गते चाह्नि विरूपाक्षोऽब्रवीत् सुतम् ।\nन प्रेक्षे राजधर्माणमद्य पुत्र खगोत्तमम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2186059, "chapter_id": 4950, "verse_number": "६", "content_sanskrit": "स पूर्वसन्ध्यां ब्रह्माणं वन्दितुं याति सर्वदा ।\nमां चादृष्ट्वा कदाचित्स न गच्छति गृहान् खगः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2186060, "chapter_id": 4950, "verse_number": "७", "content_sanskrit": "उभे द्विरात्रं सन्ध्ये वै नाभ्यगात् स ममालयम् ।\nतस्मान्न शुद्ध्यते भावो मम स ज्ञायतां सुहृत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2186061, "chapter_id": 4950, "verse_number": "८", "content_sanskrit": "स्वाध्यायेन वियुक्तो हि ब्रह्मवर्चसवर्जितः ।\nतं गतस्तत्र मे शङ्का हन्यात्तं स द्विजाधमः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2186062, "chapter_id": 4950, "verse_number": "९", "content_sanskrit": "दुराचारस्तु दुर्बुद्धिरिङ्गितैर्लक्षितो मया ।\nनिष्क्रियो दारुणाकारः कृष्णो दस्युरिवाधमः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2186063, "chapter_id": 4950, "verse_number": "१०", "content_sanskrit": "गौतमः स गतस्तत्र तेनोद्विग्नं मनो मम ।\nपुत्र शीघ्रमितो गत्वा राजधर्मनिवेशनम् ।\nज्ञायतां स विशुद्धात्मा यदि जीवति माचिरम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2186064, "chapter_id": 4950, "verse_number": "११", "content_sanskrit": "स एवमुक्तस्त्वरितो रक्षोभिः सहितो ययौ ।\nन्यग्रोधं तत्र चापश्यत् कङ्कालं राजधर्मणः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2186065, "chapter_id": 4950, "verse_number": "१२", "content_sanskrit": "न्यग्रोधे राजधर्माणमपश्यन्निहतं ततः ।\nरुदित्वा बहु तत्तद्वै विलप्य च स राक्षसः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186066, "chapter_id": 4950, "verse_number": "१३", "content_sanskrit": "गतो रोषसमाविष्टो गौतमग्रहणाय वै ।\nगृहीतो गौतमः पापो रक्षोभिः क्रोधमूर्च्छितैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186067, "chapter_id": 4950, "verse_number": "१४", "content_sanskrit": "राजधर्मशरीरस्य कङ्कालं चाप्यथो धृतम् ।\nमेरुपृष्ठे च नगरं यातुधानास्ततो गताः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2186068, "chapter_id": 4950, "verse_number": "१५", "content_sanskrit": "क्रोधरक्तेक्षणा घोरा गौतमस्य वधे धृताः ।\nपार्थिवस्याग्रतोऽधुस्ते कङ्कालं राजधर्मणः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2186069, "chapter_id": 4950, "verse_number": "१६", "content_sanskrit": "तं दृष्ट्वा विमना राजा सामात्यः सगणोऽभवत् ।\nआर्तनादो महानासीद् गृहे तस्य महात्मनः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2186070, "chapter_id": 4950, "verse_number": "१७", "content_sanskrit": "स्त्रीसङ्घस्य तदा राजन् निहते काश्यपात्मजे ।\nराजा चैवाब्रवीत्पुत्रं पापोऽयं वध्यतामिति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2186071, "chapter_id": 4950, "verse_number": "", "content_sanskrit": "राक्षसाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2186072, "chapter_id": 4950, "verse_number": "१८", "content_sanskrit": "अस्य मांसं वयं सर्वे खादिष्यामः समागताः ।\nपापकृत् पापकर्मा च पापात्मा पापमास्थितः ।\nहन्तव्य एव पापात्मा कृतघ्नो नात्र संशयः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2186073, "chapter_id": 4950, "verse_number": "", "content_sanskrit": "विरूपाक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2186074, "chapter_id": 4950, "verse_number": "१९", "content_sanskrit": "कृतघ्नं पापकर्माणं न भक्षयितुमुत्सहे ।\nदासेभ्यो दीयतामेष मित्रध्रुक् पुरुषाधमः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2186075, "chapter_id": 4950, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2186076, "chapter_id": 4950, "verse_number": "२०", "content_sanskrit": "दासाः सर्वे समाहूता यातुधानास्तथा परे ।\nनेच्छन्ति स्म कृतघ्नं तं खादितुं पुरुषोत्तम\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2186077, "chapter_id": 4950, "verse_number": "२१", "content_sanskrit": "शिरोभिश्च गता भूमिं महाराज ततो बलात् ।\nमा नार्थं जातनिर्बन्धं किल्बिषं दातुमर्हसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2186078, "chapter_id": 4950, "verse_number": "२२", "content_sanskrit": "यातुधाना नृपेणोक्ताः पापकर्मा विशस्यताम् ।\nभक्ष्यतां त्यज्यतां वायं दर्शनान्मेऽपनीयताम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2186079, "chapter_id": 4950, "verse_number": "२३", "content_sanskrit": "ततस्ते रुषिता दासाः शूलपट्टसपाणयः ।\nखण्डशो विकृतं हत्वा क्रव्याद्भ्यो ह्यददुस्तदा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2186080, "chapter_id": 4950, "verse_number": "२४", "content_sanskrit": "क्रव्यादास्त्वपि राजेन्द्र नेच्छन्ति पिशिताशनाः ।\nमृतानपि हि क्रव्यादाः कृतघ्नान्नोपभुञ्जते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2186081, "chapter_id": 4950, "verse_number": "२५", "content_sanskrit": "ब्रह्मस्वहरणे चोरे ब्रह्मघ्ने गुरुतल्पगे ।\nनिष्कृतिर्विहिता सद्भिः कृतघ्ने नास्ति निष्कृतिः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2186082, "chapter_id": 4950, "verse_number": "२६", "content_sanskrit": "मित्रद्रुहं कृतघ्नं च नृशंसं च नराधमम् ।\nक्रव्यादाः कृमयश्चैव नोपभुञ्जन्ति वै सदा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2186083, "chapter_id": 4950, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे अष्टत्रिंशोऽध्यायः ॥३८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]