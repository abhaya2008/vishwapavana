[{"id": 2039708, "chapter_id": 1878, "verse_number": "५-१२३-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039709, "chapter_id": 1878, "verse_number": "५-१२३-१", "content_sanskrit": "सद्भिरारोपितः स्वर्गं पार्थिवैर्भूरिदक्षिणैः ।\nअभ्यनुज्ञाय दौहित्रान्ययातिर्दिवमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039710, "chapter_id": 1878, "verse_number": "५-१२३-२", "content_sanskrit": "अभिवृष्टश्च वर्षेण नानापुष्पसुगन्धिना।\nपरिष्वक्तश्च पुण्येन वायुना पुण्यगन्धिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039711, "chapter_id": 1878, "verse_number": "५-१२३-३", "content_sanskrit": "अचलं स्थानमासाद्य दौहित्रफलनिर्जितम् ।\nकर्मभिः स्वैरुपचितो जज्वाल परया श्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039712, "chapter_id": 1878, "verse_number": "५-१२३-४", "content_sanskrit": "उपगीतोपनृत्तश्च गन्धर्वाप्सरसां गणैः ।\nप्रीत्या प्रतिगृहीतश्च स्वर्गे दुन्दुभिनिःस्वनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039713, "chapter_id": 1878, "verse_number": "५-१२३-५", "content_sanskrit": "अभिष्टुतश्च विविधैर्देवराजर्षिचारणैः ।\nअर्चितश्चोत्तमार्घेण दैवतैरभिनन्दितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039714, "chapter_id": 1878, "verse_number": "५-१२३-६", "content_sanskrit": "प्राप्तः स्वर्गफलं चैव तमुवाच पितामहः ।\nनिर्वृतं शान्तमनसं वचोभिस्तर्पयन्निव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039715, "chapter_id": 1878, "verse_number": "५-१२३-७", "content_sanskrit": "चतुष्पादस्त्वया धर्मश्रितो लोक्येन कर्मणा ।\nअक्षयस्तव लोकोऽयं कीर्तिश्चैवाक्षया दिवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039716, "chapter_id": 1878, "verse_number": "५-१२३-८", "content_sanskrit": "पुनस्त्वयैव राजर्षे स्वकृतेन विघातितम्।\nआवृतं तमसा चेतः सर्वेषां स्वर्गवासिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039717, "chapter_id": 1878, "verse_number": "५-१२३-९", "content_sanskrit": "येन त्वां नाभिजानन्ति ततोऽज्ञातोसि पातितः ।\nप्रीत्यैव चासि दौहित्रैस्तारितस्त्वमिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039718, "chapter_id": 1878, "verse_number": "५-१२३-१०", "content_sanskrit": "स्थानं च प्रतिपन्नोऽसि कर्मणा स्वेन निर्जितम् ।\nअचलं शाश्वतं पुण्यमुत्तमं ध्रुवमव्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039719, "chapter_id": 1878, "verse_number": "५-१२३-११x", "content_sanskrit": "ययातिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039720, "chapter_id": 1878, "verse_number": "५-१२३-११", "content_sanskrit": "भगवन्संशयो मेऽस्ति कश्चितं छेत्तुमर्हसि ।\nन ह्यन्यमहमर्हामि प्रष्टुं लोकपितामह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039721, "chapter_id": 1878, "verse_number": "५-१२३-१२", "content_sanskrit": "बहुवर्षसहस्रान्तं प्रजापालनवर्धितम्।\nअनेकक्रतुदानौघैरार्जितं मे महत्फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039722, "chapter_id": 1878, "verse_number": "५-१२३-१३", "content_sanskrit": "कथं तदल्पकालेन क्षीणं येनास्मि पातितः ।\nभगवन्वेत्थ लोकांश्च शाश्वतान्मम निर्मितान् ।\nकथं नु मम तत्सर्वं विप्रनष्टं महाद्युते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039723, "chapter_id": 1878, "verse_number": "५-१२३-१४x", "content_sanskrit": "पितामह उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039724, "chapter_id": 1878, "verse_number": "५-१२३-१४", "content_sanskrit": "बहुवर्षसहस्रान्तं प्रजापालनवर्धितम्।\nअनेकक्रतुदानौघैर्यत्त्वयोपार्जितं फलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039725, "chapter_id": 1878, "verse_number": "५-१२३-१५", "content_sanskrit": "तदनेनैव दोषेण क्षीणं येनासि पातितः।\nअभिमानेन राजेन्द्र धिक्कृतः स्वर्गवासिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039726, "chapter_id": 1878, "verse_number": "५-१२३-१६", "content_sanskrit": "नायं मानेन राजर्षे न बलेन न हिंसया।\nन शाठ्येन न मायाभिर्लोको भवति शाश्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039727, "chapter_id": 1878, "verse_number": "५-१२३-१७", "content_sanskrit": "नावमान्यास्त्वया राजन्नधमोत्कृष्टमध्यमाः।\nन हि मानप्रदग्धानां कश्चिदस्ति शमः क्वचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039728, "chapter_id": 1878, "verse_number": "५-१२३-१८", "content_sanskrit": "पतनारोहणमिदं कथयिष्यन्ति ये नराः ।\nविषमाण्यपि ते प्राप्तास्तरिष्यन्ति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039729, "chapter_id": 1878, "verse_number": "५-१२३-१९x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039730, "chapter_id": 1878, "verse_number": "५-१२३-१९", "content_sanskrit": "एष दोषोऽभिमानेन पुरा प्राप्तो ययातिना ।\nनिर्बध्नताऽतिमात्रं च गालवेन महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039731, "chapter_id": 1878, "verse_number": "५-१२३-२०", "content_sanskrit": "श्रोतव्यं हितकामानां सुहृदां हितमिच्छताम्।\nन कर्तव्यो हि निर्बन्धो निर्बन्धो हि क्षयोदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039732, "chapter_id": 1878, "verse_number": "५-१२३-२१", "content_sanskrit": "तस्मात्त्वमपि गान्धारे मानं क्रोधं च वर्जय ।\nसन्धत्स्व पाण्डवैर्वीर संरम्भं त्यज पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2039733, "chapter_id": 1878, "verse_number": "५-१२३-२२", "content_sanskrit": "स भवान्सुहृदां पथ्यं वचो गृह्णातु माऽनृतम् ।\nसमर्थैर्विग्रहं कृत्वा विषमस्थो भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2039734, "chapter_id": 1878, "verse_number": "५-१२३-२३", "content_sanskrit": "ददाति यत्पार्थिव यत्करति\nयद्वा तपस्तप्यति यञ्जुहोति।\nन तस्य नाशोऽस्ति न चापकर्षो\nनान्यस्तदश्नाति स एव कर्ता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2039735, "chapter_id": 1878, "verse_number": "५-१२३-२४", "content_sanskrit": "इदं महाख्यानमनुत्तमं हितं\nबहुश्रुतानां गतरोषरागिणाम्।\nसमीक्ष्य लोके बहुधा प्रधारितं\nत्रिवर्गदृष्टिः पृथिवीमुपाश्नुते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2039736, "chapter_id": 1878, "verse_number": "५-१२३-२५", "content_sanskrit": "` एतत्पुण्यतमं राजन्ययातेश्चरितं महत्।\nयच्छ्रुत्वा श्रावयित्वा च स्वर्गं यान्तीह मानवाः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2039737, "chapter_id": 1878, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि त्रयोविंशत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]