[{"id": 2062977, "chapter_id": 2341, "verse_number": "८-६२-०x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062978, "chapter_id": 2341, "verse_number": "८-६२-१", "content_sanskrit": "आतुरो मे मतो राजा अविपह्यश्च भारत।\nयथैनमनुवर्तन्ते पञ्चालाः सह पाण्डवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062979, "chapter_id": 2341, "verse_number": "८-६२-२", "content_sanskrit": "त्वरमाणास्त्वराकाले सर्वशस्त्रभृतां वराः।\nमज्जन्तमिव पाताले बलिनो ह्युज्जिहीर्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062980, "chapter_id": 2341, "verse_number": "८-६२-३", "content_sanskrit": "न केतुर्दृश्यते राज्ञः कर्णस्य पिहितः शरैः।\nपश्यतोर्यमयोः पार्थ सात्यकेश्च शिखण्डिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062981, "chapter_id": 2341, "verse_number": "८-६२-४", "content_sanskrit": "धृष्टद्युम्नस्य भीमस्य शतानीकस्य वा विभो।\nपाञ्चालानां च सर्वेषां चेदीनां चैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062982, "chapter_id": 2341, "verse_number": "८-६२-५", "content_sanskrit": "एष कर्णो रणे पार्थ पाण्डवानामनीकिनीम्।\nशरैर्विध्वंसयामास नलिनीमिव कुञ्जरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062983, "chapter_id": 2341, "verse_number": "८-६२-६", "content_sanskrit": "एते द्रवन्ति रथिनस्त्वदीयाः पाण्डुनन्दन।\nपश्य पश्य यथा पार्थ गच्छन्त्येते महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062984, "chapter_id": 2341, "verse_number": "८-६२-७", "content_sanskrit": "एते भारत मातङ्गाः कर्णेनाभिहताः शरैः।\nआर्तनादान्विकुर्वाणा विद्रवन्ति दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062985, "chapter_id": 2341, "verse_number": "८-६२-८", "content_sanskrit": "रथानां द्रवते वृन्दमेतच्चैव समन्ततः।\nद्राव्यमाणं रणे पार्थ कर्णेनामिततेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062986, "chapter_id": 2341, "verse_number": "८-६२-९", "content_sanskrit": "हस्तिकक्ष्यां रणे पश्य चरन्तीं तत्रतत्र ह।\nरथस्थं सूतपुत्रस्य केतुं केतुमतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062987, "chapter_id": 2341, "verse_number": "८-६२-१०", "content_sanskrit": "असौ धावति राधेयो भीमसेनरथं प्रति।\nकिरञ्शरशतान्येव विनिघ्नंस्तव वाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062988, "chapter_id": 2341, "verse_number": "८-६२-११", "content_sanskrit": "एते नश्यन्ति पाञ्चाला द्राव्यमाणा महात्मना।\nशक्रेणेव यथा दैत्या द्राव्यमाणा महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062989, "chapter_id": 2341, "verse_number": "८-६२-१२", "content_sanskrit": "एष कर्णो रणे जित्वा पाञ्चालान्पाण्डुसृञ्जयान्।\nदिशो विप्रेक्षते सर्वास्त्वदर्थमिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062990, "chapter_id": 2341, "verse_number": "८-६२-१३", "content_sanskrit": "एष कर्णो धनुःश्रेष्ठं विधून्वन्बहुशोभते।\nशत्रुं जित्वा यथा शक्रो देवसङ्खैः समावृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062991, "chapter_id": 2341, "verse_number": "८-६२-१४", "content_sanskrit": "एते नर्दन्ति कौरव्या दृष्ट्वा कर्णस्य विक्रमम्।\nत्रासयन्तो रणे पाण्डून्सृंजयांश्च समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062992, "chapter_id": 2341, "verse_number": "८-६२-१५", "content_sanskrit": "एष सर्वात्मना पाण्डूंस्त्रासयित्वा महारणे।\nअभिभाषति राधेयः सर्वसैन्यानि मानद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062993, "chapter_id": 2341, "verse_number": "८-६२-१६", "content_sanskrit": "अभिद्रवत भद्रं वो द्रुतं द्रवत कौरवाः।\nयथा न जीववान्कश्चिन्मुच्येत युधि सृञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062994, "chapter_id": 2341, "verse_number": "८-६२-१७", "content_sanskrit": "तथा कुरुत संयत्ता वयं यास्याम पृष्ठतः।\nएवमुक्त्वा गतो ह्येष पृष्ठतो विकिरञ्छरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062995, "chapter_id": 2341, "verse_number": "८-६२-१८", "content_sanskrit": "पश्य कर्णं रणे पार्थ श्वेतच्छत्रविराजितम्।\nउदयं पर्वतं यद्वच्छशाङ्केनाभिशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062996, "chapter_id": 2341, "verse_number": "८-६२-१९", "content_sanskrit": "पूर्णचन्द्रनिकाशेन मूर्ध्नि च्छत्रेण भारत।\nध्रियमाणेन समरे श्रीमच्छतशलाकिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062997, "chapter_id": 2341, "verse_number": "८-६२-२०", "content_sanskrit": "एष त्वां प्रेक्षते कर्णः सकटाक्षं धनञ्जय।\nउत्तमं यत्नमास्थाय ध्रुवमेष्यति संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062998, "chapter_id": 2341, "verse_number": "८-६२-२१", "content_sanskrit": "पश्य ह्येनं महाबाहो विधुन्वानं महद्धनुः।\nशरांश्चाशीविषाकारान्विसृजन्तं महारणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062999, "chapter_id": 2341, "verse_number": "८-६२-२२", "content_sanskrit": "असौ निवृत्तो राधेयो दृष्ट्वा ते वानरध्वजम्।\nप्रार्थयन्समरं पार्थ त्वया सह परन्तप।\nवधाय ह्यात्मनोऽभ्येति पावकं शलभो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2063000, "chapter_id": 2341, "verse_number": "८-६२-२३", "content_sanskrit": "कर्णमेकाकिनं दृष्ट्वा धार्तराष्ट्रो रणाजिरे।\nत्वां च पार्थाभिसंरब्धं कर्णं प्रति महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2063001, "chapter_id": 2341, "verse_number": "८-६२-२४", "content_sanskrit": "कृतागसं च राधेयं धर्मात्मनि युधिष्ठिरे।\nअत्मानं च कृतार्थं च समीक्ष्य भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2063002, "chapter_id": 2341, "verse_number": "८-६२-२५", "content_sanskrit": "असौ दुर्योधनः क्रुद्धो रथानीकेन भारत।\nरिरक्षिषुः सुसंवृत्तो धार्तराष्ट्रो निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2063003, "chapter_id": 2341, "verse_number": "८-६२-२६", "content_sanskrit": "सर्वैः सहैभिर्दुष्टात्मा बध्यतां च प्रयत्नतः।\nत्वया यशश्च राज्यं च सुखं चोत्तममिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2063004, "chapter_id": 2341, "verse_number": "८-६२-२७", "content_sanskrit": "अदीनयोर्विश्रुतयोर्युवयोर्योत्स्यमानयोः।\nदेवासुरे पार्थ मृधे देवदानवयोरिव।\nपश्यन्तु कौरवाः सर्वे तव पार्थ पराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2063005, "chapter_id": 2341, "verse_number": "८-६२-२८", "content_sanskrit": "त्वां च दृष्ट्वातिसंरब्धं कर्णं च भरतर्षम्।\nअसौ दुर्योधनः क्रुद्धो नोत्तरं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2063006, "chapter_id": 2341, "verse_number": "८-६२-२९", "content_sanskrit": "आत्मानं च कृतात्मानं समीक्ष्य भरतर्षभ।\nकृतागसं च राधेयं धर्मात्मनि युधिष्ठिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2063007, "chapter_id": 2341, "verse_number": "८-६२-३०", "content_sanskrit": "प्रतिपद्यस्व कौन्तेय प्राप्तकालमनन्तरम्।\nआर्यां युद्धे मतिं कृत्वा प्रत्येहि रथयूथपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2063008, "chapter_id": 2341, "verse_number": "८-६२-३१", "content_sanskrit": "पञ्च ह्येतानि मुख्यानि रथानां रथसत्तम।\nशतान्यxxxxxxजलिनां तिन्मतेजसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2063009, "chapter_id": 2341, "verse_number": "८-६२-३२", "content_sanskrit": "पञ्च नाघxxxxx द्विगुणा वाजिनस्तथा।\nअभिसंहत्य कौन्तेय पदाताः प्रयुतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2063010, "chapter_id": 2341, "verse_number": "८-६२-३३", "content_sanskrit": "xxxxxxxx वीर बलं तामभिवर्तते।\nद्रोमपुत्रं पुरस्कृत्य तच्छीघ्रं सन्निषूदय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2063011, "chapter_id": 2341, "verse_number": "८-६२-३४", "content_sanskrit": "निकृत्त्यैतद्रथानीकं बलिनं लोकविश्रुतम्।\nसूतपुत्रे महेष्वासे दर्शयात्मानमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2063012, "chapter_id": 2341, "verse_number": "८-६२-३५", "content_sanskrit": "xxxxxxxxxxxxxxxभरतर्षभ।\nxxxxxxxxxxxxx पाञ्चालानभिघावति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2063013, "chapter_id": 2341, "verse_number": "८-६२-३६", "content_sanskrit": "xxxxxx हि पश्यामि धृष्टद्युम्नरर्थ प्रति।\nxxxxxx पाञ्चालानिति मन्ये परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2063014, "chapter_id": 2341, "verse_number": "८-६२-३७", "content_sanskrit": "आचचक्षे प्रियं पार्थ तवेदं भरतर्षभ।\nराजासौ कुशली श्रीमान्धर्मपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2063015, "chapter_id": 2341, "verse_number": "८-६२-३८", "content_sanskrit": "असौ भीमो महाबाहुः सन्निवृत्तश्चमूयुखे।\nवृतः सृञ्जय सैन्येन शैनेयेन च भप्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2063016, "chapter_id": 2341, "verse_number": "८-६२-३९", "content_sanskrit": "वध्यन्त एते समरे कौरवा निशितैः शरैः।\nभीमसेनेन कौन्तेय पाञ्चालैश्च महात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2063017, "chapter_id": 2341, "verse_number": "८-६२-४०", "content_sanskrit": "सेना हि धार्तराष्ट्रस्य विमुखा व्यद्रवद्रणात्।\nवेगेन भीमसेनस्य विहता विविधैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2063018, "chapter_id": 2341, "verse_number": "८-६२-४१", "content_sanskrit": "विपन्नसस्येव मही रुधिरेण समुक्षिता।\nभारती भरतश्रेष्ठ सेना कृपणदर्शना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2063019, "chapter_id": 2341, "verse_number": "८-६२-४२", "content_sanskrit": "निवृत्तं पश्य कौन्तेय भीमसेनं युधाम्पतिम्।\nआशीविषमिव क्रुद्धं तस्माद्द्रवति भारति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2063020, "chapter_id": 2341, "verse_number": "८-६२-४३", "content_sanskrit": "पीतरक्तासितसितास्ताराचन्द्रार्कमण्डिताः।\nपताका विप्रकीर्यन्ते छत्राण्येतानि चार्जुन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2063021, "chapter_id": 2341, "verse_number": "८-६२-४४", "content_sanskrit": "सौवर्णा राजताश्चैव तैजसाश्च पृथग्विधाः।\nकेतवोऽभिनिपात्यन्ते हस्त्यश्वं च प्रकीर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2063022, "chapter_id": 2341, "verse_number": "८-६२-४५", "content_sanskrit": "रथेभ्यः प्रपतन्त्येते रथिनो विगतासवः।\nनानावर्णैर्हता बाणैः पाञ्चालैरपलायिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2063023, "chapter_id": 2341, "verse_number": "८-६२-४६", "content_sanskrit": "निर्मनुष्यान्गजानश्वान्रथांश्चैव धनञ्जय।\nसमाद्रवन्ति पाञ्चाला धार्तराष्ट्रांस्तरस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2063024, "chapter_id": 2341, "verse_number": "८-६२-४७", "content_sanskrit": "विमृद्रन्ति नरव्याघ्रा भीमसेनबलाश्रयात्।\nबलं परेषां दुर्धर्षं त्यक्त्वा प्राणानरिन्दम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2063025, "chapter_id": 2341, "verse_number": "८-६२-४८", "content_sanskrit": "एते नर्दिन्ति पाञ्चाला ध्मापयन्ति च वारिजान्।\nअभिद्रवन्ति च रणे मृद्रन्तः सायकैः परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2063026, "chapter_id": 2341, "verse_number": "८-६२-४९", "content_sanskrit": "पश्य स्वर्गस्य माहात्म्यं पाञ्चाला हि पराक्रमात्।\nधार्तराष्ट्रान्विनिघ्नन्तो विशन्त्येते रथोत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2063027, "chapter_id": 2341, "verse_number": "८-६२-५०", "content_sanskrit": "[शस्त्रमाच्छिद्य शत्रूणां सायुधानां निरायुधाः।\nतेनैवैतानमोघास्त्रा निघ्नन्ति च नदन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2063028, "chapter_id": 2341, "verse_number": "८-६२-५१", "content_sanskrit": "शिरांस्येतानि पात्यन्ते शत्रूणां बाहवोऽपि च।\nरथनागहया वीरा यशस्याः सर्व एव च]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2063029, "chapter_id": 2341, "verse_number": "८-६२-५२", "content_sanskrit": "सर्वतश्चाभिपन्नैषा धार्तराष्ट्री महाचमूः।\nत्यक्त्वा प्राणान्महेष्वासैः पाञ्चालैः परिपात्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2063030, "chapter_id": 2341, "verse_number": "८-६२-५३", "content_sanskrit": "सुहृदश्च पराक्रान्ताः कृपकर्णादयो विभो।\nनिवारणे महेष्वासाः पाञ्चालानां परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2063031, "chapter_id": 2341, "verse_number": "८-६२-५४", "content_sanskrit": "अनिवृत्तांश्च भीतांस्तान्धार्तराष्ट्रान्परन्तप।\nधृष्टद्युम्नमुखा वीरा घ्नन्ति शत्रून्सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2063032, "chapter_id": 2341, "verse_number": "८-६२-५५", "content_sanskrit": "रथाश्च विविधाः सर्वे निवृत्ते भरतर्षभे।\nविवर्णमुखभूयिष्ठा धार्तराष्ट्री महाचमूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2063033, "chapter_id": 2341, "verse_number": "८-६२-५६", "content_sanskrit": "पश्य भीमेन नाराचैर्भिन्ना नागाः पतन्त्यमी।\nवज्रिवज्रहतानीव शिखराणि धराभृताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2063034, "chapter_id": 2341, "verse_number": "८-६२-५७", "content_sanskrit": "भीमसेनस्य निर्विद्धा बाणैः सन्नतपर्वभिः।\nस्वान्यनीकानि मृद्गन्तो द्रवन्त्येते महागजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2063035, "chapter_id": 2341, "verse_number": "८-६२-५८", "content_sanskrit": "`एते द्रवन्ति कुरवो भीमसेनभयार्दिताः।\nत्यक्त्वा रथान्गजांश्चैव हयांश्चैव सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2063036, "chapter_id": 2341, "verse_number": "८-६२-५९", "content_sanskrit": "हस्त्यश्वरथपत्तीनां द्रवतां निःस्वनं शृणु।\nभीमसेनस्य निनदं द्रावयानस्य कौरवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2063037, "chapter_id": 2341, "verse_number": "८-६२-६०", "content_sanskrit": "अभिजानामि भीमस्य सिंहनादं पुनःपुनः।\nनदतः पाण्डवेयस्य सङ्ग्रामे जितकाशिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2063038, "chapter_id": 2341, "verse_number": "८-६२-६१", "content_sanskrit": "एष नैषादिरभ्येति द्विपमुख्येन पाण्डवम्।\nविसृजंस्तोमरान्क्रुद्धो दण्डपाणिरिवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2063039, "chapter_id": 2341, "verse_number": "८-६२-६२", "content_sanskrit": "तस्य चैव भुजौ छिन्नौ भीमसेनेन गर्जतः।\nनागश्च क्रकरप्रख्यैर्नाराचैर्दशभिर्हतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2063040, "chapter_id": 2341, "verse_number": "८-६२-६३", "content_sanskrit": "हन्तैते पुनरायान्ति नागा ह्यन्ये प्रहारिणः।\nनीलाञ्जनचयप्रख्या महामात्रैरधिष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2063041, "chapter_id": 2341, "verse_number": "८-६२-६४", "content_sanskrit": "शक्तितोमरसङ्घतैर्विनिघ्नन्तो वृकोदरम्।\nसप्तसप्त च नागस्था वैजयन्त्यश्च सध्वजाः।\nनवत्या निशितैर्बाणैश्छिन्नाः पार्थाग्रजेन ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2063042, "chapter_id": 2341, "verse_number": "८-६२-६५", "content_sanskrit": "दशभिर्दशभिश्चैको नाराचैर्निहतो गजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2063043, "chapter_id": 2341, "verse_number": "८-६२-६६", "content_sanskrit": "न चासौ धार्तराष्ट्राणां श्रूयते निनदस्तथा।\nपुरन्दरसमे क्रुद्धे निवृत्ते भरतर्षभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2063044, "chapter_id": 2341, "verse_number": "८-६२-६७", "content_sanskrit": "अक्षौहिण्यस्तथा तिस्रो धार्तराष्ट्रस्य सङ्गताः।\nक्रुद्धेन भीमसेनेन नरसिंहेन वारिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2063045, "chapter_id": 2341, "verse_number": "८-६२-६८", "content_sanskrit": "न शक्नुवन्ति वै पार्थं पार्थिवाः समुदीक्षितुम्।\nमध्यन्दिनगतं सूर्यं यथा दुर्बलचक्षुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2063046, "chapter_id": 2341, "verse_number": "८-६२-६९", "content_sanskrit": "एते भीमस्य सन्त्रस्ताः सिंहस्येवेतरे मृगाः।\nशरैः सन्त्रासिताः सह्ख्ये न लभन्ते सुखं क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2063047, "chapter_id": 2341, "verse_number": "८-६२-७०", "content_sanskrit": "राधेयो बहुभिः सार्धमसौ गच्छति वेगितः।\nवर्धयित्वा तु भीरुं तं पार्श्वतो ह्यानयद्धनुः।\nतं पालयन्महाराजं धार्तराष्ट्रं बलान्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2063048, "chapter_id": 2341, "verse_number": "८-६२-७१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2063049, "chapter_id": 2341, "verse_number": "८-६२-७१", "content_sanskrit": "एतच्छ्रुत्वा महाबाहुर्वासुदेवाद्धनञ्जयः।\nभीमसेनेन तत्कर्म कृतं दृष्ट्वा सुदुष्करम्।\nअर्जुनो व्यधमच्छिष्टान्संशप्तकगणान्बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2063050, "chapter_id": 2341, "verse_number": "८-६२-७२", "content_sanskrit": "ते वध्यमानाः पार्थेन संशप्तकगणाः प्रभो।\nशक्रस्यातिथितां गत्वा विशोका ह्यभवंस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2063051, "chapter_id": 2341, "verse_number": "८-६२-७३", "content_sanskrit": "नारायणांस्तु गोपालान्व्यधमत्पाण्डुनन्दनः।\nउत्तमं वेxxxxxप्तास्थाय चण्डवायुर्धनानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2063052, "chapter_id": 2341, "verse_number": "८-६२-७४", "content_sanskrit": "अन्वकीर्यन्त भीतास्ते तत्रतत्रैव भारत।\nलुलितांश्च ततः शूरानहनत्पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2063053, "chapter_id": 2341, "verse_number": "८-६२-७५", "content_sanskrit": "पुनश्च पुरुषव्याघ्रः शरैः सन्नतपर्वभिः।\nजघान धार्तराष्ट्रस्य चतुर्विधबलां चमूम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2063054, "chapter_id": 2341, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे द्विषष्टितमोऽध्यायः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]