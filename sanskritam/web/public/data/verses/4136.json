[{"id": 2145603, "chapter_id": 4136, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145604, "chapter_id": 4136, "verse_number": "१", "content_sanskrit": "कथं त्वं माधवं वेत्थ सर्वलोकमहेश्वरम् ।\nकथमेनं न वेदाहं तन्ममाचक्ष्व सञ्जय\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145605, "chapter_id": 4136, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145606, "chapter_id": 4136, "verse_number": "२", "content_sanskrit": "शृणु राजन् न ते विद्या मम विद्या न हीयते ।\nविद्याहीनस्तमोध्वस्तो नाभिजानासि केशवम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145607, "chapter_id": 4136, "verse_number": "३", "content_sanskrit": "विद्यया तात जानामि त्रियुगं मधुसूदनम् ।\nकर्तारमकृतं देवं भूतानां प्रभवाप्ययम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145608, "chapter_id": 4136, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145609, "chapter_id": 4136, "verse_number": "४", "content_sanskrit": "गावल्गणेऽत्र का विद्या या ते नित्या जनार्दने ।\nयया त्वमभिजानासि त्रियुगं मधुसूदनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145610, "chapter_id": 4136, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145611, "chapter_id": 4136, "verse_number": "५", "content_sanskrit": "मायां न सेवे भद्रं ते न वृथा धर्ममाचरे ।\nशुद्धभावं गतो भक्त्या शास्त्राद् वेद्मि जनार्दनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145612, "chapter_id": 4136, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145613, "chapter_id": 4136, "verse_number": "६", "content_sanskrit": "दुर्योधन हृषीकेशं प्रपद्यस्व जनार्दनम् ।\nआप्तो नः सञ्जयस्तात शरणं गच्छ केशवम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145614, "chapter_id": 4136, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145615, "chapter_id": 4136, "verse_number": "७", "content_sanskrit": "भगवान् देवकीपुत्रो लोकांश्चेन्निहनिष्यति ।\nप्रवदन्नर्जुने सख्यं नाहं गच्छेऽद्य केशवम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145616, "chapter_id": 4136, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145617, "chapter_id": 4136, "verse_number": "८", "content_sanskrit": "अवाग् गान्धारि पुत्रस्ते गच्छत्येष सुदुर्मतिः ।\nईर्ष्युर्दुरात्मा मानी च श्रेयसां शासनातिगः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145618, "chapter_id": 4136, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145619, "chapter_id": 4136, "verse_number": "९", "content_sanskrit": "ऐश्वर्यकाम दुष्टात्मन् वृद्धानां शासनातिग ।\nऐश्वर्यजीविते हित्वा पितरं मां च बालिश\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145620, "chapter_id": 4136, "verse_number": "१०", "content_sanskrit": "वर्धयन् दुर्हृदां प्रीतिं मां च शोकाय रन्ध्रयन् ।\nनिहतो भीमसेनेन स्मर्तासि वचनं पितुः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145621, "chapter_id": 4136, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145622, "chapter_id": 4136, "verse_number": "११", "content_sanskrit": "प्रियोऽसि राजन् कृष्णस्य धृतराष्ट्र निबोध मे ।\nयस्य ते सञ्जयो दूतो यस्त्वा श्रेयसि योक्ष्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2145623, "chapter_id": 4136, "verse_number": "१२", "content_sanskrit": "जानात्येष हृषीकेशं पुराणं यच्च वै नवम् ।\nशुश्रूषमाणमेकाग्रं मोक्ष्यते महतो भयात्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2145624, "chapter_id": 4136, "verse_number": "१३", "content_sanskrit": "वैचित्रवीर्य पुरुषाः क्रोधहर्षसमावृताः ।\nसिता बहुविधैः पाशैर्येन तुष्टाः स्वकैर्धनैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2145625, "chapter_id": 4136, "verse_number": "१४", "content_sanskrit": "यमस्य वशमायान्ति काममूढाः पुनः पुनः ।\nअन्धनेत्रा यथैवान्धा नीयमानाः स्वकर्मभिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2145626, "chapter_id": 4136, "verse_number": "१५", "content_sanskrit": "एष एकायनः पन्था येन यान्ति मनीषिणः ।\nतं दृष्ट्वा मृत्युमत्येति महांस्तत्र न सज्जते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2145627, "chapter_id": 4136, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2145628, "chapter_id": 4136, "verse_number": "१६", "content_sanskrit": "अङ्ग सञ्जय मे शंस पन्थानमकुतोभयम् ।\nयेन गत्वा हृषीकेशं प्राप्नुयां शान्तिमुत्तमाम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2145629, "chapter_id": 4136, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2145630, "chapter_id": 4136, "verse_number": "१७", "content_sanskrit": "नाकृतात्मा कृतात्मानं जातु विद्याज्जनार्दनम् ।\nआत्मनस्तु क्रियोपायो नान्यत्रेन्द्रियनिग्रहात्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2145631, "chapter_id": 4136, "verse_number": "१८", "content_sanskrit": "इन्द्रियाणामुदीर्णानां कामत्यागोऽप्रमादतः ।\nअप्रमादोऽविहिंसा च ज्ञानयोनिरसंशयम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2145632, "chapter_id": 4136, "verse_number": "१९", "content_sanskrit": "इन्द्रियाणां यमे यत्तो भव राजन्नतन्द्रितः ।\nबुद्धिश्च ते मा च्यवतु नियच्छैतां यतस्ततः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2145633, "chapter_id": 4136, "verse_number": "२०", "content_sanskrit": "एतज्ज्ञानं विदुर्विप्रा ध्रुवमिन्द्रियधारणम् ।\nएतज्ज्ञानं च पन्थाश्च येन यान्ति मनीषिणः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2145634, "chapter_id": 4136, "verse_number": "२१", "content_sanskrit": "अप्राप्यः केशवो राजन्निन्द्रियैरजितैर्नृभिः ।\nआगमाभिगतो योगी वशी तत्वे प्रसीदति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2145635, "chapter_id": 4136, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि सप्तषष्टितमोऽध्यायः ॥६७॥\nव्यासाभिगमनपर्वणि विंशोऽध्यायः ॥२०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]