[{"id": 5000080000, "chapter_id": 9080, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे तृतीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000080001, "chapter_id": 9080, "verse_number": "२-३-१", "content_sanskrit": "तेषामञ्जलिपद्मानि प्रगृहीतानि सर्वशः।\nप्रतिगृह्याब्रवीद् राजा तेभ्यः प्रियहितं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000080002, "chapter_id": 9080, "verse_number": "२-३-२", "content_sanskrit": "अहोऽस्मि परमप्रीतः प्रभावश्चातुलो मम।\nयन्मे ज्येष्ठं प्रियं पुत्रं यौवराज्यस्थमिच्छथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000080003, "chapter_id": 9080, "verse_number": "२-३-३", "content_sanskrit": "इति प्रत्यर्चितान् राजा ब्राह्मणानिदमब्रवीत्।\nवसिष्ठं वामदेवं च तेषामेवोपशृण्वताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000080004, "chapter_id": 9080, "verse_number": "२-३-४", "content_sanskrit": "चैत्रः श्रीमानयं मासः पुण्यः पुष्पितकाननः।\nयौवराज्याय रामस्य सर्वमेवोपकल्प्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000080005, "chapter_id": 9080, "verse_number": "२-३-५", "content_sanskrit": "राज्ञस्तूपरते वाक्ये जनघोषो महानभूत्।\nशनैस्तस्मिन् प्रशान्ते च जनघोषे जनाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000080006, "chapter_id": 9080, "verse_number": "२-३-६", "content_sanskrit": "वसिष्ठं मुनिशार्दूलं राजा वचनमब्रवीत्।\nअभिषेकाय रामस्य यत् कर्म सपरिच्छदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000080007, "chapter_id": 9080, "verse_number": "२-३-७", "content_sanskrit": "तदद्य भगवन् सर्वमाज्ञापयितुमर्हसि।\nतच्छ्रुत्वा भूमिपालस्य वसिष्ठो मुनिसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000080008, "chapter_id": 9080, "verse_number": "२-३-८", "content_sanskrit": "आदिदेशाग्रतो राज्ञः स्थितान् युक्तान् कृताञ्जलीन्।\nसुवर्णादीनि रत्नानि बलीन् सर्वौषधीरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000080009, "chapter_id": 9080, "verse_number": "२-३-९", "content_sanskrit": "शुक्लमाल्यानि लाजांश्च पृथक् च मधुसर्पिषी।\nअहतानि च वासांसि रथं सर्वायुधान्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000080010, "chapter_id": 9080, "verse_number": "२-३-१०", "content_sanskrit": "चतुरङ्गबलं चैव गजं च शुभलक्षणम्।\nचामरव्यजने चोभे ध्वजं छत्रं च पाण्डुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000080011, "chapter_id": 9080, "verse_number": "२-३-११", "content_sanskrit": "शतं च शातकुम्भानां कुम्भानामग्निवर्चसाम्।\nहिरण्यशृङ्गमृषभं समग्रं व्याघ्रचर्म च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000080012, "chapter_id": 9080, "verse_number": "२-३-१२", "content_sanskrit": "यच्चान्यत् किंचिदेष्टव्यं तत् सर्वमुपकल्प्यताम्।\nउपस्थापयत प्रातरग्न्यगारे महीपतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000080013, "chapter_id": 9080, "verse_number": "२-३-१३", "content_sanskrit": "अन्तःपुरस्य द्वाराणि सर्वस्य नगरस्य च।\nचन्दनस्रग्भिरर्च्यन्तां धूपैश्च घ्राणहारिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000080014, "chapter_id": 9080, "verse_number": "२-३-१४", "content_sanskrit": "प्रशस्तमन्नं गुणवद् दधिक्षीरोपसेचनम्।\nद्विजानां शतसाहस्रं यत्प्रकाममलं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000080015, "chapter_id": 9080, "verse_number": "२-३-१५", "content_sanskrit": "सत्कृत्य द्विजमुख्यानां श्वः प्रभाते प्रदीयताम्।\nघृतं दधि च लाजाश्च दक्षिणाश्चापि पुष्कलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000080016, "chapter_id": 9080, "verse_number": "२-३-१६", "content_sanskrit": "सूर्येऽभ्युदितमात्रे श्वो भविता स्वस्तिवाचनम्।\nब्राह्मणाश्च निमन्त्र्यन्तां कल्प्यन्तामासनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000080017, "chapter_id": 9080, "verse_number": "२-३-१७", "content_sanskrit": "आबध्यन्तां पताकाश्च राजमार्गश्च सिच्यताम्।\nसर्वे च तालापचरा गणिकाश्च स्वलंकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000080018, "chapter_id": 9080, "verse_number": "२-३-१८", "content_sanskrit": "कक्ष्यां द्वितीयामासाद्य तिष्ठन्तु नृपवेश्मनः।\nदेवायतनचैत्येषु सान्नभक्ष्याः सदक्षिणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000080019, "chapter_id": 9080, "verse_number": "२-३-१९", "content_sanskrit": "उपस्थापयितव्याः स्युर्माल्ययोग्याः पृथक्पृथक्।\nदीर्घासिबद्धगोधाश्च संनद्धा मृष्टवाससः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000080020, "chapter_id": 9080, "verse_number": "२-३-२०", "content_sanskrit": "महाराजाङ्गनं शूराः प्रविशन्तु महोदयम्।\nएवं व्यादिश्य विप्रौ तु क्रियास्तत्र विनिष्ठितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000080021, "chapter_id": 9080, "verse_number": "२-३-२१", "content_sanskrit": "चक्रतुश्चैव यच्छेषं पार्थिवाय निवेद्य च।\nकृतमित्येव चाब्रूतामभिगम्य जगत्पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000080022, "chapter_id": 9080, "verse_number": "२-३-२२", "content_sanskrit": "यथोक्तवचनं प्रीतौ हर्षयुक्तौ द्विजोत्तमौ।\nततः सुमन्त्रं द्युतिमान् राजा वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000080023, "chapter_id": 9080, "verse_number": "२-३-२३", "content_sanskrit": "रामः कृतात्मा भवता शीघ्रमानीयतामिति।\nस तथेति प्रतिज्ञाय सुमन्त्रो राजशासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000080024, "chapter_id": 9080, "verse_number": "२-३-२४", "content_sanskrit": "रामं तत्रानयांचक्रे रथेन रथिनां वरम्।\nअथ तत्र सहासीनास्तदा दशरथं नृपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000080025, "chapter_id": 9080, "verse_number": "२-३-२५", "content_sanskrit": "प्राच्योदीच्या प्रतीच्याश्च दाक्षिणात्याश्च भूमिपाः।\nम्लेच्छाश्चार्याश्च ये चान्ये वनशैलान्तवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000080026, "chapter_id": 9080, "verse_number": "२-३-२६", "content_sanskrit": "उपासांचक्रिरे सर्वे तं देवा वासवं यथा।\nतेषां मध्ये स राजर्षिर्मरुतामिव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000080027, "chapter_id": 9080, "verse_number": "२-३-२७", "content_sanskrit": "प्रासादस्थो दशरथो ददर्शायान्तमात्मजम्।\nगन्धर्वराजप्रतिमं लोके विख्यातपौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000080028, "chapter_id": 9080, "verse_number": "२-३-२८", "content_sanskrit": "दीर्घबाहुं महासत्त्वं मत्तमातङ्गगामिनम्।\nचन्द्रकान्ताननं राममतीव प्रियदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000080029, "chapter_id": 9080, "verse_number": "२-३-२९", "content_sanskrit": "रूपौदार्यगुणैः पुंसां दृष्टिचित्तापहारिणम्।\nघर्माभितप्ताः पर्जन्यं ह्लादयन्तमिव प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000080030, "chapter_id": 9080, "verse_number": "२-३-३०", "content_sanskrit": "न ततर्प समायान्तं पश्यमानो नराधिपः।\nअवतार्य सुमन्त्रस्तु राघवं स्यन्दनोत्तमात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000080031, "chapter_id": 9080, "verse_number": "२-३-३१", "content_sanskrit": "पितुः समीपं गच्छन्तं प्राञ्जलिः पृष्ठतोऽन्वगात्।\nस तं कैलासशृङ्गाभं प्रासादं रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000080032, "chapter_id": 9080, "verse_number": "२-३-३२", "content_sanskrit": "आरुरोह नृपं द्रष्टुं सहसा तेन राघवः।\nस प्राञ्जलिरभिप्रेत्य प्रणतः पितुरन्तिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000080033, "chapter_id": 9080, "verse_number": "२-३-३३", "content_sanskrit": "नाम स्वं श्रावयन् रामो ववन्दे चरणौ पितुः।\nतं दृष्ट्वा प्रणतं पार्श्वे कृताञ्जलिपुटं नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000080034, "chapter_id": 9080, "verse_number": "२-३-३४", "content_sanskrit": "गृह्याञ्जलौ समाकृष्य सस्वजे प्रियमात्मजम्।\nतस्मै चाभ्युद्यतं सम्यङ्मणिकाञ्चनभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000080035, "chapter_id": 9080, "verse_number": "२-३-३५", "content_sanskrit": "दिदेश राजा रुचिरं रामाय परमासनम्।\nतथाऽऽसनवरं प्राप्य व्यदीपयत राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000080036, "chapter_id": 9080, "verse_number": "२-३-३६", "content_sanskrit": "स्वयैव प्रभया मेरुमुदये विमलो रविः।\nतेन विभ्राजिता तत्र सा सभापि व्यरोचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000080037, "chapter_id": 9080, "verse_number": "२-३-३७", "content_sanskrit": "विमलग्रहनक्षत्रा शारदी द्यौरिवेन्दुना।\nतं पश्यमानो नृपतिस्तुतोष प्रियमात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000080038, "chapter_id": 9080, "verse_number": "२-३-३८", "content_sanskrit": "अलंकृतमिवात्मानमादर्शतलसंस्थितम्।\nस तं सुस्थितमाभाष्य पुत्रं पुत्रवतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000080039, "chapter_id": 9080, "verse_number": "२-३-३९", "content_sanskrit": "उवाचेदं वचो राजा देवेन्द्रमिव कश्यपः।\nज्येष्ठायामसि मे पत्न्यां सदृश्यां सदृशः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000080040, "chapter_id": 9080, "verse_number": "२-३-४०", "content_sanskrit": "उत्पन्नस्त्वं गुणज्येष्ठो मम रामात्मजः प्रियः।\nत्वया यतः प्रजाश्चेमाः स्वगुणैरनुरञ्जिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000080041, "chapter_id": 9080, "verse_number": "२-३-४१", "content_sanskrit": "तस्मात् त्वं पुष्ययोगेन यौवराज्यमवाप्नुहि।\nकामतस्त्वं प्रकृत्यैव निर्णीतो गुणवानिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000080042, "chapter_id": 9080, "verse_number": "२-३-४२", "content_sanskrit": "गुणवत्यपि तु स्नेहात् पुत्र वक्ष्यामि ते हितम्।\nभूयो विनयमास्थाय भव नित्यं जितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000080043, "chapter_id": 9080, "verse_number": "२-३-४३", "content_sanskrit": "कामक्रोधसमुत्थानि त्यजस्व व्यसनानि च।\nपरोक्षया वर्तमानो वृत्त्या प्रत्यक्षया तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000080044, "chapter_id": 9080, "verse_number": "२-३-४४", "content_sanskrit": "अमात्यप्रभृतीः सर्वाः प्रजाश्चैवानुरञ्जय।\nकोष्ठागारायुधागारैः कृत्वा संनिचयान् बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000080045, "chapter_id": 9080, "verse_number": "२-३-४५", "content_sanskrit": "इष्टानुरक्तप्रकृतिर्यः पालयति मेदिनीम्।\nतस्य नन्दन्ति मित्राणि लब्ध्वामृतमिवामराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000080046, "chapter_id": 9080, "verse_number": "२-३-४६", "content_sanskrit": "तस्मात् पुत्र त्वमात्मानं नियम्यैवं समाचर।\nतच्छ्रुत्वा सुहृदस्तस्य रामस्य प्रियकारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000080047, "chapter_id": 9080, "verse_number": "२-३-४७", "content_sanskrit": "त्वरिताः शीघ्रमागत्य कौसल्यायै न्यवेदयन्।\nसा हिरण्यं च गाश्चैव रत्नानि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000080048, "chapter_id": 9080, "verse_number": "२-३-४८", "content_sanskrit": "व्यादिदेश प्रियाख्येभ्यः कौसल्या प्रमदोत्तमा।\nअथाभिवाद्य राजानं रथमारुह्य राघवः।\nययौ स्वं द्युतिमद् वेश्म जनौघैः प्रतिपूजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000080049, "chapter_id": 9080, "verse_number": "२-३-४९", "content_sanskrit": "ते चापि पौरा नृपतेर्वचस्त-\nच्छ्रुत्वा तदा लाभमिवेष्टमाशु।\nनरेन्द्रमामन्त्र्य गृहाणि गत्वा\nदेवान् समानर्चुरभिप्रहृष्टाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000080050, "chapter_id": 9080, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे तृतीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]