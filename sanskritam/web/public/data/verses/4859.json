[{"id": 2182112, "chapter_id": 4859, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2182113, "chapter_id": 4859, "verse_number": "१", "content_sanskrit": "ब्रह्मक्षत्रस्य सामर्थ्यं कथितं ते पितामह ।\nपुरोहितप्रभावश्च लक्षणं च पुरोधसः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2182114, "chapter_id": 4859, "verse_number": "२", "content_sanskrit": "इदानीं श्रोतुमिच्छामि ब्रह्मक्षत्रविनिर्णयम् ।\nब्रह्मक्षत्रं हि सर्वस्य कारणं जगतः परम् ।\nयोगक्षेमो हि राष्ट्रस्य ताभ्यामायत्त एव हि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2182115, "chapter_id": 4859, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2182116, "chapter_id": 4859, "verse_number": "३", "content_sanskrit": "योगक्षेमो हि राष्ट्रस्य राजन्यायत्त उच्यते ।\nयोगक्षेमश्च राज्ञोऽपि समायत्तः पुरोहिते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2182117, "chapter_id": 4859, "verse_number": "४", "content_sanskrit": "यत्रादृष्टं भयं ब्रह्म प्रजानां शमयत्युत ।\nदृष्टं च राजा बाहुभ्यां तद् राष्ट्रं सुखमेधते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2182118, "chapter_id": 4859, "verse_number": "५", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nमुचुकुन्दस्य संवादं राज्ञो वैश्रवणस्य च\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2182119, "chapter_id": 4859, "verse_number": "६", "content_sanskrit": "मुचुकुन्दो विजित्येमां पृथिवीं पृथिवीपतिः ।\nजिज्ञासमानः स्वबलमभ्ययादलकाधिपम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2182120, "chapter_id": 4859, "verse_number": "७", "content_sanskrit": "ततो वैश्रवणो राजा रक्षांसि समवासृजत् ।\nते बलान्यवमृद्गन्तः प्राचरंस्तस्य नैर्ऋताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2182121, "chapter_id": 4859, "verse_number": "८", "content_sanskrit": "स हन्यमाने सैन्ये स्वे मुचुकुन्दो नराधिपः ।\nगर्हयामास विद्वांसं पुरोहितमरिन्दमः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2182122, "chapter_id": 4859, "verse_number": "९", "content_sanskrit": "तत उग्रं तपस्तप्त्वा वसिष्ठो ब्रह्मवित्तमः ।\nरक्षांस्यपावधीत् तत्र पन्थानं चाप्यविन्दत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2182123, "chapter_id": 4859, "verse_number": "१०", "content_sanskrit": "ततो वैश्रवणो राजा मुचुकुन्दमगर्हयत् ।\nवध्यमानेषु सैन्येषु वचनं चेदमब्रवीत्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2182124, "chapter_id": 4859, "verse_number": "११", "content_sanskrit": "त्वत्तो हि बलिनः पूर्वे राजानः सपुरोहिताः ।\nनचैवं समवर्तंस्ते यथा त्वमिह वर्तसे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2182125, "chapter_id": 4859, "verse_number": "१२", "content_sanskrit": "ते खल्वपि कृतास्त्राश्च बलवन्तश्च भूमिपाः ।\nआगम्य पर्युपासन्ते मामीशं सुखदुःखयोः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2182126, "chapter_id": 4859, "verse_number": "१३", "content_sanskrit": "यद्यस्ति बाहुवीर्यं ते तद् दर्शयितुमर्हसि ।\nकिं ब्राह्मणबलेन त्वमतिमात्रं प्रवर्तसे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2182127, "chapter_id": 4859, "verse_number": "१४", "content_sanskrit": "मुचुकुन्दस्ततः क्रुद्धः प्रत्युवाच धनेश्वरम् ।\nन्यायपूर्वमसंरब्धमसम्भ्रान्तमिदं वचः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2182128, "chapter_id": 4859, "verse_number": "१५", "content_sanskrit": "ब्रह्मक्षत्रमिदं सृष्टमेकयोनि स्वयम्भुवा ।\nपृथग् बलविधानं च तल्लोकं परिरक्षति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2182129, "chapter_id": 4859, "verse_number": "१६", "content_sanskrit": "तपोमन्त्रबलं नित्यं ब्राह्मणेषु प्रतिष्ठितम् ।\nअस्त्रबाहुबलं नित्यं क्षत्रियेषु प्रतिष्ठितम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2182130, "chapter_id": 4859, "verse_number": "१७", "content_sanskrit": "ताभ्यां सम्भूय कर्तव्यं प्रजानां परिपालनम् ।\nतथाच मां प्रवर्तन्तं गर्हयस्यलकाधिप\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2182131, "chapter_id": 4859, "verse_number": "१८", "content_sanskrit": "ततोऽब्रवीद् वैश्रवणो राजानं सपुरोहितम् ।\nनाहं राज्यमनिर्दिष्टं कस्मैचिद् विदधाम्युत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2182132, "chapter_id": 4859, "verse_number": "१९", "content_sanskrit": "नाच्छिन्दे चापि निर्दिष्टमिति जानीहि पार्थिव ।\nप्रशाधि पृथिवीं वीर मद्दत्तामखिलामिमाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2182133, "chapter_id": 4859, "verse_number": "", "content_sanskrit": "मुचुकुन्दः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2182134, "chapter_id": 4859, "verse_number": "२०", "content_sanskrit": "नाहं राज्यं भवद्दत्तं भोक्तुमिच्छामि पार्थिव ।\nबाहुवीर्यार्जितं राज्यमश्नीयामिति कामये\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2182135, "chapter_id": 4859, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2182136, "chapter_id": 4859, "verse_number": "२१", "content_sanskrit": "ततो वैश्रवणो राजा विस्मयं परमं ययौ ।\nक्षत्रधर्मे स्थितं दृष्ट्वा मुचुकुन्दमसम्भ्रमम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2182137, "chapter_id": 4859, "verse_number": "२२", "content_sanskrit": "ततो राजा मुचुकुन्दः सोऽन्वशासद् वसुन्धराम् ।\nबाहुवीर्यार्जितां सम्यक् क्षत्रधर्ममनुव्रतः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2182138, "chapter_id": 4859, "verse_number": "२३", "content_sanskrit": "एवं यो ब्रह्मविद् राजा ब्रह्मपूर्वं प्रवर्तते ।\nजयत्यविजितामुर्वीं यशश्च महदश्नुते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2182139, "chapter_id": 4859, "verse_number": "२४", "content_sanskrit": "नित्योदको ब्राह्मणः स्यान्नित्यशस्त्रश्च क्षत्रियः ।\nतयोर्हि सर्वमायत्तं यत्किञ्चिज्जगतीगतम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2182140, "chapter_id": 4859, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे षट्सप्ततितमोऽध्यायः ॥ ७६ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]