[{"id": 7002006000, "chapter_id": 22006, "verse_number": "५१-१", "content_sanskrit": "भगवानुवाच ।\nससप्ताश्वे सैकचक्रे रथे सूर्य्यो द्विपद्मधृक् ।\nमसीभाजनलेखन्यौ बिभ्रत्कुण्डी तु दक्षिणे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002006001, "chapter_id": 22006, "verse_number": "५१-२", "content_sanskrit": "वामे तु पिङ्गलो द्वारि दण्डभृत् स रवेर्गणः ।\nबालव्यजनधारिण्यौ पार्श्वे राज्ञी च निष्प्रभा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002006002, "chapter_id": 22006, "verse_number": "५१-३", "content_sanskrit": "अथवाश्वसमारूढः कार्य्य एकस्तु भास्करः ।\nवरदा द्व्यब्जिनः सर्वे दिक्पालास्त्रकराः क्रमात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002006003, "chapter_id": 22006, "verse_number": "५१-४", "content_sanskrit": "मुद्गरशूलचक्राव्जभृतोग्न्यादिविदिक्स्थिताः ।\nसूर्य्यार्यमादिरक्षोन्ताश्चतुर्हस्ता द्विषड्दले ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002006004, "chapter_id": 22006, "verse_number": "५१-५", "content_sanskrit": "वरुणः सूर्यनामा च सहस्रांशुस्तथापरः ।\nधाता तपनसञ्ज्ञश्च सविताथ गभस्तिकः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002006005, "chapter_id": 22006, "verse_number": "५१-६", "content_sanskrit": "रविश्चैवाथ पर्ज्जन्यस्त्वष्टा मित्रोथ विष्णुकः ।\nमेषादिराशिसंस्थाश्च मार्गादिकार्त्तिकान्तकाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002006006, "chapter_id": 22006, "verse_number": "५१-७", "content_sanskrit": "कृष्णो रक्तो मनाग्रक्तः पीतः पाण्डरकः सितः ।\nकपिलः पीतवर्णश्च शुकाभो धवलस्तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002006007, "chapter_id": 22006, "verse_number": "५१-८", "content_sanskrit": "धूम्रो नीलः क्रमाद्वर्णाः शक्तयः केशराग्रगाः ।\nइडा सुषुम्णा विश्वार्च्चिरिन्दुसञ्ज्ञा प्रमर्दिनी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002006008, "chapter_id": 22006, "verse_number": "५१-९", "content_sanskrit": "ग्रहर्षणी महाकाली कपिला च प्रबोधनी ।\nनीलाम्बरा घनान्तस्था अमृताख्या च शक्तयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002006009, "chapter_id": 22006, "verse_number": "५१-१०", "content_sanskrit": "वरुणादेश्च तद्वर्णाः केशराग्रेषु विन्यसेत् ।\nतेजश्चण्डोमहावक्रो द्विभुजः पद्मखड्गभृत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002006010, "chapter_id": 22006, "verse_number": "५१-११", "content_sanskrit": "कुण्डिकाकजप्यमालीन्दुः कुजः शक्त्यक्षमालिकः ।\nबुधश्चापाक्षपाणिः स्याज्जीवः कुण्ड्यक्षमालिकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002006011, "chapter_id": 22006, "verse_number": "५१-१२", "content_sanskrit": "शुक्रः कुण्ड्यक्षमाली स्यात् किङ्किणीसूत्रवाञ्छनिः ।\nअर्द्धचन्द्रधरो राहुः केतुः खड्गी च दीपभृत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002006012, "chapter_id": 22006, "verse_number": "५१-१३", "content_sanskrit": "अनन्तस्तक्षकः कर्क्कः पद्मो महाब्जः शङ्खकः ।\nकुलिकः सूत्रिणः सर्वे फणवक्त्रा महाप्रभाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002006013, "chapter_id": 22006, "verse_number": "५१-१४", "content_sanskrit": "इन्द्रो वज्री गजारूढश्लागगोग्निश्च शक्तिमान् ।\nयमो दण्डी च महिषे नैरृतः खड्गवान् करे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002006014, "chapter_id": 22006, "verse_number": "५१-१५", "content_sanskrit": "मकरे वरुणः पाशी वायुर्ध्वजधरो मृगे ।\nगदी कुवेरो मेषस्थ ईशानश्च जटी वृषे ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002006015, "chapter_id": 22006, "verse_number": "५१-१६", "content_sanskrit": "द्विबाहवो लोकपाला विश्वकर्म्माक्षसूत्रभृत् ।\nहनूमान् वज्रहस्तः स्यात् पद्भ्यां सम्पीडिताश्रयः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002006016, "chapter_id": 22006, "verse_number": "५१-१७", "content_sanskrit": "विणाहस्ताः किन्नराः स्युर्मालाविद्याधराश्च खे ।\nदुर्बलाङ्गाः पिशाचाः स्युर्वेताला विकृताननाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002006017, "chapter_id": 22006, "verse_number": "५१-१८", "content_sanskrit": "क्षेत्रपालाः शूलवन्तः प्रेता महोदराः कृशाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]