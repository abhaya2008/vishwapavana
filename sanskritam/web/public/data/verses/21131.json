[{"id": 7001131000, "chapter_id": 21131, "verse_number": "२-२-२२-१", "content_sanskrit": "ब्रह्मोवाच ।\nकदाचिदथ दक्षस्य तनया जलदागमे ।\nकैलासक्ष्माभृतः प्राह प्रस्थस्थं वृषभध्वजम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001131001, "chapter_id": 21131, "verse_number": "२-२-२२-२", "content_sanskrit": "सत्युवाच ।\nदेव देव महादेव शंभो मत्प्राणवल्लभ ।\nशृणु मे वचनं नाथ श्रुत्वा तत्कुरु मानद॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001131002, "chapter_id": 21131, "verse_number": "२-२-२२-३", "content_sanskrit": "घनागमोयं संप्राप्तः कालः परमदुस्सहः ।\nअनेकवर्णमेघौघास्संगीतांबरदिक्चयाः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001131003, "chapter_id": 21131, "verse_number": "२-२-२२-४", "content_sanskrit": "विवांति वाता हृदयं हारयंतीत वेगिनः ।\nकदंबरजसा धौताः पाथोबिन्दुविकर्षणाः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001131004, "chapter_id": 21131, "verse_number": "२-२-२२-५", "content_sanskrit": "मेघानां गर्जितैरुच्चैर्धारासारं विमुंचताम् ।\nविद्युत्पताकिनां तीव्रः क्षुब्धं स्यात्कस्य नो मनः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001131005, "chapter_id": 21131, "verse_number": "२-२-२२-६", "content_sanskrit": "न सूर्यो दृश्यते नापि मेघच्छन्नो निशापतिः ।\nदिवापि रात्रिवद्भाति विरहि व्यसनाकरः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001131006, "chapter_id": 21131, "verse_number": "२-२-२२-७", "content_sanskrit": "मेघानैकत्र तिष्ठंतो ध्वनन्त पवनेरिताः ।\nपतंत इव लोकानां दृश्यंते मूर्ध्नि शंकर॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001131007, "chapter_id": 21131, "verse_number": "२-२-२२-८", "content_sanskrit": "वाताहता महावृक्षा नर्तंत इव चांबरे ।\nदृश्यंते हर भीरूणां त्रासदाः कामुकेप्सिता॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001131008, "chapter_id": 21131, "verse_number": "२-२-२२-९", "content_sanskrit": "स्निग्धनीलांजनस्याशु सदिवौघस्य पृष्ठतः ।\nबलाकराजी वात्युच्चैर्यमुनापृष्ठफेनवत्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001131009, "chapter_id": 21131, "verse_number": "२-२-२२-१०", "content_sanskrit": "क्षपाक्षयेषवलयं दृश्यते कालिकागता ।\nअंबुधाविव संदीप्तपावको वडवामुखः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001131010, "chapter_id": 21131, "verse_number": "२-२-२२-११", "content_sanskrit": "प्रारोहंतीह सस्यानि मंदिरं प्राङ्गणेष्वपि ।\nकिमन्यत्र विरूपाक्ष सस्यौद्भूतिं वदाम्यहम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001131011, "chapter_id": 21131, "verse_number": "२-२-२२-१२", "content_sanskrit": "श्यामलै राजतैरक्तैर्विशदोयं हिमाचलः ।\nमंदराश्रयमेघौघः पत्रैर्दुग्धांबुधिर्यथा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001131012, "chapter_id": 21131, "verse_number": "२-२-२२-१३", "content_sanskrit": "असमश्रीश्च कुटिलं भेजे यस्याथ किंशुकान् ।\nउच्चावचान् कलौ लक्ष्मीर्गन्ता संत्यज्य सज्जनान्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001131013, "chapter_id": 21131, "verse_number": "२-२-२२-१४", "content_sanskrit": "मंदारस्तन पीलूनां शब्देन हृषिता मुहुः ।\nकेकायंते प्रतिवने सततं पृष्ठसूचकम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001131014, "chapter_id": 21131, "verse_number": "२-२-२२-१५", "content_sanskrit": "मेघोत्सुकानां मधुरश्चातकानां मनोहरः ।\nधारासारशरैस्तापं पेतुः प्रतिपथोद्गतम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001131015, "chapter_id": 21131, "verse_number": "२-२-२२-१६", "content_sanskrit": "मेघानां पश्य मद्देहे दुर्नयं करकोत्करैः ।\nये छादयंत्यनुगते मयूरांश्चातकांस्तथा॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001131016, "chapter_id": 21131, "verse_number": "२-२-२२-१७", "content_sanskrit": "शिखसारंगयोर्दृष्ट्वा मित्रादपि पराभवम् ।\nहर्षं गच्छंति गिरिशं विदूरमपि मानसम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001131017, "chapter_id": 21131, "verse_number": "२-२-२२-१८", "content_sanskrit": "एतस्मिन्विषमे काले नीलं काकाश्चकोरकाः ।\nकुर्वंति त्वां विना गेहान् कथं शांतिमवाप्स्यसि॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001131018, "chapter_id": 21131, "verse_number": "२-२-२२-१९", "content_sanskrit": "महतीवाद्य नो भीतिर्मा मेघोत्था पिनाकधृक् ।\nयतस्व यस्माद्वासाय माचिरं वचनान्मम॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001131019, "chapter_id": 21131, "verse_number": "२-२-२२-२०", "content_sanskrit": "कैलासे वा हिमाद्रौ वा महाकाश्यामथ क्षितौ ।\nतत्रोपयोग्यं संवासं कुरु त्वं वृषभध्वज॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001131020, "chapter_id": 21131, "verse_number": "२-२-२२-२१", "content_sanskrit": "॥ ब्रह्मोवाच  ।\nएवमुक्तस्तया शंभुर्दाक्षायण्या तथाऽसकृत ।\nसंजहास च शीर्षस्थचन्द्ररश्मिस्मितालयम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001131021, "chapter_id": 21131, "verse_number": "२-२-२२-२२", "content_sanskrit": "अथोवाच सतीं देवीं स्मितभिन्नौष्ठसंपुटः॥  ।\nमहात्मा सर्वतत्त्वज्ञस्तोषयन्परमेश्वरः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001131022, "chapter_id": 21131, "verse_number": "२-२-२२-२३", "content_sanskrit": "ईश्वरः उवाच ।\nयत्र प्रीत्यै मया कार्यो वासस्तव मनोहरे ।\nमेघास्तत्र न गंतारः कदाचिदपि मत्प्रिये॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001131023, "chapter_id": 21131, "verse_number": "२-२-२२-२४", "content_sanskrit": "मेघा नितंबपर्यंतं संचरंति महीभृतः ।\nसदा प्रालेयसानोस्तु वर्षास्वपि मनोहरे॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001131024, "chapter_id": 21131, "verse_number": "२-२-२२-२५", "content_sanskrit": "कैलासस्य तथा देवि पादगाः प्रायशो घनाः ।\nसंचरंति न गच्छंति तत ऊर्द्ध्वं कदाचन॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001131025, "chapter_id": 21131, "verse_number": "२-२-२२-२६", "content_sanskrit": "सुमेरोर्वा गिरेरूर्द्ध्वं न गच्छंति बलाहकाः ।\nजम्बूमूलं समासाद्य पुष्करावर्तकादयः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001131026, "chapter_id": 21131, "verse_number": "२-२-२२-२७", "content_sanskrit": "इत्युक्तेषु गिरीन्द्रेषु यस्योपरि भवेद्धि ते ।\nमनोरुचिर्निवासाय तमाचक्ष्व द्रुतं हि मे॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001131027, "chapter_id": 21131, "verse_number": "२-२-२२-२८", "content_sanskrit": "स्वेच्छाविहारैस्तव कौतुकानि सुवर्णपक्षानिलवृन्दवृन्दैः ।\nशब्दोत्तरंगैर्मधुरस्वनैस्तैर्मुदोपगेयानि गिरौ हिमोत्थे॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001131028, "chapter_id": 21131, "verse_number": "२-२-२२-२९", "content_sanskrit": "सिद्धाङ्गनास्ते रचितासना भुवमिच्छंति चैवोपहृतं सकौतुकम् ।\nस्वेच्छाविहारे मणिकुट्टिमे गिरौ कुर्वन्ति चेष्यंति फलादिदानकैः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001131029, "chapter_id": 21131, "verse_number": "२-२-२२-३०", "content_sanskrit": "फणीन्द्रकन्या गिरिकन्यकाश्च या नागकन्याश्च तुरंगमुख्याः ।\nसर्वास्तु तास्ते सततं सहायतां समाचरिष्यंत्यनुमोदविभ्रमैः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001131030, "chapter_id": 21131, "verse_number": "२-२-२२-३१", "content_sanskrit": "रूपं तदेवमतुलं वदनं सुचारु दृष्ट्वांगना निजवपुर्निजकांतिसह्यम् ।\nहेला निजे वपुषि रूपगणेषु नित्यं कर्तार इत्यनिमिषेक्षणचारुरूपाः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001131031, "chapter_id": 21131, "verse_number": "२-२-२२-३२", "content_sanskrit": "या मेनका पर्वतराज जाया रूपैर्गुणैः ख्यातवती त्रिलोके ।\nसा चापि ते तत्र मनोनुमोदं नित्यं करिष्यत्यनुनाथनाद्यैः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001131032, "chapter_id": 21131, "verse_number": "२-२-२२-३३", "content_sanskrit": "पुरं हि वर्गैर्गिंरिराजवंद्यैः प्रीतिं विचिन्वद्भिरुदाररूपा ।\nशिक्षा सदा ते खलु शोचितापि कार्याऽन्वहं प्रीतियुता गुणाद्यैः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001131033, "chapter_id": 21131, "verse_number": "२-२-२२-३४", "content_sanskrit": "विचित्रैः कोकिलालापमोदैः कुंजगणावृतम् ।\nसदा वसंतप्रभवं गंतुमिच्छसि किं प्रिये॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001131034, "chapter_id": 21131, "verse_number": "२-२-२२-३५", "content_sanskrit": "नानाबहुजलापूर्णसरश्शीत समावृतम् ।\nपद्मिनीशतशोयुक्तमचलेन्द्रं हिमालयम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001131035, "chapter_id": 21131, "verse_number": "२-२-२२-३६", "content_sanskrit": "सर्वकामप्रदैर्वृक्षैश्शाद्वलैः कल्पसंज्ञकैः ।\nसक्षणं पश्य कुसुमान्यथाश्वकरि गोव्रजे॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001131036, "chapter_id": 21131, "verse_number": "२-२-२२-३७", "content_sanskrit": "प्रशांतश्वापदगणं मुनिभिर्यतिभिर्वृतम् ।\nदेवालयं महामाये नानामृगगणैर्युतम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001131037, "chapter_id": 21131, "verse_number": "२-२-२२-३८", "content_sanskrit": "स्फटिक स्वर्णवप्राद्यै राजतैश्च विराजितम् ।\nमानसादिसरोरंगैरभितः परिशोभितम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001131038, "chapter_id": 21131, "verse_number": "२-२-२२-३९", "content_sanskrit": "हिरण्मयै रत्ननालैः पंकजैर्मुकुलैर्वृतम् ।\nशिशुमारैस्तथासंख्यैः कच्छपैर्मकरैः करैः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001131039, "chapter_id": 21131, "verse_number": "२-२-२२-४०", "content_sanskrit": "निषेवितं मंजुलैश्च तथा नीलोत्पलादिभिः ।\nदेवेशि तस्मान्मुक्तैश्च सर्वगंधैश्च कुंकुमैः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001131040, "chapter_id": 21131, "verse_number": "२-२-२२-४१", "content_sanskrit": "लसद्गंधजलैः शुभ्रैरापूर्णैः स्वच्छकांतिभिः ।\nशाद्वलैस्तरुणैस्तुंगैस्तीरस्थैरुपशोभितम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001131041, "chapter_id": 21131, "verse_number": "२-२-२२-४२", "content_sanskrit": "नृत्यद्भिरिव शाखोटैर्वर्जयंतं स्वसंभवम् ।\nकामदेवैस्सारसैश्च मत्तचक्रांगशोभितैः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001131042, "chapter_id": 21131, "verse_number": "२-२-२२-४३", "content_sanskrit": "मधुराराविभिर्मोदकारिभिर्भ्रमरादिभिः ।\nशब्दायमानं च मुदा कामोद्दीपनकारकम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001131043, "chapter_id": 21131, "verse_number": "२-२-२२-४४", "content_sanskrit": "वासवस्य कुबेरस्य यमस्य वरुणस्य च ।\nअग्नेः कोणपराजस्य मारुतस्य परस्य च॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001131044, "chapter_id": 21131, "verse_number": "२-२-२२-४५", "content_sanskrit": "पुरीभिश्शोभिशिखरं मेरोरुच्चैस्सुरालयम् ।\nरंभाशचीमेनकादिरंभोरुगणसेवितम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001131045, "chapter_id": 21131, "verse_number": "२-२-२२-४६", "content_sanskrit": "किं त्वमिच्छसि सर्वेषां पर्वतानां हि भूभृताम् ।\nसारभूते महारम्ये संविहर्तुं महागिरौ॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001131046, "chapter_id": 21131, "verse_number": "२-२-२२-४७", "content_sanskrit": "तत्र देवी सखियुता साप्सरोगणमंडिता ।\nनित्यं करिष्यति शची तव योग्यां सहायताम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001131047, "chapter_id": 21131, "verse_number": "२-२-२२-४८", "content_sanskrit": "अथवा मम कैलासे पर्वतेंद्रे सदाश्रये ।\nस्थानमिच्छसि वित्तेशपुरीपरिविराजिते॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001131048, "chapter_id": 21131, "verse_number": "२-२-२२-४९", "content_sanskrit": "गंगाजलौघप्रयते पूर्णचन्द्रसमप्रभे ।\nदरीषु सानुषु सदा ब्रह्मकन्याभ्युदीरिते॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001131049, "chapter_id": 21131, "verse_number": "२-२-२२-५०", "content_sanskrit": "नानामृगगणैर्युक्ते पद्माकरशतावृते ।\nसर्वैर्गुणैश्च सद्वस्तुसुमेरोरपि सुंदरि॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001131050, "chapter_id": 21131, "verse_number": "२-२-२२-५१", "content_sanskrit": "स्थानेष्वेतेषु यत्रापि तवांतःकरणे स्पृहा ।\nतं द्रुतं मे समाचक्ष्व वासकर्तास्मि तत्र ते॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001131051, "chapter_id": 21131, "verse_number": "२-२-२२-५२", "content_sanskrit": "ब्रह्मोवाच ।\nइतीरिते शंकरेण तदा दाक्षायणी शनैः ।\nइदमाह महादेवं लक्षणं स्वप्रकाशनम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001131052, "chapter_id": 21131, "verse_number": "२-२-२२-५३", "content_sanskrit": "॥ सत्युवाच  ।\nहिमाद्रावेव वसितुमहमिच्छे त्वया सह ।\nन चिरात्कुरु संवासं तस्मिन्नेव महागिरौ॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001131053, "chapter_id": 21131, "verse_number": "२-२-२२-५४", "content_sanskrit": "ब्रह्मोवाच ।\nअथ तद्वाक्यमाकर्ण्य हरः परममोहितः ।\nहिमाद्रिशिखरं तुंगं दाक्षायण्या समं ययौ॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001131054, "chapter_id": 21131, "verse_number": "२-२-२२-५५", "content_sanskrit": "सिद्धांगनागणयुतमगम्यं चैव पक्षिभिः ।\nअगमच्छिखरं रम्यं सरसीवनराजितम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001131055, "chapter_id": 21131, "verse_number": "२-२-२२-५६", "content_sanskrit": "विचित्ररूपैः कमलैः शिखरं रत्नकर्बुरम् ।\nबालार्कसदृशं शंभुराससाद सतीसखः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001131056, "chapter_id": 21131, "verse_number": "२-२-२२-५७", "content_sanskrit": "स्फटिकाभ्रमये तस्मिन् शादवलद्रुमराजिते ।\nविचित्रपुष्पावलिभिस्सरसोभिश्च संयुते॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001131057, "chapter_id": 21131, "verse_number": "२-२-२२-५८", "content_sanskrit": "प्रफुल्लतरुशाखाग्रं गुंजद्भ्रमरसेवितम् ।\nपंकेरुहैः प्रफुल्लैश्च नीलोत्पलचयैस्तथा॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001131058, "chapter_id": 21131, "verse_number": "२-२-२२-५९", "content_sanskrit": "शोभितं चक्रवाकाद्यैः कादंबैर्हंसशंकुभिः ।\nप्रमत्तसारसैः क्रौंचैर्नीलस्कंधैश्च शब्दितैः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001131059, "chapter_id": 21131, "verse_number": "२-२-२२-६०", "content_sanskrit": "पुंस्कोकिलानां निनदैर्मधुरैर्गणसेवितैः ।\nतुरंगवदनैस्सिद्धैरप्सरोभिश्च गुह्यकैः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001131060, "chapter_id": 21131, "verse_number": "२-२-२२-६१", "content_sanskrit": "विद्याधरीभिर्देवीभिः किन्नरीभिर्विहारितम् ।\nपुरंध्रीभिः पार्वतीभिः कन्याभिरभिसंगतम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001131061, "chapter_id": 21131, "verse_number": "२-२-२२-६२", "content_sanskrit": "विपंचीतांत्रिकामत्तमृदंगपटहस्वनैः ।\nनृत्यद्भिरप्सरोभिश्च कौतुकोत्थैश्च शोभितम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001131062, "chapter_id": 21131, "verse_number": "२-२-२२-६३", "content_sanskrit": "देविकाभिर्दीर्घिकाभिर्गंधिभिस्सुसमावृतम् ।\nप्रफुल्लकुसुमैर्नित्यं सकुंजैरुपशोभितम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001131063, "chapter_id": 21131, "verse_number": "२-२-२२-६४", "content_sanskrit": "शैलराजपुराभ्यर्णे शिखरे वृषभध्वजः ।\nसह सत्या चिरं रेमे एवंभूतेषु शोभनम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001131064, "chapter_id": 21131, "verse_number": "२-२-२२-६५", "content_sanskrit": "तस्मिन्स्वर्गसमे स्थाने दिव्यमानेन शंकरः ।\nदशवर्षसहस्राणि रेमे सत्या समं मुदा॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001131065, "chapter_id": 21131, "verse_number": "२-२-२२-६६", "content_sanskrit": "स कदाचित्ततस्स्थानादन्यद्याति स्थलं हरः ।\nकदाचिन्मेरुशिखरं देवी देववृतं सदा॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001131066, "chapter_id": 21131, "verse_number": "२-२-२२-६७", "content_sanskrit": "द्वीपान्नाना तथोद्यानवनानि वसुधातलम् ।\nगत्वागत्वा पुनस्तत्राभ्येत्य रेमे सतीसुखम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001131067, "chapter_id": 21131, "verse_number": "२-२-२२-६८", "content_sanskrit": "न जज्ञे स दिवा रात्रौ न ब्रह्मणि तपस्समम् ।\nसत्यां हि मनसा शंभुः प्रीतिमेव चकार ह॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001131068, "chapter_id": 21131, "verse_number": "२-२-२२-६९", "content_sanskrit": "एवं महादेवमुखं सत्यपश्यत्स्म सर्वदा ।\nमहादेवोऽपि सर्वत्र सदाद्राक्षीत्सतीमुखम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001131069, "chapter_id": 21131, "verse_number": "२-२-२२-७०", "content_sanskrit": "एवमन्योन्यसंसर्गादनुरागमहीरुहम् ।\nवर्द्धयामासतुः कालीशिवौ भावांबुसेचनैः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]