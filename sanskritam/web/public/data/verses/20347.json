[{"id": 7000347000, "chapter_id": 20347, "verse_number": "२-१९-१", "content_sanskrit": "सूत उवाच ।\nसोमशर्मा महाप्राज्ञः सुमनया सह सत्तमः ।\nकपिलासंगमे पुण्ये रेवातीरे सुपुण्यदे॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000347001, "chapter_id": 20347, "verse_number": "२-१९-२", "content_sanskrit": "स्नात्वा तत्र स मेधावी तर्पयित्वा सुरान्पितॄन् ।\nतपस्तेपे सुशांतात्मा जपन्नारायणं शिवम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000347002, "chapter_id": 20347, "verse_number": "२-१९-३", "content_sanskrit": "द्वादशाक्षरमंत्रेण ध्यानयुक्तो महामनाः ।\nतस्यैव देवदेवस्य वासुदेवस्य सुव्रतः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000347003, "chapter_id": 20347, "verse_number": "२-१९-४", "content_sanskrit": "आसने शयने याने स्वप्ने पश्यति केशवम् ।\nसदैव निश्चलो भूत्वा कामक्रोधविवर्जितः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000347004, "chapter_id": 20347, "verse_number": "२-१९-५", "content_sanskrit": "सा च साध्वी महाभागा पतिव्रतपरायणा ।\nसुमना कांतमेवापि शुश्रूषति तपोन्वितम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000347005, "chapter_id": 20347, "verse_number": "२-१९-६", "content_sanskrit": "ध्यायमानस्य तस्यापि विघ्नैः संदर्शितं भयम् ।\nसर्पा विषोल्बणाः कृष्णास्तत्र यांति महात्मनः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000347006, "chapter_id": 20347, "verse_number": "२-१९-७", "content_sanskrit": "पार्श्वे ते तप्यमानस्य तस्य ते सोमशर्मणः ।\nसिंहव्याघ्रगजा दृष्टा भयमेवं प्रचक्रिरे॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000347007, "chapter_id": 20347, "verse_number": "२-१९-८", "content_sanskrit": "वेताला राक्षसा भूताः कूष्मांडाः प्रेतभैरवाः ।\nभयं विदर्शयंत्येते दारुणं प्राणनाशनम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000347008, "chapter_id": 20347, "verse_number": "२-१९-९", "content_sanskrit": "नानाविधा महाभीमाः सिंहास्तत्र समागताः ।\nदंष्ट्राकरालवक्त्राश्च जगर्जुश्चातिभैरवम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000347009, "chapter_id": 20347, "verse_number": "२-१९-१०", "content_sanskrit": "विष्णोर्ध्यानात्स धर्मात्मा न चचाल महामतिः ।\nमहाविघ्नैः सुसंरूढैश्चालितो मुनिपुंगवः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000347010, "chapter_id": 20347, "verse_number": "२-१९-११", "content_sanskrit": "एवं न चलते ध्यानात्सोमशर्मा द्विजोत्तमः ।\nझंझावातैश्च शीतेन महावृष्ट्या सुपीडितः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000347011, "chapter_id": 20347, "verse_number": "२-१९-१२", "content_sanskrit": "भंभारावमहाभीमः सिंहस्तत्र समागतः ।\nतं दृष्ट्वा भयवित्रस्तः सस्मार नृहरिं द्विजः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000347012, "chapter_id": 20347, "verse_number": "२-१९-१३", "content_sanskrit": "इंद्रनीलप्रतीकाशं पीतवस्त्रं महौजसम् ।\nशंखचक्रधरं देवं गदापंकजधारिणम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000347013, "chapter_id": 20347, "verse_number": "२-१९-१४", "content_sanskrit": "महामौक्तिकहारेण इंदुवर्णानुकारिणा ।\nकौस्तुभेनापि रत्नेन द्योतमानं जनार्दनम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000347014, "chapter_id": 20347, "verse_number": "२-१९-१५", "content_sanskrit": "श्रीवत्सांकेन दिव्येन हृदयं यस्य राजते ।\nसर्वाभरणशोभांगं शतपत्रनिभेक्षणम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000347015, "chapter_id": 20347, "verse_number": "२-१९-१६", "content_sanskrit": "सुस्मितास्यं सुप्रसन्नं रत्नदामाभिशोभितम् ।\nभ्राजमानं हृषीकेशं ध्यानं तेन कृतं ध्रुवम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000347016, "chapter_id": 20347, "verse_number": "२-१९-१७", "content_sanskrit": "त्वमेव शरणं कृष्ण शरणागतवत्सल ।\nनमोस्तु देवदेवाय किं मे भयं करिष्यति॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000347017, "chapter_id": 20347, "verse_number": "२-१९-१८", "content_sanskrit": "यस्योदरे त्रयो लोकाः सप्त चान्ये महात्मनः ।\nशरणं तस्य प्रविष्टोस्मि क्वास्ते भयं ममैव हि॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000347018, "chapter_id": 20347, "verse_number": "२-१९-१९", "content_sanskrit": "यस्माद्भयाः प्रवर्तंते कृत्यादिक महाबलाः ।\nसर्वभयप्रहर्तारं तमस्मि शरणं गतः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000347019, "chapter_id": 20347, "verse_number": "२-१९-२०", "content_sanskrit": "पातकानां तु सर्वेषां दानवानां महाभयम् ।\nरक्षको विष्णुभक्तानां तमस्मि शरणं गतः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000347020, "chapter_id": 20347, "verse_number": "२-१९-२१", "content_sanskrit": "वृंदारकाणां सर्वेषां दानवानां महात्मनाम् ।\nयो गतिः कृष्णभक्तानां तमस्मि शरणं गतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000347021, "chapter_id": 20347, "verse_number": "२-१९-२२", "content_sanskrit": "अभयो भयनाशाय पापनाशाय ज्ञानवान् ।\nएकश्चेंद्रस्वरूपेण तमस्मि शरणं गतः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000347022, "chapter_id": 20347, "verse_number": "२-१९-२३", "content_sanskrit": "व्याधीनां नाशकायैव य औषधस्वरूपवान् ।\nनिरामयो निरानंदस्तमस्मि शरणंगतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000347023, "chapter_id": 20347, "verse_number": "२-१९-२४", "content_sanskrit": "अचलश्चालयेल्लोकानपापो ज्ञानमेव च ।\nतमस्मि शरणं प्राप्तो भयं किं मे करिष्यति॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000347024, "chapter_id": 20347, "verse_number": "२-१९-२५", "content_sanskrit": "साधूनां चापि सर्वेषां पालको यो ह्यनामयः ।\nपाति विश्वं च विश्वात्मा तमस्मि शरणंगतः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000347025, "chapter_id": 20347, "verse_number": "२-१९-२६", "content_sanskrit": "यो मे मृगेंद्ररूपेण भयं दर्शयतेग्रतः ।\nतमहं शरणं प्राप्तो नरसिंहं नमाम्यहम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000347026, "chapter_id": 20347, "verse_number": "२-१९-२७", "content_sanskrit": "मदमत्तो महाकायो वनहस्ती समागतः ।\nगजलीलागतिं देवं शरणागतवत्सलम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000347027, "chapter_id": 20347, "verse_number": "२-१९-२८", "content_sanskrit": "गजास्यं ज्ञानसंपन्नं सपाशांकुशधारिणम् ।\nकालास्यं गजतुंडं च शरणं सुगतोस्म्यहम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000347028, "chapter_id": 20347, "verse_number": "२-१९-२९", "content_sanskrit": "हिरण्याक्षप्रहर्तारं वाराहं शरणंगतः ।\nवामनं तं प्रपन्नोस्मि शरणागतवत्सलम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000347029, "chapter_id": 20347, "verse_number": "२-१९-३०", "content_sanskrit": "ह्रस्वास्तु वामनाः कुब्जाः प्रेताः कूष्मांडकादयः ।\nमृत्युरूपधराः सर्वे दर्शयंति भयं मम॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000347030, "chapter_id": 20347, "verse_number": "२-१९-३१", "content_sanskrit": "अमृतं तं प्रपन्नोस्मि किं भयं मे करिष्यति ।\nब्रह्मण्यो ब्रह्मदो ब्रह्मा ब्रह्मज्ञानमयो हरिः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000347031, "chapter_id": 20347, "verse_number": "२-१९-३२", "content_sanskrit": "शरणं तं प्रपन्नोस्मि भयं किं मे करिष्यति ।\nअभयो यो हि जगतो भीतिघ्नो भीतिदायकः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000347032, "chapter_id": 20347, "verse_number": "२-१९-३३", "content_sanskrit": "भयरूपं प्रपन्नोस्मि भयं किं मे करिष्यति ।\nतारकः सर्वलोकानां नाशकः सर्वपापिनाम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000347033, "chapter_id": 20347, "verse_number": "२-१९-३४", "content_sanskrit": "तमहं शरणं प्राप्तो धर्मरूपं जनार्दनम् ।\nसुरारणं यो हि रणे वपुर्द्धारयतेऽद्भुतम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000347034, "chapter_id": 20347, "verse_number": "२-१९-३५", "content_sanskrit": "शरणं तस्य गंतास्मि सदागतिरयं मम ।\nझंझावातो महाचंडो वपुर्दूयति मे भृशम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000347035, "chapter_id": 20347, "verse_number": "२-१९-३६", "content_sanskrit": "शरणं तं प्रपन्नोस्मि सदागतिरयं मम ।\nअतिशीतं चातिवर्षा आतपस्तापदायकः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000347036, "chapter_id": 20347, "verse_number": "२-१९-३७", "content_sanskrit": "एषां रूपेण यो देवस्तस्याहं शरणं गतः ।\nकालरूपा अमी प्राप्ता भयदा मम चालकाः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000347037, "chapter_id": 20347, "verse_number": "२-१९-३८", "content_sanskrit": "एषां शरणं प्रपन्नोस्मि हरेः स्वरूपिणां सदा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000347038, "chapter_id": 20347, "verse_number": "२-१९-३९", "content_sanskrit": "यं सर्वदेवं परमेश्वरं हि निष्केवलं ज्ञानमयं प्रदीपम् ।\nवदंति नारायणमादिसिद्धं सिद्धेश्वरं तं शरणं प्रपद्ये॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000347039, "chapter_id": 20347, "verse_number": "२-१९-४०", "content_sanskrit": "इति ध्यायन्स्तुवन्नित्यं केशवं क्लेशनाशनम् ।\nभक्त्या तेन समानीतस्तदात्महृदये हरिः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000347040, "chapter_id": 20347, "verse_number": "२-१९-४१", "content_sanskrit": "उद्यमं विक्रमं तस्य स दृष्ट्वा सोमशर्मणः ।\nआविर्भूय हृषीकेशस्तमुवाच प्रहृष्टवान्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000347041, "chapter_id": 20347, "verse_number": "२-१९-४२", "content_sanskrit": "सोमशर्मन्महाप्राज्ञ श्रूयतां भार्यया सह ।\nवासुदेवोस्मि विप्रेंद्र वरं याचय सुव्रत॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000347042, "chapter_id": 20347, "verse_number": "२-१९-४३", "content_sanskrit": "तेनोक्तो हि स विप्रेन्द्र उन्मील्य नयनद्वयम् ।\nदृष्ट्वा विश्वेश्वरं देवं घनश्यामं महोदयम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000347043, "chapter_id": 20347, "verse_number": "२-१९-४४", "content_sanskrit": "सर्वाभरणशोभांगं सर्वायुधसमन्वितम् ।\nदिव्यलक्षणसंपन्नं पुंडरीकनिभेक्षणम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000347044, "chapter_id": 20347, "verse_number": "२-१९-४५", "content_sanskrit": "पीतेन वाससा युक्तं राजमानं सुरेश्वरम् ।\nवैनतेयसमारूढं शंखचक्रगदाधरम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000347045, "chapter_id": 20347, "verse_number": "२-१९-४६", "content_sanskrit": "ब्रह्मादीनां सुधातारं जगतोस्य महायशाः ।\nविश्वस्यास्य सदातीतं रूपातीतं जगद्गुरुम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000347046, "chapter_id": 20347, "verse_number": "२-१९-४७", "content_sanskrit": "हर्षेण महताविष्टो दंडवत्प्रणिपत्य तम् ।\nश्रियायुक्तं भासमानं सूर्यकोटिसमप्रभम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000347047, "chapter_id": 20347, "verse_number": "२-१९-४८", "content_sanskrit": "बद्धांजलिपुटोभूत्वा तया सुमनया सह ।\nजयजयेत्युवाचैनं जयमाधवमानद॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000347048, "chapter_id": 20347, "verse_number": "२-१९-४९", "content_sanskrit": "जय योगीश योगीन्द्र जय नागांगशायन ।\nयज्ञांग जय यज्ञेश जय शाश्वतसर्वग॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000347049, "chapter_id": 20347, "verse_number": "२-१९-५०", "content_sanskrit": "जय सर्वेश्वरानंत यज्ञरूप नमोऽस्तु ते ।\nजय ज्ञानवतां श्रेष्ठ जय त्वं ज्ञाननायक॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000347050, "chapter_id": 20347, "verse_number": "२-१९-५१", "content_sanskrit": "जय सर्वदसर्वज्ञ जय त्वं सर्वभावन ।\nजय जीवस्वरूपेश महाजीव नमोस्तुते॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000347051, "chapter_id": 20347, "verse_number": "२-१९-५२", "content_sanskrit": "जय प्रज्ञादप्रज्ञांग जय प्राणप्रदायक ।\nजय पापघ्न पुण्येश जय पुण्यपते हरे॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000347052, "chapter_id": 20347, "verse_number": "२-१९-५३", "content_sanskrit": "जय ज्ञानस्वरूपेश ज्ञानगम्याय ते नमः ।\nजय पद्मपलाशाक्ष पद्मनाभाय ते नमः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000347053, "chapter_id": 20347, "verse_number": "२-१९-५४", "content_sanskrit": "जय गोविंदगोपाल जय शंखधरामल ।\nजय चक्रधराव्यक्त व्यक्तरूपाय ते नमः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000347054, "chapter_id": 20347, "verse_number": "२-१९-५५", "content_sanskrit": "जय विक्रमशोभांग जय विक्रमनायक ।\nजय लक्ष्मीविलासांग नमो वेदमयाय ते॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000347055, "chapter_id": 20347, "verse_number": "२-१९-५६", "content_sanskrit": "जय विक्रमशोभांग जय उद्यमदायक ।\nजय उद्यमकालाय उद्यमाय नमोनमः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000347056, "chapter_id": 20347, "verse_number": "२-१९-५७", "content_sanskrit": "जय उद्यमशक्ताय उद्यमत्रयधारक ।\nयुद्धोद्यमप्रवृत्ताय तस्मै धर्माय ते नमः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000347057, "chapter_id": 20347, "verse_number": "२-१९-५८", "content_sanskrit": "नमो हिरण्यरेताय तस्मै ते जायते नमः ।\nअतितेजःस्वरूपाय सर्वतेजोमयाय च॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000347058, "chapter_id": 20347, "verse_number": "२-१९-५९", "content_sanskrit": "दैत्यतेजोविनाशाय पापतेजोहराय च ।\nगोब्राह्मणहितार्थाय नमोस्तु परमात्मने॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000347059, "chapter_id": 20347, "verse_number": "२-१९-६०", "content_sanskrit": "नमोस्तु हुतभोक्त्रे च नमो हव्यवहाय ते ।\nनमः कव्यवहायैव स्वधारूपाय ते नमः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000347060, "chapter_id": 20347, "verse_number": "२-१९-६१", "content_sanskrit": "स्वाहारूपाय यज्ञाय पावनाय नमोनमः ।\nनमस्ते शार्ङ्गहस्ताय हरये पापहारिणे॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000347061, "chapter_id": 20347, "verse_number": "२-१९-६२", "content_sanskrit": "सदसच्चोदनायैव नमो विज्ञानशालिने ।\nनमो वेदस्वरूपाय पावनाय नमोनमः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000347062, "chapter_id": 20347, "verse_number": "२-१९-६३", "content_sanskrit": "नमोस्तु हरिकेशाय सर्वक्लेशहराय ते ।\nकेशवाय परायैव नमस्ते विश्वधारिणे॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000347063, "chapter_id": 20347, "verse_number": "२-१९-६४", "content_sanskrit": "नमः कृपाकरायैव नमो हर्षमयाय ते ।\nअनंताय नमो नित्यं शुद्धाय क्लेशनाशिने॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000347064, "chapter_id": 20347, "verse_number": "२-१९-६५", "content_sanskrit": "आनंदाय नमो नित्यं शुद्धाय केवलाय ते ।\nरुद्रैर्नमितपादाय विरंचिनमिताय ते॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000347065, "chapter_id": 20347, "verse_number": "२-१९-६६", "content_sanskrit": "सुरासुरेंद्रनमित पादपद्माय ते नमः ।\nनमोनमः परेशाय अजितायामृतात्मने॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000347066, "chapter_id": 20347, "verse_number": "२-१९-६७", "content_sanskrit": "क्षीरसागरवासाय नमः पद्माप्रियाय ते ।\nओंकाराय च शुद्धाय अचलाय नमोनमः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000347067, "chapter_id": 20347, "verse_number": "२-१९-६८", "content_sanskrit": "व्यापिने व्यापकायैव सर्वव्यसनहारिणे ।\nनमोनमो वराहाय महाकूर्माय ते नमः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000347068, "chapter_id": 20347, "verse_number": "२-१९-६९", "content_sanskrit": "नमो वामनरूपाय नृसिंहाय महात्मने ।\nनमो रामाय दिव्याय सर्वक्षत्रवधाय च॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000347069, "chapter_id": 20347, "verse_number": "२-१९-७०", "content_sanskrit": "सर्वज्ञानाय मत्स्याय नमो रामाय ते नमः ।\nनमः कृष्णाय बुद्धाय नमो म्लेच्छप्रणाशिने॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000347070, "chapter_id": 20347, "verse_number": "२-१९-७१", "content_sanskrit": "नमः कपिलविप्राय हयग्रीवाय ते नमः ।\nनमो व्यासस्वरूपाय नमः सर्वमयाय ते॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000347071, "chapter_id": 20347, "verse_number": "२-१९-७२", "content_sanskrit": "एवं स्तुत्वा हृषीकेशं तमुवाच जनार्दनम् ।\nगुणानां तु परं पारं ब्रह्मा वेत्ति न पावन॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000347072, "chapter_id": 20347, "verse_number": "२-१९-७३", "content_sanskrit": "न चैव स्तोतुं सर्वज्ञस्तथा रुद्र सःहस्रदृक् ।\nवक्तुं को हि समर्थस्तु कीदृशी मे मतिर्विभो॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000347073, "chapter_id": 20347, "verse_number": "२-१९-७४", "content_sanskrit": "निर्गुणं सगुणं स्तोत्रं मयैव तव केशव ।\nक्षमशब्दापशब्दं मे तव दासोस्मि सुव्रत॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000347074, "chapter_id": 20347, "verse_number": "२-१९-७५", "content_sanskrit": "जन्मजन्मनि लोकेश दयां मे कुरु पावन॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]