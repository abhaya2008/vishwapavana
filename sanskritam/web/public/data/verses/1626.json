[{"id": 2028780, "chapter_id": 1626, "verse_number": "३-२६४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028781, "chapter_id": 1626, "verse_number": "३-२६४-१", "content_sanskrit": "ततः कदाचिद्दुर्वासाः सुखासीनांस्तु पाण्डवान्।\nभुक्त्वा चावस्थितां कृष्णां ज्ञात्वा तस्मिन्वने मुनिः।\nअभ्यागच्छत्परिवृतः शिष्यैरयुतसंमितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028782, "chapter_id": 1626, "verse_number": "३-२६४-२", "content_sanskrit": "दृष्ट्वा यान्तं तमतिथिं स च राजा युधिष्ठिरः।\nजगामाभिमुखः श्रीमान्सह भ्रातृभिरच्युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028783, "chapter_id": 1626, "verse_number": "३-२६४-३", "content_sanskrit": "तस्मै बद्ध्वाञ्जलिं सम्यगुपवेश्य वरासने।\nविधिवत्पूजयित्वा तमातिथ्यन न्यमन्त्रयत्।\nआह्निकं भगवन्कृत्वा शीघ्रमेहीति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028784, "chapter_id": 1626, "verse_number": "३-२६४-४", "content_sanskrit": "जगाम च मुनिः सोपि स्नातुं शिष्यैः सहानघः।\nभोजयेत्सहशिष्यं मां कथमित्यविचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028785, "chapter_id": 1626, "verse_number": "३-२६४-५", "content_sanskrit": "न्यमज्जत्सलिले चापि मुनिसङ्घः समाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028786, "chapter_id": 1626, "verse_number": "३-२६४-६", "content_sanskrit": "एतस्मिन्नन्तरे राजन्द्रौपदी योपितां वरा।\nचिन्तामवाप परमामन्नहेतोः पतिव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028787, "chapter_id": 1626, "verse_number": "३-२६४-७", "content_sanskrit": "सा चिन्तयन्ती च यदा नान्नहेतुमविन्दत।\nमनसा चिन्तयामास कृष्णं कंसनिषूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028788, "chapter_id": 1626, "verse_number": "३-२६४-८", "content_sanskrit": "कृष्णकृष्ण महाबाहो देवकीनन्दनाव्यय।\nवासुदेव जगन्नाथ प्रणतार्तिविनाशन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028789, "chapter_id": 1626, "verse_number": "३-२६४-९", "content_sanskrit": "विश्वात्मन्विश्वजनक विश्वहर्तः प्रभोऽव्यय।\nप्रपन्नपाल गोपाल प्रजापाल परात्पर।\nआकूतीनां च चित्तीनां प्रवर्तक नताऽस्मि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028790, "chapter_id": 1626, "verse_number": "३-२६४-१०", "content_sanskrit": "वरेण्य वरदानन्त अगतीनां गतिप्रद।\nपुराणपुरुष प्राणमनोवृत्त्याद्यगोचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028791, "chapter_id": 1626, "verse_number": "३-२६४-११", "content_sanskrit": "सर्वाध्यक्ष पराध्यक्ष त्वामहं शरणं गता।\nपाहि मां कृपया देव शरणागतवत्सल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028792, "chapter_id": 1626, "verse_number": "३-२६४-१२", "content_sanskrit": "नीलोत्पलदलश्याम पद्मगर्भारुणेक्षण।\nपीताम्बरपरीधान लसत्कौस्तुभभूषण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028793, "chapter_id": 1626, "verse_number": "३-२६४-१३", "content_sanskrit": "त्वमादिरन्तो भूतानां त्वमेव च परायणम्।\nपरात्परतरं ज्योतिर्विश्वात्मा सर्वतोमुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028794, "chapter_id": 1626, "verse_number": "३-२६४-१४", "content_sanskrit": "त्वामेवाहुः परं बीजं निधानं सर्वसंपदाम्।\nत्वया नाथेन देवेश सर्वापद्म्यो भयं न हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028795, "chapter_id": 1626, "verse_number": "३-२६४-१५", "content_sanskrit": "दुःशासनादहं पूर्वं सभायां मोचिता यथा।\nतथैव संकटादस्मान्मामुद्धर्तुमिहार्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028796, "chapter_id": 1626, "verse_number": "३-२६४-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028797, "chapter_id": 1626, "verse_number": "३-२६४-१६", "content_sanskrit": "एवं स्तुतस्तदा देवः कृष्णया भक्तवत्सलः।\nद्रौपद्याः संकटं ज्ञात्वा देवदेवो जगत्पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028798, "chapter_id": 1626, "verse_number": "३-२६४-१७", "content_sanskrit": "पार्स्वस्थां शयने त्यक्त्वा रुक्मिणीं केशवः प्रभुः।\nतत्राजगाम त्वरितो ह्यचिन्त्यगतिरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028799, "chapter_id": 1626, "verse_number": "३-२६४-१८", "content_sanskrit": "ततस्तं द्रौपदी दृष्ट्वाप्रणम्य परया मुदा।\nअब्रवीद्वासुदेवाय मुनेरागमनादिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028800, "chapter_id": 1626, "verse_number": "३-२६४-१९", "content_sanskrit": "ततस्तामब्रवीत्कृष्णः क्षुधितोस्मि भृशातुरः।\nशीघ्रं भोजय मां कृष्णे पश्चात्सर्वं करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028801, "chapter_id": 1626, "verse_number": "३-२६४-२०", "content_sanskrit": "निशम्य तद्वचः कृष्णा लज्जिता वाक्यमब्रवीत्।\nस्थाल्यां भास्करदत्तायामन्नं मद्भोजनावधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028802, "chapter_id": 1626, "verse_number": "३-२६४-२१", "content_sanskrit": "भुक्तवत्यस्म्यहं देव तस्मादन्नं न विद्यते।\nततः प्रोवाच भगवान्कृष्णां कमललोचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028803, "chapter_id": 1626, "verse_number": "३-२६४-२२", "content_sanskrit": "कृष्णे न नर्मकालोऽयं क्षुच्छ्रमेणातुरे मयि।\nशीघ्रं गच्छ मम स्थालीमानयित्वा प्रदर्शय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028804, "chapter_id": 1626, "verse_number": "३-२६४-२३", "content_sanskrit": "इति निर्बन्धतः स्थालीमानाय्य स यदूद्वहः।\nस्थाल्याः कण्ठेऽथ संलग्नं शाकान्नं वीक्ष्यकेशवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028805, "chapter_id": 1626, "verse_number": "३-२६४-२४", "content_sanskrit": "उपयुज्याब्रवीदेनामनेन हरिरीश्वरः।\nविश्वात्मा प्रीयतां देवस्तुष्टश्चास्त्विति यज्ञभूक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028806, "chapter_id": 1626, "verse_number": "३-२६४-२५", "content_sanskrit": "आकारय मुनीञ्शीघ्रं भोजनायेति चाब्रवीत्।\nभीमसेनं महाबाहुः कृष्णः क्लेशविनाशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028807, "chapter_id": 1626, "verse_number": "३-२६४-२६", "content_sanskrit": "ततो जगाम त्वरितो भीमसेनो महायशाः।\nआकारितुं तु तान्सर्वान्भोजनार्थं नृपोत्तम।\nस्नातुं गतान्देवनद्यां दुर्वासःप्रभृतीन्मुनीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028808, "chapter_id": 1626, "verse_number": "३-२६४-२७", "content_sanskrit": "ते चावतीर्णाः सलिले कृतवन्तोऽघमर्षणम्।\nदृष्ट्वोद्गारान्सान्नरसांस्तृप्त्या परमया युताः।\nउत्तीर्य सलिलात्तस्माद्दृष्टवन्तः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028809, "chapter_id": 1626, "verse_number": "३-२६४-२८", "content_sanskrit": "दुर्वाससमभिप्रेक्ष्यते सर्वे मुनयोऽब्रुवन्।\nराज्ञा हिकारयित्वाऽन्नं वयं स्नातुं समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028810, "chapter_id": 1626, "verse_number": "३-२६४-२९", "content_sanskrit": "आकण्ठतृप्ता विप्रर्षे किंस्विद्भुञ्जामहे वयम्।\nवृथा पाकः कृतोस्माभिस्तत्र किं करवामहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028811, "chapter_id": 1626, "verse_number": "३-२६४-३०x", "content_sanskrit": "दुर्वासा उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028812, "chapter_id": 1626, "verse_number": "३-२६४-३०", "content_sanskrit": "वृथा पाकेन राजर्षेरपराधः कृतो महान्।\nमाऽस्मानधाक्षुर्दृष्ट्वैव पाण्डवाः क्रूरचक्षुषा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2028813, "chapter_id": 1626, "verse_number": "३-२६४-३१", "content_sanskrit": "स्मृत्वाऽनुभावं राजर्षेरम्बरीषस्य धीमतः।\nबिभेमि सुतरां विप्रा हरिपादाश्रयाज्जनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2028814, "chapter_id": 1626, "verse_number": "३-२६४-३२", "content_sanskrit": "पाण्डवाश्च महात्मानः सर्वे धर्मपरायणाः।\nशूराश्चकृतविद्याश्च व्रतिनस्तपसि स्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2028815, "chapter_id": 1626, "verse_number": "३-२६४-३३", "content_sanskrit": "सदाचाररता नित्यं वासुदेवपरायणाः।\nक्रुद्धास्ते निर्दहेयुर्वै तूलराशिमिवानलः।\nतत एतानपृष्ट्वैव शिष्याः शीघ्रं पलायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2028816, "chapter_id": 1626, "verse_number": "३-२६४-३४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2028817, "chapter_id": 1626, "verse_number": "३-२६४-३४", "content_sanskrit": "इत्युक्तास्ते द्विजाः सर्वे मुनिना गुरुणा तदा।\nपाण्डवेभ्यो भृशं भीता दुद्रुवुस्ते दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2028818, "chapter_id": 1626, "verse_number": "३-२६४-३५", "content_sanskrit": "भीमसेनो देवनद्यामपश्यन्मुनिसत्तमान्।\nतीर्थे ष्वितस्ततस्तस्या विचचार गवेषयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2028819, "chapter_id": 1626, "verse_number": "३-२६४-३६", "content_sanskrit": "तत्रस्थेभ्यस्तापसेभ्यः श्रुत्वा ताश्चैव विद्रुतान्।\nयुधिष्ठिरमथाभ्येत्य तं वृत्तान्तं न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2028820, "chapter_id": 1626, "verse_number": "३-२६४-३७", "content_sanskrit": "ततस्ते पाण्डवाः सर्वे प्र्यागमनकाङ्क्षिणः।\nप्रतीक्षनतः कियत्कालं जितात्मानोऽवतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2028821, "chapter_id": 1626, "verse_number": "३-२६४-३८", "content_sanskrit": "निशीथेऽभ्येत्य चाकस्मादस्मान्स च्छलयिष्यति।\nकथं च निस्तरेमास्मात्कृच्छ्राद्दैवोपसादितात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2028822, "chapter_id": 1626, "verse_number": "३-२६४-३९", "content_sanskrit": "इति चिन्तापरान्दृष्ट्वा निःश्वसन्तो मुहुर्मुहुः।\nउवाच वचनं श्रीमान्कृष्णः प्रत्यक्षतां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2028823, "chapter_id": 1626, "verse_number": "३-२६४-४०", "content_sanskrit": "भवतामापदं ज्ञात्वा ऋषेः परमकोपनात्।\nद्रौपद्या चिन्तितः पार्था अहं सत्वरमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2028824, "chapter_id": 1626, "verse_number": "३-२६४-४१", "content_sanskrit": "न भयं विद्यतेतस्मादृषेर्दुर्वाससोऽल्पकम्।\nतेजसा भवतां भीतः पूर्वमेव पलायितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2028825, "chapter_id": 1626, "verse_number": "३-२६४-४२", "content_sanskrit": "धर्मनित्यास्तु ये केचिन्न ते सीदन्ति कर्हिचित्।\nआपृच्छे वो गमिष्यामि नियतं भद्रमस्तु वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2028826, "chapter_id": 1626, "verse_number": "३-२६४-४३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2028827, "chapter_id": 1626, "verse_number": "३-२६४-४३", "content_sanskrit": "श्रुत्वेरितं केशवस्य बभूवुः स्वस्थामानसाः।\nद्रौपद्या सहिताः पार्थास्तमूचुर्विगतज्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2028828, "chapter_id": 1626, "verse_number": "३-२६४-४४", "content_sanskrit": "त्वया नाथेन गोविन्द दुस्तरामापदं विभो।\nतीर्णाः प्लवमिवासाद्य मज्जमाना महार्णवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2028829, "chapter_id": 1626, "verse_number": "३-२६४-४५", "content_sanskrit": "स्वस्ति साधय भद्रं ते इत्याज्ञातो ययौ पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2028830, "chapter_id": 1626, "verse_number": "३-२६४-४६", "content_sanskrit": "पाण्डवाश्च महाभाग द्रौपद्या सहिताः प्रभो।\nऊषुः प्रहृष्टमनसो विहरन्तो वनाद्वनम्।\nइति तेऽभिहितं राजन्यत्पृष्टोऽहमिह त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2028831, "chapter_id": 1626, "verse_number": "३-२६४-४७", "content_sanskrit": "एवंविधान्यलीकानि धार्तराष्ट्रैर्दुरात्मभिः।\nपाण्डवेषु वनस्थेषु प्रयुक्तानि वृथाऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2028832, "chapter_id": 1626, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि द्रौपदीहरणपर्वणि चतुःषष्ट्यधिकद्विशततमोऽध्यायः ॥ २६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]