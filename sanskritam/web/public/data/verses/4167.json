[{"id": 2146809, "chapter_id": 4167, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146810, "chapter_id": 4167, "verse_number": "१", "content_sanskrit": "एतत्तु नागलोकस्य नाभिस्थाने स्थितं पुरम् ।\nपाताळमिति विख्यातं दैत्यदानवसेवितम्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146811, "chapter_id": 4167, "verse_number": "२", "content_sanskrit": "इदमद्भिः समं प्राप्ता ये केचिद् ध्रुवजङ्गमाः ।\nप्रविशन्तो महानादं नदन्ति भयपीडिताः\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146812, "chapter_id": 4167, "verse_number": "३", "content_sanskrit": "अत्रासुरोऽग्निः सततं दीप्यते वारिभोजनः ।\nव्यापारेण महात्मानं निबध्य समबध्यत\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146813, "chapter_id": 4167, "verse_number": "४", "content_sanskrit": "अत्रामृतं सुरैः पीत्वा निहितं निहतारिभिः ।\nततः सोमस्य हानिश्च वृद्धिश्चैव प्रदृश्यते\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146814, "chapter_id": 4167, "verse_number": "५", "content_sanskrit": "अत्र दिव्यो हयशिराः काले पर्वणि पर्वणि ।\nउत्तिष्ठति सुवर्णाभः अद्भिरापूरयज्जगत्\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146815, "chapter_id": 4167, "verse_number": "६", "content_sanskrit": "यस्मादत्र समग्रस्ताः पतन्ति जलमूर्तयः ।\nतस्मात् पातालमित्येव ख्यायते पुरमुत्तमम्\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146816, "chapter_id": 4167, "verse_number": "७", "content_sanskrit": "ऐरावतोऽस्मात् सलिलं प्रगृह्य जगतो हितम् ।\nमेघेष्वामुञ्चते शीतं यन्महेन्द्रः प्रवर्षति\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146817, "chapter_id": 4167, "verse_number": "८", "content_sanskrit": "ऐरावतो नागराजो वामनः कुमुदोऽञ्जनः ।\nप्रसूताः सुप्रतीकस्य वंशे वारणसत्तमाः\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146818, "chapter_id": 4167, "verse_number": "९", "content_sanskrit": "अत्र नानाविधाकाराः तिमयो नैकरूपिणः ।\nअप्सु सोमप्रभां पीत्वा वसन्ति जलचारिणः\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146819, "chapter_id": 4167, "verse_number": "१०", "content_sanskrit": "अत्र सूर्यांशुभिर्भिन्नाः पाताळतळमाश्रिताः ।\nमृता हि दिवसे सूत पुनर्जीवन्ति वै निशि\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146820, "chapter_id": 4167, "verse_number": "११", "content_sanskrit": "उदयन् नित्यशश्चात्र चन्द्रमा रश्मिबाहुभिः ।\nअमृतं संस्पृशन् स्पर्शान् सञ्जीवयति देहिनः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146821, "chapter_id": 4167, "verse_number": "१२", "content_sanskrit": "अत्र तेऽधर्मनिरता बद्धाः कालेन पीडिताः ।\nदैतेया निवसन्ति स्म वासवेन हृतश्रियः\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146822, "chapter_id": 4167, "verse_number": "१३", "content_sanskrit": "अत्र भूतपतिर्नाम सर्वभूतमहेश्वरः ।\nभूतये सर्वभूतानामचरत् तप उत्तमम्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146823, "chapter_id": 4167, "verse_number": "१४", "content_sanskrit": "अत्र गोप्रतिमा विप्राः स्वाध्यायाम्नायकर्शिताः ।\nत्यक्तप्राणा जितस्वर्गा निवसन्ति महर्षयः\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146824, "chapter_id": 4167, "verse_number": "१५", "content_sanskrit": "यत्रतत्रशयो नित्यं येनकेनचिदाशितः ।\nयेनकेनचिदाच्छन्नः स गोव्रत इहोच्यते\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146825, "chapter_id": 4167, "verse_number": "१६", "content_sanskrit": "पश्य यद्यत्र ते कश्चिद् रोचते गुणतो वरः ।\nवरयिष्यामि तं गत्वा यत्नमास्थाय मातले\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146826, "chapter_id": 4167, "verse_number": "१७", "content_sanskrit": "नास्य जातिं निसर्गं वा कथ्यमानं शृणोमि वै ।\nपितरं मातरं चापि नास्य जानाति कश्चन\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146827, "chapter_id": 4167, "verse_number": "१७", "content_sanskrit": "अतः किल महानग्निरन्तकाले समुत्थितः ।\nधक्ष्यते मातले सर्वं त्रैलोक्यं सचराचरम्\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146828, "chapter_id": 4167, "verse_number": "१९", "content_sanskrit": "अंशमेतज्जले न्यस्तं दीप्यमानमिव श्रिया ।\nअप्रजानान्निसर्गाद्वै नोद्भिद्यति न सर्पति\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146829, "chapter_id": 4167, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146830, "chapter_id": 4167, "verse_number": "२०", "content_sanskrit": "मातलिस्त्वब्रवीच्छ्रुत्वा नारदस्याथ भाषितम् ।\nन मेऽत्र रोचते कश्चिद् अन्यतो व्रज मा चिरम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146831, "chapter_id": 4167, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अष्टनवतितमोऽध्यायः ॥९८॥\nभगवद्यानपर्वणि एकोनत्रिंशोऽध्यायः ॥२९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]