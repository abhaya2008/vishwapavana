[{"id": 2123243, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2123244, "chapter_id": 3646, "verse_number": "१", "content_sanskrit": "भवन्ति वेश्या वर्धक्यः कितवानां युधिष्ठिर ।\nन ताभिरपि दीव्यन्ति दया नैवास्ति ते विभो ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2123245, "chapter_id": 3646, "verse_number": "२", "content_sanskrit": "काश्यो यद्धनमाहार्षीद् द्रव्यं यच्चान्यदुत्तमम् ।\nतथाऽन्ये पृथिवीपाला यानि रत्नान्युपाहरन् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2123246, "chapter_id": 3646, "verse_number": "३", "content_sanskrit": "वाहनानि धनं चैव कवचान्यायुधानि च ।\nराज्यमात्मा वयं चैव कैतवेन हृताः परैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2123247, "chapter_id": 3646, "verse_number": "४", "content_sanskrit": "न च मे तत्र कोपोऽभूत् सर्वस्येशो हि नो भवान् ।\nइदं त्वतिकृतं मन्ये द्रौपदी यत्र पण्यते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2123248, "chapter_id": 3646, "verse_number": "५", "content_sanskrit": "एषा ह्यनर्हती बाला पाण्डवान् प्राप्य कौरवैः ।\nत्वत्कृते क्लिश्यते क्षुद्रैर्नृशंसैर्निकृतिप्रियैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2123249, "chapter_id": 3646, "verse_number": "६", "content_sanskrit": "अस्याः कृते मन्युरयं त्वयि राजन् निपात्यते ।\nबाहू ते सम्प्रधक्ष्यामि सहदेवाग्निमानय ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2123250, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2123251, "chapter_id": 3646, "verse_number": "७", "content_sanskrit": "पुरा न भीमसेन त्वमीदृशीर्वदसे गिरः ।\nपरैस्ते नाशितं नूनं नृशंसैर्धर्मगौरवम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2123252, "chapter_id": 3646, "verse_number": "८", "content_sanskrit": "न सकामाः परे कार्या धर्ममेवाचरोत्तमम् ।\nभ्रातरं धार्मिकं ज्येष्ठं नातिक्रमितुमर्हसि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2123253, "chapter_id": 3646, "verse_number": "९", "content_sanskrit": "आहूतोऽपि परै राजा क्षात्रं धर्ममनुस्मरन् ।\nदीव्यते परकामेन तन्नः कीर्तिकरं महत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2123254, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2123255, "chapter_id": 3646, "verse_number": "१०", "content_sanskrit": "एवमस्मिन् कृते विद्यां यदि स्माह धनञ्जय ।\nदीप्तोऽग्नौ सहितौ बाहू प्रक्षिपेयं बलादिव ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2123256, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2123257, "chapter_id": 3646, "verse_number": "११", "content_sanskrit": "तथा तान् दुःखितान् दृष्ट्वा पाण्डवान् धृतराष्ट्रजः ।\nक्लिश्यमानां च पाञ्चालीं विकर्ण इदमब्रवीत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2123258, "chapter_id": 3646, "verse_number": "१२", "content_sanskrit": "याज्ञसेन्या यदुक्तं तद् वाक्यं विब्रूत पार्थिवाः ।\nअविवेकेन वाक्यस्य नरकः सत्यमेव नः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2123259, "chapter_id": 3646, "verse_number": "१३", "content_sanskrit": "भीष्मश्च धृतराष्ट्रश्च कुरुवृद्धतमावुभौ ।\nसमेत्य नाहतुः किञ्चिद् विदुरश्च महामतिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2123260, "chapter_id": 3646, "verse_number": "१४", "content_sanskrit": "भारद्वाजोऽपि सर्वेषामाचार्यः कृप एव च ।\nयत एतावपि प्रश्नं नाहतुर्द्विजसत्तमौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2123261, "chapter_id": 3646, "verse_number": "१५", "content_sanskrit": "ये त्वन्ये पृथिवीपालाः समेताः सर्वतोदिशम् ।\nकामक्रोधौ विहायैव ते ब्रुवन्तु यथामति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2123262, "chapter_id": 3646, "verse_number": "१६", "content_sanskrit": "यदेतद् द्रौपदी वाक्यमुक्तवत्यसकृच्छुभम् ।\nविमृश्य कस्य कः पक्षः पार्थिवा वदतोत्तरम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2123263, "chapter_id": 3646, "verse_number": "१७", "content_sanskrit": "एवं स बहुशः सर्वान् उक्तवांस्तान् सभासदः ।\nन च ते पृथिवीपालास्तमूचुः साध्वसाधु वा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2123264, "chapter_id": 3646, "verse_number": "१८", "content_sanskrit": "उक्त्वाऽसकृत् तथा सर्वान् विकर्णः पृथिवीपतीन् ।\nपाणिं पाणौ विनिष्पिष्य निश्श्वसन्निदमब्रवीत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2123265, "chapter_id": 3646, "verse_number": "१९", "content_sanskrit": "विब्रूत पृथिवीपाला वाक्यं मा वा कथञ्चन ।\nमन्ये न्याय्यं यदत्राहं तद्धि वक्ष्यामि कौरवाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2123266, "chapter_id": 3646, "verse_number": "२०", "content_sanskrit": "चत्वार्याहुर्मुनिश्रेष्ठा व्यसनानि महीक्षिताम् ।\nमृगायां पानमक्षांश्च स्त्रीषु चैवातिसक्तताम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2123267, "chapter_id": 3646, "verse_number": "२१", "content_sanskrit": "एतेषु च नरः सक्तो धर्ममुत्सृज्य वर्तते ।\nतथाऽयुक्तेन च कृतां क्रियां लोको न पश्यति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2123268, "chapter_id": 3646, "verse_number": "२२", "content_sanskrit": "तथेयं पाण्डुपुत्रेण व्यसने वर्तता भृशम् ।\nसमाहूतेन कितवैराहिता द्रौपदी पणः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2123269, "chapter_id": 3646, "verse_number": "२३", "content_sanskrit": "साधारणी च सर्वेषां पाण्डवानामनिन्दिता ।\nजितेन पूर्वं चानेन पाण्डवेन पणीकृता ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2123270, "chapter_id": 3646, "verse_number": "२४", "content_sanskrit": "इयं च कीर्तिता कृष्णा सौबलेन पणार्थिना ।\nएतत् सर्वं विचार्याहं मन्ये न विजितामिमाम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2123271, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2123272, "chapter_id": 3646, "verse_number": "२५", "content_sanskrit": "एतच्छ्रुत्वा महान् नादः सभ्यानामुदतिष्ठत ।\nविकर्णं शंसमानानां सौबलं च विनिन्दताम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2123273, "chapter_id": 3646, "verse_number": "२६", "content_sanskrit": "तस्मिन्नुपरते शब्दे राधेयः क्रोधमूर्च्छितः ।\nप्रगृह्य रुचिरं बाहुमिदं वचनमब्रवीत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2123274, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2123275, "chapter_id": 3646, "verse_number": "२७", "content_sanskrit": "दृश्यन्ते वै विकर्णे हि वैकृतानि बहून्यनि ।\nतज्जातस्तद्विनाशाय यथाऽग्निररणीप्रजः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2123276, "chapter_id": 3646, "verse_number": "२८", "content_sanskrit": "व्याधिर्बलं नाशयते शरीरस्थोऽपि सम्भृतः ।\nतृणानि पशवो घ्नन्ति स्वपक्षं चैव कौरवः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2123277, "chapter_id": 3646, "verse_number": "२९", "content_sanskrit": "द्रोणो भीष्मः कृपो द्रौणिर्विदुरश्च महामतिः ।\nधृतराष्ट्रश्च गान्धारी भवतः प्राज्ञवत्तराः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2123278, "chapter_id": 3646, "verse_number": "३०", "content_sanskrit": "एते न किञ्चिदप्याहुश्चोद्यमानाश्च कृष्णया ।\nधर्मेण विजितां कृष्णां मन्यन्ते द्रुपदात्मजाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2123279, "chapter_id": 3646, "verse_number": "३१", "content_sanskrit": "त्वं तु केवलबाल्येन धार्तराष्ट्र वदिष्यसि ।\nयद् ब्रवीषि सभामध्ये बालः स्थविरभाषितम् ।\nन च धर्मं यथावत् त्वं वेत्सि दुर्योधनावर ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2123280, "chapter_id": 3646, "verse_number": "३२", "content_sanskrit": "यद् ब्रवीषि जितां कृष्णमजितेति सुमन्दधीः ।\nकथं ह्यविजितां कृष्णां मन्यसे धृतराष्ट्रज ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2123281, "chapter_id": 3646, "verse_number": "३३", "content_sanskrit": "यदा सभायां सर्वस्वं न्यस्तवान् पाण्डवाग्रजः ।\nअभ्यन्तरांश्च सर्वस्वं द्रौपदीं भरतर्षभः ।\nएवं धर्मजितां कृष्णां मन्यसे नजितां कथम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2123282, "chapter_id": 3646, "verse_number": "३४", "content_sanskrit": "कीर्तिता द्रौपदी वाचाऽप्यनुज्ञाता च पाण्डवैः ।\nभवत्यविजिता केन हेतुनैषा मता तव ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2123283, "chapter_id": 3646, "verse_number": "३५", "content_sanskrit": "अहं मन्ये सभामेतामानीतामेकवाससम् ।\nअधर्मेणेति तत्रापि शृणु मे वाक्यमुत्तरम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2123284, "chapter_id": 3646, "verse_number": "३६", "content_sanskrit": "एको भर्ता स्त्रियो देवैर्विहितः कुरुनन्दन ।\nइयं त्वनेकवशगा वर्धकीति विनिश्चिता ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2123285, "chapter_id": 3646, "verse_number": "३७", "content_sanskrit": "अस्याः सभायां नयनं न चित्रमिति मे मतिः ।\nएकाम्बरधरत्वं वाऽप्यथवाऽपि विवस्त्रता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2123286, "chapter_id": 3646, "verse_number": "३८", "content_sanskrit": "यच्चैषां द्रविणं किञ्चिद् या चैषा ये च पाण्डवाः ।\nसौबलेनेह तत् सर्वं धर्मेण विजितं वसु ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2123287, "chapter_id": 3646, "verse_number": "३९", "content_sanskrit": "दुश्शासन सुबालोऽयं विकर्णः प्राज्ञवादिकः ।\nपाण्डवानां च वासांसि द्रौपद्याश्चाप्युपाहर ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2123288, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2123289, "chapter_id": 3646, "verse_number": "४०", "content_sanskrit": "तच्छ्रुत्वा पाण्डवाः सर्वे स्वानि वासांसि भारत ।\nअवकीर्योत्तरीयाणि सभायां समुपाविशन् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2123290, "chapter_id": 3646, "verse_number": "४१", "content_sanskrit": "ततो दुश्शासनो राजन् द्रौपद्या वसनं बलात् ।\nसभामध्ये समाक्षिप्य व्यपाक्रष्टुं प्रचक्रमे ।\nआकृष्यमाणे वसने विललाप सुदुःखिता ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2123291, "chapter_id": 3646, "verse_number": "४२", "content_sanskrit": "ज्ञातं मया वसिष्ठेन पुरा गीतं महात्मना ।\nमहत्यापदि सम्प्राप्ते स्मर्तव्यो भगवान् हरिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2123292, "chapter_id": 3646, "verse_number": "समाप्तिः", "content_sanskrit": "इति निश्चित्य मनसा शरणागतवत्सलम् ।\nमनसा चिन्तयामास देवं नारायणं प्रभुम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2123293, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2123294, "chapter_id": 3646, "verse_number": "४४", "content_sanskrit": "शङ्खचक्रगदापाणे द्वारकानिलयाच्युत ।\nगोविन्द पुण्डरीकाक्ष रक्ष मां शरणागताम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2123295, "chapter_id": 3646, "verse_number": "४५", "content_sanskrit": "हा कृष्ण द्वारकावासिन् क्वासि यादवनन्दन ।\nइमामवस्थां सम्प्राप्तामनाथां किमुपेक्षसे ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2123296, "chapter_id": 3646, "verse_number": "४६", "content_sanskrit": "गोविन्द द्वारकावासिन् कृष्ण गोपीजनप्रिय ।\nकौरवैः परिभूतां मां किं न जानासि केशव ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2123297, "chapter_id": 3646, "verse_number": "४७", "content_sanskrit": "हे नाथ हे रमानाथ व्रजनाथार्तिनाशन ।\nकौरवार्णवमग्नं मामुद्धरस्व जनार्दन ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2123298, "chapter_id": 3646, "verse_number": "४८", "content_sanskrit": "कृष्ण कृष्ण महायोगिन् विश्वात्मन् विश्वभावन ।\nप्रपन्नां पाहि गोविन्द कुरुमध्येऽवसीदतीम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2123299, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2123300, "chapter_id": 3646, "verse_number": "४९", "content_sanskrit": "इत्यनुस्मृत्य कृष्णा सा हरिं त्रिभुवनेश्वरम् ।\nप्रारुदद् दुःखिता राजन् मुखमाच्छाद्य भामिनी ।\nयाज्ञसेन्या वचः श्रुत्वा कृष्णाङ्गं परितोऽभवत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2123301, "chapter_id": 3646, "verse_number": "५०", "content_sanskrit": "कृष्णं च विष्णुं च हरिं नरं च\nत्राणाय विक्रोशति याज्ञसेनी ।\nततस्तु हरिस्त्वन्तरितो महात्मा\nसमावृणोत् तां विविधैर्वस्त्रपूगैः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2123302, "chapter_id": 3646, "verse_number": "५१", "content_sanskrit": "आकृष्यमाणे वसने द्रौपद्याश्च विशाम्पते ।\nतद्रूपमपरं वस्त्रं प्रादुरासीदनेकशः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2123303, "chapter_id": 3646, "verse_number": "५२", "content_sanskrit": "नानारागविरागाणि वसनान्यथ वै प्रभो ।\nप्रादुर्भवन्ति शतशः कृष्णस्य परिपालनात् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2123304, "chapter_id": 3646, "verse_number": "५३", "content_sanskrit": "ततो हलहलाशब्दः तत्रासीद् घोरनिस्स्वनः ।\nतदद्भुततमं लोके प्रेक्ष्य सर्वे सभासदः ।\nधिग्धिगित्यनिशं वाच उत्सृजन् कौरवं प्रति ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2123305, "chapter_id": 3646, "verse_number": "५४", "content_sanskrit": "यदा तु वाससां राशिः सभामध्ये समास्थितः ।\nततो दुश्शासनः श्रान्तो व्रीळितः समुपाविशत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2123306, "chapter_id": 3646, "verse_number": "५५", "content_sanskrit": "शशाप तत्र भीमस्तु राजमध्ये महास्वरः ।\nक्रोधाद् विष्फुरमाणोष्ठो विनिष्पिष्य करे करम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2123307, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2123308, "chapter_id": 3646, "verse_number": "५६", "content_sanskrit": "इदं मे वाक्यमादध्वं क्षत्रिया लोकवासिनः ।\nनोक्तपूर्वं नरैरन्यैर्न चान्यो यद् वदिष्यति ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2123309, "chapter_id": 3646, "verse_number": "५७", "content_sanskrit": "यद्येतदेवमुक्त्वा तु न कुर्यां पृथिवीश्वराः ।\nपितामहानां सर्वेषां नाहं गतिमवाप्नुयाम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2123310, "chapter_id": 3646, "verse_number": "५८", "content_sanskrit": "अस्य पापस्य दुर्जातेर्भारतापशदस्य च ।\nन पिबेयं बलाद् वक्षो भित्त्वा चेद्रुधिरं रणे ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2123311, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2123312, "chapter_id": 3646, "verse_number": "५९", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सर्वलोकप्रहर्षणम् ।\nप्रचक्रुर्बहुलां पूजां कुत्सन्तो धृतराष्ट्रजम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2123313, "chapter_id": 3646, "verse_number": "६०", "content_sanskrit": "धिग्धिक्शब्दस्ततस्तत्र समभूद् रोमहर्षणः ।\nसभ्यानां नरदेवानां दृष्ट्वा कुन्तीसुतांस्तदा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2123314, "chapter_id": 3646, "verse_number": "६१", "content_sanskrit": "न ब्रुवन्ति हि कौरव्याः प्रश्नमेतमिति स्म ह ।\nसज्जनः क्रोशति स्मात्र धृतराष्ट्रं विगर्हयन् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2123315, "chapter_id": 3646, "verse_number": "६२", "content_sanskrit": "ततो बाहू समुद्धृत्य निवार्य च सभासदः ।\nविदुरः सर्वधर्मज्ञ इदं वचनमब्रवीत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2123316, "chapter_id": 3646, "verse_number": "६३", "content_sanskrit": "द्रौपदी प्रश्नमुक्त्वैवं रोरवीति ह्यनाथवत् ।\nन च विब्रूत तं प्रश्नं सभ्या धर्मोऽत्र पीड्यते ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2123317, "chapter_id": 3646, "verse_number": "६४", "content_sanskrit": "सभां प्रपद्यते प्रश्नः प्रज्वलन्निव हव्यवाट् ।\nतं वै सत्येन धर्मेण सभ्याः प्रशमयन्त्युत ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2123318, "chapter_id": 3646, "verse_number": "६५", "content_sanskrit": "धर्म्मप्रश्नमथो ब्रूयादेतत् सत्येन मानवः ।\nन ब्रूयुश्च ततः प्रश्नं कामक्रोधवशानुगाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2123319, "chapter_id": 3646, "verse_number": "६६", "content_sanskrit": "विकर्णेन यथाप्रश्नं पूर्वमुक्तं नराधिपाः ।\nभवन्तोऽपि हि तं प्रश्नं विब्रुवन्तु यथामति ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2123320, "chapter_id": 3646, "verse_number": "६७", "content_sanskrit": "यो हि प्रश्नं न विब्रूयाद् धर्मदर्शी सभां गतः ।\nअनृते या फलप्राप्तिस्तस्याः सोऽर्धं समश्नुते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2123321, "chapter_id": 3646, "verse_number": "६८", "content_sanskrit": "यः पुनर्वितथं ब्रूयाद् धर्मदर्शी सभां गतः ।\nअनृतस्य फलं कृत्स्नं प्राप्नोतीति विनिश्चयः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2123322, "chapter_id": 3646, "verse_number": "६९", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nप्रह्लादस्य च संवादं मुनेराङ्गिरसस्य च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2123323, "chapter_id": 3646, "verse_number": "७०", "content_sanskrit": "प्रह्लादो नाम दैत्येन्द्रस्तस्य पुत्रो विरोचनः\nकन्याहेतोराङ्गिरसं सुधन्वानमुपाद्रवत् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2123324, "chapter_id": 3646, "verse_number": "७१", "content_sanskrit": "अहं ज्यायानहं ज्यायानिति कन्येप्सया तदा ।\nतयोर्देवनमत्रासीत् प्राणयोरिति नः श्रुतम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2123325, "chapter_id": 3646, "verse_number": "७२", "content_sanskrit": "तयोः प्रश्नविवादोऽभूत् प्रह्लादं तावपृच्छताम् ।\nज्यायान् क आवयोरेकः प्रश्नं प्रब्रूहि मा मृषा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2123326, "chapter_id": 3646, "verse_number": "७३", "content_sanskrit": "स वै विवदानाद्भीतः सुधन्वानं व्यलोकयत् ।\nतं सुधन्वाऽब्रवीत् क्रुद्धो ब्रह्मदण्ड इव ज्वलन् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2123327, "chapter_id": 3646, "verse_number": "७४", "content_sanskrit": "यदि वै वक्ष्यसि मृषा प्रह्लादाथ न वक्ष्यसि ।\nशतधा ते शिरो वज्री वज्रेण प्रहरिष्यति ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2123328, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2123329, "chapter_id": 3646, "verse_number": "७५", "content_sanskrit": "सुधन्वना तथोक्तः सन् व्यथितोऽश्वत्थपर्णवत् ।\nजगाम काश्यपं दैत्यो धृतराष्ट्र महौजसम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2123330, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "प्रह्लादः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2123331, "chapter_id": 3646, "verse_number": "७६", "content_sanskrit": "त्वं वै धर्मस्य विज्ञाता दैवस्येहासुरस्य च ।\nब्राह्मणस्य महाप्राज्ञ धर्मकृच्छ्रमिदं शृणु ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2123332, "chapter_id": 3646, "verse_number": "७७", "content_sanskrit": "यो हि प्रश्नं न विब्रूयाद् वितथं वा विनिर्दिशेत् ।\nके च तस्य परे लोकास्तन्ममाचक्ष्व पृच्छतः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2123333, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "काश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2123334, "chapter_id": 3646, "verse_number": "७८", "content_sanskrit": "जानन्नविब्रुवन् पृष्टः कामात् क्रोधाद् भयात् तथा ।\nसहस्रं वारुणान् पाशान् आत्मनि प्रतिमुञ्चति ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2123335, "chapter_id": 3646, "verse_number": "७९", "content_sanskrit": "साक्षी च विब्रुवन् साक्ष्यं गोकर्णशिथिलं चरन् ।\nसहस्रं वारुणान् पाशान् आत्मनि प्रतिमुञ्चति ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2123336, "chapter_id": 3646, "verse_number": "८०", "content_sanskrit": "तस्य संवत्सरे पूर्णे पाश एकः प्रमुच्यते ।\nतस्मात् सत्यं हि वक्तव्यं जानता सत्यमञ्जसा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2123337, "chapter_id": 3646, "verse_number": "८१", "content_sanskrit": "विद्धो धर्मो ह्यधर्मेण सभां यत्रोपपद्यते ।\nन चास्य शल्यं कृन्तन्ति विद्धाः सर्वे सभासदः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2123338, "chapter_id": 3646, "verse_number": "८२", "content_sanskrit": "अर्धं भजति वै श्रेष्ठः पादो भवति कर्तृषु ।\nपादश्चैकः सभासत्सु ये न निन्दन्ति निन्दितम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2123339, "chapter_id": 3646, "verse_number": "८३", "content_sanskrit": "अनेना भवति श्रेष्ठो मुच्यन्ते च सभासदः ।\nएनो गच्छति कर्तारं निन्दार्हो यत्र निन्द्यते ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2123340, "chapter_id": 3646, "verse_number": "८४", "content_sanskrit": "वितथं तु वदेयुर्ये धर्मं प्रह्लाद पृच्छते ।\nइष्टापूर्तं च ते घ्नन्ति सप्त चैव परावरान् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2123341, "chapter_id": 3646, "verse_number": "८५", "content_sanskrit": "हृतकन्यस्य च यद् दुःखं मृतपुत्रस्य चापि यत् ।\nवैरिणा प्रतिपन्नस्य राज्ञा ग्रस्तस्य चापि यत् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2123342, "chapter_id": 3646, "verse_number": "८६", "content_sanskrit": "स्त्रियाः पत्या विहीनायाः स्वार्थाद् भ्रष्टस्य चैव यत् ।\nअध्यूढायाश्च यद् दुःखं साक्षिभिर्विहतस्य च ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2123343, "chapter_id": 3646, "verse_number": "८७", "content_sanskrit": "एतानि वै समान्याहुर्दुःखानि त्रिदशेश्वराः\nतानि दुःखानि सर्वाणि प्राप्नोति वितथं ब्रुवन् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2123344, "chapter_id": 3646, "verse_number": "८८", "content_sanskrit": "समक्षं दर्शनात् साक्ष्यं श्रवणाच्चेति धारणात् ।\nतस्मात् सत्यं ब्रुवन् साक्षी धर्मार्थाभ्यां न हीयते ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2123345, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2123346, "chapter_id": 3646, "verse_number": "८९", "content_sanskrit": "काश्यपस्य वचः श्रुत्वा प्रह्लादः पुत्रमब्रवीत् ।\nश्रेयान् सुधन्वा त्वत्तो वै मत्तः श्रेयांस्तथाऽङ्गिराः ।\nमाता सुधन्वनश्चैव श्रेयसी मातृतस्तव ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2123347, "chapter_id": 3646, "verse_number": "९०", "content_sanskrit": "विरोचन सुधन्वाऽयं प्राणानामीश्वरस्तव ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2123348, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "सुधन्वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2123349, "chapter_id": 3646, "verse_number": "९१", "content_sanskrit": "पुत्रस्नेहं परित्यज्य यस्त्वं धर्मे व्यवस्थितः ।\nअनुजानामि ते पुत्रं जीवत्वेष शतं समाः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2123350, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2123351, "chapter_id": 3646, "verse_number": "९२", "content_sanskrit": "एवं वै परमं धर्मं श्रुत्वा सर्वे सभासदः ।\nयथाप्रश्नं च कृष्णाया मन्यध्वं तत्र किं परम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2123352, "chapter_id": 3646, "verse_number": "९३", "content_sanskrit": "विदुरस्य वचः श्रुत्वा नोचुः किञ्चन पार्थिवाः ।\nकर्णो दुश्शासनं प्राह कृष्णां दासीं गृहं नय ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2123353, "chapter_id": 3646, "verse_number": "९४", "content_sanskrit": "तां वेपमानां सव्रीडां लोकयन्तीं च पाण्डवान् ।\nदुश्शासनः सभामध्ये विचकर्ष तपस्विनीम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2123354, "chapter_id": 3646, "verse_number": "२०", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां सभापर्वणि\nअष्टाशीतितमोऽध्यायः ॥८८॥\n॥ द्यूतपर्वणि विंशोऽध्यायः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2123355, "chapter_id": 3646, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}]