[{"id": 2053509, "chapter_id": 2181, "verse_number": "७-१०८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2053510, "chapter_id": 2181, "verse_number": "७-१०८-१", "content_sanskrit": "द्रौपदेयान्महेष्वासान्सौमदत्तिर्महायशाः।\nएकैकं पञ्चभिर्विद्व्वा पुनर्विव्याध सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2053511, "chapter_id": 2181, "verse_number": "७-१०८-२", "content_sanskrit": "ते पीडिता भृशं तेन रौद्रेण सहसा विभो।\nप्रमूढा नैव विविदुर्मृधे कृत्यं स्म किंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2053512, "chapter_id": 2181, "verse_number": "७-१०८-३", "content_sanskrit": "नाकुलिश्च शतानीकः सौमदत्तिं नरर्षभम्।\nद्वाभ्यां विद्व्वाऽनदद्वृष्टः शराभ्यां शत्रुकर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2053513, "chapter_id": 2181, "verse_number": "७-१०८-४", "content_sanskrit": "तथेतरे रणे यत्तास्त्रिभिस्त्रिभिरजिह्मगैः।\nविव्यधुः समरे तूर्णं सौमदत्तिममर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2053514, "chapter_id": 2181, "verse_number": "७-१०८-५", "content_sanskrit": "स तान्प्रति महाराज पञ्च चिक्षेप सायकान्।\nएकैकं हृदि चाजघ्ने एकैकेन महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2053515, "chapter_id": 2181, "verse_number": "७-१०८-६", "content_sanskrit": "ततस्ते भ्रातरः पञ्च शरैर्विद्धा महात्मना।\nपरिवार्य रणे वीरं विव्यधुः सायकैर्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2053516, "chapter_id": 2181, "verse_number": "७-१०८-७", "content_sanskrit": "अर्जुनिस्तु हयांस्तस्य चतुर्भिर्निशितैः शरैः।\nप्रेषयामास सङ्क्रुद्धो यमस्य सदनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2053517, "chapter_id": 2181, "verse_number": "७-१०८-८", "content_sanskrit": "भैमसेनिर्धनुश्छित्त्वा सौमदत्तेर्महात्मनः।\nननाद बलवन्नादं विव्याध च शितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2053518, "chapter_id": 2181, "verse_number": "७-१०८-९", "content_sanskrit": "यौधिष्ठिरिर्ध्वजं तस्य च्छित्त्वा भूमावपातयत्।\nनाकुलिश्चाथ यन्तारं रथनीडादपाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2053519, "chapter_id": 2181, "verse_number": "७-१०८-१०", "content_sanskrit": "साहदेविस्तु तं ज्ञात्वा भ्रातृभिर्विमुखीकृतम्।\nक्षुरप्रेण शिरो राजन्निचकर्त महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2053520, "chapter_id": 2181, "verse_number": "७-१०८-११", "content_sanskrit": "तच्छिरो न्यपतद्भूतौ तपनीयविभूषितम्।\nअभासयद्रुणोद्देशं बालसूर्यसमप्रभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2053521, "chapter_id": 2181, "verse_number": "७-१०८-१२", "content_sanskrit": "सौमदत्तेः शिरो दृष्ट्वा निपतत्तन्महात्मनः।\nवित्रस्तास्तावका राजन्प्रदुद्रुवुरनेकधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2053522, "chapter_id": 2181, "verse_number": "७-१०८-१३", "content_sanskrit": "अलम्बुसस्तु समरे भीमसेनं महाबलम्।\nयोधयामस सङ्क्रुद्धो लक्ष्मणं रावणिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2053523, "chapter_id": 2181, "verse_number": "७-१०८-१४", "content_sanskrit": "सम्प्रयुद्धौ रमे दृष्ट्वा तावुभौ नरराक्षसौ।\nविस्मयः सर्वभूतानां भयं चासीत्सुदारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2053524, "chapter_id": 2181, "verse_number": "७-१०८-१५", "content_sanskrit": "आर्श्यशृङ्गिं ततो भीमो नवभिर्निशितैः शरैः।\nविव्याध प्रहसन्राजन्राक्षसेन्द्रममर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2053525, "chapter_id": 2181, "verse_number": "७-१०८-१६", "content_sanskrit": "तद्रक्षः समरे विद्धं कृत्वा नादं भयावहम्।\nअभ्यद्रवत्ततो भीमं ये च तस्य पदानुगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2053526, "chapter_id": 2181, "verse_number": "७-१०८-१७", "content_sanskrit": "स भीमं पञ्छभिर्विद्व्वा शरैः सन्नतपर्वभिः।\nभैमान्परिजघानाशु रथांस्त्रिशतमाहवे।\nपुनश्चतुःशतान्हत्वा भीमं विव्याध पत्रिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2053527, "chapter_id": 2181, "verse_number": "७-१०८-१८", "content_sanskrit": "सोऽतिविद्धस्तथा भीमो राक्षसेन महाबलः।\nनिषसाद रथोपस्थे मूर्च्छयाऽभिपरिप्लुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2053528, "chapter_id": 2181, "verse_number": "७-१०८-१९", "content_sanskrit": "प्रतिलभ्य ततः संज्ञां मारुतिः क्रोधमूर्च्छितः।\nविकृष्य कार्मुकं घोरं भारसाधनमुत्तमम्।\nअलम्बुसं शरैस्तीक्ष्णैरर्दयामास सर्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2053529, "chapter_id": 2181, "verse_number": "७-१०८-२०", "content_sanskrit": "स विद्धो बहुभिर्बाणैर्नीलाञ्जनचयोपमः।\nशुशुभे सर्वतो राजन्प्रफुल्ल इव किंशुकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2053530, "chapter_id": 2181, "verse_number": "७-१०८-२१", "content_sanskrit": "स वध्यमानः समरे भीमचापच्युतैः शरैः।\nस्मरन्भ्रातृवधं चैव पाण्डवेन महात्मना।\nघोरं रूपमथो कृत्वा भीमसेनमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2053531, "chapter_id": 2181, "verse_number": "७-१०८-२२", "content_sanskrit": "तिष्ठेदानीं रणे पार्थ पश्य मेऽद्य पराक्रमम्॥\nबाको नाम सुदुर्बुद्धे राक्षसप्रवरो बली।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2053532, "chapter_id": 2181, "verse_number": "७-१०८-२३", "content_sanskrit": "परोक्षं मम तद्वृत्तं यद्धाता मे हतस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2053533, "chapter_id": 2181, "verse_number": "७-१०८-२४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2053534, "chapter_id": 2181, "verse_number": "७-१०८-२४", "content_sanskrit": "एवमुक्त्वा ततो भीममन्तर्धानं गतस्तदा।\nमहता शरवर्षेण भृशं तं समवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2053535, "chapter_id": 2181, "verse_number": "७-१०८-२५", "content_sanskrit": "भीमस्तु समरे राजन्नदृश्ये राक्षसे तदा।\nआकाशं पूरयामास शरैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2053536, "chapter_id": 2181, "verse_number": "७-१०८-२६", "content_sanskrit": "स वध्यमानो भीमेन निमेषाद्रथमास्थितः।\nजगाम धरणीं चैव क्षुद्रः खं सहसाऽगमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2053537, "chapter_id": 2181, "verse_number": "७-१०८-२७", "content_sanskrit": "उच्चावचानि रूपाणि चकार सुबहूनि च।\nअणुर्बृहत्पुनः स्थूलो नादान्मुञ्चन्निवाम्बुदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2053538, "chapter_id": 2181, "verse_number": "७-१०८-२८", "content_sanskrit": "[निपेतुर्गगनाचत्चैव शरधाराः सहस्रशः।\nशक्तयः कणपाः प्रासाः शूलपट्टसतोमराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2053539, "chapter_id": 2181, "verse_number": "७-१०८-२९", "content_sanskrit": "शतघ्न्यः परिघाश्चैव भिण़्डिपालाः परश्वथाः।\nशिलाः खङ्घा गुडाश्चैव ऋष्टीर्वज्राणि चैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2053540, "chapter_id": 2181, "verse_number": "७-१०८-३०", "content_sanskrit": "सा राक्षसविसृष्टा तु शस्त्रवृष्टिः सुदारुणा।\nजघान पाण्डुपुत्रस्य सैनिकान्रणमूर्धनि॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2053541, "chapter_id": 2181, "verse_number": "७-१०८-३१", "content_sanskrit": "उच्चावचास्तथा वाचो व्याजहार समन्ततः।\nतेन पाण्डवसैन्यानां सूदिता युधि वारणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2053542, "chapter_id": 2181, "verse_number": "७-१०८-३२", "content_sanskrit": "हयाश्च बहवो राजन्पत्तयश्च तथा पुनः।\nरथेभ्यो रथिनः पेतुस्तस्य नुन्नाः स्म सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2053543, "chapter_id": 2181, "verse_number": "७-१०८-३३", "content_sanskrit": "शोणितोदां रथावर्तां हस्तिग्राहसमाकुलाम्।\nछत्रहंसां कर्दमिनीं बाहुपन्नगसङ्कुलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2053544, "chapter_id": 2181, "verse_number": "७-१०८-३४", "content_sanskrit": "नदीं प्रवर्तयामास रक्षोगणसमाकुलाम्।\nवहन्तीं बहुधा राजंश्चेदिपाञ्चालसृञ्जयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2053545, "chapter_id": 2181, "verse_number": "७-१०८-३५", "content_sanskrit": "तं तथा समरे राजन्विचरन्तमभीतवत्।\nपाण्डवा भृशसंविग्नाः प्रापश्यंस्तस्य विक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2053546, "chapter_id": 2181, "verse_number": "७-१०८-३६", "content_sanskrit": "तावकानां तु सैन्यानां प्रहर्षः समजायत।\nवादित्रनिनदश्चोग्रः सुमहान्रोमहर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2053547, "chapter_id": 2181, "verse_number": "७-१०८-३७", "content_sanskrit": "तं श्रुत्वा निनदं घोरं तव सैन्यस्य पाण्डवः।\nनामृष्यत यथा नागस्तलशब्दं समीरितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2053548, "chapter_id": 2181, "verse_number": "७-१०८-३८", "content_sanskrit": "ततः क्रोधाभिताम्राक्षो निर्दहन्निव पावकः।\nसन्दधे त्वाष्ट्रमस्त्रं स स्वयं त्वष्टेव मारुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2053549, "chapter_id": 2181, "verse_number": "७-१०८-३९", "content_sanskrit": "ततः शरसहस्राणि प्रादुरासन्समन्ततः।\nतैः शरैस्तव सैन्यस्य विद्रवः सुमहानभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2053550, "chapter_id": 2181, "verse_number": "७-१०८-४०", "content_sanskrit": "तदस्त्रं प्रेरितं तेन भीमसेनेन संयुगे।\nराक्षसस्य महामायां हत्वा राक्षसमार्दयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2053551, "chapter_id": 2181, "verse_number": "७-१०८-४१", "content_sanskrit": "स वध्यमानो बहुधा भीमसेनेन राक्षसः।\nसन्त्यज्य समरे भीमं द्रोणानीकमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2053552, "chapter_id": 2181, "verse_number": "७-१०८-४२", "content_sanskrit": "तस्मिंस्तु निर्जिते राजन्राक्षसेन्द्रे महात्मना।\nअनादयन्सिंहनादैः पाण्डवाः सर्वतो दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2053553, "chapter_id": 2181, "verse_number": "७-१०८-४३", "content_sanskrit": "अपूजयन्मारुतिं च संहृष्टास्ते महाबलम्।\nप्रहादमिव दैतेया यथा शक्रं मरुद्गणाः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2053554, "chapter_id": 2181, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे अष्टाधिकशततमोऽध्यायः॥ १०८ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१०८-१२ सौमदत्तेः शलस्य॥ ५-१०८-२७ बृहत् बृहन्॥ ५-१०८-२८ कुण्डलितः पाठो ङ. झ.ञ. पुस्तकेषु दृश्यते॥ ५-१०८-२९ ऋष्टीः ऋष्टयः॥ ५-१०८-१०८ अष्टाधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]