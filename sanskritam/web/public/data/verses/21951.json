[{"id": 7001951000, "chapter_id": 21951, "verse_number": "१३०-१", "content_sanskrit": "दमचरितवर्णनम् ।\nमार्कण्डेय उवाच ।\nनरिष्यन्तस्य तनयो दुष्टारिदमनो दमः ।\nशक्रस्येव बलं तस्य दयाशीलं मुनेरिव ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001951001, "chapter_id": 21951, "verse_number": "१३०-२", "content_sanskrit": "बाभ्रव्यामिन्द्रसेनायां जज्ञे तस्य भूभृतः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001951002, "chapter_id": 21951, "verse_number": "१३०-३", "content_sanskrit": "नववर्षाणि जठरे स्थित्वा मार्तुर्महायशाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001951003, "chapter_id": 21951, "verse_number": "१३०-४", "content_sanskrit": "यद्ग्राहयामास दम मातरं जठरे स्थितः ।\nदमशीलश्च भविता यतश्चायं नृपात्मजः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001951004, "chapter_id": 21951, "verse_number": "१३०-५", "content_sanskrit": "ततस्त्रिकालविज्ञानः स हि तस्य पुरोहितः ।\nदम इत्यकरोन्नाम नरिष्यन्तसुतस्य तु ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001951005, "chapter_id": 21951, "verse_number": "१३०-६", "content_sanskrit": "स दत्तो राजपुत्रस्तु धनुर्वेदमशेषतः ।\nजगृहे सुरराजस्य सकाशाद्वृषपर्वणः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001951006, "chapter_id": 21951, "verse_number": "१३०-७", "content_sanskrit": "दुन्दुभेर्दैत्यवर्यस्य तपोवननिवासिनः ।\nसकाशाज्जगृहे कृत्स्नमस्त्रग्रामं च तत्त्वतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001951007, "chapter_id": 21951, "verse_number": "१३०-८", "content_sanskrit": "शक्तेः सकाशाद्वेदाश्च वेदाङ्गान्यखिलानि च ।\nतथार्ष्टिषेणाद्राजर्षेर्जगृहे योगमात्मवान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001951008, "chapter_id": 21951, "verse_number": "१३०-९", "content_sanskrit": "तं सुरूपं महात्मानं गृहीतास्त्रं महाबलम् ।\nस्वयंवरे कृता पित्रा जगृहे सुमना पतिम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001951009, "chapter_id": 21951, "verse_number": "१३०-१०", "content_sanskrit": "सुता दशार्णाधिपतेर्बलिनश्चारुवर्मणः ।\nपश्यतां सर्वभूतानां ये तदर्थमुपागताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001951010, "chapter_id": 21951, "verse_number": "१३०-११", "content_sanskrit": "तस्यां च सानुरागोऽभून्मद्रराजस्य वै सुतः ।\nसुमनायां महानन्दो महाबलपराक्रमः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001951011, "chapter_id": 21951, "verse_number": "१३०-१२", "content_sanskrit": "तथा विदर्भाधिपतेः पुत्रः संक्रन्दनस्य च ।\nवपुष्मान्राजपुत्रश्च महाधनुरुदारधीः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001951012, "chapter_id": 21951, "verse_number": "१३०-१३", "content_sanskrit": "ते तदा तं वृतं दृष्ट्वा दुष्टारिदमनं दमम् ।\nमन्त्रयामासुरन्योऽन्यं तत्रानङ्गविमोहिताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001951013, "chapter_id": 21951, "verse_number": "१३०-१४", "content_sanskrit": "एतामस्य बलात्कन्यां गृहीत्वा रूपशालिनीम् ।\nगृहं प्रयामस्तस्येयमस्माकं यं ग्रहीष्यति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001951014, "chapter_id": 21951, "verse_number": "१३०-१५", "content_sanskrit": "भर्तृबुद्ध्या वरारोहा स्वयंवरविधानतः ।\nतस्येच्छया नो भवित्री भार्या धर्मोपपादिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001951015, "chapter_id": 21951, "verse_number": "१३०-१६", "content_sanskrit": "अथ नेच्छति सा कञ्चिदस्माकं मदिरेक्षणा ।\nततस्तस्य भवित्री सा यो दमं घातयिष्यति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001951016, "chapter_id": 21951, "verse_number": "१३०-१७", "content_sanskrit": "मार्कण्डेय उवाच ।\nइति ते निश्चयं कृत्वा त्रयः पार्थिवनन्दनाः ।\nजगृहुस्तां सुचार्वङ्गीं दमपार्श्वानुवर्त्तिनीम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001951017, "chapter_id": 21951, "verse_number": "१३०-१८", "content_sanskrit": "ततः केचिन्नृपास्तेषां ये तत्पक्षा विचुक्रुशुः ।\nचुक्रुशुश्चापरे भूपाः केचिन्मध्यस्थतां गताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001951018, "chapter_id": 21951, "verse_number": "१३०-१९", "content_sanskrit": "ततो दमस्तान्भूपालानवलोक्य समन्ततः ।\nअनाकुलमना वाक्यमिदमाह महामुने ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001951019, "chapter_id": 21951, "verse_number": "१३०-२०", "content_sanskrit": "दम उवाच ।\nभो भूपा धर्मकृत्येषु यद्वदन्ति स्वयंवरम् ।\nदशार्णपतिना भूपाः कृते धर्म्ये स्वयंवरे ।\nअधर्मो वाऽथ वा धर्मो यदेभिर्गृह्यते बलात् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001951020, "chapter_id": 21951, "verse_number": "१३०-२१", "content_sanskrit": "यद्यधर्मो न मे कार्यमन्यभार्या भविष्यति ।\nधर्मो वा तदलं प्राणैर्ये रक्ष्यन्तेऽरिलङ्घने ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001951021, "chapter_id": 21951, "verse_number": "१३०-२२", "content_sanskrit": "ततो दशार्णाधिपतिश्चारुवर्मा नराधिपः ।\nनिःशब्दं कारयित्वा तत्सदः प्राह महामुने ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001951022, "chapter_id": 21951, "verse_number": "१३०-२३", "content_sanskrit": "दमेन यदिदं प्रोक्तं धर्माधर्माश्रितं नृपाः ।\nतद्वदध्वं यथा धर्मो ममास्य च न लुप्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001951023, "chapter_id": 21951, "verse_number": "१३०-२४", "content_sanskrit": "मार्कण्डेय उवाच ।\nततः केचिन्महीपालास्तमूचुर्वसुधाधिपम् ।\nपरस्परानुरागेण गान्धर्वो विहितो विधिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001951024, "chapter_id": 21951, "verse_number": "१३०-२५", "content_sanskrit": "क्षत्रियाणां परमयं न विट्शूद्रद्विजन्मनाम् ।\nदममाश्रित्य निष्पन्नः स चास्या दुहितुस्तव ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001951025, "chapter_id": 21951, "verse_number": "१३०-२६", "content_sanskrit": "इति धर्माद्दमस्यैषा दुहिता तव पार्थिव ।\nयोऽन्यथा वर्त्तते मोहात्कामात्मा सम्प्रवर्त्तते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001951026, "chapter_id": 21951, "verse_number": "१३०-२७", "content_sanskrit": "तथाऽपरे तदा प्रोचुर्महात्मानो हि भूभृताम् ।\nपक्षे ये भूभृतो विप्र दशार्णाधिपतिं वचः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001951027, "chapter_id": 21951, "verse_number": "१३०-२८", "content_sanskrit": "मोहात्किमाहुर्धर्मोऽयं गान्धर्वं क्षत्रजन्मनः ।\nन त्वेष शास्ता नान्यो हि राक्षसः शस्त्रजीविनाम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001951028, "chapter_id": 21951, "verse_number": "१३०-२९", "content_sanskrit": "बलादिमां यो हरति हत्वा तु परिपन्थिनः ।\nतस्यैषा स्याद्राक्षसेन विवाहेनावनीश्वराः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001951029, "chapter_id": 21951, "verse_number": "१३०-३०", "content_sanskrit": "प्रधानतर एषोऽत्र विवाहद्वितये मतः ।\nक्षत्रियाणामतो धर्मा महानन्दादिभिः कृतः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001951030, "chapter_id": 21951, "verse_number": "१३०-३१", "content_sanskrit": "मार्कण्डेय उवाच ।\nअथ प्रोचुः पुनर्भूपा यैः पूर्वमुदितो नृपः ।\nपरस्परानुरागेण जातिधर्माश्रितं वचः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001951031, "chapter_id": 21951, "verse_number": "१३०-३२", "content_sanskrit": "सत्यं शस्तो राक्षसोऽपि क्षत्रियाणां परो विधिः ।\nकिन्त्वसौ जनकस्वाम्ये कुमार्यानुमतो वरः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001951032, "chapter_id": 21951, "verse_number": "१३०-३३", "content_sanskrit": "हत्वा तु पितृसम्बन्धं बलेन ह्रियते हि या ।\nस राक्षसो विधिः प्रोक्तो नात्र भर्तृकरे स्थिता ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001951033, "chapter_id": 21951, "verse_number": "१३०-३४", "content_sanskrit": "पश्यतां सर्वभूपानामनया यद्वृतो दमः ।\nगान्धर्वस्येह निष्पत्तौ विवाहो राक्षसोऽत्र कः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001951034, "chapter_id": 21951, "verse_number": "१३०-३५", "content_sanskrit": "विवाहितायाः कन्यायाः कन्यात्वं नैव विद्यते ।\nकन्यायाश्च विवाहेन सम्बन्धः पृथिवीश्वराः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001951035, "chapter_id": 21951, "verse_number": "१३०-३६", "content_sanskrit": "त इमे ये बलादेनां दमादादातुमुद्यताः ।\nबलिनस्ते यदि ततः कुर्वन्तु न तु साधु तत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001951036, "chapter_id": 21951, "verse_number": "१३०-३७", "content_sanskrit": "मार्कण्डेय उवाच ।\nतच्छ्रुत्वाऽसौ दमः कोपकषायीकृतलोचनः ।\nआरोपयामास धनुर्वचनं चेदमब्रवीत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001951037, "chapter_id": 21951, "verse_number": "१३०-३८", "content_sanskrit": "ममापि भार्या बलिभिः पश्यतो ह्रियते यदि ।\nतत्कुलेन भुजाभ्यां वा को गुणः क्लीबजन्मनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001951038, "chapter_id": 21951, "verse_number": "१३०-३९", "content_sanskrit": "धिङ्ममास्त्राणि धिक्छौर्यं धिक्छरान्धिक्छरासनम् ।\nधिग्व्यर्थं मे कुले जन्म मरुत्तस्य महात्मनः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001951039, "chapter_id": 21951, "verse_number": "१३०-४०", "content_sanskrit": "यदि भार्यामिमे मूढाः समादाय बलान्विताः ।\nप्रयान्ति जीवतो धिक्तां मम व्यर्थमनुष्यताम् ॥३९", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001951040, "chapter_id": 21951, "verse_number": "१३०-४१", "content_sanskrit": "इत्युक्त्वा तान्महीपालान्महानन्दमुखान्बली ।\nअथाब्रवीत्तदा सर्वान्महारिदमनो दमः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001951041, "chapter_id": 21951, "verse_number": "१३०-४२", "content_sanskrit": "एषातिशोभना बाला चार्वङ्गी मदिरेक्षणा ।\nकिं तस्य जन्मना भार्या न यस्येयं कुलोद्भवा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001951042, "chapter_id": 21951, "verse_number": "१३०-४३", "content_sanskrit": "इति सञ्चिन्त्य भूपालास्तथा यतत संयुगे ।\nयथा निर्जित्य मामेतां पत्नीं कुरुत मानिनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001951043, "chapter_id": 21951, "verse_number": "१३०-४४", "content_sanskrit": "इत्याभाष्य ततस्तत्र शरवर्षममुञ्चत ।\nछादयन्पृथिवीपालांस्तमसेव महीरुहान् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001951044, "chapter_id": 21951, "verse_number": "१३०-४५", "content_sanskrit": "तेऽपि वीरा महीपालाः शरशक्त्यृष्टिमुद्गरान् ।\nमुमुचुस्तत्प्रयुक्तांश्च दमश्चिच्छेद लीलया ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001951045, "chapter_id": 21951, "verse_number": "१३०-४६", "content_sanskrit": "तेऽपि तत्प्रहितान्बाणांस्तेषां चासौ शरोत्करान् ।\nचिच्छेद पृथिवीशानां नरिष्यन्तात्मजो मुने ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001951046, "chapter_id": 21951, "verse_number": "१३०-४७", "content_sanskrit": "वर्त्तमाने तदा युद्धे दमस्य क्षितिपात्मजैः ।\nप्रविवेश महानन्दः खड्गपाणिर्यतो दमः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001951047, "chapter_id": 21951, "verse_number": "१३०-४८", "content_sanskrit": "तमायान्तं दमो दृष्ट्वा खड्गपाणिं महामृधे ।\nमुमोच शरवर्षाणि वर्षाणीव पुरन्दरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001951048, "chapter_id": 21951, "verse_number": "१३०-४९", "content_sanskrit": "तदस्त्राणि ततस्तानि शरजालानि तत्क्षणात् ।\nमहानन्दः प्रचिच्छेद खड्गेनान्यानवञ्चयत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001951049, "chapter_id": 21951, "verse_number": "१३०-५०", "content_sanskrit": "ततो रोषात्समारुह्य तं दमस्य तदा रथम् ।\nमहानन्दो महावीर्यो दमेन युयुधे सह ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001951050, "chapter_id": 21951, "verse_number": "१३०-५१", "content_sanskrit": "बहुधा युध्यमानस्य महानन्दस्य लाघवात् ।\nदमो मुमोच हदये शरं कालानलप्रभम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001951051, "chapter_id": 21951, "verse_number": "१३०-५२", "content_sanskrit": "तं लग्नमात्मनोत्कृष्य विभिन्नेन ततो हृदा ।\nदमं प्रति विचिक्षेप महानन्दोऽसिमुज्ज्वलम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001951052, "chapter_id": 21951, "verse_number": "१३०-५३", "content_sanskrit": "पतन्तं चैनमुल्काभं शक्त्या चिक्षेप तं दमः ।\nशिरो वेतसपत्रेण महानन्दस्य चाच्छिनत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001951053, "chapter_id": 21951, "verse_number": "१३०-५४", "content_sanskrit": "तस्मिन्हते महानन्दे प्राचुर्येण पराङ्मुखाः ।\nबभूवुः पार्थिवास्तस्थौ वपुष्मान्कुण्डिनाधिपः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001951054, "chapter_id": 21951, "verse_number": "१३०-५५", "content_sanskrit": "दमेन युयुधे चासौ बलगर्वमदान्वितः ।\nदाक्षिणात्यमहीपालतनयो रणगोचरः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001951055, "chapter_id": 21951, "verse_number": "१३०-५६", "content_sanskrit": "युध्यमानस्य तस्योग्रं करवालं स वै लघु ।\nचिच्छेद सारथेश्चैव शिरः संख्ये तथा ध्वजम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001951056, "chapter_id": 21951, "verse_number": "१३०-५७", "content_sanskrit": "छिन्नखड्गो गदां सोऽथ जग्राह बहुकण्टकाम् ।\nतामप्यस्य स चिच्छेद करस्थामेव सत्वरः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001951057, "chapter_id": 21951, "verse_number": "१३०-५८", "content_sanskrit": "यावदन्यत्समादत्त्ते स वपुष्मान्वरायुधम् ।\nतावच्छरेण तं विद्ध्वा दमो भूमावपातयत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001951058, "chapter_id": 21951, "verse_number": "१३०-५९", "content_sanskrit": "स पातितस्ततो भूमौ विह्वलाङ्गः सवेपथुः ।\nविनिवृत्तमतिर्युद्धाद्बभूव क्षितिपात्मजः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001951059, "chapter_id": 21951, "verse_number": "१३०-६०", "content_sanskrit": "तमालोक्य तथा भूतमयुद्धमतिमात्मवान् ।\nउत्सृज्यादाय सुमनां सुमनाः प्रययौ दमः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001951060, "chapter_id": 21951, "verse_number": "१३०-६१", "content_sanskrit": "ततो दशार्णाधिपतिः प्रीतिमानकरोत्तयोः ।\nदमस्य सुमनायाश्च विवाहं विधिपूर्वकम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001951061, "chapter_id": 21951, "verse_number": "१३०-६२", "content_sanskrit": "कृतदारो दमस्तत्र दशार्णाधिपतेः पुरे ।\nस्थित्वाऽल्पकालं प्रययौ सभार्यो निजमन्दिरम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001951062, "chapter_id": 21951, "verse_number": "१३०-६३", "content_sanskrit": "दशार्णाधिपतिश्चासौ दत्त्वा नागांस्तुरङ्गमान् ।\nरथगोऽश्वखरोष्ट्रांश्च दासीदासांस्तथा बहून् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001951063, "chapter_id": 21951, "verse_number": "१३०-६४", "content_sanskrit": "वस्त्रालङ्कारचापादि वरोपस्करमासनम् ।\nअन्यैस्तैश्च तथा भाण्डैः परिपूर्णं व्यसर्जयत् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]