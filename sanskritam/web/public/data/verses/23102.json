[{"id": 7003102000, "chapter_id": 23102, "verse_number": "४-३८-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nदर्पभङ्गः श्रुतो देवि शङ्करस्य जगद्गुरोः ।\nअधुना श्रूयतां मत्तो दुर्गादर्पविमोचनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003102001, "chapter_id": 23102, "verse_number": "४-३८-२", "content_sanskrit": "तेजसा सर्वदेवानामाविर्भूय जगत्प्रसूः ।\nदधार कामिनीरूपं कमनीयं मनोहरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003102002, "chapter_id": 23102, "verse_number": "४-३८-३", "content_sanskrit": "निहत्य दानवेन्द्रांश्च ररक्ष देवताकुलम् ।\nलेभे जन्म ततो देवी जठरे दक्षयोषितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003102003, "chapter_id": 23102, "verse_number": "४-३८-४", "content_sanskrit": "पिनाकपाणिं जग्राह सा देवी सुरसाधनम् ।\nशश्वत्परमभक्त्या च सिषेवे स्वामिनं सती ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003102004, "chapter_id": 23102, "verse_number": "४-३८-५", "content_sanskrit": "दक्षेण सार्द्धं देवेन बभूव शिवशत्रुता ।\nनिरर्थकं दैवयोगात्पुरा वै सुरसंसदि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003102005, "chapter_id": 23102, "verse_number": "४-३८-६", "content_sanskrit": "दक्षश्चकार यज्ञं च तत आगत्य कोपतः ।\nसर्वान्विज्ञापयामास तत्रैव शंकरं विना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003102006, "chapter_id": 23102, "verse_number": "४-३८-७", "content_sanskrit": "सस्त्रीका देवताः सर्वा आजग्मुर्दक्षमन्दिरम् ।\nसगणः शङ्करः कोपान्नाजगामाभिमानतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003102007, "chapter_id": 23102, "verse_number": "४-३८-८", "content_sanskrit": "सती पतिं च मोहेन बोधयामास यत्नतः ।\nन तं चालयितुं शक्ता बभूव चञ्चला स्वयम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003102008, "chapter_id": 23102, "verse_number": "४-३८-९", "content_sanskrit": "आजगाम पितुर्गेहं दर्पात्तस्य विनाऽऽज्ञया ।\nतस्य शापेन तस्याश्च दर्पभङ्गो बभूव ह ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003102009, "chapter_id": 23102, "verse_number": "४-३८-१०", "content_sanskrit": "न हि संभाषणं चक्रे वाङ्मात्रेण पिता च ताम् ।\nश्रुत्वा च निन्दां भर्तुश्च देहं तत्याज मानतः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003102010, "chapter_id": 23102, "verse_number": "४-३८-११", "content_sanskrit": "एवं प्रिये निगदितं सतीदर्पविमोचनम् ।\nतस्या जन्मान्तरं नित्यं दर्पभङ्गश्च श्रूयताम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003102011, "chapter_id": 23102, "verse_number": "४-३८-१२", "content_sanskrit": "लेभे जन्म सती शीघ्रं जठरे शैलयोषितः ।\nशिवस्तस्याश्चिताभस्म चास्थि जग्राह भक्तितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003102012, "chapter_id": 23102, "verse_number": "४-३८-१३", "content_sanskrit": "चकार मालामस्थ्नां च भस्मना तनुलेपनम् ।\nस्मारंस्मारं सतीं प्रेम्णा भ्रामंभ्रामं पुनःपुनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003102013, "chapter_id": 23102, "verse_number": "४-३८-१४", "content_sanskrit": "सुषाव मेना तां देवीमतीव सुमनोहराम् ।\nसृष्टौ विधातुस्तस्याश्च ह्युपमा नास्ति कुत्र च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003102014, "chapter_id": 23102, "verse_number": "४-३८-१५", "content_sanskrit": "गुणप्रसूर्गुणान्सर्वान्सर्वरूपान्बिभर्त्ति सा ।\nसर्वाश्च देवपत्न्यस्तत्कलां नार्हन्ति षोडशीम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003102015, "chapter_id": 23102, "verse_number": "४-३८-१६", "content_sanskrit": "बभूव वर्द्धमाना सा शुक्ले चन्द्रकला यथा ।\nअतीव यौवनस्था च शैलगेहे दिनेदिने ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003102016, "chapter_id": 23102, "verse_number": "४-३८-१७", "content_sanskrit": "बभूवाकाशवाणी च तां संबोध्य जगत्प्रसूम् ।\nशिवे शिवं च तपसा कठोरेण लभेति च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003102017, "chapter_id": 23102, "verse_number": "४-३८-१८", "content_sanskrit": "विनेश्वरं न तपसा प्राप्ता हि गर्भसम्भवम् ।\nप्रहस्य तस्थौ श्रुत्वेति सा च यौवनगर्विता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003102018, "chapter_id": 23102, "verse_number": "४-३८-१९", "content_sanskrit": "मम जन्मान्तरीयं च भस्मास्थि च बिभर्ति यः ।\nस मां प्रौढां कथं दृष्ट्वा न गृह्णात्यत्र जन्मनि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003102019, "chapter_id": 23102, "verse_number": "४-३८-२०", "content_sanskrit": "यो विदग्धश्च ब्रह्माण्डं बभ्राम मम शोकतः ।\nस कथं मां न गृह्णाति दृष्ट्वा परमसुन्दरीम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003102020, "chapter_id": 23102, "verse_number": "४-३८-२१", "content_sanskrit": "दक्षयज्ञं यो बभञ्ज मम हेतोः कृपानिधिः ।\nस कथं मां न गृह्णाति पत्नीं जन्मनिजन्मनि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003102021, "chapter_id": 23102, "verse_number": "४-३८-२२", "content_sanskrit": "या यस्य पत्नी यो यस्या भर्ता प्राक्तनतः पुरा ।\nकुतो विश्वे तयोर्भेदो निषेको नान्यथा भवेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003102022, "chapter_id": 23102, "verse_number": "४-३८-२३", "content_sanskrit": "सर्वरूपगुणाधारं मत्वा स्वमतिमानतः ।\nन चकार तपः साध्वी न विज्ञाय तमीश्वरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003102023, "chapter_id": 23102, "verse_number": "४-३८-२४", "content_sanskrit": "सुन्दरीषु च सर्वासु मत्तो नास्त्येव सुन्दरी ।\nहृदीति मत्वा गर्वेण न चकार तपः शिवा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003102024, "chapter_id": 23102, "verse_number": "४-३८-२५", "content_sanskrit": "रूपयौवनवेषाणां पुमान्ग्राही स्वयोषिताम् ।\nशिवो मच्छ्रुतिमात्रेण मां गृह्णाति विना तपः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003102025, "chapter_id": 23102, "verse_number": "४-३८-२६", "content_sanskrit": "हृदीति मत्वा गिरिजा तस्थौ हिमगिरेर्गृहे ।\nशश्वत्सहचरीमध्ये क्रीडोन्मत्ता दिवानिशम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003102026, "chapter_id": 23102, "verse_number": "४-३८-२७", "content_sanskrit": "एतस्मिन्नन्तरे तूर्णं दूतः शैलेन्द्रसंसदि ।\nउवाचागत्य मधुरं तत्पुरः संपुटाञ्जलिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003102027, "chapter_id": 23102, "verse_number": "४-३८-२८", "content_sanskrit": "दूत उवाच ।\nउत्तिष्ठोत्तिष्ठ शैलेन्द्र गच्छाक्षयवटान्तिकम् ।\nआजगाम महादेवः सगणो वृषवाहनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003102028, "chapter_id": 23102, "verse_number": "४-३८-२९", "content_sanskrit": "मधुपर्कादिकं दत्त्वा भक्तिनम्रात्मकन्धरः ।\nपूजनं कुरु शैलेन्द्रं देवेन्द्रं तमतीन्द्रियम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003102029, "chapter_id": 23102, "verse_number": "४-३८-३०", "content_sanskrit": "सिद्धिस्वरूपं सिद्धेशं योगीन्द्राणां गुरोर्गुरुम् ।\nमृत्युञ्जयं कालकालं ब्रह्मज्योतिः सनातनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003102030, "chapter_id": 23102, "verse_number": "४-३८-३१", "content_sanskrit": "परमात्मस्वरूपं च सगुणं निर्गुणं विभुम् ।\nभक्तध्यानार्थममलं दधानं देहमीश्वरम्॥ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003102031, "chapter_id": 23102, "verse_number": "४-३८-३२", "content_sanskrit": "शैलो दूतवचः श्रुत्वा समुत्तस्थौ मुदाऽन्वितः ।\nमधुपर्कादिकं नीत्वा जगाम शङ्करान्तिकम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003102032, "chapter_id": 23102, "verse_number": "४-३८-३३", "content_sanskrit": "देवी दूतवचः श्रुत्वा प्रसन्नवदनेक्षणा ।\nहृदीति मेने मद्धेतोराजगाम महेश्वरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003102033, "chapter_id": 23102, "verse_number": "४-३८-३४", "content_sanskrit": "चकार वेषमतुलं दधार वस्त्रमुत्तमम्।\nरत्नेन्द्रसारालंकारान्रत्नमालां  मनोहराम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003102034, "chapter_id": 23102, "verse_number": "४-३८-३५", "content_sanskrit": "पारिजातप्रसूनानां मालां चन्दनसंयुताम् ।\nचकार शङ्करार्थं च मत्वा मालां मनोहराम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003102035, "chapter_id": 23102, "verse_number": "४-३८-३६", "content_sanskrit": "रत्नसिंहासनस्था सा ददर्श दर्पणे मुखम् ।\nकस्तूरीबिन्दुना सार्द्धं सिन्दूरबिन्दुभूषितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003102036, "chapter_id": 23102, "verse_number": "४-३८-३७", "content_sanskrit": "आरक्त नेत्रयुगलं निर्मलाञ्जनसंयुतम्।\nशरन्मध्याह्नममलं यथालिपंक्तिवेष्टितम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003102037, "chapter_id": 23102, "verse_number": "४-३८-३८", "content_sanskrit": "सुकोमलौष्ठयुगुलं ताम्बूलरागसंयुतम्।\nअतीव सुन्दरं रम्यपक्वबिंबफलं यथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003102038, "chapter_id": 23102, "verse_number": "४-३८-३९", "content_sanskrit": "रत्नकुंडलदीप्त्या च गंडस्थलविराजितम् ।\nसूर्योदयेन ज्वलितं सुमेरुशिखरं यथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003102039, "chapter_id": 23102, "verse_number": "४-३८-४०", "content_sanskrit": "अत्यनिर्वचनीयं च दन्तपंक्तिमनोहरम् ।\nयथा मुक्तासमूहं च सजलं जलदागमे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003102040, "chapter_id": 23102, "verse_number": "४-३८-४१", "content_sanskrit": "गजमुक्तासमायुक्तं सुचारुनासिकोत्तमम् ।\nसुशोभितं यथा मेरुं स्वर्णदीजलधारया ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003102041, "chapter_id": 23102, "verse_number": "४-३८-४२", "content_sanskrit": "मालतीमाल्यसंयुक्तकबरीभारसंयुतम्। ।\nबकपंक्तिसुशोभाढ्यं नवीनं जलदं यथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003102042, "chapter_id": 23102, "verse_number": "४-३८-४३", "content_sanskrit": "तप्तकाञ्चन वर्णाभं चारुवक्षःस्थलोज्ज्वलम् ।\nरत्नेन्द्रसारहाराक्तं कस्तूरीकुङ्कुमान्वितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003102043, "chapter_id": 23102, "verse_number": "४-३८-४४", "content_sanskrit": "चारुचम्पकवर्णाभं स्तनयुग्मं मनोहरम् ।\nबदरीफलतुल्यं च चारुपत्रकशोभितम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003102044, "chapter_id": 23102, "verse_number": "४-३८-४५", "content_sanskrit": "मध्यं मनोहरं क्षीणं निम्ननाभिस्थलोज्ज्वलम्। ।\nअतीव सुन्दरं रम्यमुदरं वर्तुलाकृति ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003102045, "chapter_id": 23102, "verse_number": "४-३८-४६", "content_sanskrit": "रम्भास्तंभविनिंद्यैकमूरुयुग्मं मनोहरम् ।\nकामालयं सुकठिनं निगूढमंशुकेन  च४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003102046, "chapter_id": 23102, "verse_number": "४-३८-४७", "content_sanskrit": "स्थलपद्मप्रभामुष्टपदयुग्मं मनोहरम्। ।\nरत्नपाशकसंयुक्तं सिद्धालक्तकभूषितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003102047, "chapter_id": 23102, "verse_number": "४-३८-४८", "content_sanskrit": "दधतं रत्नमञ्जीरं राजहंसानुकारि च।\nरत्नेन्द्रसाराभरणं निर्मितं विश्वकर्मणा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003102048, "chapter_id": 23102, "verse_number": "४-३८-४९", "content_sanskrit": "करं सुकोमलतरं सुन्दरं कनकप्रभम् ।\nरत्नकङ्कणकेयूरशंखभूषणभूषितम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003102049, "chapter_id": 23102, "verse_number": "४-३८-५०", "content_sanskrit": "बिभ्रत्सद्रत्नमुकुरं लीलाकमलमुज्ज्वलम्। ।\nरत्नाङ्गुलीयमतुलं दधतं सुमनोहरम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003102050, "chapter_id": 23102, "verse_number": "४-३८-५१", "content_sanskrit": "दृष्ट्वा स्वरूपमतुलं दध्यौ शङ्करमीश्वरम् ।\nविशिष्य मनसा शश्वद्भर्तुश्चरणपङ्कजम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003102051, "chapter_id": 23102, "verse_number": "४-३८-५२", "content_sanskrit": "पितरं मातरं बन्धुं साध्वीवर्गं सहोदरम् ।\nअन्तरे सा न सस्मार किंचिदेव शिवं विना ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003102052, "chapter_id": 23102, "verse_number": "४-३८-५३", "content_sanskrit": "अथ शैलेश्वरस्तत्र ददर्श चन्द्रशेखरम् ।\nस्वर्णदीपुलिनाद्रम्यादुत्पतन्तं च सस्मितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003102053, "chapter_id": 23102, "verse_number": "४-३८-५४", "content_sanskrit": "दधतं संस्कृतां मालां जपन्तं मम नामकम् ।\nतप्तस्वर्णप्रभाजुष्टजटाराशि विराजितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003102054, "chapter_id": 23102, "verse_number": "४-३८-५५", "content_sanskrit": "वृषभस्थं शूलपाणिं सर्वभूषणराजितम् ।\nनागयज्ञोपवीतं च सर्पभूषणभूषितम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003102055, "chapter_id": 23102, "verse_number": "४-३८-५६", "content_sanskrit": "शुद्धस्फटिकसंकाशं व्याघ्रचर्मधरं परम् ।\nविभूतिभूषिताङ्गं तमस्थिमालं दिगम्बरम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003102056, "chapter_id": 23102, "verse_number": "४-३८-५७", "content_sanskrit": "पञ्चवक्त्रं त्रिनयनं सूर्यकोटिसमप्रभम् ।\nददर्श रुद्रान्परितो ज्वलतो ब्रह्मतेजसा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003102057, "chapter_id": 23102, "verse_number": "४-३८-५८", "content_sanskrit": "शिववामे महाकालं दक्षिणे नन्दिकेश्वरम् ।\nभूतप्रेतपिशाचांश्च कूष्माण्डान्ब्रह्मराक्षसान् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003102058, "chapter_id": 23102, "verse_number": "४-३८-५९", "content_sanskrit": "वेतालान्क्षेत्रपालांश्च भैरवान्भीमविक्रमान् ।\nसनकं च सनन्दं च कुमारं च सनातनम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003102059, "chapter_id": 23102, "verse_number": "४-३८-६०", "content_sanskrit": "जैगीषव्यं देवलं च काणादं गौतमं तथा ।\nपिप्पलादं कणखनं वोढुं पञ्चशिखं कठम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003102060, "chapter_id": 23102, "verse_number": "४-३८-६१", "content_sanskrit": "जाजलिं करखं कर्णं लोमशं सूर्यवर्चसम् ।\nकात्यायनं पाणिनिं च शंखं दुर्वाससं ततः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003102061, "chapter_id": 23102, "verse_number": "४-३८-६२", "content_sanskrit": "शातातपं पारिभद्रमष्टावक्रं मरुद्भवम् ।\nएतान्पुरोगमान्नत्वा प्रणनाम शिवं गिरिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003102062, "chapter_id": 23102, "verse_number": "४-३८-६३", "content_sanskrit": "मूर्ध्ना निपत्य भूमौ स दण्डवत्संपुटाञ्जलिः ।\nअथो अनल्पया भक्त्या धृत्वा तच्चरणाम्बुजम् ।\nननाम चाश्रुनेत्रः स पुलकाञ्चितविग्रहः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003102063, "chapter_id": 23102, "verse_number": "४-३८-६४", "content_sanskrit": "धर्मदत्तेन स्तोत्रेण तुष्टाव परमेश्वरम् ।\nतुष्टे ब्राह्मे दिनेऽतीते पुष्करे सूर्यपर्वणि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003102064, "chapter_id": 23102, "verse_number": "४-३८-६५", "content_sanskrit": "हिमालय उवाच ।\nत्वं ब्रह्मा सृष्टिकर्ता च त्वं विष्णुः परिपालकः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003102065, "chapter_id": 23102, "verse_number": "४-३८-६६", "content_sanskrit": "त्वं शिवः शिवदोऽनन्तः सर्वसंहारकारकः ।\nत्वमीश्वरो गुणातीतो ज्योतीरूपः सनातनः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003102066, "chapter_id": 23102, "verse_number": "४-३८-६७", "content_sanskrit": "प्रकृतः प्रकृतीशश्च प्राकृतः प्रकृतेः परः ।\nनानारूपविधाता त्वं भक्तानां ध्यानहेतवे ।\nयेषु रूपेषु यत्प्रीतिस्तत्तद्रूपं बिभर्षि च ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003102067, "chapter_id": 23102, "verse_number": "४-३८-६८", "content_sanskrit": "सूर्यस्त्वं सृष्टिजनक आधारः सर्वतेजसाम् ।\nसोमस्त्वं सस्यपाता च सततं शीतरश्मिना ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003102068, "chapter_id": 23102, "verse_number": "४-३८-६९", "content_sanskrit": "वायुस्त्वं वरुणस्त्वं च त्वमग्निः सर्वदाहकः ।\nइन्द्रस्त्वं देवराजश्च कालो मृत्युर्यमस्तथा॥ ॥६९।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003102069, "chapter_id": 23102, "verse_number": "४-३८-७०", "content_sanskrit": "युञ्जयो मृत्युमृत्युः कालकालो यमान्तकः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003102070, "chapter_id": 23102, "verse_number": "४-३८-७१", "content_sanskrit": "वेदस्त्वं वेदकर्ता च वेदवेदाङ्गपारगः ।\nविदुषां जनकस्त्वं च विद्वांश्च विदुषां गुरुः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003102071, "chapter_id": 23102, "verse_number": "४-३८-७२", "content_sanskrit": "मन्त्रस्त्वं हि जपस्त्वं हि तपस्त्वं तत्फलप्रदः ।\nवाक् त्वं वागधिदेवी त्वं तत्कर्ता तद्गुरुः स्वयम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003102072, "chapter_id": 23102, "verse_number": "४-३८-७३", "content_sanskrit": "अहो सरस्वतीबीजं कस्त्वां स्तोतुमिहेश्वरः ।\nइत्येवमुक्त्वा शैलेन्द्रस्तस्थौ धृत्वा पदाम्बुजम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003102073, "chapter_id": 23102, "verse_number": "४-३८-७४", "content_sanskrit": "तत्रोवास तमाबोध्य चावरुह्य वृषाच्छिवः ।\nस्तोत्रमेतन्महापुण्यं त्रिसन्ध्यं यः पठेन्नरः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003102074, "chapter_id": 23102, "verse_number": "४-३८-७५", "content_sanskrit": "मुच्यते सर्वपापेभ्यो भयेभ्यश्च भवार्णवे ।\nअपुत्रो लभते पुत्रं मासमेकं पठेद्यदि ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003102075, "chapter_id": 23102, "verse_number": "४-३८-७६", "content_sanskrit": "भार्याहीनो लभेद्भार्यां  सुशीलां सुमनोहराम्।\nचिरकालगतं वस्तु लभते सहसा ध्रुवम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003102076, "chapter_id": 23102, "verse_number": "४-३८-७७", "content_sanskrit": "राज्यभ्रष्टो लभेद्राज्यं शंकरस्य प्रसादतः ।\nकारागारे श्मशाने च शत्रुग्रस्तेऽतिसंकटे ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003102077, "chapter_id": 23102, "verse_number": "४-३८-७८", "content_sanskrit": "गभीरेऽतिजलाकीर्णे भग्नपोते विषादने ।\nरणमध्ये महाभीते हिंस्रजन्तुसमन्विते ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003102078, "chapter_id": 23102, "verse_number": "४-३८-७९", "content_sanskrit": "सर्वतो मुच्यते स्तुत्वा शंकरस्य प्रसादतः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]