[{"id": 2096084, "chapter_id": 3052, "verse_number": "१३-१८२-१", "content_sanskrit": "युधिष्ठिर उवाच।\nविद्या तपश्च दानं च किमेतेषां विशिष्यते।\nपृच्छामि त्वां सतां श्रेष्ठ तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096085, "chapter_id": 3052, "verse_number": "१३-१८२-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096086, "chapter_id": 3052, "verse_number": "१३-१८२-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nमैत्रेयस्य च संवादं कृष्णद्वैपायनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096087, "chapter_id": 3052, "verse_number": "१३-१८२-३", "content_sanskrit": "कृष्णद्वैपायनो राजन्नज्ञातचरितं चरन्।\nवाराणस्यामुपातिष्ठन्मैत्रेयं स्वैरिणीकुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096088, "chapter_id": 3052, "verse_number": "१३-१८२-४", "content_sanskrit": "तमुपच्छन्नमासीनं ज्ञात्वा स मुनिसत्तमः।\nअर्चित्वा भोजयामास मैत्रेयोऽशनमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096089, "chapter_id": 3052, "verse_number": "१३-१८२-५", "content_sanskrit": "तदन्नमुत्तमं भुक्त्वा गुणवत्सार्वकामिकम्।\nउत्तिष्ठमानोऽस्मयत प्रीतः कृष्णो महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096090, "chapter_id": 3052, "verse_number": "१३-१८२-६", "content_sanskrit": "तमुत्स्मयन्तं सम्प्रेक्ष्य मैत्रेयः कृष्णमब्रवीत्।\nकारणं ब्रूहि धर्मात्मन्व्यस्मयिष्ठाः कुतश्च ते।\nतपस्विनो धृतिमतः प्रमोदः समुपागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096091, "chapter_id": 3052, "verse_number": "१३-१८२-७", "content_sanskrit": "एतदिच्छामि ते विद्वन्नभिवाद्य प्रणम्य च।\nआत्मनश्च तपोभाग्यं सुखभाग्यं ममेह च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096092, "chapter_id": 3052, "verse_number": "१३-१८२-८", "content_sanskrit": "`तपोभाग्यान्महाभाग सुखभाग्यात्तथैव च।\nपृथगाचरितं तात पृथगाचरितात्मनः।\nअल्पान्तरमहं मन्ये विशिष्टमपि चान्वयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096093, "chapter_id": 3052, "verse_number": "१३-१८२-९x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096094, "chapter_id": 3052, "verse_number": "१३-१८२-९", "content_sanskrit": "अतिच्छेदातिवादाभ्यां स्मयोऽयं समुपागतः।\nअसत्यं वेदवचनं कस्माद्वेदोऽनृतं वदेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096095, "chapter_id": 3052, "verse_number": "१३-१८२-१०", "content_sanskrit": "त्रीण्येव तु पदान्याहुः पुरुषस्योत्तमं प्रति।\nन द्रुह्येच्चैव दद्याच्च सत्यं चैव परान्वदेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096096, "chapter_id": 3052, "verse_number": "१३-१८२-११", "content_sanskrit": "इति वेदोक्तमृषिभिः पुरस्तात्परिकल्पितम्।\nइदानीं चैव नः कृत्यं पुरस्ताच्च परिश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096097, "chapter_id": 3052, "verse_number": "१३-१८२-१२", "content_sanskrit": "अल्पोऽपि तादृशो न्यासो भवत्युत महाफलः।\nतृषिताय च यद्दत्तं हृदयेनानसूयता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096098, "chapter_id": 3052, "verse_number": "१३-१८२-१३", "content_sanskrit": "तोषितास्त्रिदशा यत्ते दत्त्वैतद्दर्शनं मम।\nअजैषीर्महतो लोकान्महायज्ञैरिव प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096099, "chapter_id": 3052, "verse_number": "१३-१८२-१४", "content_sanskrit": "ततो दानपवित्रेण प्रीतोऽस्मि तपसैव च।\nदूरात्पुण्यवतो गन्धः पुण्यस्यैव च दर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096100, "chapter_id": 3052, "verse_number": "१३-१८२-१५", "content_sanskrit": "पुण्यश्च वातिगन्धस्ते मन्ये कर्म विधानजम्।\nअथ कर्मार्जितस्तात यथाचैवानुलेपनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096101, "chapter_id": 3052, "verse_number": "१३-१८२-१६", "content_sanskrit": "शुभं सर्वपवित्रेब्यो दानमेव परं द्विज।\n[नोचेत्सर्वपवित्रेभ्यो दानमेव परं भवेत्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096102, "chapter_id": 3052, "verse_number": "१३-१८२-१७", "content_sanskrit": "यानीमान्युत्तमानीह वेदोक्तानि प्रशंसति।\nतेषां श्रेष्ठतरं दानमिति मे नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096103, "chapter_id": 3052, "verse_number": "१३-१८२-१८", "content_sanskrit": "दानवद्भिः कृतः पन्था येन यान्ति मनीषिणः।\nते हि प्राणस्य दातारस्तेषु धर्मः प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096104, "chapter_id": 3052, "verse_number": "१३-१८२-१९", "content_sanskrit": "यथा वेदाः स्वधीताश्च यथा चेन्द्रियसंयमः।\nसर्वत्यागो यता चेह तता दानमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096105, "chapter_id": 3052, "verse_number": "१३-१८२-२०", "content_sanskrit": "त्वं हि तात सुखादेव शुभमेष्यसि शोभनम्।\nसुखात्सुखतरप्राप्तिमाप्नुते मतिमान्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096106, "chapter_id": 3052, "verse_number": "१३-१८२-२१", "content_sanskrit": "तन्नः प्रत्यक्षमेवेदमुपलक्ष्यमसंशयम्।\nश्रीमन्तः प्राप्नुवन्त्यर्थान्दानं यज्ञं तथा सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096107, "chapter_id": 3052, "verse_number": "१३-१८२-२२", "content_sanskrit": "सुखादेव परं दुःखं दुःखादन्यत्परं सुखम्।\nदृश्यते हि महाप्राज्ञ नियतं वै स्वभावतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096108, "chapter_id": 3052, "verse_number": "१३-१८२-२३", "content_sanskrit": "विविधानीह वृत्तानि नरस्याहुर्मनीषिणः।\nपुण्यमन्यत्पापमन्यन्न पुण्यं न च पापकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096109, "chapter_id": 3052, "verse_number": "१३-१८२-२४", "content_sanskrit": "न वृत्तं मन्यतेऽन्यस्य मन्यतेऽन्यस्य पातकम्।\nयथा स्वकर्मनिर्वृत्तं न पुण्यं न च पापकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096110, "chapter_id": 3052, "verse_number": "१३-१८२-२५", "content_sanskrit": "यज्ञदानतपःशीला नरा वै पुण्यकर्मिणः।\nयेऽभिद्रुह्यन्ति भूतानि ते वै पापकृतो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2096111, "chapter_id": 3052, "verse_number": "१३-१८२-२६", "content_sanskrit": "द्रव्याण्याददते चैव दुःखं यान्ति पतन्ति च।\nततोऽन्यत्कर्म यत्किंचिन्न पुण्यं न च पातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2096112, "chapter_id": 3052, "verse_number": "१३-१८२-२७", "content_sanskrit": "`नित्यं चाकृपणो भुङ्क्ते स्वजनैर्देहि याचतः।\nभाग्यक्षयेण क्षीयन्ते नोपभोगेन सञ्चयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2096113, "chapter_id": 3052, "verse_number": "१३-१८२-२८", "content_sanskrit": "रमस्वैधस्व मोदस्व देहि दाने रमस्व च।\nन त्वामतिभविष्यन्ति वैद्या न च तपस्विनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2096114, "chapter_id": 3052, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्व्यशीत्यधिकशततमोऽध्यायः॥ १८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]