[{"id": 7001029000, "chapter_id": 21029, "verse_number": "५-११-१", "content_sanskrit": "श्रीपराशर उवाच।\nमखे प्रतिहते शक्रो मैत्रेयातिरुषान्वितः ।\nसंवर्त्तकं नाम गणं तोयदानामथाऽब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001029001, "chapter_id": 21029, "verse_number": "५-११-२", "content_sanskrit": "भोभो मेघा निशम्यैतद्वचनं गदतो मम ।\nआज्ञानंतरमेवाशु क्रियतामविचारितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001029002, "chapter_id": 21029, "verse_number": "५-११-३", "content_sanskrit": "नंदगोपस्सुदुर्बुद्धिर्गोपैरन्यैस्सहायवान् ।\nकृष्णाश्रयं बलाध्मातो मखभंगमचीकरत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001029003, "chapter_id": 21029, "verse_number": "५-११-४", "content_sanskrit": "आजीवो याः परस्तेषां गावस्तस्य च कारणम् ।\nतागावो वृष्टिपातेन पीड्यन्तां वचनान्मम ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001029004, "chapter_id": 21029, "verse_number": "५-११-५", "content_sanskrit": "अहमप्यद्रि शृंगाभं तुंगमारुह्य वारणम् ।\nसाहाय्यं वः करिष्यामि वाय्वम्बूत्सर्गयोजितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001029005, "chapter_id": 21029, "verse_number": "५-११-६", "content_sanskrit": "श्रीपराशर उवाच।\nइत्याज्ञप्तास्ततस्तेन मुमुचुस्ते बलाहकाः ।\nवातवर्षं महाभीममभावाय गवां द्विज ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001029006, "chapter_id": 21029, "verse_number": "५-११-७", "content_sanskrit": "ततः क्षणेन पृथिवी ककुभॐबरमेव च ।\nएकं धारामहासारपूरेणनाभवन्मुने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001029007, "chapter_id": 21029, "verse_number": "५-११-८", "content_sanskrit": "विद्युल्लताकषाघातत्रस्तैरिव घनैर्घनम् ।\nनादापूरितदिक्चक्रैर्धारासारमपात्यत ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001029008, "chapter_id": 21029, "verse_number": "५-११-९", "content_sanskrit": "अंधकारीकृते लोके वर्षद्भिरनिशं घनैः ।\nअधश्चोर्ध्वं च तिर्यक् च जगदाप्यमिवाभवत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001029009, "chapter_id": 21029, "verse_number": "५-११-१०", "content_sanskrit": "गावस्तु तेन पतता वर्षवातेन वेगिना ।\nधूताः प्राणाञ्जहुस्सन्नत्रिकसक्थिशिरोधराः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001029010, "chapter_id": 21029, "verse_number": "५-११-११", "content_sanskrit": "क्रोडेन वत्सानाक्रम्य तस्थुरन्या महामुने ।\nगावो विवत्साश्च कृता वारिपूरेण चापराः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001029011, "chapter_id": 21029, "verse_number": "५-११-१२", "content_sanskrit": "वत्साश्च दीनवदना वातकंपितकंधराः ।\nत्राहित्राहीत्यल्पशब्दाः कृष्णमूचुरिवातुराः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001029012, "chapter_id": 21029, "verse_number": "५-११-१३", "content_sanskrit": "ततस्तद्गोकुलं सर्वं गोगोपीगोपसंकुलम् ।\nअतीवार्त्तं हरिर्दृष्ट्वा मैत्रेयाचिंतयत्तदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001029013, "chapter_id": 21029, "verse_number": "५-११-१४", "content_sanskrit": "एतत्कृतं महेंद्रे ण मखभंगविरोधिना ।\nतदेतदखिलं गोष्ठं त्रातव्यमधुना मया ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001029014, "chapter_id": 21029, "verse_number": "५-११-१५", "content_sanskrit": "इममद्रि महं धैर्यादुत्पाट्योरुशिखाघनम् ।\nधारयिष्यामि गोष्ठस्य पृथुच्छत्रमिवोपरि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001029015, "chapter_id": 21029, "verse_number": "५-११-१६", "content_sanskrit": "श्रीपराशर उवाच।\nइति कृत्वामतिं कृष्णो गोवर्द्धनमहीधरम् ।\nउत्पाट्यैककरेणैव धारयामास लीलया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001029016, "chapter_id": 21029, "verse_number": "५-११-१७", "content_sanskrit": "गोपांश्चाह हसञ्छौरिस्समुत्पाटितभूधरः ।\nविशध्वमत्रत्वरिताः कृतं वर्षनिवारणम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001029017, "chapter_id": 21029, "verse_number": "५-११-१८", "content_sanskrit": "सुनिवातेषु देश्षोउ! यथा जोषमिहास्यताम् ।\nप्रविश्यतां न भेतव्यं गिरिपाताच्च निर्भयैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001029018, "chapter_id": 21029, "verse_number": "५-११-१९", "content_sanskrit": "इत्युक्तास्तेन ते गोपा विविशुर्गोधनैस्सह ।\nशकटारोपितैर्भांडैर्गोप्यश्चासारपीडिताः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001029019, "chapter_id": 21029, "verse_number": "५-११-२०", "content_sanskrit": "कृष्णोपि तं दधारैव शैलमत्यंतनिश्चलम् ।\nव्रजौकवासिभिर्हर्षविस्मिताक्षैर्निरीक्षितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001029020, "chapter_id": 21029, "verse_number": "५-११-२१", "content_sanskrit": "गोपगोपीजनैर्हृष्टैः प्रीतिविस्तारितेक्षणैः ।\nसंस्तूयमानचरितः कृष्णश्शैलमधारयत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001029021, "chapter_id": 21029, "verse_number": "५-११-२२", "content_sanskrit": "सप्तरात्रं महामेघा ववर्षुर्नंदगोकुले ।\nइंद्रे ण चोदिता विप्र गोपानां नाशकारिणा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001029022, "chapter_id": 21029, "verse_number": "५-११-२३", "content_sanskrit": "ततो धृते महाशैले परित्राते च गोकुले ।\nमिथ्याप्रतिज्ञो बलभिद्वारयामास तान्घनान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001029023, "chapter_id": 21029, "verse_number": "५-११-२४", "content_sanskrit": "व्यभ्रे नभसि देवेंद्रे वितथात्मवचस्यथ ।\nनिष्क्रम्य गोकुलं हृष्टं स्वस्थानं पुनरागमत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001029024, "chapter_id": 21029, "verse_number": "५-११-२५", "content_sanskrit": "मुमोच कृष्णोपि तदा गोवर्द्धनमहाचलम् ।\nस्वस्थाने विस्मितमुखैर्दृष्टस्तैस्तु व्रजौकसैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]