[{"id": 7004102000, "chapter_id": 24102, "verse_number": "४-५१-१", "content_sanskrit": "अथ श्रीकाशीखंडोत्तरार्धं प्रारभ्यते ।\nश्रीगणेशाय नमः ।\nअगस्तिरुवाच ।\nपार्वती हृदयानंद सर्वज्ञांगभव प्रभो ।\nकिंचित्प्रष्टुमनाः स्वामिंस्तद्भवान्वक्तुमर्हति ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004102001, "chapter_id": 24102, "verse_number": "४-५१-२", "content_sanskrit": "दक्ष प्रजापतेः पुत्री कश्यपस्य परिग्रहः ।\nगरुत्मतः प्रसूः साध्वी कुतो दास्यमवाप सा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004102002, "chapter_id": 24102, "verse_number": "४-५१-३", "content_sanskrit": "स्कंद उवाच ।\nहंजिकात्वं यथा प्राप्ता विनता सा तपस्विनी ।\nतदप्यहं समाख्यामि निशामय महामते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004102003, "chapter_id": 24102, "verse_number": "४-५१-४", "content_sanskrit": "कद्रूरजीजनत्पुत्राञ्शतं कश्यपतः पुरा ।\nउलूकमरुणं तार्क्ष्यमसूत विनता त्रयम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004102004, "chapter_id": 24102, "verse_number": "४-५१-५", "content_sanskrit": "कौशिको राज्यमाप्यापि श्रेष्ठत्वात्पक्षिणां मुने ।\nनिर्गुणत्वाच्च तैः सर्वैः स राज्यादवरोपितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004102005, "chapter_id": 24102, "verse_number": "४-५१-६", "content_sanskrit": "क्रूराक्षोयं दिवांधोयं सदा वक्रनखस्त्वसौ ।\nअतीवोद्वेगजनकं सर्वेषामस्य भाषणम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004102006, "chapter_id": 24102, "verse_number": "४-५१-७", "content_sanskrit": "इत्थं तस्य गुणग्रामान्विकथ्य बहुशः खगाः ।\nनाद्यापि वृण्वते राज्ये कमपि स्वैरचारिणः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004102007, "chapter_id": 24102, "verse_number": "४-५१-८", "content_sanskrit": "कौशिकेथ तथावृत्ते पुत्रवीक्षणलालसा ।\nअंडं प्रस्फोटयामास मध्यमं विनता तदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004102008, "chapter_id": 24102, "verse_number": "४-५१-९", "content_sanskrit": "पूर्णे वर्षसहस्रे तु प्रस्फोट्य घटसंभव ।\nतदभेदितयौत्सुक्यादंडमष्टमके शते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004102009, "chapter_id": 24102, "verse_number": "४-५१-१०", "content_sanskrit": "तावत्सर्वाणि गात्राणि तस्यातिमहसः शिशोः ।\nऊर्वोरुपरिसिद्धानि दंडांतर्निवासिनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004102010, "chapter_id": 24102, "verse_number": "४-५१-११", "content_sanskrit": "अंडान्निर्गतमात्रेण क्रोधारुणमुखश्रिया ।\nअर्धनिष्पन्नदेहेन शिशुना शापिता प्रसूः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004102011, "chapter_id": 24102, "verse_number": "४-५१-१२", "content_sanskrit": "जनयित्रि त्वया दृष्ट्वा काद्रवेयान्स्वलीलया ।\nखेलतो मातुरुत्संगे यदंडं व्याधित द्विधा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004102012, "chapter_id": 24102, "verse_number": "४-५१-१३", "content_sanskrit": "तदनिष्पन्न सर्वांगः शपामि त्वा विहंगमे ।\nतेषामेवैधि दासी त्वं सपत्न्यंग भुवामिह ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004102013, "chapter_id": 24102, "verse_number": "४-५१-१४", "content_sanskrit": "वेपमानाथ तच्छापादिदं प्रोवाच पक्षिणी ।\nअनूरो ब्रूहि मे शापावसानं मातुरंगज ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004102014, "chapter_id": 24102, "verse_number": "४-५१-१५", "content_sanskrit": "अनूरुरुवाच ।\nअंडं तृतीयं मा भिंधि ह्यनिष्पन्नं ममेव हि ।\nअस्मिन्नंडे भविष्यो यः स ते दास्यं हरिष्यति ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004102015, "chapter_id": 24102, "verse_number": "४-५१-१६", "content_sanskrit": "इत्युक्त्वा सोरुणोगच्छदुड्डीयानंदकाननम् ।\nयत्र विश्वेश्वरो दद्यादपि पंगोः शुभां गतिम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004102016, "chapter_id": 24102, "verse_number": "४-५१-१७", "content_sanskrit": "एतत्ते पृच्छतः ख्यातं विनता दास्यकारणम् ।\nमुने प्रसंगतो वच्मि अरुणादित्यसंभवम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004102017, "chapter_id": 24102, "verse_number": "४-५१-१८", "content_sanskrit": "अनूरुत्वादनूरुर्योरुणः क्रोधारुणो यतः ।\nवाराणस्यां तपस्तप्त्वा तेनाराधि दिवाकरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004102018, "chapter_id": 24102, "verse_number": "४-५१-१९", "content_sanskrit": "सोपि प्रसन्नो दत्त्वाथ वरांस्तस्मा अनूरवे ।\nआदित्यस्तस्य नाम्नाभूदरुणादित्य इत्यपि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004102019, "chapter_id": 24102, "verse_number": "४-५१-२०", "content_sanskrit": "अर्क उवाच ।\nतिष्ठानूरो मम रथे सदैव विनतात्मज ।\nजगतां च हितार्थाय ध्वांतं विध्वंसयन्पुरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004102020, "chapter_id": 24102, "verse_number": "४-५१-२१", "content_sanskrit": "अत्र त्वत्स्थापितां मूर्तिं ये भजिष्यंति मानवाः ।\nवाराणस्यां महादेवोत्तरे तेषां कुतो भयम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004102021, "chapter_id": 24102, "verse_number": "४-५१-२२", "content_sanskrit": "येर्चयिष्यंति सततमरुणादित्यसंज्ञकम् ।\nमामत्र तेषां नो दुःखं न दारिद्र्यं न पातकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004102022, "chapter_id": 24102, "verse_number": "४-५१-२३", "content_sanskrit": "व्याधिभिर्नाभिभूयंते नो पसर्गैश्च कैश्चन ।\nशोकाग्निना न दह्यंते ह्यरुणादित्यसेवनात् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004102023, "chapter_id": 24102, "verse_number": "४-५१-२४", "content_sanskrit": "अथ स्यंदनमारोप्य नीतवानरुणं रविः ।\nअद्यापि स रथे सौरे प्रातरेव समुद्यति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004102024, "chapter_id": 24102, "verse_number": "४-५१-२५", "content_sanskrit": "यः कुर्यात्प्रातरुत्थाय नमस्कारं दिनेदिने ।\nअरुणाय ससूर्याय तस्य दुःखभयं कुतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004102025, "chapter_id": 24102, "verse_number": "४-५१-२६", "content_sanskrit": "अरुणादित्यमाहात्म्यं यः श्रोष्यति नरोत्तमः ।\nन तस्य दुष्कृतं किंचिद्भविष्यति कदाचन ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004102026, "chapter_id": 24102, "verse_number": "४-५१-२७", "content_sanskrit": "स्कंद उवाच ।\nवृद्धादित्यस्य माहात्म्यं शृणु ते कथयाम्यहम् ।\nयस्य श्रवणमात्रेण नरो नो दुष्कृतं भजेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004102027, "chapter_id": 24102, "verse_number": "४-५१-२८", "content_sanskrit": "पुरात्र वृद्धहारीतो वाराणस्यां महातपाः ।\nमहातपः समृद्ध्यर्थं समाराधितवान्रविम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004102028, "chapter_id": 24102, "verse_number": "४-५१-२९", "content_sanskrit": "मूर्तिं संस्थाप्य शुभदां भास्वतः शुभलक्षणाम् ।\nदक्षिणेन विशालाक्ष्या दृढभक्तिसमन्वितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004102029, "chapter_id": 24102, "verse_number": "४-५१-३०", "content_sanskrit": "तुष्टस्तस्मै वरं प्रादाद्ब्रध्नो वृद्धतपस्विने ।\nअलं विलंब्य याचस्व कस्ते देयो वरो मया ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004102030, "chapter_id": 24102, "verse_number": "४-५१-३१", "content_sanskrit": "सोथ प्रसन्नाद्द्युमणेरवृणीत वरं मुनिः ।\nयदि प्रसन्नो भगवान्युवत्वं देहि मे पुनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004102031, "chapter_id": 24102, "verse_number": "४-५१-३२", "content_sanskrit": "तपःकरण सामर्थ्यं स्थविरस्य न मे यतः ।\nपुनस्तारुण्यमाप्तोहं चरिष्याम्युत्तमं तपः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004102032, "chapter_id": 24102, "verse_number": "४-५१-३३", "content_sanskrit": "तप एव परो धर्मस्तप एव परं वसु ।\nतप एव परः कामो निर्वाणं तप एव हि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004102033, "chapter_id": 24102, "verse_number": "४-५१-३४", "content_sanskrit": "ऋतेन तपसः क्वापि लभ्या ऐश्वर्यसंपदः ।\nपदं ध्रुवादिभिः प्रापि केवलं तपसो बलात् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004102034, "chapter_id": 24102, "verse_number": "४-५१-३५", "content_sanskrit": "ततस्तपश्चरिष्यामि लोकद्वयमहत्त्वदम् ।\nप्राप्य त्वद्वरदानेन यौवनं सर्वसंमतम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004102035, "chapter_id": 24102, "verse_number": "४-५१-३६", "content_sanskrit": "धिग्जरांप्राणिनामत्र यया सर्वो विरज्यति ।\nजरातुरेंद्रियग्रामे स्त्रियोपि नयतः स्वसात् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004102036, "chapter_id": 24102, "verse_number": "४-५१-३७", "content_sanskrit": "वरं मरणमेवास्तु मा जरास्त्वतिशोच्यकृत् ।\nक्षणं दुःखं च मरणं जरा दुःखं क्षणेक्षणे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004102037, "chapter_id": 24102, "verse_number": "४-५१-३८", "content_sanskrit": "कांक्षंति दीर्घतपसे चिरमायुर्जितेंद्रियाः ।\nधनं दानाय पुत्राय कलत्रं मुक्तये धियम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004102038, "chapter_id": 24102, "verse_number": "४-५१-३९", "content_sanskrit": "वृद्धस्यवार्धकं ब्रध्नस्तत्क्षणादपहृत्य वै ।\nददौ च चारुता हेतुं तारुण्यं पुण्यसाधनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004102039, "chapter_id": 24102, "verse_number": "४-५१-४०", "content_sanskrit": "एवं स वृद्धहारीतो वाराणस्यां महामुनिः ।\nसंप्राप्य यौवनं ब्रध्नात्तप उग्रं चचार ह ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004102040, "chapter_id": 24102, "verse_number": "४-५१-४१", "content_sanskrit": "वृद्धेनाराधितो यस्माद्धारीतेन तपस्विना ।\nआदित्यो वार्धकहरो वृद्धादित्यस्ततः स्मृतः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004102041, "chapter_id": 24102, "verse_number": "४-५१-४२", "content_sanskrit": "वृद्धादित्यं समाराध्य वाराणस्यां घटोद्भव ।\nजरा दुर्गति रोगघ्नं बहवः सिद्धिमागताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004102042, "chapter_id": 24102, "verse_number": "४-५१-४३", "content_sanskrit": "वृद्धादित्यं नमस्कृत्य वाराणस्या रवौ नरः ।\nलभेदभीप्सितां सिद्धिं न क्वचिद्दुर्गतिं लभेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004102043, "chapter_id": 24102, "verse_number": "४-५१-४४", "content_sanskrit": "स्कंद उवाच ।\nअतः परं शृणु मुने केशवादित्यमुत्तमम् ।\nयथा तु केशवं प्राप्य सविता ज्ञानमाप्तवान् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004102044, "chapter_id": 24102, "verse_number": "४-५१-४५", "content_sanskrit": "व्योम्नि संचरमाणेन सप्ताश्वेनादिकेशवः ।\nएकदा दर्शिभावेन पूजयंल्लिंगमैश्वरम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004102045, "chapter_id": 24102, "verse_number": "४-५१-४६", "content_sanskrit": "कौतुकादिव उत्तीर्य हरे रविरुपाविशत् ।\nनिःशब्दो निश्चलः स्वस्थो महाश्चर्यसमन्वितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004102046, "chapter_id": 24102, "verse_number": "४-५१-४७", "content_sanskrit": "प्रतीक्षमाणोवसरं किंचित्प्रष्टुमना हरिम् ।\nहरिं विसर्जितार्चं च प्रणनाम कृतांजलिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004102047, "chapter_id": 24102, "verse_number": "४-५१-४८", "content_sanskrit": "स्वागतं ते हरिः प्राह बहुमानपुरःसरम् ।\nस्वाभ्याशं आसयामास भास्वंतं नतकंधरम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004102048, "chapter_id": 24102, "verse_number": "४-५१-४९", "content_sanskrit": "अथावसरमालोक्य लोकचक्षुरधोक्षजम् ।\nनत्वा विज्ञापयामास कृतानुज्ञोऽसुरारिणा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004102049, "chapter_id": 24102, "verse_number": "४-५१-५०", "content_sanskrit": "रविरुवाच ।\nअंतरात्मासि जगतां विश्वंभर जगत्पते ।\nतवापि पूज्यः कोप्यस्ति जगत्पूज्यात्र माधव ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004102050, "chapter_id": 24102, "verse_number": "४-५१-५१", "content_sanskrit": "त्वत्तश्चाविर्भवेदेतत्त्वयि सर्वं प्रलीयते ।\nत्वमेव पाता सर्वस्य जगतो जगतांनिधे ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004102051, "chapter_id": 24102, "verse_number": "४-५१-५२", "content_sanskrit": "इत्याश्चर्यं समालोक्य प्राप्तोस्म्यत्र तवांतिकम् ।\nकिमिदं पूज्यते नाथ भवता भवतापहृत् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004102052, "chapter_id": 24102, "verse_number": "४-५१-५३", "content_sanskrit": "इति श्रुत्वा हृषीकेशः सहस्रांशोरुदीरितम् ।\nउच्चैर्माशंस सप्ताश्वं वारयन्करसंज्ञया ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004102053, "chapter_id": 24102, "verse_number": "४-५१-५४", "content_sanskrit": "श्रीविष्णुरुवाच ।\nदेवदेवो महादेवो नीलकंठ उमापतिः ।\nएक एव हि पूज्योत्र सर्वकारणकारणम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004102054, "chapter_id": 24102, "verse_number": "४-५१-५५", "content_sanskrit": "अत्र त्रिलोचनादन्यं समर्चयतियोल्पधीः ।\nसलोचनोपि विज्ञेयो लोचनाभ्यां विवर्जितः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004102055, "chapter_id": 24102, "verse_number": "४-५१-५६", "content_sanskrit": "एको मृत्युंजयः पूज्यो जन्ममृत्युजराहरः ।\nमृत्युंजयं किलाभ्यर्च्य श्वेतो मृत्युंजयोभवत् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004102056, "chapter_id": 24102, "verse_number": "४-५१-५७", "content_sanskrit": "कालकालं समाराध्य भृंगी कालं जिगायवै ।\nशैलादिमपि तत्याज मृत्युर्मृत्युंजयार्चकम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004102057, "chapter_id": 24102, "verse_number": "४-५१-५८", "content_sanskrit": "विजिग्ये त्रिपुरं यस्तु हेलयैकेषु मोक्षणात् ।\nतं समभ्यर्च्य भूतेशं को न पूज्यतमो भवेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004102058, "chapter_id": 24102, "verse_number": "४-५१-५९", "content_sanskrit": "त्रिजगज्जयिनो हेतोस्त्र्यक्षस्याराधनं परम् ।\nको नाराधयति ब्रध्नसारस्य स्मरविद्विषः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004102059, "chapter_id": 24102, "verse_number": "४-५१-६०", "content_sanskrit": "यस्याक्षिपक्ष्मसंकोचाज्जगत्संकोचमेत्यदः ।\nविकस्वरं विकासाच्च कस्य पूज्यतमो न सः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004102060, "chapter_id": 24102, "verse_number": "४-५१-६१", "content_sanskrit": "शंभोर्लिंगं समभ्यर्च्य पुरुषार्थचतुष्टयम् ।\nप्राप्नोत्यत्र पुमान्सद्यो नात्र कार्या विचारणा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004102061, "chapter_id": 24102, "verse_number": "४-५१-६२", "content_sanskrit": "समर्च्य शांभवं लिंगमपिजन्मशतार्जितम् ।\nपापपुंजं जहात्येव पुमानत्र क्षणाद्ध्रुवम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004102062, "chapter_id": 24102, "verse_number": "४-५१-६३", "content_sanskrit": "किंकिं न संभवेदत्र शिवलिंगसमर्चनात् ।\nपुत्राः कलत्र क्षेत्राणि स्वर्गो मोक्षोप्यसंशयम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004102063, "chapter_id": 24102, "verse_number": "४-५१-६४", "content_sanskrit": "त्रैलोक्यैश्वर्यसंपत्तिर्मया प्राप्ता सहस्रगो ।\nशिवलिंगार्चनादेकात्सत्यंसत्यं पुनःपुनः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004102064, "chapter_id": 24102, "verse_number": "४-५१-६५", "content_sanskrit": "अयमेव परोयोगस्त्विदमेव परं तपः ।\nइदमेव परं ज्ञानं स्थाणुलिंगं यदर्च्यते ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004102065, "chapter_id": 24102, "verse_number": "४-५१-६६", "content_sanskrit": "यैर्लिंगं सकृदप्यत्र पूजितं पार्वतीपतेः ।\nकुतो दुःखभयं तेषां संसारे दुःखभाजने ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004102066, "chapter_id": 24102, "verse_number": "४-५१-६७", "content_sanskrit": "सर्वं परित्यज्य रवे यो लिंगं शरणं गतः ।\nन तं पापानि बाधंते महांत्यपि दिवाकर ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004102067, "chapter_id": 24102, "verse_number": "४-५१-६८", "content_sanskrit": "लिंगार्चने भवेद्वृद्धिस्तेषामेवात्र भास्कर ।\nयेषां पुनर्भवच्छेदं चिकीर्षति महेश्वरः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004102068, "chapter_id": 24102, "verse_number": "४-५१-६९", "content_sanskrit": "न लिंगाराधनात्पुण्यं त्रिषुलोकेषु चापरम् ।\nसर्वतीर्थाभिषेकः स्याल्लिंगस्नानांबु सेवनात् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004102069, "chapter_id": 24102, "verse_number": "४-५१-७०", "content_sanskrit": "तस्माल्लिंगं त्वमप्यर्क समर्चय महेशितुः ।\nसंप्राप्तं परमां लक्ष्मीं महातेजोभि जृंभणीम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004102070, "chapter_id": 24102, "verse_number": "४-५१-७१", "content_sanskrit": "इति श्रुत्वा हरेर्वाक्यं तदारभ्य सहस्रगुः ।\nविधाय स्फाटिकं लिंगं मुनेद्यापि समर्चयेत् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004102071, "chapter_id": 24102, "verse_number": "४-५१-७२", "content_sanskrit": "गुरुत्वेन तदाकल्य विवस्वानादिकेशवम् ।\nतत्रोपतिष्ठतेद्यापि उत्तरेणादिकेशवात् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004102072, "chapter_id": 24102, "verse_number": "४-५१-७३", "content_sanskrit": "अतः स केशवादित्यः काश्यां भक्ततमोनुदः ।\nसमर्चितः सदा देयान्मनसो वांछितं फलम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004102073, "chapter_id": 24102, "verse_number": "४-५१-७४", "content_sanskrit": "केशवादित्यमाराध्य वाराणस्यां नरोत्तमः ।\nपरमं ज्ञानमाप्नोति येन निर्वाणभाग्भवेत् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004102074, "chapter_id": 24102, "verse_number": "४-५१-७५", "content_sanskrit": "तत्र पादोदके तीर्थेकृतसर्वोदकक्रियः ।\nविलोक्य केशवादित्यं मुच्यते जन्मपातकैः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004102075, "chapter_id": 24102, "verse_number": "४-५१-७६", "content_sanskrit": "अगस्ते रथसप्तम्यां रविवारो यदाप्यते ।\nतदा पादोदके तीर्थे आदिकेशव सन्निधौ ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004102076, "chapter_id": 24102, "verse_number": "४-५१-७७", "content_sanskrit": "स्नात्वोषसि नरो मौनी केशवादित्यपूजनात् ।\nसप्तजन्मार्जितात्पापान्मुक्तो भवति तत्क्षणात् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004102077, "chapter_id": 24102, "verse_number": "४-५१-७८", "content_sanskrit": "यद्यज्जन्मकृतं पापं मया सप्तसु जन्मसु ।\nतन्मे रोगं च शोकं च माकरी हंतु सप्तमी ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004102078, "chapter_id": 24102, "verse_number": "४-५१-७९", "content_sanskrit": "एतज्जन्मकृतं पापं यच्च जन्मांतरार्जितम् ।\nमनोवाक्कायजं यच्च ज्ञाताज्ञाते च ये पुनः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004102079, "chapter_id": 24102, "verse_number": "४-५१-८०", "content_sanskrit": "इति सप्तविधं पापं स्नानान्मे सप्तसप्तिके ।\nसप्तव्याधिसमायुक्तं हर माकरि सप्तमि ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004102080, "chapter_id": 24102, "verse_number": "४-५१-८१", "content_sanskrit": "एतन्मंत्रत्रयं जप्त्वा स्नात्वा पादोदके नरः ।\nकेशवादित्यमालोक्य क्षणान्निष्कलुषो भवेत् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004102081, "chapter_id": 24102, "verse_number": "४-५१-८२", "content_sanskrit": "केशवादित्यमाहात्म्यं शृण्वञ्श्रद्धासमन्वितः ।\nनरो न लिप्यते पापैः शिवभक्तिं च विंदति ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004102082, "chapter_id": 24102, "verse_number": "४-५१-८३", "content_sanskrit": "स्कंद उवाच ।\nअतः परं शृणु मुने विमलादित्यमुत्तमम् ।\nहरिकेशवने रम्ये वाराणस्यां व्यवस्थितम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004102083, "chapter_id": 24102, "verse_number": "४-५१-८४", "content_sanskrit": "उच्चदेशेभवत्पूर्वं विमलो नाम बाहुजः ।\nस प्राक्तनात्कर्मयोगाद्विमले पथ्यपि स्थितः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004102084, "chapter_id": 24102, "verse_number": "४-५१-८५", "content_sanskrit": "कुष्ठरोगमवाप्योच्चैस्त्यक्त्वा दारान्गृहं वसु ।\nवाराणसीं समासाद्य ब्रध्नमाराधयत्सुधीः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004102085, "chapter_id": 24102, "verse_number": "४-५१-८६", "content_sanskrit": "करवीरैर्जपाभिश्च गंधकैः किंशुकैः शुभैः ।\nरक्तोत्पलैरशोकैश्च स समानर्च भास्करम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004102086, "chapter_id": 24102, "verse_number": "४-५१-८७", "content_sanskrit": "विचित्ररचनैर्माल्यैः पाटलाचंपकोद्भवैः ।\nकुंकुमागुरुकर्पूरमिश्रितैः शोणचंदनैः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004102087, "chapter_id": 24102, "verse_number": "४-५१-८८", "content_sanskrit": "देवमोहनधूपैश्च बह्वामोदततांबरैः ।\nकर्पूरवर्तिदीपैश्च नैवेद्यैर्घृतपायसैः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004102088, "chapter_id": 24102, "verse_number": "४-५१-८९", "content_sanskrit": "अर्घदानैश्च विधिवत्सौरेः स्तोत्रजपैरपि ।\nएवं समाराधयतस्तस्यार्को वरदोभवत् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004102089, "chapter_id": 24102, "verse_number": "४-५१-९०", "content_sanskrit": "उवाच च वरं ब्रूहि विमलामलचेष्टित ।\nकुष्ठश्च ते प्रयात्वेष प्रार्थयान्यं वरं पुनः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004102090, "chapter_id": 24102, "verse_number": "४-५१-९१", "content_sanskrit": "आकर्ण्य विमलश्चेत्थमालापं रश्मिमालिनः ।\nप्रणतो दंडवद्भूमौ संप्रहष्टतनूरुहः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004102091, "chapter_id": 24102, "verse_number": "४-५१-९२", "content_sanskrit": "शनैर्विज्ञापयांचक्र एकचक्ररथं रविम् ।\nजगच्चक्षुरमेयात्मन्महाध्वांतविधूनन ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004102092, "chapter_id": 24102, "verse_number": "४-५१-९३", "content_sanskrit": "यदि प्रसन्नो भगवन्यदि देयो वरो मम ।\nतदा त्वद्भक्तिनिष्ठा ये कुष्ठं मास्तु तदन्वये ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004102093, "chapter_id": 24102, "verse_number": "४-५१-९४", "content_sanskrit": "अन्येपि रोगा मा संतु मास्तु तेषां दरिद्रता ।\nमास्तु कश्चन संतापस्त्वद्भक्तानां सहस्रगो ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004102094, "chapter_id": 24102, "verse_number": "४-५१-९५", "content_sanskrit": "श्रीसूर्य उवाच ।\nतथास्त्विति महाप्राज्ञ शृण्वन्यं वरमुत्तमम् ।\nत्वयेयं पूजिता मूर्तिरेवं काश्यां महामते ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004102095, "chapter_id": 24102, "verse_number": "४-५१-९६", "content_sanskrit": "अस्याः सान्निध्यमत्राहं न त्यक्ष्यामि कदाचन ।\nप्रथिता तव नाम्ना च प्रतिमैषा भविष्यति ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004102096, "chapter_id": 24102, "verse_number": "४-५१-९७", "content_sanskrit": "विमलादित्य इत्याख्या भक्तानां वरदा सदा ।\nसर्वव्याधि निहंत्री च सर्वपापक्षयंकरी ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004102097, "chapter_id": 24102, "verse_number": "४-५१-९८", "content_sanskrit": "इति दत्त्वा वरान्सूर्यस्तत्रैवांतरधीयत ।\nविमलो निर्मलतनुः सोपि स्वभवनं ययौ ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004102098, "chapter_id": 24102, "verse_number": "४-५१-९९", "content_sanskrit": "इत्थं स विमलादित्यो वाराणस्यां शुभप्रदः ।\nतस्य दर्शनमात्रेण कुष्ठरोगः प्रणश्यति ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004102099, "chapter_id": 24102, "verse_number": "४-५१-१००", "content_sanskrit": "यश्चैतां विमलादित्यकथां वै शृणुयान्नरः ।\nप्राप्नोति निर्मलां शुद्धिं त्यज्यते च मनोमलैः ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004102100, "chapter_id": 24102, "verse_number": "४-५१-१०१", "content_sanskrit": "स्कंद उवाच ।\nगंगादित्योस्ति तत्रान्यो विश्वेशाद्दक्षिणेन वै ।\nतस्य दर्शनमात्रेण नरः शुद्धिमियादिह ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004102101, "chapter_id": 24102, "verse_number": "४-५१-१०२", "content_sanskrit": "यदा गंगा समायाता भगीरथपुरस्कृता ।\nतदा गंगां परिष्टोतुं रविस्तत्रैव संस्थितः ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004102102, "chapter_id": 24102, "verse_number": "४-५१-१०३", "content_sanskrit": "अद्याप्यहर्निशं गंगां संमुखीकृत्य भास्करः ।\nपरिष्टौति प्रसन्नात्मा गंगाभक्तवरप्रदः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004102103, "chapter_id": 24102, "verse_number": "४-५१-१०४", "content_sanskrit": "गंगादित्यं समाराध्य वाराणस्यां नरोत्तमः ।\nदुर्गतिं जातु न क्वापि लभते न च रोगभाक् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004102104, "chapter_id": 24102, "verse_number": "४-५१-१०५", "content_sanskrit": "स्कंद उवाच ।\nअन्यच्छृणु महाभाग यमादित्यस्य संभवम् ।\nयच्छ्रुत्वापि नरो जातु यमलोकं न पश्यति ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004102105, "chapter_id": 24102, "verse_number": "४-५१-१०६", "content_sanskrit": "यमेशात्पश्चिमे भागे वीरेशात्पूर्वतो मुने ।\nयमादित्यं नरो दृष्ट्वा यमलोकं न पश्यति ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004102106, "chapter_id": 24102, "verse_number": "४-५१-१०७", "content_sanskrit": "यमतीर्थे नरः स्नात्वा भूतायां भौमवासरे ।\nयमेश्वरं विलोक्याशु सर्वैः पापैः प्रमुच्यते ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004102107, "chapter_id": 24102, "verse_number": "४-५१-१०८", "content_sanskrit": "यमतीर्थे यमः पूर्वं तप्त्वा सुविमलं तपः ।\nयमेशं च यमादित्यं प्रत्यष्ठाद्भक्तसिद्धिदम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004102108, "chapter_id": 24102, "verse_number": "४-५१-१०९", "content_sanskrit": "यमेन स्थापितो यस्मादादित्यस्तत्र कुंभज ।\nअतः स हि यमादित्यो यामीं हरति यातनाम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004102109, "chapter_id": 24102, "verse_number": "४-५१-११०", "content_sanskrit": "यमेशं च यमादित्यं यमेन स्थापितं नमन् ।\nयमतीर्थे कृतस्नानो यमलोकं न पश्यति ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004102110, "chapter_id": 24102, "verse_number": "४-५१-१११", "content_sanskrit": "यमतीर्थे चतुर्दश्यां भरण्यां भौमवासरे ।\nतर्पणं पिंडदानं च कृत्वा पित्रनृणी भवेत् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004102111, "chapter_id": 24102, "verse_number": "४-५१-११२", "content_sanskrit": "अभिलष्यंति सततं पितरो नरकौकसः ।\nभौमै भरण्यां भूतायां यदि योगोयमुत्तमम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004102112, "chapter_id": 24102, "verse_number": "४-५१-११३", "content_sanskrit": "काश्यां कश्चिद्यमे तीर्थे कृत्वा स्नानं महामतिः ।\nअपि यस्तर्पणंकुर्यात्सतिलं नो विमुक्तये ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004102113, "chapter_id": 24102, "verse_number": "४-५१-११४", "content_sanskrit": "किं गया गमनैः पुंसां किं श्राद्धैर्भूरिदक्षिणैः ।\nयदि काश्यां यमे तीर्थे योगेस्मिञ्श्राद्धमाप्यते ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004102114, "chapter_id": 24102, "verse_number": "४-५१-११५", "content_sanskrit": "श्राद्धं कृत्वा यमे तीर्थे पूजयित्वा यमेश्वरम् ।\nयमादित्यं नमस्कृत्य पितॄणामनृणो भवेत् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004102115, "chapter_id": 24102, "verse_number": "४-५१-११६", "content_sanskrit": "स्कंद उवाच ।\nइति ते द्वादशादित्याः कथिता पापनाशनाः ।\nयत्संभवं समाकर्ण्य नरो न निरयी भवेत् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004102116, "chapter_id": 24102, "verse_number": "४-५१-११७", "content_sanskrit": "अन्येपि संति घटज रविभक्तैरनेकशः ।\nकाश्यां संस्थापिताः सूर्या गुह्यकार्कादयः किल ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004102117, "chapter_id": 24102, "verse_number": "४-५१-११८", "content_sanskrit": "श्रुत्वाध्यायानिमान्पुण्यान्द्वादशादित्यसूचकान् ।\nश्रावयित्वापि नो मर्त्यो दुर्गतिं याति कुत्रचित् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7004102118, "chapter_id": 24102, "verse_number": "४-५१-११९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायामुत्तरार्द्धे चतुथें काशीखण्डे अरुणवृद्धकेशवविमलगंगायमादित्यवर्णनंनामैकपंचाशत्तमोऽध्यायः ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}]