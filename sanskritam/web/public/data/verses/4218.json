[{"id": 2148658, "chapter_id": 4218, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148659, "chapter_id": 4218, "verse_number": "१", "content_sanskrit": "एवमुक्ते तु भीष्मेण द्रोणेन विदुरेण च ।\nगान्धार्या धृतराष्ट्रेण न वै मन्दोऽन्वबुध्यत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148660, "chapter_id": 4218, "verse_number": "२", "content_sanskrit": "अवधूयोत्थितो मन्दः क्रोधसंरक्तलोचनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148661, "chapter_id": 4218, "verse_number": "३", "content_sanskrit": "अन्वद्रवन्त तं पश्चाद् राजानस्त्यक्तजीविताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148662, "chapter_id": 4218, "verse_number": "४", "content_sanskrit": "आज्ञापयच्च राज्ञस्तान् पार्थिवान् नष्टचेतनः ।\nप्रयान्तु वै कुरुक्षेत्रमद्यैवेति पुनः पुनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148663, "chapter_id": 4218, "verse_number": "५", "content_sanskrit": "अक्षोहिण्यो दशैका च पार्थिवानां समागताः ।\nतासां प्रमुखतो भीष्मस्ताळकेतुर्व्यरोचत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148664, "chapter_id": 4218, "verse_number": "६", "content_sanskrit": "यदत्र युक्तं प्राप्तं च तद् विधत्स्व विशाम्पते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148665, "chapter_id": 4218, "verse_number": "७", "content_sanskrit": "उक्तं भीष्मेण यद् वाक्यं द्रोणेन विदुरेण च ।\nगान्धार्या धृतराष्ट्रेण समक्षं मम भारत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148666, "chapter_id": 4218, "verse_number": "८", "content_sanskrit": "एतत् ते कथितं राजन् यद् वृत्तं कुरुसंसदि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148667, "chapter_id": 4218, "verse_number": "९", "content_sanskrit": "साम चादौ प्रयुक्तं मे राजन् सौभ्रात्रमिच्छता ।\nअभेदात् कुरुवंशस्य प्रजानां च विवृद्धये\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148668, "chapter_id": 4218, "verse_number": "१०", "content_sanskrit": "पुनर्भेदश्च मे युक्तो यदा साम न गृह्यते ।\nकर्मानुकीर्तनं चैव देवमानुषसंहितम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148669, "chapter_id": 4218, "verse_number": "११", "content_sanskrit": "यदा नाद्रियते वाक्यं सामपूर्वं सुयोधनः ।\nतदा मया समानीय भेदिताः सर्वपार्थिवाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148670, "chapter_id": 4218, "verse_number": "१२", "content_sanskrit": "अद्भुतानि च घोराणि दारुणानि च भारत ।\nअमानुषाणि कर्माणि दर्शितानि मया विभो\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148671, "chapter_id": 4218, "verse_number": "१३", "content_sanskrit": "निर्भत्सयित्वा राज्ञस्तान् तृणीकृत्य सुयोधनम् ।\nराधेयं भीषयित्वा च सौबलं च पुनः पुनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148672, "chapter_id": 4218, "verse_number": "१४", "content_sanskrit": "न्यूनतां धार्तराष्ट्राणां निन्दां कृत्वा पुनः पुनः ।\nभेदयित्वा नृपान् सर्वान् वाग्भिर्मन्त्रेण चासकृत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148673, "chapter_id": 4218, "verse_number": "१५", "content_sanskrit": "पुनः सामाभिसंयुक्तं सम्प्रदानमथाब्रुवम् ।\nअभेदात् कुरुवंशस्य कार्ययोगात् तथैव च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148674, "chapter_id": 4218, "verse_number": "१६", "content_sanskrit": "ते शूरा धृतराष्ट्रस्य भीष्मस्य विदुरस्य च ।\nतिष्ठेयुः पाण्डवाः सर्वे हित्वा मानमधश्चराः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148675, "chapter_id": 4218, "verse_number": "१७", "content_sanskrit": "प्रयच्छन्तु च ते राज्यमनीशास्ते भवन्तु च ।\nयथाऽऽह राजा गाङ्गेयो विदुरश्च तथाऽऽस्तु ते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148676, "chapter_id": 4218, "verse_number": "१८", "content_sanskrit": "सर्वं भवतु ते राज्यं पञ्च ग्रामान् विसर्जय ।\nअवश्यं भरणीया हि पितुस्ते राजसत्तम\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148677, "chapter_id": 4218, "verse_number": "१९", "content_sanskrit": "एवमुक्तोऽपि दुष्टात्मा नैव भागं व्यमुञ्चत ।\nदण्डं चतुर्थं पश्यामि तेषु पापेषु नान्यथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148678, "chapter_id": 4218, "verse_number": "२०", "content_sanskrit": "निर्याताश्च विनाशाय कुरुक्षेत्रं नराधिपाः ।\nएतत् ते कथितं राजन् यद् वृत्तं कुरुसंसदि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148679, "chapter_id": 4218, "verse_number": "२१", "content_sanskrit": "न ते राज्यं प्रयच्छन्ति विना युद्धेन पाण्डव ।\nविनाशहेतवः सर्वे प्रत्युपस्थितमृत्यवः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148680, "chapter_id": 4218, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोनपञ्चाशोत्तरशततमोऽध्यायः ॥१४९॥\nविवादपर्वणि एकादशोऽध्यायः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148681, "chapter_id": 4218, "verse_number": "", "content_sanskrit": "॥ समाप्तं विवादपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]