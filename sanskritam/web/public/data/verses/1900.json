[{"id": 2040616, "chapter_id": 1900, "verse_number": "५-१४५-०x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040617, "chapter_id": 1900, "verse_number": "५-१४५-१", "content_sanskrit": "राधेयोऽहमाधिरथिः कर्णस्त्वामभिवादये ।\nप्राप्ता किमर्थं भवती ब्रूहि किं करवामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040618, "chapter_id": 1900, "verse_number": "५-१४५-२x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040619, "chapter_id": 1900, "verse_number": "५-१४५-२", "content_sanskrit": "कौन्तेयस्त्वं न राधेयो न तवाधिरथः पिता।\nनासि सूतकुले जातः कर्ण तद्विद्धि मे वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040620, "chapter_id": 1900, "verse_number": "५-१४५-३", "content_sanskrit": "कानीनस्त्वं मया जातः पूर्वजः कुक्षिणा धृतः ।\nकुन्तिराजस्य भवने पार्थस्त्वमसि पुत्रक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040621, "chapter_id": 1900, "verse_number": "५-१४५-४", "content_sanskrit": "प्रकाशकर्मा तपनो योऽयं देवो विरोचनः ।\nअजीजनत्त्वां मय्येष कर्ण शस्त्रभृतां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040622, "chapter_id": 1900, "verse_number": "५-१४५-५", "content_sanskrit": "कुण्डली बद्धकवचो देवगर्भः श्रिया वृतः ।\nजातस्त्वमसि दुर्धर्ष मया पुत्र पितुर्गृहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040623, "chapter_id": 1900, "verse_number": "५-१४५-६", "content_sanskrit": "स त्वं भ्रातॄनसंबुद्ध्य मोहद्यदुपसेवसे ।\nधार्तराष्ट्रान्न तद्युक्तं त्वयि पुत्र विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040624, "chapter_id": 1900, "verse_number": "५-१४५-७", "content_sanskrit": "एतद्धर्मफलं पुत्र नराणां धर्मनिश्चये ।\nयत्तुष्यन्त्यस्य पितरो माता चाप्येकदर्शिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040625, "chapter_id": 1900, "verse_number": "५-१४५-८", "content_sanskrit": "अर्जुनेनार्जितां पूर्वं हृतां लोभादसाधुभिः ।\nआच्छिद्य धार्तराष्ट्रेभ्यो भुङ्क्ष यौधिष्ठिरीं श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040626, "chapter_id": 1900, "verse_number": "५-१४५-९", "content_sanskrit": "अद्य पश्यन्तु कुरवः कर्णार्जुनसमागमम् ।\nसौभ्रात्रेण समालक्ष्य संनमन्तामसाधवः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040627, "chapter_id": 1900, "verse_number": "५-१४५-१०", "content_sanskrit": "कर्णार्जुनौ वै भवतां यथा रामजनार्दनौ ।\nअसाध्यं किं नु लोके स्याद्युवयोः संहितात्मनोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040628, "chapter_id": 1900, "verse_number": "५-१४५-११", "content_sanskrit": "कर्ण शोभिष्यसे नूनं पञ्चमिर्भ्रातृभिर्वृतः।\nदेवैः परिवृतो ब्रह्मा वेद्यामिव महाध्वरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040629, "chapter_id": 1900, "verse_number": "५-१४५-१२", "content_sanskrit": "उपपद्यो गुणैः सर्वैर्ज्येष्ठः श्रेष्ठेषु बन्धुषु ।\nसूतपुत्रेति मा शब्दः पार्थस्त्वमसि वीर्यवान् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040630, "chapter_id": 1900, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि पञ्चचत्वारिंशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]