[{"id": 2000928, "chapter_id": 1004, "verse_number": "१-५-०x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2000929, "chapter_id": 1004, "verse_number": "१-५-१", "content_sanskrit": "पुराणमखिलं तात पिता तेऽधीतवान्पुरा।\nभारताध्ययनं सर्वं कृष्णद्वैपायनात्तदा।\nकच्चित्त्वमपि तत्सर्वमधीषे रौमहर्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2000930, "chapter_id": 1004, "verse_number": "१-५-२", "content_sanskrit": "पुराणे हि कथा दिव्या आदिवंशाश्च धीमताम्।\nकथ्यन्ते ये पुराऽस्माभिः श्रुतपूर्वाः पितुस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2000931, "chapter_id": 1004, "verse_number": "१-५-३", "content_sanskrit": "तत्र वंशमहं पूर्वं श्रोतुमिच्छामि भार्गवम्।\nकथयस्व कथामेतां कल्याः स्मः श्रवणे तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2000932, "chapter_id": 1004, "verse_number": "१-५-४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2000933, "chapter_id": 1004, "verse_number": "१-५-४", "content_sanskrit": "यदधीतं पुरा सम्यग्द्विजश्रेष्ठैर्महात्मभिः।\nवैशम्पायनविप्राग्र्यैस्तैश्चापि कथितं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2000934, "chapter_id": 1004, "verse_number": "१-५-५", "content_sanskrit": "यदधीतं च पित्रा मे सम्यक्कैव ततो मया।\nतावच्छृणुष्व यो देवैः सेन्द्रैः सर्षिमरुद्गणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2000935, "chapter_id": 1004, "verse_number": "१-५-६", "content_sanskrit": "पूजितः प्रवरो वंशो भार्गवो भृगुनन्दन।\nइमं वंशमहं पूर्वं भार्गवं ते महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2000936, "chapter_id": 1004, "verse_number": "१-५-७", "content_sanskrit": "निगदामि यथायुक्तं पुराणाश्रयसंयुतम्।\nभृगुर्महर्षिर्भगवान्ब्रह्मणा वै स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2000937, "chapter_id": 1004, "verse_number": "१-५-८", "content_sanskrit": "वरुणस्य क्रतौ जातः पावकादिति नः श्रुतम्।\nभृगोः सुदयितः पुत्रश्च्यवनो नाम भार्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2000938, "chapter_id": 1004, "verse_number": "१-५-९", "content_sanskrit": "च्यवनस्य च दायादः प्रमतिर्नाम धार्मिकः।\nप्रमतेरप्यभूत्पुत्रो घृताच्यां रुरुरित्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2000939, "chapter_id": 1004, "verse_number": "१-५-१०", "content_sanskrit": "रुरोरपि सुतो जज्ञे शुनको वेदपारगः।\nप्रमद्वरायां धर्मात्मा तव पूर्वपितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2000940, "chapter_id": 1004, "verse_number": "१-५-११", "content_sanskrit": "तपस्वी च यशस्वी च श्रुतवान्ब्रह्मवित्तमः।\nधार्मिकः सत्यवादी च नियतो नियताशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2000941, "chapter_id": 1004, "verse_number": "१-५-१२x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2000942, "chapter_id": 1004, "verse_number": "१-५-१२", "content_sanskrit": "सूतपुत्र यथा तस्य भार्गवस्य महात्मनः।\nच्यवनत्वं परिख्यातं तन्ममाचक्ष्व पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2000943, "chapter_id": 1004, "verse_number": "१-५-१३x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2000944, "chapter_id": 1004, "verse_number": "१-५-१३", "content_sanskrit": "भृगोः सुदयिता भार्या पुलोमेत्यभिविश्रुता।\nतस्यां समभवद्गर्भो भृगुवीर्यसमुद्भवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2000945, "chapter_id": 1004, "verse_number": "१-५-१४", "content_sanskrit": "तस्मिन्गर्भेऽथ संभूते पुलोमायां भृगूद्वह।\nसमये समशीलिन्यां धर्मपत्न्यां यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2000946, "chapter_id": 1004, "verse_number": "१-५-१५", "content_sanskrit": "अभिषेकाय निष्क्रान्ते भृगौ धर्मभृतां वरे।\nआश्रमं तस्य रक्षोऽथ पुलोमाऽभ्याजगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2000947, "chapter_id": 1004, "verse_number": "१-५-१६", "content_sanskrit": "तं प्रविश्याश्रमं दृष्ट्वा भृगोर्भार्यामनिन्दिताम्।\nहृच्छयेन समाविष्टो विचेताः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2000948, "chapter_id": 1004, "verse_number": "१-५-१७", "content_sanskrit": "अभ्यागतं तु तद्रक्षः पुलोमा चारुदर्शना।\nन्यमन्त्रयत वन्येन फलमूलादिना तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2000949, "chapter_id": 1004, "verse_number": "१-५-१८", "content_sanskrit": "तां तु रक्षस्तदा ब्रह्मन्हृच्छयेनाभिपीडितम्।\nदृष्ट्वा हृष्टमभूद्राजञ्जिहीर्षुस्तामनिन्दिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2000950, "chapter_id": 1004, "verse_number": "१-५-१९", "content_sanskrit": "जातमित्यब्रवीत्कार्यं जिहीर्षुर्मुदितः शुभाम्।\nसा हि पूर्वं वृता तेन पुलोम्ना तु शुचिस्मिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2000951, "chapter_id": 1004, "verse_number": "१-५-२०", "content_sanskrit": "तां तु प्रादात्पिता पश्चाद्भृगवे शास्त्रवत्तदा।\nतस्य तत्किल्बिषं नित्यं हृदि वर्तति भार्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2000952, "chapter_id": 1004, "verse_number": "१-५-२१", "content_sanskrit": "इदमन्तरमित्येवं हर्तुं चक्रे मनस्तदा।\nअथाग्निशरणेऽपश्यज्ज्वलन्तं जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2000953, "chapter_id": 1004, "verse_number": "१-५-२२", "content_sanskrit": "तमपृच्छत्ततो रक्षः पावकं ज्वलितं तदा।\nशंस मे कस्य भार्येयमग्ने पृच्छे ऋतेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2000954, "chapter_id": 1004, "verse_number": "१-५-२३", "content_sanskrit": "मुखं त्वमसि देवानां वद पावक पृच्छते।\nमया हीयं वृता पूर्वं भार्यार्थे वरवर्णिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2000955, "chapter_id": 1004, "verse_number": "१-५-२४", "content_sanskrit": "पश्चादिमां पिता प्रादाद्भृगवेऽनृतकारकः।\nसेयं यदि वरारोहा भृगोर्भार्या रहोगता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2000956, "chapter_id": 1004, "verse_number": "१-५-२५", "content_sanskrit": "तथा सत्यं समाख्याहि जिहीर्षाम्याश्रमादिमाम्।\nस मन्युस्तत्र हृदयं प्रदहन्निव तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2000957, "chapter_id": 1004, "verse_number": "१-५-२६", "content_sanskrit": "मत्पूर्वभार्यां यदिमां भृगुराप सुमध्यमाम्।\nअसंमतमिदं मेऽद्य हरिष्याम्याश्रमादिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2000958, "chapter_id": 1004, "verse_number": "१-५-२७x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2000959, "chapter_id": 1004, "verse_number": "१-५-२७", "content_sanskrit": "एवं रक्षस्तमामन्त्र्य ज्वलितं जातवेदसम्।\nशङ्कमानं भृगोर्भार्यां पुनःपुनरपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2000960, "chapter_id": 1004, "verse_number": "१-५-२८", "content_sanskrit": "त्वमग्ने सर्वभूतानामन्तश्चरसि नित्यदा।\nसाक्षिवत्पुण्यपापेषु सत्यं ब्रूहि कवे वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2000961, "chapter_id": 1004, "verse_number": "१-५-२९", "content_sanskrit": "मत्पूर्वभार्याऽपहृता भृगुणाऽनृतकारिणा।\nसेयं यदि तथा मे त्वं सत्यमाख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2000962, "chapter_id": 1004, "verse_number": "१-५-३०", "content_sanskrit": "श्रुत्वा त्वत्तो भृगोर्भार्यां हरिष्याम्याश्रमादिमाम्।\nजातवेदः पश्यतस्ते वद सत्यां गिरं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2000963, "chapter_id": 1004, "verse_number": "१-५-३१x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2000964, "chapter_id": 1004, "verse_number": "१-५-३१", "content_sanskrit": "तस्यैतद्वचनं श्रुत्वा सप्तार्चिर्दुःखितोऽभवत्।\nसत्यं वदामि यदि मे शापः स्याद्ब्रह्मवित्तमात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2000965, "chapter_id": 1004, "verse_number": "१-५-३२", "content_sanskrit": "असत्यं चेदहं ब्रूयां पतिष्ये नरकान्ध्रुवम्।\nभीतोऽनृताच्च शापाच्च भृगोरित्यब्रवीच्छनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2000966, "chapter_id": 1004, "verse_number": "१-५-३३", "content_sanskrit": "त्वया वृता पुलोमेयं पूर्वं दानवनन्दन।\nकिं त्वियं विधिना पूर्वं मन्त्रवन्न वृता त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2000967, "chapter_id": 1004, "verse_number": "१-५-३४", "content_sanskrit": "पित्रा तु भृगवे दत्ता पुलोमेयं यशस्विनी।\nददाति न पिता तुभ्यं वरलोभान्महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2000968, "chapter_id": 1004, "verse_number": "१-५-३५", "content_sanskrit": "अथेमां वेददृष्टेन कर्मणा विधिपूर्वकम्।\nभार्यामृषिर्भृगुः प्राप मां पुरस्कृत्य दानव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2000969, "chapter_id": 1004, "verse_number": "१-५-३६", "content_sanskrit": "सेयमित्यवगच्छामि नानृतं वक्तुमुत्सहे।\nनानृतं हि सदा लोके पूज्यते दानवोत्तम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2000970, "chapter_id": 1004, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि पौलोमपर्वणि पञ्चमोऽध्यायः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]