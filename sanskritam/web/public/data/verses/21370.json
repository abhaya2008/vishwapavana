[{"id": 7001370000, "chapter_id": 21370, "verse_number": "५-१७-१", "content_sanskrit": "सनत्कुमार उवाच ।\nपाराशर्य्य सुसंक्षेपाच्छृणु त्वं वदतो मम ।\nमण्डलं च भुवस्सम्यक् सप्तद्वीपादिसंयुतम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001370001, "chapter_id": 21370, "verse_number": "५-१७-२", "content_sanskrit": "जंबू प्लक्षश्शाल्मलिश्च कुशः क्रौञ्चश्च शाककः ।\nपुष्पकस्सप्तमस्सर्वे समुद्रैस्सप्तभिर्वृताः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001370002, "chapter_id": 21370, "verse_number": "५-१७-३", "content_sanskrit": "लवणेक्षुरसौ सर्पिर्दविदुग्धजलाशयाः ।\nजम्बुद्वीपस्समस्तानामेतेषां मध्यतः स्थितः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001370003, "chapter_id": 21370, "verse_number": "५-१७-४", "content_sanskrit": "तस्यापि मेरुः कालेयमध्ये कनकपर्वतः ।\nप्रविष्टः षोडशाधस्ताद्योजनैस्तस्य चोच्छ्रयः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001370004, "chapter_id": 21370, "verse_number": "५-१७-५", "content_sanskrit": "चतुरशीतिमानैस्तैर्द्वात्रिंशन्मूर्ध्नि विस्तृतः ।\nभूमिपृष्ठस्थशैलोऽयं विस्तरस्तस्य सर्वतः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001370005, "chapter_id": 21370, "verse_number": "५-१७-६", "content_sanskrit": "मूले षोडशसाहस्रः कर्णिकाकार संस्थितः ।\nहिमवान् हेमकूटश्च निषधश्चास्य दक्षिणे॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001370006, "chapter_id": 21370, "verse_number": "५-१७-७", "content_sanskrit": "नीलः श्वेतश्च शृङ्गी च उत्तरे वर्षपर्वताः ।\nदशसाहस्रिकं ह्येते रत्नवंतोऽरुणप्रभाः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001370007, "chapter_id": 21370, "verse_number": "५-१७-८", "content_sanskrit": "सहस्रयोजनोत्सेधास्तावद्विस्तारिणश्च ते ।\nभारतं प्रथमं वर्षं ततः किंपुरुषं स्मृतम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001370008, "chapter_id": 21370, "verse_number": "५-१७-९", "content_sanskrit": "हरिवर्षं ततो ऽन्यद्वै मेरोर्दक्षिणतो मुने ।\nरम्यकं चोत्तरे पार्श्वे तस्यांशे तु हिरण्मयम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001370009, "chapter_id": 21370, "verse_number": "५-१७-१०", "content_sanskrit": "उत्तरे कुरवश्चैव यथा वै भारतं तथा ।\nनवसाहस्रमेकैकमेतेषां मुनिसत्तम॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001370010, "chapter_id": 21370, "verse_number": "५-१७-११", "content_sanskrit": "इलावृतं तु तन्मध्ये तन्मध्ये मेरुरुच्छ्रितः ।\nमेरोश्चतुर्द्दिशं तत्र नवसाहस्रमुच्छ्रितम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001370011, "chapter_id": 21370, "verse_number": "५-१७-१२", "content_sanskrit": "इलावृतमृषिश्रेष्ठ चत्वारश्चात्र पर्वताः ।\nविष्कंभा रचिता मेरोर्योजिताः पुनरुच्छ्रिताः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001370012, "chapter_id": 21370, "verse_number": "५-१७-१३", "content_sanskrit": "पूर्वे हि मन्दरो नाम दक्षिणे गन्धमादनः ।\nविपुलः पश्चिमे भागे सुपार्श्वश्चोत्तरे स्थितः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001370013, "chapter_id": 21370, "verse_number": "५-१७-१४", "content_sanskrit": "कदंबो जंबुवृक्षश्च पिप्पलो वट एव च ।\nएकादशशतायामाः पादपा गिरिकेतवः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001370014, "chapter_id": 21370, "verse_number": "५-१७-१५", "content_sanskrit": "जम्बूद्वीपस्य नाम्नो वै हेतुं शृणु महामुने ।\nविराजंते महावृक्षास्तत्स्वभावं वदामि ते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001370015, "chapter_id": 21370, "verse_number": "५-१७-१६", "content_sanskrit": "महागज प्रमाणानि जम्ब्वास्तस्याः फलानि च ।\nपतंति भूभृतः पृष्ठे शीर्य्यमाणानि सर्वतः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001370016, "chapter_id": 21370, "verse_number": "५-१७-१७", "content_sanskrit": "रसेन तेषां विख्याता जम्बूनदीति वै ।\nपरितो वर्तते तत्र पीयते तन्निवासिभिः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001370017, "chapter_id": 21370, "verse_number": "५-१७-१८", "content_sanskrit": "न स्वेदो न च दौर्गंध्यं न जरा चेन्द्रियग्रहः ।\nतस्यास्तटे स्थितानान्तु जनानां तन्न जायते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001370018, "chapter_id": 21370, "verse_number": "५-१७-१९", "content_sanskrit": "तीरमृत्स्नां च सम्प्राप्य मुखवायुविशोषिताम् ।\nजाम्बूनदाख्यं भवति सुवर्णं सिद्धभूषणम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001370019, "chapter_id": 21370, "verse_number": "५-१७-२०", "content_sanskrit": "भद्राश्वं पूर्वतो मेरोः केतुमालं च पश्चिमे ।\nवर्षे द्वे तु मुनिश्रेष्ठ तयोर्मध्य इलावृतम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001370020, "chapter_id": 21370, "verse_number": "५-१७-२१", "content_sanskrit": "वनं चैत्ररथं पूर्वे दक्षिणे गन्धमादनः ।\nविभ्राजं पश्चिमे तद्वदुत्तरे नन्दनं स्मृतम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001370021, "chapter_id": 21370, "verse_number": "५-१७-२२", "content_sanskrit": "अरुणोदं महाभद्रं शीतोदं मानसं स्मृतम् ।\nसरांस्येतानि चत्वारि देवभोग्यानि सर्वशः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001370022, "chapter_id": 21370, "verse_number": "५-१७-२३", "content_sanskrit": "शीतांजनः कुरुंगश्च कुररो माल्यवांस्तथा ।\nचैकैकप्रमुखा मेरोः पूर्वतः केसराचलाः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001370023, "chapter_id": 21370, "verse_number": "५-१७-२४", "content_sanskrit": "त्रिकूटश्शिशिरश्चैव पतंगो रुचकस्तथा ।\nनिषधः कपिलायाश्च दक्षिणे केसराचलाः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001370024, "chapter_id": 21370, "verse_number": "५-१७-२५", "content_sanskrit": "सिनी वासः कुसुंभश्च कपिलो नारदस्तथा ।\nनागादयश्च गिरयः पश्चिमे केसराचलाः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001370025, "chapter_id": 21370, "verse_number": "५-१७-२६", "content_sanskrit": "शंखचूडोऽथ ऋषभो हंसो नाम महीधरः ।\nकालंजराद्याश्च तथा उत्तरे केसराचलाः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001370026, "chapter_id": 21370, "verse_number": "५-१७-२७", "content_sanskrit": "मेरोरुपरि मध्ये हि शातकौंभं विधेः पुरम् ।\nचतुर्द्दशसहस्राणि योजनानि च संख्यया॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001370027, "chapter_id": 21370, "verse_number": "५-१७-२८", "content_sanskrit": "अष्टानां लोकपालानां परितस्तदनुक्रमात् ।\nयथादिशं यथारूपं पुरोऽष्टावुपकल्पिताः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001370028, "chapter_id": 21370, "verse_number": "५-१७-२९", "content_sanskrit": "तस्यां च ब्रह्मणः पुर्य्यां पातयित्वेन्दुमण्डलम् ।\nविष्णुपादविनिष्क्रांता गंगा पतति वै नदी॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001370029, "chapter_id": 21370, "verse_number": "५-१७-३०", "content_sanskrit": "सीता चालकनंदा च चक्षुर्भद्रा च वै क्रमात् ।\nसा तत्र पतिता दिक्षु चतुर्द्धा प्रत्यपद्यत॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001370030, "chapter_id": 21370, "verse_number": "५-१७-३१", "content_sanskrit": "सीता पूर्वेण शैलं हि नन्दा चैव तु दक्षिणे ।\nसा चक्षुः पश्चिमे चैव भद्रा चोत्तरतो व्रजेत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001370031, "chapter_id": 21370, "verse_number": "५-१७-३२", "content_sanskrit": "गिरीनतीत्य सकलांश्चतुर्द्दिक्षु महांबुधिम् ।\nसा ययौ प्रयता सूता गंगा त्रिपथगामिनी॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001370032, "chapter_id": 21370, "verse_number": "५-१७-३३", "content_sanskrit": "सुनीलनिषधौ यौ तौ माल्यवद्गन्धमादनौ ।\nतेषां मध्यगतो मेरुः कर्णिकाकारसंस्थितः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001370033, "chapter_id": 21370, "verse_number": "५-१७-३४", "content_sanskrit": "भारतः केतुमालश्च भद्राश्वः कुरवस्तथा ।\nपत्राणि लोकपद्मस्य मर्यादालोकपर्वताः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001370034, "chapter_id": 21370, "verse_number": "५-१७-३५", "content_sanskrit": "जठरं देवकूटश्च आयामे दक्षिणोत्तरे ।\nगन्धमादनकैलासौ पूर्वपश्चिमतो गतौ॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001370035, "chapter_id": 21370, "verse_number": "५-१७-३६", "content_sanskrit": "पूर्वपश्चिमतो मेरोर्निषधो नीलपर्वतः ।\nदक्षिणोत्तरमायातौ कर्णिकांतर्व्यवस्थितौ॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001370036, "chapter_id": 21370, "verse_number": "५-१७-३७", "content_sanskrit": "जठराद्याः स्थिता मेरोर्येषां द्वौ द्वौ व्यवस्थितौ ।\nकेसराः पर्वता एते श्वेताद्याः सुमनोरमाः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001370037, "chapter_id": 21370, "verse_number": "५-१७-३८", "content_sanskrit": "शैलानामुत्तरे द्रोण्यस्सिद्धचारणसेविताः ।\nसुरम्याणि तथा तासु काननानि पुराणि च॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001370038, "chapter_id": 21370, "verse_number": "५-१७-३९", "content_sanskrit": "सर्वेषां चैव देवानां यक्षगंधर्वरक्षसाम् ।\nक्रीडंति देवदैतेयाश्शैलप्रायेष्वहर्निशम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001370039, "chapter_id": 21370, "verse_number": "५-१७-४०", "content_sanskrit": "धर्मिणामालया ह्येते भौमास्स्वर्गाः प्रकीर्तिताः ।\nन तेषु पापकर्तारो यांति पश्यंति कुत्रचित्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001370040, "chapter_id": 21370, "verse_number": "५-१७-४१", "content_sanskrit": "यानि किंपुरुषादीनि वर्षाण्यष्टौ महामुने ।\nन तेषु शोको नापत्त्यो नोद्वेगः क्षुद्भयादिकम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001370041, "chapter_id": 21370, "verse_number": "५-१७-४२", "content_sanskrit": "स्वस्थाः प्रजा निरातंकास्सर्वदुःखविवर्जिताः ।\nदशद्वादशवर्षाणां सहस्राणि स्थिरायुषः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001370042, "chapter_id": 21370, "verse_number": "५-१७-४३", "content_sanskrit": "कृतत्रेतादिकाश्चैव भौमान्यंभांसि सर्वतः ।\nन तेषु वर्षते देवस्तेषु स्थानेषु कल्पना॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001370043, "chapter_id": 21370, "verse_number": "५-१७-४४", "content_sanskrit": "सप्तस्वेतेषु नद्यश्च सुजातास्स्वर्णवा लुकाः ।\nशतशस्संति क्षुद्राश्च तासु क्रीडारता जनाः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]