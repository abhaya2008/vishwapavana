[{"id": 2146184, "chapter_id": 4152, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146185, "chapter_id": 4152, "verse_number": "१", "content_sanskrit": "तदा दूतैः समाज्ञाय आयान्तं मधुसूदनम् ।\nधृतराष्ट्रोऽब्रवीद् भीष्ममर्चयित्वा महाभुजम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146186, "chapter_id": 4152, "verse_number": "२", "content_sanskrit": "द्रोणं च सञ्जयं चैव विदुरं च महामतिम् ।\nदुर्योधनं सहामात्यं हृष्टरोमाऽब्रवीदिदम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146187, "chapter_id": 4152, "verse_number": "३", "content_sanskrit": "अद्भुतं महदाश्चर्यं श्रूयते कुरुनन्दन ।\nस्त्रियो बालाश्च वृद्धाश्च कथयन्ति गृहे गृहे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146188, "chapter_id": 4152, "verse_number": "४", "content_sanskrit": "सत्कृत्याचक्षते चान्ये तथैवान्ये समागताः ।\nपृथग्वादाश्च वर्तन्ते चत्वरेषु सभासु च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146189, "chapter_id": 4152, "verse_number": "५", "content_sanskrit": "उपयास्यति दाशार्हः पाण्डवार्थे पराक्रमी ।\nस नो मान्यश्च पूज्यश्च सर्वथा मधुसूदनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146190, "chapter_id": 4152, "verse_number": "६", "content_sanskrit": "तस्मिन् हि यात्रा लोकस्य भूतानामीश्वरो हि सः ।\nतस्मिन् धृतिश्च वीर्यं च प्रज्ञा चौजश्च माधवे\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146191, "chapter_id": 4152, "verse_number": "७", "content_sanskrit": "स मान्यतां नरश्रेष्ठः स हि धर्मः सनातनः ।\nपूजितो हि सुखाय स्यादसुखायाप्यपूजितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146192, "chapter_id": 4152, "verse_number": "८", "content_sanskrit": "स चेत् तुष्यति दाशार्ह उपचारैररिन्दमः ।\nकृष्णात् सर्वानभिप्रायान् वयं लप्स्यामहे नृषु\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146193, "chapter_id": 4152, "verse_number": "९", "content_sanskrit": "तस्य पूजार्थमद्यैव संविधत्स्व परन्तप ।\nसभाः पथि विधीयन्तां सर्वकामसमन्विताः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146194, "chapter_id": 4152, "verse_number": "१०", "content_sanskrit": "यथा प्रीतिर्महाबाहो त्वयि जायेत तस्य वै ।\nतथा कुरुष्व गान्धारे कथं वा भीष्म मन्यसे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146195, "chapter_id": 4152, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146196, "chapter_id": 4152, "verse_number": "११", "content_sanskrit": "ततो भीष्मादयः सर्वे धृतराष्ट्रं जनाधिपम् ।\nऊचुः परममित्येव पूजयन्तोऽस्य तद्वचः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146197, "chapter_id": 4152, "verse_number": "१२", "content_sanskrit": "तेषामनुमतं ज्ञात्वा राजा दुर्योधनस्तदा ।\nसभावास्तूनि रम्याणि प्रदेष्टुमुपचक्रमे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146198, "chapter_id": 4152, "verse_number": "१३", "content_sanskrit": "ततो देशेषु देशेषु रमणीयेषु भागशः ।\nसर्वरत्नसमाकीर्णाः सभाश्चक्रुरनेकशः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146199, "chapter_id": 4152, "verse_number": "१४", "content_sanskrit": "आसनानि विचित्राणि युतानि विविधैर्गुणैः ।\nस्त्रियो गन्धानलङ्कारान् वासांसि विविधानि च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146200, "chapter_id": 4152, "verse_number": "१५", "content_sanskrit": "गुणवन्त्यन्नपानानि भोज्यानि विविधानि च ।\nमाल्यानि च सुगन्धीनि तानि राजा ददौ ततः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146201, "chapter_id": 4152, "verse_number": "१६", "content_sanskrit": "विशेषतश्च वासार्थं सभां ग्रामे कुशस्थले ।\nविदधे कौरवो राजा बहुरत्नां मनोरमाम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146202, "chapter_id": 4152, "verse_number": "१७", "content_sanskrit": "एतद् विधाय वै सर्वं देवार्हमतिमानुषम् ।\nआचख्यौ धृतराष्ट्राय राजा दुर्योधनस्तथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146203, "chapter_id": 4152, "verse_number": "१८", "content_sanskrit": "ताः सभाः केशवः सर्वा रत्नानि विविधानि च ।\nअसमीक्ष्यैव दाशार्ह उपायात् कुरुसद्म तत्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146204, "chapter_id": 4152, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि त्र्यशीतितमोऽध्यायः ॥८३॥\nभगवद्यानपर्वणि चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]