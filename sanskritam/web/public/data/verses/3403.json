[{"id": 2111064, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "वसुमनाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2111065, "chapter_id": 3403, "verse_number": "१", "content_sanskrit": "पृच्छामि त्वां वसुमनैक्ष्वाकवोऽस्मि\nयदि सन्ति लोका दिवि मे नरेन्द्र ।\nयद्यन्तरिक्षे प्रथिता महात्मन्\nक्षेत्रज्ञं त्वां तस्य धर्मस्य मन्ये\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2111066, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2111067, "chapter_id": 3403, "verse_number": "२", "content_sanskrit": "यदन्तरिक्षं पृथिवीं दिवं च\nयत्तेजसा तपते भानुमांश्च ।\nलोकास्तावन्तो दिवि संस्थिता वै\nते तावन्तस्त्वां प्रतिपालयन्ति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2111068, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "वसुमनाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2111069, "chapter_id": 3403, "verse_number": "३", "content_sanskrit": "तांस्ते ददामि मा प्रपत प्रपातं\nये मे लोकास्तव ते वै भवन्तु ।\nक्रीणीष्वैनांस्तृणकेनापि हन्त\nप्रतिग्रहो यदि राजन् नैष इष्टः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2111070, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2111071, "chapter_id": 3403, "verse_number": "४", "content_sanskrit": "न मिथ्याऽहं विक्रयं ते वृणोमि \tयथा गृहीतं शिशुके शङ्कमानः ।\nकुर्यां न चैवाकृतपूर्वमन्यैर्विवित्समानः किमुतात्र साधु\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2111072, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "वसुमनाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2111073, "chapter_id": 3403, "verse_number": "५", "content_sanskrit": "तांस्त्वं लोकान् प्रतिपद्यस्व राजन्\nमया दत्तान् यदि नेष्टः क्रयस्ते ।\nन चाप्यहं तान् प्रतिपद्ये च दत्वा\nयत्र गन्ता त्वमपहायात्मलोकम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2111074, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2111075, "chapter_id": 3403, "verse_number": "६", "content_sanskrit": "यदा त्वमिन्द्रप्रतिमप्रभाव-\nस्ते चाप्यनन्ता नरदेव लोकाः ।\nतथाऽन्यलोके न रमेऽन्यदत्ते\nतस्मात् सदा नाभिनन्दामि दायम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2111076, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "शिविः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2111077, "chapter_id": 3403, "verse_number": "७", "content_sanskrit": "अहं शिविर्मा प्रपत प्रपातं\nपृच्छामि त्वां मम राजेन्द्र लोकाः ।\nयद्यन्तरिक्षे यदि वा दिवि श्रिताः\nतानाक्रमस्वाशु महेन्द्रकल्प \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2111078, "chapter_id": 3403, "verse_number": "८", "content_sanskrit": "पृच्छामि त्वां शिविरौशीनरोऽस्मि\nमम लोका ये पार्थिवस्तत्र सन्ति ।\nयद्यन्तरिक्षे यदि वा दिवि श्रिताः\nक्षेत्रज्ञं त्वां तस्य धर्मस्य मन्ये\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2111079, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2111080, "chapter_id": 3403, "verse_number": "९", "content_sanskrit": "नेमान् वाचा हृदयेन वापि\nपरीप्समानस्तव मन्ये नरेन्द्र ।\nते चानन्ता दिवि लोकाः श्रितास्ते\nविद्युद्रूपाः स्वनवन्तो नरेन्द्र\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2111081, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "शिविः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2111082, "chapter_id": 3403, "verse_number": "१०", "content_sanskrit": "तांस्ते ददामि मा प्रपत प्रपातं\nये मे लोका दिवि राजेन्द्र सन्ति ।\nयद्यन्तरिक्षे यदि वा दिवि श्रिताः\nतानाक्रमस्व प्रददाम्यहं ते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2111083, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2111084, "chapter_id": 3403, "verse_number": "११", "content_sanskrit": "यथा त्वमिन्द्रप्रतिमप्रभावः\nते चाप्यनन्ता नरदेव लोकाः ।\nतथाऽन्यलोके न रमेऽन्यदत्ते\nतस्माच्छिवे नाभिनन्दामि दायम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2111085, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2111086, "chapter_id": 3403, "verse_number": "१२", "content_sanskrit": "न चेदेकैकशो राजंल्लोकान्नः प्रतिगृह्णसि ।\nसर्वे प्रदाय भवते गन्तारो नरकं वयम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2111087, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2111088, "chapter_id": 3403, "verse_number": "१३", "content_sanskrit": "तदर्हाय ददध्वं वै सतः सत्यानृशंस्यतः ।\nअहं तु नाभिगृह्णामि यत् कृतं न मया पुरा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2111089, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2111090, "chapter_id": 3403, "verse_number": "१४", "content_sanskrit": "कस्यैते प्रतिदृश्यन्ते रथाः पञ्च हिरण्मयाः ।\nउच्चैः सन्तः प्रकाशन्ते ज्वलन्तोऽग्निशिखा इव\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2111091, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2111092, "chapter_id": 3403, "verse_number": "१५", "content_sanskrit": "युष्मानेते वहिष्यन्ति रथाः पञ्च हिरण्मयाः ।\nउच्चैः सन्तः प्रकाशन्ते ज्वलन्तोऽग्निशिखा इव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2111093, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2111094, "chapter_id": 3403, "verse_number": "१६", "content_sanskrit": "अश्वमेधे महायज्ञे स्वयम्भुविहिते पुरा ।\nहयस्य यानि चाङ्गानि हूयन्त च यथाक्रमम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2111095, "chapter_id": 3403, "verse_number": "१७", "content_sanskrit": "होताऽध्वर्युस्तथोद्गाता ब्रह्मणा मह भारत ।\nअग्नौ प्रास्यन्ति विधिवत् समस्ताः षोडशर्त्विजः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2111096, "chapter_id": 3403, "verse_number": "१८", "content_sanskrit": "धूमगन्धं वपायास्तु ये जिघ्रन्ति नरा भुवि ।\nविमुक्तपापाः पूतास्ते तत्क्षणेनाभवन् नृप\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2111097, "chapter_id": 3403, "verse_number": "१९", "content_sanskrit": "एतस्मिन्नन्तरे चैव माधवी तु तपोधना ।\nमृगचर्मपरीताङ्गी परिणामे मृगव्रता \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2111098, "chapter_id": 3403, "verse_number": "२०", "content_sanskrit": "मृगैः सह चरन्ती सा मृगाहारविचेष्टिता ।\nयज्ञवाटं मृगगणैः प्रविश्य भृशविस्मिता\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2111099, "chapter_id": 3403, "verse_number": "२१", "content_sanskrit": "आघ्रायन्ती धूमगन्धं मृगैरेव चचार सा ।\nयज्ञवाटमटन्ती सा पुत्रांस्तानपराजितान् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2111100, "chapter_id": 3403, "verse_number": "२१", "content_sanskrit": "पश्यन्ती यज्ञमाहात्म्यं मुदं लेभे च माधवी ।\nअसंस्पृशन्तं वसुधां ययातिं नाहुषं तदा \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2111101, "chapter_id": 3403, "verse_number": "२३", "content_sanskrit": "दिवः सम्प्राप्तमाज्ञाय ववन्दे पितरं तदा ।\nततो वसुमनाऽपृच्छन्मातरं वै तपस्विनीम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2111102, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "वसुमनाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2111103, "chapter_id": 3403, "verse_number": "२४", "content_sanskrit": "भवत्या यत् कृतमिदं वन्दनं वरवर्णिनि ।\nकोऽयं देवोपमो राजा यदि जानासि मे वद\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2111104, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "माधवी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2111105, "chapter_id": 3403, "verse_number": "२५", "content_sanskrit": "शृणुध्वं सहिताः पुत्रा नाहुषोऽयं पिता मम ।\nययातिर्मम पुत्राणां मातामह इति श्रुतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2111106, "chapter_id": 3403, "verse_number": "२६", "content_sanskrit": "पूरुं मे भ्रातरं राज्ये समावेश्य दिवं गतः ।\nकेन वा कारणेनैव इह प्राप्तो महायशाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2111107, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2111108, "chapter_id": 3403, "verse_number": "२७", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा मा मा भ्रष्टेति चाब्रवीत् ।\nसा पुत्रस्य वचः श्रुत्वा सन्नमाविष्टचेतना \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2111109, "chapter_id": 3403, "verse_number": "२८", "content_sanskrit": "माधवी पितरं प्राह दौहित्रपरिवारितम् ।\nतपसा निर्जिताँल्लोकान् प्रतिगृह्णीष्व मामकान् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2111110, "chapter_id": 3403, "verse_number": "२९", "content_sanskrit": "पुत्राणामपि पौत्राणां धर्मादधिगतं धनम् ।\nस्वार्थमेव वदन्तीह ऋषयो धर्मपालकाः ।\nतस्माद् दानेन तपसा अस्माकं दिवमाव्रज\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2111111, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2111112, "chapter_id": 3403, "verse_number": "३०", "content_sanskrit": "यदि धर्मफलं ह्येतच्छोभनं भविता तथा ।\nदुहित्रा चैव दौहित्रैस्तारितोऽहं महात्मभिः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2111113, "chapter_id": 3403, "verse_number": "३१", "content_sanskrit": "तस्मात् पवित्रं दौहित्रमद्यप्रभृति पैतृके ।\nभविष्यति न सन्देहः पितॄणां प्रीतिवर्धनम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2111114, "chapter_id": 3403, "verse_number": "३२", "content_sanskrit": "त्रीणि श्राद्धे पवित्राणि दौहित्रः कुतपस्तिलाः ।\nत्रीणि चात्र प्रशंसन्ति शौचमक्रोधमत्वराम् \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2111115, "chapter_id": 3403, "verse_number": "३३", "content_sanskrit": "भोक्तारः परिवेष्टारः श्रापितारः पवित्रकाः ।\nदिवसस्याष्टमे भागे मन्दीभवति भास्करे \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2111116, "chapter_id": 3403, "verse_number": "३४", "content_sanskrit": "स कालः कुतपो नाम पितॄणां दत्तमक्षयम् ।\nतिलाः पिशाचाद् रक्षन्ति दर्भा रक्षन्ति राक्षसात् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2111117, "chapter_id": 3403, "verse_number": "३५", "content_sanskrit": "रक्षन्ति श्रोत्रियाः पङ्क्तिं यतिभिर्भुक्तमक्षयम् ।\nलब्ध्वा पात्रं तु विद्वांसं श्रोत्रियं सुव्रतं शुचिम् ।\nस काले कालतो दत्तं नान्यथा काल इष्यते \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2111118, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2111119, "chapter_id": 3403, "verse_number": "३६", "content_sanskrit": "एवमुक्त्वा ययातिस्तु पुनः प्रोवाच बुद्धिमान् ।\nसर्वे ह्यवभृथस्नातास्त्वरध्वं कार्यगौरवात् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2111120, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2111121, "chapter_id": 3403, "verse_number": "३७", "content_sanskrit": "आतिष्ठस्व रथं राजन् विक्रमस्व विहायसम् ।\nवयमप्यत्र यास्यामो यदा कालो भविष्यति\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2111122, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2111123, "chapter_id": 3403, "verse_number": "३८", "content_sanskrit": "सर्वैरिदानीं गन्तव्यं सह स्वर्गमितो वयम् ।\nएष नो विरजाः पन्था दृश्यते देवसद्मनः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2111124, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2111125, "chapter_id": 3403, "verse_number": "३९", "content_sanskrit": "अष्टकश्च शिविश्चैव काशिराजः प्रतर्दनः ।\nऐक्ष्वाकवो वसुमनाश्चत्वारो भूमिपाश्च ह \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2111126, "chapter_id": 3403, "verse_number": "४०", "content_sanskrit": "सर्वे ह्यवभृथस्नाताः स्वर्गताः साधवः सह ।\nतेऽधिरुह्य रथान् सर्वे प्रयाता नृपसत्तमाः ।\nआक्रमन्तो दिवं भान्ति धर्मेणावृत्य रोदसी\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2111127, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2111128, "chapter_id": 3403, "verse_number": "४१", "content_sanskrit": "अहं मन्ये स्वर्गतानां वरिष्ठः\nसखा चेन्द्रः सर्वथा वै महात्मा ।\nकस्मादेष शिविरौशीनरोऽय-\nमेकोऽतिगः सर्वमस्मान् व्यपोह्य\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2111129, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2111130, "chapter_id": 3403, "verse_number": "४२", "content_sanskrit": "अददद् याचमानाय यावद्वित्तमविन्दत ।\nउशीनरस्य पुत्रोऽयं तस्माच्छ्रेष्ठो हि नः शिविः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2111131, "chapter_id": 3403, "verse_number": "४३", "content_sanskrit": "दानं तपः सत्यमथाऽपि धर्मो\nह्रीः श्रीः क्षमा सौम्यभावस्तितिक्षा ।\nराजन्नेतान्यप्रमत्तस्य राज्ञः\nशिवेः स्थितान्यानृशंस्यं च बुद्धौ\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2111132, "chapter_id": 3403, "verse_number": "४४", "content_sanskrit": "एवंवृत्तो ह्रीनिषेधश्च यस्मात्\nतस्माच्छिविरत्यगाद् वै रथेन \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2111133, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2111134, "chapter_id": 3403, "verse_number": "४५", "content_sanskrit": "अथाष्टकः पुनरेवान्वपृच्छ-\nन्मातामहं कोतुकादिन्द्रकल्पम् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2111135, "chapter_id": 3403, "verse_number": "४६", "content_sanskrit": "पृच्छामि त्वां नृपते ब्रूहि सत्यं\nपितासि कस्यासि सुतश्च कस्य ।\nकृतं त्वया यच्च न यस्य कर्ता\nलोके त्वदन्यः क्षत्रियो ब्राह्मणो वा \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2111136, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2111137, "chapter_id": 3403, "verse_number": "४७", "content_sanskrit": "ययातिरस्मि नहुषस्य पुत्रः\nपूरोः पिता सार्वभौमस्त्विहासम् ।\nगुह्यमर्थं ब्राह्मणेभ्यो ब्रवीमि\nमातामहोऽहं भवतां प्रकाशम् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2111138, "chapter_id": 3403, "verse_number": "४८", "content_sanskrit": "सर्वामिमां पृथिवीं निर्जिगाय\nप्रस्थे बद्ध्वा ह्यददं ब्राह्मणेभ्यः ।\nमेध्यानश्वानेकशतान् सुरूपान्\nतदा देवाः शतयज्वेत्यवोचन् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2111139, "chapter_id": 3403, "verse_number": "४९", "content_sanskrit": "अदामिमां पृथिवीं ब्राह्मणेभ्यः पूर्णामिमामखिलैर्वाहनैश्च ।\nगोभिः सुवर्णैश्च धनैश्च मुख्यैः तत्रापि नागायुतमर्बुदानि\t ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2111140, "chapter_id": 3403, "verse_number": "५०", "content_sanskrit": "सत्येन वै द्यौश्च वसुन्धरा च\nतथैवाग्निर्ज्वलते मानुषेषु ।\nन मे वृथा व्याहृतमेकवाक्यं\nसत्यं हि सन्तः प्रतिपूजयन्ति\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2111141, "chapter_id": 3403, "verse_number": "५१", "content_sanskrit": "सर्वे च देवा मुनयश्च सर्वे\nसत्येन पूज्या इति मे मनोगतम् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2111142, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2111143, "chapter_id": 3403, "verse_number": "५२", "content_sanskrit": "यो नः स्वर्गजितः सर्वान् यथावृत्तं निवेदयेत् ।\nअनसूयुर्द्विजाग्र्येभ्यः श्रुत्वा चेयात् सलोकताम् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2111144, "chapter_id": 3403, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2111145, "chapter_id": 3403, "verse_number": "५३", "content_sanskrit": "एवं राजा स महात्मा ह्यतीव\nस्वैर्दौहित्रैस्तारितोऽमित्रसाहः ।\nत्यक्त्वा महीं परमोदारकर्मा\nस्वर्गं गतः कर्मभिर्नप्त्रुपेतः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2111146, "chapter_id": 3403, "verse_number": "८२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि द्व्यशीतितमोऽध्यायः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2111147, "chapter_id": 3403, "verse_number": "३०", "content_sanskrit": "॥ सम्भवपर्वणि त्रिंशोऽध्यायः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}]