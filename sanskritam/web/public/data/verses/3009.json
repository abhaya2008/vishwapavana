[{"id": 2093949, "chapter_id": 3009, "verse_number": "१३-१३९-१", "content_sanskrit": "भीष्म उवाच।\nतथा विधौ प्रवृत्ते तु सर्व एव महर्षयः।\nपितृयज्ञानकुर्वन्त विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093950, "chapter_id": 3009, "verse_number": "१३-१३९-२", "content_sanskrit": "ऋषयो धर्मनित्यास्तु कृत्वा निवपनान्युत।\nतर्पणं चापि कुर्वन्त तीर्थांभोभिर्यतव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093951, "chapter_id": 3009, "verse_number": "१३-१३९-३", "content_sanskrit": "निवापैर्दीयमानैश्च चातुर्वर्ण्येन भारत।\nतर्पिताः पितरो देवास्तत्रान्नं जरयन्ति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093952, "chapter_id": 3009, "verse_number": "१३-१३९-४", "content_sanskrit": "अजीर्णैस्त्वभिहन्यन्ते ते देवाः पितृभिः सह॥\nसोममेवाभ्यपद्यन्त तदा ह्यन्नाभिपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093953, "chapter_id": 3009, "verse_number": "१३-१३९-५", "content_sanskrit": "तेऽब्रुवन्सोममासाद्य पितरोऽजीर्णपीडिताः।\nनिवापान्नेन पीड्यामः श्रेयो नोत्र विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093954, "chapter_id": 3009, "verse_number": "१३-१३९-६", "content_sanskrit": "तान्सोमः प्रत्युवाचाथ श्रेयश्चेदीप्सितं सुराः।\nस्वयंभूसदनं यात स वः श्रेयोऽभिधास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093955, "chapter_id": 3009, "verse_number": "१३-१३९-७", "content_sanskrit": "ते सोमवचनाद्देवाः पितृभिः सह भारत।\nमेरुशृङ्गे समासीनं पितामहमुपागमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093956, "chapter_id": 3009, "verse_number": "१३-१३९-८x", "content_sanskrit": "पितर ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093957, "chapter_id": 3009, "verse_number": "१३-१३९-८", "content_sanskrit": "निवापान्नेन भगवन्भृशं पीड्यामहे वयम्।\nप्रसादं कुरु नो देव श्रेयो नः संविधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093958, "chapter_id": 3009, "verse_number": "१३-१३९-९", "content_sanskrit": "इति तेषां वचः श्रुत्वा स्वयम्भूरिदमब्रवीत्।\nएष मे पार्श्वतो वह्निर्युष्मच्छ्रेयो विधास्यति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093959, "chapter_id": 3009, "verse_number": "१३-१३९-१०x", "content_sanskrit": "अग्निरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093960, "chapter_id": 3009, "verse_number": "१३-१३९-१०", "content_sanskrit": "सहितास्तस्य भोक्ष्यामो निवापे समुपस्थिते।\nजरयिष्यथ चाप्यन्नं मया सार्धं न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093961, "chapter_id": 3009, "verse_number": "१३-१३९-११", "content_sanskrit": "एतच्छ्रुत्वा तु पितरस्ततस्ते विज्वराऽभवन्।\nएतस्मात्कारणाच्चाग्नेः प्राग्भागो दीयते नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093962, "chapter_id": 3009, "verse_number": "१३-१३९-१२", "content_sanskrit": "निवापे चाग्निपूर्वं वै निवृत्ते पुरुषर्षभ।\nन ब्रह्मराक्षसास्तं वै निवापं धर्षयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093963, "chapter_id": 3009, "verse_number": "१३-१३९-१३", "content_sanskrit": "रक्षांसि नाभिवर्धन्ते स्थिते देवे हुताशने।\nपूर्वं पिण्डं पितुर्दद्यात्ततो दद्यात्पितामहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093964, "chapter_id": 3009, "verse_number": "१३-१३९-१४", "content_sanskrit": "प्रपितामहाय च तत एष श्राद्धविधिः स्मृतः।\nब्रूयाच्छ्राद्धे च सावित्रीं पिण्डे पिण्डे समाहितः।\nसोमायेति च वक्तव्यं तथा पितृमतेति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093965, "chapter_id": 3009, "verse_number": "१३-१३९-१५", "content_sanskrit": "रजस्वला च या नारी व्यङ्गिता कर्णयोश्च या।\nनिवापे नोपतिष्ठेत सङ्ग्राह्या नान्यवंशजा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093966, "chapter_id": 3009, "verse_number": "१३-१३९-१६", "content_sanskrit": "जलं प्रतरमाणस्च कीर्तयेत पितामहान्।\nनदीमासाद्य कुर्वीत पितॄणां पितृतर्पणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093967, "chapter_id": 3009, "verse_number": "१३-१३९-१७", "content_sanskrit": "पूर्वं स्ववंशजानां तु कृत्वाऽद्भिस्तर्पणं पुनः।\nसुहृत्सम्बन्धिवर्गाणां ततो दद्याज्जलाञ्जलिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093968, "chapter_id": 3009, "verse_number": "१३-१३९-१८", "content_sanskrit": "कल्माषगोयुगेनाथ युक्तेन तरतो जलम्।\nपितरोऽभिलषन्ते वै नावं चाप्यधिरोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093969, "chapter_id": 3009, "verse_number": "१३-१३९-१९", "content_sanskrit": "सदा नावि जलं तज्ज्ञाः प्रयच्छन्ति समाहिताः।\nमासार्धे कृष्णपक्षस्य कुर्यान्निर्वपणानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093970, "chapter_id": 3009, "verse_number": "१३-१३९-२०", "content_sanskrit": "पुष्टिरायुस्तथा वीर्यं श्रीश्चैव पितृभक्तितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093971, "chapter_id": 3009, "verse_number": "१३-१३९-२१", "content_sanskrit": "पितामहः पुलस्त्यश्च वसिष्ठः पुलहस्तथा।\nअङ्गिराश्च क्रतुश्चैव कश्यपश्च महानृषिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093972, "chapter_id": 3009, "verse_number": "१३-१३९-२२", "content_sanskrit": "एते कुरुकुलश्रेष्ठ महायोगेश्वराः स्मृताः॥\nएते च पितरो राजन्नेष श्राद्धविधिः परः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093973, "chapter_id": 3009, "verse_number": "१३-१३९-२३", "content_sanskrit": "प्रेतास्तु पिण्डसम्बन्धान्मुच्यन्ते तेन कर्मणा॥\nइत्येषा पुरुषश्रेष्ठ श्राद्धोत्पत्तिर्यथागमम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093974, "chapter_id": 3009, "verse_number": "१३-१३९-२४", "content_sanskrit": "व्याख्याता पूर्वनिर्दिष्टा किं ते वक्ष्याम्यतः परम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093975, "chapter_id": 3009, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनचत्वारिंशदधिकशततमोऽध्यायः॥ १३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]