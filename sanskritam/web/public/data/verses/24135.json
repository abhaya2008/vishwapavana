[{"id": 7004135000, "chapter_id": 24135, "verse_number": "४-८४-१", "content_sanskrit": "स्कंद उवाच ।\nआकर्णय क्षोणिसुर यथा स्थाणुरचीकरत् ।\nगंगावरणयोः पुण्यात्संभेदात्तीर्थभूमिकाम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004135001, "chapter_id": 24135, "verse_number": "४-८४-२", "content_sanskrit": "संगमे तत्र निष्णातः संगमेशं समर्च्य च ।\nनरो न जातु जननी गर्भसंगमवाप्नुयात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004135002, "chapter_id": 24135, "verse_number": "४-८४-३", "content_sanskrit": "तत्र पादोदकं तीर्थं यत्र देवेन शार्ङ्गिणा ।\nआदौ पादौ क्षलितौ तु मंदराच्चागतेन यत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004135003, "chapter_id": 24135, "verse_number": "४-८४-४", "content_sanskrit": "विप्णुपादोदके तीर्थे वारिकार्यं करोति यः ।\nव्यतीपातेन नियतं भूयः सांसारिकी गतिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004135004, "chapter_id": 24135, "verse_number": "४-८४-५", "content_sanskrit": "कृतपादोदक स्नानः कृतकेशवपूजनः ।\nवीतसंसारवसतिः काश्यामासीन्नरोत्तमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004135005, "chapter_id": 24135, "verse_number": "४-८४-६", "content_sanskrit": "काश्यां सा भूमिरुद्दिष्टा श्वेतद्वीप इति द्विजैः ।\nतत्र पुण्यार्जनं कृत्वा श्वेतद्वीपाधिपो भवेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004135006, "chapter_id": 24135, "verse_number": "४-८४-७", "content_sanskrit": "ततः पादोदकात्तीर्थात्तीर्थं क्षीराब्धिसंज्ञकम् ।\nतत्रार्जित महापुण्यो वसेत्क्षीराब्धिरोधसि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004135007, "chapter_id": 24135, "verse_number": "४-८४-८", "content_sanskrit": "क्षीरोदाद्दक्षिणेभागे तीर्थं शंखाख्यनुत्तमम् ।\nतत्र स्नातो भवेन्नूनं नाशंखादिनिधेः पतिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004135008, "chapter_id": 24135, "verse_number": "४-८४-९", "content_sanskrit": "अर्वाक्च शंखतीर्थाद्वै चक्रतीर्थमनुत्तमम् ।\nसंसारचक्रे न पतेत्तत्तीर्थजलमज्जनात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004135009, "chapter_id": 24135, "verse_number": "४-८४-१०", "content_sanskrit": "गदातीर्थं तदग्रे तु संसारगदनाशनम् ।\nतत्र श्राद्धादिकरणात्पश्येद्देवं गदाधरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004135010, "chapter_id": 24135, "verse_number": "४-८४-११", "content_sanskrit": "पद्माकृत्पद्मतीर्थं च तदग्रे पितृतृप्तिकृत् ।\nतत्र स्नानादिकरणात्प्राप्नुयादघसंक्षयम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004135011, "chapter_id": 24135, "verse_number": "४-८४-१२", "content_sanskrit": "ततस्तीर्थं महालक्ष्म्या महापुण्यफलप्रदम् ।\nतत्राभ्यर्च्य महालक्ष्मीं निर्वाणकमलां लभेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004135012, "chapter_id": 24135, "verse_number": "४-८४-१३", "content_sanskrit": "ततो गारुत्मतं तीर्थं संसारगरनाशनम् ।\nकृतोदकक्रियस्तत्र वैकुंठे वसतिं लभेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004135013, "chapter_id": 24135, "verse_number": "४-८४-१४", "content_sanskrit": "ततो नारदतीर्थं च ब्रह्मविद्यैककारणम् ।\nतत्र स्नानेन मुक्तः स्याद्दृष्ट्वा नारदकेशवम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004135014, "chapter_id": 24135, "verse_number": "४-८४-१५", "content_sanskrit": "प्रह्लादतीर्थं तद्याम्ये महाभक्तिफलप्रदम् ।\nतत्र वै स्नानमात्रेण विष्णोः प्रियतरो भवेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004135015, "chapter_id": 24135, "verse_number": "४-८४-१६", "content_sanskrit": "अंबरीषं ततस्तीर्थं महापातकनाशनम् ।\nतत्र वै शुभकर्माणो जना नो गर्भभाजनम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004135016, "chapter_id": 24135, "verse_number": "४-८४-१७", "content_sanskrit": "आदित्यकेशवं नाम तदग्रे तीर्थमुत्तमम् ।\nकृताभिषेकस्तत्रापि लभेत्स्वर्गाभिषेचनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004135017, "chapter_id": 24135, "verse_number": "४-८४-१८", "content_sanskrit": "दत्तात्रेयस्य तत्रास्ति तीर्थं त्रैलोक्यपावनम् ।\nयोगसिद्धिं लभे तत्र स्नानमात्रेण भावतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004135018, "chapter_id": 24135, "verse_number": "४-८४-१९", "content_sanskrit": "तदग्रे भार्गवं तीर्थं महाज्ञानसमर्पकम् ।\nतत्र स्नानविधानेन भवेद्भार्गव लोकभाक् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004135019, "chapter_id": 24135, "verse_number": "४-८४-२०", "content_sanskrit": "ततो वामनतीर्थं च विष्णुसान्निध्यहेतुकम् ।\nतत्र श्राद्धविधानेन मुच्यते पितृजादृणात् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004135020, "chapter_id": 24135, "verse_number": "४-८४-२१", "content_sanskrit": "नरनारायणाख्यं हि ततस्तीर्थं शुभप्रदम् ।\nतत्तीर्थमज्जनात्पुंसां गर्भवासः सुदुर्लभः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004135021, "chapter_id": 24135, "verse_number": "४-८४-२२", "content_sanskrit": "यज्ञवाराहतीर्थं च ततो दक्षिणतः शुभम् ।\nयत्र स्नातस्य वै पुंसां राजसूयफलं ध्रुवम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004135022, "chapter_id": 24135, "verse_number": "४-८४-२३", "content_sanskrit": "विदारनारसिंहाख्यं तीर्थं तत्रास्ति पावनम् ।\nयत्रैकस्नानतो नश्येदघ जन्मशतार्जितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004135023, "chapter_id": 24135, "verse_number": "४-८४-२४", "content_sanskrit": "गोपीगोविंदतीर्थं च ततो वैष्णवलोकदम् ।\nयस्मिन्स्नातो नरो विद्वान्न विंद्याद्गर्भवेदनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004135024, "chapter_id": 24135, "verse_number": "४-८४-२५", "content_sanskrit": "लक्ष्मीनृसिंहतीर्थं च गोपीगोविंद दक्षिणे ।\nनिर्वाणलक्ष्म्या यत्रत्यो व्रियते तु नरोत्तमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004135025, "chapter_id": 24135, "verse_number": "४-८४-२६", "content_sanskrit": "तद्दक्षिणायां काष्ठायां शेषतीर्थमनुत्तमम् ।\nमहापापौघ शेषोपि न तिष्ठेद्यन्निमज्जनात् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004135026, "chapter_id": 24135, "verse_number": "४-८४-२७", "content_sanskrit": "शंखमाधवतीर्थं च तद्याम्यां दिशि चोत्तमम् ।\nतत्तीर्थसेवनान्नृणां कुतः पापभयं महत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004135027, "chapter_id": 24135, "verse_number": "४-८४-२८", "content_sanskrit": "ततोपि पावनतरं तीर्थं तत्क्षणसिद्धिदम् ।\nनीलग्रीवाख्यमतुलं तत्स्नायी सर्वदा शुचिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004135028, "chapter_id": 24135, "verse_number": "४-८४-२९", "content_sanskrit": "तत्रोद्दालकतीर्थं च सर्वाघौघ विनाशनम् ।\nददाति महतीमृद्धिं स्नानमात्रेण तन्नृणाम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004135029, "chapter_id": 24135, "verse_number": "४-८४-३०", "content_sanskrit": "ततः सांख्याख्य तीर्थं च सांख्येश्वर समीपतः ।\nतत्तीर्थसेवनात्पुंसां सांख्ययोगः प्रसीदति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004135030, "chapter_id": 24135, "verse_number": "४-८४-३१", "content_sanskrit": "स्वर्लोकाद्यत्र संलीनः स्वयं देव उमापतिः ।\nअतः स्वर्लीनतीर्थं च स्वर्लीनेश्वर सन्निधौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004135031, "chapter_id": 24135, "verse_number": "४-८४-३२", "content_sanskrit": "तत्र स्नानेन दानेन श्रद्धया द्विजभोजनैः ।\nजपहोमार्चनैः पुंसामक्षयं सर्वमेव हि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004135032, "chapter_id": 24135, "verse_number": "४-८४-३३", "content_sanskrit": "महिषासुरतीर्थं च तत्समीपेति पावनम् ।\nयत्र तप्त्वा स दैत्येंद्रो विजिग्ये सकलान्सुरान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004135033, "chapter_id": 24135, "verse_number": "४-८४-३४", "content_sanskrit": "तत्तीर्थसेवकोद्यापि नारिभिः परिभूयते ।\nन पातकैर्महद्भिश्च प्रार्थितं च फलं लभेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004135034, "chapter_id": 24135, "verse_number": "४-८४-३५", "content_sanskrit": "बाणतीर्थं च तस्यारात्तत्सहस्रभुजप्रदम् ।\nतत्र स्नातो नरो भक्तिं प्राप्नुयाच्छांभवीं स्थिराम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004135035, "chapter_id": 24135, "verse_number": "४-८४-३६", "content_sanskrit": "गोप्रतारेश्वरं नाम तदग्रे तीर्थमुत्तमम् ।\nअपुत्रोपि तरेद्यत्र स्नातो वैतरणीं सुखम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004135036, "chapter_id": 24135, "verse_number": "४-८४-३७", "content_sanskrit": "तीर्थं हिरण्यगर्भाख्यं तद्याम्ये सर्वपापहृत् ।\nतत्र स्नातो हिरण्येन मुच्यते न कदाचन ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004135037, "chapter_id": 24135, "verse_number": "४-८४-३८", "content_sanskrit": "ततः प्रणवतीर्थं च सर्वतीर्थोत्तमोत्तमम् ।\nजीवन्मुक्तो भवेत्तत्र स्नानमात्रेण मानवः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004135038, "chapter_id": 24135, "verse_number": "४-८४-३९", "content_sanskrit": "ततः पिशंगिला तीर्थं दर्शनादपि पापहृत् ।\nमुने ममाधिष्ठानं वै तदगस्तेऽति सिद्धिदम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004135039, "chapter_id": 24135, "verse_number": "४-८४-४०", "content_sanskrit": "स्नात्वा पिशंगिला तीर्थे दत्त्वा दानं च किंचन ।\nकिं शोचति कृतात्पापादन्यत्रापि मृतो यदि ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004135040, "chapter_id": 24135, "verse_number": "४-८४-४१", "content_sanskrit": "यो वै पिशंगिला तीर्थे स्नात्वा मामर्चयिष्यति ।\nभविष्यति स मे मित्त्रं मित्रतेजः समप्रभम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004135041, "chapter_id": 24135, "verse_number": "४-८४-४२", "content_sanskrit": "ततस्त्रैविष्टपीदृष्टि निर्मलीकृत पुष्कलम् ।\nतीर्थं पिलिपिलाख्यं वै मनोमलविनाशनम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004135042, "chapter_id": 24135, "verse_number": "४-८४-४३", "content_sanskrit": "तत्र श्राद्धादिकरणाद्दीनानाथ प्रतर्पणात् ।\nमहतीं श्रियमाप्नोति मानवोतीव निश्चलाम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004135043, "chapter_id": 24135, "verse_number": "४-८४-४४", "content_sanskrit": "ततो नागेश्वरं तीर्थं महाघपरिशोधनम् ।\nतत्तीर्थमज्जनादेव भवेत्सर्वाघसंक्षयः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004135044, "chapter_id": 24135, "verse_number": "४-८४-४५", "content_sanskrit": "तद्दक्षिणे महापुण्यं कर्णादित्याख्यमुत्तमम् ।\nतीर्थं यत्राप्लुतो मर्त्यो भास्करीं श्रियमावहेत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004135045, "chapter_id": 24135, "verse_number": "४-८४-४६", "content_sanskrit": "ततो भैरवतीर्थं च महाघौघक्षयप्रदम् ।\nचतुरर्थोदयकरं सर्वविघ्ननिवारणम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004135046, "chapter_id": 24135, "verse_number": "४-८४-४७", "content_sanskrit": "भौमाष्टम्यां तत्र नरः स्नात्वा संतर्पयेत्पितॄन् ।\nदृष्ट्वा च भैरवं कालं कलिं कालं च संजयेत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004135047, "chapter_id": 24135, "verse_number": "४-८४-४८", "content_sanskrit": "तीर्थं खर्वनृसिंहाख्यं तीर्थाद्भरवतः पुरः ।\nतत्र स्नातस्य वै पुंसः कुतोघजनितं भयम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004135048, "chapter_id": 24135, "verse_number": "४-८४-४९", "content_sanskrit": "मृकंडस्य मुनेस्तीर्थं तद्याम्यामतिनिर्मलम ।\nतत्र स्नानेन मर्त्यानां नापायमरणं क्वचित् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004135049, "chapter_id": 24135, "verse_number": "४-८४-५०", "content_sanskrit": "ततः पंचनदाख्यं वै सर्वतीर्थनिषेवितम् ।\nतीर्थं यत्र नरः स्नात्वा न संसारी पुनर्भवेत् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004135050, "chapter_id": 24135, "verse_number": "४-८४-५१", "content_sanskrit": "ब्रह्मांडोदरवर्तीनि यानि तीर्थानि सर्वतः ।\nऊर्जे यत्र समायांति स्वाघौघ परिनुत्तये ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004135051, "chapter_id": 24135, "verse_number": "४-८४-५२", "content_sanskrit": "सर्वदा यत्र सर्वाणि दशम्यादिदिनत्रयम् ।\nतिष्ठंति तीर्थवर्याणि निजनैर्मल्यहेतवे ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004135052, "chapter_id": 24135, "verse_number": "४-८४-५३", "content_sanskrit": "भूरिशः सर्वतीर्थानि मध्य काशि पदेपदे ।\nपरं पांचनदः कैश्चिन्महिमानापि कुत्रचित् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004135053, "chapter_id": 24135, "verse_number": "४-८४-५४", "content_sanskrit": "अप्येकं कार्तिकस्याहस्तत्र वै सफलीकृतम् ।\nजपहोमार्चनादानैः कृतकृत्यास्त एव हि ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004135054, "chapter_id": 24135, "verse_number": "४-८४-५५", "content_sanskrit": "सर्वाण्यपि च तीर्थानि युगपत्तुलितान्यपि ।\nनाधिजन्मुः पंचनद्याः कलाया अपि तुल्यताम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004135055, "chapter_id": 24135, "verse_number": "४-८४-५६", "content_sanskrit": "स्नात्वा पांचनदे तीर्थे दृष्ट्वा वै बिंदुमाधवम् ।\nन जातु जायते धीमाञ्जननी जठराजिरे ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004135056, "chapter_id": 24135, "verse_number": "४-८४-५७", "content_sanskrit": "ततो ज्ञानहदं तीर्थं जडानामपि जाड्यहृत् ।\nतत्र स्नातो नरो जातु ज्ञानभ्रंशं न चाप्नुयात् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004135057, "chapter_id": 24135, "verse_number": "४-८४-५८", "content_sanskrit": "तत्र ज्ञानह्रदे स्नात्वा दृष्ट्वा ज्ञानेश्वरं नरः ।\nज्ञानं तदधिगच्छेद्वै येन नो बाध्यते पुनः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004135058, "chapter_id": 24135, "verse_number": "४-८४-५९", "content_sanskrit": "ततोस्ति मंगलं तीर्थं सर्वामंगलनाशनम् ।\nतत्रावगाहनं कृत्वा भवेन्मंगलभाजनम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004135059, "chapter_id": 24135, "verse_number": "४-८४-६०", "content_sanskrit": "अमंगलानि नश्येयुर्भवेयुर्मंगलानि च ।\nस्नातुर्वै मंगले तीर्थे नमस्कर्तुश्च मंगलम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004135060, "chapter_id": 24135, "verse_number": "४-८४-६१", "content_sanskrit": "मयूखमालिनस्तीर्थं तदग्रे मलनाशनम् ।\nतत्राप्लुतो गभस्तीशं विलोक्य विमलो भवेत् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004135061, "chapter_id": 24135, "verse_number": "४-८४-६२", "content_sanskrit": "मखतीर्थं तु तत्रैव मखैश्वर समीपतः ।\nमखजं पुण्यमाप्नोति तत्र स्नातो नरोत्तमः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004135062, "chapter_id": 24135, "verse_number": "४-८४-६३", "content_sanskrit": "तत्पार्श्वे बिंदुतीर्थं च परमज्ञानकारणम् ।\nतत्र श्राद्धादिकं कृत्वा लभेत्सुकृतमुत्तमम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004135063, "chapter_id": 24135, "verse_number": "४-८४-६४", "content_sanskrit": "पिप्पलादस्य च मुनेस्तीर्थं तद्याम्यदिक्स्थितम् ।\nस्नात्वा शनेर्दिने तत्र दृष्ट्वावै पिप्पलेश्वरम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004135064, "chapter_id": 24135, "verse_number": "४-८४-६५", "content_sanskrit": "पिप्पलं तत्र सेवित्वा अश्वत्थ इति मंत्रतः ।\nशनिपीडां न लभते दुःस्वप्नं चापि नाशयेत् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004135065, "chapter_id": 24135, "verse_number": "४-८४-६६", "content_sanskrit": "ततस्ताम्रवराहाख्यं तीर्थं चैवातिपावनम् ।\nयत्र स्नानेन दानेन न मज्जेदघसागरे ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004135066, "chapter_id": 24135, "verse_number": "४-८४-६७", "content_sanskrit": "तदग्रे कालगंगा च कलिकल्मषनाशिनी ।\nतस्यां स्नात्वा नरो धीमांस्तत्क्षणान्निरघो भवेत् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004135067, "chapter_id": 24135, "verse_number": "४-८४-६८", "content_sanskrit": "इंद्रद्युम्नं महातीर्थमिंद्रद्युम्नेश्वराग्रतः ।\nतोयकृत्यं तत्र कृत्वा लोकमैंद्रमवाप्नुयात ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004135068, "chapter_id": 24135, "verse_number": "४-८४-६९", "content_sanskrit": "ततस्तु रामतीर्थं च वीररामेश्वराग्रतः ।\nतत्तीर्थस्नानमात्रेण वैष्णवं लोकमाप्नुयात् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004135069, "chapter_id": 24135, "verse_number": "४-८४-७०", "content_sanskrit": "तत ऐक्ष्वाकवं तीर्थं सर्वाघौघविनाशनम् ।\nतत्र स्नानेन पूतात्मा जायते मनुजोत्तमः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004135070, "chapter_id": 24135, "verse_number": "४-८४-७१", "content_sanskrit": "मरुत्ततीर्थं तत्प्रांते मरुत्तेश्वरसन्निधो ।\nतत्र स्नात्वा तमर्च्येशं महदैश्वर्यमाप्नुयात् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004135071, "chapter_id": 24135, "verse_number": "४-८४-७२", "content_sanskrit": "मैत्रावरुणतीर्थं च ततः पातकनाशनम् ।\nतत्र पिंडप्रदानेन पितॄणां भवति प्रियः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004135072, "chapter_id": 24135, "verse_number": "४-८४-७३", "content_sanskrit": "ततोग्नितीर्थविमलमग्नीश पुरतो महत् ।\nअग्निलोकमवाप्नोति तत्तीर्थपरिमज्जनात् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004135073, "chapter_id": 24135, "verse_number": "४-८४-७४", "content_sanskrit": "अंगारतीर्थं तत्रैव अंगारेश्वरसन्निधौ ।\nतत्रांगार चतुर्थ्यां नु स्नात्वा निष्पापतामियात् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004135074, "chapter_id": 24135, "verse_number": "४-८४-७५", "content_sanskrit": "ततो वै कलितीर्थं च कलशेश्वरसन्निधौ ।\nस्नात्वा तल्लिंगमभ्यर्च्य कलिकालान्न बिभ्यति ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004135075, "chapter_id": 24135, "verse_number": "४-८४-७६", "content_sanskrit": "चंद्रतीर्थं च तत्रैव चंद्रेश्वरसमीपतः ।\nतत्र स्नात्वार्च्य चंद्रेशं चंद्रलोकमवाप्नुयात् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004135076, "chapter_id": 24135, "verse_number": "४-८४-७७", "content_sanskrit": "तदग्रे वीरतीर्थं च वीरेश्वर समीपतः ।\nयदुक्तं प्राक्तवपुरस्तीर्थानामुत्तमं परम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004135077, "chapter_id": 24135, "verse_number": "४-८४-७८", "content_sanskrit": "विघ्नेशतीर्थं च ततः सर्वविघ्नविघातकृत् ।\nजातुचित्तत्र संस्नातो न विघ्नैरभिभूयते ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004135078, "chapter_id": 24135, "verse_number": "४-८४-७९", "content_sanskrit": "हरिश्चंद्रस्य राजर्षस्ततस्तीर्थमनुत्तमम् ।\nयत्र स्नातो नरो जातु न सत्याच्चयवते कचित् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004135079, "chapter_id": 24135, "verse_number": "४-८४-८०", "content_sanskrit": "हरिश्चंद्रस्य तीर्थे तु यच्छ्रेयः समुपार्जितम् ।\nतदक्षयफलं वीर इह लोके परत्र च ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004135080, "chapter_id": 24135, "verse_number": "४-८४-८१", "content_sanskrit": "ततः पर्वततीर्थं च पर्वतेश समीपतः ।\nसर्वपर्वफलं तस्य स्नात्वा पर्वण्यपर्वणि ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004135081, "chapter_id": 24135, "verse_number": "४-८४-८२", "content_sanskrit": "कंबलाश्वतरं तीर्थं तत्र सर्वविषापहम् ।\nतत्र स्नातो भवेन्मर्त्यो गीतविद्याविशारदः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004135082, "chapter_id": 24135, "verse_number": "४-८४-८३", "content_sanskrit": "ततः सारस्वतं तीर्थं सर्वविद्योपपादकम् ।\nतिष्ठेयुः पितरस्तत्र सह देवर्षिमानवैः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004135083, "chapter_id": 24135, "verse_number": "४-८४-८४", "content_sanskrit": "उमातीर्थं तु तत्रैव सर्वशक्तिसमन्वितम् ।\nऔमेयलोकप्राप्त्यै स्यात्स्नानमात्रेण निश्चितम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004135084, "chapter_id": 24135, "verse_number": "४-८४-८५", "content_sanskrit": "ततस्त्रिलोकी विख्यातं त्रिलोक्युद्धरणक्षमम् ।\nतीर्थं श्रेष्ठतरं वीर यदाख्या मणिकर्णिका ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004135085, "chapter_id": 24135, "verse_number": "४-८४-८६", "content_sanskrit": "चक्रपुष्करिणीतीर्थं तदादौ विष्णुना कृतम् ।\nतदाख्या कर्णनादेव सर्वैः पापैः प्रमुच्यते ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004135086, "chapter_id": 24135, "verse_number": "४-८४-८७", "content_sanskrit": "स्वर्गौकसस्त्रिसंध्यं वै जपंति मणिकर्णिकाम् ।\nयन्नामग्रहणं पुंसां श्रेयसं परमाय हि ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004135087, "chapter_id": 24135, "verse_number": "४-८४-८८", "content_sanskrit": "यैः श्रुता यैः स्मृता वीर यैर्दृष्टा मणिकर्णिका ।\nत एव कृतिनो लोके कृतकृत्यास्त एव हि ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7004135088, "chapter_id": 24135, "verse_number": "४-८४-८९", "content_sanskrit": "त्रिलोके ये जपंतीह मानवा मणिकर्णिकाम् ।\nजपामि तानहं वीर त्रिकालं पुण्यकर्मणः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7004135089, "chapter_id": 24135, "verse_number": "४-८४-९०", "content_sanskrit": "इष्टं तेन महायज्ञैः सहस्रशतदक्षिणैः ।\nपंचाक्षरी महाविद्या येनोक्ता मणिकर्णिका ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7004135090, "chapter_id": 24135, "verse_number": "४-८४-९१", "content_sanskrit": "महादानानि दत्तानि तेन वै पुण्यकर्मणा ।\nयेनाहमर्चितो वीर संप्राप्य मणिकर्णिकाम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7004135091, "chapter_id": 24135, "verse_number": "४-८४-९२", "content_sanskrit": "मणिकर्ण्यंबुभिर्येन तर्पिताः प्रपितामहाः ।\nतेन श्राद्धानि दत्तानि गयायां मधुपायसैः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7004135092, "chapter_id": 24135, "verse_number": "४-८४-९३", "content_sanskrit": "मणिकर्णीजलं येन संपीतं शुद्धबुद्धिना ।\nकिं तस्य सोमपानैस्तैः पुनरावृत्तिलक्षणैः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7004135093, "chapter_id": 24135, "verse_number": "४-८४-९४", "content_sanskrit": "ते स्नाताः सर्वतीर्थेषु महापर्वसुभूरिशः ।\nतथा च सर्वावभृथैर्यैः स्नाता मणिकर्णिका ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7004135094, "chapter_id": 24135, "verse_number": "४-८४-९५", "content_sanskrit": "तैः सुराः पूजिताः सर्वे ब्रह्मविष्णुमुखा मखैः ।\nयैः स्वर्णकुसुमैरत्नैरर्चिता मणिकर्णिका ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7004135095, "chapter_id": 24135, "verse_number": "४-८४-९६", "content_sanskrit": "अहं तेनोमया सार्धं दीक्षां संप्राप्य शांभवीम् ।\nअर्चितः प्रत्यहं येन पूजिता णिकर्णिका ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7004135096, "chapter_id": 24135, "verse_number": "४-८४-९७", "content_sanskrit": "तपांसि तेन तप्तानि शीर्णपर्णादिना चिरम् ।\nसेविता श्रद्धया येन श्रीमती मणिकर्णिका ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7004135097, "chapter_id": 24135, "verse_number": "४-८४-९८", "content_sanskrit": "दत्त्वा दानानि भूरीणि मखानिष्ट्वा तु भूरिशः ।\nचिरं तप्त्वाप्यरण्येषु स्वर्गैश्वर्यान्महीं पुनः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7004135098, "chapter_id": 24135, "verse_number": "४-८४-९९", "content_sanskrit": "विपुलेत्र महीपृष्ठे पंचक्रोश्यां मनोहरा ।\nसंश्रिता मणिकर्णीयैस्ते याताश्चानिवर्तकाः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7004135099, "chapter_id": 24135, "verse_number": "४-८४-१००", "content_sanskrit": "दानानां च व्रतानां च क्रतूनां तपसामपि ।\nइदमेव फलं मन्ये यदाप्या मणिकर्णिका ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7004135100, "chapter_id": 24135, "verse_number": "४-८४-१०१", "content_sanskrit": "मोक्षलक्ष्मीरियं साक्षाच्छ्रीमती मणिकर्णिका ।\nप्रायोस्या महिमानं वै नवेद्म्यहमपि स्फुटम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7004135101, "chapter_id": 24135, "verse_number": "४-८४-१०२", "content_sanskrit": "अवाच्यां मणिकर्ण्याश्च तीर्थं पाशुपतं परम् ।\nतीर्थं तु रुद्रवासाख्यं विश्वतीर्थमतः परम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7004135102, "chapter_id": 24135, "verse_number": "४-८४-१०३", "content_sanskrit": "मुक्तितीर्थं ततो रम्यमविमुक्तमथोत्तमम् ।\nतीर्थं च तारकं स्कांदं ढुंढेस्तीर्थं ततोपि च ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7004135103, "chapter_id": 24135, "verse_number": "४-८४-१०४", "content_sanskrit": "भवानेयमथैशानं ज्ञानतीर्थमथोत्तमम् ।\nनंदितीर्थं विष्णुतीर्थं तीर्थं पैतामहं ततः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7004135104, "chapter_id": 24135, "verse_number": "४-८४-१०५", "content_sanskrit": "नाभितीर्थमिदं चैव ब्रह्मनालमतः परम् ।\nततो भागीरथं तीर्थं यत्तवाग्रे पुराकथि ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7004135105, "chapter_id": 24135, "verse_number": "४-८४-१०६", "content_sanskrit": "तीर्थात्युत्तरवाहिन्यां स्वर्धुन्यां काशिसन्निधौ ।\nसंत्यनेकानि पुण्यानि मयोक्तान्यल्पशः पुनः ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7004135106, "chapter_id": 24135, "verse_number": "४-८४-१०७", "content_sanskrit": "तत्रापि नितरां श्रेष्ठा पंचतीर्थी नृपांगज ।\nयस्यां स्तात्वा नरो भूयो गर्भवासं न संस्मरेत् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7004135107, "chapter_id": 24135, "verse_number": "४-८४-१०८", "content_sanskrit": "प्रथमं चासिसंभेदं तीर्थानां प्रवरं परम् ।\nततो दशाश्वमेधाख्यं सर्वतीर्थनिषेवितम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7004135108, "chapter_id": 24135, "verse_number": "४-८४-१०९", "content_sanskrit": "ततः पादोदकं तीर्थमादिकेशवसन्निधौ ।\nततः पंचनदं पुण्यं स्नानमात्रादघौघहृत् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7004135109, "chapter_id": 24135, "verse_number": "४-८४-११०", "content_sanskrit": "एतेषामपि तीर्थानां चतुर्णामपि सत्तम ।\nपंचमं मणिकर्ण्याख्यं मनावेयवशुद्धिदम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7004135110, "chapter_id": 24135, "verse_number": "४-८४-१११", "content_sanskrit": "अहं स्नाम्यत्र सततमुमया सह पर्वसु ।\nब्रह्मणा विष्णुना सार्धं सहेंद्रादिसुरर्षिभिः ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7004135111, "chapter_id": 24135, "verse_number": "४-८४-११२", "content_sanskrit": "अतएवात्र गीयेत गाथेयं श्रुतिसंमता ।\nनागलोककृतावासैः स्वर्गौकोभिश्च संततम् ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7004135112, "chapter_id": 24135, "verse_number": "४-८४-११३", "content_sanskrit": "सत्यं सत्यं पुनः सत्यं सत्यपूर्वमिदं वचः ।\nमणिकर्णी समं तीर्थं नास्ति ब्रह्मांडगोलके ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7004135113, "chapter_id": 24135, "verse_number": "४-८४-११४", "content_sanskrit": "पंचतीर्थ्यां नरः स्नात्वा न देहं पांचभौतिकम् ।\nगृह्णाति जातुचित्काश्यां पंचास्योवाथ जायते ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7004135114, "chapter_id": 24135, "verse_number": "४-८४-११५", "content_sanskrit": "इति दत्त्वा वरान्देवो वीरस्यांतर्दधे हरः ।\nस च वीरोपि वीरेशं प्रार्च्य प्राप्तः समीहितम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7004135115, "chapter_id": 24135, "verse_number": "४-८४-११६", "content_sanskrit": "स्कंद उवाच ।\nतीर्थाध्यायमिमं पुण्यमगस्ते यो निशामयेत् ।\nतस्याघसंक्षयं यायादपि जन्मशतार्जितम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7004135116, "chapter_id": 24135, "verse_number": "४-८४-११७", "content_sanskrit": "इति वीरेश्वराख्यानं तीर्थाख्यानप्रसंगतः ।\nकथितं ते पुरागस्ते कामेशं कथयाम्यतः ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7004135117, "chapter_id": 24135, "verse_number": "४-८४-११८", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीति साहस्र्यां संहितायां चतुर्थे काशीखंड उत्तरार्धे वीरेश्वराख्यानं नाम चतुरशीतितमोऽध्यायः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}]