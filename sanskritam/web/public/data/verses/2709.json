[{"id": 2080400, "chapter_id": 2709, "verse_number": "१२-२१४-०x", "content_sanskrit": "गुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2080401, "chapter_id": 2709, "verse_number": "१२-२१४-१", "content_sanskrit": "प्रवृत्तिलक्षणो धर्मो यथा समुपलभ्यते।\nतेषां विज्ञाननिष्ठानामन्यत्तत्वं न रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2080402, "chapter_id": 2709, "verse_number": "१२-२१४-२", "content_sanskrit": "दुर्लभा वेदविद्वांसो वेदोक्तेषु व्यवस्थिताः।\nप्रयोजनं महत्त्वात्तु मार्गमिच्छन्ति संस्तुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2080403, "chapter_id": 2709, "verse_number": "१२-२१४-३", "content_sanskrit": "`वेदस्य न विदुर्भावं ज्ञानमार्गप्रतिष्ठितम्।\nसद्भिराचरितत्वात्तु वृत्तमेतदगर्हितम्।\nइयं सा बुद्धिरभ्येत्य यथा याति परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2080404, "chapter_id": 2709, "verse_number": "१२-२१४-४", "content_sanskrit": "शरीरवानुपादत्ते मोहात्सर्वान्परिग्रहान्।\nकामक्रोधादिभिर्भावैर्युक्तो राजसतामसैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2080405, "chapter_id": 2709, "verse_number": "१२-२१४-५", "content_sanskrit": "नाशुद्धमाचरेत्तस्मादभीप्सन्देहयापनम्।\nकर्मणां विवरं कुर्वन्न लोकानाप्नुयाच्छुभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2080406, "chapter_id": 2709, "verse_number": "१२-२१४-६", "content_sanskrit": "लोहयुक्तं तथा हेम विपक्वं न विराजते।\nतथाऽपक्वकषायाख्यं विज्ञानं न प्रकाशते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2080407, "chapter_id": 2709, "verse_number": "१२-२१४-७", "content_sanskrit": "`केचिदात्मगुणं प्राप्तास्ते मुक्ताश्चक्रबन्धनात्।\nइतरे दुःखसन्द्वन्द्वास्तथा दुःखपरायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2080408, "chapter_id": 2709, "verse_number": "१२-२१४-८", "content_sanskrit": "शुकाकर्मानुरूपं ते जायमानाः पुनः पुनः।\nक्रोधलोभमदाविष्टा मूढान्तः करणाः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2080409, "chapter_id": 2709, "verse_number": "१२-२१४-९", "content_sanskrit": "यथा--- संछाया नास्ति नित्यतया परा।\nगुणानेव तथा चिन्त्या सन्त्येति च विदुर्बुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2080410, "chapter_id": 2709, "verse_number": "१२-२१४-१०", "content_sanskrit": "यश्चाधर्मं चरेल्लोभात्कामक्रोधावनुप्लुवन्।\nधर्म्यं पन्थानमुत्क्रम्य सानुबन्धो विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2080411, "chapter_id": 2709, "verse_number": "१२-२१४-११", "content_sanskrit": "`अचलं ज्ञानमप्राप्य चलचित्तश्चलानियात्।\nशब्दादीन्विषयांस्तस्मान्न संरागादुपप्लवेत्।\nक्रोधो हर्षो विषादश्च जायन्ते हि परस्परात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2080412, "chapter_id": 2709, "verse_number": "१२-२१४-१२", "content_sanskrit": "`गुणाः कार्याः क्रोधहर्षौ सुखदुःखे प्रियाप्रिये।\nद्वन्द्वान्यथैवमादीनि विजयेच्चैव सर्ववित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2080413, "chapter_id": 2709, "verse_number": "१२-२१४-१३", "content_sanskrit": "पञ्चभूतात्मके देहे सत्त्वराजसताभसे।\nकमभिष्टुवते चायं कं वा क्रोशति किं वदन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2080414, "chapter_id": 2709, "verse_number": "१२-२१४-१४", "content_sanskrit": "स्पर्शरूपरसाद्येषु सङ्गं गच्छन्ति बालिशाः।\nनावगच्छन्ति विज्ञानादात्मानं पार्थिवं गुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2080415, "chapter_id": 2709, "verse_number": "१२-२१४-१५", "content_sanskrit": "मृन्मयं शरणं यद्वन्मृदैव परिलिप्यते।\nपार्थिवोऽयं तथा देहो मृद्विकारान्न नश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2080416, "chapter_id": 2709, "verse_number": "१२-२१४-१६", "content_sanskrit": "मधु तैलं पयः सर्पिर्मांसानि लवणं गुडः।\nधान्यानि फलमूलानि मृद्विकाराः सहाम्भसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2080417, "chapter_id": 2709, "verse_number": "१२-२१४-१७", "content_sanskrit": "यद्वत्कान्तारमातिष्ठन्नौत्सुक्यं समनुव्रजेत्।\nग्राम्यमाहारमादद्यादस्वाद्वपि हि यापनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2080418, "chapter_id": 2709, "verse_number": "१२-२१४-१८", "content_sanskrit": "तद्वत्संसारकान्तारमातिष्ठञ्श्रमतत्परः।\nयात्रार्थमद्यादाहारं व्याधितो भेषजं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2080419, "chapter_id": 2709, "verse_number": "१२-२१४-१९", "content_sanskrit": "`भक्षणे श्वापदैर्मार्गादिति चारं करोति चेत्।\nएवं संसारमार्गेण यात्रार्थं विषयाणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2080420, "chapter_id": 2709, "verse_number": "१२-२१४-२०", "content_sanskrit": "न गच्छेद्भोगविज्ञानादुन्मार्गे पद्यते तदा।\nतस्माददुःखतो मार्गमास्थितस्तमनुस्मरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2080421, "chapter_id": 2709, "verse_number": "१२-२१४-२१", "content_sanskrit": "नानापर्णफला वृक्षा बहवः सन्ति तत्र हि।\nभोक्तारो मुनयश्चैव तस्मात्परतरं वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2080422, "chapter_id": 2709, "verse_number": "१२-२१४-२२", "content_sanskrit": "अनुमानैस्तथाशास्त्रैर्यशसा विक्रमेण च।\nसत्यशौचार्जवत्यागैर्वर्चसा विक्रमेण च।\nक्षान्त्या धृत्या च बुद्ध्या च मनसा तपसैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2080423, "chapter_id": 2709, "verse_number": "१२-२१४-२३", "content_sanskrit": "भावान्सर्वान्यथावृत्तान्संवसेत यथाक्रमम्।\nशान्तिमिच्छन्नदीनात्मा संयच्छेदिन्द्रियाणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2080424, "chapter_id": 2709, "verse_number": "१२-२१४-२४", "content_sanskrit": "सत्त्वेन रजसा चैव तमसा चैव मोहिताः।\nचक्रवत्परिवर्तन्ते ह्यज्ञानाज्जन्तवो भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2080425, "chapter_id": 2709, "verse_number": "१२-२१४-२५", "content_sanskrit": "तस्मात्सम्यक्परीक्षेत दोषानज्ञानसंभवान्।\nअज्ञानप्रभवं नित्यमहंकारं परित्यजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2080426, "chapter_id": 2709, "verse_number": "१२-२१४-२६", "content_sanskrit": "महाभूतानीन्द्रियाणि गुणाः सत्त्वं रजस्तमः।\n`देहमूलं विजानीहि नैतानि भगवानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2080427, "chapter_id": 2709, "verse_number": "१२-२१४-२७", "content_sanskrit": "उपायतः प्रवक्ष्यामि तं च मृत्युं दुरासदम्।\nत्रैलोक्यं सेश्वरं सर्वमहंकारे प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2080428, "chapter_id": 2709, "verse_number": "१२-२१४-२८", "content_sanskrit": "यथेह नियतः कालो दर्शयत्यार्तवान्गुणान्।\nतद्वद्भतेष्वहंकारं विद्याद्भूतप्रवर्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2080429, "chapter_id": 2709, "verse_number": "१२-२१४-२९", "content_sanskrit": "संमोहकं तमो विद्यात्कृष्णमज्ञानसंभवम्।\nप्रकृतेर्गुणसंजातो महानहंक्रिया ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2080430, "chapter_id": 2709, "verse_number": "१२-२१४-३०", "content_sanskrit": "अहंकारात्पुनः पश्चाद्भूतग्राममुदाहृतम्।\nअव्यक्तस्य गुणेभ्यस्तु तद्गुणांश्च निबोध तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2080431, "chapter_id": 2709, "verse_number": "१२-२१४-३१", "content_sanskrit": "प्रीतिदुःखनिबद्धांश्च समस्तांस्त्रीनथो गुणान्।\nसत्त्वस्य रजसश्चैव तमसश्च निबोध तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2080432, "chapter_id": 2709, "verse_number": "१२-२१४-३२", "content_sanskrit": "प्रसादो हर्षजा प्रीतिरसंदेहो धृतिः स्मृतिः।\nएतान्सत्त्वगुणान्विद्यादिमान्राजसतामसान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2080433, "chapter_id": 2709, "verse_number": "१२-२१४-३३", "content_sanskrit": "`असन्तोषोऽक्षमाऽधैर्यमतृप्तिर्विषयादिषु।\nराजसाश्च गुणा ह्येते तत्परं तामसाञ्शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2080434, "chapter_id": 2709, "verse_number": "१२-२१४-३४", "content_sanskrit": "मोहस्तन्द्री तथा दुःखं निद्राऽऽलस्यं प्रमादता।\nविषादी दीर्घसूत्रश्च तत्तामसमुदाहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2080435, "chapter_id": 2709, "verse_number": "१२-२१४-३५", "content_sanskrit": "कामक्रोधौ प्रमादश्च लोभमोहौ भयं क्लमः।\nविषादशोकावरतिर्मानदर्पावनार्यता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2080436, "chapter_id": 2709, "verse_number": "१२-२१४-३६", "content_sanskrit": "दोषाणामेवमादीनां परीक्ष्य गुरुलाघवम्।\nविमृशेदात्मसंस्थानमेकैकमनुसंततम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2080437, "chapter_id": 2709, "verse_number": "१२-२१४-३७", "content_sanskrit": "`यस्मिन्प्रतिष्ठितं चेदं यस्मिन्सज्ज्ञाननिर्गतिः।\nसर्वभूताधिकं नित्यमहंकारं विलोकयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2080438, "chapter_id": 2709, "verse_number": "१२-२१४-३८", "content_sanskrit": "विलोकमानः स तदा स्वबुद्ध्या सूक्ष्मया पुनः।\nतदेव भाति तद्रूपमात्मना यत्सुनिर्मलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2080439, "chapter_id": 2709, "verse_number": "१२-२१४-३९x", "content_sanskrit": "शिष्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2080440, "chapter_id": 2709, "verse_number": "१२-२१४-३९", "content_sanskrit": "के दोषा मनसा त्यक्ताः के बुद्ध्या शिथिलीकृताः\nके पुनः पुनरायान्ति के मोहादचला इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2080441, "chapter_id": 2709, "verse_number": "१२-२१४-४०", "content_sanskrit": "केषां बलाबलं बुद्ध्या हेतुभिर्विमृशेद्बुधः।\n`एतन्मे सर्वमाचक्ष्व यथा विद्यामहं विभो।\nमह्यं शुश्रूषवे विद्वन्वक्ष्येतद्बुद्धिनिश्चितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2080442, "chapter_id": 2709, "verse_number": "१२-२१४-४१", "content_sanskrit": "शान्तत्वादपरान्ताच्च आरम्भादपि चैकतः।\nप्रोक्तो ह्यत्र यथा हेतुरेवमाहुर्मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2080443, "chapter_id": 2709, "verse_number": "१२-२१४-४२x", "content_sanskrit": "गुरुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2080444, "chapter_id": 2709, "verse_number": "१२-२१४-४२", "content_sanskrit": "दोषैर्मूलादवच्छिन्नैर्विशुद्धात्मा विमुच्यते।\nविनाशयति संभूतमयस्मयमयो यथा।\nतथा कृतात्मा सहजैर्दोषैर्नश्यति राजसैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2080445, "chapter_id": 2709, "verse_number": "१२-२१४-४३", "content_sanskrit": "`सहजैरविशुद्धात्मा दोषैर्नश्यति तामसैः।\nराजसं तामसं चैव शुद्धात्मा कालसंभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2080446, "chapter_id": 2709, "verse_number": "१२-२१४-४४", "content_sanskrit": "`शमयेत्सत्त्वमास्थाय बुद्ध्या केवलया द्विजः।\nत्यजेच्च मनसा चेतः शुद्धात्मा बुद्धिमास्थितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2080447, "chapter_id": 2709, "verse_number": "१२-२१४-४५", "content_sanskrit": "तत्सर्वं देहिनां बीजं सत्त्वमात्मवतः समम्।\nतस्मादात्मवता वर्ज्यं रजश्च तम एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2080448, "chapter_id": 2709, "verse_number": "१२-२१४-४६", "content_sanskrit": "रजस्तमोभ्यां निर्मुक्तं सत्त्वं निर्मलतामियात्।\n`आहारान्वर्जयेन्नित्यं राजसांस्तामसानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2080449, "chapter_id": 2709, "verse_number": "१२-२१४-४७", "content_sanskrit": "ते ब्रह्म पुनरायान्ति न मोहादचला इव।\nअथवा मन्त्रवद्ब्रूयुर्मांसादीनां यजुष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2080450, "chapter_id": 2709, "verse_number": "१२-२१४-४८", "content_sanskrit": "स वै हेतुरनादाने शुद्धधर्मानुपालने।\nरजसा कामयुक्तानि कार्याण्यपि समाप्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2080451, "chapter_id": 2709, "verse_number": "१२-२१४-४९", "content_sanskrit": "अर्थयुक्तानि चात्यर्थं कामान्सर्वांश्च सेवते।\nतमसा लोभयुक्तानि क्रोधजानि च सेवते।\nहिंसाविहाराभिरतस्तन्द्रीनिद्रासमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2080452, "chapter_id": 2709, "verse_number": "१२-२१४-५०", "content_sanskrit": "सत्वस्थः सात्विकान्भावाञ्शुद्धान्पश्यति संश्रितः।\nस देही विमलः श्रीमाञ्श्रद्धाविद्यासमन्वितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2080453, "chapter_id": 2709, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिप्रवणि मोक्षधर्मपर्वणि चतुर्दशाधिकद्विशततमोऽध्यायः॥ २१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]