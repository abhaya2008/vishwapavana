[{"id": 2082626, "chapter_id": 2762, "verse_number": "१२-२६७-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082627, "chapter_id": 2762, "verse_number": "१२-२६७-१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nतुलाधारस्य वाक्यानि धर्मे जाजलिना सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082628, "chapter_id": 2762, "verse_number": "१२-२६७-२", "content_sanskrit": "वने वनचरः कश्चिज्जाजलिर्नाम वै द्विजः।\nसागरोद्देशमागम्य तपस्तेपे महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082629, "chapter_id": 2762, "verse_number": "१२-२६७-३", "content_sanskrit": "नियतो नियताहारश्चीराजिनजटाधरः।\nमलपङ्कधरो धीमान्बहून्वर्षगणान्मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082630, "chapter_id": 2762, "verse_number": "१२-२६७-४", "content_sanskrit": "स कदाचिन्महातेजा जलवासो महीपते।\nचचार लोकान्विप्रर्षिः प्रेक्षमाणो मनोजवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082631, "chapter_id": 2762, "verse_number": "१२-२६७-५", "content_sanskrit": "स चिन्तयामास मुनिर्जलमध्ये कदाचन।\nविप्रेक्ष्य सागरान्तां वै महीं सवनकाननाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082632, "chapter_id": 2762, "verse_number": "१२-२६७-६", "content_sanskrit": "न मया सदृशोऽस्तीह लोके स्थावरजङ्गमे।\nअप्सु वैहायसं गच्छेन्मया योऽन्यः सहेति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082633, "chapter_id": 2762, "verse_number": "१२-२६७-७", "content_sanskrit": "स दृश्यमानो रक्षोभिर्जलमध्ये च भारत।\nआस्फोटयत्तदाऽऽकाशे धर्मः प्राप्तो मयेति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082634, "chapter_id": 2762, "verse_number": "१२-२६७-८", "content_sanskrit": "अब्रुवंश्च पिशाचास्तं नैवं त्वं वक्तुमर्हसि।\nतुलाधारो वणिग्धर्मा वाराणस्यां महायशाः।\nसोऽप्येवं नार्हते वक्तुं यथा त्वं द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082635, "chapter_id": 2762, "verse_number": "१२-२६७-९", "content_sanskrit": "इत्युक्तो जाजलिर्भूतैः प्रत्युवाच महातपाः।\nपश्येयं तमहं प्राज्ञं तुलाधारं यशस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082636, "chapter_id": 2762, "verse_number": "१२-२६७-१०", "content_sanskrit": "इति ब्रुवाणं तमृषिं रक्षांस्युत्थाय सागरात्।\nअब्रुवन्गच्छ पन्थानमास्थायेमं द्विजोत्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082637, "chapter_id": 2762, "verse_number": "१२-२६७-११", "content_sanskrit": "इत्युक्तो जाजलिर्भूतैर्जगाम विमनास्तदा।\nवाराणस्यां तुलाधारं समासाद्याब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082638, "chapter_id": 2762, "verse_number": "१२-२६७-१२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082639, "chapter_id": 2762, "verse_number": "१२-२६७-१२", "content_sanskrit": "किं कृतं दुष्करं तात कर्म जाजलिना पुरा।\nयेन सिद्धिं परां प्राप्तस्तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082640, "chapter_id": 2762, "verse_number": "१२-२६७-१३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082641, "chapter_id": 2762, "verse_number": "१२-२६७-१३", "content_sanskrit": "अतीव तपसा युक्तो घोरेण स बभूव ह।\nनद्युपस्पर्शनपरः सायंप्रातर्महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082642, "chapter_id": 2762, "verse_number": "१२-२६७-१४", "content_sanskrit": "अग्नीन्परिचरन्सम्यक्स्वाध्यायपरमो द्विजः।\nवानप्रस्थ विधानज्ञो जाजलिर्ज्वलितः श्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082643, "chapter_id": 2762, "verse_number": "१२-२६७-१५", "content_sanskrit": "वने तपस्यतिष्ठत्स न चाधर्ममवैक्षत।\nवर्षास्वाकाशशायी च हेमन्ते जलसंश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082644, "chapter_id": 2762, "verse_number": "१२-२६७-१६", "content_sanskrit": "वातातपसहो ग्रीष्मे न चाधर्ममविन्दत।\nदुःखशय्याश्च विविधा भूमौ च परिवर्तनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082645, "chapter_id": 2762, "verse_number": "१२-२६७-१७", "content_sanskrit": "ततः कदाचित्स मुनिर्वर्षास्वाकाशमास्थितः।\nअन्तरिक्षाज्जलं मूर्ध्नां प्रत्यगृह्णान्मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082646, "chapter_id": 2762, "verse_number": "१२-२६७-१८", "content_sanskrit": "आप्लुतस्य जटाः क्लिन्ना बभूवुर्ग्रथिताः प्रभो।\nअरण्यगमनान्नित्यं मलिनोऽमलसंयुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082647, "chapter_id": 2762, "verse_number": "१२-२६७-१९", "content_sanskrit": "स कदाचिन्निराहारो वायुभक्षो महातपाः।\nतस्थौ काष्ठवदव्यग्रो न चचाल च कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082648, "chapter_id": 2762, "verse_number": "१२-२६७-२०", "content_sanskrit": "तस्य स्म स्थाणुभूतस्य निर्विचेष्टस्य भारत।\nकुलिङ्गशकुनौ राजन्नीडं शिरसि चक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082649, "chapter_id": 2762, "verse_number": "१२-२६७-२१", "content_sanskrit": "स तौ दयावान्ब्रह्मर्षिरुपप्रैक्षत दंपती।\nकुर्वाणौ नीडकं तत्र जटासु तृणतन्तुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082650, "chapter_id": 2762, "verse_number": "१२-२६७-२२", "content_sanskrit": "यदा न स चलत्येव स्थाणुभूतो महातपाः।\nततस्तौ सुखविश्वस्तौ सुखं तत्रोषतुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082651, "chapter_id": 2762, "verse_number": "१२-२६७-२३", "content_sanskrit": "अतीतास्वथ वर्षासु शरत्काल उपस्थिते।\nप्राजापत्येन विधिना विश्वासात्काममोहितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082652, "chapter_id": 2762, "verse_number": "१२-२६७-२४", "content_sanskrit": "तत्रोत्पादयतां राजञ्शिरस्यण्डानि खेचरौ।\nतान्यबुध्यत तेजस्वी स विप्रः संशितव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2082653, "chapter_id": 2762, "verse_number": "१२-२६७-२५", "content_sanskrit": "बुद्ध्वा च स महातेजा न चचाल च जाजलिः।\nधर्मे कृतमना नित्यं नाधर्मं स त्वरोचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2082654, "chapter_id": 2762, "verse_number": "१२-२६७-२६", "content_sanskrit": "अहन्यहनि चागत्य ततस्तौ तस्य मूर्धनि।\nआश्वासितौ निवसतः संप्रहृष्टौ तदा विभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2082655, "chapter_id": 2762, "verse_number": "१२-२६७-२७", "content_sanskrit": "अण्डेभ्यस्त्वथ पुष्टेभ्यः प्राजायन्त शकुन्तकाः।\nव्यवर्धन्त च तत्रैव न चाकम्पत जाजलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2082656, "chapter_id": 2762, "verse_number": "१२-२६७-२८", "content_sanskrit": "स रक्षमाणस्त्वण़्डानि कुलिङ्गानां धृतव्रतः।\nतथैव तस्थौ धर्मात्मा निर्विचेष्टः समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2082657, "chapter_id": 2762, "verse_number": "१२-२६७-२९", "content_sanskrit": "ततस्तु काले राजेन्द्र बभूवुस्तेऽथ पक्षिणः।\nबुबुधे तांस्तु स मुनिर्जातपक्षान्कुलिङ्गकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2082658, "chapter_id": 2762, "verse_number": "१२-२६७-३०", "content_sanskrit": "ततः कदाचित्तांस्तत्र पश्यन्पक्षीन्यतव्रतः।\nबभूव परमप्रीतस्तदा मतिमतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2082659, "chapter_id": 2762, "verse_number": "१२-२६७-३१", "content_sanskrit": "तथा तानभिसंवृद्धान्दृष्ट्वा चैवाप्तवान्मुदम्।\nशकुनौ निर्भयौ तत्र ऊषतुश्चात्मजैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2082660, "chapter_id": 2762, "verse_number": "१२-२६७-३२", "content_sanskrit": "जातपक्षांश्च सोऽपश्यदुड्डीनान्पुनरागतान्।\nसायंसायं द्विजान्विप्रो न चाकम्पत जाजलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2082661, "chapter_id": 2762, "verse_number": "१२-२६७-३३", "content_sanskrit": "कदाचित्पुनरभ्येत्य पुनर्गच्छन्ति संततम्।\nत्यक्ता मातापितृभ्यां ते नचाकम्पत जाजलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2082662, "chapter_id": 2762, "verse_number": "१२-२६७-३४", "content_sanskrit": "तथा ते दिवसं चापि गत्वा सायं पुनर्नृप।\nउपावर्तन्त तत्रैव निवासार्थं शकुन्तकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2082663, "chapter_id": 2762, "verse_number": "१२-२६७-३५", "content_sanskrit": "कदाचिद्दिवसान्पञ्च समुत्पत्य विहगमाः।\nषष्ठेऽहनि समाजग्मुर्न चाकम्पत जाजलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2082664, "chapter_id": 2762, "verse_number": "१२-२६७-३६", "content_sanskrit": "क्रमेण च पुनः सर्वे दिवसान्सुबहूनथ।\nनोपावर्तन्त शकुना जातपक्षाश्च ते यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2082665, "chapter_id": 2762, "verse_number": "१२-२६७-३७", "content_sanskrit": "कदाचिन्मासमात्रेण समुत्पत्य विहंगमाः।\nनैवागच्छंस्ततो राजन्प्रातिष्ठत स जाजलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2082666, "chapter_id": 2762, "verse_number": "१२-२६७-३८", "content_sanskrit": "ततस्तेषु प्रलीनेषु जाजलिर्जातविस्मयः।\nसिद्धोस्मीति मतिं चक्रे ततस्तं मान आविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2082667, "chapter_id": 2762, "verse_number": "१२-२६७-३९", "content_sanskrit": "स तथा निर्गतान्दृष्ट्वा शकुन्तान्नियतव्रतः।\nसंभावितात्मा संभाव्य भृशं प्रीतस्तदाऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2082668, "chapter_id": 2762, "verse_number": "१२-२६७-४०", "content_sanskrit": "स नद्यां समुपस्पृश्य तर्पयित्वा हुताशनम्।\nउदयन्तमथादित्यमभ्यागच्छन्महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2082669, "chapter_id": 2762, "verse_number": "१२-२६७-४१", "content_sanskrit": "संभाव्य चटकान्मूर्ध्नि जाजलिर्जपतांवरः।\nआस्फोटयत्तथाऽऽकाशे धर्मः प्राप्तो मयेति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2082670, "chapter_id": 2762, "verse_number": "१२-२६७-४२", "content_sanskrit": "अथान्तरिक्षे वागासीत्तां च शुश्राव जाजलिः।\nधर्मेण न समस्त्वं वै तुलाधारस्य जाजले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2082671, "chapter_id": 2762, "verse_number": "१२-२६७-४३", "content_sanskrit": "वाराणस्यां महाप्राज्ञस्तुलाधारः प्रतिष्ठितः।\nसोऽप्येवं नार्हते वक्तुं यथा त्वं भाषसे द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2082672, "chapter_id": 2762, "verse_number": "१२-२६७-४४", "content_sanskrit": "सोमर्षवशमापन्नस्तुलाधारदिदृक्षया।\nपृथिवीमचरद्राजन्यत्रसायंगृहो मुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2082673, "chapter_id": 2762, "verse_number": "१२-२६७-४५", "content_sanskrit": "कालेन महताऽगच्छत्स तु वाराणसीं पुरीम्।\nविक्रीणन्तं च पण्यानि तुलाधारं ददर्श सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2082674, "chapter_id": 2762, "verse_number": "१२-२६७-४६", "content_sanskrit": "सोऽपि दृष्ट्वैव तं विप्रमायान्तं भाण्डजीवनः।\nसमुत्थाय सुसंहृष्टः स्वागतेनाभ्यपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2082675, "chapter_id": 2762, "verse_number": "१२-२६७-४७x", "content_sanskrit": "तुलाधार उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2082676, "chapter_id": 2762, "verse_number": "१२-२६७-४७", "content_sanskrit": "आयानेवासि विदितो मम ब्रह्मन्न संशयः।\nब्रवीमि यत्तु वचनं तच्छृणुष्व द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2082677, "chapter_id": 2762, "verse_number": "१२-२६७-४८", "content_sanskrit": "सागरानूपमाश्रित्य तपस्तप्तं त्वया महत्।\nन च धर्मस्य संज्ञां त्वं पुरा वेत्थ कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2082678, "chapter_id": 2762, "verse_number": "१२-२६७-४९", "content_sanskrit": "ततः सिद्धस्य तपसा तव विप्र शकुन्तकाः।\nक्षिप्रं शिरस्यजायन्त ते च संभावितास्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2082679, "chapter_id": 2762, "verse_number": "१२-२६७-५०", "content_sanskrit": "जातपक्षा यदा ते च गता संचरितुं ततः।\nमन्यमानस्ततो धर्मं चटकप्रभवं द्विज।\nखे वाचां त्वमथाश्रौषीर्मां प्रति द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2082680, "chapter_id": 2762, "verse_number": "१२-२६७-५१", "content_sanskrit": "अमर्षवशमापन्नस्ततः प्राप्तो भवानिह।\nकरवाणि प्रियं किं ते तद्ब्रूहि द्विजसत्तम॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2082681, "chapter_id": 2762, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्तषष्ट्यधिकद्विशततमोऽध्यायः॥ २६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]