[{"id": 7000478000, "chapter_id": 20478, "verse_number": "३-२५-१", "content_sanskrit": "नारदौवाच ।\nवितस्तां च समासाद्य संतर्प्य पितृदेवताः ।\nनरः फलमवाप्नोति वाजपेयस्य भारत ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000478001, "chapter_id": 20478, "verse_number": "३-२५-२", "content_sanskrit": "काश्मीरेष्वेव नागस्य भवनं तक्षक स्यच ।\nवितस्ताख्यमिति ख्यातं सर्वपापप्रमोचनम् ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000478002, "chapter_id": 20478, "verse_number": "३-२५-३", "content_sanskrit": "तत्र स्नात्वा नरो नूनं वाजपेयमवाप्नुयात् ।\nसर्वपापविशुद्धात्मा गच्छेत परमां गतिम् ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000478003, "chapter_id": 20478, "verse_number": "३-२५-४", "content_sanskrit": "ततो गच्छेत मलदं त्रिषु लोकेषु विश्रुतम् ।\nपश्चिमायां तु संध्यायामुपस्पृश्य यथाविधि ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000478004, "chapter_id": 20478, "verse_number": "३-२५-५", "content_sanskrit": "चरुं सप्तार्चिषे राजन्यथाशक्ति निवेदयेत् ।\nपितॄणामक्षयं दानं प्रवदंति मनीषिणः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000478005, "chapter_id": 20478, "verse_number": "३-२५-६", "content_sanskrit": "गवांशतसहस्रेण राजसूयशतेन च ।\nअश्वमेधसहस्रेण श्रेयान्सप्तार्चिषश्चरुः ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000478006, "chapter_id": 20478, "verse_number": "३-२५-७", "content_sanskrit": "ततो निवृत्तो राजेंद्र रुद्रास्पदमथाविशेत् ।\nअभिगम्य महादेवमश्वमेधफलं लभेत् ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000478007, "chapter_id": 20478, "verse_number": "३-२५-८", "content_sanskrit": "मणिमंतं समासाद्य ब्रह्मचारी समाहितः ।\nएकरात्रोषितो राजन्नग्निष्टोमफलं लभेत् ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000478008, "chapter_id": 20478, "verse_number": "३-२५-९", "content_sanskrit": "अथ गच्छेत राजेंद्र देविकां लोकविश्रुताम् ।\nप्रसूतिर्यत्र विप्राणां श्रूयते भरतर्षभ ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000478009, "chapter_id": 20478, "verse_number": "३-२५-१०", "content_sanskrit": "त्रिशूलपाणेः स्थानं यत्त्रिषुलोकेषु विश्रुतम् ।\nदेविकायां नरः स्नात्वा अभ्यर्च्य च महेश्वरम् ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000478010, "chapter_id": 20478, "verse_number": "३-२५-११", "content_sanskrit": "यथाशक्ति नरस्तत्र निवेद्य भरतर्षभ ।\nसर्वकामसमृद्धस्य यज्ञस्य लभते फलम् ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000478011, "chapter_id": 20478, "verse_number": "३-२५-१२", "content_sanskrit": "कामाख्यं तत्र रुद्रस्य तीर्थं देवर्षिसंमतम् ।\nतत्र स्नात्वा नरः क्षिप्रं सिद्धिमाप्नोति भारत ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000478012, "chapter_id": 20478, "verse_number": "३-२५-१३", "content_sanskrit": "यजनं याजनं गत्वा तथैव ब्रह्मवालकम् ।\nपुष्पन्यास उपस्पृश्य न शोचेन्मरणं ततः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000478013, "chapter_id": 20478, "verse_number": "३-२५-१४", "content_sanskrit": "अर्द्धयोजनविस्तारां पंचयोजनमायताम् ।\nएतावद्देविकामाहुः पुण्यां देवर्षिसंमताम् ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000478014, "chapter_id": 20478, "verse_number": "३-२५-१५", "content_sanskrit": "ततो गच्छेत धर्मज्ञ दीर्घसत्रं यथाक्रमम् ।\nयत्र ब्रह्मादयो देवाः सिद्धाश्च परमर्षयः ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000478015, "chapter_id": 20478, "verse_number": "३-२५-१६", "content_sanskrit": "दीर्घसत्रमुपासंते दीक्षिता नियतव्रताः ।\nगमनादेव राजेंद्र दीर्घसत्रमरिंदम ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000478016, "chapter_id": 20478, "verse_number": "३-२५-१७", "content_sanskrit": "राजसूयाश्वमेधाभ्यां फलं प्राप्नोति मानवः ।\nततो विनाशनं गच्छेन्नियतो नियताशनः ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000478017, "chapter_id": 20478, "verse_number": "३-२५-१८", "content_sanskrit": "गच्छंत्यंतर्हिता यत्र मेरुपृष्ठे सरस्वती ।\nचमसे च शिवोद्भेदे नागोद्भेदे च दृश्यते ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000478018, "chapter_id": 20478, "verse_number": "३-२५-१९", "content_sanskrit": "स्नात्वा तु चमसोद्भेदे अग्निष्टोमफलं लभेत् ।\nशिवोद्भेदे नरः स्नात्वा गोसहस्रफलं लभेत् ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000478019, "chapter_id": 20478, "verse_number": "३-२५-२०", "content_sanskrit": "नागोद्भेदे नरः स्नात्वा नागलोकमवाप्नुयात् ।\nशशयानं च राजेंद्र तीर्थमासाद्य दुर्लभम् ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000478020, "chapter_id": 20478, "verse_number": "३-२५-२१", "content_sanskrit": "शशरूपप्रतिच्छन्ना पुष्करा यत्र भारत ।\nसरस्वत्यां महाभाग अनुसंवत्सरंहिते ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000478021, "chapter_id": 20478, "verse_number": "३-२५-२२", "content_sanskrit": "स्नायंते भरतश्रेष्ठ वृत्ता वै कार्त्तिकीं सदा ।\nतत्र स्नात्वा नरव्याघ्र द्योतते शिववत्सदा ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000478022, "chapter_id": 20478, "verse_number": "३-२५-२३", "content_sanskrit": "गोसहस्रफलं चैव प्राप्नुयाद्भरतर्षभ ।\nकुमारकोटिमासाद्य नियतः कुरुनंदन ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000478023, "chapter_id": 20478, "verse_number": "३-२५-२४", "content_sanskrit": "तत्राभिषेकं कुर्वीत पितृदेवार्चने रतः ।\nगवामयुतमाप्नोति कुलं चैव समुद्धरेत् ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000478024, "chapter_id": 20478, "verse_number": "३-२५-२५", "content_sanskrit": "ततो गच्छेत धर्मज्ञ रुद्रकोटिं समाहिताः ।\nपुरा यत्र महाराज ऋषिकोटिः समाहिता ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000478025, "chapter_id": 20478, "verse_number": "३-२५-२६", "content_sanskrit": "वर्षेण च समाविष्टा देवदर्शनकांक्षया ।\nअहंपूर्वमहंपूर्वं द्रक्ष्यामि वृषभध्वजम् ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000478026, "chapter_id": 20478, "verse_number": "३-२५-२७", "content_sanskrit": "एवं संप्रस्थिता राजनृषयः किलभारत ।\nततो योगीश्वरेणापि योगमास्थाय भूपते ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000478027, "chapter_id": 20478, "verse_number": "३-२५-२८", "content_sanskrit": "तेषां मन्युप्रशांत्यर्थमृषीणां भावितात्मनाम् ।\nसृष्टा तु कोटिरुद्राणामृषीणामग्रतः स्थिता ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000478028, "chapter_id": 20478, "verse_number": "३-२५-२९", "content_sanskrit": "मया पूर्वं हरो दृष्टो इति ते मेनिरे पृथक् ।\nतेषां तुष्टो महादेव ऋषीणामुग्रतेजसाम् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000478029, "chapter_id": 20478, "verse_number": "३-२५-३०", "content_sanskrit": "भक्त्या परमया राजन्वरं तेषां प्रदत्तवान् ।\nअद्यप्रभृति युष्माकं धर्मवृद्धिर्भविष्यति ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000478030, "chapter_id": 20478, "verse_number": "३-२५-३१", "content_sanskrit": "तत्र स्नात्वा नरव्याघ्र रुद्रकोट्यां नरः शुचिः ।\nअश्वमेधमवाप्नोति कुलं चैव समुद्धरेत् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000478031, "chapter_id": 20478, "verse_number": "३-२५-३२", "content_sanskrit": "ततो गच्छेत राजेंद्र संगमं लोकविश्रुतम् ।\nसरस्वत्यां महापुण्यमुपासीत जनार्दनम् ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000478032, "chapter_id": 20478, "verse_number": "३-२५-३३", "content_sanskrit": "यत्र ब्रह्मादयो देवा ऋषयः सिद्धचारणाः ।\nअभिगच्छंति राजेंद्र चैत्रशुक्लचतुर्दशीम् ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000478033, "chapter_id": 20478, "verse_number": "३-२५-३४", "content_sanskrit": "तत्र स्नात्वा नरव्याघ्र विंदेद्बहुसुवर्णकम् ।\nसर्वपापविशुद्धात्मा शिवलोकं च गच्छति ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000478034, "chapter_id": 20478, "verse_number": "३-२५-३५", "content_sanskrit": "ऋषीणां यत्र सत्राणि समाप्तानि नराधिप ।\nतत्रावसानमासाद्य गोसहस्रफलं लभेत् ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]