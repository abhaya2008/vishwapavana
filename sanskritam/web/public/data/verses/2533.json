[{"id": 2072693, "chapter_id": 2533, "verse_number": "१२-३८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072694, "chapter_id": 2533, "verse_number": "१२-३८-१", "content_sanskrit": "ततस्तत्र तु राजानं तिष्ठन्ते भ्रातृभिः सह।\nउवाच देवकीपुत्रः सर्वदर्शी जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072695, "chapter_id": 2533, "verse_number": "१२-३८-२x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072696, "chapter_id": 2533, "verse_number": "१२-३८-२", "content_sanskrit": "ब्राह्मणास्तात लोकेऽस्मिन्नर्चनीयाः सदा मम।\nएते भूमिचरा देवा वाग्विषाः सुप्रसादकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072697, "chapter_id": 2533, "verse_number": "१२-३८-३", "content_sanskrit": "पुरा कृतयुगे राजंश्चार्वाको नाम राक्षसः।\nतपस्तेपे महाबाहो बदर्यां बहुवार्षिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072698, "chapter_id": 2533, "verse_number": "१२-३८-४", "content_sanskrit": "वरेण च्छन्द्यमानश्च ब्रह्मणा च पुनः पुनः।\nअभयं सर्वभूतेभ्यो वरयामास भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072699, "chapter_id": 2533, "verse_number": "१२-३८-५", "content_sanskrit": "द्विजावमानादन्यत्र प्रादाद्वरमनुत्तमम्।\nअभयं सर्वभूतेभ्यो ददौ तस्मै जगत्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072700, "chapter_id": 2533, "verse_number": "१२-३८-६", "content_sanskrit": "स तु लब्धवरः पापो देवानमितविक्रमः।\nराक्षसस्तापयामास तीव्रकर्मा महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072701, "chapter_id": 2533, "verse_number": "१२-३८-७", "content_sanskrit": "ततो देवाः समेताश्च ब्रह्माणमिदमब्रुवन्।\nवधाय रक्षसस्तस्य बलविप्रकृतास्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072702, "chapter_id": 2533, "verse_number": "१२-३८-८", "content_sanskrit": "तानुवाच ततो देवो विहितं तत्र वै मया।\nयथाऽस्य भविता मृत्युरचिरणेति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072703, "chapter_id": 2533, "verse_number": "१२-३८-९", "content_sanskrit": "राजा दुर्योधनो नाम सखाऽस्य भविता नृषु।\nतस्य स्नेहावबद्धोऽसौ ब्राह्मणानवमंस्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072704, "chapter_id": 2533, "verse_number": "१२-३८-१०", "content_sanskrit": "तत्रैनं रुषिता विप्रा विप्रकारप्रधर्षिताः।\nधक्ष्यन्ति वाग्बलाः पापं ततो नाशं गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072705, "chapter_id": 2533, "verse_number": "१२-३८-११", "content_sanskrit": "स एष निहतः शेते ब्रह्मदण्डेन राक्षसः।\nचार्वाको नृपतिश्रेष्ठ मा शुचो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072706, "chapter_id": 2533, "verse_number": "१२-३८-१२", "content_sanskrit": "हतास्ते क्षत्रधर्मेण ज्ञातयस्तव पार्थिव।\nस्वर्गताश्च महात्मानो वीराः क्षत्रियपुङ्गवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072707, "chapter_id": 2533, "verse_number": "१२-३८-१३", "content_sanskrit": "स त्वमातिष्ठ कार्याणि मा ते भूद्वुद्धिरन्यथा।\nशत्रूञ्जहि प्रजा रक्ष द्विजांश्च परिपूजय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072708, "chapter_id": 2533, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि अष्टत्रिंशोऽध्यायः॥ ३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]