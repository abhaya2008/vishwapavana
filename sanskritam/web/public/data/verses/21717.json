[{"id": 7001717000, "chapter_id": 21717, "verse_number": "१-१०३-१", "content_sanskrit": "ब्रह्मोवाच ।\nश्रृणु वत्स प्रवक्ष्यामि वाराहं वै पुराणकम् ।\nभागद्वययुतं शश्वद्विष्णुमाहात्म्यसूचकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001717001, "chapter_id": 21717, "verse_number": "१-१०३-२", "content_sanskrit": "मानवस्य तु कल्पस्य प्रसंगं मत्कृतं पुरा ।\nनिबबंध पुराणेऽस्मिंश्चतुर्विंशसहस्रके ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001717002, "chapter_id": 21717, "verse_number": "१-१०३-३", "content_sanskrit": "व्यासो हि विदुषां श्रेष्ठः साक्षान्नारायणो भुवि ।\nतत्रादौ शुभसंवादः स्मृतोभूमिवराहयोः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001717003, "chapter_id": 21717, "verse_number": "१-१०३-४", "content_sanskrit": "अथादिकृतवृत्तांते रंभस्य चरितं ततः ।\nदुर्जयस्य च तत्पश्चाच्छ्राद्धकल्प उदीरितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001717004, "chapter_id": 21717, "verse_number": "१-१०३-५", "content_sanskrit": "महातपस आख्यानं गौर्युत्पत्तिस्ततः परा ।\nविनायकस्य नागानां सेनान्यादित्ययोरपि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001717005, "chapter_id": 21717, "verse_number": "१-१०३-६", "content_sanskrit": "गणानां च तथा देव्या धनदस्य वृषस्य च ।\nआख्यानं सत्यतपसो व्रताख्यानसमन्वितम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001717006, "chapter_id": 21717, "verse_number": "१-१०३-७", "content_sanskrit": "अगस्त्यगीता तत्पश्चाद्रुद्रगीता प्रकीर्तिता ।\nमहिषासुरविध्वंसमाहात्म्यं च त्रिशक्तिजम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001717007, "chapter_id": 21717, "verse_number": "१-१०३-८", "content_sanskrit": "पर्वाध्यायस्ततः श्वेतोपाख्यानं गोप्रदानिकम् ।\nइत्यादि कृतवृत्तांतं प्रथमे दर्शितं मया ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001717008, "chapter_id": 21717, "verse_number": "१-१०३-९", "content_sanskrit": "भगवद्धर्मके पश्चाद्वततीर्थकथानकम् ।\nद्वात्रिंशदपराधानां प्रायश्चित्तं शरीरगम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001717009, "chapter_id": 21717, "verse_number": "१-१०३-१०", "content_sanskrit": "तीर्थानां चापि सर्वेषां माहात्म्यं पृथगीरितम् ।\nमथुराया विशेषेण श्राद्धादीनां विधिस्ततः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001717010, "chapter_id": 21717, "verse_number": "१-१०३-११", "content_sanskrit": "वर्णनं यमलोकस्य ऋषिपुत्रप्रसंगतः ।\nविपाकः कर्मणां चैव विष्णुव्रतनिरूपणम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001717011, "chapter_id": 21717, "verse_number": "१-१०३-१२", "content_sanskrit": "गोकर्णस्य च माहात्म्यं कीर्तितं पापनाशनम् ।\nइत्येवं पूर्वभागोऽयं पुराणस्य निरूपितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001717012, "chapter_id": 21717, "verse_number": "१-१०३-१३", "content_sanskrit": "उत्तरे प्रविभागे तु पुलस्त्यकुरुराजयोः ।\nसंवादे सर्वतीर्थानां माहात्म्यं विस्तरात्पृथक् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001717013, "chapter_id": 21717, "verse_number": "१-१०३-१४", "content_sanskrit": "अशेषधर्माश्चाख्याताः पौष्करं पुण्यपर्व च ।\nइत्येवं तव वाराहं प्रोक्तं पापविनाशनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001717014, "chapter_id": 21717, "verse_number": "१-१०३-१५", "content_sanskrit": "पठतां श्रृण्वतां चैव भगवद्भक्तिवर्धनम् ।\nकांचनं गरुड कृत्वा तिलधेनुसमन्वितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001717015, "chapter_id": 21717, "verse_number": "१-१०३-१६", "content_sanskrit": "लिखित्वैतच्च यो दद्याच्चैत्र्यां विप्राय भक्तितः ।\nस लभेद्वैष्णवं धाम देवर्षिगणवंदितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001717016, "chapter_id": 21717, "verse_number": "१-१०३-१७", "content_sanskrit": "यो वानुक्रमणीमेंतां श्रृणोत्यपि पठत्यपि ।\nसोऽपि भक्तिं लभेद्विष्णौ संसारोच्छेदकारिणीम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]