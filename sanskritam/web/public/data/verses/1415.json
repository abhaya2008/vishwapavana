[{"id": 2019911, "chapter_id": 1415, "verse_number": "३-५३-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019912, "chapter_id": 1415, "verse_number": "३-५३-१", "content_sanskrit": "सा नमस्कृत्य देवेभ्यः प्रहस्य नलमब्रवीत्।\nप्रणयस्व यथाश्रद्धं राजन्किं करवाणि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019913, "chapter_id": 1415, "verse_number": "३-५३-२", "content_sanskrit": "अहं चैव हि यच्चान्यन्ममास्ति वसु किंचना।\nतत्सर्वं तव विस्रब्धं कुरु प्रणयमीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019914, "chapter_id": 1415, "verse_number": "३-५३-३", "content_sanskrit": "हंसानां वचनं यत्तु तन्मां दहति पार्थिव।\nत्वत्कृते हि मया वीर राजानः सन्निपातिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019915, "chapter_id": 1415, "verse_number": "३-५३-४", "content_sanskrit": "यदि त्वं भजमानां मां प्रत्याख्यास्यसि मानद।\nविषमग्निं जलं रज्जुमास्थास्ये तव कारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019916, "chapter_id": 1415, "verse_number": "३-५३-५", "content_sanskrit": "एवमुक्तस्तु वैदर्भ्या नलस्तां प्रत्युवाच ह।\nतिष्ठत्सु लोकपालेषु कथं मानुषमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019917, "chapter_id": 1415, "verse_number": "३-५३-६", "content_sanskrit": "येषामहं लोककृतामीश्वराणां महात्मनाम्।\nन पादरजसा तुल्यो मनस्ते तेषु वर्तताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019918, "chapter_id": 1415, "verse_number": "३-५३-७", "content_sanskrit": "विप्रियं ह्याचरन्मर्त्यो देवानां मृत्युच्छति।\nत्राहि मामनवद्याङ्गि वरयस्व सुरोत्तमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019919, "chapter_id": 1415, "verse_number": "३-५३-८", "content_sanskrit": "विरजांसि च वासांसि दिव्याश्चित्राः स्रजस्तथा।\nभूषणानि तु दिव्यानि देवान्प्राप्य तु भुङ्क्ष्व वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019920, "chapter_id": 1415, "verse_number": "३-५३-९", "content_sanskrit": "य इमां पृथिवीं कृत्स्नां संक्षिप्य ग्रसते पुनः।\nहुताशमीशं देवानां का तं न वरयेत्पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019921, "chapter_id": 1415, "verse_number": "३-५३-१०", "content_sanskrit": "यस् दण्डभयात्सर्वे भूतग्रामाः समागताः।\nधर्ममेवानुरुध्यन्ति का तं न वरयेत्पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019922, "chapter_id": 1415, "verse_number": "३-५३-११", "content_sanskrit": "धर्मात्मानं महात्मानं दैत्यदानवमर्दनम्।\nमहेन्द्रं सर्वदेवानां का तं न वरयेत्पतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019923, "chapter_id": 1415, "verse_number": "३-५३-१२", "content_sanskrit": "क्रियतामविशङ्केन मनसा यदि मन्यसे।\nवरुणं लोकपालानां सुहृद्वाक्यमिदं शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019924, "chapter_id": 1415, "verse_number": "३-५३-१३", "content_sanskrit": "नैषधेनैवमुक्ता सा दमयन्ती बचोऽब्रवीत्।\nसमाप्लुताभ्यां नेत्राभ्यां शोकजेनाथ वारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019925, "chapter_id": 1415, "verse_number": "३-५३-१४", "content_sanskrit": "देवेभ्योऽहं नमस्कृत् यसर्वेभ्यः पृथिवीपते।\nवृणे त्वामेव भर्तारं सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019926, "chapter_id": 1415, "verse_number": "३-५३-१५", "content_sanskrit": "तामुवाच ततो राजा वेषमानां कृताञ्जलिम्।\nदौत्येनागत्य कल्याणि नोत्सहे स्वार्थमीप्सितं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019927, "chapter_id": 1415, "verse_number": "३-५३-१६", "content_sanskrit": "कथं ह्यहं प्रतिश्रुत्य देवतानां विशेषतः।\nपरार्थे यत्नमारभ्य कथं स्वार्थमिहोत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019928, "chapter_id": 1415, "verse_number": "३-५३-१७", "content_sanskrit": "एष धर्मो यदि स्वार्थो ममापि भविता ततः।\nएवं स्वार्थं करिष्यामि तथा भद्रे विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019929, "chapter_id": 1415, "verse_number": "३-५३-१८", "content_sanskrit": "ततो बाष्पाकुलांवाचं दमयन्ती शुचिस्मिता।\nप्रत्याहरन्ती शनकैर्नलं राजानमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019930, "chapter_id": 1415, "verse_number": "३-५३-१९", "content_sanskrit": "अस्त्युपायो मया दृष्टो निरपायो नरेश्वर।\nयेन दोषो न भविता तव राजन्कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019931, "chapter_id": 1415, "verse_number": "३-५३-२०", "content_sanskrit": "त्वं चैव हि नरश्रेष्ठ देवाश्चेन्द्रपुरोगमाः।\nआयान्तु सहिताः सर्वे मम यत्र स्वयंवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019932, "chapter_id": 1415, "verse_number": "३-५३-२१", "content_sanskrit": "ततोऽहं लोकपालानां सन्निधौ त्वां नरेश्वर।\nवरयिष्ये नरव्याघ्र नैवं दोषो भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019933, "chapter_id": 1415, "verse_number": "३-५३-२२", "content_sanskrit": "एवमुक्तस्तु वैदर्भ्या नलो राजा विशंपते।\nआजगाम पुनस्तत्र यत्र देवाः समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019934, "chapter_id": 1415, "verse_number": "३-५३-२३", "content_sanskrit": "तमपश्यंस्तथाऽऽयान्तं लोकपाला महेश्वराः।\nदृष्ट्वा चैनं ततोऽपृच्छन्वृत्तान्तं सर्वमेव तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019935, "chapter_id": 1415, "verse_number": "३-५३-२४", "content_sanskrit": "कच्चिद्दृष्टा त्वया राजन्दमयन्ती शुचिस्मिता।\nकिमब्रवीच्च नः सर्वान्वद भूमिपतेऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019936, "chapter_id": 1415, "verse_number": "३-५३-२५x", "content_sanskrit": "नल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019937, "chapter_id": 1415, "verse_number": "३-५३-२५", "content_sanskrit": "भवद्भिरहमादिष्टो दमयन्त्या निवेशनम्।\nप्रविष्टः सुमहाकक्ष्यं दण्डिभिः स्थविरैर्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019938, "chapter_id": 1415, "verse_number": "३-५३-२६", "content_sanskrit": "प्रविशन्तं च मां तत्र न कश्चिद्दृष्टवान्नरः।\nऋते तां पार्तिवसुतां भवतामेव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019939, "chapter_id": 1415, "verse_number": "३-५३-२७", "content_sanskrit": "सख्यश्चास्या मया दृष्टास्ताभिश्चाप्युपलक्षितः।\nविस्मिताश्चाभवन्सर्वा दृष्ट्वा मां विबुधेश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019940, "chapter_id": 1415, "verse_number": "३-५३-२८", "content_sanskrit": "वर्ण्यमानेषु च मया भवत्सु रुचिराननां।\nमामेव गतसंकल्पा वृणीते सा सुरोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019941, "chapter_id": 1415, "verse_number": "३-५३-२९", "content_sanskrit": "अब्रवीच्चैव मां बाला आयान्तु सहिताः सुराः।\nत्वया सह नरव्याघ्र मम यत्रस्वयंवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019942, "chapter_id": 1415, "verse_number": "३-५३-३०", "content_sanskrit": "तेषामहं संनिधौ त्वां वरयिष्यामि नैषध।\nएवं तव महाबाहो दोषो न भवितेति ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019943, "chapter_id": 1415, "verse_number": "३-५३-३१", "content_sanskrit": "एतावदेव विबुधा यथावृत्तमुपाहृतम्।\nमया शेषे प्रमाणं तु भवन्तस्त्रिदशेश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019944, "chapter_id": 1415, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि त्रिपञ्चाशोऽध्यायः ॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]