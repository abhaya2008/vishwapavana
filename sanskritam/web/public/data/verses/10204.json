[{"id": 6000204000, "chapter_id": 10204, "verse_number": null, "content_sanskrit": "अथ अष्टमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000204001, "chapter_id": 10204, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.001.m4a", "display_order": 2}, {"id": 6000204002, "chapter_id": 10204, "verse_number": "१०-८-१", "content_sanskrit": "एवं स ववृधे विष्णुर्नन्दगेहे जनार्दनः।\nकुर्वन्ननिशमानन्दं गोपालानां सयोषिताम्॥ १०/८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णेन शकटासुरभञ्जनम्", "range": "१–९"}]}, {"id": 6000204003, "chapter_id": 10204, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.003.m4a", "display_order": 4}, {"id": 6000204004, "chapter_id": 10204, "verse_number": "१०-८-२", "content_sanskrit": "येन येनावतारेण भगवान् हरिरीश्वरः।\nकरोति कर्णरम्याणि मनोज्ञानि च नः प्रभो॥ १०/८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.004.m4a", "display_order": 5}, {"id": 6000204005, "chapter_id": 10204, "verse_number": "१०-८-३", "content_sanskrit": "यच्छृण्वतोऽपैत्यरतिर्वितृष्णा सत्त्वं विशुद्ध्यत्यचिरेण पुंसः।\nभक्तिर्हरौ तत्पुरुषे च सख्यं तदेव सारं वद मन्यसे चेत्॥ १०/८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.005.m4a", "display_order": 6}, {"id": 6000204006, "chapter_id": 10204, "verse_number": "१०-८-४", "content_sanskrit": "अथान्यदपि कृष्णस्य तोकाचरितमद्भुतम्।\nमानुषं देहमासाद्य तज्जातिमनुरुन्धतः॥ १०/८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.006.m4a", "display_order": 7}, {"id": 6000204007, "chapter_id": 10204, "verse_number": "१०-८-५", "content_sanskrit": "विस्तरेणेह कारुण्यात् सर्वपापप्रणाशनम्।\nवक्तुमर्हसि धर्मज्ञ दयालुस्त्वमिति प्रभो॥ १०/८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.007.m4a", "display_order": 8}, {"id": 6000204008, "chapter_id": 10204, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.008.m4a", "display_order": 9}, {"id": 6000204009, "chapter_id": 10204, "verse_number": "१०-८-६", "content_sanskrit": "कदाचिदौत्थानिककौतुकाप्लवे जन्मर्क्षयोगे समवेतयोषिताम्।\nवादित्रगीतद्विजमन्त्रवाचकैश्चकार सूनोरभिषेचनं सती॥ १०/८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.009.m4a", "display_order": 10}, {"id": 6000204010, "chapter_id": 10204, "verse_number": "१०-८-७", "content_sanskrit": "नन्दस्य पत्नी कृतमज्जनादिकं विप्रैः कृतस्वस्त्ययनं सुपूजितैः।\nअन्नाद्यवासःस्रगभीष्टधेनुभिः सञ्जातनिद्राक्षमशीशयच्छनैः॥ १०/८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.010.m4a", "display_order": 11}, {"id": 6000204011, "chapter_id": 10204, "verse_number": "१०-८-८", "content_sanskrit": "औत्थानिकौत्सुक्यमना मनस्विनी समागतान् पूजयती व्रजौकसः।\nनैवाशृणोद् वै रुदितं सुतस्य सा रुदन् स्तनार्थी चरणावुदक्षिपत्॥ १०/८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.011.m4a", "display_order": 12}, {"id": 6000204012, "chapter_id": 10204, "verse_number": "१०-८-९", "content_sanskrit": "अनः शयानस्य शिशोरथाल्पकप्रवालमृद्वङ्घ्रिहतं व्यवर्तत।\nविध्वस्तनानारसकुप्यभाजनं व्यत्यस्तचक्राक्षविभिन्नकूबरम्॥ १०/८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.012.m4a", "display_order": 13}, {"id": 6000204013, "chapter_id": 10204, "verse_number": "१०-८-१०", "content_sanskrit": "दृष्ट्वा यशोदाप्रमुखा व्रजस्‍त्रिय औत्थानिके कर्मणि याः समागताः।\nनन्दादयश्चाद्भुतदर्शनाकुलाः कथं स्वयं वै शकटं विपर्यगात्।\nइति ब्रुवन्तोऽतिविषादमोहिता जनाः समन्तात् परिवव्रुरार्तवत्॥ १०/८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.013.m4a", "display_order": 14, "topics": [{"text": "नन्देन ब्राह्मणोत्तमैः स्वस्तिवाचनं गोदानञ्च", "range": "१०–१९"}]}, {"id": 6000204014, "chapter_id": 10204, "verse_number": "१०-८-११", "content_sanskrit": "ऊचुस्तदव्यक्तमतीन् गोपान् गोपीश्च बालकाः।\nरुदताऽनेन पादेन क्षिप्तमेतन्न संशयः॥ १०/८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.014.m4a", "display_order": 15}, {"id": 6000204015, "chapter_id": 10204, "verse_number": "१०-८-१२", "content_sanskrit": "न ते श्रद्दधिरे गोपा बालभाषितमित्युत।\nअनन्तस्याप्रमेयस्य बलं तस्य न वै विदुः॥ १०/८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.015.m4a", "display_order": 16}, {"id": 6000204016, "chapter_id": 10204, "verse_number": "१०-८-१३", "content_sanskrit": "रुदन्तं सुतमादाय यशोदा ग्रहशङ्किता।\nकृतस्वस्त्ययनं विप्रैः सूक्तैः स्तनमपाययत्॥ १०/८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.016.m4a", "display_order": 17}, {"id": 6000204017, "chapter_id": 10204, "verse_number": "१०-८-१४", "content_sanskrit": "पूर्ववत् स्थापितं गोपैर्बलिभिः सपरिच्छदम्।\nविप्रा हुत्वाऽर्चयाञ्चक्रुर्दध्यक्षतकुशाम्बुभिः॥ १०/८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.017.m4a", "display_order": 18}, {"id": 6000204018, "chapter_id": 10204, "verse_number": "१०-८-१५", "content_sanskrit": "येऽसूयानृतदम्भेर्ष्याहिंसामानविवर्जिताः।\nन तेषां सत्यशीलानामाशिषो विफलाः क्‍वचित्॥ १०/८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.018.m4a", "display_order": 19}, {"id": 6000204019, "chapter_id": 10204, "verse_number": "१०-८-१६", "content_sanskrit": "इति बालकमानीय सामर्ग्यजुरुपाकृतैः।\nजलैः पवित्रौषधिभिरभिषिच्य द्विजोत्तमैः॥ १०/८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.019.m4a", "display_order": 20}, {"id": 6000204020, "chapter_id": 10204, "verse_number": "१०-८-१७", "content_sanskrit": "वाचयित्वा स्वस्त्ययनं नन्दगोपः समाहितः।\nहुत्वा चाग्निं द्विजातिभ्यः प्रादादन्नं महागुणम्॥ १०/८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.020.m4a", "display_order": 21}, {"id": 6000204021, "chapter_id": 10204, "verse_number": "१०-८-१८", "content_sanskrit": "गाश्च सर्वगुणोपेता वासःस्रग्रुग्ममालिनीः।\nपुत्रस्याभ्युदयार्थाय प्राग्जातेश्चान्वयुञ्जत॥ १०/८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.021.m4a", "display_order": 22}, {"id": 6000204022, "chapter_id": 10204, "verse_number": "१०-८-१९", "content_sanskrit": "विप्रा मन्त्रविदो युक्तास्तैर्याः प्रोक्तास्तथाऽऽशिषः।\nता निष्फला भविष्यन्ति न कदाचिदपि स्फुटम्॥ १०/८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.022.m4a", "display_order": 23}, {"id": 6000204023, "chapter_id": 10204, "verse_number": "१०-८-२०", "content_sanskrit": "एकदाऽऽरोहमारूढं लालयन्ती सुतं सती।\nगरिमाणं शिशोर्वोढुं न सेहे गिरिकूटवत्॥ १०/८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.023.m4a", "display_order": 24, "topics": [{"text": "तृणावर्तवधः", "range": "२०–३५"}]}, {"id": 6000204024, "chapter_id": 10204, "verse_number": "१०-८-२१", "content_sanskrit": "भूमौ निधाय तं गोपी विस्मिता भारपीडिता।\nमहापुरुषमादध्यौ जगामाशु च कर्मसु॥ १०/८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.024.m4a", "display_order": 25}, {"id": 6000204025, "chapter_id": 10204, "verse_number": "१०-८-२२", "content_sanskrit": "दैत्यो नाम्ना तृणावर्तः कंसभृत्यः प्रचोदितः।\nचक्रवातस्वरूपेण जहारासीनमर्भकम्॥ १०/८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.025.m4a", "display_order": 26}, {"id": 6000204026, "chapter_id": 10204, "verse_number": "१०-८-२३", "content_sanskrit": "गोकुलं सर्वमावृण्वन् मुष्णंश्चक्षूंषि रेणुभिः।\nईरयन् सुमहाघोरशब्देन प्रदिशो दिशः॥ १०/८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.026.m4a", "display_order": 27}, {"id": 6000204027, "chapter_id": 10204, "verse_number": "१०-८-२४", "content_sanskrit": "मुहूर्तमभवद् गोष्ठं रजसा तमसाऽऽवृतम्।\nसुतं यशोदा नापश्यत् तस्मिन् न्यस्तवती यतः॥ १०/८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.027.m4a", "display_order": 28}, {"id": 6000204028, "chapter_id": 10204, "verse_number": "१०-८-२५", "content_sanskrit": "नापश्यत् कश्चनात्मनं परं चापि विमोहितः।\nतृणावर्तनिसृष्टाभिः शर्कराभिरुपद्रुतः॥ १०/८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.028.m4a", "display_order": 29}, {"id": 6000204029, "chapter_id": 10204, "verse_number": "१०-८-२६", "content_sanskrit": "इति खरपवनचक्रपांसुवर्षे सुतपदवीमबलाऽविचक्षमाणा।\nअतिकरुणमनुस्मरन्त्यशोचद् भुवि पतिता मृतवत्सका यथा गौः॥ १०/८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.029.m4a", "display_order": 30}, {"id": 6000204030, "chapter_id": 10204, "verse_number": "१०-८-२७", "content_sanskrit": "रुदितमनुनिशम्य तत्र गोप्यो भृशमनुतप्तधियोऽश्रुपूर्णमुख्यः।\nरुरुदुरनुपलभ्य नन्दसूनुं पवन उपारतपांसुवर्षवेगे॥ १०/८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.030.m4a", "display_order": 31}, {"id": 6000204031, "chapter_id": 10204, "verse_number": "१०-८-२८", "content_sanskrit": "तृणावर्तः शान्तरयो वात्यारूपधरो हरन्।\nकृष्णं नभोगतो गन्तुं नाशक्नोद् भूरिभारभृत्॥ १०/८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.031.m4a", "display_order": 32}, {"id": 6000204032, "chapter_id": 10204, "verse_number": "१०-८-२९", "content_sanskrit": "तमश्मानं मन्यमान आत्मनो गुरुमत्तया।\nगले गृहीत उत्स्रष्टुं नाशक्नोदद्भुतार्भकम्॥ १०/८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.032.m4a", "display_order": 33}, {"id": 6000204033, "chapter_id": 10204, "verse_number": "१०-८-३०", "content_sanskrit": "गलग्रहणनिश्चेष्टो दैत्यो निर्गतलोचनः।\nअव्यक्तवाक्यो न्यपतत् सहबालो व्यसुर्व्रजे॥ १०/८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.033.m4a", "display_order": 34}, {"id": 6000204034, "chapter_id": 10204, "verse_number": "१०-८-३१", "content_sanskrit": "तमन्तरिक्षात् पतितं शिलायां विशीर्णसर्वावयवं करालम्।\nपुरं यथा रुद्रशरेण विद्धं स्‍त्रियो रुदन्त्यो ददृशुः समेताः॥ १०/८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.034.m4a", "display_order": 35}, {"id": 6000204035, "chapter_id": 10204, "verse_number": "१०-८-३२", "content_sanskrit": "आदाय मात्रे प्रतिहृत्य विस्मिताः कृष्णं च तस्योपरि लम्बमानम्।\nतं स्वस्तिमन्तं पुरुषादनीतं विहायसा मृत्युमुखात् प्रमुक्तम्॥ १०/८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.035.m4a", "display_order": 36}, {"id": 6000204036, "chapter_id": 10204, "verse_number": "१०-८-३३", "content_sanskrit": "गोप्यः सगोपाः किल नन्दमुख्याः लब्ध्वा पुनः प्रापुरतीव मोदम्।\nअहो बतात्यद्भुतमेष रक्षसा बालो निवृत्तिं गमितोऽभ्यगात् पुनः॥ १०/८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.036.m4a", "display_order": 37}, {"id": 6000204037, "chapter_id": 10204, "verse_number": "१०-८-३४", "content_sanskrit": "हिंस्रः स्वपापेन विहिंसितः खलः साधुः समत्वेन भयाद् विमुच्यते।\nकिं नस्तपश्चीर्णमधोक्षजार्चनं पूर्तेष्टदत्तं किमु भूतसौहृदम्।\nयः सम्परेतः पुनरेव बालको दिष्ट्या स्वबन्धून् प्रणयन्नुपस्थितः॥ १०/८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.037.m4a", "display_order": 38}, {"id": 6000204038, "chapter_id": 10204, "verse_number": "१०-८-३५", "content_sanskrit": "दृष्ट्वाऽद्भुतानि बहुशो नन्दगोपो बृहद्वने।\nवसुदेववचो भूयो मानयामास विस्मितः॥ १०/८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.038.m4a", "display_order": 39}, {"id": 6000204039, "chapter_id": 10204, "verse_number": "१०-८-३६", "content_sanskrit": "एकदाऽर्भकमादाय स्वाङ्कमारोप्य भामिनी।\nप्रस्नुतं पाययामास स्तनं स्नेहपरिप्लुता॥ १०/८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.039.m4a", "display_order": 40, "topics": [{"text": "स्वमात्रे यशोदायै विश्वरूपप्रदर्शनम्", "range": "३६–३९"}]}, {"id": 6000204040, "chapter_id": 10204, "verse_number": "१०-८-३७", "content_sanskrit": "पीतप्रायस्य जननी सुतस्य रुचिरस्मितम्।\nमुखं लालयती राजन् जृम्भतो ददृशे इदम्॥ १०/८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.040.m4a", "display_order": 41}, {"id": 6000204041, "chapter_id": 10204, "verse_number": "१०-८-३८", "content_sanskrit": "खं रोदसी ज्योतिरनीकमाशाः सूर्येन्दुवह्निश्वसनाम्बुधींश्च।\nद्वीपान् नगांस्तद्दुहितॄर्वनानि भूतानि यानि स्थिरजङ्गमानि॥ १०/८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.041.m4a", "display_order": 42}, {"id": 6000204042, "chapter_id": 10204, "verse_number": "१०-८-३९", "content_sanskrit": "संवीक्ष्य विश्वं सहसा राजन् सञ्जातवेपथुः।\nसम्मील्य मृगशावाक्षी नेत्रे आसीत् सुविस्मिता॥ १०/८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_008/BhP_10.008.042.m4a", "display_order": 43}, {"id": 6000204043, "chapter_id": 10204, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे अष्टमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]