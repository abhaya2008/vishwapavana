[{"id": 6000190000, "chapter_id": 10190, "verse_number": null, "content_sanskrit": "अथ पञ्चदशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000190001, "chapter_id": 10190, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.001.m4a", "display_order": 2}, {"id": 6000190002, "chapter_id": 10190, "verse_number": "९-१५-१", "content_sanskrit": "यतिर्ययातिः संयातिरायातिर्वियतिः कृतिः।\nषडिमे नहुषस्यासन् इन्द्रियाणीव देहिनः॥ ९/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.002.m4a", "display_order": 3, "topics": [{"text": "पुरूरवसो ज्येष्ठपुत्रस्य आयोर्नहुषादिपुत्रपञ्चकोत्पत्तिः", "range": "१"}]}, {"id": 6000190003, "chapter_id": 10190, "verse_number": "९-१५-२", "content_sanskrit": "राज्यं नैच्छद् यतिः पित्रा दत्तं तत्परिणामवित्।\nयत्र प्रविष्टः पुरुष आत्मानं नावबुध्यते॥ ९/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.003.m4a", "display_order": 4, "topics": [{"text": "नहुषव्यतिरिक्तानां क्षत्रवृद्धादीनां चतुर्णां पुत्राणां वंशकथनम्॥ नहुषस्य यतिप्रभृतिपुत्रषट्कोत्पत्तिः", "range": "२"}]}, {"id": 6000190004, "chapter_id": 10190, "verse_number": "९-१५-३", "content_sanskrit": "पितरि भ्रंशिते स्थानाद् इन्द्राण्या धर्षणाद् द्विजैः।\nप्रापितेऽजगरत्वं च ययातिरभवन्नृपः॥ ९/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.004.m4a", "display_order": 5, "topics": [{"text": "द्वितीयपुत्रस्य ययातेः शर्मिष्ठादेवयानीभ्यां विवाहः", "range": "३–२०"}]}, {"id": 6000190005, "chapter_id": 10190, "verse_number": "९-१५-४", "content_sanskrit": "चतसृष्वादिशद् दिक्षु भ्रातॄन् गोप्तॄन् यवीयसः।\nकृतदारो जुगोपोर्वीं काव्यस्य वृषपर्वणः॥ ९/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.005.m4a", "display_order": 6}, {"id": 6000190006, "chapter_id": 10190, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.006.m4a", "display_order": 7}, {"id": 6000190007, "chapter_id": 10190, "verse_number": "९-१५-५", "content_sanskrit": "ब्रह्मर्षिर्भगवान् काव्यः क्षत्रबन्धुश्च नाहुषः।\nराजन्यविप्रयोः कस्माद् विवाहः प्रातिलोमकः॥ ९/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.007.m4a", "display_order": 8}, {"id": 6000190008, "chapter_id": 10190, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.008.m4a", "display_order": 9}, {"id": 6000190009, "chapter_id": 10190, "verse_number": "९-१५-६", "content_sanskrit": "एकदा दानवेन्द्रस्य शर्मिष्ठा नाम कन्यका।\nसखीसहस्रसंयुक्ता गुरुपुत्र्या च भामिनी॥ ९/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.009.m4a", "display_order": 10}, {"id": 6000190010, "chapter_id": 10190, "verse_number": "९-१५-७", "content_sanskrit": "देवयान्या पुरोद्याने पुष्पितद्रुमसङ्कुले।\nव्यचरत् कलगीतालिनलिनीपुलिनेऽबला॥ ९/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.010.m4a", "display_order": 11}, {"id": 6000190011, "chapter_id": 10190, "verse_number": "९-१५-८", "content_sanskrit": "जलाशयं समासाद्य कन्याः कमललोचनाः।\nतीरे न्यस्य दुकूलानि विजह्रुः सिञ्चतीर्मिथः॥ ९/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.011.m4a", "display_order": 12}, {"id": 6000190012, "chapter_id": 10190, "verse_number": "९-१५-९", "content_sanskrit": "व्रजन्तं वीक्ष्य गिरिशं सह देव्या वृषे स्थितम्।\nसहसोत्तीर्य वासांसि पर्यधुर्व्रीडिताः स्‍त्रियः॥ ९/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.012.m4a", "display_order": 13}, {"id": 6000190013, "chapter_id": 10190, "verse_number": "९-१५-१०", "content_sanskrit": "शर्मिष्ठाऽजानती वासो गुरुपुत्र्याः समव्ययत्।\nस्वीयं मत्वा प्रकुपिता देवयानीदमब्रवीत्॥ ९/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.013.m4a", "display_order": 14}, {"id": 6000190014, "chapter_id": 10190, "verse_number": "९-१५-११", "content_sanskrit": "अहो निरीक्ष्यतां मह्यं दास्याः कर्म ह्यसाम्प्रतम्।\nअस्मद्धार्यं धृतवती शुनीव हविरध्वरे॥ ९/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.014.m4a", "display_order": 15}, {"id": 6000190015, "chapter_id": 10190, "verse_number": "९-१५-१२", "content_sanskrit": "यैरिदं तपसा सृष्टं मुखं पुंसः परस्य वै।\nधार्यते यैः परं ज्योतिः शिवः पन्थाश्च दर्शितः॥ ९/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.015.m4a", "display_order": 16}, {"id": 6000190016, "chapter_id": 10190, "verse_number": "९-१५-१३", "content_sanskrit": "येऽपीदमुपतिष्ठन्ते लोकनाथाः सुरेश्वराः।\nभगवानपि विश्वात्मा पावनः श्रीनिकेतनः॥ ९/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.016.m4a", "display_order": 17}, {"id": 6000190017, "chapter_id": 10190, "verse_number": "९-१५-१४", "content_sanskrit": "वयं तत्रापि भृगवः शिष्योऽस्या नः पिताऽसुरः।\nअस्मद्धार्यं धृतवती शूद्रो वेदमिवासती॥ ९/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.017.m4a", "display_order": 18}, {"id": 6000190018, "chapter_id": 10190, "verse_number": "९-१५-१५", "content_sanskrit": "एवं क्षिपन्तीं शर्मिष्ठा गुरुपुत्रीमभाषत।\nरुषा श्वसन्ती नागीव धर्षिता दष्टदच्छदा॥ ९/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.018.m4a", "display_order": 19}, {"id": 6000190019, "chapter_id": 10190, "verse_number": "९-१५-१६", "content_sanskrit": "आत्मवृत्तिमविज्ञाय कत्थसे बहु भिक्षुकि।\nकिं न प्रतीक्षसेऽस्माकं गृहान् बलिभुजो यथा॥ ९/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.019.m4a", "display_order": 20}, {"id": 6000190020, "chapter_id": 10190, "verse_number": "९-१५-१७", "content_sanskrit": "एवंविधैः सुपरुषैः क्षिप्त्वाऽऽचार्यसुतां सतीम्।\nशर्मिष्ठा प्राक्षिपत् कूपे वासस्त्वादाय मन्युना॥ ९/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.020.m4a", "display_order": 21}, {"id": 6000190021, "chapter_id": 10190, "verse_number": "९-१५-१८", "content_sanskrit": "तस्यां गतायां स्वगृहं ययातिर्मृगयां चरन्।\nप्राप्तो यदृच्छया कूपे जलार्थी तां ददर्श ह॥ ९/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.021.m4a", "display_order": 22}, {"id": 6000190022, "chapter_id": 10190, "verse_number": "९-१५-१९", "content_sanskrit": "दत्त्वा स्वमुत्तरं वासस्तस्यै राजा विवाससे।\nगृहीत्वा पाणिना पाणिमुज्जहार दयापरः॥ ९/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.022.m4a", "display_order": 23}, {"id": 6000190023, "chapter_id": 10190, "verse_number": "९-१५-२०", "content_sanskrit": "तं वीरमाहौशनसी प्रेमनिर्भरया गिरा। राजंस्त्वया गृहीतो मे पाणिः परपुरञ्जय।\nहस्तग्रहोऽपरो मा भूद् गृहीतायास्त्वया हि मे॥ ९/१५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.023.m4a", "display_order": 24}, {"id": 6000190024, "chapter_id": 10190, "verse_number": "९-१५-२१", "content_sanskrit": "एष ईशकृतो वीर सम्बन्धो नौ न पौरुषः।\nयदिदं कूपमग्नाया भवतो दर्शनं मम॥ ९/१५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.024.m4a", "display_order": 25, "topics": [{"text": "देवयान्याः पित्रा शुक्राचार्येण ययातेर्जराप्राप्तिरूपकशापदानम्", "range": "२१–३७"}]}, {"id": 6000190025, "chapter_id": 10190, "verse_number": "९-१५-२२", "content_sanskrit": "न ब्राह्मणो मे भविता हस्तग्राहो महाभुज।\nकचस्य बार्हस्पत्यस्य शापाद् यमशपं पुरा॥ ९/१५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.025.m4a", "display_order": 26}, {"id": 6000190026, "chapter_id": 10190, "verse_number": "९-१५-२३", "content_sanskrit": "ययातिरनभिप्रेतं दैवोपहृतमात्मनः।\nमनस्तु तद्गतं बुद्‌ध्वा प्रतिजग्राह तद्वचः॥ ९/१५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.026.m4a", "display_order": 27}, {"id": 6000190027, "chapter_id": 10190, "verse_number": "९-१५-२४", "content_sanskrit": "गते राजनि सा वीरे तत्र स्म रुदती पितुः।\nन्यवेदयत् ततः सर्वमुक्तं शर्मिष्ठया कृतम्॥ ९/१५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.027.m4a", "display_order": 28}, {"id": 6000190028, "chapter_id": 10190, "verse_number": "९-१५-२५", "content_sanskrit": "दुर्मना भगवान् काव्यः पौरोहित्यं विगर्हयन्।\nस्तुवन् वृत्तिं च कापोतीं दुहित्रा स ययौ पुरात्॥ ९/१५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.028.m4a", "display_order": 29}, {"id": 6000190029, "chapter_id": 10190, "verse_number": "९-१५-२६", "content_sanskrit": "वृषपर्वा तमाज्ञाय प्रत्यनीकविवक्षितम्।\nगुरुं प्रसादयन् मूर्ध्ना पादयोः पतितः पथि॥ ९/१५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.029.m4a", "display_order": 30}, {"id": 6000190030, "chapter_id": 10190, "verse_number": "९-१५-२७", "content_sanskrit": "क्षणार्धमन्युर्भगवाञ्छिष्यं व्याचष्ट भार्गवः।\nकामोऽस्याः क्रियतां राजन् नैनां त्यक्तुमिहोत्सहे २७॥ ९/१५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.030.m4a", "display_order": 31}, {"id": 6000190031, "chapter_id": 10190, "verse_number": "९-१५-२८", "content_sanskrit": "तथेत्यवस्थिते प्राह देवयानी मनोगतम्।\nपित्रा दत्ता यतो यास्ये सानुगा यातु मामनु॥ ९/१५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.031.m4a", "display_order": 32}, {"id": 6000190032, "chapter_id": 10190, "verse_number": "९-१५-२९", "content_sanskrit": "स्वानां तत् सङ्कटं वीक्ष्य तदर्थस्य च गौरवम्।\nदेवयानीं पर्यचरत् स्‍त्रीसहस्रेण दासिवत्॥ ९/१५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.032.m4a", "display_order": 33}, {"id": 6000190033, "chapter_id": 10190, "verse_number": "९-१५-३०", "content_sanskrit": "नाहुषाय सुतां दत्त्वा सह शर्मिष्ठयोशनाः।\nतमाह राजञ्छर्मिष्ठां मा धास्तल्पे तु कर्हिचित्॥ ९/१५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.033.m4a", "display_order": 34}, {"id": 6000190034, "chapter_id": 10190, "verse_number": "९-१५-३१", "content_sanskrit": "विलोक्यौशनसीं राज्ञीं शर्मिष्ठा सुप्रजां क्‍वचित्।\nतमेव वव्रे रहसि सख्याः पतिमृतौ सति॥ ९/१५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.034.m4a", "display_order": 35}, {"id": 6000190035, "chapter_id": 10190, "verse_number": "९-१५-३२", "content_sanskrit": "राजपुत्र्याऽर्थितोऽपत्ये धर्मं चावेक्ष्य धर्मवित्।\nस्मरञ्छुक्रवचः काले दिष्टमेवाभ्यपद्यत॥ ९/१५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.035.m4a", "display_order": 36}, {"id": 6000190036, "chapter_id": 10190, "verse_number": "९-१५-३३", "content_sanskrit": "यदुं च तुर्वसुं चैव देवयानी व्यजायत।\nद्रुह्युं चानुं च पूरुं च शर्मिष्ठा वार्षपर्वणी॥ ९/१५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.036.m4a", "display_order": 37}, {"id": 6000190037, "chapter_id": 10190, "verse_number": "९-१५-३४", "content_sanskrit": "गर्भसम्भवमासुर्या भर्तुर्विज्ञाय भामिनी।\nदेवयानी पितुर्गेहं ययौ क्रोधविमूर्च्छिता॥ ९/१५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.037.m4a", "display_order": 38}, {"id": 6000190038, "chapter_id": 10190, "verse_number": "९-१५-३५", "content_sanskrit": "प्रियामनुगतः कामी वचोभिरभिमन्त्रयन्।\nन प्रसादयितुं शेके पादसंवाहनादिभिः॥ ९/१५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.038.m4a", "display_order": 39}, {"id": 6000190039, "chapter_id": 10190, "verse_number": "९-१५-३६", "content_sanskrit": "शुक्रस्तमाह कुपितः स्‍त्रीकामानृतपूरुष।\nत्वां जरा विशते मन्द विरूपकरणी नृणाम्॥ ९/१५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.039.m4a", "display_order": 40}, {"id": 6000190040, "chapter_id": 10190, "verse_number": null, "content_sanskrit": "ययातिरुवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.040.m4a", "display_order": 41}, {"id": 6000190041, "chapter_id": 10190, "verse_number": "९-१५-३७", "content_sanskrit": "अतृप्तोऽस्म्यद्य कामानां ब्रह्मन् दुहितरि स्म ते।\nव्यत्यस्यैतां यथाकामं वयसा योऽभिधास्यति॥ ९/१५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.041.m4a", "display_order": 42}, {"id": 6000190042, "chapter_id": 10190, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.042.m4a", "display_order": 43}, {"id": 6000190043, "chapter_id": 10190, "verse_number": "९-१५-३८", "content_sanskrit": "इति लब्धव्यवस्थानः पुत्रं ज्येष्ठमवोचत।\nयदो तात प्रतीच्छेमां जरां देहि निजं वयः॥ ९/१५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.043.m4a", "display_order": 44, "topics": [{"text": "तस्य यदुप्रभृतिपञ्चपुत्रोत्पत्तिः", "range": "३८–४२"}]}, {"id": 6000190044, "chapter_id": 10190, "verse_number": "९-१५-३९", "content_sanskrit": "मातामहकृतां वत्स न तृप्तो विषयेष्वहम्।\nवयसा भवदीयेन रंस्ये कतिपयाः समाः॥ ९/१५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.044.m4a", "display_order": 45}, {"id": 6000190045, "chapter_id": 10190, "verse_number": null, "content_sanskrit": "यदुरुवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.045.m4a", "display_order": 46}, {"id": 6000190046, "chapter_id": 10190, "verse_number": "९-१५-४०", "content_sanskrit": "नोत्सहे जरया स्थातुमन्तरा प्राप्तया तव।\nअविदित्वा सुखं ग्राम्यं वैतृष्ण्यं नैति पूरुषः॥ ९/१५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.046.m4a", "display_order": 47}, {"id": 6000190047, "chapter_id": 10190, "verse_number": "९-१५-४१", "content_sanskrit": "तुर्वसुश्चोदितः पित्रा द्रुह्युश्चानुश्च भारत।\nप्रत्याचख्युरधर्मज्ञा ह्यनित्ये नित्यबुद्धयः॥ ९/१५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.047.m4a", "display_order": 48}, {"id": 6000190048, "chapter_id": 10190, "verse_number": "९-१५-४२", "content_sanskrit": "अपृच्छत् तनयं पूरुं वयसोनं गुणाधिकम्।\nन त्वमग्रजवद् वत्स मां प्रत्याख्यातुमर्हसि॥ ९/१५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.048.m4a", "display_order": 49}, {"id": 6000190049, "chapter_id": 10190, "verse_number": null, "content_sanskrit": "पूरुरुवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.049.m4a", "display_order": 50}, {"id": 6000190050, "chapter_id": 10190, "verse_number": "९-१५-४३", "content_sanskrit": "को नु लोके मनुष्येन्द्र पितुरात्मकृतः पुमान्।\nप्रतिहर्तुं क्षमो यस्य प्रसादाद् विन्दते परम्॥ ९/१५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.050.m4a", "display_order": 51, "topics": [{"text": "पञ्चसु पुत्रेषु कनिष्ठेन पूरुणा ययातेर्जरां गृहीत्वा तस्मै स्वयौवनदानम्", "range": "४३–५१"}]}, {"id": 6000190051, "chapter_id": 10190, "verse_number": "९-१५-४४", "content_sanskrit": "उत्तमश्चिन्तितं कुर्यात् प्रोक्तकारी तु मध्यमः।\nअधमोऽश्रद्धया कुर्यादकर्तोच्चरितं पितुः॥ ९/१५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.051.m4a", "display_order": 52}, {"id": 6000190052, "chapter_id": 10190, "verse_number": "९-१५-४५", "content_sanskrit": "इति प्रमुदितः पूरुः प्रत्यगृह्णाज्जरां पितुः।\nसोऽपि तद्वयसा कामान् यथावज्जुजुषे नृपः॥ ९/१५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.052.m4a", "display_order": 53}, {"id": 6000190053, "chapter_id": 10190, "verse_number": "९-१५-४६", "content_sanskrit": "सप्तद्वीपपतिः सम्यक् पितृवत् पालयन् प्रजाः।\nयथोपजोषं विषयान् जुजोषाऽव्याहतेन्द्रियः॥ ९/१५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.053.m4a", "display_order": 54}, {"id": 6000190054, "chapter_id": 10190, "verse_number": "९-१५-४७", "content_sanskrit": "देवयान्यप्यनुदिनं मनोवाग्देहवस्तुभिः।\nप्रेयसः परमां प्रीतिमुवाह प्रेयसी रहः॥ ९/१५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.054.m4a", "display_order": 55}, {"id": 6000190055, "chapter_id": 10190, "verse_number": "९-१५-४८", "content_sanskrit": "अयजद् यज्ञपुरुषं क्रतुभिर्भूरिदक्षिणैः।\nसर्वदेवमयं देवं सर्ववेदमयं हरिम्॥ ९/१५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.055.m4a", "display_order": 56}, {"id": 6000190056, "chapter_id": 10190, "verse_number": "९-१५-४९", "content_sanskrit": "यस्मिन्निदं विरचितं व्योम्नीव जलदावलिः।\nनानेव भाति नाभाति स्वप्नमायामनोरथः॥ ९/१५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.056.m4a", "display_order": 57}, {"id": 6000190057, "chapter_id": 10190, "verse_number": "९-१५-५०", "content_sanskrit": "तमेव हृदि विन्यस्य वासुदेवं गुहाशयम्।\nनारायणमणीयांसं निराशीरयजत् प्रभुः॥ ९/१५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.057.m4a", "display_order": 58}, {"id": 6000190058, "chapter_id": 10190, "verse_number": "९-१५-५१", "content_sanskrit": "एवं वर्षसहस्राणि मनःषष्ठैर्मनःसुखम्।\nविदधानोऽपि नातृप्यत् सार्वभौमः कदिन्द्रियैः॥ ९/१५/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_015/BhP_09.015.058.m4a", "display_order": 59}, {"id": 6000190059, "chapter_id": 10190, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे पञ्चदशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]