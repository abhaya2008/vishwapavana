[{"id": 2197399, "chapter_id": 5196, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2197400, "chapter_id": 5196, "verse_number": "१", "content_sanskrit": "पुत्रैः कथं महाराज पुरुषस्तारितो भवेत् ।\nयावन्न लब्धवान् पुत्रमफलः पुरुषो नृप\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2197401, "chapter_id": 5196, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2197402, "chapter_id": 5196, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nनारदेन पुरा गीतं मार्कण्डेयाय पृच्छते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2197403, "chapter_id": 5196, "verse_number": "३", "content_sanskrit": "पर्वतं नारदं चैव असितं देवलं च तम् ।\nआरुणेयं च रैभ्यं च एतानत्रागतान् पुरा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2197404, "chapter_id": 5196, "verse_number": "४", "content_sanskrit": "गङ्गायमुनयोर्मध्ये भोगवत्याः समागमे ।\nदृष्ट्वा पूर्वं समासीनान् मार्कण्डेयोऽभ्यगच्छत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2197405, "chapter_id": 5196, "verse_number": "५", "content_sanskrit": "ऋषयस्तु मुनिं दृष्ट्वा समुत्थायोन्मुखाः स्थिताः ।\nअर्चयित्वाऽर्हतो विप्रं किं कुर्म इति चाब्रुवन्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2197406, "chapter_id": 5196, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2197407, "chapter_id": 5196, "verse_number": "६", "content_sanskrit": "अयं समागमः सद्भिर्यत्नेनासादितो मया ।\nअत्र प्राप्स्यामि धर्माणामाचारस्य च निश्चयम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2197408, "chapter_id": 5196, "verse_number": "७", "content_sanskrit": "ऋजुः कृतयुगे धर्मस्तस्मिन् क्षीणे विमुह्यति ।\nयुगेयुगे महर्षिभ्यो धर्ममिच्छामि वेदितुम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2197409, "chapter_id": 5196, "verse_number": "८", "content_sanskrit": "ऋषिभिर्नारदः प्रोक्तो ब्रूहि यत्रास्य संशयः ।\nधर्माधर्मेषु तत्वज्ञ त्वं हि च्छेत्तासि संशयान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2197410, "chapter_id": 5196, "verse_number": "९", "content_sanskrit": "ऋषिभ्योऽनुमतं वाक्यं नियोगान्नारदोऽब्रवीत् ।\nसर्वधर्मार्थतत्त्वज्ञं मार्कण्डेयं ततोऽब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2197411, "chapter_id": 5196, "verse_number": "१०", "content_sanskrit": "दीर्घायो तपसा दीप्त वेदवेदाङ्गतत्ववित् ।\nयत्र ते संशयो ब्रह्मन् समुत्पन्नः स उच्यताम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2197412, "chapter_id": 5196, "verse_number": "११", "content_sanskrit": "धर्मं लोकोपकारं वा यच्चान्यच्छ्रोतुमिच्छसि ।\nतदहं कथयिष्यामि ब्रूहि त्वं सुमहातपः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2197413, "chapter_id": 5196, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2197414, "chapter_id": 5196, "verse_number": "१२", "content_sanskrit": "युगेयुगे व्यतीतेऽस्मिन् धर्मसेतुः प्रणश्यति ।\nकथं धर्मच्छलेनाहं प्राप्नुयामिति मे मतिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2197415, "chapter_id": 5196, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2197416, "chapter_id": 5196, "verse_number": "१३", "content_sanskrit": "आसीद् धर्मः पुरा विप्र चतुष्पादः कृते युगे ।\nततो ह्यधर्मः कालेन प्रसूतः किञ्चिदूनतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2197417, "chapter_id": 5196, "verse_number": "१४", "content_sanskrit": "ततस्त्रेतायुगं नाम प्रवृत्तं धर्मदूषणम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2197418, "chapter_id": 5196, "verse_number": "१५", "content_sanskrit": "तस्मिन् व्यतीते सम्प्राप्तं तृतीयं द्वापरं स्मृतम् ।\nतदा धर्मस्य द्वौ पादावधर्मो नाशयिष्यति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2197419, "chapter_id": 5196, "verse_number": "१६", "content_sanskrit": "द्वापरे तु परिक्षीणे नन्दिके समुपस्थिते ।\nलोकवृत्तं च धर्मं च उच्यमानं निबोध मे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2197420, "chapter_id": 5196, "verse_number": "१७", "content_sanskrit": "चतुर्थं नन्दिकं नाम धर्मः पादावशेषितः ।\nततः प्रभृति जायन्ते क्षीणप्रज्ञायुषो नराः ।\nक्षीणप्राणधना लोके धर्माचारबहिष्कृताः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2197421, "chapter_id": 5196, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2197422, "chapter_id": 5196, "verse_number": "१८", "content_sanskrit": "एवं विलुलिते धर्मे लोके चाधर्मसंयुते ।\nचातुर्वर्ण्यस्य नियतं हव्यं कव्यं न नश्यति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2197423, "chapter_id": 5196, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2197424, "chapter_id": 5196, "verse_number": "१९", "content_sanskrit": "मन्त्रपूतं सदा हव्यं कव्यं चैव न नश्यति ।\nप्रतिगृह्णन्ति तद् देवा दातुर्न्यायात् प्रयच्छतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2197425, "chapter_id": 5196, "verse_number": "२०", "content_sanskrit": "सत्वयुक्तं च दाता च सर्वान् कामानवाप्नुयात् ।\nअवाप्तकामः स्वर्गे च महीयेत यथेप्सितम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2197426, "chapter_id": 5196, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2197427, "chapter_id": 5196, "verse_number": "२१", "content_sanskrit": "चत्वारो ह्यथ ये वर्णा हव्यं कव्यं प्रदास्यति ।\nमन्त्रहीनमपन्यायं तेषां दानं क्व गच्छति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2197428, "chapter_id": 5196, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2197429, "chapter_id": 5196, "verse_number": "२२", "content_sanskrit": "असुरान् गच्छते दत्तं विप्रै रक्षांसि क्षत्रियैः ।\nवैश्यैः प्रेतानि वै दत्तं शूद्रैर्भूतानि गच्छति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2197430, "chapter_id": 5196, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2197431, "chapter_id": 5196, "verse_number": "२३", "content_sanskrit": "अथ वर्णावरे जाताश्चातुर्वण्याय देशिनः ।\nदास्यन्ति हव्यकव्यानि तेषां दत्तं क्व गच्छति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2197432, "chapter_id": 5196, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2197433, "chapter_id": 5196, "verse_number": "२४", "content_sanskrit": "वर्णावराणां भूतानां हव्यकव्यप्रदातृणाम् ।\nनैव देवा न पितरः प्रतिगृह्णन्ति तत् स्वयम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2197434, "chapter_id": 5196, "verse_number": "२५", "content_sanskrit": "यातुधानाः पिशाचाश्च भूता ये चापि नैर्ऋताः ।\nतेषां सा विहिता वृत्तिः पितृदैवतनिर्गता\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2197435, "chapter_id": 5196, "verse_number": "२६", "content_sanskrit": "तेषां सर्वप्रदातॄणां हव्यकव्यं समाहिताः ।\nयत् प्रयच्छन्ति विधिवत् तद् वै भुञ्जन्ति देवताः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2197436, "chapter_id": 5196, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे नारदमार्कण्डेयसंवादे (मन्त्रसंस्कारप्रयोगो नाम) सप्तचत्वारिंशोऽध्यायः ॥४७॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]