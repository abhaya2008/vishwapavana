[{"id": 2128292, "chapter_id": 3750, "verse_number": "", "content_sanskrit": "लोपामुद्राविवाहः। तस्या निबन्धनं धर्मचर्या ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128293, "chapter_id": 3750, "verse_number": "१", "content_sanskrit": "यदा त्वमन्यथागस्त्यो गार्हस्थ्ये तामनिन्दिताम् ।\nतदाऽभिगम्य प्रोवाच वैदर्भं पृथिवीपतिम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128294, "chapter_id": 3750, "verse_number": "२", "content_sanskrit": "राजन्निवेशे बुद्धिर्मे वर्तते पुत्रकारणात् ।\nवरये त्वां महीपाल लोपामुद्रां प्रयच्छ मे \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128295, "chapter_id": 3750, "verse_number": "३", "content_sanskrit": "एवमुक्तः स मुनिना महीपालो विचेतनः ।\nप्रत्याख्यानाय चाशक्तः प्रदातुमपि नेच्छति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128296, "chapter_id": 3750, "verse_number": "४", "content_sanskrit": "ततः स भार्यामभ्येत्य प्रोवाच पृथिवीपतिः ।\nमहर्षिर्वीर्यवानेष क्रुद्धः शापाग्निना दहेत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128297, "chapter_id": 3750, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128298, "chapter_id": 3750, "verse_number": "५", "content_sanskrit": "तं तथा दुःखितं दृष्ट्वा सभार्यं पृथिवीपतिम् ।\nलोपामुद्राऽभिगम्येदं काले वचनमब्रवीत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128299, "chapter_id": 3750, "verse_number": "६", "content_sanskrit": "मत्कृते न महीपाल पीडामभ्येतुमर्हसि ।\nप्रयच्छ मामगस्त्याय त्राह्यात्मानं मया पितः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128300, "chapter_id": 3750, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128301, "chapter_id": 3750, "verse_number": "७", "content_sanskrit": "दुहितुर्वचनाद् राजा सोऽगस्त्याय महात्मने ।\nलोपामुद्रां ततः प्रादाद् विधिपूर्वं विशांपते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128302, "chapter_id": 3750, "verse_number": "८", "content_sanskrit": "प्राप्य भार्यामगस्त्यस्तु लोपामुद्रामभाषत ।\nमहार्हाण्युत्सृजैतानि वासांस्याभरणानि च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128303, "chapter_id": 3750, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128304, "chapter_id": 3750, "verse_number": "९", "content_sanskrit": "ततः सा तानि वासांसि तनूनि च मृदूनि च ।\nसमुत्ससर्ज रम्भोरूः दिव्यान्याभरणानि च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128305, "chapter_id": 3750, "verse_number": "१०", "content_sanskrit": "ततश्चीराणि जग्राह वल्कलान्यजिनानि च ।\nसमानव्रतचर्या च बभूवायतलोचना \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128306, "chapter_id": 3750, "verse_number": "११", "content_sanskrit": "गङ्गाद्वारमुपागम्य भगवान् ऋषिसत्तमः ।\nउग्रमातिष्ठत तपः सह पत्न्याऽनुकूलया\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128307, "chapter_id": 3750, "verse_number": "१२", "content_sanskrit": "सा प्रीत्या बहुमानाच्च पतिं पर्यचरत् तदा ।\nअगस्त्यश्च परां प्रीतिं भार्यायामकरोत् प्रभुः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128308, "chapter_id": 3750, "verse_number": "१३", "content_sanskrit": "ततो बहुतिथे काले लोपामुद्रां विशांपते ।\nतपसा द्योतितां स्नातां ददर्श भगवान् ऋषिः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128309, "chapter_id": 3750, "verse_number": "१४", "content_sanskrit": "स तस्याः परिचारेण शीलेन च दमेन च ।\nश्रिया रूपेण च प्रीतो मैथुनायाजुहाव ताम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128310, "chapter_id": 3750, "verse_number": "१५", "content_sanskrit": "ततः सा प्राञ्जलिर्भूत्वा लज्जमानेव भामिनी ।\nतदा सप्रणयं वाक्यं भगवन्तमथाब्रवीत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128311, "chapter_id": 3750, "verse_number": "१६", "content_sanskrit": "असंशयं प्रजाहेतोर्भार्यां पतिरविन्दत ।\nया तु त्वयि मम प्रीतिः तामृषे कर्तुमर्हसि \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128312, "chapter_id": 3750, "verse_number": "१७", "content_sanskrit": "यथा पितुर्गृहे विप्र प्रासादे शयनं मम ।\nतथाविधे त्वं शयने मामुपैतुमिहार्हसि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128313, "chapter_id": 3750, "verse_number": "१८", "content_sanskrit": "इच्छामि त्वां स्रग्विणं च भूषणैश्च विभूषितम् ।\nउपसर्तुं यथाकामं दिव्याभरणभूषिता\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128314, "chapter_id": 3750, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128315, "chapter_id": 3750, "verse_number": "१९", "content_sanskrit": "न वै धनानि विद्यन्ते लोपामुद्रे तथा मम ।\nयथाविधानि कल्याणि पितुस्तव सुमध्यमे \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128316, "chapter_id": 3750, "verse_number": "", "content_sanskrit": "लोपामुद्रा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128317, "chapter_id": 3750, "verse_number": "२०", "content_sanskrit": "ईशोऽसि तपसा सर्वं समाहर्तुं ममेप्सितम् ।\nक्षणेन जीवलोके यद् वसु किञ्चन विद्यते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128318, "chapter_id": 3750, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128319, "chapter_id": 3750, "verse_number": "२१", "content_sanskrit": "एवमेतद् यथाऽऽत्थ त्वं तपोव्ययकरं तु मे ।\nयथा तु मे न प्रणश्येत् तपस्तदुपधारय\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128320, "chapter_id": 3750, "verse_number": "", "content_sanskrit": "लोपामुद्रा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2128321, "chapter_id": 3750, "verse_number": "२२", "content_sanskrit": "अल्पावशिष्टः कालोऽयम् ऋतौ मम तपोधन ।\nन चान्यथाऽहमिच्छेयं त्वामुपैतुं कथञ्चन \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2128322, "chapter_id": 3750, "verse_number": "२३", "content_sanskrit": "न चापि धर्ममिच्छामि विलोप्तुं ते तपोधन ।\nएवं तु मे यथाकामं सम्पादयितुमर्हसि \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2128323, "chapter_id": 3750, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2128324, "chapter_id": 3750, "verse_number": "२४", "content_sanskrit": "यद्येष कामः सुभगे तव बुद्ध्या विनिश्चितः ।\nहन्त गच्छाम्यहं भद्रे चर धर्ममिह स्थिता\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2128325, "chapter_id": 3750, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि द्विनवतितमोऽध्यायः ॥९२॥ तीर्थयात्रापर्वणि अष्टचत्वारिंशोऽध्यायः ॥४८॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]