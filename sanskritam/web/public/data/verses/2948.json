[{"id": 2091563, "chapter_id": 2948, "verse_number": "१३-७८-१", "content_sanskrit": "भीष्म उवाच।\nतमागतमभिप्रेक्ष्य शिष्यं वाक्यमथाब्रवीत्।\nदेवशर्मा महातेजा यत्तच्छृणु जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091564, "chapter_id": 2948, "verse_number": "१३-७८-२x", "content_sanskrit": "देवशर्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091565, "chapter_id": 2948, "verse_number": "१३-७८-२", "content_sanskrit": "किं त्वया मिथुनं दृष्टं तस्मिञ्शिष्य महावने।\nते त्वां जानन्ति निपुणा आत्मा च रुचिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091566, "chapter_id": 2948, "verse_number": "१३-७८-३x", "content_sanskrit": "विपुल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091567, "chapter_id": 2948, "verse_number": "१३-७८-३", "content_sanskrit": "ब्रह्मर्षे मिथुनं किन्तत्के च षट्पुरुषा विभो।\nये मां जानन्ति तत्त्वेन यन्मां त्वं परिपृच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091568, "chapter_id": 2948, "verse_number": "१३-७८-४x", "content_sanskrit": "देवशर्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091569, "chapter_id": 2948, "verse_number": "१३-७८-४", "content_sanskrit": "यद्वै तन्मिथुनं ब्रह्मिन्नहोरात्रं हि विद्धि तत्।\nचक्रवत्परिवर्तेत तत्ते जानाति दुष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091570, "chapter_id": 2948, "verse_number": "१३-७८-५", "content_sanskrit": "ये च ते पुरुषा विप्र अक्षैर्दीव्यन्ति हृष्टवत्।\nऋतूंस्तानभिजानीहि ते ते जानन्ति दुष्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091571, "chapter_id": 2948, "verse_number": "१३-७८-६", "content_sanskrit": "न मां कश्चिद्विजानीत इति कृत्वा न विश्वसेत्।\nनरो रहसि पापात्मा पापकं कर्म वै द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091572, "chapter_id": 2948, "verse_number": "१३-७८-७", "content_sanskrit": "कुर्वाणं हि नरं कर्म पापं रहसि सर्वदा।\nपश्यन्ति ऋतवश्चापि तथा दिननिशेऽप्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091573, "chapter_id": 2948, "verse_number": "१३-७८-८", "content_sanskrit": "तथैव हि भवेयुस्ते लोकाः पापकृतो यथा।\nकृत्वाऽनाचक्षतः कर्म मम तच्च यथा कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091574, "chapter_id": 2948, "verse_number": "१३-७८-९", "content_sanskrit": "ते त्वां हर्षस्मितं दृष्ट्वा गुरोः कर्मानिवेदकम्।\nस्मारयन्तस्तथा प्राहुस्ते यथा श्रउतवान्भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091575, "chapter_id": 2948, "verse_number": "१३-७८-१०", "content_sanskrit": "अहोरात्रं विजानाति ऋतवश्चापि नित्यशः।\nपुरुषे पापकं कर्म शुभं वाऽशुभकर्मिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091576, "chapter_id": 2948, "verse_number": "१३-७८-११", "content_sanskrit": "तत्त्वया मम यत्कर्म व्यभिचाराद्भयात्मकम्।\nनाख्यातमिति जानन्तस्ते त्वामाहुस्तथा द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091577, "chapter_id": 2948, "verse_number": "१३-७८-१२", "content_sanskrit": "तेनैव हि भवेयुस्ते लोकाः पापकृतो यथा।\nकृत्वा नाचक्षतः कर्म मम यच्च त्वया कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091578, "chapter_id": 2948, "verse_number": "१३-७८-१३", "content_sanskrit": "तथाऽशक्याश्च दुर्वृत्ता रक्षितुं प्रमदा द्विज।\nन च त्वं कृतवान्किंचिदागः प्रीतोस्मि तेन ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091579, "chapter_id": 2948, "verse_number": "१३-७८-१४", "content_sanskrit": "`मनोदोषविहीनानां न दोषः स्यात्तथा तव।\nअन्यथाऽऽलिङ्ग्यते कान्ता स्नेहेन दुहिताऽन्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091580, "chapter_id": 2948, "verse_number": "१३-७८-१५", "content_sanskrit": "यतेश्च कामुकानां च योषिद्रूपेऽन्यथा मतिः।\nअशिक्षयैव मनसः प्रायो लोकस्तु वञ्च्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091581, "chapter_id": 2948, "verse_number": "१३-७८-१६", "content_sanskrit": "लालेत्युद्विजते लोको वक्त्रासव इति स्पहा।\nअबन्धायोग्यमनसामिति मन्त्रात्मदैवकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091582, "chapter_id": 2948, "verse_number": "१३-७८-१७", "content_sanskrit": "न रागस्नेहलोभान्धं कर्मिणां तन्महाफलम्।\nनिष्कषायो विशुद्धस्त्वं रुच्यावेशान्न दूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091583, "chapter_id": 2948, "verse_number": "१३-७८-१८", "content_sanskrit": "यदि त्वहं त्वां दुर्वृत्तमद्राक्षं द्विजसत्तम।\nशपेयं त्वामहं क्रोधान्न मेऽत्रास्ति विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091584, "chapter_id": 2948, "verse_number": "१३-७८-१९", "content_sanskrit": "सञ्जन्ति पुरुषे नार्यः पुंसां सोऽर्थश्च पुष्कलः।\nअन्यथा रक्षतः शापोऽभविष्यत्ते मतिश्च मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091585, "chapter_id": 2948, "verse_number": "१३-७८-२०", "content_sanskrit": "रक्षिता च त्वया पुत्र मम चापि निवेदिता।\nअहं ते प्रीतिमांस्तात स्वस्थः स्वर्गं गमिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091586, "chapter_id": 2948, "verse_number": "१३-७८-२१", "content_sanskrit": "इत्युक्त्वा विपुलं प्रीतो देवशर्मा महानृषिः।\nमुमोद स्वर्गमास्थाय सहभार्यः सशिष्यकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091587, "chapter_id": 2948, "verse_number": "१३-७८-२२", "content_sanskrit": "इदमाख्यातवांश्चापि ममाख्यानं महामुनिः।\nमार्कण्डेयः पुरा राजन्गङ्गाकूले कथान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091588, "chapter_id": 2948, "verse_number": "१३-७८-२३", "content_sanskrit": "तस्माद्ब्रवीमि पार्थ त्वां स्त्रियो रक्ष्याः सदैव च।\nउभयं दृश्यते तासु सततं साध्वसाधु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091589, "chapter_id": 2948, "verse_number": "१३-७८-२४", "content_sanskrit": "स्त्रियः साध्व्यो महाभागाः सम्मता लोकमातरः।\nधारयन्ति महीं राजन्निमां सवनकाननाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091590, "chapter_id": 2948, "verse_number": "१३-७८-२५", "content_sanskrit": "असाध्व्यश्चापि दुर्वृत्ताः कुलघ्नाः पापनिश्चयाः।\nविज्ञेया लक्षणैर्दुष्टैः स्वगात्रसहजैर्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091591, "chapter_id": 2948, "verse_number": "१३-७८-२६", "content_sanskrit": "एवमेतासु रक्षा वै शक्या कर्तुं महात्मभिः।\nअन्यथा राजशार्दूल न शक्या रक्षितुं स्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2091592, "chapter_id": 2948, "verse_number": "१३-७८-२७", "content_sanskrit": "एता हि मनुजव्याघ्र तीक्ष्णास्तीक्ष्णपराक्रमाः।\nनासामस्ति प्रियो नाम मैथुने सङ्गमेति यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2091593, "chapter_id": 2948, "verse_number": "१३-७८-२८", "content_sanskrit": "एताः कृत्याश्च कष्टाश्च कृतघ्ना भरतर्षभ।\nन चैकस्मिन्नमन्त्येताः पुरुषे पाण्डुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2091594, "chapter_id": 2948, "verse_number": "१३-७८-२९", "content_sanskrit": "नासु स्नेहो नरैः कार्यस्तथैवेर्ष्या जनेश्वर।\nखेदमास्थाय भुञ्जीत धर्ममास्थाय चैव ह।\n`अनृताविह पर्वादिदोषवर्जं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2091595, "chapter_id": 2948, "verse_number": "१३-७८-३०", "content_sanskrit": "विहन्येतान्यथा कुर्वन्नरः कौरवनन्दन।\nसर्वथा राजशार्दूल युक्तः सर्वत्र युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2091596, "chapter_id": 2948, "verse_number": "१३-७८-३१", "content_sanskrit": "तेनैकेन तु रक्षा वै विपुलेन कृता स्त्रियाः।\nनान्यः शक्तस्त्रिलोकेऽस्मिन्रक्षितुं नृप योषितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2091597, "chapter_id": 2948, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टसप्ततितमोऽध्यायः॥१३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]