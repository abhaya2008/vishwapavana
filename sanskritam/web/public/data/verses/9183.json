[{"id": 5000183000, "chapter_id": 9183, "verse_number": "२-१०६-१", "content_sanskrit": "एवमुक्त्वा तु विरते रामे वचनमर्थवत् ।\nततो मन्दाकिनीतीरे रामं प्रकृतिवत्सलम् ।\nउवाच भरतश्चित्रं धार्मिको धार्मिकं वच: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000183001, "chapter_id": 9183, "verse_number": "२-१०६-२", "content_sanskrit": "को हि स्यादीदृशो लोके यादृशस्त्वमरिन्दम ।\nन त्वां प्रव्यथयेद्दु:खं प्रीतिर्वा न प्रहर्षयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000183002, "chapter_id": 9183, "verse_number": "२-१०६-३", "content_sanskrit": "सम्मतश्चासि वृद्धानां तांश्च पृच्छसि संशयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000183003, "chapter_id": 9183, "verse_number": "२-१०६-४", "content_sanskrit": "यथा मृतस्तथा जीवन् यथा ऽसति तथा सति ।\nयस्यैष बुद्धिलाभ: स्यात्परितप्येत केन स: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000183004, "chapter_id": 9183, "verse_number": "२-१०६-५", "content_sanskrit": "परावरज्ञो यश्च स्यात्तथा त्वं मनुजाधिप ।\nस एवं व्यसनं प्राप्य न विषीदितुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000183005, "chapter_id": 9183, "verse_number": "२-१०६-६", "content_sanskrit": "अमरोपम सत्त्वस्त्वं महात्मा सत्यसङ्गर: ।\nसर्वज्ञ: सर्वदर्शी च बुद्धिमांश्चासि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000183006, "chapter_id": 9183, "verse_number": "२-१०६-७", "content_sanskrit": "न त्वामेवङ्गुणैर्युक्तं प्रभवाभवकोविदम् ।\nअविषह्यतमं दु:खमासादयितुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000183007, "chapter_id": 9183, "verse_number": "२-१०६-८", "content_sanskrit": "प्रोषिते मयि यत्पापं मात्रा मत्कारणात्कृतम् ।\nक्षुद्रया तदनिष्टं मे प्रसीदतु भवान्मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000183008, "chapter_id": 9183, "verse_number": "२-१०६-९", "content_sanskrit": "धर्मबन्धेन बद्धो ऽस्मि तेनेमां नेह मातरम् ।\nहन्मि तीव्रेण दण्डेन दण्डार्हां पापकारिणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000183009, "chapter_id": 9183, "verse_number": "२-१०६-१०", "content_sanskrit": "कथं दशरथाज्जात: शुद्धाभिजनकर्मण: ।\nजानन् धर्ममधर्मिष्ठं कुर्य्यां कर्म जुगुप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000183010, "chapter_id": 9183, "verse_number": "२-१०६-११", "content_sanskrit": "गुरु: क्रियावान् वृद्धश्च राजा प्रेत: पितेति च ।\nतातं न परिगर्हेयं दैवतं चेति संसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000183011, "chapter_id": 9183, "verse_number": "२-१०६-१२", "content_sanskrit": "को हि धर्मार्थयोर्हीनमीदृशं कर्म किल्बिषम् ।\nस्त्रिया: प्रियं चिकीर्षु: सन् कुर्याद्धर्मज्ञ धर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000183012, "chapter_id": 9183, "verse_number": "२-१०६-१३", "content_sanskrit": "अन्तकाले हि भूतानि मुह्यन्तीति पुराश्रुति: ।\nराज्ञैवं कुर्वता लोके प्रत्यक्षं सा श्रुति: कृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000183013, "chapter_id": 9183, "verse_number": "२-१०६-१४", "content_sanskrit": "साध्वर्थमभिसन्धाय ऺक्रोधान्मोहाच्च साहसात् ।\nतातस्य यदतिक्रान्तं प्रत्याहरतु तद्भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000183014, "chapter_id": 9183, "verse_number": "२-१०६-१५", "content_sanskrit": "पितुरपतनहेतुत्वात्तदेवापत्यत्वेन सम्मतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000183015, "chapter_id": 9183, "verse_number": "२-१०६-१६", "content_sanskrit": "तदपत्यं भवानस्तु मा भवान् दुष्कृतं पितु: ।\nअभिपत्ता कृतं कर्म लोके धीरविगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000183016, "chapter_id": 9183, "verse_number": "२-१०६-१७", "content_sanskrit": "कैकेयीं मां च तातं च सुहृदो बान्धवांश्च न: ।\nपौरजानपदान् सर्वांस्त्रातु सर्वमिदं भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000183017, "chapter_id": 9183, "verse_number": "२-१०६-१८", "content_sanskrit": "क्व चारण्यं क्व च क्षात्ऺत्र क्व जटा: क्व च पालनम् ।\nईदृशं व्याहतं कर्म न भवान् कर्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000183018, "chapter_id": 9183, "verse_number": "२-१०६-१९", "content_sanskrit": "एष हि प्रथमो धर्म: क्षत्ऺित्रयस्याभिषेचनम् ।\nयेन शक्यं महाप्राज्ञ प्रजानां परिपालनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000183019, "chapter_id": 9183, "verse_number": "२-१०६-२०", "content_sanskrit": "कश्च प्रत्यक्षमुत्सृज्य संशयस्थमलक्षणम् ।\nआयतिस्थं चरेद्धर्मं क्षत्ऺत्रबन्धुरनिश्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000183020, "chapter_id": 9183, "verse_number": "२-१०६-२१", "content_sanskrit": "अथ क्लेशजमेव त्वं धर्मं चरितुमिच्छसि ।\nधर्मेण चतुरो वर्णान् पालयन् क्लेशमाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000183021, "chapter_id": 9183, "verse_number": "२-१०६-२२", "content_sanskrit": "चतुर्णामाश्रमाणां हि गार्हस्थ्यं श्रेष्ठमाश्रमम् ।\nप्राहुर्धर्मज्ञ धर्मज्ञास्तं कथं त्यक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000183022, "chapter_id": 9183, "verse_number": "२-१०६-२३", "content_sanskrit": "श्रुतेन बाल: स्थानेन जन्मना भवतो ह्यहम् ।\nस कथं पालयिष्यामि भूमिं भवति तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000183023, "chapter_id": 9183, "verse_number": "२-१०६-२४", "content_sanskrit": "हीनबुद्धिगुणो बालो हीन: स्थानेन चाप्यहम् ।\nभवता च विनाभूतो न वर्त्तयितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000183024, "chapter_id": 9183, "verse_number": "२-१०६-२५", "content_sanskrit": "इदं निखिलमव्यग्रं राज्यं पित्र्यमकण्टकम् ।\nअनुशाधि स्वधर्मेण धर्मज्ञ सह बान्धवै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000183025, "chapter_id": 9183, "verse_number": "२-१०६-२६", "content_sanskrit": "इहैव त्वा ऽभिषिञ्चन्तु सर्वा: प्रकृतय: सह ।\nऋत्विज: सवसिष्ठाश्च मन्त्रवन्मन्त्रकोविदा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000183026, "chapter_id": 9183, "verse_number": "२-१०६-२७", "content_sanskrit": "अभिषिक्तस्त्वमस्माभिरयोध्यां पालने व्रज ।\nविजित्य तरसा लोकान् मरुद्भिरिव वासव: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000183027, "chapter_id": 9183, "verse_number": "२-१०६-२८", "content_sanskrit": "ऋणानि त्रीण्यपाकुर्वन् दुर्हृद: साधु निर्द्दहन् ।\nसुहृदस्तर्पयन् कामैस्त्वमेवात्रानुशाधि माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000183028, "chapter_id": 9183, "verse_number": "२-१०६-२९", "content_sanskrit": "अद्यार्य मुदिता: सन्तु सुहृदस्ते ऽभिषेचने ।\nअद्य भीता: पलायन्तां दुर्हृदस्ते दिशो दश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000183029, "chapter_id": 9183, "verse_number": "२-१०६-३०", "content_sanskrit": "आक्रोशं मम मातुश्च प्रमृज्य पुरुषर्षभ ।\nअद्य तत्रभवन्तं च पितरं रक्ष किल्बिषात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000183030, "chapter_id": 9183, "verse_number": "२-१०६-३१", "content_sanskrit": "शिरसा त्वा ऽभियाचे ऽहं कुरुष्व करुणां मयि ।\nबान्धवेषु च सर्वेषु भूतेष्विव महेश्वर: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000183031, "chapter_id": 9183, "verse_number": "२-१०६-३२", "content_sanskrit": "अथैतत् पृष्ठत: कृत्वा वनमेव भवानित: ।\nगमिष्यति गमिष्यामि भवता सार्द्धमप्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000183032, "chapter_id": 9183, "verse_number": "२-१०६-३३", "content_sanskrit": "तथाहि रामो भरतेन ताम्यता प्रसाद्यमान: शिरसा महीपति: ।\nन चैव चक्रे गमनाय सत्त्ववान् मतिं पितुस्तद्वचने व्यवस्थित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000183033, "chapter_id": 9183, "verse_number": "२-१०६-३४", "content_sanskrit": "तदद्भुतं स्थैर्यमवेक्ष्य राघवे समं जनो हर्षमवाप दु:खित: ।\nन यात्ययोध्यामिति दु:खितो ऽभवत् स्थिरप्रतिज्ञत्वमवेक्ष्य हर्षित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000183034, "chapter_id": 9183, "verse_number": "२-१०६-३५", "content_sanskrit": "तमृत्विजो नैगमयूथवल्लभास्तदा विंसज्ञाश्रुकलाश्च मातर: ।\nतथा ब्रुवाणं भरतं प्रतुष्टुवु: प्रणम्य रामं च ययाचिरे सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000183035, "chapter_id": 9183, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे षडुत्तरशततम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]