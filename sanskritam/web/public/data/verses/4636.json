[{"id": 2170169, "chapter_id": 4636, "verse_number": "", "content_sanskrit": "कर्णधृष्टद्युम्नयोर्युद्धम् । सात्यकिकर्णयोर्युद्धम् । अश्वत्थाम्ना\nधृष्टद्युम्नस्य वधायोद्यते अर्जुनात् तस्य रक्षणम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2170170, "chapter_id": 4636, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2170171, "chapter_id": 4636, "verse_number": "१", "content_sanskrit": "ततः पुनः समाजग्मुरभीताः कुरुसृञ्जयाः ।\nधृष्टद्युम्नमुखाः पार्था वैकर्तनमुखा वयम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2170172, "chapter_id": 4636, "verse_number": "२", "content_sanskrit": "ततः प्रववृते भीमः सङ्ग्रामो लोमहर्षणः ।\nकर्णस्य पाण्डवानां च यमराष्ट्रविवर्धनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2170173, "chapter_id": 4636, "verse_number": "३", "content_sanskrit": "तस्मिन् प्रवृत्ते सङ्ग्रामे तुमुले शोणितोदके ।\nसंशप्तकेषु शूरेषु किञ्चिच्छिष्टेषु भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2170174, "chapter_id": 4636, "verse_number": "४", "content_sanskrit": "धृष्टद्युम्नो महाराज सहितः सर्वराजभिः ।\nकर्णमेवाभिदुद्राव पाण्डवाश्च महारथाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2170175, "chapter_id": 4636, "verse_number": "५", "content_sanskrit": "आगच्छमानांस्तान् सङ्खे प्रहृष्टान् विजयैषिणः ।\nदधारैको रणे क्रुद्धो जलौघानिव पर्वतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2170176, "chapter_id": 4636, "verse_number": "६", "content_sanskrit": "तमासाद्य तु ते कर्णं व्यशीर्यन्त महारथाः ।\nयथाचलं समासाद्य जलौघाः सर्वतोदिशम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2170177, "chapter_id": 4636, "verse_number": "७", "content_sanskrit": "तयोरासीन्महाराज सङ्ग्रामो लोमहर्षणः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2170178, "chapter_id": 4636, "verse_number": "८", "content_sanskrit": "धृष्टद्युम्नस्तु राधेयं शरेण नतपर्वणा ।\nताडयामास सङ्क्रुद्धस्तिष्ठ तिष्ठेति चाब्रवीत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2170179, "chapter_id": 4636, "verse_number": "९", "content_sanskrit": "विजयं तु धनुःश्रेष्ठं विधुन्वानो महारथः ।\nपार्षतस्य धनुश्छित्त्वा शरानाशीविषोपमान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2170180, "chapter_id": 4636, "verse_number": "१०", "content_sanskrit": "ताडयामास सङ्क्रुद्धः पार्षतं नवभिः शरैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2170181, "chapter_id": 4636, "verse_number": "११", "content_sanskrit": "ते वर्म हेमविकृतं भित्त्वा तस्य महात्मनः ।\nशोणिताक्ता व्यराजन्त शक्रगोपा इवानघ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2170182, "chapter_id": 4636, "verse_number": "१२", "content_sanskrit": "तदपास्य धनुश्छिन्नं धृष्टद्युम्नो महारथः ।\nअन्यद्धनुरुपादाय शरांश्चाशीविषोपमान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2170183, "chapter_id": 4636, "verse_number": "१३", "content_sanskrit": "कर्णं विव्याध सप्तत्या शरैः सन्नतपर्वभिः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2170184, "chapter_id": 4636, "verse_number": "१४", "content_sanskrit": "तथैव राजन् कर्णोऽपि पार्षतं शत्रुतापनम् ।\nछादयामास समरे शरैराशीविषोपमैः ।\nद्रोणशत्रुं महेष्वासो विव्याध नवभिः शरैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2170185, "chapter_id": 4636, "verse_number": "१५", "content_sanskrit": "तस्य कर्णो महाराज शरं कनकभूषणम् ।\nप्रेषयामास सङ्क्रुद्धो मृत्युदण्डमिवापरम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2170186, "chapter_id": 4636, "verse_number": "१६", "content_sanskrit": "तमापतन्तं सहसा घोररूपं विशाम्पते ।\nचिच्छेद सप्तधा राजन् शैनेयः कृतहस्तवत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2170187, "chapter_id": 4636, "verse_number": "१७", "content_sanskrit": "दृष्ट्वा विनिहतं बाणं शरैः कर्णो विशाम्पते ।\nसात्यकिं शरवर्षेण समन्तात्पर्यवारयत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2170188, "chapter_id": 4636, "verse_number": "१८", "content_sanskrit": "विव्याध चैनं समरे नाराचैस्तत्र सप्तभिः ।\nतं प्रत्यविध्यच्छैनेयः शरैर्हेमविभूषितैः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2170189, "chapter_id": 4636, "verse_number": "१९", "content_sanskrit": "ततो युद्धमतीवासीच्चक्षुःश्रोत्रभयावहम् ।\nआसीद् घोरं च चित्रं च प्रेक्षणीयं समन्ततः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2170190, "chapter_id": 4636, "verse_number": "२०", "content_sanskrit": "सर्वेषां तत्र भूतानां लोमहर्षो व्यजायत ।\nतद् दृष्ट्वा समरे कर्म कर्णशैनेययोर्नृप\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2170191, "chapter_id": 4636, "verse_number": "२१", "content_sanskrit": "एतस्मिन्नन्तरे द्रौणिरभ्ययात् सुमहाबलम् ।\nपार्षतं शत्रुदमनं शत्रुवीर्यासुनाशनम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2170192, "chapter_id": 4636, "verse_number": "२२", "content_sanskrit": "अभ्यभाषत सङ्क्रुद्धो द्रौणिः परपुरञ्जयः ।\nतिष्ठ तिष्ठाद्य ब्रह्मघ्न न मे जीवन् विमोक्ष्यसे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2170193, "chapter_id": 4636, "verse_number": "२३", "content_sanskrit": "इत्युक्त्वा सुभृशं वीरः शीघ्रकृन्निशितैः शरैः ।\nपार्षतं छादयामास घोररूपैः सुतेजनैः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2170194, "chapter_id": 4636, "verse_number": "२४", "content_sanskrit": "यतमानं परं शक्त्या यतमानो महारथः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2170195, "chapter_id": 4636, "verse_number": "२५", "content_sanskrit": "यथा हि समरे द्रौणिः पार्षतं वीक्ष्य मारिष ।\nतथा द्रौणिं रणे दृष्ट्वा पार्षतः परवीरहा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2170196, "chapter_id": 4636, "verse_number": "२६", "content_sanskrit": "नातिहृष्टमना भूत्वा मन्यते मृत्युमात्मनः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2170197, "chapter_id": 4636, "verse_number": "२७", "content_sanskrit": "स ज्ञात्वा समरेऽऽत्मानं शस्त्रेणावध्यमेव तु ।\nजवेनाभिययौ द्रौणिं कालः कालमिव क्षये\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2170198, "chapter_id": 4636, "verse_number": "२८", "content_sanskrit": "द्रौणिस्तु दृष्ट्वा राजेन्द्र धृष्टद्युम्नं रथे स्थितम् ।\nक्रोधेन निःश्वसन् वीरः पार्षतं समुपाद्रवत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2170199, "chapter_id": 4636, "verse_number": "२९", "content_sanskrit": "तावन्योन्यं तु दृष्ट्वैव संरम्भं जग्मतुः परम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2170200, "chapter_id": 4636, "verse_number": "३०", "content_sanskrit": "अथाब्रवीन्महाराज द्रोणपुत्रः प्रतापवान् ।\nधृष्टद्युम्नं समीपस्थं त्वरमाणो विशाम्पते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2170201, "chapter_id": 4636, "verse_number": "३१", "content_sanskrit": "पाञ्चालापसदाद्य त्वां प्रेषयिष्यामि मृत्यवे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2170202, "chapter_id": 4636, "verse_number": "३२", "content_sanskrit": "पापं हि यत्त्वया कर्म घ्नता द्रोणं पुरा कृतम् ।\nअद्य त्वा पत्स्यते तद्वै यथा ह्यकुशलं तथा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2170203, "chapter_id": 4636, "verse_number": "३३", "content_sanskrit": "अरक्ष्यमाणः पार्थेन यदि तिष्ठसि संयुगे ।\nनापक्रमसि वा मूढ सत्यमेतद् ब्रवीमि ते\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2170204, "chapter_id": 4636, "verse_number": "३४", "content_sanskrit": "एवमुक्तः प्रत्युवाच धृष्टद्युम्नः प्रतापवान्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2170205, "chapter_id": 4636, "verse_number": "", "content_sanskrit": "धृष्टद्युम्नः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2170206, "chapter_id": 4636, "verse_number": "३५", "content_sanskrit": "प्रतिवाक्यं स एवासिर्मामको दास्यते तव ।\nयेनैव ते पितुर्दत्तं यतमानस्य संयुगे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2170207, "chapter_id": 4636, "verse_number": "३६", "content_sanskrit": "यदि तावन्मया द्रोणो निहतो ब्राह्मणब्रुवः ।\nत्वामिदानीं कथं युद्धे न हनिष्यामि विक्रमात्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2170208, "chapter_id": 4636, "verse_number": "३७", "content_sanskrit": "एवमुक्त्वा महाराज सेनापतिरमर्षणः ।\nनिशितेनाथ बाणेन द्रौणिं विव्याध पार्षतः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2170209, "chapter_id": 4636, "verse_number": "३८", "content_sanskrit": "ततो द्रौणिः सुसङ्क्रुद्धः शरैः सन्नतपर्वभिः ।\nप्राच्छादयद् दिशो राजन् धृष्टद्युम्नस्य संयुगे\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2170210, "chapter_id": 4636, "verse_number": "३९", "content_sanskrit": "नैवान्तरिक्षं न दिशो नैव योधाः समन्ततः ।\nदृश्यन्ते वै महाराज शरैश्छन्नाः सहस्रशः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2170211, "chapter_id": 4636, "verse_number": "४०", "content_sanskrit": "तथैव पार्षतो राजन् द्रौणिमाहवशोभिनम् ।\nशरैः सञ्छादयमास सूतपुत्रस्य पश्यतः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2170212, "chapter_id": 4636, "verse_number": "४१", "content_sanskrit": "राधेयोऽपि महाराज पाञ्चालान् सह पाण्डवैः ।\nद्रौपदेयान् युधामन्युं सात्यकिं च महारथम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2170213, "chapter_id": 4636, "verse_number": "४२", "content_sanskrit": "एकः स वारयामास प्रेक्षणीयः समन्ततः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2170214, "chapter_id": 4636, "verse_number": "४३", "content_sanskrit": "दृष्टद्युम्नोऽपि समरे द्रौणेश्चिच्छेद कार्मुकम् ।\nतदपास्य धनुर्द्रौणिरन्यदादत्त कार्मुकम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2170215, "chapter_id": 4636, "verse_number": "४४", "content_sanskrit": "वेगवत्समरे घोरं शरांश्चाशीविषोपमान्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2170216, "chapter_id": 4636, "verse_number": "४५", "content_sanskrit": "स पार्षतस्य राजेन्द्र धनुः शक्तिं गदां ध्वजम् ।\nहयान् सूतं रथं चैव निमेषाद् व्यधमच्छरैः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2170217, "chapter_id": 4636, "verse_number": "४६", "content_sanskrit": "स छिन्नधन्वा विरथो हताश्वो हतसारथिः ।\nखड्गमादत्त विपुलं शतचन्द्रं च भानुमत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2170218, "chapter_id": 4636, "verse_number": "४७", "content_sanskrit": "द्रौणिस्तदपि राजेन्द्र भल्लैः क्षिप्रं महारथः ।\nचिच्छेद समरे वीरः क्षिप्रहस्तो दृढायुधः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2170219, "chapter_id": 4636, "verse_number": "४८", "content_sanskrit": "रथादनवरूढस्य तदद्भुतमिवाभवत्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2170220, "chapter_id": 4636, "verse_number": "४९", "content_sanskrit": "धृष्टद्युम्नं तु विरथं हताश्वं छिन्नकार्मुकम् ।\nशरैश्च बहुधा विद्धं मर्मस्वेव सुताडितम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2170221, "chapter_id": 4636, "verse_number": "५०", "content_sanskrit": "नातरद् भरतश्रेष्ठ यतमानो महारथः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2170222, "chapter_id": 4636, "verse_number": "५१", "content_sanskrit": "तस्यान्तमिषुभी राजन् यदा द्रौणिर्न जग्मिवान् ।\nअथ त्यक्त्वा धनुर्वीरः पार्षतं त्वरितोऽभ्यगात्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2170223, "chapter_id": 4636, "verse_number": "५२", "content_sanskrit": "आसीदाद्रवतो राजन् वेगस्तस्य महात्मनः ।\nगरुडस्येव पततो जिघृक्षोः पन्नगोत्तमम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2170224, "chapter_id": 4636, "verse_number": "५३", "content_sanskrit": "एतस्मिन्नेव काले तु माधवोऽर्जुनमब्रवीत् ।\nपश्य पार्थ यथा द्रौणिः पार्षतस्य वधं प्रति\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2170225, "chapter_id": 4636, "verse_number": "५४", "content_sanskrit": "यत्नं करोति विपुलं हन्याच्चैनमसंशयम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2170226, "chapter_id": 4636, "verse_number": "५५", "content_sanskrit": "तं मोचय महाबाहो पार्षतं शत्रुतापनम् ।\nद्रौणेरास्यमनुप्राप्तं मृत्योरास्यगतं यथा\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2170227, "chapter_id": 4636, "verse_number": "५६", "content_sanskrit": "एवमुक्त्वा महाराज वासुदेवः प्रतापवान् ।\nप्रैषयत्तत्र तुरगान् यत्र द्रौणिर्व्यवस्थितः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2170228, "chapter_id": 4636, "verse_number": "५७", "content_sanskrit": "ते हयाश्चन्द्रसङ्काशाः केशवेन प्रचोदिताः ।\nपिबन्त इव तद्व्योम जग्मुर्द्रौणिरथं प्रति\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2170229, "chapter_id": 4636, "verse_number": "५८", "content_sanskrit": "दृष्ट्वाऽऽयान्तौ महावीर्यावुभौ कृष्णधनञ्जयौ ।\nधृष्टद्युम्नवधे राजंश्चक्रे यत्नं महाबलः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2170230, "chapter_id": 4636, "verse_number": "५९", "content_sanskrit": "विकृष्यमाणं दृष्ट्वैव धृष्टद्युम्नं जनेश्वर ।\nशरांश्चिक्षेप वै पार्थो द्रौणिं प्रति महाबलः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2170231, "chapter_id": 4636, "verse_number": "६०", "content_sanskrit": "ते शरा हेमविकृता गाण्डीवप्रेषिता भृशम् ।\nद्रौणिमासाद्य विविशुर्वल्मीकमिव पन्नगाः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2170232, "chapter_id": 4636, "verse_number": "६१", "content_sanskrit": "स विद्धस्तैः शरैर्घोरैर्द्रोणपुत्रः प्रतापवान्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2170233, "chapter_id": 4636, "verse_number": "६२", "content_sanskrit": "उत्सृज्य समरे राजन् पाञ्चाल्यममितौजसम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2170234, "chapter_id": 4636, "verse_number": "६३", "content_sanskrit": "रथमारुरुहे वीरो धनञ्जयशरार्दितः ।\nप्रगृह्य च धनुः श्रेष्ठं पार्थं विव्याध सायकैः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2170235, "chapter_id": 4636, "verse_number": "६४", "content_sanskrit": "एतस्मिन्नन्तरे वीरः सहदेवो जनाधिप ।\nअपोवाह रथेनाजौ पार्षतं शत्रुतापनम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2170236, "chapter_id": 4636, "verse_number": "६५", "content_sanskrit": "अर्जुनोऽपि महाराज द्रौणिं विव्याध पत्रिभिः ।\nतं द्रोणपुत्रः सङ्क्रुद्धो बाह्वोरुरसि चार्दयत्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2170237, "chapter_id": 4636, "verse_number": "६६", "content_sanskrit": "क्रोधितस्तु रणे पार्थो नाराचं कालसम्मितम् ।\nद्रोणपुत्राय चिक्षेप कालदण्डमिवापरम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2170238, "chapter_id": 4636, "verse_number": "६७", "content_sanskrit": "स ब्राह्मणस्यांसदेशे निपपात महाद्युतिः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2170239, "chapter_id": 4636, "verse_number": "६८", "content_sanskrit": "स विह्वलो महाराज शरवेगेन संयुगे ।\nनिषसाद रथोपस्थे वैक्लव्यं च परं ययौ\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2170240, "chapter_id": 4636, "verse_number": "६९", "content_sanskrit": "ततः कर्णो महाराज व्याक्षिपद् विजयं धनुः ।\nअर्जुनं समरे क्रुद्धः प्रेक्षमाणो मुहुर्मुहुः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2170241, "chapter_id": 4636, "verse_number": "७०", "content_sanskrit": "द्वैरथं चापि पार्थेन कामयानो महारणे\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2170242, "chapter_id": 4636, "verse_number": "७१", "content_sanskrit": "विह्वलं तं तु वीक्ष्याथ द्रोणपुत्रं च सारथिः ।\nअपोवाह रथेनाजौ त्वरमाणो रणाजिरात्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2170243, "chapter_id": 4636, "verse_number": "७२", "content_sanskrit": "अथोत्क्रुष्टं महाराज पाञ्चालैर्जितकाशिभिः ।\nमोक्षितं पार्षतं दृष्ट्वा द्रोणपुत्रं च पीडितम्\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2170244, "chapter_id": 4636, "verse_number": "७३", "content_sanskrit": "वादित्राणि च दिव्यानि प्रावाद्यन्त सहस्रशः ।\nसिंहनादश्च सञ्जज्ञे दृष्ट्वा घोरं महाद्भुतम्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2170245, "chapter_id": 4636, "verse_number": "७४", "content_sanskrit": "एवं कृत्वाब्रवीत् पार्थो वासुदेवं धनञ्जयः ।\nयाहि संशप्तकान् कृष्ण कार्यमेतत्परं मम\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2170246, "chapter_id": 4636, "verse_number": "७५", "content_sanskrit": "ततः प्रयातो दाशार्हः श्रुत्वा पाण्डवभाषितम् ।\nरथेनातिपताकेन मनोमारुतरंहसा\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2170247, "chapter_id": 4636, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nधृष्टद्युम्नपराजयो नाम षट्पञ्चाशोऽध्यायः ॥५६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]