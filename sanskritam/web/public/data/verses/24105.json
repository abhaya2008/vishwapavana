[{"id": 7004105000, "chapter_id": 24105, "verse_number": "४-५४-१", "content_sanskrit": "स्कंद उवाच ।\nकुंभसंभव वक्ष्यामि शृणोत्ववहितो भवान् ।\nकपर्दीशस्य लिंगस्य महामाहात्म्यमुत्तमम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004105001, "chapter_id": 24105, "verse_number": "४-५४-२", "content_sanskrit": "कपर्दी नाम गणपः शंभोरत्यंतवल्लभः ।\nपित्रीशादुत्तरे भागे लिंगं संस्थाप्य शांभवम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004105002, "chapter_id": 24105, "verse_number": "४-५४-३", "content_sanskrit": "कुंडं चखान तस्याग्रे विमलोदक संज्ञकम् ।\nयस्य तोयस्य संस्पर्शाद्विमलो जायते नरः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004105003, "chapter_id": 24105, "verse_number": "४-५४-४", "content_sanskrit": "इतिहासं प्रवक्ष्यामि तत्र त्रेतायुगे पुरा ।\nयथावृत्तं कुंभयोने श्रवणात्पातकापहम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004105004, "chapter_id": 24105, "verse_number": "४-५४-५", "content_sanskrit": "एकः पाशुपत श्रेष्ठो वाल्मीकिरिति संज्ञितः ।\nतपश्चचार स मुनिः कपर्दीशं समर्चयन् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004105005, "chapter_id": 24105, "verse_number": "४-५४-६", "content_sanskrit": "एकदा स हि हेमंते मार्गे मासि तपोधनः ।\nस्नात्वा तत्र महातीर्थे मध्याह्ने विमलोदके ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004105006, "chapter_id": 24105, "verse_number": "४-५४-७", "content_sanskrit": "चकार भस्मना स्नानमापादतलमस्तकम् ।\nलिंगस्य दक्षिणेभागे कृतमाध्याह्निकक्रियः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004105007, "chapter_id": 24105, "verse_number": "४-५४-८", "content_sanskrit": "न्यस्तमस्तकपांसुश्च संध्यामाध्यात्मिकीं स्मरन् ।\nजपन्पंचाक्षरीं विद्यां ध्यायन्देवं कपर्दिनम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004105008, "chapter_id": 24105, "verse_number": "४-५४-९", "content_sanskrit": "कृत्वा संहारमार्गेण सप्रमाणं प्रदक्षिणाम् ।\nहुडुंकृत्य हुडुंकृत्य हुडुंकृत्य त्रिरुच्चकैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004105009, "chapter_id": 24105, "verse_number": "४-५४-१०", "content_sanskrit": "प्रणवं पुरतः कृत्वा षड्जादिस्वरभेदतः ।\nगीतं विधाय सानंदं सनृत्यं हस्तकान्वितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004105010, "chapter_id": 24105, "verse_number": "४-५४-११", "content_sanskrit": "अंगहारैर्मनोहारि चारी मंडलसंयुतम् ।\nक्षणं तत्र सरस्तीरे उपविष्टो महातपाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004105011, "chapter_id": 24105, "verse_number": "४-५४-१२", "content_sanskrit": "अद्राक्षीद्राक्षसं घोरमतीव विकृताकृतिम् ।\nशुष्कशंखकपोलास्यं निमग्ना पिंगलोचनम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004105012, "chapter_id": 24105, "verse_number": "४-५४-१३", "content_sanskrit": "रूक्षस्फुटितकेशाग्रं महालंब शिरोधरम् ।\nअतीव चिपिट घ्राणं शुष्कौष्ठमतिदंतुरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004105013, "chapter_id": 24105, "verse_number": "४-५४-१४", "content_sanskrit": "महाविशालमौलिं च प्रोर्ध्वीभूतशिरोरुहम् ।\nप्रलंबकर्णपालीकं पिंगलश्मश्रुभीषणम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004105014, "chapter_id": 24105, "verse_number": "४-५४-१५", "content_sanskrit": "प्रलंबित ललज्जिह्वमत्युत्कट कृकाटिकम् ।\nस्थूलास्थि जत्रु संस्थानं दीर्घस्कंधद्वयोत्कटम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004105015, "chapter_id": 24105, "verse_number": "४-५४-१६", "content_sanskrit": "निमग्नकक्षाकुहरं शुष्कह्रस्व भुजद्वयम् ।\nविरलांगुलिहस्ताग्रं नतपीन नखावलिम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004105016, "chapter_id": 24105, "verse_number": "४-५४-१७", "content_sanskrit": "विशुष्क पांसुलोत्क्रोडं पृष्ठलग्नोदरत्वचम् ।\nकटीतटेन विकटं निर्मांसत्रिकबंधनम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004105017, "chapter_id": 24105, "verse_number": "४-५४-१८", "content_sanskrit": "प्रलंब स्फिग्युगयुतं शुष्कमुष्काल्पमेहनम् ।\nदीर्घनिर्मांसलोरूकं स्थूलजान्वस्थिपंजरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004105018, "chapter_id": 24105, "verse_number": "४-५४-१९", "content_sanskrit": "अस्थिचर्मावशेषं च शिराजालितविग्रहम् ।\nशिरालं दीर्घजंघं च स्थूलगुल्फास्थिभीषणम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004105019, "chapter_id": 24105, "verse_number": "४-५४-२०", "content_sanskrit": "अतिविस्तृत पादं च दीर्घवक्रकृशांगुलिम् ।\nअस्थिचर्मावशेषेण शिराताडितविग्रहम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004105020, "chapter_id": 24105, "verse_number": "४-५४-२१", "content_sanskrit": "विकटं भीषणाकारं क्षुत्क्षाममतिलोमशम् ।\nदावदग्धद्रुमाकारमति चंचललोचनम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004105021, "chapter_id": 24105, "verse_number": "४-५४-२२", "content_sanskrit": "मूर्तं भयानकमिव सर्वप्राणिभयप्रदम् ।\nहृदयाकंपनं दृष्ट्वा तं प्रेतं वृद्धतापसः ।\nअतिदीनाननं कस्त्वमिति धैर्येण पृष्टवान् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004105022, "chapter_id": 24105, "verse_number": "४-५४-२३", "content_sanskrit": "कुतस्त्वमिह संप्राप्तः कस्मात्ते गतिरीदृशी ।\nअनुक्रोशधियारक्षः पृच्छामि वद निर्भयम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004105023, "chapter_id": 24105, "verse_number": "४-५४-२४", "content_sanskrit": "अस्माकं तापसानां च न भयं त्वद्विधान्मनाक् ।\nशिवनामसहस्राणां विभूतिकृतवर्मणाम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004105024, "chapter_id": 24105, "verse_number": "४-५४-२५", "content_sanskrit": "तापसोदीरितमिति तद्रक्षः प्रीतिपूवर्कम् ।\nनिशम्य प्रांजलिः प्राह तं कृपालुं तपोधनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004105025, "chapter_id": 24105, "verse_number": "४-५४-२६", "content_sanskrit": "राक्षस उवाच ।\nअनुक्रोशोस्ति यदि ते भगवंस्तापसोत्तम ।\nस्ववृत्तांतं तदा वच्मि शृणुष्वावहितः क्षणम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004105026, "chapter_id": 24105, "verse_number": "४-५४-२७", "content_sanskrit": "प्रतिष्ठानाभिधानोस्ति देशो गोदावरी तटे ।\nतीर्थप्रतिग्रहरुचिस्तत्रासं ब्राह्मणस्त्वहम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004105027, "chapter_id": 24105, "verse_number": "४-५४-२८", "content_sanskrit": "तेन कर्मविपाकेन प्राप्तोस्मि गतिमीदृशीम् ।\nमरुस्थले महाघोरे तरुतोयविवर्जिते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004105028, "chapter_id": 24105, "verse_number": "४-५४-२९", "content_sanskrit": "गतो बहुतरः कालस्तत्र मे वसतो मुने ।\nक्षुधितस्य तृषार्तस्य शीततापसहस्य च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004105029, "chapter_id": 24105, "verse_number": "४-५४-३०", "content_sanskrit": "वर्षत्यपि महामेघे धारासारैर्दिवानिशम् ।\nप्रावृट्कालेऽनिले वाति किंचित्प्रावरणं न मे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004105030, "chapter_id": 24105, "verse_number": "४-५४-३१", "content_sanskrit": "पर्वण्यदत्तदाना ये कृततीर्थप्रतिग्रहाः ।\nत इमां योनिमृच्छंति महादुःख निबंधनीम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004105031, "chapter_id": 24105, "verse_number": "४-५४-३२", "content_sanskrit": "गते बहुतिथे काले मरुभूमौ मुने मया ।\nदृष्टो ब्राह्मणदायाद एकदा कश्चिदागतः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004105032, "chapter_id": 24105, "verse_number": "४-५४-३३", "content_sanskrit": "सूर्योदयमनुप्राप्य संध्याविधिविवर्जितः ।\nकृत्वा मूत्रपुरीषे तु शौचाचमनवर्जितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004105033, "chapter_id": 24105, "verse_number": "४-५४-३४", "content_sanskrit": "मुक्तकच्छमशौचं च संध्याकर्मविवर्जितम् ।\nतं दृष्ट्वा तच्छरीरेहं संक्रांतो भोगलिप्सया ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004105034, "chapter_id": 24105, "verse_number": "४-५४-३५", "content_sanskrit": "स द्विजो मंदभाग्यान्मे केनचिद्वणिजा सह ।\nअर्थलोभेन संप्राप्तः पुरीं पुण्यामिमां मुने ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004105035, "chapter_id": 24105, "verse_number": "४-५४-३६", "content_sanskrit": "अंतःपुरि प्रविष्टोभूत्स द्विजो मुनिसत्तम ।\nतच्छरीराद्बहिर्भूतस्त्वहं पापैः समं क्षणात् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004105036, "chapter_id": 24105, "verse_number": "४-५४-३७", "content_sanskrit": "प्रवेशो नास्ति चास्माकं प्रेतानां तपसां निधे ।\nमहतां पातकानां च वाराणस्यां शिवाज्ञया ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004105037, "chapter_id": 24105, "verse_number": "४-५४-३८", "content_sanskrit": "अद्यापि तानि पापानि तद्बहिर्निर्गमेच्छया ।\nबहिरेव हि तिष्ठंति सीम्नि प्रमथसाध्वसात् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004105038, "chapter_id": 24105, "verse_number": "४-५४-३९", "content_sanskrit": "अद्य श्वो वा परश्वो वा स बहिर्निर्गमिष्यति ।\nइत्याशया स्थिताः स्मो वै यावदद्य तपोधन ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004105039, "chapter_id": 24105, "verse_number": "४-५४-४०", "content_sanskrit": "नाद्यापि स बहिर्गच्छेन्नाद्याप्याशा प्रयाति नः ।\nइत्यास्महे निराधारा आशापाश नियंत्रिताः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004105040, "chapter_id": 24105, "verse_number": "४-५४-४१", "content_sanskrit": "चित्रमद्यतनं वच्मि तपस्विंस्तन्निशामय ।\nअतीव भावि कल्याणमिति मन्येऽधुनैव हि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004105041, "chapter_id": 24105, "verse_number": "४-५४-४२", "content_sanskrit": "आप्रयागं प्रतिदिनं प्रयामः क्षुधिता वयम् ।\nआहारकाम्यया क्वापि परं नो किंचिदाप्नुमः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004105042, "chapter_id": 24105, "verse_number": "४-५४-४३", "content_sanskrit": "संति सर्वत्र फलिनः पादपाः प्रतिकाननम् ।\nजलाशयाश्च स्वच्छापाः संति भूम्यां पदेपदे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004105043, "chapter_id": 24105, "verse_number": "४-५४-४४", "content_sanskrit": "अन्यान्यपि च भक्ष्याणि सर्वेषां सुलभान्यहो ।\nपानान्यपि विचित्राणि संति भूयांसि सर्वतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004105044, "chapter_id": 24105, "verse_number": "४-५४-४५", "content_sanskrit": "परं नो दृग्गतान्येव दूरे दूरे व्रजंत्यहो ।\nदैवादद्यैकमायांतं दृष्ट्वा कार्पटिकं मुने ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004105045, "chapter_id": 24105, "verse_number": "४-५४-४६", "content_sanskrit": "तस्यांतिकमहं प्राप्तः क्षुधया परिपीडितः ।\nप्रसह्य भक्षयाम्येनमिति मत्वा त्वरान्वितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004105046, "chapter_id": 24105, "verse_number": "४-५४-४७", "content_sanskrit": "यावत्तं तु जिघृक्षामि तावत्तद्वदनांबुजात् ।\nशिवनामपवित्रा वाङ्निरगाद्विघ्नहारिणी ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004105047, "chapter_id": 24105, "verse_number": "४-५४-४८", "content_sanskrit": "शिवनामस्मरणतो मदीयमपि पातकम् ।\nमंदीभूतं ततस्तेन प्रवेशं लब्धवानहम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004105048, "chapter_id": 24105, "verse_number": "४-५४-४९", "content_sanskrit": "सीमस्थैः प्रमथैर्नाहं सद्यो दृग्गोचरीकृतः ।\nशिवनामश्रुतौ येषां तान्न पश्येद्यमोपि यत् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004105049, "chapter_id": 24105, "verse_number": "४-५४-५०", "content_sanskrit": "अंतर्गेहस्य सीमानं प्राप्तस्तेन सहाधुना ।\nस तु कार्पटिको मध्यं प्रविष्टोहमिहस्थितः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004105050, "chapter_id": 24105, "verse_number": "४-५४-५१", "content_sanskrit": "आत्मानं बहुमन्येहं त्वां विलोक्याधुना मुने ।\nमामुद्धर कृपालो त्वं योनेरस्मात्सदारुणात् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004105051, "chapter_id": 24105, "verse_number": "४-५४-५२", "content_sanskrit": "इति प्रेतवचः श्रुत्वा स कृपालुस्तपोधनः ।\nमनसा चिंतयामास धिङ्निजार्थोद्यमान्नरान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004105052, "chapter_id": 24105, "verse_number": "४-५४-५३", "content_sanskrit": "स्वोदरं भर यः सर्वे पशुपक्षिमृगादयः ।\nस एव धन्यः संसारे यः परार्थोद्यतः सदा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004105053, "chapter_id": 24105, "verse_number": "४-५४-५४", "content_sanskrit": "तपसाद्य निजेनाहं प्रेतमेतमघातुरम् ।\nमामेव शरणं प्राप्तमुद्धरिष्याम्यसंशयम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004105054, "chapter_id": 24105, "verse_number": "४-५४-५५", "content_sanskrit": "विमृश्येति स वै चित्ते पिशाचं प्राह सत्तमः ।\nविमलोदे सरस्यस्मिन्स्नाहि रे पापनुत्तये ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004105055, "chapter_id": 24105, "verse_number": "४-५४-५६", "content_sanskrit": "पिशाच ते पिशाचत्वं तीर्थस्यास्य प्रभावतः ।\nकपर्दीशेक्षणादद्य क्षणात्क्षीणं विनंक्ष्यति ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004105056, "chapter_id": 24105, "verse_number": "४-५४-५७", "content_sanskrit": "श्रुत्वेति स मुनेर्वाक्यं प्रेतः प्राह प्रणम्य तम् ।\nप्रीतात्मा प्रीतमनसं प्रबद्धकरसंपुटः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004105057, "chapter_id": 24105, "verse_number": "४-५४-५८", "content_sanskrit": "पानीयं पातुमपि नो लभेयं मुनिसत्तम ।\nस्नानस्य का कथा नाथ रक्षेयुर्जलदेवताः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004105058, "chapter_id": 24105, "verse_number": "४-५४-५९", "content_sanskrit": "पानस्याप्यत्र का वार्ता जलस्पर्शोपि दुर्लभः ।\nइति प्रेतोक्तमाकर्ण्य स भृशं प्रीतिमानभूत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004105059, "chapter_id": 24105, "verse_number": "४-५४-६०", "content_sanskrit": "उवाच च तपस्वी तं जगदुद्धरणक्षमः ।\nगृहाणेमां विभूतिं त्वं ललाटफलके कुरु ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004105060, "chapter_id": 24105, "verse_number": "४-५४-६१", "content_sanskrit": "अस्माद्विभूतिमाहात्म्यात्प्रेत कोपि न कुत्रचित् ।\nबाधा करोति कस्यापि महापातकिनोप्यहो ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004105061, "chapter_id": 24105, "verse_number": "४-५४-६२", "content_sanskrit": "भालं विभूतिधवलं विलोक्य यमकिंकराः ।\nपापिनोपि पलायंते भीताः पाशुपतास्त्रतः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004105062, "chapter_id": 24105, "verse_number": "४-५४-६३", "content_sanskrit": "अस्थिध्वजांकितं दृष्ट्वा यथा पांथा जलाशयम् ।\nदूरं यंति तथा भस्म भालांकं यमकिंकराः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004105063, "chapter_id": 24105, "verse_number": "४-५४-६४", "content_sanskrit": "कृतभूति तनुत्राणं शिवमंत्रैर्नरोत्तमम् ।\nनोपसर्पंति नियतमपि हिंस्राः समंततः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004105064, "chapter_id": 24105, "verse_number": "४-५४-६५", "content_sanskrit": "भक्त्या बिभर्ति यो भस्म शिवमंत्रपवित्रितम् ।\nभाले वक्षसि दोर्मूले न तं हिंसंति हिंसकाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004105065, "chapter_id": 24105, "verse_number": "४-५४-६६", "content_sanskrit": "सर्वेभ्यो दुष्टसत्त्वेभ्यो यतो रक्षेदहर्निशम् ।\nरक्षत्येषा ततः प्रोक्ता विभूतिर्भूतिकृद्यतः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004105066, "chapter_id": 24105, "verse_number": "४-५४-६७", "content_sanskrit": "भासनाद्भर्त्सनाद्भस्म पांसुः पांसुत्वदायतः ।\nपापानां क्षारणात्क्षारो बुधेरेवं निरुच्यते ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004105067, "chapter_id": 24105, "verse_number": "४-५४-६८", "content_sanskrit": "गृहीत्वा धारमध्यात्स भस्म प्रेतकरेऽर्पयत् ।\nसोप्यादरात्समादाय भालदेशे न्यवेशयत् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004105068, "chapter_id": 24105, "verse_number": "४-५४-६९", "content_sanskrit": "विभूतिधारिणं वीक्ष्य पिशाचं जलदेवताः ।\nजलावगाहनपरं वारयांचक्रिरे न तम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004105069, "chapter_id": 24105, "verse_number": "४-५४-७०", "content_sanskrit": "स्नात्वा पीत्वा स निर्गच्छेद्यावत्तस्माज्जलाशयात् ।\nतावत्पैशाच्यमगमद्दिव्यदेहमवाप च ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004105070, "chapter_id": 24105, "verse_number": "४-५४-७१", "content_sanskrit": "दिव्यमालांबरधरो दिव्यगंधानुलेपनः ।\nदिव्ययानं समारुह्य वर्त्म प्राप्तोथ पावनम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004105071, "chapter_id": 24105, "verse_number": "४-५४-७२", "content_sanskrit": "गच्छता तेन गगने स तपस्वी नमस्कृतः ।\nप्रोच्चैः प्रोवाच भगवन्मोचितोस्मि त्वयानघ ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004105072, "chapter_id": 24105, "verse_number": "४-५४-७३", "content_sanskrit": "तस्मात्कदर्ययोनित्वादतीव परिनिंदितात् ।\nअस्य तीर्थस्य माहात्म्याद्दिव्यदेहमवाप्तवान् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004105073, "chapter_id": 24105, "verse_number": "४-५४-७४", "content_sanskrit": "पिशाचमोचनं तीर्थमद्यारभ्य समाख्यया ।\nअन्येषामपि पैशाच्यमिदं स्नानाद्धरिष्यति ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004105074, "chapter_id": 24105, "verse_number": "४-५४-७५", "content_sanskrit": "अस्मिंस्तीर्थे महापुण्ये ये स्नास्यंतीह मानवाः ।\nपिंडांश्च निर्वपिष्यंति संध्यातर्पणपूर्वकम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004105075, "chapter_id": 24105, "verse_number": "४-५४-७६", "content_sanskrit": "दैवात्पैशाच्यमापन्नास्तेषां पितृपितामहाः ।\nतेपि पैशाच्यमुत्सृज्य यास्यंति परमां गतिम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004105076, "chapter_id": 24105, "verse_number": "४-५४-७७", "content_sanskrit": "अद्यशुक्लचतुर्दश्यां मार्गेमासि तपोनिधे ।\nअत्र स्नानादिकं कार्यं पैशाच्यपरिमोचनम ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004105077, "chapter_id": 24105, "verse_number": "४-५४-७८", "content_sanskrit": "इमां सांवत्सरीं यात्रां ये करिष्यंति मानवाः ।\nतीर्थप्रतिग्रहात्पापान्निःसरिष्यंति ते नराः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004105078, "chapter_id": 24105, "verse_number": "४-५४-७९", "content_sanskrit": "पिशाचमोचने स्नात्वा कपर्दीशं समर्च्य च ।\nकृत्वा तत्रान्नदानं च नरोन्यत्रापि निर्भयाः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004105079, "chapter_id": 24105, "verse_number": "४-५४-८०", "content_sanskrit": "मार्गशुक्लचतुर्दश्यां कपर्दीश्वर संनिधौ ।\nस्नात्वान्यत्रापि मरणान्न पैशाच्यमवाप्नुयुः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004105080, "chapter_id": 24105, "verse_number": "४-५४-८१", "content_sanskrit": "इत्युक्त्वा दिव्यपुरुषो भूयोभूयो नमस्य तम् ।\nतपोधनं महाभागो दिव्यां गतिमवाप्तवान् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004105081, "chapter_id": 24105, "verse_number": "४-५४-८२", "content_sanskrit": "तपोधनोपि तं दृष्ट्वा महाश्चर्यं घटोद्भव ।\nकपर्दीश्वरमाराध्य कालान्निर्वाणमाप्तवान् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004105082, "chapter_id": 24105, "verse_number": "४-५४-८३", "content_sanskrit": "पिशाचमोचनं तीर्थं तदारभ्य महामुने ।\nवाराणस्यां परां ख्यातिमगमत्सर्वपापहृत् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004105083, "chapter_id": 24105, "verse_number": "४-५४-८४", "content_sanskrit": "पैशाचमोचने तीर्थे संभोज्य शिवयोगिनम् ।\nकोटिभोज्यफलं सम्यगेकैक परिसंख्यया ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004105084, "chapter_id": 24105, "verse_number": "४-५४-८५", "content_sanskrit": "श्रुत्वाध्यायमिमं पुण्यं नरो नियतमानसः ।\nभूतैः प्रेतैः पिशाचैश्च कदाचिन्नाभिभूयते ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004105085, "chapter_id": 24105, "verse_number": "४-५४-८६", "content_sanskrit": "बालग्रहाभिभूतानां बालानां शांतिकारकम् ।\nपठनीयं प्रयत्नेन महाख्यानमिदं परम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7004105086, "chapter_id": 24105, "verse_number": "४-५४-८७", "content_sanskrit": "इदमाख्यानमाकर्ण्य गच्छन्देशांतरं नरः ।\nचोरव्याघ्रपिशाचाद्यैर्नाभिभूयेत कुत्रचित् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7004105087, "chapter_id": 24105, "verse_number": "४-५४-८८", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशातिसाहस्र्यां संहितायां चतुर्थे काशीखंड उत्तरार्द्धे पिशाचमोचनमहिमाकथनं नाम चतुष्पंचाशत्तमोऽध्यायः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]