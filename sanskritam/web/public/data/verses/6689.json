  {
    "id": 20012234,
    "chapter_id": 6689,
    "verse_number": "17.100",
    "content_sanskrit": "तं दृष्ट्वा बलमधुसूदनप्रधाना भक्त्यार्दाः प्रमुदितमानसाः प्रणेमुः । फालानामुपरि कृताञ्जलिः क्षमायां दुर्दशः खलु भगवानभक्तिमद्भिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
