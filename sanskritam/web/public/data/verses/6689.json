  {
    "id": 20012243,
    "chapter_id": 6689,
    "verse_number": "17.109",
    "content_sanskrit": "अथ महिषमथन्याऽऽश्लिष्टयोमामुडाभ्यां बहुविधमनुनीतास्सर्ववृष्णिप्रवीराः । क्रमविगलितयुद्धारम्भसंरम्भसौम्यस्फुटनयनमपश्यन्नर्जुनं माधवीश्च ॥",
    "padaccheda": "",
    "anvaya": "",
