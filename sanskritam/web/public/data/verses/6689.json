[
  {
    "id": 20012135,
    "chapter_id": 6689,
    "verse_number": "17.1",
    "content_sanskrit": "सुभद्रया नुन्नहयप्रकाण्डं कोदण्डिनं पाण्डवमापतन्तम् । निरीक्षमाणा रुषमापुरुग्रा वृष्ण्यन्धका वीर्यबलावलिप्ताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20012136,
    "chapter_id": 6689,
    "verse_number": "17.2",
    "content_sanskrit": "फेनावदातोल्लसट्टहासैस्खेदच्छटाशीकरपङ्क्तिशारैः । कल्लोलभीमा भ्रुकुटीर्वहद्भिः क्षयाब्धिकल्पैः क्षुभितं तदा तैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20012137,
    "chapter_id": 6689,
    "verse_number": "17.3",
    "content_sanskrit": "प्रवेपमानस्तपनीयभूषामयूखसम्पर्कपिशङ्गदीप्तिः । महोग्रमूहे वपुरुग्रसेनो ज्वलन्निव क्रोधहुताशनेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20012138,
    "chapter_id": 6689,
    "verse_number": "17.4",
    "content_sanskrit": "प्रसह्य कन्यां'हरता पुरस्तादाक्रान्तमूर्धेव धनञ्जयेन । शिनिस्तदानीं प्रकटीचकार क्ष्वेलन्महानगमिच प्रकोपम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20012139,
    "chapter_id": 6689,
    "verse_number": "17.5",
    "content_sanskrit": "पादप्रहत्या हृदि कस्य गुर्व्या श्लथत्कुलक्ष्माधरबन्धना भूः । रन्ध्रैरपामापतितैः प्रवाहैरजायतारूढजनस्य भीत्यै ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20012140,
    "chapter_id": 6689,
    "verse_number": "17.6",
    "content_sanskrit": "संभृत्य संभारचयं समस्तं महाहवार्थी हृदि कस्य सूनुः । धूमायमानभ्रुकुटीसनाथं नेत्राग्निहोत्रं ज्वलयाञ्चकार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20012141,
    "chapter_id": 6689,
    "verse_number": "17.7",
    "content_sanskrit": "कान्ताकुचालेपनधातुपङ्कसम्पूर्णशस्त्रव्रणकन्दराली । परैरसह्यौ जितसह्यपादौ निशामयामास पृथुखबाहू ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20012142,
    "chapter_id": 6689,
    "verse_number": "17.8",
    "content_sanskrit": "शीर्णैः पतद्भिः कनकाङ्गुलीयैस्समन्ततस्साङ्गदपद्मरागैः । किरन्नु कोपानलविष्फुलिङ्गान् पराहतांसं विपथुश्रवास्यम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20012143,
    "chapter_id": 6689,
    "verse_number": "17.9",
    "content_sanskrit": "क्रोधाग्निताम्रेक्षणभानुभिन्नान्नाशिनः खड्गलतां दुधाव । विशृङ्खलौर्वाग्निशिखानुविद्धां कल्पावसानाब्धिरिवोर्मिलेखाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20012144,
    "chapter_id": 6689,
    "verse_number": "17.10",
    "content_sanskrit": "कृष्णेन हेमाभरणेन दोष्णा सर्वायसीं काञ्चनपट्टनद्धाम् । वलक्षवाहं प्रतिपक्षमाप्त्वा गदो गदामादित मोदमानः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20012145,
    "chapter_id": 6689,
    "verse_number": "17.11",
    "content_sanskrit": "दत्तव्रणं वल्लभयाऽतिरक्तं दन्तैस्तुदन्नोष्ठमरुन्तुदाग्रैः । आरोपयन्नेव शरासमाराज्जिष्णुं विलोक्याऽऽहूत रौक्मिणेयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20012146,
    "chapter_id": 6689,
    "verse_number": "17.12",
    "content_sanskrit": "अस्तूलसत्केतुपटैः शताङ्गै'मदार्द्रगन्धैर्भवतु द्विपेन्द्रैः । समीरवेगैरपि पूर्यतेऽश्वैरलं सखङ्गादिकरैश्च पद्गैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20012147,
    "chapter_id": 6689,
    "verse_number": "17.13",
    "content_sanskrit": "कृतापदानैरपि कृष्णमुख्यैः कृतश्च वृष्ण्यन्धकभोजवीरैः । धनञ्जयं जेतुमलं ममाऽऽजौ हलद्वितीयो भुजदण्ड एव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20012148,
    "chapter_id": 6689,
    "verse_number": "17.14",
    "content_sanskrit": "इति ब्रुवाणो मुसली पुरस्ताच्चचाल हालामदलोहिताक्षः । ककुब्भ्रकन्याकुचकुङ्कुमाङ्कं वहन् विशालं वनमालिवक्षः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20012149,
    "chapter_id": 6689,
    "verse_number": "17.15",
    "content_sanskrit": "क्रुद्धस्तथा सीरधरस्य पश्चादतिष्ठदारूढरथो रथाङ्गी । यथाऽतिमात्रं विजयाय कुप्यन्नवेदि वृष्ण्यन्धकमण्डलेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20012150,
    "chapter_id": 6689,
    "verse_number": "17.16",
    "content_sanskrit": "जितेन्दुकुन्दद्युतिदेहदीप्तौ रामः क्रुधाऽराजत लोहितायन् । समाविशन्त्या सकलं शरीरं सन्ध्यारुचेवाऽन्धकशासनाद्रिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20012151,
    "chapter_id": 6689,
    "verse_number": "17.17",
    "content_sanskrit": "श्यामोत्तरीय'रुचिशारशिरोधरोऽथ सङ्ग्रामताण्डवरसोल्लसदट्टहासः । कैलासशैलमिव शूलधरोऽधिरूढः श्वेतम्महागजमराजत सीरपाणिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20012152,
    "chapter_id": 6689,
    "verse_number": "17.18",
    "content_sanskrit": "ध्यातोपसृप्तपततत्पतितार्क्ष्यपृष्ठपीठश्रितस्सशरशार्ङ्गरथाङ्गशङ्खः । हारस्रक्कौस्तुभशुभ्रवनमालिवक्षाः पीताम्बरोऽपि शुशुभे मणिभूषणाढ्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20012153,
    "chapter_id": 6689,
    "verse_number": "17.19",
    "content_sanskrit": "अथोल्लसत्पत्तिजलप्रवाहा सुरस्रवन्तीवसुमेरुदर्याः । आपूरयन्ती ध्वनिभिर्दशाशा दाशार्हपुर्या निरियाय सेना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20012154,
    "chapter_id": 6689,
    "verse_number": "17.20",
    "content_sanskrit": "उत्थाय तोयादुदधेस्तदानीं गोत्रा महेन्द्रेण निकृत्तपक्षाः । दोग्धुं ध्रुवं तत्तनयाय चेलुः क्रुधा महासैन्यगजच्छलेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20012155,
    "chapter_id": 6689,
    "verse_number": "17.21",
    "content_sanskrit": "सिन्दूरकाश्मीरपरागशुम्भत्कुम्भस्तनी कान्तकरोरुदण्डा । तस्मिन् बले हास्तिकमावसन्ती साक्षादिवाऽलक्ष्यत राजलक्ष्मीः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20012156,
    "chapter_id": 6689,
    "verse_number": "17.22",
    "content_sanskrit": "गम्भीरबृंहारवमञ्जनाभं सशीकरोद्यत्करवीचिमालम् । दधावनीकद्विरदेन्द्रवृन्दं तत्राऽपरक्षारसमुद्रलीलाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20012157,
    "chapter_id": 6689,
    "verse_number": "17.23",
    "content_sanskrit": "निवेशनैर्नो युगपत्पदानां न्यभेदि मास्म प्रतिभूतधात्रीम् । ध्रुवम्महेभैरिति चिन्तयद्भिः स्थितं क्रमेणैव पदैश्चलद्भिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20012158,
    "chapter_id": 6689,
    "verse_number": "17.24",
    "content_sanskrit": "उदीरतोच्चावचरत्नमालासमुल्लसच्चामरफेनराजिः । बलाम्बुधौ तत्र परापतन्ती बभौ तुरङ्गालितरङ्गपङ्क्तिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20012159,
    "chapter_id": 6689,
    "verse_number": "17.25",
    "content_sanskrit": "आरूढयोधाग्रकरोद्गृहीतखलीनखण्डक्षतजार्द्रगण्डैः । उद्यत्तिरश्चीनतताग्रपादैः कशाहतैरूत्प्लुतमश्वरत्नैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20012160,
    "chapter_id": 6689,
    "verse_number": "17.26",
    "content_sanskrit": "आमन्द्रचक्रध्वनयोऽभिपेतू रंहस्विभिर्वाजिभिरुह्यमानाः । सिताभ्रशुभांशुकशोभिताग्रैः रथा दिवं केतुभिरुल्लिखन्तः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20012161,
    "chapter_id": 6689,
    "verse_number": "17.27",
    "content_sanskrit": "समुल्लसच्चारुदुकूलमालाविभूषणाः कुङ्कुमचन्दनार्द्राः । वल्गाववल्गुश्रितखड्गवल्लीरुल्लासयन्तो निजबाहुदण्डैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20012162,
    "chapter_id": 6689,
    "verse_number": "17.28",
    "content_sanskrit": "बालातपेन छुरितं बभासे कृपाणनीलोत्पलचक्रवालम् । सेनासख्यां परिवर्तमानं कल्लोलतुल्यैर्भटबाहुदण्डैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20012163,
    "chapter_id": 6689,
    "verse_number": "17.29",
    "content_sanskrit": "आरोप्य तूर्णं किरणैः स्फुरद्भिर्नीराजनानीव शिखां मणीनाम् । आस्फालयामासुरमन्दघोषं दृष्ट्वा भुजैर्भूपतयो धनूंषि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20012164,
    "chapter_id": 6689,
    "verse_number": "17.30",
    "content_sanskrit": "युद्धोपसोढृवुद्धमुखाब्बुजानां महाबलानामवनीपतीनाम् । भुजश्रिताऽराजत तोमरालिर्जयश्रियोऽपाङ्गपरम्परेव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20012165,
    "chapter_id": 6689,
    "verse_number": "17.31",
    "content_sanskrit": "सिताश्वसंसृष्टयदुद्रुमाणामुदश्वतः कोपकृपीटयोनेः । अश्रावि धीरध्वनितं न नूनं रथ्यारवो वारणबृंहितं वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20012166,
    "chapter_id": 6689,
    "verse_number": "17.32",
    "content_sanskrit": "शङ्खादिशब्दा विविशुः समानान् मन्द्राणि मत्तद्विपबृंहितानि । समेषु कांस्यादिरवेषु लीनास्तुरङ्गहेषानिनदाश्च ताराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20012167,
    "chapter_id": 6689,
    "verse_number": "17.33",
    "content_sanskrit": "मार्दङ्गिकाद्या निजवाद्यशब्दैर्नादं सहाशाभिरिवारभन्त । उदीर्यमाणैः प्रतिसन्ततैस्ताः प्रतिप्रणादव्यवहारिणीभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20012168,
    "chapter_id": 6689,
    "verse_number": "17.34",
    "content_sanskrit": "आघातनानाविधवाद्यकोणसंयोगशब्दप्रभवा पुपूरे । तरङ्गिता शब्दनदी तदानीं जनस्य कर्णाम्बरकन्दरासु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20012169,
    "chapter_id": 6689,
    "verse_number": "17.35",
    "content_sanskrit": "निधाय हस्तैररुणाम्बुजाभैर्हं‌सावदातान् वदनाम्बुजेषु । श्वासानिलापूरविसंस्थुलेषु प्रदध्मु‌रुर्वीपतयोऽथ शङ्खान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20012170,
    "chapter_id": 6689,
    "verse_number": "17.36",
    "content_sanskrit": "सेनाङ्गपादाहतिभिर्विभक्ताः संयोगहीनास्तनुना गरिम्णा । वातेन नुन्ना रुरुधुस्ततो द्यां त्रिकादयः क्षित्यणवोऽपरोक्षाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20012171,
    "chapter_id": 6689,
    "verse_number": "17.37",
    "content_sanskrit": "अश्वीयपादातपदैर्जनित्वा रथ्याङ्घ्रिपातैः परिमाणमाप्त्वा । विधूनितं हास्तिककर्णतालैः सेनारजस्सं‌ववृधे क्रमेण ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20012172,
    "chapter_id": 6689,
    "verse_number": "17.38",
    "content_sanskrit": "मुखान्तरीयं रणवारणानां कुचस्थलीचन्दनमिन्दिरायाः । पौरस्त्यधामाऽर्जुनपार्वणेन्दोश्चमूरजो दिक्षु समुच्चकाशे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20012173,
    "chapter_id": 6689,
    "verse_number": "17.39",
    "content_sanskrit": "अदर्शनं कान्ततमस्य कृत्वा सहस्रभानोर्नव‌यौवनस्य । वियोगवद्दत्तविषादमाशाः सेनारजो धूसरयाञ्चकार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20012174,
    "chapter_id": 6689,
    "verse_number": "17.40",
    "content_sanskrit": "आसारवर्षी विपरीतपाती धूमोऽनलव्याप्यतया वियुक्तः । ग्रस्तांशुमद्दीधितिरन्धकारो वसुन्धराधूलिररुन्ध विश्वम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20012175,
    "chapter_id": 6689,
    "verse_number": "17.41",
    "content_sanskrit": "निरुद्धमुग्धालकषट्पदेषु सर्पन् विशश्राम विकस्वरेषु । सेनापरागः पुरसुन्दरीणां मुखारविन्देषु तुषारगौरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20012176,
    "chapter_id": 6689,
    "verse_number": "17.42",
    "content_sanskrit": "सिन्दूरिताग्रं चलचापवालं विलोलकेत्वंशुककर्णतालम् । शिञ्जानघण्टं पृतनारजोऽभूत् द्युदन्तियूथभ्रमदन्दिविष्टम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20012177,
    "chapter_id": 6689,
    "verse_number": "17.43",
    "content_sanskrit": "निमीलितं द्रष्टुमुपेत्य युद्धं पराणुयोगारुणितोदराणि । अपारयन्तो नयनानि देवास्तदा नरेभ्यः स्पृहयाम्बभूवुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20012178,
    "chapter_id": 6689,
    "verse_number": "17.44",
    "content_sanskrit": "कस्तूरिकाकुङ्कुमचन्दनादिराजन्यकालेपनचूर्णकीर्णः । समानचित्रांशुकवच्चकाशे दिशां दशानां पृतनापरागः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20012179,
    "chapter_id": 6689,
    "verse_number": "17.45",
    "content_sanskrit": "फेनायमानं जलराशितीरे सौधायमानं नगरान्तराले । रजो रराजोपवने विस्रस्रं प्रफुल्लचूतप्रकरायमाणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20012180,
    "chapter_id": 6689,
    "verse_number": "17.46",
    "content_sanskrit": "भटोद्धटा श्लेषविकीर्णलक्ष्मीवक्षोजहारच्युतमौक्तिकाभाः । अंभोणवः कुंभिकरैरथाप्ताः धरण्यणूनां विदधुर्विभागान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20012181,
    "chapter_id": 6689,
    "verse_number": "17.47",
    "content_sanskrit": "अंभोणुसंयोगजकर्मदृष्टैस्संयोगनाशे विहिते विभागैः । स्थिते परोक्षे परमाणुचक्रे चक्रं चकाशे ककुभां क्रमेण ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20012182,
    "chapter_id": 6689,
    "verse_number": "17.48",
    "content_sanskrit": "भुजङ्गलोकान्नु भुवो नु गर्भान्नाभीसरोजान्नरकद्विषो नु । नवान्नु सिन्धोस्तमसोऽपरान्नु प्रविश्य विश्वं निरगात्परागः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20012183,
    "chapter_id": 6689,
    "verse_number": "17.49",
    "content_sanskrit": "अर्कांशुतप्तानि दिशो मुखानि प्रावृत्य मन्ये जहुरंशुकानि । तदाऽबलालोककुतूहलिन्यः को नाम सेनारजसः प्रसङ्गः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20012184,
    "chapter_id": 6689,
    "verse_number": "17.50",
    "content_sanskrit": "लसत्पताकातलकेतुबाहुश्लिष्टेभकुम्भस्तनचक्रवाला । आकाशमाश्लिष्य तदा निवृत्ता ध्रुवं धरा धूलिततिच्छलेन ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20012185,
    "chapter_id": 6689,
    "verse_number": "17.51",
    "content_sanskrit": "चमूरहङ्कारमथान्महान्तं शब्दप्रधानांश्च बहून् विकारान् । रजस्तमोरुद्विमुक्तसत्त्वा परस्य पुंसः प्रकृतेस्समाना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20012186,
    "chapter_id": 6689,
    "verse_number": "17.52",
    "content_sanskrit": "पितामहेनेव रजोमिलापात् प्राप्ते स्वसत्वप्रतिनीयमाना । नभस्तटिन्येव तरङ्गहस्तैरादीयमाने पदभाजि विष्णोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20012187,
    "chapter_id": 6689,
    "verse_number": "17.53",
    "content_sanskrit": "भास्वन्मयूखैरिव दह्यमाने प्रभञ्जनेनेव विधूयमाने । चिक्रीडिषत्काकुभकुम्भिहस्तैः प्रसारिताग्रैरिव गृह्यमाणे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20012188,
    "chapter_id": 6689,
    "verse_number": "17.54",
    "content_sanskrit": "आरोप्यमाणे धरयाऽऽत्मनीव क्रमेण सेनारजसि प्रशान्ते । श्रितामलव्योमतलैश्चकाशे तदीयशेषैरिव वारिवाहैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20012189,
    "chapter_id": 6689,
    "verse_number": "17.55",
    "content_sanskrit": "चेट्येव चम्वा क्षितिरेणुभूत्या प्रमृष्टमुक्ते तु पटाग्रपाण्या । नभो मरुत्वन्मणिदर्पणाभं प्रकाशयामास दिशाम्मुखानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20012190,
    "chapter_id": 6689,
    "verse_number": "17.56",
    "content_sanskrit": "जाताङ्गरागभ्रमकारिभूरि सेनारजोराजदुरोजकुम्भाः । सेर्ष्यं युवानो युवतीरपश्यंस्तथैव तास्तानपि पांसुलाङ्गान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20012191,
    "chapter_id": 6689,
    "verse_number": "17.57",
    "content_sanskrit": "धूलिच्छटाधूसरितौ तदानीं रराजतू रामरथाङ्गपाणी । मेघाम्बुपातैः कलुषौ प्रयागे गङ्गाकलिन्दात्मजयोरिवौघौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20012192,
    "chapter_id": 6689,
    "verse_number": "17.58",
    "content_sanskrit": "रजोङ्गते (?) रप्युपगूह्यमानं वपुर्धरण्या धरणीधरस्य । सहस्रपत्रासनया न मुक्तं संघर्षशीला हि सदा सपत्न्यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20012193,
    "chapter_id": 6689,
    "verse_number": "17.59",
    "content_sanskrit": "रजस्वलापि द्विपकुम्भकूटसिन्दूररक्तारुणिताम्बरश्रीः । रणव्यपायोत्सवतुष्टचित्तैर्भेजे भटैः प्राणसमेव सेना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20012194,
    "chapter_id": 6689,
    "verse_number": "17.60",
    "content_sanskrit": "आमुक्तमुक्तामणिकीर्णभास्वत्सौवर्णवर्माऽथ तमालनीलः । लग्नोडुसन्ध्याभ्रनभोविडम्बी पार्थो रथोपस्थमलञ्चकार ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20012195,
    "chapter_id": 6689,
    "verse_number": "17.61",
    "content_sanskrit": "ततो मुहुर्बाहुनुदि प्रियायां मुहुर्बले रोषकपायिताक्षे । मुहुश्च कृष्णे कृतकप्रकोपे चतुर्विचिक्षेप वलक्षपाहः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20012196,
    "chapter_id": 6689,
    "verse_number": "17.62",
    "content_sanskrit": "अथोल्लसद्भ्रुकुटिललाटभीषणाः परिस्फुरद्दशननिपीडिताधराः । श्रवोऽशनीरभिदधतस्सरस्वतीः पृथासुतं प्रति यदवः प्रतस्थिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20012197,
    "chapter_id": 6689,
    "verse_number": "17.63",
    "content_sanskrit": "ज्याजानुहस्तानमितैर्धनुर्भिस्संयोज्य हस्तैरितरैरुदस्ताः । आस्फालयन्नङ्गुलिभिर्ध्वनन्तीर्युयुत्समानाः कुकुरा रथस्थाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20012198,
    "chapter_id": 6689,
    "verse_number": "17.64",
    "content_sanskrit": "उत्क्रान्तमौर्वीस्थितमग्रहस्तैरमन्दमाकृष्य विरावयन्तः । जीवन्धनुर्देहगतञ्जगर्जुः कृतान्तदूता इव कुक्कुरेशाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20012199,
    "chapter_id": 6689,
    "verse_number": "17.65",
    "content_sanskrit": "उद्धृत्य बाणानथ बाणधिभ्यः सन्धाय बाणासनमण्डलेषु । आकृष्य चाऽऽकर्ण'मभूषयंस्तैः कुरुप्रवीरं कुकुरप्रवीराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20012200,
    "chapter_id": 6689,
    "verse_number": "17.66",
    "content_sanskrit": "भीकौतुकप्रेमपतत्सुभद्राकटाक्षमालारुचिकज्जलाक्ताः । ते कालकूटच्छुरिता इवोरस्सुरेशसूनोर्विविशुर्विशालम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20012201,
    "chapter_id": 6689,
    "verse_number": "17.67",
    "content_sanskrit": "वक्षो विहाय स्थलहंसकल्पा बाहुद्रुमद्वन्द्वशकुन्तकान्ताः । भोजैर्मुखाम्भोजमधुव्रताभा शिलीमुखाश्शातमखे निखाताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20012202,
    "chapter_id": 6689,
    "verse_number": "17.68",
    "content_sanskrit": "शितैश्शरैश्शक्रजमभ्यवर्षन् भद्रां सुभद्रां परिहृत्यभोजाः भ्रूचापमाकृष्य तु दृष्टिबाणांश्चिक्षेप सा तेषु सुपक्ष्मपक्षमान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20012203,
    "chapter_id": 6689,
    "verse_number": "17.69",
    "content_sanskrit": "जिष्णोस्सुभद्रा विशिखव्रणेषु स्रवत्सु रक्तं निखिलं कदुष्णम् । मुमोच नेत्राञ्जलिभिर्मयूखान् महौषधश्यामरसायमानान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20012204,
    "chapter_id": 6689,
    "verse_number": "17.70",
    "content_sanskrit": "शरावलीदारितवारवाणो निष्यन्दमानव्रणशोणितार्द्रः । बीभत्सुरालम्बत बालभानुप्रभापरिष्वक्ततमाललीलाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20012205,
    "chapter_id": 6689,
    "verse_number": "17.71",
    "content_sanskrit": "अस्रारुणः पाण्डवचण्डधामा बालस्ततो गाण्डिवमण्डलस्थः । तदन्धकानीकसमन्धकारं शरांशुभिः प्राक्रमत प्रभेत्तुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20012206,
    "chapter_id": 6689,
    "verse_number": "17.72",
    "content_sanskrit": "विज्ञापयन्तो ग्रहकार्मुकज्यासंयोजनाकृष्टशरासनानि सैन्यान् अलक्ष्यमाणान्यतिलाघवेन पार्थस्य पेतुर्गगने पृषत्काः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20012207,
    "chapter_id": 6689,
    "verse_number": "17.73",
    "content_sanskrit": "परस्परप्रग्रथिताग्रपुङ्खास्सुवर्णभूषारुचिभूषिताशाः । शिलीमुखानां नभसि स्म मालाः पतन्ति संक्रन्दननन्दनस्य ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20012208,
    "chapter_id": 6689,
    "verse_number": "17.74",
    "content_sanskrit": "सर्वानतृप्यन्त इवात्मधाम्ना सहस्ररश्मेः किरणान् पिबन्तः । निरन्तराला गगनान्तराले शरास्सुनासीरसुतस्य पेतुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20012209,
    "chapter_id": 6689,
    "verse_number": "17.75",
    "content_sanskrit": "ते बाणा भरतसुतस्य वृष्णिपानामुष्णीषान्मणिमुकुटानि कार्मुकानि । छत्राणि ध्वजशिखराणि चाशु हत्वा साश्चर्यं वियति विवर्तयाम्बभूवुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20012210,
    "chapter_id": 6689,
    "verse_number": "17.76",
    "content_sanskrit": "तरस्विनां वृष्णिशिलीमुखानां कृत्तानि कौन्तेयशरैश्शिरांसि । कुण्ठानि गत्वा कुरुसिंहवध्वाः कुचौ लिखित्वा कठिनौ निपेतुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20012211,
    "chapter_id": 6689,
    "verse_number": "17.77",
    "content_sanskrit": "जेतुं स्वबन्धूनजिघांसुरिच्छन् जनैश्शनैरेव स विध्यति स्म । तथापि ते तस्य शरप्रहारानिन्द्राशनिस्पर्शसमान्न शेकुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20012212,
    "chapter_id": 6689,
    "verse_number": "17.78",
    "content_sanskrit": "चापमण्डलमदृशतोभयोः पार्थयोस्समिति सव्यसाचिनः । अस्यतोर्लघुतया शरान् परैस्स्वर्णभूषितमलातचक्रवत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20012213,
    "chapter_id": 6689,
    "verse_number": "17.79",
    "content_sanskrit": "हनुमद्ध्वजेन हृतवीर्यतया समरात्पराजयत वृष्णिचमूः । गलदंशुकाभरणकेशभरा दयितेव जीवितसमेन रतात् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20012214,
    "chapter_id": 6689,
    "verse_number": "17.80",
    "content_sanskrit": "पलायमाने तु बले बलं तदा युयुत्सुराह्वास्त मुकुन्दसारथिम् । भुजेन सीरं ससुरारिशोणितं प्रगृह्य खट्वाङ्गमिव त्रिलोचनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20012215,
    "chapter_id": 6689,
    "verse_number": "17.81",
    "content_sanskrit": "अथाऽऽविरासीत्सहसा रणाङ्गणे त्रिविक्रमस्य स्मरणान्त्रियम्बकः । पयोनिधिद्वीपगलिङ्गपूजाप्रसादितो दातुमना हृदि स्थितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20012216,
    "chapter_id": 6689,
    "verse_number": "17.82",
    "content_sanskrit": "वन्दारुदेवमुनिचारणयक्षरक्षोविद्याधरादिविविधस्तुतिगीतितुष्टः । नन्दीशभृङ्गिरिटिमुख्यगणेशजुष्टः पार्श्वस्थितार्यगणनायककार्तिकेयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20012217,
    "chapter_id": 6689,
    "verse_number": "17.83",
    "content_sanskrit": "गृहीतसुम्भाद्यसुरासृगात्तत्रिशूलया मण्डलिकुण्डलिन्या । सीरायुधश्रीधरयोर्भगिन्या जुष्टस्स दिष्टप्रदयार्यया च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20012218,
    "chapter_id": 6689,
    "verse_number": "17.84",
    "content_sanskrit": "गण्डाद्रितुल्यककुदं प्रविलम्बिसास्नाशुभ्राम्बुदं पतितवालधिवारिधारम् । आरूढवानमलपादमृदग्रशृङ्गं कैलासभूधरमिवापरमुक्षराजम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20012219,
    "chapter_id": 6689,
    "verse_number": "17.85",
    "content_sanskrit": "मणिमण्डितफणिमण्डलवरमण्डलरशनावलयाङ्गुलिचरणाङ्गदजठरश्रुतिवलयः । भुजगाधिपमयमौक्तिकगणभूषितगलकः करपुष्करयुगधारितमृगदारकपरशुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20012220,
    "chapter_id": 6689,
    "verse_number": "17.86",
    "content_sanskrit": "दत्तभक्तवरदक्षिणपाणिप्रोतपार्श्वगतवित्तपहस्तः । ध्वस्तभक्तभयवामकराग्रस्पृष्टशैलतनयाकुचकुम्भः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20012221,
    "chapter_id": 6689,
    "verse_number": "17.87",
    "content_sanskrit": "व्याघ्रचर्मशवलं पृथु बिभ्रद् भस्मधूलिधवलशितिकण्ठः । सोडुपिङ्गलघनासितमेघस्तोकशारशरदम्बुदलीलः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20012222,
    "chapter_id": 6689,
    "verse_number": "17.88",
    "content_sanskrit": "अद्रितनयार्द्रकुचचन्दन'चितोरश्श्लिष्टसुखसुप्तविषतमफणिहारः । कुण्डलितकुण्डलकरीन्द्रकरकृष्टप्रत्तबिसकाण्डमतिपाण्डुदशनांशुः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20012223,
    "chapter_id": 6689,
    "verse_number": "17.89",
    "content_sanskrit": "कुशलितविश्वं शिशिरकरात्मक्षततिमिरौघं दिनकररूपम् । दहनमयञ्च क्षपितमनोजं कवलितयज्ञाहृतिदथदक्षं ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20012224,
    "chapter_id": 6689,
    "verse_number": "17.90",
    "content_sanskrit": "भोगीन्द्रमण्डनफणामणिभासमानं बिभ्रत्स धूर्तकुटजाम्बुरुहादिमालम् । बम्भ्रम्यमाणसुरसिन्धुजलान्तरालं राजत्करोटिशशिकोिटजटाकिरीटम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20012225,
    "chapter_id": 6689,
    "verse_number": "17.91",
    "content_sanskrit": "यो भिक्षाकः क्षोणिनान्नायकोऽपि ब्रह्मस्तम्भस्येशिताऽपि स्वहीनः । स्तुत्यैस्सर्वैर्निर्गुणोऽपि प्रकृत्या नित्यं कर्ता नित्यमप्यक्रियाकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20012226,
    "chapter_id": 6689,
    "verse_number": "17.92",
    "content_sanskrit": "गौर्या युक्तो नित्यमप्यद्वितीयो नेत्रज्योतिर्लीढकामोऽपि कामी । संहर्ताऽपि प्राणभाजामकोपस्सार्वोप्येको बिभ्रदात्मम्भरित्वम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20012227,
    "chapter_id": 6689,
    "verse_number": "17.93",
    "content_sanskrit": "पूर्णोऽप्यपर्णापहृतार्धदेहो भस्मानुलिप्तोऽपि विमुक्तलेपः । एकादशात्माऽपि विधूतसख्यः कैलाससद्मापि जगन्निवासः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20012228,
    "chapter_id": 6689,
    "verse_number": "17.94",
    "content_sanskrit": "सत्रब्रहत्योऽपि महापवित्रो नागश्रितश्शश्वदगश्रितोऽपि । जुष्टो भुजङ्गैरपि नीलकण्ठो निरामयश्शूलगदान्वितोऽपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20012229,
    "chapter_id": 6689,
    "verse_number": "17.95",
    "content_sanskrit": "अवयवै रहितोऽपि समुद्वहन्नवयवानखिलानतिसुन्दरान् । अणुरणोः परमादपि खादपि स्थिरतरः परमं भुवनेऽद्भुतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20012230,
    "chapter_id": 6689,
    "verse_number": "17.96",
    "content_sanskrit": "जटाजूटज्योतिर्जलधररुचं पल्लवनिभाभृङ्गश्रेणिच्छायां कुटजसुमनस्संहतिरुचि । स्फुरत्कण्ठाभिख्याविततिरपि नैशान्धतमसं ततायां सन्ध्यायां नयनचटुले यत्र जयति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20012231,
    "chapter_id": 6689,
    "verse_number": "17.97",
    "content_sanskrit": "वेधास्सारथिनुन्नवेदतुरगं चन्द्रार्कचक्रप्लुतं भूमिस्यन्दनमास्थितेन दधतं नागेन्द्रमौर्वीयुतम् । दोष्णा मेरुशरासनं हरिशरं येनाऽऽस्त धूमानलज्वालालीकवलीकृतासुरकुलं दग्धं पुराणां त्रयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20012232,
    "chapter_id": 6689,
    "verse_number": "17.98",
    "content_sanskrit": "भाङ्कारातिभयङ्करप्रसृमरज्वालावलीवेष्टनश्च्योतत्काञ्चनभूमिपङ्कपतितक्रन्दत्कुमाराङ्गनम् । येनानन्तशिलीमुखाननगतक्रोधातिरेकस्फुरत्क्रूरोर्ध्वेक्षणजाशुशुक्षणिमुचा प्लुष्टं पुराणां त्रयम् ॥",
