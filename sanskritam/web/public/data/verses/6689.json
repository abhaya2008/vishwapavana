  {
    "id": 20012242,
    "chapter_id": 6689,
    "verse_number": "17.108",
    "content_sanskrit": "मूढानां चरणसरोजकिङ्कराणामस्माकं भव शरणं सदा शिवेति । स्तुत्वोक्तो नरकजिताऽनुगृह्य वृष्णीनीशानस्सपरिषदम्बिकस्तिरोऽभूत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
