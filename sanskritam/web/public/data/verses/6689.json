  {
    "id": 20012236,
    "chapter_id": 6689,
    "verse_number": "17.102",
    "content_sanskrit": "तान्महतुयमयैरपीक्षणैः प्रेक्ष्य शीतकिरणैरथाऽब्रवीत् । शेखरेन्दुरुचिपुरितस्फुरन्मन्दहासरुचिरिन्दुशेखरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
