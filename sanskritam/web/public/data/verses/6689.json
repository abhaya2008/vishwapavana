  {
    "id": 20012233,
    "chapter_id": 6689,
    "verse_number": "17.99",
    "content_sanskrit": "कृत्त्या रक्ताद्रया यो द्विरददितिजभिन्नीलभासा गलेन क्ष्वेलं पाता दयालुर्दहनकणमुचा दग्धमीनं ध्वजोऽक्ष्णा । हन्ताकानङ्कपालैरुडुपतिकलया सोमबिम्बस्य भेत्ता भर्ता चाऽमर्त्यसिन्धोस्सितसलिलकणालङ्कृताभिर्जटाभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
