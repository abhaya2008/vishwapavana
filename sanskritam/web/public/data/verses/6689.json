  {
    "id": 20012246,
    "chapter_id": 6689,
    "verse_number": "17.112",
    "content_sanskrit": "नदीरम्भःपूरस्फुरितशफरश्रेणिशबला गिरीनप्यम्भोदस्थगितशिखरान् पुष्पितवनान् । वदन्तो माधव्यै विकसितविशालायतदृशे सुखं विश्राम्यन्तो ययुरभिहरिप्रस्थमथ ते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
