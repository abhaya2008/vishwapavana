  {
    "id": 20012244,
    "chapter_id": 6689,
    "verse_number": "17.110",
    "content_sanskrit": "घ्रातो मूर्धन्यभिवादितैरतिमुदा वृद्धैस्सवृष्ण्यन्धकैर्बालान् वन्दितपादपद्मयुगलानाघ्रातवान्मूर्धनि । आश्लिश्लेष घनं समेत्य सुहृदो गात्राणि गात्रैर्निजैस्तेषामौषधशीतलैश्शितशरक्षुण्णानि निर्वापयन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 110,
    "avatarnika": ""
  },
  {
    "id": 20012245,
    "chapter_id": 6689,
    "verse_number": "17.111",
    "content_sanskrit": "सोऽनुज्ञातो मुदितहृदयैर्यादवेन्द्रैर्वयस्यान् स्वं स्वं नीत्वा भवनमखिलं दत्तदीर्घानुयात्रान् । वध्वा सार्धं सपरिजनया रामदामोदराभ्यां कामेनाऽपि श्रितहरिरथो मोदमानः प्रतस्थे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 111,
    "avatarnika": ""
