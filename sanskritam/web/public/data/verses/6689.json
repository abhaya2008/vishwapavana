  {
    "id": 20012237,
    "chapter_id": 6689,
    "verse_number": "17.103",
    "content_sanskrit": "रौप्यस्य लिङ्गस्य समर्चनैर्वः पूर्वं प्रसन्नोऽस्मि यदुप्रवीराः ! युद्धेन तुष्यामितरामिदानीं स्वधर्मचर्या हि परा ममार्चा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20012238,
    "chapter_id": 6689,
    "verse_number": "17.104",
    "content_sanskrit": "युद्धे च पर्याप्तमिदं निमित्तं यत्क्षत्रियस्य ह्रियते परेण । स्वं वस्तु तत्रापि गुणैः प्रकाशं रत्नं कुलस्याऽऽभरणं कुमारी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20012239,
    "chapter_id": 6689,
    "verse_number": "17.105",
    "content_sanskrit": "सर्वाणि कार्याणि विमृश्य किन्तु प्राज्ञैस्समं सम्यगनुष्ठितानि । बुद्ध्या भवन्तीह नृणां समृद्ध्यै वृद्ध्यै त्वबुद्धेतरथा कृतानि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20012240,
    "chapter_id": 6689,
    "verse_number": "17.106",
    "content_sanskrit": "तद्वयमेकमतयः शृणुतोच्यमानं सूक्तं मया हितमिदं त्यजताऽतितृष्णाम् । सम्बन्धिने गुणसमृद्धिमते कुमारीमेतां प्रदत्त कुरुकेसरिणेऽनुरूपाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20012241,
    "chapter_id": 6689,
    "verse_number": "17.107",
    "content_sanskrit": "इति शङ्करस्य वचनेन शममुपयतोऽथ सीरिणः । बाहुपरिघशिरान्मुसलं हृतमार्ययाऽरिमधुसूदनस्य च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 107,
    "avatarnika": ""
