[{"id": 6000120000, "chapter_id": 10120, "verse_number": null, "content_sanskrit": "भगवद्बादरायणप्रणीतं श्रीमद्भागवतम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000120001, "chapter_id": 10120, "verse_number": null, "content_sanskrit": "अथ प्रथमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 6000120002, "chapter_id": 10120, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.001.m4a", "display_order": 3}, {"id": 6000120003, "chapter_id": 10120, "verse_number": "६-१-१", "content_sanskrit": "निवृत्तिमार्गः कथित आदौ भगवता यथा।\nक्रमयोगोपलब्धेन ब्रह्मणा यदसंसृतिः॥ ६/१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.002.m4a", "display_order": 4, "topics": [{"text": "पापपरिहारकं प्रायश्चित्तं कीदृशमिति परीक्षिता पृष्टेन शुक्राचार्येण पश्चात्तापसंयुक्तं भगवन्नामस्मरणादिकमेव प्रायश्चित्तमिति वक्तुम् अजामिलोपाख्यानारम्भः", "range": "१–२०"}]}, {"id": 6000120004, "chapter_id": 10120, "verse_number": "६-१-२", "content_sanskrit": "प्रवृत्तिलक्षणश्चैव त्रैगुण्यविषयो मुने।\nयोऽसावलीनप्रकृतेर्गुणसर्गः पुनः पुनः॥ ६/१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.003.m4a", "display_order": 5}, {"id": 6000120005, "chapter_id": 10120, "verse_number": "६-१-३", "content_sanskrit": "अधर्मलक्षणा नाना नरकाश्चोपवर्णिताः।\nमन्वन्तरश्च व्याख्यात आद्यः स्वायम्भुवो यतः॥ ६/१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.004.m4a", "display_order": 6}, {"id": 6000120006, "chapter_id": 10120, "verse_number": "६-१-४", "content_sanskrit": "प्रियव्रतोत्तानपदोर्वंशस्तच्चरितानि च।\nद्वीपवर्षसमुद्राद्रिनदीनदवनानि च॥ ६/१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.005.m4a", "display_order": 7}, {"id": 6000120007, "chapter_id": 10120, "verse_number": "६-१-५", "content_sanskrit": "धरामण्डलसंस्थानं भागलक्षणमानतः।\nज्योतिषां विवराणां च यथेदमसृजद् विभुः॥ ६/१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.006.m4a", "display_order": 8}, {"id": 6000120008, "chapter_id": 10120, "verse_number": "६-१-६", "content_sanskrit": "अधुनेह महाभाग यथैव नरकान् नरः।\nनानोग्रयातनान् नेयात् तन्मे व्याख्यातुमर्हसि॥ ६/१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.007.m4a", "display_order": 9}, {"id": 6000120009, "chapter_id": 10120, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.008.m4a", "display_order": 10}, {"id": 6000120010, "chapter_id": 10120, "verse_number": "६-१-७", "content_sanskrit": "न चेदिहैवापचितिं यथाऽहंसः कृतस्य कुर्यान्मनउक्तिपाणिभिः।\nध्रुवं स वै प्रेत्य नरकानुपैति ये कीर्तिता मे भवतस्तिग्मयातनाः॥ ६/१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.009.m4a", "display_order": 11}, {"id": 6000120011, "chapter_id": 10120, "verse_number": "६-१-८", "content_sanskrit": "तस्मात्पुरैवाश्विह पापनिष्कृतौ यतेत मृत्योरविपद् यदात्मनः।\nदोषस्य दृष्ट्वा गुरुलाघवं यथा भिषक् चिकित्सेत रुजां निदानवित्॥ ६/१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.010.m4a", "display_order": 12}, {"id": 6000120012, "chapter_id": 10120, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.011.m4a", "display_order": 13}, {"id": 6000120013, "chapter_id": 10120, "verse_number": "६-१-९", "content_sanskrit": "दृष्टश्रुताभ्यां यत्पापं जानन्नप्यात्मनोऽहितम्।\nकरोति भूयो विवशः प्रायश्चित्तमथो कथम्॥ ६/१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.012.m4a", "display_order": 14}, {"id": 6000120014, "chapter_id": 10120, "verse_number": "६-१-१०", "content_sanskrit": "क्‍वचिन्निवर्ततेऽभद्रात्क्‍वचिच्चरति तत्पुनः।\nप्रायश्चित्तमथोऽपार्थं मन्ये कुञ्जरशौचवत्॥ ६/१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.013.m4a", "display_order": 15}, {"id": 6000120015, "chapter_id": 10120, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.014.m4a", "display_order": 16}, {"id": 6000120016, "chapter_id": 10120, "verse_number": "६-१-११", "content_sanskrit": "कर्मणा कर्मनिर्हारो न ह्यात्यन्तिक इष्यते।\nअविद्वदधिकारित्वात् प्रायश्चित्तं विमर्शनम्॥ ६/१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.015.m4a", "display_order": 17}, {"id": 6000120017, "chapter_id": 10120, "verse_number": "६-१-१२", "content_sanskrit": "नाश्नतः पथ्यमेवान्नं व्याधयोऽभिभवन्ति हि।\nएवं नियमकृद्राजञ्छनैः क्षेमाय कल्पते॥ ६/१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.016.m4a", "display_order": 18}, {"id": 6000120018, "chapter_id": 10120, "verse_number": "६-१-१३", "content_sanskrit": "तपसा ब्रह्मचर्येण शमेन च दमेन च।\nत्यागेन सत्यशौचाभ्यां नियमेन यमेन च॥ ६/१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.017.m4a", "display_order": 19}, {"id": 6000120019, "chapter_id": 10120, "verse_number": "६-१-१४", "content_sanskrit": "देहवाग्बुद्धिजं धीरा धर्मज्ञाः श्रद्धयाऽन्विताः।\nक्षिपन्त्यघं महदपि वेणुगुल्ममिवानलः॥ ६/१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.018.m4a", "display_order": 20}, {"id": 6000120020, "chapter_id": 10120, "verse_number": "६-१-१५", "content_sanskrit": "केचित् केवलया भक्त्या वासुदेवपरायणाः।\nअघं धुन्वन्ति कार्त्स्न्येन नीहारमिव भास्करः॥ ६/१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.019.m4a", "display_order": 21}, {"id": 6000120021, "chapter_id": 10120, "verse_number": "६-१-१६", "content_sanskrit": "न तथा ह्यघवान् राजन् पूयेत तपआदिभिः।\nयथा कृष्णार्पितप्राणस्तत्पूरुषनिषेवया॥ ६/१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.020.m4a", "display_order": 22}, {"id": 6000120022, "chapter_id": 10120, "verse_number": "६-१-१७", "content_sanskrit": "सध्रीचीनो ह्ययं लोके पन्थाः क्षेमोऽकुतोभयः।\nसुशीलाः साधवो यत्र नारायणपरायणाः॥ ६/१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.021.m4a", "display_order": 23}, {"id": 6000120023, "chapter_id": 10120, "verse_number": "६-१-१८", "content_sanskrit": "प्रायश्चित्तानि चीर्णानि नारायणपराङ्मुखैः।\nन वै पुनन्ति राजेन्द्र सुराकुम्भमिवापगाः॥ ६/१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.022.m4a", "display_order": 24}, {"id": 6000120024, "chapter_id": 10120, "verse_number": "६-१-१९", "content_sanskrit": "सकृन्मनः कृष्णपदारविन्दयोर्निवेशितं तद्गुणरागि यैरिह।\nन ते यमं पाशभृतश्च तद्भटान् स्वप्नेऽपि पश्यन्ति हि चीर्णनिष्कृताः॥ ६/१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.023.m4a", "display_order": 25}, {"id": 6000120025, "chapter_id": 10120, "verse_number": "६-१-२०", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम्।\nदूतानां विष्णुयमयोः संवादं तं निबोध मे॥ ६/१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.024.m4a", "display_order": 26}, {"id": 6000120026, "chapter_id": 10120, "verse_number": "६-१-२१", "content_sanskrit": "कान्यकुब्जे द्विजः कश्चिद् दासीपतिरजामिलः।\nनाम्ना नष्टसदाचारो दास्याः संसर्गदूषितः॥ ६/१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.025.m4a", "display_order": 27, "topics": [{"text": "भ्रष्टसदाचारेण दासीपतिना अजामिलनान्ना विप्रेण मरणकाले नारायण इति दूरस्थस्वपुत्राह्वानम्", "range": "२१–२९"}]}, {"id": 6000120027, "chapter_id": 10120, "verse_number": "६-१-२२", "content_sanskrit": "बन्द्यक्षैः कैतवैश्चौर्यैर्गर्हितां वृत्तिमाश्रितः।\nबिभ्रत् कुटुम्बमशुचिर्यातयामास देहिनम्॥ ६/१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.026.m4a", "display_order": 28}, {"id": 6000120028, "chapter_id": 10120, "verse_number": "६-१-२३", "content_sanskrit": "एवं निवसतस्तस्य लालयानस्य तत्सुतान्।\nकालोऽत्यगान्महान्राजन् अष्टाशीत्यायुषः समाः॥ ६/१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.027.m4a", "display_order": 29}, {"id": 6000120029, "chapter_id": 10120, "verse_number": "६-१-२४", "content_sanskrit": "तस्य प्रवयसः पुत्रा दश तेषां तु योऽवमः।\nबालो नारायणो नाम्ना पित्रोश्च दयितो भृशम्॥ ६/१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.028.m4a", "display_order": 30}, {"id": 6000120030, "chapter_id": 10120, "verse_number": "६-१-२५", "content_sanskrit": "स बद्धहृदयस्तस्मिन्नर्भके कलभाषिणि।\nनिरीक्षमाणस्तल्लीलां मुमुदे जरठो भृशम्॥ ६/१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.029.m4a", "display_order": 31}, {"id": 6000120031, "chapter_id": 10120, "verse_number": "६-१-२६", "content_sanskrit": "भुञ्जानः प्रपिबन्खादन्बालकस्नेहयन्त्रितः।\nभोजयन्पाययन्मूढो न वेदागतमन्तकम्॥ ६/१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.030.m4a", "display_order": 32}, {"id": 6000120032, "chapter_id": 10120, "verse_number": "६-१-२७", "content_sanskrit": "स एवं वर्तमानोऽज्ञो मृत्युकाल उपस्थिते।\nमतिं चकार तनये बाले नारायणाह्वये॥ ६/१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.031.m4a", "display_order": 33}, {"id": 6000120033, "chapter_id": 10120, "verse_number": "६-१-२८", "content_sanskrit": "स पाशहस्तांस्‍त्रीन् दृष्ट्वा पुरुषान् भृशदारुणान्।\nवक्रतुण्डानूर्ध्वरोम्ण आत्मानं नेतुमागतान्॥ ६/१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.032.m4a", "display_order": 34}, {"id": 6000120034, "chapter_id": 10120, "verse_number": "६-१-२९", "content_sanskrit": "दूरे क्रीडनकासक्तं पुत्रं नारायणाह्वयम्।\nप्लावितेन स्वरेणोच्चैराजुहावाऽकुलेन्द्रियः॥ ६/१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.033.m4a", "display_order": 35}, {"id": 6000120035, "chapter_id": 10120, "verse_number": "६-१-३०", "content_sanskrit": "निशम्य म्रियमाणस्य मुखतो हरिकीर्तनम्।\nभर्तुर्नाम महाराज पार्षदाः सहसाऽपतन्॥ ६/१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.034.m4a", "display_order": 36, "topics": [{"text": "तत्काल एवागतैर्विष्णुदूतैर्यमदूतान्निवार्य अजामिलस्य यमपाशान्मोचनम्", "range": "३०–३१"}]}, {"id": 6000120036, "chapter_id": 10120, "verse_number": "६-१-३१", "content_sanskrit": "विकर्षतोऽन्तर्हृदयात् दासीपतिमजामिलम्।\nयमप्रेष्यान् विष्णुदूता वारयामासुरोजसा॥ ६/१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.035.m4a", "display_order": 37}, {"id": 6000120037, "chapter_id": 10120, "verse_number": "६-१-३२", "content_sanskrit": "ऊचुर्निषेधितास्तांस्ते वैवस्वतपुरःसराः।\nके यूयं प्रतिषेद्धारो धर्मराजस्य शासनम्॥ ६/१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.036.m4a", "display_order": 38, "topics": [{"text": "यमदूतविष्णुदूतयोर्विवादः", "range": "३२–५५"}]}, {"id": 6000120038, "chapter_id": 10120, "verse_number": "६-१-३३", "content_sanskrit": "कस्य वा कुत आयाताः कस्मादस्य निषेधथ।\nकिं देवा उपदेवा वा यूयं किं सिद्धसत्तमाः॥ ६/१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.037.m4a", "display_order": 39}, {"id": 6000120039, "chapter_id": 10120, "verse_number": "६-१-३४", "content_sanskrit": "सर्वे पद्मपलाशाक्षाः पीतकौशेयवाससः।\nकिरीटिनः कुण्डलिनो लसत्पुष्करमालिनः॥ ६/१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.038.m4a", "display_order": 40}, {"id": 6000120040, "chapter_id": 10120, "verse_number": "६-१-३५", "content_sanskrit": "सर्वे च नूत्नवयसः सर्वे चारुचतुर्भुजाः।\nधनुर्निषङ्गासिगदाशङ्खचक्राम्बुजश्रियः॥ ६/१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.039.m4a", "display_order": 41}, {"id": 6000120041, "chapter_id": 10120, "verse_number": "६-१-३६", "content_sanskrit": "दिशो वितिमिरालोकाः कुर्वन्तः स्वेन रोचिषा।\nकिमर्थं धर्मपालस्य किङ्करान् नो निषेधथ॥ ६/१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.040.m4a", "display_order": 42}, {"id": 6000120042, "chapter_id": 10120, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.041.m4a", "display_order": 43}, {"id": 6000120043, "chapter_id": 10120, "verse_number": "६-१-३७", "content_sanskrit": "इत्युक्ते यमदूतैस्ते वासुदेवोक्तकारिणः।\nतान् प्रत्यूचुः प्रहस्येदं मेघनिर्ह्रादया गिरा॥ ६/१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.042.m4a", "display_order": 44}, {"id": 6000120044, "chapter_id": 10120, "verse_number": null, "content_sanskrit": "विष्णुदूता ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.043.m4a", "display_order": 45}, {"id": 6000120045, "chapter_id": 10120, "verse_number": "६-१-३८", "content_sanskrit": "यूयं वै धर्मराजस्य यदि निर्देशकारिणः।\nब्रूत धर्मस्य नस्तत्त्वं यच्चाधर्मस्य लक्षणम्॥ ६/१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.044.m4a", "display_order": 46}, {"id": 6000120046, "chapter_id": 10120, "verse_number": "६-१-३९", "content_sanskrit": "कथंस्विद् ध्रियते दण्डः किं वाऽस्य स्थानमीप्सितम्।\nदण्ड्याः किं कारिणः सर्वे आहोस्वित् कतिचिन्नृणाम्॥ ६/१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.045.m4a", "display_order": 47}, {"id": 6000120047, "chapter_id": 10120, "verse_number": null, "content_sanskrit": "यमदूता ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.046.m4a", "display_order": 48}, {"id": 6000120048, "chapter_id": 10120, "verse_number": "६-१-४०", "content_sanskrit": "वेदप्रणिहितो धर्मो ह्यधर्मस्तद्विपर्ययः।\nवेदो नारायणः साक्षात् स्वयम्भूरिति शुश्रुम॥ ६/१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.047.m4a", "display_order": 49}, {"id": 6000120049, "chapter_id": 10120, "verse_number": "६-१-४१", "content_sanskrit": "येन स्वधाम्न्यमी भावा रजस्सत्त्वतमोमयाः।\nगुणनामक्रियारूपैर्विभाव्यन्ते यथातथम्॥ ६/१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.048.m4a", "display_order": 50}, {"id": 6000120050, "chapter_id": 10120, "verse_number": "६-१-४२", "content_sanskrit": "सूर्योऽग्निः खं मरुद्गावः सोमः सन्ध्याऽहनी दिशः।\nकालः स्वयं धर्म इति ह्येते धर्मस्य साक्षिणः॥ ६/१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.049.m4a", "display_order": 51}, {"id": 6000120051, "chapter_id": 10120, "verse_number": "६-१-४३", "content_sanskrit": "एतैरधर्मो विज्ञातः स्थानं दण्डस्य युज्यते।\nसर्वे क्रमानुरोधेन दण्डमर्हन्ति कारिणः॥ ६/१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.050.m4a", "display_order": 52}, {"id": 6000120052, "chapter_id": 10120, "verse_number": "६-१-४४", "content_sanskrit": "सम्भवन्ति ह्यभद्राणि विपरीतानि चानघाः।\nकारणं गुणसङ्गोऽस्ति देहवान्न ह्यकर्मकृत्॥ ६/१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.051.m4a", "display_order": 53}, {"id": 6000120053, "chapter_id": 10120, "verse_number": "६-१-४५", "content_sanskrit": "येन यावान् यथा धर्मो ह्यधर्मो वा समीहितः।\nस एव तत्फलं भुङ्क्ते तथा तावदमुत्र वै॥ ६/१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.052.m4a", "display_order": 54}, {"id": 6000120054, "chapter_id": 10120, "verse_number": "६-१-४६", "content_sanskrit": "यथेह देवप्रवरास्‍त्रैविध्यमुपलभ्यते।\nभूतेषु गुणवैचित्र्यात् तथाऽन्यत्रानुमीयते॥ ६/१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.053.m4a", "display_order": 55}, {"id": 6000120055, "chapter_id": 10120, "verse_number": "६-१-४७", "content_sanskrit": "वर्तमानोऽन्ययोः कालो गुणाभिज्ञापको यथा।\nएवं जन्मानयोरेतद्धर्माधर्मनिदर्शनम्॥ ६/१/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.054.m4a", "display_order": 56}, {"id": 6000120056, "chapter_id": 10120, "verse_number": "६-१-४८", "content_sanskrit": "मनसैव पुरे देवः पूर्वरूपं विपश्यति।\nअनुमीमांसतेऽपूर्वं मनसा भगवानजः॥ ६/१/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.055.m4a", "display_order": 57}, {"id": 6000120057, "chapter_id": 10120, "verse_number": "६-१-४९", "content_sanskrit": "यथाऽज्ञस्तमसा युक्त उपास्ते व्यक्तमेव हि।\nन वेद पूर्वमपरं नष्टजन्मस्मृतिस्तथा॥ ६/१/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.056.m4a", "display_order": 58}, {"id": 6000120058, "chapter_id": 10120, "verse_number": "६-१-५०", "content_sanskrit": "पञ्चभिः कुरुते स्वार्थान् पञ्च वेदाथ पञ्चभिः।\nएकस्तु षोडशेन त्रीन् स्वयं सप्तदशोऽश्नुते॥ ६/१/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.057.m4a", "display_order": 59}, {"id": 6000120059, "chapter_id": 10120, "verse_number": "६-१-५१", "content_sanskrit": "तदेतच्छोडशकलं लिङ्गं शक्तित्रयं महत्।\nधत्तेऽनु संसृतिं पुंसि हर्षशोकभयार्तिदम्॥ ६/१/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.058.m4a", "display_order": 60}, {"id": 6000120060, "chapter_id": 10120, "verse_number": "६-१-५२", "content_sanskrit": "देह्यज्ञोऽजितषड्वर्गोऽनिच्छन् कर्माणि कार्यते।\nकोशकार इवात्मानं कर्मणाऽऽच्छाद्य मुह्यति॥ ६/१/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.059.m4a", "display_order": 61}, {"id": 6000120061, "chapter_id": 10120, "verse_number": "६-१-५३", "content_sanskrit": "न हि कश्चित् क्षणमपि जातु तिष्ठत्यकर्मकृत्।\nकार्यते ह्यवशः कर्म सर्वः प्रकृतिजैर्गुणैः॥ ६/१/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.060.m4a", "display_order": 62}, {"id": 6000120062, "chapter_id": 10120, "verse_number": "६-१-५४", "content_sanskrit": "लब्ध्वा निमित्तमव्यक्तं व्यक्ताव्यक्तं भवत्युत।\nयथायोनि यथाबीजं स्वभावेन बलीयसा॥ ६/१/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.061.m4a", "display_order": 63}, {"id": 6000120063, "chapter_id": 10120, "verse_number": "६-१-५५", "content_sanskrit": "एष प्रकृतिसङ्गेन पुरुषस्य विपर्ययः।\nआसीत् स एव न चिराद् ईशसङ्गाद् विलीयते॥ ६/१/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.062.m4a", "display_order": 64}, {"id": 6000120064, "chapter_id": 10120, "verse_number": "६-१-५६", "content_sanskrit": "अयं च श्रुतसम्पन्नः शीलवृत्तगुणालयः।\nधृतव्रतो मृदुर्दान्तः सत्यवाकङ् मन्त्रविच्छुचिः॥ ६/१/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.063.m4a", "display_order": 65, "topics": [{"text": "यमदूतैः अजामिलकृतपापानुवादपूर्वकं तस्य दण्ड्यत्वकथनम्", "range": "५६–६८"}]}, {"id": 6000120065, "chapter_id": 10120, "verse_number": "६-१-५७", "content_sanskrit": "गुर्वग्न्यतिथिवृद्धानां शुश्रूषुर्निरहंकृतिः।\nसर्वभूतसृहृत्साधुर्मितवागनसूयकः॥ ६/१/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.064.m4a", "display_order": 66}, {"id": 6000120066, "chapter_id": 10120, "verse_number": "६-१-५८", "content_sanskrit": "एकदाऽसौ वनं यातः पितृसन्देशकृद्द्विजः।\nआदाय तत आवृत्तः फलपुष्पसमित्कुशान्॥ ६/१/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.065.m4a", "display_order": 67}, {"id": 6000120067, "chapter_id": 10120, "verse_number": "६-१-५९", "content_sanskrit": "ददर्श कामिनं कञ्चिच्छूद्रं सह भुजिष्यया।\nपीत्वा तु मधु मैरेयं मदाघूर्णितनेत्रया॥ ६/१/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.066.m4a", "display_order": 68}, {"id": 6000120068, "chapter_id": 10120, "verse_number": "६-१-६०", "content_sanskrit": "मत्तया विश्लथन्नीव्या ह्युपेतं निरपत्रपम्।\nक्रीडन्तमनुगायन्तं हसन्तमनयाऽन्तिके॥ ६/१/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.067.m4a", "display_order": 69}, {"id": 6000120069, "chapter_id": 10120, "verse_number": "६-१-६१", "content_sanskrit": "दृष्ट्वा तां कामलिप्तेन बाहुना परिरम्भिताम्।\nजगाम हृच्छयवशं सहसैव विमोहितः॥ ६/१/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.068.m4a", "display_order": 70}, {"id": 6000120070, "chapter_id": 10120, "verse_number": "६-१-६२", "content_sanskrit": "स्तम्भयन्नात्मनाऽऽत्मानं यावत्सत्त्वं यथाश्रुतम्।\nन शशाक समाधातुं मनो मदनवेपितम्॥ ६/१/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.069.m4a", "display_order": 71}, {"id": 6000120071, "chapter_id": 10120, "verse_number": "६-१-६३", "content_sanskrit": "तन्निमित्तस्मरव्याजग्रहग्रस्तो विचेतनः।\nतामेव मनसा ध्यायन् स्वधर्माद् विरराम ह॥ ६/१/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.070.m4a", "display_order": 72}, {"id": 6000120072, "chapter_id": 10120, "verse_number": "६-१-६४", "content_sanskrit": "तामेव तोषयामास पित्र्येणार्थेन यावता।\nग्राम्यैर्मनोरमैः कामैः प्रसीदेत यथा तथा॥ ६/१/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.071.m4a", "display_order": 73}, {"id": 6000120073, "chapter_id": 10120, "verse_number": "६-१-६५", "content_sanskrit": "विप्रां स्वभार्यामप्रौढां कुले महति लम्भिताम्।\nविससर्जाचिरात् पापः स्वैरिण्याऽपाङ्गविद्धधीः॥ ६/१/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.072.m4a", "display_order": 74}, {"id": 6000120074, "chapter_id": 10120, "verse_number": "६-१-६६", "content_sanskrit": "इतस्ततश्चोपनिन्ये न्यायतोऽन्यायतो धनम्।\nबभारास्याः कुटुम्बिन्याः कुटुम्बं मन्दधीरयम्॥ ६/१/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.073.m4a", "display_order": 75}, {"id": 6000120075, "chapter_id": 10120, "verse_number": "६-१-६७", "content_sanskrit": "यदसौ शास्‍त्रमुल्लङ्घ्य स्वैरचार्यार्यगर्हितः।\nअवर्तत चिरं कालमघायुरशुचिर्मलात्॥ ६/१/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.074.m4a", "display_order": 76}, {"id": 6000120076, "chapter_id": 10120, "verse_number": "६-१-६८", "content_sanskrit": "तत एनं दण्डपाणेः सकाशं कृतकिल्बिषम्।\nनेष्यामोऽकृतनिर्वेशं यत्र दण्डेन शुध्यति॥ ६/१/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_001/BhP_06.001.075.m4a", "display_order": 77}, {"id": 6000120077, "chapter_id": 10120, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे प्रथमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]