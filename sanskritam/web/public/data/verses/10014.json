[{"id": 6000014000, "chapter_id": 10014, "verse_number": null, "content_sanskrit": "अथ चतुर्दशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000014001, "chapter_id": 10014, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.001.m4a", "display_order": 2}, {"id": 6000014002, "chapter_id": 10014, "verse_number": "१-१४-१", "content_sanskrit": "एवं कृष्णसखः कृष्णो भ्रात्रा राज्ञा विकल्पितः।\nनानाशङ्कास्पदं रूपं कृष्णविश्लेषकर्शितः॥ १/१४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.002.m4a", "display_order": 3, "topics": [{"text": "अर्जुनेन युधिष्‍ठिरं प्रति स्वीयसकलाभ्युदयानां श्रीकृष्णानुग्रहैकहेतुत्वकथनम्। तथा विप्रशापनिमित्तकसकलयदुकुलक्षयस्य भगवतः स्वधामोपगमस्य च कथनम्", "range": "१–२८"}]}, {"id": 6000014003, "chapter_id": 10014, "verse_number": "१-१४-२", "content_sanskrit": "शोकाग्निशुष्यद्वदनहृत्सरोजं हतप्रभम्।\nविभुं तमेवानुध्यायन्नाशक्नोत्प्रतिभाषितुम्॥ १/१४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.003.m4a", "display_order": 4}, {"id": 6000014004, "chapter_id": 10014, "verse_number": "१-१४-३", "content_sanskrit": "कृच्छ्रेण संस्तभ्य शुचः पाणिनाऽऽमृज्य नेत्रजम्।\nपारोक्ष्येण समुन्नद्धप्रणयौत्कण्ठ्यकातरः॥ १/१४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.004.m4a", "display_order": 5}, {"id": 6000014005, "chapter_id": 10014, "verse_number": "१-१४-४", "content_sanskrit": "सख्यं मैत्रीं सौहृदं च सारथ्यादिषु संस्मरन्।\nनृपमग्रजमित्याह बाष्पगद्गदया गिरा॥ १/१४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.005.m4a", "display_order": 6}, {"id": 6000014006, "chapter_id": 10014, "verse_number": null, "content_sanskrit": "अर्जुन उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.006.m4a", "display_order": 7}, {"id": 6000014007, "chapter_id": 10014, "verse_number": "१-१४-५", "content_sanskrit": "वञ्चितोऽहं महाराज हरिणा बन्धुरूपिणा।\nयेन मेऽपहृतं तेजो देवविस्मापनं महत्॥ १/१४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.007.m4a", "display_order": 8}, {"id": 6000014008, "chapter_id": 10014, "verse_number": "१-१४-६", "content_sanskrit": "यस्य क्षणवियोगेन लोको ह्यप्रियदर्शनः।\nउक्थेन रहितो ह्येष मृतकः प्रोच्यते यथा॥ १/१४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.008.m4a", "display_order": 9}, {"id": 6000014009, "chapter_id": 10014, "verse_number": "१-१४-७", "content_sanskrit": "यत्संश्रयाद् द्रुपदगेह उपागतानां राज्ञां स्वयंवरमुखे स्मरदुर्मदानाम्।\nतेजो हृतं खलु मया विहतश्‍च मत्स्यः सज्जीकृतेन धनुषाऽधिगता च कृष्णा॥ १/१४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.009.m4a", "display_order": 10}, {"id": 6000014010, "chapter_id": 10014, "verse_number": "१-१४-८", "content_sanskrit": "यत्सन्निधावहमु खाण्डवमग्नयेऽदामिन्द्रं ‍च सामरगणं तरसा विजित्य।\nलब्धा सभा मयकृताऽद्भुतशिल्पमाया दिग्भ्योऽहरन्नृपतयो बलिमध्वरे ते॥ १/१४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.010.m4a", "display_order": 11}, {"id": 6000014011, "chapter_id": 10014, "verse_number": "१-१४-९", "content_sanskrit": "यत्सन्निधौ नृपशिरोङ्घ्रिमहन्मखार्थ आर्योऽनुजस्तव गदायुधसत्त्ववीर्यः।\nतेनाहृताः प्रमथनाथमखाय भूपा यन्मोचिताऽभ्युदनयन् बलिमध्वरे ते॥ १/१४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.011.m4a", "display_order": 12}, {"id": 6000014012, "chapter_id": 10014, "verse_number": "१-१४-१०", "content_sanskrit": "पत्‍न्‍यास्तवापि मखक्लृप्‍तमहाभिषेकश्लाघिष्‍ठचारुकबरं कितवैः सभायाम्।\nस्पृष्‍टं विकीर्य पदयोः पतिताश्रुमुख्यो यैस्तत्स्‍त्रियो न्यकृत तत्स विमुक्‍तकेश्यः॥ १/१४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.012.m4a", "display_order": 13}, {"id": 6000014013, "chapter_id": 10014, "verse_number": "१-१४-११", "content_sanskrit": "यत्तेजसाऽथ भगवान्युधि शूलपाणिर्विस्मापितः स गिरिशोऽस्‍त्रमदान्निजं मे।\nअन्येऽपि चाहममुनैव कलेवरेण प्राप्‍तो महेन्द्रभवने महदासनार्धम्॥ १/१४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.013.m4a", "display_order": 14}, {"id": 6000014014, "chapter_id": 10014, "verse_number": "१-१४-१२", "content_sanskrit": "तत्रैव मे विहरतो भुजदण्डयुग्मं गाण्डीवलक्षणमरातिवधाय देवाः।\nसेन्द्राः श्रिता यदनुभावितमाजमीढ तेनाहमद्य मुषितः पुरुषेण भूम्ना॥ १/१४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.014.m4a", "display_order": 15}, {"id": 6000014015, "chapter_id": 10014, "verse_number": "१-१४-१३", "content_sanskrit": "यद्बान्धवः कुरुबलाब्धिमनन्तपारमेको रथेन तरसाऽतरमार्यसत्त्वः।\nप्रत्याहृतं पुरुधनं ‍च मया परेषां तेजः परं मणिमयं ‍च हृतं शिरोभ्यः॥ १/१४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.015.m4a", "display_order": 16}, {"id": 6000014016, "chapter_id": 10014, "verse_number": "१-१४-१४", "content_sanskrit": "यो भीष्मकर्णगुरुशल्यचमूष्वदभ्रराजन्यवर्यरथमण्डलमण्डितासु।\nअग्रेचरो मम रथे रथयूथपानामायुर्मनांसि च दृशा सहसा यदार्च्छत्॥ १/१४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.016.m4a", "display_order": 17}, {"id": 6000014017, "chapter_id": 10014, "verse_number": "१-१४-१५", "content_sanskrit": "यद्दोष्षु मां प्रणिहितं गुरुभीष्मकर्णद्रौणित्रिगर्तशलसैन्धवबाह्लिकाद्यैः।\nअस्‍त्राण्यमेयमहिमानि निरूपितानि नोपस्पृशुर्नृहरिदासमिवासुराणि॥ १/१४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.017.m4a", "display_order": 18}, {"id": 6000014018, "chapter_id": 10014, "verse_number": "१-१४-१६", "content_sanskrit": "यन्मे नृपेन्द्र तदतर्क्यविहार ईशो योऽलब्धरूपमवदद्रणमूर्ध्नि दर्शी।\nयन्माययाऽऽवृतदृशो न विदुः परं तं सूत्रादयोऽहमहमस्मि ममेति भव्याः॥ १/१४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.018.m4a", "display_order": 19}, {"id": 6000014019, "chapter_id": 10014, "verse_number": "१-१४-१७", "content_sanskrit": "सौत्ये वृतः कुमतिनाऽऽत्मद ईश्‍वरो मे यत्पादपद्ममभवाय भजन्ति भव्याः।\nसंश्रान्तवाहमरयो रथिनो भुविष्‍ठं न प्राहरन्यदनुभावनिरस्तचित्ताः॥ १/१४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.019.m4a", "display_order": 20}, {"id": 6000014020, "chapter_id": 10014, "verse_number": "१-१४-१८", "content_sanskrit": "नर्माण्युदाररुचिरस्मितशोभनानि हे पार्थ हेऽर्जुन सखे कुरुनन्दनेति।\nसञ्जल्पितानि नरदेव हृदिस्पृशानि स्मर्तुर्लुठन्ति हृदयं मम माधवस्य॥ १/१४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.020.m4a", "display_order": 21}, {"id": 6000014021, "chapter_id": 10014, "verse_number": "१-१४-१९", "content_sanskrit": "शय्यासनाटनविकत्थनभोजनादिष्वैक्याद्वयस्य ऋभुमानिति विप्रलब्धः।\nसख्युः सखेव पितृवत्तनयस्य सर्वं सेहे महामहितया कुमतेरघं मे॥ १/१४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.021.m4a", "display_order": 22}, {"id": 6000014022, "chapter_id": 10014, "verse_number": "१-१४-२०", "content_sanskrit": "सोऽहं नृपेन्द्ररहितः पुरुषोत्तमेन सख्या प्रियेण सुहृदा हृदयेन शून्यः।\nअध्वन्युरुक्रमपरिग्रहमङ्ग रक्षन्गोपैरसद्भिरबलेव विनिर्जितोऽस्मि॥ १/१४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.022.m4a", "display_order": 23}, {"id": 6000014023, "chapter_id": 10014, "verse_number": "१-१४-२१", "content_sanskrit": "तद्वै धनुस्त इषवः स रथो हयास्ते सोऽहं रथी नृपतयो यत आमनन्ति।\nसर्वं क्षणेन तदभूदसदीशरिक्‍तं भस्मन्हुतं कुहकराद्धमिवोप्‍तमूषे॥ १/१४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.023.m4a", "display_order": 24}, {"id": 6000014024, "chapter_id": 10014, "verse_number": "१-१४-२२", "content_sanskrit": "राजंस्त्वयाऽभिपृष्‍टानां सुहृदां नः सुहृत्पुरे।\nविप्रशापविमूढानां निघ्नतां मुष्‍टिभिर्मिथः॥ १/१४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.024.m4a", "display_order": 25}, {"id": 6000014025, "chapter_id": 10014, "verse_number": "१-१४-२३", "content_sanskrit": "वारुणीं मदिरां पीत्वा मदोन्मथितचेतसाम्।\nअजानतामिवात्मानं चतुःपञ्चावशेषिताः॥ १/१४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.025.m4a", "display_order": 26}, {"id": 6000014026, "chapter_id": 10014, "verse_number": "१-१४-२४", "content_sanskrit": "प्रायेणैतद्भगवत ईश्‍वरस्य विचेष्‍टितम्।\nमिथो निघ्नन्ति भूतानि भावयन्ति च यन्मिथः॥ १/१४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.026.m4a", "display_order": 27}, {"id": 6000014027, "chapter_id": 10014, "verse_number": "१-१४-२५", "content_sanskrit": "जलौकसां जले यद्वन्महान्तोऽदन्त्यणीयसः।\nदुर्बलान्बलिनो राजन्महान्तो बलिनो मिथः॥ १/१४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.027.m4a", "display_order": 28}, {"id": 6000014028, "chapter_id": 10014, "verse_number": "१-१४-२६", "content_sanskrit": "एवं बलिष्‍ठैर्यदुभिर्महद्भिरितरान्विभुः। यदून्यदुभिरन्योन्यं भूभारं सञ्जहार ह।\nकण्टकं कण्टकेनैव द्वयं ‍चापीशितुः समम्॥ १/१४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.028.m4a", "display_order": 29}, {"id": 6000014029, "chapter_id": 10014, "verse_number": "१-१४-२७", "content_sanskrit": "देशकालार्थयुक्‍तानि हृत्तापोपशमानि च।\nहरन्ति स्मरतश्‍चित्तं गोविन्दाभिहितानि मे॥ १/१४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.029.m4a", "display_order": 30}, {"id": 6000014030, "chapter_id": 10014, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.030.m4a", "display_order": 31}, {"id": 6000014031, "chapter_id": 10014, "verse_number": "१-१४-२८", "content_sanskrit": "एवं चिन्तयतो जिष्णोः कृष्णपादसरोरुहम्।\nसौहार्देनातिगाढेन शान्ताऽऽसीद्विमला मतिः॥ १/१४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_01/adhyaya_014/BhP_01.014.031.m4a", "display_order": 32}, {"id": 6000014032, "chapter_id": 10014, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां प्रथमस्कन्धे चतुर्दशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]