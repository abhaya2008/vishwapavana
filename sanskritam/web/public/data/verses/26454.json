[{"id": 7006454000, "chapter_id": 26454, "verse_number": "२-११५-१", "content_sanskrit": "जनमेजय उवाच\nभूय एव द्विजश्रेष्ठ यदुसिंहस्य धीमतः ।\nकर्माण्यपरिमेयाणि श्रोतुमिच्छामि तत्त्वतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006454001, "chapter_id": 26454, "verse_number": "२-११५-२", "content_sanskrit": "श्रूयन्ते विविधानि स्म अद्भुतानि महाद्युतेः ।\nअसंख्येयानि दिव्यानि प्रकृतान्यपि सर्वशः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006454002, "chapter_id": 26454, "verse_number": "२-११५-३", "content_sanskrit": "यान्यहं विविधान्यस्य श्रुत्वा प्रीये महामुने ।\nप्रभूयाः सर्वशस्तात तानि मे शृण्वतोऽनघ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006454003, "chapter_id": 26454, "verse_number": "२-११५-४", "content_sanskrit": "वैशम्पायन उवाच\nबहून्याश्चर्यभूतलि केशवस्य महात्मनः ।\nकथितानि महाबाहो नान्तं शक्यं हि कर्मणाम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006454004, "chapter_id": 26454, "verse_number": "२-११५-५", "content_sanskrit": "गन्तुं हि भरतश्रेष्ठ विस्तरेण समन्ततः ।\nअवश्यं हि मया वाच्यं लेशमात्रेण भारत ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006454005, "chapter_id": 26454, "verse_number": "२-११५-६", "content_sanskrit": "विष्णोरमितवीर्यस्य प्रथितोदारकर्मणः ।\nआनुपूर्व्यां प्रवक्ष्यामि शृणुष्वैकमना नृप ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006454006, "chapter_id": 26454, "verse_number": "२-११५-७", "content_sanskrit": "द्वारवत्यां निवसता यदुसिंहेन धीमता ।\nराष्ट्राणि नृपमुख्यानां क्षोभितानि महात्मनाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006454007, "chapter_id": 26454, "verse_number": "२-११५-८", "content_sanskrit": "यदूनामन्तरप्रेप्सुर्विचक्रो दानवो हतः ।\nपुरं प्राग्ज्योतिषं गत्वा पुनस्तेन महात्मना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006454008, "chapter_id": 26454, "verse_number": "२-११५-९", "content_sanskrit": "समुद्रमध्ये दुष्टात्मा नरको दानवो हतः ।\nवासवं च रणे जित्वा पारिजातो हृतो बलात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006454009, "chapter_id": 26454, "verse_number": "२-११५-१०", "content_sanskrit": "वरुणश्चैव भगवान् निर्जितो लोहिते ह्रदे ।\nदन्तवक्त्रश्च कारूषो निहतो दक्षिणापथे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006454010, "chapter_id": 26454, "verse_number": "२-११५-११", "content_sanskrit": "शिशुपालश्च सम्पूर्णे किल्बिषैकशते हतः ।\nगत्वा च शोणितपुरं शंकरेणाभिरक्षितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006454011, "chapter_id": 26454, "verse_number": "२-११५-१२", "content_sanskrit": "बलेः सुतो महावीर्यो बाणो बाहुसहस्रभृत् ।\nमहामृधे महाराज जित्वा जीवन् विसर्जितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006454012, "chapter_id": 26454, "verse_number": "२-११५-१३", "content_sanskrit": "निर्जितः पावकश्चैव गिरिमध्ये महात्मना ।\nशाल्वश्च विजितः संख्ये सौभश्च विनिपातितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006454013, "chapter_id": 26454, "verse_number": "२-११५-१४", "content_sanskrit": "विक्षोभ्य सागरं चैव पाञ्चजन्यो वशीकृतः ।\nहयग्रीवश्च निहतो नृपाश्चान्ये महाबलाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006454014, "chapter_id": 26454, "verse_number": "२-११५-१५", "content_sanskrit": "जरासंधस्य निधने मोक्षिताः सर्वपार्थिवाः ।\nरथेन जित्वा नृपतीन् गान्धारतनया हृता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006454015, "chapter_id": 26454, "verse_number": "२-११५-१६", "content_sanskrit": "भ्रष्टराज्याश्च शोकार्ताः पाण्डवाः परिरक्षिताः ।\nदाहितं च वनं घोरं पुरुहूतस्य खाण्डवम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006454016, "chapter_id": 26454, "verse_number": "२-११५-१७", "content_sanskrit": "गाण्डीवं चाग्निना दत्तमर्जुनायोपपादितम् ।\nदौत्यं च तत्कृतं घोरे विग्रहे जनमेजय ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006454017, "chapter_id": 26454, "verse_number": "२-११५-१८", "content_sanskrit": "अनेन यदुमुख्येन यदुवंशो विवर्धितः ।\nकुन्त्याश्च प्रमुखे प्रोक्ता प्रतिज्ञा पाण्डवान् प्रति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006454018, "chapter_id": 26454, "verse_number": "२-११५-१९", "content_sanskrit": "निवृत्ते भारते युद्धे प्रतिदास्यामि तत्सुतान् ।\nमोक्षितश्च महातेजा नृगः शापात्सुदारुणात् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006454019, "chapter_id": 26454, "verse_number": "२-११५-२०", "content_sanskrit": "यवनश्च हतः संख्ये काल इत्यभिविश्रुतः ।\nवानरौ च महावीर्यौ मैन्दो द्विविद एव च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006454020, "chapter_id": 26454, "verse_number": "२-११५-२१", "content_sanskrit": "विजितौ युधि दुर्धर्षौ जाम्बवांश्च पराजितः ।\nसान्दीपनेस्तथा पुत्रस्तव चैव पिता तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006454021, "chapter_id": 26454, "verse_number": "२-११५-२२", "content_sanskrit": "गतौ वैवस्वतवशं जीवितौ तस्य तेजसा ।\nसंग्रामा बहवः प्राप्ता घोरा नरवरक्षयाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006454022, "chapter_id": 26454, "verse_number": "२-११५-२३", "content_sanskrit": "निहताश्च नृपाः सर्वे कृत्वा तज्जयमद्भुतम् ।\nजनमेजयास्य युद्धेषु यथा ते वर्णिता मया ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]