[{"id": 2126595, "chapter_id": 3714, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2126596, "chapter_id": 3714, "verse_number": "१", "content_sanskrit": "सा निहत्य मृगव्याधं प्रतस्थे कमलेक्षणा ।\nवनं प्रतिभयं शून्यं झिल्लिकागणनादितम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2126597, "chapter_id": 3714, "verse_number": "२", "content_sanskrit": "सिंहव्याध्रमृगद्वीपिवराहर्क्षमृगायुतम् ।\nनानापक्षिसमाकीर्णं म्लेच्छतस्करसेवितम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2126598, "chapter_id": 3714, "verse_number": "३", "content_sanskrit": "सालवेणुधराश्वत्थतिन्दुकेन्दुककिंशुकैः ।\nअर्जुनारिष्टसञ्छन्नं स्यन्दनैश्च सशाल्मलैः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2126599, "chapter_id": 3714, "verse_number": "४", "content_sanskrit": "जम्ब्वाम्रलोध्रखदिरशाकवेत्रसमाकुलम् ।\nकाश्मर्यामलकप्लक्षकदम्बोदुम्बरावृतम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2126600, "chapter_id": 3714, "verse_number": "५", "content_sanskrit": "बदरीबिल्वसञ्छन्नं न्यग्रोधैश्च समाकुलम् ।\nप्रियालतालखर्जूरहरीतकविभीतकैः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2126601, "chapter_id": 3714, "verse_number": "६", "content_sanskrit": "नानाधातुशतैर्नद्धान् विविधानपि चाचलान् ।\nसिंहर्क्षव्याघ्रसङ्घुष्टान् दरीश्चाद्भुतदर्शनाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2126602, "chapter_id": 3714, "verse_number": "७", "content_sanskrit": "नदीः सरांसि वापीश्च विविधांश्च मृगद्विजान् ।\nसुबहून् भीमरूपांश्च पिशाचोरगराक्षसान्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2126603, "chapter_id": 3714, "verse_number": "८", "content_sanskrit": "पल्वलानि तटाकानि गिरिकूटानि सर्वशः ।\nसरित्सरांसि च तथा ददर्शाद्भुतदर्शनान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2126604, "chapter_id": 3714, "verse_number": "९", "content_sanskrit": "यूथशो ददृशे चात्र विदर्भाधिपनन्दिनी ।\nमहिषान् वराहान् गोमायून् ऋक्षपन्नगवानरान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2126605, "chapter_id": 3714, "verse_number": "१०", "content_sanskrit": "तेजसा चैव लक्ष्म्या च कान्त्या च परया वृता ।\nवैदर्भी विचचारैका नळमन्वेषती तदा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2126606, "chapter_id": 3714, "verse_number": "११", "content_sanskrit": "नाबिभ्यत् सा नृपसुता भैमी तत्राथ कस्यचित् ।\nदारुणामटवीं प्राप्य भर्तृव्यसनकर्शिता \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2126607, "chapter_id": 3714, "verse_number": "१२", "content_sanskrit": "विदर्भराजतनया विललाप सुदुःखिता ।\nभर्तृशोकपरीताङ्गी शिलातळसमाश्रिता\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2126608, "chapter_id": 3714, "verse_number": "१३", "content_sanskrit": "सिंहोरस्क महाबाहो निषधाधिपते प्रभो ।\nक्वनु राजन् गतोऽसि त्वं त्यक्त्वा मां निर्जने वने\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2126609, "chapter_id": 3714, "verse_number": "१४", "content_sanskrit": "अश्वमेधादिभिर्वीर क्रतुभिश्चाप्तदक्षिणैः ।\nकथमिष्ट्वा नरव्याघ्र मयि मिथ्या प्रवर्तसे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2126610, "chapter_id": 3714, "verse_number": "१५", "content_sanskrit": "यत्त्वयोक्तं महाराज मत्समक्षं महाद्युते ।\nस्मर्तुमर्हसि कल्याण तत् सर्वं पार्थिवर्षभ\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2126611, "chapter_id": 3714, "verse_number": "१६", "content_sanskrit": "यथोक्तं विहगैर्हंसैः समीपे तव भूमिप ।\nमत्सकाशे च तैरुक्तं तदवेक्षितुमर्हसि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2126612, "chapter_id": 3714, "verse_number": "१७", "content_sanskrit": "एकतश्चतुरो वेदाः साङ्गोपाङ्गाः सविस्तराः ।\nअधीताः पुरुषव्याघ्र सत्यमेकं किलैकतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2126613, "chapter_id": 3714, "verse_number": "१८", "content_sanskrit": "तस्मादर्हसि शत्रुघ्न सत्यं कर्तुं नरेश्वर ।\nउक्तवानसि यद्वीर मत्सकाशे पुरा वचः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2126614, "chapter_id": 3714, "verse_number": "१९", "content_sanskrit": "हा वीर ननु नामाहमिष्टा किल तवानघ ।\nअस्यामटव्यां घोरायां किं मां न प्रतिभाषसे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2126615, "chapter_id": 3714, "verse_number": "२०", "content_sanskrit": "भक्षयत्येष मां रौद्रो व्यात्तास्यो दारुणाकृतिः ।\nअरण्यराट् क्षुधाविष्टः किं मां न त्रातुमर्हसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2126616, "chapter_id": 3714, "verse_number": "२१", "content_sanskrit": "न मे त्वदन्या सुभगे प्रिया इत्यब्रवीस्तदा ।\nतामृतां कुरु कल्याण पुरोक्तां भारतीं नळ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2126617, "chapter_id": 3714, "verse_number": "२२", "content_sanskrit": "उन्मत्तवद्विलपतीं भार्यामिष्टां नराधिप ।\nईप्सितामीप्सितेनाथ किं मां न प्रतिनन्दसे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2126618, "chapter_id": 3714, "verse_number": "२३", "content_sanskrit": "कृशां दीनां विवर्णां मां मलिनां वसुधाधिप ।\nवस्त्रार्धप्रावृतामेकां विलपन्तीमनाथवत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2126619, "chapter_id": 3714, "verse_number": "२४", "content_sanskrit": "यूथभ्रष्टामिवैकां मां हरिणीं पृथुलोचन ।\nन मानयसि मां नाथ रुदन्तीमरिकर्शन\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2126620, "chapter_id": 3714, "verse_number": "२५", "content_sanskrit": "महाराज महारण्ये मामिहैकाकिनीं सतीम् ।\nत्वत्पत्नीमभिभाषन्तीं किं मां न प्रतिभाषसे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2126621, "chapter_id": 3714, "verse_number": "२६", "content_sanskrit": "अनुव्रतां महाराज किं मां न प्रतिभाषसे ।\nकुलशीलोपसम्पन्नां चारुसर्वाङ्गशोभनाम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2126622, "chapter_id": 3714, "verse_number": "२८", "content_sanskrit": "नाद्य त्वामनुपश्यामि गिरावस्मिन् नरोत्तम ।\nवने चास्मिन् महाघोरे सिंहव्याघ्रनिषेविते \t॥२७॥\nशयानमुपविष्टं वा स्थितं वा मनुजाधिप ।\nप्रस्थितं वा नरश्रेष्ठ मम शोकविवर्धन\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2126623, "chapter_id": 3714, "verse_number": "२९", "content_sanskrit": "किं नु पृच्छामि दुःखार्ता त्वदर्थे शोककर्शिता ।\nकच्चिद्दृष्टस्त्वयाऽरण्ये सङ्गम्येह नळो नृपः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2126624, "chapter_id": 3714, "verse_number": "३०", "content_sanskrit": "को नु मे कथयेदद्य वनेऽस्मिन् विष्ठितं नळम् ।\nमहाबलं महात्मानं परव्यूहविनाशनम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2126625, "chapter_id": 3714, "verse_number": "३१", "content_sanskrit": "यमन्वेषसि राजानं बाले पद्मनिभेक्षणम् ।\nअयं नु इति कस्याद्य श्रोष्यामि मधुरां गिरम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2126626, "chapter_id": 3714, "verse_number": "३२", "content_sanskrit": "अरण्यराडयं श्रीमान् चतुर्दंष्ट्रो महाहनुः ।\nशार्दूलोऽभिमुखो याति पृच्छाम्येनमशङ्किता\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2126627, "chapter_id": 3714, "verse_number": "३३", "content_sanskrit": "भवान् मृगाणामधिपः त्वमस्मिन् कानने प्रभुः ।\nविदर्भराजतनयां दमयन्तीति विद्धि माम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2126628, "chapter_id": 3714, "verse_number": "३४", "content_sanskrit": "निषधाधिपतेर्भार्यां नळस्यामित्रघातिनः ।\nपतिमन्वेषणीमेकां कृपणां शोककर्शिताम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2126629, "chapter_id": 3714, "verse_number": "३५", "content_sanskrit": "आश्वासय मृगेन्द्रेह यदि दृष्टस्त्वया नळः ।\nसिंहस्कन्धो महाबाहुः पद्मपत्रनिभेक्षणः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2126630, "chapter_id": 3714, "verse_number": "३६", "content_sanskrit": "अथवाऽरण्यनृपते नळं यदि न पश्यसि ।\nमां भक्षयित्वा शार्दूल विशोकां कुरु दुःखिताम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2126631, "chapter_id": 3714, "verse_number": "३७", "content_sanskrit": "श्रुत्वारण्ये विलपितां मामेव मृगराट् स्वयम् ।\nयात्येतां मृष्टसलिलामापगां सागरोपमाम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2126632, "chapter_id": 3714, "verse_number": "३८", "content_sanskrit": "इमं शिलोच्चयं पुण्यं शृङ्गैर्बहुभिरुच्छ्रितैः ।\nविराजद्भिर्दिविस्पृग्भिर्नैकवर्णैर्मनोहरैः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2126633, "chapter_id": 3714, "verse_number": "३९", "content_sanskrit": "नानाधातुसमाकीर्णं विविधोपलशोभितम् ।\nअस्यारण्यस्य महतः केतुभूतमिव स्थितम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2126634, "chapter_id": 3714, "verse_number": "४०", "content_sanskrit": "सिंहशार्दूलमातङ्गवराहर्क्षसमाकुलम् ।\nपतत्त्रिभिर्बहुविधैः समन्तादनुनादितम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2126635, "chapter_id": 3714, "verse_number": "४१", "content_sanskrit": "किंशुकाशोकबकुळैः पुन्नागैरुपशोभितम् ।\nसरिद्भिः सविहङ्गाभिः शिखरैश्चापि शोभितम् ।\nपृथिव्यां रुचिराकारं चूडामणिरिव स्थितम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2126636, "chapter_id": 3714, "verse_number": "४२", "content_sanskrit": "गिरिराजमिमं तावत् पृच्छामि नृपतिं प्रति\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2126637, "chapter_id": 3714, "verse_number": "४३", "content_sanskrit": "भगवन्नचलश्रेष्ठ दिव्यदर्शन विश्रुत ।\nशरण्य बहुकल्याण नमस्तेऽस्तु महीधर\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2126638, "chapter_id": 3714, "verse_number": "४४", "content_sanskrit": "प्रणमे त्वाऽभिगम्याहं राजपुत्रीं निबोध माम् ।\nराजस्नुषां राजभार्यां दमयन्तीति विश्रुताम् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2126639, "chapter_id": 3714, "verse_number": "४५", "content_sanskrit": "राजा विदर्भाधिपतिः पिता मम महारथः ।\nभीमो नाम क्षितिपतिः चातुर्वर्ण्यस्य रक्षिता\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2126640, "chapter_id": 3714, "verse_number": "४६", "content_sanskrit": "राजसूयाश्वमेधानां क्रतूनां दक्षिणावताम् ।\nआहर्ता पार्थिवश्रेष्ठः पृथुचार्वञ्चितेक्षणः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2126641, "chapter_id": 3714, "verse_number": "४७", "content_sanskrit": "ब्रह्मण्यः साधुवृत्तश्च सत्यवागनसूयकः ।\nशीलवान् सत्यवान् शूरः पृथुश्रीर्धर्मविच्छुचिः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2126642, "chapter_id": 3714, "verse_number": "४८", "content_sanskrit": "सम्यग्गोप्ता विदर्भाणां निर्जितारिगणः प्रभुः ।\nतस्य मां विद्धि तनयां भगवन् समुपस्थिताम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2126643, "chapter_id": 3714, "verse_number": "४९", "content_sanskrit": "निषधेषु महीपालः श्वशुरो मे नृपोत्तमः ।\nगृहीतनामा विख्यातो वीरसेन इति स्म ह\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2126644, "chapter_id": 3714, "verse_number": "५०", "content_sanskrit": "तस्य राज्ञः सुतो वीरः श्रीमान् सत्यपराक्रमः ।\nक्रमप्राप्तं तु यो राज्यं पितुः समुपशासति\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2126645, "chapter_id": 3714, "verse_number": "५१", "content_sanskrit": "नळो नामारिदमनः पुण्यश्लोक इति श्रुतः ।\nब्रह्मण्यो वेदविद् वाग्मी पुण्यकृत् सोमपोऽग्निचित्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2126646, "chapter_id": 3714, "verse_number": "५२", "content_sanskrit": "यष्टा दाता च योद्धा च सम्यक्चैव प्रशासिता ।\nतस्य मामचलश्रेष्ठ विद्धि भार्यामुपस्थिताम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2126647, "chapter_id": 3714, "verse_number": "५३", "content_sanskrit": "त्यक्तां श्रिया भर्तृहीनाम् अनाथां व्यसनान्विताम् ।\nअन्वेषमाणां भर्तारं नलं नरवरोत्तमम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2126648, "chapter_id": 3714, "verse_number": "५४", "content_sanskrit": "खमुल्लिखद्भिरेतैर्हि त्वया शृङ्गशतैर्नृपः ।\nकच्चिद्दृष्टोऽचलश्रेष्ठ वनेऽस्मिन् दारुणे नळः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2126649, "chapter_id": 3714, "verse_number": "५५", "content_sanskrit": "गजेन्द्रविक्रमो धीमान् दीर्घबाहुररिन्दमः ।\nविक्रान्तः सत्यवान् धीरो भर्ता मम महायशाः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2126650, "chapter_id": 3714, "verse_number": "५६", "content_sanskrit": "महीधरसमो धैर्ये महीधर महीपतिः ।\nनिषधानामधिपतिः कच्चिद् दृष्टस्त्वया नळः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2126651, "chapter_id": 3714, "verse_number": "५७", "content_sanskrit": "किं मां विलपतीमेकां पर्वतश्रेष्ठ दुःखिताम् ।\nगिरा नाश्वासयस्यद्य स्वां सुतामिव मानद\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2126652, "chapter_id": 3714, "verse_number": "५८", "content_sanskrit": "वीर विक्रान्त धर्मज्ञ सत्यसन्ध महीपते ।\nयद्यस्मिन् वै वने राजन् दर्शयात्मानमात्मना\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2126653, "chapter_id": 3714, "verse_number": "५९", "content_sanskrit": "कदा नु स्निग्धगम्भीरां जीमूतस्वनसन्निभाम् ।\nश्रोष्यामि नैषधस्याहं वाचं ताममृतोपमाम्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2126654, "chapter_id": 3714, "verse_number": "६०", "content_sanskrit": "वैदर्भीत्येव कथितां शुभां राज्ञो महात्मनः ।\nआत्माभिसारिणीमृद्धां मम शोकनिबर्हणीम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2126655, "chapter_id": 3714, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2126656, "chapter_id": 3714, "verse_number": "समाप्तिः", "content_sanskrit": "इति सा तं गिरिश्रेष्ठमुक्त्वा पार्थिवनन्दिनी ।\nदमवन्ती ततो भूयो जगाम दिशमुत्तराम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2126657, "chapter_id": 3714, "verse_number": "६२", "content_sanskrit": "सा गत्वा त्रीनहोरात्रान् ददर्श परमाङ्गना ।\nतापसारण्यमतुलं दिव्यकाननशोभितम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2126658, "chapter_id": 3714, "verse_number": "६३", "content_sanskrit": "वसिष्ठभृग्वत्रिसमैः तापसैरुपशोभितम् ।\nनियतैर्नियताहारैर्दमशौचसमन्वितैः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2126659, "chapter_id": 3714, "verse_number": "६४", "content_sanskrit": "अब्भक्षैर्वायुभक्षैश्च पत्राहारैस्तथैव च ।\nजितेन्द्रियैर्महाभागैः स्वर्गमार्गदिदृक्षुभिः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2126660, "chapter_id": 3714, "verse_number": "६५", "content_sanskrit": "वल्कलाजिनसंवीतैर्मुनिभिः संयतेन्द्रियैः ।\nतापसाध्युषितं रम्यं ददर्शाश्रममण्डलम् \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2126661, "chapter_id": 3714, "verse_number": "६६", "content_sanskrit": "सा च दृष्ट्वाऽऽश्रमपदं नानामृगनिषेवितम् ।\nशाखामृगगणैश्चैव तापसैश्च समन्वितम् \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2126662, "chapter_id": 3714, "verse_number": "६७", "content_sanskrit": "सुभ्रूः सुकेशी सुश्रोणी सुकुचा सुद्विजानना ।\nवर्चस्विनी सुप्रतिष्ठा स्वञ्चितोद्यतगामिनी\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2126663, "chapter_id": 3714, "verse_number": "६८", "content_sanskrit": "सा दृष्ट्वैवाश्रमपदं वीरसेनसुतप्रिया ।\nयोषिद्रत्नं महाभागा दमयन्ती तपस्विनी \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2126664, "chapter_id": 3714, "verse_number": "६९", "content_sanskrit": "तापसैः समुपेतं च सा दृष्ट्वैव समाश्वसत् ।\nसाऽभिवाद्य तपोवृद्धान् विनयावनता स्थिता \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2126665, "chapter_id": 3714, "verse_number": "७०", "content_sanskrit": "स्वागतं त इति प्रोक्ता तैः सर्वैस्तापसैस्तथा ।\nपूजां चक्रे यथान्यायमृषीणां सा मनस्विनी\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2126666, "chapter_id": 3714, "verse_number": "७१", "content_sanskrit": "ततस्ते पूजिता विप्राः प्रयतेन्द्रियमानसाः ।\nआस्यतामित्यथोचुस्ते ब्रूहि किं करवामहे\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2126667, "chapter_id": 3714, "verse_number": "७२", "content_sanskrit": "तानुवाच वरारोहा कच्चिद् भगवतामिह ।\nतपःस्वग्निषु धर्मे च सर्वेषु मृगपक्षिषु\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2126668, "chapter_id": 3714, "verse_number": "७३", "content_sanskrit": "अपि स्वाध्याययोगेषु धर्मयोगेषु वा पुनः ।\nकुशलं वः प्रियतपाः स्वधर्माचरणेषु च\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2126669, "chapter_id": 3714, "verse_number": "७४", "content_sanskrit": "तैश्चोक्तं कुशलं भद्रे सर्वत्रेति तपस्विभिः ।\nब्रूहि सर्वानवद्याङ्गि का त्वं किञ्च चिकीर्षसि\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2126670, "chapter_id": 3714, "verse_number": "७५", "content_sanskrit": "दृष्ट्वैव ते परं रूपं द्युतिं च परमामिह ।\nविस्मयो नः समुत्पन्नः समाश्वसिहि मा शुचः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2126671, "chapter_id": 3714, "verse_number": "७६", "content_sanskrit": "अस्यारण्यस्य महती देवता वा महीभृतः ।\nअस्या हि नद्याः कल्याणि वद सत्यमनिन्दिते\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2126672, "chapter_id": 3714, "verse_number": "७७", "content_sanskrit": "साऽब्रवीत् तानृषीन् नाहमरण्यस्यास्य देवता ।\nन चाप्यस्य गिरेर्विप्रा न नद्या देवताऽप्यहम्\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2126673, "chapter_id": 3714, "verse_number": "७८", "content_sanskrit": "मानुषीं मां विजानीत यूयं सर्वे तपोधनाः ।\nविस्तरेणाभिधास्यामि तन्मे शृणुत सर्वशः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2126674, "chapter_id": 3714, "verse_number": "", "content_sanskrit": "दमयन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2126675, "chapter_id": 3714, "verse_number": "७९", "content_sanskrit": "विदर्भेषु महीपालो भीमो नाम महाद्युतिः ।\nतस्य मां तनयां सर्वे जानीत द्विजसत्तमाः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2126676, "chapter_id": 3714, "verse_number": "८०", "content_sanskrit": "निषधाधिपतिः श्रीमान् नळो नाम महायशाः ।\nवीरः सङ्ग्रामजिद् विद्वान् मम भर्ता विशांपतिः\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2126677, "chapter_id": 3714, "verse_number": "८१", "content_sanskrit": "देवताभ्यर्चनपरो द्विजातिजनवत्सलः ।\nगोप्ता निषधवंशस्य महाभागो महाद्युतिः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2126678, "chapter_id": 3714, "verse_number": "८२", "content_sanskrit": "सत्यवाग् धर्मवित् प्राज्ञो विक्रान्तः शत्रुसूदनः ।\nब्रह्मण्यो दैवतपरः श्रीमान् परपुरञ्जयः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2126679, "chapter_id": 3714, "verse_number": "८३", "content_sanskrit": "नळो नाम नृपश्रेष्ठो देवराजसमद्युतिः ।\nमम भर्ता विशालाक्षः पूर्णेन्दुवदनोऽरिहा \t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2126680, "chapter_id": 3714, "verse_number": "८४", "content_sanskrit": "आहर्ता क्रतुमुख्यानां वेदवेदाङ्गपारगः ।\nसपत्नानां मृधे हन्ता रविसोमसमप्रभः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2126681, "chapter_id": 3714, "verse_number": "८५", "content_sanskrit": "स कैश्चिन्निकृतिप्रज्ञैरकल्याणैर्नराधमैः ।\nआहूय पृथिवीपालः सत्यधर्मपरायणः \t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2126682, "chapter_id": 3714, "verse_number": "८६", "content_sanskrit": "देवने कुशलैर्जिह्मैर्जितो राज्यं वसूनि च ।\nविवासितश्च नगराद् वनवासमुपेयिवान्\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2126683, "chapter_id": 3714, "verse_number": "८७", "content_sanskrit": "तस्य मामवगच्छध्वं भार्यां राजर्षभस्य वै ।\nदमयन्तीति विख्यातां भर्तुर्दर्शनलालसाम्\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2126684, "chapter_id": 3714, "verse_number": "८८", "content_sanskrit": "सा वनानि गिरींश्चैव सरांसि सरितस्तथा ।\nपल्वलानि च सर्वाणि तथाऽरण्यानि सर्वशः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2126685, "chapter_id": 3714, "verse_number": "८९", "content_sanskrit": "अन्वेषन्ती स्वभर्तारं नळं रणविशारदम् ।\nमहात्मानं कृतास्त्रं च विचरामीह दुःखिता\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2126686, "chapter_id": 3714, "verse_number": "९०", "content_sanskrit": "कच्चिद् भगवतां पुण्यं तपोवनमिदं महत् ।\nभवेत् प्राप्तो नळो नाम निषधानां जनाधिपः\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2126687, "chapter_id": 3714, "verse_number": "९१", "content_sanskrit": "यत्कृतेऽहमिदं दुर्गं प्रपन्ना भृशदारुणम् ।\nवनं प्रतिभयं घोरं शार्दूलमृगसेवितम्\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2126688, "chapter_id": 3714, "verse_number": "९२", "content_sanskrit": "यदि कैश्चिदहोरात्रैर्न द्रक्ष्यामि नळं नृपम् ।\nआत्मानं श्रेयसा योक्ष्ये देहस्यास्य विमोक्षणात्\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2126689, "chapter_id": 3714, "verse_number": "९३", "content_sanskrit": "को नु मे जीवितेनार्थस्तमृते पुरुषर्षभम् ।\nकथं भविष्याम्यद्याहं भर्तृशोकाभिपीडिता\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2126690, "chapter_id": 3714, "verse_number": "९४", "content_sanskrit": "तथा विलपतीमेकामरण्ये भीमनन्दिनीम् ।\nदमयन्तीमथोचुस्ते तापसाः सत्यवादिनः\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2126691, "chapter_id": 3714, "verse_number": "९५", "content_sanskrit": "उदर्कस्तव कल्याणि कल्याणो भविता शुभे ।\nवयं पश्याम तपसा क्षिप्रं द्रक्ष्यसि नैषधम्\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2126692, "chapter_id": 3714, "verse_number": "९६", "content_sanskrit": "निषधानामधिपतिं नळं रिपुनिघातिनम् ।\nभैमि धर्मभृतां श्रेष्ठं द्रष्टासि विगतज्वरम् \t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2126693, "chapter_id": 3714, "verse_number": "९७", "content_sanskrit": "विमुक्तं सर्वपापेभ्यः सर्वरत्नविभूषितम् ।\nतदेव नगरं श्रेष्ठं प्रशासन्तमरिन्दमम्\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2126694, "chapter_id": 3714, "verse_number": "९८", "content_sanskrit": "द्विषतां भयकर्तारं सुहृदां शोकनाशनम् ।\nपतिमेष्यसि कल्याणि कल्याणाभिजनं नृपम्\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2126695, "chapter_id": 3714, "verse_number": "९९", "content_sanskrit": "एवमुक्त्वा नळस्येष्टां महिषीं पार्थिवात्मजाम् ।\nअन्तर्हितास्तापसास्ते साग्निहोत्राश्रमास्तथा\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2126696, "chapter_id": 3714, "verse_number": "१००", "content_sanskrit": "सा दृष्ट्वा महदाश्चर्यं विस्मिता त्वभवत् ततः ।\nदमयन्त्यनवद्याङ्गी वीरसेननृपस्नुषा\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2126697, "chapter_id": 3714, "verse_number": "१०१", "content_sanskrit": "चिन्तयामास वैदर्भी किमेतद् दृष्टवत्यहम् ।\nकिं नु स्वप्नो मया दृष्टः कोऽयं विधिरिहागतः ।\nक्व नु ते तापसाः सर्वे क्व तदाश्रममण्डलम्\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2126698, "chapter_id": 3714, "verse_number": "१०२", "content_sanskrit": "क्व सा पुण्यजला रम्या नानाद्विजनिषेविता ।\nनदी ते च नगा हृद्याः फलपुष्पोपशोभिताः\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2126699, "chapter_id": 3714, "verse_number": "१०३", "content_sanskrit": "इत्येतन्नरशार्दूल विस्मिता कमलेक्षणा ।\nध्यात्वा चिरं भीमसुता दमयन्ती शुचिस्मिता ।\nभर्तृशोककृशा दीना विवर्णवदनाऽभवत्\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2126700, "chapter_id": 3714, "verse_number": "१०४", "content_sanskrit": "सा गता चापरां भूमिं बाष्पसंदिग्धया गिरा ।\nविललापाश्रुपूर्णाक्षी दृष्ट्वाऽशोकतरुं ततः\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2126701, "chapter_id": 3714, "verse_number": "१०५", "content_sanskrit": "उपगम्य तरुश्रेष्ठमशोकं पुष्पितं वने ।\nपल्लवापीडितं हृद्यं विहङ्गैरपि नादितम्\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2126702, "chapter_id": 3714, "verse_number": "", "content_sanskrit": "दमयन्ती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2126703, "chapter_id": 3714, "verse_number": "१०६", "content_sanskrit": "अहो वनतरुः श्रीमान् शोभतेस्मिन् वनान्तरे ।\nआपीडैर्बहुभिर्भाति श्रीमान् द्रमिळराडिव\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2126704, "chapter_id": 3714, "verse_number": "१०७", "content_sanskrit": "अशोक शोकापनुद शोकोपहतचेतसम् ।\nत्वन्नाम्नीं वै कुरु क्षिप्रं प्रियसन्दर्शनाद्धि माम्\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2126705, "chapter_id": 3714, "verse_number": "१०८", "content_sanskrit": "अशोकां कुरु मां क्षिप्रमशोक प्रियदर्शन ।\nवीतशोकभयाबाधं कच्चित्त्वं दृष्टवान् नृपम्\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2126706, "chapter_id": 3714, "verse_number": "१०९", "content_sanskrit": "नळं नामारिदमनं दमयन्त्याः प्रियं पतिम् ।\nनिषधानामधिपतिं दृष्टवानसि मे प्रियम्\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2126707, "chapter_id": 3714, "verse_number": "११०", "content_sanskrit": "एकवस्त्रार्धसंवीतं सुकुमारतनुत्वचम् ।\nव्यसनेनार्दितं वीरमरण्यमिदमागतम्\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2126708, "chapter_id": 3714, "verse_number": "१११", "content_sanskrit": "यथा विशोका गच्छेयमशोकवर तत् कुरु ।\nसत्यनामा भवाशोक मम शोकविनाशनात्\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2126709, "chapter_id": 3714, "verse_number": "११२", "content_sanskrit": "एवं साऽशोकवृक्षं तमार्ता त्रिरुपगम्य सा ।\nजगाम दारुणं देशं वैदर्भी कमलेक्षणा\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2126710, "chapter_id": 3714, "verse_number": "११३", "content_sanskrit": "सा ददर्श नगान् नैकान् सरांसि सरितस्तथा ।\nनैकांश्च पर्वतान् रम्यान् नैकांश्च मृगपक्षिणः\t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2126711, "chapter_id": 3714, "verse_number": "११४", "content_sanskrit": "कन्दरांश्च नितम्बांश्च पर्वतांश्च सकिंशुकान् ।\nददर्श सा भीमसुता पतिमन्वेषती तदा\t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2126712, "chapter_id": 3714, "verse_number": "११५", "content_sanskrit": "सा गत्वा दूरमध्वानं दमयन्ती शुचिस्मिता ।\nददर्शाथ महासार्थं हस्त्यश्वरथसङ्कुलम्\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2126713, "chapter_id": 3714, "verse_number": "११६", "content_sanskrit": "उत्तरन्तं नदीं रम्यां प्रसन्नसलिलां शुभाम् ।\nसुशीततोयां विस्तीर्णां ह्लादिनीं पादपैर्वृताम्\t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2126714, "chapter_id": 3714, "verse_number": "११७", "content_sanskrit": "प्रोद्धुष्टां क्रौञ्चकुररैश्चक्रवाकैश्च शोभिताम् ।\nकूर्मग्राहझषाकीर्णां पुळिनद्वीपशोभिताम्\t॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2126715, "chapter_id": 3714, "verse_number": "११८", "content_sanskrit": "सा दृष्ट्वैव महासार्थं दमयन्ती यशस्विनी ।\nउपसर्प्य वरारोहा जनमध्यं विवेश ह\t॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2126716, "chapter_id": 3714, "verse_number": "११९", "content_sanskrit": "उन्मत्तरूपा शोकार्ता तथा वस्त्रार्धसंवृता ।\nकृशा विवर्णवदना पांसुध्वस्तशिरोरुहा\t॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2126717, "chapter_id": 3714, "verse_number": "१२०", "content_sanskrit": "तां दृष्ट्वा तत्र मनुजाः केचिद् भीताः प्रदुद्रुवुः ।\nकेचिच्चिन्तापरास्तस्थुः केचित् तत्र विचुक्रुशुः\t॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2126718, "chapter_id": 3714, "verse_number": "१२१", "content_sanskrit": "प्रहसन्ति स्म तां केचिन्न ह्यसूयन्ति चापरे ।\nकुर्वन्त्यस्यां दयां केचित् पप्रच्छुश्चापि भारत\t॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2126719, "chapter_id": 3714, "verse_number": "१२२", "content_sanskrit": "काऽसि कस्यासि कल्याणि किं वा मृगयसे वने ।\nत्वां दृष्ट्वा व्यथिताश्चैके नराः सार्थनिवासिनः\t॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2126720, "chapter_id": 3714, "verse_number": "१२३", "content_sanskrit": "वद सत्यं वनस्यास्य पर्वतस्याथवा दिशः ।\nदेवता त्वं हि कल्याणि त्वां वयं शरणं गताः\t॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2126721, "chapter_id": 3714, "verse_number": "१२४", "content_sanskrit": "यक्षी वा राक्षसी वा त्वमुताहोऽसि सुराङ्गना ।\nसर्वथा कुरु नः स्वस्ति रक्ष चास्माननिन्दिते \t॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2126722, "chapter_id": 3714, "verse_number": "१२५", "content_sanskrit": "यथाऽयं सर्वथा सार्थः क्षेमी शीघ्रमितो व्रजेत् ।\nतथा विधत्स्व कल्याणि यथा श्रेयो हि नो भवेत्\t॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2126723, "chapter_id": 3714, "verse_number": "१२६", "content_sanskrit": "तथोक्ता तेन सार्थेन दमयन्ती नृपात्मजा ।\nप्रत्युवाच ततः साध्वी भर्तृशोकेन पीडिता\t॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2126724, "chapter_id": 3714, "verse_number": "१२७", "content_sanskrit": "सार्थवाहश्च सार्थश्च जना ये चात्र केचन ।\nयुवस्थविरबालाश्च सार्थस्यास्य पुरोगमाः\t॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2126725, "chapter_id": 3714, "verse_number": "१२८", "content_sanskrit": "मानुषीं मां विजानीत मनुजाधिपतेः सुताम् ।\nनृपस्नुषां राजभार्यां भर्तृदर्शनलालसाम्\t॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2126726, "chapter_id": 3714, "verse_number": "१२९", "content_sanskrit": "विदर्भराण्मम पिता भर्ता राजा च नैषधः ।\nनळो नाम महाभागस्तं मार्गाम्यपराजितम् \t॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2126727, "chapter_id": 3714, "verse_number": "१३०", "content_sanskrit": "यदि जानीत नृपतिं क्षिप्रं शंसत मे प्रियम् ।\nनळं पुरुषशार्दूलममित्रगणसूदनम्\t॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2126728, "chapter_id": 3714, "verse_number": "१३१", "content_sanskrit": "तामुवाचानवद्याङ्गीं सार्थस्य च महाप्रभुः ।\nसार्थवाहः शुचिर्नाम दमयन्तीं नराधिप\t॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2126729, "chapter_id": 3714, "verse_number": "१३२", "content_sanskrit": "अहं सार्थस्य नेता वै सार्थवाहः शुचिस्मिते ।\nमनुष्यं नळनामानं न पश्यामि यशस्विनि\t॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2126730, "chapter_id": 3714, "verse_number": "१३३", "content_sanskrit": "गोमायुकुञ्जरद्वीपिमहिषर्क्षमृगानपि ।\nपश्याम्यस्मिन् वने दुर्गे ह्यमनुष्यनिषेविते\t॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2126731, "chapter_id": 3714, "verse_number": "१३४", "content_sanskrit": "यथा वयं तं पश्यामो नळं पार्थिवमत्र वै ।\nततो वै यक्षराजः स मणिभद्रः प्रसीदतु\t॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2126732, "chapter_id": 3714, "verse_number": "१३५", "content_sanskrit": "साऽब्रवीद् वणिजः सर्वान् सार्थवाहं च तं ततः ।\nक्वनु यास्यति सार्थोऽयमेतदाख्यातुमर्हथ\t॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2126733, "chapter_id": 3714, "verse_number": "", "content_sanskrit": "सार्थवाहः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2126734, "chapter_id": 3714, "verse_number": "१३६", "content_sanskrit": "सार्थोऽयं चेदिराजस्य सुबाहोः सत्यवादिनः ।\nक्षिप्रं जनपदं गन्ता लाभाय मनुजात्मजे \t॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2126735, "chapter_id": 3714, "verse_number": "१२", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि\nषट्पञ्चाशोऽध्यायः ॥५६॥ ॥ तीर्थयात्रापर्वणि द्वादशोऽध्यायः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}]