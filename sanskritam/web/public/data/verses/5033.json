[{"id": 2189825, "chapter_id": 5033, "verse_number": "", "content_sanskrit": "शुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2189826, "chapter_id": 5033, "verse_number": "१", "content_sanskrit": "अध्यात्मं विस्तरेणेह पुनरेव वदस्व मे ।\nयदध्यात्मं यथा चेदं भगवन्नृषिसत्तम\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2189827, "chapter_id": 5033, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2189828, "chapter_id": 5033, "verse_number": "२", "content_sanskrit": "अध्यात्मं यदिदं तात पुरुषस्येह विद्यते ।\nतत्तेऽहं सम्प्रवक्ष्यामि तस्य व्याख्यामिमां शृणु\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2189829, "chapter_id": 5033, "verse_number": "३", "content_sanskrit": "भूमिरापस्तथा ज्योतिर्वायुराकाशमेव च ।\nमहाभूतानि भूतानां सागरस्योर्मयो यथा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2189830, "chapter_id": 5033, "verse_number": "४", "content_sanskrit": "प्रसार्येह यथाङ्गानि कूर्मः संहरते पुनः ।\nतद्वन्महान्ति भूतानि यवीयःसु विकुर्वते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2189831, "chapter_id": 5033, "verse_number": "समाप्तिः", "content_sanskrit": "इति तन्मयमेवेदं सर्वं स्थावरजङ्गमम् ।\nसर्गे च प्रलये चैव तस्मान्निर्दिश्यते तथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2189832, "chapter_id": 5033, "verse_number": "६", "content_sanskrit": "महाभूतानि पञ्चैव सर्वभूतेषु भूतकृत् ।\nअकरोत् तात वैषम्यं यस्मिन् यदनुपश्यति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2189833, "chapter_id": 5033, "verse_number": "", "content_sanskrit": "शुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2189834, "chapter_id": 5033, "verse_number": "७", "content_sanskrit": "अकरोद् यच्छरीरेषु कथं तदुपलक्षयेत् ।\nइन्द्रियाणि गुणाः केचित् कथं तानुपलक्षयेत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2189835, "chapter_id": 5033, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2189836, "chapter_id": 5033, "verse_number": "८", "content_sanskrit": "एतत्ते वर्तयिष्यामि यथावदिह दर्शनम् ।\nशृणु तत्त्वमिहैकाग्रो यथातत्त्वं यथा च तत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2189837, "chapter_id": 5033, "verse_number": "९", "content_sanskrit": "शब्दः श्रोत्रं तथा खानि त्रयमाकाशसम्भवम् ।\nप्राणश्चेष्टा तथा स्पर्श एते वायुगुणास्त्रयः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2189838, "chapter_id": 5033, "verse_number": "१०", "content_sanskrit": "रूपं चक्षुर्विपाकश्च त्रिधा ज्योतिर्विधीयते ।\nरसोऽथ रसनं स्नेहो गुणास्त्वेते त्रयोऽम्भसाम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2189839, "chapter_id": 5033, "verse_number": "११", "content_sanskrit": "घ्रेयं घ्राणं शरीरं च भूमेरेते गुणास्त्रयः ।\nएतावानिन्द्रियग्रामो व्याख्यातः पाञ्चभौतिकः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2189840, "chapter_id": 5033, "verse_number": "१२", "content_sanskrit": "वायोः स्पर्शो रसोऽद्भ्यश्च ज्योतिषो रूपमुच्यते ।\nआकाशप्रभवः शब्दो गन्धो भूमिगुणः स्मृतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2189841, "chapter_id": 5033, "verse_number": "१३", "content_sanskrit": "मनो बुद्धिश्च भावश्च त्रय एतेऽऽत्मयोनिजाः ।\nन गुणानतिवर्तन्ते गुणेभ्यः परमा मताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2189842, "chapter_id": 5033, "verse_number": "१४", "content_sanskrit": "इन्द्रियाणि नरे पञ्च षष्ठं तु मन उच्यते ।\nसप्तमीं बुद्धिमेवाहुः क्षेत्रज्ञं पुनरष्टमम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2189843, "chapter_id": 5033, "verse_number": "१५", "content_sanskrit": "चक्षुरालोचनायैव संशयं कुरुते मनः ।\nबुद्धिरध्यवसानाय साक्षी क्षेत्रज्ञ उच्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2189844, "chapter_id": 5033, "verse_number": "१६", "content_sanskrit": "रजस्तमश्च सत्त्वं च त्रय एते स्वयोनिजाः ।\nसमाः सर्वेषु भूतेषु तद्गुणेषूपलक्षयेत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2189845, "chapter_id": 5033, "verse_number": "१७", "content_sanskrit": "यथा कूर्म इहाङ्गानि प्रसार्य विनियच्छति ।\nएवमेवेन्द्रियग्रामं बुद्धिः सृष्ट्वा नियच्छति\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2189846, "chapter_id": 5033, "verse_number": "१८", "content_sanskrit": "यदूर्ध्वं पादतळयोरवाङ्मूर्ध्नश्च पश्यति ।\nएतस्मिन्नेव कृत्ये वै वर्तते बुद्धिरुत्तमा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2189847, "chapter_id": 5033, "verse_number": "१९", "content_sanskrit": "गुणानुन्नीयते बुद्धिर्बुद्धिरेवेन्द्रियाण्यपि ।\nमनःषष्ठानि सर्वाणि बुद्ध्यभावे कुतो गुणाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2189848, "chapter_id": 5033, "verse_number": "२०", "content_sanskrit": "तत्र यत् प्रीतिसंयुक्तं किञ्चिदात्मनि लक्षयेत् ।\nप्रशान्तमिव संशुद्धं सत्त्वं तदुपधारयेत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2189849, "chapter_id": 5033, "verse_number": "२१", "content_sanskrit": "यत्तु सन्तापसंयुक्तं काये मनसि वा भवेत् ।\nरजः प्रवर्तकं तत्स्यात् सततं हारि देहिनाम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2189850, "chapter_id": 5033, "verse_number": "२२", "content_sanskrit": "यत्तु सम्मोहसंयुक्तमव्यक्तविषयं भवेत् ।\nअप्रतर्क्यमविज्ञेयं तमस्तदुपधार्यताम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2189851, "chapter_id": 5033, "verse_number": "२३", "content_sanskrit": "प्रहर्षः प्रीतिरानन्दः साम्यं स्वस्थात्मचित्तता ।\nअकस्माद् यदि वा कस्माद्वर्तते सात्त्विको गुणः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2189852, "chapter_id": 5033, "verse_number": "२४", "content_sanskrit": "अभिमानो मृषावादो लोभो मोहस्तथाक्षमा ।\nलिङ्गानि रजसस्तानि वर्तन्ते हेत्वहेतुतः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2189853, "chapter_id": 5033, "verse_number": "२५", "content_sanskrit": "तथा मोहः प्रमादश्च तन्द्री निद्राप्रबोधिता ।\nकथञ्चिदभिवर्तन्ते विज्ञेयास्तामसा गुणाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2189854, "chapter_id": 5033, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे द्व्यशीतितमोऽध्यायः ॥८२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]