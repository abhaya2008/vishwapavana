[{"id": 2207179, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207180, "chapter_id": 5416, "verse_number": "१", "content_sanskrit": "एवमेतद् ब्रह्मबलं गरीयो\nन ब्रह्मतः किञ्चिदन्यद् गरीयः ।\nआविक्षितस्येह बलं न मृष्ये\nवज्रमस्मै प्रहरिष्यामि घोरम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207181, "chapter_id": 5416, "verse_number": "२", "content_sanskrit": "धृतराष्ट्र गच्छ प्रहितो मरुत्तं\nसंवर्तेन सहितं तं वदस्व ।\nबृहस्पतिं त्वमुपशिक्षस्व राजन्\nवज्रं वा ते प्रहरिष्यामि घोरम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207182, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207183, "chapter_id": 5416, "verse_number": "३", "content_sanskrit": "ततो गत्वा धृतराष्ट्रो नरेन्द्रं\nप्रोवाचेदं वचनाद् वासवस्य\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207184, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207185, "chapter_id": 5416, "verse_number": "४", "content_sanskrit": "गन्धर्वं मां धृतराष्ट्रं निबोध\nत्वामागतं वक्तुकामं नरेन्द्र ।\nऐन्द्रं वाक्यं शृणु मे राजसिंह\nयत्प्राह लोकाधिपतिर्महात्मा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207186, "chapter_id": 5416, "verse_number": "५", "content_sanskrit": "बृहस्पतिं याजकं त्वं वृणीष्व\nवज्रं वा ते प्रहरिष्यामि घोरम् ।\nवचश्चेदेतन्न करिष्यसे मे\nप्राहैतदेतावदचिन्त्यकर्मा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207187, "chapter_id": 5416, "verse_number": "६", "content_sanskrit": "बृहस्पतिं याजयितुं न चेच्छेद्\nवज्रं तस्मै प्रहरिष्यामि घोरम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207188, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207189, "chapter_id": 5416, "verse_number": "७", "content_sanskrit": "त्वं चैव तद्वेत्थ पुरुहूतश्च साध्या\nविश्वे देवा वसवश्चाश्विनौ च ।\nमित्रद्रोहे निष्कृतिर्वै यथेह\nनास्तीति लोकेषु सदैव वादः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207190, "chapter_id": 5416, "verse_number": "८", "content_sanskrit": "बृहस्पतिर्याजयिता महेन्द्रं\nदेवं श्रेष्ठं वज्रभृतां वरिष्टम् ।\nसंवर्तो मां याजयिताऽद्य राजन्\nन ते वाक्यं तस्य वा रोचयामि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207191, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207192, "chapter_id": 5416, "verse_number": "९", "content_sanskrit": "घोरो नादः श्रूयते वासवस्य\nनभस्थले गर्जतो राजसिंह ।\nव्यक्तं वज्रं मोक्ष्यते ते महेन्द्रः\nक्षेमं राजंश्चिन्त्यतामेष कालः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207193, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207194, "chapter_id": 5416, "verse_number": "१०", "content_sanskrit": "इत्येवमुक्तो धृतराष्ट्रेण राजन्\nश्रुत्वा नादं नदतो वासवस्य ।\nतपोनित्यं ब्रह्मविदां वरिष्ठं\nसंवर्तं तं ज्ञापयामास कार्यम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207195, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207196, "chapter_id": 5416, "verse_number": "११", "content_sanskrit": "यस्यात्मानं प्लवमानं त्वमाराद्\nअदूरतो देवराजं त्वमद्य ।\nप्रपद्येऽहं शर्म विप्रेन्द्र भूयः\nप्रयच्छ तस्मादभयं विप्रमुख्य\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207197, "chapter_id": 5416, "verse_number": "१२", "content_sanskrit": "अयमायाति वै वज्री दिशो विद्योतयन् दश ।\nअमानुषेण नादेन सदस्यान् भीषयन्निव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207198, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "संवर्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207199, "chapter_id": 5416, "verse_number": "१३", "content_sanskrit": "भयं शक्राद् व्येतु ते राजसिंह\nप्रणोत्स्येऽहं भयमेतत् सुघोरम् ।\nसंस्तम्भिन्या विद्यया वज्रमेव\nमा भैस्त्वमस्माद् भव चापि प्रतीतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207200, "chapter_id": 5416, "verse_number": "१४", "content_sanskrit": "अहं संस्तम्भयिष्यामि मा भैस्त्वं शक्रतो नृप ।\nसर्वेषामेव देवानां क्षपितान्यायुधानि मे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207201, "chapter_id": 5416, "verse_number": "१५", "content_sanskrit": "दिशो वज्रं व्रजताद् वायुरेतु\nवर्षं भूत्वा वर्षतात् काननेषु ।\nआपः प्लवन्त्वन्तरिक्षाद् दृढा च\nसौदामिनी विद्यते मा बिभेस्त्वम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207202, "chapter_id": 5416, "verse_number": "१६", "content_sanskrit": "अधो वह्निस्त्रातु वा सर्वशस्ते\nकामाद् वर्षं वर्षतु कामतो वा ।\nवज्रं तथा स्थापयिता च वायुः\nमहाघोरं प्लवमानं जलौघैः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207203, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207204, "chapter_id": 5416, "verse_number": "१७", "content_sanskrit": "घोरः शब्दः श्रूयते वै महास्वनो\nवज्रस्यैष संहितो मारुतेन ।\nआत्माऽपि मे प्रव्यथते मुहुर्मुहुः\nन मे स्वास्थ्यं जायते ह्यद्य विप्र\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207205, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "संवर्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207206, "chapter_id": 5416, "verse_number": "१८", "content_sanskrit": "वज्रादुग्राद् व्येतु भयं तवाद्य\nवातो भूत्वा हन्मि नरेन्द्र वज्रम् ।\nभयं त्यक्त्वा वरमन्यं वृणीष्व\nकं ते कामं तपसा योजयामि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207207, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207208, "chapter_id": 5416, "verse_number": "१९", "content_sanskrit": "इन्द्रः साक्षात् सहसाऽभ्येतु विप्र\nहविर्विद्वन् प्रतिगृह्णातु चैव ।\nस्वं स्वं हविश्चैव जुषन्तु देवाः\nसुतं सोमं प्रतिगृह्णन्तु चैव\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207209, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "संवर्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207210, "chapter_id": 5416, "verse_number": "२०", "content_sanskrit": "अयमिन्द्रो हरिभिर्याति राजन्\nदेवैः सर्वैः सहितैः सोमपीथी ।\nमन्त्राहूतो यज्ञमिमं मयाऽद्य\nपश्यस्वैनं मन्त्रवित्रस्तकायम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207211, "chapter_id": 5416, "verse_number": "२१", "content_sanskrit": "ततो देवैः सहितो देवराजो\nरथे युक्त्वा तान् हरीन् वाजिमुख्यान् ।\nआयाद्यज्ञमथ राज्ञः पिपासुः\nआविक्षितस्याप्रमेयस्य सोमम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207212, "chapter_id": 5416, "verse_number": "२२", "content_sanskrit": "तमायान्तं सहितं देवसङ्घैः\nप्रत्युद्ययौ सपुरोधा मरुत्तः ।\nचक्रे पूजां देवराजाय चाग्र्यां\nयथाशास्त्रं विधिवत् प्रीयमाणः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207213, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "संवर्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2207214, "chapter_id": 5416, "verse_number": "२३", "content_sanskrit": "सुस्वागतं ते पुरुहूतेह विद्वन्\nयज्ञोऽप्ययं सन्निहिते त्वयीन्द्र ।\nशोशुभ्यते बलवृत्रघ्न भूयः\nपिबस्व सोमं सुखमुद्यतं मया\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2207215, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "मरुत्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2207216, "chapter_id": 5416, "verse_number": "२४", "content_sanskrit": "शिवेन मां पश्य नमश्च तेऽस्तु\nप्राप्तो यज्ञः सफलं जीवितं मे ।\nअयं यज्ञं कुरुते मे सुरेन्द्र\nबृहस्पतेरवरो जन्मना च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2207217, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2207218, "chapter_id": 5416, "verse_number": "२५", "content_sanskrit": "जानामि ते गुरुमेतं तपोधनं\nबृहस्पतेरनुजं तिग्मतेजसम् ।\nयस्याह्वानादागतोऽहं नरेन्द्र\nप्रीतिर्मेऽद्य त्वयि मन्युः प्रणष्टः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2207219, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "संवर्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2207220, "chapter_id": 5416, "verse_number": "२६", "content_sanskrit": "यदि प्रीतस्त्वमसि वै देवराज\nतस्मात् स्वयं शाधि यज्ञे विधानम् ।\nस्वयं सर्वान् कुरु मार्गान् सुरेन्द्र\nजानात्वयं सर्वलोकश्च देव\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2207221, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2207222, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "एवमुक्तस्त्वाङ्गिरसेन शक्रः\nस व्यादिदेश स्वयमेव देवान्\t॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2207223, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2207224, "chapter_id": 5416, "verse_number": "२७", "content_sanskrit": "सभाः क्रियन्तामावसथाश्च मुख्याः\nसहस्रशश्चित्रभौमाः समृद्धाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2207225, "chapter_id": 5416, "verse_number": "२८", "content_sanskrit": "क्लृप्ताः स्थूणाः कुरुतारोहणानि\nगन्धर्वाणामप्सरसां च शीघ्रम् ।\nयेषु नृत्यन्त्यप्सरसः सहस्रशः\nस्वर्गोद्देशः क्रियतां यज्ञवाटः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2207226, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2207227, "chapter_id": 5416, "verse_number": "२९", "content_sanskrit": "इत्युक्तास्ते चक्रुराशु प्रतीता\nदिवौकसः शक्रवाक्यान्नरेन्द्र ।\nततो वाक्यं प्राह राजानमिन्द्रः\nप्रीतो राजन् पूजयानो मरुत्तम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2207228, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2207229, "chapter_id": 5416, "verse_number": "३०", "content_sanskrit": "एष त्वाऽहमिह राजन् समेत्य\nये चाप्यन्ये तव पूर्वे नरेन्द्राः ।\nसर्वाश्चान्या देवताः प्रीयमाणा\nहविस्त्वत्तः प्रतिगृह्णन्तु राजन्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2207230, "chapter_id": 5416, "verse_number": "३१", "content_sanskrit": "आग्नेयं वै लोहितमालभन्तां\nवैश्वदेवं बहुरूपं च राजन् ।\nनीलं चोक्षाणं मेध्यमद्यालभन्तां\nविलोभ्य च्छित्वा मत्प्रतिष्ठां द्विजेन्द्राः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2207231, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2207232, "chapter_id": 5416, "verse_number": "३२", "content_sanskrit": "ततो यज्ञो ववृधे तस्य राज्ञो\nयत्र देवाः स्वयमन्नानि जह्रुः ।\nयस्मिन् शक्रो ब्राह्मणैः पूज्यमानः\nसदस्योऽभूद्धरिवान् देवराजः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2207233, "chapter_id": 5416, "verse_number": "३३", "content_sanskrit": "ततः संवर्तश्चैत्यगतो महात्मा\nयथा वह्निः प्रज्वलितो द्वितीयः ।\nहवींष्युच्चैराह्वयन् देवसङ्घान्\nजुहावाग्नौ मन्त्रवत् सुप्रणीते\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2207234, "chapter_id": 5416, "verse_number": "३४", "content_sanskrit": "ततः पीत्वा बलभित् सोममग्र्यं\nये चाप्यन्ये सोमपा वै दिवौकसः ।\nसर्वेऽनुज्ञाताः प्रययुः पार्थिवेन\nतथाजोषं तर्पिताः प्रीयमाणाः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2207235, "chapter_id": 5416, "verse_number": "३५", "content_sanskrit": "ततो राजा जातरूपस्य राशिं\nपदे पदे कारयामास हृष्टः ।\nद्विजातिभ्यो विसृजन् भूरि वित्तं\nरराज वित्तेश इवारिहन्ता\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2207236, "chapter_id": 5416, "verse_number": "३६", "content_sanskrit": "ततो वित्तं विधिवत् सन्निधाय\nयथोत्साहं कारयित्वा च कोशम् ।\nअनुज्ञातो गुरुणा सन्निवृत्त्यं\nशशास गामखिलां सागरान्ताम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2207237, "chapter_id": 5416, "verse_number": "३७", "content_sanskrit": "एवङ्गुणः सम्बभूवेह राजा\nयस्य क्रतौ तत् सुवर्णं प्रभूतम् ।\nतत् त्वं समादाय नरेन्द्र वित्तं\nयजस्व देवांस्तपनीयैर्विधानैः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2207238, "chapter_id": 5416, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2207239, "chapter_id": 5416, "verse_number": "३८", "content_sanskrit": "ततो राजा पाण्डवो हृष्टरूपः\nश्रुत्वा वाक्यं सत्यवत्याः सुतस्य ।\nमनश्चक्रे तेन वित्तेन यष्टुं\nततोऽमात्यैर्मन्त्रयामास भूयः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2207240, "chapter_id": 5416, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् आश्वमेधिकपर्वणि वित्तानयनोपायकथनं नाम दशमोऽध्यायः ॥१०॥\nअश्वमेधपर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]