[{"id": 2139838, "chapter_id": 4019, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2139839, "chapter_id": 4019, "verse_number": "१", "content_sanskrit": "ते दृष्ट्वा निहतान् सूतान् गत्वा राज्ञे न्यवेदयन् ।\nगन्धर्वैर्निहतान् राजन् सूताः पञ्चाधिकाः शताः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2139840, "chapter_id": 4019, "verse_number": "", "content_sanskrit": "पौराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2139841, "chapter_id": 4019, "verse_number": "२", "content_sanskrit": "यथा वज्रेण वै भिन्नं पर्वतस्य महच्छिरः ।\nविनिकीर्णाः प्रदृश्यन्ते तथा सूता महीतळे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2139842, "chapter_id": 4019, "verse_number": "३", "content_sanskrit": "सैरन्ध्री चापि मुक्ता सा पुनरायाति ते गृहम् ।\nसर्वं संशयितं राजन् नगरं ते भविष्यति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2139843, "chapter_id": 4019, "verse_number": "४", "content_sanskrit": "तथारूपा च सैरन्ध्री गन्धर्वाश्च महाबलाः ।\nपुंसामिष्टश्च विषयो मैथुनाय न संशयः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2139844, "chapter_id": 4019, "verse_number": "५", "content_sanskrit": "यथा सैरन्ध्रिवेषेण नेदं राजन् पुरं तव ।\nविनाशमेति वै क्षिप्रं तथा नीतिर्विधीयताम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2139845, "chapter_id": 4019, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2139846, "chapter_id": 4019, "verse_number": "६", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा विराटो वाहिनीपतिः ।\nअब्रवीत् क्रियतामेषां सूतानां चरमक्रिया\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2139847, "chapter_id": 4019, "verse_number": "७", "content_sanskrit": "एकस्मिन्नेव ते सर्वे सुसमिद्धे हुताशने ।\nदह्यन्तां कीचकाः सर्वे सर्वगन्धैश्च सर्वशः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2139848, "chapter_id": 4019, "verse_number": "८", "content_sanskrit": "सुदेष्णां चाब्रवीद् राजा महिषीं जातसाध्वसः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2139849, "chapter_id": 4019, "verse_number": "९", "content_sanskrit": "सैरन्ध्रीमागतां ब्रूया ममैव वचनादिह ।\nगच्छ सैरन्ध्रि भद्रं ते यथाकामं वरानने\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2139850, "chapter_id": 4019, "verse_number": "१०", "content_sanskrit": "बिभेति राजा सुश्रोणि गन्धर्वेभ्यः पराभवात्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2139851, "chapter_id": 4019, "verse_number": "११", "content_sanskrit": "न हि तामुत्सहे वक्तुं स्वयं गन्धर्वरक्षिताम् ।\nस्त्रियास्त्वदोषस्तां वक्तुमतस्त्वां प्रब्रवीम्यहम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2139852, "chapter_id": 4019, "verse_number": "१२", "content_sanskrit": "अथ मुक्ता भयात् कृष्णा सूतपुत्रान् निरस्य तु ।\nमोक्षिता भीमसेनेन जगाम नगरं प्रति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2139853, "chapter_id": 4019, "verse_number": "१३", "content_sanskrit": "त्रासितेव मृगी बाला शार्दूलेन मनस्विनी ।\nगात्राणि वाससी चैव प्रक्षाल्य प्रविवेश ह\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2139854, "chapter_id": 4019, "verse_number": "१४", "content_sanskrit": "तां दृष्ट्वा पुरुषा राजन् प्राद्रवन्ति दिशो दश ।\nगन्धर्वाणां भयत्रस्ताः केचिद् दृष्टी न्यमीलयन्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2139855, "chapter_id": 4019, "verse_number": "१५", "content_sanskrit": "ततो महानसद्वारे भीमसेनमवस्थितम् ।\nददर्श राजन् पाञ्चाली यथा मत्तं महाद्विपम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2139856, "chapter_id": 4019, "verse_number": "१६", "content_sanskrit": "सापहासं तु शनकैः सञ्ज्ञाभिरिदमब्रवीत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2139857, "chapter_id": 4019, "verse_number": "१७", "content_sanskrit": "नमो गन्धर्वराजाय येनास्मि परिमोक्षिता ।\nकीचकेभ्यो विनिर्दोषामनाथां वसतीं गृहे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2139858, "chapter_id": 4019, "verse_number": "१८", "content_sanskrit": "यो मां रक्षति सन्त्रस्तां गन्धर्वाय नमोऽस्तु ते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2139859, "chapter_id": 4019, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2139860, "chapter_id": 4019, "verse_number": "१९", "content_sanskrit": "ये पुरा पुरुषास्तुभ्यं भवन्ति वशवर्तिनः ।\nतेषां वशगता नित्यं विचर त्वं यथेष्टतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2139861, "chapter_id": 4019, "verse_number": "२०", "content_sanskrit": "ये यस्या विचरन्तीह पुरुषा वशवर्तिनः ।\nतस्यास्ते वचनं श्रुत्वा ह्यनृणा विहरन्त्युत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2139862, "chapter_id": 4019, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2139863, "chapter_id": 4019, "verse_number": "२१", "content_sanskrit": "तयोस्तद्वचनं श्रुत्वा जज्ञिरे नेतरे जनाः ।\nततः पाञ्चालराजस्य सुता चापि जगाम ह\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2139864, "chapter_id": 4019, "verse_number": "२२", "content_sanskrit": "ततः सा नर्तनागारे धनञ्जयमपश्यत ।\nराज्ञः कन्या विराटस्य नर्तयानं महाभुजम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2139865, "chapter_id": 4019, "verse_number": "२३", "content_sanskrit": "ततस्तां नर्तनागाराद् विनिष्क्रम्य सभाजनाः ।\nकन्या ददृशुरायान्तीं कृष्णां क्लिष्टामनागसीम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2139866, "chapter_id": 4019, "verse_number": "", "content_sanskrit": "कन्याः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2139867, "chapter_id": 4019, "verse_number": "२४", "content_sanskrit": "दिष्ट्या सैरन्ध्रि मुक्ताऽसि दिष्ट्याऽसि पुनरागता ।\nदिष्ट्या च निहताः सूता ये त्वां क्लिश्यन्त्यनागसीम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2139868, "chapter_id": 4019, "verse_number": "", "content_sanskrit": "बृहन्नळा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2139869, "chapter_id": 4019, "verse_number": "२५", "content_sanskrit": "कथं सैरन्ध्रि मुक्ताऽसि कथं पापाश्च ते हताः ।\nइच्छामि ते कथां श्रोतुं कथयस्व यथातथम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2139870, "chapter_id": 4019, "verse_number": "", "content_sanskrit": "सैरन्ध्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2139871, "chapter_id": 4019, "verse_number": "२६", "content_sanskrit": "बृहन्नळे किं नु तव सैरन्ध्य्रा कार्यमद्य वै ।\nया त्वं वससि कल्याणि सदा कन्यापुरे सुखम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2139872, "chapter_id": 4019, "verse_number": "२७", "content_sanskrit": "न हि तद् दुःखमाप्नोषि सैरन्ध्री यद् दुःखमाप्नुते ।\nतेन मां दुःखितामेवं पृच्छसे प्रहसन्निव\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2139873, "chapter_id": 4019, "verse_number": "", "content_sanskrit": "बृहन्नळा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2139874, "chapter_id": 4019, "verse_number": "२८", "content_sanskrit": "बृहन्नळाऽपि कल्याणि दुःखमाप्नोत्यनन्तकम् ।\nतिर्यग्योनिं गतां बाले न चैनामवबुद्ध्यसे\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2139875, "chapter_id": 4019, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2139876, "chapter_id": 4019, "verse_number": "२९", "content_sanskrit": "ततः सहैव कन्याभिर्द्रौपदी राजवेश्म तत् ।\nप्रविवेश सुदेष्णायाः समीपमुपगामिनी\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2139877, "chapter_id": 4019, "verse_number": "३०", "content_sanskrit": "तामब्रवीद् राजपत्नी विराटवचनादिदम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2139878, "chapter_id": 4019, "verse_number": "३१", "content_sanskrit": "सैरन्ध्रि गम्यतां शीघ्रं यत्र कामयसे गतिम् ।\nराजा बिभेति सैरन्ध्रि गन्धर्वेभ्यः पराभवात्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2139879, "chapter_id": 4019, "verse_number": "३२", "content_sanskrit": "त्वं चापि तरुणी सुभ्रू रूपेणाप्रतिमा भुवि ।\nचित्तानि न नृणां शुभ्रे रक्तानि स्पर्शजे सुखे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2139880, "chapter_id": 4019, "verse_number": "३३", "content_sanskrit": "तस्मात् त्वत्तो भयं मह्यं राष्ट्रस्य नगरस्य च ।\nगच्छाद्यैव यथेष्टं त्वं नगराद् यत्र रंस्यसे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2139881, "chapter_id": 4019, "verse_number": "३४", "content_sanskrit": "त्वन्निमित्ते शुभे मह्यं सर्वो बन्धुजनो हतः ।\nनृशंसा खलु ते बुद्धिर्भ्रातॄणां मे कृतो वधः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2139882, "chapter_id": 4019, "verse_number": "३५", "content_sanskrit": "तस्माद् गन्धर्वराजेभ्यो भयमत्र प्रवर्तते ।\nयथेष्टं गच्छ सैरन्ध्रि इह स्वस्ति यथा भवेत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2139883, "chapter_id": 4019, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2139884, "chapter_id": 4019, "verse_number": "३६", "content_sanskrit": "सुदेष्णावचनं श्रुत्वा सैरन्ध्री चेदमब्रवीत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2139885, "chapter_id": 4019, "verse_number": "३७", "content_sanskrit": "त्रयोदशाहमात्रं तु राजा क्षाम्यतु भामिनि ।\nकृतकृत्या भविष्यन्ति गन्धर्वास्ते न संशयः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2139886, "chapter_id": 4019, "verse_number": "३८", "content_sanskrit": "ततो मामुपनेष्यन्ति करिष्यन्ति तव प्रियम् ।\nध्रुवं च श्रेयसा राजा योक्ष्यते सह बान्धवैः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2139887, "chapter_id": 4019, "verse_number": "३९", "content_sanskrit": "राज्ञा कृतोपकारास्तु कृतज्ञास्तु सदा शुभे ।\nसाधवश्च बलोत्सिक्ताः कृतप्रतिकृतेप्सवः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2139888, "chapter_id": 4019, "verse_number": "४०", "content_sanskrit": "अर्थिनी मां ब्रवीत्येषा यद्वा तद्वेति चिन्तय ।\nभरस्व तदहर्मात्रं ततः श्रेयो भविष्यति\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2139889, "chapter_id": 4019, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2139890, "chapter_id": 4019, "verse_number": "४१", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा कैकेयी दुःखमोहिता ।\nउवाच द्रौपदीमार्ता भ्रातृव्यसनकर्शिता\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2139891, "chapter_id": 4019, "verse_number": "४२", "content_sanskrit": "वस भद्रे यथेष्टं त्वं त्वामहं शरणं गता ।\nत्रायस्व मम भर्तारं पुत्रांश्चैव विशेषतः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2139892, "chapter_id": 4019, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि सप्तविंशोऽध्यायः ॥२७॥\nकीचकवधपर्वणि द्वादशोऽध्यायः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2139893, "chapter_id": 4019, "verse_number": "", "content_sanskrit": "॥ समाप्तं कीचकवधपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2139894, "chapter_id": 4019, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]