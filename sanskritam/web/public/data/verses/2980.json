[{"id": 2092958, "chapter_id": 2980, "verse_number": "१३-११०-१", "content_sanskrit": "युधिष्ठिर उवाच।\nविस्रम्भितोऽहं भवता धर्मान्प्रवदता विभो।\nप्रवक्ष्यामि तु संदेहं तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092959, "chapter_id": 2980, "verse_number": "१३-११०-२", "content_sanskrit": "व्रतानां किं फलं प्रोक्तं कीदृशं वा महाद्युते।\nनियमानां फलं किं च स्वधीतस्य च किं फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092960, "chapter_id": 2980, "verse_number": "१३-११०-३", "content_sanskrit": "दमस्येह फलं किं च वेदानां धारणे च किम्।\nअध्यापने फलं किं च सर्वमिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092961, "chapter_id": 2980, "verse_number": "१३-११०-४", "content_sanskrit": "अप्रतिग्राहके किं च फलं लोके पितामह।\nतस्य किञ्च फलं दृष्टं श्रुतं यस्तु प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092962, "chapter_id": 2980, "verse_number": "१३-११०-५", "content_sanskrit": "स्वकर्मनिरतानां च शूराणां चापि किं फलम्।\nसत्ये च किं फलं प्रोक्तं ब्रह्मचर्ये च किं फलम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092963, "chapter_id": 2980, "verse_number": "१३-११०-६", "content_sanskrit": "पितृशुश्रूषणे किञ्च मातृशुश्रूषणे तथा।\nआचार्यगुरुशुश्रूषा स्वनुक्रोशानुकम्पने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092964, "chapter_id": 2980, "verse_number": "१३-११०-७", "content_sanskrit": "एतत्सर्वमशेषेण पितामह यथातथम्।\nवेतुमिच्छामि धर्मज्ञ परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092965, "chapter_id": 2980, "verse_number": "१३-११०-८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092966, "chapter_id": 2980, "verse_number": "१३-११०-८", "content_sanskrit": "यो व्रतं वै यथोद्दिष्टं तथा सम्प्रतिपद्यते।\nअखण्डं सम्यगारभ्य तस्य लोकाः सनातनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092967, "chapter_id": 2980, "verse_number": "१३-११०-९", "content_sanskrit": "नियमानां फलं राजन्प्रत्यक्षमिह दृश्यते।\nनियमानां क्रतूनां च त्वयाऽवाप्तमिदं फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092968, "chapter_id": 2980, "verse_number": "१३-११०-१०", "content_sanskrit": "स्वधीतस्यापि च फलं दृश्यतेऽमुत्र चेह च।\nइह लोकेऽर्थवान्नित्यं ब्रह्मलोके च मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092969, "chapter_id": 2980, "verse_number": "१३-११०-११", "content_sanskrit": "दमस्य तु फलं राजञ्शृणु त्वं विस्तरेण मे।\nदान्ताः सर्वत्र सुखिनो दान्ताः सर्वत्र निर्वृताः।\nयत्रेच्छागामिनो दान्ताः सर्वशत्रुनिषूदनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092970, "chapter_id": 2980, "verse_number": "१३-११०-१२", "content_sanskrit": "प्रार्थयन्ति च यद्दान्ता लभन्ते तन्न संशयः।\nयुज्यन्ते सर्वकामैर्हि दान्ताः सर्वत्र पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092971, "chapter_id": 2980, "verse_number": "१३-११०-१३", "content_sanskrit": "स्वर्गे यथा प्रमोदन्ते तपसा विक्रमेण च।\nदानैर्यज्ञैश्च विविधैस्तथा दान्ताः क्षमान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092972, "chapter_id": 2980, "verse_number": "१३-११०-१४", "content_sanskrit": "दानाद्दमो विशिष्टो हि ददत्किञ्चिद्द्विजातये।\nदाता कुप्यति नो दान्तस्तस्माद्दानात्परंदमः॥\nयस्तु दद्यादकुप्यन्हि तस्य लोकाः सनातनाः।\nक्रोधो हन्ति हि यद्दानं तस्माद्दानाद्वरो दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092973, "chapter_id": 2980, "verse_number": "१३-११०-१६", "content_sanskrit": "अदृश्यानि महाराज स्थानान्ययुतशो दिवि।\nऋषीणां सर्वलोकषु यानि ते यान्ति देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092974, "chapter_id": 2980, "verse_number": "१३-११०-१७", "content_sanskrit": "दमेन यानि नृपते गच्छन्ति परमर्षयः।\nकामयाना महत्स्थानं तस्माद्दानात्परं दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092975, "chapter_id": 2980, "verse_number": "१३-११०-१८", "content_sanskrit": "`विद्यादानाद्वरं नास्ति वेदविद्या महाफलाः।\nअध्यापकः परिक्लेशादक्षयं फलमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092976, "chapter_id": 2980, "verse_number": "१३-११०-१९", "content_sanskrit": "विधिवत्पावकं हुत्वा ब्रह्मलोके नराधिप।\nअधीत्यापि हि यो वेदान्न्यायविद्भ्यः प्रयच्छति।\nगुरुकर्मप्रशंसी तु सोपि स्वर्गे महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092977, "chapter_id": 2980, "verse_number": "१३-११०-२०", "content_sanskrit": "क्षत्रियोऽध्ययने युक्तो यजने दानकर्मणि।\nयुद्धे यश्च परित्राता सोपि स्वर्गे महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092978, "chapter_id": 2980, "verse_number": "१३-११०-२१", "content_sanskrit": "वैश्यः स्वकर्मनिरतः प्रदानाल्लभते महत्।\nशूद्रः स्वकर्मनिरतः स्वर्गं शुश्रूषयाऽऽर्च्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092979, "chapter_id": 2980, "verse_number": "१३-११०-२२", "content_sanskrit": "शूरा बहुविधाः प्रोक्तास्तेषामर्थास्तु मे शृणु।\nशूरान्वयानां निर्दिष्टं फलं शूरस्य चैव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2092980, "chapter_id": 2980, "verse_number": "१३-११०-२३", "content_sanskrit": "यज्ञशूरा दमे शूराः सत्यशूरास्तथा परे।\nयुद्धशूरास्तथैवोक्ता दानशूराश्च मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2092981, "chapter_id": 2980, "verse_number": "१३-११०-२४", "content_sanskrit": "`बुद्धिशूरास्तथैवान्ये क्षमाशूरास्तथा परे।\nसाङ्ख्यशूराश्च बहवो योगशूरास्तथा परे।\nअरण्ये गृहवासे च त्यागे शूरास्तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2092982, "chapter_id": 2980, "verse_number": "१३-११०-२५", "content_sanskrit": "आर्जवे च तथा शूराः शमे वर्तन्ति मानवाः।\nतैस्तैश्च नियमैः शूरा बहवः सन्ति चापरे।\nवेदाध्ययनशूराश्च शूराश्चाध्यापने रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2092983, "chapter_id": 2980, "verse_number": "१३-११०-२६", "content_sanskrit": "गुरुशुश्रूषया शूराः पितृशुश्रूषया परे।\nमातृशुश्रूषया शूरा भैक्ष्यशूरास्तथा परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2092984, "chapter_id": 2980, "verse_number": "१३-११०-२७", "content_sanskrit": "अरण्ये गृहवासे च शूराश्चातिथिपूजने।\nसर्वे यान्ति पराँल्लोकान्स्वकर्मफलनिर्जितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2092985, "chapter_id": 2980, "verse_number": "१३-११०-२८", "content_sanskrit": "धारणं सर्ववेदानां सर्वतीर्थावगाहनम्।\nसत्यं च ब्रुवतो नित्यं समं वा स्यान्नवा समम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2092986, "chapter_id": 2980, "verse_number": "१३-११०-२९", "content_sanskrit": "अश्वमेधसहस्रं च सत्यं च तुलया धृतम्।\nअश्वमेधसहस्राद्धि सत्यमेव विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2092987, "chapter_id": 2980, "verse_number": "१३-११०-३०", "content_sanskrit": "सत्येन सूर्यस्तपति सत्येनाग्निः प्रदीप्यते।\nसत्येन मरुतो वान्ति सर्वं सत्ये प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2092988, "chapter_id": 2980, "verse_number": "१३-११०-३१", "content_sanskrit": "सत्येन देवाः प्रीयन्ते पितरो ब्राह्मणास्तथा।\nसत्यमाहुः परो धर्मस्तस्मात्सत्यं न लोपयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2092989, "chapter_id": 2980, "verse_number": "१३-११०-३२", "content_sanskrit": "मुनयः सत्यनिरता मुनयः सत्यविक्रमाः।\nमुनयः सत्यशपथास्तस्मात्सत्यं विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2092990, "chapter_id": 2980, "verse_number": "१३-११०-३३", "content_sanskrit": "सत्यवन्तः सत्यलोके मोदन्ते भरतर्षभ।\nदमः सत्यफलावाप्तिरुक्ता सर्वात्मना मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2092991, "chapter_id": 2980, "verse_number": "१३-११०-३४", "content_sanskrit": "असंशयं विनीतात्मा स वै स्वर्गे महीयते।\nब्रह्मचर्यस्य च गुणं शृणु त्वं वसुधाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2092992, "chapter_id": 2980, "verse_number": "१३-११०-३५", "content_sanskrit": "आजन्ममरणाद्यस्तु ब्रह्मचारी भवेदिह।\nन तस्य किञ्चिदप्राप्यमिति विद्धि नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2092993, "chapter_id": 2980, "verse_number": "१३-११०-३६", "content_sanskrit": "बह्व्यः कोट्यस्त्वषीणां तु ब्रह्मलोके वसन्त्युत\nसत्ये रतानां सततं दान्तानामूर्ध्वरेतसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2092994, "chapter_id": 2980, "verse_number": "१३-११०-३७", "content_sanskrit": "ब्रह्मचर्यं दहेद्राजन्सर्वपापान्युपासितम्।\nब्राह्मणेन विशेषेण ब्राह्ममो ह्यग्निरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2092995, "chapter_id": 2980, "verse_number": "१३-११०-३८", "content_sanskrit": "प्रत्यक्षं हि तथा ह्येतद्ब्राह्मणेषु तपस्विषु।\nबिभेति हि यथा शक्रो ब्रह्मचारिप्रधर्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2092996, "chapter_id": 2980, "verse_number": "१३-११०-३९", "content_sanskrit": "तद्ब्रह्मचर्यस्य फलमृषीणामिह दृश्यते।\nमातापित्रोः पूजने यो धर्मस्तमपि मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2092997, "chapter_id": 2980, "verse_number": "१३-११०-४०", "content_sanskrit": "शुश्रूषते यः पितरं न चासूयेत्कदाचन।\nमातरं भ्रातरं वाऽपि गुरुमाचार्यमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2092998, "chapter_id": 2980, "verse_number": "१३-११०-४१", "content_sanskrit": "तस्य राजन्फलं विद्धि स्वर्लोके स्थानमर्चितम्।\nन च पश्येत नरकं गुरुशुश्रूषयाऽऽत्मवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2092999, "chapter_id": 2980, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि दशाधिकशततमोऽध्यायः॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]