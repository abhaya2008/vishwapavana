[{"id": 5000108000, "chapter_id": 9108, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे एकत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000108001, "chapter_id": 9108, "verse_number": "२-३१-१", "content_sanskrit": "एवं श्रुत्वा स संवादं लक्ष्मणः पूर्वमागतः।\nबाष्पपर्याकुलमुखः शोकं सोढुमशक्नुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000108002, "chapter_id": 9108, "verse_number": "२-३१-२", "content_sanskrit": "स भ्रातुश्चरणौ गाढं निपीड्य रघुनन्दनः।\nसीतामुवाचातियशां राघवं च महाव्रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000108003, "chapter_id": 9108, "verse_number": "२-३१-३", "content_sanskrit": "यदि गन्तुं कृता बुद्धिर्वनं मृगगजायुतम्।\nअहं त्वानुगमिष्यामि वनमग्रे धनुर्धरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000108004, "chapter_id": 9108, "verse_number": "२-३१-४", "content_sanskrit": "मया समेतोऽरण्यानि रम्याणि विचरिष्यसि।\nपक्षिभिर्मृगयूथैश्च संघुष्टानि समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000108005, "chapter_id": 9108, "verse_number": "२-३१-५", "content_sanskrit": "न देवलोकाक्रमणं नामरत्वमहं वृणे।\nऐश्वर्यं चापि लोकानां कामये न त्वया विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000108006, "chapter_id": 9108, "verse_number": "२-३१-६", "content_sanskrit": "एवं ब्रुवाणः सौमित्रिर्वनवासाय निश्चितः।\nरामेण बहुभिः सान्त्वैर्निषिद्धः पुनरब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000108007, "chapter_id": 9108, "verse_number": "२-३१-७", "content_sanskrit": "अनुज्ञातस्तु भवता पूर्वमेव यदस्म्यहम्।\nकिमिदानीं पुनरपि क्रियते मे निवारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000108008, "chapter_id": 9108, "verse_number": "२-३१-८", "content_sanskrit": "यदर्थं प्रतिषेधो मे क्रियते गन्तुमिच्छतः।\nएतदिच्छामि विज्ञातुं संशयो हि ममानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000108009, "chapter_id": 9108, "verse_number": "२-३१-९", "content_sanskrit": "ततोऽब्रवीन्महातेजा रामो लक्ष्मणमग्रतः।\nस्थितं प्राग्गामिनं धीरं याचमानं कृताञ्जलिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000108010, "chapter_id": 9108, "verse_number": "२-३१-१०", "content_sanskrit": "स्निग्धो धर्मरतो धीरः सततं सत्पथे स्थितः।\nप्रियः प्राणसमो वश्यो विजेयश्च सखा च मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000108011, "chapter_id": 9108, "verse_number": "२-३१-११", "content_sanskrit": "मयाद्य सह सौमित्रे त्वयि गच्छति तद्वनम्।\nको भजिष्यति कौसल्यां सुमित्रां वा यशस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000108012, "chapter_id": 9108, "verse_number": "२-३१-१२", "content_sanskrit": "अभिवर्षति कामैर्यः पर्जन्यः पृथिवीमिव।\nस कामपाशपर्यस्तो महातेजा महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000108013, "chapter_id": 9108, "verse_number": "२-३१-१३", "content_sanskrit": "सा हि राज्यमिदं प्राप्य नृपस्याश्वपतेः सुता।\nदुःखितानां सपत्नीनां न करिष्यति शोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000108014, "chapter_id": 9108, "verse_number": "२-३१-१४", "content_sanskrit": "न भरिष्यति कौसल्यां सुमित्रां च सुदुःखिताम्।\nभरतो राज्यमासाद्य कैकेय्यां पर्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000108015, "chapter_id": 9108, "verse_number": "२-३१-१५", "content_sanskrit": "तामार्यां स्वयमेवेह राजानुग्रहणेन वा।\nसौमित्रे भर कौसल्यामुक्तमर्थममुं चर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000108016, "chapter_id": 9108, "verse_number": "२-३१-१६", "content_sanskrit": "एवं मयि च ते भक्तिर्भविष्यति सुदर्शिता।\nधर्मज्ञगुरुपूजायां धर्मश्चाप्यतुलो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000108017, "chapter_id": 9108, "verse_number": "२-३१-१७", "content_sanskrit": "एवं कुरुष्व सौमित्रे मत्कृते रघुनन्दन।\nअस्माभिर्विप्रहीणाया मातुर्नो न भवेत् सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000108018, "chapter_id": 9108, "verse_number": "२-३१-१८", "content_sanskrit": "एवमुक्तस्तु रामेण लक्ष्मणः श्लक्ष्णया गिरा।\nप्रत्युवाच तदा रामं वाक्यज्ञो वाक्यकोविदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000108019, "chapter_id": 9108, "verse_number": "२-३१-१९", "content_sanskrit": "तवैव तेजसा वीर भरतः पूजयिष्यति।\nकौसल्यां च सुमित्रां च प्रयतो नास्ति संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000108020, "chapter_id": 9108, "verse_number": "२-३१-२०", "content_sanskrit": "यदि दुःस्थो न रक्षेत भरतो राज्यमुत्तमम्।\nप्राप्य दुर्मनसा वीर गर्वेण च विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000108021, "chapter_id": 9108, "verse_number": "२-३१-२१", "content_sanskrit": "तमहं दुर्मतिं क्रूरं वधिष्यामि न संशयः।\nतत्पक्षानपि तान् सर्वांस्त्रैलोक्यमपि किं तु सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000108022, "chapter_id": 9108, "verse_number": "२-३१-२२", "content_sanskrit": "कौसल्या बिभृयादार्या सहस्रं मद्विधानपि।\nयस्याः सहस्रं ग्रामाणां सम्प्राप्तमुपजीविनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000108023, "chapter_id": 9108, "verse_number": "२-३१-२३", "content_sanskrit": "तदात्मभरणे चैव मम मातुस्तथैव च।\nपर्याप्ता मद्विधानां च भरणाय मनस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000108024, "chapter_id": 9108, "verse_number": "२-३१-२४", "content_sanskrit": "कुरुष्व मामनुचरं वैधर्म्यं नेह विद्यते।\nकृतार्थोऽहं भविष्यामि तव चार्थः प्रकल्प्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000108025, "chapter_id": 9108, "verse_number": "२-३१-२५", "content_sanskrit": "धनुरादाय सगुणं खनित्रपिटकाधरः।\nअग्रतस्ते गमिष्यामि पन्थानं तव दर्शयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000108026, "chapter_id": 9108, "verse_number": "२-३१-२६", "content_sanskrit": "आहरिष्यामि ते नित्यं मूलानि च फलानि च।\nवन्यानि च तथान्यानि स्वाहार्हाणि तपस्विनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000108027, "chapter_id": 9108, "verse_number": "२-३१-२७", "content_sanskrit": "भवांस्तु सह वैदेह्या गिरिसानुषु रंस्यसे।\nअहं सर्वं करिष्यामि जाग्रतः स्वपतश्च ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000108028, "chapter_id": 9108, "verse_number": "२-३१-२८", "content_sanskrit": "रामस्त्वनेन वाक्येन सुप्रीतः प्रत्युवाच तम्।\nव्रजापृच्छस्व सौमित्रे सर्वमेव सुहृज्जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000108029, "chapter_id": 9108, "verse_number": "२-३१-२९", "content_sanskrit": "ये च राज्ञो ददौ दिव्ये महात्मा वरुणः स्वयम्।\nजनकस्य महायज्ञे धनुषी रौद्रदर्शने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000108030, "chapter_id": 9108, "verse_number": "२-३१-३०", "content_sanskrit": "अभेद्ये कवचे दिव्ये तूणी चाक्षय्यसायकौ।\nआदित्यविमलाभौ द्वौ खड्गौ हेमपरिष्कृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000108031, "chapter_id": 9108, "verse_number": "२-३१-३१", "content_sanskrit": "सत्कृत्य निहितं सर्वमेतदाचार्यसद्मनि।\nसर्वमायुधमादाय क्षिप्रमाव्रज लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000108032, "chapter_id": 9108, "verse_number": "२-३१-३२", "content_sanskrit": "स सुहृज्जनमामन्त्र्य वनवासाय निश्चितः।\nइक्ष्वाकुगुरुमागम्य जग्राहायुधमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000108033, "chapter_id": 9108, "verse_number": "२-३१-३३", "content_sanskrit": "तद् दिव्यं राजशार्दूलः सत्कृतं माल्यभूषितम्।\nरामाय दर्शयामास सौमित्रिः सर्वमायुधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000108034, "chapter_id": 9108, "verse_number": "२-३१-३४", "content_sanskrit": "तमुवाचात्मवान् रामः प्रीत्या लक्ष्मणमागतम्।\nकाले त्वमागतः सौम्य कांक्षिते मम लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000108035, "chapter_id": 9108, "verse_number": "२-३१-३५", "content_sanskrit": "अहं प्रदातुमिच्छामि यदिदं मामकं धनम्।\nब्राह्मणेभ्यस्तपस्विभ्यस्त्वया सह परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000108036, "chapter_id": 9108, "verse_number": "२-३१-३६", "content_sanskrit": "वसन्तीह दृढं भक्त्या गुरुषु द्विजसत्तमाः।\nतेषामपि च मे भूयः सर्वेषां चोपजीविनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000108037, "chapter_id": 9108, "verse_number": "२-३१-३७", "content_sanskrit": "वसिष्ठपुत्रं तु सुयज्ञमार्यं\nत्वमानयाशु प्रवरं द्विजानाम्।\nअपि प्रयास्यामि वनं समस्ता-\nनभ्यर्च्य शिष्टानपरान् द्विजातीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000108038, "chapter_id": 9108, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे एकत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]