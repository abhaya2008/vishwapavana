[{"id": 2099059, "chapter_id": 3120, "verse_number": "१३-२५०-१", "content_sanskrit": "उमोवाच।\nपतिमत्या दिवारात्रं वृत्तान्तं श्रूयतां शुभम्।\nपत्युः पूर्वं समुत्थाय प्रातःक्रम समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2099060, "chapter_id": 3120, "verse_number": "१३-२५०-२", "content_sanskrit": "पत्युर्भावं विदित्वा तु पश्चात्सम्बोधयेत्तु तम्।\nनित्यं पौर्वाह्णिकं कार्यं स्वयं कुर्याद्यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2099061, "chapter_id": 3120, "verse_number": "१३-२५०-३", "content_sanskrit": "निवेद्य च तथाऽऽहारं यथा सम्पद्यतामिति।\nतथैव कुर्यात्तत्सर्वं यथा पत्युः प्रियं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2099062, "chapter_id": 3120, "verse_number": "१३-२५०-४", "content_sanskrit": "यथा भर्ता तथा नारी गुरूणां प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2099063, "chapter_id": 3120, "verse_number": "१३-२५०-५", "content_sanskrit": "शुश्रूषापोषणविधौ पतिप्रियचिकीर्षया।\nभर्तुर्निष्क्रमणे कार्यं संस्मरेदप्रमादतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2099064, "chapter_id": 3120, "verse_number": "१३-२५०-६", "content_sanskrit": "आगतं तु पतिं दृष्ट्वा सहसा परिचारणम्।\nस्वयं कुर्वीत सम्प्रीत्या कायश्रमहरं परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2099065, "chapter_id": 3120, "verse_number": "१३-२५०-७", "content_sanskrit": "पाद्यसनाभ्यां शयनैर्वाक्यैश्च हृदयप्रियैः।\nअतिथीनामागमेन प्रीतियुक्ता सदा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2099066, "chapter_id": 3120, "verse_number": "१३-२५०-८", "content_sanskrit": "कर्मणा वचनेनापि तोषयेदतिथीन्सदा।\nमङ्गलं गृहशौचं च सर्वोपकरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2099067, "chapter_id": 3120, "verse_number": "१३-२५०-९", "content_sanskrit": "सर्वकालमवेक्षेत कारयन्ती च कुर्वती।\nधर्मकार्ये तु सम्प्राप्ते तद्वद्धर्मपरा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2099068, "chapter_id": 3120, "verse_number": "१३-२५०-१०", "content_sanskrit": "अर्थकार्ये पुनर्भर्तुः प्रमादालस्यवर्जिता।\nसा यत्नं परमं कुर्यात्तस्यि साहाय्यकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2099069, "chapter_id": 3120, "verse_number": "१३-२५०-११", "content_sanskrit": "धुरन्धरा भवेद्भर्तुः साध्वी धर्मार्थयोः सदा।\nविहारकाले वै भर्तुर्ज्ञात्वा भावं हृदि स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2099070, "chapter_id": 3120, "verse_number": "१३-२५०-१२", "content_sanskrit": "अलङ्कृत्य यथायोगं मन्दहाससमन्वितम्।\nवाक्यैर्मधुरसंयुक्तैः स्मयन्ती तोषयेत्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2099071, "chapter_id": 3120, "verse_number": "१३-२५०-१३", "content_sanskrit": "कठोराणि न वाच्यानि अन्यथा प्रमदान्तरे।\nयस्यां कामी भवेद्भर्ता तस्याः प्रीतिकरी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2099072, "chapter_id": 3120, "verse_number": "१३-२५०-१४", "content_sanskrit": "अप्रमादं पुरस्कृत्य मनसा तोषयेत्पतिम्।\nअनन्तरमथान्येषां भोजनावेक्षणं चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2099073, "chapter_id": 3120, "verse_number": "१३-२५०-१५", "content_sanskrit": "दासीदासबलीवर्दांश्चण्डालं च शुनस्तथा।\nअनाथान्कृपणांश्चैव भिक्षुकांश्च तथैव च।\nपूजयेद्बलिभैक्षेण पत्युर्धर्मं विवर्धयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2099074, "chapter_id": 3120, "verse_number": "१३-२५०-१६", "content_sanskrit": "कुपितं वाऽर्थहीनं वा श्रान्तं वोपचरेत्पतिम्।\nयता स तुष्टः स्वस्थश्च तथा सन्तोषयेत्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2099075, "chapter_id": 3120, "verse_number": "१३-२५०-१७", "content_sanskrit": "यथा कुटुम्बचिन्तायां विवादे वाऽर्थसञ्चये।\nआहूता तत्सहायार्थं तथा प्रियहितं वदेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2099076, "chapter_id": 3120, "verse_number": "१३-२५०-१८", "content_sanskrit": "अप्रियं च हितं ब्रूयात्तस्य धर्मार्थकाङ्क्षया।\nएकान्तचर्याकथनं कलहं वर्जयेत्परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2099077, "chapter_id": 3120, "verse_number": "१३-२५०-१९", "content_sanskrit": "बहिरालोकनं चैव मोहं व्रीडां च पैशुनम्।\nबह्वाशित्वं दिवास्वप्नमेवमादि विवर्जयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2099078, "chapter_id": 3120, "verse_number": "१३-२५०-२०", "content_sanskrit": "रहस्येकासनं साध्वी न कुर्यादात्मजैरपि।\nयद्यद्दद्यान्नियत्स्वेति न्यासवत्परिपालयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2099079, "chapter_id": 3120, "verse_number": "१३-२५०-२१", "content_sanskrit": "विस्मृतं वाऽपि यद्द्रव्यं प्रतिपद्यात्स्वशौचतः।\nयत्किञ्चित्पतिना दत्तं लब्ध्वा तत्सा सुकी भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2099080, "chapter_id": 3120, "verse_number": "१३-२५०-२२", "content_sanskrit": "अतीवाज्ञामतीर्ष्यां च दूरतः परिवर्जयेत्।\nबालवद्वृद्धवद्भार्या सदैवानुचरेत्पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2099081, "chapter_id": 3120, "verse_number": "१३-२५०-२३", "content_sanskrit": "भार्याया व्रतमित्येव कर्तव्यं सततं विभो।\nएतत्पतिव्रतावृत्तमुक्तं देव समासतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2099082, "chapter_id": 3120, "verse_number": "१३-२५०-२४", "content_sanskrit": "न च भोगे न चैश्वर्ये न सुखे न धने तथा।\nस्पृहा यस्यास्तथा भर्तुः सा नारीणां पतिव्रता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2099083, "chapter_id": 3120, "verse_number": "१३-२५०-२५", "content_sanskrit": "पतिर्हि दैवतं स्त्रीणां पतिर्बन्धुः पतिर्गतिः।\nनान्यं गतिमहं पश्ये प्रमदाया यथा पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2099084, "chapter_id": 3120, "verse_number": "१३-२५०-२६", "content_sanskrit": "जातिष्वपि च वै स्त्रीत्वं विशिष्टं मे मतिः प्रभो।\nकायक्लेशेन महता पुरुषः प्राप्नुयात्फलम्।\nतत्सर्वं लभते नारी सुखेन पतिपूजया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2099085, "chapter_id": 3120, "verse_number": "१३-२५०-२७", "content_sanskrit": "यथासुखं पतिमती सर्वं पत्यनुकूलतः।\nईदृशं धर्मसाकल्यं पश्य त्वं प्रमदां प्रति।\nएतद्विसृज्य पच्यन्ते कुस्त्रियः पापमोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2099086, "chapter_id": 3120, "verse_number": "१३-२५०-२८", "content_sanskrit": "तपश्चर्या च दानं च पतौ तस्याः समर्पितम्।\nरूपं कुलं यशस्तेजः सर्वं तस्मिन्प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2099087, "chapter_id": 3120, "verse_number": "१३-२५०-२९", "content_sanskrit": "एवं व्रतसमाचाराः स्ववृत्तेनैव शोभनाः।\nस्वभर्त्रा च सम गच्छेत्पुण्यलोकान्सुकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2099088, "chapter_id": 3120, "verse_number": "१३-२५०-३०", "content_sanskrit": "वृद्धो विरुपो बीभत्सो धनवान्निर्धनोऽपि वा।\nएवंभूतोपि वै भर्ता स्त्रीणां भूषणमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2099089, "chapter_id": 3120, "verse_number": "१३-२५०-३१", "content_sanskrit": "आढ्यं वा रूपयुक्तं वा विरूपं धनवर्जितम्।\nया पतिं तोषयेत्साध्वी सा पत्नीनां विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2099090, "chapter_id": 3120, "verse_number": "१३-२५०-३२", "content_sanskrit": "दरिद्रांश्च विरूपाश्च प्रमूढान्कुष्टसंयुतान्।\nपतीनुपचरेल्लोकानक्षयान्प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2099091, "chapter_id": 3120, "verse_number": "१३-२५०-३३", "content_sanskrit": "एवं प्रवर्तमानायाः पतिः पूर्वं म्रियेत चेत्।\nतदाऽनुमरणं गच्छेत्पुनर्धर्मं चरेत वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2099092, "chapter_id": 3120, "verse_number": "१३-२५०-३४", "content_sanskrit": "एतदेवं मया प्रोक्तं स्त्रियस्तु बहुधा स्मृताः।\nदेवदानवगन्धर्वा मनुष्या इति नैकधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2099093, "chapter_id": 3120, "verse_number": "१३-२५०-३५", "content_sanskrit": "सौम्यशीलाः शुभाचाराः सर्वास्ताः सम्भवन्ति च।\nयथा शुभं प्रवक्ष्यामि स्त्रीणां धर्मं महेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2099094, "chapter_id": 3120, "verse_number": "१३-२५०-३६", "content_sanskrit": "आसुर्यश्चैव पैशाच्यो राक्षस्यश्च भन्ति हि।\nतासां वृत्तमशेषेण श्रूयतां लोककारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2099095, "chapter_id": 3120, "verse_number": "१३-२५०-३७", "content_sanskrit": "न्यायतो वाऽन्यथा प्रोक्ता भावदोषसमन्विताः।\nभर्तॄनुपचरन्त्येव रागद्वेषबलात्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2099096, "chapter_id": 3120, "verse_number": "१३-२५०-३८", "content_sanskrit": "स्वधर्मविमुखा भूत्वा प्रदूष्यन्ति यतस्ततः।\nप्रवृद्दविषया नित्यं प्रतिकूलं वदन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2099097, "chapter_id": 3120, "verse_number": "१३-२५०-३९", "content_sanskrit": "अर्थान्विनाशयन्त्येवं न गृह्णन्ति हितं क्वचित्।\nस्वबुद्धिनिरता भूत्वा जीवन्ति च यथा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2099098, "chapter_id": 3120, "verse_number": "१३-२५०-४०", "content_sanskrit": "गुणवत्यः क्वचिद्भूत्वा पतिधर्मपरा इव।\nपुनर्भवन्ति पापिष्ठा विषमं वृत्तमास्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2099099, "chapter_id": 3120, "verse_number": "१३-२५०-४१", "content_sanskrit": "अनवस्थितमर्यादा बहुवेषा व्यवस्थिताः।\nअसन्तुष्टाश्च लुब्धाश्च ईर्ष्याक्रोधयुता भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2099100, "chapter_id": 3120, "verse_number": "१३-२५०-४२", "content_sanskrit": "भोगप्रिया हितद्वेष्याः कामभोगपरायणाः।\nप्रायशोऽनृतभूयिष्ठा गुरूणां प्रतिलोमकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2099101, "chapter_id": 3120, "verse_number": "१३-२५०-४३", "content_sanskrit": "एवंवृत्तसमाचारा आसुरं भावमाश्रिताः।\nअपकारपरा नित्यं सततं कलहप्रिया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2099102, "chapter_id": 3120, "verse_number": "१३-२५०-४४", "content_sanskrit": "परुषा रुक्षवचना निर्घृणा निरपत्रपाः।\nनिःस्नेहाः क्रोधनाश्चैव भर्तृपुत्रस्वबन्धुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2099103, "chapter_id": 3120, "verse_number": "१३-२५०-४५", "content_sanskrit": "घोरा मांसप्रिया नित्यं हसन्ति च रुदन्ति च।\nपतीन्व्यभिचरन्त्येव दुर्मार्गेण यथा तथा।\nबन्धुभिर्भर्त्सिता भूत्वा गृहकार्याणि कुर्वते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2099104, "chapter_id": 3120, "verse_number": "१३-२५०-४६", "content_sanskrit": "अथवा भर्त्सिता देव निवृत्ताः स्वेषु कर्मसु।\nतथैवात्मवधं घोरं व्यवस्येयुर्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2099105, "chapter_id": 3120, "verse_number": "१३-२५०-४७", "content_sanskrit": "निर्दया निरनुक्रोशाः कुटुम्बार्थविलोपकाः।\nधर्मर्थरहिता घोराः सततं कुर्वते क्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2099106, "chapter_id": 3120, "verse_number": "१३-२५०-४८", "content_sanskrit": "अनर्थे निपुणाः पापाः परप्राणेषु निर्दयाः।\nएवंयुक्तसमाचाराः स्त्रियः पैशाचमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2099107, "chapter_id": 3120, "verse_number": "१३-२५०-४९", "content_sanskrit": "अपरा मोहसंयुक्ता निर्लज्जा रोदनप्रियाः।\nअशुद्धा मलदिग्धाङ्ग्य पानमांसरता भृशम्।\nवदन्त्यनृतवाक्यानि हसन्ति विलपन्ति च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2099108, "chapter_id": 3120, "verse_number": "१३-२५०-५०", "content_sanskrit": "दुष्पसादा महाक्रोधाः स्वप्नशीला निरन्तरम्।\nतामस्यो नष्टतत्वार्था मन्दशीला महोदराः।\nभुञ्जते विविधं सिद्धं भोजनं तीव्रसम्भ्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2099109, "chapter_id": 3120, "verse_number": "१३-२५०-५१", "content_sanskrit": "गुणरूपवयोयुक्तं पतिं कामिनमुत्तमम्।\nहित्वाऽन्येनैव गच्छन्ति सर्वधा भृशतापिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2099110, "chapter_id": 3120, "verse_number": "१३-२५०-५२", "content_sanskrit": "निर्लज्जा धर्मसन्दिग्धाः प्रतिकूलाः समन्ततः।\nएवंरूपसमाचाराः स्त्रियो राक्षसमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2099111, "chapter_id": 3120, "verse_number": "१३-२५०-५३", "content_sanskrit": "एवंविधानां सर्वासां न परत्र महासुखम्।\nनरकाद्विप्रमुक्तानां मानुष्यं दुर्लभं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2099112, "chapter_id": 3120, "verse_number": "१३-२५०-५४", "content_sanskrit": "कष्टं तत्रापि भुञ्जन्ते स्वकृतं दुःखजं बहु।\nदरिद्राः क्लेशभूयिष्ठा विरूपाः कुत्सिताः परैः।\nविधवा दुर्भगा वाऽपि लभन्ते दुःखमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2099113, "chapter_id": 3120, "verse_number": "१३-२५०-५५", "content_sanskrit": "शतवर्षसहस्राणि निरयं व्यभिचारिणी।\nव्रजेत्पतिं च पापेन संयोज्य स्वकुलं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2099114, "chapter_id": 3120, "verse_number": "१३-२५०-५६", "content_sanskrit": "एतद्विज्ञाय पतितं पुनश्चेद्धितमात्मनः।\nकुर्याद्भर्तारमाश्रित्य तथा धर्मवमाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2099115, "chapter_id": 3120, "verse_number": "१३-२५०-५७", "content_sanskrit": "अतिसंयान्ति ताँल्लोकान्पुण्यान्परमशोभनान्।\nअवमत्य च याः पूर्वं पतिं दुष्टेन चेतसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2099116, "chapter_id": 3120, "verse_number": "१३-२५०-५८", "content_sanskrit": "वर्तमानास्च सततं भर्तॄणां प्रतिकूलतः।\nभर्त्रानुमरणं काले याः कुर्वन्ति तथाविधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2099117, "chapter_id": 3120, "verse_number": "१३-२५०-५९", "content_sanskrit": "कामात्क्रोधाद्भयाल्लोभादपहास्या भवन्ति ताः।\nआदिप्रभृति कुस्त्रीणां तथाऽनुमरणं वृथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2099118, "chapter_id": 3120, "verse_number": "१३-२५०-६०", "content_sanskrit": "आदिप्रभृति या साध्वी पत्युः प्रियपरायणा।\nऊर्ध्वं गच्छति सा पूता भर्त्राऽनुमरणं गता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2099119, "chapter_id": 3120, "verse_number": "१३-२५०-६१", "content_sanskrit": "एवं मृताया वै लोकानहं पश्यामि चक्षुषा।\nस्पृहणीयान्सुरगणैर्यान्गच्छन्ति पतिव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2099120, "chapter_id": 3120, "verse_number": "१३-२५०-६२", "content_sanskrit": "अथवा भर्तरि मृते वैधव्यं धर्ममाश्रिताः।\nतूष्णीं भौमं जले नित्यमञ्जलिस्नानमुत्तमम्।\nव्रतं च पतिमुद्दिश्य कुर्यश्चैव विधिं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2099121, "chapter_id": 3120, "verse_number": "१३-२५०-६३", "content_sanskrit": "एवं गच्छति सा नारी पतिलोकमनुत्तमम्।\nरमणीयमनिर्देश्यं दुष्प्रापं देवमानुषैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2099122, "chapter_id": 3120, "verse_number": "१३-२५०-६४", "content_sanskrit": "प्राप्नुयात्तादृशं लोकं केवलं या पतिव्रता।\nइति ते कथितं देव स्त्रीणां धर्मिमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2099123, "chapter_id": 3120, "verse_number": "१३-२५०-६५", "content_sanskrit": "भवतः प्रियकामिन्या यन्मयोक्तं तवाग्रतः।\nचापल्यान्मम देवेश तद्भवान्क्षन्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2099124, "chapter_id": 3120, "verse_number": "१३-२५०-६६x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2099125, "chapter_id": 3120, "verse_number": "१३-२५०-६६", "content_sanskrit": "एवं वदन्तीं रुद्राणीं लज्जाभावसमन्विताम्।\nप्रशशंस च देवेशो वाचा सञ्जनयन्प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2099126, "chapter_id": 3120, "verse_number": "१३-२५०-६७", "content_sanskrit": "ऋषयो देवगन्धर्वाः प्रमदाश्च सहस्रशः।\nप्रणम्य शिरसा देवीं स्तुतिभिश्चाभितुष्टुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2099127, "chapter_id": 3120, "verse_number": "१३-२५०-६८", "content_sanskrit": "पूजयामासुरपरे देवदेव मुदा युताः।\nसंवादं चिन्तयन्त्यन्ते श्रद्दधानाः सुचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2099128, "chapter_id": 3120, "verse_number": "१३-२५०-६९", "content_sanskrit": "ततस्तु देवदेवेशो देवीं वचनमब्रवीत्।\nशृणु कल्याणि मद्वाक्यं संवादोऽयं मया तव।\nपुण्यं पवित्रं ख्यातं च भविता नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2099129, "chapter_id": 3120, "verse_number": "१३-२५०-७०", "content_sanskrit": "य इमं श्रावयेद्विद्वान्संवादं चावयोः प्रिये।\nशुचिर्भूत्वा नरान्युक्तान्स तैः स्वर्गं व्रजेत्सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2099130, "chapter_id": 3120, "verse_number": "१३-२५०-७१", "content_sanskrit": "यस्त्वेनं शृणुयान्नित्यं संवादं चावयोः शुभम्।\nकीर्तिमायुष्यमारोग्यं लभते स गतिं पराम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2099131, "chapter_id": 3120, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चाशदधिकद्विशततमोऽध्यायः॥ २५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]