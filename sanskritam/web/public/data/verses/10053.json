[{"id": 6000053000, "chapter_id": 10053, "verse_number": null, "content_sanskrit": "अथ त्रयोविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000053001, "chapter_id": 10053, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.001.m4a", "display_order": 2}, {"id": 6000053002, "chapter_id": 10053, "verse_number": "३-२३-१", "content_sanskrit": "एवमाविष्कृताशेषगुणकर्मोदयो मुनिम्।\nसव्रीड इव तं सम्राड् उपारतमुवाच ह॥ ३/२३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.002.m4a", "display_order": 3, "topics": [{"text": "स्वायम्भुवेन मनुना सोपचारं स्वपुत्रीपाणिग्रहणं प्रार्थितेन कर्दमेन सबहुमानं देवहूतीसमुद्वाहः", "range": "१–२०"}]}, {"id": 6000053003, "chapter_id": 10053, "verse_number": null, "content_sanskrit": "मनुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.003.m4a", "display_order": 4}, {"id": 6000053004, "chapter_id": 10053, "verse_number": "३-२३-२", "content_sanskrit": "ब्रह्मासृजत् स्वमुखतो युष्मान् अस्मत्परीप्सया।\nछन्दोमयांस्तपोविद्यायोगयुक्तान् अलम्पटान्॥ ३/२३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.004.m4a", "display_order": 5}, {"id": 6000053005, "chapter_id": 10053, "verse_number": "३-२३-३", "content_sanskrit": "तत्त्राणायासृजच्चास्मान् दोःसहस्रात् सहस्रपात्।\nहृदयं तस्य हि ब्रह्म क्षत्रमङ्गं प्रचक्षते॥ ३/२३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.005.m4a", "display_order": 6}, {"id": 6000053006, "chapter_id": 10053, "verse_number": "३-२३-४", "content_sanskrit": "अतो ह्यन्योन्यमात्मानं ब्रह्म क्षत्रं च रक्षतः।\nरक्षत्यस्मान् द्वयं देवः सदा सदसदात्मकः॥ ३/२३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.006.m4a", "display_order": 7}, {"id": 6000053007, "chapter_id": 10053, "verse_number": "३-२३-५", "content_sanskrit": "तव सन्दर्शनादेव च्छिन्ना मे संशया हृदः।\nयत् स्वयं भगवान् प्रीत्या धर्ममाह रिरक्षिषोः॥ ३/२३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.007.m4a", "display_order": 8}, {"id": 6000053008, "chapter_id": 10053, "verse_number": "३-२३-६", "content_sanskrit": "दिष्ट्या मे भगवान् दृष्टो दुर्दर्शो योऽकृतात्मनाम्।\nदिष्ट्या पादरजः स्पृष्टं शीर्ष्णा मे भवतः शिवम्॥ ३/२३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.008.m4a", "display_order": 9}, {"id": 6000053009, "chapter_id": 10053, "verse_number": "३-२३-७", "content_sanskrit": "दिष्ट्या त्वयाऽनुशिष्टोऽहं कृतश्चानुग्रहो महान्।\nअपावृतैः कर्णरन्ध्रैर्जुष्टा दिष्ट्योशतीर्गिरः॥ ३/२३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.009.m4a", "display_order": 10}, {"id": 6000053010, "chapter_id": 10053, "verse_number": "३-२३-८", "content_sanskrit": "स भवान् दुहितुः स्नेहपरिक्लिष्टात्मनो मम।\nश्रोतुमर्हसि दीनस्य श्रावितं कृपया मुने॥ ३/२३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.010.m4a", "display_order": 11}, {"id": 6000053011, "chapter_id": 10053, "verse_number": "३-२३-९", "content_sanskrit": "प्रियव्रतोत्तानपदोः स्वसेयं दुहिता मम।\nअन्विच्छन्ती पतिं युक्तं वयःशीलगुणादिभिः॥ ३/२३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.011.m4a", "display_order": 12}, {"id": 6000053012, "chapter_id": 10053, "verse_number": "३-२३-१०", "content_sanskrit": "यदा तु भवतः शीलश्रुतरूपवयोगुणान्।\nअशृृणोन्नारदात् सैषा त्वय्यासीत् कृतनिश्चया॥ ३/२३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.012.m4a", "display_order": 13}, {"id": 6000053013, "chapter_id": 10053, "verse_number": "३-२३-११", "content_sanskrit": "तत् प्रतीच्छ द्विजाग्र्येमां श्रद्धयोपहृतां मया।\nसर्वात्मनाऽनुरूपां ते गृहमेधेषु कर्मसु॥ ३/२३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.013.m4a", "display_order": 14}, {"id": 6000053014, "chapter_id": 10053, "verse_number": "३-२३-१२", "content_sanskrit": "उद्यतस्य हि कामस्य प्रतिवादो न शस्यते।\nअपि निर्मुक्तसङ्गस्य कामरक्तस्य किं पुनः॥ ३/२३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.014.m4a", "display_order": 15}, {"id": 6000053015, "chapter_id": 10053, "verse_number": "३-२३-१३", "content_sanskrit": "य उद्यतमनादृत्य कीनाशमभियाचते।\nक्षीयते तद् यशः स्फीतं मानश्चावज्ञया हतः॥ ३/२३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.015.m4a", "display_order": 16}, {"id": 6000053016, "chapter_id": 10053, "verse_number": "३-२३-१४", "content_sanskrit": "अहं चाशृृणवं विद्वन्नुद्वाहार्थं समुद्यतम्।\nअतस्त्वमुपकुर्वाणोऽप्रत्तां प्रतिगृहाण मे॥ ३/२३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.016.m4a", "display_order": 17}, {"id": 6000053017, "chapter_id": 10053, "verse_number": null, "content_sanskrit": "ऋषिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.017.m4a", "display_order": 18}, {"id": 6000053018, "chapter_id": 10053, "verse_number": "३-२३-१५", "content_sanskrit": "बाढमुद्वोढुकामोऽहमप्रमत्ता तवात्मजा।\nआवयोरनुरूपोऽसावाद्यो वैवाहिको विधिः॥ ३/२३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.018.m4a", "display_order": 19}, {"id": 6000053019, "chapter_id": 10053, "verse_number": "३-२३-१६", "content_sanskrit": "कामः स भूयान्नरदेव तेऽस्याः पुत्र्याः समाम्नायविधौ प्रतीतः।\nक एव ते तनयां नाद्रियेत स्वयाऽङ्गकान्त्या क्षिपतीमिव श्रियम्॥ ३/२३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.019.m4a", "display_order": 20}, {"id": 6000053020, "chapter_id": 10053, "verse_number": "३-२३-१७", "content_sanskrit": "यां हर्म्यपृष्ठेक्‍वणदङ्घ्रिशोभां विक्रीडतीं कन्दुकविह्वलाक्षीम्।\nविश्वावसुर्न्यपतत् स्वाद्विमानाद् विलोक्य संमोहविमूढचेताः॥ ३/२३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.020.m4a", "display_order": 21}, {"id": 6000053021, "chapter_id": 10053, "verse_number": "३-२३-१८", "content_sanskrit": "तां प्रार्थयन्तीं ललनाललामामसेवितश्रीचरणैरदृष्टाम्।\nसुतां मनोरुच्चपदः स्वसारं को नानुमन्येत बुधोऽभिजातः॥ ३/२३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.021.m4a", "display_order": 22}, {"id": 6000053022, "chapter_id": 10053, "verse_number": "३-२३-१९", "content_sanskrit": "अतो भजिष्ये समयेन साध्वीं यावत् तेजो बिभृयादात्मनो मे।\nअतो धर्मान् पारमहंस्यमुख्यान् शुक्लोपदिष्टान् बहुमन्येऽविहिंस्रान्॥ ३/२३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.022.m4a", "display_order": 23}, {"id": 6000053023, "chapter_id": 10053, "verse_number": "३-२३-२०", "content_sanskrit": "यतोऽभवद् विश्वमिदं विचित्रं संस्थाप्यते यत्र च वाऽवतिष्ठते।\nप्रजापतीनां पतिरेष मह्यं परं प्रमाणं भगवाननन्तः॥ ३/२३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.023.m4a", "display_order": 24}, {"id": 6000053024, "chapter_id": 10053, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.024.m4a", "display_order": 25}, {"id": 6000053025, "chapter_id": 10053, "verse_number": "३-२३-२१", "content_sanskrit": "स उग्रधन्वन्नियदेवाबभाष आसीच्च तूष्णीमरविन्दनाभम्।\nधियोपगृह्णन् स्मितशोभितेन मुखेन चेतो लुलुभे देवहूत्याः॥ ३/२३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.025.m4a", "display_order": 26, "topics": [{"text": "कन्यादानानन्तरं मनोः प्रतिगमनम्, मनुवैशिष्ट्यवर्णनं च", "range": "२१–३९"}]}, {"id": 6000053026, "chapter_id": 10053, "verse_number": "३-२३-२२", "content_sanskrit": "सोऽनु ज्ञात्वा व्यवसितं महिष्या दुहितुः स्फुटम्।\nतस्मै गुणगणाढ्याय ददौ तुल्यां प्रहर्षितः॥ ३/२३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.026.m4a", "display_order": 27}, {"id": 6000053027, "chapter_id": 10053, "verse_number": "३-२३-२३", "content_sanskrit": "शतरूपा महाराज्ञी पारिबर्हान् महाधनान्।\nदम्पत्योः पर्यदात् प्रीत्या गृहवासपरिच्छदान्॥ ३/२३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.027.m4a", "display_order": 28}, {"id": 6000053028, "chapter_id": 10053, "verse_number": "३-२३-२४", "content_sanskrit": "दत्त्वा दुहितरं सम्राट् सदृक्षाय गतव्यथः।\nउपगुह्य च बाहुभ्यामौत्कण्ठ्योन्मथिताशयः॥ ३/२३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.028.m4a", "display_order": 29}, {"id": 6000053029, "chapter_id": 10053, "verse_number": "३-२३-२५", "content_sanskrit": "अशक्नुवंस्तद्विरहं मुञ्चन् बाष्पकला मुहुः।\nआसिञ्चन्नम्ब वत्सेति नेत्रोदैर्दुहितुः शिखाः॥ ३/२३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.029.m4a", "display_order": 30}, {"id": 6000053030, "chapter_id": 10053, "verse_number": "३-२३-२६", "content_sanskrit": "आमन्त्र्य तं मुनिवरमनुज्ञातः सहानुगः।\nप्रतस्थे रथमास्थाय सभार्यः स्वपुरं नृपः॥ ३/२३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.030.m4a", "display_order": 31}, {"id": 6000053031, "chapter_id": 10053, "verse_number": "३-२३-२७", "content_sanskrit": "उभयोर्ऋषिकुल्यायाः सरस्वत्याः सुरोधसोः।\nऋषीणामुपशान्तानां पश्यन्नाश्रमसम्पदः॥ ३/२३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.031.m4a", "display_order": 32}, {"id": 6000053032, "chapter_id": 10053, "verse_number": "३-२३-२८", "content_sanskrit": "तमायान्तमभिप्रेक्ष्य ब्रह्मावर्तप्रजाः पतिम्।\nगीतसंस्तुतिवादित्रैः प्रत्युदीयुः प्रहर्षिताः॥ ३/२३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.032.m4a", "display_order": 33}, {"id": 6000053033, "chapter_id": 10053, "verse_number": "३-२३-२९", "content_sanskrit": "बर्हिष्मती नाम पुरी सर्वसम्पत्समन्विता।\nन्यपतन् यत्र रोमाणि यज्ञस्याङ्गं विधुन्वतः॥ ३/२३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.033.m4a", "display_order": 34}, {"id": 6000053034, "chapter_id": 10053, "verse_number": "३-२३-३०", "content_sanskrit": "कुशकाशास्त एवासन् लसद्धरितवर्चसः।\nऋषयो यैः पराभाव्य यज्ञघ्नान् यज्ञमीजिरे॥ ३/२३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.034.m4a", "display_order": 35}, {"id": 6000053035, "chapter_id": 10053, "verse_number": "३-२३-३१", "content_sanskrit": "कुशकाशमयं बर्हिरास्तीर्य भगवान् मनुः।\nअयजद् यज्ञपुरुषं लब्धं स्थानं यतो दृढम्॥ ३/२३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.035.m4a", "display_order": 36}, {"id": 6000053036, "chapter_id": 10053, "verse_number": "३-२३-३२", "content_sanskrit": "बर्हिष्मतीं नाम पुरीं निर्विश्य सुखमावसत्। तस्यां प्रविष्टो भवनं तापत्रयविनाशनम्।\nसभार्यः सप्रजः कामान् बुभुजेऽन्याविरोधतः॥ ३/२३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.036.m4a", "display_order": 37}, {"id": 6000053037, "chapter_id": 10053, "verse_number": "३-२३-३३", "content_sanskrit": "संगीयमानसत्कीर्तिः सस्‍त्रीभिः सुरगायकैः।\nप्रत्यूषेष्वनुबद्धेन हृदा शृण्वन् हरेः कथाः॥ ३/२३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.037.m4a", "display_order": 38}, {"id": 6000053038, "chapter_id": 10053, "verse_number": "३-२३-३४", "content_sanskrit": "निष्णातं योगमायासु मुनिं स्वायुम्भुवं मनुम्।\nयदा स्रंसयितुं भोगा न शेकुर्भगवत्परम्॥ ३/२३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.038.m4a", "display_order": 39}, {"id": 6000053039, "chapter_id": 10053, "verse_number": "३-२३-३५", "content_sanskrit": "अयातयामास्तस्यासन् यामाः स्वान्तरयापनाः।\nशृण्वतो ध्यायतो विष्णोः कुर्वतो ब्रुवतः कथाः॥ ३/२३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.039.m4a", "display_order": 40}, {"id": 6000053040, "chapter_id": 10053, "verse_number": "३-२३-३६", "content_sanskrit": "स एवं स्वान्तरं निन्ये युगानामेकसप्ततिम्।\nवासुदेवप्रसङ्गेन परिभूतगतित्रयः॥ ३/२३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.040.m4a", "display_order": 41}, {"id": 6000053041, "chapter_id": 10053, "verse_number": "३-२३-३७", "content_sanskrit": "शारीरा मानसा दिव्याः पर्यासे ये च मानुषाः।\nभौतिकाश्च कथं क्लेशा बाधन्ते हरिसंश्रयम्॥ ३/२३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.041.m4a", "display_order": 42}, {"id": 6000053042, "chapter_id": 10053, "verse_number": "३-२३-३८", "content_sanskrit": "यः पृष्टो मुनिभिः प्राह धर्मान् नानाविधान् शुभान्।\nनृणां वर्णाश्रमाणां च सर्वभूतहितः सदा॥ ३/२३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.042.m4a", "display_order": 43}, {"id": 6000053043, "chapter_id": 10053, "verse_number": "३-२३-३९", "content_sanskrit": "एतत् त आदिराजस्य मनोश्चरितमद्भुतम्।\nवर्णितं वर्णनीयस्य तदपत्योदयं शृृणु॥ ३/२३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_023/BhP_03.023.043.m4a", "display_order": 44}, {"id": 6000053044, "chapter_id": 10053, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे त्रयोविंशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]