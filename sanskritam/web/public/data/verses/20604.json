[{"id": 7000604000, "chapter_id": 20604, "verse_number": "५-६३-१", "content_sanskrit": "शेष उवाच ।\nलवं विमूर्च्छितं दृष्ट्वा बलिवैरिविदारणम् ।\nशत्रुघ्नो जयमापेदे रणमूर्ध्नि महाबलः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000604001, "chapter_id": 20604, "verse_number": "५-६३-२", "content_sanskrit": "लवं बालं रथे स्थाप्य शिरस्त्राणाद्यलंकृतम् ।\nरामप्रतिनिधिं मूर्त्या ततो गंतुमियेष सः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000604002, "chapter_id": 20604, "verse_number": "५-६३-३", "content_sanskrit": "स्वमित्रं शत्रुणा ग्रस्तमिति दुःखसमन्विताः ।\nबालामात्रेऽस्य सीतायै त्वरिताः संन्यवेदयन्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000604003, "chapter_id": 20604, "verse_number": "५-६३-४", "content_sanskrit": "बाला ऊचुः ।\nमातर्जानकि ते पुत्रो बलाद्वाहमपाहरत् ।\nकस्यचिद्भूपवर्यस्य बलयुक्तस्य मानिनः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000604004, "chapter_id": 20604, "verse_number": "५-६३-५", "content_sanskrit": "ततो युद्धमभूद्घोरं तस्य सैन्येन जानकि ।\nतदा वीरेण पुत्रेण तव सर्वं निपातितम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000604005, "chapter_id": 20604, "verse_number": "५-६३-६", "content_sanskrit": "पश्चादपि जयं प्राप्तः सुतस्तव मनोहरः ।\nतं भूपं मूर्छितं कृत्वा जयमाप रणांगणे॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000604006, "chapter_id": 20604, "verse_number": "५-६३-७", "content_sanskrit": "ततो मूर्च्छां विहायैष राजा परमदारुणः ।\nसंकुप्य पातयामास तव पुत्रं रणांगणे॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000604007, "chapter_id": 20604, "verse_number": "५-६३-८", "content_sanskrit": "अस्माभिर्वारितः पूर्वं मा गृहाण हयोत्तमम् ।\nअस्मान्सर्वांश्च धिक्कृत्य ब्राह्मणान्वेदपारगान्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000604008, "chapter_id": 20604, "verse_number": "५-६३-९", "content_sanskrit": "इति वाक्यं शिशूनां सा समाकर्ण्य सुदारुणम् ।\nपपात भूतलोपस्थे दुःखयुक्ता रुरोद ह॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000604009, "chapter_id": 20604, "verse_number": "५-६३-१०", "content_sanskrit": "सीतोवाच ।\nकथं नृपो दयाहीनो बालेन सह युध्यति ।\nअधर्मकृतदुर्बुद्धिर्यो मद्बालं न्यपातयत्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000604010, "chapter_id": 20604, "verse_number": "५-६३-११", "content_sanskrit": "लव वीरभवान्कुत्र वर्ततेऽति बलान्वितः ।\nकथं त्वं निष्कृपस्याहो राज्ञोऽहार्षीद्धयोत्तमम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000604011, "chapter_id": 20604, "verse_number": "५-६३-१२", "content_sanskrit": "त्वं बालस्ते दुराक्रांताः सर्वशस्त्रविशारदाः ।\nरथस्था विरथस्त्वं वै कथं युद्धं समं भवेत्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000604012, "chapter_id": 20604, "verse_number": "५-६३-१३", "content_sanskrit": "ताताहं तु त्वया सार्द्धं रामत्यागासुखं जहौ ।\nइदानीं रहिता युष्मत्कथं जीवामि कानने॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000604013, "chapter_id": 20604, "verse_number": "५-६३-१४", "content_sanskrit": "एहि मां मुंच यज्ञाश्वं गच्छत्वेष महीपतिः ।\nमद्दुःखं नाभिजानासि मम दुःखप्रमार्जकः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000604014, "chapter_id": 20604, "verse_number": "५-६३-१५", "content_sanskrit": "कुशो यद्यभविष्यत्स रणे वीरशिरोमणिः ।\nअमोचयिष्यदधुना भवंतं भूपपार्श्वतः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000604015, "chapter_id": 20604, "verse_number": "५-६३-१६", "content_sanskrit": "सोऽपि मद्दैवतो नास्ति समीपे किं करोम्यतः ।\nदैवमेव ममाप्यत्र कारणं दुःखसंभवे॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000604016, "chapter_id": 20604, "verse_number": "५-६३-१७", "content_sanskrit": "एवमादि बहुश्रीमत्येषा वै विललाप ह ।\nपादांगुष्ठेन लिखती भूमिं नेत्रद्वयाश्रुभिः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000604017, "chapter_id": 20604, "verse_number": "५-६३-१८", "content_sanskrit": "बालान्प्रति जगादासौ पृथुकः स च भूपतिः ।\nकथं मत्सुतमापात्य रणे कुत्र गमिष्यति॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000604018, "chapter_id": 20604, "verse_number": "५-६३-१९", "content_sanskrit": "इति वाक्यं वदत्येषा जानकी पतिदेवता ।\nतावत्कुशस्तु संप्राप्त उज्जयिन्या महर्षिभिः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000604019, "chapter_id": 20604, "verse_number": "५-६३-२०", "content_sanskrit": "माघासितचतुर्दश्यां महाकालं समर्च्य च ।\nप्राप्य भूरिवरांस्तस्मादागमन्मातृसन्निधौ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000604020, "chapter_id": 20604, "verse_number": "५-६३-२१", "content_sanskrit": "जानकीं विह्वलां दृष्ट्वा नेत्रोद्भूताश्रु विक्लवाम् ।\nशोकविह्वलदीनांगीं बभाषे यावदुत्सुकः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000604021, "chapter_id": 20604, "verse_number": "५-६३-२२", "content_sanskrit": "तदा स्वबाहुरवदत्स्फुरद्युद्धाभिशंसनः ।\nहृदये चरणोत्साहो बभूवातिरथस्य हि॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000604022, "chapter_id": 20604, "verse_number": "५-६३-२३", "content_sanskrit": "स प्रत्युवाच जननीं दीनगद्गदभाषिणीम् ।\nमातस्तव गतं दुःखं मयि पुत्र उपस्थिते॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000604023, "chapter_id": 20604, "verse_number": "५-६३-२४", "content_sanskrit": "मयि जीवति ते नेत्रादश्रूणि भुवि नो पतन् ।\nप्रसूमुवाचाश्रुखिन्नां दीनगद्गदभाषिणीम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000604024, "chapter_id": 20604, "verse_number": "५-६३-२५", "content_sanskrit": "कुशो दुःखमितः सद्यो दुःखितां धीरमानसः ।\nमम भ्राता लवः कुत्र वर्तते वैरिमर्दनः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000604025, "chapter_id": 20604, "verse_number": "५-६३-२६", "content_sanskrit": "सदा मामागतं ज्ञात्वा प्रहर्षन्सन्निधावियात् ।\nन दृश्यते कथं वीरः कुत्र रंतुं गतो बली॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000604026, "chapter_id": 20604, "verse_number": "५-६३-२७", "content_sanskrit": "केन वा सह बालत्वाद्गतो मां वै निरीक्षितुम् ।\nकिं त्वं रोदिषि मे मातर्लवः कुत्र स वर्तते॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000604027, "chapter_id": 20604, "verse_number": "५-६३-२८", "content_sanskrit": "तन्मे कथय सर्वं यत्तव दुःखस्य कारणम् ।\nतच्छ्रुत्वा पुत्रवाक्यं सा दुःखिता कुशमब्रवीत्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000604028, "chapter_id": 20604, "verse_number": "५-६३-२९", "content_sanskrit": "लवो धृतो नृपेणात्र केनचिद्धयरक्षिणा ।\nबबंध बालको मेत्र हयं यागक्रियोचितम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000604029, "chapter_id": 20604, "verse_number": "५-६३-३०", "content_sanskrit": "तद्रक्षकान्बहूञ्जिग्ये एकोऽनेकान्रिपून्बली ।\nराजा तं मूर्च्छितं कृत्वा बबंध रणमूर्धनि॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000604030, "chapter_id": 20604, "verse_number": "५-६३-३१", "content_sanskrit": "बालका इति मामूचुः सहगंतार एव हि ।\nततोऽहं दुःखिता जाता निशम्य लवमाधृतम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000604031, "chapter_id": 20604, "verse_number": "५-६३-३२", "content_sanskrit": "त्वं मोचय बलात्तस्मात्काले प्राप्तो नृपोत्तमात् ।\nनिशम्य मातुर्वचनं कुशः कोपसमन्वितः ।\nजगाद तां दशन्नोष्ठं दंतैर्दंतान्विनिष्पिषन्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000604032, "chapter_id": 20604, "verse_number": "५-६३-३३", "content_sanskrit": "कुश उवाच ।\nमातर्जानीहि तं मुक्तं लवं पाशस्य बंधनात् ।\nइदानीं हन्मि तं बाणैः समग्रबलवाहनम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000604033, "chapter_id": 20604, "verse_number": "५-६३-३४", "content_sanskrit": "यदि देवोऽमरो वापि यदि शर्वः समागतः ।\nतथापि मोचये तस्माद्बाणैर्निशितपर्वभिः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000604034, "chapter_id": 20604, "verse_number": "५-६३-३५", "content_sanskrit": "मा रोदिषि मातरिह वीराणां रणमूर्छितम् ।\nकीर्तयेऽत्र भवत्येव पलायनमकीर्तये॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000604035, "chapter_id": 20604, "verse_number": "५-६३-३६", "content_sanskrit": "देहि मे कवचं दिव्यं धनुर्गुणसमन्वितम् ।\nशिरस्त्राणं च मे मातः करवालं तथाशितम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000604036, "chapter_id": 20604, "verse_number": "५-६३-३७", "content_sanskrit": "इदानीं यामि समरे पातयामि बलं महत् ।\nमोचयामि भ्रातरं स्वं रणमध्याद्विमूर्छितम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000604037, "chapter_id": 20604, "verse_number": "५-६३-३८", "content_sanskrit": "न मोचयाम्यद्य पुत्रं तव मातर्महारणात् ।\nतदा तौ मे भवत्पादौ संरुष्टौ भवतां क्षितौ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000604038, "chapter_id": 20604, "verse_number": "५-६३-३९", "content_sanskrit": "शेष उवाच ।\nइति वाक्येन संतुष्टा जानकी शुभलक्षणा ।\nसर्वं प्रादादस्त्रवृंदं जयाशीर्भिर्नियुज्यतम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000604039, "chapter_id": 20604, "verse_number": "५-६३-४०", "content_sanskrit": "प्रयाहि पुत्र संग्रामं लवं मोचय मूर्च्छितम् ।\nइत्याज्ञप्तः कुशः संख्ये कवची कुंडली बली॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000604040, "chapter_id": 20604, "verse_number": "५-६३-४१", "content_sanskrit": "मुकुटी करवाली च चर्मधारी धनुर्धरः ।\nअक्षयाविषुधी कृत्वा स्कंधयोः सिंहवीर्ययोः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000604041, "chapter_id": 20604, "verse_number": "५-६३-४२", "content_sanskrit": "जगाम तरसा नत्वा मातृपादौ रथाग्रणीः ।\nवेगेन यावद्युद्धाय गच्छति क्षिप्रमाहवे॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000604042, "chapter_id": 20604, "verse_number": "५-६३-४३", "content_sanskrit": "तावद्ददर्श स्वलवं वैरिवृंदनिपातकम् ।\nआयांतं तं कुशं वीरा ददृशुः सुमहाभटाः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000604043, "chapter_id": 20604, "verse_number": "५-६३-४४", "content_sanskrit": "कृतांतमिव संहर्तुं सर्वं विश्वमुपस्थितम् ।\nलवो महाबलं दृष्ट्वा कुशं भ्रातरमागतम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000604044, "chapter_id": 20604, "verse_number": "५-६३-४५", "content_sanskrit": "अत्यंतं वह्निवद्युद्धे दिदीपे वायुना समम् ।\nरथादुन्मुच्य चात्मानं युद्धाय स विनिर्गतः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000604045, "chapter_id": 20604, "verse_number": "५-६३-४६", "content_sanskrit": "कुशः सर्वान्रणस्थान्वै वीरान्पूर्वदिशि क्षिपत् ।\nपश्चिमायां दिशि लवः कोपात्सर्वान्समैरयत्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000604046, "chapter_id": 20604, "verse_number": "५-६३-४७", "content_sanskrit": "कुशबाणव्यथाव्याप्ता लवसायकपीडिताः ।\nसैन्ये जना मुने सर्वे उत्कल्लोलांबुधिभ्रमाः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000604047, "chapter_id": 20604, "verse_number": "५-६३-४८", "content_sanskrit": "कुशेन च लवेनाथ शरव्रातैः प्रपीडितम् ।\nन शर्म लेभे सकलं सैन्यं वीरप्रपूरितम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000604048, "chapter_id": 20604, "verse_number": "५-६३-४९", "content_sanskrit": "इतस्ततः प्रभग्नं तद्बलं त्रस्तं पुनः पुनः ।\nन कुत्रचिद्रणे स्थित्वा युद्धमैच्छद्बलान्वितः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000604049, "chapter_id": 20604, "verse_number": "५-६३-५०", "content_sanskrit": "एतस्मिन्समये राजा शत्रुघ्नः परतापनः ।\nकुशं वीरं ययौ योद्धुं तादृशं लवसन्निभम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000604050, "chapter_id": 20604, "verse_number": "५-६३-५१", "content_sanskrit": "कुशं दृष्ट्वा बलाक्रांतं राममूर्तिसमप्रभम् ।\nरथे तिष्ठन्हेममये जगाद परवीरहा॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000604051, "chapter_id": 20604, "verse_number": "५-६३-५२", "content_sanskrit": "शत्रुघ्न उवाच ।\nकोऽसि त्वं सन्निभो भ्रात्रा लवेन सुमहाबलः ।\nकिं नामासि महावीर कस्ते तातः क्व ते प्रसूः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000604052, "chapter_id": 20604, "verse_number": "५-६३-५३", "content_sanskrit": "कथं वने द्विजैर्जुष्टे तिष्ठसि त्वं नरर्षभ ।\nसर्वं शंस यथायुध्ये त्वया सह महाबल॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000604053, "chapter_id": 20604, "verse_number": "५-६३-५४", "content_sanskrit": "इति वाक्यं समाकर्ण्य कुशः प्रोवाच भूमिपम् ।\nमेघगंभीरया वाचा नादयन्रणमंडलम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000604054, "chapter_id": 20604, "verse_number": "५-६३-५५", "content_sanskrit": "केवलं सुषुवे सीता पतिव्रतपरायणा ।\nवने वसावो वाल्मीकेश्चरणार्चनतत्परौ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000604055, "chapter_id": 20604, "verse_number": "५-६३-५६", "content_sanskrit": "मातृसेवासमुद्युक्तौ सर्वविद्याविशारदौ ।\nकुशो लव इति प्रख्यामागतौ भूपतेऽनघ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000604056, "chapter_id": 20604, "verse_number": "५-६३-५७", "content_sanskrit": "कस्त्वं वीरो रणश्लाघी किमर्थं हयसत्तमः ।\nमुक्तोऽस्ति समरे त्वद्य जेतासि बलसंयुतः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000604057, "chapter_id": 20604, "verse_number": "५-६३-५८", "content_sanskrit": "युध्यस्व त्वं मया सार्द्धं यदि वीरोऽसि भूमिप ।\nइदानीं पातयिष्यामि भवंतं रणमूर्धनि॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000604058, "chapter_id": 20604, "verse_number": "५-६३-५९", "content_sanskrit": "शत्रुघ्नस्तं सुतं ज्ञात्वा सीताया रामसंभवम् ।\nविसिष्माय स्वयं चित्ते कोपाद्धनुरुपाददत्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000604059, "chapter_id": 20604, "verse_number": "५-६३-६०", "content_sanskrit": "तमात्तधनुषं दृष्ट्वा कुशः कोपसमन्वितः ।\nविस्फारयामास धनुः स्वीयं सुदृढमुत्तमम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000604060, "chapter_id": 20604, "verse_number": "५-६३-६१", "content_sanskrit": "मुमोच बाणान्निशिताञ्छत्रुघ्नः सर्वशस्त्रवित् ।\nतांश्चिच्छेद कुशः सर्वांल्लीलया प्रहसन्रणे॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000604061, "chapter_id": 20604, "verse_number": "५-६३-६२", "content_sanskrit": "बाणाश्च शतसाहस्राः कुशस्य च नृपस्य च ।\nभुवनं व्याप्नुवन्सर्वं तच्चित्रमभवन्मुने॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000604062, "chapter_id": 20604, "verse_number": "५-६३-६३", "content_sanskrit": "अग्न्यस्त्रेण कुशः सर्वान्ददाह तरसा बली ।\nशमयामास तं भूपः पर्जन्यास्त्रेण वीर्यवान्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000604063, "chapter_id": 20604, "verse_number": "५-६३-६४", "content_sanskrit": "शमयामास तं भूपो वायव्येनातिविक्रमः ।\nतदा वायुरभूत्तीव्रः सर्वतो रणमंडले ।\nपर्वतास्त्रेण तं वायुं क्षोभयंतं समावृणोत्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000604064, "chapter_id": 20604, "verse_number": "५-६३-६५", "content_sanskrit": "वज्रास्त्रेण नृपः संख्ये चिच्छेद सनगोपलान् ।\nतदा नारायणास्त्रं स मुमोच कुश उद्भटः ।\nनारायणं तदा भूपं नाशकत्परिबाधितुम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000604065, "chapter_id": 20604, "verse_number": "५-६३-६६", "content_sanskrit": "तदा प्रकुपितोऽत्यतं कुशः कोपपरायणः ।\nउवाच भूपं शत्रुघ्नं महाबलपराक्रमम्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000604066, "chapter_id": 20604, "verse_number": "५-६३-६७", "content_sanskrit": "जानामि त्वां महावीरं संग्रामे जयकारिणम् ।\nयत्त्वां नारायणास्त्रं मे न बबाधे भयानकम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000604067, "chapter_id": 20604, "verse_number": "५-६३-६८", "content_sanskrit": "इदानीं पातयाम्यद्य भूमौ त्वां नृपते शरैः ।\nत्रिभिश्चेन्नकरोम्येतत्प्रतिज्ञां तर्हि मे शृणु॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000604068, "chapter_id": 20604, "verse_number": "५-६३-६९", "content_sanskrit": "यो मनुष्यवपुः प्राप्य दुर्लभं पुण्यकोटिभिः ।\nतन्नाद्रियेत संमोहात्तस्य मेस्त्वत्र पातकम्॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000604069, "chapter_id": 20604, "verse_number": "५-६३-७०", "content_sanskrit": "सावधानो भवानत्र भवतु प्रधनांगणे ।\nपातयामि क्षितौ सद्य इत्युक्त्वा स्वशरासने॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000604070, "chapter_id": 20604, "verse_number": "५-६३-७१", "content_sanskrit": "शरं संरोपयामास घोरं कालानलप्रभम् ।\nलक्षीकृत्य रिपोर्वक्षो विपुलं कठिनं महत्॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000604071, "chapter_id": 20604, "verse_number": "५-६३-७२", "content_sanskrit": "तं संधितं शरं दृष्ट्वा शत्रुघ्नः कोपमूर्च्छितः ।\nमुमोच बाणान्निशितान्कुशत्वग्भेदकारकान्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000604072, "chapter_id": 20604, "verse_number": "५-६३-७३", "content_sanskrit": "स बाणो हृदयं तस्य भेत्तुं तत्प्रचचाल वै ।\nघोररूपो वह्निसमआशीविषवदुच्छ्वसन्॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000604073, "chapter_id": 20604, "verse_number": "५-६३-७४", "content_sanskrit": "स बाणो नृपवर्येण रामं स्मृत्वाशुलक्षितः ।\nचिच्छेद कुशमुक्तं स सायकं शितपर्वकम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000604074, "chapter_id": 20604, "verse_number": "५-६३-७५", "content_sanskrit": "तदात्यंतं प्रकुपितः कुशो बाणस्य कृंतनात् ।\nअपरं सायकं चापे दधार शितपर्वकम्॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000604075, "chapter_id": 20604, "verse_number": "५-६३-७६", "content_sanskrit": "स यावत्तदुरो भेत्तुं करोति च बलोद्धुरः ।\nतं तावदच्छिनत्तस्य शरं कालानलप्रभम्॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000604076, "chapter_id": 20604, "verse_number": "५-६३-७७", "content_sanskrit": "तदा कुशो मातृपादौ स्मृत्वा रोषसमन्वितः ।\nतृतीयं चापके स्वीये दधार शरमद्भुतम्॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000604077, "chapter_id": 20604, "verse_number": "५-६३-७८", "content_sanskrit": "शत्रुघ्नस्तमपि क्षिप्रं च्छेत्तुं बाणं समाददे ।\nतावद्विद्धः शरेणासौ पपात धरणीतले॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000604078, "chapter_id": 20604, "verse_number": "५-६३-७९", "content_sanskrit": "हाहाकारो महानासीच्छत्रुघ्ने विनिपातिते ।\nजयमापकुशस्तत्र स्वबाहुबलदर्पितः॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}]