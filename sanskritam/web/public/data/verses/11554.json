[{"id": 50015414, "chapter_id": 11554, "verse_number": "1", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50015415, "chapter_id": 11554, "verse_number": "2", "content_sanskrit": "यतिर्ययातिः संयातिरायातिर्वियतिः कृतिः। षडिमे नहुषस्यासन् इन्द्रियाणीव देहिनः॥ ९/१५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50015416, "chapter_id": 11554, "verse_number": "3", "content_sanskrit": "राज्यं नैच्छद् यतिः पित्रा दत्तं तत्परिणामवित्। यत्र प्रविष्टः पुरुष आत्मानं नावबुध्यते॥ ९/१५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50015417, "chapter_id": 11554, "verse_number": "4", "content_sanskrit": "पितरि भ्रंशिते स्थानादिन्द्राण्या धर्षणाद् द्विजैः। प्रापितेऽजगरत्वं च ययातिरभवन्नृपः॥ ९/१५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50015418, "chapter_id": 11554, "verse_number": "5", "content_sanskrit": "चतसृष्वादिशद् दिक्षु भ्रातॄन् गोप्तॄन् (???) यवीयसः। कृतदारो जुगोपोर्वीं काव्यस्य वृषपर्वणः॥ ९/१५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50015419, "chapter_id": 11554, "verse_number": "6", "content_sanskrit": "राजोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50015420, "chapter_id": 11554, "verse_number": "7", "content_sanskrit": "ब्रह्मर्षिर्भगवान् काव्यः क्षत्रबन्धुश्च नाहुषः। राजन्यविप्रयोः कस्माद् विवाहः प्रातिलोमकः॥ ९/१५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50015421, "chapter_id": 11554, "verse_number": "8", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50015422, "chapter_id": 11554, "verse_number": "9", "content_sanskrit": "एकदा दानवेन्द्रस्य शर्मिष्ठा नाम कन्यका। सखीसहस्रसंयुक्ता गुरुपुत्र्या च भामिनी॥ ९/१५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50015423, "chapter_id": 11554, "verse_number": "10", "content_sanskrit": "देवयान्या पुरोद्याने पुष्पितद्रुमसङ्कुले। व्यचरत् कळगीताळिनळिनीपुळिनेऽबला॥ ९/१५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50015424, "chapter_id": 11554, "verse_number": "11", "content_sanskrit": "जलाशयं समासाद्य कन्याः कमललोचनाः। तीरे न्यस्य दुकूलानि विजह्नुः सिञ्चतीर्मिथः॥ ९/१५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50015425, "chapter_id": 11554, "verse_number": "12", "content_sanskrit": "वीक्ष्य व्रजन्तं गिरिशं सह देव्या वृषे स्थितम्। सहसोत्तीर्य वासांसि पर्यधुर्व्रीळिताः (???) स्त्रियः॥ ९/१५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50015426, "chapter_id": 11554, "verse_number": "13", "content_sanskrit": "शर्मिष्ठाऽजानती वासो गुरुपुत्र्याः समव्ययत्। स्वीयं मत्वा प्रकुपिता देवयानीदमब्रवीत्॥ ९/१५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50015427, "chapter_id": 11554, "verse_number": "14", "content_sanskrit": "अहो निरीक्ष्यतां मह्यं दास्याः कर्म ह्यसाम्प्रतम्। अस्मद्धार्यं धृतवती शुनीव हविरध्वरे॥ ९/१५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50015428, "chapter_id": 11554, "verse_number": "15", "content_sanskrit": "यैरिदं तपसा सृष्टं मुखं पुंसः परस्य वै। धार्यते यैः परञ्ज्योतिः शिवः पन्थाश्च दर्शितः॥ ९/१५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50015429, "chapter_id": 11554, "verse_number": "16", "content_sanskrit": "येऽपीदमुपतिष्ठन्ते लोकनाथाः सुरेश्वराः। भगवानपि विश्वात्मा पावनः श्रीनिकेतनः॥ ९/१५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50015430, "chapter_id": 11554, "verse_number": "17", "content_sanskrit": "वयं तत्रापि भृगवः शिष्योऽस्या नः पिताऽसुरः। अस्मद्धार्थं धृतवती शूद्रो वेदमिवासती॥ ९/१५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50015431, "chapter_id": 11554, "verse_number": "18", "content_sanskrit": "एवं शपन्तीं शर्मिष्ठा गुरुपुत्रीमभाषत। रुषा श्वसन्ती नागीव धर्षिता दष्टदच्छदा॥ ९/१५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50015432, "chapter_id": 11554, "verse_number": "19", "content_sanskrit": "आत्मवृत्तिमविज्ञाय कत्थसे बहु भिक्षुकि। किं न प्रतीक्षसेऽस्माकं गृहान् बलिभुजो यथा॥ ९/१५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50015433, "chapter_id": 11554, "verse_number": "20", "content_sanskrit": "एवंविधैः सुपरुषैः क्षिप्त्वाऽऽचार्यसुतां सतीम्। शर्मिष्ठा प्राक्षिपत् कूपे वासस्त्वादाय मन्युना॥ ९/१५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50015434, "chapter_id": 11554, "verse_number": "21", "content_sanskrit": "तस्यां गतायां स्वगृहं ययातिर्मृगयां चरन्। प्राप्तो यदृच्छया कूपे जलार्थी तां ददर्श ह॥ ९/१५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50015435, "chapter_id": 11554, "verse_number": "22", "content_sanskrit": "दत्वा स्वमुत्तरं वासस्तस्यै राजा विवाससे। गृहीत्वा पाणिना पाणिमुज्जहार दयापरः॥ ९/१५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50015436, "chapter_id": 11554, "verse_number": "23", "content_sanskrit": "तं वीरमाहौशनसी प्रेमनिर्भरया गिरा। राजंस्त्वया गृहीतो मे पाणिः परपुरञ्जय। हस्तग्रहोऽपरो मा भूद् गृहीतायास्त्वया हि मे॥ ९/१५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50015437, "chapter_id": 11554, "verse_number": "24", "content_sanskrit": "एष ईशकृतो वीर सम्बन्धो नौ न पौरुषः। यदिदं कूपमग्नाया भवतो दर्शनं मम॥ ९/१५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50015438, "chapter_id": 11554, "verse_number": "25", "content_sanskrit": "न ब्राह्मणो मे भविता हस्तग्राहो महाभुज। कचस्य बार्हस्पत्यस्य शापाद् यमशपं पुरा॥ ९/१५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50015439, "chapter_id": 11554, "verse_number": "26", "content_sanskrit": "ययातिरनभिप्रेतं दैवोपहृतमात्मनः। मनस्तु तद्गतं बुद्ध्वा प्रतिजग्राह तद्वचः॥ ९/१५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50015440, "chapter_id": 11554, "verse_number": "27", "content_sanskrit": "गते राजनि सा वीरे तत्र स्म रुदती पितुः। न्यवेदयत् ततः सर्वमुक्तं शर्मिष्ठया कृतम्॥ ९/१५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50015441, "chapter_id": 11554, "verse_number": "28", "content_sanskrit": "दुर्मना भगवान् काव्यः पौरोहित्यं विगर्हयन्। स्तुवन् वृत्तिं च कापोतीं दुहित्रा स ययौ पुरात्॥ ९/१५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50015442, "chapter_id": 11554, "verse_number": "29", "content_sanskrit": "वृषपर्वा तदाज्ञाय प्रत्यनीकविवक्षितम्। गुरुं प्रसादयन् मूर्ध्ना पादयोः पतितः पथि॥ ९/१५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50015443, "chapter_id": 11554, "verse_number": "30", "content_sanskrit": "क्षणार्धमन्युर्भगवाञ्छिष्यं व्याचष्ट भार्गवः। कामोऽस्याः क्रियतां राजन् नैनां त्यक्तुमिहोत्सहे॥ ९/१५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50015444, "chapter_id": 11554, "verse_number": "31", "content_sanskrit": "तथेत्यवस्थिते प्राह देवयानी मनोगतम्। पित्रा दत्ता यतो यास्ये सानुगा यातु मामनु॥ ९/१५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50015445, "chapter_id": 11554, "verse_number": "32", "content_sanskrit": "स्वानां तत् सङ्कटं वीक्ष्य तदर्थस्य च गौरवम्। देवयानीं पर्यचरत् स्त्रीसहस्रेण दासिवत्॥ ९/१५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50015446, "chapter_id": 11554, "verse_number": "33", "content_sanskrit": "नाहुषाय सुतां दत्वा सह शर्मिष्ठयोशनाः। तमाह राजञ्छर्मिष्ठां मा धास्तल्पे तु कर्हिचित्॥ ९/१५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50015447, "chapter_id": 11554, "verse_number": "34", "content_sanskrit": "विलोक्यौशनसीं राज्ञीं शर्मिष्ठा सुप्रजां क्वचित्। तमेव वव्रे रहसि सख्याः पतिमृतौ सति॥ ९/१५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50015448, "chapter_id": 11554, "verse_number": "35", "content_sanskrit": "राजपुत्र्याऽर्थितोऽपत्ये धर्मं चावेक्ष्य धर्मवित्। स्मरञ्छुक्रवचः काले दिष्टमेवाभ्यपद्यत॥ ९/१५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50015449, "chapter_id": 11554, "verse_number": "36", "content_sanskrit": "यदुं च तुर्वसुं चैव देवयानी व्यजायत। द्रुह्युं चानुं च पूरुं च शर्मिष्ठा वार्षपर्वणी॥ ९/१५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50015450, "chapter_id": 11554, "verse_number": "37", "content_sanskrit": "गर्भसम्भवमासुर्या भर्तुर्विज्ञाय मानिनी। देवयानी पितुर्गेहं ययौ क्रोधविमूर्च्छिता॥ ९/१५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50015451, "chapter_id": 11554, "verse_number": "38", "content_sanskrit": "प्रियामनुगतः कामी वचोभिरभिमन्त्रयन्। न प्रसादयितुं शेके पादसंवन्दनादिभिः॥ ९/१५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50015452, "chapter_id": 11554, "verse_number": "39", "content_sanskrit": "शुक्रस्तमाह कुपितः स्त्रीकामानृतपूरुष। त्वां जरा विशते मन्द विरूपकरणी नृणाम्॥ ९/१५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50015453, "chapter_id": 11554, "verse_number": "40", "content_sanskrit": "ययातिरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50015454, "chapter_id": 11554, "verse_number": "41", "content_sanskrit": "अतृप्तोऽस्म्यद्य कामानां ब्रह्मन् दुहितरि स्म ते। व्यत्यस्यैतां यथाकामं वयसा यो हि दास्यति॥ ९/१५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50015455, "chapter_id": 11554, "verse_number": "42", "content_sanskrit": "श्रीशुक उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50015456, "chapter_id": 11554, "verse_number": "43", "content_sanskrit": "इति लब्धव्यवस्थानः पुत्रं ज्येष्ठमवोचत। यदो तात प्रतीच्छेमां जरां देहि निजं वयः॥ ९/१५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50015457, "chapter_id": 11554, "verse_number": "44", "content_sanskrit": "मातामहकृतां वत्स न तृप्तो विषयेष्वहम्। वयसा भवदीयेन रंस्ये कतिपयाः समाः॥ ९/१५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50015458, "chapter_id": 11554, "verse_number": "45", "content_sanskrit": "यदुरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50015459, "chapter_id": 11554, "verse_number": "46", "content_sanskrit": "नोत्सहे जरया स्थातुमन्तरा प्राप्तया तव। अविदित्वा सुखं ग्राम्यं वैतृष्ण्यं नैति पूरुषः॥ ९/१५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50015460, "chapter_id": 11554, "verse_number": "47", "content_sanskrit": "तुर्वशुश्चोदितः पित्रा द्रुह्युश्चानुश्च भारत। प्रत्याचख्युरधर्मज्ञा ह्यनित्ये नित्यबुद्धयः॥ ९/१५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50015461, "chapter_id": 11554, "verse_number": "48", "content_sanskrit": "अपृच्छत् तनयं पूरुं वयसोनं गुणाधिकम्। न त्वमग्रजवद् वत्स मां प्रत्याख्यातुमर्हसि॥ ९/१५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50015462, "chapter_id": 11554, "verse_number": "49", "content_sanskrit": "पूरुरुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50015463, "chapter_id": 11554, "verse_number": "50", "content_sanskrit": "को नु लोके मनुष्येन्द्र पितुरात्मकृतः पुमान्। प्रतिकर्तुं क्षमो यस्य प्रसादाद् विन्दते परम्॥ ९/१५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50015464, "chapter_id": 11554, "verse_number": "51", "content_sanskrit": "उत्तमश्चिन्तितं कुर्यात् प्रोक्तकारी तु मध्यमः। अधमोऽश्रद्धया कुर्यादकर्तोच्चरितं पितुः॥ ९/१५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50015465, "chapter_id": 11554, "verse_number": "52", "content_sanskrit": "इति प्रमुदितः पूरुः प्रत्यगृह्णाज्जरां पितुः। सोऽपि तद्वयसा कामान् यथावज्जुजुषे नृप॥ ९/१५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50015466, "chapter_id": 11554, "verse_number": "53", "content_sanskrit": "सप्तद्वीपपतिः सम्यक् पितृवत् पालयन् प्रजाः। यथोपजोषं विषयान् जुजोषाव्याहतेन्द्रियः॥ ९/१५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50015467, "chapter_id": 11554, "verse_number": "54", "content_sanskrit": "देवयान्यप्यनुदिनं मनोवाग्देहवस्तुभिः। प्रेयसः परमां प्रीतिमुवाह प्रेयसी रहः॥ ९/१५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50015468, "chapter_id": 11554, "verse_number": "55", "content_sanskrit": "अयजद् यज्ञपुरुषं क्रतुभिर्भूरिदक्षिणैः। सर्वदेवमयं देवं सर्ववेदमयं हरिम्॥ ९/१५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50015469, "chapter_id": 11554, "verse_number": "56", "content_sanskrit": "यस्मिन्निदं विरचितं व्योम्नीव जलदाविळः। नानेव भाति नाभाति स्वप्नमायामनोरथः॥ ९/१५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50015470, "chapter_id": 11554, "verse_number": "57", "content_sanskrit": "तमेव हृदि विन्यस्य वासुदेवं गुहाशयम्। नारायणमणीयांसं निराशीरयजत् प्रभुः॥ ९/१५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50015471, "chapter_id": 11554, "verse_number": "58", "content_sanskrit": "एवं वर्षसहस्राणि मनःषष्ठैर्मनःसुखम्। विदधानोऽपि नातृप्यत् सार्वभौमः कदिन्द्रियैः॥ ९/१५/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50015472, "chapter_id": 11554, "verse_number": "59", "content_sanskrit": "इति श्रीमद्भागवते नवमस्कन्धे पञ्चदशोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]