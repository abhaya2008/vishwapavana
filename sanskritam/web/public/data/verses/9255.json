[{"id": 5000255000, "chapter_id": 9255, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे अष्टपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000255001, "chapter_id": 9255, "verse_number": "३-५८-१", "content_sanskrit": "स दृष्ट्वा लक्ष्मणं दीनं शून्यं दशरथात्मजः।\nपर्यपृच्छत धर्मात्मा वैदेहीमागतं विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000255002, "chapter_id": 9255, "verse_number": "३-५८-२", "content_sanskrit": "प्रस्थितं दण्डकारण्यं या मामनुजगाम ह।\nक्व सा लक्ष्मण वैदेही यां हित्वा त्वमिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000255003, "chapter_id": 9255, "verse_number": "३-५८-३", "content_sanskrit": "राज्यभ्रष्टस्य दीनस्य दण्डकान् परिधावतः।\nक्व सा दुःखसहाया मे वैदेही तनुमध्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000255004, "chapter_id": 9255, "verse_number": "३-५८-४", "content_sanskrit": "यां विना नोत्सहे वीर मुहूर्तमपि जीवितुम्।\nक्व सा प्राणसहाया मे सीता सुरसुतोपमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000255005, "chapter_id": 9255, "verse_number": "३-५८-५", "content_sanskrit": "पतित्वममराणां हि पृथिव्याश्चापि लक्ष्मण।\nविना तां तपनीयाभां नेच्छेयं जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000255006, "chapter_id": 9255, "verse_number": "३-५८-६", "content_sanskrit": "कच्चिज्जीवति वैदेही प्राणैः प्रियतरा मम।\nकच्चित् प्रव्राजनं वीर न मे मिथ्या भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000255007, "chapter_id": 9255, "verse_number": "३-५८-७", "content_sanskrit": "सीतानिमित्तं सौमित्रे मृते मयि गते त्वयि।\nकच्चित् सकामा कैकेयी सुखिता सा भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000255008, "chapter_id": 9255, "verse_number": "३-५८-८", "content_sanskrit": "सपुत्रराज्यां सिद्धार्थां मृतपुत्रा तपस्विनी।\nउपस्थास्यति कौसल्या कच्चित् सौम्येन कैकयीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000255009, "chapter_id": 9255, "verse_number": "३-५८-९", "content_sanskrit": "यदि जीवति वैदेही गमिष्याम्याश्रमं पुनः।\nसंवृत्ता यदि वृत्ता सा प्राणांस्त्यक्ष्यामि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000255010, "chapter_id": 9255, "verse_number": "३-५८-१०", "content_sanskrit": "यदि मामाश्रमगतं वैदेही नाभिभाषते।\nपुरः प्रहसिता सीता विनशिष्यामि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000255011, "chapter_id": 9255, "verse_number": "३-५८-११", "content_sanskrit": "ब्रूहि लक्ष्मण वैदेही यदि जीवति वा न वा।\nत्वयि प्रमत्ते रक्षोभिर्भक्षिता वा तपस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000255012, "chapter_id": 9255, "verse_number": "३-५८-१२", "content_sanskrit": "सुकुमारी च बाला च नित्यं चादुःखभागिनी।\nमद्वियोगेन वैदेही व्यक्तं शोचति दुर्मनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000255013, "chapter_id": 9255, "verse_number": "३-५८-१३", "content_sanskrit": "सर्वथा रक्षसा तेन जिह्मेन सुदुरात्मना।\nवदता लक्ष्मणेत्युच्चैस्तवापि जनितं भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000255014, "chapter_id": 9255, "verse_number": "३-५८-१४", "content_sanskrit": "श्रुतश्च मन्ये वैदेह्या स स्वरः सदृशो मम।\nत्रस्तया प्रेषितस्त्वं च द्रष्टुं मां शीघ्रमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000255015, "chapter_id": 9255, "verse_number": "३-५८-१५", "content_sanskrit": "सर्वथा तु कृतं कष्टं सीतामुत्सृजता वने।\nप्रतिकर्तुं नृशंसानां रक्षसां दत्तमन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000255016, "chapter_id": 9255, "verse_number": "३-५८-१६", "content_sanskrit": "दुःखिताः खरघातेन राक्षसाः पिशिताशनाः।\nतैः सीता निहता घोरैर्भविष्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000255017, "chapter_id": 9255, "verse_number": "३-५८-१७", "content_sanskrit": "अहोऽस्मि व्यसने मग्नः सर्वथा रिपुनाशन।\nकिं त्विदानीं करिष्यामि शङ्के प्राप्तव्यमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000255018, "chapter_id": 9255, "verse_number": "३-५८-१८", "content_sanskrit": "इति सीतां वरारोहां चिन्तयन्नेव राघवः।\nआजगाम जनस्थानं त्वरया सहलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000255019, "chapter_id": 9255, "verse_number": "३-५८-१९", "content_sanskrit": "विगर्हमाणोऽनुजमार्तरूपं\nक्षुधाश्रमेणैव पिपासया च।\nविनिःश्वसन् शुष्कमुखो विषण्णः\nप्रतिश्रयं प्राप्य समीक्ष्य शून्यम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000255020, "chapter_id": 9255, "verse_number": "३-५८-२०", "content_sanskrit": "स्वमाश्रमं स प्रविगाह्य वीरो\nविहारदेशाननुसृत्य कांश्चित्।\nएतत्तदित्येव निवासभूमौ\nप्रहृष्टरोमा व्यथितो बभूव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000255021, "chapter_id": 9255, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे अष्टपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]