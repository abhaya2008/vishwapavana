[{"id": 2070568, "chapter_id": 2483, "verse_number": "११-१५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2070569, "chapter_id": 2483, "verse_number": "११-१५-१", "content_sanskrit": "तमेवमुक्त्वा गान्धारी युधिष्ठिरमपृच्छत।\nक्व स राजेति सक्रोधा पुत्रपौत्रवधार्दिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2070570, "chapter_id": 2483, "verse_number": "११-१५-२", "content_sanskrit": "तामभ्यगच्छत्कौन्तेयो वेपमानः कृताञ्जलिः।\nयुधिष्ठिरस्तु गान्धारीं मधुरं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2070571, "chapter_id": 2483, "verse_number": "११-१५-३", "content_sanskrit": "पुत्रहन्ता नृशंसोऽहं तव देवि युधिष्ठिरः।\nशापार्हः पृथिवीनाशे हेतुभूतः शपस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2070572, "chapter_id": 2483, "verse_number": "११-१५-४", "content_sanskrit": "नहि मे जीवितेनार्थो न राज्येन सुखेन वा।\nतादृशान्सुहृदो हत्वा प्रमूढस्य सुहृद्द्रुहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2070573, "chapter_id": 2483, "verse_number": "११-१५-५", "content_sanskrit": "तमेवंवादिनं भीतं सन्निकर्षागतं तदा।\nनोवाच किञ्चिद्गान्धारी निःश्वासपरमा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2070574, "chapter_id": 2483, "verse_number": "११-१५-६", "content_sanskrit": "तस्मावनतदेहस्य पादयोर्निपतिष्यतः।\nयुधिष्ठिरस्य नृपतेर्धर्मज्ञा दीर्घदर्शिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2070575, "chapter_id": 2483, "verse_number": "११-१५-७", "content_sanskrit": "अङ्गुल्यग्राणि ददृशे देवी पट्टान्तरेण सा।\nततः स कुनखीभूतो दर्शनीयनखो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2070576, "chapter_id": 2483, "verse_number": "११-१५-८", "content_sanskrit": "तं दृष्ट्वा चार्जुनोऽगच्छद्वासुदेवस्य पृष्ठतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2070577, "chapter_id": 2483, "verse_number": "११-१५-९", "content_sanskrit": "एवं सञ्चेष्टमानांस्तानितश्चेतश्च भारत।\nगान्धारी विगतक्रोधा सांत्वयामास मातृवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2070578, "chapter_id": 2483, "verse_number": "११-१५-१०", "content_sanskrit": "ते पाण्डवा अनुज्ञाता मातरं वीतमत्सराः।\nअभ्यगच्छन्त सहिताः पृथां पृथुवलक्षसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2070579, "chapter_id": 2483, "verse_number": "११-१५-११", "content_sanskrit": "चिरस्य दृष्ट्वा पुत्रान्सा पुत्राधिभिरभिप्लुता।\nबाष्पमाहारयद्देवी वस्त्रेणावृत्य वै मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2070580, "chapter_id": 2483, "verse_number": "११-१५-१२", "content_sanskrit": "ततो बाष्पं समुत्सृज्य सह पुत्रैस्तदा पृथा।\nअपश्यदेनाञ्शस्त्रौघैर्बहुधा परिविक्षतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2070581, "chapter_id": 2483, "verse_number": "११-१५-१३", "content_sanskrit": "सा तानेकैकशः पुत्रान्संस्पृशन्ती पुनःपुनः।\nअन्वशोचत दुःखार्ता द्रौपदीं निहतात्मजाम्।\nरुदन्तीमथ पाञ्चालीं ददर्श पतितां भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2070582, "chapter_id": 2483, "verse_number": "११-१५-१४x", "content_sanskrit": "द्रौपद्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2070583, "chapter_id": 2483, "verse_number": "११-१५-१४", "content_sanskrit": "आर्ये पौत्रास्तु ते सर्वे सौभद्रसहिता गताः।\nन त्वां तेऽद्याभिगच्छन्ति चिरं दृष्ट्वा अनिन्दिते।\nकिन्नु राज्येन मे कार्यं विहीनायाः सुतैर्वरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2070584, "chapter_id": 2483, "verse_number": "११-१५-१५", "content_sanskrit": "तां समाश्वासयामास पृथा पृथललोचना।\nउत्थाप्याङ्केन सुदतीं रुदतीं शोककर्शिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2070585, "chapter_id": 2483, "verse_number": "११-१५-१६", "content_sanskrit": "तयैव सहिता चापि पुत्रैरनुगता पृथा।\nअभ्यगच्छत गान्धारीमार्तामार्ततरा स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2070586, "chapter_id": 2483, "verse_number": "११-१५-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2070587, "chapter_id": 2483, "verse_number": "११-१५-१७", "content_sanskrit": "तामुवाचाथ गान्धारी सह कुन्त्या यशस्विनीम्।\nमैवं पुत्रीति शोकार्ता पश्य मामपि दुःखितां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2070588, "chapter_id": 2483, "verse_number": "११-१५-१८", "content_sanskrit": "मन्ये लोकविनाशोऽयं कालपर्यायनोदितः।\nअवश्यभावी सम्प्राप्तः स्वभावाद्रोमहर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2070589, "chapter_id": 2483, "verse_number": "११-१५-१९", "content_sanskrit": "इदं तत्समनुप्राप्तं विदुरस्य वचो महत्।\nअसिद्धानुनये कृष्णे यदुवाच महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2070590, "chapter_id": 2483, "verse_number": "११-१५-२०", "content_sanskrit": "तस्मिन्नपरिहार्येऽर्थे व्यतीते च विशेषतः।\nमा शुचो न हि शोच्यास्ते सङ्ग्रामे निधनं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2070591, "chapter_id": 2483, "verse_number": "११-१५-२१", "content_sanskrit": "यथैवाहं तथैव त्वं को वामाश्वासयिष्यति।\nममैव ह्यपराधेन कुलमग्र्यं विनाशितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2070592, "chapter_id": 2483, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते स्त्रीपर्वणि जलप्रदानिकपर्वणि पञ्चदशोऽध्यायः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]