[{"id": 900007687, "chapter_id": 8580, "verse_number": "161.1", "content_sanskrit": "किञ्च सर्वविलोपश्च केन मानेन गम्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007688, "chapter_id": 8580, "verse_number": "161.2", "content_sanskrit": "सर्वेण सह तद्वाक्यमर्थश्च यदि गृह्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007689, "chapter_id": 8580, "verse_number": "161.3", "content_sanskrit": "उपपत्तिविहीनस्य वाक्यस्यार्थो न गम्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007690, "chapter_id": 8580, "verse_number": "161.4", "content_sanskrit": "उपक्रमादिलिङ्गानां बलीयो ह्युत्तरोत्तरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007691, "chapter_id": 8580, "verse_number": "161.5", "content_sanskrit": "प्रत्यक्षमुपपत्तिश्च बहवश्चागमा यदा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007692, "chapter_id": 8580, "verse_number": "161.6", "content_sanskrit": "उपपन्नेऽविरोधिनि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007693, "chapter_id": 8580, "verse_number": "161.7", "content_sanskrit": "अतः सर्वगुणैर्युक्तं ब्रह्माङ्गीकार्यमेव हि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007694, "chapter_id": 8580, "verse_number": "161.8", "content_sanskrit": "अपलापोऽपि सर्वस्य न कथञ्चन युज्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900007695, "chapter_id": 8580, "verse_number": "161.9", "content_s