[{"id": 2101209, "chapter_id": 3179, "verse_number": "१४-३५-१", "content_sanskrit": "ब्राह्मण उवाच।\nनेदमल्पात्मना शक्यं वेदितुं वाऽकृतात्मना।\nबहु चाल्पं च संक्षिप्तं विस्तृतं च मतं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101210, "chapter_id": 3179, "verse_number": "१४-३५-२", "content_sanskrit": "उपायं तं मम ब्रूहि येनैषा लभ्यते मतिः।\nतन्मन्ये कारणं कर्म यत एषा प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101211, "chapter_id": 3179, "verse_number": "१४-३५-३x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101212, "chapter_id": 3179, "verse_number": "१४-३५-३", "content_sanskrit": "अरणीं ब्राह्मणीं विद्धि गुरुरस्योत्तरारणिः।\nतपःश्रुतेभिमथिनी ज्ञानाग्निर्जायते ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101213, "chapter_id": 3179, "verse_number": "१४-३५-४x", "content_sanskrit": "ब्राह्मणयुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101214, "chapter_id": 3179, "verse_number": "१४-३५-४", "content_sanskrit": "यदिदं ब्रह्मणो लिङ्गं क्षेत्रज्ञ इति संज्ञितम्।\nग्रहीतुं येन यच्छक्यं लक्षणं तस्य तद्वद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101215, "chapter_id": 3179, "verse_number": "१४-३५-५x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101216, "chapter_id": 3179, "verse_number": "१४-३५-५", "content_sanskrit": "अलिङ्गो निर्गुणश्चैव कारणं नास्य विग्रहे।\nउपायमेव वक्ष्यामि येन गृह्येत भावना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101217, "chapter_id": 3179, "verse_number": "१४-३५-६", "content_sanskrit": "सम्यगप्युपदिष्टस्य ह्यमृतस्येव तृप्यसे।\nकर्मबुद्धिरबुद्धित्वाज्ज्ञानलिङ्गान्निपातितः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101218, "chapter_id": 3179, "verse_number": "१४-३५-७", "content_sanskrit": "इदं कार्यमिदं नेति न मोक्षेषूपदिश्यते।\nपश्यतः शृण्वतो बुद्धिरात्मनैवोपजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101219, "chapter_id": 3179, "verse_number": "१४-३५-८", "content_sanskrit": "यावन्त इह शक्येरंस्तावतोंऽसान्प्रकल्पयेत्।\nअव्यक्तान्व्यक्तरूपांश्च शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101220, "chapter_id": 3179, "verse_number": "१४-३५-९", "content_sanskrit": "सर्वानुमानयुक्तांश्च सर्वान्प्रत्यक्षहेतुकान्।\nयतः परं न विद्येत ततोऽभ्यासे भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101221, "chapter_id": 3179, "verse_number": "१४-३५-१०x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101222, "chapter_id": 3179, "verse_number": "१४-३५-१०", "content_sanskrit": "ततस्तु तस्या ब्राह्मण्या मतिः क्षेत्रज्ञसंशये।\nक्षेत्रज्ञानेन परतः क्षेत्रज्ञोऽन्यः प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101223, "chapter_id": 3179, "verse_number": "१४-३५-११x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101224, "chapter_id": 3179, "verse_number": "१४-३५-११", "content_sanskrit": "क्व नु सा ब्राह्मणि कृष्ण क्व चासौ ब्राह्मणर्षभः।\nयाभ्यां सिद्धिरियं प्राप्ता तावुभौ वद मेऽच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101225, "chapter_id": 3179, "verse_number": "१४-३५-१२x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101226, "chapter_id": 3179, "verse_number": "१४-३५-१२", "content_sanskrit": "मनो मे ब्राह्मणं विद्धि बुद्धिं मे विद्धि ब्राह्मणीम्।\nक्षेत्रज्ञ इति यश्चोक्तः सोऽहमेव धनंजय॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101227, "chapter_id": 3179, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि पञ्चत्रिंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]