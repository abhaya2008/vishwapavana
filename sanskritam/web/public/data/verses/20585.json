[{"id": 7000585000, "chapter_id": 20585, "verse_number": "५-४४-१", "content_sanskrit": "शेष उवाच ।\nआगत्य सविधे रुद्रं समरांगणमूर्धनि ।\nजगाद हनुमान्वीरः संजिहीर्षुः सुराधिपम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000585001, "chapter_id": 20585, "verse_number": "५-४४-२", "content_sanskrit": "हनूमानुवाच ।\nत्वं यदाचरसे रुद्र धर्मस्य प्रतिकूलनम् ।\nतस्मात्त्वां शास्तुमिच्छामि रामभक्तवधोद्यतम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000585002, "chapter_id": 20585, "verse_number": "५-४४-३", "content_sanskrit": "मया पुरा श्रुतं देव ऋषिभिर्बहुधोदितम् ।\nरघुनाथपदस्मारी नित्यं रुद्रः पिनाकभृत्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000585003, "chapter_id": 20585, "verse_number": "५-४४-४", "content_sanskrit": "तत्सर्वं तु मृषा जातं शत्रुघ्नं प्रति युध्यतः ।\nपुष्कलो मे हतः शूरः शत्रुघ्नोऽपि विमूर्च्छितः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000585004, "chapter_id": 20585, "verse_number": "५-४४-५", "content_sanskrit": "तस्मात्त्वां पातयाम्यद्य त्रैलोक्यप्रलयोद्यतम् ।\nयत्नात्तिष्ठस्व भोः शर्व रामभक्तिपराङ्मुखः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000585005, "chapter_id": 20585, "verse_number": "५-४४-६", "content_sanskrit": "शेष उवाच ।\nइत्युक्तवंतं प्लवगं प्रोवाच स महेश्वरः ।\nधन्योऽसि वीरवर्यस्त्वं भवान्वदति नो मृषा॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000585006, "chapter_id": 20585, "verse_number": "५-४४-७", "content_sanskrit": "मत्स्वामी रामचंद्रोऽयं सुरासुरनमस्कृतः ।\nतदश्वमानयामास शत्रुघ्नः परवीरहा॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000585007, "chapter_id": 20585, "verse_number": "५-४४-८", "content_sanskrit": "तद्रक्षार्थं समायातस्तद्भक्त्या तु वशीकृतः ।\nयथाकथंचिद्भक्तोऽसौ रक्ष्यः स्वात्मा इति स्थितिः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000585008, "chapter_id": 20585, "verse_number": "५-४४-९", "content_sanskrit": "रघुनाथः कृपां कृत्वा विलोकय तु निस्त्रपम् ।\nमां स्वभक्त सुदुःखेन किंचित्कोपं दधन्महान्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000585009, "chapter_id": 20585, "verse_number": "५-४४-१०", "content_sanskrit": "शेष उवाच ।\nएवं वदति चंडीशे हनूमान्कुपितो भृशम् ।\nशिलामादाय महतीं ताडयामास तद्रथम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000585010, "chapter_id": 20585, "verse_number": "५-४४-११", "content_sanskrit": "शिलया ताडितस्तस्य रथः शकलतां गतः ।\nससूतः सहयः केतुपताकाभिः समन्वितः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000585011, "chapter_id": 20585, "verse_number": "५-४४-१२", "content_sanskrit": "नभःस्था देवताः सर्वाः प्रशशंसुः कपीश्वरम् ।\nधन्योसि प्लवगाधीश महत्कर्म त्वया कृतम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000585012, "chapter_id": 20585, "verse_number": "५-४४-१३", "content_sanskrit": "श्रीशिवं विरथं दृष्ट्वा नंदी तं समुपाद्रवत् ।\nउवाच श्रीमहादेवं मत्पृष्ठं गम्यतामिति॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000585013, "chapter_id": 20585, "verse_number": "५-४४-१४", "content_sanskrit": "वृषस्थितं तु भूतेशं हनूमान्कुपितो भृशम् ।\nशिलामुत्पाट्य तरसा प्राहनद्धृदये तदा॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000585014, "chapter_id": 20585, "verse_number": "५-४४-१५", "content_sanskrit": "तदाहतो भूतपतिः शूलं तीक्ष्णं समाददे ।\nजाज्वल्यमानं त्रिशिखं वह्निज्वालासमप्रभम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000585015, "chapter_id": 20585, "verse_number": "५-४४-१६", "content_sanskrit": "आयातं तन्महद्दृष्ट्वा शूलं प्रज्वलनप्रभम् ।\nहस्ते गृहीत्वा तरसा बभंज तिलशः क्षणात्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000585016, "chapter_id": 20585, "verse_number": "५-४४-१७", "content_sanskrit": "भग्ने त्रिशूले तरसा कपीन्द्रेण क्षणाच्छिवः ।\nशक्तिं करे समाधत्त सर्वलोहविनिर्मिताम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000585017, "chapter_id": 20585, "verse_number": "५-४४-१८", "content_sanskrit": "सा शक्तिः शिवनिर्मुक्ता हृदये तस्य धीमतः ।\nलग्ना क्षणादभूत्तत्र विक्लवः प्लवगाधिपः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000585018, "chapter_id": 20585, "verse_number": "५-४४-१९", "content_sanskrit": "क्षणाच्च तद्व्यथां तीर्त्वा गृहीत्वा वृक्षमुल्बणम् ।\nताडयामास हृदये महाव्यालविभूषिते॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000585019, "chapter_id": 20585, "verse_number": "५-४४-२०", "content_sanskrit": "ताडितास्तेन वीरेण फणीन्द्रास्त्रा समागताः ।\nइतस्ततस्ते तं मुक्त्वा गताः पातालमुज्जवाः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000585020, "chapter_id": 20585, "verse_number": "५-४४-२१", "content_sanskrit": "शिवस्तस्मिन्नगे मुक्ते वक्षसि स्वे निरीक्ष्य च ।\nकुपितो व्यदधाद्घोरं मुसलं करयुग्मके॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000585021, "chapter_id": 20585, "verse_number": "५-४४-२२", "content_sanskrit": "हतोसि गच्छ संग्रामात्पलाय्य प्लवगाधम ।\nएष ते प्राणहंताहं मुसलेन क्षणादिह॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000585022, "chapter_id": 20585, "verse_number": "५-४४-२३", "content_sanskrit": "मुसलं वीक्ष्य निर्मुक्तं शिवेन कुपितेन वै ।\nकीशस्तद्वंचयामास महावेगाद्धरिं स्मरन्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000585023, "chapter_id": 20585, "verse_number": "५-४४-२४", "content_sanskrit": "मुसलं तत्पपाताधः शिवमुक्तं महायसम् ।\nविदार्य पृथिवीं सर्वां जगाम च रसातलम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000585024, "chapter_id": 20585, "verse_number": "५-४४-२५", "content_sanskrit": "तदा प्रकुपितोऽत्यतं हनूमान्रामसेवकः ।\nगृहीत्वा पर्वतं हस्ते ताडयामास वक्षसि॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000585025, "chapter_id": 20585, "verse_number": "५-४४-२६", "content_sanskrit": "स यावत्पर्वतं छेत्तुं मतिं चक्रे सतीपतिः ।\nतावद्धतः कपींद्रेण शालेन बहुशाखिना॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000585026, "chapter_id": 20585, "verse_number": "५-४४-२७", "content_sanskrit": "तमपिच्छेत्तुमुद्युक्तो यावत्तावच्छिलाहतः ।\nशिलास्ता भेदितुं स्वांतं चकार मृड उद्यतः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000585027, "chapter_id": 20585, "verse_number": "५-४४-२८", "content_sanskrit": "तावद्वृष्टिं चकारायं शिलाभिर्नगपर्वतैः ।\nलांगूलेन च संवेष्ट्य ताडयत्येष भूतपम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000585028, "chapter_id": 20585, "verse_number": "५-४४-२९", "content_sanskrit": "शिलाभिः पर्वतैर्वृक्षैः पुच्छास्फोटेन भूरिशः ।\nनंदी प्राप्तो महात्रासं चंद्रोऽपि शकलीकृतः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000585029, "chapter_id": 20585, "verse_number": "५-४४-३०", "content_sanskrit": "अत्यंतं विह्वलो जातो महेशानः प्रकोपनः ।\nक्षणेक्षणे प्रहारेण विह्वलं कुर्वतं भृशम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000585030, "chapter_id": 20585, "verse_number": "५-४४-३१", "content_sanskrit": "जगाद प्लवगाधीशं धन्योसि रघुपानुग ।\nमहत्कर्म कृतं तेऽद्य यत्तेहं सुप्रतोषितः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000585031, "chapter_id": 20585, "verse_number": "५-४४-३२", "content_sanskrit": "न दानेन न यज्ञेन नाल्पेन तपसा ह्यहम् ।\nसुलभोऽस्मि महावेग तस्मात्प्रार्थय मे वरम्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000585032, "chapter_id": 20585, "verse_number": "५-४४-३३", "content_sanskrit": "शेष उवाच ।\nएवं ब्रुवंतं तं दृष्ट्वा हनूमान्निजगाद तम् ।\nप्रहसन्निर्भिया वाण्या महेशानं सुतोषितम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000585033, "chapter_id": 20585, "verse_number": "५-४४-३४", "content_sanskrit": "हनूमानुवाच ।\nरघुनाथप्रसादेन सर्वं मेऽस्ति महेश्वर ।\nतथापि याचे हि वरं त्वत्तः समरतोषितात्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000585034, "chapter_id": 20585, "verse_number": "५-४४-३५", "content_sanskrit": "एष पुष्कलसंज्ञो नः समरे पतितो हतः ।\nतथैव रामावरजः शत्रुघ्नो मूर्च्छितो रणे॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000585035, "chapter_id": 20585, "verse_number": "५-४४-३६", "content_sanskrit": "अन्ये च वीरा बहवः पतिताः शरविक्षताः ।\nमूर्च्छिताः पतिताः केचित्तान्रक्षस्व गणैः सह॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000585036, "chapter_id": 20585, "verse_number": "५-४४-३७", "content_sanskrit": "यथा चैतान्महाभूता वेतालाश्च पिशाचकाः ।\nन हरंति न खादंति श्वशृगालादयस्तथा॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000585037, "chapter_id": 20585, "verse_number": "५-४४-३८", "content_sanskrit": "एतेषां वपुषो भेदो न भवेत्त्वं तथाचर ।\nयावदिंद्रगणं जित्वा न यामि द्रोणपर्वतम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000585038, "chapter_id": 20585, "verse_number": "५-४४-३९", "content_sanskrit": "तत्रस्था औषधीर्वापि नीत्वा संस्थापितान्भटान् ।\nजीवयामि बलात्सर्वांस्तावत्त्वं रक्ष सर्वशः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000585039, "chapter_id": 20585, "verse_number": "५-४४-४०", "content_sanskrit": "एष गच्छामि तं नेतुं द्रोणं पर्वतसत्तमम् ।\nयस्मिन्वसंत्योषधयः प्राणिसंजीवनंकराः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000585040, "chapter_id": 20585, "verse_number": "५-४४-४१", "content_sanskrit": "एतद्वचः समाकर्ण्य तथेति निजगाद तम् ।\nयाहि शीघ्रं नगं तं तु रक्षामि त्वद्भटान्मृतान्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000585041, "chapter_id": 20585, "verse_number": "५-४४-४२", "content_sanskrit": "तच्छ्रुत्वा वाक्यमीशस्य जगाम द्रोणपर्वतम् ।\nद्वीपान्सर्वानतिक्रम्य जगाम क्षीरसागरम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000585042, "chapter_id": 20585, "verse_number": "५-४४-४३", "content_sanskrit": "अत्र तु स्वगणैश्चायं रक्षति स्म शिवो महान् ।\nश्मशानं तद्गणैः स्वीयैर्महाबलपराक्रमैः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000585043, "chapter_id": 20585, "verse_number": "५-४४-४४", "content_sanskrit": "हनूमान्द्रोणमासाद्य द्रोणंनाम महागिरिम् ।\nलांगूले तं निधायाशु प्रतस्थे रणमंडलम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000585044, "chapter_id": 20585, "verse_number": "५-४४-४५", "content_sanskrit": "तं नेतुमुद्यते विप्र चकंपे स च पर्वतः ।\nकंपमानं तु तं दृष्ट्वा तत्पाला देवतागणाः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000585045, "chapter_id": 20585, "verse_number": "५-४४-४६", "content_sanskrit": "हाहेति कृत्वा प्रोचुस्ते किमिदं भविता गिरौ ।\nको ह्येनं नयते वीरो महाबलपराक्रमः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000585046, "chapter_id": 20585, "verse_number": "५-४४-४७", "content_sanskrit": "एवं कृत्वा सुराः सर्वे संहता ददृशुः कपिम् ।\nमुंचैनमिति तं प्रोच्य जघ्नुः शस्त्रास्त्रकोटिभिः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000585047, "chapter_id": 20585, "verse_number": "५-४४-४८", "content_sanskrit": "तान्सर्वान्निघ्नतो दृष्ट्वा हनूमान्कुपितो भृशम् ।\nजघान तान्क्षणाद्वीरः शक्रः सर्वासुरान्यथा॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000585048, "chapter_id": 20585, "verse_number": "५-४४-४९", "content_sanskrit": "केचित्पदाहतास्तत्र केचित्करविमर्दिताः ।\nलांगूलेन हताः केचित्केचिच्छृंगेण चाहताः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000585049, "chapter_id": 20585, "verse_number": "५-४४-५०", "content_sanskrit": "सर्वे ते नाशमापन्नाः क्षणात्कीशेन ताडिताः ।\nकेचिन्निपतिता भूमौ रुधिरेण परिप्लुताः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000585050, "chapter_id": 20585, "verse_number": "५-४४-५१", "content_sanskrit": "केचित्कीशभयात्त्रस्ता जग्मुः शक्रं सुराधिपम् ।\nक्षतेन च परिप्लुष्टा रुधिरक्षतदेहिनः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000585051, "chapter_id": 20585, "verse_number": "५-४४-५२", "content_sanskrit": "तान्दृष्ट्वा भयसंविग्नान्रुधिरेण परिप्लुतान् ।\nसुराञ्जगाद विमनाः शक्रः सर्वसुरोत्तमः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000585052, "chapter_id": 20585, "verse_number": "५-४४-५३", "content_sanskrit": "कथं यूयं भयत्रस्ताः कथं रुधिरविप्लुताः ।\nकेन दैत्येन निहता राक्षसेनाधमेन वा॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000585053, "chapter_id": 20585, "verse_number": "५-४४-५४", "content_sanskrit": "सर्वं शंसत मे तथ्यं यथा ज्ञात्वा व्रजामि तम् ।\nनिहत्य बद्ध्वा चायामि युष्मद्घातकमुन्मदम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000585054, "chapter_id": 20585, "verse_number": "५-४४-५५", "content_sanskrit": "इति वाक्यं समाकर्ण्य तुरासाहं सुरोत्तमाः ।\nजगदुर्दीनया वाचा सुरासुरनमस्कृतम्॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000585055, "chapter_id": 20585, "verse_number": "५-४४-५६", "content_sanskrit": "देवा ऊचुः ।\nइहागत्य न जानीमः कश्चिद्वानररूपधृक् ।\nनेतुं द्रोणं समुद्युक्तो लांगूले वेष्ट्य तं गिरिम्॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000585056, "chapter_id": 20585, "verse_number": "५-४४-५७", "content_sanskrit": "गंतुं कृतमतिस्तावद्वयं सर्वे सुसंहताः ।\nयुद्धं चक्रुः सुसंनद्धाः सर्वशस्त्रास्त्रवर्षिणः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000585057, "chapter_id": 20585, "verse_number": "५-४४-५८", "content_sanskrit": "तेन सर्वे वयं युद्धे निर्जिता बलशालिना ।\nअनेके निहतास्तत्र भूमौ पेतुः सुरोत्तमाः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000585058, "chapter_id": 20585, "verse_number": "५-४४-५९", "content_sanskrit": "वयं तु बहुभिः पुण्यैर्जीविता इह चागताः ।\nशोणितेन सुसिक्तांगाः क्षतपीडासमन्विताः॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000585059, "chapter_id": 20585, "verse_number": "५-४४-६०", "content_sanskrit": "एतद्वाक्यं समाकर्ण्य सुराणां स पुरंदरः ।\nआदिदेश सुरान्सर्वान्महाबलसमन्वितान्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000585060, "chapter_id": 20585, "verse_number": "५-४४-६१", "content_sanskrit": "यात महाद्रोणगिरिं कपिं बद्धुं महाबलम् ।\nबद्ध्वा नयत यूयं वै सुराणां रणपातकम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000585061, "chapter_id": 20585, "verse_number": "५-४४-६२", "content_sanskrit": "इत्याज्ञप्ता ययुस्ते वै द्रोणं पर्वतसत्तमम् ।\nयत्रास्ते बलवान्वीरो हनूमान्कपिसत्तमः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000585062, "chapter_id": 20585, "verse_number": "५-४४-६३", "content_sanskrit": "गत्वा ते प्राहरन्सर्वे हनूमंतं महाबलम् ।\nहनूमता ते निहता मुष्टिभिः करताडनैः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000585063, "chapter_id": 20585, "verse_number": "५-४४-६४", "content_sanskrit": "पतितास्ते क्षणात्तत्र रुधिरक्षतविग्रहाः ।\nअन्ये पलायनपरा जग्मुस्ते त्रिदिवेश्वरम्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000585064, "chapter_id": 20585, "verse_number": "५-४४-६५", "content_sanskrit": "तच्छ्रुत्वा कुपितः शक्रः सर्वानमरसत्तमान् ।\nआदिदेश महावीरं वानरेंद्रं सुरोत्तमः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000585065, "chapter_id": 20585, "verse_number": "५-४४-६६", "content_sanskrit": "तदाज्ञप्ता ययुस्ते वै यत्र कीशेश्वरो बली ।\nतान्सर्वानागतान्दृष्ट्वा जगाद कपिसत्तमः॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000585066, "chapter_id": 20585, "verse_number": "५-४४-६७", "content_sanskrit": "मायां तु वीराः समरे संहर्तारं हि मां बलात् ।\nनेष्यामि युष्मानधुना संयमिन्याः पुरोंऽतिके॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000585067, "chapter_id": 20585, "verse_number": "५-४४-६८", "content_sanskrit": "इत्युक्ता अपि ते सर्वे सन्नद्धाः प्राहरन्कपिम् ।\nशस्त्रास्त्रैर्बहुधा मुक्तैर्महाबलसमन्विताः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000585068, "chapter_id": 20585, "verse_number": "५-४४-६९", "content_sanskrit": "केचिच्छूलैः परशुभिः केचित्खड्गैश्च पट्टिशैः ।\nमुसलैः शक्तिभिः केचित्क्रोधेन कलुषीकृताः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000585069, "chapter_id": 20585, "verse_number": "५-४४-७०", "content_sanskrit": "स आहतोऽमरवरैर्विविधैरायुधैर्बली ।\nशिलाभिस्ताञ्जघानाशु सर्वानमरसत्तमान्॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000585070, "chapter_id": 20585, "verse_number": "५-४४-७१", "content_sanskrit": "केचित्पलाय्य आहुस्ते गताः शक्रसमीपकम् ।\nतदुक्तं वाक्यमाकर्ण्य भयं प्राप सुराधिपः॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000585071, "chapter_id": 20585, "verse_number": "५-४४-७२", "content_sanskrit": "बृहस्पतिं सुराध्यक्षं मंत्रिणं स्वर्गवासिनाम् ।\nपप्रच्छ सविधे गत्वा नत्वा सुरगुरुं वरम्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000585072, "chapter_id": 20585, "verse_number": "५-४४-७३", "content_sanskrit": "इंद्र उवाच ।\nकोऽसौ यो वानरो द्रोणं नेतुं स्वामिन्समागतः ।\nयेन मे निहता वीरा अमराः शस्त्रधारिणः॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000585073, "chapter_id": 20585, "verse_number": "५-४४-७४", "content_sanskrit": "शेष उवाच ।\nएतच्छ्रुत्वा तु तद्वाक्यमुक्तमांगिरसो महान् ।\nजगाद भयसंविग्नं तुरासाहं सुराधिपम्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000585074, "chapter_id": 20585, "verse_number": "५-४४-७५", "content_sanskrit": "बृहस्पतिरुवाच ।\nयो रावणमहन्संख्ये कुंभकर्णमदीदहत् ।\nयेन ते वैरिणः सर्वे हतास्तस्यैव सेवकः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000585075, "chapter_id": 20585, "verse_number": "५-४४-७६", "content_sanskrit": "येन लंका सत्रिकूटा निर्दग्धा पुच्छवह्निना ।\nअक्षश्च निहतो येन हनूमंतमवेहि तम्॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000585076, "chapter_id": 20585, "verse_number": "५-४४-७७", "content_sanskrit": "तेन सर्वे विनिहता द्रोणार्थमयमुद्यतः ।\nहयमेधं महाराजः करोति बलिसत्तमः॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000585077, "chapter_id": 20585, "verse_number": "५-४४-७८", "content_sanskrit": "तस्याश्वं शिवभक्तस्तु नृपो वीरमणिर्महान् ।\nजहार तत्र समभूद्रणं सुरविमोहनम्॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000585078, "chapter_id": 20585, "verse_number": "५-४४-७९", "content_sanskrit": "शिवेन निहताः संख्ये वीरा रामस्य भूरिशः ।\nतान्वै जीवयितुं द्रोणं नेष्यत्येव महाबलः॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000585079, "chapter_id": 20585, "verse_number": "५-४४-८०", "content_sanskrit": "नायं वर्षशतैर्जेयो भवता बलसंयुतः ।\nतस्मात्प्रसादय कपिं देहि तत्रत्यमौषधम्॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]