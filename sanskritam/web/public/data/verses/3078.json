[{"id": 2096902, "chapter_id": 3078, "verse_number": "१३-२०८-१", "content_sanskrit": "महेश्वर उवाच।\nहन्त ते कथयिष्यामि यत्ते देवि मनःप्रियम्।\nशृणु तत्सर्वमखिलं धर्मं वर्णाश्रमाश्रितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096903, "chapter_id": 3078, "verse_number": "१३-२०८-२", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याः शुद्राश्चेति चतुर्विधम्।\nब्राह्मणा विहिताः पूर्वं लोकतन्त्रमभीप्सता।\nकर्माणि च तदर्हाणि शास्त्रेषु विहितानि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096904, "chapter_id": 3078, "verse_number": "१३-२०८-३", "content_sanskrit": "यदीदमेकवर्णं स्याज्जगत्सर्वं विनश्यति।\nसहैव देवि वर्णानि चत्वारि विहितान्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096905, "chapter_id": 3078, "verse_number": "१३-२०८-४", "content_sanskrit": "मुखतो ब्राह्मणाः सृष्टस्तस्मात्ते वाग्विशारदाः।\nबाहुभ्यां क्षत्रियाः सृष्टास्तस्मात्ते बाहुगर्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096906, "chapter_id": 3078, "verse_number": "१३-२०८-५", "content_sanskrit": "ऊरुभ्यामुद्गता वैश्यास्तस्माद्वार्तोपजीविनः।\nशूद्राश्च पादतः सृष्टास्तस्मात्ते परिचाकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096907, "chapter_id": 3078, "verse_number": "१३-२०८-६", "content_sanskrit": "तेषां धर्मांश्च कर्माणि शृणु देवि समाहिता।\nविप्राः कृता भूमिदेवा लोकानां धारणे कृताः।\nते कैश्चिन्नावमन्तव्या ब्राह्मणा हितमिच्छुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096908, "chapter_id": 3078, "verse_number": "१३-२०८-७", "content_sanskrit": "यदि ते ब्राह्मणा न स्युर्दानयोगवहाः सदा।\nउभयोर्लोकयोर्देवि स्थितिर्न स्यात्समासतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096909, "chapter_id": 3078, "verse_number": "१३-२०८-८", "content_sanskrit": "लोकेषु दुर्लभं किंतु ब्राह्मणत्वमिति स्मृतम्।\nअबुधो वा दरिद्रो वा पूजनीयः सदैव सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096910, "chapter_id": 3078, "verse_number": "१३-२०८-९", "content_sanskrit": "ब्राह्मणान्योऽवमन्येत निन्देच्च क्रोधयेच्च वा।\nप्रहरेत हरेद्वाऽपि धनं तेषां नराधमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096911, "chapter_id": 3078, "verse_number": "१३-२०८-१०", "content_sanskrit": "कारयेद्धीनकर्मणि कामलोभविमोहनात्।\nस च मामवमन्येत मां क्रोधयति निन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096912, "chapter_id": 3078, "verse_number": "१३-२०८-११", "content_sanskrit": "मामेव प्रहरेन्मूढो मद्धनस्यापहारकः।\nमामेव प्रेषणं कृत्वा निदन्ते मूढचेतनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096913, "chapter_id": 3078, "verse_number": "१३-२०८-१२", "content_sanskrit": "स्वाध्यायो यजनं दानं तस्य धर्म इति स्थितिः।\nकर्मण्यध्यापनं चैव याजनं च प्रतिग्रहः।\nसत्यं शान्तिस्तपः शौचं तस्य धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096914, "chapter_id": 3078, "verse_number": "१३-२०८-१३", "content_sanskrit": "विक्रयो रसधान्यानां ब्राह्मणस्य विगर्हितः।\nअनापदि च शूद्रान्नं वृषलीसङ्ग्रहस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096915, "chapter_id": 3078, "verse_number": "१३-२०८-१४", "content_sanskrit": "तप एव सदा धर्मो ब्राह्मणस्य न संशयः।\nस तु धर्मार्थमुत्पन्नः पूर्वं धात्रा तपोबलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096916, "chapter_id": 3078, "verse_number": "१३-२०८-१५", "content_sanskrit": "तस्योपनयनं धर्मो नित्यं चोदकधारणम्।\nशास्त्रस्य श्रवणं धर्मो देवव्रतनिषेवणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096917, "chapter_id": 3078, "verse_number": "१३-२०८-१६", "content_sanskrit": "अग्निकार्यं परो धर्मो नित्ययज्ञोपवीतिता।\nशूद्रान्नवर्जनं धर्मो धर्मः सत्पथसेवनम्।\nधर्मो नित्योपवासित्वं ब्रह्मचर्यं परं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096918, "chapter_id": 3078, "verse_number": "१३-२०८-१७", "content_sanskrit": "गृहस्थस्य परो धर्मो गृहस्थाश्रमिणस्तथा।\nगृहसम्मार्जनं धर्म आलेपनविधिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096919, "chapter_id": 3078, "verse_number": "१३-२०८-१८", "content_sanskrit": "अतिथिप्रियता धर्मो धर्मस्त्रेताग्निधारणम्।\nइष्टिर्वा पशुबन्धाश्च विधिपूर्वं परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096920, "chapter_id": 3078, "verse_number": "१३-२०८-१९", "content_sanskrit": "दम्पत्योः समशीलत्वं धर्मो वै गृहमेधिनाम्।\nएवं द्विजन्मनो धर्मो गार्हस्थ्ये धर्मधारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096921, "chapter_id": 3078, "verse_number": "१३-२०८-२०", "content_sanskrit": "यस्तु क्षत्रगतो धर्मस्त्वया देवि प्रयोदितः।\nतमहं ते प्रवक्ष्यामि शृणु देवि समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096922, "chapter_id": 3078, "verse_number": "१३-२०८-२१", "content_sanskrit": "क्षत्रियास्तु ततो देवि द्विजानां पालने स्मृताः।\nयदि निःक्षत्रियो लोको जगत्स्यादधरोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096923, "chapter_id": 3078, "verse_number": "१३-२०८-२२", "content_sanskrit": "रक्षणात्क्षत्रियैरेव जगद्भवति शाश्वतम्।\nतस्याप्यध्ययनं दानं यजनं धर्मतः स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096924, "chapter_id": 3078, "verse_number": "१३-२०८-२३", "content_sanskrit": "दीनानां रक्षणं चैव पापनामनुशासनम्।\nसतां सम्पोषणं चैव कर्मषण्मार्गजीवनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096925, "chapter_id": 3078, "verse_number": "१३-२०८-२४", "content_sanskrit": "उत्साहः शस्त्रजीवित्वं तस्य धर्मः सनातनः।\nभृत्यानां भरणं धर्मः कृते कर्मण्यमोघता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096926, "chapter_id": 3078, "verse_number": "१३-२०८-२५", "content_sanskrit": "सम्यग्गुणयुतो धर्मो धर्मः पौरहितक्रिया।\nव्यवहारस्थितिर्नित्यं गुणयुक्तो महीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096927, "chapter_id": 3078, "verse_number": "१३-२०८-२६", "content_sanskrit": "आर्तवित्तप्रदो राजा धर्मं प्राप्नोत्यनुत्तमम्।\nएवं तैर्विहितः पूर्वैर्धर्मः कर्मविधानतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096928, "chapter_id": 3078, "verse_number": "१३-२०८-२७", "content_sanskrit": "तथैव देवि वैश्याश्च लोकयात्राहिताः स्मृताः।\nअन्ये तानुपजीवन्ति प्रत्यक्षफलदा हि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2096929, "chapter_id": 3078, "verse_number": "१३-२०८-२८", "content_sanskrit": "यदि न स्युस्तथा वैश्या न भवेयुस्तथा परे।\nतेषामध्ययनं दानं गजनं धर्म उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2096930, "chapter_id": 3078, "verse_number": "१३-२०८-२९", "content_sanskrit": "वैश्यस्य सततं धर्मः पाशुपाल्यं कृषिस्तथा।\nअग्निहोत्रपरिस्पन्दास्त्रयो वर्णा द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2096931, "chapter_id": 3078, "verse_number": "१३-२०८-३०", "content_sanskrit": "वाणिज्यं सत्पथे स्थानमातिथेयत्वमेव च।\nविप्राणां स्वागतन्यायो वैश्यधर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2096932, "chapter_id": 3078, "verse_number": "१३-२०८-३१", "content_sanskrit": "तिलगन्धरसाश्चैव न विक्रेयाः कथञ्चन।\nवणिक्पथमुपासद्भिर्वैश्यैर्वैश्यपथि स्थितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2096933, "chapter_id": 3078, "verse_number": "१३-२०८-३२", "content_sanskrit": "सर्वातिथ्यं त्रिवर्गस्य यथाशक्ति दिवानिशम्।\nएवं ते विहिता देवि लोकयात्रा स्वयंभुवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2096934, "chapter_id": 3078, "verse_number": "१३-२०८-३३", "content_sanskrit": "तथैव शूद्रा विहिताः सर्वधर्मप्रसाधकाः।\nशूद्राश्च यदि ते न स्युः कर्मकर्ता न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2096935, "chapter_id": 3078, "verse_number": "१३-२०८-३४", "content_sanskrit": "त्रयः पूर्वे शूद्रमूलाः सर्वे कर्मकराः स्मृताः।\nब्राह्मणादिषु शुश्रूषा दासधर्म इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2096936, "chapter_id": 3078, "verse_number": "१३-२०८-३५", "content_sanskrit": "वार्ता च कारुकर्माणि शिल्यं नाट्यं तथैव च।\nअहिंसकः शुभाचारो देवतद्विजवन्दकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2096937, "chapter_id": 3078, "verse_number": "१३-२०८-३६", "content_sanskrit": "शूद्रो धर्मफलैरिष्टैः स्वधर्मेणोपपद्यते।\nएवमादि तथाऽन्यच्च शूद्रधर्म इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2096938, "chapter_id": 3078, "verse_number": "१३-२०८-३७", "content_sanskrit": "तेऽप्येवं विहिता लोके कर्मयोग्याः शुभानने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2096939, "chapter_id": 3078, "verse_number": "१३-२०८-३८", "content_sanskrit": "एवं चतुर्णां वर्णानां वर्णलोकाः परत्र च।\nविहिताश्च तथा दृष्टा यथावद्धर्मचारिणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2096940, "chapter_id": 3078, "verse_number": "१३-२०८-३९", "content_sanskrit": "एष वर्णाश्रयो धर्मः कर्म चैव तदर्पणम्।\nकथितं श्रोतुकामायाः किं भूयः श्रोतुमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2096941, "chapter_id": 3078, "verse_number": "१३-२०८-४०x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2096942, "chapter_id": 3078, "verse_number": "१३-२०८-४०", "content_sanskrit": "भगवन्देवदेवेश नमस्ते वृषभध्वज।\nश्रोतुमिच्छाम्यहं देव धर्ममाश्रमिणां विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2096943, "chapter_id": 3078, "verse_number": "१३-२०८-४१x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2096944, "chapter_id": 3078, "verse_number": "१३-२०८-४१", "content_sanskrit": "तथाऽऽश्रमगतं धर्मं शृणु देवि समाहिता।\nआश्रमाणां तु यो धर्मः क्रियते ब्रह्मवादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2096945, "chapter_id": 3078, "verse_number": "१३-२०८-४२", "content_sanskrit": "गृहस्थः प्रवरस्तेषां गार्हस्थ्यं धर्ममाश्रितः।\nपञ्चयज्ञक्रियाशौचं दारतुष्टिरतन्द्रिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2096946, "chapter_id": 3078, "verse_number": "१३-२०८-४३", "content_sanskrit": "ऋतुकालाभिगमनं दानयज्ञतपांसि च।\nअविप्रवासस्तस्येष्टः स्वाध्यायश्वाग्निपूर्वकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2096947, "chapter_id": 3078, "verse_number": "१३-२०८-४४", "content_sanskrit": "अतिथीनामाभिमुख्यं शक्त्या चेष्टनिमन्त्रणम्।\nअनुग्रहश्च सर्वेषां मनोवाक्कायकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2096948, "chapter_id": 3078, "verse_number": "१३-२०८-४५", "content_sanskrit": "एवमादि शुभं चान्यत्कुर्यात्तद्वृत्तिमान्गृही।\nएवं सञ्चरतस्तस्य पुण्यलोका न संशयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2096949, "chapter_id": 3078, "verse_number": "१३-२०८-४६", "content_sanskrit": "तथैव वानप्रस्थस्य धर्माः प्रोक्ताः सनातनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2096950, "chapter_id": 3078, "verse_number": "१३-२०८-४७", "content_sanskrit": "गृहवासं समुत्सृकज्य निश्चित्यैकमनाः शुभैः।\nवन्यैरेव तदाहारैः वर्तयेदिति च स्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2096951, "chapter_id": 3078, "verse_number": "१३-२०८-४८", "content_sanskrit": "भूमिशय्या जटाश्मश्रुचर्मवल्कलधारणम्।\nदेवतातिथिसत्कारो महाकृच्छ्राभिपूजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2096952, "chapter_id": 3078, "verse_number": "१३-२०८-४९", "content_sanskrit": "अग्निहोत्रं त्रिषवणं नित्यं तस्य विधीयते।\nब्रह्मचर्यं क्षमा शौचं तस्य धर्मः सनातनः।\nएवं स विगते प्राणे देवलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2096953, "chapter_id": 3078, "verse_number": "१३-२०८-५०", "content_sanskrit": "यतिधर्मास्तथा देवि गृहांस्त्यक्त्वा यतस्ततः।\nआकिञ्चन्यमनारम्भः सर्वतः शौचमार्जवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2096954, "chapter_id": 3078, "verse_number": "१३-२०८-५१", "content_sanskrit": "सर्वत्र भैक्षचर्या च सर्वत्रैव विवासनम्।\nसदा ध्यानपरत्वं च देहशुद्धिः क्षमा दया।\nतत्वानुगतबुद्धित्वं तस्य धर्मविधिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2096955, "chapter_id": 3078, "verse_number": "१३-२०८-५२", "content_sanskrit": "ब्रह्मचारी च यो देवि जन्मप्रभृति भिक्षितः।\nब्रह्मचर्यपरो भूत्वा साधयेद्गुरुमात्मनः।\nसर्वकालेषु सर्वत्र गुरुपूजां समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2096956, "chapter_id": 3078, "verse_number": "१३-२०८-५३", "content_sanskrit": "भैक्षचर्याग्निकार्यं च सदा जलनिषेवणम्।\nस्वाध्यायः सततं तस्य एष धर्मः सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2096957, "chapter_id": 3078, "verse_number": "१३-२०८-५४", "content_sanskrit": "तस्य चेष्टा तु गुर्वर्थमाप्राणान्तमिति स्थितिः।\nगुरोरभावे तत्पुत्रे गुरुवद्वृत्तिमाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2096958, "chapter_id": 3078, "verse_number": "१३-२०८-५५", "content_sanskrit": "एवं सोप्यमलाँल्लोकान्ब्राह्मणः प्रतिपद्यते।\nएष ते कथितो देवि धर्मश्चाश्रमवासिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2096959, "chapter_id": 3078, "verse_number": "१३-२०८-५६", "content_sanskrit": "चतुर्णामाश्रमो युक्तो लोक इत्येव विद्यते।\nकथितं ते समासेन किं भूयः श्रोतुमिच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2096960, "chapter_id": 3078, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि अष्टोत्तरद्विशततमोऽध्यायः॥ २०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]