[{"id": 2127261, "chapter_id": 3730, "verse_number": "", "content_sanskrit": "भीमेन नळस्य सत्कारः । ऋतुपर्णेन प्रीतिवचनमुक्त्वागमनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2127262, "chapter_id": 3730, "verse_number": "", "content_sanskrit": "बृहदश्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2127263, "chapter_id": 3730, "verse_number": "१", "content_sanskrit": "अथ रात्र्यां व्यतीतायां नळो राजा विशांपते ।\nवैदर्भ्या सहितः काल्यं ददर्श वसुधाधिपम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2127264, "chapter_id": 3730, "verse_number": "२", "content_sanskrit": "ततोऽभिवादयामास प्रयतः श्वशुरं नळः ।\nतस्यानु दमयन्ती च ववन्दे पितरं शुभा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2127265, "chapter_id": 3730, "verse_number": "३", "content_sanskrit": "तं भीमः प्रतिजग्राह पुत्रवत् परया मुदा ।\nयथार्हं पूजयित्वा तं समाश्वासयत प्रभुम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2127266, "chapter_id": 3730, "verse_number": "४", "content_sanskrit": "नळेन सहितां तत्र दमयन्तीं पतिव्रताम् ।\nअनुजग्राह महता सत्कारेण क्षितीश्वरः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2127267, "chapter_id": 3730, "verse_number": "५", "content_sanskrit": "तामर्हणां नळो राजा प्रतिगृह्य यथाविधि ।\nपरिचर्यां स्वकां तस्मै यथावत् प्रत्यवेदयत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2127268, "chapter_id": 3730, "verse_number": "६", "content_sanskrit": "ततो बभूव नगरे सुमहान् हर्षनिस्वनः ।\nजनस्य सम्प्रहृष्टस्य नळं दृष्ट्वा तथाऽगतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2127269, "chapter_id": 3730, "verse_number": "७", "content_sanskrit": "अशोभयच्च नगरीं पताकाध्वजमालिनीम् ।\nसिक्ताःसुमृष्टपुष्पाढ्या राजमार्गास्तथाकृताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2127270, "chapter_id": 3730, "verse_number": "८", "content_sanskrit": "द्वारिद्वारि च पौराणां पुष्पभङ्गः प्रकल्पितः ।\nअर्चितानि च वेश्मानि दैवतायतनानि च \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2127271, "chapter_id": 3730, "verse_number": "९", "content_sanskrit": "ऋतुपर्णोऽपि शुश्राव बाहुकच्छद्मिनं नळम् ।\nदमयन्त्या समायुक्तं जहृषे च परन्तपः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2127272, "chapter_id": 3730, "verse_number": "१०", "content_sanskrit": "तमानाय्य नळं राजा क्षमयामास पार्थिवम् ।\nस च तं क्षमयामास हेतुभिर्बुद्धिसम्मतैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2127273, "chapter_id": 3730, "verse_number": "११", "content_sanskrit": "स सत्कृतो महीपालो नैषधं विस्मिताननः ।\nदिष्ट्या समेतो दारैस्त्वमित्युवाच नळं नृपः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2127274, "chapter_id": 3730, "verse_number": "१२", "content_sanskrit": "कच्चिन्न नापराधं ते कृतवानस्मि नैषध ।\nअज्ञातवासं वसतो मद्गृहे निषधाधिप\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2127275, "chapter_id": 3730, "verse_number": "१३", "content_sanskrit": "यदि वाऽबुद्धिपूर्वाणि यदि बुद्ध्याऽपि कर्हिचित् ।\nमया कृतान्यकार्याणि तानि त्वं क्षन्तुमर्हसि\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2127276, "chapter_id": 3730, "verse_number": "", "content_sanskrit": "नळः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2127277, "chapter_id": 3730, "verse_number": "१४", "content_sanskrit": "न मेऽपराधं कृतवांस् त्वं स्वल्पमपि पार्थिव ।\nकृतेऽपि च न मे कोपः क्षन्तव्यं हि मया तव\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2127278, "chapter_id": 3730, "verse_number": "१५", "content_sanskrit": "पूर्वं ह्यपि सखा चासि सम्बन्धी च नराधिप ।\nअत ऊर्ध्वं च भूयस्त्वं प्रीतिमाहर्तुमर्हसि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2127279, "chapter_id": 3730, "verse_number": "१६", "content_sanskrit": "सर्वकामैः सुविहितः सुखमस्म्युषितस्त्वयि ।\nन तथा स्वगृहे राजन् यथा तव गृहे सदा \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2127280, "chapter_id": 3730, "verse_number": "१७", "content_sanskrit": "इदं चैव हयज्ञानं त्वदीयं मम तिष्ठति ।\nतदुपाकर्तुमिच्छामि मन्यसे यदि पार्थिव \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2127281, "chapter_id": 3730, "verse_number": "१८", "content_sanskrit": "एवमुक्त्वा ददौ विद्यामृतुपर्णाय नैषधः ।\nस च तां प्रतिजग्राह विधिदृष्टेन कर्मणा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2127282, "chapter_id": 3730, "verse_number": "१९", "content_sanskrit": "ततो गृह्याश्वहृदयं प्रीतो भार्गस्वरिर्नृप ।\nसूतमन्यमुपादाय प्रययौ स्वां पुरीं प्रति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2127283, "chapter_id": 3730, "verse_number": "२०", "content_sanskrit": "ऋतुपर्णे प्रतिगते नळो राजा विशांपते ।\nनगरे कुण्डिने कालं नातिदीर्घमिवावसत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2127284, "chapter_id": 3730, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nवनपर्वणि द्विसप्ततितमोऽध्यायः ॥७२॥\n॥ तीर्थयात्रापर्वणि अष्टाविंशोऽध्यायः ॥२८॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]