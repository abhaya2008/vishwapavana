[{"id": 5000470000, "chapter_id": 9470, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे त्रिषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000470001, "chapter_id": 9470, "verse_number": "६-६३-१", "content_sanskrit": "तस्य राक्षसराजस्य निशम्य परिदेवितम्।\nकुम्भकर्णो बभाषेदं वचनं प्रजहास च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000470002, "chapter_id": 9470, "verse_number": "६-६३-२", "content_sanskrit": "दृष्टो दोषो हि योऽस्माभिः पुरा मन्त्रविनिर्णये।\nहितेष्वनभियुक्तेन सोऽयमासादितस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000470003, "chapter_id": 9470, "verse_number": "६-६३-३", "content_sanskrit": "शीघ्रं खल्वभ्युपेतं त्वां फलं पापस्य कर्मणः।\nनिरयेष्वेव पतनं यथा दुष्कृतकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000470004, "chapter_id": 9470, "verse_number": "६-६३-४", "content_sanskrit": "प्रथमं वै महाराज कृत्यमेतदचिन्तितम्।\nकेवलं वीर्यदर्पेण नानुबन्धो विचारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000470005, "chapter_id": 9470, "verse_number": "६-६३-५", "content_sanskrit": "यः पश्चात्पूर्वकार्याणि कुर्यादैश्वर्यमास्थितः।\nपूर्वं चोत्तरकार्याणि न स वेद नयानयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000470006, "chapter_id": 9470, "verse_number": "६-६३-६", "content_sanskrit": "देशकालविहीनानि कर्माणि विपरीतवत्।\nक्रियमाणानि दुष्यन्ति हवींष्यप्रयतेष्विव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000470007, "chapter_id": 9470, "verse_number": "६-६३-७", "content_sanskrit": "त्रयाणां पञ्चधा योगं कर्मणां यः प्रपद्यते।\nसचिवैः समयं कृत्वा स सम्यग् वर्तते पथि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000470008, "chapter_id": 9470, "verse_number": "६-६३-८", "content_sanskrit": "यथागमं च यो राजा समयं च चिकीर्षति।\nबुध्यते सचिवैर्बुद्ध्या सुहृदश्चानुपश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000470009, "chapter_id": 9470, "verse_number": "६-६३-९", "content_sanskrit": "धर्ममर्थं हि कामं वा सर्वान् वा रक्षसां पते।\nभजेत पुरुषः काले त्रीणि द्वन्द्वानि वा पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000470010, "chapter_id": 9470, "verse_number": "६-६३-१०", "content_sanskrit": "त्रिषु चैतेषु यच्छ्रेष्ठं श्रुत्वा तन्नावबुध्यते।\nराजा वा राजमात्रो वा व्यर्थं तस्य बहुश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000470011, "chapter_id": 9470, "verse_number": "६-६३-११", "content_sanskrit": "उपप्रदानं सान्त्वं च भेदं काले च विक्रमम्।\nयोगं च रक्षसां श्रेष्ठ तावुभौ च नयानयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000470012, "chapter_id": 9470, "verse_number": "६-६३-१२", "content_sanskrit": "काले धर्मार्थकामान् यः सम्मन्त्र्य सचिवैः सह।\nनिषेवेतात्मवाँल्लोके न स व्यसनमाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000470013, "chapter_id": 9470, "verse_number": "६-६३-१३", "content_sanskrit": "हितानुबन्धमालोक्य कुर्यात् कार्यमिहात्मनः।\nराजा सहार्थतत्त्वज्ञैः सचिवैर्बुद्धिजीविभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000470014, "chapter_id": 9470, "verse_number": "६-६३-१४", "content_sanskrit": "अनभिज्ञाय शास्त्रार्थान् पुरुषाः पशुबुद्धयः।\nप्रागल्भ्याद् वक्तुमिच्छन्ति मन्त्रिष्वभ्यन्तरीकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000470015, "chapter_id": 9470, "verse_number": "६-६३-१५", "content_sanskrit": "अशास्त्रविदुषां तेषां कार्यं नाभिहितं वचः।\nअर्थशास्त्रानभिज्ञानां विपुलां श्रियमिच्छताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000470016, "chapter_id": 9470, "verse_number": "६-६३-१६", "content_sanskrit": "अहितं च हिताकारं धार्ष्ट्याज्जल्पन्ति ये नराः।\nअवश्यं मन्त्रबाह्यास्ते कर्तव्याः कृत्यदूषकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000470017, "chapter_id": 9470, "verse_number": "६-६३-१७", "content_sanskrit": "विनाशयन्तो भर्तारं सहिताः शत्रुभिर्बुधैः।\nविपरीतानि कृत्यानि कारयन्तीह मन्त्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000470018, "chapter_id": 9470, "verse_number": "६-६३-१८", "content_sanskrit": "तान् भर्ता मित्रसंकाशानमित्रान् मन्त्रनिर्णये।\nव्यवहारेण जानीयात् सचिवानुपसंहितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000470019, "chapter_id": 9470, "verse_number": "६-६३-१९", "content_sanskrit": "चपलस्येह कृत्यानि सहसानुप्रधावतः।\nछिद्रमन्ये प्रपद्यन्ते क्रौञ्चस्य खमिव द्विजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000470020, "chapter_id": 9470, "verse_number": "६-६३-२०", "content_sanskrit": "यो हि शत्रुमवज्ञाय आत्मानं नाभिरक्षति।\nअवाप्नोति हि सोऽनर्थान् स्थानाच्च व्यवरोप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000470021, "chapter_id": 9470, "verse_number": "६-६३-२१", "content_sanskrit": "यदुक्तमिह ते पूर्वं प्रियया मेऽनुजेन च।\nतदेव नो हितं वाक्यं यथेच्छसि तथा कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000470022, "chapter_id": 9470, "verse_number": "६-६३-२२", "content_sanskrit": "तत् तु श्रुत्वा दशग्रीवः कुम्भकर्णस्य भाषितम्।\nभ्रुकुटिं चैव संचक्रे क्रुद्धश्चैनमभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000470023, "chapter_id": 9470, "verse_number": "६-६३-२३", "content_sanskrit": "मान्यो गुरुरिवाचार्यः किं मां त्वमनुशाससे।\nकिमेवं वाक्श्रमं कृत्वा यद् युक्तं तद् विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000470024, "chapter_id": 9470, "verse_number": "६-६३-२४", "content_sanskrit": "विभ्रमाच्चित्तमोहाद् वा बलवीर्याश्रयेण वा।\nनाभिपन्नमिदानीं यद् व्यर्था तस्य पुनः कथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000470025, "chapter_id": 9470, "verse_number": "६-६३-२५", "content_sanskrit": "अस्मिन् काले तु यद् युक्तं तदिदानीं विचिन्त्यताम्।\nगतं तु नानुशोचन्ति गतं तु गतमेव हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000470026, "chapter_id": 9470, "verse_number": "६-६३-२६", "content_sanskrit": "ममापनयजं दोषं विक्रमेण समीकुरु।\nयदि खल्वस्ति मे स्नेहो विक्रमं वाधिगच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000470027, "chapter_id": 9470, "verse_number": "६-६३-२७", "content_sanskrit": "यदि कार्यं ममैतत्ते हृदि कार्यतमं मतम्।\nस सुहृद् यो विपन्नार्थं दीनमभ्युपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000470028, "chapter_id": 9470, "verse_number": "६-६३-२८", "content_sanskrit": "स बन्धुर्योऽपनीतेषु साहाय्यायोपकल्पते।\nतमथैवं ब्रुवाणं स वचनं धीरदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000470029, "chapter_id": 9470, "verse_number": "६-६३-२९", "content_sanskrit": "रुष्टोऽयमिति विज्ञाय शनैः श्लक्ष्णमुवाच ह।\nअतीव हि समालक्ष्य भ्रातरं क्षुभितेन्द्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000470030, "chapter_id": 9470, "verse_number": "६-६३-३०", "content_sanskrit": "कुम्भकर्णः शनैर्वाक्यं बभाषे परिसान्त्वयन्।\nशृणु राजन्नवहितो मम वाक्यमरिंदम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000470031, "chapter_id": 9470, "verse_number": "६-६३-३१", "content_sanskrit": "अलं राक्षसराजेन्द्र संतापमुपपद्य ते।\nरोषं च सम्परित्यज्य स्वस्थो भवितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000470032, "chapter_id": 9470, "verse_number": "६-६३-३२", "content_sanskrit": "नैतन्मनसि कर्तव्यं मयि जीवति पार्थिव।\nतमहं नाशयिष्यामि यत् कृते परितप्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000470033, "chapter_id": 9470, "verse_number": "६-६३-३३", "content_sanskrit": "अवश्यं तु हितं वाच्यं सर्वावस्थं मया तव।\nबन्धुभावादभिहितं भ्रातृस्नेहाच्च पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000470034, "chapter_id": 9470, "verse_number": "६-६३-३४", "content_sanskrit": "सदृशं यच्च कालेऽस्मिन् कर्तुं स्नेहेन बन्धुना।\nशत्रूणां कदनं पश्य क्रियमाणं मया रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000470035, "chapter_id": 9470, "verse_number": "६-६३-३५", "content_sanskrit": "अद्य पश्य महाबाहो मया समरमूर्धनि।\nहते रामे सह भ्रात्रा द्रवन्तीं हरिवाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000470036, "chapter_id": 9470, "verse_number": "६-६३-३६", "content_sanskrit": "अद्य रामस्य तद् दृष्ट्वा मयाऽऽनीतं रणाच्छिरः।\nसुखी भव महाबाहो सीता भवतु दुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000470037, "chapter_id": 9470, "verse_number": "६-६३-३७", "content_sanskrit": "अद्य रामस्य पश्यन्तु निधनं सुमहत् प्रियम्।\nलङ्कायां राक्षसाः सर्वे ये ते निहतबान्धवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000470038, "chapter_id": 9470, "verse_number": "६-६३-३८", "content_sanskrit": "अद्य शोकपरीतानां स्वबन्धुवधशोचिनाम्।\nशत्रोर्युधि विनाशेन करोम्यश्रुप्रमार्जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000470039, "chapter_id": 9470, "verse_number": "६-६३-३९", "content_sanskrit": "अद्य पर्वतसंकाशं ससूर्यमिव तोयदम्।\nविकीर्णं पश्य समरे सुग्रीवं प्लवगेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000470040, "chapter_id": 9470, "verse_number": "६-६३-४०", "content_sanskrit": "कथं च राक्षसैरेभिर्मया च परिसान्त्वितः।\nजिघांसुभिर्दाशरथिं व्यथसे त्वं सदानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000470041, "chapter_id": 9470, "verse_number": "६-६३-४१", "content_sanskrit": "मां निहत्य किल त्वां हि निहनिष्यति राघवः।\nनाहमात्मनि संतापं गच्छेयं राक्षसाधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000470042, "chapter_id": 9470, "verse_number": "६-६३-४२", "content_sanskrit": "कामं त्विदानीमपि मां व्यादिश त्वं परंतप।\nन परः प्रेक्षणीयस्ते युद्धायातुलविक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000470043, "chapter_id": 9470, "verse_number": "६-६३-४३", "content_sanskrit": "अहमुत्सादयिष्यामि शत्रूंस्तव महाबलान्।\nयदि शक्रो यदि यमो यदि पावकमारुतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000470044, "chapter_id": 9470, "verse_number": "६-६३-४४", "content_sanskrit": "तानहं योधयिष्यामि कुबेरवरुणावपि।\nगिरिमात्रशरीरस्य शितशूलधरस्य मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000470045, "chapter_id": 9470, "verse_number": "६-६३-४५", "content_sanskrit": "नर्दतस्तीक्ष्णदंष्ट्रस्य बिभीयाद् वै पुरंदरः।\nअथ वा त्यक्तशस्त्रस्य मृद्नतस्तरसा रिपून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000470046, "chapter_id": 9470, "verse_number": "६-६३-४६", "content_sanskrit": "न मे प्रतिमुखः कश्चित् स्थातुं शक्तो जिजीविषुः।\nनैव शक्त्या न गदया नासिना निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000470047, "chapter_id": 9470, "verse_number": "६-६३-४७", "content_sanskrit": "हस्ताभ्यामेव संरभ्य हनिष्यामि सवज्रिणम्।\nयदि मे मुष्टिवेगं स राघवोऽद्य सहिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000470048, "chapter_id": 9470, "verse_number": "६-६३-४८", "content_sanskrit": "ततः पास्यन्ति बाणौघा रुधिरं राघवस्य मे।\nचिन्तया तप्यसे राजन् किमर्थं मयि तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000470049, "chapter_id": 9470, "verse_number": "६-६३-४९", "content_sanskrit": "सोऽहं शत्रुविनाशाय तव निर्यातुमुद्यतः।\nमुञ्च रामाद् भयं घोरं निहनिष्यामि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000470050, "chapter_id": 9470, "verse_number": "६-६३-५०", "content_sanskrit": "राघवं लक्ष्मणं चैव सुग्रीवं च महाबलम्।\nहनूमन्तं च रक्षोघ्नं येन लङ्का प्रदीपिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000470051, "chapter_id": 9470, "verse_number": "६-६३-५१", "content_sanskrit": "हरींश्च भक्षयिष्यामि संयुगे समुपस्थिते।\nअसाधारणमिच्छामि तव दातुं महद् यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000470052, "chapter_id": 9470, "verse_number": "६-६३-५२", "content_sanskrit": "यदि चेन्द्राद् भयं राजन् यदि चापि स्वयंभुवः।\nततोऽहं नाशयिष्यामि नैशं तम इवांशुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000470053, "chapter_id": 9470, "verse_number": "६-६३-५३", "content_sanskrit": "अपि देवाः शयिष्यन्ते मयि क्रुद्धे महीतले।\nयमं च शमयिष्यामि भक्षयिष्यामि पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000470054, "chapter_id": 9470, "verse_number": "६-६३-५४", "content_sanskrit": "आदित्यं पातयिष्यामि सनक्षत्रं महीतले।\nशतक्रतुं वधिष्यामि पास्यामि वरुणालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000470055, "chapter_id": 9470, "verse_number": "६-६३-५५", "content_sanskrit": "पर्वतांश्चूर्णयिष्यामि दारयिष्यामि मेदिनीम्।\nदीर्घकालं प्रसुप्तस्य कुम्भकर्णस्य विक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000470056, "chapter_id": 9470, "verse_number": "६-६३-५६", "content_sanskrit": "अद्य पश्यन्तु भूतानि भक्ष्यमाणानि सर्वशः।\nन त्विदं त्रिदिवं सर्वमाहारो मम पूर्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000470057, "chapter_id": 9470, "verse_number": "६-६३-५७", "content_sanskrit": "वधेन ते दाशरथेः सुखावहं\nसुखं समाहर्तुमहं व्रजामि।\nनिहत्य रामं सह लक्ष्मणेन\nखादामि सर्वान् हरियूथमुख्यान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000470058, "chapter_id": 9470, "verse_number": "६-६३-५८", "content_sanskrit": "रमस्व राजन् पिब चाद्य वारुणीं\nकुरुष्व कृत्यानि विनीय दुःखम्।\nमयाद्य रामे गमिते यमक्षयं\nचिराय सीता वशगा भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000470059, "chapter_id": 9470, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे त्रिषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]