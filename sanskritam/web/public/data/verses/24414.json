[{"id": 7004414000, "chapter_id": 24414, "verse_number": "५-३-१०८-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेन्महीपाल रोहिणीतीर्थमुत्तमम् ।\nविख्यातं त्रिषु लोकेषु सर्वपापहरं परम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004414001, "chapter_id": 24414, "verse_number": "५-३-१०८-२", "content_sanskrit": "युधिष्ठिर उवाच ।\nरोहिणीतीर्थमाहात्म्यं सर्वपापप्रणाशनम् ।\nश्रोतुमिच्छामि तत्त्वेन तन्मे त्वं वक्तुमर्हसि॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004414002, "chapter_id": 24414, "verse_number": "५-३-१०८-३", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nतस्मिन्नेकार्णवे घोरे नष्टे स्थावरजङ्गमे ।\nउदधौ च शयानस्य देवदेवस्य चक्रिणः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004414003, "chapter_id": 24414, "verse_number": "५-३-१०८-४", "content_sanskrit": "नाभौ समुत्थितं पद्मं रविमण्डलसन्निभम् ।\nकर्णिकाकेसरोपेतं पत्रैश्च समलंकृतम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004414004, "chapter_id": 24414, "verse_number": "५-३-१०८-५", "content_sanskrit": "तत्र ब्रह्मा समुत्पन्नश्चतुर्वदनपङ्कजः ।\nकिं करोमीति देवेश आज्ञा मे दीयतां प्रभो॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004414005, "chapter_id": 24414, "verse_number": "५-३-१०८-६", "content_sanskrit": "एवमुक्तस्तु देवेशः शङ्खचक्रगदाधरः ।\nउवाच मधुरां वाणीं तदा देवं पितामहम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004414006, "chapter_id": 24414, "verse_number": "५-३-१०८-७", "content_sanskrit": "सरस्वत्यां महाबाहो लोकं कुरु ममाज्ञया ।\nभूतग्राममशेषस्य उत्पादनविधिक्षयम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004414007, "chapter_id": 24414, "verse_number": "५-३-१०८-८", "content_sanskrit": "एतच्छ्रुतं तु वचनं पद्मनाभस्य भारत ।\nचिन्तयामास भगवान्सप्तर्षीन्हितकाम्यया॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004414008, "chapter_id": 24414, "verse_number": "५-३-१०८-९", "content_sanskrit": "क्रमात्ते चिन्तिताः प्राज्ञाः पुलस्त्यः पुलहः क्रतुः ।\nप्राचेतसो वसिष्ठश्च भृगुर्नारद एव च॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004414009, "chapter_id": 24414, "verse_number": "५-३-१०८-१०", "content_sanskrit": "यज्ञे प्राचेतसो दक्षो महातेजाः प्रजापतिः ।\nदक्षस्यापि तथा जाताः पञ्चाशद्दुहितरोऽनघ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004414010, "chapter_id": 24414, "verse_number": "५-३-१०८-११", "content_sanskrit": "ददौ स दश धर्माय कश्यपाय त्रयोदश ।\nतथैव स महाभागः सप्तविंशतिमिन्दवे॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004414011, "chapter_id": 24414, "verse_number": "५-३-१०८-१२", "content_sanskrit": "रोहिणीनाम या तासां मध्ये तस्य नराधिप ।\nअनिष्टा सर्वनारीणां भर्तुश्चैव विशेषतः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004414012, "chapter_id": 24414, "verse_number": "५-३-१०८-१३", "content_sanskrit": "ततः सा परमं कृत्वा वैराग्यं नृपसत्तम ।\nआगत्य नर्मदातीरे चचार विपुलं तपः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004414013, "chapter_id": 24414, "verse_number": "५-३-१०८-१४", "content_sanskrit": "एकरात्रैस्त्रिरात्रैश्च षड्द्वादशभिरेव च ।\nपक्षमासोपवासैश्च कर्शयन्ति कलेवरम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004414014, "chapter_id": 24414, "verse_number": "५-३-१०८-१५", "content_sanskrit": "आराधयन्ती सततं महिषासुरनाशिनीं ।\nदेवीं भगवतीं तात सर्वार्तिविनिवारणीम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004414015, "chapter_id": 24414, "verse_number": "५-३-१०८-१६", "content_sanskrit": "स्नात्वा स्नात्वा जले नित्यं नर्मदायाः शुचिस्मिता ।\nततस्तुष्टा महाभागा देवी नारायणी नृप॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004414016, "chapter_id": 24414, "verse_number": "५-३-१०८-१७", "content_sanskrit": "प्रसन्ना ते महाभागे व्रतेन नियमेन च ।\nएतच्छ्रुत्वा तु वचनं रोहिणी शशिनः प्रिया॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004414017, "chapter_id": 24414, "verse_number": "५-३-१०८-१८", "content_sanskrit": "यथा भवामि न चिरात्तथा भवतु मानदे ।\nएवमस्त्विति सा चोक्त्वा भवानी भक्तवत्सला॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004414018, "chapter_id": 24414, "verse_number": "५-३-१०८-१९", "content_sanskrit": "स्तूयमाना मुनिगणैस्तत्रैवान्तरधीयत ।\nतदाप्रभृति तत्तीर्थं रोहिणी शशिनः प्रिया॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004414019, "chapter_id": 24414, "verse_number": "५-३-१०८-२०", "content_sanskrit": "संजाता सर्वकालं तु वल्लभा नृपसत्तम ।\nतत्र तीर्थे तु या नारी नरो वा स्नानि भक्तितः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004414020, "chapter_id": 24414, "verse_number": "५-३-१०८-२१", "content_sanskrit": "वल्लभा जायते सा तु भर्तुर्वै रोहिणी यथा ।\nतत्र तीर्थे तु यः कश्चित्प्राणत्यागं करोति वै॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004414021, "chapter_id": 24414, "verse_number": "५-३-१०८-२२", "content_sanskrit": "सप्तजन्मानि दाम्पत्यवियोगो न भवेत्क्वचित्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]