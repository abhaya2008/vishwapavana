[{"id": 2014302, "chapter_id": 1294, "verse_number": "२-३५-१", "content_sanskrit": "वैशम्पायन उवाच॥\nनकुलस्य तु वक्ष्यामि कर्माणि विजयं तथा।\nवासुदेवजितामाशां यथाऽसावजयत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2014303, "chapter_id": 1294, "verse_number": "२-३५-२", "content_sanskrit": "निर्याय खाण्डवप्रस्थात्प्रतीचीमभितो दिशम्।\nउद्दिश्य मतिमान्प्रायान्महत्या सेनया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2014304, "chapter_id": 1294, "verse_number": "२-३५-३", "content_sanskrit": "सिंहनादेन महता योधानां गर्जितेन च।\nरथनेमिनिनादैश्च कम्पयन्वसुधामिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2014305, "chapter_id": 1294, "verse_number": "२-३५-४", "content_sanskrit": "ततो बहु धनं रम्यं गावाढ्यं धनधान्यवत्।\nकार्तिकेयस्य दयितं रोहीतकुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2014306, "chapter_id": 1294, "verse_number": "२-३५-५", "content_sanskrit": "तत्र युद्धं महच्चासीच्छूरैर्मत्तमयूरकैः।\nमरुभूमिं स कार्त्स्न्येन तथैव बहुधान्यकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2014307, "chapter_id": 1294, "verse_number": "२-३५-६", "content_sanskrit": "शैरीषकं महेत्थं च वशे चक्रे महाद्युतिः।\nआक्रोशं चैव राजर्षि तेन युद्धमभून्महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2014308, "chapter_id": 1294, "verse_number": "२-३५-७", "content_sanskrit": "तान्दशार्णान्स जित्वा च प्रतस्थे पाण्डुनन्दनः।\nशिबींस्त्रिगर्तानम्बष्ठान्मालवान्पञ्च कर्पटान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2014309, "chapter_id": 1294, "verse_number": "२-३५-८", "content_sanskrit": "तथा मध्यमकेयांश्च वाटधानान्द्विजानथ।\nपुनश्च परिवृत्याथ पुष्करारण्यवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2014310, "chapter_id": 1294, "verse_number": "२-३५-९", "content_sanskrit": "गणानुत्सवसङ्केतान्व्यजयत्पुरुषर्षभः।\nसिन्धुकूलाश्रिता ये च ग्रामणीया महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2014311, "chapter_id": 1294, "verse_number": "२-३५-१०", "content_sanskrit": "शूद्राभीरगणाश्चैव ये चाश्रित्य सरस्वतीम्।\nवर्तयन्ति च ये मत्स्यैर्ये च पर्वतवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2014312, "chapter_id": 1294, "verse_number": "२-३५-११", "content_sanskrit": "कत्स्नं पञ्चनन्दं चैव तथैवामरपर्वतम्।\nउत्तरज्योतिषं चैव तथा दिव्यकटं पुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2014313, "chapter_id": 1294, "verse_number": "२-३५-१२", "content_sanskrit": "द्वारपालं च तरसा वशे चक्रे महाद्युतिः।\nरामठान्हारहूणांश्च प्रतीच्याश्चैव ये नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2014314, "chapter_id": 1294, "verse_number": "२-३५-१३", "content_sanskrit": "तान्सर्वान्स वशे चक्रे शासनादेव पाण्डवः।\nतत्रस्थः प्रेषयामास वासुदेवाय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2014315, "chapter_id": 1294, "verse_number": "२-३५-१४", "content_sanskrit": "स चास्य गतभी राजन्प्रतिजग्राह शासनम्।\nततः शाकलमभ्येत्य मद्राणां पुटभेदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2014316, "chapter_id": 1294, "verse_number": "२-३५-१५", "content_sanskrit": "मातुलं प्रीतिपूर्वेण शल्यं चक्रे वशे बली।\nस तेन सत्कृतो राज्ञा सत्कारार्हो विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2014317, "chapter_id": 1294, "verse_number": "२-३५-१६", "content_sanskrit": "रत्नानि भूरीण्यादाय सम्प्रतस्थे युधां पतिः।\nततः सागरकुक्षिस्थान्म्लेच्छान्परमदारुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2014318, "chapter_id": 1294, "verse_number": "२-३५-१७", "content_sanskrit": "पह्लवान्वर्बरांश्चैव किरातान्यवनाञ्शकान्।\nततो रत्नान्यपादाय वशे कृत्वा च पार्थिवान्।\nन्यवर्तत कुरुश्रेष्ठो नकुलश्चित्रमार्गवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2014319, "chapter_id": 1294, "verse_number": "२-३५-१८", "content_sanskrit": "करमाणां सहस्राणि कोशं तस्य महात्मनः।\nऊहर्दश महाराज कृच्छ्रादिव महाधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2014320, "chapter_id": 1294, "verse_number": "२-३५-१९", "content_sanskrit": "इन्द्रप्रस्थगतं वीरमभ्येत्य स युधिष्ठिरम्।\nततो माद्रीसुतः श्रीमान्धनं तस्मै न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2014321, "chapter_id": 1294, "verse_number": "२-३५-२०", "content_sanskrit": "एवं विजित्य नकुलो दिशं वरुणपालिताम्।\nप्रतीचीं वासुदेवेन निर्जितां भरतर्षभ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2014322, "chapter_id": 1294, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि दिग्विजयपर्वणि पञ्चत्रिंशोऽध्यायः॥ ३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]