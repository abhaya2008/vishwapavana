[{"id": 2150573, "chapter_id": 4267, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150574, "chapter_id": 4267, "verse_number": "१", "content_sanskrit": "तथैव राजा कौन्तेयो धर्मपुत्रो युधिष्ठिरः ।\nधृष्टद्युम्नमुखान् वीरान् चोदयामास भारत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150575, "chapter_id": 4267, "verse_number": "२", "content_sanskrit": "चेदिकाशिकरूशानां नेतारं दृढविक्रमम् ।\nसेनापतिममित्रघ्नं धृष्टकेतुमथादिशत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150576, "chapter_id": 4267, "verse_number": "३", "content_sanskrit": "विराटं द्रुपदं चैव युयुधानं शिखण्डिनम् ।\nपाञ्चाल्यौ च महेष्वासौ युधामन्यूत्तमौजसौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150577, "chapter_id": 4267, "verse_number": "४", "content_sanskrit": "ते शूराश्चित्रवर्माणः तप्तकुण्डलधारिणः ।\nआज्यावसिक्ता ज्वलिता धिष्ण्येष्विव हुताशनाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150578, "chapter_id": 4267, "verse_number": "५", "content_sanskrit": "अशोभन्त महेष्वासा ग्रहाः प्रज्वलिता इव\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150579, "chapter_id": 4267, "verse_number": "६", "content_sanskrit": "अथ सैन्यं यथायोगं पूजयित्वा नरर्षभः ।\nदिदेश तान्यनीकानि प्रयाणाय महीपतिः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150580, "chapter_id": 4267, "verse_number": "७", "content_sanskrit": "अभिमन्युं बृहन्तं च द्रौपदेयांश्च सर्वशः ।\nधृष्टद्युम्नमुखानेतान् प्राहिणोत् पाण्डुनन्दनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150581, "chapter_id": 4267, "verse_number": "८", "content_sanskrit": "भीमं च युयुधानं च पाण्डवं च धनञ्जयम् ।\nद्वितीयं प्रेषयामास बलस्कन्धं युधिष्ठिरः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150582, "chapter_id": 4267, "verse_number": "९", "content_sanskrit": "भाण्डं समारोपयतां चरतां सम्प्रधावताम् ।\nहृष्टानां तत्र योधानां शब्दो दिवमिवास्पृशत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150583, "chapter_id": 4267, "verse_number": "१०", "content_sanskrit": "स्वयमेव ततः पश्चाद् विराटद्रुपदान्वितः ।\nअथापरैर्महीपालैः सह प्रायान् महाबलः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150584, "chapter_id": 4267, "verse_number": "११", "content_sanskrit": "भीमधन्वाऽऽयती सेना धृष्टद्युम्नेन पालिता ।\nगङ्गेव पूर्णा स्तिमिता स्यन्दमाना व्यदृश्यत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150585, "chapter_id": 4267, "verse_number": "१२", "content_sanskrit": "ततः पुनरनीकानि न्ययोजयत बुद्धिमान् ।\nमोहयन् धृतराष्ट्रस्य पुत्राणां बुद्धिनिश्चयम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150586, "chapter_id": 4267, "verse_number": "१३", "content_sanskrit": "द्रौपदेयान् महेष्वासानभिमन्युं च भारत ।\nनकुलं सहदेवं च सर्वांश्चैव प्रभद्रकान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150587, "chapter_id": 4267, "verse_number": "१४", "content_sanskrit": "दश चाश्वसहस्राणि द्विसहस्राणि दन्तिनाम् ।\nअयुतं च पदातीनां रथान् पञ्चशतं तथा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150588, "chapter_id": 4267, "verse_number": "१५", "content_sanskrit": "भीमसेनं च दुर्धर्षं प्रथमं प्रादिशद् बलम् ।\nमध्यमे च विराटं च जयत्सेनं च मागधम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150589, "chapter_id": 4267, "verse_number": "१६", "content_sanskrit": "महारथौ महात्मानौ युधामन्यूत्तमौजसौ ।\nवीर्यवन्तौ महात्मानौ गदाकार्मुकधारिणौ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150590, "chapter_id": 4267, "verse_number": "१७", "content_sanskrit": "अन्वयातां तदा मध्ये वासुदेवधनञ्जयौ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150591, "chapter_id": 4267, "verse_number": "१८", "content_sanskrit": "बभूवुरतिसंरब्धाः कृतप्रहरणा नराः ।\nतेषां विंशतिसाहस्रा हयाः शूरैरधिष्ठिताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150592, "chapter_id": 4267, "verse_number": "१९", "content_sanskrit": "पञ्च नागसहस्राणि रथवंशाश्च सर्वशः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150593, "chapter_id": 4267, "verse_number": "२०", "content_sanskrit": "पदातयश्च ये शूराः कार्मुकासिगदाधराः ।\nसहस्रशोऽन्वयुः पश्चादग्रतश्च सहस्रशः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150594, "chapter_id": 4267, "verse_number": "२१", "content_sanskrit": "युधिष्ठिरो यत्र सैन्ये यत्र चैव च फल्गुनः ।\nतत्र ते पृथिवीपाला भूयिष्ठं पर्यवस्थिताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150595, "chapter_id": 4267, "verse_number": "२२", "content_sanskrit": "तत्र नागसहस्राणि हयानामयुतानि च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150596, "chapter_id": 4267, "verse_number": "२३", "content_sanskrit": "चेकितानः स्वसैन्येन महता पार्थिवर्षभः ।\nधृष्टकेतुश्च चेदीनां प्रणेता तत्र वाहिनीम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150597, "chapter_id": 4267, "verse_number": "२४", "content_sanskrit": "सात्यकिश्च महेष्वासो वृष्णीनां प्रवरो रथः ।\nवृतः शतसहस्रेण रथानां प्राणदद् बली\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150598, "chapter_id": 4267, "verse_number": "२५", "content_sanskrit": "क्षत्रदेवब्रह्मदेवौ रथस्थौ पुरुषर्षभौ ।\nजघनं पालयन्तौ च पृष्ठतोऽनुप्रजग्मतुः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2150599, "chapter_id": 4267, "verse_number": "२६", "content_sanskrit": "भक्ष्यं भोज्यं च यत् किञ्चिद् यानं युग्यं च सर्वशः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2150600, "chapter_id": 4267, "verse_number": "२७", "content_sanskrit": "तत्र नागसहस्राणि हयानामयुतानि च ।\nफल्गु सर्वं कलत्रं च यत् किञ्चित् कृशदुर्बलम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2150601, "chapter_id": 4267, "verse_number": "२८", "content_sanskrit": "कोशसञ्चयवाहाश्च कोष्ठागारास्तथैव च ।\nगजानीकेन सङ्गृह्य शनैः प्रायाद् युधिष्ठिरः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2150602, "chapter_id": 4267, "verse_number": "२९", "content_sanskrit": "तमन्वयात् सत्यधृतिः सौचित्तिर्युद्धदुर्मदः ।\nश्रेणिमान् वसुदानश्च पुत्रः काश्यस्य वै विभुः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2150603, "chapter_id": 4267, "verse_number": "३०", "content_sanskrit": "रथाधिपतिसाहस्रा ये तेषामनुयायिनः ।\nहयानां नव कोट्यश्च महतां किङ्किणीकिनाम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2150604, "chapter_id": 4267, "verse_number": "३१", "content_sanskrit": "गजा विंशतिसाहस्रा ईषादन्ताः प्रहारिणः ।\nकुलीना भिन्नकरटा मेघा इव विसर्पिणः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2150605, "chapter_id": 4267, "verse_number": "३२", "content_sanskrit": "षष्टिनागसहस्राणि दशान्यानि च भारत ।\nयुधिष्ठिरस्य यान्यासन् युधि सैन्ये महात्मनः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2150606, "chapter_id": 4267, "verse_number": "३३", "content_sanskrit": "क्षरन्त इव जीमूताः प्रभिन्नकरटामुखाः ।\nराजानमन्वयुः पश्चात् चलन्त इव पर्वताः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2150607, "chapter_id": 4267, "verse_number": "३४", "content_sanskrit": "एवं तस्य बलं भीष्मं कुन्तीपुत्रस्य धीमतः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2150608, "chapter_id": 4267, "verse_number": "३५", "content_sanskrit": "तथा रथसहस्राणि पदातीनां च भारत\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2150609, "chapter_id": 4267, "verse_number": "३६", "content_sanskrit": "यदाश्रित्याथ युयुधे धार्तराष्ट्रं सुयोधनम् ।\nततोऽन्ये शतशः पश्चात् सहस्रायुतशो नराः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2150610, "chapter_id": 4267, "verse_number": "३७", "content_sanskrit": "नर्दन्तः प्रययुस्तेषामनीकानि सहस्रशः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2150611, "chapter_id": 4267, "verse_number": "३८", "content_sanskrit": "तत्र भेरीसहस्राणि शङ्खानामयुतानि च ।\nवादयन्ति स्म संहृष्टाः सहस्रायुतशो नराः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2150612, "chapter_id": 4267, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अष्टनवत्युत्तरशततमोऽध्यायः ॥१९८॥\nअम्बोपाख्यानपर्वणि अष्टाविंशोऽध्यायः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2150613, "chapter_id": 4267, "verse_number": "", "content_sanskrit": "॥ समाप्तम् अम्बोपाख्यानपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2150614, "chapter_id": 4267, "verse_number": "", "content_sanskrit": "॥ समाप्तम् उद्योगपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2150615, "chapter_id": 4267, "verse_number": "", "content_sanskrit": "॥ श्रीमध्वेशार्पणमस्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]