[{"id": 2113730, "chapter_id": 3445, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2113731, "chapter_id": 3445, "verse_number": "१", "content_sanskrit": "ततः क्षत्ता च भीष्मश्च व्यासो राजा च पाण्डुभिः ।\nददुः श्राद्धं तथा पाण्डोः स्वधामृतसमं तदा\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2113732, "chapter_id": 3445, "verse_number": "२", "content_sanskrit": "पुरोहितसहायास्ते यथान्यायमकुर्वत ।\nकुरूंश्च द्विजमुख्यांश्च भोजयित्वा सहस्रशः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2113733, "chapter_id": 3445, "verse_number": "३", "content_sanskrit": "रत्नौघान् विप्रमुख्येभ्यो दत्त्वा ग्रामवरानपि ।\nकृतशौचांस्ततस्तांस्तु पाण्डवान् भरतर्षभ \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2113734, "chapter_id": 3445, "verse_number": "४", "content_sanskrit": "आदाय विविशुः पौराः पुरं वाराणसाह्वयम् ।\nसततं स्मान्वतप्यन्त तमेव भरतर्षभम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2113735, "chapter_id": 3445, "verse_number": "५", "content_sanskrit": "पौरजानपदाः सर्वे मृतं स्वमिव बान्धवम् ।\nश्राद्धावसानेषु तदा दृष्ट्वा तं दुःखितं जनम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2113736, "chapter_id": 3445, "verse_number": "६", "content_sanskrit": "सम्मूढां दुःखशोकार्तां व्यासो मातरमब्रवीत् ।\nअपक्रान्तसुखाः कालाः प्रत्युपस्थितदारुणाः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2113737, "chapter_id": 3445, "verse_number": "७", "content_sanskrit": "शश्वत् पापीयदिवसाः पृथिवी गतयौवना ।\nबहुमायासमाकीर्णा नानादेशाः समाकुलाः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2113738, "chapter_id": 3445, "verse_number": "८", "content_sanskrit": "लुप्तधर्मक्रियाचारो घोरः कालो भविष्यति ।\nगच्छ त्वं त्यागमास्थाय युक्ता वस तपोवने \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2113739, "chapter_id": 3445, "verse_number": "९", "content_sanskrit": "मा द्रक्ष्यसि कुलस्यास्य घोरं सङ्क्षयमात्मनः ।\nतथेति समनुज्ञाय सा प्रविश्याब्रवीत् स्नुषाम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2113740, "chapter_id": 3445, "verse_number": "", "content_sanskrit": "सत्यवती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2113741, "chapter_id": 3445, "verse_number": "१०", "content_sanskrit": "अम्बिके तव पुत्रस्य दुर्नयात् किल भारताः ।\nसानुबन्धा विनङ्क्ष्यन्ति पौत्राश्चैवेति नः श्रुतम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2113742, "chapter_id": 3445, "verse_number": "११", "content_sanskrit": "तत् कौसल्यामिमामार्तां पुत्रशोकाभिपीडिताम् ।\nवनमादाय गच्छामो भद्रं ते यदि मन्यसे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2113743, "chapter_id": 3445, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2113744, "chapter_id": 3445, "verse_number": "१२", "content_sanskrit": "तथेत्युक्ता त्वम्बिकया भीष्ममामन्त्र्य सुव्रता ।\nवनं ययौ सत्यवती स्नुषाभ्यां सह भारत\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2113745, "chapter_id": 3445, "verse_number": "१३", "content_sanskrit": "ताः सुघोरं तपः कृत्वा दैवाद् भरतसत्तम ।\nदेहं त्यक्त्वा महाराज गतिमिष्टां ययुस्तदा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2113746, "chapter_id": 3445, "verse_number": "१२४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nचतुर्विंशत्यधिकशततमोऽध्यायः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2113747, "chapter_id": 3445, "verse_number": "७२", "content_sanskrit": "॥ इति सम्भवपर्वणि द्विसप्ततितमोऽध्यायः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2113748, "chapter_id": 3445, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]