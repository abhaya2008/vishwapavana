[{"id": 7001249000, "chapter_id": 21249, "verse_number": "२-५-२२-१", "content_sanskrit": "उपमन्युरुवाच ।\nन्यासस्तु त्रिविधः प्रोक्तः स्थित्युत्पत्तिलयक्रमात् ।\nस्थितिर्न्यासो गृहस्थानामुत्पत्तिर्ब्रह्मचारिणाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001249001, "chapter_id": 21249, "verse_number": "२-५-२२-२", "content_sanskrit": "यतीनां संहृतिन्यासो वनस्थानां तथैव च ।\nस एव भर्तृहीनायाः कुटुंबिन्याः स्थितिर्भवेत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001249002, "chapter_id": 21249, "verse_number": "२-५-२२-३", "content_sanskrit": "कन्यायाः पुनरुत्पत्तिं वक्ष्ये न्यासस्य लक्षणम् ।\nअंगुष्ठादिकनिष्ठांतं स्थितिन्यास उदाहृतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001249003, "chapter_id": 21249, "verse_number": "२-५-२२-४", "content_sanskrit": "दक्षिणांगुष्ठमारभ्य वामांगुष्ठान्तमेव च ।\nउत्पत्तिन्यास आख्यातो विपरीतस्तु संहृतिः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001249004, "chapter_id": 21249, "verse_number": "२-५-२२-५", "content_sanskrit": "सबिंदुकान्नकारादीन्वर्णान्न्यस्येदनुक्रमात् ।\nअंगुलीषु शिवं न्यस्येत्तलयोरप्यनामयोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001249005, "chapter_id": 21249, "verse_number": "२-५-२२-६", "content_sanskrit": "अस्त्रन्यासं ततः कृत्वा दशदिक्ष्वस्त्रमंत्रतः ।\nनिवृत्त्यादिकलाः पञ्च पञ्चभूतस्वरूपिणीः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001249006, "chapter_id": 21249, "verse_number": "२-५-२२-७", "content_sanskrit": "पञ्चभूताधिपैस्सार्धं ततच्चिह्नसमन्विताः ।\nहृत्कण्टतालुभ्रूमध्यब्रह्मरन्ध्रसमाश्रयाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001249007, "chapter_id": 21249, "verse_number": "२-५-२२-८", "content_sanskrit": "तद्तद्बीजेन संग्रंथीस्तद्तद्बीजेषु भावयेत् ।\nतासां विशोधनार्थाय विद्यां पञ्चाक्षरीं जपेत्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001249008, "chapter_id": 21249, "verse_number": "२-५-२२-९", "content_sanskrit": "निरुद्ध्वा प्राणवायुं च गुणसंख्यानुसारतः ।\nभूतग्रंथिं ततश्छिद्यादस्त्रेणैवास्त्रमुद्रया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001249009, "chapter_id": 21249, "verse_number": "२-५-२२-१०", "content_sanskrit": "नाड्या सुषुम्नयात्मानं प्रेरितं प्राणवायुना ।\nनिर्गतं ब्रह्मरन्ध्रेण योजयेच्छिवतेजसा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001249010, "chapter_id": 21249, "verse_number": "२-५-२२-११", "content_sanskrit": "विशोष्य वायुना पश्चाद्देहं कालाग्निना दहेत् ।\nततश्चोपरिभावेन कलास्संहृत्य वायुना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001249011, "chapter_id": 21249, "verse_number": "२-५-२२-१२", "content_sanskrit": "देहं संहृत्य वै दग्धं कलास्स्पृष्ट्वा सहाब्धिना ।\nप्लावयित्वामृतैर्देहं यथास्थानं निवेशयेत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001249012, "chapter_id": 21249, "verse_number": "२-५-२२-१३", "content_sanskrit": "अथ संहृत्य वै दग्धः कलासर्गं विनैव तु ।\nअमृतप्लावनं कुर्याद्भस्मीभूतस्य वै ततः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001249013, "chapter_id": 21249, "verse_number": "२-५-२२-१४", "content_sanskrit": "ततो विद्यामये तस्मिन्देहे दीपशिखाकृतिम् ।\nशिवान्निर्गतमात्मानं ब्रह्मरंध्रेण योजयेत्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001249014, "chapter_id": 21249, "verse_number": "२-५-२२-१५", "content_sanskrit": "देहस्यान्तः प्रविष्टं तं ध्यात्वा हृदयपंकजे ।\nपुनश्चामृतवर्षेण सिंचेद्विद्यामयं वपुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001249015, "chapter_id": 21249, "verse_number": "२-५-२२-१६", "content_sanskrit": "ततः कुर्यात्करन्यासं करशोधनपूर्वकम् ।\nदेहन्यासं ततः पश्चान्महत्या मुद्रया चरेत्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001249016, "chapter_id": 21249, "verse_number": "२-५-२२-१७", "content_sanskrit": "अंगन्यासं ततः कृत्वा शिवोक्तेन तु वर्त्मना ।\nवर्णन्यासं ततः कुर्याद्धस्तपादादिसंधिषु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001249017, "chapter_id": 21249, "verse_number": "२-५-२२-१८", "content_sanskrit": "षडंगानि ततो न्यस्य जातिषट्कयुतानि च ।\nदिग्बंधमाचरेत्पश्चादाग्नेयादि यथाक्रमम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001249018, "chapter_id": 21249, "verse_number": "२-५-२२-१९", "content_sanskrit": "यद्वा मूर्धादिपञ्चांगं न्यासमेव समाचरेत् ।\nतथा षडंगन्यासं च भूतशुद्ध्यादिकं विना", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001249019, "chapter_id": 21249, "verse_number": "२-५-२२-२०", "content_sanskrit": "एवं समासरूपेण कृत्वा देहात्मशोधनम् ।\nशिवभावमुपागम्य पूजयेत्परमेश्वरम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001249020, "chapter_id": 21249, "verse_number": "२-५-२२-२१", "content_sanskrit": "अथ यस्यास्त्यवसरो नास्ति वा मतिविभ्रमः ।\nस विस्तीर्णेन कल्पेन न्यासकर्म समाचरेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001249021, "chapter_id": 21249, "verse_number": "२-५-२२-२२", "content_sanskrit": "तत्राद्यो मातृकान्यासो ब्रह्मन्यासस्ततः परः ।\nतृतीयः प्रणवन्यासो हंसन्यासस्तदुत्तरः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001249022, "chapter_id": 21249, "verse_number": "२-५-२२-२३", "content_sanskrit": "पञ्चमः कथ्यते सद्भिर्न्यासः पञ्चाक्षरात्मकः ।\nएतेष्वेकमनेकं वा कुर्यात्पूजादि कर्मसु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001249023, "chapter_id": 21249, "verse_number": "२-५-२२-२४", "content_sanskrit": "अकारं मूर्ध्नि विन्यस्य आकारं च ललाटके ।\nइं ईं च नेत्रयोस्तद्वतुं ऊं श्रवणयोस्तथा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001249024, "chapter_id": 21249, "verse_number": "२-५-२२-२५", "content_sanskrit": "ऋं ःं कपोलयोश्चैव ऌअं ॡं नासापुटद्वये ।\nएमेमोष्ठद्वयोरोमौं दंतपंक्तिद्वयोः क्रमात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001249025, "chapter_id": 21249, "verse_number": "२-५-२२-२६", "content_sanskrit": "अं जिह्वायामथो तालुन्यः प्रयोज्यो यथाक्रमम् ।\nकवर्गं दक्षिणे हस्ते न्यसेत्पञ्चसु संधिषु॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001249026, "chapter_id": 21249, "verse_number": "२-५-२२-२७", "content_sanskrit": "चवर्गं च तथा वामहस्तसंधिषु विन्यसेत् ।\nटवर्गं च तवर्गं च पादयोरुभयोरपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001249027, "chapter_id": 21249, "verse_number": "२-५-२२-२८", "content_sanskrit": "पफौ तु पार्श्वयोः पृष्ठे नाभौ चापि बभौ ततः ।\nन्यसेन्मकारं हृदये त्वगादिषु यथाक्रमम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001249028, "chapter_id": 21249, "verse_number": "२-५-२२-२९", "content_sanskrit": "यकरादिसकारांतान्न्यसेत्सप्तसु धातुषु ।\nहंकारं हृदयस्यांतः क्षकारं भ्रूयुगांतरे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001249029, "chapter_id": 21249, "verse_number": "२-५-२२-३०", "content_sanskrit": "एवं वर्णान्प्रविन्यस्य पञ्चाशद्रुद्रवर्त्मना ।\nअंगवक्त्रकलाभेदात्पञ्च ब्रह्माणि विन्यसेत्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001249030, "chapter_id": 21249, "verse_number": "२-५-२२-३१", "content_sanskrit": "करन्यासाद्यमपि तैः कृत्वा वाथ न वा क्रमात् ।\nशिरोवदनहृद्गुह्यपादेष्वेतानि कल्पयेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001249031, "chapter_id": 21249, "verse_number": "२-५-२२-३२", "content_sanskrit": "ततश्चोर्ध्वादिवक्त्राणि पश्चिमांतानि कल्पयेत् ।\nईशानस्य कलाः पञ्च पञ्चस्वेतेषु च क्रमात्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001249032, "chapter_id": 21249, "verse_number": "२-५-२२-३३", "content_sanskrit": "ततश्चतुर्षु वक्त्रेषु पुरुषस्य कला अपि ।\nचतस्रः प्रणिधातव्याः पूर्वादिक्रमयोगतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001249033, "chapter_id": 21249, "verse_number": "२-५-२२-३४", "content_sanskrit": "हृत्कंठांसेषु नाभौ च कुक्षौ पृष्ठे च वक्षसि ।\nअघोरस्य कलाश्चाष्टौ पादयोरपि हस्तयोः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001249034, "chapter_id": 21249, "verse_number": "२-५-२२-३५", "content_sanskrit": "पश्चात्त्रयोःदशकलाः पायुमेढ्रोरुजानुषु ।\nजंघास्फिक्कटिपार्श्वेषु वामदेवस्य भावयेत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001249035, "chapter_id": 21249, "verse_number": "२-५-२२-३६", "content_sanskrit": "घ्राणे शिरसि बाह्वोश्च कल्पयेत्कल्पवित्तमः ।\nअष्टत्रिंशत्कलान्यासमेवं कृत्वानुपूर्वशः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001249036, "chapter_id": 21249, "verse_number": "२-५-२२-३७", "content_sanskrit": "पश्चात्प्रणवविद्धीमान्प्रणवन्यासमाचरेत् ।\nबाहुद्वये कूर्परयोस्तथा च मणिबन्धयोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001249037, "chapter_id": 21249, "verse_number": "२-५-२२-३८", "content_sanskrit": "पार्श्वोदरोरुजंघेषु पादयोः पृष्ठतस्तथा ।\nइत्थं प्रणवविन्यासं कृत्वा न्यासविचक्षणः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001249038, "chapter_id": 21249, "verse_number": "२-५-२२-३९", "content_sanskrit": "हंसन्यासं प्रकुर्वीत शिवशास्त्रे यथोदितम् ।\nबीजं विभज्य हंसस्य नेत्रयोर्घ्राणयोरपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001249039, "chapter_id": 21249, "verse_number": "२-५-२२-४०", "content_sanskrit": "विभज्य बाहुनेत्रास्यललाटे घ्राणयोरपि ।\nकक्षयोः स्कन्धयोश्चैव पार्श्वयोस्तनयोस्तथा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001249040, "chapter_id": 21249, "verse_number": "२-५-२२-४१", "content_sanskrit": "कठ्योः पाण्योर्गुल्फयोश्च यद्वा पञ्चांगवर्त्मना ।\nहंसन्यासमिमं कृत्वा न्यसेत्पञ्चाक्षरीं ततः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001249041, "chapter_id": 21249, "verse_number": "२-५-२२-४२", "content_sanskrit": "यथा पूर्वोक्तमार्गेण शिवत्वं येन जायते ।\nनाशिवः शिवमभ्यस्येन्नाशिवः शिवमर्चयेत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001249042, "chapter_id": 21249, "verse_number": "२-५-२२-४३", "content_sanskrit": "नाशिवस्तु शिवं ध्यायेन्नाशिवम्प्राप्नुयाच्छिवम् ।\nतस्माच्छैवीं तनुं कृत्वा त्यक्त्वा च पशुभावनाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001249043, "chapter_id": 21249, "verse_number": "२-५-२२-४४", "content_sanskrit": "शिवो ऽहमिति संचिन्त्य शैवं कर्म समाचरेत् ।\nकर्मयज्ञस्तपोयज्ञो जपयज्ञस्तदुत्तरः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001249044, "chapter_id": 21249, "verse_number": "२-५-२२-४५", "content_sanskrit": "ध्यानयज्ञो ज्ञानयज्ञः पञ्च यज्ञाः प्रकीर्तिताः ।\nकर्मयज्ञरताः केचित्तपोयज्ञरताः परे ।\nजपयज्ञरताश्चान्ये ध्यानयज्ञरतास्तथा॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001249045, "chapter_id": 21249, "verse_number": "२-५-२२-४६", "content_sanskrit": "ज्ञानयज्ञरताश्चान्ये विशिष्टाश्चोत्तरोत्तरम् ।\nक्रमयज्ञो द्विधा प्रोक्तः कामाकामविभेदतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001249046, "chapter_id": 21249, "verse_number": "२-५-२२-४७", "content_sanskrit": "कामान्कामी ततो भुक्त्वा कामासक्तः पुनर्भवेत् ।\nअकामे रुद्रभवने भोगान्भुक्त्वा ततश्च्युतः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001249047, "chapter_id": 21249, "verse_number": "२-५-२२-४८", "content_sanskrit": "तपोयज्ञरतो भूत्वा जायते नात्र संशयः ।\nतपस्वी च पुनस्तस्मिन्भोगान् भुक्त्वा ततश्च्युतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001249048, "chapter_id": 21249, "verse_number": "२-५-२२-४९", "content_sanskrit": "जपध्यानरतो भूत्वा जायते भुवि मानवः ।\nजपध्यानरतो मर्त्यस्तद्वैशिष्ट्यवशादिह॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001249049, "chapter_id": 21249, "verse_number": "२-५-२२-५०", "content_sanskrit": "ज्ञानं लब्ध्वाचिरादेव शिवसायुज्यमाप्नुयात् ।\nतस्मान्मुक्तो शिवाज्ञप्तः कर्मयज्ञो ऽपि देहिनाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001249050, "chapter_id": 21249, "verse_number": "२-५-२२-५१", "content_sanskrit": "अकामः कामसंयुक्तो बन्धायैव भविष्यति ।\nतस्मात्पञ्चसु यज्ञेषु ध्यानज्ञानपरो भवेत्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001249051, "chapter_id": 21249, "verse_number": "२-५-२२-५२", "content_sanskrit": "ध्यानं ज्ञानं च यस्यास्ति तीर्णस्तेन भवार्णवः ।\nहिंसादिदोषनिर्मुक्तो विशुद्धश्चित्तसाधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001249052, "chapter_id": 21249, "verse_number": "२-५-२२-५३", "content_sanskrit": "ध्यानयज्ञः परस्तस्मादपवर्गफलप्रदः ।\nबहिः कर्मकरा यद्वन्नातीव फलभागिनः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001249053, "chapter_id": 21249, "verse_number": "२-५-२२-५४", "content_sanskrit": "दृष्ट्वा नरेन्द्रभवने तद्वदत्रापि कर्मिणः ।\nध्यानिनां हि वपुः सूक्ष्मं भवेत्प्रत्यक्षमैश्वरम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001249054, "chapter_id": 21249, "verse_number": "२-५-२२-५५", "content_sanskrit": "यथेह कर्मणां स्थूलं मृत्काष्ठाद्यैः प्रकल्पितम् ।\nध्यानयज्ञरतास्तस्माद्देवान्पाषाणमृण्मयान्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001249055, "chapter_id": 21249, "verse_number": "२-५-२२-५६", "content_sanskrit": "नात्यंतं प्रतिपद्यंते शिवयाथात्म्यवेदनात् ।\nआत्मस्थं यः शिवं त्यक्त्वा बहिरभ्यर्चयेन्नरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001249056, "chapter_id": 21249, "verse_number": "२-५-२२-५७", "content_sanskrit": "हस्तस्थं फलमुत्सृज्य लिहेत्कूर्परमात्मनः ।\nज्ञानाद्ध्यानं भवेद्ध्यानाज्ज्ञानं भूयः प्रवर्तते॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001249057, "chapter_id": 21249, "verse_number": "२-५-२२-५८", "content_sanskrit": "तदुभाभ्यां भवेन्मुक्तिस्तस्माद्ध्यानरतो भवेत् ।\nद्वादशान्ते तथा मूर्ध्नि ललाटे भ्रूयुगान्तरे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001249058, "chapter_id": 21249, "verse_number": "२-५-२२-५९", "content_sanskrit": "नासाग्रे वा तथास्ये वा कन्धरे हृदये तथा ।\nनाभौ वा शाश्वतस्थाने श्रद्धाविद्धेन चेतसा॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001249059, "chapter_id": 21249, "verse_number": "२-५-२२-६०", "content_sanskrit": "बहिर्यागोपचारेण देवं देवीं च पूजयेत् ।\nअथवा पूजयेन्नित्यं लिंगे वा कृतकेपि वा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001249060, "chapter_id": 21249, "verse_number": "२-५-२२-६१", "content_sanskrit": "वह्नौ वा स्थण्डिले वाथ भक्त्या वित्तानुसारतः ।\nअथवांतर्बहिश्चैव पूजयेत्परमेश्वरम् ।\nअंतर्यागरतः पूजां बहिः कुर्वीत वा न वा॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]