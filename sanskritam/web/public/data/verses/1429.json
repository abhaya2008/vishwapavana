[{"id": 2020525, "chapter_id": 1429, "verse_number": "३-६७-०x", "content_sanskrit": "दमयन्त्यवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020526, "chapter_id": 1429, "verse_number": "३-६७-१", "content_sanskrit": "मां चेदिच्छसि जीवन्तीं मातः सत्यं ब्रवीमिते।\nनलस्य नरवीरस्य यतस्वानयने पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020527, "chapter_id": 1429, "verse_number": "३-६७-२", "content_sanskrit": "दमयन्त्या तथोक्ता तु सा देवी भृशदुःखिता।\nबाष्पेणापिहिता राज्ञी नोत्तरं किंचिदब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020528, "chapter_id": 1429, "verse_number": "३-६७-३", "content_sanskrit": "तदवस्थां तु तां दृष्ट्वा सर्वमन्तःपुरं तदा।\nहाहाभूतमतीवासीद्भृशं च प्ररुरोद ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020529, "chapter_id": 1429, "verse_number": "३-६७-४", "content_sanskrit": "ततो भीमं महाराजं भार्या वचनामब्रवीत्।\nदमयन्ती नृप भृशं भर्तारमनुशोचति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020530, "chapter_id": 1429, "verse_number": "३-६७-५", "content_sanskrit": "अपकृष्य च लज्जां सा स्वयमुक्तवती विभो।\nप्रयतन्तु तवप्रेष्याः पुण्यश्लोकस्य दर्शने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020531, "chapter_id": 1429, "verse_number": "३-६७-६x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020532, "chapter_id": 1429, "verse_number": "३-६७-६", "content_sanskrit": "तयाप्रयोदितो राजा ब्राह्मणान्वशवर्तिनः।\nप्राश्थापयद्दिशः सर्वा यतध्वं नलदर्शने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020533, "chapter_id": 1429, "verse_number": "३-६७-७", "content_sanskrit": "ततो विदर्भाधिपतेर्नियोगाद्ब्राह्मणास्तदा।\nदमयन्तीमथापृच्छ्य प्रस्थितास्ते तथाऽव्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020534, "chapter_id": 1429, "verse_number": "३-६७-८", "content_sanskrit": "अथ तानब्रवीद्भैमी सर्वराष्ट्रेष्विदं वचः।\nब्रूत वै जनसंसत्सु तत्रतत्र पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020535, "chapter_id": 1429, "verse_number": "३-६७-९", "content_sanskrit": "क्वनु त्वं कितव च्छित्त्वा वस्त्रार्धं प्रस्थितो मम।\nउत्सृज्य वपिने सुप्तामनुरक्तां प्रियां प्रिय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020536, "chapter_id": 1429, "verse_number": "३-६७-१०", "content_sanskrit": "सा वै यथा त्वया दृष्टा तथाऽऽस्ते त्वत्प्रतीक्षिणी।\nदह्यमाना भृशं बाला वस्त्रार्धेनाभिसंवृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020537, "chapter_id": 1429, "verse_number": "३-६७-११", "content_sanskrit": "तस्या रुदन्त्याः सततं तेन शोकेन पार्थिव।\nप्रसादं कुरु वै देव प्रतिवाक्यं वदस्व च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020538, "chapter_id": 1429, "verse_number": "३-६७-१२", "content_sanskrit": "एवमन्यच्च वक्तव्यं कृपां कुर्याद्यथा मयि।\nवायुना धूयमानो हि वनं दहति पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020539, "chapter_id": 1429, "verse_number": "३-६७-१३", "content_sanskrit": "भर्तव्या रक्षणीया त्व पत्नी पत्या हि नित्यदा।\nतन्नष्टमुभयं कस्माद्धर्मज्ञस्य सतस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020540, "chapter_id": 1429, "verse_number": "३-६७-१४", "content_sanskrit": "ख्यातः प्राज्ञः कुलीनश् सानुक्रोशो भवान्सदा।\nसंवृत्तो निरनुक्रोशः शङ्के मद्भाग्यसंक्षयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020541, "chapter_id": 1429, "verse_number": "३-६७-१५", "content_sanskrit": "तत्कुरुष्व नरव्याघ्र दयां मयि नरर्पभ।\nआनृशंस्यं परो धर्मस्त्वत्त एव हि मे श्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020542, "chapter_id": 1429, "verse_number": "३-६७-१६", "content_sanskrit": "एवंब्रुवाणान्यदि वः प्रतिब्रूयाद्धि कश्चन।\nस नरः सर्वथा ज्ञेयः कश्चासौ क्वनु वर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020543, "chapter_id": 1429, "verse_number": "३-६७-१७", "content_sanskrit": "यश्चैवं वचनं श्रुत्य्वा बूयात्प्रतिवचो नरः।\nतदादाय वचस्तस्य ममावेद्यं द्विजोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020544, "chapter_id": 1429, "verse_number": "३-६७-१८", "content_sanskrit": "यथा च वो न जानीयाच्चरतो भीमशासनात्।\nपुनरागमनं चेह तथा कार्यमतन्द्रितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020545, "chapter_id": 1429, "verse_number": "३-६७-१९", "content_sanskrit": "यदि वाऽसौ समृद्धः स्याद्यदि वाऽप्यधनो भवेत्।\nयदिऽवाप्यसमर्थः स्याज्ज्ञेयमस्य चिकीर्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020546, "chapter_id": 1429, "verse_number": "३-६७-२०", "content_sanskrit": "एवमुक्तास्त्वगच्छंस्ते ब्राह्मणाः सर्वतो दिशम्।\nनलं मृगयितुं राजंस्तदा व्यसनिनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020547, "chapter_id": 1429, "verse_number": "३-६७-२१", "content_sanskrit": "ते पुराणि सराष्ट्राणि ग्रामान्धोपांस्तथाऽऽश्रमान्।\nअन्वेषन्तो नलं राजन्नाधिजग्मुर्दविजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020548, "chapter_id": 1429, "verse_number": "३-६७-२२", "content_sanskrit": "तच्च वाक्यं तथा सर्वेतत्रतत्र विशांपते।\nश्रावयांचक्रिरे विप्रा दमयन्त्या यथेरितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020549, "chapter_id": 1429, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि सप्तषष्टितमोऽध्यायः ॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]