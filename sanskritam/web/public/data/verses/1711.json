[{"id": 2032948, "chapter_id": 1711, "verse_number": "४-३४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2032949, "chapter_id": 1711, "verse_number": "४-३४-१", "content_sanskrit": "निर्याय नगराच्छूरा व्यूढानीकाः प्रहारिणः।\nत्रिगर्तानस्पृशन्मात्स्याः मूर्येऽस्तंगमिते सति ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2032950, "chapter_id": 1711, "verse_number": "४-३४-२", "content_sanskrit": "ते त्रिगर्ताश्च मात्स्याश्च व्यूढानीकाः प्रहारिणः।\nअन्योन्यमभिवर्तन्ते गोषु गृद्धा महाबलाः ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2032951, "chapter_id": 1711, "verse_number": "४-३४-३", "content_sanskrit": "भीमाश्च मत्तमातङ्गास्तोमराङ्कुशचोदिताः।\nग्रामणीयैः समारूढाः कुशलैर्हस्तिसादिभिः ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2032952, "chapter_id": 1711, "verse_number": "४-३४-४", "content_sanskrit": "तेषां समागमो घोरस्तुमुलो रोमहर्षणः।\nघ्नतां परस्परं राजन्यमराष्ट्रविवर्धनः ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2032953, "chapter_id": 1711, "verse_number": "४-३४-५", "content_sanskrit": "देवासुरसमो राजन्नासीत्सूर्येऽबलम्बति ।\nपदातिरथनागेन्द्रहयारोहबलौघवान् ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2032954, "chapter_id": 1711, "verse_number": "४-३४-६", "content_sanskrit": "अन्योन्यमभ्यापततां निघ्नतां चेतरेतरम् ।\nउदतिष्ठद्रजो भौमं न प्राज्ञायत किंचन ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2032955, "chapter_id": 1711, "verse_number": "४-३४-७", "content_sanskrit": "पक्षिणश्चापतन्भूमौ सैन्येन रजसा वृताः ।\nइषुभिर्व्यतिसर्पद्भिरादित्योऽन्तरधीयत ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2032956, "chapter_id": 1711, "verse_number": "४-३४-८", "content_sanskrit": "खद्योतैरिव संयुक्तमन्तरिक्षमजायत॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2032957, "chapter_id": 1711, "verse_number": "४-३४-९", "content_sanskrit": "रुक्मपृष्ठानि चापानि विचेरुर्विद्युतो यथा ।\nनर्दतां लोकवीराणां सव्यं दक्षिणमस्यताम् ॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2032958, "chapter_id": 1711, "verse_number": "४-३४-१०", "content_sanskrit": "रथा रथैः समाजग्मुः पत्तयश्च पदातिभिः ।\nसादिनः सादिभिर्जग्मुर्गजैश्चापि महागजाः ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2032959, "chapter_id": 1711, "verse_number": "४-३४-११", "content_sanskrit": "असिभिः पट्टसैश्चापि शक्तिभिस्तोमरैरपि ।\nसंरब्धाः समरे योधा निजघ्नुरितरेतरम् ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2032960, "chapter_id": 1711, "verse_number": "४-३४-१२", "content_sanskrit": "निघ्नन्तः समरेऽन्योन्यं हृष्टाः परिघपाणयः ।\nन शेकुरतिसंक्रुद्धाः शूराः कर्तुं पराङ्भुखम् ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2032961, "chapter_id": 1711, "verse_number": "४-३४-१३", "content_sanskrit": "रक्ताधरोष्ठं सुनसं क्लृप्तश्मश्रु स्वलंकृतम्।\nअदृश्यत शिरश्छिन्नं रजोविध्वस्तकुण्डलम् ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2032962, "chapter_id": 1711, "verse_number": "४-३४-१४", "content_sanskrit": "दृश्यन्ते तत्र गात्राणि वीरैश्छिन्नानि सर्वशः ।\nसालस्कन्धनिकाशानि क्षत्रियाणा महामृधे ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2032963, "chapter_id": 1711, "verse_number": "४-३४-१५", "content_sanskrit": "नागभोगनिकाशैश्च बाहुभिश्चन्दनोक्षितैः।\nआकीर्णा वसुधा तत्र शिरोभिश्च सकुण्डलैः ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2032964, "chapter_id": 1711, "verse_number": "४-३४-१६", "content_sanskrit": "यथा वा वाससी श्लक्ष्णे महारजतरञ्जिते।\nबिभ्रती युवती श्यामा तद्वद्भाति वसुन्धरा ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2032965, "chapter_id": 1711, "verse_number": "४-३४-१७", "content_sanskrit": "उपाशाम्यद्रजो भौमं रुधिरेण प्रवर्षता।\nकश्मलं प्राविशद्धोरं निर्मर्यादमवर्तत ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2032966, "chapter_id": 1711, "verse_number": "४-३४-१८", "content_sanskrit": "युधिष्ठिरोऽपि धर्मात्मा भ्रातृभिः सहितस्तदा।\nव्यूहं कृत्वा विराटस्य अन्वयुध्यत पाण्डवः ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2032967, "chapter_id": 1711, "verse_number": "४-३४-१९", "content_sanskrit": "आत्मानं श्येनवत्कृत्वा तुण्डमासीद्युधिष्ठिरः।\nपक्षौं यमौ च भवतः पुच्छमासीद्वृकोदरः ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2032968, "chapter_id": 1711, "verse_number": "४-३४-२०", "content_sanskrit": "सहस्रं न्यहनत्तत्र कुन्तीपुत्रो युधिष्ठिरः।\nभीमसेनस्तु संक्रुद्धः सर्वशस्त्रभृतांवरः ।\nद्विसहस्रं रथान्वीरः परलोकं प्रवेशयत् ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2032969, "chapter_id": 1711, "verse_number": "४-३४-२१", "content_sanskrit": "नकुलस्त्रिशतं जघ्ने सहदेवश्चतुःशतम् ।\nशतानीकः शतं जघ्ने मदिराश्वश्चतुःशतम् ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2032970, "chapter_id": 1711, "verse_number": "४-३४-२२", "content_sanskrit": "प्रहृष्टां महतीं सेनां त्रिगर्तानां महाबलौ ।\nआर्च्छतां बहुसंरब्धौ केशाकेशि रथारथि ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2032971, "chapter_id": 1711, "verse_number": "४-३४-२३", "content_sanskrit": "लक्षयित्वा त्रिगर्तानां तौ प्रविष्टौ महाचमूम्।\nजग्मतुः सूर्यदत्तश्च वललश्चापि पृष्ठतः ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2032972, "chapter_id": 1711, "verse_number": "४-३४-२४", "content_sanskrit": "शङ्खो विराटपुत्रश्च महेष्वासो महाबलः।\nविनिघ्नन्समरे शूरान्प्रविवेश महाचमूम् ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2032973, "chapter_id": 1711, "verse_number": "४-३४-२५", "content_sanskrit": "विराटस्तत्र संग्रामे हत्वा पञ्चशतं रथान्।\nकुञ्जराणां शतं चैव सहस्रं वाजिनां तथा ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2032974, "chapter_id": 1711, "verse_number": "४-३४-२६", "content_sanskrit": "चरन्स विविधान्मार्गान्रथेन रथिनांवरः।\nत्रिगर्तानां सुशर्माणमार्च्छद्रुक्मरथं रणे ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2032975, "chapter_id": 1711, "verse_number": "४-३४-२७", "content_sanskrit": "तौ तु प्राहरतां तत्र महेष्वासौ महाबलौ ।\nअन्योन्यमभिनिघ्नन्तौ गोषु गोवृषभाविव ॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2032976, "chapter_id": 1711, "verse_number": "४-३४-२८", "content_sanskrit": "राजसिंहौ सुसंरब्धौ विरेजतुरमर्षणौ।\nकृतास्रौ निशितैर्बाणैरसिशक्तिपरश्वथैः ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2032977, "chapter_id": 1711, "verse_number": "४-३४-२९", "content_sanskrit": "ततो रथाभ्यां रथिनौ व्यतीयातां समन्ततः ।\nशरान्ससृजतुः शीघ्रं तोयधारा घनाविव ॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2032978, "chapter_id": 1711, "verse_number": "४-३४-३०", "content_sanskrit": "अन्योन्यमभिसंरब्धौ दन्ताभ्यामिव कुञ्जरौ।\nकृतास्त्रौ निशितैर्बाणैर्दारयामासतू रणे ॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2032979, "chapter_id": 1711, "verse_number": "४-३४-३१", "content_sanskrit": "मात्स्यो राजा सुशर्माणं विव्याध निशितैः शरैः ।\nपञ्चभिः पञ्चभिर्बाणैर्विव्याध चतुरो हयान् ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2032980, "chapter_id": 1711, "verse_number": "४-३४-३२", "content_sanskrit": "द्वाभ्यां सूतं च विव्याध केतुं च त्रिभिराशुगैः ।\nतथैव मात्स्यराजं तु सुशर्मा युद्धदुर्मदः ।\nपञ्चाशद्भिः शितैर्बाणैविव्याध परमास्त्रवित् ॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2032981, "chapter_id": 1711, "verse_number": "४-३४-३३", "content_sanskrit": "तयोर्बलानि राजेन्द्र समस्तानि महारणे।\nनाजानन्त तदाऽन्योन्यं प्रदोषे रजसा वृते ॥ ३३ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2032982, "chapter_id": 1711, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि चतुस्त्रिंशोऽध्यायः ॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]