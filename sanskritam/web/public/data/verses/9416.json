[{"id": 5000416000, "chapter_id": 9416, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे नवमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000416001, "chapter_id": 9416, "verse_number": "६-९-१", "content_sanskrit": "ततो निकुम्भो रभसः सूर्यशत्रुर्महाबलः।\nसुप्तघ्नो यज्ञकोपश्च महापार्श्वमहोदरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000416002, "chapter_id": 9416, "verse_number": "६-९-२", "content_sanskrit": "अग्निकेतुश्च दुर्धर्षो रश्मिकेतुश्च राक्षसः।\nइन्द्रजिच्च महातेजा बलवान् रावणात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000416003, "chapter_id": 9416, "verse_number": "६-९-३", "content_sanskrit": "प्रहस्तोऽथ विरूपाक्षो वज्रदंष्ट्रो महाबलः।\nधूम्राक्षश्चातिकायश्च दुर्मुखश्चैव राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000416004, "chapter_id": 9416, "verse_number": "६-९-४", "content_sanskrit": "परिघान् पट्टिशान् शूलान् प्रासान् शक्तिपरश्वधान्।\nचापानि च सुबाणानि खड्गांश्च विपुलाम्बुभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000416005, "chapter_id": 9416, "verse_number": "६-९-५", "content_sanskrit": "प्रगृह्य परमक्रुद्धाः समुत्पत्य च राक्षसाः।\nअब्रुवन् रावणं सर्वे प्रदीप्ता इव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000416006, "chapter_id": 9416, "verse_number": "६-९-६", "content_sanskrit": "अद्य रामं वधिष्यामः सुग्रीवं च सलक्ष्मणम्।\nकृपणं च हनूमन्तं लङ्का येन प्रधर्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000416007, "chapter_id": 9416, "verse_number": "६-९-७", "content_sanskrit": "तान् गृहीतायुधान् सर्वान् वारयित्वा विभीषणः।\nअब्रवीत् प्राञ्जलिर्वाक्यं पुनः प्रत्युपवेश्य तान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000416008, "chapter_id": 9416, "verse_number": "६-९-८", "content_sanskrit": "अप्युपायैस्त्रिभिस्तात योऽर्थः प्राप्तुं न शक्यते।\nतस्य विक्रमकालांस्तान् युक्तानाहुर्मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000416009, "chapter_id": 9416, "verse_number": "६-९-९", "content_sanskrit": "प्रमत्तेष्वभियुक्तेषु दैवेन प्रहतेषु च।\nविक्रमास्तात सिद्ध्यन्ति परीक्ष्य विधिना कृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000416010, "chapter_id": 9416, "verse_number": "६-९-१०", "content_sanskrit": "अप्रमत्तं कथं तं तु विजिगीषुं बले स्थितम्।\nजितरोषं दुराधर्षं तं धर्षयितुमिच्छथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000416011, "chapter_id": 9416, "verse_number": "६-९-११", "content_sanskrit": "समुद्रं लङ्घयित्वा तु घोरं नदनदीपतिम्।\nगतिं हनूमतो लोके को विद्यात् तर्कयेत वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000416012, "chapter_id": 9416, "verse_number": "६-९-१२", "content_sanskrit": "बलान्यपरिमेयानि वीर्याणि च निशाचराः।\nपरेषां सहसावज्ञा न कर्तव्या कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000416013, "chapter_id": 9416, "verse_number": "६-९-१३", "content_sanskrit": "किं च राक्षसराजस्य रामेणापकृतं पुरा।\nआजहार जनस्थानाद् यस्य भार्यां यशस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000416014, "chapter_id": 9416, "verse_number": "६-९-१४", "content_sanskrit": "खरो यद्यतिवृत्तस्तु स रामेण हतो रणे।\nअवश्यं प्राणिनां प्राणा रक्षितव्या यथाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000416015, "chapter_id": 9416, "verse_number": "६-९-१५", "content_sanskrit": "एतन्निमित्तं वैदेही भयं नः सुमहद् भवेत्।\nआहृता सा परित्याज्या कलहार्थे कृते नु किम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000416016, "chapter_id": 9416, "verse_number": "६-९-१६", "content_sanskrit": "न तु क्षमं वीर्यवता तेन धर्मानुवर्तिना।\nवैरं निरर्थकं कर्तुं दीयतामस्य मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000416017, "chapter_id": 9416, "verse_number": "६-९-१७", "content_sanskrit": "यावन्न सगजां साश्वां बहुरत्नसमाकुलाम्।\nपुरीं दारयते बाणैर्दीयतामस्य मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000416018, "chapter_id": 9416, "verse_number": "६-९-१८", "content_sanskrit": "यावत् सुघोरा महती दुर्धर्षा हरिवाहिनी।\nनावस्कन्दति नो लङ्कां तावत् सीता प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000416019, "chapter_id": 9416, "verse_number": "६-९-१९", "content_sanskrit": "विनश्येद्धि पुरी लङ्का शूराः सर्वे च राक्षसाः।\nरामस्य दयिता पत्नी न स्वयं यदि दीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000416020, "chapter_id": 9416, "verse_number": "६-९-२०", "content_sanskrit": "प्रसादये त्वां बन्धुत्वात् कुरुष्व वचनं मम।\nहितं तथ्यं त्वहं ब्रूमि दीयतामस्य मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000416021, "chapter_id": 9416, "verse_number": "६-९-२१", "content_sanskrit": "पुरा शरत्सूर्यमरीचिसंनिभान्\nनवाग्रपुङ्खान् सुदृढान् नृपात्मजः।\nसृजत्यमोघान् विशिखान् वधाय ते\nप्रदीयतां दाशरथाय मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000416022, "chapter_id": 9416, "verse_number": "६-९-२२", "content_sanskrit": "त्यजाशु कोपं सुखधर्मनाशनं\nभजस्व धर्मं रतिकीर्तिवर्धनम्।\nप्रसीद जीवेम सपुत्रबान्धवाः\nप्रदीयतां दाशरथाय मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000416023, "chapter_id": 9416, "verse_number": "६-९-२३", "content_sanskrit": "विभीषणवचः श्रुत्वा रावणो राक्षसेश्वरः।\nविसर्जयित्वा तान् सर्वान् प्रविवेश स्वकं गृहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000416024, "chapter_id": 9416, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे नवमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]