[{"id": 40022951, "chapter_id": 9416, "verse_number": "1", "content_sanskrit": "वाल्मीकिनैवमुक्तस्तु राघवः प्रत्यभाषत । प्राञ्जलिर्जगतो मध्ये दृष्ट्वा तां वरवर्णिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022952, "chapter_id": 9416, "verse_number": "2", "content_sanskrit": "एवमेतन्महाभाग यथा वदसि धर्मवित् । प्रत्ययस्तु मम ब्रह्मंस्तव वाक्यैरकल्मषैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022953, "chapter_id": 9416, "verse_number": "3", "content_sanskrit": "प्रत्ययस्तु पुरा वृत्तो वैदेह्याः सुरसन्निधौ । शपथस्तु कृतस्तत्र तेन वेश्म प्रवेशिता । लोकापवादो बलवान्येन त्यक्ता हि मैथिली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022954, "chapter_id": 9416, "verse_number": "4", "content_sanskrit": "सेयं लोकभयाद्ब्रह्मन्नपापेत्यभिजानता । परित्यक्ता मया सीता तद्भावन्क्षन्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022955, "chapter_id": 9416, "verse_number": "5", "content_sanskrit": "जानामि चेमौ पुत्रौ मे यमजातौ कुशीलवौ । शुद्धायां जगतो मध्ये मैथिल्यां प्रीतिरस्तु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022956, "chapter_id": 9416, "verse_number": "6", "content_sanskrit": "अभिप्रायं तु विज्ञाय रामस्य सुरसत्तमाः । सीतायाः शपथे तस्मिन् महेन्द्राद्या महौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022957, "chapter_id": 9416, "verse_number": "7", "content_sanskrit": "पितामहं पुरस्कृत्य सर्व एव समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022958, "chapter_id": 9416, "verse_number": "8", "content_sanskrit": "आदित्या वसवो रुद्रा ह्यश्विनौ समरुद्गणाः । गन्धर्वाप्सरसश्चैव सर्व एव समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022959, "chapter_id": 9416, "verse_number": "9", "content_sanskrit": "साध्याश्च विश्वेदेवाश्च सर्वे च परमर्षयः । नागाः सुपर्णाः सिद्धाश्च ते सर्वे हृष्टमानसाः । सीताशपथसम्भ्रान्ताः सर्व एव समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022960, "chapter_id": 9416, "verse_number": "10", "content_sanskrit": "दृष्ट्वा देवानृषींश्चैव राघवः पुनरब्रवीत् । प्रत्ययो मे नरश्रेष्ठा ऋषिवाक्यैरकल्मषैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022961, "chapter_id": 9416, "verse_number": "11", "content_sanskrit": "शुद्धायां जगतो मध्ये वैदेह्यां प्रीतिरस्तु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022962, "chapter_id": 9416, "verse_number": "12", "content_sanskrit": "ततो वायुः शुभः पुण्यो दिव्यगन्धो मनोरमः । तज्जनौघं सुरश्रेष्ठो ह्लादयामास सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022963, "chapter_id": 9416, "verse_number": "13", "content_sanskrit": "तदद्भुतमिवाचिन्त्यं निरैक्षन्त समागताः । मानवाः सर्वराष्ट्रेभ्यः पूर्वं कृतयुगे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022964, "chapter_id": 9416, "verse_number": "14", "content_sanskrit": "सर्वान्समागतान्दृष्ट्वा सीता काषायवासिनी । अब्रवीत्प्राञ्जलिर्वाक्यमधोदृष्टिरवाङ्मुखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022965, "chapter_id": 9416, "verse_number": "15", "content_sanskrit": "यथा ऽहं राघवादन्यं मनसापि न चिन्तये । तथा मे माधवी देवी विवरं दातुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022966, "chapter_id": 9416, "verse_number": "16", "content_sanskrit": "मनसा कर्मणा वाचा यथा रामं समर्चये । तथा मे माधवी देवी विवरं दातुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022967, "chapter_id": 9416, "verse_number": "17", "content_sanskrit": "यथैतत्सत्यमुक्तं मे वेद्मि रामात्परं न च । तथा मे माधवी देवी विवरं दातुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022968, "chapter_id": 9416, "verse_number": "18", "content_sanskrit": "तथा शपन्त्यां वैदेह्यां प्रादुरासीत्तदद्भुतम् । भूतलादुत्थितं दिव्यं सिंहासनमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022969, "chapter_id": 9416, "verse_number": "19", "content_sanskrit": "ध्रियमाणं शिरोभिस्तु नागैरमितविक्रमैः । दिव्यं दिव्येन वपुषा दिव्यरत्नविभूषितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022970, "chapter_id": 9416, "verse_number": "20", "content_sanskrit": "तस्मिंस्तु धरणी देवी बाहुभ्यां गृह्य मैथिलीम् । स्वागतेनाभिनन्द्यैनामासने चोपवेशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022971, "chapter_id": 9416, "verse_number": "21", "content_sanskrit": "तामासनगतां दृष्ट्वा प्रविशन्तीं रसातलम् । पुष्पवृष्टिरविच्छिन्ना दिव्या सीतामवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40022972, "chapter_id": 9416, "verse_number": "22", "content_sanskrit": "साधुकारश्च सुमहान्देवानां सहसोत्थितः । साधु साध्विति वै सीते यस्यास्ते शीलमीदृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40022973, "chapter_id": 9416, "verse_number": "23", "content_sanskrit": "एवं बहुविधा वाचो ह्यन्तरिक्षगताः सुराः । व्याजह्रुर्हृष्टमनसो दृष्ट्वा सीताप्रवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40022974, "chapter_id": 9416, "verse_number": "24", "content_sanskrit": "यज्ञवाटगताश्चापि मुनयः सर्व एव ते । राजानश्च नरव्याघ्रा विस्मयान्नोपरेमिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40022975, "chapter_id": 9416, "verse_number": "25", "content_sanskrit": "अन्तरिक्षे च भूमौ च सर्वे स्थावरजङ्गमाः । दानवाश्च महाकायाः पाताले पन्नगाधिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40022976, "chapter_id": 9416, "verse_number": "26", "content_sanskrit": "केचिद्विनेदुः संहृष्टाः केचिद्ध्यानपरायणाः । केचिद्रामं निरीक्षन्ते केचित्सीतामचेतनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40022977, "chapter_id": 9416, "verse_number": "27", "content_sanskrit": "सीताप्रवेशनं दृष्ट्वा तेषामासीत्समागमः । तन्मुहूर्तमिवात्यर्थं समं सम्मोहितं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]