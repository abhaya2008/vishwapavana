[{"id": 2209054, "chapter_id": 5465, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209055, "chapter_id": 5465, "verse_number": "१", "content_sanskrit": "उदङ्काय वरं दत्त्वा गोविन्दो द्विजसत्तम ।\nअत ऊर्ध्वं महाबाहुः किं चकार महायशाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209056, "chapter_id": 5465, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209057, "chapter_id": 5465, "verse_number": "२", "content_sanskrit": "दत्त्वा वरमुदङ्काय प्रायात् सात्यकिना सह ।\nद्वारकामेव गोविन्दः शीघ्रवेगैर्हयोत्तमैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209058, "chapter_id": 5465, "verse_number": "३", "content_sanskrit": "स सरांसि नदीश्चैव वनानि विविधानि च ।\nअतिक्रम्याससादाथ रम्यां द्वारवतीं पुरीम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209059, "chapter_id": 5465, "verse_number": "४", "content_sanskrit": "वर्तमाने महाराज महे रैवतकस्य तु ।\nउपायात् पुण्डरीकाक्षो युयुधानानुगस्तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209060, "chapter_id": 5465, "verse_number": "५", "content_sanskrit": "अलङ्कृतस्तु स गिरिर्नानारूपैर्विचित्रकैः ।\nबभौ रुग्ममयैः कोशैः सर्वत्र पुरुषर्षभ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209061, "chapter_id": 5465, "verse_number": "६", "content_sanskrit": "काञ्चनस्रग्भिरग्र्याभिः सुमनोभिस्तथैव च ।\nवासोभिश्च महाशैलः कल्पवृक्षैश्च सर्वशः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209062, "chapter_id": 5465, "verse_number": "७", "content_sanskrit": "दीपवृक्षैश्च सौवर्णैरभीक्ष्णमभिशोभितः ।\nगुहानिर्झरभागेषु दीपभूतो बभूव ह ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209063, "chapter_id": 5465, "verse_number": "८", "content_sanskrit": "पताकाभिश्च चित्राभिः सङ्घट्टाभिः समन्ततः ।\nपुंभिः स्त्रीभिश्च सम्पूर्णः प्रगीत इव चाभवत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209064, "chapter_id": 5465, "verse_number": "९", "content_sanskrit": "अतीव प्रेक्षणीयोऽभून्मेरुर्मुनिगणैरिव ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209065, "chapter_id": 5465, "verse_number": "१०", "content_sanskrit": "मत्तानां हृष्टरूपाणां स्त्रीणां पुंसां च भारत ।\nगायतां पर्वतेन्द्रस्य दिविस्पृगिव निःस्वनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209066, "chapter_id": 5465, "verse_number": "११", "content_sanskrit": "मत्तप्रमत्तसम्मत्तक्ष्वेडिताकृष्टसङ्कुलः ।\nतथा किलकिलाशब्दैः भूरभूत् सुमनोरमा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209067, "chapter_id": 5465, "verse_number": "१२", "content_sanskrit": "विपणापणवान् रम्यो भक्ष्यभोज्यविहारवान् ।\nवस्त्रमाल्योत्करयुतो वीणावेणुमृदङ्गवान् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209068, "chapter_id": 5465, "verse_number": "१३", "content_sanskrit": "सुरामैरेयमिश्रेण भक्ष्यभोज्येन चैव हि ।\nदीनान्धकृपणादिभ्यो दीयमानेन चानिशम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209069, "chapter_id": 5465, "verse_number": "१४", "content_sanskrit": "बभौ परमकल्याणो महस्तस्य महागिरेः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209070, "chapter_id": 5465, "verse_number": "१५", "content_sanskrit": "पुण्यावसथवान् वीरैः पुण्यकृद्भिर्निषेवितः ।\nविहारो वृष्णिवीराणां बभौ रैवतकस्य च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209071, "chapter_id": 5465, "verse_number": "१६", "content_sanskrit": "स तथा वेश्मसङ्कीर्णो देवलोक इवाबभौ ।\nतदा च कृष्णसान्निध्यान्मुदा देवगणैर्युतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209072, "chapter_id": 5465, "verse_number": "१७", "content_sanskrit": "स्तुवन्त्यन्तर्हिता देवा गन्धर्वाश्च सहर्षिभिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209073, "chapter_id": 5465, "verse_number": "", "content_sanskrit": "देवगन्धर्वाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209074, "chapter_id": 5465, "verse_number": "१८", "content_sanskrit": "साधकः सर्वधर्माणामसुराणां विनाशकः ।\nत्वं स्रष्टा सृज्यमाधारं कारणं धर्मवेदवित् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209075, "chapter_id": 5465, "verse_number": "१९", "content_sanskrit": "त्वया यत् क्रियते देव न जानीमोऽत्र मायया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209076, "chapter_id": 5465, "verse_number": "२०", "content_sanskrit": "केवलं त्वाऽभिजानीमः शरणं परमेश्वरम् ।\nब्रह्मादीनां च गोविन्द सान्निध्यं शरणं नमः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209077, "chapter_id": 5465, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209078, "chapter_id": 5465, "verse_number": "समाप्तिः", "content_sanskrit": "इति स्तुते मानुषैश्च पूजिते देवकीसुते ।\nशक्रसद्मप्रतीकाशो बभूव स हि शैलराट् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209079, "chapter_id": 5465, "verse_number": "२२", "content_sanskrit": "ततः सम्पूज्यमानः स विवेश भवनं शुभम् ।\nगोविन्दः सात्यकिश्चापि जग्मतुर्भवनं स्वकम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209080, "chapter_id": 5465, "verse_number": "२३", "content_sanskrit": "विवेश च स हृष्टात्मा चिरकालप्रवासकः ।\nकृत्वा नसुकरं कर्म दानवेष्विव वासवः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209081, "chapter_id": 5465, "verse_number": "२४", "content_sanskrit": "उपायान्तं तु वार्ष्णेयं भोजवृष्ण्यन्धकास्तदा ।\nअभ्यगच्छन्महात्मानं देवा इव शतक्रतुम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209082, "chapter_id": 5465, "verse_number": "२५", "content_sanskrit": "स तानभ्यर्च्य मेधावी पृष्ट्वा च कुशलं तदा ।\nअभ्यवादयत प्रीतः पितरं मातरं तदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209083, "chapter_id": 5465, "verse_number": "२६", "content_sanskrit": "ताभ्यां च सम्परिष्वक्तः सान्त्वितः स महाभुजः ।\nउपोपविष्टस्तैः सर्वैर्वृष्णिभिः परिवारितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209084, "chapter_id": 5465, "verse_number": "२७", "content_sanskrit": "स विश्रान्तो महातेजाः कृतपादावनेजनः ।\nकथयामास तं कृत्स्नं पृष्टः पित्रा महाहवम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209085, "chapter_id": 5465, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि कृष्णस्य रैवतगिरेरुत्सवदर्शनं नाम एकोनषष्टितमोऽध्यायः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]