[{"id": 7000846000, "chapter_id": 20846, "verse_number": "६-१८९-१", "content_sanskrit": "ईश्वर उवाच ।\nप्रवक्ष्यामि विशालाक्षि तुहिनाचलकन्यके ।\nगीता पंचदशाध्यायमाहात्म्यमवधारय ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000846001, "chapter_id": 20846, "verse_number": "६-१८९-२", "content_sanskrit": "कृपालुर्नरसिंहोऽभून्नाम्ना गौडेषु भूपतिः ।\nयस्यासिधारया संख्ये देवासंघा वधीकृताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000846002, "chapter_id": 20846, "verse_number": "६-१८९-३", "content_sanskrit": "यदीय मत्तमातंग दानधाराजलैरिला ।\nनिदाघेपि च सेहेतां रविसंतापवेदनाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000846003, "chapter_id": 20846, "verse_number": "६-१८९-४", "content_sanskrit": "संक्रंदनपरित्रस्ता यदीय शरणं गताः ।\nरेजिरे करिणो मत्ताश्चलंतः पर्वता इव ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000846004, "chapter_id": 20846, "verse_number": "६-१८९-५", "content_sanskrit": "मत्तमातंगचीत्कारप्रतिस्वनमिवादरात् ।\nयस्य गोपायतः शैला व्याहरंति कृपावतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000846005, "chapter_id": 20846, "verse_number": "६-१८९-६", "content_sanskrit": "यदीय धावत्तुरगक्षुरसंघातजर्जरम् ।\nनाभूच्चित्रं कथंकारं गतखंडं धरातलम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000846006, "chapter_id": 20846, "verse_number": "६-१८९-७", "content_sanskrit": "यस्मिन्वृत्रहणो मित्रे समुद्धरति मेदिनीम् ।\nपुनरुज्वलयांचक्रे महाभाष्यं फणीश्वरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000846007, "chapter_id": 20846, "verse_number": "६-१८९-८", "content_sanskrit": "तस्यासीत्सैनिको धीमाञ्छस्त्रशास्त्रकलानिधिः ।\nनाम्ना सरभभेरुंडः प्रचंडभुजमंडलः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000846008, "chapter_id": 20846, "verse_number": "६-१८९-९", "content_sanskrit": "भांडारेण तुरंगैश्च भटैर्वीररसोद्भवैः ।\nसमान एव भूपालदुर्गैरत्यंतदुर्गमैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000846009, "chapter_id": 20846, "verse_number": "६-१८९-१०", "content_sanskrit": "स कदाचित्स्वयं राज्यं कर्तुं पापो दधे मनः ।\nनिहत्य वसुधापालं बलात्साकं कुमारकै ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000846010, "chapter_id": 20846, "verse_number": "६-१८९-११", "content_sanskrit": "कर्तुं व्यवस्य दिवसैः स्वल्पैरित्थं चिकीर्षया ।\nविषूचिकामयादाशु परासुः समजायत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000846011, "chapter_id": 20846, "verse_number": "६-१८९-१२", "content_sanskrit": "कालेनाल्पीयसा प्रेत्य पापात्मा तेन कर्मणा ।\nतेजस्वी तुरगो जातः सिंधुदेशे कृशोदरिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000846012, "chapter_id": 20846, "verse_number": "६-१८९-१३", "content_sanskrit": "मूलेन बहुना क्रीत्वा हयतत्वविदा ततः ।\nबहुयत्नवता नीतः केनचिद्वैश्यसूनुना ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000846013, "chapter_id": 20846, "verse_number": "६-१८९-१४", "content_sanskrit": "राजापि पौत्रनप्त्त्राद्यैस्तस्यैव मरणात्परम् ।\nकालेन वृद्धतां प्राप्तः स्वराज्यं चापि पालयन् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000846014, "chapter_id": 20846, "verse_number": "६-१८९-१५", "content_sanskrit": "स वैश्यसूनुस्तं चाश्वं राज्ञे दातुं समागतः ।\nराज्ञोद्वारिस्थतस्तत्र प्रतीक्षंस्तत्समागमम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000846015, "chapter_id": 20846, "verse_number": "६-१८९-१६", "content_sanskrit": "ज्ञातपूर्वोऽपि वैश्योऽसौ प्रतीहारेण दर्शितः ।\nकिमर्थं ब्रूहि राज्ञेति पृष्टः स्पष्टमभाषत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000846016, "chapter_id": 20846, "verse_number": "६-१८९-१७", "content_sanskrit": "देव त्रिजगतीरत्नमिति मत्वा तुरंगमः ।\nमया नियुतमूल्येन बहुना साधुलक्षणः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000846017, "chapter_id": 20846, "verse_number": "६-१८९-१८", "content_sanskrit": "ततोऽवलोक्य वक्त्राणि भूपालः पार्श्ववर्तिनाम् ।\nसमादिदेश वणिजमश्वोऽत्र नीयतामिति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000846018, "chapter_id": 20846, "verse_number": "६-१८९-१९", "content_sanskrit": "शिरांसि धूनयन्नृणामश्वलक्षणवेदिनाम् ।\nशूराणामपि चेतांसि मुहुरुत्साहयन्महान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000846019, "chapter_id": 20846, "verse_number": "६-१८९-२०", "content_sanskrit": "अखंडमेदिनीवेगबहुसंक्रमणार्जितम् ।\nलालाफेनछलेनासौ वमन्शुभ्रतरं यशः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000846020, "chapter_id": 20846, "verse_number": "६-१८९-२१", "content_sanskrit": "उच्चैःश्रवस्तुलां भेजे गुणसाम्येन तत्त्वतः ।\nविवृण्वन्नति तेजस्वी ह्रियेवनतकंधरः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000846021, "chapter_id": 20846, "verse_number": "६-१८९-२२", "content_sanskrit": "चामरैरिंदुधवलैर्वीज्यमानो निरंतरम् ।\nदुग्धांभोनिधिलोलैस्तैः श्वासैरुच्चैःश्रवा इव ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000846022, "chapter_id": 20846, "verse_number": "६-१८९-२३", "content_sanskrit": "नीलातपत्रयुगलं घनच्छायतुलश्रिया ।\nबिभ्राणो वारिदालीढ हिमाद्रि शिखरश्रियम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000846023, "chapter_id": 20846, "verse_number": "६-१८९-२४", "content_sanskrit": "मेदिनीमंडलस्पर्श संक्रांतमिव पावकम् ।\nमुहुरुद्धरयन्धुन्वन्बंधुरं कंधरातटम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000846024, "chapter_id": 20846, "verse_number": "६-१८९-२५", "content_sanskrit": "दारयन्वैरिणः सर्वान्व्याहरंश्च जयश्रियम् ।\nहेषारवेण गुरुणा दिक्षुप्रख्यापयन्यशः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000846025, "chapter_id": 20846, "verse_number": "६-१८९-२६", "content_sanskrit": "सत्त्वस्य राशिरत्युच्चैर्गतीनामिव शेवधिः ।\nरूपस्य निलयं साक्षाल्लक्षणानां पयोनिधिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000846026, "chapter_id": 20846, "verse_number": "६-१८९-२७", "content_sanskrit": "आनीतो वणिजा वाजी राज्ञा च समदृश्यत ।\nबहुधा वर्णितोऽमात्यैरश्वलक्षणवेदिभिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000846027, "chapter_id": 20846, "verse_number": "६-१८९-२८", "content_sanskrit": "यथेच्छं वणिजोदीर्णं स्वर्णं दत्त्वा महीपतिः ।\nजग्राह तुरगं वेगादसीमानंदनिर्भरः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000846028, "chapter_id": 20846, "verse_number": "६-१८९-२९", "content_sanskrit": "ततोऽश्वपालमाहूय यत्नतस्तं निरूप्य च ।\nविसर्जितसभालोको गृहांतरमगान्नृपः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000846029, "chapter_id": 20846, "verse_number": "६-१८९-३०", "content_sanskrit": "अनेकधा समापृष्टो महीपालं रंणांगणे ।\nशस्त्रव्रणकिणश्रेणीभूषणं सत्वसन्निभम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000846030, "chapter_id": 20846, "verse_number": "६-१८९-३१", "content_sanskrit": "एकदा मृगयां खेलन्कुतूहलरसात्मना ।\nतमारुह्य महीपालो वनं प्रति विवेश ह ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000846031, "chapter_id": 20846, "verse_number": "६-१८९-३२", "content_sanskrit": "विसृज्य सैनिकान्पृष्टे धावतः परितोऽखिलान् ।\nआकृष्यमाणो हरिणैः पिपासाकुलितोऽभवत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000846032, "chapter_id": 20846, "verse_number": "६-१८९-३३", "content_sanskrit": "तत उत्तीर्य तुरगाज्जलमन्वेषयन् नृपः ।\nबध्वाश्वं तरुशाखायामारुरोह शिलां नृपः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000846033, "chapter_id": 20846, "verse_number": "६-१८९-३४", "content_sanskrit": "गीतापंचदशाध्यायश्लोकार्द्धलिखितं ततः ।\nपातितं मरुता तत्र यत्र खंडे विलोकयत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000846034, "chapter_id": 20846, "verse_number": "६-१८९-३५", "content_sanskrit": "पत्रं वाचयतो राज्ञः श्रुत्वा गीताक्षरावलीम् ।\nततो मुक्तिपदं लेभे तुरगस्त्वरयाऽपतत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000846035, "chapter_id": 20846, "verse_number": "६-१८९-३६", "content_sanskrit": "ततो ग्रंथिं समाच्छिद्य पल्याणवतार्य च ।\nउत्थापमानस्तुरगो राज्ञा नोत्थितवान्मृतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000846036, "chapter_id": 20846, "verse_number": "६-१८९-३७", "content_sanskrit": "ततः सरभभेरुंडो नृपमाभाष्य सुस्वरम् ।\nदिव्यं विमानमारुह्य जगाम त्रिदशालयम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000846037, "chapter_id": 20846, "verse_number": "६-१८९-३८", "content_sanskrit": "ततो गिरिं समारुह्य ददर्शाश्रममुत्तमम् ।\nपुन्नागकदलीचूतनारिकेलसमन्वितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000846038, "chapter_id": 20846, "verse_number": "६-१८९-३९", "content_sanskrit": "द्राक्षेक्षुवाटिकापूगनागकेसरचंपकम् ।\nखेलत्करभसारंगं नृत्यत्केकिकुलं नृपः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000846039, "chapter_id": 20846, "verse_number": "६-१८९-४०", "content_sanskrit": "प्रणिपत्य द्विजन्मानमुटजाभ्यंतरस्थितम् ।\nपप्रच्छ परया भक्त्या मुक्तसंसारवासनात् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000846040, "chapter_id": 20846, "verse_number": "६-१८९-४१", "content_sanskrit": "तुरगो निरगात्स्वर्गं हेतुना केन मे वद ।\nइत्याकर्ण्य वचो राज्ञो द्विजन्मा वाचमूचिवान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000846041, "chapter_id": 20846, "verse_number": "६-१८९-४२", "content_sanskrit": "कालेन बहुना प्रेत्य तत्पापात्तुरगोऽभवत् ।\nअथ पंचदशाध्यायश्लोकार्द्धं लिखितं क्वचित् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000846042, "chapter_id": 20846, "verse_number": "६-१८९-४३", "content_sanskrit": "ततो वाचयतः श्रुत्वा निरगात्तुरगो दिवम् ।\nततः समागतैस्तत्र परिवारजनैर्वृतः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000846043, "chapter_id": 20846, "verse_number": "६-१८९-४४", "content_sanskrit": "प्रणिपत्य द्विजन्मानं हृष्टरोमा विनिर्गतः ।\nपत्रं तदेव लिखितं गीतापंचदशाक्षरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000846044, "chapter_id": 20846, "verse_number": "६-१८९-४५", "content_sanskrit": "वाचयन्स महीपालो हर्षसंफुल्ललोचनः ।\nअभिषिच्य निजं पुत्रं मंत्रविन्मंत्रिभिः समम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000846045, "chapter_id": 20846, "verse_number": "६-१८९-४६", "content_sanskrit": "सिंहासने सिंहबलं मुक्तिमाप विशुद्धधीः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]