[{"id": 2152437, "chapter_id": 4310, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2152438, "chapter_id": 4310, "verse_number": "१", "content_sanskrit": "एवं व्यूढेष्वनीकेषु मामकेष्वितरेषु च ।\nके पूर्वं प्राहरंस्तत्र कुरवः पाण्डवास्तथा \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2152439, "chapter_id": 4310, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2152440, "chapter_id": 4310, "verse_number": "२", "content_sanskrit": "भ्रातृभिः सहितो राजन् पुत्रो दुर्योधनस्तव ।\nभीष्मं प्रमुखतः कृत्वा प्रययौ सह सेनया\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2152441, "chapter_id": 4310, "verse_number": "३", "content_sanskrit": "तथैव पाण्डवाः सर्वे भीमसेनपुरोगमाः ।\nभीष्मेण युद्धमिच्छन्तः प्रययुर्हृष्टमानसाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2152442, "chapter_id": 4310, "verse_number": "४", "content_sanskrit": "क्ष्वेडाः किलकिलाशब्दाः कृकवा गोविषाणिकाः ।\nभेरीमृदङ्गमुरजा हयकुञ्जरनिस्वनाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2152443, "chapter_id": 4310, "verse_number": "५", "content_sanskrit": "उभयोः सेनयो राजंस्ततस्तेऽस्मान् समद्रवन् ।\nवयं प्रतिनन्दन्तस्तदासीत् तुमुलं महत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2152444, "chapter_id": 4310, "verse_number": "६", "content_sanskrit": "महान्त्यनीकानि महासमुच्छ्रये\nसमागमे पाण्डवधार्तराष्ट्रयोः ।\nचकम्पिरे शङ्खमृदङ्गनिस्वनैः\nप्रकम्पितानीव वनानि वायुना \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2152445, "chapter_id": 4310, "verse_number": "७", "content_sanskrit": "नरेन्द्रनागाश्वरथाकुलाना-\nमभ्यायतीनामशिवे मुहूर्ते ।\nबभूव घोषस्तुमुलश्चमूनां\nवातोद्धुतानामिव सागराणाम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2152446, "chapter_id": 4310, "verse_number": "८", "content_sanskrit": "तस्मिन् समुत्थिते शब्दे तुमुले लोमहर्षणे ।\nभीमसेनो महाबाहुः प्राणदद् गोवृषो यथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2152447, "chapter_id": 4310, "verse_number": "९", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषं वारणानां च बृंहितम् ।\nसिंहनादं च सैन्यानां भीमसेनरवोऽभ्यभूत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2152448, "chapter_id": 4310, "verse_number": "१०", "content_sanskrit": "हयानां हेषमाणानामनीकेषु सहस्रशः ।\nसर्वान् पराभवच्छब्दान् भीमसेनस्य निस्वनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2152449, "chapter_id": 4310, "verse_number": "११", "content_sanskrit": "तं श्रुत्वा निनदं तस्य सैन्यास्तव वितत्रसुः ।\nजीमूतस्येव नदतः शक्राशनिसमस्वनम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2152450, "chapter_id": 4310, "verse_number": "१२", "content_sanskrit": "वाहनानि च सर्वाणि शकृन्मूत्रं प्रसुस्रुवुः ।\nशब्देन तस्य वीरस्य सिंहस्येवेतरे मृगाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2152451, "chapter_id": 4310, "verse_number": "१३", "content_sanskrit": "दर्शयन् घोरमात्मानं महाभ्रमिव नादयन् ।\nविभीषयंस्तव सुतांस्तव सेनां समभ्ययात्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2152452, "chapter_id": 4310, "verse_number": "१४", "content_sanskrit": "तमायान्तं महेष्वासं सोदर्याः पर्यवारयन् ।\nछादयन्तः शरव्रातैर्मेघा इव दिवाकरम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2152453, "chapter_id": 4310, "verse_number": "१५", "content_sanskrit": "दुर्योधनश्च पुत्रस्ते दुर्मुखो दुःसहः शलः ।\nदुःशासनश्चातिरथस्तथा दुर्मर्षणो नृप\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2152454, "chapter_id": 4310, "verse_number": "१६", "content_sanskrit": "विविंशतिश्चित्रसेनो विकर्णश्च महारथः ।\nपुरुमित्रो जयो भोजः सौमदत्तिश्च वीर्यवान् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2152455, "chapter_id": 4310, "verse_number": "१७", "content_sanskrit": "महाचापानि धुन्वन्तो जलदा इव विद्युतः ।\nआददानाश्च नाराचान् निर्मुक्ताशीविषोपमान् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2152456, "chapter_id": 4310, "verse_number": "१८", "content_sanskrit": "अथ तान् द्रौपदीपुत्राः सौभद्रश्च महारथः ।\nनकुलः सहदेवश्च धृष्टद्युम्नश्च पार्षतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2152457, "chapter_id": 4310, "verse_number": "१९", "content_sanskrit": "धार्तराष्ट्रान् प्रतिययुरर्दयन्तः शितैः शरैः ।\nवज्रैरिव महावेगैः शिखराणि धराभृताम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2152458, "chapter_id": 4310, "verse_number": "२०", "content_sanskrit": "तस्मिन् प्रथमसम्मर्दे भीमं ज्यातळनिस्वने ।\nतावकानां परेषां च नासीत् कश्च पराङ्मुखः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2152459, "chapter_id": 4310, "verse_number": "२१", "content_sanskrit": "लाघवं द्रोणशिष्याणामपश्यं भरतर्षभ ।\nनिमित्तवेधिनां राजञ्शरानुत्सृजतां भृशम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2152460, "chapter_id": 4310, "verse_number": "२२", "content_sanskrit": "नोपशाम्यति निर्घोषो धनुषां कूजतां तथा ।\nविनिश्चेरुः शरा दीप्ता ज्योतींषीव नभस्तळात्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2152461, "chapter_id": 4310, "verse_number": "२३", "content_sanskrit": "सर्वे त्वन्ये महीपालाः प्रेक्षका इव भारत ।\nददृशुर्दर्शनीयं तं भीमं ज्ञातिसमागमम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2152462, "chapter_id": 4310, "verse_number": "२४", "content_sanskrit": "ततस्ते जातसंरम्भाः परस्परकृतागसः ।\nअन्योन्यस्पर्धया राजन् व्यायच्छन्त महारथाः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2152463, "chapter_id": 4310, "verse_number": "२५", "content_sanskrit": "कुरुपाण्डवसेने ते हस्त्यश्वरथसङ्कुले ।\nशुशुभाते रणेऽतीव पटे चित्रगते इव\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2152464, "chapter_id": 4310, "verse_number": "२६", "content_sanskrit": "ततस्ते पार्थिवाः सर्वे प्रगृहीतशरासनाः ।\nसहसैन्याः समापेतुः पुत्रस्य तव शासनात्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2152465, "chapter_id": 4310, "verse_number": "२७", "content_sanskrit": "युधिष्ठिरेण चादिष्टाः पार्थिवास्ते सहस्रशः ।\nविनदन्तः समापेतुः पुत्रस्य तव वाहिनीम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2152466, "chapter_id": 4310, "verse_number": "२८", "content_sanskrit": "उभयोः सेनयोस्तीव्रः सैन्यानां स समागमः ।\nअन्तर्धीयत चादित्यः सैन्येन रजसाऽऽवृतः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2152467, "chapter_id": 4310, "verse_number": "२९", "content_sanskrit": "प्रयुद्धानां प्रभग्नानां पुनरावर्ततामपि ।\nनात्र स्वेषां परेषां वा विशेषः समजायत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2152468, "chapter_id": 4310, "verse_number": "३०", "content_sanskrit": "तस्मिंस्तु तुमुले युद्धे वर्तमाने महाभये ।\nअति सर्वाण्यनीकानि पिता तेऽभिव्यरोचत\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2152469, "chapter_id": 4310, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते भीष्मपर्वणि द्विचत्वारिंशोऽध्यायः ॥४२॥\n॥ भीमवधपर्वणि द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]