[{"id": 2169631, "chapter_id": 4627, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2169632, "chapter_id": 4627, "verse_number": "१", "content_sanskrit": "तानभिद्रवतो दृष्ट्वा पाण्डवांस्तावकं बलम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2169633, "chapter_id": 4627, "verse_number": "२", "content_sanskrit": "दुर्योधनो महाराज वारयामास सर्वशः ।\nयोधांश्च स्वबलं चैव समन्ताद् भरतर्षभ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2169634, "chapter_id": 4627, "verse_number": "३", "content_sanskrit": "क्रोशतस्तव पुत्रस्य न स्म राजन्न्यवर्तत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2169635, "chapter_id": 4627, "verse_number": "४", "content_sanskrit": "ततः पक्षात् प्रपक्षाच्च शकुनिश्चापि सौबलः ।\nतदात्तशस्त्राः कुरवो भीममभ्यद्रवन् रुषा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2169636, "chapter_id": 4627, "verse_number": "५", "content_sanskrit": "कर्णोऽपि दृष्ट्वा द्रवतो धार्तराष्ट्रान् पराङ्मुखान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2169637, "chapter_id": 4627, "verse_number": "६", "content_sanskrit": "मद्रराजमुवाचेदं याहि भीमरथं प्रति ।\nएवमुक्तश्च कर्णेन शल्यो मद्राधिपस्तदा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2169638, "chapter_id": 4627, "verse_number": "७", "content_sanskrit": "हंसवर्णान् हयाग्र्यांस्तान् प्रैषीद् यत्र वृकोदरः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2169639, "chapter_id": 4627, "verse_number": "८", "content_sanskrit": "ते प्रेषिता महाराज शल्येनाहवशोभिना ।\nभीमसेनरथं प्राप्य समसज्जन्त वाजिनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2169640, "chapter_id": 4627, "verse_number": "९", "content_sanskrit": "दृष्ट्वा कर्णं समायान्तं भीमः क्रोधसमन्वितः ।\nमतिं दध्रे विनाशाय कर्णस्य भरतर्षभ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2169641, "chapter_id": 4627, "verse_number": "१०", "content_sanskrit": "सोऽब्रवीत् सात्यकिं वीरं धृष्टद्युम्नं च पार्षतम् ।\nएनं रक्षत राजानं धर्मात्मानं युधिष्ठिरम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2169642, "chapter_id": 4627, "verse_number": "११", "content_sanskrit": "संशयान्महतो मुक्तं कथञ्चित् प्रेक्षतो मम\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2169643, "chapter_id": 4627, "verse_number": "१२", "content_sanskrit": "अग्रतो मे कृतो राजा छिन्नसर्वपरिच्छदः ।\nदुर्योधनस्य प्रीत्यर्थं राधेयेन दुरात्मना\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2169644, "chapter_id": 4627, "verse_number": "१३", "content_sanskrit": "अन्तमद्य करिष्यामि तस्य दुःखस्य पार्षत ।\nहन्ता वास्मि रणे कर्णं स वा मां निहनिष्यति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2169645, "chapter_id": 4627, "verse_number": "१४", "content_sanskrit": "सङ्ग्रामेण सुघोरेण सत्यमेतद् ब्रवीमि वः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2169646, "chapter_id": 4627, "verse_number": "१५", "content_sanskrit": "राजानमद्य भवतां न्यासभूतं ददामि वै ।\nअस्य संरक्षणे सर्वे यतध्वं विगतज्वराः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2169647, "chapter_id": 4627, "verse_number": "१६", "content_sanskrit": "एवमुक्त्वा महाबाहुः प्रायादाधिरथिं प्रति ।\nसिंहनादेन महता सर्वाः सन्नादयन् दिशः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2169648, "chapter_id": 4627, "verse_number": "१७", "content_sanskrit": "दृष्ट्वा त्वरितमायान्तं भीमं युद्धाभिनन्दिनम् ।\nसूतपुत्रमथोवाच मद्राणामीश्वरो विभुः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2169649, "chapter_id": 4627, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2169650, "chapter_id": 4627, "verse_number": "१८", "content_sanskrit": "पश्य कर्ण महाबाहुं क्रुद्धं पाण्डवनन्दनम् ।\nदीर्घकालार्जितं क्रोधं मोक्तुकामं त्वयि ध्रुवम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2169651, "chapter_id": 4627, "verse_number": "१९", "content_sanskrit": "ईदृशं नास्य रूपं मे दृष्टपूर्वं कदाचन ।\nअभिमन्यौ हते कर्ण राक्षसे वा घटोत्कचे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2169652, "chapter_id": 4627, "verse_number": "२०", "content_sanskrit": "त्रैलोक्यस्य समस्तस्य शक्तः क्रुद्धो निवारणे ।\nबिभर्ति तादृशं रूपं कालाग्निसदृशं शुभम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2169653, "chapter_id": 4627, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2169654, "chapter_id": 4627, "verse_number": "समाप्तिः", "content_sanskrit": "इति ब्रुवति राधेयं मद्राणामीश्वरे नृप ।\nअभ्यवर्तत वै कर्णं क्रोधदीप्तो वृकोदरः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2169655, "chapter_id": 4627, "verse_number": "२२", "content_sanskrit": "तथागतं तु सम्प्रेक्ष्य भीमं युद्धाभिनन्दिनम् ।\nअब्रवीद् वचनं शल्यं राधेयः प्रहसन्निव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2169656, "chapter_id": 4627, "verse_number": "२३", "content_sanskrit": "यदुक्तं वचनं मेऽद्य त्वया मद्रजनेश्वर ।\nभीमसेनं प्रति विभो तत्सत्यं नात्र संशयः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2169657, "chapter_id": 4627, "verse_number": "२४", "content_sanskrit": "एष शूरश्च वीरश्च क्रोधनश्च वृकोदरः ।\nनिरपेक्षः शरीरे च प्राणतश्च बलाधिकः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2169658, "chapter_id": 4627, "verse_number": "२५", "content_sanskrit": "अज्ञातवासं वसता विराटनगरे तदा ।\nद्रौपद्याः प्रियकामेन केवलं बाहुसंश्रयात्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2169659, "chapter_id": 4627, "verse_number": "२६", "content_sanskrit": "गूढभावं समाश्रित्य कीचकः सगणो हतः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2169660, "chapter_id": 4627, "verse_number": "२७", "content_sanskrit": "सोऽद्य सङ्ग्रामशिरसि सन्नद्धः क्रोधमूर्च्छितः ।\nकिं न नोद्यतदण्डेन मृत्युनापि व्रजेद् रणम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2169661, "chapter_id": 4627, "verse_number": "२८", "content_sanskrit": "चिरकालाभिलषितो ममायं तु मनोरथः ।\nअर्जुनं समरे हन्यां मां वा हन्याद् धनञ्जयः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2169662, "chapter_id": 4627, "verse_number": "२९", "content_sanskrit": "स मे कदाचिदद्यैव भवेद् भीमसमागमात्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2169663, "chapter_id": 4627, "verse_number": "३०", "content_sanskrit": "निहते भीमसेने तु यदि वा विरथीकृते ।\nअभियास्यति मां पार्थस्तन्मे साधु भविष्यति\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2169664, "chapter_id": 4627, "verse_number": "३१", "content_sanskrit": "अत्र यन्मन्यसे प्राप्तं तच्छीघ्रं सम्प्रधारय\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2169665, "chapter_id": 4627, "verse_number": "३२", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं राधेयस्य महात्मनः ।\nउवाच वचनं शल्यः सूतपुत्रं तथागतम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2169666, "chapter_id": 4627, "verse_number": "३३", "content_sanskrit": "अभियासि महाबाहो भीमसेनं महाबलम् ।\nनिरस्य भीमसेनं तु ततः प्राप्स्यसि फल्गुनम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2169667, "chapter_id": 4627, "verse_number": "३४", "content_sanskrit": "यस्ते कामोऽभिलषितश्चिरात् प्रभृति हृद्गतः ।\nस वै सम्पत्स्यते कर्ण सत्यमेतद् ब्रवीमि ते\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2169668, "chapter_id": 4627, "verse_number": "३५", "content_sanskrit": "एवमुक्ते ततः कर्णः शल्यं पुनरभाषत ।\nहन्ताहमर्जुनं सङ्खे मां वा हन्ता धनञ्जयः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2169669, "chapter_id": 4627, "verse_number": "३६", "content_sanskrit": "युद्धे मनः समाधाय याहि यत्र वृकोदरः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2169670, "chapter_id": 4627, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2169671, "chapter_id": 4627, "verse_number": "३७", "content_sanskrit": "ततः प्रायाद् रथेनाशु शल्यस्तत्र विशाम्पते ।\nयत्र भीमो महेष्वासो व्यद्रावयत वाहिनीम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2169672, "chapter_id": 4627, "verse_number": "३८", "content_sanskrit": "ततस्तूर्यनिनादश्च भेरीणां च महास्वनः ।\nउदतिष्ठत राजेन्द्र कर्णभीमसमागमे\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2169673, "chapter_id": 4627, "verse_number": "३९", "content_sanskrit": "भीमसेनोऽथ सङ्क्रुद्धस्तव सैन्यं दुरासदम् ।\nनाराचैर्विमलैस्तीक्ष्णैर्दिशः प्राद्रावयद् बली\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2169674, "chapter_id": 4627, "verse_number": "४०", "content_sanskrit": "स सन्निपातस्तुमुलो भीमरूपो विशाम्पते ।\nआसीद् रौद्रो महाराज कर्णपाण्डवयोर्मृधे\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2169675, "chapter_id": 4627, "verse_number": "४१", "content_sanskrit": "ततो मुहूर्ताद् राजेन्द्र पाण्डवः कर्णमाद्रवत् ।\nतमापतन्तं सम्प्रेक्ष्य कर्णो वैकर्तनो वृषः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2169676, "chapter_id": 4627, "verse_number": "४२", "content_sanskrit": "आजघानोरसि क्रुद्धो नाराचेन स्तनान्तरे ।\nपुनश्चैनममेयात्मा शरवर्षैरवाकिरत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2169677, "chapter_id": 4627, "verse_number": "४३", "content_sanskrit": "स विद्धः सूतपुत्रेण छादयामास पत्रिभिः ।\nविव्याध निशितैः कर्णं नवभिर्नतपर्वभिः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2169678, "chapter_id": 4627, "verse_number": "४४", "content_sanskrit": "तस्य कर्णो धनुर्मध्ये द्विधा चिच्छेद पत्रिणा ।\nअथ तं छिन्नधन्वानमभ्यविध्यत् स्तनान्तरे\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2169679, "chapter_id": 4627, "verse_number": "४५", "content_sanskrit": "नाराचेन सुतीक्ष्णेन सर्वावरणभेदिना ।\nसोऽन्यत् कार्मुकमादाय सूतपुत्रं वृकोदरः ।\nराजन् मर्मसु मर्मज्ञो विद्ध्वा सुनिशितैः शरैः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2169680, "chapter_id": 4627, "verse_number": "४६", "content_sanskrit": "ननाद बलवन्नादं कम्पयन्निव मेदिनीम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2169681, "chapter_id": 4627, "verse_number": "४७", "content_sanskrit": "तं कर्णः पञ्चविंशत्या नाराचानां समार्दयत् ।\nमदोत्कटं वने दृप्तमुल्काभिरिव कुञ्जरम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2169682, "chapter_id": 4627, "verse_number": "४८", "content_sanskrit": "ततः सायकभिन्नाङ्गः पाण्डवः क्रोधमूर्च्छितः ।\nसंरम्भामर्षताम्राक्षः सूतपुत्रवधेच्छया\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2169683, "chapter_id": 4627, "verse_number": "४९", "content_sanskrit": "स कार्मुके महावेगं भारसाधनमुत्तमम् ।\nगिरीणामपि भेत्तारं सायकं समयोजयत्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2169684, "chapter_id": 4627, "verse_number": "५०", "content_sanskrit": "विकृष्य बलवच्चापमाकर्णादति मारुतिः ।\nतं मुमोच महेष्वासः क्रुद्धः कर्णजिघांसया\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2169685, "chapter_id": 4627, "verse_number": "५१", "content_sanskrit": "स विसृष्टो बलवता बाणो वज्राशनिस्वनः ।\nअदारयद् रणे कर्णं वज्रवेग इवाचलम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2169686, "chapter_id": 4627, "verse_number": "५२", "content_sanskrit": "स भीमसेनाभिहतो सूतपुत्रः कुरूद्वह ।\nनिषसाद रथोपस्थे विसञ्ज्ञः पृतनापतिः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2169687, "chapter_id": 4627, "verse_number": "५३", "content_sanskrit": "एतस्मिन्नन्तरे दृष्ट्वा मद्रराजो वृकोदरम् ।\nजिह्वां छेत्तुं समायान्तं सान्त्वयन्निदमब्रवीत्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2169688, "chapter_id": 4627, "verse_number": "५४", "content_sanskrit": "भीमसेन महाबाहो यत् त्वा वक्ष्यामि तच्छृणु ।\nवचनं हेतुसम्पन्नं श्रुत्वा चैतत् तथा कुरु \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2169689, "chapter_id": 4627, "verse_number": "५५", "content_sanskrit": "अर्जुनेन प्रतिज्ञातो वधः कर्णस्य शुष्मिणः ।\nतां तथा कुरु भद्रं ते प्रतिज्ञां सव्यसाचिनः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2169690, "chapter_id": 4627, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2169691, "chapter_id": 4627, "verse_number": "५६", "content_sanskrit": "दृढव्रतत्वं पार्थस्य जानामि नृपसत्तम ।\nराज्ञस्तु धर्षणं पापः कृतवान् मम सन्निधौ\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2169692, "chapter_id": 4627, "verse_number": "५७", "content_sanskrit": "ततः क्रोधाभिभूतेन शेषं न गणितं मया ।\nपतिते चापि राधेये न मे मन्युः शमं गतः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2169693, "chapter_id": 4627, "verse_number": "५८", "content_sanskrit": "जिह्वोद्धरणमेवास्य प्राप्तकालं मतं मम \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2169694, "chapter_id": 4627, "verse_number": "५९", "content_sanskrit": "अनेन तु नृशंसेन समवेतेषु राजसु ।\nअस्माकं शृण्वतां कृष्णा यानि वाक्यानि मातुल\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2169695, "chapter_id": 4627, "verse_number": "६०", "content_sanskrit": "असह्यानि च नीचेन बहूनि श्रावितानि भोः ।\nनूनं ते तत् परिज्ञातं दूरस्थस्यापि पार्थिव\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2169696, "chapter_id": 4627, "verse_number": "६१", "content_sanskrit": "छेदनं चाह्य जिह्वायास्तदैवाकाङ्क्षितं मया ।\nराज्ञस्तु प्रियकामेन कालोऽयं परिपालितः \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2169697, "chapter_id": 4627, "verse_number": "६२", "content_sanskrit": "भवता तु यदुक्तोऽस्मि वाक्यं हेत्वर्थसंयुतम् ।\nतद् गृहीतं महाराज कटु तिक्तमिवौषधम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2169698, "chapter_id": 4627, "verse_number": "६३", "content_sanskrit": "हीनप्रतिज्ञो बीभत्सुर्नहि जीवेत कर्हिचित् ।\nअस्मिन् विनष्टे नष्टाः स्मः सर्व एव सकेशवाः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2169699, "chapter_id": 4627, "verse_number": "६४", "content_sanskrit": "अद्य चैव नृशंसात्मा पापः पापकृतां वरः ।\nगमिष्यति पराभावं दृष्टमात्रः किरीटिना\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2169700, "chapter_id": 4627, "verse_number": "६५", "content_sanskrit": "युधिष्ठिरस्य कोपेन पूर्वं दग्धो नृशंसकृत् ।\nत्वया संरक्षितस्त्वद्य मत्समीपादुपायतः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2169701, "chapter_id": 4627, "verse_number": "६६", "content_sanskrit": "ततो मद्राधिपो दृष्ट्वा विसञ्ज्ञं सूतनन्दनम् ।\nअपोवाह रथेनाजौ कर्णमाहवशोभिनम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2169702, "chapter_id": 4627, "verse_number": "६७", "content_sanskrit": "ततः पराजिते कर्णे धार्तराष्ट्रीं महाचमूम् ।\nव्यद्रावयद् भीमसेनो यथेन्द्रो दानवीं चमूम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2169703, "chapter_id": 4627, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nसप्तचत्वारिंशोऽध्यायः ॥४७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]