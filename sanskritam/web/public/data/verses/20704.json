[{"id": 7000704000, "chapter_id": 20704, "verse_number": "६-४७-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nवासुदेव नमस्तुभ्यं कथयस्व ममाग्रतः ।\nचैत्रस्य शुक्लपक्षे तु किं नामैकादशी भवेत् ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000704001, "chapter_id": 20704, "verse_number": "६-४७-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nशृणुष्वैकमना राजन्कथां पुण्यां पुरातनीम् ।\nवसिष्ठो यामकथयत्प्राग्दिलीपाय पृच्छते ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000704002, "chapter_id": 20704, "verse_number": "६-४७-३", "content_sanskrit": "दिलीप उवाच ।\nभगवञ्छ्रोतुमिच्छामि कथयस्व प्रसादतः ।\nचैत्रमासि सिते पक्षे किंनामैकादशी भवेत् ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000704003, "chapter_id": 20704, "verse_number": "६-४७-४", "content_sanskrit": "वसिष्ठ उवाच ।\nसाधु पृष्टं त्वया राजन्कथयामि तवाग्रतः ।\nचैत्रस्य शुक्लपक्षे तु कामदा नाम नामतः ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000704004, "chapter_id": 20704, "verse_number": "६-४७-५", "content_sanskrit": "एकादशी पुण्यतमा पापेंधनदवानलः ।\nशृणु राजन्कथामेतां पापघ्नीं पुण्यदायिनीम् ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000704005, "chapter_id": 20704, "verse_number": "६-४७-६", "content_sanskrit": "पुरा नागपुरे रम्ये हेमरत्नविभूषिते ।\nपुंडरीकमुखा नागा निवसंति महोत्कटाः ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000704006, "chapter_id": 20704, "verse_number": "६-४७-७", "content_sanskrit": "तस्मिन्पुरे पुंडरीको राजा राज्यं चकार सः ।\nगन्धर्वैः किन्नरैश्चैव अप्सरोभिश्च सेव्यते ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000704007, "chapter_id": 20704, "verse_number": "६-४७-८", "content_sanskrit": "वराप्सरास्तु ललिता गंधर्वो ललितस्तथा ।\nउभौ रागेण संरक्तौ दंपती कामपीडितौ ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000704008, "chapter_id": 20704, "verse_number": "६-४७-९", "content_sanskrit": "रेमाते स्वगृहे रम्ये धनधान्ययुते तदा ।\nललितायाश्च हृदये पतिर्वसति सर्वदा ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000704009, "chapter_id": 20704, "verse_number": "६-४७-१०", "content_sanskrit": "हृदये तस्य ललिता नित्यं वसति भामिनी ।\nएकदा पुंडरीकोऽथ क्रीडते सदसि स्थितः ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000704010, "chapter_id": 20704, "verse_number": "६-४७-११", "content_sanskrit": "गीतं गानं प्रकुरुते ललितो दयितां विना ।\nपदबंधस्खलज्जिह्वो बभूव ललितां स्मरन् ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000704011, "chapter_id": 20704, "verse_number": "६-४७-१२", "content_sanskrit": "मनोभावं विदित्वास्य कर्कटो नागसत्तमः ।\nपदबंधच्युतिं तस्य पुंडरीके न्यवेदयत् ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000704012, "chapter_id": 20704, "verse_number": "६-४७-१३", "content_sanskrit": "श्रुत्वा कर्कोटकवचः पुंडरीको भुजंगराट् ।\nक्रोधसंरक्तनयनो बभूवातिभयंकरः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000704013, "chapter_id": 20704, "verse_number": "६-४७-१४", "content_sanskrit": "शशाप ललितं तत्र गायंतं मदनातुरम् ।\nराक्षसो भव दुर्बुद्धे क्रव्यादः पुरुषादकः ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000704014, "chapter_id": 20704, "verse_number": "६-४७-१५", "content_sanskrit": "यतः पत्नीवशोपेतो गायमानो ममाग्रतः ।\nवचनात्तस्य राजेंद्र रक्षोरूपो बभूव सः ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000704015, "chapter_id": 20704, "verse_number": "६-४७-१६", "content_sanskrit": "रौद्राननो विरूपाक्षो दृष्टमात्रो भयंकरः ।\nबाहूयोजनविस्तीर्णौ मुखं कंदरसन्निभम् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000704016, "chapter_id": 20704, "verse_number": "६-४७-१७", "content_sanskrit": "चंद्रसूर्यनिभे नेत्रे ग्रीवापर्वतसंनिभा ।\nनासारंध्रे तु विवरे अधरौ योजनायतौ ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000704017, "chapter_id": 20704, "verse_number": "६-४७-१८", "content_sanskrit": "शरीरं तस्य राजेंद्र उत्थितं योजनाष्टकम् ।\nईदृशो राक्षसो भूत्वा भुंजानः कर्मणः फलम् ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000704018, "chapter_id": 20704, "verse_number": "६-४७-१९", "content_sanskrit": "ललिता तु तथालोक्य स्वपतिं विकृताकृतिम् ।\nचिंतयामास मनसा दुःखेन महतार्दिता ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000704019, "chapter_id": 20704, "verse_number": "६-४७-२०", "content_sanskrit": "किं करोमि क्व गच्छामि पतिः शापेन पीडितः ।\nइति संस्मृत्य संस्मृत्य मनसा शर्म नालभत् ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000704020, "chapter_id": 20704, "verse_number": "६-४७-२१", "content_sanskrit": "चचार पतिना सार्द्धं ललिता गहने वने ।\nबभ्राम विपिने दुर्गे कामरूपी स राक्षसः ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000704021, "chapter_id": 20704, "verse_number": "६-४७-२२", "content_sanskrit": "निर्घृणः पापनिरतो विरूपः पुरुषादकः ।\nन सुखं लभते रात्रौ न दिवा पापपीडितः ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000704022, "chapter_id": 20704, "verse_number": "६-४७-२३", "content_sanskrit": "ललिता दुःखितातीव पतिं दृष्ट्वा तथाविधम् ।\nबभ्राम तेन सार्द्धं सा रुदती गहने वने ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000704023, "chapter_id": 20704, "verse_number": "६-४७-२४", "content_sanskrit": "दृष्ट्वाश्रमपदं रम्यं मुनिं संशांतविग्रहम् ।\nशीघ्रं जगाम ललिता नमस्कृत्याग्रतः स्थिता ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000704024, "chapter_id": 20704, "verse_number": "६-४७-२५", "content_sanskrit": "तां दृष्ट्वा स मुनिः प्राह दुःखितां हि दयापरः ।\nका त्वं कस्मादिहायाता सत्यं वद ममाग्रतः ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000704025, "chapter_id": 20704, "verse_number": "६-४७-२६", "content_sanskrit": "ललितोवाच ।\nवीरधन्वेति गंधर्वः सुता तस्य महात्मनः ।\nललितां नाम मां विद्धि पत्यर्थमिह चागताम् ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000704026, "chapter_id": 20704, "verse_number": "६-४७-२७", "content_sanskrit": "भर्ता मे पापदोषेण राक्षसोऽभून्महामुने ।\nरौद्ररूपो दुराचारस्तं दृष्ट्वा नास्ति मे सुखम् ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000704027, "chapter_id": 20704, "verse_number": "६-४७-२८", "content_sanskrit": "सांप्रतं शाधि मां ब्रह्मन्यत्कृत्यं तद्वद प्रभो ।\nकुरुष्व तद् व्रतं भद्रे विधिपूर्वं मयोदितम् ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000704028, "chapter_id": 20704, "verse_number": "६-४७-२९", "content_sanskrit": "ऋषिरुवाच ।\nचैत्रमासस्य रंभोरु शुक्लपक्षोऽस्ति सांप्रतम् ।\nकामदैकादशीनाम पापघ्नी ललिते परा ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000704029, "chapter_id": 20704, "verse_number": "६-४७-३०", "content_sanskrit": "कुरुष्व तद्व्रतं भद्रे विधिपूर्वं मयोदितम् ।\nअस्य व्रतस्य यत्पुण्यं तत्स्वभर्त्रे प्रदीयताम् ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000704030, "chapter_id": 20704, "verse_number": "६-४७-३१", "content_sanskrit": "दत्ते पुण्येक्षणात्तस्य शापदोषः प्रयास्यति ।\nइति श्रुत्वा मुनेर्वाक्यं ललिता हर्षिताभवत् ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000704031, "chapter_id": 20704, "verse_number": "६-४७-३२", "content_sanskrit": "उपोष्यैकादशीं राजन्द्वादशीदिवसे तथा ।\nविप्रस्यैव समीपे तद्वासुदेवस्य चाग्रतः ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000704032, "chapter_id": 20704, "verse_number": "६-४७-३३", "content_sanskrit": "वाक्यमुवाच ललिता स्वपत्युस्तारणाय वै ।\nमया तु तद्व्रतं चीर्णं कामदाया उपोषणम् ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000704033, "chapter_id": 20704, "verse_number": "६-४७-३४", "content_sanskrit": "तस्य पुण्यप्रभावेन गच्छत्वस्य पिशाचता ।\nललितावचनादेव वर्त्तमानोऽपि तत्क्षणे ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000704034, "chapter_id": 20704, "verse_number": "६-४७-३५", "content_sanskrit": "गतपापः स ललितो दिव्यदेहो बभूव ह ।\nराक्षसत्वं गतं तस्य प्राप्ता गंधर्वता पुनः ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000704035, "chapter_id": 20704, "verse_number": "६-४७-३६", "content_sanskrit": "हेमरत्नसमाकीर्णो रेमे ललितया सह ।\nविमानवरमारूढौ पूर्वरूपाधिकौ च तौ ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000704036, "chapter_id": 20704, "verse_number": "६-४७-३७", "content_sanskrit": "दंपती अत्यशोभेतां कामदायाः प्रभावतः ।\nइति ज्ञात्वा नृपश्रेष्ठ कर्तव्यैषा प्रयत्नतः ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000704037, "chapter_id": 20704, "verse_number": "६-४७-३८", "content_sanskrit": "लोकानां तु हितार्थाय तवाग्रे कथिता मया ।\nब्रह्महत्यादि पापघ्नी पिशाचत्वविनाशनी ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000704038, "chapter_id": 20704, "verse_number": "६-४७-३९", "content_sanskrit": "नातः परतरा काचित्त्रैलोक्ये सचराचरे ।\nपठनाच्छ्रवणाद्राजन्वाजपेयफलं लभेत् ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]