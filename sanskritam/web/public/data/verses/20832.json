[{"id": 7000832000, "chapter_id": 20832, "verse_number": "६-१७५-१", "content_sanskrit": "पार्वत्युवाच ।\nभगवन्सर्वतत्वज्ञ श्रीविष्णोस्त्वत्प्रसादतः ।\nश्रुता नानाविधा धर्मा लोकनिस्तारहेतवः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000832001, "chapter_id": 20832, "verse_number": "६-१७५-२", "content_sanskrit": "अधुना श्रोतुमिच्छमि गीतामाहात्म्यमप्यहम् ।\nश्रुतेन येन देवेश हरौ भक्तिर्विवर्द्धते ।\nतद्वदस्वाधुना देव यद्यहं तव वल्लभा॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000832002, "chapter_id": 20832, "verse_number": "६-१७५-३", "content_sanskrit": "ईश्वर उवाच ।\nअतसीपुष्पसंकाशं खगेंद्रासनमच्युतम् ।\nशयानं शेषशय्यायां महाविष्णुमुपास्महे॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000832003, "chapter_id": 20832, "verse_number": "६-१७५-४", "content_sanskrit": "कदाचिदासने रम्ये सुखासीनं मुरद्विषम् ।\nआनंदयित्री लोकानां लक्ष्मीः पप्रच्छ सादरात्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000832004, "chapter_id": 20832, "verse_number": "६-१७५-५", "content_sanskrit": "श्रीरुवाच ।\nशयालुरसि दुग्धाब्धौ भगवन्केन हेतुना ।\nउदासीन इवैश्वर्यं जगंति स्थापयन्निव॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000832005, "chapter_id": 20832, "verse_number": "६-१७५-६", "content_sanskrit": "ईश्वर उवाच ।\nइति देव्या वचः श्रुत्वा मुरभिज्ज्ञानगर्वितम् ।\nउवाच श्लक्ष्णया वाचा विस्मयस्मेरलोचनः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000832006, "chapter_id": 20832, "verse_number": "६-१७५-७", "content_sanskrit": "श्रीभगवानुवाच ।\nनाहं सुमुखि निद्रालुर्निजं माहेश्वरं वपुः ।\nदृशा तत्वानुवर्त्तिन्या पश्याम्यंतर्निमग्नया॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000832007, "chapter_id": 20832, "verse_number": "६-१७५-८", "content_sanskrit": "कुशाग्रया धिया देवि यदंतर्योगिनो हृदि ।\nपश्यंति यच्च वेदानां सारं मीमांसते भृशम्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000832008, "chapter_id": 20832, "verse_number": "६-१७५-९", "content_sanskrit": "तदेवमक्षरं ज्योतिरात्मरूपमनामयम् ।\nअखंडानंद संदोह निष्पादि द्वैतवर्जितम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000832009, "chapter_id": 20832, "verse_number": "६-१७५-१०", "content_sanskrit": "यदाश्रया जगद्वृत्तिर्यन्मया चानुभूयते ।\nन येन रहितं किंचिज्जगत्तत्वं चराचरम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000832010, "chapter_id": 20832, "verse_number": "६-१७५-११", "content_sanskrit": "निर्मथ्य बहुधालोक्य वेदशास्त्रांबुधिं सुधीः ।\nद्वैपायनो यदासाद्य गीताशास्त्रं निसृष्टवान्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000832011, "chapter_id": 20832, "verse_number": "६-१७५-१२", "content_sanskrit": "यदास्थाय महानंदमानंदीकृतमानसः ।\nनिद्रालुरिव देवेशि दुग्धाब्धौ प्रतिभामि वै॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000832012, "chapter_id": 20832, "verse_number": "६-१७५-१३", "content_sanskrit": "इति तस्य मुरारातेर्मितमानंदवद्वचः ।\nसा हर्षोत्फुल्ललोलाक्षी लक्ष्मी श्रुत्वा विसिस्मिरे॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000832013, "chapter_id": 20832, "verse_number": "६-१७५-१४", "content_sanskrit": "श्रीरुवाच ।\nभवानेव हृषीकेश ध्येयोऽसि यमिनां सदा ।\nतस्मात्त्वत्तः परं यत्तच्छ्रोतुं कौतूहलं हि मे॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000832014, "chapter_id": 20832, "verse_number": "६-१७५-१५", "content_sanskrit": "चराचराणां लोकानां कर्त्ता हर्त्ता स्वयं प्रभुः ।\nयथास्थितस्ततोऽन्यत्वं यदि मां बोधयाच्युत॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000832015, "chapter_id": 20832, "verse_number": "६-१७५-१६", "content_sanskrit": "श्रीभगवानुवाच ।\nमायामयमिदं देवि वपुर्मे न तु तात्विकम् ।\nसृष्टिस्थित्योपसंहारक्रियाजालोपबृंहितम्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000832016, "chapter_id": 20832, "verse_number": "६-१७५-१७", "content_sanskrit": "अतोऽन्यदात्मनोरूपं द्वैताद्वैतविवर्जितम् ।\nभावाभावविनिर्मुक्तमाद्यंतरहितं प्रिये॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000832017, "chapter_id": 20832, "verse_number": "६-१७५-१८", "content_sanskrit": "शुद्धसंवित्प्रभालाभं परानंदैकसुंदरम् ।\nरूपमैश्वरमात्मैक्यगम्यं गीतासु कीर्तितम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000832018, "chapter_id": 20832, "verse_number": "६-१७५-१९", "content_sanskrit": "इत्याकर्ण्य वचो देवि देवस्यामिततेजसः ।\nशंकमाना ह वाक्येषु परस्परविरोधिषु॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000832019, "chapter_id": 20832, "verse_number": "६-१७५-२०", "content_sanskrit": "स्वयं चेत्परमानंदमवाङ्मनसगोचरम् ।\nकथं गीता बोधयति इति मे च्छिंधि संशयम्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000832020, "chapter_id": 20832, "verse_number": "६-१७५-२१", "content_sanskrit": "ईश्वर उवाच ।\nश्रियः श्रुत्वा वचोयुक्तमितिहासपुरःसरम् ।\nआत्मानुगामिनीं दृष्टिं गीतां बोधितवान्प्रभुः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000832021, "chapter_id": 20832, "verse_number": "६-१७५-२२", "content_sanskrit": "अहमात्मा परेशानि परापरविभेदतः ।\nद्विधा ततः परः साक्षी निर्गुणो निष्कलः शिवः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000832022, "chapter_id": 20832, "verse_number": "६-१७५-२३", "content_sanskrit": "अपरः पंचवक्त्रोऽहं द्विधा तस्यापि संस्थितिः ।\nशब्दार्थभेदतो वाच्यो यथात्माहं महेश्वरः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000832023, "chapter_id": 20832, "verse_number": "६-१७५-२४", "content_sanskrit": "गीतानां वाक्यरूपेण यन्निरुच्छिद्यते दृढः ।\nमदीयपाशबंधोऽयं संसारविषयात्मकः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000832024, "chapter_id": 20832, "verse_number": "६-१७५-२५", "content_sanskrit": "यदाभ्यासपराधीनौ पंचवक्त्रमहेश्वरौ ।\nइति तस्य वचः श्रुत्वा गीतासारमहोदधेः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000832025, "chapter_id": 20832, "verse_number": "६-१७५-२६", "content_sanskrit": "इदं परविभेदेन बुध्यते भवभीरुभिः ।\nतमपृच्छदिदं लक्ष्मीरंगप्रत्यंगसंस्थितम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000832026, "chapter_id": 20832, "verse_number": "६-१७५-२७", "content_sanskrit": "माहात्म्यं सेतिहासं च सर्वं तस्यै न्यवेदयत् ।\nश्रीभगवानुवाच ।\nशृणु सुश्रोणि वक्ष्यामि गीतासु स्थितिमात्मनः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000832027, "chapter_id": 20832, "verse_number": "६-१७५-२८", "content_sanskrit": "वक्त्राणि पंच जानीहि पंचाध्यायाननुक्रमात् ।\nदशाध्याया भुजाश्चैक उदरं द्वौ पदांबुजे॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000832028, "chapter_id": 20832, "verse_number": "६-१७५-२९", "content_sanskrit": "एवमष्टादशाध्याया वाङ्मयी मूर्तिरैश्वरी ।\nविज्ञेया ज्ञानमात्रेण महापातकनाशिनी॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000832029, "chapter_id": 20832, "verse_number": "६-१७५-३०", "content_sanskrit": "अतोध्यायं तदर्धं वा श्लोकमर्द्धं तदर्धकम् ।\nअभ्यस्यति सुमेधा यः सुशर्मेव समुच्यते॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000832030, "chapter_id": 20832, "verse_number": "६-१७५-३१", "content_sanskrit": "श्रीरुवाच ।\nसुशर्मा नाम को देव किं जातीयः किमात्मकः ।\nकुतस्तस्य च वै मुक्तिः केनाजायत हेतुना॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000832031, "chapter_id": 20832, "verse_number": "६-१७५-३२", "content_sanskrit": "श्रीभगवानुवाच ।\nसुशर्मा नाम दुर्मेधाः सीमा पापात्मनामभूत् ।\nजातो नात्मविदां वंशे विप्राणां क्रूरकर्मणाम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000832032, "chapter_id": 20832, "verse_number": "६-१७५-३३", "content_sanskrit": "न ध्यानं न जपो होमो न चैवातिथिपूजनम् ।\nकेवलं विषयेष्वेव बलाढ्येनाभिवर्त्तते॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000832033, "chapter_id": 20832, "verse_number": "६-१७५-३४", "content_sanskrit": "कृषिकर्मरतो नित्यं पर्णजीवी सुराप्रियः ।\nमांसोपहारी सुचिरं कालमेवं निनाय सः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000832034, "chapter_id": 20832, "verse_number": "६-१७५-३५", "content_sanskrit": "आनेतुकामः पर्णानि पर्यटनृषिवाटिकाम् ।\nततः स तत्र दष्टोऽभूत्कालसर्पेण मूढधीः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000832035, "chapter_id": 20832, "verse_number": "६-१७५-३६", "content_sanskrit": "कालधर्मं समासाद्य गत्वा च निरयान्बहून् ।\nपुनरागत्य मर्त्येषु बलीवर्दत्वमीयिवान्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000832036, "chapter_id": 20832, "verse_number": "६-१७५-३७", "content_sanskrit": "पंगुना केन विक्रीतः स स्वजीवनहेतवे ।\nनयन्पृष्ठेन शरदः सप्ताष्टौ कष्टतोनयत्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000832037, "chapter_id": 20832, "verse_number": "६-१७५-३८", "content_sanskrit": "कदाचित्पंगुनासोऽपि चिरमावर्तितो जवात् ।\nपपात तरसा भूमौ मूर्च्छां च प्रतिपेदिवान्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000832038, "chapter_id": 20832, "verse_number": "६-१७५-३९", "content_sanskrit": "विकलांगो विवृत्ताक्षः फेनसंततिमुद्गिरन् ।\nन जीवति न मृत्युं वा प्रतिपेदे स्वकर्मणा॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000832039, "chapter_id": 20832, "verse_number": "६-१७५-४०", "content_sanskrit": "कौतुकाकृष्टलोकेऽस्मिंस्तस्मिन्जनसमागमे ।\nश्रेयसे तस्य सुकृती कश्चित्पुण्यं वितीर्णवान्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000832040, "chapter_id": 20832, "verse_number": "६-१७५-४१", "content_sanskrit": "कर्माणि स्वान्यनुस्मृत्य ददुरन्ये च केचन ।\nगणिका कापि तत्रस्था लोकयात्रानुवर्तिनी॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000832041, "chapter_id": 20832, "verse_number": "६-१७५-४२", "content_sanskrit": "अज्ञात निजपुण्या सा किंचिदुत्सृष्टवत्यभूत् ।\nपरेतनगरीमादौ स नीतः कालकिंकरैः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000832042, "chapter_id": 20832, "verse_number": "६-१७५-४३", "content_sanskrit": "गणिकादत्तपुण्येन पुण्यवानिति मोचितः ।\nपुनरागत्य भूर्लोकं कुलशीलवतां गृहे॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000832043, "chapter_id": 20832, "verse_number": "६-१७५-४४", "content_sanskrit": "द्विजन्मनामसौ जज्ञे जातिं स्वामनुसंस्मरन् ।\nकाले महति जिज्ञासुः श्रेयः स्वाज्ञाननोदनम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000832044, "chapter_id": 20832, "verse_number": "६-१७५-४५", "content_sanskrit": "उपेत्य गणिकां दत्तं ख्यापयित्वा स पृष्टवान् ।\nआचष्ट मां शुको नित्यं पंजरस्थः पठत्यसौ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000832045, "chapter_id": 20832, "verse_number": "६-१७५-४६", "content_sanskrit": "तेन पूतांतरात्माहं तत्पुण्यं पर्यकल्पयम् ।\nताभ्यां शुकस्तु पृष्टोऽसौ व्याख्यातुमुपचक्रमे॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000832046, "chapter_id": 20832, "verse_number": "६-१७५-४७", "content_sanskrit": "आख्यायिकां पुरावृत्तां स्मृत्वा जातिं निजामपि ।\nशुक उवाच ।\nपुरा विद्वानहं भूत्वा वैदुष्य स्मयमोहितः॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000832047, "chapter_id": 20832, "verse_number": "६-१७५-४८", "content_sanskrit": "रागद्वेषेण विद्वत्सु गुणवत्स्वपि मत्सरी ।\nकालेनाहं ततः प्रेत्य प्राप्य लोकाञ्जुगुप्सितान्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000832048, "chapter_id": 20832, "verse_number": "६-१७५-४९", "content_sanskrit": "सोऽहं कीरकुलेऽभूवं सद्गुरावतिनिंदकः ।\nकाले धर्मणि दुष्कर्मा पितृभ्यां च वियोजितः॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000832049, "chapter_id": 20832, "verse_number": "६-१७५-५०", "content_sanskrit": "निदाघेऽध्वनिसंतप्ते आनीतो ऋषिपुंगवैः ।\nपातितः पंजरस्थोऽहं माश्रमे महदाश्रये॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000832050, "chapter_id": 20832, "verse_number": "६-१७५-५१", "content_sanskrit": "आवर्तयद्भ्यो गीतानामाद्यमध्यायमादरात् ।\nश्रुत्वा ऋषिकुमारेभ्यः पाठं चाकरवं मुहुः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000832051, "chapter_id": 20832, "verse_number": "६-१७५-५२", "content_sanskrit": "एतस्मिन्नंतरे कश्चिद्वागुरिश्चौरकर्मकृत् ।\nमामाहृत्य तदाक्रीणादिति वृत्तमुदाहृतम्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000832052, "chapter_id": 20832, "verse_number": "६-१७५-५३", "content_sanskrit": "श्रीभगवानुवाच ।\nअध्यायोऽयं पुराम्नातो येन पापमनोदयम् ।\nपूतांतरात्मा येनासौ मोचितश्च द्विजोत्तमः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000832053, "chapter_id": 20832, "verse_number": "६-१७५-५४", "content_sanskrit": "एवमन्योन्यमाभाष्य तन्माहात्म्यं प्रशस्य च ।\nते जपंतोनिशं धीरा मुक्तिं गेहे प्रपेदिरे॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000832054, "chapter_id": 20832, "verse_number": "६-१७५-५५", "content_sanskrit": "तस्मादध्यायमाद्यं यः पठते शृणुते स्मरेत् ।\nअभ्यसेत्तस्य न भवेद्भवांभोधिर्दुरुत्तरः॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]