    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": "व्याप्तिः"
  },
  {
    "id": 20216686,
    "chapter_id": 7843,
    "verse_number": "६१",
    "content_sanskrit": "व्याप्यस्य पर्वतादिवृत्तित्वं पक्षधर्मता ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": "पक्षधर्मता"
  },
  {
    "id": 20216687,
    "chapter_id": 7843,
    "verse_number": "६२",
    "content_sanskrit": "तत्र स्वार्थ स्वानुमितिहेतुः । तथाहि स्वयमेव भूयोदर्शनेन 'यत्र यत्र धूमस्तत्र तत्राग्निः' इति महानसादौ व्याप्तिं गृहीत्वा पर्वतसमीपं गतस्तद्गते चाग्नौ सन्दिहानः पर्वते धूमं पश्यन्  व्याप्तिं स्मरति- 'यत्र यत्र धूमस्तत्र तत्राग्निः' इति । तदनन्तरं 'वह्निव्याप्य धूमवानयं पर्वतः' इति ज्ञानमुत्पद्यते, अयमेव लिङ्गपरामर्श इत्युच्यते । तस्मात्पर्वतो वह्निमान्, इति ज्ञानमनुमितिरुत्पद्यते । तदेतत्स्वार्थानुमानम् ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": "स्वार्थः"
  },
  {
    "id": 20216688,
    "chapter_id": 7843,
    "verse_number": "६३",
    "content_sanskrit": "यत्तु स्वयं धूमादग्निमनुमाय परं प्रति बोधयितुं पञ्चावयववाक्यं प्रयुज्यते, तत्परार्थानुमानम् । यथा-पर्वतो वह्निमान्, धूमवत्वात्, यो यो धूमवान् स स वह्निमान् यथा महानसम्, तथा चायम्, तस्मात्तथा इति । अनेन प्रतिपादिताल्लिङ्गात्परोऽप्यग्निं प्रतिपद्यते ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": "परार्थः"
  },
  {
    "id": 20216689,
    "chapter_id": 7843,
    "verse_number": "६४",
    "content_sanskrit": "प्रतिज्ञा-हेतू-दाहरणो-पनय-निगमनानि पञ्चावयवाः । (१) पर्वतो वह्निमान्, इति प्रतिज्ञा । (२) धूमवत्वादिति हेतुः । (३) यो यो धूमवान् स स वह्निमानित्युदाहरणम् । (४)  तथा चायमित्युपनयः । (५) तस्मात्तथेति निगमनम् ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
