  {
    "id": 20216644,
    "chapter_id": 7843,
    "verse_number": "१९",
    "content_sanskrit": "चक्षुर्मात्रग्राह्यो गुणो रूपम् । तच्च शुक्लनीलपीतरक्तहरितकपिशचित्रभेदात् सप्तविधम् । पृथिवीजलतेजोवृत्ति । तत्र पृथिव्यां सप्तविधम्, अभास्वरशुक्लं जले । भास्वरशुक्लं तेजसि ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": "रूपम्"
