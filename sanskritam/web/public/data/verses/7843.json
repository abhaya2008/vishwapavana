  {
    "id": 20216692,
    "chapter_id": 7843,
    "verse_number": "६७",
    "content_sanskrit": "अन्वयेन व्यतिरेकेण च व्याप्तिमदन्वयवेतिरेकि । यथा-वह्नौ  साध्ये धूमवत्वम् । 'यत्र धूमस्तत्राग्निर्यथा महानसम्' इत्वन्वयव्याप्तिः । यत्र वह्निर्नास्ति तत्र धूमोऽपि नास्ति यथा ह्रदः इति व्यतिरेकव्याप्तिः ।",
    "padaccheda": "",
