  {
    "id": 20216684,
    "chapter_id": 7843,
    "verse_number": "५९",
    "content_sanskrit": "अनुमितिकरणमनुमानम् । परामर्शजन्यं ज्ञानमनुमितिः ।  व्याप्तिविशिष्टपक्षधर्मता-ज्ञानं परामर्शः । यथा 'वह्निव्याप्यधूमवानयं पर्वतः' इति ज्ञानं परामर्शः । तज्जन्यं पर्वतो वह्निमान्, इति ज्ञानमनुमितिः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": "अनुमानम्"
