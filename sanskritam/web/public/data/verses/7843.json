  {
    "id": 20216647,
    "chapter_id": 7843,
    "verse_number": "२२",
    "content_sanskrit": "त्वगिन्द्रियमात्रग्राह्यो गुणः स्पर्शः । स च त्रिविधः शीतोष्णाऽनुष्णाशीतभेदात् । पृथिव्यप्तेजोवायुवृत्तिः । तत्र शीतो जले । उष्णस्तेजसि । अनुष्णाऽशीतः पृथिवीवाय्योः ।",
    "padaccheda": "",
