  {
    "id": 20216654,
    "chapter_id": 7843,
    "verse_number": "२९",
    "content_sanskrit": "पराऽपरव्यवहारा-साधारणकारणे परत्वाऽपरत्वे । पृथिव्यादिचतुष्टयमनोवृत्तिनी । ते द्विविधे-दिक्कृते कालकृते च । दूरस्थे दिक्कृतं परत्वम् । समीपस्थे दिक्कृतमपरत्वम् । ज्येष्ठे कालकृतं परत्वम् । कनिष्ठे कालकृतमपरत्वम् ।",
    "padaccheda": "",
