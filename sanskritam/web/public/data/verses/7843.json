  {
    "id": 20216685,
    "chapter_id": 7843,
    "verse_number": "६०",
    "content_sanskrit": "'यत्र यत्र धूमस्तत्र तत्र वह्निः' इति साहचर्यनियमो व्याप्तिः । अनुमानं द्विविधं-स्वार्थं परार्थं च ।",
    "padaccheda": "",
