  {
    "id": 20216635,
    "chapter_id": 7843,
    "verse_number": "१०",
    "content_sanskrit": "तत्र गन्धवती पृथिवी । सा द्विविधा नित्याऽनित्या च । नित्या परमाणुरूपा । अनित्या कार्यरूपा । पुनस्त्रिविधा शरीरेन्द्रियविषयभेदात् । शरीरमस्मदादीनाम् । इन्द्रियं गन्धग्राहकं घ्राणं नासाऽग्रवर्ति । विषयो मृत्पाषाणादिः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": "पृथिवी"
  },
  {
    "id": 20216636,
    "chapter_id": 7843,
    "verse_number": "११",
    "content_sanskrit": "शीतस्पर्शवत्य आपः । ता द्विविधाः । नित्या अनित्याश्च । नित्याः परमाणुरूपाः । अनित्याः कार्यरूपाः । पुनस्त्रिविधाः शरीरेन्द्रियविषयभेदात् । शरीरं वरुणलोके । इन्द्रियं रसग्राहकं रसनं जिह्वाऽग्रवर्ति । विषयः सरित्समुद्रादिः ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": "अप्"
  },
  {
    "id": 20216637,
    "chapter_id": 7843,
    "verse_number": "१२",
    "content_sanskrit": "उष्णस्पर्शवत्तेजः । तच्च द्विविधं नित्यमनित्यञ्च । नित्यं परमाणुरूपम्, अनित्यं कार्यरूपम् । पुनस्त्रिविधं-शरीरेन्द्रियविषयभेदात् । शरीरमादित्यलोके प्रसिद्धम् । इन्द्रियं रूपग्राहकं चक्षुः कृष्णताराग्रवर्ति । विषयश्चतुर्विधः-भौम-दिव्यौ-दर्या-करजभेदात् । भौमं वह्न्यादिकम् । अबिन्धनं दिव्यं विद्युदादि । भुक्तस्य परिणामहेतुरौदर्यम् । आकरजं सुवर्णादि ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": "तेजः"
  },
  {
    "id": 20216638,
    "chapter_id": 7843,
    "verse_number": "१३",
    "content_sanskrit": "रूपरहितः स्पर्शवान्वायुः । स द्विविधो नित्योऽनित्यश्च । नित्यः परमाणुरूपः । अनित्यः कार्यरूपः । पुनस्त्रिविधः शरीरेन्द्रियविषयभेदात् । शरीरं वायुलोके । इन्द्रियं स्पर्शग्राहकं त्वक्, सर्वशरीरवर्ति । विषयो वृक्षादिकम्पनहेतुः । शरीराऽन्तःसञ्चारी वायुः प्राणः, स चैकोऽपि उपाधिभेदात् प्राणाऽपानादिसंज्ञां लभते ।",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": "वायुः"
  },
