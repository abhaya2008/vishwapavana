[{"id": 2180156, "chapter_id": 4815, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2180157, "chapter_id": 4815, "verse_number": "१", "content_sanskrit": "ततो राजा पाण्डुसुतो नारदं प्रत्यभाषत ।\nभगवन् श्रोतुमिच्छामि सुवर्णष्ठीविसम्भवम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2180158, "chapter_id": 4815, "verse_number": "२", "content_sanskrit": "एवमुक्तः स च मुनिर्धर्मराजेन नारदः ।\nआचचक्षे यथावृत्तं सुवर्णष्ठीविनं प्रति\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2180159, "chapter_id": 4815, "verse_number": "३", "content_sanskrit": "एवमेतन्महाराज यथायं केशवोऽब्रवीत् ।\nकार्यस्यास्य तु यच्छेषं तत् ते वक्ष्यामि पृच्छतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2180160, "chapter_id": 4815, "verse_number": "४", "content_sanskrit": "अहं च पर्वतश्चैव स्वस्रीयो मे महामुनिः ।\nवस्तुकामावभिगतौ सृञ्जयं जयतां वरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2180161, "chapter_id": 4815, "verse_number": "५", "content_sanskrit": "तत्र सम्पूजितौ तेन विधिदृष्टेन कर्मणा ।\nसर्वकामै सुविहितौ निवसावोऽस्य वेश्मनि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2180162, "chapter_id": 4815, "verse_number": "६", "content_sanskrit": "व्यतिक्रान्तासु वर्षासु समये गमनस्य च ।\nपर्वतो मामुवाचेदं काले वचनमर्थवत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2180163, "chapter_id": 4815, "verse_number": "७", "content_sanskrit": "आवामस्य नरेन्द्रस्य गृहे परमपूजितौ ।\nउषितौ समये ब्रह्मंश्चिन्त्यतामत्र साम्प्रतम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2180164, "chapter_id": 4815, "verse_number": "८", "content_sanskrit": "ततोऽहमब्रुवं राजन् पर्वतं शुभदर्शनम् ।\nसर्वमेतत् त्वयि विभो भागिनेयोपपद्यते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2180165, "chapter_id": 4815, "verse_number": "९", "content_sanskrit": "वरेण छन्द्यतां राजा लभतां यद् यदिच्छति ।\nआवयोस्तपसा सिद्धिं प्राप्नोतु यदि मन्यसे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2180166, "chapter_id": 4815, "verse_number": "१०", "content_sanskrit": "तत आहूय राजानं सृञ्जयं शुभदर्शनम् ।\nपर्वतोऽनुमतं वाक्यमुवाच मुनिपुङ्गवः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2180167, "chapter_id": 4815, "verse_number": "११", "content_sanskrit": "प्रीतौ स्वो नृप सत्कारैस्तव ह्यार्जवसम्भृतैः ।\nआवाभ्यामभ्यनुज्ञातो वरं नृवर चिन्तय\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2180168, "chapter_id": 4815, "verse_number": "१२", "content_sanskrit": "देवानामविहिंसायां यद् भवेन्मानुषक्षमम् ।\nतद् गृहाण महाराज पूजार्हो नौ मतो भवान्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2180169, "chapter_id": 4815, "verse_number": "", "content_sanskrit": "सृञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2180170, "chapter_id": 4815, "verse_number": "१३", "content_sanskrit": "प्रीतौ भवन्तौ यदि मे कृतमेतावता मम ।\nएष एव परो लाभो निर्वृत्तो मे महाफलः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2180171, "chapter_id": 4815, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2180172, "chapter_id": 4815, "verse_number": "१४", "content_sanskrit": "तमेवंवादिनं भूयः पर्वतः प्रत्यभाषत ।\nवृणीष्व राजन् सङ्कल्पो यस्ते हृदि चिरं स्थितः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2180173, "chapter_id": 4815, "verse_number": "", "content_sanskrit": "सृञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2180174, "chapter_id": 4815, "verse_number": "१५", "content_sanskrit": "अभीप्सामि सुतं वीरं वीर्यवन्तं दृढव्रतम् ।\nआयुष्मन्तं महाभागं देवराजसमद्युतिम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2180175, "chapter_id": 4815, "verse_number": "", "content_sanskrit": "पर्वतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2180176, "chapter_id": 4815, "verse_number": "१६", "content_sanskrit": "भविष्यत्येष ते कामो न त्वायुष्मान् भविष्यति ।\nदेवराजाभिभूत्यर्थं सङ्कल्पो ह्येष ते हृदि\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2180177, "chapter_id": 4815, "verse_number": "१७", "content_sanskrit": "सुवर्णष्ठीवनाच्चैव स्वर्णष्ठीवी भविष्यति ।\nरक्ष्यश्च देवराजात् स देवराजसमद्युतिः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2180178, "chapter_id": 4815, "verse_number": "१८", "content_sanskrit": "तच्छ्रुत्वा सृञ्जयो वाक्यं पर्वतस्य महात्मनः ।\nप्रसादयामास तदा नैतदेवं भवेदिति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2180179, "chapter_id": 4815, "verse_number": "१९", "content_sanskrit": "आयुष्मान् मे भवेत् पुत्रो भवतस्तपसा मुने ।\nनच तं पर्वतः किञ्चिदुवाचेन्द्रव्यपेक्षया\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2180180, "chapter_id": 4815, "verse_number": "२०", "content_sanskrit": "तमहं नृपतिं दीनमब्रुवं पुनरेव तु ।\nस्मर्तव्योऽहं महाराज दर्शयिष्यामि ते स्मृतः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2180181, "chapter_id": 4815, "verse_number": "२१", "content_sanskrit": "अहं ते दयितं पुत्रं प्रेतराजवशं गतम् ।\nपुनर्दास्यामि तद् रूपं मा शुचः पृथिवीपते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2180182, "chapter_id": 4815, "verse_number": "२२", "content_sanskrit": "एवमुक्त्वा तु नृपतिं प्रयातौ स्वो यथेप्सितम् ।\nसृञ्जयश्च यथाकामं प्रविवेश स्वमन्दिरम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2180183, "chapter_id": 4815, "verse_number": "२३", "content_sanskrit": "सृञ्जयस्याथ राजर्षेः कस्मिंश्चित् कालपर्यये ।\nजज्ञे पुत्रो महावीर्यस्तजसा प्रज्वलन्निव\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2180184, "chapter_id": 4815, "verse_number": "२४", "content_sanskrit": "ववृधे स यथाकालं सरसीव महोत्पलम् ।\nबभूव काञ्चनष्ठीवी यथार्थं नाम तस्य तत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2180185, "chapter_id": 4815, "verse_number": "२४", "content_sanskrit": "तदद्भुततमं लोके पप्रथे कुरुसत्तम ।\nबुबुधे तच्च देवेन्द्रो वरदानं महात्मनोः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2180186, "chapter_id": 4815, "verse_number": "२६", "content_sanskrit": "ततस्त्वभिभवाद् भीतो बृहस्पतिमते स्थितः ।\nकुमारस्यान्तरप्रेक्षी बभूव बलवृत्रहा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2180187, "chapter_id": 4815, "verse_number": "२७", "content_sanskrit": "चोदयामास वज्रं स दिव्यास्त्रं मूर्तिसंस्थितम् ।\nव्याघ्रो भूत्वा जहीमं त्वं राजपुत्रमिति प्रभो\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2180188, "chapter_id": 4815, "verse_number": "२८", "content_sanskrit": "विवृद्धः किल वीर्येण मामेषोऽभिभविष्यति ।\nसृञ्जयस्य सुतो वज्र यथैनं पर्वतो ददौ\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2180189, "chapter_id": 4815, "verse_number": "२९", "content_sanskrit": "एवमुक्तस्तु शक्रेण वज्रः परपुरञ्जयः ।\nकुमारस्यान्तरप्रेक्षी नित्यमेवान्वपद्यत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2180190, "chapter_id": 4815, "verse_number": "३०", "content_sanskrit": "सृञ्जयोऽपि सुतं प्राप्य देवराजसमद्युतिम् ।\nहृष्टः सान्तःपुरो राजा वननित्योऽभवत्तदा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2180191, "chapter_id": 4815, "verse_number": "३१", "content_sanskrit": "ततो भागीरथीतीरे कदाचिद् वननिर्झरे ।\nधात्रीद्वितीयो बालः स क्रीडार्थं पर्यधावत\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2180192, "chapter_id": 4815, "verse_number": "३२", "content_sanskrit": "पञ्चवर्षकदेशीयो बालो नागेन्द्रविक्रमः ।\nसहसोत्पतितं व्याघ्रमाससाद महाबलः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2180193, "chapter_id": 4815, "verse_number": "३३", "content_sanskrit": "स बालस्तेन निष्पिष्टो वेपमानो नृपात्मजः ।\nव्यसुः पपात मेदिन्यां ततो धात्री विचुक्रुशे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2180194, "chapter_id": 4815, "verse_number": "३४", "content_sanskrit": "हत्वा तु राजपुत्रं स तत्रैवान्तरधीयत ।\nशार्दूलो देवराजस्य माययान्तर्हितस्तदा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2180195, "chapter_id": 4815, "verse_number": "३५", "content_sanskrit": "धात्र्यास्तु निनदं श्रुत्वा रुदत्याः परमार्तवत् ।\nअभ्यधावत तं देशं स्वयमेव महीपतिः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2180196, "chapter_id": 4815, "verse_number": "३६", "content_sanskrit": "स ददर्श गतासुं तं शयानं पीतशोणितम् ।\nकुमारं विगतानन्दं निशाकरमिव च्युतम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2180197, "chapter_id": 4815, "verse_number": "३७", "content_sanskrit": "स तमुत्सङ्गमारोप्य परपीडितवक्षसम् ।\nपुत्रं रुधिरसंसिक्तं पर्यदेवयदातुरः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2180198, "chapter_id": 4815, "verse_number": "३८", "content_sanskrit": "ततस्ता मातररस्तस्य रुदन्त्यः शोककर्शिताः ।\nअभ्यधावन्त तं देशं यत्र राजा स सृञ्जयः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2180199, "chapter_id": 4815, "verse_number": "३९", "content_sanskrit": "ततः स राजा सस्मार मामन्तर्गतमानसः ।\nतच्चाहं चिन्तितं ज्ञात्वा गतवांस्तस्य दर्शनम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2180200, "chapter_id": 4815, "verse_number": "४०", "content_sanskrit": "स मयैतानि वाक्यानि श्रावितः शोकलालसः ।\nयानि ते यदुवीरेण कथितानि महीपते\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2180201, "chapter_id": 4815, "verse_number": "४१", "content_sanskrit": "सञ्जीवितश्चापि मया वासवानुमते तदा ।\nभवितव्यं तथा तच्च न तच्छक्यमतोऽन्यथा\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2180202, "chapter_id": 4815, "verse_number": "४२", "content_sanskrit": "अत ऊर्ध्वं कुमारः स स्वर्णष्ठीवी महायशाः ।\nचित्तं प्रसादयामास पितुर्मातुश्च वीर्यवान्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2180203, "chapter_id": 4815, "verse_number": "४३", "content_sanskrit": "कारयामास राज्यं स पितरि स्वर्गते विभुः ।\nवर्षाणामेकशतवत् सहस्रं भीमविक्रमः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2180204, "chapter_id": 4815, "verse_number": "४४", "content_sanskrit": "तत इष्ट्वा महायज्ञैर्बहुभिर्भूरिदक्षिणैः ।\nतर्पयामास देवांश्च पितॄंश्चैव महाद्युतिः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2180205, "chapter_id": 4815, "verse_number": "४५", "content_sanskrit": "उत्पाद्य च बहून् पुत्रान् कुलसन्तानकारिणः ।\nकालेन महता राजन् कालधर्ममुपेयिवान्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2180206, "chapter_id": 4815, "verse_number": "४६", "content_sanskrit": "स त्वं राजेन्द्र सञ्जातं शोकमेतन्निवर्तय ।\nयथा त्वां केशवः प्राह व्यासश्च सुमहातपाः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2180207, "chapter_id": 4815, "verse_number": "४७", "content_sanskrit": "पितृपैतामहं राज्यमास्थाय धुरमुद्वह ।\nदृष्ट्वा पुण्यैर्महायज्ञैरिष्टाँल्लोकानवाप्स्यसि\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2180208, "chapter_id": 4815, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे नारदेन स्वर्णष्ठीविजन्मकथनं नाम द्वात्रिंशोऽध्यायः ॥ ३२ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]