[{"id": 2195615, "chapter_id": 5164, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2195616, "chapter_id": 5164, "verse_number": "१", "content_sanskrit": "गरुडः पक्षिणां श्रेष्ठ इति पूर्वं पितामह ।\nउक्तस्त्वया महाबाहो श्वेतवाहं प्रशंसता\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2195617, "chapter_id": 5164, "verse_number": "२", "content_sanskrit": "अत्र कौतूहलं मेऽस्ति श्रवणे जायते मतिः ।\nकथं गरुत्मान् पक्षीणां श्रैष्ठ्यं प्राप परन्तप\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2195618, "chapter_id": 5164, "verse_number": "३", "content_sanskrit": "सुपर्णो वैनतेयश्च केन शत्रुश्च भोगिनाम् ।\nकिंवीर्यः किम्बलश्चासौ वक्तुमर्हसि भारत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2195619, "chapter_id": 5164, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2195620, "chapter_id": 5164, "verse_number": "४", "content_sanskrit": "वासुदेव महाबाहो देवकी सुप्रजास्त्वया ।\nश्रुतं ते धर्मराजस्य यदुहर्षविवर्धन\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2195621, "chapter_id": 5164, "verse_number": "५", "content_sanskrit": "सुपर्णं शंस इत्येव मामाह कुरुनन्दनः ।\nअस्य प्रवक्तुमिच्छामि त्वयाऽऽज्ञप्तो महाद्युते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2195622, "chapter_id": 5164, "verse_number": "६", "content_sanskrit": "त्वं हि शौरे महाबाहो सुपर्णः प्रोच्यसे पुरा ।\nअनादिनिधने काले गरुडश्चासि केशव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2195623, "chapter_id": 5164, "verse_number": "७", "content_sanskrit": "तस्मात् पूर्वं प्रसाद्य त्वां धर्मपुत्राय धीमते ।\nगरुडं पततांश्रेष्ठं वक्तुमिच्छामि माधव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2195624, "chapter_id": 5164, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2195625, "chapter_id": 5164, "verse_number": "८", "content_sanskrit": "यथैव मां भवान् वेद तथा वेद युधिष्ठिरः ।\nयथा च गरुडो राजंस्तथाऽस्मै ब्रूहि तत्त्वतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2195626, "chapter_id": 5164, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे गरुडोपाख्यानारम्भो नाम पञ्चदशोऽध्यायः ॥१५॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]