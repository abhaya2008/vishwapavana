[{"id": 2098469, "chapter_id": 3106, "verse_number": "१३-२३६-१", "content_sanskrit": "उमोवाच।\nभगवन्देवदेवेश कथं देयं तिलान्वितम्।\nतस्य तस्य फलं ब्रूहि दत्तस्य च कृतस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2098470, "chapter_id": 3106, "verse_number": "१३-२३६-२x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2098471, "chapter_id": 3106, "verse_number": "१३-२३६-२", "content_sanskrit": "तिलकल्पविधिं देवि तन्मे शृणु समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2098472, "chapter_id": 3106, "verse_number": "१३-२३६-३", "content_sanskrit": "समृद्धैरसमृद्धैर्वा तिला देया विशेषतः।\nतिलाः पवित्राः पापघ्नाः सुपुण्या इति संस्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2098473, "chapter_id": 3106, "verse_number": "१३-२३६-४", "content_sanskrit": "न्यायतस्तु तिलाञ्शुद्धान्संहृत्याथ स्वशक्तिनः।\nतिलराशिं पुनः कुर्यात्पर्वाताभं सुरस्नकम्।\nमहान्तं यदि वा स्तोकं नानाद्रव्यसमन्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2098474, "chapter_id": 3106, "verse_number": "१३-२३६-५", "content_sanskrit": "सुवर्णरजताभ्यां च मणिमुक्ताप्रवालकैः।\nअलङ्कृत्य यथायोगं सपताकं सवेदिकम्।\nसभूषणं सवस्त्रं च शयनासनसंमितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2098475, "chapter_id": 3106, "verse_number": "१३-२३६-६", "content_sanskrit": "प्रायशः कौमुदीमासे पौर्णमास्यां विशेषतः।\nभोजयित्वा च विधिवद्ब्राह्म्णानर्हतो बहून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2098476, "chapter_id": 3106, "verse_number": "१३-२३६-७", "content_sanskrit": "स्वयं कृतोपवासश्च वृत्तशौचसमन्वितः।\nदद्यात्प्रदक्षिणीकृत्य तिलराशिं सदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2098477, "chapter_id": 3106, "verse_number": "१३-२३६-८", "content_sanskrit": "एकस्यापि बहूनां वा दातव्यं भूतिमिच्छता।\nतस्य दानफलं देवि अग्निष्टोमेन संयुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2098478, "chapter_id": 3106, "verse_number": "१३-२३६-९", "content_sanskrit": "केवलं वा तिलैरेव भूमौ कृत्वा गवाकृतिम्।\nसवस्त्रकं सरत्नं च पुंसा गोदानकाङ्क्षिणा।\nतदर्हाय प्रदातव्यं तस्य गोदानतः फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2098479, "chapter_id": 3106, "verse_number": "१३-२३६-१०", "content_sanskrit": "शरावांस्तिलसम्पूर्णान्सहिरण्यान्सचम्पकान्।\nनृपोऽददद्ब्राह्मणाय सु पुण्यफलभाग्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2098480, "chapter_id": 3106, "verse_number": "१३-२३६-११", "content_sanskrit": "एवं तिलमयं देयं नरेण हितमिच्छता।\nनानादानफलं भूयः शृणु देवि समाहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2098481, "chapter_id": 3106, "verse_number": "१३-२३६-१२", "content_sanskrit": "बलमायुष्यमारोग्यमन्नदानाल्लभेन्नरः।\nपानीयदस्तु सौभाग्यं रसज्ञानं लभेन्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2098482, "chapter_id": 3106, "verse_number": "१३-२३६-१३", "content_sanskrit": "वस्त्रदानाद्वपुःशोभामलङ्कारं लभेन्नरः।\nदीपदो बुद्धिवैशद्यं द्युतिशोभां लभेन्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2098483, "chapter_id": 3106, "verse_number": "१३-२३६-१४", "content_sanskrit": "राजपीडाविमोक्षं तु छत्रदो लभते फलम्।\nदासीदासप्रदानात्तु भवेत्कर्मान्तभाङ्नरः।\nदासीदासं च विविधं लभेत्प्रेत्य गुणान्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2098484, "chapter_id": 3106, "verse_number": "१३-२३६-१५", "content_sanskrit": "यानानि वाहनं चैव तदर्हाय ददन्नरः।\nपादरोगपरिक्लेशान्मुक्तः श्वसनवाहवान्।\nविचित्र रमणीयं च लभते यानवाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2098485, "chapter_id": 3106, "verse_number": "१३-२३६-१६", "content_sanskrit": "प्रतिश्रयप्रदानं च तदर्हाय तदिच्छते।\nवर्षाकाले तु रात्रौ वा लभेत्पक्षबलं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2098486, "chapter_id": 3106, "verse_number": "१३-२३६-१७", "content_sanskrit": "सेतुकूपतटाकानां कर्ता तु लभते नरः।\nदीर्घायुष्यं च सौभाग्यं तता प्रेत्य गतिं शुभां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2098487, "chapter_id": 3106, "verse_number": "१३-२३६-१८", "content_sanskrit": "वृक्षसंरोपको यस्तु छायापुष्पफलप्रदः।\nप्रेत्यभावे लभेत्पुण्यमभिगम्यो भवेन्नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2098488, "chapter_id": 3106, "verse_number": "१३-२३६-१९", "content_sanskrit": "यस्तु सङ्क्रमकृल्लोके नदीषु जलहारिणाम्।\nलभेत्पुण्यफलं प्रेत्य व्यसनेभ्यो विमोक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2098489, "chapter_id": 3106, "verse_number": "१३-२३६-२०", "content_sanskrit": "मार्गकृत्सततं मर्त्यो भवेत्सन्तानवान्नरः।\nकायदोषविमुक्तस्तु तीर्थकृत्सततं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2098490, "chapter_id": 3106, "verse_number": "१३-२३६-२१", "content_sanskrit": "औषधानां प्रदानात्तु सततं कृपयाऽन्वितः।\nभवेद्व्याधिविहीनश्च दीर्घायुश्च विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2098491, "chapter_id": 3106, "verse_number": "१३-२३६-२२", "content_sanskrit": "अनाथान्पोषयेद्यस्तु कृपणान्धकपङ्गुकान्।\nस च पुण्यफलं प्रेत्य लभते कृच्छ्रमोक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2098492, "chapter_id": 3106, "verse_number": "१३-२३६-२३", "content_sanskrit": "वेदगोष्ठाः शुभाः शाला भिक्षूणां च प्रतिश्रयम्।\nयः कुर्याल्लभते नित्यं नरः प्रेत्य फलं शुभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2098493, "chapter_id": 3106, "verse_number": "१३-२३६-२४", "content_sanskrit": "प्रासादवासं विविधं यक्षशोभां लभेत्पुनः।\nविविधं विविधाकारं भक्ष्यभोज्यगुणान्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2098494, "chapter_id": 3106, "verse_number": "१३-२३६-२५", "content_sanskrit": "रम्यं तं दैवगोवाटं यः कुर्याल्लभते नरः।\nप्रेत्य भावे शुभां जातिं व्याधिमोक्षं तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2098495, "chapter_id": 3106, "verse_number": "१३-२३६-२६", "content_sanskrit": "एवं नानाविधं द्रव्यं दानकर्ता लभेत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2098496, "chapter_id": 3106, "verse_number": "१३-२३६-२७x", "content_sanskrit": "उमोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2098497, "chapter_id": 3106, "verse_number": "१३-२३६-२७", "content_sanskrit": "कृतं दत्तं यथा यावत्तस्य तल्लभते फलम्।\nएतन्मे देवदेवेश तत्र कौतूहलं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2098498, "chapter_id": 3106, "verse_number": "१३-२३६-२८x", "content_sanskrit": "महेश्वर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2098499, "chapter_id": 3106, "verse_number": "१३-२३६-२८", "content_sanskrit": "प्रेत्यिभावे शृणु फलं दत्तस्य च कृतस्य च।\nदानं षङ्गुणयुक्तं तु तदर्हाय यथाविधिः।\nयथाविभवतो दानं दातव्यमिति मानवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2098500, "chapter_id": 3106, "verse_number": "१३-२३६-२९", "content_sanskrit": "बुद्धिमायुष्यमारोग्यं बलं भाग्यं तथाऽऽगमम्।\nरूपेण सप्तधा भूत्वा मानुष्यं फलति ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2098501, "chapter_id": 3106, "verse_number": "१३-२३६-३०", "content_sanskrit": "इदं दत्तमिदं देयमित्येवं फलकाङ्क्षया।\nयद्दत्तं तत्तदेव स्यान्न तु किञ्चन लभ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2098502, "chapter_id": 3106, "verse_number": "१३-२३६-३१", "content_sanskrit": "ध्रुवं देव्यत्तमे दानं मध्यमे त्वधमं फलम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2098503, "chapter_id": 3106, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षट्त्रिंशदधिकद्विशततमोऽध्यायः॥ २३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]