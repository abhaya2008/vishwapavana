[{"id": 2017931, "chapter_id": 1373, "verse_number": "३-११-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2017932, "chapter_id": 1373, "verse_number": "३-११-१", "content_sanskrit": "किर्मीरस्य वधं क्षत्तः श्रोतुमिच्छामि कथ्यताम्।\nरक्षसा भीमसेनस्य कथमासीत्समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2017933, "chapter_id": 1373, "verse_number": "३-११-२x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2017934, "chapter_id": 1373, "verse_number": "३-११-२", "content_sanskrit": "शृणु भीमस्य कर्मेदमतिमानषकर्मणः।\nश्रुतपूर्वं मया तेषां कथान्तेषु पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2017935, "chapter_id": 1373, "verse_number": "३-११-३", "content_sanskrit": "इतः प्रयाता राजेन्द्र पाण्डवा द्यूतनिर्जिताः।\nजग्मुस्त्रिभिरहोरात्रैः काम्यकं नाम तद्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2017936, "chapter_id": 1373, "verse_number": "३-११-४", "content_sanskrit": "रात्रौ निशीथे त्वाभीले गतेऽर्धसमये नृप।\nप्रचारे पुरुषादानां रक्षसां घोरकर्मणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2017937, "chapter_id": 1373, "verse_number": "३-११-५", "content_sanskrit": "तद्वनं तापसा नित्यमशेषा वनचारिणः।\nदूरात्परिहरन्ति स्म पुरुषादभयात्किल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2017938, "chapter_id": 1373, "verse_number": "३-११-६", "content_sanskrit": "तेषां प्रविशतां तत्र मार्गमावृत्य भारत।\nदीप्ताक्षं भीषणं रक्षः मोल्मुकं प्रत्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2017939, "chapter_id": 1373, "verse_number": "३-११-७", "content_sanskrit": "बाहू महान्तौ कृत्वा च तथास्यं च भयानकम्।\nस्थितमावृत्यपन्थानं येन यान्ति कुरूद्वहाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2017940, "chapter_id": 1373, "verse_number": "३-११-८", "content_sanskrit": "दष्टोष्ठदंष्ट्रं ताम्राक्षं प्रदीप्तोर्ध्वशिरोरुहम्।\nसार्करश्मितडिच्चक्रं सबलाकमिवाम्बुदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2017941, "chapter_id": 1373, "verse_number": "३-११-९", "content_sanskrit": "सृजन्तं राक्षसीं मायां महानादनिनादितम्।\nमुञ्चन्तं विपुलान्नादान्सतोयमिव तोयदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2017942, "chapter_id": 1373, "verse_number": "३-११-१०", "content_sanskrit": "तस्य नादेन संत्रस्ताः पक्षिणः सर्वतोदिशम्।\nविमुक्तनादाः संपेतुः स्थलजा जलजैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2017943, "chapter_id": 1373, "verse_number": "३-११-११", "content_sanskrit": "संप्रद्रुतमृगद्वीपिमहिषर्क्षसमाकुलम्।\nतद्वनं तस्य नादेन संप्रस्थितमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2017944, "chapter_id": 1373, "verse_number": "३-११-१२", "content_sanskrit": "तस्योरुवाताभिहतास्ताम्रपल्लवबाहवः।\nविदूरजाताश्च लताः समाश्लिष्यन्ति पादपान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2017945, "chapter_id": 1373, "verse_number": "३-११-१३", "content_sanskrit": "तस्मिन्क्षणेऽथ प्रववौ मारुतो भृशदारुणः।\nरजसा संवृतं तेन नष्टर्क्षमभवन्नभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2017946, "chapter_id": 1373, "verse_number": "३-११-१४", "content_sanskrit": "पञ्चानां पाण्डुपुत्राणामविज्ञातो महारिपुः।\nपञ्चानामिन्द्रियाणां तु शोकावेश इवातुलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2017947, "chapter_id": 1373, "verse_number": "३-११-१५", "content_sanskrit": "स दृष्ट्वा पाण्डवान्दूरात्कृष्णाजिनसमावृतान्।\nआवृणोत्तद्वनद्वारं मैनाक इव पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2017948, "chapter_id": 1373, "verse_number": "३-११-१६", "content_sanskrit": "तं समासाद्य वित्रस्ता कृष्णा कमललोचना।\nअदृष्टपूर्वं संत्रासान्न्यमीलयत लोचने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2017949, "chapter_id": 1373, "verse_number": "३-११-१७", "content_sanskrit": "दुःशासनकरोत्सृष्टविप्रकीर्णशिरोरुहा।\nपञ्चपर्वतमध्यस्था नदीवाकुलतां गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2017950, "chapter_id": 1373, "verse_number": "३-११-१८", "content_sanskrit": "विमुह्यमानां तां तत्र जगृहुः पञ्च पाण्डवाः।\nइन्द्रियाणि प्रसक्तानि विषयेषु यथारतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2017951, "chapter_id": 1373, "verse_number": "३-११-१९", "content_sanskrit": "अथ तां राक्षसीं मायामुत्थितां घोरदर्शनाम्।\nरक्षोघ्नैर्विविधैर्मन्त्रैर्धौम्यः सम्यक्प्रयोजितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2017952, "chapter_id": 1373, "verse_number": "३-११-२०", "content_sanskrit": "पश्यतां पाण्डुपुत्राणां नाशयामास वीर्यवान्।\nस नष्टमायोऽतिबलः क्रोधविस्फारितेक्षणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2017953, "chapter_id": 1373, "verse_number": "३-११-२१", "content_sanskrit": "काममूर्तिधरः क्रूरः कालकल्पो व्यदृश्यत।\nतमुवाच ततो राजा दीर्घप्रज्ञो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2017954, "chapter_id": 1373, "verse_number": "३-११-२२", "content_sanskrit": "को भवान्कस्य वा किं ते क्रियतां कार्यमुच्यताम्।\nप्रत्युवाचाथ तद्रक्षो धर्मराजं युधिष्ठिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2017955, "chapter_id": 1373, "verse_number": "३-११-२३", "content_sanskrit": "अहं वकस्य वै भ्राता किर्मीर इति विश्रुतः।\nवनेऽस्मिन्काम्यके शून्ये निवसामि गतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2017956, "chapter_id": 1373, "verse_number": "३-११-२४", "content_sanskrit": "युधि निर्जित्य पुरुषानाहारं नित्यमाचरन्।\nके यूयमभिसंप्राप्ता भक्ष्यभूता ममान्तिकम्।\nयुधि निर्जित्यवः सर्वान्भक्षयिष्ये गतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2017957, "chapter_id": 1373, "verse_number": "३-११-२५x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2017958, "chapter_id": 1373, "verse_number": "३-११-२५", "content_sanskrit": "युधिष्ठिरस्तु तच्छ्रुत्वा वचस्तस्य दुरात्मनः।\nआचचक्षे ततः सर्वं गोत्रनामादि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2017959, "chapter_id": 1373, "verse_number": "३-११-२६", "content_sanskrit": "पाण्डवो धर्मराजोऽहं यदि ते श्रोत्रमागतः।\nसहितो भ्रातृभिः सर्वैर्भीमसेनार्जुनादिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2017960, "chapter_id": 1373, "verse_number": "३-११-२७", "content_sanskrit": "हृतराज्यो वने वासं वस्तुं कृतमतिस्ततः।\nवनमभ्यागतो घोरमिदं तव परिग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2017961, "chapter_id": 1373, "verse_number": "३-११-२८", "content_sanskrit": "`विस्मयं परमं गत्वा राक्षसो घोरदर्शनः।\nकिर्मीरस्त्वब्रवीदेनं दिष्ट्या देवैरिदं मम।\nउपपादितमद्येह चिरकालान्मनोरथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2017962, "chapter_id": 1373, "verse_number": "३-११-२९", "content_sanskrit": "भीमसेनवधार्थं हि नित्यमभ्युद्यतायुधः।\nचरामि पृथिवीं कृत्स्नां नैनं चासादयाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2017963, "chapter_id": 1373, "verse_number": "३-११-३०", "content_sanskrit": "सोयमासादितो दिष्ट्या भ्रातृहा काङ्क्षितश्चिरम्।\nअनेन हि मम भ्राता बको विनिहतः प्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2017964, "chapter_id": 1373, "verse_number": "३-११-३१", "content_sanskrit": "वैत्रकीयवने राजन्ब्राह्मणच्छद्मरूपिणा।\nविद्याबलमुपाश्रित्य न ह्मस्त्यस्यौरसं बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2017965, "chapter_id": 1373, "verse_number": "३-११-३२", "content_sanskrit": "हिडिम्बश्च सखा मह्मं दयितो वनगोचरः।\nहतो दुरात्मनाऽनेन स्वसा चास्य हृता पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2017966, "chapter_id": 1373, "verse_number": "३-११-३३", "content_sanskrit": "सोयमभ्यागतो मूढो ममेदं गहनं वनम्।\nप्रचारसमयेऽस्माकमर्द्धरात्रे स्थिते समे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2017967, "chapter_id": 1373, "verse_number": "३-११-३४", "content_sanskrit": "अद्यास्य यातयिष्यामि तद्वैरं चिरसंभृतम्।\nतर्पयिष्यामि च बकं रुधिरेणास्य भूरिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2017968, "chapter_id": 1373, "verse_number": "३-११-३५", "content_sanskrit": "अद्याहमनृणो भूत्वा भ्रातुः सख्युस्तथैव च।\nशान्तिं लब्धास्मि परमां हत्वा राक्षसकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2017969, "chapter_id": 1373, "verse_number": "३-११-३६", "content_sanskrit": "यदि तेन पुरा मुक्तो भीमसेनो बकेन वै।\nअद्यैनं भक्षयिष्यामि पश्यतस्ते युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2017970, "chapter_id": 1373, "verse_number": "३-११-३७", "content_sanskrit": "एनं हि विपुलप्राणमद्य हत्वा वृकोदरम्।\nसंभक्ष्य जरयिष्यामि यथाऽगस्त्यो महासुरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2017971, "chapter_id": 1373, "verse_number": "३-११-३८", "content_sanskrit": "एवमुक्तस्तु धर्मात्मा सत्यसन्धो युधिष्ठिरः।\nनैतदस्तीति सक्रोधो भर्त्सयामास राक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2017972, "chapter_id": 1373, "verse_number": "३-११-३९", "content_sanskrit": "ततो भीमो महाबाहुरारुज्यतरसा द्रुमम्।\nदशव्याममथोद्विद्धं निष्पत्रमकरोत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2017973, "chapter_id": 1373, "verse_number": "३-११-४०", "content_sanskrit": "चकार सज्यं गाण्डीवं वज्रनिष्पेषगौरवम्।\nनिमेषान्तरमात्रेण तथैव विजयोऽर्जुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2017974, "chapter_id": 1373, "verse_number": "३-११-४१", "content_sanskrit": "निवार्य भीमो जिष्णुं तं तद्रक्षो मेघनिःस्वनम्।\nअभिद्रुत्याब्रवीद्वाक्यं तिष्ठतिष्ठेति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2017975, "chapter_id": 1373, "verse_number": "३-११-४२", "content_sanskrit": "इत्युक्त्वैनमतिक्रुद्धः कक्ष्यामुत्पीड्य पाण्डवः।\nनिष्पिष्य पाणिना पाणिं संदष्टौष्ठपुटो बली।\nतमभ्यधावद्वेगेन भीमो वृक्षायुधस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2017976, "chapter_id": 1373, "verse_number": "३-११-४३", "content_sanskrit": "यमदण्डप्रतीकाशं ततस्तं तस्य मूर्धनि।\nपातयामास वेगेन कुलिशं मघवानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2017977, "chapter_id": 1373, "verse_number": "३-११-४४", "content_sanskrit": "असंभ्रान्तं तु तद्रक्षः समरे प्रत्यदृश्यत।\nचिक्षेप चोल्मुकं दीप्तमशनिं ज्वलितामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2017978, "chapter_id": 1373, "verse_number": "३-११-४५", "content_sanskrit": "तदुदस्तमलातं तु भीमः प्रहरतां वरः।\nपदा सव्येन चिक्षेप तद्रक्षः पुनराव्रजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2017979, "chapter_id": 1373, "verse_number": "३-११-४६", "content_sanskrit": "किर्मीरश्चापि सहसा वृक्षमुत्पाट्य पाण्डवम्।\nदण्डपाणिरिव क्रुद्धः समरे प्रत्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2017980, "chapter_id": 1373, "verse_number": "३-११-४७", "content_sanskrit": "तद्वृक्षयुद्धमभवन्महीरुहविनाशनम्।\nवालिसुग्रीवयोर्भ्रात्रोर्यथा स्त्रीकाङ्क्षिणोः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2017981, "chapter_id": 1373, "verse_number": "३-११-४८", "content_sanskrit": "शीर्षयोः पतिता वृक्षा विभिदुर्नैकधा तयोः।\nयथैवोत्पलपत्राणि मत्तयोर्द्विपयोस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2017982, "chapter_id": 1373, "verse_number": "३-११-४९", "content_sanskrit": "मूर्ध्निजर्झरभूतास्तु बहवस्तत्र पादपाः।\nचीराणीव व्युदस्तानि रेजुस्तत्र महावने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2017983, "chapter_id": 1373, "verse_number": "३-११-५०", "content_sanskrit": "तद्वृक्षयुद्धमभवन्महूर्तं भरतर्षभ।\nराक्षसानां च मुख्यस्य नराणामुत्तमस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2017984, "chapter_id": 1373, "verse_number": "३-११-५१", "content_sanskrit": "ततः शिलां समुत्क्षिप्य भीमस्य युधि तिष्ठतः।\nप्राहिणोद्रासः क्रुद्धो भीमसेनश्चचाल ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2017985, "chapter_id": 1373, "verse_number": "३-११-५२", "content_sanskrit": "तं शिलाताडनजडं पर्यधावत राक्षसः।\nबाहुविक्षिप्तकिरणः स्वर्भानुरिव भास्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2017986, "chapter_id": 1373, "verse_number": "३-११-५३", "content_sanskrit": "तावन्योन्यं समाश्लिश्य प्रकर्षन्तौ परस्परम्।\nउभावपि चकाशेते प्रवृद्धौ वृषभाविव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2017987, "chapter_id": 1373, "verse_number": "३-११-५४", "content_sanskrit": "तयोरासीत्सुतुमुलः संप्रहारः सुदारुणः।\nनखदंष्ट्रायुधवतोर्व्याघ्रयोरिव दृप्तयोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2017988, "chapter_id": 1373, "verse_number": "३-११-५५", "content_sanskrit": "दुर्योधननिकाराच्च बाहुवीर्याच्च दर्पितः।\nकृष्णानयनदृष्टश्च व्यवर्धत वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2017989, "chapter_id": 1373, "verse_number": "३-११-५६", "content_sanskrit": "अभिहत्याथ बाहुभ्यां प्रत्यगृह्णादमर्षितः।\nमातङ्गमिव मातङ्गः प्रभिननकरटामुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2017990, "chapter_id": 1373, "verse_number": "३-११-५७", "content_sanskrit": "स चाप्येनं ततो रक्षः प्रतिजग्राह वीर्यबान्।\nतमाक्षिपद्भीमसेनो बलेन बलिनां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2017991, "chapter_id": 1373, "verse_number": "३-११-५८", "content_sanskrit": "तयोर्भुजविनिष्पेषादुभयोर्बलिनोस्तदा।\nशब्दः समभवद्घोरो वेणुस्फोटसमो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2017992, "chapter_id": 1373, "verse_number": "३-११-५९", "content_sanskrit": "अथैनमाक्षिप्य बलाद्गृद्य मध्ये वृकोदरः।\nधूनयामास वेगेन वायुश्चण्ड इव द्रुमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2017993, "chapter_id": 1373, "verse_number": "३-११-६०", "content_sanskrit": "स भीमेन परामृष्टो दुर्बलो बलिनां रणे।\nव्यस्पन्दत यथाप्राणं विचकर्ष च पाण्डवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2017994, "chapter_id": 1373, "verse_number": "३-११-६१", "content_sanskrit": "तत एनं परिश्रान्तमुपलक्ष्य वृकोदरः।\nयोक्रयामास बाहुभ्यां पशुं रशनया यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2017995, "chapter_id": 1373, "verse_number": "३-११-६२", "content_sanskrit": "विनदन्तं महानादं भिन्नभिरीस्वनं बली।\nभ्रामयामास सुचिरं विस्फुरन्तमचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2017996, "chapter_id": 1373, "verse_number": "३-११-६३", "content_sanskrit": "तं विषीदन्तमाज्ञाय राक्षसं पाण्डुनन्दनः।\nप्रगृह्य तरसा दोर्भ्यां पशुमारममारयत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2017997, "chapter_id": 1373, "verse_number": "३-११-६४", "content_sanskrit": "आक्रम्य च कटीदेशे जानुना राक्षसाधमम्।\nपीडयामास पाणिभ्यां तस्य कण्ठंवृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2017998, "chapter_id": 1373, "verse_number": "३-११-६५", "content_sanskrit": "अथ जर्जरसर्वाङ्गं व्यावृत्तनयनोल्बणम्।\nभूतले भ्रामयामास वाक्यं चेदमुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2017999, "chapter_id": 1373, "verse_number": "३-११-६६", "content_sanskrit": "हिडिम्बबकयोः पाप न त्वमश्रुप्रमार्जनम्।\nकरिष्यसि गतश्चापि यमस्य सदनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2018000, "chapter_id": 1373, "verse_number": "३-११-६७", "content_sanskrit": "इत्येवमुक्त्वा पुरुषप्रवीर-\nस्तं राक्षसं क्रोधपरीतचेताः।\nविस्रस्तवस्त्राभरणं स्फुरन्त-\nमुद्धान्तचित्तं व्यसुमुत्ससर्ज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2018001, "chapter_id": 1373, "verse_number": "३-११-६८", "content_sanskrit": "तस्मिन्हते तोयदतुल्यरूपे\nकृष्णां पुरस्कृत्य नरेन्द्रपुत्राः।\nभीमं प्रशस्याथ गुणैरनेकै-\nर्हृष्टास्ततो द्वैतवनाय जग्मुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2018002, "chapter_id": 1373, "verse_number": "३-११-६९x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2018003, "chapter_id": 1373, "verse_number": "३-११-६९", "content_sanskrit": "एवं विनिहतः सङ्ख्ये किर्मोरो मनुजाधिप।\nभीमेन वचनात्तस् धर्मराजस्य कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2018004, "chapter_id": 1373, "verse_number": "३-११-७०", "content_sanskrit": "ततो निष्कष्टकं कृत्वा वनं तदयराजितः।\nद्रौपद्या सह धर्मज्ञो वसतिं तामुवास ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2018005, "chapter_id": 1373, "verse_number": "३-११-७१", "content_sanskrit": "समाश्वास्य च ते सर्वे द्रौपदीं भरतर्षभाः।\nप्रहृष्टमनसः प्रीत्या प्रसशंसुर्वृकोदरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2018006, "chapter_id": 1373, "verse_number": "३-११-७२", "content_sanskrit": "भीमबाहुबलोत्पिष्टे विनष्टे राक्षसे ततः।\nविविशुस्ते वनं वीराः क्षेमं निहतकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2018007, "chapter_id": 1373, "verse_number": "३-११-७३", "content_sanskrit": "स मया गच्छता मार्गे विनिकीर्णो भयावहः।\nवने महति दुष्टात्मा दृष्टो भीमबलाद्धतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2018008, "chapter_id": 1373, "verse_number": "३-११-७४", "content_sanskrit": "तत्राश्रौषमहं चैतत्कर्म भीमस् भारत।\nब्राह्मणानां कथयतां ये तत्रासन्समागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2018009, "chapter_id": 1373, "verse_number": "३-११-७५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2018010, "chapter_id": 1373, "verse_number": "", "content_sanskrit": "एवं विनिहतं सङ्ख्ये किर्मीरं रक्षसां वरम्।\nश्रुत्वा ध्यानपरो राजा निशश्वासार्तवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]