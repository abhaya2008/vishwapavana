[{"id": 7000444000, "chapter_id": 20444, "verse_number": "२-११६-१", "content_sanskrit": "कुंजल उवाच ।\nअशोकसुंदरी पुण्या रंभया सह हर्षिता ।\nनहुषं प्राप्य विक्रांतं तमुवाच तपस्विनी॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000444001, "chapter_id": 20444, "verse_number": "२-११६-२", "content_sanskrit": "अहं ते धर्मतः पत्नी देवैर्दिष्टा तपस्विनी ।\nउद्वाहयस्व मां वीर यदि धर्ममिहेच्छसि॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000444002, "chapter_id": 20444, "verse_number": "२-११६-३", "content_sanskrit": "सदैव चिंत्यमाना च त्वामहं तपसि स्थिता ।\nभवान्धर्मप्रसादेन मया प्राप्तो नृपोत्तम॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000444003, "chapter_id": 20444, "verse_number": "२-११६-४", "content_sanskrit": "नहुष उवाच ।\nमदर्थे नियता भद्रे यदि त्वं तपसि स्थिता ।\nगुरोर्वाक्यान्मुहूर्तेन तव भर्ता भवाम्यहम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000444004, "chapter_id": 20444, "verse_number": "२-११६-५", "content_sanskrit": "अनया रंभया सार्द्धमावां गच्छाव भामिनि ।\nसमारोप्य रथे तां तु तां रंभां तु मनोरमाम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000444005, "chapter_id": 20444, "verse_number": "२-११६-६", "content_sanskrit": "तेनैव रथवर्येण वशिष्ठस्याश्रमं प्रति ।\nजगाम लघुवेगेन ताभ्यां सह महायशाः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000444006, "chapter_id": 20444, "verse_number": "२-११६-७", "content_sanskrit": "तमाश्रमगतं विप्रं समालोक्य प्रणम्य च ।\nतया सार्द्धं महातेजा हर्षेण महतान्वितः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000444007, "chapter_id": 20444, "verse_number": "२-११६-८", "content_sanskrit": "यथा युद्धं रणे जातं निहतो दानवाधमः ।\nनिवेदयामास सर्वं वशिष्ठाय महात्मने॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000444008, "chapter_id": 20444, "verse_number": "२-११६-९", "content_sanskrit": "वशिष्ठोऽपि समाकर्ण्य नहुषस्य विचेष्टितम् ।\nहर्षेण महताविष्ट आशीर्भिरभिनंद्य तम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000444009, "chapter_id": 20444, "verse_number": "२-११६-१०", "content_sanskrit": "तिथौ लग्ने शुभे प्राप्ते तयोस्तु मुनिपुंगवः ।\nविवाहं कारयामास अग्निब्राह्मणसन्निधौ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000444010, "chapter_id": 20444, "verse_number": "२-११६-११", "content_sanskrit": "आशीर्भिरभिनंद्यैव मिथुनं प्रेषितं पुनः ।\nमातरं पितरं पश्य द्रुतं गत्वा महामते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000444011, "chapter_id": 20444, "verse_number": "२-११६-१२", "content_sanskrit": "त्वां च दृष्ट्वा हि ते माता पितासौ तव सुव्रत ।\nहर्षेण वृद्धिमाप्नोतु पर्वणीव तु सागरः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000444012, "chapter_id": 20444, "verse_number": "२-११६-१३", "content_sanskrit": "एवं संप्रेषितो वीरो मुनिना ब्रह्मसूनुना ।\nतेनैव रथवर्येण जगाम लघुविक्रमः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000444013, "chapter_id": 20444, "verse_number": "२-११६-१४", "content_sanskrit": "नमस्कृत्य द्विजेंद्रं तं गतो मातलिना तदा ।\nस्वपुरं पितरं द्रष्टुं तथैव च स्वमातरम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000444014, "chapter_id": 20444, "verse_number": "२-११६-१५", "content_sanskrit": "सूत उवाच ।\nअप्सरा मेनिका नाम प्रेषिता दैवतैस्ततः ।\nआयोर्भार्या सुदुःखेन पतिता शोकसागरे॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000444015, "chapter_id": 20444, "verse_number": "२-११६-१६", "content_sanskrit": "तामुवाच महाभागां देवीमिंदुमतीं प्रति ।\nमुंच शोकं महाभागे तनयं पश्य सस्नुषम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000444016, "chapter_id": 20444, "verse_number": "२-११६-१७", "content_sanskrit": "निहत्य दानवं पापं तव पुत्रापहारकम् ।\nसमायांतं सभायां च वीरश्रियासमन्वितम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000444017, "chapter_id": 20444, "verse_number": "२-११६-१८", "content_sanskrit": "सुवृत्तं संगरे तस्य नहुषेण यथा कृतम् ।\nतस्यै निवेदयामास इंदुमत्यै च मेनिका॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000444018, "chapter_id": 20444, "verse_number": "२-११६-१९", "content_sanskrit": "मेनिकाया वचः श्रुत्वा हर्षेण महतान्विता ।\nसखि सत्यं ब्रवीषि त्वमित्युवाच सगद्गदम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000444019, "chapter_id": 20444, "verse_number": "२-११६-२०", "content_sanskrit": "सामृतं सुप्रियं प्रोक्तं मनःप्रोत्साहकारकम् ।\nजीवादिकं मया देयं त्वयि सर्वस्वमेव हि॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000444020, "chapter_id": 20444, "verse_number": "२-११६-२१", "content_sanskrit": "एवमाभाष्य तां देवी राजानमिदमब्रवीत् ।\nतव पुत्रो महाबाहुः समायातो हि सांप्रतम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000444021, "chapter_id": 20444, "verse_number": "२-११६-२२", "content_sanskrit": "आख्याति च महाराज एषा मे वै वराप्सराः ।\nभर्तारमेवमाभाष्य विरराम सुहर्षिता॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000444022, "chapter_id": 20444, "verse_number": "२-११६-२३", "content_sanskrit": "समाकर्ण्य नृपेंद्रस्तु तामुवाच प्रियां प्रति ।\nपुरा प्रोक्तं महाभागे मुनिना नारदेन हि॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000444023, "chapter_id": 20444, "verse_number": "२-११६-२४", "content_sanskrit": "पुत्रं प्रति न कर्तव्यं दुःखं राजंस्त्वया कदा ।\nतं निहत्य सुवीर्येण दानवं चैष्यते सुतः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000444024, "chapter_id": 20444, "verse_number": "२-११६-२५", "content_sanskrit": "संजातं सत्यमेवं वै मुनिना भाषितं पुरा ।\nअन्यथा वचनं तस्य कथं देवि भविष्यति॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000444025, "chapter_id": 20444, "verse_number": "२-११६-२६", "content_sanskrit": "दत्तात्रेयो मुनिश्रेष्ठः साक्षाद्देवो भविष्यति ।\nशुश्रूषितस्त्वया देवि मया च तपसा पुरा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000444026, "chapter_id": 20444, "verse_number": "२-११६-२७", "content_sanskrit": "पुत्ररत्नं तेन दत्तं वैष्णवांशप्रधारकम् ।\nसदा हनिष्यति परं दानवं पापचेतनम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000444027, "chapter_id": 20444, "verse_number": "२-११६-२८", "content_sanskrit": "सर्वदैत्यप्रहर्ता च प्रजापालो महाबलः ।\nदत्तात्रेयेण मे दत्तो वैष्णवांशः सुतोत्तमः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000444028, "chapter_id": 20444, "verse_number": "२-११६-२९", "content_sanskrit": "एवं संभाष्य तां देवीं राजा चेंदुमतीं तदा ।\nमहोत्सवं ततश्चक्रे पुत्रस्यागमनं प्रति॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000444029, "chapter_id": 20444, "verse_number": "२-११६-३०", "content_sanskrit": "हर्षेण महताविष्टो विष्णुं सस्मार वै पुनः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000444030, "chapter_id": 20444, "verse_number": "२-११६-३१", "content_sanskrit": "सर्वोपपन्नं सुरवर्गयुक्तमानंदरूपं परमार्थमेकम् ।\nक्लेशापहं सौख्यप्रदं नराणां सद्वैष्णवानामिह मोक्षदं परम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]