[{"id": 2092330, "chapter_id": 2965, "verse_number": "१३-९५-१", "content_sanskrit": "युधिष्ठिर उवाच।\nयौ च स्यातां चरणेनोपपन्नौ\nयौ विद्यया सदृशौ जन्मना च।\nताभ्यां दानं कतरस्मै विशिष्ट-\nमयाचमानाय च याचते च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092331, "chapter_id": 2965, "verse_number": "१३-९५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092332, "chapter_id": 2965, "verse_number": "१३-९५-२", "content_sanskrit": "श्रेयो वै याचतः पार्थ दानमाहुरयाचते।\nअर्हत्तमो वै धृतिमान्कृपणादकृतात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092333, "chapter_id": 2965, "verse_number": "१३-९५-३", "content_sanskrit": "क्षत्रियो रक्षणधृतिर्ब्राह्मणोऽनर्थनाधृतिः।\nब्राह्मणो धृतिमान्विद्वान्देवान्प्रीणाति तुष्टिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092334, "chapter_id": 2965, "verse_number": "१३-९५-४", "content_sanskrit": "याच्यमाहुरनीशस्य अतिहारं च भारत।\nउद्वेजयन्ति याचन्ति यदा भूतानि दस्युवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092335, "chapter_id": 2965, "verse_number": "१३-९५-५", "content_sanskrit": "म्रियते याचमानो वै तमनु म्रियतेऽददत्।\nददत्संजीवयत्येनमात्मानं च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092336, "chapter_id": 2965, "verse_number": "१३-९५-६", "content_sanskrit": "आनृशंस्यं परो धर्मो याचते यत्प्रदीयते।\nअयाचतः सीदमानान्सर्वोपायैर्निमन्त्रयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092337, "chapter_id": 2965, "verse_number": "१३-९५-७", "content_sanskrit": "यदि वै तादृशा राष्ट्रे वसेयुस्ते द्विजोत्तमाः।\nभस्मच्छन्नानिवाग्नींस्तान्बुध्येथास्त्वं प्रयत्नतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092338, "chapter_id": 2965, "verse_number": "१३-९५-८", "content_sanskrit": "तपसा दीप्यमानास्ते दहेयुः पृथिवीमपि।\nअपूज्यमानाः कौरव्य पूजार्हास्तु तथाविधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092339, "chapter_id": 2965, "verse_number": "१३-९५-९", "content_sanskrit": "पूज्या हि ज्ञानविज्ञानतपोयोगसमन्विताः।\nतेभ्यः पूजां प्रयुञ्जीथा ब्राह्मणेभ्यः परन्तपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092340, "chapter_id": 2965, "verse_number": "१३-९५-१०", "content_sanskrit": "ददद्बहुविधान्देयानुपच्छन्दयते च तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092341, "chapter_id": 2965, "verse_number": "१३-९५-११", "content_sanskrit": "यदग्निहोत्रे सुहुते सायंप्रातर्भवेत्फलम्।\nविद्यावेदव्रतवति तद्दानफलमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092342, "chapter_id": 2965, "verse_number": "१३-९५-१२", "content_sanskrit": "विद्यावेदव्रतस्नाता न व्यापाश्रयजीविनः।\nगूढस्वाध्यायतपसो ब्राह्मणान्संशितव्रतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092343, "chapter_id": 2965, "verse_number": "१३-९५-१३", "content_sanskrit": "कृतैरावसथैर्हृद्यैः सप्रेष्यैः सपरिच्छदैः।\nनिमन्त्रयेथाः कौरव्य कामैश्चान्यैर्द्विजोत्तमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092344, "chapter_id": 2965, "verse_number": "१३-९५-१४", "content_sanskrit": "अपि ते प्रतिगृह्णीयुः श्रद्धोपेतं युधिष्ठिर।\nकार्यमित्येव मन्वाना धर्मज्ञाः सूक्ष्मदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092345, "chapter_id": 2965, "verse_number": "१३-९५-१५", "content_sanskrit": "अपि ते ब्राह्मणा भुक्त्वा गताः सोद्धरणान्गृहान्।\nयेषां दाराः प्रतीक्षन्ते पर्जन्यमिव कर्षकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092346, "chapter_id": 2965, "verse_number": "१३-९५-१६", "content_sanskrit": "अन्नानि प्रातःसवने नियता ब्रह्मचारिणः।\nब्राह्मणास्तात भुञ्जानास्त्रेताग्निं प्रीणयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092347, "chapter_id": 2965, "verse_number": "१३-९५-१७", "content_sanskrit": "माध्यंदिनं ते सवनं ददतस्तात वर्तताम्।\nगोहिरण्यानि वासांसि तेनेन्द्रः प्रीयतां तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092348, "chapter_id": 2965, "verse_number": "१३-९५-१८", "content_sanskrit": "तृतीयं सवनं ते वै वैश्वदेवं युधिष्ठिर।\nयद्देवेभ्यः पितृभ्यश्च विप्रेभ्यश्च प्रयच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092349, "chapter_id": 2965, "verse_number": "१३-९५-१९", "content_sanskrit": "अहिंसा सर्वभूतेभ्यः संविभागश्च सर्वशः।\nदमस्त्यागो धृतिः सत्यं भवत्यवभृथाय ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092350, "chapter_id": 2965, "verse_number": "१३-९५-२०", "content_sanskrit": "एथ ते चिततो यज्ञः श्रद्धापूतः सदक्षिणः।\nविशिष्टः सर्वयज्ञानां नित्यं तात प्रवर्तताम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2092351, "chapter_id": 2965, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि पञ्चनवतितमोऽध्यायः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]