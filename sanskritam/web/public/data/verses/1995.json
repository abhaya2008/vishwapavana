[{"id": 2044429, "chapter_id": 1995, "verse_number": "६-४४-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2044430, "chapter_id": 1995, "verse_number": "६-४४-१", "content_sanskrit": "एवं व्यूढेष्वनीकेषु मामकेष्वितरेषु च।\nके पूर्वं प्राहरंस्तत्र कुरवःक पाण्डवा नु किम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2044431, "chapter_id": 1995, "verse_number": "६-४४-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2044432, "chapter_id": 1995, "verse_number": "६-४४-२", "content_sanskrit": "भ्रातृभिः सहितो राजन्पुत्रो दुःशासनस्तव।\nभीष्मं प्रमुखतः कृत्वा प्रययौ सह सेनया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2044433, "chapter_id": 1995, "verse_number": "६-४४-३", "content_sanskrit": "तथैव पाण्डवाः सर्वे भीमसेनपुरोगमाः ।\nभीष्मेण युद्धमिच्छन्तः प्रययुर्हृष्टमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2044434, "chapter_id": 1995, "verse_number": "६-४४-४", "content_sanskrit": "क्ष्वेडाः किलकिलाशब्दाः क्रकचा गोविषाणिकाः ।\nभेरीमृदङ्गमुरजा हयकुञ्जरनिःस्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2044435, "chapter_id": 1995, "verse_number": "६-४४-५", "content_sanskrit": "उभयोःक सेनयोर्ह्यासंस्ततस्तेऽस्मान्समाद्रवन्।\nवयं तान्प्रतिर्दन्तस्तदाऽऽसीत्तुमुलं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2044436, "chapter_id": 1995, "verse_number": "६-४४-६", "content_sanskrit": "महान्त्यनीकानि महासमुच्छ्रये\nसमागमे पाण्डवधार्तराष्ट्रयोः।\nचकम्पिरे शङ्खमृदङ्गनिःस्वनैः\nप्रकम्पितानीव वनानि वायुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2044437, "chapter_id": 1995, "verse_number": "६-४४-७", "content_sanskrit": "नरेन्द्र नागाश्वरताकुलाना-\nमभ्यागतानामशिवे मुहूर्ते।\nबभूव घोषस्तुमुलश्चमूनां\nवातोद्धुतानामिव सागराणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2044438, "chapter_id": 1995, "verse_number": "६-४४-८", "content_sanskrit": "तस्मिन्समुत्थिते शब्दे तुमुले रोमहर्षणे।\nभीमसेनो महाबाहुः प्राणदद्गोवृषो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2044439, "chapter_id": 1995, "verse_number": "६-४४-९", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषं वारणानां च बृंहितम्।\nसिंहनादं च सैन्यानां भीससेनरवोऽभ्यभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2044440, "chapter_id": 1995, "verse_number": "६-४४-१०", "content_sanskrit": "हयानां हेषमाणानामनीकेषु सहस्रशः ।\nसर्वानभ्यभवच्चब्दान्भीमस्य नदतः स्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2044441, "chapter_id": 1995, "verse_number": "६-४४-११", "content_sanskrit": "तं श्रुत्वा निनदं तस्य सैन्यास्तव वितत्रसुः ।\nजीमूतस्येव नदतः शक्राशनिसमस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2044442, "chapter_id": 1995, "verse_number": "६-४४-१२", "content_sanskrit": "वाहनानि च सर्वाणि शकृन्मूत्रं प्रमुस्रुवुः ।\nशब्देन तस्य वीरस्य सिंहस्येवेतरेक मृगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2044443, "chapter_id": 1995, "verse_number": "६-४४-१३", "content_sanskrit": "दर्शयन्घोरमात्मानं महाभ्रमिव नादयन्।\nविभीषयंस्तव सुतान्भीमसेनः समभ्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2044444, "chapter_id": 1995, "verse_number": "६-४४-१४", "content_sanskrit": "तमायान्तं महेष्वासं सोदर्याः पर्यवारयन् ।\nछादयन्तः शरव्रातैर्मेघा इव दिवाकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2044445, "chapter_id": 1995, "verse_number": "६-४४-१५", "content_sanskrit": "दुर्योधनश्च पुत्रस्ते दुर्मुखो दुःसहः शलः ।\nदुःशासनश्चातिरथस्तथा दुर्मर्षणो नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2044446, "chapter_id": 1995, "verse_number": "६-४४-१६", "content_sanskrit": "विविंशतिश्चित्रसेनो विकर्णश्च महारथः ।\nपुरुमित्रो जयो भोजः सौमदत्तिश्च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2044447, "chapter_id": 1995, "verse_number": "६-४४-१७", "content_sanskrit": "महाचापानि धुन्वन्तो मेघा इव सविद्युतः ।\nआददानाश्च नाराचान्निर्मुक्ताशीविषोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2044448, "chapter_id": 1995, "verse_number": "६-४४-१८", "content_sanskrit": "अथ ते द्रौपदीपुत्राः सौभद्रश्च महारथः ।\nनकुलः सहदेवश्च धृष्टद्युम्नश्च पार्षतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2044449, "chapter_id": 1995, "verse_number": "६-४४-१९", "content_sanskrit": "धार्तराष्ट्रान्प्रतिययुरर्दयन्तः शितैः शरैः ।\nवज्रैरिव महावेगैः शिखराणि धराभृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2044450, "chapter_id": 1995, "verse_number": "६-४४-२०", "content_sanskrit": "तस्मिन्प्रथमसंग्रामे भीमज्यातलनिःस्वने।\nतावकानां परेषां च नासीत्कश्चित्पराङ्मुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2044451, "chapter_id": 1995, "verse_number": "६-४४-२१", "content_sanskrit": "लाघवं द्रोणशिष्याणामपश्यं भरतर्षभ ।\nनिमित्तवेधिनां चैव शरानुत्सृजतां भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2044452, "chapter_id": 1995, "verse_number": "६-४४-२२", "content_sanskrit": "नोपशाम्यति निर्घोषो धनुषां कूजतां तथा।\nविनिश्चेरुः शरा दीप्ताज्योतींषीव नभस्तलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2044453, "chapter_id": 1995, "verse_number": "६-४४-२३", "content_sanskrit": "सर्वे त्वन्ये महीपालाः प्रेक्षका इव भारत।\nददृशुर्दर्शनीयं तं भीमं ज्ञातिसमागमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2044454, "chapter_id": 1995, "verse_number": "६-४४-२४", "content_sanskrit": "ततस्ते जातसंरम्भाः परस्परकृतागसः ।\nअन्योन्यस्पर्धया राजन्व्यायच्छन्त महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2044455, "chapter_id": 1995, "verse_number": "६-४४-२५", "content_sanskrit": "कुरुपाण्डवसेने ते हस्त्यश्वरथसंकुले ।\nशुशुभाते रणेऽतीव पटे चित्रार्पिते इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2044456, "chapter_id": 1995, "verse_number": "६-४४-२६", "content_sanskrit": "ततस्ते पार्थिवाः सर्वे प्रगृहीतशरासनाः ।\nसहसैन्याः समापेतुः पुत्रस्य तव शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2044457, "chapter_id": 1995, "verse_number": "६-४४-२७", "content_sanskrit": "युधिष्ठिरेण चदिष्टाः पार्थिवास्ते सहस्रशः ।\nविनदन्तः समापेतुः पुत्रस्य तव वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2044458, "chapter_id": 1995, "verse_number": "६-४४-२८", "content_sanskrit": "उभयोः सेनयोस्तीव्रः सैन्यानां स समागमः ।\nअन्तर्धीयत चादित्यः सैन्येन रजसा वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2044459, "chapter_id": 1995, "verse_number": "६-४४-२९", "content_sanskrit": "प्रयुद्धानां प्रभग्नानां पुनरावर्तिनामपि।\nनात्र स्वेषां परेषां वा विशेषः समदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2044460, "chapter_id": 1995, "verse_number": "६-४४-३०", "content_sanskrit": "तस्मिस्तु तुमुले युद्धे वर्तमाने महाभये।\nअति सर्वाण्यनीकानि पिता तेऽभिव्यरोचत ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2044461, "chapter_id": 1995, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि चतुश्चत्वारिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]