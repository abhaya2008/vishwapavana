[{"id": 5000315000, "chapter_id": 9315, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे त्रिचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000315001, "chapter_id": 9315, "verse_number": "४-४३-१", "content_sanskrit": "ततः संदिश्य सुग्रीवः श्वशुरं पश्चिमां दिशम्।\nवीरं शतबलिं नाम वानरं वानरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000315002, "chapter_id": 9315, "verse_number": "४-४३-२", "content_sanskrit": "उवाच राजा सर्वज्ञः सर्ववानरसत्तमः।\nवाक्यमात्महितं चैव रामस्य च हितं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000315003, "chapter_id": 9315, "verse_number": "४-४३-३", "content_sanskrit": "वृतः शतसहस्रेण त्वद्विधानां वनौकसाम्।\nवैवस्वतसुतैः सार्धं प्रविष्टः सर्वमन्त्रिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000315004, "chapter_id": 9315, "verse_number": "४-४३-४", "content_sanskrit": "दिशं ह्युदीचीं विक्रान्तां हिमशैलावतंसिकाम्।\nसर्वतः परिमार्गध्वं रामपत्नीं यशस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000315005, "chapter_id": 9315, "verse_number": "४-४३-५", "content_sanskrit": "अस्मिन् कार्ये विनिर्वृत्ते कृते दाशरथेः प्रिये।\nऋणान्मुक्ता भविष्यामः कृतार्थार्थविदां वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000315006, "chapter_id": 9315, "verse_number": "४-४३-६", "content_sanskrit": "कृतं हि प्रियमस्माकं राघवेण महात्मना।\nतस्य चेत्प्रतिकारोऽस्ति सफलं जीवितं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000315007, "chapter_id": 9315, "verse_number": "४-४३-७", "content_sanskrit": "अर्थिनः कार्यनिर्वृत्तिमकर्तुरपि यश्चरेत्।\nतस्य स्यात् सफलं जन्म किं पुनः पूर्वकारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000315008, "chapter_id": 9315, "verse_number": "४-४३-८", "content_sanskrit": "एतां बुद्धिं समास्थाय दृश्यते जानकी यथा।\nतथा भवद्भिः कर्तव्यमस्मत्प्रियहितैषिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000315009, "chapter_id": 9315, "verse_number": "४-४३-९", "content_sanskrit": "अयं हि सर्वभूतानां मान्यस्तु नरसत्तमः।\nअस्मासु च गतः प्रीतिं रामः परपुरंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000315010, "chapter_id": 9315, "verse_number": "४-४३-१०", "content_sanskrit": "इमानि बहुदुर्गाणि नद्यः शैलान्तराणि च।\nभवन्तः परिमार्गन्तु बुद्धिविक्रमसम्पदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000315011, "chapter_id": 9315, "verse_number": "४-४३-११", "content_sanskrit": "तत्र म्लेच्छान् पुलिन्दांश्च शूरसेनांस्तथैव च।\nप्रस्थलान् भरतांश्चैव कुरूंश्च सह मद्रकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000315012, "chapter_id": 9315, "verse_number": "४-४३-१२", "content_sanskrit": "काम्बोजयवनांश्चैव शकानां पत्तनानि च।\nअन्वीक्ष्य दरदांश्चैव हिमवन्तं विचिन्वथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000315013, "chapter_id": 9315, "verse_number": "४-४३-१३", "content_sanskrit": "लोध्रपद्मकषण्डेषु देवदारुवनेषु च।\nरावणः सह वैदेह्या मार्गितव्यस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000315014, "chapter_id": 9315, "verse_number": "४-४३-१४", "content_sanskrit": "ततः सोमाश्रमं गत्वा देवगन्धर्वसेवितम्।\nकालं नाम महासानुं पर्वतं तं गमिष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000315015, "chapter_id": 9315, "verse_number": "४-४३-१५", "content_sanskrit": "महत्सु तस्य शैलेषु पर्वतेषु गुहासु च।\nविचिन्वत महाभागां रामपत्नीमनिन्दिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000315016, "chapter_id": 9315, "verse_number": "४-४३-१६", "content_sanskrit": "तमतिक्रम्य शैलेन्द्रं हेमगर्भं महागिरिम्।\nततः सुदर्शनं नाम पर्वतं गन्तुमर्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000315017, "chapter_id": 9315, "verse_number": "४-४३-१७", "content_sanskrit": "ततो देवसखो नाम पर्वतः पतगालयः।\nनानापक्षिसमाकीर्णो विविधद्रुमभूषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000315018, "chapter_id": 9315, "verse_number": "४-४३-१८", "content_sanskrit": "तस्य काननषण्डेषु निर्झरेषु गुहासु च।\nरावणः सह वैदेह्या मार्गितव्यस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000315019, "chapter_id": 9315, "verse_number": "४-४३-१९", "content_sanskrit": "तमतिक्रम्य चाकाशं सर्वतः शतयोजनम्।\nअपर्वतनदीवृक्षं सर्वसत्त्वविवर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000315020, "chapter_id": 9315, "verse_number": "४-४३-२०", "content_sanskrit": "तत्तु शीघ्रमतिक्रम्य कान्तारं रोमहर्षणम्।\nकैलासं पाण्डुरं प्राप्य हृष्टा यूयं भविष्यथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000315021, "chapter_id": 9315, "verse_number": "४-४३-२१", "content_sanskrit": "तत्र पाण्डुरमेघाभं जाम्बूनदपरिष्कृतम्।\nकुबेरभवनं रम्यं निर्मितं विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000315022, "chapter_id": 9315, "verse_number": "४-४३-२२", "content_sanskrit": "विशाला नलिनी यत्र प्रभूतकमलोत्पला।\nहंसकारण्डवाकीर्णा अप्सरोगणसेविता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000315023, "chapter_id": 9315, "verse_number": "४-४३-२३", "content_sanskrit": "तत्र वैश्रवणो राजा सर्वलोकनमस्कृतः।\nधनदो रमते श्रीमान् गुह्यकैः सह यक्षराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000315024, "chapter_id": 9315, "verse_number": "४-४३-२४", "content_sanskrit": "तस्य चन्द्रनिकाशेषु पर्वतेषु गुहासु च।\nरावणः सह वैदेह्या मार्गितव्यस्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000315025, "chapter_id": 9315, "verse_number": "४-४३-२५", "content_sanskrit": "क्रौञ्चं तु गिरिमासाद्य बिलं तस्य सुदुर्गमम्।\nअप्रमत्तैः प्रवेष्टव्यं दुष्प्रवेशं हि तत् स्मृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000315026, "chapter_id": 9315, "verse_number": "४-४३-२६", "content_sanskrit": "वसन्ति हि महात्मानस्तत्र सूर्यसमप्रभाः।\nदेवैरभ्यर्थिताः सम्यग् देवरूपा महर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000315027, "chapter_id": 9315, "verse_number": "४-४३-२७", "content_sanskrit": "क्रौञ्चस्य तु गुहाश्चान्याः सानूनि शिखराणि च।\nनिर्दराश्च नितम्बाश्च विचेतव्यास्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000315028, "chapter_id": 9315, "verse_number": "४-४३-२८", "content_sanskrit": "अवृक्षं कामशैलं च मानसं विहगालयम्।\nन गतिस्तत्र भूतानां देवानां न च रक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000315029, "chapter_id": 9315, "verse_number": "४-४३-२९", "content_sanskrit": "स च सर्वैर्विचेतव्यः ससानुप्रस्थभूधरः।\nक्रौञ्चं गिरिमतिक्रम्य मैनाको नाम पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000315030, "chapter_id": 9315, "verse_number": "४-४३-३०", "content_sanskrit": "मयस्य भवनं तत्र दानवस्य स्वयंकृतम्।\nमैनाकस्तु विचेतव्यः ससानुप्रस्थकन्दरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000315031, "chapter_id": 9315, "verse_number": "४-४३-३१", "content_sanskrit": "स्त्रीणामश्वमुखीनां तु निकेतस्तत्र तत्र तु।\nतं देशं समतिक्रम्य आश्रमं सिद्धसेवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000315032, "chapter_id": 9315, "verse_number": "४-४३-३२", "content_sanskrit": "सिद्धा वैखानसा यत्र वालखिल्याश्च तापसाः।\nवन्दितव्यास्ततः सिद्धास्तपसा वीतकल्मषाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000315033, "chapter_id": 9315, "verse_number": "४-४३-३३", "content_sanskrit": "प्रष्टव्या चापि सीतायाः प्रवृत्तिर्विनयान्वितैः।\nहेमपुष्करसंछन्नं तत्र वैखानसं सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000315034, "chapter_id": 9315, "verse_number": "४-४३-३४", "content_sanskrit": "तरुणादित्यसंकाशैर्हंसैर्विचरितं शुभैः।\nऔपवाह्यः कुबेरस्य सार्वभौम इति स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000315035, "chapter_id": 9315, "verse_number": "४-४३-३५", "content_sanskrit": "गजः पर्येति तं देशं सदा सह करेणुभिः।\nतत् सरः समतिक्रम्य नष्टचन्द्रदिवाकरम्।\nअनक्षत्रगणं व्योम निष्पयोदमनादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000315036, "chapter_id": 9315, "verse_number": "४-४३-३६", "content_sanskrit": "गभस्तिभिरिवार्कस्य स तु देशः प्रकाश्यते।\nविश्राम्यद्भिस्तपःसिद्धैर्देवकल्पैः स्वयंप्रभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000315037, "chapter_id": 9315, "verse_number": "४-४३-३७", "content_sanskrit": "तं तु देशमतिक्रम्य शैलोदा नाम निम्नगा।\nउभयोस्तीरयोस्तस्याः कीचका नाम वेणवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000315038, "chapter_id": 9315, "verse_number": "४-४३-३८", "content_sanskrit": "ते नयन्ति परं तीरं सिद्धान् प्रत्यानयन्ति च।\nउत्तराः कुरवस्तत्र कृतपुण्यप्रतिश्रयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000315039, "chapter_id": 9315, "verse_number": "४-४३-३९", "content_sanskrit": "ततः काञ्चनपद्माभिः पद्मिनीभिः कृतोदकाः।\nनीलवैदूर्यपत्राढ्या नद्यस्तत्र सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000315040, "chapter_id": 9315, "verse_number": "४-४३-४०", "content_sanskrit": "रक्तोत्पलवनैश्चात्र मण्डिताश्च हिरण्मयैः।\nतरुणादित्यसंकाशा भान्ति तत्र जलाशयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000315041, "chapter_id": 9315, "verse_number": "४-४३-४१", "content_sanskrit": "महार्हमणिपत्रैश्च काञ्चनप्रभकेसरैः।\nनीलोत्पलवनैश्चित्रैः स देशः सर्वतो वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000315042, "chapter_id": 9315, "verse_number": "४-४३-४२", "content_sanskrit": "निस्तुलाभिश्च मुक्ताभिर्मणिभिश्च महाधनैः।\nउद‍्धूतपुलिनास्तत्र जातरूपैश्च निम्नगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000315043, "chapter_id": 9315, "verse_number": "४-४३-४३", "content_sanskrit": "सर्वरत्नमयैश्चित्रैरवगाढा नगोत्तमैः।\nजातरूपमयैश्चापि हुताशनसमप्रभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000315044, "chapter_id": 9315, "verse_number": "४-४३-४४", "content_sanskrit": "नित्यपुष्पफलास्तत्र नगाः पत्ररथाकुलाः।\nदिव्यगन्धरसस्पर्शाः सर्वकामान् स्रवन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000315045, "chapter_id": 9315, "verse_number": "४-४३-४५", "content_sanskrit": "नानाकाराणि वासांसि फलन्त्यन्ये नगोत्तमाः।\nमुक्तावैदूर्यचित्राणि भूषणानि तथैव च।\nस्त्रीणां यान्यनुरूपाणि पुरुषाणां तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000315046, "chapter_id": 9315, "verse_number": "४-४३-४६", "content_sanskrit": "सर्वर्तुसुखसेव्यानि फलन्त्यन्ये नगोत्तमाः।\nमहार्हमणिचित्राणि फलन्त्यन्ये नगोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000315047, "chapter_id": 9315, "verse_number": "४-४३-४७", "content_sanskrit": "शयनानि प्रसूयन्ते चित्रास्तरणवन्ति च।\nमनःकान्तानि माल्यानि फलन्त्यत्रापरे द्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000315048, "chapter_id": 9315, "verse_number": "४-४३-४८", "content_sanskrit": "पानानि च महार्हाणि भक्ष्याणि विविधानि च।\nस्त्रियश्च गुणसम्पन्ना रूपयौवनलक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000315049, "chapter_id": 9315, "verse_number": "४-४३-४९", "content_sanskrit": "गन्धर्वाः किन्नराः सिद्धा नागा विद्याधरास्तथा।\nरमन्ते सततं तत्र नारीभिर्भास्वरप्रभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000315050, "chapter_id": 9315, "verse_number": "४-४३-५०", "content_sanskrit": "सर्वे सुकृतकर्माणः सर्वे रतिपरायणाः।\nसर्वे कामार्थसहिता वसन्ति सह योषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000315051, "chapter_id": 9315, "verse_number": "४-४३-५१", "content_sanskrit": "गीतवादित्रनिर्घोषः सोत्कृष्टहसितस्वनः।\nश्रूयते सततं तत्र सर्वभूतमनोरमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000315052, "chapter_id": 9315, "verse_number": "४-४३-५२", "content_sanskrit": "तत्र नामुदितः कश्चिन्नात्र कश्चिदसत्प्रियः।\nअहन्यहनि वर्धन्ते गुणास्तत्र मनोरमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000315053, "chapter_id": 9315, "verse_number": "४-४३-५३", "content_sanskrit": "समतिक्रम्य तं देशमुत्तरः पयसां निधिः।\nतत्र सोमगिरिर्नाम मध्ये हेममयो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000315054, "chapter_id": 9315, "verse_number": "४-४३-५४", "content_sanskrit": "इन्द्रलोकगता ये च ब्रह्मलोकगताश्च ये।\nदेवास्तं समवेक्षन्ते गिरिराजं दिवं गताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000315055, "chapter_id": 9315, "verse_number": "४-४३-५५", "content_sanskrit": "स तु देशो विसूर्योऽपि तस्य भासा प्रकाशते।\nसूर्यलक्ष्म्याभिविज्ञेयस्तपतेव विवस्वता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000315056, "chapter_id": 9315, "verse_number": "४-४३-५६", "content_sanskrit": "भगवांस्तत्र विश्वात्मा शम्भुरेकादशात्मकः।\nब्रह्मा वसति देवेशो ब्रह्मर्षिपरिवारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000315057, "chapter_id": 9315, "verse_number": "४-४३-५७", "content_sanskrit": "न कथंचन गन्तव्यं कुरूणामुत्तरेण वः।\nअन्येषामपि भूतानां नानुक्रामति वै गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000315058, "chapter_id": 9315, "verse_number": "४-४३-५८", "content_sanskrit": "स हि सोमगिरिर्नाम देवानामपि दुर्गमः।\nतमालोक्य ततः क्षिप्रमुपावर्तितुमर्हथ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000315059, "chapter_id": 9315, "verse_number": "४-४३-५९", "content_sanskrit": "एतावद् वानरैः शक्यं गन्तुं वानरपुंगवाः।\nअभास्करममर्यादं न जानीमस्ततः परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000315060, "chapter_id": 9315, "verse_number": "४-४३-६०", "content_sanskrit": "सर्वमेतद् विचेतव्यं यन्मया परिकीर्तितम्।\nयदन्यदपि नोक्तं च तत्रापि क्रियतां मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000315061, "chapter_id": 9315, "verse_number": "४-४३-६१", "content_sanskrit": "ततः कृतं दाशरथेर्महत्प्रियं\nमहत्प्रियं चापि ततो मम प्रियम्।\nकृतं भविष्यत्यनिलानलोपमा\nविदेहजादर्शनजेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000315062, "chapter_id": 9315, "verse_number": "४-४३-६२", "content_sanskrit": "ततः कृतार्थाः सहिताः सबान्धवा\nमयार्चिताः सर्वगुणैर्मनोरमैः।\nचरिष्यथोर्वीं प्रति शान्तशत्रवः\nसहप्रिया भूतधराः प्लवंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000315063, "chapter_id": 9315, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे त्रिचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]