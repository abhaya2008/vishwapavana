[{"id": 5000034000, "chapter_id": 9034, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे चतुस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000034001, "chapter_id": 9034, "verse_number": "१-३४-१", "content_sanskrit": "कृतोद्वाहे गते तस्मिन् ब्रह्मदत्ते च राघव ।\nअपुत्रः पुत्रलाभाय पौत्रीमिष्टिमकल्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000034002, "chapter_id": 9034, "verse_number": "१-३४-२", "content_sanskrit": "इष्ट्यां तु वर्तमानायां कुशनाभं महीपतिम् ।\nउवाच परमोदारः कुशो ब्रह्मसुतस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000034003, "chapter_id": 9034, "verse_number": "१-३४-३", "content_sanskrit": "पुत्रस्ते सदृशः पुत्र भविष्यति सुधार्मिकः ।\nगाधिं प्राप्स्यसि तेन त्वं कीर्तिं लोके च शाश्वतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000034004, "chapter_id": 9034, "verse_number": "१-३४-४", "content_sanskrit": "एवमुक्त्वा कुशो राम कुशनाभं महीपतिम् ।\nजगामाकाशमाविश्य ब्रह्मलोकं सनातनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000034005, "chapter_id": 9034, "verse_number": "१-३४-५", "content_sanskrit": "कस्यचित् त्वथ कालस्य कुशनाभस्य धीमतः ।\nजज्ञे परमधर्मिष्ठो गाधिरित्येव नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000034006, "chapter_id": 9034, "verse_number": "१-३४-६", "content_sanskrit": "स पिता मम काकुत्स्थ गाधिः परमधार्मिकः ।\nकुशवंशप्रसूतोऽस्मि कौशिको रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000034007, "chapter_id": 9034, "verse_number": "१-३४-७", "content_sanskrit": "पूर्वजा भगिनी चापि मम राघव सुव्रता ।\nनाम्ना सत्यवती नाम ऋचीके प्रतिपादिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000034008, "chapter_id": 9034, "verse_number": "१-३४-८", "content_sanskrit": "सशरीरा गता स्वर्गं भर्तारमनुवर्तिनी ।\nकौशिकी परमोदारा सा प्रवृत्ता महानदी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000034009, "chapter_id": 9034, "verse_number": "१-३४-९", "content_sanskrit": "दिव्या पुण्योदका रम्या हिमवन्तमुपाश्रिता\nलोकस्य हितकार्यार्थं प्रवृत्ता भगिनी मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000034010, "chapter_id": 9034, "verse_number": "१-३४-१०", "content_sanskrit": "ततोऽहं हिमवत्पार्श्वे वसामि नियतः सुखम्\nभगिन्यां स्नेहसंयुक्तः कौशिक्यां रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000034011, "chapter_id": 9034, "verse_number": "१-३४-११", "content_sanskrit": "सा तु सत्यवती पुण्या सत्ये धर्मे प्रतिष्ठिता\nपतिव्रता महाभागा कौशिकी सरितां वरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000034012, "chapter_id": 9034, "verse_number": "१-३४-१२", "content_sanskrit": "अहं हि नियमाद्राम हित्वा तां समुपागतः\nसिद्धाश्रममनुप्राप्तः सिद्धोऽस्मि तव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000034013, "chapter_id": 9034, "verse_number": "१-३४-१३", "content_sanskrit": "एषा राम ममोत्पत्तिः स्वस्य वंशस्य कीर्तिता\nदेशस्य च महाबाहो यन्मां त्वं परिपृच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000034014, "chapter_id": 9034, "verse_number": "१-३४-१४", "content_sanskrit": "गतोऽर्धरात्रः काकुत्स्थ कथाः कथयतो मम ।\nनिद्रामभ्येहि भद्रं ते मा भूद् विघ्नोऽध्वनीह नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000034015, "chapter_id": 9034, "verse_number": "१-३४-१५", "content_sanskrit": "निष्पन्दास्तरवः सर्वे निलीना मृगपक्षिणः ।\nनैशेन तमसा व्याप्ता दिशश्च रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000034016, "chapter_id": 9034, "verse_number": "१-३४-१६", "content_sanskrit": "शनैर्विसृज्यते संध्या नभो नेत्रैरिवावृतम् ।\nनक्षत्रतारागहनं ज्योतिर्भिरवभासते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000034017, "chapter_id": 9034, "verse_number": "१-३४-१७", "content_sanskrit": "१-३४-१६॥\nउत्तिष्ठते च शीतांशुः शशी लोकतमोनुदः ।\nह्लादयन् प्राणिनां लोके मनांसि प्रभया स्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000034018, "chapter_id": 9034, "verse_number": "१-३४-१८", "content_sanskrit": "नैशानि सर्वभूतानि प्रचरन्ति ततस्ततः ।\nयक्षराक्षससंघाश्च रौद्राश्च पिशिताशनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000034019, "chapter_id": 9034, "verse_number": "१-३४-१९", "content_sanskrit": "एवमुक्त्वा महातेजा विरराम महामुनिः ।\nसाधुसाध्विति तं सर्वे मुनयो ह्यभ्यपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000034020, "chapter_id": 9034, "verse_number": "१-३४-२०", "content_sanskrit": "कुशिकानामयं वंशो महान् धर्मपरः सदा ।\nब्रह्मोपमा महात्मानः कुशवंश्या नरोत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000034021, "chapter_id": 9034, "verse_number": "१-३४-२१", "content_sanskrit": "विशेषेण भवानेव विश्वामित्र महायशः ।\nकौशिकी सरितां श्रेष्ठा कुलोद्योतकरी तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000034022, "chapter_id": 9034, "verse_number": "१-३४-२२", "content_sanskrit": "मुदितैर्मुनिशार्दूलैः प्रशस्तः कुशिकात्मजः ।\nनिद्रामुपागमच्छ्रीमानस्तंगत इवांशुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000034023, "chapter_id": 9034, "verse_number": "१-३४-२३", "content_sanskrit": "रामोऽपि सहसौमित्रिः किञ्चिदागतविस्मयः ।\nप्रशस्य मुनिशार्दूलं निद्रां समुपसेवते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000034024, "chapter_id": 9034, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे चतुस्त्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]