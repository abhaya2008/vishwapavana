[{"id": 2029632, "chapter_id": 1646, "verse_number": "३-२८४-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029633, "chapter_id": 1646, "verse_number": "३-२८४-१", "content_sanskrit": "ततस्तत्रैवरामस्य समासीनस्य तैः सह।\nसमाजग्मुः कपिश्रेष्ठाः सुग्रीववचनात्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029634, "chapter_id": 1646, "verse_number": "३-२८४-२", "content_sanskrit": "वृतः कोटिसहस्रेण वानराणां तरस्विनाम्।\nश्वशुरो वालिनः श्रीमान्सुषेणो राममभ्ययात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029635, "chapter_id": 1646, "verse_number": "३-२८४-३", "content_sanskrit": "कोटीशतवृतोवाऽपिगजो गवय एव च।\nवानरेन्रौ महावीर्यौ पृथक्पृथगदृश्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029636, "chapter_id": 1646, "verse_number": "३-२८४-४", "content_sanskrit": "षष्टिकोटिसहस्राणि प्रकर्षन्प्रत्यदृश्यत।\nगोलाङ्गूलो महाराज गवाक्षो भीमदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029637, "chapter_id": 1646, "verse_number": "३-२८४-५", "content_sanskrit": "गन्धमादनवासी तु प्रथितो गन्धमादनः।\nकोटीशतसहस्राणि हरीणां समकर्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029638, "chapter_id": 1646, "verse_number": "३-२८४-६", "content_sanskrit": "पनसो नाम मेधावी वानरःसुमहाबलः।\nकोटीर्दश द्वादश च त्रिंशत्पञ्च प्रकर्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029639, "chapter_id": 1646, "verse_number": "३-२८४-७", "content_sanskrit": "श्रीमान्दधिमुखो नाम हरिवृद्धोऽतिवीर्यवान्।\nप्रचकर्ष महासैनयं हरीणां भीमतेजसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029640, "chapter_id": 1646, "verse_number": "३-२८४-८", "content_sanskrit": "कृषणानां मुखपुण्ड्राणामृक्षाणां भीमकर्मणाम्।\nकोटीर्दश द्वादश च त्रिंशत्पञ्च प्रकर्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029641, "chapter_id": 1646, "verse_number": "३-२८४-९", "content_sanskrit": "एते चान्ये च बहवो हरियूथपयूथपाः।\nअसङ्ख्येया महाराज समीयू रामकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029642, "chapter_id": 1646, "verse_number": "३-२८४-१०", "content_sanskrit": "गिरिकूटनिभाङ्गानां सिंहानामिव गर्जताम्।\nश्रूयते तुमुलः शब्दस्तत्रतत्रप्रधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029643, "chapter_id": 1646, "verse_number": "३-२८४-११", "content_sanskrit": "गिरिकूटनिभाः क्नचित्केचिन्महिषसन्निभाः।\nशरदभ्रप्रतीकाशाः केचिद्धिङ्गुलकाननाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029644, "chapter_id": 1646, "verse_number": "३-२८४-१२", "content_sanskrit": "उत्पतन्तः पतन्तश्च प्लवमानाश्च वानराः।\nउद्धुन्वन्तोऽपरे रेणून्समाजग्मुः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029645, "chapter_id": 1646, "verse_number": "३-२८४-१३", "content_sanskrit": "सवानरमहासैन्यः पूर्णसागरसन्निभः।\nनिवेशमकरोत्तत्रसुग्रीवानुमते तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029646, "chapter_id": 1646, "verse_number": "३-२८४-१४", "content_sanskrit": "ततस्तेषु हरीन्द्रेषु समावृत्तेषु सर्वशः।\nतिथौ प्रशस्ते नक्षत्रे मुहूर्ते चाभिपूजिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029647, "chapter_id": 1646, "verse_number": "३-२८४-१५", "content_sanskrit": "तेन व्यूढेन सैन्येन लोकानुद्वर्तयन्निव।\nप्रययौ राघवः श्रीमान्सुग्रीवसहितस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029648, "chapter_id": 1646, "verse_number": "३-२८४-१६", "content_sanskrit": "मुखमासीत्तु सैन्यस्य हनूमान्मारुतात्मजः।\nजघनं पालयामास सौमित्रिरकुतोभयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029649, "chapter_id": 1646, "verse_number": "३-२८४-१७", "content_sanskrit": "बद्धगोधाङ्गुलित्रणौ राघवौ तत्रजग्मतुः।\nवृतौ हरिमहामात्रैश्चन्द्रसूर्यौ ग्रहैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029650, "chapter_id": 1646, "verse_number": "३-२८४-१८", "content_sanskrit": "प्रबभौ हरिसैन्यं तत्सालतालशिलायुधम्।\nसुमहच्छालिभवनं यथा सूर्योदयं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029651, "chapter_id": 1646, "verse_number": "३-२८४-१९", "content_sanskrit": "नलनीलाङ्गदक्राथमैन्दद्विविदपालिता।\nययौ सुमहती सेना राघवस्यार्थसिद्धये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029652, "chapter_id": 1646, "verse_number": "३-२८४-२०", "content_sanskrit": "विविधेषु प्रशस्तेषु बहुमूलफलेषु च।\nप्रभूतमधुमांसेषु वारिमत्सु विवेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029653, "chapter_id": 1646, "verse_number": "३-२८४-२१", "content_sanskrit": "निवसन्ती निराबाधा तथैवगिरिसानुषु।\nउपायाद्धिरिसेना सा क्षारोदमथ मागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029654, "chapter_id": 1646, "verse_number": "३-२८४-२२", "content_sanskrit": "द्वितीयसागरनिमं तद्बलंबहुलध्वजम्।\nवेलावनं समासाद् निवासमकरोत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029655, "chapter_id": 1646, "verse_number": "३-२८४-२३", "content_sanskrit": "ततो दाशरथिः श्रीमान्सुग्रीवं प्रत्यभाषत।\nमध्ये वानरमुख्यानां प्राप्तकालमिदं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029656, "chapter_id": 1646, "verse_number": "३-२८४-२४", "content_sanskrit": "उपायः कोनु भवतां मतः सागरलङ्घने।\nइयं हि महती सेना सागरश्चातिदुस्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029657, "chapter_id": 1646, "verse_number": "३-२८४-२५", "content_sanskrit": "तत्रान्ये व्याहरन्ति स्म वानराः पटुमानिनः।\nसमर्था लङ्घने सिन्दोर्न तत्कृत्स्नस्य वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029658, "chapter_id": 1646, "verse_number": "३-२८४-२६", "content_sanskrit": "केचिन्नौभिर्व्यवस्यन्ति केचिच्च विविधैः प्लवैः।\nनेति रामस्तु तानसर्वान्सान्त्वयन्प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029659, "chapter_id": 1646, "verse_number": "३-२८४-२७", "content_sanskrit": "शतयोजनविस्तारं न शक्ताः सर्ववानराः।\nक्रान्तुं तोयनिधिं वीरानैषा वो नैष्ठिकी मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029660, "chapter_id": 1646, "verse_number": "३-२८४-२८", "content_sanskrit": "नावो न सन्ति सेनाया बह्व्यस्तारयितुं तथा।\nवणिजामुपघातं च कथमस्मद्विधश्चरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029661, "chapter_id": 1646, "verse_number": "३-२८४-२९", "content_sanskrit": "विस्तीर्णं चैव नः सैन्यं हन्याच्छिद्रेण वै परः।\nप्लवोडुपप्रतारश्चनैवात्रमम रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029662, "chapter_id": 1646, "verse_number": "३-२८४-३०", "content_sanskrit": "अहं त्विमं जलनिधिं समारप्स्याम्युपायतः।\nप्रतिशेष्याम्युपवसन्दर्शयिष्ति मां ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2029663, "chapter_id": 1646, "verse_number": "३-२८४-३१", "content_sanskrit": "न चेद्दर्शयिता मार्गं धक्ष्याम्यनमहं ततः।\nमहास्त्रैरप्रतिहतैरत्यग्निपवनोज्ज्वलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2029664, "chapter_id": 1646, "verse_number": "३-२८४-३२", "content_sanskrit": "इत्युक्त्वा सहसौमित्रिरुपस्पृश्याथ राघवः।\nप्रतिशिस्ये जलनिधं विधिवत्कुशसंस्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2029665, "chapter_id": 1646, "verse_number": "३-२८४-३३", "content_sanskrit": "सागरस्तु ततः स्वप्ने दर्शयामास राघवम्।\nदेवो नदनदीमर्ता श्रीमान्यादोगणैर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2029666, "chapter_id": 1646, "verse_number": "३-२८४-३४", "content_sanskrit": "कौसल्यामातरित्येवमाभाष्य मधुरं वचः।\nइदमित्याह रत्नानामाकरैः शतशो वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2029667, "chapter_id": 1646, "verse_number": "३-२८४-३५", "content_sanskrit": "ब्रूहि किं तेकरोम्यत्रसाहाय्यं पुरुषर्षभ।\nऐक्ष्वाको ह्यस्मि ते ज्ञाती राम सत्यपराक्रमः।\nएवमुक्तः समुद्रेण रामो वाक्यमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2029668, "chapter_id": 1646, "verse_number": "३-२८४-३६", "content_sanskrit": "मार्गमिच्छामि सैन्यस्य दत्तं नदनदीपते।\nयेन गत्वादशग्रीवं हन्याम कुलपांसनम्।\n`राक्षसंसानुबन्धं तं मम भार्यापहारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2029669, "chapter_id": 1646, "verse_number": "३-२८४-३७", "content_sanskrit": "यद्येवं याचतो मार्गं न प्रदास्यति मे भवान्।\nशरैस्त्वां शोषयिष्यामि दिव्यास्त्रयतिमन्त्रितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2029670, "chapter_id": 1646, "verse_number": "३-२८४-३८", "content_sanskrit": "इत्येवंब्रुवतः श्रुत्वारामस्य वरुणालयः।\nउवाचव्यथितोवाक्यमितिबद्धाञ्जलिःस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2029671, "chapter_id": 1646, "verse_number": "३-२८४-३९", "content_sanskrit": "नेच्छामि प्रतिघातं ते नास्मि विघ्नकरस्तव।\nशृणु चेदं वचोराम श्रुत्वा कर्तव्यमाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2029672, "chapter_id": 1646, "verse_number": "३-२८४-४०", "content_sanskrit": "यदि दास्यामि ते मार्गं सैन्यस् व्रजतोऽऽज्ञया।\nअन्येऽप्याज्ञापयिष्यन्ति मामेवं धनुषोबलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2029673, "chapter_id": 1646, "verse_number": "३-२८४-४१", "content_sanskrit": "अस्तित्वत्रनलो नाम वानरः शिल्पिसंमतः।\nत्वष्टुः काकुत्स्थ तनयो बलवान्विश्वकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2029674, "chapter_id": 1646, "verse_number": "३-२८४-४२", "content_sanskrit": "स यत्काष्ठं तृणं वाऽपिशिलां वा क्षेप्स्यते मयि।\nसर्वं तद्धारयिष्यामि स ते सेतुर्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2029675, "chapter_id": 1646, "verse_number": "३-२८४-४३", "content_sanskrit": "इत्युक्त्वाऽन्तर्हिते तस्मिन्रामो नलमुवाच ह।\nकुरु सेतुं समुद्रे त्वंशक्तो ह्यसि मतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2029676, "chapter_id": 1646, "verse_number": "३-२८४-४४", "content_sanskrit": "तेनोपायेन काकुत्स्थः सतुबन्धमकारयत्।\nदशयोजनविस्तारमायतं शतयोजनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2029677, "chapter_id": 1646, "verse_number": "३-२८४-४५", "content_sanskrit": "नलसेतुरिति ख्यातो योऽद्यापि प्रथितो भुवि।\nरामस्याज्ञां पुरस्कृत्य धार्यते गिरिसंनिभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2029678, "chapter_id": 1646, "verse_number": "३-२८४-४६", "content_sanskrit": "तत्रस्थं स तु धर्मात्मा समागच्चद्विभीषणः।\nभ्राता वै राक्षसेन्द्रस्य चतुर्भिः सचिवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2029679, "chapter_id": 1646, "verse_number": "३-२८४-४७", "content_sanskrit": "प्रतिजग्राह रामस्तं स्वागतेन महामनाः।\nसुग्रीवस्य तु शङ्काऽभूत्प्रणिधिः स्यादिति स्मह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2029680, "chapter_id": 1646, "verse_number": "३-२८४-४८", "content_sanskrit": "राघवः सत्यचेष्टाभिः सम्यक्व चरितेङ्गितैः।\nयदा तत्त्वेन तुष्टोऽभूत्तत एनमपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2029681, "chapter_id": 1646, "verse_number": "३-२८४-४९", "content_sanskrit": "सर्वराक्षसराज्येचाप्यभ्यपिञ्चद्विभीषणम्।\nचक्रे च मन्त्रसचिवं सहृदंलक्ष्मणस् च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2029682, "chapter_id": 1646, "verse_number": "३-२८४-५०", "content_sanskrit": "विभीषणमते चैव सोऽत्यक्रामन्महार्णवम्।\nससैन्यः सेतुना तेन मार्गेणैव नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2029683, "chapter_id": 1646, "verse_number": "३-२८४-५१", "content_sanskrit": "ततो गत्वासमासाद्य लङ्कोद्यानान्यनेकशः।\nभेदयामास कपिभिर्महान्ति च बहूनि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2029684, "chapter_id": 1646, "verse_number": "३-२८४-५२", "content_sanskrit": "तत्रास्तां रावणामात्यौ राक्षसौ शुकसारणौ।\nचरौ वानररूपेण तौ जग्राह विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2029685, "chapter_id": 1646, "verse_number": "३-२८४-५३", "content_sanskrit": "प्रतिपन्नौ यदा रूपं राक्षसं तौ निशाचरौ।\nदर्शयित्वा ततः सैन्यं रामः पश्चादवासृजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2029686, "chapter_id": 1646, "verse_number": "३-२८४-५४", "content_sanskrit": "निवेश्योपवने सैन्यं स शूरः प्राज्यवानरम्।\nप्रेषयामास दुत्येन रावणस्य ततोऽङ्गदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2029687, "chapter_id": 1646, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि चतुरशीत्यधिकद्विशततमोऽध्यायः ॥ २८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]