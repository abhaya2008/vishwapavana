[{"id": 2201234, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2201235, "chapter_id": 5287, "verse_number": "१", "content_sanskrit": "अत्रैवोदाहरन्तीममितिहासं पुरातनम् ।\nयद् वृत्तं तीर्थयात्रायां शपथं प्रति तच्छृणु\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2201236, "chapter_id": 5287, "verse_number": "२", "content_sanskrit": "पुष्करार्थं कृतं स्तैन्यं पुरा भरतसत्तम ।\nराजर्षिभिर्महाराज तथैव च द्विजर्षिभिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2201237, "chapter_id": 5287, "verse_number": "३", "content_sanskrit": "ऋषयः समेताः पश्चिमे वै प्रभासे\nसमागता मन्त्रममन्त्रयन्त ।\nचराम सर्वे पृथिवीं पुण्यतीर्थां\nतन्नः कार्यं हन्त गच्छाम सर्वे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2201238, "chapter_id": 5287, "verse_number": "४", "content_sanskrit": "शुक्रोऽङ्गिराश्चैव कविश्च विद्वां-\nस्तथाऽगस्त्यो नारदपर्वतौ च ।\nभृगुर्वसिष्ठः कश्यपो गौतमश्च\nविश्वामित्रो जमदग्निश्च राजन् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2201239, "chapter_id": 5287, "verse_number": "५", "content_sanskrit": "ऋषिस्तथा गालवोऽथाष्टकश्च\nभरद्वाजोऽरुन्धती वालखिल्याः ।\nशिबिर्दिलीपो नहुषोऽम्बरीषो\nराजा ययातिर्धुन्धुमारोऽथ पूरुः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2201240, "chapter_id": 5287, "verse_number": "६", "content_sanskrit": "जग्मुः पुरस्कृत्य महानुभावं\nशतक्रतुं वृत्रहणं नरेन्द्र ।\nतीर्थानि सर्वाणि परिक्रमन्तो\nमाघ्यां ययुः कौशिकीं पुण्यतीर्थाम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2201241, "chapter_id": 5287, "verse_number": "७", "content_sanskrit": "सर्वेषु तीर्थेष्वथ धूतपापा\nजग्मुस्ततो ब्रह्मसरः सुपुण्यम् ।\nदेवस्य तीर्थे जलमग्निकल्पा\nविगाह्य ते भुक्तबिसप्रसूनाः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2201242, "chapter_id": 5287, "verse_number": "८", "content_sanskrit": "केचिद् बिसान्यखनंस्तत्र राजन्\nअन्ये मृणालान्यखनंस्तत्र विप्राः ।\nअथापश्यन् पुष्करं ते ह्रियन्तं\nह्रदादगस्त्येन समुद्धृतं वै \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2201243, "chapter_id": 5287, "verse_number": "९", "content_sanskrit": "तानाह सर्वानृषिमुख्यानगस्त्यः\nकेनादत्तं पुष्करं मे सुजातम् ।\nयुष्मान् शङ्के दीयतां पुष्करं मे\nन वै भवन्तो हर्तुमर्हन्ति पद्मम् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2201244, "chapter_id": 5287, "verse_number": "१०", "content_sanskrit": "शृणोमि कालो हिंसते धर्मवीर्यं\nसेयं प्राप्ता वर्धते धर्मपीडा ।\nपुराऽधर्मो वर्धते नेह यावत्\nतावद् गच्छामि परलोकं चिराय \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2201245, "chapter_id": 5287, "verse_number": "११", "content_sanskrit": "पुरा वेदान् ब्राह्मणा ग्राममध्ये\nघुष्टस्वरा वृषलान् श्रावयन्ति ।\nपुरा राजा व्यवहारानधर्म्यान्\nपश्यत्यहं परलोकं व्रजामि \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2201246, "chapter_id": 5287, "verse_number": "१२", "content_sanskrit": "पुरा वरान् प्रत्यवरा गरीयसो\nयावन्नरा नावमंस्यन्ति सर्वे ।\nतमोत्तरं यावदिदं न वर्तते\nतावद् व्रजामि परलोकं चिराय \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2201247, "chapter_id": 5287, "verse_number": "१३", "content_sanskrit": "पुरा प्रपश्यामि परेण मर्त्यान्\nबलीयसा दुर्बलान् भुज्यमानान् ।\nतस्माद् यास्यामि परलोकं चिराय\nन ह्युत्सहे द्रष्टुमीदृङ् नृलोके \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2201248, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2201249, "chapter_id": 5287, "verse_number": "१४", "content_sanskrit": "तमाहुरार्ता ऋषयो महर्षिं\nन ते वयं पुष्करं चोरयामः ।\nमिथ्याभिषङ्गो भवता न कार्यः\nशपाम तीक्ष्णान् शपथान् महर्षे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2201250, "chapter_id": 5287, "verse_number": "१५", "content_sanskrit": "ते निश्चितास्तत्र महर्षयस्तु\nसम्मन्यन्तो धर्ममेवं नरेन्द्र ।\nततोऽशपन् शपथान् पर्ययेण\nसहैव ते पार्थिव पुत्रपौत्रैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2201251, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "भृगुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2201252, "chapter_id": 5287, "verse_number": "१६", "content_sanskrit": "प्रत्याक्रोशेदिहाक्रुष्टस्ताडितः प्रतिताडयेत् ।\nखादेच्च पृष्ठमांसानि यस्ते हरति पुष्करम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2201253, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2201254, "chapter_id": 5287, "verse_number": "१७", "content_sanskrit": "अस्वाध्यायपरो लोके श्वानं च परिकर्षतु ।\nपुरे च भिक्षुर्भवतु यस्ते हरति पुष्करम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2201255, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "कश्यपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2201256, "chapter_id": 5287, "verse_number": "१८", "content_sanskrit": "सर्वत्र सर्वं पणतु न्यासे लोभं करोतु च ।\nकूटसाक्षित्वमभ्येतु यस्ते हरति पुष्करम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2201257, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2201258, "chapter_id": 5287, "verse_number": "१९", "content_sanskrit": "जीवत्वहङ्कृतो बुद्ध्या विपणत्वधमेन सः ।\nकर्षको मत्सरी चास्तु यस्ते हरति पुष्करम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2201259, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "अङ्गिराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2201260, "chapter_id": 5287, "verse_number": "२०", "content_sanskrit": "अशुचिर्ब्रह्मकूटोऽस्तु श्वानं च परिकर्षतु ।\nब्रह्महानिकृतिश्चास्तु यस्ते हरति पुष्करम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2201261, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "धुन्धुमारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2201262, "chapter_id": 5287, "verse_number": "२१", "content_sanskrit": "अकृतज्ञोऽस्तु मित्राणां शूद्रायां तु प्रजायतु ।\nएकः सम्पन्नमश्नातु यस्ते हरति पुष्करम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2201263, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "पूरुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2201264, "chapter_id": 5287, "verse_number": "२२", "content_sanskrit": "चिकित्सायां प्रचरतु भार्यया चैव पुष्यतु ।\nश्वशुरात् तस्य वृत्तिः स्याद् यस्ते हरति पुष्करम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2201265, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "दिलीपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2201266, "chapter_id": 5287, "verse_number": "२३", "content_sanskrit": "उदपानप्लवे ग्रामे ब्राह्मणो वृषलीपतिः ।\nतस्य लोकान् स व्रजतु यस्ते हरति पुष्करम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2201267, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "शुक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2201268, "chapter_id": 5287, "verse_number": "२४", "content_sanskrit": "पृष्ठमांसं समश्नातु दिवा गच्छतु मैथुनम् ।\nप्रेष्यो भवतु राज्ञश्च यस्ते हरति पुष्करम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2201269, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "जमदग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2201270, "chapter_id": 5287, "verse_number": "२५", "content_sanskrit": "अनध्यायेष्वधीयीत मित्रं श्राद्धे च भोजयेत् ।\nश्राद्धे शूद्रस्य चाश्नीयाद् यस्ते हरति पुष्करम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2201271, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "शिबिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2201272, "chapter_id": 5287, "verse_number": "२६", "content_sanskrit": "अनाहिताग्निर्म्रियतां यज्ञे विघ्नं करोतु च ।\nतपस्विभिर्विरुध्येत यस्ते हरति पुष्करम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2201273, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2201274, "chapter_id": 5287, "verse_number": "२७", "content_sanskrit": "अनृतौ जटी व्रतिन्यां वै भार्यायां सम्प्रजायतु ।\nनिराकरोतु वेदांश्च यस्ते हरति पुष्करम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2201275, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "नहुषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2201276, "chapter_id": 5287, "verse_number": "२८", "content_sanskrit": "अतिथिं गृहस्थो नुदतु कामवृत्तोऽस्तु दीक्षितः ।\nविद्यां प्रयच्छतु भृतो यस्ते हरति पुष्करम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2201277, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "अम्बरीषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2201278, "chapter_id": 5287, "verse_number": "२९", "content_sanskrit": "नृशंसस्त्यक्तधर्मोऽस्तु स्त्रीषु ज्ञातिषु गोषु च ।\nब्राह्मणं चापि जहतु यस्ते हरति पुष्करम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2201279, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2201280, "chapter_id": 5287, "verse_number": "३०", "content_sanskrit": "गूढोऽज्ञानी बहिः शास्त्रं पठतां विस्वरं पदम् ।\nगरीयसोऽवजानातु यस्ते हरति पुष्करम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2201281, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "नाभागः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2201282, "chapter_id": 5287, "verse_number": "३१", "content_sanskrit": "अनृतं भाषतु सदा सद्भिश्चैव विरुध्यतु ।\nशुल्केन कन्यां ददतु यस्ते हरति पुष्करम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2201283, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "कविः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2201284, "chapter_id": 5287, "verse_number": "३२", "content_sanskrit": "पदा स गां ताडयतु सूर्यं च प्रतिमेहतु ।\nशरणागतं च त्यजतु यस्ते हरति पुष्करम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2201285, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2201286, "chapter_id": 5287, "verse_number": "३३", "content_sanskrit": "करोतु भृतकोऽवर्षां राज्ञश्चास्तु पुरोहितः ।\nऋत्विगस्तु ह्ययाज्यस्य यस्ते हरति पुष्करम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2201287, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "पर्वतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2201288, "chapter_id": 5287, "verse_number": "३४", "content_sanskrit": "ग्रामे चाधिकृतः सोऽस्तु खरयानेन गच्छतु ।\nशुनः कर्षतु वृत्त्यर्थे यस्ते हरति पुष्करम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2201289, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "भरद्वाजः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2201290, "chapter_id": 5287, "verse_number": "३५", "content_sanskrit": "सर्वपापसमादानं नृशंसे चानृते च यत् ।\nतत् तस्यास्तु सदा पापं यस्ते हरति पुष्करम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2201291, "chapter_id": 5287, "verse_number": "३६", "content_sanskrit": "सदा वसतु सन्न्यासी ग्रामे वा नगरेऽपि वा ।\nबन्धुभिः सहवासोऽस्तु यस्ते हरति पुष्करम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2201292, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "अष्टकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2201293, "chapter_id": 5287, "verse_number": "३७", "content_sanskrit": "स राजास्त्वकृतप्रज्ञः कामवृत्तिश्च पापकृत् ।\nअधर्मेणानुशास्तूर्वीं यस्ते हरति पुष्करम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2201294, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "गालवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2201295, "chapter_id": 5287, "verse_number": "३८", "content_sanskrit": "पापिष्ठेभ्यस्त्वनर्घार्हः स नरोऽस्तु सुपापकृत् ।\nदत्त्वा दानं कीर्तयतु यस्ते हरति पुष्करम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2201296, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "अरुन्धती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2201297, "chapter_id": 5287, "verse_number": "३९", "content_sanskrit": "श्वश्व्राऽपवादं वदतु भर्तुर्भवतु दुर्मनाः ।\nएका स्वादु समश्नातु या ते हरति पुष्करम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2201298, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "वालखिल्याः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2201299, "chapter_id": 5287, "verse_number": "४०", "content_sanskrit": "एकपादेन वृत्त्यर्थं ग्रामद्वारे स तिष्ठतु ।\nधर्मज्ञस्त्यक्तधर्मोऽस्तु यस्ते हरति पुष्करम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2201300, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "पशुसखः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2201301, "chapter_id": 5287, "verse_number": "४१", "content_sanskrit": "अग्निहोत्रमनादृत्य सुखं स्वपतु स द्विजः ।\nपरिव्राट् कामवृत्तोऽस्तु यस्ते हरति पुष्करम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2201302, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "सुरभी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2201303, "chapter_id": 5287, "verse_number": "४२", "content_sanskrit": "बाल्वजेन निदानेन कांस्यं भवतु दोहनम् ।\nदुह्येत परवत्सेन या ते हरति पुष्करम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2201304, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2201305, "chapter_id": 5287, "verse_number": "४३", "content_sanskrit": "ततस्तु तैः शपथैः शप्यमानैः\nनानाविधैर्बहुभिः कौरवेन्द्र ।\nसहस्राक्षो देवराट् सम्प्रहृष्टः\nसमीक्ष्य तं कोपनं विप्रमुख्यम् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2201306, "chapter_id": 5287, "verse_number": "४४", "content_sanskrit": "अथाब्रवीन्मघवा प्रत्ययं स्वं\nसमाभाष्य तमृषिं जातरोषम् ।\nब्रह्मर्षिदेवर्षिनृपर्षिमध्ये\nयत् तन्निबोधेह ममाद्य राजन् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2201307, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2201308, "chapter_id": 5287, "verse_number": "४५", "content_sanskrit": "अध्वर्यवे दुहितरं ददातु\nच्छन्दोगे वा चरितब्रह्मचर्ये ।\nआथर्वणं वेदमधीत्य विप्रः\nस्नायीत यः पुष्करमाददाति \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2201309, "chapter_id": 5287, "verse_number": "४६", "content_sanskrit": "सर्वान् वेदानधीयीत पुण्यशीलोऽस्तु धार्मिकः ।\nब्रह्मणः सदनं यातु यस्ते हरति पुष्करम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2201310, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "अगस्त्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2201311, "chapter_id": 5287, "verse_number": "४७", "content_sanskrit": "आशीर्वादस्त्वया प्रोक्तः शपथो बलसूदन ।\nदीयतां पुष्करं मह्यमेष धर्मः सनातनः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2201312, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2201313, "chapter_id": 5287, "verse_number": "४८", "content_sanskrit": "न मया भगवन् लोभाद् हृतं पुष्करमद्य वै ।\nधर्मं तु श्रोतुकामेन हृतं न क्रोद्धुमर्हसि\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2201314, "chapter_id": 5287, "verse_number": "४९", "content_sanskrit": "धर्मः श्रुतः समुत्कर्षो धर्मसेतुरनामयः ।\nआर्षो वै शाश्वतो नित्यमव्ययोऽयं मया श्रुतः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2201315, "chapter_id": 5287, "verse_number": "५०", "content_sanskrit": "तदिदं गृह्यतां विद्वन् पुष्करं मुनिसत्तम ।\nअतिक्रमं मे भगवन् क्षन्तुमर्हस्यनिन्दित\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2201316, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2201317, "chapter_id": 5287, "verse_number": "५१", "content_sanskrit": "इत्युक्तः स महेन्द्रेण तपस्वी कोपनो भृशम् ।\nजग्राह पुष्करं धीमान् प्रसन्नश्चाभवन्मुनिः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2201318, "chapter_id": 5287, "verse_number": "५२", "content_sanskrit": "प्रययुस्ते ततो भूयस्तीर्थानि वनगोचराः ।\nपुण्यतीर्थेषु च तथा गात्राण्याप्लावयन्ति ते\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2201319, "chapter_id": 5287, "verse_number": "५३", "content_sanskrit": "आख्यानं य इदं युक्तः पठेत् पर्वणिपर्वणि ।\nन मूर्खं जनयेत् पुत्रं न भवेच्च निराकृतिः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2201320, "chapter_id": 5287, "verse_number": "५४", "content_sanskrit": "न तमापत् स्पृशेत् काचिन्न ज्वरो न रुजश्च ह ।\nविरजाः श्रेयसा युक्तः प्रेत्य स्वर्गमवाप्नुयात्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2201321, "chapter_id": 5287, "verse_number": "५५", "content_sanskrit": "यश्च शास्त्रमनुध्यायेदृषिभिः परिपालितम् ।\nस गच्छेद् ब्रह्मणो लोकमव्ययं च नरोत्तम\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2201322, "chapter_id": 5287, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे पुष्करस्तैन्यकथनं नाम अष्टत्रिंशोत्तरशततमोऽध्यायः ॥१३८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]