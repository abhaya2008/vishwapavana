[{"id": 7006398000, "chapter_id": 26398, "verse_number": "२-५५-१", "content_sanskrit": "जनमेजय उवाच\nविदर्भनगराद् याते शक्रतुल्यपराक्रमे ।\nकिमर्थं गरुडो नीतः किं च कर्म चकार सः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006398001, "chapter_id": 26398, "verse_number": "२-५५-२", "content_sanskrit": "न चारुरोह भगवान् वैनतेयं महाबलम् ।\nएतन्मे संशयं ब्रह्मन् ब्रूहि तत्त्वं महामुने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006398002, "chapter_id": 26398, "verse_number": "२-५५-३", "content_sanskrit": "वैशम्पायन उवाच\nशृणु राजन् सुपर्णेन कृतं कर्मातिमानुषम् ।\nविदर्भनगरीं गत्वा वैनतेयो महाद्युतिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006398003, "chapter_id": 26398, "verse_number": "२-५५-४", "content_sanskrit": "असम्प्राप्ते च नगरीं मथुरां मधुसूदने ।\nमनसा चिन्तयामास वैनतेयो महाद्युतिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006398004, "chapter_id": 26398, "verse_number": "२-५५-५", "content_sanskrit": "यदुक्तं देवदेवेन नृपाणामग्रतः प्रभो ।\nयास्यामि मथुरां रम्यां भोजराजेन पालिताम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006398005, "chapter_id": 26398, "verse_number": "२-५५-६", "content_sanskrit": "इति तद्वचनस्यान्ते गमिष्येति विचिन्तयन् ।\nकृताञ्जलिपुटः श्रीमान् प्रणिपत्याब्रवीदिदम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006398006, "chapter_id": 26398, "verse_number": "२-५५-७", "content_sanskrit": "गरुड उवाच\nदेव यास्यामि नगरीं रैवतस्य कुशस्थलीम् ।\nरैवतं च गिरिं रम्यं नन्दनप्रतिमं वनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006398007, "chapter_id": 26398, "verse_number": "२-५५-८", "content_sanskrit": "रुक्मिणोद्वासितां रम्यां शैलोदधितटाश्रयाम् ।\nवृक्षगुल्मलताकीर्णां पुष्परेणुविभूषिताम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006398008, "chapter_id": 26398, "verse_number": "२-५५-९", "content_sanskrit": "गजेन्द्रभुजगाकीर्णामृक्षवानरसेविताम् ।\nवराहमानुषाक्रान्तां मृगयूथैरनेकशः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006398009, "chapter_id": 26398, "verse_number": "२-५५-१०", "content_sanskrit": "तां समन्तात् समालोक्य वासार्थं ते क्षमां क्षमा ।\nयदि स्याद् भवतो रम्या प्रशस्ता नगरीति च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006398010, "chapter_id": 26398, "verse_number": "२-५५-११", "content_sanskrit": "कण्टकोद्धरणं कृत्वा आगमिष्ये तवान्तिकम् ।\nवैशम्पायन उवाच\nएवं विज्ञाप्य देवेशं प्रणिपत्य जनार्दनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006398011, "chapter_id": 26398, "verse_number": "२-५५-१२", "content_sanskrit": "जगाम पतगेन्द्रोऽपि पश्चिमाभिमुखो बली ।\nकृष्णोऽपि यदुभिः सार्द्धं विवेश मथुरां पुरीम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006398012, "chapter_id": 26398, "verse_number": "२-५५-१३", "content_sanskrit": "उग्रसेनश्च नागराश्चैव सर्वशः ।\nप्रत्युद्गम्यार्चयन् कृष्णं प्रहृष्टजनसंकुलम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006398013, "chapter_id": 26398, "verse_number": "२-५५-१४", "content_sanskrit": "जनमेजय उवाच\nश्रुत्वाभिषिक्तं राजेन्द्रं बहुभिर्वसुधाधिपैः ।\nकिं चकार महाबाहुरुग्रसेनो महीपतिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006398014, "chapter_id": 26398, "verse_number": "२-५५-१५", "content_sanskrit": "वैशम्पायन उवाच\nश्रुत्वाभिषिक्तं राजेन्द्रं बहुभिः पार्थिवोत्तमैः ।\nइन्द्रेण कृतसंधानं दूतं चित्राङ्गदं कृतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006398015, "chapter_id": 26398, "verse_number": "२-५५-१६", "content_sanskrit": "एकैकं नृपतेर्भागं शतसाहस्रसम्मितम् ।\nराजेन्द्रे त्वर्बुदं दत्तं मानवेषु च वै दश ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006398016, "chapter_id": 26398, "verse_number": "२-५५-१७", "content_sanskrit": "ये तत्र समनुप्राप्ता न रिक्तास्ते गृहं गताः ।\nशङ्खो यादवरूपेण प्रददौ हरिचिन्तितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006398017, "chapter_id": 26398, "verse_number": "२-५५-१८", "content_sanskrit": "एवं निधिपतिः श्रीमान् दैवतैरनुमोदितः ।\nइति श्रुत्वात्मिकजनाल्लोकप्रवृत्तिकान्नरात् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006398018, "chapter_id": 26398, "verse_number": "२-५५-१९", "content_sanskrit": "चकार महतीं पूजां देवतायतनेष्वपि ।\nवसुदेवस्य भवने तोरणोभयपार्श्वतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006398019, "chapter_id": 26398, "verse_number": "२-५५-२०", "content_sanskrit": "नटानां नृत्यगेयानि वाद्यानि च समन्ततः ।\nपताकाध्वजमालाढ्यां कारयामास वै नृपः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006398020, "chapter_id": 26398, "verse_number": "२-५५-२१", "content_sanskrit": "कंसराजस्य च सभां विचित्राम्बरसुप्रभाम् ।\nपताका विविधाकारा दापयामास भोजराट् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006398021, "chapter_id": 26398, "verse_number": "२-५५-२२", "content_sanskrit": "तोरणं गोपुरं चैव सुधापङ्कानुलेपनम् ।\nकारयामास राजेन्द्रो राजेन्द्रस्यासनालयम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006398022, "chapter_id": 26398, "verse_number": "२-५५-२३", "content_sanskrit": "नटानां नृत्यगेयानि वाद्यानि च समन्ततः ।\nपताका वनमालाढ्याः पूर्णकुम्भाः समन्ततः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006398023, "chapter_id": 26398, "verse_number": "२-५५-२४", "content_sanskrit": "राजमार्गेषु राजेन्द्र चन्दनोदकसेचितम् ।\nवस्त्राभरणकं राजा दापयामास भूतले ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006398024, "chapter_id": 26398, "verse_number": "२-५५-२५", "content_sanskrit": "धूपं पार्श्वोभये चैव चन्दनागुरुगुग्गुलैः ।\nगुडं सर्जरसं चैव दह्यमानं ततस्ततः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006398025, "chapter_id": 26398, "verse_number": "२-५५-२६", "content_sanskrit": "वृद्धस्त्रीजनसंघैश्च गायद्भिः स्तुतिमङ्गलम् ।\nअर्घं कृत्वा प्रतीक्षन्ते स्वेषु स्थानेषु योषितः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006398026, "chapter_id": 26398, "verse_number": "२-५५-२७", "content_sanskrit": "एवं कृत्वा पुरानन्दमुग्रसेनो नराधिपः ।\nवसुदेवगृहं गत्वा प्रियाख्यानं निवेद्य च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006398027, "chapter_id": 26398, "verse_number": "२-५५-२८", "content_sanskrit": "रामेण सह सम्मन्त्र्य निर्गतो रथमन्तिकम् ।\nतस्मिन्नेवान्तरे राजञ्शङ्खध्वनिरभून्महान् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006398028, "chapter_id": 26398, "verse_number": "२-५५-२९", "content_sanskrit": "पाञ्चजन्यस्य निनदं श्रुत्वा मधुरवासिनः ।\nस्त्रियो वृद्धाश्च बालाश्च सूता मागधबन्दिनः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006398029, "chapter_id": 26398, "verse_number": "२-५५-३०", "content_sanskrit": "विनिर्ययुर्महासेना रामं कृत्वाग्रतो नृप ।\nअर्घ्य पाद्यं पुरस्कृत्य उग्रसेनेन धीमता ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006398030, "chapter_id": 26398, "verse_number": "२-५५-३१", "content_sanskrit": "दृष्टिपन्थानमासाद्य उग्रसेनो महीपतिः ।\nअवतीर्य रथाच्छुभ्रात् पादमार्गेण चाग्रतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006398031, "chapter_id": 26398, "verse_number": "२-५५-३२", "content_sanskrit": "दृष्ट्वाऽऽसीनं रथे रम्ये दिव्यरत्नविभूषितम् ।\nअङ्गेष्वाभरणं चैव दिव्यरत्नप्रभायुतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006398032, "chapter_id": 26398, "verse_number": "२-५५-३३", "content_sanskrit": "वनमालोरसं दिव्यं तपन्तमिव भास्करम् ।\nचामरं व्यजनं छत्रं खगेन्द्रध्वजमुच्छ्रितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006398033, "chapter_id": 26398, "verse_number": "२-५५-३४", "content_sanskrit": "राजलक्षणसम्पूर्णमासन्नार्कमिवोज्ज्वलम् ।\nश्रियाभिभूतं देवेशं दुर्निरीक्ष्यतरं हरिम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006398034, "chapter_id": 26398, "verse_number": "२-५५-३५", "content_sanskrit": "दृष्ट्वा स राजा राजेन्द्र हर्षगद्गदया गिरा ।\nबभाषे पुण्डरीकाक्षं रामं बलनिषूदनम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006398035, "chapter_id": 26398, "verse_number": "२-५५-३६", "content_sanskrit": "रथेन न मया गन्तुं युक्तपूर्वेति चिन्त्य वै ।\nअवतीर्णो महाभाग गच्छ त्वं स्यन्दनेन च ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006398036, "chapter_id": 26398, "verse_number": "२-५५-३७", "content_sanskrit": "विष्णुना छद्मरूपेण गत्वेमां मथुरां पुरीम् ।\nअनुप्रकाशितात्मानं देवेन्द्रत्वं नृपार्णवे ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006398037, "chapter_id": 26398, "verse_number": "२-५५-३८", "content_sanskrit": "तमहं स्तोतुमिच्छामि सर्वभावेन केशवम् ।\nप्रत्युवाच महातेजा राजानं कृष्णपूर्वजः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006398038, "chapter_id": 26398, "verse_number": "२-५५-३९", "content_sanskrit": "न युक्तं नृपते स्तोतुं व्रजन्तं देवसत्तमम् ।\nविना स्तोत्रेण संतुष्टस्तव राजञ्जनार्दनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006398039, "chapter_id": 26398, "verse_number": "२-५५-४०", "content_sanskrit": "तुष्टस्य स्तुतिना किं ते दर्शनेन तव स्तुतिः ।\nराजेन्द्रत्वमनुप्राप्य आगतस्तव वेश्मनि ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006398040, "chapter_id": 26398, "verse_number": "२-५५-४१", "content_sanskrit": "न त्वया स्तुतवान्राजन्दिव्यैः स्तोत्रैरमानुषैः ।\nएवमाब्रुवमाणौ तौ सम्प्राप्तौ केशवान्तिकम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006398041, "chapter_id": 26398, "verse_number": "२-५५-४२", "content_sanskrit": "अर्घोद्यतभुजं दृष्ट्वा स्थापयित्वा रथोत्तमम् ।\nउवाच वदतां श्रेष्ठ उग्रसेनं नराधिपम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006398042, "chapter_id": 26398, "verse_number": "२-५५-४३", "content_sanskrit": "यन्मया चाभिषिक्तस्त्वं मथुरेशो भवत्विति ।\nन युक्तमन्यथा कर्तुं मथुराधिपते स्वयम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006398043, "chapter_id": 26398, "verse_number": "२-५५-४४", "content_sanskrit": "अर्घ्यमाचमनीयं च पाद्यं चास्मै निवेदितम् ।\nन दातुमर्हसे राजन्नेष मे मनसः प्रियः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006398044, "chapter_id": 26398, "verse_number": "२-५५-४५", "content_sanskrit": "तवाभिप्रायं विज्ञाय ब्रवीमि नृपते वचः ।\nत्वमेव माथुरो राजा नान्यथा कर्तुमर्हसि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006398045, "chapter_id": 26398, "verse_number": "२-५५-४६", "content_sanskrit": "स्थानभागं च नृपते दास्यामि तव दक्षिणम् ।\nयथा नृपाणां सर्वेषां तथा ते स्थापितोऽग्रतः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006398046, "chapter_id": 26398, "verse_number": "२-५५-४७", "content_sanskrit": "शतसाहस्रिको भागो वस्त्राभरणवर्जितः ।\nआरुहस्व रथं शुभ्रं चामीकरविभूषितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006398047, "chapter_id": 26398, "verse_number": "२-५५-४८", "content_sanskrit": "चामरं व्यजनं छत्रं ध्वजं च मनुजेश्वर ।\nदिव्याभरणसंयुक्तं मुकुटं भास्करप्रभम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006398048, "chapter_id": 26398, "verse_number": "२-५५-४९", "content_sanskrit": "धारयस्व महाभाग पालयस्व पुरीमिमाम् ।\nपुत्रपौत्रैः प्रमुदितो मथुरां परिपालय ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006398049, "chapter_id": 26398, "verse_number": "२-५५-५०", "content_sanskrit": "जित्वारिगणसंघांश्च भोजवंशं विवर्द्धय ।\nदेवदेवाद्यनन्ताय शौरिणे वज्रपाणिना ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006398050, "chapter_id": 26398, "verse_number": "२-५५-५१", "content_sanskrit": "प्रेषितं देवराजेन दिव्याभरणमम्बरम् ।\nमाथुराणां च सर्वेषां भागा दीनारका दश ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006398051, "chapter_id": 26398, "verse_number": "२-५५-५२", "content_sanskrit": "सूतमागधबन्दीनामेकैकस्य सहस्रकम् ।\nवृद्धस्त्रीजनसंघानां गणिकानां शतं शतम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006398052, "chapter_id": 26398, "verse_number": "२-५५-५३", "content_sanskrit": "नृपेण सह तिष्ठन्ति विकद्रुप्रमुखाश्च ये ।\nदशसाहस्रिको भागस्तेषां धात्रा प्रकल्पितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006398053, "chapter_id": 26398, "verse_number": "२-५५-५४", "content_sanskrit": "वैशम्पायन उवाच\nएवं सम्पूज्य राजानं माथुराणां चमूमुखे ।\nकृत्वा सुमहदानन्दां मथुरां मधुसूदनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006398054, "chapter_id": 26398, "verse_number": "२-५५-५५", "content_sanskrit": "दिव्याभरणमाल्यैश्च दिव्याम्बरविलेपनैः ।\nदीप्यमानाः समन्ताच्च देवा इव त्रिविष्टपे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006398055, "chapter_id": 26398, "verse_number": "२-५५-५६", "content_sanskrit": "भेरीपटहनादेन शङ्खदुन्दुभिनिःस्वनैः ।\nबृंहितेन च नागानां हयानां हेषितेन च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006398056, "chapter_id": 26398, "verse_number": "२-५५-५७", "content_sanskrit": "सिंहनादेन शूराणां रथनेमिस्वनेन च ।\nतुमुलः सुमहानासीन्मेघनाद इवाम्बरे ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006398057, "chapter_id": 26398, "verse_number": "२-५५-५८", "content_sanskrit": "बन्दिभिः स्तूयमानं च नमश्चक्रुरपि प्रजाः ।\nदत्त्वा दानमनन्तं च न ययौ विस्मयं हरिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006398058, "chapter_id": 26398, "verse_number": "२-५५-५९", "content_sanskrit": "स्वभावोन्नतभावत्वाद् दृष्टपूर्वात्ततोऽधिकम् ।\nअनहंकारभावाच्च विस्मयं न जगाम ह ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006398059, "chapter_id": 26398, "verse_number": "२-५५-६०", "content_sanskrit": "दीप्यमानं स्ववपुषा आयान्तं भास्करप्रभम् ।\nदृष्ट्वा मथुरवासिन्यो नमश्चक्रुः पदे पदे ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006398060, "chapter_id": 26398, "verse_number": "२-५५-६१", "content_sanskrit": "एष नारायणः श्रीमान् क्षीरार्णवनिकेतनः ।\nनागपर्यङ्कमुत्सृज्य प्राप्तोऽयं मथुरां पुरीम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006398061, "chapter_id": 26398, "verse_number": "२-५५-६२", "content_sanskrit": "बद्ध्वा बलिं महावीर्यं दुर्जयं त्रिदशैरपि ।\nशक्राय प्रददौ राज्यं त्रैलोक्यं वज्रपाणये ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006398062, "chapter_id": 26398, "verse_number": "२-५५-६३", "content_sanskrit": "हत्वा दैत्यगणान् सर्वान् कंसं च बलिनां वरम् ।\nभोजराजाय मथुरां दत्त्वा केशिनिषूदनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006398063, "chapter_id": 26398, "verse_number": "२-५५-६४", "content_sanskrit": "नाभिषिक्तः स्वयं राज्ये न चासीनो नृपासने ।\nराजेन्द्रत्वं च सम्प्राप्य मथुरामाविशत्ततः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006398064, "chapter_id": 26398, "verse_number": "२-५५-६५", "content_sanskrit": "एवमन्योन्यसंजल्पं श्रुत्वा पुरनिवासिनाम्।\nबन्दिमागधसूतानामिदमूचुर्गणाधिपाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006398065, "chapter_id": 26398, "verse_number": "२-५५-६६", "content_sanskrit": "किं वा शक्यामहे वक्तुं गुणानां ते गुणोदधे ।\nमानुषेणैकजिह्वेन प्रभावोत्साहसम्भवान् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006398066, "chapter_id": 26398, "verse_number": "२-५५-६७", "content_sanskrit": "स तत्र भोगी नागेन्द्रः कदाचिद्देव बुद्धिमान् ।\nद्विसाहस्रेण जिह्वेन वासुकिः कथयिष्यति ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006398067, "chapter_id": 26398, "verse_number": "२-५५-६८", "content_sanskrit": "किं त्वद्भुतमिदं लोके मानवेन्द्रेषु भूतले ।\nन भूतं न भविष्यं च शक्रादासनमागतम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006398068, "chapter_id": 26398, "verse_number": "२-५५-६९", "content_sanskrit": "सभावतरणं चैव कलशैरागतं स्वयम् ।\nन श्रुतं न च दृष्टं वा तेन मन्यामहेऽद्भुतम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006398069, "chapter_id": 26398, "verse_number": "२-५५-७०", "content_sanskrit": "धन्या देवी महाभागा देवकी योषितां वरा ।\nभवन्तं त्रिदशश्रेष्ठं धृत्वा गर्भेण केशवम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006398070, "chapter_id": 26398, "verse_number": "२-५५-७१", "content_sanskrit": "कृष्णं पद्मपलाशाक्षं श्रीपुञ्जममरार्चितम् ।\nनेत्राभ्यां स्नेहपूर्णाभ्यां वीक्षते मुखपङ्कजम् ॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006398071, "chapter_id": 26398, "verse_number": "२-५५-७२", "content_sanskrit": "इति संजल्पमानानां शृण्वन्तौ पृथगीरितम् ।\nउग्रसेनं पुरस्कृत्य भ्रातरौ रामकेशवौ ॥ ७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006398072, "chapter_id": 26398, "verse_number": "२-५५-७३", "content_sanskrit": "प्राकारद्वारि सम्प्राप्तावर्चयामास वै तदा ।\nअर्घ्यमाचमनं दत्त्वा पाद्यं पाद्येति चाब्रवीत् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006398073, "chapter_id": 26398, "verse_number": "२-५५-७४", "content_sanskrit": "उग्रसेनस्ततो धीमान् केशवस्य रथाग्रतः ।\nप्रणम्य शिरसा कृष्णं गजमारुह्य वीर्यवान् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006398074, "chapter_id": 26398, "verse_number": "२-५५-७५", "content_sanskrit": "घनवत् तोयधारेण ववर्ष कनकाम्बुभिः ।\nघनौघैर्वर्षमाणस्तु सम्प्राप्तः पितृवेश्मनि ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006398075, "chapter_id": 26398, "verse_number": "२-५५-७६", "content_sanskrit": "मथुराधिपतिः श्रीमानुवाच मधुसूदनम् ।\nराजेन्द्रत्वमनुप्राप्य युक्तं मे नृपवेश्मनि ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006398076, "chapter_id": 26398, "verse_number": "२-५५-७७", "content_sanskrit": "स्थापितुं देवराजेन दत्तं सिंहासनं प्रभो ।\nनेष्यामि मथुरेशस्य सभां भुजबलार्जिताम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006398077, "chapter_id": 26398, "verse_number": "२-५५-७८", "content_sanskrit": "प्रसादयिष्ये भगवन् न कोपं कर्तुमर्हसि ।\nदेवकी वसुदेवश्च रोहिणी च विशाम्पते ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006398078, "chapter_id": 26398, "verse_number": "२-५५-७९", "content_sanskrit": "न किंचित्करणे शक्ता हर्षक्लमविमोहिता ।\nकंसमाता ततो राजन्नर्चयामास केशवम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006398079, "chapter_id": 26398, "verse_number": "२-५५-८०", "content_sanskrit": "नानादिग्देशजानीतं कंसेनोपार्जितं धनम् ।\nदेशकालं समालोक्य पादयुग्मे न्यवेदयत् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006398080, "chapter_id": 26398, "verse_number": "२-५५-८१", "content_sanskrit": "उग्रसेनं समाहूय उवाच श्लक्ष्णया गिरा ।\nश्रीकृष्ण उवाच\nन चाहं मथुराकाङ्क्षी न मया वित्तकाङ्क्षया ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006398081, "chapter_id": 26398, "verse_number": "२-५५-८२", "content_sanskrit": "घातितस्तव पुत्रोऽयं कालेन निधनं गतः ।\nयजस्व विविधान्यज्ञान् ददस्व विपुलं धनम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006398082, "chapter_id": 26398, "verse_number": "२-५५-८३", "content_sanskrit": "जयस्व रिपुसैन्यानि मम बाहुबलाश्रयात् ।\nत्यजस्व मनसस्तापं कंसनाशोद्भवं भयम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006398083, "chapter_id": 26398, "verse_number": "२-५५-८४", "content_sanskrit": "नयस्व वित्तनिचयं मया दत्तं पुनस्तव ।\nइति प्राश्वास्य राजानं कृष्णस्तु हलिना सह ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006398084, "chapter_id": 26398, "verse_number": "२-५५-८५", "content_sanskrit": "प्रविवेश ततः श्रीमान् मातापित्रोरथान्तिकम् ।\nआनन्दपरिपूर्णाभ्यां हृदयाभ्यां महाबलौ ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006398085, "chapter_id": 26398, "verse_number": "२-५५-८६", "content_sanskrit": "पितृमात्रोस्तु पादान् वै नमश्चक्रतुरानतौ ।\nतस्मिन् मुहूर्ते नगरी मथुरा तु बभूव सा ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006398086, "chapter_id": 26398, "verse_number": "२-५५-८७", "content_sanskrit": "स्वर्गलोकं परित्यज्यावतीर्णेवामरावती ।\nवसुदेवस्य भवनं समीक्ष्य पुरवासिनः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006398087, "chapter_id": 26398, "verse_number": "२-५५-८८", "content_sanskrit": "मनसा चिन्तयामासुर्देवलोकं न भूतलम् ।\nविसृज्य मथुरेशं तु महिषीसहितं तदा ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006398088, "chapter_id": 26398, "verse_number": "२-५५-८९", "content_sanskrit": "भवनं वसुदेवस्य प्रविश्य बलकेशवौ ।\nन्यस्तशस्त्रावुभौ वीरौ स्वगृहे स्वैरचारिणौ ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7006398089, "chapter_id": 26398, "verse_number": "२-५५-९०", "content_sanskrit": "ततः कृताह्निकौ भूत्वा सुखासीनौ कथान्तरे ।\nएतस्मिन्नेव काले तु महोत्पातो बभूव ह ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7006398090, "chapter_id": 26398, "verse_number": "२-५५-९१", "content_sanskrit": "बभ्रमुश्च घनाकाशे चेलुश्च भुवि पर्वताः ।\nसमुद्राः क्षुभिताः सर्वे विभ्रान्तो भोगिनां वरः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7006398091, "chapter_id": 26398, "verse_number": "२-५५-९२", "content_sanskrit": "कम्पिता यादवाः सर्वे न्युब्जाश्च पतिता भुवि ।\nतौ तान्निपतितान्दृष्ट्वा रामकृष्णौ तु निश्चलौ ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7006398092, "chapter_id": 26398, "verse_number": "२-५५-९३", "content_sanskrit": "महता पक्षवातेन विज्ञातौ पतगोत्तमम् ।\nददर्श समनुप्राप्तं दिव्यस्रगनुलेपनम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7006398093, "chapter_id": 26398, "verse_number": "२-५५-९४", "content_sanskrit": "प्रणम्य शिरसा ताभ्यां सौम्यरूपी कृतासनः ।\nतं दृष्ट्वा समनुप्राप्तं सचिवं साम्परायिकम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7006398094, "chapter_id": 26398, "verse_number": "२-५५-९५", "content_sanskrit": "धृतिमन्तं गरुत्मन्तमुवाच बलिसूदनः ।\nस्वागतं खेचरश्रेष्ठ सुरसेनारिमर्दन ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7006398095, "chapter_id": 26398, "verse_number": "२-५५-९६", "content_sanskrit": "विनताहृदयानन्द स्वागतं केशवप्रिय ।\nतमुवाच ततः कृष्णः स्थितं देहमिवापरम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7006398096, "chapter_id": 26398, "verse_number": "२-५५-९७", "content_sanskrit": "तुल्यसामर्थ्यया वाचा आसीनं विनतात्मजम् ।\nश्रीकृष्ण उवाच\nयास्यामः पतगश्रेष्ठ भोजस्यान्तःपुरं महत् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7006398097, "chapter_id": 26398, "verse_number": "२-५५-९८", "content_sanskrit": "तत्र गत्वा सुखासीना मन्त्रयामो मनोगतम् ।\nवैशम्पायन उवाच\nप्रविष्टौ तौ महावीर्यौ बलदेवजनार्दनौ ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7006398098, "chapter_id": 26398, "verse_number": "२-५५-९९", "content_sanskrit": "वैनतेयतृतीयौ च गुह्यं मन्त्रमथाब्रुवन् ।\nअवध्योऽसौ कृतोऽस्माकं सुमहच्च रिपोर्बलम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7006398099, "chapter_id": 26398, "verse_number": "२-५५-१००", "content_sanskrit": "वृतः सैन्येन महता महद्भिश्च नराधिपैः ।\nबहुलानि च सैन्यानि हन्तुं वर्षशतैरपि ॥१०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7006398100, "chapter_id": 26398, "verse_number": "२-५५-१०१", "content_sanskrit": "न शक्ष्यामः क्षयं कर्तुं जरासंधस्य वाहिनीम् ।\nअतोऽर्थं वैनतेय त्वां ब्रवीमि मथुरां पुरीम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7006398101, "chapter_id": 26398, "verse_number": "२-५५-१०२", "content_sanskrit": "वसतोरावयोः श्रेयो न भवेदिति मे मतिः ।\nगरुड उवाच\nदेवदेवं नमस्कृत्य गतोऽहं भवतोऽन्तिकात् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7006398102, "chapter_id": 26398, "verse_number": "२-५५-१०३", "content_sanskrit": "वासार्थमीक्षितुं भूमिं तव देव कुशस्थलीम् ।\nगत्वाहं खे समास्थाय समन्तादवलोक्य ताम्॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7006398103, "chapter_id": 26398, "verse_number": "२-५५-१०४", "content_sanskrit": "दृष्ट्वाहं विबुधश्रेष्ठ पुरीं लक्षणपूजिताम्।\nसागरानूपविपुलां प्रागुदक्प्लवशीतलाम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7006398104, "chapter_id": 26398, "verse_number": "२-५५-१०५", "content_sanskrit": "सर्वतोदधिमध्यस्थामभेद्यां त्रिदशैरपि ।\nसर्वरत्नाकरवतीं सर्वकामफलद्रुमाम् ॥१०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7006398105, "chapter_id": 26398, "verse_number": "२-५५-१०६", "content_sanskrit": "सर्वर्तुकुसुमाकीर्णां सर्वतः सुमनोहराम् ।\nसर्वाश्रमाधिवासां च सर्वकामगुणैर्युताम् ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7006398106, "chapter_id": 26398, "verse_number": "२-५५-१०७", "content_sanskrit": "नरनारीसमाकीर्णां नित्यामोदविवर्द्धिनीम् ।\nप्राकारपरिखोपेतां गोपुराट्टालमालिनीम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7006398107, "chapter_id": 26398, "verse_number": "२-५५-१०८", "content_sanskrit": "विचित्रचत्वरपथां विपुलद्वारतोरणाम् ।\nयन्त्रार्गलविचित्राख्यां हेमप्राकारशोभिताम् ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7006398108, "chapter_id": 26398, "verse_number": "२-५५-१०९", "content_sanskrit": "नरनागाश्वकलिलां रथसैन्यसमाकुलाम् ।\nनानादिग्देशजाकीर्णां दिव्यपुष्पफलद्रुमाम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7006398109, "chapter_id": 26398, "verse_number": "२-५५-११०", "content_sanskrit": "पताकाध्वजमालाढ्यां महाभवनशालिनीम् ।\nभीषणीं रिपुसंघानां मित्राणां हर्षवर्द्धनीम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7006398110, "chapter_id": 26398, "verse_number": "२-५५-१११", "content_sanskrit": "मनुजेन्द्राधिवासेभ्यो विशिष्टां नगरोत्तमाम् ।\nरैवतं च गिरिश्रेष्ठं कुरु देव सुरालयम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7006398111, "chapter_id": 26398, "verse_number": "२-५५-११२", "content_sanskrit": "नन्दनप्रतिमं दिव्यं पुरद्वारस्य भूषणम् ।\nकारयस्वाधिवासं च तत्र गत्वा सुरोत्तम ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7006398112, "chapter_id": 26398, "verse_number": "२-५५-११३", "content_sanskrit": "कुमारीणां प्रचारश्च सुरमण्यो भविष्यति ।\nनाम्ना द्वारवती ज्ञेया त्रिषु लोकेषु विश्रुता ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7006398113, "chapter_id": 26398, "verse_number": "२-५५-११४", "content_sanskrit": "भविष्यति पुरी रम्या शक्रस्येवामरावती ।\nयदि स्यात् संवृतां भूमिं प्रदास्यति महोदधिः ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7006398114, "chapter_id": 26398, "verse_number": "२-५५-११५", "content_sanskrit": "यथेष्टं विविधं कर्म विश्वकर्मा करिष्यति ।\nमणिमुक्ताप्रवालाभिर्वज्रवैदूर्यसप्रभैः ॥११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7006398115, "chapter_id": 26398, "verse_number": "२-५५-११६", "content_sanskrit": "दिव्यैरभिप्राययुतैर्दिव्यरत्नैस्त्रिलोकजैः ।\nदिव्यस्तम्भशताकीर्णान् स्वर्गे देवसभोपमान् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7006398116, "chapter_id": 26398, "verse_number": "२-५५-११७", "content_sanskrit": "जाम्बुनदमयाञ्छुभ्रान् सर्वरत्नविभूषितान् ।\nदिव्यध्वजपताकाढ्यान् देवगन्धर्वपालितान् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7006398117, "chapter_id": 26398, "verse_number": "२-५५-११८", "content_sanskrit": "चन्द्रसूर्यप्रतीकाशान् प्रासादान् कारय प्रभो ।\nवैशम्पायन उवाच\nएवं कृत्वा तु संकल्पं वैनतेयोऽथ केशवम् ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7006398118, "chapter_id": 26398, "verse_number": "२-५५-११९", "content_sanskrit": "प्रणम्य शिरसा ताभ्यां निषसाद कृतासनः ।\nकृष्णोऽपि रामसहितो विचिन्त्य हितमीरितम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7006398119, "chapter_id": 26398, "verse_number": "२-५५-१२०", "content_sanskrit": "प्रकाशकर्तुकामौ तौ विसृज्य विनतात्मजम् ।\nसत्कृत्य विधिवद् राजन् महार्हवरभूषणैः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7006398120, "chapter_id": 26398, "verse_number": "२-५५-१२१", "content_sanskrit": "मोदेते सुखिनौ तत्र सुरलोके यथामरौ ।\nतस्य तद् वचनं श्रुत्वा भोजराजो महायशाः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7006398121, "chapter_id": 26398, "verse_number": "२-५५-१२२", "content_sanskrit": "कृष्णं स्नेहेन विस्रब्धं बभाषे वचनामृतम् ।\nकृष्ण कृष्ण महाबाहो यदूनां नन्दिवर्द्धन ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7006398122, "chapter_id": 26398, "verse_number": "२-५५-१२३", "content_sanskrit": "श्रूयतां वचनं त्वाद्य वक्ष्यामि रिपुसूदन ।\nत्वया विहीनाः सर्वे स्म न शक्ताः सुखमासितुम् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7006398123, "chapter_id": 26398, "verse_number": "२-५५-१२४", "content_sanskrit": "पुरेऽस्मिन् विषयान्ते वा पतिहीना इव स्त्रियः ।\nत्वत्सनाथा वयं तात त्वद्बाहुबलमाश्रिताः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7006398124, "chapter_id": 26398, "verse_number": "२-५५-१२५", "content_sanskrit": "बिभीमो न नरेन्द्राणां सेन्द्राणामपि मानद ।\nविजयाय यदुश्रेष्ठ यत्र यत्र गमिष्यसि ॥ १२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7006398125, "chapter_id": 26398, "verse_number": "२-५५-१२६", "content_sanskrit": "तत्र त्वं सहितोऽस्माभिर्गच्छेथा यादवर्षभ ।\nतस्य राज्ञो वचः श्रुत्वा सस्मितं देवकीसुतः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7006398126, "chapter_id": 26398, "verse_number": "२-५५-१२७", "content_sanskrit": "यथेष्टं भवतामद्य तथा कर्तास्म्यसंशयम् ॥ १२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}]