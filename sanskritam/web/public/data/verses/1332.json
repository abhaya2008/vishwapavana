[{"id": 2015775, "chapter_id": 1332, "verse_number": "२-७३-१", "content_sanskrit": "वैशम्पायन उवाच॥\nअनुसंसार्य नृपतीन्पाण्डवाः पाण्डवाग्रजम्।\nअभिजग्मुर्महेष्वासा धर्मराजं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015776, "chapter_id": 1332, "verse_number": "२-७३-२", "content_sanskrit": "सोऽनुमेने महाबाहुर्भातॄंश्च सुहृदस्तथा।\nशिष्यैः परिवृतो व्यासः पुरस्तात्समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015777, "chapter_id": 1332, "verse_number": "२-७३-३", "content_sanskrit": "सोऽभ्ययादासनात्तूर्णं भ्रातृभिः परिवारितः।\nपाद्येनासनदानेन पितामहमपूजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015778, "chapter_id": 1332, "verse_number": "२-७३-४", "content_sanskrit": "अथोपविश्य भगवान्काञ्चने परमासने।\nआस्यतामिति चोवाच धर्मराजं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015779, "chapter_id": 1332, "verse_number": "२-७३-५", "content_sanskrit": "अथोपविष्टं राजानं भ्रातृभिः परिवारितम्।\nउवाच भगवान्व्यासस्तत्तद्वाक्यविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015780, "chapter_id": 1332, "verse_number": "२-७३-६", "content_sanskrit": "दिष्ट्या वर्धसि कौन्तेय साम्राज्यं प्राप्य दुर्लभम्।\nवर्धिताः कुरवः सर्वे त्वया कुरुकुलोद्वह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015781, "chapter_id": 1332, "verse_number": "२-७३-७", "content_sanskrit": "आपृच्छे त्वां गमिष्यामि पूजितोऽस्मि विशाम्पते।\nएवमुक्तः स कृष्णेन धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015782, "chapter_id": 1332, "verse_number": "२-७३-८", "content_sanskrit": "अभिवाद्योपसङ्गृह्य पितामहमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015783, "chapter_id": 1332, "verse_number": "२-७३-८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015784, "chapter_id": 1332, "verse_number": "२-७३-९", "content_sanskrit": "संशयो द्विपदां श्रेष्ठ ममोत्पन्नः सुदुर्लभः।\nतस्य नान्योऽस्ति वक्ता वै त्वामृते द्विजपुङ्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015785, "chapter_id": 1332, "verse_number": "२-७३-१०", "content_sanskrit": "उत्पातांस्त्रिविधान्प्राह नारदो भगवानृषिः।\nदिव्यांश्चैवान्तरिक्षांश्च पार्थिवांश्च पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015786, "chapter_id": 1332, "verse_number": "२-७३-११", "content_sanskrit": "सुमहच्च फलं तेषां भवितेति न संशयः।\nअपि चैद्यस्य पतनाच्छान्तमौत्पातिकं महत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015787, "chapter_id": 1332, "verse_number": "२-७३-१२x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015788, "chapter_id": 1332, "verse_number": "२-७३-१२", "content_sanskrit": "राज्ञस्तु वचनं श्रुत्वा पराशरसुतः प्रभुः।\nकृष्णद्वैपायनो व्यास इदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015789, "chapter_id": 1332, "verse_number": "२-७३-१३", "content_sanskrit": "त्रयोदश समा राजन्नुत्पातानां फलं महत्।\nसर्वक्षत्रविनाशाय भविष्यति विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015790, "chapter_id": 1332, "verse_number": "२-७३-१४", "content_sanskrit": "त्वामेकं कारणं कृत्वा कालेन भरतर्षभ।\nसमेतं पार्थिवं क्षत्रं क्षयं यास्यति भारत।\nदुर्योधनापराधेन भीमार्जुनबलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015791, "chapter_id": 1332, "verse_number": "२-७३-१५", "content_sanskrit": "स्वप्नं द्रक्ष्यसि राजेन्द्र तस्मिन्काल उपस्थिते।\nतत्तेऽहं सम्प्रवक्ष्यामि तन्निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015792, "chapter_id": 1332, "verse_number": "२-७३-१६", "content_sanskrit": "यान्तं द्रक्ष्यसि राजेन्द्र क्षपान्ते त्वं वृषध्वजम्।\nनीलकण्ठं भवं स्थाणुं कपालिं त्रिपुरान्तकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015793, "chapter_id": 1332, "verse_number": "२-७३-१७", "content_sanskrit": "उग्रं रुद्रं पशुपतिं महादेवमुमापतिम्।\nहरं शर्वं वृषं शूलं पिनाकिं कृत्तिवाससम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015794, "chapter_id": 1332, "verse_number": "२-७३-१८", "content_sanskrit": "कैलासकूडप्रतिमे वृषभेऽवस्थितं शिवम्।\nनिरीक्षमाणं सततं पितृराजाश्रितां दिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015795, "chapter_id": 1332, "verse_number": "२-७३-१९", "content_sanskrit": "एवमीदृशकं स्वप्नं द्रक्ष्यसि त्वं विशाम्पते।\nमा तत्कृते ह्यनुध्याहि कालो हि दुरतिक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015796, "chapter_id": 1332, "verse_number": "२-७३-२०", "content_sanskrit": "स्वस्ति तेऽस्तु गमिष्यामि कैलासं पर्वतं प्रति।\nअप्रमत्तः स्थितो दान्तः पृथिवीं परिपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015797, "chapter_id": 1332, "verse_number": "२-७३-२१x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015798, "chapter_id": 1332, "verse_number": "२-७३-२१", "content_sanskrit": "एवमुक्त्वा स भगवान्कैलासं पर्वतं ययौ।\nकृष्णद्वैपायनो व्यासः सह शिष्यैः सहानुगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015799, "chapter_id": 1332, "verse_number": "२-७३-२२", "content_sanskrit": "गते पितामहे राजा चिन्ताशोकसमन्वितः।\nनिः श्वसन्नुष्णमसकृत्तमेवार्थं विचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015800, "chapter_id": 1332, "verse_number": "२-७३-२३", "content_sanskrit": "कथं तु दैवं शक्येत पौरुषेण प्रबाधितुम्।\nअवश्यमेव भविता यदुक्तं परमर्षिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015801, "chapter_id": 1332, "verse_number": "२-७३-२४", "content_sanskrit": "ततोऽब्रवीन्महातेजाः सर्वान्भ्रातॄन्युधिष्ठिरः।\nश्रुतं वै पुरुषव्याघ्रा यन्मां द्वैपायनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015802, "chapter_id": 1332, "verse_number": "२-७३-२५", "content_sanskrit": "तदा तद्वचनं श्रुत्वा मरणे निश्चिता मतिः।\nसर्वक्षत्रस्य निधने यद्यहं हेतुरीप्सितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015803, "chapter_id": 1332, "verse_number": "२-७३-२६", "content_sanskrit": "कालेन निर्मितस्तात को ममार्थोऽस्ति जीवतः।\nएवं ब्रुवन्तं राजानं फाल्गुनः प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015804, "chapter_id": 1332, "verse_number": "२-७३-२७", "content_sanskrit": "मा राजन्कश्मलं घोरं प्रविशो बुद्धिनाशनम्।\nसम्प्रधार्य महाराज यत्क्षमं तत्समाचर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015805, "chapter_id": 1332, "verse_number": "२-७३-२८x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015806, "chapter_id": 1332, "verse_number": "२-७३-२८", "content_sanskrit": "ततोऽब्रवीत्सत्यधृतिर्भ्रातॄन्सर्वान्युधिष्ठिरः।\nद्वैपायनस्य वचनं तत्रैव समचिन्तयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015807, "chapter_id": 1332, "verse_number": "२-७३-२९", "content_sanskrit": "अद्यप्रभृति भद्रं वः प्रतिज्ञां मे निबोधत।\nत्रयोदश समास्तात को ममार्थो ऽस्ति जीवतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015808, "chapter_id": 1332, "verse_number": "२-७३-३०", "content_sanskrit": "न प्रवक्ष्यामि परुषं भ्रातॄनन्यांश्च पार्थिवान्।\nस्थितो निदेशे ज्ञातीनां योक्ष्ये तत्सुमुदाहरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015809, "chapter_id": 1332, "verse_number": "२-७३-३१", "content_sanskrit": "एवं मे वर्तमानस्य स्वसुतेऽष्वितरेषु च।\nभेदो न भविता लोके भेदमूलो हि विग्रहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2015810, "chapter_id": 1332, "verse_number": "२-७३-३२", "content_sanskrit": "विग्रहं दूरतो रक्षन्प्रियाण्येव समाचरन्।\nवाच्यतां न गमिष्यामि लोकेषु मनुजर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2015811, "chapter_id": 1332, "verse_number": "२-७३-३३", "content_sanskrit": "भ्रातृर्ज्येष्ठस्य वचनं पाण्डवाः संनिशम्य तत।\nतमेव समवर्तन्त धर्मराजहिते रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2015812, "chapter_id": 1332, "verse_number": "२-७३-३४", "content_sanskrit": "संसत्सु समयं कृत्वा धर्मराड्भ्रातृभिः सह।\nपितॄंस्तर्प्य यथान्यायं देवताश्च विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2015813, "chapter_id": 1332, "verse_number": "२-७३-३५", "content_sanskrit": "कृतमङ्गलकल्यामो भ्रातृभिः पिरवारितः।\nगतेषु क्षत्रियेन्द्रेषु सर्वेषु भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2015814, "chapter_id": 1332, "verse_number": "२-७३-३६", "content_sanskrit": "युधिष्ठिरः सहामात्यः प्रविवेश पुरोत्तमम्।\nदुर्योधनो महाराज शकुनिश्चापि सौबलः।\nसभायां समणीयायां तत्रैवास्ते नराधिप॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2015815, "chapter_id": 1332, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि त्रिसप्ततितमोऽध्यायः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]