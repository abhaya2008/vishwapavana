[{"id": 5000376000, "chapter_id": 9376, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे सप्तत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000376001, "chapter_id": 9376, "verse_number": "५-३७-१", "content_sanskrit": "सा सीता वचनं श्रुत्वा पूर्णचन्द्रनिभानना।\nहनूमन्तमुवाचेदं धर्मार्थसहितं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000376002, "chapter_id": 9376, "verse_number": "५-३७-२", "content_sanskrit": "अमृतं विषसम्पृक्तं त्वया वानर भाषितम्।\nयच्च नान्यमना रामो यच्च शोकपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000376003, "chapter_id": 9376, "verse_number": "५-३७-३", "content_sanskrit": "ऐश्वर्ये वा सुविस्तीर्णे व्यसने वा सुदारुणे।\nरज्ज्वेव पुरुषं बद्‍ध्वा कृतान्तः परिकर्षति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000376004, "chapter_id": 9376, "verse_number": "५-३७-४", "content_sanskrit": "विधिर्नूनमसंहार्यः प्राणिनां प्लवगोत्तम।\nसौमित्रं मां च रामं च व्यसनैः पश्य मोहितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000376005, "chapter_id": 9376, "verse_number": "५-३७-५", "content_sanskrit": "शोकस्यास्य कथं पारं राघवोऽधिगमिष्यति।\nप्लवमानः परिक्रान्तो हतनौः सागरे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000376006, "chapter_id": 9376, "verse_number": "५-३७-६", "content_sanskrit": "राक्षसानां वधं कृत्वा सूदयित्वा च रावणम्।\nलङ्कामुन्मथितां कृत्वा कदा द्रक्ष्यति मां पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000376007, "chapter_id": 9376, "verse_number": "५-३७-७", "content_sanskrit": "स वाच्यः संत्वरस्वेति यावदेव न पूर्यते।\nअयं संवत्सरः कालस्तावद्धि मम जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000376008, "chapter_id": 9376, "verse_number": "५-३७-८", "content_sanskrit": "वर्तते दशमो मासो द्वौ तु शेषौ प्लवङ्गम।\nरावणेन नृशंसेन समयो यः कृतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000376009, "chapter_id": 9376, "verse_number": "५-३७-९", "content_sanskrit": "विभीषणेन च भ्रात्रा मम निर्यातनं प्रति।\nअनुनीतः प्रयत्नेन न च तत् कुरुते मतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000376010, "chapter_id": 9376, "verse_number": "५-३७-१०", "content_sanskrit": "मम प्रतिप्रदानं हि रावणस्य न रोचते।\nरावणं मार्गते संख्ये मृत्युः कालवशंगतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000376011, "chapter_id": 9376, "verse_number": "५-३७-११", "content_sanskrit": "ज्येष्ठा कन्या कला नाम विभीषणसुता कपे।\nतया ममैतदाख्यातं मात्रा प्रहितया स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000376012, "chapter_id": 9376, "verse_number": "५-३७-१२", "content_sanskrit": "अविन्ध्यो नाम मेधावी विद्वान् राक्षसपुङ्गवः।\nधृतिमाञ्छीलवान् वृद्धो रावणस्य सुसम्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000376013, "chapter_id": 9376, "verse_number": "५-३७-१३", "content_sanskrit": "रामात् क्षयमनुप्राप्तं रक्षसां प्रत्यचोदयत्।\nन च तस्य स दुष्टात्मा शृणोति वचनं हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000376014, "chapter_id": 9376, "verse_number": "५-३७-१४", "content_sanskrit": "आशंसेयं हरिश्रेष्ठ क्षिप्रं मां प्राप्स्यते पतिः।\nअन्तरात्मा हि मे शुद्धस्तस्मिंश्च बहवो गुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000376015, "chapter_id": 9376, "verse_number": "५-३७-१५", "content_sanskrit": "उत्साहः पौरुषं सत्त्वमानृशंस्यं कृतज्ञता।\nविक्रमश्च प्रभावश्च सन्ति वानर राघवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000376016, "chapter_id": 9376, "verse_number": "५-३७-१६", "content_sanskrit": "चतुर्दश सहस्राणि राक्षसानां जघान यः।\nजनस्थाने विना भ्रात्रा शत्रुः कस्तस्य नोद्विजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000376017, "chapter_id": 9376, "verse_number": "५-३७-१७", "content_sanskrit": "न स शक्यस्तुलयितुं व्यसनैः पुरुषर्षभः।\nअहं तस्यानुभावज्ञा शक्रस्येव पुलोमजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000376018, "chapter_id": 9376, "verse_number": "५-३७-१८", "content_sanskrit": "शरजालांशुमान् शूरः कपे रामदिवाकरः।\nशत्रुरक्षोमयं तोयमुपशोषं नयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000376019, "chapter_id": 9376, "verse_number": "५-३७-१९", "content_sanskrit": "इति संजल्पमानां तां रामार्थे शोककर्शिताम्।\nअश्रुसम्पूर्णवदनामुवाच हनुमान् कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000376020, "chapter_id": 9376, "verse_number": "५-३७-२०", "content_sanskrit": "श्रुत्वैव च वचो मह्यं क्षिप्रमेष्यति राघवः।\nचमूं प्रकर्षन् महतीं हर्यृक्षगणसंकुलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000376021, "chapter_id": 9376, "verse_number": "५-३७-२१", "content_sanskrit": "अथवा मोचयिष्यामि त्वामद्यैव सराक्षसात्।\nअस्माद् दुःखादुपारोह मम पृष्ठमनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000376022, "chapter_id": 9376, "verse_number": "५-३७-२२", "content_sanskrit": "त्वां तु पृष्ठगतां कृत्वा संतरिष्यामि सागरम्।\nशक्तिरस्ति हि मे वोढुं लङ्कामपि सरावणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000376023, "chapter_id": 9376, "verse_number": "५-३७-२३", "content_sanskrit": "अहं प्रस्रवणस्थाय राघवायाद्य मैथिलि।\nप्रापयिष्यामि शक्राय हव्यं हुतमिवानलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000376024, "chapter_id": 9376, "verse_number": "५-३७-२४", "content_sanskrit": "द्रक्ष्यस्यद्यैव वैदेहि राघवं सहलक्ष्मणम्।\nव्यवसायसमायुक्तं विष्णुं दैत्यवधे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000376025, "chapter_id": 9376, "verse_number": "५-३७-२५", "content_sanskrit": "त्वद्दर्शनकृतोत्साहमाश्रमस्थं महाबलम्।\nपुरंदरमिवासीनं नगराजस्य मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000376026, "chapter_id": 9376, "verse_number": "५-३७-२६", "content_sanskrit": "पृष्ठमारोह मे देवि मा विकाङ्क्षस्व शोभने।\nयोगमन्विच्छ रामेण शशाङ्केनेव रोहिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000376027, "chapter_id": 9376, "verse_number": "५-३७-२७", "content_sanskrit": "कथयन्तीव शशिना संगमिष्यसि रोहिणी।\nमत्पृष्ठमधिरोह त्वं तराकाशं महार्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000376028, "chapter_id": 9376, "verse_number": "५-३७-२८", "content_sanskrit": "नहि मे सम्प्रयातस्य त्वामितो नयतोऽङ्गने।\nअनुगन्तुं गतिं शक्ताः सर्वे लङ्कानिवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000376029, "chapter_id": 9376, "verse_number": "५-३७-२९", "content_sanskrit": "यथैवाहमिह प्राप्तस्तथैवाहमसंशयम्।\nयास्यामि पश्य वैदेहि त्वामुद्यम्य विहायसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000376030, "chapter_id": 9376, "verse_number": "५-३७-३०", "content_sanskrit": "मैथिली तु हरिश्रेष्ठाच्छ्रुत्वा वचनमद्भुतम्।\nहर्षविस्मितसर्वाङ्गी हनूमन्तमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000376031, "chapter_id": 9376, "verse_number": "५-३७-३१", "content_sanskrit": "हनूमन् दूरमध्वानं कथं मां नेतुमिच्छसि।\nतदेव खलु ते मन्ये कपित्वं हरियूथप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000376032, "chapter_id": 9376, "verse_number": "५-३७-३२", "content_sanskrit": "कथं चाल्पशरीरस्त्वं मामितो नेतुमिच्छसि।\nसकाशं मानवेन्द्रस्य भर्तुर्मे प्लवगर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000376033, "chapter_id": 9376, "verse_number": "५-३७-३३", "content_sanskrit": "सीतायास्तु वचः श्रुत्वा हनूमान् मारुतात्मजः।\nचिन्तयामास लक्ष्मीवान् नवं परिभवं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000376034, "chapter_id": 9376, "verse_number": "५-३७-३४", "content_sanskrit": "न मे जानाति सत्त्वं वा प्रभावं वासितेक्षणा।\nतस्मात् पश्यतु वैदेही यद् रूपं मम कामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000376035, "chapter_id": 9376, "verse_number": "५-३७-३५", "content_sanskrit": "इति संचिन्त्य हनुमांस्तदा प्लवगसत्तमः।\nदर्शयामास सीतायाः स्वरूपमरिमर्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000376036, "chapter_id": 9376, "verse_number": "५-३७-३६", "content_sanskrit": "स तस्मात् पादपाद् धीमानाप्लुत्य प्लवगर्षभः।\nततो वर्धितुमारेभे सीताप्रत्ययकारणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000376037, "chapter_id": 9376, "verse_number": "५-३७-३७", "content_sanskrit": "मेरुमन्दरसंकाशो बभौ दीप्तानलप्रभः।\nअग्रतो व्यवतस्थे च सीताया वानरर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000376038, "chapter_id": 9376, "verse_number": "५-३७-३८", "content_sanskrit": "हरिः पर्वतसंकाशस्ताम्रवक्त्रो महाबलः।\nवज्रदंष्ट्रनखो भीमो वैदेहीमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000376039, "chapter_id": 9376, "verse_number": "५-३७-३९", "content_sanskrit": "सपर्वतवनोद्देशां साट्टप्राकारतोरणाम्।\nलङ्कामिमां सनाथां वा नयितुं शक्तिरस्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000376040, "chapter_id": 9376, "verse_number": "५-३७-४०", "content_sanskrit": "तदवस्थाप्यतां बुद्धिरलं देवि विकाङ्क्षया।\nविशोकं कुरु वैदेहि राघवं सहलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000376041, "chapter_id": 9376, "verse_number": "५-३७-४१", "content_sanskrit": "तं दृष्ट्वाचलसंकाशमुवाच जनकात्मजा।\nपद्मपत्रविशालाक्षी मारुतस्यौरसं सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000376042, "chapter_id": 9376, "verse_number": "५-३७-४२", "content_sanskrit": "तव सत्त्वं बलं चैव विजानामि महाकपे।\nवायोरिव गतिश्चापि तेजश्चाग्नेरिवाद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000376043, "chapter_id": 9376, "verse_number": "५-३७-४३", "content_sanskrit": "प्राकृतोऽन्यः कथं चेमां भूमिमागन्तुमर्हति।\nउदधेरप्रमेयस्य पारं वानरयूथप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000376044, "chapter_id": 9376, "verse_number": "५-३७-४४", "content_sanskrit": "जानामि गमने शक्तिं नयने चापि ते मम।\nअवश्यं सम्प्रधार्याशु कार्यसिद्धिरिवात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000376045, "chapter_id": 9376, "verse_number": "५-३७-४५", "content_sanskrit": "अयुक्तं तु कपिश्रेष्ठ मया गन्तुं त्वया सह।\nवायुवेगसवेगस्य वेगो मां मोहयेत् तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000376046, "chapter_id": 9376, "verse_number": "५-३७-४६", "content_sanskrit": "अहमाकाशमासक्ता उपर्युपरि सागरम्।\nप्रपतेयं हि ते पृष्ठाद् भूयो वेगेन गच्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000376047, "chapter_id": 9376, "verse_number": "५-३७-४७", "content_sanskrit": "पतिता सागरे चाहं तिमिनक्रझषाकुले।\nभवेयमाशु विवशा यादसामन्नमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000376048, "chapter_id": 9376, "verse_number": "५-३७-४८", "content_sanskrit": "न च शक्ष्ये त्वया सार्धं गन्तुं शत्रुविनाशन।\nकलत्रवति संदेहस्त्वयि स्यादप्यसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000376049, "chapter_id": 9376, "verse_number": "५-३७-४९", "content_sanskrit": "ह्रियमाणां तु मां दृष्ट्वा राक्षसा भीमविक्रमाः।\nअनुगच्छेयुरादिष्टा रावणेन दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000376050, "chapter_id": 9376, "verse_number": "५-३७-५०", "content_sanskrit": "तैस्त्वं परिवृतः शूरैः शूलमुद‍्गरपाणिभिः।\nभवेस्त्वं संशयं प्राप्तो मया वीर कलत्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000376051, "chapter_id": 9376, "verse_number": "५-३७-५१", "content_sanskrit": "सायुधा बहवो व्योम्नि राक्षसास्त्वं निरायुधः।\nकथं शक्ष्यसि संयातुं मां चैव परिरक्षितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000376052, "chapter_id": 9376, "verse_number": "५-३७-५२", "content_sanskrit": "युध्यमानस्य रक्षोभिस्ततस्तैः क्रूरकर्मभिः।\nप्रपतेयं हि ते पृष्ठाद् भयार्ता कपिसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000376053, "chapter_id": 9376, "verse_number": "५-३७-५३", "content_sanskrit": "अथ रक्षांसि भीमानि महान्ति बलवन्ति च।\nकथंचित् साम्पराये त्वां जयेयुः कपिसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000376054, "chapter_id": 9376, "verse_number": "५-३७-५४", "content_sanskrit": "अथवा युध्यमानस्य पतेयं विमुखस्य ते।\nपतितां च गृहीत्वा मां नयेयुः पापराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000376055, "chapter_id": 9376, "verse_number": "५-३७-५५", "content_sanskrit": "मां वा हरेयुस्त्वद्धस्ताद् विशसेयुरथापि वा।\nअनवस्थौ हि दृश्येते युद्धे जयपराजयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000376056, "chapter_id": 9376, "verse_number": "५-३७-५६", "content_sanskrit": "अहं वापि विपद्येयं रक्षोभिरभितर्जिता।\nत्वत्प्रयत्नो हरिश्रेष्ठ भवेन्निष्फल एव तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000376057, "chapter_id": 9376, "verse_number": "५-३७-५७", "content_sanskrit": "कामं त्वमपि पर्याप्तो निहन्तुं सर्वराक्षसान्।\nराघवस्य यशो हीयेत् त्वया शस्तैस्तु राक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000376058, "chapter_id": 9376, "verse_number": "५-३७-५८", "content_sanskrit": "अथवाऽऽदाय रक्षांसि न्यसेयुः संवृते हि माम्।\nयत्र ते नाभिजानीयुर्हरयो नापि राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000376059, "chapter_id": 9376, "verse_number": "५-३७-५९", "content_sanskrit": "आरम्भस्तु मदर्थोऽयं ततस्तव निरर्थकः।\nत्वया हि सह रामस्य महानागमने गुणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000376060, "chapter_id": 9376, "verse_number": "५-३७-६०", "content_sanskrit": "मयि जीवितमायत्तं राघवस्यामितौजसः।\nभ्रातॄणां च महाबाहो तव राजकुलस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000376061, "chapter_id": 9376, "verse_number": "५-३७-६१", "content_sanskrit": "तौ निराशौ मदर्थं च शोकसंतापकर्शितौ।\nसह सर्वर्क्षहरिभिस्त्यक्ष्यतः प्राणसंग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000376062, "chapter_id": 9376, "verse_number": "५-३७-६२", "content_sanskrit": "भर्तुर्भक्तिं पुरस्कृत्य रामादन्यस्य वानर।\nनाहं स्प्रष्टुं स्वतो गात्रमिच्छेयं वानरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000376063, "chapter_id": 9376, "verse_number": "५-३७-६३", "content_sanskrit": "यदहं गात्रसंस्पर्शं रावणस्य गता बलात्।\nअनीशा किं करिष्यामि विनाथा विवशा सती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000376064, "chapter_id": 9376, "verse_number": "५-३७-६४", "content_sanskrit": "यदि रामो दशग्रीवमिह हत्वा सराक्षसम्।\nमामितो गृह्य गच्छेत तत् तस्य सदृशं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000376065, "chapter_id": 9376, "verse_number": "५-३७-६५", "content_sanskrit": "श्रुताश्च दृष्टा हि मया पराक्रमा\nमहात्मनस्तस्य रणावमर्दिनः।\nन देवगन्धर्वभुजङ्गराक्षसा\nभवन्ति रामेण समा हि संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000376066, "chapter_id": 9376, "verse_number": "५-३७-६६", "content_sanskrit": "समीक्ष्य तं संयति चित्रकार्मुकं\nमहाबलं वासवतुल्यविक्रमम्।\nसलक्ष्मणं को विषहेत राघवं\nहुताशनं दीप्तमिवानिलेरितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000376067, "chapter_id": 9376, "verse_number": "५-३७-६७", "content_sanskrit": "सलक्ष्मणं राघवमाजिमर्दनं\nदिशागजं मत्तमिव व्यवस्थितम्।\nसहेत को वानरमुख्य संयुगे\nयुगान्तसूर्यप्रतिमं शरार्चिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000376068, "chapter_id": 9376, "verse_number": "५-३७-६८", "content_sanskrit": "स मे कपिश्रेष्ठ सलक्ष्मणं प्रियं\nसयूथपं क्षिप्रमिहोपपादय।\nचिराय रामं प्रति शोककर्शितां\nकुरुष्व मां वानरवीर हर्षिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000376069, "chapter_id": 9376, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे सप्तत्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]