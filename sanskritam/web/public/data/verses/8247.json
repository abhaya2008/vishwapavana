[{"id": 900001667, "chapter_id": 8247, "verse_number": "4.1", "content_sanskrit": "जनको ह वैदेह आसाञ्चक्रे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001668, "chapter_id": 8247, "verse_number": "4.2", "content_sanskrit": "जनको वै वैदेहः कूर्चादुपावसर्पन्नुवाच नमस्तेऽस्तु..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001669, "chapter_id": 8247, "verse_number": "4.3", "content_sanskrit": "जनकं ह वैदेहं याज्ञवल्क्यो जगाम स मेने..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001670, "chapter_id": 8247, "verse_number": "4.4", "content_sanskrit": "स यत्रायमात्मा बल्यं न्येत्य सम्मोहमिव ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001671, "chapter_id": 8247, "verse_number": "4.5", "content_sanskrit": "अथ ह याज्ञवल्क्यस्य द्वे भार्ये बभूवतुः मैत्रेयी च कात्यायनी च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001672, "chapter_id": 8247, "verse_number": "4.6", "content_sanskrit": "अथ वंशः पौतिमाष्यो गौपवनात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]