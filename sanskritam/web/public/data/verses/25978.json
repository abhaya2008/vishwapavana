[{"id": 7005978000, "chapter_id": 25978, "verse_number": "१-१६१-१", "content_sanskrit": "धन्वन्तरिरुवाच । उदराणां निदानञ्च वक्ष्ये सुश्रुत तच्छृणु। ।\nरोगाः सर्वेऽपि मन्दाग्नौ सुतरामुदराणि तु ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005978001, "chapter_id": 25978, "verse_number": "१-१६१-२", "content_sanskrit": "अनीर्णामयाश्चाप्यन्ये जायन्ते मलसंचयात् ।\nऊर्ध्वाधो वायवो रुद्ध्वा व्याकुलाविप्रवाहिणी? ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005978002, "chapter_id": 25978, "verse_number": "१-१६१-३", "content_sanskrit": "प्राणानपानान्संदूष्य कुर्युस्तान्मांससन्धिगान्। ।\nआध्माप्य कुक्षिमुदरमष्टधा ते च भेदतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005978003, "chapter_id": 25978, "verse_number": "१-१६१-४", "content_sanskrit": "पृथग्दोषैः समस्तौश्च प्लीहवङ्क्षक्षतोदकै ।\nतेनार्ताः शुष्कताल्वोष्ठाः सर्वपादकरोदराः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005978004, "chapter_id": 25978, "verse_number": "१-१६१-५", "content_sanskrit": "नष्टचेष्टबलाहाराः कृतप्रध्मात्कुक्षयः ।\nपुरुषाः स्युः प्रेतरूपा भाविनस्तस्य लक्षणम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005978005, "chapter_id": 25978, "verse_number": "१-१६१-६", "content_sanskrit": "क्षुन्नाशोऽरुचिवत्सर्वं सविदाहञ्च पच्यते ।\nजीर्णान्नं यो न जानाति सोऽपथ्यं सेवतेनरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005978006, "chapter_id": 25978, "verse_number": "१-१६१-७", "content_sanskrit": "क्षीयते बलमङ्गस्य श्वसित्यल्पोऽविचष्टितः ।\nविषयावृत्तिबुद्धिश्च शोकशोषादयोऽपिच ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005978007, "chapter_id": 25978, "verse_number": "१-१६१-८", "content_sanskrit": "रुग्बस्तिसन्धौ सततं लघ्वल्पभोजनैरप ।\nजराजीर्णो बलभ्रंशो भवेज्जठररोगिणः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005978008, "chapter_id": 25978, "verse_number": "१-१६१-९", "content_sanskrit": "स्वतन्त्रतन्द्रालसता मलसर्गोऽल्पवह्नता ।\nदाहः श्वयथुराध्मानमन्त्रे सलिलसम्भवे ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005978009, "chapter_id": 25978, "verse_number": "१-१६१-१०", "content_sanskrit": "सर्वत्र तोये मरणं शोचनं तत्र नषफलम् ।\nगवाक्षवच्छिराजालैरुदरं गुड्गुडायते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005978010, "chapter_id": 25978, "verse_number": "१-१६१-११", "content_sanskrit": "नाभिमन्त्रश्च विष्टभ्य वेगं कृत्वापरणश्यति ।\nमारुते हृत्कटीनाभिपायुवङ्क्षणवेदनाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005978011, "chapter_id": 25978, "verse_number": "१-१६१-१२", "content_sanskrit": "सशब्दो निः सरेद्वायुर्वहते मूत्रमल्पकम् ।\nनातिमात्रं भवेल्लौल्यं नरस्य विरसं मुखम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005978012, "chapter_id": 25978, "verse_number": "१-१६१-१३", "content_sanskrit": "तत्रवातोदरे शोथः पाणिपान्मुखकुक्षिषु ।\nकुर्क्षिपार्श्वोदरकटीपृष्ठरुक्पर्वभदनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005978013, "chapter_id": 25978, "verse_number": "१-१६१-१४", "content_sanskrit": "शुष्ककासाङ्गमर्दाधोगुरुतामलसंग्रहः ।\nश्यामारुणत्वगादित्वं मुखे च रसवद्धिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005978014, "chapter_id": 25978, "verse_number": "१-१६१-१५", "content_sanskrit": "सतोदभेदमुदरं नीलकृष्णशिराततम् ।\nआध्मातमुदरे शब्दमद्भुतं वा करोति सः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005978015, "chapter_id": 25978, "verse_number": "१-१६१-१६", "content_sanskrit": "वायुश्चात्र सरुक्च्छब्दं विधत्ते सर्वथा गतम ।\nपित्तोदरे ज्वरो मूर्छा दाहित्वं कटुकास्यता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005978016, "chapter_id": 25978, "verse_number": "१-१६१-१७", "content_sanskrit": "भ्रमोतिसारः पीतत्वं त्वगादावुदरं हरित् ।\nपीतताम्रशिरादित्वं सस्वेदं सोष्म दह्यते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005978017, "chapter_id": 25978, "verse_number": "१-१६१-१८", "content_sanskrit": "धूमायते मृदुस्पर्शं क्षैप्रपाकं प्रदूयते ।\nश्लेष्मोदरेषु सदनं स्वेदश्वयथुगौरवम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005978018, "chapter_id": 25978, "verse_number": "१-१६१-१९", "content_sanskrit": "निद्रा क्लेशोऽरुचिः श्वासः काशः शुक्लत्वगादित। ।\nउदरं तिमिरं स्निग्धं शुक्लकृष्णशिरावृतम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005978019, "chapter_id": 25978, "verse_number": "१-१६१-२०", "content_sanskrit": "नीरातिवृद्धौ कठिनं शीतस्पर्शं गुरु स्थिम ।\nत्रिदोषकोपने तैस्तैस्त्रिदोषजीनैतर्मलैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005978020, "chapter_id": 25978, "verse_number": "१-१६१-२१", "content_sanskrit": "सर्वदूषणदुष्टाश्च सरक्ताः सञ्चिता मलाः ।\nकोष्ठं प्राप्य विकुर्वाणाः शोषमूर्छाभ्रमान्वितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005978021, "chapter_id": 25978, "verse_number": "१-१६१-२२", "content_sanskrit": "कुर्युस्त्रिलिङ्गमुदरं शीघ्रपाकं सुदारुणम् ।\nवर्धते तच्च सुतरां शीतवातप्रदर्शने ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005978022, "chapter_id": 25978, "verse_number": "१-१६१-२३", "content_sanskrit": "अत्यशनाच्च संक्षोभाद्यानपानादिचेष्ठितैः ।\nअविहितैश्च पानाद्यैर्वमनव्याधिकर्षणैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005978023, "chapter_id": 25978, "verse_number": "१-१६१-२४", "content_sanskrit": "वामपार्श्वास्थितः प्लीहा त्युतस्थानो विवर्धते ।\nशोणिताद्वा रसादिभ्यो विवृद्धो जनयेद्व्यथाम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005978024, "chapter_id": 25978, "verse_number": "१-१६१-२५", "content_sanskrit": "सोऽष्ठीला चातिकठिनः प्रोन्नतः कूर्मपृष्ठवत्। ।\nक्रमेण वर्धमानश्च कुक्षौ व्याततिमाहरेत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005978025, "chapter_id": 25978, "verse_number": "१-१६१-२६", "content_sanskrit": "श्वासकासपिपासास्यवैरस्याध्मानकज्वरैः ।\nपाण्डुत्वमूर्छाछर्दित्वग्दाहमोहैश्च संयुतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005978026, "chapter_id": 25978, "verse_number": "१-१६१-२७", "content_sanskrit": "अरुणाभं विचित्राभं नीलहारिद्रराजितम् ।\nउदावर्तेन चानाहमोहतृड्द्गहनज्वरैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005978027, "chapter_id": 25978, "verse_number": "१-१६१-२८", "content_sanskrit": "गौरवारुचिकाठिन्यैर्विघातभ्रमसंक्रमात् ।\nप्लीहवद्दक्षिणात्पार्श्वात्कुर्याद्यकृदपि च्युतम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005978028, "chapter_id": 25978, "verse_number": "१-१६१-२९", "content_sanskrit": "पक्वे भूते यकृति च सदा बद्धमलो गुदे ।\nदुर्नामभिरुदावर्तैरन्यैर्वा पीडितो भवेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005978029, "chapter_id": 25978, "verse_number": "१-१६१-३०", "content_sanskrit": "वर्चः पित्तकफान्बद्धान्करोति कुपितोऽनिलः ।\nअपानो जठरे तेन संरुद्धो ज्वररुक्करः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005978030, "chapter_id": 25978, "verse_number": "१-१६१-३१", "content_sanskrit": "काशश्वासोरुसद्गनं शिरोरुङ्नाभिपार्श्वरक ।\nमलासंगोऽरुचिश्छर्दिरुदरे मलमारुतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005978031, "chapter_id": 25978, "verse_number": "१-१६१-३२", "content_sanskrit": "स्थिरनीलारुणशिराजालैरुदरमावृतम् ।\nनाभेरुपरि च प्रायो गोपुच्छाकृति जायते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005978032, "chapter_id": 25978, "verse_number": "१-१६१-३३", "content_sanskrit": "अस्थ्यादिशल्यै रन्यैश्च विद्धे चैवोदरे तथा ।\nपच्यते यकृतादिश्च तच्छिद्रैश्च सरन्बहिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005978033, "chapter_id": 25978, "verse_number": "१-१६१-३४", "content_sanskrit": "आम एव गुदाहेति ततोऽल्पाल्पः शकृद्रसः ।\nस स्याद्विकृतगन्धोऽपि पिच्छिलः पीतलोहितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005978034, "chapter_id": 25978, "verse_number": "१-१६१-३५", "content_sanskrit": "शेषश्चापूर्य जठरं घोरमारभते ततः ।\nवर्धते तदधो नाभेराशु चैति जलात्मताम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005978035, "chapter_id": 25978, "verse_number": "१-१६१-३६", "content_sanskrit": "उद्रिक्ते दोषरूपे च व्याप्ते च श्वासतृटभरमैः ।\nछिद्रोदरमिदं प्राहुः परिस्त्रावीति चापरे ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005978036, "chapter_id": 25978, "verse_number": "१-१६१-३७", "content_sanskrit": "प्रवृत्तस्नेहपानादेः सहसापथ्यसेविनः ।\nअत्यम्बुपानान्मन्दाग्नेः क्षीणस्यातिकृशस्य च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005978037, "chapter_id": 25978, "verse_number": "१-१६१-३८", "content_sanskrit": "रुद्धः स्वमार्गादनिलः कफश्च जलमूर्छितः ।\nवर्धते तु तदेवाम्बु तन्मात्राद्विन्दुराशितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005978038, "chapter_id": 25978, "verse_number": "१-१६१-३९", "content_sanskrit": "तत्कोपादुदरं तृष्णागुदस्नुतिरुजान्वितम। ।\nकाशश्वासारुचियुतं नानावर्णाशिराततम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005978039, "chapter_id": 25978, "verse_number": "१-१६१-४०", "content_sanskrit": "तोयपूर्णान्मृदुस्पर्शात्सदृशक्षोभवेपथु ।\nबकोदरं स्थिरंस्निग्धं नाडीमावृत्य जायते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005978040, "chapter_id": 25978, "verse_number": "१-१६१-४१", "content_sanskrit": "उपेक्षायाञ्च सर्वेषां स्वस्थानां परिचालिताः ।\nपाका द्रवा द्रवीकुर्युः सन्धिस्रोतोमुखान्यपि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005978041, "chapter_id": 25978, "verse_number": "१-१६१-४२", "content_sanskrit": "स्वेदे चैव तु संरुद्धे मूर्छिताश्चानरस्थिताः ।\nतदेवोदरमापूर्य कुर्यादुदरामयम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005978042, "chapter_id": 25978, "verse_number": "१-१६१-४३", "content_sanskrit": "गुरूदरं स्थितं वृत्तमाहतञ्च न शब्दकृत् ।\nहीनबलं तथा घोरं नाड्यां स्पृष्टञ्च सपति ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005978043, "chapter_id": 25978, "verse_number": "१-१६१-४४", "content_sanskrit": "शिरान्तर्धानमुदरे सर्वलक्षणमुच्यत। ।\nवातपित्तकफप्लीहसन्निपातोदकोदरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005978044, "chapter_id": 25978, "verse_number": "१-१६१-४५", "content_sanskrit": "पक्षाच्च जातसलिलं विष्टम्भोपद्रवान्वितम् ।\nजन्मनैवोदरं सर्वं प्रायः कृच्छ्रतमं मतम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]