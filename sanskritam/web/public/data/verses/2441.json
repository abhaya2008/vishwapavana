[{"id": 2068704, "chapter_id": 2441, "verse_number": "९-५९-०x", "content_sanskrit": "सञ्चय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068705, "chapter_id": 2441, "verse_number": "९-५९-१", "content_sanskrit": "समुदीर्णं ततो दृष्ट्वा सङ्ग्रामं कुरुमुख्ययोः।\nअब्रवीदर्जुनस्तत्र वासुदेवं यशस्विनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068706, "chapter_id": 2441, "verse_number": "९-५९-२", "content_sanskrit": "अनयोर्वीरयोर्युद्धे को ज्यायान्भवतो मतः।\nकस्य वा को गुणो ज्यायानेतद्वद जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068707, "chapter_id": 2441, "verse_number": "९-५९-३x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068708, "chapter_id": 2441, "verse_number": "९-५९-३", "content_sanskrit": "उपदेशोऽनयोस्तुल्यो भीमस्तु बलवत्तरः।\nकृती यत्नपरस्त्वेष धार्तराष्ट्रो वृकोदरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068709, "chapter_id": 2441, "verse_number": "९-५९-४", "content_sanskrit": "भीमसेनस्तु धर्मेण युध्यमानो न जेष्यति।\nअन्यायेन तु युध्यन्वै हन्यादेव सुयोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068710, "chapter_id": 2441, "verse_number": "९-५९-५", "content_sanskrit": "मायया निर्जिता देवैरसुरा इति नः श्रुतम्।\nविरोचनस्तु शक्रेण मायया निर्जितः स वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068711, "chapter_id": 2441, "verse_number": "९-५९-६", "content_sanskrit": "मायया चाक्षिपत्तेजो वृत्रस्य बलसूदनः।\nतस्मान्मायामयं वीर आतिष्ठतु वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068712, "chapter_id": 2441, "verse_number": "९-५९-७", "content_sanskrit": "प्रतिज्ञातं च भीमेन द्यूतकाले धनञ्जय।\nऊरू भेत्स्यामि ते सङ्ख्ये गदयेति सुयोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068713, "chapter_id": 2441, "verse_number": "९-५९-८", "content_sanskrit": "सोऽयं प्रतिज्ञां तां चापि पारयत्वरिकर्शनः।\nमायाविनं तु राजानं माययैव निकृन्ततु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068714, "chapter_id": 2441, "verse_number": "९-५९-९", "content_sanskrit": "यद्येष बलमास्थाय न्यायेन प्रहरिष्यति।\nविषमस्थस्ततो राजा भविष्यति युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068715, "chapter_id": 2441, "verse_number": "९-५९-१०", "content_sanskrit": "पुनरेव तु वक्ष्यामि पाण्डवेय निबोध मे।\nधर्मराजापराधेन भयं नः पुनरागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068716, "chapter_id": 2441, "verse_number": "९-५९-११", "content_sanskrit": "कृत्वा हि सुमहत्कर्म हत्वा भीष्ममुखान्कुरून्।\nजयः प्राप्तो यशः प्राग्र्यं वैरं च प्रतियातितम्।\nतदेवं विजयः प्राप्तः पुनः संशयितः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068717, "chapter_id": 2441, "verse_number": "९-५९-१२", "content_sanskrit": "अबुद्धिरेषां महती धर्मराजस्य पाण्डव।\nयदेकविजये वीर पणितं कृतमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068718, "chapter_id": 2441, "verse_number": "९-५९-१३", "content_sanskrit": "सुयोधनः कृती वीर एकायनगतस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068719, "chapter_id": 2441, "verse_number": "९-५९-१४", "content_sanskrit": "अपि चोशनसा गीतः श्रूयतेऽयं पुरातनः।\nश्लोकस्तत्त्वार्थसहितस्तन्मे निगदतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068720, "chapter_id": 2441, "verse_number": "९-५९-१५", "content_sanskrit": "पुनरावर्तमानानां भग्नानां जीवितैषिणाम्।\nभेतव्यमरिशेषाणामेकायनगता हि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068721, "chapter_id": 2441, "verse_number": "९-५९-१६", "content_sanskrit": "[साहसोत्पतितानां च निराशानां च जीविते।\nन शक्यमग्रतः स्थातुं शक्रेणापि धनञ्जय]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068722, "chapter_id": 2441, "verse_number": "९-५९-१७", "content_sanskrit": "सुयोधनमिमं भग्नं हतसैन्यं हदं गतम्।\nपराजितं वनप्रेप्सुं निराशं राज्यलम्भने।\nकोऽन्विष्य संयुगे प्राज्ञः पुनर्द्वन्द्वे समाह्वयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068723, "chapter_id": 2441, "verse_number": "९-५९-१८", "content_sanskrit": "अपि नो निर्जितं राज्यं न हरेत सुयोधनः।\nयस्त्रयोदशवर्षाणि गदया कृतनिश्रमः।\nचरत्यूर्ध्वं च तिर्यक्व भीमसेनिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068724, "chapter_id": 2441, "verse_number": "९-५९-१९", "content_sanskrit": "एनं चेन्न महाबाहुरन्यायेन हनिष्यति।\nएष वः कौरवो राजा धार्तराष्ट्रो भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068725, "chapter_id": 2441, "verse_number": "९-५९-२०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068726, "chapter_id": 2441, "verse_number": "९-५९-२०", "content_sanskrit": "धनञ्जयस्तु श्रुत्वैतत्केशवस्य महात्मनः।\nप्रेक्षतो भीमसेनस्य सव्यमूरुमताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068727, "chapter_id": 2441, "verse_number": "९-५९-२१", "content_sanskrit": "गृह्य संज्ञां ततो भीमो गदया व्यचरद्रणे।\nमण्डलानि विचित्राणि यमकानीतराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068728, "chapter_id": 2441, "verse_number": "९-५९-२२", "content_sanskrit": "दक्षिणं मण्डलं सव्यं गोमूत्रिकमथापि च।\nव्यचरत्पाण्डवो राजन्नरिं सम्मोहयन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068729, "chapter_id": 2441, "verse_number": "९-५९-२३", "content_sanskrit": "तथैव तव पुत्रोऽपि गदामार्गविशारदः।\nव्यचरल्लघु चित्रं च भीमसेनजिघांसया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068730, "chapter_id": 2441, "verse_number": "९-५९-२४", "content_sanskrit": "आधुन्वन्तौ गदे घोरे चन्दनागरुरूषिते।\nवैरस्यान्तं परीप्सन्तौ रणे क्रुद्धाविवान्तकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068731, "chapter_id": 2441, "verse_number": "९-५९-२५", "content_sanskrit": "अन्योन्यं तौ जिघांसन्तौ प्रवीरौ पुरुषर्षभौ।\nयुयुधाते गरुत्मन्तौ यथा नागामिषैषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068732, "chapter_id": 2441, "verse_number": "९-५९-२६", "content_sanskrit": "मण्डलानि बिचित्राणि चरतोर्नृपभीमयोः।\nगदासम्पातजास्तत्र प्रजज्ञुः पावकार्चिषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068733, "chapter_id": 2441, "verse_number": "९-५९-२७", "content_sanskrit": "समं प्रहरतोस्तत्र शूरयोर्बलिनोर्मृधे।\nक्षुब्धयोर्वायुना राजन्द्वयोरिव समुद्रयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068734, "chapter_id": 2441, "verse_number": "९-५९-२८", "content_sanskrit": "तयोः प्रहरतोस्तुल्यं मत्तकुञ्जरयोरिव।\nगदानिर्घातसं हादः प्रहाराणामजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068735, "chapter_id": 2441, "verse_number": "९-५९-२९", "content_sanskrit": "तस्मिंस्तदा सम्प्रहारे दारुणे सङ्कुले भृशम्।\nउभावपि परिश्रान्तौ युध्यमानावरिन्दमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068736, "chapter_id": 2441, "verse_number": "९-५९-३०", "content_sanskrit": "तौ मुहूर्ते समाश्वस्य पुनरेव परन्तप।\nअभ्यहारयतां क्रुद्धौ प्रगृह्य महती गदे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068737, "chapter_id": 2441, "verse_number": "९-५९-३१", "content_sanskrit": "तयोः समभवद्युद्धं घोररूपमसंवृतम्।\nगदानिपातै राजेन्द्र तक्षतोर्वै परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2068738, "chapter_id": 2441, "verse_number": "९-५९-३२", "content_sanskrit": "समरे प्रद्रुतौ तौ तु वृषभाक्षौ तरस्विनौ।\nअन्योन्यं जघ्नतुर्वीरौ पङ्कस्थौ महिषाविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2068739, "chapter_id": 2441, "verse_number": "९-५९-३३", "content_sanskrit": "जर्झरीकृतसर्वाङ्गौ रुधिरेणाभिसंप्लुतौ।\nददृशाते हिमवति पुष्पिताविव किंशुकौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2068740, "chapter_id": 2441, "verse_number": "९-५९-३४", "content_sanskrit": "दुर्योधनस्तु पार्थेन विवरे सम्प्रदर्शिते।\nईषदुत्स्मयमानस्तु सहसा प्रससार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2068741, "chapter_id": 2441, "verse_number": "९-५९-३५", "content_sanskrit": "तमभ्याशगतं प्राज्ञः क्षणे प्रेक्ष्य वृकोदरः।\nअवाक्षिपद्गदां तस्मिन्वेगेन महता बती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2068742, "chapter_id": 2441, "verse_number": "९-५९-३६", "content_sanskrit": "अवक्षेपं तु तं दृष्ट्वा पुत्रस्तव विशाम्पते।\nअपासर्पत्ततः स्थानात्सा मोघा न्यपतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2068743, "chapter_id": 2441, "verse_number": "९-५९-३७", "content_sanskrit": "मोक्षयित्वा प्रहारं तं सुतस्तव सुसम्भ्रमात्।\nभीमसेनं च गदया प्राहरत्कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2068744, "chapter_id": 2441, "verse_number": "९-५९-३८", "content_sanskrit": "तस्य विस्यन्दमानेन रुधिरेणामितौजसः।\nप्रहारगुरुपाताच मूर्छेव समजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2068745, "chapter_id": 2441, "verse_number": "९-५९-३९", "content_sanskrit": "तन्नावुध्यत पुत्रस्ते पीडितं पाण्डवं रणे।\nधारयामास भीमोऽपि शरीरमतिपीडितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2068746, "chapter_id": 2441, "verse_number": "९-५९-४०", "content_sanskrit": "अमन्यत स्थितं ह्येनं प्रहरिष्यन्तमाहवे।\nअतो न प्राहरत्तस्मै पुनरेव तवात्मजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2068747, "chapter_id": 2441, "verse_number": "९-५९-४१", "content_sanskrit": "ततो मुहूर्तनाश्वस्य दुर्योधनमुपस्थितम्।\nदेगेनाभ्ययतद्राजन्गदामादाय पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2068748, "chapter_id": 2441, "verse_number": "९-५९-४२", "content_sanskrit": "तमापतन्तं सम्प्रेक्ष्य संरब्धगमितौजसम्।\nमोधमस्य प्रहारं तं चिकीर्षुर्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2068749, "chapter_id": 2441, "verse_number": "९-५९-४३", "content_sanskrit": "अवस्याने मतिं कृत्वा पुत्रन्तव महामनाः।\nइयेषोत्पतितुं राजञ्छलयिष्यन्वृकोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2068750, "chapter_id": 2441, "verse_number": "९-५९-४४", "content_sanskrit": "अबुध्यद्भीमसेनस्तु राज्ञस्तस्य चिकीर्षितम्।\nअचास्य सममिद्रुत्य समुत्पत्य च सिंहवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2068751, "chapter_id": 2441, "verse_number": "९-५९-४५", "content_sanskrit": "सत्या वञ्चवतो राजन्पुनरेवोत्पतिष्यतः।\nऊरुभ्यां प्राहिणोद्राजन्गदां वेगेन पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2068752, "chapter_id": 2441, "verse_number": "९-५९-४६", "content_sanskrit": "सा वज्रनिष्पेषसमा प्रहिता भीमकर्मणा।\nऊरू दुर्योधनस्याथ बभञ्ज प्रियदर्शनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2068753, "chapter_id": 2441, "verse_number": "९-५९-४७", "content_sanskrit": "स पपात नरव्याघ्रो वसुधामनुनादयन्।\nभग्नोरुर्भीमसेनेन पुत्रस्तव महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2068754, "chapter_id": 2441, "verse_number": "९-५९-४८", "content_sanskrit": "ववुर्वाताः सनिर्घाताः पांसुवर्षं पपात च।\nचचाल पृथिवी चापि सवृक्षक्षुपपर्वता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2068755, "chapter_id": 2441, "verse_number": "९-५९-४९", "content_sanskrit": "तस्मिन्निपतिते वीरे पत्यौ सर्वमहीक्षिताम्।\nमहास्वना पुनर्दीप्ता सनिर्घाता भयङ्करी।\nपपात चोल्का महती पतिते पृथिवीपतौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2068756, "chapter_id": 2441, "verse_number": "९-५९-५०", "content_sanskrit": "तथा शोणितवर्षं च पांसुवर्षं च भारत।\nववर्ष मघवांस्तत्र तव पुत्रे निपातिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2068757, "chapter_id": 2441, "verse_number": "९-५९-५१", "content_sanskrit": "यक्षाणां राक्षसानां च पिशाचानां तथैव च।\nअन्तरिक्षे महान्नादस्तत्र भारत शुश्रुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2068758, "chapter_id": 2441, "verse_number": "९-५९-५२", "content_sanskrit": "तेन शब्देन घोरेण मृगाणामथ पक्षिणाम्।\nजज्ञे घोरतरः शब्दो बहूनां सर्वतोदिशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2068759, "chapter_id": 2441, "verse_number": "९-५९-५३", "content_sanskrit": "ये तत्र वाजिनः शेषा गजाश्च मनुजैः सह।\nमुमुचुस्ते महानादं तव पुत्रे निपातिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2068760, "chapter_id": 2441, "verse_number": "९-५९-५४", "content_sanskrit": "बेरीशङ्खमृदङ्गानामभवच्च स्वनो महान्।\nअन्तर्भूमिगतश्चैव तव पुत्रे निपातिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2068761, "chapter_id": 2441, "verse_number": "९-५९-५५", "content_sanskrit": "[बहुपादैर्बहुभुजैः कबन्धैर्घोरदर्शनैः।\nनृत्यद्भिर्भयदैर्व्याप्ता दिशस्तत्राभवन्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2068762, "chapter_id": 2441, "verse_number": "९-५९-५६", "content_sanskrit": "ध्वजवन्तोऽस्त्रवन्तश्च शस्त्रवन्तस्तथैव च।\nप्राकम्पन्त ततो राजंस्तव पुत्रे निपातिते]॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2068763, "chapter_id": 2441, "verse_number": "९-५९-५७", "content_sanskrit": "हदाः कूपाश्च रुधिरमुद्वेमुर्नृपसत्तम।\nनद्यश्च सुमहावेगाः प्रतिस्रोतोवहाऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2068764, "chapter_id": 2441, "verse_number": "९-५९-५८", "content_sanskrit": "पुल्लिङ्गा इव नार्यस्तु स्त्रीलिङ्गाः पुरुषाऽभवन्।\nदुर्योधने तदा राजन्पतिते तनये तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2068765, "chapter_id": 2441, "verse_number": "९-५९-५९", "content_sanskrit": "दृष्ट्वा तानद्भुतोत्पातान्पाञ्चालाः पाण्डवैः सह।\nआविग्नमनसः सर्वे बभूवुर्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2068766, "chapter_id": 2441, "verse_number": "९-५९-६०", "content_sanskrit": "ययुर्देवा यथाकामं गन्धर्वाप्सरसस्तथा।\nकथयन्तोऽद्भुतं युद्धं सुतयोस्तव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2068767, "chapter_id": 2441, "verse_number": "९-५९-६१", "content_sanskrit": "तथैव सिद्धा राजेन्द्र तथा वातिकचारणाः।\nनरसिंहौ प्रशंसन्तौ विप्रजग्मुर्यथागतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2068768, "chapter_id": 2441, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि गदायुद्धपर्वणि एकोनषष्टितमोऽध्यायः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]