[{"id": 2042179, "chapter_id": 1939, "verse_number": "५-१८४-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2042180, "chapter_id": 1939, "verse_number": "५-१८४-१", "content_sanskrit": "ततो रात्रौ व्यतीतायां प्रतिबुद्धोऽस्मि भारत ।\nततः संचिन्त्य वै स्वप्नमवापं हर्षमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2042181, "chapter_id": 1939, "verse_number": "५-१८४-२", "content_sanskrit": "ततः समभवद्युद्धं मम तस्य च भारत ।\nतुमुलं सर्वभूतानां रोमहर्षणमद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2042182, "chapter_id": 1939, "verse_number": "५-१८४-३", "content_sanskrit": "ततो बाणमयं वर्षं ववर्ष मयि भार्गवः।\nन्यवारयमहं तच्च शरजालेन भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2042183, "chapter_id": 1939, "verse_number": "५-१८४-४", "content_sanskrit": "ततः परमसंक्रुद्धः पुनरेव महातपाः ।\nह्यस्तनेन च कोपेन शक्तिं वै प्राहिणोन्मयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2042184, "chapter_id": 1939, "verse_number": "५-१८४-५", "content_sanskrit": "इन्द्राशनिसमस्पर्शां यमदण्डसमप्रभाम् ।\nज्वलन्तीमग्निवत्सङ्ख्ये लेलिहानां समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2042185, "chapter_id": 1939, "verse_number": "५-१८४-६", "content_sanskrit": "ततो भरतशार्दूल धिष्ण्यमाकाशगं यथा।\nसा ममाभ्यवधीत्तूर्णं जत्रुदेशे कुरूद्वह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2042186, "chapter_id": 1939, "verse_number": "५-१८४-७", "content_sanskrit": "अथास्रमस्रवद्धोरं गिरेर्गैरिकधातुवात् ।\nरामेण सुमहाबाहो क्षतस्य क्षतजेक्षण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2042187, "chapter_id": 1939, "verse_number": "५-१८४-८", "content_sanskrit": "ततोऽहं जामदग्न्याय भृशं क्रोधसमन्वितः ।\nचिक्षेप मृत्युसंकाशं बाणं सर्पविषोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2042188, "chapter_id": 1939, "verse_number": "५-१८४-९", "content_sanskrit": "स तेनाभिहतो वीरो ललाटे द्विजसत्तमः ।\nअशोभत महाराज शश्रृङ्ग इव पर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2042189, "chapter_id": 1939, "verse_number": "५-१८४-१०", "content_sanskrit": "स संरब्धः समावृत्य शरं कालान्तकोपमम् ।\nसंदधे बलवत्कृष्य घोरं शत्रनिबर्हणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2042190, "chapter_id": 1939, "verse_number": "५-१८४-११", "content_sanskrit": "स वक्षसि पापतोग्रः शरो व्याल इव श्वसन् ।\nमहीं राजंस्ततश्चाहमगमं रुधिराविलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2042191, "chapter_id": 1939, "verse_number": "५-१८४-१२", "content_sanskrit": "संप्राप्य तु पुनः संज्ञां जामदघ्न्याय धीमते ।\nप्राहिण्वं विमलां शक्तिं ज्वलन्तीमशनीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2042192, "chapter_id": 1939, "verse_number": "५-१८४-१३", "content_sanskrit": "सा तस्य द्विजमुख्यस्य निपपात भुजान्तरे ।\nविह्वलश्चाभवद्राजन्वेपथुश्चैनमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2042193, "chapter_id": 1939, "verse_number": "५-१८४-१४", "content_sanskrit": "तत एनं परिष्वज्य सखा विप्रो महातपाः ।\nअकृतव्रणः शुभैर्वाक्यैराश्वासयदनेकधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2042194, "chapter_id": 1939, "verse_number": "५-१८४-१५", "content_sanskrit": "समाश्वस्तस्ततो रामः क्रोधामर्षसमन्वितः ।\nप्रादुश्चक्रे तदा ब्राह्मं परमास्त्रं महाव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2042195, "chapter_id": 1939, "verse_number": "५-१८४-१६", "content_sanskrit": "ततस्तत्प्रतिघातार्थं ब्राह्ममेवास्त्रमुत्तमम् ।\nमया प्रयुक्तं जज्वाल युगान्तमिव दर्शयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2042196, "chapter_id": 1939, "verse_number": "५-१८४-१७", "content_sanskrit": "तयोर्ब्रह्मास्त्रयोरासीदन्तरा वै समागमः ।\nअसंप्राप्यैव रामं च मां च भारतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2042197, "chapter_id": 1939, "verse_number": "५-१८४-१८", "content_sanskrit": "ततो व्योम्नि प्रादुरभूत्तेज एव हि केवलम् ।\nभूतानि चैव सर्वाणि जग्मुरार्तिं विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2042198, "chapter_id": 1939, "verse_number": "५-१८४-१९", "content_sanskrit": "ऋषयश्च सगन्धर्वा देवताश्चैव भारत।\nसंतापं परमं जग्मुरस्त्रतेजोभिपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2042199, "chapter_id": 1939, "verse_number": "५-१८४-२०", "content_sanskrit": "ततश्चचाल पृथिवी सपर्वतवनद्रुमा।\nसंतप्तानि च भूतानि विषादंक जग्मुरुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2042200, "chapter_id": 1939, "verse_number": "५-१८४-२१", "content_sanskrit": "प्रजज्वाल नभो राजन्धूमायन्ते दिशो दश।\nन स्थातुमन्तरिक्षे च शेकुराकाशगास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2042201, "chapter_id": 1939, "verse_number": "५-१८४-२२", "content_sanskrit": "ततो हाहाकृते लोके सदेवासुरराक्षसे ।\nइदमन्तरमित्येवं मोक्तुकामोऽस्मि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2042202, "chapter_id": 1939, "verse_number": "५-१८४-२३", "content_sanskrit": "प्रस्वापमस्त्रं त्वरितो वचनाद्ब्रह्मवादिनाम् ।\nचिन्तितं च तदस्त्रं मे मनसि प्रत्यभात्तदा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2042203, "chapter_id": 1939, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि अम्बोपाख्यानपर्वणि चतुरशीत्यधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]