[{"id": 2028689, "chapter_id": 1624, "verse_number": "३-२६२-०x", "content_sanskrit": "देवदूत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028690, "chapter_id": 1624, "verse_number": "३-२६२-१", "content_sanskrit": "महर्षेऽकार्यबुद्धिस्त्वं यः स्वर्गसुखमुत्तमम्।\nसंप्राप्तं प्रतिपत्तव्यं विमृशस्यबुधो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028691, "chapter_id": 1624, "verse_number": "३-२६२-२", "content_sanskrit": "उपरिष्टादयं लोको योऽयं स्वरिति संज्ञितः।\nऊर्ध्वगः सत्पथः शश्वद्देवयानचरो मुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028692, "chapter_id": 1624, "verse_number": "३-२६२-३", "content_sanskrit": "नातप्ततपसः पुंसो नामहायज्ञयाजिनः।\nनानृता नास्तिकाश्चैव तत्रगच्छन्ति मुद्गल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028693, "chapter_id": 1624, "verse_number": "३-२६२-४", "content_sanskrit": "धर्मात्मानो जितात्मानः शान्ता दान्ता विमत्सराः।\nदानधर्मरताः पुंसः शूराश्चाहितलक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028694, "chapter_id": 1624, "verse_number": "३-२६२-५", "content_sanskrit": "तत्रगच्छन्ति धर्माग्र्यं कृत्वा शमदमात्मकम्।\nलोकान्पुण्यकृतां ब्रह्मन्सद्भिराचरितान्नृभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028695, "chapter_id": 1624, "verse_number": "३-२६२-६", "content_sanskrit": "देवाः साध्यास्तथा विश्वे तथैव च महर्षयः।\nयामा धामाश्च मौद्गल्य गन्धर्वाप्सरसस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028696, "chapter_id": 1624, "verse_number": "३-२६२-७", "content_sanskrit": "एषां देवनिकायानां पृथक्पृथगनेकशः।\nभास्वन्तः कामसंपन्ना लोकास्तेजोमयाः शुभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028697, "chapter_id": 1624, "verse_number": "३-२६२-८", "content_sanskrit": "त्रयस्त्रिंशत्सहस्राणि योजनानि हिरण्मयः।\nमेरुः पर्वतराड्यत्रदेवोद्यानानि मुद्गल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028698, "chapter_id": 1624, "verse_number": "३-२६२-९", "content_sanskrit": "`नन्दनान्यतिरम्याणि तत्रोद्यानानि मुद्गल।\nसर्वकामफलैर्वृक्षैः शोभितानि समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028699, "chapter_id": 1624, "verse_number": "३-२६२-१०", "content_sanskrit": "नन्दनादीनि पुण्यानि विहाराः पुण्यकर्मणाम्।\nन क्षुत्पिपासे न ग्लानिर्न शीतोष्णे भयं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028700, "chapter_id": 1624, "verse_number": "३-२६२-११", "content_sanskrit": "बीभत्समशुभं वाऽपि रोगो वा तत्र कश्चन।\nमनोज्ञाः सर्वतो गन्धाः सुखस्पर्शाश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028701, "chapter_id": 1624, "verse_number": "३-२६२-१२", "content_sanskrit": "शब्दाः श्रुतिमनोग्राह्याः सर्वतस्तत्रवै मुने।\nन शोको न जरा तत्र नायासपरिदेवने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028702, "chapter_id": 1624, "verse_number": "३-२६२-१३", "content_sanskrit": "ईदृशः स मुने लोकः स्वकर्मफलहेतुकः।\nसुकृतैस्तत्रपुरुषाः संभवन्त्यात्मकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028703, "chapter_id": 1624, "verse_number": "३-२६२-१४", "content_sanskrit": "तैजसानि शरीराणि भवन्त्य्रोपपद्यताम्।\nकर्मजान्येव मौद्गल्य न मातृपितृजान्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028704, "chapter_id": 1624, "verse_number": "३-२६२-१५", "content_sanskrit": "रन संस्वेदो न दौर्गन्ध्यं पुरीषं मूत्रमेव च।\nतेषां न च रजोवस्त्रं बाधते तत्रवै मुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028705, "chapter_id": 1624, "verse_number": "३-२६२-१६", "content_sanskrit": "न म्लायन्ति स्रजस्तेषां दिव्यगन्धा मनोरमाः।\nसमूह्यन्ते विमानैश्च ब्रह्मन्नेवंविधा हि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028706, "chapter_id": 1624, "verse_number": "३-२६२-१७", "content_sanskrit": "ईर्ष्याशोकक्लमापेता मोहमात्सर्यवर्जिताः।\nसुखं संर्गजितस्तत्रवर्तयन्ते महामुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028707, "chapter_id": 1624, "verse_number": "३-२६२-१८", "content_sanskrit": "तेषां तथाविधानां तु लोकानां मुनिपुङ्गव।\nउपर्युपरि शक्रस् लोका दिव्या गुणान्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028708, "chapter_id": 1624, "verse_number": "३-२६२-१९", "content_sanskrit": "परतो ब्रह्मणस्तस्य लोकस्तेजोमयः शुभः।\nयत्र यान्त्यृषयो ब्रह्मन्पूताः स्वैः कर्मभिः शुभैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028709, "chapter_id": 1624, "verse_number": "३-२६२-२०", "content_sanskrit": "ऋभवो नाम तत्रान्ये देवानामपि देवताः।\nतेषां लोकाः परतरे यान्यजन्तीह देवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028710, "chapter_id": 1624, "verse_number": "३-२६२-२१", "content_sanskrit": "स्वयंप्रभास्ते भास्वन्तो लोकाः कामदुघाः परे।\nन तेषां स्त्रीकृतस्तापो न भोगैश्वर्यमत्सरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028711, "chapter_id": 1624, "verse_number": "३-२६२-२२", "content_sanskrit": "न वर्तयन्त्याहुतिभिस्ते नाप्यमृतभोजनाः।\nतथा दिव्यशरीरास्ते न च विग्रहमूर्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028712, "chapter_id": 1624, "verse_number": "३-२६२-२३", "content_sanskrit": "नासुखाः सुखकामास्ते देवदेवाः सनातनाः।\nन कल्पपरिवर्तेषु परिवर्तन्ति ते तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028713, "chapter_id": 1624, "verse_number": "३-२६२-२४", "content_sanskrit": "रजरा मृत्युः कुतस्तेषां हर्षः प्रीतिः सुखं न च।\nन दुःखं न सुखं चापि रागद्वेषौ कुतो मुने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028714, "chapter_id": 1624, "verse_number": "३-२६२-२५", "content_sanskrit": "देवानामपि मौद्गल्यकाङ्क्षिता सा गतिः परा।\nदुष्प्रापा परमा सिद्धिरगम्या कामगोचरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028715, "chapter_id": 1624, "verse_number": "३-२६२-२६", "content_sanskrit": "त्रयस्त्रिंशदिमे लोकाः शेषा लोका मनीषिभिः।\nगम्यन्ते नियमैः श्रेष्ठैर्दानैर्वा विधिपूर्वकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028716, "chapter_id": 1624, "verse_number": "३-२६२-२७", "content_sanskrit": "सेयं दानकृता व्युष्टिरनुप्राप्ता सुखं त्वया।\nतां रभुङ्क्ष्व सुकृतैर्लब्धां तपसा द्योतितप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028717, "chapter_id": 1624, "verse_number": "३-२६२-२८", "content_sanskrit": "एतत्स्वर्गसुखं विप्र लोका नानाविधास्तथा।\nगुणाः स्वर्गस्य प्रोक्तास्ते दोषानपि निबोध मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028718, "chapter_id": 1624, "verse_number": "३-२६२-२९", "content_sanskrit": "कृस्य कर्मणस्तत्रभुज्यते यत्फलं दिवि।\nन चान्त्क्रियते कर्म मूलच्छेदेन भुज्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028719, "chapter_id": 1624, "verse_number": "३-२६२-३०", "content_sanskrit": "सोऽत्रदोषो मम मतस्तस्यान्ते पतनं च यत्।\nसुखव्याप्तमनस्कानां पतनं यच्च मुद्गल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028720, "chapter_id": 1624, "verse_number": "३-२६२-३१", "content_sanskrit": "असंतोषः परीतापो दृष्ट्वा दीप्ततराः श्रियः।\nयद्भवत्यवरे स्थाने स्थितानां तत्सुदुष्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028721, "chapter_id": 1624, "verse_number": "३-२६२-३२", "content_sanskrit": "संज्ञामोहश्चपततां रजसा च प्रधर्षणम्।\nप्रम्लानेषु च माल्येषु ततः पिपतिषोर्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2028722, "chapter_id": 1624, "verse_number": "३-२६२-३३", "content_sanskrit": "आब्रह्मभवनादेते दोषा मौद्गल्य दारुणाः।\nनाकलोकेसुकृतिनां गुणास्त्वयुतशो नृणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2028723, "chapter_id": 1624, "verse_number": "३-२६२-३४", "content_sanskrit": "अयं त्वन्यो गुणः श्रेष्ठश्च्युतानां स्वर्गतो मुने।\nशुभानुशययोगेन मनुष्येषूपजायते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2028724, "chapter_id": 1624, "verse_number": "३-२६२-३५", "content_sanskrit": "तत्रापि स महाभागः कुले महति जायते।\nन चेत्संबुध्यते तत्रगच्छत्यधमतां ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2028725, "chapter_id": 1624, "verse_number": "३-२६२-३६", "content_sanskrit": "इह यत्क्रियते कर्म तत्परत्रोपभुज्यते।\nकर्मभूमिरियं ब्रह्मन्फलभूमिरसौ मता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2028726, "chapter_id": 1624, "verse_number": "३-२६२-३७x", "content_sanskrit": "[मुद्गल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2028727, "chapter_id": 1624, "verse_number": "३-२६२-३७", "content_sanskrit": "महान्तस्तु अमी दोपास्त्वया स्वर्गस्य कीर्तिताः।\nनिर्दोष एव यस्त्यन्यो लोकं तं प्रवदस्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2028728, "chapter_id": 1624, "verse_number": "३-२६२-३८x", "content_sanskrit": "देवदूत उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2028729, "chapter_id": 1624, "verse_number": "३-२६२-३८", "content_sanskrit": "ब्रह्मणः सदनादूर्ध्वं तद्विष्णोः परमं पदम्।\nशुद्धं सनातनं ज्योतिः परं ब्रह्मेति यद्विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2028730, "chapter_id": 1624, "verse_number": "३-२६२-३९", "content_sanskrit": "न तत्रविप्र गच्छन्ति पुरुषा विषयात्मकाः।\nदम्भलोभमहाक्रोधमोहद्रोहैरभिद्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2028731, "chapter_id": 1624, "verse_number": "३-२६२-४०", "content_sanskrit": "निर्ममा निरहंकारा निर्द्विन्द्वाः संयतेन्द्रियाः।\nध्यानयोगपराश्चैव तत्रगच्छन्ति मानवाः ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2028732, "chapter_id": 1624, "verse_number": "३-२६२-४१", "content_sanskrit": "एतत्ते सर्वमाख्यतं यन्मां पृच्छसि मुद्गल।\nतवानुकम्पया साधो साधु गच्छाम माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2028733, "chapter_id": 1624, "verse_number": "३-२६२-४२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2028734, "chapter_id": 1624, "verse_number": "३-२६२-४२", "content_sanskrit": "एतच्छ्रुत्वा तु मौद्गल्यो वाक्यं विममृशे धिया।\nविमृश्य च मुनिश्रेष्ठो देवदूतमुवाचह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2028735, "chapter_id": 1624, "verse_number": "३-२६२-४३", "content_sanskrit": "देवदूत नमस्तेऽम्तु गच्छ तात यथासुखम्।\nमहादोषेण मे कार्यं न स्वर्गेण सुखेन चा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2028736, "chapter_id": 1624, "verse_number": "३-२६२-४४", "content_sanskrit": "पतनान्ते महादुःखं परितापः सुदारुणः।\nस्वर्गभाजः पतन्तीह तस्मात्स्वर्गं न कामये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2028737, "chapter_id": 1624, "verse_number": "३-२६२-४५", "content_sanskrit": "यत्रगत्वान शोचन्ति न व्यथन्तिचलन्ति वा।\nतदहं स्थानमत्यन्तं मार्गयिष्यामि केवलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2028738, "chapter_id": 1624, "verse_number": "३-२६२-४६", "content_sanskrit": "इत्युक्त्वा स मुनिर्वाक्यं देवदूतंविसृज्य तम्।\nशिलोञ्छवृत्तिमुत्सृज्य शममातिष्ठदुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2028739, "chapter_id": 1624, "verse_number": "३-२६२-४७", "content_sanskrit": "तुल्यनिन्दास्तुतिर्भूत्वासमलोष्टाश्मकाञ्चनः।\nज्ञानयोगेन शुद्धेन ध्याननित्यो बभूव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2028740, "chapter_id": 1624, "verse_number": "३-२६२-४८", "content_sanskrit": "`निगृहीतेन्द्रियग्रामः समयोजयदात्मनि।\nयुक्तचित्तं यथाऽऽत्मानं युयोज परमेश्वरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2028741, "chapter_id": 1624, "verse_number": "३-२६२-४९", "content_sanskrit": "ध्यानयोगाद्बलं लब्ध्वा प्राप्य बुद्धिमनुत्तमाम्।\nजगाम शाश्वतीं सिद्धिं परां निर्वाणलक्षणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2028742, "chapter_id": 1624, "verse_number": "३-२६२-५०", "content_sanskrit": "तस्मात्त्वमपिकौन्तेय न शोकं कर्तुमर्हसि।\nराज्यात्स्फीतात्परिभ्रष्टस्तपसा तदवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2028743, "chapter_id": 1624, "verse_number": "३-२६२-५१", "content_sanskrit": "सुखस्यानन्तरं दुःखं दुःखस्यानन्तरं सुखम्।\nपर्यायेणोपसर्पन्ते नरं नेमिमरा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2028744, "chapter_id": 1624, "verse_number": "३-२६२-५२", "content_sanskrit": "पितृपैतामहं राज्यंप्राप्स्यस्यमितविक्रम।\nवर्षात्रयोदशादूर्ध्वंव्येतु ते मानसो ज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2028745, "chapter_id": 1624, "verse_number": "३-२६२-५३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2028746, "chapter_id": 1624, "verse_number": "३-२६२-५३", "content_sanskrit": "स एवमुक्त्वाभगवान्व्यासः पाण्डवनन्दनम्।\nजगाम तपसे धीमान्पुनरेवाश्रमं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2028747, "chapter_id": 1624, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि ब्रीहिद्रौणिकपर्वणि द्विषष्ट्यधिकद्विशततमोऽध्यायः ॥ २६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]