[{"id": 2040526, "chapter_id": 1898, "verse_number": "५-१४३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040527, "chapter_id": 1898, "verse_number": "५-१४३-१", "content_sanskrit": "केशवस्य तु तद्वाक्यं कर्णः श्रुत्वा हितं शुभम्।\nअब्रवीदभिसंपूज्य कृष्णं तं मधुसूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040528, "chapter_id": 1898, "verse_number": "५-१४३-२", "content_sanskrit": "जानन्मां किं महाबाहो संमोहयितुमिच्छसि।\nयोयं पृथिव्याः कार्त्स्न्येन विनाशः समुपस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040529, "chapter_id": 1898, "verse_number": "५-१४३-३", "content_sanskrit": "निमित्तं तत्र शकुनिरहं दुःशासनस्तथा।\nदुर्योधनश्च नृपतिर्धृतराष्ट्रसुतोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040530, "chapter_id": 1898, "verse_number": "५-१४३-४", "content_sanskrit": "असंशयमिदं कृष्ण महद्युद्धमुपस्थितम्।\nपाण्डवानां कुरूणां च घोरं रुधिरकर्दमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040531, "chapter_id": 1898, "verse_number": "५-१४३-५", "content_sanskrit": "राजानो राजपुत्राश्च दुर्योधनवशानुगाः ।\nरणे शस्त्राग्निना दग्धाः प्राप्स्यन्ति यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040532, "chapter_id": 1898, "verse_number": "५-१४३-६", "content_sanskrit": "स्वप्ना हि बहवो घोरा दृश्यन्ते मधुसूदन।\nनिमित्तानि च घोराणि तथोत्पाताः सुदारुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040533, "chapter_id": 1898, "verse_number": "५-१४३-७", "content_sanskrit": "पराजयं धार्तराष्ट्रे विजयं च युधिष्ठिरे ।\nसंसन्त इव वार्ष्णेय विविधा रोमहर्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040534, "chapter_id": 1898, "verse_number": "५-१४३-८", "content_sanskrit": "प्राजापत्यं हि नक्षत्रं ग्रहस्तीक्ष्णो महाद्युतिः ।\nशनैश्चरः पीडयति पीडयन्प्राणिनोऽधिकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040535, "chapter_id": 1898, "verse_number": "५-१४३-९", "content_sanskrit": "कृत्वा चाङ्गारको वक्रं ज्योष्ठायां मधुसूदन।\nअनुराधां प्रार्थयते मैत्रं संगमयन्निव ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040536, "chapter_id": 1898, "verse_number": "५-१४३-१०", "content_sanskrit": "नूनं महद्भयं कृष्ण कुरूणां समुपस्थितम् ।\nविशेषेण हि वार्ष्णेय चित्रां पीडयते ग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040537, "chapter_id": 1898, "verse_number": "५-१४३-११", "content_sanskrit": "सोमस्य लक्ष्म व्यावृत्तं राहुरर्कमुपैति च।\nदिवश्चोल्काः पतन्त्येताः सनिर्घाताः सकंपनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040538, "chapter_id": 1898, "verse_number": "५-१४३-१२", "content_sanskrit": "निष्टनन्ति च मातङ्गा मुञ्चन्त्यश्रूणि वाजिनः ।\nपानीयं यवसं चापि नाभिनन्दन्ति माधव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040539, "chapter_id": 1898, "verse_number": "५-१४३-१३", "content_sanskrit": "प्रादुर्भूतेषु चैतेषु भयमाहुरुपास्थितम्।\nनिमित्तेषु महाबाहो दारुणं प्राणिनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040540, "chapter_id": 1898, "verse_number": "५-१४३-१४", "content_sanskrit": "अल्पे भुक्ते पुरीषं च प्रभूतमिह दृश्यते।\nवाजिनां वारणानां च मनुष्याणां च केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040541, "chapter_id": 1898, "verse_number": "५-१४३-१५", "content_sanskrit": "धार्तराष्ट्रस्य सैन्येषु सर्वेषु मधुसूदन।\nपराभवस्य तल्लिङ्गमिति प्राहुर्मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040542, "chapter_id": 1898, "verse_number": "५-१४३-१६", "content_sanskrit": "प्रहृष्टं वाहनं कृष्ण पाण्डवानां प्रचक्षते।\nप्रदक्षिणा मृगाश्चैव तत्तेषां जयलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040543, "chapter_id": 1898, "verse_number": "५-१४३-१७", "content_sanskrit": "अपसव्या मृगाः सर्वे धार्तराष्ट्रस्य केशव ।\nवाचश्चाप्यशरीरिण्यस्तकत्पराभवलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040544, "chapter_id": 1898, "verse_number": "५-१४३-१८", "content_sanskrit": "मयूराः पुण्यशकुना हंससारसचातकाः ।\nजीवञ्जीवकसङ्घाश्चाप्यनुगच्छन्ति पाण्डवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040545, "chapter_id": 1898, "verse_number": "५-१४३-१९", "content_sanskrit": "गृध्राः कङ्का बकाः श्येना यातुधानास्तथा वृकाः ।\nमक्षिकाणां च सङ्घाता अनुधावन्ति कौरवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040546, "chapter_id": 1898, "verse_number": "५-१४३-२०", "content_sanskrit": "धार्तराष्ट्रस्य सैन्येषु भेरीणां नास्ति निःस्वनः ।\nअनाहताः पाण्डवानां नदन्ति पटहाः किल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040547, "chapter_id": 1898, "verse_number": "५-१४३-२१", "content_sanskrit": "उदपानाश्च नर्दन्ति यथा गोवृषभास्तथा ।\nधार्तराष्ट्रस्य सैन्येषु तत्पराभवलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040548, "chapter_id": 1898, "verse_number": "५-१४३-२२", "content_sanskrit": "मांसशोणितवर्षं च वृष्टं देवेन माधव ।\nतथा गन्धर्वनगरं भानुमत्समुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040549, "chapter_id": 1898, "verse_number": "५-१४३-२३", "content_sanskrit": "सप्राकारं सपरिखं सवप्रं चारुतोरणम् ।\nकृष्णश्च परिघस्तत्र भानुमावृत्य तिष्ठति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040550, "chapter_id": 1898, "verse_number": "५-१४३-२४", "content_sanskrit": "उदयास्तमने संध्ये वेदयन्ती महद्भयम् ।\nशिवा च वाशते घोरं तत्पराभवलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040551, "chapter_id": 1898, "verse_number": "५-१४३-२५", "content_sanskrit": "एकपक्षाक्षिचरणाः पक्षिणो मधुसूदन ।\nउत्सृजन्ति महद्धोरं तत्पराभवलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040552, "chapter_id": 1898, "verse_number": "५-१४३-२६", "content_sanskrit": "कृष्णग्रीवाश्च शकुना रक्तपादा भयानकाः ।\nसन्ध्यामिमुखा यान्ति तत्पराभवलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040553, "chapter_id": 1898, "verse_number": "५-१४३-२७", "content_sanskrit": "ब्राह्मणान्प्रथमं द्वेष्टि गुरूंश्च मधुसूदन ।\nभृत्यान्भक्तिमतश्चापि तत्पराभवलक्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040554, "chapter_id": 1898, "verse_number": "५-१४३-२८", "content_sanskrit": "पूर्वा दिग्लोहिताकारा शस्त्रवर्णा च दक्षिणा ।\nआमपात्रप्रतीकाशा पश्चिमा मधुसूदन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040555, "chapter_id": 1898, "verse_number": "५-१४३-२९", "content_sanskrit": "उत्तरा शङ्खवर्णाभा दिशां वर्णा उदाहृताः ॥\nप्रदीप्ताश्च दिशः सर्वा धार्तराष्ट्रस्य माधव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040556, "chapter_id": 1898, "verse_number": "५-१४३-३०", "content_sanskrit": "महद्भयं वेदयन्ति तस्मिन्नुत्पातदर्शने ॥\nसहस्रपादं प्रासादं स्वप्नान्ते स्म युधिष्ठिरः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040557, "chapter_id": 1898, "verse_number": "५-१४३-३१", "content_sanskrit": "अधिरोहन्मया दृष्टः सह भ्रातृभिरच्युत ॥\nश्वेतोष्णीषाश्च दृश्यन्ते सर्वे वै शुक्लवाससः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040558, "chapter_id": 1898, "verse_number": "५-१४३-३२", "content_sanskrit": "आसनानि च शुभ्राणि सर्वेषामुपलक्षये ॥\nतव चापि मया कृष्ण स्वप्नान्ते रुधिराविला ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2040559, "chapter_id": 1898, "verse_number": "५-१४३-३३", "content_sanskrit": "आन्त्रेण पृथिवी दृष्टा परिक्षिप्ता जनार्दन ॥\nअस्थिसञ्चयमारूढश्चामितौजा यधिष्ठिरः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2040560, "chapter_id": 1898, "verse_number": "५-१४३-३४", "content_sanskrit": "सुवर्णपात्र्यां संहृष्टो भुक्तवान्घृतपायसम् ॥\nयुधिष्ठिरो मया दृष्टो ग्रसमानो वसुन्धराम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2040561, "chapter_id": 1898, "verse_number": "५-१४३-३५", "content_sanskrit": "उच्चं पर्वतमारूढो भीमकर्मा वृकोदरः।\nगदापाणिर्नरव्याघ्रो ग्रसन्निव महीमिमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2040562, "chapter_id": 1898, "verse_number": "५-१४३-३६", "content_sanskrit": "क्षपयिष्यति नः सर्वान्स सुव्यक्तं महारणे।\nविदितं मे हृषीकेश श्रिया परमया ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2040563, "chapter_id": 1898, "verse_number": "५-१४३-३७", "content_sanskrit": "पाण्डुरं गजमारूढो गाण्डीवी स धनञ्जयः।\nत्वया सार्धं हृषीकेश श्रिया परमया ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2040564, "chapter_id": 1898, "verse_number": "५-१४३-३८", "content_sanskrit": "यूयं सर्वे वधिष्यध्वं तत्र मे नास्ति संशयः।\nपार्थिवान्समरे कृष्ण दुर्योधनपुरोगमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2040565, "chapter_id": 1898, "verse_number": "५-१४३-३९", "content_sanskrit": "नकुलः सहदेवश्च सात्यकिश्च महारथः ।\nशुक्लकेयूरकण्ठत्राः शुक्लमाल्याम्बरावृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2040566, "chapter_id": 1898, "verse_number": "५-१४३-४०", "content_sanskrit": "अधिरूढा नरव्याघ्रा नरवाहनमुत्तमम् ।\nत्रय एते मया दृष्टाः पाण्डुरच्छत्रवाससः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2040567, "chapter_id": 1898, "verse_number": "५-१४३-४१", "content_sanskrit": "श्वेतोष्णीषाश्च दृश्यन्ते त्रय एते जनार्दन ।\nधार्तराष्ट्रेषु सैन्येषु तान्विजानीहि केशव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2040568, "chapter_id": 1898, "verse_number": "५-१४३-४२", "content_sanskrit": "अश्वत्थामा कृपश्चैव कृतवर्मा च सात्वतः ।\nरक्तोष्णीषाश्च दृश्यन्ते सर्वे माधव पार्थिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2040569, "chapter_id": 1898, "verse_number": "५-१४३-४३", "content_sanskrit": "उष्ट्रप्रयुक्तमारूढौ भीष्मद्रोणौ महारथौ ।\nमया सार्धं महाबाहो धार्तराष्ट्रेण वा विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2040570, "chapter_id": 1898, "verse_number": "५-१४३-४४", "content_sanskrit": "अगस्त्यशास्तां च दिशं प्रयाताः स्म जनार्दन ।\nअचिरेणैव कालेन प्राप्स्यामो यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2040571, "chapter_id": 1898, "verse_number": "५-१४३-४५", "content_sanskrit": "अहं चान्ये च राजानो यच्च तत्क्षत्रमण्डलम् ।\nगाण्डिवाग्निं प्रवेक्ष्याम इति मे नास्ति संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2040572, "chapter_id": 1898, "verse_number": "५-१४३-४६x", "content_sanskrit": "कृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2040573, "chapter_id": 1898, "verse_number": "५-१४३-४६", "content_sanskrit": "अपस्थितविनाशेयं नूनमद्य वसुंधरा।\nयथा हि मे वचः कर्ण नोपैति हृदयं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2040574, "chapter_id": 1898, "verse_number": "५-१४३-४७", "content_sanskrit": "सर्वेषां तात भूतानां विनाशे प्रत्युपस्थिते।\nअनयो नयसङ्काशो हृदयान्नापसर्पति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2040575, "chapter_id": 1898, "verse_number": "५-१४३-४८x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2040576, "chapter_id": 1898, "verse_number": "५-१४३-४८", "content_sanskrit": "अपि त्वां कृष्ण पश्यामो जीवन्तोऽस्मान्महारणात्।\nसमुत्तीर्णा महाबाहो वीरक्षत्रविनाशनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2040577, "chapter_id": 1898, "verse_number": "५-१४३-४९", "content_sanskrit": "अथवा सङ्गमः कृष्ण स्वर्गे नो भविता ध्रुवम्।\nतत्रेदानीं समेष्यामः पुनः सार्धं त्वयानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2040578, "chapter_id": 1898, "verse_number": "५-१४३-५०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2040579, "chapter_id": 1898, "verse_number": "५-१४३-५०", "content_sanskrit": "इत्युक्त्वा माधवं कर्णः परिष्वज्य च पीडितम्।\nविसर्जितः केशवेन रथोपस्थादवातरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2040580, "chapter_id": 1898, "verse_number": "५-१४३-५१", "content_sanskrit": "ततः स्वरथामस्थाय जाम्बूनदविभूषितम्।\nमहात्मा वै निववृते राधेयो दीनमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2040581, "chapter_id": 1898, "verse_number": "५-१४३-५२", "content_sanskrit": "ततः शीघ्रतरं प्रायात्केशवः सहसात्यकिः।\nपुनरुच्चारयन्वाणीं याहि याहीति सारथिम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2040582, "chapter_id": 1898, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि त्रिचत्वारिंशदधिकशततमोध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]