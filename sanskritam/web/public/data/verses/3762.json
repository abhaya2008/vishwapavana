[{"id": 2128680, "chapter_id": 3762, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2128681, "chapter_id": 3762, "verse_number": "१", "content_sanskrit": "स तु राजा महेष्वासः चक्रवर्ती महामनाः ।\nबभूव सर्वलोकस्य मनोनयननन्दनः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2128682, "chapter_id": 3762, "verse_number": "२", "content_sanskrit": "स शुश्राव महाबाहुः कपिलेन महात्मना ।\nपितॄणां निधनं घोरमप्राप्तिं त्रिदिवस्य च \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2128683, "chapter_id": 3762, "verse_number": "३", "content_sanskrit": "स राज्यं सचिवे न्यस्य हृदयेन विदूयता ।\nजगाम हिमवत्पार्श्वं तपस्तप्तुं नरेश्वरः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2128684, "chapter_id": 3762, "verse_number": "४", "content_sanskrit": "आरिराधयिषुर्गङ्गां तपसा दग्धकिल्बिषः ।\nसोऽपश्यत गिरिश्रेष्ठं हिमवन्तं नरेश्चरः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2128685, "chapter_id": 3762, "verse_number": "५", "content_sanskrit": "शृङ्गैर्बहुविधाकारैर्धातुनद्धैरलङ्कृतम् ।\nपवनालम्बिभिर्मेघैः परिष्वक्तं समन्ततः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2128686, "chapter_id": 3762, "verse_number": "६", "content_sanskrit": "नदीकुञ्जनितम्बैश्च सोदकैरुपशोभितम् ।\nगुहाकन्दरसंलीनैः सिंहव्याघ्रैर्निषेवितम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2128687, "chapter_id": 3762, "verse_number": "७", "content_sanskrit": "शकुनैश्च विचित्राङ्गैः कूजद्भिर्विविधा गिरः ।\nभृङ्गराजैस्तथा राजन् नत्यूहैर्जलकुक्कुटैः \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2128688, "chapter_id": 3762, "verse_number": "८", "content_sanskrit": "मयूरैः शतपत्रैश्च कोकिलैर्जीवजीवकैः ।\nचकोरैरसितापाङ्गैः तथा पुत्रप्रियैरपि \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2128689, "chapter_id": 3762, "verse_number": "९", "content_sanskrit": "जलस्थानेषु सर्वेषु पद्मिनीभिश्च सङ्कुलम् ।\nसारसानां च मधुरैर्व्याहृतैः समलङ्कृतम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2128690, "chapter_id": 3762, "verse_number": "१०", "content_sanskrit": "किन्नरैरप्सरोभिश्च गन्धर्वैश्च निषेवितम् ।\nदिग्गजेन्द्रविषाणाग्रैः समन्ताद् घृष्टपादपम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2128691, "chapter_id": 3762, "verse_number": "११", "content_sanskrit": "विद्याधरानुचरितं नानाद्रुमलतायुतम् ।\nविषोल्बणैर्भुजङ्गैश्च दीप्तजिह्वैर्भयानकम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2128692, "chapter_id": 3762, "verse_number": "१२", "content_sanskrit": "क्वचित् कनकसङ्काशं क्वचिद्रजतसन्निभम् ।\nक्वचिदञ्जनपुञ्जाभं हिमवन्तमुपागमत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2128693, "chapter_id": 3762, "verse_number": "१३", "content_sanskrit": "स तु तत्र नरश्रेष्ठ तपो घोरं समाश्रितः ।\nफलमूलाम्बुभक्षोऽभूत् सहस्रपरिवत्सरान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2128694, "chapter_id": 3762, "verse_number": "१४", "content_sanskrit": "संवत्सरसहस्रे तु गते दिव्ये महानदी ।\nदर्शयामास तं गङ्गा तदा मूर्तिमती स्वयम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2128695, "chapter_id": 3762, "verse_number": "", "content_sanskrit": "गङ्गा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2128696, "chapter_id": 3762, "verse_number": "१५", "content_sanskrit": "किमिच्छसि महाराज मत्तः किञ्चिद् ददामि ते ।\nतद् ब्रूहि नृपतिश्रेष्ठ करिष्यामि वचस्तव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2128697, "chapter_id": 3762, "verse_number": "१६", "content_sanskrit": "एवमुक्तः प्रत्युवाच राजा हैमवतीं तदा ।\nनदीं भगीरथो राजन् प्रणिपत्य कृताञ्जलिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2128698, "chapter_id": 3762, "verse_number": "१७", "content_sanskrit": "पितामहा मे वरदे कपिलेन महानदि ।\nअन्वेषमाणास्तुरगं नीता वैवस्वतक्षयम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2128699, "chapter_id": 3762, "verse_number": "१८", "content_sanskrit": "षष्टिस्तानि सहस्राणि सागराणां महात्मनाम् ।\nकापिलं तेज आसाद्य क्षणेन निधनं गताः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2128700, "chapter_id": 3762, "verse_number": "१९", "content_sanskrit": "एषामेवं विनष्टानां स्वर्गे वासो न विद्यते ।\nयावत् तानि शरीराणि त्वं जलैर्नाभिषिञ्चसि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2128701, "chapter_id": 3762, "verse_number": "२०", "content_sanskrit": "स्वर्गं नय महाभागे मत्पितॄन् सगरात्मजान् ।\nतेषामर्थे हि याचामि त्वामहं वै महानदि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2128702, "chapter_id": 3762, "verse_number": "२१", "content_sanskrit": "एतच्छ्रुत्वा वचो राज्ञो गङ्गा लोकनमस्कृता ।\nभगीरथमिदं वाक्यं प्रीता पश्चादभाषत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2128703, "chapter_id": 3762, "verse_number": "२२", "content_sanskrit": "करिष्यामि महाराज वचस्ते नात्र संशयः ।\nवेगं तु मम दुर्धार्यं पतन्त्या गगनाच्च्युतम् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2128704, "chapter_id": 3762, "verse_number": "२३", "content_sanskrit": "न शक्तस्त्रिषु लोकेषु कश्चिद् धारयितुं नृप ।\nअन्यत्र विबुधश्रेष्ठान्नीलकण्ठान्महेश्वरात्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2128705, "chapter_id": 3762, "verse_number": "२४", "content_sanskrit": "तं तोषय महाबाहो तपसा वरदं हरम् ।\nस तु मां प्रच्युतां देवः शिरसा धारयिष्यति\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2128706, "chapter_id": 3762, "verse_number": "२५", "content_sanskrit": "करिष्यति च ते कामं पितॄणां हितकाम्यया ।\nतपसाऽराधितः शम्भुर्भगवाँल्लोकभावनः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2128707, "chapter_id": 3762, "verse_number": "२६", "content_sanskrit": "एतच्छ्रुत्वा वचो राजन् महाराजो भगीरथः ।\nकैलासं पर्वतं गत्वा तोषयामास शङ्करम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2128708, "chapter_id": 3762, "verse_number": "२७", "content_sanskrit": "ततस्तेन समागम्य कालयोगेन केनचित् ।\nगङ्गावतरणं राजन्नयाचत महीपतिः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2128709, "chapter_id": 3762, "verse_number": "२८", "content_sanskrit": "अगृह्णाच्च वरं तस्माद् गङ्गाया धारणे नृप ।\nस्वर्गे वासं समुद्दिश्य पितॄणां स नरोत्तमः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2128710, "chapter_id": 3762, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चतुरधिकशततमोऽध्यायः ॥१०४॥\n॥ तीर्थयात्रापर्वणि षष्टितमोऽध्यायः ॥६०॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]