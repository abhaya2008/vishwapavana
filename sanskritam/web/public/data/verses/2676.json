[{"id": 2078911, "chapter_id": 2676, "verse_number": "१२-१८१-०x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2078912, "chapter_id": 2676, "verse_number": "१२-१८१-१", "content_sanskrit": "मेरुमध्ये स्थितो ब्रह्मा कथं स ससृजे प्रजाः।\nएतन्मे सर्वमाचक्ष्व याथातथ्येन पृच्छतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2078913, "chapter_id": 2676, "verse_number": "१२-१८१-२x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2078914, "chapter_id": 2676, "verse_number": "१२-१८१-२", "content_sanskrit": "प्रजाविसर्गं पूर्वं स मानसो मनसाऽसृजत्।\nसंरक्षणार्थं भूतानां सृष्टं प्रथमतो जलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2078915, "chapter_id": 2676, "verse_number": "१२-१८१-३", "content_sanskrit": "यत्प्राणः सर्वभूतानां वर्धन्ते येन च प्रजाः।\nपरित्यक्ताश्च नश्यन्ति तेनेदं सर्वमावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2078916, "chapter_id": 2676, "verse_number": "१२-१८१-४", "content_sanskrit": "पृथिवी पर्वता मेघा मूर्तिमन्तश्च ये परे।\nसर्वं तद्वारुणं ज्ञेयमापस्तस्तम्भिरे हि ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2078917, "chapter_id": 2676, "verse_number": "१२-१८१-५x", "content_sanskrit": "भरद्वाज उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2078918, "chapter_id": 2676, "verse_number": "१२-१८१-५", "content_sanskrit": "कथं सलिलमुत्पन्नं कथं चैवाग्निमारुतौ।\nकथं वा मेदिनी सृष्टेत्यत्र मे संशयो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2078919, "chapter_id": 2676, "verse_number": "१२-१८१-६x", "content_sanskrit": "भृगुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2078920, "chapter_id": 2676, "verse_number": "१२-१८१-६", "content_sanskrit": "ब्रह्मकल्पे पुरा ब्रह्मन्ब्रह्मर्षीणां समागमे।\nलोकसंभवसन्देहः समुत्पन्नो महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2078921, "chapter_id": 2676, "verse_number": "१२-१८१-७", "content_sanskrit": "तेऽतिष्ठन्ध्यानमालम्ब्य मौनमास्थाय निश्चलाः।\nत्यक्ताहाराः पवनपा दिव्यं वर्षशतं द्विजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2078922, "chapter_id": 2676, "verse_number": "१२-१८१-८", "content_sanskrit": "तेषां ब्रह्ममयी वाणी सर्वेषां श्रोत्रमागमत्।\nदिव्या सरस्वती तत्र संबभूव नभस्तलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2078923, "chapter_id": 2676, "verse_number": "१२-१८१-९", "content_sanskrit": "पुराऽस्तमितनिःशब्दमाकाशमचलोपमम्।\nनष्टचन्द्रार्कपवनं प्रसुप्तमिव संबभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2078924, "chapter_id": 2676, "verse_number": "१२-१८१-१०", "content_sanskrit": "ततः सलिलमुत्पन्नं तमसीवापरं तमः।\nतस्माच्च सलिलोत्पीडात्समजायत मारुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2078925, "chapter_id": 2676, "verse_number": "१२-१८१-११", "content_sanskrit": "यथा भाजनमच्छिद्रं निःशब्दमिह लक्ष्यते।\nतच्चाम्भसा पूर्यमाणं सशब्दं कुरुतेऽनिलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2078926, "chapter_id": 2676, "verse_number": "१२-१८१-१२", "content_sanskrit": "तथा सलिलसंरुद्धे नभसोन्ते निरन्तरे।\nभित्त्वाऽर्णवतलं वायुः समुत्पतति घोषवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2078927, "chapter_id": 2676, "verse_number": "१२-१८१-१३", "content_sanskrit": "स एष चरते वायुरर्णवोत्पीडसंभवः।\nआकाशस्थानमासाद्य प्रशान्तिं नाधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2078928, "chapter_id": 2676, "verse_number": "१२-१८१-१४", "content_sanskrit": "तस्मिन्वाय्वम्बुसंघर्षे दीप्ततेजा महाबलः।\nप्रादुर्बभूवोर्ध्वशिखः कृत्वा निस्तिमिरं नभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2078929, "chapter_id": 2676, "verse_number": "१२-१८१-१५", "content_sanskrit": "अग्निः पवनसंयुक्तः स्वात्समुत्क्षिपते जलम्।\nसोऽग्निमारुतसंयोगाद्धनत्वमुपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2078930, "chapter_id": 2676, "verse_number": "१२-१८१-१६", "content_sanskrit": "तस्याकाशान्निपतितः स्नेहस्तिष्ठति योऽपरः।\nस संघातत्वमापन्नो भूमित्वमनुगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2078931, "chapter_id": 2676, "verse_number": "१२-१८१-१७", "content_sanskrit": "रसानां सर्वगन्धानां स्नेहानां प्राणिनां तथा।\nभूमिर्योनिरिह ज्ञेया यस्यां सर्वं प्रसूयते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2078932, "chapter_id": 2676, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकाशीत्यधिकशततमोऽध्यायः॥ १८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]