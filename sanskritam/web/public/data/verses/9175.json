[{"id": 5000175000, "chapter_id": 9175, "verse_number": "२-९८-१", "content_sanskrit": "निवेश्य सेनां तु विभु: पद्भ्यां पादवतां वर:।\nअभिगन्तुं स काकुत्स्थमियेष गुरुवर्त्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000175001, "chapter_id": 9175, "verse_number": "२-९८-२", "content_sanskrit": "निविष्टमात्रे सैन्ये तु यथोद्देशं विनीतवत्।\nभरतो भ्रातरं वाक्यं शत्रुघ्नमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000175002, "chapter_id": 9175, "verse_number": "२-९८-३", "content_sanskrit": "क्षिप्रं वनमिदं सौम्य नरसङ्घै: समन्तत:।\nलुब्धैश्च सहितैरेभिस्त्वमन्वेषितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000175003, "chapter_id": 9175, "verse_number": "२-९८-४", "content_sanskrit": "गुहो ज्ञातिसहस्रेण शरचापासिधारिणा।\nसमन्वेषतु काकुत्स्थावस्मिन् परिवृत: स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000175004, "chapter_id": 9175, "verse_number": "२-९८-५", "content_sanskrit": "अमात्यै: सह पौरैश्च गुरुभिश्च द्विजातिभि:।\nवनं सर्वं चरिष्यामि पद्भ्यां परिवृत: स्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000175005, "chapter_id": 9175, "verse_number": "२-९८-६", "content_sanskrit": "यावन्न रामं द्रक्ष्यामि लक्ष्मणं वा महाबलम्।\nवैदेहीं वा महाभागां न मे शान्तिर्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000175006, "chapter_id": 9175, "verse_number": "२-९८-७", "content_sanskrit": "यावन्न चन्द्रसङ्काशं द्रक्ष्यामि शुभमाननम्।\nभ्रातु: पद्मपलाशाक्षं न मे शान्तिर्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000175007, "chapter_id": 9175, "verse_number": "२-९८-८", "content_sanskrit": "यावन्न चरणौ भ्रातु: पार्थिवव्यञ्जनान्वितौ।\nशिरसा धारयिष्यामि न मे शान्तिर्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000175008, "chapter_id": 9175, "verse_number": "२-९८-९", "content_sanskrit": "यावन्न राज्ये राज्यार्ह: पितृपैतामहे स्थित:।\nअभिषेकजलक्लिन्नो न मे शान्तिर्भविष्ऺयति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000175009, "chapter_id": 9175, "verse_number": "२-९८-१०", "content_sanskrit": "सिद्धार्थ: खलु सौमित्रिर्यश्चन्द्रविमलोपमम्।\nमुखं पश्यति रामस्य राजीवाक्षं महाद्युति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000175010, "chapter_id": 9175, "verse_number": "२-९८-११", "content_sanskrit": "कृतकत्या महाभागा वैदेही जनकात्मजा।\nभर्तारं सागरान्ताया: पृथिव्या याऽनुगच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000175011, "chapter_id": 9175, "verse_number": "२-९८-१२", "content_sanskrit": "सुभगश्चित्रकूटोऽसौ गिरिराजोपमो गिरि:।\nयस्मिन् वसति काकुत्स्थ: कुबेर इव नन्दने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000175012, "chapter_id": 9175, "verse_number": "२-९८-१३", "content_sanskrit": "कृतकार्यमिदं दुर्गं वनं व्यालनिषेवितम्।\nयदध्यास्ते महातेजा राम: शस्त्रभृतां वर: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000175013, "chapter_id": 9175, "verse_number": "२-९८-१४", "content_sanskrit": "एवमुक्त्वा महातेजा भरत: पुरुषर्षभ:।\nपद्भ्यामेव महाबाहु: प्रविवेश महद्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000175014, "chapter_id": 9175, "verse_number": "२-९८-१५", "content_sanskrit": "स तानि द्रुमजालानि जातानि गिरिसानुषु।\nपुष्पिताग्राणि मध्येन जगाम वदतां वर: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000175015, "chapter_id": 9175, "verse_number": "२-९८-१६", "content_sanskrit": "समीपत्वात्तन्मूलदर्शनमिति न पुनरुक्ति: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000175016, "chapter_id": 9175, "verse_number": "२-९८-१७", "content_sanskrit": "तं दृष्ट्वा भरत: श्रीमान् मुमोह सहबान्धव:।\nअत्र राम इति ज्ञात्वा गत: पारमिवाम्भस: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000175017, "chapter_id": 9175, "verse_number": "२-९८-१८", "content_sanskrit": "स चित्रकूटे तु गिरौ निशम्य रामाश्रमं पुण्यजनोपपन्नम्।\nगुहेन सार्द्धं त्वरितो जगाम पुनर्निवेश्यैव चमूं महात्मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000175018, "chapter_id": 9175, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे अष्टनवतितम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]