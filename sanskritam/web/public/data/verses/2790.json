[{"id": 2084160, "chapter_id": 2790, "verse_number": "१२-२९५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084161, "chapter_id": 2790, "verse_number": "१२-२९५-१", "content_sanskrit": "तिष्ठते मे सदा तात कौतूहलमिदं हृदि।\nतदहं श्रोतुमिच्छामि त्वत्तः कुरुपितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084162, "chapter_id": 2790, "verse_number": "१२-२९५-२", "content_sanskrit": "कथं देवर्षिरुशना सदा काव्यो महामतिः।\nअसुराणां प्रियकारः सुराणामप्रिये रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084163, "chapter_id": 2790, "verse_number": "१२-२९५-३", "content_sanskrit": "वर्धयामास तेजश्च किमर्थममितौजसाम्।\nनित्यं वैरनिबद्धाश्च दानवाः सुरसत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084164, "chapter_id": 2790, "verse_number": "१२-२९५-४", "content_sanskrit": "कथं चाप्युशना प्राप शुक्रत्वममरद्युतिः।\nऋद्धिं च स कथं प्राप्तः सर्वमेतद्ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084165, "chapter_id": 2790, "verse_number": "१२-२९५-५", "content_sanskrit": "न याति च स तेजस्वी मध्येन नभसः कथम्।\nएतदिच्छामि विज्ञातुं निखिलेन पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084166, "chapter_id": 2790, "verse_number": "१२-२९५-६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084167, "chapter_id": 2790, "verse_number": "१२-२९५-६", "content_sanskrit": "शृणु राजन्नवहितः सर्वमेतद्यथातथम्।\nयथामति यथा चैतच्छ्रुतपूर्वं मयाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084168, "chapter_id": 2790, "verse_number": "१२-२९५-७", "content_sanskrit": "एष भार्गवदायादो मुनिर्मान्यो दृढव्रतः।\nसुराणां विप्रियकरो निमित्ते कारणात्मके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084169, "chapter_id": 2790, "verse_number": "१२-२९५-८", "content_sanskrit": "इन्द्रोऽथ धनदो राजा यक्षरक्षोधिपः सदा।\nप्रभविष्णुश्च कोशस्य जगतश्च तथा प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084170, "chapter_id": 2790, "verse_number": "१२-२९५-९", "content_sanskrit": "तस्यात्मानमथाविश्य योगसिद्धो महामुनिः।\nरुद्ध्वा धनपतिं देवं योगेन हृतवान्वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084171, "chapter_id": 2790, "verse_number": "१२-२९५-१०", "content_sanskrit": "हृते धने ततः शर्म न लेभे धनदस्तथा।\nआपन्नमन्युः संविग्नः सोभ्यगात्सुरसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084172, "chapter_id": 2790, "verse_number": "१२-२९५-११", "content_sanskrit": "निवेदयामास तदा शिवायामिततेजसे।\nदेवश्रेष्ठाय रुद्राय सौम्याय बहुरूपिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084173, "chapter_id": 2790, "verse_number": "१२-२९५-१२", "content_sanskrit": "योगात्मकेनोशनसा रुद्ध्वा मम हृतं वसु।\nयोगेनात्मगतं कृत्वा निःसृतश्च महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084174, "chapter_id": 2790, "verse_number": "१२-२९५-१३", "content_sanskrit": "एतच्छ्रुत्वा ततः क्रुद्धो महायोगी महेश्वरः।\nसंरक्तनयनो राजञ्शूलमादाय तस्थिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084175, "chapter_id": 2790, "verse_number": "१२-२९५-१४", "content_sanskrit": "क्वासौ क्वासाविति प्राह गृहीत्वा परमायुधम्।\nउशना दूरतस्तस्य ह्यभूज्ज्ञात्वा चिकीर्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084176, "chapter_id": 2790, "verse_number": "१२-२९५-१५", "content_sanskrit": "स महायोगिनो बुद्ध्वा तं रोषं वै महात्मनः।\nगतिमागमनं वेत्ति स्थानं चैव ततः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084177, "chapter_id": 2790, "verse_number": "१२-२९५-१६", "content_sanskrit": "संचिन्त्येग्रेण तपसा महात्मानं महेश्वरम्।\nउशना योगसिद्धात्मा शूलाग्रे प्रत्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084178, "chapter_id": 2790, "verse_number": "१२-२९५-१७", "content_sanskrit": "विज्ञातरूपः स तदा तपः सिद्धोऽथ धन्विना।\nज्ञात्वा शूलं च देवेशः पाणिना समनामयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084179, "chapter_id": 2790, "verse_number": "१२-२९५-१८", "content_sanskrit": "आनतेनाथ शूलेन पाणिनामिततेजसा।\nपिनाकमिति चोवाच शूलमुग्रायुधः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084180, "chapter_id": 2790, "verse_number": "१२-२९५-१९", "content_sanskrit": "पाणिमध्यगतं दृष्ट्वा भार्गवं तमुमापतिः।\nआस्यं विवृत्य भ्रकुटिं पाणिं संप्राक्षिपच्छनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084181, "chapter_id": 2790, "verse_number": "१२-२९५-२०", "content_sanskrit": "स तु प्रविष्ट उशना कोष्ठं माहेश्वरं प्रभुः।\nव्यचरच्चापि तत्रासौ महात्मा भृगुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084182, "chapter_id": 2790, "verse_number": "१२-२९५-२१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084183, "chapter_id": 2790, "verse_number": "१२-२९५-२१", "content_sanskrit": "किमर्थं व्यचरद्राजन्नुशना तस्य धीमतः।\nजठरे देवदेवस्य किंचाकार्षीन्महाद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084184, "chapter_id": 2790, "verse_number": "१२-२९५-२२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084185, "chapter_id": 2790, "verse_number": "१२-२९५-२२", "content_sanskrit": "पुरा सोऽन्तर्जलगतः स्थाणुभूतो महाव्रतः।\nवर्षाणामभवद्राजन्प्रयुतान्यर्बुदानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2084186, "chapter_id": 2790, "verse_number": "१२-२९५-२३", "content_sanskrit": "उदतिष्ठत्तपस्तप्त्वा दुश्चरं च महाह्रदात्।\nततो देवातिदेवस्तं ब्रह्मा वै समसर्पत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2084187, "chapter_id": 2790, "verse_number": "१२-२९५-२४", "content_sanskrit": "तपोवृद्धिमपृच्छच्च कुशलं चैवमव्ययः।\nतपः सुचीर्णमिति च प्रोवाच वृषभध्वजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2084188, "chapter_id": 2790, "verse_number": "१२-२९५-२५", "content_sanskrit": "तत्संयोगेन वृद्धिं चाप्यपश्यत्स तु शंकरः।\nमहामतिरचिन्त्यात्मा सत्यधर्मरतः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2084189, "chapter_id": 2790, "verse_number": "१२-२९५-२६", "content_sanskrit": "स तेनाढ्यो महायोगी तपसा च धनेन च।\nव्यराजत महाराज त्रिषु लोकेषु वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2084190, "chapter_id": 2790, "verse_number": "१२-२९५-२७", "content_sanskrit": "ततः पिनाकी योगात्मा ध्यानयोगं समाविशत्।\nउशना तु समुद्विग्नो निलिल्ये जठरे ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2084191, "chapter_id": 2790, "verse_number": "१२-२९५-२८", "content_sanskrit": "तुष्टाव च महायोगी देवं तत्रस्थ एव च।\nनिःसारं काङ्क्षमाणः स तेन स्म प्रतिहन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2084192, "chapter_id": 2790, "verse_number": "१२-२९५-२९", "content_sanskrit": "उशना तु तथोवाच जठरस्थो महामुनिः।\nप्रसादं मे कुरुष्वेति पुनः पुनररिंदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2084193, "chapter_id": 2790, "verse_number": "१२-२९५-३०", "content_sanskrit": "तमुवाच महादेवो गच्छ शिश्नेन मोक्षणम्।\nइति सर्वाणि स्रोतांसि रुद्ध्वा त्रिदशपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2084194, "chapter_id": 2790, "verse_number": "१२-२९५-३१", "content_sanskrit": "अपश्यमानस्तद्द्वारं सर्वतः पिहितो मुनिः।\nपर्यक्रामद्दह्यमान इतश्चेतश्च तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2084195, "chapter_id": 2790, "verse_number": "१२-२९५-३२", "content_sanskrit": "स वै निष्क्रम्य शिश्नेन शुक्रत्वमभिपेदिवान्।\nकार्येण तेन नभसो नाध्यगच्छत मध्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2084196, "chapter_id": 2790, "verse_number": "१२-२९५-३३", "content_sanskrit": "`तत एव च देवेषु अप्रविष्टो महामुनिः।\nपौरोहित्यं च दैत्यानां शक्रतेजोविवृद्धये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2084197, "chapter_id": 2790, "verse_number": "१२-२९५-३४", "content_sanskrit": "विनिष्क्रान्तं तु तं दृष्ट्वा ज्वलन्तमिव तेजसा।\nभवो रोषसमाविष्टः शूलोद्यतकरः स्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2084198, "chapter_id": 2790, "verse_number": "१२-२९५-३५", "content_sanskrit": "अवारयत तं देवी क्रुद्धं पशुपतिं पतिम्।\nपुत्रत्वमगमद्देव्या वारिते शंकरे च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2084199, "chapter_id": 2790, "verse_number": "१२-२९५-३६x", "content_sanskrit": "देव्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2084200, "chapter_id": 2790, "verse_number": "१२-२९५-३६", "content_sanskrit": "हिंसनीयस्त्वया नैव मम पुत्रत्वमागतः।\nन हि देवोदरात्कश्चिन्निःसृतो नाशमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2084201, "chapter_id": 2790, "verse_number": "१२-२९५-३७", "content_sanskrit": "ततः प्रीतो भवो देव्याः प्रहसंश्चेदमब्रवीत्।\nगच्छत्वेष यथाकाममिति राजन्पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2084202, "chapter_id": 2790, "verse_number": "१२-२९५-३८", "content_sanskrit": "ततः प्रणम्य वरदं देवं देवीमुमां तथा।\nउशना प्राप तद्धीमान्गतिमिष्टां महामुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2084203, "chapter_id": 2790, "verse_number": "१२-२९५-३९", "content_sanskrit": "एतत्ते कथितं तात भार्गवस्य महात्मनः।\nचरितं भरतश्रेष्ठ यन्मां त्वं परिपृच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2084204, "chapter_id": 2790, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि पञ्चनवत्यधिकद्विशततमोऽध्यायः॥ २९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]