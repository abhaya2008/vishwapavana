[{"id": 2048748, "chapter_id": 2071, "verse_number": "६-१२०-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2048749, "chapter_id": 2071, "verse_number": "६-१२०-१", "content_sanskrit": "कथमासंस्तदा योधा हीना भीष्मेण सञ्जय ।\nबलिना देवकल्पेन कौमारब्रह्मचारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2048750, "chapter_id": 2071, "verse_number": "६-१२०-२", "content_sanskrit": "तदैव निहतान्मन्ये कुरूनन्यांश्च पाण्डवैः ।\nन प्राहरद्यदा भीष्मो घृणित्वाद्द्रुपदात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2048751, "chapter_id": 2071, "verse_number": "६-१२०-३", "content_sanskrit": "ततो दुःखतरं मन्ये किमन्यत्प्रभविष्यति ।\nअद्यैव निहतं श्रुत्वा पितरं मम दुर्मतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2048752, "chapter_id": 2071, "verse_number": "६-१२०-४", "content_sanskrit": "अश्मसारमयं नूनं हृदयं मम सञ्जय ।\nश्रुत्वा विनिहतं भीष्मं शतधा यन्न दीर्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2048753, "chapter_id": 2071, "verse_number": "६-१२०-५", "content_sanskrit": "यदन्यन्निहतेनाजौ भीष्मेण जयमिच्छता ।\nचेष्टितं कुरुसिंहेन तन्मे कथय सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2048754, "chapter_id": 2071, "verse_number": "६-१२०-६", "content_sanskrit": "पुनःपुनर्न मृष्यामि हतं देवव्रतं रणे।\nन हतो जामदग्न्येन दिव्यैरस्त्रैश्च यः पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2048755, "chapter_id": 2071, "verse_number": "६-१२०-७", "content_sanskrit": "स हतो द्रौपदेयेन पाञ्चाल्येन शिखण्डिना ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2048756, "chapter_id": 2071, "verse_number": "६-१२०-७x", "content_sanskrit": "सञ्जय उवाच।\nसायाह्ने न्यपतद्भूमौ धार्तराष्ट्रान्विषादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2048757, "chapter_id": 2071, "verse_number": "६-१२०-८", "content_sanskrit": "पाञ्चालान्हर्षयंश्चैव भीष्मः कुरुपितामहः ।\nस शेते शरतल्पस्थो मेदिनीमस्पृशंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2048758, "chapter_id": 2071, "verse_number": "६-१२०-९", "content_sanskrit": "भीष्मो रथात्प्रपतितः संछिन्नो बहुभिः शरैः ।\nहाहेति तुमुलः शब्दो भूतानां समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2048759, "chapter_id": 2071, "verse_number": "६-१२०-१०", "content_sanskrit": "सीमावृक्षे निपतिते कुरूणां समितिंजये ।\nसेनयोरुभयो राजन्क्षत्रियान्भयमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2048760, "chapter_id": 2071, "verse_number": "६-१२०-११", "content_sanskrit": "भीष्मं शान्तनवं दृष्ट्वा विशीर्णकवचध्वजम् ।\nकुरवः पर्यवर्तन्त पाण्डवाश्च विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2048761, "chapter_id": 2071, "verse_number": "६-१२०-१२", "content_sanskrit": "खं तमःसंवृतमभूदासीद्भानुर्गतप्रभः ।\nररास पृथिवी चैव भीष्मे शान्तनवे हते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2048762, "chapter_id": 2071, "verse_number": "६-१२०-१३", "content_sanskrit": "अयं ब्रह्मविदां श्रेष्ठो गतिर्ब्रह्मविदां सदा।\nइत्यभाषन्त भूतानि शयानं पुरुषर्षभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2048763, "chapter_id": 2071, "verse_number": "६-१२०-१४", "content_sanskrit": "अयं पितरमाज्ञाय कामार्तं शन्तनुं पुरा ।\nऊर्ध्वरेतसमात्मानं चकार पुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2048764, "chapter_id": 2071, "verse_number": "६-१२०-१५", "content_sanskrit": "इति स्म शरतल्पस्थं भरतानां पितामहम् ।\nऋषयस्त्वभ्यभाषन्त सहिताः सिद्धचारणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2048765, "chapter_id": 2071, "verse_number": "६-१२०-१६", "content_sanskrit": "हते शान्तनवे भीष्मे भरतानां पितामहे ।\nन किंचित्प्रत्यपद्यन्त पुत्रास्तव हि मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2048766, "chapter_id": 2071, "verse_number": "६-१२०-१७", "content_sanskrit": "विषण्णवदनाश्चासन्हतश्रीकाश्च भारत ।\nअतिष्ठन्व्रीडिताश्चैव ह्रिया युक्ता ह्यधोमुखाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2048767, "chapter_id": 2071, "verse_number": "६-१२०-१८", "content_sanskrit": "पाण्डवाश्च जयं लब्ध्वा संग्रामशिरसि स्थिताः ।\nसर्वे दध्युर्महाशङ्खान्हेमजालपरिष्कृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2048768, "chapter_id": 2071, "verse_number": "६-१२०-१९", "content_sanskrit": "हर्षात्तूर्यसहस्रेषु वाद्यमानेषु चानघ ।\nअपश्याम महाराज भीमसेनं महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2048769, "chapter_id": 2071, "verse_number": "६-१२०-२०", "content_sanskrit": "विक्रीडमानं कौन्तेयं हर्षेण महता युतम्।\nनिहत्य तरसा शत्रुं महाबलसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2048770, "chapter_id": 2071, "verse_number": "६-१२०-२१", "content_sanskrit": "संमोहश्चापि तुमुलः कुरूणामभवत्ततः ।\nकर्णदुर्योधनौ चापि निःश्वसेतां मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2048771, "chapter_id": 2071, "verse_number": "६-१२०-२२", "content_sanskrit": "तथा निपातिते भीष्मे कौरवाणां पितामहे ।\nहाहाभूतमभूत्सर्वं निर्मर्यादमवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2048772, "chapter_id": 2071, "verse_number": "६-१२०-२३", "content_sanskrit": "दृष्ट्वा च पतितं भीष्मं पुत्रो दुःशासनस्तव।\nउत्तमं जवमास्थाय द्रोणानीकभुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2048773, "chapter_id": 2071, "verse_number": "६-१२०-२४", "content_sanskrit": "भ्रात्रा प्रस्थापितो वीरः स्वेनानीकेन दंशितः।\nप्रययौ पुरुषव्याघ्रः स्वसैन्यमभिहर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2048774, "chapter_id": 2071, "verse_number": "६-१२०-२५", "content_sanskrit": "तमायान्तमभिप्रेक्ष्य कुरवः पर्यवारयन्।\nदुःशासनं महाराज किमयं वक्ष्यतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2048775, "chapter_id": 2071, "verse_number": "६-१२०-२६", "content_sanskrit": "ततो द्रोणाय निहतं भीष्ममाचष्ट कौरवः ।\nद्रोणस्तदाऽप्रियं श्रुत्वा मुमोह भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2048776, "chapter_id": 2071, "verse_number": "६-१२०-२७", "content_sanskrit": "स संज्ञामुपलभ्याशु भारद्वाजः प्रतापवान् ।\nनिवारयामास तदा स्वान्यनीकानि मारिष ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2048777, "chapter_id": 2071, "verse_number": "६-१२०-२८", "content_sanskrit": "विनिवृत्तान्कुरून्दृष्ट्वा पाण्डवापि स्वसैनिकान्।\nरथैः शीघ्राश्वसंयुक्तैः समन्तात्पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2048778, "chapter_id": 2071, "verse_number": "६-१२०-२९", "content_sanskrit": "निवृत्तेषु च सैन्येषु पारम्पर्येण सर्वशः ।\nनिर्मुक्तकवचाः सर्वे भीष्ममीयुर्नराधिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2048779, "chapter_id": 2071, "verse_number": "६-१२०-३०", "content_sanskrit": "व्युपरम्य ततो युद्धाद्योधाः शतसहस्रशः ।\nउपतस्थुर्महात्मानं प्रजापतिमिवामराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2048780, "chapter_id": 2071, "verse_number": "६-१२०-३१", "content_sanskrit": "ते तु भीष्मं समासाद्य शयानं भरतर्षभम् ।\nअभिवाद्यावतिष्ठन्त पाण्डवाः कुरुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2048781, "chapter_id": 2071, "verse_number": "६-१२०-३२", "content_sanskrit": "अथ पाण्डून्कुरूंश्चैव प्रणिपत्याग्रतः स्थितान् ।\nअभ्यभाषत धर्मात्मा भीष्मः शान्तनवस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2048782, "chapter_id": 2071, "verse_number": "६-१२०-३३", "content_sanskrit": "स्वागतं वो महाभागाः स्वागतं वो महारथाः ।\nतुष्यामि दर्शनाच्चाहं युष्माकममरोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2048783, "chapter_id": 2071, "verse_number": "६-१२०-३४", "content_sanskrit": "अभिनन्द्य स तानेवं शिरसा लम्बताऽब्रवीत् ।\n`परपार्श्वे तव सुतान्स्थितानुद्वीक्ष्य भारत।\nशिरो मे लम्बतेऽत्यर्थमुपधानं प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2048784, "chapter_id": 2071, "verse_number": "६-१२०-३५", "content_sanskrit": "ततो नृपाः समाजह्रुस्तनूनि च मृदूनि च ।\nउपधानानि मुख्यानि नैच्छत्तानि पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2048785, "chapter_id": 2071, "verse_number": "६-१२०-३६", "content_sanskrit": "अथाब्रवीन्नरव्याघ्रः प्रसहन्निव तान्नृपान् ।\nनैतानि वीरशय्यासु युक्तरूपाणि पार्थिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2048786, "chapter_id": 2071, "verse_number": "६-१२०-३७", "content_sanskrit": "ततो वीक्ष्य नरश्रेष्ठमभ्यभाषत पाण्डवम् ।\nधनञ्जयं दीर्घबाहुं सर्वलोकमहारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2048787, "chapter_id": 2071, "verse_number": "६-१२०-३८", "content_sanskrit": "धनञ्जय महाबाहो शिरो मे तात लम्बते।\nदीयतामुपधानं वै यद्युक्तमिह मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2048788, "chapter_id": 2071, "verse_number": "६-१२०-३९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2048789, "chapter_id": 2071, "verse_number": "६-१२०-३९", "content_sanskrit": "समारोप्य महच्चापमभिवाद्य पितामहम्।\nनेत्राभ्यामश्रुपूर्णाभ्यामिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2048790, "chapter_id": 2071, "verse_number": "६-१२०-४०", "content_sanskrit": "आज्ञापय कुरुश्रेष्ठ सर्वशस्त्रभृतां वर।\nप्रेष्योऽहं तव दुर्धर्ष क्रियतां किं पितामह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2048791, "chapter_id": 2071, "verse_number": "६-१२०-४१", "content_sanskrit": "तमब्रवीच्छान्तनवः शिरो मे तात लम्बते । ६-१२०-४१b`दीयतामुपधानं मे यद्युक्तमिह मन्यसे\nउपधानं कुरुश्रेष्ठ उपधेहि ममार्जुन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2048792, "chapter_id": 2071, "verse_number": "६-१२०-४२", "content_sanskrit": "वीरशय्यानुरूपं वै शीघ्रं वीर प्रयच्छ मे ।\nत्वं हि पार्थ समर्थो वै श्रेष्ठः सर्वधनुष्मताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2048793, "chapter_id": 2071, "verse_number": "६-१२०-४३", "content_sanskrit": "क्षत्रधर्मस्य वेत्ता च बुद्धिसत्वगुणान्वितः ।\nफल्गुनोऽपि तथेत्युक्त्वा व्यवसायं परंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2048794, "chapter_id": 2071, "verse_number": "६-१२०-४४", "content_sanskrit": "गृह्यानुमन्त्र्य गाण्डीवं शरान्सन्नतपर्वणः ।\nअनुमान्य महात्मानं भरतानां महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2048795, "chapter_id": 2071, "verse_number": "६-१२०-४५", "content_sanskrit": "त्रिभिस्तीक्ष्णैर्महावेगैरुदगृह्णाच्छिरः शरैः ।\nअभिप्राये तु विदिते धर्मात्मा स्वयसाचिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2048796, "chapter_id": 2071, "verse_number": "६-१२०-४६", "content_sanskrit": "अतुष्यद्भरतश्रेष्ठो भीष्मो धर्मार्थतत्त्ववित् ।\nउपधानेन दत्तेन प्रत्यनन्दद्धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2048797, "chapter_id": 2071, "verse_number": "६-१२०-४७", "content_sanskrit": "प्राह सर्वान्समुद्वीक्ष्य भरतान्भारतं प्रति।\nकुन्तीपुत्रं युधां श्रेष्ठं सुहृदां प्रीतिवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2048798, "chapter_id": 2071, "verse_number": "६-१२०-४८", "content_sanskrit": "शयनस्यानुरूपं मे पाण्डवोपहितं त्वया।\nयद्यन्यथा प्रपद्येथाः शपेयं त्वामहं पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2048799, "chapter_id": 2071, "verse_number": "६-१२०-४९", "content_sanskrit": "एवमेव महाबाहो धर्मेषु परितिष्ठता।\nस्वप्तव्यं क्षत्रियेणाजौ शरतल्पगतेन वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2048800, "chapter_id": 2071, "verse_number": "६-१२०-५०", "content_sanskrit": "एवमुक्त्वा तु बीभत्सुं सर्वांस्तानब्रवीद्वचः ।\nराज्ञश्च राजपुत्रांश्च पाण्डवैरभिसंवृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2048801, "chapter_id": 2071, "verse_number": "६-१२०-५१", "content_sanskrit": "पश्यध्वमुपधानं मे पाणडवेनाभिसन्धितम् ।\nशयेयमस्यां शय्यायां यावदावर्तनं रवेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2048802, "chapter_id": 2071, "verse_number": "६-१२०-५२", "content_sanskrit": "ये तदा धारयिष्यन्ति ते च प्रेक्ष्यन्ति मां नृपाः।\nदिशं वैश्रवणाक्रान्तां यदा गन्ता दिवाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2048803, "chapter_id": 2071, "verse_number": "६-१२०-५३", "content_sanskrit": "नूनं सप्ताश्वयुक्तेन रथेनोत्तमतेजसा ।\nरक्ष्येऽहं वै मम प्राणान्सुहृदः सुप्रियानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2048804, "chapter_id": 2071, "verse_number": "६-१२०-५४", "content_sanskrit": "परिखाः खन्यतामत्र ममावसदने नृपाः ।\nउपासिष्ये विवस्वन्तमेवं शरशताचितः ।\nउपारमध्वं संग्रामाद्वैरमुत्सृज्य पार्थिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2048805, "chapter_id": 2071, "verse_number": "६-१२०-५५x", "content_sanskrit": "स़ञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2048806, "chapter_id": 2071, "verse_number": "६-१२०-५५", "content_sanskrit": "उपातिष्ठन्नथो वैद्याः शल्योद्धरणकोविदाः।\nसर्वोपकरणैर्युक्ताः कुशलैः साधुशिक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2048807, "chapter_id": 2071, "verse_number": "६-१२०-५६", "content_sanskrit": "तान्दृष्ट्वा जाह्नवीपुत्रः प्रोवाच तनयं तव ।\nदत्तदेया विसृज्यन्तां पूजयित्वा चिकित्सकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2048808, "chapter_id": 2071, "verse_number": "६-१२०-५७", "content_sanskrit": "एवंगते मयेदानीं वैद्यैः कार्यमिहास्ति किम्।\nक्षत्रधर्मे प्रशस्तां हि प्राप्तोऽस्मि परमां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2048809, "chapter_id": 2071, "verse_number": "६-१२०-५८", "content_sanskrit": "नैष धर्मो महीपालाः शरतल्पगतस्य मे ।\nएभिरेव शरैश्चाहं दग्धव्योऽग्नौ नराधिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2048810, "chapter_id": 2071, "verse_number": "६-१२०-५९", "content_sanskrit": "तच्छ्रुत्वा वचनं तस्य पुत्रो दुर्योधनस्तव।\nवैद्यान्विसर्जयामास पूजयित्वा यथार्हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2048811, "chapter_id": 2071, "verse_number": "६-१२०-६०", "content_sanskrit": "ततस्ते विस्मयं जग्मुर्नानाजनपदेश्वराः ।\nस्थितिं धर्मे परां दृष्ट्वा भीष्मस्यामिततेजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2048812, "chapter_id": 2071, "verse_number": "६-१२०-६१", "content_sanskrit": "उपधानं ततो दत्त्वा पितुस्ते मनुजेश्वराः ।\nसहिताः पाण्डवाः सर्वे कुरवश्च महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2048813, "chapter_id": 2071, "verse_number": "६-१२०-६२", "content_sanskrit": "उपगम्य महात्मानं शयानं शयने शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2048814, "chapter_id": 2071, "verse_number": "६-१२०-६३", "content_sanskrit": "तेऽभिवाद्य ततो भीष्मं कृत्वा च त्रिःप्रदक्षिणम्।\nविधाय रक्षां भीष्मस्य सर्व एव समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2048815, "chapter_id": 2071, "verse_number": "६-१२०-६४", "content_sanskrit": "वीराः स्वशिबिराण्येव ध्यायन्तः परमातुराः ।\nनिवेशायाभ्युपागच्छन्सायाह्ने रुधिरोक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2048816, "chapter_id": 2071, "verse_number": "६-१२०-६५", "content_sanskrit": "निविष्टान्पाण्डवांश्चैव प्रीयमाणान्महारथान् ।\nभीष्मस्य पतनं दृष्ट्वा उपगम्य महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2048817, "chapter_id": 2071, "verse_number": "६-१२०-६६", "content_sanskrit": "उवाच माधवः काले धर्मपुत्रं युधिष्ठिरम् ।\nदिष्ट्या जयसि कौरव्य दिष्ट्या भीष्मो निपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2048818, "chapter_id": 2071, "verse_number": "६-१२०-६७", "content_sanskrit": "अवध्यो मानुषैरेव सत्यसन्धो महारथः ।\nअथवा दैवतैः सार्धं सर्वशास्त्रस्य पारगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2048819, "chapter_id": 2071, "verse_number": "६-१२०-६८", "content_sanskrit": "त्वां तु चक्षुर्हणं प्राप्य दग्धो घोरेण चक्षुष ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2048820, "chapter_id": 2071, "verse_number": "६-१२०-६८x", "content_sanskrit": "सञ्जय उवाच।\nएवमुक्तो धर्मराजः प्रत्युवाच जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2048821, "chapter_id": 2071, "verse_number": "६-१२०-६९", "content_sanskrit": "तव प्रसादाद्विजयः क्रोधात्तव पराजयः ।\nत्वं हि नः शरणं कृष्ण भक्तानामभयंकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2048822, "chapter_id": 2071, "verse_number": "६-१२०-७०", "content_sanskrit": "अनाश्चर्यो जयस्तेषां येषां त्वमसि केशव ।\nरक्षिता समरे नित्यं नित्यं चापि हिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2048823, "chapter_id": 2071, "verse_number": "६-१२०-७१", "content_sanskrit": "सर्वथा त्वां समासाद्य नाश्चर्यमिति मे मतिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2048824, "chapter_id": 2071, "verse_number": "६-१२०-७१x", "content_sanskrit": "सञ्जय उवाच।\nएवमुक्तः प्रत्युवाच स्मयमानो जनार्दनः।\nतवैवैतद्युक्तरूपं वचनं पार्थिवोत्तम ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2048825, "chapter_id": 2071, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि दशमदिवसे विंशत्यधिकशततमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-१२०-११ पर्यवर्तन्त परिवृतवन्तः ॥ ६-१२०-१७ व्रीडिताः व्रीडावन्तः । व्रीडा चान्यतः। ह्रीश्चाकार्यकरणात् ॥ ६-१२०-२९ पारम्पर्येण क्रमेण॥ ६-१२०-३४ उपधानं उपबर्हम् ॥ ६-१२०-३८ इह वीरशय्यायाम् ॥ ६-१२०-४३ व्यवसायमुचितोद्योगम् ॥ ६-१२०-४५ अन्वगृह्णात् अवतष्टम्भे ॥ ६-१२०-४८ उपहितं उपधानीयं दत्तम्॥ ६-१२०-५३ विमोक्ष्येऽहं तदा प्राणान् इति झo पाठः ॥ ६-१२०-५४ ममावसदने मन्निवासस्थाने ॥ ६-१२०-६८ चक्षुषा हन्तीति तथा तम्। दृष्टिमात्रेण हननक्षमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}]