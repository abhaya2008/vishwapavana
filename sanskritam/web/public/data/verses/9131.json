[{"id": 5000131000, "chapter_id": 9131, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे चतुःपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000131001, "chapter_id": 9131, "verse_number": "२-५४-१", "content_sanskrit": "ते तु तस्मिन् महा वृक्षौषित्वा रजनीम् शिवाम् ।\nविमले अभ्युदिते सूर्ये तस्मात् देशात् प्रतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000131002, "chapter_id": 9131, "verse_number": "२-५४-२", "content_sanskrit": "यत्र भागीरथी गन्गा यमुनाम् अभिवर्तते ।\nजग्मुस् तम् देशम् उद्दिश्य विगाह्य सुमहद् वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000131003, "chapter_id": 9131, "verse_number": "२-५४-३", "content_sanskrit": "ते भूमिम् आगान् विविधान् देशामः च अपि मनो रमान् ।\nअदृष्ट पूर्वान् पश्यन्तः तत्र तत्र यशस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000131004, "chapter_id": 9131, "verse_number": "२-५४-४", "content_sanskrit": "यथा क्षेमेण गच्चन् स पश्यमः च विविधान् द्रुमान् ।\nनिवृत्त मात्रे दिवसे रामः सौमित्रिम् अब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000131005, "chapter_id": 9131, "verse_number": "२-५४-५", "content_sanskrit": "प्रयागम् अभितः पश्य सौमित्रे धूमम् उन्नतम् ।\nअग्नेर् भगवतः केतुम् मन्ये सम्निहितः मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000131006, "chapter_id": 9131, "verse_number": "२-५४-६", "content_sanskrit": "नूनम् प्राप्ताः स्म सम्भेदम् गन्गा यमुनयोः वयम् ।\nतथा हि श्रूयते शम्ब्दो वारिणा वारि घट्टितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000131007, "chapter_id": 9131, "verse_number": "२-५४-७", "content_sanskrit": "दारूणि परिभिन्नानि वनजैः उपजीविभिः ।\nभरद्वाज आश्रमे च एते दृश्यन्ते विविधा द्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000131008, "chapter_id": 9131, "verse_number": "२-५४-८", "content_sanskrit": "धन्विनौ तौ सुखम् गत्वा लम्बमाने दिवा करे ।\nगन्गा यमुनयोह् सम्धौ प्रापतुर् निलयम् मुनेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000131009, "chapter_id": 9131, "verse_number": "२-५४-९", "content_sanskrit": "रामः तु आश्रमम् आसाद्य त्रासयन् मृग पक्षिणः ।\nगत्वा मुहूर्तम् अध्वानम् भरद्वाजम् उपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000131010, "chapter_id": 9131, "verse_number": "२-५४-१०", "content_sanskrit": "ततः तु आश्रमम् आसाद्य मुनेर् दर्शन कान्क्षिणौ ।\nसीतया अनुगतौ वीरौ दूरात् एव अवतस्थतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000131011, "chapter_id": 9131, "verse_number": "२-५४-११", "content_sanskrit": "स प्रविश्य महात्मानमृषिम् शिष्यगणैर्वऋतम् ।\nसम्शितव्रतमेकाग्रम् तपसा लब्धचक्षुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000131012, "chapter_id": 9131, "verse_number": "२-५४-१२", "content_sanskrit": "हुत अग्नि होत्रम् दृष्ट्वा एव महा भागम् कृत अन्जलिः ।\nरामः सौमित्रिणा सार्धम् सीतया च अभ्यवादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000131013, "chapter_id": 9131, "verse_number": "२-५४-१३", "content_sanskrit": "न्यवेदयत च आत्मानम् तस्मै लक्ष्मण पूर्वजः ।\nपुत्रौ दशरथस्य आवाम् भगवन् राम लक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000131014, "chapter_id": 9131, "verse_number": "२-५४-१४", "content_sanskrit": "भार्या मम इयम् वैदेही कल्याणी जनक आत्मजा ।\nमाम् च अनुयाता विजनम् तपो वनम् अनिन्दिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000131015, "chapter_id": 9131, "verse_number": "२-५४-१५", "content_sanskrit": "पित्रा प्रव्राज्यमानम् माम् सौमित्रिर् अनुजः प्रियः ।\nअयम् अन्वगमद् भ्राता वनम् एव दृढ व्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000131016, "chapter_id": 9131, "verse_number": "२-५४-१६", "content_sanskrit": "पित्रा नियुक्ता भगवन् प्रवेष्यामः तपो वनम् ।\nधर्मम् एव आचरिष्यामः तत्र मूल फल अशनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000131017, "chapter_id": 9131, "verse_number": "२-५४-१७", "content_sanskrit": "तस्य तत् वचनम् श्रुत्वा राज पुत्रस्य धीमतः ।\nउपानयत धर्म आत्मा गाम् अर्घ्यम् उदकम् ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000131018, "chapter_id": 9131, "verse_number": "२-५४-१८", "content_sanskrit": "नानाविधानन्नरसान् वन्यमूलफलाश्रयान् ।\nतेभ्यो ददौ तप्ततपा वासम् चैवाभ्यकल्पयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000131019, "chapter_id": 9131, "verse_number": "२-५४-१९", "content_sanskrit": "मृग पक्षिभिर् आसीनो मुनिभिः च समन्ततः ।\nरामम् आगतम् अभ्यर्च्य स्वागतेन आह तम् मुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000131020, "chapter_id": 9131, "verse_number": "२-५४-२०", "content_sanskrit": "प्रतिगृह्य च ताम् अर्चाम् उपविष्टम् स राघवम् ।\nभरद्वाजो अब्रवीद् वाक्यम् धर्म युक्तम् इदम् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000131021, "chapter_id": 9131, "verse_number": "२-५४-२१", "content_sanskrit": "चिरस्य खलु काकुत्स्थ पश्यामि त्वाम् इह आगतम् ।\nश्रुतम् तव मया च इदम् विवासनम् अकारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000131022, "chapter_id": 9131, "verse_number": "२-५४-२२", "content_sanskrit": "अवकाशो विविक्तः अयम् महा नद्योह् समागमे ।\nपुण्यः च रमणीयः च वसतु इह भगान् सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000131023, "chapter_id": 9131, "verse_number": "२-५४-२३", "content_sanskrit": "एवम् उक्तः तु वचनम् भरद्वाजेन राघवः ।\nप्रत्युवाच शुभम् वाक्यम् रामः सर्व हिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000131024, "chapter_id": 9131, "verse_number": "२-५४-२४", "content_sanskrit": "भगवन्न् इताअसन्नः पौर जानपदो जनः ।\nसुदर्शमिह माम् प्रेक्ष्य मन्येऽह मिममाश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000131025, "chapter_id": 9131, "verse_number": "२-५४-२५", "content_sanskrit": "आगमिष्यति वैदेहीम् माम् च अपि प्रेक्षको जनः ।\nअनेन कारणेन अहम् इह वासम् न रोचये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000131026, "chapter_id": 9131, "verse_number": "२-५४-२६", "content_sanskrit": "एक अन्ते पश्य भगवन्न् आश्रम स्थानम् उत्तमम् ।\nरमते यत्र वैदेही सुख अर्हा जनक आत्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000131027, "chapter_id": 9131, "verse_number": "२-५४-२७", "content_sanskrit": "एतत् श्रुत्वा शुभम् वाक्यम् भरद्वाजो महा मुनिः ।\nराघवस्य ततः वाक्यम् अर्थ ग्राहकम् अब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000131028, "chapter_id": 9131, "verse_number": "२-५४-२८", "content_sanskrit": "दश क्रोशैतः तात गिरिर् यस्मिन् निवत्स्यसि ।\nमहर्षि सेवितः पुण्यः सर्वतः सुख दर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000131029, "chapter_id": 9131, "verse_number": "२-५४-२९", "content_sanskrit": "गो लान्गूल अनुचरितः वानर ऋष्क निषेवितः ।\nचित्र कूटैति ख्यातः गन्ध मादन सम्निभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000131030, "chapter_id": 9131, "verse_number": "२-५४-३०", "content_sanskrit": "यावता चित्र कूटस्य नरः शृन्गाणि अवेक्षते ।\nकल्याणानि समाधत्ते न पापे कुरुते मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000131031, "chapter_id": 9131, "verse_number": "२-५४-३१", "content_sanskrit": "ऋषयः तत्र बहवो विहृत्य शरदाम् शतम् ।\nतपसा दिवम् आरूधाः कपाल शिरसा सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000131032, "chapter_id": 9131, "verse_number": "२-५४-३२", "content_sanskrit": "प्रविविक्तम् अहम् मन्ये तम् वासम् भवतः सुखम् ।\nइह वा वन वासाय वस राम मया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000131033, "chapter_id": 9131, "verse_number": "२-५४-३३", "content_sanskrit": "स रामम् सर्व कामैअः तम् भरद्वाजः प्रिय अतिथिम् ।\nसभार्यम् सह च भ्रात्रा प्रतिजग्राह धर्मवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000131034, "chapter_id": 9131, "verse_number": "२-५४-३४", "content_sanskrit": "तस्य प्रयागे रामस्य तम् महर्षिम् उपेयुषः ।\nप्रपन्ना रजनी पुण्या चित्राः कथयतः कथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000131035, "chapter_id": 9131, "verse_number": "२-५४-३५", "content_sanskrit": "सीतातृतीय काकुत्स्थह् परिश्रान्तः सुखोचितः ।\nभरद्वाजाश्रमे रम्ये ताम् रात्रि मवस्त्सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000131036, "chapter_id": 9131, "verse_number": "२-५४-३६", "content_sanskrit": "प्रभातायाम् रजन्याम् तु भरद्वाजम् उपागमत् ।\nउवाच नर शार्दूलो मुनिम् ज्वलित तेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000131037, "chapter_id": 9131, "verse_number": "२-५४-३७", "content_sanskrit": "शर्वरीम् भवनन्न् अद्य सत्य शील तव आश्रमे ।\nउषिताः स्म इह वसतिम् अनुजानातु नो भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000131038, "chapter_id": 9131, "verse_number": "२-५४-३८", "content_sanskrit": "रात्र्याम् तु तस्याम् व्युष्टायाम् भरद्वाजो अब्रवीद् इदम् ।\nमधु मूल फल उपेतम् चित्र कूटम् व्रज इति ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000131039, "chapter_id": 9131, "verse_number": "२-५४-३९", "content_sanskrit": "वासमौपयिकम् मन्ये तव राम महाबल ।\nनानानगगणोपेतः किन्नरोरगसेवितह् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000131040, "chapter_id": 9131, "verse_number": "२-५४-४०", "content_sanskrit": "मयूरनादाभिरुतो गजराजनिषेवितः ।\nगम्यताम् भवता शैलश्चित्रकूटः स विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000131041, "chapter_id": 9131, "verse_number": "२-५४-४१", "content_sanskrit": "पुण्यश्च रमणीयश्च बहुमूलफलायुतः ।\nतत्र कुन्जर यूथानि मृग यूथानि च अभितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000131042, "chapter_id": 9131, "verse_number": "२-५४-४२", "content_sanskrit": "विचरन्ति वन अन्तेषु तानि द्रक्ष्यसि राघव ।\nसरित्प्रस्रवणप्रस्थान् दरीकन्धरनिर्घरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000131043, "chapter_id": 9131, "verse_number": "२-५४-४३", "content_sanskrit": "चरतः सीतया सार्धम् नन्दिष्यति मनस्तव ।\nप्रहृष्ट कोयष्टिक कोकिल स्वनैः ।\nर्विनादितम् तम् वसुधा धरम् शिवम् ।\nमृगैः च मत्तैः बहुभिः च कुन्जरैः ।\nसुरम्यम् आसाद्य समावस आश्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000131044, "chapter_id": 9131, "verse_number": null, "content_sanskrit": "इति वाल्मीकि रामायणे आदि काव्ये अयोध्याकाण्डे चतुःपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]