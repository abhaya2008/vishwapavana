[{"id": 900004125, "chapter_id": 8321, "verse_number": "1.1", "content_sanskrit": "नारायणाय परिपूर्णगुणार्णवाय विश्वोदयस्थितिलयोन्नियति प्रदाय", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004126, "chapter_id": 8321, "verse_number": "1.2", "content_sanskrit": "जयति हरिरचिन्त्यः सर्वदेवैकवन्द्यः परमगुरुरभीष्टावाप्तिदः सज्जनानाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900004127, "chapter_id": 8321, "verse_number": "1.3", "content_sanskrit": "जयत्यजोऽखण्डगुणोरुमण्डलः सदोदितो ज्ञानमरीचिमाली", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900004128, "chapter_id": 8321, "verse_number": "1.4", "content_sanskrit": "अथाभ्यवर्धंश्चतुराः कुमारा नृपस्य गेहे पुरुषोत्तमाद्याः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900004129, "chapter_id": 8321, "verse_number": "1.5", "content_sanskrit": "इत्थं विश्वेश्वरेऽस्मिन्नखिल जगदवस्थाप्य सीतासहाये भूमिष्ठे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900004130, "chapter_id": 8321, "verse_number": "1.6", "content_sanskrit": "उत्थाप्य चैनमरविन्ददलायताक्षश्चक्राङ्कितेन वरदेन कराम्बुजेन", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900004131, "chapter_id": 8321, "verse_number": "1.7", "content_sanskrit": "रामाय शाश्वतसुविस्तृतषड्गुणाय सर्वेश्वराय सुखसारमहार्णवाय", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900004132, "chapter_id": 8321, "verse_number": "1.8", "content_sanskrit": "श्रुत्वा हनूमदुदितं कृतमस्य सर्वं प्रीतः प्रयाणमभिरोचयते स रामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900004133, "chapter_id": 8321, "verse_number": "1.9", "content_sanskrit": "अथाऽप्तराज्यो भगवान् स लक्ष्मणं जगाद राजा तरुणो भवाऽशु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900004134, "chapter_id": 8321, "verse_number": "1.10", "content_sanskrit": "द्वापरेऽथ युगे प्राप्ते त्वष्टाविंशतिमे पुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900004135, "chapter_id": 8321, "verse_number": "1.11", "content_sanskrit": "शशाङ्कपुत्रादभवत् पुरूरवास्तस्याऽयुरायोर्नहुषो ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900004136, "chapter_id": 8321, "verse_number": "1.12", "content_sanskrit": "बभूव गन्धर्वमुनिस्तु देवकः स आस सेवार्थमथाऽहुकाद्धरेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900004137, "chapter_id": 8321, "verse_number": "1.13", "content_sanskrit": "गर्गः शूरसुतोक्त्या व्रजमायात् सात्त्वतां पुरोधाः सः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900004138, "chapter_id": 8321, "verse_number": "1.14", "content_sanskrit": "कृष्णो विमोच्य पितरावभिवन्द्य सर्ववन्द्योऽपि रामसहितः प्रतिपालनाय", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900004139, "chapter_id": 8321, "verse_number": "1.15", "content_sanskrit": "एवं प्रशासति जगत् पुरुषोत्तमेऽस्मिन् भीमार्जुनौ तु सहदेवयुतावनुज्ञाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900004140, "chapter_id": 8321, "verse_number": "1.16", "content_sanskrit": "काले त्वेतस्मिन् भूय एवाखिलैश्च नृपैर्युक्तो मागधो योद्धुकामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900004141, "chapter_id": 8321, "verse_number": "1.17", "content_sanskrit": "गतेऽथ चेदिपे स्वकं पुरं जनार्दनोऽशृणोत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900004142, "chapter_id": 8321, "verse_number": "1.18", "content_sanskrit": "यदा रामादवाप्तानि दिव्यास्त्राणि प्रपेदिरे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900004143, "chapter_id": 8321, "verse_number": "1.19", "content_sanskrit": "एवं शुभोच्चगुणवत्सु जनार्दनेन युक्तेषु पाण्डुषु चरत्स्वधिकं शुभानि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900004144, "chapter_id": 8321, "verse_number": "1.20", "content_sanskrit": "यज्ञोरुदाननरदेववन्द्यताप्रश्नर्षिपूजासु युधिष्ठिरोऽभूत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900004145, "chapter_id": 8321, "verse_number": "1.21", "content_sanskrit": "जनार्दनाज्ञया मयः समस्तकौतुकोत्तराम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900004146, "chapter_id": 8321, "verse_number": "1.22", "content_sanskrit": "आगन्तुकामान् पुरवासिनस्ते संस्थाप्य कृच्छ्रेण कुरुप्रवीराः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900004147, "chapter_id": 8321, "verse_number": "1.23", "content_sanskrit": "नारायणानुग्रहतो यथावन्निस्तीर्य तान् द्वादशाब्दान् वने ते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900004148, "chapter_id": 8321, "verse_number": "1.24", "content_sanskrit": "ततः सम्मन्त्र्यानुमते कृष्णस्य स्वपुरोहितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900004149, "chapter_id": 8321, "verse_number": "1.25", "content_sanskrit": "ते सेने समरारम्भे समेते सागरोपमे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900004150, "chapter_id": 8321, "verse_number": "1.26", "content_sanskrit": "अथाखिलानां पृथिवीपतीनामाचार्यमग्र्यं रथिनां सुविद्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900004151, "chapter_id": 8321, "verse_number": "1.27", "content_sanskrit": "अथानुज्ञामुपादाय द्रौणेर्दुर्योधनो नृपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900004152, "chapter_id": 8321, "verse_number": "1.28", "content_sanskrit": "प्रभातायां तु शर्वर्यां गुरुपुत्रानुमोदितः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900004153, "chapter_id": 8321, "verse_number": "1.29", "content_sanskrit": "यदैव कृष्णौ सकलाधिराज्ये युधिष्ठिरं यौवराज्ये च भीमम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900004154, "chapter_id": 8321, "verse_number": "1.30", "content_sanskrit": "अथ कृष्णमनुस्मृत्य भीष्मे स्वां वसुतां गते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900004155, "chapter_id": 8321, "verse_number": "1.31", "content_sanskrit": "यज्ञेश्वरेणाभियुतेषु युक्त्या महीं प्रशासत्सु पृथासुतेषु", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900004156, "chapter_id": 8321, "verse_number": "1.32", "content_sanskrit": "ततः कुरुक्षेत्रमवाप्य कृष्णो दीक्षां प्रपेदे द्विषडब्दसत्रे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]