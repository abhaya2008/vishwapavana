[{"id": 7001385000, "chapter_id": 21385, "verse_number": "५-३२-१", "content_sanskrit": "सूत उवाच ।\nअदितिर्दितिश्च सुरसारिष्टेला दनुरेव च ।\nसुरभिर्विनता चेला ताम्रा क्रोधवशा तथा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001385001, "chapter_id": 21385, "verse_number": "५-३२-२", "content_sanskrit": "कदूर्मुनिश्च विप्रेन्द्र तास्वपत्यानि मे शृणु ।\nपूर्वमन्वंतरे श्रेष्ठे द्वादशासन्सुरोत्तमाः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001385002, "chapter_id": 21385, "verse_number": "५-३२-३", "content_sanskrit": "तुषिता नाम तेऽन्योन्यमूचुर्वैवस्वतेंतरे ।\nउपस्थिते सुयशसश्चाक्षुषस्यांतरे मनोः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001385003, "chapter_id": 21385, "verse_number": "५-३२-४", "content_sanskrit": "हिताय सर्वलोकानां समागम्य परस्परम् ।\nआगच्छतस्तु तानूचुरदितिं च प्रविश्य वै॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001385004, "chapter_id": 21385, "verse_number": "५-३२-५", "content_sanskrit": "मन्वंतरे प्रसूयामस्सतां श्रेयो भविष्यति ।\nएवमुक्तास्तु ते सर्वे चाक्षुषस्यान्तरे मनोः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001385005, "chapter_id": 21385, "verse_number": "५-३२-६", "content_sanskrit": "मारीचात्कश्यपाज्जातास्तेऽदित्यां दक्षकन्यया ।\nतत्र विष्णुश्च शक्रश्च जज्ञाते पुनरेव हि॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001385006, "chapter_id": 21385, "verse_number": "५-३२-७", "content_sanskrit": "अर्यमा चैव धाता च त्वष्टा पूषा तथैव च ।\nविवस्वान्सविता चैव मित्रावरुण एव च॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001385007, "chapter_id": 21385, "verse_number": "५-३२-८", "content_sanskrit": "अंशो भगश्चातितेजा आदित्या द्वादश स्मृताः ।\nपूर्वमासन्ये तुषितास्सुराः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001385008, "chapter_id": 21385, "verse_number": "५-३२-९", "content_sanskrit": "पुरैव तस्यांतरे तु आदित्या द्वादश स्मृताः ।\nइति प्रोक्तानि क्रमशोऽदित्यपत्यानि शौनक॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001385009, "chapter_id": 21385, "verse_number": "५-३२-१०", "content_sanskrit": "सप्तविंशति याः प्रोक्तास्सोमपत्न्योऽथ सुव्रताः ।\nतासामपत्यान्यभवन्दीप्तयोऽमिततेजसः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001385010, "chapter_id": 21385, "verse_number": "५-३२-११", "content_sanskrit": "अरिष्टनेमिपत्नीनामपत्यानीह षोडश ।\nबहुपुत्रस्य विदुषश्चतस्रो यास्सुताः स्मृताः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001385011, "chapter_id": 21385, "verse_number": "५-३२-१२", "content_sanskrit": "कृशाश्वस्य तु देवर्षे देवप्रहरणाः स्मृताः ।\nभार्म्यायामर्चिषि मुने धूम्रकेशस्तथैव च॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001385012, "chapter_id": 21385, "verse_number": "५-३२-१३", "content_sanskrit": "स्वधा सती च द्वे पत्न्यौ स्वधा ज्येष्ठा सती परा ।\nस्वधासूत पितॄन्वेदमथर्वाङ्गिरसं सती॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001385013, "chapter_id": 21385, "verse_number": "५-३२-१४", "content_sanskrit": "एते युगसहस्रांते जायंते पुनरेव हि ।\nसर्वदेवनिकायाश्च त्रयस्त्रिंशत्तु कामजाः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001385014, "chapter_id": 21385, "verse_number": "५-३२-१५", "content_sanskrit": "यथा सूर्य्यस्य नित्यं हि उदयास्तमयाविह ।\nएवं देवानिकास्ते च संभवंति युगेयुगे॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001385015, "chapter_id": 21385, "verse_number": "५-३२-१६", "content_sanskrit": "दित्यां बभूवतुः पुत्रौ कश्यपादिति नः श्रुतम् ।\nहिरण्यकशिपुश्चैव हिरण्याक्षश्च वीर्यवान्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001385016, "chapter_id": 21385, "verse_number": "५-३२-१७", "content_sanskrit": "सिंहिका ह्यभवत्कन्या विप्रचित्तेः परिग्रहः ।\nहिरण्यकशिपोः पुत्राश्चत्वारः प्रथितौजसः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001385017, "chapter_id": 21385, "verse_number": "५-३२-१८", "content_sanskrit": "अनुह्रादश्च ह्रादश्च संह्रादश्चैव वीर्यवान् ।\nप्रह्रादश्चानुजस्तत्र विष्णुभक्तिविचारधीः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001385018, "chapter_id": 21385, "verse_number": "५-३२-१९", "content_sanskrit": "अनुह्रादस्य सूर्यायां पुलोमा महिषस्तथा ।\nह्रादस्य धमनिर्भार्यासूत वातापिमिल्वलम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001385019, "chapter_id": 21385, "verse_number": "५-३२-२०", "content_sanskrit": "संह्रादस्य कृतिर्भार्यासूतः पंचजनं ततः ।\nविरोचनस्तु प्राह्रादिर्देव्यास्तस्याभवद्बलिः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001385020, "chapter_id": 21385, "verse_number": "५-३२-२१", "content_sanskrit": "बलेः पुत्रशतं त्वासीदशनायां मुनीश्वर ।\nबलिरासीन्महाशैवः शिवभक्तिपरायणः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001385021, "chapter_id": 21385, "verse_number": "५-३२-२२", "content_sanskrit": "दानशील उदारश्च पुण्यकीर्ति तपाः स्मृतः ।\nतत्पुत्रो बाणनामा यत्सोऽषि शैववरस्सुधीः ।\nयस्संतोष्य शिवं सम्यग्गाणपत्यमवाप ह॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001385022, "chapter_id": 21385, "verse_number": "५-३२-२३", "content_sanskrit": "सा कथा श्रुतपूर्वा ते बाणस्य हि महात्मनः ।\nकृष्णं यस्समरे वीरस्सुप्रसन्नं चकार ह॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001385023, "chapter_id": 21385, "verse_number": "५-३२-२४", "content_sanskrit": "हिरण्याक्षसुताः पंच पंडितास्तु महाबलाः ।\nकुकुरः शकुनिश्चैव भूतसंतापनस्तथा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001385024, "chapter_id": 21385, "verse_number": "५-३२-२५", "content_sanskrit": "महानादश्च विक्रांतः कालनाभस्तथैव च ।\nइत्युक्ता दितिपुत्राश्च दनोः पुत्रान्मुने शृणु॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001385025, "chapter_id": 21385, "verse_number": "५-३२-२६", "content_sanskrit": "अभवन्दनुपुत्राश्च शतं तीव्रपराक्रमाः ।\nअयोमुखश्शंबरश्च कपोलो वामनस्तथा॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001385026, "chapter_id": 21385, "verse_number": "५-३२-२७", "content_sanskrit": "वैश्वानरः पुलोमा च विद्रावणमहाशिरौ ।\nस्वर्भानुर्वृषपर्वा च विप्रचित्तिश्च वीर्यवान्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001385027, "chapter_id": 21385, "verse_number": "५-३२-२८", "content_sanskrit": "एते सर्वे दनोः पुत्राः कश्यपादनुजज्ञिरे ।\nएषां पुत्राञ्च्छृणु मुने प्रसंगाद्वच्मि तेऽनघ॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001385028, "chapter_id": 21385, "verse_number": "५-३२-२९", "content_sanskrit": "स्वभार्नोस्तु प्रभा कन्या पुलोम्नस्तु शची सुता ।\nउपदानवी हयशिरा शर्म्मिष्ठा वार्षपर्वणी॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001385029, "chapter_id": 21385, "verse_number": "५-३२-३०", "content_sanskrit": "पुलोमा पुलोमिका चैव वैश्वानरसुते उभे ।\nबह्वपत्ये महावीर्य्ये मारीचेस्तु परिग्रहः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001385030, "chapter_id": 21385, "verse_number": "५-३२-३१", "content_sanskrit": "तयोः पुत्रसहस्राणि षष्टिर्दानवनन्दनाः ।\nमरीचिर्जनयामास महता तपसान्वितः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001385031, "chapter_id": 21385, "verse_number": "५-३२-३२", "content_sanskrit": "पौलोमाः कालखंजाश्च दानवानां महाबला ।\nअवध्या देवतानां च हिरण्यपुरवासिनः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001385032, "chapter_id": 21385, "verse_number": "५-३२-३३", "content_sanskrit": "पितामहप्रसादेन ये हताः सव्यसाचिना ।\nसिंहिकायामथोत्पन्ना विप्रचित्तेस्सुतास्तथा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001385033, "chapter_id": 21385, "verse_number": "५-३२-३४", "content_sanskrit": "दैत्यदानवसंयोगाज्जातास्तीव्रपराक्रमाः ।\nसैंहिकेया इति ख्यातास्त्रयोदश महाबलाः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001385034, "chapter_id": 21385, "verse_number": "५-३२-३५", "content_sanskrit": "राहुः शल्यो सुबलिनो बलश्चैव महाबलः ।\nवातापिर्नमुचिश्चैवाथेल्वलः स्वसृपस्तथा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001385035, "chapter_id": 21385, "verse_number": "५-३२-३६", "content_sanskrit": "अजिको नरकश्चैव कालनाभस्तथैव च ।\nशरमाणश्शरकल्पश्च एते वंशविवर्द्धनाः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001385036, "chapter_id": 21385, "verse_number": "५-३२-३७", "content_sanskrit": "एषां पुत्राश्च पौत्राश्च दनुवंशविवर्द्धनाः ।\nबहवश्च समुद्भूता विस्तरत्वान्न वर्णिताः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001385037, "chapter_id": 21385, "verse_number": "५-३२-३८", "content_sanskrit": "संह्रादस्य तु दैतेया निवातकवचाः कुले ।\nउत्पन्ना मरुतस्तस्मिंस्तपसा भावितात्मनः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001385038, "chapter_id": 21385, "verse_number": "५-३२-३९", "content_sanskrit": "षण्मुखाद्या महासत्त्वास्ताम्रायाः परिकीर्तिताः ।\nकाकी श्येनी च भासी च सुग्रीवी च शुकी तथा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001385039, "chapter_id": 21385, "verse_number": "५-३२-४०", "content_sanskrit": "गृद्ध्रिकाश्वी ह्युलूकी च ताम्रा कन्याः प्रकीर्तिताः ।\nकाकी काकानजनयदुलूकी प्रत्युलूककान्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001385040, "chapter_id": 21385, "verse_number": "५-३२-४१", "content_sanskrit": "श्येनी श्येनांस्तथा भासी भासा न्गृद्धी तु गृध्रकान् ।\nशुकी शुकानजनयत्सुग्रीवी शुभपक्षिणः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001385041, "chapter_id": 21385, "verse_number": "५-३२-४२", "content_sanskrit": "अश्वानुष्ट्रान्गर्दभांश्च ताम्रा च कश्यपप्रिया ।\nजनयामास चेत्येवं ताम्रावंशाः प्रकीर्तिताः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001385042, "chapter_id": 21385, "verse_number": "५-३२-४३", "content_sanskrit": "विनतायाश्च पुत्रौ द्वावरुणो गरुडस्तथा ।\nसुपर्णः पततां श्रेष्ठो नारुणस्स्वेन कर्मणा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001385043, "chapter_id": 21385, "verse_number": "५-३२-४४", "content_sanskrit": "सुरसायास्सहस्रं तु सर्पाणाममितौजसाम् ।\nअनेकशिरसां तेषां खेचराणां महात्मनाम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001385044, "chapter_id": 21385, "verse_number": "५-३२-४५", "content_sanskrit": "येषां प्रधाना राजानः शेषवासुकितक्षकाः ।\nऐरावतो महापद्मः कंबलाश्वतरावुभौ॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001385045, "chapter_id": 21385, "verse_number": "५-३२-४६", "content_sanskrit": "ऐलापुत्रस्तथा पद्मः कर्कोटकधनंजयौ ।\nमहानीलमहाकर्णौ धृतराष्ट्रो बलाहकः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001385046, "chapter_id": 21385, "verse_number": "५-३२-४७", "content_sanskrit": "कुहरः पुष्पदन्तश्च दुर्मुखास्सुमुखस्तथा ।\nबहुशः खररोमा च पाणिरित्येवमादयः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001385047, "chapter_id": 21385, "verse_number": "५-३२-४८", "content_sanskrit": "गणाः क्रोधवशायाश्च तस्यास्सर्वे च दंष्ट्रिणः ।\nअंडजाः पक्षिणोऽब्जाश्च वराह्याः पशवो मताः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001385048, "chapter_id": 21385, "verse_number": "५-३२-४९", "content_sanskrit": "अनायुषायाः पुत्राश्च पंचाशच्च महाबलाः ।\nअभवन्बलवृक्षौ च विक्षरोऽथ बृहंस्तथा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001385049, "chapter_id": 21385, "verse_number": "५-३२-५०", "content_sanskrit": "शशांस्तु जनयामास सुररभिर्महिषांस्तथा ।\nइला वृक्षांल्लता वल्लीस्तृणजातीस्तु सर्वशः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001385050, "chapter_id": 21385, "verse_number": "५-३२-५१", "content_sanskrit": "खशा तु यक्षरक्षांसि मुनिरप्सरसस्तथा ।\nअरिष्टासूत सर्पांश्च प्रभावैर्मानवोत्तमान्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001385051, "chapter_id": 21385, "verse_number": "५-३२-५२", "content_sanskrit": "एते कश्यपदायादाः कीर्तितास्ते मुनीश्वर ।\nयेषां पुत्राश्च पौत्राश्च शतशोऽथ सहस्रशः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]