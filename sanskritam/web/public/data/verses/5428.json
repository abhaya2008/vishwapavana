[{"id": 2207632, "chapter_id": 5428, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207633, "chapter_id": 5428, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nनिबोध दशहोतॄणां विधानमिह यादृशम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207634, "chapter_id": 5428, "verse_number": "२", "content_sanskrit": "श्रोत्रं त्वक् चक्षुषी जिह्वा नासिका चरणौ करौ ।\nउपस्थं पायुरिति वा होतॄणि दश भामिनि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207635, "chapter_id": 5428, "verse_number": "३", "content_sanskrit": "शब्दस्पर्शौ रूपरसौ गन्धो वाक्यं क्रिया गतिः ।\nरेतोमूत्रपुरीषाणां त्यागो दश हवींषि च\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207636, "chapter_id": 5428, "verse_number": "४", "content_sanskrit": "दिशो वायू रविश्चन्द्रः पृथ्वग्नी विष्णुरेव च ।\nइन्द्रः प्रजापतिर्मित्रमग्नयो दश भामिनि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207637, "chapter_id": 5428, "verse_number": "५", "content_sanskrit": "दशेन्द्रियाणि होतॄणि हवींषि दश भामिनि ।\nविषया नाम समिधो हूयन्ते तु दशाग्निषु\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207638, "chapter_id": 5428, "verse_number": "६", "content_sanskrit": "चित्रं स्रुवश्च वित्तं च पवित्रं ज्ञानमुत्तमम् ।\nसुविभक्तमिदं सर्वं जगदासीदिति श्रुतम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207639, "chapter_id": 5428, "verse_number": "७", "content_sanskrit": "सर्वमेवात्र विज्ञेयं चित्तं ज्ञानमवेक्षते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207640, "chapter_id": 5428, "verse_number": "८", "content_sanskrit": "चेतः शरीरभोक्ता यो विज्ञाता तु शरीरभृत् ।\nशरीरभृद् गार्हपत्यस्तस्मादन्यः प्रणीयते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207641, "chapter_id": 5428, "verse_number": "९", "content_sanskrit": "ततश्चाहवनीयस्तु तस्मिन् प्रक्षिप्यते हविः ।\nततो वाचस्पतिर्यज्ञे मनसा पर्यवेक्षते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207642, "chapter_id": 5428, "verse_number": "१०", "content_sanskrit": "रूपं भवति वै वक्त्रं तदनुद्रवते मनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207643, "chapter_id": 5428, "verse_number": "", "content_sanskrit": "ब्राह्मणी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207644, "chapter_id": 5428, "verse_number": "११", "content_sanskrit": "कस्माद् वागभवत् पूर्वं कस्मात् पश्चान्मनोऽभवत् ।\nमनसा चिन्तितं पूर्वं वाक्यं समभिपद्यते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207645, "chapter_id": 5428, "verse_number": "१२", "content_sanskrit": "केन विज्ञानयोगेन मतिश्चित्तं समाप्नुते ।\nसमुन्नीता नाधिगच्छेत् को वैनां प्रतिषेधति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207646, "chapter_id": 5428, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2207647, "chapter_id": 5428, "verse_number": "१३", "content_sanskrit": "तामुदानः पतिर्भूत्वा तस्मात् प्रेक्षत्यपानिति ।\nतां मतिं मनसः प्राहुर्मनस्तस्मादवेक्षते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2207648, "chapter_id": 5428, "verse_number": "१४", "content_sanskrit": "प्रश्नं तु वै वाङ्मनसोर्यस्मात् त्वमनुपृच्छसि ।\nतस्मात् ते वर्तयिष्यामि तयोरेव समाह्वयम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2207649, "chapter_id": 5428, "verse_number": "१५", "content_sanskrit": "उभे वाङ्मनसी गत्वा भूतात्मानमपृच्छताम् ।\nआवयोः श्रेष्ठमाचक्ष्व च्छिन्धि नौ संशयं विभो\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2207650, "chapter_id": 5428, "verse_number": "१६", "content_sanskrit": "मन इत्येव भगवान् तदा प्राह सरस्वतीम् ।\nअहं वै कामधुक् तुभ्यमिति तं प्राह वागथ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2207651, "chapter_id": 5428, "verse_number": "", "content_sanskrit": "प्रजापतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2207652, "chapter_id": 5428, "verse_number": "१७", "content_sanskrit": "स्थावरं जङ्गमं चैव विद्ध्युभे मनसी मम ।\nस्थावरं मत्सकाशे वै जङ्गमं विषये तव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2207653, "chapter_id": 5428, "verse_number": "१८", "content_sanskrit": "यत्तु ते विषयं गच्छन् मन्त्रो वर्णः स्वरोऽपि वा ।\nतन्मनो जङ्गमं नाम तस्मादपि गरीयसी\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2207654, "chapter_id": 5428, "verse_number": "१९", "content_sanskrit": "यस्मादिदं तु(त्वं) मा वोचः स्वयमभ्येत्य शोभने ।\nतस्मादुच्छ्वासमासाद्य मा वक्ष्यसि सरस्वति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2207655, "chapter_id": 5428, "verse_number": "२०", "content_sanskrit": "प्राणापानान्तरे तस्माद् आवां नित्यं प्रतिष्ठिताम् ।\nप्रीयमाणं महाभागे विना प्राणमपानिति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2207656, "chapter_id": 5428, "verse_number": "२१", "content_sanskrit": "प्रजापतिमुपाधावत् प्रसीद भगवन्निति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2207657, "chapter_id": 5428, "verse_number": "२२", "content_sanskrit": "ततः प्राणः प्रादुरभूद् वाचमाप्याययन्नपि ।\nतस्मादुच्छ्वासमासाद्य न वाग्वदति कर्हिचित्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2207658, "chapter_id": 5428, "verse_number": "२३", "content_sanskrit": "घोषिणी जातनिर्घोषा नित्यमेषा प्रवर्तते ।\nतयोरपि च घोषिण्या निर्घोषैव गरीयसी\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2207659, "chapter_id": 5428, "verse_number": "२४", "content_sanskrit": "गौरिव प्रस्रवत्यर्थान् रसमुत्तमपालिनी ।\nसततं स्यन्दते ह्येषा शाश्वती ब्रह्मवादिनी\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2207660, "chapter_id": 5428, "verse_number": "२५", "content_sanskrit": "दिव्या दिव्यप्रभावेण भारती गौः शुचिस्मिता ।\nएतयोरन्तरं पश्य सूक्ष्मयोः स्यन्दमानयोः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2207661, "chapter_id": 5428, "verse_number": "", "content_sanskrit": "ब्राह्मणी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2207662, "chapter_id": 5428, "verse_number": "२६", "content_sanskrit": "अनुत्पन्नेषु वाक्येषु चोद्यमाना सिसृक्षया ।\nकिं नु पूर्वं ततो देवी व्याजहार सरस्वती\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2207663, "chapter_id": 5428, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2207664, "chapter_id": 5428, "verse_number": "२७", "content_sanskrit": "प्राणेन या संश्रयते शरीरे\nप्राणादपानं प्रतिपद्यते तु ।\nउदानभूता च विसृज्य देहं\nव्यानेन सर्वां दिवमावृणोति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2207665, "chapter_id": 5428, "verse_number": "२८", "content_sanskrit": "ततः समाने प्रतितिष्ठतीह\nइत्येव सर्वं प्रजजल्प वागपि ।\nतस्मान्मनः स्थावरत्वात् विशिष्टः\nतथा देवी जङ्गमत्वाद् विशिष्टा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2207666, "chapter_id": 5428, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nआश्वमेधिकपर्वणि वाङ्मनोविहारकथनं नाम द्वाविंशोऽध्यायः ॥२२॥\nअनुगीतापर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]