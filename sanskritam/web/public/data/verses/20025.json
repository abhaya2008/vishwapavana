[{"id": 7000025000, "chapter_id": 20025, "verse_number": "२५-१", "content_sanskrit": "तत्रादौ सर्वतीर्थमाहात्म्यवर्णनम् मुनय ऊचुः पृथिव्यां यानि तीर्थानि पुण्यान्यायतनानि च ।\nवक्तुमर्हसि धर्म्मज्ञ श्रोतुं नो वर्त्तते मनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000025001, "chapter_id": 20025, "verse_number": "२५-२", "content_sanskrit": "यस्य हस्तौ च पादौ च मनश्चैव सुसंयत्म् ।\nविद्या तपश्च कीर्त्तिश्च स तोर्थफलमश्नुते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000025002, "chapter_id": 20025, "verse_number": "२५-३", "content_sanskrit": "मनो विशुद्धं पुरुषस्य तीर्थं वाचां तथा चेन्द्रियनिग्रहश्च ।\nएतानि तीर्थानि शरीरजानि, स्वर्गस्य मार्गं प्रतिबोधयन्ति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000025003, "chapter_id": 20025, "verse_number": "२५-४", "content_sanskrit": "चित्तमन्तर्गतं दुष्टं तीर्थस्नानैर्न शुध्यति ।\nशतशोऽपि जलैर्धौतं सुराभाण्डमिवाशुचि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000025004, "chapter_id": 20025, "verse_number": "२५-५", "content_sanskrit": "न तीर्थानि न दानानि न व्रतानि न चाश्रमाः ।\nदुष्टाशयं दम्भरुचि पुनन्ति व्युत्थितेन्द्रियम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000025005, "chapter_id": 20025, "verse_number": "२५-६", "content_sanskrit": "इन्द्रियाणि वशे कृत्वा यत्र वसेन्नरः ।\nतत्र तत्र कुरुक्षेत्रं प्रयागं पुष्करं तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000025006, "chapter_id": 20025, "verse_number": "२५-७", "content_sanskrit": "तस्माच्छृणुध्वं वक्ष्यामि तीर्थान्यायतनानि च ।\nसंक्षेपेण मुनिश्रेष्ठाः पृतिव्यां यानि कानि वै ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000025007, "chapter_id": 20025, "verse_number": "२५-८", "content_sanskrit": "विस्तरेण न शक्यन्ते वक्तुं वर्षशतैरपि ।\nप्रथमं पुष्करं तीर्थं नैमिषारण्यमेव च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000025008, "chapter_id": 20025, "verse_number": "२५-९", "content_sanskrit": "प्रयागञ्च प्रवक्ष्यामि धर्म्मारण्यं द्विजोत्तमाः ।\nधेनुकं चम्पकारण्यं सैन्धवारण्यमेव च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000025009, "chapter_id": 20025, "verse_number": "२५-१०", "content_sanskrit": "पुण्यञ्च मगधारण्यं दण्डकारण्यमेव च ।\nगया प्रभासं श्रीतीर्थं दिव्यं कनखलं तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000025010, "chapter_id": 20025, "verse_number": "२५-११", "content_sanskrit": "भृगुतुङ्गं हिरण्याक्षं भीमारण्यं कुशस्थलीम् ।\nलोहाकुलं सकेदारं मन्दरारण्यमेव च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000025011, "chapter_id": 20025, "verse_number": "२५-१२", "content_sanskrit": "महाबलंम कोटितीर्थं सर्व्वपापहरं तथा ।\nरूपतीर्थं शूकरवं चक्रतीर्थं महाफलम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000025012, "chapter_id": 20025, "verse_number": "२५-१३", "content_sanskrit": "योगतीर्थं सोमतीर्थं तीर्थं साहोटक्रं तथा ।\nतीर्थं कोकामुकं पुण्यं बदरोशैलमेव च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000025013, "chapter_id": 20025, "verse_number": "२५-१४", "content_sanskrit": "सोमतीर्थ तुङ्गकूटं तीर्थं स्कन्दाश्रमं तथा ।\nकोटितीर्थञ्चाग्निपदं तीर्थ पञ्चशिखं तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000025014, "chapter_id": 20025, "verse_number": "२५-१५", "content_sanskrit": "धर्म्मोद्भवं कोटितीर्थं तीर्थं बाधप्रमोचनम् ।\nगङ्गाद्वारं पञ्चकूटं मघ्यकेसरमेव च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000025015, "chapter_id": 20025, "verse_number": "२५-१६", "content_sanskrit": "चक्रप्रभं मतङ्गञ्च क्रुशदण्डञ्च विश्रुतम् ।\nदंष्ट्राकुण्डं विष्णुतीर्थं सार्व्वकामिकमेव च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000025016, "chapter_id": 20025, "verse_number": "२५-१७", "content_sanskrit": "तीर्थं मत्स्यतिलञ्चैव वदरी सुप्रभं तथा ।\nब्रह्मकुण्डं वह्निकुण्डं तीर्थं सत्यपदं तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000025017, "chapter_id": 20025, "verse_number": "२५-१८", "content_sanskrit": "चतुःस्रोतश्चतुःश्रृङ्गं शैलं द्वादशधारकम् ।\nमानसं स्थूलश्रृङ्गञ्च स्थूलदण्डं तथोर्व्वशी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000025018, "chapter_id": 20025, "verse_number": "२५-१९", "content_sanskrit": "लोकपालं मनुवरं सोमाह्वं शैलमेव च ।\nसदाप्रभं मेरुकुण्डं तीर्थं सोमाभिषेचनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000025019, "chapter_id": 20025, "verse_number": "२५-२०", "content_sanskrit": "महास्रोतं क्रोटरक्रं पञ्चधारं त्रिधारकम् ।\nसप्तधारैकधारञ्च तीर्थं चामपकण्टकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000025020, "chapter_id": 20025, "verse_number": "२५-२१", "content_sanskrit": "सालग्रामं चक्रतीर्थं कोटिद्रुममनुत्तमम् ।\nविल्वप्रभं देवह्रदं तीर्थं विष्णुह्रदं तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000025021, "chapter_id": 20025, "verse_number": "२५-२२", "content_sanskrit": "शङ्खप्रभं देवसुण्डं तीर्थं वज्रायुधं तथा ।\nअग्निप्रभञ्च पुन्नागं देवप्रभमनुत्तमम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000025022, "chapter_id": 20025, "verse_number": "२५-२३", "content_sanskrit": "विद्याधरं सगान्धर्व्वं श्रीतीर्तं ब्रह्मणो ह्रदम् ।\nसातीर्थं लोकपालाख्यं मणिपूरगिरं तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000025023, "chapter_id": 20025, "verse_number": "२५-२४", "content_sanskrit": "तीथै पञ्चह्रदञ्चैव पुण्यं पिण्डारकं तथा ।\nमलव्यं गोप्रभावञ्च गोवरं व़मूलकम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000025024, "chapter_id": 20025, "verse_number": "२५-२५", "content_sanskrit": "स्नानदण्डं प्रयागञ्च गह्यं विष्णुपदं तथा ।\nकन्याश्रमं वायुकुण्डं जम्बूमार्ग तथोत्तमम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000025025, "chapter_id": 20025, "verse_number": "२५-२६", "content_sanskrit": "गभस्तितीर्थञ्च तथा ययातिपतनं शुचि ।\nकोटितीर्थं भद्रवटं महाकालवनं तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000025026, "chapter_id": 20025, "verse_number": "२५-२७", "content_sanskrit": "नर्म्मदातीर्थमपरं तीर्थव्रज्रं चतथार्व्वुदम् ।\nपिङ्गुतीर्थं सवासिष्ठं तीर्थञ्च पृथुसङ्गमम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000025027, "chapter_id": 20025, "verse_number": "२५-२८", "content_sanskrit": "तीर्थं दौर्व्वासिकं नाम तथा पिञ्जरकं शुभम् ।\nऋषितुङ्गं वसुतीर्थं कुमारिकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000025028, "chapter_id": 20025, "verse_number": "२५-२९", "content_sanskrit": "शत्रुतीर्थं पञ्चनदं रेणुकातीर्थमेव च ।\nपैतामहञ्च विमलं रुद्रपादं तथोत्तमम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000025029, "chapter_id": 20025, "verse_number": "२५-३०", "content_sanskrit": "मणिमत्तञ्च कामाख्यं कृष्णतीर्थं कुशावितम् ।\nयजनं याजनञ्चैव तथैव ब्रह्मवालुकम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000025030, "chapter_id": 20025, "verse_number": "२५-३१", "content_sanskrit": "पुष्पन्यासं पुण्डरीकं मणिपूरं तथोत्तरम् ।\nदीर्घसत्रं हयपदं तीर्थ चानशनं तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000025031, "chapter_id": 20025, "verse_number": "२५-३२", "content_sanskrit": "गङ्गोद्‌भेदं शिवोद्‌भेदं नर्म्मदोद्‌भेदमेव च ।\nवस्त्रापदं दारुबलं छायारोहणमेव च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000025032, "chapter_id": 20025, "verse_number": "२५-३३", "content_sanskrit": "सिद्धेश्वरं मित्रबलं कालिकाश्रममेव च ।\nवटावटं भद्रवटं कौशाम्बी च दिवाकरम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000025033, "chapter_id": 20025, "verse_number": "२५-३४", "content_sanskrit": "द्वीपं सारस्वतञ्चैव विजयं कामदं तथा ।\nरुद्रकोटिं सुमनसं तीर्थं सद्रादनामितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000025034, "chapter_id": 20025, "verse_number": "२५-३५", "content_sanskrit": "स्यमन्तपञ्चकं तीर्थं ब्रह्मतीर्थं सुदर्शनम् ।\nसततं पऋतिवीसर्व्व पारिप्लवपृथूदकौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000025035, "chapter_id": 20025, "verse_number": "२५-३६", "content_sanskrit": "दशाश्वमेधिकं तीर्थं सर्पिजं विषयान्तिकम् ।\nकोटितीर्थं पञ्चनदं वाराहं यक्षिणीह्रदम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000025036, "chapter_id": 20025, "verse_number": "२५-३७", "content_sanskrit": "पुण्‍रीकं सोमतीर्थं मृञ्जवाटं तथोत्तमम् ।\nबदरीवनमासीनं रत्नमुलकमेव च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000025037, "chapter_id": 20025, "verse_number": "२५-३८", "content_sanskrit": "लोकद्वारं पञ्चतीर्थं कपिलातीर्थमेव च ।\nसूर्य्यतीर्थं शङ्खिनी च गवां भवनमेव च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000025038, "chapter_id": 20025, "verse_number": "२५-३९", "content_sanskrit": "तीर्थञ्च यक्षराजस्य ब्रह्मवर्त्तं सुतीर्थकम् ।\nकामेश्वरं मातृतीर्थं तीर्थं शीतवनं तथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000025039, "chapter_id": 20025, "verse_number": "२५-४०", "content_sanskrit": "स्नानलोमाप़हञ्चैव माससंसरकं तथा ।\nदशाश्वमेधं केदारं ब्रह्मोतुम्बरमेव च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000025040, "chapter_id": 20025, "verse_number": "२५-४१", "content_sanskrit": "सप्तर्षिकुण्डञ्च तथा तीर्थं देव्याः सुजम्बुकम् ।\nईहास्पदं कोटिकूटं किन्दानं किञ्जपं तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000025041, "chapter_id": 20025, "verse_number": "२५-४२", "content_sanskrit": "कारण्डवं चावेध्यञ्च त्रिविष्टपमथापरम् ।\nपाणिखातं मिश्रकञ्च मधूवटमनोजवौ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000025042, "chapter_id": 20025, "verse_number": "२५-४३", "content_sanskrit": "कौशिकी देवतीर्तञ्च तीर्थञ्च ऋणमोचनम् ।\nदिव्यञ्च नृगधूमाख्यं तीर्थं विष्णुपदं तथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000025043, "chapter_id": 20025, "verse_number": "२५-४४", "content_sanskrit": "अमराणां ह्रदं पुण्यं कोटितीर्थं तथापरम् ।\nश्रीकुञ्जं शालितीर्थञ्च मधूवटमनोजवौ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000025044, "chapter_id": 20025, "verse_number": "२५-४५", "content_sanskrit": "ब्रह्मस्थानं सोमतीर्थं कन्यातीर्थं तथैव च ।\nब्रह्मतीर्थं मनस्तीर्थं तीर्थं वै कारुपावनम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000025045, "chapter_id": 20025, "verse_number": "२५-४६", "content_sanskrit": "सौगन्धिकवनञ्चैव मणितीर्थं सरस्वती ।\nईशानतीर्थं प्रवरं पावनं पाञ्चयज्ञिकम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000025046, "chapter_id": 20025, "verse_number": "२५-४७", "content_sanskrit": "त्रिशूलधारं माहेन्द्रं देवस्थानं कृतालयम् ।\nशाकम्भरी देवतीर्थं सुवर्णक्षिं कर्लि ह्रदम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000025047, "chapter_id": 20025, "verse_number": "२५-४८", "content_sanskrit": "क्षीरस्रवं विरूपाक्षं भृगुतीर्थं कुशोद्‌भवम् ।\nब्रह्मतीर्थं ब्रह्मयोनिं नीलपर्व्वतमेव च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000025048, "chapter_id": 20025, "verse_number": "२५-४९", "content_sanskrit": "कुब्जाम्बकं भद्रवटं वसिष्ठपदमेव च ।\nस्वर्गद्वारं प्रजाद्वारं कालिकाश्रममेव च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000025049, "chapter_id": 20025, "verse_number": "२५-५०", "content_sanskrit": "रुद्रावर्त्तं सुगन्धाश्वं कपिलावनमेव च ।\nभद्रकर्णह्रदञ्चैव शङ्कुकर्णह्रदं तथा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000025050, "chapter_id": 20025, "verse_number": "२५-५१", "content_sanskrit": "सप्तसारस्वतञ्चैव तीर्थेमौशनसं तथा ।\nकपालमोचनञ्चैव अवकीर्णञ्च काम्यकम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000025051, "chapter_id": 20025, "verse_number": "२५-५२", "content_sanskrit": "चतुःसामुद्रिकञ्चैव शतिकञ्च सहस्रिकम् ।\nरेणुकं पञ्चवटकं विमोचनमथौजसम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000025052, "chapter_id": 20025, "verse_number": "२५-५३", "content_sanskrit": "स्थाणुतीर्थं कुरोस्तीर्थं स्वर्गद्वारं कुशध्वजम् ।\nविश्वेश्वरं मानवकं कूपं नारायणाश्रयम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000025053, "chapter_id": 20025, "verse_number": "२५-५४", "content_sanskrit": "गङ्गाह्रदं बटञ्चैव वदरीपाटनं तथा ।\nइन्द्रमार्गमेकरात्रं क्षीरकावासमेव च ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000025054, "chapter_id": 20025, "verse_number": "२५-५५", "content_sanskrit": "सोमतीर्थं दधीचञ्च श्रुततीर्थञ्च भो द्विजाः ।\nकोटितीर्थस्थलीञ्चैव भद्रकालीह्रदं तथा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000025055, "chapter_id": 20025, "verse_number": "२५-५६", "content_sanskrit": "अरुन्धतीवनञ्चैव ब्रह्मावर्त्तं तथोत्तमम् ।\nअश्ववेदी कुब्जावनं यमुनाप्रभवं तथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000025056, "chapter_id": 20025, "verse_number": "२५-५७", "content_sanskrit": "वोरं प्रमोक्षं सिन्धूत्थमृषिकुल्या सकृत्तिकम् ।\nउर्व्वीसंक्रमणञ्चैव मायाविद्योद्‌भवं तथा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000025057, "chapter_id": 20025, "verse_number": "२५-५८", "content_sanskrit": "महाश्रमो वैतसिकारूपं सुन्दरिकाश्रमम् ।\nबाहुतीर्थं चारुनदीं विमलीसोकमेव च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000025058, "chapter_id": 20025, "verse_number": "२५-५९", "content_sanskrit": "तीर्थं पञ्चदञ्चैव मार्कण्डेयस्य धीमतः ।\nसोमतीर्थ सितोदञ्च तीर्थं मतस्योदरी तथा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000025059, "chapter_id": 20025, "verse_number": "२५-६०", "content_sanskrit": "सूर्य्यप्रभं सूर्यतीर्थमसोकवनमेव च ।\nअरुणास्पदं कामदञ्च सुक्रतीर्थं सवालुकम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000025060, "chapter_id": 20025, "verse_number": "२५-६१", "content_sanskrit": "पिशाचमोचऩञ्चैव सुभद्राह्रदमेव च ।\nकुण्डं विमलदण्डस्य तीर्थं चण्डेश्वरस्य च ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000025061, "chapter_id": 20025, "verse_number": "२५-६२", "content_sanskrit": "ज्येष्ठस्थानह्रदञ्चैव पुण्यं ब्रह्मसरं तथा ।\nजैगीषव्यगुहा चैव हरिकेशवनं तथा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000025062, "chapter_id": 20025, "verse_number": "२५-६३", "content_sanskrit": "अजामुखसरञ्चैव घण्टाकर्णह्रदं तथा ।\nपुण्डरीकह्रदञ्चैव वापी कर्कोटकस्य च ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000025063, "chapter_id": 20025, "verse_number": "२५-६४", "content_sanskrit": "सुवर्णास्योदपानञ्च विनायकह्रवं तथा ।\nकुण्डं घर्घरिकायाश्च श्यामाकूपञ्च चन्द्रिका ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000025064, "chapter_id": 20025, "verse_number": "२५-६५", "content_sanskrit": "श्मशानस्तम्भकूपञ्च विनायकह्रदं तथा ।९ कूपं सिन्धूद्भञ्चैव पुण्यं ब्रह्मसरं तथा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000025065, "chapter_id": 20025, "verse_number": "२५-६६", "content_sanskrit": "रुद्रावासं तथा तीर्थं नागतीर्थं पुलोमकम् ।\nभक्तह्रदं क्षीपसरः प्रेताधारं कुमारकम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000025066, "chapter_id": 20025, "verse_number": "२५-६७", "content_sanskrit": "ब्रह्मावर्त्तं कुशावर्त्तं दधिकर्णोदपानकम् ।\nश्रृङ्गतीर्थं महातीर्थं तीर्थंश्रेष्ठा महानदी ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000025067, "chapter_id": 20025, "verse_number": "२५-६८", "content_sanskrit": "दिव्यं ब्रह्मसरं पुण्यं गयाशीर्षाक्षयं वटम् ।\nदक्षिणं चोत्तरञ्चैव गोमयं रूपशीतिकम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000025068, "chapter_id": 20025, "verse_number": "२५-६९", "content_sanskrit": "कपिलाह्रदं गृध्रवटं सावित्रीह्रदमेव च ।\nप्रभासनं सीतवनं योनिद्वारञ्च धेनुकम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000025069, "chapter_id": 20025, "verse_number": "२५-७०", "content_sanskrit": "धन्यकं कोकिलाख्यञ्च मतङ्गह्रदमेव च  ।\nपितृकूपं रुद्रतीर्थं शक्रतीर्थं सुमालिनम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000025070, "chapter_id": 20025, "verse_number": "२५-७१", "content_sanskrit": "ब्रह्मस्थानं सपतकुण्डं मणिरत्नह्रदं तथा ।\nकौशिक्यं भरतञ्चैव तीर्थं ज्येष्ठालिका तथा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000025071, "chapter_id": 20025, "verse_number": "२५-७२", "content_sanskrit": "विश्वेश्वरं कल्पसरः कन्यासंवेद्यमेव च ।\nनिश्चिवाप्रभवश्चैव वसिष्ठाश्रमममेव च ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000025072, "chapter_id": 20025, "verse_number": "२५-७३", "content_sanskrit": "देवकूटञ्च कूपञ्च वसिष्ठाश्रममेव च ।\nवीराश्रमं ब्रह्मसरो ब्रह्मवीरावकापिलो ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000025073, "chapter_id": 20025, "verse_number": "२५-७४", "content_sanskrit": "कुमारधारा श्रीधारा गौरीसिखरमेव च ।\nशुनः कुण्डोऽथ तीर्थञ्च नन्दितीर्थं तथाव च ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000025074, "chapter_id": 20025, "verse_number": "२५-७५", "content_sanskrit": "कुमारवासं श्रीवाससमौर्विशीतीर्थमेव च ।\nकुम्भकर्णह्रदञ्चैव कौशिकीह्रदमेव च ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000025075, "chapter_id": 20025, "verse_number": "२५-७६", "content_sanskrit": "धर्म्मतीर्थं कामतीर्थं तीर्थमुद्‌दालकं तथा ।\nसन्ध्यातीर्थं कारतोयं कपिलं लोहितार्णवम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000025076, "chapter_id": 20025, "verse_number": "२५-७७", "content_sanskrit": "शोणोद्‌भवं वंशगुल्ममृषभं कलतीर्थकम् ।\nपुण्यावतीह्रदं तीर्थं तीर्थं बदरिकाश्रमम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000025077, "chapter_id": 20025, "verse_number": "२५-७८", "content_sanskrit": "रामतीर्थं पितृवनं विरजातीर्थमेव च ।\nमार्गण्डेयवनञ्चैव कृष्णतीर्तं तथा वटम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000025078, "chapter_id": 20025, "verse_number": "२५-७९", "content_sanskrit": "रोहिणीकूपप्रवरमिन्द्रद्युम्नसरञ्च यत् ।\nसानुगर्त्तं समाहेन्द्रं श्रीतीर्थं श्रीनदं तथा ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000025079, "chapter_id": 20025, "verse_number": "२५-८०", "content_sanskrit": "इषुतीर्थं वार्षभञ्व कावेरीह्रदमेव च ।\nकन्यातीर्तञ्च गोकर्णं गायत्रीस्थानमेव च ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000025080, "chapter_id": 20025, "verse_number": "२५-८१", "content_sanskrit": "बदरीह्रदमन्यच्च मध्यस्थानं विकर्णकम् ।\nजीतीह्रदं देवकूपं कुशप्रवणमेव च ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000025081, "chapter_id": 20025, "verse_number": "२५-८२", "content_sanskrit": "सर्व्वदेवव्रतञ्चैव कन्याश्रमह्रदं तथा ।\nतथान्यद्वालखिल्यानां सपूर्व्वाणां तथापरम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000025082, "chapter_id": 20025, "verse_number": "२५-८३", "content_sanskrit": "तथान्यच्च महर्षीणामखण्डितह्रदं तथा ।\nतीर्थेष्वेतेषु विधिवत् सम्यक् श्रद्धासमन्वितः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000025083, "chapter_id": 20025, "verse_number": "२५-८४", "content_sanskrit": "स्नानं करोति यो मर्त्त्यः सोपवासो जितन्द्रियः ।\nदेवानृषीन्मनुष्यांश्च पितॄत् सन्तर्प्य च क्रमात् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000025084, "chapter_id": 20025, "verse_number": "२५-८५", "content_sanskrit": "अभ्यर्च्च्य देवतास्तत्र स्तित्वा च रजनीत्रयम् ।\nपृथक् पृथक् फलं तेषु प्रतितीर्थेषु भो द्विजाह ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000025085, "chapter_id": 20025, "verse_number": "२५-८६", "content_sanskrit": "प्राप्नोति हयमेधस्य नरो नास्त्यत्र संशयः ।\nयस्त्विदं शृणुयान्नित्यं तीर्थमाहात्म्यमुत्तमम् ।\nपठेच् श्रावयेद्‌वापि सर्व्वपापैः प्रमुच्यते ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]