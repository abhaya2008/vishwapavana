[{"id": 2074555, "chapter_id": 2575, "verse_number": "१२-८०-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074556, "chapter_id": 2575, "verse_number": "१२-८०-१", "content_sanskrit": "यदप्यल्पतरं कर्म तदप्येकेन दुष्करम्।\nपुरुषेणासहायेन किमु राज्यं पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074557, "chapter_id": 2575, "verse_number": "१२-८०-२", "content_sanskrit": "किंशीलः किंसमाचारो राज्ञो यः सचिवो भवेत्।\nकीदृशे विश्वसेद्राजा कीदृशे न च विश्वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074558, "chapter_id": 2575, "verse_number": "१२-८०-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074559, "chapter_id": 2575, "verse_number": "१२-८०-३", "content_sanskrit": "चतुर्विधानि मित्राणि राज्ञां राजन्भवन्त्युत।\nसहार्थो भजः निश्च सहजः कृत्रिमस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074560, "chapter_id": 2575, "verse_number": "१२-८०-४", "content_sanskrit": "धर्मात्मा पञ्चमं मित्रं स तु नैकस्य न द्वयोः।\nयतो धर्मस्ततो वा स्यान्मध्यस्थो वा ततो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074561, "chapter_id": 2575, "verse_number": "१२-८०-५", "content_sanskrit": "यो यस्यार्थो न रोचेत न तं तस्य प्रकाशयेत।\n`मित्राणां प्रकृतिर्नास्ति त्वमित्राणां च भारत।\nउपकाराद्भवेन्मित्रमपकाराद्भवेदरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074562, "chapter_id": 2575, "verse_number": "१२-८०-६", "content_sanskrit": "यस्यैव हि मनुष्यस्य नरो मरणमृच्छति।\nतस्य पर्यागते काले पुनर्जीवितुमिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074563, "chapter_id": 2575, "verse_number": "१२-८०-७", "content_sanskrit": "धर्माधर्मेण राजानश्चरन्ति विजिगीषवः।\nचतुर्णां मध्यमौ श्रेष्ठौ नित्यं शङ्क्यौ तथाऽपरौ।\nसर्वे नित्यं शङ्कितव्याः प्रत्यक्षं कार्यमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074564, "chapter_id": 2575, "verse_number": "१२-८०-८", "content_sanskrit": "न हि राज्ञा प्रमादो वै कर्तव्यो मित्ररक्षणे।\nप्रमादिनं हि राजानं लोकाः परिभवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074565, "chapter_id": 2575, "verse_number": "१२-८०-९", "content_sanskrit": "असाधुः साधुतामेति साधुर्भवति दारुणः।\nअरिश्च मित्रं भवति मित्रं चापि प्रदुष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074566, "chapter_id": 2575, "verse_number": "१२-८०-१०", "content_sanskrit": "अनित्यचित्तः पुरुषस्तस्मिन्को जातु विश्वसेत्।\nतस्मात्प्रधानं यत्कार्यं प्रत्यक्षं तत्समाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074567, "chapter_id": 2575, "verse_number": "१२-८०-११", "content_sanskrit": "एकान्तेन हि विश्वासः कृत्स्नो कर्मार्थनाशकः।\nअविश्वासश्च सर्वत्र मृत्युर्नापि विशिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074568, "chapter_id": 2575, "verse_number": "१२-८०-१२", "content_sanskrit": "अकालमृत्युर्विश्वासोऽविश्वसन्हि विपद्यते।\nयस्मिन्करोति विश्वासमिच्छतस्तस्य जीवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074569, "chapter_id": 2575, "verse_number": "१२-८०-१३", "content_sanskrit": "तस्माद्विश्वसितव्यं च शङ्कितव्यं च केषुचित्।\nएषा नीतिगतिस्तात लक्ष्मीश्चैषा सनातनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074570, "chapter_id": 2575, "verse_number": "१२-८०-१४", "content_sanskrit": "यं मन्येत ममाभावादिममर्थागमः स्पृशेत्।\nनित्यं तस्माच्छङ्कितव्यममित्रं तं विदुर्बुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074571, "chapter_id": 2575, "verse_number": "१२-८०-१५", "content_sanskrit": "यस्य क्षेत्रादप्युदकं क्षेत्रमन्यस्य गच्छति।\nन तत्रानिच्छतस्तस्य भिद्येरन्सर्वसेतवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074572, "chapter_id": 2575, "verse_number": "१२-८०-१६", "content_sanskrit": "तथैवात्युदकाद्भीतस्तस्य भेदनमिच्छति।\nयमेवंलक्षणं विद्यात्तममित्रं विदुर्बुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074573, "chapter_id": 2575, "verse_number": "१२-८०-१७", "content_sanskrit": "यस्तु वृद्ध्या न तप्येत क्षये दीनतरो भवेत्।\nएतदुत्तममित्रस्य निमित्तमभिचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074574, "chapter_id": 2575, "verse_number": "१२-८०-१८", "content_sanskrit": "यन्मन्येत ममाभावादस्याभावो भवेदिति।\nतस्मिन्कुर्वीत विश्वासं यथा पितरी वै तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074575, "chapter_id": 2575, "verse_number": "१२-८०-१९", "content_sanskrit": "तं शक्त्या वर्तमानं च सर्वतः परिबृंहयेत्।\nनित्यं क्षताद्वारयति यो धर्मेष्वपि कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074576, "chapter_id": 2575, "verse_number": "१२-८०-२०", "content_sanskrit": "क्षताद्भीतं विजानीयादुत्तमं मित्रलक्षणम्।\nये यस्य क्षयमिच्छन्ति ते तस्य रिपवः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074577, "chapter_id": 2575, "verse_number": "१२-८०-२१", "content_sanskrit": "व्यसनान्नित्यभीतो यः समृद्ध्या यो न दुष्यति।\nयत्स्यादेवंविधं मित्रं तदात्मसममुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074578, "chapter_id": 2575, "verse_number": "१२-८०-२२", "content_sanskrit": "रूपवर्णस्वरोपेतस्तितिक्षुरनसूयकः।\nकुलीनः शीलसंपन्नः स ते स्यात्प्रत्यनन्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074579, "chapter_id": 2575, "verse_number": "१२-८०-२३", "content_sanskrit": "मेधावी स्मृतिमान्दक्षः प्रकृत्या चानृशंस्यवान्।\nयो मानितोऽमानितो वा न सन्तुष्येत्कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074580, "chapter_id": 2575, "verse_number": "१२-८०-२४", "content_sanskrit": "ऋत्विग्वा यदि वाऽऽचार्यः सखा वाऽत्यंतसत्कृतः।\nगृहे वसेदमात्यस्ते स स्यात्परमपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074581, "chapter_id": 2575, "verse_number": "१२-८०-२५", "content_sanskrit": "संविद्याः परमं मित्रं प्रकृतिं चार्थधर्मयोः।\nविश्वासस्ते भवेत्तत्र यथा पितरि वै तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074582, "chapter_id": 2575, "verse_number": "१२-८०-२६", "content_sanskrit": "नैव द्वौ न त्रयः कार्या न मृष्येरन्परस्परम्।\nएकार्थे हेतुभूतानां भेदो भवति सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074583, "chapter_id": 2575, "verse_number": "१२-८०-२७", "content_sanskrit": "कीर्तिप्रधानो यस्त स्याद्यश्च स्यात्समये स्थितः।\nसमर्थान्यश्च न द्वेष्टि नानर्थान्कुरुते च यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074584, "chapter_id": 2575, "verse_number": "१२-८०-२८", "content_sanskrit": "यो न कामाद्भयाल्लोभात्क्रोधाद्वा धर्ममुत्सृजेत्।\nदक्षः पर्याप्तवचनः स ते स्यात्प्रत्यनन्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074585, "chapter_id": 2575, "verse_number": "१२-८०-२९", "content_sanskrit": "कुलीनः शीलसंपन्नस्तितिक्षुरविकत्थनः।\nशूरश्चार्यश्च विद्वांश्च प्रतिपत्तिविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074586, "chapter_id": 2575, "verse_number": "१२-८०-३०", "content_sanskrit": "एते ह्यमात्याः कर्तव्याः सर्वकर्मस्ववस्थिताः।\nपूजिताः संबिभक्ताश्च सुसहायाः स्वनुष्ठिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074587, "chapter_id": 2575, "verse_number": "१२-८०-३१", "content_sanskrit": "कृत्स्नप्रेते विनिक्षिप्ताः प्रतिरूपेषु कर्मसु।\nयुक्ता महत्सु कार्येषु श्रेयांस्युत्पादयन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074588, "chapter_id": 2575, "verse_number": "१२-८०-३२", "content_sanskrit": "एते कर्माणि कुर्वन्ति स्पर्धमाना मिथः सदा।\nअनुतिष्ठन्ति चैवार्थमाचक्षाणाः परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074589, "chapter_id": 2575, "verse_number": "१२-८०-३३", "content_sanskrit": "ज्ञातिभ्यो बिभियाश्चैव मृत्योरिव यतस्तदा।\nउपराजेव राजर्धि ज्ञातिर्न सहते सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2074590, "chapter_id": 2575, "verse_number": "१२-८०-३४", "content_sanskrit": "ऋजोर्मृदोर्वदान्यस्य ह्रीमतः सत्यवादिनः।\nनान्यो ज्ञातेर्महाबाहो विनाशमभिनन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2074591, "chapter_id": 2575, "verse_number": "१२-८०-३५", "content_sanskrit": "अज्ञातयोऽप्यसुखदा ज्ञातयोऽपि सुखावहाः।\nअज्ञातिमन्तं पुरुषं परे चाभिभवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2074592, "chapter_id": 2575, "verse_number": "१२-८०-३६", "content_sanskrit": "निकृतस्य नरैरन्यैर्ज्ञातिरेव परायणम्।\nनान्यो निकारं सहते ज्ञातिर्ज्ञातेः कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2074593, "chapter_id": 2575, "verse_number": "१२-८०-३७", "content_sanskrit": "आत्मानमेव जानाति निकृतं बान्धवैपरि।\nतेषु सन्ति गुणाश्चैव नैर्गुण्यं चैव लक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2074594, "chapter_id": 2575, "verse_number": "१२-८०-३८", "content_sanskrit": "नाज्ञातिरनुगृह्णाति नाज्ञातिर्वृद्धिमश्नुते।\nउभयं ज्ञातिवर्गेषु दृश्यते साध्वसाधु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2074595, "chapter_id": 2575, "verse_number": "१२-८०-३९", "content_sanskrit": "संमानयेत्पूजयेच्च वाचा नित्यं च कर्मणा।\nकुर्याच्च प्रियमेतेभ्यो नाप्रियं किंचिद चरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2074596, "chapter_id": 2575, "verse_number": "१२-८०-४०", "content_sanskrit": "विश्वस्तवदविश्वस्तस्तेषु वर्तेत सर्वदा\nन हि दोषो गुणो वेति निरूप्यस्तेषु दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2074597, "chapter_id": 2575, "verse_number": "१२-८०-४१", "content_sanskrit": "अस्यैवं वर्तमानस्य पुरुषस्याप्रमादिनः।\nअमित्राः संप्रसीदन्ति ततो मित्रं भवन्त्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2074598, "chapter_id": 2575, "verse_number": "१२-८०-४२", "content_sanskrit": "य एवं वर्तते नित्यं ज्ञातिसंबन्धिमण्डले।\nमित्रेष्वमित्रे मध्यस्थे चिरं यशसि तिष्ठति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2074599, "chapter_id": 2575, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि अशीतितमोऽध्यायः॥ ८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]