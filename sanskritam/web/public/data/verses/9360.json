[{"id": 40021597, "chapter_id": 9360, "verse_number": "1", "content_sanskrit": "विसृज्य च महाबाहुर्ऋक्षवानरराक्षसान् । भ्रातृभिः सहितो रामः प्रमुमोद सुखं सुखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021598, "chapter_id": 9360, "verse_number": "2", "content_sanskrit": "अथापराह्णसमये भ्रातृभिः सह राघवः । शुश्राव मधुरां वाणीमन्तरिक्षात् प्रभाषिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021599, "chapter_id": 9360, "verse_number": "3", "content_sanskrit": "सौम्य राम निरीक्षस्व सौम्येन वदनेन माम् । कुबेरभवनात्प्राप्तं विद्धि मां पुष्पकं प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021600, "chapter_id": 9360, "verse_number": "4", "content_sanskrit": "तव शासनमाज्ञाय गतो ऽस्मि भवनं प्रति । उपस्थातुं नरश्रेष्ठ स च मां प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021601, "chapter_id": 9360, "verse_number": "5", "content_sanskrit": "निर्जितस्त्वं नरेन्द्रेण राघवेण महात्मना । निहत्य युधि दुर्धर्षं रावणं राक्षसेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021602, "chapter_id": 9360, "verse_number": "6", "content_sanskrit": "ममापि परमा प्रीतर्हते तस्मिन्दुरात्मनि । रावणे सगणे चैव सपुत्रे सहबान्धवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021603, "chapter_id": 9360, "verse_number": "7", "content_sanskrit": "स त्वं रामेण लङ्कायां निर्जितः परमात्मना । वह सौम्य तमेव त्वमहमाज्ञापयामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021604, "chapter_id": 9360, "verse_number": "8", "content_sanskrit": "परमो ह्येष मे कामो यत्त्वं राघवनन्दनम् । वहेर्लोकस्य संयानं गच्छस्व विगतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021605, "chapter_id": 9360, "verse_number": "9", "content_sanskrit": "सो ऽहं शासनमाज्ञाय धनदस्य महात्मनः । त्वत्सकाशमनुप्राप्तो निर्विशङ्कः प्रतीक्ष माम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021606, "chapter_id": 9360, "verse_number": "10", "content_sanskrit": "अदृष्यः सर्वभूतानां सर्वेषां धनदाज्ञया । चराम्यहं प्रभावेण तवाज्ञां परिपालयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021607, "chapter_id": 9360, "verse_number": "11", "content_sanskrit": "एवमुक्तस्तदा रामः पुष्पकेण महाबलः । उवाच पुष्पकं दृष्ट्वा विमानं पुनरागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021608, "chapter_id": 9360, "verse_number": "12", "content_sanskrit": "यद्येवं स्वागतं ते ऽस्तु विमानवर पुष्पक । आनुकूल्याद्धनेशस्य वृत्तदोषो न नो भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021609, "chapter_id": 9360, "verse_number": "13", "content_sanskrit": "लाजैश्चैव तथा पुष्पैर्धूपैश्चैव सुगन्धिभिः । पूजयित्वा महाबाहू राघवः पुष्पकं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021610, "chapter_id": 9360, "verse_number": "14", "content_sanskrit": "गम्यतामिति चोवाच आगच्छ त्वं स्मरे यदा । सिद्धानां च गतौ सौम्य मा विषादेन योजय । प्रतिघातश्च ते मा भूद्यथेष्टं गच्छतो दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021611, "chapter_id": 9360, "verse_number": "15", "content_sanskrit": "एवमस्त्विति रामेण पूजयित्वा विसर्जितम् । अभिप्रेतां दिशं तस्मात्प्रायात्तत्पुष्पकं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021612, "chapter_id": 9360, "verse_number": "16", "content_sanskrit": "एवमन्तर्हिते तस्मिन्पुष्पके सुकृतात्मनि । भरतः प्राञ्जलिर्वाक्यमुवाच रघुनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021613, "chapter_id": 9360, "verse_number": "17", "content_sanskrit": "विविधात्मनि दृश्यन्ते त्वयि वीर प्रशासति । अमानुषाणां सत्त्वानां व्याहृतानि मुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021614, "chapter_id": 9360, "verse_number": "18", "content_sanskrit": "अनामयश्च सत्वानां साग्रो मासो गतो ह्ययम् । जीर्णानामपि सत्त्वानां मृत्युर्नायाति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021615, "chapter_id": 9360, "verse_number": "19", "content_sanskrit": "अरोगप्रसवा नार्यो वपुष्मन्तो हि मानवाः । हर्षश्चाभ्यधिको राजञ्जनस्य पुरवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021616, "chapter_id": 9360, "verse_number": "20", "content_sanskrit": "काले वर्षति पर्जन्यः पातयन्नमृतं पयः । वाताश्चापि प्रवान्त्येते स्पर्शयुक्ताः सुखाः शिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021617, "chapter_id": 9360, "verse_number": "21", "content_sanskrit": "ईदृशो ऽनश्वरो राजा भवेदिति नरेश्वरः । कथयन्ति पुरे राजन्पौरजानपदास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021618, "chapter_id": 9360, "verse_number": "22", "content_sanskrit": "एता वाचः सुमधुरा भरतेन समीरिताः । श्रुत्वा रामो मुदा युक्तो बभूव नृपसत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]