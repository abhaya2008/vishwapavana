[{"id": 5000360000, "chapter_id": 9360, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे एकविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000360001, "chapter_id": 9360, "verse_number": "५-२१-१", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा सीता रौद्रस्य रक्षसः।\nआर्ता दीनस्वरा दीनं प्रत्युवाच ततः शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000360002, "chapter_id": 9360, "verse_number": "५-२१-२", "content_sanskrit": "दुःखार्ता रुदती सीता वेपमाना तपस्विनी।\nचिन्तयन्ती वरारोहा पतिमेव पतिव्रता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000360003, "chapter_id": 9360, "verse_number": "५-२१-३", "content_sanskrit": "तृणमन्तरतः कृत्वा प्रत्युवाच शुचिस्मिता।\nनिवर्तय मनो मत्तः स्वजने प्रीयतां मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000360004, "chapter_id": 9360, "verse_number": "५-२१-४", "content_sanskrit": "न मां प्रार्थयितुं युक्तस्त्वं सिद्धिमिव पापकृत्।\nअकार्यं न मया कार्यमेकपत्न्या विगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000360005, "chapter_id": 9360, "verse_number": "५-२१-५", "content_sanskrit": "कुलं सम्प्राप्तया पुण्यं कुले महति जातया।\nएवमुक्त्वा तु वैदेही रावणं तं यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000360006, "chapter_id": 9360, "verse_number": "५-२१-६", "content_sanskrit": "रावणं पृष्ठतः कृत्वा भूयो वचनमब्रवीत्।\nनाहमौपयिकी भार्या परभार्या सती तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000360007, "chapter_id": 9360, "verse_number": "५-२१-७", "content_sanskrit": "साधु धर्ममवेक्षस्व साधु साधुव्रतं चर।\nयथा तव तथान्येषां रक्ष्या दारा निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000360008, "chapter_id": 9360, "verse_number": "५-२१-८", "content_sanskrit": "आत्मानमुपमां कृत्वा स्वेषु दारेषु रम्यताम्।\nअतुष्टं स्वेषु दारेषु चपलं चपलेन्द्रियम्।\nनयन्ति निकृतिप्रज्ञं परदाराः पराभवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000360009, "chapter_id": 9360, "verse_number": "५-२१-९", "content_sanskrit": "इह सन्तो न वा सन्ति सतो वा नानुवर्तसे।\nयथा हि विपरीता ते बुद्धिराचारवर्जिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000360010, "chapter_id": 9360, "verse_number": "५-२१-१०", "content_sanskrit": "वचो मिथ्याप्रणीतात्मा पथ्यमुक्तं विचक्षणैः।\nराक्षसानामभावाय त्वं वा न प्रतिपद्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000360011, "chapter_id": 9360, "verse_number": "५-२१-११", "content_sanskrit": "अकृतात्मानमासाद्य राजानमनये रतम्।\nसमृद्धानि विनश्यन्ति राष्ट्राणि नगराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000360012, "chapter_id": 9360, "verse_number": "५-२१-१२", "content_sanskrit": "तथैव त्वां समासाद्य लंका रत्नौघसंकुला।\nअपराधात् तवैकस्य नचिराद् विनशिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000360013, "chapter_id": 9360, "verse_number": "५-२१-१३", "content_sanskrit": "स्वकृतैर्हन्यमानस्य रावणादीर्घदर्शिनः।\nअभिनन्दन्ति भूतानि विनाशे पापकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000360014, "chapter_id": 9360, "verse_number": "५-२१-१४", "content_sanskrit": "एवं त्वां पापकर्माणं वक्ष्यन्ति निकृता जनाः।\nदिष्ट्यैतद् व्यसनं प्राप्तो रौद्र इत्येव हर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000360015, "chapter_id": 9360, "verse_number": "५-२१-१५", "content_sanskrit": "शक्या लोभयितुं नाहमैश्वर्येण धनेन वा।\nअनन्या राघवेणाहं भास्करेण यथा प्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000360016, "chapter_id": 9360, "verse_number": "५-२१-१६", "content_sanskrit": "उपधाय भुजं तस्य लोकनाथस्य सत्कृतम्।\nकथं नामोपधास्यामि भुजमन्यस्य कस्यचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000360017, "chapter_id": 9360, "verse_number": "५-२१-१७", "content_sanskrit": "अहमौपयिकी भार्या तस्यैव च धरापतेः।\nव्रतस्नातस्य विद्येव विप्रस्य विदितात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000360018, "chapter_id": 9360, "verse_number": "५-२१-१८", "content_sanskrit": "साधु रावण रामेण मां समानय दुःखिताम्।\nवने वासितया सार्धं करेण्वेव गजाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000360019, "chapter_id": 9360, "verse_number": "५-२१-१९", "content_sanskrit": "मित्रमौपयिकं कर्तुं रामः स्थानं परीप्सता।\nबन्धं चानिच्छता घोरं त्वयासौ पुरुषर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000360020, "chapter_id": 9360, "verse_number": "५-२१-२०", "content_sanskrit": "विदितः सर्वधर्मज्ञः शरणागतवत्सलः।\nतेन मैत्री भवतु ते यदि जीवितुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000360021, "chapter_id": 9360, "verse_number": "५-२१-२१", "content_sanskrit": "प्रसादयस्व त्वं चैनं शरणागतवत्सलम्।\nमां चास्मै प्रयतो भूत्वा निर्यातयितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000360022, "chapter_id": 9360, "verse_number": "५-२१-२२", "content_sanskrit": "एवं हि ते भवेत् स्वस्ति सम्प्रदाय रघूत्तमे।\nअन्यथा त्वं हि कुर्वाणः परां प्राप्स्यसि चापदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000360023, "chapter_id": 9360, "verse_number": "५-२१-२३", "content_sanskrit": "वर्जयेद् वज्रमुत्सृष्टं वर्जयेदन्तकश्चिरम्।\nत्वद्विधं न तु संक्रुद्धो लोकनाथः स राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000360024, "chapter_id": 9360, "verse_number": "५-२१-२४", "content_sanskrit": "रामस्य धनुषः शब्दं श्रोष्यसि त्वं महास्वनम्।\nशतक्रतुविसृष्टस्य निर्घोषमशनेरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000360025, "chapter_id": 9360, "verse_number": "५-२१-२५", "content_sanskrit": "इह शीघ्रं सुपर्वाणो ज्वलितास्या इवोरगाः।\nइषवो निपतिष्यन्ति रामलक्ष्मणलक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000360026, "chapter_id": 9360, "verse_number": "५-२१-२६", "content_sanskrit": "रक्षांसि निहनिष्यन्तः पुर्यामस्यां न संशयः।\nअसम्पातं करिष्यन्ति पतन्तः कङ्कवाससः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000360027, "chapter_id": 9360, "verse_number": "५-२१-२७", "content_sanskrit": "राक्षसेन्द्रमहासर्पान् स रामगरुडो महान्।\nउद्धरिष्यति वेगेन वैनतेय इवोरगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000360028, "chapter_id": 9360, "verse_number": "५-२१-२८", "content_sanskrit": "अपनेष्यति मां भर्ता त्वत्तः शीघ्रमरिंदमः।\nअसुरेभ्यः श्रियं दीप्तां विष्णुस्त्रिभिरिव क्रमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000360029, "chapter_id": 9360, "verse_number": "५-२१-२९", "content_sanskrit": "जनस्थाने हतस्थाने निहते रक्षसां बले।\nअशक्तेन त्वया रक्षः कृतमेतदसाधु वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000360030, "chapter_id": 9360, "verse_number": "५-२१-३०", "content_sanskrit": "आश्रमं तत्तयोः शून्यं प्रविश्य नरसिंहयोः।\nगोचरं गतयोर्भ्रात्रोरपनीता त्वयाधम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000360031, "chapter_id": 9360, "verse_number": "५-२१-३१", "content_sanskrit": "नहि गन्धमुपाघ्राय रामलक्ष्मणयोस्त्वया।\nशक्यं संदर्शने स्थातुं शुना शार्दूलयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000360032, "chapter_id": 9360, "verse_number": "५-२१-३२", "content_sanskrit": "तस्य ते विग्रहे ताभ्यां युगग्रहणमस्थिरम्।\nवृत्रस्येवेन्द्रबाहुभ्यां बाहोरेकस्य विग्रहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000360033, "chapter_id": 9360, "verse_number": "५-२१-३३", "content_sanskrit": "क्षिप्रं तव स नाथो मे रामः सौमित्रिणा सह।\nतोयमल्पमिवादित्यः प्राणानादास्यते शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000360034, "chapter_id": 9360, "verse_number": "५-२१-३४", "content_sanskrit": "गिरिं कुबेरस्य गतोऽथवाऽऽलयं\nसभां गतो वा वरुणस्य राज्ञः।\nअसंशयं दाशरथेर्विमोक्ष्यसे\nमहाद्रुमः कालहतोऽशनेरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000360035, "chapter_id": 9360, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे एकविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]