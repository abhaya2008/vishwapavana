[{"id": 2038442, "chapter_id": 1839, "verse_number": "५-८४-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038443, "chapter_id": 1839, "verse_number": "५-८४-१", "content_sanskrit": "कथं प्रयातो दाशार्हो महात्मा मधुसूदनः।\nकानि वा व्रजतस्तस्य निमित्तानि महौजसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038444, "chapter_id": 1839, "verse_number": "५-८४-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038445, "chapter_id": 1839, "verse_number": "५-८४-२", "content_sanskrit": "तस्य प्रयाणे यान्यसन्निमित्तानि महात्मनः।\nतानि मे श्रृणु सर्वाणि दैवान्यौत्पातिकानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038446, "chapter_id": 1839, "verse_number": "५-८४-३", "content_sanskrit": "अनभ्रेऽशनिनिर्घोषः सविद्युत्समजायत ।\nअन्वगेव च पर्जन्यः प्रावर्षद्विघने भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038447, "chapter_id": 1839, "verse_number": "५-८४-४", "content_sanskrit": "प्रत्यगूहुर्महानद्यः प्राङ्मुखाः सिन्धुसप्तमाः ।\nविपरिता दिशः सर्वा न प्राज्ञायत किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038448, "chapter_id": 1839, "verse_number": "५-८४-५", "content_sanskrit": "प्राज्वलन्नग्नयो राजन्पृथिवी समकम्पत ।\nउदपानाश्च कुम्भाश्च प्रासिञ्चञ्शतशो जलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038449, "chapter_id": 1839, "verse_number": "५-८४-६", "content_sanskrit": "तमःसंवृतमप्यासीत्सर्वं जगदिदं तथा।\nन दिशो नादिशो राजन्प्रज्ञायन्तेस्म रेणुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038450, "chapter_id": 1839, "verse_number": "५-८४-७", "content_sanskrit": "प्रादुरासीन्महाञ्छब्दः खेशरीरमदृश्यत ।\nसर्वेषु राजन्देशेषु तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038451, "chapter_id": 1839, "verse_number": "५-८४-८", "content_sanskrit": "प्रामथ्नाद्धास्तिनपुरं वातो दक्षिणपश्चिमः ।\nआरुजन्गणशो वृक्षान्परुषोऽशनिनिःस्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038452, "chapter_id": 1839, "verse_number": "५-८४-९", "content_sanskrit": "यत्रयत्र च वार्ष्णेयो वर्तते पथि भारत ।\nतत्रतत्र सुखो वायुः सर्वं चासीत्प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038453, "chapter_id": 1839, "verse_number": "५-८४-१०", "content_sanskrit": "ववर्ष पुष्पवर्षं च कमलानि च भूरिशः ।\nसमश्च पन्था निर्दुःखो व्यपेतकुशकण्टकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038454, "chapter_id": 1839, "verse_number": "५-८४-११", "content_sanskrit": "संस्तुतो ब्राह्मणैर्गीर्भिस्तत्रतत्र सहस्रशः ।\nअर्च्यते मधुपर्कैश्च वसुभिश्च वसुप्रदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038455, "chapter_id": 1839, "verse_number": "५-८४-१२", "content_sanskrit": "तं किरन्ति महात्मानं वन्यैः पुष्पैः सुगन्धिभिः ।\nस्त्रियः पथि समागम्य सर्वभूतहिते रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038456, "chapter_id": 1839, "verse_number": "५-८४-१३", "content_sanskrit": "स शालिभवनं रम्यं सर्वसस्यसमाचितम्।\nसुख परमधर्मिष्ठमभ्यगाद्भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038457, "chapter_id": 1839, "verse_number": "५-८४-१४", "content_sanskrit": "पश्यन्बहुपशून्ग्रामान्रम्यान्हृदयतोपणान्।\nपुराणि च व्यतिकामन्राष्ट्राणि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038458, "chapter_id": 1839, "verse_number": "५-८४-१५", "content_sanskrit": "नित्यं हृष्टाः सुमनसो भारतैरभिरक्षिताः।\nनोद्विग्नाः परचक्राणां व्यसनानामकोविदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038459, "chapter_id": 1839, "verse_number": "५-८४-१६", "content_sanskrit": "उपप्लाव्यादथागम्य जनाः पुरनिवासिनः।\nयथ्यतिष्ठन्त सहिता विष्वक्सेनदिदृक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038460, "chapter_id": 1839, "verse_number": "५-८४-१७", "content_sanskrit": "ते तु सर्वे समायान्तमग्निमिद्धमिव प्रभुम् ।\nअर्चयामासुरर्चार्हं देशातिथिमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038461, "chapter_id": 1839, "verse_number": "५-८४-१८", "content_sanskrit": "वृकस्थलं समासाद्य केशवः परवीरहा ।\nप्रकीर्णरश्मावादित्ये व्योम्नि वै लोहितायति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038462, "chapter_id": 1839, "verse_number": "५-८४-१९", "content_sanskrit": "` ततो ह्यनुचरान्सर्वानुवाच मधुसूदनः।\nयुधिष्ठिरस्य कार्यार्थमिह वत्स्यामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038463, "chapter_id": 1839, "verse_number": "५-८४-२०", "content_sanskrit": "तस्य तन्मतमाज्ञाय चक्रुरावसथं नराः ।\nक्षणेन चान्नपानानि ररावन्ति समार्जयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038464, "chapter_id": 1839, "verse_number": "५-८४-२१", "content_sanskrit": "अवतीर्य रथात्तूर्णं कृत्वा शौचं यथाविधि ।\nरथमोचनमादिश्य सन्ध्यामुपविवेश ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038465, "chapter_id": 1839, "verse_number": "५-८४-२२", "content_sanskrit": "दारुकोऽपि हयान्मुक्त्वा परिचर्य च शास्त्रतः।\nमुमोच सर्वं योक्तादि मुक्त्वा चैतानवासृजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038466, "chapter_id": 1839, "verse_number": "५-८४-२३", "content_sanskrit": "तस्मिन्ग्रामे प्रधानास्तु य आसन्ब्राह्मणा नृप ।\nआर्याः कुलीना ह्रीमन्तो ब्राह्मीं वृत्तिमनुष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2038467, "chapter_id": 1839, "verse_number": "५-८४-२४", "content_sanskrit": "तेऽभिगम्य महात्मानं हृषीकेशमरिन्दमम्।\nपूजां चक्रुर्यथान्यायमाशीर्मङ्गलसंयुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2038468, "chapter_id": 1839, "verse_number": "५-८४-२५", "content_sanskrit": "ते पूजयित्वा दाशार्हं सर्वलोकेषु पूजितम्।\nन्यवेदयन्त वेश्मानि गुणवन्ति महात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2038469, "chapter_id": 1839, "verse_number": "५-८४-२६", "content_sanskrit": "तान्प्रभुः कृतमित्युक्ता सत्कृत्य च यथार्हतः ।\nअभ्येत्य चैषां वेश्मानि पुनरायात्सहैव तैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2038470, "chapter_id": 1839, "verse_number": "५-८४-२७", "content_sanskrit": "सुमृष्टं भोजयित्वा च ब्राह्मणांस्तत्र केशवः ।\nभुक्ता च सह तैः सर्वैरवसत्तां क्षपां सुखम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2038471, "chapter_id": 1839, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वमि भगवद्यानपर्वणि चतुरशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]