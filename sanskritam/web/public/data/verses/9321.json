[{"id": 5000321000, "chapter_id": 9321, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे एकोनपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000321001, "chapter_id": 9321, "verse_number": "४-४९-१", "content_sanskrit": "अथाङ्गदस्तदा सर्वान् वानरानिदमब्रवीत्।\nपरिश्रान्तो महाप्राज्ञः समाश्वास्य शनैर्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000321002, "chapter_id": 9321, "verse_number": "४-४९-२", "content_sanskrit": "वनानि गिरयो नद्यो दुर्गाणि गहनानि च।\nदरी गिरिगुहाश्चैव विचिताः सर्वमन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000321003, "chapter_id": 9321, "verse_number": "४-४९-३", "content_sanskrit": "तत्र तत्र सहास्माभिर्जानकी न च दृश्यते।\nतथा रक्षोऽपहर्ता च सीतायाश्चैव दुष्कृती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000321004, "chapter_id": 9321, "verse_number": "४-४९-४", "content_sanskrit": "कालश्च नो महान् यातः सुग्रीवश्चोग्रशासनः।\nतस्माद् भवन्तः सहिता विचिन्वन्तु समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000321005, "chapter_id": 9321, "verse_number": "४-४९-५", "content_sanskrit": "विहाय तन्द्रीं शोकं च निद्रां चैव समुत्थिताम्।\nविचिनुध्वं तथा सीतां पश्यामो जनकात्मजाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000321006, "chapter_id": 9321, "verse_number": "४-४९-६", "content_sanskrit": "अनिर्वेदं च दाक्ष्यं च मनसश्चापराजयम्।\nकार्यसिद्धिकराण्याहुस्तस्मादेतद् ब्रवीम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000321007, "chapter_id": 9321, "verse_number": "४-४९-७", "content_sanskrit": "अद्यापीदं वनं दुर्गं विचिन्वन्तु वनौकसः।\nखेदं त्यक्त्वा पुनः सर्वं वनमेव विचिन्वताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000321008, "chapter_id": 9321, "verse_number": "४-४९-८", "content_sanskrit": "अवश्यं कुर्वतां तस्य दृश्यते कर्मणः फलम्।\nपरं निर्वेदमागम्य नहि नोन्मीलनं क्षमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000321009, "chapter_id": 9321, "verse_number": "४-४९-९", "content_sanskrit": "सुग्रीवः क्रोधनो राजा तीक्ष्णदण्डश्च वानराः।\nभेतव्यं तस्य सततं रामस्य च महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000321010, "chapter_id": 9321, "verse_number": "४-४९-१०", "content_sanskrit": "हितार्थमेतदुक्तं वः क्रियतां यदि रोचते।\nउच्यतां हि क्षमं यत् तत् सर्वेषामेव वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000321011, "chapter_id": 9321, "verse_number": "४-४९-११", "content_sanskrit": "अङ्गदस्य वचः श्रुत्वा वचनं गन्धमादनः।\nउवाच व्यक्तया वाचा पिपासाश्रमखिन्नया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000321012, "chapter_id": 9321, "verse_number": "४-४९-१२", "content_sanskrit": "सदृशं खलु वो वाक्यमङ्गदो यदुवाच ह।\nहितं चैवानुकूलं च क्रियतामस्य भाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000321013, "chapter_id": 9321, "verse_number": "४-४९-१३", "content_sanskrit": "पुनर्मार्गामहे शैलान् कन्दरांश्च शिलांस्तथा।\nकाननानि च शून्यानि गिरिप्रस्रवणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000321014, "chapter_id": 9321, "verse_number": "४-४९-१४", "content_sanskrit": "यथोद्दिष्टानि सर्वाणि सुग्रीवेण महात्मना।\nविचिन्वन्तु वनं सर्वे गिरिदुर्गाणि संगताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000321015, "chapter_id": 9321, "verse_number": "४-४९-१५", "content_sanskrit": "ततः समुत्थाय पुनर्वानरास्ते महाबलाः।\nविन्ध्यकाननसंकीर्णां विचेरुर्दक्षिणां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000321016, "chapter_id": 9321, "verse_number": "४-४९-१६", "content_sanskrit": "ते शारदाभ्रप्रतिमं श्रीमद्रजतपर्वतम्।\nशृङ्गवन्तं दरीवन्तमधिरुह्य च वानराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000321017, "chapter_id": 9321, "verse_number": "४-४९-१७", "content_sanskrit": "तत्र लोध्रवनं रम्यं सप्तपर्णवनानि च।\nविचिन्वन्तो हरिवराः सीतादर्शनकांक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000321018, "chapter_id": 9321, "verse_number": "४-४९-१८", "content_sanskrit": "तस्याग्रमधिरूढास्ते श्रान्ता विपुलविक्रमाः।\nन पश्यन्ति स्म वैदेहीं रामस्य महिषीं प्रियाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000321019, "chapter_id": 9321, "verse_number": "४-४९-१९", "content_sanskrit": "ते तु दृष्टिगतं दृष्ट्वा तं शैलं बहुकन्दरम्।\nअध्यारोहन्त हरयो वीक्षमाणाः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000321020, "chapter_id": 9321, "verse_number": "४-४९-२०", "content_sanskrit": "अवरुह्य ततो भूमिं श्रान्ता विगतचेतसः।\nस्थिता मुहूर्तं तत्राथ वृक्षमूलमुपाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000321021, "chapter_id": 9321, "verse_number": "४-४९-२१", "content_sanskrit": "ते मुहूर्तं समाश्वस्ताः किंचिद्भग्नपरिश्रमाः।\nपुनरेवोद्यताः कृत्स्नां मार्गितुं दक्षिणां दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000321022, "chapter_id": 9321, "verse_number": "४-४९-२२", "content_sanskrit": "हनुमत्प्रमुखास्तावत् प्रस्थिताः प्लवगर्षभाः।\nविन्ध्यमेवादितः कृत्वा विचेरुश्च समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000321023, "chapter_id": 9321, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे एकोनपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]