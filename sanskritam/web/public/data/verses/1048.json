[{"id": 2002300, "chapter_id": 1048, "verse_number": "१-४९-०x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002301, "chapter_id": 1048, "verse_number": "१-४९-१", "content_sanskrit": "यदपृच्छत्तदा राजा मन्त्रिणो जनमेजयः।\nपितुः स्वर्गगतिं तन्मे विस्तरेण पुनर्वद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002302, "chapter_id": 1048, "verse_number": "१-४९-२x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002303, "chapter_id": 1048, "verse_number": "१-४९-२", "content_sanskrit": "शृणु ब्रह्मन्यथाऽपृच्छन्मन्त्रिणो नृपतिस्तदा।\nयथा चाख्यातवन्तस्ते निधनं तत्परिक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002304, "chapter_id": 1048, "verse_number": "१-४९-३x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002305, "chapter_id": 1048, "verse_number": "१-४९-३", "content_sanskrit": "जानन्ति स्म भवन्तस्तद्यथावृत्तं पितुर्मम।\nआसीद्यथा स निधनं गतः काले महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002306, "chapter_id": 1048, "verse_number": "१-४९-४", "content_sanskrit": "श्रुत्वा भवत्सकाशाद्धि पितुर्वृत्तमशेषतः।\nकल्याणं प्रतिपत्स्यामि विपरीतं न जातुचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002307, "chapter_id": 1048, "verse_number": "१-४९-५x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002308, "chapter_id": 1048, "verse_number": "१-४९-५", "content_sanskrit": "मन्त्रिणोऽथाब्रुवन्वाक्यं पृष्टास्तेन महात्मना।\nसर्वे धर्मविदः प्राज्ञा राजानं जनमेजयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002309, "chapter_id": 1048, "verse_number": "१-४९-६x", "content_sanskrit": "मन्त्रिण ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002310, "chapter_id": 1048, "verse_number": "१-४९-६", "content_sanskrit": "शृणु पार्थिव यद्ब्रूषे पितुस्तव महात्मनः।\nचरितं पार्थिवेन्द्रस्य यथा निष्ठां गतश्च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002311, "chapter_id": 1048, "verse_number": "१-४९-७", "content_sanskrit": "धर्मात्मा च महात्मा च प्रजापालः पिता तव।\nआसीदिहायथा वृत्तः स महात्मा शृणुष्व तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002312, "chapter_id": 1048, "verse_number": "१-४९-८", "content_sanskrit": "चातुर्वर्ण्यं स्वधर्मस्थं स कृत्वा पर्यरक्षत।\nधर्मतो धर्मविद्राजा धर्मो विग्रहवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002313, "chapter_id": 1048, "verse_number": "१-४९-९", "content_sanskrit": "ररक्ष पृथिवीं देवीं श्रीमानतुलविक्रमः।\nद्वेष्टारस्तस्य नैवासन्स च द्वेष्टि न कंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002314, "chapter_id": 1048, "verse_number": "१-४९-१०", "content_sanskrit": "समः सर्वेषु भूतेषु प्रजापतिरिवाभवत्।\nब्राह्मणाः क्षत्रिया वैश्याः शूद्राश्चैव स्वकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002315, "chapter_id": 1048, "verse_number": "१-४९-११", "content_sanskrit": "स्थितः सुमनसो राजंस्तेन राज्ञा स्वधिष्ठिताः।\nविधवानाथविकलान्कृपणांश्च बभार सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002316, "chapter_id": 1048, "verse_number": "१-४९-१२", "content_sanskrit": "सुदर्शः सर्वभूतानामासीत्सोम इवापरः।\nतुष्टपुष्टजनः श्रीमान्सत्यवाग्दृढविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002317, "chapter_id": 1048, "verse_number": "१-४९-१३", "content_sanskrit": "धनुर्वेदे तु शिष्योऽभून्नृपः शारद्वतस्य सः।\nगोविन्दस्य प्रियश्चासीत्पिता ते जनमेजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002318, "chapter_id": 1048, "verse_number": "१-४९-१४", "content_sanskrit": "लोकस्य चैव सर्वस्य प्रिय आसीन्महायशाः।\nपरिक्षीणेषु कुरुषु सोत्तरायामजीजनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002319, "chapter_id": 1048, "verse_number": "१-४९-१५", "content_sanskrit": "परिक्षिदभवत्तेन सौभद्रस्यात्मजो बली।\nराजधर्मार्थकुशलो युक्तः सर्वगुणैर्वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002320, "chapter_id": 1048, "verse_number": "१-४९-१६", "content_sanskrit": "जितेन्द्रियश्चात्मवांश्च मेधावी धर्मसेविता।\nषड्वर्गजिन्महाबुद्धिर्नीतिशास्त्रविदुत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002321, "chapter_id": 1048, "verse_number": "१-४९-१७", "content_sanskrit": "प्रजा इमास्तव पिता षष्टिवर्षाण्यपालयत्।\nततो दिष्टान्तमापन्नः सर्वेषां दुःखमावहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002322, "chapter_id": 1048, "verse_number": "१-४९-१८", "content_sanskrit": "ततस्त्वं पुरुषश्रेष्ठ धर्मेण प्रतिपेदिवान्।\nइदं वर्षसहस्राणि राज्यं कुरुकुलागतम्।\nबाल एवाभिषिक्तस्त्वं सर्वभूतानुपालकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002323, "chapter_id": 1048, "verse_number": "१-४९-१९x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002324, "chapter_id": 1048, "verse_number": "१-४९-१९", "content_sanskrit": "नास्मिन्कुले जातु बभूव राजा\nयो न प्रजानां प्रियकृत्प्रियश्च।\nविशेषतः प्रेक्ष्य पितामहानां\nवृत्तं महद्वृत्तपरायणानाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002325, "chapter_id": 1048, "verse_number": "१-४९-२०", "content_sanskrit": "कथं निधनमापन्नः पिता मम तथाविधः।\nआचक्षध्वं यथावन्मे श्रोतुमिच्छामि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002326, "chapter_id": 1048, "verse_number": "१-४९-२१x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002327, "chapter_id": 1048, "verse_number": "१-४९-२१", "content_sanskrit": "एवं संचोदिता राज्ञा मन्त्रिणस्ते नराधिपम्।\nऊचुः सर्वे यथावृत्तं राज्ञः प्रियहितैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002328, "chapter_id": 1048, "verse_number": "१-४९-२२x", "content_sanskrit": "मन्त्रिण ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2002329, "chapter_id": 1048, "verse_number": "१-४९-२२", "content_sanskrit": "स राजा पृथिवीपालः सर्वशस्त्रभृतां वरः।\nबभूव मृगयाशीलस्तव राजन्पिता सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2002330, "chapter_id": 1048, "verse_number": "१-४९-२३", "content_sanskrit": "यथा पाण्डुर्महाबाहुर्धनुर्धरवरो युधि।\nअस्मास्वासज्य सर्वाणि राजकार्याण्यशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2002331, "chapter_id": 1048, "verse_number": "१-४९-२४", "content_sanskrit": "स कदाचिद्वनगतो मृगं विव्याध पत्रिणा।\nविद्ध्वा चान्वसरत्तूर्णं तं मृगं गहने वने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2002332, "chapter_id": 1048, "verse_number": "१-४९-२५", "content_sanskrit": "पदातिर्बद्धनिस्त्रिंशस्ततायुधकलापवान्।\nन चाससाद गहने मृगं नष्टं पिता तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2002333, "chapter_id": 1048, "verse_number": "१-४९-२६", "content_sanskrit": "परिश्रान्तो वयस्थश्च षष्टिवर्षो जरान्वितः।\nक्षुधितः स महारण्ये ददर्श मुनिसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2002334, "chapter_id": 1048, "verse_number": "१-४९-२७", "content_sanskrit": "स तं पप्रच्छ राजेन्द्रो मुनिं मौनव्रते स्थितम्।\nन च किंचिदुवाचेदं पृष्टोऽपि समुनिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2002335, "chapter_id": 1048, "verse_number": "१-४९-२८", "content_sanskrit": "ततो राजा क्षुच्छ्रमार्तस्तं मुनिं स्थाणुवत्स्थितम्।\nमौनव्रतधरं शान्तं सद्यो मन्युवशं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2002336, "chapter_id": 1048, "verse_number": "१-४९-२९", "content_sanskrit": "न बुबोध च तं राजा मौनव्रतधरं मुनिम्।\nस तं क्रोधसमाविष्टो धर्षयामास ते पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2002337, "chapter_id": 1048, "verse_number": "१-४९-३०", "content_sanskrit": "मृतं सर्पं धनुष्कोट्या समुत्क्षिप्य धरातलात्।\nतस्य शुद्धात्मनः प्रादात्स्कन्धे भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2002338, "chapter_id": 1048, "verse_number": "१-४९-३१", "content_sanskrit": "न चोवाच स मेधावी तमथो साध्वसाधु वा।\nतस्थौ तथैव चाक्रुद्धः सर्पं स्कन्धेन धारयन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2002339, "chapter_id": 1048, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि एकोनपञ्चाशत्तमोऽध्यायः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]