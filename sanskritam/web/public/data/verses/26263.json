[{"id": 7006263000, "chapter_id": 26263, "verse_number": "३-१७-१", "content_sanskrit": "दण्डनाथाविनिर्याणे संख्यातीतैः सितप्रभैः ।\nछत्रैर्गगनमारेजे निःसंख्याशशिमण्डितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006263001, "chapter_id": 26263, "verse_number": "३-१७-२", "content_sanskrit": "अन्योन्यसक्तैर्थवलच्छत्रैरन्तर्घनीभवत् ।\nतिमिरं नुनुदे भूयस्तत्काण्डमणिरोचिषा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006263002, "chapter_id": 26263, "verse_number": "३-१७-३", "content_sanskrit": "वज्रप्रभाधगधगच्छायापूरितदिङ्मुखाः ।\nतालवृन्ताः शतविधाः क्रोडमुख्या बलेऽचलन् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006263003, "chapter_id": 26263, "verse_number": "३-१७-४", "content_sanskrit": "चण्डो दण्डादयस्तीव्राभैरवाः शुलपाणयः ।\nज्वलत्केशापिशङ्गाभास्तडिद्भासुरदिङ्मुखाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006263004, "chapter_id": 26263, "verse_number": "३-१७-५", "content_sanskrit": "दहत्य इव दैत्यौघांस्तीक्ष्णैर्मार्गणवह्निभिः ।\nप्रचेलुर्दण्डनाथायास्सेना नासीरधाविताः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006263005, "chapter_id": 26263, "verse_number": "३-१७-६", "content_sanskrit": "अथ पोत्रीमुखीदेवीसमानाकृतिभूषणाः ।\nतत्समानायुधकरास्तत्समानस्ववाहनाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006263006, "chapter_id": 26263, "verse_number": "३-१७-७", "content_sanskrit": "तीक्ष्मदंष्ट३ इनिष्ठ्यूतवह्रिधूमामितांबराः ।\nतमालश्यामलाकाराः कपिलाः क्रूरलोचनाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006263007, "chapter_id": 26263, "verse_number": "३-१७-८", "content_sanskrit": "सहस्रमहिषारूढाः प्रचेलुः सूकराननाः ।\nअथ श्रीदण्डनाथा च करिचक्ररथोत्तमात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006263008, "chapter_id": 26263, "verse_number": "३-१७-९", "content_sanskrit": "अवरुह्य महासिंहमारुरोह स्ववाहनम् ।\nवज्रघोष इति ख्यातं धूतकेसरमण्डलम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006263009, "chapter_id": 26263, "verse_number": "३-१७-१०", "content_sanskrit": "व्यक्तास्यं विकटाकारं विशङ्कटविलोचनम् ।\nदंष्ट्राकटकटत्कारबधिरीकृतदिक्तटम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006263010, "chapter_id": 26263, "verse_number": "३-१७-११", "content_sanskrit": "आदिकूर्मकठोरास्थि खर्परप्रतिमैर्नखैः ।\nविबन्तमिव भूचक्रमापातालं निमज्जिभिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006263011, "chapter_id": 26263, "verse_number": "३-१७-१२", "content_sanskrit": "योजनत्रयमुत्तुङ्गं वगादुद्धूतवालधिम् ।\nसिंहवाहनमारुह्य व्यचलद्दण्डनायिका ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006263012, "chapter_id": 26263, "verse_number": "३-१७-१३", "content_sanskrit": "तस्यामसुरसंहारे प्रवृत्तायां ज्वलत्क्रुधि ।\nउद्वेगं बहुलं प्राप त्रैलोक्यं सचराचरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006263013, "chapter_id": 26263, "verse_number": "३-१७-१४", "content_sanskrit": "किमसौ धक्ष्यति रुषा विश्वमद्यैव पोत्रिणी ।\nकिं वा मुसलघातेन भूमिं द्वेधा करिष्यति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006263014, "chapter_id": 26263, "verse_number": "३-१७-१५", "content_sanskrit": "अथ वा हलनिर्घातैः क्षोभयिष्यति वारिधीन् ।\nइति त्रस्तहृदः सर्वे गगने नाकिनां गणाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006263015, "chapter_id": 26263, "verse_number": "३-१७-१६", "content_sanskrit": "दूराद्रुतं विमानैश्च सत्रासं ददृशुर्गताः ।\nववन्दिरे च ता देवा बद्धाञ्जलिपुटान्विताः ।\nमुहुर्द्वादशनामानि कीर्तयन्तो नभस्तले ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006263016, "chapter_id": 26263, "verse_number": "३-१७-१७", "content_sanskrit": "अगस्त्य उवाच कानि द्वादशनामानि तस्या देव्या वद प्रभो ।\nअश्वानन महाप्राज्ञ येषु मे कौतुकं महत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006263017, "chapter_id": 26263, "verse_number": "३-१७-१८", "content_sanskrit": "हयग्रीव उवाच शृणु द्वादशनामानि तस्या देव्या घटोद्भव ।\nयदाकर्णनमात्रेण प्रसन्ना सा भविष्यति ।\nपञ्चमी दण्डनाथा च संकेता समयेश्वरी ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006263018, "chapter_id": 26263, "verse_number": "३-१७-१९", "content_sanskrit": "तथा समयसंकेता वाराही पोत्रिणी तथा ।\nवार्ताली च महासेनाप्याज्ञा चक्रेश्वरी तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006263019, "chapter_id": 26263, "verse_number": "३-१७-२०", "content_sanskrit": "अरिघ्नी चेति सम्प्रोक्तं नामद्वादशकं मुने ।\nनामद्वादशकाभिख्यवज्रपञ्जरमध्यगः ।\nसंकटे दुःखमाप्नोति न कदाचन मानवः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006263020, "chapter_id": 26263, "verse_number": "३-१७-२१", "content_sanskrit": "एतैर्नामभिरभ्रस्थाः संकेतां बहु तुष्टुवुः ।\nतेषामनुग्रहार्थाय प्रचचालच सा पुनः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006263021, "chapter_id": 26263, "verse_number": "३-१७-२२", "content_sanskrit": "अथ संकेतयोगिन्या मन्त्रनाथा पदस्पृशः ।\nनिर्याणसूचनकरी दिवि दध्वान काहली ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006263022, "chapter_id": 26263, "verse_number": "३-१७-२३", "content_sanskrit": "शृङ्गारप्रायभूषाणां शार्दूलश्यामलत्विषाम् ।\nवीणासंयतपाणीनां शक्तीनां निर्ययौ बलम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006263023, "chapter_id": 26263, "verse_number": "३-१७-२४", "content_sanskrit": "काश्चद्गायन्ति नृत्यन्ति मत्तकोकिलनिःस्वनाः ।\nवीणावेणुमृदङ्गाद्याः सविलासपदक्रमाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006263024, "chapter_id": 26263, "verse_number": "३-१७-२५", "content_sanskrit": "प्रचेलुः शक्तयः श्यामा हर्षयन्त्यो जगज्जनान् ।\nमयूरवाहनाः काश्चित्कतिचिद्धंसवाहनाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006263025, "chapter_id": 26263, "verse_number": "३-१७-२६", "content_sanskrit": "कतिचिन्नकुलारूढाः कतिचित्कोकिलासनाः ।\nसर्वाश्च श्यामलाकाराः काश्चित्कर्णीरथस्थिताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006263026, "chapter_id": 26263, "verse_number": "३-१७-२७", "content_sanskrit": "कादंबमधुमत्ताश्च काश्चिदारूढसैन्धवाः ।\nमन्त्रनाथां पुरस्कृत्य संप्रचेलुः पुरः पुरः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006263027, "chapter_id": 26263, "verse_number": "३-१७-२८", "content_sanskrit": "अथारुह्य समुत्तुङ्गध्वजचक्रं महारथम् ।\nबालार्कवर्णकवचा मदालोलविलोचना ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006263028, "chapter_id": 26263, "verse_number": "३-१७-२९", "content_sanskrit": "ईषत्प्रस्वेदकणिकामनोहरमुखांबुजा ।\nप्रेक्षयन्ती कटाक्षौधौः किञ्चिद्भ्रूवल्लिताण्डवैः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006263029, "chapter_id": 26263, "verse_number": "३-१७-३०", "content_sanskrit": "समस्तमपि तत्सैन्यं शक्तीनामुद्धतोद्धतम् ।\nपिच्छत्रिकोणच्छत्रेण बिरुदेन महीयसा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006263030, "chapter_id": 26263, "verse_number": "३-१७-३१", "content_sanskrit": "आसां मध्ये न चान्यासां शक्तीनामुज्ज्वलोदया ।\nनिर्जगाम घनश्यामश्यामला मन्त्रनायिका ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006263031, "chapter_id": 26263, "verse_number": "३-१७-३२", "content_sanskrit": "तां तुष्टुवुः षोडशभिर्नामभिर्नाकवासिनः ।\nतानि षोडशनामानि शृणु कुंभसमुद्भव ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006263032, "chapter_id": 26263, "verse_number": "३-१७-३३", "content_sanskrit": "संगीतयोगिनी श्यामा श्यामला मन्त्रनायिका ।\nमन्त्रिणी सचिवेशी च प्रधानेशी शुकप्रिया ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006263033, "chapter_id": 26263, "verse_number": "३-१७-३४", "content_sanskrit": "वीणावती वैणिकी च मुद्रिणी प्रियकप्रिया ।\nनिपप्रिया कदंबेशी कदंबवनवासिनी ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006263034, "chapter_id": 26263, "verse_number": "३-१७-३५", "content_sanskrit": "सदामदा च नामानि षोडशैतानि कुंभज ।\nएतैर्यः सचिवेशानीं सकृत्स्तौति शरीरवान् ।\nतस्य त्रैलोक्यमखिलं हस्ते तिष्ठत्यसंशयम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006263035, "chapter_id": 26263, "verse_number": "३-१७-३६", "content_sanskrit": "मन्त्रिनाथा यत्रयत्र कटाक्षं विकिरत्यसौ ।\nतत्रतत्र गताशङ्कं शत्रुसैन्यं पतत्यलम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006263036, "chapter_id": 26263, "verse_number": "३-१७-३७", "content_sanskrit": "ललितापरमेशान्या राज्यचर्चा तु यावती ।\nशक्तीनामपि चर्चा या सा सर्वत्र जयप्रदा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006263037, "chapter_id": 26263, "verse_number": "३-१७-३८", "content_sanskrit": "अथ संगीतयोगिन्याः करस्थाच्छुकपोतकात् ।\nनिर्जगाम धनुर्वेदो वहन्सज्जंशरासनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006263038, "chapter_id": 26263, "verse_number": "३-१७-३९", "content_sanskrit": "चतुर्बाहुयुतो वीरस्त्रिशिरास्त्रिविलोचनः ।\nनमस्कृत्य प्रधानेशीमिदमाह स भक्तिमान् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006263039, "chapter_id": 26263, "verse_number": "३-१७-४०", "content_sanskrit": "देवि भण्डासुरेद्रस्य युद्धाय त्वं प्रवर्त्तसे ।\nअतस्तव मया साह्यं कर्तव्यं मन्त्रिनायिके ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006263040, "chapter_id": 26263, "verse_number": "३-१७-४१", "content_sanskrit": "चत्रजीवमिमं नाम कोदण्डं सुमहत्तरम् ।\nगृहाण जगतामंब दानवानां निबर्हणम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006263041, "chapter_id": 26263, "verse_number": "३-१७-४२", "content_sanskrit": "इमौ चाक्षयबाणाढ्यौ तूणीरौ स्वर्णचित्रितौ ।\nगृहाण दैत्यनाशाय ममानुग्रहहेतवे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006263042, "chapter_id": 26263, "verse_number": "३-१७-४३", "content_sanskrit": "इति प्रणम्य शिरसा धनुर्वेदेन भक्तितः ।\nअर्पितांश्चापतूणीराञ्जग्राह प्रियकप्रिया ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006263043, "chapter_id": 26263, "verse_number": "३-१७-४४", "content_sanskrit": "चित्रजीवं महाचापमादाय च शूकप्रिया ।\nविस्फारं जनयामास मौर्वीमुद्वाद्य भूरिशः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006263044, "chapter_id": 26263, "verse_number": "३-१७-४५", "content_sanskrit": "संगीतयोगिनी चापध्वनिना पूरितं जगत् ।\nनाकालयानां च मनोन यनानन्दसंपदा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006263045, "chapter_id": 26263, "verse_number": "३-१७-४६", "content_sanskrit": "यन्त्रिणी चेति द्वे तस्याः परिचारिके ।\nशुकं वीणां च सहसा वहन्त्यौ परिचेरतुः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006263046, "chapter_id": 26263, "verse_number": "३-१७-४७", "content_sanskrit": "आलोलवलयक्वाणवर्धिष्णुगुणनिस्वनम् ।\nधारयन्ती घनश्यामा चकारातिमनोहरम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006263047, "chapter_id": 26263, "verse_number": "३-१७-४८", "content_sanskrit": "चित्रजीवशरासेन भूषिता गीतयोगिनी ।\nकदंबिनीव रुरुचे कदम्बच्छत्रकार्मुका ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006263048, "chapter_id": 26263, "verse_number": "३-१७-४९", "content_sanskrit": "कालीकटाक्षवत्तीक्ष्णो नृत्यद्भुजगभीषणः ।\nउल्लसन्दक्षिणे पाणौ विललास शिलीमुखः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006263049, "chapter_id": 26263, "verse_number": "३-१७-५०", "content_sanskrit": "गेयचक्ररथारूढां तां पश्चाच्च सिषेविरे ।\nतद्वच्छ्यामलशोभाढ्या देव्यो बाणधनुर्धराः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006263050, "chapter_id": 26263, "verse_number": "३-१७-५१", "content_sanskrit": "सहस्राक्षौहिणीसंख्यास्तीव्रवेगा मदालसाः ।\nआपूरयन्त्यः ककुभं कलैः किलिकिलारवैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]