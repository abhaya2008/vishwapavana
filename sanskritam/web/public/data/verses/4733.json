[{"id": 2176445, "chapter_id": 4733, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2176446, "chapter_id": 4733, "verse_number": "१", "content_sanskrit": "हतं दुर्योधनं दृष्ट्वा भीमसेनेन संयुगे ।\nपाण्डवाः सृञ्जयाश्चैव किमकुर्वत सञ्जय\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2176447, "chapter_id": 4733, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2176448, "chapter_id": 4733, "verse_number": "२", "content_sanskrit": "हतं दुर्योधनं दृष्ट्वा भीमसेनेन संयुगे ।\nसिंहेनेव महाराज मत्तं वनगजं वने\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2176449, "chapter_id": 4733, "verse_number": "३", "content_sanskrit": "प्रहृष्टमनसः सर्वे कृष्णेन सह पाण्डवाः ।\nपाञ्चालाः सृञ्जयाश्चैव निहते कुरुनन्दने\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2176450, "chapter_id": 4733, "verse_number": "४", "content_sanskrit": "आविध्यन्नुत्तरीयाणि सिंहनादांश्च चक्रिरे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2176451, "chapter_id": 4733, "verse_number": "५", "content_sanskrit": "नैतान् हर्षसमाविष्टानियं सेहे वसुन्धरा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2176452, "chapter_id": 4733, "verse_number": "६", "content_sanskrit": "धनूंष्येके व्याक्षिपन्ति ज्याश्चाप्यन्ये तथाऽक्षिपन् ।\nदध्मुश्चान्ये महाशङ्खान् अन्ये जघ्नुश्च दुन्दुभीन्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2176453, "chapter_id": 4733, "verse_number": "७", "content_sanskrit": "चिक्रीडुश्च तथैवान्ये जहसुश्च तवाहिताः ।\nअब्रुवंश्चासकृद् वीरं भीमसेनमिदं वचः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2176454, "chapter_id": 4733, "verse_number": "", "content_sanskrit": "पाञ्चालसृञ्जयाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2176455, "chapter_id": 4733, "verse_number": "८", "content_sanskrit": "दुष्करं भवता कर्म रणेऽद्य सुमहत् कृतम् ।\nकौरवेयं रणे हत्वा गदया कृतनिश्रमम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2176456, "chapter_id": 4733, "verse_number": "९", "content_sanskrit": "इन्द्रेणेव हि वृत्रस्य वधं परमसंयुगे ।\nत्वया कृतममन्यन्त शत्रोर्वधमिमं जनाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2176457, "chapter_id": 4733, "verse_number": "१०", "content_sanskrit": "चरन्तं विविधान् मार्गान् मण्डलानि च सर्वशः ।\nदुर्योधनमिमं हन्यात् कोऽन्यः शूरं वृकोदरात्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2176458, "chapter_id": 4733, "verse_number": "११", "content_sanskrit": "वैरस्य च गतः पारं त्वमिहान्यैः सुदुर्गमम् ।\nअशक्यमेतदन्येन सम्पादयितुमीदृशम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2176459, "chapter_id": 4733, "verse_number": "१२", "content_sanskrit": "कुञ्जरेणेव मत्तेन वीरसङ्ग्राममूर्धनि ।\nदुर्योधनशिरो दिष्ट्या पादेन मृदितं त्वया\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2176460, "chapter_id": 4733, "verse_number": "१३", "content_sanskrit": "सिंहेन महिषस्येव कृत्वा सङ्गरमद्भुतम् ।\nदुःशासनस्य रुधिरं पीतं दिष्ट्या त्वयाऽनघ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2176461, "chapter_id": 4733, "verse_number": "१४", "content_sanskrit": "ये विप्रकुर्वन् राजानं धर्मात्मानं युधिष्ठिरम् ।\nमूर्ध्नि तेषां कृतः पादो दिष्ट्या ते स्वेन कर्मणा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2176462, "chapter_id": 4733, "verse_number": "१५", "content_sanskrit": "अमित्राणामधिष्ठानाद् वधाद् दुर्योधनस्य च ।\nभीम दिष्ट्या पृथिव्यां ते प्रथितं सुमहद्यशः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2176463, "chapter_id": 4733, "verse_number": "१६", "content_sanskrit": "एवं नूनं हते वृत्रे शक्रं नन्दन्ति वन्दिनः ।\nयथा त्वां निहतामित्रं स्वयं नन्दाम भारत\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2176464, "chapter_id": 4733, "verse_number": "१७", "content_sanskrit": "दुर्योधनवधे यानि रोमाणि हृषितानि नः ।\nअद्यापि न विदृश्यन्ते तानि तद्विद्धि भारत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2176465, "chapter_id": 4733, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2176466, "chapter_id": 4733, "verse_number": "१८", "content_sanskrit": "इत्यब्रुवन् भीमसेनं वादिकास्तत्र सङ्गताः ।\nतान् हृष्टान् पुरुषव्याघ्रान् पाञ्चालान् पाण्डवैः सह ।\nब्रुवतः सदृशं तत्तत् प्रोवाच मधुसूदनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2176467, "chapter_id": 4733, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2176468, "chapter_id": 4733, "verse_number": "१९", "content_sanskrit": "नान्यायान्निहतः शत्रुरिति वक्तुं जनाधिपान् ।\nअसकृद् वाग्भिरुग्राभिर्निहतो ह्येष मन्दधीः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2176469, "chapter_id": 4733, "verse_number": "२०", "content_sanskrit": "तदेवैष हतः क्षुद्रो यदैव निरपत्रपः ।\nलुब्धः पापसहायश्च सुहृदां शासनातिगः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2176470, "chapter_id": 4733, "verse_number": "२१", "content_sanskrit": "बहुशो विदुरद्रोणकृपगाङ्गेयसञ्जयैः ।\nपाण्डुभ्यः प्रोच्यमानोऽपि पित्र्यमंशं न दत्तवान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2176471, "chapter_id": 4733, "verse_number": "२२", "content_sanskrit": "नानेन कार्ये दुष्टेन श्रुतेनैव कथास्वपि ।\nईदृशो मित्रमर्यादो गतिं याता हि तादृशीम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2176472, "chapter_id": 4733, "verse_number": "२३", "content_sanskrit": "श्रुत्वैवं वदतस्तस्य साऽसूयं वचनं तदा ।\nशपन्निव च रोषेण स्फुरन्निव च भूपतिः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2176473, "chapter_id": 4733, "verse_number": "२४", "content_sanskrit": "नैष योग्योऽत्र मित्रं वा शत्रुर्वा पुरुषाधमः ।\nकिमनेनातिनुन्नेन वाग्भिः काष्ठसधर्मणा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2176474, "chapter_id": 4733, "verse_number": "२५", "content_sanskrit": "रथेष्वारोहत क्षिप्रं गच्छाम वसुधाधिपाः ।\nदिष्ट्या हतोऽयं पापात्मा सामात्यज्ञातिबान्धवः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2176475, "chapter_id": 4733, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2176476, "chapter_id": 4733, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रुत्वाऽऽत्मनि क्षेपं कृष्णाद् दुर्योधनो नृपः ।\nअमर्षवशमापन्न उदतिष्ठद्विशाम्पते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2176477, "chapter_id": 4733, "verse_number": "२७", "content_sanskrit": "स्फिग्देशेनोपविष्टः सन् दोर्भ्यां विष्टभ्य मेदिनीम् ।\nदृष्टिं भ्रूसङ्कटां कृत्वा वासुदेवे न्यपातयत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2176478, "chapter_id": 4733, "verse_number": "२८", "content_sanskrit": "अर्धोन्नतशरीरस्य रूपमासीन्नृपस्य तत् ।\nक्रुद्धस्याशीविषस्येव च्छिन्नपक्षस्य भोगिनः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2176479, "chapter_id": 4733, "verse_number": "२९", "content_sanskrit": "प्राणान्तकरिणीं घोरां वेदनामविचिन्तयन् ।\nदुर्योधनो वासुदेवं वाग्भिरुग्राभिरार्दयत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2176480, "chapter_id": 4733, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2176481, "chapter_id": 4733, "verse_number": "३०", "content_sanskrit": "कंसदासस्य दायाद न ते लज्जाऽस्त्यनेन वै ।\nअधर्मेण गदायुद्धे यदहं विनिपातितः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2176482, "chapter_id": 4733, "verse_number": "३१", "content_sanskrit": "ऊरू भिन्धीति भीमस्य स्मृतिं मिथ्या प्रयच्छसि ।\nकिं न विज्ञातमेतन्मे यदर्जुनमवोचथाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2176483, "chapter_id": 4733, "verse_number": "३२", "content_sanskrit": "पातयित्वा महीपालान् ऋजुयुद्धान् सहस्रशः ।\nजिह्मैरुपायैर्निपुणैर्न ते लज्जा न ते घृणा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2176484, "chapter_id": 4733, "verse_number": "३३", "content_sanskrit": "अहन्यहनि शूराणां कुर्वाणः कदनं महत् ।\nशिखण्डिनं पुरस्कृत्य घातितः स पितामहः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2176485, "chapter_id": 4733, "verse_number": "३४", "content_sanskrit": "अश्वत्थाम्नः सनामानं हत्वा नागं सुदुर्मते ।\nआचार्यस्त्याजितः शस्त्रं किं तन्न विदितं मम\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2176486, "chapter_id": 4733, "verse_number": "३५", "content_sanskrit": "स चानेन नृशंसेन धृष्टद्युम्नेन वीर्यवान् ।\nहन्यमानस्त्वया दृष्टो न चैनं समवारयः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2176487, "chapter_id": 4733, "verse_number": "३६", "content_sanskrit": "वधार्थं पाण्डुपुत्रस्य याचितां शक्तिमेव च ।\nघटोत्कचे व्यंसयेथाः कस्त्वत्तः पापकृत्तमः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2176488, "chapter_id": 4733, "verse_number": "३७", "content_sanskrit": "छिन्नबाहुः प्रायगतस्तथा भूरिश्रवा रणे ।\nत्वया निसृष्टेन हतः शैनेयेन दुरात्मना\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2176489, "chapter_id": 4733, "verse_number": "३८", "content_sanskrit": "कुर्वाणश्चोत्तमं कर्म कर्णः पार्थजिघांसया ।\nव्यसनेनाश्वसेनस्य पन्नगेन्द्रसुतस्य वै\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2176490, "chapter_id": 4733, "verse_number": "३९", "content_sanskrit": "पुनश्च पतिते चक्रे व्यसनार्तः पराजितः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2176491, "chapter_id": 4733, "verse_number": "४०", "content_sanskrit": "पातितश्च रणे कर्णश्चक्रव्यग्रोऽग्रणीर्नृणाम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2176492, "chapter_id": 4733, "verse_number": "४१", "content_sanskrit": "यदि मां चैव कर्णं च भीष्मद्रोणौ च संयुगे ।\nन्यायेन प्रतियुध्येथा न वः स्याद् विजयो ध्रुवः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2176493, "chapter_id": 4733, "verse_number": "४२", "content_sanskrit": "त्वया पुनरनार्येण जिह्ममार्गेण पार्थिवाः ।\nये धर्ममनुतिष्ठन्तो वयं चान्ये निपातिताः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2176494, "chapter_id": 4733, "verse_number": "४३", "content_sanskrit": "त्वया मायाविना कृष्ण मायामर्कप्रमोषिणीम् ।\nकृत्वा हतः सिन्धुपतिः किं तन्न विदितं मम\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2176495, "chapter_id": 4733, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2176496, "chapter_id": 4733, "verse_number": "४४", "content_sanskrit": "हतस्त्वमसि गान्धारे सभ्रातृसुतबान्धवः ।\nसगणः ससुहृच्चैव पापमार्गमनुष्ठितः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2176497, "chapter_id": 4733, "verse_number": "४५", "content_sanskrit": "तवैव दुष्कृतैर्वीरो भीष्मद्रोणौ निपातितौ ।\nकर्णश्च निहतः सङ्खे तव शीलानुवर्तकः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2176498, "chapter_id": 4733, "verse_number": "४६", "content_sanskrit": "याच्यमानो मया मूढः पित्र्यमंशं न दित्ससि ।\nपाण्डवेभ्यः स्वराज्यार्थं लोभाच्छकुनिनिश्चयात्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2176499, "chapter_id": 4733, "verse_number": "४७", "content_sanskrit": "विषं ते भीमसेनाय दत्तं सर्वे च पाण्डवाः ।\nप्रदीपिता जतुगृहे मात्रा सह सुदुर्मते\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2176500, "chapter_id": 4733, "verse_number": "४८", "content_sanskrit": "सभायां याज्ञसेनी च द्यूते क्लिष्टा रजस्वला ।\nतदैव तावद् दुष्टात्मा वध्यस्त्वं निरपत्रपः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2176501, "chapter_id": 4733, "verse_number": "४९", "content_sanskrit": "अनक्षज्ञं च धर्मज्ञं सौबलेनाक्षदेविना ।\nनिकृत्या वै पराजैषीस्तस्मादसि रणे हतः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2176502, "chapter_id": 4733, "verse_number": "५०", "content_sanskrit": "जयद्रथेन पापेन यत् कृष्णा क्लेशिता वने ।\nयातेषु मृगयामेषु तृणबिन्दोस्तथाऽऽश्रमे\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2176503, "chapter_id": 4733, "verse_number": "५१", "content_sanskrit": "अभिमन्युश्च यद्बाल एको बहुभिराहवे ।\nत्वद्दोषैर्निहतः पाप तस्मादसि रणे हतः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2176504, "chapter_id": 4733, "verse_number": "५२", "content_sanskrit": "कुर्वाणं कर्म समरे पाण्डवानर्थकाङ्क्षिणम् ।\nयच्छिखण्ड्यवधीद् भीष्मं मित्रार्थे न व्यतिक्रमः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2176505, "chapter_id": 4733, "verse_number": "५३", "content_sanskrit": "स्वधर्मं पृष्ठतः कृत्वा आचार्यस्त्वत्प्रियेप्सया ।\nपार्षतेन हतः सङ्खे वर्तमानोऽसतां पथि\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2176506, "chapter_id": 4733, "verse_number": "५४", "content_sanskrit": "प्रतिज्ञामात्मनः सत्यां चिकीर्षन् समरे रिपुम् ।\nहतवान् सात्वतो विद्वान् सौमदत्तिं महारथम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2176507, "chapter_id": 4733, "verse_number": "५५", "content_sanskrit": "अर्जुनः समरे राजन् युध्यमानः कदाचन ।\nनिन्दितं पुरुषव्याघ्रः करोति न कथञ्चन\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2176508, "chapter_id": 4733, "verse_number": "५६", "content_sanskrit": "लब्ध्वाऽपि बहुशः छिद्रं वीरवृत्तमनुस्मरन् ।\nन जघान रणे कर्णं मैवं वोचः सुदुर्मते\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2176509, "chapter_id": 4733, "verse_number": "५७", "content_sanskrit": "देवानां मतमाज्ञाय तेषां प्रियहितेप्सया ।\nअर्जुनस्य नते नागं मया व्यंसितमस्रजम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2176510, "chapter_id": 4733, "verse_number": "५८", "content_sanskrit": "त्वं च भीष्मश्च कर्णश्च द्रोणो द्रौणिस्तथा कृपः ।\nविराटनगरे तस्य आनृशंस्याच्च जीविताः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2176511, "chapter_id": 4733, "verse_number": "५९", "content_sanskrit": "स्मर पार्थस्य विक्रान्तं गन्धर्वेषु कृतं तदा ।\nअधर्मः कोऽत्र गान्धारे पाण्डवैर्यत् कृतं त्वयि\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2176512, "chapter_id": 4733, "verse_number": "६०", "content_sanskrit": "स्वबाहुबलमास्थाय स्वधर्मेण परन्तपाः ।\nजितवन्तो रणे वीराः पापोऽसि निधनं गतः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2176513, "chapter_id": 4733, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2176514, "chapter_id": 4733, "verse_number": "६१", "content_sanskrit": "अधीतं सुहुतं दत्तं भूः प्रभुक्ता ससागरा ।\nमूर्ध्नि स्थितममित्राणां को नु स्वन्ततरो मया\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2176515, "chapter_id": 4733, "verse_number": "६२", "content_sanskrit": "सर्वेषां क्षत्रबन्धूनां स्वधर्ममनुपश्यताम् ।\nतदिदं निधनं प्राप्तं को नु स्वन्ततरो मया\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2176516, "chapter_id": 4733, "verse_number": "६३", "content_sanskrit": "राजार्हा मानुषा भोगाः प्राप्ताश्चासुलभा नृपैः ।\nऐश्वर्यं चोत्तमं प्राप्तं को नु स्वन्ततरो मया\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2176517, "chapter_id": 4733, "verse_number": "६४", "content_sanskrit": "ससुहृत् सानुबन्धश्च स्वर्गं यातोऽहमच्युत ।\nयूयं गर्हितसङ्कल्पाः शोचन्तो वर्तयिष्यथ\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2176518, "chapter_id": 4733, "verse_number": "६५", "content_sanskrit": "न मे विषादो भीमेन पादेन शिर आहतम् ।\nकाका वा कङ्कगृध्रा वा निधास्यन्ति पदं क्षणात्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2176519, "chapter_id": 4733, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2176520, "chapter_id": 4733, "verse_number": "६६", "content_sanskrit": "अस्य वाक्यस्य निधने कुरुराजस्य भारत ।\nअपतत् सुमहद् वर्षं पुष्पाणां दिव्यगन्धिनाम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2176521, "chapter_id": 4733, "verse_number": "६७", "content_sanskrit": "अवाद्यन्त च तूर्याणि जगुश्चाप्सरसां गणाः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2176522, "chapter_id": 4733, "verse_number": "६८", "content_sanskrit": "जगुश्चाप्सरसो राज्ञो यशः सम्बद्धमेव च ।\nसिद्धाश्च मुमुचुर्नादं साधु साध्विति भारत\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2176523, "chapter_id": 4733, "verse_number": "६९", "content_sanskrit": "ववौ च सुरभिर्वातः पुण्यगन्धः शुचिर्मृदुः ।\nव्यराजतामलं चैव नभो वैडूर्यसन्निभम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2176524, "chapter_id": 4733, "verse_number": "७०", "content_sanskrit": "इत्यद्भुतानि ते दृष्ट्वा वासुदेवपुरोगमाः ।\nदुर्योधनस्य पूजां च कृतां व्रीडामुपागमन्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2176525, "chapter_id": 4733, "verse_number": "७१", "content_sanskrit": "हतांश्चाधर्मतः श्रुत्वा शोकार्ताः शुशुचुर्हि ते ।\nभीष्मं द्रोणं तथा कर्णं भूरिश्रवसमेव च\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2176526, "chapter_id": 4733, "verse_number": "७२", "content_sanskrit": "तांस्तु चिन्तापरान् दृष्ट्वा पाण्डवान् दीनचेतसः ।\nप्रोवाचेदं वचः कृष्णो मेघदुन्दुभिनिस्वनः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2176527, "chapter_id": 4733, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2176528, "chapter_id": 4733, "verse_number": "७३", "content_sanskrit": "नैष शक्योऽतिशीघ्रास्त्रः ते च सर्वे महारथाः ।\nऋजुयुद्धेन विक्रान्ता हन्तुं युष्माभिराहवे\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2176529, "chapter_id": 4733, "verse_number": "७४", "content_sanskrit": "उपायान्निहता ह्येते मया तस्मान्नराधिपाः ।\nअन्यथा पाण्डवेयानां नाभविष्यज्जयः क्वचित्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2176530, "chapter_id": 4733, "verse_number": "७५", "content_sanskrit": "ते हि सर्वे महेष्वासाः चत्वारोऽतिरथा भुवि ।\nन शक्या धर्मतो हन्तुं लोकपालैरपि स्वयम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2176531, "chapter_id": 4733, "verse_number": "७६", "content_sanskrit": "तथैवायं गदापाणिर्धार्तराष्ट्रो गतक्लमः ।\nन शक्यो धर्मतो हन्तुं कालेनापि हि दण्डिना\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2176532, "chapter_id": 4733, "verse_number": "७७", "content_sanskrit": "न च वो हृदि कर्तव्यं यदयं निहतो नृपः ।\nमिथ्यावध्याच्छलोपायैर्बहवः शत्रवो हताः\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2176533, "chapter_id": 4733, "verse_number": "७८", "content_sanskrit": "पूर्वं ह्यनुगतो मार्गो देवैरसुरघातिभिः ।\nसद्भिश्चानुगतः पन्था सर्वैरनुगमिष्यते\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2176534, "chapter_id": 4733, "verse_number": "७९", "content_sanskrit": "एवं विधात्रा विहितो वध ह्येष महात्मना ।\nदैवं पुरुषकारेण न शक्यमतिवर्तितुम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2176535, "chapter_id": 4733, "verse_number": "८०", "content_sanskrit": "भूतं भव्यं भविष्यच्च निमेषाद् यो हनिष्यति ।\nकृतान्तमन्यथा कर्तुं नेच्छेत् सोऽयं धनञ्जय\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2176536, "chapter_id": 4733, "verse_number": "८१", "content_sanskrit": "कृतकृत्याः स्म सायाह्ने निवासं रोचयामहे ।\nसाश्वनागरथाः सर्वे विश्राम्यन्तु नराधिपाः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2176537, "chapter_id": 4733, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2176538, "chapter_id": 4733, "verse_number": "८२", "content_sanskrit": "वासुदेववचः श्रुत्वा तदानीं पाण्डवैः सह ।\nपाञ्चाला भृशसंहृष्टा विनेदुः सिंहसङ्घवत्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2176539, "chapter_id": 4733, "verse_number": "८३", "content_sanskrit": "ततः प्राध्मापयच्छङ्खं पाञ्चजन्यं जनार्दनः ।\nदेवदत्तं प्रहृष्टात्मा शङ्खप्रवरमर्जुनः\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2176540, "chapter_id": 4733, "verse_number": "८४", "content_sanskrit": "(अनन्तविजयं राजा कुन्तीपुत्रो युधिष्ठिरः ।\nपौण्ड्रं दध्मौ महाशङ्खं भीमकर्मा वृकोदरः\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2176541, "chapter_id": 4733, "verse_number": "८५", "content_sanskrit": "नकुलः सहदेवश्च सुघोषमणिपुष्पकौ ।\nधृष्टद्युम्नस्तथा जैत्रं सात्यकिर्नन्दिवर्धनम्\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2176542, "chapter_id": 4733, "verse_number": "८६", "content_sanskrit": "तेषां नादेन महता शङ्खानां भरतर्षभ ।\nआपुपूरे नभः सर्वं पृथिवी च चचाल ह\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2176543, "chapter_id": 4733, "verse_number": "", "content_sanskrit": "ततः शङ्खाश्च भेर्यश्च पणवानकगोमुखाः ।\nपाण्डुसैन्येष्ववाद्यन्त स शब्दस्तुमुलोऽभवत्\t॥८७॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2176544, "chapter_id": 4733, "verse_number": "८८", "content_sanskrit": "अस्तुवन् पाण्डवानन्ये गीर्भिश्च स्तुतिमङ्गलैः ।\nहृष्टा दुर्योधनं दृष्ट्वा निहतं पुरुषर्षभाः\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2176545, "chapter_id": 4733, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि साधुवचनं नाम एकत्रिंशोऽध्यायः ॥३१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}]