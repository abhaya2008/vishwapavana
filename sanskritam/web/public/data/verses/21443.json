[{"id": 7001443000, "chapter_id": 21443, "verse_number": "७-१-१६-१", "content_sanskrit": "वायुरुवाच ।\nअथ देवो महादेवो महाजलदनादया ।\nवाचा मधुरगंभीरशिवदश्लक्ष्णवर्णया॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001443001, "chapter_id": 21443, "verse_number": "७-१-१६-२", "content_sanskrit": "अर्थसंपन्नपदया राजलक्षणयुक्तया ।\nअशेषविषयारंभरक्षाविमलदक्षया॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001443002, "chapter_id": 21443, "verse_number": "७-१-१६-३", "content_sanskrit": "मनोहरतरोदारमधुरस्मितपूर्वया ।\nसंबभाषे सुसंपीतो विश्वकर्माणमीश्वरः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001443003, "chapter_id": 21443, "verse_number": "७-१-१६-४", "content_sanskrit": "ईश्वर उवाच ।\nवत्स वत्स महाभाग मम पुत्र पितामह ।\nज्ञातमेव मया सर्वं तव वाक्यस्य गौरवम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001443004, "chapter_id": 21443, "verse_number": "७-१-१६-५", "content_sanskrit": "प्रजानामेव बृद्ध्यर्थं तपस्तप्तं त्वयाधुना ।\nतपसा ऽनेन तुष्टोस्मि ददामि च तवेप्सितम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001443005, "chapter_id": 21443, "verse_number": "७-१-१६-६", "content_sanskrit": "इत्युक्त्वा परमोदारं स्वभावमधुरं वचः ।\nससर्ज वपुषो भागाद्देवीं देववरो हरः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001443006, "chapter_id": 21443, "verse_number": "७-१-१६-७", "content_sanskrit": "यामाहुर्ब्रह्मविद्वांसो देवीं दिव्यगुणान्विताम् ।\nपरस्य परमां शक्तिं भवस्य परमात्मनः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001443007, "chapter_id": 21443, "verse_number": "७-१-१६-८", "content_sanskrit": "यस्यां न खलु विद्यंते जन्म मृत्युजरादयः ।\nया भवानी भवस्यांगात्समाविरभवत्किल॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001443008, "chapter_id": 21443, "verse_number": "७-१-१६-९", "content_sanskrit": "यस्या वाचो निवर्तन्ते मनसा चेंद्रियैः सह ।\nसा भर्तुर्वपुषो भागाज्जातेव समदृश्यत॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001443009, "chapter_id": 21443, "verse_number": "७-१-१६-१०", "content_sanskrit": "या सा जगदिदं कृत्स्नं महिम्ना व्याप्य तिष्ठति ।\nशरीरिणीव स देवी विचित्रं समलक्ष्यत॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001443010, "chapter_id": 21443, "verse_number": "७-१-१६-११", "content_sanskrit": "सर्वं जगदिदं चैषा संमोहयति मायया ।\nईश्वरात्सैव जाताभूदजाता परमार्थतः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001443011, "chapter_id": 21443, "verse_number": "७-१-१६-१२", "content_sanskrit": "न यस्या परमो भावः सुराणामपि गोचरः ।\nविश्वामरेश्वरी चैव विभक्ता भर्तुरंगतः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001443012, "chapter_id": 21443, "verse_number": "७-१-१६-१३", "content_sanskrit": "तां दृष्ट्वा परमेशानीं सर्वलोकमहेश्वरीम् ।\nसर्वज्ञां सर्वगां सूक्ष्मां सदसद्व्यक्तिवर्जिताम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001443013, "chapter_id": 21443, "verse_number": "७-१-१६-१४", "content_sanskrit": "परमां निखिलं भासा भासयन्तीमिदं जगत् ।\nप्रणिपत्य महादेवीं प्रार्थयामास वै विराट्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001443014, "chapter_id": 21443, "verse_number": "७-१-१६-१५", "content_sanskrit": "ब्रह्मोवाच ।\nदेवि देवेन सृष्टो ऽहमादौ सर्वजगन्मयि ।\nप्रजासर्गे नियुक्तश्च सृजामि सकलं जगत्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001443015, "chapter_id": 21443, "verse_number": "७-१-१६-१६", "content_sanskrit": "मनसा निर्मिताः सर्वे देवि देवादयो मया ।\nन वृद्धिमुपगच्छन्ति सृज्यमानाः पुनः पुनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001443016, "chapter_id": 21443, "verse_number": "७-१-१६-१७", "content_sanskrit": "मिथुनप्रभवामेव कृत्वा सृष्टिमतः परम् ।\nसंवर्धयितुमिच्छामि सर्वा एव मम प्रजाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001443017, "chapter_id": 21443, "verse_number": "७-१-१६-१८", "content_sanskrit": "न निर्गतं पुरा त्वत्तो नारीणां कुलमव्ययम् ।\nतेन नारीकुलं स्रष्टुं शक्तिर्मम न विद्यते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001443018, "chapter_id": 21443, "verse_number": "७-१-१६-१९", "content_sanskrit": "सर्वासामेव शक्तीनां त्वत्तः खलु समुद्भवः ।\nतस्मात्सर्वत्र सर्वेषां सर्वशक्तिप्रदायिनीम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001443019, "chapter_id": 21443, "verse_number": "७-१-१६-२०", "content_sanskrit": "त्वामेव वरदां मायां प्रार्थयामि सुरेश्वरीम् ।\nचराचरविवृद्ध्यर्थमंशेनैकेन सर्वगे॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001443020, "chapter_id": 21443, "verse_number": "७-१-१६-२१", "content_sanskrit": "दक्षस्य मम पुत्रस्य पुत्री भव भवार्दिनि ।\nएवं सा याचिता देवी ब्रह्मणा ब्रह्मयोनिना॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001443021, "chapter_id": 21443, "verse_number": "७-१-१६-२२", "content_sanskrit": "शक्तिमेकां भ्रुवोर्मध्यात्ससर्जात्मसमप्रभाम् ।\nतामाह प्रहसन्प्रेक्ष्य देवदेववरो हरः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001443022, "chapter_id": 21443, "verse_number": "७-१-१६-२३", "content_sanskrit": "ब्रह्माणं तपसाराध्य कुरु तस्य यथेप्सितम् ।\nतामाज्ञां परमेशस्य शिरसा प्रतिगृह्य सा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001443023, "chapter_id": 21443, "verse_number": "७-१-१६-२४", "content_sanskrit": "ब्रह्मणो वचनाद्देवी दक्षस्य दुहिताभवत् ।\nदत्त्वैवमतुलां शक्तिं ब्रह्मणे ब्रह्मरूपिणीम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001443024, "chapter_id": 21443, "verse_number": "७-१-१६-२५", "content_sanskrit": "विवेश देहं देवस्य देवश्चांतरधीयत ।\nतदा प्रभृति लोके ऽस्मिन् स्त्रियां भोगः प्रतिष्ठितः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001443025, "chapter_id": 21443, "verse_number": "७-१-१६-२६", "content_sanskrit": "प्रजासृष्टिश्च विप्रेंद्रा मैथुनेन प्रवर्तते ।\nब्रह्मापि प्राप सानन्दं सन्तोषं मुनिपुंगवाः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001443026, "chapter_id": 21443, "verse_number": "७-१-१६-२७", "content_sanskrit": "एतद्वस्सर्वमाख्यातं देव्याः शक्तिसमुद्भवम् ।\nपुण्यवृद्धिकरं श्राव्यं भूतसर्गानुपंगतः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001443027, "chapter_id": 21443, "verse_number": "७-१-१६-२८", "content_sanskrit": "य इदं कीर्तयेन्नित्यं देव्याः शक्तिसमुद्भवम् ।\nपुण्यं सर्वमवाप्नोति पुत्रांश्च लभते शुभान्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]