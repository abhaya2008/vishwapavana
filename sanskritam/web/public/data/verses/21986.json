[{"id": 7001986000, "chapter_id": 21986, "verse_number": "३१-१", "content_sanskrit": "अग्निरुवाच ।\nरक्षां स्वस्य परेषाञ्च वक्ष्ये तां मार्जनाह्वयां ।\nयया विमुच्यते दुःखैः सुखञ्च प्राप्नुयान्नरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001986001, "chapter_id": 21986, "verse_number": "३१-२", "content_sanskrit": "ॐ नमः परमार्थाय पुरुषाय महात्मने ।\nअरूपबहुरूपाय व्यापिने परमात्मने ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001986002, "chapter_id": 21986, "verse_number": "३१-३", "content_sanskrit": "निष्कल्मषाय शुद्धाय ध्यानयोगरताय च ।\nनमस्कृत्य प्रवक्ष्यामि यत्तत्सिध्यतु मे वचः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001986003, "chapter_id": 21986, "verse_number": "३१-४", "content_sanskrit": "वराहाय नृसिंहाय वामनाय महामुने ।\nनमस्कृत्य प्रवक्ष्यामि यत्तत्सिध्यतु मे वचः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001986004, "chapter_id": 21986, "verse_number": "३१-५", "content_sanskrit": "त्रिविक्रमाय रामाय वैकुण्ठाय नराय च ।\nनमस्कृत्य प्रवक्ष्यामि यत्तत्सिध्यतु मे वचः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001986005, "chapter_id": 21986, "verse_number": "३१-६", "content_sanskrit": "वराह नरसिंहेश वामनेश त्रिविक्रम ।\nहरग्रीवेश सर्वेश हृषीकेश हराशुभम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001986006, "chapter_id": 21986, "verse_number": "३१-७", "content_sanskrit": "अपराजितचक्राद्यैश्चतुर्भिः परमायुधैः ।\nअखण्डितानुभावैस्त्वं सर्वदुष्टहरो भव ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001986007, "chapter_id": 21986, "verse_number": "३१-८", "content_sanskrit": "हरामुकस्य दुरितं सर्वञ्च कुशलं कुरु ।\nमृत्युबन्धार्तभयदं दुरितस्य च यत्फलम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001986008, "chapter_id": 21986, "verse_number": "३१-९", "content_sanskrit": "पराभिध्यानसहितैः प्रयुक्तञ्चाभिचारकम् ।\nगदस्पर्शमहारोगप्रयोगं जरया जर ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001986009, "chapter_id": 21986, "verse_number": "३१-१०", "content_sanskrit": "ॐ नमो वासुदेवाय नमः कृष्णाय खड्गिने ।\nनमः पुष्करनेत्राय केशवायादिचक्रिणे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001986010, "chapter_id": 21986, "verse_number": "३१-११", "content_sanskrit": "नमः कमलकिञ्जल्कपीतनिर्मलवाससे ।\nमहाहररिपुस्कन्धसृष्टचक्राय चक्रिणे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001986011, "chapter_id": 21986, "verse_number": "३१-१२", "content_sanskrit": "द्ंष्ट्रोद्धृतक्षितिभृते त्रयीमूर्तिमते नमः ।\nमहायज्ञवराहाय शेषभोगाङ्कशायिने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001986012, "chapter_id": 21986, "verse_number": "३१-१३", "content_sanskrit": "तप्तहाटककेशाग्रज्वलत्पावकलोचन ।\nवज्राधिकनखस्पर्शं दिव्यसिंह नमोस्तु ते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001986013, "chapter_id": 21986, "verse_number": "३१-१४", "content_sanskrit": "काश्यपायातिह्रस्वाय ऋग्यजुःसामभूषित ।\nतुभ्यं वामनरूपायाक्रमते गां नमो नमः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001986014, "chapter_id": 21986, "verse_number": "३१-१५", "content_sanskrit": "वराहाशेषदुष्टानि सर्वपापफलानि वै ।\nमर्द मर्द महादंष्ट्र मर्द मर्द च तत्फलम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001986015, "chapter_id": 21986, "verse_number": "३१-१६", "content_sanskrit": "नरसिंह करालाख्य दन्तप्रान्तानलोज्ज्वल ।\nभञ्ज भञ्ज निनादेन दुष्टान्यस्यार्तिनाशन ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001986016, "chapter_id": 21986, "verse_number": "३१-१७", "content_sanskrit": "ऋग्यजुःसामगर्भाभिर्वाग्भिर्वामनरूपधृक् ।\nप्रशमं सर्वदुःखानि नयत्त्वस्य जनार्दनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001986017, "chapter_id": 21986, "verse_number": "३१-१८", "content_sanskrit": "ऐकाहिकं द्व्याहिकञ्च तथा त्रिदिवसं ज्वरम् ।\nचातुर्थकन्तथात्युग्रन्तथैव सततज्वरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001986018, "chapter_id": 21986, "verse_number": "३१-१९", "content_sanskrit": "दोषोत्थं सन्निपातोत्थं तथैवागन्तुकं ज्वरम् ।\nशमं नयाशु गोविन्द च्छिन्धि च्छिन्ध्यस्य वेदनाम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001986019, "chapter_id": 21986, "verse_number": "३१-२०", "content_sanskrit": "नेत्रदुःखं शिरोदुःखं दुःखञ्चोदरसम्भवम् ।\nअन्तःश्वासमतिश्वासं परितापं सवेपथुम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001986020, "chapter_id": 21986, "verse_number": "३१-२१", "content_sanskrit": "गुदघ्राणाङ्घ्रिरोगांश्च कुष्ठरोगांस्तथा क्षयं ।\nकामलादींस्तथा रोगान् प्रमेहांश्चातिदारुणान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001986021, "chapter_id": 21986, "verse_number": "३१-२२", "content_sanskrit": "भगन्दरातिसारांश्च मुखरोगांश्च वल्गुलीम् ।\nअश्मरीं मूत्रकृच्छ्रांश्च रोगानन्यांश्च दारुणान् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001986022, "chapter_id": 21986, "verse_number": "३१-२३", "content_sanskrit": "ये वातप्रभवा रोगा ये च पित्तसमुद्भवाः ।\nकफोद्भवाश्च ये केचित्ये चान्ये सान्निपातिकाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001986023, "chapter_id": 21986, "verse_number": "३१-२४", "content_sanskrit": "आगन्तुकाश्च ये रोगा लूता विस्फोटकादयः ।\nते सर्वे प्रशमं यान्तु वासुदेवापमार्जिताः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001986024, "chapter_id": 21986, "verse_number": "३१-२५", "content_sanskrit": "विलयं यान्तु ते सर्वे विष्णोरुच्चारणेन च ।\nक्षयं गछ्हन्तु चाशेषास्ते चक्राभिहता हरेः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001986025, "chapter_id": 21986, "verse_number": "३१-२६", "content_sanskrit": "अच्युतानन्तगोविन्दनामोच्चारणभीषिताः ।\nनश्यन्ति सकला रोगाः सत्यं सत्यं वदाम्यहम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001986026, "chapter_id": 21986, "verse_number": "३१-२७", "content_sanskrit": "स्थावरं जङ्गमं वापि कृत्रिमं चापि यद्विषम् ।\nदन्तोद्भवं नखभवमाकाशप्रभवं विषम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001986027, "chapter_id": 21986, "verse_number": "३१-२८", "content_sanskrit": "लूतादिप्रभवं यच्च विषमन्यत्तु दुःखदं ।\nशमं नयतु तत्सर्वं कीर्तितोस्य जनार्दनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001986028, "chapter_id": 21986, "verse_number": "३१-२९", "content_sanskrit": "ग्रहान् प्रेतग्रहांश्चापि तथा वै डाकिनीग्रहान् ।\nवेतालांश्च पिशाचांश्च गन्धर्वान् यक्षराक्षसान् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001986029, "chapter_id": 21986, "verse_number": "३१-३०", "content_sanskrit": "शकुनीपूतनाद्यांश्च तथा वैनायकान् ग्रहान् ।\nमुखमण्डीं तथा क्रूरां रेवतीं वृद्धरेवतीम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001986030, "chapter_id": 21986, "verse_number": "३१-३१", "content_sanskrit": "वृद्धकाख्यान् ग्रहांश्चोग्रांस्तथा मातृग्रहानपि ।\nबालस्य विष्णोश्चरितं हन्तु बालग्रहानिमान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001986031, "chapter_id": 21986, "verse_number": "३१-३२", "content_sanskrit": "वृद्धाश्च ये ग्रहाः केचिद्ये च बालग्रहाः क्वचित् ।\nनरसिंहस्य ते दृष्ट्या दग्धा ये चापि यौवने ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001986032, "chapter_id": 21986, "verse_number": "३१-३३", "content_sanskrit": "सदा करालवदनो नरसिंहो महाबलः ।\nग्रहानशेषान्निःशेषान् करोतु जगतो हितः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001986033, "chapter_id": 21986, "verse_number": "३१-३४", "content_sanskrit": "नरसिंह महासिंह ज्वालामालोज्ज्वलानन ।\nग्रहानशेषान् सर्वेश खाद खादाग्निलोचन ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001986034, "chapter_id": 21986, "verse_number": "३१-३५", "content_sanskrit": "ये रोगा ये महोत्पाता यद्विषं ये महाग्रहाः ।\nयानि च क्रूरभृतानि ग्रहपीडाश्च दारुणाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001986035, "chapter_id": 21986, "verse_number": "३१-३६", "content_sanskrit": "शस्त्रक्षतेषु ये दोषा ज्वालागर्दभकादयः ।\nतानि सर्वाणि सर्वात्मा परमात्मा जनार्दनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001986036, "chapter_id": 21986, "verse_number": "३१-३७", "content_sanskrit": "किञ्चिद्रूपं समास्याय वासुदेवास्य नाशय ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001986037, "chapter_id": 21986, "verse_number": "३१-३८", "content_sanskrit": "क्षिप्त्वा सुदर्शनञ्चक्रं ज्वालामालातिभीषणम् ।\nसर्वदुष्टोपशमनं कुरु देववराच्युत ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001986038, "chapter_id": 21986, "verse_number": "३१-३९", "content_sanskrit": "सुदर्शन महाज्वाल च्छिन्धि च्छिन्धि महारव ।\nसर्वदुष्टानि रक्षांसि क्षयं यान्तु विभीषण ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001986039, "chapter_id": 21986, "verse_number": "३१-४०", "content_sanskrit": "प्राच्यां प्रतीच्यां च दिशि दक्षिणोत्तरतस्तथा ।\nरक्षाङ्करोतु सर्वात्मा नरसिंहः सुगर्जितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001986040, "chapter_id": 21986, "verse_number": "३१-४१", "content_sanskrit": "दिवि भुव्यन्तरीक्षे च पृष्ठतः पार्श्वतोग्रतः ।\nरक्षाङ्करोतु भगवान् बहुरूपी जनार्दनः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001986041, "chapter_id": 21986, "verse_number": "३१-४२", "content_sanskrit": "यथा विष्णुर्जगत्सर्वं सदेवासुरमानुषं ।\nतेन सत्येन दुष्टानि शममस्य व्रजन्तु वै ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001986042, "chapter_id": 21986, "verse_number": "३१-४३", "content_sanskrit": "यथा विष्णौ स्मृते सद्यः सङ्क्षयं यान्ति पातकाः ।\nसत्येन तेन सकलं दुष्टमस्य प्रशाम्यतु ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001986043, "chapter_id": 21986, "verse_number": "३१-४४", "content_sanskrit": "परमात्मा यथा विष्णुर्वेदान्तेषु च गीयते ।\nतेन सत्येन सकलं दुष्टमस्य प्रशाम्यतु ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001986044, "chapter_id": 21986, "verse_number": "३१-४५", "content_sanskrit": "यथा यज्ञेश्वरो विष्णुर्देवेष्वपि हि गीयते ।\nसत्येन तेन सकलं यन्मयोक्तं तथास्तु तत् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001986045, "chapter_id": 21986, "verse_number": "३१-४६", "content_sanskrit": "शान्तिरस्तु शिवञ्चास्तु दुष्टमस्य प्रशाम्यतु ।\nवासुदेवशरीरोत्थैः कुशैर्निर्मथितं मया ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001986046, "chapter_id": 21986, "verse_number": "३१-४७", "content_sanskrit": "अपमार्जतु गोविन्दो नरो नारायणस्तथा ।\nतथास्तु सर्वदुःखानां प्रशमो जपनाद्धरेः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001986047, "chapter_id": 21986, "verse_number": "३१-४८", "content_sanskrit": "अपमार्जनकं शस्त्रं सर्वरोगादिवारणम् ।\nअयं हरिः कुशो विष्णुर्हता रोगा मया तव ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]