[{"id": 2174341, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2174342, "chapter_id": 4703, "verse_number": "१", "content_sanskrit": "मुहूर्तादिव राजेन्द्र सर्वं शून्यमदृश्यत ।\nमत्तवारणसङ्घुष्टं शिबिरं विद्रुते बले\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2174343, "chapter_id": 4703, "verse_number": "२", "content_sanskrit": "यत्र शब्देन महता अबुध्यन्त महारथाः ।\nतत्र शब्दं न शृणुमो मनुष्यस्यापि कस्यचित्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2174344, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2174345, "chapter_id": 4703, "verse_number": "३", "content_sanskrit": "हतेषु तेषु सैन्येषु पाण्डुपुत्रै रणाजिरे ।\nमामका ह्यवशिष्टास्ते किमकुर्वत सञ्जय\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2174346, "chapter_id": 4703, "verse_number": "४", "content_sanskrit": "कृपश्च कृतवर्मा च द्रोणपुत्रश्च वीर्यवान् ।\nदुर्योधनश्च मन्दात्मा राजा किमकरोत् तदा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2174347, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2174348, "chapter_id": 4703, "verse_number": "५", "content_sanskrit": "सम्प्राद्रवत्सु दारेषु क्षत्रियाणां महात्मनाम् ।\nविद्रुते शिबिरे शून्ये भयोद्विग्नास्त्रयो रथाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2174349, "chapter_id": 4703, "verse_number": "६", "content_sanskrit": "निशम्य पाण्डुपुत्राणां जयिनां सुमहास्वनम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2174350, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2174351, "chapter_id": 4703, "verse_number": "७", "content_sanskrit": "विद्रुतं शिबिरं दृष्ट्वा सायाह्ने राजगर्धिनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2174352, "chapter_id": 4703, "verse_number": "८", "content_sanskrit": "स्थानं नारोचयंस्तत्र ततस्तं ह्रदमभ्ययुः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2174353, "chapter_id": 4703, "verse_number": "९", "content_sanskrit": "युधिष्ठिरोऽपि कौन्तेयो भ्रातृभिः सहितो रणे ।\nहृष्टः पर्यतपद् राजन् दुर्योधनवधेप्सया\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2174354, "chapter_id": 4703, "verse_number": "१०", "content_sanskrit": "मार्गमाणास्तु सङ्क्रुद्धास्तव पुत्रं जिघांसवः ।\nयत्नतोऽन्वेषमाणाश्च नैवापश्यन् नराधिपम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2174355, "chapter_id": 4703, "verse_number": "११", "content_sanskrit": "स तु तीव्रेण वेगेन गदापाणिरपाक्रमत् ।\nतं ह्रदं प्राविशच्चापि विष्टभ्यापः स्वमायया\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2174356, "chapter_id": 4703, "verse_number": "१२", "content_sanskrit": "तदा तु पाण्डवाः सर्वे सुपरिश्रान्तवाहनाः ।\nततस्ते शिबिरं प्राप्य व्यतिष्ठन् सहसैनिकाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2174357, "chapter_id": 4703, "verse_number": "१३", "content_sanskrit": "ततः कृपश्च द्रौणिश्च कृतवर्मा च सात्वतः ।\nसन्निविष्टेषु पार्थेषु प्रययुस्तं ह्रदं शनैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2174358, "chapter_id": 4703, "verse_number": "१४", "content_sanskrit": "ते तं ह्रदं समासाद्य यत्र शेते नराधिपः ।\nअभ्यभाषन्त दुर्धर्षं राजानं सुप्तमम्भसि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2174359, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "कृपादयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2174360, "chapter_id": 4703, "verse_number": "१५", "content_sanskrit": "राजन्नुत्तिष्ठ युध्यस्व सहास्माभिर्युधिष्ठिरम् ।\nजित्वा वा पृथिवीं भुङ्क्ष्व हतो वा स्वर्गमाप्नुहि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2174361, "chapter_id": 4703, "verse_number": "१६", "content_sanskrit": "तेषामपि बलं सर्वं हतं दुर्योधन त्वया ।\nप्रतिरुद्धाश्च भूयिष्ठं ये शिष्टास्तत्र सैनिकाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2174362, "chapter_id": 4703, "verse_number": "१७", "content_sanskrit": "न ते वेगं विषहितुं शक्तास्तव विशाम्पते ।\nअस्माभिरभिगुप्तस्य तस्मादुत्तिष्ठ भारत\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2174363, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2174364, "chapter_id": 4703, "verse_number": "१८", "content_sanskrit": "दिष्ट्या पश्यामि वो मुक्तान् ईदृशाज्जनसङ्क्षयात् ।\nपाण्डुकौरवसम्मर्दे जीवमानान् नरर्षभान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2174365, "chapter_id": 4703, "verse_number": "१९", "content_sanskrit": "विजेष्यामो वयं सर्वे विश्रान्ता विगतक्लमाः ।\nभवन्तश्च परिश्रान्ता अहं च भृशविक्षतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2174366, "chapter_id": 4703, "verse_number": "२०", "content_sanskrit": "उदीर्णं च बलं तेषां तेन युद्धं न रोचये\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2174367, "chapter_id": 4703, "verse_number": "२१", "content_sanskrit": "भवतामद्भुतं वीरा युद्धे महदिदं मनः ।\nअस्मासु च परा भक्तिर्दर्शिता कार्यगौरवात्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2174368, "chapter_id": 4703, "verse_number": "२२", "content_sanskrit": "विश्राम्यैकां निशामद्य भवद्भिः सहितो रणे ।\nप्रतियोद्धास्मि तान् शत्रून् श्वो वा न स्याच्छ्रमो मम\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2174369, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2174370, "chapter_id": 4703, "verse_number": "२३", "content_sanskrit": "एवमुक्तोऽब्रवीद् द्रौणी राजानं युद्धदुर्मदम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2174371, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "अश्वत्थामा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2174372, "chapter_id": 4703, "verse_number": "२४", "content_sanskrit": "उत्तिष्ठ राजन् भद्रं ते विजेष्यामो रणे परान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2174373, "chapter_id": 4703, "verse_number": "२५", "content_sanskrit": "इष्टापूर्तेन सत्येन दानेन च जपेन च ।\nशपे राजन् यथा ह्यद्य निहनिष्यामि सोमकान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2174374, "chapter_id": 4703, "verse_number": "२६", "content_sanskrit": "मा स्म यज्ञकृताँल्लोकान् प्राप्नुयां सज्जनोचितान् ।\nयदीमां रजनीं व्युष्टां न हि हन्मि परान् रणे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2174375, "chapter_id": 4703, "verse_number": "२७", "content_sanskrit": "नाहत्वा सर्वपाञ्चालान् विमोक्ष्ये कवचं विभो ।\nइति सत्यं ब्रवीम्येतत् तन्मे शृणु जनाधिप\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2174376, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2174377, "chapter_id": 4703, "verse_number": "२८", "content_sanskrit": "तेषु सम्भाषमाणेषु व्याधास्तं देशमागमन् ।\nमांसभारपरिश्रान्ताः पानीयार्थं यदृच्छया\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2174378, "chapter_id": 4703, "verse_number": "२९", "content_sanskrit": "ते हि नित्यं महाराज भीमसेनस्य लुब्धकाः ।\nमांसभारानुपाजह्रुः भक्त्या परमया युताः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2174379, "chapter_id": 4703, "verse_number": "३०", "content_sanskrit": "ते तत्र विष्ठितास्तेषां सर्वं तद्वचनं रहः ।\nदुर्योधनवचश्चैव शुश्रुवुः सङ्गता मिथः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2174380, "chapter_id": 4703, "verse_number": "३१", "content_sanskrit": "ते हि सर्वे महेष्वासा अयुद्धार्थिनि कौरवे ।\nनिर्बन्धं परमं चक्रुः सुभृशं युद्धकाङ्क्षिणः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2174381, "chapter_id": 4703, "verse_number": "३२", "content_sanskrit": "तांस्तथा ते समुद्वीक्ष्य कौरवाणां महारथान् ।\nअयुद्धमनसं चैव राजानं स्थितमम्भसि\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2174382, "chapter_id": 4703, "verse_number": "३३", "content_sanskrit": "तेषां श्रुत्वा च संवादं राज्ञश्च सलिले सतः ।\nव्याधा व्यजानन् राजेन्द्र सलिलस्थं सुयोधनम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2174383, "chapter_id": 4703, "verse_number": "३४", "content_sanskrit": "ते पूर्वं पाण्डुपुत्रेण पृष्टा ह्यासन् सुतं तव ।\nयदृच्छया गतास्तत्र राजानं परिमार्गितुम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2174384, "chapter_id": 4703, "verse_number": "३५", "content_sanskrit": "ततस्ते पाण्डुपुत्रस्य स्मृत्वा तद्भाषितं तदा ।\nअन्योन्यमब्रुवन् राजन् मृगव्याधाः शनैरिदम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2174385, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "व्याधाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2174386, "chapter_id": 4703, "verse_number": "३६", "content_sanskrit": "दुर्योधनं ख्यापयामो धनं दास्यति पाण्डवः ।\nसुव्यक्तमिह नः ख्यातो ह्रदे दुर्योधनो नृपः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2174387, "chapter_id": 4703, "verse_number": "३७", "content_sanskrit": "तस्माद् गच्छामहे सर्वे यत्र राजा युधिष्ठिरः ।\nआख्यातुं सलिले सुप्तं दुर्योधनममर्षणम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2174388, "chapter_id": 4703, "verse_number": "३८", "content_sanskrit": "धृतराष्ट्रात्मजं तस्मै भीमसेनाय धीमते ।\nशयानं सलिले सर्वे कथयामो धनुर्भृते\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2174389, "chapter_id": 4703, "verse_number": "३९", "content_sanskrit": "स नो दास्यति धर्मात्मा धनानि बहुलान्युत ।\nकिं नो मांसेन शुष्केण परिक्लिष्टेन शोषिणा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2174390, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2174391, "chapter_id": 4703, "verse_number": "४०", "content_sanskrit": "एवमुक्त्वा तु ते व्याधाः सम्प्रहृष्टाः धनार्थिनः ।\nमांसभारानुपादाय प्रययुः शिबिरं प्रति\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2174392, "chapter_id": 4703, "verse_number": "४१", "content_sanskrit": "पाण्डवाश्च महाराज लब्धलक्षाः प्रहारिणः ।\nअपश्यमानाः समरे दुर्योधनमवस्थितम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2174393, "chapter_id": 4703, "verse_number": "४२", "content_sanskrit": "निकृतेस्तस्य पापस्य युद्धाभिगमनेप्सया ।\nचारान् सम्प्रेषयामासुः समन्तात् तद् रणाजिरात्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2174394, "chapter_id": 4703, "verse_number": "४३", "content_sanskrit": "आगत्य तु ततः सर्वे नष्टं दुर्योधनं नृपम् ।\nन्यवेदयन्त सहिता धर्मराजस्य सैनिकाः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2174395, "chapter_id": 4703, "verse_number": "४४", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा चाराणां भरतर्षभ ।\nचिन्तामभ्यगमत् तीव्रं निशश्वास च पार्थिवः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2174396, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2174397, "chapter_id": 4703, "verse_number": "४५", "content_sanskrit": "अरिशेषे जीवति तु सन्दिग्धो विजयो भवेत् ।\nराज्यं कथं लभे तद्धि पूजितं विजयादिभिः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2174398, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2174399, "chapter_id": 4703, "verse_number": "४६", "content_sanskrit": "अथ स्थितानां पाण्डूनां दीनानां भरतर्षभ ।\nतस्माद् देशादपाक्रम्य त्वरिता लुब्धका विभो\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2174400, "chapter_id": 4703, "verse_number": "४७", "content_sanskrit": "आजग्मुः शिबिरं हृष्टा दृष्ट्वा दुर्योधनं नृपम् ।\nवार्यमाणाः प्रविष्टाश्च भीमसेनं दिदृक्षवः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2174401, "chapter_id": 4703, "verse_number": "४८", "content_sanskrit": "ते तु पाण्डवमासाद्य भीमसेनं महाबलम् ।\nतस्मै तत् सर्वमाचख्युर्यद् वृत्तं यच्च वै श्रुतम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2174402, "chapter_id": 4703, "verse_number": "४९", "content_sanskrit": "ततो वृकोदरो राजन् दत्वा तेषां धनं बहु ।\nधर्मराजाय तत्सर्वमाचचक्षे परन्तपः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2174403, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2174404, "chapter_id": 4703, "verse_number": "५०", "content_sanskrit": "असौ दुर्योधनो राजन् विज्ञातो मम लुब्धकैः ।\nसंस्तभ्य सलिलं शेते यस्यार्थे परितप्यसे\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2174405, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2174406, "chapter_id": 4703, "verse_number": "५१", "content_sanskrit": "तद्वचो भीमसेनस्य प्रियं श्रुत्वा विशाम्पते ।\nअजातशत्रुः कौन्तेयो हृष्टोऽभूत् सह सोदरैः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2174407, "chapter_id": 4703, "verse_number": "५२", "content_sanskrit": "तं च श्रुत्वा महेष्वासाः प्रविष्टं सलिलह्रदे ।\nक्षिप्रमेव ततोऽगच्छन् पुरस्कृत्य जनार्दनम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2174408, "chapter_id": 4703, "verse_number": "५३", "content_sanskrit": "ततः किलकिलाशब्दः प्रादुरासीद् विशाम्पते ।\nपाण्डवानां प्रहृष्टानां पाञ्चालानां च सर्वशः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2174409, "chapter_id": 4703, "verse_number": "५४", "content_sanskrit": "सिंहनादांस्ततश्चक्रुः क्ष्वेलांश्च भरतर्षभ ।\nत्वरिताः क्षत्रिया राजन् जग्मुर्द्वैपायनह्रदम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2174410, "chapter_id": 4703, "verse_number": "५५", "content_sanskrit": "ज्ञातः पापो धार्तराष्ट्रो दृष्टवीर्योऽसकृद् रणे ।\nप्राक्रोशन् सैनिकास्तत्र हृष्टरूपाः समन्ततः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2174411, "chapter_id": 4703, "verse_number": "५६", "content_sanskrit": "तेषामाशु प्रयातानां रथानारुह्य वेगिनाम् ।\nबभूव तुमुलःशब्दो दिविस्पृक् पृथिवीपते\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2174412, "chapter_id": 4703, "verse_number": "५७", "content_sanskrit": "दुर्योधनं परीप्सन्तस्तत्र तत्र युधिष्ठिरम् ।\nअन्वयुस्त्वरितास्ते वै राजानं श्रान्तवाहनाः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2174413, "chapter_id": 4703, "verse_number": "५९", "content_sanskrit": "अर्जुनो भीमसेनश्च माद्रीपुत्रौ च पाण्डवौ ।\nधृष्टद्युम्नश्च पाञ्चाल्यः शिखण्डी चापराजितः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2174414, "chapter_id": 4703, "verse_number": "५९", "content_sanskrit": "उत्तमौजा युधामन्युः सात्यकिश्च महारथः ।\nपाञ्चालानां च ये शिष्टा द्रौपदेयाश्च भारत\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2174415, "chapter_id": 4703, "verse_number": "६०", "content_sanskrit": "हयाश्च सर्वे नागाश्च शतशश्च पदातयः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2174416, "chapter_id": 4703, "verse_number": "६१", "content_sanskrit": "ततः प्राप्तो महाराज धर्मपुत्रः प्रतापवान् ।\nद्वैपायनह्रदं ख्यातं यत्र दुर्योधनोऽभवत्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2174417, "chapter_id": 4703, "verse_number": "६२", "content_sanskrit": "शीतामलजलं हृद्यं द्वितीयमिव सागरम् ।\nमायया सलिलं स्तभ्य यत्र शेते सुतस्तव\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2174418, "chapter_id": 4703, "verse_number": "६३", "content_sanskrit": "अत्यद्भुतेन विधिना दैवयोगेन भारत ।\nसलिलान्तर्गतः शेते दुर्दर्शः कस्यचिद् विभो\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2174419, "chapter_id": 4703, "verse_number": "६४", "content_sanskrit": "मानुषस्य मनुष्येन्द्रो गदाहस्तो नराधिप\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2174420, "chapter_id": 4703, "verse_number": "६५", "content_sanskrit": "(ततो दुर्योधनो राजा सलिलान्तर्गतोऽपि सन् ।\nशुश्रुवे तुमुलं शब्दं जलदोपमनिःस्वनम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2174421, "chapter_id": 4703, "verse_number": "६६", "content_sanskrit": "युधिष्ठिरोऽपि राजेन्द्र ह्रदं तैः सह सोदरैः ।\nआजगाम महाराज तव पुत्रवधाय वै\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2174422, "chapter_id": 4703, "verse_number": "६७", "content_sanskrit": "महता सिंहनादेन रथनेमिस्वनेन च ।\nधून्वंश्चापि महारेणुं कम्पयंश्चापि मेदिनीम्)\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2174423, "chapter_id": 4703, "verse_number": "६८", "content_sanskrit": "यौधिष्ठिरस्य सैन्यस्य श्रुत्वा शब्दं महारथाः ।\nकृतवर्मा कृपो द्रौणी राजानमिदब्रुवन्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2174424, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "कृपादयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2174425, "chapter_id": 4703, "verse_number": "६९", "content_sanskrit": "इमे ह्यायान्ति संहृष्टाः पाण्डवा जितकाशिनः ।\nअपयास्यामहे तावद् अनुजानातु नो भवान्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2174426, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2174427, "chapter_id": 4703, "verse_number": "७०", "content_sanskrit": "दुर्योधनस्तु तच्छ्रुत्वा तेषां चैव यशस्विनाम् ।\nतथेत्युक्त्वा ह्रदं तं वै माययाऽस्तम्भयत् प्रभो\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2174428, "chapter_id": 4703, "verse_number": "७१", "content_sanskrit": "ते त्वनुज्ञाप्य राजानं भृशं शोकपरायणाः ।\nजग्मुर्दूरं महाराज कृपप्रभृतयो रथाः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2174429, "chapter_id": 4703, "verse_number": "७२", "content_sanskrit": "ते गत्वा दूरमध्वानं न्यग्रोधं प्रेक्ष्य मारिष ।\nन्यविशन्त भृशं श्रान्ताः चिन्तयन्तो नृपं प्रति\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2174430, "chapter_id": 4703, "verse_number": "७३", "content_sanskrit": "विष्टभ्य सलिलं सुप्तो धार्तराष्ट्रो महाबलः ।\nपाण्डवाश्चापि सम्प्राप्ताः तं देशं युद्धमीप्सवः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2174431, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "कृपादयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2174432, "chapter_id": 4703, "verse_number": "७४", "content_sanskrit": "कथं न युद्धं भविता कथं नु स्यात् स पार्थिवः ।\nकथं नु पाण्डवाश्चात्र प्रतिपत्स्यन्ति कौरवम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2174433, "chapter_id": 4703, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2174434, "chapter_id": 4703, "verse_number": "७५", "content_sanskrit": "इत्येवं चिन्तयन्तस्ते रथेभ्योऽश्वान् विमुच्य च ।\nतत्रासाञ्चक्रिरे राजन् कृपप्रभृतयस्तदा\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2174435, "chapter_id": 4703, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि दुर्योधनस्य ह्रदप्रवेशो नाम प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]