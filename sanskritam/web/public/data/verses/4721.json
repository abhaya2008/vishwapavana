[{"id": 2175630, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2175631, "chapter_id": 4721, "verse_number": "१", "content_sanskrit": "अत्यद्भुतमिदं ब्रह्मन् श्रुतवानस्मि तत्त्वतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2175632, "chapter_id": 4721, "verse_number": "२", "content_sanskrit": "अभिषेकं कुमारस्य दैत्यानां च वधं तथा ।\nश्रुत्वा मे परमा प्रीतिर्भूयः कौतूहलं हि मे\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2175633, "chapter_id": 4721, "verse_number": "३", "content_sanskrit": "अपाम्पतिः कथं ह्यस्मिन्नभिषिक्तः कदा सुरैः ।\nतन्मे ब्रूहि महाप्राज्ञ कुशलो ह्यसि सत्तम\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2175634, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2175635, "chapter_id": 4721, "verse_number": "४", "content_sanskrit": "शृणु राजन्निदं चित्रं पूर्वकाले यथाऽभवत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2175636, "chapter_id": 4721, "verse_number": "५", "content_sanskrit": "आदौ कृतयुगे तस्मिन् वर्तमाने यथाविधि ।\nवरुणं देवताः सर्वाः समेत्येदमथाब्रुवन्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2175637, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2175638, "chapter_id": 4721, "verse_number": "६", "content_sanskrit": "यथाऽस्मान् सुरराट् शक्रो भयेभ्यस्त्राति सर्वदा ।\nतथा त्वमपि सर्वासां सरितां वै पतिर्भव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2175639, "chapter_id": 4721, "verse_number": "७", "content_sanskrit": "वासश्च ते सदा देव सागरे मकरालये ।\nसमुद्रोऽयं तव वशे भविष्यति नदीपतिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2175640, "chapter_id": 4721, "verse_number": "८", "content_sanskrit": "सोमेन सार्धं तव च हानिर्वृद्धिर्भविष्यति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2175641, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2175642, "chapter_id": 4721, "verse_number": "९", "content_sanskrit": "एवमस्त्विति तान् देवान् वरुणो वाक्यमब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2175643, "chapter_id": 4721, "verse_number": "१०", "content_sanskrit": "समागम्य तु ते सर्वे वरुणं सागरालयम् ।\nअपाम्पतिं प्रचक्रुर्हि विधिदृष्टेन कर्मणा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2175644, "chapter_id": 4721, "verse_number": "११", "content_sanskrit": "अभिषिच्य ततो देवा वरुणं पयसां पतिम् ।\nस्वान्येव जग्मुः स्थानानि पूजयित्वा जलेश्वरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2175645, "chapter_id": 4721, "verse_number": "१२", "content_sanskrit": "अभिषिक्तस्ततो देवैः वरुणोऽपि महायशाः ।\nसरितः सागरांश्चैव नदांश्चैव सरांसि च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2175646, "chapter_id": 4721, "verse_number": "१३", "content_sanskrit": "पालयामास विधिना यथा देवान् शतक्रतुः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2175647, "chapter_id": 4721, "verse_number": "१४", "content_sanskrit": "ततस्तत्राप्युपस्पृश्य दत्त्वा च विविधं वसु ।\nअग्नितीर्थं महाप्राज्ञो जगामाथ प्रलम्बहा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2175648, "chapter_id": 4721, "verse_number": "१५", "content_sanskrit": "नष्टो न दृश्यते यत्र शमीगर्भो हुताशनः ।\nलोकालोकविनाशे च प्रादुर्भूते तदा नृप\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2175649, "chapter_id": 4721, "verse_number": "१६", "content_sanskrit": "उपतस्थुर्महात्मानं सर्वलोकपितामहम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2175650, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2175651, "chapter_id": 4721, "verse_number": "१७", "content_sanskrit": "अग्निः प्रनष्टो भगवान् कारणं न च विद्महे ।\nसर्वलोकक्षयो मा भूत् सम्पादयतु नोऽनलम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2175652, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2175653, "chapter_id": 4721, "verse_number": "१८", "content_sanskrit": "किमर्थं भगवानग्निः प्रनष्टो लोकभावनः ।\nविज्ञातश्च कथं देवैस्तन्ममाचक्ष्व पृच्छतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2175654, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2175655, "chapter_id": 4721, "verse_number": "१९", "content_sanskrit": "भृगोः शापभयाद् भीतो जातवेदाः प्रतापवान् ।\nशमीगर्भमथासाद्य ननाश भगवांस्ततः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2175656, "chapter_id": 4721, "verse_number": "२०", "content_sanskrit": "प्रनष्टे तु तदा वह्नौ देवाः सर्वे सवासवाः ।\nअन्वेषयंस्तदा सर्वे ज्वलनं भृशदुःखिताः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2175657, "chapter_id": 4721, "verse_number": "२१", "content_sanskrit": "ततोऽग्नितीर्थमागम्य शमीगर्भस्थमेव हि ।\nददृशुर्ज्वलनं तत्र वसमानं यथाविधि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2175658, "chapter_id": 4721, "verse_number": "२२", "content_sanskrit": "देवाः सर्वे महाराज बृहस्पतिपुरोगमाः ।\nज्वलनं ते समासाद्य प्रीता भूवन् सवासवाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2175659, "chapter_id": 4721, "verse_number": "२३", "content_sanskrit": "पुनर्यथागतं जग्मुः सर्वभक्षश्च सोऽभवत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2175660, "chapter_id": 4721, "verse_number": "२४", "content_sanskrit": "भृगोः शापान्महीपाल यदुक्तं ब्रह्मवादिना ।\nतत्रैवाप्लुत्य मतिमान् ब्रह्मयोनिं जगाम ह\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2175661, "chapter_id": 4721, "verse_number": "२५", "content_sanskrit": "ससर्ज भगवान् यत्र सर्वलोकपितामहः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2175662, "chapter_id": 4721, "verse_number": "२६", "content_sanskrit": "तत्राप्लुत्य ततो ब्रह्मा सह देवैः पुरा प्रभुः ।\nससर्ज चान्नानि तथा देवतानां यथाविधि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2175663, "chapter_id": 4721, "verse_number": "२७", "content_sanskrit": "तत्र स्नात्वा च दत्त्वा च वसूनि विविधानि च ।\nकौबेरं प्रययौ तीर्थं यत्र तप्त्वा तपो महत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2175664, "chapter_id": 4721, "verse_number": "२८", "content_sanskrit": "धनाधिपत्यं सम्प्राप्तो राजन्नैलबिलः प्रभुः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2175665, "chapter_id": 4721, "verse_number": "२९", "content_sanskrit": "तत्रस्थमेव तं राजन् धनानां निधयस्तथा ।\nउपतस्थुर्नरश्रेष्ठ तत्तीर्थं लाङ्गली तदा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2175666, "chapter_id": 4721, "verse_number": "३०", "content_sanskrit": "गत्वा स्नात्वा च विधिवद् ब्राह्मणानां ददौ धनम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2175667, "chapter_id": 4721, "verse_number": "३१", "content_sanskrit": "ददृशे तत्र तत्स्थानं कौबेरे कानने प्रभुः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2175668, "chapter_id": 4721, "verse_number": "३२", "content_sanskrit": "पुरा यत्र तपस्तप्तं विपुलं सुमहात्मना ।\nयत्र राज्ञा कुबेरेण वरा लब्धाश्च पुष्कलाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2175669, "chapter_id": 4721, "verse_number": "३३", "content_sanskrit": "धनाधिपत्यं सख्यं च रुद्रेणामिततेजसा ।\nसुरत्वं लोकपालत्वं पुत्रं च नलकूबरम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2175670, "chapter_id": 4721, "verse_number": "३४", "content_sanskrit": "यत्र लेभे महाबाहो धनाधिपतिरञ्जसा ।\nअभिषिक्तश्च यत्रैव समागम्य मरुद्गणैः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2175671, "chapter_id": 4721, "verse_number": "३५", "content_sanskrit": "वाहनं चास्य तद्दत्तं हंसयुक्तं मनोजवम् ।\nविमानं पुष्पकं दिव्यं नैर्ऋतैश्वर्यमेव च\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2175672, "chapter_id": 4721, "verse_number": "३६", "content_sanskrit": "तत्राप्लुत्य महाराज दत्त्वा देयान् सुपुष्कलान् ।\nजगाम त्वरितो रामस्तीर्थं श्वेतानुलेपनः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2175673, "chapter_id": 4721, "verse_number": "३७", "content_sanskrit": "निषेवितं महासत्त्वैर्नाम्ना बदरपाचनम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2175674, "chapter_id": 4721, "verse_number": "३८", "content_sanskrit": "तपस्विसिद्धचरितं यत्र कन्या धृतव्रता\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2175675, "chapter_id": 4721, "verse_number": "३९", "content_sanskrit": "भरद्वाजस्य दुहिता रूपेणाप्रतिमा भुवि ।\nश्रुतावती नाम विभो कौमारब्रह्मचारिणी\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2175676, "chapter_id": 4721, "verse_number": "४०", "content_sanskrit": "तपश्चचार साऽत्युग्रं नियमैर्बहुभिः प्रभो ।\nभर्ता मे देवराजः स्यादिति निश्चित्य भामिनी\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2175677, "chapter_id": 4721, "verse_number": "४१", "content_sanskrit": "समास्तस्या व्यतिक्रान्ता बह्व्यः कुरुकुलोद्वह ।\nचरन्त्या नियमांस्तांस्तान् स्त्रीभिस्तीव्रान् सुदुश्चरान्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2175678, "chapter_id": 4721, "verse_number": "४२", "content_sanskrit": "तस्यास्तु तेन वृत्तेन तपसा च विशाम्पते ।\nभक्त्या परमया प्रीतो भगवान् पाकशासनः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2175679, "chapter_id": 4721, "verse_number": "४३", "content_sanskrit": "आजगामाश्रमं तस्याः त्रिदशाधिपतिस्तदा ।\nआस्थाय रूपं ब्रह्मर्षेर्वसिष्ठस्य महात्मनः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2175680, "chapter_id": 4721, "verse_number": "४४", "content_sanskrit": "सा तं दृष्ट्वोग्रतपसं वसिष्ठं जपतां वरम् ।\nआचारैर्बहुभिर्जुष्टं पूजयामास भारत\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2175681, "chapter_id": 4721, "verse_number": "४५", "content_sanskrit": "उवाच विनयज्ञा सा कल्याणी च प्रियंवदा\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2175682, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "श्रुतावती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2175683, "chapter_id": 4721, "verse_number": "४६", "content_sanskrit": "वदस्व मुनिशार्दूल किमाज्ञापयसि प्रभो ।\nसर्वमद्य यथाशक्ति तव दास्यामि सुव्रता\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2175684, "chapter_id": 4721, "verse_number": "४७", "content_sanskrit": "शक्रभक्त्या च ते पाणिं न दास्यामि कथञ्चन\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2175685, "chapter_id": 4721, "verse_number": "४८", "content_sanskrit": "व्रतैश्च नियमैश्चैव तपसा च तपोधन ।\nशक्रस्तोषयितव्यो वै मया त्रिभुवनेश्वरः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2175686, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2175687, "chapter_id": 4721, "verse_number": "४९", "content_sanskrit": "इत्युक्तो भगवान् देवः स्मयन्निव निरीक्ष्य ताम् ।\nउवाच नियमं ज्ञात्वा सान्त्वयन्निव भारत\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2175688, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2175689, "chapter_id": 4721, "verse_number": "५०", "content_sanskrit": "उग्रं तपश्चरसि हि विदिता मेऽसि सुव्रते ।\nयदर्थमयमारम्भस्तव कल्याणि हृद्गतः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2175690, "chapter_id": 4721, "verse_number": "५१", "content_sanskrit": "तत्सर्वं च तथाभूतं भविष्यति वरानने ।\nतपसा लभ्यते सर्वं सर्वं तपसि तिष्ठति\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2175691, "chapter_id": 4721, "verse_number": "५२", "content_sanskrit": "यानि स्थानानि सर्वाणि विबुधानां शुभानने ।\nतपसा तानि लभ्यन्ते तपोमूलं महत्सुखम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2175692, "chapter_id": 4721, "verse_number": "समाप्तिः", "content_sanskrit": "इति कृत्वा तपो घोरं देहं सन्त्यज्य मानवाः ।\nदेवत्वं यान्ति कल्याणि शृणु चेदं वचो मम\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2175693, "chapter_id": 4721, "verse_number": "५४", "content_sanskrit": "पचस्वैतानि सुभगे बदराणि शुभव्रते\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2175694, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2175695, "chapter_id": 4721, "verse_number": "५५", "content_sanskrit": "पचेत्युक्त्वा स भगवान् जगाम बलसूदनः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2175696, "chapter_id": 4721, "verse_number": "५६", "content_sanskrit": "आमन्त्र्य तां तु कल्याणीं ततो जप्यं जजाप सा ।\nअविदूरे ततस्तस्माद् आश्रमात् तीर्थ उत्तमे\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2175697, "chapter_id": 4721, "verse_number": "५७", "content_sanskrit": "तच्च तीर्थं महाराज यत्र जप्यं जजाप सा ।\nइन्द्रतीर्थं महाराज त्रिषु लोकेषु विश्रुतम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2175698, "chapter_id": 4721, "verse_number": "५८", "content_sanskrit": "तस्या जिज्ञासनार्थे तु भगवान् पाकशासनः ।\nबदराणामपचनं चकार विबुधाधिपः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2175699, "chapter_id": 4721, "verse_number": "५९", "content_sanskrit": "ततः सा प्रयता राजन् वाग्यता विगतक्लमा ।\nतत्परा शुचिसंवीता पावके समधिश्रयत्\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2175700, "chapter_id": 4721, "verse_number": "६०", "content_sanskrit": "अपचत् पुरुषव्याघ्र बदराणि शुभव्रता\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2175701, "chapter_id": 4721, "verse_number": "६१", "content_sanskrit": "तस्याः पचन्त्याः सुचिरं कालोऽगात् पुरुषर्षभ ।\nन च स्म तानि पच्यन्ते दिनं च क्षयमभ्ययात्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2175702, "chapter_id": 4721, "verse_number": "६२", "content_sanskrit": "हुताशनेन दग्धश्च यस्तस्याः काष्ठसञ्चयः ।\nअकाष्ठमग्निं सा दृष्ट्वा स्वशरीरमथापचत्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2175703, "chapter_id": 4721, "verse_number": "६३", "content_sanskrit": "पादौ प्रक्षिप्य सा पूर्वं पावके चारुदर्शना ।\nदग्धौ दग्धौ पुनः पादावुपावर्तयतानघ\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2175704, "chapter_id": 4721, "verse_number": "६४", "content_sanskrit": "चरणौ दह्यमानौ च नाचिन्तयदनिन्दिता ।\nदुःखं कमलपत्राक्षी महर्षेः प्रियकाम्यया\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2175705, "chapter_id": 4721, "verse_number": "६५", "content_sanskrit": "न वैमनस्यं तस्यास्तु मुखभेदोऽथवाऽभवत् ।\nशरीरमग्निना दीप्य जलमध्ये यथा स्थिता\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2175706, "chapter_id": 4721, "verse_number": "६६", "content_sanskrit": "तच्चास्या वचनं नित्यमावर्तद् हृदि भारत ।\nसर्वथा बदराण्येव पक्तव्यानीति कन्यका\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2175707, "chapter_id": 4721, "verse_number": "६७", "content_sanskrit": "सा तद् हृदि दृढं कृत्वा महर्षेर्वचनं शुभा ।\nअपचद् बदराण्येव न चापच्यन्त भारत\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2175708, "chapter_id": 4721, "verse_number": "६८", "content_sanskrit": "तस्याश्च चरणौ वह्निर्ददाह भगवान् भृशम् ।\nन च तस्या मनोदुःखं स्वल्पमप्यभवत् तदा\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2175709, "chapter_id": 4721, "verse_number": "६९", "content_sanskrit": "अथ तत् कर्म दृष्ट्वाऽस्याः प्रीतस्त्रिभुवनेश्वरः ।\nततः स दर्शयामास कन्यायै रूपमात्मनः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2175710, "chapter_id": 4721, "verse_number": "७०", "content_sanskrit": "उवाच च सुरश्रेष्ठः तां कन्यां सुदृढव्रताम्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2175711, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2175712, "chapter_id": 4721, "verse_number": "७१", "content_sanskrit": "प्रीतोऽस्मि ते शुभे भक्त्या तपसा विपुलेन च ।\nतस्माद् योऽभिमतः कामः स ते सम्पत्स्यते शुभे\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2175713, "chapter_id": 4721, "verse_number": "७२", "content_sanskrit": "देहं त्यक्त्वा महाभागे त्रिदिवे च निवत्स्यसि\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2175714, "chapter_id": 4721, "verse_number": "७३", "content_sanskrit": "इदं च ते तीर्थवरं ख्यातं लोके भविष्यति ।\nसर्वपापापहं सुभ्रु नाम्ना बदरपाचनम्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2175715, "chapter_id": 4721, "verse_number": "७४", "content_sanskrit": "विख्यातं त्रिषु लोकेषु ब्रह्मर्षिभिरभिप्लुतम्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2175716, "chapter_id": 4721, "verse_number": "७५", "content_sanskrit": "अस्मिन् खलु महाभागे शुभे तीर्थवरे पुरा ।\nन्यस्य सप्तर्षयो याता हिमवन्तमरुन्धतीम्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2175717, "chapter_id": 4721, "verse_number": "७६", "content_sanskrit": "ततस्ते सुमहाभागा गत्वा तत्र सुसंशिताः ।\nवृत्त्यर्थं फलमूलानि समाहर्तुं ययुः किल\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2175718, "chapter_id": 4721, "verse_number": "७७", "content_sanskrit": "तेषां वृत्त्यर्थिनां तत्र वसतां हिमवद् वने ।\nअनावृष्टिरनुप्राप्ता तदा द्वादशवार्षिकी\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2175719, "chapter_id": 4721, "verse_number": "७८", "content_sanskrit": "तेऽत्र कृत्वाऽऽश्रमं राजन् न्यवसन्त तपस्विनः ।\nअरुन्धत्यपि कल्याणी तपोनित्याऽभवत् तदा\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2175720, "chapter_id": 4721, "verse_number": "७९", "content_sanskrit": "अरुन्धतीं ततो दृष्ट्वा तीर्थे नियममास्थिताम् ।\nअथागमत् त्रिणयनः सम्प्रीतो वरदस्तदा\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2175721, "chapter_id": 4721, "verse_number": "८०", "content_sanskrit": "ब्रह्मरूपं तदा कृत्वा महादेवो महायशाः ।\nतामभ्येत्याब्रवीद् देवो भिक्षामिच्छाम्यहं शुभे\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2175722, "chapter_id": 4721, "verse_number": "८१", "content_sanskrit": "प्रत्युवाच ततः सा तु ब्राह्मणं चारुदर्शना\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2175723, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "अरुन्धती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2175724, "chapter_id": 4721, "verse_number": "८२", "content_sanskrit": "क्षीणोऽन्नसञ्चयो विप्र बदराणीह भक्षय\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2175725, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2175726, "chapter_id": 4721, "verse_number": "८३", "content_sanskrit": "ततोऽब्रवीन्महादेवः पचस्वैतानि भामिनि ।\nइत्युक्ता साऽपचत् तानि ब्राह्मणप्रियकाम्यया\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2175727, "chapter_id": 4721, "verse_number": "८४", "content_sanskrit": "अधिश्रित्य समिद्धेऽग्नौ बदराणि यशस्विनी\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2175728, "chapter_id": 4721, "verse_number": "८५", "content_sanskrit": "दिव्या मनोरमाः पुण्याः कथाः शुश्राव सा शुभा ।\nअतीता सा त्वनावृष्टिर्घोरा द्वादशवार्षिकी\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2175729, "chapter_id": 4721, "verse_number": "८६", "content_sanskrit": "अनश्नन्त्याः पचन्त्याश्च शृण्वन्त्याश्च कथाः शुभाः ।\nअह्ना समः स तस्यास्तु कालोऽतीतः सुदारुणः\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2175730, "chapter_id": 4721, "verse_number": "८७", "content_sanskrit": "ततस्ते मुनयः प्राप्ताः फलान्यादाय पर्वतात् ।\nततः स भगवान् प्रीतः प्रोवाचारुन्धतीं तदा\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2175731, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "महादेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2175732, "chapter_id": 4721, "verse_number": "८८", "content_sanskrit": "उपसर्पस्व भद्रं ते यथापूर्वं हि तानृषीन् ।\nप्रीतोऽस्मि ते महाभागे तपसा नियमेन च\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2175733, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2175734, "chapter_id": 4721, "verse_number": "८९", "content_sanskrit": "ततस्तां दर्शयामास स्वरूपं भगवान् हरः ।\nततोऽब्रवीत् तदा तेभ्यः तस्यास्तच्चरितं महत्\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2175735, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "महादेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2175736, "chapter_id": 4721, "verse_number": "९०", "content_sanskrit": "भवद्भिर्हिमवत्पृष्ठे यत्तपः समुपार्जितम् ।\nअस्याश्च यत्तपो विप्राः सममेतन्मतं मम\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2175737, "chapter_id": 4721, "verse_number": "९१", "content_sanskrit": "अनया हि तपस्विन्या तपस्तप्तं सुदुश्चरम् ।\nअनश्नन्त्या पचन्त्या च समा द्वादश वारिताः\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2175738, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2175739, "chapter_id": 4721, "verse_number": "९२", "content_sanskrit": "ततः प्रोवाच भगवान् तामेवारुन्धतीं पुनः\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2175740, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "महादेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2175741, "chapter_id": 4721, "verse_number": "९३", "content_sanskrit": "वरं वृणीष्व कल्याणि यस्तेऽभिलषितो हृदि\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2175742, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2175743, "chapter_id": 4721, "verse_number": "९४", "content_sanskrit": "साऽब्रवीत् पृथुताम्राक्षी देवं सप्तर्षिसंसदि\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2175744, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "अरुन्धती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2175745, "chapter_id": 4721, "verse_number": "९५", "content_sanskrit": "भगवन् यदि तुष्टो मे तीर्थं स्यादिदमुत्तमम् ।\nसिद्धदेवर्षिचरितं नाम्ना बदरपाचनम्\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2175746, "chapter_id": 4721, "verse_number": "९६", "content_sanskrit": "तथाऽस्मिन् देवदेवेश त्रिरात्रमुषितो शुचिः ।\nप्राप्नुयादुपवासेन फलं द्वादशवार्षिकम्\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2175747, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2175748, "chapter_id": 4721, "verse_number": "९७", "content_sanskrit": "एवमस्त्विति तां देवः प्रत्युवाच तपस्विनीम् ।\nसप्तर्षिभिः स्तुतो देवः तदा यातस्त्रिविष्टपम्\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2175749, "chapter_id": 4721, "verse_number": "९८", "content_sanskrit": "ऋषयो विस्मयं जग्मुस्तां दृष्ट्वा चाप्यरुन्धतीम् ।\nअश्रान्तामविवर्णां च क्षुत्पिपासासहां सतीम्\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2175750, "chapter_id": 4721, "verse_number": "९९", "content_sanskrit": "एवं सिद्धिः परा प्राप्ता अरुन्धत्या विशिष्टया\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2175751, "chapter_id": 4721, "verse_number": "१००", "content_sanskrit": "त्वया तथा महाभागे मदर्थं संशितव्रते ।\nविशेषो हि त्वया भद्रे व्रते ह्यस्मिन् समर्पितः\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2175752, "chapter_id": 4721, "verse_number": "१०१", "content_sanskrit": "यथा तथा ददाम्यद्य नियमेन सुतोषितः\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2175753, "chapter_id": 4721, "verse_number": "१०२", "content_sanskrit": "विशिष्टं तव कल्याणि प्रयच्छामि परं वरम् ।\nअरुन्धत्या वरस्तस्या यो दत्तो वै महात्मना\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2175754, "chapter_id": 4721, "verse_number": "१०३", "content_sanskrit": "तस्या वरप्रदानेन तव कल्याणि तेजसा ।\nप्रवक्ष्याम्यपरं भूयो वरमत्र यथाविधि\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2175755, "chapter_id": 4721, "verse_number": "१०४", "content_sanskrit": "यस्त्वेकां रजनीं तीर्थे वत्स्यते सुसमाहितः ।\nस स्नात्वा प्राप्नुयाँल्लोकान् देहन्यासाच्च दुर्लभान्\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2175756, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2175757, "chapter_id": 4721, "verse_number": "१०५", "content_sanskrit": "इत्युक्त्वा भगवान् देवः सहस्राक्षः प्रतापवान् ।\nश्रुतावतीं ततो गृह्य जगाम त्रिदिवं पुनः\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2175758, "chapter_id": 4721, "verse_number": "१०६", "content_sanskrit": "गते वज्रधरे राजन् ततो वर्षं पपात ह ।\nपुष्पाणां भरतश्रेष्ठ दिव्यानां दिव्यगन्धिनाम्\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2175759, "chapter_id": 4721, "verse_number": "१०७", "content_sanskrit": "नेदुर्दुन्दुभयश्चापि समन्तात् सुमहास्वनाः ।\nमरुतश्च ववुर्युक्ताः पुण्यगन्धा विशाम्पते\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2175760, "chapter_id": 4721, "verse_number": "१०८", "content_sanskrit": "उत्सृज्य तु कृशं देहं जगामेन्द्रस्य भार्यताम् ।\nतपसोग्रेण सा लब्ध्वा रेमे तेन सहाच्युत\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2175761, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2175762, "chapter_id": 4721, "verse_number": "१०९", "content_sanskrit": "का नु तस्याभवन्माता क्व संवृद्धा च शोभना ।\nश्रोतुमिच्छाम्यहं ब्रह्मन् कौतूहलमतीव मे\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2175763, "chapter_id": 4721, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2175764, "chapter_id": 4721, "verse_number": "११०", "content_sanskrit": "भरद्वाजस्य विप्रर्षेः स्कन्नं रेतो महात्मनः ।\nदृष्ट्वाऽप्सरसमायान्तीं घृताचीं पृथुलोचनाम्\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2175765, "chapter_id": 4721, "verse_number": "१११", "content_sanskrit": "स तु जग्राह तद्रेतः करेण जपतां वरः ।\nतदाऽपतत् पर्णपुटे तत्र सा सम्भवच्छुभा\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2175766, "chapter_id": 4721, "verse_number": "११२", "content_sanskrit": "तस्याः स जातकर्मादि कृत्वा सर्वं तपोधनः ।\nनाम तस्यास्तु कृतवान् भारद्वाजो महामुनिः\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2175767, "chapter_id": 4721, "verse_number": "११३", "content_sanskrit": "श्रुतावतीति धर्मात्मा देवर्षिगणसंसदि ।\nस च तामाश्रमे न्यस्य जगाम हिमवद् वनम्\t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2175768, "chapter_id": 4721, "verse_number": "११४", "content_sanskrit": "तत्राप्युपस्पृश्य महानुभावो\nवसूनि दत्त्वा च महाद्विजेभ्यः ।\nजगाम तीर्थं सुसमाहितात्मा\nशक्रस्य तत् तीर्थवरं तदानीम्\t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2175769, "chapter_id": 4721, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि श्रुतावतीमाहात्म्यं नाम एकोनविंशोऽध्यायः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}]