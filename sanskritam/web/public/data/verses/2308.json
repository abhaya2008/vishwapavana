[{"id": 2061179, "chapter_id": 2308, "verse_number": "८-२९-०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2061180, "chapter_id": 2308, "verse_number": "८-२९-१", "content_sanskrit": "एवं स भगवान्देवः सर्वलोकपितामहः।\nसारथ्यमकरोत्तत्र ब्रह्मा रुद्रोऽभवद्रथी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2061181, "chapter_id": 2308, "verse_number": "८-२९-२", "content_sanskrit": "रथिनोऽभ्यधिको वीर कर्तव्यो रथसारथिः।\nतस्मात्त्वं पुरुषव्याघ्र नियच्छ तुरगान्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2061182, "chapter_id": 2308, "verse_number": "८-२९-३", "content_sanskrit": "यथा देवगणैस्तत्र वृतो यत्नात्पितामहः।\nतथाऽस्माभिर्भवान्यत्नात्कर्णादभ्यधिको वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2061183, "chapter_id": 2308, "verse_number": "८-२९-४", "content_sanskrit": "यथा देवैर्महाराज ईश्वरादधिको वृतः।\nतथा देवैर्महाराज क्षिप्रं रुद्रस्यव पितामहः।\nनियच्छ तुरगान्युद्वे राधेयस्य महाद्युते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2061184, "chapter_id": 2308, "verse_number": "८-२९-५x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2061185, "chapter_id": 2308, "verse_number": "८-२९-५", "content_sanskrit": "मयाप्येतन्नरश्रेष्ठ बहुशो नरसिंहयोः।\nकथ्यमानं श्रुतं दिव्यमाख्यानमतिमानुषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2061186, "chapter_id": 2308, "verse_number": "८-२९-६", "content_sanskrit": "यथा च चक्रे सारथ्यं भवस्य प्रपितामहः।\nयथाऽसुराश्च निहता इषुणैकेन भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2061187, "chapter_id": 2308, "verse_number": "८-२९-७", "content_sanskrit": "कृष्णस्य चापि विदितं सर्वमेतत्पुरा ह्यभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2061188, "chapter_id": 2308, "verse_number": "८-२९-८", "content_sanskrit": "यथा पितामहो जज्ञे भगवान्सारथिस्तदा।\nअनागतमतिक्रान्तं वेद कृष्णोऽपि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2061189, "chapter_id": 2308, "verse_number": "८-२९-९", "content_sanskrit": "एतदर्थं विदित्वाऽपि सारथ्यमुपजग्मिवान्।\nस्वयम्भूरिव रुद्रस्य कृष्णः पार्थस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2061190, "chapter_id": 2308, "verse_number": "८-२९-१०", "content_sanskrit": "यदि हन्याच्च कौन्तेयं सूतपुत्रः कथञ्चनः।\nदृष्ट्वा पार्थं हि निहतं स्वयं योत्स्यति केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2061191, "chapter_id": 2308, "verse_number": "८-२९-११", "content_sanskrit": "शङ्खचक्रगदापाणिर्धक्ष्यते तव वाहिनीम्।\nन चापि तस्य क्रुद्धस्य वार्ष्णेयस्य महात्मनः।\nस्थास्यते प्रत्यनीकेषु कश्चिदत्र नृपस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2061192, "chapter_id": 2308, "verse_number": "८-२९-१२", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2061193, "chapter_id": 2308, "verse_number": "८-२९-१२", "content_sanskrit": "तं तथा भाषमाणं तु मद्रराजमरिन्दमः।\nप्रत्युवाच महाबाहुरदीनात्मा सुतस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2061194, "chapter_id": 2308, "verse_number": "८-२९-१३", "content_sanskrit": "मावमंस्था महाबाहो कर्णं वैकर्तनं रणे।\nसर्वशस्त्रभृतां श्रेष्ठं सर्वशास्त्रार्थपरागम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2061195, "chapter_id": 2308, "verse_number": "८-२९-१४", "content_sanskrit": "यस्य ज्यातलनिर्घोषं श्रुत्वा भयकरं महत्।\nपाण्डवेयानि सैन्यानि विद्रवन्ति दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2061196, "chapter_id": 2308, "verse_number": "८-२९-१५", "content_sanskrit": "प्रत्यक्ष ते महाबाहो यथा रात्रौ घटोत्कचः।\nमायाशतानि कुर्वाणो हतो मायापुरस्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2061197, "chapter_id": 2308, "verse_number": "८-२९-१६", "content_sanskrit": "न चातिष्ठत बीभत्सुः प्रत्यनीके कथञ्चन।\nएतांश्च दिवसान्सर्वान्भयेन महता वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2061198, "chapter_id": 2308, "verse_number": "८-२९-१७", "content_sanskrit": "भीमसेनश्च बलवान्धनुष्कोट्याभिचोदितः।\nउक्तश्च संज्ञया राजन्मूढ औदरिको यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2061199, "chapter_id": 2308, "verse_number": "८-२९-१८", "content_sanskrit": "माद्रीपुत्रौ तथा शूरौ येन जित्वा महारणे।\nकमप्यर्थं पुरस्कृत्य न हतौ युधि मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2061200, "chapter_id": 2308, "verse_number": "८-२९-१९", "content_sanskrit": "येन वृष्णिप्रवीरस्तु सात्यकिः सात्वतां वरः।\nनिर्जित्य समरे शूरो विस्थश्च बलात्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2061201, "chapter_id": 2308, "verse_number": "८-२९-२०", "content_sanskrit": "सृञ्जयाश्चेतरे सर्वे धृष्टद्युम्नपुरोगमाः।\nअसकृन्निर्जिताः सङ्ख्ये स्मयमानेन संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2061202, "chapter_id": 2308, "verse_number": "८-२९-२१", "content_sanskrit": "तं कथं पाण्डवा युद्वे विजेष्यन्ति महारथम्।\nयो हन्यात्समरे क्रुद्वो वज्रहस्तं पुरन्दरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2061203, "chapter_id": 2308, "verse_number": "८-२९-२२", "content_sanskrit": "त्वं च सर्वास्त्रविद्वीरः सर्वविद्यास्त्रपारगः।\nबाहुवीर्येण ते तुल्यः पृथिव्यां नास्ति कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2061204, "chapter_id": 2308, "verse_number": "८-२९-२३", "content_sanskrit": "त्वं शल्यभूतः शत्रूणामविषह्यः पराक्रमे।\nततस्त्वमुच्यसे राजञ्शल्य इत्यरिसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2061205, "chapter_id": 2308, "verse_number": "८-२९-२४", "content_sanskrit": "तव बाहुबलं प्राप्य न शेकुः सर्वसात्वताः।\nतव बाहुबलाद्राजन्किं नु कृष्णो बलाधिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2061206, "chapter_id": 2308, "verse_number": "८-२९-२५", "content_sanskrit": "यथा हि कृष्णेन बलं धार्यं वै फल्गुने हते।\nतथा कर्णात्ययीभावे त्वया धार्यं महद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2061207, "chapter_id": 2308, "verse_number": "८-२९-२६", "content_sanskrit": "किमर्थं समरे सैन्यं वासुदेवो न्यवारयत्।\nकिमर्थं च भवान्सैन्यं न हनिष्यति मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2061208, "chapter_id": 2308, "verse_number": "८-२९-२७", "content_sanskrit": "त्वत्कृते पदवीं गन्तुमिच्छेयं युधि मारिष।\nसोदराणां च वीराणां सर्वेषां च महीक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2061209, "chapter_id": 2308, "verse_number": "८-२९-२८x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2061210, "chapter_id": 2308, "verse_number": "८-२९-२८", "content_sanskrit": "यन्मां ब्रवीषि गान्धारे अग्रे सैन्यस्य मानद।\nविशिष्टं देवकीपुत्रात्प्रीतिमानस्म्यहं त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2061211, "chapter_id": 2308, "verse_number": "८-२९-२९", "content_sanskrit": "एष सारथ्यमातिष्ठे राधेयस्य यशस्विनः।\nयुध्यतः पाण्डवाग्र्येण यथा त्वं वीर मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2061212, "chapter_id": 2308, "verse_number": "८-२९-३०", "content_sanskrit": "समयश्च हि मे वीर कश्चिद्वैकर्तनं प्रति।\nउत्सृजेयं यथाश्रद्वमहं वाचोऽस्य सन्निधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2061213, "chapter_id": 2308, "verse_number": "८-२९-३१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2061214, "chapter_id": 2308, "verse_number": "८-२९-३१", "content_sanskrit": "तथेति राजन्पुत्रस्ते सह कर्णेन मारिष।\nअब्रवीत्मद्रराजानं सर्वक्षत्रस्य सन्निधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2061215, "chapter_id": 2308, "verse_number": "८-२९-३२", "content_sanskrit": "सारथ्यस्याभ्युपगमाच्छल्येनाश्वासितस्तदा।\nदुर्योधनस्तदा हृष्टः कर्णं तमभिषस्वजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2061216, "chapter_id": 2308, "verse_number": "८-२९-३३", "content_sanskrit": "अब्रवीच्च पुनः कर्णं स्तूयमानः सुतस्तव।\nजहि पार्थान्रणे सर्वान्महेन्द्रो दानवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2061217, "chapter_id": 2308, "verse_number": "८-२९-३४", "content_sanskrit": "स शल्येनाभ्युपगते हयानां सन्नियच्छने।\nकर्णो हृष्टमना भूयो दुर्योधनभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2061218, "chapter_id": 2308, "verse_number": "८-२९-३५", "content_sanskrit": "नातिहृष्टमना ह्येष मद्रराजोऽभिभाषते।\nराजन्मधुरया वाचा पुनरेनं ब्रवीहि वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2061219, "chapter_id": 2308, "verse_number": "८-२९-३६", "content_sanskrit": "ततो राजा महाप्राज्ञः सर्वास्त्रकुशलो बली।\nदुर्योधनोऽब्रवीच्छल्यं मद्रराजं महीपतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2061220, "chapter_id": 2308, "verse_number": "८-२९-३७", "content_sanskrit": "पूरयन्निव घोषेण मेघगम्भीरया गिरा।\nशल्य कर्णोऽर्जुनेनाद्य योद्वव्यमिति मन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2061221, "chapter_id": 2308, "verse_number": "८-२९-३८", "content_sanskrit": "तस्य त्वं पुरुषव्याघ्र नियच्छ तुरगान्युधि।\nकर्णो हत्वेतरान्सर्वान्फल्गुनं हन्तुमिच्छति।\nतस्याभीषुग्रहे राजन्प्रयाचे त्वां पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2061222, "chapter_id": 2308, "verse_number": "८-२९-३९", "content_sanskrit": "पार्थस्य सचिवः कृष्णो यथाऽभीषुग्रहो वरः।\nतथा त्वमपि राधेयं सर्वतः परिपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2061223, "chapter_id": 2308, "verse_number": "८-२९-४०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2061224, "chapter_id": 2308, "verse_number": "८-२९-४०", "content_sanskrit": "ततः शल्यः परिष्वज्य सुतं ते वाक्यमब्रवीत्।\nदुर्योधनममित्रघ्नं प्रीतो मद्राधिपस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2061225, "chapter_id": 2308, "verse_number": "८-२९-४१x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2061226, "chapter_id": 2308, "verse_number": "८-२९-४१", "content_sanskrit": "एवं चेन्मन्यसे राजन्गान्धारे प्रियदर्शन।\nतस्मात्ते यत्प्रियं किञ्चित्तत्सर्वं करवाण्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2061227, "chapter_id": 2308, "verse_number": "८-२९-४२", "content_sanskrit": "यत्रास्मि भरतश्रेष्ठ योग्यः कर्मणि कर्हिचित्।\nतत्र सर्वात्मना युक्तो वक्ष्ये कार्यं परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2061228, "chapter_id": 2308, "verse_number": "८-२९-४३", "content_sanskrit": "यत्तु कर्णमहं ब्रूयां हितकामः प्रियाप्रिये।\nमम तत्क्षमतां सर्वं भवान्कर्णश्च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2061229, "chapter_id": 2308, "verse_number": "८-२९-४४x", "content_sanskrit": "कर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2061230, "chapter_id": 2308, "verse_number": "८-२९-४४", "content_sanskrit": "ईशानस्य यथा ब्रह्मा यथा पार्थस्य केशवः।\nतथा नित्यं हिते युक्तो मद्रराज भवस्व नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2061231, "chapter_id": 2308, "verse_number": "८-२९-४५x", "content_sanskrit": "शल्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2061232, "chapter_id": 2308, "verse_number": "८-२९-४५", "content_sanskrit": "आत्मनिन्दात्मपूजा च परनिन्दा परस्तवः।\nअनाचरितमार्याणां वृत्तमेतच्चतुर्विधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2061233, "chapter_id": 2308, "verse_number": "८-२९-४६", "content_sanskrit": "यत्तु विद्वन्प्रवक्ष्यामि प्रxxxxयार्थमहं तव।\nआत्मनः स्तवसंयुक्तं तन्निबोध यथातथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2061234, "chapter_id": 2308, "verse_number": "८-२९-४७", "content_sanskrit": "अहं शक्रस्य सारथ्ये योग्यो मातलिवत्प्रभो।\nअप्रमादात्प्रयोगाच्च ज्ञानविद्याचिकित्सनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2061235, "chapter_id": 2308, "verse_number": "८-२९-४८", "content_sanskrit": "ततः पार्थेन सङ्ग्रामे युध्यमानस्य तेऽनघ।\nवाहयिष्यामि तुरगान्विज्वरो भव सूतज॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2061236, "chapter_id": 2308, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि एकोनत्रिंशोऽध्यायः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]