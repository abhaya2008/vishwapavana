[{"id": 2141182, "chapter_id": 4047, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141183, "chapter_id": 4047, "verse_number": "१", "content_sanskrit": "ततस्त्रीणि सहस्राणि रथानां च धनुष्मताम् ।\nघोराणि कुरुवीराणां पर्यकीर्यन्त भारत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141184, "chapter_id": 4047, "verse_number": "२", "content_sanskrit": "कर्णो रथसहस्रेण प्रत्यतिष्ठद् धनञ्जयम् ।\nभीष्मः शान्तनवो धीमान् सहस्रेण पुरस्कृतः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141185, "chapter_id": 4047, "verse_number": "३", "content_sanskrit": "तथा रथसहस्रेण भ्रातृभिः परिवारितः ।\nपश्चाद् दुर्योधनोऽतिष्ठद् हस्तावाप्तश्रिया ज्वलन्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141186, "chapter_id": 4047, "verse_number": "४", "content_sanskrit": "अतिष्ठन्नवकाशे तु पादाताः सह वाजिभिः ।\nभीमरूपाश्च मातङ्गाः तोमराङ्कुशचोदिताः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141187, "chapter_id": 4047, "verse_number": "५", "content_sanskrit": "तानि दृष्ट्वा ह्यनीकानि विततानि महात्मनाम् ।\nवैराटिमुत्तरं तं तु प्रत्यभाषत पाण्डवः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141188, "chapter_id": 4047, "verse_number": "६", "content_sanskrit": "जाम्बूनदमयी वेदिर्ध्वजाग्रे यस्य दृश्यते ।\nशोणाश्चाश्वा रथे युक्ता द्रोण एष प्रकाशते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141189, "chapter_id": 4047, "verse_number": "७", "content_sanskrit": "आचार्यो निपुणो धीमान् ब्रह्मविच्छूरसम्मतः ।\nलाघवे चाप्रतिद्वन्द्वो दूरपाती महारथः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141190, "chapter_id": 4047, "verse_number": "८", "content_sanskrit": "सुप्रसन्नो महावीरः कुरष्वैनं प्रदक्षिणम् ।\nअत्रैव चाविरोधेन एष धर्मः सनातनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141191, "chapter_id": 4047, "verse_number": "९", "content_sanskrit": "यदि मे प्रहरेद् द्रोणः शरीरे प्रहरिष्यतः ।\nततोऽस्मिन् प्रहरिष्यामि नान्यथा युद्धमस्ति मे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141192, "chapter_id": 4047, "verse_number": "१०", "content_sanskrit": "भारताचार्यमुख्येन ब्राह्मणेन महात्मना ।\nतेन मे युध्यमानस्य मन्दं वाहय सारथे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141193, "chapter_id": 4047, "verse_number": "११", "content_sanskrit": "ध्वजाग्रे सिंहलाङ्गूलो दिक्षु सर्वासु शोभते ।\nभारताचार्यपुत्रस्तु सोऽश्वत्थामा विराजते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141194, "chapter_id": 4047, "verse_number": "१२", "content_sanskrit": "ध्वजाग्रे यस्य दृश्यन्ते बालसूर्यसमप्रभाः ।\nदुर्जयः सर्वसैन्यानां देवैरपि सवासवैः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141195, "chapter_id": 4047, "verse_number": "१३", "content_sanskrit": "तेन मे युध्यमानस्य मन्दं वाहय सारथे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141196, "chapter_id": 4047, "verse_number": "१४", "content_sanskrit": "ध्वजाग्रे गोवृषो यस्य काञ्चनोऽभिविराजते ।\nआचार्यवरमुख्यस्तु कृप एष महारथः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141197, "chapter_id": 4047, "verse_number": "१५", "content_sanskrit": "द्रोणेन च समो वीर्ये पितुर्मे परमः सखा ।\nतेन मे युध्यमानस्य मन्दं वाहय सारथे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141198, "chapter_id": 4047, "verse_number": "१६", "content_sanskrit": "यस्य काञ्चनकम्बूभिः हस्तिकक्ष्यापरिष्कृतः ।\nध्वजः प्रकाशते दूराद् रथे विद्युद्गणोपमः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141199, "chapter_id": 4047, "verse_number": "१७", "content_sanskrit": "एष वैकर्तनः कर्णः प्रतिमानं धनुष्मताम् ।\nएष वै स्पर्धते नित्यं मया सह सुदुर्जयः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141200, "chapter_id": 4047, "verse_number": "१८", "content_sanskrit": "जामदग्न्यस्य रामस्य शिष्यो ह्येष महारथः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141201, "chapter_id": 4047, "verse_number": "१९", "content_sanskrit": "सर्वास्त्रकुशलः कर्णः सर्वशस्त्रभृतां वरः ।\nयुद्धेऽप्रतिमवीर्यश्च दृढधन्वी पराक्रमी\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141202, "chapter_id": 4047, "verse_number": "२०", "content_sanskrit": "अद्याहं युद्धमेतेन करिष्ये सूतबन्धुना ।\nयुद्धमेतत्तु द्रष्टासि बलिवासवयोरिव\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141203, "chapter_id": 4047, "verse_number": "२१", "content_sanskrit": "महारथेन शूरेण सूतपुत्रेण धन्विना ।\nतेन मे युध्यमानस्य शीघ्रं वाहय सारथे\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141204, "chapter_id": 4047, "verse_number": "२२", "content_sanskrit": "यस्य चैव रथोपस्थे नागो मणिमयो ध्वजे ।\nएष दुर्योधनस्तत्र कौरवो यशसा वृतः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141205, "chapter_id": 4047, "verse_number": "२३", "content_sanskrit": "लब्धलक्षो दृढं वेधी लघुहस्तः प्रतापवान् ।\nतेन मे युध्यमानस्य शीघ्रं वाहय सारथे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141206, "chapter_id": 4047, "verse_number": "२४", "content_sanskrit": "यस्तु श्वेतावदातेन पञ्चताळेन केतुना ।\nवैडूर्यदण्डेन तथा ताळवृक्षेण राजते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2141207, "chapter_id": 4047, "verse_number": "२५", "content_sanskrit": "हस्तवांश्च बृहद्धन्वा सेनां तिष्ठति हर्षयन् ।\nरामेण जामदग्न्येन द्वैरथे न जितः पुरा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2141208, "chapter_id": 4047, "verse_number": "२६", "content_sanskrit": "शीघ्रश्च लघुवेधी च लघुहस्तः प्रतापवान् ।\nएष शान्तनवो भीष्मः सर्वेषां नः पितामहः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2141209, "chapter_id": 4047, "verse_number": "२७", "content_sanskrit": "ककुदः सर्वसैन्यानां सर्वशस्त्रभृतां वरः ।\nराजश्रियाऽपविद्धस्तु सुयोधनवशानुगः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2141210, "chapter_id": 4047, "verse_number": "२८", "content_sanskrit": "पश्चादेष प्रयातव्यो न मे विघ्नकरो भवेत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2141211, "chapter_id": 4047, "verse_number": "२९", "content_sanskrit": "इत्येतान् त्वरितः पार्थः कथयित्वा तदोत्तरम् ।\nरूपतश्चिह्नतश्चैव युद्धाय त्वरते पुनः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2141212, "chapter_id": 4047, "verse_number": "३०", "content_sanskrit": "विमृश्य गाण्डिवं तत्र युद्धायैव व्यवस्थितः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2141213, "chapter_id": 4047, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि पञ्चपञ्चाशोऽध्यायः ॥५५॥ गोग्रहणपर्वणि अष्टाविंशोऽध्यायः ॥२८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]