[{"id": 7000048000, "chapter_id": 20048, "verse_number": "४८-१", "content_sanskrit": "इन्द्रद्युम्नस्य प्रतिमानिर्माणम् मुनय ऊचुः ब्रूहि नो देवेदेवेश यत्पृच्छाम पुरातनम् ।\nयथा ताः प्रतिमाः पूर्वमन्द्रद्युम्नेन निर्मिताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000048001, "chapter_id": 20048, "verse_number": "४८-२", "content_sanskrit": "केन चैव प्रकारेम तुष्टस्तस्मै स माधवः ।\nतत्सर्वं वद चास्माकं परं कौतूहलं हि नः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000048002, "chapter_id": 20048, "verse_number": "४८-३", "content_sanskrit": "ब्रह्मोवाच श्रृणुध्वं मुनिसार्दूलाः पुराणं वेदसंमितम् ।\nकथयामि पुरा वृत्तं प्रतिमानां च संभवम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000048003, "chapter_id": 20048, "verse_number": "४८-४", "content_sanskrit": "प्रवृत्ते च महायज्ञे प्रासादे चैव निर्मिते ।\nचिन्ता तस्य बभूवाथ प्रतिमार्थमहर्निशम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000048004, "chapter_id": 20048, "verse_number": "४८-५", "content_sanskrit": "न वेद्मि केन देवेशं सर्वेसं लोकपावनम् ।\nसर्गस्थित्यन्तकर्तारं पश्यामि पुरुषोत्तमम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000048005, "chapter_id": 20048, "verse_number": "४८-६", "content_sanskrit": "चिन्ताविष्टस्त्वभूद्राजा शेते रात्रौ दिवाऽपि न ।\nन भुङ्क्ते विविधान्बोगान्न च स्नानं प्रसाधनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000048006, "chapter_id": 20048, "verse_number": "४८-७", "content_sanskrit": "नैव वाद्येन गन्धेन गायनैर्वर्णकैरपि ।\nन गजैर्मदयुक्तैश्च न चानेकैर्हयान्वितैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000048007, "chapter_id": 20048, "verse_number": "४८-८", "content_sanskrit": "नेन्गद्रनीलैर्महानीलैः पद्मरागमयैर्न च ।\nसुवर्णरजताद्यैस्च वज्रस्फटिकसंयुतैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000048008, "chapter_id": 20048, "verse_number": "४८-९", "content_sanskrit": "बहुरागार्थकामैर्वा न वन्यैरन्तरिक्षगैः ।\nबभूव तस्य नृपतेर्मनसस्तुष्टिवर्धतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000048009, "chapter_id": 20048, "verse_number": "४८-१०", "content_sanskrit": "शैलमृद्‌दारुजातेषु प्रशस्तं किं महीतले ।\nविष्णुप्रतिमायोग्यं च सर्वलक्षमलक्षितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000048010, "chapter_id": 20048, "verse_number": "४८-११", "content_sanskrit": "एतैरैव त्रयाणां तु दयितं स्यात्सुरार्चितम् ।\nस्थापिते प्रीतिमभ्येति इति चिन्तापरोऽभवत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000048011, "chapter_id": 20048, "verse_number": "४८-१२", "content_sanskrit": "पञ्चरात्रविधानेन संपूज्य पुरुषोत्तमम् ।\nचिन्ताविष्टो महीपालः संस्तोतुमुचक्रमे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]