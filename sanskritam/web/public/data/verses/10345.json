[{"id": 6000345000, "chapter_id": 10345, "verse_number": null, "content_sanskrit": "अष्टादशपुराणानां ग्रन्थसङ्‌ख्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000345001, "chapter_id": 10345, "verse_number": null, "content_sanskrit": "सूत उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.001.m4a", "display_order": 2}, {"id": 6000345002, "chapter_id": 10345, "verse_number": "१२-१३-१", "content_sanskrit": "यं ब्रह्मा वरुणेन्द्ररुद्रमरुतः स्तुन्वन्ति दिव्यैः स्तवै-\nर्वेदैः साङ्गपदक्रमोपनिषदैर्गायन्ति यं सामगाः।\nध्यानावस्थिततद्गतेन मनसा पश्यन्ति यं योगिनो\nयस्यान्तं न विदुः सुरासुरगणा देवाय तस्मै नमः॥ १२/१३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.002.m4a", "display_order": 3, "topics": [{"text": "अष्टादशपुराणानां ग्रन्थसङ्‌ख्या", "range": "१–९"}]}, {"id": 6000345003, "chapter_id": 10345, "verse_number": "१२-१३-२", "content_sanskrit": "पृष्ठभ्राम्यदमन्दमन्दरगिरिग्रावाग्रकण्डूयना-\nन्निद्रालोः कमठाकृतेर्भगवतः श्वासानिलाः पान्तु वः।\nयत्संस्कारकलानुवर्तनवशाद्वेलानिलेनाम्भसां\nयातायातमतन्द्रितं जलनिधेर्नाद्यापि विश्राम्यति॥ १२/१३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.003.m4a", "display_order": 4}, {"id": 6000345004, "chapter_id": 10345, "verse_number": "१२-१३-३", "content_sanskrit": "पुराणसङ्ख्यासम्भूतिमस्य वाच्यप्रयोजने।\nदानं दानस्य माहात्म्यं पाठादेश्च निबोधत॥ १२/१३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.004.m4a", "display_order": 5}, {"id": 6000345005, "chapter_id": 10345, "verse_number": "१२-१३-४", "content_sanskrit": "ब्राह्मं दशसहस्राणि पाद्मं पञ्चोनषष्टिकम्।\nश्रीवैष्णवं त्रयोविंशच्चतुर्विंशति शैवकम्॥ १२/१३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.005.m4a", "display_order": 6}, {"id": 6000345006, "chapter_id": 10345, "verse_number": "१२-१३-५", "content_sanskrit": "दशाष्टौ श्रीभागवतं नारदं पञ्चविंशतिः।\nमार्कण्डेयं नवाग्नेयं दशपञ्चचतुश्शतम्॥ १२/१३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.006.m4a", "display_order": 7}, {"id": 6000345007, "chapter_id": 10345, "verse_number": "१२-१३-६", "content_sanskrit": "चतुर्दश भविष्यं स्यात् तथा पञ्चदशानि च।\nदशाष्टौ ब्रह्मवैवर्तं लिङ्गमेकादशैव तु॥ १२/१३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.007.m4a", "display_order": 8}, {"id": 6000345008, "chapter_id": 10345, "verse_number": "१२-१३-७", "content_sanskrit": "चतुर्विंशति वाराहमेकाशीतिसहस्रकम्।\nस्कान्दं शतं तथा चैकं वामनं दश कीर्तितम्॥ १२/१३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.008.m4a", "display_order": 9}, {"id": 6000345009, "chapter_id": 10345, "verse_number": "१२-१३-८", "content_sanskrit": "कौर्मं सप्तदश ख्यातं मात्स्यं तच्च चतुर्दश।\nएकोनविंशत् सौपर्णं ब्रह्माण्डं द्वादशैव तु॥ १२/१३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.009.m4a", "display_order": 10}, {"id": 6000345010, "chapter_id": 10345, "verse_number": "१२-१३-९", "content_sanskrit": "एवं पुराणसन्दोहश्चतुर्लक्ष उदाहृतः।\nतत्राष्टादशसाहस्रं श्रीभागवतमिष्यते॥ १२/१३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.010.m4a", "display_order": 11}, {"id": 6000345011, "chapter_id": 10345, "verse_number": "१२-१३-१०", "content_sanskrit": "इदं भगवता पूर्वं ब्रह्मणे नाभिपङ्कजे। स्थिताय भवभीताय कारुण्यात् सम्प्रकाशितम्।\nआदिमध्यावसानेषु वैराग्याख्यानसंयुतम्॥ १२/१३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.011.m4a", "display_order": 12, "topics": [{"text": "भागवतश्रवणफलम्", "range": "१०–१२"}]}, {"id": 6000345012, "chapter_id": 10345, "verse_number": "१२-१३-११", "content_sanskrit": "हरिलीलाकथाव्रातामृतानन्दितसत्सुरम्। सर्ववेदान्तसारं यद् ब्रह्मात्मैकत्वलक्षणम्।\nवस्त्वद्वितीयं तन्निष्ठं कैवल्यैकप्रयोजनम्॥ १२/१३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.012.m4a", "display_order": 13}, {"id": 6000345013, "chapter_id": 10345, "verse_number": "१२-१३-१२", "content_sanskrit": "प्रौष्ठपद्यां पौर्णमास्यां हेमसिंहसमन्वितम्।\nददाति यो भागवतं स याति परमां गतिम्॥ १२/१३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.013.m4a", "display_order": 14}, {"id": 6000345014, "chapter_id": 10345, "verse_number": "१२-१३-१३", "content_sanskrit": "राजन्ते तावदन्यानि पुराणानि सतां गणे।\nयावन्न दृश्यते साक्षाच्छ्रीमद्भागवतं परम्॥ १२/१३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.014.m4a", "display_order": 15, "topics": [{"text": "भागवतमहिमा", "range": "१३–२२"}]}, {"id": 6000345015, "chapter_id": 10345, "verse_number": "१२-१३-१४", "content_sanskrit": "सर्ववेदान्तसारं हि श्रीभागवतमिष्यते।\nतद्रसामृततृप्तस्य नान्यत्र स्याद् रतिः क्‍वचित्॥ १२/१३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.015.m4a", "display_order": 16}, {"id": 6000345016, "chapter_id": 10345, "verse_number": "१२-१३-१५", "content_sanskrit": "निम्नगानां यथा गङ्गा देवानामच्युतो यथा।\nवैष्णवानां यथा शम्भुः पुराणानामिदं तथा॥ १२/१३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.016.m4a", "display_order": 17}, {"id": 6000345017, "chapter_id": 10345, "verse_number": "१२-१३-१६", "content_sanskrit": "क्षेत्राणां चैव सर्वेषां यथा काशी ह्यनुत्तमा।\nतथा पुराणव्रातानां श्रीमद्भागवतं द्विजाः॥ १२/१३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.017.m4a", "display_order": 18}, {"id": 6000345018, "chapter_id": 10345, "verse_number": "१२-१३-१७", "content_sanskrit": "श्रीमद्भागवतं पुराणममलं यद् वैष्णवानां प्रियं\nयस्मिन् पारमहंस्यमेकममलं ज्ञानं परं गीयते।\nयत्र ज्ञानविरागभक्तिसहितं नैष्कर्म्यमाविष्कृतं\nतच्छृण्वन् विपठन् विचारणपरो भक्त्या विमुच्येन्नरः॥ १२/१३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.018.m4a", "display_order": 19}, {"id": 6000345019, "chapter_id": 10345, "verse_number": "१२-१३-१८", "content_sanskrit": "कस्मै येन विभासितोऽयमतुलो ज्ञानप्रदीपः पुरा\nतद्रूपेण च नारदाय मुनये कृष्णाय तद्रूपिणे।\nयोगीन्द्राय तदात्मनाऽथ भगवद्राताय कारुण्यत-\nस्तच्छुद्धं विमलं विशोकममृतं सत्यं परं धीमहि॥ १२/१३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.019.m4a", "display_order": 20}, {"id": 6000345020, "chapter_id": 10345, "verse_number": "१२-१३-१९", "content_sanskrit": "नमस्तस्मै भगवते वासुदेवाय साक्षिणे।\nय इदं कृपया कस्मै व्याचचक्षे मुमुक्षवे॥ १२/१३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.020.m4a", "display_order": 21}, {"id": 6000345021, "chapter_id": 10345, "verse_number": "१२-१३-२०", "content_sanskrit": "योगीन्द्राय नमस्तस्मै शुकाय ब्रह्मरूपिणे।\nसंसारसर्पदष्टं यो विष्णुरातमूमुचत्॥ १२/१३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.021.m4a", "display_order": 22}, {"id": 6000345022, "chapter_id": 10345, "verse_number": "१२-१३-२१", "content_sanskrit": "भवे भवे यथा भक्तिः पादयोस्तव जायते।\nतथा कुरुष्व योगेश नाथस्त्वं मे यतः प्रभो॥ १२/१३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.022.m4a", "display_order": 23}, {"id": 6000345023, "chapter_id": 10345, "verse_number": "१२-१३-२२", "content_sanskrit": "नामसङ्कीर्तनं यस्य सर्वपापप्राणाशनम्।\nप्रणामो दुःखशमनस्तं नमामि हरिं परम्॥ १२/१३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_013/BhP_12.013.023.m4a", "display_order": 24}, {"id": 6000345024, "chapter_id": 10345, "verse_number": null, "content_sanskrit": "॥ इति अष्टादशपुराणानां ग्रन्थसङ्ख्या॥\n॥ श्रीकृष्णार्पणमस्तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]