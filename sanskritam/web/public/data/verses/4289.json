[{"id": 2151438, "chapter_id": 4289, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2151439, "chapter_id": 4289, "verse_number": "१", "content_sanskrit": "बृहतीं धार्तराष्ट्राणां दृष्ट्वा सेनां समुद्यताम् ।\nविषादमगमद् राजा कुन्तीपुत्रो युधिष्ठिरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2151440, "chapter_id": 4289, "verse_number": "२", "content_sanskrit": "व्यूहं भीष्मेण चाभेद्यं कल्पितं प्रेक्ष्य पाण्डवः ।\nअभेद्यमिव सम्प्रेक्ष्य विषण्णोऽर्जुनमब्रवीत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2151441, "chapter_id": 4289, "verse_number": "३", "content_sanskrit": "धनञ्जय कथं शक्यमस्माभिर्योद्धुमाहवे ।\nधार्तराष्ट्रैर्महाबाहो येषां योद्धा पितामहः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2151442, "chapter_id": 4289, "verse_number": "४", "content_sanskrit": "अक्षोभ्योऽयमभेद्यश्च भीष्मेणामित्रकर्शिना ।\nकल्पितः शास्त्रदृष्टेन विधिना भूरितेजसा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2151443, "chapter_id": 4289, "verse_number": "५", "content_sanskrit": "ते वयं संशयं प्राप्ताः ससैन्याः शत्रुकर्शन ।\nकथमस्मान् महाव्यूहादुद्यानं नो भविष्यति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2151444, "chapter_id": 4289, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2151445, "chapter_id": 4289, "verse_number": "६", "content_sanskrit": "अथार्जुनोऽब्रवीद् पार्थं युधिष्ठिरममित्रहा ।\nविषण्णमभिसम्प्रेक्ष्य तव राजन्ननीकिनीम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2151446, "chapter_id": 4289, "verse_number": "७", "content_sanskrit": "प्रज्ञयाभ्यधिकान् शूरान् गुणयुक्तान् बहूनपि ।\nजयन्त्यल्पतरा येन तन्निबोध विशाम्पते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2151447, "chapter_id": 4289, "verse_number": "८", "content_sanskrit": "तत्तु ते कारणं राजन् प्रवक्ष्याम्यनसूयवे ।\nनारदस्तमृषिर्वेद भीष्मद्रोणौ च पाण्डव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2151448, "chapter_id": 4289, "verse_number": "९", "content_sanskrit": "एतमेवार्थमाश्रित्य युद्धे देवासुरेऽब्रवीत् ।\nपितामहः किल पुरा महेन्द्रादीन् दिवौकसः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2151449, "chapter_id": 4289, "verse_number": "१०", "content_sanskrit": "न तथा बलवीर्याभ्यां विजयन्ते जिगीषवः ।\nयथा सत्यानृशंसाभ्यां धर्मेणैवोद्यमेन च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2151450, "chapter_id": 4289, "verse_number": "११", "content_sanskrit": "त्यक्त्वाऽऽधर्मं च लोभं च मोहं चोद्यममास्थिताः ।\nयुध्यध्वमनहङ्कारा यतो धर्मस्ततो जयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2151451, "chapter_id": 4289, "verse_number": "१२", "content_sanskrit": "यत्र कृष्णश्च वेदात्मा सर्वसर्वेश्वरो हरिः ।\nजयस्तत्र महाबाहो यथा मे प्राह नारदः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2151452, "chapter_id": 4289, "verse_number": "१३", "content_sanskrit": "एवं राजन् विजानीहि ध्रुवोऽस्माकं रणे जयः ।\nयथा मे नारदः प्राह यतः कृष्णस्ततो जयः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2151453, "chapter_id": 4289, "verse_number": "१४", "content_sanskrit": "गुणभूतो जयः कृष्णे पृष्ठतोऽन्वेति माधवम् ।\nआभिजातिजयस्तस्य सन्नतिश्चापरो गुणः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2151454, "chapter_id": 4289, "verse_number": "१५", "content_sanskrit": "अनन्ततेजा गोविन्दः शत्रुपूगेषु निर्व्यथः ।\nपुरुषः सनातनतमो यतः कृष्णस्ततो जयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2151455, "chapter_id": 4289, "verse_number": "१६", "content_sanskrit": "पुरा ह्येष हरिर्भूत्वा वैकुण्ठोऽकुण्ठसायकः ।\nसुरासुरानवस्फूर्जन्नब्रवीत् के जयन्त्विति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2151456, "chapter_id": 4289, "verse_number": "१७", "content_sanskrit": "अनुकृष्णं जयाम इति यैरुक्तं तत्र तैर्जितम् ।\nतत्प्रसादाद्धि त्रैलोक्यं प्राप्तं शक्रादिभिः सुरैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2151457, "chapter_id": 4289, "verse_number": "१८", "content_sanskrit": "तस्य ते न व्यथां काञ्चिदिह पश्यामि भारत ।\nयस्य ते जयमाशास्ते विश्वभुक् त्रिदशेश्वरः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2151458, "chapter_id": 4289, "verse_number": "२१", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां भीष्मपर्वणि एकविंशतितमोऽध्यायः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2151459, "chapter_id": 4289, "verse_number": "", "content_sanskrit": "॥ इति भगवद्गीतापर्वणि अष्टमोऽध्यायः ॥८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]