[{"id": 2030693, "chapter_id": 1672, "verse_number": "३-३१०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030694, "chapter_id": 1672, "verse_number": "३-३१०-१", "content_sanskrit": "एतस्मिन्नेव काले तु धृतराष्ट्रस्य वै सखा।\nसूतोऽधिरथ इत्येव सदारो जाह्नवीं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030695, "chapter_id": 1672, "verse_number": "३-३१०-२", "content_sanskrit": "तस्य भार्याऽभवद्राजन्रूपेणासदृशी भुवि।\nराधा नाम महाभागा न सा पुत्रमविन्दत।\nअपत्यार्थे परं यत्नमकरोच्च विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030696, "chapter_id": 1672, "verse_number": "३-३१०-३", "content_sanskrit": "सा ददर्शाथ मञ्जूषामुह्यमानां यदृच्छया।\nदत्तरक्षाप्रतिसरामन्वालम्भनशोभनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030697, "chapter_id": 1672, "verse_number": "३-३१०-४", "content_sanskrit": "ऊर्मीतरङ्गैर्जाह्नव्याः समानीतामुपह्वरम्।\n`विवर्तमानां बहुशः पुनःपुनरितस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030698, "chapter_id": 1672, "verse_number": "३-३१०-५", "content_sanskrit": "ततः सा वायुना राजन्स्रोतसा च बलीयसा।\nउपानीतो यतः सूतः सभार्यो जलमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030699, "chapter_id": 1672, "verse_number": "३-३१०-६", "content_sanskrit": "सा तु कौतूहलात्प्राप्तां ग्राहयामास भामिनी।\nततो निवेदयामास सूतस्याधिरथस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030700, "chapter_id": 1672, "verse_number": "३-३१०-७", "content_sanskrit": "स तामुद्धृत्य मञ्जूषामुत्सार्य जलमन्तिकात्।\nयन्त्रैरुद्घाटयामास सोऽपश्यत्तत्रबालकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030701, "chapter_id": 1672, "verse_number": "३-३१०-८", "content_sanskrit": "मृष्टकुण्डलयुक्तेन वदनेन विराजितम्।\n`परिम्लानमुखं बालं रुदन्तं क्षुधितं भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030702, "chapter_id": 1672, "verse_number": "३-३१०-९", "content_sanskrit": "स तु तं परया लक्ष्म्या दृष्ट्वा युक्तं वरात्मजम्।\nस सूतो भार्यया सार्धं विस्मयोत्फुल्ललोचनः।\nअङ्कमारोप्य तं बालं भार्यां वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030703, "chapter_id": 1672, "verse_number": "३-३१०-१०", "content_sanskrit": "इदमत्यद्भुतं भीरु यतो जातोस्मि भामिनि।\nदृष्टवान्देवगर्भोऽयं मन्येऽस्माकमुपागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030704, "chapter_id": 1672, "verse_number": "३-३१०-११", "content_sanskrit": "अनपत्यस्य पुत्रोऽयं देवैर्दत्तो ध्रुवं मम।\nइत्युक्त्वा तं ददौ पुत्रं राधायै स महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030705, "chapter_id": 1672, "verse_number": "३-३१०-१२", "content_sanskrit": "रप्रतिजग्राह तं राधा विधिवद्दिव्यरूपिणम्।\nपुत्रं कमलगर्भाभं देवगर्भं श्रिया वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030706, "chapter_id": 1672, "verse_number": "३-३१०-१३", "content_sanskrit": "`स्तन्यं समस्रवच्चास्य दैवादित्थ निश्चयः।\nपुपोष चैनं विधिवद्ववृधे स च वीर्यवान्।\nततः प्रभृति चाप्यन्ये प्राभवन्नौरसाः सुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030707, "chapter_id": 1672, "verse_number": "३-३१०-१४", "content_sanskrit": "`नामकर्म च चक्रुस्ते कुण्डले तस् दृश्यते।\nकर्ण इत्येव तं बालं दृष्ट्वा कर्णं सकुण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030708, "chapter_id": 1672, "verse_number": "३-३१०-१५", "content_sanskrit": "वसुवर्मधरं दृष्ट्वा तं बालं हेमकुण्डलम्।\nनामास्य वसुषेणेति ततश्चक्रुर्द्विजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030709, "chapter_id": 1672, "verse_number": "३-३१०-१६", "content_sanskrit": "एवं स सूतपुत्रत्वं जगामामितविक्रमः।\nवसुषेण इतिख्यातो वृष इत्येव च प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030710, "chapter_id": 1672, "verse_number": "३-३१०-१७", "content_sanskrit": "सूतस्य ववृधेऽङ्गेषु ज्येष्ठः पुत्रः स वीर्यवान्।\nचारेण विदितश्चासीत्पृथया दिव्यवर्मभृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030711, "chapter_id": 1672, "verse_number": "३-३१०-१८", "content_sanskrit": "सूतस्त्वधिरथः पुत्रं विवृद्धं समयेन तम्।\nदृष्ट्वा प्रस्थापयामास पुरं वारणसाह्वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030712, "chapter_id": 1672, "verse_number": "३-३१०-१९", "content_sanskrit": "तत्रोपसदनं चक्रे द्रोणस्येष्वस्त्रकर्मणि।\nसख्यं दुर्योधनेनैवमगमत्स च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030713, "chapter_id": 1672, "verse_number": "३-३१०-२०", "content_sanskrit": "द्रोणात्कृपाच्च रामाच्च सोऽस्त्रग्रामं चतुर्विधम्।\nलब्ध्वा लोकेऽभवत्ख्यातः परमेष्वासतां गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030714, "chapter_id": 1672, "verse_number": "३-३१०-२१", "content_sanskrit": "संधाय धार्तराष्ट्रेण पार्थानां विप्रिये रतः।\nयोद्धुमाशंसते नित्यं फल्गुनेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030715, "chapter_id": 1672, "verse_number": "३-३१०-२२", "content_sanskrit": "सदा हि तस् स्पर्धाऽऽसीदर्जुनन विशांपते।\nअर्जुनस्य च कर्णेन यतो द्वन्द्वं बभूव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030716, "chapter_id": 1672, "verse_number": "३-३१०-२३", "content_sanskrit": "एतद्गुह्यं महाराज सूर्यस्यासीन्न संशयः।\nयः सूर्यसंभवः कर्णः कुर्यात्प्रतिकुले रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030717, "chapter_id": 1672, "verse_number": "३-३१०-२४", "content_sanskrit": "तं तु कुण्डलिनं दृष्ट्वा वर्मणा च समन्वितम्।\nअवध्यं समरे मत्वा पर्यतप्यद्युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030718, "chapter_id": 1672, "verse_number": "३-३१०-२५", "content_sanskrit": "यदा च कर्णो राजेन्द्र भानुमन्तं दिवाकरम्।\nस्तौति मध्यंदिने प्राप्ते प्राञ्जलिः सलिलोत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030719, "chapter_id": 1672, "verse_number": "३-३१०-२६", "content_sanskrit": "तत्रैनमुपतिष्ठन्ति ब्राह्मणा धनहेतुना।\nनादेयं तस्य तत्काले किंचिदस्ति द्विजातिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030720, "chapter_id": 1672, "verse_number": "३-३१०-२७", "content_sanskrit": "तमिन्द्रो ब्राह्मणो भूत्वा भिक्षां देहीत्युपस्थितः।\nस्वागतं चेति राधेयस्तमथ प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2030721, "chapter_id": 1672, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि कुण्डलाहरणपर्वणि दशाधिकत्रिशततमोऽध्यायः ॥ ३१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]