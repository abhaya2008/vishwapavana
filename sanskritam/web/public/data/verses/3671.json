[{"id": 2124691, "chapter_id": 3671, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2124692, "chapter_id": 3671, "verse_number": "१", "content_sanskrit": "असान्निध्यं कथं कृष्ण तवासीद् वृष्णिनन्दन ।\nक्व चासीद् विप्रवासस्ते किं चाकार्षीः प्रवासितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2124693, "chapter_id": 3671, "verse_number": "", "content_sanskrit": "कृष्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2124694, "chapter_id": 3671, "verse_number": "२", "content_sanskrit": "साल्वस्य नगरं सौभं गतोऽहं भरतर्षभ ।\nनिहन्तुं भरतश्रेष्ठ शृणु मे तत्र कारणम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2124695, "chapter_id": 3671, "verse_number": "३", "content_sanskrit": "महातेजा महाबाहुर्यः स राजा महायशाः ।\nदमघोषात्मजो वीरः शिशुपालो मया हतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2124696, "chapter_id": 3671, "verse_number": "४", "content_sanskrit": "यज्ञे ते भरतश्रेष्ठ राजसूयेऽर्हणां प्रति ।\nसरोषमनुसम्प्राप्तो नामृष्यत दुरात्मवान् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2124697, "chapter_id": 3671, "verse_number": "५", "content_sanskrit": "श्रुत्वा तं निहतं साल्वः तीव्रकोपसमन्वितः ।\nउपायाद् द्वारकां शून्यामिहस्थे मयि भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2124698, "chapter_id": 3671, "verse_number": "६", "content_sanskrit": "स तत्र योधितो राजन् बालकैर्वृष्णिपुङ्गवैः ।\nनिवृत्तः कामगं सौभमारुह्यैव नृशंसकृत् ।\nचिरजीवी नृपः सोऽपि प्रसादात् पद्मजन्मनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2124699, "chapter_id": 3671, "verse_number": "७", "content_sanskrit": "ततो वृष्णिप्रवीरांस्तान् बालान् हत्वा बहूंस्तदा ।\nपुरोद्यानानि सर्वाणि भेदयामास दुर्मतिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2124700, "chapter_id": 3671, "verse_number": "८", "content_sanskrit": "उक्तवांश्च महाबाहो क्वासौ वृष्णिकुलाधमः ।\nवासुदेवः स मन्दात्मा वसुदेवसुतो गतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2124701, "chapter_id": 3671, "verse_number": "९", "content_sanskrit": "तस्य युद्धार्थिनो दर्पं युद्धे विनयिताऽस्म्यहम् ।\nआनर्ताः सर्वमाख्यात तत्र गन्तास्मि यत्र सः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2124702, "chapter_id": 3671, "verse_number": "१०", "content_sanskrit": "तं हत्वा विनिवर्तिष्ये कंसकेशिनिषूदनम् ।\nअहत्वा न विवर्तिष्ये सत्येनायुधमालभे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2124703, "chapter_id": 3671, "verse_number": "११", "content_sanskrit": "क्वासौ क्वासाविति पुनस्तत्र तत्र प्रधावति ।\nमया किल रणे योद्धुं काङ्क्षमाणः स सौभराट्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2124704, "chapter_id": 3671, "verse_number": "१२", "content_sanskrit": "अद्याहं पापकर्माणं क्षुद्रं विश्वासघातिनम् ।\nशिशुपालवधामर्षाद् गमयिष्ये यमक्षयम् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2124705, "chapter_id": 3671, "verse_number": "१३", "content_sanskrit": "मम पापस्वभावेन भ्राता येन निपातितः।\nशिशुपालो महावीर्यं तं हनिष्याम्यहं रणे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2124706, "chapter_id": 3671, "verse_number": "१४", "content_sanskrit": "भ्राता वालश्च राजा च न च सङ्ग्राममूर्द्धनि ।\nप्रमत्तश्च हतो वीरः तं वधिष्ये जनार्दनम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2124707, "chapter_id": 3671, "verse_number": "१५", "content_sanskrit": "एवमादि महाराज विलप्य दिवमास्थितः ।\nकामगेन स सौभेन क्षिप्त्वा मां कुरुनन्दन\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2124708, "chapter_id": 3671, "verse_number": "१६", "content_sanskrit": "तमश्रौषमहं गत्वा यथावृत्तः स दुर्मतिः ।\nगतः कौरव्य दुष्टात्मा मार्तिकावतको नृपः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2124709, "chapter_id": 3671, "verse_number": "१७", "content_sanskrit": "ततोऽहमपि कौरव्य रोषव्याकुललोचनः ।\nनिश्चित्य मनसा राजन् वधायास्य मनो दधे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2124710, "chapter_id": 3671, "verse_number": "१८", "content_sanskrit": "आनर्तेषु विमर्दं च क्षेपं चात्मनि कौरव ।\nप्रवृद्धमवलेपं च तस्य कुष्कृतकर्मणः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2124711, "chapter_id": 3671, "verse_number": "१९", "content_sanskrit": "ततः सौभवधायाहं प्रस्थितः पृथिवीपते ।\nस मया सागरोपान्ते दृष्ट आसीत् परीप्सता\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2124712, "chapter_id": 3671, "verse_number": "२०", "content_sanskrit": "ततः प्रध्माप्य जलजं पाञ्चजन्यमहं नृप ।\nआहूय साल्वं समरे युद्धाय समवास्थितः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2124713, "chapter_id": 3671, "verse_number": "२१", "content_sanskrit": "मुहूर्तमभवद् युद्धं तत्र मे दानवैःसह ।\nवशीभूताश्च मे सर्वे भूतळे च निपातिताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2124714, "chapter_id": 3671, "verse_number": "२२", "content_sanskrit": "एतत् कार्यं महाबाहो येनाहं नागतस्तदा ।\nश्रुत्वैव हस्तिनपुरे द्यूतं चाविनयोत्थितम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2124715, "chapter_id": 3671, "verse_number": "३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां वनपर्वणि\nत्रयोदशोऽध्यायः ॥१३॥\n॥ कैरातपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2124716, "chapter_id": 3671, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]