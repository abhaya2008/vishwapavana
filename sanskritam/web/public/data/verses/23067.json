[{"id": 7003067000, "chapter_id": 23067, "verse_number": "४-१-१", "content_sanskrit": "नारद उवाच ।\nश्रुतं प्रथमतो ब्रह्मन्ब्रह्मखण्डं मनोहरम् ।\nब्रह्मणो वदनांभोजात्परमाद्भुतमेव च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003067001, "chapter_id": 23067, "verse_number": "४-१-२", "content_sanskrit": "ततस्तद्वचनात्तूर्णं समागत्य तवांतिकम् ।\nश्रुतं प्रकृतिखण्डं च सुधाखंडात्परं वरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003067002, "chapter_id": 23067, "verse_number": "४-१-३", "content_sanskrit": "ततो गणपतेः खंडमखंडभवखंडनम् ।\nन मे तृप्तं मनो लोलं विशिष्टं श्रोतुमिच्छति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003067003, "chapter_id": 23067, "verse_number": "४-१-४", "content_sanskrit": "श्रीकृष्णजन्मखंडं च जन्मादेः खंडनं नृणाम् ।\nप्रदीपं सर्वतत्त्वानां कर्मघ्नं हरिभक्तिदम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003067004, "chapter_id": 23067, "verse_number": "४-१-५", "content_sanskrit": "सद्यो वैराग्यजननं भवरोगनिकृंतनम् ।\nकारणं मुक्तिबीजानां भवाब्धेस्तारणं परम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003067005, "chapter_id": 23067, "verse_number": "४-१-६", "content_sanskrit": "कर्मोपभोगरोगाणां खंडने च रसायनम् ।\nश्रीकृष्णचरणांभोजप्राप्तिसोपान कारणम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003067006, "chapter_id": 23067, "verse_number": "४-१-७", "content_sanskrit": "जीवनं वैष्णवानां च जगतां पावनं परम् ।\nवद विस्तार्य मां भक्तं शिष्यं च शरणागतम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003067007, "chapter_id": 23067, "verse_number": "४-१-८", "content_sanskrit": "केन वा प्रार्थितः कृष्ण आजगाम महीतलम् ।\nसर्वांशैरेक एवेशः परिपूर्णतमः स्वयम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003067008, "chapter_id": 23067, "verse_number": "४-१-९", "content_sanskrit": "युगे कुत्र कुतो हेतोः कुत्र वाऽऽविर्बभूव ह ।\nवसुदेवोऽस्य जनकः को वा का वा च देवकी ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003067009, "chapter_id": 23067, "verse_number": "४-१-१०", "content_sanskrit": "वद कस्य कुले जन्म मायया सुविडंबनम् ।\nकिं चकार समागत्य केन रूपेण वा हरिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003067010, "chapter_id": 23067, "verse_number": "४-१-११", "content_sanskrit": "जगाम गोकुलं कंसभयेन सूतिकागृहात् ।\nकथं कंसात्कीटतुल्याद्भयेशस्य भयं मुने ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003067011, "chapter_id": 23067, "verse_number": "४-१-१२", "content_sanskrit": "हरिर्वा गोपवेषेण गोकुले किं चकार ह ।\nकुतो गोपाङ्गनासार्धं विजहार जगत्पतिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003067012, "chapter_id": 23067, "verse_number": "४-१-१३", "content_sanskrit": "का वा गोपांगना के वा गोपाला बालरूपिणः ।\nका वा यशोदा को नंदः किं वा पुण्यं चकार ह ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003067013, "chapter_id": 23067, "verse_number": "४-१-१४", "content_sanskrit": "कथं राधा पुण्यवती देवी गोकुलवासिनी ।\nव्रजे वा व्रजकन्या सा बभूव प्रेयसो हरेः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003067014, "chapter_id": 23067, "verse_number": "४-१-१५", "content_sanskrit": "कथं गोप्यो दुराराध्यं संप्रापुरीश्वरं परम् ।\nकथं ताश्च परित्यज्य जगाम मथुरां पुनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003067015, "chapter_id": 23067, "verse_number": "४-१-१६", "content_sanskrit": "भारावतरणं कृत्वा किं विधाय जगाम सः ।\nकथयस्व महाभाग पुण्यश्रवणकीर्तन ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003067016, "chapter_id": 23067, "verse_number": "४-१-१७", "content_sanskrit": "सुदुर्लभां हरिकथां तरणिं भवसागरे ।\nनिषेकभोगनिगडक्लेशच्छेदन कर्तनीम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003067017, "chapter_id": 23067, "verse_number": "४-१-१८", "content_sanskrit": "पापेंधनानां दहने ज्वलदग्निशिखामिव ।\nपुंसां श्रुतवतां कोटिजन्मकिल्बिषनाशिनीम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003067018, "chapter_id": 23067, "verse_number": "४-१-१९", "content_sanskrit": "मुक्तिं कर्णसुधारम्यां शोकसागरनाशिनीम् ।\nमह्यं भक्ताय शिष्याय ज्ञानं देहि कृपानिधे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003067019, "chapter_id": 23067, "verse_number": "४-१-२०", "content_sanskrit": "तपोजपमहादानात्पृथिव्यां तीर्थदर्शनात् ।\nश्रुतिपाठादनशनाद्व्रताद्देवार्चनादपि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003067020, "chapter_id": 23067, "verse_number": "४-१-२१", "content_sanskrit": "दीक्षायाः सर्वयज्ञेषु यत्फलं लभते नरः ।\nषोडशीं ज्ञानदानस्य कलां नार्हति तत्फलम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003067021, "chapter_id": 23067, "verse_number": "४-१-२२", "content_sanskrit": "पित्राऽहं प्रेषितो ज्ञानादानाय तव सन्निधिम् ।\nसुधासमुद्रं संप्राप्य को वाऽन्यत्पातुमिच्छति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003067022, "chapter_id": 23067, "verse_number": "४-१-२३", "content_sanskrit": "श्रीनारायण उवाच ।\nमया ज्ञातोऽसि धन्यस्त्वं पुण्यराशिः सुमूर्तिमान् ।\nकरोषि भ्रमणं लोकान्पावितुं कुलपावन ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003067023, "chapter_id": 23067, "verse_number": "४-१-२४", "content_sanskrit": "जनानां हृदयं सद्यः सुव्यक्तं वचनेन वै ।\nशिष्ये कलत्रे कन्यायां दौहित्रे बांधवेऽपि च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003067024, "chapter_id": 23067, "verse_number": "४-१-२५", "content_sanskrit": "पुत्रे पौत्रे च वचसि प्रतापे चापदि स्त्रियाम् ।\nवृद्धौ वैरिणि विद्यायां ज्ञायते हृदयं नृणाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003067025, "chapter_id": 23067, "verse_number": "४-१-२६", "content_sanskrit": "जीवन्मुक्तोऽसि पूतस्त्वं शुद्धभक्तो गदाभृतः ।\nपुनासि पादरजसा सर्वाधारां वसुन्धराम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003067026, "chapter_id": 23067, "verse_number": "४-१-२७", "content_sanskrit": "पुनासि लोकान्त्सर्वांश्च स्वीयविग्रहदर्शनात् ।\nसुमंगलां हरिकथां तेन त्वं श्रोतुमिच्छसि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003067027, "chapter_id": 23067, "verse_number": "४-१-२८", "content_sanskrit": "यत्र कृष्णकथाः संति तत्रैव सर्वदेवताः ।\nऋषयो मुनयश्चैव तीर्थानि निखिलानि च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003067028, "chapter_id": 23067, "verse_number": "४-१-२९", "content_sanskrit": "कथाः श्रुत्वा कथांते ते यांति सन्तो निरापदम् ।\nभवंति तानि तीर्थानि येषु कृष्णकथाः शुभाः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003067029, "chapter_id": 23067, "verse_number": "४-१-३०", "content_sanskrit": "सद्यः कृष्णकथावक्ता स्वस्य पुंसां शतं शतम्।\nसमुद्धृत्य श्रुतवतां पुनाति निखिलं कुलम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003067030, "chapter_id": 23067, "verse_number": "४-१-३१", "content_sanskrit": "प्रष्टा तु प्रश्नमात्रेण पुनाति कुलमात्मनः ।\nश्रोता श्रवणमात्रेण स्वकुलं स्व स्वबांधवान् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003067031, "chapter_id": 23067, "verse_number": "४-१-३२", "content_sanskrit": "शतजन्मतपस्तप्तो जन्मेदं भारते लभेत् ।\nकरोति सफलं जन्म श्रुत्वा हरिकथामृतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003067032, "chapter_id": 23067, "verse_number": "४-१-३३", "content_sanskrit": "अर्चनं वंदनं मन्त्रजपः सेवनमेव च ।\nस्मरणं कीर्तनं शश्वद्गुणश्रवणमीप्सितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003067033, "chapter_id": 23067, "verse_number": "४-१-३४", "content_sanskrit": "निवेदनं तस्य दास्यं नवधा भक्तिलक्षणम् ।\nकरोति जन्म सुफलं कृत्वैतानि च नारद ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003067034, "chapter_id": 23067, "verse_number": "४-१-३५", "content_sanskrit": "न च विघ्नो भवेत्तस्य परमायुर्न नश्यति ।\nन याति तत्पुरः कालो वैनतेयमिवोरगः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003067035, "chapter_id": 23067, "verse_number": "४-१-३६", "content_sanskrit": "न जहाति समीपं च क्षणं तस्य हरिः स्वयम् ।\nउपतिष्ठति तूर्णं तमणिमादिकसिद्धयः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003067036, "chapter_id": 23067, "verse_number": "४-१-३७", "content_sanskrit": "सुदर्शनं भ्रमत्येव तस्य पार्श्वे दिवानिशम् ।\nकृष्णाज्ञया च रक्षार्थं को वा किं कर्तुमीश्वरः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003067037, "chapter_id": 23067, "verse_number": "४-१-३८", "content_sanskrit": "न यांति तत्समीपं च स्वप्नेऽपि यमकिंकराः ।\nज्वलदग्निं यथा दृष्ट्वा शलभा न व्रजंति तम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003067038, "chapter_id": 23067, "verse_number": "४-१-३९", "content_sanskrit": "व्याधयो विपदः शोका विप्राश्च न प्रयांति तम् ।\nन याति तत्समीपं च मृत्युर्मृत्युभयान्मुने ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003067039, "chapter_id": 23067, "verse_number": "४-१-४०", "content_sanskrit": "ऋषयो मुनयः सिद्धाः सन्तुष्टाः सर्वदेवताः ।\nस च सर्वत्र निःशंकः सुखी कृष्णप्रसादतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003067040, "chapter_id": 23067, "verse_number": "४-१-४१", "content_sanskrit": "तव कृष्णकथायां च रतिरात्यंतिकी सदा ।\nजनकस्य स्वभावो हि जन्ये तिष्ठति निश्चितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003067041, "chapter_id": 23067, "verse_number": "४-१-४२", "content_sanskrit": "विप्रेंद्र का प्रशंसेयं जन्म ते ब्रह्ममानसे ।\nयत्र यत्र कुले जन्म तन्मतिस्तादृशी भवेत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003067042, "chapter_id": 23067, "verse_number": "४-१-४३", "content_sanskrit": "पिता विधाता जगतां कृष्णपादाब्जसेवया ।\nनित्यं करोति यः शश्वन्नवधा भक्तिलक्षणम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003067043, "chapter_id": 23067, "verse_number": "४-१-४४", "content_sanskrit": "रतिः कृष्णकथायां च यस्याश्रुपुलकोद्गमः ।\nमनो निमग्नं तत्रैव स भक्तः कथितो बुधैः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003067044, "chapter_id": 23067, "verse_number": "४-१-४५", "content_sanskrit": "पुत्रदारादिकं सर्वं जानाति श्रीहरेरिति ।\nआत्मना मनसा वाचा स भक्तः कथितो बुधैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003067045, "chapter_id": 23067, "verse_number": "४-१-४६", "content_sanskrit": "निर्जने तीर्थसंपर्के निःसंगा ये मुदाऽन्विताः ।\nध्यायंते चरणांभोजं श्रीहरेस्ते च वैष्णवाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003067046, "chapter_id": 23067, "verse_number": "४-१-४७", "content_sanskrit": "दयाऽस्ति सर्वजीवेषु सर्वं कृष्णम यं जगत् ।\nयो जानाति महाज्ञानी स भक्तो वैष्णवो मतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003067047, "chapter_id": 23067, "verse_number": "४-१-४८", "content_sanskrit": "शश्वद्ये नाम गायंति गुणं मंत्रं जपंति च ।\nकुर्वंति श्रवणं गाथा वदंति तेऽतिवैष्णवाः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003067048, "chapter_id": 23067, "verse_number": "४-१-४९", "content_sanskrit": "लब्धानीष्टानि वस्तूनि प्रदातुं हरये मुदा ।\nतूर्णं यस्य मनो हृष्टं स भक्तो ज्ञानिनां वरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003067049, "chapter_id": 23067, "verse_number": "४-१-५०", "content_sanskrit": "यन्मनो हरिपादाब्जे स्वप्ने ज्ञाने दिवानिशम्।\nपूर्वकर्मोपभोगं च बहिर्भुङ्क्ते स वैष्णवः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003067050, "chapter_id": 23067, "verse_number": "४-१-५१", "content_sanskrit": "गुरुवक्त्राद्विष्णुमंत्रो यस्य कर्णे विशत्यलम् ।\nतं वैष्णवं महापूतं प्रवदंति मनीषिणः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003067051, "chapter_id": 23067, "verse_number": "४-१-५२", "content_sanskrit": "पूर्वान्त्सप्त परान्त्सप्त सप्त मातामहादिकान् ।\nसोदरानुद्धरेद्भक्तः स्वप्रसूं च प्रसूप्रसूम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003067052, "chapter_id": 23067, "verse_number": "४-१-५३", "content_sanskrit": "कलत्रं कन्यकां बंधुं शिष्यं दौहित्रमात्मनः ।\nकिंकरान्किंकरीश्चैवमुद्धरेद्वैष्णवः सदा ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003067053, "chapter_id": 23067, "verse_number": "४-१-५४", "content_sanskrit": "सदा वांछति तीर्थानि वैष्णवस्पर्शदर्शने ।\nपापिदत्तानि पापानि तेषां नश्यंति संगतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003067054, "chapter_id": 23067, "verse_number": "४-१-५५", "content_sanskrit": "गोदोहनक्षणं यावद्यत्र तिष्ठंति वैष्णवाः ।\nतत्र सर्वाणि तीर्थानि संति तावन्महीतले ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003067055, "chapter_id": 23067, "verse_number": "४-१-५६", "content_sanskrit": "ध्रुवं तत्र मृतः पापी मुक्तो याति हरेः पदम् ।\nतथैव ज्ञानगंगायामंते कृष्णस्मृतौ यथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003067056, "chapter_id": 23067, "verse_number": "४-१-५७", "content_sanskrit": "तुलसीकानने गोष्ठे श्रीकृष्णमंदिरे परे। ।\nवृंदारण्ये हरिद्वारे तीर्थेष्वन्येषु वा यथा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003067057, "chapter_id": 23067, "verse_number": "४-१-५८", "content_sanskrit": "पापानि पापिनां यांति तीर्थस्नानावगाहनात् ।\nतेषां पापानि नश्यंति वैष्णवस्पर्शवायुना ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003067058, "chapter_id": 23067, "verse_number": "४-१-५९", "content_sanskrit": "न हि स्थातुं शक्नुवंति पापान्येव कृतानि च ।\nज्वलदग्नौ यथा क्षिप्रं शुष्काणि हि तृणानि च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003067059, "chapter_id": 23067, "verse_number": "४-१-६०", "content_sanskrit": "भक्तं वर्त्मनि गच्छंतं ये ये पश्यंति मानवाः। ।\nसप्तजन्मार्जिताघानि तेषां नश्यंति निश्चितम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003067060, "chapter_id": 23067, "verse_number": "४-१-६१", "content_sanskrit": "ये निंदंति हृषीकेशं तद्भक्तं पुण्यरूपिणम् ।\nशतजन्मार्जितं पुण्यं तेषां नश्यति निश्चित म्६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003067061, "chapter_id": 23067, "verse_number": "४-१-६२", "content_sanskrit": "ते पच्यंते महाघोरे कुंभीपाके भयानके ।\nभक्षिताः कीटसंघेन यावच्चंद्रदिवाकरौ ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003067062, "chapter_id": 23067, "verse_number": "४-१-६३", "content_sanskrit": "तस्य दर्शनमात्रेण पुण्यं नश्यति निश्चितम् ।\nगंगां स्नात्वा रविं नत्वा तदा विद्वान्विशुध्यति ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003067063, "chapter_id": 23067, "verse_number": "४-१-६४", "content_sanskrit": "वैष्णवस्पर्शमात्रेण मुक्तो भवति पातकी ।\nतस्य पापानि हंत्येव स्वांतःस्थो मधुसूदनः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003067064, "chapter_id": 23067, "verse_number": "४-१-६५", "content_sanskrit": "इत्येवं कथितो विप्र विष्णुवैष्णवयोर्गुणः ।\nअधुना श्रीहरेर्जन्म निबोध कथयामि ते ॥६५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]