[{"id": 7002135000, "chapter_id": 22135, "verse_number": "१८०-१", "content_sanskrit": "पञ्चमीव्रतानि ।\nअग्निरुवाच ।\nपञ्चमीव्रतकं वक्ष्ये आरोग्यस्वर्गमोक्षदं ।\nनभोनभस्याश्विने च कार्त्तिके शुक्लपक्षके ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002135001, "chapter_id": 22135, "verse_number": "१८०-२", "content_sanskrit": "वासुकिस्तक्षकः पूज्यः कालीयो मणिभद्रकः ।\nऐरावतो धृतराष्ट्रः कर्कोटकधनञ्जयौ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002135002, "chapter_id": 22135, "verse_number": "१८०-३", "content_sanskrit": "एते प्रयच्छन्त्यभयमायुर्विद्यायशः श्रियम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]