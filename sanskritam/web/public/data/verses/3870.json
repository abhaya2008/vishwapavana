[{"id": 2133033, "chapter_id": 3870, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2133034, "chapter_id": 3870, "verse_number": "१", "content_sanskrit": "धुन्धुर्नाम महाराज तयोः पुत्रो महाद्युतिः ।\nस तपोऽतप्यत महत् महावीर्यपराक्रमः ।\nअतिष्ठदेकपादेन कृशो धमनिसन्ततः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2133035, "chapter_id": 3870, "verse_number": "२", "content_sanskrit": "तस्मै ब्रह्मा ददौ प्रीतो वरं वव्रे स च प्रभुम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2133036, "chapter_id": 3870, "verse_number": "", "content_sanskrit": "धुन्धुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2133037, "chapter_id": 3870, "verse_number": "३", "content_sanskrit": "देवदानवयक्षाणां सर्पगन्धर्वरक्षसाम् ।\nअवध्योऽहं भवेयं वै वर एष वृतो मया\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2133038, "chapter_id": 3870, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2133039, "chapter_id": 3870, "verse_number": "४", "content_sanskrit": "एवं भवतु गच्छेति तमुवाच पितामहः ।\nस एवमुक्तस्तत्पादौ मूर्ध्ना स्पृश्य जगाम ह \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2133040, "chapter_id": 3870, "verse_number": "५", "content_sanskrit": "स तु धुन्धुर्वरं लब्ध्वा महावीर्यपराक्रमः ।\nअनुस्मरन् पितृवधं द्रुतं विष्णुमुपागमत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2133041, "chapter_id": 3870, "verse_number": "६", "content_sanskrit": "स तु देवान् सगन्धर्वान् जित्वा धुन्धुरमर्षणः ।\nबबाध सर्वानसकृद् विष्णुं देवांश्च वै भृशम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2133042, "chapter_id": 3870, "verse_number": "७", "content_sanskrit": "समुद्रे वालुकापूर्णे उज्जानक इति स्मृते ।\nआगम्य च स दुष्टात्मा तं देशं भरतर्षभ।\nबाधते स्म परं शक्त्या तमुत्तङ्काश्रमं विभो\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2133043, "chapter_id": 3870, "verse_number": "८", "content_sanskrit": "अन्तर्भूमिगतस्तत्र वालुकान्तर्हितस्तथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2133044, "chapter_id": 3870, "verse_number": "९", "content_sanskrit": "मधुकैटभयोः पुत्रो धुन्धुर्भीमपराक्रमः ।\nशेते लोकविनाशाय तपोबलमुपाश्रितः ।\nउत्तङ्कस्याश्रमाभ्याशे निःश्वसन् पावकार्चिषः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2133045, "chapter_id": 3870, "verse_number": "१०", "content_sanskrit": "एतस्मिन्नेव काले तु राजा सबलवाहनः ।\nकुवलाश्वो नरपतिरन्वितो बलशालिनाम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2133046, "chapter_id": 3870, "verse_number": "११", "content_sanskrit": "सहस्रैरेकविंशत्या पुत्राणामरिमर्दनः ।\nप्रायादुदङ्कसहितो धुन्धोस्तस्य वधाय वै\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2133047, "chapter_id": 3870, "verse_number": "१२", "content_sanskrit": "तमाविशत् ततो विष्णुर्भगवांस्तेजसा प्रभुः ।\nउत्तङ्कस्य नियोगेन लोकानां हितकाम्यया\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2133048, "chapter_id": 3870, "verse_number": "१३", "content_sanskrit": "तस्मिन् प्रयाते दुर्धर्षे दिवि शब्दो महानभूत् ।\nएष श्रीमानवध्योऽद्य धुन्धुमारो भविष्यति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2133049, "chapter_id": 3870, "verse_number": "१४", "content_sanskrit": "दिव्यैश्च पुष्पैस्तं देवाः समन्तात् पर्यवारयन् ।\nदेवदुन्दुभयश्चापि नेदुः स्वयमनीरिताः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2133050, "chapter_id": 3870, "verse_number": "१५", "content_sanskrit": "शीतश्च वायुः प्रववौ प्रयाणे तस्य धीमतः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2133051, "chapter_id": 3870, "verse_number": "१६", "content_sanskrit": "विपांसुलां महीं कुर्वन् ववर्ष च सुरेश्वरः ।\nप्रदक्षिणाश्चाप्यभवन् वन्यस्तं समृगद्विजाः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2133052, "chapter_id": 3870, "verse_number": "१७", "content_sanskrit": "अन्तरिक्षे विमानादि देवतानां युधिष्ठिर ।\nतत्रैव समदृश्यन्त धुन्धुर्यत्र महासुरः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2133053, "chapter_id": 3870, "verse_number": "१८", "content_sanskrit": "कुवलाश्वस्य धुन्धोश्च युद्धकौतूहलान्विताः ।\nदेवगन्धर्वसहिताः समवैक्षन् महर्षयः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2133054, "chapter_id": 3870, "verse_number": "१९", "content_sanskrit": "नारायणेन कौरव्य तेजसाऽऽप्यायितस्तदा ।\nस गतो नृपतिः क्षिप्रं पुत्रैस्तैः सर्वतोदिशम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2133055, "chapter_id": 3870, "verse_number": "२०", "content_sanskrit": "अर्णवं खानयामास कुवलाश्वो महीपतिः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2133056, "chapter_id": 3870, "verse_number": "२१", "content_sanskrit": "कुवलाश्वस्य पुत्रैश्च तस्मिन् वै वालुकार्णवे ।\nसप्तभिर्दिवसैः खात्वा दृष्टो धुन्धुर्महाबलः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2133057, "chapter_id": 3870, "verse_number": "२२", "content_sanskrit": "आसीद् घोरं वपुस्तस्य वालुकान्तर्हितं महत् ।\nदीप्यमानं यथा सूर्यस्तेजसा भरतर्षभ\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2133058, "chapter_id": 3870, "verse_number": "२३", "content_sanskrit": "ततो धुन्धुर्महाराज दिशमावृत्य पश्चिमाम् ।\nसुप्तोऽभूद् राजशार्दूल कालानलसमद्युतिः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2133059, "chapter_id": 3870, "verse_number": "२४", "content_sanskrit": "कुवलाश्वस्य पुत्रैस्तु सर्वतः परिवारितः ।\nअभिद्रुतः शरैस्तीक्ष्णैर्गदाभिर्मुसलैरपि\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2133060, "chapter_id": 3870, "verse_number": "२५", "content_sanskrit": "पट्टिसैः परिघैः प्रासैः खड्गैश्च विमलैः शितैः ।\nस वध्यमानः सङ्क्रुद्धः समुत्तस्थौ महाबलः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2133061, "chapter_id": 3870, "verse_number": "२६", "content_sanskrit": "क्रुद्धश्चाभक्षयत् तेषां शस्त्राणि विविधानि च ।\nआस्याद् वमन् पावकं स संवर्तकसमं तदा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2133062, "chapter_id": 3870, "verse_number": "२७", "content_sanskrit": "तान् सर्वान् नृपतेः पुत्रानदहत् स्वेन तेजसा ।\nमुखजेनाग्निना क्रुद्धो लोकानुद्वर्तयन्निव \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2133063, "chapter_id": 3870, "verse_number": "२८", "content_sanskrit": "क्षणेन राजशार्दूल पुरेव कपिलः प्रभुः ।\nसगरस्यात्मजान् क्रुद्धस्तदद्भुतमिवाभवत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2133064, "chapter_id": 3870, "verse_number": "२९", "content_sanskrit": "तेषु क्रोधाग्निदग्धेषु तदा भरतसत्तम ।\nतं प्रबुद्धं महात्मानं कुम्भकर्णमिवापरम् ।\nआससाद महातेजाः कुवलाश्वो महीपतिः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2133065, "chapter_id": 3870, "verse_number": "३०", "content_sanskrit": "तस्य वारि महाराज सुस्राव बहु देहतः ।\nतदापीय ततस्तेजो राजा वारिमयं नृप\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2133066, "chapter_id": 3870, "verse_number": "३१", "content_sanskrit": "योगी योगेन वह्निं च शमयामास वारिणा ।\nब्रह्मास्त्रेण च राजेन्द्र दैत्यं क्रूरपराक्रमम्। \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2133067, "chapter_id": 3870, "verse_number": "३२", "content_sanskrit": "ददाह भरतश्रेष्ठ सर्वलोकभवाय वै\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2133068, "chapter_id": 3870, "verse_number": "३३", "content_sanskrit": "सोऽस्त्रेण दग्ध्वा राजर्षिः कुवलाश्वो महासुरम् ।\nसुरशत्रुममित्रघ्नः त्रैलोक्येश इवापरः ।\nधुन्धोर्वधात् तदा राजा कुवलाश्वो महामनाः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2133069, "chapter_id": 3870, "verse_number": "३४", "content_sanskrit": "प्रीतैश्च त्रिदशैः सर्वैर्महर्षिसहितैस्तदा ।\nवरं वृणीष्वेत्युक्तः स प्राञ्जलिः प्रणतस्तदा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2133070, "chapter_id": 3870, "verse_number": "३५", "content_sanskrit": "अतीव मुदितो राजन्निदं वचनमब्रवीत् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2133071, "chapter_id": 3870, "verse_number": "३६", "content_sanskrit": "दद्यां वित्तं द्विजाग्र्येभ्यः शत्रूणां चापि दुर्जयः ।\nसख्यं च विष्णुना मे स्याद् भूतेष्वद्रोह एव च ।\nधर्मे रतिश्च सततं स्वर्गे वासस्तथाऽक्षयः \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2133072, "chapter_id": 3870, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2133073, "chapter_id": 3870, "verse_number": "३७", "content_sanskrit": "तथास्त्विति ततो देवैः प्रीतैरुक्तः स पार्थिवः ।\nऋषिभिश्च सगन्धर्वैरुत्तङ्केन च धीमता\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2133074, "chapter_id": 3870, "verse_number": "३८", "content_sanskrit": "सम्भाष्य चैनं विविधैराशीर्वादैस्ततो नृप ।\nदेवा महर्षयश्चापि स्वानि स्थानानि भेजिरे\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2133075, "chapter_id": 3870, "verse_number": "३९", "content_sanskrit": "तस्य पुत्रास्त्रयः शिष्टा युधिष्ठिर तदाभवन् ।\nदृढाश्वः कपिलाश्वश्च चन्द्राश्वश्चैव भारत\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2133076, "chapter_id": 3870, "verse_number": "४०", "content_sanskrit": "तेभ्यः परम्परा राजन्निक्ष्वाकूणां महात्मनाम् ।\nवंशस्य सुमहाभाग राज्ञाममिततेजसाम् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2133077, "chapter_id": 3870, "verse_number": "४१", "content_sanskrit": "एवं स निहतस्तेन कुवलाश्वेन सत्तम ।\nधुन्धुर्नाम महादैत्यो मधुकैटभयोः सुतः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2133078, "chapter_id": 3870, "verse_number": "४२", "content_sanskrit": "कुवलाश्वश्च नृपतिर्धुन्धुमार इति स्मृतः ।\nनाम्ना च गुणसंयुक्तस्तदाप्रभृति सोऽभवत्\t॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2133079, "chapter_id": 3870, "verse_number": "४३", "content_sanskrit": "एतत् ते सर्वमाख्यातं यन्मां त्वं परिपृच्छसि ।\nधौन्धुमारमुपाख्यानं प्रथितं यस्य कर्मणा\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2133080, "chapter_id": 3870, "verse_number": "४४", "content_sanskrit": "इदं तु पुण्यमाख्यानं विष्णोः समनुकीर्तनम् ।\nशृणुयाद् यः स धर्मात्मा पुत्रवांश्च भवेन्नरः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2133081, "chapter_id": 3870, "verse_number": "४५", "content_sanskrit": "आयुष्मान् भूतिमांश्चैव श्रुत्वा भवति पर्वसु ।\nन च व्याधिभयं किञ्चित्प्राप्नोति विगतज्वरः \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2133082, "chapter_id": 3870, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकनवत्यधिकशततमोऽध्यायः ॥१९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2133083, "chapter_id": 3870, "verse_number": "१६", "content_sanskrit": "॥ इति मार्कण्डेयसमस्यापर्वणि षोडशोऽध्यायः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2133084, "chapter_id": 3870, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]