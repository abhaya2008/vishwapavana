[{"id": 2012088, "chapter_id": 1247, "verse_number": "१-२४८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012089, "chapter_id": 1247, "verse_number": "१-२४८-१", "content_sanskrit": "इन्द्रप्रस्थे वसन्तस्ते जघ्रुरन्यान्नराधिपान्।\nशासनाद्धृतराष्ट्रस्य राज्ञः शान्तनवस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012090, "chapter_id": 1247, "verse_number": "१-२४८-२", "content_sanskrit": "आश्रित्य धर्मराजानं सर्वलोकोऽवसत्सुखम्।\nपुण्यलक्षणकर्माणं स्वदेहमिव देहिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012091, "chapter_id": 1247, "verse_number": "१-२४८-३", "content_sanskrit": "स समं धर्मकामार्थान्सिषेवे भरतर्षभ।\nत्रीनिवात्मसमान्बन्धून्नीतिमानिव मानयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012092, "chapter_id": 1247, "verse_number": "१-२४८-४", "content_sanskrit": "तेषां समविभक्तानां क्षितौ देहवतामिव।\nबभौ धर्मार्थकामानां चतुर्थ इव पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012093, "chapter_id": 1247, "verse_number": "१-२४८-५", "content_sanskrit": "अध्येतारं परं वेदान्प्रयोक्तारं महाध्वरे।\nरक्षितारं शुभाँल्लोकाँल्लोभिरे तं जनाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012094, "chapter_id": 1247, "verse_number": "१-२४८-६", "content_sanskrit": "अधिष्ठानवती लक्ष्मीः परायणवती मतिः।\nवर्धमानोऽखिलो धर्मस्तेनासीत्पृथिवीक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012095, "chapter_id": 1247, "verse_number": "१-२४८-७", "content_sanskrit": "भ्रातृभिः सहितौ राजा चतुर्भिरधिकं बभौ।\nप्रयुज्यमानैर्विततो वेदैरिव महाध्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012096, "chapter_id": 1247, "verse_number": "१-२४८-८", "content_sanskrit": "तं तु धौम्यादयो विप्राः परिवार्योपतस्थिरे।\nबृहस्पतिसमा मुख्याः प्रजापतिमिवामराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012097, "chapter_id": 1247, "verse_number": "१-२४८-९", "content_sanskrit": "धर्मराजे ह्यतिप्रीत्या पूर्णचन्द्र इवामले।\nप्रजानां रेमिरे तुल्यं नेत्राणि हृदयानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012098, "chapter_id": 1247, "verse_number": "१-२४८-१०", "content_sanskrit": "न तु केवलदैवेन प्रजा भावेन रेमिरे।\nयद्बभूव मनःकान्तं कर्मणा स चकार तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012099, "chapter_id": 1247, "verse_number": "१-२४८-११", "content_sanskrit": "न ह्ययुक्तं न चासत्यं नासह्यं न च वाऽप्रियम्।\nभाषितं चारुभाषस्य जज्ञे पार्थस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012100, "chapter_id": 1247, "verse_number": "१-२४८-१२", "content_sanskrit": "स हि सर्वस्य लोकस्य हितमात्मन एव च।\nचिकीर्षन्सुमहातेजा रेमे भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012101, "chapter_id": 1247, "verse_number": "१-२४८-१३", "content_sanskrit": "तथा तु मुदिताः सर्वे पाण्डवा विगतज्वराः।\nअवसन्पृथिवीपालाँस्तापयन्तः स्वतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012102, "chapter_id": 1247, "verse_number": "१-२४८-१४", "content_sanskrit": "ततः कतिपयाहस्य बीभत्सुः कृष्णमब्रवीत्।\nउष्णानि कृष्ण वर्तन्ते गच्छावो यमुनां प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012103, "chapter_id": 1247, "verse_number": "१-२४८-१५", "content_sanskrit": "सुहृज्जनवृतौ तत्र विहृत्य मधुसूदन।\nसायाह्ने पुनरेष्यावो रोचतां ते जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012104, "chapter_id": 1247, "verse_number": "१-२४८-१६x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012105, "chapter_id": 1247, "verse_number": "१-२४८-१६", "content_sanskrit": "कुन्तीमातर्ममाप्येतद्रोचते यद्वयं जले।\nसुहृज्जनवृताः पार्थ विहरेम यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012106, "chapter_id": 1247, "verse_number": "१-२४८-१७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012107, "chapter_id": 1247, "verse_number": "१-२४८-१७", "content_sanskrit": "आमन्त्र्य तौ धर्मराजमनुज्ञाप्य च भारत।\nजग्मतुः पार्थगोविन्दौ सुहृज्जनवृतौ ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012108, "chapter_id": 1247, "verse_number": "१-२४८-१८", "content_sanskrit": "विहरन्खाण्डवप्रस्थे काननेषु च माधवः।\nपुष्पितोपवनां दिव्यां ददर्श यमुनां नदीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012109, "chapter_id": 1247, "verse_number": "१-२४८-१९", "content_sanskrit": "तस्यास्तीरे वनं दिव्यं सर्वर्तुसुमनोहरम्।\nआलयं सर्वभूतानां खाण्डवं खड्गचर्मभृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012110, "chapter_id": 1247, "verse_number": "१-२४८-२०", "content_sanskrit": "ददर्श कृत्स्नं तं देशं सहितः सव्यसाचिना।\nऋक्षगोमायुशार्दूलवृककृष्णमृगान्वितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012111, "chapter_id": 1247, "verse_number": "१-२४८-२१", "content_sanskrit": "शाखामृगगणैर्जुष्टं गजद्वीपिनिषेवितम्।\nशकबर्हिणदात्यूहहंससारसनादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012112, "chapter_id": 1247, "verse_number": "१-२४८-२२", "content_sanskrit": "नानामृगसहस्रैश्च पक्षिभिश्च समावृतम्।\nमानार्हं तच्च सर्वेषां देवदानवरक्षसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012113, "chapter_id": 1247, "verse_number": "१-२४८-२३", "content_sanskrit": "आलयं पन्नगेन्द्रस्य तक्षकस्य महात्मनः।\nवेणुशाल्मलिबिल्वातिमुक्तजंब्वाम्रचम्पकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2012114, "chapter_id": 1247, "verse_number": "१-२४८-२४", "content_sanskrit": "अङ्कोलपनसाश्वत्थतालजम्बीरवञ्जुलैः।\nएकपद्मकतालैश्च शतशश्चैव रौहिणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2012115, "chapter_id": 1247, "verse_number": "१-२४८-२५", "content_sanskrit": "नानावृक्षैः समायुक्तं नानागुल्मसमावृतम्।\nवेत्रकीचकसंयुक्तमाशीविषनिषेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2012116, "chapter_id": 1247, "verse_number": "१-२४८-२६", "content_sanskrit": "विगतार्कं महाभोगविततद्रुमसङ्कटम्।\nव्यालदंष्ट्रिगणाकीर्णं वर्जितं सर्वमानुषैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2012117, "chapter_id": 1247, "verse_number": "१-२४८-२७", "content_sanskrit": "रक्षसां भुजगेन्द्राणां पक्षिणां च महालयम्।\nखाण्डवं सुमहाप्राज्ञः सर्वलोकविभागवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2012118, "chapter_id": 1247, "verse_number": "१-२४८-२८", "content_sanskrit": "दृष्टवान्सर्वलोकेश अर्जुनेन समन्वितः।\nपीताम्बरधरो देवस्तद्वनं बहुधा चरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2012119, "chapter_id": 1247, "verse_number": "१-२४८-२९", "content_sanskrit": "सद्रुमस्य सयक्षस्य सभूतगणपक्षिणः।\nखाण्डवस्य विनाशं तं ददर्श मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2012120, "chapter_id": 1247, "verse_number": "१-२४८-३०", "content_sanskrit": "विहारदेशं संप्राप्य नानाद्रुममनुत्तमम्।\nगृहैरुच्चावचैर्युक्तं पुरन्दरपुरोपमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2012121, "chapter_id": 1247, "verse_number": "१-२४८-३१", "content_sanskrit": "भक्ष्यैर्भोज्यैश्च पेयैश्च रसवद्बिर्महाधनैः।\nमाल्यैश्च विविधैर्गन्धैस्तथा वार्ष्मेयपाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2012122, "chapter_id": 1247, "verse_number": "१-२४८-३२", "content_sanskrit": "तदा विविशतुः पूर्णं रत्नैरुच्चावचैः शुभैः।\nयथोपजोषं सर्वश्च जनश्चिक्रीड भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2012123, "chapter_id": 1247, "verse_number": "१-२४८-३३", "content_sanskrit": "स्त्रियश्च विपुलश्रोष्ण्यश्चारुपीनपयोधराः।\nमदस्खलितगामिन्यश्चिक्रीडुर्वामलोचनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2012124, "chapter_id": 1247, "verse_number": "१-२४८-३४", "content_sanskrit": "वने काश्चिज्जले काश्चित्काश्चिद्वेश्मसु चाङ्गनाः।\nयथादेशं यथाप्रीति चिक्रीडुः पार्थकृष्णयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2012125, "chapter_id": 1247, "verse_number": "१-२४८-३५", "content_sanskrit": "वासुदेवप्रिया नित्यं सत्यभामा च भामिनी।\nद्रौपदी च सुभद्रा च वासांस्याभरणानि च।\nप्रायच्छन्त महाराज स्त्रीणां ताः स्म मदोत्कटाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2012126, "chapter_id": 1247, "verse_number": "१-२४८-३६", "content_sanskrit": "काश्चित्प्रहृष्टा ननृतुश्चुक्रुशुश्च तथा पराः।\nजहसुश्च परा नार्यः पपुश्चान्या वरासवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2012127, "chapter_id": 1247, "verse_number": "१-२४८-३७", "content_sanskrit": "रुरुधुश्चापरास्तत्र प्रजघ्नुश्च परस्परम्।\nमन्त्रयामासुरन्याश्च रहस्यानि परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2012128, "chapter_id": 1247, "verse_number": "१-२४८-३८", "content_sanskrit": "वेणुवीणामृदङ्गानां मनोज्ञानां च सर्वशः।\nशब्देन पूर्यते हर्म्यं तद्वनं सुमहर्द्धिमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2012129, "chapter_id": 1247, "verse_number": "१-२४८-३९", "content_sanskrit": "तस्मिंस्तदा वर्तमानो कुरुदाशार्हनन्दनौ।\nसमीपं जग्मतुः कंचिदुद्देशं सुमनोहरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2012130, "chapter_id": 1247, "verse_number": "१-२४८-४०", "content_sanskrit": "तत्र गत्वा महात्मानौ कृष्णौ परपुरञ्जयौ।\nमहार्हासनयो राजंस्ततस्तौ सन्निषीदतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2012131, "chapter_id": 1247, "verse_number": "१-२४८-४१", "content_sanskrit": "तत्र पूर्वव्यतीतानि विक्रान्तानीतराणि च।\nबहूनि कथयित्वा तौ रेमाते पार्थमाधवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2012132, "chapter_id": 1247, "verse_number": "१-२४८-४२", "content_sanskrit": "तत्रोपविष्टौ मुदितौ नाकपृष्ठेऽश्विनाविव।\nअभ्यागच्छत्तदा विप्रो वासुदेवधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2012133, "chapter_id": 1247, "verse_number": "१-२४८-४३", "content_sanskrit": "बृहच्छालप्रतीकाशः प्रतप्तकनकप्रभः।\nहरिपिङ्गोज्ज्वलश्मश्रुः प्रमाणायामतः समः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2012134, "chapter_id": 1247, "verse_number": "१-२४८-४४", "content_sanskrit": "तरुणादित्यसङ्काशश्चीरवासा जटाधरः।\nपद्मपत्राननः पिङ्गस्तेजसा प्रज्वलन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2012135, "chapter_id": 1247, "verse_number": "१-२४८-४५", "content_sanskrit": "जगाम तौ कृष्णपार्थौ दिधक्षुः खाण्डवं वनम्।\nउपसृष्टं तु तं कृष्णो भ्राजमानं द्विजोत्तमम्।\nअर्जनो वासुदेवश्च तूर्णमुत्पत्य तस्थतुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2012136, "chapter_id": 1247, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि खाण्डवदाहपर्वणि अष्टचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]