[{"id": 7003171000, "chapter_id": 23171, "verse_number": "४-१०७-१", "content_sanskrit": "अथ सप्ताधिकशततमोऽध्यायः ।\nनारायण उवाच ।\nअथ कोपपीतश्च बलदेवो महाबलः ।\nहलेन रुक्मियानं च बभञ्ज मुनिपुंगव ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003171001, "chapter_id": 23171, "verse_number": "४-१०७-२", "content_sanskrit": "घोटकान्सारथिं चैव निहत्य जगतीपतिः ।\nभुमिष्ठं चापि पापिष्ठं रुक्मिं हन्तुं जगाम सः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003171002, "chapter_id": 23171, "verse_number": "४-१०७-३", "content_sanskrit": "रुक्मी च शरजालेन वारयामास लीलया ।\nनागास्त्रं योजयामास बद्धुं हलिनमीश्वरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003171003, "chapter_id": 23171, "verse_number": "४-१०७-४", "content_sanskrit": "नागास्त्रं गारुडेनैव संजहार हली स्वयम् ।\nजग्राह कोपाद्रुक्मी च परं पाशुपतं मुने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003171004, "chapter_id": 23171, "verse_number": "४-१०७-५", "content_sanskrit": "अव्यर्थं वैरिमर्द च शतसूर्यसमप्रभम् ।\nअभितो हलिना रुक्मी जृम्भणास्त्रेण जृम्भितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003171005, "chapter_id": 23171, "verse_number": "४-१०७-६", "content_sanskrit": "भूमिष्ठः स्थाणुमद्रुक्मी निद्रास्त्रेणैव निद्रितः ।\nशाल्वस्तं निद्रितं दृष्ट्वा शतबाणान्मुमोच तम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003171006, "chapter_id": 23171, "verse_number": "४-१०७-७", "content_sanskrit": "शैलवृष्टिं शिलावृष्टिं जलवृष्टिं चकार सः ।\nज्वलदङ्गारवृष्टिं च शरवृष्टिं चकार ह ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003171007, "chapter_id": 23171, "verse_number": "४-१०७-८", "content_sanskrit": "बलाच्चास्त्रेण सर्वाणि वारयामास लाङ्गली ।\nहलेन तद्रथं चूर्ण चकार रणमध्यतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003171008, "chapter_id": 23171, "verse_number": "४-१०७-९", "content_sanskrit": "घोटकान्सारथिं चैव जघान चैव लीलया ।\nकोपाद्बलेन तं हन्तुं वाग्बभूवाशरीरिणी ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003171009, "chapter_id": 23171, "verse_number": "४-१०७-१०", "content_sanskrit": "त्यज शाल्वं कृष्णवध्यं तव किं पौरुषं रणे ।\nयस्य मूर्ध्नि च ब्रह्माण्डं शूर्पे च सर्षपे यथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003171010, "chapter_id": 23171, "verse_number": "४-१०७-११", "content_sanskrit": "तच्छ्रुत्वा बलदेवश्च हलेन तस्य मस्तकम् ।\nचकार चूर्ण व्यथितः पपात रणमूर्धनि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003171011, "chapter_id": 23171, "verse_number": "४-१०७-१२", "content_sanskrit": "शाल्वस्य पतनं दृष्ट्वा शिशुपालो महाबली ।\nचकार शरवृष्टिं च जलवृष्टिं यथा भुवि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003171012, "chapter_id": 23171, "verse_number": "४-१०७-१३", "content_sanskrit": "हली तस्य रथं चूर्ण चकार लाङ्गलेन च ।\nअर्धचन्द्रेण तद्वाणान्वारयामास लीलया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003171013, "chapter_id": 23171, "verse_number": "४-१०७-१४", "content_sanskrit": "तं हन्तुं शंकरः साक्षान्निषेधं च चकार तम् ।\nकृष्णवध्यं त्यज बल पार्षदप्रवरं हरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003171014, "chapter_id": 23171, "verse_number": "४-१०७-१५", "content_sanskrit": "दन्तवक्त्रस्य दन्तं च बभञ्ज स हलेन च ।\nसुप्रवृत्तस्य युद्धेन ते सर्वे जहसुश्च तम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003171015, "chapter_id": 23171, "verse_number": "४-१०७-१६", "content_sanskrit": "बलस्य विक्रमं दृष्ट्वा सर्वे वीराः पलायिताः ।\nचक्रुः प्रवेशनं सर्वे कुण्डिनं वरयात्रिकाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003171016, "chapter_id": 23171, "verse_number": "४-१०७-१७", "content_sanskrit": "एतस्मिन्नन्तरे तत्र शतानन्दो महामुनिः ।\nकोटिभिर्मुनिभिः सार्धमाजगाम हरेः पुरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003171017, "chapter_id": 23171, "verse_number": "४-१०७-१८", "content_sanskrit": "पुरं प्रवेशयामास शतद्वारं च दुर्गमम् ।\nअगम्यं चापि शत्रूणां मित्राणा च सुखप्रदम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003171018, "chapter_id": 23171, "verse_number": "४-१०७-१९", "content_sanskrit": "देवकन्या नागकन्या राजकन्यास्तथैव च ।\nमुनिकन्या वरं द्रष्टुं सस्मिताश्च समाययुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003171019, "chapter_id": 23171, "verse_number": "४-१०७-२०", "content_sanskrit": "ददृशुर्योषितः सर्वा निमेषरहितेन च ।\nप्रसन्नं कारयामास सस्मितश्चन्द्रशेखरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003171020, "chapter_id": 23171, "verse_number": "४-१०७-२१", "content_sanskrit": "रत्नेन्द्रसारनिर्माणरथस्थं परमेश्वरम् ।\nसर्वेषां परमात्मानं भक्तानुग्रहविग्रहम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003171021, "chapter_id": 23171, "verse_number": "४-१०७-२२", "content_sanskrit": "नवीनजलदश्यामं शोभितं पीतवाससा ।\nयन्दनोक्षितसर्वाङ्गं वनमालाविभूषितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003171022, "chapter_id": 23171, "verse_number": "४-१०७-२३", "content_sanskrit": "रत्नकेयूरवलयरत्नमालाकुलोज्ज्वलम् ।\nरत्नकुण्डलयुग्मेन गण्डस्थलविराचितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003171023, "chapter_id": 23171, "verse_number": "४-१०७-२४", "content_sanskrit": "रत्नेन्द्रसारनिर्माणक्वणन्मञ्जीररञ्जितम् ।\nसस्मितं मुरलीहस्तं पश्यन्तं रत्नदर्पणम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003171024, "chapter_id": 23171, "verse_number": "४-१०७-२५", "content_sanskrit": "सप्तभिः पार्षदैर्गोपैः सेवितं श्वेतचामरैः ।\nनवयौवनसंपन्नं शरत्कमललोचनम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003171025, "chapter_id": 23171, "verse_number": "४-१०७-२६", "content_sanskrit": "शरत्पूर्णेन्दुतुल्यास्यं भक्तानुग्रहकारकम् ।\nकोटिकन्दर्पसौन्दर्यं सत्यं नित्यं सनातनम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003171026, "chapter_id": 23171, "verse_number": "४-१०७-२७", "content_sanskrit": "तीर्थपूतं कीर्तिपूतं ब्रह्मेशशेषवन्दितम् ।\nपरम्ह्नादकं रूपं कौटिचन्द्रसमप्रभम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003171027, "chapter_id": 23171, "verse_number": "४-१०७-२८", "content_sanskrit": "ध्यानासाध्यं दुराराध्यं परमं प्रकृतेः परम् ।\nदूर्वया पट्टसूत्रं च रत्नेन्द्रसारदर्पणम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003171028, "chapter_id": 23171, "verse_number": "४-१०७-२९", "content_sanskrit": "दधानं कर्तृकासार्ध कदल्याः स्फुटमञ्जरीम् ।\nचूडां त्रिविक्रमाकारां मालतीमाल्यभूषितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003171029, "chapter_id": 23171, "verse_number": "४-१०७-३०", "content_sanskrit": "पुष्पं नारीप्रदत्तं च मुकुटं मस्तकोजज्ववलम् ।\nदृष्ट्वा वरं युवत्यश्च मूर्च्छा संप्रापुरीश्वरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003171030, "chapter_id": 23171, "verse_number": "४-१०७-३१", "content_sanskrit": "रुक्मिणीजीवनं धन्यं श्लाध्यमित्यूचुरीप्सितम् ।\nजामातरं सा ददर्श राज्ञी भीष्मककामिनी ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003171031, "chapter_id": 23171, "verse_number": "४-१०७-३२", "content_sanskrit": "निमेषरहिता तुष्टा प्रसन्नवदनेक्षणा ।\nराजा प्रसन्नवदनः सामात्यः सपुरोहितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003171032, "chapter_id": 23171, "verse_number": "४-१०७-३३", "content_sanskrit": "समागत्य सुरान्विप्रान्भूपांश्च प्रणनाम सः ।\nददौ योग्याश्रमं तेभ्यो भक्ष्यपूर्ण सुधोपमम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003171033, "chapter_id": 23171, "verse_number": "४-१०७-३४", "content_sanskrit": "दिवानिशं चाप्युवाच दीयतां दीयतामिति ।\nसुखं निनाय रजनीं देवैश्च बान्धवैः सह ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003171034, "chapter_id": 23171, "verse_number": "४-१०७-३५", "content_sanskrit": "वसुदेवः प्रभाते च प्रातःकृत्यं चकार सः ।\nस्नात्वा संध्यादिकं कृत्वा धृत्वा धौते च वाससी ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003171035, "chapter_id": 23171, "verse_number": "४-१०७-३६", "content_sanskrit": "चकार वेदमन्त्रेण शुभाधिवासनं हरेः ।\nसंपूज्य मातृकाः सर्वाः साक्षाच्च सर्वदेवताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003171036, "chapter_id": 23171, "verse_number": "४-१०७-३७", "content_sanskrit": "प्रदाय वसुधारां च वृद्धिश्राद्धादिकं तथा ।\nप्राह्मणान्भोजयामास देवांश्च बान्धवांस्तथा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003171037, "chapter_id": 23171, "verse_number": "४-१०७-३८", "content_sanskrit": "वाद्यं च वादयामास कारयामास मङ्गलम् ।\nसुवेषं कारयामास वरस्यापि प्रशंसितम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003171038, "chapter_id": 23171, "verse_number": "४-१०७-३९", "content_sanskrit": "सज्जं च कारयामास नरयानं सुशोभनम् ।\nएवं राजा भीष्मकश्च विवाहार्हं च मङ्गलम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003171039, "chapter_id": 23171, "verse_number": "४-१०७-४०", "content_sanskrit": "पुरोहितैर्वेदमन्त्रैः सर्व कर्म चकार सः ।\nमणिरत्नं धनं चापि मुक्तामाणिक्यहीरकम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003171040, "chapter_id": 23171, "verse_number": "४-१०७-४१", "content_sanskrit": "भक्ष्यद्रव्यं च वस्त्रं चाप्युपहारमनुत्तमम् ।\nभट्टेम्यो ब्राह्मणेभ्योऽपि भिक्षुकेभ्यो ददौ मुदा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003171041, "chapter_id": 23171, "verse_number": "४-१०७-४२", "content_sanskrit": "वाद्यं च वादयामास कारयामास मङ्गलम् ।\nसुवेषं कारयामास रुक्मिण्याश्च मनोहरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003171042, "chapter_id": 23171, "verse_number": "४-१०७-४३", "content_sanskrit": "राज्ञीभिर्मुनिपत्नीभिर्विधानं च यथोचितम् ।\nततः शुभे क्षणे प्राप्ते माहेन्द्रे परमोदये ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003171043, "chapter_id": 23171, "verse_number": "४-१०७-४४", "content_sanskrit": "विवाहोचितलग्ने च लग्नाधिपतिसंयुते ।\nसद्ग्रहेक्षणशुद्धे चाप्यसतां दृष्टिवर्जिते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003171044, "chapter_id": 23171, "verse_number": "४-१०७-४५", "content_sanskrit": "शुभक्षणे सुभर्क्षे च विशुद्धे चन्द्रतारयोः ।\nवेधदोषादिरहिते शलाकादिविवर्जिते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003171045, "chapter_id": 23171, "verse_number": "४-१०७-४६", "content_sanskrit": "दंपत्योः शर्मयोग्ये च परिणामसुखप्रदे ।\nएवंभूते च समये भीष्मकप्राङ्गणं हरिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003171046, "chapter_id": 23171, "verse_number": "४-१०७-४७", "content_sanskrit": "आजगाम सुरैः सार्ध सुनिविप्रपुरोहितैः ।\nज्ञातिभिर्बान्धवैः सार्धं पित्रा मात्रानृपैस्तथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003171047, "chapter_id": 23171, "verse_number": "४-१०७-४८", "content_sanskrit": "गोपालकैः पार्षदैश्च वयस्यैश्च मनोहरैः ।\nभट्टैश्च गणकैर्ज्योतिः शास्त्रज्ञानविशारदैः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003171048, "chapter_id": 23171, "verse_number": "४-१०७-४९", "content_sanskrit": "वाद्यैर्नानाविधैश्चैव नर्तकैर्गायनैस्तथा ।\nनानाशिल्पकरैश्चैव मालाकारैस्तथाऽपरैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003171049, "chapter_id": 23171, "verse_number": "४-१०७-५०", "content_sanskrit": "विद्याधर्यप्सरोभिश्च किन्नरीभिश्च सत्वरम् ।\nस्थलं च ददुशुर्देवा मुनयश्च नृपेश्वराः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003171050, "chapter_id": 23171, "verse_number": "४-१०७-५१", "content_sanskrit": "सर्वे समागता ये च विवाहदर्शनोत्सुकाः ।\nरम्भास्तम्भसहस्रैश्च पट्टसूत्रपरिष्कृतैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003171051, "chapter_id": 23171, "verse_number": "४-१०७-५२", "content_sanskrit": "चम्बकानां चन्दनानां रसालानां च पल्लवैः ।\nमाल्यैर्नानाविधैश्चैव पीतरक्तसितान्वितैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003171052, "chapter_id": 23171, "verse_number": "४-१०७-५३", "content_sanskrit": "परितो मङ्गलघटैः फलपल्लवसंयुतैः ।\nकस्तूरीचन्दनाक्तैश्च कुङ्कुमेन विराजितैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003171053, "chapter_id": 23171, "verse_number": "४-१०७-५४", "content_sanskrit": "पर्णैर्लाजैः फलैः पुष्पैर्दूर्वाभिरुपशोभितैः ।\nमुनिभिर्ब्राह्मणैश्चैव राजेन्द्रैरपि वेष्टितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003171054, "chapter_id": 23171, "verse_number": "४-१०७-५५", "content_sanskrit": "रत्नेन्द्रसारनिर्माणवेदीयुक्तं मनोहरम् ।\nचर्चितं चन्दनस्निग्धैः कस्तूरीकुङ्कुमान्वितैः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003171055, "chapter_id": 23171, "verse_number": "४-१०७-५६", "content_sanskrit": "सुगन्धिशीतमन्दैश्च पवनैः सुरभीकृतम् ।\nरत्नानां च सहस्रैश्च ज्वलितं ज्वलदीप्तकैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003171056, "chapter_id": 23171, "verse_number": "४-१०७-५७", "content_sanskrit": "नानाप्रकारधूपैश्च गन्धद्रव्यैः सुवासतम् ।\nचित्रैर्विचित्रैर्विविधैः शिल्पिनांपुण्यकारिणाम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003171057, "chapter_id": 23171, "verse_number": "४-१०७-५८", "content_sanskrit": "परितः परितश्चैव शोभनार्हैः सुशोभनैः ।\nगन्धर्वाणां च संगीतैमधुरंर्मधुरीकृतम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003171058, "chapter_id": 23171, "verse_number": "४-१०७-५९", "content_sanskrit": "विद्याधरीणांनृत्यैश्च नर्तकीनां च शिल्पिनाम् ।\nतत्र निश्चेष्टचित्रैश्च जनराजिविराजितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003171059, "chapter_id": 23171, "verse_number": "४-१०७-६०", "content_sanskrit": "गुप्तद्वारैर्गवाक्षैश्च युवतीभिश्च वीक्षितम् ।\nमङ्गलेन घटेनैव विधुषा च पुरोधसा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003171060, "chapter_id": 23171, "verse_number": "४-१०७-६१", "content_sanskrit": "कुशहस्तेन भूपेन दानेन दानवस्तुना ।\nदृष्ट्वा च प्राङ्गणं राज्ञो देवा ब्रह्मादयस्तथा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003171061, "chapter_id": 23171, "verse_number": "४-१०७-६२", "content_sanskrit": "अवरुह्य रथात्तूणं तिष्टन्ति प्राङ्गणे मुदा ।\nराजेन्द्रा दानवेन्द्राश्च सुनयः सनकादयः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003171062, "chapter_id": 23171, "verse_number": "४-१०७-६३", "content_sanskrit": "श्रीकृष्णश्चापि भगवान्पार्षदप्रवरैः सह ।\nतान्दृष्ट्वा सहसोत्थाय जवेन भीष्मकस्तथा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003171063, "chapter_id": 23171, "verse_number": "४-१०७-६४", "content_sanskrit": "मूर्घ्ना ववन्दे देवाश्च मुनोन्द्रांश्च नृपांस्तथा ।\nरत्नसिहासनेष्वेव सुरम्येषु पृथवपृथक् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003171064, "chapter_id": 23171, "verse_number": "४-१०७-६५", "content_sanskrit": "क्रमतो वासयामास संपूज्य सादरेण च ।\nराजा तुष्टाव भक्त्या च तान्सर्वान्भक्तिपूर्वकम् ।\nवसुदेवं वासुदेवं साश्रुनेत्रः पुटाञ्जलिः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003171065, "chapter_id": 23171, "verse_number": "४-१०७-६६", "content_sanskrit": "भीष्मक उवाच ।\nअद्य मे सफलं जन्म जीवितं च सुजीवितम् ।\nबभूव जन्मकोटीनां कर्ममूलनिकृन्तनम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003171066, "chapter_id": 23171, "verse_number": "४-१०७-६७", "content_sanskrit": "स्वयं विधाता जगतां प्रदाता सर्वसंपदाम् ।\nस्वप्रे यत्पादपद्मं च द्रष्टुं नैव क्षमः प्रभो ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003171067, "chapter_id": 23171, "verse_number": "४-१०७-६८", "content_sanskrit": "तपसां फरदाता च संस्रष्टा प्राङ्गणे मम ।\nस्वात्मारामेषु पूर्णेषु शुभप्रश्नमनीप्सितम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003171068, "chapter_id": 23171, "verse_number": "४-१०७-६९", "content_sanskrit": "योगीन्द्रैरपि सिद्धेन्द्रैः सुरेन्द्रैश्च मुनीन्द्रकैः ।\nध्यानादृष्टश्च यो देवः स शिवः प्राङ्गणे मम ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003171069, "chapter_id": 23171, "verse_number": "४-१०७-७०", "content_sanskrit": "कालस्य कालो भगवान्मृत्योर्मृत्युश्च यः प्रभुः ।\nमृत्युंजयश्च सर्वेशोनराणां दृष्टिगोचरः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003171070, "chapter_id": 23171, "verse_number": "४-१०७-७१", "content_sanskrit": "यस्यमूर्ध्नां सहस्रेषु मूर्ध्नि विश्वं चराचरम् ।\nनास्त्यन्तः सर्ववेदेषु सोऽयं च मम प्राङ्गणे ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003171071, "chapter_id": 23171, "verse_number": "४-१०७-७२", "content_sanskrit": "सर्वकामप्रणेयो हि सर्वाग्रे यस्य पूजनम् ।\nश्रेष्ठो देवगणानां च स गणेशो ममाङ्गणे ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003171072, "chapter_id": 23171, "verse_number": "४-१०७-७३", "content_sanskrit": "मुनीनां वैष्णवानां च प्रवनो ज्ञानिनां गुरुः ।\nसनत्कुमारो भगवान्प्रत्यक्षः प्राङ्गणे मम ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003171073, "chapter_id": 23171, "verse_number": "४-१०७-७४", "content_sanskrit": "ब्रह्मपुत्राश्च पौत्राश्च प्रपौत्राश्चापि वंशजाः ।\nते सर्वे मदगृहेऽद्यैव ज्वलन्तो ब्रह्मतेजसा ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003171074, "chapter_id": 23171, "verse_number": "४-१०७-७५", "content_sanskrit": "अहो कल्पान्तपर्यन्तं तीर्थीभूतो ममाऽऽश्रमः ।\nयेषां पादोदकैस्तीर्थ विशुद्धं तद्गृहे मम ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003171075, "chapter_id": 23171, "verse_number": "४-१०७-७६", "content_sanskrit": "पृथिव्यां यानि तीर्थानि तानि तीर्थानि सागरे ।\nसागरे यानि तीर्थानि विप्रपादेषु तानि च ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003171076, "chapter_id": 23171, "verse_number": "४-१०७-७७", "content_sanskrit": "विप्रपादोदकक्लिन्ना यावत्तिष्ठति मेदिनी ।\nतावत्पुष्करपत्रेषु पिबन्ति पितरो जलम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003171077, "chapter_id": 23171, "verse_number": "४-१०७-७८", "content_sanskrit": "विप्रपादोदकं भुक्त्वा दत्त्वा विप्राय दक्षिणाम् ।\nस्रानानां सर्वतीर्थानां फलमाप्नोति निश्चितम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003171078, "chapter_id": 23171, "verse_number": "४-१०७-७९", "content_sanskrit": "निकृन्तनं च विपदां व्याधिनिर्मुलकारणम् ।\nसुखदं शुभदं सारं विप्रपादोदकं नृणाम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003171079, "chapter_id": 23171, "verse_number": "४-१०७-८०", "content_sanskrit": "न गङ्गासदृशं तीर्थ न देवो माधवात्परः ।\nसनत्कुमारा द्भक्तो न न हि कल्पतरोस्तरुः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003171080, "chapter_id": 23171, "verse_number": "४-१०७-८१", "content_sanskrit": "न पुष्पं पारिजाताच्च न व्रतं हरिवासरात् ।\nपूजने न हि पूज्यं च न पत्रं तुलसीपरम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003171081, "chapter_id": 23171, "verse_number": "४-१०७-८२", "content_sanskrit": "न देवी प्रकृतेश्चापि नाऽऽधारः पवनात्परः ।\nन हि स्थूलो महाविष्णोर्न सूक्ष्मं परमाणुतः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003171082, "chapter_id": 23171, "verse_number": "४-१०७-८३", "content_sanskrit": "न ब्राह्मणात्परः पूतो नाऽऽश्रमश्च न तीर्यकम् ।\nन देवो न परः कोऽपि चेत्याह कमलोद्भवः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003171083, "chapter_id": 23171, "verse_number": "४-१०७-८४", "content_sanskrit": "ब्रह्मविष्णुशिवादीनां प्रकृतेश्च परः प्रभुः ।\nध्यानासाध्यो दुराराध्यो योगिनामपि निश्चितम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003171084, "chapter_id": 23171, "verse_number": "४-१०७-८५", "content_sanskrit": "निर्गुणश्च निराकारो भक्तानुग्रहविग्रहः ।\nस एव चक्षुषो नॄणां साक्षाद्देवश्च मद्गृहे ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003171085, "chapter_id": 23171, "verse_number": "४-१०७-८६", "content_sanskrit": "देवैर्ब्रह्मेशशेषैश्च ध्यातं यत्पादपङ्कजम् ।\nधनेशेन गणेशेन दिनेशेनापि दुर्लभम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003171086, "chapter_id": 23171, "verse_number": "४-१०७-८७", "content_sanskrit": "इत्युक्त्वा भीष्मकः कृष्णं समानीय स्वयं पुरः ।\nतुष्टाव सामवेदोक्तस्तोत्रेण परमेश्वरम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003171087, "chapter_id": 23171, "verse_number": "४-१०७-८८", "content_sanskrit": "भीष्मक उवाच ।\nसर्वान्तरात्मा सर्वेषां साक्षी निर्लिप्त एव च ।\nकर्मिणां कर्मणामेव कारणानां च कारणम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003171088, "chapter_id": 23171, "verse_number": "४-१०७-८९", "content_sanskrit": "केचिद्वदन्ति त्वामेकं ज्योतीरूपं सनातनम् ।\nकेचिच्च परमात्मानं जीवो यत्प्रतिबिम्बकः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003171089, "chapter_id": 23171, "verse_number": "४-१०७-९०", "content_sanskrit": "केचित्प्राकृतिकं जीवं सगृणं भ्रान्तबुद्धयः ।\nकेचिन्नित्यशरीरं च बुद्धा (धा) श्च सूक्ष्मबुद्धयः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003171090, "chapter_id": 23171, "verse_number": "४-१०७-९१", "content_sanskrit": "ज्योतिरभ्यन्तरे नित्यं देहरूपं सनातनम् ।\nकस्मात्तेजः प्रभवति साकारमीश्वरं विना ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003171091, "chapter_id": 23171, "verse_number": "४-१०७-९२", "content_sanskrit": "एवं स्तुत्वा स चाऽऽचान्तः स्मरन्विष्णुं च नारद ।\nपाद्यं पद्मार्चिते पादपद्मे चायं ददौ मुदा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003171092, "chapter_id": 23171, "verse_number": "४-१०७-९३", "content_sanskrit": "अर्ध्यं च प्रददौ तत्र दूर्वापुष्पजलान्वितम् ।\nमधुपर्कं च सुरभिं सर्वाङ्गे गन्धयन्दनम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003171093, "chapter_id": 23171, "verse_number": "४-१०७-९४", "content_sanskrit": "यत्प्रदत्तं महेन्द्रेण शुभकर्मणि यौतुकम् ।\nपारिजातस्य माल्यं च जामातुश्च गले ददौ ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003171094, "chapter_id": 23171, "verse_number": "४-१०७-९५", "content_sanskrit": "कुबेरेण च यदत्तममूल्यरत्नभूषणम् ।\nचकार वरणं तस्य स राजा भक्तिपूर्वकम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003171095, "chapter_id": 23171, "verse_number": "४-१०७-९६", "content_sanskrit": "कह्निशुद्धांशुकयुगं यद्दत्तं वाह्निना पुरा ।\nददौ तदेव कृष्णाय परिपूर्णतमाय च ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003171096, "chapter_id": 23171, "verse_number": "४-१०७-९७", "content_sanskrit": "ज्वलितं रत्नमुकुटं यद्दत्तं विश्वकर्मणा ।\nददौ तन्मस्तके राजा कृष्णस्य परमात्मनः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003171097, "chapter_id": 23171, "verse_number": "४-१०७-९८", "content_sanskrit": "धूपं रत्नप्रदीपं च नैवेद्यं सुमनोहरम् ।\nनानाप्रकारपुष्पं च रत्नसिहासनं ददौ ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003171098, "chapter_id": 23171, "verse_number": "४-१०७-९९", "content_sanskrit": "सप्ततीर्थोदकं चैव पुनराचमनीयकम् ।\nताम्बूलं च वरं रम्यं कर्पूरादिसुवासितम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003171099, "chapter_id": 23171, "verse_number": "४-१०७-१००", "content_sanskrit": "शय्यां रतिकरी रम्यां पानार्थं वासितं जलम् ।\nकृत्वा च वरणं राजा परिहारं चकारतम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003171100, "chapter_id": 23171, "verse_number": "४-१०७-१०१", "content_sanskrit": "कृताञ्जलिपुटो राजा तस्मै पुष्पाञ्जलीं ददौ ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}]