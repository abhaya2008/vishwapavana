[{"id": 6000131000, "chapter_id": 10131, "verse_number": null, "content_sanskrit": "अथ द्वादशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000131001, "chapter_id": 10131, "verse_number": null, "content_sanskrit": "ऋषिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.001.m4a", "display_order": 2}, {"id": 6000131002, "chapter_id": 10131, "verse_number": "६-१२-१", "content_sanskrit": "एवं जिहासुर्नृप देहमाजौ मृत्युं परं विजयं मन्यमानः।\nशूलं प्रगृह्याभ्यपतत् सुरेन्द्रं यथा महापुरुषं कैटभोऽप्सु॥ ६/१२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.002.m4a", "display_order": 3, "topics": [{"text": "इन्द्रेण च्छिन्नैकबाहुना वृत्रेण सह युध्यमानस्य इन्द्रस्य हस्ताद् वज्रायुधभ्रंशः", "range": "१–४"}]}, {"id": 6000131003, "chapter_id": 10131, "verse_number": "६-१२-२", "content_sanskrit": "ततो युगान्ताग्निकठोरजिह्वमाविध्य शूलं तरसाऽसुरेन्द्रः।\nक्षिप्त्वा महेन्द्राय विनद्य धीरो हतोऽसि पापेति रुषा जगाद॥ ६/१२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.003.m4a", "display_order": 4}, {"id": 6000131004, "chapter_id": 10131, "verse_number": "६-१२-३", "content_sanskrit": "ख आपतन्तं ज्वलितं महोल्कवन्निरीक्ष्य दुष्प्रेक्ष्यमजातविक्लवः।\nवज्रेण वज्री शतपर्वणाऽच्छिनद् भुजं च तस्योरगभोगभोगम्॥ ६/१२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.004.m4a", "display_order": 5}, {"id": 6000131005, "chapter_id": 10131, "verse_number": "६-१२-४", "content_sanskrit": "छिन्नैकबाहुः परिघेण वृत्रः संरब्ध आसाद्य गृहीतवज्रम्।\nहनौ तताडेन्द्रमथामरेशं वज्रश्च हस्तान्न्यपतन्मघोनः॥ ६/१२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.005.m4a", "display_order": 6}, {"id": 6000131006, "chapter_id": 10131, "verse_number": "६-१२-५", "content_sanskrit": "वृत्रस्य कर्मातिमहाद्भुतं तत् सुरासुराश्चारणसिद्धसङ्घाः।\nअपूजयंस्तत् पुरुहूतसङ्कटं निरीक्ष्य हाहेति विचुक्रुशुर्भृशम्॥ ६/१२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.006.m4a", "display_order": 7, "topics": [{"text": "लज्जया पुनर्वज्रायुधम् अगृहीतवन्तम् इन्द्रं प्रति वृत्रासुरेण ज्ञानोपदेशः", "range": "५–१७"}]}, {"id": 6000131007, "chapter_id": 10131, "verse_number": "६-१२-६", "content_sanskrit": "इन्द्रो न वज्रं जगृहे विलज्जितश्च्युतं स्वहस्तादरिसन्निधौ पुनः।\nतमाह वृत्रो हर आत्तवज्रो जहि स्वशत्रुं न विषादकालः॥ ६/१२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.007.m4a", "display_order": 8}, {"id": 6000131008, "chapter_id": 10131, "verse_number": "६-१२-७", "content_sanskrit": "युयुत्सतां कुत्रचिदाततायिनां जयः सदैकत्र न वै पराजयः।\nविनैकमुत्पत्तिलयस्थितीश्वरं सर्वज्ञमाद्यं पुरुषं सनातनम्॥ ६/१२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.008.m4a", "display_order": 9}, {"id": 6000131009, "chapter_id": 10131, "verse_number": "६-१२-८", "content_sanskrit": "लोकाः सपाला यस्येमे श्वसन्ति विवशा वशे।\nद्विजा इव सिचा बद्धाः स काल इह कारणम्॥ ६/१२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.009.m4a", "display_order": 10}, {"id": 6000131010, "chapter_id": 10131, "verse_number": "६-१२-९", "content_sanskrit": "ओजः सहो बलं प्राणममृतं मृत्युमेव च।\nतमज्ञाय जनो हेतुमात्मानं मन्यते जडः॥ ६/१२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.010.m4a", "display_order": 11}, {"id": 6000131011, "chapter_id": 10131, "verse_number": "६-१२-१०", "content_sanskrit": "यथा दारुमयी नारी यथा यन्त्रमयो मृगः।\nएवंभूतानि मघवन्नीशतन्त्राणि विद्धि भोः॥ ६/१२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.011.m4a", "display_order": 12}, {"id": 6000131012, "chapter_id": 10131, "verse_number": "६-१२-११", "content_sanskrit": "पुरुषः प्रकृतिर्व्यक्तमात्मभूतेन्द्रियाशयाः।\nशक्नुवन्त्यस्य सर्गादौ न विना यदनुग्रहम्॥ ६/१२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.012.m4a", "display_order": 13}, {"id": 6000131013, "chapter_id": 10131, "verse_number": "६-१२-१२", "content_sanskrit": "अविद्वानेवमात्मानं मन्यतेऽनीशमीश्वरम्।\nभूतैः सृजति भूतानि ग्रसते तानि वै स्वयम्॥ ६/१२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.013.m4a", "display_order": 14}, {"id": 6000131014, "chapter_id": 10131, "verse_number": "६-१२-१३", "content_sanskrit": "आयुः श्रीः कीर्तिरैश्वर्यमाशिषः पुरुषस्य याः।\nभवन्त्येव हि ते काले यथाऽनिच्छोर्विपर्ययाः॥ ६/१२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.014.m4a", "display_order": 15}, {"id": 6000131015, "chapter_id": 10131, "verse_number": "६-१२-१४", "content_sanskrit": "तस्मादकीर्तियशसोर्जयापजययोरपि।\nसमः स्यात्सुखदुःखाभ्यां मृत्युजीवनयोस्तथा॥ ६/१२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.015.m4a", "display_order": 16}, {"id": 6000131016, "chapter_id": 10131, "verse_number": "६-१२-१५", "content_sanskrit": "सत्त्वं रजस्तम इति प्रकृतेर्नात्मनो गुणाः।\nतत्र साक्षिणमात्मानं यो वेद न स बध्यते॥ ६/१२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.016.m4a", "display_order": 17}, {"id": 6000131017, "chapter_id": 10131, "verse_number": "६-१२-१६", "content_sanskrit": "पश्य मां निर्जितं शक्र वृक्णायुधभुजं मृधे।\nघटमानं यथाशक्ति तव प्राणजिहीर्षया॥ ६/१२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.017.m4a", "display_order": 18}, {"id": 6000131018, "chapter_id": 10131, "verse_number": "६-१२-१७", "content_sanskrit": "प्राणग्लहोऽयं समर इष्वक्षो वाहनासनः।\nअत्र न ज्ञायतेऽमुष्य जयोऽमुष्य पराजयः॥ ६/१२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.018.m4a", "display_order": 19}, {"id": 6000131019, "chapter_id": 10131, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.019.m4a", "display_order": 20}, {"id": 6000131020, "chapter_id": 10131, "verse_number": "६-१२-१८", "content_sanskrit": "इन्द्रो वृत्रवचः श्रुत्वा गतालीकमपूजयत्।\nगृहीतवज्रः प्रहसंस्तमाह गतविस्मयः॥ ६/१२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.020.m4a", "display_order": 21, "topics": [{"text": "वृत्रं स्तुत्वा पुनर्युद्‌ध्वा वज्रायुधेन वृत्रवधः", "range": "१८–३५"}]}, {"id": 6000131021, "chapter_id": 10131, "verse_number": null, "content_sanskrit": "इन्द्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.021.m4a", "display_order": 22}, {"id": 6000131022, "chapter_id": 10131, "verse_number": "६-१२-१९", "content_sanskrit": "अहो दानव सिद्धोऽसि यस्य ते मतिरीदृशी।\nभक्तः सर्वात्मनाऽऽत्मानं सुहृदं जगदीश्वरम्॥ ६/१२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.022.m4a", "display_order": 23}, {"id": 6000131023, "chapter_id": 10131, "verse_number": "६-१२-२०", "content_sanskrit": "भवानतार्षीन्मायां वै वैष्णवीं जनमोहिनीम्।\nयद् विहायासुरं भावं महापुरुषतां गतः॥ ६/१२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.023.m4a", "display_order": 24}, {"id": 6000131024, "chapter_id": 10131, "verse_number": "६-१२-२१", "content_sanskrit": "खल्विदं महदाश्चर्यं यद् रजःप्रकृतेस्तव।\nवासुदेवे भगवति सर्वात्मनि दृढा मतिः॥ ६/१२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.024.m4a", "display_order": 25}, {"id": 6000131025, "chapter_id": 10131, "verse_number": "६-१२-२२", "content_sanskrit": "यस्य भक्तिर्भगवति हरौ निःश्रेयसेश्वरे।\nविक्रीडतोऽमृताम्भोधौ किं क्षुद्रैः खातकोदकैः॥ ६/१२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.025.m4a", "display_order": 26}, {"id": 6000131026, "chapter_id": 10131, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.026.m4a", "display_order": 27}, {"id": 6000131027, "chapter_id": 10131, "verse_number": "६-१२-२३", "content_sanskrit": "इति ब्रुवाणावन्योन्यं धर्मजिज्ञासया नृप।\nयुयुधाते महावीर्याविन्द्रवृत्रौ युधाम्पती॥ ६/१२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.027.m4a", "display_order": 28}, {"id": 6000131028, "chapter_id": 10131, "verse_number": "६-१२-२४", "content_sanskrit": "आविध्य परिघं वृत्रः कार्ष्णायसमरिन्दम।\nइन्द्राय प्राहिणोद् घोरं वामहस्तेन मारिष॥ ६/१२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.028.m4a", "display_order": 29}, {"id": 6000131029, "chapter_id": 10131, "verse_number": "६-१२-२५", "content_sanskrit": "स तु वृत्रस्य परिघं करं च करभोपमम्।\nचिच्छेद युगपद् देवो वज्रेण शतपर्वणा॥ ६/१२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.029.m4a", "display_order": 30}, {"id": 6000131030, "chapter_id": 10131, "verse_number": "६-१२-२६", "content_sanskrit": "दोर्भ्यामुत्कृत्तमूलाभ्यां बभौ रक्तस्रवोऽसुरः।\nछिन्नपक्षो यथा गोत्रः खाद् भ्रष्टो वज्रिणा हतः॥ ६/१२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.030.m4a", "display_order": 31}, {"id": 6000131031, "chapter_id": 10131, "verse_number": "६-१२-२७", "content_sanskrit": "कृत्वाऽधरां हनुं भूमौ दैत्यो दिव्युत्तरां हनुम्।\nनभो गम्भीरवक्त्रेण लिलेहोल्बणजिह्वया॥ ६/१२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.031.m4a", "display_order": 32}, {"id": 6000131032, "chapter_id": 10131, "verse_number": "६-१२-२८", "content_sanskrit": "दंष्ट्राभिः कालकल्पाभिर्ग्रसन्निव जगत्त्रयम्।\nअतिमात्रं महाकाय आक्षिपंस्तरसा गिरीन्॥ ६/१२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.032.m4a", "display_order": 33}, {"id": 6000131033, "chapter_id": 10131, "verse_number": "६-१२-२९", "content_sanskrit": "गिरिराट् पादचारीव पद्भ्यां निर्दरयन् महीम्। जग्रास तं समासाद्य वज्रिणं सहवाहनम्।\nमहाप्राणो महावीर्यो महासर्प इव द्विपम्॥ ६/१२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.033.m4a", "display_order": 34}, {"id": 6000131034, "chapter_id": 10131, "verse_number": "६-१२-३०", "content_sanskrit": "वृत्रग्रस्तं तमालक्ष्य सप्रजापतयः सुराः।\nहा कष्टमिति निर्विण्णाश्चुक्रुशुः समहर्षयः॥ ६/१२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.034.m4a", "display_order": 35}, {"id": 6000131035, "chapter_id": 10131, "verse_number": "६-१२-३१", "content_sanskrit": "निगीर्णोऽप्यसुरेन्द्रेण न ममारोदरं गतः।\nमहापुरुषसन्नद्धो योगमायाबलेन च॥ ६/१२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.035.m4a", "display_order": 36}, {"id": 6000131036, "chapter_id": 10131, "verse_number": "६-१२-३२", "content_sanskrit": "भित्त्वा वज्रेण तत्कुक्षिं निष्क्रम्य बलभिद् विभुः।\nऊच्चकर्त शिरः शत्रोर्गिरिशृङ्गमिवौजसा॥ ६/१२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.036.m4a", "display_order": 37}, {"id": 6000131037, "chapter_id": 10131, "verse_number": "६-१२-३३", "content_sanskrit": "वज्रस्तु तत्कन्धरमाशुवेगः कृन्तन् समन्तात् परिवर्तमानः।\nन्यपातयत् तावदहर्गणेन यो ज्योतिषामयने वार्त्रहत्ये॥ ६/१२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.037.m4a", "display_order": 38}, {"id": 6000131038, "chapter_id": 10131, "verse_number": "६-१२-३४", "content_sanskrit": "तदा च खे दुन्दुभयो विनेदुर्गन्धर्वविद्याध्रमहर्षिसिद्धाः।\nवार्त्रघ्नलिङ्गैस्तमभिष्टुवाना मन्त्रैर्मुदा कुसुमैरभ्यवर्षन्॥ ६/१२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.038.m4a", "display_order": 39}, {"id": 6000131039, "chapter_id": 10131, "verse_number": "६-१२-३५", "content_sanskrit": "वृत्रस्य देहान्निष्क्रान्तमात्मज्योतिररिन्दम।\nपश्यतां सर्वलोकानां स्वलोकं समपद्यत॥ ६/१२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_06/adhyaya_012/BhP_06.012.039.m4a", "display_order": 40}, {"id": 6000131040, "chapter_id": 10131, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां षष्ठस्कन्धे द्वादशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]