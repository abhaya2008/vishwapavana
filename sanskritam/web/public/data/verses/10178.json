[{"id": 6000178000, "chapter_id": 10178, "verse_number": null, "content_sanskrit": "अथ तृतीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000178001, "chapter_id": 10178, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.001.m4a", "display_order": 2}, {"id": 6000178002, "chapter_id": 10178, "verse_number": "९-३-१", "content_sanskrit": "एवं गतेऽथ सुद्युम्ने मनुर्वैवस्वतः सुते।\nपुत्रकामस्तपस्तेपे यमुनायां शतं समाः॥ ९/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.002.m4a", "display_order": 3, "topics": [{"text": "ततो वैवस्वतमनोरिक्ष्वाकुप्रभृतिपुत्रोत्पत्तिः", "range": "१–२"}]}, {"id": 6000178003, "chapter_id": 10178, "verse_number": "९-३-२", "content_sanskrit": "ततोऽयजन्मनुर्देवमपत्यार्थं हरिं प्रभुम्।\nइक्ष्वाकुपूर्वजान् पुत्रान् लेभे स्वसदृशान् दश॥ ९/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.003.m4a", "display_order": 4}, {"id": 6000178004, "chapter_id": 10178, "verse_number": "९-३-३", "content_sanskrit": "वृषध्रस्तु मनोः पुत्रो गोपालो गुरुणा कृतः।\nपालयामास गा यत्तो रात्र्यां वीरासनव्रतः॥ ९/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.004.m4a", "display_order": 5, "topics": [{"text": "अज्ञानाद्गोवधं कृतवता मनोरष्टमपुत्रेण वृषध्रेण तपोवनगमनम्", "range": "३–१४"}]}, {"id": 6000178005, "chapter_id": 10178, "verse_number": "९-३-४", "content_sanskrit": "एकदा प्राविशद् गोष्ठं शार्दूलो निशि वर्षति।\nशयाना गाव उत्थाय भीतास्ता बभ्रमुर्व्रजे॥ ९/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.005.m4a", "display_order": 6}, {"id": 6000178006, "chapter_id": 10178, "verse_number": "९-३-५", "content_sanskrit": "एकां जग्राह बलवान् सा चुक्रोश भयातुरा।\nतस्यास्तु क्रन्दितं श्रुत्वा वृषध्रोऽभिससार ह॥ ९/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.006.m4a", "display_order": 7}, {"id": 6000178007, "chapter_id": 10178, "verse_number": "९-३-६", "content_sanskrit": "खड्गमादाय तरसा प्रलीनोडुगणे निशि।\nअजानन्नहनद् बभ्रोः शिरः शार्दूलशङ्कया॥ ९/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.007.m4a", "display_order": 8}, {"id": 6000178008, "chapter_id": 10178, "verse_number": "९-३-७", "content_sanskrit": "व्याघ्रो विवृक्णश्रवणो निस्‍त्रिंशाग्रहतस्ततः।\nनिश्चक्राम भृशं भीतो रक्तं पथि समुत्सृजन्॥ ९/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.008.m4a", "display_order": 9}, {"id": 6000178009, "chapter_id": 10178, "verse_number": "९-३-८", "content_sanskrit": "मन्यमानो हतं व्याघ्रं वृषध्रः परवीरहा।\nअद्राक्षीत् स्वहतां बभ्रुं व्युष्टायां निशि दुःखितः॥ ९/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.009.m4a", "display_order": 10}, {"id": 6000178010, "chapter_id": 10178, "verse_number": "९-३-९", "content_sanskrit": "तं शशाप कुलाचार्यः कृतागसमकामतः।\nन क्षत्रबन्धुः शूद्रस्त्वं कर्मणा भविताऽमुना॥ ९/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.010.m4a", "display_order": 11}, {"id": 6000178011, "chapter_id": 10178, "verse_number": "९-३-१०", "content_sanskrit": "एवं शप्तस्तु गुरुणा प्रत्यगृह्णात् कृताञ्जलिः।\nअधारयद् व्रतं वीर ऊर्ध्वरेता मुनिप्रियम्॥ ९/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.011.m4a", "display_order": 12}, {"id": 6000178012, "chapter_id": 10178, "verse_number": "९-३-११", "content_sanskrit": "वासुदेवे भगवति सर्वात्मन्यमले परे।\nएकान्तित्वं गतो भक्त्या सर्वभूतसुहृत् समः॥ ९/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.012.m4a", "display_order": 13}, {"id": 6000178013, "chapter_id": 10178, "verse_number": "९-३-१२", "content_sanskrit": "विमुक्तसङ्गः शान्तात्मा संयताक्षोऽपरिग्रहः।\nयदृच्छयोपपन्नेन कल्पयन् वृत्तिमात्मनः॥ ९/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.013.m4a", "display_order": 14}, {"id": 6000178014, "chapter_id": 10178, "verse_number": "९-३-१३", "content_sanskrit": "आत्मन्यात्मानमाधाय ज्ञानतृप्तः समाहितः।\nविचचार महीमेतां जडान्धबधिराकृतिः॥ ९/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.014.m4a", "display_order": 15}, {"id": 6000178015, "chapter_id": 10178, "verse_number": "९-३-१४", "content_sanskrit": "एवंव्रतो वनं गत्वा दृष्ट्वा दावाग्निमुत्थितम्।\nतेनोपयुक्तकरणो ब्रह्म प्राप परं मुनिः॥ ९/३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.015.m4a", "display_order": 16}, {"id": 6000178016, "chapter_id": 10178, "verse_number": "९-३-१५", "content_sanskrit": "कविस्तदाऽयं विषयेषु निःस्पृहो विसृज्य सङ्गं सह बन्धुभिर्वनम्।\nनिवेश्य चित्ते पुरुषं स्वरोचिषं विवेश कैशोरवयाः परं गतः॥ ९/३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.016.m4a", "display_order": 17, "topics": [{"text": "इक्ष्वाकुवंशस्य महत्त्वात् लघूनामन्येषां मनुपुत्राणां वंशकथनम्", "range": "१५–३६"}]}, {"id": 6000178017, "chapter_id": 10178, "verse_number": "९-३-१६", "content_sanskrit": "करूशान्मानवादासन् कारूशाः क्षत्रजातयः।\nउत्तरापथगोप्तारो ब्रह्मण्या धर्मवत्सलाः॥ ९/३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.017.m4a", "display_order": 18}, {"id": 6000178018, "chapter_id": 10178, "verse_number": "९-३-१७", "content_sanskrit": "धृष्टाद्धार्ष्टमभूत् क्षत्रं ब्रह्मभूतं गतं क्षितौ।\nनभपुत्रोऽतिबलवान् स्वातिमूलोऽभवद्वसुः॥ ९/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.018.m4a", "display_order": 19}, {"id": 6000178019, "chapter_id": 10178, "verse_number": "९-३-१८", "content_sanskrit": "वसोः प्रतीकस्तत्पुत्र ओघवानोघवत्स्वसा।\nकन्या चोघवती नाम सुदर्शन उवाह ताम्॥ ९/३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.019.m4a", "display_order": 20}, {"id": 6000178020, "chapter_id": 10178, "verse_number": "९-३-१९", "content_sanskrit": "चित्रसेनो नरिष्यन्ताद्दक्षस्तस्य सुतोऽभवत्।\nतस्य मीढ्वांस्ततः कूर्च इन्द्रसेनस्तु तत्सुतः॥ ९/३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.020.m4a", "display_order": 21}, {"id": 6000178021, "chapter_id": 10178, "verse_number": "९-३-२०", "content_sanskrit": "वीतिहोत्रस्त्विन्द्रसेनात् तस्य सत्यश्रवा अभूत्।\nउरुश्रवाः सुतस्तस्य देवदत्तस्ततोऽभवत्॥ ९/३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.021.m4a", "display_order": 22}, {"id": 6000178022, "chapter_id": 10178, "verse_number": "९-३-२१", "content_sanskrit": "देवदत्तस्य भगवानग्निः स्वयमभूत् सुतः।\nकानीन इति विख्यातो जातूकर्ण्यो महानृषिः॥ ९/३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.022.m4a", "display_order": 23}, {"id": 6000178023, "chapter_id": 10178, "verse_number": "९-३-२२", "content_sanskrit": "ततो ब्रह्मकुलं जातमाग्निवेश्यायनं नृप।\nनरिष्यन्तान्वयः प्रोक्तो दिष्टवंशमतः शृणु॥ ९/३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.023.m4a", "display_order": 24}, {"id": 6000178024, "chapter_id": 10178, "verse_number": "९-३-२३", "content_sanskrit": "नाभागो दिष्टपुत्रोऽन्यः कर्मणा वैश्यतां गतः।\nभलन्दनः सुतस्तस्य वत्सप्रीतिर्भलन्दनात्॥ ९/३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.024.m4a", "display_order": 25}, {"id": 6000178025, "chapter_id": 10178, "verse_number": "९-३-२४", "content_sanskrit": "वत्सप्रीतेः सुतः प्रांशुस्तत्सुतः प्रमितिर्विभुः।\nखनित्रः प्रमितेस्तस्माच्चाक्षुषोऽथ विविंशतिः॥ ९/३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.025.m4a", "display_order": 26}, {"id": 6000178026, "chapter_id": 10178, "verse_number": "९-३-२५", "content_sanskrit": "विविंशतिसुतो रम्भः खनिनेत्रोऽस्य धार्मिकः।\nकरन्धमो महाराज तस्यासीदात्मजो नृपः॥ ९/३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.026.m4a", "display_order": 27}, {"id": 6000178027, "chapter_id": 10178, "verse_number": "९-३-२६", "content_sanskrit": "तस्यावीक्षित् सुतो यस्य मरुत्तश्चक्रवर्त्यभूत्।\nसंवर्तोऽयाजयद्यं वै महायोग्यङ्गिरस्सुतः॥ ९/३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.027.m4a", "display_order": 28}, {"id": 6000178028, "chapter_id": 10178, "verse_number": "९-३-२७", "content_sanskrit": "मरुत्तस्य यथा यज्ञो न तथान्योऽस्ति कश्चन।\nसर्वे हिरण्मयं त्वासीद् यत् किञ्चास्त्यतिशोभनम्॥ ९/३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.028.m4a", "display_order": 29}, {"id": 6000178029, "chapter_id": 10178, "verse_number": "९-३-२८", "content_sanskrit": "अमाद्यदिन्द्रः सोमेन दक्षिणाभिर्द्विजातयः।\nमरुतः परिवेष्टारो विश्वे देवाः सभासदः॥ ९/३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.029.m4a", "display_order": 30}, {"id": 6000178030, "chapter_id": 10178, "verse_number": "९-३-२९", "content_sanskrit": "मरुत्तस्य दमः पुत्रस्तस्यासीद् राज्यवर्धनः।\nसुधृतिस्तत्सुतो जज्ञे सौधृतेयो नरः सुतः॥ ९/३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.030.m4a", "display_order": 31}, {"id": 6000178031, "chapter_id": 10178, "verse_number": "९-३-३०", "content_sanskrit": "तत्सुतः केवलस्तस्माद् बन्धुमान् वेगवांस्ततः।\nबन्धुस्तस्याभवद् यस्य तृणबिन्दुर्महीपतिः॥ ९/३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.031.m4a", "display_order": 32}, {"id": 6000178032, "chapter_id": 10178, "verse_number": "९-३-३१", "content_sanskrit": "तं भेजेऽलम्बुषा देवी भजनीयगुणालयम्।\nवराप्सरा यतः पुत्राः कन्या चेलिबिलाऽभवत्॥ ९/३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.032.m4a", "display_order": 33}, {"id": 6000178033, "chapter_id": 10178, "verse_number": "९-३-३२", "content_sanskrit": "यस्यामुत्पादयामास विश्रवाश्च धनाधिपम्।\nप्रदाय विद्यां परमामृषिर्योगेश्वरः पितुः॥ ९/३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.033.m4a", "display_order": 34}, {"id": 6000178034, "chapter_id": 10178, "verse_number": "९-३-३३", "content_sanskrit": "विशालः शून्यबन्धुश्च धूमकेतुश्च तत्सुताः।\nविशालो वंशकृद् राजा वैशालीं निर्ममे पुरीम्॥ ९/३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.034.m4a", "display_order": 35}, {"id": 6000178035, "chapter_id": 10178, "verse_number": "९-३-३४", "content_sanskrit": "हेमचन्द्रः सुतस्तस्य धूम्राक्षस्तस्य चात्मजः।\nतत्पुत्रः सहदेवस्तु कृशाश्वः सहदेवजः॥ ९/३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.035.m4a", "display_order": 36}, {"id": 6000178036, "chapter_id": 10178, "verse_number": "९-३-३५", "content_sanskrit": "कृशाश्वात् सोमदत्तोऽभूद् योऽश्वमेधैरिडस्पतिम्।\nइष्ट्वा पुरुषमापाग्र्यां गतिं योगेश्वराश्रितम्॥ ९/३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.036.m4a", "display_order": 37}, {"id": 6000178037, "chapter_id": 10178, "verse_number": "९-३-३६", "content_sanskrit": "सौमदत्तिस्तु सुमतिस्तत्सुतो जनमेजयः।\nएते वैशालभूपालास्तृणबिन्दोर्यशोधराः॥ ९/३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_003/BhP_09.003.037.m4a", "display_order": 38}, {"id": 6000178038, "chapter_id": 10178, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे तृतीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]