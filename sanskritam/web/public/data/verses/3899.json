[{"id": 2134294, "chapter_id": 3899, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134295, "chapter_id": 3899, "verse_number": "१", "content_sanskrit": "यदा स्कन्देन मातॄणामेवमेतत् प्रियं कृतम् ।\nअथैनमब्रवीत् स्वाहा मम पुत्रस्त्वमौरसः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134296, "chapter_id": 3899, "verse_number": "२", "content_sanskrit": "इच्छाम्यहं त्वया दत्तां प्रीतिं परमदुर्लभाम् ।\nतामब्रवीत् ततः स्कन्दः प्रीतिमिच्छसि कीदृशीम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134297, "chapter_id": 3899, "verse_number": "", "content_sanskrit": "स्वाहा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134298, "chapter_id": 3899, "verse_number": "३", "content_sanskrit": "दक्षस्याहं प्रिया कन्या स्वाहा नाम महाभुज ।\nबाल्यात् प्रभृति नित्यं च जातकामा हुताशने \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134299, "chapter_id": 3899, "verse_number": "४", "content_sanskrit": "न स मां कामिनीं पुत्र सम्यग् जानाति पावकः ।\nइच्छामि शाश्वतं वासं वस्तुं पुत्र सहाग्निना \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134300, "chapter_id": 3899, "verse_number": "", "content_sanskrit": "स्कन्दः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134301, "chapter_id": 3899, "verse_number": "५", "content_sanskrit": "हव्यं कव्यं च यत् किञ्चिद् द्विजानां मन्त्रसंस्तुतम् ।\nहोष्यन्त्यग्नौ सदा देवि स्वाहेत्युक्त्वा समुद्धृतम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134302, "chapter_id": 3899, "verse_number": "६", "content_sanskrit": "अद्यप्रभृति दास्यन्ति सुवृत्ताः सत्पथे स्थिताः ।\nएवमग्निस्त्वया सार्धं सदा वत्स्यति शोभने \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134303, "chapter_id": 3899, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134304, "chapter_id": 3899, "verse_number": "७", "content_sanskrit": "एवमुक्ता ततः स्वाहा तुष्टा स्कन्देन पूजिता ।\nपावकेन समायुक्ता भर्त्रा स्कन्दमपूजयत् ।\nततो ब्रह्मा महासेनं प्रजापतिरथाब्रवीत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134305, "chapter_id": 3899, "verse_number": "८", "content_sanskrit": "अभिगच्छ महादेवं पितरं त्रिपुरार्दनम् ।\nरुद्रेणाग्निं समाविश्य स्वाहामाविश्य चोमया\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134306, "chapter_id": 3899, "verse_number": "९", "content_sanskrit": "हितार्थं सर्वलोकानां जातस्त्वमपराजितः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134307, "chapter_id": 3899, "verse_number": "१०", "content_sanskrit": "उमायोन्यां च रुद्रेण शुक्रं सिक्तं महात्मना ।\nअस्मिन् गिरौ निपतितं मिञ्जिकामिञ्जिकं यतः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134308, "chapter_id": 3899, "verse_number": "११", "content_sanskrit": "मिथुनं चै महाभाग तत्र तद् रुद्रसम्भवम् ।\nसम्भूतं लोहितोदे तु शुक्रशेषमवापतत् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134309, "chapter_id": 3899, "verse_number": "१२", "content_sanskrit": "सूर्यरश्मिषु चाप्यन्यदन्यच्चाप्यपतद् भुवि ।\nआसक्तमन्यद् वृक्षेषु तदेवं पञ्चधाऽपतत् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134310, "chapter_id": 3899, "verse_number": "१३", "content_sanskrit": "त एते विविधाकारा गणा ज्ञेया मनीषिभिः ।\nतव पारिषदा घोरा य एते पिशिताशनाः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134311, "chapter_id": 3899, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134312, "chapter_id": 3899, "verse_number": "१४", "content_sanskrit": "एवमस्त्विति चाप्युक्त्वा महासेनो महेश्वरम् ।\nअपूजयदमेयात्मा पितरं पितृवत्सलः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134313, "chapter_id": 3899, "verse_number": "१५", "content_sanskrit": "अर्कपुष्पैस्तु ते पञ्च गणाः पूज्या धनार्थिभिः ।\nव्याधिप्रशमनार्थं च तेषां पूजां समाचरेत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134314, "chapter_id": 3899, "verse_number": "१६", "content_sanskrit": "मिञ्जिकामिञ्जिकं चैव मिथुनं रुद्रसम्भवम् ।\nनमस्कार्यं सदैवेह बालानां हितमिच्छता\t ॥ १६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2134315, "chapter_id": 3899, "verse_number": "१७", "content_sanskrit": "स्त्रियो मानुषमांसादा वृद्धिका नाम नामतः ।\nवृक्षेषु जातास्ता नार्यो नमस्कार्याः प्रजार्थिभिः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2134316, "chapter_id": 3899, "verse_number": "१८", "content_sanskrit": "एवमेते पिशाचानामसङ्ख्येया गणाः स्मृताः ।\nघण्टायाः सपताकायाः शृणु मे सम्भवं नृप \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2134317, "chapter_id": 3899, "verse_number": "१९", "content_sanskrit": "ऐरावतस्य घण्टे द्वे वैजयन्त्याविति श्रुते।\nगुहस्य ते स्वयं दत्ते क्रमेणानाय्य धीमता \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2134318, "chapter_id": 3899, "verse_number": "२०", "content_sanskrit": "एका तत्र विशाखस्य घण्टा स्कन्दस्य चापरा ।\nपताका कार्त्तिकेयस्य विशाखस्य च लोहिता \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2134319, "chapter_id": 3899, "verse_number": "२१", "content_sanskrit": "यानि क्रीडनकान्यस्य देवैर्दत्तानि वै तदा ।\nतैरेव रमते देवो महासेनो महाबलः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2134320, "chapter_id": 3899, "verse_number": "२२", "content_sanskrit": "स संवृतः पिशाचानां गणैर्देवगणैस्तथा ।\nशुशुभे काञ्चने शैले दीप्यमानः श्रिया वृतः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2134321, "chapter_id": 3899, "verse_number": "२३", "content_sanskrit": "तेन वीरेण शुशुभे स शैलः शुभकाननः ।\nआदित्येनेवांशुमता मन्दरश्चारुकन्दरः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2134322, "chapter_id": 3899, "verse_number": "२४", "content_sanskrit": "सन्तानकवनैः फुल्लैः करवीरवनैरपि ।\nपारिजातवनैश्चैव जपाशोकवनैस्तथा \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2134323, "chapter_id": 3899, "verse_number": "२५", "content_sanskrit": "कदम्बतरुषण्डैश्च दिव्यैर्मृगगणैरपि ।\nदिव्यैः पक्षिगणैश्चैव शुशुभे श्वेतपर्वतः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2134324, "chapter_id": 3899, "verse_number": "२६", "content_sanskrit": "तत्र देवगणाः सर्वे सर्वे देवर्षयस्तथा ।\nमेघतूर्यरवाश्चैव क्षुब्धोदधिसमस्वनाः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2134325, "chapter_id": 3899, "verse_number": "२७", "content_sanskrit": "तत्र दिव्याश्च गन्धर्वा नृत्यन्त्यप्सरसां गणाः ।\nहृष्टानां तत्र भूतानां श्रूयते निनदो महान् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2134326, "chapter_id": 3899, "verse_number": "२८", "content_sanskrit": "एवं सेन्द्रं जगत्सर्वं श्वेतपर्वतसंस्थितम् ।\nप्रहृष्टं प्रेक्षते स्कन्दं न च ग्लायति दर्शनात्\t ॥ २८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2134327, "chapter_id": 3899, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते वनपर्वणि शतसहस्रिकायां संहितायां वैयासिक्यां विंशत्यधिकद्विशततमोऽध्यायः ॥१२०॥\n॥ इति मार्कण्डेयसमास्यापर्वणि पञ्चचत्वारिंशोऽध्यायः ॥४५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]