[{"id": 2020064, "chapter_id": 1420, "verse_number": "३-५८-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020065, "chapter_id": 1420, "verse_number": "३-५८-१", "content_sanskrit": "ततस्तु याते वार्ष्णेये पुण्यश्लोकस्य दीव्यतः।\nपुष्करेण हृतं राज्यं यच्चापि वसु किंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020066, "chapter_id": 1420, "verse_number": "३-५८-२", "content_sanskrit": "हृतराज्यं नलं राजन्प्रहसन्पुष्करोऽब्रवीत्।\nद्यूतं प्रवर्ततां भूयः प्रतिपाणोऽस्ति कस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020067, "chapter_id": 1420, "verse_number": "३-५८-३", "content_sanskrit": "शिष्टा ते दमयन्त्येका सर्वमन्यद्धृतं मया।\nदमयन्त्याः पणः साधु वर्ततां यदि मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020068, "chapter_id": 1420, "verse_number": "३-५८-४", "content_sanskrit": "पुष्रेणैवमुक्तस्य पुण्यश्लोकस्य मन्युना।\nव्यदीर्यतेव हृदयं न चैनं किंचिदब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020069, "chapter_id": 1420, "verse_number": "३-५८-५", "content_sanskrit": "ततः पुष्करमालोक्य नलः परममन्युमान्।\n`उवाच विद्यतेऽन्यच्च धनं मम नराधम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020070, "chapter_id": 1420, "verse_number": "३-५८-६", "content_sanskrit": "षणरूपेण निक्षिप्य पुण्यश्लोकः सुदुर्मनाः।\nउत्तरीयं तथा वस्त्रं तस्याश्चाभरणानि च।\nउन्सृज्य सर्वगात्रभ्यो भूषणानि सहायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020071, "chapter_id": 1420, "verse_number": "३-५८-७", "content_sanskrit": "सुकवासा ह्यसंवीतः सुहृच्छोकविवर्धनः।\nनिश्चक्राम ततोराजा त्यक्त्वा सुविपुलां श्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020072, "chapter_id": 1420, "verse_number": "३-५८-८", "content_sanskrit": "दमयन्त्येकवस्त्राऽथ गच्छन्तं पृष्ठतोऽन्वगात्।\nस तया नगराभ्याशे त्रिरात्रं नैपधोऽवसत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020073, "chapter_id": 1420, "verse_number": "३-५८-९", "content_sanskrit": "पुष्करस्तु महाराज धोषयामास वै पुरे।\nनले यः सम्यगातिष्ठेत्स गच्छेद्वध्यतां मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020074, "chapter_id": 1420, "verse_number": "३-५८-१०", "content_sanskrit": "पुष्करस्य तु वाक्येन तस्य विद्वेषणेन च।\nपौरा न तस्य सत्कारं कृतवन्तो युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020075, "chapter_id": 1420, "verse_number": "३-५८-११", "content_sanskrit": "स तथा नगराभ्याशे सत्कारार्हो न सन्कृतः।\nत्रिगत्रमुपितो राजा जलमात्रेण वर्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020076, "chapter_id": 1420, "verse_number": "३-५८-१२", "content_sanskrit": "[पीड्यमानः क्षुधा तत्र फलमृलानि कर्पयन्।\nप्रातिष्ठत ततोराजा दमयन्ती तमन्वगात् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020077, "chapter_id": 1420, "verse_number": "३-५८-१३", "content_sanskrit": "क्षुधया पीड्यमानम्तु नलो बहुतिथेऽहनि।\nअपश्यच्छकुनान्कांश्रिद्धिरण्यसदृशच्छदान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020078, "chapter_id": 1420, "verse_number": "३-५८-१४", "content_sanskrit": "स चिन्तयामास तदा निपधाधिपतिर्बली।\nअस्ति भक्ष्यो ममाद्यापि वसु चेदं भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020079, "chapter_id": 1420, "verse_number": "३-५८-१५", "content_sanskrit": "ततस्तानन्तरीयेण वाससा स समावृणोत्।\nतस्य तद्वस्त्रमादाय सर्वे जग्मुर्विहायसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020080, "chapter_id": 1420, "verse_number": "३-५८-१६", "content_sanskrit": "उन्पतन्तः खगा वाक्यमेतदाहुस्ततो नलम्।\nदृष्ट्वा दिग्वाससं भूमौ स्थितं दीनमधोमुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020081, "chapter_id": 1420, "verse_number": "३-५८-१७", "content_sanskrit": "वयमक्षाः सुदुर्बुद्धे तववासो जिहीर्षवः।\nआगता न हि नः प्रीतिः सवाससि गते त्वयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020082, "chapter_id": 1420, "verse_number": "३-५८-१८", "content_sanskrit": "नान्समीक्ष्य गतानक्षानात्मानं च विवाससम्।\nपुण्यश्लोकस्तदा राजा दमयन्तीमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020083, "chapter_id": 1420, "verse_number": "३-५८-१९", "content_sanskrit": "येषां प्रकोपादैश्वर्यान्प्रच्युतोऽहमनिन्दिते।\nप्राणयात्रां न विन्देयं दुःखितः क्षुधयाऽन्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020084, "chapter_id": 1420, "verse_number": "३-५८-२०", "content_sanskrit": "येषां कृते न सत्कारमकुर्वन्मयि नैषधाः।\nइमे ते शकुना भूत्वा वासश्चाषहरन्ति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020085, "chapter_id": 1420, "verse_number": "३-५८-२१", "content_sanskrit": "वैषम्यं परमं प्राप्तो दुःखितो गतचेतनः।\nभर्ता तेऽहं निबोधेदं वचनं हितमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020086, "chapter_id": 1420, "verse_number": "३-५८-२२", "content_sanskrit": "एते गच्छन्ति वहवः पन्थानो दिणापथम्।\nअवन्तीमृक्षवन्तं च समतिक्रम्य पर्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020087, "chapter_id": 1420, "verse_number": "३-५८-२३", "content_sanskrit": "एष विन्ध्यो महाशैलः पयोष्णी च समुद्रगा।\nआश्रमाश्च महर्षीणां बहुमूलफलान्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020088, "chapter_id": 1420, "verse_number": "३-५८-२४", "content_sanskrit": "एष पन्था विदर्भाणामेष यास्यति कोसलान्।\nअतःपरं च देशोऽयं दक्षिणो दक्षिणापथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020089, "chapter_id": 1420, "verse_number": "३-५८-२५", "content_sanskrit": "एतद्वाक्यं नलो राजा दमयन्तीं समाहितः।\nउवाचासकृदार्तो हि भैमीमुद्दिश्य भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020090, "chapter_id": 1420, "verse_number": "३-५८-२६", "content_sanskrit": "ततः सा वाष्पकलया वाचा दुःखेन कर्शिता।\nउवाच दमयन्ती तं नैषधं करुणं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020091, "chapter_id": 1420, "verse_number": "३-५८-२७", "content_sanskrit": "उद्वेषते मे हृदयं सीदन्त्यङ्गानि सर्वशः।\nतव पार्थिव संकल्पं चिन्तयन्त्याः पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020092, "chapter_id": 1420, "verse_number": "३-५८-२८", "content_sanskrit": "हृतराज्यं हृतद्रव्यं विवस्त्रं क्षुच्छ्रमान्वितम्।\nकथमुत्सृज्य गच्छेयमहं त्वां निर्जने वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020093, "chapter_id": 1420, "verse_number": "३-५८-२९", "content_sanskrit": "श्रान्तस्य ते क्षुधार्तस्य चिन्तयानस्य तत्सुखम्।\nवने घोरे महाराज नाशयिष्याम्यहं क्लमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020094, "chapter_id": 1420, "verse_number": "३-५८-३०", "content_sanskrit": "न च भार्यासमं किंचिन्नरस्यार्तस्य भेषजम्।\nनित्यं हि सर्वदुःखेषु सत्यमेतद्व्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020095, "chapter_id": 1420, "verse_number": "३-५८-३१x", "content_sanskrit": "नल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2020096, "chapter_id": 1420, "verse_number": "३-५८-३१", "content_sanskrit": "एवमेतद्यथाऽऽन्थ त्वं दमयन्ति सुमध्यमे।\nनास्ति बार्यासमं मित्रं नरस्यार्तस्य भेषजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2020097, "chapter_id": 1420, "verse_number": "३-५८-३२", "content_sanskrit": "न चाहं त्यक्तुकामस्त्वां किमलं भीरु शङ्कसे।\nत्यजेयमहमात्मानं न चैव त्वामनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2020098, "chapter_id": 1420, "verse_number": "३-५८-३३x", "content_sanskrit": "दमयन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2020099, "chapter_id": 1420, "verse_number": "३-५८-३३", "content_sanskrit": "यदि मां त्वं महाराज न विहातुमिहच्छसि।\nतत्किमर्थं विदर्भाणां पन्थाः समुपदिश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2020100, "chapter_id": 1420, "verse_number": "३-५८-३४", "content_sanskrit": "अवैमि चाहं नृपते न तु मां त्यक्तुमर्हसि।\nचेतसा त्वपकृष्टेन मां त्यजेथा महीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2020101, "chapter_id": 1420, "verse_number": "३-५८-३५", "content_sanskrit": "पन्थानं हि ममाभीक्ष्णमाख्यासि च नरोत्तम।\nअतो निमित्तं शोकं मे वर्धयस्यमरोपम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2020102, "chapter_id": 1420, "verse_number": "३-५८-३६", "content_sanskrit": "यदि चायमभिप्रायस्तव राजन्भविष्यति।\nसहितावेव गच्छावो विदर्भान्यदि मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2020103, "chapter_id": 1420, "verse_number": "३-५८-३७", "content_sanskrit": "विदर्भराजस्तत्र त्वां पूजयिष्यति मानद।\nतेन त्वं पूजितो राजन्सुखं वत्स्यसि नो गृहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2020104, "chapter_id": 1420, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि अष्टपञ्चाशोऽध्यायः ॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]