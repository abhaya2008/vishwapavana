[{"id": 7002768000, "chapter_id": 22768, "verse_number": "९-५३-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nअध्रुवेण शरीरेण सुपक्वेनापि किं फलम् ।\nमाघस्नानविहीनेन यत्त्यक्तं यदुनन्दन ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002768001, "chapter_id": 22768, "verse_number": "९-५३-२", "content_sanskrit": "प्रातःस्नानासमर्थानां शरीरं पश्य देहिनाम् ।\nकिं तेन वद कर्तव्यं माघे संसारभीरुणा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002768002, "chapter_id": 22768, "verse_number": "९-५३-३", "content_sanskrit": "कायक्लेशसहा नार्यो न भवंति यदूत्तम ।\nसौकुमार्यं शरीरस्य अचलत्वात्तथैव च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002768003, "chapter_id": 22768, "verse_number": "९-५३-४", "content_sanskrit": "कथं च ताः सुरूपाः स्युः सुभगाः सुप्रजास्तथा ।\nसुकृतस्येह पुण्यस्य सर्वमेतत्फलं यतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002768004, "chapter_id": 22768, "verse_number": "९-५३-५", "content_sanskrit": "अल्पायासेन सुमहद्येन पुण्यमवाप्यते ।\nस्त्रीभिर्माघे मम ब्रूहि स्नानं तत्त्वं रमाधव ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002768005, "chapter_id": 22768, "verse_number": "९-५३-६", "content_sanskrit": "श्रीकृष्ण उवाच ।\nश्रूयतां पांडवश्रेष्ठ रहस्यमृषिभाषितम् ।\nयन्मया कस्यचिन्नोक्तमचलासप्तमीव्रतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002768006, "chapter_id": 22768, "verse_number": "९-५३-७", "content_sanskrit": "वेश्या चेन्दुमती नाम रूपौदार्यगुणान्विता ।\nआसीत्कुरुकुलश्रेष्ठ मगधस्य विलासिनी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002768007, "chapter_id": 22768, "verse_number": "९-५३-८", "content_sanskrit": "तनुमध्या सुजघना पीनोन्नतपयोधरा ।\nसम्यग्विभक्तावयवा पूर्णचन्द्रनिभानना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002768008, "chapter_id": 22768, "verse_number": "९-५३-९", "content_sanskrit": "सौंदर्यं सौकुमार्यं च तस्याः कामेन गीयते ।\nयस्याः संदर्शनादेव कामः कामातुरो भवेत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002768009, "chapter_id": 22768, "verse_number": "९-५३-१०", "content_sanskrit": "मूर्तिः शशधरस्येव नयनानन्दकारिणी ।\nवशीकरणविद्येव सर्वलोकमनोहरा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002768010, "chapter_id": 22768, "verse_number": "९-५३-११", "content_sanskrit": "एकस्मिन्दिवसे प्रातः सुमुखस्थितया तया ।\nचिंतिता हृदये राजन्त्संसारस्यानवस्थितिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002768011, "chapter_id": 22768, "verse_number": "९-५३-१२", "content_sanskrit": "सन्निमज्य जगदिदं विषये कायसागरे ।\nजन्ममृत्युजराग्राहं न कश्चिदवबुद्ध्यते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002768012, "chapter_id": 22768, "verse_number": "९-५३-१३", "content_sanskrit": "अपाको भूतभाण्डानां धातृशिल्पिविनिर्मितम् ।\nस्वकर्मेंधनसंवीतं पच्यते बालवह्निना ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002768013, "chapter_id": 22768, "verse_number": "९-५३-१४", "content_sanskrit": "ये यांति दिवसाः पुंसां धर्मकामार्थवर्जिताः ।\nन ते पुनरिहायांति हरभक्ता नरा यथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002768014, "chapter_id": 22768, "verse_number": "९-५३-१५", "content_sanskrit": "स्नानं दानं तपो होमः स्वाध्यायः पितृतर्पणम् ।\nयस्मिन्दिने न क्रियते वृथा स दिवसो नृणाम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002768015, "chapter_id": 22768, "verse_number": "९-५३-१६", "content_sanskrit": "पुत्राणां दारगृहकसमासक्तं हि मानसम् ।\nवृकीवोरणमासाद्य मृत्युर्द्वाराय गच्छति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002768016, "chapter_id": 22768, "verse_number": "९-५३-१७", "content_sanskrit": "इत्येवं चिंतयित्वा तु वेश्या चेन्दुमती ततः ।\nवशिष्ठस्याश्रमं पुण्यं जगाम गजगामिनी ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002768017, "chapter_id": 22768, "verse_number": "९-५३-१८", "content_sanskrit": "वशिष्ठमृषिमासीनं प्रणम्य विनयात्ततः ।\nकृताञ्जलिपुटा भूत्वा इदं वचनमब्रवीत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002768018, "chapter_id": 22768, "verse_number": "९-५३-१९", "content_sanskrit": "इन्दुमत्युवाच ।\nदशसूनासमश्चक्री दशचक्रिसमो ध्वजः ।\nदशध्वजसमा वेश्या दशवेश्यासमो नृपः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002768019, "chapter_id": 22768, "verse_number": "९-५३-२०", "content_sanskrit": "मया न दत्तं न हुतं नोपवासो व्रतं कृतम् ।\nभक्त्या न पूजितः शम्भुः श्रितो नैको धनी नरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002768020, "chapter_id": 22768, "verse_number": "९-५३-२१", "content_sanskrit": "सांप्रतं वर्तमानाया व्रतं किंचिद्वदस्व मे ।\nयेन दुःखांबुपापौघादुत्तरामि भवार्णवात् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002768021, "chapter_id": 22768, "verse_number": "९-५३-२२", "content_sanskrit": "एतदस्याः सुबहुशः श्रुत्वा धर्मं परंतपः ।\nवशिष्ठः कथयामास महाकारुणिको मुनिः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002768022, "chapter_id": 22768, "verse_number": "९-५३-२३", "content_sanskrit": "वशिष्ठ उवाच ।\nमाघस्य सितसप्तम्यां सर्वकामफलप्रदम् ।\nतपःसौभाग्यजननं स्नानं तव वरानने ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002768023, "chapter_id": 22768, "verse_number": "९-५३-२४", "content_sanskrit": "कृत्वा षष्ठ्यामेकभक्तं सप्तम्यां निश्चलं जलम् ।\nरात्र्यंते चालयेथास्त्वं दत्त्वा शिरसि दीपकम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002768024, "chapter_id": 22768, "verse_number": "९-५३-२५", "content_sanskrit": "माघस्य सितसप्तम्यामचलं चालितं मया ।\nजलामलानां सर्वेषां कृतं न चलनं तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002768025, "chapter_id": 22768, "verse_number": "९-५३-२६", "content_sanskrit": "वशिष्ठवचनं श्रुत्वा तस्मिन्नहनि भूपते ।\nसर्वं चकारेन्दुमती स्नानं दानं यथाविधि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002768026, "chapter_id": 22768, "verse_number": "९-५३-२७", "content_sanskrit": "त्र्यहस्नानप्रभावेण भुक्त्वा भोग्यान्यथेप्सितान् ।\nइन्द्रलोकेप्सरःसंघे नायिकात्वमवाप सा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002768027, "chapter_id": 22768, "verse_number": "९-५३-२८", "content_sanskrit": "अचलासप्तमीस्नानं कथितं च विशांपते ।\nसर्वपापप्रशमनं सुखसौभाग्यवर्द्धनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002768028, "chapter_id": 22768, "verse_number": "९-५३-२९", "content_sanskrit": "युधिष्ठिर उवाच ।\nसप्तमीस्नानमाहात्म्यं श्रुतं न च विशेषतः ।\nसांप्रतं श्रोतुमिच्छामि विधिमंत्रसमन्वितम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002768029, "chapter_id": 22768, "verse_number": "९-५३-३०", "content_sanskrit": "श्रीकृष्ण उवाच ।\nएकभक्तेन संतिष्ठेत्षष्ठ्यां संपूज्य भास्करम् ।\nसप्तम्यां तु व्रजेत्प्रातः सुगंभीरं जलाशयम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002768030, "chapter_id": 22768, "verse_number": "९-५३-३१", "content_sanskrit": "सरित्संगं तडागं च देवखातमथापि वा ।\nसुखावगाहसलिलं दुष्टसत्त्वैरदूषितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002768031, "chapter_id": 22768, "verse_number": "९-५३-३२", "content_sanskrit": "पशुभिः पक्षिभिश्चैव जलजैर्मत्स्यकच्छपैः ।\nन जलं चाल्यते यावत्तावत्स्नानं समाचरेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002768032, "chapter_id": 22768, "verse_number": "९-५३-३३", "content_sanskrit": "नमस्ते रुद्ररूपाय रसानां पतये नमः ।\nवरुणाय नमस्तेऽस्तु हरिवास नमोऽस्तु ते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002768033, "chapter_id": 22768, "verse_number": "९-५३-३४", "content_sanskrit": "यावज्जन्म कृतं पापं मया जन्मसु सप्तसु ।\nतन्मे रोगं च शोकं च माकरी हंतु सप्तमी ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002768034, "chapter_id": 22768, "verse_number": "९-५३-३५", "content_sanskrit": "जननी सर्वभूतानां सप्तमी सप्तसप्तिके ।\nसर्वव्याधिहरे देवि नमस्ते रविमंडले ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002768035, "chapter_id": 22768, "verse_number": "९-५३-३६", "content_sanskrit": "जलोपरितरं दीपं स्नात्वा संतर्प्य देवताः ।\nचंदनेन लिखेत्पद्ममष्टपत्रं सकर्णिकम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002768036, "chapter_id": 22768, "verse_number": "९-५३-३७", "content_sanskrit": "मध्ये शर्वं सपत्नीकं प्रणवेन तु पूजयेत् ।\nभानुं शक्रे दले पूज्य रविं वैश्वानरे दले ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002768037, "chapter_id": 22768, "verse_number": "९-५३-३८", "content_sanskrit": "याम्ये विवस्वान्नैरृत्ये भास्करस्येति पूजयेत् ।\nपश्चिमे सविता पूज्यः पूज्योर्को वायुना जले ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002768038, "chapter_id": 22768, "verse_number": "९-५३-३९", "content_sanskrit": "सौम्ये सहस्रकिरणः शेषे सर्वात्मनेति च ।\nपूज्याः प्रणवपूर्वास्तु नमस्कारांतयोजिताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002768039, "chapter_id": 22768, "verse_number": "९-५३-४०", "content_sanskrit": "पुष्पैः सुगन्धधूपैश्च वस्त्रेणाच्छाद्य भास्करम् ।\nविसर्जयेत्ततः पश्चात्स्वस्थानं गम्यतामिति ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002768040, "chapter_id": 22768, "verse_number": "९-५३-४१", "content_sanskrit": "ताम्रपात्रे सुविस्तीर्णे मृन्मये वा युधिष्ठिर ।\nस्थापयेत्तिलचूर्णं च सघृतं सगुडं तथा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002768041, "chapter_id": 22768, "verse_number": "९-५३-४२", "content_sanskrit": "काञ्चनं तालकं कृत्वा ह्यसिक्तस्तिलचूर्णकम् ।\nसंस्थाप्य रक्तवस्त्रैस्तु पुष्पैर्धूपैस्तथार्चयेत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002768042, "chapter_id": 22768, "verse_number": "९-५३-४३", "content_sanskrit": "ततस्तं ब्राह्मणे दद्याद्दत्त्वा मंत्रेण तालकम् ।\nआदित्यस्य प्रसादेन प्रातः स्नानफलं भजेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002768043, "chapter_id": 22768, "verse_number": "९-५३-४४", "content_sanskrit": "दुष्टदौर्भाग्यदुःखेभ्यो मया दत्तं तु तालकम् ।\nततस्तत्तालकं कृत्वा ब्राह्मणायोपपादयेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002768044, "chapter_id": 22768, "verse_number": "९-५३-४५", "content_sanskrit": "सपुत्रपशुभृत्याय मेऽर्कोयं प्रीयतामिति ।\nततो व्रतोपदेष्टारं पूजयेद्वस्त्रगोतिलैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002768045, "chapter_id": 22768, "verse_number": "९-५३-४६", "content_sanskrit": "विप्रानन्यान्यथाशक्त्या पूजयित्वा गृहं व्रजेत् ।\nएतत्ते कथितं कार्यं रूपसौभाग्यकारकम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002768046, "chapter_id": 22768, "verse_number": "९-५३-४७", "content_sanskrit": "अचलासप्तमीस्नानं सर्वकामफलप्रदम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]