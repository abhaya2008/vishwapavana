[{"id": 7003593000, "chapter_id": 23593, "verse_number": "१-१-१५-१", "content_sanskrit": "ऋषय ऊचुः ।\nराज्यं प्राप्तो हि देवेंद्रः कथितस्ते गुरुं विना ।\nगुरोरवज्ञया जातो राज्यभ्रंशो हि तस्य तु ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003593001, "chapter_id": 23593, "verse_number": "१-१-१५-२", "content_sanskrit": "केन प्रणोदितश्चेंद्रो बभूव चिरमासने ।\nतत्सर्वं कथयाशु त्वं परं कौतूहलं हि नः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003593002, "chapter_id": 23593, "verse_number": "१-१-१५-३", "content_sanskrit": "लोमश उवाच ।\nगुरुणापि विना राज्यं कृतवान्स शचीपतिः ।\nविश्वरूपोक्तविधिना इंद्रो राज्ये स्थितो महान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003593003, "chapter_id": 23593, "verse_number": "१-१-१५-४", "content_sanskrit": "विश्वकर्मसुतो विप्रा विश्वरूपो महानृपः ।\nपुरोहितोऽथ शक्रस्य याजकश्चाभवत्तदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003593004, "chapter_id": 23593, "verse_number": "१-१-१५-५", "content_sanskrit": "तस्मिन्यज्ञेऽवदानैश्च यजने असुरान्सुरान् ।\nमनुष्यांश्चैव त्रिशिरा अपरोक्षं शचीपतेः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003593005, "chapter_id": 23593, "verse_number": "१-१-१५-६", "content_sanskrit": "देवान्ददाति साक्रोशं दैत्यांस्तूष्णीमथाददात् ।\nमनुष्यान्मध्यपातेन प्रत्यहं स ग्रहान्द्विजः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003593006, "chapter_id": 23593, "verse_number": "१-१-१५-७", "content_sanskrit": "एकदा तु महेंद्रेण सूचितो गुरुलाघवात् ।\nअलक्ष्यमाणेन तदा ज्ञातं तस्य चिकीर्षितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003593007, "chapter_id": 23593, "verse_number": "१-१-१५-८", "content_sanskrit": "दैत्यानां कार्यसिद्ध्यर्थमवदानं प्रयच्छति ।\nअसौ पुरोहितोऽस्माकं परेषां च फलप्रदः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003593008, "chapter_id": 23593, "verse_number": "१-१-१५-९", "content_sanskrit": "इति मत्वा तदा शक्रो वज्रेण शतपर्वणा ।\nचिच्छेद तच्छिरांस्येव तत्क्षणादभवद्वधः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003593009, "chapter_id": 23593, "verse_number": "१-१-१५-१०", "content_sanskrit": "येनाकरोत्सोमपानमजायंत कपिंजलाः ।\nततोन्येन सुरापानात्कलविंका भवन्मुखात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003593010, "chapter_id": 23593, "verse_number": "१-१-१५-११", "content_sanskrit": "अन्याननादजायंत तित्तिरा विश्वरूपिणः ।\nएवं हतो विश्वरूपः शक्रेण मंदभागिना ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003593011, "chapter_id": 23593, "verse_number": "१-१-१५-१२", "content_sanskrit": "ब्रह्महत्या तदोद्भूता दुर्धर्षा च भयावहा ।\nदुर्धर्षा दुर्मुखा दुष्टा चण्डालरजसान्विता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003593012, "chapter_id": 23593, "verse_number": "१-१-१५-१३", "content_sanskrit": "ब्रह्महत्या सुरापानं स्तेयं गुर्वंगनागमः ।\nइत्येषामप्यघवतामिदमेव च निष्कृतिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003593013, "chapter_id": 23593, "verse_number": "१-१-१५-१४", "content_sanskrit": "नामव्याहरणं विष्णोर्यतस्तद्विषया मतिः ।\nत्रिशिरा धूम्रहस्ता सा शक्रं ग्रस्तुमुपाययौ ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003593014, "chapter_id": 23593, "verse_number": "१-१-१५-१५", "content_sanskrit": "ततो भयेन महता पलायनपरोऽभवत् ।\nपलायमानं तं दृष्ट्वा ह्यनुयाता भयावहा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003593015, "chapter_id": 23593, "verse_number": "१-१-१५-१६", "content_sanskrit": "यतो धावति साऽधावत्तिष्ठंतमनुतिष्ठति ।\nअंगकृता यथा छाया शक्रस्यपरिवेष्टितुम् ।\nआयाति तावत्सहसा इंद्रोऽप्यप्सु न्यमज्जत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003593016, "chapter_id": 23593, "verse_number": "१-१-१५-१७", "content_sanskrit": "शीघ्रत्वेन यथा विप्राश्चिरंतनजलेचरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003593017, "chapter_id": 23593, "verse_number": "१-१-१५-१८", "content_sanskrit": "एवं दिव्यशतं पूर्णं वर्षाणां च शचीपतेः ।\nवसतस्तस्य दुःखेन तथा चैव शतद्वयम् ।\nअराजकं तदा जातं नाकपृष्ठे भयावहम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003593018, "chapter_id": 23593, "verse_number": "१-१-१५-१९", "content_sanskrit": "तदा चिंतान्विता देवा ऋषयोऽपि तपस्विनः ।\nत्रैलोक्यं चाऽपदा ग्रस्तं बभूव च तदा द्विजाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003593019, "chapter_id": 23593, "verse_number": "१-१-१५-२०", "content_sanskrit": "एकोऽपि ब्रह्महा यत्र राष्ट्रे वसति निर्भयः ।\nअकालमरणं तत्र साधूनामुपजायते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003593020, "chapter_id": 23593, "verse_number": "१-१-१५-२१", "content_sanskrit": "राजा पापयुतो यस्मिन्राष्ट्रे वसति तत्र वै ।\nदुर्भिक्षं चैव मरणं तथैवोपद्रवा द्विजाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003593021, "chapter_id": 23593, "verse_number": "१-१-१५-२२", "content_sanskrit": "भवंति बहवोऽनर्थाः प्रजानां नाशहेतवे ।\nतस्माद्राज्ञा तु कर्तव्यो धर्म्मः श्रद्धापरेण हि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003593022, "chapter_id": 23593, "verse_number": "१-१-१५-२३", "content_sanskrit": "तथा प्रकृतयो राज्ञः शुचजित्वेन प्रतिष्ठिताः ।\nइन्द्रेण च कृतं पापं तेन पापेन वै द्विजाः ।\nनानाविधैर्महातापैः सोपद्रवमभूज्जगत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003593023, "chapter_id": 23593, "verse_number": "१-१-१५-२४", "content_sanskrit": "शौनक उवाच ।\nअश्वमेधशतेनैव प्राप्तं राज्यं महत्तरम् ।\nदेवानामखिलं सूत कस्माद्विघ्रमजायत ।\nशक्रस्य च महाभाग यथावत्कथयस्व न ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003593024, "chapter_id": 23593, "verse_number": "१-१-१५-२५", "content_sanskrit": "सूत उवाच ।\nदेवानां दानवानां च मनुष्याणां विशेषतः ।\nकर्म्मैव सुखदुःखानां हेतुभूतं न संशयः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003593025, "chapter_id": 23593, "verse_number": "१-१-१५-२६", "content_sanskrit": "इन्द्रेण च कृतं विप्रा महद्भूतं जुगुप्सितम् ।\nगुरोरवज्ञा च कृता विश्वरूपवधः कृतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003593026, "chapter_id": 23593, "verse_number": "१-१-१५-२७", "content_sanskrit": "गौतमस्य गुरोः पत्नी सेविता तस्य तत्फलम् ।\nप्राप्तं महेंद्रेण चिरं यस्य नास्ति प्रतिक्रिया ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003593027, "chapter_id": 23593, "verse_number": "१-१-१५-२८", "content_sanskrit": "ये हि दृष्कटतकर्म्माणो न कुर्वंति च निष्कृतिम् ।\nदुर्दशां प्रप्नुवन्त्येते यथैवेन्द्रः शतक्रतुः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003593028, "chapter_id": 23593, "verse_number": "१-१-१५-२९", "content_sanskrit": "दुष्कृतोपार्जितस्या तः प्रायाश्चित्तं हि तत्क्षणात् ।\nकर्तव्यं विधिवद्विप्राः सर्वपापोपशांतये ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003593029, "chapter_id": 23593, "verse_number": "१-१-१५-३०", "content_sanskrit": "उपपातकमध्यस्तं महापातकतां व्रजेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003593030, "chapter_id": 23593, "verse_number": "१-१-१५-३१", "content_sanskrit": "ततः स्वधर्मनिष्ठां च ये कुर्वंति सदा नराः ।\nप्रातर्मध्याह्नसायाह्ने तेषां पापं विनश्यति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003593031, "chapter_id": 23593, "verse_number": "१-१-१५-३२", "content_sanskrit": "प्राप्नुवंत्युत्तमं लोकं नात्र कार्या विचारणा ।\nतस्मादसौ दुराचारः प्राप्ते वै कर्मणः फलम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003593032, "chapter_id": 23593, "verse_number": "१-१-१५-३३", "content_sanskrit": "स प्रधार्य तदा सर्वे लोकपालास्त्वरान्विताः ।\nबृहस्पतिमुपागम्य सर्वमात्मनि धिष्ठितम् ।\nकथयामासुरव्यग्रा इंद्रस्य च गुरुं प्रति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003593033, "chapter_id": 23593, "verse_number": "१-१-१५-३४", "content_sanskrit": "देवैरुक्तं वचो विप्रा निशम्य च बृहस्पतिः ।\nअराजकं च संप्राप्तं चिंतयामास बुद्धिमान् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003593034, "chapter_id": 23593, "verse_number": "१-१-१५-३५", "content_sanskrit": "किं कार्यं चाद्य कर्तव्यं कथं श्रेयो भविष्यति ।\nदेवानां चाद्य लोकानामृषीणां भावितात्मनाम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003593035, "chapter_id": 23593, "verse_number": "१-१-१५-३६", "content_sanskrit": "मनसैव च तत्सर्वं कार्याकार्यं विचार्य च ।\nजगाम शक्रं त्वरितो देवैः सह महायशाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003593036, "chapter_id": 23593, "verse_number": "१-१-१५-३७", "content_sanskrit": "प्राप्तो जलाशयं तं च यत्रास्ते हि पुरंदरः ।\nयस्य तीरे स्थिता हत्या चंडालीव भयावहा ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003593037, "chapter_id": 23593, "verse_number": "१-१-१५-३८", "content_sanskrit": "तत्रोविष्टास्ते सर्वे देवा ऋषिगणान्विताः ।\nआह्वानं च कृतं तस्य शक्रस्य गुरुणा स्वयम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003593038, "chapter_id": 23593, "verse_number": "१-१-१५-३९", "content_sanskrit": "समुत्थितस्ततः शक्रो ददर्श स्वगुरुं तदा ।\nबाष्पपूरितवक्त्रो हि बृहस्पतिमभाषत ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003593039, "chapter_id": 23593, "verse_number": "१-१-१५-४०", "content_sanskrit": "प्रणिपत्य च तत्रत्यान्कृताञ्जलिरभाषत ।\nतदा दीनमुखो भूत्वा मनसा संविमृश्य च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003593040, "chapter_id": 23593, "verse_number": "१-१-१५-४१", "content_sanskrit": "स्वयमेव कृतं पूर्वमज्ञानलक्षणं महत् ।\nअधुनैव मया कार्यं किं कर्तव्यं वद प्रभो ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003593041, "chapter_id": 23593, "verse_number": "१-१-१५-४२", "content_sanskrit": "प्रहस्योवाच भगवान्बृहस्पति रुदारधीः ।\nपुरा त्वया कृतं यच्च तस्येदं कर्मणः फलम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003593042, "chapter_id": 23593, "verse_number": "१-१-१५-४३", "content_sanskrit": "मां च उद्दिश्य भो इंद्र तद्भोगादेव संक्षयः ।\nप्रायश्चितं हि हत्याया न दृष्टं स्मृतिकारिभिः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003593043, "chapter_id": 23593, "verse_number": "१-१-१५-४४", "content_sanskrit": "अज्ञानतो हि यज्जातं पापं तस्य प्रतिक्रिया ।\nकथिता धर्म्मशास्त्रज्ञैः सकामस्य न विद्यते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003593044, "chapter_id": 23593, "verse_number": "१-१-१५-४५", "content_sanskrit": "सकामेन कृतं पापमकामं नैव जायते ।\nताभ्यां विषयभेदेन प्रायश्चित्तं विधीयते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003593045, "chapter_id": 23593, "verse_number": "१-१-१५-४६", "content_sanskrit": "मरणांतो विधिः कार्यो कामेन हि कृतेन हि ।\nअज्ञानजनिते पापे प्रायश्चित्तं विधीयते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003593046, "chapter_id": 23593, "verse_number": "१-१-१५-४७", "content_sanskrit": "तस्मात्त्वया कृतं यच्च स्वयमेव हतो द्विजः ।\nपुरोहितश्च विद्वांश्च तस्मान्नास्ति प्रतिक्रिया ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003593047, "chapter_id": 23593, "verse_number": "१-१-१५-४८", "content_sanskrit": "यावन्मरणमप्येति तावदप्सु स्थिरो भव ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003593048, "chapter_id": 23593, "verse_number": "१-१-१५-४९", "content_sanskrit": "शताश्वमेधसंज्ञं च यत्फलं तव दुर्मते ।\nतन्नष्टं तत्क्षणादेव घातितो हि द्विजो यदा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003593049, "chapter_id": 23593, "verse_number": "१-१-१५-५०", "content_sanskrit": "सच्छिद्रे च यथा तोयं न तिष्ठति घटेऽण्वपि ।\nतथैव सुकृतं पापे हीयते च प्रदक्षिणम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003593050, "chapter_id": 23593, "verse_number": "१-१-१५-५१", "content_sanskrit": "तस्माच्च दैवसंयोगात्प्राप्तं स्वर्गादिकं च यैः ।\nयथोक्तं तद्भवेत्तेषां धर्मिष्ठानां न संशयः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003593051, "chapter_id": 23593, "verse_number": "१-१-१५-५२", "content_sanskrit": "एतच्छ्रुत्वा वचस्तस्य शक्रो वचनमब्रवीत् ।\nकुकर्मणा मदीयेन प्राप्तमेतन्न संशयः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003593052, "chapter_id": 23593, "verse_number": "१-१-१५-५३", "content_sanskrit": "अमरावती माशु त्वं गच्छ देवर्षिबिः सह ।\nलोकानां कार्यसिद्ध्यर्थे देवानां च बृहस्पते ।\nइंद्रं कुरु महाभाग यस्ते मनसि रोचते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003593053, "chapter_id": 23593, "verse_number": "१-१-१५-५४", "content_sanskrit": "यथा मृतस्तथा हं वै ब्रह्महत्यावृतो महान् ।\nरागद्वेषसमुत्थेन पापेनास्मि परिप्लुतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003593054, "chapter_id": 23593, "verse_number": "१-१-१५-५५", "content_sanskrit": "तस्मात्त्वरान्विता यूयं देवराजानमाशुः वै ।\nकुर्वतु मदनुज्ञाताः सत्यं प्रतिवदामि वः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003593055, "chapter_id": 23593, "verse_number": "१-१-१५-५६", "content_sanskrit": "एवमुक्तास्तदा सर्वे बृहस्पतिपुरोगमाः ।\nएत्यामरावतीं तूर्णं पुरंदरविचेष्टितम् ।\nकथयामासुरव्यग्रा शचीं प्रति यथा तथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003593056, "chapter_id": 23593, "verse_number": "१-१-१५-५७", "content_sanskrit": "राज्यस्य हेतोः किं कार्यं विमृशंतः परस्परम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003593057, "chapter_id": 23593, "verse_number": "१-१-१५-५८", "content_sanskrit": "एवं विमृश्यमानानां देवानां तत्र नारदः ।\nयदृच्छयागतस्तत्र देवर्षिरमितद्युतिः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003593058, "chapter_id": 23593, "verse_number": "१-१-१५-५९", "content_sanskrit": "उवाच पूजितो देवान्कस्माद्यूयं विचेतसः ।\nतेनोक्ताः कथयामासुः सर्वं शक्रस्य चेष्टितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003593059, "chapter_id": 23593, "verse_number": "१-१-१५-६०", "content_sanskrit": "गतमिंद्रस्य चेंद्रत्वमेनसा परमेण तु ।\nततः प्रोवाच तान्देवान्देवर्षिर्नारदो वचः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003593060, "chapter_id": 23593, "verse_number": "१-१-१५-६१", "content_sanskrit": "यूयं देवाश्च सर्वज्ञास्तपसा विक्रमेण च ।\nतस्मादिंद्रो हि कर्तव्यो नहुषः सोमवंशजः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003593061, "chapter_id": 23593, "verse_number": "१-१-१५-६२", "content_sanskrit": "सोऽस्मिन्राष्ट्रे प्रतिष्ठाप्यस्त्वरितेनैव निर्जराः ।\nएकोनमश्वमेधानां शतं तेन महात्मना ।\nकृतमस्ति महाभागा नहुषेण च यज्वना ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003593062, "chapter_id": 23593, "verse_number": "१-१-१५-६३", "content_sanskrit": "शच्या श्रुतं च तद्वाक्यं नारदस्य मुखोद्गतम् ।\nगतांतःपुरमव्यग्रा बाष्पपूरितलोचना ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003593063, "chapter_id": 23593, "verse_number": "१-१-१५-६४", "content_sanskrit": "नारदस्य वचः श्रुत्वा सर्वे देवान्वमोदयन् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003593064, "chapter_id": 23593, "verse_number": "१-१-१५-६५", "content_sanskrit": "नहुषं राज्यमारोढुमैकपद्येन ते यदा ।\nआनीतो हि तदा राजा नहुषो ह्यमरावतीम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003593065, "chapter_id": 23593, "verse_number": "१-१-१५-६६", "content_sanskrit": "राज्यं दत्तं महेंद्रस्य सुरैः सर्वैर्महर्षिभिः ।\nतदागस्त्यादयः सर्वे नहुषं पर्युपासत ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003593066, "chapter_id": 23593, "verse_number": "१-१-१५-६७", "content_sanskrit": "गंधर्वाप्सरसो यक्षा विद्याधरमहोरगाः ।\nयक्षाः सुपर्णाः पतगा ये चान्ये स्वर्गवासिनः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003593067, "chapter_id": 23593, "verse_number": "१-१-१५-६८", "content_sanskrit": "तदा महोत्सवो जातो देवपुर्यां निरंतरः ।\nशंखतूर्यमृदंगानि नेदुर्दुंदुभयः समम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003593068, "chapter_id": 23593, "verse_number": "१-१-१५-६९", "content_sanskrit": "गायकाश्च जगुस्तत्र तथा वाद्यानि वादकाः ।\nनर्तका ननृतुस्तत्र तथा राज्यमहोत्सवे ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003593069, "chapter_id": 23593, "verse_number": "१-१-१५-७०", "content_sanskrit": "अभिषिक्तस्तदा तत्र बृहस्पतिपुरोगमैः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003593070, "chapter_id": 23593, "verse_number": "१-१-१५-७१", "content_sanskrit": "अर्चितो देवसूक्तैश्च यथा वद्ग्रहपूजनम् ।\nकृतवांश्चैव ऋषिभिर्विद्वद्भिर्भावितात्मभिः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003593071, "chapter_id": 23593, "verse_number": "१-१-१५-७२", "content_sanskrit": "तथा च सर्वैः परिपूजितो महान्राजा सुराणां नहुषस्तदानीम् ।\nइंद्रासने चेंद् समानरूपः संस्तूयमानः परमेण वर्चसा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003593072, "chapter_id": 23593, "verse_number": "१-१-१५-७३", "content_sanskrit": "सुगंधदीपैश्च सुवाससा युतोऽलंकारभोगैः सुविराजितांगः ।\nबभौ तदानीं नहुषो मुनीद्रैः संस्तूयमानो हि तथाऽमरेंद्रैः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003593073, "chapter_id": 23593, "verse_number": "१-१-१५-७४", "content_sanskrit": "इति परमकलान्वितोऽसौ सुरमुनिवरगणैश्च पूज्यमानः ।\nनहुषनृपवरोऽभवत्तदानीं हृदि महता हृच्छयेनतप्तः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003593074, "chapter_id": 23593, "verse_number": "१-१-१५-७५", "content_sanskrit": "नहुष उवाच ।\nइंद्राणी कथमद्यैव नायाति मम सन्निधौ ।\nतां चाह्वयत शीघ्रं भो मा विलंबितुमर्हथ ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003593075, "chapter_id": 23593, "verse_number": "१-१-१५-७६", "content_sanskrit": "नहुपस्य वचः श्रुत्वा बृहस्पतिरुदारधीः ।\nशचीभवनमासाद्य उवाच च सविस्तरम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003593076, "chapter_id": 23593, "verse_number": "१-१-१५-७७", "content_sanskrit": "शक्रस्य दुर्निमित्तेन ह्यनीतो नहुषोऽत्र वै ।\nराज्यार्ते भामिनि त्वं च अर्द्धासनगता भव ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003593077, "chapter_id": 23593, "verse_number": "१-१-१५-७८", "content_sanskrit": "शची प्रहस्य चोवाच बृहस्पतिमकल्मषम् ।\nअसौ न परिपूर्णो हि यज्ञैः शक्रासने स्थितः ।\nएकोनमश्वमेधानां शतं कृतमनेन वै ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003593078, "chapter_id": 23593, "verse_number": "१-१-१५-७९", "content_sanskrit": "तस्मान्न योग्यो प्रहस्य चोवाच बृहस्पतिमकल्पणषम् ।\nअसौ न परिपूर्णो हि यज्ञैः शक्रासने स्थितः ।\nअवाह्यवाहनेनैव अत्रागत्य लभेत माम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003593079, "chapter_id": 23593, "verse_number": "१-१-१५-८०", "content_sanskrit": "तथेति गत्वा त्वरितो बृहस्पतिरुवाच तम् ।\nनहुषं कामसंतप्तं शच्योक्तं च यथातथम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003593080, "chapter_id": 23593, "verse_number": "१-१-१५-८१", "content_sanskrit": "तथेति मत्वा राजासौ नहुषः काममोहितः ।\nविमृश्य परया बुद्ध्या अवाह्यं किं प्रशस्यते ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003593081, "chapter_id": 23593, "verse_number": "१-१-१५-८२", "content_sanskrit": "स बुद्ध्या च चिरं स्मृत्वा ब्राह्मणाश्चतपस्विनः ।\nअवाह्याश्च भवंत्यस्मादात्मानं वाहयाम्यहम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003593082, "chapter_id": 23593, "verse_number": "१-१-१५-८३", "content_sanskrit": "द्वाभ्यां च तस्याः प्राप्त्यर्थमिति मे हृदि वर्तते ।\nशिबिकां च ददौ ताभ्यां द्विजाभ्यां काममोहितः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003593083, "chapter_id": 23593, "verse_number": "१-१-१५-८४", "content_sanskrit": "उपविश्य तदा तस्यां शिवबिकायां समाहितः ।\nसर्पसर्पेति वचनान्नोदयामास तौ तदा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003593084, "chapter_id": 23593, "verse_number": "१-१-१५-८५", "content_sanskrit": "अगस्त्यः शिबिकावाही ततः क्रुद्धोऽशपन्नृपम् ।\nविप्राणामवमंता त्वमुन्मत्तोऽजगरो भव ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003593085, "chapter_id": 23593, "verse_number": "१-१-१५-८६", "content_sanskrit": "शापोक्तिमात्रतो राजा पतितो ब्राह्मणस्य हि ।\nतत्रैवाजगरो भूत्वा विप्रशापो दुरत्ययः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003593086, "chapter_id": 23593, "verse_number": "१-१-१५-८७", "content_sanskrit": "यथा हि नहुषो जातस्तथा सर्वेऽपि तादृशाः ।\nविप्राणामवमानेन पतिन्ति निरयेऽशुचौ ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003593087, "chapter_id": 23593, "verse_number": "१-१-१५-८८", "content_sanskrit": "तस्मासर्वप्रयत्नेन पदं प्राप्य विचक्षणैः ।\nअप्रमत्तैर्नरैर्भाव्यमिहामुत्र च लब्धये ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003593088, "chapter_id": 23593, "verse_number": "१-१-१५-८९", "content_sanskrit": "तथैव नहुषः सर्प्पो जातोरण्ये महाभये ।\nएवं चैवाभवत्तत्र देवलोके ह्यराजकम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003593089, "chapter_id": 23593, "verse_number": "१-१-१५-९०", "content_sanskrit": "तथैव ते सुराः सर्वे विस्मयाविष्टचेतसः ।\nअहो बत महत्कष्टं प्राप्तं राज्ञा ह्यनेन वै ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003593090, "chapter_id": 23593, "verse_number": "१-१-१५-९१", "content_sanskrit": "न मर्त्य लोको न स्वर्गो जातो ह्यस्य दुरात्मनः ।\nसतामवज्ञया सद्यः सुकृतं दग्धमेव हि ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003593091, "chapter_id": 23593, "verse_number": "१-१-१५-९२", "content_sanskrit": "याज्ञिको ह्यपरो लोके कथ्यतां च महामुने ।\nतदोवाच महातेजा नारदो मुनिसत्तमः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003593092, "chapter_id": 23593, "verse_number": "१-१-१५-९३", "content_sanskrit": "ययातिं च महाभागा आनयध्वं त्वरान्विताः ।\nदेवदूतास्तु वै तूर्णं ययातिं द्रुतमानयन् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003593093, "chapter_id": 23593, "verse_number": "१-१-१५-९४", "content_sanskrit": "विमानमारुह्य तदा महात्मा ययौ दिवं देवदूतैः समेतः ।\nपुरस्कृतो देववरैस्तदानीं तथोरगैर्यक्षगंधर्वसिद्धैः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003593094, "chapter_id": 23593, "verse_number": "१-१-१५-९५", "content_sanskrit": "आयातः सोऽमरावत्यां त्रिदशैरभितोषितः ।\nइंद्रासने चोपविष्टो बभाषे च स सत्वरम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003593095, "chapter_id": 23593, "verse_number": "१-१-१५-९६", "content_sanskrit": "नारदेनैवमुक्तस्तु त्वं राजा याज्ञिको ह्यसि ।\nसतामवज्ञया प्राप्तो नहुषो दंदशूकताम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003593096, "chapter_id": 23593, "verse_number": "१-१-१५-९७", "content_sanskrit": "ये प्राप्नुवंति धर्मिष्ठा दैवेन परमं पदम् ।\nप्राक्तनेनैव मूढास्ते न पश्यंति शुभाशुभम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003593097, "chapter_id": 23593, "verse_number": "१-१-१५-९८", "content_sanskrit": "पतंति नरके घोरे स्तब्धा वै नात्र संशयः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003593098, "chapter_id": 23593, "verse_number": "१-१-१५-९९", "content_sanskrit": "ययातिरुवाच ।\nयैः कृतं पुण्यं तेषां विघ्नः प्रजायते ।\nअल्पकत्वेन देवर्षे विद्धि सर्वं परं मम ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003593099, "chapter_id": 23593, "verse_number": "१-१-१५-१००", "content_sanskrit": "महादानानि दत्तानि अन्नदानयुतानि च ।\nगोदानानि बहून्येव भूमिदानयुतानि च ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003593100, "chapter_id": 23593, "verse_number": "१-१-१५-१०१", "content_sanskrit": "तथैव सर्वाण्यपि चोत्तमानि दानानि चोक्तानि मनीषिभिर्यदा ।\nएतानि सर्वाणि मया तदैव दत्तानि काले च महाविधानतः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003593101, "chapter_id": 23593, "verse_number": "१-१-१५-१०२", "content_sanskrit": "यज्ञैरिष्टं वाजपेयातिरात्रैर्ज्योतिष्टोमै राजसूयादिभिश्च ।\nशास्त्रप्रोक्तैरश्वमेधादिभिश्च यूपैरेषालंकृता भूः समंतात् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003593102, "chapter_id": 23593, "verse_number": "१-१-१५-१०३", "content_sanskrit": "देवदेवो जगन्नाथ इष्टो यज्ञैरनेकशः ।\nगालवाय पुरे दत्ता कन्या त्वेषा च माधवी ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003593103, "chapter_id": 23593, "verse_number": "१-१-१५-१०४", "content_sanskrit": "पत्नीत्वेन चतुर्भ्यश्च दत्ताः कन्या मुने तदा ।\nगालवस्य गुरोरर्थे विश्वामित्रस्य धीमतः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003593104, "chapter_id": 23593, "verse_number": "१-१-१५-१०५", "content_sanskrit": "एवं भूतान्यनेकानि सुकृतानि मया पुरा ।\nमहांति च बहून्येव तानि वक्तुं न पार्यते ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003593105, "chapter_id": 23593, "verse_number": "१-१-१५-१०६", "content_sanskrit": "भूयः पृष्टः सर्वदेवैः स राजा कृतं सर्वं गुप्तमेव यथार्थम् ।\nविज्ञातुमिच्छाम यथार्थतोपि सर्वे वयं श्रोतुकामा ययाते ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003593106, "chapter_id": 23593, "verse_number": "१-१-१५-१०७", "content_sanskrit": "वचो निशम्य देवानां ययातिरमितद्युतिः ।\nकथयामास तत्सर्वं पुण्यशेषं यथार्थतः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003593107, "chapter_id": 23593, "verse_number": "१-१-१५-१०८", "content_sanskrit": "कथितं सर्वमेतच्च निःशेषं व्यासवत्तदा ।\nस्वपुण्यकथनेनैव ययातिरपतद्भुवि ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003593108, "chapter_id": 23593, "verse_number": "१-१-१५-१०९", "content_sanskrit": "तत्क्षणादेव सर्वेषां सुराणां तत्र पश्यताम् ।\nएवमेव तथा जातमराजकमतंद्रितम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003593109, "chapter_id": 23593, "verse_number": "१-१-१५-११०", "content_sanskrit": "अन्यो न दृश्यते लोके याज्ञिको यो हि तत्र वै ।\nशक्रासनेऽभिषे कार्यं श्रूयतां हि द्विजोत्तमाः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003593110, "chapter_id": 23593, "verse_number": "१-१-१५-१११", "content_sanskrit": "सर्वे सुराश्च ऋषयोऽथ महाफणींद्रा गन्धर्वयक्षखगचारणकिंनराश्च ।\nविद्याधराः सुरगणाप्सरसां गणाश्च चिंतापराः समभवन्मनुजास्तथैव ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}]