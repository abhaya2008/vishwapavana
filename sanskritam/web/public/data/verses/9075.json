[{"id": 5000075000, "chapter_id": 9075, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे पञ्चसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000075001, "chapter_id": 9075, "verse_number": "१-७५-१", "content_sanskrit": "राम दाशरथे वीर वीर्यं ते श्रूयतेऽद्भुतम्।\nधनुषो भेदनं चैव निखिलेन मया श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000075002, "chapter_id": 9075, "verse_number": "१-७५-२", "content_sanskrit": "तदद्भुतमचिन्त्यं च भेदनं धनुषस्तथा।\nतच्छ्रुत्वाहमनुप्राप्तो धनुर्गृह्यापरं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000075003, "chapter_id": 9075, "verse_number": "१-७५-३", "content_sanskrit": "तदिदं घोरसंकाशं जामदग्न्यं महद्धनुः।\nपूरयस्व शरेणैव स्वबलं दर्शयस्व च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000075004, "chapter_id": 9075, "verse_number": "१-७५-४", "content_sanskrit": "तदहं ते बलं दृष्ट्वा धनुषोऽप्यस्य पूरणे।\nद्वन्द्वयुद्धं प्रदास्यामि वीर्यश्लाघ्यमहं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000075005, "chapter_id": 9075, "verse_number": "१-७५-५", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा राजा दशरथस्तदा।\nविषण्णवदनो दीनः प्राञ्जलिर्वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000075006, "chapter_id": 9075, "verse_number": "१-७५-६", "content_sanskrit": "क्षत्ररोषात् प्रशान्तस्त्वं ब्राह्मणश्च महातपाः।\nबालानां मम पुत्राणामभयं दातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000075007, "chapter_id": 9075, "verse_number": "१-७५-७", "content_sanskrit": "भार्गवाणां कुले जातः स्वाध्यायव्रतशालिनाम्।\nसहस्राक्षे प्रतिज्ञाय शस्त्रं प्रक्षिप्तवानसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000075008, "chapter_id": 9075, "verse_number": "१-७५-८", "content_sanskrit": "स त्वं धर्मपरो भूत्वा कश्यपाय वसुंधराम्।\nदत्त्वा वनमुपागम्य महेन्द्रकृतकेतनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000075009, "chapter_id": 9075, "verse_number": "१-७५-९", "content_sanskrit": "मम सर्वविनाशाय सम्प्राप्तस्त्वं महामुने।\nन चैकस्मिन् हते रामे सर्वे जीवामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000075010, "chapter_id": 9075, "verse_number": "१-७५-१०", "content_sanskrit": "ब्रुवत्येवं दशरथे जामदग्न्यः प्रतापवान्।\nअनादृत्य तु तद्वाक्यं राममेवाभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000075011, "chapter_id": 9075, "verse_number": "१-७५-११", "content_sanskrit": "इमे द्वे धनुषी श्रेष्ठे दिव्ये लोकाभिपूजिते।\nदृढे बलवती मुख्ये सुकृते विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000075012, "chapter_id": 9075, "verse_number": "१-७५-१२", "content_sanskrit": "अनुसृष्टं सुरैरेकं त्र्यम्बकाय युयुत्सवे।\nत्रिपुरघ्नं नरश्रेष्ठ भग्नं काकुत्स्थ यत्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000075013, "chapter_id": 9075, "verse_number": "१-७५-१३", "content_sanskrit": "इदं द्वितीयं दुर्धर्षं विष्णोर्दत्तं सुरोत्तमैः।\nतदिदं वैष्णवं राम धनुः परपुरंजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000075014, "chapter_id": 9075, "verse_number": "१-७५-१४", "content_sanskrit": "समानसारं काकुत्स्थ रौद्रेण धनुषा त्विदम्।\nतदा तु देवताः सर्वाः पृच्छन्ति स्म पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000075015, "chapter_id": 9075, "verse_number": "१-७५-१५", "content_sanskrit": "शितिकण्ठस्य विष्णोश्च बलाबलनिरीक्षया।\nअभिप्रायं तु विज्ञाय देवतानां पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000075016, "chapter_id": 9075, "verse_number": "१-७५-१६", "content_sanskrit": "विरोधं जनयामास तयोः सत्यवतां वरः।\nविरोधे तु महद् युद्धमभवद् रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000075017, "chapter_id": 9075, "verse_number": "१-७५-१७", "content_sanskrit": "शितिकण्ठस्य विष्णोश्च परस्परजयैषिणोः।\nतदा तु जृम्भितं शैवं धनुर्भीमपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000075018, "chapter_id": 9075, "verse_number": "१-७५-१८", "content_sanskrit": "हुंकारेण महादेवः स्तम्भितोऽथ त्रिलोचनः।\nदेवैस्तदा समागम्य सर्षिसङ्घः सचारणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000075019, "chapter_id": 9075, "verse_number": "१-७५-१९", "content_sanskrit": "याचितौ प्रशमं तत्र जग्मतुस्तौ सुरोत्तमौ।\nजृम्भितं तद् धनुर्दृष्ट्वा शैवं विष्णुपराक्रमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000075020, "chapter_id": 9075, "verse_number": "१-७५-२०", "content_sanskrit": "अधिकं मेनिरे विष्णुं देवाः सर्षिगणास्तथा।\nधनू रुद्रस्तु संक्रुद्धो विदेहेषु महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000075021, "chapter_id": 9075, "verse_number": "१-७५-२१", "content_sanskrit": "देवरातस्य राजर्षेर्ददौ हस्ते ससायकम्।\nइदं च वैष्णवं राम धनुः परपुरंजयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000075022, "chapter_id": 9075, "verse_number": "१-७५-२२", "content_sanskrit": "ऋचीके भार्गवे प्रादाद् विष्णुः स न्यासमुत्तमम्।\nऋचीकस्तु महातेजाः पुत्रस्याप्रतिकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000075023, "chapter_id": 9075, "verse_number": "१-७५-२३", "content_sanskrit": "पितुर्मम ददौ दिव्यं जमदग्नेर्महात्मनः।\nन्यस्तशस्त्रे पितरि मे तपोबलसमन्विते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000075024, "chapter_id": 9075, "verse_number": "१-७५-२४", "content_sanskrit": "अर्जुनो विदधे मृत्युं प्राकृतां बुद्धिमास्थितः।\nवधमप्रतिरूपं तु पितुः श्रुत्वा सुदारुणम्।\nक्षत्रमुत्सादयं रोषाज्जातं जातमनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000075025, "chapter_id": 9075, "verse_number": "१-७५-२५", "content_sanskrit": "पृथिवीं चाखिलां प्राप्य कश्यपाय महात्मने।\nयज्ञस्यान्तेऽददं राम दक्षिणां पुण्यकर्मणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000075026, "chapter_id": 9075, "verse_number": "१-७५-२६", "content_sanskrit": "दत्त्वा महेन्द्रनिलयस्तपोबलसमन्वितः।\nश्रुत्वा तु धनुषो भेदं ततोऽहं द्रुतमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000075027, "chapter_id": 9075, "verse_number": "१-७५-२७", "content_sanskrit": "तदेवं वैष्णवं राम पितृपैतामहं महत्।\nक्षत्रधर्मं पुरस्कृत्य गृह्णीष्व धनुरुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000075028, "chapter_id": 9075, "verse_number": "१-७५-२८", "content_sanskrit": "योजयस्व धनुःश्रेष्ठे शरं परपुरंजयम्।\nयदि शक्तोऽसि काकुत्स्थ द्वन्द्वं दास्यामि ते ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000075029, "chapter_id": 9075, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे पञ्चसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]