[{"id": 2095256, "chapter_id": 3034, "verse_number": "१३-१६४-१", "content_sanskrit": "युधिष्ठिर उवाच।\nपितामहेन विधिवद्यज्ञाः प्रोक्ता महात्मना।\nगुणाश्चैषां यथातथ्यं प्रेत्य चेह च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095257, "chapter_id": 3034, "verse_number": "१३-१६४-२", "content_sanskrit": "न तै शक्या दरिद्रेण यज्ञाः प्राप्तुं पितामह।\nबहूपकरणा यज्ञा नानासम्भारविस्तराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095258, "chapter_id": 3034, "verse_number": "१३-१६४-३", "content_sanskrit": "पार्थिवै राजपुत्रैर्वा शक्याः प्राप्तुं पितामह।\nनार्थन्यूनैरवगुणैरेकात्मभिरसंहतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095259, "chapter_id": 3034, "verse_number": "१३-१६४-४", "content_sanskrit": "यो दरिद्रैरपि विधिः शक्यः प्राप्तुं सदा भवेत्।\nअर्थन्यूनैरवगुणैरेकात्मभिरसंहतैः।\nतुल्यो यज्ञफलैरेतैस्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095260, "chapter_id": 3034, "verse_number": "१३-१६४-५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095261, "chapter_id": 3034, "verse_number": "१३-१६४-५", "content_sanskrit": "इदमङ्गिरसा प्रोक्तमुपवासफलात्मकम्।\nविधिं यज्ञफलैस्तुल्यं तन्निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095262, "chapter_id": 3034, "verse_number": "१३-१६४-६", "content_sanskrit": "यस्तु कल्यं तथा सायं भुञ्जानो नान्तरा पिबेत्।\nअहिंसानिरतो नित्यं जुह्वानो जातवेदसम्।\nषड्भिरेव स वर्षैस्तु सिध्यते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095263, "chapter_id": 3034, "verse_number": "१३-१६४-७", "content_sanskrit": "तप्तकाञ्चनवर्णं च विमानं लभते नरः।\nदेवस्त्रीणामधीवासे नृत्तगीतनिनादिते।\nप्राजापत्ये वसेत्पद्मं वर्षाणामग्निसन्निभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095264, "chapter_id": 3034, "verse_number": "१३-१६४-८", "content_sanskrit": "त्रीणि वर्षाणि यः प्राशेत्सततं त्वेकभोजनम्।\nधर्मत्नीरतो नित्यमग्निष्टोमफलं लभेत्।\nयज्ञं बहुसुवर्णं वा वासवप्रियमाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095265, "chapter_id": 3034, "verse_number": "१३-१६४-९", "content_sanskrit": "सत्यवान्दानशीलश्च ब्रह्मण्यश्चानसूयकः।\nक्षान्तो दान्तो जितक्रोधः स गच्छति परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095266, "chapter_id": 3034, "verse_number": "१३-१६४-१०", "content_sanskrit": "पाण्डुराभ्रपतीकाशे विमाने हंसलक्षणे।\nद्वे समाप्ते ततः पद्मे सोप्सरोभिर्वसेत्सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095267, "chapter_id": 3034, "verse_number": "१३-१६४-११", "content_sanskrit": "द्वितीये दिवसे यस्तु प्राश्नीयादेकभोजनम्।\nसदा द्वादशमासांस्तु जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2095268, "chapter_id": 3034, "verse_number": "१३-१६४-१२", "content_sanskrit": "अग्निकार्यपरो नित्यं नित्यं कल्यप्रबोधनः।\nअग्निष्टोमस्य यज्ञस्य फलं प्राप्नोति मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2095269, "chapter_id": 3034, "verse_number": "१३-१६४-१३", "content_sanskrit": "हंससारसयुक्तं च विमानं लभते नरः।\nइन्द्रलोके च वसते वरस्त्रीभिः समावृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2095270, "chapter_id": 3034, "verse_number": "१३-१६४-१४", "content_sanskrit": "तृतीये दिवसे यस्तु प्राश्नीयादेकभोजनम्।\nसदा द्वादशमासांस्तु जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2095271, "chapter_id": 3034, "verse_number": "१३-१६४-१५", "content_sanskrit": "अग्निकार्यपरो नित्यं नित्यं कल्यप्रबोधनः।\nअतिरात्रस्य यज्ञस्य फलं प्राप्नोत्यनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2095272, "chapter_id": 3034, "verse_number": "१३-१६४-१६", "content_sanskrit": "मयूरहंसयुक्तं च विमानं लभते नरः।\nसप्तर्षीणां सदा लोके सोप्सरोभिर्वसेत्सह।\nनिवर्तनं च तत्रास्य त्रीणि पद्मानि वै विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2095273, "chapter_id": 3034, "verse_number": "१३-१६४-१७", "content_sanskrit": "दिवसे यश्चतुर्थे तु प्राश्नीयादेकभोजनम्।\nसदा द्वादशमासान्वै जुह्वानो जातवेदसम्।\nवाजपेयस्य यज्ञस्य फलं प्राप्नीत्यनुत्तमम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2095274, "chapter_id": 3034, "verse_number": "१३-१६४-१८", "content_sanskrit": "इन्द्रिकन्याभिरूढं च विमान लभते नरः।\nसागरस्य च पर्यन्ते वासवं लोकमावसेत्।\nदेवराजस्य च क्रीडां नित्यकालमवेक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2095275, "chapter_id": 3034, "verse_number": "१३-१६४-१९", "content_sanskrit": "दिवसे पञ्चमे यस्तु प्राश्नीयादैकभोजनम्।\nसदा द्वादशमासांस्तु जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2095276, "chapter_id": 3034, "verse_number": "१३-१६४-२०", "content_sanskrit": "अलुब्धः। सत्यवादी च ब्रह्मण्यश्चाविहिंसकः।\nअनसूयुरपापस्थो द्वादशाहफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2095277, "chapter_id": 3034, "verse_number": "१३-१६४-२१", "content_sanskrit": "जाम्बूनदमयं दिव्यं विमानं हंसलक्षणम्।\nसूर्यमालासमाभासमारोहेत्पाण्डुरं गुहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2095278, "chapter_id": 3034, "verse_number": "१३-१६४-२२", "content_sanskrit": "आवर्तनानि चत्वारि तथा पद्मानि द्वादश।\nशराग्निपरिमाणं च तत्रासौ वसते सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2095279, "chapter_id": 3034, "verse_number": "१३-१६४-२३", "content_sanskrit": "दिवसे यस्तु षष्ठे वै मुनिः प्राशेत भोजनम्।\nसदा द्वादशमासान्वै जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2095280, "chapter_id": 3034, "verse_number": "१३-१६४-२४", "content_sanskrit": "सदा त्रिषवणस्नायी ब्रह्मचार्यनसूयकः।\nगवामयनयज्ञस्य फलं प्राप्नोत्यनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2095281, "chapter_id": 3034, "verse_number": "१३-१६४-२५", "content_sanskrit": "अग्निज्वालासमाभासं हंसबर्हिणसेवितम्।\nशातकुम्भसमायुक्तं साधयेद्यानमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2095282, "chapter_id": 3034, "verse_number": "१३-१६४-२६", "content_sanskrit": "तथैवाप्सरसामङ्के प्रतिसुप्तः प्रबोध्यते।\nनूपुराणां निनादेन मेखलानां च निःस्वनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2095283, "chapter_id": 3034, "verse_number": "१३-१६४-२७", "content_sanskrit": "कोटीसहस्रं वर्षाणां त्रीणि कोटिशतानि च।\nपद्मान्यष्टादश तथा पताके द्वे तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2095284, "chapter_id": 3034, "verse_number": "१३-१६४-२८", "content_sanskrit": "अयुतानि च पञ्चशदृक्षचर्मशतस्य च।\nलोम्नां प्रमाणेन समं ब्रह्मलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2095285, "chapter_id": 3034, "verse_number": "१३-१६४-२९", "content_sanskrit": "दिवसे सप्तमे यस्तु प्राश्नीयादेकभोजनम्।\nसदा द्वादशमासान्वै जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2095286, "chapter_id": 3034, "verse_number": "१३-१६४-३०", "content_sanskrit": "सरस्वतीं गोपयानो ब्रह्मचर्यं समाचरन्।\nसुमनोवर्णकं चैव मधु मांसं च वर्जयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2095287, "chapter_id": 3034, "verse_number": "१३-१६४-३१", "content_sanskrit": "पुरुषो मरुतां लोकमिन्द्रलोकं च गच्छति।\nतत्रतत्र हि सिद्धार्थो देवकन्याभिरुह्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2095288, "chapter_id": 3034, "verse_number": "१३-१६४-३२", "content_sanskrit": "फलं बहुसुवर्णस्य यज्ञस्य लभते नरः।\nसङ्ख्यामतिगुणां चापि तेषु लोकेषु मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2095289, "chapter_id": 3034, "verse_number": "१३-१६४-३३", "content_sanskrit": "यस्तु संवत्सरं क्षान्तो भुङ्क्तेऽहन्यष्टमे नरः।\nदेवकार्यपरो नित्यं जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2095290, "chapter_id": 3034, "verse_number": "१३-१६४-३४", "content_sanskrit": "पौण्डरीकस्य यज्ञस्य फलं प्राप्नोत्यनुत्तमम्।\nपद्मवर्णनिभं चैव विमानमधिरोहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2095291, "chapter_id": 3034, "verse_number": "१३-१६४-३५", "content_sanskrit": "मृष्टाः कनकगौर्यश्च नार्यः श्यामास्तथा पराः।\nवयोरूपविलासिन्यो लभते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2095292, "chapter_id": 3034, "verse_number": "१३-१६४-३६", "content_sanskrit": "यस्तु संवत्सरं भुङ्क्ते नवमेनवमेऽहनि।\nसदा द्वादशमासान्वै जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2095293, "chapter_id": 3034, "verse_number": "१३-१६४-३७", "content_sanskrit": "अश्वमेधसहस्रस्य फलं प्राप्नोत्यनुत्तमम्।\nपुण्डरीकप्रकाशं च विमानं लभते नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2095294, "chapter_id": 3034, "verse_number": "१३-१६४-३८", "content_sanskrit": "दीप्तसूर्याग्नितेजोभिर्दिव्यमालाभिरेव च।\nनीयते रुद्रकन्याभिः सोन्तरिक्षं सनातनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2095295, "chapter_id": 3034, "verse_number": "१३-१६४-३९", "content_sanskrit": "अष्टादशसहस्राणि वर्षाणां कल्पमेव च।\nकोटीशतसहस्रं च तेषु लोकेषु मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2095296, "chapter_id": 3034, "verse_number": "१३-१६४-४०", "content_sanskrit": "यस्तु संवत्सरं भुङ्क्ते दशाहे वै गतेगते।\nसदा द्वादश मासान्वै जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2095297, "chapter_id": 3034, "verse_number": "१३-१६४-४१", "content_sanskrit": "ब्रह्मकन्यानिवासे स सर्वभूतमनोहरे।\nअश्वमेधसहस्रस्य फलं प्राप्नोत्यनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2095298, "chapter_id": 3034, "verse_number": "१३-१६४-४२", "content_sanskrit": "रूपवत्यश्च तं कन्या रमयन्ति सदा नरम्।\nनीलोत्पलनिभैर्वर्णै रक्तोत्पलनिभैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2095299, "chapter_id": 3034, "verse_number": "१३-१६४-४३", "content_sanskrit": "विमानं मण्डलावर्तमावर्तगहनाकुलम्।\nसागरोर्मिप्रतीकाशं स लभेद्यानमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2095300, "chapter_id": 3034, "verse_number": "१३-१६४-४४", "content_sanskrit": "विचित्रमणिमालाभिर्नादितं शङ्खनिःस्वनैः।\nस्फाटिकैर्वज्रसारैश्च स्तम्भैः सुकृतवेदिकम्।\nआरोहति महद्यानं हंससारसवाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2095301, "chapter_id": 3034, "verse_number": "१३-१६४-४५", "content_sanskrit": "एकादशे तु दिवसे यः प्राप्ते प्राशते हविः।\nसदा द्वादशमासांस्तु जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2095302, "chapter_id": 3034, "verse_number": "१३-१६४-४६", "content_sanskrit": "परिस्त्रियं नाभिलषेद्वाचाथ मनसाऽपि वा।\nअनृतं च न भाषेत मातापित्रोःक कृतेऽपि वा।\nअभिगच्छेन्महादेवं विमानस्थं महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2095303, "chapter_id": 3034, "verse_number": "१३-१६४-४७", "content_sanskrit": "अश्वमेधसहस्रस्य फलं प्राप्नोत्यनुत्तमम्।\nस्वायंभुवं च पश्येत विमानं समुपस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2095304, "chapter_id": 3034, "verse_number": "१३-१६४-४८", "content_sanskrit": "कुमार्यः काञ्चनाभासा रूपवत्यो नयन्ति तम्।\nरुद्राणां तमधीवासं दिवि दिव्यं मनोहरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2095305, "chapter_id": 3034, "verse_number": "१३-१६४-४९", "content_sanskrit": "वर्षाण्यपरिमेयानि युगान्तमपि चावसेत्।\nकोटीशतसहस्रं च दशकोटिशतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2095306, "chapter_id": 3034, "verse_number": "१३-१६४-५०", "content_sanskrit": "रुद्रं नित्यं प्रणमते देवदानवसम्मतम्।\nस तस्मै दर्शनं प्राप्तो दिवसेदिवसे भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2095307, "chapter_id": 3034, "verse_number": "१३-१६४-५१", "content_sanskrit": "दिवसे द्वादशे यस्तु प्राप्तो वै प्राशते हविः।\nसदा द्वादश मासान्वै जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2095308, "chapter_id": 3034, "verse_number": "१३-१६४-५२", "content_sanskrit": "नियमेन समायुक्तः सर्वमेधफलं लभेत।\nआदित्यैर्द्वादशैस्तस्य विमानं संविधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2095309, "chapter_id": 3034, "verse_number": "१३-१६४-५३", "content_sanskrit": "मणिमुक्ताप्रवालैश्च महार्हैरुपशोभितम्।\nहंसभासा परिक्षिप्तं नागवीथीसमाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2095310, "chapter_id": 3034, "verse_number": "१३-१६४-५४", "content_sanskrit": "मयूरैश्चक्रवाकैश्च कूजद्भिरुपशोभितम्।\nअट्टैर्महद्भिः संयुक्तं ब्रह्मलोके प्रतिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2095311, "chapter_id": 3034, "verse_number": "१३-१६४-५५", "content_sanskrit": "नित्यमावसथं राजन्नरनारीसमावृतम्।\nऋषिरेवं महाभागस्त्वङ्गिराः प्राह धर्मिवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2095312, "chapter_id": 3034, "verse_number": "१३-१६४-५६", "content_sanskrit": "त्रयोदशे तु दिवसे प्राप्ते यः प्राशते हविः।\nसदा द्वादश मासान्वै देवसत्रफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2095313, "chapter_id": 3034, "verse_number": "१३-१६४-५७", "content_sanskrit": "रक्तपद्मोदयं नाम विमानं साधयेन्नरः।\nजातरूपप्रयुक्तं च रत्नसञ्चयभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2095314, "chapter_id": 3034, "verse_number": "१३-१६४-५८", "content_sanskrit": "देवकन्याभिराकीर्णं दिव्याभरणभूषितम्।\nपुण्यगन्धोदयं दिव्यं वादित्रैरुपशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2095315, "chapter_id": 3034, "verse_number": "१३-१६४-५९", "content_sanskrit": "तत्र शङ्कुपताके द्वे युगान्तं कल्पमेव च।\nअयुतायुतं तथा पद्मं समुद्रं च तथा वसेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2095316, "chapter_id": 3034, "verse_number": "१३-१६४-६०", "content_sanskrit": "गीतगन्धर्वघोषैश्च भेरीपणवनिःस्वनैः।\nसदा प्रह्लादितस्ताभिर्देवकन्याभिरीड्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2095317, "chapter_id": 3034, "verse_number": "१३-१६४-६१", "content_sanskrit": "चतुर्दशे तु दिवसे यः पूर्णे प्राशते हविः।\nसदा द्वादशमासांस्तु महामेधफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2095318, "chapter_id": 3034, "verse_number": "१३-१६४-६२", "content_sanskrit": "अनिर्देश्यवयोरूपा देवकन्याः स्वलङ्कृताः।\nमृष्टतप्ताङ्गदधरा विमानैरुपयान्ति तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2095319, "chapter_id": 3034, "verse_number": "१३-१६४-६३", "content_sanskrit": "कलहंसविनिर्घोषैर्नूपुराणां च निःखनैः।\nकाञ्चीनां च समुत्कर्षैस्तत्रतत्र निबोध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2095320, "chapter_id": 3034, "verse_number": "१३-१६४-६४", "content_sanskrit": "देवकन्यानिवासे च तस्मिन्वसति मानवः।\nजाह्नवीवालुकाकीर्णं पूर्णं संवत्सरं नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2095321, "chapter_id": 3034, "verse_number": "१३-१६४-६५", "content_sanskrit": "यस्तु पक्षे गते भुङ्क्ते एकभक्तं जितेन्द्रियः।\nसदा द्वादशमासांस्तु जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2095322, "chapter_id": 3034, "verse_number": "१३-१६४-६६", "content_sanskrit": "राजसूयसहस्रस्य फलं प्राप्नोत्यनुत्तमम्।\nयानमारोहते दिव्यं हंसबर्हिणलक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2095323, "chapter_id": 3034, "verse_number": "१३-१६४-६७", "content_sanskrit": "मणिमण्डलकैश्चित्रं जातरूपसमावृतम्।\nदिव्याभरणशोभाभिर्वरस्त्रीभिरलङ्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2095324, "chapter_id": 3034, "verse_number": "१३-१६४-६८", "content_sanskrit": "एकस्तम्भं चतुर्द्वारं सप्तभौमं सुमङ्गलम्।\nवैजयन्तीसहस्रैश्च शोभितं गीतनिःस्वनै।\nदिव्यं दिव्यगुणोपेतं विमानमधिरोहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2095325, "chapter_id": 3034, "verse_number": "१३-१६४-६९", "content_sanskrit": "मणिमुक्ताप्रवालैश्च भूषितं वैद्युतप्रभम्।\nवसेद्युगसहस्रं च खड्गकुञ्जरवाहनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2095326, "chapter_id": 3034, "verse_number": "१३-१६४-७०", "content_sanskrit": "षोडशे दिवसे यस्तु सम्प्राप्ते प्राशते हविः।\nसदा द्वादशमासान्वै सोमयज्ञफलं लभेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2095327, "chapter_id": 3034, "verse_number": "१३-१६४-७१", "content_sanskrit": "सोमकन्यानिवासेषु सोऽध्यावसति नित्यशः।\nसौम्यगन्धानुलिप्तश्च कामचारगतिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2095328, "chapter_id": 3034, "verse_number": "१३-१६४-७२", "content_sanskrit": "सुदर्शनाभिर्नारीभिर्मधुराभिस्तथैव च।\nअर्च्यते वै विमानस्थः कामभोगैश्च सेव्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2095329, "chapter_id": 3034, "verse_number": "१३-१६४-७३", "content_sanskrit": "फलं पद्मशतप्रख्यं महाकल्पं दशाधिकम्।\nआवर्तनानि चत्वारि साधयेच्चाप्यसौ नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2095330, "chapter_id": 3034, "verse_number": "१३-१६४-७४", "content_sanskrit": "दिवसे सप्तदशमे यः प्राप्ते प्राशते हविः।\nसदा द्वादशमासान्वै जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2095331, "chapter_id": 3034, "verse_number": "१३-१६४-७५", "content_sanskrit": "स्थानं वारुणमैन्द्रं च रौद्रं वाऽप्यधिगच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2095332, "chapter_id": 3034, "verse_number": "१३-१६४-७६", "content_sanskrit": "मारुतं शयनं चैव ब्रह्मलोकं स गच्छति।\nतत्र दैवतकन्याभिरासनेनोपचर्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2095333, "chapter_id": 3034, "verse_number": "१३-१६४-७७", "content_sanskrit": "भूर्भुवःस्वश्च देवर्षिर्विश्वरूपमवेक्षते।\nतत्र देवाधिदेवस्य कुमार्यो रमयन्ति तम्।\nद्वात्रिंशद्रूपदारिण्यो मधुराः समलङ्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2095334, "chapter_id": 3034, "verse_number": "१३-१६४-७८", "content_sanskrit": "चन्द्रादित्यावुभौ यावद्गगते चरतः प्रभो।\nतावच्चरत्यसौ धीरः सुधातुल्यरसाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2095335, "chapter_id": 3034, "verse_number": "१३-१६४-७९", "content_sanskrit": "अष्टादशे यो दिवसे प्राश्नीयादेकभोजनम्।\nसदा द्वादशमासान्वै सप्तलोकान्स पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2095336, "chapter_id": 3034, "verse_number": "१३-१६४-८०", "content_sanskrit": "रथैः स नन्दिघोषैश्च पृष्ठतः सोऽनुगम्यते।\nदेवकन्याधिरूढैस्तु भ्राजमानैः स्वलंकृतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2095337, "chapter_id": 3034, "verse_number": "१३-१६४-८१", "content_sanskrit": "व्याघ्रसिंहप्रयुक्तं च मेघस्वननिनादितम्।\nविमानमुत्तमं दिव्यं सुसुखि ह्यधिरोहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2095338, "chapter_id": 3034, "verse_number": "१३-१६४-८२", "content_sanskrit": "तत्र कल्पसहस्रं स कन्याभिः सह मोदते।\nसुधारसं च भुञ्जीत अमृतोपममुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2095339, "chapter_id": 3034, "verse_number": "१३-१६४-८३", "content_sanskrit": "एकोनविंशदिवसे यो भुङ्क्ते एकभोजनम्।\nसदा द्वादशमासान्वै सप्त लोकान्स पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2095340, "chapter_id": 3034, "verse_number": "१३-१६४-८४", "content_sanskrit": "उत्तमं लभते स्थानमप्सरोगणसेवितम्।\nगन्धर्वैरुपगीतं च विमानं सूर्यवर्चसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2095341, "chapter_id": 3034, "verse_number": "१३-१६४-८५", "content_sanskrit": "तत्रामरवरस्त्रीभिर्मोदते विगतज्वरः।\nदिव्याम्बरधरः श्रीमानयुतानां शतंशतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2095342, "chapter_id": 3034, "verse_number": "१३-१६४-८६", "content_sanskrit": "पूर्णेऽथ विंशे दिवसे यो भुङ्क्ते ह्येकभोजनम्।\nसदा द्वादशमासांस्तु सत्यवादी धृतव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2095343, "chapter_id": 3034, "verse_number": "१३-१६४-८७", "content_sanskrit": "अमांसाशी ब्रह्मचारी सर्वभूतहिते रतः।\nस लोकान्विपुलान्रम्यानादित्यानामुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2095344, "chapter_id": 3034, "verse_number": "१३-१६४-८८", "content_sanskrit": "गन्धर्वैरप्सरोभिश्च दिव्यमाल्यानुलेपनैः।\nविमानैः काञ्चनैर्हृद्यैः पृष्ठतश्चानुगम्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2095345, "chapter_id": 3034, "verse_number": "१३-१६४-८९", "content_sanskrit": "एकविंशो तु दिवसे यो भुङ्क्ते ह्येकभोजनम्।\nसदा द्वादशमासान्वै जुह्वानो जातवेदसम्।\nलोकमौशनसं दिव्यं शक्रलोकं च गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2095346, "chapter_id": 3034, "verse_number": "१३-१६४-९०", "content_sanskrit": "अश्विनोर्मरुतां चैव सुखेष्वभिरतः सदा।\nअनभिज्ञश्च दुःखानां विमानवरमास्थितः।\nसेव्यमानो वरस्त्रीभिः क्रीडत्यमरवत्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2095347, "chapter_id": 3034, "verse_number": "१३-१६४-९१", "content_sanskrit": "द्वाविंशे दिवसे प्राप्ते यो भुङ्क्ते ह्येकभोजनम्।\nसदा द्वादश मासान्वै जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2095348, "chapter_id": 3034, "verse_number": "१३-१६४-९२", "content_sanskrit": "अहिंसानिरतो धीमान्सत्यवागनसूयकः।\nलोकान्वसूनामाप्नोति दिवाकरसमप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2095349, "chapter_id": 3034, "verse_number": "१३-१६४-९३", "content_sanskrit": "कामचारी सुधाहारो विमानवरमास्थितः।\nरमते देवकन्याभिर्दिव्याभरणभूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2095350, "chapter_id": 3034, "verse_number": "१३-१६४-९४", "content_sanskrit": "त्रयोविंशे तु दिवसे प्राशेद्यस्त्वेकभोजनम्।\nसदा द्वादशमासांस्तु मिताहारो जितेन्द्रियः।\nवायोरुशनसस्चैव रुद्रलोकं च गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2095351, "chapter_id": 3034, "verse_number": "१३-१६४-९५", "content_sanskrit": "कामचारी कामगमः पूज्यमानोऽप्सरोगणैः।\nअनेकयुगपर्यन्तं विमानवरमास्थितः।\nरमते देवकन्याभिर्दिव्याभरणभूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2095352, "chapter_id": 3034, "verse_number": "१३-१६४-९६", "content_sanskrit": "चतुर्विंशे तु दिवसे यः प्राप्ते प्राशते हविः।\nसदा द्वादशमासांश्च जुह्वानो जातवेदसम्।\nआदित्यानामधीवासे मोदमानो वसेच्चिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2095353, "chapter_id": 3034, "verse_number": "१३-१६४-९७", "content_sanskrit": "दिव्यमाल्याम्बरधरो दिव्यगन्धानुलेपनः।\nविमाने काञ्चने दिव्ये हंसयुक्ते मनोरमे।\nरमते देवकन्यानां सहस्रैरयुतैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2095354, "chapter_id": 3034, "verse_number": "१३-१६४-९८", "content_sanskrit": "पञ्चविंशे तु दिवसे यः प्राशेदेकभोजनम्।\nसदा द्वादशमासांस्तु पुष्कलं यानमारुहेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2095355, "chapter_id": 3034, "verse_number": "१३-१६४-९९", "content_sanskrit": "सिंहव्याग्रप्रयुक्तैस्तु मेघनिःस्वननादितैः।\nस रथैर्नन्दिघोषैश्च पृष्ठतो ह्यनुगम्यते।\nदेवकन्यासमारूढैः काञ्चनैर्विमलैः शुभैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2095356, "chapter_id": 3034, "verse_number": "१३-१६४-१००", "content_sanskrit": "विमानमुत्तमं दिव्यमास्थाय सुमनोहरम्।\nतत्र कल्पसहस्रं वै वसते स्त्रीशतावृते।\nसुधारसं चोपजीवन्नमृतोपममुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2095357, "chapter_id": 3034, "verse_number": "१३-१६४-१०१", "content_sanskrit": "षड्विंशे दिवसे यस्तु प्रकुर्यादेकभोजनम्।\nसदा द्वादशमासांस्तु नियतो नियताशनः।\nजितेन्द्रियो वीतरागो जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2095358, "chapter_id": 3034, "verse_number": "१३-१६४-१०२", "content_sanskrit": "स प्राप्नोति महाभागः पूज्यमानोऽप्सरोगणैः।\nसप्तानां मरुतां लोकान्वसूनां चापि सोश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2095359, "chapter_id": 3034, "verse_number": "१३-१६४-१०३", "content_sanskrit": "विमानैः स्फाटिकैर्दिव्यैःइ सर्वरत्नैरलङ्कृतैः।\nगन्धर्वैरप्सरोभिश्चि पूज्यमानः प्रमोदते।\nद्वेऽर्बुदानां सहस्रे तु दिव्ये दिव्येन तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2095360, "chapter_id": 3034, "verse_number": "१३-१६४-१०४", "content_sanskrit": "सप्तविंशेऽथ दिवसे यः कुर्यादेकभोजनम्।\nसदा द्वादशमासांस्तु जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2095361, "chapter_id": 3034, "verse_number": "१३-१६४-१०५", "content_sanskrit": "फलं प्राप्नोति विपुलं देवलोके च पूज्यते।\nअमृताशी वसंस्तत्र स वितृपः प्रमोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2095362, "chapter_id": 3034, "verse_number": "१३-१६४-१०६", "content_sanskrit": "देवर्षिचरिताँल्लोकान्राजर्षिभिरनुष्ठितान्।\nअध्यावसति दिव्यात्मा विमानवरमास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2095363, "chapter_id": 3034, "verse_number": "१३-१६४-१०७", "content_sanskrit": "स्त्रीभिर्मिनोभिरामाभी रममाणो मदोत्कटः।\nयुगकल्पसहस्राणि त्रीण्यावसति वै सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2095364, "chapter_id": 3034, "verse_number": "१३-१६४-१०८", "content_sanskrit": "योऽष्टाविंशे तु दिवसे प्राश्नीयादेकभोजनम्।\nसदा द्वादशमासांस्तु जितात्मा विजितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2095365, "chapter_id": 3034, "verse_number": "१३-१६४-१०९", "content_sanskrit": "फलं देवर्षिचरितं विपुलं समुपाश्नुते।\nभोगवांस्तेजसा भाति सहस्रांशुरिवामलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2095366, "chapter_id": 3034, "verse_number": "१३-१६४-११०", "content_sanskrit": "सुकुमार्यश्च नार्यस्तं रममाणाः सुवर्चसः।\nपीनस्तनोरुजघना दिव्याभरणभूषिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2095367, "chapter_id": 3034, "verse_number": "१३-१६४-१११", "content_sanskrit": "रमयन्ति मनःकान्ता विमाने सूर्यसन्निबे।\nसर्वकामगमे दिव्ये कल्पायुतशतं समाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2095368, "chapter_id": 3034, "verse_number": "१३-१६४-११२", "content_sanskrit": "एकोनत्रिंशदिवसे यः प्राशेदेकभोजनम्।\nतस्य लोकाः शुभा दिव्या देवराजर्षिपूजिताः॥\nतस्य लोकाः शुभा दिव्या देवराजर्षिपूजिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2095369, "chapter_id": 3034, "verse_number": "१३-१६४-११३", "content_sanskrit": "विमानं सूर्यचन्द्राभं दिव्यं समधिगच्छति।\nजातरूपमयं युक्तं सर्वरत्नसमन्वितम्।\nअप्सरोगणसङ्कीर्णं गन्धर्वैरभिनादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2095370, "chapter_id": 3034, "verse_number": "१३-१६४-११४", "content_sanskrit": "तत्र चैनं शुभा नार्यो दिव्याभरणभूषिताः।\nमनोभिरामा मधुरा रमयन्ति मदोत्कटाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2095371, "chapter_id": 3034, "verse_number": "१३-१६४-११५", "content_sanskrit": "भोगवांस्तेजसा युक्तो वैश्वानरसमप्रभः।\nदिव्यो दिव्येन वपुषा भ्राजमान इवामरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2095372, "chapter_id": 3034, "verse_number": "१३-१६४-११६", "content_sanskrit": "वसूनां मरुतां चैव साध्यानामश्विनोस्तथा।\nरुद्राणां च तथा लोकं ब्रह्मलोकं च गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2095373, "chapter_id": 3034, "verse_number": "१३-१६४-११७", "content_sanskrit": "यस्तु मासे गते भुङ्क्ते एकभक्तं समाहितः।\nसदा द्वादश मासान्वै ब्रह्म्लोकमवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2095374, "chapter_id": 3034, "verse_number": "१३-१६४-११८", "content_sanskrit": "सुधारसकृताहार श्रीमान्सर्वमनोहरः।\nतेजसा वपुषा लक्ष्म्या भ्राजते रश्मिवानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2095375, "chapter_id": 3034, "verse_number": "१३-१६४-११९", "content_sanskrit": "दिव्यमाल्याम्बरधरो दिव्यगन्धानुलेपनः।\nसुखेष्वभिरतो भोगी दुःखानामविजानकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2095376, "chapter_id": 3034, "verse_number": "१३-१६४-१२०", "content_sanskrit": "स्वयंप्रभाभिर्नारीभिर्विमानस्थो महीयते।\nरुद्रदेवर्षिकन्याभिः सततं चाभिपूज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2095377, "chapter_id": 3034, "verse_number": "१३-१६४-१२१", "content_sanskrit": "नानारमणरूपाभिर्नानारागाभिरेव च।\nनानामधुरभाषाभिर्नानारतिभिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2095378, "chapter_id": 3034, "verse_number": "१३-१६४-१२२", "content_sanskrit": "विमाने गगनाकारे सूर्यवैडूर्यसन्निभे।\nपृष्ठतः सोमसङ्करो उदर्के चाभ्रसन्निभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2095379, "chapter_id": 3034, "verse_number": "१३-१६४-१२३", "content_sanskrit": "दक्षिणायां तु रक्ताभे अधस्तान्नीलमण्डले।\nऊर्ध्वं विचित्रसङ्काशे नैको वसति पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2095380, "chapter_id": 3034, "verse_number": "१३-१६४-१२४", "content_sanskrit": "यावद्वर्षसहस्रं वै जम्बूद्वीपे प्रवर्षति।\nतावत्संवत्सराः प्रोक्ता ब्रह्मलोकेऽस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2095381, "chapter_id": 3034, "verse_number": "१३-१६४-१२५", "content_sanskrit": "विप्रुषश्चैव यावन्त्यो निपतन्ति नभस्तलात्।\nवर्षासु वर्षतस्तावन्निवसत्यमरप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2095382, "chapter_id": 3034, "verse_number": "१३-१६४-१२६", "content_sanskrit": "मासोपवासी वर्षैस्तु दशभिः स्वर्गमुत्तमम्।\nमहर्षित्वमथासाद्य सशरीरगतिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2095383, "chapter_id": 3034, "verse_number": "१३-१६४-१२७", "content_sanskrit": "मुनिर्दान्तो जितक्रोधो जितशिश्नोदरः सदा।\nजुह्वन्नग्नींश्च नियतः सन्ध्योपासनसेविता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2095384, "chapter_id": 3034, "verse_number": "१३-१६४-१२८", "content_sanskrit": "बहुभिर्नियमैरेवं शुचिरश्नाति यो नरः।\nअभ्रावकाशशीलश्च तस्य भानोरिव त्विषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2095385, "chapter_id": 3034, "verse_number": "१३-१६४-१२९", "content_sanskrit": "दिवं गत्वा शरीरेण स्वेन राजन्यथाऽमरः।\nस्वर्गं पुण्यं यथाकाममुपभुङ्क्ते तथाविधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2095386, "chapter_id": 3034, "verse_number": "१३-१६४-१३०", "content_sanskrit": "एथ ते भरतश्रेष्ठ यज्ञानां विधिरुत्तमः।\nव्याख्यातो ह्यानुपूर्व्येण उपवासफलात्मकः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2095387, "chapter_id": 3034, "verse_number": "१३-१६४-१३१", "content_sanskrit": "दरिद्रैर्मनुजैः पार्थ प्राप्यं यज्ञफलं यथा॥\nदेवद्विजातिपूजायां रतो भरतसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2095388, "chapter_id": 3034, "verse_number": "१३-१६४-१३२", "content_sanskrit": "उपवासविधिस्त्वेष विस्तरेण प्रकीर्तितः।\nनियतेष्वप्रमत्तेषु शौचवत्सु महात्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2095389, "chapter_id": 3034, "verse_number": "१३-१६४-१३३", "content_sanskrit": "दम्भद्रोहनिवृत्तेषु कृतबुद्धिषु भारत।\nअचलेष्वप्रकम्पेषु मा ते भूदत्र संशयः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2095390, "chapter_id": 3034, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुःषष्ट्यधिकशततमोऽध्यायः॥ १६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}]