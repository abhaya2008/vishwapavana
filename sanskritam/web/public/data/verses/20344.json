[{"id": 7000344000, "chapter_id": 20344, "verse_number": "२-१६-१", "content_sanskrit": "सुमनोवाच ।\nअंगारसंचये मार्गे घृष्यमाणो हि नीयते ।\nदह्यमानः स दुष्टात्मा चेष्टमानः पुनः पुनः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000344001, "chapter_id": 20344, "verse_number": "२-१६-२", "content_sanskrit": "यत्रातपो महातीव्रो द्वादशादित्यतापितः ।\nनीयते तेन मार्गेण संतप्तः सूर्यरश्मिभिः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000344002, "chapter_id": 20344, "verse_number": "२-१६-३", "content_sanskrit": "पर्वतेष्वेव दुर्गेषु छायाहीनेषु दुर्मतिः ।\nनीयते तेन मार्गेण क्षुधातृष्णाप्रपीडितः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000344003, "chapter_id": 20344, "verse_number": "२-१६-४", "content_sanskrit": "स दूतैर्हन्यमानस्तु गदाखड्गैः परश्वधैः ।\nकशाभिस्ताड्यमानस्तु निंद्यमानस्तु दूतकैः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000344004, "chapter_id": 20344, "verse_number": "२-१६-५", "content_sanskrit": "ततः शीतमये मार्गे वायुना सेव्यते पुनः ।\nतेन शीतेन दुःखी स भूत्वा याति न संशयः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000344005, "chapter_id": 20344, "verse_number": "२-१६-६", "content_sanskrit": "आकृष्यमाणो दूतैस्तु नानादुर्गेषु नीयते ।\nएवं पापी स दुष्टात्मा देवब्राह्मणनिंदकः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000344006, "chapter_id": 20344, "verse_number": "२-१६-७", "content_sanskrit": "सर्वपापसमाचारो नीयते यमकिंकरैः ।\nयमं पश्यति दुष्टात्मा कृष्णांजनचयोपमम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000344007, "chapter_id": 20344, "verse_number": "२-१६-८", "content_sanskrit": "तमुग्रं दारुणं भीमं भीमदूतैः समावृतम् ।\nसर्वव्याधिसमाकीर्णं चित्रगुप्तसमन्वितम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000344008, "chapter_id": 20344, "verse_number": "२-१६-९", "content_sanskrit": "आरूढं महिषं देवं धर्मराजं द्विजोत्तम ।\nदंष्ट्राकरालमत्युग्रं तस्यास्यं कालसंनिभम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000344009, "chapter_id": 20344, "verse_number": "२-१६-१०", "content_sanskrit": "पीतवासं गदाहस्तं रक्तगंधानुलेपनम् ।\nरक्तमाल्यकृताभूषं गदाहस्तं भयंकरम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000344010, "chapter_id": 20344, "verse_number": "२-१६-११", "content_sanskrit": "एवंविधं महाकायं यमं पश्यति दुर्मतिः ।\nतं दृष्ट्वा समनुप्राप्तं सर्वधर्मबहिष्कृतम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000344011, "chapter_id": 20344, "verse_number": "२-१६-१२", "content_sanskrit": "यमः पश्यति तं दुष्टं पापिष्ठं धर्मकंटकम् ।\nशासयेत्तु महादुःखैः पीडाभिर्दारुमुद्गलैः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000344012, "chapter_id": 20344, "verse_number": "२-१६-१३", "content_sanskrit": "यावद्युगसहस्रांतं तावत्कालं प्रपच्यते ।\nनानाविधे च नरके पच्यते च पुनः पुनः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000344013, "chapter_id": 20344, "verse_number": "२-१६-१४", "content_sanskrit": "नारकीं याति वै योनिं कृमिकोटिषु पापकृत् ।\nअमेध्ये पच्यते नित्यं हाहाभूतो विचेतनः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000344014, "chapter_id": 20344, "verse_number": "२-१६-१५", "content_sanskrit": "मरणं च स पापात्मा एवं याति सुनिश्चितम् ।\nएवं पापस्य संयोगं भुंक्ते चैव सु दुर्मतिः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000344015, "chapter_id": 20344, "verse_number": "२-१६-१६", "content_sanskrit": "पुनर्जन्म प्रवक्ष्यामि यासु योनिषु याति च ।\nशुनां योनिशतं प्राप्य भुंक्ते वै पातकं पुनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000344016, "chapter_id": 20344, "verse_number": "२-१६-१७", "content_sanskrit": "व्याघ्रो भवति दुष्टात्मा रासभीं याति वै पुनः ।\nमार्जार शूकरीं योनिं सर्पयोनिं तथैव च॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000344017, "chapter_id": 20344, "verse_number": "२-१६-१८", "content_sanskrit": "नानाभेदासु सर्वासु तिर्यक्षु च पुनः पुनः ।\nपापपक्षिषु संयाति अन्यासु महतीषु च॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000344018, "chapter_id": 20344, "verse_number": "२-१६-१९", "content_sanskrit": "चांडाल भिल्लयोनिं च पुलिंदीं याति पापकृत् ।\nएतत्ते सर्वमाख्यातं पापिनां जन्म चैव हि॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000344019, "chapter_id": 20344, "verse_number": "२-१६-२०", "content_sanskrit": "मरणे शृणु कांत त्वं चेष्टां तेषां सुदारुणाम् ।\nपापपुण्यसमाचारस्तवाग्रे कथितो मया॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000344020, "chapter_id": 20344, "verse_number": "२-१६-२१", "content_sanskrit": "अन्यदेवं प्रवक्ष्यामि यदि पृच्छसि मानद॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]