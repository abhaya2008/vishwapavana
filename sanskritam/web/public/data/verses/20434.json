[{"id": 7000434000, "chapter_id": 20434, "verse_number": "२-१०६-१", "content_sanskrit": "कुंजल उवाच ।\nआयुभार्या महाभागा स्वर्भानोस्तनया सुतम् ।\nअपश्यंती सुबालं तं देवोपममनौपमम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000434001, "chapter_id": 20434, "verse_number": "२-१०६-२", "content_sanskrit": "हाहाकारं महत्कृत्वा रुरोद वरवर्णिनी ।\nकेन मे लक्षणोपेतो हृतो बालः सुलक्षणः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000434002, "chapter_id": 20434, "verse_number": "२-१०६-३", "content_sanskrit": "तपसा दानयज्ञैश्च नियमैर्दुष्करैः सुतः ।\nसंप्राप्तो हि मया वत्स कष्टैश्च दारुणैः पुनः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000434003, "chapter_id": 20434, "verse_number": "२-१०६-४", "content_sanskrit": "दत्तात्रेयेण पुण्येन संतुष्टेन महात्मना ।\nदत्तः पुत्रो हृतः केन रुरोद करुणान्विता॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000434004, "chapter_id": 20434, "verse_number": "२-१०६-५", "content_sanskrit": "हा पुत्र वत्स मे तात हा बालगुणमंदिर ।\nक्वासि केनापनीतोसि मम शब्दः प्रदीयताम्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000434005, "chapter_id": 20434, "verse_number": "२-१०६-६", "content_sanskrit": "सोमवंशस्य सर्वस्य भूषणोसि न संशयः ।\nकेन त्वमपनीतोसि मम प्राणैः समन्वितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000434006, "chapter_id": 20434, "verse_number": "२-१०६-७", "content_sanskrit": "राजसुलक्षणैर्दिव्यैः संपूर्णः कमलेक्षणः ।\nकेनाद्यापहृतो वत्सः किं करोमि क्व याम्यहम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000434007, "chapter_id": 20434, "verse_number": "२-१०६-८", "content_sanskrit": "स्फुटं जानाम्यहं कर्म ह्यन्यजन्मनि यत्कृतम् ।\nन्यासनाशः कृतः कस्य तस्मात्पुत्रो हृतो मम॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000434008, "chapter_id": 20434, "verse_number": "२-१०६-९", "content_sanskrit": "किं वा छलं कृतं कस्य पूर्वजन्मनि पापया ।\nकर्मणस्तस्य वै दुःखमनुभुंजामि नान्यथा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000434009, "chapter_id": 20434, "verse_number": "२-१०६-१०", "content_sanskrit": "रत्नापहारिणी जाता पुत्ररत्नं हृतं मम ।\nतस्माद्दैवेन मे दिव्य अनौपम्य गुणाकरः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000434010, "chapter_id": 20434, "verse_number": "२-१०६-११", "content_sanskrit": "किं वा वितर्कितो विप्रः कर्मणस्तस्य वै फलम् ।\nप्राप्तं मया न संदेहः पुत्रशोकान्वितं भृशम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000434011, "chapter_id": 20434, "verse_number": "२-१०६-१२", "content_sanskrit": "किं वा शिशुविरोधश्च कृतो जन्मांतरे मया ।\nतस्य पापस्य भुंजामि कर्मणः फलमीदृशम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000434012, "chapter_id": 20434, "verse_number": "२-१०६-१३", "content_sanskrit": "याचमानस्य चैवाग्रे वैश्वदेवस्य कर्मणः ।\nकिं वापि नार्पितं चान्नं व्याहृतीभिर्हुतं द्विजैः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000434013, "chapter_id": 20434, "verse_number": "२-१०६-१४", "content_sanskrit": "एवं सुदेवमानाच्च स्वर्भानोस्तनया तदा ।\nइंदुमती महाभाग शोकेन करुणाकुला॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000434014, "chapter_id": 20434, "verse_number": "२-१०६-१५", "content_sanskrit": "पतिता मूर्च्छिता शोकाद्विह्वलत्वं गता सती ।\nनिःश्वासान्मुंचमाना सा वत्सहीना यथा हि गौः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000434015, "chapter_id": 20434, "verse_number": "२-१०६-१६", "content_sanskrit": "आयू राजा स शोकेन दुःखेन महतान्वितः ।\nबालं श्रुत्वा हृतं तं तु धैर्यं तत्याज पार्थिवः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000434016, "chapter_id": 20434, "verse_number": "२-१०६-१७", "content_sanskrit": "तपसश्च फलं नास्ति नास्ति दानस्य वै फलम् ।\nयस्मादेवं हृतः पुत्रस्तस्मान्नास्ति न संशयः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000434017, "chapter_id": 20434, "verse_number": "२-१०६-१८", "content_sanskrit": "दत्तात्रेयः प्रसादेन वरं मे दत्तवान्पुरा ।\nअजेयं च जयोपेतं पुत्रं सर्वगुणान्वितम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000434018, "chapter_id": 20434, "verse_number": "२-१०६-१९", "content_sanskrit": "तस्य वरप्रदानस्य कथं विघ्नो ह्यजायत ।\nइति चिंतापरो राजा दुःखितः प्रारुदद्भृशम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]