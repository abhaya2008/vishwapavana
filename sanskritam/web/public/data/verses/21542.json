[{"id": 7001542000, "chapter_id": 21542, "verse_number": "१-३९-१", "content_sanskrit": "॥सूत उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001542001, "chapter_id": 21542, "verse_number": "१-३९-२", "content_sanskrit": "अतः परं प्रवक्ष्यामि यस्मिन् यस्मिन् शिलोच्चये ।\nये सन्निविष्टा देवानां विविधानां गृहोत्तमाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001542002, "chapter_id": 21542, "verse_number": "१-३९-३", "content_sanskrit": "तत्र योऽसौ महाशैलः शीतान्तो नैक विस्तरः ।\nनैकधातुशतैश्चित्रैर्नैकरत्नाकराकरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001542003, "chapter_id": 21542, "verse_number": "१-३९-४", "content_sanskrit": "नितम्बैः पुष्पसालम्बैर्नैकसत्त्वगुणालयः ।\nमहार्हमणिचित्राभिर्हेमवंशैरलंकृतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001542004, "chapter_id": 21542, "verse_number": "१-३९-५", "content_sanskrit": "नितम्बैः षट्पदोद्गीतैः प्रवालैर्हेमचित्रकैः ।\nतटैः कुसुमसङ्कीर्णैर्मत्तभ्रमरनादितैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001542005, "chapter_id": 21542, "verse_number": "१-३९-६", "content_sanskrit": "लतालम्बैश्चित्रवद्भिश्चित्रैर्धातुशतार्चितैः ।\nसानुभी रत्नचित्रैश्च पुष्पाढ्यैश्च विभूषितः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001542006, "chapter_id": 21542, "verse_number": "१-३९-७", "content_sanskrit": "विमलस्वादुपानीयैर्नैकप्रस्रवमैर्युतः ।\nनिकुञ्जैः कुसुमोत्कीर्णैरनेकैश्च विभूषितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001542007, "chapter_id": 21542, "verse_number": "१-३९-८", "content_sanskrit": "पुष्मौडुपवहाभिश्च स्रवन्तीभिरलंकृतः ।\nकिन्नराचरिताभिश्च दरीभिः सर्वतस्ततः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001542008, "chapter_id": 21542, "verse_number": "१-३९-९", "content_sanskrit": "यक्षगन्धर्वचरितैरनेकैः कन्दरोदरैः ।\nशोभितश्च सुखासेव्यैश्चित्रैर्गहनसङ्कटैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001542009, "chapter_id": 21542, "verse_number": "१-३९-१०", "content_sanskrit": "नानासत्वगणाकीर्णैः सुपानीयैः सुखाश्रयैः ।\nनानापुष्पफलोपेतैः पादपैः समलंकृतः॥९  ।\nतस्मिन् गुहाश्रयाकीर्णे अनेकोदरकन्दरे ।\nक्रीडावनं महेन्द्रस्य सर्वकामगुणैर्युतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001542010, "chapter_id": 21542, "verse_number": "१-३९-११", "content_sanskrit": "तत्र तद्देवराजस्य पारिजातवनं महत् ।\nप्रकाशं त्रिषु लोकेषु गीयते श्रुतिनिश्चयात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001542011, "chapter_id": 21542, "verse_number": "१-३९-१२", "content_sanskrit": "तरुणादित्यसंकाशै र्महागन्धैर्मनोहरैः ।\nपुष्पैर्भाति नगश्रेष्ठः सुदीप्त इव सर्वशः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001542012, "chapter_id": 21542, "verse_number": "१-३९-१३", "content_sanskrit": "समग्रं योजनशतं तं गन्धमनिलो ववौ ।\nपारिजातकपुष्माणां माहेन्द्र वननिर्गतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001542013, "chapter_id": 21542, "verse_number": "१-३९-१४", "content_sanskrit": "वैढूर्यनीलैः कमलैः सौवर्णैर्वज्रकेसरैः ।\nसर्वगन्धबलोपेतैर्मत्तषट्पदनादितैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001542014, "chapter_id": 21542, "verse_number": "१-३९-१५", "content_sanskrit": "व्याकोशौर्विकचैश्चापि शतपत्रैर्मनोहरैः ।\nसपङ्कजैर्महा पत्रैर्वाप्यस्तत्र विभूषिताः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001542015, "chapter_id": 21542, "verse_number": "१-३९-१६", "content_sanskrit": "विरेजुरन्तरम्बुस्थाः सौवर्णमणिभूषिताः ।\nपरिप्सन्देक्षणा नित्यं मीनयूथाः सहस्रशः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001542016, "chapter_id": 21542, "verse_number": "१-३९-१७", "content_sanskrit": "कूर्मैश्चानेकसंस्थानैर्हेमरत्नपरिष्कृतैः ।\nचञ्चूर्यमाणैः सलिलैर्भाति चित्रं समन्ततः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001542017, "chapter_id": 21542, "verse_number": "१-३९-१८", "content_sanskrit": "नानावर्णैश्च शखुनैर्नानारत्नतनूरुहैः ।\nसुवर्णपुष्पैश्चानेकैर्मणितुण्डैर्द्विजातिभिः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001542018, "chapter_id": 21542, "verse_number": "१-३९-१९", "content_sanskrit": "वल्गुस्वरैः सदोन्मत्तैः सम्पतद्भिः समन्ततः ।\nशुशुभे तद्वनं रम्यं सहस्राक्षस्य धीमतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001542019, "chapter_id": 21542, "verse_number": "१-३९-२०", "content_sanskrit": "मत्तभ्रमरसन्नादैर्विहङ्गानाञ्च कूजितैः ।\nनित्यमा नन्दितवनं तस्मात् क्रीडावनं महत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001542020, "chapter_id": 21542, "verse_number": "१-३९-२१", "content_sanskrit": "सुवर्णपार्श्वैश्च नगैर्मणिमुक्तापुरस्कृतैः ।\nमणिश्रृङ्गकलापन्नैः पतद्भिश्च समन्ततः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001542021, "chapter_id": 21542, "verse_number": "१-३९-२२", "content_sanskrit": "शाखामृगैश्च चित्राङ्गैर्नानारत्नतनूरुहैः ।\nनानावर्णप्रकारैश्च सत्वैरन्यैः समाकुलम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001542022, "chapter_id": 21542, "verse_number": "१-३९-२३", "content_sanskrit": "मुञ्चन्ति पुष्पवर्षञ्च तत्र बाललता द्रुमाः ।\nपारिजातकपुष्पाणां मन्दमारुत कम्पिताः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001542023, "chapter_id": 21542, "verse_number": "१-३९-२४", "content_sanskrit": "शयनासननिर्व्यूहैः स्तीर्णै रत्नविभूषितैः ।\nविहारभूमयस्तत्र द्विजाः शक्रवने शुभाः ।\nन च शीतो न चाप्युष्णो रविस्तत्र समः सदा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001542024, "chapter_id": 21542, "verse_number": "१-३९-२५", "content_sanskrit": "नित्यमुन्मादजननो मधुमाधवसम्भवः ।\nवाति चाप्यनिलस्तत्र नानापुष्पाधिवासितः ।\nनित्यं सङ्गसुखाह्लादी श्रमक्लमविनाशनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001542025, "chapter_id": 21542, "verse_number": "१-३९-२६", "content_sanskrit": "तस्मिन्निन्द्रवने शुभ्रे देवदानवपन्नगाः ।\nयक्षराक्षसगुह्याश्च गन्धर्वाश्चामितौजसः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001542026, "chapter_id": 21542, "verse_number": "१-३९-२७", "content_sanskrit": "विद्याधराश्च सिद्धाश्च किन्नराश्च मुदा युताः ।\nअथाप्सरोगणाश्चैव नित्यं क्रीडापरायणाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001542027, "chapter_id": 21542, "verse_number": "१-३९-२८", "content_sanskrit": "तस्य पर्वतराजस्य पूर्वे पार्श्वे महोचितम् ।\nकुमुञ्चं शैलराजानं नैकनिर्झरकन्दरम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001542028, "chapter_id": 21542, "verse_number": "१-३९-२९", "content_sanskrit": "तस्य धातुविचित्रेषु कूटेषु बहुविस्तराः ।\nअष्टौ पुर्यो ह्युदीर्णाश्च दानवानां महात्मनाम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001542029, "chapter_id": 21542, "verse_number": "१-३९-३०", "content_sanskrit": "वज्रके पर्वते चापि अनेकशिखरोदरैः ।\nउदीर्णा राक्षसावासा नरनारीसमाकुलाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001542030, "chapter_id": 21542, "verse_number": "१-३९-३१", "content_sanskrit": "नीलका नाम ते घोरा राक्षसाः कामरूपिणः ।\nतत्र तेऽभिरता नित्यं महाबलपराक्रमाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001542031, "chapter_id": 21542, "verse_number": "१-३९-३२", "content_sanskrit": "महानीलेऽपि शैलेन्द्रे पुराणि दश पञ्च च ।\nहयाननानां विख्याताः किन्नराणां महात्मनाम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001542032, "chapter_id": 21542, "verse_number": "१-३९-३३", "content_sanskrit": "देवसेनो महाबाहुर्बलमिन्द्रादयस्तथा ।\nतत्र किन्नरराजानो दशपञ्च च गर्विताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001542033, "chapter_id": 21542, "verse_number": "१-३९-३४", "content_sanskrit": "सुवर्णपार्श्वाः प्रायेण नानापर्णसमाकुलैः ।\nबिलप्रवेशैर्नगरैः शैलेन्द्रः सोऽभ्यलंकृतः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001542034, "chapter_id": 21542, "verse_number": "१-३९-३५", "content_sanskrit": "अतिदारुणा दृष्टिविषा ह्यग्निकोपा दुरासदाः ।\nमहोरगशतास्तत्र सुवर्णवशवर्तिनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001542035, "chapter_id": 21542, "verse_number": "१-३९-३६", "content_sanskrit": "सुनागेऽपि महाशैले दैत्यावासा- सहस्रशः ।\nहर्म्यप्रासाद कलिलाः प्रांशुप्राकारतोरणाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001542036, "chapter_id": 21542, "verse_number": "१-३९-३७", "content_sanskrit": "वेणुमन्ते महाशैले विद्याधरपुरत्रयम् ।\nत्रिंशदद्योजनविस्तीर्णं पञ्चाशद्योजनायतम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001542037, "chapter_id": 21542, "verse_number": "१-३९-३८", "content_sanskrit": "उलूको रोमशश्चैव महानेत्रश्च वीर्यवान् ।\nविद्याधरवरास्तत्र शक्रतुल्यपराक्रमाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001542038, "chapter_id": 21542, "verse_number": "१-३९-३९", "content_sanskrit": "वैकङ्के शैलशिखरे ह्यन्तःकन्दरनिर्झरे ।\nमहोच्चश्रृङ्गे रुचिरे रत्नधातुविचित्रिते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001542039, "chapter_id": 21542, "verse_number": "१-३९-४०", "content_sanskrit": "तत्रास्ते गारुडिर्नित्यं उरगारिर्दुरासदः ।\nमहावायुजवश्चण्डः सुग्रीवो नाम वीर्यवान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001542040, "chapter_id": 21542, "verse_number": "१-३९-४१", "content_sanskrit": "महाप्रमाणै र्विक्रान्तैर्महाबलपराक्रमैः ।\nसशैलो ह्यावृतः सर्वः पक्षिभिः पन्नगारिभिः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001542041, "chapter_id": 21542, "verse_number": "१-३९-४२", "content_sanskrit": "करञ्जेऽभिरतो नित्यं साक्षाद्भूतपतिः प्रभुः ।\nवृषभाङ्को महादेवः शङ्करो योगिनां प्रभुः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001542042, "chapter_id": 21542, "verse_number": "१-३९-४३", "content_sanskrit": "नानावेषधरैर्भूतैः प्रमथैश्च दुरासदैः ।\nकरञ्जे सानवः सर्वे ह्यवकीर्णाः समन्ततः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001542043, "chapter_id": 21542, "verse_number": "१-३९-४४", "content_sanskrit": "वसुधारे वसुमतां वसूनाममितौजसाम् ।\nअष्टावायतनान्याहुः पूजितानि महात्मनाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001542044, "chapter_id": 21542, "verse_number": "१-३९-४५", "content_sanskrit": "रत्नधातौ गिरिवरे ऋषीणाञ्च महात्मनाम् ।\nसप्ताश्रमाणि पुण्यानि सिद्धावासयुतानि च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001542045, "chapter_id": 21542, "verse_number": "१-३९-४६", "content_sanskrit": "महाप्रजापतेः स्थानं हेमश्रृङ्गो नगोत्तमे ।\nचतुर्वक्त्रस्य देवस्य सर्वभूतनमस्कृतम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001542046, "chapter_id": 21542, "verse_number": "१-३९-४७", "content_sanskrit": "गजशैले भगवतो नानाभूतगणावृताः  ।\nरुद्राः प्रमुदिता नित्यं सर्वभूतनमस्कृताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001542047, "chapter_id": 21542, "verse_number": "१-३९-४८", "content_sanskrit": "सुमेधे धातुचित्राढ्ये शैलेन्द्रे मेघसन्निभे ।\nनैकोदरदरीवप्रनिकुञ्जैश्चोपशोभिते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001542048, "chapter_id": 21542, "verse_number": "१-३९-४९", "content_sanskrit": "आदित्यानां वसूनाञ्च रुद्राणाञ्चामितौजसाम् ।\nतत्रायतनविन्यासा रम्याश्चैवाश्विनोरपि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001542049, "chapter_id": 21542, "verse_number": "१-३९-५०", "content_sanskrit": "स्थानानि सिद्धैर्देवानां स्थापितानि नगोत्तमे ।\nतत्र पूजापरा नित्यं यक्ष गन्धर्वकिन्नराः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001542050, "chapter_id": 21542, "verse_number": "१-३९-५१", "content_sanskrit": "गन्धर्वनगरी स्फीता हेमकक्षे नगोत्तमे ।\nअशीत्यामरपुर्य्याभा महाप्राकारतोरणा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001542051, "chapter_id": 21542, "verse_number": "१-३९-५२", "content_sanskrit": "सिद्धा ह्यपत्तना नाम गन्धर्वा युद्ध शालिनः ।\nयेषामधिपतिर्देवो राजराजः कपिञ्जलः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001542052, "chapter_id": 21542, "verse_number": "१-३९-५३", "content_sanskrit": "अनले राक्षसावासाः पञ्चकूटेऽपि दानवाः ।\nऊर्जिता देवरिपवो महाबलपराक्रमाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001542053, "chapter_id": 21542, "verse_number": "१-३९-५४", "content_sanskrit": "शतश्रृङ्गे पुरशतं यक्षाणाममितौजसाम् ।\nताम्राभे काद्रवेयस्य तक्षकस्य पुरोत्तमम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001542054, "chapter_id": 21542, "verse_number": "१-३९-५५", "content_sanskrit": "विशाखे पर्वतश्रेष्ठे नैकवप्रदरीशुभे ।\nगुहानिरतवासस्य गुहस्यायतनं महत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001542055, "chapter_id": 21542, "verse_number": "१-३९-५६", "content_sanskrit": "श्वेतोदरे महाशैले महाभवनमण्डिते ।\nपुरं गरुढपुत्रस्य सुनाभस्य महात्मनः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001542056, "chapter_id": 21542, "verse_number": "१-३९-५७", "content_sanskrit": "पिशाचके गिरिवरे हर्म्यं प्रासाद मण्डितम् ।\nयक्षगन्धर्वचरितं कुबेरभवनं महत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001542057, "chapter_id": 21542, "verse_number": "१-३९-५८", "content_sanskrit": "हरिकूटे हरिर्देवः सर्वभूतनमस्कृतः ।\nप्रभावात्तस्य शैलोऽसौ महानाभः प्रकाशते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001542058, "chapter_id": 21542, "verse_number": "१-३९-५९", "content_sanskrit": "कुमुदे किन्नरावासा अञ्जने च महोरगाः ।\nकृष्णे गन्धर्व्वनगरा महाभवनशालिनः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001542059, "chapter_id": 21542, "verse_number": "१-३९-६०", "content_sanskrit": "पाण्डुरे चारुशिखरे महाप्राकारतोरणे ।\nविद्याधरपुरं तत्र महाभवनमालिनम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001542060, "chapter_id": 21542, "verse_number": "१-३९-६१", "content_sanskrit": "सहस्रशिखरे शैले दैत्यानामुग्रकर्म्मणाम् ।\nपुराणि समुदीर्णानां सहस्रं हेममालिनाम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001542061, "chapter_id": 21542, "verse_number": "१-३९-६२", "content_sanskrit": "मुकुटे पन्नगावासा अनेकाः पर्वतोत्तमाः ।\nपुष्पके वै मुनिगणा नित्यमेव मुदा युताः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001542062, "chapter_id": 21542, "verse_number": "१-३९-६३", "content_sanskrit": "वैवस्वतस्य सोमस्य वायोर्नागाधिपस्य च ।\nसुपक्षे पर्वतवरे चत्वार्य्यायतनानि च ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001542063, "chapter_id": 21542, "verse_number": "१-३९-६४", "content_sanskrit": "गन्धर्वैः किन्नरैर्यक्षैर्न्नागैर्विद्याधरोत्तमैः ।\nसिद्धैर्हि तेषु स्थानेषु नित्यमिष्टः प्रपूज्यते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001542064, "chapter_id": 21542, "verse_number": "१-३९-६५", "content_sanskrit": "इति श्रीमहा पुराणे वायुप्रोक्ते भुवनविन्यासो नामैकोनचत्वारिंशोऽध्यायः ॥ ३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]