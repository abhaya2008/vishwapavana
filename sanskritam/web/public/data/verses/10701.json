[{"id": 50003343, "chapter_id": 10701, "verse_number": "1", "content_sanskrit": "दैवमेवापरे यज्ञं योगिनः पर्युपासते। ब्रह्माग्नावपरे यज्ञं यज्ञेनैवोपजुह्वति॥ ४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50003344, "chapter_id": 10701, "verse_number": "2", "content_sanskrit": "श्रोत्रादीनीन्द्रियाण्यन्ये संयमाग्निषु जुह्वति। शब्दादीन् विषयानन्य इन्द्रियाग्निषु जुह्वति॥ ४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50003345, "chapter_id": 10701, "verse_number": "3", "content_sanskrit": "सर्वाणीन्द्रियकर्माणि प्राणकर्माणि चापरे। आत्मसंयमयोगाग्नौ जुह्वति ज्ञानदीपिते॥ ४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50003346, "chapter_id": 10701, "verse_number": "4", "content_sanskrit": "द्रव्ययज्ञास्तपोयज्ञा योगयज्ञास्तथाऽपरे। स्वाध्यायज्ञानयज्ञाश्च यतयः संशितव्रताः॥ ४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50003347, "chapter_id": 10701, "verse_number": "5", "content_sanskrit": "अपाने जुह्वनि प्राणं प्राणेऽपानं तथाऽपरे। प्राणापानगती रुद्ध्वा प्राणायामपरायणाः॥ ४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50003348, "chapter_id": 10701, "verse_number": "6", "content_sanskrit": "अपरे नियताहाराः प्राणान् प्राणेषु जुह्वति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]