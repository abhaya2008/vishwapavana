[{"id": 7003775000, "chapter_id": 23775, "verse_number": "२-२-१९-१", "content_sanskrit": "जैमिनिरुवाच ।\nततः स पृथिवीपालस्तथा कृत्वांऽतरिक्षगा ।\nयदुवाच गिरां देवी तद्वत्परिचचार ह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003775001, "chapter_id": 23775, "verse_number": "२-२-१९-२", "content_sanskrit": "एवं दिनेदिने याते दिव्यगंधोऽनुभूयते ।\nपारिजातप्रसूनानां वृष्टिर्मर्त्येषु दुर्लभा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003775002, "chapter_id": 23775, "verse_number": "२-२-१९-३", "content_sanskrit": "दिव्यसंगीतनादश्च गीतानि रुचिराणि च ।\nस्वर्गंगाजलवृष्टिश्च सूक्ष्मबिंदुसुशोभना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003775003, "chapter_id": 23775, "verse_number": "२-२-१९-४", "content_sanskrit": "ऐरावतादिनागानां मदगंधो वनद्विपैः ।\nदुःसहः सर्वभूतानां सुखकार्यनुभूयते ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003775004, "chapter_id": 23775, "verse_number": "२-२-१९-५", "content_sanskrit": "यज्ञार्थमागता देवास्ते सर्वे विगतज्वराः ।\nआविर्भूतं हरिं दृष्ट्वा उपासांचक्रिरे द्विजाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003775005, "chapter_id": 23775, "verse_number": "२-२-१९-६", "content_sanskrit": "यथा हि माधवं पूर्वं तथा तं विष्णुशाखिनम् ।\nउपासनासु देवानां दिव्यचिह्नानि जज्ञिरे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003775006, "chapter_id": 23775, "verse_number": "२-२-१९-७", "content_sanskrit": "निर्ववाह स्वयं देवः क्रमात्पंचदशे दिने ।\nचतुर्मूर्तिः स भगवान्यथा पूर्वं मयोदितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003775007, "chapter_id": 23775, "verse_number": "२-२-१९-८", "content_sanskrit": "तादृगाविर्बभूवासौ युष्माकं वर्णितः पुरा ।\nदिव्यसिंहासनगतो बलभद्रासुदर्शनैः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003775008, "chapter_id": 23775, "verse_number": "२-२-१९-९", "content_sanskrit": "शंखचक्रगदापद्मलसद्बाहुर्जनार्दनः ।\nगदामुसलचक्राब्जं धारयन्पन्नगाकृतिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003775009, "chapter_id": 23775, "verse_number": "२-२-१९-१०", "content_sanskrit": "छत्राकृतिफणासप्तमुकुटोज्ज्वलकुंडलः ।\nसुभद्रा चारुवदना वराब्जाभयधारिणी ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003775010, "chapter_id": 23775, "verse_number": "२-२-१९-११", "content_sanskrit": "लक्ष्मीः प्रादुर्बभूवेयं सर्वचैतन्यरूपिणी ।\nइयं कृष्णावतारे हि रोहिणीगर्भसंभवा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003775011, "chapter_id": 23775, "verse_number": "२-२-१९-१२", "content_sanskrit": "बलभद्राकृतिर्जाता बलरूपस्य चिंतनात् ।\nक्षणं न सहते सा हि मोक्तुं लीलावतारिणम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003775012, "chapter_id": 23775, "verse_number": "२-२-१९-१३", "content_sanskrit": "न भेदोऽस्तीह को विप्राः कृष्णस्य च बलस्य च ।\nएकगर्भप्रसूतत्वाद्व्यवहारोऽथ लौकिकः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003775013, "chapter_id": 23775, "verse_number": "२-२-१९-१४", "content_sanskrit": "भगिनी बलदेवस्येत्येषा पौराणिकी कथा ।\nपुंरूपे स्त्रीस्वरूपेण लक्ष्मीः सर्वत्र तिष्ठति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003775014, "chapter_id": 23775, "verse_number": "२-२-१९-१५", "content_sanskrit": "पुंनाम्ना भगवान्विष्णुः स्त्रीनाम्ना कमलालया ।\nदेवतिर्यङ्मनुष्यादौ विद्यते न तयोः परम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003775015, "chapter_id": 23775, "verse_number": "२-२-१९-१६", "content_sanskrit": "को ह्यन्यः पुंडरीकाक्षाद्भुवनानि चतुर्दश ।\nधारयेत्तु फणाग्रेण सोऽनंतो बलसंज्ञितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003775016, "chapter_id": 23775, "verse_number": "२-२-१९-१७", "content_sanskrit": "तस्य शक्तिस्वरूपेयं भगिनी श्रीः प्रकीर्तिता ।\nसुदर्शनं तु यच्चक्रं सदा विष्णोः करे स्थितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003775017, "chapter_id": 23775, "verse_number": "२-२-१९-१८", "content_sanskrit": "शाखाग्रस्तंभमध्यस्थं तद्रूपं तत्तुरीयकम् ।\nएवं तु मूर्त्तयस्तेन चतस्रो वै प्रकाशिताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003775018, "chapter_id": 23775, "verse_number": "२-२-१९-१९", "content_sanskrit": "निर्वृत्ते भगवद्रूपे चतुर्द्धा दिव्यरूपिणि ।\nलोकानामुपकाराय पुनराहांतरिक्षगा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003775019, "chapter_id": 23775, "verse_number": "२-२-१९-२०", "content_sanskrit": "पटैराच्छाद्य सुदृढं नृपते प्रतिमास्त्विमाः ।\nस्वं स्वं वर्णं प्रापयाशु वर्णकैश्चित्रकर्मणा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003775020, "chapter_id": 23775, "verse_number": "२-२-१९-२१", "content_sanskrit": "नीलाभ्रश्यामलं विष्णुं शंखेंदुधवलं बलम् ।\nरक्तं सुदर्शनं चक्रं सुभद्रां कुंकुमारुणाम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003775021, "chapter_id": 23775, "verse_number": "२-२-१९-२२", "content_sanskrit": "नानालंकाररुचिरां नानाभंगिविभागशः ।\nअमी दारुस्वरूपेण दृष्टाः पापाय हेतवे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003775022, "chapter_id": 23775, "verse_number": "२-२-१९-२३", "content_sanskrit": "गोपनीया प्रयत्नेन पटनिर्यासवल्कलैः ।\nतस्मात्प्रथममेवैतांस्तरोरेवास्य वल्कलैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003775023, "chapter_id": 23775, "verse_number": "२-२-१९-२४", "content_sanskrit": "शिल्पिभिः कर्मकुशलैर्दृढमाच्छादयाग्रतः ।\nवर्षे वर्षे च संस्कार्याः पूर्वसंस्कार मोचनात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003775024, "chapter_id": 23775, "verse_number": "२-२-१९-२५", "content_sanskrit": "ऋते वल्कललेपं तु स तु दिव्यश्चिरंतनः ।\nप्रमादाद्य इमं लेपमपनीयेत कश्चन ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003775025, "chapter_id": 23775, "verse_number": "२-२-१९-२६", "content_sanskrit": "दुर्भिक्षं मरकं राष्ट्रे संततिश्चास्य हीयते ।\nनेक्षितव्यास्त्वया राजन्कदाचिदपवारणाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003775026, "chapter_id": 23775, "verse_number": "२-२-१९-२७", "content_sanskrit": "मनुष्यैश्चापि राजेंद्र दृष्टाः स्युर्भयहेतवः ।\nतस्मात्सचित्रा द्रष्टव्या बहुलेपविलेपिताः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003775027, "chapter_id": 23775, "verse_number": "२-२-१९-२८", "content_sanskrit": "सुचित्रं पुण्डरीकाक्षं सविलासं सविभ्रमम् ।\nदृष्ट्वा विमुच्यते पापैः कल्पकोटिसमुद्भवैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003775028, "chapter_id": 23775, "verse_number": "२-२-१९-२९", "content_sanskrit": "सुचित्रान्कुरु राजेंद्र चित्रान्कामानवाप्स्यति ।\nआविर्बभूव भगवांस्तवानुग्रहकाम्यया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003775029, "chapter_id": 23775, "verse_number": "२-२-१९-३०", "content_sanskrit": "तव प्रसादाज्जंतूनां चतुर्वर्गं प्रदास्यति ।\nनीलाद्रौ कल्पवृक्षस्य वायव्यां शतहस्ततः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003775030, "chapter_id": 23775, "verse_number": "२-२-१९-३१", "content_sanskrit": "प्रदेशे सुमहत्स्थाने प्रासादं सुदृढायतम् ।\nउत्तरे नरसिंहस्य सहस्रकरमुच्छ्रितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003775031, "chapter_id": 23775, "verse_number": "२-२-१९-३२", "content_sanskrit": "कारयित्वा प्रतिष्ठाप्य तत्रैनं विनिवेशय ।\nपुरा स्थितं पर्वतेऽस्मिन्योऽभ्यर्चयति माधवम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003775032, "chapter_id": 23775, "verse_number": "२-२-१९-३३", "content_sanskrit": "नाम्ना विश्वावसुर्नाम शबरो वैष्णवोत्तमः ।\nपुरोधसः सख्यमासीत्तेन सार्द्धं पुरा च ते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003775033, "chapter_id": 23775, "verse_number": "२-२-१९-३४", "content_sanskrit": "तयोः संततिरेवास्य लेपसंस्कारकर्मणि ।\nनियुज्यतां महाराज भविष्यत्सूत्सवेषु च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003775034, "chapter_id": 23775, "verse_number": "२-२-१९-३५", "content_sanskrit": "विररामैतदाभाष्य सा तु दिव्या सरस्वती ।\nतयोपदिष्टमाकर्ण्य प्रहृष्टेनांतरात्मना ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003775035, "chapter_id": 23775, "verse_number": "२-२-१९-३६", "content_sanskrit": "वेष्टनं मोचयामास महावेद्या नृपोत्तमः ।\nददृशुस्ते तदा सर्वे रत्नसिंहासने स्थितम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003775036, "chapter_id": 23775, "verse_number": "२-२-१९-३७", "content_sanskrit": "रामं कृष्णं सुभद्रां च वासुदेवं सुदर्शनम् ।\nयथोपदिष्टलेप्यादिसंस्कारे रुचिराकृतिम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003775037, "chapter_id": 23775, "verse_number": "२-२-१९-३८", "content_sanskrit": "कृपया स्मेरवदनमुन्नतायतवक्षसम् ।\nदीनानामुद्धृतौ नाथं प्रलंबभुजपंजरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003775038, "chapter_id": 23775, "verse_number": "२-२-१९-३९", "content_sanskrit": "प्रबुद्धपुण्डरीकाक्षं हासशोणायताधरम् ।\nपश्यतां दृष्टिमात्रेण हर्तारं पापसंचयम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003775039, "chapter_id": 23775, "verse_number": "२-२-१९-४०", "content_sanskrit": "पद्मासनस्थितं कृष्णं दिव्यालंकारभूषितम् ।\nस्वतेजसा परिवृतं दारुदेहेऽपि निर्मलम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003775040, "chapter_id": 23775, "verse_number": "२-२-१९-४१", "content_sanskrit": "नीलजीमूतसंकाशं सर्वसंतापनाशनम् ।\nददर्श बलदेवं च साट्टहासमुखांबुजम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003775041, "chapter_id": 23775, "verse_number": "२-२-१९-४२", "content_sanskrit": "फणामण्डलविस्तीर्णं वारुणीघूर्णितेक्षणम् ।\nप्रोत्थितं नागराजानं पीनोन्नतसुवक्षसम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003775042, "chapter_id": 23775, "verse_number": "२-२-१९-४३", "content_sanskrit": "किंचिन्नतं पृष्ठदेशे कुण्डलीकृतविग्रहम् ।\nअग्रसंफुल्लककुभं कैलासशिखरं यथा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003775043, "chapter_id": 23775, "verse_number": "२-२-१९-४४", "content_sanskrit": "हलचक्राब्जमुसलधारिणं वनमालिनम् ।\nहारकुण्डलकेयूरकिरीटमुकुटोज्ज्वलम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003775044, "chapter_id": 23775, "verse_number": "२-२-१९-४५", "content_sanskrit": "तयोर्मध्ये स्थितां लक्ष्मीं सुभद्रां भद्ररूपिणीम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003775045, "chapter_id": 23775, "verse_number": "२-२-१९-४६", "content_sanskrit": "सर्वदेवारणीं पापसागरोत्तारकारिणीम् ।\nविकचांभोजवदनां वराब्जाभयधारिणीम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003775046, "chapter_id": 23775, "verse_number": "२-२-१९-४७", "content_sanskrit": "रूपलावण्यवसतिं शोभमानां प्रसाधनैः ।\nकुंकुमारुणदेहां तां साक्षाल्लक्ष्मीमिवापराम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003775047, "chapter_id": 23775, "verse_number": "२-२-१९-४८", "content_sanskrit": "ददर्श विष्णोर्वामस्थां चक्रशाखाग्रनिर्मिताम् ।\nबालार्कसदृशीं तीक्ष्णधारां तेजोमयीं द्विजाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003775048, "chapter_id": 23775, "verse_number": "२-२-१९-४९", "content_sanskrit": "तां दृष्ट्वानन्दपाथोधि निमग्नः पृथिवीपतिः ।\nकर्तव्यमूढः स्वतनौ स्वयं न प्रबभूव ह ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003775049, "chapter_id": 23775, "verse_number": "२-२-१९-५०", "content_sanskrit": "दरमीलितनेत्रः सन्सृजन्बाष्पांबु केवलम् ।\nकृतांजलिपुटस्तस्थौ स्थूणाकारो नृपोत्तमः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003775050, "chapter_id": 23775, "verse_number": "२-२-१९-५१", "content_sanskrit": "उवाच तं मुनिवरः स्मितवक्त्रः क्षितीश्वरम् ।\nयदर्थं श्रममापन्नस्तत्सांप्रतमभूत्तव ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003775051, "chapter_id": 23775, "verse_number": "२-२-१९-५२", "content_sanskrit": "प्रत्यक्षं नृपशार्दूल एकस्त्वं भाग्यवान्भुवि ।\nअमुं पश्य जगन्नाथं पुण्डरीकायतेक्षणम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003775052, "chapter_id": 23775, "verse_number": "२-२-१९-५३", "content_sanskrit": "भक्तानुग्रहपाथोधिं सर्वज्ञाननिधिं हरिम् ।\nयं द्रष्टुं योगिनो नित्यं यतंति यतमानसाः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003775053, "chapter_id": 23775, "verse_number": "२-२-१९-५४", "content_sanskrit": "अवधानेन महता क्षणं पश्यन्ति मानवाः ।\nसोऽयं दारुमयं देहं समास्थाय जनार्दनः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003775054, "chapter_id": 23775, "verse_number": "२-२-१९-५५", "content_sanskrit": "अनुग्रहीतुं त्वां भूप प्रत्यक्षत्वमुपागतः ।\nभजैनं धरणीनाथं स्तुहि कारुण्यसागरम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003775055, "chapter_id": 23775, "verse_number": "२-२-१९-५६", "content_sanskrit": "ददाति संस्तुतः कामान्सर्वान्नृप मनोगतान् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003775056, "chapter_id": 23775, "verse_number": "२-२-१९-५७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे पुरुषोत्तमक्षेत्रमाहात्म्ये जैमिनिऋषिसंवाद एकोनविशोऽध्यायः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]