[{"id": 2093750, "chapter_id": 3003, "verse_number": "१३-१३३-१", "content_sanskrit": "युधिष्ठिर उवाच।\nउक्ताः पितामहेनेह सुवर्णस्य विधानतः।\nविस्तरेण प्रदानस्य ये गुणाः श्रुतिलक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2093751, "chapter_id": 3003, "verse_number": "१३-१३३-२", "content_sanskrit": "यत्तु कारणमुत्पत्तेः सुवर्णस्य प्रकीर्तितम्।\nस कथं तारकः प्राप्तो निधनं तद्ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2093752, "chapter_id": 3003, "verse_number": "१३-१३३-३", "content_sanskrit": "उक्तं स दैवतानां हि अवध्य इति पार्थिव।\nकथं तस्याभवन्मृत्युर्विस्तरेण प्रकीर्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2093753, "chapter_id": 3003, "verse_number": "१३-१३३-४", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं त्वत्तः कुरुकुलोद्वह।\nकार्त्स्न्येन तारकवधं परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2093754, "chapter_id": 3003, "verse_number": "१३-१३३-५x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2093755, "chapter_id": 3003, "verse_number": "१३-१३३-५", "content_sanskrit": "विपन्नकृत्या राजेन्द्र देवता ऋषयस्तथा।\nकृत्तिकाश्चोदयामासुरपत्यभरणाय वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2093756, "chapter_id": 3003, "verse_number": "१३-१३३-६", "content_sanskrit": "न देवतानां काचिद्धि समर्था जातवेदसः।\nएता हि शक्तास्तं गर्भं सन्धारयितुमोजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2093757, "chapter_id": 3003, "verse_number": "१३-१३३-७", "content_sanskrit": "षण्णां तासां ततः प्रीतः पावको गर्भधारणात्।\nस्वेन तेजोविसर्गेण वीर्येण परमेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2093758, "chapter_id": 3003, "verse_number": "१३-१३३-८", "content_sanskrit": "तास्तु षट् कृत्तिका गर्भं पुपुषुर्जातवेदसः।\nषट्सु वर्त्मसु तेजोऽग्नेः सकलं निहितं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2093759, "chapter_id": 3003, "verse_number": "१३-१३३-९", "content_sanskrit": "ततस्ता वर्धमानस्य कुमारस्य महात्मनः।\nतेजसाऽभिपरीताङ्ग्यो न क्वचिच्छर्म लेभिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2093760, "chapter_id": 3003, "verse_number": "१३-१३३-१०", "content_sanskrit": "ततस्तेजःपरीताङ्ग्यः सर्वाः काल उपस्थिते।\nसमं गर्भं सुषुविरे कृतिकास्ता नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2093761, "chapter_id": 3003, "verse_number": "१३-१३३-११", "content_sanskrit": "ततस्तं ष़डधिष्ठानं गर्भमेकत्वमागतम्।\nपृथिवी प्रतिजग्राह कृत्तिकानां समीपतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2093762, "chapter_id": 3003, "verse_number": "१३-१३३-१२", "content_sanskrit": "स गर्भो दिव्यसंस्थानो दीप्तिमान्पावकप्रभः।\nदिव्यं शरवणं प्राप्य ववृधे प्रियदर्शनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2093763, "chapter_id": 3003, "verse_number": "१३-१३३-१३", "content_sanskrit": "ददृशुः कृत्तिकास्तं तु बालमर्कसमद्युतिम्।\nजातस्नेहाश्च सौहार्दात्पुपुषुः स्तन्तविस्रवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2093764, "chapter_id": 3003, "verse_number": "१३-१३३-१४", "content_sanskrit": "अभवत्कार्तिकेयः स त्रैलोक्ये सचराचरे।\nस्कन्नत्वात्स्कन्दतां प्राप्तो गुहावासाद्गुहोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2093765, "chapter_id": 3003, "verse_number": "१३-१३३-१५", "content_sanskrit": "ततो देवास्त्रयस्त्रिंशद्दिशश्च सदिगीश्वराः।\nरुद्रो धाता च विष्णुश्च यमः पूषाऽर्यमा भगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2093766, "chapter_id": 3003, "verse_number": "१३-१३३-१६", "content_sanskrit": "अंशो मित्रश्च साध्याश्च वासवो वसवोऽश्विनौ।\nआपो वायुर्नभश्चन्द्रो नक्षत्राणि ग्रहा रविः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2093767, "chapter_id": 3003, "verse_number": "१३-१३३-१७", "content_sanskrit": "पृथग्भूतानि चान्यानि यानि देवगणानि वै।\nआजग्मुस्तेऽद्भुतं द्रष्टुं कुमारं ज्वलनात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2093768, "chapter_id": 3003, "verse_number": "१३-१३३-१८", "content_sanskrit": "ऋषयस्तुष्टुवुश्चैव गन्धर्वाश्च जगुस्तथा।\nषडाननं कुमारं तु द्विषडक्षं द्विजप्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2093769, "chapter_id": 3003, "verse_number": "१३-१३३-१९", "content_sanskrit": "पीनांसं द्वादशभुजं पावकादित्यवर्चसम्।\nशयानं शरगुल्मस्थं दृष्ट्वा देवाः सहर्षिभिः।\nलेभिरे परमं हर्षं मेनिरे चासुरं हतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2093770, "chapter_id": 3003, "verse_number": "१३-१३३-२०", "content_sanskrit": "ततो देवाः प्रियाण्यस्य सर्व एव समाहरन्।\nक्रीडतः क्रीडनीयानि ददुः पक्षिगणांश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2093771, "chapter_id": 3003, "verse_number": "१३-१३३-२१", "content_sanskrit": "सुपर्णोऽस्य ददौ पुत्रं मयूरं चित्रबर्हिणम्।\nराक्षसाश्च ददुस्तस्मै वराहमहिषावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2093772, "chapter_id": 3003, "verse_number": "१३-१३३-२२", "content_sanskrit": "कुक्कुटं चाग्निसङ्काशं प्रददावरुणः स्वयम्।\nचन्द्रमाः प्रददौ मेषमादित्यो रुचिरां प्रभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2093773, "chapter_id": 3003, "verse_number": "१३-१३३-२३", "content_sanskrit": "गवां माता च गा देवी ददौ शतसहस्रशः।\nछागमग्निर्गुणोपेतमिला पुष्पफलं बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2093774, "chapter_id": 3003, "verse_number": "१३-१३३-२४", "content_sanskrit": "सुधन्वा शकटं चैव रथं चाञ्चितकूबरम्।\nवरुणो वारुणान्दिव्यान्सगजान्प्रददौ शुभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2093775, "chapter_id": 3003, "verse_number": "१३-१३३-२५", "content_sanskrit": "सिंहान्सुरेन्द्रो व्याघ्रांश्च द्विपानन्यांश्च दंष्ट्रिणः।\nश्वापदांश्च बहून्घोराञ्शस्त्राणि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2093776, "chapter_id": 3003, "verse_number": "१३-१३३-२६", "content_sanskrit": "राक्षसासुरसङ्घाश्च अनुजग्मुस्तमीश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2093777, "chapter_id": 3003, "verse_number": "१३-१३३-२७", "content_sanskrit": "वर्धमानवधोपायं प्रार्थयामास तारकः।\nउपायैर्बहुभिर्हन्तुं नाशकच्चापि तं विभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2093778, "chapter_id": 3003, "verse_number": "१३-१३३-२८", "content_sanskrit": "सैनापत्येन तं देवाः पूजयित्वा गुहालयम्।\nशशंसुर्विप्रकारं तं तस्मै तारककारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2093779, "chapter_id": 3003, "verse_number": "१३-१३३-२९", "content_sanskrit": "स विवृद्धो महावीर्यो देवसेनापतिः प्रभुः।\nजघानामोघया शक्त्या दानवं तारकं गुहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2093780, "chapter_id": 3003, "verse_number": "१३-१३३-३०", "content_sanskrit": "तेन तस्मिन्कुमारेण क्रीडता निहतेऽसुरे।\nसुरेन्द्रः स्थापितो राज्ये देवानां पुनरीश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2093781, "chapter_id": 3003, "verse_number": "१३-१३३-३१", "content_sanskrit": "स सेनापतिरेवाथ बभौ स्कन्दः प्रतापवान्।\nईशो गोप्ता च देवानां प्रियकृच्छङ्करस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2093782, "chapter_id": 3003, "verse_number": "१३-१३३-३२", "content_sanskrit": "हिरण्यमूर्तिर्भगवानेव एव च पावकिः।\nसदा कुमारो देवानां सैनापत्यमवाप्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2093783, "chapter_id": 3003, "verse_number": "१३-१३३-३३", "content_sanskrit": "तस्मात्सुवर्णं मङ्गल्यं रत्नमक्षय्यमुत्तमम्।\nसहजं कार्तिकेयस्य वह्नेस्तेजः परं मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2093784, "chapter_id": 3003, "verse_number": "१३-१३३-३४", "content_sanskrit": "एवं रामाय कौरव्य वसिष्ठोऽकथयत्पुरा।\nतस्मात्सुवर्णदानाय प्रयतस्व नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2093785, "chapter_id": 3003, "verse_number": "१३-१३३-३५", "content_sanskrit": "रामः सुवर्णं दत्त्वा हि विमुक्तः सर्वकिल्बिषैः।\nत्रिविष्टपे महत्स्थानमवापासुलभं नरैः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2093786, "chapter_id": 3003, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रयस्त्रिंशदधिकशततमोऽध्यायः॥ १३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]