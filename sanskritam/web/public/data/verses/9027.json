[{"id": 5000027000, "chapter_id": 9027, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकीयरामायणे बालकाण्डे सप्तविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000027001, "chapter_id": 9027, "verse_number": "१-२७-१", "content_sanskrit": "अथ तां रजनीमुष्य विश्वामित्रो महायशाः ।\nप्रहस्य राघवं वाक्यमुवाच मधुरस्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000027002, "chapter_id": 9027, "verse_number": "१-२७-२", "content_sanskrit": "परितुष्टोऽस्मि भद्रं ते राजपुत्र महायशः ।\nप्रीत्या परमया युक्तो ददाम्यस्त्राणि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000027003, "chapter_id": 9027, "verse_number": "१-२७-३", "content_sanskrit": "देवासुरगणान् वापि सगन्धर्वोरगान् भुवि ।\nयैरमित्रान् प्रसह्याजौ वशीकृत्य जयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000027004, "chapter_id": 9027, "verse_number": "१-२७-४", "content_sanskrit": "तानि दिव्यानि भद्रं ते ददाम्यस्त्राणि सर्वशः ।\nदण्डचक्रं महद् दिव्यं तव दास्यामि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000027005, "chapter_id": 9027, "verse_number": "१-२७-५", "content_sanskrit": "धर्मचक्रं ततो वीर कालचक्रं तथैव च ।\nविष्णुचक्रं तथात्युग्रमैन्द्रं चक्रं तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000027006, "chapter_id": 9027, "verse_number": "१-२७-६", "content_sanskrit": "वज्रमस्त्रं नरश्रेष्ठ शैवं शूलवरं तथा ।\nअस्त्रं ब्रह्मशिरश्चैव ऐषीकमपि राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000027007, "chapter_id": 9027, "verse_number": "१-२७-७", "content_sanskrit": "ददामि ते महाबाहो ब्राह्ममस्त्रमनुत्तमम् ।\nगदे द्वे चैव काकुत्स्थ मोदकीशिखरी शुभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000027008, "chapter_id": 9027, "verse_number": "१-२७-८", "content_sanskrit": "प्रदीप्ते नरशार्दूल प्रयच्छामि नृपात्मज ।\nधर्मपाशमहं राम कालपाशं तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000027009, "chapter_id": 9027, "verse_number": "१-२७-९", "content_sanskrit": "वारुणं पाशमस्त्रं च ददान्यहमनुत्तमम् ।\nअशनी द्वे प्रयच्छामि शुष्कार्द्रे रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000027010, "chapter_id": 9027, "verse_number": "१-२७-१०", "content_sanskrit": "ददामि चास्त्रं पैनाकमस्त्रं नारायणं तथा ।\nआग्नेयमस्त्रं दयितं शिखरं नाम नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000027011, "chapter_id": 9027, "verse_number": "१-२७-११", "content_sanskrit": "वायव्यं प्रथमं नाम ददामि तव चानघ ।\nअस्त्रं हयशिरो नाम क्रौञ्चमस्त्रं तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000027012, "chapter_id": 9027, "verse_number": "१-२७-१२", "content_sanskrit": "शक्तिद्वयं च काकुत्स्थ ददामि तव राघव ।\nकङ्कालं मुसलं घोरं कापालमथ किङ्किणीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000027013, "chapter_id": 9027, "verse_number": "१-२७-१३", "content_sanskrit": "वधार्थं रक्षसां यानि ददाम्येतानि सर्वशः ।\nवैद्याधरं महास्त्रं च नन्दनं नाम नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000027014, "chapter_id": 9027, "verse_number": "१-२७-१४", "content_sanskrit": "असिरत्नं महाबाहो ददामि नृवरात्मज ।\nगान्धर्वमस्त्रं दयितं मोहनं नाम नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000027015, "chapter_id": 9027, "verse_number": "१-२७-१५", "content_sanskrit": "प्रस्वापनं प्रशमनं दद्मि सौम्यं च राघव ।\nवर्षणं शोषणं चैव संतापनविलापने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000027016, "chapter_id": 9027, "verse_number": "१-२७-१६", "content_sanskrit": "मादनं चैव दुर्धर्षं कन्दर्पदयितं तथा ।\nगान्धर्वमस्त्रं दयितं मानवं नाम नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000027017, "chapter_id": 9027, "verse_number": "१-२७-१७", "content_sanskrit": "पैशाचमस्त्रं दयितं मोहनं नाम नामतः ।\nप्रतीच्छ नरशार्दूल राजपुत्र महायशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000027018, "chapter_id": 9027, "verse_number": "१-२७-१८", "content_sanskrit": "तामसं नरशार्दूल सौमनं च महाबलम् ।\nसंवर्तं चैव दुर्धर्षं मौसलं च नृपात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000027019, "chapter_id": 9027, "verse_number": "१-२७-१९", "content_sanskrit": "सत्यमस्त्रं महाबाहो तथा मायामयं परम् ।\nसौरं तेजःप्रभं नाम परतेजोऽपकर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000027020, "chapter_id": 9027, "verse_number": "१-२७-२०", "content_sanskrit": "सोमास्त्रं शिशिरं नाम त्वाष्ट्रमस्त्रं सुदारुणम् ।\nदारुणं च भगस्यापि शीतेषुमथ मानवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000027021, "chapter_id": 9027, "verse_number": "१-२७-२१", "content_sanskrit": "एतान् राम महाबाहो कामरूपान् महाबलान् ।\nगृहाण परमोदारान् क्षिप्रमेव नृपात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000027022, "chapter_id": 9027, "verse_number": "१-२७-२२", "content_sanskrit": "स्थितस्तु प्राङ्मुखो भूत्वा शुचिर्मुनिवरस्तदा ।\nददौ रामाय सुप्रीतो मन्त्रग्राममनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000027023, "chapter_id": 9027, "verse_number": "१-२७-२३", "content_sanskrit": "सर्वसंग्रहणं येषां दैवतैरपि दुर्लभम् ।\nतान्यस्त्राणि तदा विप्रो राघवाय न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000027024, "chapter_id": 9027, "verse_number": "१-२७-२४", "content_sanskrit": "जपतस्तु मुनेस्तस्य विश्वामित्रस्य धीमतः ।\nउपतस्थुर्महार्हाणि सर्वाण्यस्त्राणि राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000027025, "chapter_id": 9027, "verse_number": "१-२७-२५", "content_sanskrit": "ऊचुश्च मुदिता रामं सर्वे प्राञ्जलयस्तदा ।\nइमे च परमोदार किंकरास्तव राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000027026, "chapter_id": 9027, "verse_number": "१-२७-२६", "content_sanskrit": "यद्यदिच्छसि भद्रं ते तत्सर्वं करवाम वै ।\nततो रामः प्रसन्नात्मा तैरित्युक्तो महाबलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000027027, "chapter_id": 9027, "verse_number": "१-२७-२७", "content_sanskrit": "प्रतिगृह्य च काकुत्स्थः समालभ्य च पाणिना ।\nमनसा मे भविष्यध्वमिति तान्यभ्यचोदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000027028, "chapter_id": 9027, "verse_number": "१-२७-२८", "content_sanskrit": "ततः प्रीतमना रामो विश्वामित्रं महामुनिम्।\nअभिवाद्य महातेजा गमनायोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000027029, "chapter_id": 9027, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे सप्तविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]