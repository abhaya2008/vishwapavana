[{"id": 7006493000, "chapter_id": 26493, "verse_number": "३-३२-१", "content_sanskrit": "दक्षयज्ञविध्वंसः वैशम्पायन उवाच ततो महति वृत्तान्ते स्थिते राज्ये महोदये ।\nदेवतानां मनुष्याणां सहवासोऽभवत् तदा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006493001, "chapter_id": 26493, "verse_number": "३-३२-२", "content_sanskrit": "एकतः समधीयन्ति सहिताः प्ररुदन्ति च ।\nस्वयं च भागं गृह्णन्ति यज्ञकर्मणि भारत ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006493002, "chapter_id": 26493, "verse_number": "३-३२-३", "content_sanskrit": "प्राचेतसं ततो दक्षं दीक्षित्वा वै बृहस्पतिः ।\nवाजिमेधाय भगवानृषिभिः परिवारितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006493003, "chapter_id": 26493, "verse_number": "३-३२-४", "content_sanskrit": "तस्मिन् मातामहे यज्ञे दक्षस्य विदितात्मनः ।\nशामित्रमकरोद् रुद्रो भागार्थे सह नन्दिना ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006493004, "chapter_id": 26493, "verse_number": "३-३२-५", "content_sanskrit": "रुद्रस्यैव हि तद् रूपं द्विधाभूतं तदीप्सया ।\nजातः परमधर्मात्मा नन्दी पुरुषविग्रहः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006493005, "chapter_id": 26493, "verse_number": "३-३२-६", "content_sanskrit": "तेन योगेन राजेन्द्र यत्तद् ब्रह्म सनातनम् ।\nविहितं सत्यवचनैस्तेनैव परमात्मना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006493006, "chapter_id": 26493, "verse_number": "३-३२-७", "content_sanskrit": "सरूपैश्चाप्यरूपैश्च विरूपाक्षैर्घटोदरैः ।\nऊर्ध्वनेत्रैर्महाकायैर्विकटैर्वामनैस्तथा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006493007, "chapter_id": 26493, "verse_number": "३-३२-८", "content_sanskrit": "शिखिभिर्जटिभिश्चैव त्र्यक्षैश्च शङ्कुकर्णिभिः ।\nचीरिभिश्चर्मिभिश्चैव कूटमुद्गरपाणिभिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006493008, "chapter_id": 26493, "verse_number": "३-३२-९", "content_sanskrit": "सघण्टाधारिभिश्चैव मुञ्जमेखलधारिभिः ।\nसहस्तकटकैश्चैव स्वर्णकुण्डलधारिभिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006493009, "chapter_id": 26493, "verse_number": "३-३२-१०", "content_sanskrit": "सडिण्डिमैः सभेरीयैः समृदङ्गैः सवेणुभिः ।\nएतैः परिवृतो देवो मखं तं समुपारुजत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006493010, "chapter_id": 26493, "verse_number": "३-३२-११", "content_sanskrit": "सशङ्खमुरजैश्चापि सतालफलपाणिभिः ।\nउप्रायुधधरो देवः सपिनाक इवान्तकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006493011, "chapter_id": 26493, "verse_number": "३-३२-१२", "content_sanskrit": "विरराजार्चिभिर्दीप्तैर्मखे मखवतां वरः ।\nकालाग्निरिव दीप्तार्चिर्जगद्दग्धुमिवोद्यतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006493012, "chapter_id": 26493, "verse_number": "३-३२-१३", "content_sanskrit": "नन्दी पिनाकपाणिश्च जघ्नतुर्मखमुत्तमम् ।\nयुगान्त इव कालाग्निः क्षिप्रं दग्धुमिवोद्यतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006493013, "chapter_id": 26493, "verse_number": "३-३२-१४", "content_sanskrit": "यूपमुत्क्षिप्य धावन्ति निशाचरगणास्तथा ।\nत्रासयन् मुनिसंघांश्च चीरचर्मनिवासिनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006493014, "chapter_id": 26493, "verse_number": "३-३२-१५", "content_sanskrit": "हवींष्यन्ये पिबन्त्येव जिह्वाभिस्ताम्रलोचनाः ।\nभक्षयन्ति पशूनन्ये रसनान्तावलम्बिभिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006493015, "chapter_id": 26493, "verse_number": "३-३२-१६", "content_sanskrit": "मुमुचुश्चापरे यूपान् पशवः प्रहरन्ति च ।\nवह्निमध्ये प्रसिञ्चन्ति वारिभिः प्रशमाय च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006493016, "chapter_id": 26493, "verse_number": "३-३२-१७", "content_sanskrit": "सोममन्ये जहुः केचिन्नेत्रैस्ताम्रजपोपमैः ।\nदर्भान् केचिद् विलुम्पन्ति हस्तैः पद्मदलप्रभैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006493017, "chapter_id": 26493, "verse_number": "३-३२-१८", "content_sanskrit": "बभञ्जिरे च यूपाग्रान् कलशांश्चापि चिक्षिपुः ।\nचिच्छिदुः काञ्चनान् वृक्षाञ्छोभार्थमुपकल्पितान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006493018, "chapter_id": 26493, "verse_number": "३-३२-१९", "content_sanskrit": "बिभिदुश्चैव बाणैस्ते मुमुचुश्च हिरण्मयान् ।\nलुलुपुश्चैव पात्राणि ममन्थुश्चारणीमपि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006493019, "chapter_id": 26493, "verse_number": "३-३२-२०", "content_sanskrit": "अरुजंश्चैव प्राग्वंशं लुलुपुश्च समाहिताः ।\nचखादिरे पुरोडाशान् नखाग्रैश्च चकर्तिरे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006493020, "chapter_id": 26493, "verse_number": "३-३२-२१", "content_sanskrit": "एवं दिवा च रात्रौ च भिद्यमानो महामखः ।\nचुक्रोश च महानादान् भिद्यमान इवार्णवः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006493021, "chapter_id": 26493, "verse_number": "३-३२-२२", "content_sanskrit": "धनुः सशरमादाय पूर्वदत्तं स्वयंभुवा ।\nकृतं कीचकवेणुभ्यां समरे सुमहारथः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006493022, "chapter_id": 26493, "verse_number": "३-३२-२३", "content_sanskrit": "प्रतिगृह्य महादेवः स शरैः समयोजयत् ।\nधनुर्विगृह्य जानुभ्यां जघान स महाक्रतुम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006493023, "chapter_id": 26493, "verse_number": "३-३२-२४", "content_sanskrit": "स विद्धस्तेन बाणेन खं समुत्पतितः क्रतुः ।\nमृगो भूत्वा नर्दमानो ब्रह्माणमुपधावति ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006493024, "chapter_id": 26493, "verse_number": "३-३२-२५", "content_sanskrit": "शरेणाभिहतस्त्राणं न लेभे प्रशमं भुवि ।\nशरणार्थी ह्ययं प्राप्तः शरेणान्तर्गतेन च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006493025, "chapter_id": 26493, "verse_number": "३-३२-२६", "content_sanskrit": "तमुवाच मृगं ब्रह्मा शुभं सानुनयं वचः ।\nस्वरेणोत्तमवीर्येण गम्भीरेण सुभाषिणा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006493026, "chapter_id": 26493, "verse_number": "३-३२-२७", "content_sanskrit": "एवंरूपो नभसि त्वं भविष्यसि महामृगः ।\nविजितश्च त्रिपर्वेण शरेणानतपर्वणा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006493027, "chapter_id": 26493, "verse_number": "३-३२-२८", "content_sanskrit": "तिष्ठन् नक्षत्रशिरसि सह रुद्रेण नित्यशः ।\nसोमेन सह संयुक्तो ह्यक्षयेणाव्ययेन च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006493028, "chapter_id": 26493, "verse_number": "३-३२-२९", "content_sanskrit": "दिवि संचारभूतो वै ताराभिः सह संगतः ।\nज्योतिर्भूतो ज्योतिषां त्वं ध्रुवश्चैव महाध्रुवः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006493029, "chapter_id": 26493, "verse_number": "३-३२-३०", "content_sanskrit": "यच्चैतद् रुधिरं दिव्यं क्षतजादभिनिःसृतम् ।\nनभस्युत्पतितं चैव प्रवेगेन प्रधावतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006493030, "chapter_id": 26493, "verse_number": "३-३२-३१", "content_sanskrit": "क्षतजं बहुवर्णं च क्षेत्रं मण्डलसंज्ञितम् ।\nनिमित्तभूतं भूतानां वर्षे वर्षप्रदं तथा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006493031, "chapter_id": 26493, "verse_number": "३-३२-३२", "content_sanskrit": "सुखं दुःखं च भूतानां दर्शने सम्प्रवर्तते ।\nइन्द्रियश्रवणाच्चैव नभसीन्द्रायुधोऽभवत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006493032, "chapter_id": 26493, "verse_number": "३-३२-३३", "content_sanskrit": "चक्षुषी मानुषे राजन् विस्मयात् समवैक्षत ।\nअद्भुतं बहुचित्रं च मनसा सम्प्रकल्पितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006493033, "chapter_id": 26493, "verse_number": "३-३२-३४", "content_sanskrit": "न तु रात्रौ प्रदृश्येत खे सब्रह्मणि संज्ञितम् ।\nदिनस्यैव सदा त्वग्रे महत्कार्यं प्रदृश्यते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006493034, "chapter_id": 26493, "verse_number": "३-३२-३५", "content_sanskrit": "भूमावेव समुत्तिष्ठेदाकाशे तु विलीयते ।\nशतशश्च समं सर्वे प्रधावन्ति प्रचेतसः ।\nभयाद् रुद्रस्य महतो धन्विनो बाणपाणयः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006493035, "chapter_id": 26493, "verse_number": "३-३२-३६", "content_sanskrit": "नन्दी रुद्रगणैः सार्द्धं पिनाकी समतिष्ठत ।\nयुगान्तकाले ज्वलितो ब्रह्मदण्ड इवोद्यतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006493036, "chapter_id": 26493, "verse_number": "३-३२-३७", "content_sanskrit": "विष्णुः शृङ्गसमुद्भूतं प्रगृह्य विपुलं धनुः ।\nप्रातिष्ठत महाबाहुः पाणिना चक्रमादधत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006493037, "chapter_id": 26493, "verse_number": "३-३२-३८", "content_sanskrit": "गदां सघण्टामन्येन खड्गमन्येन पाणिना ।\nप्रगृह्य सोऽग्रतोऽतिष्ठद् रुद्रायोद्यतपाणये ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006493038, "chapter_id": 26493, "verse_number": "३-३२-३९", "content_sanskrit": "ततः शृङ्गाग्रसम्भूतं प्रगृह्य विपुलं धनुः ।\nशङ्खं चाप्रतिमं लोके शरांश्चानतपर्वणः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006493039, "chapter_id": 26493, "verse_number": "३-३२-४०", "content_sanskrit": "विष्णुरग्रस्थितो भाति सबलः संहताङ्गुलिः ।\nबद्धगोधाङ्गुलित्राणः सचन्द्र इव तोयदः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006493040, "chapter_id": 26493, "verse_number": "३-३२-४१", "content_sanskrit": "आदित्या वसवश्चैव दिव्यैः प्रहरणैः सह ।\nविष्णुमेवाभितः सर्वे तिष्ठन्ति ज्वलनप्रभाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006493041, "chapter_id": 26493, "verse_number": "३-३२-४२", "content_sanskrit": "मरुतश्चैव विश्वे च रुद्रमेवाभिपेदिरे ।\nगन्धर्वाः किन्नराश्चैव नागा यक्षाः सपन्नगाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006493042, "chapter_id": 26493, "verse_number": "३-३२-४३", "content_sanskrit": "ऋषयो न्यस्तदण्डाश्च उभयोः पक्षयोर्हिताः ।\nजपन्ति शान्तये नित्यं लोकानां हितकाम्यया ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006493043, "chapter_id": 26493, "verse_number": "३-३२-४४", "content_sanskrit": "रुद्रः शरेणाभ्यहनद् विष्णुमेवाग्रणी रणे ।\nहृदि सर्वाङ्गसन्धीषु तीक्ष्णाग्रेण सुयन्त्रिणा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006493044, "chapter_id": 26493, "verse_number": "३-३२-४५", "content_sanskrit": "न चकम्पे तदा विष्णुः सर्वात्मा ब्रह्मसम्भवः ।\nन च रोषमना नित्यं वृतः सर्वैः षडिन्द्रियैः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006493045, "chapter_id": 26493, "verse_number": "३-३२-४६", "content_sanskrit": "विष्णुश्च धनुरानम्य शरेण समयोजयत् ।\nजत्रुदेशे मुमोचाशु ब्रह्मदण्डमिवोद्यतम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006493046, "chapter_id": 26493, "verse_number": "३-३२-४७", "content_sanskrit": "स विद्धस्तेन बाणेन महादेवो न कम्पते ।\nवज्रेण च महासन्धिर्मन्दरस्य न चाल्यते ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006493047, "chapter_id": 26493, "verse_number": "३-३२-४८", "content_sanskrit": "ततः प्रसभमाप्लुत्य रुद्रं विष्णुः सनातनम् ।\nकण्ठे जग्राह भगवान् नीलकण्ठस्ततोऽभवत् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006493048, "chapter_id": 26493, "verse_number": "३-३२-४९", "content_sanskrit": "अनादिनिधनो देवो क्षमतां हि भवान्मम ।\nसर्वभूतागमाचार्यमचलत्वाच्च कर्मणाम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006493049, "chapter_id": 26493, "verse_number": "३-३२-५०", "content_sanskrit": "कर्मणां चैव कर्ता च विकर्ता चैव भारत ।\nअशेषत्वाच्च भूतानां सर्वभूतेषु चोत्तमः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006493050, "chapter_id": 26493, "verse_number": "३-३२-५१", "content_sanskrit": "स्वयमेव हि यत् कर्म विधत्ते कर्मयोनिषु ।\nतयोः शुभतमो राजन् स्वयमेव तथाकरोत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006493051, "chapter_id": 26493, "verse_number": "३-३२-५२", "content_sanskrit": "अन्तरिक्षाच्छुभा वाचः श्रूयन्ते परमाद्भुताः ।\nसिद्धानां वदनोन्मुक्ताः सनातन नमोऽस्तु ते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006493052, "chapter_id": 26493, "verse_number": "३-३२-५३", "content_sanskrit": "नन्दी पिनाकमुद्यम्य बलवान् रुद्रसम्भवः ।\nमूर्द्धन्यभिजघानाजौ विष्णुं क्रोधेन मूर्छितः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006493053, "chapter_id": 26493, "verse_number": "३-३२-५४", "content_sanskrit": "ततः प्रहसितो विष्णुर्नन्दीं दृष्ट्वा सुरोत्तमः ।\nस्तम्भयामास भगवान् सर्वभूतपतिर्हरिः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006493054, "chapter_id": 26493, "verse_number": "३-३२-५५", "content_sanskrit": "विष्णुर्ब्रह्मसमो भूत्वा तेजसा प्रज्वलन्निव ।\nक्षमया च समायुक्तः स्थितः स्थाणुरिवाचलः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006493055, "chapter_id": 26493, "verse_number": "३-३२-५६", "content_sanskrit": "अचिन्त्यश्चाप्रमेयश्च ह्यजेयश्चाप्यरिंदमः ।\nयुगान्ताग्निसमो भूत्वा शान्तात्मा हरिरव्ययः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006493056, "chapter_id": 26493, "verse_number": "३-३२-५७", "content_sanskrit": "प्रसन्नः कल्पयामास भागं रुद्राय धीमते ।\nविष्णुर्धर्मपरो नित्यं त्यक्तकामः सुरोत्तमः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006493057, "chapter_id": 26493, "verse_number": "३-३२-५८", "content_sanskrit": "विष्णुना चैव राजेन्द्र स यज्ञः संधितः पुनः ।\nयथापक्षं च ते सर्वे गणास्त्वासन् महीपते ।\nतस्मिन् युद्धे महाघोरे विष्णू रुद्रस्य चैव ह ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006493058, "chapter_id": 26493, "verse_number": "३-३२-५९", "content_sanskrit": "यथापक्षं भवेद् युद्धं दक्षयज्ञविनाशने ।\nविनाशश्चैव यज्ञस्य तदा लोके प्रतिष्ठितः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006493059, "chapter_id": 26493, "verse_number": "३-३२-६०", "content_sanskrit": "सर्वभूतेषु राजेन्द्र हितो यज्ञः सनातनः ।\nदक्षो यज्ञफलं चैव प्राप्तवान् स प्रजापतिः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006493060, "chapter_id": 26493, "verse_number": "३-३२-६१", "content_sanskrit": "इमां चोदाहृतां दिव्यां कथामिति स बुद्धिमान् ।\nश्रावयेद् यस्तु विप्रेभ्यः शुचिः प्रयतमानसः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006493061, "chapter_id": 26493, "verse_number": "३-३२-६२", "content_sanskrit": "अधीत्य सर्वमध्यात्मं देवलोके महीयते ।\nएष पौष्करको नाम प्रादुर्भावो महात्मनः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006493062, "chapter_id": 26493, "verse_number": "३-३२-६३", "content_sanskrit": "पुराणे पौष्करे चैव मया द्वैपायनेरितः ।\nयथावदनुपूर्वेण संस्कृतः परमर्षिभिः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006493063, "chapter_id": 26493, "verse_number": "३-३२-६४", "content_sanskrit": "यश्चैनमग्र्यं पुरुषः पुराणं सदाप्रमत्तः शृणुयाद् यथोक्तम् ।\nअवाप्य कामानिह वीतशोकः परत्र च स्वर्गफलानि भुङ्क्ते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]