[{"id": 7004001000, "chapter_id": 24001, "verse_number": "३-२-१२-१", "content_sanskrit": "व्यास उवाच ।\nततो देवैर्नृपश्रेष्ठ रक्षार्थं सत्यमंदिरम् ।\nस्थापितं तत्तदाद्यैव सत्याभिख्या हि सा पुरी॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004001001, "chapter_id": 24001, "verse_number": "३-२-१२-२", "content_sanskrit": "पूर्वं धर्मेश्वरो देवो दक्षिणेन गणाधिपः ।\nपश्चिमे स्थापितो भानुरुत्तरे च स्वयंभुवः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004001002, "chapter_id": 24001, "verse_number": "३-२-१२-३", "content_sanskrit": "युधिष्ठिर उवाच ।\nगणेशः स्थापितः केन कस्मात्स्थापितवानसौ ।\nकिं नामासौ महाभाग तन्मे कथय मा चिरम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004001003, "chapter_id": 24001, "verse_number": "३-२-१२-४", "content_sanskrit": "व्यास उवाच ।\nअधुनाहं प्रवक्ष्यामि गणेशोत्पत्तिकारणम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004001004, "chapter_id": 24001, "verse_number": "३-२-१२-५", "content_sanskrit": "समये मिलिताः सर्वे देवता मातरस्तथा ।\nधर्मारण्ये महाराज स्थापितश्चंडिकासुतः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004001005, "chapter_id": 24001, "verse_number": "३-२-१२-६", "content_sanskrit": "आदौ देवैर्नृपश्रेष्ठ भूमौ वै सत्ययोषिताम् ।\nप्राकारश्चाभवत्तत्र पताकाध्वजशोभितः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004001006, "chapter_id": 24001, "verse_number": "३-२-१२-७", "content_sanskrit": "ब्राह्मणायतने तत्र प्राकारमण्डलान्तरे ।\nतन्मध्ये रचितं पीठमिष्टकाभिः सुशोभितम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004001007, "chapter_id": 24001, "verse_number": "३-२-१२-८", "content_sanskrit": "प्रतोल्यश्च चतस्रो वै शुद्धा एव सतोरणाः ।\nपूर्वे धर्मेश्वरो देवो दक्षिणे गणनायकः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004001008, "chapter_id": 24001, "verse_number": "३-२-१२-९", "content_sanskrit": "पश्चिमे स्थापितो भानुरुत्तरे च स्वयंभुवः ।\nधर्मेश्वरोत्पत्तिवृत्तमाख्यातं तत्तवाग्रतः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004001009, "chapter_id": 24001, "verse_number": "३-२-१२-१०", "content_sanskrit": "अधुनाहं प्रवक्ष्यामि गणेशोत्पत्तिहेतुकम् ।\nकदाचित्पार्वती गात्रोद्वर्त्तनं कृतवत्यभूत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004001010, "chapter_id": 24001, "verse_number": "३-२-१२-११", "content_sanskrit": "मलं तज्जनितं दृष्ट्वा हस्ते धृत्वा स्वगात्रजम् ।\nप्रतिमां च ततः कृत्वा सुरूपं च ददर्श ह॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004001011, "chapter_id": 24001, "verse_number": "३-२-१२-१२", "content_sanskrit": "जीवं तस्यां च संचार्य उदतिष्ठत्तदग्रतः ।\nमातरं स तदोवाच कि करोमि तवाज्ञया॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004001012, "chapter_id": 24001, "verse_number": "३-२-१२-१३", "content_sanskrit": "पार्वत्युवाच ।\nयावत्स्नानं करिष्यामि तावत्त्वं द्वारि तिष्ठ मे ।\nआयुधानि च सर्वाणि परश्वादीनि यानि तु॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004001013, "chapter_id": 24001, "verse_number": "३-२-१२-१४", "content_sanskrit": "त्वयि तिष्ठति मद्द्वारे कोऽपि विघ्नं करोतु न ।\nएवमुक्तो महादेव्या द्वारेऽतिष्ठत्स सायुधः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004001014, "chapter_id": 24001, "verse_number": "३-२-१२-१५", "content_sanskrit": "एतस्मिन्नंतरे देवो महादेवो जगाम ह ।\nआभ्यंतरे प्रवेष्टुं च मतिं दध्रे महेश्वरः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004001015, "chapter_id": 24001, "verse_number": "३-२-१२-१६", "content_sanskrit": "द्वारस्थेन गणेशेन प्रवेशोदायि तस्य न ।\nततः क्रुद्धो महादेवः परस्परमयुध्यत॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004001016, "chapter_id": 24001, "verse_number": "३-२-१२-१७", "content_sanskrit": "युद्धं कृत्वा ततश्चोभौ परस्परवधैषिणौ ।\nपरशुं जघ्निवान्देव ललाटे परमे शुभम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004001017, "chapter_id": 24001, "verse_number": "३-२-१२-१८", "content_sanskrit": "ततो देवो महादेवः शूलमुद्यम्य चाहनत् ।\nशिरश्चिच्छेद शूलेन तद्भूमौ निपपात ह॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004001018, "chapter_id": 24001, "verse_number": "३-२-१२-१९", "content_sanskrit": "तं दृष्ट्वा पतितं पुत्रं पार्वती प्ररुरोद ह ।\nहाहाकारो महानासीत्तदा तत्र निपातिते॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004001019, "chapter_id": 24001, "verse_number": "३-२-१२-२०", "content_sanskrit": "पार्वतीं विकलां दृष्ट्वा देवदेवो महेश्वरः ।\nचिंतयामास देवोऽपि किं कृतं वा मुधा मया॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004001020, "chapter_id": 24001, "verse_number": "३-२-१२-२१", "content_sanskrit": "एतस्मिन्नंतरे तत्र गजासुरमपश्यत ।\nतं दृष्ट्वा च महादैत्यं सर्वलोकैकपूजितः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004001021, "chapter_id": 24001, "verse_number": "३-२-१२-२२", "content_sanskrit": "जघ्निवांस्तच्छिरो गृह्य पार्वत्या कृतमर्भकम् ।\nउत्तस्थौ सगणस्तत्र महादेवस्य सन्निधौ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004001022, "chapter_id": 24001, "verse_number": "३-२-१२-२३", "content_sanskrit": "ततो नाम चकारास्य गजानन इति स्फुटम् ।\nसुराः सर्वे च संपृक्ता हर्षिता मुनयस्तथा॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004001023, "chapter_id": 24001, "verse_number": "३-२-१२-२४", "content_sanskrit": "स्तुवंति स्तुतिभिः शश्वत्कुटुम्बकुशलंकरम् ।\nविक्रीणाति कुटुम्बं यो मोदकार्थं समर्चके॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004001024, "chapter_id": 24001, "verse_number": "३-२-१२-२५", "content_sanskrit": "दक्षिणस्यां प्रतोल्यां तमेकदंतं च पीवरम् ।\nआर्चयच्च महादेवं स्वयंभूः सुरपूजितम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004001025, "chapter_id": 24001, "verse_number": "३-२-१२-२६", "content_sanskrit": "जटिलं वामनं चैव नागयज्ञोपवीतकम् ।\nत्र्यक्षं चैव महाकायं करध्वजकुठारकम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004001026, "chapter_id": 24001, "verse_number": "३-२-१२-२७", "content_sanskrit": "दधानं कमलं हस्ते सर्वविप्रविनाशनम् ।\nरक्षणाय च लोकानां नगराद्दक्षिणाश्रितम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004001027, "chapter_id": 24001, "verse_number": "३-२-१२-२८", "content_sanskrit": "सुप्रसन्नं गणाध्यक्षं सिद्धिबुद्धिनमस्कृतम् ।\nसिंदूराभं सुरश्रेष्ठं तीव्रांकुशधरं शुभम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004001028, "chapter_id": 24001, "verse_number": "३-२-१२-२९", "content_sanskrit": "शतपुष्पैः शुभैः पुष्पैरर्चितं ह्यमराधिपः ।\nप्रणम्य च महाभक्त्या तुष्टुवु स्तं सुरास्ततः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004001029, "chapter_id": 24001, "verse_number": "३-२-१२-३०", "content_sanskrit": "देवा ऊचुः ।\nनमस्तेस्तु सुरेशाय गणानां पतये नमः ।\nगजानन नमस्तुभ्यं महादेवाधिदैवत॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004001030, "chapter_id": 24001, "verse_number": "३-२-१२-३१", "content_sanskrit": "भक्तिप्रियाय देवाय गणाध्यक्ष नमोस्तु ते ।\nइत्येतैश्च शुभैः स्तोत्रैः स्तूयमानो गणाधिपः ।\nसुप्रीतश्च गणाध्यक्षः तदाऽसौ वाक्यमब्रवीत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004001031, "chapter_id": 24001, "verse_number": "३-२-१२-३२", "content_sanskrit": "गणाध्यक्ष उवाच ।\nतुष्टोऽहं वो सुरा ब्रूत वांछितं च ददामि वः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004001032, "chapter_id": 24001, "verse_number": "३-२-१२-३३", "content_sanskrit": "देवा ऊचुः ।\nत्वमत्रस्थो महाभाग कुरु कार्यं च नः प्रभो ।\nधर्मारण्ये च विप्राणां वणिग्जननिवासिनाम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004001033, "chapter_id": 24001, "verse_number": "३-२-१२-३४", "content_sanskrit": "ब्रह्मचर्यादियुक्तानां धार्मिकाणां गणेश्वर ।\nवर्णाश्रमेतराणां च रक्षिता भव सर्वदा॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004001034, "chapter_id": 24001, "verse_number": "३-२-१२-३५", "content_sanskrit": "त्वत्प्रसादान्महाभाग धनसौख्ययुता द्विजाः ।\nभवंतु सर्वे सततं वणिजश्च महाबलाः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004001035, "chapter_id": 24001, "verse_number": "३-२-१२-३६", "content_sanskrit": "रक्षितव्यास्त्वया देव यावच्चंद्रार्कमेदिनी ।\nएवमस्त्विति सोवादीद्गणनाथो महेश्वरः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004001036, "chapter_id": 24001, "verse_number": "३-२-१२-३७", "content_sanskrit": "देवाश्च हर्षमापन्नाः पूजयंति गणाधिपम् ।\nततो देवा मुदा युक्ताः पुष्पधूपादितर्पणैः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004001037, "chapter_id": 24001, "verse_number": "३-२-१२-३८", "content_sanskrit": "ये चान्ये मनुजा लोके निर्विघ्नार्थं च पूजयन्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004001038, "chapter_id": 24001, "verse_number": "३-२-१२-३९", "content_sanskrit": "विवाहोत्सवयज्ञेषु पूर्वमाराधितो भवेत् ।\nधर्मारण्योद्भवानां च प्रसन्नो भव सर्वदा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]