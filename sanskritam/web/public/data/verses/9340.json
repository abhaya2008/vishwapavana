[{"id": 40020666, "chapter_id": 9340, "verse_number": "1", "content_sanskrit": "एवं सञ्चिन्त्य विप्रेन्दो जगाम लघुविक्रमः । आख्यातुं तद्यथावृत्तं यमस्य सदनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40020667, "chapter_id": 9340, "verse_number": "2", "content_sanskrit": "अपश्यत्स यमं तत्र देवमग्निपुरस्कृतम् । विधानमुपतिष्ठन्तं प्राणिनो यस्य यादृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40020668, "chapter_id": 9340, "verse_number": "3", "content_sanskrit": "स तु दृष्ट्वा यमः प्राप्तं महर्षिं तत्र नारदम् । अब्रवीत्सुखमासीनमर्घ्यमावेद्य धर्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40020669, "chapter_id": 9340, "verse_number": "4", "content_sanskrit": "कच्चित्क्षेमं तु देवर्षे कच्चिद्धर्मो न नश्यति । किमागमनकृत्यं ते देवगन्धर्वसेवित ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40020670, "chapter_id": 9340, "verse_number": "5", "content_sanskrit": "अब्रवीत्तु तदा वाक्यं नारदो भगवानृषिः । श्रूयतामभिधास्यामि विधानं च विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40020671, "chapter_id": 9340, "verse_number": "6", "content_sanskrit": "एष नाम्नो दशग्रीवः पितृराज निशाचरः । उपयाति वशं नेतुं विक्रमैस्त्वां सुदुर्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40020672, "chapter_id": 9340, "verse_number": "7", "content_sanskrit": "एतेन कारणेनाहं त्वरितो ह्यागतः प्रभो । दण्डप्रहरणस्याद्य तव किं नु भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40020673, "chapter_id": 9340, "verse_number": "8", "content_sanskrit": "एतस्मिन्नन्तरे दुरादंशुमन्तमिवोदितम् । ददृशुर्दीप्तमायान्तं विमानं तस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40020674, "chapter_id": 9340, "verse_number": "9", "content_sanskrit": "तं देशं प्रभया तस्य पुष्पकस्य महाबलः । कृत्वा वितिमिरं सर्वं समीपं सो ऽभ्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40020675, "chapter_id": 9340, "verse_number": "10", "content_sanskrit": "सो ऽपश्यत्स महाबाहुर्दशग्रीवस्ततस्ततः । प्राणिनः सुकृतं कर्म भुञ्जानांश्चैव दुष्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40020676, "chapter_id": 9340, "verse_number": "11", "content_sanskrit": "अपश्यत्सैनिकांश्चास्य यमस्यानुचरैः सह । यमस्य पुरुषैरुग्रैर्घोररूपैर्भयानकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40020677, "chapter_id": 9340, "verse_number": "12", "content_sanskrit": "ददर्श वध्यमानांश्च क्लिश्यमानांश्च देहिनः । क्रोशतश्च महानादं तीव्रनिष्टनतत्परान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40020678, "chapter_id": 9340, "verse_number": "13", "content_sanskrit": "कृमिभिर्भक्ष्यमाणांश्च सारमेयैश्च दारुणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40020679, "chapter_id": 9340, "verse_number": "14", "content_sanskrit": "क्षोत्रायासकरा वाचो वदतश्च भयावहाः । सन्तार्यमाणान्वैतरणीं बहुशः शोणितोदकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40020680, "chapter_id": 9340, "verse_number": "15", "content_sanskrit": "वालुकासु च तप्तासु तप्यमानान्मुहूर्मुहुः । असिपत्रवने चैव भिद्यमानानधार्मिकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40020681, "chapter_id": 9340, "verse_number": "16", "content_sanskrit": "रौरवे क्षारनद्यां च क्षुरधारासु चैव हि । पानीयं याचमानांश्च तृषितान्क्षुधितानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40020682, "chapter_id": 9340, "verse_number": "17", "content_sanskrit": "शवभूतान्कृशान्दीनान्विवर्णान्मुक्तमूर्धजान् । मलपङ्कधरान्दीनान्रूक्षांश्च परिधावतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40020683, "chapter_id": 9340, "verse_number": "18", "content_sanskrit": "ददर्श रावणो मार्गे शतशो ऽथ सहस्रशः । कांश्चिच्च गृहमुख्येषु गीतवादित्रनिःस्वनैः । प्रमोदमानानद्राक्षीद्रावणः सुकृतैः स्वकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40020684, "chapter_id": 9340, "verse_number": "19", "content_sanskrit": "गौरसं गोप्रदातारो ह्यन्नं चैवान्नदायिनः । गृहांश्च गृहदातारः स्वकर्मफलमश्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40020685, "chapter_id": 9340, "verse_number": "20", "content_sanskrit": "सुवर्णमणिमुक्ताभिः प्रमदाभिरलङ्कृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40020686, "chapter_id": 9340, "verse_number": "21", "content_sanskrit": "धार्मिकानपरांस्तत्र दीप्यमानान्स्वतेजसा । ददर्श सुमहाबाहू रावणो राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40020687, "chapter_id": 9340, "verse_number": "22", "content_sanskrit": "ततस्तान्भिद्यमानांश्च कर्मभिर्दुष्कृतैः स्वकैः । रावणो मोचयामास विक्रमेण बलाद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40020688, "chapter_id": 9340, "verse_number": "23", "content_sanskrit": "प्राणिनो मोचितास्तेन दशग्रीवेण रक्षसा । सुखमापुर्मुहूर्तं ते ह्यतर्कितमचिन्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40020689, "chapter_id": 9340, "verse_number": "24", "content_sanskrit": "प्रेतेषु मुच्यमानेषु राक्षसेन महीयसा । प्रेतगोपाः सुसङ्क्रुद्धा राक्षसेन्द्रमभिद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40020690, "chapter_id": 9340, "verse_number": "25", "content_sanskrit": "ततो हलहलाशब्दः सर्वदिग्भ्यः समुत्थितः । धर्मराजस्य योधानां शूराणां सम्प्रधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40020691, "chapter_id": 9340, "verse_number": "26", "content_sanskrit": "ते प्रासैः परिघैः शूलैर्मुसलैः शक्तितोमरैः । पुष्पकं समवर्षन्त शूराः शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40020692, "chapter_id": 9340, "verse_number": "27", "content_sanskrit": "तस्यासनानि प्रासादान्वेदिकास्तोरणानि च । पुष्पकस्य बभञ्जुस्ते शीघ्रं मधुकरा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40020693, "chapter_id": 9340, "verse_number": "28", "content_sanskrit": "देवनिष्ठानभूतं तद्विमानं पुष्पकं मृधे । भज्यमानं तथैवासीदक्षयं ब्रह्मतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40020694, "chapter_id": 9340, "verse_number": "29", "content_sanskrit": "असङ्ख्या सुमहत्यासीत्तस्य सेना महात्मनः । शूराणामग्रयातऽणां सहस्राणि शतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40020695, "chapter_id": 9340, "verse_number": "30", "content_sanskrit": "ततो वृक्षैश्च शैलैश्च प्रासादानां शतैस्तथा । ततस्ते सचिवास्तस्य यथाकामं यथाबलम् । अयुध्यन्त महावीराः स च राजा दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40020696, "chapter_id": 9340, "verse_number": "31", "content_sanskrit": "ते तु शोणितदिग्धाङ्गाः सर्वशस्त्रसमाहताः । अमात्या राक्षसेन्द्रस्य चक्रुरायोधनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40020697, "chapter_id": 9340, "verse_number": "32", "content_sanskrit": "अन्योन्यं ते महाभागा जघ्नुः प्रहरणैर्भृशम् । यमस्य च महाबाहो रावणस्य च मन्त्रिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40020698, "chapter_id": 9340, "verse_number": "33", "content_sanskrit": "अमात्यांस्तांस्तु सन्त्यज्य यमयोधा महाबलाः । तमेव चाभ्यधावन्त शूलवर्षैर्दशाननम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40020699, "chapter_id": 9340, "verse_number": "34", "content_sanskrit": "ततः शोणितदिग्धाङ्गः प्रहारैर्जर्जरीकृतः । फुल्लाशोक इवाभाति पुष्पके राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40020700, "chapter_id": 9340, "verse_number": "35", "content_sanskrit": "स तु शूलगदापासाञ्छक्तितोमरसायकान् । मुसलानि शिलावृक्षान्मुमोचास्त्रबलाद्बली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40020701, "chapter_id": 9340, "verse_number": "36", "content_sanskrit": "तरूणां च शिलानां च शस्त्राणां चातिदारुणम् । यमसैन्येषु तद्वर्षं पपात धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40020702, "chapter_id": 9340, "verse_number": "37", "content_sanskrit": "तांस्तु सर्वान्विनिर्भिद्य तदस्त्रमपहत्य च । जघ्नुस्ते राक्षसं घोरमेकं शतसहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40020703, "chapter_id": 9340, "verse_number": "38", "content_sanskrit": "परिवार्य च तं सर्वे शैलं मोघोत्करा इव । भिन्दिपालैश्च शूलैश्च निरुच्छ्वासमपोथयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40020704, "chapter_id": 9340, "verse_number": "39", "content_sanskrit": "विमुक्तकवचः क्रुद्धः सिक्तः शोणितविस्रवैः । ततः स पुष्पकं त्यक्त्वा पृथिव्यामवतिष्ठत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40020705, "chapter_id": 9340, "verse_number": "40", "content_sanskrit": "ततः स कार्मुकी वाणी समरे चाभिवर्तत । लब्धसञ्ज्ञो मुहूर्तेन क्रुद्धस्तस्थौ यथान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40020706, "chapter_id": 9340, "verse_number": "41", "content_sanskrit": "ततः पाशुपतं दिव्यमस्त्रं सन्धाय कार्मुके । तिष्ठ तिष्ठेति तानुक्त्वा तच्चापं विचकर्ष स ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40020707, "chapter_id": 9340, "verse_number": "42", "content_sanskrit": "आकर्णात्स विकृष्याथ चापमिन्द्रारिराहवे । मुमोच तं शरं क्रुद्धस्त्रिपुरे शङ्करो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40020708, "chapter_id": 9340, "verse_number": "43", "content_sanskrit": "तस्य रूपं शरस्यासीत्विधूमज्वालमण्डलम् । वनं दहिष्यतो घर्मे दावाग्नेरिव मूर्च्छतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40020709, "chapter_id": 9340, "verse_number": "44", "content_sanskrit": "ज्वालामाली स तु शरः क्रव्यादानुगतो रणे । मुक्तो गुल्मान्द्रुमांश्चापि भस्म कृत्वा प्रधावति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40020710, "chapter_id": 9340, "verse_number": "45", "content_sanskrit": "ते तस्य तेजसा दग्धाः सैन्या वैवस्वतस्य तु । रणे तस्मिन्निपतिता दावदग्धा नगा इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40020711, "chapter_id": 9340, "verse_number": "46", "content_sanskrit": "ततस्तु सिचवैः सार्धं राक्षसो भीमविक्रमः । ननाद सुमहानादं कम्पयन्निव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]