[{"id": 5000520000, "chapter_id": 9520, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे त्रयोदशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000520001, "chapter_id": 9520, "verse_number": "६-११३-१", "content_sanskrit": "इति प्रतिसमादिष्टो हनूमान् मारुतात्मजः।\nप्रविवेश पुरीं लङ्कां पूज्यमानो निशाचरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000520002, "chapter_id": 9520, "verse_number": "६-११३-२", "content_sanskrit": "प्रविश्य च पुरीं लङ्कामनुज्ञाप्य विभीषणम्।\nततस्तेनाभ्यनुज्ञातो हनूमान् वृक्षवाटिकाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000520003, "chapter_id": 9520, "verse_number": "६-११३-३", "content_sanskrit": "सम्प्रविश्य यथान्यायं सीताया विदितो हरिः।\nददर्श मृजया हीनां सातङ्कां रोहिणीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000520004, "chapter_id": 9520, "verse_number": "६-११३-४", "content_sanskrit": "वृक्षमूले निरानन्दां राक्षसीभिः परीवृताम्।\nनिभृतः प्रणतः प्रह्वः सोऽभिगम्याभिवाद्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000520005, "chapter_id": 9520, "verse_number": "६-११३-५", "content_sanskrit": "दृष्ट्वा तमागतं देवी हनूमन्तं महाबलम्।\nतूष्णीमास्त तदा दृष्ट्वा स्मृत्वा हृष्टाभवत् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000520006, "chapter_id": 9520, "verse_number": "६-११३-६", "content_sanskrit": "सौम्यं तस्या मुखं दृष्ट्वा हनूमान् प्लवगोत्तमः।\nरामस्य वचनं सर्वमाख्यातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000520007, "chapter_id": 9520, "verse_number": "६-११३-७", "content_sanskrit": "वैदेहि कुशली रामः सहसुग्रीवलक्ष्मणः।\nकुशलं चाह सिद्धार्थो हतशत्रुरमित्रजित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000520008, "chapter_id": 9520, "verse_number": "६-११३-८", "content_sanskrit": "विभीषणसहायेन रामेण हरिभिः सह।\nनिहतो रावणो देवि लक्ष्मणेन च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000520009, "chapter_id": 9520, "verse_number": "६-११३-९", "content_sanskrit": "प्रियमाख्यामि ते देवि भूयश्च त्वां सभाजये।\nतव प्रभावाद् धर्मज्ञे महान् रामेण संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000520010, "chapter_id": 9520, "verse_number": "६-११३-१०", "content_sanskrit": "लब्धोऽयं विजयः सीते स्वस्था भव गतज्वरा।\nरावणश्च हतः शत्रुर्लङ्का चैव वशीकृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000520011, "chapter_id": 9520, "verse_number": "६-११३-११", "content_sanskrit": "मया ह्यलब्धनिद्रेण धृतेन तव निर्जये।\nप्रतिज्ञैषा विनिस्तीर्णा बद्‍ध्वा सेतुं महोदधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000520012, "chapter_id": 9520, "verse_number": "६-११३-१२", "content_sanskrit": "सम्भ्रमश्च न कर्तव्यो वर्तन्त्या रावणालये।\nविभीषणविधेयं हि लङ्कैश्वर्यमिदं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000520013, "chapter_id": 9520, "verse_number": "६-११३-१३", "content_sanskrit": "तदाश्वसिहि विस्रब्धं स्वगृहे परिवर्तसे।\nअयं चाभ्येति संहृष्टस्त्वद्दर्शनसमुत्सुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000520014, "chapter_id": 9520, "verse_number": "६-११३-१४", "content_sanskrit": "एवमुक्ता तु सा देवी सीता शशिनिभानना।\nप्रहर्षेणावरुद्धा सा व्याहर्तुं न शशाक ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000520015, "chapter_id": 9520, "verse_number": "६-११३-१५", "content_sanskrit": "ततोऽब्रवीद्धरिवरः सीतामप्रतिजल्पतीम्।\nकिं त्वं चिन्तयसे देवि किं च मां नाभिभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000520016, "chapter_id": 9520, "verse_number": "६-११३-१६", "content_sanskrit": "एवमुक्ता हनुमता सीता धर्मपथे स्थिता।\nअब्रवीत् परमप्रीता बाष्पगद‍्गदया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000520017, "chapter_id": 9520, "verse_number": "६-११३-१७", "content_sanskrit": "प्रियमेतदुपश्रुत्य भर्तुर्विजयसंश्रितम्।\nप्रहर्षवशमापन्ना निर्वाक्यास्मि क्षणान्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000520018, "chapter_id": 9520, "verse_number": "६-११३-१८", "content_sanskrit": "नहि पश्यामि सदृशं चिन्तयन्ती प्लवंगम।\nआख्यानकस्य भवतो दातुं प्रत्यभिनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000520019, "chapter_id": 9520, "verse_number": "६-११३-१९", "content_sanskrit": "न हि पश्यामि तत् सौम्य पृथिव्यामपि वानर।\nसदृशं यत्प्रियाख्याने तव दत्त्वा भवेत् सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000520020, "chapter_id": 9520, "verse_number": "६-११३-२०", "content_sanskrit": "हिरण्यं वा सुवर्णं वा रत्नानि विविधानि च।\nराज्यं वा त्रिषु लोकेषु एतन्नार्हति भाषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000520021, "chapter_id": 9520, "verse_number": "६-११३-२१", "content_sanskrit": "एवमुक्तस्तु वैदेह्या प्रत्युवाच प्लवंगमः।\nप्रगृहीताञ्जलिर्हर्षात् सीतायाः प्रमुखे स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000520022, "chapter_id": 9520, "verse_number": "६-११३-२२", "content_sanskrit": "भर्तुः प्रियहिते युक्ते भर्तुर्विजयकांक्षिणि।\nस्निग्धमेवंविधं वाक्यं त्वमेवार्हस्यनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000520023, "chapter_id": 9520, "verse_number": "६-११३-२३", "content_sanskrit": "तवैतद् वचनं सौम्ये सारवत् स्निग्धमेव च।\nरत्नौघाद् विविधाच्चापि देवराज्याद् विशिष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000520024, "chapter_id": 9520, "verse_number": "६-११३-२४", "content_sanskrit": "अर्थतश्च मया प्राप्ता देवराज्यादयो गुणाः।\nहतशत्रुं विजयिनं रामं पश्यामि सुस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000520025, "chapter_id": 9520, "verse_number": "६-११३-२५", "content_sanskrit": "तस्य तद् वचनं श्रुत्वा मैथिली जनकात्मजा।\nततः शुभतरं वाक्यमुवाच पवनात्मजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000520026, "chapter_id": 9520, "verse_number": "६-११३-२६", "content_sanskrit": "अतिलक्षणसम्पन्नं माधुर्यगुणभूषणम्।\nबुद्‍ध्या ह्यष्टाङ्गया युक्तं त्वमेवार्हसि भाषितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000520027, "chapter_id": 9520, "verse_number": "६-११३-२७", "content_sanskrit": "श्लाघनीयोऽनिलस्य त्वं सुतः परमधार्मिकः।\nबलं शौर्यं श्रुतं सत्त्वं विक्रमो दाक्ष्यमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000520028, "chapter_id": 9520, "verse_number": "६-११३-२८", "content_sanskrit": "तेजः क्षमा धृतिः स्थैर्यं विनीतत्वं न संशयः।\nएते चान्ये च बहवो गुणास्त्वय्येव शोभनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000520029, "chapter_id": 9520, "verse_number": "६-११३-२९", "content_sanskrit": "अथोवाच पुनः सीतामसम्भ्रान्तो विनीतवत्।\nप्रगृहीताञ्जलिर्हर्षात् सीतायाः प्रमुखे स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000520030, "chapter_id": 9520, "verse_number": "६-११३-३०", "content_sanskrit": "इमास्तु खलु राक्षस्यो यदि त्वमनुमन्यसे।\nहन्तुमिच्छामि ताः सर्वा याभिस्त्वं तर्जिता पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000520031, "chapter_id": 9520, "verse_number": "६-११३-३१", "content_sanskrit": "क्लिश्यन्तीं पतिदेवां त्वामशोकवनिकां गताम्।\nघोररूपसमाचाराः क्रूराः क्रूरतरेक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000520032, "chapter_id": 9520, "verse_number": "६-११३-३२", "content_sanskrit": "इह श्रुता मया देवि राक्षस्यो विकृताननाः।\nअसकृत्परुषैर्वाक्यैर्वदन्त्यो रावणाज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000520033, "chapter_id": 9520, "verse_number": "६-११३-३३", "content_sanskrit": "विकृता विकृताकाराः क्रूराः क्रूरकचेक्षणाः।\nइच्छामि विविधैर्घातैर्हन्तुमेताः सुदारुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000520034, "chapter_id": 9520, "verse_number": "६-११३-३४", "content_sanskrit": "राक्षस्यो दारुणकथा वरमेतत् प्रयच्छ मे।\nमुष्टिभिः पार्ष्णिघातैश्च विशालैश्चैव बाहुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000520035, "chapter_id": 9520, "verse_number": "६-११३-३५", "content_sanskrit": "जङ्घाजानुप्रहारैश्च दन्तानां चैव पीडनैः।\nकर्तनैः कर्णनासानां केशानां लुञ्चनैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000520036, "chapter_id": 9520, "verse_number": "६-११३-३६", "content_sanskrit": "निपात्य हन्तुमिच्छामि तव विप्रियकारिणीः।\nएवं प्रहारैर्बहुभिः सम्प्रहार्य यशस्विनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000520037, "chapter_id": 9520, "verse_number": "६-११३-३७", "content_sanskrit": "घातये तीव्ररूपाभिर्याभिस्त्वं तर्जिता पुरा।\nइत्युक्ता सा हनुमता कृपणा दीनवत्सला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000520038, "chapter_id": 9520, "verse_number": "६-११३-३८", "content_sanskrit": "हनूमन्तमुवाचेदं चिन्तयित्वा विमृश्य च।\nराजसंश्रयवश्यानां कुर्वतीनां पराज्ञया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000520039, "chapter_id": 9520, "verse_number": "६-११३-३९", "content_sanskrit": "विधेयानां च दासीनां कः कुप्येद् वानरोत्तम।\nभाग्यवैषम्यदोषेण पुरस्ताद्दुष्कृतेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000520040, "chapter_id": 9520, "verse_number": "६-११३-४०", "content_sanskrit": "मयैतत् प्राप्यते सर्वं स्वकृतं ह्युपभुज्यते।\nमैवं वद महाबाहो दैवी ह्येषा परा गतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000520041, "chapter_id": 9520, "verse_number": "६-११३-४१", "content_sanskrit": "प्राप्तव्यं तु दशायोगान्मयैतदिति निश्चितम्।\nदासीनां रावणस्याहं मर्षयामीह दुर्बला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000520042, "chapter_id": 9520, "verse_number": "६-११३-४२", "content_sanskrit": "आज्ञप्ता राक्षसेनेह राक्षस्यस्तर्जयन्ति माम्।\nहते तस्मिन् न कुर्वन्ति तर्जनं मारुतात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000520043, "chapter_id": 9520, "verse_number": "६-११३-४३", "content_sanskrit": "अयं व्याघ्रसमीपे तु पुराणो धर्मसंहितः।\nऋक्षेण गीतः श्लोकोऽस्ति तं निबोध प्लवंगम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000520044, "chapter_id": 9520, "verse_number": "६-११३-४४", "content_sanskrit": "न परः पापमादत्ते परेषां पापकर्मणाम्।\nसमयो रक्षितव्यस्तु सन्तश्चारित्रभूषणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000520045, "chapter_id": 9520, "verse_number": "६-११३-४५", "content_sanskrit": "पापानां वा शुभानां वा वधार्हाणामथापि वा।\nकार्यं कारुण्यमार्येण न कश्चिन्नापराध्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000520046, "chapter_id": 9520, "verse_number": "६-११३-४६", "content_sanskrit": "लोकहिंसाविहाराणां क्रूराणां पापकर्मणाम्।\nकुर्वतामपि पापानि नैव कार्यमशोभनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000520047, "chapter_id": 9520, "verse_number": "६-११३-४७", "content_sanskrit": "एवमुक्तस्तु हनुमान् सीतया वाक्यकोविदः।\nप्रत्युवाच ततः सीतां रामपत्नीमनिन्दिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000520048, "chapter_id": 9520, "verse_number": "६-११३-४८", "content_sanskrit": "युक्ता रामस्य भवती धर्मपत्नी गुणान्विता।\nप्रतिसंदिश मां देवि गमिष्ये यत्र राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000520049, "chapter_id": 9520, "verse_number": "६-११३-४९", "content_sanskrit": "एवमुक्ता हनुमता वैदेही जनकात्मजा।\nसाब्रवीद् द्रष्टुमिच्छामि भर्तारं भक्तवत्सलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000520050, "chapter_id": 9520, "verse_number": "६-११३-५०", "content_sanskrit": "तस्यास्तद् वचनं श्रुत्वा हनूमान् मारुतात्मजः।\nहर्षयन् मैथिलीं वाक्यमुवाचेदं महामतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000520051, "chapter_id": 9520, "verse_number": "६-११३-५१", "content_sanskrit": "पूर्णचन्द्रमुखं रामं द्रक्ष्यस्यद्य सलक्ष्मणम्।\nस्थितमित्रं हतामित्रं शचीवेन्द्रं सुरेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000520052, "chapter_id": 9520, "verse_number": "६-११३-५२", "content_sanskrit": "तामेवमुक्त्वा भ्राजन्तीं सीतां साक्षादिव श्रियम्।\nआजगाम महातेजा हनूमान् यत्र राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000520053, "chapter_id": 9520, "verse_number": "६-११३-५३", "content_sanskrit": "सपदि हरिवरस्ततो हनूमान्\nप्रतिवचनं जनकेश्वरात्मजायाः।\nकथितमकथयद् यथाक्रमेण\nत्रिदशवरप्रतिमाय राघवाय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000520054, "chapter_id": 9520, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे त्रयोदशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]