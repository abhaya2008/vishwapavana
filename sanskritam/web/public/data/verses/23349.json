[{"id": 7003349000, "chapter_id": 23349, "verse_number": "२-४४-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nअथान्यत्संप्रवक्ष्यामि सर्वदानोत्तमोत्तमम् ।\nपूर्वोक्तदेशकाले च मंडपे च विधानतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003349001, "chapter_id": 23349, "verse_number": "२-४४-२", "content_sanskrit": "प्रणयात्कुंडमध्ये च स्थंडिले शिवसन्निधौ ।\nपूर्वं विष्णुं समासाद्य पद्मयोनिमतः परम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003349002, "chapter_id": 23349, "verse_number": "२-४४-३", "content_sanskrit": "मंत्राभ्यां विधिनोक्ताभ्यां प्रणवादिसमंत्रकम्  ।\nनारायणाय विद्महे वासुदेवाय धीमहि ।\nतन्नो विष्णुः प्रचोदयात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003349003, "chapter_id": 23349, "verse_number": "२-४४-४", "content_sanskrit": "ब्रह्मब्राह्मणवृद्धाय ब्रह्मणे विश्ववेधसे ।\nशिवाय हरये स्वाहा स्वधा वौषट्वषट् तथा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003349004, "chapter_id": 23349, "verse_number": "२-४४-५", "content_sanskrit": "पूजयित्वा विधानेन पश्चाद्धोमं समाचरेत् ।\nसर्वद्रव्यं हि होतव्यं द्वाभ्यां कुंडविधानतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003349005, "chapter_id": 23349, "verse_number": "२-४४-६", "content_sanskrit": "ऋत्विजौ द्वौ प्रकर्तव्यौ गुरुणा वेदपारगौ ।\nतानुद्दिश्य यथान्यायं विप्रेभ्यो दापयेद्धनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003349006, "chapter_id": 23349, "verse_number": "२-४४-७", "content_sanskrit": "शतमष्टोत्तरं तेभ्यः पृथक्पृथगनुत्तमम् ।\nवस्त्राभरणसंयुक्तं सर्वालंकारसंयुतम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003349007, "chapter_id": 23349, "verse_number": "२-४४-८", "content_sanskrit": "गुरुरेको हि वै श्रीमान् ब्रह्मा विष्णुर्महेश्वरः ।\nतेषां पृथक्पृथग्देयं भोजयेद्ब्राह्मणानपि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003349008, "chapter_id": 23349, "verse_number": "२-४४-९", "content_sanskrit": "शिवार्चना च कर्तव्या स्नपनादि यथाक्रमम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]