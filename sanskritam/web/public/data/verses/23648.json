[{"id": 7003648000, "chapter_id": 23648, "verse_number": "१-२-३५-१", "content_sanskrit": "नारद उवाच ।\nकुमारेण स्थापितोऽत्र कुमारेशस्ततः सुराः ।\nप्रणम्य गुहमूचुश्च प्रबद्धकरसंपुटाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003648001, "chapter_id": 23648, "verse_number": "१-२-३५-२", "content_sanskrit": "किंचिद्विज्ञापयष्यामो वयं त्वां श्रृणु तत्त्वतः ।\nपूर्वप्रसिद्ध आचारः प्रोच्यते जयिनामयम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003648002, "chapter_id": 23648, "verse_number": "१-२-३५-३", "content_sanskrit": "जयंति ये रणे शत्रूंस्तैः कार्यः स्तंभचिह्नकः ।\nतस्मात्तव जयोद्द्योतनिमित्तं स्तंममुत्तमम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003648003, "chapter_id": 23648, "verse_number": "१-२-३५-४", "content_sanskrit": "नक्षिपाम वयं यावत्त्मनुज्ञातुमर्हसि ।\nविश्वकर्मकृतं यच्च तृतीयं लिंगमुत्तमम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003648004, "chapter_id": 23648, "verse_number": "१-२-३५-५", "content_sanskrit": "तस्य स्तंभाग्रतसतं च संस्थापय शिवात्मज ।\nएवमुक्ते सुरैः स्कन्दस्ततेत्याह महामनाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003648005, "chapter_id": 23648, "verse_number": "१-२-३५-६", "content_sanskrit": "ततो हृष्टाः सुरगणाः शक्राद्याः स्तंभमुत्तमम् ।\nजांबूनदमयं शुभ्रं रणभूमौ विनिक्षिपुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003648006, "chapter_id": 23648, "verse_number": "१-२-३५-७", "content_sanskrit": "परितः स्थंडिलं दिक्षु सर्वरत्नमयं तु ते ।\nतत्र हृष्टाश्चाप्सरसो ननृतुर्दशधा शुभाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003648007, "chapter_id": 23648, "verse_number": "१-२-३५-८", "content_sanskrit": "मातरो मंगलान्यस्य जगुः स्कन्दस्य नंदिताः ।\nइंद्राद्या ननृतुस्तत्र स्वयं विष्णुश्च वादकः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003648008, "chapter_id": 23648, "verse_number": "१-२-३५-९", "content_sanskrit": "पेतुः खात्पुष्पवर्षाणि देववाद्यानि सस्वनुः ।\nएवं स्तंभं समारोप्य जयाख्यं विश्वनंदकः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003648009, "chapter_id": 23648, "verse_number": "१-२-३५-१०", "content_sanskrit": "स्तम्भेश्वरस्ततो देवः स्थापितस्त्र्यक्षसूनुना ।\nविरिंचिप्रमुखैर्देवैर्जातानन्दैः समं तदा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003648010, "chapter_id": 23648, "verse_number": "१-२-३५-११", "content_sanskrit": "हरिहरादित्युक्तैस्तैः सेन्द्रैर्मुनिगणैरपि ।\nतस्यैव पश्चिमे भागे शक्त्यग्रेण महात्मना ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003648011, "chapter_id": 23648, "verse_number": "१-२-३५-१२", "content_sanskrit": "गुहेन निर्मितः कूपो गंगा तत्र तलोद्भवा ।\nमाघस्य च चतुर्दश्यां कृष्णायां पितृतर्पणम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003648012, "chapter_id": 23648, "verse_number": "१-२-३५-१३", "content_sanskrit": "कूपे स्नानं नरः कृत्वा भक्त्या यः पांडुनंदन ।\nगयाश्राद्धेन यत्पुण्यं तत्फलं लभते स्फुटम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003648013, "chapter_id": 23648, "verse_number": "१-२-३५-१४", "content_sanskrit": "स्तंभेश्वरं ततो देवं गन्धपुष्पैः प्रपूजयेत् ।\nवाजपेयफलं प्राप्य मोदते रुद्रसद्मानि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003648014, "chapter_id": 23648, "verse_number": "१-२-३५-१५", "content_sanskrit": "पौर्णमास्याममावास्यां महीसागरसंगमे ।\nश्राद्धं कृत्वा च योऽभ्यर्च्चेंत्स्तंभेश्वरमकल्मषः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003648015, "chapter_id": 23648, "verse_number": "१-२-३५-१६", "content_sanskrit": "पितरस्तस्य तृप्यंति तृप्ता यच्छंति चाशिषः ।\nस भित्त्वा सर्वपापानि रुद्रलोके महीयते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003648016, "chapter_id": 23648, "verse_number": "१-२-३५-१७", "content_sanskrit": "इत्याह भगवान्रुद्रः स्कन्दस्य प्रीतये पुरा ।\nएवमेव चतुर्थं च स्थापितं लिंगमुत्तमम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003648017, "chapter_id": 23648, "verse_number": "१-२-३५-१८", "content_sanskrit": "प्रणेमुर्देवताः सर्वे साधुसाध्विति ते जगुः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]