[{"id": 2103877, "chapter_id": 3247, "verse_number": "१४-१०३-१", "content_sanskrit": "वैशम्पायन उवाच।\nवासुदेवेन दानेषु कथितेषु यथाक्रमम्।\nअवितृप्तश्च धर्मेषु केशवं पुनरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2103878, "chapter_id": 3247, "verse_number": "१४-१०३-२", "content_sanskrit": "देव धर्मामृतमिदं शृण्वतोपि परंतप।\nन विद्यते सुरश्रेष्ठ मम तृप्तिर्हि माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2103879, "chapter_id": 3247, "verse_number": "१४-१०३-३", "content_sanskrit": "अनडुत्संप्रदानस्य यत्फलं तु विधीयते।\nतत्फलं कथयस्वेह तव भक्तस्य मेऽच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2103880, "chapter_id": 3247, "verse_number": "१४-१०३-४", "content_sanskrit": "यानिचान्यानिदानानित्वया नोक्तानि कानिचित्॥\nतान्याचक्ष्व सुरश्रेष्ठ तेषां चानुक्रमात्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2103881, "chapter_id": 3247, "verse_number": "१४-१०३-५x", "content_sanskrit": "भगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2103882, "chapter_id": 3247, "verse_number": "१४-१०३-५", "content_sanskrit": "पवित्रत्वात्सुपुण्यत्वात्पावनत्वात्तथैव च।\nशृणु धर्मामृतं श्रेष्ठं दत्तस्यानडुहः फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2103883, "chapter_id": 3247, "verse_number": "१४-१०३-६", "content_sanskrit": "दशधेनुसमोऽनड्वानेकोपि कुरुपुङ्गव।\nमेदोमांसविपुष्टाङ्गो नीरोगः कोपवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2103884, "chapter_id": 3247, "verse_number": "१४-१०३-७", "content_sanskrit": "युवा भद्रः सुशीलश्च सर्वदोषविवर्जितः।\nधुरं धारयति क्षिप्रं दत्तो विप्राय पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2103885, "chapter_id": 3247, "verse_number": "१४-१०३-८", "content_sanskrit": "स तेन पुण्यदानेन वर्षकोटिं युधिष्ठिर।\nयथाकामं महादेजा गवां लोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2103886, "chapter_id": 3247, "verse_number": "१४-१०३-९", "content_sanskrit": "यश्च दद्यादनडुहौ द्वौ युक्तौ च धुरंधरौ।\nसुवृत्ताय दरिद्राय श्रोत्रियाय विशेषतः।\nतस्य यत्पुण्यमाख्यातं तच्छृणुष्व युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2103887, "chapter_id": 3247, "verse_number": "१४-१०३-१०", "content_sanskrit": "सहस्रगोप्रदानेन यत्प्रोक्तं फलमुत्तमम्॥\nतत्पुण्यफलमाप्नोति याति लोकान्स मामकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2103888, "chapter_id": 3247, "verse_number": "१४-१०३-११", "content_sanskrit": "यावन्ति चैव रोमाणि तयोरनुडुहोर्नृप।\nतावद्वर्षसहस्राणि मम लोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2103889, "chapter_id": 3247, "verse_number": "१४-१०३-१२", "content_sanskrit": "दरिद्रायैव दातव्यं न समृद्धाय पाण्डव।\nवर्षाणां हि तटाकेषु फलं नैव पयोधिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2103890, "chapter_id": 3247, "verse_number": "१४-१०३-१३", "content_sanskrit": "यस्तु दद्यादनडुहं दरिद्राय द्विजातये।\nस तेन पुण्यदानेन पुतात्मा कुरुपुङ्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2103891, "chapter_id": 3247, "verse_number": "१४-१०३-१४", "content_sanskrit": "विमानं दिव्यमारूढो दिव्यरूपी यथासुखम्।\nमम लोकेषु रमते यावदाभूतसंप्लुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2103892, "chapter_id": 3247, "verse_number": "१४-१०३-१५", "content_sanskrit": "गृहं दीपप्रभायुक्तं शय्यासनविभूषितम्।\nभाजनोपस्करैर्युक्तं धनधान्यैरलङ्कृतम्।\nदासीगोभूमिसंयुक्तमन्यूनं सर्वसाधनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2103893, "chapter_id": 3247, "verse_number": "१४-१०३-१६", "content_sanskrit": "ब्राह्मणाय दरिद्राय श्रोत्रियाय युधिष्ठिर।\nदद्यात्सदक्षिणं यस्तु तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2103894, "chapter_id": 3247, "verse_number": "१४-१०३-१७", "content_sanskrit": "देवाः पितृगणाश्चैव ह्यग्नयो ऋषयस्तथा।\nप्रयच्छन्ति प्रहृष्टा वै यानमादित्यसन्निभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2103895, "chapter_id": 3247, "verse_number": "१४-१०३-१८", "content_sanskrit": "तेन गच्छेच्छ्रिया युक्तो ब्रह्मलोकमनुत्तमम्।\nस्त्रीसहस्रावृते रम्ये भवने तत्र काञ्चने।\nमोदते ब्रह्मलोकस्थो यावदाभूतसप्लवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2103896, "chapter_id": 3247, "verse_number": "१४-१०३-१९", "content_sanskrit": "शय्यं प्रस्तरणोपेतां यः प्रयच्छति पाण्डव।\nअर्चयित्वा द्विजं भक्त्या वस्त्रमाल्यानुलेपनैः।\nभोजयित्वा विचित्रान्नं तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2103897, "chapter_id": 3247, "verse_number": "१४-१०३-२०", "content_sanskrit": "धेनुदानस्य यत्पुण्यं विधिदत्तस्य पाण्डव।\nतत्पुण्यं तमनुप्राप्य पितृलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2103898, "chapter_id": 3247, "verse_number": "१४-१०३-२१", "content_sanskrit": "शिल्पमध्ययनं वाऽपि विद्यां मन्त्रौषधानि च।\nयः प्रयच्छति विप्राय तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2103899, "chapter_id": 3247, "verse_number": "१४-१०३-२२", "content_sanskrit": "आहिताग्निसहस्रस्य पूजितस्यैव यत्फलम्।\nतत्पुण्यफलमाप्नोति यस्तु शय्यां प्रयच्चति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2103900, "chapter_id": 3247, "verse_number": "१४-१०३-२३", "content_sanskrit": "छन्दोभिः संप्रयुक्तेन विमानेन विराजता।\nसप्तर्षिलोकान्व्रजति पूज्यते ब्रह्मवादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2103901, "chapter_id": 3247, "verse_number": "१४-१०३-२४", "content_sanskrit": "चतुर्युगानि वै त्रिंशत्क्रीडित्वा तत्र देववत्।\nइह मानुष्यके लोके विप्रो भवति वेदवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2103902, "chapter_id": 3247, "verse_number": "१४-१०३-२५", "content_sanskrit": "विश्रामयति यो विप्रं श्रान्तमध्वनि कर्शितम्।\nकविनश्यति तदा पापं तस्य वर्षकृतं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2103903, "chapter_id": 3247, "verse_number": "१४-१०३-२६", "content_sanskrit": "अथ प्रक्षालयेत्पादौ तस्य तोयेन भक्तिमान्।\nदशवर्षकृतं पापं व्यपोहति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2103904, "chapter_id": 3247, "verse_number": "१४-१०३-२७", "content_sanskrit": "घृतेन वाऽथ तैलेन पादौ तस्य तु पूजयेत्।\nतद्द्वादसमारूढं पापमाशु व्यपोहति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2103905, "chapter_id": 3247, "verse_number": "१४-१०३-२८", "content_sanskrit": "धेनुकाञ्चनदत्तस्य यत्पुण्यं समुदाहृतम्।\nतत्पुण्यफलमाप्नोति यस्त्वेनं विप्रमर्चयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2103906, "chapter_id": 3247, "verse_number": "१४-१०३-२९", "content_sanskrit": "स्वागतेन तु यो विप्रं पूजयेदासनेन च।\nप्रत्युत्थानेन वा राजन्स देवानां प्रियो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2103907, "chapter_id": 3247, "verse_number": "१४-१०३-३०", "content_sanskrit": "स्वागतेनाग्नयो राजन्नासनेन शतक्रतुः।\nप्रत्युत्थानेन पितरः प्रीति यान्त्यतिथिप्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2103908, "chapter_id": 3247, "verse_number": "१४-१०३-३१", "content_sanskrit": "अग्निशक्रपितॄणां च तेषां प्रीत्या नराधिप।\nसंवत्सरकृतं पापं तस्य सद्यो विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2103909, "chapter_id": 3247, "verse_number": "१४-१०३-३२", "content_sanskrit": "यः प्रयच्छति विप्राय आसनं माल्यभूषितम्।\nस याति मणिचित्रेण रथेनेन्द्रनिकेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2103910, "chapter_id": 3247, "verse_number": "१४-१०३-३३", "content_sanskrit": "पुरन्दरासने तत्र दिव्यनारीविभूषितः।\nषष्टिं वर्षसहस्राणि क्रीडत्यप्सरसां गणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2103911, "chapter_id": 3247, "verse_number": "१४-१०३-३४", "content_sanskrit": "वाहनं यः प्रयच्छेत ब्राह्मणाय युधिष्ठिर।\nस याति रत्नचित्रेण वाहनेन सुरालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2103912, "chapter_id": 3247, "verse_number": "१४-१०३-३५", "content_sanskrit": "स तत्र कामं क्रीडित्वा सेव्यमानोप्सरोगणैः।\nइह राजा भवेद्राजन्नात्र कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2103913, "chapter_id": 3247, "verse_number": "१४-१०३-३६", "content_sanskrit": "पादपं पल्लवाकीर्णं पुष्पतिं फलितं तथा।\nगन्धमाल्यैरथाभ्यर्च्य वस्त्राभरणभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2103914, "chapter_id": 3247, "verse_number": "१४-१०३-३७", "content_sanskrit": "यः प्रयच्छति विप्राय श्रोत्रियाय सदक्षिणम्।\nभोजयित्वा यथाकामं तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2103915, "chapter_id": 3247, "verse_number": "१४-१०३-३८", "content_sanskrit": "जांबूनदविचित्रेण विमानेन विराजता।\nपुरन्दरपुरं याति जयशब्दरवैर्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2103916, "chapter_id": 3247, "verse_number": "१४-१०३-३९", "content_sanskrit": "ततः शक्रपुरे रम्ये तस्य कल्पकपादपः।\nददाति चेप्सितं सर्वं मनसा यद्यदिच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2103917, "chapter_id": 3247, "verse_number": "१४-१०३-४०", "content_sanskrit": "यावन्ति तस्य पत्राणि पुष्पाणि च फलानि च।\nतावद्वर्षसहस्राणि शक्रलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2103918, "chapter_id": 3247, "verse_number": "१४-१०३-४१", "content_sanskrit": "शक्रलोकावतीर्णश्च मानुष्यं लोकमागतः।\nरथाश्वगजसंपूर्णं पुरं राज्यं च वक्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2103919, "chapter_id": 3247, "verse_number": "१४-१०३-४२", "content_sanskrit": "स्थापयित्वा तु मद्भक्त्या यो मत्प्रतिकृति नरः।\nआलयं विधिवत्कृत्वा पूजाकर्म च कारयेत्।\nस्वयं वा पूजयेद्भक्त्या तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2103920, "chapter_id": 3247, "verse_number": "१४-१०३-४३", "content_sanskrit": "अश्वमेधसहस्रस्य यत्पुण्यं समुदाहृतम्।\nतत्फलं समवाप्नोति मत्सालोक्यं प्रपद्यते।\nन जाने निर्गमं तस्य मम लोकाद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2103921, "chapter_id": 3247, "verse_number": "१४-१०३-४४", "content_sanskrit": "देवालये विप्रगृहे गोवाटे चत्वरेऽपि वा।\nप्रज्वालयति यो दीपं तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2103922, "chapter_id": 3247, "verse_number": "१४-१०३-४५", "content_sanskrit": "आरुद्य काञ्चनं यानं द्योतयन्सर्वतो दिशम्।\nगच्छेदादित्यलोकं स सेव्यमानः सुरोत्तमैः॥छ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2103923, "chapter_id": 3247, "verse_number": "१४-१०३-४६", "content_sanskrit": "तत्र प्रकामं क्रीडित्वा वर्षकोटिं महातपाः।\nइह लोके भवेद्विप्रो वेदवेदाङ्गपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2103924, "chapter_id": 3247, "verse_number": "१४-१०३-४७", "content_sanskrit": "देवालयेषु वा राजन्ब्राह्मणावसथेषु वा।\nचत्वरे वा चतुष्के वा रात्रौ वा यदि वा दिवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2103925, "chapter_id": 3247, "verse_number": "१४-१०३-४८", "content_sanskrit": "नानागन्धर्ववाद्यानि धर्मश्रावणिकानि च।\nयस्तु कारयते भक्त्या मद्गतेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2103926, "chapter_id": 3247, "verse_number": "१४-१०३-४९", "content_sanskrit": "तस्य देवा नरश्रेष्ठ पितरश्चापि हर्षिताः।\nसुप्रीताः संप्रयच्चन्ति विमानं कामगं सुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2103927, "chapter_id": 3247, "verse_number": "१४-१०३-५०", "content_sanskrit": "स च तेन पिमानेन याति देवपुरं नरः।\nतत्र दिव्याप्सरोभिस्तु सेव्यमानः प्रमोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2103928, "chapter_id": 3247, "verse_number": "१४-१०३-५१", "content_sanskrit": "देवलोकावतीर्णस्तु सोस्मिँल्लोके नराधिप।\nवेदवेदाङ्गतत्वज्ञो भोगवान्ब्राह्मणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2103929, "chapter_id": 3247, "verse_number": "१४-१०३-५२", "content_sanskrit": "चत्वरे वा सभायां वा विस्तीर्णि वा सभाङ्गणे।\nकृत्वाऽग्निकुण्डं विपुलं स्थण्डिलं वा युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2103930, "chapter_id": 3247, "verse_number": "१४-१०३-५३", "content_sanskrit": "तत्राग्निं चतुरो मासाञ्ज्वालयेद्यस्तु भक्तिमाम्।\nसमाप्तेषु च मासेषु पौष्यादिषु ततो द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2103931, "chapter_id": 3247, "verse_number": "१४-१०३-५४", "content_sanskrit": "भोजयेत्पायसं मृष्टं मद्गतेनान्तरात्मना।\nदक्षिणां च यथाशक्ति ब्राह्म्णेभ्यो निवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2103932, "chapter_id": 3247, "verse_number": "१४-१०३-५५", "content_sanskrit": "एवमग्निं तु यः कुर्यान्नित्यमेवार्चयेत्तु माम्।\nतस्य पुण्यफलं यद्वै तन्निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2103933, "chapter_id": 3247, "verse_number": "१४-१०३-५६", "content_sanskrit": "तेनाहं शङ्करश्चैव पितरो ह्यग्नयस्तथा।\nयास्यामः परमां प्रीतिं नात्र कार्याविचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2103934, "chapter_id": 3247, "verse_number": "१४-१०३-५७", "content_sanskrit": "षष्टिं वर्षसहस्राणि षष्टिं वर्षशतानि च।\nसोस्मत्प्रीतिकरः श्रीमान्मम लोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2103935, "chapter_id": 3247, "verse_number": "१४-१०३-५८", "content_sanskrit": "मम लोकावतीर्णश्च अस्मिँल्लोके महायशाः।\nवेदवेदाङ्गविद्विप्रो जायते राजपूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2103936, "chapter_id": 3247, "verse_number": "१४-१०३-५९", "content_sanskrit": "यः करोति नरश्रेष्ठ भरणं ब्राह्मणस्य तु।\nश्रोत्रियस्याभिजातस्य दरिद्रस्य विशेषतः।\nतस्य पुण्यफलं यद्वै तन्निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2103937, "chapter_id": 3247, "verse_number": "१४-१०३-६०", "content_sanskrit": "गवां कोटिप्रदानेन यत्पुण्यं समुदाहृतम्।\nतत्सर्वफलमाप्नोति वर्षेणैकेन पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2103938, "chapter_id": 3247, "verse_number": "१४-१०३-६१", "content_sanskrit": "काञ्चनेन विचित्रेण विमानेनार्कशोभिना।\nस याति मामकं लोकं दिव्यस्त्रीगणसेवितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2103939, "chapter_id": 3247, "verse_number": "१४-१०३-६२", "content_sanskrit": "गीयमानो वरस्त्रीभिर्वर्षाणां कोटिविंशतिम्।\nक्रीडित्वा मामके तत्र सर्वदेवैरभिष्टुतः।\nमानुष्यमवतीर्णस्तु वेदविद्ब्राह्मणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2103940, "chapter_id": 3247, "verse_number": "१४-१०३-६३", "content_sanskrit": "करकां कर्णिकां वाऽपि महद्वा जलभाजनम्।\nयः प्रयच्छति विप्राय तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2103941, "chapter_id": 3247, "verse_number": "१४-१०३-६४", "content_sanskrit": "ब्रह्मकूर्चे तु यत्पीते फलं प्रोक्तं नरादिप।\nतत्पुण्यफलमाप्नोति जलभाजनदो नरः।\nसुतृप्तः सर्वसौगन्धः प्रहृष्टेन्द्रियमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2103942, "chapter_id": 3247, "verse_number": "१४-१०३-६५", "content_sanskrit": "हंससारसयुक्तेन विमानेन विराजता।\nस याति वारुणं लोकं दिव्यगन्धर्वसेवितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2103943, "chapter_id": 3247, "verse_number": "१४-१०३-६६", "content_sanskrit": "पानीयं यः प्रयच्छेद्वै जीवानां जीवनं परम्।\nग्रीष्मे च त्रिषु मासेषु तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2103944, "chapter_id": 3247, "verse_number": "१४-१०३-६७", "content_sanskrit": "कपिलाकोटिनानस्य यत्पुण्यं तु विधीयते।\nतत्पुण्यफलमाप्नोति पानीयं यः प्रयच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2103945, "chapter_id": 3247, "verse_number": "१४-१०३-६८", "content_sanskrit": "पूर्णचन्द्रप्रकासेन विमानेन विराजता।\nस गच्छेच्चन्द्रभवनं सेव्यमानोप्सरोगणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2103946, "chapter_id": 3247, "verse_number": "१४-१०३-६९", "content_sanskrit": "त्रिंशत्कोटियुगं तत्र दिव्यगन्धर्वसेवितः।\nक्रीडित्वा मानुषे लोके चतुर्वेदी द्विजो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2103947, "chapter_id": 3247, "verse_number": "१४-१०३-७०", "content_sanskrit": "शिरोभ्यङ्गप्रदानेन तेजस्वी प्रियदर्शनः।\nसुभगो रूपवाञ्शूरः पण्डितश्च भवेद्द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2103948, "chapter_id": 3247, "verse_number": "१४-१०३-७१", "content_sanskrit": "वस्त्रदायी तु तेजस्वी सर्वत्र प्रियदर्शनः।\nसुभगो भवति श्रीमान्स्त्रीणां नित्यं मनोरमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2103949, "chapter_id": 3247, "verse_number": "१४-१०३-७२", "content_sanskrit": "उपानहौ च च्छत्रं च यो ददाति नरोत्तमः।\nस याति रथमुख्येन काञ्चनेन विराजता।\nशक्रलोकं महातेजाः सेव्यमानोप्सरोगणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2103950, "chapter_id": 3247, "verse_number": "१४-१०३-७३", "content_sanskrit": "काष्ठपादुकदा यान्ति विमानैर्वृक्षनिर्मितैः।\nधर्मराजपुरं रम्यं सेव्यमानाः सुरोत्तमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2103951, "chapter_id": 3247, "verse_number": "१४-१०३-७४", "content_sanskrit": "दन्तकाष्ठप्रादनेन प्रियवाक्यो भवेन्नरः।\nसुगन्धवदनः श्रीमान्मेदासौभाग्यसंयुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2103952, "chapter_id": 3247, "verse_number": "१४-१०३-७५", "content_sanskrit": "क्षीरं दधि घृतं वाऽपि गुडं मधुरसं तथा।\nये प्रयच्छन्ति विप्रेभ्यः परां भक्तिमुपागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2103953, "chapter_id": 3247, "verse_number": "१४-१०३-७६", "content_sanskrit": "ते वृषैरश्वयानैश्च श्वेतस्रग्दामभूषिताः।\nउपगीयमाना गन्धर्वैर्यान्तीश्वरपुरं नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2103954, "chapter_id": 3247, "verse_number": "१४-१०३-७७", "content_sanskrit": "तत्र दिव्याप्सरोभिस्तु सेव्यमाना यथासुखम्।\nषष्टिवर्षसहस्राणि मोदन्ते देवसन्निभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2103955, "chapter_id": 3247, "verse_number": "१४-१०३-७८", "content_sanskrit": "ततः कालावतीर्णाश्च जायन्ते त्विह मानवाः॥\nप्रभूतधनधान्याश्च भोगवन्तो नरोत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2103956, "chapter_id": 3247, "verse_number": "१४-१०३-७९", "content_sanskrit": "वैशाखे मासि वैशाखे दिवसे पाण्डुनन्दन।\nवैवस्वतं समुद्दिश्य परां भक्तिमुपागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2103957, "chapter_id": 3247, "verse_number": "१४-१०३-८०", "content_sanskrit": "अभ्यर्च्य विधिवद्विप्रांस्तिलान्गुडसमन्वितान्।\nये प्रयच्छन्ति विप्रेभ्यस्तेषां पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2103958, "chapter_id": 3247, "verse_number": "१४-१०३-८१", "content_sanskrit": "गोप्रदानेन यत्पुण्यं विधिवत्पाण्डुनन्दन।\nतत्पुण्यं समनुप्राप्तो यमलोके महीयते।\nततश्चापि च्युतः कालादिह राजा भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2103959, "chapter_id": 3247, "verse_number": "१४-१०३-८२", "content_sanskrit": "तस्मिन्नेव दिने विप्रान्भोजयित्वा सुदक्षिणम्।\nतोयपूर्णानि दिव्यानि भाजनानि दिशन्ति ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2103960, "chapter_id": 3247, "verse_number": "१४-१०३-८३", "content_sanskrit": "ते यान्त्यादित्यवर्णाभैर्विमानैर्वरुणालयम्।\nतत्र दिव्याङ्गनाभिस्तु रमन्ते कामकामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2103961, "chapter_id": 3247, "verse_number": "१४-१०३-८४", "content_sanskrit": "ततोऽवतीर्णाः कालेन ते चास्मिन्मानुषे पुनः।\nभोगवन्तो द्विजश्रेष्ठ भविष्यन्ति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2103962, "chapter_id": 3247, "verse_number": "१४-१०३-८५", "content_sanskrit": "अनन्तराशी यश्चापि वर्तते व्रतवत्सदा।\nसत्यवाक्क्रोधरहितः शुचिः स्नानरतः सदा।\nस विमानेन दिव्येन याति शक्रपुरं नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2103963, "chapter_id": 3247, "verse_number": "१४-१०३-८६", "content_sanskrit": "तत्र दिव्याप्सरोभिस्तु वर्षकोटिं महातपाः।\nक्रीडित्वा मानुषे लोके जायते वेदविद्द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2103964, "chapter_id": 3247, "verse_number": "१४-१०३-८७", "content_sanskrit": "एकभुक्तेन यश्चापि वर्षमेकं तु वर्तते।\nब्रह्मचारी जितक्रोधः सत्यशौचसमन्वितः।\nस विमानेन दिव्येन याति शक्रपुरं नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2103965, "chapter_id": 3247, "verse_number": "१४-१०३-८८", "content_sanskrit": "दशकोटिसहस्राणि क्रीडित्वाऽप्सरसां गणैः।\nइह मानुष्यके लोके वेदविद्ब्राह्मणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2103966, "chapter_id": 3247, "verse_number": "१४-१०३-८९", "content_sanskrit": "चतुर्थकाले यो भुङ्क्ते ब्रह्मचारी जितेन्द्रियः।\nवर्तते चैकवर्षं तु तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2103967, "chapter_id": 3247, "verse_number": "१४-१०३-९०", "content_sanskrit": "चित्रबर्हिणयुक्तेन विचित्रध्वजशोभिना।\nयाति यानेन दिव्येन स महेन्द्रपुरं नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2103968, "chapter_id": 3247, "verse_number": "१४-१०३-९१", "content_sanskrit": "अकृशाभिर्वरस्त्रीभिः सेव्यमानो यथासुखम्।\nततो द्वादशकोटिं स समाः सम्यक्प्रमोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2103969, "chapter_id": 3247, "verse_number": "१४-१०३-९२", "content_sanskrit": "शक्रलोकावतीर्णस्तु लोके चास्मिन्नराधिप।\nभवेद्वै ब्राह्मणो विद्वान्क्षमावान्वेदपारगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2103970, "chapter_id": 3247, "verse_number": "१४-१०३-९३", "content_sanskrit": "षष्ठकाले तु योऽश्नाति वर्षमेकमकल्मषः।\nब्रह्मचर्यव्रतैर्युक्तः शुचि क्रोधविवर्जितः।\nतपोयुक्तस्य तस्याथ शृणुष्व फलमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2103971, "chapter_id": 3247, "verse_number": "१४-१०३-९४", "content_sanskrit": "अत्यादित्यप्रकाशेन विमानेनार्कसंनिभः।\nस याति मम लोकान्वै दिव्यनारीनिषेवितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2103972, "chapter_id": 3247, "verse_number": "१४-१०३-९५", "content_sanskrit": "तत्र साध्यैर्मरुद्भिस्तु पूज्यमानो यथासुखम्।\nपश्यन्नेव सदा मां तु क्रीडत्यप्सरसां गणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2103973, "chapter_id": 3247, "verse_number": "१४-१०३-९६", "content_sanskrit": "पक्षोपवासं यश्चापि कुरुते मद्गतात्मना।\nसमाप्ते तु व्रते तस्मिंस्तर्पयेच्छ्रोत्रियान्द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2103974, "chapter_id": 3247, "verse_number": "१४-१०३-९७", "content_sanskrit": "सोपि गच्छति दिव्येन विमानेन महातपाः।\nद्योतयनप्रभया व्योम मम लोकं प्रपद्यते।\nस तत्र मोदते कामं कामरूपी यथासुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2103975, "chapter_id": 3247, "verse_number": "१४-१०३-९८", "content_sanskrit": "त्रिंशत्कोटिसमा राजन्क्रीडित्वा तत्र देववत्।\nइह मानुष्यके लोके पूजनीयो द्विजो भवेत्।\nत्रयाणामपि वेदानां साङ्गानां पारगे भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2103976, "chapter_id": 3247, "verse_number": "१४-१०३-९९", "content_sanskrit": "यश्च मासोपवासं वै कुरुते मद्गतात्मना।\nजितेन्द्रियो जितक्रोधोजितधीः स्नानतत्परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2103977, "chapter_id": 3247, "verse_number": "१४-१०३-१००", "content_sanskrit": "समाप्ते नियमे तत्र भोजयित्वा द्विजोत्तमान्।\nदक्षिणां च ततो दद्यात्प्रहृष्टेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2103978, "chapter_id": 3247, "verse_number": "१४-१०३-१०१", "content_sanskrit": "स गच्छति महातेजा ब्रह्मलोकमनु****म्।\nसिंहयुक्तेन यानेन दिव्यस्त्रीगणसेवितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2103979, "chapter_id": 3247, "verse_number": "१४-१०३-१०२", "content_sanskrit": "स तत्र ब्रह्मणो लोके दिव्यर्षिगणसेवितः।\nशतकोटिसमा राजन्यथाकामं प्रमोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2103980, "chapter_id": 3247, "verse_number": "१४-१०३-१०३", "content_sanskrit": "ततः कालावतीर्णश्च सोस्मिँल्लोके द्विजो भवेत्।\nषडङ्गविच्चतुर्वेदी त्रिंशज्जन्मान्यरोगवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2103981, "chapter_id": 3247, "verse_number": "१४-१०३-१०४", "content_sanskrit": "यस्त्यक्त्वा सर्वकर्माणि शुचिः क्रोधविवर्जितः।\nमहाप्रस्तानमेकाग्नो याति मद्गतमानसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2103982, "chapter_id": 3247, "verse_number": "१४-१०३-१०५", "content_sanskrit": "स गच्छेदिन्द्रसदनं विमानेन महातपाः।\nमहामणिविचित्रेण सौवर्णन विराजता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2103983, "chapter_id": 3247, "verse_number": "१४-१०३-१०६", "content_sanskrit": "शतकोटिसमास्तत्र सुराधिपतिपूजितः।\nनाकपृष्ठे निवसति दिव्यस्त्रीगणसेवितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2103984, "chapter_id": 3247, "verse_number": "१४-१०३-१०७", "content_sanskrit": "शक्रलोकावतीर्णश्च मानुषेषूपजायते।\nराज्ञां राजा महातेजाः सर्वलोकार्चितः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2103985, "chapter_id": 3247, "verse_number": "१४-१०३-१०८", "content_sanskrit": "प्रायोपवेशं यश्चापि कुरुते मद्गतात्मना।\nनमो ब्रह्मण्यदेवायेत्युक्त्वा मन्त्रं समाहितः।\nअन्तःस्वस्थो जितक्रोधस्तस्य पुण्यफलं शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2103986, "chapter_id": 3247, "verse_number": "१४-१०३-१०९", "content_sanskrit": "कामगः कामरूपी च बालसूर्यसमप्रभः।\nस विमानेन दिव्येन याति लोकाननामयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2103987, "chapter_id": 3247, "verse_number": "१४-१०३-११०", "content_sanskrit": "स्वर्गत्स्वर्गं महातेजा गत्वा चैव यथासुखम्।\nमम लोकेषु रमते यावदाभूतसंप्लवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2103988, "chapter_id": 3247, "verse_number": "१४-१०३-१११", "content_sanskrit": "अग्निप्रवेशं यश्चापि कुरुते मद्गतात्मना।\nसोपि यानेन दिव्येन मम लोकं प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2103989, "chapter_id": 3247, "verse_number": "१४-१०३-११२", "content_sanskrit": "तत्र सर्वगुणोपेतः पश्यन्नेव स मां सदा।\nत्रिंशत्कोटिसमा राजन्मोदते मम संनिधौ।\nततोऽवतीर्णः कालेन वेदविद्ब्राह्मणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2103990, "chapter_id": 3247, "verse_number": "१४-१०३-११३", "content_sanskrit": "कर्षणं साधयन्यस्तु मां प्रपन्नः शुचिव्रतः।\nनमो ब्रह्मण्यदेवायेत्येतन्मन्त्रमुदाहरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2103991, "chapter_id": 3247, "verse_number": "१४-१०३-११४", "content_sanskrit": "बालसूर्यप्रकाशेन विमानेन विराजता।\nमम लोकं समासाद्य वर्षकोटिं प्रमोदते।\nमम लोकावतीर्णश्च सोस्मिँल्लोके नृपो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2103992, "chapter_id": 3247, "verse_number": "१४-१०३-११५", "content_sanskrit": "निवेशयति मन्मूर्त्यामात्मानं मद्गतः शुचिः।\nरुद्रदक्षिणमूर्त्यां वा चतुर्दश्यां विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2103993, "chapter_id": 3247, "verse_number": "१४-१०३-११६", "content_sanskrit": "सिद्धैर्ब्रह्मर्षिभिश्चैव देवलोकैश्च पूजितः।\nगन्धर्वैर्भूतसङ्घैश्च गीयमानो महातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2103994, "chapter_id": 3247, "verse_number": "१४-१०३-११७", "content_sanskrit": "प्रविशेत्स महातेजा मां वा शङ्करमेव वा।\nन स्यात्पुनर्भवो राजन्नात्र कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2103995, "chapter_id": 3247, "verse_number": "१४-१०३-११८", "content_sanskrit": "गोकृते स्त्रीकृते चैव गुरुविप्रकृतेऽपि वा।\nहन्यन्ते ये तु राजेन्द्र शक्रलोकं व्रजन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2103996, "chapter_id": 3247, "verse_number": "१४-१०३-११९", "content_sanskrit": "तत्र जांबूनदमये विमाने कामगामिनि।\nमन्वन्तरं प्रमोदन्ते दिव्यनारीनिषेविताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2103997, "chapter_id": 3247, "verse_number": "१४-१०३-१२०", "content_sanskrit": "आश्रुतस्याप्रादनेन दत्तस्य हरणेन च।\nजन्मप्रभृति यद्दत्तं तत्सर्वं तु विनश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2103998, "chapter_id": 3247, "verse_number": "१४-१०३-१२१", "content_sanskrit": "नाऽगोप्रदास्तत्र पयः पिबन्ति\nनाभूमिदा भूमिमथाश्नुवन्ति।\nयान्यान्कामान्ब्राह्मणेभ्यो ददाति\nतांस्तान्कामान्स्वर्गलोके च भुङ्क्ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2103999, "chapter_id": 3247, "verse_number": "१४-१०३-१२२", "content_sanskrit": "यद्यदिष्टतमं द्रव्यं न्यायनोपार्जितं च यत्।\nतत्तद्गुणवते देयं तदेवाक्षयमिच्छता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2104000, "chapter_id": 3247, "verse_number": "१४-१०३-१२३", "content_sanskrit": "अनुपोष्य त्रिरात्राणि तीर्थान्यनभिगम्य च।\nअदत्त्वा काञ्चनं गां दरिद्रो नाम जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2104001, "chapter_id": 3247, "verse_number": "१४-१०३-१२४", "content_sanskrit": "दानं यत्तत्फलं नैव श्रोत्रियाय न दीयते।\nश्रोत्रिया यत्र नाश्नन्ति न देवास्तत्र भुञ्जते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2104002, "chapter_id": 3247, "verse_number": "१४-१०३-१२५", "content_sanskrit": "श्रोत्रियेभ्यः परं नास्ति परमं दैवतं महत्।\nनिधानं चापि राजेन्द्र नास्माच्छ्रोत्रियभोजनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2104003, "chapter_id": 3247, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि वैष्णवधर्मपर्वणि त्र्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}]