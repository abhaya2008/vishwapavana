[{"id": 40018422, "chapter_id": 9285, "verse_number": "1", "content_sanskrit": "तथातैःकृत्तगात्रैस्तुदशग्रीवेणमार्गणैः । बभूववसुधातत्रप्रकीर्णाहरिभिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018423, "chapter_id": 9285, "verse_number": "2", "content_sanskrit": "रावणस्याप्रसह्यंतंशरसम्पातमेकतः । न शेकुस्सहितुंदीप्तंपतङ्गाज्वलनंयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018424, "chapter_id": 9285, "verse_number": "3", "content_sanskrit": "तेऽर्दितानिशितैर्बाणैःक्रोशन्तोविप्रदुद्रुवुः । पावकार्चिस्समाविष्टादह्यमानायथागजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018425, "chapter_id": 9285, "verse_number": "4", "content_sanskrit": "प्लवङ्गनामनीकानिमहाभ्राणीवमारुतः । सययौसमरेतस्मिन्विधमन्रावणश्शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018426, "chapter_id": 9285, "verse_number": "5", "content_sanskrit": "कदनंतरसाकृत्वाराक्षसेन्ध्रोवनौकसाम् । आससादततोत्वरितंयुद्धेराघवंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018427, "chapter_id": 9285, "verse_number": "6", "content_sanskrit": "सुग्रीवस्तान्कपीन्दृष्टवाभग्नान्विद्रावितान्रणे । गुल्मेसुषेणंनिक्षिप्यचक्रेयुद्धेऽद्भुतंमनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018428, "chapter_id": 9285, "verse_number": "7", "content_sanskrit": "आत्मनस्सदृशंवीरस्सतंनिक्षिप्यवानरम् । सुग्रीवोऽऽभिमुखश्शत्रुंप्रतस्थेपादपायुधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018429, "chapter_id": 9285, "verse_number": "8", "content_sanskrit": "पार्श्वतःपृष्ठतश्चास्यसर्वेयूथाधिपास्स्वयम् । अनुजह्रुर्महाशैलान् विविधांश्चमहाद्रुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018430, "chapter_id": 9285, "verse_number": "9", "content_sanskrit": "सनदन्युधिसुग्रीवस्स्वरेणमहतामहान् । पातयन्विविधांश्चान्यान्ञ्जगामोत्तमराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018431, "chapter_id": 9285, "verse_number": "10", "content_sanskrit": "ममन्थ च महाकायान्राक्षसान्वानरेश्वरः । युगान्तसमयेवायुःप्रवृद्धानगमानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018432, "chapter_id": 9285, "verse_number": "11", "content_sanskrit": "राक्षसानामनीकेषुशैलवर्षंववर्ष ह । अश्मवर्षंयथामेघःपक्षिसङ्घेषुकानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018433, "chapter_id": 9285, "verse_number": "12", "content_sanskrit": "कपिराजविमुक्तैस्तैश्शैलवर्षैस्तुराक्षसाः । विकीर्णशिरसःपेतुर्निकृत्ताइवपर्वताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018434, "chapter_id": 9285, "verse_number": "13", "content_sanskrit": "अथसंक्षीयमाणेषुराक्षसेषुसमन्ततः । सुग्रीवेणप्रभग्नेषुपतत्सुनिनदत्सु च ॥ विरूपाक्षस्स्वकंनामधन्वीविश्राव्यराक्षसः । रथादाप्लुत्यदुर्धर्षोगजस्कन्धमुपारुहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018435, "chapter_id": 9285, "verse_number": "14", "content_sanskrit": "अथसंक्षीयमाणेषुराक्षसेषुसमन्ततः । सुग्रीवेणप्रभग्नेषुपतत्सुनिनदत्सु च ॥ विरूपाक्षस्स्वकंनामधन्वीविश्राव्यराक्षसः । रथादाप्लुत्यदुर्धर्षोगजस्कन्धमुपारुहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018436, "chapter_id": 9285, "verse_number": "15", "content_sanskrit": "स तंद्विरदमारुह्यविरूपाक्षोमहारथः । वनर्दभनीमनिर्ह्रादंवानरानभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018437, "chapter_id": 9285, "verse_number": "16", "content_sanskrit": "सुग्रीवे स शरान्घोरान्विससर्जचमूमुखे । स्थापयामासचोद्विग्नान्राक्षसान् सम्प्रहर्षयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018438, "chapter_id": 9285, "verse_number": "17", "content_sanskrit": "सतुविद्धश्शितैर्बाणैःकपीन्द्रस्तेनरक्षसा । चुक्रोध स महाक्रोधोवधेचास्यमनोदधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018439, "chapter_id": 9285, "verse_number": "18", "content_sanskrit": "ततःपादपमुद्धृत्यशूरस्सम्प्रधनोहरिः । अभिपत्यजघानास्यप्रमुखेतुमहागजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018440, "chapter_id": 9285, "verse_number": "19", "content_sanskrit": "स तुप्रहाराभिहतस्सुग्रीवेणमहागजः । अपासर्पद्धनुर्मात्रंनिषसादननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018441, "chapter_id": 9285, "verse_number": "20", "content_sanskrit": "गजात्तुमथितात्तूर्णमपक्रम्य स वीर्यवान् । राक्षसोऽऽभिमुखश्शत्रुंप्रत्युद्गम्यततःकपिम् ॥ आर्षभंचर्मखडगं च प्रगृह्यलघुविक्रमः । भर्त्सयन्निवसुग्रीवमाससादव्यवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018442, "chapter_id": 9285, "verse_number": "21", "content_sanskrit": "गजात्तुमथितात्तूर्णमपक्रम्य स वीर्यवान् । राक्षसोऽऽभिमुखश्शत्रुंप्रत्युद्गम्यततःकपिम् ॥ आर्षभंचर्मखडगं च प्रगृह्यलघुविक्रमः । भर्त्सयन्निवसुग्रीवमाससादव्यवस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018443, "chapter_id": 9285, "verse_number": "22", "content_sanskrit": "स हितस्याभिसङ्कृद्धःप्रगृह्यविपुलांशिलाम् । विरूपाक्षायचिक्षेपसुग्रीवोजलदोपमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018444, "chapter_id": 9285, "verse_number": "23", "content_sanskrit": "स तांशिलामापतन्तींदृष्टवाराक्षसपुङ्गवः । अपक्रम्यसुविक्रान्तःखडगेनप्राहरत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018445, "chapter_id": 9285, "verse_number": "24", "content_sanskrit": "तेनखडगप्रहारेणरक्षसाबलिनाहतः । मुहूर्तमभवद्वीरोविसंज्ञइववानरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018446, "chapter_id": 9285, "verse_number": "25", "content_sanskrit": "स तदा स हसोत्पत्यराक्षसस्यमहाहवे । मुष्टिंसन्वर्त्यवेगेनपातयामासवक्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40018447, "chapter_id": 9285, "verse_number": "26", "content_sanskrit": "मुष्टिप्रहाराभिहतोविरूपाक्षोनिशाचरः । तेनखडगेनसङ्कृद्दस्सुग्रीवस्यचमूमुखे ॥ कवचंपातयामासपद्भ्यामभिहतोऽऽपतत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40018448, "chapter_id": 9285, "verse_number": "27", "content_sanskrit": "स समुत्थायपतितःकपिस्तस्यव्यसर्जयत् । तलप्रहारमशनेस्समानंभीमनिस्स्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40018449, "chapter_id": 9285, "verse_number": "28", "content_sanskrit": "तलप्रहारंतद्रक्षस्सुग्रीवेणसमुद्यतम् । नैपुण्यान्मोचयित्वैनंमुष्टिनोरस्यताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40018450, "chapter_id": 9285, "verse_number": "29", "content_sanskrit": "तस्सुसङ्कृद्धतरःसुग्रीवोवानरेश्वरः ॥ मोक्षितंचात्मनोदृष्टवाप्रहारंतेनरक्षसा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40018451, "chapter_id": 9285, "verse_number": "30", "content_sanskrit": "ददर्शान्तरंतस्यविरूपाक्षस्यवानरः ॥ ततोन्यपातयत्क्रोधाच्छङ्खदेशेमहात्तलम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40018452, "chapter_id": 9285, "verse_number": "31", "content_sanskrit": "महेन्द्राशनिकल्पेनतलेनाभिहतःक्षितौ ॥ पपातरुधिरक्लिन्नश्शोणितंसमुद्यमन् । स्रोतोभ्यस्तुविरूपाक्षोजलंप्रस्रवणादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40018453, "chapter_id": 9285, "verse_number": "32", "content_sanskrit": "महेन्द्राशनिकल्पेनतलेनाभिहतःक्षितौ ॥ पपातरुधिरक्लिन्नश्शोणितंसमुद्यमन् । स्रोतोभ्यस्तुविरूपाक्षोजलंप्रस्रवणादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40018454, "chapter_id": 9285, "verse_number": "33", "content_sanskrit": "विवृत्तनयनंक्रोधात्सफेनंरुधिराप्लुतम् । ददृशुस्तेविरूपाक्षंविरूपाक्षतरंकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40018455, "chapter_id": 9285, "verse_number": "34", "content_sanskrit": "स्फुरन्तंपरिवर्तन्तंपार्श्वेनरुधिरोक्षितम् । करुणं च विनर्दन्तंददृशुःकपयोरिपुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40018456, "chapter_id": 9285, "verse_number": "35", "content_sanskrit": "तथातुतौसंम्यतिसम्प्रयुक्तौ । तरस्विनौवानरराक्षसानाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]