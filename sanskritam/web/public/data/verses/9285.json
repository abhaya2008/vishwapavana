[{"id": 5000285000, "chapter_id": 9285, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे त्रयोदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000285001, "chapter_id": 9285, "verse_number": "४-१३-१", "content_sanskrit": "ऋष्यमूकात् स धर्मात्मा किष्किन्धां लक्ष्मणाग्रजः।\nजगाम सह सुग्रीवो वालिविक्रमपालिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000285002, "chapter_id": 9285, "verse_number": "४-१३-२", "content_sanskrit": "समुद्यम्य महच्चापं रामः काञ्चनभूषितम्।\nशरांश्चादित्यसंकाशान् गृहीत्वा रणसाधकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000285003, "chapter_id": 9285, "verse_number": "४-१३-३", "content_sanskrit": "अग्रतस्तु ययौ तस्य राघवस्य महात्मनः।\nसुग्रीवः संहतग्रीवो लक्ष्मणश्च महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000285004, "chapter_id": 9285, "verse_number": "४-१३-४", "content_sanskrit": "पृष्ठतो हनुमान् वीरो नलो नीलश्च वीर्यवान्।\nतारश्चैव महातेजा हरियूथपयूथपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000285005, "chapter_id": 9285, "verse_number": "४-१३-५", "content_sanskrit": "ते वीक्षमाणा वृक्षांश्च पुष्पभारावलम्बिनः।\nप्रसन्नाम्बुवहाश्चैव सरितः सागरंगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000285006, "chapter_id": 9285, "verse_number": "४-१३-६", "content_sanskrit": "कन्दराणि च शैलांश्च निर्दराणि गुहास्तथा।\nशिखराणि च मुख्यानि दरीश्च प्रियदर्शनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000285007, "chapter_id": 9285, "verse_number": "४-१३-७", "content_sanskrit": "वैदूर्यविमलैस्तोयैः पद्मैश्चाकोशकुड्मलैः।\nशोभितान् सजलान् मार्गे तटाकांश्चावलोकयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000285008, "chapter_id": 9285, "verse_number": "४-१३-८", "content_sanskrit": "कारण्डैः सारसैर्हंसैर्वञ्जुलैर्जलकुक्कुटैः।\nचक्रवाकैस्तथा चान्यैः शकुनैः प्रतिनादितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000285009, "chapter_id": 9285, "verse_number": "४-१३-९", "content_sanskrit": "मृदुशष्पाङ्कुराहारान्निर्भयान् वनगोचरान्।\nचरतः सर्वतः पश्यन् स्थलीषु हरिणान् स्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000285010, "chapter_id": 9285, "verse_number": "४-१३-१०", "content_sanskrit": "तटाकवैरिणश्चापि शुक्लदन्तविभूषितान्।\nघोरानेकचरान् वन्यान् द्विरदान् कूलघातिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000285011, "chapter_id": 9285, "verse_number": "४-१३-११", "content_sanskrit": "मत्तान् गिरितटोत्कृष्टान् पर्वतानिव जङ्गमान्।\nवानरान् द्विरदप्रख्यान् महीरेणुसमुक्षितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000285012, "chapter_id": 9285, "verse_number": "४-१३-१२", "content_sanskrit": "वने वनचरांश्चान्यान् खेचरांश्च विहंगमान्।\nपश्यन्तस्त्वरिता जग्मुः सुग्रीववशवर्तिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000285013, "chapter_id": 9285, "verse_number": "४-१३-१३", "content_sanskrit": "तेषां तु गच्छतां तत्र त्वरितं रघुनन्दनः।\nद्रुमषण्डवनं दृष्ट्वा रामः सुग्रीवमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000285014, "chapter_id": 9285, "verse_number": "४-१३-१४", "content_sanskrit": "एष मेघ इवाकाशे वृक्षषण्डः प्रकाशते।\nमेघसंघातविपुलः पर्यन्तकदलीवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000285015, "chapter_id": 9285, "verse_number": "४-१३-१५", "content_sanskrit": "किमेतज्ज्ञातुमिच्छामि सखे कौतूहलं मम।\nकौतूहलापनयनं कर्तुमिच्छाम्यहं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000285016, "chapter_id": 9285, "verse_number": "४-१३-१६", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा राघवस्य महात्मनः।\nगच्छन् नेवाचचक्षेऽथ सुग्रीवस्तन्महद् वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000285017, "chapter_id": 9285, "verse_number": "४-१३-१७", "content_sanskrit": "एतद् राघव विस्तीर्णमाश्रमं श्रमनाशनम्।\nउद्यानवनसम्पन्नं स्वादुमूलफलोदकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000285018, "chapter_id": 9285, "verse_number": "४-१३-१८", "content_sanskrit": "अत्र सप्तजना नाम मुनयः संशितव्रताः।\nसप्तैवासन्नधःशीर्षा नियतं जलशायिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000285019, "chapter_id": 9285, "verse_number": "४-१३-१९", "content_sanskrit": "सप्तरात्रे कृताहारा वायुनाचलवासिनः।\nदिवं वर्षशतैर्याताः सप्तभिः सकलेवराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000285020, "chapter_id": 9285, "verse_number": "४-१३-२०", "content_sanskrit": "तेषामेतत्प्रभावेण द्रुमप्राकारसंवृतम्।\nआश्रमं सुदुराधर्षमपि सेन्द्रैः सुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000285021, "chapter_id": 9285, "verse_number": "४-१३-२१", "content_sanskrit": "पक्षिणो वर्जयन्त्येतत् तथान्ये वनचारिणः।\nविशन्ति मोहाद् येऽप्यत्र न निवर्तन्ति ते पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000285022, "chapter_id": 9285, "verse_number": "४-१३-२२", "content_sanskrit": "विभूषणरवाश्चात्र श्रूयन्ते सकलाक्षराः।\nतूर्यगीतस्वनश्चापि गन्धो दिव्यश्च राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000285023, "chapter_id": 9285, "verse_number": "४-१३-२३", "content_sanskrit": "त्रेताग्नयोऽपि दीप्यन्ते धूमो ह्येष प्रदृश्यते।\nवेष्टयन्निव वृक्षाग्रान् कपोताङ्गारुणो घनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000285024, "chapter_id": 9285, "verse_number": "४-१३-२४", "content_sanskrit": "एते वृक्षाः प्रकाशन्ते धूमसंसक्तमस्तकाः।\nमेघजालप्रतिच्छन्ना वैडूर्यगिरयो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000285025, "chapter_id": 9285, "verse_number": "४-१३-२५", "content_sanskrit": "कुरु प्रणामं धर्मात्मंस्तेषामुद्दिश्य राघव।\nलक्ष्मणेन सह भ्रात्रा प्रयतः संहताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000285026, "chapter_id": 9285, "verse_number": "४-१३-२६", "content_sanskrit": "प्रणमन्ति हि ये तेषामृषीणां भावितात्मनाम्।\nन तेषामशुभं किंचिच्छरीरे राम विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000285027, "chapter_id": 9285, "verse_number": "४-१३-२७", "content_sanskrit": "ततो रामः सह भ्रात्रा लक्ष्मणेन कृताञ्जलिः।\nसमुद्दिश्य महात्मानस्तानृषीनभ्यवादयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000285028, "chapter_id": 9285, "verse_number": "४-१३-२८", "content_sanskrit": "अभिवाद्य च धर्मात्मा रामो भ्राता च लक्ष्मणः।\nसुग्रीवो वानराश्चैव जम्मुः संहृष्टमानसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000285029, "chapter_id": 9285, "verse_number": "४-१३-२९", "content_sanskrit": "ते गत्वा दूरमध्वानं तस्मात् सप्तजनाश्रमात्।\nददृशुस्तां दुराधर्षां किष्किन्धां वालिपालिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000285030, "chapter_id": 9285, "verse_number": "४-१३-३०", "content_sanskrit": "ततस्तु रामानुजरामवानराः\nप्रगृह्य शस्त्राण्युदितोग्रतेजसः।\nपुरीं सुरेशात्मजवीर्यपालितां\nवधाय शत्रोः पुनरागतास्त्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000285031, "chapter_id": 9285, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे त्रयोदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]