[{"id": 2185987, "chapter_id": 4948, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2185988, "chapter_id": 4948, "verse_number": "१", "content_sanskrit": "गिरं तां मधुरां श्रुत्वा गौतमो विस्मितस्तदा ।\nकौतूहलान्वितो राजन् राजधर्माणमैक्षत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2185989, "chapter_id": 4948, "verse_number": "", "content_sanskrit": "राजधर्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2185990, "chapter_id": 4948, "verse_number": "२", "content_sanskrit": "भोः कश्यपस्य पुत्रोऽहं माता दाक्षायणी च मे ।\nअतिथिस्त्वं गुणोपेतः स्वागतं ते द्विजर्षभ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2185991, "chapter_id": 4948, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2185992, "chapter_id": 4948, "verse_number": "३", "content_sanskrit": "तस्मै दत्त्वा स सत्कारं विधिदृष्टेन कर्मणा ।\nशालपुष्पमयीं दिव्यां बृसीं समुपकल्पयत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2185993, "chapter_id": 4948, "verse_number": "४", "content_sanskrit": "भगीरथरथाक्रान्तान् देशान् गङ्गानिषेवितान् ।\nये चरन्ति महामीनास्तांश्च तस्यान्वकल्पयत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2185994, "chapter_id": 4948, "verse_number": "५", "content_sanskrit": "वह्निं चापि सुसंदीप्तं मीनांश्चैव सुपीवरान् ।\nस गौतमायातिथये न्यवेदयत काश्यपः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2185995, "chapter_id": 4948, "verse_number": "६", "content_sanskrit": "भुक्तवन्तं च तं विप्रं प्रीतात्मानं महामनाः ।\nक्लमापनयनार्थं स पक्षाभ्यामभ्यवीजयत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2185996, "chapter_id": 4948, "verse_number": "७", "content_sanskrit": "ततो विश्रान्तमासीनं गोत्रप्रश्नमपृच्छत ।\nसोऽब्रवीद् गौतमोऽस्मीति ब्राह्म नान्यदुदाहरत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2185997, "chapter_id": 4948, "verse_number": "८", "content_sanskrit": "तस्मै पर्णमयं दिव्यं दिव्यपुष्पाधिवासितम् ।\nगन्धाढ्यं शयनं प्रादात्स शिश्ये तत्र वै सुखम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2185998, "chapter_id": 4948, "verse_number": "९", "content_sanskrit": "अथोपविष्टं शयने गौतमं बकराट् तदा ।\nपप्रच्छ काश्यपो वाग्मी किमागमनकारणम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2185999, "chapter_id": 4948, "verse_number": "१०", "content_sanskrit": "ततोऽब्रवीद्गौतमस्तं दरिद्रोऽहं महामते ।\nसमुद्रगमनाकाङ्क्षी द्रव्यार्थमिति भारत\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186000, "chapter_id": 4948, "verse_number": "११", "content_sanskrit": "तं काश्यपोऽब्रवीत् प्रीतो नोत्कण्ठां कर्तुमर्हसि ।\nकृतकार्यो द्विजश्रेष्ठ सदृशो यास्यसे सुखान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186001, "chapter_id": 4948, "verse_number": "१२", "content_sanskrit": "चतुर्विधा ह्यर्थगतिर्बृहस्पतिमतं यथा ।\nपारम्पर्यं तथा दैवं कर्म मित्रमिति प्रभो\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2186002, "chapter_id": 4948, "verse_number": "१३", "content_sanskrit": "प्रादुर्भूतोऽस्मि ते मित्रं सुहृत्त्वं च मम त्वयि ।\nसोऽहं तथा यतिष्यामि भविष्यसि यथार्थवान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2186003, "chapter_id": 4948, "verse_number": "१४", "content_sanskrit": "ततः प्रभातसमये सुखं पृष्ट्वाब्रवीदिदम् ।\nगच्छ सौम्य पथानेन कृतकृत्यो भविष्यसि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2186004, "chapter_id": 4948, "verse_number": "१५", "content_sanskrit": "इतस्त्रियोजनं गत्वा राक्षसाधिपतिर्महान् ।\nविरूपाक्ष इति ख्यातः सखा मम महाबलः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2186005, "chapter_id": 4948, "verse_number": "१६", "content_sanskrit": "तं गच्छ द्विजमुख्य त्वं मम वाक्यप्रचोदितः ।\nकामानभीप्सितांस्तुभ्यं दाता नास्त्यत्र संशयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2186006, "chapter_id": 4948, "verse_number": "१७", "content_sanskrit": "इत्युक्तः प्रययौ राजन्गौतमो विगतक्लमः ।\nफलान्यमृतकल्पानि भक्षयन्स्म यथेष्टतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2186007, "chapter_id": 4948, "verse_number": "१८", "content_sanskrit": "चन्दनागुरुमुख्यानि त्वक्पत्राणां वनानि च ।\nतस्मिन् पथि महाराज सेवमानो द्रुतं ययौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2186008, "chapter_id": 4948, "verse_number": "१९", "content_sanskrit": "ततो मेरुव्रजं नाम नगरं शैलतोरणम् ।\nशैलप्राकारवप्रं च शैलयन्त्रार्गलं तथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2186009, "chapter_id": 4948, "verse_number": "२०", "content_sanskrit": "विदितश्चाभवत्तस्य राक्षसेन्द्रस्य धीमतः ।\nप्रहितः सुहृदा राजन् प्रीयता वै प्रियातिथिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2186010, "chapter_id": 4948, "verse_number": "२१", "content_sanskrit": "ततः स राक्षसेन्द्रः स्वान् प्रेष्यानाह युधिष्ठिर ।\nगौतमो नगरद्वाराच्छीघ्रमानीयतामिति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2186011, "chapter_id": 4948, "verse_number": "२२", "content_sanskrit": "ततः पुरवरात्तस्मात् पुरुषाः श्वेतवेष्टनाः ।\nगौतमेत्यभिभाषन्तः पुरद्वारमुपागमन्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2186012, "chapter_id": 4948, "verse_number": "२३", "content_sanskrit": "ते तमूचुर्महाराज प्रेष्या रक्षःपतेर्द्विजम् ।\nत्वरस्व तूर्णमागच्छ राजा त्वां द्रष्टुमिच्छति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2186013, "chapter_id": 4948, "verse_number": "२४", "content_sanskrit": "राक्षसाधिपतिर्वीरो विरूपाक्ष इति श्रुतः ।\nस त्वां त्वरति वै द्रष्टुं तत् क्षिप्रं संविधीयताम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2186014, "chapter_id": 4948, "verse_number": "२५", "content_sanskrit": "ततः स प्राद्रवद् विप्रो विस्मयाद् विगतक्लमः ।\nगौतमो नगरर्द्धिं तां पश्यन् परमविस्मितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2186015, "chapter_id": 4948, "verse_number": "२६", "content_sanskrit": "तैरेव सहितो राज्ञो वेश्म तूर्णमुपाद्रवत् ।\nदर्शनं राक्षसेन्द्रस्य काङ्क्षमाणो द्विजस्तदा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2186016, "chapter_id": 4948, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे षट्त्रिंशोऽध्यायः ॥ ३६ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]