[{"id": 2123497, "chapter_id": 3650, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2123498, "chapter_id": 3650, "verse_number": "१", "content_sanskrit": "या नः श्रुता मनुष्येषु स्त्रियो रूपेण सम्मताः ।\nयासामेतादृशं कर्म न कस्याश्चिन्निशाम्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2123499, "chapter_id": 3650, "verse_number": "२", "content_sanskrit": "क्रोधाविष्टेषु पार्थेषु धृतराष्ट्रसुतेन च ।\nद्रौपदी पाण्डुपुत्राणां कृष्णा शन्तिरिहाभवत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2123500, "chapter_id": 3650, "verse_number": "३", "content_sanskrit": "अप्लवेऽम्भसि मग्नानामप्रतिष्ठे निमज्जताम् ।\nपाञ्चाली पाण्डुपुत्राणां पारगा नौरिवाभवत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2123501, "chapter_id": 3650, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2123502, "chapter_id": 3650, "verse_number": "४", "content_sanskrit": "तद्वै श्रुत्वा भीमसेनः कुरुमध्येऽत्यमर्षणः ॥\nस्त्री गतिः पाण्डुपुत्राणामित्युवाच सुदुर्मनाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2123503, "chapter_id": 3650, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2123504, "chapter_id": 3650, "verse_number": "५", "content_sanskrit": "त्रीणि ज्योतींषि पुरुष इति वै देवलोऽब्रवीत् ।\nयुद्धेऽपराङ्मुखत्वं च आहूतस्यानिवर्तनम् ।\nदाराणां वर्त्तनं चैव इति तज्ज्योतिषां त्रयम् । ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2123505, "chapter_id": 3650, "verse_number": "६", "content_sanskrit": "अमेध्ये वै गतप्राणे शून्ये ज्ञातिभिरुज्झिते ।\nदेहे त्रितयमेवैतत् पुरुषस्योपजायते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2123506, "chapter_id": 3650, "verse_number": "७", "content_sanskrit": "तन्नो ज्योतिरुपहतं दाराणामभिमर्शनात् ।\nधनञ्जय कथं स्वित् स्याद् अपत्यमभिमृष्टजम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2123507, "chapter_id": 3650, "verse_number": "", "content_sanskrit": "धनञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2123508, "chapter_id": 3650, "verse_number": "८", "content_sanskrit": "न चैवोक्ता न चानुक्ता हीनतः परुषा गिरः ।\nभारताः प्रतिजल्पन्ति सदाऽनुत्तमपूरुषाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2123509, "chapter_id": 3650, "verse_number": "९", "content_sanskrit": "स्मरन्ति सुकृतान्येव न वैराणि कृतानि च ।\nसन्तः प्रतिविजानन्तो लब्ध्वा प्रत्ययमात्मनः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2123510, "chapter_id": 3650, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2123511, "chapter_id": 3650, "verse_number": "१०", "content_sanskrit": "इहैवैतानहं सर्वान् हत्वा शत्रून् समागतान् ।\nअथ निष्क्रम्य राजेन्द्र आमूलाद्धन्मि भारत ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2123512, "chapter_id": 3650, "verse_number": "११", "content_sanskrit": "किं नो विवदितेनेह किं नः क्लेशेन भारत ।\nअद्यैव तान् निहत्याजौ प्रशाधि वसुधामिमाम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2123513, "chapter_id": 3650, "verse_number": "१२", "content_sanskrit": "इत्युक्त्वा भीमसेनस्तु कनिष्ठैर्भ्रातृभिर्वृतः ।\nमृगमध्ये यथा सिंहो मुहुः परिघमैक्षत ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2123514, "chapter_id": 3650, "verse_number": "१३", "content_sanskrit": "सान्त्व्यमानो वार्यमाणः पार्थेनाक्लिष्टकर्मणा ।\nस्विद्यते च महाबाहुरन्तर्दाहेन वीर्यवान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2123515, "chapter_id": 3650, "verse_number": "१४", "content_sanskrit": "क्रुद्धस्य तस्य स्रोतोभ्यः कर्णादिभ्यो नराधिप ।\nसधूमः सस्फुलिङ्गार्चिः पावकः समजायत ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2123516, "chapter_id": 3650, "verse_number": "१५", "content_sanskrit": "भ्रुकुटीपुटदुष्प्रेक्षमभवत् तस्य तन्मुखम् ।\nयुगान्तकाले सम्प्राप्ते कृतान्तस्येव रूपिणः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2123517, "chapter_id": 3650, "verse_number": "१६", "content_sanskrit": "युधिष्ठिरस्तमावार्य बाहुना बाहुशाळिनम् ।\nमैवमित्यब्रवीच्चैनं जोषमास्वेति भारत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2123518, "chapter_id": 3650, "verse_number": "१७", "content_sanskrit": "निवार्य तं महाबाहुं कोपसंरक्तलोचनम् ।\nपितरं समुपातिष्ठद् धृतराष्ट्रं कृताञ्जलिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2123519, "chapter_id": 3650, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2123520, "chapter_id": 3650, "verse_number": "१८", "content_sanskrit": "राजन् किं करवामस्ते प्रशाध्यस्मांस्त्वमीश्वरः ।\nनित्यं हि स्थातुमिच्छामस्तव भारत शासने ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2123521, "chapter_id": 3650, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2123522, "chapter_id": 3650, "verse_number": "१९", "content_sanskrit": "अजातशत्रो भद्रं ते अरिष्टं स्वस्ति गच्छत ।\nअनुज्ञाताः सहधनाः स्वराज्यमनुशासत ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2123523, "chapter_id": 3650, "verse_number": "२०", "content_sanskrit": "इदं ते तात बोद्धव्यं वृद्धस्य मम शासनम् ।\nमया निगदितं कृत्न्सं पश्य निश्श्रेयसं परम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2123524, "chapter_id": 3650, "verse_number": "२१", "content_sanskrit": "वेत्थ त्वं तात धर्माणां गतिं सूक्ष्मां युधिष्ठिर ।\nविनीतोऽसि महाप्राज्ञ वृद्धानां पर्युपासिता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2123525, "chapter_id": 3650, "verse_number": "२२", "content_sanskrit": "यतोऽनुबुद्धितः शान्तिः प्रशमं गच्छ भारत ।\nनादारौ क्रमते शस्त्रं दारौ शस्त्रं निपात्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2123526, "chapter_id": 3650, "verse_number": "२३", "content_sanskrit": "न वैराण्यभिजानन्ति गुणान् पश्यन्ति नागुणान्\nविरोधं नाधिगच्छन्ति नित्यमुत्तमपूरुषाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2123527, "chapter_id": 3650, "verse_number": "२४", "content_sanskrit": "संवादे परुषाण्याहुर्युधिष्ठिर नराधमाः ।\nप्रत्याहुर्मध्यमास्त्वेतेऽनुक्ताः परुषमुत्तरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2123528, "chapter_id": 3650, "verse_number": "२५", "content_sanskrit": "नचैवोक्ता न चानुक्ता अहिताः परुषा गिरः ।\nअभिजल्पन्ति नो धीराः सदा तूत्तमपूरुषाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2123529, "chapter_id": 3650, "verse_number": "२६", "content_sanskrit": "स्मरन्ति सुकृतान्येव न वैराणि कृतान्यपि ।\nसन्तः प्रतिविजानन्तो लब्ध्वा प्रत्ययमात्मनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2123530, "chapter_id": 3650, "verse_number": "२७", "content_sanskrit": "यथाऽऽचरितमार्येण त्वयाऽस्मिन् सत्समागमे ।\nदुर्योधनस्य पारुष्यं तत् तात हृदि मा कृथाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2123531, "chapter_id": 3650, "verse_number": "२८", "content_sanskrit": "मातरं चैव गान्धारीं मां च त्वद्गुणकाङ्क्षिणम् ।\nउपस्थितं वृद्धमन्धं पितरं पश्य भारत ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2123532, "chapter_id": 3650, "verse_number": "२९", "content_sanskrit": "मित्राणि द्रष्टुकामेन पुत्राणां च बलाबलम् ।\nअशोच्याः कुरवो राजन् येषां त्वमनुशासिता ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2123533, "chapter_id": 3650, "verse_number": "३०", "content_sanskrit": "मन्त्री च विदुरो धीमान् सर्वशास्त्रविशारदः ।\nत्वयि धर्मोर्ऽजुने धैर्य्यं भीमसेने पराक्रमः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2123534, "chapter_id": 3650, "verse_number": "३१", "content_sanskrit": "अजातशत्रो भद्रं ते खाण्डवप्रस्थमाविश ।\nभ्रातृभिस्तेऽस्तु सौभ्रात्रं धर्मे ते धीयतां मनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2123535, "chapter_id": 3650, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2123536, "chapter_id": 3650, "verse_number": "३२", "content_sanskrit": "इत्युक्तो भरतश्रेष्ठो धर्मराजो युधिष्ठिरः ।\nकृत्वाऽऽर्यसमयं सर्वं प्रतस्थे भ्रातृभिः सह ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2123537, "chapter_id": 3650, "verse_number": "३३", "content_sanskrit": "ते रथान् सूर्यसङ्काशा आस्थाय सह कृष्णया ।\nप्रययुर्हृष्टमनस इन्द्रप्रस्थपुरं प्रति ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2123538, "chapter_id": 3650, "verse_number": "२४", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि द्विनवतितमोऽध्यायः ॥९२॥\n॥ द्यूतपर्वणि चतुर्विंशोऽध्यायः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2123539, "chapter_id": 3650, "verse_number": "", "content_sanskrit": "॥ समाप्तं द्यूतपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]