[{"id": 7000416000, "chapter_id": 20416, "verse_number": "२-८८-१", "content_sanskrit": "कुंजल उवाच ।\nव्रतं स्तोत्रं महाज्ञानं ध्यानं चैव सुपुत्रक ।\nमयाख्यातं तवाग्रे वै विष्णोः पापप्रणाशनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000416001, "chapter_id": 20416, "verse_number": "२-८८-२", "content_sanskrit": "एवं चतुष्टयं सा हि यदा पुण्यं समाचरेत् ।\nप्रयाति वैष्णवं लोकं देवानामपि दुर्लभम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000416002, "chapter_id": 20416, "verse_number": "२-८८-३", "content_sanskrit": "इतो गत्वा व्रतं वत्स दिव्यां देवीं प्रबोधय ।\nअशून्यशयनं नाम व्रतराजं वदस्व ताम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000416003, "chapter_id": 20416, "verse_number": "२-८८-४", "content_sanskrit": "समुद्धर महापापाद्राजकन्यां यशस्विनीम् ।\nत्वया पृष्टं मया ख्यातं पुण्यदं पापनाशनम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000416004, "chapter_id": 20416, "verse_number": "२-८८-५", "content_sanskrit": "गच्छ गच्छ महाभाग इत्युक्त्वा विरराम सः ।\nश्रीविष्णुरुवाच ।\nउज्ज्वलोप्येवमुक्तस्तु स पित्रा कुंजलेन हि॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000416005, "chapter_id": 20416, "verse_number": "२-८८-६", "content_sanskrit": "प्रणम्य पादौ धर्मात्मा मातापित्रोर्महामतिः ।\nजगाम त्वरितो राजन्प्लक्षद्वीपं स उज्ज्वलः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000416006, "chapter_id": 20416, "verse_number": "२-८८-७", "content_sanskrit": "तं गिरिं सर्वतोभद्रं नानाधातुसमाकुलम् ।\nनानारत्नमयैस्तुंगैः शिखरैरुपशोभितम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000416007, "chapter_id": 20416, "verse_number": "२-८८-८", "content_sanskrit": "नानाप्रवाहसंपूर्णैरुदकैरुज्ज्वलैर्नृप ।\nनद्यः संति स्वच्छनीरास्तस्मिन्गिरिवरोत्तमे॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000416008, "chapter_id": 20416, "verse_number": "२-८८-९", "content_sanskrit": "किन्नरास्तत्र गायंति गंधर्वाः सुस्वरैर्नृप ।\nअप्सरोभिः समाकीर्णं देववृंदैरुपावृतम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000416009, "chapter_id": 20416, "verse_number": "२-८८-१०", "content_sanskrit": "सिद्धचारणसंघुष्टं मुनिवृंदैरलंकृतम् ।\nनानापक्षिनिनादैश्च सर्वत्र परिनादितम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000416010, "chapter_id": 20416, "verse_number": "२-८८-११", "content_sanskrit": "एवं गिरिं समासाद्य उज्ज्वलो लघुविक्रमः ।\nसुस्वरेणापि सा कन्या गिरौ तस्मिन्प्ररोदिति॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000416011, "chapter_id": 20416, "verse_number": "२-८८-१२", "content_sanskrit": "रोरूयमाणां स प्राज्ञो वचनं चेदमब्रवीत् ।\nका त्वं भवसि कल्याणि कस्माद्रोदिषि सांप्रतम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000416012, "chapter_id": 20416, "verse_number": "२-८८-१३", "content_sanskrit": "कमाश्रिता महाभागे केन ते विप्रियं कृतम् ।\nसमाचक्ष्व ममाद्यैव सर्वदुःखस्य कारणम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000416013, "chapter_id": 20416, "verse_number": "२-८८-१४", "content_sanskrit": "दिव्यादेव्युवाच ।\nविपाको हि महाभाग कर्मणां मम सांप्रतम् ।\nइह तिष्ठामि दुःखेन वैधव्येन समन्विता॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000416014, "chapter_id": 20416, "verse_number": "२-८८-१५", "content_sanskrit": "भवान्को हि महाभाग कृपया मम पीडितः ।\nपक्षिरूपधरो वत्स सोत्सवं परिभाषते॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000416015, "chapter_id": 20416, "verse_number": "२-८८-१६", "content_sanskrit": "एवमाकर्ण्य तत्सर्वं भाषितं राजकन्यया ।\nअहं पक्षी महाभागे कृपया तव पीडितः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000416016, "chapter_id": 20416, "verse_number": "२-८८-१७", "content_sanskrit": "पक्षिरूपधरो भद्रे नाहं सिद्धो न ज्ञानवान् ।\nरुदमानां महालापैर्भवतीं दृष्टवानिह॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000416017, "chapter_id": 20416, "verse_number": "२-८८-१८", "content_sanskrit": "ततः पृच्छाम्यहं देवि वद मे कारणं त्विह ।\nपितुर्गेहे यथावृत्तमात्मवृत्तांतमेव हि॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000416018, "chapter_id": 20416, "verse_number": "२-८८-१९", "content_sanskrit": "तया निवेदितं सर्वं यथासंख्येन दुःखदम् ।\nसमासेन समाकर्ण्य उज्ज्वलस्तु महमनाः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000416019, "chapter_id": 20416, "verse_number": "२-८८-२०", "content_sanskrit": "तामुवाच महापक्षी दिव्यादेवीं सुदुःखिताम् ।\nयथा विवाहकाले ते भर्तारो मरणं गताः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000416020, "chapter_id": 20416, "verse_number": "२-८८-२१", "content_sanskrit": "स्वयंवरनिमित्तं ते क्षयं याताश्च क्षत्रियाः ।\nएतत्ते चेष्टितं सर्वं मया पितरि भाषितम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000416021, "chapter_id": 20416, "verse_number": "२-८८-२२", "content_sanskrit": "अन्यजन्मकृतंकर्मतव पापं सुलोचने ।\nमम पित्रा ममाग्रे तु कृपया परिभाषितम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000416022, "chapter_id": 20416, "verse_number": "२-८८-२३", "content_sanskrit": "तेन दोषेण संपुष्टा लिप्ता जाता वरानने ।\nएतावत्कारणं सर्वं तातेन परिभाषितम्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000416023, "chapter_id": 20416, "verse_number": "२-८८-२४", "content_sanskrit": "पूर्वकर्मविपाकं तु भुंक्ष्व त्वं च समाश्वस ।\nएवं सा भाषितं तस्य श्रुत्वा कन्योज्ज्वलस्य तत्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000416024, "chapter_id": 20416, "verse_number": "२-८८-२५", "content_sanskrit": "प्रत्युवाच महात्मानं ब्रुवंतं पक्षिणं पुनः ।\nप्रणता दीनया वाचा कुरु पक्षिन्कृपां मम॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000416025, "chapter_id": 20416, "verse_number": "२-८८-२६", "content_sanskrit": "कथयस्व प्रसादेन तस्य पापस्य निष्कृतिम् ।\nप्रायश्चित्तं सुपुण्यं च मम पातकशोधनम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000416026, "chapter_id": 20416, "verse_number": "२-८८-२७", "content_sanskrit": "येन व्रजाम्यहं पुण्यं विशुद्धाधौतकल्मषा ।\nप्रायश्चित्तं महाभाग वद मे त्वं प्रसादतः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000416027, "chapter_id": 20416, "verse_number": "२-८८-२८", "content_sanskrit": "उज्ज्वल उवाच ।\nतवार्थं तु महाभागे पितरं पृष्टवानहम् ।\nसमाख्यातमतः पित्रा प्रायश्चित्तमनुत्तमम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000416028, "chapter_id": 20416, "verse_number": "२-८८-२९", "content_sanskrit": "तत्त्वं कुरु महाभागे सर्वपातकशोधनम् ।\nध्यायस्व हि हृषीकेशं शतनामजपस्व च॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000416029, "chapter_id": 20416, "verse_number": "२-८८-३०", "content_sanskrit": "भव ज्ञानपरा नित्यं कुरु व्रतमनुत्तमम् ।\nअशून्यशयनं पुण्यं व्रतं पापप्रणाशकम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000416030, "chapter_id": 20416, "verse_number": "२-८८-३१", "content_sanskrit": "समाचष्ट स धर्मात्मा सर्वज्ञानप्रकाशकम् ।\nज्ञानं स्तोत्रं व्रतं ध्यानं विष्णोश्चैव महात्मनः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000416031, "chapter_id": 20416, "verse_number": "२-८८-३२", "content_sanskrit": "विष्णुरुवाच ।\nतस्मात्सा हि प्रजग्राह संस्थिता निर्जने वने ।\nसर्वद्वंद्वविनिर्मुक्ता संजाता तपसि स्थिता॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000416032, "chapter_id": 20416, "verse_number": "२-८८-३३", "content_sanskrit": "व्रतं चक्रे जिताहारा निराधारा सुदुःखिता ।\nकामक्रोधविहीना सा वर्गं संयम्य नित्यशः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000416033, "chapter_id": 20416, "verse_number": "२-८८-३४", "content_sanskrit": "इंद्रियाणां महाराज महामोहं निरस्य सा ।\nअब्दे चतुर्थके प्राप्ते सुप्रसन्नो जनार्दनः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000416034, "chapter_id": 20416, "verse_number": "२-८८-३५", "content_sanskrit": "तस्यै वरं दातुकामश्चायातो वरनायकः ।\nतस्यै संदर्शयामास स्वरूपं वरदः प्रभुः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000416035, "chapter_id": 20416, "verse_number": "२-८८-३६", "content_sanskrit": "सूत उवाच ।\nइंद्रनीलघनश्यामं शंखचक्रगदाधरम् ।\nसर्वाभरणशोभाढ्यं पद्महस्तं महेश्वरम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000416036, "chapter_id": 20416, "verse_number": "२-८८-३७", "content_sanskrit": "बद्धांजलिपुटा भूत्वा वेपमाना निराश्रया ।\nउवाच गद्गदैर्वाक्यैः प्रणता मधुसूदनम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000416037, "chapter_id": 20416, "verse_number": "२-८८-३८", "content_sanskrit": "तेजसा तव दिव्येन स्थातुं शक्नोमि नैव हि ।\nदिव्यरूपो भवेः कस्त्वं कृपया मम चाग्रतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000416038, "chapter_id": 20416, "verse_number": "२-८८-३९", "content_sanskrit": "कथयस्व प्रसादेन किमत्र तव कारणम् ।\nसर्वमेव प्रसादेन प्रब्रवीहि महामते॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000416039, "chapter_id": 20416, "verse_number": "२-८८-४०", "content_sanskrit": "देवमेवं विजानामि तेजसा इंगितैस्तव ।\nज्ञानहीना जगन्नाथ न जाने रूपनामनी॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000416040, "chapter_id": 20416, "verse_number": "२-८८-४१", "content_sanskrit": "किं ब्रह्मा वा भवान्विष्णुः किं वा शंकर एव हि ।\nएवमुक्त्वा प्रणम्यैवं दंडवद्धरणीं गता॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000416041, "chapter_id": 20416, "verse_number": "२-८८-४२", "content_sanskrit": "तामुवाच जगन्नाथः प्रणतां राजनंदिनीम् ।\nश्रीभगवानुवाच ।\nत्रयाणामपि देवानामंतरं नास्ति शोभने॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000416042, "chapter_id": 20416, "verse_number": "२-८८-४३", "content_sanskrit": "ब्रह्मा समर्चितो येन शंकरो वा वरानने ।\nतेनाहमर्चितो नित्यं नात्र कार्या विचारणा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000416043, "chapter_id": 20416, "verse_number": "२-८८-४४", "content_sanskrit": "एतौ ममाभिन्नतरौ नित्यं चापि त्रिरूपवान् ।\nअहं हि पूजितो यैश्च तावेतौ तैः सुपूजितौ॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000416044, "chapter_id": 20416, "verse_number": "२-८८-४५", "content_sanskrit": "अहं देवो हृषीकेशः कृपया तव चागतः ।\nस्तवेनानेन पुण्येन व्रतेन नियमेन च॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000416045, "chapter_id": 20416, "verse_number": "२-८८-४६", "content_sanskrit": "संजाता कल्मषैर्हीना वरं वरय शोभने ।\nदिव्यादेव्युवाच ।\nविजयस्व हृषीकेश कृष्णक्लेशापहारक॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000416046, "chapter_id": 20416, "verse_number": "२-८८-४७", "content_sanskrit": "नमामि चरणद्वंद्वं मामुद्धर सुरेश्वर ।\nवरं मे दातुकामोऽसि चक्रपाणे प्रसीद मे॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000416047, "chapter_id": 20416, "verse_number": "२-८८-४८", "content_sanskrit": "आत्मपादयुगस्यापि भक्तिं देहि ममानघ ।\nदर्शयस्व जगन्नाथ मोक्षमार्गं निरामयम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000416048, "chapter_id": 20416, "verse_number": "२-८८-४९", "content_sanskrit": "दासत्वं देहि वैकुंठ यदि तुष्टो जनार्दन ।\nश्रीभगवानुवाच ।\nएवमस्तु महाभागे गच्छ निर्धूतकल्मषा॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000416049, "chapter_id": 20416, "verse_number": "२-८८-५०", "content_sanskrit": "वैष्णवं परमं लोकं दुर्लभं योगिभिः सदा ।\nगच्छ गच्छ परं लोकं प्रसादान्मम सांप्रतम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000416050, "chapter_id": 20416, "verse_number": "२-८८-५१", "content_sanskrit": "एवमुक्ते ततो वाक्ये माधवेन महात्मना ।\nदिव्यादेवी अभूद्दिव्या सूर्यतेजः समप्रभा॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000416051, "chapter_id": 20416, "verse_number": "२-८८-५२", "content_sanskrit": "पश्यतां सर्वलोकानां दिव्याभरणभूषिता ।\nदिव्यमालान्विता सा च दिव्यहारविलंबिनी॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000416052, "chapter_id": 20416, "verse_number": "२-८८-५३", "content_sanskrit": "गता सा वैष्णवं लोकं दाहप्रलयवर्जितम् ।\nपुनः पक्षी समायातः स्वगृहं हर्षसंयुतः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000416053, "chapter_id": 20416, "verse_number": "२-८८-५४", "content_sanskrit": "तत्सर्वं कथयामास पितरं प्रति सत्तमः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]