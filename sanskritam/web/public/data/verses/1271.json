[{"id": 2013180, "chapter_id": 1271, "verse_number": "२-१२-१", "content_sanskrit": "युधिष्ठिर उवाच॥\nप्रायशो राजलोकस्ते कथितो वदतां वर।\nवैवस्वतसभायां तु यथा वदसि मे प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013181, "chapter_id": 1271, "verse_number": "२-१२-२", "content_sanskrit": "वरुणस्य सभायां तु नागास्ते कथिता विभो।\nदैत्येन्द्राश्चापि भूयिष्ठाः सरितः सागरास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013182, "chapter_id": 1271, "verse_number": "२-१२-३", "content_sanskrit": "तथा धनपतेर्यक्षा गुह्यका राक्षसास्तथा।\nगन्धर्वाप्सरसश्चैव भगवांश्च वृषध्वजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013183, "chapter_id": 1271, "verse_number": "२-१२-४", "content_sanskrit": "पितामहसभायां तु कथितास्ते महर्षभः।\nसर्वे देवनिकायाश्च सर्वशास्त्राणि वैव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013184, "chapter_id": 1271, "verse_number": "२-१२-५", "content_sanskrit": "शक्रस्य तु सभायां तु देवाः सङ्कीर्तिता मुने।\nउद्देशतश्च गन्धर्वा विविधाश्च महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013185, "chapter_id": 1271, "verse_number": "२-१२-६", "content_sanskrit": "एक एव तु राजर्षिर्हरिश्चन्द्रो महामुने।\nकथितस्ते सभायां वै देवेन्द्रस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013186, "chapter_id": 1271, "verse_number": "२-१२-७", "content_sanskrit": "किं कर्म तेनाचरितं तपो वा नियतव्रत।\nयेनासौ सह शक्रेण स्पर्धदे सुमहायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013187, "chapter_id": 1271, "verse_number": "२-१२-८", "content_sanskrit": "पितृलोकगतश्चैव त्वया विप्र पिता मम।\nदृष्टः पाण्डुर्महाभागः कथं वाऽपि समागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013188, "chapter_id": 1271, "verse_number": "२-१२-९", "content_sanskrit": "किमुक्तवांश्च भगवंस्तन्ममाचक्ष्व सुव्रत।\nत्वत्तः श्रोतुं सर्वमिदं परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013189, "chapter_id": 1271, "verse_number": "२-१२-१०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013190, "chapter_id": 1271, "verse_number": "२-१२-१०", "content_sanskrit": "यन्मां पृच्छसि राजेन्द्र हरिश्चन्द्रं प्रति प्रभो।\nतत्तेऽहं सम्प्रवक्ष्यामि माहात्म्यं तस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013191, "chapter_id": 1271, "verse_number": "२-१२-११", "content_sanskrit": "इक्ष्वाकूणां कुले जातस्त्रिशङ्कुर्नाम पार्थिवः।\nअयोध्याधिपतिर्वीरो विश्वामित्रेण संस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013192, "chapter_id": 1271, "verse_number": "२-१२-१२", "content_sanskrit": "तस्य सत्यवती नाम पत्नी केकयवंशजा।\nतस्यां गर्भः समभवद्धर्मेण कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013193, "chapter_id": 1271, "verse_number": "२-१२-१३", "content_sanskrit": "सा च काले महाभागा राजन्मासं प्रविश्य च।\nकुमारं जनयामास हरिश्चन्द्रमकल्मषम्।\nस वै राजा हरिश्चन्द्रस्त्रैशङ्कव इति स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013194, "chapter_id": 1271, "verse_number": "२-१२-१४", "content_sanskrit": "स राजा बलवानासीत्सम्राट् सर्वमहीक्षिताम्।\nतस्य सर्वे महीपालाः शासनावनताः स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013195, "chapter_id": 1271, "verse_number": "२-१२-१५", "content_sanskrit": "तेनैकं रथमास्थाय जैत्रं हेमविभूषितम्।\nशस्त्रप्रतापेन जिता द्वीपाः सप्त जनेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013196, "chapter_id": 1271, "verse_number": "२-१२-१६", "content_sanskrit": "स निर्जित्य महीं कृत्स्नां सशैलवनकाननाम्।\nआजहार महाराज राजसूयं महाक्रतुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013197, "chapter_id": 1271, "verse_number": "२-१२-१७", "content_sanskrit": "तस्य सर्वे महीपाला धनान्याजह्रुराज्ञया।\nद्विजानां परिवेष्टारस्तस्मिन्यज्ञे च तेऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013198, "chapter_id": 1271, "verse_number": "२-१२-१८", "content_sanskrit": "समाप्तयज्ञो विधिवद्धरिश्चन्द्रः प्रतापवान्।\nअभिषिक्तश्च शुशुभे साम्राज्येन नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013199, "chapter_id": 1271, "verse_number": "२-१२-१९", "content_sanskrit": "राजसूयेऽभिषिक्तश्च समाप्तवरदक्षिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013200, "chapter_id": 1271, "verse_number": "२-१२-२०", "content_sanskrit": "प्रादाच्च द्रविणं प्रीत्या याचकानां नरेश्वरः।\nयथोक्तवन्तस्ते तस्मिंस्ततः पञ्चगुणाधिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013201, "chapter_id": 1271, "verse_number": "२-१२-२१", "content_sanskrit": "अतर्पयच्च विविधैर्वसुभिर्ब्राह्मणांस्तदा।\nप्रसर्पकाले सम्प्राप्ते नानादिग्भ्यः समागतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013202, "chapter_id": 1271, "verse_number": "२-१२-२२", "content_sanskrit": "भक्ष्यभोज्यैश्च विविधैर्यथाकामपुरस्कृतैः।\nरत्नौघतर्पितैस्तुष्टैर्द्विजैश्च समुदाहृतम्।\nतेजस्वी च यशस्वी च नृपेभ्योऽभ्यधिकोऽभवत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013203, "chapter_id": 1271, "verse_number": "२-१२-२३", "content_sanskrit": "एतस्मात्कारणाद्राजन्हरिश्चन्द्रो विराजते।\nतेभ्यो राजसहस्रेभ्यस्तद्विद्वि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013204, "chapter_id": 1271, "verse_number": "२-१२-२४", "content_sanskrit": "समाप्य च हरिश्चन्द्रो महायज्ञं प्रतापवान्।\nअभिषिक्तश्च शुशुभे साम्राज्येन नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013205, "chapter_id": 1271, "verse_number": "२-१२-२५", "content_sanskrit": "ये चान्ये च महीपाला राजसूयं महाक्रतुम्।\nयजन्ते ते सहेन्द्रेण मोदन्ते भरतर्षभ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013206, "chapter_id": 1271, "verse_number": "२-१२-२६", "content_sanskrit": "ये चापि नि नं प्राप्ताः सङ्ग्रामेष्वपलायिनः।\nते तत्सदनम् ताद्य मोन्दते भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013207, "chapter_id": 1271, "verse_number": "२-१२-२७", "content_sanskrit": "तपसा ये च तीव्रेण त्यजन्तीह कलेवरम्।\nते तत्स्थानं समासाद्य श्रीमन्तो भान्ति नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013208, "chapter_id": 1271, "verse_number": "२-१२-२८", "content_sanskrit": "पिता च त्वाऽऽह कौन्तेय पाण्डुः कौरवनन्दन।\nहरिश्चन्द्रे श्रियं दृष्ट्वा नृपतौ जातविस्मयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013209, "chapter_id": 1271, "verse_number": "२-१२-२९", "content_sanskrit": "विज्ञाय मानुषं लोकमायान्तं मां नराधिप।\nप्रोवाच प्रणतो भूत्वा वदेथास्त्वं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013210, "chapter_id": 1271, "verse_number": "२-१२-३०", "content_sanskrit": "समर्थोऽसि महीं जेतुं भ्रातरस्ते स्थिता वशे।\nराजसूयं क्रतुश्रेष्ठमहारस्वेति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013211, "chapter_id": 1271, "verse_number": "२-१२-३१", "content_sanskrit": "त्वयीष्टवति पुत्रेऽहं हरिश्चन्द्रवदाशु वै।\nमोदिष्ये बहुलाः शश्वत्समाः शक्रस्य संसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013212, "chapter_id": 1271, "verse_number": "२-१२-३२", "content_sanskrit": "एवं भवतु वक्ष्येऽहं तव पुत्रं नराधिपम्।\nभूलोकं यदि गच्छेयमिति पाण्डुमथाब्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013213, "chapter_id": 1271, "verse_number": "२-१२-३३", "content_sanskrit": "तस्य त्वं पुरुषव्याघ्र सङ्कल्पं कुरु पाण्डव।\nगन्तासित्वं महेन्द्रस्य पूर्वैः सह सलोकताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2013214, "chapter_id": 1271, "verse_number": "२-१२-३४", "content_sanskrit": "बहुविघ्नश्च नृपते क्रतुरेष स्मृतो महान्।\nछिद्राण्यस्य वाञ्छन्ति यज्ञघ्ना ब्रह्मराक्षसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2013215, "chapter_id": 1271, "verse_number": "२-१२-३५", "content_sanskrit": "युद्धं च क्षत्रशमनं पृथिवीक्षयकारणम्।\nकिञ्चिदेव निमित्तं च भवत्यत्र क्षयावहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2013216, "chapter_id": 1271, "verse_number": "२-१२-३६", "content_sanskrit": "एतत्सञ्चिन्त्य राजेन्द्र यत्क्षमं तत्समाचर।\nअप्रमत्तोत्थितो नित्यं चातुर्वर्ण्यस्य रक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2013217, "chapter_id": 1271, "verse_number": "२-१२-३७", "content_sanskrit": "भव एधस्व मोदस्व धनैस्तर्पय च द्विजान्।\nएतत्ते विस्तरेणोक्तं यन्मां त्वं परिपृच्छसि।\nआपृच्छे त्वां गमिष्यामि दाशार्हनगरीं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2013218, "chapter_id": 1271, "verse_number": "२-१२-३८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2013219, "chapter_id": 1271, "verse_number": "२-१२-३८", "content_sanskrit": "एवमाख्याय पार्थेभ्यो नारदो जनमेजय।\nजगाम तैर्वृतो राजन्नृषिभिर्यैः समागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2013220, "chapter_id": 1271, "verse_number": "२-१२-३९", "content_sanskrit": "गते तु नारदे पार्थो भ्रातृभिः सह कौरवः।\nराजसूयं क्रतुश्रेष्ठं चिन्तयामास पार्थिवः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2013221, "chapter_id": 1271, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि द्वादशोऽध्यायः॥ १२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]