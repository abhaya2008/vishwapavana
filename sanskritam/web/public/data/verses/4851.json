[{"id": 2181705, "chapter_id": 4851, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2181706, "chapter_id": 4851, "verse_number": "१", "content_sanskrit": "चातुराश्रम्य उक्तोऽत्र चातुर्वर्ण्यस्तथैव च ।\nराष्ट्रस्य यत् कृत्यतमं तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2181707, "chapter_id": 4851, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2181708, "chapter_id": 4851, "verse_number": "२", "content_sanskrit": "राष्ट्रस्यैतत् कृत्यतमं राज्ञ एवाभिषेचनम् ।\nअनिन्द्रमबलं राष्ट्रं दस्यवोऽभिभवन्ति च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2181709, "chapter_id": 4851, "verse_number": "३", "content_sanskrit": "अराजकेषु राष्ट्रेषु धर्मो न व्यवतिष्ठते ।\nपरस्परं च खादन्ति सर्वथा धिगराजकम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2181710, "chapter_id": 4851, "verse_number": "४", "content_sanskrit": "इन्द्रमेनं प्रवृणुते यद् राजानमिति श्रुतिः ।\nयथैवेन्द्रस्तथा राजा सम्पूज्यो भूतिमिच्छता\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2181711, "chapter_id": 4851, "verse_number": "५", "content_sanskrit": "नाराजकेषु राष्ट्रेषु वस्तव्यमिति वैदिकम् ।\nनाराजकेषु राष्ट्रेषु हव्यमग्निर्वहत्यपि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2181712, "chapter_id": 4851, "verse_number": "६", "content_sanskrit": "अथ चेदधिवर्तेत राज्यार्थी बलवत्तरः ।\nअराजकानि राष्ट्राणि हतवीराणि वा पुनः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2181713, "chapter_id": 4851, "verse_number": "७", "content_sanskrit": "प्रत्युद्गम्याभिपूज्यः स्यादेतदत्र सुमन्त्रितम् ।\nनहि पापात् पापतरमस्ति किञ्चिदराजकात्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2181714, "chapter_id": 4851, "verse_number": "८", "content_sanskrit": "स चेत् समनुपश्येत समग्रं कुशलं भवेत् ।\nबलवान् हि प्रकुपितः कुर्यान्निःशेषतामपि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2181715, "chapter_id": 4851, "verse_number": "९", "content_sanskrit": "भूयांसं लभते क्लेशं या गौर्भवति दुर्दुहा ।\nसुदुहा या तु भवति नैव तां क्लेशयन्त्युत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2181716, "chapter_id": 4851, "verse_number": "१०", "content_sanskrit": "यदतप्तं प्रणमति न तत् सन्तापयन्त्युत ।\nयच्च स्वयं नतं दारु न तत् सन्नामयन्त्यपि\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2181717, "chapter_id": 4851, "verse_number": "११", "content_sanskrit": "एतयोपमया धीरः सन्नमेत बलीयसे ।\nइन्द्राय स प्रणमते नमते यो बलीयसे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2181718, "chapter_id": 4851, "verse_number": "१२", "content_sanskrit": "तस्माद् राजैव कर्तव्यः सततं भूतिमिच्छता ।\nन धनार्थो न दारार्थस्तेषां येषामराजकम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2181719, "chapter_id": 4851, "verse_number": "१३", "content_sanskrit": "प्रीयते हि हरन् पापः परवित्तमराजके ।\nयदास्य उद्धरन्त्यन्ये तदा राजानमिच्छति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2181720, "chapter_id": 4851, "verse_number": "१४", "content_sanskrit": "पापा अपि तदा क्षेमं न लभन्ते कदाचन ।\nएकस्य हि द्वौ हरतो द्वयोश्च बहवोऽपरे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2181721, "chapter_id": 4851, "verse_number": "१५", "content_sanskrit": "अदासः क्रियते दासो ह्रियन्ते च बलात् स्त्रियः ।\nएतस्मात् कारणाद् देवाः प्रजापालान् प्रचक्रिरे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2181722, "chapter_id": 4851, "verse_number": "१६", "content_sanskrit": "राजा चेन्न भवेल्लोके पृथिव्यां दण्डधारकः ।\nशूले मत्स्यानिवापक्ष्यन् दुर्बलान् बलवत्तराः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2181723, "chapter_id": 4851, "verse_number": "१७", "content_sanskrit": "अराजकाः प्रजाः पूर्वं विनेशुरिति नः श्रुतम् ।\nपरस्परं भक्षयन्तो मत्स्या इव जले कृशान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2181724, "chapter_id": 4851, "verse_number": "१८", "content_sanskrit": "ताः समेत्य ततश्चक्रुः समयानिति नः श्रुतम् ।\nवाक्क्रूरो दण्डपरुषो यश्च स्यात् पारदारिकः ।\nयश्च नः स्वमथादद्यात् त्याज्या नस्तादृशा इति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2181725, "chapter_id": 4851, "verse_number": "१९", "content_sanskrit": "विश्वासनार्थं वर्णानां सर्वेषामविशेषतः ।\nतास्तथा समयं कृत्वा समयेनावतस्थिरे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2181726, "chapter_id": 4851, "verse_number": "२०", "content_sanskrit": "सहितास्तास्तदा जग्मुरसुखार्ताः पितामहम् ।\nअनीश्वरा विनश्यामो भगवन्नीश्वरं दिश\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2181727, "chapter_id": 4851, "verse_number": "२१", "content_sanskrit": "यं पूजयेम सम्भूय यश्च नः परिपालयेत् ।\nताभ्यो मनुं व्यादिदेश मनुर्नाभिननन्द ताः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2181728, "chapter_id": 4851, "verse_number": "", "content_sanskrit": "मनुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2181729, "chapter_id": 4851, "verse_number": "२२", "content_sanskrit": "बिभेमि कर्मणः क्रूराद् राज्यं हि भृशदुष्करम् ।\nविशेषतो मनुष्येषु मिथ्यावृत्तिषु नित्यदा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2181730, "chapter_id": 4851, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2181731, "chapter_id": 4851, "verse_number": "२३", "content_sanskrit": "तमब्रुवन् प्रजा मा भैः कर्मणैनो गमिष्यति ।\nपशूनामधिपञ्चाशद् हिरण्यस्य तथैव च ।\nधान्यस्य दशमं भागं दास्यामः कोशवर्धनम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2181732, "chapter_id": 4851, "verse_number": "२४", "content_sanskrit": "कन्यां मुख्यां चारुरूपां विवाहेषूद्यतासु च ।\nमुख्येन शस्त्रपत्रेण ये मनुष्याः प्रधानतः ।\nभवन्तं तेऽनुयास्यन्ति महेन्द्रमिव देवताः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2181733, "chapter_id": 4851, "verse_number": "२५", "content_sanskrit": "स त्वं जातबलो राजन् दुष्प्रधर्षः प्रतापवान् ।\nसुखे धास्यसि नः सर्वान् कुबेर इव नैर्ऋतान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2181734, "chapter_id": 4851, "verse_number": "२६", "content_sanskrit": "यं च धर्मं चरिष्यन्ति प्रजा राज्ञा सुरक्षिताः ।\nचतुर्थं तस्य धर्मस्य त्वत्संस्थं नो भविष्यति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2181735, "chapter_id": 4851, "verse_number": "२७", "content_sanskrit": "तेन धर्मेण महता सुखलुब्धेन भावितः ।\nपाह्यस्मान् सर्वतो राजन् देवानिव शतक्रतुः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2181736, "chapter_id": 4851, "verse_number": "२८", "content_sanskrit": "विजयायाशु निर्याहि प्रतपन् रश्मिमानिव ।\nमानं विधम शत्रूणां धर्मो जयतु नस्तदा\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2181737, "chapter_id": 4851, "verse_number": "२९", "content_sanskrit": "स निर्ययौ महातेजा बलेन महता वृतः ।\nमहाभिजनसम्पन्नस्तेजसा प्रज्वलन्निव\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2181738, "chapter_id": 4851, "verse_number": "३०", "content_sanskrit": "तस्य तां महिमां दृष्ट्वा महेन्द्रस्येव देवताः ।\nअपतत्रसिरे सर्वे स्वधर्मे च दधुर्मनः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2181739, "chapter_id": 4851, "verse_number": "३१", "content_sanskrit": "ततो महीं परिययौ पर्जन्य इव वृष्टिमान् ।\nशमयन् सर्वतः पापान् स्वकर्मसु च योजयन्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2181740, "chapter_id": 4851, "verse_number": "३२", "content_sanskrit": "एवं ये भूतिमिच्छेयुः पृथिव्यां मानवाः क्वचित् ।\nकुर्यू राजानमेवाग्रे प्रजानुग्रहकारणात्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2181741, "chapter_id": 4851, "verse_number": "३३", "content_sanskrit": "नमस्येयुश्च तं भक्त्या शिष्या इव गुरुं सदा ।\nदेवा इव सहस्राक्षं प्रजा राजानमन्तिके\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2181742, "chapter_id": 4851, "verse_number": "३४", "content_sanskrit": "सत्कृतं स्वजनेनेह परोऽपि बहु मन्यते ।\nस्वजनेन त्ववज्ञातं परे परिभवन्त्युत\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2181743, "chapter_id": 4851, "verse_number": "३५", "content_sanskrit": "राज्ञः परैः परिभवः सर्वेषामसुखावहः ।\nतस्माच्छस्त्रं च पत्रं च वासांस्याभरणानि च\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2181744, "chapter_id": 4851, "verse_number": "३६", "content_sanskrit": "भोजनान्यथ पानानि राज्ञे दद्युर्गृहाणि च ।\nआसनानि च शय्याश्च सर्वोपकरणानि च\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2181745, "chapter_id": 4851, "verse_number": "३७", "content_sanskrit": "गुप्तात्मा स्याद् दुराधर्षः स्मितपूर्वाभिभाषिता ।\nआभाषितश्च मधुरं प्रतिभाषेत मानवान्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2181746, "chapter_id": 4851, "verse_number": "३८", "content_sanskrit": "कृतज्ञो दृढभक्तिः स्यात् संविभागी जितेन्द्रियः ।\nईक्षितः प्रतिवीक्षेत मृदु चर्जु च वल्गु च\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2181747, "chapter_id": 4851, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे राष्ट्रकृत्यवर्णनं नाम अष्टषष्टितमोऽध्यायः ॥ ६८ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]