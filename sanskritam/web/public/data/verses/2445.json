[{"id": 2068961, "chapter_id": 2445, "verse_number": "९-६३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068962, "chapter_id": 2445, "verse_number": "९-६३-१", "content_sanskrit": "ततस्ते प्रययुः सर्वे निवासाय महीक्षितः।\nशङ्खान्प्रध्मापयन्तो वै हृष्टाः परिघबाहवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068963, "chapter_id": 2445, "verse_number": "९-६३-२", "content_sanskrit": "पाण्डवान्गच्छतश्चापि शिबिरं नो विशाम्पते।\nमहेष्वासोऽन्वगात्पश्चाद्युयुत्सुः सात्यकिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068964, "chapter_id": 2445, "verse_number": "९-६३-३", "content_sanskrit": "धृष्टद्युम्नः शिखण्डी च द्रौपदेयाश्च सर्वशः।\nसर्वे चान्ये महेष्वासा ययुः स्वशिबिराण्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068965, "chapter_id": 2445, "verse_number": "९-६३-४", "content_sanskrit": "ततस्ते प्राविशन्पार्था हतत्विट्कं हतेश्वरम्।\nदुर्योधनस्य शिबिरं रङ्गवन्निःसृते जने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068966, "chapter_id": 2445, "verse_number": "९-६३-५", "content_sanskrit": "गतोत्सवं पुरमिव हृतनागमिव हदम्।\nस्त्रीवर्षवरभूयिष्ठं वृद्धामात्यैरधिष्ठितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068967, "chapter_id": 2445, "verse_number": "९-६३-६", "content_sanskrit": "तत्रैतान्पर्युपातिष्ठन्दुर्योधन पुरःसराः।\nकृताञ्जलिपुटा राजन्काषायमलिनाम्बराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068968, "chapter_id": 2445, "verse_number": "९-६३-७", "content_sanskrit": "शिबिरं समनुप्राप्य कुरुराजस्य पाण्डवाः।\nअवतेरुर्महाराज रथेभ्यो रथसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068969, "chapter_id": 2445, "verse_number": "९-६३-८", "content_sanskrit": "ततो गाण्डीवधन्वानमभ्यभाषत केशवः।\nस्थितः प्रियहिते नित्यमतीव भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068970, "chapter_id": 2445, "verse_number": "९-६३-९", "content_sanskrit": "अवरोपय गाण्डीवमक्षयौ च महेषुधी।\nअथाहमवरोक्ष्यामि पश्चाद्भरतसत्तम।\nस्वयं चैवावरोह त्वमेतच्छ्रेयस्तवानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068971, "chapter_id": 2445, "verse_number": "९-६३-१०", "content_sanskrit": "तच्चाकरोत्तथा वीरः पाण्डुपुत्रो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068972, "chapter_id": 2445, "verse_number": "९-६३-११", "content_sanskrit": "अथ पश्चात्ततः कृष्णो रश्मीनुत्सृज्य वाजिनाम्।\nअवारोहत मेधावी रथाद्गाण्डीवधन्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068973, "chapter_id": 2445, "verse_number": "९-६३-१२", "content_sanskrit": "अथावतीर्णे भूतानामीश्वरे सुमहात्मनि।\nकपिरप्याश्वपाक्रामत्सहदेवैर्ध्वजालयैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068974, "chapter_id": 2445, "verse_number": "९-६३-१३", "content_sanskrit": "स दग्धो द्रोणकर्णाभ्यां दिव्यैरस्त्रैर्महारथः।\nअथ दीप्तोऽग्निना ह्याशु प्रजज्वाल महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068975, "chapter_id": 2445, "verse_number": "९-६३-१४", "content_sanskrit": "सोपासङ्गः सरश्मिश्च साश्वः सयुगबन्धनः।\nभस्मीभूतोऽपतद्भूमौ रथो गाण्डीवधन्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068976, "chapter_id": 2445, "verse_number": "९-६३-१५", "content_sanskrit": "तं तथा भस्मभूतं तु दृष्ट्वा पाण्डुसुताः प्रभो।\nअभवन्विस्मिता राजन्नर्जुनश्चेदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068977, "chapter_id": 2445, "verse_number": "९-६३-१६", "content_sanskrit": "कृताञ्जलिः सप्रणयं प्रणिपत्याभिवाद्य ह।\nगोवन्द कस्माद्भगवन्रथो दग्धोऽयमग्निना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068978, "chapter_id": 2445, "verse_number": "९-६३-१७", "content_sanskrit": "किमेतन्महदाश्चर्यमभवद्यदुनन्दन।\nतन्मे ब्रूहि महाबाहो श्रोतव्यं यदि मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068979, "chapter_id": 2445, "verse_number": "९-६३-१८x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068980, "chapter_id": 2445, "verse_number": "९-६३-१८", "content_sanskrit": "द्रोणकर्णास्त्रनिर्दग्धः पूर्वमेवायमर्जुन।\nमदास्थितत्वात्समरे न विशीर्णः परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068981, "chapter_id": 2445, "verse_number": "९-६३-१९", "content_sanskrit": "इदानीं तु विशीर्णोऽयं दग्धो ब्रह्मास्त्रतेजसा।\nमया विमुक्तः कौन्तेय त्वय्यद्य कृतकर्मणि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068982, "chapter_id": 2445, "verse_number": "९-६३-२०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068983, "chapter_id": 2445, "verse_number": "९-६३-२०", "content_sanskrit": "ईषदुत्स्मयमानस्तु भगवान्केशवोऽरिहा।\nपरिष्वज्य च राजानं युधिष्ठिरमभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068984, "chapter_id": 2445, "verse_number": "९-६३-२१", "content_sanskrit": "दिष्ट्या जयसि कौन्तेय दिष्ट्या ते शत्रवो जिताः।\nदिष्ट्या गाण्डीवधन्वा च भीमसेनश्च पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068985, "chapter_id": 2445, "verse_number": "९-६३-२२", "content_sanskrit": "त्वं चापि कुशली राजन्माद्रीपुत्रौ च पाण्डवौ।\nमुक्ता वीरक्षयादिस्मात्सङ्ग्रामान्निहतद्विषः।\nक्षिप्रमुत्तरकालानि कुरु कार्याणि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068986, "chapter_id": 2445, "verse_number": "९-६३-२३", "content_sanskrit": "उपयातमुपप्लाव्यं सह गाण्डीवधन्वना।\nआनीय मधुपर्कं मां यत्पुरा त्वमवोचथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068987, "chapter_id": 2445, "verse_number": "९-६३-२४", "content_sanskrit": "एष भ्राता सखा चैव तव कृष्ण धनञ्जयः।\nरक्षितव्यो महाबाहो सर्वास्वापत्स्विति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068988, "chapter_id": 2445, "verse_number": "९-६३-२५", "content_sanskrit": "तव चैव ब्रुवाणस्य तथेत्येवाहमब्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068989, "chapter_id": 2445, "verse_number": "९-६३-२६", "content_sanskrit": "स सव्यसाची गुप्तस्ते विजयी च जनेश्वर।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068990, "chapter_id": 2445, "verse_number": "९-६३-२६", "content_sanskrit": "भ्रातृभिः सह राजेन्द्र शूरः सत्यपराक्रमः।\nमुक्तो वीरक्षयादस्मात्सङ्ग्रामाद्रोमहर्षणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068991, "chapter_id": 2445, "verse_number": "९-६३-२७", "content_sanskrit": "एवमुक्तस्तु कृष्णेन धर्मराजो युधिष्ठिरः।\nहृष्टरोमा महाराज प्रत्युवाच जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068992, "chapter_id": 2445, "verse_number": "९-६३-२८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068993, "chapter_id": 2445, "verse_number": "९-६३-२८", "content_sanskrit": "प्रमुक्तं द्रोणकर्णाभ्यां ब्रह्मास्त्रमरिमर्दन।\nकस्त्वदन्यः सहेत्साक्षादपि वज्री पुरन्दरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068994, "chapter_id": 2445, "verse_number": "९-६३-२९", "content_sanskrit": "भवतस्तु प्रसादेन संग्रामे बहवो हताः।\nमहारणगतः पार्थो यच्च नासीत्पराङ्मुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2068995, "chapter_id": 2445, "verse_number": "९-६३-३०", "content_sanskrit": "तथा तव महाबाहो पर्यायैर्बहुभिर्मया।\nकर्मणआमनुसन्धानात्तेजस्वी जगति श्रुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2068996, "chapter_id": 2445, "verse_number": "९-६३-३१", "content_sanskrit": "उपप्लाव्ये महर्षिर्मे कृष्णद्वैपायनोऽब्रवीत्।\nयतो धर्मस्ततः कृष्णो यतः कृष्णस्ततो जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2068997, "chapter_id": 2445, "verse_number": "९-६३-३२", "content_sanskrit": "`एवमुक्तस्ततः कृष्णः प्रत्युवाच युधिष्ठिरम्।\nन तुल्याश्चार्जुनस्येह बलेन कुरुनन्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2068998, "chapter_id": 2445, "verse_number": "९-६३-३३", "content_sanskrit": "स एष सर्वाण्यस्त्राणि दिव्यानि प्राप्य शङ्करात्।\nसत्समो वा विशिष्टो वा रणे त्वमिति पाण्डवः।\nअनुज्ञातः पाण्डुसुतः पुनः प्रत्यागमन्महीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2068999, "chapter_id": 2445, "verse_number": "९-६३-३४", "content_sanskrit": "भूतं भव्यं भविष्यच्च अनुज्ञातस्त्वया विभो।\nनिमेषार्धान्नरव्याघ्रो नयेदिति मतिर्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2069000, "chapter_id": 2445, "verse_number": "९-६३-३५", "content_sanskrit": "द्रोणं भीष्मं कृपं कर्णं द्रोणपुत्रं जयद्रथम्।\nनिहन्तुं शक्नुयात्क्रुद्धो निमेषार्धाद्धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2069001, "chapter_id": 2445, "verse_number": "९-६३-३६", "content_sanskrit": "सदेवासुरगन्धर्वान्सयक्षोरगराक्षसान्।\nत्रीन्वा लोकान्विजेतुं स शक्तः किमिह मानुषान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2069002, "chapter_id": 2445, "verse_number": "९-६३-३७", "content_sanskrit": "विधिना विहितं चासौ मया सञ्चोदितोऽपि सन्।\nन चकार मतिं हन्तुं ततस्ते बलवत्तराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2069003, "chapter_id": 2445, "verse_number": "९-६३-३८", "content_sanskrit": "अत्र गीता मया सुष्ठु गिरः सत्या महीपते।\nदर्सितं मयि सर्वं च तेनासौ जितवान्रिपून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2069004, "chapter_id": 2445, "verse_number": "९-६३-३९", "content_sanskrit": "अर्जुनोऽपि महाबाहुर्मया तुल्यो महीपते।\nस महेश्वरलब्धास्त्रः किं न कुर्याद्विभुः प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2069005, "chapter_id": 2445, "verse_number": "९-६३-४०", "content_sanskrit": "इत्येवमुक्ते ते वीराः शिबिरं तव भारत।\nप्रविश्य प्रत्यपद्यन्त कोशरत्नर्धिसञ्चयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2069006, "chapter_id": 2445, "verse_number": "९-६३-४१", "content_sanskrit": "रजतं जातरूपं च मणीनथ च मौक्तिकान्।\nभूषणान्यथ मुख्यानि कम्बलान्यजिनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2069007, "chapter_id": 2445, "verse_number": "९-६३-४२", "content_sanskrit": "`गजानश्वान्रथांश्चैव महान्ति शयनानि च।\nदासीदासमसंख्येयं राज्योपकरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2069008, "chapter_id": 2445, "verse_number": "९-६३-४३", "content_sanskrit": "ते प्राप्य धनमक्षय्यं त्वदीयं भरतर्षभ।\nउदक्रोशन्महाभागा नरेन्द्र विजितारयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2069009, "chapter_id": 2445, "verse_number": "९-६३-४४", "content_sanskrit": "ते तु वीराः समाश्वस्य वाहनान्यवमुच्य च।\nअतिष्ठन्त मुहुः सर्वे पाण्डवा विगतज्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2069010, "chapter_id": 2445, "verse_number": "९-६३-४५", "content_sanskrit": "अथाब्रवीन्महाराज वासुदेवो महायशाः।\nअस्माभिर्मङ्गलार्थाय वस्तव्यं शिबिराद्बहिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2069011, "chapter_id": 2445, "verse_number": "९-६३-४६", "content_sanskrit": "तथेत्युक्त्वा हि ते सर्वे पाण्डवाः सात्यकिस्तथा।\nवासुदेवेन सहिता मङ्गलार्थं बहिर्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2069012, "chapter_id": 2445, "verse_number": "९-६३-४७", "content_sanskrit": "ते समासाद्य सरितं पुण्यामोघवतीं नृप।\nन्यवसन्नथ तां रात्रिं पाण्डवा हतशत्रवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2069013, "chapter_id": 2445, "verse_number": "९-६३-४८", "content_sanskrit": "युधिष्ठिरस्ततो राजा प्राप्तकालमचिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2069014, "chapter_id": 2445, "verse_number": "९-६३-४९", "content_sanskrit": "तत्र ते गमनं माप्तं रोचते तव माधव।\nगान्धार्याः क्रोधदीप्तायाः प्रशमार्थमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2069015, "chapter_id": 2445, "verse_number": "९-६३-५०", "content_sanskrit": "हेतुकारणयुक्तैश्च वाक्यैः कालसमीरितैः।\nक्षिप्रमेव महाभाग गान्धारीं प्रशमिष्यसि।\nपितामहश्च भगवान्व्यासस्तत्र भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2069016, "chapter_id": 2445, "verse_number": "९-६३-५१", "content_sanskrit": "ततः सम्प्रेषयामासुर्यादवं नागसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2069017, "chapter_id": 2445, "verse_number": "९-६३-५२", "content_sanskrit": "स च प्रायाज्जवेनाशु वासुदेवः प्रतापवान्।\nदारुकं रथमारोप्य येन राजाऽम्बिकासुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2069018, "chapter_id": 2445, "verse_number": "९-६३-५३", "content_sanskrit": "तमूचुः सम्प्रयास्यन्तं शैब्यसुग्रीववाहनम्।\nप्रत्याश्वासय गान्धारीं हतपुत्रां यशस्विनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2069019, "chapter_id": 2445, "verse_number": "९-६३-५४", "content_sanskrit": "स प्रायात्पाण्डवैरुक्तस्तत्पुरं सात्वतां वरः।\nआससाद ततः क्षिप्रं गान्धारीं निहतात्मजाम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2069020, "chapter_id": 2445, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि गदायुद्धपर्वणि त्रिषष्टितमोऽध्यायः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]