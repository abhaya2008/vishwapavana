[{"id": 2190770, "chapter_id": 5060, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2190771, "chapter_id": 5060, "verse_number": "१", "content_sanskrit": "मोक्षः पितामहेनोक्त नानुपायादुपायतः ।\nतमुपायं यथान्यायं श्रोतुमिच्छामि भारत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2190772, "chapter_id": 5060, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2190773, "chapter_id": 5060, "verse_number": "२", "content_sanskrit": "त्वय्येवैतन्महाप्राज्ञ युक्तं निपुणदर्शनम् ।\nयदुपायेन सर्वार्थान्नित्यं मृगयसेऽनघ\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190774, "chapter_id": 5060, "verse_number": "३", "content_sanskrit": "करणे घटस्य या बुद्धिर्घटोत्पत्तौ न सानघ ।\nएवं धर्माभ्युपायेषु नान्यद्धर्मेषु कारणम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190775, "chapter_id": 5060, "verse_number": "४", "content_sanskrit": "पूर्वे समुद्रे यः पन्था न स गच्छति पश्चिमम् ।\nएकः पन्था हि मोक्षस्य तन्मे विस्तरतः शृणु\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190776, "chapter_id": 5060, "verse_number": "५", "content_sanskrit": "क्षमया क्रोधमुच्छिन्द्यात् कामं सङ्कल्पवर्जनात् ।\nसत्त्वसंसेवनाद्धीरो निद्रामुच्छेत्तुमर्हति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190777, "chapter_id": 5060, "verse_number": "६", "content_sanskrit": "अप्रमादाद् भयं रक्षेच्छ्वासं क्षेत्रज्ञशीलनात् ।\nइच्छां द्वेषं च कामं च धैर्येण विनिवर्तयेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190778, "chapter_id": 5060, "verse_number": "७", "content_sanskrit": "भ्रमं प्रमोहमावर्तमभ्यासाद् विनिवर्तयेत् ।\nनिद्रां चाप्रतिभां चैव ज्ञानाभ्यासेन तत्त्ववित्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2190779, "chapter_id": 5060, "verse_number": "८", "content_sanskrit": "उपद्रवांस्तथा रोगान् हितजीर्णमिताशनात् ।\nलोभं मोहं च सन्तोषाद् विषयांस्तत्त्वदर्शनात्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2190780, "chapter_id": 5060, "verse_number": "९", "content_sanskrit": "अनुक्रोशादधर्मं च जयेद्धर्ममुपेक्षया ।\nआयत्या च जयेदाशामर्थं सङ्गविवर्जनात्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2190781, "chapter_id": 5060, "verse_number": "१०", "content_sanskrit": "अनित्यत्वेन च स्नेहं क्षुधं योगेन पण्डितः ।\nकारुण्येनात्मनो मानं तृष्णां च परितोषतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2190782, "chapter_id": 5060, "verse_number": "११", "content_sanskrit": "उत्थानेन जयेत्तन्द्रीं वितर्कं निश्चयाज्जयेत् ।\nमौनेन बहुभाष्यं च शौर्येण च भयं जयेत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2190783, "chapter_id": 5060, "verse_number": "१२", "content_sanskrit": "यच्छेद् वाङ्मनसी बुद्ध्या तां यच्छेज्ज्ञानचक्षुषा ।\nज्ञानमात्मा महान् यच्छेत्तं यच्छेत् ज्ञान आत्मनि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2190784, "chapter_id": 5060, "verse_number": "१३", "content_sanskrit": "तदेतदुपशान्तेन बोद्धव्यं शुचिकर्मणा ।\nयोगदोषान् समुच्छिद्य पञ्च यान् कवयो विदुः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2190785, "chapter_id": 5060, "verse_number": "१४", "content_sanskrit": "कामं क्रोधं च लोभं च भयं स्वप्नं च पञ्चमम् ।\nपरित्यज्य निषेवेत तथेमान् योगसाधनान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2190786, "chapter_id": 5060, "verse_number": "१५", "content_sanskrit": "ध्यानमध्ययनं दानं सत्यं ह्रीरार्जवं क्षमा ।\nशौचमाहारतः शुद्धिरिन्द्रियाणां च संयमः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2190787, "chapter_id": 5060, "verse_number": "१६", "content_sanskrit": "एतैर्विवर्धते तेजः पाप्मानमपहन्ति च ।\nसिद्ध्यन्ति चास्य सङ्कल्पा विज्ञानं च प्रवर्तते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2190788, "chapter_id": 5060, "verse_number": "१७", "content_sanskrit": "धूतपापः स तेजस्वी लघ्वाहारो जितेन्द्रियः ।\nकामक्रोधौ वशे कृत्वा निनीषेद् ब्रह्मणः पदम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2190789, "chapter_id": 5060, "verse_number": "१८", "content_sanskrit": "अमूढत्वमसङ्गित्वं कामक्रोधविवर्जनम् ।\nअदैन्यमनुदीर्णत्वमनुद्वेगो व्यवस्थितिः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2190790, "chapter_id": 5060, "verse_number": "१९", "content_sanskrit": "एष मार्गो हि मोक्षस्य प्रसन्नो विमलः शुचिः ।\nतथा वाक्कायमनसां नियमः कामतोऽन्यथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2190791, "chapter_id": 5060, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे नवाधिकशततमोऽध्यायः ॥१०९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]