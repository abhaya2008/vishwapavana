[{"id": 2082360, "chapter_id": 2749, "verse_number": "१२-२५४-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082361, "chapter_id": 2749, "verse_number": "१२-२५४-१", "content_sanskrit": "मनः प्रसृजते भावं बुद्धिरध्यवसायिनी।\nहृदयं प्रियाप्रिये वेद त्रिविधा कर्मवेदना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082362, "chapter_id": 2749, "verse_number": "१२-२५४-२", "content_sanskrit": "इन्द्रियेभ्यः परा ह्यर्था अर्थेभ्यः परमं मनः।\nमनसस्तु परा बुद्धिर्बुद्धेरात्मा परो मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082363, "chapter_id": 2749, "verse_number": "१२-२५४-३", "content_sanskrit": "बुद्धिरात्मा मनुष्यस्य बुद्धिरेवात्मनो गतिः।\nयदा विकुरुते भाव तदा भवति सा मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082364, "chapter_id": 2749, "verse_number": "१२-२५४-४", "content_sanskrit": "इन्द्रियाणां पृथग्भावाद्बुद्धिर्विक्रियतेऽसकृत्।\nशृण्वती भवति श्रोत्रं स्पृशती स्पर्श उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082365, "chapter_id": 2749, "verse_number": "१२-२५४-५", "content_sanskrit": "पश्यती भवते दृष्टी रसती रसनं भवेत्।\nजिघ्रती भवति घ्राणं बुद्धिर्विक्रियते पृथक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082366, "chapter_id": 2749, "verse_number": "१२-२५४-६", "content_sanskrit": "इन्द्रियाणीति तान्याहुस्तेष्वदृश्योऽधितिष्ठति।\nतिष्ठती पुरुषे बुद्धिस्त्रिषु भावेषु वर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082367, "chapter_id": 2749, "verse_number": "१२-२५४-७", "content_sanskrit": "कदाचिल्लभते प्रीतिं कदाचिदपि शोचति।\nन सुखेन न दुःखेन कदाचिदिह युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082368, "chapter_id": 2749, "verse_number": "१२-२५४-८", "content_sanskrit": "सेयं भावात्मिका भावांस्त्रीनेताननुवर्तते।\nसरितां सागरो भर्ता महावेलामिवोर्मिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082369, "chapter_id": 2749, "verse_number": "१२-२५४-९", "content_sanskrit": "यदा प्रार्थयते किंचित्तदा भवति सा मनः।\nअधिष्ठानानि वै बुद्ध्यां पृथगेतानि संस्मरेत।\nइन्द्रियाण्येवमेतानि विजेतव्यानि कृत्स्नशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082370, "chapter_id": 2749, "verse_number": "१२-२५४-१०", "content_sanskrit": "सर्वाण्येवानुपूर्व्येण यद्यदाऽनुविधीयते।\nअविभागगता बुद्धिर्भावे मनसि वर्तते। १२-२५४-१०c` प्रवर्तमानं तु रजः सत्वमप्यनुवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082371, "chapter_id": 2749, "verse_number": "१२-२५४-११", "content_sanskrit": "ये चैव भावा वर्तन्ते सर्व एष्वेव ते त्रिषु।\nअन्वर्थाः संप्रवर्तन्ते रथनेमिमरा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082372, "chapter_id": 2749, "verse_number": "१२-२५४-१२", "content_sanskrit": "प्रदीपार्थं मनः कुर्यादिन्द्रियैर्बुद्धिसत्तमैः।\nनिश्चरद्भिर्यथायोगमुदासीनैर्यदृच्छया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082373, "chapter_id": 2749, "verse_number": "१२-२५४-१३", "content_sanskrit": "एवं स्वभावमेवेदमिति विद्वान्न मुह्यति।\nअशोचन्नप्रहृष्यन्हि नित्यं विगतमत्सरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082374, "chapter_id": 2749, "verse_number": "१२-२५४-१४", "content_sanskrit": "न चात्मा शक्यते द्रष्टुमिन्द्रियैः कामगोचरैः।\nप्रवर्तमानैरनयैर्दुर्धर्षैरकृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082375, "chapter_id": 2749, "verse_number": "१२-२५४-१५", "content_sanskrit": "तेषां तु मनसा रश्मीन्यदा सम्यङ्क्तियच्छति।\nतदा प्रकाशतेऽस्यात्मा दीपदीप्ता यथाऽऽकृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082376, "chapter_id": 2749, "verse_number": "१२-२५४-१६", "content_sanskrit": "सर्वेषामेव भूतानां मनस्युपरते यथा।\nप्रकाशं भवते सर्वं तथेदमुपधार्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082377, "chapter_id": 2749, "verse_number": "१२-२५४-१७", "content_sanskrit": "यथा वारिचरः पक्षी न लिप्यति जले चरन्।\nविमुक्तात्मा तथा योगी गुणदोषैर्न लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082378, "chapter_id": 2749, "verse_number": "१२-२५४-१८", "content_sanskrit": "एवमेव कृतप्रज्ञो न दोषैर्विषयांश्चरन्।\nअसज्जमानः सर्वेषु कथंचन न लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082379, "chapter_id": 2749, "verse_number": "१२-२५४-१९", "content_sanskrit": "त्यक्त्वा पूर्वकृतं कर्म रतिर्यस्य सदाऽऽत्मनि।\nसर्वभूतात्मभूतस्य गुणवर्गेष्वसज्जतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082380, "chapter_id": 2749, "verse_number": "१२-२५४-२०", "content_sanskrit": "सत्वमात्मा प्रसरति गुणान्वाऽपि कदाचन।\nन गुणा विदुरात्मानं गुणान्वेद स सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082381, "chapter_id": 2749, "verse_number": "१२-२५४-२१", "content_sanskrit": "परिद्रष्टा गुणानां च परिस्रष्टा यथातथम्।\nक्षेतक्षेत्रज्ञयोरेतदन्तरं विद्धि सूक्ष्मयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082382, "chapter_id": 2749, "verse_number": "१२-२५४-२२", "content_sanskrit": "सृजतेऽत्र गुणानेक एको न सृजते गुणान्।\nपृथग्भूतौ प्रकृत्या तौ संप्रयुक्तौ च सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082383, "chapter_id": 2749, "verse_number": "१२-२५४-२३", "content_sanskrit": "यथा मत्स्योऽद्भिरन्यः स्यात्संप्रयुक्तौ तथैव तौ।\nमशकोदुम्बरौ वाऽपि संप्रयुक्तौ यथा सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082384, "chapter_id": 2749, "verse_number": "१२-२५४-२४", "content_sanskrit": "इषीका वा यथा मुञ्जे पृथक्च सह चैव च।\nतथैव सहितावेतावन्योन्यस्मिन्प्रतिष्ठितौ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082385, "chapter_id": 2749, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुःपञ्चाशदधिकद्विशततमोऽध्यायः॥ २५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]