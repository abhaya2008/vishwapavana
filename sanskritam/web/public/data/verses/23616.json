[{"id": 7003616000, "chapter_id": 23616, "verse_number": "१-२-३-१", "content_sanskrit": "सू उवाच ।\nएवं स्थानानि पुण्यानि यानियानीह वै भुवि ।\nनिरीक्षंस्तत्र तत्राहं नारदो वीरसत्तम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003616001, "chapter_id": 23616, "verse_number": "१-२-३-२", "content_sanskrit": "विचरन्मेदिनीं सर्वां प्राप्तोऽहमाश्रमं भृगोः ।\nयत्र रेवानदी पुण्या सप्तकल्पस्मरा वरा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003616002, "chapter_id": 23616, "verse_number": "१-२-३-३", "content_sanskrit": "महापुण्या पवित्रा च सर्वतीर्थमयी शुभा ।\nपुनानि कीर्तनेनैव दर्शनेन विशेषतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003616003, "chapter_id": 23616, "verse_number": "१-२-३-४", "content_sanskrit": "तत्रावगाहनात्पार्थ मुच्यते जंतुरंहसा ।\nयथा सा पिङ्गला नाडी देहमध्ये व्यवस्थिता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003616004, "chapter_id": 23616, "verse_number": "१-२-३-५", "content_sanskrit": "इयं ब्रह्मांडपिण्डस्य स्थाने तस्मिन्प्रकीर्तिता ।\nतत्रास्ते शुक्लतीर्थाख्यं रेवायां पापनाशनम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003616005, "chapter_id": 23616, "verse_number": "१-२-३-६", "content_sanskrit": "यत्र वै स्नानमात्रेण ब्रह्महत्या प्रणश्यति ।\nतस्यापि सन्निधौ पार्थ रेवाया उत्तरे तटे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003616006, "chapter_id": 23616, "verse_number": "१-२-३-७", "content_sanskrit": "नानावृक्षसमाकीर्णं लतागुल्मोपशोभितम् ।\nनानापुष्पफलो पेतं कदलीखंडमंडितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003616007, "chapter_id": 23616, "verse_number": "१-२-३-८", "content_sanskrit": "अनेकाश्वापदाकीर्णं विहगैरनुनादितम् ।\nसुगंधपुष्पशोभाढ्यं मयूररवनादितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003616008, "chapter_id": 23616, "verse_number": "१-२-३-९", "content_sanskrit": "भ्रमरैः सर्वमुत्सृज्य निलीनं रावसंयुतम् ।\nयथा संसारमुत्सृज्य भक्तेन हरपादयोः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003616009, "chapter_id": 23616, "verse_number": "१-२-३-१०", "content_sanskrit": "कोकिला मधुरैः स्वानैर्नादयंति तथा मुनीन् ।\nयथा कथामृताख्यानैर्ब्राह्मणा भवभीरुकान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003616010, "chapter_id": 23616, "verse_number": "१-२-३-११", "content_sanskrit": "यत्र वृक्षा ह्लादयंति फलैः पुष्पैश्च पत्रकैः ।\nछायाभिरपि काष्ठैश्च लोकानिव हरव्रताः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003616011, "chapter_id": 23616, "verse_number": "१-२-३-१२", "content_sanskrit": "पुत्रपुत्रेति वाशंते यत्र पुत्रप्रियाः खगाः ।\nयथा शिवप्रियाः शैवा नित्यं शिवशिवेति च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003616012, "chapter_id": 23616, "verse_number": "१-२-३-१३", "content_sanskrit": "एवंविधं मुनेस्तस्य भृगोराश्रममंडलम् ।\nविप्रैस्त्रैविद्यसंयुक्तैः सर्वतः समलंकृतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003616013, "chapter_id": 23616, "verse_number": "१-२-३-१४", "content_sanskrit": "ऋग्यजुः सामनिर्घोपैरारूरितदिगन्तरम् ।\nरुद्रभक्तेन धीरेण यथैव भुवनत्रयम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003616014, "chapter_id": 23616, "verse_number": "१-२-३-१५", "content_sanskrit": "तत्राहं पार्थ संप्राप्तो यत्रास्ते मुनिसत्तमः ।\nभृगुः परमधर्मात्मातपसा द्योतितप्रभः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003616015, "chapter_id": 23616, "verse_number": "१-२-३-१६", "content_sanskrit": "आगच्छंतं तु मां दृष्ट्वा दीनं च मुदितं तथा ।\nअभ्युत्थआनं कृतं सर्वैर्विप्रैर्भृगुपुरोगमैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003616016, "chapter_id": 23616, "verse_number": "१-२-३-१७", "content_sanskrit": "कृत्वा सुस्वागतं दत्त्वा अर्घाद्यं भृगुणा सह ।\nआसनेषूपविष्टास्ते मुनींद्रा ग्राहिता मया ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003616017, "chapter_id": 23616, "verse_number": "१-२-३-१८", "content_sanskrit": "विश्रांतं तु ततो ज्ञात्वा भृगुर्मामप्युवाचह ।\nक्व गंतव्यं मुनिश्रेष्ठ कस्मादिह समागतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003616018, "chapter_id": 23616, "verse_number": "१-२-३-१९", "content_sanskrit": "आगमनकारणं सर्वं समाचक्ष्व परिस्फुटम् ।\nततस्तं चिंतयाविष्टो भृगुं पार्थाहमब्रुवम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003616019, "chapter_id": 23616, "verse_number": "१-२-३-२०", "content_sanskrit": "श्रूयतामभिधास्यामि यदर्थमहामागतः ।\nमया पर्यटिता सर्वा समुद्रांता च मेदिनी ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003616020, "chapter_id": 23616, "verse_number": "१-२-३-२१", "content_sanskrit": "द्विजानां भूमिदानार्थं मार्गमाणः पदेपदे ।\nनिर्दोषां च पवित्रां च तीर्थेष्वपि समन्विताम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003616021, "chapter_id": 23616, "verse_number": "१-२-३-२२", "content_sanskrit": "रम्यां मनोरमां भूमिं न पश्यामि कथंचन ।\nभृगुरुवाच ।\nविप्राणां स्थापनार्थाय मयापि भ्रमता पुरा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003616022, "chapter_id": 23616, "verse_number": "१-२-३-२३", "content_sanskrit": "पृथ्वी सागरपर्यंता दृष्टा सर्वा तदानघ ।\nमहीनाम नदी पुण्या सर्वतीर्थमयी शुभा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003616023, "chapter_id": 23616, "verse_number": "१-२-३-२४", "content_sanskrit": "दिव्या मनोरमा सौम्या महापापप्रणाशिनी ।\nनदीरूपेण तत्रैव पृथ्वी सा नात्र संशयः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003616024, "chapter_id": 23616, "verse_number": "१-२-३-२५", "content_sanskrit": "पृथिव्यां यानि तीर्थानि दृष्टादृष्टानि नारद ।\nतानि सर्वाणि तत्रैव निवसंति महीजले ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003616025, "chapter_id": 23616, "verse_number": "१-२-३-२६", "content_sanskrit": "सा समुद्रेण संप्राप्ता पुण्यतोया महानदी ।\nसंजातस्तत्र देवर्षे महीसागरसंगमः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003616026, "chapter_id": 23616, "verse_number": "१-२-३-२७", "content_sanskrit": "स्तंभाख्यं तत्र तीर्थं तु त्रिषु लोकेषु विश्रुतम् ।\nतत्र ये मनुजाः स्नानं प्रकुर्वंति विपश्चितः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003616027, "chapter_id": 23616, "verse_number": "१-२-३-२८", "content_sanskrit": "सर्वपापविनिर्मुक्ता नोपसर्पंति वै यमम् ।\nतत्राद्भुतं हि दृष्टं मे पुरा स्नातुं गतेन वै ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003616028, "chapter_id": 23616, "verse_number": "१-२-३-२९", "content_sanskrit": "तदहं कीर्तयिष्यामि मुने श्रृणु महाद्भुतम् ।\nयावत्स्नातुं व्रजाम्यस्मिन्महीसागरसंगमे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003616029, "chapter_id": 23616, "verse_number": "१-२-३-३०", "content_sanskrit": "तीरे स्थितं प्रपश्यामि मुनींद्रं पावकोपमम् ।\nप्रांशुं वृद्धं चास्थिशेषं तपोलक्ष्म्या विभूषितम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003616030, "chapter_id": 23616, "verse_number": "१-२-३-३१", "content_sanskrit": "भुजावूर्ध्वौ ततः कृत्वा प्ररुदंतं मुहुर्मुहुः ।\nतं तथा दुःखितं दृष्ट्वा दुःखितोऽहमथाभवम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003616031, "chapter_id": 23616, "verse_number": "१-२-३-३२", "content_sanskrit": "सतां लक्षणमेतद्धि यद्दृष्ट्वा दुःखितं जनम् ।\nशतसंख्य तस्य भवेत्तथाहं विललाप ह ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003616032, "chapter_id": 23616, "verse_number": "१-२-३-३३", "content_sanskrit": "अहिंसा सत्यमस्तेयं मानुष्ये सति दुर्लभम् ।\nततस्तमुपसंगम्य पर्यपृच्छमहं तदा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003616033, "chapter_id": 23616, "verse_number": "१-२-३-३४", "content_sanskrit": "किमर्थं रोदिशि मुने शोके किं कारणं तव ।\nसुगुह्यमपि चेद्बूहि जिज्ञासा महती हि मे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003616034, "chapter_id": 23616, "verse_number": "१-२-३-३५", "content_sanskrit": "मुनिस्ततो मामवदद्भृगो निर्भाग्यवानहम् ।\nतेन रोदिमि मा पृच्छ दुर्भाग्यं चालपेद्धि कः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003616035, "chapter_id": 23616, "verse_number": "१-२-३-३६", "content_sanskrit": "तमहं विस्मयाविष्टः पुनरेवेदमब्रुवम् ।\nदुर्लभं भारते जन्म तत्रापि च मनुष्यता ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003616036, "chapter_id": 23616, "verse_number": "१-२-३-३७", "content_sanskrit": "मनुष्यत्वे ब्राह्मणत्वं मुनित्वं तत्र दुर्लभम् ।\nतत्रापि च तपःसिद्धिः प्राप्यैतत्पंचकं परम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003616037, "chapter_id": 23616, "verse_number": "१-२-३-३८", "content_sanskrit": "किमर्थं रोदिषि मुने विस्मयोऽत्र महान्मम ।\nएवं संपृच्छते मह्यमेतस्मिन्नेव चांतरे ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003616038, "chapter_id": 23616, "verse_number": "१-२-३-३९", "content_sanskrit": "सुभद्रोनाम नाम्ना च मुनिस्तत्राभ्युपाययौ ।\nस हि मेरुं परित्यज्य ज्ञात्वा तीर्थस्य सारताम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003616039, "chapter_id": 23616, "verse_number": "१-२-३-४०", "content_sanskrit": "कृताश्रमः पूजयति सदा स्तंभेश्वरं मुनिः ।\nसोऽप्येवं मामि वापृच्छन्मुनिं रोदनकारणम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003616040, "chapter_id": 23616, "verse_number": "१-२-३-४१", "content_sanskrit": "अथाहाचम्य स मुनिः श्रूयतां कारणं मुनी ।\nअहं हि देवशर्माख्यो मुनिः संयतवाङ्मनाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003616041, "chapter_id": 23616, "verse_number": "१-२-३-४२", "content_sanskrit": "निवसामि कृतस्थानो गंगासागरसंगमे ।\nतत्र दर्शेतर्पयामि सदैव च पितॄनहम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003616042, "chapter_id": 23616, "verse_number": "१-२-३-४३", "content_sanskrit": "श्राद्धांते ते च प्रत्यक्षा ह्याशिषो मे वदंति च ।\nततः कदाचित्पितरः प्रहृष्टा मामथाब्रवन् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003616043, "chapter_id": 23616, "verse_number": "१-२-३-४४", "content_sanskrit": "वयं सदात्र चायामो देवशर्मंस्तवांतिके ।\nस्थानेऽस्माकं कदाचित्त्वं न चायासि कुतः सुतः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003616044, "chapter_id": 23616, "verse_number": "१-२-३-४५", "content_sanskrit": "स्थानं दिदृक्षुस्तच्चाहं न शक्तोऽस्मि निवोदितुम् ।\nततः परममित्युक्त्वा गतवान्पितृभिः सह ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003616045, "chapter_id": 23616, "verse_number": "१-२-३-४६", "content_sanskrit": "पितॄणां मंदिरं पुण्यं भौमलोकसमास्थितम् ।\nतत्रतत्र स्थितश्चाहं तेजोमण्डलदुर्दृशान् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003616046, "chapter_id": 23616, "verse_number": "१-२-३-४७", "content_sanskrit": "दृष्ट्वाग्रतः पूजयाढ्यानपृच्छं स्वान्पितॄनिति ।\nके ह्यमी समुपायांति भृशं तृप्ता भृशार्चिताः ।\nभृशंप्रमुदिता नैव तथा यूयं यथा ह्यमी ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003616047, "chapter_id": 23616, "verse_number": "१-२-३-४८", "content_sanskrit": "पितर ऊचुः ।\nभद्रं ते पितरः पुण्याः सुभद्रस्य महामुनेः ।\nतर्पितास्तेन मुनिना महीसागरसंगमे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003616048, "chapter_id": 23616, "verse_number": "१-२-३-४९", "content_sanskrit": "सर्वतीर्थमयी यत्र निलीना ह्युदधौ मही ।\nतत्र दर्शे तर्पयति सुभद्रस्तानमून्सुत ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003616049, "chapter_id": 23616, "verse_number": "१-२-३-५०", "content_sanskrit": "इत्याकर्ण्य वचस्तेषां लज्जितोऽहं भृशंतदा ।\nविस्मितश्च प्रणम्यैतान्पितॄन्स्वं स्थानमागतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003616050, "chapter_id": 23616, "verse_number": "१-२-३-५१", "content_sanskrit": "यथा तथा चिंतितं च तत्र यास्याम्यहं श्फुटम् ।\nपुण्यो यत्रापि विख्यातो महीसागरसंगमः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003616051, "chapter_id": 23616, "verse_number": "१-२-३-५२", "content_sanskrit": "कृताश्रमश्च तत्रैव तर्पयिष्ये निजान्पितॄन् ।\nदर्शेदर्शे यथा चासौ स्तुत्यनामा सुभद्रकः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003616052, "chapter_id": 23616, "verse_number": "१-२-३-५३", "content_sanskrit": "किं तेन ननु जातेन कुलांगारेण पापिना ।\nयस्मिञ्जीवत्यवि निजाः पितरोऽन्यस्पृहाकराः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003616053, "chapter_id": 23616, "verse_number": "१-२-३-५४", "content_sanskrit": "इति संचिंत्य मुदितो रुचिं भार्यामथाब्रवुम् ।\nरुचे त्वया समायुक्तो महीसागगरसंगमम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003616054, "chapter_id": 23616, "verse_number": "१-२-३-५५", "content_sanskrit": "गत्वा स्थास्यामि तत्रैव शीघ्रं त्वं सम्मुखीभव ।\nपतिव्रतासि शुद्धासिकुलीनासि यशस्विनि ।\nतस्मादेतन्मम शुभे कर्तुमर्हसि चिंतितम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003616055, "chapter_id": 23616, "verse_number": "१-२-३-५६", "content_sanskrit": "रुचिरुवाच ।\nहता तस्य जनिर्नाभूत्कथं पाप दुरात्मना ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003616056, "chapter_id": 23616, "verse_number": "१-२-३-५७", "content_sanskrit": "श्मशानस्तंभ येनाहं दत्ता तुभ्यं कृतंत्वाय ।\nइह कंदफलाहारैर्यत्किं तेन न पूर्यते ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003616057, "chapter_id": 23616, "verse_number": "१-२-३-५८", "content_sanskrit": "नेतुमिच्छसि मां तत्र यत्र क्षारोदकं सदा ।\nत्वमेव तत्र संयाहि नंदंतु तव पूर्वजाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003616058, "chapter_id": 23616, "verse_number": "१-२-३-५९", "content_sanskrit": "गच्छ वा तिष्ठ वा वृद्ध वस वा काकवच्चिरम् ।\nतथा ब्रुवन्त्यां तस्यां तु कर्णावस्मि पिधाय च ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003616059, "chapter_id": 23616, "verse_number": "१-२-३-६०", "content_sanskrit": "विपुलं शिष्यमादिश्य गृह एकोऽत्र आगतः ।\nसोऽहं स्नात्वात्र संतर्प्य पितॄञ्छ्रद्धापरायणः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003616060, "chapter_id": 23616, "verse_number": "१-२-३-६१", "content_sanskrit": "चिंतां सुविपुलां प्राप्तो नरके दुष्कृती यथा ।\nयदि तिष्ठामि चात्रैव अर्धदेहधरो ह्यहम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003616061, "chapter_id": 23616, "verse_number": "१-२-३-६२", "content_sanskrit": "नरो हि गृहिणीहीनो अर्धदेह इति स्मृतः ।\nयथात्मना विना देहे कार्यं किंचिन्न सिध्यति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003616062, "chapter_id": 23616, "verse_number": "१-२-३-६३", "content_sanskrit": "अनयोर्हि फलं ग्राह्यं सारता नात्र काचन ।\nअर्धदेही च मनुजस्त्वसंस्पृश्यः सतांमतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003616063, "chapter_id": 23616, "verse_number": "१-२-३-६४", "content_sanskrit": "अनयोर्हिफलं ग्राह्यं सारता नात्र काचन ।\nअर्धदेही च मनुजस्त्वसंस्पृश्यः सतांमतः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003616064, "chapter_id": 23616, "verse_number": "१-२-३-६५", "content_sanskrit": "औत्तानपादिरस्पृश्य उत्तमो हि सुरैः कृतः ।\nअथ चेत्तत्र संयामि न महीसागरस्ततः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003616065, "chapter_id": 23616, "verse_number": "१-२-३-६६", "content_sanskrit": "यामि वा तत्कथं पादौ चलतो मे कथंचन ।\nएतस्मिन्मे मनो विद्धं खिद्यतेऽज्ञानसंकटे ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003616066, "chapter_id": 23616, "verse_number": "१-२-३-६७", "content_sanskrit": "अतोऽहमतिमुह्यामि भृशं शोचामि रोदिमि ।\nइतिश्रुत्वा वचस्तस्य भृशं रोमांचपूरितम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003616067, "chapter_id": 23616, "verse_number": "१-२-३-६८", "content_sanskrit": "साधुसाध्वित्यथोवाच तं सुभद्रोऽप्यहं तथा ।\nदण्डवच्च प्रणमितो महीसागरसङ्गमम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003616068, "chapter_id": 23616, "verse_number": "१-२-३-६९", "content_sanskrit": "चिन्तयावश्च मनसि प्रतीकारं मुनेरुभौ ।\nयो हि मानुष्यमासाद्य जलबुद्बुदभंगुरम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003616069, "chapter_id": 23616, "verse_number": "१-२-३-७०", "content_sanskrit": "परार्थाय भवत्येष पुरुषोऽन्ये पुरीषकाः ।\nततः संचिंत्य प्राहेदं सुभद्रो मुनिसत्तमम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003616070, "chapter_id": 23616, "verse_number": "१-२-३-७१", "content_sanskrit": "मा मुने परिखिद्यस्व देवशर्मन्स्थिरो भव ।\nअहं ते नाशयिष्यामि शोकं सूर्यस्तमो यथा ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003616071, "chapter_id": 23616, "verse_number": "१-२-३-७२", "content_sanskrit": "गमिष्याम्याश्रमं त्वं च नात्रापि परिहास्यते ।\nश्रृणु तत्कारणं तुभ्यं तर्पयिष्ये पितॄनहम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003616072, "chapter_id": 23616, "verse_number": "१-२-३-७३", "content_sanskrit": "देवशर्मोवाच ।\nएवं ते वदमानस्य आयुरस्तु शतं समाः ।\nयदशक्यं महत्कर्म कर्तुमिच्छसि मत्कृते ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003616073, "chapter_id": 23616, "verse_number": "१-२-३-७४", "content_sanskrit": "हर्षस्थाने विषादश्च पुनर्मां बाधते श्रृणु ।\nअपि वाक्यं शुभं सन्तो न गृह्णन्ति मुधा मुने ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003616074, "chapter_id": 23616, "verse_number": "१-२-३-७५", "content_sanskrit": "कथमेतन्महत्कर्म कारयामि मुधावद ।\nपुनः किंचित्प्रवक्ष्यामि यथा मे निष्कृतिर्भवेत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003616075, "chapter_id": 23616, "verse_number": "१-२-३-७६", "content_sanskrit": "शापितोऽसि मया प्राणैर्यथा वच्मि तथा कुरु ।\nअहं सदा करिष्यामि दर्शे चोद्दिश्यते पितॄन् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003616076, "chapter_id": 23616, "verse_number": "१-२-३-७७", "content_sanskrit": "श्राद्धं गंगार्णवे चात्र मत्पितॄणां त्वमाचर ।\nअहं चैवापि तपसः संचितस्यापि जन्मना ।\nचतुर्भागं प्रदास्यामि एवमेवैतदाचर ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003616077, "chapter_id": 23616, "verse_number": "१-२-३-७८", "content_sanskrit": "सुभद्र उवाच ।\nयद्येवं तव संतोषस्त्वेवमस्तु मुनीश्वर ।\nसाधूनां च यथा हर्षस्तथा कार्यं विजानता ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003616078, "chapter_id": 23616, "verse_number": "१-२-३-७९", "content_sanskrit": "भृगुरुवाच ।\nदेवशर्मा ततो हृष्टो दत्त्वा पुण्यं त्रिवाचिकम् ।\nचतुर्थाशं ययौ धाम स्वं सुभद्रोऽपि च स्थितः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003616079, "chapter_id": 23616, "verse_number": "१-२-३-८०", "content_sanskrit": "एवंविधो नारदासौ मही सागरसंगमः ।\nयमनुस्मरतो मह्यं रोमांचोऽद्यापि वर्तते ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003616080, "chapter_id": 23616, "verse_number": "१-२-३-८१", "content_sanskrit": "नारद उवाच ।\nइति श्रुत्वा फाल्गुनाहं हर्षगद्गदया गिरा ।\nमृतोमृत इवा वोचं साधुसाध्विति तंभृगुम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003616081, "chapter_id": 23616, "verse_number": "१-२-३-८२", "content_sanskrit": "यूयं वयं गमिष्यामो महीतीरं सुशोभनम् ।\nआवामीक्षावहे सर्वं स्थानकं तदनुत्तमम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003616082, "chapter_id": 23616, "verse_number": "१-२-३-८३", "content_sanskrit": "मम चैवं वचः श्रुत्वा भृगुः सह मयययौ ।\nसमस्तं तु महापुण्यं महीकूलं निरीक्षितम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003616083, "chapter_id": 23616, "verse_number": "१-२-३-८४", "content_sanskrit": "तद्दृष्ट्वा चातिहृष्टोहमासं रोमांचकंचुकः ।\nअब्रवं मुनिशार्दूलं हर्षगद्गदया गिरा ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003616084, "chapter_id": 23616, "verse_number": "१-२-३-८५", "content_sanskrit": "त्वत्प्रसादात्करिष्यामि भृगो स्थानमनुत्तमम् ।\nस्वस्थानं गम्यतां ब्रह्मन्नतः कृत्यं विचिंतये ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003616085, "chapter_id": 23616, "verse_number": "१-२-३-८६", "content_sanskrit": "एवं भृगुं चास्मिविसर्जयित्वा कल्लोलकोलाहलकौतुकीतटे ।\nअथोपविश्येदमचिंतयं तदा किं कृत्यमात्मानमिवैकयोगी ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]