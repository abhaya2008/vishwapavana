[{"id": 2205172, "chapter_id": 5371, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2205173, "chapter_id": 5371, "verse_number": "", "content_sanskrit": "भगवन् देवदेवेश विशिष्टं यज्ञमुच्यते ।\nलौकिकं वैदिकं चैव तन्मे शंसितुमर्हसि\t॥१", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2205174, "chapter_id": 5371, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2205175, "chapter_id": 5371, "verse_number": "२", "content_sanskrit": "देवतानां तु पूजा या यज्ञेष्वेव समाहिता ।\nयज्ञा वेदेष्वधीनाश्च वेदा ब्राह्मणसंयुताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2205176, "chapter_id": 5371, "verse_number": "३", "content_sanskrit": "इदं तु सकलं दिव्यं दिवि वा भुवि वा प्रिये ।\nयज्ञार्थं विद्धि तत् सृष्टं लोकानां हितकाम्यया\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2205177, "chapter_id": 5371, "verse_number": "४", "content_sanskrit": "एवं विज्ञाय तत्कर्ता सदारः सततं द्विजः ।\nप्रेत्यभावे लभेल्लोकान् ब्रह्मकर्मसमाधिना\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2205178, "chapter_id": 5371, "verse_number": "५", "content_sanskrit": "ब्राह्मणेष्वपि तद् ब्रह्म नित्यं देवि समाहितम् ।\nतस्माद् विप्रैर्यथाशास्त्रं विधिदृष्टेन कर्मणा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2205179, "chapter_id": 5371, "verse_number": "६", "content_sanskrit": "यज्ञकर्म कृतं सर्वं देवता अभितर्पयेत् ।\nब्राह्मणाः क्षत्रियाश्चैव यज्ञार्हाः प्रायशः स्मृताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2205180, "chapter_id": 5371, "verse_number": "७", "content_sanskrit": "अग्निष्टोमादिभिर्यज्ञैर्वेदेषु परिकल्पितैः ।\nसुशुद्धैर्यजमानैश्च ऋत्विग्भिश्च यथाविधि ।\nशुद्धैर्द्रव्योपकरणैर्यष्टव्यमिति निश्चयः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2205181, "chapter_id": 5371, "verse_number": "८", "content_sanskrit": "तथा कृतेषु यज्ञेषु देवानां तोषणं भवेत् ।\nतुष्टेषु देवसङ्घेषु यज्वा यज्ञफलं लभेत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2205182, "chapter_id": 5371, "verse_number": "९", "content_sanskrit": "देवाः सन्तोषिता यज्ञैर्लोकान् संवर्धयन्त्युत ।\nउभयोर्लोकयोर्भूतिर्देवि यज्ञैः प्रदृश्यते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2205183, "chapter_id": 5371, "verse_number": "१०", "content_sanskrit": "तस्माद् यज्वा दिवं गत्वा अमरैः सह मोदते ।\nनास्ति यज्ञसमं दानं नास्ति यज्ञसमो निधिः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2205184, "chapter_id": 5371, "verse_number": "११", "content_sanskrit": "सर्वधर्मसमुद्देशो देवि यज्ञे समाहितः ।\nएषा यज्ञकृता पूजा लौकिकीमपरां शृणु\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2205185, "chapter_id": 5371, "verse_number": "१२", "content_sanskrit": "देवसत्कारमुद्दिश्य क्रियते लौकिकोत्सवाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2205186, "chapter_id": 5371, "verse_number": "१३", "content_sanskrit": "देवगोष्ठान् हि संस्कृत्य चोत्सवं यः करोति वै ।\nयागान् देवोपहारांश्च शुचिर्भूत्वा यथाविधि ।\nदेवान् सन्तोषयित्वा स देवि धर्ममवाप्नुयात्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2205187, "chapter_id": 5371, "verse_number": "१४", "content_sanskrit": "गन्धमाल्यैश्च विविधैः परमान्नेन धूपनैः ।\nबहुभिः स्तुतिभिश्चैव स्तुवन्तः प्रयता नराः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2205188, "chapter_id": 5371, "verse_number": "१५", "content_sanskrit": "नृत्तैर्वाद्यैश्च गान्धर्वैरन्यैर्दृष्टिविलोभनैः ।\nदेवसत्कारमुद्दिश्य कुर्वते ये नरा भुवि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2205189, "chapter_id": 5371, "verse_number": "१६", "content_sanskrit": "तेषां भक्तिकृतेनैव सत्कारेणाभिपूजिताः ।\nतथैव तोषं संयान्ति देवि देवास्त्रिविष्टपे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2205190, "chapter_id": 5371, "verse_number": "१७", "content_sanskrit": "मानुषैरपरैर्वापि शुचिभिस्तत्परायणैः ।\nब्रह्मचर्यपरैरेतत्कृतं धर्मफलं लभेत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2205191, "chapter_id": 5371, "verse_number": "१८", "content_sanskrit": "केवलैः स्तुतिभिर्देवि गन्धमाल्यसमायुतैः ।\nप्रयतैः शुद्धगात्रैस्तु शुद्धदेशे सुपूजिताः ।\nसन्तोषं यान्ति वै देवा भक्तैः सम्पूजितास्तथा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2205192, "chapter_id": 5371, "verse_number": "१९", "content_sanskrit": "देवान् सन्तोषयित्वैव देवि धर्ममवाप्नुयात्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2205193, "chapter_id": 5371, "verse_number": "", "content_sanskrit": "उमा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2205194, "chapter_id": 5371, "verse_number": "२०", "content_sanskrit": "त्रिविष्टपस्था वै भूमौ देवा मानुषचेष्टितम् ।\nकथं ज्ञास्यन्ति विधिवत् तन्मे शंसितुमर्हसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2205195, "chapter_id": 5371, "verse_number": "", "content_sanskrit": "महेश्वरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2205196, "chapter_id": 5371, "verse_number": "२१", "content_sanskrit": "तदहं ते प्रवक्ष्यामि यथा तैर्विद्यते प्रिये ।\nप्राणिनां तु शरीरेषु अन्तरात्मा व्यवस्थितः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2205197, "chapter_id": 5371, "verse_number": "२२", "content_sanskrit": "आत्मानं परमं देवमिति विद्धि शुभेक्षणे ।\nआत्मा मनोव्यवस्थानात् सर्वं वेत्ति शुभाशुभम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2205198, "chapter_id": 5371, "verse_number": "२३", "content_sanskrit": "आत्मैव देवास्तद् विद्युरव्यग्रमनसः कृतम् ।\nसतां मनोव्यवस्थानाच्छुभं भवति वै नृणाम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2205199, "chapter_id": 5371, "verse_number": "२४", "content_sanskrit": "तस्माद् देवाभिसम्पूजा पितृपूजा तथैव च ।\nयज्ञाश्च धर्मकार्याणि गुरुपूजाश्च शोभने\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2205200, "chapter_id": 5371, "verse_number": "२५", "content_sanskrit": "शुद्धगात्रैर्वृत्तयुक्तैस्तन्मयैस्तत्परायणैः ।\nएवं व्यवस्थितैर्नित्यं कर्तव्यमिति निश्चयः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2205201, "chapter_id": 5371, "verse_number": "२६", "content_sanskrit": "एवं कृत्वा शुभाकाङ्क्षी परत्रेह च मोदते ।\nअन्यथा मन आवेश्य कृतं न फलति प्रिये ।\nऋतेऽपि तु मनो देवि अशुभं फलति ध्रुवम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2205202, "chapter_id": 5371, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे लौकिकवैदिककर्मफलवर्णनं नाम द्वाविंशत्युत्तरद्विशततमोऽध्यायः ॥२२२॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]