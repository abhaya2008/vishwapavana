[{"id": 5000602000, "chapter_id": 9602, "verse_number": "७-६७-१", "content_sanskrit": "अथ रात्र्यां प्रवृत्तायां शत्रुघ्नो भृगुनन्दनम् ।\nपप्रच्छ च्यवनं विप्रं लवणस्य यथा बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000602001, "chapter_id": 9602, "verse_number": "७-६७-२", "content_sanskrit": "शूलस्य च बलं ब्रह्मन्के च पूर्वं विनाशिताः ।\nअनेन शूलमुख्येन द्वन्द्वयुद्धमुपागताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000602002, "chapter_id": 9602, "verse_number": "७-६७-३", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा शत्रुघ्नस्य महात्मनः ।\nप्रत्युवाच महातेजाश्च्यवनो रघुनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000602003, "chapter_id": 9602, "verse_number": "७-६७-४", "content_sanskrit": "असङ्ख्येयानि कर्माणि यान्यस्य रघुनन्दन ।\nइक्ष्वाकुवंशप्रभवे यद्वृत्तं तच्छृणष्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000602004, "chapter_id": 9602, "verse_number": "७-६७-५", "content_sanskrit": "अयोध्यायां पुरा राजा युवनाश्वसुतो बली ।\nमान्धातेति स विख्यातस्त्रिषु लोकेषु वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000602005, "chapter_id": 9602, "verse_number": "७-६७-६", "content_sanskrit": "स कृत्वा पृथिवीं कृत्स्नां शासने पृथिवीपतिः ।\nसुरलोकमितो जेतुमुद्योगमकरोन्नृपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000602006, "chapter_id": 9602, "verse_number": "७-६७-७", "content_sanskrit": "इन्द्रस्य च भयं तीव्रं सुराणां च महात्मनाम् ।\nमान्धातरि कृतोद्योगे देवलोकजिगीषया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000602007, "chapter_id": 9602, "verse_number": "७-६७-८", "content_sanskrit": "अर्धासनेन शक्रस्य राज्यार्धेन च पार्थिवः ।\nवन्द्यमानः सुरगणैः प्रतिज्ञामध्यरोहत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000602008, "chapter_id": 9602, "verse_number": "७-६७-९", "content_sanskrit": "तस्य पापमभिप्रायं विदित्वा पाकशासनः ।\nसान्त्वपूर्वमिदं वाक्यमुवाच युवनाश्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000602009, "chapter_id": 9602, "verse_number": "७-६७-१०", "content_sanskrit": "राजा त्वं मानुषे लोके न तावत्पुरुषर्षभ ।\nअकृत्वा पृथिवीं वश्यां देवराज्यमिहेच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000602010, "chapter_id": 9602, "verse_number": "७-६७-११", "content_sanskrit": "यदि वीर समग्रा ते मेदिनी निखिला वशे ।\nदेवराज्यं कुरुष्वेह सभृत्यबलवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000602011, "chapter_id": 9602, "verse_number": "७-६७-१२", "content_sanskrit": "इन्द्रमेवं ब्रुवाणं तं मान्धाता वाक्यमब्रवीत् ।\nक्व मे शक्र प्रतिहतं शासनं पृथिवीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000602012, "chapter_id": 9602, "verse_number": "७-६७-१३", "content_sanskrit": "तमुवाच सहस्राक्षो लवणो नाम राक्षसः ।\nमधुपुत्रो मधुवने न ते ऽ ऽज्ञां कुरुते ऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000602013, "chapter_id": 9602, "verse_number": "७-६७-१४", "content_sanskrit": "तच्छ्रुत्वा विप्रियं घोरं सहस्राक्षेण भाषितम् ।\nव्रीडितो ऽवाङ्मुखो राजा व्याहर्तुं न शशाक ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000602014, "chapter_id": 9602, "verse_number": "७-६७-१५", "content_sanskrit": "आमन्त्र्य तु सहस्राक्षं ह्रिया किञ्चिदवाङ्मुखः ।\nपुनरेवागमच्छ्रीमानिमं लोकं नरेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000602015, "chapter_id": 9602, "verse_number": "७-६७-१६", "content_sanskrit": "स कृत्वा हृदये ऽमर्षं सभृत्यबलवाहनः ।\nआजगाम मधोः पुत्रं वशे कर्तुमरिन्दमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000602016, "chapter_id": 9602, "verse_number": "७-६७-१७", "content_sanskrit": "स काङ्क्षमाणो लवणं युद्धाय पुरुषर्षभः ।\nदूतं सम्प्रेषयामास सकाशं लवणस्य हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000602017, "chapter_id": 9602, "verse_number": "७-६७-१८", "content_sanskrit": "स गत्वा विप्रियाण्याह बहूनि मधुनः सुतम् ।\nवदन्तमेवं तं दूतं भक्षयामास राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000602018, "chapter_id": 9602, "verse_number": "७-६७-१९", "content_sanskrit": "चिरायमाणे दूते तु राजा क्रोधसमन्वितः ।\nअर्दयामास तद्रक्षः शरवृष्ट्या समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000602019, "chapter_id": 9602, "verse_number": "७-६७-२०", "content_sanskrit": "ततः प्रहस्य तद्रक्षः शूलं जग्राह पाणिना ।\nवधाय सानुबन्धस्य मुमोचायुधमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000602020, "chapter_id": 9602, "verse_number": "७-६७-२१", "content_sanskrit": "तच्छूलं दीप्यमानं तु सभृत्यबलवाहनम् ।\nभस्मीकृत्वा नृपं भूयो लवणस्यागमत्करम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000602021, "chapter_id": 9602, "verse_number": "७-६७-२२", "content_sanskrit": "एवं स राजा सुमहान्हतः सबलवाहनः ।\nशूलस्य तु बलं सौम्य अप्रमेयमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000602022, "chapter_id": 9602, "verse_number": "७-६७-२३", "content_sanskrit": "श्वः प्रभाते तु लवणं वधिष्यसि न संशयः ।\nअगृहीतायुधं क्षिप्रं ध्रुवो हि विजयस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000602023, "chapter_id": 9602, "verse_number": "७-६७-२४", "content_sanskrit": "लोकानां स्वस्ति चैव स्यात्कृते कर्मणि च त्वया ।\nएतत्ते सर्वमाख्यातं लवणस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000602024, "chapter_id": 9602, "verse_number": "७-६७-२५", "content_sanskrit": "शूलस्य च बलं घोरमप्रमेयं नरर्षभ ।\nविनाशश्चैव मान्धातुर्यत्तेनाभूच्च पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000602025, "chapter_id": 9602, "verse_number": "७-६७-२६", "content_sanskrit": "त्वं श्वः प्रभाते लवणं महात्मन्वधिष्यसे नात्र तु संशयो मे ।\nशूलं विना निर्गतमामिषार्थे ध्रुवो जयस्ते भविता नरेन्द्र ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000602026, "chapter_id": 9602, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे सप्तषष्टितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]