[{"id": 2052560, "chapter_id": 2163, "verse_number": "७-९०-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2052561, "chapter_id": 2163, "verse_number": "७-९०-१", "content_sanskrit": "तस्मिन्प्रभग्ने सैन्याग्रे वध्यमाने किरीटिना।\nकेतु तत्र रणे वीराः प्रत्युदीयुर्धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2052562, "chapter_id": 2163, "verse_number": "७-९०-२", "content_sanskrit": "आहोस्विच्छकटव्यूहं प्रविष्टा मोघनिश्चयाः॥\nद्रोणमाश्रित्य तिष्ठन्ति प्राकारमकुतोभयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2052563, "chapter_id": 2163, "verse_number": "७-९०-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2052564, "chapter_id": 2163, "verse_number": "७-९०-३", "content_sanskrit": "तथाऽर्जुनेन सम्भग्ने तस्मिंस्तव बलेऽनघ।\nहतवीरे हतोत्साहे पलायनकृतक्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2052565, "chapter_id": 2163, "verse_number": "७-९०-४", "content_sanskrit": "पाकशासनिनाऽभीक्ष्णं वध्यमाने शरोत्तमैः।\nन तत्र कश्चित्सङ्ग्रामे शशाकार्जुनमीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2052566, "chapter_id": 2163, "verse_number": "७-९०-५", "content_sanskrit": "ततस्तव सुतो राजन्दृष्ट्वा सैन्यं तथागतम्।\nदुःशासनो भृशं क्रुद्धो युद्धायार्जुनमभ्यगात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2052567, "chapter_id": 2163, "verse_number": "७-९०-६", "content_sanskrit": "सकाञ्चनविचित्रेण कवचेन समावृतः।\nजाम्बूनदशिरस्त्राणः शूरस्तीव्रपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2052568, "chapter_id": 2163, "verse_number": "७-९०-७", "content_sanskrit": "नागानीकेन महता ग्रसन्निव महीमिमाम्।\nदुःशासनो महाराज सव्यसाचिनमावृणोत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2052569, "chapter_id": 2163, "verse_number": "७-९०-८", "content_sanskrit": "हादेन गजघण्टानां शङ्खानां निनदेन च।\nज्याक्षेपनिनदैश्चैव विरावेण च दन्तिनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2052570, "chapter_id": 2163, "verse_number": "७-९०-९", "content_sanskrit": "भूर्दिशश्चान्तरिक्षं च शब्देनासीत्समावृतम्।\n`युवराजो बलश्लाघी पिङ्गलः प्रियदर्शनः।\nस मुहूर्तं प्रतिभयो दारुणः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2052571, "chapter_id": 2163, "verse_number": "७-९०-१०", "content_sanskrit": "तान्दृष्ट्वा पततस्तूर्णमङ्कुशैरभिचोदितान्।\nव्यालम्बहस्तान्संरब्धान्सपक्षानिव पर्वतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2052572, "chapter_id": 2163, "verse_number": "७-९०-११", "content_sanskrit": "सिंहनादेन महता नरसिंहो धनञ्जयः।\n`तदाचलघनप्रख्यं पताकाशतसङ्कुलम्।\nगजानीकममित्राणामभितो व्यधमच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2052573, "chapter_id": 2163, "verse_number": "७-९०-१२", "content_sanskrit": "महोर्मिणमिवोद्धूतं श्वसनेन महार्णवम्।\nकिरीटी तद्गजानीकं प्राविशन्मकरो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2052574, "chapter_id": 2163, "verse_number": "७-९०-१३", "content_sanskrit": "खमाश्रित इवादित्यः प्रतपन्स युगक्षये।\nददृशे दिक्षु सर्वासु पार्थः परपुरञ्जनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2052575, "chapter_id": 2163, "verse_number": "७-९०-१४", "content_sanskrit": "खुरशब्देन चाश्वानां नेमिघोषेण तेन च।\nतेन चोत्क्रुष्टशब्देन ज्यानिनादेन तेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2052576, "chapter_id": 2163, "verse_number": "७-९०-१५", "content_sanskrit": "नानावादित्रशब्देन पाञ्चजन्यस्वनेन च।\nदेवदत्तस्य घोषेण गाण्डीवनिनदेन च।\nमन्दवेगा नरा नागा बभूवुस्ते विचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2052577, "chapter_id": 2163, "verse_number": "७-९०-१६", "content_sanskrit": "शरैराशीविषस्पर्शैर्निर्भिन्नाः सव्यसाचिना।\nते गजाः समसीदन्त मग्नाः पङ्कार्णवेष्विव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2052578, "chapter_id": 2163, "verse_number": "७-९०-१७", "content_sanskrit": "युगपच्च समाविष्टैः शरैर्गाण्डीवधन्वनः।\nअनेकशतसाहस्रैर्द्रुमा मधुकरैरिव।\n`पुङ्खावशिष्टैर्बहुभिः शोणितोत्पीडवाहिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2052579, "chapter_id": 2163, "verse_number": "७-९०-१८", "content_sanskrit": "आरावं परमं कृत्वा वध्यमानाः किरीटिना।\nनिपेतुरनिशं भूमौ छिन्नपक्षा इवाद्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2052580, "chapter_id": 2163, "verse_number": "७-९०-१९", "content_sanskrit": "अपरे दन्तवेष्टेषु कुम्भेषु च कटेषु च।\nशरैः समर्पिता नागाः क्रौञ्चवद्व्यनदन्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2052581, "chapter_id": 2163, "verse_number": "७-९०-२०", "content_sanskrit": "गजस्कन्धगतानां च पुरुषाणां किरीटिना।\nछिद्यन्ते चोत्तमाङ्गानि भुल्लैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2052582, "chapter_id": 2163, "verse_number": "७-९०-२१", "content_sanskrit": "सकुण्डलानां पततां शिरसां धरणीतले।\nपद्मानामिव सङ्घातैः पार्थश्चक्रे निवेदनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2052583, "chapter_id": 2163, "verse_number": "७-९०-२२", "content_sanskrit": "यन्त्रबद्धा विकवचा व्रणार्ता रुधिरोक्षिताः।\nभ्रमत्सु युधि नागेषु मनुष्या विललम्बिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2052584, "chapter_id": 2163, "verse_number": "७-९०-२३", "content_sanskrit": "केचिदेकेन बाणेन सुयुक्तेन सुपत्रिणा।\nद्वौ त्रयश्च विनिर्भिन्ना निपेतुर्धरणीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2052585, "chapter_id": 2163, "verse_number": "७-९०-२४", "content_sanskrit": "अपरे मदसंरब्धा मातङ्गाः पर्वतोपमाः।\nसारोहा न्यपतन्भूमौ द्रुमवन्त इवाचलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2052586, "chapter_id": 2163, "verse_number": "७-९०-२५", "content_sanskrit": "मौर्वी ध्वजं धनुश्चैव युगमीषां तथैव च।\nरथिनां कुट्टयामास भल्लैः सन्नतपर्वभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2052587, "chapter_id": 2163, "verse_number": "७-९०-२६", "content_sanskrit": "न सन्दधन्न चाकर्षन्न विमुञ्चन्न चोद्वहन्।\nमण्डलेनैव धनुषा नृत्यन्पार्थः स्म दृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2052588, "chapter_id": 2163, "verse_number": "७-९०-२७", "content_sanskrit": "अतिविद्धाश्च नाराचैर्वमन्तो रुधिरं मुखैः।\nमुहूर्तान्न्यपतन्नन्ये वारणा वसुधातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2052589, "chapter_id": 2163, "verse_number": "७-९०-२८", "content_sanskrit": "उत्थितान्यगणेयानि कबन्धानि समन्ततः।\nअदृश्यन्त महाराज तस्मिन्परमसङ्कुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2052590, "chapter_id": 2163, "verse_number": "७-९०-२९", "content_sanskrit": "सचापाः साङ्गुलित्राणाः सखङ्गाः साङ्गदा रणे।\nअदृश्यन्त भुजाश्छिन्ना हेमाभरणभूषिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2052591, "chapter_id": 2163, "verse_number": "७-९०-३०", "content_sanskrit": "सूपस्करैरधिष्ठानैरीषादण्डकबन्धुरैः।\nचक्रैर्विमथितैरक्षैर्भग्नैश्च बहुधा युगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2052592, "chapter_id": 2163, "verse_number": "७-९०-३१", "content_sanskrit": "चर्मचापधरैश्चैव व्यवकीर्णैस्ततस्ततः।\nस्रग्भिराभरणैर्वस्त्रैः पतितैश्च महाध्वजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2052593, "chapter_id": 2163, "verse_number": "७-९०-३२", "content_sanskrit": "निहतैर्वारणैरश्वैः क्षत्रियैश्च निपातितैः।\nअदृश्यत मही तत्र दारुणप्रतिदर्शना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2052594, "chapter_id": 2163, "verse_number": "७-९०-३३", "content_sanskrit": "एवं दुःशासनबलं वध्यमानं किरीटिना।\nसम्प्राद्रवन्महाराज व्यथितं सहनायकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2052595, "chapter_id": 2163, "verse_number": "७-९०-३४", "content_sanskrit": "`एवं बले द्रुते याते राजपुत्रं महारथम्।\nविव्याध दशभिर्बाणैस्तिष्ठतिष्ठेति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2052596, "chapter_id": 2163, "verse_number": "७-९०-३५", "content_sanskrit": "जीवितेन कथं गन्ता दुरुक्तं यावदद्य ते।\nतद्वाक्यसदृशं कर्म कुरु त्वं यदि मन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2052597, "chapter_id": 2163, "verse_number": "७-९०-३६", "content_sanskrit": "एवमुक्त्वा ततो राजा पार्थः पार्थिवमर्दनः।\nभृशं क्रुद्धो महाराज अविध्यत्तनयं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2052598, "chapter_id": 2163, "verse_number": "७-९०-३७", "content_sanskrit": "ततो दुःशासनस्त्रस्तः सहानीकः शरार्दितः।\nद्रोणं त्रातारमाकाङ्क्षञ्शकटव्यूहमभ्यगात्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2052599, "chapter_id": 2163, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे नवतितमोऽध्यायः॥ ९० ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-९०-३ पलायने कृतः क्षणोऽवसरो येन॥ ५-९०-९ प्रतिभयो भयङ्करः। दारुणः क्रूरः॥ ५-९०-१९ दन्तवेष्टेषु दन्तमूलेषु। कटेषु कटिषु॥ ५-९०-२१ निवेदनमुपाहारम्॥ ५-९०-२२ यन्त्रबद्धा यन्त्रैरालिखिताः॥ ५-९०-९० नवतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]