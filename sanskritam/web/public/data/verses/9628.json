[{"id": 5000628000, "chapter_id": 9628, "verse_number": "७-९३-१", "content_sanskrit": "वर्तमाने तथाभूते यज्ञे च परमाद्भुते ।\nसशिष्य आजगामाशु वाल्मीकिर्मुनिपुङ्गवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000628001, "chapter_id": 9628, "verse_number": "७-९३-२", "content_sanskrit": "स दृष्ट्वा दिव्यसङ्काशं यज्ञमद्भुतदर्शनम् ।\nएकान्ते ऋषिवाटानां चकार उटजाञ्छुभान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000628002, "chapter_id": 9628, "verse_number": "७-९३-३", "content_sanskrit": "शकटांश्च बहून्पूर्णान्फलमूलैश्च शोभनान् ।\nवाल्मीकिवाटे रुचिरे स्थापयन्नविदूरतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000628003, "chapter_id": 9628, "verse_number": "७-९३-४", "content_sanskrit": "आसीत्सुपूजितो राज्ञा मुनिभिश्च महात्मभिः ।\nवाल्मीकिः सुमहातेजा न्यवसत्परमात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000628004, "chapter_id": 9628, "verse_number": "७-९३-५", "content_sanskrit": "स शिष्यावब्रवीद्धृष्टौ युवां गत्वा समाहितौ ।\nकृत्स्नं रामायणं काव्यं गायेथां परया मुदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000628005, "chapter_id": 9628, "verse_number": "७-९३-६", "content_sanskrit": "ऋषिवाटेषु पुण्येषु ब्राह्मणावसथेषु च ।\nरथ्यासु राजमार्गेषु पार्थिवानां गृहेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000628006, "chapter_id": 9628, "verse_number": "७-९३-७", "content_sanskrit": "रामस्य भवनद्वारि यत्र कर्म च कुर्वते ।\nऋत्विजामग्रतश्चैव तत्र गेयं विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000628007, "chapter_id": 9628, "verse_number": "७-९३-८", "content_sanskrit": "इमानि च फलान्यत्र स्वादूनि विविधानि च ।\nजातानि पर्वताग्रेषु चास्वाद्यास्वाद्य गायताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000628008, "chapter_id": 9628, "verse_number": "७-९३-९", "content_sanskrit": "न यास्यथः श्रमं वत्सौ भक्षयित्वा फलानि वै ।\nमूलानि च सुमृष्टानि नगराद्बहिरास्यथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000628009, "chapter_id": 9628, "verse_number": "७-९३-१०", "content_sanskrit": "यदि शब्दापयेद्रामः श्रवणाय महीपतिः ।\nऋषीणामुपविष्टानां ततो गेयं प्रवर्तताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000628010, "chapter_id": 9628, "verse_number": "७-९३-११", "content_sanskrit": "दिवसे विंशतिः सर्गा गेया मधुरया गिरा ।\nप्रमाणैर्बहुभिस्तत्र यथोद्दिष्टा मया पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000628011, "chapter_id": 9628, "verse_number": "७-९३-१२", "content_sanskrit": "लोभश्चापि न कर्तव्यः स्वल्पो ऽपि धनकाङ्क्षया ।\nकिं धनेनाश्रमस्थानां फलमूलोपजीविना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000628012, "chapter_id": 9628, "verse_number": "७-९३-१३", "content_sanskrit": "यदि पृच्छेत्स काकुत्स्थो युवां कस्येति दारकौ ।\nआवां वाल्मीकिशिष्यौ स्वो ब्रूतमेवं नराधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000628013, "chapter_id": 9628, "verse_number": "७-९३-१४", "content_sanskrit": "इमास्तन्त्रीः सुमधुराः स्थानं वा ऽपूर्वदर्शनम् ।\nमूर्च्छयित्वा सुमधुरं गायतां विगतज्वरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000628014, "chapter_id": 9628, "verse_number": "७-९३-१५", "content_sanskrit": "आदिप्रभृति गेयं स्यान्न चावज्ञाय पार्थिवम् ।\nपिता हि सर्वभूतानां राजा भविति धर्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000628015, "chapter_id": 9628, "verse_number": "७-९३-१६", "content_sanskrit": "तद्युवां हृष्टमनसौ श्वः प्रभाते समास्थितौ ।\nगायेथां मधुरं गेयं तन्त्रीलयसमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000628016, "chapter_id": 9628, "verse_number": "७-९३-१७", "content_sanskrit": "इति सन्दिश्य बहुशो मुनिः प्राचेतसस्तदा ।\nवाल्मीकिः परमोदारस्तूष्णीमासीन्महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000628017, "chapter_id": 9628, "verse_number": "७-९३-१८", "content_sanskrit": "सन्दिष्टौ मुनिना तेन तावुभौ मैथिलीसुतौ ।\nतथैव करवावेति निर्जग्मतुररिन्दमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000628018, "chapter_id": 9628, "verse_number": "७-९३-१९", "content_sanskrit": "तामद्भुतां तौ हृदये कुमारौ निवेश्य वाणीमृषिभाषितां तदा ।\nसमुत्सुकौ तौ सममूषतुर्निशां यथा ऽश्विनौ भार्गवनीतिसंहिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000628019, "chapter_id": 9628, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे त्रिनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]