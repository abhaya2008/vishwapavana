[{"id": 7004963000, "chapter_id": 24963, "verse_number": "७-१-१४६-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि धर्मराजप्रतिष्ठितम् ।\nयमेश्वरं महादेवं तस्यै वोत्तरतः स्थितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004963001, "chapter_id": 24963, "verse_number": "७-१-१४६-२", "content_sanskrit": "यदा शप्तो धर्मराजश्छायया वरवर्णिनि ।\nतदा तस्यापतत्पादः स च दुःखान्वितोऽभवत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004963002, "chapter_id": 24963, "verse_number": "७-१-१४६-३", "content_sanskrit": "ततः प्राभासिके क्षेत्रे तपस्तेपे महातपाः ।\nस्थापयामास लिंगं तु तत्र देवस्य शूलिनः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004963003, "chapter_id": 24963, "verse_number": "७-१-१४६-४", "content_sanskrit": "तस्य तुष्टो महादेवस्ततः प्रत्यक्षतां गतः ।\nअब्रवीद्धर्म भद्रं ते वरं वरय चेप्सितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004963004, "chapter_id": 24963, "verse_number": "७-१-१४६-५", "content_sanskrit": "तदाऽब्रवीद्धर्मराजः पादः प्रपतितो मम ।\nप्रसादात्तव देवेश जायतां पुनरेव हि ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004963005, "chapter_id": 24963, "verse_number": "७-१-१४६-६", "content_sanskrit": "एतल्लिंगं सुरश्रेष्ठ यन्मया निर्मितं तव ।\nएतद्ये भक्तिसंयुक्ताः पश्यंति प्राणिनो भुवि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004963006, "chapter_id": 24963, "verse_number": "७-१-१४६-७", "content_sanskrit": "तेषां तव प्रसादेन भूयात्पापविमोक्षणम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004963007, "chapter_id": 24963, "verse_number": "७-१-१४६-८", "content_sanskrit": "एवं भविष्यतीत्युक्ता ह्यन्तर्धानं गतो हरः ।\nयमोऽपि लब्धपादस्तु पुनरेव दिवं ययौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004963008, "chapter_id": 24963, "verse_number": "७-१-१४६-९", "content_sanskrit": "तस्मिन्दृष्टे सुरश्रेष्ठ यमलोकसमुद्भवम् ।\nन भयं विद्यते नृणामपि दुष्कृतकारिणाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004963009, "chapter_id": 24963, "verse_number": "७-१-१४६-१०", "content_sanskrit": "भ्रातृद्वितीयासंयोगे स्नात्वा पुष्करिणीजले ।\nयमेश्वरसमीपस्थो यमेशमवलोकयेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004963010, "chapter_id": 24963, "verse_number": "७-१-१४६-११", "content_sanskrit": "तिलपात्रं प्रदातव्यं दीपं गाः कांचना दिकम् ।\nयमदेवं समुद्दिश्य मुच्यते सर्वपातकैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]