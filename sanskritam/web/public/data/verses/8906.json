[{"id": 40004066, "chapter_id": 8906, "verse_number": "1", "content_sanskrit": "प्रभातायां तु शर्वर्यां पौरास्ते राघवं विना। शोकोपहतनिश्चेष्टा बभूवुर्हतचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40004067, "chapter_id": 8906, "verse_number": "2", "content_sanskrit": "शोकजाश्रुपरिद्यूना वीक्षमाणास्ततस्ततः। आलोकमपि रामस्य न पश्यन्ति स्म दुःखिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40004068, "chapter_id": 8906, "verse_number": "3", "content_sanskrit": "ते विषादार्तवदना रहितास्तेन धीमता। कृपणाः करुणा वाचो वदन्ति स्म मनस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40004069, "chapter_id": 8906, "verse_number": "4", "content_sanskrit": "धिगस्तु खलु निद्रां तां ययाऽपहृतचेतसः। नाद्य पश्यामहे रामं पृथूरस्कं महाभुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40004070, "chapter_id": 8906, "verse_number": "5", "content_sanskrit": "कथं नाम महाबाहु स्स तथावितथक्रियः। भक्तं जनं परित्यज्य प्रवासं राघवो गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40004071, "chapter_id": 8906, "verse_number": "6", "content_sanskrit": "यो नः सदा पालयति पिता पुत्रानिवौरसान्। कथं रघूणां स श्रेष्ठस्त्यक्त्वा नो विपिनं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40004072, "chapter_id": 8906, "verse_number": "7", "content_sanskrit": "इहैव निधनं यामो महाप्रस्थानमेव वा। रामेण रहितानां हि किमर्थं जीवितं हि नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40004073, "chapter_id": 8906, "verse_number": "8", "content_sanskrit": "सन्ति शुष्काणि काष्ठानि प्रभूतानि महान्ति च। तैः प्रज्वाल्य चितां सर्वे प्रविशामोऽथ पावकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40004074, "chapter_id": 8906, "verse_number": "9", "content_sanskrit": "किं वक्ष्यामो महाबाहुरनसूयः प्रियंवदः। नीत स्स राघवोऽस्माभिरिति वक्तुं कथं क्षमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40004075, "chapter_id": 8906, "verse_number": "10", "content_sanskrit": "सा नूनं नगरी दीना दृष्ट्वाऽस्मान् राघवं विना। भविष्यति निरानन्दा सस्त्रीबालवयोधिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40004076, "chapter_id": 8906, "verse_number": "11", "content_sanskrit": "निर्यातास्तेन वीरेण सह नित्यं जितात्मना। विहीनास्तेन च पुनः कथं पश्याम तां पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40004077, "chapter_id": 8906, "verse_number": "12", "content_sanskrit": "इतीव बहुधा वाचो बाहुमुद्यम्य ते जनाः। विलपन्ति स्म दुःखार्ता विवत्सा इव धेनवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40004078, "chapter_id": 8906, "verse_number": "13", "content_sanskrit": "ततो मार्गानुसारेण गत्वा किञ्चित् क्षणं पुनः। मार्गनाशाद्विषादेन महता समभिप्लुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40004079, "chapter_id": 8906, "verse_number": "14", "content_sanskrit": "रथस्य मार्गनाशेन न्यवर्तन्त मनस्विनः। किमिदं किं करिष्यामो दैवेनोपहता इति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40004080, "chapter_id": 8906, "verse_number": "15", "content_sanskrit": "ततो यथागतेनैव मार्गेण क्लान्तचेतसः। अयोध्यामागमन्सर्वे पुरीं व्यथितसज्जनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40004081, "chapter_id": 8906, "verse_number": "16", "content_sanskrit": "आलोक्य नगरीं तां च क्षयव्याकुलमानसाः। आवर्तयन्त तेऽश्रूणि नयनैः शोकपीडितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40004082, "chapter_id": 8906, "verse_number": "17", "content_sanskrit": "एषा रामेण नगरी रहिता नातिशोभते। आपगा गरुडेनेव ह्रदादुद्धृतपन्नगा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40004083, "chapter_id": 8906, "verse_number": "18", "content_sanskrit": "चन्द्रहीनमिवाकाशं तोयहीनमिवार्णवम्। अपश्यन्निहतानन्दं नगरं ते विचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40004084, "chapter_id": 8906, "verse_number": "19", "content_sanskrit": "ते तानि वेश्मानि महाधनानि दुःखेन दुःखोपहता विशन्तः। नैव प्रजज्ञुः स्वजनं जनं वा निरीक्षमाणाः प्रविनष्टहर्षाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]