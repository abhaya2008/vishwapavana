[{"id": 5000197000, "chapter_id": 9197, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे प्रथमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000197001, "chapter_id": 9197, "verse_number": "३-१-१", "content_sanskrit": "प्रविश्य तु महारण्यं दण्डकारण्यमात्मवान्।\nरामो ददर्श दुर्धर्षस्तापसाश्रममण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000197002, "chapter_id": 9197, "verse_number": "३-१-२", "content_sanskrit": "कुशचीरपरिक्षिप्तं ब्राह्म्या लक्ष्म्या समावृतम्।\nयथा प्रदीप्तं दुर्दर्शं गगने सूर्यमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000197003, "chapter_id": 9197, "verse_number": "३-१-३", "content_sanskrit": "शरण्यं सर्वभूतानां सुसम्मृष्टाजिरं सदा।\nमृगैर्बहुभिराकीर्णं पक्षिसंघैः समावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000197004, "chapter_id": 9197, "verse_number": "३-१-४", "content_sanskrit": "पूजितं चोपनृत्तं च नित्यमप्सरसां गणैः।\nविशालैरग्निशरणैः स्रुग्भाण्डैरजिनैः कुशैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000197005, "chapter_id": 9197, "verse_number": "३-१-५", "content_sanskrit": "समिद्भिस्तोयकलशैः फलमूलैश्च शोभितम्।\nआरण्यैश्च महावृक्षैः पुण्यैः स्वादुफलैर्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000197006, "chapter_id": 9197, "verse_number": "३-१-६", "content_sanskrit": "बलिहोमार्चितं पुण्यं ब्रह्मघोषनिनादितम्।\nपुष्पैश्चान्यैः परिक्षिप्तं पद्मिन्या च सपद्मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000197007, "chapter_id": 9197, "verse_number": "३-१-७", "content_sanskrit": "फलमूलाशनैर्दान्तैश्चीरकृष्णाजिनाम्बरैः।\nसूर्यवैश्वानराभैश्च पुराणैर्मुनिभिर्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000197008, "chapter_id": 9197, "verse_number": "३-१-८", "content_sanskrit": "पुण्यैश्च नियताहारैः शोभितं परमर्षिभिः।\nतद् ब्रह्मभवनप्रख्यं ब्रह्मघोषनिनादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000197009, "chapter_id": 9197, "verse_number": "३-१-९", "content_sanskrit": "ब्रह्मविद्भिर्महाभागैर्ब्राह्मणैरुपशोभितम्।\nतद् दृष्ट्वा राघवः श्रीमांस्तापसाश्रममण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000197010, "chapter_id": 9197, "verse_number": "३-१-१०", "content_sanskrit": "अभ्यगच्छन्महातेजा विज्यं कृत्वा महद् धनुः।\nदिव्यज्ञानोपपन्नास्ते रामं दृष्ट्वा महर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000197011, "chapter_id": 9197, "verse_number": "३-१-११", "content_sanskrit": "अभिजग्मुस्तदा प्रीता वैदेहीं च यशस्विनीम्।\nते तु सोममिवोद्यन्तं दृष्ट्वा वै धर्मचारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000197012, "chapter_id": 9197, "verse_number": "३-१-१२", "content_sanskrit": "लक्ष्मणं चैव दृष्ट्वा तु वैदेहीं च यशस्विनीम्।\nमङ्गलानि प्रयुञ्जानाः प्रत्यगृह्णन् दृढव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000197013, "chapter_id": 9197, "verse_number": "३-१-१३", "content_sanskrit": "रूपसंहननं लक्ष्मीं सौकुमार्यं सुवेषताम्।\nददृशुर्विस्मिताकारा रामस्य वनवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000197014, "chapter_id": 9197, "verse_number": "३-१-१४", "content_sanskrit": "वैदेहीं लक्ष्मणं रामं नेत्रैरनिमिषैरिव।\nआश्चर्यभूतान् ददृशुः सर्वे ते वनवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000197015, "chapter_id": 9197, "verse_number": "३-१-१५", "content_sanskrit": "अत्रैनं हि महाभागाः सर्वभूतहिते रताः।\nअतिथिं पर्णशालायां राघवं संन्यवेशयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000197016, "chapter_id": 9197, "verse_number": "३-१-१६", "content_sanskrit": "ततो रामस्य सत्कृत्य विधिना पावकोपमाः।\nआजह्रुस्ते महाभागाः सलिलं धर्मचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000197017, "chapter_id": 9197, "verse_number": "३-१-१७", "content_sanskrit": "मङ्गलानि प्रयुञ्जाना मुदा परमया युताः।\nमूलं पुष्पं फलं सर्वमाश्रमं च महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000197018, "chapter_id": 9197, "verse_number": "३-१-१८", "content_sanskrit": "निवेदयित्वा धर्मज्ञास्ते तु प्राञ्जलयोऽब्रुवन्।\nधर्मपालो जनस्यास्य शरण्यश्च महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000197019, "chapter_id": 9197, "verse_number": "३-१-१९", "content_sanskrit": "पूजनीयश्च मान्यश्च राजा दण्डधरो गुरुः।\nइन्द्रस्यैव चतुर्भागः प्रजा रक्षति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000197020, "chapter_id": 9197, "verse_number": "३-१-२०", "content_sanskrit": "राजा तस्माद् वरान् भोगान् रम्यान् भुङ्‍क्ते नमस्कृतः।\nते वयं भवता रक्ष्या भवद्विषयवासिनः।\nनगरस्थो वनस्थो वा त्वं नो राजा जनेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000197021, "chapter_id": 9197, "verse_number": "३-१-२१", "content_sanskrit": "न्यस्तदण्डा वयं राजञ्जितक्रोधा जितेन्द्रियाः।\nरक्षणीयास्त्वया शश्वद् गर्भभूतास्तपोधनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000197022, "chapter_id": 9197, "verse_number": "३-१-२२", "content_sanskrit": "एवमुक्त्वा फलैर्मूलैः पुष्पैरन्यैश्च राघवम्।\nवन्यैश्च विविधाहारैः सलक्ष्मणमपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000197023, "chapter_id": 9197, "verse_number": "३-१-२३", "content_sanskrit": "तथान्ये तापसाः सिद्धा रामं वैश्वानरोपमाः।\nन्यायवृत्ता यथान्यायं तर्पयामासुरीश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000197024, "chapter_id": 9197, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे प्रथमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]