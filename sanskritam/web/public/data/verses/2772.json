[{"id": 2083148, "chapter_id": 2772, "verse_number": "१२-२७७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2083149, "chapter_id": 2772, "verse_number": "१२-२७७-१", "content_sanskrit": "धर्ममर्थं च कामं च वेदाः शंसन्ति भारत।\nकस्य लाभो विशिष्टोऽत्र तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2083150, "chapter_id": 2772, "verse_number": "१२-२७७-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2083151, "chapter_id": 2772, "verse_number": "१२-२७७-२", "content_sanskrit": "अत्र ते वर्तयिष्यामि इतिहासं पुरातनम्।\nकुण्डधारेण यत्प्रीत्या भक्तायोपकृतं पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2083152, "chapter_id": 2772, "verse_number": "१२-२७७-३", "content_sanskrit": "अधनो ब्राह्मणः कश्चित्कामाद्धनमवैक्षत।\nयज्ञार्थं सततोऽर्थार्थी तपोऽतप्यत दारुणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2083153, "chapter_id": 2772, "verse_number": "१२-२७७-४", "content_sanskrit": "स निश्चयमथो कृत्वा पूजयामास देवताः।\nभक्त्या न चैवाध्यगच्छद्धनं संपूज्य देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2083154, "chapter_id": 2772, "verse_number": "१२-२७७-५", "content_sanskrit": "ततश्चिन्तामनुप्राप्तः कतमद्दैवतं तु तत्।\nयन्मे द्रुतं प्रसीदेत मानुषैरजडीकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2083155, "chapter_id": 2772, "verse_number": "१२-२७७-६", "content_sanskrit": "सोऽथ सौम्येन मनसा देवानुचरमन्तिके।\nप्रत्यपश्यज्जलधरं कुण्डधारमवस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2083156, "chapter_id": 2772, "verse_number": "१२-२७७-७", "content_sanskrit": "दृष्ट्वैव तं महाबाहुं तस्य भक्तिरजायत।\nअयं मे धास्यति श्रेयो वपुरेतद्धि तादृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2083157, "chapter_id": 2772, "verse_number": "१२-२७७-८", "content_sanskrit": "संनिकृष्टश्च देवस्य न चान्यैर्मानुषैर्वृतः।\nएष मे दास्यति धनं प्रभूतं शीघ्रमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2083158, "chapter_id": 2772, "verse_number": "१२-२७७-९", "content_sanskrit": "ततो धूपैश्च गन्धैश्च माल्यैरुच्चावचैरपि।\nबलिभिर्विविधाभिश्च पूजयामास तं द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2083159, "chapter_id": 2772, "verse_number": "१२-२७७-१०", "content_sanskrit": "ततस्त्वल्पेन कालेन तुष्टो जलधरस्तदा।\nतस्योपकारनियतामिमां वाचमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2083160, "chapter_id": 2772, "verse_number": "१२-२७७-११", "content_sanskrit": "ब्रह्मघ्ने च सुरापे च चोरे भग्नव्रते तथा।\nनिष्कृतिर्विहिता सद्भिः कृतघ्ने नास्ति निष्कृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2083161, "chapter_id": 2772, "verse_number": "१२-२७७-१२", "content_sanskrit": "आशायास्तनयोऽधर्मः क्रोधोऽसूयासुतः स्मृतः।\nलोभः पुत्रो निकृत्यास्तु कृतघ्नो नार्हति प्रजां॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2083162, "chapter_id": 2772, "verse_number": "१२-२७७-१३", "content_sanskrit": "ततः स ब्राह्मणः स्वप्ने कुण्डधारस्य तेजसा।\nअपश्यत्सर्वभूतानि कुशेषु शयितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2083163, "chapter_id": 2772, "verse_number": "१२-२७७-१४", "content_sanskrit": "शमेन तपसा चैव भक्त्या च निरुपस्कृतः।\nशुद्धात्मा ब्राह्मणो रात्रौ निदर्शनमपश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2083164, "chapter_id": 2772, "verse_number": "१२-२७७-१५", "content_sanskrit": "माणिभद्रं स तत्रस्थं देवतानां महाद्युतिम्।\nअपश्यत महात्मानं व्यादिशन्तं युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2083165, "chapter_id": 2772, "verse_number": "१२-२७७-१६", "content_sanskrit": "तत्र देवाः प्रयच्छन्ति राज्यानि च धनानि च।\nशुभैः कर्मभिरारब्धाः प्रच्छिदन्त्यशुभेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2083166, "chapter_id": 2772, "verse_number": "१२-२७७-१७", "content_sanskrit": "पश्यतामथ यक्षाणं कुण्डधारो महाद्युतिः।\nनिष्पत्य पतितो भूमौ देवानां भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2083167, "chapter_id": 2772, "verse_number": "१२-२७७-१८", "content_sanskrit": "ततस्तु देववचनान्मणिभद्रो महामनाः।\nउवाच पतितं भूमौ कुण्डधार किमिच्छसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2083168, "chapter_id": 2772, "verse_number": "१२-२७७-१९x", "content_sanskrit": "कुण्डधार उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2083169, "chapter_id": 2772, "verse_number": "१२-२७७-१९", "content_sanskrit": "यदि प्रसन्ना देवा मे भक्तोऽयं ब्राह्मणो मम।\nअस्यानुग्रहमिच्छामि कृतं किंचित्सुखोदयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2083170, "chapter_id": 2772, "verse_number": "१२-२७७-२०", "content_sanskrit": "ततस्तं माणिभद्रस्तु पुनर्वचनमब्रवीत्\nदेवानामेव वचनात्कुण्डधारं माहद्युतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2083171, "chapter_id": 2772, "verse_number": "१२-२७७-२१", "content_sanskrit": "उत्तिष्ठोत्तिष्ठ भद्रं ते कृतकृत्यः सुखी भव।\nधनार्थी यदि विप्रोऽयं धनमस्मै प्रदीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2083172, "chapter_id": 2772, "verse_number": "१२-२७७-२२", "content_sanskrit": "यावद्धनं प्रार्थयते ब्राह्मणोऽयं सथा तव।\nदेवानां शासनात्तावदसङ्ख्येयं ददाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2083173, "chapter_id": 2772, "verse_number": "१२-२७७-२३", "content_sanskrit": "विचार्य कुण्डधारस्तु मानुष्यं चलमध्रुवम्।\nतपसो मतिमाधत्त ब्राह्मणस्य यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2083174, "chapter_id": 2772, "verse_number": "१२-२७७-२४x", "content_sanskrit": "कुण्डधार उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2083175, "chapter_id": 2772, "verse_number": "१२-२७७-२४", "content_sanskrit": "नाहं धनानि याचामि ब्राह्मणाय धनप्रद।\nअन्यमेवाहमिच्छामि भक्तायानुग्रहं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2083176, "chapter_id": 2772, "verse_number": "१२-२७७-२५", "content_sanskrit": "पृथिवीं रत्नपूर्णां वा महद्वा रत्नसंचयम्।\nभक्ताय नाहमिच्छमि भवेदेष तु धार्मिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2083177, "chapter_id": 2772, "verse_number": "१२-२७७-२६", "content_sanskrit": "धर्मेऽस्य रमतां बुद्धिर्धर्मं चैवोपजीवतु।\nधर्मप्रधानो भवतु ममैषोऽनुग्रहो मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2083178, "chapter_id": 2772, "verse_number": "१२-२७७-२७x", "content_sanskrit": "माणिभद्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2083179, "chapter_id": 2772, "verse_number": "१२-२७७-२७", "content_sanskrit": "सदा धर्मफलं राज्यं सुखानि विविधानि च।\nफलान्येवायमश्नातु कायक्लेशविवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2083180, "chapter_id": 2772, "verse_number": "१२-२७७-२८x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2083181, "chapter_id": 2772, "verse_number": "१२-२७७-२८", "content_sanskrit": "ततस्तदेव बहुशः कुण्डधारो महायशाः।\nअभ्यासमकरोद्धर्मे ततस्तुष्टास्तु देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2083182, "chapter_id": 2772, "verse_number": "१२-२७७-२९x", "content_sanskrit": "माणिभद्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2083183, "chapter_id": 2772, "verse_number": "१२-२७७-२९", "content_sanskrit": "प्रीतास्ते देवताः सर्वा द्विजस्यास्य तथैव च।\nभविष्यत्येष धर्मात्मा धर्मे चाधरस्यते मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2083184, "chapter_id": 2772, "verse_number": "१२-२८८-३०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2083185, "chapter_id": 2772, "verse_number": "१२-२७७-३०", "content_sanskrit": "ततः प्रीतो जलधरः कृतकार्यो युधिष्ठिर।\nईप्सितं मनसो लब्ध्वा वरमन्यैः सुदुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2083186, "chapter_id": 2772, "verse_number": "१२-२७७-३१", "content_sanskrit": "ततोऽपश्यत चीराणि सूक्ष्माणि द्विजसत्तमः।\nपार्श्वतोऽभ्याशतो न्यस्तान्यथ निर्वेदमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2083187, "chapter_id": 2772, "verse_number": "१२-२७७-३२x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2083188, "chapter_id": 2772, "verse_number": "१२-२७७-३२", "content_sanskrit": "अयं न सुकृतं वेत्ति को न्वन्यो वेत्स्यते कृतम्।\nगच्छामि वनमेवाहं परं धर्मेण जीवितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2083189, "chapter_id": 2772, "verse_number": "१२-२७७-३३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2083190, "chapter_id": 2772, "verse_number": "१२-२७७-३३", "content_sanskrit": "निर्वेदाद्देवतानां च प्रसादात्स द्विजोत्तमः।\nवनं प्रविश्य सुमहत्तप आरब्धवांस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2083191, "chapter_id": 2772, "verse_number": "१२-२७७-३४", "content_sanskrit": "देवतातिथिशेषेण फलमूलाशनो द्विजः।\nधर्मे चास्य महाराज दृढा बुद्धिरजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2083192, "chapter_id": 2772, "verse_number": "१२-२७७-३५", "content_sanskrit": "त्यक्त्वा मूलफलं सर्वं पर्णाहारोऽभवद्द्विजः।\nपर्णं त्यक्त्वा जलाहारः पुनरासीद्द्विजस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2083193, "chapter_id": 2772, "verse_number": "१२-२७७-३६", "content_sanskrit": "वायुभक्षस्ततः पश्चाद्बहून्वर्षगणानभूत्।\nन चास्य क्षीयते प्राणस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2083194, "chapter_id": 2772, "verse_number": "१२-२७७-३७", "content_sanskrit": "धर्मे च श्रद्दधानस्य तपस्युग्रे च वर्ततः।\nकालेन महता तस्य दिव्या दृष्टिरजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2083195, "chapter_id": 2772, "verse_number": "१२-२७७-३८", "content_sanskrit": "तस्य बुद्धिः प्रादुरासीद्यदि दद्यामहं धनम्।\nतुष्टः कस्यचिदेवेह मिथ्या वाङ्ग भवेन्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2083196, "chapter_id": 2772, "verse_number": "१२-२७७-३९", "content_sanskrit": "ततः प्रहृष्टवदनो भूय आरब्धवांस्तपः।\nभूयश्चाचिन्तयत्सिद्धो यत्परं सोऽभिमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2083197, "chapter_id": 2772, "verse_number": "१२-२७७-४०", "content_sanskrit": "यदि दद्यामहं राज्यं तुष्टो वै यस्य कस्यचित्।\nस भवेदचिराद्राजा न मिथ्या वाग्भवेन्मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2083198, "chapter_id": 2772, "verse_number": "१२-२७७-४१", "content_sanskrit": "तस्य साक्षात्कुण्डधारो दर्शयामास भारत।\nब्राह्मणस्य तपोयोगात्सौहृदेनाभिचोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2083199, "chapter_id": 2772, "verse_number": "१२-२७७-४२", "content_sanskrit": "समागम्य स तेनाथ पूजां चक्रे यथाविधि।\nब्राह्मणः कुण्डधारस्य विस्मितश्चाभवन्नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2083200, "chapter_id": 2772, "verse_number": "१२-२७७-४३", "content_sanskrit": "ततोऽब्रवीत्कुण्डधारो दिव्यं ते चक्षुरुत्तमम्।\nपश्य राज्ञां गतिं विप्र लोकांश्चैव तु चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2083201, "chapter_id": 2772, "verse_number": "१२-२७७-४४", "content_sanskrit": "ततो राजसहस्राणि मग्नानि निरये तदा।\nदूरादपश्यद्विप्रः स दिव्ययुक्तेन चक्षुषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2083202, "chapter_id": 2772, "verse_number": "१२-२७७-४५x", "content_sanskrit": "कुण्डधार उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2083203, "chapter_id": 2772, "verse_number": "१२-२७७-४५", "content_sanskrit": "मां पूजयित्वा भावेन यदि त्वं दुःखमाप्नुयाः।\nकृतं मया भवेत्किं ते कश्च तेऽनुग्रहो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2083204, "chapter_id": 2772, "verse_number": "१२-२७७-४६", "content_sanskrit": "पश्यपश्य च भूयस्त्वं कामानिच्छेत्कथं नरः।\nस्वर्गद्वारं हि संरुद्धं मानुषेषु विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2083205, "chapter_id": 2772, "verse_number": "१२-२७७-४७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2083206, "chapter_id": 2772, "verse_number": "१२-२७७-४७", "content_sanskrit": "ततोऽपश्यत्स कामं च क्रोधं लोभं भयं मदम्।\nनिद्रां तन्द्रीं तथाऽऽलस्यमावृत्त्य पुरुषान्स्थितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2083207, "chapter_id": 2772, "verse_number": "१२-२७७-४८x", "content_sanskrit": "कुण्डधार उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2083208, "chapter_id": 2772, "verse_number": "१२-२७७-४८", "content_sanskrit": "एतैर्लोकाः सुसंरुद्धा देवानां मानुषाद्भयम्।\nतथैव देववचनाद्विघ्नं कुर्वन्ति सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2083209, "chapter_id": 2772, "verse_number": "१२-२७७-४९", "content_sanskrit": "न देवैरननुज्ञातः कश्चिद्भवति धार्मिकः।\nएष शक्तोस्मि तपसा दातुं राज्यं धनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2083210, "chapter_id": 2772, "verse_number": "१२-२७७-५०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2083211, "chapter_id": 2772, "verse_number": "१२-२७७-५०", "content_sanskrit": "ततः पपात शिरसा ब्राह्मणस्तोयधारिणे।\nउवाच चैनं धर्मात्मा महान्मेऽनुग्रहः कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2083212, "chapter_id": 2772, "verse_number": "१२-२७७-५१", "content_sanskrit": "कामलोभानुबन्धेन पुरा ते यदसूयितम्।\nमया स्नेहमविज्ञाय तत्र मे क्षन्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2083213, "chapter_id": 2772, "verse_number": "१२-२७७-५२", "content_sanskrit": "क्षान्तमेव मयेत्युक्त्वा कुण्डधारो द्विजर्षभम्।\nसंपरिष्वज्य बाहुभ्यां तत्रैवान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2083214, "chapter_id": 2772, "verse_number": "१२-२७७-५३", "content_sanskrit": "ततः सर्वांस्तदा लोकान्ब्राह्मणोऽनुचचार ह।\nकुण्डधारप्रसादेन तपसा सिद्धिमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2083215, "chapter_id": 2772, "verse_number": "१२-२७७-५४", "content_sanskrit": "विहायसा च गमनं तथा संकल्पितार्थता।\nधर्माच्छक्त्या तथा योगाद्या चैव परमा गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2083216, "chapter_id": 2772, "verse_number": "१२-२७७-५५", "content_sanskrit": "देवता ब्राह्मणाः सन्तो यक्षा मानुषचारणाः।\nधार्मिकान्पूजयन्तीह न धनाढ्यान्न कामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2083217, "chapter_id": 2772, "verse_number": "१२-२७७-५६", "content_sanskrit": "सुप्रसन्ना हि ते देवा यत्ते धर्मे रता मतिः।\nधने सुखकला काचिद्धर्मे तु परमं सुखम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2083218, "chapter_id": 2772, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि सप्तसप्तत्यधिकद्विशततमोऽध्यायः॥ २७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]