[{"id": 2012494, "chapter_id": 1256, "verse_number": "१-२५७-०x", "content_sanskrit": "जरितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012495, "chapter_id": 1256, "verse_number": "१-२५७-१", "content_sanskrit": "अस्माद्बिलान्निष्पतितमाखुं श्येनो जहार तम्।\nक्षुद्रं पद्भ्यां गृहीत्वा च यातो नात्र भयं हि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2012496, "chapter_id": 1256, "verse_number": "१-२५७-२x", "content_sanskrit": "शार्ङ्गका ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2012497, "chapter_id": 1256, "verse_number": "१-२५७-२", "content_sanskrit": "न हृतं तं वयं विद्मः श्येनेनाखुं कथंचन।\nअन्येऽपि भितारोऽत्र तेभ्योऽपि भमेव नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2012498, "chapter_id": 1256, "verse_number": "१-२५७-३", "content_sanskrit": "संशयो वह्निरागच्छेद्दृष्टं वायोर्निवर्तनम्।\nमृत्युर्नो बिलवासिभ्यो बिले स्यान्नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2012499, "chapter_id": 1256, "verse_number": "१-२५७-४", "content_sanskrit": "निःसंशयात्संशयितो मृत्युर्मातर्विशिष्यते।\nचर खे त्वं यथान्यायं पुत्रानाप्स्यसि शोभनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2012500, "chapter_id": 1256, "verse_number": "१-२५७-५x", "content_sanskrit": "जरितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2012501, "chapter_id": 1256, "verse_number": "१-२५७-५", "content_sanskrit": "अहं वेगेन तं यान्तमद्राक्षं पततां वरम्।\nबिलादाखुं समादाय श्येनं पुत्रा महाबलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2012502, "chapter_id": 1256, "verse_number": "१-२५७-६", "content_sanskrit": "तं पतन्तं महावेगा त्वरिता पृष्ठतोऽन्वगाम्।\nआशिषोऽस्य प्रयुञ्जाना हरतो मूषिकं बिलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2012503, "chapter_id": 1256, "verse_number": "१-२५७-७", "content_sanskrit": "यो नो द्वेष्टारमादाय श्येनराज प्रधावसि।\nभव त्वं दिवमास्थाय निरमित्रो हिरण्मयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2012504, "chapter_id": 1256, "verse_number": "१-२५७-८", "content_sanskrit": "स यदा भक्षितस्तेन श्येनेनाखुः पतत्रिणा।\nतदाहं तमनुज्ञाप्य प्रत्युपायां पुनर्गृहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2012505, "chapter_id": 1256, "verse_number": "१-२५७-९", "content_sanskrit": "प्रविशध्वं बिलं पुत्रा विश्रब्धा नास्ति वो भयम्।\nश्येनेन मम पश्यन्त्या हृत आखुर्महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2012506, "chapter_id": 1256, "verse_number": "१-२५७-१०x", "content_sanskrit": "शार्ङ्गका ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2012507, "chapter_id": 1256, "verse_number": "१-२५७-१०", "content_sanskrit": "न विद्महे हृतं मातः श्येनैनाखुं कथंचन।\nअविज्ञाय न शक्यामः प्रवेष्टं विवरं भुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2012508, "chapter_id": 1256, "verse_number": "१-२५७-११x", "content_sanskrit": "जरितोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2012509, "chapter_id": 1256, "verse_number": "१-२५७-११", "content_sanskrit": "अहं तमभिजानामि हृतं श्येनेन मूषिकम्।\nनास्ति वोऽत्र भयं पुत्राः क्रियतां वचनं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2012510, "chapter_id": 1256, "verse_number": "१-२५७-१२x", "content_sanskrit": "शार्ङ्गका ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2012511, "chapter_id": 1256, "verse_number": "१-२५७-१२", "content_sanskrit": "न त्वं मिथ्योपचारेण मोक्षयेथा भयाद्धि नः।\nसमाकुलेषु ज्ञानेषु न बुद्धिकृतमेव तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2012512, "chapter_id": 1256, "verse_number": "१-२५७-१३", "content_sanskrit": "न चोपकृतमस्माभिर्न चास्मान्वेत्थ ये वयम्।\nपीड्यमाना बिभर्ष्यस्मान्का सती के वयं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2012513, "chapter_id": 1256, "verse_number": "१-२५७-१४", "content_sanskrit": "तरुणी दर्शीयाऽसि समर्था भर्तुरेषणे।\nअनुगच्छ पतिं मातुः पुत्रानाप्स्यसि शोमनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2012514, "chapter_id": 1256, "verse_number": "१-२५७-१५", "content_sanskrit": "वयमस्निं समाविश्य लोकानाप्स्याम शोभनान्।\nअथास्मान्न दहेदग्निरायास्त्वं पुनरेव नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2012515, "chapter_id": 1256, "verse_number": "१-२५७-१६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2012516, "chapter_id": 1256, "verse_number": "१-२५७-१६", "content_sanskrit": "एवमुक्ता ततः शार्ङ्गी पुत्रानुत्सृज्य खाण्डवे।\nजगाम त्वरिता देशं क्षेममग्नेरनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2012517, "chapter_id": 1256, "verse_number": "१-२५७-१७", "content_sanskrit": "ततस्तीक्ष्णार्चिरभ्यागात्त्वरितो हव्यवाहनः।\nयत्र शार्ङ्गा वभूवुस्ते मन्दपालस्य पुत्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2012518, "chapter_id": 1256, "verse_number": "१-२५७-१८", "content_sanskrit": "ततस्तं ज्वलितं दृष्ट्वा ज्वलनं ते विहङ्गमाः।\nव्यथिताः करुणा वाचः श्रावयामासुरन्तिकात्।\nजरितारिस्ततो वाक्यं श्रावयामास पावकम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2012519, "chapter_id": 1256, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि मयदर्शनपर्वणि सप्तपञ्चाशदधिकद्विशततमोऽध्यायः॥ २५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]