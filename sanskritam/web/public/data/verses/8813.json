[{"id": 40000966, "chapter_id": 8813, "verse_number": "1", "content_sanskrit": "अथ तां रजनीं तत्र कृतार्थौ रामलक्ष्मणौ। ऊषतुर्मुदितौ वीरौ प्रहृष्टेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40000967, "chapter_id": 8813, "verse_number": "2", "content_sanskrit": "प्रभातायां तु शर्वर्यां कृतपौर्वाह्णिकक्रियौ। विश्वामित्रमृषींश्चान्यान् सहितावभिजग्मतु: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40000968, "chapter_id": 8813, "verse_number": "3", "content_sanskrit": "अभिवाद्य मुनिश्रेष्ठं ज्वलन्तमिव पावकम्। ऊचतुर्मधुरोदारं वाक्यं मधुरभाषिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40000969, "chapter_id": 8813, "verse_number": "4", "content_sanskrit": "इमौ स्म मुनिशार्दूल किङ्करौ समुपस्थितौ। आज्ञापय यथेष्टं वै शासनं करवाव किम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40000970, "chapter_id": 8813, "verse_number": "5", "content_sanskrit": "एवमुक्ता स्ततस्ताभ्यां सर्व एव महर्षय:। विश्वामित्रं पुरस्कृत्य रामं वचनमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40000971, "chapter_id": 8813, "verse_number": "6", "content_sanskrit": "मैथिलस्य नरश्रेष्ठ जनकस्य भविष्यति। यज्ञ: परमधर्मिष्ठस्तस्य यास्यामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40000972, "chapter_id": 8813, "verse_number": "7", "content_sanskrit": "त्वं चैव नरशार्दूल सहास्माभिर्गमिष्यसि। अद्भुतं धनुरत्नं च तत्र तद्रष्टुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40000973, "chapter_id": 8813, "verse_number": "8", "content_sanskrit": "तद्धि पूर्वं नरश्रेष्ठ दत्तं सदसि दैवतै:। अप्रमेयबलं घोरं मखे परमभास्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40000974, "chapter_id": 8813, "verse_number": "9", "content_sanskrit": "नास्य देवा न गन्धर्वा नासुरा न च राक्षसा:। कर्तुमारोपणं शक्ता न कथञ्चन मानुषा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40000975, "chapter_id": 8813, "verse_number": "10", "content_sanskrit": "धनुषस्तस्य वीर्यं तु जिज्ञासन्तो महीक्षित:। न शेकुरारोपयितुं राजपुत्रा महाबला: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40000976, "chapter_id": 8813, "verse_number": "11", "content_sanskrit": "तद्धनुर्नरशार्दूल मैथिलस्य महात्मन:। तत्र द्रक्ष्यसि काकुत्स्थ यज्ञं चाद्भुतदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40000977, "chapter_id": 8813, "verse_number": "12", "content_sanskrit": "तद्धि यज्ञफलं तेन मैथिलेनोत्तमं धनु:। याचितं नरशार्दूल सुनाभं सर्वदैवतै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40000978, "chapter_id": 8813, "verse_number": "13", "content_sanskrit": "आयागभूतं नृपतेस्तस्य वेश्मनि राघव। अर्चितं विविधैर्गन्धैर्धूपैश्चागरुगन्धिभि: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40000979, "chapter_id": 8813, "verse_number": "14", "content_sanskrit": "एवमुक्त्वा मुनिवर: प्रस्थानमकरोत्तदा। सर्षिसङ्घ स्सकाकुत्स्थ: आमन्त्र्य वनदेवता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40000980, "chapter_id": 8813, "verse_number": "15", "content_sanskrit": "स्वस्ति वोऽस्तु गमिष्यामि सिद्वस्सिद्धाश्रमादहम्। उत्तरे जाह्नवीतीरे हिमवन्तं शिलोच्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40000981, "chapter_id": 8813, "verse_number": "16", "content_sanskrit": "प्रदक्षिणं तत: कृत्वा सिद्धाश्रममनुत्तमम्। उत्तरां दिशमुद्दिश्य प्रस्थातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40000982, "chapter_id": 8813, "verse_number": "17", "content_sanskrit": "तं प्रयान्तं मुनिवरमन्वयादनुसारिणम्। शकटीशतमात्रं तु प्रायेण ब्रह्मवादिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40000983, "chapter_id": 8813, "verse_number": "18", "content_sanskrit": "मृगपक्षिगणाश्चैव सिद्धाश्रमनिवासिन:। अनुजग्मुर्महात्मानं विश्वामित्रं महामुनिम् ॥ निवर्तयामास तत: पक्षिसङ्घान् मृगानपि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40000984, "chapter_id": 8813, "verse_number": "19", "content_sanskrit": "ते गत्वा दूरमध्वानं लम्बमाने दिवाकरे। वासं चक्रुर्मुनिगणाः शोणाकूले समाहिता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40000985, "chapter_id": 8813, "verse_number": "20", "content_sanskrit": "तेऽस्तं गते दिनकरे स्नात्वा हुतहुताशना:। विश्वामित्रं पुरस्कृत्य निषेदुरमितौजस: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40000986, "chapter_id": 8813, "verse_number": "21", "content_sanskrit": "रामोऽपि सहसौमित्रिर्मुनीं स्तानभिपूज्य च। अग्रतो निषसादाथ विश्वामित्रस्य धीमत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40000987, "chapter_id": 8813, "verse_number": "22", "content_sanskrit": "अथ रामो महातेजाः विश्वामित्रं महामुनिम्। पप्रच्छ नरशार्दूल: कौतूहलसमन्वित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40000988, "chapter_id": 8813, "verse_number": "23", "content_sanskrit": "भगवन् कोऽन्वयं देशस्समृद्धवनशोभित:। श्रोतुमिच्छामि भद्रं ते वक्तुमर्हसि तत्त्वत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40000989, "chapter_id": 8813, "verse_number": "24", "content_sanskrit": "चोदितो रामवाक्येन कथयामास सुव्रत:। तस्य देशस्य निखिलमृषिमध्ये महातपा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]