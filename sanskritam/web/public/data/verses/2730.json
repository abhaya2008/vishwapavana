[{"id": 2081514, "chapter_id": 2730, "verse_number": "१२-२३५-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081515, "chapter_id": 2730, "verse_number": "१२-२३५-१", "content_sanskrit": "पूर्वरूपाणि मे राजन्पुरुषस्य भविष्यतः।\nपराभविष्यतश्चैव तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081516, "chapter_id": 2730, "verse_number": "१२-२३५-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081517, "chapter_id": 2730, "verse_number": "१२-२३५-२", "content_sanskrit": "मन एव मनुष्यस्य पूर्वरूपाणि शंसति।\nभविष्यतश्च भद्रं ते तथैव न भविष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081518, "chapter_id": 2730, "verse_number": "१२-२३५-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nश्रिया शक्रस्य संवादं तन्निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081519, "chapter_id": 2730, "verse_number": "१२-२३५-४", "content_sanskrit": "महतस्तपसो व्यष्ट्या पश्यँल्लोकौ परावरौ।\nसामान्यमृषिभिर्गत्वा ब्रह्मलोकनिवासिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081520, "chapter_id": 2730, "verse_number": "१२-२३५-५", "content_sanskrit": "ब्रह्मेवामितदीप्तौजाः शान्तपाप्मा महातपाः।\nविचचार यथाकालं त्रिषु लोकेषु नारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081521, "chapter_id": 2730, "verse_number": "१२-२३५-६", "content_sanskrit": "कदाचित्प्रातरुत्थाय पिस्पृक्षुः सलिलं शुचि।\nध्रुवद्वारभवां गङ्गां जगामावततार च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081522, "chapter_id": 2730, "verse_number": "१२-२३५-७", "content_sanskrit": "`मेरुपादोद्भवां गङ्गां नारायणपदच्युताम्।\nस वीक्षमाणो हृष्टात्मा तं देशमभिजग्मिवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081523, "chapter_id": 2730, "verse_number": "१२-२३५-८", "content_sanskrit": "यं--देवजवाकीर्णं सूक्ष्मकाञ्जनवालुकम्।\nगङ्गाद्वीपं समासाद्य नानावृक्षैरलङ्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081524, "chapter_id": 2730, "verse_number": "१२-२३५-९", "content_sanskrit": "सालतालाश्वकर्णानां चन्दनानां च राजिभिः।\nमण्डितं विविधैः पुष्पैर्हंसकारण्डवायुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081525, "chapter_id": 2730, "verse_number": "१२-२३५-१०", "content_sanskrit": "नदीपुलिनमासाद्य स्नात्वा संतर्प्य देवताः।\nजजाप जप्यं धर्मात्मा तन्मयत्वेन भास्वता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081526, "chapter_id": 2730, "verse_number": "१२-२३५-११", "content_sanskrit": "सहस्रनयनश्चापि वज्री शम्बरपाकहा।\nतस्या देवर्षिजुष्टायास्तीरमभ्याजगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081527, "chapter_id": 2730, "verse_number": "१२-२३५-१२", "content_sanskrit": "तावाप्लुत्य यतात्मानौ कृतजप्यौ समासतः।\nनद्याः पुलिनमासाद्य सूक्ष्मकाञ्चनवालुकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081528, "chapter_id": 2730, "verse_number": "१२-२३५-१३", "content_sanskrit": "पुण्यकर्मभिराख्याता देवर्षिकथिताः कथाः।\nचक्रतुस्तौ तथाऽऽसीनौ महर्षिकथितास्तथा।\nपूर्ववृत्तव्यतीतानि कथयन्तौ समाहितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081529, "chapter_id": 2730, "verse_number": "१२-२३५-१४", "content_sanskrit": "अद्य भास्करमुद्यन्तं रश्मिजालपुरस्कृतम्।\nपूर्णमण्डलमालोक्य तावुत्थायोपतस्थतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081530, "chapter_id": 2730, "verse_number": "१२-२३५-१५", "content_sanskrit": "`विविक्ते पुण्यदेशे तु रममाणौ मुदा युतौ।\nददृशातेऽन्तरिक्षे तौ सूर्यस्योदयनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081531, "chapter_id": 2730, "verse_number": "१२-२३५-१६", "content_sanskrit": "ज्योतिर्ज्वालसमाकीर्णं ज्योतिषां गणमण्डितम्।\nअभितस्तूदयन्तं तमर्कमर्कमिवापरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081532, "chapter_id": 2730, "verse_number": "१२-२३५-१७", "content_sanskrit": "आकाशो ददृशे ज्योतिरुद्यतार्चिः समप्रभम्।\n`अर्कस्य तेजसा तुल्यं तद्भास्करसमप्रभम्।\nतयोः समीपं तं प्राप्तं प्रत्यदृश्यत भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081533, "chapter_id": 2730, "verse_number": "१२-२३५-१८", "content_sanskrit": "तत्सुपर्णार्करचितमास्थितं वैष्णवं पदम्।\nभाभिरप्रतिमं भाति त्रैलोक्यमवभासयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081534, "chapter_id": 2730, "verse_number": "१२-२३५-१९", "content_sanskrit": "`दृष्ट्वा तौ तु विक्रान्तौ प्राञ्जली समुपास्थितौ।\nक्रमात्संप्रेक्ष्यमाणौ तौ विमानं दिव्यमद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081535, "chapter_id": 2730, "verse_number": "१२-२३५-२०", "content_sanskrit": "तस्मिंस्तदा सतीं कान्तां लोककान्तां परां शुभाम्।\nधात्रीं लोकस्य रमणीं लोकमातरमच्युताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081536, "chapter_id": 2730, "verse_number": "१२-२३५-२१", "content_sanskrit": "दिव्याभिरुपशोभाभिरप्सरोभिः पुरस्कृताम्।\nबृहतीमंशुमत्प्रख्यां बृहद्भानोरिवार्चिषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081537, "chapter_id": 2730, "verse_number": "१२-२३५-२२", "content_sanskrit": "नक्षत्रकल्पाभरणां तारापङ्क्तिसमस्रजम्।\nश्रियं ददृशतुः पद्मां साक्षात्पद्मदलस्थिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2081538, "chapter_id": 2730, "verse_number": "१२-२३५-२३", "content_sanskrit": "साऽवरुह्य विमानाग्रादङ्गनानामनुत्तमा।\nअभ्यागच्छन्त्रिलोकेशं शक्रं चर्षि च नारदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2081539, "chapter_id": 2730, "verse_number": "१२-२३५-२४", "content_sanskrit": "नारदानुगतः साक्षान्मघवांस्तामुपागमत्।\nकृताञ्जलिपुटो देवीं निवेद्यात्मानमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2081540, "chapter_id": 2730, "verse_number": "१२-२३५-२५", "content_sanskrit": "चक्रे चानुपमां पूजां तस्याश्चापि स सर्वंवित्।\nदेवराजः श्रियं राजन्वाक्यं चेदमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2081541, "chapter_id": 2730, "verse_number": "१२-२३५-२६", "content_sanskrit": "का त्वं केन च कार्येण संप्राप्ता चारुहासिनि।\nकुतश्चागम्यते सुभ्रु गन्तव्यं क्व च ते शुभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2081542, "chapter_id": 2730, "verse_number": "१२-२३५-२७x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2081543, "chapter_id": 2730, "verse_number": "१२-२३५-२७", "content_sanskrit": "पुण्येषु त्रिषु लोकेषु सर्वे स्थावरजङ्गमाः।\nममात्मभावमिच्छन्तो यतन्ते परमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2081544, "chapter_id": 2730, "verse_number": "१२-२३५-२८", "content_sanskrit": "साऽहं वै पङ्कजे जाता सूर्यरश्मिप्रबोधिते।\nभूत्यर्तं सर्वभूतानां पद्मा श्रीः पद्ममालिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2081545, "chapter_id": 2730, "verse_number": "१२-२३५-२९", "content_sanskrit": "अहं लक्ष्मीरहं भूतिः श्रीश्चाहं बलसूदन।\nअहं श्रद्धा च मेधा च सन्नतिर्विजितिः स्थितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2081546, "chapter_id": 2730, "verse_number": "१२-२३५-३०", "content_sanskrit": "अहं धृतिरहं सिद्धिरहं संभूतिरेव च।\nअहं स्वाहा स्वधा चैव संस्तुतिर्नियतिः कृतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2081547, "chapter_id": 2730, "verse_number": "१२-२३५-३१", "content_sanskrit": "राज्ञां विजयमानानां सेनाग्नेषु ध्वजेषु च।\nनिवसे धर्मशीलानां विषयेषु पुरेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2081548, "chapter_id": 2730, "verse_number": "१२-२३५-३२", "content_sanskrit": "जितकाशिनि शूरे च संग्रामेष्वनिवर्तिनि।\nनिवसामि मनुष्येन्द्रे सदैव बलसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2081549, "chapter_id": 2730, "verse_number": "१२-२३५-३३", "content_sanskrit": "धर्मनित्ये महाबुद्धौ ब्रह्मण्ये सत्यवादिनि।\nप्रश्रिते दानशीले च सदैव निवसाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2081550, "chapter_id": 2730, "verse_number": "१२-२३५-३४", "content_sanskrit": "असुरेष्ववसं पूर्वं सत्यधर्मनिबन्धनात्।\nविपरीतांस्तु तान्बुद्ध्वा त्वयि वासमरोचयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2081551, "chapter_id": 2730, "verse_number": "१२-२३५-३५x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2081552, "chapter_id": 2730, "verse_number": "१२-२३५-३५", "content_sanskrit": "कथं वृत्तेषु दैत्येषु त्वमवात्सीर्वरानाने।\nदृष्ट्वा च किमिहागास्त्वं हित्वा दैतेयदानवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2081553, "chapter_id": 2730, "verse_number": "१२-२३५-३६x", "content_sanskrit": "श्रीरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2081554, "chapter_id": 2730, "verse_number": "१२-२३५-३६", "content_sanskrit": "स्वधर्ममनुतिष्ठत्सु धैर्यादचलितेषु च।\nस्वर्गमार्गाभिरामेषु सत्वेषु निरता ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2081555, "chapter_id": 2730, "verse_number": "१२-२३५-३७", "content_sanskrit": "दानाध्ययनयज्ञेज्यापितृदैवतपूजनम्।\nगुरूणामतिथीनां च तेषां नित्यमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2081556, "chapter_id": 2730, "verse_number": "१२-२३५-३८", "content_sanskrit": "सुसंमृष्टगुहाश्चासञ्जितस्त्रीका हुताग्नयः।\nगुरुशुश्रूषका दान्ता ब्रह्मण्याः सत्यवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2081557, "chapter_id": 2730, "verse_number": "१२-२३५-३९", "content_sanskrit": "श्रद्दधाना जितक्रोधा दानशीलाऽनसूयवः।\nभृतपुत्रा भृतामात्या भृतदारा ह्यनीर्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2081558, "chapter_id": 2730, "verse_number": "१२-२३५-४०", "content_sanskrit": "अमर्षेण न चान्योन्यं स्पृहयन्ते कदाचन।\nन च जातूपतप्यन्ति धीराः परसमृद्धिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2081559, "chapter_id": 2730, "verse_number": "१२-२३५-४१", "content_sanskrit": "दातारः संग्रहीतार आर्याः करुणवेदिनः।\nमहाप्रसादा ऋजवो दृढभक्ता जितेन्द्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2081560, "chapter_id": 2730, "verse_number": "१२-२३५-४२", "content_sanskrit": "संतुष्टभृत्यसचिवाः कृतज्ञाः प्रियवादिनः।\nयथार्हमानार्थकरा ह्रीनिषेवा यतव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2081561, "chapter_id": 2730, "verse_number": "१२-२३५-४३", "content_sanskrit": "नित्यं पर्वसु सुस्नाताः स्वनुलिप्ताः स्वलङ्कृताः।\nउपवासतपः शीलाः प्रतीता ब्रह्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2081562, "chapter_id": 2730, "verse_number": "१२-२३५-४४", "content_sanskrit": "नैनानभ्युदियात्सूर्यो नैवास्वप्स्यन्प्रगेशयाः।\nरात्रौ दधि च सक्तूंश्च नित्यमेव व्यवर्जयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2081563, "chapter_id": 2730, "verse_number": "१२-२३५-४५", "content_sanskrit": "काल्यं घृतं तु चान्वीक्ष्य प्रयता ब्रह्मवादिनः।\nपङ्गल्यान्यपि चापश्यन्ब्रह्माणांश्चाप्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2081564, "chapter_id": 2730, "verse_number": "१२-२३५-४६", "content_sanskrit": "सदा हि ददतां धर्म्यं सदाचाप्रतिगृह्णताम्।\nअर्धं च रात्र्याः स्वपतां दिवा चास्वपतां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2081565, "chapter_id": 2730, "verse_number": "१२-२३५-४७", "content_sanskrit": "कृपणानाथवृद्धानां दुर्बलातुरयोषिताम्।\nदयां च संविभागं च नित्यमेवान्वमोदताम्।\nकालो यातः सुखेनैव धर्ममार्गे निवर्तताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2081566, "chapter_id": 2730, "verse_number": "१२-२३५-४८", "content_sanskrit": "त्रस्तं विषण्णमुद्विग्नं भयार्तं व्याधिपीडितम्।\nहृतस्वं व्यसनार्तं च नित्यमाश्वासयन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2081567, "chapter_id": 2730, "verse_number": "१२-२३५-४९", "content_sanskrit": "धर्ममेवानुवर्तन्ते न हिंसन्ति परस्परम्।\nअनुकूलाश्च कार्येषु गुरुवृद्धोपसेविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2081568, "chapter_id": 2730, "verse_number": "१२-२३५-५०", "content_sanskrit": "पितॄन्देवातिथींश्चैव गुरूंश्चैवाभ्यपूजयन्।\nअवशेषाणि चाश्नन्ति नित्यं सत्यतपोधृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2081569, "chapter_id": 2730, "verse_number": "१२-२३५-५१", "content_sanskrit": "नैकेऽश्नन्ति सुसंपन्नं न गच्छन्ति परस्त्रियम्।\nसर्वभूतेष्ववर्तन्त यथाऽऽत्मनि दयां प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2081570, "chapter_id": 2730, "verse_number": "१२-२३५-५२", "content_sanskrit": "नैवाकाशे न पशुषु नायोनौ च न पर्वसु।\nइन्द्रियस्य विसर्गं ते रोचयन्ति कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2081571, "chapter_id": 2730, "verse_number": "१२-२३५-५३", "content_sanskrit": "नित्यं दानं तथा दाक्ष्यमार्जवं चैव नित्यदा।\nउत्साहोऽथानहकारः परमं सौहृदं क्षमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2081572, "chapter_id": 2730, "verse_number": "१२-२३५-५४", "content_sanskrit": "सत्यं दानं तपः शौचं कारुण्यं वागनिष्ठुरा।\nमित्रेषु चानभिद्रोहः सर्वं तेष्वभवत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2081573, "chapter_id": 2730, "verse_number": "१२-२३५-५५", "content_sanskrit": "निद्रा तन्द्रीरसंप्रीतिरसूयाऽथानवेक्षिता।\nअरतिश्च विषादश्च स्पृहा चाप्यविशन्न तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2081574, "chapter_id": 2730, "verse_number": "१२-२३५-५६", "content_sanskrit": "साऽहमेवंगुणेष्वेव दानवेष्ववसं पुरा।\nप्रजासर्गमुपादाय यावद्गुणविपर्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2081575, "chapter_id": 2730, "verse_number": "१२-२३५-५७", "content_sanskrit": "ततः कालविपर्यासे तेषां गुणविपर्ययात्।\nअपश्यं निर्गतं धर्मं कामक्रोधवशात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2081576, "chapter_id": 2730, "verse_number": "१२-२३५-५८", "content_sanskrit": "सभासदां च वृद्धानां सतां कथयतां कथाः।\nप्राहसन्नभ्यसूयंश्च सर्वबुद्धान्गुरून्परान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2081577, "chapter_id": 2730, "verse_number": "१२-२३५-५९", "content_sanskrit": "युवानश्च समासीना वृद्धानपि गतान्सतः।\nनाभ्युत्थानाभिवादाभ्यां यथापूर्वमपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2081578, "chapter_id": 2730, "verse_number": "१२-२३५-६०", "content_sanskrit": "वर्तयत्येव पितरि पुत्रः प्रभवते तथा।\nअमित्रभृत्यतां प्राप्य ख्यापयन्त्यनपत्रपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2081579, "chapter_id": 2730, "verse_number": "१२-२३५-६१", "content_sanskrit": "तथा धर्मादपेतेन कर्मणा गर्हितेन ये।\nमहतः प्राप्नुवन्त्यर्थांस्तेषां तत्राभवत्स्पृहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2081580, "chapter_id": 2730, "verse_number": "१२-२३५-६२", "content_sanskrit": "उच्चैश्चाभ्यवदन्रात्रौ नीचैस्तत्राग्निरज्वलत्।\nपुत्राः पितृनत्यचरन्नार्यश्चात्यचरन्पतीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2081581, "chapter_id": 2730, "verse_number": "१२-२३५-६३", "content_sanskrit": "मातरं पितरं वृद्धमाचार्यमतिथिं गुरुम्।\nगुरुत्वान्नाभ्यनन्दन्त कुमारान्नान्वपालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2081582, "chapter_id": 2730, "verse_number": "१२-२३५-६४", "content_sanskrit": "भिक्षां बलिमदत्त्वा च स्वयमन्नानि भुञ्जते।\nअनिष्ट्वाऽसंविभज्याथ पितृदेवातिथीन्गुरून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2081583, "chapter_id": 2730, "verse_number": "१२-२३५-६५", "content_sanskrit": "न शौचमन्वरुद्ध्यन्त तेषां सूदजनास्तथा।\nमनसा कर्मणा वाचा भक्ष्यमासीदनावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2081584, "chapter_id": 2730, "verse_number": "१२-२३५-६६", "content_sanskrit": "`बालानां प्रेक्षमाणानां भक्तान्यश्नन्ति मोहिताः।\nएको दासो भवेत्तेषां तेषां दासीद्वयं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2081585, "chapter_id": 2730, "verse_number": "१२-२३५-६७", "content_sanskrit": "त्रिगवा दानवाः केचिच्चतुरोजास्तथा परे।\nषडश्वाः सप्तमातङ्गाः पञ्चमाहिषिकाः परे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2081586, "chapter_id": 2730, "verse_number": "१२-२३५-६८", "content_sanskrit": "रात्रौ दधि च सक्तूंश्च नित्यमेवाविवर्जिताः।\nअन्तर्दशाहे चाश्नन्ति गवां क्षिरं विचेतनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2081587, "chapter_id": 2730, "verse_number": "१२-२३५-६९", "content_sanskrit": "क्रमदोहं न कुर्वन्ति वत्सस्तन्यानि भुञ्जते।\nअनाथां कृपणां भार्यां घ्नन्ति नित्यं शपन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2081588, "chapter_id": 2730, "verse_number": "१२-२३५-७०", "content_sanskrit": "शूद्रान्नपुष्टा विप्रास्तु निर्लज्जाश्च भवन्त्युत।\nसंकीर्णानि च धान्यानि नात्यवेक्षत्कुटुंबिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2081589, "chapter_id": 2730, "verse_number": "१२-२३५-७१", "content_sanskrit": "मार्जारकुक्कुटश्वानैः क्रीडां कुर्वन्ति मानवाः।\nगृहे कण्टकिनो वृक्षास्तथा निष्पाववल्लरी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2081590, "chapter_id": 2730, "verse_number": "१२-२३५-७२", "content_sanskrit": "यज्ञियाश्च तथा वृक्षास्तेषामासन्दुरात्मनाम्।\nकूपस्नानरता नित्यं पर्वमैथुनगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2081591, "chapter_id": 2730, "verse_number": "१२-२३५-७३", "content_sanskrit": "तिलानश्नन्ति रात्रौ च तैलाभ्यक्ताश्च शेरते।\nविभीतककरञ्जानां छायामूलनिवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2081592, "chapter_id": 2730, "verse_number": "१२-२३५-७४", "content_sanskrit": "करवीरं च ते पुष्पं धारयन्ति च मोहिताः।\nपद्मबिजानि खादन्ति पुष्पं जिघ्रन्ति मोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2081593, "chapter_id": 2730, "verse_number": "१२-२३५-७५", "content_sanskrit": "न भोक्ष्यन्ति तथा नित्यं दैत्याः कालेन मोहिताः।\nनिन्दन्ति स्तवनं विष्णोस्तस्य नित्यद्विषो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2081594, "chapter_id": 2730, "verse_number": "१२-२३५-७६", "content_sanskrit": "होमधूमो न तत्रासीद्वेदघोषस्तथैव च।\nयज्ञाश्च न प्रवर्तन्ते यथापूर्वं गृहेगृहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2081595, "chapter_id": 2730, "verse_number": "१२-२३५-७७", "content_sanskrit": "शिष्याचार्यक्रमो नासीत्पुत्रैरात्मपितुः पिता।\nविष्णुं ब्रह्मण्यदेवेशं हित्वा पाषण्डमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2081596, "chapter_id": 2730, "verse_number": "१२-२३५-७८", "content_sanskrit": "हव्यकव्यविहीनाश्च ज्ञानाध्ययनवर्जिताः।\nदेवस्वादानरुचयो ब्रह्मस्वरुचयस्तथा।\nस्तुतिमङ्गलहीनानि देवस्थानानि सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2081597, "chapter_id": 2730, "verse_number": "१२-२३५-७९", "content_sanskrit": "विप्रकीर्णानि धान्यानि काकमूषिकभोजनम्।\nअपावृतं पयोतिष्ठदुच्छिष्टाश्चास्पृशन्धृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2081598, "chapter_id": 2730, "verse_number": "१२-२३५-८०", "content_sanskrit": "कुद्दालं दात्रपिटकं प्रकीर्णं कांस्यभोजनम्।\nद्रव्योपकरणं सर्वं नान्ववैक्षत्कुटुम्बिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2081599, "chapter_id": 2730, "verse_number": "१२-२३५-८१", "content_sanskrit": "प्राकारागारविध्वंसान्न स्म ते प्रतिकुर्वते।\n`क्षुद्राः संस्कारहीनाश्च नार्यो ह्युदरपोषणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2081600, "chapter_id": 2730, "verse_number": "१२-२३५-८२", "content_sanskrit": "शौचाचारपरिभ्रष्टा निर्लज्जा भोगवञ्चिताः।\nउभाभ्यामेव पाणिभ्यां शिरः कण्डूयनान्विताः।\nगृहजालाभिसंस्थाना ह्यासंस्तत्र स्त्रियः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2081601, "chapter_id": 2730, "verse_number": "१२-२३५-८३", "content_sanskrit": "श्वश्रूश्वशुरयोर्मध्ये भर्तारं कृतकं यथा।\nप्रेक्षयन्ति च निर्लज्जा नार्यः कुलजलक्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2081602, "chapter_id": 2730, "verse_number": "१२-२३५-८४", "content_sanskrit": "नाद्रियन्ते पशून्बद्ध्वा यवसेनोदकेन च।\nबालानां प्रेक्षमाणानां स्वयं भक्ष्यमभक्षयन्।\nतथा भृत्यजनं सर्वमसंतर्प्य च दानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2081603, "chapter_id": 2730, "verse_number": "१२-२३५-८५", "content_sanskrit": "पायसं कृसरं मांसमपूपानथ शष्कुलीः।\nअपाचयन्नात्मनोऽर्थे वृथा मांसान्यभक्षयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2081604, "chapter_id": 2730, "verse_number": "१२-२३५-८६", "content_sanskrit": "उत्सूर्यशायिनश्चासन्सर्वे चासन्प्रगेशयाः।\nआवृत्तकलहाश्चात्र दिवारात्रं गृहेगृहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2081605, "chapter_id": 2730, "verse_number": "१२-२३५-८७", "content_sanskrit": "अनार्याश्चार्यमासीनं पर्युपासन्न तत्र ह।\nआश्रमस्थान्विकर्मस्थाः प्राद्विषन्त परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2081606, "chapter_id": 2730, "verse_number": "१२-२३५-८८", "content_sanskrit": "संकराश्चाभ्यवर्तन्त न च शौचमवर्तत।\nये च वेदविदो विप्रा विस्पष्टमनुचश्च ये।\nनिरन्तरविशेषास्ते बहुमानावमानयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2081607, "chapter_id": 2730, "verse_number": "१२-२३५-८९", "content_sanskrit": "भावमाभरणं वेषं गतं स्थितमवेक्षितम्।\nअसेवन्त भुजिष्या वै दुर्जनाचरितं विधिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2081608, "chapter_id": 2730, "verse_number": "१२-२३५-९०", "content_sanskrit": "स्त्रियः पुरुषवेषेण पुंसः स्त्रीवेषधारिणः।\nक्रीडारतिविहारेषु परां मुदमवाप्नुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2081609, "chapter_id": 2730, "verse_number": "१२-२३५-९१", "content_sanskrit": "प्रभवद्भिः पुरा दायानर्हेभ्यः प्रतिपादितान्।\nनाभ्यवर्न्तत नास्तिक्याद्वर्तन्तः संभवेष्वपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2081610, "chapter_id": 2730, "verse_number": "१२-२३५-९२", "content_sanskrit": "मित्रेणाभ्यर्थितं द्रव्यमर्थी संश्रयते क्वचित्।\nवालकोट्यग्रमात्रेण स्वार्थेनाघ्नत तद्वसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2081611, "chapter_id": 2730, "verse_number": "१२-२३५-९३", "content_sanskrit": "परस्वादानरुचयो विपणव्यवहारिणः।\nअदृश्यन्तार्यवर्णषु शृद्राश्चापि तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2081612, "chapter_id": 2730, "verse_number": "१२-२३५-९४", "content_sanskrit": "अधीयतेऽव्रताः केचिद्वृथा व्रतमथापरे।\nअशुश्रूषुर्गुरोः शिष्यः कश्चिच्छिप्यसखो गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2081613, "chapter_id": 2730, "verse_number": "१२-२३५-९५", "content_sanskrit": "पिता चैव जनित्री च श्रान्तौ वृत्तोत्सवाविव।\nअप्रभुत्वे स्थितौ वृद्धावन्नं प्रार्थयतः सुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2081614, "chapter_id": 2730, "verse_number": "१२-२३५-९६", "content_sanskrit": "तत्र वेदविदः प्राज्ञा गाम्भीर्ये सागरोपमाः।\nकृष्यादिष्वभवन्सक्ता मूर्खाः श्राद्धान्यभुञ्जत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2081615, "chapter_id": 2730, "verse_number": "१२-२३५-९७", "content_sanskrit": "प्रातः सायं च सुप्रश्नं कल्पनं प्रेषणक्रियाः।\nशिष्यानप्रहितास्तेषामकुर्वन्गुरवश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2081616, "chapter_id": 2730, "verse_number": "१२-२३५-९८", "content_sanskrit": "श्वश्रूश्वशुरयोरग्रे वधूः प्रेष्यानशासत।\nअन्वशासच्च भर्तारं समाह्वायाभिजल्पति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2081617, "chapter_id": 2730, "verse_number": "१२-२३५-९९", "content_sanskrit": "प्रयत्नेनापि चारक्षच्चित्तं पुत्रस्य वै पिता।\nव्यभजच्चापि संरम्भाद्दुःखवासं तथाऽवसत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2081618, "chapter_id": 2730, "verse_number": "१२-२३५-१००", "content_sanskrit": "अग्निदाहेन चोरैर्वा राजभिर्वा हृतं धनम्।\nदृष्ट्वा द्वेषात्प्राहसन्त सुहृत्संभाविता ह्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2081619, "chapter_id": 2730, "verse_number": "१२-२३५-१०१", "content_sanskrit": "कृतघ्ना नास्तिकाः पापा गुरुदाराभिमर्शिनः।\n`श्वशुरानुगताः सर्वे ह्युत्सृज्य पितरौ सुताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2081620, "chapter_id": 2730, "verse_number": "१२-२३५-१०२", "content_sanskrit": "स्वकर्मणा च जातोऽहमित्येवंवादिनस्तथा।\nअभक्ष्यभक्षणरता निर्मर्यादा हतत्विषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2081621, "chapter_id": 2730, "verse_number": "१२-२३५-१०३", "content_sanskrit": "तेष्वेवमादीनाचारानाचरत्सु विपर्यये।\nनाहं देवेन्द्र वत्स्यामि दानवेष्विति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2081622, "chapter_id": 2730, "verse_number": "१२-२३५-१०४", "content_sanskrit": "तन्मां स्वयमनुप्राप्ताभिनन्द शचीपते।\nत्वयाऽर्चितां मां देवेश पुरो धास्यन्ति देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2081623, "chapter_id": 2730, "verse_number": "१२-२३५-१०५", "content_sanskrit": "यत्राहं तत्र मत्कान्ता मद्विशिष्टा मदर्पणाः।\nसप्तदेव्यो जयाष्टभ्यो वासमेष्यन्ति तेऽष्टधा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2081624, "chapter_id": 2730, "verse_number": "१२-२३५-१०६", "content_sanskrit": "आशा श्रद्धा धृतिः क्षान्तिर्विजितिः सन्नतिः क्षमा।\nअष्टमी वृत्तिरेतासां पुरोगा पाकशासन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2081625, "chapter_id": 2730, "verse_number": "१२-२३५-१०७", "content_sanskrit": "ताश्चाहं चासुरांस्त्यक्त्वा युष्मद्विषयमागताः।\nत्रिदशेषु निवत्स्यामो धर्मनिष्ठान्तरात्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2081626, "chapter_id": 2730, "verse_number": "१२-२३५-१०८", "content_sanskrit": "इत्युक्तवचनां देवीं प्रीत्यर्थं च ननन्दतुः।\nनारदश्चात्र देवर्षिर्वृत्रहन्ता च वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2081627, "chapter_id": 2730, "verse_number": "१२-२३५-१०९", "content_sanskrit": "ततोऽनलसखो वायुः प्रववौ देववर्त्मसु।\nइष्टगन्धः सुखस्पर्शः सर्वेन्द्रियसुखावहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2081628, "chapter_id": 2730, "verse_number": "१२-२३५-११०", "content_sanskrit": "शुचौ चाभ्यर्थिते देशे त्रिदशाः प्रायशः स्थिताः।\nलक्ष्मीसहितमासीनं मघवन्तं दिदृक्षवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2081629, "chapter_id": 2730, "verse_number": "१२-२३५-१११", "content_sanskrit": "ततो दिवं प्राप्य सहस्रलोचनः।\nस्त्रियोपपन्नः सुहृदा महर्षिणा।\nरथेन हर्यश्वयुजा सुरर्षभः\nसदः सुराणामभिसत्कृतो ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2081630, "chapter_id": 2730, "verse_number": "१२-२३५-११२", "content_sanskrit": "अथेङ्गितं वज्रधरस्य नारदः\nश्रियश्च देव्या मनसा विचारयन्।\nश्रियै शशंसामरदृष्टपौरुषः\nशिवेन तत्रागमनं महर्षिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2081631, "chapter_id": 2730, "verse_number": "१२-२३५-११३", "content_sanskrit": "ततोऽमृतं द्यौः प्रववर्ष भास्वती\nपितामहस्यायतने स्वयंभुवः।\nअनाहता दुन्दुभयोऽथ नेदिरे\nतथा प्रसन्नाश्च दिशश्चकाशिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2081632, "chapter_id": 2730, "verse_number": "१२-२३५-११४", "content_sanskrit": "यथर्तु सस्येषु ववर्ष वासवो\nन धर्ममार्गाद्विचचाल कश्चन।\nअनेकरत्नाकरभूषणा च भूः\nसुघोषघोषाश्च दिवौकसां जये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2081633, "chapter_id": 2730, "verse_number": "१२-२३५-११५", "content_sanskrit": "क्रियाभिरामा मनुजा मनस्विनो\nबभुः शुभे पुण्यकृतां पथि स्थिताः।\nनरामराः किन्नरयक्षराक्षसाः\nसमृद्धिमन्तः सुमनस्विनोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2081634, "chapter_id": 2730, "verse_number": "१२-२३५-११६", "content_sanskrit": "न जात्वकाले कुसुमं कुतः फलं\nपपात वृक्षात्पवनेरितादपि।\nरसप्रदाः कामदुघाश्च धेनवो\nन दारुणा वाग्विचचार कस्यचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2081635, "chapter_id": 2730, "verse_number": "१२-२३५-११७", "content_sanskrit": "इमां सपर्यां सह सर्वकामदैः\nश्रियाश्च शक्रप्रमुखैश्च दैवतैः।\nपठन्ति ये विप्रसदः समागताः\nसमृद्धकामाः श्रियमाप्नुवन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2081636, "chapter_id": 2730, "verse_number": "१२-२३५-११८", "content_sanskrit": "त्वया कुरूणां वर यत्प्रचोदितं\nभवाभवस्येह परं निदर्शनम्।\nतदद्य सर्वं परिकीर्तितं मया\nपरीक्ष्य तत्त्वं परिगन्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2081637, "chapter_id": 2730, "verse_number": "१२-२३५-११९", "content_sanskrit": "`संस्मृत्य बुद्धीन्द्रियगोचरातिगं\nस्वगोचरे सर्वकृतालयं तम्।\nहरिं महापाग्रहरं जनास्ते\nसंस्मृत्य संपूज्य विधूतपापाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2081638, "chapter_id": 2730, "verse_number": "१२-२३५-१२०", "content_sanskrit": "यमैश्च नित्यं नियमैश्च संयता\nस्तत्वं च विष्णोः परिपश्यमानाः।\nदेवानुसारेण विमुक्तियोगं\nते गाहमानाः परमाप्नुवन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2081639, "chapter_id": 2730, "verse_number": "१२-२३५-१२१", "content_sanskrit": "एवं राजेन्द्र सततं जपहोमपरायणः।\nवासुदेवपरो नित्यं ज्ञानध्यानपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2081640, "chapter_id": 2730, "verse_number": "१२-२३५-१२२", "content_sanskrit": "दानधर्मरतिर्नित्यं प्रजास्त्वं परिपालय।\nवासुदेवपरो नित्यं ज्ञानध्यानपरायणान्।\nविशेषेणार्चयेथास्त्वं सततं पर्युपास्व च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2081641, "chapter_id": 2730, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि प़ञ्चत्रिंशदधिकद्विशततमोऽध्यायः॥ २३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}]