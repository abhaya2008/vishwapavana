[{"id": 2096589, "chapter_id": 3069, "verse_number": "१३-१९९-१", "content_sanskrit": "[युधिष्ठिर उवाच।\nउक्तास्तु भवता भोज्यास्तथाऽभोज्याश्च सर्वशः।\nअत्र मे प्रश्नसन्देहस्तन्मे वद पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096590, "chapter_id": 3069, "verse_number": "१३-१९९-२", "content_sanskrit": "ब्राह्मणानां विशेषेण हव्यकव्यप्रतिग्रहे।\nनानाविधेषु भोज्येषु प्रायश्चित्तानि शंस मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096591, "chapter_id": 3069, "verse_number": "१३-१९९-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096592, "chapter_id": 3069, "verse_number": "१३-१९९-३", "content_sanskrit": "हन्त वक्ष्यामि ते राजन्ब्राह्मणानां महात्मनाम्।\nप्रतिग्रहेषु भोज्ये च मुच्यते येन पाप्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096593, "chapter_id": 3069, "verse_number": "१३-१९९-४", "content_sanskrit": "घृतप्रतिग्रहे चैव सावित्री समिदाहुतिः।\nतिलप्रतिग्रहे चैव सममेतद्युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096594, "chapter_id": 3069, "verse_number": "१३-१९९-५", "content_sanskrit": "मांसप्रतिग्रहे चैव मधुनो लवणस्य च।\nआदित्योदयनं स्थित्वा पूतो भवति ब्राह्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096595, "chapter_id": 3069, "verse_number": "१३-१९९-६", "content_sanskrit": "काञ्चनं प्रतिगृह्याथ जपमानो गुरुश्रुतिम्।\nकृष्णायसं च विवृतं धारयन्मुच्यते द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096596, "chapter_id": 3069, "verse_number": "१३-१९९-७", "content_sanskrit": "एवं प्रतिगृहीतेऽथ धने वस्त्रे तथा स्त्रियाम्।\nएवमेव नरश्रेष्ठ सुवर्णस्य प्रतिग्रहे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096597, "chapter_id": 3069, "verse_number": "१३-१९९-८", "content_sanskrit": "अन्नप्रतिग्रहे चैव पायसेक्षुरसे तथा।\nइक्षुतैलपवित्राणां त्रिसन्ध्येऽप्सु निमज्जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096598, "chapter_id": 3069, "verse_number": "१३-१९९-९", "content_sanskrit": "व्रीहौ पुष्पे फले चैव जले पिष्टमये तथा।\nयावके दधिदुग्धे च सावित्रीं शतशोऽन्विताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096599, "chapter_id": 3069, "verse_number": "१३-१९९-१०", "content_sanskrit": "उपानहौ च च्छत्रं च प्रतिगृह्यौर्ध्वदेहिके।\nजपेच्छतं समायुक्तस्तेन मुच्यते पाप्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096600, "chapter_id": 3069, "verse_number": "१३-१९९-११", "content_sanskrit": "क्षेत्रप्रतिग्रहे चैव ग्रहसूतकयोस्तथा।\nत्रीणि रात्राण्युपोषित्वा तेन पापाद्विमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096601, "chapter_id": 3069, "verse_number": "१३-१९९-१२", "content_sanskrit": "कृष्णपक्षे तु यः श्राद्धं पितॄणामश्नुते द्विजः।\nअन्नमेतदहोरात्रात्पूतो भवति ब्राह्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096602, "chapter_id": 3069, "verse_number": "१३-१९९-१३", "content_sanskrit": "न च सन्ध्यामुपासीत न च जाप्यं प्रवर्तयेत्।\nन सङ्किरेत्तदन्नं च ततः पूयेत ब्राह्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2096603, "chapter_id": 3069, "verse_number": "१३-१९९-१४", "content_sanskrit": "इत्यर्थमपराङ्णे तु पितॄणां श्राद्धमुच्यते।\nयथोक्तानां यदश्नीयुर्ब्राह्मणाः पूर्वकेतिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2096604, "chapter_id": 3069, "verse_number": "१३-१९९-१५", "content_sanskrit": "मृतकस्य तृतीयाहे ब्राह्मणो योऽन्नमश्नुते।\nस त्रिवेलं समुन्मज्ज्य द्वादशाहेन शुध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2096605, "chapter_id": 3069, "verse_number": "१३-१९९-१६", "content_sanskrit": "द्वादशाहे व्यतीते तु कृतशौचो विशेषतः।\nब्राह्मणेभ्यो हविर्दत्त्वा मुच्यते तेन पाप्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2096606, "chapter_id": 3069, "verse_number": "१३-१९९-१७", "content_sanskrit": "मृतस्य दशरात्रेण प्रायश्चित्तानि दापयेत्।\nसावित्रीं रैवतीमिष्टिं कूश्माण्डमघमर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2096607, "chapter_id": 3069, "verse_number": "१३-१९९-१८", "content_sanskrit": "मृतकस्य त्रिरात्रे यः समुद्दिष्टे समश्नुते।\nसप्तत्रिषवणं स्नात्वा पूतो भवति ब्राह्मणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2096608, "chapter_id": 3069, "verse_number": "१३-१९९-१९", "content_sanskrit": "सिद्धिमाप्नोति विपुलामापदं चैव नाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2096609, "chapter_id": 3069, "verse_number": "१३-१९९-२०", "content_sanskrit": "यस्तु शूद्रैः समश्नीयाद्ब्राह्मणोऽप्येकभोजने।\nअशौचं विधिवत्तस्य शौचमत्र विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2096610, "chapter_id": 3069, "verse_number": "१३-१९९-२१", "content_sanskrit": "यस्तु वैश्यैः सहाश्नीयाद्ब्राह्मणोऽप्येकभोजने।\nस वै त्रिरात्रं दीक्षित्वा मुच्यते तेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2096611, "chapter_id": 3069, "verse_number": "१३-१९९-२२", "content_sanskrit": "क्षत्रियैः सह योऽश्नीयाद्ब्राह्मणोऽप्येकभोजने।\nआप्लुतः सह वासोभिस्तेन मुच्येत पाप्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2096612, "chapter_id": 3069, "verse_number": "१३-१९९-२३", "content_sanskrit": "शूद्रास्य तु कुलं हन्ति वैश्यस्य पशुबान्धवान्।\nक्षत्रियस्य श्रियं हन्ति ब्राह्मणस्य सुवर्चसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2096613, "chapter_id": 3069, "verse_number": "१३-१९९-२४", "content_sanskrit": "प्रायश्चित्तं च शान्तिं च जुहुयात्तेन मुच्यते।\nसावित्रीं रैवतीमिष्टिं कूश्माण्डमघमर्षणम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2096614, "chapter_id": 3069, "verse_number": "१३-१९९-२५", "content_sanskrit": "तथोच्छिष्टमथान्योन्यं सम्प्राशेन्नात्र संशयः।\nरोचना विरजा रात्रिर्मङ्गलालम्भनानि च॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2096615, "chapter_id": 3069, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकोनद्विशततमोध्यायः॥ १९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]