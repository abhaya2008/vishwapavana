[{"id": 7000507000, "chapter_id": 20507, "verse_number": "३-५४-१", "content_sanskrit": "व्यास उवाच ।\nवेदं वेदौ तथा वेदान्वेदांगानि तथा द्विजाः ।\nअधीत्य चाधिगम्यार्थं ततः स्नायाद्द्विजोत्तमः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000507001, "chapter_id": 20507, "verse_number": "३-५४-२", "content_sanskrit": "गुरवे तु धनं दत्वा स्नायीत तदनुज्ञया ।\nतीर्णव्रतोथ युक्तात्मा शक्तो वा स्नातुमर्हति॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000507002, "chapter_id": 20507, "verse_number": "३-५४-३", "content_sanskrit": "वैणवीं धारयेद्यष्टिमंतर्वासस्तथोत्तरम् ।\nयज्ञोपवीतद्वितयं सोदकं च कमंडलुम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000507003, "chapter_id": 20507, "verse_number": "३-५४-४", "content_sanskrit": "छत्रं चोष्णीषममलं पादुके चाप्युपानहौ ।\nरौक्मे च कुंडले धार्ये कृत्तकेशनखः शुचिः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000507004, "chapter_id": 20507, "verse_number": "३-५४-५", "content_sanskrit": "अन्यत्र कांचनाद्विप्रो न रक्तां बिभृयात्स्रजम् ।\nशुक्लांबरधरो नित्यं सुगंधः प्रियदर्शनः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000507005, "chapter_id": 20507, "verse_number": "३-५४-६", "content_sanskrit": "न जीर्ण मलवद्वासा भवेद्वै विभवे सति ।\nन रक्तमुल्बणं चान्य धृतं वासो न कुंडलम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000507006, "chapter_id": 20507, "verse_number": "३-५४-७", "content_sanskrit": "नोपानहौ स्रजं चाथ पादुके च प्रयोजयेत् ।\nउपवीतमलंकारं दर्शयन्कृष्णमाजिनम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000507007, "chapter_id": 20507, "verse_number": "३-५४-८", "content_sanskrit": "नापसव्यं परीदध्याद्वासो न विकृतं वसेत् ।\nआहरेद्विधिवद्दारान्सदृशानात्मनः शुभान्॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000507008, "chapter_id": 20507, "verse_number": "३-५४-९", "content_sanskrit": "रूपलक्षणसंयुक्तान्योनिदोषविवर्जितान् ।\nअपितृगोत्रजभवामन्यमानुषगोत्रजाम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000507009, "chapter_id": 20507, "verse_number": "३-५४-१०", "content_sanskrit": "आहरेद्ब्राह्मणो भार्यां शीलशौचसमन्विताम् ।\nऋतुकालाभिगामी स्याद्यावत्पुत्रोभिजायते॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000507010, "chapter_id": 20507, "verse_number": "३-५४-११", "content_sanskrit": "वर्जयेत्प्रतिषिद्धानि प्रयत्नेन दिनानि तु ।\nषष्ठ्यष्टमीं पंचदशीं द्वादशीं च चतुर्दशीम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000507011, "chapter_id": 20507, "verse_number": "३-५४-१२", "content_sanskrit": "ब्रह्मचारी भवेन्नित्यं तद्वज्जन्मत्रयाहनि ।\nआदधीत विवाहाग्निं जुहुयाज्जातवेदसम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000507012, "chapter_id": 20507, "verse_number": "३-५४-१३", "content_sanskrit": "एतानि स्नातको नित्यं पावनानि च पावयेत् ।\nवेदोदितं स्वकं कर्म्म नित्यं कुर्यादतंद्रितः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000507013, "chapter_id": 20507, "verse_number": "३-५४-१४", "content_sanskrit": "अकुर्वाणः पतत्याशु नरकानतिभीषणान् ।\nअभ्यसेत्प्रयतो वेदं महायज्ञान्न हापयेत्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000507014, "chapter_id": 20507, "verse_number": "३-५४-१५", "content_sanskrit": "कुर्याद्गृह्याणि कार्याणि संध्योपासनमेव च ।\nसख्यं समाधिकैः कुर्यादुपेयादीश्वरं सदा॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000507015, "chapter_id": 20507, "verse_number": "३-५४-१६", "content_sanskrit": "दैवतान्यभिगच्छेत कुर्य्याद्भार्य्याभिपोषणम् ।\nन धर्मं ख्यापयेद्विद्वान्न पापं गूहयेदपि॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000507016, "chapter_id": 20507, "verse_number": "३-५४-१७", "content_sanskrit": "कुर्वीतात्महितं नित्यं सर्वभूतानुकंपकः ।\nवयसः कर्म्मणोऽर्थस्य श्रुतस्याभिजनस्य च॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000507017, "chapter_id": 20507, "verse_number": "३-५४-१८", "content_sanskrit": "देशवाग्बुद्धिसारूप्यमाचरन्विचरेत्सदा ।\nश्रुतिस्मृत्युदितं सम्यक्साधुभिर्यश्च सेवितः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000507018, "chapter_id": 20507, "verse_number": "३-५४-१९", "content_sanskrit": "तमाचारं निषेवेत नेहेतान्यत्र कर्हिचित् ।\nयेनास्य पितरो याता येन याताः पितामहाः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000507019, "chapter_id": 20507, "verse_number": "३-५४-२०", "content_sanskrit": "तेन यायात्सतां मार्गं तेन गच्छन्न दुष्यति ।\nनित्यं स्वाध्यायशीलः स्यान्नित्यं यज्ञोपवीतवान्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000507020, "chapter_id": 20507, "verse_number": "३-५४-२१", "content_sanskrit": "सत्यवादी जितक्रोधो लोभमोहविवर्जितः ।\nसावित्रीजाप निरतः श्राद्धकृन्मुच्यते गृही॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000507021, "chapter_id": 20507, "verse_number": "३-५४-२२", "content_sanskrit": "मातापित्रोर्हिते युक्तो ब्राह्मणस्य हिते रतः ।\nदाता यज्वा देवभक्तो ब्रह्मलोके महीयते॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000507022, "chapter_id": 20507, "verse_number": "३-५४-२३", "content_sanskrit": "त्रिवर्गसेवी सततं देवानां च समर्चनम् ।\nकुर्यादहरहर्नित्यं नमस्येत्प्रयतः सुरान्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000507023, "chapter_id": 20507, "verse_number": "३-५४-२४", "content_sanskrit": "विभागशीलः सततं क्षमायुक्तो दयालुकः ।\nगृहस्थस्तु समाख्यातो न गृहेण गृही भवेत्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000507024, "chapter_id": 20507, "verse_number": "३-५४-२५", "content_sanskrit": "क्षमा दया च विज्ञानं सत्यं चैव दमः शमः ।\nअध्यात्मनित्यता ज्ञानमेतद्ब्राह्मणलक्षणम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000507025, "chapter_id": 20507, "verse_number": "३-५४-२६", "content_sanskrit": "एतस्मान्न प्रमाद्येत विशेषेण द्विजोत्तमः ।\nयथाशक्ति चरन्धर्म्मं निंदितानि विवर्जयेत्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000507026, "chapter_id": 20507, "verse_number": "३-५४-२७", "content_sanskrit": "विधूय मोहकलिलं लब्ध्वा योगमनुत्तमम् ।\nगृहस्थो मुच्यते बंधान्नात्र कार्याविचारणा॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000507027, "chapter_id": 20507, "verse_number": "३-५४-२८", "content_sanskrit": "विगर्हित जय क्षेप हिंसा बंधवधात्मनाम् ।\nअन्यमन्यु समुत्थानां दोषाणां मर्षणं क्षमा॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000507028, "chapter_id": 20507, "verse_number": "३-५४-२९", "content_sanskrit": "स्वदुःखेष्वेव कारुण्यं परदुःखेषु सौहृदम् ।\nदयेति मुनयः प्राहुः साक्षाद्धर्मस्य साधनम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000507029, "chapter_id": 20507, "verse_number": "३-५४-३०", "content_sanskrit": "चतुर्दशानां विद्यानां धारणा हि परार्थतः ।\nविज्ञानमिति तद्विद्याद्येन धर्मो विवर्धते॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000507030, "chapter_id": 20507, "verse_number": "३-५४-३१", "content_sanskrit": "अधीत्य विधिवद्विद्यामर्थं चैवोपलभ्यते ।\nधर्मकार्याणि कुर्वीत ह्येतद्विज्ञानमुच्यते॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000507031, "chapter_id": 20507, "verse_number": "३-५४-३२", "content_sanskrit": "सत्येन लोकं जयति सत्यं तत्परमं पदम् ।\nयथा भूता प्रमादं तु सत्यमाहुर्मनीषिणः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000507032, "chapter_id": 20507, "verse_number": "३-५४-३३", "content_sanskrit": "दमः शरीरोपरतिः शमः प्रज्ञाप्रसादतः ।\nअध्यात्ममक्षरं विद्या यत्र गत्वा न शोचति॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000507033, "chapter_id": 20507, "verse_number": "३-५४-३४", "content_sanskrit": "यया स देवोभगवान्विद्यया विद्यते परः ।\nसाक्षादेव हृषीकेशस्तज्ज्ञानमिति कीर्तितम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000507034, "chapter_id": 20507, "verse_number": "३-५४-३५", "content_sanskrit": "तन्निष्ठस्तत्परो विद्वान्नित्यमक्रोधनः शुचिः ।\nमहायज्ञपरो विप्रो लभते तदनुत्तमम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000507035, "chapter_id": 20507, "verse_number": "३-५४-३६", "content_sanskrit": "धर्मस्यायतनं यत्नाच्छरीरं परिपालयेत् ।\nनहि देहं विना विष्णुः पुरुषैर्विद्यतेपरः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000507036, "chapter_id": 20507, "verse_number": "३-५४-३७", "content_sanskrit": "नित्यं धर्मार्थकामेषु युज्येत नियतो द्विजः ।\nन धर्मवर्जितं काममर्थं वा मनसा स्मरेत्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000507037, "chapter_id": 20507, "verse_number": "३-५४-३८", "content_sanskrit": "सीदन्नपि हि धर्मेण न त्वधर्मं समाचरेत् ।\nधर्मो हि भगवान्देवो गतिः सर्वेषु जंतुषु॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000507038, "chapter_id": 20507, "verse_number": "३-५४-३९", "content_sanskrit": "भूतानांप्रियकारीस्यान्नपरद्रो हकर्मधीः ।\nन वेददेवतानिंदां कुर्य्यात्तैश्च न संवसेत्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000507039, "chapter_id": 20507, "verse_number": "३-५४-४०", "content_sanskrit": "यस्त्विमं नियतो मर्त्यो धर्माध्यायं पठेच्छुचिः ।\nअध्यापयेच्छ्रावयेद्वा ब्रह्मलोके महीयते॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]