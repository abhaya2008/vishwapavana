[{"id": 7002276000, "chapter_id": 22276, "verse_number": "३२१-१", "content_sanskrit": "ईश्वर उवाच ।\nअस्त्रयागः पुरा कार्य्यः सर्वकर्म्मसु सिद्धिदः ।\nमध्ये पूज्यं शिवाद्यस्त्रं वज्रादीन् पूर्वतः क्रमात् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002276001, "chapter_id": 22276, "verse_number": "३२१-२", "content_sanskrit": "पञ्चचक्रं दश करं रणादौ पूजितं जये ।\nग्रहपूजा रविर्मध्ये पूर्व्वाद्याः सोमकादयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002276002, "chapter_id": 22276, "verse_number": "३२१-३", "content_sanskrit": "सर्व्व एकादशस्थास्तु ग्रहाः स्युः ग्रहपूजनात् ।\nअस्त्रशान्तिं प्रवक्ष्यामि सर्वोत्पातविनाशिनीं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002276003, "chapter_id": 22276, "verse_number": "३२१-४", "content_sanskrit": "ग्रहरोगादिशमनीं मारीशत्रुविमर्द्दनीं ।\nविनायकोपतप्तिघ्नमघोरास्त्रं जपेन्नरः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002276004, "chapter_id": 22276, "verse_number": "३२१-५", "content_sanskrit": "लक्षं ग्रहादिनाशः स्यादुत्पाते तिलहोमकम् ।\nदिव्ये लक्षं तदर्द्धेन व्योमजोत्पातनाशनं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002276005, "chapter_id": 22276, "verse_number": "३२१-६", "content_sanskrit": "घृतेन लक्षपातेन उत्पाते भूमिजे हितम् ।\nघृतगुग्गुलुहोमे च सर्व्वोत्पातादिमर्द्दनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002276006, "chapter_id": 22276, "verse_number": "३२१-७", "content_sanskrit": "दूर्वाक्षताज्यहोमेन व्याधयोऽथ घृतेन च ।\nसहस्रेण तु दुःस्वप्ना विनश्यन्ति न संशयः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002276007, "chapter_id": 22276, "verse_number": "३२१-८", "content_sanskrit": "अयुताद् ग्रहदोषघ्नो जवाघृतविमिश्रितात् ।\nविनायकार्त्तिशमनमयुतेन घृतस्य च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002276008, "chapter_id": 22276, "verse_number": "३२१-९", "content_sanskrit": "भूतवेतालशान्तिस्तु गुग्गुलोरयुतेन च ।\nमहावृक्षस्य भङ्गे तु व्यालकङ्के गृहे स्थिते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002276009, "chapter_id": 22276, "verse_number": "३२१-१०", "content_sanskrit": "आरण्यानां प्रवेशे च दूर्वाज्याक्षतहावनात् ।\nउल्कापाते भूमिकम्पे तिलाज्येनाहुताच्छिवम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002276010, "chapter_id": 22276, "verse_number": "३२१-११", "content_sanskrit": "रक्तस्रावे तु वृक्षाणामयुताद् गुग्गुलोः शिवं ।\nअकाले फलपुष्पणां राष्ट्रभङ्गे च मारणे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002276011, "chapter_id": 22276, "verse_number": "३२१-१२", "content_sanskrit": "द्विपदादेर्यदा मारी लक्षार्द्धाच्च तिलाज्यतः ।\nहस्तिमारीप्रशान्त्यर्थ करिणीदन्तवर्द्धने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002276012, "chapter_id": 22276, "verse_number": "३२१-१३", "content_sanskrit": "हस्तिन्यां मददृष्टौ च अयुताच्छान्तिरिष्यते ।\nअकाले गर्भपाते तु जातं यत्र विनश्यति ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002276013, "chapter_id": 22276, "verse_number": "३२१-१४", "content_sanskrit": "विकृता यत्र जायन्ते यात्राकालेऽयुतं हुनेत् ।\nतिलाज्यलक्षहोमन्तु उत्तमासिद्धिसाधने ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002276014, "chapter_id": 22276, "verse_number": "३२१-१५", "content_sanskrit": "मध्यमायां तदर्द्धेन तत्पादादधमासु च ।\nयथा जपस्तथा होमः संग्रामे विजयो भवेत ।\nअघोरास्त्रं जपेन्न्यस्य ध्यात्वा पञ्चास्यमूर्ज्जितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]