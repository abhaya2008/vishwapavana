[{"id": 2007394, "chapter_id": 1143, "verse_number": "१-१४४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2007395, "chapter_id": 1143, "verse_number": "१-१४४-१", "content_sanskrit": "कृतास्त्रान्धार्तराष्ट्रांश्च पाण्डुपुत्रांश्च भारत।\nदृष्ट्वा द्रोणोऽब्रवीद्राजन्धृतराष्ट्रं जनेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2007396, "chapter_id": 1143, "verse_number": "१-१४४-२", "content_sanskrit": "कृपस्य सोमदत्तस्य वाह्लीकस्य च धीमतः।\nगाङ्गेयस्य च सान्निध्ये व्यासस्य विदुरस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2007397, "chapter_id": 1143, "verse_number": "१-१४४-३", "content_sanskrit": "राजन्संप्राप्तविद्यास्ते कुमाराः कुरुसत्तम।\nते दर्शयेयुः स्वां शिक्षां राजन्ननुमते तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2007398, "chapter_id": 1143, "verse_number": "१-१४४-४", "content_sanskrit": "ततोऽब्रवीन्महाराजः प्रहृष्टेनान्तरात्मना।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2007399, "chapter_id": 1143, "verse_number": "१-१४४-४x", "content_sanskrit": "धृतराष्ट्र उवाच।\nभारद्वाज महत्कर्म कृतं ते द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2007400, "chapter_id": 1143, "verse_number": "१-१४४-५", "content_sanskrit": "यदानुमन्यसे कालं यस्मिन्देशे यथायथा।\nतथातथा विधानाय स्वयमाज्ञापयस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2007401, "chapter_id": 1143, "verse_number": "१-१४४-६", "content_sanskrit": "स्पृहयाम्यद्य निर्वेदान्पुरुषाणां सचक्षुषाम्।\nअस्त्रहेतोः पराक्रान्तान्ये मे द्रक्ष्यन्ति पुत्रकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2007402, "chapter_id": 1143, "verse_number": "१-१४४-७", "content_sanskrit": "क्षत्तर्यद्गुरुराचार्यो ब्रवीति कुरु तत्तथा।\nन हीदृशं प्रियं मन्ये भविता धर्मवत्सल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2007403, "chapter_id": 1143, "verse_number": "१-१४४-८", "content_sanskrit": "ततो राजानमामन्त्र्य विदुरानुमतोपि हि।\nभारद्वाजो महाप्राज्ञो मापयामास मेदिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2007404, "chapter_id": 1143, "verse_number": "१-१४४-९", "content_sanskrit": "समामवृक्षां निर्गुलमामुदक्प्रवणसंस्थिताम्।\nतस्यां भूमौ बलिं चक्रे तिथौ नक्षत्रपूजिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2007405, "chapter_id": 1143, "verse_number": "१-१४४-१०", "content_sanskrit": "अवघुष्टं पुरं चापि तदर्थं भरतर्षभ।\nरङ्गभूमौ सुविपुलं शास्त्रदृष्टं यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2007406, "chapter_id": 1143, "verse_number": "१-१४४-११", "content_sanskrit": "प्रेक्षागारं सुविहितं चक्रस्ते तस्य शिल्पिनः।\nरक्षां सर्वायुधोपेतां स्त्रीणां चैव नरर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2007407, "chapter_id": 1143, "verse_number": "१-१४४-१२", "content_sanskrit": "मञ्चांश्च कारयामासुर्यत्र जानपदा जनाः।\nविपुलानुच्छ्रयोपेताञ्शिबिकाश्च महाधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2007408, "chapter_id": 1143, "verse_number": "१-१४४-१३", "content_sanskrit": "तस्मिंस्ततोऽहनि प्राप्ते राजा ससचिवस्तदा।\nसान्तःपुरः सहामात्यो व्यासस्यानुमते तदा।\nभीष्मं प्रमुखतः कृत्वा कृपं चाचार्यसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2007409, "chapter_id": 1143, "verse_number": "१-१४४-१४", "content_sanskrit": "बाह्लीकं सोमदत्तं च भूरिश्रवसमेव च।\nकुरूनन्यांश्च सचिवानादाय नगराद्बहिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2007410, "chapter_id": 1143, "verse_number": "१-१४४-१५", "content_sanskrit": "रङ्गभूमिं समासाद्य ब्राह्मणैः सहितो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2007411, "chapter_id": 1143, "verse_number": "१-१४४-१६", "content_sanskrit": "मुक्ताजालपरिक्षिप्तं वैदूर्यममिशोभितम्।\nशातकुम्भमयं दिव्यं प्रेक्षागारमुपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2007412, "chapter_id": 1143, "verse_number": "१-१४४-१७", "content_sanskrit": "गान्धारी च महाभागा कुन्ती च जयतां वर।\nस्त्रियश्च राज्ञः सर्वास्ताः सप्रेष्याः सपरिच्छदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2007413, "chapter_id": 1143, "verse_number": "१-१४४-१८", "content_sanskrit": "हर्षादारुरुहुर्मञ्चान्मेरुं देवस्त्रियो यथा।\nब्राह्मणक्षत्रियाद्यं च चातुर्वर्ण्यं पुराद्द्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2007414, "chapter_id": 1143, "verse_number": "१-१४४-१९", "content_sanskrit": "दर्शनेप्सुः समभ्यागात्कुमाराणां कृतास्त्रताम्।\nक्षणेनैकस्थतां तत्र दर्शनेप्सुर्जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2007415, "chapter_id": 1143, "verse_number": "१-१४४-२०", "content_sanskrit": "प्रवादितैश्च वादित्रैर्जनकौतूहलेन च।\nमहार्णव इव क्षुब्धः समाजः सोऽभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2007416, "chapter_id": 1143, "verse_number": "१-१४४-२१", "content_sanskrit": "ततः शुक्लाम्बरधरः शुक्लयज्ञोपवीतवान्।\nशुक्लकेशः सितश्मश्रुः शुक्लाल्यानुलेपनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2007417, "chapter_id": 1143, "verse_number": "१-१४४-२२", "content_sanskrit": "रङ्गमध्यं तदाचार्यः सपुत्रः प्रविवेश ह।\nनभो जलधरैर्हीनं साङ्गारक इवांशुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2007418, "chapter_id": 1143, "verse_number": "१-१४४-२३", "content_sanskrit": "व्यासस्यानुमते चक्रे बलिं बलवतां वरः।\nब्राह्मणांस्तु सुमन्त्रज्ञान्कारयामास मङ्गलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2007419, "chapter_id": 1143, "verse_number": "१-१४४-२४", "content_sanskrit": "सुवर्णमणिरत्नानि वस्त्राणि विविधानि च।\nप्रददौ दक्षिणां राजा द्रोणाय च कृपाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2007420, "chapter_id": 1143, "verse_number": "१-१४४-२५", "content_sanskrit": "सुखपुण्याहघोषस्य पुण्यस्य समनन्तरम्।\nविविशुर्विविधं गृह्य शस्त्रोपकरणं नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2007421, "chapter_id": 1143, "verse_number": "१-१४४-२६", "content_sanskrit": "ततो बद्धाङ्गुलित्राणा बद्धकक्ष्या महारथाः।\nबद्धथूणाः सधनुषो विविशुर्भरतर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2007422, "chapter_id": 1143, "verse_number": "१-१४४-२७", "content_sanskrit": "रङ्गमध्ये स्थितं द्रोणमभिवाद्य नरर्षभाः।\nचक्रुः पूजां यथान्यायं द्रोणस्य च कृपस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2007423, "chapter_id": 1143, "verse_number": "१-१४४-२८", "content_sanskrit": "आशीर्भिश्च प्रयुक्ताभिः सर्वे संहृष्टमानसाः।\nअभिवाद्य पुनः शस्त्रान्बलिपुष्पैः समर्चितान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2007424, "chapter_id": 1143, "verse_number": "१-१४४-२९", "content_sanskrit": "रक्तचन्दनसंमिश्रैः स्वयमर्चन्ति कौरवाः।\nरक्तचन्दनदिग्धाश्च रक्तमाल्यानुधारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2007425, "chapter_id": 1143, "verse_number": "१-१४४-३०", "content_sanskrit": "सर्वे रक्तपताकाश्च सर्वे रक्तान्तलोचनाः।\nद्रोणेन समनुज्ञाता गृह्य शस्त्रं परन्तपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2007426, "chapter_id": 1143, "verse_number": "१-१४४-३१", "content_sanskrit": "धनूंषि पूर्व संगृह्य तप्तकाञ्चनभूषिताः।\nसज्यानि विविधाकाराः शरैः सन्धाय कौरवा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2007427, "chapter_id": 1143, "verse_number": "१-१४४-३२", "content_sanskrit": "ज्याघोषं तलघोषं च कृत्वा भूतान्यमोहयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2007428, "chapter_id": 1143, "verse_number": "१-१४४-३३", "content_sanskrit": "अनुज्येष्ठं च ते तत्र युधिष्ठिरपुनरोगमाः।\nचक्रुरस्त्रं महावीर्याः कुमाराः परमाद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2007429, "chapter_id": 1143, "verse_number": "१-१४४-३४", "content_sanskrit": "केषांचित्तत्र माल्येषु शरा निपतिता नृप।\nकेषांचित्पुष्पमुकुटे निपतन्ति स्म सायकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2007430, "chapter_id": 1143, "verse_number": "१-१४४-३५", "content_sanskrit": "केचिल्लक्ष्याणि विविधैर्बाणैराहितलक्षणैः।\nबिभिदुर्लाघवोत्सृष्टैर्गुरूणि च लघूनि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2007431, "chapter_id": 1143, "verse_number": "१-१४४-३६", "content_sanskrit": "केचिच्छराक्षेपभयाच्छिरांस्यवननामिरे।\nमनुजा धृष्टमपरे वीक्षाञ्चक्रुः सुविस्मिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2007432, "chapter_id": 1143, "verse_number": "१-१४४-३७", "content_sanskrit": "ते स्म लक्ष्याणि बिभिदुर्बाणैर्नामाङ्कशोभितैः।\nविविधैर्लाघवोत्सृष्टैरुह्यन्तो वाजिभिर्द्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2007433, "chapter_id": 1143, "verse_number": "१-१४४-३८", "content_sanskrit": "तत्कुमारबलं तत्र गृहीतशरकार्मुकम्।\nगन्धर्वनगराकारं प्रेक्ष्य ते विस्मिताभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2007434, "chapter_id": 1143, "verse_number": "१-१४४-३९", "content_sanskrit": "सहसा चुक्रुशुश्चान्ये नराः शतसहस्रशः।\nविस्मयोत्फुल्लनयनाः साधुसाध्विति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2007435, "chapter_id": 1143, "verse_number": "१-१४४-४०", "content_sanskrit": "कृत्वा धनुषि ते मार्गान्रथचर्यासु चासकृत्।\nगजपृष्ठेऽश्वपृष्ठे च नियुद्धे च महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2007436, "chapter_id": 1143, "verse_number": "१-१४४-४१", "content_sanskrit": "गृहीतखड्गचर्माणस्ततो भूयः प्रहारिणः।\nत्सरुमार्गान्यथोद्दिष्टांश्चेरुः सर्वासु भूमिषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2007437, "chapter_id": 1143, "verse_number": "१-१४४-४२", "content_sanskrit": "लाघवं सौष्ठवं शोभां स्थिरत्वं दृढमुष्टिताम्।\nददृशुस्तत्र सर्वेषां प्रयोगं खड्गचर्मणोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2007438, "chapter_id": 1143, "verse_number": "१-१४४-४३", "content_sanskrit": "अथ तौ नित्यसंहृष्टौ सुयोधनवृकोदरौ।\nअवतीर्णौ गदाहस्तावेकशृङ्गाविवाचलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2007439, "chapter_id": 1143, "verse_number": "१-१४४-४४", "content_sanskrit": "बद्धकक्ष्यौ महाबाहू पौरुषे पर्यवस्थितौ।\nबृंहन्तौ वासिताहेतोः समदाविव कुञ्जरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2007440, "chapter_id": 1143, "verse_number": "१-१४४-४५", "content_sanskrit": "तौ प्रदक्षिणसव्यानि मण्डलानि महाबलौ।\nचेरतुर्मण्डलगतौ समदाविव कुञ्जरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2007441, "chapter_id": 1143, "verse_number": "१-१४४-४६", "content_sanskrit": "विदुरो धृतराष्ट्राय गान्धार्याः पाण्डवारणिः।\nन्यवेदयेतां तत्सर्वं कुमाराणां विचेष्टितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2007442, "chapter_id": 1143, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि चतुश्चत्वारिंशदधिकशततमोऽध्यायः॥ १४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]