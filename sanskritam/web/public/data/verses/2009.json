[{"id": 2045296, "chapter_id": 2009, "verse_number": "६-५८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045297, "chapter_id": 2009, "verse_number": "६-५८-१", "content_sanskrit": "ततस्ते पार्थिवाः क्रुद्धाः फल्गुनं वीक्ष्य संयुगे।\nरथैरनेकसाहस्रैः समन्तात्पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045298, "chapter_id": 2009, "verse_number": "६-५८-२", "content_sanskrit": "अथैनं रथबृन्देन कोष्ठकीकृत्य भारत।\nशरैः सुबहुसाहस्रैः समन्तादभ्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045299, "chapter_id": 2009, "verse_number": "६-५८-३", "content_sanskrit": "शक्तीश्च विमलाकस्तीक्ष्णा गदाश्च परिघैः सह ।\nप्रासान्परश्वथांश्चैव मुद्गरान्मुसलानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2045300, "chapter_id": 2009, "verse_number": "६-५८-४", "content_sanskrit": "चिक्षिषुः समरे क्रुद्धाः फल्गुनस्य रथं प्रति।\nशस्त्राणामथ तां वृष्टिं शलभानामिवायतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2045301, "chapter_id": 2009, "verse_number": "६-५८-५", "content_sanskrit": "रुरोध सर्वतः पार्थः शरैः कनकभूषणैः ।\nतत्र तल्लाघवं दृष्ट्वा बीभत्सोरतिमानुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2045302, "chapter_id": 2009, "verse_number": "६-५८-६", "content_sanskrit": "देवदानवगन्धर्वाः पिशाचोरगराक्षसाः ।\nसाधुसाध्विति राजेन्द्र फल्गुनं प्रत्यपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2045303, "chapter_id": 2009, "verse_number": "६-५८-७", "content_sanskrit": "सात्यकिश्चाभिमन्युश्च महत्या सेकनया वृतौ ।\nगान्धारान्समरे शूराञ्जग्मतुः सहसौबलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2045304, "chapter_id": 2009, "verse_number": "६-५८-८", "content_sanskrit": "तत्र सौबलकाः क्रुद्धा वार्ष्णेयस्य रथोत्तमम् ।\nतिशलश्चिच्छिदुः क्रोधाच्छस्त्रैर्नानाविधैर्युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2045305, "chapter_id": 2009, "verse_number": "६-५८-९", "content_sanskrit": "सात्यकिस्तु रथं त्यक्त्वा वर्तमाने भयावहे ।\nअभिमन्यो रथं तूर्णमारुरोह परंतपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2045306, "chapter_id": 2009, "verse_number": "६-५८-१०", "content_sanskrit": "तावेकरथसंयुक्तौ सौबलेयस्य वाहिनीम् ।\nव्यधमेतां शितैस्तूर्णं शरैःक सन्नतपर्वभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2045307, "chapter_id": 2009, "verse_number": "६-५८-११", "content_sanskrit": "द्रोणभीष्मौ रणे यत्तौ धर्मराजस्य वाहिनीम् ।\nनाशयेतां शरैस्तीक्ष्णैः कङ्कपत्रपरिच्छदैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2045308, "chapter_id": 2009, "verse_number": "६-५८-१२", "content_sanskrit": "ततो धर्मसुतोक राजा माद्रीपुत्रौ च पाण्डवौ ।\nमिषतां सर्वसैन्यानां द्रोणानीकमुपाद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2045309, "chapter_id": 2009, "verse_number": "६-५८-१३", "content_sanskrit": "तत्रासीत्सुमहद्युद्धं तुमुलं रोमहर्षणम् ।\nयथा देवासुरं युद्धं पूर्वमासीत्सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2045310, "chapter_id": 2009, "verse_number": "६-५८-१४", "content_sanskrit": "कुर्वाणौ सुमहत्कर्म भीमसेनघटोत्कचौ।\nदुर्योधनस्ततोऽभ्येत्य तावुभावप्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2045311, "chapter_id": 2009, "verse_number": "६-५८-१५", "content_sanskrit": "तत्राद्भुतमपश्याम हैडिम्बस्य पराक्रमम्।\nअतीत्य पीतरं युद्धे यदयुध्यत भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2045312, "chapter_id": 2009, "verse_number": "६-५८-१६", "content_sanskrit": "भीमसेनस्तु संक्रुद्धो दुर्योधनममर्षणम्।\nहृद्यविध्यत्पृषत्केन प्रहसन्निव पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2045313, "chapter_id": 2009, "verse_number": "६-५८-१७", "content_sanskrit": "ततो दुर्योधननो राजा प्रहारवरपीडितः।\nनिषसाद रथोपस्थे कश्मलं च जगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2045314, "chapter_id": 2009, "verse_number": "६-५८-१८", "content_sanskrit": "तं विसंज्ञं विदित्वा तु त्वरमाणोऽस्य सारथिः ।\nअपोवाह रणाद्राजंस्ततः सैन्यमभज्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2045315, "chapter_id": 2009, "verse_number": "६-५८-१९", "content_sanskrit": "ततस्तां कौरवीं सेनां द्रवमाणां समन्ततः।\nनिघ्नन्भीमः शरैस्तीक्ष्णैरनुवव्राज पृष्ठतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2045316, "chapter_id": 2009, "verse_number": "६-५८-२०", "content_sanskrit": "पार्षतश्च रथश्रोष्ठो धर्मपुत्रश्च पाण्डवः।\nद्रोणस्य पश्यतः सैन्यं गाङ्गेयस्य च पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2045317, "chapter_id": 2009, "verse_number": "६-५८-२१", "content_sanskrit": "जघ्नतुर्विशिकैस्तीक्ष्णैः परानीकविनाशनैः ।\nद्रवमाणं तु तत्सैन्यं तव पुत्रस्य संयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2045318, "chapter_id": 2009, "verse_number": "६-५८-२२", "content_sanskrit": "नाशक्नुतां वारयितुं भीष्मद्रोणौ महारथौ ।\nवार्यमाणं च भीष्मेण द्रोणेन च महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2045319, "chapter_id": 2009, "verse_number": "६-५८-२३", "content_sanskrit": "विद्रवत्येव तत्सैन्यं पश्यतोर्द्रोणभीष्मयोः।\nततो रथसहस्रेषु विद्रवत्सु ततस्ततःक ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2045320, "chapter_id": 2009, "verse_number": "६-५८-२४", "content_sanskrit": "तावास्थितावेकरथं सौभद्रशिनिपुङ्गवौ ।\nसौबलीं समरे सेनां शातयेतां समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2045321, "chapter_id": 2009, "verse_number": "६-५८-२५", "content_sanskrit": "शुशुभाते तदा तौ तु शैनेयकुरुपुङ्गवौ।\nअमावास्यां गतौ यद्वत्सोमसूर्यौ नभस्तले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2045322, "chapter_id": 2009, "verse_number": "६-५८-२६", "content_sanskrit": "अर्जुनस्तु ततः क्रुद्धस्तव सैन्यं विशांपते ।\nववर्ष शरवर्षेण धाराभिरिव तोयदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2045323, "chapter_id": 2009, "verse_number": "६-५८-२७", "content_sanskrit": "वध्यमानं ततस्तत्र शरैः पार्थस्य संयुगे।\nदुद्राव कौरवं सैन्यं विषादभयकम्पितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2045324, "chapter_id": 2009, "verse_number": "६-५८-२८", "content_sanskrit": "द्रवतस्तान्समालक्ष्य भीष्मद्रोणौ महारथौ ।\nन्यवारयेतां संरब्धौ दुर्योधनहितैषिणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2045325, "chapter_id": 2009, "verse_number": "६-५८-२९", "content_sanskrit": "ततो दुर्योधनो राजा समाश्वस्य विशांपते ।\nन्यवर्तयत तत्सैन्यं द्रवमाणां समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2045326, "chapter_id": 2009, "verse_number": "६-५८-३०", "content_sanskrit": "यत्र यत्र हि पुत्रं ते ये ये पश्यन्ति भारत।\nतत्र तत्र न्यवर्तन्त क्षत्रियाणां महरथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2045327, "chapter_id": 2009, "verse_number": "६-५८-३१", "content_sanskrit": "तान्निवृत्तान्समीक्ष्यैव ततोऽन्येऽपीतरे जनाः।\nअन्योन्यस्पर्धया राजँल्लज्जया चावतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2045328, "chapter_id": 2009, "verse_number": "६-५८-३२", "content_sanskrit": "पुनरावर्ततां तेषां वेग आसीद्विशांपते।\nपूर्यतः सागरस्येव चन्द्रस्योदयनं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2045329, "chapter_id": 2009, "verse_number": "६-५८-३३", "content_sanskrit": "अन्निवृत्तांस्ततस्तांस्तु दृष्ट्वा राजा सुयोधनः।\nअब्रवीत्त्वरितो गत्वा भीष्मं शान्तनवं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2045330, "chapter_id": 2009, "verse_number": "६-५८-३४", "content_sanskrit": "पितामह निबोधेदं यत्त्वां वक्ष्यामि भारत।\nनानुरूपमहं मन्ये त्वयि जीवति कौरव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2045331, "chapter_id": 2009, "verse_number": "६-५८-३५", "content_sanskrit": "द्रोणो चास्त्रविदां श्रेष्ठे सपुत्रे ससुहृञ्जने।\nकृपे चैव महेष्वासे द्रवते यद्वरूथिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2045332, "chapter_id": 2009, "verse_number": "६-५८-३६", "content_sanskrit": "न पाण्डवान्प्रतिलांस्तव मन्ये कथंचन ।\nतथा द्रोणस्य सङ्ग्रमे द्रौमेश्चैव कृपस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2045333, "chapter_id": 2009, "verse_number": "६-५८-३७", "content_sanskrit": "अनुग्राह्याः पाण्डुसुतास्तव नूनं पितामह ।\nयथेमां क्षमसे वीर वध्यमानां वरूथिनीम् ॥ ६-५८-३८aसोऽस्मि वाच्यस्त्वया राजन्पूर्वमेव समागमे।\nन योत्स्ये पाण्डवान्सङ्ख्ये नापि पार्षतसात्यकी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2045334, "chapter_id": 2009, "verse_number": "६-५८-३९", "content_sanskrit": "श्रुत्वा तु वचनं तुभ्यमाचार्यस्य कृपस्य च।\nकर्णेन सहितः कृत्यं चिन्तयानस्तदैव हि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2045335, "chapter_id": 2009, "verse_number": "६-५८-४०", "content_sanskrit": "यदि नाहं परित्याज्यो युवाभ्यामिह संयुगे ।\nविक्रमेणानुरूपेण युध्येतां पुरुषर्षभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2045336, "chapter_id": 2009, "verse_number": "६-५८-४१", "content_sanskrit": "एतच्छ्रुत्वा वचो भीष्मः प्रहसन्वै मुहुर्मुहुः ।\nअब्रवीत्तनयं तुभ्यं क्रोधादुद्वृत्य चक्षुषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2045337, "chapter_id": 2009, "verse_number": "६-५८-४२", "content_sanskrit": "बहुशोऽसि मया राजंस्तथ्यमुक्तो हितं वचः।\nअजेयाः पाण्डवा युद्धे देवैरपि सवासवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2045338, "chapter_id": 2009, "verse_number": "६-५८-४३", "content_sanskrit": "यत्तु शक्यं मया कर्तुं वृद्धेनाद्य गतायुषा।\nकरिष्यामि यथाशक्ति पश्येदानीं सबान्धवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2045339, "chapter_id": 2009, "verse_number": "६-५८-४४", "content_sanskrit": "अद्य पाण्डुसुतानेकः ससैन्यान्सह बन्धुभिः ।\nसोऽहं निवारयिष्यामि सर्वलोकस्य पश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2045340, "chapter_id": 2009, "verse_number": "६-५८-४५", "content_sanskrit": "एवमुक्ते तु भीष्मेण पुत्रास्तव जनेश्वर ।\nदध्मुः शङ्खान्मुदा युक्ता भेरीः संजघ्निरे भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2045341, "chapter_id": 2009, "verse_number": "६-५८-४६", "content_sanskrit": "पाण्डवा हि ततो राजञ्श्रुत्वा तं निनदं महत्।\nदध्मुः शङ्खांश्च भेरीश्च मुरजांश्चाप्यनादयन् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2045342, "chapter_id": 2009, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि तृतीयदिवसयुद्धे अष्टपञ्चाशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]