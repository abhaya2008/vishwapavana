[{"id": 2077796, "chapter_id": 2648, "verse_number": "१२-१५३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077797, "chapter_id": 2648, "verse_number": "१२-१५३-१", "content_sanskrit": "बलिनः प्रत्यमित्रस्य नित्यमासन्नवर्तिनः।\nउण्कारापकाराभ्यां समर्थस्योद्यतस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077798, "chapter_id": 2648, "verse_number": "१२-१५३-२", "content_sanskrit": "मोहाद्विकत्थनामात्रैरसारोऽल्पबलो लघुः।\nवाग्भिरप्रतिरूपाभिरभिद्रुह्य पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077799, "chapter_id": 2648, "verse_number": "१२-१५३-३", "content_sanskrit": "आत्मनो बलमास्थाय कथं वर्तेत मानवः।\nआगच्छतोऽतिक्रुद्धस्य तस्योद्धरणकाम्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077800, "chapter_id": 2648, "verse_number": "१२-१५३-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077801, "chapter_id": 2648, "verse_number": "१२-१५३-४", "content_sanskrit": "अत्राप्युदाहन्तीममितिहासं पुरातनम्।\nसंवादं भरतश्रेष्ठ शाल्मलेः पवनस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077802, "chapter_id": 2648, "verse_number": "१२-१५३-५", "content_sanskrit": "हिमवन्तं समासाद्य महानासीद्वनस्पतिः।\nवर्षपूगाभिसंवृद्धः शाखामूलपलाशवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077803, "chapter_id": 2648, "verse_number": "१२-१५३-६", "content_sanskrit": "तत्र स्म मत्तमातङ्गा घर्मार्ताः श्रमकर्शिताः।\nविश्राम्यन्ति महाबाहो तथाऽन्या मृगजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077804, "chapter_id": 2648, "verse_number": "१२-१५३-७", "content_sanskrit": "नल्वमांत्रपरीणाहो घनच्छायो वनस्पतिः।\nशुकशारिकसंघुष्टः पुष्पवान्फलवानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077805, "chapter_id": 2648, "verse_number": "१२-१५३-८", "content_sanskrit": "सार्थका वणिजश्चापि तापसाश्च वनौकसः।\nवसन्ति तत्र मार्गस्थाः सुरम्ये नगसत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077806, "chapter_id": 2648, "verse_number": "१२-१५३-९", "content_sanskrit": "तस्य ता विपुलाः शाखा दृष्ट्वा स्कन्धं च सर्वशः।\nअभिगम्याब्रवीदेनं नारदो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077807, "chapter_id": 2648, "verse_number": "१२-१५३-१०", "content_sanskrit": "अहो नु रमणीयस्त्वमहो चासि मनोहरः।\nप्रीयामहे त्वया नित्यं तरुप्रवर शाल्मके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077808, "chapter_id": 2648, "verse_number": "१२-१५३-११", "content_sanskrit": "सदैव शकुनास्तात मृगाश्चाथ तथा गजाः।\nवसन्ति तव संहृष्टा मनोहरतरास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077809, "chapter_id": 2648, "verse_number": "१२-१५३-१२", "content_sanskrit": "तव शाखा महाशाख स्कन्धांश्च विपुलांस्तथा।\nन वै प्रभग्नान्पश्यामि मारुतेन कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077810, "chapter_id": 2648, "verse_number": "१२-१५३-१३", "content_sanskrit": "किंनु ते पवनस्तात प्रीतिमानथवा सुहृत्।\nत्वां रक्षति सदा येन वनेऽत्र पवनो ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077811, "chapter_id": 2648, "verse_number": "१२-१५३-१४", "content_sanskrit": "भगवान्पवनः स्थानाद्वृक्षानुच्चावचानपि।\nपर्वतानां च शिखराण्याचालयति वेगवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077812, "chapter_id": 2648, "verse_number": "१२-१५३-१५", "content_sanskrit": "शोषयत्येव पातालं वहन्गन्धवहः शुचिः।\nसरांसि सरितश्चैव सागरांश्च तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077813, "chapter_id": 2648, "verse_number": "१२-१५३-१६", "content_sanskrit": "संरक्षति त्वां पवनः सखित्वेन न संशयः।\nतस्मात्त्वं बहुशाखोऽपि पर्णवान्पुष्पवानपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077814, "chapter_id": 2648, "verse_number": "१२-१५३-१७", "content_sanskrit": "इदं च रमणीयं ते प्रतिभाति वनस्पते।\nय इमे विहगास्तात रमन्ते मुदितास्त्वयि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077815, "chapter_id": 2648, "verse_number": "१२-१५३-१८", "content_sanskrit": "एषां पृथक्समस्तानां श्रूयते मधुरस्वरः।\nपुष्पसंमोदने काले वाशन्ते हरियूथपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077816, "chapter_id": 2648, "verse_number": "१२-१५३-१९", "content_sanskrit": "तथेमे गर्जिता नागाः स्वयूथगणशोभिताः।\nघर्मार्तास्त्वां समासाद्य सुखं विन्दति शाल्मके।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077817, "chapter_id": 2648, "verse_number": "१२-१५३-२०", "content_sanskrit": "तथैव मृगजातीभिरन्याभिरभिशोभसे।\nतथा सार्थाधिवासैश्च शोभसे मेरुवद्द्रुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2077818, "chapter_id": 2648, "verse_number": "१२-१५३-२१", "content_sanskrit": "ब्राह्मणैश्च तपः सिद्धैस्तापसैः श्रमणैस्तथा।\nत्रिविष्टपसमं मन्ये तवायतनमेव हि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2077819, "chapter_id": 2648, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि त्रिपञ्चाशदधिकशततमोऽध्यायः॥ १५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]