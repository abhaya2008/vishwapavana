[{"id": 5000528000, "chapter_id": 9528, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकविंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000528001, "chapter_id": 9528, "verse_number": "६-१२१-१", "content_sanskrit": "तां रात्रिमुषितं रामं सुखोदितमरिंदमम्।\nअब्रवीत् प्राञ्जलिर्वाक्यं जयं पृष्ट्वा विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000528002, "chapter_id": 9528, "verse_number": "६-१२१-२", "content_sanskrit": "स्नानानि चाङ्गरागाणि वस्त्राण्याभरणानि च।\nचन्दनानि च माल्यानि दिव्यानि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000528003, "chapter_id": 9528, "verse_number": "६-१२१-३", "content_sanskrit": "अलंकारविदश्चैता नार्यः पद्मनिभेक्षणाः।\nउपस्थितास्त्वां विधिवत् स्नापयिष्यन्ति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000528004, "chapter_id": 9528, "verse_number": "६-१२१-४", "content_sanskrit": "एवमुक्तस्तु काकुत्स्थः प्रत्युवाच विभीषणम्।\nहरीन् सुग्रीवमुख्यांस्त्वं स्नानेनोपनिमन्त्रय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000528005, "chapter_id": 9528, "verse_number": "६-१२१-५", "content_sanskrit": "स तु ताम्यति धर्मात्मा मम हेतोः सुखोचितः।\nसुकुमारो महाबाहुर्भरतः सत्यसंश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000528006, "chapter_id": 9528, "verse_number": "६-१२१-६", "content_sanskrit": "तं विना कैकयीपुत्रं भरतं धर्मचारिणम्।\nन मे स्नानं बहु मतं वस्त्राण्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000528007, "chapter_id": 9528, "verse_number": "६-१२१-७", "content_sanskrit": "एतत् पश्य यथा क्षिप्रं प्रतिगच्छाम तां पुरीम्।\nअयोध्यां गच्छतो ह्येष पन्थाः परमदुर्गमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000528008, "chapter_id": 9528, "verse_number": "६-१२१-८", "content_sanskrit": "एवमुक्तस्तु काकुत्स्थं प्रत्युवाच विभीषणः।\nअह्ना त्वां प्रापयिष्यामि तां पुरीं पार्थिवात्मज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000528009, "chapter_id": 9528, "verse_number": "६-१२१-९", "content_sanskrit": "पुष्पकं नाम भद्रं ते विमानं सूर्यसंनिभम्।\nमम भ्रातुः कुबेरस्य रावणेन बलीयसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000528010, "chapter_id": 9528, "verse_number": "६-१२१-१०", "content_sanskrit": "हृतं निर्जित्य संग्रामे कामगं दिव्यमुत्तमम्।\nत्वदर्थं पालितं चेदं तिष्ठत्यतुलविक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000528011, "chapter_id": 9528, "verse_number": "६-१२१-११", "content_sanskrit": "तदिदं मेघसंकाशं विमानमिह तिष्ठति।\nयेन यास्यसि यानेन त्वमयोध्यां गतज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000528012, "chapter_id": 9528, "verse_number": "६-१२१-१२", "content_sanskrit": "अहं ते यद्यनुग्राह्यो यदि स्मरसि मे गुणान्।\nवस तावदिह प्राज्ञ यद्यस्ति मयि सौहृदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000528013, "chapter_id": 9528, "verse_number": "६-१२१-१३", "content_sanskrit": "लक्ष्मणेन सह भ्रात्रा वैदेह्या भार्यया सह।\nअर्चितः सर्वकामैस्त्वं ततो राम गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000528014, "chapter_id": 9528, "verse_number": "६-१२१-१४", "content_sanskrit": "प्रीतियुक्तस्य विहितां ससैन्यः ससुहृद‍्गणः।\nसत्क्रियां राम मे तावद् गृहाण त्वं मयोद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000528015, "chapter_id": 9528, "verse_number": "६-१२१-१५", "content_sanskrit": "प्रणयाद् बहुमानाच्च सौहार्देन च राघव।\nप्रसादयामि प्रेष्योऽहं न खल्वाज्ञापयामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000528016, "chapter_id": 9528, "verse_number": "६-१२१-१६", "content_sanskrit": "एवमुक्तस्ततो रामः प्रत्युवाच विभीषणम्।\nरक्षसां वानराणां च सर्वेषामेव शृण्वताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000528017, "chapter_id": 9528, "verse_number": "६-१२१-१७", "content_sanskrit": "पूजितोऽस्मि त्वया वीर साचिव्येन परेण च।\nसर्वात्मना च चेष्टाभिः सौहार्देन परेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000528018, "chapter_id": 9528, "verse_number": "६-१२१-१८", "content_sanskrit": "न खल्वेतन्न कुर्यां ते वचनं राक्षसेश्वर।\nतं तु मे भ्रातरं द्रष्टुं भरतं त्वरते मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000528019, "chapter_id": 9528, "verse_number": "६-१२१-१९", "content_sanskrit": "मां निवर्तयितुं योऽसौ चित्रकूटमुपागतः।\nशिरसा याचतो यस्य वचनं न कृतं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000528020, "chapter_id": 9528, "verse_number": "६-१२१-२०", "content_sanskrit": "कौसल्यां च सुमित्रां च कैकेयीं च यशस्विनीम्।\nगुहं च सुहृदं चैव पौराञ्जानपदैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000528021, "chapter_id": 9528, "verse_number": "६-१२१-२१", "content_sanskrit": "अनुजानीहि मां सौम्य पूजितोऽस्मि विभीषण।\nमन्युर्न खलु कर्तव्यः सखे त्वां चानुमानये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000528022, "chapter_id": 9528, "verse_number": "६-१२१-२२", "content_sanskrit": "उपस्थापय मे शीघ्रं विमानं राक्षसेश्वर।\nकृतकार्यस्य मे वासः कथं स्यादिह सम्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000528023, "chapter_id": 9528, "verse_number": "६-१२१-२३", "content_sanskrit": "एवमुक्तस्तु रामेण राक्षसेन्द्रो विभीषणः।\nविमानं सूर्यसंकाशमाजुहाव त्वरान्वितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000528024, "chapter_id": 9528, "verse_number": "६-१२१-२४", "content_sanskrit": "ततः काञ्चनचित्राङ्गं वैदूर्यमणिवेदिकम्।\nकूटागारैः परिक्षिप्तं सर्वतो रजतप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000528025, "chapter_id": 9528, "verse_number": "६-१२१-२५", "content_sanskrit": "पाण्डुराभिः पताकाभिर्ध्वजैश्च समलंकृतम्।\nशोभितं काञ्चनैर्हर्म्यैर्हेमपद्मविभूषितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000528026, "chapter_id": 9528, "verse_number": "६-१२१-२६", "content_sanskrit": "प्रकीर्णं किङ्किणीजालैर्मुक्तामणिगवाक्षकम्।\nघण्टाजालैः परिक्षिप्तं सर्वतो मधुरस्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000528027, "chapter_id": 9528, "verse_number": "६-१२१-२७", "content_sanskrit": "तं मेरुशिखराकारं निर्मितं विश्वकर्मणा।\nबृहद्भिर्भूषितं हर्म्यैर्मुक्तारजतशोभितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000528028, "chapter_id": 9528, "verse_number": "६-१२१-२८", "content_sanskrit": "तलैः स्फटिकचित्राङ्गैर्वैदूर्यैश्च वरासनैः।\nमहार्हास्तरणोपेतैरुपपन्नं महाधनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000528029, "chapter_id": 9528, "verse_number": "६-१२१-२९", "content_sanskrit": "उपस्थितमनाधृष्यं तद् विमानं मनोजवम्।\nनिवेदयित्वा रामाय तस्थौ तत्र विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000528030, "chapter_id": 9528, "verse_number": "६-१२१-३०", "content_sanskrit": "तत् पुष्पकं कामगमं विमान-\nमुपस्थितं भूधरसंनिकाशम्।\nदृष्ट्वा तदा विस्मयमाजगाम\nरामः ससौमित्रिरुदारसत्त्वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000528031, "chapter_id": 9528, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे एकविंशत्यधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]