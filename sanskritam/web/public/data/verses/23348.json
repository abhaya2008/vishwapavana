[{"id": 7003348000, "chapter_id": 23348, "verse_number": "२-४३-१", "content_sanskrit": "सनत्कुमार उवाच  ।\nलोकपालाष्टकं दिव्यं साक्षात्परमदुर्लभम् ।\nसर्वसंपत्करं गुह्यं परक्रविनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003348001, "chapter_id": 23348, "verse_number": "२-४३-२", "content_sanskrit": "स्वदेशरक्षणं दिव्यं गजवाजिविवर्धनम् ।\nपुत्र वृद्धिकरं पुण्यं गोब्राह्मणहितावहम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003348002, "chapter_id": 23348, "verse_number": "२-४३-३", "content_sanskrit": "पूर्वोक्तदेशकाले तु वेदिकोपरिमंडले ।\nमध्ये शिवं समभ्यर्च्य यथानायायं यथाक्रमम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003348003, "chapter_id": 23348, "verse_number": "२-४३-४", "content_sanskrit": "दिग्विदिक्षु प्रकर्तव्यं स्थंडिलं वालुकामयम् ।\nअष्टौ विप्रान्समभ्यर्च्य वेदवेदांगपारगान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003348004, "chapter_id": 23348, "verse_number": "२-४३-५", "content_sanskrit": "जितेंद्रियान्कुलोद्भूतान्सर्वलक्षणसंयुतान् ।\nशिवाभिमुखमासीनाऽनाहतेष्वंबरेषु च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003348005, "chapter_id": 23348, "verse_number": "२-४३-६", "content_sanskrit": "वस्त्रैराभरणैर्दिव्यैर्लोकपालकमंत्रकैः ।\nगंधपुष्पैः सुधूपैश्च ब्राह्मणानर्चयेत्क्रमात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003348006, "chapter_id": 23348, "verse_number": "२-४३-७", "content_sanskrit": "पूर्वतो होमयेदग्नौ लोकपालकमंत्रकैः ।\nसमिद्धृताभ्यां होतव्यमग्निकार्यं क्रमेण वा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003348007, "chapter_id": 23348, "verse_number": "२-४३-८", "content_sanskrit": "एवं हुत्वा विधानेन आचार्यः शिववत्सलः ।\nयजमानं समाहूय सर्वाभरमभूषितान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003348008, "chapter_id": 23348, "verse_number": "२-४३-९", "content_sanskrit": "तेन तान्पूजयित्वाथ द्विजोभ्यो दापयेद्धनम् ।\nपृथक्पृथक्तन्मंत्रैश्च दशनिष्कं च भूषणम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003348009, "chapter_id": 23348, "verse_number": "२-४३-१०", "content_sanskrit": "दशनीष्केण कर्तव्यमासनं केवलं पृथक् ।\nस्नपनं तत्र कर्तव्यं शिवस्य विधिपूर्वकम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003348010, "chapter_id": 23348, "verse_number": "२-४३-११", "content_sanskrit": "दक्षिणा च प्रदातव्या यथाविभविस्तरम्  ।\nएवं यः कुरुते दानं लोकेशानां तु भक्तितः ।\nलोकेशानां चिरं स्थित्वा सार्वभौमौ भवेद्बुधः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]