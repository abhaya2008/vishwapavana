[{"id": 2010825, "chapter_id": 1219, "verse_number": "१-२२०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010826, "chapter_id": 1219, "verse_number": "१-२२०-१", "content_sanskrit": "दुर्योधनेनैवमुक्तः कर्णेन च विशांपते।\nपुत्रं च सूतपुत्रं च धृतराष्ट्रोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010827, "chapter_id": 1219, "verse_number": "१-२२०-२x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010828, "chapter_id": 1219, "verse_number": "१-२२०-२", "content_sanskrit": "अहमप्येवमेवैतच्चिकीर्षामि यथा युवाम्।\nविवेक्तुं नाहमिच्छामि त्वाकारं विदुरं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010829, "chapter_id": 1219, "verse_number": "१-२२०-३", "content_sanskrit": "ततस्तेषां गुणानेव कीर्तयामि विशेषतः।\nनावबुध्येत विदुरो ममाभिप्रायमिङ्गितैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010830, "chapter_id": 1219, "verse_number": "१-२२०-४", "content_sanskrit": "यच्च त्वं मन्यसे प्राप्तं तद्ब्रवीहि सुयोधन।\nराधेय मन्यसे यच्च प्राप्तकालं वदाशु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010831, "chapter_id": 1219, "verse_number": "१-२२०-५x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010832, "chapter_id": 1219, "verse_number": "१-२२०-५", "content_sanskrit": "अद्य तान्कुशलैर्विप्रैः सुगुप्तैराप्तकारिभिः।\nकुन्तीपुत्रान्भेदयामो माद्रीपुत्रौ च पाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010833, "chapter_id": 1219, "verse_number": "१-२२०-६", "content_sanskrit": "अथवा द्रुपदो राजा महद्भिर्वित्तसंचयैः।\nपुत्राश्चास्य प्रलोभ्यन्ताममात्याश्चैव सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010834, "chapter_id": 1219, "verse_number": "१-२२०-७", "content_sanskrit": "परित्यजेद्यथा राजा कुन्तीपुत्रं युधिष्ठिरम्।\nअथ तत्रैव वा तेषां निवासं रोचयन्तु ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010835, "chapter_id": 1219, "verse_number": "१-२२०-८", "content_sanskrit": "इहैषां दोषवद्वासं वर्णयन्तु पृथक्पृथक्।\nते भिद्यमानास्तत्रैव मनः कुर्वन्तु पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010836, "chapter_id": 1219, "verse_number": "१-२२०-९", "content_sanskrit": "अथवा कुशळाः केचिदुपायनिपुणा नराः।\nइतरेतरतः पार्थान्भेदयन्त्वनुरागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010837, "chapter_id": 1219, "verse_number": "१-२२०-१०", "content_sanskrit": "व्युत्थापयन्तु वा कृष्णां बहुत्वात्सुकरं हि तत्।\nअथवा पाण्डवांस्तस्यां भेदयन्तु ततश्च ताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010838, "chapter_id": 1219, "verse_number": "१-२२०-११", "content_sanskrit": "भीमसेनस्य वा राजन्नुपायकुशलैर्नरैः।\nमृत्युर्विधीयतां छन्नैः स हि तेषां बलाधिकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010839, "chapter_id": 1219, "verse_number": "१-२२०-१२", "content_sanskrit": "तमाश्रित्य हि कौन्तेयः पुरा चास्मान्न मन्यते।\nसहि तीक्ष्णश्च शूरश्च तेषां चैव परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010840, "chapter_id": 1219, "verse_number": "१-२२०-१३", "content_sanskrit": "तस्मिंस्त्वभिहते राजन्हतोत्साहा हतौजसः।\nयतिष्यन्ते न राज्याय स हि तेषां व्यपाश्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010841, "chapter_id": 1219, "verse_number": "१-२२०-१४", "content_sanskrit": "अजेयो ह्यर्जुनः सङ्ख्ये पृष्ठगोपे वृकोदरे।\nतमृते फाल्गुनो युद्धे राधेयस्य न पादभाक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010842, "chapter_id": 1219, "verse_number": "१-२२०-१५", "content_sanskrit": "ते जानानास्तु दौर्बल्यं भीमसेनमृते महत्।\nअस्मान्बलवतो ज्ञात्वा न यतिष्यन्ति दुर्बलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010843, "chapter_id": 1219, "verse_number": "१-२२०-१६", "content_sanskrit": "इहागतेषु वा तेषु निदेशवशवर्तिषु।\nप्रवर्तिष्यामहे राजन्यथाशास्त्रं निबर्हणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010844, "chapter_id": 1219, "verse_number": "१-२२०-१७", "content_sanskrit": "दर्पं वा वदतां तेषां केचिदत्र मनस्विनः।\nद्रुपदस्यात्मजा राजन्प्रभिद्यन्ते ततः परैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010845, "chapter_id": 1219, "verse_number": "१-२२०-१८", "content_sanskrit": "अथवा दर्शनीयाभिः प्रमदाभिर्विलोभ्यताम्।\nएकैकस्तत्र कौन्तेयस्ततः कृष्णा विरज्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010846, "chapter_id": 1219, "verse_number": "१-२२०-१९", "content_sanskrit": "प्रेष्यतां चैव राधेयस्तेषामागमनाय वै।\nतैस्तैः प्रकारैः सन्नीय पात्यन्तामाप्तकारिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010847, "chapter_id": 1219, "verse_number": "१-२२०-२०", "content_sanskrit": "एतेषामप्युपायानां यस्ते निर्दोषवान्मतः।\nतस्य यप्रोगमातिष्ठ पुरा कालोऽतिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010848, "chapter_id": 1219, "verse_number": "१-२२०-२१", "content_sanskrit": "यावद्ध्यकृतविश्वासा द्रुपदे पार्थिवर्षभे।\nतावदेव हि ते शक्या न शक्यास्तु ततः परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010849, "chapter_id": 1219, "verse_number": "१-२२०-२२", "content_sanskrit": "एषा मम मतिस्तात निग्रहाय प्रवर्तते।\nसाध्वी वा यदि वाऽसाध्वी किं वा राधेय मन्यसे॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010850, "chapter_id": 1219, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि विदुरागमनराज्यलाभपर्वणि विंशत्यधिकद्विशततमोऽध्यायः॥ २२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]