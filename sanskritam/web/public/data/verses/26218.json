[{"id": 7006218000, "chapter_id": 26218, "verse_number": "२-४६-१", "content_sanskrit": "वसिष्ठ उवाच सगच्छन्पथि शुश्राव मुनिभ्यस्त त्त्वमादितः ।\nराजपुत्रव्यवसितं पित्रौः स्वर्गतिमेव च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006218001, "chapter_id": 26218, "verse_number": "२-४६-२", "content_sanskrit": "पितुस्तु जीवहरणं शिरोहरणमेव च ।\nतन्मृतेरेव मरणं श्रुत्वा मातुश्च केवलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006218002, "chapter_id": 26218, "verse_number": "२-४६-३", "content_sanskrit": "विललाप महाबाहुर्दुःखशोकसमन्वितः ।\nतमथाश्वासयामास तुल्यदुःखोऽकृतव्रणः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006218003, "chapter_id": 26218, "verse_number": "२-४६-४", "content_sanskrit": "हेतुभिः शास्त्रनिर्दिष्टैर्वीर्यसामर्थ्यसूचकैः ।\nयुक्तिलौकिकदृष्टान्तैस्तच्छोकं संव्यशामयत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006218004, "chapter_id": 26218, "verse_number": "२-४६-५", "content_sanskrit": "सांत्वितस्तेन मैधावी धृतिमालंब्य भार्गवः ।\nप्रययौ सहितः सख्या भ्रातॄणां तु दिदृक्षया ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006218005, "chapter_id": 26218, "verse_number": "२-४६-६", "content_sanskrit": "स तान्दृष्ट्वाभिवाद्यैतान्दुःखितान्दुःखकर्शितः ।\nशोकामषयुतस्तैश्च सह त्स्थौ दिनत्रयम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006218006, "chapter_id": 26218, "verse_number": "२-४६-७", "content_sanskrit": "ततोऽस्य सुमाहान्क्रोधः स्मरतो निधनं पितुः ।\nबभूव सहसा सर्वलोकसंहरणक्षमः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006218007, "chapter_id": 26218, "verse_number": "२-४६-८", "content_sanskrit": "मातुरर्थे कृतां पूर्वं प्रतिज्ञां सत्यसंगरः ।\nदृढीचकार हृदये सर्वक्षत्रवधोद्यतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006218008, "chapter_id": 26218, "verse_number": "२-४६-९", "content_sanskrit": "क्षत्रवंश्यानशेषेण हत्वा तद्देहलोहितैः ।\nकरिष्ये तर्पणं पित्रोरिति निश्चित्य भार्गवः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006218009, "chapter_id": 26218, "verse_number": "२-४६-१०", "content_sanskrit": "भ्रातॄणां चैव सर्वेषामाख्यायात्मसमीहितम् ।\nप्रययौ तदनुज्ञातः कृत्वा संस्थांपितुः क्रियाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006218010, "chapter_id": 26218, "verse_number": "२-४६-११", "content_sanskrit": "अकृतव्रणसंयुक्तः प्राप्य माहिष्मतीं ततः ।\nतद्बाह्योपवने स्थित्वा सस्मार स महोदरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006218011, "chapter_id": 26218, "verse_number": "२-४६-१२", "content_sanskrit": "स तस्मै रथचापाद्यं सहसाश्वसमन्वितम् ।\nप्रेषयामास रामाय सर्वसंहननानि च ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006218012, "chapter_id": 26218, "verse_number": "२-४६-१३", "content_sanskrit": "रामोऽपि रथमारुह्य सन्नद्धः सशरं धनुः ।\nगृहीत्वापूरयच्छङ्खं रुद्रदत्तममित्रजित् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006218013, "chapter_id": 26218, "verse_number": "२-४६-१४", "content_sanskrit": "ज्याघोषं च चकारोच्चै रोदसी कंपयन्निव ।\nसहसाहोथ सारथ्यं चक्रे सारथिनां वरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006218014, "chapter_id": 26218, "verse_number": "२-४६-१५", "content_sanskrit": "रथज्याशङ्खनादैस्तु वधात्पित्रोरमर्षिणः ।\nतस्याभून्नगरी सर्वा संक्षुब्धाश्च नरद्विपाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006218015, "chapter_id": 26218, "verse_number": "२-४६-१६", "content_sanskrit": "रामं त्वागतमाज्ञाय सर्वक्षत्रकुलान्तकम् ।\nसंक्षुब्धाश्चक्रुरुद्योगं संग्रामाय नृपात्मजाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006218016, "chapter_id": 26218, "verse_number": "२-४६-१७", "content_sanskrit": "अथ पञ्चरथाः शुराः शूरसेनादयो नृप ।\nरामेण योद्धुं सहिता राजभिश्च क्रुरुद्यमम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006218017, "chapter_id": 26218, "verse_number": "२-४६-१८", "content_sanskrit": "चतुरङ्गवलोपेतास्ततस्ते क्षत्रियर्षभाः ।\nराममासादयामासुः पतङ्गा इव पावकम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006218018, "chapter_id": 26218, "verse_number": "२-४६-१९", "content_sanskrit": "निवार्य तानापततो रथेनैकेन भार्गवः ।\nयुयुधे पार्थिवैः सर्वैः समरेऽमितविक्रमः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006218019, "chapter_id": 26218, "verse_number": "२-४६-२०", "content_sanskrit": "ततः पुनरभूद्युद्धं रामस्य सह राजभिः ।\nजघान यत्र संक्रुद्धो राज्ञां शतमुदारधीः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006218020, "chapter_id": 26218, "verse_number": "२-४६-२१", "content_sanskrit": "ततः स शूरसेनादीन्हत्वा सबलवाहनान् ।\nत्रणेन पातयामास क्षितौ क्षत्रियमण्डलम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006218021, "chapter_id": 26218, "verse_number": "२-४६-२२", "content_sanskrit": "ततस्ते भग्नसंकल्पा हतस्वबलवाहनाः ।\nहतशिष्टा नृपतयो दुद्रुवुः सर्वतोदिशम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006218022, "chapter_id": 26218, "verse_number": "२-४६-२३", "content_sanskrit": "एवं विद्राव्य सैन्यानि हत्वा जित्वाथ संयुगे ।\nजघान शतशो राज्ञः शूराञ्छरवराग्निना ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006218023, "chapter_id": 26218, "verse_number": "२-४६-२४", "content_sanskrit": "ततः क्रोधपरीतात्मा दग्धुकामोऽखिलां पुरीम् ।\nउदैरयद्भार्गवोऽस्त्रं कालाग्निसदृशप्रभम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006218024, "chapter_id": 26218, "verse_number": "२-४६-२५", "content_sanskrit": "ज्वालाकवलिताशेषपुरप्राकारमालिनीम् ।\nपुरीं सहस्त्यश्वनरां स ददाहास्त्रपावकः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006218025, "chapter_id": 26218, "verse_number": "२-४६-२६", "content_sanskrit": "दह्यमानां पुरीं दृष्ट्वा प्राणत्राणपरायणः ।\nजीवनाय जगामाशु वीतिहोत्रो भयातुरः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006218026, "chapter_id": 26218, "verse_number": "२-४६-२७", "content_sanskrit": "अस्त्राग्निना पुरीं सर्वां दग्ध्वा हत्वा च शात्रवान् ।\nप्राशयानोऽखिलान् लोकान् साक्षात्काल इवान्तकः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006218027, "chapter_id": 26218, "verse_number": "२-४६-२८", "content_sanskrit": "अकृतव्रणसंयुक्तः सहसाहेन चान्वितः ।\nजगामरथघोषेण कंपयन्निव मेदिनीम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006218028, "chapter_id": 26218, "verse_number": "२-४६-२९", "content_sanskrit": "विनिघ्नन् क्षत्रियान्सर्वान् संशाम्य पृथिवीतले ।\nमहेन्द्राद्रिं ययौ रामस्तपसे धतमानसः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006218029, "chapter_id": 26218, "verse_number": "२-४६-३०", "content_sanskrit": "तस्मिन्नष्टचतुष्कं च यावत्क्षत्रसमुद्गमम् ।\nप्रत्येत्य भूयस्तद्धत्यै बद्धदीक्षो धृतव्रतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006218030, "chapter_id": 26218, "verse_number": "२-४६-३१", "content_sanskrit": "क्षत्रक्षेत्रेषु भूयश्च क्षत्रमुत्पादितं द्विजैः ।\nनिजघान पुनर्भूमौ राज्ञ शतसहस्रशः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006218031, "chapter_id": 26218, "verse_number": "२-४६-३२", "content_sanskrit": "वर्षद्वयेन भूयोऽपि कृत्वा निःक्षत्रियां महीम् ।\nषट्चतुष्टयवर्षान्तं तपस्तेपे पुनश्च सः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006218032, "chapter_id": 26218, "verse_number": "२-४६-३३", "content_sanskrit": "भूयोऽपि राजन् संबुद्धं क्षत्रमुत्पादितं द्विजैः ।\nजघान भूमौ निःशेषं साक्षात्काल इवान्तकः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006218033, "chapter_id": 26218, "verse_number": "२-४६-३४", "content_sanskrit": "कालेन तावता भूयः समुत्पन्नं नृपात्त्वयम् ।\nनिघ्नंश्चचार पृथिवीं वर्षद्वयमनारतम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006218034, "chapter_id": 26218, "verse_number": "२-४६-३५", "content_sanskrit": "अलं रामेण राजेन्द्र स्मरता निधनं पितुः ।\nत्रिः सप्तकृत्वः पृथिवी तेन निःक्षत्रिया कृता ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006218035, "chapter_id": 26218, "verse_number": "२-४६-३६", "content_sanskrit": "त्रिःसप्तकृत्वस्तन्माता यदुरः स्वमताडयत् ।\nतावद्रामेण तस्मात्तु क्षत्रमुत्सादितं भुवि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]