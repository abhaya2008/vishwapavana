[{"id": 2067356, "chapter_id": 2417, "verse_number": "९-३५-०x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2067357, "chapter_id": 2417, "verse_number": "९-३५-१", "content_sanskrit": "पूर्वमेव यदा रामस्तस्मिन्युद्ध उपस्थिते।\nआमन्त्र्य केशवं यातो वृष्णिभिः सहितः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2067358, "chapter_id": 2417, "verse_number": "९-३५-२", "content_sanskrit": "साहाय्यं धार्तराष्ट्रस्य न च कर्ताऽस्मि केशव।\nन चैव पाण्डुपुत्राणां गमिष्यामि यथागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2067359, "chapter_id": 2417, "verse_number": "९-३५-३", "content_sanskrit": "एवमुक्त्वा तदा रामो यातः शत्रुनिबर्हणः।\nतस्य चागमनं भूयो ब्रह्मञ्शं सितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2067360, "chapter_id": 2417, "verse_number": "९-३५-४", "content_sanskrit": "आख्याहि मे विस्तरशः कथं राम उपस्थितः।\nकथं च दृष्टवान्युद्धं कुशलो ह्यसि सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2067361, "chapter_id": 2417, "verse_number": "९-३५-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2067362, "chapter_id": 2417, "verse_number": "९-३५-५", "content_sanskrit": "उपप्लाव्ये निविष्टेषु पाण्डवेषु महात्मसु।\nप्रेषितो धृतराष्ट्रस्य समीपं मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2067363, "chapter_id": 2417, "verse_number": "९-३५-६", "content_sanskrit": "शमं प्रति महाबाहो हितार्थं सर्वदेहिनाम्॥\nस गत्वा हास्तिनपुरं धृतराष्ट्रं समेत्य च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2067364, "chapter_id": 2417, "verse_number": "९-३५-७", "content_sanskrit": "उक्तवान्वचनं पथ्यं हितं चैव विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2067365, "chapter_id": 2417, "verse_number": "९-३५-८", "content_sanskrit": "न च तत्कृतवान्राजा यथाऽख्यातं हि तत्पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2067366, "chapter_id": 2417, "verse_number": "९-३५-९", "content_sanskrit": "अनवाप्य शमं तत्र कृष्णः पुरुषसत्तमः।\nआगच्छत महाबाहुरुपप्लाव्यं जनाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2067367, "chapter_id": 2417, "verse_number": "९-३५-१०", "content_sanskrit": "ततः प्रत्यागतः कृष्णो धार्तराष्ट्रविसर्जितः।\nआजगाम नरव्याघ्रः पाण्डवानामनीकिनीम्।\nयथोक्तं च यथावृत्तं गत्वा पाण्डवमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2067368, "chapter_id": 2417, "verse_number": "९-३५-११", "content_sanskrit": "न कुर्वन्ति वचो मह्यं कुरवः कालनोदिताः।\nनिर्गच्छध्व पाण्डवेयाः पुष्येण सहिता मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2067369, "chapter_id": 2417, "verse_number": "९-३५-१२", "content_sanskrit": "ततो विभज्यमानेषु बलेषु बलिनां वरः।\nप्रोवाच भ्रातरं कृष्णं रौहिणेयो महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2067370, "chapter_id": 2417, "verse_number": "९-३५-१३", "content_sanskrit": "तेषामपि महाबाहो साहाय्यं मधुसूदन।\nक्रियतामिति तत्कृष्णो नास्य चक्रे वचस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2067371, "chapter_id": 2417, "verse_number": "९-३५-१४", "content_sanskrit": "ततो मन्युपरीतात्मा जगाम यदुनन्दनः।\nतीर्थयात्रां हलधरः सरस्वत्यां महायशाः।\nमैत्रनक्षत्रयोगे स्म सहितः सर्वयादवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2067372, "chapter_id": 2417, "verse_number": "९-३५-१५", "content_sanskrit": "आश्रयामास भोजस्तु दुर्योधनमरिन्दमः।\nयुयुधानेन सहितो वासुदेवस्तु पाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2067373, "chapter_id": 2417, "verse_number": "९-३५-१६", "content_sanskrit": "रौहिणेये गते शूरे पुष्येण मधुसूदनः।\nपाण्डवेयान्पुरस्कृत्य ययावभिमुखः कूरून्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2067374, "chapter_id": 2417, "verse_number": "९-३५-१७", "content_sanskrit": "गच्छन्नेव पथिस्थस्तु रामः प्रेष्यानुवाच ह।\nसम्भारांस्तीर्थयात्रायां सर्वोपकरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2067375, "chapter_id": 2417, "verse_number": "९-३५-१८", "content_sanskrit": "आनयध्वं द्वारकाया अग्नीन्वै याजकांस्तथा।\nसुवर्णरजनं चैव धैनूर्वासांसि वाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2067376, "chapter_id": 2417, "verse_number": "९-३५-१९", "content_sanskrit": "कुञ्जरांश्च रथांश्चैव खरोष्ट्रं वाहनानि च।\nक्षिप्रमानीयतां सर्वं तीर्थहेतोः परिच्छदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2067377, "chapter_id": 2417, "verse_number": "९-३५-२०", "content_sanskrit": "प्रतिस्रोतः सरस्वत्या गच्छध्वं शीघ्रगामिनः।\nऋत्विजश्चानयध्वं वै शतशश्च द्विजर्षभान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2067378, "chapter_id": 2417, "verse_number": "९-३५-२१", "content_sanskrit": "एवं सन्दिश्य तु प्रेष्यान्बलदेवो महाबलः।\nतीर्थयात्रां ययौ राजन्कुरूणां वैशसे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2067379, "chapter_id": 2417, "verse_number": "९-३५-२२", "content_sanskrit": "सरस्वत्याः प्रतिस्रोतः समुद्रादभिजग्मिवान।\nरामो यदूत्तमः श्रीमांस्तीर्थयात्रामनुस्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2067380, "chapter_id": 2417, "verse_number": "९-३५-२३", "content_sanskrit": "ऋत्विग्भिश्च सुहृद्भिश्च यथाऽन्यैर्द्विजसत्तमैः।\nरथैर्गजैस्तथाऽश्वैश्च प्रेष्यैश्च भरतर्षभ।\nगोखरोष्ट्रप्रयुक्तैश्च यानैश्च बहुभिर्वृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2067381, "chapter_id": 2417, "verse_number": "९-३५-२४", "content_sanskrit": "श्रान्तानां क्लान्तबपुषां शिशूनां विपुलायुषाम्।\nदेशेदेशे तु देयानि दानानि विविधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2067382, "chapter_id": 2417, "verse_number": "९-३५-२५", "content_sanskrit": "अर्चायै चार्थिनां राजन्क्लृप्तानि बहुशस्तथा।\nतानि यानीह देशेषु प्रतीक्षन्ति स्म भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2067383, "chapter_id": 2417, "verse_number": "९-३५-२६", "content_sanskrit": "बुभुक्षितानामर्थाय क्लृप्तमन्नं समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2067384, "chapter_id": 2417, "verse_number": "९-३५-२७", "content_sanskrit": "योयो यत्र द्विजो भोज्यं भोक्तुं कामयते तदा।\nतस्यतस्य तु तत्रैवमुपजह्रुस्तदा नृष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2067385, "chapter_id": 2417, "verse_number": "९-३५-२८", "content_sanskrit": "तत्रतत्र स्थिता राजन्रौहिणेयस्य शासनात्।\nभक्ष्यपेयस्य कुर्वन्ति राशींस्तत्र समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2067386, "chapter_id": 2417, "verse_number": "९-३५-२९", "content_sanskrit": "वासांसि च महार्हाणि पर्यङ्कास्तरणानि च।\nपूजार्थं तत्र क्लृप्तानि विप्राणां सुखमिच्छताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2067387, "chapter_id": 2417, "verse_number": "९-३५-३०", "content_sanskrit": "यत्र यः स्वपते विप्रो यो वा जागर्ति भारत।\nतत्रतत्रैव सर्वस्य क्लृप्तं सर्वमपश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2067388, "chapter_id": 2417, "verse_number": "९-३५-३१", "content_sanskrit": "यथासुखं जनः सर्वो याति तिष्ठति वै तदा।\nयातुकामस्य यानानि पानानि तृषितस्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2067389, "chapter_id": 2417, "verse_number": "९-३५-३२", "content_sanskrit": "बुभुक्षितस्य चान्नानि स्वादूनि भरतर्षभ।\nउपजह्रुर्नरास्तत्र वस्त्राण्याभरणानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2067390, "chapter_id": 2417, "verse_number": "९-३५-३३", "content_sanskrit": "स पन्थाः प्रबभौ राजन्सर्वस्यैव सुखावहः।\nस्वर्गोपमस्तदा वीर नराणां तत्र गच्छताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2067391, "chapter_id": 2417, "verse_number": "९-३५-३४", "content_sanskrit": "नित्यप्रमुदितोपेतः स्वादुभक्ष्यो जलान्वितः।\nविपण्यापणपण्यानं नानाजनशतैर्वृतः।\nनानाद्रुमलतोपेतो नानारत्नविभूषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2067392, "chapter_id": 2417, "verse_number": "९-३५-३५", "content_sanskrit": "ततो महात्मा नियतो मनस्विनां\nपुण्येषु तीर्थेषु वसूनि राजन्।\nददौ द्विजेभ्यः क्रतुदक्षिणाश्च\nयदुप्रवीरो हलभृत्प्रतीतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2067393, "chapter_id": 2417, "verse_number": "९-३५-३६", "content_sanskrit": "दोग्ध्रीश्च धेनूश्च सहस्रशो वै\nसुवाससः काञ्चनबद्धशृङ्गीः।\nहयांश्च नानाविधदेशजातान्\nयानानि दासांश्च शुभान्द्विजेभ्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2067394, "chapter_id": 2417, "verse_number": "९-३५-३७", "content_sanskrit": "रत्नानि मुक्तामणिविद्रुमं चा--\nप्यग्र्यं सुवर्णं रजतं सुशुन्द्वम्।\nअयस्मयं ताम्रमयं च भाण्डं\nददौ द्विजातिप्रवरेषु रामः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2067395, "chapter_id": 2417, "verse_number": "९-३५-३८", "content_sanskrit": "एवं स वित्तं प्रददौ महात्मा\nसरस्वतीतीर्थगतेषु भूरि।\nययौ क्रमेणाप्रतिमप्रभाव--\nस्ततः कुरुक्षेत्रमुदारवृत्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2067396, "chapter_id": 2417, "verse_number": "९-३५-३९x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2067397, "chapter_id": 2417, "verse_number": "९-३५-३९", "content_sanskrit": "सारस्वतानां तीर्थानां गुणोत्पत्तिं वदस्व मे।\nफलं च द्विपदां श्रेष्ठ कर्म निर्वृत्तिमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2067398, "chapter_id": 2417, "verse_number": "९-३५-४०", "content_sanskrit": "यथाक्रमेण भगवंस्तीर्थानामनुपूर्वशः।\nब्रूहि ब्रह्मविदां श्रेष्ठ परं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2067399, "chapter_id": 2417, "verse_number": "९-३५-४१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2067400, "chapter_id": 2417, "verse_number": "९-३५-४१", "content_sanskrit": "तीर्थानां च फलं राजन्गुणोत्पत्तिं चं सर्वशः।\nमयोच्यमानं वै पुण्यं शृणु राजेन्द्र कृत्स्नशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2067401, "chapter_id": 2417, "verse_number": "९-३५-४२", "content_sanskrit": "पूर्वं महाराज यदुप्रवीर\nऋत्विक्सुहृद्विप्रगणैश्च सार्धम्।\nपुण्यं प्रभासं समुपाजगाम\nयत्रोडुराढ्यक्ष्मणा क्षीयमाणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2067402, "chapter_id": 2417, "verse_number": "९-३५-४३", "content_sanskrit": "विमुक्तशापः पुनराप्य तेजः\nसर्वं जगद्भासयते नरेन्द्र।\nएतत्तु तीर्थप्रवरं पृथिव्यां\nप्रभासनात्तस्य ततः प्रभासः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2067403, "chapter_id": 2417, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि अष्टदशदिवसयुद्धे पञ्चत्रिंशोऽध्यायः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]