[{"id": 7002402000, "chapter_id": 22402, "verse_number": "१-६४-१", "content_sanskrit": "दिण्डिरुवाच ।\nउपवासैः सुरश्रेष्ठ कथं तुष्यति भास्करः ।\nपरिहारांस्तथाचक्ष्व ये त्याज्याश्चोपवासिभिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002402001, "chapter_id": 22402, "verse_number": "१-६४-२", "content_sanskrit": "यद्यत्कार्यं यथा चैव भास्कराराधने नरै ।\nतत्सर्वं विस्तराद्ब्रह्मन्यथावद्वक्तुमर्हसि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002402002, "chapter_id": 22402, "verse_number": "१-६४-३", "content_sanskrit": "ब्रह्मोवाच ।\nस्मृतः सम्पूजितो धूपपुष्पान्नैर्भानुरादरात् ।\nभोगिनामुपकाराय किं पुनश्चोपवासिनाम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002402003, "chapter_id": 22402, "verse_number": "१-६४-४", "content_sanskrit": "उपावृत्तस्य पापेभ्यो यस्तु वासो गुणैः सह ।\nउपवासः स विज्ञेयः सर्वभोगविवर्जितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002402004, "chapter_id": 22402, "verse_number": "१-६४-५", "content_sanskrit": "एकरात्रं द्विरात्रं वा त्रिरात्रं नक्तमेव च ।\nउपवासी रविं यस्तु भक्त्या ध्यायति मानवः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002402005, "chapter_id": 22402, "verse_number": "१-६४-६", "content_sanskrit": "तन्नामजापी तत्कर्मरतस्तद्गतमानसः ।\nनिष्कामः पुरुषो दिण्डे स ब्रह्म परमाप्नुयात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002402006, "chapter_id": 22402, "verse_number": "१-६४-७", "content_sanskrit": "यं च काममभिध्याय मास्करार्पितमानसः ।\nउपोषति तमाप्नोति प्रसन्ने खगमेऽखिलम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002402007, "chapter_id": 22402, "verse_number": "१-६४-८", "content_sanskrit": "दिण्डिरुवाच ।\nब्राह्मणैः क्षत्रियैर्वैश्यैः शूद्रैः स्त्रीभिश्च कञ्जज ।\nसंसारगर्ते पङ्कस्थे सुगतिः प्राप्यते कथम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002402008, "chapter_id": 22402, "verse_number": "१-६४-९", "content_sanskrit": "ब्रह्मोवाच ।\nअनाराध्य जगन्नाथं गोपतिं ध्वान्तनाशनम् ।\nनिर्व्यलीकेन चित्तेन कः प्रयास्यति सद्गतिम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002402009, "chapter_id": 22402, "verse_number": "१-६४-१०", "content_sanskrit": "विषयग्राहि वै यस्य न चित्तं भास्करार्पितम् ।\nस कथं पापपङ्काक्तो नरो यास्यति सद्गतिम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002402010, "chapter_id": 22402, "verse_number": "१-६४-११", "content_sanskrit": "यदि संसारदुःखार्तः सुगतिं गन्तुमिच्छसि ।\nतदाराधय सर्वेशं भास्करं ज्योतिषां पतिम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002402011, "chapter_id": 22402, "verse_number": "१-६४-१२", "content_sanskrit": "पुष्पैः सुगन्धैर्हद्यैश्च धूपैः सागरुचन्दनैः ।\nवासोभिर्भूषणैर्भक्ष्यैरुपवासपरायणः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002402012, "chapter_id": 22402, "verse_number": "१-६४-१३", "content_sanskrit": "यदि संसारनिर्वेदादभिवाच्छसि सद्गतिम् ।\nतदाराधय मार्तण्डं भक्तिप्रवणचेतसा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002402013, "chapter_id": 22402, "verse_number": "१-६४-१४", "content_sanskrit": "पुष्पाणि यदि ते न स्नुः शस्तपादपपल्लवैः ।\nदूर्वाङ्करैरपि दिण्डे तदभावेऽर्चयार्यमम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002402014, "chapter_id": 22402, "verse_number": "१-६४-१५", "content_sanskrit": "पुष्पपत्राम्बुभिर्धूपैर्यथाविभवमात्मनः ।\nपूजितस्तुष्टिमतुलां भक्त्या यात्येकचेतसा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002402015, "chapter_id": 22402, "verse_number": "१-६४-१६", "content_sanskrit": "यः सदायतने भानोः कुरुते मार्जनक्रियाम् ।\nस यात्युत्तमके स्थाने सर्वपापं व्यपोहति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002402016, "chapter_id": 22402, "verse_number": "१-६४-१७", "content_sanskrit": "यावत्यः पांसुकणिका मार्ज्यन्ते भास्करालये ।\nदिनानि दिवि तावन्ति तिष्ठत्यर्कसमो नरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002402017, "chapter_id": 22402, "verse_number": "१-६४-१८", "content_sanskrit": "अहन्यहनि यत्पापं कुरुते गणनायक ।\nगोचर्ममात्रं सम्मार्ज्य हन्ति तद्भास्करालये ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002402018, "chapter_id": 22402, "verse_number": "१-६४-१९", "content_sanskrit": "यश्चानुलेपनं कुर्याद्भानोरायतने नरः ।\nसोऽपि लोकं समासाद्य हंसेन सह मोदते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002402019, "chapter_id": 22402, "verse_number": "१-६४-२०", "content_sanskrit": "मृदा धातुविकारैर्वा वर्णकैर्गोमयेन वा ।\nउपलेपनकृद्याति मत्पुरं यानमास्थितः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002402020, "chapter_id": 22402, "verse_number": "१-६४-२१", "content_sanskrit": "उदकाभ्युक्षणं भानोर्यः करोति सदा गृहे ।\nसोऽपि गच्छति यत्रास्ते भगवान्यादसां पतिः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002402021, "chapter_id": 22402, "verse_number": "१-६४-२२", "content_sanskrit": "पुष्पप्रकरमत्यर्थं सुगन्धं भास्करालये ।\nअनुलिप्ते नरो दत्त्वा न दुर्गतिमवाप्नुयात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002402022, "chapter_id": 22402, "verse_number": "१-६४-२३", "content_sanskrit": "विमानमतिशोभाढ्यं सर्वर्तुसुखभूषितम् ।\nसमाप्नोति नरो दत्त्वा दीपकं भास्करालये ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002402023, "chapter_id": 22402, "verse_number": "१-६४-२४", "content_sanskrit": "यस्तु संवत्सरं पूर्णं तिलपात्रप्रदो नरः ।\nध्वजं च भास्करे दद्यात्सममत्र फलं लभेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002402024, "chapter_id": 22402, "verse_number": "१-६४-२५", "content_sanskrit": "विधूतो हन्ति वातेन दातुरज्ञानतः कृतम् ।\nपापं कर्तुर्गृहे भानोर्दिवा रात्रौ नराधिप ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002402025, "chapter_id": 22402, "verse_number": "१-६४-२६", "content_sanskrit": "गीतवाद्यादिभिर्भानुं य उपास्ते तमोपहम् ।\nगन्धर्वैर्नृत्यगीतैः स विमानस्थो निषेव्यते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002402026, "chapter_id": 22402, "verse_number": "१-६४-२७", "content_sanskrit": "जातिस्मरत्वं मेधां च तथैवोपरमे स्मृतिम् ।\nप्राप्नोति गणाशार्दूल कृत्वा पुस्तकवाचनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002402027, "chapter_id": 22402, "verse_number": "१-६४-२८", "content_sanskrit": "एवं खगेश्वरो भक्त्या येन भानुरुपासितः ।\nस प्राप्नोति गतिं श्लाध्यां यां यामिच्छति चेतसा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002402028, "chapter_id": 22402, "verse_number": "१-६४-२९", "content_sanskrit": "देवत्वं मनुजैः कैश्चिद्गन्धर्वत्वं तथा परैः ।\nविद्याधरत्वमपरैः संराध्येह दिवाकरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002402029, "chapter_id": 22402, "verse_number": "१-६४-३०", "content_sanskrit": "शक्रः क्रतुशतेनेशमाराध्य ज्योतिषां पतिम् ।\nदेवेन्द्रत्वं गतस्तस्मान्नान्यः२ पूज्यतमः क्वचित् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002402030, "chapter_id": 22402, "verse_number": "१-६४-३१", "content_sanskrit": "ब्रह्मचारिगृहस्थानां वनस्थानां गणाधिप ।\nनान्यः पूज्यस्तथा स्त्रीणामृते देवं दिवाकरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002402031, "chapter_id": 22402, "verse_number": "१-६४-३२", "content_sanskrit": "मध्ये परिव्राजकानां सहस्रांशुं महात्मनाम् ।\nमोक्षद्वारं विशन्तीह तं रविं विजितात्मनाम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002402032, "chapter_id": 22402, "verse_number": "१-६४-३३", "content_sanskrit": "एवं सर्वाश्रमाणां हि सहस्रांशुः परायणम् ।\nसर्वेषां चैव वर्णानां ग्रहेशो वै गतिः परा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002402033, "chapter_id": 22402, "verse_number": "१-६४-३४", "content_sanskrit": "शृणुष्व गदतः काम्यानुपवासांस्तथापरान् ।\nशृणु दिण्डे महापुण्यफलकां सप्तमीं पराम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002402034, "chapter_id": 22402, "verse_number": "१-६४-३५", "content_sanskrit": "आदित्याराधनायैनां सर्वपापहरां शिवाम् ।\nयामुपोष्य नरो भक्त्या मुच्यते सर्वपातकैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002402035, "chapter_id": 22402, "verse_number": "१-६४-३६", "content_sanskrit": "तथा लोकमवाप्नोति सूर्यस्यामिततेजसः ।\nअथ भाद्रपदे मासि शुक्लपक्षे समागते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002402036, "chapter_id": 22402, "verse_number": "१-६४-३७", "content_sanskrit": "सोपोष्या प्रथमं तात विधानं शृणु तत्र वै ।\nअयाचितं चतुर्थ्यां तु पञ्चम्यामेकभोजनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002402037, "chapter_id": 22402, "verse_number": "१-६४-३८", "content_sanskrit": "उपवासपरः षष्ठ्यां जितक्रोधो जितेन्द्रियः ।\nअर्चयित्वा दिनकरं गन्धधूपनिवेदनैः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002402038, "chapter_id": 22402, "verse_number": "१-६४-३९", "content_sanskrit": "पुरतः स्थण्डिले रात्रौ स्वप्याद्देवस्य पुत्रक ।\nप्रध्यायन्मनसा देवं सर्वभूतार्तिनाशनम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002402039, "chapter_id": 22402, "verse_number": "१-६४-४०", "content_sanskrit": "सर्वदोषप्रशमनं सर्वपातकनाशनम् ।\nविबुद्धस्त्वथ सप्तम्यां कुर्याद्ब्राह्मणभोजनम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002402040, "chapter_id": 22402, "verse_number": "१-६४-४१", "content_sanskrit": "पूजयित्वा दिनकरं पुष्पधूपविलेपनैः ।\nनैवेद्यं तात देवस्य फलानि कथयन्ति४ हि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002402041, "chapter_id": 22402, "verse_number": "१-६४-४२", "content_sanskrit": "खर्जूरनालिकेराणि तथा आम्रफलानि तु ।\nमातुलिङ्गफलान्येव कथितानि मनीषिभिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002402042, "chapter_id": 22402, "verse_number": "१-६४-४३", "content_sanskrit": "एतैश्च भोजयेद्विप्रानात्मना च प्रभक्षयेत् ।\nतथैषां चाप्यभावेन शृणु चान्यानि सुव्रत ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002402043, "chapter_id": 22402, "verse_number": "१-६४-४४", "content_sanskrit": "शालिगोधूमपिष्टानि कारयेद्गणनायक ।\nगुडगर्भकृतानीह घृतपाकेन पावयेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002402044, "chapter_id": 22402, "verse_number": "१-६४-४५", "content_sanskrit": "चातुर्यावकमिश्राणि आदित्याय निवेदयेत् ।\nअग्निकार्यमथो कृत्वा ब्राह्मणान्भोजयेत्ततः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002402045, "chapter_id": 22402, "verse_number": "१-६४-४६", "content_sanskrit": "इत्थं द्वादश वै मासान्कार्यं व्रतमनुत्तमम् ।\nमासि मासि फलाहारः फलदायी फलार्चनः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002402046, "chapter_id": 22402, "verse_number": "१-६४-४७", "content_sanskrit": "वर्षान्ते त्वथ कुर्वीत शक्त्या ब्राह्मणभोजनम् ।\nस्नानप्राशनयोश्चापि विधानं शृणु सुव्रत ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002402047, "chapter_id": 22402, "verse_number": "१-६४-४८", "content_sanskrit": "गोमूत्रं गोमयं क्षीरं दधि सर्पिः कुशोदकम् ।\nतिलसर्षपयोः कल्कं श्वेता मृच्चापि सुव्रत ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002402048, "chapter_id": 22402, "verse_number": "१-६४-४९", "content_sanskrit": "दूर्वाकल्कं घृतं चापि गोशृंगक्षालितं जलम् ।\nजातिगुल्मविनिर्यासः प्रशस्तः स्नानकर्मणि ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002402049, "chapter_id": 22402, "verse_number": "१-६४-५०", "content_sanskrit": "प्राशने चाप्यथैतानि सर्वपापहराणि वै ।\nआदौ कृत्वा भाद्रपदं यथा संख्यं विदुर्बुधाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002402050, "chapter_id": 22402, "verse_number": "१-६४-५१", "content_sanskrit": "इत्थं वर्षान्तमासाद्य भोजयित्वा द्विजोत्तमान् ।\nदिव्यान्भोगान्महादेव ततस्तेभ्यो निवेदयेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002402051, "chapter_id": 22402, "verse_number": "१-६४-५२", "content_sanskrit": "फलानि तात१ हैमानि यथा शक्त्या गणाधिप ।\nसवत्सामथ वा धेनुं भूमिं सस्यान्वितामथ ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002402052, "chapter_id": 22402, "verse_number": "१-६४-५३", "content_sanskrit": "प्रासादमथ वा भौमं सर्वधान्यसमन्वितम् ।\nदद्यात्छुक्लानि२ वस्त्राणि ताम्रपात्रं सविद्रुमम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002402053, "chapter_id": 22402, "verse_number": "१-६४-५४", "content_sanskrit": "शक्तियुक्तस्य चैतानि दरिद्रस्य तु मे शृणु ।\nफलानि पिष्टकान्येषां तिलचूर्णान्वितानि तु ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002402054, "chapter_id": 22402, "verse_number": "१-६४-५५", "content_sanskrit": "भोजयित्वा द्विजान्दद्याद्राजतानि४ फलानि तु ।\nधातुरक्तं वस्त्रयुगममाचार्याय निवेदयेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002402055, "chapter_id": 22402, "verse_number": "१-६४-५६", "content_sanskrit": "सहिरण्यं महादेव पञ्चरत्नसमन्वितम् ।\nइत्थं समाप्यते तात पारणं वार्षिकान्तिकम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002402056, "chapter_id": 22402, "verse_number": "१-६४-५७", "content_sanskrit": "इत्येषा वै पुण्यतमा सप्तमी दुरितापहा ।\nयामुपोष्य नराः सर्वे यान्ति सूर्यसलोकताम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002402057, "chapter_id": 22402, "verse_number": "१-६४-५८", "content_sanskrit": "१ पूज्यमानः सदा देवैर्गन्धर्वाप्सरसां गणैः ।\nअनया मानवो नित्यं पूजयेद्भास्करं सदा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002402058, "chapter_id": 22402, "verse_number": "१-६४-५९", "content_sanskrit": "दारिद्यदुःखदुरितैर्मुक्तो याति दिवाकरम् ।\nब्राह्मणो मोक्षमायाति क्षत्रियश्चेन्द्रतां व्रजेत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002402059, "chapter_id": 22402, "verse_number": "१-६४-६०", "content_sanskrit": "वैश्यो धनदसालोक्यं शूद्रोः विप्रत्वमाप्नुयात् ।\nअपुत्रो लभते पुत्रं दुर्भगा सुभगा भवेत् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002402060, "chapter_id": 22402, "verse_number": "१-६४-६१", "content_sanskrit": "यामुपोष्य च नारीमां सप्तमीं लोकपूजिताम् ।\nविधवा वा सती भक्त्या अनया पूजयेद्रविम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002402061, "chapter_id": 22402, "verse_number": "१-६४-६२", "content_sanskrit": "नान्यजन्मनि वैधव्यं नारी प्राप्नोति मानद ।\nचिन्तामणिसमा ह्येषा विज्ञेया फलसप्तमी ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002402062, "chapter_id": 22402, "verse_number": "१-६४-६३", "content_sanskrit": "पठतां शृण्वतां दिण्डे सर्वकामप्रदा स्मृता ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]