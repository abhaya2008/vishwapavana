[{"id": 2147247, "chapter_id": 4182, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2147248, "chapter_id": 4182, "verse_number": "१", "content_sanskrit": "अथाह गालवं दीनं सुपर्णः पततां वरः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2147249, "chapter_id": 4182, "verse_number": "२", "content_sanskrit": "निर्मितं वह्निना भूमौ वायुना वर्धितं तथा ।\nयस्माद्धिरण्मयं सर्वं हिरण्यं तेन चोच्यते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2147250, "chapter_id": 4182, "verse_number": "३", "content_sanskrit": "धत्ते धारयते चेदम् एतस्मात् कारणाद् धनम् ।\nतदेतत् त्रिषु लोकेषु धनं तिष्ठति शाश्वतम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2147251, "chapter_id": 4182, "verse_number": "४", "content_sanskrit": "नित्यं प्रोष्ठपदाभ्यां च शक्रे धनपतौ तथा ।\nमनुष्येभ्यः सदाऽऽदत्ते शक्रश्चित्तार्जितं धनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2147252, "chapter_id": 4182, "verse_number": "५", "content_sanskrit": "अजैकपादहिर्बुध्न्यौ रक्ष्येते धनदेन च ।\nएवं न शक्यते लब्धुमलब्धव्यं द्विजर्षभ\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2147253, "chapter_id": 4182, "verse_number": "६", "content_sanskrit": "ऋते न धनमश्वानामवाप्तिर्विद्यते तव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2147254, "chapter_id": 4182, "verse_number": "७", "content_sanskrit": "अर्थं याचस्व राजानं कञ्चिद् राजर्षिवंशजम् ।\nअपीड्य राजा पौरान् हि यो नौ कुर्यात् कृतार्थिनौ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2147255, "chapter_id": 4182, "verse_number": "८", "content_sanskrit": "अस्ति सोमान्ववाये मे जातः कश्चिन्नृपः सखा ।\nअभिगच्छावहे तं वै यस्यास्ति विभवो भुवि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2147256, "chapter_id": 4182, "verse_number": "९", "content_sanskrit": "ययातिर्नाम राजर्षिः नाहुषः सत्यविक्रमः ।\nस दास्यति मया चोक्तो भवता चार्थितः स्वयम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2147257, "chapter_id": 4182, "verse_number": "१०", "content_sanskrit": "विभवश्चास्य सुमहान् आसीद् धनपतेरिव ।\nएवं गुरुधनं विद्वन् दानेनैव विशोधय\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2147258, "chapter_id": 4182, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2147259, "chapter_id": 4182, "verse_number": "११", "content_sanskrit": "तथा तौ कथयन्तौ च चिन्तयन्तौ च यत् क्षमम् ।\nप्रतिष्ठाने नरपतिं ययातिं प्रत्युपस्थितौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2147260, "chapter_id": 4182, "verse_number": "१२", "content_sanskrit": "प्रतिगृह्य च सत्कारैरर्घ्यपाद्यादिकं ददौ ।\nपृष्टश्चागमने हेतुमुवाच विनतासुतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2147261, "chapter_id": 4182, "verse_number": "१३", "content_sanskrit": "अयं मे नाहुष सखा गालवस्तपसो निधिः ।\nविश्वामित्रस्य शिष्योऽभूद् वर्षाण्ययुतशो नृप\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2147262, "chapter_id": 4182, "verse_number": "१४", "content_sanskrit": "सोऽयं तेनाभ्यनुज्ञात उपकारेप्सया द्विजः ।\nतमाह भगवन् किं ते ददानि गुरुदक्षिणाम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2147263, "chapter_id": 4182, "verse_number": "१५", "content_sanskrit": "असकृत् तेन चोक्तेन किञ्चिदागतमन्युना ।\nअयमुक्तः प्रयच्छेति जानता विभवं लघु\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2147264, "chapter_id": 4182, "verse_number": "१६", "content_sanskrit": "एकतः श्यामकर्णानां शुभ्राणां शुद्धजन्मनाम् ।\nअष्टौ शतानि मे देहि हयानां चन्द्रवर्चसाम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2147265, "chapter_id": 4182, "verse_number": "१७", "content_sanskrit": "गुर्वर्थो दीयतामेष यदि गालव मन्यसे ।\nइत्येवमाह सक्रोधो विश्वामित्रस्तपोधनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2147266, "chapter_id": 4182, "verse_number": "१८", "content_sanskrit": "सोऽयं शोकेन महता तप्यमानो द्विजर्षभः ।\nअशक्तः प्रतिकर्तुं तद् भवन्तं शरणं गतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2147267, "chapter_id": 4182, "verse_number": "१९", "content_sanskrit": "प्रतिगृह्य नरव्याघ्र त्वत्तो भिक्षां गतव्यथः ।\nकृत्वाऽपवर्गं गुरवे चरिष्यति महत् तपः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2147268, "chapter_id": 4182, "verse_number": "२०", "content_sanskrit": "तपसः संविभागेन भवन्तमपि योक्ष्यते ।\nस्वेन राजर्षितपसा पूर्णं त्वां पूरयिष्यति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2147269, "chapter_id": 4182, "verse_number": "२१", "content_sanskrit": "यावन्ति रोमाणि हये भवन्तीह नरेश्वर ।\nतावतो वाजिदा लोकान् प्राप्नुवन्ति महीपते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2147270, "chapter_id": 4182, "verse_number": "२२", "content_sanskrit": "पात्रं प्रतिग्रहस्यायं दातुं पात्रं तथा भवान् ।\nशङ्खे क्षीरमिवासक्तं भवत्वेतत् तथोपमम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2147271, "chapter_id": 4182, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि त्रयो- दशोत्तरशततमोऽध्यायः ॥११३॥ भगवद्यानपर्वणि चतुश्चत्वारिंशोऽध्यायः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]