[{"id": 2110756, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2110757, "chapter_id": 3394, "verse_number": "१", "content_sanskrit": "जरां प्राप्य ययातिस्तु स्वपुरं प्राप्य चैव ह ।\nपुत्रं ज्येष्ठं वरिष्ठं च यदुमित्यब्रवीद् वचः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2110758, "chapter_id": 3394, "verse_number": "२", "content_sanskrit": "जरावली च मे तात पलितानि च पर्यगुः ।\nकाव्यस्योशनसः शापान्न तृप्तोऽस्मि च यौवने\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2110759, "chapter_id": 3394, "verse_number": "३", "content_sanskrit": "त्वं यदो प्रतिपद्यस्व पाप्मानं जरया सह ।\nयौवनेन त्वदीयेन चरेयं विषयानहम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2110760, "chapter_id": 3394, "verse_number": "४", "content_sanskrit": "पूर्णे वर्षसहस्रे तु त्वदीयं यौवनं त्वहम् ।\nदत्त्वा स्वं प्रतिपत्स्यामि पाप्मानं जरया सह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2110761, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "यदुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2110762, "chapter_id": 3394, "verse_number": "५", "content_sanskrit": "सितश्मश्रुशिरो दीनो जरया शिथिलीकृतः ।\nवलीसन्ततिगात्रश्च दुर्दर्शो दुर्बलः कृशः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2110763, "chapter_id": 3394, "verse_number": "६", "content_sanskrit": "अशक्तः कार्यकरणे परिभूतः सयौवनैः ।\nसहोपजीविभिश्चैव तां जरां नैव कामये\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2110764, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2110765, "chapter_id": 3394, "verse_number": "७", "content_sanskrit": "यो मे त्वं हृदयाज्जातो वयः स्वं न प्रयच्छसि ।\nतस्मादराज्यभाक् तात प्रजा वै ते भविष्यति \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2110766, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2110767, "chapter_id": 3394, "verse_number": "८", "content_sanskrit": "प्रत्याख्यातश्च राजा स तुर्वशुं प्रत्युवाच ह ।\nतुर्वशो प्रतिपद्यस्व पाप्मानं जरया सह \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2110768, "chapter_id": 3394, "verse_number": "९", "content_sanskrit": "यौवनेन चरेयं वै विषयांस्तव पुत्रक ।\nपूर्णे वर्षसहस्रे तु प्रतिदास्यामि यौवनम् ।\nस्वं चैव प्रतिपत्स्यामि पाप्मानं जरया सह\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2110769, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "तुर्वशुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2110770, "chapter_id": 3394, "verse_number": "१०", "content_sanskrit": "न कामये जरां तात कामभोगविनाशिनीम् ।\nबलरूपान्तकरिणीं बुद्धिप्राणविनाशिनीम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2110771, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2110772, "chapter_id": 3394, "verse_number": "११", "content_sanskrit": "यो मे त्वं हृदयाज्जातो वयः स्वं न प्रयच्छसि ।\nतुर्वशो त्वं प्रियं कामं नैव सम्पत्स्यसे क्वचित् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2110773, "chapter_id": 3394, "verse_number": "१२", "content_sanskrit": "स चोडुप्लवसन्तारस्तत्र नित्यं भविष्यसि ।\nअराजा भोजशब्दं तु तत्रावाप्स्यसि सान्वयः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2110774, "chapter_id": 3394, "verse_number": "१३", "content_sanskrit": "तस्मात् प्रजा समुच्छेदं तुर्वशो तव यास्यति ।\nसङ्कीर्णाचारधर्मेषु प्रतिलोमचरेषु च \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2110775, "chapter_id": 3394, "verse_number": "१४", "content_sanskrit": "म्लेच्छेषु पिशिताशेषु मूढो राजा भविष्यसि ।\nगुरुदारप्रसक्तेषु तिर्यग्योनिगतेषु च ।\nछिन्नधर्मस्वरूपेषु व्याधेषु जनयिष्यसि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2110776, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2110777, "chapter_id": 3394, "verse_number": "१५", "content_sanskrit": "एवं स तुर्वशुं शप्त्वा ययातिः सुतमात्मनः ।\nशर्मिष्ठायाः सुतं द्रुह्युमिदं वचनमब्रवीत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2110778, "chapter_id": 3394, "verse_number": "१६", "content_sanskrit": "द्रुह्यो त्वं प्रतिपद्यस्व पाप्मानं जरया सह ।\nयौवनेन चरेयं वै विषयांस्तव पुत्रक \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2110779, "chapter_id": 3394, "verse_number": "१८", "content_sanskrit": "पूर्णे वर्षसहस्रे तु प्रतिदास्यामि यौवनम् ।\nस्वं चैव प्रतिपत्स्यामि पाप्मानं जरया सह \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2110780, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "द्रुह्युः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2110781, "chapter_id": 3394, "verse_number": "१९", "content_sanskrit": "जीर्णः शिशुवदादत्ते कालेऽन्नमशुचिर्यथा ।\nन जुहोति च कालेऽग्नीन् न बुध्यति च कालतः ।\nन च कृत्यं करोत्येष तां जरां नैव कामये\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2110782, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2110783, "chapter_id": 3394, "verse_number": "२०", "content_sanskrit": "यो मे त्वं हृदयाज्जातो वयः स्वं न प्रयच्छसि ।\nजरादोषस्त्वयोक्तोऽयं तस्मान्न प्रतिपद्यसे\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2110784, "chapter_id": 3394, "verse_number": "२१", "content_sanskrit": "प्रजाश्च यौवनं प्राप्ता विनशिष्यन्त्वतस्तव ।\nअग्निप्रस्पन्दनपरस्त्वं चापि न भविष्यसि\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2110785, "chapter_id": 3394, "verse_number": "२२", "content_sanskrit": "अनो त्वं प्रतिपद्यस्व पाप्मानं जरया सह ।\nएकं वर्षसहस्रं वै चरेयं तव रूपधृक्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2110786, "chapter_id": 3394, "verse_number": "२३", "content_sanskrit": "पूर्णे वर्षसहस्रे तु पुनस्ते यौवनं त्वहम् ।\nदत्त्वा च प्रतिपत्स्यामि पाप्मानं जरया सह\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2110787, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "अनुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2110788, "chapter_id": 3394, "verse_number": "२४", "content_sanskrit": "न हस्तिनं नरो नाश्वं जीर्णो भुङ्क्ते न पीठकम् ।\nवाग् दुर्भगाऽस्य भवति तां जरां नैव कामये \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2110789, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2110790, "chapter_id": 3394, "verse_number": "२५", "content_sanskrit": "यो मे त्वं हृदयाज्जातो वयः स्वं न प्रयच्छसि ।\nहस्त्यश्वरथयुग्यानामध्वा न स्यात् कदाचन\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2110791, "chapter_id": 3394, "verse_number": "२६", "content_sanskrit": "हस्तिनां पीठकानां वा गर्दभानां तथैव च ।\nउष्ट्राणां च गवां चैव शिबिकायास्तथैव च \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2110792, "chapter_id": 3394, "verse_number": "२७", "content_sanskrit": "यद्वाऽन्यद् वाहनं किञ्चिद् देवो हन्यात् क्वचित्क्वचित् ।\nअराजा तव जातिश्च भविष्यति न संशयः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2110793, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2110794, "chapter_id": 3394, "verse_number": "२८", "content_sanskrit": "प्रत्याख्यातश्चतुर्भिस्तु शप्त्वा तान् यदुपूर्वकान् ।\nपूरोः सकाशमगमद् ध्यात्वा पूरुमलङ्घिनम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2110795, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "ययतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2110796, "chapter_id": 3394, "verse_number": "२९", "content_sanskrit": "पूरो त्वं मे प्रियः पुत्रः त्वं गरीयान् भविष्यसि ।\nजरा वली च मे तात पलितानि च पर्यगुः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2110797, "chapter_id": 3394, "verse_number": "३०", "content_sanskrit": "काव्यस्योशनसः शापान्न च तृप्तोऽस्मि यौवने ।\nपूरो त्वं प्रतिपद्यस्व पाप्मानं जरया सह\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2110798, "chapter_id": 3394, "verse_number": "३१", "content_sanskrit": "यथाकामं चरेयं वै विषयान् वयसा तव ।\nपूर्णे वर्षसहस्रे तु प्रतिदास्यामि यौवनम् ।\nस्वं चैव प्रतिपत्स्यामि पाप्मानं जरया सह\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2110799, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2110800, "chapter_id": 3394, "verse_number": "३२", "content_sanskrit": "एवमुक्तः प्रत्युवाच पुत्रः पितरमञ्जसा ।\nयथात्थ मां महाराज तत् करिष्यामि ते वचः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2110801, "chapter_id": 3394, "verse_number": "३३", "content_sanskrit": "गुरोर्वै वचनं पुण्यं स्वर्ग्यमायुष्करं नृणाम् ।\nगुरुप्रसादात् त्रैलोक्यमन्वशासच्छतक्रतुः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2110802, "chapter_id": 3394, "verse_number": "३४", "content_sanskrit": "गुरोरनुमतं प्राप्य सर्वान् कामानवाप्नुयात्।\nप्रतिपत्स्यामि ते राजन् पाप्मानं जरया सह\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2110803, "chapter_id": 3394, "verse_number": "३५", "content_sanskrit": "यावदिच्छसि वाऽऽजीवं तावत् तां धारयाम्यहम् ।\nगृहाण यौवनं मत्तश्चर कामान् यथेप्सितान् \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2110804, "chapter_id": 3394, "verse_number": "३६", "content_sanskrit": "जरयाऽहं प्रतिच्छन्नो वसे रूपधरस्तव ।\nयौवनं भवते दत्त्वा चरिष्यामि यथात्थ माम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2110805, "chapter_id": 3394, "verse_number": "", "content_sanskrit": "ययातिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2110806, "chapter_id": 3394, "verse_number": "३७", "content_sanskrit": "पूरो प्रीतोऽस्मि ते पुत्र प्रीतश्चेदं ददामि ते ।\nसर्वकामसमृद्धा ते प्रजा राज्ये भविष्यति\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2110807, "chapter_id": 3394, "verse_number": "७३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्रिसप्ततितमोऽध्यायः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2110808, "chapter_id": 3394, "verse_number": "२१", "content_sanskrit": "॥ सम्भवपर्वणि एकविंशोऽध्यायः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]