[{"id": 7004284000, "chapter_id": 24284, "verse_number": "५-२-६२-१", "content_sanskrit": "ईश्वर उवाच ।\nद्विषष्टिकं विजानीहि देवं रूपेश्वरं प्रिये ।\nयस्य दर्शनमात्रेण रूपवाञ्जायते नरः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004284001, "chapter_id": 24284, "verse_number": "५-२-६२-२", "content_sanskrit": "पाद्मकल्पे महादेवि पद्मोनाम महीपतिः ।\nपद्मगर्भसमुद्भूतो बभूवातिपराक्रमी ।\nपृथिव्याश्चतुरंताया जातो धर्मरतो बली॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004284002, "chapter_id": 24284, "verse_number": "५-२-६२-३", "content_sanskrit": "स कदाचिन्महाबाहुः प्रभूतबलवाहनः ।\nवनं जगाम गहनं हयनागशतैर्वृतः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004284003, "chapter_id": 24284, "verse_number": "५-२-६२-४", "content_sanskrit": "बिल्वार्कखदिराकीर्णं कपित्थधवसंकुलम् ।\nमृगसिंहैर्वृतं घोरैरन्यैश्चापि वनेचरैः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004284004, "chapter_id": 24284, "verse_number": "५-२-६२-५", "content_sanskrit": "तत्र वन्यसहस्राणि हत्वा सबलवाहनः ।\nराजा मृगप्रसंगेन वनमन्यद्विवेश सः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004284005, "chapter_id": 24284, "verse_number": "५-२-६२-६", "content_sanskrit": "एक एवोत्तमबलः क्षुत्पिपासासमन्वितः ।\nस वनस्यांतमासाद्य महदारण्यमासदत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004284006, "chapter_id": 24284, "verse_number": "५-२-६२-७", "content_sanskrit": "तच्चाप्यतीत्य नृपतिर्ददर्शाश्रममुत्तमम् ।\nमनःप्रह्लादजननं दृष्टिकांतमतीव च॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004284007, "chapter_id": 24284, "verse_number": "५-२-६२-८", "content_sanskrit": "पुष्पितैः पादपैः कीर्णमतीव सुखशाद्वलम् ।\nततोऽगच्छन्महाबाहुरेकोऽमात्यान्विसृज्य तान्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004284008, "chapter_id": 24284, "verse_number": "५-२-६२-९", "content_sanskrit": "नापश्यदाश्रमे तस्मिंस्तमृषिं संशितव्रतम् ।\nउवाच क इहेत्युच्चैर्वनं संनाद्यन्निव॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004284009, "chapter_id": 24284, "verse_number": "५-२-६२-१०", "content_sanskrit": "श्रुत्वाथ तं तथा शब्दं कन्या श्रीरिव रूपिणी ।\nनिश्चक्रामाश्रमात्तस्मात्तापसाकारधारिणी॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004284010, "chapter_id": 24284, "verse_number": "५-२-६२-११", "content_sanskrit": "सा तं दृष्ट्वैव राजानं पद्मगर्भसमुद्भवम् ।\nआसनेनार्चयित्वा च पप्रच्छ नाम तं तदा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004284011, "chapter_id": 24284, "verse_number": "५-२-६२-१२", "content_sanskrit": "उवाच स्मयमानाथ किं कार्यं क्रियतामिति ।\nतामब्रवीत्ततो राजा कन्यां मधुरभाषिणीम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004284012, "chapter_id": 24284, "verse_number": "५-२-६२-१३", "content_sanskrit": "दृष्ट्वा चैवानवद्यांगीं यथावत्प्रतिपूजितः ।\nआगतोऽहं महाभागे मुनिश्रेष्ठमुपासितुम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004284013, "chapter_id": 24284, "verse_number": "५-२-६२-१४", "content_sanskrit": "क्व गतो भगवान्भद्रे तन्ममाचक्ष्व शोभने ।\nएवमुक्ता तु सा कन्या तेन राज्ञा तदाश्रमे ।\nहसंती प्रत्युवाचेदं वाक्यं समधुराक्षरम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004284014, "chapter_id": 24284, "verse_number": "५-२-६२-१५", "content_sanskrit": "कन्याहं पृथिवीपाल कौमारब्रह्मचारिणः ।\nतपस्विनो धृतिमतो धर्मज्ञस्य मनस्विनः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004284015, "chapter_id": 24284, "verse_number": "५-२-६२-१६", "content_sanskrit": "सुता कण्वस्य मामेवं विद्धि त्वं मनुजाधिप ।\nकण्वं हि पितरमन्ये पितरं स्वमजानती॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004284016, "chapter_id": 24284, "verse_number": "५-२-६२-१७", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा नृपेणोक्तं वरानने ।\nसुव्यक्तं राजपुत्री त्वं यथा कल्याणि भाषसे॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004284017, "chapter_id": 24284, "verse_number": "५-२-६२-१८", "content_sanskrit": "भार्या मे भव सुश्रोणि ब्रूहि किं करवाणि ते ।\nसुवर्णरत्नवासांसि कुंडले परिहारके॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004284018, "chapter_id": 24284, "verse_number": "५-२-६२-१९", "content_sanskrit": "आहरामि तवाद्याहं भार्या मे भव शोभने ।\nगांधर्वेण च मां भीरु विवाहेनैव सुंदरि ।\nविवाहानां च रंभोरु गांधर्वः श्रेष्ठ उच्यते॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004284019, "chapter_id": 24284, "verse_number": "५-२-६२-२०", "content_sanskrit": "नृपस्य वचनं श्रुत्वा कन्या वचनमब्रवीत् ।\nमुहूर्त्तं संप्रतीक्षस्व स मां तुभ्यं प्रदास्यति॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004284020, "chapter_id": 24284, "verse_number": "५-२-६२-२१", "content_sanskrit": "राजोवाच ।\nइच्छामि त्वां वरारोहे भजमानमनिंदिते ।\nतदर्थं मां स्थितं विद्धि त्वया मेऽपहृतं मनः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004284021, "chapter_id": 24284, "verse_number": "५-२-६२-२२", "content_sanskrit": "आत्मनो बंधुरात्मैव गतिरात्मैव चात्मनः ।\nआत्मनैवात्मनो दानं कर्तुमर्हसि धर्मतः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004284022, "chapter_id": 24284, "verse_number": "५-२-६२-२३", "content_sanskrit": "कन्योवाच ।\nयदि धर्मपथस्त्वेष यदि चात्मा प्रभुर्मम ।\nसत्यं मे प्रतिजानीहि दत्तमात्मानमद्य मे॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004284023, "chapter_id": 24284, "verse_number": "५-२-६२-२४", "content_sanskrit": "इति तस्या वचः श्रुत्वा परिणीता नृपेण हि ।\nगांधर्वेण विवाहेन कामासक्तेन पार्वति॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004284024, "chapter_id": 24284, "verse_number": "५-२-६२-२५", "content_sanskrit": "कामिता सा नृपेणेव ततो गंतुं समुद्यतः ।\nएतस्मिन्नंतरे देवि कण्वश्चाश्रममभ्यगात्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004284025, "chapter_id": 24284, "verse_number": "५-२-६२-२६", "content_sanskrit": "सा कन्या पितरं दृष्ट्वा ह्रिया नोपजगाम तम् ।\nविज्ञायाथ च तां विप्रो दिव्यज्ञानो महातपाः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004284026, "chapter_id": 24284, "verse_number": "५-२-६२-२७", "content_sanskrit": "उवाच परमं कुद्धस्तां कन्यां काममोहिताम् ।\nत्वयापि दुष्टे रहसि मामवज्ञाय यत्कृतः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004284027, "chapter_id": 24284, "verse_number": "५-२-६२-२८", "content_sanskrit": "स्वयं स्वयंवरो मोहात्तस्मात्कृष्णा भविष्यसि ।\nकुत्सिता निर्घृणा दीना निर्लज्जा रूपवर्जिता॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004284028, "chapter_id": 24284, "verse_number": "५-२-६२-२९", "content_sanskrit": "अयं ते नृपतिर्भर्त्ता दुष्टरूपो भविष्यति॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004284029, "chapter_id": 24284, "verse_number": "५-२-६२-३०", "content_sanskrit": "इत्युक्ता तत्क्षणाज्जाता सा कन्या रूपवर्जिता ।\nकुरूपो नृपतिर्जातः शापात्तस्य महात्मनः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004284030, "chapter_id": 24284, "verse_number": "५-२-६२-३१", "content_sanskrit": "अथ प्रसादयामास सा कन्या पितरं तदा ।\nबालानभिज्ञा मूढाहं मन्मथेन प्रपीडिता॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004284031, "chapter_id": 24284, "verse_number": "५-२-६२-३२", "content_sanskrit": "अज्ञानाच्च कृतं पापं तात त्वं क्षंतुमर्हसि ।\nअयं महीपतिस्तात प्रत्यग्लीनो महाव्रतः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004284032, "chapter_id": 24284, "verse_number": "५-२-६२-३३", "content_sanskrit": "न चाहं प्रार्थिता तेन मयासौ प्रार्थितो नृपः ।\nतस्मादनुग्रहं तात कर्त्तुमर्हसि चावयोः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004284033, "chapter_id": 24284, "verse_number": "५-२-६२-३४", "content_sanskrit": "इति तस्या वचः श्रुत्वा स विप्रोऽतिकृपान्वितः ।\nउवाच स्वां दुहितरमाश्वास्यैवं पुनःपुनः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004284034, "chapter_id": 24284, "verse_number": "५-२-६२-३५", "content_sanskrit": "नैव वागनृतं पुत्रि यावदद्य स्मराम्यहम् ।\nदैवमत्र परं मन्ये धिग्बुद्धिं धिक्पराक्रमम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004284035, "chapter_id": 24284, "verse_number": "५-२-६२-३६", "content_sanskrit": "अकार्यं कारितो येन बलादहमनिंदिते ।\nउपदेशं प्रदास्यामि तत्त्वं कर्तुमिहार्हसि॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004284036, "chapter_id": 24284, "verse_number": "५-२-६२-३७", "content_sanskrit": "महाकालवने पुण्ये लिंगं रूपप्रदायकम् ।\nपशुपेश्वरपूर्वे तु विद्यतेऽभीष्टदायकम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004284037, "chapter_id": 24284, "verse_number": "५-२-६२-३८", "content_sanskrit": "तत्त्वं गच्छ त्वरा युक्ता सह भर्त्रा नृपेण हि ।\nरूपं प्राप्स्यसि दुष्प्राप्यं लिंगदर्शनमात्रतः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004284038, "chapter_id": 24284, "verse_number": "५-२-६२-३९", "content_sanskrit": "इत्युक्ता सा तदा कन्या सह भर्त्रा गता प्रिये ।\nमहाकालवने रम्ये यत्र लिंगमनुत्तमम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004284039, "chapter_id": 24284, "verse_number": "५-२-६२-४०", "content_sanskrit": "ददर्श परया भक्त्या स च राजा नरोत्तमः ।\nतत्क्षणाद्दिव्यदेहा सा रूपेणातिमनोहरा ।\nदिव्यवस्त्रपरीधाना दिव्यालंकारभूषिता॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004284040, "chapter_id": 24284, "verse_number": "५-२-६२-४१", "content_sanskrit": "स च राजा तथा जातः कंदर्पसदृशाकृतिः ।\nरूपेणाप्रतिमो लोके तस्य लिंगस्य दर्शनात्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004284041, "chapter_id": 24284, "verse_number": "५-२-६२-४२", "content_sanskrit": "अतो लोकेषु विख्यातो देवो रूपेश्वरः प्रिये ।\nरूपदो धनदोऽत्यर्थं पुत्रदः स्वर्गदस्तथा॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004284042, "chapter_id": 24284, "verse_number": "५-२-६२-४३", "content_sanskrit": "स च राजा स्वकं प्राप्तो राष्ट्रं सस्यादिसंयुतम् ।\nप्रियया परया सार्धं चक्रे राज्यमकंटकम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004284043, "chapter_id": 24284, "verse_number": "५-२-६२-४४", "content_sanskrit": "राज्यं कृत्वा गतः स्वर्गं भार्यया सह पार्वति ।\nदेदीप्यमानो वपुषा द्वितीय इव भास्करः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004284044, "chapter_id": 24284, "verse_number": "५-२-६२-४५", "content_sanskrit": "विमानेन सुदीप्तेन वंद्यमानो दिवालये ।\nदर्शनात्तस्य लिंगस्य प्राप्तः पदमनामयम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004284045, "chapter_id": 24284, "verse_number": "५-२-६२-४६", "content_sanskrit": "ये पश्यंति विशालाक्षि देवं रूपेश्वरं शिवम् ।\nन ते रूपेण हीयंते यशसा च कुलेन च॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004284046, "chapter_id": 24284, "verse_number": "५-२-६२-४७", "content_sanskrit": "सदा रूपकरं लिंगं भुक्तिमुक्तिफलप्रदम् ।\nये पश्यंति वरारोहे तेषां लोकाः सदाऽक्षयाः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004284047, "chapter_id": 24284, "verse_number": "५-२-६२-४८", "content_sanskrit": "येऽर्चयंति नरा नित्यं देवं रूपेश्वरं परम् ।\nतेऽर्चिता यांति यानेन मम लोकं सनातनम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004284048, "chapter_id": 24284, "verse_number": "५-२-६२-४९", "content_sanskrit": "स एव सुकृती लोके कुलं तेनाप्यलंकृतम् ।\nयः पूजयति रूपेशं रूपसौभाग्यदायकम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004284049, "chapter_id": 24284, "verse_number": "५-२-६२-५०", "content_sanskrit": "यः पूजयति देवेशं प्रसंगादपि पार्वति ।\nधनवान्रूपवान्सोऽपि राजा भवति भूतले॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004284050, "chapter_id": 24284, "verse_number": "५-२-६२-५१", "content_sanskrit": "एष ते कथितो देवि प्रभावः पापनाशनः ।\nरूपेश्वरस्य देवस्य धनुःसाहस्रकं॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]