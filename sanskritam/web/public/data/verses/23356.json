[{"id": 7003356000, "chapter_id": 23356, "verse_number": "२-५१-१", "content_sanskrit": "ऋषय ऊचुः    ।\nनिग्रहोऽघोररूपेयं कथितोऽस्माकमुत्तमम् ।\nवज्रवाहनिकां विद्यां वक्तुमर्हसि सत्तम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003356001, "chapter_id": 23356, "verse_number": "२-५१-२", "content_sanskrit": "सूत उवाच  ।\nवज्रवाहनिका नाम सर्वशत्रुभयंकरी ।\nअनया सेचयेद्वज्रं नृपाणां साधयेत्तथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003356002, "chapter_id": 23356, "verse_number": "२-५१-३", "content_sanskrit": "वज्रं कृत्वा विधानेन तद्वज्रमभिषिच्य च ।\nअनया विद्यया तस्मिन्विन्येसेत्कांचनेन च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003356003, "chapter_id": 23356, "verse_number": "२-५१-४", "content_sanskrit": "ततश्चाक्षरलक्षं च जपेद्विद्वान्समाहितः ।\nवज्रीदशांशं जुहुयाद्वज्रकुंडे घृतादिभिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003356004, "chapter_id": 23356, "verse_number": "२-५१-५", "content_sanskrit": "तद्वज्रं गोपयेन्नित्यं दापयेन्नृपतेस्ततः ।\nतेन वज्रेण वै गच्छञ्छत्रूञ्जीयाद्रणाजिरे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003356005, "chapter_id": 23356, "verse_number": "२-५१-६", "content_sanskrit": "पुरा पिता महेनैव लब्धा विद्या प्रयत्नतः ।\nदेवी शक्रोपकारार्थं साक्षाद्वज्रेश्वरी तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003356006, "chapter_id": 23356, "verse_number": "२-५१-७", "content_sanskrit": "पुरा त्वष्ट प्रजानाथो हतपुत्रः सुरेश्वरात् ।\nविद्ययाहरतः सोममिंद्रवैरेण सुव्रताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003356007, "chapter_id": 23356, "verse_number": "२-५१-८", "content_sanskrit": "तस्मिन्यज्ञे यताप्राप्तं विदिनोपकृतं हविः ।\nतदैच्छत महाबाहुर्विश्वरूपविमर्दनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003356008, "chapter_id": 23356, "verse_number": "२-५१-९", "content_sanskrit": "मत्पुत्रमवधीः शक्र न दास्ये तव शोभनम् ।\nभागं भागार्हता नैव विश्वरूपो हतस्त्वया ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003356009, "chapter_id": 23356, "verse_number": "२-५१-१०", "content_sanskrit": "इत्युक्त्वा चाश्रमं सर्वं मोहयामास मायया ।\nततो मायां विनिर्भिद्य विश्वरूपविमर्दनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003356010, "chapter_id": 23356, "verse_number": "२-५१-११", "content_sanskrit": "प्रसह्य सोममपिबत्सगणैश्च शचीपतिः ।\nततस्तच्छेषमादाय क्रोधाविष्टः प्रजापतिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003356011, "chapter_id": 23356, "verse_number": "२-५१-१२", "content_sanskrit": "इंद्रस्य शत्रो वर्धस्व स्वाहेत्यग्नौ जुहाव ह ।\nततः कालाग्निसंकाशो वर्तनाद्वृत्रसंज्ञितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003356012, "chapter_id": 23356, "verse_number": "२-५१-१३", "content_sanskrit": "प्रादुरासीत्सुरेशारिर्दुद्राव वृषांतकः ।\nततः किरीटी भगवान्परित्यज्य दिवं क्षणात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003356013, "chapter_id": 23356, "verse_number": "२-५१-१४", "content_sanskrit": "सहस्रनेत्रः सगणो दुद्राव भयविह्वलः ।\nतदा तमाह स विभृर्हृष्टो ब्रह्मा च विश्वसृट् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003356014, "chapter_id": 23356, "verse_number": "२-५१-१५", "content_sanskrit": "त्यक्त्वा वज्रं तमेतेन जहीत्यरिसरिंदमः ।\nसोऽपि सन्नह्य देवेंद्रो देवैः सार्धं महाभुजः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003356015, "chapter_id": 23356, "verse_number": "२-५१-१६", "content_sanskrit": "निहत्य चाप्रयत्नेन गतवान्विगतज्वरः ।\nतस्माद्वज्रेश्वरीविद्या सर्वशत्रुभयंकरी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003356016, "chapter_id": 23356, "verse_number": "२-५१-१७", "content_sanskrit": "मंदेहा राक्षसा नित्यं विजिता विद्ययैव तु ।\nतां विद्यां संप्रवक्ष्यामि सर्वपापप्रमोचनीम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003356017, "chapter_id": 23356, "verse_number": "२-५१-१८", "content_sanskrit": "ॐ भूर्भुवस्वः तत्सवितुर्वरेण्यं भर्गो देवस्य धीमहि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003356018, "chapter_id": 23356, "verse_number": "२-५१-१९", "content_sanskrit": "धियो यो नः प्रचोदयात्  ।\nॐ फट् जहि हुं फट् छिंधि भिंधि जहि हनहन स्वाहा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003356019, "chapter_id": 23356, "verse_number": "२-५१-२०", "content_sanskrit": "विद्या वज्रेश्वरीत्येषा सर्वशत्रुभयंकरी ।\nअनया संहृतिः शंभोर्विद्याया मुनिपुंगवाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]