[{"id": 2074472, "chapter_id": 2573, "verse_number": "१२-७८-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074473, "chapter_id": 2573, "verse_number": "१२-७८-१", "content_sanskrit": "व्याख्याता राजधर्मेण वृत्तिरापत्सु भारत।\nकथंचिद्वैश्यधर्मेण जीवेद्वा ब्राह्मणो न वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074474, "chapter_id": 2573, "verse_number": "१२-७८-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074475, "chapter_id": 2573, "verse_number": "१२-७८-२", "content_sanskrit": "अशक्तः क्षत्रधर्मेण वैश्यधर्मेण वर्तयेत्।\nकृषिं गोरक्ष्यमास्थाय व्यसने वृत्तिसंक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074476, "chapter_id": 2573, "verse_number": "१२-७८-३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074477, "chapter_id": 2573, "verse_number": "१२-७८-३", "content_sanskrit": "कानि पण्यानि विक्रीणन्स्वर्गलोकान्न हीयते।\nब्राह्मणो वैश्यधर्मेण वर्तयन्भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074478, "chapter_id": 2573, "verse_number": "१२-७८-४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074479, "chapter_id": 2573, "verse_number": "१२-७८-४", "content_sanskrit": "सुरालवणमित्येतत्तिलान्केसरिणः पशून्।\nवृषभान्मधु मांसं च कृतान्नं च युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074480, "chapter_id": 2573, "verse_number": "१२-७८-५", "content_sanskrit": "सर्वास्ववस्थास्वेतानि ब्राह्मणः परिवर्जयेत्।\nएतेषां विक्रयात्तात ब्राह्मणो नरके पतेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074481, "chapter_id": 2573, "verse_number": "१२-७८-६", "content_sanskrit": "अजोऽग्निर्वरुणो मेषः सूर्योऽश्वः पृथिवी विराट्।\nधेनुर्यज्ञश्च सोमश्च न विक्रेयाः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074482, "chapter_id": 2573, "verse_number": "१२-७८-७", "content_sanskrit": "पक्वेनामस्य निमयं न प्रशंसन्ति साधवः।\nनिमयेत्पक्वमामेन भोजनार्थाय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074483, "chapter_id": 2573, "verse_number": "१२-७८-८", "content_sanskrit": "वयं सिद्धमशिष्यामो भवान्साधयतामिदम्।\nएवं संवीक्ष्य समयं नाधर्मोऽस्ति कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074484, "chapter_id": 2573, "verse_number": "१२-७८-९", "content_sanskrit": "अत्र ते वर्तयिष्यामि यथा कर्मः सनातनः।\nव्यवहारप्रवृत्तानां तन्निबोध युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074485, "chapter_id": 2573, "verse_number": "१२-७८-१०", "content_sanskrit": "भवतेऽहं ददानीदं भवानेतत्प्रयच्छतु।\nउचितो वर्तते धर्मो न बलात्संप्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074486, "chapter_id": 2573, "verse_number": "१२-७८-११", "content_sanskrit": "इत्येवं संप्रवर्तन्ते व्यवहाराः पुरातनः।\nऋषीणामितरेषां च साधु चैतदसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074487, "chapter_id": 2573, "verse_number": "१२-७८-१२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074488, "chapter_id": 2573, "verse_number": "१२-७८-१२", "content_sanskrit": "अथ तात यदा सर्वाः शस्त्रमाददते प्रजाः।\nव्युत्क्रमन्ते स्वधर्मेभ्यः क्षत्रस्य क्षीयते बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074489, "chapter_id": 2573, "verse_number": "१२-७८-१३", "content_sanskrit": "तदा त्राता तु को नु स्यात्को धर्मः किं परायणम्।\nएतं मे संशयं ब्रूहि विस्तरेण पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074490, "chapter_id": 2573, "verse_number": "१२-७८-१४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074491, "chapter_id": 2573, "verse_number": "१२-७८-१४", "content_sanskrit": "दानेन तपसा यज्ञैदद्रोहेण दमेन च।\nब्राह्मणप्रमुखा वर्णाः क्षेममिच्छेयुरात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074492, "chapter_id": 2573, "verse_number": "१२-७८-१५", "content_sanskrit": "तेषां ये वेदबलिनस्त उत्थाय समन्ततः।\nराज्ञो बलं वर्धयेयुर्महेन्द्रस्येव देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074493, "chapter_id": 2573, "verse_number": "१२-७८-१६", "content_sanskrit": "राज्ञो हि क्षीयमाणस्य ब्रह्मैवाहुः परायणम्।\nतस्माद्ब्राह्मबलेनैव समुत्थेयं विजानता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074494, "chapter_id": 2573, "verse_number": "१२-७८-१७", "content_sanskrit": "यदा तु विजयी राजा क्षेमं राष्ट्रेऽभिसन्दधेत्।\nतदा वर्णा यथाधर्मं निविशेयुः स्वकर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074495, "chapter_id": 2573, "verse_number": "१२-७८-१८", "content_sanskrit": "उन्मर्यादे प्रवृत्ते तु दस्युभिः संकरे कृते।\nसर्वे वर्णा न दुष्येयुः शस्त्रवन्तो युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074496, "chapter_id": 2573, "verse_number": "१२-७८-१९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074497, "chapter_id": 2573, "verse_number": "१२-७८-१९", "content_sanskrit": "अथ चेत्सर्वतः क्षत्रं प्रदुष्येद्ब्राह्मणं प्रति।\nकस्तत्र ब्राह्मणांस्त्राता को धर्मः किं परायणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074498, "chapter_id": 2573, "verse_number": "१२-७८-२०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074499, "chapter_id": 2573, "verse_number": "१२-७८-२०", "content_sanskrit": "तपसा ब्रह्मचर्येण शस्त्रेण च बलेन च।\nअमायया मायया च नियन्तव्यं तदा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074500, "chapter_id": 2573, "verse_number": "१२-७८-२१", "content_sanskrit": "क्षत्रियस्यातिवृत्तस्य ब्राह्मणेषु विशेषतः।\nब्रह्मैव संनियन्तृ स्यात्क्षत्रं हि ब्रह्मसंभवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074501, "chapter_id": 2573, "verse_number": "१२-७८-२२", "content_sanskrit": "अभ्द्योऽग्निर्ब्रह्मतः क्षत्रमश्मनो लोहमुत्थितम्।\nतेषां सर्वत्रगं तेजः स्वस्वयोनिषु शाम्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074502, "chapter_id": 2573, "verse_number": "१२-७८-२३", "content_sanskrit": "यदा छिनत्त्ययोऽश्मानमग्निश्चापोऽभिहन्ति च।\nक्षत्रं च ब्राह्मणं द्वेष्टि तदा शाम्यन्ति ते त्रयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074503, "chapter_id": 2573, "verse_number": "१२-७८-२४", "content_sanskrit": "तस्माद्ब्रह्मणि शाम्यन्ति क्षत्रियाणां युधिष्ठिर।\nसमुदीर्णान्यजेयानि तेजांसि च बलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074504, "chapter_id": 2573, "verse_number": "१२-७८-२५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074505, "chapter_id": 2573, "verse_number": "१२-७८-२५", "content_sanskrit": "ब्रह्मवीर्ये मृदूभूते क्षत्रवीर्ये च दुर्बले।\nदुष्टेषु सर्ववर्णेषु ब्राह्मणान्प्रति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074506, "chapter_id": 2573, "verse_number": "१२-७८-२६", "content_sanskrit": "ये तत्र युद्धं कुर्वन्ति त्यक्त्वा जीवितमात्मनः।\n`ब्राह्मणान्परिरक्षन्ति तेषां लोका भवन्ति के॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2074507, "chapter_id": 2573, "verse_number": "१२-७८-२७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2074508, "chapter_id": 2573, "verse_number": "१२-७८-२७", "content_sanskrit": "ब्राह्मणान्परिरक्षन्तो धर्ममात्मानमेव च।\nमनस्विनो मन्युमन्तः पुण्याँल्लोकान्व्रजन्त्यमी।\nब्राह्मणार्थं हि सर्वेषां शस्त्रग्रहणभिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2074509, "chapter_id": 2573, "verse_number": "१२-७८-२८", "content_sanskrit": "अतिस्विष्टमधीतानां लोकानतितपस्विनाम्।\nअनाशकाग्न्याहितानां शूरा यान्ति परां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2074510, "chapter_id": 2573, "verse_number": "१२-७८-२९", "content_sanskrit": "ब्राह्मणस्त्रिषु वर्णेषु शस्त्रं गृह्णन्न दुष्यति।\nएष एवात्मनस्त्यागो नान्यं धर्मं विदुर्जना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2074511, "chapter_id": 2573, "verse_number": "१२-७८-३०", "content_sanskrit": "तेभ्यो नमश्च भद्रं च ये शरीराणि जुह्वति।\nब्रह्मद्विपो जिघांसन्तस्तेषां नोऽस्तु सलोकता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2074512, "chapter_id": 2573, "verse_number": "१२-७८-३१", "content_sanskrit": "ब्रह्मलोकजितः स्वर्ग्यान्वीरांस्तान्मनुरव्रवीत्।\nयथाऽश्वमेधावभृथे स्नाताः पूता भवन्त्युत।\nदुष्कृतः सुकृतश्चैव तथा शस्त्रहता रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2074513, "chapter_id": 2573, "verse_number": "१२-७८-३२", "content_sanskrit": "भवत्यधर्मो धर्मो हि धर्मोऽधर्मो भवत्युत।\nकारणाद्देशकालस्य देशः कालः स तादृशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2074514, "chapter_id": 2573, "verse_number": "१२-७८-३३", "content_sanskrit": "मैत्राः क्रूराणि कुर्वन्तो जयन्ति स्वर्गमुत्तमम्।\nधर्म्याः पापानि कुर्वाणा गच्छन्ति परमां गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2074515, "chapter_id": 2573, "verse_number": "१२-७८-३४", "content_sanskrit": "ब्राह्मणस्त्रिषु कालेषु शस्त्रं गृह्णन्न दुष्यति।\nआत्मत्राणे दस्युदोषे सर्वस्वहरणे तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2074516, "chapter_id": 2573, "verse_number": "१२-७८-३५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2074517, "chapter_id": 2573, "verse_number": "१२-७८-३५", "content_sanskrit": "अभ्युत्थिते दस्युबले क्षत्रार्थे वर्णसङ्करे।\nसंप्रमूढेषु वर्णेषु यदन्योऽभिभवेद्वली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2074518, "chapter_id": 2573, "verse_number": "१२-७८-३६", "content_sanskrit": "ब्राह्मणो यदि वा वैश्यः शूद्रो वा राजसत्तम।\nदस्युभ्यो यः प्रजा रक्षेद्दण्डं धर्मेण धारयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2074519, "chapter_id": 2573, "verse_number": "१२-७८-३७x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2074520, "chapter_id": 2573, "verse_number": "१२-७८-३७", "content_sanskrit": "कार्यं कुर्यान्न वा कुर्यात्स वार्यो वा भवेन्न वा।\nन स्म शस्त्रं गृहीतव्यमन्यत्र क्षत्रबन्धुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2074521, "chapter_id": 2573, "verse_number": "१२-७८-३८", "content_sanskrit": "अपारे यो भवेत्पारमप्लवेः यः प्लवो भवेत्।\nशूद्रो वा यदि वाऽप्यन्यः सर्वथा मानमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2074522, "chapter_id": 2573, "verse_number": "१२-७८-३९", "content_sanskrit": "यमाश्रित्य नरा राजन्वर्तयेयुर्यथासुखम्।\nअनाथास्तप्यमानाश्च दस्युभिः परिपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2074523, "chapter_id": 2573, "verse_number": "१२-७८-४०", "content_sanskrit": "तमेव पूजयेयुस्ते प्रीत्या स्वमिव बान्धवम्।\nयहद्ध्यभीष्टं कौरव्य कर्ता सन्मानमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2074524, "chapter_id": 2573, "verse_number": "१२-७८-४१", "content_sanskrit": "किमनडुहा यो न वहेत्किं धेन्वा वाऽप्यदुग्धया।\nबन्ध्यया भार्यया कोऽर्थः कोऽर्थो राज्ञाऽप्यरक्षता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2074525, "chapter_id": 2573, "verse_number": "१२-७८-४२", "content_sanskrit": "यथा दारुमयो हस्ती यथा चर्ममयो मृगः।\nयथा ह्यदक्षः पुरुषः पथि क्षेत्रं यथोपरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2074526, "chapter_id": 2573, "verse_number": "१२-७८-४३", "content_sanskrit": "यथा विप्रोऽनधीयानो राजा यश्च न रक्षिता।\nमेघो न वर्षते यश्च सर्व एव निरर्थकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2074527, "chapter_id": 2573, "verse_number": "१२-७८-४४", "content_sanskrit": "नित्यं यस्तु सतो रक्षेदसतश्च निवर्तयेत्।\nस एव राजा कर्तव्यस्तेन सर्वमिदं धृतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2074528, "chapter_id": 2573, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि अष्टसप्ततितमोऽध्यायः॥ ७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]