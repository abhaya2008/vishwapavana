[{"id": 7001009000, "chapter_id": 21009, "verse_number": "४-१५-१", "content_sanskrit": "मैत्रेय उवाच\nहिरण्यकशिपुत्वे च रावणत्वे च विष्णुना ।\nअवाप निहतो भोगानप्राप्यानमरैरपि  ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001009001, "chapter_id": 21009, "verse_number": "४-१५-२", "content_sanskrit": "न लयं तत्र तेनैव निहतः स कथं पुनः ।\nसंप्राप्तः शिशुपालत्वे सायुज्यं शाश्वते हरौ  ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001009002, "chapter_id": 21009, "verse_number": "४-१५-३", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं सर्वधर्मभृत्तां वर ।\nकौतूहलपरेणैतत्पृष्टो मे वक्तुमर्हसि  ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001009003, "chapter_id": 21009, "verse_number": "४-१५-४", "content_sanskrit": "श्रीपराशर उवाच\nदैत्येश्वरस्य वधायाशिललोकोत्पत्तिस्थितिविनाशकारिणा पूर्वं तनुग्रहणं कुर्वता नृसिंह रूपमाविष्कृतम्  ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001009004, "chapter_id": 21009, "verse_number": "४-१५-५", "content_sanskrit": "तत्र च हिरण्यकशिपोर्विष्णुरयमित्येतन्न मनस्यभूत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001009005, "chapter_id": 21009, "verse_number": "४-१५-६", "content_sanskrit": "निरतिशयपुण्यसमुद्भूतमेतत्सत्त्वाजातमिति  ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001009006, "chapter_id": 21009, "verse_number": "४-१५-७", "content_sanskrit": "रजोद्रेकप्रेरितैकाग्रमतिस्तद्भावनायोगात्ततोवाप्तवधहैतुकीं निरतिशयामेवाखिलत्रैलोक्यकारीणीं दशाननत्वे भोगसंपदमवाप  ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001009007, "chapter_id": 21009, "verse_number": "४-१५-८", "content_sanskrit": "न तु स तस्मिन्ननादिनिधने परब्रह्मभूते भगवत्यनालंबिनि कृते मनसस्तल्लयमवाप  ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001009008, "chapter_id": 21009, "verse_number": "४-१५-९", "content_sanskrit": "एवं दशाननत्वेप्यनङ्गपराधीनतया जानकीसमासक्तचेतसा भगवता दाशरथि रूपधारिणा हतस्य तद्रूपदर्शनमेवासीत्नायमच्युत इत्यासक्तिर्विपद्यतोन्तःकरणे मानुषबुद्धिरेव केवलमस्याभूत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001009009, "chapter_id": 21009, "verse_number": "४-१५-१०", "content_sanskrit": "पुनरप्यच्युतविनिपातमात्रफलमखिलभूमण्डलश्लाघ्यचेदिराजकुले जन्म अव्याहतैश्वर्यं शिशुपालत्वेप्यवाप  ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001009010, "chapter_id": 21009, "verse_number": "४-१५-११", "content_sanskrit": "तत्र त्वखिलानामेव स भगवन्नाम्नां त्वङ्कारकारणमभवत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001009011, "chapter_id": 21009, "verse_number": "४-१५-१२", "content_sanskrit": "ततश्च तत्कालकृतानां तेषामशेषणामेवाच्युतनाम्नामनवरतमनेकजन्मसु वर्धितविद्वेषानुबन्धिचित्तो विनिन्दनसंतर्जनादिषूच्चारणमकरोत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001009012, "chapter_id": 21009, "verse_number": "४-१५-१३", "content_sanskrit": "तच्च रूपमुत्फुल्लपद्मदलामलाक्षिमत्युज्ज्वलपीतवस्त्रधार्यमलकिरिटकेयूरहारकटकादिशोभितमुदारचतुर्बाहुशङ्खचक्रगदाधरमतिप्ररूढवैरानुभावादटनभोजनस्नानासनशयनादिष्वशेषावस्थान्तरेषु नान्यत्रोपययावस्य चेतसः  ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001009013, "chapter_id": 21009, "verse_number": "४-१५-१४", "content_sanskrit": "ततस्तमेवाक्रोशेषूच्चारयंस्तमेव हृदयेन धारयन्नात्मवधाय यावद्भगवद्धस्तचक्रांशुमालोज्ज्वालमक्षयतेजःस्वरूपं ब्रह्मभूतमपगतद्वेषादिदोषं भगवन्तमद्राक्षीत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001009014, "chapter_id": 21009, "verse_number": "४-१५-१५", "content_sanskrit": "तावच्च भगवच्चक्रेणाशु व्यापादितस्तत्स्मरणदग्धाखिलाघसंचयो भगवतान्तमुपनीतस्ततस्मिन्नेव लयमुपययौ  ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001009015, "chapter_id": 21009, "verse_number": "४-१५-१६", "content_sanskrit": "एतत्तवाखिलंमयाभिहितम्  ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001009016, "chapter_id": 21009, "verse_number": "४-१५-१७", "content_sanskrit": "अयं हि भगवान् कीर्तितश्च संस्मृतश्च द्वेषानुबन्धेनापि अखिलमुरासुरादिर्दुल्लभं फलं प्रयच्छति किमुत सम्यग्भक्तिमत्मिति  ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001009017, "chapter_id": 21009, "verse_number": "४-१५-१८", "content_sanskrit": "वसुदेवस्य त्वानकदुन्दुभेः पौरवीरोहिणीमदिराभद्रादेवकीप्रमुखा बह्व्यः पत्न्योऽभवन्  ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001009018, "chapter_id": 21009, "verse_number": "४-१५-१९", "content_sanskrit": "बलभद्रशठसारणदुर्मदादीन्पुत्रार्त्नोहिण्यानकदुन्दुभिरुत्पादयामास  ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001009019, "chapter_id": 21009, "verse_number": "४-१५-२०", "content_sanskrit": "बलदेवोपि रेवत्यां विशठोल्मुकौ पुत्रावजनयत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001009020, "chapter_id": 21009, "verse_number": "४-१५-२१", "content_sanskrit": "सार्ष्टिमार्ष्टिशिशुसत्यसत्यधृतिप्रमुखाः सारणात्मजाः  ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001009021, "chapter_id": 21009, "verse_number": "४-१५-२२", "content_sanskrit": "भद्राश्वभद्रबाहुदुर्दमभूताद्याः रोहिण्याः कुलजाः  ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001009022, "chapter_id": 21009, "verse_number": "४-१५-२३", "content_sanskrit": "नन्दोपनन्दकृतकाद्य मदिरायास्तनयाः  ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001009023, "chapter_id": 21009, "verse_number": "४-१५-२४", "content_sanskrit": "भद्रायाश्चोपनिधिगदाद्याः  ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001009024, "chapter_id": 21009, "verse_number": "४-१५-२५", "content_sanskrit": "वैशाल्यां च कौशिकमेकमेवाजनयत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001009025, "chapter_id": 21009, "verse_number": "४-१५-२६", "content_sanskrit": "आनकदुन्दुभेर्देवक्यामपि कीर्तिमत्सुषेणोदायुभद्रसेनऋजुदासभद्रदेवाख्याः षट्पुत्रा जज्ञिरे  ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001009026, "chapter_id": 21009, "verse_number": "४-१५-२७", "content_sanskrit": "तांश्च सर्वानेव कंसोघातितवान्  ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001009027, "chapter_id": 21009, "verse_number": "४-१५-२८", "content_sanskrit": "अनन्तरं च सप्तमं गर्भमर्धरात्रे भगवत्प्रहितायोगनिद्रा रोहिण्या जठरमाकृष्य नीतवती  ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001009028, "chapter_id": 21009, "verse_number": "४-१५-२९", "content_sanskrit": "कर्षणाच्चासावपि संकर्षणाख्यामगमत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001009029, "chapter_id": 21009, "verse_number": "४-१५-३०", "content_sanskrit": "ततश्च सकलजगन्महातरुमूलभूतोभूतभविष्यदादिसकलमुरासुरमुनिजनमनसामप्यगोचरोऽब्जभवप्रमुखैरनलमुखैः प्रणम्यावनिभारहरणाय प्रसादितो भगवाननादिमध्यनिधनोदेवकीगर्भमवततार वासुदेवः  ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001009030, "chapter_id": 21009, "verse_number": "४-१५-३१", "content_sanskrit": "तत्प्रसादविवद्धमानोरुमहिमा च योगनिद्रा नन्दगोपपत्न्या यशोदाया गर्भमधितिष्ठितवती  ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001009031, "chapter_id": 21009, "verse_number": "४-१५-३२", "content_sanskrit": "सुप्रसन्नादित्यचन्द्रादिग्रहमव्यालादिभयं स्वस्थमानसमखिलमेवैतज्जगदपास्ताधर्ममभवत्त्स्मिश्च पुण्डरीकनयने जायमाने  ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001009032, "chapter_id": 21009, "verse_number": "४-१५-३३", "content_sanskrit": "जातेन च तेनाखिलमेवैतत्सन्मार्गवर्ति जगदक्रियत  ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001009033, "chapter_id": 21009, "verse_number": "४-१५-३४", "content_sanskrit": "भगवतोप्यत्र मर्त्यलोकेऽवतीर्णस्य षोडशसहस्राण्येकोत्तरशताधिकानि भार्याणाम भवन्  ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001009034, "chapter_id": 21009, "verse_number": "४-१५-३५", "content_sanskrit": "तासां च रुक्मिणी सत्यभामा जांबवती चारुहासिनीप्रमुखा ह्यष्टौ पत्न्यः प्रधाना बभूचवुः  ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001009035, "chapter_id": 21009, "verse_number": "४-१५-३६", "content_sanskrit": "तासु चाष्टावयुतानिलक्षं च पुत्राणां भगवानखिलमूर्तिरनादिमानजनयत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001009036, "chapter_id": 21009, "verse_number": "४-१५-३७", "content_sanskrit": "तेषां च प्रद्युम्नचारुदेष्ण्यसांबादयः त्रयोदश प्रधानाः  ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001009037, "chapter_id": 21009, "verse_number": "४-१५-३८", "content_sanskrit": "प्रद्युम्नोपि रुक्मिणस्तनयां रुक्मवतीं नामोपयेमे  ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001009038, "chapter_id": 21009, "verse_number": "४-१५-३९", "content_sanskrit": "तस्यामनिरुद्धो जज्ञे  ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001009039, "chapter_id": 21009, "verse_number": "४-१५-४०", "content_sanskrit": "अनिरुद्धोऽपि रुक्मिणा एव पौत्रीं सुभद्रां नामो पयेमे  ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001009040, "chapter_id": 21009, "verse_number": "४-१५-४१", "content_sanskrit": "तस्यामस्य वज्रो जज्ञे  ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001009041, "chapter_id": 21009, "verse_number": "४-१५-४२", "content_sanskrit": "वज्रस्य प्रतिबाहुः तस्यापि सुचारुः  ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001009042, "chapter_id": 21009, "verse_number": "४-१५-४३", "content_sanskrit": "एवमनेकशतसहस्६ उषसंख्यस्य यदुकुलस्य पुत्रसंख्या वर्षशतैरपि वक्तुं न शक्यते  ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001009043, "chapter_id": 21009, "verse_number": "४-१५-४४", "content_sanskrit": "यतो हि श्लोकाविमावत्र चरितार्थौ  ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001009044, "chapter_id": 21009, "verse_number": "४-१५-४५", "content_sanskrit": "तिस्त्रः कोट्यःसहस्राणामष्टाशीति शतानि च ।\nकुमाराणां कृहाचार्याश्चापयोगेषु ये रताः  ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001009045, "chapter_id": 21009, "verse_number": "४-१५-४६", "content_sanskrit": "संख्यानं यादवानां कः करिष्यति महात्मनाम् ।\nयत्रायुतानामयुतलक्षेणास्ते सदाहुकः  ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001009046, "chapter_id": 21009, "verse_number": "४-१५-४७", "content_sanskrit": "देवासुरे हता ये तु दैतेयाःसुमहाबलाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001009047, "chapter_id": 21009, "verse_number": "४-१५-४८", "content_sanskrit": "उत्पन्नास्ते मनुष्येषु प्रमाणे च प्रभुत्वे च व्यवस्थितः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001009048, "chapter_id": 21009, "verse_number": "४-१५-४९", "content_sanskrit": "निदेशस्थायिनस्तस्य ववृधुःसर्वयादवाः  ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001009049, "chapter_id": 21009, "verse_number": "४-१५-५०", "content_sanskrit": "इति प्रसूतिं वृष्णीनां यश्र्शृणोति नरः सदा ।\nस सर्वैः पातकैर्मुक्तो विष्णुलोकं प्रपद्यते  ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]