[{"id": 2209756, "chapter_id": 5485, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209757, "chapter_id": 5485, "verse_number": "१", "content_sanskrit": "क्रमेण स हयस्त्वेवं विचरन् भरतर्षभ ।\nमणलूरुपतेर्देशमुपायात् सहपाण्डवः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209758, "chapter_id": 5485, "verse_number": "२", "content_sanskrit": "श्रुत्वा तु नृपतिर्वीरं पितरं बभ्रुवाहनः ।\nनिर्ययौ विनयेनार्यो ब्राह्मणार्घ्यपुरस्सरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209759, "chapter_id": 5485, "verse_number": "३", "content_sanskrit": "मणलूरेश्वरं त्वेवमुपयातं धनञ्जयः ।\nनाभ्यनन्दत मेधावी क्षात्रधर्ममनुस्मरन् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209760, "chapter_id": 5485, "verse_number": "४", "content_sanskrit": "उवाच चैनं धर्मात्मा समन्युः फल्गुनस्तदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209761, "chapter_id": 5485, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209762, "chapter_id": 5485, "verse_number": "५", "content_sanskrit": "प्रक्रियेयं न ते युक्ता बहिस्त्वं क्षत्रधर्मतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209763, "chapter_id": 5485, "verse_number": "६", "content_sanskrit": "संरक्ष्यमाणं तुरगं यौधिष्ठिरमुपागतम् ।\nयाज्ञियं विषयं त्वं मां नायोत्सीः किं नु पुत्रक ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209764, "chapter_id": 5485, "verse_number": "७", "content_sanskrit": "धिक् धिक् त्वां तु सुदुर्बुद्धिं क्षत्रधर्माऽविशारदम् ।\nयो मां युधि सुसम्प्राप्तं साम्नैवाथो त्वमग्रहीः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209765, "chapter_id": 5485, "verse_number": "८", "content_sanskrit": "न त्वया पुरुषार्थश्च कश्चिदस्तीह जीवता ।\nयस्त्वं स्त्रीवद् युधा प्राप्तं साम्ना मां प्रतिगृह्णथाः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209766, "chapter_id": 5485, "verse_number": "९", "content_sanskrit": "यद्यहं न्यस्तशस्त्रं त्वामागच्छेयं सुदुर्मते ।\nप्रक्रियेयं ततो युक्ता भवेत् तव नराधम ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209767, "chapter_id": 5485, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209768, "chapter_id": 5485, "verse_number": "१०", "content_sanskrit": "तमेवमुक्तं भर्त्रा च विदित्वा पन्नगात्मजा ।\nअमृष्यमाणा भित्त्वोर्वीमुलूपी तमुपागमत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209769, "chapter_id": 5485, "verse_number": "११", "content_sanskrit": "सा ददर्श ततः पुत्रं विमृशन्तमधोमुखम् ।\nसन्तर्ज्यमानमसकृद् भर्त्रा युद्धार्थिना विभो ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209770, "chapter_id": 5485, "verse_number": "१२", "content_sanskrit": "ततः सा चारुसर्वाङ्गी तमुपेत्योरगात्मजा ।\nउलूपी प्राह वचनं क्षत्रधर्माविशारदम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209771, "chapter_id": 5485, "verse_number": "", "content_sanskrit": "उलूपी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209772, "chapter_id": 5485, "verse_number": "१३", "content_sanskrit": "उलूपीं मां निबोध त्वं मातरं पन्नगात्मजाम् ।\nकुरुष्व वचनं पुत्र धर्मस्ते भविता महान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209773, "chapter_id": 5485, "verse_number": "१४", "content_sanskrit": "युद्ध्यस्वैनं कुरुश्रेष्ठं धनञ्जयमरिन्दमम् ।\nएवमेष पिता प्रीतो भविष्यति न संशयः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209774, "chapter_id": 5485, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209775, "chapter_id": 5485, "verse_number": "१५", "content_sanskrit": "एवमुद्धर्षितो मात्रा स राजा बभ्रुवाहनः ।\nमनश्चक्रे महातेजा युद्धाय भरतर्षभ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209776, "chapter_id": 5485, "verse_number": "१६", "content_sanskrit": "सन्नह्य काञ्चनं वर्म शिरस्त्राणं च भानुमत् ।\nतूणीरशरसम्बाधमारुरोह महारथम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209777, "chapter_id": 5485, "verse_number": "१७", "content_sanskrit": "सर्वोपकरणैर्युक्तं युक्तमश्वैर्मनोजवैः ।\nसुचक्रोपस्करं धीमान् हेमभाण्डपरिष्कृतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209778, "chapter_id": 5485, "verse_number": "१८", "content_sanskrit": "परमार्चितमुच्छ्रित्य ध्वजं हंसं हिरण्मयम् ।\nप्रययौ पार्थमुद्दिश्य स राजा बभ्रुवाहनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209779, "chapter_id": 5485, "verse_number": "१९", "content_sanskrit": "ततोऽभ्येत्य हयं वीरो याज्ञियं पार्थरक्षितम् ।\nग्राहयामास पुरुषैर्हयशिक्षाविशारदैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209780, "chapter_id": 5485, "verse_number": "२०", "content_sanskrit": "गृहीतं वाजिनं दृष्ट्वा प्रीतात्मा स धनञ्जयः ।\nपुत्रं रथस्थं भूमिष्ठः सन्न्यवारयदाहवे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209781, "chapter_id": 5485, "verse_number": "२१", "content_sanskrit": "ततः स राजा तं वीरः शरव्रातैः सहस्रशः ।\nअर्दयामास निशितैराशीविषविषोपमैः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209782, "chapter_id": 5485, "verse_number": "२२", "content_sanskrit": "तयोः समभवद् युद्धं पितुः पुत्रस्य चातुलम् ।\nदेवासुररणप्रख्यम् उभयोः प्रीयमाणयोः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209783, "chapter_id": 5485, "verse_number": "२३", "content_sanskrit": "किरीटिनं तु विव्याध शरेणानतपर्वणा ।\nजत्रुदेशे नरव्याघ्र प्रहसन् बभ्रुवाहनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209784, "chapter_id": 5485, "verse_number": "२४", "content_sanskrit": "सोऽत्यगात् सह पुङ्खेन वल्मीकमिव पन्नगः ।\nविनिर्भिद्य च कौन्तेयं महीतलमुपाविशत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209785, "chapter_id": 5485, "verse_number": "२५", "content_sanskrit": "स गाढवेदनो धीमान् आलम्ब्य धनुरुत्तमम् ।\nदिव्यं तेजः समाविश्य निमीलित इवाबभौ ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209786, "chapter_id": 5485, "verse_number": "२६", "content_sanskrit": "स सञ्ज्ञामुपलभ्याथ प्रशस्य पुरुषर्षभः ।\nपुत्रं शक्रात्मजो वाक्यमिदमाह महीपते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209787, "chapter_id": 5485, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2209788, "chapter_id": 5485, "verse_number": "२७", "content_sanskrit": "साधु साधु महाबाहो वत्स चित्राङ्गदात्मज ।\nसदृशं कर्म ते दृष्ट्वा प्रीतिमानस्मि पुत्रक ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2209789, "chapter_id": 5485, "verse_number": "२८", "content_sanskrit": "विमुञ्चाम्यद्य बाणांश्च युद्धे धीरो भवाद्य वै ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2209790, "chapter_id": 5485, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2209791, "chapter_id": 5485, "verse_number": "२९", "content_sanskrit": "इत्येवमुक्त्वा नाराचैरभ्यवर्षदमित्रहा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2209792, "chapter_id": 5485, "verse_number": "३०", "content_sanskrit": "तांस्तान् गाण्डीवनिर्मुक्तान् वज्राशनिसमस्वनान् ।\nनाराचानच्छिनद् राजा सर्वानेव त्रिधा त्रिधा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2209793, "chapter_id": 5485, "verse_number": "३१", "content_sanskrit": "तस्य पार्थः शरैस्तीक्ष्णैर्ध्वजं हेमपरिष्कृतम् ।\nसुवर्णतालप्रतिमं क्षणेनापाहरद् रथात् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2209794, "chapter_id": 5485, "verse_number": "३२", "content_sanskrit": "हयांश्चास्य महाकायान् महावेगपराक्रमान् ।\nचकार राजन् निर्जीवान् प्रहसन् पाण्डवर्षभः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2209795, "chapter_id": 5485, "verse_number": "३३", "content_sanskrit": "स रथादवतीर्याशु राजा परमकोपनः ।\nपदातिः पितरं कोपाद् योधयामास पाण्डवम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2209796, "chapter_id": 5485, "verse_number": "३४", "content_sanskrit": "सम्प्रीयमाणः पाण्डूनामृषभः पुत्रविक्रमात् ।\nनात्यर्थं पीडयामास पुत्रं वज्रधरात्मजः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2209797, "chapter_id": 5485, "verse_number": "३५", "content_sanskrit": "स हन्यमानोऽभिमुखं पितरं बभ्रुवाहनः ।\nशरैराशीविषाकारैः पुनरेवार्दयद् बली ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2209798, "chapter_id": 5485, "verse_number": "३६", "content_sanskrit": "ततः स बाल्यात् पितरं विव्याध हृदि पत्रिणा ।\nनिशितेन सुपुङ्खेन बलवद् बभ्रुवाहनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2209799, "chapter_id": 5485, "verse_number": "३७", "content_sanskrit": "स शरस्तेजसा दीप्तो ज्वलन्निव हुताशनः ।\nविवेश पाण्डवं राजन् मर्म भित्त्वाऽतिदुःखकृत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2209800, "chapter_id": 5485, "verse_number": "३८", "content_sanskrit": "स तेनातिभृशं विद्धः पुत्रेण कुरुनन्दनः ।\nमहीं जगाम मोहार्तस्ततो राजन् धनञ्जयः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2209801, "chapter_id": 5485, "verse_number": "३९", "content_sanskrit": "तस्मिन् निपतिते वीरे कौरवाणां धुरन्धरे ।\nसोऽपि मोहं जगामाशु तत्र चित्राङ्गदात्मजः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2209802, "chapter_id": 5485, "verse_number": "४०", "content_sanskrit": "व्यायम्य संयुगे राजा दृष्ट्वा च पितरं हतम् ।\nपूर्वमेव च बाणौघैर्गाढविद्धोऽर्जुनेन सः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2209803, "chapter_id": 5485, "verse_number": "४१", "content_sanskrit": "भर्तारं निहतं श्रुत्वा पुत्रं च पतितं भुवि ।\nचित्राङ्गदा परित्रस्ता प्रविवेश रणाजिरम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2209804, "chapter_id": 5485, "verse_number": "४२", "content_sanskrit": "शोकसन्तप्तहृदया रुदती सा ततः शुभा ।\nमणलूरपतेर्माता ददर्श निहतं पतिम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2209805, "chapter_id": 5485, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि बभ्रुवाहनेन अर्जुन.... नाम एकोनाशीतितमोऽध्यायः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]