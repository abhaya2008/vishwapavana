[{"id": 2174927, "chapter_id": 4711, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2174928, "chapter_id": 4711, "verse_number": "१", "content_sanskrit": "ततो विनशनं राजन् आजगाम हलायुधः ।\nशूद्राभीरान् प्रति द्वेषाद् यत्र नष्टा सरस्वती\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2174929, "chapter_id": 4711, "verse_number": "२", "content_sanskrit": "यस्मात् सा भरतश्रेष्ठ शूद्रद्वेष्या सरस्वती ।\nतस्मात् तामृषयो नित्यमाहुर्विनशनेति ह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2174930, "chapter_id": 4711, "verse_number": "३", "content_sanskrit": "तच्चाप्यतिक्रम्य बलवान् सरस्वत्यां महातपाः ।\nअभूमिकं ततोऽगच्छत् सरस्वत्यास्तटं परम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2174931, "chapter_id": 4711, "verse_number": "४", "content_sanskrit": "यत्र चाप्सरसः शुभ्राः सर्वकालमतन्द्रिताः ।\nक्रीडाभिर्विपुलाभिश्च क्रीडन्ति विमलाननाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2174932, "chapter_id": 4711, "verse_number": "५", "content_sanskrit": "तत्र देवाः सगन्धर्वा मासि मासि जनेश्वर ।\nअभिगच्छन्ति तत्तीर्थं पुण्यं ब्राह्मणसेवितम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2174933, "chapter_id": 4711, "verse_number": "६", "content_sanskrit": "तत्र नृत्यन्ति गन्धर्वाः तथैवाप्सरसां गणाः ।\nसमेताः सहिता राजन् यथाप्राप्तं यथासुखम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2174934, "chapter_id": 4711, "verse_number": "७", "content_sanskrit": "तत्र मोदन्ति देवाश्च पितरश्च सवीरुधः ।\nपुण्यैः पुष्पैः सदा दिव्यैः कीर्यमाणैः पुनः पुनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2174935, "chapter_id": 4711, "verse_number": "८", "content_sanskrit": "आक्रीडभूमिः सा राजन् तासामप्सरसां शुभा ।\nसुभूमिकेति विख्याता सरस्वत्यास्तटे वने\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2174936, "chapter_id": 4711, "verse_number": "९", "content_sanskrit": "तत्र स्नात्वा च दत्त्वा च वसु विप्रेषु माधवः ।\nश्रुत्वा गीतं च तद् दिव्यं वादित्राणां च निस्वनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2174937, "chapter_id": 4711, "verse_number": "१०", "content_sanskrit": "छायां च विपुलां दृष्ट्वा देवगन्धर्वरक्षसाम् ।\nगन्धर्वाणां ततस्तीर्थमगमद् रोहिणीसुतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2174938, "chapter_id": 4711, "verse_number": "११", "content_sanskrit": "विश्वावसुमुखास्तत्र गन्धर्वास्तपसाऽन्विताः ।\nनृत्तवादित्रगीतं च प्राप्तवन्तो मनोरमम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2174939, "chapter_id": 4711, "verse_number": "१२", "content_sanskrit": "तत्र दत्वा हलधरो विप्रेभ्यो विविधं वसु ।\nअजाविकं खरोष्ट्रं च सुवर्णं रजतं तथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2174940, "chapter_id": 4711, "verse_number": "१३", "content_sanskrit": "भोजयित्वा द्विजान् कामैः सन्तर्प्य च महाधनैः ।\nप्रययौ सहितो विप्रैः स्तूयमानश्च माधवः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2174941, "chapter_id": 4711, "verse_number": "१४", "content_sanskrit": "तस्माद् गन्धर्वतीर्थाच्च महाबाहुररिन्दमः ।\nगर्ग्यस्रोतो महत्तीर्थमाजगामैककुण्डलः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2174942, "chapter_id": 4711, "verse_number": "१५", "content_sanskrit": "तत्र गर्गेण वृद्धेन तपसा भावितात्मना ।\nकालज्ञानगतिश्चैव ज्योतिषां गतिरेव च\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2174943, "chapter_id": 4711, "verse_number": "१६", "content_sanskrit": "उत्पाता दारुणाश्चैव शुभाश्च जनमेजय ।\nसरस्वत्याः शुभे तीर्थे विहिताश्च महात्मना\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2174944, "chapter_id": 4711, "verse_number": "१७", "content_sanskrit": "तस्य नाम्ना च तत्तीर्थं गर्गस्रोत इति स्मृतम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2174945, "chapter_id": 4711, "verse_number": "१८", "content_sanskrit": "तत्र गर्गं महात्मानमृषयः सुव्रता नृप ।\nउपासाञ्चक्रिरे नित्यं कालज्ञानं प्रति प्रभौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2174946, "chapter_id": 4711, "verse_number": "१९", "content_sanskrit": "तत्र गत्वा महाराज बलः श्वेतानुलेपनः ।\nविधिवद्धि धनं प्रादान्मुनीनां भावितात्मनाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2174947, "chapter_id": 4711, "verse_number": "२०", "content_sanskrit": "उच्चावचांस्तथा देयान् द्विजेभ्योऽभिप्रदाय च ।\nनीलावासास्ततोऽगच्छत् शङ्खतीर्थं महायशाः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2174948, "chapter_id": 4711, "verse_number": "२१", "content_sanskrit": "तत्रापश्यन्महाशङ्खं महापद्ममिवोत्थितम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2174949, "chapter_id": 4711, "verse_number": "२२", "content_sanskrit": "श्वेतपर्वतसङ्काशमृषिसङ्घैर्निषेवितम् ।\nसरस्वत्यास्तटे जातं नगं तालध्वजो बली\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2174950, "chapter_id": 4711, "verse_number": "२३", "content_sanskrit": "यक्षविद्याधराश्चैव राक्षसाश्च सहस्रशः ।\nपिशाचाश्चामितबलास्तत्र सिद्धाः सहस्रशः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2174951, "chapter_id": 4711, "verse_number": "२४", "content_sanskrit": "ते सर्वे ह्यशनं कृत्वा फलैस्तस्य वनस्पतेः ।\nव्रतैश्च नियमैश्चैव काले काले स्म भुञ्जते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2174952, "chapter_id": 4711, "verse_number": "२५", "content_sanskrit": "अदृश्यमाना मनुजैर्व्यचरन् भरतर्षभ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2174953, "chapter_id": 4711, "verse_number": "२६", "content_sanskrit": "एवं ख्यातो नरपते लोकेऽस्मिन् स वनस्पतिः ।\nतत्र तीर्थं सरस्वत्याः पावनं लोकविश्रुतम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2174954, "chapter_id": 4711, "verse_number": "२७", "content_sanskrit": "तस्मिंश्च यदुशार्दूलो दत्वा तीर्थे यशस्विनाम् ।\nताम्रायसानि भाण्डानि वस्त्राण्याभरणानि च\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2174955, "chapter_id": 4711, "verse_number": "२८", "content_sanskrit": "पूजयित्वा द्विजांश्चैव पूजितश्च द्विजोत्तमैः ।\nपुण्यं राजन्नाजगाम मुनितीर्थं महाबलः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2174956, "chapter_id": 4711, "verse_number": "२९", "content_sanskrit": "तत्र गत्वा मुनीन् दृष्ट्वा नानावेषधरान् बहून् ।\nआप्लुत्य सलिले चापि पूजयामास वै द्विजान्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2174957, "chapter_id": 4711, "verse_number": "३०", "content_sanskrit": "तथैव दत्त्वा विप्रेभ्यः परिभोगान् सुपुष्कलान् ।\nततः प्रायाद् बलो राजन् दक्षिणेन सरस्वतीम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2174958, "chapter_id": 4711, "verse_number": "३१", "content_sanskrit": "गत्वा चैनां महाबाहुर्नातिदूरे महायशाः ।\nधर्मात्मा नागधन्वानं तीर्थं चागमदच्युतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2174959, "chapter_id": 4711, "verse_number": "३२", "content_sanskrit": "तत्तु पन्नगराजस्य वासुकेस्तन्निवेशनम् ।\nमहाद्युतेर्महाराज बहुभिः पन्नगैर्वृतम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2174960, "chapter_id": 4711, "verse_number": "३३", "content_sanskrit": "यत्रासन् ऋषयः सिद्धाः सहस्राणि चतुर्दश\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2174961, "chapter_id": 4711, "verse_number": "३४", "content_sanskrit": "यत्र देवाः समासाद्य वासुकिं पन्नगोत्तमम् ।\nसर्वपन्नगराजानमभ्यषिञ्चन् यथाविधि\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2174962, "chapter_id": 4711, "verse_number": "३५", "content_sanskrit": "पन्नगेभ्यो भयं तत्र न च विद्येत भारत\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2174963, "chapter_id": 4711, "verse_number": "३६", "content_sanskrit": "तत्रापि विधिवद् दत्त्वा विप्राणां वित्तसञ्चयान् ।\nययौ प्राचीं दिशं राजन् दीप्यमानः स वीर्यवान्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2174964, "chapter_id": 4711, "verse_number": "३७", "content_sanskrit": "आप्लुत्य बहुशो हृष्टस्तेषु तीर्थेषु लाङ्गली ।\nदत्त्वा वसु द्विजाग्र्येभ्यो निर्जगाम महाबलः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2174965, "chapter_id": 4711, "verse_number": "३८", "content_sanskrit": "तत्रस्थान् ऋषिसङ्घांस्तानभिवाद्य हलायुधः ।\nततो रामोऽगमत् तीर्थं ऋषिभिः सेवितं महत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2174966, "chapter_id": 4711, "verse_number": "३९", "content_sanskrit": "यत्र भूयो निववृते प्राङ्मुखा वै सरस्वती ।\nऋषीणां नैमिशीयानामपेक्षार्थं महात्मनाम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2174967, "chapter_id": 4711, "verse_number": "४०", "content_sanskrit": "निवृत्तां तां सरिच्छ्रेष्ठां तत्र गत्वा तु लाङ्गली ।\nबभूव विस्मितो राजन् बलः श्वेतानुलेपनः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2174968, "chapter_id": 4711, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2174969, "chapter_id": 4711, "verse_number": "४१", "content_sanskrit": "कस्मात् सरस्वती ब्रह्मन् निवृत्ता प्राङ्मुखी ततः ।\nआख्यातुमेतदिच्छामि सर्वमध्वर्युसत्तम\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2174970, "chapter_id": 4711, "verse_number": "४२", "content_sanskrit": "कस्मिंश्च कारणे तत्र विस्मितो यदुनन्दनः ।\nनिवृत्ता च सरिच्छ्रेष्ठा कथमेतद् द्विजोत्तम\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2174971, "chapter_id": 4711, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2174972, "chapter_id": 4711, "verse_number": "४३", "content_sanskrit": "पूर्वं कृतयुगे राजन् नैमिशेयास्तपोधनाः ।\nवर्तमाने सुबहुले सत्रे द्वादशवार्षिके\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2174973, "chapter_id": 4711, "verse_number": "४४", "content_sanskrit": "ऋषयो बहवो राजन् तत्र सम्प्रतिपेदिरे ।\nउषित्वा च महाभागास्तत्र तीर्थे यथाविधि\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2174974, "chapter_id": 4711, "verse_number": "४५", "content_sanskrit": "निर्वृत्ते नैमिशेये वै सत्रे द्वादशवार्षिके ।\nआजग्मुः ऋषयस्तत्र बहवस्तीर्थकारणात्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2174975, "chapter_id": 4711, "verse_number": "४६", "content_sanskrit": "ऋषीणां बहुलत्त्वात् तु सरस्वत्या विशाम्पते ।\nतीर्थानि नगरायन्ते कूले वै दक्षिणोत्तरे\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2174976, "chapter_id": 4711, "verse_number": "४७", "content_sanskrit": "समन्तपञ्चकं यावत् तावत्ते द्विजसत्तमाः ।\nतीर्थलोभान्नरव्याघ्र नद्यास्तीरं समाश्रिताः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2174977, "chapter_id": 4711, "verse_number": "४८", "content_sanskrit": "जुह्वतां तत्र तेषां तु मुनीनां भावितात्मनाम् ।\nस्वाध्यायेनापि महता बभूवुः परितो दिशः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2174978, "chapter_id": 4711, "verse_number": "४९", "content_sanskrit": "अग्निहोत्रैस्ततस्तेषां हूयमानैर्महात्मनाम् ।\nअशोभत सरिच्छ्रेष्ठा दीप्यमानैः समन्ततः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2174979, "chapter_id": 4711, "verse_number": "५०", "content_sanskrit": "वालखिल्या महाराज अश्मकुट्टाश्च तापसाः ।\nदन्तोलूखलिनश्चान्ये सम्प्रक्षालास्तथा परे\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2174980, "chapter_id": 4711, "verse_number": "५१", "content_sanskrit": "वायुभक्षाः फलाहाराः पर्णभक्षाश्च तापसाः ।\nनानानियमधर्माश्च तथाऽन्ये स्थण्डिलेशयाः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2174981, "chapter_id": 4711, "verse_number": "५२", "content_sanskrit": "अवसन् मुनयस्तत्र सरस्वत्याः समीपतः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2174982, "chapter_id": 4711, "verse_number": "५३", "content_sanskrit": "व्यशोभयन् सरिच्छ्रेष्ठां गङ्गामिव दिवौकसः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2174983, "chapter_id": 4711, "verse_number": "५४", "content_sanskrit": "ततो यज्ञं समापेतुर्ऋषयः सत्रयाजिनः ।\nतेऽवकाशं च ददृशुः कुरुक्षेत्रे महायशः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2174984, "chapter_id": 4711, "verse_number": "५५", "content_sanskrit": "ततो यज्ञोपवीतैस्तैः तत्तीर्थं निर्विमाय वै ।\nजुहुवुश्चाग्निहोत्राणि चक्रुश्च विविधाः क्रियाः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2174985, "chapter_id": 4711, "verse_number": "५६", "content_sanskrit": "ततस्तमृषिसङ्घातं निराशं चिन्तयाऽन्वितम् ।\nदर्शयामास राजेन्द्र तेषामर्थे सरस्वती\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2174986, "chapter_id": 4711, "verse_number": "५७", "content_sanskrit": "ततः कुञ्जान्(कुड्यान्) बहून् कृत्वा सन्निवृत्ता सरस्वती ।\nऋषीणां पुण्यतपसां माननार्थं महात्मनाम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2174987, "chapter_id": 4711, "verse_number": "५८", "content_sanskrit": "ततो निवृत्ता राजेन्द्र तेषामर्थे सरस्वती ।\nभूयः प्रतीच्यभिमुखी सुस्राव सरितां वरा\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2174988, "chapter_id": 4711, "verse_number": "५९", "content_sanskrit": "अमोघं गमनं कृत्वा तेषां भूयो जगाम ह ।\nअत्यद्भुतं तदा चक्रे तत्र राजन् महानदी\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2174989, "chapter_id": 4711, "verse_number": "६०", "content_sanskrit": "एवं हि कुञ्जो राजेन्द्र नैमिषीय इति श्रुतिः ।\nकुरुश्रेष्ठ कुरुक्षेत्रे कुरुष्व महती क्रियाः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2174990, "chapter_id": 4711, "verse_number": "६१", "content_sanskrit": "तत्र कुञ्जान् बहून् दृष्ट्वा सन्निवृत्तां च तां नदीम् ।\nबभूव विस्मयस्तत्र रामस्याथ महात्मनः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2174991, "chapter_id": 4711, "verse_number": "६२", "content_sanskrit": "उपस्पृश्य च तत्रापि विधिवद् यदुनन्दनः ।\nदत्त्वा देयान् द्विजातिभ्यो भाण्डानि विविधानि च\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2174992, "chapter_id": 4711, "verse_number": "६३", "content_sanskrit": "भक्ष्यं पेयं च विविधं ब्राह्मणान् प्रत्यभोजयत्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2174993, "chapter_id": 4711, "verse_number": "६४", "content_sanskrit": "ततः प्रायाद् बलो राजन् पूज्यमानो द्विजातिभिः ।\nसरस्वत्यास्तीर्थवरं नानाद्विजगणायुतम्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2174994, "chapter_id": 4711, "verse_number": "६५", "content_sanskrit": "बदरेङ्गुदश्यामाकप्लक्षाश्वत्थविभीतकैः ।\nपनसैश्च पलाशैश्च करवीरैश्च पीलुभिः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2174995, "chapter_id": 4711, "verse_number": "६६", "content_sanskrit": "सरस्वतीतीररुहैश्चन्दनैः स्पन्दनैस्तथा ।\nकरूषिकवनैश्चैव बिल्वैरामलकैरपि\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2174996, "chapter_id": 4711, "verse_number": "६७", "content_sanskrit": "अतिमुक्तकषण्डैश्च पारिजातैश्च शोभितम् ।\nकदलीवनभूयिष्ठं दृष्टिकान्तं मनोहरम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2174997, "chapter_id": 4711, "verse_number": "६८", "content_sanskrit": "वाय्वम्बुफलपर्णादैः दन्तोलूखलिकैरपि ।\nतथाऽश्मकुट्टैर्वा तोयैर्मुनिभिर्बहुभिर्वृतम्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2174998, "chapter_id": 4711, "verse_number": "६९", "content_sanskrit": "स्वाध्यायघोषैः सङ्घुष्टं मृतयूथशताकुलम् ।\nअहिंस्रैः धर्मपरमैर्नृभिरत्यन्तसेवितम्\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2174999, "chapter_id": 4711, "verse_number": "७०", "content_sanskrit": "सप्तसारस्वतं तीर्थम् आजगाम हलायुधः ।\nयत्र मङ्कणकः सिद्धस्तपस्तेपे महामुनिः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2175000, "chapter_id": 4711, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां गदापर्वणि बलभद्रस्य तीर्थयात्रावर्णनं नाम नवमोऽध्यायः ॥९॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]