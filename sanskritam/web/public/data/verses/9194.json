[{"id": 40014360, "chapter_id": 9194, "verse_number": "1", "content_sanskrit": "लङ्कायांतुकृतंकर्मघोरंदृष्टवाभयावहम् । राक्षसेन्द्रोहनुमताशक्रेणेवमहात्मना ॥ अब्रवीद्राक्षसान् सर्वान्ह्रियाकिञ्चिदवाङ्मुखः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014361, "chapter_id": 9194, "verse_number": "2", "content_sanskrit": "धर्षिताचप्रविष्टाचलङ्कादुष्प्रसहापुरी ॥ तेनवानरमात्रेणदृष्टासीताचजानकी ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014362, "chapter_id": 9194, "verse_number": "3", "content_sanskrit": "प्रासादोधर्षितश्चैत्यःप्रवराराक्षसाहताः ॥ आविलाचपुरीलङ्कासर्वाहनुमताकृता ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014363, "chapter_id": 9194, "verse_number": "4", "content_sanskrit": "किंकरिष्यामिभद्रंवोकिंवायुक्तमनन्तरम् ॥ उच्यतांनस्समर्थंयत्कृतंचसुकृतंभवेत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014364, "chapter_id": 9194, "verse_number": "5", "content_sanskrit": "मन्त्रमूलंचविजयंप्रवदन्तिमनस्विनः ॥ तस्मद्वैरोचयेमन्त्रंरामंप्रतिमहाबलाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014365, "chapter_id": 9194, "verse_number": "6", "content_sanskrit": "त्रिविधाःपुरुषालोकेउत्तमाधममध्यमाः ॥ तेषांतुसमवेतानांगुणदोषौवदाम्यहम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014366, "chapter_id": 9194, "verse_number": "7", "content_sanskrit": "मन्त्रिभिर्हितसंयुक्तैस्समर्थैर्मन्त्रनिर्णये ॥ मित्रैर्वापिसमानार्थैर्बान्धवैरपिवाधिकैः । सहितोमन्त्रियित्वायःकर्मारम्भान्प्रवर्तयेत् ॥ दैवेचकुरुतेयत्नंतमाहुःपुरुषोत्तमम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014367, "chapter_id": 9194, "verse_number": "8", "content_sanskrit": "मन्त्रिभिर्हितसंयुक्तैस्समर्थैर्मन्त्रनिर्णये ॥ मित्रैर्वापिसमानार्थैर्बान्धवैरपिवाधिकैः । सहितोमन्त्रियित्वायःकर्मारम्भान्प्रवर्तयेत् ॥ दैवेचकुरुतेयत्नंतमाहुःपुरुषोत्तमम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014368, "chapter_id": 9194, "verse_number": "9", "content_sanskrit": "कोऽर्थंविमृशेदेकोधर्मेप्रकुरुतेमनः ॥ कःकार्याणिकुरुतेतमाहुर्मध्यमंनरम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014369, "chapter_id": 9194, "verse_number": "10", "content_sanskrit": "गुणदोषौवनिशिचत्य त्यक्त्यादैवव्यपाश्रयम् ॥ करिष्यामीतियःकार्यमुपेक्षेत्सनराधमः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014370, "chapter_id": 9194, "verse_number": "11", "content_sanskrit": "यथेमेपुरुषानित्यमुत्तमाधममध्यमाः ॥ वंमन्त्राऽहिविज्ञेयाउत्तमाधममध्यमः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014371, "chapter_id": 9194, "verse_number": "12", "content_sanskrit": "ऐकमत्यमुपागम्यशास्त्रदृष्टेनचक्षुषा ॥ मन्त्रिणोयत्रनिरतास्तमाहुर्मन्त्रमुत्तमम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014372, "chapter_id": 9194, "verse_number": "13", "content_sanskrit": "बह्व्योऽपिमतीर्गत्वामन्त्रिणामर्थनिर्णये ॥ पुनर्यत्रैकतांप्राप्तस्समन्त्रोमध्यमस्स्मृतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014373, "chapter_id": 9194, "verse_number": "14", "content_sanskrit": "अन्योन्यमतिमास्थाययत्रसम्प्रतिभाष्यते ॥ नचैकमत्येश्रेयोऽस्तिमन्त्रस्सोऽधमउच्यत ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014374, "chapter_id": 9194, "verse_number": "15", "content_sanskrit": "तस्मात्सुमन्त्रितंसाधुभवन्तोमतिसत्तमा: ॥ कार्यंसम्प्रतिपद्यन्तामेतत्कृत्यंमतंमम ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014375, "chapter_id": 9194, "verse_number": "16", "content_sanskrit": "वानराणांहिधीराणांसहस्रैःपरिवारितः ॥ रामोऽभ्येतिपुरीलङ्कामस्माकमुपरोधकः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40014376, "chapter_id": 9194, "verse_number": "17", "content_sanskrit": "तरिष्यतिचसुव्यक्तंराघवस्सागरंसुखम् ॥ तरसायुक्तरूपेणसानुजस्सबलानुगः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40014377, "chapter_id": 9194, "verse_number": "18", "content_sanskrit": "समुद्रमुच्छोषयतिवीर्येणान्यत्करोतिवा ॥ अस्मिन्नेवंगतेकार्येविरुद्धेवानरैस्सह । हितंपुरेचसैन्येचसर्वसम्मन्त्रयतांमम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]