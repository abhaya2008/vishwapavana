[{"id": 5000022000, "chapter_id": 9022, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे द्वाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000022001, "chapter_id": 9022, "verse_number": "१-२२-१", "content_sanskrit": "तथा वसिष्ठे ब्रुवति राजा दशरथः स्वयम् ।\nप्रहृष्टवदनो राममाजुहाव सलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000022002, "chapter_id": 9022, "verse_number": "१-२२-२", "content_sanskrit": "कृतस्वस्त्ययनं मात्रा पित्रा दशरथेन च ।\nपुरोधसा वसिष्ठेन मङ्गलैरभिमन्त्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000022003, "chapter_id": 9022, "verse_number": "१-२२-३", "content_sanskrit": "स पुत्रं मूर्ध्न्युपाघ्राय राजा दशरस्तदा ।\nददौ कुशिकपुत्राय सुप्रीतेनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000022004, "chapter_id": 9022, "verse_number": "१-२२-४", "content_sanskrit": "ततो वायुः सुखस्पर्शो नीरजस्को ववौ तदा ।\nविश्वामित्रगतं रामं दृष्ट्वा राजीवलोचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000022005, "chapter_id": 9022, "verse_number": "१-२२-५", "content_sanskrit": "पुष्पवृष्टिर्महत्यासीद् देवदुन्दुभिनिस्वनैः ।\nशङ्खदुन्दुभिनिर्घोषः प्रयाते तु महात्मनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000022006, "chapter_id": 9022, "verse_number": "१-२२-६", "content_sanskrit": "विश्वामित्रो ययावग्रे ततो रामो महायशाः ।\nकाकपक्षधरो धन्वी तं च सौमित्रिरन्वगात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000022007, "chapter_id": 9022, "verse_number": "१-२२-७", "content_sanskrit": "कलापिनौ धनुष्पाणी शोभयानौ दिशो दश ।\nविश्वामित्रं महात्मानं त्रिशीर्षाविव पन्नगौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000022008, "chapter_id": 9022, "verse_number": "१-२२-८", "content_sanskrit": "अनुजग्मतुरक्षुद्रौ पितामहमिवाश्विनौ ।\nअनुयातौ श्रिया दीप्तौ शोभयेतावनिन्दितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000022009, "chapter_id": 9022, "verse_number": "१-२२-९", "content_sanskrit": "तदा कुशिकपुत्रं तु धनुष्पाणी स्वलंकृतौ ।\nबद्धगोधाङ्गुलित्राणौ खड्गवन्तौ महाद्युती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000022010, "chapter_id": 9022, "verse_number": "१-२२-१०", "content_sanskrit": "कुमारौ चारुवपुषौ भ्रातरौ रामलक्ष्मणौ ।\nअनुयातौ श्रिया दीप्तौ शोभयेतावनिन्दितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000022011, "chapter_id": 9022, "verse_number": "१-२२-११", "content_sanskrit": "स्थाणुं देवमिवाचिन्त्यं कुमाराविव पावकी ।\nअध्यर्धयोजनं गत्वा सरय्वा दक्षिणे तटे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000022012, "chapter_id": 9022, "verse_number": "१-२२-१२", "content_sanskrit": "रामेति मधुरां वाणीं विश्वामित्रोऽभ्यभाषत ।\nगृहाण वत्स सलिलं मा भूत्कालस्य पर्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000022013, "chapter_id": 9022, "verse_number": "१-२२-१३", "content_sanskrit": "मन्त्रग्रामं गृहाण त्वं बलामतिबलां तथा ।\nन श्रमो न ज्वरो वा ते न रूपस्य विपर्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000022014, "chapter_id": 9022, "verse_number": "१-२२-१४", "content_sanskrit": "न च सुप्तं प्रमत्तं वा धर्षयिष्यन्ति नैर्ऋताः ।\nन बाह्वोः सदृशो वीर्ये पृथिव्यामस्ति कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000022015, "chapter_id": 9022, "verse_number": "१-२२-१५", "content_sanskrit": "त्रिषु लोकेषु वा राम न भवेत्सदृशस्तव ।\nबलामतिबलां चैव पठतस्तात राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000022016, "chapter_id": 9022, "verse_number": "१-२२-१६", "content_sanskrit": "न सौभाग्ये न दाक्षिण्ये न ज्ञाने बुद्धिनिश्चये ।\nनोत्तरे प्रतिवक्तव्ये समो लोके तवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000022017, "chapter_id": 9022, "verse_number": "१-२२-१७", "content_sanskrit": "एतद्विद्याद्वये लब्धे न भवेत् सदृशस्तव ।\nबला चातिबला चैव सर्वज्ञानस्य मातरौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000022018, "chapter_id": 9022, "verse_number": "१-२२-१८", "content_sanskrit": "क्षुत्पिपासे न ते राम भविष्येते नरोत्तम ।\nबलामतिबलां चैव पठस्तात राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000022019, "chapter_id": 9022, "verse_number": "१-२२-१९", "content_sanskrit": "गृहाण सर्वलोकस्य गुप्तये रघुनन्दन ।\nविद्याद्वयमधीयाने यशश्चाथ भवेद् भुवि ।\nपितामहसुते ह्येते विद्ये तेजःसमन्विते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000022020, "chapter_id": 9022, "verse_number": "१-२२-२०", "content_sanskrit": "प्रदातुं तव काकुत्स्थ सदृशस्त्वं हि पार्थिव ।\nकामं बहुगुणाः सर्वे त्वय्येते नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000022021, "chapter_id": 9022, "verse_number": "१-२२-२१", "content_sanskrit": "तपसा संभृते चैते बहुरूपे भविष्यतः ।\nततो रामो जलं स्पृष्ट्वा प्रहृष्टवदनः शुचिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000022022, "chapter_id": 9022, "verse_number": "१-२२-२२", "content_sanskrit": "प्रतिजग्राह ते विद्ये महर्षेर्भावितात्मनः ।\nविद्यासमुदितो रामः शुशुभे भूरिविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000022023, "chapter_id": 9022, "verse_number": "१-२२-२३", "content_sanskrit": "सहस्ररश्मिर्भगवाञ्शरदीव दिवाकरः ।\nगुरुकार्याणि सर्वाणि नियुज्य कुशिकात्मजे ।\nऊषुस्तां रजनीं तत्र सरय्वां सुसुखं त्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000022024, "chapter_id": 9022, "verse_number": "१-२२-२४", "content_sanskrit": "दशरथनृपसूनुसत्तमाभ्यां\n:::तृणशयनेऽनुचिते तदोषिताभ्याम् ।\nकुशिकसुतवचोऽनुलालिताभ्याम्\n:::सुखमिव सा विबभौ विभावरी च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000022025, "chapter_id": 9022, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे द्वाविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]