[{"id": 2030136, "chapter_id": 1659, "verse_number": "३-२९७-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030137, "chapter_id": 1659, "verse_number": "३-२९७-१", "content_sanskrit": "ततः काले बहुतिथे व्यतिक्रान्ते कदाचन।\nप्राप्तः स कालो मर्व्यं यत्रसत्यवता नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030138, "chapter_id": 1659, "verse_number": "३-२९७-२", "content_sanskrit": "गणयन्त्याश्च सावित्र्या दिवसदिवसे गते।\nयद्वाक्यं नारदेनोक्तं वर्तते हृदि नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030139, "chapter_id": 1659, "verse_number": "३-२९७-३", "content_sanskrit": "चतुर्थेऽहनि मर्तव्यमिति संचिन्त्य भामिनी।\nव्रतं त्रिरात्रमुद्दिश्य दिवारात्रं स्थिताऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030140, "chapter_id": 1659, "verse_number": "३-२९७-४", "content_sanskrit": "`त्रयोदश्यां चोपवासं प्रतिपत्सु च पारणम्।\nआयुष्यं वर्धते भर्तुर्व्रतेनानि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030141, "chapter_id": 1659, "verse_number": "३-२९७-५", "content_sanskrit": "तं श्रुत्वा रकनियमं तस्या भृशं दुःखान्वितो नृपः।\nउत्थाय वाक्यं सावित्रीमब्रवीत्परिसान्त्वयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030142, "chapter_id": 1659, "verse_number": "३-२९७-६", "content_sanskrit": "अतितीव्रोऽयमारम्भस्त्वयाऽऽरब्धो नृपात्मजे।\nतिसृणां वसतीनां हि स्तानं परमदुश्चरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030143, "chapter_id": 1659, "verse_number": "३-२९७-७x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030144, "chapter_id": 1659, "verse_number": "३-२९७-७", "content_sanskrit": "न कार्यस्तात संतापः पारयिष्याम्यहं व्रतम्।\nव्यसंसायकृतं हीदं व्यवसायश्च कारणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030145, "chapter_id": 1659, "verse_number": "३-२९७-८x", "content_sanskrit": "द्युमत्सेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030146, "chapter_id": 1659, "verse_number": "३-२९७-८", "content_sanskrit": "व्रतं भिन्धीति वक्तुं त्वां नास्मि शक्तः कथंचन।\nपारयस्वेति वचनं युक्तमस्मद्विधो वदेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030147, "chapter_id": 1659, "verse_number": "३-२९७-९x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030148, "chapter_id": 1659, "verse_number": "३-२९७-९", "content_sanskrit": "एवमुक्त्वा द्युमत्सेनो विरराम महामनाः।\nतिष्ठन्ती चैव सावित्री काण्ठभूतेव लक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030149, "chapter_id": 1659, "verse_number": "३-२९७-१०", "content_sanskrit": "श्वोभूते भर्तृमरणे सावित्र्या भरतर्षभ।\nदुःखान्वितायास्तिष्ठन्त्याः सा रात्रिर्व्यत्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030150, "chapter_id": 1659, "verse_number": "३-२९७-११", "content_sanskrit": "अद्य तद्दिवसं चेति हुत्वा दीप्तं हुताशनम्।\nयुगमात्रोदिते सूर्येकृत्वा पौर्वाङ्णिकीः क्रियाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030151, "chapter_id": 1659, "verse_number": "३-२९७-१२", "content_sanskrit": "`व्रतं समाप्यसावित्री स्नात्वा शुद्धा यशस्विनी।\nततः सर्वान्द्विजान्वृद्धाञ्श्वश्रूं श्वशुरमेव च।\nअभिवाद्यानुपूर्व्येण प्राञ्जलिर्नियता स्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030152, "chapter_id": 1659, "verse_number": "३-२९७-१३", "content_sanskrit": "अवैधव्याशिषस्ते तु सावित्र्यर्थं हिताः शुभाः।\nऊचुस्तपस्विनः सर्वे तपोवननिवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030153, "chapter_id": 1659, "verse_number": "३-२९७-१४", "content_sanskrit": "एवमस्त्विति सावित्री ध्यानयोगपरायणा।\nमनसा ता गिरः सर्वाः प्रत्यगृह्णात्तपस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030154, "chapter_id": 1659, "verse_number": "३-२९७-१५", "content_sanskrit": "तं कालं तं मुहूर्तं च प्रतीक्षन्ती नृपात्मजा।\nयथोक्तं नारदवचश्चिन्तयन्ती सुदुःखिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030155, "chapter_id": 1659, "verse_number": "३-२९७-१६", "content_sanskrit": "ततस्तु श्वश्रूश्वशुरावूचतुस्तां नृपात्मजाम्।\nएकान्तमास्थितां वाक्यं प्रीत्या भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030156, "chapter_id": 1659, "verse_number": "३-२९७-१७", "content_sanskrit": "व्रतं यथोपदिष्टं तु तथा तत्पारितं त्वया।\nआहारकालः संप्राप्तः क्रियतां यदनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030157, "chapter_id": 1659, "verse_number": "३-२९७-१८x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030158, "chapter_id": 1659, "verse_number": "३-२९७-१८", "content_sanskrit": "अस्तं गते मयाऽऽदित्ये भोक्तव्यं कृतकामया।\nएष मे हृदि संकल्पः समयश्च कृतो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030159, "chapter_id": 1659, "verse_number": "३-२९७-१९x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030160, "chapter_id": 1659, "verse_number": "३-२९७-१९", "content_sanskrit": "एवं संभाषमाणायाः सावित्र्या भोजनं प्रति।\nस्कन्धे परशुमादाय सत्यवान्प्रस्थितो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030161, "chapter_id": 1659, "verse_number": "३-२९७-२०", "content_sanskrit": "सावित्री त्वाह भर्तारं नैकस्त्वं गन्तुमर्हसि।\nसह त्वया गमिष्यामि न हित्वां हातुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030162, "chapter_id": 1659, "verse_number": "३-२९७-२१x", "content_sanskrit": "सत्यवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030163, "chapter_id": 1659, "verse_number": "३-२९७-२१", "content_sanskrit": "वनं न गतपूर्वं ते दुःख पन्थाश्च भामिनि।\nव्रतोपवासक्षामा च कथं पद्भ्यां गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2030164, "chapter_id": 1659, "verse_number": "३-२९७-२२x", "content_sanskrit": "सावित्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2030165, "chapter_id": 1659, "verse_number": "३-२९७-२२", "content_sanskrit": "उपवासान्न मे ग्लानिर्नास्ति चापि परिश्रमः।\nगमने च कृतोत्साहां प्रतिषेद्धुं न माऽर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2030166, "chapter_id": 1659, "verse_number": "३-२९७-२३x", "content_sanskrit": "सत्यवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2030167, "chapter_id": 1659, "verse_number": "३-२९७-२३", "content_sanskrit": "यदि ते गमनोत्साहः करिष्यामि तव प्रयम्।\nमम त्वामन्त्रय गुरून्न मां दोषः स्पृशेदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2030168, "chapter_id": 1659, "verse_number": "३-२९७-२४x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2030169, "chapter_id": 1659, "verse_number": "३-२९७-२४", "content_sanskrit": "साऽभिवाद्याब्रवीच्छ्वश्रूं श्वशुरं च महाव्रता।\nअयं गच्छति मे भर्ता फलाहारो महावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2030170, "chapter_id": 1659, "verse_number": "३-२९७-२५", "content_sanskrit": "इच्छेयमभ्यनुज्ञाता आर्यया श्वशुरेण ह।\nअनेन सह निर्गन्तुं न मेऽद्य विरहः क्षमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2030171, "chapter_id": 1659, "verse_number": "३-२९७-२६", "content_sanskrit": "गुर्वग्निहोत्रार्तकृतेप्रस्थितश्च सुतस्तव।\nन निवार्यो निवार्यः स्यादन्यथा प्रस्थितो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2030172, "chapter_id": 1659, "verse_number": "३-२९७-२७", "content_sanskrit": "संवत्सरः किंचिदूनो न निष्क्रान्ताऽहमाश्रमात्।\nवनं कुसुमितं द्रष्टुं परं कौतूहलं हि मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2030173, "chapter_id": 1659, "verse_number": "३-२९७-२८x", "content_sanskrit": "द्युमत्सेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2030174, "chapter_id": 1659, "verse_number": "३-२९७-२८", "content_sanskrit": "यदा प्रभृति सावित्री पित्रा दत्ता स्नाषु मम।\nनानयाऽभ्यर्थनायुक्तमुक्तपूर्वं स्मराम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2030175, "chapter_id": 1659, "verse_number": "३-२९७-२९", "content_sanskrit": "तदेषा लभतां कामं यथाभिलषितं वधूः।\nअप्रमादश्च कर्तव्यः पुत्रि सत्यवतः पथि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2030176, "chapter_id": 1659, "verse_number": "३-२९७-३०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2030177, "chapter_id": 1659, "verse_number": "३-२९७-३०", "content_sanskrit": "उभाभ्यामभ्यनुज्ञाता सा जगाम यशस्विनी।\nसहभर्त्रा हसन्तीव हृदयेन विदूयता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2030178, "chapter_id": 1659, "verse_number": "३-२९७-३१", "content_sanskrit": "सा वनानि विचित्राणि रमणीयानि सर्वशः।\nमयूरगणजुष्टानि ददर्श विपुलेक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2030179, "chapter_id": 1659, "verse_number": "३-२९७-३२", "content_sanskrit": "नदीः पुण्यवहाश्चैव पुष्पितांश्च नगोत्तमान्।\nसत्यवानाह पश्येति सावित्रीं मधूरं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2030180, "chapter_id": 1659, "verse_number": "३-२९७-३३", "content_sanskrit": "नीरीक्षमाणा भर्तारं सर्वावस्थमनिन्दिता।\nमृतमेव हिं मेने काले मुनिवचः स्मरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2030181, "chapter_id": 1659, "verse_number": "३-२९७-३४", "content_sanskrit": "अनुव्रजन्ती भर्तारं जगाम मृदुगामिनी।\nद्विधेव हृदयं कृत्वा तं च कालमवेक्षती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2030182, "chapter_id": 1659, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि पतिब्रतामाहात्म्यपर्वणि सप्तनवत्यधिकद्विशततमोऽध्यायः ॥ २९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]