[{"id": 7003639000, "chapter_id": 23639, "verse_number": "१-२-२६-१", "content_sanskrit": "नारद उवाच ।\nअथ ब्रह्मा महादेवमभिवाद्य कृतांजलिः ।\nउद्वाहः क्रियतां देव इत्युवाच महेश्वरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003639001, "chapter_id": 23639, "verse_number": "१-२-२६-२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा प्राहेदं भगवान्हरः ।\nपराधीना वयं ब्रह्मन्हिमाद्रेस्तव चापि यत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003639002, "chapter_id": 23639, "verse_number": "१-२-२६-३", "content_sanskrit": "यद्युक्तं क्रियतां तद्धि वयं युष्मद्वशेऽधुना ।\nततो ब्रह्मा स्वयं दिव्यं पुरं रत्नमयं शुभम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003639003, "chapter_id": 23639, "verse_number": "१-२-२६-४", "content_sanskrit": "उद्वाहार्थं महेशस्य तत्क्षणात्समकल्पयत् ।\nशतयोजनविस्तीर्णं प्रासादशतशोभितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003639004, "chapter_id": 23639, "verse_number": "१-२-२६-५", "content_sanskrit": "पुरेतस्मिन्महादेवः स्वयमेव व्यतिष्ठत ।\nततः सप्तमुनीन्देवश्चिंतिताब्यागतान्पुरः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003639005, "chapter_id": 23639, "verse_number": "१-२-२६-६", "content_sanskrit": "प्राहिणोदंबिकायाश्च स्थिरपत्रार्थमीश्वरः ।\nसारुंधतीकास्ते तत्र ह्लादयंतो हिमाचलम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003639006, "chapter_id": 23639, "verse_number": "१-२-२६-७", "content_sanskrit": "सभार्यामीश्वरगुणैः स्थिरपत्राणि चादधुः ।\nततः संपूजितास्तेन पुनरागम्य तेऽचलात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003639007, "chapter_id": 23639, "verse_number": "१-२-२६-८", "content_sanskrit": "न्यवेदयंस्र्यंबकाय स च तानभ्यनंदत ।\nउद्वाहार्थं ततो देवो विश्वं सर्वं न्यमंत्रयत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003639008, "chapter_id": 23639, "verse_number": "१-२-२६-९", "content_sanskrit": "समागतं च तत्सव विना दैत्यैर्दुरात्मभिः ।\nस्थावरं जंगमं यच्च विश्वं विष्णुपुरोगमम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003639009, "chapter_id": 23639, "verse_number": "१-२-२६-१०", "content_sanskrit": "सब्रह्यकं पुरारातेर्महिमानमवर्धयत् ।\nततस्तं विधिराहेदं गन्धमादनपर्वते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003639010, "chapter_id": 23639, "verse_number": "१-२-२६-११", "content_sanskrit": "पुरे स्थितं विवाहस्य देव कालः प्रवर्तते ।\nततस्तस्य जटाजूटे चंद्रखंडं पितामहः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003639011, "chapter_id": 23639, "verse_number": "१-२-२६-१२", "content_sanskrit": "बबंध प्रणयोदारविस्फारितविलोचनः ।\nकपर्द्दं शोभनं विष्णुः स्वय चक्रेऽस्य हर्षतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003639012, "chapter_id": 23639, "verse_number": "१-२-२६-१३", "content_sanskrit": "कपालमालां विपुलां चामुण्डा मूर्ध्न्यबंधत ।\nउवाच चापि गिरिशं पुत्रं जनय शंकर ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003639013, "chapter_id": 23639, "verse_number": "१-२-२६-१४", "content_sanskrit": "यो दैत्येंद्रकुलं हत्वा मां रक्तैस्तर्पयिष्यति ।\nसूर्यो ज्वलच्छिखारक्तं भाबासितजगत्त्रयम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003639014, "chapter_id": 23639, "verse_number": "१-२-२६-१५", "content_sanskrit": "बबंध देवदेवस्यच स्वयमेव प्रमोदतः ।\nशेषवासुकिमुख्याश्च ज्वलंतस्तेजसा शुभाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003639015, "chapter_id": 23639, "verse_number": "१-२-२६-१६", "content_sanskrit": "आत्मानं भूषणस्थाने स्वयं ते चक्रुरीश्वरे॥वायवश्च ततस्तीक्ष्णश्रृंगं हिमगिरिप्रभम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003639016, "chapter_id": 23639, "verse_number": "१-२-२६-१७", "content_sanskrit": "वृषं विभूषयामासुर्नानारत्नोपपत्तिभिः ।\nशक्रो गजजिनं गृह्य स्वयमग्रे व्यवस्थितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003639017, "chapter_id": 23639, "verse_number": "१-२-२६-१८", "content_sanskrit": "विना भस्म समाधाय कपाले रजतप्रभम् ।\nमनुजास्थिमयीं मालां प्रेतनाथश्च वन्दनम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003639018, "chapter_id": 23639, "verse_number": "१-२-२६-१९", "content_sanskrit": "वह्निस्तेजोमयं दिव्यमजिनं प्रददौ स्थितः ।\nएवं विभूषितः सर्वैर्भृत्यैरीशो बभौ भृशम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003639019, "chapter_id": 23639, "verse_number": "१-२-२६-२०", "content_sanskrit": "ततो हिमाद्रेः पुरुषा वीरकं प्रोचिरे वचः ।\nमा भूत्कालात्ययः शीघ्रं भवस्यैतन्निवेद्यताम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003639020, "chapter_id": 23639, "verse_number": "१-२-२६-२१", "content_sanskrit": "ततो देवं प्रणम्याह वीरकः करसंपुटी ।\nत्वरयंति महेशानं हिमाद्रेः पुरुषास्त्वमी ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003639021, "chapter_id": 23639, "verse_number": "१-२-२६-२२", "content_sanskrit": "इति श्रुत्वा वचो देवः शीघ्रमित्येव चाब्रवीत् ।\nसप्त वारिधयस्तस्य चक्रुर्दर्पणदर्शनम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003639022, "chapter_id": 23639, "verse_number": "१-२-२६-२३", "content_sanskrit": "तत्रैक्षत महादेवः स्वरूपं स जगन्मयम् ।\nततो बद्धांजलिर्धीमान्स्थाणुं प्रोवाच केशवः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003639023, "chapter_id": 23639, "verse_number": "१-२-२६-२४", "content_sanskrit": "देवदेव महादेव त्रिपुरांतक शंकर ।\nशोभसेऽनेन रूपेण जगदानंददायिना ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003639024, "chapter_id": 23639, "verse_number": "१-२-२६-२५", "content_sanskrit": "महेश्वर यथा साक्षादपरस्त्वं महेश्वरः ।\nततः स्मयन्महादेवो जयेति भुवने श्रुतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003639025, "chapter_id": 23639, "verse_number": "१-२-२६-२६", "content_sanskrit": "करमालंब्य विष्णोश्च वृषभं रुरुहेशनैः ।\nततश्च वसवो देवाः शूलं तस्य न्यवेदयन् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003639026, "chapter_id": 23639, "verse_number": "१-२-२६-२७", "content_sanskrit": "धनदो निदिभिर्युक्तः समीपस्थस्ततोऽभवत् ।\nस शूलपाणिर्विश्वात्मा संचचाल ततो हरः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003639027, "chapter_id": 23639, "verse_number": "१-२-२६-२८", "content_sanskrit": "देवदुंदुभिनादैश्च पुष्पासारैश्च गीतकैः ।\nनृत्यद्भिरप्सरोभिश्च जयेति च महास्वनैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003639028, "chapter_id": 23639, "verse_number": "१-२-२६-२९", "content_sanskrit": "सव्यदक्षिणसंस्थानौ ब्रह्मविष्णूतु जग्मतुः ।\nहंसं च गरुडं चैव समारुह्य महाप्रभौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003639029, "chapter_id": 23639, "verse_number": "१-२-२६-३०", "content_sanskrit": "अथादितिर्दितिः सा च दनुः कद्रूः सुपर्णजा ।\nपौलोमी सुरसा चैव सिंहिका सुरभिर्मुनिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003639030, "chapter_id": 23639, "verse_number": "१-२-२६-३१", "content_sanskrit": "सिद्धिर्माया क्षमा दुर्गा देवी स्वाहा स्वधा सुधा ।\nसावित्री चैव गायत्री लक्ष्मीः सा दक्षिणा द्युतिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003639031, "chapter_id": 23639, "verse_number": "१-२-२६-३२", "content_sanskrit": "स्पृहामतिर्धृतिर्बुद्धिर्मंथिरृद्धिः सरस्वती ।\nराका कुहूः सिनीवाली देवी भानुमती तथा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003639032, "chapter_id": 23639, "verse_number": "१-२-२६-३३", "content_sanskrit": "धरणी धारणी वेला राज्ञी चापि च रोहिणी ।\nइत्येताश्चान्यदेवानां मातरः पत्नयस्तथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003639033, "chapter_id": 23639, "verse_number": "१-२-२६-३४", "content_sanskrit": "उद्वाहं देवदेवस्य जग्मुः सर्वा मुदान्विताः ।\nउरगा गरुडा यक्षा गंधर्वाः किंनरा नराः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003639034, "chapter_id": 23639, "verse_number": "१-२-२६-३५", "content_sanskrit": "सागरा गिरयो मेघा मासाः संवत्सरास्तथा ।\nवेदा मंत्रास्तथा यज्ञाः श्रौता धर्माश्च सर्वशः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003639035, "chapter_id": 23639, "verse_number": "१-२-२६-३६", "content_sanskrit": "हुंकाराः प्रणवाश्चैव इतिहासाः सहस्रशः ।\nकोटिशश्च तथा देवा महेंद्राद्याः सवाहनाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003639036, "chapter_id": 23639, "verse_number": "१-२-२६-३७", "content_sanskrit": "अनुजग्मुर्महादेवं कोटिशोऽर्बुदशश्च हि ।\nगणाश्च पृष्ठतो जग्मुः शंखवर्णाश्च कोटिशः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003639037, "chapter_id": 23639, "verse_number": "१-२-२६-३८", "content_sanskrit": "दशभिः केकराख्याश्च विद्युतोऽष्टाभिरेव च ।\nचतुःषष्ट्या विशाखाश्च नवभिः पारियात्रिकाः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003639038, "chapter_id": 23639, "verse_number": "१-२-२६-३९", "content_sanskrit": "षड्भिः सर्वांतकः श्रीमांस्तथैव विकृताननः ।\nज्वालाकेशो द्वादशभिः कोटिभिः संवृतो ययौ ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003639039, "chapter_id": 23639, "verse_number": "१-२-२६-४०", "content_sanskrit": "सप्तभिः समदः श्रीमान्दुंदुभोष्ठाभिरेव च ।\nपंचभिश्च कपालीशः षड्भिः संह्रादकः शुभः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003639040, "chapter_id": 23639, "verse_number": "१-२-२६-४१", "content_sanskrit": "कोटिकोटिभिरेवैकः कुंडकः कुंभकस्तथा ।\nविष्टंभोऽष्टाभिरेवेह गणपः सर्वसत्तमः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003639041, "chapter_id": 23639, "verse_number": "१-२-२६-४२", "content_sanskrit": "पिप्पलश्च सहस्रेण सन्नादश्च तथा बली ।\nआवेशनस्तथाष्टाभिः सप्तभिश्चंद्रतापनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003639042, "chapter_id": 23639, "verse_number": "१-२-२६-४३", "content_sanskrit": "महाकेशः सहस्रेण नंदिर्द्वादशभिस्तथा ।\nनगः कालः करालश्च महाकालः शतेन च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003639043, "chapter_id": 23639, "verse_number": "१-२-२६-४४", "content_sanskrit": "अग्निकः शतकोट्या वै कोट्याग्निमुख एव च ।\nआदित्यमूर्धा कोट्या च कोट्या चैव धनावहः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003639044, "chapter_id": 23639, "verse_number": "१-२-२६-४५", "content_sanskrit": "सन्नागश्च शतेनैव कुमुदः कोटिभिस्त्रिभिः ।\nअमोघः कोकिलश्चैव कोटिकोट्या सुमंत्रकः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003639045, "chapter_id": 23639, "verse_number": "१-२-२६-४६", "content_sanskrit": "काकपादस्तता षष्ट्या षष्ट्या संतानको गणः ।\nमहाबलश्च नवभिर्मधुपिंगश्च पिंगलः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003639046, "chapter_id": 23639, "verse_number": "१-२-२६-४७", "content_sanskrit": "नीलो नवत्या सप्तत्या चतुर्वक्त्रश्च पूर्वपात् ।\nवीरभद्रश्चश्चतुःषष्ट्या करणो बालकस्तथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003639047, "chapter_id": 23639, "verse_number": "१-२-२६-४८", "content_sanskrit": "पंचाक्षः शतमन्युश्च मेघमन्युश्च विंशतिः ।\nकाष्ठकोटिश्चतुःषष्ट्या सुकोशो वृषभस्तथा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003639048, "chapter_id": 23639, "verse_number": "१-२-२६-४९", "content_sanskrit": "विश्वरूपस्तालकेतुः पंचाशच्च सिताननः ।\nईशानो वृद्धदेवश्च दीप्तात्मा मृत्युहा तथा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003639049, "chapter_id": 23639, "verse_number": "१-२-२६-५०", "content_sanskrit": "विषादो यमहा चैव गणो भृंगरिटिस्तथा ।\nअशनी हासकश्चैव चतुःषष्ट्या सहस्रपात् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003639050, "chapter_id": 23639, "verse_number": "१-२-२६-५१", "content_sanskrit": "एते चान्ये च गणपा असंख्याता महाबलाः ।\nसर्वे सहस्रहस्ताश्च जटामुकुटधारीणः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003639051, "chapter_id": 23639, "verse_number": "१-२-२६-५२", "content_sanskrit": "चंद्रलेखावतंसाश्च नीलकंठास्त्रिलोचनाः ।\nहारकुंडलकेयूरमुकुटाद्यैरलंकृताः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003639052, "chapter_id": 23639, "verse_number": "१-२-२६-५३", "content_sanskrit": "अणिमादिगुणैर्युक्ताः शक्ताः शापप्रसादयोः ।\nसूर्यकोटिप्रतीकाशास्तत्राजग्मुर्गणेश्वराः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003639053, "chapter_id": 23639, "verse_number": "१-२-२६-५४", "content_sanskrit": "पातालांबरभूमिस्थाः सर्वलोकनिवासिनः ।\nतुंबुरुर्नारदो हाहा हूहूश्चैव तु सामगाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003639054, "chapter_id": 23639, "verse_number": "१-२-२६-५५", "content_sanskrit": "तंत्रीमादाय वाद्यांश्चाऽवादयञ्छंकरोत्सवे ।\nऋषयः कृत्स्नशश्चैव वेदगीतांस्तपोधनाः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003639055, "chapter_id": 23639, "verse_number": "१-२-२६-५६", "content_sanskrit": "पुण्यान्वैवाहिकान्मंत्राञ्जेषुः संहृष्टमानसाः ।\nएवं प्रतस्थेगिरिशो वीज्यमानश्च गंगया ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003639056, "chapter_id": 23639, "verse_number": "१-२-२६-५७", "content_sanskrit": "तथा यमुनया चापांपतिना धृतच्छत्रया ।\nस्त्रीभिर्नानाविधालापैलाजाभिश्चानुमोदितः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003639057, "chapter_id": 23639, "verse_number": "१-२-२६-५८", "content_sanskrit": "महोत्सवेन देवेशो गिरिस्थानं विवेश सः ।\nप्रभासत्स्वर्णकलशं तोरणानां शतैर्युतम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003639058, "chapter_id": 23639, "verse_number": "१-२-२६-५९", "content_sanskrit": "वैडूर्यबद्धभूमिस्थं रत्नजैश्च गृहैर्युतम् ।\nतत्प्रविश्य स्तूयमानो द्वारमभ्याससाद ह ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003639059, "chapter_id": 23639, "verse_number": "१-२-२६-६०", "content_sanskrit": "ततो हिमाचलस्तत्र दृश्यते व्याकुलाकुलः ।\nआदिशदात्मभृत्यानां महादेव उपस्थिते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003639060, "chapter_id": 23639, "verse_number": "१-२-२६-६१", "content_sanskrit": "ततो ब्रह्माणमचलो गुरुत्वे प्रार्थयत्तदा ।\nकृत्यानां सर्वभारेषु वासुदेवं च बुद्धिमान् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003639061, "chapter_id": 23639, "verse_number": "१-२-२६-६२", "content_sanskrit": "प्रत्याह च विवाहऽस्मिन्कुमारीभ्रातरं विना ।\nभविष्यति कथं विष्णो लाजहोमादिकर्मसु ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003639062, "chapter_id": 23639, "verse_number": "१-२-२६-६३", "content_sanskrit": "सुतो हि मम मैनाकः स प्रविष्टोऽर्णवे स्थितः ।\nइति चिंताविषण्णं तं विष्णुराहमहामतिः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003639063, "chapter_id": 23639, "verse_number": "१-२-२६-६४", "content_sanskrit": "अत्र चिंता न कर्तव्या गिरिराज कथंचन ।\nअहं भ्राता जगन्मातुरेतदे वं च नान्यथा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003639064, "chapter_id": 23639, "verse_number": "१-२-२६-६५", "content_sanskrit": "ततः प्रमुदितः शैलः पार्वतीं च स्वलंकृताम् ।\nसखीभिः कोटिसंख्याभिर्वृतां प्रवेशयत्सदः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003639065, "chapter_id": 23639, "verse_number": "१-२-२६-६६", "content_sanskrit": "ततो नीलमयस्तंभं ज्वलत्कांचनकुट्टिमम् ।\nमुक्ताजालपरिष्कारं ज्वलितौ षधिदीपितम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003639066, "chapter_id": 23639, "verse_number": "१-२-२६-६७", "content_sanskrit": "रत्नासनसहस्राढ्यं शतयोजनविस्तृतम् ।\nविवाहमंडपं शर्वो विवेशानुचरावृतः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003639067, "chapter_id": 23639, "verse_number": "१-२-२६-६८", "content_sanskrit": "ततः शैलः सपत्नीकः पादौ प्रक्षाल्य हर्षितः ।\nभवस्य तेन तोयेन सिषिचे स्वं जगत्तथा ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003639068, "chapter_id": 23639, "verse_number": "१-२-२६-६९", "content_sanskrit": "पाद्यमाचमनं दत्त्वा मधुपर्कं च गां तथा ।\nप्रदानस्य प्रयोगं च संचिंतयंति ब्राह्मणाः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003639069, "chapter_id": 23639, "verse_number": "१-२-२६-७०", "content_sanskrit": "दौहित्रीं कव्यवाहानां दद्मि पुत्रीं स्वकामहम् ।\nइत्युक्त्वा तस्थिवाञ्छैलो न जानाति हरस्य सः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003639070, "chapter_id": 23639, "verse_number": "१-२-२६-७१", "content_sanskrit": "ततः सर्वानपृच्छत्स कुलं कोऽपि न वेद तत् ।\nततो विष्णुरिदं प्राह पृछ्यंतेऽन्ये किमर्थतः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003639071, "chapter_id": 23639, "verse_number": "१-२-२६-७२", "content_sanskrit": "अज्ञातकुलतां तस्य पृछ्यतामयमेव च ।\nअहिरेव अहेः पादान्वेत्ति नान्यो हिमाचल ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003639072, "chapter_id": 23639, "verse_number": "१-२-२६-७३", "content_sanskrit": "स्वगोत्रं यदि न ब्रूते न देया भगिनी मम ।\nततो हासस्तदा जज्ञे सर्वेषां सुमहास्वनः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003639073, "chapter_id": 23639, "verse_number": "१-२-२६-७४", "content_sanskrit": "निवृत्तश्च क्षणाद्भूयः किं वक्ष्यति हरस्त्विति ।\nततो विमृश्य बहुधा किंचिद्भीताननो यता ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003639074, "chapter_id": 23639, "verse_number": "१-२-२६-७५", "content_sanskrit": "लज्जाजडः स्मितं चक्रे ततः पार्थ स वै हरः ।\nततो विशिष्टा ब्रुवति शीघ्रं कालोऽतिवर्तते ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003639075, "chapter_id": 23639, "verse_number": "१-२-२६-७६", "content_sanskrit": "हरिः प्राह महेशानं बिभ्यदावेद्मयहं तव ।\nमातामहं च पितरं प्रयोगं श्रृणु भूधर ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003639076, "chapter_id": 23639, "verse_number": "१-२-२६-७७", "content_sanskrit": "आत्मपुत्राय ते शंभो आत्मदौहित्रकाय ते ।\nइत्युक्ते विष्णुना सर्वे साधुसाध्विति ते जगुः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003639077, "chapter_id": 23639, "verse_number": "१-२-२६-७८", "content_sanskrit": "देवोऽप्युदाहरेद्वुद्धिं सर्वेभ्योऽप्यधिकां वराम् ।\nततः शैलस्तथा चोक्त्वा दत्त्वा देवीं च सोदकम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003639078, "chapter_id": 23639, "verse_number": "१-२-२६-७९", "content_sanskrit": "आत्मानं चापि देवाय प्रददौ सोदकं नगः ।\nततः सर्वे तुष्टुवुस्तं विवाहं विस्मयान्विताः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003639079, "chapter_id": 23639, "verse_number": "१-२-२६-८०", "content_sanskrit": "दाता महीभृतां नाथो होता देवश्चतुर्मुखः ।\nवरः पशुपतिः साक्षात्कन्या विश्वरणिस्तथा ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003639080, "chapter_id": 23639, "verse_number": "१-२-२६-८१", "content_sanskrit": "ततः स्तुवत्सु मुनिषु पुष्पवर्षे महत्यपि ।\nनदत्सु देवतूर्येषु करं जग्राह त्र्यम्बकः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003639081, "chapter_id": 23639, "verse_number": "१-२-२६-८२", "content_sanskrit": "देवो देवीं समालोक्य सलज्जां हिमशैलजाम् ।\nन तृप्यति न चाह्लादत्सा च देवां वृषध्वजम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003639082, "chapter_id": 23639, "verse_number": "१-२-२६-८३", "content_sanskrit": "तत्र ब्रह्मादिमुनयो देवीमद्भुतरूपिणीम् ।\nपश्यंतः शरणं जग्मुर्मनसा परमेश्वरम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003639083, "chapter_id": 23639, "verse_number": "१-२-२६-८४", "content_sanskrit": "मा मुह्याम पार्वतीं च यथा नारदपर्वतौ ।\nततस्तथैव तच्चक्रे सर्वेषामीप्सितं वचः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003639084, "chapter_id": 23639, "verse_number": "१-२-२६-८५", "content_sanskrit": "ततो देवैश्च मुनिभिः संस्तुतः परमेश्वरः ।\nप्रविवेश शुभां वेदीं मूर्तिमज्ज्वलनाश्रिताम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003639085, "chapter_id": 23639, "verse_number": "१-२-२६-८६", "content_sanskrit": "वेधाः श्रुतीरितैर्मं त्रैर्मूर्तिमद्भिरुपस्थितैः ।\nमूर्तमग्निं जुहाव त्रिः परिक्रम्य च तं हरः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003639086, "chapter_id": 23639, "verse_number": "१-२-२६-८७", "content_sanskrit": "लाजाहोम उमाभ्राता प्राह तं सस्मितं हरिः ।\nबहवो मिलिताः संति लोकाः संमर्द ईश्वर ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003639087, "chapter_id": 23639, "verse_number": "१-२-२६-८८", "content_sanskrit": "सावधानेन रक्ष्याणि भूषणानि त्वया हर ।\nततो हरश्च तं प्राह स्वजने माऽतिगोपय ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003639088, "chapter_id": 23639, "verse_number": "१-२-२६-८९", "content_sanskrit": "किंचित्प्रार्थय दास्यामि प्राह विष्णुस्ततो वरम् ।\nत्वयि भक्तिर्दृढा मेऽस्तु स च तद्दुर्लभं ददौ ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003639089, "chapter_id": 23639, "verse_number": "१-२-२६-९०", "content_sanskrit": "ददतुः सृष्टिसंरक्षां ब्रह्मणे दक्षिणामुभौ ।\nअग्नये यज्ञभागांश्च प्रीतौ हरजनार्दनौ ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003639090, "chapter_id": 23639, "verse_number": "१-२-२६-९१", "content_sanskrit": "भृग्वादीनां ततो दत्त्वा श्रुतिरक्षणदक्षिणाम् ।\nततो गीतैश्च नृत्यैश्च भोजनैश्च यथेप्सितैः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003639091, "chapter_id": 23639, "verse_number": "१-२-२६-९२", "content_sanskrit": "महोत्सवैरनेकैश्च विस्मयं समपद्यत ।\nविसृज्य लोकं तं सर्वं किमिच्छादानकैर्भवः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003639092, "chapter_id": 23639, "verse_number": "१-२-२६-९३", "content_sanskrit": "सरस्वत्या च पितरौ देव्याश्चाऽश्वास्य दुःखितौ ।\nआमंत्र्य हिमशैलेंद्रं ब्रह्मणं च सकेशवम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003639093, "chapter_id": 23639, "verse_number": "१-२-२६-९४", "content_sanskrit": "जगाम मंदरगिरिं गिरिणा यानुगोर्चितः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003639094, "chapter_id": 23639, "verse_number": "१-२-२६-९५", "content_sanskrit": "ततो गते भगवति नीललोहिते सहोमया गिरिममलं हि भूधरः ।\nसबांधवो रुदिति हि कस्य नो मनो विसंष्ठंलं जगति हि कन्यकापितुः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003639095, "chapter_id": 23639, "verse_number": "१-२-२६-९६", "content_sanskrit": "इमं विवाहं गिरिराजपुत्र्याः श्रृणोति चाध्येति च यो नरः शुचिः ।\nविशेषतश्चापि विवाहमंगले स मंगलं वृद्धिमवाप्नुते चिरम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}]