[{"id": 50013299, "chapter_id": 11508, "verse_number": "1", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50013300, "chapter_id": 11508, "verse_number": "2", "content_sanskrit": "भक्तियोगस्य तत् सर्वमन्तरायतयाऽर्भकः। मन्यमानो हृषीकेशं स्मयमान उवाच ह॥ ७/१०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50013301, "chapter_id": 11508, "verse_number": "3", "content_sanskrit": "प्रह्लाद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50013302, "chapter_id": 11508, "verse_number": "4", "content_sanskrit": "मा मा प्रलोभयोत्पत्त्याऽऽसक्तं कामेषु तैर्वरैः। तत्सङ्गभीतो निर्विण्णो मुमुक्षुस्त्वामुपाश्रितः॥ ७/१०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50013303, "chapter_id": 11508, "verse_number": "5", "content_sanskrit": "भृत्यलक्षणजिज्ञासुर्भक्तं कामेषु चोदयात्। भवान् संसारबीजेषु हृदयग्रान्धषु प्रभो॥ ७/१०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50013304, "chapter_id": 11508, "verse_number": "6", "content_sanskrit": "नान्यथा तेऽखिलगुरोर्घटते करुणात्मनः। नष्टदृष्टेस्तमस्यन्धे त्वं पारः पारदर्शिनः॥ ७/१०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50013305, "chapter_id": 11508, "verse_number": "7", "content_sanskrit": "यस्त आशिष आशास्ते न स भृत्यः स वै वणिक्। स वै स्वामी स वै भृत्यो गुणलुब्धौ न कामुकौ॥ ७/१०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50013306, "chapter_id": 11508, "verse_number": "8", "content_sanskrit": "आशासानो न वै भृत्यः स्वामिन्याशिष आत्मनः। न स्वामी भृत्यतः स्वाम्यमिच्छन् यो राति चाशिषः॥ ७/१०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50013307, "chapter_id": 11508, "verse_number": "9", "content_sanskrit": "अहं त्वकामस्त्वद्भक्तस्त्वं स्वामी ह्यनपाश्रयः। नान्यथेहावयोरर्थो राजसेवकयोरिव॥ ७/१०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50013308, "chapter_id": 11508, "verse_number": "10", "content_sanskrit": "यदि रासीश मे कामान् वरान् त्वं वरदर्षभ। कामानां हृद्यसंरोहं भवतस्तु वृणे वरम्॥ ७/१०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50013309, "chapter_id": 11508, "verse_number": "11", "content_sanskrit": "इन्द्रियाणि मनः प्राणा आत्मा धर्मो धृतिर्मतिः। ह्रीः श्रीस्तेजः स्मृतिः सत्यं येषां नश्यन्ति जन्मना॥ ७/१०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50013310, "chapter_id": 11508, "verse_number": "12", "content_sanskrit": "विमुञ्चति यदा कामान् मानवो मनसि श्रितान्। तर्ह्येव पुण्डरीकाक्ष न भवायावकल्पने॥ ७/१०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50013311, "chapter_id": 11508, "verse_number": "13", "content_sanskrit": "ॐ नमो भगवते तुभ्यं पुरुषाय महात्मने। हरयेऽद्भुतसिंहाय ब्रह्मणे परमात्मने॥ ७/१०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50013312, "chapter_id": 11508, "verse_number": "14", "content_sanskrit": "श्रीनृसिंह उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50013313, "chapter_id": 11508, "verse_number": "15", "content_sanskrit": "नैकान्तिनो मे मयि जात्विहाशिष आशासतेऽमुत्र तथा भवादृशाः। तथापि मन्वन्तरमेतदत्र दैत्येश्वराणामनुभु(ॐ) भोगान्॥ ७/१०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50013314, "chapter_id": 11508, "verse_number": "16", "content_sanskrit": "कथा मदीया जुषमाणः प्रियास्त्वमावेश्य मामात्मनि सन्तमेकम्। सर्वेषु भूतेष्वधियज्ञमीश्वरं यजस्व योगेन च कर्म हिन्वन्॥ ७/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50013315, "chapter_id": 11508, "verse_number": "17", "content_sanskrit": "भोगेन पुण्यं कुशलेन पापं कळेबरं कालजवेन हित्वा। कीर्तिं विशुद्धां सुरलोकगीतां विताय मामेष्यसि मुक्तबन्धः॥ ७/१०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50013316, "chapter_id": 11508, "verse_number": "18", "content_sanskrit": "य एवं कीर्तयेन्मह्यं त्वया गीतमिदं नरः। त्वां च मां च स्मरन् काले कर्मबन्धाद् विमुच्यते॥ ७/१०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50013317, "chapter_id": 11508, "verse_number": "19", "content_sanskrit": "प्रह्लाद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50013318, "chapter_id": 11508, "verse_number": "20", "content_sanskrit": "वरं वरय एतत् ते वरदेशान्महेश्वर। यदनिन्दत् पिता मे त्वामविद्वांस्तेज ऐश्वरम्॥ ७/१०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50013319, "chapter_id": 11508, "verse_number": "21", "content_sanskrit": "बद्धामर्षाशयः साक्षात् सर्वलोकगुरुं प्रभुम्। भ्रातृहेति मृषादृष्टिस्त्वद्भक्ते मयि चाघवान्॥ ७/१०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50013320, "chapter_id": 11508, "verse_number": "22", "content_sanskrit": "तस्मात् पिता मे पूयेत दुरन्ताद् दुस्तरादघात्। पूतस्ते शान्तया दृष्ट्या दृष्टः कृपणवत्सल॥ ७/१०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 50013321, "chapter_id": 11508, "verse_number": "23", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 50013322, "chapter_id": 11508, "verse_number": "24", "content_sanskrit": "त्रिःसप्तभिः पिता पूतः पितृभिः सह तेऽनघ। यत् साधोऽस्य गृहे जातो भवान् वै कुलपावनः॥ ७/१०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 50013323, "chapter_id": 11508, "verse_number": "25", "content_sanskrit": "यत्रयत्र च मद्भक्ताः प्रशान्ताः समदर्शिनः। साधवः समुदाचारास्ते पूयन्तेऽपि काकटाः॥ ७/१०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 50013324, "chapter_id": 11508, "verse_number": "26", "content_sanskrit": "सर्वात्मना न हिंसन्ति भूतग्रामेषु किञ्चन। उच्चावचेषु दैत्येन्द्र मद्भावेन गतस्पृहाः॥ ७/१०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 50013325, "chapter_id": 11508, "verse_number": "27", "content_sanskrit": "भवन्ति पुरुषा लोके मद्भक्ता मामनुव्रताः। भवान् मे खलु भक्तानां सर्वेषां प्रतिरूपधृक्॥ ७/१०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 50013326, "chapter_id": 11508, "verse_number": "28", "content_sanskrit": "कुरु ते प्रेतकार्याणि पितुः पूतस्य सर्वशः। मदङ्गस्पर्शनेनाङ्ग लोकान् यास्यति सुप्रजाः॥ ७/१०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 50013327, "chapter_id": 11508, "verse_number": "29", "content_sanskrit": "पित्र्यं च स्थानमातिष्ठ यथोक्तं ब्रह्मवादिभिः। मय्यावेश्य मनस्तात कुरु कर्माणि मत्परः॥ ७/१०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 50013328, "chapter_id": 11508, "verse_number": "30", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 50013329, "chapter_id": 11508, "verse_number": "31", "content_sanskrit": "प्रह्लादोऽपि तथा चक्रे पितुर्यत् साम्परायिकम्। यथाऽऽह भगवान् राजन्नभिषिक्तो द्विजोत्तमैः॥ ७/१०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 50013330, "chapter_id": 11508, "verse_number": "32", "content_sanskrit": "प्रसादसुमुखं दृष्ट्वा ब्रह्मा नरहरिं हरिम्। स्तुत्वा वाग्भिः पवित्राभिः प्राह देवादिभिर्वृतः॥ ७/१०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 50013331, "chapter_id": 11508, "verse_number": "33", "content_sanskrit": "ब्रह्मोवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 50013332, "chapter_id": 11508, "verse_number": "34", "content_sanskrit": "देवदेवाखिलाध्यक्ष भूतभावन पूर्वज। दिष्ट्या ते निहतः पापो लोकसन्तापनोऽसुरः॥ ७/१०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 50013333, "chapter_id": 11508, "verse_number": "35", "content_sanskrit": "योऽसौ लब्धवरो मत्तो न वध्यो मम सृष्टिभिः। तपोयोगबलोन्नद्धः समस्तजनहानिदः॥ ७/१०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 50013334, "chapter_id": 11508, "verse_number": "36", "content_sanskrit": "दिष्ट्याऽस्य तनयः साधुर्महाभागवतोऽर्भकः। त्वया विमोचितो मृत्योर्दिष्ट्या तस्मै वरोऽधुना॥ ७/१०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 50013335, "chapter_id": 11508, "verse_number": "37", "content_sanskrit": "एतद् वपुस्ते भगवान् ध्यायतः प्रयतात्मनः। सर्वतो गोप्तृ सन्त्रासान्मृत्योरपि जिघांसतः॥ ७/१०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 50013336, "chapter_id": 11508, "verse_number": "38", "content_sanskrit": "श्रीभगवानुवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 50013337, "chapter_id": 11508, "verse_number": "39", "content_sanskrit": "मैवंविधोऽसुराणां ते प्रदेयः पद्मसम्भव। वरः क्रूरनिसर्गाणामहीनाममृतं यथा॥ ७/१०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 50013338, "chapter_id": 11508, "verse_number": "40", "content_sanskrit": "नारद उवाच", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 50013339, "chapter_id": 11508, "verse_number": "41", "content_sanskrit": "इत्युक्त्वा भगवान् राजन् ततश्चान्तर्दधे हरिः। अदृश्यः सर्वभूतानां पूजितः परमेष्ठिना॥ ७/१०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 50013340, "chapter_id": 11508, "verse_number": "42", "content_sanskrit": "ततः सम्पूज्य विधिवद् ववन्दे परमेष्ठिनम्। भवं प्रजापतीन् देवान् प्रह्लादो भगवत्कलाः॥ ७/१०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 50013341, "chapter_id": 11508, "verse_number": "43", "content_sanskrit": "ततः काव्यादिभिः साकं मुनिभिः कमलासनः। दैत्यानां दानवानां च प्रह्लादमकरोत् पतिम्॥ ७/१०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 50013342, "chapter_id": 11508, "verse_number": "44", "content_sanskrit": "प्रतिनन्द्य ततो देवाः प्रयुज्य परमाशिषः। स्वधामानि ययू राजन् ब्रह्माद्याः प्रतिपूजिताः॥ ७/१०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 50013343, "chapter_id": 11508, "verse_number": "45", "content_sanskrit": "एवं तौ पार्षदौ विष्णोः पुत्रत्वं प्रापितौ दितेः। हृदि स्थितेन हरिणा वैरभावेन तौ हतौ॥ ७/१०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 50013344, "chapter_id": 11508, "verse_number": "46", "content_sanskrit": "पुनस्तौ पूर्वशापेन राक्षसौ द्वौ बभूवतुः। कुम्भकर्णदशग्रीवौ हतौ तौ रामविक्रमैः॥ ७/१०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 50013345, "chapter_id": 11508, "verse_number": "47", "content_sanskrit": "शयानौ युधि निर्भिण्णहृदयौ रामसायकैः। तच्चित्तौ जहतुर्देहं यथा प्राक्तनजन्मनि॥ ७/१०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 50013346, "chapter_id": 11508, "verse_number": "48", "content_sanskrit": "ताविहापि पुनर्जातौ शिशुपालकरूशकौ। हतौ वैरानुबन्धेन पश्यतस्ते समीयतुः॥ ७/१०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 50013347, "chapter_id": 11508, "verse_number": "49", "content_sanskrit": "एनः पूर्वकृतं यत् तद् राजानः कृष्णवैरिणः। जहुस्तेऽन्ते तदात्मानः कीटाः पेशस्कृतो यथा॥ ७/१०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 50013348, "chapter_id": 11508, "verse_number": "50", "content_sanskrit": "यथायथा भागवता भक्त्या परमया भिदाम्। नृपाश्चैद्यादयः साम्यं हरेस्तच्चिन्तया ययुः॥ ७/१०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 50013349, "chapter_id": 11508, "verse_number": "51", "content_sanskrit": "आख्यातं सर्वमेतत् ते यन्मां त्वं परिपृष्टवान्। दमघोषसुतादीनां हरेः साम्यमपि द्विषाम्॥ ७/१०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 50013350, "chapter_id": 11508, "verse_number": "52", "content_sanskrit": "एषा ब्रह्मण्यदेवस्य कृष्णस्य च महात्मनः। अवतारकथा पुण्या वधो यत्रादिदैत्ययोः॥ ७/१०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 50013351, "chapter_id": 11508, "verse_number": "53", "content_sanskrit": "प्रह्लादस्यानुचरितं महाभागवतस्य च। भक्तिर्ज्ञानं विरक्तिश्च याथात्म्यं चास्य वै हरेः॥ ७/१०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 50013352, "chapter_id": 11508, "verse_number": "54", "content_sanskrit": "सर्गस्थित्यप्ययेशस्य गुणकर्मानुवर्णनम्। परावरेषां स्थानानां कालेनाव्यत्ययो महान्॥ ७/१०/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 50013353, "chapter_id": 11508, "verse_number": "55", "content_sanskrit": "धर्मो भागवतानां च भगवान् येन गम्यते। आख्यानेऽस्मिन् समाख्यातमाध्यात्मिकमशेषतः॥ ७/१०/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 50013354, "chapter_id": 11508, "verse_number": "56", "content_sanskrit": "एतद् य आद्यपुरुषस्य मृगेन्द्रलीलां दैत्येन्द्रयूथपवधं प्रयतः पठेत। दैत्यात्मजस्य च सतां प्रवरस्य पुण्यं श्रुत्वाऽनुभावमकुतोभयमेति लोकम्॥ ७/१०/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 50013355, "chapter_id": 11508, "verse_number": "57", "content_sanskrit": "यूयं नृलोके बत भूरिभागा लोकं पुनाना मुनयोऽतियाथ। येषां गृहानावसतीति साक्षाद् गूढं परं ब्रह्म मनुष्यलिङ्गम्॥ ७/१०/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 50013356, "chapter_id": 11508, "verse_number": "58", "content_sanskrit": "स वा अयं ब्रह्म महद् विमृग्यं कैवल्यनिर्वाणसुखानुभूतिः। प्रियः सुहृद् वः खलु मातुलेय आत्माऽर्हणीयो विधिकृद् गुरुश्च॥ ७/१०/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 50013357, "chapter_id": 11508, "verse_number": "59", "content_sanskrit": "न यस्य साक्षाद् भवपद्मजादिभी रूपं धिया वस्तुतयाऽनुवर्णितम्। मौनेन भक्त्योपशमेन पूजितः प्रसीदतामेष स सात्वतां पतिः॥ ७/१०/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 50013358, "chapter_id": 11508, "verse_number": "60", "content_sanskrit": "इति श्रीमद्भागवते सप्तमस्कन्धे दशमोऽध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]