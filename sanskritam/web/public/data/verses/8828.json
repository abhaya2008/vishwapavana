[{"id": 40001384, "chapter_id": 8828, "verse_number": "1", "content_sanskrit": "हतेषु तेषु पुत्रेषु दिति: परमदु:खिता। मारीचं काश्यपं राम भर्तारमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40001385, "chapter_id": 8828, "verse_number": "2", "content_sanskrit": "हतपुत्राऽस्मि भगवंस्तव पुत्रैर्महाबलै:। शक्रहन्तारमिच्छामि पुत्रं दीर्घतपोऽर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40001386, "chapter_id": 8828, "verse_number": "3", "content_sanskrit": "साऽहं तपश्चरिष्यामि गर्भं मे दातुमर्हसि। ईश्वरं शक्रहन्तारं त्वमनुज्ञातुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40001387, "chapter_id": 8828, "verse_number": "4", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा मारीच: काश्यपस्तदा। प्रत्युवाच महातेजा दितिं परमदु:खिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40001388, "chapter_id": 8828, "verse_number": "5", "content_sanskrit": "एवं भवतु, भद्रं ते शुचिर्भव तपोधने। जनयिष्यसि पुत्रं त्वं शक्रहन्तारमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40001389, "chapter_id": 8828, "verse_number": "6", "content_sanskrit": "पूर्णे वर्षसहस्रे तु शुचिर्यदि भविष्यसि। पुत्रं त्रैलोक्यभर्तारं मत्तस्त्वं जनयिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40001390, "chapter_id": 8828, "verse_number": "7", "content_sanskrit": "एवमुक्त्वा महातेजा: पाणिना स ममार्ज ताम्। समालभ्य ततस्स्वस्तीत्युक्त्वा स तपसे ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40001391, "chapter_id": 8828, "verse_number": "8", "content_sanskrit": "गते तस्मिन्नरश्श्रेष्ठ दिति: परमहर्षिता। कुशप्लवनमासाद्य तपस्तेपे सुदारुणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40001392, "chapter_id": 8828, "verse_number": "9", "content_sanskrit": "तपस्तस्यां हि कुर्वन्त्यां परिचर्यां चकार ह। सहस्राक्षो नरश्श्रेष्ठ परया गुणसम्पदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40001393, "chapter_id": 8828, "verse_number": "10", "content_sanskrit": "अग्निं कुशान् काष्ठमप: फलं मूलं तथैव च। न्यवेदयत्सहस्राक्षो यच्चान्यदपि काङ्क्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40001394, "chapter_id": 8828, "verse_number": "11", "content_sanskrit": "गात्रसंवहनश्चैव श्रमापनयनैस्तथा। शक्रस्सर्वेषु कालेषु दितिं परिचचार ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40001395, "chapter_id": 8828, "verse_number": "12", "content_sanskrit": "अथ वर्षसहस्रे तु दशोने रघुनन्दन । दिति: परमसम्प्रीता सहस्राक्षमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40001396, "chapter_id": 8828, "verse_number": "13", "content_sanskrit": "याचितेन सुरश्रेष्ठ तव पित्रा महात्मना। वरो वर्षसहस्रान्ते दत्तो मम सुतं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40001397, "chapter_id": 8828, "verse_number": "14", "content_sanskrit": "तपश्चरन्त्या वर्षाणि दश वीर्यवतां वर। अवशिष्टानि भद्रं ते भ्रातरं द्रक्ष्यसे तत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40001398, "chapter_id": 8828, "verse_number": "15", "content_sanskrit": "तमहं त्वत्कृते पुत्र समाधास्ये जयोत्सुकम्। त्रैलोक्यविजयं पुत्र सह भोक्ष्यसि विज्वर: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40001399, "chapter_id": 8828, "verse_number": "16", "content_sanskrit": "एवमुक्त्वा दितिश्शक्रं प्राप्ते मध्यं दिवाकरे। निद्रयाऽपहृता देवी पादौ कृत्वाऽथ शीर्षत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40001400, "chapter_id": 8828, "verse_number": "17", "content_sanskrit": "दृष्ट्वा तामशुचिं शक्र: पादत: कृतमूर्धजाम्। शिरस्स्थाने कृतौ पादौ जहास च मुमोद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40001401, "chapter_id": 8828, "verse_number": "18", "content_sanskrit": "तस्याश्शरीरविवरं विवेश च पुरन्दर:। गर्भं च सप्तधा राम बिभेद परमात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40001402, "chapter_id": 8828, "verse_number": "19", "content_sanskrit": "भिद्यमानस्ततो गर्भो वज्रेण शतपर्वणा। रुरोद सुस्वरं राम ततो दितिरबुध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40001403, "chapter_id": 8828, "verse_number": "20", "content_sanskrit": "मा रुदो मा रुदश्चेति गर्भं शक्रोऽभ्यभाषत। बिभेद च महातेजा रुदन्तमपि वासव: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40001404, "chapter_id": 8828, "verse_number": "21", "content_sanskrit": "न हन्तव्यो न हन्तव्य इत्येवं दितिरब्रवीत्। निष्पपात ततश्शक्रो मातुर्वचनगौरवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40001405, "chapter_id": 8828, "verse_number": "22", "content_sanskrit": "प्राञ्जलिर्वज्रसहितो दितिं शक्रोऽभ्यभाषत। अशुचिर्देवि सुप्ताऽसि पादयो: कृतमूर्धजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40001406, "chapter_id": 8828, "verse_number": "23", "content_sanskrit": "तदन्तरमहं लब्ध्वा शक्रहन्तारमाहवे। अभिदं सप्तधा देवि तन्मे त्वं क्षन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]