[{"id": 7004978000, "chapter_id": 24978, "verse_number": "७-१-१६१-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि तस्य दक्षिणतः स्थितम् ।\nईशाने लक्ष्मणेशाच्च धनुषां षोडशे प्रिये ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004978001, "chapter_id": 24978, "verse_number": "७-१-१६१-२", "content_sanskrit": "अनन्तेश्वरनामानमनन्तेन प्रतिष्ठितम् ।\nनागराजेन देवेशि ज्ञात्वा क्षेत्रं तु पावनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004978002, "chapter_id": 24978, "verse_number": "७-१-१६१-३", "content_sanskrit": "यस्तु तं पूजयेद्देवि पंचम्यां फाल्गुने सिते ।\nपञ्चोपचारविधिना जिताहारो जितेन्द्रियः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004978003, "chapter_id": 24978, "verse_number": "७-१-१६१-४", "content_sanskrit": "न तं दशंति फणिनो दश वर्षाणि पंच च ।\nविषं न क्रमते देवि देहे त्वचरमेव वा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004978004, "chapter_id": 24978, "verse_number": "७-१-१६१-५", "content_sanskrit": "तस्मात्तं पूजयेद्यत्नात्पंचम्यां च विशेषतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004978005, "chapter_id": 24978, "verse_number": "७-१-१६१-६", "content_sanskrit": "तत्रानंतव्रतं कार्यं मधुपायससंयुतम् ।\nपायसं मधुसंयुक्तं देयं विप्राय भोजनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004978006, "chapter_id": 24978, "verse_number": "७-१-१६१-७", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्येऽनन्तेश्वरमाहात्म्यवर्णनंनामैकषष्ट्युत्तरशततमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]