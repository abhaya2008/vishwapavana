[{"id": 2141668, "chapter_id": 4055, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2141669, "chapter_id": 4055, "verse_number": "१", "content_sanskrit": "तांस्तान् विजित्य सङ्ग्रामे कुरूणां मिषतां वने ।\nततो युद्धमनाः पार्थः प्रायात् पञ्च रथान् प्रति\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2141670, "chapter_id": 4055, "verse_number": "२", "content_sanskrit": "आददानश्च नाराचान् विमृशन्निषुधी अपि ।\nसंस्पृशानश्च गाण्डीवं भूयः कर्णं समभ्ययात्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2141671, "chapter_id": 4055, "verse_number": "", "content_sanskrit": "अश्वत्थामा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2141672, "chapter_id": 4055, "verse_number": "३", "content_sanskrit": "कर्ण यत् तत् सभामध्ये बह्वबद्धं प्रभाषसे ।\nन मे युधि समोऽस्तीति तदिदं समुपस्थितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2141673, "chapter_id": 4055, "verse_number": "४", "content_sanskrit": "एषोऽन्तकसमः क्रुद्धः सर्वभूतावमर्दनः ।\nअदूरात् प्रत्युपस्थाय जृम्भते केसरी यथा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2141674, "chapter_id": 4055, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2141675, "chapter_id": 4055, "verse_number": "५", "content_sanskrit": "नाहं बिभेमि बीभत्सोः कृष्णाद्वा देवकीसुतात् ।\nपाण्डवेभ्योऽपि सर्वेभ्यः क्षत्रधर्ममनुव्रतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2141676, "chapter_id": 4055, "verse_number": "६", "content_sanskrit": "सत्वाधिकानां पुंसां तु धनुर्वेदोपजीविनाम् ।\nगर्जनाज्जायते दर्पः स्वरश्च न विषीदति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141677, "chapter_id": 4055, "verse_number": "७", "content_sanskrit": "पश्यत्वाचार्यपुत्रो मामर्जुनेन रणे सह ।\nयुध्यमानं सुसंयत्तं दैवं तु दुरतिक्रमम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141678, "chapter_id": 4055, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141679, "chapter_id": 4055, "verse_number": "८", "content_sanskrit": "तं समन्ताद् रथाः पञ्च परिवार्य धनञ्जयम् ।\nत इषून् सम्यगस्यन्तो मुमुक्षन्तोऽपि जीवितम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141680, "chapter_id": 4055, "verse_number": "९", "content_sanskrit": "ते लाभमिव मन्वानाः क्षिप्रमार्छन् धनञ्जयम् ।\nशरौघान् सम्यगस्यन्तो जीमूता इव वार्षिकाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141681, "chapter_id": 4055, "verse_number": "१०", "content_sanskrit": "बहुभिर्निशितैर्बाणैर्विविधैर्लोमवापिभिः ।\nदुर्द्रवाः प्रत्यवस्थाय प्रत्यविध्यन् धनञ्जयम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141682, "chapter_id": 4055, "verse_number": "११", "content_sanskrit": "ततः प्रहस्य बीभत्सुः सर्वशस्त्रभृतां वरः ।\nदिव्यमस्त्रं विकुर्वाणः प्रत्ययाद् रथसत्तमान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141683, "chapter_id": 4055, "verse_number": "१२", "content_sanskrit": "यथा रश्मिभिरादित्यः प्रच्छादयति मेदिनीम् ।\nएवं गाण्डीवनिर्मुक्तैः शरैः प्राच्छादयद् दिशः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141684, "chapter_id": 4055, "verse_number": "१३", "content_sanskrit": "न रथानां न चाश्वानां न ध्वजानां न दन्तिनाम् ।\nअविद्धं निशितैर्बाणैरासीद् द्व्यङ्गुलमन्तरम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141685, "chapter_id": 4055, "verse_number": "१४", "content_sanskrit": "सर्वे शान्तिपरा योधाः स्वचित्तं नाभिजज्ञिरे ।\nहस्त्यश्वाश्चापि वित्रस्ता व्यवधीयन्त सर्वशः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141686, "chapter_id": 4055, "verse_number": "१५", "content_sanskrit": "यथा नळवनं नागः प्रभिन्नः षष्टिहायनः ।\nएवं सर्वानपामृद्नादर्जुनः शस्त्रतेजसा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141687, "chapter_id": 4055, "verse_number": "१६", "content_sanskrit": "गाण्डीवस्य च घोषेण पृथिवी समकम्पत ।\nमनांसि धार्तराष्ट्राणामप्यकृन्तद् धनञ्जयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141688, "chapter_id": 4055, "verse_number": "१७", "content_sanskrit": "ततो विगाह्य सैन्यानां मध्यं शस्त्रभृतां वरः ।\nसारथिं समरे शूरमभ्यभाषत वीर्यवान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141689, "chapter_id": 4055, "verse_number": "१८", "content_sanskrit": "सन्नियम्य हयानेतान् मन्दं वाहय सारथे ।\nआचार्यपुत्रं समरे योधयिष्यामि मानिनम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141690, "chapter_id": 4055, "verse_number": "१९", "content_sanskrit": "पुरा ह्येष न मे शब्दः साधीभवति पृष्ठतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141691, "chapter_id": 4055, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141692, "chapter_id": 4055, "verse_number": "२०", "content_sanskrit": "एवमुक्तोऽर्जुनेनासावश्वत्थामरथं प्रति ।\nविराटपुत्रो जवनान् भृशमश्वानचोदयत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2141693, "chapter_id": 4055, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2141694, "chapter_id": 4055, "verse_number": "२१", "content_sanskrit": "एषोऽपयाति बीभत्सुर्व्यथितो गाढवेदनः ।\nतं तु तत्रैव योत्स्यामि नायं मुच्येत जीवितात्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2141695, "chapter_id": 4055, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2141696, "chapter_id": 4055, "verse_number": "२२", "content_sanskrit": "नैषोऽभयं न निर्यातो महात्मा पाकशासनिः ।\nनैवं भीतो निवर्तेत न पुनर्गाढवेदनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2141697, "chapter_id": 4055, "verse_number": "२३", "content_sanskrit": "यद्येनमभिसङ्क्रुद्धं पुनरेवाभियास्यति ।\nबहून्यस्त्राणि जानीते न पुनर्मोक्ष्यते भवान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2141698, "chapter_id": 4055, "verse_number": "२४", "content_sanskrit": "दिष्ट्या दुर्योधनो मुक्तो गावः सर्वाः पलायिताः ।\nमुक्तं मुक्त्वैव सङ्ग्रामे किं रणेन करिष्यसि\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2141699, "chapter_id": 4055, "verse_number": "२५", "content_sanskrit": "क्रोशमात्रमतिक्रम्य बलमन्वानयामहे ।\nअन्वागतबलाः पार्थं पुनरेवाभियास्यथ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2141700, "chapter_id": 4055, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि त्रिषष्टितमोऽध्यायः ॥६३॥ गोग्रहणपर्वणि षट्त्रिंशोऽध्यायः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]