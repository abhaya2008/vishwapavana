[{"id": 7002242000, "chapter_id": 22242, "verse_number": "२८७-१", "content_sanskrit": "पालकाप्य उवाच ।\nगजलक्षअम चिकित्साञ्च लोमपाद वदामि ते ।\nदीर्घहस्ता महोच्छ्वासाः प्रशस्तास्ते सहिष्णवः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002242001, "chapter_id": 22242, "verse_number": "२८७-२", "content_sanskrit": "विंशत्यष्टादशनखाः शीतकालमदाश्च ये ।\nदक्षिणञ्चोन्नतन्दन्तं वृंहितं जलदोपमं ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002242002, "chapter_id": 22242, "verse_number": "२८७-३", "content_sanskrit": "कर्णौ च विपुलौ येषां सूक्ष्मविन्द्वन्वितत्वचौ ।\nते धार्य्या न तथा धार्य्या वामना ये च सङ्कुशाः२ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002242003, "chapter_id": 22242, "verse_number": "२८७-४", "content_sanskrit": "हस्तिन्यः पार्श्वगर्भिण्यो ये च मूढा मतङ्गजाः ।\nवर्णं सत्वं बलं रूपं कान्तिः संहननञ्जवः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002242004, "chapter_id": 22242, "verse_number": "२८७-५", "content_sanskrit": "सप्तस्थितो गजश्वेदृक् सङ्ग्रामेरीञ्जयेत्स च ।\nकुञ्जराः परमा शोभा शिविरस्य बलस्य च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002242005, "chapter_id": 22242, "verse_number": "२८७-६", "content_sanskrit": "आयत्तं कुञ्जरैश्चैव विजयं पृथिवीक्षितां ।\nपाकलेषु च सर्वेषु कर्त्तव्यमनुवासनं ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002242006, "chapter_id": 22242, "verse_number": "२८७-७", "content_sanskrit": "घृततैलपरीपाकं स्थानं वातविवर्जितं ।\nस्कन्धेषु च क्रिया कार्य्या तथा पालकवन्नृपाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002242007, "chapter_id": 22242, "verse_number": "२८७-८", "content_sanskrit": "गोमूत्रं पाण्डुरोगेषु रजनीभ्यां घृतन्द्विज ।\nआनाहे तैलसिक्तस्य निषेकस्तस्य शस्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002242008, "chapter_id": 22242, "verse_number": "२८७-९", "content_sanskrit": "लवणैः पञ्चभिर्म्मिश्रा प्रतिपानाय वारुणी ।\nविडङ्गत्रिफलाव्योषसैन्धवैः कवलान् कृतान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002242009, "chapter_id": 22242, "verse_number": "२८७-१०", "content_sanskrit": "मृर्च्छासु भोजयेन्नागं क्षौद्रन्तोयञ्च पाययेत् ।\nअब्यङ्ग शिरसः शुले नस्यञ्चैव प्रशस्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002242010, "chapter_id": 22242, "verse_number": "२८७-११", "content_sanskrit": "नागानां स्नेहपुटकः पादरोगानुपक्रमेत् ।\nपश्चात् कल्ककषायेण शोधनञ्च विधीयते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002242011, "chapter_id": 22242, "verse_number": "२८७-१२", "content_sanskrit": "शिखितित्तिरिलावानां पिप्पलीमरिचान्वितैः ।\nरसैः सम्भोज्येन्नागं वेपथुर्यस्य जायते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002242012, "chapter_id": 22242, "verse_number": "२८७-१३", "content_sanskrit": "बालविल्वं तथा लोध्रं धातकी सितया सह ।\nअतीसारविनाशाय पिण्डीं भुञ्जीत कुञ्जरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002242013, "chapter_id": 22242, "verse_number": "२८७-१४", "content_sanskrit": "नस्यं करग्रहे देयं घृतं लवणसंयुतम् ।\nमागधीनागराजाजीयवागूर्मुस्तसाधिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002242014, "chapter_id": 22242, "verse_number": "२८७-१५", "content_sanskrit": "उत्कर्णके तु दातव्या वारहञ्च तथा रसम् ।\nदशमूलकुलत्थाम्लकाकमाचीविपाचितम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002242015, "chapter_id": 22242, "verse_number": "२८७-१६", "content_sanskrit": "तैलमूषणसंयुक्तं गलग्रहगदापहम् ।\nअष्टभिर्लवणैः पिष्टैः प्रसन्नाः पाययेद्घृतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002242016, "chapter_id": 22242, "verse_number": "२८७-१७", "content_sanskrit": "मूत्रभङ्गेऽथ वा वीजं क्कथितं त्रपूषस्य च ।\nत्वग्दोषेषु पिवेन्निम्बं वृषं वा क्कथितं द्विपः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002242017, "chapter_id": 22242, "verse_number": "२८७-१८", "content_sanskrit": "गवां मूत्रं विड़ङ्गानि कृमिकोष्ठेषु शस्यते ।\nश्रृङ्गवेरकणाद्राक्षाशर्कराभिः श्रृतं पयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002242018, "chapter_id": 22242, "verse_number": "२८७-१९", "content_sanskrit": "क्षतक्षयकरं पानं तथा मांसरसः शुभः ।\nमुद्गोदनं व्योषयुतमरुचौ तु प्रशस्यते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002242019, "chapter_id": 22242, "verse_number": "२८७-२०", "content_sanskrit": "त्रिवृद्व्योषाग्निदन्त्यर्कश्यामाक्षीरे भपिप्पली ।\nएतैर्गुल्महरः स्नेहः कृतश्चैव तथापरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002242020, "chapter_id": 22242, "verse_number": "२८७-२१", "content_sanskrit": "भेदनद्रावणाभ्यङ्गस्नेहपानानुवासनैः ।\nसर्वानेव समुत्पन्नान् विद्रवान् समुपाहरेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002242021, "chapter_id": 22242, "verse_number": "२८७-२२", "content_sanskrit": "यष्टिकं मुद्गसूपेन शारदेन तथा पिवेत् ।\nबालविल्वैस्तथा लेपः कटुरोगेषु शस्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002242022, "chapter_id": 22242, "verse_number": "२८७-२३", "content_sanskrit": "विडङ्गेन्द्रयवौ हिङ्गु सरलं रजनीद्वयम् ।\nपूर्वाह्णे पाययेत् पिण्डात् पिण्डान् सर्वशूलोपशान्तये ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002242023, "chapter_id": 22242, "verse_number": "२८७-२४", "content_sanskrit": "प्रधानभोजने तेषां यष्टिकब्रीहिशालयः ।\nमध्यमौ यवगोधूमौ यवगोधूमौ शेषा दन्तिनि चाधमाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002242024, "chapter_id": 22242, "verse_number": "२८७-२५", "content_sanskrit": "यवश्चैव तथैवेक्षुर्नागानां बलवर्द्धनः ।\nनागानां यवसं शुष्कं तथा धातुप्रकोपणं ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002242025, "chapter_id": 22242, "verse_number": "२८७-२६", "content_sanskrit": "मदक्षीणस्य नागस्य पयःपानं प्रशस्यते ।\nदीपनीयैस्तथा द्रव्यैः श्रृतो मांसरसः शुभः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002242026, "chapter_id": 22242, "verse_number": "२८७-२७", "content_sanskrit": "चायसः कुक्कुरश्चोभौ काकोलूककुलो हरिः ।\nभवेत् क्षौद्रेण संयुक्तः पिण्डो युद्धे महापदि४ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002242027, "chapter_id": 22242, "verse_number": "२८७-२८", "content_sanskrit": "कटुमत्स्यविड़ङ्गानि क्षारः कोषातकी पयः ।\nहरिद्राचेति धूपोयं कुञ्जरस्य जयावहः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002242028, "chapter_id": 22242, "verse_number": "२८७-२९", "content_sanskrit": "पिप्पलीतण्डुलास्तैलं माध्वीकं माक्षैकम् तथा ।\nनेत्रयोः परिषेकोयं दीपनीयः प्रशस्यते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002242029, "chapter_id": 22242, "verse_number": "२८७-३०", "content_sanskrit": "पुरीषञ्जतनेत्रस्तु तथा पारावतस्य च ।\nक्षीरवृक्षकरीषाश्च प्रसन्नायेष्टमञ्जनं ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002242030, "chapter_id": 22242, "verse_number": "२८७-३१", "content_sanskrit": "अनेनाञ्जिनेत्रस्तु करोति कदनं रणे ।\nउत्पलानि च नीलानि सुस्तन्तगरमेव च ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002242031, "chapter_id": 22242, "verse_number": "२८७-३२", "content_sanskrit": "तण्डुलोदकपिष्टानि नेत्रनिर्वापनं परम् ।\nनखवृद्धौ नखच्छेदस्तैलसेकश्च मास्यपि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002242032, "chapter_id": 22242, "verse_number": "२८७-३३", "content_sanskrit": "शय्यास्थानं भवेच्चास्य करीषैः पांशुभिस्तथा ।\nशरन्निदाघयोः सेकः सर्पिषा च तथेष्यते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]