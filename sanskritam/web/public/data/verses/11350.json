[{"id": 50006419, "chapter_id": 11350, "verse_number": "1", "content_sanskrit": "[न्यायमाला (अनुव्याख्याने ४-२-१२६-७)- सुशक्यता शश्वदतिप्रसिद्धिर्विवेकविन्यासविचारसञ्ज्ञाः। नानाप्रवृत्तिः कृतकृत्यता च विपक्षतर्काः समतीतपादे॥ महाफलत्वं प्रविविक्तता च सन्धिग्रहः साधनमाप्तकृत्यम्। विशेषकार्यं कृतसंस्थितिश्च सुयुक्तयो निर्णयगाः स्वपक्षे॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50006420, "chapter_id": 11350, "verse_number": "2", "content_sanskrit": "॥ ॐ आवृत्तिरसकृदुपदेशात् ॐ॥ सुशक्यता। महाफलत्वम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50006421, "chapter_id": 11350, "verse_number": "3", "content_sanskrit": "॥ ॐ आत्मेति तूपगच्छन्ति ग्राहयन्ति च ॐ॥ शस्वदतिप्रसिद्धिः। प्रविविक्तता॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50006422, "chapter_id": 11350, "verse_number": "4", "content_sanskrit": "॥ ॐ न प्रतीके नहि सः ॐ॥ विवेकः। सन्धिग्रहः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50006423, "chapter_id": 11350, "verse_number": "5", "content_sanskrit": "॥ ॐ ब्रह्मदृष्टिरुत्कर्षात् ॐ॥ विन्यासः साधनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50006424, "chapter_id": 11350, "verse_number": "6", "content_sanskrit": "॥ ॐ आदित्यादिमतयश्चाङ्ग उपपत्तेः ॐ॥ विचारः। आप्तकृत्यम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50006425, "chapter_id": 11350, "verse_number": "7", "content_sanskrit": "॥ ॐ आसीनः सम्भवात् ॐ॥ सञ्ज्ञा। विशेषकार्यम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50006426, "chapter_id": 11350, "verse_number": "8", "content_sanskrit": "॥ ॐ आ प्रायणात् तत्रापि हि दृष्टम् ॐ॥ नानाप्रवृत्तिः। विशेषकार्यम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50006427, "chapter_id": 11350, "verse_number": "9", "content_sanskrit": "॥ ॐ तदधिगम उत्तरपूर्वाघयोरश्लेषविनाशौ तद्व्यपदेशात् ॐ॥ कृतकृत्यता। कृतसंस्थितिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]