[{"id": 2050994, "chapter_id": 2120, "verse_number": "७-४७-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2050995, "chapter_id": 2120, "verse_number": "७-४७-१", "content_sanskrit": "तथा प्रविष्टं तरुणं सौभद्रमपराजितम्।\nकुलानुरूपं कुर्वाणं सङ्ग्रामेष्वपराजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2050996, "chapter_id": 2120, "verse_number": "७-४७-२", "content_sanskrit": "आजानेयैः सुबलिभिर्यान्तमश्वैस्त्रिहायनैः।\nप्लवमानमिवाकाशे के शूराः समवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2050997, "chapter_id": 2120, "verse_number": "७-४७-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2050998, "chapter_id": 2120, "verse_number": "७-४७-३", "content_sanskrit": "अभिमन्युः प्रविश्यैतांस्तावकान्निशितैः शरैः।\nअकरोत्पार्थिवान्सर्वान्विमुखान्पाण्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2050999, "chapter_id": 2120, "verse_number": "७-४७-४", "content_sanskrit": "तं तु द्रोणः कृपः कर्णो द्रौणिश्च सबृहद्बलः।\nकृतवर्मा च हार्दिक्यः षड्रथाः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2051000, "chapter_id": 2120, "verse_number": "७-४७-५", "content_sanskrit": "दृष्ट्वा तु सैन्धवे भारमतिमात्रं समाहितम्।\nसैन्यं तव महाराज युधिष्ठिरमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2051001, "chapter_id": 2120, "verse_number": "७-४७-६", "content_sanskrit": "सौभद्रमितरे वीरमभ्यवर्षञ्शराम्बुभिः।\nतालमात्राणि चापानि विकर्षन्तो महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2051002, "chapter_id": 2120, "verse_number": "७-४७-७", "content_sanskrit": "तांस्तु सर्वान्महेष्वासान्सर्वविद्यासु निष्ठितान्।\nव्यदृष्टम्भयद्रणे बाणैः सौभद्रः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2051003, "chapter_id": 2120, "verse_number": "७-४७-८", "content_sanskrit": "द्रोणं पञ्चाशताविध्यद्विंशत्या च बृहद्बलम्।\nअशीत्या कृतवर्माणं कृपं षष्ट्या शिलीमुखैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2051004, "chapter_id": 2120, "verse_number": "७-४७-९", "content_sanskrit": "रुक्मपुङ्खैर्महावेगैराकर्णसमचोदितैः।\nअविध्यद्दशभिर्बाणैरश्वत्थामानमार्जुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2051005, "chapter_id": 2120, "verse_number": "७-४७-१०", "content_sanskrit": "कर्णं च कर्णिना कर्णे पीतेन च शितेन च।\nफाल्गुनिर्द्विषतां मध्ये विव्याध परमेषुणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2051006, "chapter_id": 2120, "verse_number": "७-४७-११", "content_sanskrit": "पातयित्वा कृपस्याश्वांस्तथोभौ पार्ष्णिसारथी।\nअथैनं दशभिर्बाणैः प्रत्यविध्यत्स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2051007, "chapter_id": 2120, "verse_number": "७-४७-१२", "content_sanskrit": "ततो बृन्दारकं वीरं कुरूणां कीर्तिवर्धनम्।\nपुत्राणां तव वीराणां पश्यतामवधीद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2051008, "chapter_id": 2120, "verse_number": "७-४७-१३", "content_sanskrit": "तं द्रौणिः पञ्चविंशत्या क्षुद्रकाणां समार्पयत्।\nवरंवरममित्राणामारुजन्तमभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2051009, "chapter_id": 2120, "verse_number": "७-४७-१४", "content_sanskrit": "स तु बाणैः शितैस्तूर्णं प्रत्यविध्यत मारिष।\nपश्यतां धार्तराष्ट्राणामश्वत्थामानमार्जुनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2051010, "chapter_id": 2120, "verse_number": "७-४७-१५", "content_sanskrit": "षष्ट्या शराणां तं द्रौणिस्तिग्मधारैः सुतेजनैः।\nउग्रैर्नाकम्पयद्विद्ध्वा मैनाकमिव पर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2051011, "chapter_id": 2120, "verse_number": "७-४७-१६", "content_sanskrit": "स तु द्रौणिं त्रिसप्तत्या हेमपुङ्घैरजिह्मगैः।\nप्रत्यविध्यन्महातेजा बलवानपकारिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2051012, "chapter_id": 2120, "verse_number": "७-४७-१७", "content_sanskrit": "तस्मिन्द्रोणो बाणशतं पुत्रगृद्धी न्यपातयत्।\nअश्वत्थामा तथाऽष्टौ च परीप्सन्पितरं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2051013, "chapter_id": 2120, "verse_number": "७-४७-१८", "content_sanskrit": "कर्णो द्वाविंशतिं भल्लान्कृतवर्मा च विंशतिम्।\nबृहद्बलस्तु पञ्चाशत्कृपः शारद्वतो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2051014, "chapter_id": 2120, "verse_number": "७-४७-१९", "content_sanskrit": "तांस्तु प्रत्यवधीत्सर्वान्दशभिर्दशभिः शरैः।\nतैरर्द्यमानः सौभद्रः सर्वतो निशितैः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2051015, "chapter_id": 2120, "verse_number": "७-४७-२०", "content_sanskrit": "तं कोसलानामधिपः कर्णिनाऽताडयद्धृदि।\nस तस्याश्वान्ध्वजं चापं सूतं चापातयत्क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2051016, "chapter_id": 2120, "verse_number": "७-४७-२१", "content_sanskrit": "अथ कोसलराजस्तु विरथः खङ्ग्रचर्मधृत्।\nइयेष फाल्गुनेः कायाच्छिरो हर्तुं सकुण्डलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2051017, "chapter_id": 2120, "verse_number": "७-४७-२२", "content_sanskrit": "स कोसलानामधिपं राजपुत्रं बृहद्बलम्।\nहृदि विव्याध वाणेन स भिन्नहृदयोऽपतत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2051018, "chapter_id": 2120, "verse_number": "७-४७-२३", "content_sanskrit": "बभञ्ज च सहस्राणि दश राज्ञां महात्मनाम्।\nसृजतामशिवा वाचः खङ्गकार्मुकधारिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2051019, "chapter_id": 2120, "verse_number": "७-४७-२४", "content_sanskrit": "तथा बृहद्बलं हत्वा सौभद्रो व्यचरद्रणे।\nव्यष्टम्भयन्महेष्वासो योधांस्तव शराम्बुभिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2051020, "chapter_id": 2120, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि अभिमन्युवधपर्वणि त्रोयदशदिवसयुद्धे सप्तचत्वारिंशोऽध्यायः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]