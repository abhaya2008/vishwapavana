[{"id": 2108520, "chapter_id": 3350, "verse_number": "", "content_sanskrit": "गरुडः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2108521, "chapter_id": 3350, "verse_number": "१", "content_sanskrit": "इत्येवमुक्तो गरुडः प्रत्युवाच शचीपतिम् ।\nसख्यं मेऽस्तु त्वया देव यथेच्छसि पुरन्दर \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2108522, "chapter_id": 3350, "verse_number": "२", "content_sanskrit": "बलं तु मम जानीहि महच्चानन्त्यमेव च ।\nकामं नैव प्रशंसन्ति सन्तः स्वगुणसंस्तवम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2108523, "chapter_id": 3350, "verse_number": "३", "content_sanskrit": "गुणसङ्कीर्तनं चापि स्वयमेव शतक्रतो ।\nसखेति कृत्वा तु सखे पृष्टो वक्ष्याम्यहं त्वया\t ॥ ३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2108524, "chapter_id": 3350, "verse_number": "४", "content_sanskrit": "न ह्यात्मस्तवसंयुक्तं वक्तव्यमनिमित्ततः ।\nसपर्वतवनामुर्वीं ससागरनदीमिमाम्\t ॥ ४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2108525, "chapter_id": 3350, "verse_number": "५", "content_sanskrit": "पक्षेणैकेन वै शक्र त्वां चैवात्रावलम्बिनम् ।\nसर्वान् सपिण्डितान् वापि लोकान् सस्थाणुजङ्गमान् ।\nवहेयमपरिश्रान्तो विद्धीदं मे महद्बलम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2108526, "chapter_id": 3350, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2108527, "chapter_id": 3350, "verse_number": "६", "content_sanskrit": "इत्युक्तो वचनं वीरः किरीटी श्रीमतां वरः ।\nआह शौनक देवेन्द्रः सर्वभूतहितः प्रभुः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2108528, "chapter_id": 3350, "verse_number": "७", "content_sanskrit": "एवमेव यथाऽऽह त्वं सर्वं सम्भावये त्वयि ।\nप्रगृह्यतामिदानीं मे सख्यमानन्त्यमुत्तमम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2108529, "chapter_id": 3350, "verse_number": "८", "content_sanskrit": "न कार्यं तव सोमेन मम सोमः प्रदीयताम् ।\nअस्मांस्ते हि प्रबाधेयुर्येभ्यो दद्याद् भवानिदम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2108530, "chapter_id": 3350, "verse_number": "", "content_sanskrit": "गरुडः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2108531, "chapter_id": 3350, "verse_number": "९", "content_sanskrit": "किञ्चित् कारणमुद्दिश्य सोमोऽयं नीयते मया ।\nन दास्यामि समापातुं सोमं कस्मैचिदप्यहम्\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2108532, "chapter_id": 3350, "verse_number": "१०", "content_sanskrit": "यत्रेमं तु सहस्राक्ष निक्षिपेयमहं शुभम् ।\nत्वमादाय ततस्तूर्णं हरेथास्त्रिदिवेश्वर\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2108533, "chapter_id": 3350, "verse_number": "", "content_sanskrit": "शक्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2108534, "chapter_id": 3350, "verse_number": "११", "content_sanskrit": "वाक्येनानेन तुष्टोऽहं यत्त्वयोक्तमिहाण्डज ।\nयदिच्छसि वरं मत्तस्तद् गृहाण खगोत्तम \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2108535, "chapter_id": 3350, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2108536, "chapter_id": 3350, "verse_number": "१२", "content_sanskrit": "इत्युक्तः प्रत्युवाचेदं कद्रूपुत्राननुस्मरन् ।\nस्मृत्वा चैवोपधिकृतं मातुर्दास्यनिमित्ततः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2108537, "chapter_id": 3350, "verse_number": "", "content_sanskrit": "गरुडः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2108538, "chapter_id": 3350, "verse_number": "१३", "content_sanskrit": "ईशोऽहमपि सर्वस्य करिष्यामि त्वदर्थितम् ।\nभवेयुर्भुजगाः शक्र मम भक्ष्या न संशयः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2108539, "chapter_id": 3350, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2108540, "chapter_id": 3350, "verse_number": "१४", "content_sanskrit": "तथेत्युक्त्वाऽन्वगच्छत् तं तदा दानवसूदनः ।\nहरिष्यामि विनिक्षिप्तं सोममित्यनुभाष्य तम्\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2108541, "chapter_id": 3350, "verse_number": "१५", "content_sanskrit": "आजगाम ततस्तूर्णं सुपर्णो मातुरन्तिकम् ॥\nअथ सर्पानुवाचेदं सर्वान् परमहृष्टवत् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2108542, "chapter_id": 3350, "verse_number": "१६", "content_sanskrit": "इदमानीतममृतं निक्षिपामि कुशेषु वः ।\nस्नाता मङ्गलसंयुक्तास्ततः प्राश्नीत पन्नगाः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2108543, "chapter_id": 3350, "verse_number": "१७", "content_sanskrit": "अदासी चैव मातेयमद्यप्रभृति चास्तु मे ।\nयथोक्तं भवतामेतद् वचो मे प्रतिपादितम्\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2108544, "chapter_id": 3350, "verse_number": "", "content_sanskrit": "सूतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2108545, "chapter_id": 3350, "verse_number": "१८", "content_sanskrit": "ततः स्नातुं गताः सर्पाः प्रत्युक्त्वा तं तथेत्युत ।\nशक्रोऽप्यमृतमादाय जगाम त्रिदिवं पुनः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2108546, "chapter_id": 3350, "verse_number": "१९", "content_sanskrit": "अथागतास्तमुद्देशं सर्पाः सोमार्थिनस्तदा ।\nस्नाताश्च कृतजप्याश्च प्रहृष्टाः कृतमङ्गलाः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2108547, "chapter_id": 3350, "verse_number": "२०", "content_sanskrit": "तद् विज्ञाय हृतं सर्पाः शक्रमायाकृतं च तत् ।\nसोमस्थानमिदं चेति दर्भांस्ते लिलिहुस्तदा \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2108548, "chapter_id": 3350, "verse_number": "२१", "content_sanskrit": "ततो द्वैधीकृता जिह्वाः सर्पाणां तेन कर्मणा ।\nएवं तदमृतं तेनाहृतं मात्रार्थमेव च\t ॥ २१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2108549, "chapter_id": 3350, "verse_number": "२२", "content_sanskrit": "द्विजिह्वाश्च कृताः सर्पा गरुडेन महात्मना ।\nअभवंश्चामृतस्पर्शाद् दर्भास्तेऽथ पवित्रिणः\t ॥ २२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2108550, "chapter_id": 3350, "verse_number": "२३", "content_sanskrit": "ततः सुपर्णः परमप्रहृष्टवान्\nविहृत्य मात्रा सह तत्र कानने ।\nभुजङ्गभक्षः परमार्चितः खगै-\nरदीनकीर्तिर्विनतामनन्दयत् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2108551, "chapter_id": 3350, "verse_number": "२४", "content_sanskrit": "इमां कथां यः श्रुणुयान्नरः सदा\nपठेत वा द्विजगणमुख्यसंसदि ।\nअसंशयं त्रिदिवमियात् सुपुण्यभाङ्-\nमहात्मनः पतगपतेः प्रकीर्तनात् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2108552, "chapter_id": 3350, "verse_number": "२९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि एकोनत्रिंशोऽध्यायः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2108553, "chapter_id": 3350, "verse_number": "", "content_sanskrit": "॥ आस्तीकपर्वणि सप्तदशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]