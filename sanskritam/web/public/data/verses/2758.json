[{"id": 2082501, "chapter_id": 2758, "verse_number": "१२-२६३-०x", "content_sanskrit": "स्थाणुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082502, "chapter_id": 2758, "verse_number": "१२-२६३-१", "content_sanskrit": "प्रजासर्गनिमित्तं मे कार्यवत्तामिमां प्रभो।\nविद्धि सृष्टास्त्वया हीमा मा कुप्यासां पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082503, "chapter_id": 2758, "verse_number": "१२-२६३-२", "content_sanskrit": "तव तेजोग्निना देव प्रजा दह्यन्ति सर्वशः।\nता दृष्ट्वा मम कारुण्यं मा कुप्यासां जगत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082504, "chapter_id": 2758, "verse_number": "१२-२६३-३x", "content_sanskrit": "प्रजापतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082505, "chapter_id": 2758, "verse_number": "१२-२६३-३", "content_sanskrit": "न कुप्ये न च मे कामो नभवेयुः प्रजा इति।\nलाघवार्थं धरण्यास्तु ततः संहार इष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082506, "chapter_id": 2758, "verse_number": "१२-२६३-४", "content_sanskrit": "इयं हि मां सदा देवी भारार्ता समचोदयत्।\nसंहारार्थं महादेव भारेणाप्सु निमज्जती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082507, "chapter_id": 2758, "verse_number": "१२-२६३-५", "content_sanskrit": "यदाऽहं नाधिगच्छामि बुद्ध्या बहु विचारयन्।\nसंहारमासां वृद्धानां ततो मां क्रोध आविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082508, "chapter_id": 2758, "verse_number": "१२-२६३-६x", "content_sanskrit": "स्थाणुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082509, "chapter_id": 2758, "verse_number": "१२-२६३-६", "content_sanskrit": "संहारात्त्वं निवर्तस्य मा क्रुधो विवुधेश्वर।\nमा प्रजाः स्थावरं चैव जङ्गमं च व्यनीनशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082510, "chapter_id": 2758, "verse_number": "१२-२६३-७", "content_sanskrit": "पल्वलानि च सर्वाणि सर्वं चैव तृणीलपम्।\nस्थावरं जङ्गमं चैव भूतग्रामं चतुर्विधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082511, "chapter_id": 2758, "verse_number": "१२-२६३-८", "content_sanskrit": "अकाले भस्मसाद्भूतं जगत्सर्वमुपप्लुतम्।\nप्रसीद भगवन्साधो वर एष वृतो मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082512, "chapter_id": 2758, "verse_number": "१२-२६३-९", "content_sanskrit": "नष्टा न पुनरेष्यन्ति प्रजा ह्येताः कथंचन।\nतस्मान्निवर्ततामेतत्तेन स्वेनेव तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082513, "chapter_id": 2758, "verse_number": "१२-२६३-१०", "content_sanskrit": "उपायमन्यं संपश्य भूतानां हितकाम्यया।\nयथामी जन्तवः सर्वे न दह्येरन्पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082514, "chapter_id": 2758, "verse_number": "१२-२६३-११", "content_sanskrit": "अभावं हि न गच्छेयुरुत्सन्नप्रजनाः प्रजाः।\n`पुत्रत्वेनानुसंकल्प्ये तदाऽहं तप्य दानवैः।\nअधिदैवे नियुक्तोस्मि त्वया लोकहितेप्सुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082515, "chapter_id": 2758, "verse_number": "१२-२६३-१२", "content_sanskrit": "त्वद्भवं हि जगन्नाथ एतत्स्थावरजङ्गमम्।\nप्रसाद्य त्वां महादेव याचाम्यावृत्तिजाः प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082516, "chapter_id": 2758, "verse_number": "१२-२६३-१३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082517, "chapter_id": 2758, "verse_number": "१२-२६३-१३", "content_sanskrit": "श्रुत्वा तु वचनं देवः स्थाणोर्नियतवाङ्भनाः।\nतेजस्तत्सन्निजग्राह पुनरेवान्तरात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082518, "chapter_id": 2758, "verse_number": "१२-२६३-१४", "content_sanskrit": "ततोऽग्निमुपसंगृह्य भगवाँल्लोकपूजितः।\nप्रवृत्तिं च निवृत्तिं च कल्पयामास वै प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082519, "chapter_id": 2758, "verse_number": "१२-२६३-१५", "content_sanskrit": "उपसंहरतस्तस्य तमग्निं रोषजं तदा।\nप्रादुर्बभूव विश्वेभ्यः खेभ्यो नारी महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082520, "chapter_id": 2758, "verse_number": "१२-२६३-१६", "content_sanskrit": "कृष्णरक्ताम्बरधरा कृष्णनेत्रतलान्तरा।\nदिव्यकुण्डलसंपन्ना दिव्याभरणभूषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082521, "chapter_id": 2758, "verse_number": "१२-२६३-१७", "content_sanskrit": "सा विनिःसृत्य वै खेभ्यो दक्षिणामाश्रिता दिशम्।\nददृशाते च तां कन्यां देवौ विश्वेश्वरावुभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082522, "chapter_id": 2758, "verse_number": "१२-२६३-१८", "content_sanskrit": "तामाहूय तदा देवो लोकानामादिरीश्वरः।\nमृत्यो इति महीपाल जहि चेमाः प्रजा इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082523, "chapter_id": 2758, "verse_number": "१२-२६३-१९", "content_sanskrit": "त्वं हि संहारबुद्ध्या मे चिन्तिता रुषितेन च।\nतस्मात्संहर सर्वास्त्वं प्रजाः सजडपण्डिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2082524, "chapter_id": 2758, "verse_number": "१२-२६३-२०", "content_sanskrit": "अविशेषेण चैव त्वं प्रजाः संहर कामिनि।\nमम त्वं हि नियोगेन श्रेयः परमवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2082525, "chapter_id": 2758, "verse_number": "१२-२६३-२१", "content_sanskrit": "एवमुक्ता तु या देवी मृत्युः कमलमालिनी।\nप्रदध्यौ दुःखिता बाला साश्रुपातमतीव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2082526, "chapter_id": 2758, "verse_number": "१२-२६३-२२", "content_sanskrit": "पाणिभ्यां चैव जग्राह तान्यश्रूणि जनेश्वरः।\nमानवानां हितार्थाय ययाचे पुनरेव ह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2082527, "chapter_id": 2758, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रिषष्ट्यधिकद्विशततमोऽध्यायः॥ २६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]