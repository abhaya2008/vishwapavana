[{"id": 2038817, "chapter_id": 1849, "verse_number": "५-९४-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038818, "chapter_id": 1849, "verse_number": "५-९४-१", "content_sanskrit": "तथा कथयतोरेव तयोर्बुद्धिमतोस्तदा।\nशिवा नक्षत्रसंपन्ना सा व्यतीयाय शर्वरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038819, "chapter_id": 1849, "verse_number": "५-९४-२", "content_sanskrit": "धर्मार्थकामयुक्ताश्च विचित्रार्थपदाक्षराः।\nशृण्वतो विविधा वाचो विदुरस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038820, "chapter_id": 1849, "verse_number": "५-९४-३", "content_sanskrit": "कथाभिरनुरूपाभी रक्तस्यामिततेजसः ।\nअकामस्यैव कृष्णस्य सा व्यतीयाय शर्वरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038821, "chapter_id": 1849, "verse_number": "५-९४-४", "content_sanskrit": "ततस्तु स्वरसंपन्ना बहवः सूतमागधाः ॥\nशङ्खदुन्दुमिनिर्घोषैः केशवं प्रत्यबोधयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038822, "chapter_id": 1849, "verse_number": "५-९४-५", "content_sanskrit": "तत उत्थाय दाशार्हऋषभः सर्वसात्वताम् ।\nसर्वमावश्यकं चक्रे प्रातः कार्यं जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038823, "chapter_id": 1849, "verse_number": "५-९४-६", "content_sanskrit": "कृतोदकानुजप्यः स हुताग्निः समलङ्कृतः।\nततश्चादित्यमुद्यन्तमुपातिष्ठत माधवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038824, "chapter_id": 1849, "verse_number": "५-९४-७", "content_sanskrit": "अथ दुर्योधनः कृष्मं शकुनिश्चापि सौबलः।\nसन्ध्यां तिष्ठन्तमभ्येत्य दाशार्हमपराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038825, "chapter_id": 1849, "verse_number": "५-९४-८", "content_sanskrit": "आचक्षेतां तु कृष्णस्य धृतराष्ट्रं सभागतम्।\nकुरूश्च भीष्मप्रमुखान्राज्ञः सर्वांश्च पार्थिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038826, "chapter_id": 1849, "verse_number": "५-९४-९", "content_sanskrit": "त्वामर्थयन्ते गोविन्द दिवि शक्रमिवामराः ।\nतावभ्यनन्दद्गोविन्दः साम्ना परमवल्गुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038827, "chapter_id": 1849, "verse_number": "५-९४-१०", "content_sanskrit": "ततो विमल आदित्ये ब्राह्मणेभ्यो जनार्दनः।\nददौ हिरण्यं वासांसि गाश्चाश्चांश्च परन्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038828, "chapter_id": 1849, "verse_number": "५-९४-११", "content_sanskrit": "विसृष्टवन्तं रत्नानि दाशार्हमपराजितम्।\nतिष्ठन्तमुपसङ्गम्य ववन्दे सारथिस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038829, "chapter_id": 1849, "verse_number": "५-९४-१२", "content_sanskrit": "` तस्मै रथवरो युक्तः शुशुभे लोकविश्रुतः ।\nवाजिभिः शैब्यसुग्रीवमेघपुष्पबलाहकैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038830, "chapter_id": 1849, "verse_number": "५-९४-१३", "content_sanskrit": "शैब्यस्तु शुकपत्राभः सुग्रीवः किंशुकप्रभः ।\nमेघपुष्पो मेघवर्णः पाण्डरस्तु बलाहकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038831, "chapter_id": 1849, "verse_number": "५-९४-१४", "content_sanskrit": "दक्षिणं चावहच्छैब्यः सुग्रीवः सव्यतोऽवहत्।\nपृष्ठवाहौ रथस्यास्तां मेघपुष्पबलाहकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038832, "chapter_id": 1849, "verse_number": "५-९४-१५", "content_sanskrit": "विश्वकर्मकृताऽऽपीडा रत्नजालविभूषिता ।\nआश्रिता वै रथे तस्मिन्ध्वजयष्टिरशोभत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038833, "chapter_id": 1849, "verse_number": "५-९४-१६", "content_sanskrit": "वैनतेयः स्थितस्तस्यां प्रभाकरमिव स्पृशन्।\nतस्य सत्ववतः केतौ भुजगारिरशोभत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038834, "chapter_id": 1849, "verse_number": "५-९४-१७", "content_sanskrit": "तस्य कीर्तिमतस्तेन भास्वरेण विराजता ।\nशुशुभे स्यन्दनश्रेष्ठः पतगेन्द्रेण केतुना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038835, "chapter_id": 1849, "verse_number": "५-९४-१८", "content_sanskrit": "रश्मिजालैः पताकाभिः सौवर्णेन च केतुना ।\nबभूव स रथश्रेष्ठः कालसूर्य इवोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2038836, "chapter_id": 1849, "verse_number": "५-९४-१९", "content_sanskrit": "पक्षिध्वजवितानैश्च रुक्मजालकृताङ्गणैः ।\nदण्डमार्गविभागैश्च सुकृतैर्विश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2038837, "chapter_id": 1849, "verse_number": "५-९४-२०", "content_sanskrit": "प्रवालमणिशोभैश्च मुक्तावैडूर्यशोभनैः ।\nकिङ्किणीशतसङ्घैश्च वालजालकृतान्तरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2038838, "chapter_id": 1849, "verse_number": "५-९४-२१", "content_sanskrit": "कार्तस्वरमयीभिश्च पद्मिनीभिरलङ्कृतः।\nशुशुभे स्यन्दनश्रेष्ठस्तापनीयैश्च पादपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2038839, "chapter_id": 1849, "verse_number": "५-९४-२२", "content_sanskrit": "व्याघ्रसिंहवराहैश्च गोभिश्च मृगपक्षिभिः ।\nताराभिर्भास्करैश्चापि वारणैश्च हिरण्मयैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2038840, "chapter_id": 1849, "verse_number": "५-९४-२३", "content_sanskrit": "वज्राङ्कुशविमानैश्च कूबरावृत्तसन्धिषु ।\nसमुच्छ्रितमहानाभिः स्तनयित्नुमहास्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2038841, "chapter_id": 1849, "verse_number": "५-९४-२४", "content_sanskrit": "ततो रथेन शुभ्रेण महता किङ्किणीकिना ।\nहयोत्तमयुजा शीघ्रमुपातिष्ठत दारुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2038842, "chapter_id": 1849, "verse_number": "५-९४-२५", "content_sanskrit": "तमुपस्थितमाज्ञाय रथं दिव्यं महामनाः ।\nमहाभ्रघननिर्घोषं सर्वरत्नविभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2038843, "chapter_id": 1849, "verse_number": "५-९४-२६", "content_sanskrit": "अग्निं प्रदक्षिणं कृत्वा ब्राह्मणांश्च जनार्दनः।\nकौस्तुभं मणिमाबध्य श्रिया परमया ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2038844, "chapter_id": 1849, "verse_number": "५-९४-२७", "content_sanskrit": "कुरुभिः संवृतः कृष्णो वृष्णिभिश्चाभिरक्षितः ।\nआतिष्ठत रथं शौरिः सर्वयादवनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2038845, "chapter_id": 1849, "verse_number": "५-९४-२८", "content_sanskrit": "अन्वारुरोह दाशार्हं विदुरः सर्वधर्मवित्।\nसर्वप्राणभृतां श्रेष्ठं सर्वबुद्धिमतां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2038846, "chapter_id": 1849, "verse_number": "५-९४-२९", "content_sanskrit": "ततो दुर्योधनः कृष्णं शकुनिश्चापि सौबलः ।\nद्वितीयेन रथेनैनमन्वयातां परन्तपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2038847, "chapter_id": 1849, "verse_number": "५-९४-३०", "content_sanskrit": "सात्यकिः कृतवर्मा च वृष्णीनां चापरे रथाः ।\nपृष्ठतोऽनुययुः कृष्णं गजैरश्वै रथैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2038848, "chapter_id": 1849, "verse_number": "५-९४-३१", "content_sanskrit": "तेषां हेमपरिष्कारैर्युक्ताः परमवाजिभिः ।\nगच्छतां घोषिणश्चित्ररथा राजन्विरेजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2038849, "chapter_id": 1849, "verse_number": "५-९४-३२", "content_sanskrit": "संमृष्टसंसिक्तरजः प्रतिपेदे महापथम् ।\nराजर्षिचरितं काले कृष्णो धीमाञ्श्रिया ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2038850, "chapter_id": 1849, "verse_number": "५-९४-३३", "content_sanskrit": "ततः प्रयाते दाशार्हे प्रावाद्यन्तैकपुष्कराः।\nशङ्खाश्च दध्मिरे तत्र वाद्यान्यन्यानि यानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2038851, "chapter_id": 1849, "verse_number": "५-९४-३४", "content_sanskrit": "प्रवीराः सर्वलोकस्य युवानः सिंहविक्रमाः।\nपरिवार्य रथं शौरेरगच्छन्त परन्तपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2038852, "chapter_id": 1849, "verse_number": "५-९४-३५", "content_sanskrit": "ततोऽन्ये बहुसाहस्रा विचित्राद्भुतवाससः ।\nअसिप्रासायुधधराः कृष्णस्यासन्पुरःसराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2038853, "chapter_id": 1849, "verse_number": "५-९४-३६", "content_sanskrit": "गजाः पञ्चशतास्तत्र रथाश्चासन्सहस्रशः।\nप्रयान्तमन्वयुर्वीरं दाशार्हमपराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2038854, "chapter_id": 1849, "verse_number": "५-९४-३७", "content_sanskrit": "पुरं कुरूणां संवृत्तं द्रष्टुकामं जनार्दनम् ।\nसबालवृद्धं सस्त्रीकं रथ्यागतमरिन्दम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2038855, "chapter_id": 1849, "verse_number": "५-९४-३८", "content_sanskrit": "वेदिकामाश्रिताभिश्च समाक्रान्तान्यनेकशः ।\nप्रचलन्तीव भारेण योषिद्भिर्भवनान्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2038856, "chapter_id": 1849, "verse_number": "५-९४-३९", "content_sanskrit": "स पूज्यमानः कुरुभिः संश्रृण्वन्मधुराः कथाः ।\nयथार्हं प्रतिसत्कुर्वन्प्रेक्षमाणः शनैर्ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2038857, "chapter_id": 1849, "verse_number": "५-९४-४०", "content_sanskrit": "ततः सभां समासाद्य केशवस्यानुयायिनः।\nसशङ्खैर्वेणुनिर्घोषैर्दिशः सर्वा व्यनादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2038858, "chapter_id": 1849, "verse_number": "५-९४-४१", "content_sanskrit": "ततः सा समितिः सर्वा राज्ञाममिततेजसाम्।\nसंप्राकम्पत हर्षेण कृष्णागमनकाङ्क्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2038859, "chapter_id": 1849, "verse_number": "५-९४-४२", "content_sanskrit": "ततोऽभ्याशंगते कृष्णे समहृष्यन्नराधिपाः।\nश्रुत्वां तं रथनिर्घोषं पर्जन्यनिनदोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2038860, "chapter_id": 1849, "verse_number": "५-९४-४३", "content_sanskrit": "आसाद्य तु सभाद्वारमृषभः सर्वसात्वताम् ।\nअवतीर्य रथाच्छौरिः कैलासशिखरोपमात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2038861, "chapter_id": 1849, "verse_number": "५-९४-४४", "content_sanskrit": "नवमेघप्रतीकाशां ज्वलन्तीमिव तेजसा ।\nमहेन्द्रसदनप्रख्यां प्रविवेश सभां ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2038862, "chapter_id": 1849, "verse_number": "५-९४-४५", "content_sanskrit": "पाणौ गृहीत्वा विदुरं सात्यकिं च महायशाः।\nज्येतींष्यादित्यवद्राजन्कुरून्प्राच्छादयच्छ्रिया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2038863, "chapter_id": 1849, "verse_number": "५-९४-४६", "content_sanskrit": "अग्रतो वासुदेवस्य कर्णदुर्योधनावुभौ ।\nकृष्णयः कृतवर्मा चाप्यासन्कृष्णस्य पृष्ठतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2038864, "chapter_id": 1849, "verse_number": "५-९४-४७", "content_sanskrit": "धृतराष्ट्रं पुरस्कृत्य भीष्मद्रोणादयस्ततः ।\nआसनेभ्योऽचलन्सर्वे पूजयन्तो जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2038865, "chapter_id": 1849, "verse_number": "५-९४-४८", "content_sanskrit": "अभ्यागच्छति दाशार्हे प्रज्ञाचक्षुर्नरेश्वर।\nसहैव द्रोणभीष्माभ्यामुदतिष्ठन्महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2038866, "chapter_id": 1849, "verse_number": "५-९४-४९", "content_sanskrit": "उत्तिष्ठति महाराजे धृतराष्ट्रे जनेश्वरे ।\nतानि राजसहस्राणि समुत्तस्थुः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2038867, "chapter_id": 1849, "verse_number": "५-९४-५०", "content_sanskrit": "आसनं सर्वतोभद्रं जाम्बूनदपरिष्कृतम् ।\nकृष्णार्थे कल्पितं तत्र धृतराष्ट्रस्य शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2038868, "chapter_id": 1849, "verse_number": "५-९४-५१", "content_sanskrit": "स्मयमानस्तु राजानं भीष्मद्रोणौ च माधवः ।\nअभ्यभाषत धर्मात्मा राज्ञश्चान्यान्यथावयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2038869, "chapter_id": 1849, "verse_number": "५-९४-५२", "content_sanskrit": "तत्र केशवमानर्चुः सम्यगभ्यागतं सभाम्।\nराजानः पार्थिवाः सर्वे कुरवश्च जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2038870, "chapter_id": 1849, "verse_number": "५-९४-५३", "content_sanskrit": "तत्र तिष्ठन्स दाशार्हो राजमध्ये परन्तपः।\nअपश्यदन्तरिक्षस्थानृषीन्परपुरञ्जयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2038871, "chapter_id": 1849, "verse_number": "५-९४-५४", "content_sanskrit": "ततस्तानभिसंप्रेक्ष्य नारदप्रमुखानृषीन् ॥\nअभ्यभाषत दाशार्हो भीष्मं शान्तनवं शनैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2038872, "chapter_id": 1849, "verse_number": "५-९४-५५", "content_sanskrit": "पार्थिवीं समितिं द्रष्टुमृषयोऽभ्यागता नृप ॥\nनिमन्त्र्यन्तामासनैश्च सत्कारेण च भूयसा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2038873, "chapter_id": 1849, "verse_number": "५-९४-५६", "content_sanskrit": "नैतेष्वनुपविष्टेषु शक्यं केनचिदासितुम् ॥\nपूजा प्रयुज्यतामाशु मुनीनां भावितात्मनाम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2038874, "chapter_id": 1849, "verse_number": "५-९४-५७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2038875, "chapter_id": 1849, "verse_number": "५-९४-५७", "content_sanskrit": "ऋषीञ्शान्तनवो दृष्ट्वा सभाद्वारमुपस्थितान् ।\nत्वरमाणस्ततो भृत्यानासनानीत्यचोदयत् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2038876, "chapter_id": 1849, "verse_number": "५-९४-५८", "content_sanskrit": "आसनान्यथ मृष्टानि महान्ति विपुलानि च ॥\nमणिकाञ्चनचित्राणि समाजह्रुस्ततस्ततः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2038877, "chapter_id": 1849, "verse_number": "५-९४-५९", "content_sanskrit": "तेषु तत्रोपविष्टेषु गृहीतार्घ्येषु भारत ॥\nनिषसादासने कृष्णो राजानश्च यथासनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2038878, "chapter_id": 1849, "verse_number": "५-९४-६०", "content_sanskrit": "दुःशासनः सात्यकये ददावासनमुत्तमम् ॥\nविविंशतिर्ददौ पीठं काञ्चनं कृतवर्मणे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2038879, "chapter_id": 1849, "verse_number": "५-९४-६१", "content_sanskrit": "अविदूरे तु कृष्णस्य कर्णदुर्योधनावुभौ ॥\nएकासने महात्मानौ निषीदतुरमर्षणौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2038880, "chapter_id": 1849, "verse_number": "५-९४-६२", "content_sanskrit": "गान्धारराजः शकुनिर्गान्धारैरभिरक्षितः ॥\nनिषसादासने राजा सहपुत्रो विशांपते ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2038881, "chapter_id": 1849, "verse_number": "५-९४-६३", "content_sanskrit": "विदुरो मणिपीठे तु शुक्लस्पर्ध्याजिनोत्तरे ॥\nसंस्पृशन्नासनं शौरेर्महामतिरुपाविशत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2038882, "chapter_id": 1849, "verse_number": "५-९४-६४", "content_sanskrit": "चिरस्य दृष्ट्वा दाशार्हं राजानः सर्व एव ते ॥\nअमृतस्येव नातृप्यन्प्रेक्षमाणा जनार्दनम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2038883, "chapter_id": 1849, "verse_number": "५-९४-६५", "content_sanskrit": "अतसीपुष्पसङ्काशः पीतवासा जनार्दनः ॥\nव्यभ्राजत सभामध्ये हेम्नीवोपहितो मणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2038884, "chapter_id": 1849, "verse_number": "५-९४-६६", "content_sanskrit": "ततस्तूष्णीं सर्वमासीद्गोविन्दगतमानसम् ।\nन तत्र कश्चित्किंचिद्वा व्याजहार पुमान्क्वचित् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2038885, "chapter_id": 1849, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि चतुर्नवतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]