[{"id": 2185567, "chapter_id": 4938, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2185568, "chapter_id": 4938, "verse_number": "१", "content_sanskrit": "स्वाध्यायकृतयत्नस्य ब्राह्मणस्य पितामह ।\nधर्मकामस्य धर्मात्मन् किं नु श्रेय इहोच्यते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2185569, "chapter_id": 4938, "verse_number": "२", "content_sanskrit": "बहुधादर्शने लोके श्रेयो यदिह मन्यसे ।\nअस्मिँल्लोके परे चैव तन्मे ब्रूहि पितामह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2185570, "chapter_id": 4938, "verse_number": "३", "content_sanskrit": "महानयं धर्मपथो बहुशाखश्च भारत ।\nकिं स्विदेवेह धर्माणामनुष्ठेयतमं मतम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2185571, "chapter_id": 4938, "verse_number": "४", "content_sanskrit": "धर्मस्य महतो राजन् बहुशाखस्य तत्त्वतः ।\nयन्मूलं परमं तात तत् सर्वं ब्रूह्यतन्द्रितः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2185572, "chapter_id": 4938, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2185573, "chapter_id": 4938, "verse_number": "५", "content_sanskrit": "हन्त ते कथयिष्यामि येन श्रेयः प्रपत्स्यसे ।\nपीत्वामृतमिव प्राज्ञो ज्ञानतृप्तो भविष्यसि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2185574, "chapter_id": 4938, "verse_number": "६", "content_sanskrit": "धर्मस्य विधयो नैके ते ते प्रोक्ता महर्षिभिः ।\nस्वं स्वं विज्ञानमाश्रित्य दमस्तेषां परायणम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2185575, "chapter_id": 4938, "verse_number": "७", "content_sanskrit": "दमं निःश्रेयसं प्राहुर्वृद्धा निश्चयदर्शिनः ।\nब्राह्मणस्य विशेषेण दमो धर्मः सनातनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2185576, "chapter_id": 4938, "verse_number": "८", "content_sanskrit": "नादान्तस्य क्रियासिद्धिर्यथावदुपलभ्यते ।\nदमो दानं तथा यज्ञानधीतं चातिवर्तते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2185577, "chapter_id": 4938, "verse_number": "९", "content_sanskrit": "दमस्तेजो वर्धयति पवित्रं च दमः परम् ।\nविपाप्मा तेजसा युक्तः पुरुषो विन्दते महत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2185578, "chapter_id": 4938, "verse_number": "१०", "content_sanskrit": "दमेन सदृशं धर्मं नान्यं लोकेषु शुश्रुम ।\nदमो हि परमो लोके प्रशस्तः सर्वधर्मिणाम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2185579, "chapter_id": 4938, "verse_number": "११", "content_sanskrit": "प्रेत्य चापि मनुष्येन्द्र परमं विन्दते सुखम् ।\nदमेन हि समायुक्तो महान्तं धर्ममश्नुते\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2185580, "chapter_id": 4938, "verse_number": "१२", "content_sanskrit": "सुखं दान्तः प्रस्वपिति सुखं च प्रतिबुध्यते ।\nसुखं पर्येति लोकांश्च मनश्चास्य प्रसीदति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2185581, "chapter_id": 4938, "verse_number": "१३", "content_sanskrit": "अदान्तः पुरुषः क्लेशमभीक्ष्णं प्रतिपद्यते ।\nअनर्थांश्च बहूनन्यान् प्रसृजत्यात्मदोषजान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2185582, "chapter_id": 4938, "verse_number": "१४", "content_sanskrit": "आश्रमेषु चतुर्ष्वाहुर्दममेवोत्तमं व्रतम् ।\nतस्य लिङ्गानि वक्ष्यामि येषां समुदयो दमः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2185583, "chapter_id": 4938, "verse_number": "१५", "content_sanskrit": "क्षमा धृतिरहिंसा च समता सत्यमार्जवम् ।\nइन्द्रियावजयो दाक्ष्यं मार्दवं ह्रीरचापलम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2185584, "chapter_id": 4938, "verse_number": "१६", "content_sanskrit": "अकार्पण्यमसंरम्भः सन्तोषः प्रियवादिता ।\nअविवित्सानसूया चाप्येषां समुदयो दमः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2185585, "chapter_id": 4938, "verse_number": "१७", "content_sanskrit": "गुरुपूजा च कौरव्य दया भूतेष्वपैशुनम् ।\nजनवादमृषावादस्तुतिनिन्दाविवर्जनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2185586, "chapter_id": 4938, "verse_number": "१८", "content_sanskrit": "कामः क्रोधश्च लोभश्च दर्पः स्तम्भो विकत्थनम् ।\nमोह ईर्ष्यावमानश्चेत्येतद्दान्तो न सेवते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2185587, "chapter_id": 4938, "verse_number": "१९", "content_sanskrit": "अनिन्दिते ह्यकामात्माऽथाल्पेच्छोऽथानसूयकः ।\nसमुद्रकल्पः पुरुषो न कदाचिन्न पूर्यते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2185588, "chapter_id": 4938, "verse_number": "२०", "content_sanskrit": "अहं त्वयि मम त्वं च मयि ते तेषु चाप्यहम् ।\nपूर्वसम्बन्धिसंयोगान्नैतद् दान्तो निषेवते\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2185589, "chapter_id": 4938, "verse_number": "२१", "content_sanskrit": "सर्वा ग्राम्यास्तथारण्या याश्च लोके प्रवृत्तयः ।\nनिन्दां चैव प्रशंसां च यो नाश्रयति मुच्यते\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2185590, "chapter_id": 4938, "verse_number": "२२", "content_sanskrit": "मैत्रोऽथ शीलसम्पन्नः सुसहायपरश्च यः ।\nमुक्तश्च विविधैः सङ्गैस्तस्य प्रेत्य महत्फलम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2185591, "chapter_id": 4938, "verse_number": "२३", "content_sanskrit": "सुवृत्तः शीलसम्पन्नः प्रसन्नात्मात्मविद् बुधः ।\nप्राप्येह लोके सत्कारं सुगतिं प्रतिपद्यते\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2185592, "chapter_id": 4938, "verse_number": "२४", "content_sanskrit": "कर्म यच्छुभमेवेह सद्भिराचरितं च यत् ।\nतदेव ज्ञानयुक्तस्य मुनेर्धर्मो न हीयते\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2185593, "chapter_id": 4938, "verse_number": "२५", "content_sanskrit": "निष्क्रम्य वनमास्थाय ज्ञानयुक्तो जितेन्द्रियः ।\nकालाकाङ्क्षी चरन्नेवं ब्रह्मभूयाय कल्पते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2185594, "chapter_id": 4938, "verse_number": "२६", "content_sanskrit": "अभयं यस्य भूतेभ्यो भूतानामभयं यतः ।\nतस्य देहाद् विमुक्तस्य भयं नास्ति कुतश्चन\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2185595, "chapter_id": 4938, "verse_number": "२७", "content_sanskrit": "अवाचिनोति कर्माणि न च सम्प्रचिनोति ह ।\nसमः सर्वेषु भूतेषु मैत्रायणगतिश्चरेत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2185596, "chapter_id": 4938, "verse_number": "२८", "content_sanskrit": "शकुनीनामिवाकाशे जले वारिचरस्य वा ।\nयथा गतिर्न दृश्येत तथा तस्य न संशयः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2185597, "chapter_id": 4938, "verse_number": "२९", "content_sanskrit": "गृहानुत्सृज्य यो राजन् मोक्षमेवाभिपद्यते ।\nलोकास्तेजोमयास्तस्य कल्पन्ते शाश्वतीः समाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2185598, "chapter_id": 4938, "verse_number": "३०", "content_sanskrit": "सन्न्यस्य सर्वकर्माणि सन्न्यस्य विधिवत्तपः ।\nसंन्यस्य विविधा विद्याः सर्वं संन्यस्य चैव ह\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2185599, "chapter_id": 4938, "verse_number": "३१", "content_sanskrit": "कामे शुचिरनावृत्तः प्रसन्नात्मात्मविच्छुचिः ।\nप्राप्येह लोके सत्कारं स्वर्गं समभिपद्यते\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2185600, "chapter_id": 4938, "verse_number": "३२", "content_sanskrit": "यच्च पैतामहं स्थानं ब्रह्मराशिसमुद्भवम् ।\nगुहायां पिहितं नित्यं तद्दमेनाभिपद्यते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2185601, "chapter_id": 4938, "verse_number": "३३", "content_sanskrit": "ज्ञानारामस्य बुद्धस्य सर्वभूताविरोधिनः ।\nनावृत्तिभयमस्तीह परलोके भयं कुतः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2185602, "chapter_id": 4938, "verse_number": "३४", "content_sanskrit": "एक एव दमे दोषो द्वितीयो नोपपद्यते ।\nयदेनं क्षमया युक्तमशक्तं मन्यते जनः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2185603, "chapter_id": 4938, "verse_number": "३५", "content_sanskrit": "एतस्य तु महाप्राज्ञ दोषस्य सुमहान् गुणः ।\nक्षमायां विपुला लोकाः सुलभा हि सहिष्णुना\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2185604, "chapter_id": 4938, "verse_number": "३६", "content_sanskrit": "दान्तस्य किमरण्येन तथादान्तस्य भारत ।\nयत्रैव हि वसेद् दान्तस्तदरण्यं स आश्रमः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2185605, "chapter_id": 4938, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2185606, "chapter_id": 4938, "verse_number": "३७", "content_sanskrit": "एतद्भीष्मस्य वचनं श्रुत्वा राजा युधिष्ठिरः ।\nअमृतेनेव सन्तृप्तः प्रहृष्टः समपद्यत\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2185607, "chapter_id": 4938, "verse_number": "३८", "content_sanskrit": "पुनश्च परिपप्रच्छ भीष्मं धर्मभृतां वरम् ।\nतपः प्रति स चोवाच तस्मै सर्वं कुरूद्वह\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2185608, "chapter_id": 4938, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे षड्विंशोऽध्यायः ॥ २६ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]