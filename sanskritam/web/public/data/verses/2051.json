[{"id": 2047488, "chapter_id": 2051, "verse_number": "६-१००-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2047489, "chapter_id": 2051, "verse_number": "६-१००-१", "content_sanskrit": "अभिमन्यू रथोदारः पिशङ्गैस्तुरगोत्तमैः।\nअभिदुद्राव तेजस्वी दुर्योधनबलं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2047490, "chapter_id": 2051, "verse_number": "६-१००-२", "content_sanskrit": "विकिरञ्शरवर्षाणि वारिधारा इवाम्बुदः।\nन शेकुः समरे क्रुद्धं सौभद्रमरिसूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2047491, "chapter_id": 2051, "verse_number": "६-१००-३", "content_sanskrit": "शस्त्रौघिणं गाहमानं सेनासागरमक्षयम्।\nनिवारयितुमप्याजौ त्वदीयाः कुरुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2047492, "chapter_id": 2051, "verse_number": "६-१००-४", "content_sanskrit": "तेन मुक्ता रणे राजञ्शराः शत्रुनिबर्हणाः।\nक्षत्रियाननयञ्शूरान्प्रेतराजनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2047493, "chapter_id": 2051, "verse_number": "६-१००-५", "content_sanskrit": "यमदण्डोपमान्घोराञ्ज्वलिताशीविषोपमान् ।\nसौभद्रः समरे क्रुद्धः प्रेषयामास सायकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2047494, "chapter_id": 2051, "verse_number": "६-१००-६", "content_sanskrit": "सरथान्रथिनस्तूर्णं हयांश्चैव ससादिनः ।\nगजारोहांश्च सगजान्दारयामास फाल्गुनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2047495, "chapter_id": 2051, "verse_number": "६-१००-७", "content_sanskrit": "तस्य तत्कुर्वतः कर्म महत्सङ्ख्ये महीभृतः।\nपूजयांचक्रिरे हृष्टाः प्रशशंसुश्च फाल्गुनिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2047496, "chapter_id": 2051, "verse_number": "६-१००-८", "content_sanskrit": "तान्यनीकानि सौभद्रो द्रावयामास भारत।\nतूलराशीनिवाकाशे मारुतः सर्वतो दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2047497, "chapter_id": 2051, "verse_number": "६-१००-९", "content_sanskrit": "तेन विद्राव्यमाणानि तव सैन्यानि भारत ।\nत्रतारं नाध्यगच्छन्त पङ्क्ते मग्ना इव द्वीपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2047498, "chapter_id": 2051, "verse_number": "६-१००-१०", "content_sanskrit": "विद्राव्य सर्वसैन्यानि तावकानि नरोत्तम ।\nअभिमन्युः स्थितो राजन्विधूमोऽग्निरिव ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2047499, "chapter_id": 2051, "verse_number": "६-१००-११", "content_sanskrit": "न चैनं तावका राजन्विषेहुररिघातिनम् ।\nप्रदीप्तं पावकं यद्वत्पतङ्गाः कालचोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2047500, "chapter_id": 2051, "verse_number": "६-१००-१२", "content_sanskrit": "प्रहरन्सर्वशत्रुभ्यः पाण्डवानां महारथः ।\nअदृश्यत महेष्वासः सवज्र इव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2047501, "chapter_id": 2051, "verse_number": "६-१००-१३", "content_sanskrit": "हेमपृष्ठं धनुश्चास्य ददृशे विचरद्दिशः ।\nतोयदेषु यथा राजन्राजमाना शतह्रदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2047502, "chapter_id": 2051, "verse_number": "६-१००-१४", "content_sanskrit": "शराश्च निशिताः पीता निश्चरन्ति स्म संयुगे ।\nवनात्फुल्लद्रुमाद्राजन्भ्रमराणामिव व्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2047503, "chapter_id": 2051, "verse_number": "६-१००-१५", "content_sanskrit": "तथैव चरतस्तस्य सौभद्रस्य महात्मनः ।\nरथेन काञ्चनाङ्गेन ददृशुर्नान्तरं जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2047504, "chapter_id": 2051, "verse_number": "६-१००-१६", "content_sanskrit": "मोहयित्वा कृपं द्रोणं द्रौणिं च सबृहद्बलम्।\nसैन्धवं च महेष्वासो व्यचरल्लघु सुष्ठु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2047505, "chapter_id": 2051, "verse_number": "६-१००-१७", "content_sanskrit": "मण्डलीकृतमेवास्य धनुः पश्याम भारत।\nसूर्यमण्डलसंकाशं दहतस्तव वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2047506, "chapter_id": 2051, "verse_number": "६-१००-१८", "content_sanskrit": "तं दृष्ट्वा क्षत्रियाः शुराः प्रतपन्तं तरस्विनम् ।\nद्विफल्गुनमिमं लोकं मेनिरे तस्य कर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2047507, "chapter_id": 2051, "verse_number": "६-१००-१९", "content_sanskrit": "तेनार्दिता महाराज भारती सा महाचमूः ।\nव्यभ्रमत्तत्रतत्रैव योषिन्मदवशादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2047508, "chapter_id": 2051, "verse_number": "६-१००-२०", "content_sanskrit": "द्रावयित्वा महासैन्यं कम्पयित्वा महारथान् ।\nनन्दयामास सुहृदो मयं जित्वेव वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2047509, "chapter_id": 2051, "verse_number": "६-१००-२१", "content_sanskrit": "तेन निद्राव्यमाणानि तव सैन्यानि संयुगे।\nचक्रुरार्तस्वनं घोरं पर्जन्यनिनदोपमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2047510, "chapter_id": 2051, "verse_number": "६-१००-२२", "content_sanskrit": "तं श्रुत्वा निनदं घोरं तव सैन्यस्य भारत।\nमारुतोद्धूतवेगस्य सागरस्येव पर्वणि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2047511, "chapter_id": 2051, "verse_number": "६-१००-२३", "content_sanskrit": "दुर्योधनस्तदा राजन्नार्श्यशृङ्गिमभाषत।\nएष कार्ष्णिर्महाबाहो द्वितीय इव फल्गुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2047512, "chapter_id": 2051, "verse_number": "६-१००-२४", "content_sanskrit": "चमूं द्रावयते क्रोधाद्वृत्रो देवचमूमिव ।\nतस्य चान्यत्र पश्यामि संयुगे भेषजं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2047513, "chapter_id": 2051, "verse_number": "६-१००-२५", "content_sanskrit": "ऋते त्वां राक्षसश्रेष्ठं सर्वविद्यासु पारगम् ।\nस गत्वा त्वरितं वीरं जहि सौभद्रमाहवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2047514, "chapter_id": 2051, "verse_number": "६-१००-२६", "content_sanskrit": "वयं पार्थं हनिष्यामो भीष्मद्रोणपुरोगमाः ।\nस एवमुक्तो बलवान्राक्षसेन्द्रः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2047515, "chapter_id": 2051, "verse_number": "६-१००-२७", "content_sanskrit": "प्रययौ समरे तूर्णं तव पुत्रस्य शासनात्।\nनर्दमानो महानादं प्रावृषीव बलाहकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2047516, "chapter_id": 2051, "verse_number": "६-१००-२८", "content_sanskrit": "तस्य शब्देन महता पाण्डवानां बलं महत् ।\nप्राचलत्सर्वतो राजन्वातोद्धूत इवार्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2047517, "chapter_id": 2051, "verse_number": "६-१००-२९", "content_sanskrit": "बहवश्च महाराज तस्य नादेन भीषिताः।\nप्रियान्प्राणान्परित्यज्य निपेतुर्धरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2047518, "chapter_id": 2051, "verse_number": "६-१००-३०", "content_sanskrit": "कार्ष्णिश्चापि मुदा युक्तः प्रगृह्य सशरं धनुः ।\nनृत्यन्निव रथोपस्थे तद्रक्षः समुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2047519, "chapter_id": 2051, "verse_number": "६-१००-३१", "content_sanskrit": "ततः स राक्षसः क्रुद्धः संप्राप्यैवार्जुनं रणे।\nनातिदूरे स्थितां तस्य द्रावयामास वै चमूम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2047520, "chapter_id": 2051, "verse_number": "६-१००-३२", "content_sanskrit": "तां वध्यमानां च तथा पाण्डवानां महाचमूम्।\nप्रत्यद्ययौ रणे रक्षो देवसेनां यथा बलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2047521, "chapter_id": 2051, "verse_number": "६-१००-३३", "content_sanskrit": "विमर्दः सुमहानासीत्तस्य सैन्यस्य मारिष ।\nरक्षसा घोररूपेण वध्यमानस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2047522, "chapter_id": 2051, "verse_number": "६-१००-३४", "content_sanskrit": "ततः शरसहस्त्रैस्तां पाण्डवानां महाचमूम्।\nव्यद्रावयद्रणे रक्षो दर्शयतत्स्वपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2047523, "chapter_id": 2051, "verse_number": "६-१००-३५", "content_sanskrit": "सा वध्यमाना च तथा पाण्डवानामनीकिनी ।\nरक्षसा घोररूपेण प्रदुद्राव रणे भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2047524, "chapter_id": 2051, "verse_number": "६-१००-३६", "content_sanskrit": "प्रमृद्य च रणे सेनां पद्मिनीं वारणो यथा।\nततोऽभिद्रद्राव रणे द्रौपदेयान्महाबलान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2047525, "chapter_id": 2051, "verse_number": "६-१००-३७", "content_sanskrit": "ते तु क्रुद्धा महेष्वासा द्रौपदेयाः प्रहारिणः।\nराक्षसं दुद्रुवुः सङ्ख्ये ग्रहाः पञ्च रविं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2047526, "chapter_id": 2051, "verse_number": "६-१००-३८", "content_sanskrit": "वीर्यवद्भिस्ततस्तैस्तु पीडितो राक्षसोत्तमः ।\nयथा युगक्षये घोरे चन्द्रमाः पञ्चभिर्ग्रहैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2047527, "chapter_id": 2051, "verse_number": "६-१००-३९", "content_sanskrit": "प्रतिविन्ध्यस्ततो रक्षो बिभेद निशितैः शरैः ।\nसर्वपारशवैस्तूर्णमकुण्ठाग्रैर्महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2047528, "chapter_id": 2051, "verse_number": "६-१००-४०", "content_sanskrit": "स तैर्भिन्नतनुत्राणः शुशुभे राक्षसोत्तमः ।\nमरीचिभिरिवार्कस्य संस्यूतो जलदो महान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2047529, "chapter_id": 2051, "verse_number": "६-१००-४१", "content_sanskrit": "विषक्तैः सशरैश्चापि तपनीयपरिच्छदैः ।\nआर्श्यशृङ्गिर्बभौ राजन्दीप्तशृङ्ग इवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2047530, "chapter_id": 2051, "verse_number": "६-१००-४२", "content_sanskrit": "ततस्ते भ्रातरः पञ्च राक्षसेन्द्रं महाहवे।\nविव्यधुर्निशितैर्बाणैस्तपनीयविभूषितैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2047531, "chapter_id": 2051, "verse_number": "६-१००-४३", "content_sanskrit": "स निर्भिन्नः शरैर्घोरैर्भुजगैः कोपितैरिव ।\nअलम्बुसो भृशं राजन्नागेन्द्र इव चुक्रुधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2047532, "chapter_id": 2051, "verse_number": "६-१००-४४", "content_sanskrit": "सोऽतिविद्धो महाराज मुहूर्तमथ मारिष ।\nप्रविवेश तमो दीर्घं पीडितस्तैर्महारथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2047533, "chapter_id": 2051, "verse_number": "६-१००-४५", "content_sanskrit": "प्रतिलभ्य ततः संज्ञां क्रोधेन द्विगुणीकृतः ।\nचिच्छेद सायकैस्तेषां ध्वजांश्चैव धनूंषि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2047534, "chapter_id": 2051, "verse_number": "६-१००-४६", "content_sanskrit": "एकैकं पञ्चभिर्बाणैराजघान स्मयन्निव ।\nअलम्बुसो रथोपस्थे नृत्यन्निव महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2047535, "chapter_id": 2051, "verse_number": "६-१००-४७", "content_sanskrit": "त्वरमाणः सुसंबद्धो हयांस्तेषां महात्मनाम् ।\nजघान राक्षसः क्रुद्धः सारथींश्च सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2047536, "chapter_id": 2051, "verse_number": "६-१००-४८", "content_sanskrit": "बिभेद च सुसंरब्धः पुनश्चैनान्सुतांशितैः।\nशरैर्बहुविधाकारैः शतशोऽथ सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2047537, "chapter_id": 2051, "verse_number": "६-१००-४९", "content_sanskrit": "विरथांश्च महेष्वासान्कृत्वा तत्र स राक्षसः ।\nअभिदुद्राव वेगेन हन्तुकामो निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2047538, "chapter_id": 2051, "verse_number": "६-१००-५०", "content_sanskrit": "तानर्दितान्रणे तेन राक्षसेन दुरात्मना ।\nदृष्ट्वाऽर्जुनसुतः सङ्ख्ये राक्षसं समुपाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2047539, "chapter_id": 2051, "verse_number": "६-१००-५१", "content_sanskrit": "तयोः समभवद्युद्धं वृत्रवासवयोरिव।\nददृशुस्तावकाः सर्वे पाण्डवाश्च परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2047540, "chapter_id": 2051, "verse_number": "६-१००-५२", "content_sanskrit": "तौ समेतौ महायुद्धे क्रोधदीप्तौ परस्परम्।\nमहाबलौ महाराज क्रोधसंरक्तलोचनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2047541, "chapter_id": 2051, "verse_number": "६-१००-५३", "content_sanskrit": "परस्परमवेक्षेतां कालानलसमौ युधि।\n`आशीविषाविव क्रुद्धौ नेत्राभ्यामितरेतरम् ।\nतयोः समागमो घोरो बभूव कटुकोदयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2047542, "chapter_id": 2051, "verse_number": "६-१००-५४", "content_sanskrit": "यथा देवासुरे युद्धे शक्रशम्बरयोः पुरा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2047543, "chapter_id": 2051, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि नवमदिवसयुद्धे शततमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-१००-१६ लघु सुष्ठु च शीघ्रं शोभनं च यथा स्तात्तथा ॥ ६-१००-२३ आर्ष्यशृङ्गिमलम्बुसम् ॥ ६-१००-३९ सर्वपारशवैः सर्वलोहमयैः ॥ ६-१००-४० संस्यूतो ग्रथितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]