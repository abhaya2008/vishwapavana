[{"id": 2116045, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2116046, "chapter_id": 3499, "verse_number": "१", "content_sanskrit": "स गन्धर्ववचः श्रुत्वा तत् तदा भरतर्षभ ।\nअर्जुनः परया प्रीत्या पूर्णचन्द्र इवाबभौ \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2116047, "chapter_id": 3499, "verse_number": "२", "content_sanskrit": "उवाच च महाप्राज्ञो गन्धर्वं कुरुसत्तमः ।\nजातकौतूलहोऽतीव वसिष्ठस्य तपोबलात् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2116048, "chapter_id": 3499, "verse_number": "३", "content_sanskrit": "वसिष्ठ इति यस्यैतद् ऋषेर्नाम त्वयेरितम् ।\nएतदिच्छाम्यहं श्रोतुं यथावत् तद् ब्रवीतु मे \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2116049, "chapter_id": 3499, "verse_number": "४", "content_sanskrit": "स एष गन्धर्वपते पूर्वेषां नः पुरोहितः ।\nआसीदेतन्ममाचक्ष्व क एष भगवान् ऋषिः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2116050, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2116051, "chapter_id": 3499, "verse_number": "५", "content_sanskrit": "ब्रह्मणो मानसः पुत्रो वसिष्ठोऽरुन्धतीपतिः ।\nअजितावेतौ नरव्याघ्र अजिताः सर्व एव ते \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2116052, "chapter_id": 3499, "verse_number": "६", "content_sanskrit": "कामक्रोधावुभौ यस्य चरणौ संववाहतुः ।\nयस्तु नोच्छेदनं चक्रे कुशिकानामुदारधीः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2116053, "chapter_id": 3499, "verse_number": "७", "content_sanskrit": "विश्वामित्रापराधेन धारयन् मन्युमुत्तमम् ।\nपुत्रव्यसनसन्तप्तः शक्तिमानपि यत् प्रभुः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2116054, "chapter_id": 3499, "verse_number": "८", "content_sanskrit": "विश्वामित्रविनाशाय मेने कर्म न दारुणम् ।\nमृतांश्च पुनराहर्तुं शक्तः पुत्रान् यमक्षयात्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2116055, "chapter_id": 3499, "verse_number": "९", "content_sanskrit": "कृतान्तं नातिचक्राम वेलामिव महोदधिः ।\nयं प्राप्य विजितात्मानं महात्मानं नराधिपाः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2116056, "chapter_id": 3499, "verse_number": "१०", "content_sanskrit": "इक्ष्वाकवो महीपाला लेभिरे पृथिवीमिमाम् ।\nपुरोहितवरं प्राप्य वसिष्ठमृषिमुत्तमम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2116057, "chapter_id": 3499, "verse_number": "११", "content_sanskrit": "ईजिरे क्रतुभिश्चापि नृपास्ते कुरुनन्दन ।\nस हि तान् याजयामास सर्वान् नृपतिसत्तमान् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2116058, "chapter_id": 3499, "verse_number": "१२", "content_sanskrit": "महर्षिः पाण्डवश्रेष्ठ बृहस्पतिरिवामरान् ।\nयथा वसिष्ठेन सह स सौदासः सुसङ्गतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2116059, "chapter_id": 3499, "verse_number": "१३", "content_sanskrit": "रक्षोभिर्विप्रमुक्तस्तु विश्वामित्रेण योजितैः ।\nतथा द्विजसहायान् वै न गन्धर्वा न राक्षसाः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2116060, "chapter_id": 3499, "verse_number": "१४", "content_sanskrit": "शक्ताः प्रार्दयितुं वीर मनसाऽपि महाबलाः ।\nतस्माद् धर्मप्रधानात्मा वेदशास्त्रविदीप्सितः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2116061, "chapter_id": 3499, "verse_number": "१५", "content_sanskrit": "ब्राह्मणो गुणवान् कश्चित् पुरोधाः परिगृह्यताम् ।\nक्षत्रियेण तु जातेन पृथिवीं जेतुमिच्छता \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2116062, "chapter_id": 3499, "verse_number": "१६", "content_sanskrit": "पूर्वं पुरोहितः कार्यः पार्थ राज्यविवृद्धये ।\nमहीं जिहीर्षता राज्ञा ब्रह्म कार्यं पुरस्कृतम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2116063, "chapter_id": 3499, "verse_number": "१७", "content_sanskrit": "नाब्रह्मण्यं भवेत् क्षत्रमब्रह्मण्यं विनश्यति ।\nब्रह्म क्षत्रेण संयुक्तं क्षत्रं ब्रह्मणि निष्ठितम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2116064, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2116065, "chapter_id": 3499, "verse_number": "१८", "content_sanskrit": "किं निमित्तमभूद वैरं विश्वामित्रवसिष्ठयोः ।\nवसतोराश्रमे रम्ये शंस तत् सर्वमेव मे \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2116066, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2116067, "chapter_id": 3499, "verse_number": "१९", "content_sanskrit": "इदं वासिष्ठमाख्यानं पुराणं परिचक्षते ।\nपार्थ सर्वेषु लोकेषु यथावत् तन्निबोध मे \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2116068, "chapter_id": 3499, "verse_number": "२०", "content_sanskrit": "कन्याकुब्जे महानासीत् पार्थिवो भरतर्षभ ।\nगाधीति विश्रुतो लोके सत्यधर्मपरायणः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2116069, "chapter_id": 3499, "verse_number": "२१", "content_sanskrit": "तस्य धर्मात्मनः पुत्रः समृद्धबलवाहनः ।\nविश्वामित्र इति ख्यातो बभूव रिपुनाशनः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2116070, "chapter_id": 3499, "verse_number": "२२", "content_sanskrit": "स चचार सहामात्यो मृगयां सुमहावने ।\nमृगान् निघ्नन् वराहांश्च चचार मरुधन्वसु \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2116071, "chapter_id": 3499, "verse_number": "२३", "content_sanskrit": "व्यायामार्तस्तु स तदा मृगलिप्सुः पिपासितः ।\nआजगाम रथिश्रेष्ठो वसिष्ठस्याश्रमं प्रति \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2116072, "chapter_id": 3499, "verse_number": "२४", "content_sanskrit": "वसिष्ठस्तु स तं दृष्ट्वा राजर्षिमतिथिं तदा ।\nविश्वामित्रं सशिष्यो वै प्रतिजग्राह पूजया \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2116073, "chapter_id": 3499, "verse_number": "२५", "content_sanskrit": "पाद्येनार्घ्यप्रदानेन स्वागतेन च तं नृपम् ।\nप्रतिजग्राह धर्मात्मा वन्येन हविषा तदा \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2116074, "chapter_id": 3499, "verse_number": "२६", "content_sanskrit": "तस्यैव कामधुग् धेनुर्वसिष्ठस्य महात्मनः ।\nउक्ता नन्दिनि धत्स्वेति सा कामान् दुदुहे तदा \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2116075, "chapter_id": 3499, "verse_number": "२७", "content_sanskrit": "बाष्पाढ्यस्योदनस्यात्र राशयः पर्वतोपमाः ।\nनिष्ठानानि च सूपांश्च दधिकुल्यास्तथैव च \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2116076, "chapter_id": 3499, "verse_number": "२८", "content_sanskrit": "अपूपान् घृतसम्पूर्णान् भक्ष्याणां राशयस्तथा ।\nभोजनानि महार्हाणि गौड्यान्नानि सहस्रशः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2116077, "chapter_id": 3499, "verse_number": "२९", "content_sanskrit": "इक्षून् मधूनि लाजांश्च मेरेयांश्च वरासवान् ।\nवस्त्राणि च महार्हाणि कम्बळानि सहस्रशः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2116078, "chapter_id": 3499, "verse_number": "३०", "content_sanskrit": "ग्राम्यारण्यौषधीश्चैव दुदुहे पय एव च ।\nषड्रसं चामृतरसं रसायनमनुत्तमम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2116079, "chapter_id": 3499, "verse_number": "३१", "content_sanskrit": "भोजनीयानि पेयानि भक्ष्याणि विविधानि च ।\nलेह्यान्यमृतकल्पानि चोष्याणि च तथा पुनः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2116080, "chapter_id": 3499, "verse_number": "३२", "content_sanskrit": "तैः कामैः सर्वसम्पन्नैः पूजितः स महीपतिः ।\nसामात्यः सबलस्तत्र तुतोष सुभृशं तदा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2116081, "chapter_id": 3499, "verse_number": "३३", "content_sanskrit": "षडुन्नतां सुपार्श्वोरुं त्रिपृथुं पञ्चसंवृताम् ।\nमण्डूकनेत्रां स्वाकारां पीनौधसमनिन्दिताम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2116082, "chapter_id": 3499, "verse_number": "३४", "content_sanskrit": "सुवालधिं शङ्कुकर्णीं चारुशृङ्गीं मनोरमाम् ।\nअष्टायतशिरोग्रीवां विस्मितः सोऽभिवीक्ष्य ताम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2116083, "chapter_id": 3499, "verse_number": "३५", "content_sanskrit": "अभ्यनन्दत् स तां नन्दीं वसिष्ठस्य यशस्विनीम् ।\nअब्रवीच्च भृशं तुष्टो विश्वामित्र ऋषिं तदा\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2116084, "chapter_id": 3499, "verse_number": "३६", "content_sanskrit": "अर्बुदेन गवां ब्रह्मंस्तथा राज्येन वा पुनः ।\nब्रह्मन्निमां प्रयच्छस्व भुङ्क्ष्व राज्यं महामुने\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2116085, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2116086, "chapter_id": 3499, "verse_number": "३७", "content_sanskrit": "देवताऽतिथितिपित्रर्थे याज्यार्थे च पयस्विनी ।\nअदेया नन्दिनी चेयं राज्येनापि तवानघ \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2116087, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2116088, "chapter_id": 3499, "verse_number": "३८", "content_sanskrit": "रत्नं हि भगवन्नेतद् रत्नहारी च पार्थिवः ।\nक्षत्रियोऽहं भवान् विप्रस्तपःस्वाध्यायसाधनः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2116089, "chapter_id": 3499, "verse_number": "३९", "content_sanskrit": "ब्राह्मणेषु कुतो वीर्यं प्रशान्तेषु धृतात्मसु ।\nअर्बुदेन गवां यस्त्वं न ददासि ममेप्सिताम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2116090, "chapter_id": 3499, "verse_number": "४०", "content_sanskrit": "स्वधर्मं न प्रहास्यामि स नेष्ये ते बलेन गाम् ।\nक्षत्रियोऽस्मि न विप्रोऽहं बाहुवीर्योऽस्मि धर्मतः ।\nतस्माद् भुजबलेनेमां हरिष्यामीह पश्यतः \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2116091, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2116092, "chapter_id": 3499, "verse_number": "४१", "content_sanskrit": "अत्र हव्यं च कव्यं च प्राणयात्रा तथैव च ।\nआयत्तमग्निहोत्रं च आतिथ्यं च न संशयः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2116093, "chapter_id": 3499, "verse_number": "४२", "content_sanskrit": "बहुना किं प्रलापेन न दास्ये कामदोहिनीम् ।\nबलस्थश्चापि राजा च वीर्यवांश्च नृपोत्तम ।\nयथेच्छसि तथा क्षिप्रं कुरु त्वं मा विचारय \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2116094, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2116095, "chapter_id": 3499, "verse_number": "४३", "content_sanskrit": "एवमुक्तस्तदा पार्थ विश्वामित्रो बलादिव ।\nहंसचन्द्रप्रतीकाशां नन्दिनीं वै जहार गाम् \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2116096, "chapter_id": 3499, "verse_number": "४४", "content_sanskrit": "सा तदा ह्रियमाणाऽपि विश्वामित्रबलैर्बलात् ।\nकशादण्डप्रहारैश्च काल्यमाना इतस्ततः \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2116097, "chapter_id": 3499, "verse_number": "४५", "content_sanskrit": "ह्रियमाणा तथा तेन वसिष्ठस्याथ नन्दिनी ।\nउद्यम्याभिमुखी पार्थ तस्थौ भगवदुन्मुखी\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2116098, "chapter_id": 3499, "verse_number": "४६", "content_sanskrit": "भृशं सन्तप्यमानाऽपि नाजगामाश्रमात् ततः ।\nआश्रमान्नैव गच्छन्ती हम्भारावैर्ननाद च\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2116099, "chapter_id": 3499, "verse_number": "४७", "content_sanskrit": "सा तु तेषां बलान्नन्दी बलानां भरतर्षभ ।\nविश्वामित्रभयोद्विग्ना वसिष्ठं समुपागमत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2116100, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2116101, "chapter_id": 3499, "verse_number": "४८", "content_sanskrit": "शृणोमि ते रवं भद्रे रुदन्त्या वै मुहुर्मुहुः ।\nबलाद् ह्रियसि मे नन्दि क्षमावान् ब्राह्मणो ह्यहम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2116102, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "नन्दिनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2116103, "chapter_id": 3499, "verse_number": "४९", "content_sanskrit": "पाषाणदण्डाभिहतां क्रन्दन्तीं मामनाथवत् ।\nविश्वामित्रतपोद्विग्नां भगवन् किमुपेक्षसे \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2116104, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2116105, "chapter_id": 3499, "verse_number": "५०", "content_sanskrit": "एवं तस्यां तथा पार्थ धर्षितायां महामुनिः ।\nन चाक्षुभ्यत न धैर्याच्च विचचाल समादधे\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2116106, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2116107, "chapter_id": 3499, "verse_number": "५१", "content_sanskrit": "क्षत्रियाणां बलं वीर्यं ब्राह्मणानां बलं क्षमा ।\nक्षमा मां भजते यस्माद् गम्यतां यदि रोचते \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2116108, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "नन्दिनी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2116109, "chapter_id": 3499, "verse_number": "५२", "content_sanskrit": "किं नु त्यक्ताऽस्मि भगवन् यदेवं मां प्रभाषसे ।\nन त्यक्ताऽहं त्वया ब्रह्मन्न शक्त्या नयितुं बलात् \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2116110, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "वसिष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2116111, "chapter_id": 3499, "verse_number": "५३", "content_sanskrit": "न त्वां त्यजामि कल्याणि स्थीयतां यदि शक्यते ।\nदृढेन दाम्ना बद्ध्वैव वत्सस्ते ह्रियते बलात् ।\nयेन केनाप्युपायेन त्वया वत्सो निवार्यताम् \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2116112, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2116113, "chapter_id": 3499, "verse_number": "५४", "content_sanskrit": "स्थीयतामिति तच्छ्रुत्वा वसिष्ठश्य यशस्विनी ।\nऊर्ध्वाञ्चितशिरोग्रीवा प्रभावाच्चारुदर्शना \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2116114, "chapter_id": 3499, "verse_number": "५५", "content_sanskrit": "क्रोधरक्तेक्षणा सा गौः हम्भारवघनस्वनैः ।\nविश्वामित्रस्य तत् सैन्यं व्यद्रावयत सर्वशः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2116115, "chapter_id": 3499, "verse_number": "५६", "content_sanskrit": "कशाग्रदण्डाभिहता काल्यमाना इतस्ततः ।\nक्रोधदीप्तेक्षणा क्रोधं भूय एव समादधे \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2116116, "chapter_id": 3499, "verse_number": "५७", "content_sanskrit": "आदित्य इव मध्याह्ने क्रोधदीप्तवपुर्बभौ ।\nअङ्गारवर्षं मुञ्चन्ती मुहुर्वातं मुखाद् वमत् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2116117, "chapter_id": 3499, "verse_number": "५८", "content_sanskrit": "असृजत् पह्लवान् पुच्छात् प्रस्रवाच्छम्बराञ्छकान् ।\nयोनिदेशाच्च यवनान् शकृद्देशाच्छकांस्तथा \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2116118, "chapter_id": 3499, "verse_number": "५९", "content_sanskrit": "मूत्रतश्चासृजच्चापि नन्दिनी क्रोधमूर्छिता ।\nपौण्ड्रान् किरातान् द्रमिळान् सिंहळान् बर्बरांस्तथा \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2116119, "chapter_id": 3499, "verse_number": "६०", "content_sanskrit": "तथैव बर्बरान् म्लेच्छान् फेनतः सा ससर्ज ह ।\nतैर्विसृष्टैर्महासैन्यैर्नानाम्लेच्छगणैस्तथा \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2116120, "chapter_id": 3499, "verse_number": "६१", "content_sanskrit": "नानावरणसञ्छन्नैर्नानायुधधरैस्तथा ।\nअदीर्यत सुसन्नद्धैर्विश्वामित्रस्य पश्यतः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2116121, "chapter_id": 3499, "verse_number": "६२", "content_sanskrit": "एकैकशस्तस्य योधाः पञ्चभिः सप्तभिर्वृताः ।\nशस्त्रवर्षेण महता हन्यमानं बलं ततः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2116122, "chapter_id": 3499, "verse_number": "६३", "content_sanskrit": "प्रभग्नदर्पं सन्त्रस्तं विश्वामित्रस्य पश्यतः ।\nतस्य तच्चतुरङ्गं वै बलं परमदुःसहम् \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2116123, "chapter_id": 3499, "verse_number": "६४", "content_sanskrit": "प्रभग्नं सर्वतो घोरं पयस्विन्या विनिर्जितम् ।\nन च प्राणैर्वियुज्यन्ते नच केचन सैनिकाः \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2116124, "chapter_id": 3499, "verse_number": "६५", "content_sanskrit": "विश्वामित्रस्य सङ्क्रुद्धाद् वसिष्ठाद् भरतर्षभ ।\nविश्वामित्रस्य तत् सैन्यं काल्यमानं त्रियोजनम् \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2116125, "chapter_id": 3499, "verse_number": "६६", "content_sanskrit": "क्रोशमानं भृशोद्विग्नं त्रातारं नाध्यगच्छत ।\nविश्वामित्रस्ततो दृष्ट्वा क्रोधाविष्टः स रोदसी \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2116126, "chapter_id": 3499, "verse_number": "६७", "content_sanskrit": "ववर्ष शरवर्षाणि वसिष्ठे मुनिसत्तमे ।\nघोररूपांश्च नाराचान् क्षुरान् भल्लान् महामुनिः \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2116127, "chapter_id": 3499, "verse_number": "६८", "content_sanskrit": "विश्वामित्रप्रयुक्तांस्तान् वैणवेन व्यमोचयत् ।\nवसिष्ठस्य तदा दृष्ट्वा कर्मकौशलमाहवे \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2116128, "chapter_id": 3499, "verse_number": "६९", "content_sanskrit": "विश्वामित्रोऽपि कोपेन भूयः शत्रुनिपातनः ।\nदिव्यास्त्रवर्षं तस्मै तु प्राहिणोन्मुनये रुषा\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2116129, "chapter_id": 3499, "verse_number": "७०", "content_sanskrit": "आग्नेयं वारुणं चैन्द्रं याम्यं वायव्यमेव च ।\nविससर्ज महाभागे वसिष्ठे ब्रह्मणः सुते \t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2116130, "chapter_id": 3499, "verse_number": "७१", "content_sanskrit": "अस्त्राणि सर्वतो ज्वालां विसृजन्ति प्रपेदिरे ।\nयुगान्तसमये घोराः पतङ्गस्येव रश्मयः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2116131, "chapter_id": 3499, "verse_number": "७२", "content_sanskrit": "वसिष्ठोऽपि महातेजा ब्रह्मशक्तिप्रयुक्तया ।\nयष्ट्या निवारयामास सर्वाण्यस्त्राणि स स्मयन् \t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2116132, "chapter_id": 3499, "verse_number": "७३", "content_sanskrit": "ततस्ते भस्मसाद्भूताः पतन्ति स्म महीतळे ।\nअपोह्य दिव्यान्यस्त्राणि वसिष्ठो वाक्यमब्रवीत् \t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2116133, "chapter_id": 3499, "verse_number": "७४", "content_sanskrit": "निर्जितोऽसि महाराज दुरात्मन् गाधिनन्दन ।\nयदि तेऽस्ति परं शौर्यं तद् दर्शय मयि स्थिते \t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2116134, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2116135, "chapter_id": 3499, "verse_number": "७५", "content_sanskrit": "विश्वामित्रस्तथा चोक्तो वसिष्ठेन नराधिप ।\nनोवाच किञ्चिद् व्रीडाढ्यो विद्रावितमहाबलः\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2116136, "chapter_id": 3499, "verse_number": "७६", "content_sanskrit": "तद् दृष्ट्वा महदाश्चर्यं ब्रह्मतेजोभवं बलम् ।\nविश्वामित्रः क्षत्रभावान्निर्विण्णो वाक्यमब्रवीत् \t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2116137, "chapter_id": 3499, "verse_number": "७७", "content_sanskrit": "धिग् बलं क्षत्रियबलं ब्रह्मतेजोबलं बलम् ।\nबलाबले विनिश्चित्य तप एव परं बलम् \t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2116138, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2116139, "chapter_id": 3499, "verse_number": "७८", "content_sanskrit": "स राज्यं स्फीतमुत्सृज्य तां च दीप्तां नृपश्रियम् ।\nभोगांश्च पृष्ठतः कृत्वा तप एव समाददे \t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2116140, "chapter_id": 3499, "verse_number": "७९", "content_sanskrit": "स गत्वा तपसा सिद्धिं लोकान् विष्टभ्य तेजसा ।\nतताप सर्वान् लोकांश्च ब्राह्मणत्वमवाप च \t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2116141, "chapter_id": 3499, "verse_number": "८०", "content_sanskrit": "अपिबच्च सुतं सोममिन्द्रेण सह कौशिकः ।\nएवंवीर्यस्तु राजर्षिर्विप्रर्षिः सम्बभूव ह \t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2116142, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nअष्टसप्तत्यधिकशततमोऽध्यायः ॥१७८॥ इति चैत्ररथपर्वणि एकादशोऽध्यायः ॥११", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2116143, "chapter_id": 3499, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}]