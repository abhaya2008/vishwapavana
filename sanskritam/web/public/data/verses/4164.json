[{"id": 2146690, "chapter_id": 4164, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146691, "chapter_id": 4164, "verse_number": "१", "content_sanskrit": "तस्मिन्नभिहिते वाक्ये केशवेन महात्मना ।\nस्तिमिता हृष्टरोमाण आसन् सर्वे सभासदः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146692, "chapter_id": 4164, "verse_number": "२", "content_sanskrit": "कश्चिदुत्तरमेतेषां वक्तुं नोत्सहते पुमान् ।\nइति सर्वे मनोभिस्ते चिन्तयन्ति स्म पार्थिवाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146693, "chapter_id": 4164, "verse_number": "३", "content_sanskrit": "तथा तेषु च सर्वेषु तूष्णीम्भूतेषु राजसु ।\nजामदग्न्य इदं वाक्यमब्रवीत् कुरुसंसदि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146694, "chapter_id": 4164, "verse_number": "४", "content_sanskrit": "इमां मे सोपमां वाचं शृणु सत्यामशङ्कितः ।\nतां श्रुत्वा श्रेय आदत्स्व यदि साध्विति मन्यसे\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146695, "chapter_id": 4164, "verse_number": "५", "content_sanskrit": "राजा दम्भोद्भवो नाम सार्वभौमः पुराऽभवत् ।\nअखिलां बुभुजे सर्वां पृथिवीमिति नः श्रुतम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146696, "chapter_id": 4164, "verse_number": "६", "content_sanskrit": "स स्म नित्यं निशापाये प्रातरुत्थाय वीर्यवान् ।\nब्राह्मणान् क्षत्रियान् वैश्यान् पृच्छन्नास्ते महारथः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146697, "chapter_id": 4164, "verse_number": "७", "content_sanskrit": "अस्ति कश्चिद् विशिष्टो वा मद्विधो वा भवेद् युधि ।\nशूद्रो वैश्यः क्षत्रियो वा ब्राह्मणो वाऽपि शस्त्रभृत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146698, "chapter_id": 4164, "verse_number": "समाप्तिः", "content_sanskrit": "इति ब्रुवन्नन्वचरत् स राजा पृथिवीमिमाम् ।\nदर्पेण महता मत्तः कञ्चिदन्यमचिन्तयन्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146699, "chapter_id": 4164, "verse_number": "९", "content_sanskrit": "तं स्म वैद्या अकृपणा ब्राह्मणाः सर्वतोऽभयाः ।\nप्रत्यषेधन्त राजानं श्लाघमानं पुनः पुनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146700, "chapter_id": 4164, "verse_number": "१०", "content_sanskrit": "निषिध्यमानोऽप्यसकृत् पृच्छत्येव स वै द्विजान् ।\nअभिमानी श्रिया मत्तः तमूचुर्ब्राह्मणास्तदा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146701, "chapter_id": 4164, "verse_number": "११", "content_sanskrit": "तपस्विनो महात्मानो वेदव्रतसमन्विताः ।\nउदीर्यमाणं राजानं क्रोधदीप्ता द्विजातयः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146702, "chapter_id": 4164, "verse_number": "१२", "content_sanskrit": "अनेकजननं सख्यं ययोः पुरुषसिंहयोः ।\nतयोस्त्वं न समो युद्धे भवितासि कदाचन\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146703, "chapter_id": 4164, "verse_number": "१३", "content_sanskrit": "एवमुक्तः स राजा तु पुनः पप्रच्छ तान् द्विजान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146704, "chapter_id": 4164, "verse_number": "१४", "content_sanskrit": "क्व तौ वीरौ क्वजन्मानौ किङ्कर्माणौ च कौ च तौ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146705, "chapter_id": 4164, "verse_number": "", "content_sanskrit": "ब्राह्मणाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146706, "chapter_id": 4164, "verse_number": "१५", "content_sanskrit": "नरो नारायणश्चैव तापसाविति नः श्रुतम् ।\nअजातौ मानुषे लोके ताभ्यां युद्ध्यस्व पार्थिव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146707, "chapter_id": 4164, "verse_number": "१६", "content_sanskrit": "श्रूयते तौ महात्मानौ नरनारायणावुभौ ।\nतपो घोरमनिर्देश्यं तप्येते गन्धमादने\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146708, "chapter_id": 4164, "verse_number": "", "content_sanskrit": "जामदग्न्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146709, "chapter_id": 4164, "verse_number": "१७", "content_sanskrit": "स राजा महतीं सेनां योजयित्वा षडङ्गिनीम् ।\nअमृष्यमाणः सम्प्रायाद् यत्र तावपराजितौ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146710, "chapter_id": 4164, "verse_number": "१८", "content_sanskrit": "स गत्वा विषमं घोरं पर्वतं गन्धमादनम् ।\nमार्गमाणोऽभ्यगच्छत् तौ तापसावपराजितौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146711, "chapter_id": 4164, "verse_number": "१९", "content_sanskrit": "तौ दृष्ट्वा क्षुत्पिपासाभ्यां कृशौ धमनिसन्ततौ ।\nशीतवातातपैरुग्रैः कर्शितौ पुरुषोत्तमौ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146712, "chapter_id": 4164, "verse_number": "२०", "content_sanskrit": "अभिवाद्योपसङ्गृह्य पर्यपृच्छदनामयम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146713, "chapter_id": 4164, "verse_number": "२१", "content_sanskrit": "तमर्चित्वा मूलफलैरासनेनोदकेन च ।\nअब्रूतां परवीरघ्नं किं कार्यं क्रियतामिति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146714, "chapter_id": 4164, "verse_number": "", "content_sanskrit": "दम्भोद्भवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2146715, "chapter_id": 4164, "verse_number": "२२", "content_sanskrit": "बाहुभ्यां मे जिता भूमिर्निहताः सर्वशत्रवः ।\nभवद्भ्यां युद्धमाकाङ्क्षन्नुपयातोऽस्मि पर्वतम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2146716, "chapter_id": 4164, "verse_number": "२३", "content_sanskrit": "आतिथ्यं दीयतामेतत् काङ्क्षितं मे चिरं प्रति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2146717, "chapter_id": 4164, "verse_number": "", "content_sanskrit": "नरनारायणौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2146718, "chapter_id": 4164, "verse_number": "२४", "content_sanskrit": "अपेतक्रोधलोभोऽयमाश्रमो राजसत्तम\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2146719, "chapter_id": 4164, "verse_number": "२५", "content_sanskrit": "न ह्यस्मिन्नाश्रमे युद्धं कुतः शस्त्रं कुतोऽनृजुः ।\nअन्यत्र युद्धमाकाङ्क्ष बहवः क्षत्रिया क्षितौ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2146720, "chapter_id": 4164, "verse_number": "", "content_sanskrit": "जामदग्न्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2146721, "chapter_id": 4164, "verse_number": "२६", "content_sanskrit": "उच्यमानस्तथाऽपि स्म भूय एवाभ्यभाषत ।\nपुनः पुनः क्षाम्यमाणः सान्त्व्यमानश्च भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2146722, "chapter_id": 4164, "verse_number": "२७", "content_sanskrit": "दम्भोद्भवो युद्धमिच्छन्नाह्वयत्येव तापसौ\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2146723, "chapter_id": 4164, "verse_number": "२८", "content_sanskrit": "ततो नरस्त्विषीकाणां मुष्टिमादाय भारत ।\nअब्रवीदेहि युद्ध्यस्व युद्धकाम मया सह\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2146724, "chapter_id": 4164, "verse_number": "२९", "content_sanskrit": "सर्वशस्त्राणि चादत्स्व योजयस्व च वाहिनीम् ।\nसन्नह्यस्व च वर्माणि यानि चान्यानि सन्ति ते\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2146725, "chapter_id": 4164, "verse_number": "३०", "content_sanskrit": "अहं हि ते विनेष्यामि युद्धश्रद्धामितः परम् ।\nयदाह्वयसि दर्पेण ब्राह्मणप्रमुखान् जनान्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2146726, "chapter_id": 4164, "verse_number": "", "content_sanskrit": "दम्भोद्भवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2146727, "chapter_id": 4164, "verse_number": "३१", "content_sanskrit": "यद्येतदस्त्रमस्मासु युक्तं तापस मन्यसे ।\nएतेनापि त्वया योत्स्ये युद्धार्थी ह्यहमागतः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2146728, "chapter_id": 4164, "verse_number": "", "content_sanskrit": "जामदग्न्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2146729, "chapter_id": 4164, "verse_number": "३२", "content_sanskrit": "इत्युक्त्वा शरवर्षेण सर्वतः समवाकिरत् ।\nदम्भोद्भवस्तापसौ तौ जिघांसुर्बलदर्पितः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2146730, "chapter_id": 4164, "verse_number": "३३", "content_sanskrit": "तस्य तानस्यतः क्षिप्रमिषून् परतनुच्छिदः ।\nकदर्थीकृत्य स मुनिरिषीकाभिरपानुदत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2146731, "chapter_id": 4164, "verse_number": "३४", "content_sanskrit": "ततोऽस्मै प्रासृजद् घोरमैषीकमपराजितः ।\nअस्त्रमप्रतिसन्धेयं तदद्भुतमिवाभवत्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2146732, "chapter_id": 4164, "verse_number": "३५", "content_sanskrit": "तेषामक्षीणि कर्णांश्च नासिकाश्चैव मायया ।\nनिमित्तवेधी स मुनिरिषीकाभिः समर्पयत्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2146733, "chapter_id": 4164, "verse_number": "३६", "content_sanskrit": "स दृष्ट्वा स्फीतमाकाशमिषीकाभिः समाचितम् ।\nपादयोर्न्यपतद् राजा स्वस्ति मेऽस्त्विति चाब्रवीत्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2146734, "chapter_id": 4164, "verse_number": "३७", "content_sanskrit": "तमब्रवीन्नरो राजन् शरण्यः शरणैषिणाम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2146735, "chapter_id": 4164, "verse_number": "३८", "content_sanskrit": "ब्रह्मण्यो भव धर्मात्मा मा च स्मैवं पुनः कृथाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2146736, "chapter_id": 4164, "verse_number": "३९", "content_sanskrit": "मा च दर्पसमाविष्टः क्षेप्सीः कांश्चित् कदाचन ।\nसदृशान् श्रेयसो वाऽपि तत् ते राजन् समाहितम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2146737, "chapter_id": 4164, "verse_number": "४०", "content_sanskrit": "जितक्रोधः कृतप्रज्ञो निरहङ्कार आत्मवान् ।\nदान्तः शान्तो मृदुः क्षेमं प्रजाः पालय सर्वदा\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2146738, "chapter_id": 4164, "verse_number": "४१", "content_sanskrit": "मा स्म भूयः क्षिपेः कञ्चिदविदित्वा बलाबलम् ।\nअनुज्ञातः स्वस्ति गच्छ स्वगृहं राजसत्तम\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2146739, "chapter_id": 4164, "verse_number": "४२", "content_sanskrit": "कुशलं ब्राह्मणान् पृच्छेरावयोर्वचनाद् भृशम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2146740, "chapter_id": 4164, "verse_number": "", "content_sanskrit": "जामदग्न्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2146741, "chapter_id": 4164, "verse_number": "४३", "content_sanskrit": "ततो राजा तयोः पादावभिवाद्य महात्मनोः ।\nप्रत्याजगाम स्वपुरं धर्मं चैवाचरद् भृशम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2146742, "chapter_id": 4164, "verse_number": "४४", "content_sanskrit": "तस्माद् यावद् धनुःश्रेष्ठे गाण्डीवेऽस्त्रं न युज्यते ।\nतावत् त्वं मानमुत्सृज्य गच्छ राजन् धनञ्जयम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2146743, "chapter_id": 4164, "verse_number": "४५", "content_sanskrit": "कङ्कुदीपं कङ्कुलासमक्षिसन्तर्जनं तथा ।\nसन्तानं नर्तकं घोरं हास्यमौदकमष्टमम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2146744, "chapter_id": 4164, "verse_number": "४६", "content_sanskrit": "एतैर्विद्धाः सर्व एव मरणं यान्ति मानवाः ।\nउन्मत्ताश्च विचेष्टन्ते नष्टसञ्ज्ञा विचेतसः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2146745, "chapter_id": 4164, "verse_number": "४७", "content_sanskrit": "स्वपन्ति च प्लवन्ते च च्छर्दयन्ति च मानवाः ।\nमूत्रयन्ते च सततं रुदन्ति च हसन्ति च\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2146746, "chapter_id": 4164, "verse_number": "४८", "content_sanskrit": "असङ्ख्येया गुणाः पार्थे तद्विशिष्टो जनार्दनः ।\nत्वमेव भूयो जानासि कुन्तीपुत्रं धनञ्जयम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2146747, "chapter_id": 4164, "verse_number": "४९", "content_sanskrit": "नरनारायणौ यौ तौ तावेवार्जुनकेशवौ ।\nविजानीहि महाराज प्रवीरौ पुरुषोत्तमौ\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2146748, "chapter_id": 4164, "verse_number": "५०", "content_sanskrit": "यद्येतदेवं जानासि न च मामभिशङ्कसे ।\nआर्यां मतिं समास्थाय शाम्य भारत पाण्डवैः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2146749, "chapter_id": 4164, "verse_number": "५१", "content_sanskrit": "अथ चेन्मन्यसे श्रेयो न मे भेदो भवेदिति ।\nप्रशाम्य भरतश्रेष्ठ मा च युद्धे मनः कृथाः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2146750, "chapter_id": 4164, "verse_number": "५२", "content_sanskrit": "निर्माता सर्वलोकानामीश्वरः सर्वलोककृत् ।\nयस्य नारायणो बन्धुरर्जुनो दुःसहो युधि\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2146751, "chapter_id": 4164, "verse_number": "५३", "content_sanskrit": "कः समुत्सहते जेतुं त्रिषु लोकेषु भारत ।\nवीरं कपिध्वजं जिष्णुं यस्य नास्ति समो युधि\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2146752, "chapter_id": 4164, "verse_number": "५४", "content_sanskrit": "भवतां च कुरुश्रेष्ठ कुलं बहुमतं भुवि ।\nतत् तथैवास्तु भद्रं ते स्वार्थमत्रानुचिन्तय\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2146753, "chapter_id": 4164, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि पञ्चनवतितमोऽध्यायः ॥९५॥\nभगवद्यानपर्वणि षड्विंशोऽध्यायः ॥२६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]