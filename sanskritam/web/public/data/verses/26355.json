[{"id": 7006355000, "chapter_id": 26355, "verse_number": "२-११-१", "content_sanskrit": "वैशम्पायन उवाच\nकदाचित् तु तदा कृष्णो विना संकर्षणेन वै ।\nचचार तद् वनं रम्यं कामरूपी वराननः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006355001, "chapter_id": 26355, "verse_number": "२-११-२", "content_sanskrit": "काकपक्षधरः श्रीमाञ्छ्यामः पद्मदलेक्षणः ।\nश्रीवत्सेनोरसा युक्तः शशाङ्क इव लक्ष्मणा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006355002, "chapter_id": 26355, "verse_number": "२-११-३", "content_sanskrit": "साङ्गदेनाग्रहस्तेन पङ्कजोद्भिन्नवर्चसा ।\nसुकुमाराभिताम्रेण क्रान्तविक्रान्तगामिना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006355003, "chapter_id": 26355, "verse_number": "२-११-४", "content_sanskrit": "पीते प्रीतिकरे नॄणां पद्मकिञ्जल्कसप्रभे ।\nसूक्ष्मे वसानो वसने ससंध्य इव तोयदः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006355004, "chapter_id": 26355, "verse_number": "२-११-५", "content_sanskrit": "वत्सव्यापारयुक्ताभ्यां व्यग्राभ्यां गण्डरज्जुभिः ।\nभुजाभ्यां साधुवृत्ताभ्यां पूजिताभ्यां दिवौकसैः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006355005, "chapter_id": 26355, "verse_number": "२-११-६", "content_sanskrit": "सदृशं पुण्डरीकस्य गन्धेन कमलस्य च ।\nरराज चास्य तद् बाल्ये रुचिरौष्ठपुटं मुखम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006355006, "chapter_id": 26355, "verse_number": "२-११-७", "content_sanskrit": "शिखाभिस्तस्य मुक्ताभी रराज मुखपङ्कजम् ।\nवृतं षट्पदपंक्तीभिर्यथा स्यात् पद्ममण्डलम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006355007, "chapter_id": 26355, "verse_number": "२-११-८", "content_sanskrit": "तस्यार्जुनकदम्बाख्या नीपकन्दलमालिनी ।\nरराज माला शिरसि नक्षत्राणां यथा दिवि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006355008, "chapter_id": 26355, "verse_number": "२-११-९", "content_sanskrit": "स तया मालया वीरः शुशुभे कण्ठसक्तया ।\nमेघमालाम्बुदश्यामो नभस्य इव मूर्तिमान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006355009, "chapter_id": 26355, "verse_number": "२-११-१०", "content_sanskrit": "एकेनामलपत्रेण कण्ठसूत्रावलम्बिना ।\nरराज बर्हिपत्रेण मन्दमारुतकम्पिना ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006355010, "chapter_id": 26355, "verse_number": "२-११-११", "content_sanskrit": "क्वचिद्गायन्क्वचित्क्रीडंश्चञ्चूर्यंश्च क्वचित्क्वचित् ।\nपर्णवाद्यं श्रुतिसुखं वादयंश्च क्वचिद् वने ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006355011, "chapter_id": 26355, "verse_number": "२-११-१२", "content_sanskrit": "गोपवेणुं सुमधुरं कामात् तमपि वादयन् ।\nप्रह्लादनार्थं च गवां क्वचिद् वनगतो युवा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006355012, "chapter_id": 26355, "verse_number": "२-११-१३", "content_sanskrit": "गोकुलेऽम्बुधरश्यामश्चचार द्युतिमान् प्रभुः ।\nरेमे च तत्र रम्यासु चित्रासु वनराजिषु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006355013, "chapter_id": 26355, "verse_number": "२-११-१४", "content_sanskrit": "मयूररवघुष्टासु मदनोद्दीपनीषु च ।\nमेघनादप्रतिव्यूहेर्नादितासु समन्ततः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006355014, "chapter_id": 26355, "verse_number": "२-११-१५", "content_sanskrit": "शाद्वलच्छत्रमार्गासु शिलीन्ध्राभरणासु च ।\nकन्दलामलपत्रासु स्रवन्तीषु नवं जलम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006355015, "chapter_id": 26355, "verse_number": "२-११-१६", "content_sanskrit": "केसराणां नवैर्गन्धैर्मदनिःश्वसितोपमैः ।\nअभीक्ष्णं निःश्वसन्तीषु कामिनीष्विव नित्यशः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006355016, "chapter_id": 26355, "verse_number": "२-११-१७", "content_sanskrit": "सेव्यमानो नवैर्वातैर्द्रुमसंघातनिःसृतैः ।\nतासु कृष्णो मुदं लेभे सौम्यासु वनराजिषु ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006355017, "chapter_id": 26355, "verse_number": "२-११-१८", "content_sanskrit": "स कदाचिद् वने तस्मिन्गोभिः सह परिभ्रमन् ।\nददर्श विपुलोदग्रं शाखिनं शाखिनां वरम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006355018, "chapter_id": 26355, "verse_number": "२-११-१९", "content_sanskrit": "स्थितं धरण्यां मेघाभं निबिडं पत्रसंचयैः ।\nगगनार्धोच्छ्रिताकारं पर्वताभोगधारिणम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006355019, "chapter_id": 26355, "verse_number": "२-११-२०", "content_sanskrit": "नीलचित्राङ्गवर्णैश्च सेवितं बहुभिः खगैः ।\nफलैः प्रवालैश्च घनैः सेन्द्रचापघनोपमम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006355020, "chapter_id": 26355, "verse_number": "२-११-२१", "content_sanskrit": "भवनाकारविटपं लतापुष्पसुमण्डितम् ।\nविशालमूलावनतं पवनाम्भोदधारिणम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006355021, "chapter_id": 26355, "verse_number": "२-११-२२", "content_sanskrit": "आधिपत्यमिवान्येषां तस्य देशस्य शाखिनाम् ।\nकुर्वाणं शुभकर्माणं निरावर्षमनातपम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006355022, "chapter_id": 26355, "verse_number": "२-११-२३", "content_sanskrit": "न्यग्रोधं पर्वताग्राभं भाण्डीरं नाम नामतः ।\nदृष्ट्वा तत्र मतिं चक्रे निवासाय ततः प्रभुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006355023, "chapter_id": 26355, "verse_number": "२-११-२४", "content_sanskrit": "स तत्र वयसा तुल्यैर्वत्सपालैः सहानघ ।\nरेमे वै वासरं कृष्णः पुरा स्वर्गगतो यथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006355024, "chapter_id": 26355, "verse_number": "२-११-२५", "content_sanskrit": "तं क्रीडमानं गोपालाः कृष्णं भाण्डीरवासिनम् ।\nरमयन्ति स्म बहवो वन्यैः क्रीडनकैस्तदा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006355025, "chapter_id": 26355, "verse_number": "२-११-२६", "content_sanskrit": "अन्ये स्म परिगायन्ति गोपा मुदितमानसाः ।\nगोपालाः कृष्णमेवान्ये गायन्ति स्म रतिप्रियाः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006355026, "chapter_id": 26355, "verse_number": "२-११-२७", "content_sanskrit": "तेषां स गायतामेव वादयामास वीर्यवान् ।\nपर्णवाद्यान्तरे वेणुं तुम्बीं वीणां च तत्र ह ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006355027, "chapter_id": 26355, "verse_number": "२-११-२८", "content_sanskrit": "कदाचिच्चारयन्नेव गाः स गोवृषभेक्षणः ।\nजगाम यमुनातीरं लतालंकृतपादपम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006355028, "chapter_id": 26355, "verse_number": "२-११-२९", "content_sanskrit": "तरङ्गापाङ्गकुटिलां वारिस्पर्शसुखानिलाम् ।\nतां च पद्मोत्पलवतीं ददर्श यमुनां नदीम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006355029, "chapter_id": 26355, "verse_number": "२-११-३०", "content_sanskrit": "सुतीर्थां स्वादुसलिलां ह्रदिनीं वेगगामिनीम् ।\nतोयवातोद्यतैर्वेगैरवनामितपादपाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006355030, "chapter_id": 26355, "verse_number": "२-११-३१", "content_sanskrit": "हंसकारण्डवोद्घुष्टा सारसैश्च निनादिताम् ।\nअन्योन्यमिथुनैश्चैव सेवितां मिथुनेचरैः ॥ ३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006355031, "chapter_id": 26355, "verse_number": "२-११-३२", "content_sanskrit": "जलजैः प्राणिभिः कीर्णां जलजैर्भूषितां गुणैः ।\nजलजैः कुसुमैश्चित्रां जलजैर्हरितोदकाम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006355032, "chapter_id": 26355, "verse_number": "२-११-३३", "content_sanskrit": "प्रसृतस्रोतचरणां पुलिनश्रोणिमण्डलाम् ।\nआवर्तनाभिगम्भीरां पद्मरोमानुरञ्जिताम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006355033, "chapter_id": 26355, "verse_number": "२-११-३४", "content_sanskrit": "तटच्छेदोदरां कान्तां त्रितरङ्गवलीधराम् ।\nफेनप्रहृष्टवदनां प्रसन्नां हंसहासिनीम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006355034, "chapter_id": 26355, "verse_number": "२-११-३५", "content_sanskrit": "रुचिरोत्पलरक्तोष्ठीं नतभ्रूं जलजेक्षणाम् ।\nह्रददीर्घललाटान्तां कान्तां शैवलमूर्द्धजाम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006355035, "chapter_id": 26355, "verse_number": "२-११-३६", "content_sanskrit": "चक्रवाकस्तनतटीं तीरपार्श्वायताननाम् ।\nदीर्घस्रोतायतभुजामाभोगश्रवणायुताम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006355036, "chapter_id": 26355, "verse_number": "२-११-३७", "content_sanskrit": "कारण्डवाकुण्डलिनीं श्रीमत्पङ्कजलोचनाम् ।\nतटजाभरणोपेतां मीननिर्मलमेखलाम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006355037, "chapter_id": 26355, "verse_number": "२-११-३८", "content_sanskrit": "वारिप्लवप्लवक्षौमां सारसारावनूपुराम् ।\nकाशचामीकरं वासो वसानां हंसलक्षणम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006355038, "chapter_id": 26355, "verse_number": "२-११-३९", "content_sanskrit": "भीमनक्रानुलिप्ताङ्गीं कूर्मलक्षणभूषिताम् ।\nनिपानश्वापदापीडां नृभिः पीतपयोधराम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006355039, "chapter_id": 26355, "verse_number": "२-११-४०", "content_sanskrit": "श्वापदोच्छिष्टसलिलामाश्रमस्थानसंकुलाम् ।\nतां समुद्रस्य महिषीमीक्षमाणः समन्ततः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006355040, "chapter_id": 26355, "verse_number": "२-११-४१", "content_sanskrit": "चचार रुचिरं कृष्णो यमुनामुपशोभयन् ।\nतां चरन्स नदीं श्रेष्ठां ददर्श ह्रदमुत्तमम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006355041, "chapter_id": 26355, "verse_number": "२-११-४२", "content_sanskrit": "दीर्घं योजनविस्तारं दुस्तरं त्रिदशैरपि ।\nगम्भीरमक्षोभ्यजलं निष्कम्पमिव सागरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006355042, "chapter_id": 26355, "verse_number": "२-११-४३", "content_sanskrit": "तोयजैः श्वापदैस्त्यक्तं शून्यं तोयचरैः खगैः ।\nअगाधेनाम्भसा पूर्णं मेघपूर्णमिवाम्बरम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006355043, "chapter_id": 26355, "verse_number": "२-११-४४", "content_sanskrit": "दुःखोपसर्प्यं तीरेषु ससर्पैर्विपुलैर्बिलैः ।\nविषारणिभवस्याग्नेर्धूमेन परिवेष्टितम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006355044, "chapter_id": 26355, "verse_number": "२-११-४५", "content_sanskrit": "अभोग्यं तत् पशूनां हि अपेयं च जलार्थिनाम् ।\nउपभोगैः परित्यक्तं सुरैस्त्रिषवणार्थिभिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006355045, "chapter_id": 26355, "verse_number": "२-११-४६", "content_sanskrit": "आकाशादप्यसंचार्यं खगैराकाशगोचरैः ।\nतृणेष्वपि पतत्स्वप्सु ज्वलन्तमिव तेजसा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006355046, "chapter_id": 26355, "verse_number": "२-११-४७", "content_sanskrit": "समन्ताद्योजनं साग्रं देवैरपि दुरासदम् ।\nविषानलेन घोरेण ज्वालाप्रज्वलितद्रुमम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006355047, "chapter_id": 26355, "verse_number": "२-११-४८", "content_sanskrit": "व्रजस्योत्तरतस्तस्य क्रोशमात्रे निरामये ।\nतं दृष्ट्वा चिन्तयामास कृष्णो वै विपुलं ह्रदम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006355048, "chapter_id": 26355, "verse_number": "२-११-४९", "content_sanskrit": "अगाधं द्योतमानं च कस्यायं महतो ह्रदः ।\nअस्मिन् स कालियो नाम कालाञ्जनचयोपमः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006355049, "chapter_id": 26355, "verse_number": "२-११-५०", "content_sanskrit": "उरगाधिपतिः साक्षाद्ध्रदे वसति दारुणः ।\nउत्सृज्य सागरावासं यो मया विदितः पुरा ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006355050, "chapter_id": 26355, "verse_number": "२-११-५१", "content_sanskrit": "भयात् पतगराजस्य सुपर्णस्योरगाशिनः ।\nतेनेयं दूषिता सर्वा यमुना सागरङ्गमा ॥ ५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006355051, "chapter_id": 26355, "verse_number": "२-११-५२", "content_sanskrit": "भयात् तस्योरगपतेर्नायं देशो निषेव्यते ।\nतदिदं दारुणाकारमरण्यं रूढशाद्वलम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006355052, "chapter_id": 26355, "verse_number": "२-११-५३", "content_sanskrit": "सावरोहद्रुमं घोरं कीर्णं नानालताद्रुमैः ।\nरक्षितं सर्पराजस्य सचिवैराप्तकारिभिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006355053, "chapter_id": 26355, "verse_number": "२-११-५४", "content_sanskrit": "वनं निर्विषयाकारं विषान्नमिव दुःस्पृशम् ।\nतैराप्तकारिभिर्नित्यं सर्वतः परिरक्षितम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006355054, "chapter_id": 26355, "verse_number": "२-११-५५", "content_sanskrit": "शैवालनलिनैश्चापि वृक्षैः क्षुद्रलताकुलैः ।\nकर्तव्यमार्गौ भ्राजेते हृदस्यास्य तटावुभौ ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006355055, "chapter_id": 26355, "verse_number": "२-११-५६", "content_sanskrit": "तदस्य सर्पराजस्य कर्तव्यो निग्रहो मया ।\nयथेयं सरिदम्भोदा भवेच्छिवजलाशया ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006355056, "chapter_id": 26355, "verse_number": "२-११-५७", "content_sanskrit": "व्रजोपभोग्या च यथा नागे च दमिते मया ।\nसर्वत्र सुखसंचारा सर्वतीर्थसुखाश्रया ॥ ५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006355057, "chapter_id": 26355, "verse_number": "२-११-५८", "content_sanskrit": "एतदर्थं च वासोऽयं व्रजेऽस्मिन् गोपजन्म च ।\nअमीषामुत्पथस्थानां निग्रहार्थं दुरात्मनाम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006355058, "chapter_id": 26355, "verse_number": "२-११-५९", "content_sanskrit": "एनं कदम्बमारुह्य तदेव शिशुलीलया ।\nविनिपत्य ह्रदे घोरे दमयिष्यामि कालियम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006355059, "chapter_id": 26355, "verse_number": "२-११-६०", "content_sanskrit": "एवं कृते बाहुवीर्ये लोके ख्यातिं गमिष्यति ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}]