[{"id": 7002282000, "chapter_id": 22282, "verse_number": "३२७-१", "content_sanskrit": "ईश्वर उवाच ।\nव्रतेश्वरांश्च सत्यादीनिष्ट्वा व्रतसम्र्पणम् ।\nअरिष्टशमने शस्तमरिष्टं सूत्रनायकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002282001, "chapter_id": 22282, "verse_number": "३२७-२", "content_sanskrit": "हेमरत्नमयं भूत्यै महाशङ्खञ्च मारणे ।\nआप्यायने शङ्खसूत्रं मौक्तिकं पूत्रवर्द्धनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002282002, "chapter_id": 22282, "verse_number": "३२७-३", "content_sanskrit": "स्फाटिकं भूतिदं कौशं मुक्तिदं रुद्रनेत्रजं ।\nधात्रीफलप्रमाणेन रुद्राक्षं चोत्तमन्ततः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002282003, "chapter_id": 22282, "verse_number": "३२७-४", "content_sanskrit": "समेरुं मेरुहीनं वा सूत्रं जप्यन्तु मानसम् ।\nअनामाङ्गुष्ठमाक्रम्य जपं भाष्यन्तु कारयेत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002282004, "chapter_id": 22282, "verse_number": "३२७-५", "content_sanskrit": "तर्ज्जन्यङ्गुष्ठमाक्रम्य न मेरुं लङ्घयेज्जपे ।\nप्रमादात् पतिते सूत्रे जप्तव्यन्तु शतद्वयम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002282005, "chapter_id": 22282, "verse_number": "३२७-६", "content_sanskrit": "सर्ववाद्यमयी घण्टा तस्या वादनमर्थकृत् ।\nगोशकृन्मूत्रवल्मीकमृत्तिकाभस्मवारिभिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002282006, "chapter_id": 22282, "verse_number": "३२७-७", "content_sanskrit": "वेस्मायतनलिङ्गादेः कार्य्यमेवं विशोधनम् ।\nस्कन्दो नमः शिवायेति मन्त्रः सर्व्वार्थसाधकः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002282007, "chapter_id": 22282, "verse_number": "३२७-८", "content_sanskrit": "गीतः पञ्चाक्षरो वेदे लोके गीतः षड़क्षरः ।\nओमित्यन्ते स्थितः शम्भुर्म्मुद्रार्थं वटवीजवत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002282008, "chapter_id": 22282, "verse_number": "३२७-९", "content_sanskrit": "क्रमान्नमः शिवायेति ईशानाद्यानि वै विदुः ।\nषड़क्षरस्य सूत्रस्य भाष्यद्विद्याकदम्बकं ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002282009, "chapter_id": 22282, "verse_number": "३२७-१०", "content_sanskrit": "यदोंनमः शिवायेति एतावत् परमं पदम् ।\nअनेन पूजयेल्लिङ्गं लिङ्गे यस्मात् स्थितः शिवः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002282010, "chapter_id": 22282, "verse_number": "३२७-११", "content_sanskrit": "अनुग्रहाय लोकानां धर्म्मकामार्थमुक्तिदः ।\nयो न पूजयते लिङ्गन्न स धर्म्मादिभाजनं ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002282011, "chapter_id": 22282, "verse_number": "३२७-१२", "content_sanskrit": "लिङ्गार्च्चनाद्भुक्तिमुक्तिर्यावज्जीवमतो यजेत् ।\nवरं प्राणपरित्यागो भुञ्जीतापूज्य नैव तं ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002282012, "chapter_id": 22282, "verse_number": "३२७-१३", "content_sanskrit": "रुद्रस्य पूजनाद्रुद्रो विष्णुः स्याद्विष्णुपूजनात् ।\nसूर्य्यः स्यात् सूर्य्यपूजातः शक्त्यादिः शक्तिपूजनात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002282013, "chapter_id": 22282, "verse_number": "३२७-१४", "content_sanskrit": "सर्वयज्ञतपोदाने तीर्थे वेदेषु यत् फलं ।\nतत् फलं कोटिगुणितं स्थाप्य लिङ्गं लभेन्नरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002282014, "chapter_id": 22282, "verse_number": "३२७-१५", "content_sanskrit": "त्रिसन्ध्यं योर्च्चयेल्लिङ्गं कृत्वा विल्वेन पार्थिवम् ।\nशतैकादशिकं यावत् कुलमुद्धृत्य नाकभाक् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002282015, "chapter_id": 22282, "verse_number": "३२७-१६", "content_sanskrit": "भक्त्या वित्तानुसारेण कुर्य्यात् प्रासादसञ्चयम् ।\nअल्पे महति वा तुल्यफलमाढ्यदरिद्रयोः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002282016, "chapter_id": 22282, "verse_number": "३२७-१७", "content_sanskrit": "भागद्वयञ्च धर्मार्थं कल्पयेज्जीवनाय च ।\nधनस्य भागमेकन्तु अनित्यं जीवितं यतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002282017, "chapter_id": 22282, "verse_number": "३२७-१८", "content_sanskrit": "त्रिसप्तकुलमुद्धृत्य देवागारकृदर्थंभाक् ।\nमृत्कष्ठेष्टकशैलाद्यैः क्रमात् कोटिगुणं फलम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002282018, "chapter_id": 22282, "verse_number": "३२७-१९", "content_sanskrit": "अष्टेष्टकसुरागारकारी स्वर्गमवाप्नुयात् ।\nपांशुना क्रीडमानोपि देवागारकृदर्थभाक् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]