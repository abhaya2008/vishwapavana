[{"id": 7001167000, "chapter_id": 21167, "verse_number": "२-३-१५-१", "content_sanskrit": "ब्रह्मोवाच ।\nअथ सा गर्भमाधत्त वरांगी तत्पुरादरात् ।\nस ववर्द्धाभ्यंतरे हि बहुवर्षैः सुतेजसा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001167001, "chapter_id": 21167, "verse_number": "२-३-१५-२", "content_sanskrit": "ततः सा समये पूर्णे वरांगी सुषुवे सुतम् ।\nमहाकायं महावीर्यं प्रज्वलंतं दिशो दश॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001167002, "chapter_id": 21167, "verse_number": "२-३-१५-३", "content_sanskrit": "तदैव च महोत्पाता बभूवुर्दुःखहेतवः ।\nजायमाने सुते तस्मिन्वरांग्यात्सुखदुःखदे॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001167003, "chapter_id": 21167, "verse_number": "२-३-१५-४", "content_sanskrit": "दिवि भुव्यंतरिक्षे च सर्वलोकभयंकराः ।\nअनर्थसूचकास्तात त्रिविधास्तान्ब्रवीम्यहम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001167004, "chapter_id": 21167, "verse_number": "२-३-१५-५", "content_sanskrit": "सोल्काश्चाशनयः पेतुर्महाशब्दा भयंकराः ।\nउदयं चक्रुरुत्कृष्टाः केतवो दुःखदायकाः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001167005, "chapter_id": 21167, "verse_number": "२-३-१५-६", "content_sanskrit": "चचाल वसुधा साद्रिर्जज्वलुस्सकला दिशः ।\nचुक्षुभुस्सरितस्सर्वाः सागराश्च विशेषतः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001167006, "chapter_id": 21167, "verse_number": "२-३-१५-७", "content_sanskrit": "हूत्करानीरयन्धीरान्खरस्पर्शो मरुद्ववौ ।\nउन्मूलयन्महावृक्षान्वात्यानीकोरजोध्वजः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001167007, "chapter_id": 21167, "verse_number": "२-३-१५-८", "content_sanskrit": "सराह्वोस्सूर्य्यविध्वोस्तु मुहुः परिधयोऽभवन् ।\nमहाभयस्य विप्रेन्द्र सूचकास्सुखहारकः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001167008, "chapter_id": 21167, "verse_number": "२-३-१५-९", "content_sanskrit": "महीध्रविवरेभ्यश्च निर्घाता भयसूचकाः ।\nरथनिर्ह्रादतुल्याश्च जज्ञिरेऽवसरे ततः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001167009, "chapter_id": 21167, "verse_number": "२-३-१५-१०", "content_sanskrit": "सृगालोलूकटंकारैर्वमन्त्यो मुखतोऽनलम् ।\nअंतर्ग्रामेषु विकटं प्रणेदुरशिवाश्शिवाः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001167010, "chapter_id": 21167, "verse_number": "२-३-१५-११", "content_sanskrit": "यतस्ततो ग्रामसिंहा उन्नमय्य शिरोधराम् ।\nसंगीतवद्रोदनवद्व्यमुचन्विविधान्रवान्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001167011, "chapter_id": 21167, "verse_number": "२-३-१५-१२", "content_sanskrit": "खार्काररभसा मत्ताः सुरैर्घ्नंतो रसांखराः ।\nवरूथशस्तदा तात पर्यधावन्नितस्ततः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001167012, "chapter_id": 21167, "verse_number": "२-३-१५-१३", "content_sanskrit": "खगा उदपतन्नीडाद्रासभत्रस्तमानसः ।\nक्रोशंतो व्यग्रचित्ताश्च स्थितमापुर्न कुत्रचित्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001167013, "chapter_id": 21167, "verse_number": "२-३-१५-१४", "content_sanskrit": "शकृन्मूत्रमकार्षुश्च गोष्ठेऽरण्ये भयाकुलः ।\nबभ्रमुः स्थितिमापुर्नो पशवस्ताडिता इव॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001167014, "chapter_id": 21167, "verse_number": "२-३-१५-१५", "content_sanskrit": "गावोऽत्रसन्नसृग्दोहा वाष्पनेत्रा भयाकुलाः ।\nतोयदा अभवंस्तत्र भयदाः पूयवर्षिणः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001167015, "chapter_id": 21167, "verse_number": "२-३-१५-१६", "content_sanskrit": "व्यरुदन्प्रतिमास्तत्र देवानामुत्पतिष्णवः ।\nविनाऽनिलं द्रुमाः पेतुर्ग्रहयुद्धं बभूव खे॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001167016, "chapter_id": 21167, "verse_number": "२-३-१५-१७", "content_sanskrit": "इत्यादिका बहूत्पाता जज्ञिरे मुनिसत्तम ।\nअज्ञानिनो जनास्तत्र मेनिरे विश्वसंप्लवम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001167017, "chapter_id": 21167, "verse_number": "२-३-१५-१८", "content_sanskrit": "अथ प्रजापतिर्नामाकरोत्तस्यासुरस्य वै ।\nतारकेति विचार्यैव कश्यपो हि महौजसः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001167018, "chapter_id": 21167, "verse_number": "२-३-१५-१९", "content_sanskrit": "महावीरस्य सहसा व्यज्यमानात्मपौरुषः ।\nववृधेत्यश्मसारेण कायेनाद्रिपतिर्यथा॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001167019, "chapter_id": 21167, "verse_number": "२-३-१५-२०", "content_sanskrit": "अथो स तारको दैत्यो महाबलपराक्रमः ।\nतपः कर्तुं जनन्याश्चाज्ञां ययाचे महामनाः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001167020, "chapter_id": 21167, "verse_number": "२-३-१५-२१", "content_sanskrit": "प्राप्ताज्ञः स महामायी मायिनामपि मोहकः ।\nसर्वदेवजयं कर्तुं तपोर्थं मन आदधे॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001167021, "chapter_id": 21167, "verse_number": "२-३-१५-२२", "content_sanskrit": "मधोर्वनमुपागम्य गुर्वाज्ञाप्रतिपालकः ।\nविधिमुद्दिश्य विधिवत्तपस्तेपे सुदारुणम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001167022, "chapter_id": 21167, "verse_number": "२-३-१५-२३", "content_sanskrit": "ऊर्द्ध्वबाहुश्चैकपादो रविं पश्यन्स चक्षुषा ।\nशतवर्षं तपश्चक्रे दृढचित्तो दृढव्रतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001167023, "chapter_id": 21167, "verse_number": "२-३-१५-२४", "content_sanskrit": "अंगुष्ठेन भुवं स्पृष्ट्वा शत वर्षं च तादृशः ।\nतेपे तपो दृढात्मा स तारकोऽसुरराट्प्रभुः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001167024, "chapter_id": 21167, "verse_number": "२-३-१५-२५", "content_sanskrit": "शतवर्षं जलं प्राश्नञ्च्छतवर्षं च वायुभुक् ।\nशतवर्ष जले तिष्ठञ्च्छतं च स्थंडिलेऽतपत्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001167025, "chapter_id": 21167, "verse_number": "२-३-१५-२६", "content_sanskrit": "शतवर्षं तथा चाग्नौ शतवर्षमधोमुखः ।\nशतवर्षं तु हस्तस्य तलेन च भुवं स्थित॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001167026, "chapter_id": 21167, "verse_number": "२-३-१५-२७", "content_sanskrit": "शतवर्षं तु वृक्षस्य शाखामालब्य वै मुने ।\nपादाभ्यां शुचिधूमं हि पिबंश्चाधोमुखस्तथा॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001167027, "chapter_id": 21167, "verse_number": "२-३-१५-२८", "content_sanskrit": "एवं कष्टतरं तेपे सुतपस्स तु दैत्यराट् ।\nकाममुद्दिश्य विधिवच्छृण्वतामपि दुस्सहम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001167028, "chapter_id": 21167, "verse_number": "२-३-१५-२९", "content_sanskrit": "तत्रैवं तपतस्तस्य महत्तेजो विनिस्सृतम् ।\nशिरसस्सर्वंसंसर्पि महोपद्रवकृन्मुने॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001167029, "chapter_id": 21167, "verse_number": "२-३-१५-३०", "content_sanskrit": "तेनैव देवलोकास्ते दग्धप्राया बभूविरे ।\nअभितो दुःखमापन्नास्सर्वे देवर्षयो मुने॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001167030, "chapter_id": 21167, "verse_number": "२-३-१५-३१", "content_sanskrit": "इंद्रश्च भयमापेदे ऽधिकं देवेश्वरस्तदा ।\nतपस्यत्यद्य कश्चिद्वै मत्पदं धर्षयिष्यति॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001167031, "chapter_id": 21167, "verse_number": "२-३-१५-३२", "content_sanskrit": "अकांडे चैव ब्रह्माण्डं संहरिष्यत्ययं प्रभु ।\nइति संशयमापन्ना निश्चयं नोपलेभिरे॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001167032, "chapter_id": 21167, "verse_number": "२-३-१५-३३", "content_sanskrit": "ततस्सर्वे सुसंमन्त्र्य मिथस्ते निर्जरर्षयः ।\nमल्लोकमगमन्भीता दीना मां समुपस्थिताः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001167033, "chapter_id": 21167, "verse_number": "२-३-१५-३४", "content_sanskrit": "मां प्रणम्य सुसंस्तूय सर्वे ते क्लिष्टचेतसः ।\nकृतस्वंजलयो मह्यं वृत्तं सर्वं न्यवेदयन्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001167034, "chapter_id": 21167, "verse_number": "२-३-१५-३५", "content_sanskrit": "अहं सर्वं सुनिश्चित्य कारणं तस्य सद्धिया ।\nवरं दातुं गतस्तत्र यत्र तप्यति सोऽसुरः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001167035, "chapter_id": 21167, "verse_number": "२-३-१५-३६", "content_sanskrit": "अवोचं वचनं तं वै वरं ब्रूहीत्यहं मुने ।\nतपस्तप्तं त्वया तीव्रं नादेयं विद्यते तव॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001167036, "chapter_id": 21167, "verse_number": "२-३-१५-३७", "content_sanskrit": "इत्येवं मद्वचः श्रुत्वा तारकस्स महासुरः ।\nमां प्रणम्य सुसंस्तूय वरं वव्रेऽतिदारुणम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001167037, "chapter_id": 21167, "verse_number": "२-३-१५-३८", "content_sanskrit": "तारक उवाच ।\nत्वयि प्रसन्ने वरदे किमसाध्यं भवेन्मम ।\nअतो याचे वरं त्वत्तः शृणु तन्मे पितामह॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001167038, "chapter_id": 21167, "verse_number": "२-३-१५-३९", "content_sanskrit": "यदि प्रसन्नो देवेश यदि देयो वरो मम ।\nदेयं वरद्वयं मह्यं कृपां कृत्वा ममोपरि॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001167039, "chapter_id": 21167, "verse_number": "२-३-१५-४०", "content_sanskrit": "त्वया च निर्मिते लोके सकलेऽस्मिन्महाप्रभो ।\nमत्तुल्यो बलवान्नूनं न भवेत्कोऽपि वै पुमान्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001167040, "chapter_id": 21167, "verse_number": "२-३-१५-४१", "content_sanskrit": "शिववीर्यसमुत्पन्नः पुत्रस्सेनापतिर्यदा ।\nभूत्वा शस्त्रं क्षिपेन्मह्यं तदा मे मरणं भवेत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001167041, "chapter_id": 21167, "verse_number": "२-३-१५-४२", "content_sanskrit": "इत्युक्तोऽथ तदा तेन दैत्येनाहं मुनीश्वर ।\nवरं च तादृशं दत्त्वा स्वलोकमगमं द्रुतम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001167042, "chapter_id": 21167, "verse_number": "२-३-१५-४३", "content_sanskrit": "दैत्योऽपि स वरं लब्ध्वा मनसेप्सितमुत्तमम् ।\nसुप्रसन्नोतरो भूत्वा शोणिताख्यपुरं गतः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001167043, "chapter_id": 21167, "verse_number": "२-३-१५-४४", "content_sanskrit": "अभिषिक्तस्तदा राज्ये त्रैलोक्यस्यासुरैस्सह ।\nशुक्रेण दैत्यगुरुणाज्ञया मे स महासुरः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001167044, "chapter_id": 21167, "verse_number": "२-३-१५-४५", "content_sanskrit": "ततस्तु स महादैत्योऽभवस्त्रैलोक्यनायकः ।\nस्वाज्ञां प्रवर्तयामास पीडयन्सचराचरम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001167045, "chapter_id": 21167, "verse_number": "२-३-१५-४६", "content_sanskrit": "राज्यं चकार विधिवस्त्रिलोकस्य स तारकः ।\nप्रजाश्च पालयामास पीडयन्निर्जरादिकान्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001167046, "chapter_id": 21167, "verse_number": "२-३-१५-४७", "content_sanskrit": "ततस्स तारको दैत्यस्तेषां रत्नान्युपाददे ।\nइंद्रादिलोकपालानां स्वतो दत्तानि तद्भयात्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001167047, "chapter_id": 21167, "verse_number": "२-३-१५-४८", "content_sanskrit": "इंद्रेणैरावतस्तस्य भयात्तस्मै समर्पितः ।\nकुबेरेण तदा दत्ता निधयो नवसंख्यका॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001167048, "chapter_id": 21167, "verse_number": "२-३-१५-४९", "content_sanskrit": "वरुणेन हयाः शुभ्रा ऋषिभिः कामकृत्तथा ।\nसूर्येणोच्चैश्श्रवा दिव्यो भयात्तस्मै समर्पितः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001167049, "chapter_id": 21167, "verse_number": "२-३-१५-५०", "content_sanskrit": "यत्र यत्र शुभं वस्तु दृष्टं तेनासुरेण हि ।\nतत्तद्गृहीतं तरसा निस्सारस्त्रिभवोऽभवत्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001167050, "chapter_id": 21167, "verse_number": "२-३-१५-५१", "content_sanskrit": "समुद्राश्च तथा रत्नान्यदुस्तस्मै भयान्मुने ।\nअकृष्टपच्यासीत्पृथ्वी प्रजाः कामदुघाः खिलाः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001167051, "chapter_id": 21167, "verse_number": "२-३-१५-५२", "content_sanskrit": "सूर्यश्च तपते तद्वत्तद्दुःखं न यथा भवेत् ।\nचंद्रस्तु प्रभया दृश्यो वायुस्सर्वानुकूलवान्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001167052, "chapter_id": 21167, "verse_number": "२-३-१५-५३", "content_sanskrit": "देवानां चैव यद्द्रव्यं पितॄणां च परस्य च ।\nतत्सर्वं समुपादत्तमसुरेण दुरात्मना॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001167053, "chapter_id": 21167, "verse_number": "२-३-१५-५४", "content_sanskrit": "वशीकृत्य स लोकांस्त्रीन्स्वयमिंद्रो बभूव ह ।\nअद्वितीयः प्रभुश्चासीद्राज्यं चक्रेऽद्भुतं वशी॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001167054, "chapter_id": 21167, "verse_number": "२-३-१५-५५", "content_sanskrit": "निस्सार्य सकलान्देवान्दैत्यानस्थापयत्ततः ।\nस्वयं नियोजयामास देवयोनिस्स्वकर्मणि॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001167055, "chapter_id": 21167, "verse_number": "२-३-१५-५६", "content_sanskrit": "अथ तद्बाधिता देवास्सर्वे शक्रपुरोगमाः ।\nमुने मां शरणं जग्मुरनाथा अतिविह्वलाः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]