[{"id": 7003076000, "chapter_id": 23076, "verse_number": "४-११-१", "content_sanskrit": "श्रीनारायण उवाच ।\nएकदा गोकुले साध्वी यशोदा नंदगेहिनी ।\nगृहकर्मणि संसक्ता कृत्वा बालं स्ववक्षसि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003076001, "chapter_id": 23076, "verse_number": "४-११-२", "content_sanskrit": "वात्यारूपं तृणावर्तमागच्छंतं च गोकुलम् ।\nश्रीहरिर्मनसा ज्ञात्वा भारयुक्तो बभूव  ह ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003076002, "chapter_id": 23076, "verse_number": "४-११-३", "content_sanskrit": "भाराक्रांता यशोदा च तत्याज बालकं तदा ।\nशयनं कारयित्वा च जगाम यमुनां मुने ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003076003, "chapter_id": 23076, "verse_number": "४-११-४", "content_sanskrit": "एतस्मिन्नंतरे त वात्यारूपधरोऽसुरः ।\nआदाय तं भ्रामयित्वा गत्वा च शतयोजनम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003076004, "chapter_id": 23076, "verse_number": "४-११-५", "content_sanskrit": "बभंज वृक्षशाखाश्च ह्यंधीभूतं च गोकुलम् ।\nचकार सद्यो मायावी पुनस्तत्र पपात ह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003076005, "chapter_id": 23076, "verse_number": "४-११-६", "content_sanskrit": "असुरोऽपि हरिस्पर्शाज्जगाम हरिमंदिरम् ।\nसुंदरं रथमारुह्य कृत्वा कर्मक्षयं स्वकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003076006, "chapter_id": 23076, "verse_number": "४-११-७", "content_sanskrit": "पांड्यदेशोद्भवो राजा शापाद्दुर्वाससोऽसुरः ।\nश्रीकृष्णचरणस्पर्शाद्गोलोकं स जगाम ह ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003076007, "chapter_id": 23076, "verse_number": "४-११-८", "content_sanskrit": "वात्यारूपे गते गोपा गोप्यश्च भयविह्वलाः ।\nन दृष्ट्वा बालकं तत्र शयानं शयने मु ने८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003076008, "chapter_id": 23076, "verse_number": "४-११-९", "content_sanskrit": "सर्वे निजघ्नुः स्वं वक्षस्थलं शोकाकुला भयात् ।\nकेचिन्मूर्छामवापुश्च रुरुदुश्चापि केचन ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003076009, "chapter_id": 23076, "verse_number": "४-११-१०", "content_sanskrit": "अन्वेषणं प्रकुर्वंतो ददृशुर्बालकं व्रजे ।\nधूलिधूसरसर्वांगं पुष्पोद्यानांतरस्थितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003076010, "chapter_id": 23076, "verse_number": "४-११-११", "content_sanskrit": "बाह्यैकदेशे सरसस्तीरे नीरसमन्विते ।\nपश्यंतं गगनं शश्वद्वदंतं भयकातरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003076011, "chapter_id": 23076, "verse_number": "४-११-१२", "content_sanskrit": "गृहीत्वा बालकं नंदः कृत्वा वक्षसि सत्वरम् ।\nदर्शं दर्शं मुखं तस्य रुरोद च शुचाऽन्वितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003076012, "chapter_id": 23076, "verse_number": "४-११-१३", "content_sanskrit": "यशोदा रोहिणी शीघ्रं दृष्ट्वा बालं रुरोद च ।\nकृत्वा वक्षसि तद्वक्त्रं चुचुंब च मुहुर्मुहुः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003076013, "chapter_id": 23076, "verse_number": "४-११-१४", "content_sanskrit": "मंगलं कारयामास स्नापयामास बालकम् ।\nस्तनं ददौ यशोदा च प्रसन्नवदनेक्षणा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003076014, "chapter_id": 23076, "verse_number": "४-११-१५", "content_sanskrit": "नारद उवाच ।\nकथं शशाप दुर्वासाः पांड्यदेशोद्भवं नृपम् ।\nसुविचार्य वद ब्रह्मन्नितिहासं पुरातनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003076015, "chapter_id": 23076, "verse_number": "४-११-१६", "content_sanskrit": "श्रीनारायण उवाच ।\nपांड्यदेशाधिपो राजा सहस्राक्षः प्रतापवान् ।\nस्त्रीसहस्रं समादाय कामबाणप्रपीडितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003076016, "chapter_id": 23076, "verse_number": "४-११-१७", "content_sanskrit": "मनोहरे निर्जने च पर्वते गंधमादने ।\nविजहार नदीतीरे पुष्पोद्याने मनोरमे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003076017, "chapter_id": 23076, "verse_number": "४-११-१८", "content_sanskrit": "नानाप्रकारशृगारं विपरीतादिकं नृपः ।\nनखदंतक्षतांगं च कामिनीनां चकार सः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003076018, "chapter_id": 23076, "verse_number": "४-११-१९", "content_sanskrit": "कृत्वा मूर्तिसहस्रं च योगींद्रो नृपतीश्वरः ।\nकृत्वा स्थलविहारं च जलक्रीडां चकार ह ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003076019, "chapter_id": 23076, "verse_number": "४-११-२०", "content_sanskrit": "नार्यो विवसनाः सर्वा नग्नाश्च नृपयोषितः ।\nविजह्रुश्च पुष्पभद्रानदीतीरे मनोहरे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003076020, "chapter_id": 23076, "verse_number": "४-११-२१", "content_sanskrit": "एतस्मिन्नंतरे तत्र समायातो महामुनिः ।\nशिष्यलक्षैः परिवृतो गच्छन्वै शंकरं प्रति ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003076021, "chapter_id": 23076, "verse_number": "४-११-२२", "content_sanskrit": "दृष्ट्वा मुनिं महामत्तो नोत्तस्थौ न ननाम ह ।\nवाचा हस्तेन राजा च संभाषां न चकार ह ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003076022, "chapter_id": 23076, "verse_number": "४-११-२३", "content_sanskrit": "दृष्ट्वा चुकोप नृपतिं शशाप स्फुरिताधरः ।\nअसुरो भव पापिष्ठ योगाद्भ्रष्टो भुवं व्रज ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003076023, "chapter_id": 23076, "verse_number": "४-११-२४", "content_sanskrit": "भारते लक्षवर्षं च स्थातव्यं ते नराधम ।\nततो हरिपदस्पर्शाद्गोलोकं यास्यसि ध्रुवम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003076024, "chapter_id": 23076, "verse_number": "४-११-२५", "content_sanskrit": "स्थानेस्थाने हे महिष्यो जनिं लभत भारते ।\nराजेंद्रगेहे राजेंद्राद्भविष्यथ मनोहराः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003076025, "chapter_id": 23076, "verse_number": "४-११-२६", "content_sanskrit": "इत्युक्त्वा तु मुनींद्रस्तु जगाम शंकरालयम् ।\nहा हा शब्दं विचक्रुश्च शिष्यसंघाः कृपालवः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003076026, "chapter_id": 23076, "verse_number": "४-११-२७", "content_sanskrit": "गते मुनींद्रे राजेंद्रो रुरोद च सरित्तटे ।\nरुरुदू रमणीयाश्च रमण्यो विरहातुराः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003076027, "chapter_id": 23076, "verse_number": "४-११-२८", "content_sanskrit": "हे नाथ रमणश्रेष्ठेत्युच्चार्य च पुनः पुनः ।\nत्वां विना वा क्व यास्यामो वयं त्वं वा क्व यास्य सि२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003076028, "chapter_id": 23076, "verse_number": "४-११-२९", "content_sanskrit": "वयं नो विहरिष्यामस्त्वया सार्द्धं सुनिर्जने ।\nन करिष्यसि राज्यं त्वं न यास्यामो गृहं वयम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003076029, "chapter_id": 23076, "verse_number": "४-११-३०", "content_sanskrit": "शरच्चंद्रप्रभामुष्टं न द्रक्ष्यामो मुखं तव ।\nप्रसारिताभ्यां बाहुभ्यां नानयिष्याम इत्यतः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003076030, "chapter_id": 23076, "verse_number": "४-११-३१", "content_sanskrit": "इत्युक्त्वा रुरुदुः सर्वाः पुरस्कृत्य नराधिपम् ।\nमूर्छामवापुश्चरणं धृत्वा राज्ञः सरित्तटे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003076031, "chapter_id": 23076, "verse_number": "४-११-३२", "content_sanskrit": "राजाऽग्निकुण्डमाधाय नारीभिः सह नारद ।\nस्मृत्वा हरिपदांभोजं ज्वलदग्निं विवेश ह ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003076032, "chapter_id": 23076, "verse_number": "४-११-३३", "content_sanskrit": "हाहाकारं सुराः सर्वे विचक्रुर्गगने स्थिताः। ।\nइत्यूचुर्मुनयश्चैव दैवं च बलवत्तरम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003076033, "chapter_id": 23076, "verse_number": "४-११-३४", "content_sanskrit": "स च राजा तृणावर्तो जगाम हरिमंदिरम्।\nमहिष्यो भारते वर्षे लेभिरे जन्म वाञ्छितम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003076034, "chapter_id": 23076, "verse_number": "४-११-३५", "content_sanskrit": "इत्येवं कथितं सर्वं हरेर्माहात्म्य मुत्तमम् ।\nमाक्षणं नृपतेश्चैव मुनींद्रशापहेतुकम् ॥३५", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]