[{"id": 2122969, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2122970, "chapter_id": 3639, "verse_number": "१", "content_sanskrit": "त्वत्तः कैतवकेनैव यज्जितोऽस्मि दुरोदरम् ।\nशकुने हन्त दीव्यावो ग्लहमानौ सहस्रशः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2122971, "chapter_id": 3639, "verse_number": "२", "content_sanskrit": "इमे निष्कसहस्रस्य कुम्भिनो भरितायुतम् ।\nकोशो हिरण्यमक्षय्यं जातरूपमनेकशः ।\nएतद् राजधनं मह्यं तेन दीव्याम्यहं त्वया ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2122972, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2122973, "chapter_id": 3639, "verse_number": "३", "content_sanskrit": "इत्युक्तः शकुनिः प्राह जितमित्येव तं नृपम् ।\nकौरवाणां कुलकरं श्रेष्ठं पाण्डवमच्युतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2122974, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2122975, "chapter_id": 3639, "verse_number": "४", "content_sanskrit": "अयं सहस्रसमितो वैयाघ्रः सुप्रवर्तितः ।\nसुचक्रोपस्करः श्रीमान् किङ्किणीजालमण्डितः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2122976, "chapter_id": 3639, "verse_number": "५", "content_sanskrit": "संह्रादनो राजरथो य इहास्मानुपावहत् ।\nजैत्रो रथवरः पुण्यो मेघसागरनिःस्वनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2122977, "chapter_id": 3639, "verse_number": "६", "content_sanskrit": "अष्टौ यं कुलसम्पन्नाः सदश्वा राष्ट्रसम्मताः ।\nवहन्ति नैषा मुच्येत पदाद् भूमिमुपास्पृशन् ।\nएतद् राजन् धनं मह्यं तेन दीव्याम्यहं त्वया ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2122978, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2122979, "chapter_id": 3639, "verse_number": "७", "content_sanskrit": "तमेवंवादिनं पार्थं प्रहसन्निव सौबलः ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2122980, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2122981, "chapter_id": 3639, "verse_number": "८", "content_sanskrit": "सहस्रसङ्ख्या नागा मे मत्तास्तिष्ठन्ति सौबल ।\nहेमकक्ष्याः कृतापीडाः पद्मिनो हेममालिनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2122982, "chapter_id": 3639, "verse_number": "९", "content_sanskrit": "सुदन्ता राजवहनाः सर्वशस्त्रसहा युधि ।\nशुभ्रदन्ता महाकायाः सर्वे चेष्टकरेणवः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2122983, "chapter_id": 3639, "verse_number": "१०", "content_sanskrit": "सर्वे च पुरभेत्तारो नवमेघनिभा गजाः ।\nएतद् राजन् धनं मह्यं तेन दीव्याम्यहं त्वया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2122984, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2122985, "chapter_id": 3639, "verse_number": "११", "content_sanskrit": "तमेवंवादिनं पार्थं प्रहसन्निव सौबलः ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2122986, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2122987, "chapter_id": 3639, "verse_number": "१२", "content_sanskrit": "शतं दासीसहस्राणि तरुण्यो हेमभूषणाः ।\nकञ्चुकेयूरहारिण्यो निष्ककण्ठ्यः स्वलङ्कृताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2122988, "chapter_id": 3639, "verse_number": "१३", "content_sanskrit": "महार्हमाल्याभरणाः सुवस्त्राश्चन्दनोक्षिताः ।\nमणिहेम च बिभ्रत्यः सर्वा वै सूक्ष्मवाससः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2122989, "chapter_id": 3639, "verse_number": "१४", "content_sanskrit": "अनुसेवां चरन्तीमाः कुशला नृत्तसामसु ।\nस्नातकानाममात्यानां राज्ञां च मम शासनात् ।\nएतद् राजन् धनं मह्यं तेन दीव्याम्यहं त्वया ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2122990, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2122991, "chapter_id": 3639, "verse_number": "१५", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः ।\nजितमित्येव शकुनिर्युधिष्ठिरमुवाच ह ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2122992, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2122993, "chapter_id": 3639, "verse_number": "१६", "content_sanskrit": "एतावन्त्येव दासानां सहस्राण्युत सन्ति मे ।\nप्रदक्षिणानुलोमाश्च प्रावारवसनाः सदा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2122994, "chapter_id": 3639, "verse_number": "१७", "content_sanskrit": "प्राज्ञा मेधाविनो दक्षा युवानो मृष्टकुण्डलाः ।\nपात्रहस्ता दिवारात्रमतिथीन् भोजयन्ति ये ।\nएतद् राजन् धनं मह्यं तेन दीव्याम्यहं त्वया ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2122995, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2122996, "chapter_id": 3639, "verse_number": "१८", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2122997, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2122998, "chapter_id": 3639, "verse_number": "१९", "content_sanskrit": "रथास्तावन्त एवैते हेमभाण्डाः पताकिनः ।\nहयैर्विनीतैः सम्पन्ना रथिभिश्चित्रयोधिभिः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2122999, "chapter_id": 3639, "verse_number": "२०", "content_sanskrit": "एकैको यत्र लभते सहस्रपरमां भृतिम् ।\nयुध्यतोऽयुध्यतो वाऽपि वेतनं मासकल्पितम् ।\nएतद् राजन् धनं मह्यं तेन दीव्याम्यहं त्वया ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2123000, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2123001, "chapter_id": 3639, "verse_number": "२१", "content_sanskrit": "इत्येवमुक्तः पार्थेन कृतवैरो दुरात्मवान् ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2123002, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2123003, "chapter_id": 3639, "verse_number": "२२", "content_sanskrit": "अश्वांस्तित्तिरिकल्माषान् गान्धर्वान् हेममालिनः ।\nददौ चित्ररथस्तुष्टो यांस्तान् गाण्डीवधन्वने ।\nएतद् राजन् धनं मह्यं तेन दीव्याम्यहं त्वया ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2123004, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2123005, "chapter_id": 3639, "verse_number": "२३", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः ।\nजितमित्येव शकुनिर्युधिष्ठिरभाषत ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2123006, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2123007, "chapter_id": 3639, "verse_number": "२४", "content_sanskrit": "रथानां शकटानां च यानानां चायुतानि मे ।\nयुक्तान्येव हि तिष्ठन्ति वाहैरुच्चावचैर्हयैः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2123008, "chapter_id": 3639, "verse_number": "२५", "content_sanskrit": "एवं वर्णस्य वर्णस्य समुच्चयसहस्रशः ।\nतथा समुदिता वीराः सर्वे वीरपराक्रमाः ।\nक्षीरं पिबन्तस्तिष्ठन्ति भुञ्जानाः शालितण्डुलान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2123009, "chapter_id": 3639, "verse_number": "२६", "content_sanskrit": "षष्टिस्तानि सहस्राणि सर्वे पृथुलवक्षसः ।\nएतद् राजन् धनं मह्यं तेन दीव्याम्यहं त्वया ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2123010, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2123011, "chapter_id": 3639, "verse_number": "२७", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः ।\nजितमित्येव शकुनिर्युधिष्ठिरमभाषत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2123012, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2123013, "chapter_id": 3639, "verse_number": "२८", "content_sanskrit": "ताम्रलोहैः परिवृता निधयो मे चतुश्शतम् ।\nपञ्चद्रौणिक एकैकः सुवर्णस्याहतस्य वै ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2123014, "chapter_id": 3639, "verse_number": "२९", "content_sanskrit": "एतद् राजन् धनं मह्यं तेन दीव्याम्यहं त्वया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2123015, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2123016, "chapter_id": 3639, "verse_number": "३०", "content_sanskrit": "एतच्छ्रुत्वा व्यवसितो निकृतिं समुपाश्रितः ।\nजितमित्येव शकुनिर्युधिष्ठिरभाषत ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2123017, "chapter_id": 3639, "verse_number": "१३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि एकाशीतितमोऽध्यायः ॥८१॥\n॥ द्यूतपर्वणि त्रयोदशोऽध्यायः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2123018, "chapter_id": 3639, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]