[{"id": 2190873, "chapter_id": 5064, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2190874, "chapter_id": 5064, "verse_number": "१", "content_sanskrit": "धन्या धन्या इति जनाः सर्वेऽस्मान् प्रवदन्त्युत ।\nन दुःखिततरः कश्चित् पुमानस्माभिरस्ति ह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2190875, "chapter_id": 5064, "verse_number": "२", "content_sanskrit": "लोकसम्भावितैर्दुःखं यत् प्राप्तं कुरुसत्तम ।\nप्राप्य जातिं मनुष्येषु देवैरपि पितामह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2190876, "chapter_id": 5064, "verse_number": "३", "content_sanskrit": "कदा वयं करिष्यामः संन्यासं दुःखसञ्ज्ञकम् ।\nदुःखमेतच्छरीराणां धारणं कुरुसत्तम\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2190877, "chapter_id": 5064, "verse_number": "४", "content_sanskrit": "विमुक्ताः सप्तदशभिर्हेतुभूतैश्च पञ्चभिः ।\nइन्द्रियार्थैर्गुणैश्चैव अष्टभिः प्रपितामह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2190878, "chapter_id": 5064, "verse_number": "५", "content_sanskrit": "न गच्छन्ति पुनर्भावं मुनयः संशितव्रताः ।\nकदा वयं भविष्यामो राज्यं हित्वा परन्तप\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2190879, "chapter_id": 5064, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2190880, "chapter_id": 5064, "verse_number": "६", "content_sanskrit": "नास्त्यनन्तं महाराज सर्वं सङ्ख्यानगोचरम् ।\nपुनर्भावोऽपि सङ्ख्यातो नास्ति किञ्चिदिहाचलम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2190881, "chapter_id": 5064, "verse_number": "७", "content_sanskrit": "न चापि गम्यते राजन्नैष दोषः प्रसङ्गतः ।\nउद्योगादेव धर्मज्ञ कालेनैव गमिष्यथ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2190882, "chapter_id": 5064, "verse_number": "८", "content_sanskrit": "नेशोऽयं सततं देही नृपते पुण्यपापयोः ।\nतत एव समुत्थेन तमसा रुद्ध्यतेऽपि च\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2190883, "chapter_id": 5064, "verse_number": "९", "content_sanskrit": "यथाञ्जनमयो वायुः पुनर्मानःशिलं रजः ।\nअनुप्रविश्य तद्वर्णो दृश्यते रञ्जयन् दिशः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2190884, "chapter_id": 5064, "verse_number": "१०", "content_sanskrit": "तथा कर्मफलैर्देही रञ्जितस्तमसावृतः ।\nविवर्णो वर्णमाश्रित्य देहेषु परिवर्तते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2190885, "chapter_id": 5064, "verse_number": "११", "content_sanskrit": "ज्ञानेन हि यदा जन्तुरज्ञानप्रभवं तमः ।\nव्यपोहति तदा ब्रह्म प्रकाशेत सनातनम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2190886, "chapter_id": 5064, "verse_number": "१२", "content_sanskrit": "अयत्नसाध्यं मुनयो वदन्ति\nये चापि मुक्तास्त उपासितव्याः ।\nत्वया च लोकेन च सामरेण\nतस्मान्न शाम्यन्ति महर्षिसङ्घाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2190887, "chapter_id": 5064, "verse_number": "१३", "content_sanskrit": "अस्मिन्नर्थे पुरा गीतं शृणुष्वैकमना नृप ।\nयथा दैत्येन वृत्रेण भ्रष्टैश्वर्येण चेष्टितम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2190888, "chapter_id": 5064, "verse_number": "१४", "content_sanskrit": "निर्जितेनासहायेन हृतराज्येन भारत ।\nअशोचता शत्रुमध्ये बुद्धिमास्थाय केवलाम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2190889, "chapter_id": 5064, "verse_number": "१५", "content_sanskrit": "भ्रष्टैश्वर्यं पुरा वृत्रमुशना वाक्यमब्रवीत् ।\nकच्चित् पराजितस्याद्य न व्यथा तेऽस्ति दानव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2190890, "chapter_id": 5064, "verse_number": "", "content_sanskrit": "वृत्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2190891, "chapter_id": 5064, "verse_number": "१६", "content_sanskrit": "सत्येन तपसा चैव विदित्वा सङ्क्षयं ह्यहम् ।\nन शोचामि न हृष्यामि भूतानामागतिं गतिम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2190892, "chapter_id": 5064, "verse_number": "१७", "content_sanskrit": "कालसञ्चोदिता जीवा मज्जन्ति नरकेऽवशाः ।\nपरिदृष्टानि सर्वाणि दिव्यान्याहुर्मनीषिणः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2190893, "chapter_id": 5064, "verse_number": "१८", "content_sanskrit": "क्षपयित्वा तु तं कालं गणितं कालचोदिताः ।\nसावशेषेण कालेन सम्भवन्ति पुनः पुनः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2190894, "chapter_id": 5064, "verse_number": "१९", "content_sanskrit": "तिर्यग्योनिसहस्राणि गत्वा नरकमेव च ।\nनिर्गच्छन्त्यवशा जीवाः कालबन्धनबन्धनाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2190895, "chapter_id": 5064, "verse_number": "२०", "content_sanskrit": "एवं संसरमाणानि जीवान्यहमदृष्टवान् ।\nयथा कर्म तथा लाभ इति शास्त्रनिदर्शनम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2190896, "chapter_id": 5064, "verse_number": "२१", "content_sanskrit": "तिर्यग्गच्छन्ति नरकं मानुष्यं दैवमेव च ।\nसुखदुःखे प्रियद्वेष्ये चरित्वा पूर्वमेव च\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2190897, "chapter_id": 5064, "verse_number": "२२", "content_sanskrit": "कृतान्तविधिसंयुक्तं सर्वलोकः प्रपद्यते ।\nगतं गच्छन्ति चाध्वानं सर्वभूतानि सर्वदा\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2190898, "chapter_id": 5064, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2190899, "chapter_id": 5064, "verse_number": "२३", "content_sanskrit": "कालसङ्ख्यानसङ्ख्यातं सृष्टिस्थितिपरायणम् ।\nतं भाषमाणं भगवानुशना प्रत्यभाषत॥\nभीमान् दुष्टप्रलापांस्त्वं तात कस्मात् प्रभाषसे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2190900, "chapter_id": 5064, "verse_number": "", "content_sanskrit": "वृत्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2190901, "chapter_id": 5064, "verse_number": "२४", "content_sanskrit": "प्रत्यक्षमेतद्भवतस्तथान्येषां मनीषिणाम् ।\nमया यज्जयलुब्धेन पुरा तप्तं महत्तपः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2190902, "chapter_id": 5064, "verse_number": "", "content_sanskrit": "गन्धानादाय भूतानां रसांश्च विविधानपि ।\nअवर्धं त्रीन् समाक्रम्य लोकान् वै स्वेन तेजसा\t॥२५ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2190903, "chapter_id": 5064, "verse_number": "२६", "content_sanskrit": "ज्वालामालापरिक्षिप्तो वैहायसचरस्तथा ।\nअजेयः सर्वभूतानामासं नित्यमपेतभीः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2190904, "chapter_id": 5064, "verse_number": "२७", "content_sanskrit": "ऐश्वर्यं तपसा प्राप्तं भ्रष्टं तच्च स्वकर्मभिः ।\nधृतिमास्थाय भगवन्न शोचामि ततस्त्वहम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2190905, "chapter_id": 5064, "verse_number": "२८", "content_sanskrit": "युयुत्सता महेन्द्रेण पुरा सार्धं महात्मना ।\nततो मे भगवान्दृष्टो हरिर्नारायणः प्रभुः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2190906, "chapter_id": 5064, "verse_number": "२९", "content_sanskrit": "वैकुण्ठः पुरुषो विष्णुः शुक्लोऽनन्तः सनातनः ।\nमुञ्जकेशो हरिश्मश्रुः सर्वभूतपितामहः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2190907, "chapter_id": 5064, "verse_number": "३०", "content_sanskrit": "नूनं तु तस्य तपसः सावशेषं ममास्ति वै ।\nयदहं प्रष्टुमिच्छामि भवन्तं कर्मणः फलम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2190908, "chapter_id": 5064, "verse_number": "३१", "content_sanskrit": "ऐश्वर्यं वै महद् ब्रह्मन् कस्मिन् वर्णे प्रतिष्ठितम् ।\nनिवर्तते चापि पुनः कथमैश्वर्यमुत्तमम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2190909, "chapter_id": 5064, "verse_number": "३२", "content_sanskrit": "कस्माद् भूतानि जीवन्ति प्रवर्तन्तेऽथ वा पुनः ।\nकिं वा फलं परं प्राप्य जीवस्तिष्ठति शाश्वतः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2190910, "chapter_id": 5064, "verse_number": "३३", "content_sanskrit": "केन वा कर्मणा शक्यमथ ज्ञानेन केन वा ।\nब्रह्मर्षे तत्फलं प्राप्तुं तन्मे व्याख्यातुमर्हसि\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2190911, "chapter_id": 5064, "verse_number": "३४", "content_sanskrit": "इतीदमुक्तः स मुनिस्तदानीं\nप्रत्याह यत्तच्छृणु राजसिंह ।\nमयोच्यमानं पुरुषर्षभ त्व-\nमनन्यचित्तः सह सोदरीयैः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2190912, "chapter_id": 5064, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे त्रयोदशाधिकशततमोऽध्यायः ॥११३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]