[{"id": 2040911, "chapter_id": 1908, "verse_number": "५-१५३-१", "content_sanskrit": "जनमेजय उवाच।\nयुधिष्ठिरं सहानीकमुपायान्तं युयुत्सया।\nसन्निविष्टं कुरुक्षेत्रे वासुदेवेन पालितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040912, "chapter_id": 1908, "verse_number": "५-१५३-२", "content_sanskrit": "विराटद्रुपदाभ्यां च सपुत्राभ्यां समन्वितम् ।\nकेकयैर्वृष्णिभिश्चैव पार्थिवैः शतशो वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040913, "chapter_id": 1908, "verse_number": "५-१५३-३", "content_sanskrit": "महेन्द्रमिव चादित्यैरभिगुप्तं महारथैः।\nश्रुत्वा दुर्योधनो राजा किं कार्यं प्रत्यपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040914, "chapter_id": 1908, "verse_number": "५-१५३-४", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं विस्तरेण महामते।\nसंभ्रमे तुमुले तस्मिन्यदासीत्कुरुजाङ्गले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040915, "chapter_id": 1908, "verse_number": "५-१५३-५", "content_sanskrit": "व्यथयेयुरिमे देवान्सेन्द्रानपि समागमे ।\nपाण्डवा वासुदेवश्च विराटद्रुपदौ तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040916, "chapter_id": 1908, "verse_number": "५-१५३-६", "content_sanskrit": "धृष्टद्युम्नश्च पाञ्चाल्यः शिखण्डी च महारथः ।\nयुधामन्युश्च विक्रान्तो देवैरपि दुरासदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040917, "chapter_id": 1908, "verse_number": "५-१५३-७", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं विस्तरेण तपोधन ।\nकुरूणां पाण्डवानां च यद्यदासीद्विचेष्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040918, "chapter_id": 1908, "verse_number": "५-१५३-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040919, "chapter_id": 1908, "verse_number": "५-१५३-८", "content_sanskrit": "प्रतियाते तु दाशार्हे राजा दुर्योधनस्तदा।\nकर्णं दुःशासनं चैव शकुनिं चाब्रवीदिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040920, "chapter_id": 1908, "verse_number": "५-१५३-९", "content_sanskrit": "अकृतेनैव कार्येण गतः पार्थानधोक्षजः ।\nस एनान्मन्युनाविष्टो ध्रुवं धक्ष्यत्यसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040921, "chapter_id": 1908, "verse_number": "५-१५३-१०", "content_sanskrit": "इष्टो हि वासुदेवस्य पाण्डवैर्मम विग्रहः ।\nभीमसेनार्जुनौ चैव दाशार्हस्य मते स्थितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040922, "chapter_id": 1908, "verse_number": "५-१५३-११", "content_sanskrit": "अजातशत्रुरत्यर्थं भीमसेनवशानुगः।\nनिकृतश्च मया पूर्वं सह सर्वैः सहोदरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040923, "chapter_id": 1908, "verse_number": "५-१५३-१२", "content_sanskrit": "विराटद्रुपदौ चैव कृतवैरौ मया सह ।\nतौ च सेनाप्रणेतारौ वासुदेववशानुगौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040924, "chapter_id": 1908, "verse_number": "५-१५३-१३", "content_sanskrit": "भविता विग्रहः सोयं तुमुलो लोमहर्षणः ।\nतस्मात्साङ्ग्रामिकं सर्वं कारयध्वमतन्द्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040925, "chapter_id": 1908, "verse_number": "५-१५३-१४", "content_sanskrit": "शिबिराणि कुरुक्षेत्रे क्रियन्तां वसुधाधिपाः ।\nस्वपर्याप्तावकाशानि दुरादेयानि शत्रुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040926, "chapter_id": 1908, "verse_number": "५-१५३-१५", "content_sanskrit": "आसन्नजलकोष्ठानि शतशोथ सहस्रशः ।\nअच्छेद्याहारमार्गाणि बन्धोच्छ्रयचितानि च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040927, "chapter_id": 1908, "verse_number": "५-१५३-१६", "content_sanskrit": "विविधायुधपूर्णानि पताकाध्वजवन्ति च।\nसमाश्च तेषां पन्थानः क्रियन्तां नगराद्बहिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040928, "chapter_id": 1908, "verse_number": "५-१५३-१७", "content_sanskrit": "प्रयाणं घुष्यतामद्य श्वोभूत इति माचिरम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040929, "chapter_id": 1908, "verse_number": "५-१५३-१७x", "content_sanskrit": "वैशम्पायन उवाच।\nते तथेति प्रतिज्ञाय श्वोभूते चक्रिरे तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040930, "chapter_id": 1908, "verse_number": "५-१५३-१८", "content_sanskrit": "हृष्टरूपा महात्मानो निवासाय महीक्षिताम् ।\nततस्ते पार्थिवाः सर्वे तच्छ्रुत्वा राजशासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040931, "chapter_id": 1908, "verse_number": "५-१५३-१९", "content_sanskrit": "आसनेभ्यो महार्हेभ्य उदतिष्ठन्नमर्षिताः ।\nबाहून्परिघसङ्काशान्संस्पृशन्तः शनैः शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040932, "chapter_id": 1908, "verse_number": "५-१५३-२०", "content_sanskrit": "काञ्चनाङ्गददीप्तांश्च चन्दनागरुभूषितान्।\nउष्णीषाणि नियच्छन्तः पुण्डरीकनिभै करैः।\nअन्तरीयोत्तरीयाणि भूषणानि च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040933, "chapter_id": 1908, "verse_number": "५-१५३-२१", "content_sanskrit": "ते रथान्रथिनः श्रेष्ठा हयांश्च हयकोविदाः।\nसज्जयन्ति स्म नागांश्च नागशिक्षास्वनुष्ठिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040934, "chapter_id": 1908, "verse_number": "५-१५३-२२", "content_sanskrit": "अथ वर्माणि चित्राणि काञ्चनानि बहूनि च ।\nविविधानि च शस्त्राणि चक्रुः सर्वाणि सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040935, "chapter_id": 1908, "verse_number": "५-१५३-२३", "content_sanskrit": "पदातयश्च पुरुषाः शस्त्राणि विविधानि च।\nउपाजह्रुः शरीरेषु हेमचित्राण्यनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040936, "chapter_id": 1908, "verse_number": "५-१५३-२४", "content_sanskrit": "तदुत्सव इवोदग्रं संप्रहृष्टनरावृतम् ।\nनगरं धार्तराष्ट्रस्य भारतासीत्समाकुलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040937, "chapter_id": 1908, "verse_number": "५-१५३-२५", "content_sanskrit": "जनौघसलिलावर्तो रथनागाश्वमीनवान् ।\nशङ्खदुन्दुभिनिर्घोषः कोशसञ्चयरत्नवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040938, "chapter_id": 1908, "verse_number": "५-१५३-२६", "content_sanskrit": "चित्राभरणवर्मोर्मिः शस्त्रनिर्मलफेनवान् ।\nप्रासादमालाद्रिवृतो रथ्यापणमहाह्रदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040939, "chapter_id": 1908, "verse_number": "५-१५३-२७", "content_sanskrit": "योधचन्द्रोदयोद्भूतः कुरुराजमहार्णवः ।\nव्यदृश्यत तदा राजंश्चन्द्रोदय इवोदधिः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040940, "chapter_id": 1908, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सैन्यनिर्याणपर्वणि त्रिपञ्चाशदधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]