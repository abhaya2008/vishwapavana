[{"id": 2130390, "chapter_id": 3811, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2130391, "chapter_id": 3811, "verse_number": "१", "content_sanskrit": "ततः संहृत्य विपुलं तद्वपुः कामतः कृतम् ।\nभीमसेनं पुनर्दोर्भ्यां पर्यष्वजत वानरः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2130392, "chapter_id": 3811, "verse_number": "२", "content_sanskrit": "परिष्वक्तस्य तस्याशु भ्रात्रा भीमस्य भारत ।\nश्रमो नाशमुपागच्छत् सर्वं चासीत् प्रदक्षिणम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2130393, "chapter_id": 3811, "verse_number": "३", "content_sanskrit": "ततः पुनरथोवाच पर्यश्रुनयनो हरिः ।\nभीममाभाष्य सौहार्दाद् भाष्पगद्गदया गिरा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2130394, "chapter_id": 3811, "verse_number": "४", "content_sanskrit": "गच्छ वीर स्वमावासं स्मर्तव्योऽस्मि कथान्तरे ।\nइहस्थश्च कुरुश्रेष्ठ न निवेद्योऽस्मि कर्हिचित्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2130395, "chapter_id": 3811, "verse_number": "५", "content_sanskrit": "शीघ्रं तु कार्यसिद्ध्यर्थं गच्छ त्वं पाण्डुनन्दन ।\nस्मर्तव्योऽस्मि त्वया वीर कथास्वमितविक्रम\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2130396, "chapter_id": 3811, "verse_number": "६", "content_sanskrit": "धनदस्यालयाच्चापि विसृष्टानां महाबल ।\nदेशकाल इहायातुं देवगन्धर्वयोषिताम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2130397, "chapter_id": 3811, "verse_number": "७", "content_sanskrit": "ममापि सफलं चक्षुः स्मारितश्चास्मि राघवम् ।\nरामाभिधानं विष्णुं हि जगद्धृदयनन्दनम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2130398, "chapter_id": 3811, "verse_number": "८", "content_sanskrit": "सीतावक्त्रारविन्दार्कं दशास्यध्वान्तभास्करम् ।\nमानुषं गात्रसंस्पर्शं गत्वा भीम त्वया सह\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2130399, "chapter_id": 3811, "verse_number": "९", "content_sanskrit": "तदस्मद्दर्शनं वीर कौन्तेयामोघमस्तु ते ।\nभ्रातृत्वं त्वं पुरुस्कृत्य वरं वरय भारत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2130400, "chapter_id": 3811, "verse_number": "१०", "content_sanskrit": "यदि तावन्मया क्षुद्रा गत्वा वारणसाह्वयम् ।\nधार्तराष्ट्रा निहन्तव्या यावदेतत् करोम्यहम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2130401, "chapter_id": 3811, "verse_number": "११", "content_sanskrit": "शिलया नगरं वापि मर्दितव्यं मया यदि \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2130402, "chapter_id": 3811, "verse_number": "१२", "content_sanskrit": "बद्ध्वा दुर्योधनं चाद्य आनयामि तवान्तिकम् ।\nयावदेतत् करोम्यद्य कामं तव महाबल \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2130403, "chapter_id": 3811, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2130404, "chapter_id": 3811, "verse_number": "१३", "content_sanskrit": "भीमसेनस्तु तद्वाक्यं श्रुत्वा तस्य महात्मनः ।\nप्रत्युवाच हनूमन्तं प्रहृष्टेनान्तरात्मना\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2130405, "chapter_id": 3811, "verse_number": "१४", "content_sanskrit": "कृतमेव त्वया सर्वं मम वानरपुङ्गव ।\nस्वस्ति तेऽस्तु महाबाहो कामये त्वां प्रसीद मे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2130406, "chapter_id": 3811, "verse_number": "१५", "content_sanskrit": "सनाथाः पाण्डवाः सर्वे त्वया नाथेन वीर्यवन् ।\nतवैव तेजसा सर्वान् विजेष्यामो वयं परान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2130407, "chapter_id": 3811, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2130408, "chapter_id": 3811, "verse_number": "१६", "content_sanskrit": "एवमुक्तस्तु हनुमान् भीमसेनमभाषत ।\nभ्रातृत्वात् सौहृदाच्चैव करिष्यामि प्रियं तव \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2130409, "chapter_id": 3811, "verse_number": "१७", "content_sanskrit": "चमूं विगाह्य शत्रूणां शरशक्तिसमाकुलाम् ।\nयदा सिंहरवं वीर करिष्यसि महाबल \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2130410, "chapter_id": 3811, "verse_number": "१८", "content_sanskrit": "तदाहं बृंहयिष्यामि स्वरवेण रवं तव ।\nयं श्रुत्वैव भविष्यन्ति व्यसवस्तेऽरयो रणे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2130411, "chapter_id": 3811, "verse_number": "१९", "content_sanskrit": "विजयस्य ध्वजस्थश्च नादान् मोक्ष्यामि दारुणान् ।\nशत्रूणां ये प्राणहराः सुखं येन हनिष्यथ\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2130412, "chapter_id": 3811, "verse_number": "२०", "content_sanskrit": "एवमाभाष्य हनूमांस्तदा पाण्डवनन्दनम् ।\nमार्गमाख्याय भीमाय तत्रैवान्तरधीयत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2130413, "chapter_id": 3811, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2130414, "chapter_id": 3811, "verse_number": "", "content_sanskrit": "गते तस्मिन् हरिवरे भीमोऽपि बलिनां वरः ।\nतेन मार्गेण विपुलं व्यचरद् गन्धमादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2130415, "chapter_id": 3811, "verse_number": "२१", "content_sanskrit": "अनुस्मरन् वपुस्तस्य श्रियं चाप्रतिमां भुवि ।\nमाहात्म्यमनुभावं च स्मरन् दाशरथेर्ययौ\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2130416, "chapter_id": 3811, "verse_number": "२२", "content_sanskrit": "स तानि रमणीयानि वनान्युपवनानि च ।\nविलोकयामास तदा सौगन्धिकवनेप्सया\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2130417, "chapter_id": 3811, "verse_number": "", "content_sanskrit": "फुल्लद्रुमविचित्राणि सरांसि सरितस्तथा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2130418, "chapter_id": 3811, "verse_number": "", "content_sanskrit": "नानाकुसुमचित्राणि पुष्पितानि वनानि च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2130419, "chapter_id": 3811, "verse_number": "२३", "content_sanskrit": "नानाविहगजुष्टानि पश्यति स्म समन्ततः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2130420, "chapter_id": 3811, "verse_number": "२४", "content_sanskrit": "मत्तवारणयूथानि पङ्कक्लिन्नानि भारत ।\nवर्षतामिव मेघानां वृन्दानि ददृशे तदा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2130421, "chapter_id": 3811, "verse_number": "२५", "content_sanskrit": "हरिणैश्चपलापाङ्गैर्हरिणीसहितैर्वनम् ।\nसशष्पकवलैः श्रीमान् पथि दृष्ट्वा द्रुतं ययौ\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2130422, "chapter_id": 3811, "verse_number": "२६", "content_sanskrit": "महिषैश्च वराहैश्च शार्दूलैश्च निषेवितम् ।\nव्यपेतभीर्गिरिं शौर्याद् भीमसेनो व्यगाहत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2130423, "chapter_id": 3811, "verse_number": "२७", "content_sanskrit": "कुसुमानन्तगन्धैश्च ताम्रपल्लवकोमलैः ।\nयाच्यमान इवारण्ये द्रुमैर्मारुतकम्पितैः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2130424, "chapter_id": 3811, "verse_number": "२८", "content_sanskrit": "कृतपद्माञ्जलिपुटा मत्तषट्पदसेविताः ।\nप्रियतीर्थवना मार्गे पद्मिनीः समतिक्रमन्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2130425, "chapter_id": 3811, "verse_number": "२९", "content_sanskrit": "सज्जमानमनोदृष्टिः फुल्लेषु गिरिसानुषु ।\nद्रौपदीवाक्यपाथेयो भीमः शीघ्रतरं ययौ\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2130426, "chapter_id": 3811, "verse_number": "३०", "content_sanskrit": "परिवृत्तेऽहनि ततः प्रकीर्णहरिणे वने ।\nकाञ्चनैर्विमलैः पद्मैर्ददर्श विपुलां नदीम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2130427, "chapter_id": 3811, "verse_number": "३१", "content_sanskrit": "हंसकारण्डवयुतां चक्रवाकोपशोभिताम् ।\nरचितामिव तस्याद्रेर्मालां विमलपङ्कजाम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2130428, "chapter_id": 3811, "verse_number": "३२", "content_sanskrit": "तस्यां नद्यां महासत्त्वः सौगन्धिकवनं महत् ।\nअपश्यत् प्रीतिजननं बालार्कसदृशद्युति\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2130429, "chapter_id": 3811, "verse_number": "३३", "content_sanskrit": "तद् दृष्ट्वा लब्धकामः स मनसा पाण्डुनन्दनः ।\nवनवासपरिक्लिष्टां जगाम मनसा प्रियाम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2130430, "chapter_id": 3811, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि अष्टचत्वारिंशदधिकशततमोऽध्यायः ॥ १४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2130431, "chapter_id": 3811, "verse_number": "१०४", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि चतुरधिकशततमोऽध्यायः ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2130432, "chapter_id": 3811, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]