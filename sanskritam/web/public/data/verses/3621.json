[{"id": 2122116, "chapter_id": 3621, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2122117, "chapter_id": 3621, "verse_number": "१", "content_sanskrit": "वचः श्रुत्वैव भीष्मस्य चेदिराडुरुविक्रमः ।\nयुयुत्सुर्वासुदेवेन वासुदेवमुवाच ह ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2122118, "chapter_id": 3621, "verse_number": "२", "content_sanskrit": "आह्वये त्वां रणायैहि मया सह जनार्दन ।\nयावदद्य निहन्मि त्वां सहितं सर्वपाण्डवैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2122119, "chapter_id": 3621, "verse_number": "३", "content_sanskrit": "स च भीष्मोऽपि मे वध्यः पाण्डवाः सर्वराजभिः ।\nनृपतीन् समतिक्रम्य यैरराजा त्वमर्चितः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2122120, "chapter_id": 3621, "verse_number": "४", "content_sanskrit": "ये त्वां गोपमराजानं बाल्यादर्चन्ति दुर्मतिम् ।\nअनर्हमर्हवत् कृष्ण वध्यास्त इति मे मतिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2122121, "chapter_id": 3621, "verse_number": "५", "content_sanskrit": "इत्युक्त्वा राजशार्दूलः शार्दूल इव नादयन् ।\nपश्यतां भूमिपालानां शिशुपालः प्रतापवान् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2122122, "chapter_id": 3621, "verse_number": "६", "content_sanskrit": "स रणायैव सङ्क्रुद्धः सन्नद्धः सर्वराजभिः ।\nसुनीथः प्रययौ क्षिप्रं पार्थयज्ञजिघांसया ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2122123, "chapter_id": 3621, "verse_number": "७", "content_sanskrit": "ततश्चक्रगदापाणिः केशवः केशिहा हरिः ।\nसध्वजं रथमास्थाय युद्धाय समुपस्थितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2122124, "chapter_id": 3621, "verse_number": "८", "content_sanskrit": "स रथस्य स्वनेनैव कोपितान् सर्वपार्थिवान् ।\nआससाद रथे कृष्णः सज्जितैकरथे स्थितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2122125, "chapter_id": 3621, "verse_number": "९", "content_sanskrit": "ततः पुष्करपत्राक्षं गरुडध्वजमच्युतम् ।\nदिवाकरमिवोद्यन्तं ददृशुः सर्वपार्थिवाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2122126, "chapter_id": 3621, "verse_number": "१०", "content_sanskrit": "दृष्ट्वा कृष्णमथायान्तं प्रतपन्तमिवौजसा ।\nस्थितं पुष्परथे दिव्ये पुष्पकेतुमिवापरम् ।\nयथार्हं केशवे वृत्तिमवशाः प्रतिपेदिरे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2122127, "chapter_id": 3621, "verse_number": "११", "content_sanskrit": "तानुवाच महाबाहुर्महासुरनिबर्हणः ।\nवृष्णिवीरस्तदा राजन् सान्त्वयन् परवीरहा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2122128, "chapter_id": 3621, "verse_number": "१२", "content_sanskrit": "अपेत सबलाः सर्व आश्वस्ता मम शासनात् ।\nअदुष्टान् दूषयेत् पाप एष वै सर्वपार्थिवान् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2122129, "chapter_id": 3621, "verse_number": "१३", "content_sanskrit": "एष नः शत्रुरत्यन्तमेष वृष्णिविमर्दनः ।\nसात्वतानां नृशंसात्मा वैरं चरति शाश्वतम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2122130, "chapter_id": 3621, "verse_number": "१४", "content_sanskrit": "प्राग्ज्योतिषपुरं यातानस्मान् ज्ञात्वा नृशंसकृत् ।\nअदहद् द्वारकामेष स्वस्रीयः सन्नराधिपाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2122131, "chapter_id": 3621, "verse_number": "१५", "content_sanskrit": "क्रीडतो भोजराजन्यान् एष रैवतके गिरौ ।\nगत्वा हत्वा च बध्वा च स्वपुरं तानथानयत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2122132, "chapter_id": 3621, "verse_number": "१६", "content_sanskrit": "अश्वमेधे हयं मेध्यमुत्सृष्टं रक्षिभिर्वृतम् ।\nअपाहरत् पापबुद्धिः पितुर्य्यज्ञजिघांसया ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2122133, "chapter_id": 3621, "verse_number": "१७", "content_sanskrit": "सौवीरात् प्रतिपत्तौ च बभ्रोरेष यशस्विनः ।\nभार्यामपाहरत् पापामकामां धर्मतो गताम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2122134, "chapter_id": 3621, "verse_number": "१८", "content_sanskrit": "एष मायाप्रतिच्छन्नः करूशार्थे तपस्विनीम् ।\nजहार भार्यां वैशालीं मातुलस्य नृशंसकृत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2122135, "chapter_id": 3621, "verse_number": "१९", "content_sanskrit": "विशालराज्ञो दुहितां मम पित्रा वृतां सतीम् ।\nअनेन कृत्वा सन्धानं करूशेन जिहीर्षया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2122136, "chapter_id": 3621, "verse_number": "२०", "content_sanskrit": "वृष्णिदारान् विलुप्यैष हत्वा च कुकुरान्धकान् ।\nपापबुद्धिरुपातिष्ठत् स प्रविश्य ससम्भ्रमम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2122137, "chapter_id": 3621, "verse_number": "२१", "content_sanskrit": "जरासन्धं समाश्रित्य कृतवान् विप्रियाणि मे ।\nतानि सर्वाणि सङ्ख्र्यातुं न शक्नोमि धराधिपाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2122138, "chapter_id": 3621, "verse_number": "२२", "content_sanskrit": "एवमेतदपर्यन्तमेष वृष्णिषु किल्बिषम् ।\nअस्माकमयमारम्भांश्चकार परमानृजुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2122139, "chapter_id": 3621, "verse_number": "२३", "content_sanskrit": "शतं क्षन्तव्यमस्माभिर्वधार्हाणां किलागसाम् ।\nबद्धोऽस्मि समयैर्घोरैर्मातुलेयोऽस्य सङ्गरे ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2122140, "chapter_id": 3621, "verse_number": "२४", "content_sanskrit": "तत् तथा शतमस्माकं क्षान्तं क्षयकरं मया ।\nद्वौ तु मे वधकालेऽस्मिन् न क्षन्तव्यौ कथञ्चन ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2122141, "chapter_id": 3621, "verse_number": "२५", "content_sanskrit": "यज्ञविघ्नकरं हन्यां पाण्डवानां च दुर्हृदम् ।\nइति मे वर्तते भावस्तमतीयां कथं न्वहम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2122142, "chapter_id": 3621, "verse_number": "२६", "content_sanskrit": "पितृष्वसुः कृते दुःखं सुमहन्मर्षयाम्यहम् ।\nदिष्ट्या त्विदं सर्वराज्ञां सन्निधावद्य वर्तते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2122143, "chapter_id": 3621, "verse_number": "२७", "content_sanskrit": "पश्यन्ति हि भवन्तोऽस्य मय्यतीव व्यतिक्रमम् ।\nकृतानि तु परोक्षं मे यानि तानि निबोधत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2122144, "chapter_id": 3621, "verse_number": "२८", "content_sanskrit": "इमं त्वद्य न शक्ष्यामि क्षन्तुमस्य व्यतिक्रमम् ।\nअवलेपाद् वधार्हस्य समग्रे राजमण्डले ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2122145, "chapter_id": 3621, "verse_number": "२९", "content_sanskrit": "रुग्मिण्यामस्य मूढस्य प्रार्थनाऽऽसीन्मुमूर्षतः ।\nन चैनां प्राप्तवान् मूढः शूद्रो वेदश्रुतिं यथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2122146, "chapter_id": 3621, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2122147, "chapter_id": 3621, "verse_number": "३०", "content_sanskrit": "एवमादि ततः सर्वे विस्तरेण नराधिपाः ।\nगर्हणं शिशुपालस्य वासुदेवेन विश्रुताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2122148, "chapter_id": 3621, "verse_number": "३१", "content_sanskrit": "वासुदेववचः श्रुत्वा चेदिराजमगर्हयन् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2122149, "chapter_id": 3621, "verse_number": "३२", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा शिशुपालः प्रतापवान् ।\nजहास स्वनवद्धासं सम्प्रहस्यैनमूचिवान् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2122150, "chapter_id": 3621, "verse_number": "३३", "content_sanskrit": "मत्पूर्वां रुग्मिणीं कृष्ण संसत्सु परिकीर्तयन् ।\nविशेषतः पार्थिवेषु व्रीडां न कुरुषे कथम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2122151, "chapter_id": 3621, "verse_number": "३४", "content_sanskrit": "मन्यमानो हि कः सत्सु पुरुषः परिकीर्तयेत् ।\nअन्यपूर्वां स्त्रियं जातु त्वदन्यो मधुसूदन ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2122152, "chapter_id": 3621, "verse_number": "३५", "content_sanskrit": "क्षम वा यदि ते श्रद्धा मा वा कृष्ण मम क्षम ।\nक्रुद्धाद् वाऽपि प्रमत्ताद् वा किं मे त्वत्तो भविष्यति ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2122153, "chapter_id": 3621, "verse_number": "३६", "content_sanskrit": "तथा ब्रुवत एवास्य भगवान् मधुसूदनः ।\nमनसाऽचिन्तयच्चक्रं दैत्यसैन्यनिषूदनम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2122154, "chapter_id": 3621, "verse_number": "३७", "content_sanskrit": "एतस्मिन्नेव काले तु चक्रे हस्तगते सति ।\nउवाच भगवानुच्चैर्वाक्यं वाक्यविशारदः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2122155, "chapter_id": 3621, "verse_number": "३८", "content_sanskrit": "शृण्वन्तु मे महीपाला येनैतन्निन्दितं मया ।\nअपराधशतं क्षम्यं मातुलस्यैव याचते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2122156, "chapter_id": 3621, "verse_number": "३९", "content_sanskrit": "दत्तं मया याचितानि तानि पूर्णानि पार्थिवाः ।\nअधुना तं वधिष्यामि पश्यतां वो महीक्षिताम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2122157, "chapter_id": 3621, "verse_number": "४०", "content_sanskrit": "वासुदेववचः श्रुत्वा प्राद्रवन् सर्वपार्थिवाः ।\nविहाय परमक्रुद्धं चेदिराजं चमूमुखे ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2122158, "chapter_id": 3621, "verse_number": "४१", "content_sanskrit": "स तांस्तु प्रद्रुतान् सर्वान् संवीक्ष्य वसुधाधिपान् ।\nतदा तद्वृष्णिवीरेण त्रासितानुरुविक्रमान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2122159, "chapter_id": 3621, "verse_number": "४२", "content_sanskrit": "कृष्णतेजोहतान् सर्वान् समीक्ष्य वसुधाधिपान् ।\nशिशुपालो रथेनैकः प्रत्युपायात् स केशवम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2122160, "chapter_id": 3621, "verse_number": "५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां सभापर्वर्णि\nत्रिषष्टितमोऽध्यायः ॥६३॥ शिशुपालवधपर्वणि पञ्चमोऽध्यायः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2122161, "chapter_id": 3621, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]