[{"id": 2150931, "chapter_id": 4277, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2150932, "chapter_id": 4277, "verse_number": "१", "content_sanskrit": "वर्षाणां चैव नामानि पर्वतानां च सञ्जय ।\nआचक्ष्व मे यथातत्त्वं ये च पर्वतवासिनः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2150933, "chapter_id": 4277, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2150934, "chapter_id": 4277, "verse_number": "२", "content_sanskrit": "दक्षिणेन तु श्वेतस्य नीलस्यैवोत्तरेण तु ।\nवर्षं रमणकं नाम जायन्ते तत्र मानवाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2150935, "chapter_id": 4277, "verse_number": "३", "content_sanskrit": "शुक्लाभिजनसम्पन्नाः सर्वे सुप्रियदर्शनाः ।\nरतिप्रधानाश्च तथा जायन्ते तत्र मानवाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2150936, "chapter_id": 4277, "verse_number": "४", "content_sanskrit": "दश वर्षसहस्राणि शतानि दश पञ्च च ।\nजीवन्ति ते महाराज नित्यं मुदितमानसाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2150937, "chapter_id": 4277, "verse_number": "५", "content_sanskrit": "दक्षिणे शृङ्गिणश्चैव श्वेतस्याथोत्तरेण च ।\nवर्षं हैरण्वतं नाम यत्र हैरण्वती नदी ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2150938, "chapter_id": 4277, "verse_number": "६", "content_sanskrit": "यक्षानुगा महाराज धन्विनः प्रियदर्शनाः ।\nमहाबलास्तत्र सदा राजन् मुदितमानसाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2150939, "chapter_id": 4277, "verse_number": "७", "content_sanskrit": "एकादश सहस्राणि वर्षाणां ते जनाधिप ।\nआयुष्प्रमाणं जीवन्ति शतानि दश पञ्च च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2150940, "chapter_id": 4277, "verse_number": "८", "content_sanskrit": "शृङ्गाणि वै शृङ्गवतस्त्रीण्येव मनुजाधिप ।\nएकं मणिमयं तत्र तथैकं रौग्ममद्भुतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2150941, "chapter_id": 4277, "verse_number": "९", "content_sanskrit": "सर्वरत्नमयं चैकं भवनैरुपशोभितम् ।\nतत्र स्वयम्प्रभा देवी नित्यं वसति शाण्डिली ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2150942, "chapter_id": 4277, "verse_number": "१०", "content_sanskrit": "उत्तरेण तु शृङ्गस्य समुद्रान्ते जनाधिप ।\nवर्षमैरावतं नाम तस्माच्छृङ्गवतः परम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2150943, "chapter_id": 4277, "verse_number": "११", "content_sanskrit": "न तत्र सूर्यस्तपति न ते जीर्यन्ति मानवाः ।\nचन्द्रमाश्च सनक्षत्रो ज्योतिर्भूत इवावृतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2150944, "chapter_id": 4277, "verse_number": "१२", "content_sanskrit": "पद्मप्रभाः पद्मवर्णाः पद्मपत्रनिभेक्षणाः ।\nपद्मपत्रसुगन्धाश्च जायन्ते तत्र मानवाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2150945, "chapter_id": 4277, "verse_number": "१३", "content_sanskrit": "अनिष्यन्दाः सुगन्धाश्च निराहारा जितेन्द्रियाः ।\nदेवलोकच्युताः सर्वे तथा विरजसो नृप ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2150946, "chapter_id": 4277, "verse_number": "१४", "content_sanskrit": "त्रयोदश सहस्राणि वर्षाणां ते जनाधिप ।\nआयुष्प्रमाणं जीवन्ति नरा भरतसत्तम ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2150947, "chapter_id": 4277, "verse_number": "१५", "content_sanskrit": "क्षीरोदस्य समुद्रस्य तथैवोत्तरतः प्रभुः ।\nहरिर्वसति वैकुण्ठः शकटे कनकात्मके ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2150948, "chapter_id": 4277, "verse_number": "१६", "content_sanskrit": "अष्टचक्रं हि तद् यानं भूतयुक्तं मनोजवम् ।\nअग्निवर्णं महावेगं जाम्बूनदपरिष्कृतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2150949, "chapter_id": 4277, "verse_number": "१७", "content_sanskrit": "स प्रभुः सर्वभूतानां विभुश्च भरतर्षभ ।\nसङ्क्षेपो विस्तरश्चैव कर्ता कारयिता च सः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2150950, "chapter_id": 4277, "verse_number": "१८", "content_sanskrit": "पृथिव्यापस्तथाकाशं वायुस्तेजश्च पार्थिव ।\nस यज्ञः सर्वभूतानामास्यं तस्य हुताशनः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2150951, "chapter_id": 4277, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150952, "chapter_id": 4277, "verse_number": "१९", "content_sanskrit": "एवमुक्तः सञ्जयेन धृतराष्ट्रो महामनाः ।\nध्यानमन्वगमद् राजा पुत्रान् प्रति जनाधिप ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150953, "chapter_id": 4277, "verse_number": "२०", "content_sanskrit": "स विचिन्त्य महाराज पुनरेवाब्रवीद् वचः ।\nअसंशयं सूतपुत्र कालः सङ्क्षिप्यते जगत् ।\nसृजते च पुनः सर्वं नेह विद्यति शाश्वतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150954, "chapter_id": 4277, "verse_number": "२१", "content_sanskrit": "नरो नारायणश्चैव सर्वज्ञः सर्वभूतभृत् ।\nदेवा वैकुण्ठ इत्याहुर्वेदा विष्णुरिति प्रभुम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150955, "chapter_id": 4277, "verse_number": "९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां भीष्मपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150956, "chapter_id": 4277, "verse_number": "", "content_sanskrit": "॥ इति जम्बूखण्डनिर्माणपर्वणि नवमोऽध्यायः ॥९॥\n* * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]