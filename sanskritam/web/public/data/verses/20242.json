[{"id": 7000242000, "chapter_id": 20242, "verse_number": "२४२-१", "content_sanskrit": "वशिष्ठकरालजनकसंवादवर्णनम् वसिष्ठ उवाच एवमप्रतिबुद्धत्वादबुद्धमनुवर्तते ।\nदेहाद्देहसहस्राणि तथा च न स भिद्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000242001, "chapter_id": 20242, "verse_number": "२४२-२", "content_sanskrit": "?Bतिर्यग्योनिसहस्रेषु कदाचिद्देवतास्वपि ।\nउत्पद्यति तपोयोगाद्‌गुणैः सह गुणक्षयात् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000242002, "chapter_id": 20242, "verse_number": "२४२-३", "content_sanskrit": "मनुष्यत्वाद्दिवं याति देवो मानुष्यमेति च ।\nमानुष्यान्निरयस्थानमालयं प्रतिपद्यते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000242003, "chapter_id": 20242, "verse_number": "२४२-४", "content_sanskrit": "कोषकारो यथाऽऽत्मानं कीटः समभिरुन्धति ।\nसूत्रतन्तुगुणैर्नित्यं तथाऽयमगुणो गुणैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000242004, "chapter_id": 20242, "verse_number": "२४२-५", "content_sanskrit": "द्वंद्वंमेति च निर्द्वंद्वस्तासु तास्विह योनिषु ।\nशीर्षरोगेऽक्षिरोगे च दन्तशूले गलग्रहे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000242005, "chapter_id": 20242, "verse_number": "२४२-६", "content_sanskrit": "जलोदरेऽतिसारे च गण्डमालविचर्चिके ।\nश्वत्रकुष्ठेऽग्निदग्धे च सिध्मापस्मारयोरपि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000242006, "chapter_id": 20242, "verse_number": "२४२-७", "content_sanskrit": "यानि चान्यानि द्वंद्वानि प्राकृतानि शरीरिणाम् ।\nउत्पद्यन्ते विचित्राणि तान्येवाऽऽत्माऽभिमन्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000242007, "chapter_id": 20242, "verse_number": "२४२-८", "content_sanskrit": "अभिमानातिमानानां तथैव सुकृतान्यपि ।\nएकवासाश्चतुर्वासाः शायी नित्यमधस्तथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000242008, "chapter_id": 20242, "verse_number": "२४२-९", "content_sanskrit": "मण्डूकशायी च तथा वीरासनगतस्तथा ।\nवीरमासनमाकाशे तथा शयनमेव च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000242009, "chapter_id": 20242, "verse_number": "२४२-१०", "content_sanskrit": "इष्टकाप्रस्तरे चैव चक्रकप्रस्तरे तथा ।\nभस्माप्रस्तरशायी च भूमिशय्यानुलेपनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000242010, "chapter_id": 20242, "verse_number": "२४२-११", "content_sanskrit": "वीरस्थानाम्बुपाके च शयनं फलकेषु च ।\nविविधासु च शय्यासु फलगृह्यान्वितासु च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000242011, "chapter_id": 20242, "verse_number": "२४२-१२", "content_sanskrit": "उद्याने खललाग्ने तु क्षौमकृष्णाजिनान्वितः ।\nमणिवालपरीधानो व्याघ्रचर्मपरिच्छदः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000242012, "chapter_id": 20242, "verse_number": "२४२-१३", "content_sanskrit": "सिंहचर्मपरीधानः पट्टवासास्तथैव च ।\nफलकं(?)परिधानश्च तथा कटकवस्त्रधृक् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000242013, "chapter_id": 20242, "verse_number": "२४२-१४", "content_sanskrit": "कटैकवसनश्चैव चीरवासास्तथैव च ।\nवस्त्राणि चान्यानि बहून्यभिमत्य य बुद्धिमान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000242014, "chapter_id": 20242, "verse_number": "२४२-१५", "content_sanskrit": "भोजनानि विचित्राणि रत्नानि विविधानि च ।\nएकरात्रान्तराशित्वमेककालिभोजनम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000242015, "chapter_id": 20242, "verse_number": "२४२-१६", "content_sanskrit": "चतुर्थाष्टमकालं च षष्ठकालिकमेव च ।\nषड्रात्रभोजनश्चैव तथा चाष्टाहभोजनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000242016, "chapter_id": 20242, "verse_number": "२४२-१७", "content_sanskrit": "मासोपवासी मूलाशी फलाहारस्तथैव च ।\nवायुभक्षश्च पिण्याकदधिगोमयभोजनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000242017, "chapter_id": 20242, "verse_number": "२४२-१८", "content_sanskrit": "गोमूत्रभोजनश्चैव काशपुष्पाशनस्तथा ।\nशैवालभोजनश्चैव तथा चान्येन वर्तयन् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000242018, "chapter_id": 20242, "verse_number": "२४२-१९", "content_sanskrit": "वर्तयञ्शीर्मपर्णैश्च प्रकीर्णफलभोजनः ।\nविविधानि च कृच्छ्राणि सेवते सिद्धिकाङ्क्षया ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000242019, "chapter_id": 20242, "verse_number": "२४२-२०", "content_sanskrit": "चान्द्रायणानि विधिवल्लिङ्गानि विविधानि च ।\nचातुराश्रम्ययुक्तानि धर्माधर्माश्रयाण्यपि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000242020, "chapter_id": 20242, "verse_number": "२४२-२१", "content_sanskrit": "उपाश्रयानप्यपरान्पाखण्डान्विविधानपि ।\nविविक्ताश्च शिलाछायास्तथा प्रस्रवणानि च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000242021, "chapter_id": 20242, "verse_number": "२४२-२२", "content_sanskrit": "पुलिनानि विविक्तानि विविधानि तपांसि च ।\nयज्ञांश्च विविधाकारान्विद्याश्च विविधास्तथा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000242022, "chapter_id": 20242, "verse_number": "२४२-२३", "content_sanskrit": "नियमान्विविधांश्चापि विविधानि तपांसि च ।\nयज्ञांश्च विविधाकारान्विद्याश्च विविधास्तथा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000242023, "chapter_id": 20242, "verse_number": "२४२-२४", "content_sanskrit": "वणिक्पथं द्विजक्षत्रवैश्यशूद्रांस्तथैव च ।\nदानां च विविधाकारं दीनान्धकृपणादिषु ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000242024, "chapter_id": 20242, "verse_number": "२४२-२५", "content_sanskrit": "अभिमन्येत संधातुं तथैव विविधान्गुणान् ।\nसत्त्वं रजस्तमश्चैव धर्मार्थै काम एव च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000242025, "chapter_id": 20242, "verse_number": "२४२-२६", "content_sanskrit": "यजनाध्ययने दानं तथैवाऽऽहुः प्रतिग्रहम् ।\nयाजनाध्यापने चैव तथाऽन्यदपि किंचन ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000242026, "chapter_id": 20242, "verse_number": "२४२-२७", "content_sanskrit": "यजनाध्ययने दानं तथैवाऽऽहुः प्रतिग्रहम् ।\nयाजनाध्यापने चैव तथाऽन्यदपि किंचन ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000242027, "chapter_id": 20242, "verse_number": "२४२-२८", "content_sanskrit": "जन्ममृत्युविधानेन तथा विशसनेन च ।\nशुभाशुभमयं सर्वमेतदाहुः सनातनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000242028, "chapter_id": 20242, "verse_number": "२४२-२९", "content_sanskrit": "प्रकृतिः कुरुते देवी भयं प्रलयमेव च ।\nदिवसान्ते गुणानेतानतीत्यैकोऽवतिष्ठते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000242029, "chapter_id": 20242, "verse_number": "२४२-३०", "content_sanskrit": "रश्मिजालमिवाऽऽदित्यस्तत्कालं संनियच्छति ।\nएवमेवैष तत्सर्वं क्रीडार्थमभिमन्यते ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000242030, "chapter_id": 20242, "verse_number": "२४२-३१", "content_sanskrit": "आत्मरूपगुणानेतान्विविधान्हृदयप्रियान् ।\nएवमेतां प्रकुर्वाणः सर्गप्रलयधर्मिणीम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000242031, "chapter_id": 20242, "verse_number": "२४२-३२", "content_sanskrit": "क्रियां क्रियापथे रक्तस्त्रिगुणस्त्रिगुणाधिपः ।\nक्रियाक्रियापतोपेतस्तथा तदिति मन्यते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000242032, "chapter_id": 20242, "verse_number": "२४२-३३", "content_sanskrit": "प्रकृत्या सर्वमेवेदं जगदन्धीकृतं विभो ।\nरजसा तमसा चैव व्याप्तं सर्वमनेकधा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000242033, "chapter_id": 20242, "verse_number": "२४२-३४", "content_sanskrit": "एवं द्वंद्वान्यतीतानि मम वर्तन्ति नित्यशः ।\nमत्त एतानि जायन्ते प्रलये यान्ति मामपि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000242034, "chapter_id": 20242, "verse_number": "२४२-३५", "content_sanskrit": "निस्तर्तव्याण्थैतानि सर्वाणीति नराधिप ।\nमन्यते पक्षबुद्धत्वात्तथैव सुकृतान्यपि ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000242035, "chapter_id": 20242, "verse_number": "२४२-३६", "content_sanskrit": "भोक्तव्यानि ममैतानि वेवलोकगतेन वै ।\nइहैव चैनं भोक्ष्यामि शुभासुभफलोदयम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000242036, "chapter_id": 20242, "verse_number": "२४२-३७", "content_sanskrit": "सुखमेवं तु कर्तव्यं सकृत्कृत्वा सुखं मम ।\nयावदेव तु मे सौख्यं जात्यां जात्यां भविष्यति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000242037, "chapter_id": 20242, "verse_number": "२४२-३८", "content_sanskrit": "भविष्यति न मे दुःखं कृतेनेहाप्यनन्तकम् ।\nसुखदुःखं हि मानुष्यं निरये चापि मज्जनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000242038, "chapter_id": 20242, "verse_number": "२४२-३९", "content_sanskrit": "निरयाच्चापि मानुष्यं कालेनैष्याम्यहं पुनः ।\nमनुष्यत्वाच्च देवत्वं देवत्वात्पौरुषं पुनः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000242039, "chapter_id": 20242, "verse_number": "२४२-४०", "content_sanskrit": "मनुष्यत्वाच्च निरयं पर्यायेणोपगच्छति ।\nएष एवं द्विजातीनामात्मा वै स गुणैर्वृतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000242040, "chapter_id": 20242, "verse_number": "२४२-४१", "content_sanskrit": "तेन देवमनुष्येषु निरयं चोपपद्यते ।\nममत्वेनाऽऽवृतो नित्यं तत्रैव परिवर्तते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000242041, "chapter_id": 20242, "verse_number": "२४२-४२", "content_sanskrit": "सर्गकोटिसहस्राणि मरणान्तासु मूर्तिषु ।\nय एवं कुरुते कर्म शूभाशुभफलात्मकम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000242042, "chapter_id": 20242, "verse_number": "२४२-४३", "content_sanskrit": "स एव फलमाप्नोति त्रिषु लोकेषु मूर्तिमान् ।\nप्रकृतिः कुरुते कर्मशुभशुभफलात्मकम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000242043, "chapter_id": 20242, "verse_number": "२४२-४४", "content_sanskrit": "प्रकृतिश्व तथाऽऽनोति त्रिषु लोकेषु कामणा ।\nतिर्यग्योनिमनुष्यत्वले देवलोके तथैव च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000242044, "chapter_id": 20242, "verse_number": "२४२-४५", "content_sanskrit": "त्रीणि स्थानानि चैतानि जानीयात्प्राकृतानि ह ।\nअलिङ्गप्रकृतित्वाच्च लिङ्गैरप्यनुमीयते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000242045, "chapter_id": 20242, "verse_number": "२४२-४६", "content_sanskrit": "तथैव पौरुषं लिङ्गमनुमानाद्धि मन्यते ।\nस लिङ्गान्तरमासाद्य प्राकृतं लिङ्गमव्रणम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000242046, "chapter_id": 20242, "verse_number": "२४२-४७", "content_sanskrit": "व्रणद्वाराण्यधिष्ठाय कर्माण्यात्मनि मन्यते ।\nश्रोत्रादीनि तु सर्वाणि पञ्च कर्मेन्द्रियाण्यथ ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000242047, "chapter_id": 20242, "verse_number": "२४२-४८", "content_sanskrit": "रागादीनि प्रवर्तन्ते गुणेष्विह गुणैः सह ।\nअहमेतानि वै कुर्वन्ममैतानीन्द्रियाणिह ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000242048, "chapter_id": 20242, "verse_number": "२४२-४९", "content_sanskrit": "निरिन्द्रियो हि मन्येत व्रणवानस्मि निर्व्रणः ।\nअलिङ्गो लिङ्गमात्मानमकालं कालमात्मनः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000242049, "chapter_id": 20242, "verse_number": "२४२-५०", "content_sanskrit": "असत्त्वं सत्त्वमात्मानममृतं मृतमात्मनः ।\nअमृत्युं मृत्युमात्मात्मानमभवं भवमात्मनः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000242050, "chapter_id": 20242, "verse_number": "२४२-५१", "content_sanskrit": "अक्षेत्रं क्षेत्रमात्मानमसङ्गं सङ्गमात्मनः ।\nअतत्त्वं तत्त्वमात्मानमभवं भवमात्मनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000242051, "chapter_id": 20242, "verse_number": "२४२-५२", "content_sanskrit": "अक्षरं क्षरमात्मानमबुद्धत्वाद्धि मन्यते ।\nएवमप्रतिबुद्धत्वादबुद्धजनसेवनात् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000242052, "chapter_id": 20242, "verse_number": "२४२-५३", "content_sanskrit": "सर्गकोटिसहस्राणि पतनान्तानि गच्छति ।\nजन्मान्तरसहस्राणि मरणान्तानि गच्छति ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000242053, "chapter_id": 20242, "verse_number": "२४२-५४", "content_sanskrit": "तिर्यग्योनिमनुष्यत्वे देवलोके तथैव च ।\nचन्द्रमा इव कोशानां पुनस्तत्र सहस्रशः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000242054, "chapter_id": 20242, "verse_number": "२४२-५५", "content_sanskrit": "नीयतेऽप्रतिबुद्धत्वादेवमेव कुबुद्धिमान् ।\nकला पञ्चदशी योनिस्तद्धाम इति पठ्यते ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000242055, "chapter_id": 20242, "verse_number": "२४२-५६", "content_sanskrit": "नित्यमेव विजानीहि सोमं वै षोडशांशकैः ।\nकलया जायतेऽजस्रं पुनः पुनरबुद्धिमान् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000242056, "chapter_id": 20242, "verse_number": "२४२-५७", "content_sanskrit": "धीमांश्चायं न भवति नृप एवं हि जायते ।\nषोडशी तु कला सूक्ष्मा स सोम उपधार्यताम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000242057, "chapter_id": 20242, "verse_number": "२४२-५८", "content_sanskrit": "न तूपयूज्यते देवैर्दैवानपि युनक्ति सः ।\nममत्वं क्षपयित्वा तु जायते नृपसत्तम ।\nप्रकृतेस्त्रिगुणायास्तु स एव त्रिगुणो भवेत् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]