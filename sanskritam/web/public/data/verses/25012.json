[{"id": 7005012000, "chapter_id": 25012, "verse_number": "७-१-१९५-१", "content_sanskrit": "ईश्वर उवाच ।\nततो वृद्धप्रभासं तु गच्छेच्च नियतात्मवान् ।\nआदिप्रभासाद्दक्षिणतो नातिदूरे व्यवस्थितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005012001, "chapter_id": 25012, "verse_number": "७-१-१९५-२", "content_sanskrit": "चतुर्मुखं महालिंगं दर्शनात्पापनाशनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005012002, "chapter_id": 25012, "verse_number": "७-१-१९५-३", "content_sanskrit": "श्रीदेव्युवाच ।\nकथं वृद्धप्रभासं तु नाम तस्याभवत्प्रभो ।\nतस्मिन्दृष्टे फलं किं स्यात्स्तुते संपूजिते तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005012003, "chapter_id": 25012, "verse_number": "७-१-१९५-४", "content_sanskrit": "एतत्कथय मे देव संक्षेपान्नातिविस्तरात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005012004, "chapter_id": 25012, "verse_number": "७-१-१९५-५", "content_sanskrit": "ईश्वर उवाच ।\nआदौ स्वायंभुवे देवि पूर्वमन्वन्तरे पुरा ।\nत्रेतायुगे चतुर्थे तु प्रभासे क्षेत्र उत्तमे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005012005, "chapter_id": 25012, "verse_number": "७-१-१९५-६", "content_sanskrit": "तस्मिन्काले महादेवि पूर्वमन्वंतरे पुरा ।\nत्रेतायुगे चतुर्थे तु ऋषयस्तत्र संगताः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005012006, "chapter_id": 25012, "verse_number": "७-१-१९५-७", "content_sanskrit": "दर्शनार्थं प्रभासस्य उत्तरापथगामिनः ।\nतं दृष्ट्वाऽच्छादितं देवं वज्रेण तु महेश्वरि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005012007, "chapter_id": 25012, "verse_number": "७-१-१९५-८", "content_sanskrit": "विषादं परमं जग्मुर्वाक्यं चेदमथाबुवन् ।\nअदृष्ट्वा शांकरं लिगं न यास्यामो वयं गृहम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005012008, "chapter_id": 25012, "verse_number": "७-१-१९५-९", "content_sanskrit": "स्वर्गार्थिनो वयं प्राप्ता महदध्वानमेव हि ।\nतस्मादत्रैव तिष्ठामो यावल्लिंगस्य दर्शनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005012009, "chapter_id": 25012, "verse_number": "७-१-१९५-१०", "content_sanskrit": "एवं ते निश्चयं कृत्वा परस्मिंस्तपसि स्थिताः ।\nवर्षास्वाकाशगा भूत्वा हेमंते सलिलाश्रयाः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005012010, "chapter_id": 25012, "verse_number": "७-१-१९५-११", "content_sanskrit": "पञ्चाग्निसाधना ग्रीष्मे नियता ब्रह्मचारिणः ।\nबहून्वर्षगणान्विप्रा जराग्रस्तास्तदाऽभवन् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005012011, "chapter_id": 25012, "verse_number": "७-१-१९५-१२", "content_sanskrit": "एवं वृद्धत्वमापन्ना यदा ते वरवर्णिनि ।\nछन्द्यमाना वरैस्ते तु शंकरेण महात्मना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005012012, "chapter_id": 25012, "verse_number": "७-१-१९५-१३", "content_sanskrit": "लिंगस्य दर्शनं मुक्त्वा न तेऽन्यं वव्रिरे वरम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005012013, "chapter_id": 25012, "verse_number": "७-१-१९५-१४", "content_sanskrit": "तेषां तु निश्चयं ज्ञात्वा सर्वेषां वृषभध्वजः ।\nअनुकम्पापरो भूत्वा स्वलिंगं तानदर्शयत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005012014, "chapter_id": 25012, "verse_number": "७-१-१९५-१५", "content_sanskrit": "एतस्मिन्नेव काले तु भित्त्वा चैव वसुन्धराम् ।\nउत्थितं सहसा लिंगं तदेव वरवर्णिनि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005012015, "chapter_id": 25012, "verse_number": "७-१-१९५-१६", "content_sanskrit": "ऋषयस्ते च तं दृष्ट्वा सर्वे च त्रिदिवं गताः ।\nअथ तेषु प्रयातेषु शक्रस्तप्तमना ह्यभूत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005012016, "chapter_id": 25012, "verse_number": "७-१-१९५-१७", "content_sanskrit": "तमपि च्छादयामास वज्रेण शतपर्वणा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005012017, "chapter_id": 25012, "verse_number": "७-१-१९५-१८", "content_sanskrit": "वृद्धभावे यतस्तेषामृषीणां दर्शनं गतः ।\nअतो वृद्धप्रभासं तत्कीर्त्यते वसुधातले ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005012018, "chapter_id": 25012, "verse_number": "७-१-१९५-१९", "content_sanskrit": "तस्मिन्दृष्टे वरारोहे अद्यापि लभते फलम् ।\nराजसूयाश्वमेधानां नरो भक्तिसमन्वितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005012019, "chapter_id": 25012, "verse_number": "७-१-१९५-२०", "content_sanskrit": "एवं तत्र समुत्पन्नं प्रभासं वृद्धसंज्ञकम् ।\nतत्रोक्षा ब्राह्मणे देयः सम्यग्यात्राफलेप्सुभिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005012020, "chapter_id": 25012, "verse_number": "७-१-१९५-२१", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये वृद्धप्रभासमाहात्म्यवर्णनंनाम पञ्चनवत्युत्तरशततमोऽध्यायः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]