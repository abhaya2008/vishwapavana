[{"id": 2021690, "chapter_id": 1447, "verse_number": "३-८५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2021691, "chapter_id": 1447, "verse_number": "३-८५-१", "content_sanskrit": "तान्सर्वानुत्सुकान्दृष्ट्वा पाण्डवान्दीनचेतसः।\nअश्वासयंस्तथा धौम्यो बृहस्पतिसमोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2021692, "chapter_id": 1447, "verse_number": "३-८५-२", "content_sanskrit": "ब्राह्मणानुमतान्पुण्यानाश्रमान्भरतर्षभ।\nदिशस्तीर्थानि शैलांश्च शृणु मे वदतोऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2021693, "chapter_id": 1447, "verse_number": "३-८५-३", "content_sanskrit": "याञ्श्रुत्वा गदतो राजन्विशोको भवितासि ह।\nद्रौपद्या चानया सार्धं भ्रातृभिश्च नरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2021694, "chapter_id": 1447, "verse_number": "३-८५-४", "content_sanskrit": "श्रवणाच्चैव तेषां त्वं पुण्यमाप्स्यसि पाण्डव।\nगत्वा शतगुणं चैव तेभ्य एव नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021695, "chapter_id": 1447, "verse_number": "३-८५-५", "content_sanskrit": "शृणु पूर्वां दिशं राजन्देवर्षिगणसेविताम्।\nरम्यां ते कथयिष्यामि युधिष्ठिर यथास्मृति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021696, "chapter_id": 1447, "verse_number": "३-८५-६", "content_sanskrit": "तस्यां रदेवर्षिजुष्टायां नैमिषं नाम भारत।\nयत्रतीर्थानि देवानां पुण्यानि च पृथक् पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021697, "chapter_id": 1447, "verse_number": "३-८५-७", "content_sanskrit": "यत्र सा गोमती पुण्या रम्या देवर्षिसेविता।\nयज्ञभूमिश्च देवानां शामित्रं च विवस्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021698, "chapter_id": 1447, "verse_number": "३-८५-८", "content_sanskrit": "तस्यां गिरिवरः पुण्यो गयो राजर्षिसत्कृतः।\nशिवं ब्रह्मसरो यत्रसेवितं त्रिदशर्षिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021699, "chapter_id": 1447, "verse_number": "३-८५-९", "content_sanskrit": "यदर्थे पुरुषव्याघ्र कीर्तयन्ति पुरातनाः।\nएष्टव्या बहवः पुत्रा यद्येकोपि गयां व्रजेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021700, "chapter_id": 1447, "verse_number": "३-८५-१०", "content_sanskrit": "गौरीं वा वरयेत्कन्यां नीलं वा वृषमुत्सृजेत्।\nउत्तारयति संतत्या दश पूर्वान्दशावरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021701, "chapter_id": 1447, "verse_number": "३-८५-११", "content_sanskrit": "महानदी च तत्रैव तथा गयशिरो नृप।\nयत्रासौ कीर्त्यते विप्रैरक्षय्यकरणो वटः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021702, "chapter_id": 1447, "verse_number": "३-८५-१२", "content_sanskrit": "यत्रदत्तं पितृभ्योऽन्नमक्षय्यं भवति प्रभो।\nसा च पुण्यजला तत्र फल्गुनामा महानदी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021703, "chapter_id": 1447, "verse_number": "३-८५-१३", "content_sanskrit": "बहुमूलफला चापि कौशिकी भरतर्षभ।\nविश्वामित्रोऽध्यगाद्यत्र ब्राह्मणत्वं तपोधनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021704, "chapter_id": 1447, "verse_number": "३-८५-१४", "content_sanskrit": "गङ्गा यत्रनदी पुण्या यस्यास्तीरे भगीरथः।\nअयजत्तत्रबहुभिः क्रतुभिर्भूरिदक्षिणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021705, "chapter_id": 1447, "verse_number": "३-८५-१५", "content_sanskrit": "पाञ्चालेषु च कौरव्य कथयन्त्युत्पलावतम्।\nविश्वामित्रोऽयजद्यत्र शक्रेण सह कौशिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021706, "chapter_id": 1447, "verse_number": "३-८५-१६", "content_sanskrit": "यत्रानुवंशं भगवाञ्जामदग्न्यस्तथा जगौ।\nविश्वामित्रस्य तां दृष्ट्वा चिभूतिमतिमानुषीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021707, "chapter_id": 1447, "verse_number": "३-८५-१७", "content_sanskrit": "कान्यकुब्जेऽपिबत्सोममिन्द्रेण सह कौशिकः।\nततः क्षत्रादपाक्रामद्ब्राह्मणोस्मीति चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021708, "chapter_id": 1447, "verse_number": "३-८५-१८", "content_sanskrit": "पवित्रमृषिभिर्जुष्टं पुण्यं पावनमुत्तमम्।\nगङ्गायमुनयोर्वीर संगमं लोकविश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2021709, "chapter_id": 1447, "verse_number": "३-८५-१९", "content_sanskrit": "यत्रायजत भूतात्मा पूर्वमेव पितामहः।\nप्रयागमिति विख्यातं तस्माद्भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2021710, "chapter_id": 1447, "verse_number": "३-८५-२०", "content_sanskrit": "अगस्त्यस्य तु राजेन्द्र तत्राश्रमवरो नृप।\nतत्तथा तापसारण्यं तापसैरुपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2021711, "chapter_id": 1447, "verse_number": "३-८५-२१", "content_sanskrit": "हिरण्यबिन्दुः कथितो गिरौ कालञ्जरे महान्।\nआगस्त्यपर्वतोरभ्यः पुण्यो गिरिवः शिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2021712, "chapter_id": 1447, "verse_number": "३-८५-२२", "content_sanskrit": "महेन्द्रो नाम कौरव्य भार्गवस्य महात्मनः।\nअयजत्तत्रकौन्तेय पूर्वमेव पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2021713, "chapter_id": 1447, "verse_number": "३-८५-२३", "content_sanskrit": "यत्रभागीरथी पुण्यां सरस्यासीद्युधिष्ठिर।\nयत्र सा ब्रह्मशालेति पुण्याख्याता विशांपते।\nधूतपाप्मभिराकीर्णा पुण्यं तस्याश्च दर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2021714, "chapter_id": 1447, "verse_number": "३-८५-२४", "content_sanskrit": "पवित्रो मङ्गलीयश्च ख्यातो लोके सनातनः।\nकेदारश्च मतङ्गस्य महानाश्रम उत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2021715, "chapter_id": 1447, "verse_number": "३-८५-२५", "content_sanskrit": "कुण्डोदः पर्वतो रम्यो बहुमूलफलोदकः।\nनैषधस्तृषितो यत्र जलं शर्म च लब्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2021716, "chapter_id": 1447, "verse_number": "३-८५-२६", "content_sanskrit": "यत्र देववनं पुण्यं तापसैरुपशोभितम्।\nबाहुदा च नदी यत्रनन्दा च गिरिमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2021717, "chapter_id": 1447, "verse_number": "३-८५-२७", "content_sanskrit": "तीर्थानि सरितः शैलाः पुण्यान्यायतनानि च।\nप्राच्यां दिशि महाराज कीर्तितानि मया तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2021718, "chapter_id": 1447, "verse_number": "३-८५-२८", "content_sanskrit": "तिसृष्वन्यासु पुण्यानि दिक्षु तीर्थानि मे शृणु।\nसरितः पर्वतांश्चैव पुण्यान्यायतनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2021719, "chapter_id": 1447, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि पञ्चाशीतितमोऽध्यायः ॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]