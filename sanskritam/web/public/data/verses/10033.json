[{"id": 6000033000, "chapter_id": 10033, "verse_number": null, "content_sanskrit": "अथ तृतीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000033001, "chapter_id": 10033, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.001.m4a", "display_order": 2}, {"id": 6000033002, "chapter_id": 10033, "verse_number": "३-३-१", "content_sanskrit": "ततः स आगत्य पुरीं स्वपित्रोश्चिकीर्षयाऽऽशां बलदेवसंयुतः।\nनिपात्य तुङ्गाद् रिपुयूथनाथं हतं व्यकर्षद् व्यसुमोजसोर्व्याम्॥ ३/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.002.m4a", "display_order": 3, "topics": [{"text": "उद्धवेन विदुरं प्रति संग्रहेण श्रीकृष्णचरित्रकथनम्", "range": "१–२४"}]}, {"id": 6000033003, "chapter_id": 10033, "verse_number": "३-३-२", "content_sanskrit": "सान्दीपिनेः सकृत् प्रोक्तं ब्रह्माधीत्य सविस्तरम्।\nतस्मै प्रादाद् वरं पुत्रं मृतं पञ्चजनोदरात्॥ ३/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.003.m4a", "display_order": 4}, {"id": 6000033004, "chapter_id": 10033, "verse_number": "३-३-३", "content_sanskrit": "समाहुता भीष्मककन्यया ये श्रियः सवर्णेन जिहीर्षयैषाम्।\nगान्धर्ववृत्त्या मिषतां स्वभागं जह्रे पदं मूर्ध्नि दधत् सुपर्णः॥ ३/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.004.m4a", "display_order": 5}, {"id": 6000033005, "chapter_id": 10033, "verse_number": "३-३-४", "content_sanskrit": "ककुद्मतोऽविद्धनसो दमित्वा स्वयंवरे नाग्नजितीमुवाह।\nतान् भग्नमानानभिगृध्यतोऽज्ञान् जघ्नेऽक्षतः शस्‍त्रभृतश्च शस्‍त्रैः॥ ३/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.005.m4a", "display_order": 6}, {"id": 6000033006, "chapter_id": 10033, "verse_number": "३-३-५", "content_sanskrit": "प्रियं प्रभुर्ग्राम्य इव प्रियाया विधित्सुरार्च्छद् द्युतरुं यदर्थे।\nवज्य्राद्रवत् तं सगणो रुषाऽन्धः स्वार्थे पुरा तैर्यमयाचतानतः॥ ३/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.006.m4a", "display_order": 7}, {"id": 6000033007, "chapter_id": 10033, "verse_number": "३-३-६", "content_sanskrit": "सुतं मृधे स्वं वपुषा ग्रसन्तं दृष्ट्वा सुनाभोन्मथितं धरित्र्याः।\nआमन्त्रितस्तत्तनयाय शेषं दत्त्वा तदन्तःपुरमाविवेश॥ ३/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.007.m4a", "display_order": 8}, {"id": 6000033008, "chapter_id": 10033, "verse_number": "३-३-७", "content_sanskrit": "तत्राहृतास्ता नरदेवकन्याः कुजेन दृष्ट्वा हरिमार्तबन्धुम्।\nउत्थाय सद्यो जगृहुः प्रहर्षव्रीडानुरागप्रहितावलोकैः॥ ३/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.008.m4a", "display_order": 9}, {"id": 6000033009, "chapter_id": 10033, "verse_number": "३-३-८", "content_sanskrit": "आसां मुहूर्त एकस्मिन् नानागारेषु योषिताम्।\nसविधिं जगृहे पाणिं पुरुरूपः स्वमायया॥ ३/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.009.m4a", "display_order": 10}, {"id": 6000033010, "chapter_id": 10033, "verse_number": "३-३-९", "content_sanskrit": "तास्वपत्यान्यजनयदात्मतुल्यानि सर्वतः।\nएकैकस्यां दश दश प्रकृतेर्विबुभूषया॥ ३/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.010.m4a", "display_order": 11}, {"id": 6000033011, "chapter_id": 10033, "verse_number": "३-३-१०", "content_sanskrit": "कालमागधशाल्वादीननीकै रुन्धतः पुरम्।\nअजीघनत् स्वयं दिव्यं स्वपुंसां तेज आदिशन्॥ ३/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.011.m4a", "display_order": 12}, {"id": 6000033012, "chapter_id": 10033, "verse_number": "३-३-११", "content_sanskrit": "शम्बरं विविदं बाणं मुरं बल्वलमेव च।\nअन्यांश्च दन्तवक्रादीनवधीत् कांश्च घातयन्॥ ३/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.012.m4a", "display_order": 13}, {"id": 6000033013, "chapter_id": 10033, "verse_number": "३-३-१२", "content_sanskrit": "अथ ते भ्रातृपुत्राणां पक्षयोः पतितान् नृपान्।\nचचाल भूः कुरुक्षेत्रं येषामापततां बलैः॥ ३/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.013.m4a", "display_order": 14}, {"id": 6000033014, "chapter_id": 10033, "verse_number": "३-३-१३", "content_sanskrit": "सकर्णदुःशासनसौबलानां कुमन्त्रपाकेन हतश्रियायुषम्।\nसुयोधनं सानुचरं शयानं भग्नोरुमुर्व्यां स ननन्द पश्यन्॥ ३/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.014.m4a", "display_order": 15}, {"id": 6000033015, "chapter_id": 10033, "verse_number": "३-३-१४", "content_sanskrit": "कियान् भुवोऽयं क्षपितोरुभारो यद् द्रोणभीष्मार्जुनभीमशल्यैः।\nअष्टादशाक्षौहिणिको मदंशैरास्ते बलं दुर्विषहं यदूनाम्॥ ३/३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.015.m4a", "display_order": 16}, {"id": 6000033016, "chapter_id": 10033, "verse_number": "३-३-१५", "content_sanskrit": "मिथो यदैषां भविता विवादो माध्व्या मदात् ताम्रविलोचनानाम्।\nनैषां वधोपाय इयानतोऽन्यो मय्युद्यतेऽन्तर्दधते स्वयं स्म॥ ३/३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.016.m4a", "display_order": 17}, {"id": 6000033017, "chapter_id": 10033, "verse_number": "३-३-१६", "content_sanskrit": "एवं सञ्चिन्त्य भगवान् स्वाराज्ये स्थाप्य धर्मजम्।\nनन्दयामास सुहृदः साधूनां वर्त्म दर्शयन्॥ ३/३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.017.m4a", "display_order": 18}, {"id": 6000033018, "chapter_id": 10033, "verse_number": "३-३-१७", "content_sanskrit": "उत्तरायां धृतः पूरोर्वंशः साध्वभिमन्युना।\nस वै द्रौण्यस्‍त्रसंछिन्नः पुनर्भगवता धृतः॥ ३/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.018.m4a", "display_order": 19}, {"id": 6000033019, "chapter_id": 10033, "verse_number": "३-३-१८", "content_sanskrit": "अयाजयद् धर्मसुतमश्वमेधैस्‍त्रिभिर्विभुः।\nसोऽपि क्ष्मामनुजै रक्षन् रेमे कृष्णमनुव्रतः॥ ३/३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.019.m4a", "display_order": 20}, {"id": 6000033020, "chapter_id": 10033, "verse_number": "३-३-१९", "content_sanskrit": "भगवानपि विश्वात्मा लोकवेदपथानुगः।\nकामान् सिषेवे द्वार्वत्यामसक्तः सांख्यमास्थितः॥ ३/३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.020.m4a", "display_order": 21}, {"id": 6000033021, "chapter_id": 10033, "verse_number": "३-३-२०", "content_sanskrit": "स्निग्धस्मितावलोकेन वाचा पीयूषकल्पया।\nचरित्रेणानवद्येन श्रीनिकेतेन चात्मना॥ ३/३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.021.m4a", "display_order": 22}, {"id": 6000033022, "chapter_id": 10033, "verse_number": "३-३-२१", "content_sanskrit": "इमं लोकममूंश्चैव रमयन् सुतरां यदून्।\nरेमे क्षणदया दत्तक्षणः स्‍त्रीक्षणसौहृदः॥ ३/३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.022.m4a", "display_order": 23}, {"id": 6000033023, "chapter_id": 10033, "verse_number": "३-३-२२", "content_sanskrit": "तस्येत्थं रममाणस्य संवत्सरगणान् बहून्।\nगृहमेधेषु योगेषु विरागः समजायत॥ ३/३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.023.m4a", "display_order": 24}, {"id": 6000033024, "chapter_id": 10033, "verse_number": "३-३-२३", "content_sanskrit": "दैवाधीनेषु कामेषु दैवाधीनः स्वयं पुमान्।\nको विश्रम्भेत योगेन योगेश्वरमनुव्रतः॥ ३/३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.024.m4a", "display_order": 25}, {"id": 6000033025, "chapter_id": 10033, "verse_number": "३-३-२४", "content_sanskrit": "पुर्यां कदाचित् क्रीडद्भिर्यदुभोजकुमारकैः।\nकोपिता मुनयः शेपुर्भगवन्मतकोविदाः॥ ३/३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.025.m4a", "display_order": 26}, {"id": 6000033026, "chapter_id": 10033, "verse_number": "३-३-२५", "content_sanskrit": "ततः कतिपयैर्मासैर्वृष्णिभोजान्धकादयः।\nययुः प्रभासं संहृष्टा रथैर्दैवविमोहिताः॥ ३/३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.026.m4a", "display_order": 27, "topics": [{"text": "श्रीकृष्णाज्ञया यादवानां प्रभासतीर्थगमनकथनम्", "range": "२५–२८"}]}, {"id": 6000033027, "chapter_id": 10033, "verse_number": "३-३-२६", "content_sanskrit": "तत्र स्नात्वा पितॄन् देवान् ऋषींश्चैव तदम्भसा।\nतर्पयित्वाऽथ विप्रेभ्यो गावो बहुगुणा ददुः॥ ३/३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.027.m4a", "display_order": 28}, {"id": 6000033028, "chapter_id": 10033, "verse_number": "३-३-२७", "content_sanskrit": "हिरण्यं रजतं शय्यां वासांस्यजिनकम्बलान्।\nहयान् रथानिभान् कन्यां धरां वृत्तिकरीमपि॥ ३/३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.028.m4a", "display_order": 29}, {"id": 6000033029, "chapter_id": 10033, "verse_number": "३-३-२८", "content_sanskrit": "अन्नं चोरुरसं तेभ्यो दत्त्वा भगवदर्पणम्।\nगोविप्रार्थासवः शूराः प्रणेमुर्भुवि मूर्धभिः॥ ३/३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_03/adhyaya_003/BhP_03.003.029.m4a", "display_order": 30}, {"id": 6000033030, "chapter_id": 10033, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां तृतीयस्कन्धे तृतीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]