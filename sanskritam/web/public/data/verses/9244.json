[{"id": 40016202, "chapter_id": 9244, "verse_number": "1", "content_sanskrit": "तद्दृष्टवासुमहत्कर्मकृतंवानरतस्तमैः । क्रोधमाहारयामासयुधितीव्रमकम्पनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40016203, "chapter_id": 9244, "verse_number": "2", "content_sanskrit": "क्रोधमूर्चितरूपस्तुधून्वन्परमकार्मुकम् । दृष्टवातुकर्मशत्रूणांसारथिंवाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40016204, "chapter_id": 9244, "verse_number": "3", "content_sanskrit": "तत्त्त्वैतावत्त्वरितंरथंप्रापयसारथे । यत्रैतेबहवोघ्नन्तिसुबहून्राक्षसान्रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40016205, "chapter_id": 9244, "verse_number": "4", "content_sanskrit": "एतेऽत्रबलवन्तोहिभीमकोपाश्चवानराः । द्रुमशैलप्रहरणास्तिष्ठन्तिप्रमुखेमम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40016206, "chapter_id": 9244, "verse_number": "5", "content_sanskrit": "एतान्निहन्तुमिच्छामिसमरश्लाघिनोह्यहम् । एतैःप्रमथितंसर्वंदृश्यतेराक्षसांबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40016207, "chapter_id": 9244, "verse_number": "6", "content_sanskrit": "ततःप्रजवनाश्वेनरथेनरथिनांवरः । हरीनभ्यहनत्क्रोधाच्छरजालैकम्पनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40016208, "chapter_id": 9244, "verse_number": "7", "content_sanskrit": "नस्थातुंवानराश्शेकुःकिंपुनर्योद्धुमाहवे । अकम्पनशरैर्भग्नास्सर्वएवविदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40016209, "chapter_id": 9244, "verse_number": "8", "content_sanskrit": "तान्मृत्युवशमापन्नानकम्पनवंशगतान् । समीक्ष्यहनुमान्ज्ञातीनुपतस्थेमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40016210, "chapter_id": 9244, "verse_number": "9", "content_sanskrit": "तंमहाप्लवगंदृष्टवासर्वेतेप्लवगयूथपा: । समेत्यसमरेवीरास्सहिताःपर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40016211, "chapter_id": 9244, "verse_number": "10", "content_sanskrit": "अवस्थितंहनूमन्तंतेदृष्टवाहरियूथपा: । बभूवुर्बलवन्तोहिबलवन्तंसमाश्रिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40016212, "chapter_id": 9244, "verse_number": "11", "content_sanskrit": "अकम्पनस्तुशैलाभंहनूमन्तमवस्थितम् । महेन्द्रइवदाराभिश्शरैरभिववर्षह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40016213, "chapter_id": 9244, "verse_number": "12", "content_sanskrit": "अचिन्तयित्वाबाणौघान् शरीरेपतितान्शितान् । अकम्पनवधार्थायमनोदध्रेमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40016214, "chapter_id": 9244, "verse_number": "13", "content_sanskrit": "सप्रहस्यमहातेजाहनुमान् मारुतात्मजः । अभिदुद्रावतद्रक्षःकम्पयन्निवमेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40016215, "chapter_id": 9244, "verse_number": "14", "content_sanskrit": "तस्याभिनर्दमानस्यदीप्यमानस्यतेजसा । बभूवरूपंदुर्धर्षंदीप्तस्येवविभावसोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40016216, "chapter_id": 9244, "verse_number": "15", "content_sanskrit": "आत्मानंमप्रहरणंज्ञात्वाक्रोधसमन्वितः । शैलमुत्पाटयामासवेगेनहरिपुङ्