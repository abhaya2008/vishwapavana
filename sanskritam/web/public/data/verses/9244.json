ya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40016224, "chapter_id": 9244, "verse_number": "23", "content_sanskrit": "गजांश्चसगजारोहान्सरथान्रथिनस्तथा । जघानहनुमान् भीमान् राक्षसांश्चपदातिगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40016225, "chapter_id": 9244, "verse_number": "24", "content_sanskrit": "तमन्तकमिवक्रुद्धंसद्रुमंप्राणहारिणम् । हनूमन्तमभिप्रेक्ष्यराक्षसाविप्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40016226, "chapter_id": 9244, "verse_number": "25", "content_sanskrit": "तमापतन्तंसङ्कृद्धंराक्षसानांभयावहम् । ददर्शाकम्पनोवीरश्चुक्षोधचननादच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40016227, "chapter_id": 9244, "verse_number": "26", "content_sanskrit": "सचतुर्दशभिर्बाणैश्शितैर्देहविदारणैः । निर्बिभेदहनूमन्तंमहावीर्यमकम्पनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40016228, "chapter_id": 9244, "verse_number": "27", "content_sanskrit": "सतदाप्रतिविद्धस्तुबह्वीभिश्शरवृष्टभिः । हनूमान्ददृशेवीरःप्ररूढइवसानुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40016229, "chapter_id": 9244, "verse_number": "28", "content_sanskrit": "विरराजमहाकायोमहावीर्योमहामना: । पुष्पिताशोकसङ्काशोविधूमइवपावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40016230, "chapter_id": 9244, "verse_number": "29", "content_sanskrit": "ततोऽन्यंवृक्षमुत्पाट्यकृत्वावेगमनुत्तमम् । शिरस्यभिजघानाशुराक्षसेन्द्रमकम्पनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40016231, "chapter_id": 9244, "verse_number": "30", "content_sanskrit": "सवृक्षेणहतस्तेनसक्रोधेनमहात्मना । राक्षसोवानरेन्द्रेणपपातचममारच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40016232, "chapter_id": 9244, "verse_number": "31", "content_sanskrit": "तंदृष्टवानिहतंभूमौराक्षसेन्द्रमकम्पनम् । व्यथिताराक्षसास्सर्वेक्षितिकम्पइवद्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40016233, "chapter_id": 9244, "verse_number": "32", "content_sanskrit": "त्यक्तप्रहरणास्सर्वेराक्षसास्तेपराजिताः । लङ्कामभिययुस्त्रस्तावानरास्तैभिद्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40016234, "chapter_id": 9244, "verse_number": "33", "content_sanskrit": "तेमुक्तकेशाःसम्भ्रान्ताभग्नमानाःपराजिताः । स्रवच्छ्रमजलैरङ्गैश्श्वसन्तोविप्रदुद्रुवुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40016235, "chapter_id": 9244, "verse_number": "34", "content_sanskrit": "अन्योन्यंप्रममन्थुस्तेविविशुर्नगरंभयात् । पृष्ठतस्तेतुसम्मूढाःप्रेक्षमाणामुहुर्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40016236, "chapter_id": 9244, "verse_number": "35", "content_sanskrit": "तेषुलङ्कांप्रविष्टेषुराक्षसेषुमहाबलाः । समेत्यहरयस्सर्वेहनूमन्तमपूजयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40016237, "chapter_id": 9244, "verse_number": "36", "content_sanskrit": "सोऽपिप्रहृष्टस्तान् सर्वान् हरीन् सम्प्रत्यपूजयत् । हनुमान्सत्त्वसम्पन्नोयथार्हमनुकूलतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40016238, "chapter_id": 9244, "verse_number": "37", "content_sanskrit": "विनेदुश्चयथाप्राणंहरयोजितकाशिनः । चकर्षुश्चपुनस्तत्रसप्राणानपिराक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40016239, "chapter_id": 9244, "verse_number": "38", "content_sanskrit": "सवीरशोभामभजन्महाकपिःसमेत्यरक्षांसिनिहत्यमारुतिः । महासुरंभीमममित्रनाशनःयथैवविष्णुर्बलिनंचमूमुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40016240, "chapter_id": 9244, "verse_number": "39", "content_sanskrit": "अपूजयन्देवगणास्तदाकपिंस्वयंचरामोऽतिबलश्चलक्ष्मणः । तथैवसुग्रीवमुखाःप्लवङ्गमाविभीषणश्चैवमहाबलस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]