[{"id": 5000244000, "chapter_id": 9244, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे अष्टचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000244001, "chapter_id": 9244, "verse_number": "३-४८-१", "content_sanskrit": "एवं ब्रुवत्यां सीतायां संरब्धः परुषं वचः।\nललाटे भ्रुकुटिं कृत्वा रावणः प्रत्युवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000244002, "chapter_id": 9244, "verse_number": "३-४८-२", "content_sanskrit": "भ्राता वैश्रवणस्याहं सापत्नो वरवर्णिनि।\nरावणो नाम भद्रं ते दशग्रीवः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000244003, "chapter_id": 9244, "verse_number": "३-४८-३", "content_sanskrit": "यस्य देवाः सगन्धर्वाः पिशाचपतगोरगाः।\nविद्रवन्ति सदा भीता मृत्योरिव सदा प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000244004, "chapter_id": 9244, "verse_number": "३-४८-४", "content_sanskrit": "येन वैश्रवणो भ्राता वैमात्राः कारणान्तरे।\nद्वन्द्वमासादितः क्रोधाद् रणे विक्रम्य निर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000244005, "chapter_id": 9244, "verse_number": "३-४८-५", "content_sanskrit": "मद्भयार्तः परित्यज्य स्वमधिष्ठानमृद्धिमत्।\nकैलासं पर्वतश्रेष्ठमध्यास्ते नरवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000244006, "chapter_id": 9244, "verse_number": "३-४८-६", "content_sanskrit": "यस्य तत् पुष्पकं नाम विमानं कामगं शुभम्।\nवीर्यादावर्जितं भद्रे येन यामि विहायसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000244007, "chapter_id": 9244, "verse_number": "३-४८-७", "content_sanskrit": "मम संजातरोषस्य मुखं दृष्ट्वैव मैथिलि।\nविद्रवन्ति परित्रस्ताः सुराः शक्रपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000244008, "chapter_id": 9244, "verse_number": "३-४८-८", "content_sanskrit": "यत्र तिष्ठाम्यहं तत्र मारुतो वाति शङ्कितः।\nतीव्रांशुः शिशिरांशुश्च भयात् सम्पद्यते दिवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000244009, "chapter_id": 9244, "verse_number": "३-४८-९", "content_sanskrit": "निष्कम्पपत्रास्तरवो नद्यश्च स्तिमितोदकाः।\nभवन्ति यत्र तत्राहं तिष्ठामि च चरामि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000244010, "chapter_id": 9244, "verse_number": "३-४८-१०", "content_sanskrit": "मम पारे समुद्रस्य लङ्का नाम पुरी शुभा।\nसम्पूर्णा राक्षसैर्घोरैर्यथेन्द्रस्यामरावती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000244011, "chapter_id": 9244, "verse_number": "३-४८-११", "content_sanskrit": "प्राकारेण परिक्षिप्ता पाण्डुरेण विराजिता।\nहेमकक्ष्या पुरी रम्या वैदूर्यमयतोरणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000244012, "chapter_id": 9244, "verse_number": "३-४८-१२", "content_sanskrit": "हस्त्यश्वरथसम्बाधा तूर्यनादविनादिता।\nसर्वकामफलैर्वृक्षैः संकुलोद्यानभूषिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000244013, "chapter_id": 9244, "verse_number": "३-४८-१३", "content_sanskrit": "तत्र त्वं वस हे सीते राजपुत्रि मया सह।\nन स्मरिष्यसि नारीणां मानुषीणां मनस्विनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000244014, "chapter_id": 9244, "verse_number": "३-४८-१४", "content_sanskrit": "भुञ्जाना मानुषान् भोगान् दिव्यांश्च वरवर्णिनि।\nन स्मरिष्यसि रामस्य मानुषस्य गतायुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000244015, "chapter_id": 9244, "verse_number": "३-४८-१५", "content_sanskrit": "स्थापयित्वा प्रियं पुत्रं राज्ये दशरथो नृपः।\nमन्दवीर्यस्ततो ज्येष्ठः सुतः प्रस्थापितो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000244016, "chapter_id": 9244, "verse_number": "३-४८-१६", "content_sanskrit": "तेन किं भ्रष्टराज्येन रामेण गतचेतसा।\nकरिष्यसि विशालाक्षि तापसेन तपस्विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000244017, "chapter_id": 9244, "verse_number": "३-४८-१७", "content_sanskrit": "रक्ष राक्षसभर्तारं कामय स्वयमागतम्।\nन मन्मथशराविष्टं प्रत्याख्यातुं त्वमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000244018, "chapter_id": 9244, "verse_number": "३-४८-१८", "content_sanskrit": "प्रत्याख्याय हि मां भीरु पश्चात्तापं गमिष्यसि।\nचरणेनाभिहत्येव पुरूरवसमुर्वशी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000244019, "chapter_id": 9244, "verse_number": "३-४८-१९", "content_sanskrit": "अङ्गुल्या न समो रामो मम युद्धे स मानुषः।\nतव भाग्येन सम्प्राप्तं भजस्व वरवर्णिनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000244020, "chapter_id": 9244, "verse_number": "३-४८-२०", "content_sanskrit": "एवमुक्ता तु वैदेही क्रुद्धा संरक्तलोचना।\nअब्रवीत् परुषं वाक्यं रहिते राक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000244021, "chapter_id": 9244, "verse_number": "३-४८-२१", "content_sanskrit": "कथं वैश्रवणं देवं सर्वदेवनमस्कृतम्।\nभ्रातरं व्यपदिश्य त्वमशुभं कर्तुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000244022, "chapter_id": 9244, "verse_number": "३-४८-२२", "content_sanskrit": "अवश्यं विनशिष्यन्ति सर्वे रावण राक्षसाः।\nयेषां त्वं कर्कशो राजा दुर्बुद्धिरजितेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000244023, "chapter_id": 9244, "verse_number": "३-४८-२३", "content_sanskrit": "अपहृत्य शचीं भार्यां शक्यमिन्द्रस्य जीवितुम्।\nनहि रामस्य भार्यां मामानीय स्वस्तिमान् भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000244024, "chapter_id": 9244, "verse_number": "३-४८-२४", "content_sanskrit": "जीवेच्चिरं वज्रधरस्य पश्चा-\nच्छचीं प्रधृष्याप्रतिरूपरूपाम्।\nन मादृशीं राक्षस धर्षयित्वा\nपीतामृतस्यापि तवास्ति मोक्षः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000244025, "chapter_id": 9244, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे अष्टचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]