[{"id": 7003721000, "chapter_id": 23721, "verse_number": "२-१-५-१", "content_sanskrit": "अथ पद्मावतीदर्शनेन श्रीनिवासस्य मोहप्राप्तिः॥  ।\nश्रीवराह उवाच ।\nसम्प्राप्य चालयं दिव्यमवतीर्य हयोत्तमात् ।\nविसृज्य सानुगान्सर्वान्देवान्कैरातरूपकान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003721001, "chapter_id": 23721, "verse_number": "२-१-५-२", "content_sanskrit": "विश्रमध्वमिति प्रोच्य विवेश मणिमण्डपम् ।\nआरुह्य मणिसोपानं पंचकक्षा अतीत्य च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003721002, "chapter_id": 23721, "verse_number": "२-१-५-३", "content_sanskrit": "मुक्तागृहं समासाद्य तस्मिंल्लोलायिते शुभे ।\nनवरत्नमये मंचे संविवेशावशो हरिः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003721003, "chapter_id": 23721, "verse_number": "२-१-५-४", "content_sanskrit": "संस्मरन्पद्मगर्भाभां तामेवायतलोचनाम् ।\nतनुमध्यां पीनकुचां मन्दस्मितसुखांबुजाम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003721004, "chapter_id": 23721, "verse_number": "२-१-५-५", "content_sanskrit": "क्षीराब्धितनयामेव मेने पद्मोद्भवां शुभाम् ।\nतस्यां गतमना देवः श्रीनिवासो मुमोह च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003721005, "chapter_id": 23721, "verse_number": "२-१-५-६", "content_sanskrit": "अथ मुह्यमानं श्रीनिवासं प्रति बकुलमालिकोक्तिः ।\nततो मध्याह्नसमये कृत्वान्नं दिव्यमुत्तमम् ।\nसूपदंशं सुगन्धं च देवार्हमतिशोभनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003721006, "chapter_id": 23721, "verse_number": "२-१-५-७", "content_sanskrit": "शुद्धान्नं पायसान्नं च गौडं मुद्गान्नमेव च ।\nकृत्वा पञ्चविधापूपान्पूरिकावटकानपि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003721007, "chapter_id": 23721, "verse_number": "२-१-५-८", "content_sanskrit": "देवं द्रष्टुं ययौ शीघ्रं सखी वकुलमालिका ।\nपद्मावतीपद्मपत्रा चित्ररेखासमन्विता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003721008, "chapter_id": 23721, "verse_number": "२-१-५-९", "content_sanskrit": "निवेश्य द्वारि देवस्य ताः सर्वाः प्रमदोत्तमाः ।\nविवेश तत्समीपं सा स्वयं बकुलमालिका ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003721009, "chapter_id": 23721, "verse_number": "२-१-५-१०", "content_sanskrit": "गत्वा समीपं देवस्य ववन्दे भक्तिभावतः ।\nदृष्ट्वाथ देवं विवशं पर्यंके रत्नभूषिते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003721010, "chapter_id": 23721, "verse_number": "२-१-५-११", "content_sanskrit": "पादसंवाहनं कृत्वा निमीलितविलोचनम् ।\nतं ध्यायन्तं च किमपि व्याजहार शुचिस्मिता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003721011, "chapter_id": 23721, "verse_number": "२-१-५-१२", "content_sanskrit": "उत्तिष्ठ देवदेवेश किं शेषे पुरुषोत्तम ।\nपरमान्नं कृतं देव भोक्तुमागच्छ माधव ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003721012, "chapter_id": 23721, "verse_number": "२-१-५-१३", "content_sanskrit": "किं वा त्वमार्तवच्छेषे सर्वलोकार्तिनाशन ।\nमृगयामटता देव कि दृष्टं भवता वने ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003721013, "chapter_id": 23721, "verse_number": "२-१-५-१४", "content_sanskrit": "अवस्था ते विशालाक्ष कामुकस्येव दृश्यते ।\nका दृष्टा देवकन्या वा मानुषी वाऽहिकन्यका ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003721014, "chapter_id": 23721, "verse_number": "२-१-५-१५", "content_sanskrit": "ब्रूहि मे त्वमचिन्त्यात्मन्कन्यां तां चित्तहारिणीम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003721015, "chapter_id": 23721, "verse_number": "२-१-५-१६", "content_sanskrit": "श्रीवराह उवाच ।\nतस्यास्तद्वचनं श्रुत्वा निःश्वासमकरोद्विभुः ।\nनिःश्वसंतं पुनः प्राह प्रीता बकुलमालिका ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003721016, "chapter_id": 23721, "verse_number": "२-१-५-१७", "content_sanskrit": "एवं मनोहरा का सा तवापि पुरुषोत्तम ।\nतामवोचद्धृषीकेशो वक्ष्यामि शृणु तत्त्वतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003721017, "chapter_id": 23721, "verse_number": "२-१-५-१८", "content_sanskrit": "अथ श्रीनिवासोक्तपद्मावतीपरिणयकारणानि ।\nश्रीभगवानुवाच ।\nपुरा त्रेतायुगे पुण्ये रावणं हतवानहम् ।\nतदा वेदवती कन्या साहाय्यमकरोच्छ्रियः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003721018, "chapter_id": 23721, "verse_number": "२-१-५-१९", "content_sanskrit": "सीतारूपाभवल्लक्ष्मीर्जनकस्य महीतलात् ।\nगते मयि तु मारीचं हन्तुं पञ्चवटीवने ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003721019, "chapter_id": 23721, "verse_number": "२-१-५-२०", "content_sanskrit": "ममानुजोऽपि मामेव सीतया चोदितोन्वयात् ।\nतदन्तरे राक्षसेन्द्रो हर्तुं सीतामुपाययौ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003721020, "chapter_id": 23721, "verse_number": "२-१-५-२१", "content_sanskrit": "अग्निहोत्रगतो वह्निस्तं ज्ञात्वा रावणोद्यमम् ।\nआदाय सीतां पाताले स्वाहायां सन्निवेश्य च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003721021, "chapter_id": 23721, "verse_number": "२-१-५-२२", "content_sanskrit": "तेनैव रक्षसा स्पृष्टां पुरा वेदवतीं शुभाम् ।\nअग्नौ विसृष्टदेहां तां संहर्तुं रावणं पुनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003721022, "chapter_id": 23721, "verse_number": "२-१-५-२३", "content_sanskrit": "सीताया रूपसदृशीं कृत्वा चैवोत्ससर्ज ह ।\nसा रावणहृता भूत्वा लंकायां च निवेशिता ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003721023, "chapter_id": 23721, "verse_number": "२-१-५-२४", "content_sanskrit": "हते तु रावणे पश्चात्पुनरग्निं विवेश सा ।\nअग्निस्तु रक्षितां लक्ष्मीं स्वाहायां मम जानकीम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003721024, "chapter_id": 23721, "verse_number": "२-१-५-२५", "content_sanskrit": "दत्त्वा हस्ते च मामाह सीतया सहितां सखीम ।\nइयं वेदवती देव सीतायाः प्रियकारिणी ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003721025, "chapter_id": 23721, "verse_number": "२-१-५-२६", "content_sanskrit": "सीतार्थं राक्षसपुरे तेन बन्दीकृता स्थिता ।\nतस्मादेनां वरेणैव प्रीणय त्वं श्रिया सह ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003721026, "chapter_id": 23721, "verse_number": "२-१-५-२७", "content_sanskrit": "इति वह्निवचः श्रुत्वा सीता मामवदच्छुभा ।\nमम प्रीतिकरी नित्यमियं वेदवती विभो ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003721027, "chapter_id": 23721, "verse_number": "२-१-५-२८", "content_sanskrit": "तस्मात्परं भागवतीं देवैनां वरय प्रभो ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003721028, "chapter_id": 23721, "verse_number": "२-१-५-२९", "content_sanskrit": "श्रीभगवानुवाच ।\nतथा देवि करिष्यामि ह्यष्टाविंशे कलौ युगे ।\nतावदेषा ब्रह्मलोके वसत्वमरपूजिता ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003721029, "chapter_id": 23721, "verse_number": "२-१-५-३०", "content_sanskrit": "पश्चात्तु भूमितनया भविष्यति वियत्सुता ।\nइति दत्तवरा पूर्वं मया लक्ष्म्या च सुन्दरी ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003721030, "chapter_id": 23721, "verse_number": "२-१-५-३१", "content_sanskrit": "अद्य नारायणपुरे सम्भूता धरणीतलात् ।\nपद्मासमा पद्मनेत्री पद्मादत्तवरा सती ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003721031, "chapter_id": 23721, "verse_number": "२-१-५-३२", "content_sanskrit": "सखीभिरनुरूपाभिर्वने पुष्पाणि चिन्वती ।\nमृगयामटता तत्र मया दृष्टा मनोरमा ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003721032, "chapter_id": 23721, "verse_number": "२-१-५-३३", "content_sanskrit": "तस्या रूपं मया वक्तुं न शक्यं शतहायनैः ।\nलक्ष्म्येव च तया मेऽद्य संगमो भविता यदि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003721033, "chapter_id": 23721, "verse_number": "२-१-५-३४", "content_sanskrit": "प्राणाः स्थिरा भविष्यन्ति सत्यमित्यवधारय ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003721034, "chapter_id": 23721, "verse_number": "२-१-५-३५", "content_sanskrit": "अथ वियद्राजपुरं प्रति बकुलमालिकागमनम् ।\nत्वं तत्र गत्वा तां कन्यां दृष्ट्वा बकुलमालिके ।\nजानीहि रूपलावण्यादियं योग्येति चास्य वै ।\nअनवद्या विशालाक्षी पद्मेन्दीवरलोचना ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003721035, "chapter_id": 23721, "verse_number": "२-१-५-३६", "content_sanskrit": "इत्युक्त्वा मोहमापन्नं तं प्राह बकुला पुनः ।\nइतो गच्छामि देवेश मनोज्ञा तव यत्र सा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003721036, "chapter_id": 23721, "verse_number": "२-१-५-३७", "content_sanskrit": "मार्गं वद रमाधीश गमिष्ये येन तां प्रति ।\nएवमुक्तो रमाधीशस्तां प्राह वकुलस्रजम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003721037, "chapter_id": 23721, "verse_number": "२-१-५-३८", "content_sanskrit": "इतो गच्छ महाभागे श्रीनृसिंहगुहा यतः ।\nतन्मार्गेणावतीर्यास्माद्भूधरेन्द्रान्मनोरमात् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003721038, "chapter_id": 23721, "verse_number": "२-१-५-३९", "content_sanskrit": "अगस्त्याश्रममासाद्य दृष्ट्वा लिंगं तदर्चितम् ।\nअगस्त्येश इति ख्यातं सुवर्णमुखरीतटे ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003721039, "chapter_id": 23721, "verse_number": "२-१-५-४०", "content_sanskrit": "तीरेणैव ततो गच्छ शुकब्रह्मऋषेर्वनम् ।\nपश्यन्ती स्वर्णमुखरीं तत्र कल्लोलमालिनीम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003721040, "chapter_id": 23721, "verse_number": "२-१-५-४१", "content_sanskrit": "तत्र पद्मसरोनाम पावनं पद्मसंयुतम् ।\nतत्र स्नात्वाऽथ तत्तीरे तपन्तं मुनिसत्तमम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003721041, "chapter_id": 23721, "verse_number": "२-१-५-४२", "content_sanskrit": "छायाशुकं नमस्कृत्य कृष्णं च बलसंयुतम् ।\nआराध्यमानं मुनिना शुकेन सततं शुभे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003721042, "chapter_id": 23721, "verse_number": "२-१-५-४३", "content_sanskrit": "इन्द्रनीलमणिश्यामं पीतनिर्मलवाससम् ।\nतीर्थयात्रां गमिष्यन्तं बलभद्रं सिताकृतिम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003721043, "chapter_id": 23721, "verse_number": "२-१-५-४४", "content_sanskrit": "उपासयन्तं मंत्राणि मुक्तान्वितकरद्वयम् ।\nउद्यन्तं पादुकायुक्तं बलभद्रं प्रणम्य च ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003721044, "chapter_id": 23721, "verse_number": "२-१-५-४५", "content_sanskrit": "आदाय स्वर्णकमलं सरसोऽस्माद्वरानने ।\nतीर्त्वा सुवर्णमुखरीं वनान्युपवनानि च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003721045, "chapter_id": 23721, "verse_number": "२-१-५-४६", "content_sanskrit": "अरणीतीरमासाद्य विश्रम्य च वनान्तरे ।\nनारायणपुरीं दृष्ट्वा विस्मयं च गमिष्यसि ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003721046, "chapter_id": 23721, "verse_number": "२-१-५-४७", "content_sanskrit": "तस्याश्चोपवने वृक्षान्पुष्पाढ्यान्फलसंयुतान् ।\nपनसाम्रशिरीषांश्च कुन्दतिन्दुकपाटलान् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003721047, "chapter_id": 23721, "verse_number": "२-१-५-४८", "content_sanskrit": "पुन्नागनागवरणरसालांकोलचंपकान् ।\nबकुलामलकान्सालांस्तालहिंतालपद्मकान् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003721048, "chapter_id": 23721, "verse_number": "२-१-५-४९", "content_sanskrit": "जम्बूनिम्बकदम्बैलापिप्पलीमधुकार्जुनान् ।\nप्रियंगुहिंगुखर्जूरमायूराशोकलोध्रकान् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003721049, "chapter_id": 23721, "verse_number": "२-१-५-५०", "content_sanskrit": "अश्वत्थोदुम्बरप्लक्षबदरीभूर्जकीचकान् ।\nचिञ्चाकिंशुकमन्दारशाल्मलीबीजपूरकान् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003721050, "chapter_id": 23721, "verse_number": "२-१-५-५१", "content_sanskrit": "पूगनारंगलिकुचनारिकेलवनाकुलान् ।\nमल्लिकामालतीकुन्द यूथिकाकेतकीयुतान् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003721051, "chapter_id": 23721, "verse_number": "२-१-५-५२", "content_sanskrit": "करवीराब्जसंपन्नान्राजरंभाविराजितान् ।\nमयूरकीरगरुडशुकसारससंकुलान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003721052, "chapter_id": 23721, "verse_number": "२-१-५-५३", "content_sanskrit": "भृंगझंकारनिबिडानारामान्सुमनोहरान् ।\nपश्यन्तीं परमं हर्षमवाप्य च नदीतटे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003721053, "chapter_id": 23721, "verse_number": "२-१-५-५४", "content_sanskrit": "गत्वा पूर्वोत्तरे मार्गे पुरीमिन्द्रपुरीसमाम् ।\nगङ्गयेवावृतां नित्यं सरितारणिनामया ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003721054, "chapter_id": 23721, "verse_number": "२-१-५-५५", "content_sanskrit": "आकाशराजनगरीं गत्वा तत्रोचितं कुरु ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003721055, "chapter_id": 23721, "verse_number": "२-१-५-५६", "content_sanskrit": "श्रीवराह उवाच ।\nइत्यादिश्य सुराधीशः सखीं तां बकुलाभिधाम् ।\nविसृज्य शयने शुभ्रे स शिश्ये श्रीसमन्वितः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003721056, "chapter_id": 23721, "verse_number": "२-१-५-५७", "content_sanskrit": "प्रणम्य देवदेवेशं सखी बकुलमालिका ।\nगुञ्जामणिसमाकारं रक्ताश्वमधिरुह्य सा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003721057, "chapter_id": 23721, "verse_number": "२-१-५-५८", "content_sanskrit": "यथोक्तमार्गेण ययौ पश्यन्ती विविधान्मृगान् ।\nमत्तेभान्पर्वताकाराञ्छ्वेतदन्तविभूषितान् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003721058, "chapter_id": 23721, "verse_number": "२-१-५-५९", "content_sanskrit": "करिणीयूथसहिताञ्जलदादानतत्परान् ।\nसिंहाञ्छ्वे तघनप्रख्यान्सिंहीयूथैरनुद्रुतान् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003721059, "chapter_id": 23721, "verse_number": "२-१-५-६०", "content_sanskrit": "शार्दूलर्क्षांश्च खड्गांश्च शरभान्गवयान्मृगान् ।\nकृष्णसारांश्च गोमायूञ्छशांश्च प्रियकानपि ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003721060, "chapter_id": 23721, "verse_number": "२-१-५-६१", "content_sanskrit": "सारसांश्च मयूरांश्च मार्जारान्वनगोचरान् ।\nवृकाञ्छुकान्सूकरांश्च सुवाचः पक्षिणस्तथा ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003721061, "chapter_id": 23721, "verse_number": "२-१-५-६२", "content_sanskrit": "पश्यन्ती विविधाकारांस्तुष्यन्ती च मुहुर्मुहुः ।\nआससादारणीतीरं पश्चिमं पादपाकुलम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003721062, "chapter_id": 23721, "verse_number": "२-१-५-६३", "content_sanskrit": "अवतीर्यारुणादश्वादगस्त्येशसमीपतः ।\nदृष्ट्वागस्त्येश्वरं लिङ्गमगस्त्येन सुपूजितम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003721063, "chapter_id": 23721, "verse_number": "२-१-५-६४", "content_sanskrit": "तत्र स्नात्वा च पीत्वा च विशश्राम नदीतटे ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003721064, "chapter_id": 23721, "verse_number": "२-१-५-६५", "content_sanskrit": "अथ दिव्योद्यानस्थपद्मावतीसखीः प्रति बकुलमालिकोक्तिः ।\nतत्रागता राजगृहाद्योषितो देवसंनिधौ ।\nसखीः पद्मालयायास्ता दृष्ट्वा बकुलमालिका ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003721065, "chapter_id": 23721, "verse_number": "२-१-५-६६", "content_sanskrit": "गत्वा समीपे तासां सा किंवदन्तीं स्म पृच्छति ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003721066, "chapter_id": 23721, "verse_number": "२-१-५-६७", "content_sanskrit": "बकुलमालिकोवाच ।\nका यूयं योषितो ब्रूत विचित्राभरणस्रजः ।\nकुतः समागता ह्यत्र किं कार्यं वोऽमलाननाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003721067, "chapter_id": 23721, "verse_number": "२-१-५-६८", "content_sanskrit": "तास्तु तस्या वचः श्रुत्वा स्मितपूर्वमथाब्रुवन् ।\nशृणुष्वावहिता देवि वयं वक्ष्यामहेऽधुना ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003721068, "chapter_id": 23721, "verse_number": "२-१-५-६९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे श्रीवेंकटाचलमाहात्म्ये धरणीवराहसंवादे पद्मावतीदर्शनेन श्रीनिवासस्यमोहप्राप्त्यादिवर्णनंनाम पञ्चमोऽध्यायः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]