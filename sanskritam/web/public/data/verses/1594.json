[{"id": 2027661, "chapter_id": 1594, "verse_number": "३-२३२-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027662, "chapter_id": 1594, "verse_number": "३-२३२-१", "content_sanskrit": "यदाऽभिषिक्तो भगवान्सैनापत्ये तु पावकिः।\nतदा संप्रस्थितः श्रीमान्हृष्टो भद्रवटं हरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027663, "chapter_id": 1594, "verse_number": "३-२३२-२", "content_sanskrit": "रथेनादित्यवर्णेन पार्वत्या सहितः प्रभुः।\n`अनुयातः सुरैः सर्वैः सहस्राक्षपुरोगमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027664, "chapter_id": 1594, "verse_number": "३-२३२-३", "content_sanskrit": "सहस्रं तस्य सिंहानां तस्मिन्युक्तं रथोत्तमे।\nउत्पपात दिवं शुभ्रं कालेनाभिप्रचोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027665, "chapter_id": 1594, "verse_number": "३-२३२-४", "content_sanskrit": "तेपिबन्त इवाकाशं त्रासयन्तक्षराचरान्।\nसिंहा नभस्यगच्छन्त नदन्तश्चारुकेसराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027666, "chapter_id": 1594, "verse_number": "३-२३२-५", "content_sanskrit": "तस्मिन्रथे पशुपतिः स्थितो भात्युमया सह।\nविद्युता सहितः सूर्यः सेन्द्रचापे घने यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027667, "chapter_id": 1594, "verse_number": "३-२३२-६", "content_sanskrit": "अग्रतस्तस्य भगवान्धनेशो गुह्यकैः सह।\nआस्थाय रुचिरं याति पुष्पकं नरवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027668, "chapter_id": 1594, "verse_number": "३-२३२-७", "content_sanskrit": "ऐरावतं समास्थाय शक्रश्चापि सुरैः सह।\nपृष्ठतोऽनुययौ यान्तं वरदं वृषभध्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027669, "chapter_id": 1594, "verse_number": "३-२३२-८", "content_sanskrit": "जृम्भकैर्यक्षरक्षोभिः स्रग्विभिः समलंकृतः।\nयात्यमोघो महायक्षो दक्षिणं पक्षमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027670, "chapter_id": 1594, "verse_number": "३-२३२-९", "content_sanskrit": "तस्य दक्षिणतो देवा बहवश्चित्रयोधिनः।\nगच्छन्ति वसुभिः सार्धं रुद्रैश्च सह संगताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027671, "chapter_id": 1594, "verse_number": "३-२३२-१०", "content_sanskrit": "यमश्च मृत्युना सार्धं सर्वतः परिवारितः।\nघोरैर्व्याधिशतैर्याति घोररूपवपुस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027672, "chapter_id": 1594, "verse_number": "३-२३२-११", "content_sanskrit": "यमस्य पृष्ठतश्चैव रघोरस्त्रिशिखरः शितः।\nविजयो नाम रुद्रस्य याति शूलः स्वलंकृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027673, "chapter_id": 1594, "verse_number": "३-२३२-१२", "content_sanskrit": "तमुग्रपाशो वरुणो भगवान्सलिलेश्वरः।\nपरिवार्य शनैर्याति यादोभिर्विविधैर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027674, "chapter_id": 1594, "verse_number": "३-२३२-१३", "content_sanskrit": "पृष्ठतोविजयस्यापि याति रुद्रस्य पट्टसः।\nगदामुसलशक्त्याद्यैर्वृतः प्रहरणोत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027675, "chapter_id": 1594, "verse_number": "३-२३२-१४", "content_sanskrit": "पट्टसं त्वन्वगाद्राजंश्छत्रं रौद्रं महाप्रभम्।\nकमण्डलुश्चाप्यनु तं महर्षिगणसेवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027676, "chapter_id": 1594, "verse_number": "३-२३२-१५", "content_sanskrit": "तस्य दक्षिणतो भाति दण्डो गच्छञ्श्रिया वृतः।\nभृग्वङ्गिरोभिः सहितो दैधतैश्चानुपूजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027677, "chapter_id": 1594, "verse_number": "३-२३२-१६", "content_sanskrit": "एषां तु पृष्ठतो रुद्रो विमले स्यन्दने स्थितः।\nयाति संहर्षयन्सर्वांस्तेजसा त्रिदिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027678, "chapter_id": 1594, "verse_number": "३-२३२-१७", "content_sanskrit": "ऋषयश्चापि देवाश्च गन्धर्वा भुजगास्तथा।\nनद्यो ह्रदाःसमुद्राश्चतथैवाप्सरसां गणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027679, "chapter_id": 1594, "verse_number": "३-२३२-१८", "content_sanskrit": "नक्षत्राणि ग्रहाश्चैवदेवानां शिशवश्च ये।\nस्त्रियश्च विविधाकारा यान्ति रुद्रस्य पृष्ठतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027680, "chapter_id": 1594, "verse_number": "३-२३२-१९", "content_sanskrit": "सृजन्त्यः पुष्पवर्षाणि चारुरूपा वराङ्गनाः।\nपर्जन्यश्चाप्यनुययौ नमस्कृत्य पिनाकिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027681, "chapter_id": 1594, "verse_number": "३-२३२-२०", "content_sanskrit": "छत्रं च पाण्डुरं सोमस्तस्य मूर्धन्यधारयत्।\nचामरे चापि वायुश्च गृहीत्वाऽग्निश्च धिष्ठितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027682, "chapter_id": 1594, "verse_number": "३-२३२-२१", "content_sanskrit": "शक्रश्च पृष्ठतस्तस्य याति राजञ्छ्रिया वृतः।\nसहराजर्षिभिः सर्वैः स्तुवानो वृषकेतनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027683, "chapter_id": 1594, "verse_number": "३-२३२-२२", "content_sanskrit": "गौरी विद्याऽथ गान्धारी केशिनी मित्रसाह्वया।\nसावित्र्या सह सर्वास्ताः पार्वत्या यान्ति पृष्ठतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027684, "chapter_id": 1594, "verse_number": "३-२३२-२३", "content_sanskrit": "तत्र विद्यागणाः सर्वेये केचित्कविभिः स्मृताः।\nतस्य कुर्वन्ति वचनं सेन्द्रा देवाश्चमूमुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027685, "chapter_id": 1594, "verse_number": "३-२३२-२४", "content_sanskrit": "गृहीत्वा तु पताकां वै यात्यग्रे राक्षसो ग्रहः।\nव्यापृतस्तु श्मशाने यो नित्यं रुद्रस् वै सखा।\nपिङ्गलो नाम यक्षेन्द्रो लोकस्यानन्ददायकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027686, "chapter_id": 1594, "verse_number": "३-२३२-२५", "content_sanskrit": "एबिश्च सहितो देवस्तत्रयाति यथासुखम्।\nअग्रतः पृष्ठतस्चैवं न हि तस्य गतिर्ध्रुवा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027687, "chapter_id": 1594, "verse_number": "३-२३२-२६", "content_sanskrit": "रुद्रं सत्कर्मभिर्मर्त्याः पूजयन्तीह दैवतम्।\nशिवमित्येव यं प्राहुरीशं रुद्रं पिनाकिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027688, "chapter_id": 1594, "verse_number": "३-२३२-२७", "content_sanskrit": "`एवं सर्वे सुरगणास्तदा वै प्रीतमानसाः।\nभावैस्तु विविधाकारैः पूजयन्ति महेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2027689, "chapter_id": 1594, "verse_number": "३-२३२-२८", "content_sanskrit": "कदेवसेनापतिस्त्वं देवसेनाभिरावृतः।\nअनुदच्छति देवेशं ब्रह्मण्यः कृत्तिकासुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2027690, "chapter_id": 1594, "verse_number": "३-२३२-२९", "content_sanskrit": "अथाब्रवीन्महासेनं महादेवो बृहद्वचः।\nसप्तमं मारुतस्कन्धं रक्ष नित्यमतन्द्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2027691, "chapter_id": 1594, "verse_number": "३-२३२-३०x", "content_sanskrit": "स्कन्द उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2027692, "chapter_id": 1594, "verse_number": "३-२३२-३०", "content_sanskrit": "सप्तमं मारुतस्कन्धं पालयिष्याम्यहं प्रभो।\nयदन्यदपि मे कार्यं देव तद्वद माचिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2027693, "chapter_id": 1594, "verse_number": "३-२३२-३१x", "content_sanskrit": "रुद्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2027694, "chapter_id": 1594, "verse_number": "३-२३२-३१", "content_sanskrit": "कार्येष्वहं त्वया पुत्र संद्रष्टव्यः सदैव हि।\nदर्शनान्मम भक्त्या च श्रेयः परमवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2027695, "chapter_id": 1594, "verse_number": "३-२३२-२५x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2027696, "chapter_id": 1594, "verse_number": "३-२३२-३२", "content_sanskrit": "इत्युक्त्वा विससर्जैनं परिष्यज्य महेश्वरः।\n`स्कन्दं सहोमया प्रीतो ज्वलन्तमिव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2027697, "chapter_id": 1594, "verse_number": "३-२३२-३३", "content_sanskrit": "विसर्जिते ततः स्कन्दे बभूवौत्पातिकं महत्।\nसहसैव महाराजदेवान्सर्वान्प्रमोहयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2027698, "chapter_id": 1594, "verse_number": "३-२३२-३४", "content_sanskrit": "जज्वाल स्वं सनक्षत्रं प्रमूढं भुवनं भृशम्।\nचचाल व्यनदच्चोर्वी तमोभूतं जगत्प्रभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2027699, "chapter_id": 1594, "verse_number": "३-२३२-३५", "content_sanskrit": "ततस्तद्दारुणं दृष्ट्वा क्षुभितः शंकरस्तदा।\nउमा चैवमहाभाग देवाश्च समहर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2027700, "chapter_id": 1594, "verse_number": "३-२३२-३६", "content_sanskrit": "ततस्तेषु प्रमूढेषु पर्वताम्बुदसन्निभम्।\nनानाप्रहरणं घोरमदृश्यत महद्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2027701, "chapter_id": 1594, "verse_number": "३-२३२-३७", "content_sanskrit": "तद्वै घोरमसङ्ख्येयं गर्जच्च विविधा गिरः।\nअभ्यद्रवद्रणए देवान्भगवन्तं च शंकरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2027702, "chapter_id": 1594, "verse_number": "३-२३२-३८", "content_sanskrit": "तैर्विसृष्टान्यनीकेषु बाणजालान्यनेकशः।\nपर्वताश्च शतघ्न्यश्च प्रासासिपरिघा गदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2027703, "chapter_id": 1594, "verse_number": "३-२३२-३९", "content_sanskrit": "निपतद्भिश्च तैर्घोरैर्देवानीकं महायुधैः।\nक्षणेन व्यद्रवत्सर्वं विमुखं चाप्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2027704, "chapter_id": 1594, "verse_number": "३-२३२-४०", "content_sanskrit": "निकृत्तयोधनागाश्वं कृत्तायुधमहारथम्।\nदानवैरर्दितं सैन्यं देवानां विमुखं बभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2027705, "chapter_id": 1594, "verse_number": "३-२३२-४१", "content_sanskrit": "असुरैर्वध्यमानं तत्पावकैरिव काननम्।\nअपतद्दग्धभूयिष्ठं महाद्रुमवनं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2027706, "chapter_id": 1594, "verse_number": "३-२३२-४२", "content_sanskrit": "ते विभिन्नशिरोदेहाः प्राद्रवन्तो दिवौकसः।\nन नाथमधिगच्छन्ति वध्यमाना महारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2027707, "chapter_id": 1594, "verse_number": "३-२३२-४३", "content_sanskrit": "अथ तद्विद्रुतं सैन्यं दृष्ट्वा देवः पुरंदरः।\nआश्वासयन्नुवाचेदं बलभिद्दानवार्दितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2027708, "chapter_id": 1594, "verse_number": "३-२३२-४४", "content_sanskrit": "भयं त्यजत भद्रं व शूराः शस्त्राणि गृह्णत।\nकुरुध्वंविक्रमे बुद्धिं मा वः काचिद्व्यथा भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2027709, "chapter_id": 1594, "verse_number": "३-२३२-४५", "content_sanskrit": "जयतैनाम्सुदुर्वृत्तान्दानवान्घोरदर्शनान्।\nअभिद्रवत भद्रं वो मया सह महासुरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2027710, "chapter_id": 1594, "verse_number": "३-२३२-४६", "content_sanskrit": "शक्रस् वचनं श्रुत्वा समाश्वस्ता दिवौकसः।\nदानवान्प्रत्ययुध्यन्त शक्रं कृत्वा व्यपाश्रयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2027711, "chapter_id": 1594, "verse_number": "३-२३२-४७", "content_sanskrit": "ततस्ते त्रिदशाः सर्वेमरुतश्च महाबलाः।\nप्रत्युद्ययुर्महाभागाः साध्याश्च वसुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2027712, "chapter_id": 1594, "verse_number": "३-२३२-४८", "content_sanskrit": "तैर्विसृष्टान्यनीकेषु क्रुद्धैः शस्त्राणि संयुगे।\nशराश्च दैत्यकायेषु पिबन्ति रुधिरं बहु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2027713, "chapter_id": 1594, "verse_number": "३-२३२-४९", "content_sanskrit": "तेषां देहान्विनिर्भिद्य शरास्ते निशितास्तदा।\nनिपतन्तोऽभ्यदृश्यन्त नगेभ्य इव पन्नगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2027714, "chapter_id": 1594, "verse_number": "३-२३२-५०", "content_sanskrit": "तानि दैत्यशरीराणि निर्भिन्नानिस्म सायकैः।\nअपतन्भूतलेराजंश्छिन्नाभ्राणीव सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2027715, "chapter_id": 1594, "verse_number": "३-२३२-५१", "content_sanskrit": "ततस्तद्दानवं सैन्यं सर्वैर्देवगणैर्युधि।\nत्रासितं विविधैर्बाणैः कृतंचैव पराङ्युखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2027716, "chapter_id": 1594, "verse_number": "३-२३२-५२", "content_sanskrit": "अथोत्क्रुष्टं तदा हृष्टैः सर्वैर्देवैरुदायुधैः।\nसंहतानि च तूर्याणि प्रावाद्यन्त ह्यनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2027717, "chapter_id": 1594, "verse_number": "३-२३२-५३", "content_sanskrit": "एवमन्योन्रसंयुक्तं युद्धमासीत्सुदारुणम्।\nदेवानां दानवानां च मांसशोणितकर्दमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2027718, "chapter_id": 1594, "verse_number": "३-२३२-५४", "content_sanskrit": "अनयो देवलोकस्य सहसैवाभ्यदृश्यत।\nतथहि दानवा घोरा विनिघ्नन्ति दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2027719, "chapter_id": 1594, "verse_number": "३-२३२-५५", "content_sanskrit": "ततस्तूर्यप्रणादाश्च भेरीणां च महास्वनाः।\nबभूवुर्दानवेन्द्राणां सिंहनादाश्च दारुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2027720, "chapter_id": 1594, "verse_number": "३-२३२-५६", "content_sanskrit": "अथ दैत्यबलाद्घोरान्निष्पपात महाबलः।\nदानवो महिषो नाम प्रगृह्य विपुलं गिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2027721, "chapter_id": 1594, "verse_number": "३-२३२-५७", "content_sanskrit": "ते तं धनैरिवादित्यं दृष्ट्वासंपरिवारितम्।\nतमुद्यतगिरिं राजन्व्यद्रवन्त दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2027722, "chapter_id": 1594, "verse_number": "३-२३२-५८", "content_sanskrit": "अथाभिद्रुत्य महिषो देवांश्चिक्षेप तं गिरिम्।\n`महाकायं महाराज सतोयमिव तोयदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2027723, "chapter_id": 1594, "verse_number": "३-२३२-५९", "content_sanskrit": "पतता तेन गिरिणा देवसैन्यस् पार्थिव।\nभीमरूपेण निहतमयुतं प्रापतद्भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2027724, "chapter_id": 1594, "verse_number": "३-२३२-६०", "content_sanskrit": "अथ तैर्दानवैः सार्धं महिषस्त्रासयन्सुरान्।\nअभ्यद्रवद्रणे तूर्णं सिंहः क्षुद्रमृगानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2027725, "chapter_id": 1594, "verse_number": "३-२३२-६१", "content_sanskrit": "तमापतन्तं महिषं दृष्ट्वा सेन्द्रा दिवौकसः।\nव्यद्रवन्तरणे बीता विकीर्णायुधकेतनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2027726, "chapter_id": 1594, "verse_number": "३-२३२-६२", "content_sanskrit": "ततःस महिषः क्रुद्धस्तूर्णं रुद्ररथं ययौ।\nअभिद्रुत्य च जग्राह रुद्रस् रथकूवरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2027727, "chapter_id": 1594, "verse_number": "३-२३२-६३", "content_sanskrit": "यदा रुद्ररथं क्रुद्धो महिषः सहसा गतः।\nरेसतू रोदसी गाढं मुमुहुश् महर्षयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2027728, "chapter_id": 1594, "verse_number": "३-२३२-६४", "content_sanskrit": "अनदंश्चमहाकाया दैत्या जलधरोपमाः।\nआसीच्चनिश्चितं तेषां जितमस्माभिरित्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2027729, "chapter_id": 1594, "verse_number": "३-२३२-६५", "content_sanskrit": "तथाभूते तु भगवानाहूय गुहमात्मजम्।\n`दौरात्म्यं पश्य पुतर् त्वं दानवस्य दुरात्मनः।\nजहि शीघ्रं दुराचारं द्रष्टुमिच्छामि ते बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2027730, "chapter_id": 1594, "verse_number": "३-२३२-६६", "content_sanskrit": "इत्युक्ताव भगवान्स्कन्दं परिपूज्य महेश्वरः।\nअयोजयन्निग्रहार्थं महिषस् गतायुषः।\nसस्मार च तदा स्कन्दं मृत्युं तस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2027731, "chapter_id": 1594, "verse_number": "३-२३२-६७", "content_sanskrit": "महिषोऽपि रथं दृष्ट्वा रौद्रं रुद्रस् चानदत्।\nदेवान्संत्रासयंश्चापि दैत्यांस्चापिप्रहर्षयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2027732, "chapter_id": 1594, "verse_number": "३-२३२-६८", "content_sanskrit": "ततस्तस्मिनभये घोरे देवानां समुपस्थिते।\nआजगाम महासेनः क्रोधात्सूर्य इव ज्वलन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2027733, "chapter_id": 1594, "verse_number": "३-२३२-६९", "content_sanskrit": "लोहिताम्बरसंवीतो लोहितस्रग्विभूषणः।\nलोहिताश्वो महाबाहुर्हिरण्यकवचः प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2027734, "chapter_id": 1594, "verse_number": "३-२३२-७०", "content_sanskrit": "रथमादित्यसंकाशमास्थितः कनकप्रभम्।\nतं दृष्ट्वा दैत्यसेना सा व्यद्रवत्सहसा रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2027735, "chapter_id": 1594, "verse_number": "३-२३२-७१", "content_sanskrit": "स चापि तां प्रज्वलितां महिषस् विदारिणीम्।\nमुमोच शक्तिं राजेनद्र महासेनो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2027736, "chapter_id": 1594, "verse_number": "३-२३२-७२", "content_sanskrit": "सा मुक्ताऽभ्यहरत्तस्य महिषस्य शिरो महत्।\nपपात भिन्ने शिरसि महिषस्त्यक्तजीवितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2027737, "chapter_id": 1594, "verse_number": "३-२३२-७३", "content_sanskrit": "पतता शिरसा तेन द्वारं षोडशयोजनम्।\nपर्वताभेन पिहितं तदाऽगम्यं ततोऽभवत्।\nउत्तराः कुरवस्तेन गच्छन्त्यद्य यथासुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2027738, "chapter_id": 1594, "verse_number": "३-२३२-७४", "content_sanskrit": "क्षिप्ताक्षिप्ता तु सा शक्तिर्हत्वा शत्रून्सहस्रशः।\nस्कन्दहस्तमनुप्राप्ता दृश्यते देवदानवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2027739, "chapter_id": 1594, "verse_number": "३-२३२-७५", "content_sanskrit": "प्रायः शरैर्विनिहता महासेनेन धीमता।\nशेषा दैत्यगणा घोरा भीतास्त्रस्ता दुरासदैः।\nस्कन्दपारिषदैर्हत्वा भक्षिताश्च सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2027740, "chapter_id": 1594, "verse_number": "३-२३२-७६", "content_sanskrit": "दनवान्भक्षयन्तस्ते प्रपिबन्तश्च शोणितम्।\nक्षणान्निर्दानवं सर्वमकार्षुर्भृशहर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2027741, "chapter_id": 1594, "verse_number": "३-२३२-७७", "content_sanskrit": "तमांसीवयथा सूर्यो वृक्षानग्निर्घनान्खगः।\nतथास्कन्दोऽजयच्छत्रून्स्वेन वीर्येण कीर्तिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2027742, "chapter_id": 1594, "verse_number": "३-२३२-७८", "content_sanskrit": "संपूज्यमानस्त्रिदशैरभिवाद्य महेश्वरम्।\nशुशुभे कृतिकापुत्रः प्रकीरणांशुरिवांशुमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2027743, "chapter_id": 1594, "verse_number": "३-२३२-७९", "content_sanskrit": "नष्टशत्रुर्यदा स्कन्दः प्रयातस्तु महेश्वरम्।\nतदाऽब्रवीन्महासेनं परिष्वज्य पुरंदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2027744, "chapter_id": 1594, "verse_number": "३-२३२-८०", "content_sanskrit": "ब्रह्मदत्तवरः स्कन्द त्वयाऽयं महिषो हतः।\n`हजय्यो युधि देवानां दानवः स महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2027745, "chapter_id": 1594, "verse_number": "३-२३२-८१", "content_sanskrit": "देवास्तृणसमा यस्य वबूवुर्जयतांवर।\nसोऽयं त्वया महाबाहो शमितो देवकण्टकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2027746, "chapter_id": 1594, "verse_number": "३-२३२-८२", "content_sanskrit": "शतं महिषतुल्यानां दानवानां त्वय रणे।\nनिहतंदेवशत्रूणां यैर्वयं पूर्वतापिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2027747, "chapter_id": 1594, "verse_number": "३-२३२-८३", "content_sanskrit": "तावकैर्भक्षिताश्चान्ये दानवाः शतसङ्घशः।\nअजेयस्त्वं रणेऽरीणामुमापतिरिव प्रभुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2027748, "chapter_id": 1594, "verse_number": "३-२३२-८४", "content_sanskrit": "एतत्ते प्रथमं देव ख्यातं कर्म भविष्यति।\nत्रिषु लोकेषु कीर्तिश्च तवाक्षय्या भविष्यति।\nवशगाश्च भविष्यनति सुरास्तव महाभुज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2027749, "chapter_id": 1594, "verse_number": "३-२३२-८५", "content_sanskrit": "महासेनमेवमुक्त्वा निवृत्तः सह दैवतैः।\nअनुज्ञातो भगवता त्र्यम्बकेण शचीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2027750, "chapter_id": 1594, "verse_number": "३-२३२-८६", "content_sanskrit": "गतो भद्रवटंरुद्रो निवृत्ताश्च दिवौकसः।\nउक्ताश्च देवा रुद्रेण स्कन्दं पश्यत मामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2027751, "chapter_id": 1594, "verse_number": "३-२३२-८७", "content_sanskrit": "स हत्वा दानवगणान्पूज्यमानो महर्षिभिः।\nएकाह्नैवाजयत्सर्वं त्रैलोक्यं वह्निनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2027752, "chapter_id": 1594, "verse_number": "३-२३२-८८", "content_sanskrit": "स्कन्दस् य इदं विप्रः पठेज्जन्म समाहितः।\n`शृणुयाद्ब्राह्मणेभ्यो यः श्रावयेद्वाविचेतनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2027753, "chapter_id": 1594, "verse_number": "३-२३२-८९", "content_sanskrit": "धनमायुर्यशो दीप्तिं पुत्राञ्शत्रुजयंतथा।\nसपुष्टिमिहसंप्राप्य स्कन्दसालोक्यमाप्नुयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2027754, "chapter_id": 1594, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि द्वात्रिंशदधिकद्विशततमोऽध्यायः ॥ २३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}]