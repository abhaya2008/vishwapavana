[{"id": 2020867, "chapter_id": 1438, "verse_number": "३-७६-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020868, "chapter_id": 1438, "verse_number": "३-७६-१", "content_sanskrit": "स मासमुष्य कौन्तेय भीममामन्त्र्य नैषधः।\nपुरादल्पपरीवारो जगाम निषधान्प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020869, "chapter_id": 1438, "verse_number": "३-७६-२", "content_sanskrit": "रथेनैकेन शुभ्रेण दन्तिभिः परिषोडशै।\nपञ्चाशद्भिर्हयैश्चैव षट्शतैश्च पदातिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020870, "chapter_id": 1438, "verse_number": "३-७६-३", "content_sanskrit": "स कम्पयन्निव महीं त्वरमाणो महापुरीम्।\nप्रविवेशाथ संरब्धस्तरसैव महामनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020871, "chapter_id": 1438, "verse_number": "३-७६-४", "content_sanskrit": "ततः पुष्करमासाद्य वीरसेनसुतो नलः।\nउवाच दीव्याव पुनर्बहुवित्तं मयाऽर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020872, "chapter_id": 1438, "verse_number": "३-७६-५", "content_sanskrit": "दमयन्ती च यच्चान्यन्मम किंचन विद्यते।\nएष वै मम संन्यासस्तव राज्यंतु पुष्कर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020873, "chapter_id": 1438, "verse_number": "३-७६-६", "content_sanskrit": "पुनः प्रवर्ततां द्यूतमिति मे निश्चिता मतिः।\nएकपाणेन भद्रं ते प्राणयोश्च पणावहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020874, "chapter_id": 1438, "verse_number": "३-७६-७", "content_sanskrit": "जित्वा परस्वमाहृत् राज्यंवा यदि वा वसु।\nप्रतिपाणः प्रदातव्यः प्राणो हि पणमुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020875, "chapter_id": 1438, "verse_number": "३-७६-८", "content_sanskrit": "न चेद्वाञ्छसि तद्द्यूतं युद्धद्यूतं प्रवर्तताम्।\nद्वैरथेनास्तु वै शान्तिस्तव वा मम वा नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020876, "chapter_id": 1438, "verse_number": "३-७६-९", "content_sanskrit": "वंशभोज्यमिदं राज्यमर्थितव्यं यथा तथा।\nयेनकेनाप्युपायेन वृद्धानामिति शासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020877, "chapter_id": 1438, "verse_number": "३-७६-१०", "content_sanskrit": "द्वयोरेकतरे बुद्धिः क्रियतामद्य पुष्कर।\nकैतवेनाक्षवत्यां वा युद्धे वा नाम्यतां धनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020878, "chapter_id": 1438, "verse_number": "३-७६-११", "content_sanskrit": "नैषधेनैवमुक्तस्तु पुष्करः प्रहसन्निव।\nध्रुवमात्मजयं मत्वा प्रत्याह निषधाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020879, "chapter_id": 1438, "verse_number": "३-७६-१२", "content_sanskrit": "दिष्ट्या त्वयाऽर्जितं वित्तं प्रतिपाणाय नैषध।\nदिष्ट्या च दुष्कृतंकर्म दमयन्त्याः क्षयं गतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020880, "chapter_id": 1438, "verse_number": "३-७६-१३", "content_sanskrit": "दिष्ट्या वै प्रीसे राजन्मम लाभाय नैषध।\nपुनर्द्यूते च ते बुद्धिर्दिष्ट्या पुरुषसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020881, "chapter_id": 1438, "verse_number": "३-७६-१४", "content_sanskrit": "धनेनानेन वै भैमी जितेन समलंकृता।\nमामुपस्थास्यति व्यक्तं दिवि शक्रमिवाप्सराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020882, "chapter_id": 1438, "verse_number": "३-७६-१५", "content_sanskrit": "नित्यशो हि स्मरामि त्वां प्रतीक्षेऽपि च नैषध।\nदेवने च मभ प्रीतिर्भवत्येवासुहृद्गणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020883, "chapter_id": 1438, "verse_number": "३-७६-१६", "content_sanskrit": "जित्वात्वद्य वरारोहां दमयन्तीमनिन्दिताम्।\nकतकृत्यो भविष्यामि सा हिमे नित्यशो हृदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020884, "chapter_id": 1438, "verse_number": "३-७६-१७", "content_sanskrit": "श्रुत्वा तु तस् ता वाचो बह्वबद्धप्रलापिनः।\nइयेष स शिरश्छेत्तुं खङ्गेन कुपितो नलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020885, "chapter_id": 1438, "verse_number": "३-७६-१८", "content_sanskrit": "स्मयंस्तु रोषताम्राक्षस्तमुवाच नलो नृपः।\nपणावः किं व्याहरसे जितो न व्याहरिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020886, "chapter_id": 1438, "verse_number": "३-७६-१९", "content_sanskrit": "ततः प्रावर्तत द्यूतं पुष्करस्य नलस्य च।\nएकपाणेन भद्रं ते नलेन स पराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020887, "chapter_id": 1438, "verse_number": "३-७६-२०", "content_sanskrit": "स रत्नकोशनिचयैः प्राणेन पणितोपि च।\nजित्वा च पुष्करं राजा प्रहसन्निदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020888, "chapter_id": 1438, "verse_number": "३-७६-२१", "content_sanskrit": "मम सर्वमिदं राज्यमव्यग्रं हतकण्ठकम्।\nवैदर्भी न त्वया शक्या राजापशद वीक्षितम्।\nतस्यास्त्वं सपरीवारो मूढ दासत्वमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020889, "chapter_id": 1438, "verse_number": "३-७६-२२", "content_sanskrit": "न त्वया तत्कृतंकर्म येनाहं विजितः पुरा।\nकलिना तत्कृतं कर्म त्वं च मूढ न बुध्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020890, "chapter_id": 1438, "verse_number": "३-७६-२३", "content_sanskrit": "नाहं परकृतं दोषं त्वय्याधास्ये कथंचन।\nयथासुखं वै जीवत्वंप्राणानवसृजामि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020891, "chapter_id": 1438, "verse_number": "३-७६-२४", "content_sanskrit": "तथैव सर्वसंभारं स्वमंशं वितरामि ते।\nतथैव च मम प्रीतिस्त्वयि वीर न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020892, "chapter_id": 1438, "verse_number": "३-७६-२५", "content_sanskrit": "सौहार्दं चापि मे त्वत्तो न कदाचित्प्रहास्यति।\nपुष्कर त्वं हि मे भ्राता संजीव शरदः शतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020893, "chapter_id": 1438, "verse_number": "३-७६-२६", "content_sanskrit": "एवं नलः सान्त्वयित्वा भ्रातरं सत्यविक्रमः।\nवचनैस्तोषयामास परिष्वज्य पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020894, "chapter_id": 1438, "verse_number": "३-७६-२७", "content_sanskrit": "सान्त्वितो नैषधेनैवं पुष्ररः प्रत्युवाच तम्।\nपुण्यश्लोकं तदा राजन्नभिवाद्य कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020895, "chapter_id": 1438, "verse_number": "३-७६-२८", "content_sanskrit": "कीर्तिरस्तु तवाक्षय्या जीव वर्षायुतं सुखी।\nयो मे वितरसि प्राणानधिष्ठानं च पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020896, "chapter_id": 1438, "verse_number": "३-७६-२९", "content_sanskrit": "स तथा सत्कृतो राज्ञा मासमुष्य तदा नृपः।\nप्रययौ पुषरो हृष्टः स्वपुरं स्वजनावृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020897, "chapter_id": 1438, "verse_number": "३-७६-३०", "content_sanskrit": "महत्या सेनया सार्धंविनीतैः परिचारकैः।\nभ्राजमान इवादित्यो वपुषा पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020898, "chapter_id": 1438, "verse_number": "३-७६-३१", "content_sanskrit": "प्रस्थाप्य पुष्करं राजा वित्तवन्तमनामयम्।\nप्रविवेश पुरं श्रीमानत्यर्थमुपशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2020899, "chapter_id": 1438, "verse_number": "३-७६-३२", "content_sanskrit": "प्रविश्य सान्त्वयामास पौरांश्च निषधाधिपः।\n`हितेषु चैषां सततं पितेवावहितोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2020900, "chapter_id": 1438, "verse_number": "३-७६-३३", "content_sanskrit": "पौरा जानपदाश्चापि संप्रहृष्टतनूरुहाः।\nऊचुः प्राञ्जलयः सर्वे सामात्यप्रमुखा जनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2020901, "chapter_id": 1438, "verse_number": "", "content_sanskrit": "अद्यस्म निर्वृता राजन्पुरे जनपदेऽपि च।\nउपासितुं पुनः प्राप्ता देवा इव शतक्रतुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]