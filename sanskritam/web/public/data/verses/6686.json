[
  {
    "id": 20011777,
    "chapter_id": 6686,
    "verse_number": "14.1",
    "content_sanskrit": "सा तमाराधयामास य'तिचित्तं यतिं सदा । तस्यैवाऽऽसिसिषाञ्चक्रे मुक्तक्रीडारसाऽन्तिके ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20011778,
    "chapter_id": 6686,
    "verse_number": "14.2",
    "content_sanskrit": "आसन्नसलिलं भिक्षोश्चकासामास मन्दिरम् । सर्वकर्मीणया सिक्तं परिमृष्टं सुभद्रया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20011779,
    "chapter_id": 6686,
    "verse_number": "14.3",
    "content_sanskrit": "ईक्षाञ्चक्रे कटाक्षैर्यदिन्दीवरसहोदरैः । ईहामास च तेनाऽस्य काममुम्भाञ्चकार सा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20011780,
    "chapter_id": 6686,
    "verse_number": "14.4",
    "content_sanskrit": "दयाञ्चक्रे स भूतानामयामास परं शमम् । आसामास सदाऽऽत्मानं परमं नाम भावयन् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20011781,
    "chapter_id": 6686,
    "verse_number": "14.5",
    "content_sanskrit": "ओषामासाऽर्जुनं शश्वत्कुसुमायुधपावकः । विदामास मुकुन्दस्तज्जागरामास तद्धिते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20011782,
    "chapter_id": 6686,
    "verse_number": "14.6",
    "content_sanskrit": "स्खलिताद्विभयामास जिह्रयामास दर्शने । सा तस्य नित्यं बिभ्रांबभूवाराधनाभरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20011783,
    "chapter_id": 6686,
    "verse_number": "14.7",
    "content_sanskrit": "सा कटाक्षेन्धनैस्तस्य संधुक्ष्य मदनाननलम् । जुहवामास तत्र खामाज्यधारामिव स्मितिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20011784,
    "chapter_id": 6686,
    "verse_number": "14.8",
    "content_sanskrit": "यदुवोष स्मराग्निंस्तं सा मुग्धा न विवेद तत् । सा तस्य वरिवस्यांयां जजागार दिवानिशम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20011785,
    "chapter_id": 6686,
    "verse_number": "14.9",
    "content_sanskrit": "दर्शयन्त्यपि जिह्राय याऽऽत्मानं परिचर्यया । सा नाऽविनयलक्ष्माणि बभारेति कृतं गिरा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20011786,
    "chapter_id": 6686,
    "verse_number": "14.10",
    "content_sanskrit": "तन्द्रीमास जहौ निद्रामुपस्युपसि माधवी । उत्तस्थौ शयनात्सुष्ठु काष्ठैर्दन्तान् दधाव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20011787,
    "chapter_id": 6686,
    "verse_number": "14.11",
    "content_sanskrit": "आपुप्लुवेऽम्बुभिश्शुद्धैर्वसनं ववसे सितम् । जजाप पावनान् मन्तान् कीर्तयामास सज्जनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20011788,
    "chapter_id": 6686,
    "verse_number": "14.12",
    "content_sanskrit": "महीपरागसंभिन्नकुचकुड्मलमण्डला । उड्डीयमानं मार्तण्डं नमस्यामास चाऽसकृत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20011789,
    "chapter_id": 6686,
    "verse_number": "14.13",
    "content_sanskrit": "विदग्धालीकृतां दध्रे ललाटेन ललाटिकाम् । प्रकाशितकपोलाभ्यां कर्णाभ्यामपि कर्णिकाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20011790,
    "chapter_id": 6686,
    "verse_number": "14.14",
    "content_sanskrit": "काश्मीरजपरागेण विलिलेप पयोधरौ । ऊहे निकुञ्चितान्ताभ्यां मौक्तिकैकावलीमपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20011791,
    "chapter_id": 6686,
    "verse_number": "14.15",
    "content_sanskrit": "आमुमोचाऽङ्गदं दीप्तमाबबन्ध च कङ्कणम् । मेखलां कलयामास धारयामास नूपुरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20011792,
    "chapter_id": 6686,
    "verse_number": "14.16",
    "content_sanskrit": "सुवर्णयष्टिसङ्काशगात्रयष्टिद्युतिप्रदम् । अंसयोरुत्तरीयञ्च शुकपृष्ठप्रभं दधौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20011793,
    "chapter_id": 6686,
    "verse_number": "14.17",
    "content_sanskrit": "अञ्जनेनाऽञ्जसाऽऽनञ्ज नयनेन्दीवरद्वयम् । मुखेन्दुनाऽनुजग्राह दूर्वाकिसलयानि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20011794,
    "chapter_id": 6686,
    "verse_number": "14.18",
    "content_sanskrit": "दूर्वाप्रवालसंसृष्टं सितप्रसवशेखरम् । तमालवननीलेन धम्मिल्लेन बभार सा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20011795,
    "chapter_id": 6686,
    "verse_number": "14.19",
    "content_sanskrit": "मुखकान्तिजितोपात्तशशिबिम्बविडम्बिनी । ध्यायन्ती पार्थमात्मानं ददर्श मणिदर्पणे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20011796,
    "chapter_id": 6686,
    "verse_number": "14.20",
    "content_sanskrit": "एवं भूषितसर्वाङ्गी सा पार्थ पुरतः स्थिता । कबलीकृत्य नेत्राभ्यां मनसि ध्रुवमादधे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20011797,
    "chapter_id": 6686,
    "verse_number": "14.21",
    "content_sanskrit": "इयेष सा सदा द्रष्टुं वक्तुमालिङ्गितुं च तम् । चोदिता पञ्चबाणेन त्रपया न शशाक च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20011798,
    "chapter_id": 6686,
    "verse_number": "14.22",
    "content_sanskrit": "स्नात्वा प्रगेतरामेव प्रविवेशाऽस्य सा गृहम् । ममार्ज गोमयाम्भोभिस्सर्वमुक्षांबभूव च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20011799,
    "chapter_id": 6686,
    "verse_number": "14.23",
    "content_sanskrit": "परिचस्कार पुष्पैश्च प्रत्यग्रैस्तत्सुगन्धिभिः । सञ्चिकाय क्वचिन्मृत्स्नामुदकुंभांश्च शोभनान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20011800,
    "chapter_id": 6686,
    "verse_number": "14.24",
    "content_sanskrit": "भक्षान् स्वादीयसस्सर्वांश्चकार प्रददौ च सा । यथाकालं यतीन्द्राय सर्वान्नीनाय सादरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20011801,
    "chapter_id": 6686,
    "verse_number": "14.25",
    "content_sanskrit": "हृष्यन् जितामृतैरन्नैः प्रियलाभाशिषो वदन् । पिप्रीय कान्तामेकान्ते लज्जयामास चाऽर्जुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20011802,
    "chapter_id": 6686,
    "verse_number": "14.26",
    "content_sanskrit": "क्रमेण चाटुकारत्वं कान्तायाः प्रतिपद्य सः । बभूव भूरपाङ्गानां समन्दस्मितरोचिषाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20011803,
    "chapter_id": 6686,
    "verse_number": "14.27",
    "content_sanskrit": "श्रुत्त्वाऽऽसीनं परिव्राजं जातु जातकुतूहला । विविधं लोकवृत्तान्तं परिपप्रच्छ माधवी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20011804,
    "chapter_id": 6686,
    "verse_number": "14.28",
    "content_sanskrit": "स पृष्टः पृष्टमिष्टायै प्रचक्षाणो विचक्षणः । उदन्तं वर्णयामास भ्रातृणामात्मनश्च तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20011805,
    "chapter_id": 6686,
    "verse_number": "14.29",
    "content_sanskrit": "सा तं श्रुत्वैव मन्दाक्षकन्दर्पावेशविह्वला । गत्वा तु शिश्रिये शय्यां व्यपदिश्य शिरोरुजम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20011806,
    "chapter_id": 6686,
    "verse_number": "14.30",
    "content_sanskrit": "वासुदेवस्तु विज्ञाय भिक्षोस्समभिराधने । देवीमेवातिनिष्णातां चोदयामास रुक्मिणीम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20011807,
    "chapter_id": 6686,
    "verse_number": "14.31",
    "content_sanskrit": "गत्वाऽथाऽश्वाऽऽसयामास वत्सला देवकीसुताम् । जिष्णुरेव पतिर्भावी तव कृष्ण नयैरिति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20011808,
    "chapter_id": 6686,
    "verse_number": "14.32",
    "content_sanskrit": "अथैकदाऽच्युतस्तेने कमपीप्सुर्मनोरथम् । महाद्वीपे महाम्भोधेर्महादेवमहामहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20011809,
    "chapter_id": 6686,
    "verse_number": "14.33",
    "content_sanskrit": "अथाऽनङ्गद्विषो लिङ्गं द्वैप्यमभ्यर्चितुं ययुः । द्वीपं वृष्ण्यन्धकास्सर्वे तरन्तो नौभिरर्णवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20011810,
    "chapter_id": 6686,
    "verse_number": "14.34",
    "content_sanskrit": "तरङ्गिणीवनाभोगगिरिकुञ्जनिरन्तरे । चतुस्त्रिंशदहोरात्रान् विजह्रुस्तत्र ते सुखम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20011811,
    "chapter_id": 6686,
    "verse_number": "14.35",
    "content_sanskrit": "वसन्तसमयस्तत्र वसन्तं वासवानुजम् । रमयामास सत्पुष्पै रमयाऽऽश्लिष्टवक्षसम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20011812,
    "chapter_id": 6686,
    "verse_number": "14.36",
    "content_sanskrit": "तदा सम्मोहयन् वृष्णीन्मायया मधुसूदनः । द्वीपे च द्वारकायाञ्च रेमे स रमणीजनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20011813,
    "chapter_id": 6686,
    "verse_number": "14.37",
    "content_sanskrit": "सोऽर्जुनेन सहोवास मूर्त्या तत्रैकया पुरे । चिकीड माधवैस्सार्धं द्वीपे तु विबुरन्यया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20011814,
    "chapter_id": 6686,
    "verse_number": "14.38",
    "content_sanskrit": "अथ वसन्तवर्णनम् गायन्तो भृङ्गझङ्कारैस्सपुष्पस्वर्णभूषणाः । तत्र लेसुरिवाऽशोकाश्चलत्किसलयांशुकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20011815,
    "chapter_id": 6686,
    "verse_number": "14.39",
    "content_sanskrit": "क्षिप्तैर्दक्षिणवातेन बकुलप्रसवैश्श्रितम् । हृद्यमुद्यानमास्थानमध्युवास झषध्वजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20011816,
    "chapter_id": 6686,
    "verse_number": "14.40",
    "content_sanskrit": "विरराजुररण्येषु किंशुकाः काममुद्गराः । दधतो मञ्जरीभिन्नवियोगिहृदयासृजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20011817,
    "chapter_id": 6686,
    "verse_number": "14.41",
    "content_sanskrit": "चूता रुरुचिरे पुष्पैः पलाशाः प्रचकाशिरे । फुल्लाः कुरबका रेजुः पुपुष्पुरपि चम्पकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20011818,
    "chapter_id": 6686,
    "verse_number": "14.42",
    "content_sanskrit": "मकरन्दलिहो मत्ता बभ्रमुर्भ्रमरा वने । भृङ्गाङ्गनाश्च विभ्रेमुर्भूरिपुष्परजोभृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20011819,
    "chapter_id": 6686,
    "verse_number": "14.43",
    "content_sanskrit": "परपुष्टकुले धृष्टे चूतशाखासु कूजति । जज्ञिरे प्रेमयुद्धानि रतियुद्धानि कामिनाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20011820,
    "chapter_id": 6686,
    "verse_number": "14.44",
    "content_sanskrit": "मेदे तैर्येन जेरूर्यद्वसन्ते युक्तमेव तत् । जजरुर्ये तुयत्तेपि मेदू रक्तास्तदद्भुतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20011821,
    "chapter_id": 6686,
    "verse_number": "14.45",
    "content_sanskrit": "त्रेसुरालोक्य शार्दूलानद्रिकुञ्जेषु योषितः । तत्रसुश्च हरी'न्दृष्ट्वा गाढश्श्वाऽऽशिश्लिषुः प्रियान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20011822,
    "chapter_id": 6686,
    "verse_number": "14.46",
    "content_sanskrit": "विविक्तेष्वभिकाःस्त्रीणां वासांस्याऽऽचकृषुः करैः । तास्त्रेपिरे तदाश्लिष्टा विरेधुस्तान् स्तनै रुषा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20011823,
    "chapter_id": 6686,
    "verse_number": "14.47",
    "content_sanskrit": "यावन्न विजना फेणुर्ह्रीताः कान्तैर्हृतांशुकाः । कान्तास्तावत् परिष्वज्य कान्तास्ताः पफणू रतिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20011824,
    "chapter_id": 6686,
    "verse_number": "14.48",
    "content_sanskrit": "सुभ्रुवां कुचकुम्भेषु नखरेखा रराजिरे । रेजिरे रदलक्ष्माणि रदनच्छदनेषु च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20011825,
    "chapter_id": 6686,
    "verse_number": "14.49",
    "content_sanskrit": "रमण्यो रतिषु स्येमुस्सस्यमुर्वलयालयः । सस्वनुर्मौक्तिकाकल्पस्स्वेनुश्च मणिमेखलाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20011826,
    "chapter_id": 6686,
    "verse_number": "14.50",
    "content_sanskrit": "श्लेषां दददिरे कान्ताः कान्तेभ्यश्चुम्बनानि च । नखैर्विशशसुर्गात्रान् दन्तैर्दन्तच्छदानि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20011827,
    "chapter_id": 6686,
    "verse_number": "14.51",
    "content_sanskrit": "तदाऽष्टमूर्तिदग्धस्वमूर्तिमारेस्य पप्रथे । मारुतेरितमाकन्दपुष्परेणुच्छलादिव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20011828,
    "chapter_id": 6686,
    "verse_number": "14.52",
    "content_sanskrit": "सहैवाऽऽराधयामासुः स्मरेण स्मरवैरिणम् । माधवे भयमुत्सृज्य माधवा माधवाज्ञया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20011829,
    "chapter_id": 6686,
    "verse_number": "14.53",
    "content_sanskrit": "उद्धृते क्षणमर्चायामीक्षमाणोम्बुजेक्षणम् । विरूपाक्षो न चुक्रोध लालयन्तमपि स्मरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20011830,
    "chapter_id": 6686,
    "verse_number": "14.54",
    "content_sanskrit": "मधु द्विषन्मधुं यद्वन्ननन्दोपस्थितं तदा । कामस्यापि द्विषन्कारमाददे तद्वदागतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20011831,
    "chapter_id": 6686,
    "verse_number": "14.55",
    "content_sanskrit": "अथ शूलगवेनेष्ट्वा शूलपाणिं कदाचन । गौरीपारिषदोपेतं तुष्टाव मधुसूदनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20011832,
    "chapter_id": 6686,
    "verse_number": "14.56",
    "content_sanskrit": "नमो भवाय शर्वाय तुभ्यं पशुपते नमः । उग्राय महते भीमरुद्रेशान नमो नमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20011833,
    "chapter_id": 6686,
    "verse_number": "14.57",
    "content_sanskrit": "शर्व सर्वोऽप्यसर्वस्त्वं गुणवानपि निर्गुणः । निष्कर्मा विश्वसर्गादिकर्मकारोऽपि दुस्तवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20011834,
    "chapter_id": 6686,
    "verse_number": "14.58",
    "content_sanskrit": "सस्रष्ठ परमेष्ठी संस्त्वमेव भुवनं भव । ससर्जिय च भूतानि त्रसानि स्थावराणि च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20011835,
    "chapter_id": 6686,
    "verse_number": "14.59",
    "content_sanskrit": "कालेश कालवश्यांस्त्वन्ददर्शिथ बहूनजान् । रुद्र दद्रष्ट भूयिष्ठानप्रमेयमनून् पुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20011836,
    "chapter_id": 6686,
    "verse_number": "14.60",
    "content_sanskrit": "महाविषं जगद्गुप्त्यै कालकूटं त्वमादिथ । पातुं भूतानि भूतेभ्यश्श्मशानानि त्वमारिथ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20011837,
    "chapter_id": 6686,
    "verse_number": "14.61",
    "content_sanskrit": "संविष्ययिथ चर्माणि व्याघ्राणां त्वं जगद्द्रुहाम् । बहून् 'बभर्थ भक्तांस्त्वं भियस्तेषां जहर्थ च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20011838,
    "chapter_id": 6686,
    "verse_number": "14.62",
    "content_sanskrit": "भक्तं भक्तं ययाथ त्वं भगवन् भक्तवत्सल । पपिथापि जगन्मात्रा सह शैलेन्द्रकन्यया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20011839,
    "chapter_id": 6686,
    "verse_number": "14.63",
    "content_sanskrit": "देहिनामरिमग्रण्यं देहिथ त्वं मनोभवम् । पुरा ददग्ध चाऽरीणां पुराणि परमेश्वर ! ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20011840,
    "chapter_id": 6686,
    "verse_number": "14.64",
    "content_sanskrit": "उपमन्युमृषिं भक्तं फेणिथ त्वं पयोर्थिनम् । क्षीरोदवेष्टितश्वास्य कृत्वा पफणिथाऽऽश्रमम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20011841,
    "chapter_id": 6686,
    "verse_number": "14.65",
    "content_sanskrit": "श्वेतन्तमभिदुद्रोथ क्रन्दन्तं भीतमन्तकात् । विरेधिथ त्रिशूलेन तञ्च तञ्च ररक्षिथ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20011842,
    "chapter_id": 6686,
    "verse_number": "14.66",
    "content_sanskrit": "आद्यन्तावन्तकाराते कश्चाहश्च न जज्ञिव । तदादि ते महादेव दासावावां बभूविव ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20011843,
    "chapter_id": 6686,
    "verse_number": "14.67",
    "content_sanskrit": "जलन्धरस्य येन त्वं शिरो लुलविथाऽरिणा । पुरा नारायणो हन्त चकमे किल शङ्कर ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20011844,
    "chapter_id": 6686,
    "verse_number": "14.68",
    "content_sanskrit": "सोहं चकार तेऽभ्यर्चां सहस्रतममम्बुजम् । तदा न नाऽशमेयाहन्नेत्रमुज्जहरात्मनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20011845,
    "chapter_id": 6686,
    "verse_number": "14.69",
    "content_sanskrit": "प्रससत्थ ततो मेऽरिन्नयनञ्च वितेरिथ । चक्रचुञ्चुरहञ्चक्रे तदाद्यमुमुचोऽसुरान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20011846,
    "chapter_id": 6686,
    "verse_number": "14.70",
    "content_sanskrit": "पूजयाञ्चकृषे न त्वं दक्षेण स्वमखे किल । चुक्रोधिव ततस्तस्मै सुस्रोथ च मखक्षितिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20011847,
    "chapter_id": 6686,
    "verse_number": "14.71",
    "content_sanskrit": "चिच्छेदिथ कुठारेण तत्र त्वं सवितुः करम् । बभञ्जिथ भगस्याक्षि पदा सोमं बिभेदिथ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20011848,
    "chapter_id": 6686,
    "verse_number": "14.72",
    "content_sanskrit": "जिगेथ वज्रिणं युद्धे तथा जिगयिथाऽच्युतम् । दुदोथ सर्वान् गीर्वाणान् सर्वान् दुदविथर्त्विजः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20011849,
    "chapter_id": 6686,
    "verse_number": "14.73",
    "content_sanskrit": "दारुणं भेजिषे रूपं तदा त्वं कुपितो हर । शमयाञ्चकृमाऽथ त्वान्नुवन्तो विबुधा वयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20011850,
    "chapter_id": 6686,
    "verse_number": "14.74",
    "content_sanskrit": "त्वत्प्रसादाच्च शर्माणि वयं लेभिमहे तदा । तदाप्रभृति देवा'स्तवत्सर्वे वै भीम बिभ्यिम ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20011851,
    "chapter_id": 6686,
    "verse_number": "14.75",
    "content_sanskrit": "त्वयैवमवता लोकान् सप्रियेण क्षता सता । परमेश वयं पाल्यास्स्वपादशरणास्सदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20011852,
    "chapter_id": 6686,
    "verse_number": "14.76",
    "content_sanskrit": "अष्टमूर्त्तिस्स्वमूर्त्येत्थं नुतः श्रीवत्सलक्ष्मणा । तं वृष्णिनृपमध्यस्थं जगाद व्यक्तबिग्रहः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20011853,
    "chapter_id": 6686,
    "verse_number": "14.77",
    "content_sanskrit": "युक्ता परिजनस्येयं विधे यस्य विडम्बना । यत्त्वमर्चितवान्र्च्यः स्तुत्यश्च स्तुतवान् विभो ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20011854,
    "chapter_id": 6686,
    "verse_number": "14.78",
    "content_sanskrit": "सद्सद्वा न किञ्चित्त्वदपरं पुरुषोत्तम । स्वाधीनमेव ते सर्वं त्वयाऽऽप्तं सर्वमीप्सितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20011855,
    "chapter_id": 6686,
    "verse_number": "14.79",
    "content_sanskrit": "गोविन्द न त्वदन्योऽहम्मच्च नार्थान्तरं भवान् । तत्त्वयाऽर्थ्यं मयाऽप्यऽर्थ्यं देयं देयं तवापि मे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20011856,
    "chapter_id": 6686,
    "verse_number": "14.80",
    "content_sanskrit": "उक्तेति कृष्णं वृष्णिभ्यो दत्त्वा चेप्सितमीप्सितम् । अन्तर्दधेऽन्धकारातिराननेन्दुश्च ते समे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20011857,
    "chapter_id": 6686,
    "verse_number": "14.81",
    "content_sanskrit": "तथा विजृम्भमाणेण मारस्तु मधुना सह । विव्याध बहुलं पौष्पैर्माधवीकौरवौ शरैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20011858,
    "chapter_id": 6686,
    "verse_number": "14.82",
    "content_sanskrit": "एकदा तु प्रियालीभिस्सविशेषं विभूषिता । रुक्मिणीसत्यभामोत्का माधवीयाय फल्गुनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20011859,
    "chapter_id": 6686,
    "verse_number": "14.83",
    "content_sanskrit": "सा विध्यन्ती तदाऽपाङ्गैर्विपदिग्घैरिवेषुभिः । मनो विलोलयामास विजयस्य मनस्विनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20011860,
    "chapter_id": 6686,
    "verse_number": "14.84",
    "content_sanskrit": "उपवेश्य प्रियालापैरथ पार्श्वे धनञ्जयः । कथाभिरभिरामाभिस्सविस्त्रम्भां चकार ताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20011861,
    "chapter_id": 6686,
    "verse_number": "14.85",
    "content_sanskrit": "स तामथेत्थं पप्रच्छ कीदृक् तव मनो मयि । प्रसितं त्वयि चित्तं मे पार्थोऽहं पाण्डुनन्दनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20011862,
    "chapter_id": 6686,
    "verse_number": "14.86",
    "content_sanskrit": "इत्युच्यमाना सरसै रूढवेपथुकण्टकैः । जगाद त्वदधीनाऽहमिति सा पार्थमङ्गकैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20011863,
    "chapter_id": 6686,
    "verse_number": "14.87",
    "content_sanskrit": "स तामित्थमथोवाद त्याज्या लज्जा त्वयाऽधुना । दूने यथाहं मारेण तथैव त्वमपि ध्रुवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20011864,
    "chapter_id": 6686,
    "verse_number": "14.88",
    "content_sanskrit": "अचिरेण तदावाभ्यामन्योन्यप्राणरक्षणम् । प्रदानेनात्मनोः कार्यं गान्धर्वोऽयं विधिः स्मृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20011865,
    "chapter_id": 6686,
    "verse_number": "14.89",
    "content_sanskrit": "गान्धर्वविधिना होहे सोमसूनुरिलां बुधः । ययातिर्देवयानीञ्च दुष्यन्तश्च शकुन्तलाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20011866,
    "chapter_id": 6686,
    "verse_number": "14.90",
    "content_sanskrit": "भ्रातुश्च तव कृष्णस्य प्रियं नौ सङ्गतं प्रिये । द्वीपे कृत्वोत्सवं तेन यन्नौ निर्माक्षिकं कृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20011867,
    "chapter_id": 6686,
    "verse_number": "14.91",
    "content_sanskrit": "अस्मिन्नवसरे तस्मात् त्वां गृहीत्वा मया द्रुतम् । पुरं पुरन्दरप्रस्थं प्राप्यं पृथुललोचने ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20011868,
    "chapter_id": 6686,
    "verse_number": "14.92",
    "content_sanskrit": "विस्रब्धया त्वया भाव्यं मन्दमन्दाक्षया ततः । दामोदरेऽनुकूले नौ सिद्धं सकलमीप्सितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20011869,
    "chapter_id": 6686,
    "verse_number": "14.93",
    "content_sanskrit": "इत्युक्त्वा स सुभद्रायाः पाणिं जग्राह पाणिना । सरत्नकङ्कणश्रेणि मृदुताम्रतलाङ्गुलिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20011870,
    "chapter_id": 6686,
    "verse_number": "14.94",
    "content_sanskrit": "तथाऽस्यास्संहतौ क्रूरौ पृथुना हृदयद्रुहौ । स्तनौ कोपादिवोद्वृत्तौ पीडयामास वक्षसा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20011871,
    "chapter_id": 6686,
    "verse_number": "14.95",
    "content_sanskrit": "चुचुम्ब मुखचन्द्रेण चन्द्रकान्तं तदाननम् । स्यन्दमानमिवोद्यद्भिरसमन्तात् स्वेदबिन्दुभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20011872,
    "chapter_id": 6686,
    "verse_number": "14.96",
    "content_sanskrit": "सोऽथ सार्धं तया रन्तुं कौन्तेयस्तत्वरेतराम् । सस्मार च मुकुन्दस्य सख्युश्शतमखस्य च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20011873,
    "chapter_id": 6686,
    "verse_number": "14.97",
    "content_sanskrit": "जगाम शरणं शश्वन्मनसा सा च माधवम् । विभुस्तु कृपया तूर्णं द्वीपाद् द्वारवतीं ययौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20011874,
    "chapter_id": 6686,
    "verse_number": "14.98",
    "content_sanskrit": "रुक्मिणीञ्चेति पप्रच्छ यथासुखमिहाऽर्जुनः । उवास तं सुभद्रा च स्वस्राऽऽनर्च गते मयि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20011875,
    "chapter_id": 6686,
    "verse_number": "14.99",
    "content_sanskrit": "सा तु घोरां मनोजार्तिं वर्णयन्ती तयोस्तदा । विवाहोपक्रमेऽतीव चकार त्वरितं पतिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20011876,
    "chapter_id": 6686,
    "verse_number": "14.100",
    "content_sanskrit": "पार्थेनाऽथ स्मृतश्शक्रः प्रतस्थे द्वारकां दिवः । सिन्दूरितवराङ्गेन सर्वश्वेतेन दन्तिना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20011877,
    "chapter_id": 6686,
    "verse_number": "14.101",
    "content_sanskrit": "छत्रमच्छिन्नचन्द्राभं दध्रे मूर्ध्नि मरुत्पतेः । व्यजने तत्प्रभापूर्णे दुधुवाते च पार्श्वयोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20011878,
    "chapter_id": 6686,
    "verse_number": "14.102",
    "content_sanskrit": "जयन्तेन कुमारेण सहाऽभ्रमुशिरोगता । देवीवृता शचीदेवी दीव्यन्त्यनुदिदेव तम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20011879,
    "chapter_id": 6686,
    "verse_number": "14.103",
    "content_sanskrit": "पनायन्तः प्रियैस्सूक्तैरन्वीयुस्तं सुरर्षयः । सर्वेऽनुसस्रुर्गीर्वाणास्सूर्यवैश्वानरादयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20011880,
    "chapter_id": 6686,
    "verse_number": "14.104",
    "content_sanskrit": "जगुस्तदपदानानि विश्वावसुपुरस्सराः । ननृतुश्चोर्वशीमुख्याः विमानस्था विभोः पुरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20011881,
    "chapter_id": 6686,
    "verse_number": "14.105",
    "content_sanskrit": "इन्द्रमिन्द्रानुजः प्राप्तमथाऽऽनर्च स्वमालयम् । विवाहसंभ्रमैरेव पौलोमीमपि रुक्मिणी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20011882,
    "chapter_id": 6686,
    "verse_number": "14.106",
    "content_sanskrit": "अथ प्रववृते गूढस्तत्र पाणिग्रहोत्सवः । सपुरन्ध्रीजनैः पौरैः परिष्कृतगृहावलिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  },
  {
    "id": 20011883,
    "chapter_id": 6686,
    "verse_number": "14.107",
    "content_sanskrit": "अथाऽऽगत्यर्षयो हर्षात् सर्वे भुवनवासिनः । इन्द्राविष्णू च देवाश्च तुष्टुवुर्मङ्गलार्थिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 107,
    "avatarnika": ""
  },
  {
    "id": 20011884,
    "chapter_id": 6686,
    "verse_number": "14.108",
    "content_sanskrit": "इन्द्राविष्णू युवां दैत्यान् संग्रामेषु विजिग्यथुः । समरेष्वतिशिष्येवां न कश्चिदसुरो हरी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 108,
    "avatarnika": ""
  },
  {
    "id": 20011885,
    "chapter_id": 6686,
    "verse_number": "14.109",
    "content_sanskrit": "त्वमिन्द्र नमुचिं वृत्रं वलादींश्च विजिग्यिषे । त्रिविक्रमवलिं बद्ध्वा निनेथ त्वं रसातलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 109,
    "avatarnika": ""
  },
  {
    "id": 20011886,
    "chapter_id": 6686,
    "verse_number": "14.110",
    "content_sanskrit": "पप यूयं प्रजा देवाश्चकृढ्वे पापनिग्रहान् । लुलुविढ्वे ततश्शस्त्रैर्लुलुविध्वेच नैरृतान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 110,
    "avatarnika": ""
  },
  {
    "id": 20011887,
    "chapter_id": 6686,
    "verse_number": "14.111",
    "content_sanskrit": "विबुधारीन् बबाधाथे विबुधांश्च ररक्षथुः । ईशानौ सर्वभूतानां शिववैश्रवणौ युवाम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 111,
    "avatarnika": ""
  },
  {
    "id": 20011888,
    "chapter_id": 6686,
    "verse_number": "14.112",
    "content_sanskrit": "युष्माभिरद्य तैस्सर्वैस्सुभद्रासव्यसाचिनोः । देवाशिशावानि कार्याणि भक्तयोर्भक्तवत्सलाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 112,
    "avatarnika": ""
  },
  {
    "id": 20011889,
    "chapter_id": 6686,
    "verse_number": "14.113",
    "content_sanskrit": "स्तुत्वेत्थमर्चिता देवा मुनिभिर्द्रुहिणादयः । वर्धयामासुराशीर्भिर्मिथुनं वीक्ष्य तन्मुदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 113,
    "avatarnika": ""
  },
  {
    "id": 20011890,
    "chapter_id": 6686,
    "verse_number": "14.114",
