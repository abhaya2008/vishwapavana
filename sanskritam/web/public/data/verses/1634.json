[{"id": 2029014, "chapter_id": 1634, "verse_number": "३-२७२-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029015, "chapter_id": 1634, "verse_number": "३-२७२-१", "content_sanskrit": "संतिष्ठध्वं प्रहरत तूर्णं विपरिधावत।\nइति स्म सैन्धवो राजा चोदयामास तान्नृपन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029016, "chapter_id": 1634, "verse_number": "३-२७२-२", "content_sanskrit": "ततो घोरतमः शब्दोरणे समभवत्तदा।\nभीमार्जुनयमान्दृष्ट्वा सैन्यानां सयुधिष्ठिरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029017, "chapter_id": 1634, "verse_number": "३-२७२-३", "content_sanskrit": "शिबिसिंधुत्रिगर्तानां विषादश्चाप्यजायत।\nतान्दृष्ट्वापुरुषव्याघ्रान्व्याघ्रानिव बलोत्कटान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029018, "chapter_id": 1634, "verse_number": "३-२७२-४", "content_sanskrit": "हेमबिन्दुं महोत्सेधां सर्वशैक्यायसीं गदाम्।\nप्रगृह्याभ्यद्रवद्भीमः सैन्धवं कालचोदितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029019, "chapter_id": 1634, "verse_number": "३-२७२-५", "content_sanskrit": "तदन्तरमथावृत्य कोटिकाश्योऽभ्यहारयत्।\nमहता रथवंशेन परिवार्य वृकोधरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029020, "chapter_id": 1634, "verse_number": "३-२७२-६", "content_sanskrit": "शक्तितोमरनाराचैर्वीरबाहुप्रचोदितैः।\nकीर्यमाणोपि बहुभिर्न स्म भीमोऽभ्यकम्पत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029021, "chapter_id": 1634, "verse_number": "३-२७२-७", "content_sanskrit": "गजं तु सगजारोहं पदातींश्च चतुर्दश।\nजघान गदया भीमः सैन्धवध्वजंनीमुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029022, "chapter_id": 1634, "verse_number": "३-२७२-८", "content_sanskrit": "पार्थः पञ्चशताञ्शूरान्पार्वतीयान्महारथान्।\nपरीप्समानः सौवीरं जघान ध्वजिनीमुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029023, "chapter_id": 1634, "verse_number": "३-२७२-९", "content_sanskrit": "राजा स्वयं सुवीराणां प्रवराणां प्रहारिणाम्।\nनिमेषमात्रेण शतं जघान समरे तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029024, "chapter_id": 1634, "verse_number": "३-२७२-१०", "content_sanskrit": "ददृशे नकुलस्तत्ररथात्प्रस्कन्द्य खङ्गधृत्।\nशिरांसि पादरक्षाणां बीजवत्प्रवपन्मुहुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029025, "chapter_id": 1634, "verse_number": "३-२७२-११", "content_sanskrit": "सहदेवस्तु संयाय रथेन गजयोधिनः।\nपातयामास नाराचैर्द्रुमेभ्य इव बर्हिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029026, "chapter_id": 1634, "verse_number": "३-२७२-१२", "content_sanskrit": "ततस्त्रिगर्तः सधनुरवतीर्य महारथात्।\nगदया चतुरो वाहान्राज्ञस्तस् तदाऽवधीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029027, "chapter_id": 1634, "verse_number": "३-२७२-१३", "content_sanskrit": "तमथाभ्यागतं राजा पदातिं कुन्तिनन्दनः।\nअर्धचन्द्रेण बाणएन विव्याधोरसि धर्मराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029028, "chapter_id": 1634, "verse_number": "३-२७२-१४", "content_sanskrit": "स भिन्नहृदयो वीरो वक्राच्छोणितमुद्वमन्।\nपपाताभिमुखं प्राप्तश्चिन्नमूल इव द्रुमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029029, "chapter_id": 1634, "verse_number": "३-२७२-१५", "content_sanskrit": "इन्द्रसेनद्वितीयस्तु रथात्प्रस्कन्द्य धर्मराट्।\nहताश्वः सहदेवस्य प्रतिपेदे महारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029030, "chapter_id": 1634, "verse_number": "३-२७२-१६", "content_sanskrit": "नकुलं त्वभिसंवार्य क्षेमंकरमहामुखौ।\nउभावुभतस्तीक्ष्णैः शरवर्षैरवर्षताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029031, "chapter_id": 1634, "verse_number": "३-२७२-१७", "content_sanskrit": "तौ शरैरभिवर्षन्तौ जीमूताविव वार्षिकौ।\nएकैकेन विपाठेन जघ्ने माद्रवतीसुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029032, "chapter_id": 1634, "verse_number": "३-२७२-१८", "content_sanskrit": "त्रिगर्तराजः सुरथस्तस्याथ गजूर्गतः।\nरथमाक्षेपयामास गजेन गजयानवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029033, "chapter_id": 1634, "verse_number": "३-२७२-१९", "content_sanskrit": "नकुलस्त्वपभीस्तस्माद्रथाच्चर्मासिपाणिमान्।\nउद्धाम्य स्तानमास्थाय तस्थौ गिरिवाचलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029034, "chapter_id": 1634, "verse_number": "३-२७२-२०", "content_sanskrit": "सुरथस्तं गजवरं वधाय नकुलस्य तु।\nप्रेषयामास सक्रोधमत्युच्छ्रितकरं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029035, "chapter_id": 1634, "verse_number": "३-२७२-२१", "content_sanskrit": "नकुलस्तस्य नागस्य समीपपरिवर्तिनः।\nसविषाणं भुजं मूले खङ्गेन निरकृन्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029036, "chapter_id": 1634, "verse_number": "३-२७२-२२", "content_sanskrit": "स विनद्यमहानादं गजः किङ्किणिभूषणः।\nपतन्नवाक्शिरा भूमौ हस्त्यारोहमपोथयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029037, "chapter_id": 1634, "verse_number": "३-२७२-२३", "content_sanskrit": "स तत्कर्म महत्कृत्वा शूरो माद्रवतीसुतः।\nभीमसेनरथं प्राप्य शर्म लेभे महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029038, "chapter_id": 1634, "verse_number": "३-२७२-२४", "content_sanskrit": "भीमस्त्वापततो राज्ञः कोटिकाश्यस् संगरे।\nसूतस्य नुदतो वाहान्क्षुरेणापाहरच्छिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029039, "chapter_id": 1634, "verse_number": "३-२७२-२५", "content_sanskrit": "न बुबोध हतं सूतं स राजा बाहुशालिना।\nतस्याश्वा व्यद्रवन्सङ्ख्ये हतमसूतास्ततस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029040, "chapter_id": 1634, "verse_number": "३-२७२-२६", "content_sanskrit": "विरथं हतसूतं तं भीमः प्रहरतांवरः।\nजघान तलयुक्तेन प्रासेनाभ्येत्य पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029041, "chapter_id": 1634, "verse_number": "३-२७२-२७", "content_sanskrit": "द्वादशानां तु सर्वेषां सौवीराणां धनंजयः।\nचकर्त निशितैर्भल्लैर्धनूंषि च शिरांसि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029042, "chapter_id": 1634, "verse_number": "३-२७२-२८", "content_sanskrit": "शिबीनिक्ष्वाकुमुख्यांश्च त्रिगर्तान्सैन्धवानपि।\nजघानातिरथः सङ्ख्ये बाणगोचरमागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029043, "chapter_id": 1634, "verse_number": "३-२७२-२९", "content_sanskrit": "सूदिताः प्रत्यदृश्यन्त बहवः सव्यसाचिना।\nसपताकाश्च मातङ्गाः सध्वजाश्च महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029044, "chapter_id": 1634, "verse_number": "३-२७२-३०", "content_sanskrit": "प्रच्छाद्य पृथिवीं तस्थुः सर्वमायोधनं प्रति।\nशरीराण्यशिरस्कानि विदेहानि शिरांसि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2029045, "chapter_id": 1634, "verse_number": "३-२७२-३१", "content_sanskrit": "श्वगृध्रकङ्ककाकोलभासगोमायुवायसाः।\nअतृप्यंस्तत्रवीराणां हतानां मासशोणितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2029046, "chapter_id": 1634, "verse_number": "३-२७२-३२", "content_sanskrit": "`एवं तीक्ष्णशरज्वालैर्गाण्डीवानिलचोदितैः।\nसेनेन्धनं ददाहाशु सरोषः पार्थपावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2029047, "chapter_id": 1634, "verse_number": "३-२७२-३३", "content_sanskrit": "चक्राणां पतितानां च युगानां च महीपते।\nतूणीराणआं पताकानां ध्वजानां च रथैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2029048, "chapter_id": 1634, "verse_number": "३-२७२-३४", "content_sanskrit": "ईषाणामनुकर्षाणां त्रिवेणूनां तथैव च।\nअक्षाणामथ योक्राणां प्रतोदानां च राशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2029049, "chapter_id": 1634, "verse_number": "३-२७२-३५", "content_sanskrit": "शिरसां पतितानां च कुण्डलोष्णीषधारिणाम्।\nभुजानां मकुटानां च हाराणामङ्गदैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2029050, "chapter_id": 1634, "verse_number": "३-२७२-३६", "content_sanskrit": "छत्राणां व्यजनानां च चर्मणआं वर्मणां तथा।\nछिन्नानां कार्मुकाणां च पट्टसानां तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2029051, "chapter_id": 1634, "verse_number": "३-२७२-३७", "content_sanskrit": "शक्तीनामथ खङ्गानां दण्डानां सह तेमरैः।\nराशयश्चात्रदृश्यन्ते तत्रतत्र विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2029052, "chapter_id": 1634, "verse_number": "३-२७२-३८", "content_sanskrit": "पतितैश्चैव मातङ्गैः सयोधैः पर्वतोपमैः।\nहयैर्द्विधाकृतैः सार्धं सादिभिः सायुधैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2029053, "chapter_id": 1634, "verse_number": "३-२७२-३९", "content_sanskrit": "विप्रविद्धै रथैश्चैव निहतैश्चपदातिभिः।\nअगम्यरूपा पृथिवी मांसशोणितकर्दमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2029054, "chapter_id": 1634, "verse_number": "३-२७२-४०", "content_sanskrit": "हतेषु तेषु वीरेषु सिन्धुराजो जयद्रथः।\nविमुच्य कृष्णां संत्रस्तः पलायनपरोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2029055, "chapter_id": 1634, "verse_number": "३-२७२-४१", "content_sanskrit": "स तस्मिन्संकुले सैन्ये द्रौपदीमवतार्य ताम्।\nप्राणप्रेप्सुरुपाधावद्वनं तत्र नराधमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2029056, "chapter_id": 1634, "verse_number": "३-२७२-४२", "content_sanskrit": "द्रौपदीं धर्मराजस्तु दृष्ट्वा धौम्यपुरस्कृताम्।\nमाद्रीपुत्रेण वीरेण रथमारोपयत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2029057, "chapter_id": 1634, "verse_number": "३-२७२-४३", "content_sanskrit": "ततस्तद्विद्रुतं सैन्यमपयाते जयद्रथे।\nआदिश्यादिश्य नाराचैराजघान वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2029058, "chapter_id": 1634, "verse_number": "३-२७२-४४", "content_sanskrit": "सव्यसाची तु तं दृष्ट्वा पलायन्तं जयद्रथम्।\nवारयामास निघ्नन्तं भीमं सैन्धवसैनिकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2029059, "chapter_id": 1634, "verse_number": "३-२७२-४५x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2029060, "chapter_id": 1634, "verse_number": "३-२७२-४५", "content_sanskrit": "यस्यापचारात्प्राप्तोऽयमस्मान्क्लेशो दुरासदः।\nतमस्मिन्समरोद्देशे न पश्यामि जयद्रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2029061, "chapter_id": 1634, "verse_number": "३-२७२-४६", "content_sanskrit": "`मूढं नैकृतिकं दुष्टं द्रौपद्याः क्लेशकारिणम्।\nतमेवान्विष भद्रं ते किं ते योधैर्निपातितैः।\nअनामिषमिदं कर्म कथं वा मन्यते भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2029062, "chapter_id": 1634, "verse_number": "३-२७२-४७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2029063, "chapter_id": 1634, "verse_number": "३-२७२-४७", "content_sanskrit": "इत्युक्तो भीमसेनस्तु गुडाकेशेन धीमता।\nयुधिष्ठिरमभिप्रेत्य वाग्मी वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2029064, "chapter_id": 1634, "verse_number": "३-२७२-४८", "content_sanskrit": "हतप्रवीरा रिपवो भूयिष्ठं विद्रुता दिशः।\nगृहीत्वा द्रौपदीं राजन्निवर्ततु भवानितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2029065, "chapter_id": 1634, "verse_number": "३-२७२-४९", "content_sanskrit": "यमाभ्यां सह राजेन्द्र धौम्येन च महात्मना।\nप्राप्याश्रमपदं राजन्द्रौपदीं परिसान्त्वय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2029066, "chapter_id": 1634, "verse_number": "३-२७२-५०", "content_sanskrit": "न हि मे मोक्ष्यतेजीवन्मूढः सैन्धवको नृपः।\nपातालतलसंस्थोपि यदि शक्रोस्य सारथिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2029067, "chapter_id": 1634, "verse_number": "३-२७२-५१x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2029068, "chapter_id": 1634, "verse_number": "३-२७२-५१", "content_sanskrit": "न हन्तव्यो महाबाहो दुरात्माऽपिस सैन्धवः।\nदुःशलामभिसंस्मृत्य गान्धारीं च यशस्विनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2029069, "chapter_id": 1634, "verse_number": "३-२७२-५२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2029070, "chapter_id": 1634, "verse_number": "३-२७२-५२", "content_sanskrit": "तच्छ्रुत्वा द्रौपदी भीममुवाच व्याकुलेन्द्रिया।\nकुपिता ह्रीमती प्राज्ञा पती भीमार्जुनावुभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2029071, "chapter_id": 1634, "verse_number": "३-२७२-५३", "content_sanskrit": "कर्तव्यं चेत्प्रियं मह्यं वध्यः स पुरुषाधमः।\nसैन्धवापशदः पापो दुर्मतिः कुलपांसनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2029072, "chapter_id": 1634, "verse_number": "३-२७२-५४", "content_sanskrit": "भार्याभिहर्ता वैरी यो यश्च राज्यहरो रिपुः।\nयाचमानोऽपिसंग्रामे न मोक्तव्यः कथंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2029073, "chapter_id": 1634, "verse_number": "३-२७२-५५", "content_sanskrit": "इत्युक्तौ तौ नरव्याघ्रौ ययतुर्यत्र सैन्धवः।\nराजा निववृतेकृष्णामादाय सपुरोहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2029074, "chapter_id": 1634, "verse_number": "३-२७२-५६", "content_sanskrit": "स प्रविश्याश्रमपदमपविद्धवृसीकटम्।\nमार्कण्डेयादिभिर्विप्रैरनुकीर्णं ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2029075, "chapter_id": 1634, "verse_number": "३-२७२-५७", "content_sanskrit": "द्रौपदीमनुशोचद्भिर्ब्राह्मणैस्तैः समाहितैः।\nसमेयाय महाप्राज्ञः सभार्य भ्रातृमध्यगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2029076, "chapter_id": 1634, "verse_number": "३-२७२-५८", "content_sanskrit": "ते स्म तं मुदिता दृष्ट्वा पुनरप्यागतं नृपम्।\nजित्वा तान्सिनधुसौवीरान्द्रौपदीं चाहृतां पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2029077, "chapter_id": 1634, "verse_number": "३-२७२-५९", "content_sanskrit": "स तैः परिवृतो राजातत्रैवोपविवेश ह।\nप्रविवेशाश्रमं कृष्णा यमाभ्यां सह भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2029078, "chapter_id": 1634, "verse_number": "३-२७२-६०", "content_sanskrit": "भीमसेनार्जुनौ चापि श्रुत्वा क्रोशगतं रिपुम्।\nस्वयमश्वांस्तुदन्तौ तौ जवेनैवाभ्यधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2029079, "chapter_id": 1634, "verse_number": "३-२७२-६१", "content_sanskrit": "इदमत्यद्भुतं चात्र चकारातिरथोऽर्जुनः।\nक्रोशमात्रगतानश्वान्सैन्धवस्य जघान यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2029080, "chapter_id": 1634, "verse_number": "३-२७२-६२", "content_sanskrit": "स हि दिव्यास्त्रसंपन्नः कृच्छ्रकालेऽप्यसंभ्रमः।\nअकरोद्दुष्करं कर्म शरैरस्त्रानुमन्त्रितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2029081, "chapter_id": 1634, "verse_number": "३-२७२-६३", "content_sanskrit": "ततोऽभ्यधावतां वीरावुभौ भीमधनंजयौ।\nहताश्वं सैन्धवं भीतमेकं व्याकुलचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2029082, "chapter_id": 1634, "verse_number": "३-२७२-६४", "content_sanskrit": "सैन्धवस्तु हतान्दृष्ट्वा तथाऽश्वान्स्वान्सुदुःखितः।\n`रथात्प्रस्कन्द्य पद्भ्यां वै पलायनपरोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2029083, "chapter_id": 1634, "verse_number": "३-२७२-६५", "content_sanskrit": "दृष्ट्वा रविक्रमकर्माणि कुर्वाणं च धनंजयम्।\nपलायनकृतोत्साहः प्राद्रवद्येन वै वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2029084, "chapter_id": 1634, "verse_number": "३-२७२-६६", "content_sanskrit": "सैन्धवं त्वमिसंप्रेक्ष्यपराक्रान्तं पलायने।\nअनुयाय महाबाहुः फल्गुनो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2029085, "chapter_id": 1634, "verse_number": "३-२७२-६७", "content_sanskrit": "अनन वीर्येण कथं स्त्रियं प्रार्थयसे बलात्।\nराजपुत्र निवर्तस्व न ते युक्तं पलायनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2029086, "chapter_id": 1634, "verse_number": "३-२७२-६८", "content_sanskrit": "कथं ह्यनुचरान्हित्वा शत्रुमध्ये पलायसे।\nइत्युच्यमानः पार्थेन सैन्धवो न न्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2029087, "chapter_id": 1634, "verse_number": "३-२७२-६९", "content_sanskrit": "तिष्ठतिष्ठेति तं भीमः सहसाऽभ्यद्रवद्बली।\nमा वधीरिति पार्थस्तं दयावान्प्रत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2029088, "chapter_id": 1634, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि द्रौपदीहरणपर्वणि द्विसप्तत्यधिकद्विशततमोऽध्यायः ॥ २७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]