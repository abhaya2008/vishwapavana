[{"id": 7000496000, "chapter_id": 20496, "verse_number": "३-४३-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nयथा प्रयागस्य मुने माहात्म्यं कथितं त्वया ।\nतथातथा प्रमुच्येऽहं सर्वपापैर्न संशयः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000496001, "chapter_id": 20496, "verse_number": "३-४३-२", "content_sanskrit": "भगवन्केन विधिना गंतव्यं धर्मनिश्चयैः ।\nप्रयागे यो विधिः प्रोक्तः तन्मे ब्रूहि महामुने॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000496002, "chapter_id": 20496, "verse_number": "३-४३-३", "content_sanskrit": "मार्कंडेय उवाच ।\nकथयिष्यामि ते वत्स तीर्थयात्राविधिक्रमम् ।\nयो गच्छेतकुरुश्रेष्ठ प्रयागं देवसंयुतम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000496003, "chapter_id": 20496, "verse_number": "३-४३-४", "content_sanskrit": "बलीवर्दसमारूढः शृणु तस्यापि यत्फलम् ।\nवसते नरके घोरे गवां क्रोधे सुदारुणे॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000496004, "chapter_id": 20496, "verse_number": "३-४३-५", "content_sanskrit": "सलिलं च न गृह्णंति पितरस्तस्य देहिनः ।\nयस्तु पुत्रांस्तथा बालान्स्नापयेत्पाययेत्तथा॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000496005, "chapter_id": 20496, "verse_number": "३-४३-६", "content_sanskrit": "यथात्मनस्तथा सर्वान्दानं विप्रेषु दापयेत् ।\nऐश्वर्यलोभान्मोहाद्वा गच्छेद्यानेन यो नरः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000496006, "chapter_id": 20496, "verse_number": "३-४३-७", "content_sanskrit": "निष्फलं तस्य तत्तीर्थं तस्माद्यानं परित्यजेत् ।\nगंगायमुनयोर्मध्ये यस्तु कन्यां प्रयच्छति॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000496007, "chapter_id": 20496, "verse_number": "३-४३-८", "content_sanskrit": "आर्षेण तु विधानेन यथाविभवसंभवम् ।\nन पश्यति यमं घोरं नरकं तेन कर्मणा॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000496008, "chapter_id": 20496, "verse_number": "३-४३-९", "content_sanskrit": "उत्तरान्स कुरून्गत्वा मोदते कालमक्षयम् ।\nपुत्रांस्तु दारांल्लभते धार्मिकान्नयसंयुतान्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000496009, "chapter_id": 20496, "verse_number": "३-४३-१०", "content_sanskrit": "तत्र दानं प्रदातव्यं यथाविभवसंभवम् ।\nतेन तीर्थफलैनैव वर्द्धते नात्र संशयः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000496010, "chapter_id": 20496, "verse_number": "३-४३-११", "content_sanskrit": "स्वर्गे तिष्ठति राजेंद्र यावदाभूतसंप्लवम् ।\nवटमूलं समाश्रित्य यस्तु प्राणान्परित्यजेत्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000496011, "chapter_id": 20496, "verse_number": "३-४३-१२", "content_sanskrit": "सर्वलोकानतिक्रम्य रुद्रलोकं च गच्छति ।\nतत्र ते द्वादशादित्यास्तपंते रुद्रमाश्रिताः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000496012, "chapter_id": 20496, "verse_number": "३-४३-१३", "content_sanskrit": "निर्दहंति जगत्सर्वं वटमूलं न दह्यते ।\nनष्टचंद्रार्कपवनं यदा चैकार्णवं जगत्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000496013, "chapter_id": 20496, "verse_number": "३-४३-१४", "content_sanskrit": "स्वपित्यत्रैव वै विष्णुर्जायमानः पुनः पुनः ।\nदेवदानवगंधर्व ऋषयः सिद्धचारणाः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000496014, "chapter_id": 20496, "verse_number": "३-४३-१५", "content_sanskrit": "सदा सेवंति तत्तीर्थं गंगायमुनसंगमे ।\nतत्र गच्छंति राजेंद्र प्रयागे संयुतं च यत्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000496015, "chapter_id": 20496, "verse_number": "३-४३-१६", "content_sanskrit": "तत्र ब्रह्मादयो देवा दिशश्चैव दिगीश्वराः ।\nलोकपालाश्च साध्याश्च पितरो लोकसंमताः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000496016, "chapter_id": 20496, "verse_number": "३-४३-१७", "content_sanskrit": "सनत्कुमारप्रमुखास्तथैव परमर्षयः ।\nअंगिरप्रमुखाश्चैव तथा ब्रह्मर्षयः परे॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000496017, "chapter_id": 20496, "verse_number": "३-४३-१८", "content_sanskrit": "तथा नागाश्च सिद्धाश्च सुपर्णाः खेचराश्च ये ।\nसरितः सागराः शैला नागा विद्याधरास्तथा॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000496018, "chapter_id": 20496, "verse_number": "३-४३-१९", "content_sanskrit": "हरिश्च भगवानास्ते प्रजापतिपुरस्कृतः ।\nगंगायमुनयोर्मध्ये पृथिव्या जघनं स्मृतम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000496019, "chapter_id": 20496, "verse_number": "३-४३-२०", "content_sanskrit": "प्रयागं राजशार्दूल त्रिषुलोकेषु विश्रुतम् ।\nततः पुण्यतमं नास्ति त्रिषुलोकेषु भारत॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000496020, "chapter_id": 20496, "verse_number": "३-४३-२१", "content_sanskrit": "श्रवणात्तस्य तीर्थस्य नामसंकीर्तनादपि ।\nमृत्तिका लंभनाद्वापि नरः पापात्प्रमुच्यते॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000496021, "chapter_id": 20496, "verse_number": "३-४३-२२", "content_sanskrit": "तत्राभिषेकं यः कुर्य्यात्संगमे संशितव्रतः ।\nतुल्यं फलमवाप्नोति राजसूयाश्वमेधयोः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000496022, "chapter_id": 20496, "verse_number": "३-४३-२३", "content_sanskrit": "न वेदवचनात्तात न लोकवचनादपि ।\nमतिरुत्क्रमणीया ते प्रयागगमनं प्रति॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000496023, "chapter_id": 20496, "verse_number": "३-४३-२४", "content_sanskrit": "दशतीर्थसहस्राणि षष्टिकोट्यस्तथापराः ।\nयेषां सान्निध्यमत्रैव कीर्तनात्कुरुनंदन॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000496024, "chapter_id": 20496, "verse_number": "३-४३-२५", "content_sanskrit": "या गतिर्योगयुक्तस्य सदुत्थस्य मनीषिणः ।\nसा गतिस्त्यजतः प्राणान्गंगायमुनसंगमे॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000496025, "chapter_id": 20496, "verse_number": "३-४३-२६", "content_sanskrit": "तेन जीवंति लोकेऽस्मिन्यत्र यत्र युधिष्ठिर ।\nये प्रयागं न संप्राप्तास्त्रिषु लोकेषु विश्रुतम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000496026, "chapter_id": 20496, "verse_number": "३-४३-२७", "content_sanskrit": "एवं दृष्ट्वा तु तत्तीर्थं प्रयागं परमं पदम् ।\nमुच्यते सर्वपापेभ्यः शशांक इव राहुणा॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000496027, "chapter_id": 20496, "verse_number": "३-४३-२८", "content_sanskrit": "कंबलाश्वतरौ नागौ यमुना दक्षिणे तटे ।\nतत्र स्नात्वा च पीत्वा च मुच्यते सर्वपातकैः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000496028, "chapter_id": 20496, "verse_number": "३-४३-२९", "content_sanskrit": "तत्र गत्वा तु तत्स्थानं महादेवस्य धीमतः ।\nनरस्तारयते सर्वान्दशातीतान्दशापरान्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000496029, "chapter_id": 20496, "verse_number": "३-४३-३०", "content_sanskrit": "कृत्वाभिषेकं तु नरः सोऽश्वमेधफलं लभेत् ।\nस्वर्गलोकमवाप्नोति यावदाभूतसंप्लवम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000496030, "chapter_id": 20496, "verse_number": "३-४३-३१", "content_sanskrit": "पूर्वपार्श्वे तु गंगायां त्रिषु लोकेषु भारत ।\nकूपं चैव तु सामुद्रं प्रतिष्ठानं तु विश्रुतम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000496031, "chapter_id": 20496, "verse_number": "३-४३-३२", "content_sanskrit": "ब्रह्मचारी जितक्रोधस्त्रिरात्रं यदि तिष्ठति ।\nसर्वपापविशुद्धात्मा सोऽश्वमेधफलं लभेत्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000496032, "chapter_id": 20496, "verse_number": "३-४३-३३", "content_sanskrit": "उत्तरेण प्रतिष्ठानाद्भागीरथ्यास्तु पूर्वतः ।\nहंसप्रपतनं नाम तीर्थं त्रैलोक्यविश्रुतम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000496033, "chapter_id": 20496, "verse_number": "३-४३-३४", "content_sanskrit": "अश्वमेधफलं तस्मिन्स्नातमात्रस्य भारत ।\nयावच्चन्द्रश्च सूर्यश्च तावत्स्वर्गे महीयते॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000496034, "chapter_id": 20496, "verse_number": "३-४३-३५", "content_sanskrit": "उर्वशीपुलिने रम्ये विपुले हंसपांडुरे ।\nसलिलैस्तर्प्पयेद्यस्तु पितॄंस्तत्र विमत्सरः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000496035, "chapter_id": 20496, "verse_number": "३-४३-३६", "content_sanskrit": "षष्टिवर्षसहस्राणि षष्टिवर्षशतानि च ।\nसेवते पितृभिः सार्द्धं स्वर्गलोकं नराधिप॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000496036, "chapter_id": 20496, "verse_number": "३-४३-३७", "content_sanskrit": "पूज्यते सततं तत्र ऋषिगंधर्वकिन्नरैः ।\nततः स्वर्गपरिभ्रष्टः क्षीणकर्म्मा दिवश्च्युतः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000496037, "chapter_id": 20496, "verse_number": "३-४३-३८", "content_sanskrit": "उर्वशीसदृशीनां तु कन्यानां लभते शतम् ।\nगवां शतसहस्राणां भोक्ता भवति भूमिप॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000496038, "chapter_id": 20496, "verse_number": "३-४३-३९", "content_sanskrit": "कांचीनूपुरशब्देन सुप्तोऽसौ प्रतिबुध्यते ।\nभुक्त्वा तु विपुलान्भोगांस्तत्तीर्थं लभते पुनः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000496039, "chapter_id": 20496, "verse_number": "३-४३-४०", "content_sanskrit": "कुशासनधरो नित्यं नियतः संयतेंद्रियः ।\nएककालं तु भुंजानो मासं भोगपतिर्भवेत्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000496040, "chapter_id": 20496, "verse_number": "३-४३-४१", "content_sanskrit": "सुवर्णालंकृतानां तु नारीणां लभते शतम् ।\nपृथिव्यामासमुद्रायां महाभोगपतिर्भवेत्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000496041, "chapter_id": 20496, "verse_number": "३-४३-४२", "content_sanskrit": "दशग्रामसहस्राणां भोक्ता भवति भूमिपः ।\nधनधान्यसमायुक्तो दाता भवति नित्यशः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000496042, "chapter_id": 20496, "verse_number": "३-४३-४३", "content_sanskrit": "स भुक्त्वा विपुलान्भोगांस्तत्तीर्थं स्मरते पुनः ।\nअथ तस्मिन्वटे रम्ये ब्रह्मचारी जितेंद्रियः॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000496043, "chapter_id": 20496, "verse_number": "३-४३-४४", "content_sanskrit": "उपोष्य योगयुक्तश्च ब्रह्मज्ञानमवाप्नुयात् ।\nकोटितीर्थं समासाद्य यस्तु प्राणान्परित्यजेत्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000496044, "chapter_id": 20496, "verse_number": "३-४३-४५", "content_sanskrit": "कोटिवर्षसहस्राणि स्वर्गलोके महीयते ।\nततः स्वर्गात्परिभ्रष्टः क्षीणकर्म्मा दिवश्च्युतः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000496045, "chapter_id": 20496, "verse_number": "३-४३-४६", "content_sanskrit": "सुवर्णमणिमुक्ताढ्ये कुले भवति रूपवान् ।\nततो भोगवतीं गत्वा वासुकेरुत्तरेण तु॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000496046, "chapter_id": 20496, "verse_number": "३-४३-४७", "content_sanskrit": "दशाश्वमेधकं तत्र तीर्थं तत्रापरं भवेत् ।\nकृत्वाभिषेकं तु नरः सोऽश्वमेधफलं लभेत्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000496047, "chapter_id": 20496, "verse_number": "३-४३-४८", "content_sanskrit": "धनाढ्यो रूपवान्दक्षो दाता भवति धार्मिकः ।\nचतुर्वेदेषु यत्पुण्यं सत्यवादिषु यत्फलम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000496048, "chapter_id": 20496, "verse_number": "३-४३-४९", "content_sanskrit": "अहिंसायां तु यो धर्म्मो गमनादेव तद्भवेत् ।\nकुरुक्षेत्रसमा गंगा यत्रतत्रावगाह्यते॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000496049, "chapter_id": 20496, "verse_number": "३-४३-५०", "content_sanskrit": "कुरुक्षेत्राद्दशगुणा यत्र सिंध्वा समागता ।\nयत्र गंगा महाभागा बहुतीर्थतपोधना॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000496050, "chapter_id": 20496, "verse_number": "३-४३-५१", "content_sanskrit": "सिद्धक्षेत्रं हि तज्ज्ञेयं नात्र कार्या विचारणा ।\nक्षितौ तारयते मर्त्यान्नागांस्तारयतेऽप्यधः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000496051, "chapter_id": 20496, "verse_number": "३-४३-५२", "content_sanskrit": "दिवि तारयते देवांस्तेन सा त्रिपथा स्मृता ।\nयावदस्थीनि गंगायां तिष्ठंति तस्य देहिनः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000496052, "chapter_id": 20496, "verse_number": "३-४३-५३", "content_sanskrit": "तावद्वर्षसहस्राणि स्वर्गलोके महीयते ।\nतीर्थानां तु परं तीर्थं नदीनामुत्तमा नदी॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000496053, "chapter_id": 20496, "verse_number": "३-४३-५४", "content_sanskrit": "मोक्षदा सर्वभूतानां महापातकिनामपि ।\nसर्वत्र सुलभा गंगा त्रिषु स्थानेषु दुर्लभा॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000496054, "chapter_id": 20496, "verse_number": "३-४३-५५", "content_sanskrit": "गंगाद्वारे प्रयागे च गंगासागरसंगमे ।\nतत्र स्नात्वा दिवं यांति ये मृतास्तेऽपुनर्भवाः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000496055, "chapter_id": 20496, "verse_number": "३-४३-५६", "content_sanskrit": "सर्वेषां चैव भूतानां पापोपहतचेतसाम् ।\nगतिमन्वेषमाणानां नास्ति गंगासमा गतिः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000496056, "chapter_id": 20496, "verse_number": "३-४३-५७", "content_sanskrit": "पवित्राणां पवित्रं या मंगलानां च मंगलम् ।\nमहेश्वरशिरोभ्रष्टा सर्वपापहरा शुभा॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]