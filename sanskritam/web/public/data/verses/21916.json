[{"id": 7001916000, "chapter_id": 21916, "verse_number": "९५-१", "content_sanskrit": "मार्कण्डेय उवाच ।\nततस्तस्मान्नदीमध्यात्समुत्तस्थौ मनोरमा ।\nप्रम्लोचा नाम तन्वङ्गी तत्समीपे वराप्सराः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001916001, "chapter_id": 21916, "verse_number": "९५-२", "content_sanskrit": "सा चोवाच महात्मानं रुचिं सुमधुराक्षरम् ।\nप्रश्रयावनता सुभूः प्रम्लोचा वै वराप्सराः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001916002, "chapter_id": 21916, "verse_number": "९५-३", "content_sanskrit": "अतीव रूपिणी कन्या मत्सुता तपतां वर ।\nजाता वरुणपुत्रेण पुष्करेण महात्मना ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001916003, "chapter_id": 21916, "verse_number": "९५-४", "content_sanskrit": "तां गृहाण मया दत्तां भार्यार्थे वरवर्णिनीम् ।\nमनुर्महामतिस्तस्यां समुत्पस्यति ते सुतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001916004, "chapter_id": 21916, "verse_number": "९५-५", "content_sanskrit": "मार्कण्डेय उवाच ।\nतथेति तेन साऽप्युक्ता तस्मात्तोयाद्वपुष्मतीम् ।\nउज्जहार ततः कन्यां मालिनी नाम नामतः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001916005, "chapter_id": 21916, "verse_number": "९५-६", "content_sanskrit": "नद्याश्च पुलिने तस्मिन्स रुचिर्मुनिसत्तमः ।\nजग्राह पाणिं विधिवत्समानाय्य महामुनीन् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001916006, "chapter_id": 21916, "verse_number": "९५-७", "content_sanskrit": "तस्यां तस्य सुतो जज्ञे महावीर्यो महामतिः ।\nरौच्योऽभवत्पितुर्नाम्ना ख्यातोऽत्र वसुधातले ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001916007, "chapter_id": 21916, "verse_number": "९५-८", "content_sanskrit": "तस्य मन्वन्तरे देवास्तथा सप्तर्षयश्च ये ।\nतनयाश्च नृपाश्चैव ते सम्यक्कथितास्तव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001916008, "chapter_id": 21916, "verse_number": "९५-९", "content_sanskrit": "धर्मवृद्धिस्तथारोग्यं धनधान्यसुतोद्भवः ।\nनृणां भवत्यसन्दिग्धमस्मिन्मन्वन्तरे श्रुते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001916009, "chapter_id": 21916, "verse_number": "९५-१०", "content_sanskrit": "पितृस्तवं तथा श्रुत्वा पितॄणां च तथा गणान् ।\nसर्वान्कामानवाप्नोति तत्प्रसादान्महामुने ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]