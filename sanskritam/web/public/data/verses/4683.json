[{"id": 2172909, "chapter_id": 4683, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2172910, "chapter_id": 4683, "verse_number": "१", "content_sanskrit": "तत् प्रभग्नं बलं दृष्ट्वा तावका भरतर्षभ ।\nमद्रराजं पुरस्कृत्य जग्मुर्युद्धाय भारत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2172911, "chapter_id": 4683, "verse_number": "२", "content_sanskrit": "मद्रराजो महाराज सारथिं वाक्यमब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2172912, "chapter_id": 4683, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2172913, "chapter_id": 4683, "verse_number": "३", "content_sanskrit": "एष तिष्ठति वै राजा पाण्डुपुत्रो युधिष्ठिरः ।\nछत्रेण ध्रियमाणेन पाण्डुरेण विराजता\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2172914, "chapter_id": 4683, "verse_number": "४", "content_sanskrit": "तत्र मां प्रापय क्षिप्रं सारथे पश्य मे बलम् ।\nन समर्थास्तु मे पार्थाः स्थातुमद्याग्रतो युधि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2172915, "chapter_id": 4683, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2172916, "chapter_id": 4683, "verse_number": "५", "content_sanskrit": "एवमुक्तस्ततः प्रायान्मद्रराजस्य सारथिः ।\nयत्र राजा धर्मपुत्रः सत्यसन्धो युधिष्ठिरः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2172917, "chapter_id": 4683, "verse_number": "६", "content_sanskrit": "आपतत् तच्च सहसा पाण्डवानां महद्बलम् ।\nदधारैको रणे शल्यो वेलेवोद्वृत्तमर्णवम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2172918, "chapter_id": 4683, "verse_number": "७", "content_sanskrit": "पाण्डवानां बलौघस्तु शल्यमासाद्य मारिष ।\nव्यतिष्ठत तदा युद्धे सिन्धोर्वेग इवाचलम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2172919, "chapter_id": 4683, "verse_number": "८", "content_sanskrit": "मद्रराजं तु समरे दृष्ट्वा युद्धाय विष्ठितम् ।\nकुरवः सन्न्यवर्तन्त मृत्युं कृत्वा निवर्तनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2172920, "chapter_id": 4683, "verse_number": "९", "content_sanskrit": "तेषु राजन्निवृत्तेषु व्यूढानीकेषु भागशः ।\nप्रावर्तत महारौद्रः सङ्ग्रामः शोणितोदकः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2172921, "chapter_id": 4683, "verse_number": "१०", "content_sanskrit": "सङ्गतश्चित्रसेनेन नकुलो युद्धदुर्मदः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2172922, "chapter_id": 4683, "verse_number": "११", "content_sanskrit": "तौ परस्परमासाद्य चित्रकार्मुकयोधिनौ ।\nमेघाविव यथोद्वृत्तौ दक्षिणोत्तरवर्षिणौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2172923, "chapter_id": 4683, "verse_number": "१२", "content_sanskrit": "शरतोयैः सिषिचतुः तौ परस्परमाहवे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2172924, "chapter_id": 4683, "verse_number": "१३", "content_sanskrit": "नान्तरं तत्र पश्यामः पाण्डवस्येतरस्य वा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2172925, "chapter_id": 4683, "verse_number": "१४", "content_sanskrit": "उभौ कृतास्त्रौ बलिनौ रथचर्याविशारदौ ।\nपरस्परवधे युक्तौ छिद्रान्वेषणतत्परौ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2172926, "chapter_id": 4683, "verse_number": "१५", "content_sanskrit": "चित्रसेनस्तु भल्लेन पीतेन निशितेन च ।\nनकुलस्य महाराज मुष्टिदेशेऽच्छिनद्धनुः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2172927, "chapter_id": 4683, "verse_number": "१६", "content_sanskrit": "अथैनं छिन्नधन्वानं रुग्मपुङ्खैः शिलाशितैः ।\nत्रिभिः शरैरसम्भ्रान्तो ललाटे वै समर्पयत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2172928, "chapter_id": 4683, "verse_number": "१७", "content_sanskrit": "हयांश्चास्य शरैस्तीक्ष्णैः प्रेषयामास मृत्यवे ।\nतथा ध्वजं सारथिं च त्रिभिस्त्रिभिरताडयत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2172929, "chapter_id": 4683, "verse_number": "१८", "content_sanskrit": "स शत्रुभुजनिर्मुक्तैः ललाटस्थैस्त्रिभिः शरैः ।\nनकुलः शुशुभे राजन् त्रिशृङ्ग इव पर्वतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2172930, "chapter_id": 4683, "verse_number": "१९", "content_sanskrit": "सञ्छिन्नधन्वा विरथः खड्गमादाय चर्म च ।\nरथादवातरद् वीरः शैलाग्रादिव केसरी\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2172931, "chapter_id": 4683, "verse_number": "२०", "content_sanskrit": "पद्भ्यामापततस्तस्य शरवृष्टिमवासृजत् ।\nनकुलोऽप्यग्रहीत् तां वै चर्मणा लघुविक्रमः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2172932, "chapter_id": 4683, "verse_number": "२१", "content_sanskrit": "चित्रसेनरथं प्राप्य चित्रयोधी जितश्रमः ।\nआरुरोह महाबाहुः सर्वसैन्यस्य पश्यतः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2172933, "chapter_id": 4683, "verse_number": "२२", "content_sanskrit": "सकुण्डलं समकुटं सुनासं स्वायतेक्षणम् ।\nचित्रसेनशिरः कायाद् अपाहरत पाण्डवः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2172934, "chapter_id": 4683, "verse_number": "२३", "content_sanskrit": "स पपात रथोपस्थाद् दिवाकरसमप्रभः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2172935, "chapter_id": 4683, "verse_number": "२४", "content_sanskrit": "चित्रसेनशिरस्तत् तु दृष्ट्वा तत्र महारथाः ।\nसिंहनादस्वनांश्चक्रुः साधुवादांश्च पुष्कलान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2172936, "chapter_id": 4683, "verse_number": "२५", "content_sanskrit": "विशस्तं भ्रातरं दृष्ट्वा कर्णपुत्रौ महारथौ ।\nसुशर्मा सत्यसेनश्च मुञ्चन्तौ निशितान् शरान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2172937, "chapter_id": 4683, "verse_number": "२६", "content_sanskrit": "ततोऽभ्यधावतां तूर्णं पाण्डवं रथिनां वरम् ।\nजिघांसन्तौ यथानागं व्याघ्रौ राजन् महावने\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2172938, "chapter_id": 4683, "verse_number": "२७", "content_sanskrit": "तावभ्यवर्षतां तीक्ष्णैः द्वावप्येनं महारथौ ।\nशरौघान् सम्यगस्यन्तौ जीमूतौ सलिलं यथा\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2172939, "chapter_id": 4683, "verse_number": "२८", "content_sanskrit": "स शरैः सर्वतो विद्धः प्रहृष्टः इव पाण्डवः ।\nअन्यत् कार्मुकमादाय रथमारुह्य वीर्यवान्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2172940, "chapter_id": 4683, "verse_number": "२९", "content_sanskrit": "अतिष्ठत रणे वीरः क्रुद्धरूप इवान्तकः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2172941, "chapter_id": 4683, "verse_number": "३०", "content_sanskrit": "तौ तस्य भ्रातरौ वीरौ शरैः सन्नतपर्वभिः ।\nरथं विशकलीकर्तुं समारब्धौ विशाम्पते\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2172942, "chapter_id": 4683, "verse_number": "३१", "content_sanskrit": "ततः प्रसह्य नकुलः चतुर्भिश्चतुरो हयान् ।\nजघान निशितैर्बाणैः सत्यसेनस्य संयुगे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2172943, "chapter_id": 4683, "verse_number": "३२", "content_sanskrit": "ततः सन्धाय नाराचं रुग्मपुङ्खं शिलाशितम् ।\nधनुश्चिच्छेद राजेन्द्र सत्यसेनस्य पाण्डवः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2172944, "chapter_id": 4683, "verse_number": "३३", "content_sanskrit": "अथान्यं रथमास्थाय धनुरादाय चापरम् ।\nसत्यसेनः सुशर्मा च पाण्डवं पर्यधावताम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2172945, "chapter_id": 4683, "verse_number": "३४", "content_sanskrit": "अविध्यत् तावसम्भ्रान्तौ माद्रीपुत्रश्च वीर्यवान् ।\nद्वाभ्यां द्वाभ्यां महाराज शराभ्यां रणमूर्धनि\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2172946, "chapter_id": 4683, "verse_number": "३५", "content_sanskrit": "सुशर्मा तु ततः क्रुद्धः पाण्डवस्य महद्धनुः ।\nचिच्छेद प्रहसन् युद्धे क्षुरप्रेण महारथः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2172947, "chapter_id": 4683, "verse_number": "३६", "content_sanskrit": "अथान्यद्धनुरादाय नकुलः क्रोधमूर्च्छितः ।\nसुशर्माणं त्रिभिर्विद्ध्वा ध्वजमेकेन चिच्छिदे\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2172948, "chapter_id": 4683, "verse_number": "३८", "content_sanskrit": "सत्यसेनस्य च धनुर्हस्तावापं च मारिष ।\nचिच्छेद तरसा युद्धे तत उच्चुक्रुशुर्जनाः\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2172949, "chapter_id": 4683, "verse_number": "३९", "content_sanskrit": "अथान्यद्धनुरादाय शत्रुघ्नं भारसाधनम् ।\nशरैः सञ्छादयामास समन्तात् पाण्डुनन्दनम्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2172950, "chapter_id": 4683, "verse_number": "४०", "content_sanskrit": "सन्निवार्य तु तान् बाणान् नकुलः परवीरहा ।\nसत्यसेनसुशर्माणौ द्वाभ्यां द्वाभ्यामविध्यत\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2172951, "chapter_id": 4683, "verse_number": "४१", "content_sanskrit": "तावेनं प्रत्यविध्येतां पृथक् पृथगजिह्मगैः ।\nसारथिं चास्य राजेन्द्र शरैर्विव्यथतुः शितैः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2172952, "chapter_id": 4683, "verse_number": "४२", "content_sanskrit": "सत्यसेनो रथेषां तु नकुलस्य धनुस्तदा ।\nपृथक् शराभ्यां चिच्छेद कृतहस्तः प्रतापवान्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2172953, "chapter_id": 4683, "verse_number": "४३", "content_sanskrit": "स रथेऽतिरथस्तिष्ठन् रथशक्तिं परामृशन् ।\nस्वर्णदण्डामकुण्ठाग्रां तैलधौतां सुनिर्मलाम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2172954, "chapter_id": 4683, "verse_number": "४४", "content_sanskrit": "लेलिहानां महाबाहो नागकन्यां महाविषाम् ।\nसमुद्यम्य प्रचिक्षेप सत्यसेनस्य संयुगे\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2172955, "chapter_id": 4683, "verse_number": "४५", "content_sanskrit": "सा तस्य हृदयं सङ्खे बिभेद शतधा नृप ।\nस पपात रथाद् भूमिं गतसत्त्वोऽल्पचेतनः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2172956, "chapter_id": 4683, "verse_number": "४६", "content_sanskrit": "भ्रातरं निहतं दृष्ट्वा सुशर्मा क्रोधमूर्च्छितः ।\nअभ्यवर्षच्छरैस्तूर्णं पदातिं पाण्डुनन्दनम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2172957, "chapter_id": 4683, "verse_number": "४७", "content_sanskrit": "नकुलं विरथं दृष्ट्वा द्रौपदेयो महारथः ।\nश्रुतसोमोऽभिदुद्राव परीप्सन् पितरं रणे\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2172958, "chapter_id": 4683, "verse_number": "४८", "content_sanskrit": "ततोऽधिरुह्य नकुलः श्रुतसोमस्य तं रथम् ।\nशुशुभे भरतश्रेष्ठो गिरिस्थ इव केसरी\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2172959, "chapter_id": 4683, "verse_number": "४९", "content_sanskrit": "सोऽन्यत् कार्मुकमादाय सुशर्माणमयोधयत्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2172960, "chapter_id": 4683, "verse_number": "५०", "content_sanskrit": "तावुभौ शरवर्षाभ्यां समासाद्य परस्परम् ।\nपरस्परवधे यत्नं चक्रतुः सुमहारथौ\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2172961, "chapter_id": 4683, "verse_number": "५१", "content_sanskrit": "सुशर्मा तु सुसङ्क्रुद्धः पाण्डवं विशिखैस्त्रिभिः ।\nश्रुतसोमं च विंशत्या बाह्वोरुरसि चार्पयत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2172962, "chapter_id": 4683, "verse_number": "५२", "content_sanskrit": "ततः क्रुद्धो महाराज नकुलः परवीरहा ।\nशरैस्तस्य दिशः सर्वान् छादयामास वीर्यवान्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2172963, "chapter_id": 4683, "verse_number": "५३", "content_sanskrit": "ततो गृहीत्वा तीक्ष्णाग्रमर्धचन्द्रं सुतेजनम् ।\nसवेगयुक्तं चिक्षेप कर्णपुत्रस्य संयुगे\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2172964, "chapter_id": 4683, "verse_number": "५४", "content_sanskrit": "तस्य तेन शिरः कायाद् जहार नृपसत्तम ।\nपश्यतां सर्वसैन्यानां तदद्भुतमिवाभवत्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2172965, "chapter_id": 4683, "verse_number": "५५", "content_sanskrit": "स हतः प्रापतद् राजन् नकुलेन महात्मना ।\nनदीवेगाद् यथा भग्नस्तीरजः पादपो महान्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2172966, "chapter_id": 4683, "verse_number": "५६", "content_sanskrit": "कर्णपुत्रवधं दृष्ट्वा नकुलस्य च विक्रमम् ।\nप्रदुद्राव भयात् सेना तावकी भरतर्षभ\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2172967, "chapter_id": 4683, "verse_number": "५७", "content_sanskrit": "तां तु सेनां महाराज मद्रराजः प्रतापवान् ।\nअपालयद् रणे शूरः सेनापतिररिन्दमः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2172968, "chapter_id": 4683, "verse_number": "५८", "content_sanskrit": "विभीस्तस्थौ महाराज व्यवस्थाप्य च वाहिनीम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2172969, "chapter_id": 4683, "verse_number": "५९", "content_sanskrit": "सिंहनादं भृशं कृत्वा धनुःशब्दं च दारुणम् ।\nतावकाः समरे राजन् रक्षिता दृढधन्व(न्वि)ना\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2172970, "chapter_id": 4683, "verse_number": "६०", "content_sanskrit": "प्रत्युद्ययुररीन् सर्वान् समन्ताद् विगतव्यथाः ।\nमद्रराजं महेष्वासं परिवार्य समन्ततः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2172971, "chapter_id": 4683, "verse_number": "६१", "content_sanskrit": "स्थिता राजन् महासेना योद्धुकामा समन्ततः ।\nसात्यकिर्भीमसेनश्च माद्रीपुत्रौ च पाण्डवौ\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2172972, "chapter_id": 4683, "verse_number": "६२", "content_sanskrit": "युधिष्ठिरं पुरस्कृत्य ह्रीनिषेधमरिन्दमम् ।\nपरिवार्य महेष्वासाः सिंहनादं प्रचक्रिरे\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2172973, "chapter_id": 4683, "verse_number": "६३", "content_sanskrit": "बाणशङ्खरवांश्चोग्रान् क्ष्वेलांश्च विविधान् दधुः\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2172974, "chapter_id": 4683, "verse_number": "६४", "content_sanskrit": "तथैव तावकाः सर्वे मद्राधिपतिमञ्जसा ।\nपरिवार्य सुसंरब्धाः पुनर्युद्धमरोचयन्\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2172975, "chapter_id": 4683, "verse_number": "६५", "content_sanskrit": "ततः प्रववृते युद्धं भीरूणां भयवर्धनम् ।\nतावकानां परेषां च मृत्युं कृत्वा निवर्तनम्\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2172976, "chapter_id": 4683, "verse_number": "६६", "content_sanskrit": "यथा दैवासुरं युद्धं पूर्वमासीद् विशाम्पते ।\nअभीतानां तदा राजन् यमराष्ट्रविवर्धनम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2172977, "chapter_id": 4683, "verse_number": "६७", "content_sanskrit": "ततः कपिध्वजो राजन् हत्वा संशप्तकान् रणे ।\nअभ्यद्रवत तां सेनां कौरवीं पाण्डुनन्दनः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2172978, "chapter_id": 4683, "verse_number": "६८", "content_sanskrit": "तथैव पाण्डवाः शेषाः धृष्टद्युम्नपुरोगमाः ।\nअभ्यधावन्त तां सेनां विसृजन्तः शितान् शरान्\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2172979, "chapter_id": 4683, "verse_number": "६९", "content_sanskrit": "पाण्डवैरभिकीर्णानां सम्मोहः समजायत ।\nन विजानन्त्यनीकानि दिशो वा प्रदिशस्तथा\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2172980, "chapter_id": 4683, "verse_number": "७०", "content_sanskrit": "आपूर्यमाणानि शितैः शरैः पाण्डवचोदितैः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2172981, "chapter_id": 4683, "verse_number": "७१", "content_sanskrit": "हतप्रवीरा विध्वस्ता कीर्यमाणाः समन्ततः ।\nकौरव्याऽवध्यत चमूः पाण्डुपुत्रैर्महारथैः\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2172982, "chapter_id": 4683, "verse_number": "७२", "content_sanskrit": "तथैव पाण्डवी सेना शरैः राजन् समन्ततः ।\nरणेऽहन्यत पुत्रैस्ते शतशोऽथ सहस्रशः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2172983, "chapter_id": 4683, "verse_number": "७३", "content_sanskrit": "ते सेने भृशसन्तप्ते वध्यमाने परस्परम् ।\nव्याकुले समपद्येतां वर्षासु सरिताविव\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2172984, "chapter_id": 4683, "verse_number": "७४", "content_sanskrit": "द्रवमाणेषु सैन्येषु विनदत्सु च दन्तिषु\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2172985, "chapter_id": 4683, "verse_number": "७५", "content_sanskrit": "कूजतां स्तनतां चापि पदातीनां महाहवे\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2172986, "chapter_id": 4683, "verse_number": "७६", "content_sanskrit": "विद्रुतेषु महाराज हयेषु बहुधा तदा ।\nसङ्क्षये दारुणे जाते सङ्गरे सर्वदेहिनाम्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2172987, "chapter_id": 4683, "verse_number": "७७", "content_sanskrit": "नानाशस्त्रसमावापे व्यतिषक्तरथद्विपे ।\nहर्षणे युद्धशौण्डानां भीरूणां भयवर्धने\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2172988, "chapter_id": 4683, "verse_number": "७८", "content_sanskrit": "गाहमानेषु योधेषु परस्परवधैषिषु ।\nप्राणादेषु महाघोरे वर्तमाने दुरोदरे\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2172989, "chapter_id": 4683, "verse_number": "७९", "content_sanskrit": "सङ्ग्रामे घोररूपे तु यमराष्ट्रविवर्धने ।\nपाण्डवास्तावकं सैन्यं व्यधमन् निशितैः शरैः\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2172990, "chapter_id": 4683, "verse_number": "८०", "content_sanskrit": "तथैव तावका योधा जघ्नुः पाण्डवसैनिकान् ।\nतस्मिंस्तथा वर्तमाने युद्धे भीरुभयङ्करे\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2172991, "chapter_id": 4683, "verse_number": "८१", "content_sanskrit": "पूर्वाह्णे चापि सम्प्राप्ते भास्करोदयनं प्रति ।\nलब्धलक्षाः परे राजन् रक्षिताश्च महात्मभिः\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2172992, "chapter_id": 4683, "verse_number": "८२", "content_sanskrit": "अयोधयंस्तव बलं मृत्युं कृत्वा निवर्तनम् ।\nबलिभिः पाण्डवैर्दृप्तैः लब्धलक्षैः प्रहारिभिः\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2172993, "chapter_id": 4683, "verse_number": "८३", "content_sanskrit": "कौरव्यसीदत्पृतना गौरिवाग्निसमाकुला ।\nतां दृष्ट्वा सीदतीं सेनां पङ्कगामिव दुर्बलाम्\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2172994, "chapter_id": 4683, "verse_number": "८४", "content_sanskrit": "उज्जिहीर्षुस्तदा शल्यः प्रदुद्राव चमूपतिः ।\nमद्रराजस्तु सङ्क्रुद्धो गृहीत्वा धनुरुत्तमम्\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2172995, "chapter_id": 4683, "verse_number": "८५", "content_sanskrit": "आविवेश ततस्तीव्रं तावकानां महद्भयम् ।\nपाण्डवानां च राजेन्द्र तथा भूते महाहवे\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2172996, "chapter_id": 4683, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि दशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2172997, "chapter_id": 4683, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि दशमोऽध्यायः ॥१०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]