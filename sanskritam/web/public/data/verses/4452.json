[{"id": 2159221, "chapter_id": 4452, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159222, "chapter_id": 4452, "verse_number": "१", "content_sanskrit": "भगीरथं च राजानं मृतं सृञ्जय शुश्रुम ।\nपरित्राणाय पूर्वेषां येन गङ्गाऽवतारिता\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159223, "chapter_id": 4452, "verse_number": "२", "content_sanskrit": "यस्येन्द्रो बाहुवीर्येण प्रीतो राज्ञो महात्मनः ।\nसोऽश्वमेधशतैरीजे समाप्तवरदक्षिणैः\nहविर्मन्त्रान्नसम्पन्नैर्देवानामादधान्मुदम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159224, "chapter_id": 4452, "verse_number": "३", "content_sanskrit": "यः सहस्रं सहस्राणां कन्या हेमविभूषिताः ।\nराजन्यान् राजपुत्र्यश्च ब्राह्मणेभ्यो ह्यमन्यत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159225, "chapter_id": 4452, "verse_number": "४", "content_sanskrit": "सर्वा रथगताः कन्या रथाः सर्वे चतुर्युजः ।\nरथे रथे शतं नागाः पद्मिनो हेममालिनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159226, "chapter_id": 4452, "verse_number": "५", "content_sanskrit": "सहस्रमश्वाश्चैकैकं गजानां पृष्ठतोऽन्वयुः ।\nअश्वेऽश्वे गोसहस्रं तु तथैव च अजाविकम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159227, "chapter_id": 4452, "verse_number": "६", "content_sanskrit": "तेन क्रान्ता जनौघेन दक्षिणाभिश्च भूयसी ।\nउपह्वरेऽतिव्यथिता तस्याङ्के निषसाद ह\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159228, "chapter_id": 4452, "verse_number": "७", "content_sanskrit": "ततो भागीरथी गङ्गा ह्यूर्ध्वगा ह्यभवत् पुरा ।\nदुहितृत्वं गता राज्ञः पुत्रीवच्चोपपादिता\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159229, "chapter_id": 4452, "verse_number": "८", "content_sanskrit": "तत्र गाथां जगुः प्रीता गन्धर्वाः सूर्यवर्चसः ।\nपितृदेवमनुष्याणां शृण्वतां वल्गुवादिनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159230, "chapter_id": 4452, "verse_number": "९", "content_sanskrit": "भगीरथं याजमानमैक्ष्वाकं भूरिदक्षिणम् ।\nगङ्गा समुद्रगा देवी वव्रे पितरमीश्वरम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159231, "chapter_id": 4452, "verse_number": "१०", "content_sanskrit": "सेन्द्रैः सवरुणैर्देवैर्यस्य यज्ञाः स्वलङ्कृताः ।\nसम्यक् परिगृहीताश्च शान्तविघ्ना निरामयाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159232, "chapter_id": 4452, "verse_number": "११", "content_sanskrit": "यो यद्यदिच्छते विप्रो यच्च यस्यात्मनः प्रियम् ।\nतत्तद् भगीरथः प्रादात् तत्र तत्रानघो वशी\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159233, "chapter_id": 4452, "verse_number": "१२", "content_sanskrit": "नादेयं ब्राह्मणेष्वासीदस्य किञ्चित् प्रियं धनम् ।\nयश्च विप्रप्रसादेन ब्रह्मलोकं गतो नृपः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159234, "chapter_id": 4452, "verse_number": "१३", "content_sanskrit": "येन यातास्त्वभिमुखा दिशमद्यापि पादपाः ।\nआनतास्तस्थुरिच्छन्तः तमन्वागन्तुमीश्वरम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2159235, "chapter_id": 4452, "verse_number": "", "content_sanskrit": "स चेन्ममार सृञ्जय चतुर्भद्रतरस्त्वया", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2159236, "chapter_id": 4452, "verse_number": "१४", "content_sanskrit": "पुत्रात् पुण्यतरस्तुभ्यं मा पुत्रमनुतप्यथाः ।\nअयज्वानमदक्षिण्यमधिचैत्येत्युदाहरत्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2159237, "chapter_id": 4452, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि सप्तपञ्चाशोऽध्यायः ॥ ५७ ॥\nअभिमन्युवधपर्वणि षड्विंशोऽध्यायः ॥ २६ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]