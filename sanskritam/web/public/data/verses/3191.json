[{"id": 2101619, "chapter_id": 3191, "verse_number": "१४-४७-१", "content_sanskrit": "ब्रह्मोवाच।\nसंन्यासं तप इत्याहुर्वृद्धा निश्चितवादिनः।\nब्राह्मणा ब्रह्मयोनिस्था ज्ञानं ब्रह्म परं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101620, "chapter_id": 3191, "verse_number": "१४-४७-२", "content_sanskrit": "अतिदूरात्मकं ब्रह्म वेदविद्याव्यपाश्रयम्।\nनिर्द्वन्द्वं निर्गुणं नित्यमचिन्त्यगुणमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101621, "chapter_id": 3191, "verse_number": "१४-४७-३", "content_sanskrit": "ज्ञानेन तपसा चैव धीराः पश्यन्ति तत्परम्।\nनिर्णिक्तमनसः पूता व्युत्क्रान्तरजसोऽमलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101622, "chapter_id": 3191, "verse_number": "१४-४७-४", "content_sanskrit": "तपसा क्षेममध्वानं गच्छन्ति परमेश्वरम्।\nसंन्यासनिरता नित्यं ये च ब्रह्मविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101623, "chapter_id": 3191, "verse_number": "१४-४७-५", "content_sanskrit": "तपः प्रदीप इत्याहुराचारो धर्मसाधकः।\nज्ञानं वै परमं विद्यात्संन्यासं तप उत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101624, "chapter_id": 3191, "verse_number": "१४-४७-६", "content_sanskrit": "यस्तु वेद निराबाधं ज्ञानं तत्त्वविनिश्चयात्।\nसर्वभूतस्थमात्मानं स सर्वविदिहोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101625, "chapter_id": 3191, "verse_number": "१४-४७-७", "content_sanskrit": "यो विद्वान्सहवासं च विवासं चैव पश्यति।\nतथैवेकत्वनानात्वे स दुःखात्प्रतिमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101626, "chapter_id": 3191, "verse_number": "१४-४७-८", "content_sanskrit": "यो न कामयते किञ्चिन्न किञ्चिदवमन्यते।\nइह लोकस्थ एवैष ब्रह्मभूयाय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101627, "chapter_id": 3191, "verse_number": "१४-४७-९", "content_sanskrit": "प्रधानगुणतत्त्वज्ञः सर्व भूतविधानवित्।\nनिर्ममो निरहङ्कारो मुच्यते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101628, "chapter_id": 3191, "verse_number": "१४-४७-१०", "content_sanskrit": "निर्द्वन्द्वो निर्नमस्कारो निःस्वधाकार एव च।\nनिर्गुणं नित्यमद्वन्द्वं प्रशमेनैव गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101629, "chapter_id": 3191, "verse_number": "१४-४७-११", "content_sanskrit": "हित्वा गुणमयं सर्वं कर्म जन्तुः शुभाशुभम्।\nउभे सत्यानृते हित्वा मुच्यते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101630, "chapter_id": 3191, "verse_number": "१४-४७-१२", "content_sanskrit": "अव्यक्तबीजप्रभवो बुद्धिस्कन्धमयो महान्।\nमहाहङ्कारविटप इन्द्रियान्तरकोटरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101631, "chapter_id": 3191, "verse_number": "१४-४७-१३", "content_sanskrit": "महाभूतविशाखश्च विशेषप्रतिशाखवान्।\nसदापत्रः सदापुष्पः शुभाशुभफलोदयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101632, "chapter_id": 3191, "verse_number": "१४-४७-१४", "content_sanskrit": "आजीव्यः सर्वभूतानां ब्रह्मवृक्षः सनातनः।\nएनं छित्त्वा च भित्त्वा च तत्त्वज्ञानासिना बुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101633, "chapter_id": 3191, "verse_number": "१४-४७-१५", "content_sanskrit": "हित्वा सङ्गमयान्पाशान्मृत्युजन्मजरोदयान्।\nनिर्ममो निरहङ्कारो मुच्यते नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101634, "chapter_id": 3191, "verse_number": "१४-४७-१६", "content_sanskrit": "द्वाविमौ पक्षिणौ नित्यौ संक्षेपौ चाप्यचेतनौ।\nएताभ्यां तु परो योन्यश्चेतनावान्स उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101635, "chapter_id": 3191, "verse_number": "१४-४७-१७", "content_sanskrit": "अचेतनः सत्वसङ्ख्याविमुक्तः\nसत्त्वात्परं चेतयतेऽन्तरात्मा।\nस क्षेत्रवित्सर्वसङ्ख्यातबुद्धि-\nर्गुणातिगो मुच्यते सर्वपापैः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101636, "chapter_id": 3191, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि सप्तचत्वारिंशोऽध्यायः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]