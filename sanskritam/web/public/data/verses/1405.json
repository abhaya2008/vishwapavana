[{"id": 2019449, "chapter_id": 1405, "verse_number": "३-४३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2019450, "chapter_id": 1405, "verse_number": "३-४३-१", "content_sanskrit": "ददर्श स पुरीं रम्यां सिद्धचारणसेविताम्।\nसर्वर्तुकुसुमैः पुण्यैः पादपैरुपशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2019451, "chapter_id": 1405, "verse_number": "३-४३-२", "content_sanskrit": "तत्र सौगन्धिकानां च पुष्पाणां पुण्यगन्धिनाम्।\nउपवीज्यमानो मिश्रेण वायुना पुण्यगन्धिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2019452, "chapter_id": 1405, "verse_number": "३-४३-३", "content_sanskrit": "नन्दनं च वनं दिव्यमप्सरोगणसेवितम्।\nददर्श दिव्यकुसुमैराह्वयद्भिरिव द्रुमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2019453, "chapter_id": 1405, "verse_number": "३-४३-४", "content_sanskrit": "नातप्ततपसा शक्यो द्रष्टुं नानाहिताग्निना।\nस लोकः पुण्यकर्तॄणां नापि युद्धे पराङ्युखैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2019454, "chapter_id": 1405, "verse_number": "३-४३-५", "content_sanskrit": "नायज्वभिर्नाव्रतिकैर्न वेदश्रुतिवर्जितैः।\nनानाप्लुताङ्गैस्तीर्थेषु यज्ञदानबहिष्कृतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2019455, "chapter_id": 1405, "verse_number": "३-४३-६", "content_sanskrit": "नापि यज्ञहनैः क्षुद्रैर्द्रष्टुं शक्यः कथंचन।\nपानपैर्गुरुतल्पैश्च मांसादैर्वा दुरात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2019456, "chapter_id": 1405, "verse_number": "३-४३-७", "content_sanskrit": "स तद्दिव्यं वनं पश्यन्दिव्यगीतनिनादितम्।\nप्रविवेश महाबाहुः शक्रस्य दयितां पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2019457, "chapter_id": 1405, "verse_number": "३-४३-८", "content_sanskrit": "तत्र देवविमानानि कामगानि सहस्रशः।\nसंस्थितान्यभियातानि ददर्शायुतशस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2019458, "chapter_id": 1405, "verse_number": "३-४३-९", "content_sanskrit": "संस्तूयमानो गन्धर्वैरप्सरोभिश्च पाण्डवः।\nपुष्पगन्धवहैः पुण्यैर्वायुभिश्चानुवीजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2019459, "chapter_id": 1405, "verse_number": "३-४३-१०", "content_sanskrit": "ततो देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः।\nहृष्टाः संपूजयामासुः पार्थमक्लिष्टकारिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2019460, "chapter_id": 1405, "verse_number": "३-४३-११", "content_sanskrit": "आसीर्वादैः स्तूयमानो दिव्यवादित्रनिःस्वनैः।\nप्रतिपेदे महाबाहुः शङ्खदुन्दुभिनादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2019461, "chapter_id": 1405, "verse_number": "३-४३-१२", "content_sanskrit": "नक्षत्रमार्गं विपुलं सुरवीथीति विश्रुतम्।\nइन्द्राज्ञया ययौ पार्थः स्तूयमानः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2019462, "chapter_id": 1405, "verse_number": "३-४३-१३", "content_sanskrit": "तत्र साध्यास्तथा विश्वे मरुतोऽथाश्विनौ तथा।\nआदित्या वसवो रुद्रास्तथा ब्रह्मर्षयोऽमलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2019463, "chapter_id": 1405, "verse_number": "३-४३-१४", "content_sanskrit": "राजर्षयश्च बहवो दिलीपप्रमुखा नृपाः।\nतम्बुरुर्नारदश्चैव गन्धर्वौ च हाहा हूहूः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2019464, "chapter_id": 1405, "verse_number": "३-४३-१५", "content_sanskrit": "तान्स सर्वान्समागम्य विधिवत्कुरुनन्दनः।\nततोऽपश्यद्देवराजं शतक्रतुमरिंदमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2019465, "chapter_id": 1405, "verse_number": "३-४३-१६", "content_sanskrit": "ततः पार्थो महाबाहुरवतीर्य रथोत्तमात्।\nददर्श साक्षाद्देवेशं पितरं पाकशासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2019466, "chapter_id": 1405, "verse_number": "३-४३-१७", "content_sanskrit": "पाण्डुरेणातपत्रेण हेमदण्डेन चारुणा।\nदिव्यगन्धाधिवासेन व्यजनेन विधूयता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2019467, "chapter_id": 1405, "verse_number": "३-४३-१८", "content_sanskrit": "विश्वावसुप्रभृतिनिर्गन्धर्वैः स्तुतिवन्दिभिः।\nस्तूयमानं द्विजाग्र्यैश्च ऋग्यजुःसामसंस्तवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2019468, "chapter_id": 1405, "verse_number": "३-४३-१९", "content_sanskrit": "ततोऽभिगम्य कौन्तेयः शिरसाऽभ्यगमद्बली।\nस चैनं वृत्तपीनाभ्यां बाहुभ्यां प्रत्यगृह्णत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2019469, "chapter_id": 1405, "verse_number": "३-४३-२०", "content_sanskrit": "ततः शक्रासने पुण्ये देवर्षिगणसेविते।\nशक्रः पाणौ गृहीत्वैनमुपावेशयदन्तिके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2019470, "chapter_id": 1405, "verse_number": "३-४३-२१", "content_sanskrit": "मूर्धि चैनमुपाघ्राय देवेन्द्रः परवीरहा।\nअङ्कमारोपयामास प्रश्रयावनतं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2019471, "chapter_id": 1405, "verse_number": "३-४३-२२", "content_sanskrit": "सहस्राक्षनियोगात्स पार्थः शक्रासनं तदा।\nआरुरुक्षुरमेयात्मा द्वितीय इववासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2019472, "chapter_id": 1405, "verse_number": "३-४३-२३", "content_sanskrit": "ततः प्रेम्णा वृत्रशत्रुरर्जुनस्य शुभं मुखम्।\nपस्पर्श पुण्यगन्धेन करेण परिसान्त्वयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2019473, "chapter_id": 1405, "verse_number": "३-४३-२४", "content_sanskrit": "प्रमार्जमानः शनकैर्बाहू चास्यायतौ शुभौ।\nज्याशरक्षेपकिनौ स्तम्भाविव हिरण्मयौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2019474, "chapter_id": 1405, "verse_number": "३-४३-२५", "content_sanskrit": "वज्रग्रहणचिह्नेन करेण परिसान्त्वयन्।\nमुहुर्मुहुर्वज्रधरो बाहू चास्फोटयञ्शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2019475, "chapter_id": 1405, "verse_number": "३-४३-२६", "content_sanskrit": "स्मयन्निव गुडाकेशं प्रेक्षमाणः सहस्रदृक्।\nहर्षेणोत्फुल्लनयनो न चातृप्यत वृत्रहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2019476, "chapter_id": 1405, "verse_number": "३-४३-२७", "content_sanskrit": "एकासनोपविष्टौ तौ शोभयांसचक्रतुः सभाम्।\nसूर्याचन्द्रमसौ व्योम चतुर्दश्यामिवोदितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2019477, "chapter_id": 1405, "verse_number": "३-४३-२८", "content_sanskrit": "तत्र स्म गाथा गायन्ति साम्ना परमवल्गुना।\nगन्धर्वास्तुम्बुरुश्रेष्ठाः कुशला गीतसामसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2019478, "chapter_id": 1405, "verse_number": "३-४३-२९", "content_sanskrit": "घृताची मेनका रम्भा पूर्वचित्तिः स्वयंप्रभा।\nउर्वशी मिश्रकेशी च दण्डगौरी वरूथीनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2019479, "chapter_id": 1405, "verse_number": "३-४३-३०", "content_sanskrit": "गोपाली सहजन्या च कुम्भयोनिः प्रजागरा।\nचित्रसेना चित्रलेखा सहा च मधुरस्वरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2019480, "chapter_id": 1405, "verse_number": "३-४३-३१", "content_sanskrit": "एताश्चान्याश्च ननृतुस्तत्रतत्र शुचिस्मिताः।\nचत्तप्रमथने युक्ताः सिद्धानां पद्मलोचनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2019481, "chapter_id": 1405, "verse_number": "३-४३-३२", "content_sanskrit": "महाकटितटश्रोण्यः कम्पमानैः पयोधरैः।\nकटाक्षहावमाधुर्यैश्चेतोबुद्धिमनोहरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2019482, "chapter_id": 1405, "verse_number": "३-४३-३३", "content_sanskrit": "[ततो देवाः सगन्धर्वाः समादायार्घ्यमुत्तमम्।\nशक्रस्य मतमाज्ञाय पार्थमानर्चुरञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2019483, "chapter_id": 1405, "verse_number": "३-४३-३४", "content_sanskrit": "पाद्यमाचमनीयं च प्रतिग्राह्य नृपात्मजम्।\nप्रवेशयामासुरथो पुरंदरनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2019484, "chapter_id": 1405, "verse_number": "३-४३-३५", "content_sanskrit": "एवं संपूजितो जिष्णुरुवास भवने पितुः।\nउपशिक्षन्महास्राणि ससंहाराणि पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2019485, "chapter_id": 1405, "verse_number": "३-४३-३६", "content_sanskrit": "शक्रस्य हस्ताद्दयितं वज्रमस्त्रं च दुःसहम्।\nअशनीश्च महानादा मेघबर्हिणलक्षणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2019486, "chapter_id": 1405, "verse_number": "३-४३-३७", "content_sanskrit": "गृहीतास्त्रस्तु कौन्तेयो भ्रातॄन्सस्मार पाण्डवः।\nपुरंदरनियोगाच्च पञ्चाब्दानवसत्सुखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2019487, "chapter_id": 1405, "verse_number": "३-४३-३८", "content_sanskrit": "ततः शक्रोऽब्रवीत्पार्थं कृतास्त्रं काल आगते।\nनृत्यं गीतं च कौन्तेय चित्रसेनादवाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2019488, "chapter_id": 1405, "verse_number": "३-४३-३९", "content_sanskrit": "वादित्रं देवविहितं नृलोके यन्न विद्यते।\nतदर्जयस्व कौन्तेय श्रेयो वै ते भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2019489, "chapter_id": 1405, "verse_number": "३-४३-४०", "content_sanskrit": "सखायं प्रददौ चास्य चित्रसेनं पुरंदरः।\nस तेन सह संगम्य रेमे पार्थो निरामयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2019490, "chapter_id": 1405, "verse_number": "३-४३-४१", "content_sanskrit": "गीतवादित्रनृत्यानि भूय एवादिदेश ह।\nतथाऽपि नालभच्छर्म तरस्वी द्यूतकारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2019491, "chapter_id": 1405, "verse_number": "३-४३-४२", "content_sanskrit": "दुःशासनवधामर्षी शकुनेः सौबलस्य च।\nततस्तेनातुलां प्रीतिमुपागम्य क्वचित्क्वचित्।\nगान्धऱ्वमतुलं नृत्यं वादित्रं चोपलब्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2019492, "chapter_id": 1405, "verse_number": "३-४३-४३", "content_sanskrit": "स शिक्षितो नृत्यगुणाननेका-\nन्वादित्रगीतार्थगुणांश्च सर्वान्।\nन शर्ण लेभे परवीरहन्ता\nभ्रातॄन्स्मरन्मातरं चैव कुन्तीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2019493, "chapter_id": 1405, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि इन्द्रलोकाभिगमनपर्वणि त्रिचत्वारिंशोऽध्यायः ॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]