[{"id": 2207985, "chapter_id": 5438, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2207986, "chapter_id": 5438, "verse_number": "१", "content_sanskrit": "त्रयो वै रिपवो लोके नवधा गुणतः स्मृताः ।\nहर्षः स्तम्भोऽतिमानश्च त्रयस्ते सात्विका गुणाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2207987, "chapter_id": 5438, "verse_number": "२", "content_sanskrit": "शोकः क्रोधोऽभिसंरम्भो राजसास्ते गुणाः स्मृताः ।\nस्वप्नस्तन्द्री च मोहश्च त्रयस्ते तामसा गुणाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2207988, "chapter_id": 5438, "verse_number": "३", "content_sanskrit": "एतान् निकृत्य धृतिमान् बाणसङ्घैरतन्द्रितः ।\nजित्वा परानुत्सहते प्रशान्तः स्याज्जितेन्द्रियः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2207989, "chapter_id": 5438, "verse_number": "४", "content_sanskrit": "अत्र गाथाः कीर्तयन्ति पुराकल्पविदो जनाः ।\nअम्बरीषेण या गीता राज्ञा राज्यं प्रशासता ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2207990, "chapter_id": 5438, "verse_number": "५", "content_sanskrit": "समुदीर्णेषु दुष्टेषु वध्यमानेषु सर्वशः ।\nजग्राह तरसा राज्यमम्बरीष इति श्रुतिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2207991, "chapter_id": 5438, "verse_number": "६", "content_sanskrit": "सन्निगृह्य महादोषान् साधून् समभिपूज्य च ।\nजगाम महतीं सिद्धिं गाथाश्चेमा जगाद ह ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2207992, "chapter_id": 5438, "verse_number": "", "content_sanskrit": "अम्बरीषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2207993, "chapter_id": 5438, "verse_number": "७", "content_sanskrit": "भूयिष्ठं मे जिता दोषा निहताः सर्वशत्रवः ।\nएको दोषोऽवशिष्टस्तु वध्येष्वनिहतो मया ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2207994, "chapter_id": 5438, "verse_number": "८", "content_sanskrit": "येन युक्तो जन्तुरयं तृष्णामेवाधिगच्छति ।\nतृषार्त इव निम्नानि परिधावति नित्यदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2207995, "chapter_id": 5438, "verse_number": "९", "content_sanskrit": "अकार्यमपि येनेह प्रयुक्तः सेवते नरः ।\nतं लोभमसिभिस्तीक्ष्णैर्निकृत्य सुखमेधते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2207996, "chapter_id": 5438, "verse_number": "१०", "content_sanskrit": "लोभाद्धि जायते तृष्णा ततश्चित्तं प्रसज्यते ।\nस लिप्समानो लभते भूयिष्ठं राजसान् गुणान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2207997, "chapter_id": 5438, "verse_number": "११", "content_sanskrit": "तदवाप्तौ तु लभते भूयिष्ठं तामसान् गुणान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2207998, "chapter_id": 5438, "verse_number": "१२", "content_sanskrit": "स तैर्गुणैः संहतदेहवन्धनः\nपुनः पुनर्जायति कर्म चेहते ।\nजन्मक्षये भिन्नविकीर्णदेहो\nपुनर्मृत्युं गच्छति जन्मनि स्वे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2207999, "chapter_id": 5438, "verse_number": "१३", "content_sanskrit": "तस्मादेनं सम्यगवेक्ष्य लोभं\nनिगृह्य धृत्याऽऽत्मनि राज्यमिच्छेत् ।\nएतद् राज्यं नान्यदस्तीति विद्यात्\nयस्तेन राज्ञा विजितोऽमुयैकः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208000, "chapter_id": 5438, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208001, "chapter_id": 5438, "verse_number": "समाप्तिः", "content_sanskrit": "इति राज्ञाऽम्बरीषेण गाथा गीता यशस्विनी ।\nआधिराज्यं पुरस्कृत्य लोभमेकं निकृन्तता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208002, "chapter_id": 5438, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु अम्बरीषचरित्रकथनं नाम द्वात्रिंशोऽध्यायः ॥३२॥\nअनुगीतापर्वणि सप्तदशोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]