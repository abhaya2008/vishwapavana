[{"id": 2068803, "chapter_id": 2443, "verse_number": "९-६१-०x", "content_sanskrit": "धृतराष्ट्रा उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068804, "chapter_id": 2443, "verse_number": "९-६१-१", "content_sanskrit": "अधर्मेण हतं दृष्ट्वा राजानं माधवोत्तमः।\nकिमब्रवीत्तदा सूत बलदेवो महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068805, "chapter_id": 2443, "verse_number": "९-६१-२", "content_sanskrit": "गदायुद्धविशेषज्ञो गदायुद्धविशारदः।\nकृतवान्रौहिणेयो यत्तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068806, "chapter_id": 2443, "verse_number": "९-६१-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068807, "chapter_id": 2443, "verse_number": "९-६१-३", "content_sanskrit": "शिरस्यभिहतं दृष्ट्वा भीमसेनेन ते सुतम्।\nरामः प्रहरतां श्रेष्ठश्चुक्रोध बलवद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068808, "chapter_id": 2443, "verse_number": "९-६१-४", "content_sanskrit": "ततो मध्ये नरेन्द्राणामूर्ध्वबाहुर्हलायुधः।\nकुर्वन्नार्तस्वरं घोरं धिग्धिग्भीमेत्युवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068809, "chapter_id": 2443, "verse_number": "९-६१-५", "content_sanskrit": "अहो धिग्यदधो नाभेः प्रहृतं धर्मविग्रहे।\nनैतद्दृष्टं गदायुद्धे कृतवान्यद्वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068810, "chapter_id": 2443, "verse_number": "९-६१-६", "content_sanskrit": "अधो नाभ्या न हन्तव्यमिति शास्त्रस्य निश्चयः।\nअयं तु शास्त्रमुत्सृज्य स्वच्छन्दात्सम्प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068811, "chapter_id": 2443, "verse_number": "९-६१-७", "content_sanskrit": "तस्य तत्तद्ब्रुवाणस्य रोषः समभवन्महान्।\n[ततो राजानमालोक्य रोषसंरक्तलोचनः।\nबलदेवो महाराज ततो वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068812, "chapter_id": 2443, "verse_number": "९-६१-८", "content_sanskrit": "न चैष पतितः कृष्ण केवलं मत्समोऽसमः।\nआश्रितस्य तु दौर्बल्यादाश्रयः परिभर्त्स्यते॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068813, "chapter_id": 2443, "verse_number": "९-६१-९", "content_sanskrit": "ततो लाङ्गलमुद्यम्य भीममभ्यद्रवद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068814, "chapter_id": 2443, "verse_number": "९-६१-१०", "content_sanskrit": "तस्योर्ध्वबाहोः सदृशं रूपमासीन्महात्मनः।\nबहुधातुविचित्रस्य श्वेतस्येव महागिरेः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068815, "chapter_id": 2443, "verse_number": "९-६१-११", "content_sanskrit": "`भ्रातृभिः सहितो वीरैः सार्जुनैरस्त्रकोविदैः।\nन विव्यथे महाराज दृष्ट्वा हलधरं बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068816, "chapter_id": 2443, "verse_number": "९-६१-१२", "content_sanskrit": "अथ रामं निजग्राह केशवो विनयान्वितः।\nबाहुभ्यां पीनवृत्ताभ्यां प्रयत्नाद्बलवद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068817, "chapter_id": 2443, "verse_number": "९-६१-१३", "content_sanskrit": "सितासितौ यदुवरौ शुशुभातेऽधिकं तदा।\n`सङ्गताविव राजेन्द्र कैलासाञ्जनपर्वतौ।\nनभोगतौ यथा राजंश्चन्द्रसूर्यौ दिनक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068818, "chapter_id": 2443, "verse_number": "९-६१-१४", "content_sanskrit": "उवाच चैनं संरब्धं शमयन्निव केशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068819, "chapter_id": 2443, "verse_number": "९-६१-१५", "content_sanskrit": "आत्मवृद्धिर्मित्रवृद्धिर्मित्रमित्रोदयस्तथा।\nविपरीतं द्विषत्स्वेतत्षड्विधा वृद्धिरात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068820, "chapter_id": 2443, "verse_number": "९-६१-१६", "content_sanskrit": "आत्मन्यपि च मित्रे च विपरीतं यदा भवेत्।\nतदा विद्यान्मनोग्लानिमाशु शान्तिकरो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068821, "chapter_id": 2443, "verse_number": "९-६१-१७", "content_sanskrit": "अस्माकं सहजं मित्रं पाण्डवाः शुद्धपौरुषाः।\nस्वकाः पितृष्वसुः पुत्रास्ते परैर्निकृता भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068822, "chapter_id": 2443, "verse_number": "९-६१-१८", "content_sanskrit": "प्रतिज्ञापालनं धर्मः क्षत्रियस्येति वेत्थ तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068823, "chapter_id": 2443, "verse_number": "९-६१-१९", "content_sanskrit": "सुयोधनस्य गदया भक्ताऽस्म्यूरू महाहवे।\nइति पूर्वं प्रतिज्ञातं भीमेन हि सभातले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068824, "chapter_id": 2443, "verse_number": "९-६१-२०", "content_sanskrit": "मैत्रेयेणाभिशप्तश्च पूर्वमेव महार्षिणा।\nऊरू ते भेत्स्यते भीमो गदयेति परन्तप।\nअतो दोषं न पश्यामि मा क्रुध्यस्व प्रलम्बहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068825, "chapter_id": 2443, "verse_number": "९-६१-२१", "content_sanskrit": "यौनः स्वैः सुखहार्दैश्च सम्बन्धः सह पाण्डवैः।\nतेषां वृद्ध्या हि वृद्धिर्नो मा क्रुधः पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068826, "chapter_id": 2443, "verse_number": "९-६१-२२", "content_sanskrit": "वासुदेववचः श्रुत्वा सीरभृत्प्राह धर्मवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068827, "chapter_id": 2443, "verse_number": "९-६१-२३", "content_sanskrit": "धर्मश्च धारितः सद्भिः स च द्वाभ्यां नियच्छति।\nअर्थश्चाप्यतिलुब्धस्य कामश्चातिप्रसङ्गिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2068828, "chapter_id": 2443, "verse_number": "९-६१-२४", "content_sanskrit": "धर्मार्थौ धर्मकामौ च कामार्थौ चाप्यपीडयन्।\nधर्मार्थकामान्योऽभ्येति सोत्यन्तं सुखमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2068829, "chapter_id": 2443, "verse_number": "९-६१-२५", "content_sanskrit": "तदिदं व्याकुलं सर्वं कृतं धर्मस्य पीडनात्।\nभीमसेनेन गोविन्द कामं त्वं तु यथाऽऽत्थ माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2068830, "chapter_id": 2443, "verse_number": "९-६१-२६x", "content_sanskrit": "कृष्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2068831, "chapter_id": 2443, "verse_number": "९-६१-२६", "content_sanskrit": "अरोषणो हि धर्मात्मा सततं धर्मवत्सलः।\nभवान्प्रख्यायते लोके तस्मात्संशाम्य मा क्रुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2068832, "chapter_id": 2443, "verse_number": "९-६१-२७", "content_sanskrit": "प्राप्तं कलियुगं विद्वि प्रतिज्ञां पाण्डवस्य च।\nआनृण्यं यातु वैरस्य प्रतिज्ञायाश्च पाण्डवः।\n`ततः पुरुषशार्दूलो हत्वा नैकृतिकं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2068833, "chapter_id": 2443, "verse_number": "९-६१-२८", "content_sanskrit": "निकृत्या निकृतिप्रज्ञं यो हन्याद्वैरिणं रणे।\nअधर्मो विद्यते नात्र यद्भीमो हतवान्रिपुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2068834, "chapter_id": 2443, "verse_number": "९-६१-२९", "content_sanskrit": "युध्यमानं रणे वीरं कुरुवृष्णियशस्करम्।\nअनेन कर्णः सन्दिष्टः पृष्ठतो धनुरच्छिनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2068835, "chapter_id": 2443, "verse_number": "९-६१-३०", "content_sanskrit": "ततः सञ्छिन्नधन्वानं विरथं पौरुषे स्थितम्।\nव्यायुधीकृत्य बहवः सौभद्रमपलायिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2068836, "chapter_id": 2443, "verse_number": "९-६१-३१", "content_sanskrit": "जन्मप्रभृति लुब्धश्च पापात्मा चैष दुर्मतिः।\nनिहतो भीमसेनेन दुर्बुद्धिः कुलपांसनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2068837, "chapter_id": 2443, "verse_number": "९-६१-३२", "content_sanskrit": "प्रतिज्ञां भीमसेनेन त्रयोदशसमार्जिताम्।\nकिमर्थं नाभिजानाति युध्यमानो हि शत्रुभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2068838, "chapter_id": 2443, "verse_number": "९-६१-३३", "content_sanskrit": "ऊर्ध्वमाक्रम्य वेगेन जिघांसन्तं वृकोदरः।\nबिभेद गदया चोरू न स्थाने न च मण्डले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2068839, "chapter_id": 2443, "verse_number": "९-६१-३४x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2068840, "chapter_id": 2443, "verse_number": "९-६१-३४", "content_sanskrit": "धर्मच्छलमिमं श्रुत्वा केशवात्स विशाम्पते।\nनैव प्रीतमाना रामो वचनं प्राह संसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2068841, "chapter_id": 2443, "verse_number": "९-६१-३५", "content_sanskrit": "हत्वाऽधर्मेण राजानं धर्मात्मानं सुयोधनम्।\nजिह्मयोधीति लोकेऽस्मिन्ख्यातिं यास्यति पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2068842, "chapter_id": 2443, "verse_number": "९-६१-३६", "content_sanskrit": "दुर्योधनोऽपि धर्मात्मा गतिं यास्यति शाश्वतीम्।\nऋजुयोधी हतो राजा धर्मराष्ट्रो नराधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2068843, "chapter_id": 2443, "verse_number": "९-६१-३७", "content_sanskrit": "युद्धदीक्षां प्रविश्याजौ रणयज्ञं वितत्य च।\nहुत्वाऽऽत्मानममित्राग्नौ प्राप चावभृथं यशः।\n`स्वर्गं गन्ता महाराजः ससुहृज्ज्ञातिबान्धवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2068844, "chapter_id": 2443, "verse_number": "९-६१-३८", "content_sanskrit": "इत्युक्त्वा रथमास्थाय रौहिणेयः प्रतापवान्।\nश्वेताभ्रशिखराकारः प्रययौ द्वारकां प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2068845, "chapter_id": 2443, "verse_number": "९-६१-३९", "content_sanskrit": "पाञ्चालाश्च सवार्ष्णेयाः पाण्डवाश्च विशाम्पते।\nरामे द्वारवतीं याते नातिप्रमनसोऽभवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2068846, "chapter_id": 2443, "verse_number": "९-६१-४०", "content_sanskrit": "ततो युधिष्ठिरं दीनं चिन्तापरमधोमुखम्।\nशोकोपहतसङ्कल्पं वासुदेवोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2068847, "chapter_id": 2443, "verse_number": "९-६१-४१x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2068848, "chapter_id": 2443, "verse_number": "९-६१-४१", "content_sanskrit": "धर्मराज किमर्थं त्वमधर्ममनुमन्यसे।\nहतबन्धोर्यदेतस्य पतितस्य विचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2068849, "chapter_id": 2443, "verse_number": "९-६१-४२", "content_sanskrit": "दुर्योधनस्य भीमेन मृद्यमानं शिरः पदा।\nउपप्रेक्षसि कस्मात्त्वं धर्मज्ञः सन्नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2068850, "chapter_id": 2443, "verse_number": "९-६१-४३x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2068851, "chapter_id": 2443, "verse_number": "९-६१-४३", "content_sanskrit": "न ममैतत्प्रियं कृष्ण यद्राजानं वृकोदरः।\nपदा मूर्ध्न्यस्पृशत्क्रोधान्न च हृष्ये कुलक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2068852, "chapter_id": 2443, "verse_number": "९-६१-४४", "content_sanskrit": "निकृत्या निकृता नित्यं धृतराष्ट्रसुतैर्वयम्।\nबहूनि परुषाण्युक्त्वा वनं प्रस्थापिता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2068853, "chapter_id": 2443, "verse_number": "९-६१-४५", "content_sanskrit": "भीमसेनस्य तद्दुःखमतीव हृदि वर्तते।\nइति सञ्चिन्त्य वार्ष्णेय मयैतत्समुपेक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2068854, "chapter_id": 2443, "verse_number": "९-६१-४६", "content_sanskrit": "तस्माद्धत्वाऽकृतप्रज्ञं लुब्धं कामवशानुगम्।\nलभतां पाण़्डवः कामं धर्मोऽधर्मोऽथवा कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2068855, "chapter_id": 2443, "verse_number": "९-६१-४७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2068856, "chapter_id": 2443, "verse_number": "९-६१-४७", "content_sanskrit": "इत्युक्तवति कौन्तेये धर्मराजे युधिष्ठिरे।\nवासुदेवो महाबाहुर्युधिष्ठिरमभाषत।\nकाममस्त्वेतदिति वै कृच्छ्राद्यदुकुलोद्वहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2068857, "chapter_id": 2443, "verse_number": "९-६१-४८", "content_sanskrit": "इत्युक्त्वा वासुदेवोऽपि वायुपुत्रप्रियेप्सया।\nअन्वमोदत तत्सर्वं यद्भीमेन कृतं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2068858, "chapter_id": 2443, "verse_number": "९-६१-४९", "content_sanskrit": "`अर्जुनोऽपि महाबाहुरप्रीतेनान्तरात्मना।\nनोवाच किञ्चिद्वचनं भ्रातरं साध्वसाधु वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2068859, "chapter_id": 2443, "verse_number": "९-६१-५०", "content_sanskrit": "भीमसेनोऽपि हत्वाऽऽजौ तव पुत्रममर्षणः।\nअभिवाद्याग्रतः स्थित्वा सम्प्रहृष्टः कृताञ्जलिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2068860, "chapter_id": 2443, "verse_number": "९-६१-५१", "content_sanskrit": "प्रोवाच सुमहातेजा धर्मराजं युधिष्ठिरम्।\nहर्षादुत्फुल्लनयनो जितकाशी विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2068861, "chapter_id": 2443, "verse_number": "९-६१-५२", "content_sanskrit": "तवाद्य पृथिवी सर्वा क्षेमा निहतकण्टका।\nतां प्रशाधि महाराज स्वधर्ममनुपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2068862, "chapter_id": 2443, "verse_number": "९-६१-५३", "content_sanskrit": "यस्तु कर्ताऽस्य वैरस्य निकृत्या निकृतिप्रियः।\nसोऽयं विनिहतः शेते पृथिव्यं पृथिवीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2068863, "chapter_id": 2443, "verse_number": "९-६१-५४", "content_sanskrit": "दुःशासनप्रभृतयः सर्वे ते चोग्रवादिनः।\nराधेयः शकुनिश्चैव हताश्च तव शत्रवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2068864, "chapter_id": 2443, "verse_number": "९-६१-५५", "content_sanskrit": "सेयं रत्नसमाकीर्णा मही सवनपर्वता।\nउपावृत्ता महाराज त्वामद्य निहतद्विषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2068865, "chapter_id": 2443, "verse_number": "९-६१-५६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2068866, "chapter_id": 2443, "verse_number": "९-६१-५६", "content_sanskrit": "गतो वैरस्य निधनं हतो राजा सुयोधनः।\nकृष्णस्य मतमास्थाय विजितेयं वसुन्धरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2068867, "chapter_id": 2443, "verse_number": "९-६१-५७", "content_sanskrit": "दिष्ट्या गतस्त्वमानृण्यं मातुः कोपस्य चोभयोः।\nदिष्ट्या जयसि दुर्धर्ष दिष्ट्या शत्रुर्निपातितः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2068868, "chapter_id": 2443, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि गदायुद्धपर्वणि एकषष्टितमोऽध्यायः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}]