[{"id": 2208871, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208872, "chapter_id": 5462, "verse_number": "१", "content_sanskrit": "उदङ्कः केन तपसा संयुक्तः स महातपाः ।\nयः शापं दातुकामोऽभूद् विष्णवे प्रभविष्णवे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208873, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208874, "chapter_id": 5462, "verse_number": "२", "content_sanskrit": "उदङ्को महता युक्तः तपसा जनमेजय ।\nगुरुभक्तः स तेजस्वी नान्यत् किञ्चिदपूजयत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208875, "chapter_id": 5462, "verse_number": "३", "content_sanskrit": "सर्वेषामृषिपुत्राणामेष चासीन्मनोरथः ।\nऔदङ्कीं गुरुवृत्तिं वै प्राप्नुयामेति भारत ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208876, "chapter_id": 5462, "verse_number": "४", "content_sanskrit": "गौतमस्य तु शिष्याणां बहूनां जनमेजय ।\nउदङ्केऽभ्यधिका प्रीतिः स्नेहश्चैवाभवत् तदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208877, "chapter_id": 5462, "verse_number": "५", "content_sanskrit": "स तस्य दमशौचाभ्यां विक्रान्तेन च कर्मणा ।\nसम्यक् चैवोपचारेण गौतमः प्रीतिमानभूत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208878, "chapter_id": 5462, "verse_number": "६", "content_sanskrit": "अथ शिष्यसहस्राणि समनुज्ञाय गौतमः ।\nउदङ्कं परया प्रीत्या नाभ्यनुज्ञातुमैच्छत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208879, "chapter_id": 5462, "verse_number": "७", "content_sanskrit": "तं क्रमेण जरा तात परिरेभे महामुनिम् ।\nन चान्वबुध्यत तदा स मुनिर्गुरुवत्सलः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208880, "chapter_id": 5462, "verse_number": "८", "content_sanskrit": "ततः कदाचिद् राजेन्द्र काष्ठान्यानयितुं ययौ ।\nउदङ्कः काष्ठभारं तु महान्तं समुपानयत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208881, "chapter_id": 5462, "verse_number": "९", "content_sanskrit": "स तद्भाराभिभूतात्मा काष्ठभारमरिन्दम ।\nनिष्पिपेष क्षितौ राजन् परिश्रान्तो बुभुक्षितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208882, "chapter_id": 5462, "verse_number": "१०", "content_sanskrit": "तस्य काष्ठे विलग्नाऽभूत् जटा रूप्यसमप्रभा ।\nततः काष्ठैः सह तदा पपात धरणीतळे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208883, "chapter_id": 5462, "verse_number": "११", "content_sanskrit": "ततः स भारनिष्पिष्टः क्षुधाविष्टश्च भार्गवः ।\nदृष्ट्वा तां वयसोऽवस्थां रुरोदार्तस्वरं तदा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208884, "chapter_id": 5462, "verse_number": "१२", "content_sanskrit": "ततो गुरुसुता तस्य पद्मपत्रायतेक्षणा ।\nजग्राहाश्रूणि सुश्रोणी तपोयुक्तस्य धीमतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208885, "chapter_id": 5462, "verse_number": "१३", "content_sanskrit": "पितुर्नियोगाद् धर्मज्ञा शिरसाऽवनता तदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208886, "chapter_id": 5462, "verse_number": "१४", "content_sanskrit": "तस्या निपेततुर्दग्धौ करौ तैरश्रुबिन्दुभिः ।\nन हि तानश्रुपातान् वै शक्ता धारयितुं मही ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208887, "chapter_id": 5462, "verse_number": "१५", "content_sanskrit": "गौतमस्त्वब्रवीद् विप्रमुदङ्कं प्रीतिमानसः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208888, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208889, "chapter_id": 5462, "verse_number": "१६", "content_sanskrit": "कस्मात् तात तवाद्येह शोकोत्तरमिदं मनः ।\nस स्वैरं ब्रूहि विप्रर्षे श्रोतुमिच्छामि ते वचः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2208890, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2208891, "chapter_id": 5462, "verse_number": "१७", "content_sanskrit": "भवद्गतेन मनसा भवत्प्रियचिकीर्षया ।\nभवद्भक्तिगतेनेह भवद्भावानुगेन च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2208892, "chapter_id": 5462, "verse_number": "१८", "content_sanskrit": "जरेयं नावबुद्धा मे नाभिज्ञातं सुखं च मे ।\nशतवर्षोषितं हि त्वं न मामभ्यनुजज्ञिवान् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2208893, "chapter_id": 5462, "verse_number": "१९", "content_sanskrit": "भवता ह्यभ्यनुज्ञाताः शिष्याः प्रत्यवरा मम ।\nउपपन्ना द्विजश्रेष्ठ शतशोऽथ सहस्रशः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2208894, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2208895, "chapter_id": 5462, "verse_number": "२०", "content_sanskrit": "त्वत्प्रीतियुक्तेन मया गुरुशुश्रूषया तव ।\nव्यतिक्रामन्महान् कालो नावबुद्धो द्विजर्षभ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2208896, "chapter_id": 5462, "verse_number": "२१", "content_sanskrit": "किं त्वद्य यदि ते श्रद्धा गमनं प्रति भार्गव ।\nअनुज्ञां प्राप्य मत्तस्त्वं स्वगृहान् गच्छ मा चिरम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2208897, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2208898, "chapter_id": 5462, "verse_number": "२२", "content_sanskrit": "गुर्वर्थं किं प्रयच्छामि ब्रूहि त्वं द्विजसत्तम ।\nकिमुपाहृत्य गच्छेयमनुज्ञास्त्वया विभो ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2208899, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "गौतमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2208900, "chapter_id": 5462, "verse_number": "२३", "content_sanskrit": "दक्षिणा परितोषो वै गुरूणां सद्भिरुच्यते ।\nतव ह्याचरतो धर्मं तुष्टोऽहं वै न संशयः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2208901, "chapter_id": 5462, "verse_number": "२४", "content_sanskrit": "इत्थं हि परितुष्टं मां विजानीहि भृगूद्वह ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2208902, "chapter_id": 5462, "verse_number": "२५", "content_sanskrit": "युवा षोडशवर्षो हि तदद्य त्वं भविष्यसि ।\nददानि पत्नीं कन्यां च स्वां ते दुहितरं द्विज ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2208903, "chapter_id": 5462, "verse_number": "२६", "content_sanskrit": "एतामृते हि नान्या वै त्वत्तेजोऽर्हति सेवितुम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2208904, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2208905, "chapter_id": 5462, "verse_number": "२७", "content_sanskrit": "ततस्तां प्रतिजग्राह युवा भूत्वा तपस्विनीम् ।\nगुरुणा चाभ्यनुज्ञातो गुरुपत्नीमथाब्रवीत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2208906, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2208907, "chapter_id": 5462, "verse_number": "२८", "content_sanskrit": "किं भवत्यै प्रयच्छामि गुर्वर्थं विनियुङ्क्ष्व माम् ।\nप्रियं हि तव काङ्क्षामि प्राणैरपि धनैरपि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2208908, "chapter_id": 5462, "verse_number": "२९", "content_sanskrit": "यद् दुर्लभं हि लोकेऽस्मिन् रत्नमत्यद्भुतं भवेत् ।\nतदानयेयं तपसा न हि मेऽत्रास्ति संशयः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2208909, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "अहल्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2208910, "chapter_id": 5462, "verse_number": "३०", "content_sanskrit": "परितुष्टाऽस्मि ते विप्र नित्यं भगवता सह ।\nपर्याप्तमेतद् भद्रं ते गच्छ तात यथेप्सितम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2208911, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2208912, "chapter_id": 5462, "verse_number": "३१", "content_sanskrit": "उदङ्कस्तु महाराज पुनरेवाब्रवीद् वचः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2208913, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2208914, "chapter_id": 5462, "verse_number": "३२", "content_sanskrit": "आज्ञापयस्व मां मातः किं कर्तव्यं प्रियं तव ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2208915, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "अहल्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2208916, "chapter_id": 5462, "verse_number": "३३", "content_sanskrit": "सौदासपत्न्या विधृते दिव्ये ये मणिकुण्डले ।\nते ममानय भद्रं ते गुर्वर्थः स कृतो भवेत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2208917, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2208918, "chapter_id": 5462, "verse_number": "३४", "content_sanskrit": "स तथेति प्रतिश्रुत्य जगाम जनमेजय ।\nगुरुपत्नीप्रियार्थं वै ते समानयितुं तदा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2208919, "chapter_id": 5462, "verse_number": "३५", "content_sanskrit": "स जगाम ततः शीघ्रमुदङ्को ब्राह्मणर्षभः ।\nसौदासं पुरुषादं वै भिक्षितुं मणिकुण्डले ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2208920, "chapter_id": 5462, "verse_number": "३६", "content_sanskrit": "गौतमस्त्बब्रवीद् पत्नीमुदङ्को नात्र दृश्यते ।\nइति पृष्टा तमाचष्ट कुण्डलार्थं गतं तु वै ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2208921, "chapter_id": 5462, "verse_number": "३७", "content_sanskrit": "ततः प्रोवाच पत्नीं स न ते सम्यगिदं कृतम् ।\nशप्तः स पार्थिवो नूनं ब्राह्मणं तं हनिष्यति ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2208922, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "अहल्या", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2208923, "chapter_id": 5462, "verse_number": "३८", "content_sanskrit": "अजानन्त्या नियुक्तः स भगवन् ब्राह्मणोऽद्य वै ।\nभवत्प्रसादान्न भयं किञ्चित् तस्य भविष्यति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2208924, "chapter_id": 5462, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2208925, "chapter_id": 5462, "verse_number": "३९", "content_sanskrit": "इत्युक्तः प्राह तां पत्नीमेवमस्त्विति गौतमः ।\nउदङ्कोऽपि वने शून्ये राजानं तं ददर्श ह ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2208926, "chapter_id": 5462, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि सौदासदर्शनकथनं नाम षट्पञ्चाशोऽध्यायः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]