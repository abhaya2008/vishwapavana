[{"id": 7004074000, "chapter_id": 24074, "verse_number": "४-२३-१", "content_sanskrit": "शिवशर्मोवाच ।\nसत्यलोकेश्वर विधे सर्वेषां प्रपितामह ।\nकिंचिद्विज्ञप्तुकामोस्मि न भयाद्वक्तुमुत्सहे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004074001, "chapter_id": 24074, "verse_number": "४-२३-२", "content_sanskrit": "ब्रह्मोवाच ।\nयत्त्वं प्रष्टुमना विप्र ज्ञातं ते तन्मनोगतम् ।\nपिपृच्छिषुस्त्वं निर्वाणं गणौ तत्कथयिष्यतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004074002, "chapter_id": 24074, "verse_number": "४-२३-३", "content_sanskrit": "नेतयोर्विष्णुगणयोरगोचरमिहास्ति हि ।\nसर्वमेतौ विजानीतो यत्किंचिद्ब्रह्मगो लके ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004074003, "chapter_id": 24074, "verse_number": "४-२३-४", "content_sanskrit": "इत्युक्त्वा सत्कृतास्ते वै ब्रह्मणा भगवद्गणाः ।\nप्रणम्य लोककर्तारं तेऽपि हृष्टाः प्रतस्थिरे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004074004, "chapter_id": 24074, "verse_number": "४-२३-५", "content_sanskrit": "पुनः स्वयानमारुह्य वैकुंठमभितो ययुः ।\nगच्छतापि पुनस्तत्र द्विजेनापृच्छितौ गणौ ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004074005, "chapter_id": 24074, "verse_number": "४-२३-६", "content_sanskrit": "शिवशर्मोवाच ।\nकियद्दूरे वयं प्राप्ता गंतव्यं च कियत्पुनः ।\nपृच्छाम्यन्यच्च वां भद्रौ ब्रूतं प्रीत्या तदप्यहो ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004074006, "chapter_id": 24074, "verse_number": "४-२३-७", "content_sanskrit": "कांच्यवंती द्वारवती काश्ययोध्या च पंचमी ।\nमायापुरी च मथुरा पुर्यः सप्त विमुक्तिदाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004074007, "chapter_id": 24074, "verse_number": "४-२३-८", "content_sanskrit": "विहाय षट्पुरीश्चान्याः काश्यामेवप्रतिष्ठिता ।\nमुक्तिर्विश्वसृजा तत्किं मम मुक्तिर्न संप्रति ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004074008, "chapter_id": 24074, "verse_number": "४-२३-९", "content_sanskrit": "इति सर्वं मम पुरः प्रसादाद्वक्तुमर्हतम् ।\nइति तद्वाक्यमाकर्ण्य गणावूचतुरादरात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004074009, "chapter_id": 24074, "verse_number": "४-२३-१०", "content_sanskrit": "गणावूचतुः ।\nयथार्थं कथयावस्ते यत्पृष्टं भवतानघ ।\nविष्णुप्रसादाज्जानीवो भूतंभाविभवत्तथा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004074010, "chapter_id": 24074, "verse_number": "४-२३-११", "content_sanskrit": "विप्रावभासते यावत्किरणैः पुष्पवंतयोः ।\nतावतीभूः समुद्दिष्टा ससमुद्राद्रि कानना ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004074011, "chapter_id": 24074, "verse_number": "४-२३-१२", "content_sanskrit": "वियच्च तावदुपरि विस्तारपरिमंडलम् ।\nयोजनानां च नियुते भूमेर्भानुर्व्यवस्थितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004074012, "chapter_id": 24074, "verse_number": "४-२३-१३", "content_sanskrit": "भानोः सकाशादुपरि लक्षे लक्ष्यः क्षपाकरः ।\nनक्षत्रधं डलं सोमाल्लक्षयोजनमुच्छ्रितम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004074013, "chapter_id": 24074, "verse_number": "४-२३-१४", "content_sanskrit": "उडुमंडलतः सौम्य उपरिष्टाद्द्विलक्षतः ।\nद्विलक्षे तु बुधाच्छुक्रः शुक्राद्भौमो द्विलक्षके ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004074014, "chapter_id": 24074, "verse_number": "४-२३-१५", "content_sanskrit": "माहेयादुपरिष्टाच्च सुरेज्यो नियुतद्वये ।\nद्विलक्षयोजनोत्सेधः सौरिर्देवपुरोहितात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004074015, "chapter_id": 24074, "verse_number": "४-२३-१६", "content_sanskrit": "दशायुतसमुच्छ्रायं सौरेः सप्तर्षिमंडलम् ।\nसप्तर्षिभ्यः सहस्राणां शतादूर्ध्वं ध्रुवस्थितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004074016, "chapter_id": 24074, "verse_number": "४-२३-१७", "content_sanskrit": "पादगम्यं हि यत्किंचिद्वस्त्वस्ति धरणीतले ।\nतद्भूर्लोक इति ख्यातः साब्धिद्वीपाद्रिकाननम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004074017, "chapter_id": 24074, "verse_number": "४-२३-१८", "content_sanskrit": "भूर्लोकाच्च भुवर्लोको ब्रध्नावधिरुदाहृतः ।\nआदित्यादाध्रुवं विप्र स्वर्लोक इति गीयते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004074018, "chapter_id": 24074, "verse_number": "४-२३-१९", "content_sanskrit": "महर्लोकः क्षितेरूर्ध्वमेककोटिप्रमाणतः ।\nकोटिद्वये तु संख्यातो जनो भूर्लोकतो जनैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004074019, "chapter_id": 24074, "verse_number": "४-२३-२०", "content_sanskrit": "चतुष्कोटिप्रमाणस्तु तपोलोकोऽस्ति भूतलात् ।\nउपरिष्टात्क्षितेरष्टौ कोटयः सत्यमीरितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004074020, "chapter_id": 24074, "verse_number": "४-२३-२१", "content_sanskrit": "सत्यादुपरि वैकुंठो योजनानां प्रमाणतः ।\nभूर्लोकात्परिसंख्यातः कोटिषोडशसंमितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004074021, "chapter_id": 24074, "verse_number": "४-२३-२२", "content_sanskrit": "यत्रास्ते श्रीपतिः साक्षात्सर्वेषामभयप्रदः ।\nततस्तु षोडशगुणः कैलासोऽस्ति शिवालयः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004074022, "chapter_id": 24074, "verse_number": "४-२३-२३", "content_sanskrit": "पार्वत्या सहितः शंभुर्गजास्य स्कंद नंदिभिः ।\nयत्र तिष्ठति विश्वेशः सकलः स परः स्मूतः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004074023, "chapter_id": 24074, "verse_number": "४-२३-२४", "content_sanskrit": "तस्य देवस्य खेलोऽयं स्वलीला मूर्तिधारिणः ।\nस विश्वेश इति ख्यात स्तस्याज्ञाकृदिदं जगत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004074024, "chapter_id": 24074, "verse_number": "४-२३-२५", "content_sanskrit": "सर्वेषां शासकश्चासौ तस्य शास्ता न चापरः ।\nस्वयं सृजति भूतानि स्वयं पाति तथात्ति च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004074025, "chapter_id": 24074, "verse_number": "४-२३-२६", "content_sanskrit": "सर्वज्ञ एकः स प्रोक्तः स्वेच्छाधीन विचेष्टितः ।\nतस्य प्रवतर्कः कोपि नहि नैव निवर्तकः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004074026, "chapter_id": 24074, "verse_number": "४-२३-२७", "content_sanskrit": "अमूर्तं यत्परं ब्रह्म समूर्तं श्रुतिचोदितम् ।\nसर्वव्यापि सदा नित्यं सत्यं द्वैतविवर्जितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004074027, "chapter_id": 24074, "verse_number": "४-२३-२८", "content_sanskrit": "सर्वेभ्यः कारणेभ्यश्च परात्परतरं परम् ।\nआनंदं ब्रह्मणो रूपं श्रुतयो यत्प्रचक्षते ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004074028, "chapter_id": 24074, "verse_number": "४-२३-२९", "content_sanskrit": "संविदं तेन यं वेदा विष्णुर्वेद न वै विधिः ।\nयतो वाचो निवर्तंते ह्यप्राप्य मनसा सह ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004074029, "chapter_id": 24074, "verse_number": "४-२३-३०", "content_sanskrit": "स्वयंवेद्यः परं ज्योतिः सर्वस्य हृदि संस्थितः ।\nयोगिगम्यस्त्वनाख्येयो यः प्रमाणैकगोचरः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004074030, "chapter_id": 24074, "verse_number": "४-२३-३१", "content_sanskrit": "नानारूपोप्यरूपो यः सर्वगोपि न गोचरः ।\nअनंतोप्यंतक वपुः सर्ववित्कर्मवर्जितः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004074031, "chapter_id": 24074, "verse_number": "४-२३-३२", "content_sanskrit": "तस्येदमैश्वरं रूपं खंडचंद्रावतंसकम् ।\nतमालश्यामलगलं स्फुरद्भालविलोचनम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004074032, "chapter_id": 24074, "verse_number": "४-२३-३३", "content_sanskrit": "लसद्वामार्धनारीकं कृतशेषशुभांगदम् ।\nगंगातरंगसत्संग सदाधौतजटातटम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004074033, "chapter_id": 24074, "verse_number": "४-२३-३४", "content_sanskrit": "स्मरांगरजःपुंज पूजितावयवोज्ज्वलम् ।\nविचित्रगात्रविधृतमहाव्यालविभूषणम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004074034, "chapter_id": 24074, "verse_number": "४-२३-३५", "content_sanskrit": "महोक्षस्यंदनगमं विरुताजगवायुधम् ।\nगजाजिनोत्तरासंगं दशार्धवदनं शुभम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004074035, "chapter_id": 24074, "verse_number": "४-२३-३६", "content_sanskrit": "उत्त्रासित महामृत्यु महाबलगणावृतम् ।\nशरणार्थिकृतत्राणं नत निर्वाणकारणम् ।\nमनोरथपथातीतं वरदानपरायणम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004074036, "chapter_id": 24074, "verse_number": "४-२३-३७", "content_sanskrit": "तस्य तत्त्वस्वरूपस्य रूपातीतस्य भो द्विज ।\nपरावरे रुद्ररूपे सर्वेव्याप्यावतिष्ठत ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004074037, "chapter_id": 24074, "verse_number": "४-२३-३८", "content_sanskrit": "निराकारोपि साकारः शिव एव हि कारणम ।\nमुक्तये भुक्तये वापि न शिवान्मोक्षदो परः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004074038, "chapter_id": 24074, "verse_number": "४-२३-३९", "content_sanskrit": "यथा तेनाखिलं ह्येतत्पार्वतीपतिसात्कृतम ।\nइदं चराचरं सर्वं दृश्यादृश्यमरूपिणा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004074039, "chapter_id": 24074, "verse_number": "४-२३-४०", "content_sanskrit": "तथा मृडानीकांतेन विष्णुसादखिलंजगत ।\nविधाय क्रीड्यते विप्र नित्यं स्वच्छंद लीलया ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004074040, "chapter_id": 24074, "verse_number": "४-२३-४१", "content_sanskrit": "यथाशिवस्तथा विष्णुर्यथाविष्णुस्तथा शिवः ।\nअंतरं शिवविष्ण्वोश्च मनागपि न विद्यते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004074041, "chapter_id": 24074, "verse_number": "४-२३-४२", "content_sanskrit": "आहूय पूर्वं ब्रह्मादीन्समस्तान्देवतागणान् ।\nविद्याधरोरगादींश्च सिद्धगंधर्वचारणान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004074042, "chapter_id": 24074, "verse_number": "४-२३-४३", "content_sanskrit": "निजसिंहासनसमं कृत्वा सिंहासनं शुभम् ।\nउपवेश्य हरिं तत्र च्छत्रं कृत्वा मनोहरम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004074043, "chapter_id": 24074, "verse_number": "४-२३-४४", "content_sanskrit": "श्लक्ष्णं कोटिशलाकं च विश्वकर्मविनिर्मितम् ।\nपांडुरं रत्नदंडं च स्थूलमुक्तावलंबितम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004074044, "chapter_id": 24074, "verse_number": "४-२३-४५", "content_sanskrit": "कलशेन विचित्रेण ह्युपरिष्टाद्विराजितम् ।\nसहस्रयोजनायामं सर्वरत्नमयं शुभम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004074045, "chapter_id": 24074, "verse_number": "४-२३-४६", "content_sanskrit": "पट्टसूत्रमयैरम्यैश्चामरैश्च परिष्कृतम् ।\nराजाभिषेकयोग्यैश्च द्रव्यैः सर्वौषधादिभिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004074046, "chapter_id": 24074, "verse_number": "४-२३-४७", "content_sanskrit": "प्रत्यक्षतीर्थपाथोभिः पंचकुंभैर्मनोहरैः ।\nसिद्धार्थाक्षतदूर्वाभिर्मंत्रैः स्वयमुपस्थितैः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004074047, "chapter_id": 24074, "verse_number": "४-२३-४८", "content_sanskrit": "देवानां च तथर्षीणां सिद्धानां फणिनामपि ।\nआनीय मंगलकराः कन्याः षोडशषोडश ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004074048, "chapter_id": 24074, "verse_number": "४-२३-४९", "content_sanskrit": "वीणामृदंगाब्जभेरी मरु डिंडिमझर्झरैः ।\nआनकैः कांस्यतालाद्यै र्वाद्यैर्ललितगायनैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004074049, "chapter_id": 24074, "verse_number": "४-२३-५०", "content_sanskrit": "ब्रह्मघोषमहारावैरापूरितनभोंगणे ।\nशुभे तिथौ शुभे लग्ने ताराचंद्रबलान्विते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004074050, "chapter_id": 24074, "verse_number": "४-२३-५१", "content_sanskrit": "आबद्धमुकुटं रम्यं कृतकौतुकमंगलम् ।\nमृडानीकृतशृंगारं सुश्रिया सुश्रियायुतम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004074051, "chapter_id": 24074, "verse_number": "४-२३-५२", "content_sanskrit": "अभिषिच्य महेशेन स्वयं ब्रह्मांडमंडपे ।\nदत्तं समस्तमैश्वर्यं यन्निजं नान्यगामि च ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004074052, "chapter_id": 24074, "verse_number": "४-२३-५३", "content_sanskrit": "ततस्तुष्टाव देवेशः प्रमथैः सह शार्ङ्गिणम् ।\nब्रह्माणं लोककर्तारमुवाच च वचस्त्विदम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004074053, "chapter_id": 24074, "verse_number": "४-२३-५४", "content_sanskrit": "मम वंद्यस्त्वयं विष्णुः प्रणमत्वममुं हरिम् ।\nइत्युक्त्वाथ स्वयं रुद्रो ननाम गरुडध्वजम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004074054, "chapter_id": 24074, "verse_number": "४-२३-५५", "content_sanskrit": "ततो गणेश्वरैः सर्वैंर्ब्रह्मणा च मरुद्गणैः ।\nयोगिभिः सनकाद्यैश्च सिद्धैर्देवर्षिभिस्तथा ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004074055, "chapter_id": 24074, "verse_number": "४-२३-५६", "content_sanskrit": "विद्याधरैः सगंधर्वैर्यक्षरक्षोप्सरोगणैः ।\nगुह्यकैश्चारणैर्भूतैः शेष वासुकि तक्षकैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004074056, "chapter_id": 24074, "verse_number": "४-२३-५७", "content_sanskrit": "पतत्रिभिः किंनरैश्च सर्वैः स्थावरजंगमैः ।\nततो जयजयेत्युक्त्वा नमोस्त्विति नमोस्त्विति ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004074057, "chapter_id": 24074, "verse_number": "४-२३-५८", "content_sanskrit": "ततोहरिर्महेशेन संसदि द्युसदां तदा ।\nएतैर्महारवै रम्यैश्चानर्चि परमार्चिषा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004074058, "chapter_id": 24074, "verse_number": "४-२३-५९", "content_sanskrit": "त्वं कर्ता सर्वभूतानां पाता हर्ता त्वमेव च ।\nत्वमेव जगतां पूज्यस्त्वमेव जगदीश्वरः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004074059, "chapter_id": 24074, "verse_number": "४-२३-६०", "content_sanskrit": "दाता धर्मार्थकामानां शास्ता दुर्नयकारिणाम् ।\nअजेयस्त्वं च संग्रामे ममापि हि भविष्यसि ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004074060, "chapter_id": 24074, "verse_number": "४-२३-६१", "content_sanskrit": "इच्छाशक्तिः क्रियाशक्तिर्ज्ञानशक्तिस्तथोत्तमा ।\nशक्तित्रयमिदं विष्णो गृहाण प्रापितं मया ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004074061, "chapter_id": 24074, "verse_number": "४-२३-६२", "content_sanskrit": "त्वद्द्वेष्टारो हरे नूनं मया शास्याः प्रयत्नतः ।\nत्वद्भक्तानां मया विष्णो देयं निर्वाणमुत्तमम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004074062, "chapter_id": 24074, "verse_number": "४-२३-६३", "content_sanskrit": "मायां चापि गृहाणेमां दुष्प्रणोद्यां सुरासुरैः ।\nयया संमोहितं विश्वमकिंचिज्ज्ञं भविष्यति ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004074063, "chapter_id": 24074, "verse_number": "४-२३-६४", "content_sanskrit": "वामबाहुर्मदीयस्त्वं दक्षिणोसौ पितामहः ।\nअस्यापि हि विधेः पाता जनितापि भविष्यसि ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004074064, "chapter_id": 24074, "verse_number": "४-२३-६५", "content_sanskrit": "वैकुंठैश्वर्यमासाद्य हरेरित्थं हरः स्वयम् ।\nकैलासे प्रमथैः सार्धं स्वैरं क्रीडत्युमापतिः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004074065, "chapter_id": 24074, "verse_number": "४-२३-६६", "content_sanskrit": "तदा प्रभृति देवोसौ शार्ङ्गधन्वा गदाधरः ।\nत्रैलोक्यमखिलं शास्ति दानवांतकरो हरिः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004074066, "chapter_id": 24074, "verse_number": "४-२३-६७", "content_sanskrit": "इति ते कथिता विप्र लोकानां च परिस्थितिः ।\nइदानीं कथयिष्यावस्तवनिर्वाण कारणम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004074067, "chapter_id": 24074, "verse_number": "४-२३-६८", "content_sanskrit": "इदं तु परमाख्यानं शृणुयाद्यः समाहितः ।\nस्वर्लोकमभिगम्याथ काश्यां निर्वाणमाप्नुयात् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004074068, "chapter_id": 24074, "verse_number": "४-२३-६९", "content_sanskrit": "यज्ञोत्सवे विवाहे च मंगलेष्वखिलेष्वपि ।\nराज्याभिषेक समये देवस्थापनकर्मणि ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004074069, "chapter_id": 24074, "verse_number": "४-२३-७०", "content_sanskrit": "सर्वाधिकारदानेषु नववेश्मप्रवेशने ।\nपठितव्यं प्रयत्नेन तत्कार्य परिसिद्धये ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004074070, "chapter_id": 24074, "verse_number": "४-२३-७१", "content_sanskrit": "अपुत्रो लभते पुत्रमधनो धनवान्भवेत् ।\nव्याधितो मुच्यते रोगाद्बद्धो मुच्येत बंधनात् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004074071, "chapter_id": 24074, "verse_number": "४-२३-७२", "content_sanskrit": "जप्यमेतत्प्रयत्नेन सततं मंगलार्थिना ।\nअमंगलानां शमनं हरनारायणप्रियम ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]