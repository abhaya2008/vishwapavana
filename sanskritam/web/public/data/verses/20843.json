[{"id": 7000843000, "chapter_id": 20843, "verse_number": "६-१८६-१", "content_sanskrit": "महादेव उवाच ।\nअस्ति कोल्हापुरं नाम नगरं दक्षिणापथे ।\nसुखानां सदनं साध्वि साधूनां सिद्धिसंभवम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000843001, "chapter_id": 20843, "verse_number": "६-१८६-२", "content_sanskrit": "परशक्तेः परंपीठं सर्वदेवनिषेवितम् ।\nपुराणेषु प्रसिद्धं यद्भुक्तिमुक्तिफलप्रदम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000843002, "chapter_id": 20843, "verse_number": "६-१८६-३", "content_sanskrit": "कोटिशस्तत्र तीर्थानि शिवलिगानि कोटिशः ।\nआस्ते रुद्रगया यत्र विशालं लोकविश्रुतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000843003, "chapter_id": 20843, "verse_number": "६-१८६-४", "content_sanskrit": "तुंगाचलमहावप्र गोपुरोल्लासितोरणम् ।\nप्रासादशिखरे यत्र तुंगं च कनकध्वजम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000843004, "chapter_id": 20843, "verse_number": "६-१८६-५", "content_sanskrit": "सोमकांतिमहासौधवलभीपंक्तिशोभितम् ।\nजालरंध्रोद्गिरद्धूपधूमाऽमोदितदिक्तटम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000843005, "chapter_id": 20843, "verse_number": "६-१८६-६", "content_sanskrit": "चलत्पताकविस्तीर्णच्छायं देवालयान्वितम् ।\nचतुरैः सुंदरैः स्निग्धैः श्रीमद्भिः शुचिमानसैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000843006, "chapter_id": 20843, "verse_number": "६-१८६-७", "content_sanskrit": "अधिष्ठितं सदाचारैः पुरुषेर्भूरिभूषणैः ।\nकुरंगनयनाश्चंद्रवदनाः कुटिलालकाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000843007, "chapter_id": 20843, "verse_number": "६-१८६-८", "content_sanskrit": "उत्फुल्लचंपकच्छायाः पीनतुंगपयोधराः ।\nकृशमध्या निम्ननाभि वलित्रयविराजिताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000843008, "chapter_id": 20843, "verse_number": "६-१८६-९", "content_sanskrit": "विशालजघनाश्चारुजंघा युग्मा वरांघ्रयः ।\nवाचालमेखलादामनिक्वणन्मणिनूपुराः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000843009, "chapter_id": 20843, "verse_number": "६-१८६-१०", "content_sanskrit": "रणत्कंकणहस्ताब्ज स्फुरत्करज रश्मयः ।\nवसंति प्रमदा यत्र मादयंत्यो मुनीनपि ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000843010, "chapter_id": 20843, "verse_number": "६-१८६-११", "content_sanskrit": "समस्तवस्तुसंयुक्तं सर्वभोगसमन्वितम् ।\nमंगलैः सकलैर्युक्तं महालक्ष्मीसमन्वितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000843011, "chapter_id": 20843, "verse_number": "६-१८६-१२", "content_sanskrit": "तत्रागच्छत्पुमान्कश्चिद्युवा गौरं सुलोचनः ।\nकंबुकंठः पृथुस्कंधो महावक्षा महाभुजः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000843012, "chapter_id": 20843, "verse_number": "६-१८६-१३", "content_sanskrit": "समस्तलक्षणोपेतो गोचरासक्तमानसः ।\nप्रविश्य नगरं पश्यन्शोभां सौधेषु सर्वतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000843013, "chapter_id": 20843, "verse_number": "६-१८६-१४", "content_sanskrit": "उत्कंठितमना द्रष्टुंमहालक्ष्मीं सुरेश्वरीम् ।\nमणिकुंडे कृतः स्नानः संपन्न पितॄतर्पणः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000843014, "chapter_id": 20843, "verse_number": "६-१८६-१५", "content_sanskrit": "महालक्ष्मीं महामायां नत्वा तुष्टाव भक्तितः ।\nजयत्यपारकरुणाशरण्या जगदंबिका ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000843015, "chapter_id": 20843, "verse_number": "६-१८६-१६", "content_sanskrit": "कुर्वाणा जगतो जन्म पालनं क्षपणं दृशा ।\nयया शक्त्या कृतादिष्टः परमेष्ठी सृजत्यसौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000843016, "chapter_id": 20843, "verse_number": "६-१८६-१७", "content_sanskrit": "अवष्टभ्य च तां शक्तिं पालयत्यच्युतो जगत् ।\nयया शक्त्या कृतावेशः संहरत्यखिलं हरः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000843017, "chapter_id": 20843, "verse_number": "६-१८६-१८", "content_sanskrit": "तां भजे परमां शक्तिं सर्गस्थितिलयोर्जिताम् ।\nयोगिध्येयांघ्रिकमले कमले कमलालये ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000843018, "chapter_id": 20843, "verse_number": "६-१८६-१९", "content_sanskrit": "स्वभावानखिलान्नस्त्वं गृह्णासींद्रियगोचरान् ।\nत्वमेव कल्पनाजालं तत्कल्पं कुरुषे मनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000843019, "chapter_id": 20843, "verse_number": "६-१८६-२०", "content_sanskrit": "इच्छाज्ञानक्रियारूपा परसंवित्स्वरूपिणी ।\nनिष्फला निर्मला नित्या निराकारा निरंजना ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000843020, "chapter_id": 20843, "verse_number": "६-१८६-२१", "content_sanskrit": "निरंतरा निरातंका निरालंबा निरामया ।\nतवैवं महिमानं हि को वर्णयितुमीशते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000843021, "chapter_id": 20843, "verse_number": "६-१८६-२२", "content_sanskrit": "वंदे निर्भिन्नषट्चक्रद्वादशांतर्विहारिणीम् ।\nअनाहतध्वनिमयीं बिंदुनादकलात्मिकाम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000843022, "chapter_id": 20843, "verse_number": "६-१८६-२३", "content_sanskrit": "मातस्त्वं पूर्णशीतांशु गलत्पीयूषवाहिनी ।\nपुष्णासि वत्सले बालान्सनकादीन्दिगंबरान् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000843023, "chapter_id": 20843, "verse_number": "६-१८६-२४", "content_sanskrit": "अनुस्यूता शिवा संविज्जाग्रत्स्वप्नसुषुप्तिषु ।\nतुरीयायां वर्त्तमानां दयासूनृतसंधिषु ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000843024, "chapter_id": 20843, "verse_number": "६-१८६-२५", "content_sanskrit": "ददासि प्राणिनां सर्वाः सततं ब्रह्मसंपदः ।\nसंहृत्य तत्वसंघातं तुरीयातीतया त्वया ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000843025, "chapter_id": 20843, "verse_number": "६-१८६-२६", "content_sanskrit": "योगिनां बिंबतादत्म्यं दीयते निर्विकल्पया ।\nपरां नमामि पश्यंतीं मध्यमां वैखरीमपि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000843026, "chapter_id": 20843, "verse_number": "६-१८६-२७", "content_sanskrit": "रूपाणि देवि गृह्णासि जगत्संत्राणहेतवे ।\nत्वं ब्राह्मी वैष्णवी च त्वं माहेशी च त्वमंबिके ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000843027, "chapter_id": 20843, "verse_number": "६-१८६-२८", "content_sanskrit": "वाराहि त्वं महालक्ष्मीर्नारसिंही त्वमैंद्रिका ।\nत्वं कौमारी चंडिका त्वं लक्ष्मीस्त्वं विश्वपावनी ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000843028, "chapter_id": 20843, "verse_number": "६-१८६-२९", "content_sanskrit": "सावित्री त्वं जगन्माता शशिनी त्वं च रोहिणी ।\nत्वं स्वाहा त्वं स्वधा त्वं हि त्वं सुधा परमेश्वरी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000843029, "chapter_id": 20843, "verse_number": "६-१८६-३०", "content_sanskrit": "चंडमुंडभुजादंडखंडदोर्दंडमंडिते ।\nरक्तबीजगलद्रक्तपानघूर्णितलोचने ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000843030, "chapter_id": 20843, "verse_number": "६-१८६-३१", "content_sanskrit": "उन्मत्तमहिषग्रीवोन्मूलनप्रौढ दोर्युगे ।\nशुंभासुरमहादैत्यदारणायातविक्रमे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000843031, "chapter_id": 20843, "verse_number": "६-१८६-३२", "content_sanskrit": "अनंतचरिते तुभ्यं नमस्त्रैलोक्यमातृके ।\nभक्तकल्पलते मह्यं प्रसीद परमेश्वरि ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000843032, "chapter_id": 20843, "verse_number": "६-१८६-३३", "content_sanskrit": "इति तेन स्तुता देवी महालक्ष्मीस्ततः स्वयम् ।\nनिजरूपं समास्थाय पुरुषं प्रत्युवाच तम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000843033, "chapter_id": 20843, "verse_number": "६-१८६-३४", "content_sanskrit": "श्रीलक्ष्मीरुवाच ।\nराजपुत्र प्रसन्नाऽहं वृणीष्व वरमुत्तमम् ।\nराजपुत्र उवाच ।\nपिता मे धरणीपालो वाजिमेधं महाक्रतुम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000843034, "chapter_id": 20843, "verse_number": "६-१८६-३५", "content_sanskrit": "कुर्वाणो दैवयोगेन रोगाक्रांतो दिवं ययौ ।\nतद्वपुस्तप्ततैलेन शोषयित्वा मया ततः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000843035, "chapter_id": 20843, "verse_number": "६-१८६-३६", "content_sanskrit": "स्थापितस्तत्र यागोऽसौ यथापूर्वमवर्तत ।\nअथ क्रांतमहीचक्रो यूपे यागतुरंगमः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000843036, "chapter_id": 20843, "verse_number": "६-१८६-३७", "content_sanskrit": "निशीथे बंधनं हित्वा नीतः केनापि कुत्रचित् ।\nअदृष्ट्वा तद्गतं क्वापि निवृत्तेषु जनेष्वहम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000843037, "chapter_id": 20843, "verse_number": "६-१८६-३८", "content_sanskrit": "आमंत्र्य ऋत्विजः सर्वाञ्छरणं त्वामुपागतः ।\nप्रसन्ना यदि देवि त्वं तन्मे यागतुरंगमः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000843038, "chapter_id": 20843, "verse_number": "६-१८६-३९", "content_sanskrit": "दृष्टो भवतु यागोऽसौ संपूर्णो जायते यथा ।\nआनृण्यं मम तातस्य तेन राज्ञो भविष्यति ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000843039, "chapter_id": 20843, "verse_number": "६-१८६-४०", "content_sanskrit": "तथा कुरु जगद्धात्रि शरणागतवत्सले ।\nदेव्युवाच ।\nममद्वारं द्विजः सिद्धसमाधिरिति विश्रुतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000843040, "chapter_id": 20843, "verse_number": "६-१८६-४१", "content_sanskrit": "ममाज्ञया स ते सर्वं कार्यं निष्पादयिष्यति ।\nइत्युक्तः श्रीमहालक्ष्म्या ततो राजकुमारकः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000843041, "chapter_id": 20843, "verse_number": "६-१८६-४२", "content_sanskrit": "आजगाम मुनिः सिद्धसमाधिर्यत्र तिष्ठति ।\nप्रणम्य तस्यपादाब्जं कृतांजलिरवस्थितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000843042, "chapter_id": 20843, "verse_number": "६-१८६-४३", "content_sanskrit": "तमुवाच ततो विप्रः प्रहितोऽसि त्वमंबया ।\nत्वदीप्सितमिदं सर्वं साधयामि विलोकय ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000843043, "chapter_id": 20843, "verse_number": "६-१८६-४४", "content_sanskrit": "इत्युक्त्वा त्रिदशान्सर्वानाचकर्ष स मांत्रिकः ।\nएक्षत क्षितिपालस्य तनयोऽसौ तदा सुरान् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000843044, "chapter_id": 20843, "verse_number": "६-१८६-४५", "content_sanskrit": "कृतांजलिपुटान्देवान्वेपमानकलेवरान् ।\nअथ तानमरान्सर्वान्संबभाषे द्विजोत्तमः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000843045, "chapter_id": 20843, "verse_number": "६-१८६-४६", "content_sanskrit": "अमुष्य राजपुत्रस्य वाजी यज्ञाय कल्पितः ।\nनीतोस्ति देवराजेन क्षपायामपहृत्य सः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000843046, "chapter_id": 20843, "verse_number": "६-१८६-४७", "content_sanskrit": "गीर्वाणा अश्वमेवास्य समानयत मा चिरम् ।\nअथ तस्य मुनेर्वाक्याद्देवैर्यज्ञतुरंगमः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000843047, "chapter_id": 20843, "verse_number": "६-१८६-४८", "content_sanskrit": "समर्पितस्ततस्तेन तेऽनुज्ञात्वा दिवौकसः ।\nआकृष्टानमरान्दृष्ट्वा गतं लब्ध्वा तुरंगमम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000843048, "chapter_id": 20843, "verse_number": "६-१८६-४९", "content_sanskrit": "महीपतिसुतो नत्वा तं मुनिं वाक्यमब्रवीत् ।\nआश्चर्यमिदमेतत्ते सामर्थ्यमृषिसत्तम ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000843049, "chapter_id": 20843, "verse_number": "६-१८६-५०", "content_sanskrit": "कृतं त्वया चित्रमिदं त्रिदशाकर्षणं क्षणात् ।\nहस्तादाकृष्य दत्तो मे यज्ञीयोऽयं तुरंगमः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000843050, "chapter_id": 20843, "verse_number": "६-१८६-५१", "content_sanskrit": "न किंचिदपरं यावद्दुष्करं यत्सुरैरपि ।\nप्रभविष्यति तत्कर्तुं भवानेव न चापरः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000843051, "chapter_id": 20843, "verse_number": "६-१८६-५२", "content_sanskrit": "शृणु विप्र महीपाल पितासीन्मेबृहद्रथः ।\nप्रारब्ध हयमेधोऽसौ दैवेन निधनं गतः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000843052, "chapter_id": 20843, "verse_number": "६-१८६-५३", "content_sanskrit": "अद्यापि तस्य देहोस्ति तप्ततैलेन शोषितः ।\nतस्य संजीवनं भूयः कर्त्तुमर्हसि सत्तम ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000843053, "chapter_id": 20843, "verse_number": "६-१८६-५४", "content_sanskrit": "इत्याकर्ण्य स्मितं कृत्वा स जगाद महामुनिः ।\nयामस्तत्र पिता यत्र तावको यागमंडपः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000843054, "chapter_id": 20843, "verse_number": "६-१८६-५५", "content_sanskrit": "अथागत्य समं तेन तत्र सिद्धः समाधिना ।\nपयोऽभिमंत्र्य विदधे तस्य प्रेतस्य मूर्द्धनि ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000843055, "chapter_id": 20843, "verse_number": "६-१८६-५६", "content_sanskrit": "ततः प्राप नृपः संज्ञामुत्तस्थे वै ददर्श च ।\nस तं पप्रच्छ विप्रेंद्रं कोऽसि धर्मेति भूपतिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000843056, "chapter_id": 20843, "verse_number": "६-१८६-५७", "content_sanskrit": "ततो राजसुतः सर्वं भूपालाय न्यवेदयत् ।\nस नत्वा ब्राह्मणं राजा तं पुनर्दत्तजीवितम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000843057, "chapter_id": 20843, "verse_number": "६-१८६-५८", "content_sanskrit": "बभाषे केन पुण्येन त्वयि शक्तिरलौकिकी ।\nयया मे जीवितं दत्तमाकृष्टाश्च दिवौकसः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000843058, "chapter_id": 20843, "verse_number": "६-१८६-५९", "content_sanskrit": "यागश्चोद्धरितो विप्र येनमेतन्निरूपय ।\nइत्युक्तस्तेनविप्रोऽसौ जगाद श्लक्ष्णया गिरा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000843059, "chapter_id": 20843, "verse_number": "६-१८६-६०", "content_sanskrit": "गीतानां द्वादशाध्यायं जपाम्यहमतंद्रितः ।\nतेन शक्तिरियं राजन्यया प्राप्तोसि जीवितम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000843060, "chapter_id": 20843, "verse_number": "६-१८६-६१", "content_sanskrit": "एतदाकर्ण्य राजाऽसौ द्वादशाध्यायमुत्तमम् ।\nपपाठ तस्माद्विप्रर्षेः सकाशात्ब्राह्मणान्वितम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000843061, "chapter_id": 20843, "verse_number": "६-१८६-६२", "content_sanskrit": "तस्याध्यायस्य माहत्म्यात्ते सर्वे सद्गतिं ययुः ।\nअन्ये पठित्वा जीवाश्च मुक्तिमापुरहो पराम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]