[{"id": 2178603, "chapter_id": 4778, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178604, "chapter_id": 4778, "verse_number": "१", "content_sanskrit": "आवन्त्यं भीमसेनेन भक्षयन्ति निपातितम् ।\nगृध्रगोमायवः शूरं बहुबन्धुमबन्धुवत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178605, "chapter_id": 4778, "verse_number": "२", "content_sanskrit": "तं पश्य कदनं कृत्वा शत्रूणां मधुसूदन ।\nशयानं वीरशयने रुधिरेण समुक्षितम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178606, "chapter_id": 4778, "verse_number": "३", "content_sanskrit": "तं सृगालाश्च कङ्काश्च क्रव्यादाश्च पृथग्विधाः ।\nतेन तेन विकर्षन्ति पश्य कालस्य पर्ययम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178607, "chapter_id": 4778, "verse_number": "४", "content_sanskrit": "शयानं वीरशयने शूरमाक्रन्दकारिणम् ।\nआवन्त्यमभितो नार्यो रुदन्त्यः पर्युपासते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178608, "chapter_id": 4778, "verse_number": "५", "content_sanskrit": "प्रातिपेयं महेष्वासं हतं भीमेन बाह्लिकम् ।\nप्रसुप्तमिव शार्दूलं पश्य कृष्ण मनस्विनम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178609, "chapter_id": 4778, "verse_number": "६", "content_sanskrit": "अतीव मुखवर्णोऽस्य निहतस्यापि शोभते ।\nसोमस्येवाभिपूर्णस्य पौर्णमास्यां समुद्यतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178610, "chapter_id": 4778, "verse_number": "७", "content_sanskrit": "पुत्रशोकाभितप्तेन प्रतिज्ञां चैव रक्षता ।\nपाकशासनिना सङ्खे वार्धक्षत्रिर्निपातितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178611, "chapter_id": 4778, "verse_number": "८", "content_sanskrit": "एकादश चमूभर्त्रा रक्ष्यमाणं महात्मना ।\nसत्यं चिकीर्षता पश्य हतमेनं जयद्रथम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178612, "chapter_id": 4778, "verse_number": "९", "content_sanskrit": "सिन्धुसौवीरभर्तारं दर्पपूर्णं मनस्विनम् ।\nभक्षयन्ति शिवा गृध्रा जनार्दन जयद्रथम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178613, "chapter_id": 4778, "verse_number": "१०", "content_sanskrit": "संरक्ष्यमाणं भार्याभिरनुरक्ताभिरच्युत ।\nभषन्तोऽप्यपकर्षन्ति गहनं निम्नमन्तिकात्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178614, "chapter_id": 4778, "verse_number": "११", "content_sanskrit": "तमेताः पर्युपासन्ते वीक्षमाणा महाभुजम् ।\nसिन्धसौवीरकाम्भोजगान्धारयवनस्त्रियः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178615, "chapter_id": 4778, "verse_number": "१२", "content_sanskrit": "यदा कृष्णामुपादाय प्राद्रवत् केकयैः सह ।\nतदैव वध्यः पाण्डूनां जनार्दन जयद्रथः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178616, "chapter_id": 4778, "verse_number": "१३", "content_sanskrit": "दुःशलां मानयद्भिस्तु तदा मुक्तो जयद्रथः ।\nकथमद्य न तां कृष्ण मानयन्ति स्म ते सुताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178617, "chapter_id": 4778, "verse_number": "१४", "content_sanskrit": "सैन्धवं मे सुता बाला प्रलपन्तीव दुःखिता ।\nप्रमापयति चात्मानं प्राक्रोशन्ती च पाण्डवान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178618, "chapter_id": 4778, "verse_number": "१५", "content_sanskrit": "किं नु दुःखतरं कृष्ण परं मम भविष्यति ।\nयत् सुता विधवा बाला स्नुषाश्च निहतेश्वराः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178619, "chapter_id": 4778, "verse_number": "१६", "content_sanskrit": "अहो धिग् दुःशलां पश्य वीतशोकभयादिव ।\nभर्तुः शिर अपश्यन्तीं धावमानामितस्ततः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178620, "chapter_id": 4778, "verse_number": "१७", "content_sanskrit": "वारयामास यः सर्वान् पाण्डवान् पुत्रगर्धिनः ।\nस हत्वा विशिखैः सेनां स्वयं मृत्युवशं गतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178621, "chapter_id": 4778, "verse_number": "१८", "content_sanskrit": "तं सुप्तमिव मातङ्गं वीरं परमदुर्जयम् ।\nपरिवार्य रुदन्त्येताः स्त्रियश्चन्द्रोपमाननाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178622, "chapter_id": 4778, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nसैन्धवदर्शनं नाम द्वाविंशोऽध्यायः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178623, "chapter_id": 4778, "verse_number": "", "content_sanskrit": "स्त्रीपर्वणि सप्तमोऽध्यायः ॥७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]