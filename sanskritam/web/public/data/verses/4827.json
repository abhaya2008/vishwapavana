[{"id": 2180616, "chapter_id": 4827, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2180617, "chapter_id": 4827, "verse_number": "१", "content_sanskrit": "ततो विसर्जयामास सर्वाः प्रकृतयो नृपः ।\nविविशुश्चाभ्यनुज्ञाता यथास्वानि गृहाणि च\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2180618, "chapter_id": 4827, "verse_number": "२", "content_sanskrit": "ततो युधिष्ठिरो राजा भीमं भीमपराक्रमम् ।\nसान्त्वयन्नब्रवीद् धीमानर्जुनं यमजौ तथा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2180619, "chapter_id": 4827, "verse_number": "३", "content_sanskrit": "शत्रुभिर्विविधैः शस्त्रैः कृत्तदेहा महारणे ।\nश्रान्ता भवन्तः सुभृशं तापिताः शोकमन्युभिः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2180620, "chapter_id": 4827, "verse_number": "४", "content_sanskrit": "अरण्ये दुःखवसतीर्मत्कृते पुरुषोत्तमाः ।\nभवद्भिरनुभूताश्च यथा कुपुरुषैस्तथा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2180621, "chapter_id": 4827, "verse_number": "५", "content_sanskrit": "यथासुखं यथाजोषं जयोऽयमनुभूयताम् ।\nविश्रान्ताँल्लब्धविज्ञानान् श्वः समेतास्मि वः पुनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2180622, "chapter_id": 4827, "verse_number": "६", "content_sanskrit": "ततो दुर्योधनगृहं प्रासादैरुपशोभितम् ।\nबहुरत्नसमाकीर्णं दासीदाससमाकुलम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2180623, "chapter_id": 4827, "verse_number": "७", "content_sanskrit": "धृतराष्ट्राभ्यनुज्ञातं भ्रात्रा दत्तं वृकोदरः ।\nप्रतिपेदे महाबाहुर्मन्दरं मघवानिव\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2180624, "chapter_id": 4827, "verse_number": "८", "content_sanskrit": "यथा दुर्योधनगृहं तथा दुःशासनस्य च ।\nप्रासादमालासंयुक्तं हेमतोरणभूषितम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2180625, "chapter_id": 4827, "verse_number": "९", "content_sanskrit": "दासीदाससुसम्पूर्णं प्रभूतधनधान्यवत् ।\nप्रतिपेदे महाबाहुरर्जुनो राजशासनात्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2180626, "chapter_id": 4827, "verse_number": "१०", "content_sanskrit": "दुर्मर्षणस्य भवनं दुःशासनगृहाद् वरम् ।\nकुबेरभवनप्रख्यं मणिहेमविभूषितम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2180627, "chapter_id": 4827, "verse_number": "११", "content_sanskrit": "नकुलाय वरार्हाय कर्शिताय महावने ।\nददौ प्रीतो महाराज धर्मराजो युधिष्ठिरः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2180628, "chapter_id": 4827, "verse_number": "१२", "content_sanskrit": "दुर्मुखस्य च वेश्माग्र्यं श्रीमत्कनकभूषितम् ।\nपूर्णं पद्मदलाक्षीणां स्त्रीणां शयनसङ्कुलम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2180629, "chapter_id": 4827, "verse_number": "१३", "content_sanskrit": "प्रददौ सहदेवाय सततं प्रियकारिणे ।\nमुमुदे तच्च लब्ध्वा स कैलासं धनदो यथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2180630, "chapter_id": 4827, "verse_number": "१४", "content_sanskrit": "युयुत्सुर्विदुरश्चैव सञ्जयश्च महामतिः ।\nसुधर्मा चैव धौम्यश्च यथास्वं जग्मुरालयान्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2180631, "chapter_id": 4827, "verse_number": "१५", "content_sanskrit": "सह सात्यकिना शौरिरर्जुनस्य निवेशनम् ।\nविवेश पुरुषव्याघ्रो व्याघ्रो गिरिगुहामिव\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2180632, "chapter_id": 4827, "verse_number": "१६", "content_sanskrit": "तत्र भक्षान्नपानैस्ते समुपेताः सुखोषिताः ।\nसुखप्रबुद्धा राजानमुपतस्थुर्युधिष्ठिरम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2180633, "chapter_id": 4827, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे चतुःश्चत्वारिंशोऽध्यायः ॥ ४४ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]