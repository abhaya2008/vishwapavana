[{"id": 5000627000, "chapter_id": 9627, "verse_number": "७-९२-१", "content_sanskrit": "तत्सर्वमखिलेनाशु प्रस्थाप्य भरताग्रजः ।\nहयं लक्षणसम्पन्नं कृष्णसारं मुमोच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000627001, "chapter_id": 9627, "verse_number": "७-९२-२", "content_sanskrit": "ऋत्विग्भिर्लक्ष्मणं सार्धमश्वतन्त्रे नियोज्य च ।\nततो ऽभ्यगच्छत्काकुत्स्थः सह सैन्येन नैमिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000627002, "chapter_id": 9627, "verse_number": "७-९२-३", "content_sanskrit": "यज्ञवाटं महाबाहुर्दृष्ट्वा परममद्भुतम् ।\nप्रबर्षमतुलं लेभे श्रीमानिति वचो ऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000627003, "chapter_id": 9627, "verse_number": "७-९२-४", "content_sanskrit": "नैमिषे वसतस्तस्य सर्व एव नराधिपाः ।\nआनिन्युरुपहारांश्च तान्रामः प्रत्यपूजयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000627004, "chapter_id": 9627, "verse_number": "७-९२-५", "content_sanskrit": "उपकार्या महार्हाश्च पार्थिवानां महात्मनाम् ।\nसानुगानां नरश्रेष्ठो व्यादिदेश महामतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000627005, "chapter_id": 9627, "verse_number": "७-९२-६", "content_sanskrit": "अन्नपानानि वस्त्राणि सानुगानां महात्मनाम् ।\nभरतः सन्ददावाशु शत्रुघ्नसहितस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000627006, "chapter_id": 9627, "verse_number": "७-९२-७", "content_sanskrit": "वानराश्च महात्मानः सुग्रीवसहितास्तदा ।\nविप्राणां प्रणताः सर्वे चक्रिरे परिवेषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000627007, "chapter_id": 9627, "verse_number": "७-९२-८", "content_sanskrit": "बिभीषणश्च रक्षोभिर्बहुभिः स्रग्विभिर्वृतः ।\nऋषीणामुग्रतपसां पूजां चक्रे महात्मनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000627008, "chapter_id": 9627, "verse_number": "७-९२-९", "content_sanskrit": "एवं सुविहितो यज्ञो हयमेधो ऽभ्यवर्तत ।\nलक्ष्मणेनागुप्ता च हयचर्या प्रवर्तत ।\nईदृशं राजसिंहस्य यज्ञप्रवरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000627009, "chapter_id": 9627, "verse_number": "७-९२-१०", "content_sanskrit": "नान्यः शब्दो ऽभवत्तत्र हयमेधे महात्मनः ।\nछन्दतो देहि विस्रब्धो यावत्तुष्यन्ति याचकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000627010, "chapter_id": 9627, "verse_number": "७-९२-११", "content_sanskrit": "तावत्सर्वाणि दत्तानि क्रतुमध्ये महात्मनः ।\nविविधानि च गौडानि खाण्डवानि तथैव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000627011, "chapter_id": 9627, "verse_number": "७-९२-१२", "content_sanskrit": "न निस्सृतं भतत्योष्ठाद्वचनं यावदर्थिनाम् ।\nतावद्वानररक्षोभिर्दत्तमेवाभ्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000627012, "chapter_id": 9627, "verse_number": "७-९२-१३", "content_sanskrit": "न कश्चिन्मलिनस्तत्र दीनो वा ऽप्यथ कृर्शतः ।\nतस्मिन्यज्ञवरे राज्ञो हृष्टपुष्टजनावृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000627013, "chapter_id": 9627, "verse_number": "७-९२-१४", "content_sanskrit": "ये च तत्र महात्मानो मुनयश्चिरजीविनः ।\nनास्मरंस्तादृशं यज्ञं नाप्यासीत् स कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000627014, "chapter_id": 9627, "verse_number": "७-९२-१५", "content_sanskrit": "यः कृत्यवान्सुवर्णेन सुवर्णं लभते स्म सः ।\nवित्तार्थी लभते वित्तं रत्नार्थी रत्नमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000627015, "chapter_id": 9627, "verse_number": "७-९२-१६", "content_sanskrit": "रजतानां सुवर्णानामश्मनामथ वाससाम् ।\nअनिशं दीयमानानां राशिः समुपदृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000627016, "chapter_id": 9627, "verse_number": "७-९२-१७", "content_sanskrit": "न शक्रस्य धनेशस्य यमस्य वरुणस्य वा ।\nईदृशो दृष्टपूर्वो न एवमूचुस्तपोधनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000627017, "chapter_id": 9627, "verse_number": "७-९२-१८", "content_sanskrit": "सर्वत्र वानरास्तस्थुः सर्वत्रैव च राक्षसाः ।\nवासोधनान्नमर्थिभ्यः पूर्णहस्ता ददुर्भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000627018, "chapter_id": 9627, "verse_number": "७-९२-१९", "content_sanskrit": "ईदृशो राजसिंहस्य यज्ञः सर्वगुणान्वितः ।\nसंवत्सरमथो साग्रं वर्तते न च हीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000627019, "chapter_id": 9627, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे द्विनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]