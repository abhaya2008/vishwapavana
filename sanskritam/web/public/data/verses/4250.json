[{"id": 2149979, "chapter_id": 4250, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149980, "chapter_id": 4250, "verse_number": "१", "content_sanskrit": "तमहं स्मयन्निव रणे प्रत्यभाषं व्यवस्थितम् ।\nभूमिष्ठं नोत्सहे योद्धुं भवन्तं रथमास्थितः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149981, "chapter_id": 4250, "verse_number": "२", "content_sanskrit": "आरोह स्यन्दनं वीर कवचं च महाभुज ।\nबधान समरे राम यदि योद्धुमिहेच्छसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149982, "chapter_id": 4250, "verse_number": "३", "content_sanskrit": "ततो मामब्रवीद् रामः स्मयमानो रणाजिरे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149983, "chapter_id": 4250, "verse_number": "४", "content_sanskrit": "रथो मे मेदिनी वीर वाहा वेदाः सदश्ववत् ।\nसूतश्च मातरिश्वा वै कवचं वेदमातरः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149984, "chapter_id": 4250, "verse_number": "५", "content_sanskrit": "सुसंवीतो रणे ताभिर्योत्स्येऽहं कुरुनन्दन\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149985, "chapter_id": 4250, "verse_number": "६", "content_sanskrit": "एवं ब्रुवाणो गान्धारे रामो मां सत्यविक्रमः ।\nशरव्रातेन महता सर्वतः प्रत्यवारयत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149986, "chapter_id": 4250, "verse_number": "७", "content_sanskrit": "ततोऽपश्यं जामदग्न्यं रथे दिव्ये व्यवस्थितम् ।\nसर्वायुधधरे श्रीमत्यद्भुतोपमदर्शने\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149987, "chapter_id": 4250, "verse_number": "८", "content_sanskrit": "मनसा विहिते पुण्ये विस्तीर्णे नगरोपमे ।\nदिव्याश्वयुजि सन्नद्धे कवचेन विभूषिते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149988, "chapter_id": 4250, "verse_number": "९", "content_sanskrit": "ध्वजेन च महाबाहो सोमार्ककृतलक्ष्मणा ।\nधनुर्धरो बद्धतूणो बद्धगोधाङ्गुलित्रवान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149989, "chapter_id": 4250, "verse_number": "१०", "content_sanskrit": "सारथ्यं कृतवांस्तत्र युयुत्सोरकृतव्रणः ।\nसखा वेदविदत्यन्तं दयितो भार्गवस्य ह\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149990, "chapter_id": 4250, "verse_number": "११", "content_sanskrit": "आह्वयानः स मां युद्धे मनो हर्षयतीव मे ।\nपुनः पुनरपि क्रोशन् उपायान्मां हि भार्गवः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149991, "chapter_id": 4250, "verse_number": "१२", "content_sanskrit": "तमादित्यमिवोद्यन्तमनाधृष्यं महाबलम् ।\nक्षत्रियान्तकरं राममेकमेकः समासदम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149992, "chapter_id": 4250, "verse_number": "१३", "content_sanskrit": "ततोऽहं बाणपातेषु त्रिषु वाहान् निगृह्य वै\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149993, "chapter_id": 4250, "verse_number": "१४", "content_sanskrit": "अवतीर्य धनुर्न्यस्य पदातिर्ऋषिसत्तमम् ।\nअभ्यगच्छं तदा राममर्चिष्यन् द्विजसत्तमम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149994, "chapter_id": 4250, "verse_number": "१५", "content_sanskrit": "अभिवाद्य चैनं विधिवदब्रवं वाक्यमुत्तमम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2149995, "chapter_id": 4250, "verse_number": "१६", "content_sanskrit": "योत्स्ये त्वया रणे राम विशिष्टेनाधिकेन च ।\nगुरुणा धर्मशीलेन जयमाशास्व मे विभो\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2149996, "chapter_id": 4250, "verse_number": "", "content_sanskrit": "रामः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2149997, "chapter_id": 4250, "verse_number": "१७", "content_sanskrit": "एवमेतत् कुरुश्रेष्ठ कर्तव्यं भूतिमिच्छता ।\nधर्मो ह्येष महाबाहो विशिष्टैः सह युध्यताम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2149998, "chapter_id": 4250, "verse_number": "१८", "content_sanskrit": "शपेयं त्वां न चेदेवमागच्छेथा विशाम्पते ।\nयुध्यस्व त्वं रणे यत्तो धैर्यमालम्ब्य कौरव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2149999, "chapter_id": 4250, "verse_number": "१९", "content_sanskrit": "न तु ते जयमाशंसे त्वां विजेतुमहं स्थितः ।\nगच्छ युध्यस्व धर्मेण प्रीतोऽस्मि चरितेन ते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2150000, "chapter_id": 4250, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2150001, "chapter_id": 4250, "verse_number": "२०", "content_sanskrit": "ततोऽहं तं नमस्कृत्य रथमारुह्य सत्वरः ।\nप्राध्मापयं रणे शङ्खं पुनर्हेमपरिष्कृतम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2150002, "chapter_id": 4250, "verse_number": "२१", "content_sanskrit": "ततो युद्धं समभवन्मम तस्य च भारत ।\nदिवसान् सुबहून् राजन् परस्परजिगीषया\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2150003, "chapter_id": 4250, "verse_number": "२२", "content_sanskrit": "स मे तस्मिन् रणे पूर्वं प्राहरत् कङ्कपत्रिभिः ।\nषष्ठ्या शतैश्च नवभिः शराणामग्निवर्चसाम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2150004, "chapter_id": 4250, "verse_number": "२३", "content_sanskrit": "चत्वारस्तेन मे वाहाः सूतश्चैव विशाम्पते ।\nप्रतिरुद्धास्तथैवाहं समरे दंसितः स्थितः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2150005, "chapter_id": 4250, "verse_number": "२४", "content_sanskrit": "नमस्कृत्य च देवेभ्यो ब्राह्मणेभ्यो विशेषतः ।\nतमहं स्मयन्निव रणे प्रत्यभाषं व्यवस्थितम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2150006, "chapter_id": 4250, "verse_number": "२५", "content_sanskrit": "आचार्यता मानिता मे निर्मर्यादे ह्यपि त्वयि ।\nभूयश्च शृणु मे ब्रह्मन् संवादं धर्मसङ्ग्रहे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2150007, "chapter_id": 4250, "verse_number": "२६", "content_sanskrit": "एते वेदाः शरीरस्था ब्राह्मण्यं यच्च ते महत् ।\nतपश्च सुमहत् तप्तं न तेभ्यः प्रहराम्यहम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2150008, "chapter_id": 4250, "verse_number": "२७", "content_sanskrit": "प्रहरे क्षत्रधर्मं तं यं त्वं राम समाश्रितः ।\nब्राह्मणः क्षत्रियत्वं हि याति शस्त्रसमुद्यमात्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2150009, "chapter_id": 4250, "verse_number": "२८", "content_sanskrit": "पश्य मे धनुषो वीर्यं पश्य बाह्वोर्बलं च मे ।\nएष ते कार्मुकं वीर द्विधा कुर्यां ससायकम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2150010, "chapter_id": 4250, "verse_number": "२९", "content_sanskrit": "तस्याहं निशितं भल्लं प्राहिण्वं भरतर्षभ ।\nतेनास्य धनुषः कोटिः छिन्ना भूमिमथागमत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2150011, "chapter_id": 4250, "verse_number": "३०", "content_sanskrit": "नव चापि पृषत्कानां शतानि नतपर्वणाम् ।\nप्राहिण्वं कङ्कपत्राणां जामदग्न्यरथं प्रति\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2150012, "chapter_id": 4250, "verse_number": "३१", "content_sanskrit": "काये निषक्तास्तु तदा वायुना समुदीरिताः ।\nचेलुः क्षरन्तो रुधिरं नागा इव वसुन्धराम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2150013, "chapter_id": 4250, "verse_number": "३२", "content_sanskrit": "क्षतजोक्षितसर्वाङ्गः क्षरन् स रुधिरं रणे ।\nबभौ रामस्तदा राजन् मेरुर्धातूनिवोत्सृजन्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2150014, "chapter_id": 4250, "verse_number": "३३", "content_sanskrit": "हेमन्तान्तेऽशोक इव रक्तस्तबकमण्डितः ।\nबभौ रामस्तदा राजन् क्वचित् किंशुकसन्निभः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2150015, "chapter_id": 4250, "verse_number": "३४", "content_sanskrit": "ततोऽन्यद् धनुरादाय रामः क्रोधसमन्वितः ।\nहेमपुङ्खान् सुनिशितान् शरांस्तान् प्रववर्ष सः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2150016, "chapter_id": 4250, "verse_number": "३५", "content_sanskrit": "ते समासाद्य मां रौद्रा बहुधा मर्मभेदिनः ।\nअकम्पयन् महावेगाः सर्पाननविषोपमाः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2150017, "chapter_id": 4250, "verse_number": "३६", "content_sanskrit": "तमहं समवष्टभ्य पुनरात्मानमाहवे ।\nशतसङ्ख्यैः शरैः क्रुद्धस्तदा राममवाकिरम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2150018, "chapter_id": 4250, "verse_number": "३७", "content_sanskrit": "स तैरग्न्यर्कसङ्काशैः शरैराशीविषोपमैः ।\nशितैरभ्यर्दितो रामो मन्दचेता इवाभवत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2150019, "chapter_id": 4250, "verse_number": "३८", "content_sanskrit": "ततोऽहं कृपयाऽऽविष्टो विनिन्द्यात्मानमात्मना ।\nधिग्धिगित्यब्रवं युद्धं क्षत्रधर्मं च भारत\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2150020, "chapter_id": 4250, "verse_number": "३९", "content_sanskrit": "असकृच्चाब्रवं राजन् शोकवेगपरिप्लुतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2150021, "chapter_id": 4250, "verse_number": "४०", "content_sanskrit": "अहो बत कृतं पापं मयेदं क्षत्रधर्मणा ।\nगुरुर्द्विजातिर्धर्मात्मा यदेवं पीडितः शरैः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2150022, "chapter_id": 4250, "verse_number": "४१", "content_sanskrit": "ततोऽहं प्राहरं भूयो जामदग्न्याय भारत\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2150023, "chapter_id": 4250, "verse_number": "४२", "content_sanskrit": "अथापतत् स पृथिवीं पूषा दिवससङ्क्षये ।\nजगामास्तं सहस्रांशुः ततो युद्धमुपारमत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2150024, "chapter_id": 4250, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकाशीत्युत्तरशततमोऽध्यायः ॥१८१॥\nअम्बोपाख्यानपर्वणि एकादशोऽध्यायः ॥११॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]