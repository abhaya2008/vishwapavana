[{"id": 900004215, "chapter_id": 8325, "verse_number": "1.1", "content_sanskrit": "अशेषगुरुमीशेशं नारायणमनामयम् । सम्प्रणम्य प्रवक्ष्यामि प्रमाणानां स्वलक्षणम् ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004216, "chapter_id": 8325, "verse_number": "1.2", "content_sanskrit": "नारायणस्यैव नमस्कारे को हेतुरित्यत उक्तम् ।। अशेष-गुरुमिति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}]