[{"id": 2112741, "chapter_id": 3430, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112742, "chapter_id": 3430, "verse_number": "१", "content_sanskrit": "धृतराष्ट्रे च पाण्डौ च विदुरे च महात्मनि ।\nतेषु त्रिषु कुमारेषु जातेषु कुरुजाङ्गलम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112743, "chapter_id": 3430, "verse_number": "२", "content_sanskrit": "कुरवोऽथ कुरुक्षेत्रं त्रयमेतदवर्घत ।\nयथर्तुवर्षी पर्जन्यो बहुपुष्पफला द्रुमाः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112744, "chapter_id": 3430, "verse_number": "३", "content_sanskrit": "वाहनानि प्रहृष्टानि मुदिता मृगपक्षिणः ।\nरूढसस्याऽभवद् भूमिः सस्यानि फलवन्ति च \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112745, "chapter_id": 3430, "verse_number": "४", "content_sanskrit": "गन्धवन्ति च माल्यानि पुष्पाणि रसवन्ति च ।\nवणिग्भिश्चोपकीर्यन्ते नगराण्यथ शिल्पिभिः \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112746, "chapter_id": 3430, "verse_number": "५", "content_sanskrit": "शूराश्च कृतविद्याश्च सन्तश्च सुखिनोऽभवन् ।\nनाभवत् कृपणः कश्चिन्न काचिद् विधवाऽभवत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112747, "chapter_id": 3430, "verse_number": "६", "content_sanskrit": "नाभवन् दस्यवः केचिन्नाधर्मरुचयो जनाः ।\nप्रदेशेष्वपि राष्ट्राणां कृतं युगमवर्तत \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112748, "chapter_id": 3430, "verse_number": "७", "content_sanskrit": "तन्महोदधिसङ्काशं नगरं बह्वशोभत ।\nद्वारतोरणनिर्व्यूहैश्छन्नमभ्रं घनैरिव \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112749, "chapter_id": 3430, "verse_number": "८", "content_sanskrit": "प्रासादशतसम्बाधं महेन्द्रपुरसन्निभम् ।\nनदीपादपषण्डेषु वापीपल्वलसेतुषु\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112750, "chapter_id": 3430, "verse_number": "९", "content_sanskrit": "काननेषु विचित्रेषु विहरन्ति स्म कौरवाः ।\nउत्तरैः कुरुभिः सार्धं दक्षिणाः कुरवस्तदा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112751, "chapter_id": 3430, "verse_number": "१०", "content_sanskrit": "स्वर्धमानाश्च दृश्यन्ते देवर्षीणां समागमे ।\nदानधर्मक्रियायुक्ता यज्ञव्रतपरायणाः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112752, "chapter_id": 3430, "verse_number": "११", "content_sanskrit": "अन्योन्यप्रीतिसंयुक्ता वर्धन्ते स्म प्रजास्तदा ।\nमानक्रोधविहीनाश्च प्रजा लोभविवर्जिताः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112753, "chapter_id": 3430, "verse_number": "१२", "content_sanskrit": "अन्योन्यमभ्यनन्दन्त ब्रह्मोत्तरमवर्धत ।\nतस्मिन् जनपदश्रेष्ठे भीष्मेण विधिना कृताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112754, "chapter_id": 3430, "verse_number": "१३", "content_sanskrit": "कूपारामाः सभा वाप्यो ब्राह्मणावसथास्तदा ।\nस्वाहाकारैः स्वधाभिश्च सन्निवासकुरूषितः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112755, "chapter_id": 3430, "verse_number": "१४", "content_sanskrit": "बभूव परमोपेतो यूपचैत्यजयध्वजैः ।\nप्रमृज्य परराष्ट्राणि स्वराष्ट्रं पर्यरक्षत \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112756, "chapter_id": 3430, "verse_number": "१५", "content_sanskrit": "भीष्मेण विहितं राष्ट्रे धर्मचक्रमवर्धत ।\nक्रियमाणेषु कृत्येषु कुमाराणां यशस्विनाम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112757, "chapter_id": 3430, "verse_number": "१६", "content_sanskrit": "पौरजानपदाः सर्वे बभूवुः परमोत्सवाः ।\nगृहेषु कुरुमुख्यानां पौराणां च यशस्विनाम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112758, "chapter_id": 3430, "verse_number": "१७", "content_sanskrit": "दीयतां भुज्यतां चेति वाचोऽश्रूयन्त सर्वशः ।\nधृतराष्ट्रश्च पाण्डुश्च विदुरश्च महायशाः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112759, "chapter_id": 3430, "verse_number": "१८", "content_sanskrit": "जन्मप्रभृति भीष्मेण पुत्रवत् परिरक्षिताः ।\nवैदिकाध्ययने युक्तो नीतिशास्त्रे च पारागः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112760, "chapter_id": 3430, "verse_number": "१९", "content_sanskrit": "भीष्मेण राजन् कौरव्यो धृतराष्ट्रोऽभिषेचितः ।\nधनुर्वेदेऽश्वपृष्ठे च गदायुद्धेऽसिचर्मणि \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112761, "chapter_id": 3430, "verse_number": "२०", "content_sanskrit": "तथैव गजशिक्षायामस्त्रेषु विविधेषु च ।\nअर्थधर्मप्रधानासु विद्यासु विविधासु च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112762, "chapter_id": 3430, "verse_number": "२१", "content_sanskrit": "गतः पारं यदा पाण्डुस्तदा सेनापतिः कृतः ।\nधृतराष्ट्रस्त्वचक्षुष्ट्वाद् राज्यं न प्रत्यपद्यत \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112763, "chapter_id": 3430, "verse_number": "२२", "content_sanskrit": "करणत्वाच्च विदुरः पाण्डुश्चासीन्महीपतिः ।\nअमात्यो मनुजेन्द्रस्य बाल एव यशस्विनः\t॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112764, "chapter_id": 3430, "verse_number": "२३", "content_sanskrit": "प्रणेता सर्वधर्माणां भीष्मेण विदुरः कृतः ।\nसर्वशास्त्रार्थतत्त्वज्ञो बुद्धिमेधापटुर्युवा \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112765, "chapter_id": 3430, "verse_number": "२४", "content_sanskrit": "भावेनागमयुक्तेन सर्वं वेदयते जगत् ।\nप्रनष्टः शन्तनोर्वंशो भीष्मेण पुनरुद्धृतः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112766, "chapter_id": 3430, "verse_number": "२५", "content_sanskrit": "ततो निर्वचनं सत्सु तदिदं परिपठ्यते ।\nकौसल्या वीरसूः स्त्रीणां देशानां कुरुजाङ्गलम् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112767, "chapter_id": 3430, "verse_number": "२६", "content_sanskrit": "भीष्मो धर्मभृतां श्रेष्ठः पुराणां गजसाह्वयम् ।\nते त्रयः कालयोगेन कुमारा जनमेजय \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2112768, "chapter_id": 3430, "verse_number": "२७", "content_sanskrit": "अवर्धन्त महात्मानो नन्दयन्तः सुहृज्जनान् ।\nसंस्कारैः संस्कृतास्ते वै वृत्तेनाध्ययनेन च \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2112769, "chapter_id": 3430, "verse_number": "२८", "content_sanskrit": "श्रमव्यायामकुशलाः समपद्यन्त यौवनम् ।\nधनुर्वेदे च मुष्टौ च गदायुद्धेऽसिचर्मणि \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2112770, "chapter_id": 3430, "verse_number": "२९", "content_sanskrit": "तथैव गजशिक्षायां नीतिशास्त्रेषु पारगाः ।\nइतिहासपुराणेषु नानाशास्त्रेषु पारगाः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2112771, "chapter_id": 3430, "verse_number": "३०", "content_sanskrit": "वेदवेदाङ्गतत्वज्ञाः सर्वत्र च कृतश्रमाः ।\nअतीव बलवानासीद् धृतराष्ट्रोऽम्बिकासुतः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2112772, "chapter_id": 3430, "verse_number": "३१", "content_sanskrit": "पाण्डुर्धनुषि विक्रान्तो नरेष्वभ्यधिकोऽभवत् ।\nत्रिषु लोकेषु न त्वासीत् प्राणी विदुरसम्मितः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2112773, "chapter_id": 3430, "verse_number": "३२", "content_sanskrit": "धर्मनित्यो हि धर्मस्य बुद्ध्या चैव गतिं गतः ।\nअथ शुश्राव विप्रेभ्यो देवकस्य महीपतेः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2112774, "chapter_id": 3430, "verse_number": "३३", "content_sanskrit": "रूपयौवनसम्पन्नां सुतां सागरगासुतः ।\nसुबलस्य च कल्याणीं गान्धाराधिपतेः सुताम् ।\nसुतां च मद्रराजस्य रूपेणाप्रतिमां भुवि \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2112775, "chapter_id": 3430, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2112776, "chapter_id": 3430, "verse_number": "३४", "content_sanskrit": "गुणैः समुदितं नित्यमिदं नः प्रथितं कुलम् ।\nअत्यन्यान् पृथिवीपालान् पृथिव्यामपि राजकान्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2112777, "chapter_id": 3430, "verse_number": "३५", "content_sanskrit": "रक्षितं राजभिः पूर्वैर्धर्मनित्यैर्महात्मभिः ।\nनोत्सादमगमच्चेदं कथञ्चिदिह नः कुलम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2112778, "chapter_id": 3430, "verse_number": "३६", "content_sanskrit": "मया च सत्यवत्या च कृष्णेन च महात्मना ।\nसमवस्थापितं भूयो युष्मासु कुलतन्तुषु \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2112779, "chapter_id": 3430, "verse_number": "३७", "content_sanskrit": "वर्धेत तदिदं पुत्र कुलं सागरवद् यथा ।\nतथा मया विधातव्यं त्वया चैव विशेषतः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2112780, "chapter_id": 3430, "verse_number": "३८", "content_sanskrit": "श्रूयते यादवी कन्या ह्मनुरूपा कुलस्य नः ।\nसुबलस्यात्मजा चैव तथा मद्रेश्वरस्य च \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2112781, "chapter_id": 3430, "verse_number": "३९", "content_sanskrit": "कुलीना रूपवत्यश्च नाथवत्यश्च सर्वशः ।\nउचिताश्चैव सम्बन्धे तेऽस्माकं क्षत्रियोत्तमाः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2112782, "chapter_id": 3430, "verse_number": "४०", "content_sanskrit": "मन्ये वरयितव्यास्ता इत्यहं धीमतां वर ।\nसमानार्थाः कुलस्यास्य यद्वा विदुर मन्यसे \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2112783, "chapter_id": 3430, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2112784, "chapter_id": 3430, "verse_number": "४१", "content_sanskrit": "भवान् पिता भवान्माता भवान् नः परमो गुरुः ।\nतस्मात् स्वयं कुलस्यास्य विचार्य कुरु यद् हितम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2112785, "chapter_id": 3430, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2112786, "chapter_id": 3430, "verse_number": "४२", "content_sanskrit": "अथ शुश्राव विप्रेभ्यो गान्धारीं सुबलात्मजाम् ।\nआराध्य वरदं देवं भगनेत्रहरं हरम् \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2112787, "chapter_id": 3430, "verse_number": "४३", "content_sanskrit": "गान्धारी किल पुत्राणां शतं लेभे वरं पुरा ।\nइति श्रुत्वा च तत्वेन भीष्मः कुरुपितामहः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2112788, "chapter_id": 3430, "verse_number": "४४", "content_sanskrit": "ततो गान्धारराजस्य प्रेषयामास कौरवः ।\nअचक्षुरिति तस्यासीत् सुबलस्य विचारणा \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2112789, "chapter_id": 3430, "verse_number": "४५", "content_sanskrit": "बलख्यातिं च वृद्धिं च बुद्ध्या तु प्रसमीक्ष्य च ।\nददौ तां धृतराष्टय गान्धारीं धर्मचारिणीम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2112790, "chapter_id": 3430, "verse_number": "४६", "content_sanskrit": "गान्घारी त्वथ शुश्राव धृतराष्ठ्रं त्वचक्षुषम् ।\nआत्मानं दित्सितां तत्र पितुर्मातुश्च कौरव \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2112791, "chapter_id": 3430, "verse_number": "४७", "content_sanskrit": "ततः सा पट्टमानाय्य कृत्वा बहुगुणं शुभा ।\nन पश्यतीति भर्ता मे वेष्टयामास चक्षुषी \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2112792, "chapter_id": 3430, "verse_number": "४९", "content_sanskrit": "नात्यश्नीयां पतिमहमित्येवं कृतनिश्चया ।\nततो गान्धारराजस्य सुतः शकुनिराव्रजत् \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2112793, "chapter_id": 3430, "verse_number": "५०", "content_sanskrit": "स्वसारं परया लक्ष्म्या युक्तामादाय कौरव ।\nततो विवाहं चक्रेऽस्या नक्षत्रे सर्वसम्मते \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2112794, "chapter_id": 3430, "verse_number": "५१", "content_sanskrit": "सौबलः स महाराजः शकुनिः प्रियदर्शनः ।\nदत्वा स्वभगिनीं तत्र यथार्हं च परिच्छदम् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2112795, "chapter_id": 3430, "verse_number": "५२", "content_sanskrit": "पुनरागात् स्वनगरं भीष्मेण परिपूजितः ।\nगान्धार्यपि वरारोहा शीलाचारविचेष्टितैः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2112796, "chapter_id": 3430, "verse_number": "५३", "content_sanskrit": "तुष्टिं कुरूणां सर्वेषां जनयामास भारत ।\nगान्धारी सा पतिं दृष्ट्वा प्रज्ञाचक्षुषमीश्चरम् \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2112797, "chapter_id": 3430, "verse_number": "५४", "content_sanskrit": "अतिचाराद् भृशं भीता भर्तुः सा समचिन्तयत् ।\nसा दृष्टिविनिवृत्ता हि भर्तुस्तु समतामयात् \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2112798, "chapter_id": 3430, "verse_number": "५५", "content_sanskrit": "न हि सूक्ष्मेऽप्यतीचारे भर्तुः सा ववृते तदा ।\nवृत्तेनाराध्य तान् सर्वान् पतिव्रतपरायणा \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2112799, "chapter_id": 3430, "verse_number": "५६", "content_sanskrit": "वाचाऽपि पुरुषानन्यान् स्वजनान् नानुकीर्तयत् ।\nतस्याः सहोदराः कन्याः भीष्मेण परिपूजिताः \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2112800, "chapter_id": 3430, "verse_number": "५७", "content_sanskrit": "गान्धारराजः सुबलो भीष्मेण वरितस्तदा ।\nसत्यव्रतां सत्यसेनां सुषेणां च सुसंहिताम् \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2112801, "chapter_id": 3430, "verse_number": "५८", "content_sanskrit": "तेजश्रवां स्वश्रवां च नभोर्वीं निष्कृतिं तथा \t।\nसम्भवां च दशार्णां च गान्धारीं दश विश्रुताः \t॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2112802, "chapter_id": 3430, "verse_number": "५९", "content_sanskrit": "एकाह्ना चोपयेमे ता धृतराष्ट्रो जनेश्चरः ।\nततः शान्तनवो भीष्मो धनुःक्रीतास्ततस्ततः ।\nआहरद्धृतराष्ट्राय राजपुत्रीस्ततः शतम्\t॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2112803, "chapter_id": 3430, "verse_number": "१०९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nनवाधिकशततमोऽध्यायः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2112804, "chapter_id": 3430, "verse_number": "५७", "content_sanskrit": "॥ इति सम्भवपर्वणि सप्तपञ्चाशोऽध्यायः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2112805, "chapter_id": 3430, "verse_number": "", "content_sanskrit": "* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]