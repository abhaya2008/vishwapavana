[{"id": 2037914, "chapter_id": 1823, "verse_number": "५-६८-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2037915, "chapter_id": 1823, "verse_number": "५-६८-१", "content_sanskrit": "कथं त्वं माधवं वेत्थ सर्वलोकमहेश्वरम्।\nकथमेनं न वेदाहं तन्ममाचक्ष्व सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2037916, "chapter_id": 1823, "verse_number": "५-६८-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2037917, "chapter_id": 1823, "verse_number": "५-६८-२", "content_sanskrit": "श्रृणु राजन्न ते विद्या मम विद्या न हीयते।\nविद्याहीनस्तमोध्वस्तो नाभिजानाति केशवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2037918, "chapter_id": 1823, "verse_number": "५-६८-३", "content_sanskrit": "विद्यया तात जानामि त्रियुगं मधुसूदनम् ।\nकर्तारमकृतं देवं भूतानां प्रभवाप्ययम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2037919, "chapter_id": 1823, "verse_number": "५-६८-४x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2037920, "chapter_id": 1823, "verse_number": "५-६८-४", "content_sanskrit": "गावल्गणेऽत्र का भक्तिर्या ते नित्या जनार्दने।\nयया त्वमभिजानासि त्रियुगं मधुसूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2037921, "chapter_id": 1823, "verse_number": "५-६८-५x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2037922, "chapter_id": 1823, "verse_number": "५-६८-५", "content_sanskrit": "मायां न सेवे भद्रं ते न वृथाधर्ममाचरे।\nशुद्धभावं गतो भक्त्या शास्त्रद्वेद्मि जनार्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2037923, "chapter_id": 1823, "verse_number": "५-६८-६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2037924, "chapter_id": 1823, "verse_number": "५-६८-६", "content_sanskrit": "दुर्योधन हृषीकेशं प्रपद्यस्व जनार्दनम्।\nआप्तो नः सञ्जयस्तात शरणं गच्छ केशवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2037925, "chapter_id": 1823, "verse_number": "५-६८-७x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2037926, "chapter_id": 1823, "verse_number": "५-६८-७", "content_sanskrit": "भगवान्देवकीपुत्रो लोकांश्चेन्निहनिष्यति।\nप्रवदन्नर्जुने सख्यं नाहं गच्छेऽद्य केशवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2037927, "chapter_id": 1823, "verse_number": "५-६८-८x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2037928, "chapter_id": 1823, "verse_number": "५-६८-८", "content_sanskrit": "अवाग्गान्धारि पुत्रस्ते गच्छत्येष सुदुर्मतिः ।\nईर्षुर्दुरात्मा मानी च श्रेयसां वचनातिगः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2037929, "chapter_id": 1823, "verse_number": "५-६८-९x", "content_sanskrit": "गान्धार्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2037930, "chapter_id": 1823, "verse_number": "५-६८-९", "content_sanskrit": "ऐश्वर्यकाम दुष्टात्मन्वृद्धानां शासनातिग।\nऐश्वर्यजीतिते हित्वा पितरं मां च बालिश ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2037931, "chapter_id": 1823, "verse_number": "५-६८-१०", "content_sanskrit": "वर्धयन्दुर्हृदां प्रीतिं मां च शोकेन वर्धयन् ।\nनिहतो भीमसेनेन स्मर्ताति वचनं पितुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2037932, "chapter_id": 1823, "verse_number": "५-६८-११x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2037933, "chapter_id": 1823, "verse_number": "५-६८-११", "content_sanskrit": "प्रियोऽसि राजन्कृष्णस्य धृतराष्ट्र निबोध मे।\nयस्य ते सञ्जयो दूतो यस्त्वां श्रेयसि योक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2037934, "chapter_id": 1823, "verse_number": "५-६८-१२", "content_sanskrit": "जानात्येष हृषीकेशं पुराणं यच्च वै परम्।\nशुश्रूषमाणमैकाग्र्यं मोक्ष्यते महतो भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2037935, "chapter_id": 1823, "verse_number": "५-६८-१३", "content_sanskrit": "वैचित्रवीर्य पुरुषाः क्रोधहर्षसमावृताः ।\nसिता बहुविधैः पाशैर्ये न तुष्टाः स्वकैर्धनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2037936, "chapter_id": 1823, "verse_number": "५-६८-१४", "content_sanskrit": "यमस्य वशमायान्ति काममूढाः पुनः पुनः ।\nअन्धनेत्रा यथैवान्धा नीयमानाः स्वकर्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2037937, "chapter_id": 1823, "verse_number": "५-६८-१५", "content_sanskrit": "एष एकायनः पन्था येन यान्ति मनीषिणः ।\nतं दृष्ट्वा मृत्युमत्येति महांस्तत्र न सञ्जति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2037938, "chapter_id": 1823, "verse_number": "५-६८-१६x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2037939, "chapter_id": 1823, "verse_number": "५-६८-१६", "content_sanskrit": "अङ्ग सञ्जय मे शंस पन्थानमकुतोभयम्।\nयेन गत्वा हृषीकेशं प्राप्नुयां सिद्धिमुत्तमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2037940, "chapter_id": 1823, "verse_number": "५-६८-१७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2037941, "chapter_id": 1823, "verse_number": "५-६८-१७", "content_sanskrit": "नाकृतात्मा कृतात्मानं जातु विद्याञ्जनार्दनम् ।\nआत्मनस्तु क्रियोपायो नान्यत्रेन्द्रियनिग्रहात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2037942, "chapter_id": 1823, "verse_number": "५-६८-१८", "content_sanskrit": "इन्द्रियाणामुदीर्णानां कामत्यागोऽप्रमादतः।\nअप्रमादोऽविहिंसा च ज्ञानयोनिरसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2037943, "chapter_id": 1823, "verse_number": "५-६८-१९", "content_sanskrit": "इन्द्रियाणां यमे यत्तो भव राजन्नतन्द्रितः ।\nबुद्धिश्च ते मा च्युवतु नियच्छैनां यतस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2037944, "chapter_id": 1823, "verse_number": "५-६८-२०", "content_sanskrit": "एतज्ज्ञानं विदुर्विप्रा ध्रुवमिन्द्रियधारणम्।\nएतज्ज्ञानं च पन्थाश्च येन यान्ति मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2037945, "chapter_id": 1823, "verse_number": "५-६८-२१", "content_sanskrit": "अप्राप्यः केशवो राजन्निन्द्रियैरजितैर्नृभिः।\nआगमाधिगमाद्योगाद्वशी तत्त्वे प्रसीदति ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2037946, "chapter_id": 1823, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि यानसन्धिपर्वणि अष्टषष्टितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]