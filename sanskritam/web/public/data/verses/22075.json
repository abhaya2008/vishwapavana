[{"id": 7002075000, "chapter_id": 22075, "verse_number": "१२०-१", "content_sanskrit": "अग्निरुवाच ।\nविस्तारस्तु स्मृतो भूमेः सहस्राणि च सप्ततिः ।\nउच्छ्रायो दशसाहस्रं पातालञ्चैकमेककं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002075001, "chapter_id": 22075, "verse_number": "१२०-२", "content_sanskrit": "अतलं वितलञ्चैव नितलञ्च गभस्तिमत् ।\nमहाख्यं सुतलञ्चाग्र्यं पातालञ्चापि सप्तमं ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002075002, "chapter_id": 22075, "verse_number": "१२०-३", "content_sanskrit": "कृष्णपीतारुणाः शुक्लशर्कराशैलकाञ्चनाः ।\nभूमयस्तेषु रम्येषु सन्ति दैत्यादयः सुखं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002075003, "chapter_id": 22075, "verse_number": "१२०-४", "content_sanskrit": "पातालानामधश्चास्ते शेषो विष्णुश्च तामसः ।\nगुणानन्त्यात्स चानन्ततः शिरसा धारयन्महीं ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002075004, "chapter_id": 22075, "verse_number": "१२०-५", "content_sanskrit": "भुवोऽधो नरका नैके न पतेत्तत्र वैष्णवः ।\nरविणा भासिता पृथ्वी यावत्तायन्नभो मतं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002075005, "chapter_id": 22075, "verse_number": "१२०-६", "content_sanskrit": "भूमेर्योजनलक्षन्तु विशिष्ठरविमण्डलं ।\nरवेर्लक्षेण चन्द्रश्च लक्षान्नाक्षत्रमिन्दुतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002075006, "chapter_id": 22075, "verse_number": "१२०-७", "content_sanskrit": "द्विलक्षाद्भाद्बुधश्चास्ते बुधाच्छुक्रो द्विलक्षतः ।\nद्विलक्षेण कुजः शुक्राद्भौमाद्द्विलक्षतो गुरुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002075007, "chapter_id": 22075, "verse_number": "१२०-८", "content_sanskrit": "गुरोर्द्विलक्षतः सौरित्ल्लक्षात्सप्तर्षयः शनेः ।\nलक्षाद्ध्रुवो ह्यृषिभ्यस्तु त्रैलोक्यञ्चोच्छ्रयेण च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002075008, "chapter_id": 22075, "verse_number": "१२०-९", "content_sanskrit": "ध्रुवात्कोट्या महर्लोको यत्र ते कल्पवासिनः ।\nजनो द्विकोटितस्तस्माद्यत्रासन् सनकादयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002075009, "chapter_id": 22075, "verse_number": "१२०-१०", "content_sanskrit": "जनात्तपश्चाष्तकोट्या वैराजा यत्र देवताः ।\nषणवत्या तु कोटीनान्तपसः सत्यलोककः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002075010, "chapter_id": 22075, "verse_number": "१२०-११", "content_sanskrit": "अपुनर्मारका यत्र ब्रह्मलोको हि स स्मृतः ।\nपादगम्यस्तु भूल्लोको भुवः सूर्यान्तरः स्मृतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002075011, "chapter_id": 22075, "verse_number": "१२०-१२", "content_sanskrit": "स्वर्गलोको ध्रुवान्तस्तु नियुतानि चतुर्दश ।\nएतदण्डकटाहेन वृतो ब्रह्माण्डविस्तरः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002075012, "chapter_id": 22075, "verse_number": "१२०-१३", "content_sanskrit": "वारिवह्न्यनिलाकाशैस्ततो भूतादिना वहिः ।\nवृतं दशगुणैरण्डं भूतादिर्महता तथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002075013, "chapter_id": 22075, "verse_number": "१२०-१४", "content_sanskrit": "दशोत्तराणि शेषाणि एकैकस्मान्मामुने ।\nमहान्तञ्च समावृत्य प्रधानं समवस्थितं ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002075014, "chapter_id": 22075, "verse_number": "१२०-१५", "content_sanskrit": "अनन्तस्य न तस्यान्तः सङ्ख्यानं नापि विद्यते ।\nहेतुभूतमशेषस्य प्रकृतिः सा परा मुने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002075015, "chapter_id": 22075, "verse_number": "१२०-१६", "content_sanskrit": "असङ्ख्यातानि शाण्डानि तत्र जातानि चेदृशां ।\nदारुण्यग्निर्यथा तैलं तिले तद्वत्पुमानिति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002075016, "chapter_id": 22075, "verse_number": "१२०-१७", "content_sanskrit": "प्रधाने च स्थितो व्यापी चेतनात्मात्मवेदनः ।\nप्रधानञ्च पुमांश्चैव सर्वभूतात्मभृतया ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002075017, "chapter_id": 22075, "verse_number": "१२०-१८", "content_sanskrit": "विष्णुशक्त्या महाप्राज्ञ वृतौ संश्रयधर्मिणौ ।\nतयोः सैव पृथग्भावे कारणं संश्रयस्य च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002075018, "chapter_id": 22075, "verse_number": "१२०-१९", "content_sanskrit": "क्षोभकारणभूतश्च सर्गकाले महामुने ।\nयथा शैत्यं जले वातो विभर्ति कणिकागतं ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002075019, "chapter_id": 22075, "verse_number": "१२०-२०", "content_sanskrit": "जगच्छक्तिस्तथा विष्णोः प्रधानप्रतिपादिकां ।\nविष्णुशक्तिं समासाद्य देवाद्याः सम्भवन्ति हि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002075020, "chapter_id": 22075, "verse_number": "१२०-२१", "content_sanskrit": "स च विष्णुः स्वयं ब्रह्म यतः सर्वमिदं जगत् ।\nयोजनानां सहस्राणि भास्करस्य रथो नव ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002075021, "chapter_id": 22075, "verse_number": "१२०-२२", "content_sanskrit": "ईशादण्डस्तथैवास्य द्विगुणो मुनिसत्तम ।\nसार्धकोटिस्तथा सप्तनियुतान्यधिकानि वै ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002075022, "chapter_id": 22075, "verse_number": "१२०-२३", "content_sanskrit": "योजनानान्तु तस्याक्षस्तत्र चक्रं प्रतिष्ठितं ।\nत्रिनाभिमतिपञ्चारं षण्णेमि द्व्ययनात्मकं ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002075023, "chapter_id": 22075, "verse_number": "१२०-२४", "content_sanskrit": "संवत्सरमयं कृत्स्नं कालचक्रं प्रतिष्ठितं ।\nचत्वारिंशत्सहस्राणि द्वितीयाक्षो विवस्वतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002075024, "chapter_id": 22075, "verse_number": "१२०-२५", "content_sanskrit": "पञ्चान्यानि तु सार्धानि स्यन्दनस्य महामते ।\nअक्षप्रमाणमुभयोः प्रमाणन्तदद्युगार्धयोः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002075025, "chapter_id": 22075, "verse_number": "१२०-२६", "content_sanskrit": "ह्रस्वोऽक्षस्तद्युगार्धञ्च ध्रुवाधारं रथस्य वै ।\nहयाश्च सप्त छन्दांसि गायत्र्यादीनि सुव्रत ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002075026, "chapter_id": 22075, "verse_number": "१२०-२७", "content_sanskrit": "उदयास्तमनं ज्ञेयं दर्शनादर्शनं रवेः ।\nयावन्मात्रप्रदेशे तु वशिष्ठोऽवस्थितो ध्रुवः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002075027, "chapter_id": 22075, "verse_number": "१२०-२८", "content_sanskrit": "स्वयमायाति तावत्तु भूमेराभूतसम्प्लवे ।\nऊर्ध्वोत्तरमृषिभ्यस्तु ध्रुवो यत्र व्यवस्थितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002075028, "chapter_id": 22075, "verse_number": "१२०-२९", "content_sanskrit": "एतद्विष्णुपदं दिव्यं तृतीयं व्योम्नि भास्वरं ।\nनिर्धूतदोषपङ्कानां यतीनां स्थानमुत्तमं ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002075029, "chapter_id": 22075, "verse_number": "१२०-३०", "content_sanskrit": "ततो गङ्गा प्रभवति स्मरणात्पाशनाशनी ।\nदिवि रूपं हरेर्ज्ञेयं शिशुमाराकृति प्रभो ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002075030, "chapter_id": 22075, "verse_number": "१२०-३१", "content_sanskrit": "स्थितः पुच्छे ध्रुवस्तत्र भ्रमन् भ्रामयति ग्रहान् ।\nस रथोऽधिष्ठिता देवैरादित्यैरृषिभिर्वरैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002075031, "chapter_id": 22075, "verse_number": "१२०-३२", "content_sanskrit": "गन्धर्वैरप्सरोभिश्च ग्रामणीसर्पराक्षसैः ।\nहिमोष्णवारिवर्षाणां कारणं भगवान् रविः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002075032, "chapter_id": 22075, "verse_number": "१२०-३३", "content_sanskrit": "ऋग्वेदादिमयो विष्णुः स शुभाशुभकारणं ।\nरथस्त्रिचक्रः सोमस्य कुन्दाभास्तस्य वाजिनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002075033, "chapter_id": 22075, "verse_number": "१२०-३४", "content_sanskrit": "वामदक्षिणतो युक्ता दश तेन चरत्यसौ ।\nत्रयस्त्रिंशत्सहस्राणि त्रयस्त्रिंशच्छतानि च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002075034, "chapter_id": 22075, "verse_number": "१२०-३५", "content_sanskrit": "त्रयस्त्रिंशत्तथा देवाः पिबन्ति क्षणदाकरं ।\nएकां कलाञ्च पितर एकामारश्मिसंस्थिताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002075035, "chapter_id": 22075, "verse_number": "१२०-३६", "content_sanskrit": "वाय्वग्निद्रव्यसम्भूतो रथश्चन्द्रसुतस्य च ।\nअष्टाभिस्तुरगैर्युक्तो बुधस्तेन चरत्यपि ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002075036, "chapter_id": 22075, "verse_number": "१२०-३७", "content_sanskrit": "शुक्रस्यापि रथोऽष्टाश्वो भौमस्यापि रथस्तथा ।\nबृहस्पते रथोऽष्टाश्वः शनेरष्टाश्वको रथः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002075037, "chapter_id": 22075, "verse_number": "१२०-३८", "content_sanskrit": "स्वर्भानोश्च रथोऽष्टाश्वः केतोश्चाष्टाश्वको रथः ।\nयदद्य वैष्णवः कायस्ततो विप्र वसुन्धरा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002075038, "chapter_id": 22075, "verse_number": "१२०-३९", "content_sanskrit": "पद्माकरा समुद्भूता पर्वताद्यादिसंयुता ।\nज्योतिर्भुवननद्यद्रिसमुद्रवनकं हरिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002075039, "chapter_id": 22075, "verse_number": "१२०-४०", "content_sanskrit": "यदस्ति नास्ति तद्विष्णुर्विष्णुज्ञानविजृम्भितं ।\nन विज्ञानमृते किञ्चिज्ज्ञानं विष्णुः परम्पदं ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002075040, "chapter_id": 22075, "verse_number": "१२०-४१", "content_sanskrit": "तत्कुर्याद्येन विष्णुः स्यात्सत्यं ज्ञानमनन्तकं ।\nपठेद्भुवनकोषं हि यः सोऽवाप्तसुखात्मभाक् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002075041, "chapter_id": 22075, "verse_number": "१२०-४२", "content_sanskrit": "ज्योतिःशास्त्रादिविध्याश्च शुभाशुभाधिपो हरिः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]