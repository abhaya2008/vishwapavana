[{"id": 900009297, "chapter_id": 8743, "verse_number": "1.1", "content_sanskrit": "निखिलगुणनिकायं नित्यनिर्धूतहेयं शुभतममतिमेयं शुद्धसौख्याप्त्युपायम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009298, "chapter_id": 8743, "verse_number": "1.2", "content_sanskrit": "ननु मिथ्यैव विश्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009299, "chapter_id": 8743, "verse_number": "1.3", "content_sanskrit": "इदं च विप्रतिपत्तिप्रदर्शनं तार्किकरीत्यैव न तु वस्तुतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009300, "chapter_id": 8743, "verse_number": "1.4", "content_sanskrit": "विमतं मिथ्या दृश्यत्वात्, जडत्वात्, परिच्छिन्नत्वात्, शुक्तिरूप्यवत्’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009301, "chapter_id": 8743, "verse_number": "1.5", "content_sanskrit": "यद्वा, पृथिवी सत्या मिथ्या वा, ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900009302, "chapter_id": 8743, "verse_number": "1.6", "content_sanskrit": "नवीनास्तु – एतत्पटात्यन्ताभावः एतत्तन्तुनिष्ठः, एतत्पटानाद्यभावत्वात्, एतत्पटान्योन्याभाववत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900009303, "chapter_id": 8743, "verse_number": "1.7", "content_sanskrit": "मिथ्यात्वं च यद्यपि नात्यन्तासत्त्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900009304, "chapter_id": 8743, "verse_number": "1.8", "content_sanskrit": "यद्वा बाध्यत्वमनिर्वाच्यत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900009305, "chapter_id": 8743, "verse_number": "1.9", "content_sanskrit": "दृश्यत्वं च न्यायदीपावलीरीत्या दृग्विषयत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900009306, "chapter_id": 8743, "verse_number": "1.10", "content_sanskrit": "श्रुतिश्चात्र प्रमाणम् । ‘‘एकमेवाद्वितीयम्’’ इत्यादौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900009307, "chapter_id": 8743, "verse_number": "1.11", "content_sanskrit": "उच्यते– मिथ्यात्वं हि त्वयैव पक्षान्तरनिषेधेन पञ्चधा निरुक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900009308, "chapter_id": 8743, "verse_number": "1.12", "content_sanskrit": "किं च यथा अनित्ये वाङ्मनसे इत्यत्र..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900009309, "chapter_id": 8743, "verse_number": "1.13", "content_sanskrit": "न द्वितीयः । त्रैकालिकनिषेधस्य तात्त्विकत्वेऽद्वैतहानेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900009310, "chapter_id": 8743, "verse_number": "1.14", "content_sanskrit": "किञ्च निषेधप्रतियोगित्वं किं स्वरूपेण?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900009311, "chapter_id": 8743, "verse_number": "1.15", "content_sanskrit": "अत्यन्तासत्त्वापाताच्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900009312, "chapter_id": 8743, "verse_number": "1.16", "content_sanskrit": "नापि सदनिर्वाच्याभ्यामन्यत्वमसत्त्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900009313, "chapter_id": 8743, "verse_number": "1.17", "content_sanskrit": "अथ मतम् – असतोऽसत्त्वादेवात्यन्तिकनिषेधप्रतियोगिताऽपि नेति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900009314, "chapter_id": 8743, "verse_number": "1.18", "content_sanskrit": "ननु सदा सर्वत्राविद्यमानत्वमसत्त्वं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900009315, "chapter_id": 8743, "verse_number": "1.19", "content_sanskrit": "नापि ज्ञानत्वेन ज्ञाननिवर्त्यत्वमिति तृतीयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900009316, "chapter_id": 8743, "verse_number": "1.20", "content_sanskrit": "एतेन स्वात्यन्ताभावाधिकरण एव प्रतीयमानत्वं मिथ्यात्वमिति चतुर्थोऽपि निरस्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900009317, "chapter_id": 8743, "verse_number": "1.21", "content_sanskrit": "पञ्चमेऽपि सत् किं सत्ताजातिमद्विवक्षितम्? अबाध्यं वा? ब्रह्म वा? नाद्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900009318, "chapter_id": 8743, "verse_number": "1.22", "content_sanskrit": "अस्तु वा मिथ्यात्वं यत्किञ्चित्, तथापि मिथ्यात्वमबाध्यम्? बाध्यं वा? आद्ये अद्वैतहानिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900009319, "chapter_id": 8743, "verse_number": "1.23", "content_sanskrit": "किं च प्रतिपन्नोपाधावनिषिद्धं प्रत्युत बाधकज्ञानेन..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900009320, "chapter_id": 8743, "verse_number": "1.24", "content_sanskrit": "दृश्यत्वहेतूक्तिरपि— स्तम्भादिप्रत्ययो मिथ्या प्रत्ययत्वात्तथा हि यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900009321, "chapter_id": 8743, "verse_number": "1.25", "content_sanskrit": "ननु शुद्धं ब्रह्म न दृश्यम्, किं तु विशिष्टमेव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900009322, "chapter_id": 8743, "verse_number": "1.26", "content_sanskrit": "किं च शुद्धज्ञानाभावे तदाच्छादकस्य मूलाज्ञानस्य निवृत्तिर्न स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900009323, "chapter_id": 8743, "verse_number": "1.27", "content_sanskrit": "नन्वस्तु तर्हि चतुर्थः । अतीतादेरपि कदाचित् स्वाकारवृतिप्रतिफलितचिद्विषय-त्वात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900009324, "chapter_id": 8743, "verse_number": "1.28", "content_sanskrit": "न षष्ठः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900009325, "chapter_id": 8743, "verse_number": "1.29", "content_sanskrit": "जडत्वमप्यज्ञातृत्वं वा? अज्ञानत्वं वा? अस्वप्रकाशत्वं वा?..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900009326, "chapter_id": 8743, "verse_number": "1.30", "content_sanskrit": "एवं ज्ञात्रभावादपि न ज्ञानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900009327, "chapter_id": 8743, "verse_number": "1.31", "content_sanskrit": "परिच्छिन्नत्वमपि देशतः? कालतः? वस्तुतो वा? नाद्यद्वितीयौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900009328, "chapter_id": 8743, "verse_number": "1.32", "content_sanskrit": "किं च कालादिपरिच्छिन्नत्वं न तावदेककालादिमात्रे सत्त्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900009329, "chapter_id": 8743, "verse_number": "1.33", "content_sanskrit": "एतेन यदुक्तं प्रमाणमालायाम्– ‘विवादाध्यासिताः स्वानुगतप्रतिभासे वस्तुनि कल्पिताः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900009330, "chapter_id": 8743, "verse_number": "1.34", "content_sanskrit": "अंशित्वादिहेतुष्वपि मतद्वयेऽपि कार्यस्य कारणाभेदेन तदनाश्रितत्वात्सिद्ध-साधनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900009331, "chapter_id": 8743, "verse_number": "1.35", "content_sanskrit": "किं चात्यन्ताभावप्रतियोगित्वं स्वरूपेण वा? पारमार्थिकत्वेन वा? नोभयमपि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900009332, "chapter_id": 8743, "verse_number": "1.36", "content_sanskrit": "यत्तु विमतं ज्ञानव्यतिरेकेणासत्, ज्ञानव्यतिरेकेणानुपलभ्यमानत्वादिति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900009333, "chapter_id": 8743, "verse_number": "1.37", "content_sanskrit": "सोपाधिकाश्च दृश्यत्वादयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900009334, "chapter_id": 8743, "verse_number": "1.38", "content_sanskrit": "यद्वा अधिष्ठानाभिमतसमसत्ताकदोषवद्धेतुजन्यज्ञानविषयत्वमुपाधिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900009335, "chapter_id": 8743, "verse_number": "1.39", "content_sanskrit": "विमतं प्रातिभासिकम्, दृश्यत्वाच्छुक्तिरूप्यवत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900009336, "chapter_id": 8743, "verse_number": "1.40", "content_sanskrit": "सन् घट इत्यादिप्रत्यक्षबाधिताश्च दृश्यत्वादयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 900009337, "chapter_id": 8743, "verse_number": "1.41", "content_sanskrit": "उच्यते– तवात्मनि यत्सत्त्वं तदेवेह मम", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 900009338, "chapter_id": 8743, "verse_number": "1.42", "content_sanskrit": "अश्वे गोत्वं कदाचिदपि नास्तीत्यादौ तत्संसर्ग एव निषिध्यत इति मते देशपद-मनपेक्षितम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 900009339, "chapter_id": 8743, "verse_number": "1.43", "content_sanskrit": "नन्विदं रूप्यमित्यत्रेदमितिवत् सन् घट इत्यत्रापि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 900009340, "chapter_id": 8743, "verse_number": "1.44", "content_sanskrit": "उपक्रमाधिकरणन्यायेनोपसंहारादुपक्रमस्यैवानुपसञ्जातविरोधित्वाच्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 900009341, "chapter_id": 8743, "verse_number": "1.45", "content_sanskrit": "‘‘यदाहवनीये जुहोति’’– इत्यस्मात् ‘‘पदे जुहोति’’ इत्यस्येव विशेष-विषयत्वाच्च", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 900009342, "chapter_id": 8743, "verse_number": "1.46", "content_sanskrit": "किञ्च पञ्चदशरात्रे प्रथमेऽहनि अग्निष्टुन्नामके नामातिदेशेन ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 900009343, "chapter_id": 8743, "verse_number": "1.47", "content_sanskrit": "किं चोपजीव्यत्वात्प्राबल्यमक्षस्य श्रुतेः स्मृतित इव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 900009344, "chapter_id": 8743, "verse_number": "1.48", "content_sanskrit": "ननु तथापि कथं प्रामाण्यमिथ्यात्वे विषयमिथ्यात्वम्?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 900009345, "chapter_id": 8743, "verse_number": "1.49", "content_sanskrit": "यदि तु प्रत्यक्षं लिङ्गबाध्यम्, तर्हि ‘‘औदुम्बरीं स्पृष्ट्वोद्गायेत्’’ ऐन्द्र्या गार्हपत्यमुपतिष्ठते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 900009346, "chapter_id": 8743, "verse_number": "1.50", "content_sanskrit": "अग्न्यौष्ण्यप्रत्यक्षं च तच्छैत्यानुमित्या विवरणोक्तं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 900009347, "chapter_id": 8743, "verse_number": "1.51", "content_sanskrit": "यदि चाक्षं शब्दबाध्यं तर्हि जैमिनिना..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 900009348, "chapter_id": 8743, "verse_number": "1.52", "content_sanskrit": "यच्चोक्तं वाचस्पतिना– ‘‘प्रस्तरादिवाक्यमन्यशेषत्वादमुख्यार्थम्, अद्वैतवाक्यं तु न तथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 900009349, "chapter_id": 8743, "verse_number": "1.53", "content_sanskrit": "यत्तूक्तं वाचस्पतिना पूर्वस्य प्रत्यक्षस्य परेणागमेनापच्छेदन्यायेन बाध इति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 900009350, "chapter_id": 8743, "verse_number": "1.54", "content_sanskrit": "न चैवं प्रकृते प्रत्यक्षप्रामाण्यस्यावकाशोऽस्तीति नापच्छेदन्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 900009351, "chapter_id": 8743, "verse_number": "1.55", "content_sanskrit": "एवं चाक्षस्य लिङ्गादिबाध्यत्वे कालात्ययापदिष्टादेर्दोषता वा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 900009352, "chapter_id": 8743, "verse_number": "1.56", "content_sanskrit": "इदं रूप्यमिति प्रत्यक्षमपि नेदं रूप्यमिति सयुक्तिकबलवत्प्रत्यक्षेण बाध्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 900009353, "chapter_id": 8743, "verse_number": "1.57", "content_sanskrit": "केचित्त्वाका(शे)शो नीलिमोदेतीति श्रुतेर्नभो नीलमेव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 900009354, "chapter_id": 8743, "verse_number": "1.58", "content_sanskrit": "नापि भाविबाधकशङ्कामात्रेणेति तृतीयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 900009355, "chapter_id": 8743, "verse_number": "1.59", "content_sanskrit": "कथं चेयं शङ्का?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 900009356, "chapter_id": 8743, "verse_number": "1.60", "content_sanskrit": "नापि प्रत्यक्षं कालत्रयाबाध्यत्वग्रहाक्षममिति द्वितीयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 900009357, "chapter_id": 8743, "verse_number": "1.61", "content_sanskrit": "अनुमानबाधिताश्च दृश्यत्वादयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 900009358, "chapter_id": 8743, "verse_number": "1.62", "content_sanskrit": "किञ्च, विमतं न सद्विलक्षणम्, असद्विलक्षणत्वात्, आत्मवत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 900009359, "chapter_id": 8743, "verse_number": "1.63", "content_sanskrit": "किञ्च, विमतं न सद्विलक्षणम्, असद्विलक्षणत्वात्, आत्मवत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 900009360, "chapter_id": 8743, "verse_number": "1.64", "content_sanskrit": "किञ्च ‘‘विश्वं सत्यं’’ ‘‘यच्चिकेत सत्यमित्तन्न मोघम्’’", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 900009361, "chapter_id": 8743, "verse_number": "1.65", "content_sanskrit": "किञ्च यथा ‘‘षड्विंशतिरस्य वंक्रयः’’ इति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 900009362, "chapter_id": 8743, "verse_number": "1.66", "content_sanskrit": "नापि व्यावहारिकसत्त्वपरा, वैयर्थ्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 900009363, "chapter_id": 8743, "verse_number": "1.67", "content_sanskrit": "किञ्चैतैरेव प्रयोगैः स्वप्रतिज्ञाहेतूदाहरणादिप्रापितानां ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 900009364, "chapter_id": 8743, "verse_number": "1.68", "content_sanskrit": "नन्वसत्यमपि प्रतिबिम्बं बिम्बस्य, स्वाप्नार्थश्च शुभाशुभयोः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 900009365, "chapter_id": 8743, "verse_number": "1.69", "content_sanskrit": "अथ सम्बन्धान्तरमन्तरेण विशिष्ट१व्यवहारजननयोग्यं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 900009366, "chapter_id": 8743, "verse_number": "1.70", "content_sanskrit": "अनुकूलतर्कहीनाश्च मिथ्यात्वहेतवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 900009367, "chapter_id": 8743, "verse_number": "1.71", "content_sanskrit": "अत्रोच्यते–सर्वस्यापि दृश्यस्य ब्रह्मात्मैकदृगध्यस्तत्वेऽपि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 900009368, "chapter_id": 8743, "verse_number": "1.72", "content_sanskrit": "उक्तं हि– ‘‘षष्ठी स्थानेयोगे’’त्यत्र महाभाष्ये – ‘‘एकशतं षष्ठ्यर्था’’ इति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 900009369, "chapter_id": 8743, "verse_number": "1.73", "content_sanskrit": "ज्ञानस्येव ज्ञेयस्य सत्यत्वेऽपि तत्सम्बन्धमिथ्यात्वोपपत्तेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 900009370, "chapter_id": 8743, "verse_number": "1.74", "content_sanskrit": "त्वयापि– घटोऽयमित्यसावुक्तिराभासस्य प्रसादतः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 900009371, "chapter_id": 8743, "verse_number": "1.75", "content_sanskrit": "किञ्चाध्यासिकसम्बन्ध इति कोऽर्थः ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 900009372, "chapter_id": 8743, "verse_number": "1.76", "content_sanskrit": "अन्ये तु यस्सम्बन्धान्तरमनपेक्ष्य यज्ज्ञानावच्छेदको ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 900009373, "chapter_id": 8743, "verse_number": "1.77", "content_sanskrit": "यच्चोक्तम्– ‘यथा तटाकोदकं छिद्रान्निर्गत्य कुल्यात्मना केदारान्प्रविश्य", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 900009374, "chapter_id": 8743, "verse_number": "1.78", "content_sanskrit": "तन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 900009375, "chapter_id": 8743, "verse_number": "1.79", "content_sanskrit": "अस्तु वा चैतन्यस्य विषयप्रकाशत्वम्, तथापि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 900009376, "chapter_id": 8743, "verse_number": "1.80", "content_sanskrit": "किञ्च, वृत्तेस्तदाकारत्वं न तावत्तद्विषयत्वम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 900009377, "chapter_id": 8743, "verse_number": "1.81", "content_sanskrit": "आवरणाभिभवार्थत्वपक्षोऽप्ययुक्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 900009378, "chapter_id": 8743, "verse_number": "1.82", "content_sanskrit": "प्रतिकूलतर्कहताश्चैते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 900009379, "chapter_id": 8743, "verse_number": "1.83", "content_sanskrit": "नन्वथापि न प्रधानं भ्रमहेतुः, किन्तु तत्संस्कारः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 900009380, "chapter_id": 8743, "verse_number": "1.84", "content_sanskrit": "न च दोषादिकं विना भ्रमश्शङ्क्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 900009381, "chapter_id": 8743, "verse_number": "1.85", "content_sanskrit": "किञ्च यदि जगत्कल्पितं स्यात्तदा त्वन्मतेऽपि ‘जन्माद्यस्य यतः’ इति सूत्रे..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 900009382, "chapter_id": 8743, "verse_number": "1.86", "content_sanskrit": "नापि श्रुतिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 900009383, "chapter_id": 8743, "verse_number": "1.87", "content_sanskrit": "किञ्चोक्तरीत्या श्रुत्याप्यविद्याकार्यस्य विश्वस्य न स्वरूपेण त्रैकालिक निषेधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 900009384, "chapter_id": 8743, "verse_number": "1.88", "content_sanskrit": "न तृतीयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 900009385, "chapter_id": 8743, "verse_number": "1.89", "content_sanskrit": "किञ्च न तावद् ‘एकमेवाद्वितीयम्’ इत्यादिश्रुतिस्तत्र मानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 900009386, "chapter_id": 8743, "verse_number": "1.90", "content_sanskrit": "अत्रोक्तं खण्डने प्रत्यक्षं नियतविषयं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 900009387, "chapter_id": 8743, "verse_number": "1.91", "content_sanskrit": "किञ्चाऽद्वैतश्रुतेः किं सर्वमिथ्यात्वे तात्पर्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 900009388, "chapter_id": 8743, "verse_number": "1.92", "content_sanskrit": "यच्चोक्तं इयमर्थापत्तिर्न स्वविषयेति सैव द्वारमद्वयश्रुतेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 900009389, "chapter_id": 8743, "verse_number": "1.93", "content_sanskrit": "किञ्च ‘सलिल एको द्रष्टाऽद्वैतो भवति’ इत्यत्र ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 900009390, "chapter_id": 8743, "verse_number": "1.94", "content_sanskrit": "अद्वितीयशब्दोऽपि कर्मधारयो बहुव्रीहिर्वा ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 900009391, "chapter_id": 8743, "verse_number": "1.95", "content_sanskrit": "नापि ‘नेह नानास्ति किञ्चन’ इति श्रुतिस्तत्र मानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 900009392, "chapter_id": 8743, "verse_number": "1.96", "content_sanskrit": "‘अनुभूतिः न नाना, अनुभूतित्वाद्, उपाधिभेदमन्तरेणाविभाव्यमानभेद त्वात्’..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 900009393, "chapter_id": 8743, "verse_number": "1.97", "content_sanskrit": "धर्माणां स्वरूपेण निषेधे हि नानेति पृथगिति च व्यर्थं स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 900009394, "chapter_id": 8743, "verse_number": "1.98", "content_sanskrit": "नापि ‘यत्र त्वस्य सर्वमात्मैवाभूत्तत्केन कं पश्येत्’ इति श्रुतिस्तत्र मानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 900009395, "chapter_id": 8743, "verse_number": "1.99", "content_sanskrit": "नापि ‘यद्द्वैतं पश्यति पश्यन्वै तन्न पश्यति..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 900009396, "chapter_id": 8743, "verse_number": "1.100", "content_sanskrit": "नापि ‘वाचारम्भणं विकारो नामधेयम्’ इति श्रुतिस्तत्र मानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 900009397, "chapter_id": 8743, "verse_number": "1.101", "content_sanskrit": "नापि ‘इदं सर्वं यदयमात्मा’ इत्यादि श्रुतिस्तत्र मानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 900009398, "chapter_id": 8743, "verse_number": "1.102", "content_sanskrit": "‘यस्मात्परं नापरमस्ति’ इति श्रुतेरपि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 900009399, "chapter_id": 8743, "verse_number": "1.103", "content_sanskrit": "प्रपञ्चो यदि विद्येत निवर्तेत न संशयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 900009400, "chapter_id": 8743, "verse_number": "1.104", "content_sanskrit": "यत्तु तत्त्वप्रदीपिकायाम् ‘सत्यं ज्ञानमनन्तम्’ इत्यनन्तशब्दस्तत्र मानम् इत्युक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 900009401, "chapter_id": 8743, "verse_number": "1.105", "content_sanskrit": "‘इन्द्रो मायाभिः पुरुरूप ईयते’ इत्यत्रापीश्वरस्य विचित्रशक्तिभिर्मत्स्या द्यनेकरूपत्वमेवोच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 900009402, "chapter_id": 8743, "verse_number": "1.106", "content_sanskrit": "यत्तु कौमुद्याम् ‘‘अतोऽन्यदार्तम्’ इति वाक्यं तत्र मानम्’’ इत्युक्तं, तत्त्वतितुच्छम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 900009403, "chapter_id": 8743, "verse_number": "1.107", "content_sanskrit": "पुराणादिषु क्वचित् जगतोऽसत्त्वोक्तिरसाधुत्वात्, ‘‘नासत्पुरुषमाश्रयेत्’’ इत्यादिवत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 900009404, "chapter_id": 8743, "verse_number": "1.108", "content_sanskrit": "नापि ज्ञाननिवर्त्यत्वान्यथानुपपत्तिस्तत्र मानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 900009405, "chapter_id": 8743, "verse_number": "1.109", "content_sanskrit": "नापि ‘‘प्राणा वै सत्यं तेषामेष सत्यम्’’ इति श्रुतार्थापत्तिस्तत्र मानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 900009406, "chapter_id": 8743, "verse_number": "1.110", "content_sanskrit": "यच्च बौद्धाभिमतक्षणिकत्वसिद्ध्यर्थमुक्तं ‘‘विश्वस्य दृष्टिसृष्टिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 900009407, "chapter_id": 8743, "verse_number": "1.111", "content_sanskrit": "यच्चेदमुच्यते– ‘‘एकमेव च शरीरं सजीवमन्यानि तु स्वाप्नशरीरव-न्निर्जीवानि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 900009408, "chapter_id": 8743, "verse_number": "1.112", "content_sanskrit": "यच्चोक्तम् (१) अनादिभावरूपत्वे सति ज्ञाननिवर्त्यत्वं..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 900009409, "chapter_id": 8743, "verse_number": "1.113", "content_sanskrit": "यच्चाज्ञाने प्रत्यक्षं मानमित्युक्तम् । तन्न", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 900009410, "chapter_id": 8743, "verse_number": "1.114", "content_sanskrit": "यच्चाद्यानुमानं, तत्र सुखादिप्रमायां बाधः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 900009411, "chapter_id": 8743, "verse_number": "1.115", "content_sanskrit": "‘‘अनृतेन हि प्रत्यूढा’’ इत्यत्रानृतशब्दो दुष्कर्मपरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 900009412, "chapter_id": 8743, "verse_number": "1.116", "content_sanskrit": "भ्रमोपादानत्वेनाविद्याकल्पनं तु द्वितीलक्षणनिरासेनैव निरस्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 900009413, "chapter_id": 8743, "verse_number": "1.117", "content_sanskrit": "किं च त्वन्मते अज्ञानस्याप्रामाणिकत्वात्कथं तत्र प्रमाणोक्तिः ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 900009414, "chapter_id": 8743, "verse_number": "1.118", "content_sanskrit": "किं चाविद्या किं शुद्धसाक्षिचैतन्येनैव भाति ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 900009415, "chapter_id": 8743, "verse_number": "1.119", "content_sanskrit": "अविद्याश्रयश्च दुर्वचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 900009416, "chapter_id": 8743, "verse_number": "1.120", "content_sanskrit": "किञ्च त्वन्मते शुद्धब्रह्मणश्चिन्म•त्रत्वेऽपि श्रुत्यादौ तस्य सर्वज्ञत्वात् कथमज्ञानम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 900009417, "chapter_id": 8743, "verse_number": "1.121", "content_sanskrit": "एतेन मा भूद् ब्रह्मण्यविद्या, माया तु स्यात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 900009418, "chapter_id": 8743, "verse_number": "1.122", "content_sanskrit": "यच्चोक्तं वाचस्पतिना जीवाश्रिताऽविद्येति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 900009419, "chapter_id": 8743, "verse_number": "1.123", "content_sanskrit": "अविद्याविषयोऽपि दुर्वचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 900009420, "chapter_id": 8743, "verse_number": "1.124", "content_sanskrit": "यदप्युच्यते अहमर्थो नात्मा पश्चात्परामर्शान्यथानुपपत्त्या ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 900009421, "chapter_id": 8743, "verse_number": "1.125", "content_sanskrit": "यच्चोच्यते जपाकुसुमस्थं लौहित्यं स्फटिक इव मनस्स्थं कर्तृत्वमात्म-न्यध्यस्तम्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 900009422, "chapter_id": 8743, "verse_number": "1.126", "content_sanskrit": "यच्चोच्यते (आत्मनि देहेन्द्रियाद्यैक्यं तद्धर्माश्चाध्यस्यन्ते)..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 900009423, "chapter_id": 8743, "verse_number": "1.127", "content_sanskrit": "यच्चोक्तं यद्यप्यनिर्वाच्यत्वं न निरुक्तिविरहः, इदं रूप्यमिति निरुक्तेः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 900009424, "chapter_id": 8743, "verse_number": "1.128", "content_sanskrit": "अनुमानं चायुक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 900009425, "chapter_id": 8743, "verse_number": "1.129", "content_sanskrit": "अर्थापत्तावपि सच्चेन्न बाध्येतेत्यत्र किमिदं सत् ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 900009426, "chapter_id": 8743, "verse_number": "1.130", "content_sanskrit": "नन्वत्यन्तासत्त्वे कथं निषेधप्रतियोगित्वम् ?", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 900009427, "chapter_id": 8743, "verse_number": "1.131", "content_sanskrit": "नापि ‘नासदासीन्नो सदासीत्तम आसीत्’ इति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 900009428, "chapter_id": 8743, "verse_number": "1.132", "content_sanskrit": "तस्मादनिर्वाच्यख्यात्यसम्भवाद्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 900009429, "chapter_id": 8743, "verse_number": "1.133", "content_sanskrit": "यच्चेदमुच्यते अध्यस्तमज्ञानोपादानकं तत्त्वज्ञाननाश्यं चेति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 900009430, "chapter_id": 8743, "verse_number": "1.134", "content_sanskrit": "यच्चेदमुच्यते अधिष्ठानांशे इन्द्रियजन्यान्तःकरणवृत्तिरध्यस्तांशे ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 900009431, "chapter_id": 8743, "verse_number": "1.135", "content_sanskrit": "यच्चेदमुच्यते ब्रह्म पारमार्थिकं सद्, जगद् व्यावहारिकम्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}]