[{"id": 7003557000, "chapter_id": 23557, "verse_number": "१९७-१", "content_sanskrit": "ऋषिपुत्र उवाच ।\nदशयोजनविस्तारं ततो द्विगुणमायतम् ।\nप्राकारेण परिक्षिप्तं प्रासादशत शोभितम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003557001, "chapter_id": 23557, "verse_number": "१९७-२", "content_sanskrit": "समालिखदिवाकाशं प्रदीप्तमिव तेजसा ।\nगोपुरं तूत्तमं तत्र प्रासादशतशोभितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003557002, "chapter_id": 23557, "verse_number": "१९७-३", "content_sanskrit": "नानायन्त्रैः समाकीर्णं ज्वालामालासमायुतम् ।\nदेवतानामृषीणां च ये चान्ये शुभकारिणः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003557003, "chapter_id": 23557, "verse_number": "१९७-४", "content_sanskrit": "प्रवेशस्तत्र तेषां हि विहितो धर्मदर्शिनाम् ।\nराजते गोपुरं सर्वं शारदाभ्रचयप्रभम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003557004, "chapter_id": 23557, "verse_number": "१९७-५", "content_sanskrit": "मानुषाणां सुकृतिनां प्रवेशस्तत्र निर्मितः ।\nअग्निघर्मसमाकीर्णं सर्वदोषसमन्वितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003557005, "chapter_id": 23557, "verse_number": "१९७-६", "content_sanskrit": "आयसं गोपुरं तत्र दक्षिणं भीमदर्शनम् ।\nरौद्रं प्रतिभयाकारं सुतप्तं दुर्निरीक्षणम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003557006, "chapter_id": 23557, "verse_number": "१९७-७", "content_sanskrit": "प्रवेशो हि ततस्तेन विहितो रविसूनुना ।\nपापिष्ठानां नृशंसानां क्रव्यादानां दुरात्मनाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003557007, "chapter_id": 23557, "verse_number": "१९७-८", "content_sanskrit": "पापानां चैव सर्वेषां ये चान्ये घातकारकाः ।\nऔदुम्बरमवीचीकमुच्चावचमनःकृतम ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003557008, "chapter_id": 23557, "verse_number": "१९७-९", "content_sanskrit": "गोपुरं पश्चिमं तच्च दुर्निरीक्षं समन्ततः ।\nमहता वह्निजालेन समालिप्तं भयानकम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003557009, "chapter_id": 23557, "verse_number": "१९७-१०", "content_sanskrit": "दुष्कृतीनां प्रवेशार्थं यमेन विहितं स्वयम् ।\nतस्मिन् पुरवरे रम्ये रम्या परम शोभना ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003557010, "chapter_id": 23557, "verse_number": "१९७-११", "content_sanskrit": "सर्वरत्नमयी दिव्या वैवस्वतनियोजिता ।\nसभा परमसम्पन्ना धार्मिकैः सत्यवादिभिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003557011, "chapter_id": 23557, "verse_number": "१९७-१२", "content_sanskrit": "जितक्रोधैरलुब्धैश्च वीतरागैस्तपस्विभिः ।\nसा सभा धर्मयुक्तानां सा सभा पापकारिणाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003557012, "chapter_id": 23557, "verse_number": "१९७-१३", "content_sanskrit": "सा सभा सर्वलोकस्य शुभस्यैवाशुभस्य च ।\nकर्मणा सूचितस्याथ सा सभा धर्मसंहिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003557013, "chapter_id": 23557, "verse_number": "१९७-१४", "content_sanskrit": "अनिर्वर्त्यं यथा कर्म शास्त्रदृष्टेन कर्मणा ।\nनिर्विशङ्का निराक्षेपा धर्मज्ञा धर्मपाठकाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003557014, "chapter_id": 23557, "verse_number": "१९७-१५", "content_sanskrit": "चिन्तयन्ति च कार्याणि सर्वलोकहिताय ते ।\nयथादृष्टं यथाशास्त्रं यथाकालनिवेदकाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003557015, "chapter_id": 23557, "verse_number": "१९७-१६", "content_sanskrit": "ततः सर्वे च तत्सर्वं चिन्तयन्ति सुयन्त्रिताः ।\nमनुः प्रजापतिश्चैव पाराशर्यो महामुनिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003557016, "chapter_id": 23557, "verse_number": "१९७-१७", "content_sanskrit": "अत्रिरौद्दालकिश्चैव आपस्तम्बश्च वीर्यवान् ।\nबृहस्पतिश्च शुक्रश्च गौतमश्च महातपाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003557017, "chapter_id": 23557, "verse_number": "१९७-१८", "content_sanskrit": "शङ्खश्च लिखितश्चैव ह्यङ्गिरा भृगुरेव च ।\nपुलस्त्यः पुलहश्चैव ये चान्ये धर्मपाठकाः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003557018, "chapter_id": 23557, "verse_number": "१९७-१९", "content_sanskrit": "यमेन सहिताः सर्वे चिन्तयन्ति प्रतिक्रियाम् ।\nसर्वे च कामप्रचुरा ये दिव्या ये च मानुषाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003557019, "chapter_id": 23557, "verse_number": "१९७-२०", "content_sanskrit": "कुण्डलाभ्यां पिनद्धाभ्यामङ्गदाभ्यां महातपाः ।\nभ्राजते मुकुटस्तस्य ब्रह्मदत्तो महाद्युतिः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003557020, "chapter_id": 23557, "verse_number": "१९७-२१", "content_sanskrit": "तेजसा वचसा चैव दुर्निरीक्ष्यो महाबलः ।\nएकस्थमिव सर्वेषां तेजस्तेजस्विनां तदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003557021, "chapter_id": 23557, "verse_number": "१९७-२२", "content_sanskrit": "तस्य पार्श्वे महादिव्या ऋषयो ब्रह्मवादिनः ।\nदीप्यमानाः स्ववपुषा वेदवेदाङ्गपारगाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003557022, "chapter_id": 23557, "verse_number": "१९७-२३", "content_sanskrit": "वेदार्थानां विचारज्ञाः सत्यधर्मपुरस्कृताः ।\nछन्दःशिक्षाविकल्पज्ञाः सर्वशास्त्रविकल्पकाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003557023, "chapter_id": 23557, "verse_number": "१९७-२४", "content_sanskrit": "निरुक्तमतिवादाश्च सामगान्धर्वशोभिताः ।\nधातुवादाश्च विविधा निरुक्ताश्चैव नैगमाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003557024, "chapter_id": 23557, "verse_number": "१९७-२५", "content_sanskrit": "तत्र चैव मया दृष्टा ऋषयः पितरस्तथा ।\nभवने धर्मराजस्य प्रगायन्तः कथाः शुभाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003557025, "chapter_id": 23557, "verse_number": "१९७-२६", "content_sanskrit": "तस्य पार्श्वे मया दृष्टः कृष्णवर्णो   महाहनुः ।\nउत्तमः प्रकृताकार उर्द्ध्वरोमा निराकृतिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003557026, "chapter_id": 23557, "verse_number": "१९७-२७", "content_sanskrit": "वामबाहुश्च दण्डेन प्रवरेण समन्वितः ।\nविकृतास्यो महादंष्ट्रो नित्यक्रुद्धो भयानकः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003557027, "chapter_id": 23557, "verse_number": "१९७-२८", "content_sanskrit": "शिक्षार्थे धर्मराजेन सन्दिष्टः स पुनः पुनः ।\nशृणोति चैव कालोऽसौ नित्ययुक्तः सनातनः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003557028, "chapter_id": 23557, "verse_number": "१९७-२९", "content_sanskrit": "तथान्ये चापरे तत्र शासनेषु समाहिताः ।\nदृष्टास्तत्र मया तात सर्वतेजोमयी शुभा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003557029, "chapter_id": 23557, "verse_number": "१९७-३०", "content_sanskrit": "यमेन पूज्यमाना सा दिव्यगन्धानुलेपनैः ।\nसंहारः सर्वलोकानां गतीनां च महागतिः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003557030, "chapter_id": 23557, "verse_number": "१९७-३१", "content_sanskrit": "अतः परं न कर्त्तव्यं साधनं कथितं बुधैः ।\nबिभ्यंति ह्यसुरास्तत्र ऋषयश्च तपोधनाः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003557031, "chapter_id": 23557, "verse_number": "१९७-३२", "content_sanskrit": "असुराश्च सुराश्चैव योगिनश्च महौजसः ।\nनमस्कार्या च पूज्या च मोहिनी सर्वसाधनी ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003557032, "chapter_id": 23557, "verse_number": "१९७-३३", "content_sanskrit": "तस्याङ्गेभ्यः समुद्भूता व्याधयः क्लेशसम्भवाः ।\nअपराश्च महाघोराः व्याधयः कालनिर्मिताः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003557033, "chapter_id": 23557, "verse_number": "१९७-३४", "content_sanskrit": "पौरुषेण समायुक्ताः सर्वलोकनयायताः ।\nप्रकृत्या दुर्विनीतश्च महाक्रोधः सुदारुणः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003557034, "chapter_id": 23557, "verse_number": "१९७-३५", "content_sanskrit": "महासत्त्वो महातेजाः जरामरणवर्जितः ।\nमृत्युर्दृष्टा दुराधर्षो दिव्यगन्धानुलेपनः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003557035, "chapter_id": 23557, "verse_number": "१९७-३६", "content_sanskrit": "गायका हासकाश्चैव सर्वजीवप्रबोधकाः ।\nमृत्युना सहिता नित्यं कालज्ञा कालसम्मताः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003557036, "chapter_id": 23557, "verse_number": "१९७-३७", "content_sanskrit": "दिव्याभरणशोभाभिः शोभमानाः सुतेजसः ।\nसवालव्यजनच्छन्नैः केचित्तत्र महौजसः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003557037, "chapter_id": 23557, "verse_number": "१९७-३८", "content_sanskrit": "पर्यास्तरणसंछन्नेष्वासनेषु तथा परे ।\nपूज्यमाना मया दृष्टाः केचित्तत्र महौजसः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003557038, "chapter_id": 23557, "verse_number": "१९७-३९", "content_sanskrit": "अनेकाश्च नरास्तत्र वेदनाश्च सुदारुणाः ।\nनारीनरस्वरूपाश्च मया दृष्टास्त्वनेकशः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003557039, "chapter_id": 23557, "verse_number": "१९७-४०", "content_sanskrit": "कामक्रोधविचारिण्यो नानारूपधराः स्त्रियः ।\nजीवभक्षकरा घोरास्तीव्ररोषा भयानकाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003557040, "chapter_id": 23557, "verse_number": "१९७-४१", "content_sanskrit": "तासां हलहलाशब्दः सर्वासां च समन्ततः ।\nधर्मराजसमीपे तु दारयन्ति धरामिमाम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003557041, "chapter_id": 23557, "verse_number": "१९७-४२", "content_sanskrit": "कूष्माण्डा यातुधानाश्च राक्षसाः पिशिताशनाः ।\nएकपादा द्विपादाश्च त्रिपादा बहुपादकाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003557042, "chapter_id": 23557, "verse_number": "१९७-४३", "content_sanskrit": "एकबाहुर्द्विबाहुश्च त्रिबाहुर्बहुबाहुकः ।\nशङ्कुकर्णा महाकर्णा हस्तिकर्णास्तथाऽपरे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003557043, "chapter_id": 23557, "verse_number": "१९७-४४", "content_sanskrit": "केचित्तु तत्र पुरुषाः सर्वशोभाविशोभिताः ।\nकेयूरैर्मुकुटैश्चान्ये चित्रैरङ्गैस्तथाऽपरे ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003557044, "chapter_id": 23557, "verse_number": "१९७-४५", "content_sanskrit": "स्रग्विणो बद्धपादाश्च सर्वाभरणभूषिताः ।\nसकुठाराः सकुद्दालाः सचक्राः शूलपाणयः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003557045, "chapter_id": 23557, "verse_number": "१९७-४६", "content_sanskrit": "सशक्तितोमराः केचित्सधनुष्का दुरासदाः ।\nअसिहस्तास्तथा चान्ये तथा मुद्गरपाणयः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003557046, "chapter_id": 23557, "verse_number": "१९७-४७", "content_sanskrit": "सज्जिता दधिहस्ताश्च गन्धहस्ता ह्यनेकशः ।\nविचित्रभक्षहस्ताश्च वस्त्रहस्तास्तथैव च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003557047, "chapter_id": 23557, "verse_number": "१९७-४८", "content_sanskrit": "धूपान्प्रगृह्य विविधान्वासांसि शुभदर्शनाः ।\nशिबिकाश्च महाशोभा यानानि विविधानि च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003557048, "chapter_id": 23557, "verse_number": "१९७-४९", "content_sanskrit": "वाजिकुञ्जरयुक्तानि हंसयुक्तानि चापरे ।\nशरभै ऋषभैश्चापि हस्तिभिश्च सुदर्शनैः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003557049, "chapter_id": 23557, "verse_number": "१९७-५०", "content_sanskrit": "मयूरैः सारसैश्चैव चक्रवाकैश्च वाजिभिः ।\nएवंरूपा मया दृष्टास्तत्र चान्ये भयानकाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003557050, "chapter_id": 23557, "verse_number": "१९७-५१", "content_sanskrit": "उज्ज्वला मलिनाश्चैव जीर्णवस्त्रा नवांशुकाः ।\nसुमनाभिमना मूका मारकाः शतमारका ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003557051, "chapter_id": 23557, "verse_number": "१९७-५२", "content_sanskrit": "समार्जारी काचवर्णा कृष्णा चैव कलिस्तथा ।\nधर्महस्ता यशोहस्ताः कीर्त्तिहस्तास्तथापरे ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003557052, "chapter_id": 23557, "verse_number": "१९७-५३", "content_sanskrit": "एते पुरोगमास्तत्र कृतान्तस्य महात्मनः ।\nयद्येतानि यजेद्विप्रो नास्ति तस्य पराभवः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003557053, "chapter_id": 23557, "verse_number": "१९७-५४", "content_sanskrit": "नमस्कार्याश्च पूज्याश्च आपन्नेन हि नित्यशः ।\nपरितुष्य कृता नित्यं विहिताः सार्वलौकिकाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]