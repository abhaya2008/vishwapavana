[{"id": 6000256000, "chapter_id": 10256, "verse_number": null, "content_sanskrit": "अथ षष्टितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000256001, "chapter_id": 10256, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.001.m4a", "display_order": 2}, {"id": 6000256002, "chapter_id": 10256, "verse_number": "१०-६०-१", "content_sanskrit": "सत्राजित्तनयां तन्वीं कृष्णाय कृतकिल्बिषः।\nस्यमन्तकेन मणिना स्वयमुद्यम्य दत्तवान्॥ १०/६०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.002.m4a", "display_order": 3, "topics": [{"text": "सत्राजितः सूर्यमाराध्य स्यमन्तकाख्यं मणिं लेभे", "range": "१–३"}]}, {"id": 6000256003, "chapter_id": 10256, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.003.m4a", "display_order": 4}, {"id": 6000256004, "chapter_id": 10256, "verse_number": "१०-६०-२", "content_sanskrit": "सत्राजितः किमकरोद् ब्रह्मन् कृष्णस्य किल्बिषम्।\nस्यमन्तकः कुतस्तस्य कस्माद् दत्ता सुता हरेः॥ १०/६०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.004.m4a", "display_order": 5}, {"id": 6000256005, "chapter_id": 10256, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.005.m4a", "display_order": 6}, {"id": 6000256006, "chapter_id": 10256, "verse_number": "१०-६०-३", "content_sanskrit": "आसीत् सत्राजितःसूर्यः भक्तस्य परमः सखा।\nप्रीतस्तस्मै मणिं प्रादात्सूर्यस्तुष्टः स्यमन्तकम्॥ १०/६०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.006.m4a", "display_order": 7}, {"id": 6000256007, "chapter_id": 10256, "verse_number": "१०-६०-४", "content_sanskrit": "स तं बिभ्रन् मणिं कण्ठे भ्राजमानो यथा रविः।\nप्रविष्टो द्वारकां राजंस्तेजसा नोपलक्षितः॥ १०/६०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.007.m4a", "display_order": 8}, {"id": 6000256008, "chapter_id": 10256, "verse_number": "१०-६०-५", "content_sanskrit": "तं विलोक्य जना दूरात् तेजसा मुष्टदृष्टयः।\nदीव्यतेऽक्षैर्भगवते शशंसुः सूर्यमागतम्॥ १०/६०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.008.m4a", "display_order": 9}, {"id": 6000256009, "chapter_id": 10256, "verse_number": "१०-६०-६", "content_sanskrit": "नारायण नमस्तेऽस्तु शङ्खचक्रगदाधर।\nदामोदरारविन्दाक्ष गोविन्द यदुनन्दन॥ १०/६०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.009.m4a", "display_order": 10}, {"id": 6000256010, "chapter_id": 10256, "verse_number": "१०-६०-७", "content_sanskrit": "एष आयाति सविता त्वां दिदृक्षुर्जगत्पते।\nमुष्णन् गभस्तिचक्रेण नृणां चक्षूंषि तिग्मरुक्॥ १०/६०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.010.m4a", "display_order": 11}, {"id": 6000256011, "chapter_id": 10256, "verse_number": "१०-६०-८", "content_sanskrit": "नन्वन्विच्छन्ति ते मार्गं त्रिलोक्यां विबुधर्षभाः।\nज्ञात्वाऽद्य गूढं यदुषु द्रष्टुं त्वां यात्यजः प्रभुः॥ १०/६०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.011.m4a", "display_order": 12}, {"id": 6000256012, "chapter_id": 10256, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.012.m4a", "display_order": 13}, {"id": 6000256013, "chapter_id": 10256, "verse_number": "१०-६०-९", "content_sanskrit": "निशम्य बालवचनं प्रहस्याम्बुजलोचनः।\nप्राह नासौ रविर्देवः सत्राजिन्मणिना ज्वलन्॥ १०/६०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.013.m4a", "display_order": 14}, {"id": 6000256014, "chapter_id": 10256, "verse_number": "१०-६०-१०", "content_sanskrit": "सत्राजित् स्वगृहं श्रीमत् कृतकौतुकमङ्गलम्।\nप्रविश्य देवसदने मणिं विप्रैर्न्यवेशयत्॥ १०/६०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.014.m4a", "display_order": 15}, {"id": 6000256015, "chapter_id": 10256, "verse_number": "१०-६०-११", "content_sanskrit": "दिने दिने स्वर्णभारानष्टौ स सृजति प्रभो।\nदुर्भिक्षमार्यरिष्टानि सर्वेऽपि व्याधयोऽशुभाः॥ १०/६०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.015.m4a", "display_order": 16}, {"id": 6000256016, "chapter_id": 10256, "verse_number": "१०-६०-१२", "content_sanskrit": "न सन्ति मायिनस्तत्र यद्राष्ट्रेऽभ्यर्चितो मणिः।\nस याचितो मणिं क्‍वापि यदुराजाय शौरिणा॥ १०/६०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.016.m4a", "display_order": 17}, {"id": 6000256017, "chapter_id": 10256, "verse_number": "१०-६०-१३", "content_sanskrit": "नैवार्थकामुकः प्रादाद् याञ्चाभङ्गमतर्कयन्।\nतमेकदा मणिं कण्ठे प्रतिमुच्य महाप्रभम्॥ १०/६०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.017.m4a", "display_order": 18, "topics": [{"text": "प्रसेनस्तं मणिं कण्ठे धृत्वा वने मृगयामाचरत्", "range": "१३"}]}, {"id": 6000256018, "chapter_id": 10256, "verse_number": "१०-६०-१४", "content_sanskrit": "प्रसेनो हयमारुह्य मृगयां व्यचरद् वने।\nप्रसेनं सहयं हत्वा मणिमाच्छिद्य केसरी॥ १०/६०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.018.m4a", "display_order": 19, "topics": [{"text": "सिंहस्तं हत्वा मणिमादाय गतः", "range": "१४"}]}, {"id": 6000256019, "chapter_id": 10256, "verse_number": "१०-६०-१५", "content_sanskrit": "बिलं विशन् जाम्बवता निहतो मणिमिच्छता।\nसोऽपि चक्रे कुमारस्य मणिं क्रीडनकं बिले॥ १०/६०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.019.m4a", "display_order": 20, "topics": [{"text": "गच्छन्तं सिंहं जाम्बवान्हत्वा मणिं कुमारस्य क्रीडनकं चक्रे", "range": "१५"}]}, {"id": 6000256020, "chapter_id": 10256, "verse_number": "१०-६०-१६", "content_sanskrit": "अपश्यन् भ्रातरं भ्राता सत्राजित् पर्यतप्यत।\nप्रायः कृष्णेन निहतो मणिग्रीवो वनं गतः॥ १०/६०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.020.m4a", "display_order": 21, "topics": [{"text": "कृष्णः स्वस्यागतमपयशो मार्ष्टुं वनं गत्वा जाम्बवन्तं युद्धेऽजयत्", "range": "१६–२५"}]}, {"id": 6000256021, "chapter_id": 10256, "verse_number": "१०-६०-१७", "content_sanskrit": "भ्राता ममेति तच्छ्रुत्वा कर्णे कर्णेऽजपन् जनाः।\nभगवान् तदुपश्रुत्य दुर्यशो लिप्तमात्मनि॥ १०/६०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.021.m4a", "display_order": 22}, {"id": 6000256022, "chapter_id": 10256, "verse_number": "१०-६०-१८", "content_sanskrit": "मार्ष्टुं प्रसेनपदवीमन्वपद्यत नागरैः।\nहतं प्रसेनमश्वं च वीक्ष्य केसरिणा वने॥ १०/६०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.022.m4a", "display_order": 23}, {"id": 6000256023, "chapter_id": 10256, "verse_number": "१०-६०-१९", "content_sanskrit": "तं चाद्रिपृष्ठे निहतमृक्षेण ददृशुर्जनाः। ऋक्षराजबिलं भीममन्धेन तमसा वृतम्।\nएको विवेश भगवानवस्थाप्य बहिः प्रजाः॥ १०/६०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.023.m4a", "display_order": 24}, {"id": 6000256024, "chapter_id": 10256, "verse_number": "१०-६०-२०", "content_sanskrit": "तत्र दृष्ट्वा मणिश्रेष्ठं बालक्रीडनकं कृतम्।\nहर्तुं कृतमतिस्तस्मिन्नवतस्थेऽर्भकान्तिके॥ १०/६०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.024.m4a", "display_order": 25}, {"id": 6000256025, "chapter_id": 10256, "verse_number": "१०-६०-२१", "content_sanskrit": "तमपूर्वं नरं दृष्ट्वा धात्री चुक्रोश भीतवत्।\nतच्छ्रुत्वाऽभ्यद्रवत् क्रुद्धो जाम्बवान् बलिनां वरः॥ १०/६०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.025.m4a", "display_order": 26}, {"id": 6000256026, "chapter_id": 10256, "verse_number": "१०-६०-२२", "content_sanskrit": "स वै भगवता तेन युयुधे स्वामिनाऽऽत्मनः।\nपुरुषं प्राकृतं मत्वा कुपितो नानुभाववित्॥ १०/६०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.026.m4a", "display_order": 27}, {"id": 6000256027, "chapter_id": 10256, "verse_number": "१०-६०-२३", "content_sanskrit": "द्वन्द्वयुद्धं सुतुमुलमुभयोर्विजिगीषतोः।\nआयुधाश्मद्रुमैर्दोर्भिः क्रव्यार्थे श्येनयोरिव॥ १०/६०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.027.m4a", "display_order": 28}, {"id": 6000256028, "chapter_id": 10256, "verse_number": "१०-६०-२४", "content_sanskrit": "आसीत् तदष्टविंशाहमितरेतरमुष्टिभिः।\nवज्रनिष्पेषपरुषैरविश्रममहर्निशम्॥ १०/६०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.028.m4a", "display_order": 29}, {"id": 6000256029, "chapter_id": 10256, "verse_number": "१०-६०-२५", "content_sanskrit": "कृष्णमुष्टिविनिष्पातनिष्पिष्टाङ्गोरुबन्धनः।\nक्षीणसत्त्वः स्विन्नगात्रस्तमाहातीव विस्मितः॥ १०/६०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.029.m4a", "display_order": 30}, {"id": 6000256030, "chapter_id": 10256, "verse_number": "१०-६०-२६", "content_sanskrit": "जाने त्वां सर्वभूतानां प्राणओजःसहोबलम्।\nविष्णुं पुराणपुरुषं प्रभविष्णुमधीश्वरम्॥ १०/६०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.030.m4a", "display_order": 31, "topics": [{"text": "जाम्बवता स्वापराधं परिहर्तुं श्रीकृष्णाय मणिना सह जाम्बवतीप्रदानम्", "range": "२६–३२"}]}, {"id": 6000256031, "chapter_id": 10256, "verse_number": "१०-६०-२७", "content_sanskrit": "त्वं हि विश्वसृजां स्रष्टा सृष्टानामधिपो वसन्।\nकालः कलयतामीश पर आत्मा तथाऽऽत्मनाम्॥ १०/६०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.031.m4a", "display_order": 32}, {"id": 6000256032, "chapter_id": 10256, "verse_number": "१०-६०-२८", "content_sanskrit": "यस्येषदुत्कलितरोषकटाक्षमोक्षैर्वर्त्मादिशत् क्षुभितनक्रतिमिङ्गिलोऽब्धिः।\nसेतुः कृतः स्वयशउज्ज्वलिता च लङ्का रक्षःशिरांसि भुवि पेतुरिषुक्षतानि॥ १०/६०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.032.m4a", "display_order": 33}, {"id": 6000256033, "chapter_id": 10256, "verse_number": "१०-६०-२९", "content_sanskrit": "इति विज्ञातविज्ञानमृक्षराजानमच्युतः।\nव्याजहार महाराज भगवान् देवकीसुतः॥ १०/६०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.033.m4a", "display_order": 34}, {"id": 6000256034, "chapter_id": 10256, "verse_number": "१०-६०-३०", "content_sanskrit": "अभिमृष्यारविन्दाक्षः पाणिना शङ्करेण तम्।\nकृपया परया भक्तं मेघगम्भीरया गिरा॥ १०/६०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.034.m4a", "display_order": 35}, {"id": 6000256035, "chapter_id": 10256, "verse_number": "१०-६०-३१", "content_sanskrit": "मणिहेतोरिह प्राप्ता वयमृक्षपते बिलम्।\nमिथ्याभिशापं प्रमृजन्नात्मनो मणिनाऽमुना॥ १०/६०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.035.m4a", "display_order": 36}, {"id": 6000256036, "chapter_id": 10256, "verse_number": "१०-६०-३२", "content_sanskrit": "इत्युक्तः स्वां दुहितरं कन्यां जाम्बवतीं मुदा।\nअर्हणार्थं सहमणिं कृष्णायोपजहार सः॥ १०/६०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.036.m4a", "display_order": 37}, {"id": 6000256037, "chapter_id": 10256, "verse_number": "१०-६०-३३", "content_sanskrit": "अदृष्ट्वा निर्गमं शौरेः प्रविष्टस्य बिलं जनाः।\nप्रतीक्ष्य द्वादशाहानि दुःखितास्ते पुरं ययुः॥ १०/६०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.037.m4a", "display_order": 38}, {"id": 6000256038, "chapter_id": 10256, "verse_number": "१०-६०-३४", "content_sanskrit": "निशम्य देवकी देवी रुग्मिण्यानकदुन्दुभिः।\nसुहृदो ज्ञातयोऽशोचन् बिलात् कृष्णमनिर्गतम्॥ १०/६०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.038.m4a", "display_order": 39}, {"id": 6000256039, "chapter_id": 10256, "verse_number": "१०-६०-३५", "content_sanskrit": "सत्राजितं शपन्तस्ते दुःखिता द्वारकौकसः।\nउपतस्थुर्महामायां दुर्गां कृष्णोपलब्धये॥ १०/६०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.039.m4a", "display_order": 40}, {"id": 6000256040, "chapter_id": 10256, "verse_number": "१०-६०-३६", "content_sanskrit": "तेषां तु देव्युपस्थानात् प्रत्यादिष्टाशिषांभवन्।\nप्रादुर्बभूव सिद्धार्थः सदारो हर्षयन् हरिः॥ १०/६०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.040.m4a", "display_order": 41}, {"id": 6000256041, "chapter_id": 10256, "verse_number": "१०-६०-३७", "content_sanskrit": "उपलभ्य हृषीकेशं मृतं पुनरिवागतम्।\nसह पत्न्या मणिग्रीवं सर्वे जातमहोत्सवाः॥ १०/६०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.041.m4a", "display_order": 42}, {"id": 6000256042, "chapter_id": 10256, "verse_number": "१०-६०-३८", "content_sanskrit": "सत्राजितं समाहूय सभायां राजसन्निधौ।\nप्राप्तिं चाख्याय भगवान् मणिं तस्मै न्यवेदयत्॥ १०/६०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.042.m4a", "display_order": 43}, {"id": 6000256043, "chapter_id": 10256, "verse_number": "१०-६०-३९", "content_sanskrit": "स चातिव्रीडितो रत्नं गृहीत्वाऽवाङ्मुखस्ततः।\nअनुतप्यन् स्वभवनमगमत् स्वेन पाप्मना॥ १०/६०/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.043.m4a", "display_order": 44}, {"id": 6000256044, "chapter_id": 10256, "verse_number": "१०-६०-४०", "content_sanskrit": "सोऽनुध्यायंस्तदेवाघं बलवद्विग्रहाकुलः।\nकथं मृजाम्यात्मरजः प्रसीदेद् वाऽच्युतः कथम्॥ १०/६०/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.044.m4a", "display_order": 45}, {"id": 6000256045, "chapter_id": 10256, "verse_number": "१०-६०-४१", "content_sanskrit": "किं कृत्वा साधु मह्यं स्यान्न शपेद् वा जनो यथा।\nअदीर्घदर्शनं धिङ्मां मूढं द्रविणलोलुपम्॥ १०/६०/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.045.m4a", "display_order": 46}, {"id": 6000256046, "chapter_id": 10256, "verse_number": "१०-६०-४२", "content_sanskrit": "दास्ये दुहितरं तस्मै स्‍त्रीरत्नं रत्नमेव च।\nउपायोऽयं समीचीनस्तस्य शान्तेर्न चान्यथा॥ १०/६०/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.046.m4a", "display_order": 47}, {"id": 6000256047, "chapter_id": 10256, "verse_number": "१०-६०-४३", "content_sanskrit": "एवं व्यवसितो बुद्ध्या सत्राजित् स्वसुतां शुभाम्।\nमणिं च स्वयमुद्यम्य कृष्णायोपजहार ताम्॥ १०/६०/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.047.m4a", "display_order": 48}, {"id": 6000256048, "chapter_id": 10256, "verse_number": "१०-६०-४४", "content_sanskrit": "स सत्यभामां भगवानुपयेमे यथाविधि।\nबहुभिर्याचितां शीलरूपौदार्यगुणान्विताम्॥ १०/६०/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.048.m4a", "display_order": 49, "topics": [{"text": "श्रीकृष्णसत्यभामाविवाहः", "range": "४४"}]}, {"id": 6000256049, "chapter_id": 10256, "verse_number": "१०-६०-४५", "content_sanskrit": "भगवानाह न मणिं प्रतीच्छामो वयं नृप।\nतवास्तु देवभक्तस्य वयं हि फलभागिनः॥ १०/६०/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_060/BhP_10.060.049.m4a", "display_order": 50}, {"id": 6000256050, "chapter_id": 10256, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे षष्टितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]