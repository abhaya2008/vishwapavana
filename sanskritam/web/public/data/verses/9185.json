[{"id": 5000185000, "chapter_id": 9185, "verse_number": "२-१०८-१", "content_sanskrit": "आश्वासयन्तं भरतं जाबालिर्ब्राह्मणोत्तम: ।\nउवाच रामं धर्मज्ञं धर्मापेतमिदं वच: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000185001, "chapter_id": 9185, "verse_number": "२-१०८-२", "content_sanskrit": "साधु राघव माभूत्ते बुद्धिरेवं निरर्थिका ।\nप्राकृतस्य नरस्येव ह्यार्यबुद्धेर्मनस्विन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000185002, "chapter_id": 9185, "verse_number": "२-१०८-३", "content_sanskrit": "क: कस्य पुरुषो बन्धु: किमाप्यं कस्य केनचित् ।\nयदेको जायते जन्तुरेक एव विनश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000185003, "chapter_id": 9185, "verse_number": "२-१०८-४", "content_sanskrit": "तस्मान्माता पिता चेति राम सज्जेतयो नर: ।\nउन्मत्त इव स ज्ञेयो नास्ति कश्चिद्धि कस्यचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000185004, "chapter_id": 9185, "verse_number": "२-१०८-५", "content_sanskrit": "यथा ग्रामान्तरं गच्छन् नर: कश्चित् क्वचिद्वसेत् ।\nउत्सृज्य च तमावासं प्रतिष्ठेतापरे ऽहनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000185005, "chapter_id": 9185, "verse_number": "२-१०८-६", "content_sanskrit": "एवमेव मनुष्याणां पिता माता गृहं वसु ।\nआवासमात्रं काकुत्स्थ सज्जन्ते नात्र सज्जना: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000185006, "chapter_id": 9185, "verse_number": "२-१०८-७", "content_sanskrit": "पित्र्यं राज्यं परित्यज्य स नार्हसि नरोत्तम ।\nआस्थातुं कापथं दु:खं विषमं बहुकण्टकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000185007, "chapter_id": 9185, "verse_number": "२-१०८-८", "content_sanskrit": "समृद्धायामयोध्यायामात्मानमभिषेचय ।\nएकवेणी धरा हि त्वां नगरी सम्प्रतीक्षते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000185008, "chapter_id": 9185, "verse_number": "२-१०८-९", "content_sanskrit": "राजभोगाननुभवन् महार्हान् पार्थिवात्मज ।\nविहर त्वमयोध्यायां यथा शक्रस्त्रिविष्टपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000185009, "chapter_id": 9185, "verse_number": "२-१०८-१०", "content_sanskrit": "न ते कश्चिद्दशरथस्त्वं च तस्य न कश्चन ।\nअन्यो राजा त्वमन्य: स तस्मात् कुरु यदुच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000185010, "chapter_id": 9185, "verse_number": "२-१०८-११", "content_sanskrit": "बीजमात्रं पिता जन्तो: शुक्लं रुधिरमेव च ।\nसंयुक्तमृतुमन्मात्रा पुरुषस्येह जन्म तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000185011, "chapter_id": 9185, "verse_number": "२-१०८-१२", "content_sanskrit": "गत: स नृपतिस्तत्र गन्तव्यं यत्र तेन वै ।\nप्रवृत्तिरेषा मर्त्त्यानां त्वं तु मिथ्या विहन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000185012, "chapter_id": 9185, "verse_number": "२-१०८-१३", "content_sanskrit": "अर्थधर्मपरा ये ये तांस्तान् शोचामि नेतरान् ।\nते हि दु:खमिह प्राप्य विनाशं प्रेत्य भेजिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000185013, "chapter_id": 9185, "verse_number": "२-१०८-१४", "content_sanskrit": "अष्टका पितृदैवत्यमित्ययं प्रसृतो जन: ।\nअन्नस्योपद्रवं पश्य मृतो हि किमशिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000185014, "chapter_id": 9185, "verse_number": "२-१०८-१५", "content_sanskrit": "यदि भुक्तमिहान्येन देहमन्यस्य गच्छति ।\nदद्यात् प्रवसत: श्राद्धं न तत् पथ्यशनं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000185015, "chapter_id": 9185, "verse_number": "२-१०८-१६", "content_sanskrit": "दानसंवनना ह्येते ग्रन्था मेधाविभि: कृता: ।\nयजस्व देहि दीक्षस्व तपस्तप्यस्व सन्त्यज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000185016, "chapter_id": 9185, "verse_number": "२-१०८-१७", "content_sanskrit": "स नास्ति परमित्येव कुरु बुद्धिं महामते ।\nप्रत्यक्षं यत्तदातिष्ठ परोक्षं पृष्ठत: कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000185017, "chapter_id": 9185, "verse_number": "२-१०८-१८", "content_sanskrit": "स तां बुद्धिं पुरस्कृत्य सर्वलोकनिदर्शिनीम् ।\nराज्यं त्वं प्रतिगृह्णीष्व भरतेन प्रसादित: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000185018, "chapter_id": 9185, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे अष्टोत्तरशततम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]