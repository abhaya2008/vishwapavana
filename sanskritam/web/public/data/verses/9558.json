[{"id": 5000558000, "chapter_id": 9558, "verse_number": "७-२३-१", "content_sanskrit": "ततो जित्वा दशग्रीवो यमं त्रिदशपुङ्गवम् ।\nरावणस्तु रणश्लाघी स्वसहायान्ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000558001, "chapter_id": 9558, "verse_number": "७-२३-२", "content_sanskrit": "ततो रुधिरसिक्ताङ्गं प्रहारैर्जर्जरीकृतम् ।\nरावणं राक्षसा दृष्ट्वा ह्यष्टवत् समुपागमन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000558002, "chapter_id": 9558, "verse_number": "७-२३-३", "content_sanskrit": "जयेन वर्धयित्वा च मारीचप्रमुखास्ततः ।\nपुष्पकं भेजिरे सर्वे सान्त्विता रावणेन तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000558003, "chapter_id": 9558, "verse_number": "७-२३-४", "content_sanskrit": "ततो रसातलं गच्छन् प्रविष्टः पयसां निधिम् ।\nदैत्योरगगणाध्युष्टं वरुणेन सुरक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000558004, "chapter_id": 9558, "verse_number": "७-२३-५", "content_sanskrit": "स तु भोगवतीं गत्वा पुरीं वासुकिपालिताम् ।\nकृत्वा नागान्वशे हृष्टो ययौ मणिमयीं पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000558005, "chapter_id": 9558, "verse_number": "७-२३-६", "content_sanskrit": "निवातकवचास्तत्र दैत्या लब्धवरा वसन् ।\nराक्षसान्तान्समागम्य युद्धाय समुपाह्वयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000558006, "chapter_id": 9558, "verse_number": "७-२३-७", "content_sanskrit": "ते तु सर्वे सुविक्रान्ता दैतेया बलशालिनः ।\nनानाप्रहरणास्तत्र प्रहृष्टा युद्धदुर्मदाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000558007, "chapter_id": 9558, "verse_number": "७-२३-८", "content_sanskrit": "शूलैस्त्रिशूलैः कुलिशैः पट्टिशासिपरश्वधैः ।\nअन्योन्यं बिभिदुः क्रुद्धा राक्षसा दानवास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000558008, "chapter_id": 9558, "verse_number": "७-२३-९", "content_sanskrit": "तेषां तु युध्यमानानां साग्रः संवत्सरो गतः ।\nन चान्यतरयोस्तत्र विजयो वा क्षयो ऽपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000558009, "chapter_id": 9558, "verse_number": "७-२३-१०", "content_sanskrit": "ततः पितामहस्तत्र त्रैलोक्यगतिरव्ययः ।\nआजगाम द्रुतं देवो विमानवरमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000558010, "chapter_id": 9558, "verse_number": "७-२३-११", "content_sanskrit": "निवातकवचानां तु निवार्य रणकर्म तत् ।\nवृद्धः पितामहो वाक्यमुवाच विदितार्थवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000558011, "chapter_id": 9558, "verse_number": "७-२३-१२", "content_sanskrit": "नह्ययं रावणो युद्धे शक्यो जेतुं सुरासुरैः ।\nन भवन्तः क्षयं नेतुमपि सामरदानवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000558012, "chapter_id": 9558, "verse_number": "७-२३-१३", "content_sanskrit": "राक्षसस्य सखित्वं च भवद्भिः सह रोचते ।\nअविभक्ताश्च सर्वार्थाः सुहृदां नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000558013, "chapter_id": 9558, "verse_number": "७-२३-१४", "content_sanskrit": "ततो ऽग्निसाक्षिकं सख्यं कृतवांस्तत्र रावणः ।\nनिवातकवचैः सार्धं प्रीतिमानभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000558014, "chapter_id": 9558, "verse_number": "७-२३-१५", "content_sanskrit": "अर्थतस्तैर्यथान्यायं संवत्सरमथोषितः ।\nस्वपुरान्निर्विशेषं च प्रियं प्राप्तो दशाननः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000558015, "chapter_id": 9558, "verse_number": "७-२३-१६", "content_sanskrit": "ततोपधार्य मायानां शतमेकं समाप्तवान् ।\nसलिलेन्द्रपुरान्वेषी भ्रमति स्म रसातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000558016, "chapter_id": 9558, "verse_number": "७-२३-१७", "content_sanskrit": "ततो ऽश्मनगरं नाम कालकेयैरधिष्ठितम् ।\nगत्वा तु कालकेयांश्च हत्वा तत्र बलोत्कटान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000558017, "chapter_id": 9558, "verse_number": "७-२३-१८", "content_sanskrit": "शूर्पणख्याश्च भर्तारमसिना प्राच्छिनत्तदा ।\nश्यालं च बलवन्तं च विद्युज्जिह्वं बलोत्कटम् ।\nजिह्वया संलिहन्तं च राक्षसं समरे तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000558018, "chapter_id": 9558, "verse_number": "७-२३-१९", "content_sanskrit": "तं विजित्य मुहूर्तेन जघ्ने दैत्यांश्चतुःशतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000558019, "chapter_id": 9558, "verse_number": "७-२३-२०", "content_sanskrit": "ततः पाण्डुरमेघाभं कैलासमिव भास्वरम् ।\nवरुणस्यालयं दिव्यमपश्यद्राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000558020, "chapter_id": 9558, "verse_number": "७-२३-२१", "content_sanskrit": "क्षरन्तीं च पयस्तत्र सुरभिं गामवस्थिताम् ।\nयस्याः पयोभिनिष्यन्दात्क्षीरोदो नाम सागरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000558021, "chapter_id": 9558, "verse_number": "७-२३-२२", "content_sanskrit": "ददर्श रावणस्तत्र गोवृषेन्द्रवरारणिम् ।\nयस्माच्चन्द्रः प्रभवति शीतरश्मिर्निशाकरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000558022, "chapter_id": 9558, "verse_number": "७-२३-२३", "content_sanskrit": "यं समाश्रित्य जीवन्ति फेनपाः परमर्षयः ।\nअमृतं यत्र चोत्पन्नं स्वधा च स्वधभोजिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000558023, "chapter_id": 9558, "verse_number": "७-२३-२४", "content_sanskrit": "यां ब्रुवन्ति नरा लोके सुरभिं नाम नामतः ।\nप्रदक्षिणं तु तां कृत्वा रावणः परमाद्भुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000558024, "chapter_id": 9558, "verse_number": "७-२३-२५", "content_sanskrit": "प्रविवेश महाघोरं गुप्तं बहुविधैर्बलैः ।\nततो धाराशताकीर्णं शारदाभ्रनिभं तदा ।\nनित्यप्रहृष्टं ददृशे वरुणस्य गृहोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000558025, "chapter_id": 9558, "verse_number": "७-२३-२६", "content_sanskrit": "ततो हत्वा बलाध्यक्षान्समरे तैश्च ताडितः ।\nअब्रवीच्च ततो योधान्राजा शीघ्रं निवेद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000558026, "chapter_id": 9558, "verse_number": "७-२३-२७", "content_sanskrit": "युद्धार्थी रावणः प्राप्तस्तस्य युद्धं प्रदीयताम् ।\nवद वा न भयं ते ऽस्ति निर्जितो ऽस्मीति साञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000558027, "chapter_id": 9558, "verse_number": "७-२३-२८", "content_sanskrit": "एतस्मिन्नन्तरे क्रुद्धा वरुणस्य महात्मनः ।\nपुत्राः पौत्राश्च निष्क्रामन्गौश्च पुष्कर एव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000558028, "chapter_id": 9558, "verse_number": "७-२३-२९", "content_sanskrit": "ते तु वीर्यगुणोपेता बलैः परिवृताः स्वकैः ।\nयुङ्क्त्वा रथान्कामगमानुद्यद्भास्वरवर्चसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000558029, "chapter_id": 9558, "verse_number": "७-२३-३०", "content_sanskrit": "ततो युद्धं समभवद्दारुणं रोमहर्षणम् ।\nसलिलेन्द्रस्य पुत्राणां रावणस्य च धीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000558030, "chapter_id": 9558, "verse_number": "७-२३-३१", "content_sanskrit": "अमात्यैश्च महावीर्यैर्दशग्रीवस्य रक्षसः ।\nवारुणं तद्बलं कृत्स्नं क्षणेन विनिपातितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000558031, "chapter_id": 9558, "verse_number": "७-२३-३२", "content_sanskrit": "समीक्ष्य स्वबलं सङ्ख्ये वरुणस्य सुतास्तदा ।\nअर्दिताः शरजालेन निवृत्ता रणकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000558032, "chapter_id": 9558, "verse_number": "७-२३-३३", "content_sanskrit": "महीतलगतास्ते तु रावणं दृश्य पुष्पके ।\nआकाशमाशु विविशुः स्यन्दनैः शीघ्रगामिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000558033, "chapter_id": 9558, "verse_number": "७-२३-३४", "content_sanskrit": "महादासीत्ततस्तेषां तुल्यं स्थानमवाप्य तत् ।\nआकाशयुद्धं तुमुलं देवदानवयोरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000558034, "chapter_id": 9558, "verse_number": "७-२३-३५", "content_sanskrit": "ततस्ते रावणं युद्धे शरैः पावकसन्निभैः ।\nविमुखीकृत्य सन्तुष्टा विनेदुर्विविधान्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000558035, "chapter_id": 9558, "verse_number": "७-२३-३६", "content_sanskrit": "ततो महोदरः क्रुद्धो राजानं दृश्य धर्षितम् ।\nत्यक्त्वा मृत्युभयं वीरो युद्धकाङ्क्षी व्यलोकयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000558036, "chapter_id": 9558, "verse_number": "७-२३-३७", "content_sanskrit": "तेन ते दारुणा युद्धे कामगाः पवनोपमाः ।\nमहोदरेण गदया हता वै प्रययुः क्षितिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000558037, "chapter_id": 9558, "verse_number": "७-२३-३८", "content_sanskrit": "तेषां वरुणपुत्राणां हत्वा योधान्हयाञ्छतान् ।\nमुमोचाशु महानादं विरथान्प्रेक्ष्य तान्स्थितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000558038, "chapter_id": 9558, "verse_number": "७-२३-३९", "content_sanskrit": "ते तु तेषां रथाः साश्वाः सह सारथिभिर्हतैः ।\nमहोदरेण निहताः पतिताः पृथिवीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000558039, "chapter_id": 9558, "verse_number": "७-२३-४०", "content_sanskrit": "ते तु त्यक्त्वा रथान्पुत्रा वरुणस्य महात्मनः ।\nआकाशे विष्ठिताः शूराः स्वप्रभावान्न विव्यथुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000558040, "chapter_id": 9558, "verse_number": "७-२३-४१", "content_sanskrit": "धनूंषि कृत्वा सज्जानि विनिर्भिद्य महोदरम् ।\nरावणं समरे क्रुद्धाः सहिताः समभिद्रवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000558041, "chapter_id": 9558, "verse_number": "७-२३-४२", "content_sanskrit": "सायकैश्चापविभ्रष्टैर्वज्रकल्पैः सुदारुणैः ।\nदारयन्ति स्म सङ्क्रुद्धा मेघा इव महागिरिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000558042, "chapter_id": 9558, "verse_number": "७-२३-४३", "content_sanskrit": "ततः क्रुद्धो दशग्रीवः कालाग्निरिव निर्गतः ।\nशरवर्षैर्महाघोरैस्तेषां मर्मस्वताडयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000558043, "chapter_id": 9558, "verse_number": "७-२३-४४", "content_sanskrit": "ततस्तेनैव सहसा सीदन्ति स्म पदातयः ।\nमुसलानि विचित्राणि ततो भल्लशतानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000558044, "chapter_id": 9558, "verse_number": "७-२३-४५", "content_sanskrit": "पट्टिशांश्चैव शक्तीश्च शतघ्नीस्तोमरांस्तथा ।\nपातयामास दुर्धर्षस्तेषामुपरि विष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000558045, "chapter_id": 9558, "verse_number": "७-२३-४६", "content_sanskrit": "अपविद्धास्तु ते वीरा विनिष्पेतुः पदातयः ।\nमहापङ्कमिवासाद्य कुञ्जराष्षष्टिहायनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000558046, "chapter_id": 9558, "verse_number": "७-२३-४७", "content_sanskrit": "सीदमानान्सुतान्दृष्ट्वा विह्वलान्सुमहौजसः ।\nननाद रावणो हर्षान्महानम्बुधरो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000558047, "chapter_id": 9558, "verse_number": "७-२३-४८", "content_sanskrit": "ततो रक्षो महानादान्मुक्त्वा हन्ति स्म वारुणान् ।\nनानाप्रहरणोपेतैर्धारापातैरिवाम्बुदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000558048, "chapter_id": 9558, "verse_number": "७-२३-४९", "content_sanskrit": "ततस्ते विमुखाः सर्वे पतिता धरणीतले ।\nरणात्स्वपुरुषैः शीघ्रं गृहाण्येव प्रवेशिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000558049, "chapter_id": 9558, "verse_number": "७-२३-५०", "content_sanskrit": "तानब्रवीत्ततो रक्षो वरुणाय निवेद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000558050, "chapter_id": 9558, "verse_number": "७-२३-५१", "content_sanskrit": "रावणं त्वब्रवीन्मन्त्री प्रहस्तो (प्रहसो) नाम वारुणः ।\nगतः खलु महाराजो ब्रह्मलोकं जलेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000558051, "chapter_id": 9558, "verse_number": "७-२३-५२", "content_sanskrit": "गान्धर्वं वरुणः श्रोतुं यं त्वमाह्वयसे युधि ।\nतत्किं तव वृथा वीर परिश्रम्य गते नृपे ।\nये तु सन्निहिता वीराः कुमारास्ते पराजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000558052, "chapter_id": 9558, "verse_number": "७-२३-५३", "content_sanskrit": "राक्षसेन्द्रस्तु तच्छ्रुत्वा नाम विश्राव्य चात्मनः ।\nहर्षान्नादं विमुञ्चन्वै निष्क्रान्तो वरुणालयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000558053, "chapter_id": 9558, "verse_number": "७-२३-५४", "content_sanskrit": "आगतस्तु पथा येन तेनैव विनिवृत्य सः ।\nलङ्कामभिमुखो रक्षो नभस्तलगतो ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000558054, "chapter_id": 9558, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे त्रयोविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]