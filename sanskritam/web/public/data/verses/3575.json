[{"id": 2119851, "chapter_id": 3575, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119852, "chapter_id": 3575, "verse_number": "१", "content_sanskrit": "उक्तं त्वया बुद्धिमता यन्नान्यो वक्तुमर्हति ।\nसंशयानां विनिर्मोक्ता कोऽन्यस्त्वत्तो हि नः पुमान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119853, "chapter_id": 3575, "verse_number": "२", "content_sanskrit": "गृहे गृहे हि राजानः स्वस्य स्वस्य प्रियङ्कराः ।\nनच साम्राज्यमाप्तास्ते सम्राट्शब्दो हि कृत्स्नभाक्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119854, "chapter_id": 3575, "verse_number": "३", "content_sanskrit": "कथं परानुभावाज्ञः स्वयं शंसितुमर्हति ।\nपरेण समवेतस्तु यः प्रशस्तः स पूज्यते\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119855, "chapter_id": 3575, "verse_number": "४", "content_sanskrit": "विस्तीर्णा बहुळा भूमिर्बहुरत्नसमाचिता ।\nदूरं गत्वा विजानाति श्रेयो वृष्णिकुलोद्वह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119856, "chapter_id": 3575, "verse_number": "५", "content_sanskrit": "हित्वा करान् यौवनाश्वः पालनाच्च भगीरथः ।\nकार्तवीर्यस्तपोयोगाद् बलात्तु भरतो विभुः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119857, "chapter_id": 3575, "verse_number": "६", "content_sanskrit": "ऋद्ध्या मरुत्तस्तान् पञ्च साम्राज्येनेति शुश्रुमः ।\nसर्वान् वंशाननुभृशं नैते सन्ति युगेयुगे ।\nशममेव परं मन्ये नतु वाचा भवेच्छमः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119858, "chapter_id": 3575, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119859, "chapter_id": 3575, "verse_number": "७", "content_sanskrit": "आरम्भे पारमेष्ठ्यं तु नाप्राप्यमिति मे मतिः ।\nएवमेवाभिजानन्ति कुले जाता मनस्विनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119860, "chapter_id": 3575, "verse_number": "८", "content_sanskrit": "कश्चित् कदाचिदेतेषां भवेज्ज्येष्ठो जनार्दन\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119861, "chapter_id": 3575, "verse_number": "९", "content_sanskrit": "अनारम्भपरो राजा वल्मीक इव सीदति ।\nदुर्बलश्चाप्युपायेन बलिनं योधयिष्यति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119862, "chapter_id": 3575, "verse_number": "१०", "content_sanskrit": "अतन्द्रितस्तु प्रायेण दुर्बलो बलिनं रिपुम् ।\nजयेत् सम्यङ् नयो राजन् नीत्यर्थे हि प्रवर्तते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119863, "chapter_id": 3575, "verse_number": "११", "content_sanskrit": "कृष्णे नयो मयि बलं जयः पार्थे धनञ्जये ।\nमागधं साधयिष्यामो वयं त्रय इवाग्नयः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119864, "chapter_id": 3575, "verse_number": "१२", "content_sanskrit": "त्वद्बुद्धिबलमाश्रित्य सर्वं प्राप्स्यति धर्मराट् ।\nजयोऽस्माकं हि गोविन्द येषां नाथो भवान् सदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119865, "chapter_id": 3575, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119866, "chapter_id": 3575, "verse_number": "१३", "content_sanskrit": "आत्मनोऽर्थपरो बालो नानुबन्धमवेक्षते ।\nतं विषक्तमथो घ्नन्ति बालमर्थपरायणम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119867, "chapter_id": 3575, "verse_number": "१४", "content_sanskrit": "तस्माद् वंश्याननुमृशन्नेवं नैव सतां युगे ।\nसाधयेदेव तत् कार्यं विचार्यारभते हि यः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119868, "chapter_id": 3575, "verse_number": "१५", "content_sanskrit": "सङ्ग्राह्यलक्षणं प्राप्तो धर्मार्थनयलक्षणैः ।\nबार्हद्रथं जरासन्धं तं विद्धि भरतर्षभ\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119869, "chapter_id": 3575, "verse_number": "१६", "content_sanskrit": "नचैनं प्रतियुद्ध्यन्ति कुलान्येकशतं नृपाः ।\nतस्मादेतद्बलादेव साम्राज्यं कुरुतेऽद्य सः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119870, "chapter_id": 3575, "verse_number": "१७", "content_sanskrit": "रत्नभाजो हि राजन्या जरासन्धमुपासते ।\nनच तुष्यति तेनापि बलेनानयमास्थितः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119871, "chapter_id": 3575, "verse_number": "१८", "content_sanskrit": "मूर्धाभिषिक्तं नृपतिं प्रधानं पुरुषं न च ।\nनादत्ते यो पुमान् द्रष्टा भागं पुरुषतः क्वचित्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2119872, "chapter_id": 3575, "verse_number": "१९", "content_sanskrit": "एवं सर्वानतीत्यैको जरासन्धः शतावरान् ।\nतं दुर्बलतरो राजा कथं पार्थ उपेष्यति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2119873, "chapter_id": 3575, "verse_number": "२०", "content_sanskrit": "तण्डुलप्रस्थको राजा कपर्दिनमुपासते ।\nप्रोक्षितानां प्रमृष्टानां राज्ञां पशुपतेर्गृहे ।\nपशूनामिव का प्रीतिर्जीविते भरतर्षभ\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2119874, "chapter_id": 3575, "verse_number": "२१", "content_sanskrit": "क्षत्रियः शस्त्रमरणो यदा भवति सत्कृतः ।\nननु स्म मागधं सर्वं प्रतियुध्येम तं वयम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119875, "chapter_id": 3575, "verse_number": "२२", "content_sanskrit": "षडशीतिः समानीताः शेषाश्चान्ये चतुर्दश ।\nजरासन्धेन राजानस्ततः क्रूरं प्रपत्स्यते\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119876, "chapter_id": 3575, "verse_number": "२३", "content_sanskrit": "प्राप्नुयात् स यशो दीप्तं तत्र यो विघ्नमाचरेत् ।\nजयेद् यश्च जरासन्धं स सम्राण्णियतं भवेत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119877, "chapter_id": 3575, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि सप्तदशोऽध्यायः ॥१७॥ ॥ मन्त्रपर्वणि सप्तदशोऽध्यायः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119878, "chapter_id": 3575, "verse_number": "", "content_sanskrit": "— ० —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]