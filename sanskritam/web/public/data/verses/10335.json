[{"id": 6000335000, "chapter_id": 10335, "verse_number": null, "content_sanskrit": "अथ तृतीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000335001, "chapter_id": 10335, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.001.m4a", "display_order": 2}, {"id": 6000335002, "chapter_id": 10335, "verse_number": "१२-३-१", "content_sanskrit": "दृष्ट्वाऽऽत्मनिर्जयव्यग्रान् नृपान् हसति भूरियम्।\nअहो मां विजिगीषन्ति मृत्योः क्रीडनका नृपाः॥ १२/३/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.002.m4a", "display_order": 3, "topics": [{"text": "भूम्या राज्यस्पृधां राज्ञामुपहासः", "range": "१–१४"}]}, {"id": 6000335003, "chapter_id": 10335, "verse_number": "१२-३-२", "content_sanskrit": "काम एष नरेन्द्राणां मोघः स्याद् विदुषामपि।\nयेन फेनोपमे पिण्डे येन विस्रम्भिता नृपाः॥ १२/३/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.003.m4a", "display_order": 4}, {"id": 6000335004, "chapter_id": 10335, "verse_number": "१२-३-३", "content_sanskrit": "पूर्वं निर्जित्य षड्वर्गं जेष्यामो राजमन्त्रिणः।\nततः सचिवपौराप्तकरीन्द्रानथ कण्टकान्॥ १२/३/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.004.m4a", "display_order": 5}, {"id": 6000335005, "chapter_id": 10335, "verse_number": "१२-३-४", "content_sanskrit": "एवं क्रमेण जेष्यामः पृथ्वीं सागरमेखलाम्।\nइत्याशाबद्धहृदया न पश्यन्त्यन्तिकेऽन्तकम्॥ १२/३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.005.m4a", "display_order": 6}, {"id": 6000335006, "chapter_id": 10335, "verse_number": "१२-३-५", "content_sanskrit": "समुद्रावरणां जित्वा मां विशन्त्यब्धिमोजसा।\nकियदात्मजयस्यैतन्मुक्तिरात्मजये फलम्॥ १२/३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.006.m4a", "display_order": 7}, {"id": 6000335007, "chapter_id": 10335, "verse_number": "१२-३-६", "content_sanskrit": "यां विसृज्यैव मनवस्तत्सुताश्च कुरूद्वह।\nगता यथागतं युद्धे तां मां जेष्यन्त्यबुद्धयः॥ १२/३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.007.m4a", "display_order": 8}, {"id": 6000335008, "chapter_id": 10335, "verse_number": "१२-३-७", "content_sanskrit": "मत्कृते पितृपुत्राणां भ्रातॄणां चापि विग्रहः।\nजायते ह्यसतां राज्ये ममताबद्धचेतसाम्॥ १२/३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.008.m4a", "display_order": 9}, {"id": 6000335009, "chapter_id": 10335, "verse_number": "१२-३-८", "content_sanskrit": "ममैवेयं मही कृत्स्ना न ते मूढेति वादिनः।\nस्पर्धमाना मिथो घ्नन्ति म्रियन्ते मत्कृते नृपाः॥ १२/३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.009.m4a", "display_order": 10}, {"id": 6000335010, "chapter_id": 10335, "verse_number": "१२-३-९", "content_sanskrit": "पृथुः पुरूरवा गाधिर्भरतो नहुषोऽर्जुनः।\nमान्धाता सगरो रामः खट्वाङ्गो धुन्धुहा रघुः॥ १२/३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.010.m4a", "display_order": 11}, {"id": 6000335011, "chapter_id": 10335, "verse_number": "१२-३-१०", "content_sanskrit": "तृणबिन्दुर्ययातिश्च शर्यातिः शन्तनुर्गयः।\nभगीरथः कुवलयाश्वः ककुत्स्थो नैषधो नृगः॥ १२/३/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.011.m4a", "display_order": 12}, {"id": 6000335012, "chapter_id": 10335, "verse_number": "१२-३-११", "content_sanskrit": "हिरण्यकशिपुर्वृत्रो रावणो लोकरावणः।\nनमुचिः शम्बरो भौमो हिरण्याक्षोऽथ तारकः॥ १२/३/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.012.m4a", "display_order": 13}, {"id": 6000335013, "chapter_id": 10335, "verse_number": "१२-३-१२", "content_sanskrit": "अन्ये च बहवो दैत्या राजानो ये प्रजेश्वराः।\nसर्वे सर्वविदः शूराः सर्वे सर्वजितोऽजिताः॥ १२/३/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.013.m4a", "display_order": 14}, {"id": 6000335014, "chapter_id": 10335, "verse_number": "१२-३-१३", "content_sanskrit": "ममतां मय्यमर्त्यायां कृत्वोच्चैर्मत्यधर्मिणः।\nकथावशेषाः कालेन ह्यकृतार्थाः कृता अहो॥ १२/३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.014.m4a", "display_order": 15}, {"id": 6000335015, "chapter_id": 10335, "verse_number": "१२-३-१४", "content_sanskrit": "कथा इमास्ते कथिता महीयसां विताय लोकेषु यशः परेयुषाम्।\nविज्ञानवैराग्यविवक्षया विभो वचोविभूतीर्न तु पारमार्थ्यम्॥ १२/३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.015.m4a", "display_order": 16}, {"id": 6000335016, "chapter_id": 10335, "verse_number": "१२-३-१५", "content_sanskrit": "यत्रोत्तमश्लोकगुणानुवादः सङ्गीयतेऽभीक्ष्णममङ्गलघ्नः।\nतमेव नित्यं शृणुतादभीक्ष्णं कृष्णेऽमलां भक्तिमभीप्समानः॥ १२/३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.016.m4a", "display_order": 17, "topics": [{"text": "कलिदोषनिरासकश्रीहरिगुणप्रशंसा", "range": "१५–५२"}]}, {"id": 6000335017, "chapter_id": 10335, "verse_number": null, "content_sanskrit": "राजोवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.017.m4a", "display_order": 18}, {"id": 6000335018, "chapter_id": 10335, "verse_number": "१२-३-१६", "content_sanskrit": "केनोपायेन भगवन् कलेर्दोषान् कलौ जनाः।\nविधमिष्यन्त्युपचितांस्तन्मे ब्रूहि यथा मुने॥ १२/३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.018.m4a", "display_order": 19}, {"id": 6000335019, "chapter_id": 10335, "verse_number": "१२-३-१७", "content_sanskrit": "युगानि युगमानं च मानं प्रलयकल्पयोः।\nकालस्येश्वररूपस्य गतिं विष्णोर्महात्मनः॥ १२/३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.019.m4a", "display_order": 20}, {"id": 6000335020, "chapter_id": 10335, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.020.m4a", "display_order": 21}, {"id": 6000335021, "chapter_id": 10335, "verse_number": "१२-३-१८", "content_sanskrit": "कृते प्रवर्तते धर्मश्चतुष्पात् तज्जनैर्धृतः।\nसत्यं दया तपो दानमिति पादा विभोर्नृप॥ १२/३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.021.m4a", "display_order": 22}, {"id": 6000335022, "chapter_id": 10335, "verse_number": "१२-३-१९", "content_sanskrit": "सन्तुष्टाः करुणा मैत्राः शान्ता दान्तास्तितिक्षवः।\nआत्मारामाः समदृशः प्राय आश्रमिणो जनाः॥ १२/३/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.022.m4a", "display_order": 23}, {"id": 6000335023, "chapter_id": 10335, "verse_number": "१२-३-२०", "content_sanskrit": "त्रैतायां धर्मपादानां तुर्यांशो हीयते शनैः।\nअधर्मपादैरनृतहिंसाऽसन्तोषविग्रहैः॥ १२/३/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.023.m4a", "display_order": 24}, {"id": 6000335024, "chapter_id": 10335, "verse_number": "१२-३-२१", "content_sanskrit": "तदा क्रियातपोनिष्ठा नातिहिंसा न लम्पटाः।\nत्रैवर्गिकास्त्रयीवृद्धा वर्णा ब्रह्मोत्तरा नृपाः॥ १२/३/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.024.m4a", "display_order": 25}, {"id": 6000335025, "chapter_id": 10335, "verse_number": "१२-३-२२", "content_sanskrit": "तपःसत्यदयादानेष्वर्धं ह्रसति द्वापरे।\nहिंसाऽतुष्ट्यनृतद्वैधैर्धर्मस्याधर्मलक्षणैः॥ १२/३/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.025.m4a", "display_order": 26}, {"id": 6000335026, "chapter_id": 10335, "verse_number": "१२-३-२३", "content_sanskrit": "यशस्विनो महाशालाः स्वाध्यायाध्ययने रताः।\nआढ्याः कुटुम्बिनो दृष्टा वर्णाः क्षत्रद्विजोत्तमाः॥ १२/३/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.026.m4a", "display_order": 27}, {"id": 6000335027, "chapter_id": 10335, "verse_number": "१२-३-२४", "content_sanskrit": "कलौ तु धर्महेतूनां पर्यासोऽधर्महेतुभिः।\nएधमानैः क्षीयमाणो ह्यन्ते सोऽपि विनश्यति॥ १२/३/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.027.m4a", "display_order": 28}, {"id": 6000335028, "chapter_id": 10335, "verse_number": "१२-३-२५", "content_sanskrit": "तस्मिन् लुब्धा दुराचारा निर्दयाः शुष्कवैरिणः।\nदुर्भगा भूरिदर्पाश्च शूद्रदासोत्तराः प्रजाः॥ १२/३/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.028.m4a", "display_order": 29}, {"id": 6000335029, "chapter_id": 10335, "verse_number": "१२-३-२६", "content_sanskrit": "सत्त्वं रजस्तम इति दृश्यन्ते पुरुषे गुणाः।\nकालसञ्चोदितास्ते वै परिवर्तन्त आत्मनि॥ १२/३/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.029.m4a", "display_order": 30}, {"id": 6000335030, "chapter_id": 10335, "verse_number": "१२-३-२७", "content_sanskrit": "प्रसीदति यदा सत्त्वं मनोबुद्धीन्द्रियाणि च।\nतदा कृतयुगं विद्याज्ज्ञाने तपसि यद् रुचिः॥ १२/३/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.030.m4a", "display_order": 31}, {"id": 6000335031, "chapter_id": 10335, "verse_number": "१२-३-२८", "content_sanskrit": "यदा कर्मसु कामेषु भक्तिर्यशसि देहिनाम्।\nतदा त्रेता रजोवृत्तिरिति जानीत बुद्धिमान्॥ १२/३/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.031.m4a", "display_order": 32}, {"id": 6000335032, "chapter_id": 10335, "verse_number": "१२-३-२९", "content_sanskrit": "यदा लोभस्त्वसन्तोषो मानो दम्भोऽथ मत्सरः।\nकर्मणां चापि काम्यानां द्वापरं तद् रजस्तमः॥ १२/३/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.032.m4a", "display_order": 33}, {"id": 6000335033, "chapter_id": 10335, "verse_number": "१२-३-३०", "content_sanskrit": "यदा मायाऽनृतं तन्द्री निद्रा हिंसा विषादनम्।\nशोको मोहो भयं दैन्यं स कलिस्तामसः स्मृतः॥ १२/३/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.033.m4a", "display_order": 34}, {"id": 6000335034, "chapter_id": 10335, "verse_number": "१२-३-३१", "content_sanskrit": "यस्मात् क्षुद्रदृशो मर्त्याः क्षुद्रभाग्या महाशनाः।\nकामिनो वृत्तिहीनाश्च स्वैरिण्यश्च स्त्रियोऽसतीः॥ १२/३/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.034.m4a", "display_order": 35}, {"id": 6000335035, "chapter_id": 10335, "verse_number": "१२-३-३२", "content_sanskrit": "दस्यूत्कृष्टा जनपदा वेदाः पाखण्डदूषिताः।\nराजानश्च प्रजाभक्ष्याः शिश्नोदरपरा द्विजाः॥ १२/३/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.035.m4a", "display_order": 36}, {"id": 6000335036, "chapter_id": 10335, "verse_number": "१२-३-३३", "content_sanskrit": "अव्रता वटवोऽशौचा भिक्षवश्च कुटुम्बिनः।\nतपस्विनो ग्रामवासा न्यासिनोऽत्यर्थलोलुपाः॥ १२/३/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.036.m4a", "display_order": 37}, {"id": 6000335037, "chapter_id": 10335, "verse_number": "१२-३-३४", "content_sanskrit": "ह्रस्वकाया महाहारा भूर्यपत्या गतह्रियः।\nशश्वत्कटुकभाषिण्यश्चौर्यमायोरुसाहसाः॥ १२/३/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.037.m4a", "display_order": 38}, {"id": 6000335038, "chapter_id": 10335, "verse_number": "१२-३-३५", "content_sanskrit": "पणयिष्यन्ति वै क्षुद्राः किराटान् कूटकारिणः।\nअनापद्यपि मंस्यन्ते वार्तां साधुजुगुप्सिताम्॥ १२/३/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.038.m4a", "display_order": 39}, {"id": 6000335039, "chapter_id": 10335, "verse_number": "१२-३-३६", "content_sanskrit": "पतिं त्यक्ष्यन्ति निर्द्रव्यं भूत्या अप्यखिलोत्तमम्।\nभृत्यं विपन्नं पतयः कौलं गाश्चापयस्विनीः॥ १२/३/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.039.m4a", "display_order": 40}, {"id": 6000335040, "chapter_id": 10335, "verse_number": "१२-३-३७", "content_sanskrit": "पितॄन् भ्रातॄन् स्वसॄर्ज्ञातीन् हत्वा सौरतसौहृदाः।\nश्वशुरश्यालसंवादा दीनाः स्त्रैणा कलौ नराः॥ १२/३/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.040.m4a", "display_order": 41}, {"id": 6000335041, "chapter_id": 10335, "verse_number": "१२-३-३८", "content_sanskrit": "शूद्राः प्रतिग्रहीष्यन्ति तपो वेषोपजीविनः।\nधर्मं वक्ष्यन्त्यधर्मज्ञा अधिरुह्योत्तमासनम्॥ १२/३/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.041.m4a", "display_order": 42}, {"id": 6000335042, "chapter_id": 10335, "verse_number": "१२-३-३९", "content_sanskrit": "नित्यमुद्विग्नमनसो दुर्भिक्षकरकर्शिताः।\nनिरन्ने भूतले राजन्ननावृष्टिभयातुराः॥ १२/३/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.042.m4a", "display_order": 43}, {"id": 6000335043, "chapter_id": 10335, "verse_number": "१२-३-४०", "content_sanskrit": "वासोऽन्नपानशयनव्यवायस्नानभूषणैः।\nहीनाः पिशाचसन्दर्शा भविष्यन्ति कलौ प्रजाः॥ १२/३/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.043.m4a", "display_order": 44}, {"id": 6000335044, "chapter_id": 10335, "verse_number": "१२-३-४१", "content_sanskrit": "कलौ काकणिकेऽप्यर्थे विगृह्य त्यक्तसौहृदाः।\nत्यक्ष्यन्ति हि प्रियान् प्राणान् हनिष्यन्ति स्वकानपि॥ १२/३/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.044.m4a", "display_order": 45}, {"id": 6000335045, "chapter_id": 10335, "verse_number": "१२-३-४२", "content_sanskrit": "न रक्षिष्यन्ति मनुजाः स्थविरौ पितरावपि।\nपुत्रीं भार्यां च कुलजां क्षुद्राः शिश्नोदरम्भराः॥ १२/३/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.045.m4a", "display_order": 46}, {"id": 6000335046, "chapter_id": 10335, "verse_number": "१२-३-४३", "content_sanskrit": "कलौ न राजन् जगतां परं गुरुं त्रिलोकनाथानतपादपङ्कजम्।\nप्रायेण मर्त्या भगवन्तमच्युतं यक्ष्यन्ति पाखण्डविभिन्नचेतसः॥ १२/३/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.046.m4a", "display_order": 47}, {"id": 6000335047, "chapter_id": 10335, "verse_number": "१२-३-४४", "content_sanskrit": "यन्नामधेयं म्रियमाण आतुरः पतन् स्खलन् वा विवशो गृणन् पुमान्।\nविमुक्तकर्मार्गल उत्तमां गतिं प्राप्नोति यक्ष्यन्ति न तं कलौ जनाः॥ १२/३/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.047.m4a", "display_order": 48}, {"id": 6000335048, "chapter_id": 10335, "verse_number": "१२-३-४५", "content_sanskrit": "पुंसां कलिकृतान् दोषान् द्रव्यदेशात्मसम्भवान्।\nसर्वं हरति चित्तस्थो भगवान् पुरुषोत्तमः॥ १२/३/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.048.m4a", "display_order": 49}, {"id": 6000335049, "chapter_id": 10335, "verse_number": "१२-३-४६", "content_sanskrit": "श्रुतः संकीर्तितो ध्यातः पूजितश्चादृतोऽपि वा।\nनृणां धुनोति भगवान् हृत्स्थो जन्मायुताशुभम्॥ १२/३/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.049.m4a", "display_order": 50}, {"id": 6000335050, "chapter_id": 10335, "verse_number": "१२-३-४७", "content_sanskrit": "यथा हेम्नि स्थितो वह्निर्दुर्वर्णं हन्ति धातुजम्।\nएवमात्मगतो विष्णुर्योगिनामशुभाशयम्॥ १२/३/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.050.m4a", "display_order": 51}, {"id": 6000335051, "chapter_id": 10335, "verse_number": "१२-३-४८", "content_sanskrit": "विद्यातपःप्राणनिरोधमैत्रीतीर्थाभिषेकव्रतदानजप्यैः।\nनात्यन्तशुद्धिं लभतेऽन्तरात्मा यथा हृदिस्थे भगवत्यनन्ते॥ १२/३/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.051.m4a", "display_order": 52}, {"id": 6000335052, "chapter_id": 10335, "verse_number": "१२-३-४९", "content_sanskrit": "तस्मात् सर्वात्मना राजन् हृदिस्थं कुरु केशवम्।\nम्रियमाणो ह्यवहितस्ततो यासि परां गतिम्॥ १२/३/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.052.m4a", "display_order": 53}, {"id": 6000335053, "chapter_id": 10335, "verse_number": "१२-३-५०", "content_sanskrit": "म्रियमाणैरभिध्येयो भगवान् परमेश्वरः।\nआत्मभावं नयत्यङ्ग सर्वात्मा सर्वसम्भवः॥ १२/३/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.053.m4a", "display_order": 54}, {"id": 6000335054, "chapter_id": 10335, "verse_number": "१२-३-५१", "content_sanskrit": "कलेर्दोषनिधे राजन्नस्ति ह्येको महान् गुणः।\nकीर्तनादेव कृष्णस्य मुक्तसङ्गः परं व्रजेत्॥ १२/३/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.054.m4a", "display_order": 55}, {"id": 6000335055, "chapter_id": 10335, "verse_number": "१२-३-५२", "content_sanskrit": "कृते यद् ध्यायतो विष्णुं त्रेतायां यजतो मखैः।\nद्वापरे परिचर्यायाः कलौ तद् हरिकीर्तनात्॥ १२/३/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_12/adhyaya_003/BhP_12.003.055.m4a", "display_order": 56}, {"id": 6000335056, "chapter_id": 10335, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वादशस्कन्धे तृतीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]