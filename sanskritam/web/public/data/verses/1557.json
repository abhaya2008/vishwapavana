[{"id": 2026057, "chapter_id": 1557, "verse_number": "३-१९५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026058, "chapter_id": 1557, "verse_number": "३-१९५-१", "content_sanskrit": "भूय एव ब्राह्मणमाहात्म्यं वक्तुमर्हसीत्यब्रवीत्पाण्डवेयो मार्कण्डेयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026059, "chapter_id": 1557, "verse_number": "३-१९५-२", "content_sanskrit": "अथाचष्ट मार्कण्डेयोऽपूर्वमिदं श्रूयतां ब्राह्मणानां चरितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026060, "chapter_id": 1557, "verse_number": "३-१९५-३", "content_sanskrit": "अयोध्यायामिक्ष्वाकुकुलोद्वहः पार्थिवः परीक्षिन्नाम मृगयामगमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026061, "chapter_id": 1557, "verse_number": "३-१९५-४", "content_sanskrit": "स एकोऽश्वेन मृगमन्वसरत् मृगो दूरमपाहरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026062, "chapter_id": 1557, "verse_number": "३-१९५-५", "content_sanskrit": "अध्वनि जातश्रमः क्षुत्तृष्णाभिभूतश्चैकस्मिन्देशे नीलं गहनं वनषण्डमपश्यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026063, "chapter_id": 1557, "verse_number": "३-१९५-६", "content_sanskrit": "तस्याविशेषतो वनषण्डस्य मध्येऽतीव रमणीयं सरो दृष्ट्वा साश्व एव व्यगाहत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026064, "chapter_id": 1557, "verse_number": "३-१९५-७", "content_sanskrit": "अथाश्वस्तः स बिसमृणालमश्वायाग्रतो निक्षिप्य पुष्करिणीतीरे संविवेश ततः शयानो मधुरंगीतमशृणोत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026065, "chapter_id": 1557, "verse_number": "३-१९५-८", "content_sanskrit": "स श्रुत्वाऽचिन्तयन्नेह मनुष्यगतिं पश्यामि कस्य स्वल्वयं गीतंशब्द इति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026066, "chapter_id": 1557, "verse_number": "३-१९५-९", "content_sanskrit": "अथापश्यत्कन्यां परमरूपदर्शनीयां पुष्पाण्यवचिन्वतीं गायन्तीं च अथ सा राज्ञः समीपे पर्यक्रामत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026067, "chapter_id": 1557, "verse_number": "३-१९५-१०", "content_sanskrit": "तामब्रवीद्राजा कस्यासि भद्रे का वा त्वमिति सा प्रत्युवाच कन्याऽस्मीति तां राजोवाचार्थी त्वयाऽहमिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026068, "chapter_id": 1557, "verse_number": "३-१९५-११", "content_sanskrit": "अथोवाच कन्या समयेनाहं शक्या त्वया लब्धुं नान्यथेति राजा तां समयमपृच्छत् मण्डूकराजस्य कः समय इति ततः कन्येदमुवाच नोदकं मे दर्शयितव्यमिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026069, "chapter_id": 1557, "verse_number": "३-१९५-१२", "content_sanskrit": "स राजा तां बाढमित्युक्त्वा तां समागम्य तयासह तत्र तस्थौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026070, "chapter_id": 1557, "verse_number": "३-१९५-१३", "content_sanskrit": "ततस्तत्रैवासीने राजनि सा सेनाऽन्वगच्छत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026071, "chapter_id": 1557, "verse_number": "३-१९५-१४", "content_sanskrit": "पदेनानुपदं दृष्ट्वा राजानं परिवार्यातिष्ठत अथ पर्याश्वस्तश्च राजा तयैव सह शिविकया प्रायादविषादः स्वनगरमनुप्राप्य रहसि तया रममाणो न कांश्चिदपश्यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026072, "chapter_id": 1557, "verse_number": "३-१९५-१५", "content_sanskrit": "अथ प्रधानामात्योऽभ्याशचरास्तस्य स्त्रियोऽपृच्छत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026073, "chapter_id": 1557, "verse_number": "३-१९५-१६", "content_sanskrit": "किमत्र प्रयोजनं वर्तते इत्यथाब्रुवंस्ताः स्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026074, "chapter_id": 1557, "verse_number": "३-१९५-१७", "content_sanskrit": "अपूर्वमिव पश्याम उदकं नात्र नीयत इत्यथामात्योऽनुदकं वनं कारयित्वोदारवृक्षं बहुपुष्पफलमूलं तस्य मध्ये मुक्ताजालमयीं पार्श्वे वापीं गूढां सुधोपलिप्तां स रहस्युपगम्य राजानमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026075, "chapter_id": 1557, "verse_number": "३-१९५-१८", "content_sanskrit": "वनमिदमुदारमनुदकं साध्वत्र सहैतया गम्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026076, "chapter_id": 1557, "verse_number": "३-१९५-१९", "content_sanskrit": "स तस्य वचनात्तयैव सह देव्या तद्वनं प्राविशत्स कदाचित्तस्मिन्कानने रम्ये तयैव स व्यवाहरदथक्षुत्तृष्णार्दितः श्रान्तोऽतिमुक्तागारमपश्यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026077, "chapter_id": 1557, "verse_number": "३-१९५-२०", "content_sanskrit": "तत्प्रविश्यराजा सह प्रियया सुसंस्कृतां विमलां सलिलपूर्णां वापीमपश्त् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026078, "chapter_id": 1557, "verse_number": "३-१९५-२१", "content_sanskrit": "दृष्ट्वैव च तां तस्याश्च तीरे सहैव तया देव्याऽवातिष्ठत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026079, "chapter_id": 1557, "verse_number": "३-१९५-२२", "content_sanskrit": "अथ ता देवीं स राजाऽब्रवीत्साध्ववतर वापीसलिलमिति सा तद्वच श्रुत्वाऽवतीर्य वापीं न्यमज्जन्न पुनरुदकादुदमज्जत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026080, "chapter_id": 1557, "verse_number": "३-१९५-२३", "content_sanskrit": "तां स मृगयमाणो राजा नापश्यद्वापीमथ निःस्राव्य मण्डूकं श्वभ्रमुखे दृष्ट्वा क्रुद्ध आज्ञापयामास स राजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026081, "chapter_id": 1557, "verse_number": "३-१९५-२४", "content_sanskrit": "सर्वमण्डूकवधः क्रियतामिति योमयाऽर्थी स मां मृतमण्डूकोपायनमादायोपतिष्ठेदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026082, "chapter_id": 1557, "verse_number": "३-१९५-२५", "content_sanskrit": "अथ मण्डूकवधे घोरे क्रियमाणे दिक्षु सर्वासु रमण्डूकान्भयमाविवेश ते भीता मण्डूकराज्ञे यथावृत्तं न्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026083, "chapter_id": 1557, "verse_number": "३-१९५-२६", "content_sanskrit": "ततो मण्डूकराट् तापसवेषधारी राजानमभ्यगच्छदुपेत्य चैनमुवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2026084, "chapter_id": 1557, "verse_number": "३-१९५-२७", "content_sanskrit": "मा राजन्क्रोधवशं गमः प्रसादं कुरु नार्हसि मण्डूकानामनपराधिनां वधं कर्तुमिति श्लोकौ चात्र भवतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2026085, "chapter_id": 1557, "verse_number": "३-१९५-२८", "content_sanskrit": "मा मण्डूकाञ्जिघांसीस्त्वं कोपं संधारयाच्युत। प्रक्षिपन्ति वधाद्भेका जनानां परिजानताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2026086, "chapter_id": 1557, "verse_number": "३-१९५-२९", "content_sanskrit": "प्रतिजानीहि नैतांस्त्वं प्राप्य क्रोधं विमोक्ष्यसे। अलं कृत्वा तवाधर्मं मण्डूकैः किं हतैर्हि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2026087, "chapter_id": 1557, "verse_number": "३-१९५-३०", "content_sanskrit": "तमेवंवादिनमिष्टजनवियोगशोकपरीतात्मा राजाऽथोवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2026088, "chapter_id": 1557, "verse_number": "३-१९५-३१", "content_sanskrit": "न हि क्षम्यते तन्मया हनिष्याम्येतानेतैर्दुरात्मभिः प्रिया मे भक्षिता सर्वथैव मे वध्या मण्डूका नार्हसि विद्वन्मामुपरोद्धुमिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2026089, "chapter_id": 1557, "verse_number": "३-१९५-३२", "content_sanskrit": "स तद्वाक्यमुपलभ्यव्यथितेन्द्रियमनाः प्रोवाच प्रसीद राजन्नहमायुर्नाम मण्डूकराजो मम सा दुहिता सुशोभना नाम तस्या हि दौःशील्यमेतद्बहवस्तया राजानो विप्रलब्धपूर्वा इति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2026090, "chapter_id": 1557, "verse_number": "३-१९५-३३", "content_sanskrit": "तमब्रवीद्राजा या सा तव रदुहिता तया समर्थी सा मे दीयतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2026091, "chapter_id": 1557, "verse_number": "३-१९५-३४", "content_sanskrit": "अथैनां राज्ञे पिताऽदादब्रवीच्चैनामेनं राजानं शुश्रूषस्वेति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2026092, "chapter_id": 1557, "verse_number": "३-१९५-३५", "content_sanskrit": "स एवमुक्त्वा दुहितरं क्रुद्धः शशाप यस्मात्त्वया राजानो विप्रलब्धा बहवस्तस्मादब्रह्मण्यानि तवापत्यानि भविष्यन्त्यानृतिकत्वात्तवेति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2026093, "chapter_id": 1557, "verse_number": "३-१९५-३६", "content_sanskrit": "स च राजा तामुपलभ्य तस्यां सुरतगुणनिबद्धहृदयो लोकत्रयैश्वर्यमिवोपलभ्य हर्षबाष्पसन्दिग्धया वाचा प्रणिपत्याभिपूज्य मण्डूकराजमब्रवीदनुगृहीतोस्मीति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2026094, "chapter_id": 1557, "verse_number": "३-१९५-३७", "content_sanskrit": "स च मण्डूकराजो दुहितरमनुज्ञाप्य यथागतमगच्छत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2026095, "chapter_id": 1557, "verse_number": "३-१९५-३८", "content_sanskrit": "अथ कस्यचित्कालस्य तस्यां कुमारास्त्रयस्तस्य राज्ञः संबभूवुः शलो दलो बलश्चेति ततस्तेषां ज्येष्ठं शलं समये पिता राज्येऽभिषिच्य तपसि धृतात्मा वनं जगाम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2026096, "chapter_id": 1557, "verse_number": "३-१९५-३९", "content_sanskrit": "अथ कदाचिच्छलो मृगयामनुचरन्मृगमासाद्य रथेनान्वधावत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2026097, "chapter_id": 1557, "verse_number": "३-१९५-४०", "content_sanskrit": "सूतं चोवाच शीघ्रं मां वाहयस्वेति स तथोक्त सूतो राजानमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2026098, "chapter_id": 1557, "verse_number": "३-१९५-४१", "content_sanskrit": "न क्रियतामनुबन्धो नैष शक्यस्त्वया मृगोऽयं ग्रहीतुं यद्यपि ते रथे युक्तौ वाम्यौ स्यातामिति ततोऽब्रवीद्राजा सूतमाचक्ष्व मे वाभ्यौ वाजिनौ त्वा पृच्छामीति ॥ स एवमुक्तो राजभयभीतः सूतो वामदेवशापभयभीतश्चास्योपाचख्यौ ॥ वामदेवस्याश्वौ वाम्यौ मनोजवाविति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2026099, "chapter_id": 1557, "verse_number": "३-१९५-४२", "content_sanskrit": "अथैनमेवं ब्रुवाणमब्रवीद्राजा वामदेवाश्रमं प्रयादहीति स गत्वा वामदेवाश्रमं तमृषिमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2026100, "chapter_id": 1557, "verse_number": "३-१९५-४३", "content_sanskrit": "भगवन्मृगो मे विद्धः पलायते संभावयितुमर्हसि वाम्यौ दातुमिति तमब्रवीदृषिर्ददानि ते वाम्यौ कृतकार्येण भवता ममैव वाम्यौ निर्यातयितव्यौ क्षिप्रमिति स च तावश्वौ प्रतिगृह्यानुज्ञाप्य ऋषिं प्रायाद्वाजियुक्तेन रथेन मृगं प्रति गच्छंश्चाब्रवीत्सूतमश्वरत्नद्वयमावयोर्योग्यं नैतौ प्रतिदेयौ वामदेवायेत्युक्त्वा मृगमवाप्य स्वनगरमेत्याश्वावन्तःपुरेऽस्थापयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2026101, "chapter_id": 1557, "verse_number": "३-१९५-४४", "content_sanskrit": "अथर्षिश्चिन्तयामास तरुणो राजपुत्रः कल्याणं पत्रमासाद्य रमते न मे वाम्यौ प्रतिनिर्यातयत्यहो कष्टमिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2026102, "chapter_id": 1557, "verse_number": "३-१९५-४५", "content_sanskrit": "स मनसा विचिन्त्य मासि पूर्णे शिष्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2026103, "chapter_id": 1557, "verse_number": "३-१९५-४६", "content_sanskrit": "गच्छात्रेय राजानं ब्रूहि यदि पर्याप्तं निर्यातयोगाध्यायवाम्याविति स गत्वैवं तं राजानमब्रवीत्तराजा प्रत्युवाच राज्ञामेतद्वाहनमनर्हा ब्राह्मणा रत्नानामेवंविधानां न किंचित् ब्राह्मणानामश्वैः कार्यं साधु गम्यतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2026104, "chapter_id": 1557, "verse_number": "३-१९५-४७", "content_sanskrit": "स गत्वैतदुपाध्यायायाचष्ट तच्छ्रुत्वा वचनमप्रियं वामदेवः क्रोधपरीतात्मा स्वयमेव राजानमभिगम्याश्वार्थमचोदयन्न चाददद्राजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2026105, "chapter_id": 1557, "verse_number": "३-१९५-४८x", "content_sanskrit": "वामदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2026106, "chapter_id": 1557, "verse_number": "३-१९५-४८", "content_sanskrit": "प्रपच्छ वाम्यौ मम पार्थिव त्वं\nकृतं हि ते कार्यमाभ्यामशक्यम्।\nमा त्वा वधीद्वरुणो घोरपाशै-\nर्ब्रह्मक्षत्रस्यान्तरे वर्तमानः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2026107, "chapter_id": 1557, "verse_number": "३-१९५-४९x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2026108, "chapter_id": 1557, "verse_number": "३-१९५-४९", "content_sanskrit": "अनड्वाहौ सुव्रतौ साधु दान्ता-\nवेतद्विप्राणां वाहनं वामदेव।\nताभ्यां याहि त्वं यत्र कामो महर्षे-\nच्छन्दांसि वै त्वादृशं संवहन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2026109, "chapter_id": 1557, "verse_number": "३-१९५-५०x", "content_sanskrit": "वामदवे उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2026110, "chapter_id": 1557, "verse_number": "३-१९५-५०", "content_sanskrit": "छन्दांसि वै मादृशं संवहन्ति\nलोकेऽमुष्मिन्पार्थिव यानि सन्ति।\nअस्मिस्तु लोके मम यानमेत-\nदस्मद्विधानामपरेषां च राजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2026111, "chapter_id": 1557, "verse_number": "३-१९५-५१x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2026112, "chapter_id": 1557, "verse_number": "३-१९५-५१", "content_sanskrit": "चत्वारस्त्वां वा गर्दभाः संवहन्तु\nश्रेष्ठाश्वतर्यो हरयो वातरंहाः।\nतैस्त्वं याहि रक्षत्रियस्यैष वाहो\nममैव वाम्यौ न तवैतौ हि विद्धि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2026113, "chapter_id": 1557, "verse_number": "३-१९५-५२x", "content_sanskrit": "वामदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2026114, "chapter_id": 1557, "verse_number": "३-१९५-५२", "content_sanskrit": "घोरं व्रतं ब्राह्मणस्यैतदाहु-\nरेतद्राजन्यदिहाजीवमानः।\nअयस्मया घोररूपा महान्त-\nश्चत्वारो वा यातुधानाः सुरौद्राः।\nमया प्रयुक्तास्त्वद्वधमीप्समाना\nवहन्तु त्वां शितशूलाश्चतुर्धा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2026115, "chapter_id": 1557, "verse_number": "३-१९५-५३x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2026116, "chapter_id": 1557, "verse_number": "३-१९५-५३", "content_sanskrit": "ये त्वां विदुर्ब्राह्मणं वामदेव\nवाचा हन्तुं मनसा कर्मणा वा।\nते त्वां सशिष्यमिह पातयन्तु\nमद्वाक्यनुन्नाः शितशूलासिहस्ताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2026117, "chapter_id": 1557, "verse_number": "३-१९५-५४x", "content_sanskrit": "[वामदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2026118, "chapter_id": 1557, "verse_number": "३-१९५-५४", "content_sanskrit": "ममैतौ वाम्यौ प्रतिगृह्य राजन्\nपुनर्ददानीति प्रपद्य मे त्वम्।\nप्रयच्छ शीघ्रं मम वाम्यौ त्वमश्वौ\nयद्यात्मानं जीवितुं ते क्षमं स्यात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2026119, "chapter_id": 1557, "verse_number": "३-१९५-५५x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2026120, "chapter_id": 1557, "verse_number": "३-१९५-५५", "content_sanskrit": "न ब्राह्मणेभ्यो मृगया प्रसूता\nन त्वाऽनुशास्म्यद्यप्रभृति ह्यसत्यम्।\nतवैवाज्ञां संप्रणिधाय सर्वां\nतथा ब्रह्मन्पुण्यलोकं लभेयम् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2026121, "chapter_id": 1557, "verse_number": "३-१९५-५६x", "content_sanskrit": "वामदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2026122, "chapter_id": 1557, "verse_number": "३-१९५-५६", "content_sanskrit": "नानुयोगा ब्राह्मणानां भवन्ति\nवाचा राजन्मनसा कर्मणा वा।\nयस्त्वेवं ब्रह्म तपसाऽन्वेति विद्वां-\nस्तेन श्रेष्ठो भवति हि जीवमानः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2026123, "chapter_id": 1557, "verse_number": "३-१९५-५७x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2026124, "chapter_id": 1557, "verse_number": "३-१९५-५७", "content_sanskrit": "एवमुक्ते वामदेवेन राजन्\nसमुत्तस्थू राक्षसा घोररूपाः।\nतैः शूलहस्तैर्वध्यमानः स राजा\nप्रोवाचेदं वाक्यमुच्चैस्तदानीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2026125, "chapter_id": 1557, "verse_number": "३-१९५-५८", "content_sanskrit": "इक्ष्वाकवो वा यदि मां त्यजेयु-\nर्ये ते विधेया भुवि चान्ये महीपाः।\nनोत्स्रक्ष्येऽहं वामदेवस् वाम्यौ\nनैवंविधा धर्मशीला भवन्ति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2026126, "chapter_id": 1557, "verse_number": "३-१९५-५९", "content_sanskrit": "एवं ब्रुवन्नेव स यातुधानै-\nर्हतो जगामाशु महीं क्षितीशः।\nततो विदित्वा नृपतिं निपातित-\nमिक्ष्वाकवो वै दलमभ्यषिञ्चन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2026127, "chapter_id": 1557, "verse_number": "३-१९५-६०", "content_sanskrit": "राज्ये तदा तत्र गत्वा स विप्रः\nप्रोवाचेदं वचनं वामदेवः।\nदलं राजानं ब्राह्मणानां हि देय-\nमेवं राजन्सर्वधर्मेषु दृष्टम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2026128, "chapter_id": 1557, "verse_number": "३-१९५-६१", "content_sanskrit": "बिभेषि चेत्त्वमधर्मान्नरेन्द्र\nप्रयच्छ मे शीघ्रमेवाद्य वाम्यौ।\nएतच्छ्रुत्वा वामदेवस् वाक्यं\nस पार्थिवः सूतमुवाच रोषात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2026129, "chapter_id": 1557, "verse_number": "३-१९५-६२", "content_sanskrit": "एकं हि मे सायकं चित्ररूपं\nदुग्धं विषेणाहरसंगृहीतम्।\nयेन विद्धो वामदेवः शयीत\nसंदश्यमानः श्वभिरार्तरूपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2026130, "chapter_id": 1557, "verse_number": "३-१९५-६३x", "content_sanskrit": "वामदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2026131, "chapter_id": 1557, "verse_number": "३-१९५-६३", "content_sanskrit": "जानामि पुत्रं दशवर्षं तवाहं\nजातं महिष्यां श्येनजितं नरेन्द्र।\nएतं जहि त्वं मद्वचनात्प्रणुन्न-\nस्तूर्णं प्रियं सायकैर्घोररूपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2026132, "chapter_id": 1557, "verse_number": "३-१९५-६४x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2026133, "chapter_id": 1557, "verse_number": "३-१९५-६४", "content_sanskrit": "एवमुक्तो वामदेवेन राजन्न-\nन्तःपुरे राजपुत्रं जघान।\nस सायकस्तिग्मतेजा विसृष्टः\nश्रुत्वा दलस्तत्र वाक्यं बभाषे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2026134, "chapter_id": 1557, "verse_number": "३-१९५-६५", "content_sanskrit": "इक्ष्वाकवो हन्त चरामि वः प्रियं\nनिहन्मीमं विप्रमद्य प्रमथ्य।\nआनीयतामपरस्तिग्मतेजाः\nपश्यध्वं मे वीर्यमद्य क्षितीशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2026135, "chapter_id": 1557, "verse_number": "३-१९५-६६x", "content_sanskrit": "वामदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2026136, "chapter_id": 1557, "verse_number": "३-१९५-६६", "content_sanskrit": "यत्त्वमेनं सायकं घोररूपं\nविषेण दिग्धं मम संदधासि।\nन त्वेतं त्वं शरवर्षं विमोक्तुं\nसंधातुं वा शक्ष्यसे मानवेन्द्र ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2026137, "chapter_id": 1557, "verse_number": "३-१९५-६७x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2026138, "chapter_id": 1557, "verse_number": "३-१९५-६७", "content_sanskrit": "इक्ष्वाकवः पश्त मां गृहीतं\nन वै शक्नोम्येष शरं विमोक्तुम्\nन चास्य कर्तुं नाशमभ्युत्सहामि\nआयुष्मान्वै जीवतु वामदेवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2026139, "chapter_id": 1557, "verse_number": "३-१९५-६८x", "content_sanskrit": "वैमदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2026140, "chapter_id": 1557, "verse_number": "३-१९५-६८", "content_sanskrit": "संस्पृश्यैनां महीषीं सायकेन\nततस्तस्मादेनसो मोक्ष्यसे त्वम्।\nततस्तथा कृतवान्पार्थिवस्तु\nततो मुनिं राजपुत्री बभाषे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2026141, "chapter_id": 1557, "verse_number": "३-१९५-६९", "content_sanskrit": "यथा युक्ता वामदेवाहमेनं\nदिनेदिने संदिशन्ती नृशंसम्।\nब्राह्मणेभ्यो मृगयती सूनृतानि\nतथा ब्रह्मन्पुण्यलोकं लभेयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2026142, "chapter_id": 1557, "verse_number": "३-१९५-७०x", "content_sanskrit": "वामदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2026143, "chapter_id": 1557, "verse_number": "३-१९५-७०", "content_sanskrit": "त्वया त्रातं राजकुलं शुभेक्षणे\nवरं वृणीष्वाप्रतिमं ददानि ते।\nप्रशाधीमं स्वजनं राजपुत्रि\nइक्ष्वाकुराज्यं सुमहच्चाप्यनिन्द्ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2026144, "chapter_id": 1557, "verse_number": "३-१९५-७१x", "content_sanskrit": "राजपुत्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2026145, "chapter_id": 1557, "verse_number": "३-१९५-७१", "content_sanskrit": "वरं वृणे भगवंस्त्वेवमेष\nविमुच्यतां किल्विषादद्य भर्ता।\nशिवेन जीवामि सपुत्रबान्धवं\nवरो वृतो ह्येष मया द्विजाग्र्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2026146, "chapter_id": 1557, "verse_number": "३-१९५-७२x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2026147, "chapter_id": 1557, "verse_number": "३-१९५-७२", "content_sanskrit": "श्रुत्वा वच स मुनी राजपुत्र्या-\nस्तथाऽस्त्विति प्राह कुरुप्रवीर।\nततः स राजा मुदितो बभूव\nवाम्यौ चास्मै प्रददौ संप्रणम्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2026148, "chapter_id": 1557, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि पञ्चनवत्यधिकशततमोऽध्यायः ॥ १९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]