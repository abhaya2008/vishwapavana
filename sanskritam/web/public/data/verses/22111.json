[{"id": 7002111000, "chapter_id": 22111, "verse_number": "१५६-१", "content_sanskrit": "द्रव्यशुद्धिः ।\nपुष्कर उवाच ।\nद्रव्यशुद्धिं प्रवक्ष्यामि पुनःपाकेन मृण्मयं ।\nशुद्ध्येन्मूत्रपुरीषाद्यैः स्पृष्टाम्रं सुवर्णकं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002111001, "chapter_id": 22111, "verse_number": "१५६-२", "content_sanskrit": "आवर्तितञ्चान्यथा तु वारिणाम्ल्लेन ताम्रकं ।\nक्षारेण कांस्यलोहानां मुक्तादेः क्षालनेन तु ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002111002, "chapter_id": 22111, "verse_number": "१५६-३", "content_sanskrit": "अब्जानां चैव भाण्डानां सर्वस्याश्ममयस्य च ।\nशाकरज्जुमूलफलवैदलानां तथैव च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002111003, "chapter_id": 22111, "verse_number": "१५६-४", "content_sanskrit": "मार्जनाद्यज्ञपात्राणां पाणिना यज्ञकर्मणि ।\nउष्णाम्बुना सस्नेहानां शुद्धिः सम्मार्जनाद्गृहे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002111004, "chapter_id": 22111, "verse_number": "१५६-५", "content_sanskrit": "शोधनान्म्रक्षणाद्वस्त्रे मृत्तिकाद्भिर्विशोधनं ।\nबहुवस्त्रे प्रोक्षणाच्च दारवाणाञ्च तक्षणात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002111005, "chapter_id": 22111, "verse_number": "१५६-६", "content_sanskrit": "प्रोक्षणात्संहतानान्तु द्रवाणाञ्च तथोत्प्लवात् ।\nशयनासनयानानां शूर्पस्य शकटस्य च ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002111006, "chapter_id": 22111, "verse_number": "१५६-७", "content_sanskrit": "शुद्धिः सम्प्रोक्षणाज्ज्ञेया पलालेन्धनयोस्तथा ।\nशुद्धार्थकानाङ्कल्केन शृङ्गदन्तमयस्य च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002111007, "chapter_id": 22111, "verse_number": "१५६-८", "content_sanskrit": "गोबालैः पलपात्राणामस्थ्नां स्याच्छृङ्गवत्तथा ।\nनिर्यासानां गुडानाञ्च लवणानां च शोषणात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002111008, "chapter_id": 22111, "verse_number": "१५६-९", "content_sanskrit": "कुशुम्भकुसुमानाञ्च ऊर्णाकार्पासयोस्तथा ।\nशुद्धन्नदीगतं तोयं पुण्यन्तद्वत्प्रसारितं ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002111009, "chapter_id": 22111, "verse_number": "१५६-१०", "content_sanskrit": "मुखवर्जञ्च गौः शुद्धा शुद्धमश्वाजयोर्मुखं ।\nनारीणाञ्चैव वत्सानां शकुनीनां शुनो मुखं ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002111010, "chapter_id": 22111, "verse_number": "१५६-११", "content_sanskrit": "मुखैः प्रस्रवणे वृत्ते मृगयायां सदा शुचि ।\nभुक्त्वा क्षुत्वा तथा सुप्त्वा पीत्वा चाम्भो विगाह्य च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002111011, "chapter_id": 22111, "verse_number": "१५६-१२", "content_sanskrit": "रथ्यामाक्रम्य चाचामेद्वासो विपरिधाय च ।\nमार्जारश्चङ्क्रमाच्छुद्धश्चतुर्य्थेऽह्नि रजस्वला ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002111012, "chapter_id": 22111, "verse_number": "१५६-१३", "content_sanskrit": "स्नाता स्त्री पञ्चमे योग्या दैवे पित्र्ये च कर्मणि ।\nपञ्चापाने दशैकस्मिन्नुभयोः सप्त मृत्तिकाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002111013, "chapter_id": 22111, "verse_number": "१५६-१४", "content_sanskrit": "एकां लिङ्गे मृदं दद्यात्करयोस्त्रिद्विमृत्तिकाः ।\nब्रह्मचारिवनस्थानां यतीनाञ्च चतुर्गुणं ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002111014, "chapter_id": 22111, "verse_number": "१५६-१५", "content_sanskrit": "श्रीफलैरंशुपट्टानां क्षौमाणाङ्गौरसर्षपैः ।\nशुद्धिः पर्युक्ष्य तोयेन मृगलोम्नां प्रकीर्तिता ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]