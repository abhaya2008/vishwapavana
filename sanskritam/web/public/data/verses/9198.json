[{"id": 40014450, "chapter_id": 9198, "verse_number": "1", "content_sanskrit": "ततःप्रत्युषसिप्राप्तेप्राप्तधर्मार्थनिश्चयः । राक्षसाधिपतेर्वेश्मभीमकर्माविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014451, "chapter_id": 9198, "verse_number": "2", "content_sanskrit": "शैलाग्रचयसङ्काशंशैलशृङ्गमिवोन्नतम् । सुविभक्तमहाकक्षंमहाजनपरिग्रहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014452, "chapter_id": 9198, "verse_number": "3", "content_sanskrit": "मतिमद्भिर्महामात्रैरनुरक्तैरधिष्ठितम् । राक्षसैराप्तपर्याप्तैस्सर्वतःपरिरक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014453, "chapter_id": 9198, "verse_number": "4", "content_sanskrit": "मत्तमातङ्गनिश्श्वासैर्व्याकुलीकृतमारुतम् । शङ्खघोषमहाघोषंतूर्यनादानुनादितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014454, "chapter_id": 9198, "verse_number": "5", "content_sanskrit": "प्रमदाजनसम्बाधंप्रजल्पितमहापथम् । तप्तकाञ्चननिर्यूहंभूषणोत्तमभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014455, "chapter_id": 9198, "verse_number": "6", "content_sanskrit": "गन्धर्वाणामिवाऽवासमालयंमरुतामिव । रत्नसञ्चयसम्बाधंभवनंभोगिनामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014456, "chapter_id": 9198, "verse_number": "7", "content_sanskrit": "तंमहाभ्रमिवाऽदित्यस्तेजोविस्तृतरश्मिमान् । अग्रजस्यालयंवीरःप्रविवेशमहाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014457, "chapter_id": 9198, "verse_number": "8", "content_sanskrit": "पुण्यान्पुण्याहघोषांश्चवेदविद्भिरुदाहृतान् । शुश्रावसुमहातेजाभ्रातुर्विजयसंश्रितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014458, "chapter_id": 9198, "verse_number": "9", "content_sanskrit": "पूजितान् दधिपात्रैश्चसर्पिर्भिस्सुमनोक्षतैः । मन्त्रवेदविदोविप्रान्ददर्शसमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014459, "chapter_id": 9198, "verse_number": "10", "content_sanskrit": "सपूज्यमानोरक्षोभिद्दीप्यमानस्स्वतेजसा । आसनस्थंमहाबाहुर्ववन्देधनदानुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014460, "chapter_id": 9198, "verse_number": "11", "content_sanskrit": "सराजदृष्टिसम्पन्नमासनंहेमभूषितम् । जगामसमुदाचारंप्रयुज्याचारकोविदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014461, "chapter_id": 9198, "verse_number": "12", "content_sanskrit": "सरावणंमहात्मानंविजनेमन्त्रिसन्निधौ । उवाचहितमत्यर्थंवचनंहेतुनिश्चितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014462, "chapter_id": 9198, "verse_number": "13", "content_sanskrit": "प्रसाद्यभ्रातरंजेष्ठंसान्त्वेनोपस्थितक्रमः । देशकालार्थसंवादिदृष्टलोकपरावरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014463, "chapter_id": 9198, "verse_number": "14", "content_sanskrit": "यदाप्रभृतिवैदेहीसम्प्रास्तेमांपुरींतव । तदाप्रभृतिदृश्यन्तेनिमित्तान्यशुभानिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014464, "chapter_id": 9198, "verse_number": "15", "content_sanskrit": "सस्फुलिङ्गस्सधूमार्चिस्सधूमकलुषोदयः । मन्त्रसङ्घहुतोऽप्यग्निर्नसम्यगभिवर्थते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014465, "chapter_id": 9198, "verse_number": "16", "content_sanskrit": "अग्निष्ठेष्वग्निशलासुतथाब्रह्मस्थालीषुच । सरीसृपाणिदृश्यन्तेहन्येषुचपिपीलिकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40014466, "chapter_id": 9198, "verse_number": "17", "content_sanskrit": "गवांसयांसिस्कन्नानिविमदावीरकुञ्जराः । दीनमश्वाःप्रहेषन्तेनचग्रासाभिनन्दिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40014467, "chapter_id": 9198, "verse_number": "18", "content_sanskrit": "खरोष्ट्राश्वतराराजभनभिन्नरोमास्स्रवन्तिच । नस्वभावेऽवतिष्ठन्तिविधानैरपिचिन्तिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40014468, "chapter_id": 9198, "verse_number": "19", "content_sanskrit": "वायसाःसङ्घशःक्रूराव्याहरन्तिसमन्ततः । समवेताश्चदृश्यन्तेविमानाग्रेषुसङ्घशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40014469, "chapter_id": 9198, "verse_number": "20", "content_sanskrit": "गृध्राश्चपरिलीयन्तेपुरीमुपरिपिण्डिताः । उपपन्नाश्चस्नध्येद्वेव्याहऱ्नत्यशिवंशिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40014470, "chapter_id": 9198, "verse_number": "21", "content_sanskrit": "क्रव्यादानांमृगाणांचपुरीद्वारेषुसङ्घशः । श्रूयन्तेविपुलाघोषास्सविस्फूर्जितनिस्स्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40014471, "chapter_id": 9198, "verse_number": "22", "content_sanskrit": "तदेवंप्रस्तुतेकार्येप्रायश्चित्तमिदंक्षमम् । रोचतेयदिवैदेहीराघवायप्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40014472, "chapter_id": 9198, "verse_number": "23", "content_sanskrit": "इदंचयदिवामोहाल्लोभाद्वाव्याहृतंमया । तत्रापिचमहाराज नदोषंकर्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40014473, "chapter_id": 9198, "verse_number": "24", "content_sanskrit": "अयंहिदोषस्सर्वस्यजनस्यास्योपलक्ष्यते । रक्षसांराक्षसीनांचपुरस्यान्तःपुरस्यच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40014474, "chapter_id": 9198, "verse_number": "25", "content_sanskrit": "श्रावणेचास्यमन्त्रस्यनिवृत्तास्सर्वमन्त्रिणः । अवश्यंचमयावाच्यंयद्दृष्टमपिवाश्रुतम् ॥ सम्विधाययथान्यायंतद्भवान् कर्तुमर्हति ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40014475, "chapter_id": 9198, "verse_number": "26", "content_sanskrit": "इतिस्ममन्त्रिणांमध्येभ्राताभ्रातरमूचिवान् । रावणंराक्षसांश्रेष्ठंपथ्यमेतद्विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40014476, "chapter_id": 9198, "verse_number": "27", "content_sanskrit": "हितंमहार्थंमृदुहेतुसंहितंव्यतीतकालायतिसम्प्रतिक्षमम् । निशम्यतद्वाक्यमुपस्थितज्वरःप्रसङ्गवानुत्तरमेतदब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40014477, "chapter_id": 9198, "verse_number": "28", "content_sanskrit": "भयंनपश्यामिकुतश्चिदप्यहंनराघवःप्राप्स्यतिजातुमैथिलीम् । सुरैस्सहेन्द्रैरपिसङ्गरेकथंममाग्रतस्स्थास्यतिलक्ष्मणाग्रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40014478, "chapter_id": 9198, "verse_number": "29", "content_sanskrit": "इत्येवमुक्त्वासुरसैन्यनाशनोमहाबलस्संयतिचण्डविक्रमः । दशाननोभ्रातरमाप्तवादिनंविसर्जयामासतदाविभीषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]