[{"id": 5000198000, "chapter_id": 9198, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे द्वितीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000198001, "chapter_id": 9198, "verse_number": "३-२-१", "content_sanskrit": "कृतातिथ्योऽथ रामस्तु सूर्यस्योदयनं प्रति।\nआमन्त्र्य स मुनीन् सर्वान् वनमेवान्वगाहत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000198002, "chapter_id": 9198, "verse_number": "३-२-२", "content_sanskrit": "नानामृगगणाकीर्णमृक्षशार्दूलसेवितम्।\nध्वस्तवृक्षलतागुल्मं दुर्दर्शसलिलाशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000198003, "chapter_id": 9198, "verse_number": "३-२-३", "content_sanskrit": "निष्कूजमानशकुनिं झिल्लिकागणनादितम्।\nलक्ष्मणानुचरो रामो वनमध्यं ददर्श ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000198004, "chapter_id": 9198, "verse_number": "३-२-४", "content_sanskrit": "सीतया सह काकुत्स्थस्तस्मिन् घोरमृगायुते।\nददर्श गिरिशृङ्गाभं पुरुषादं महास्वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000198005, "chapter_id": 9198, "verse_number": "३-२-५", "content_sanskrit": "गभीराक्षं महावक्त्रं विकटं विकटोदरम्।\nबीभत्सं विषमं दीर्घं विकृतं घोरदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000198006, "chapter_id": 9198, "verse_number": "३-२-६", "content_sanskrit": "वसानं चर्म वैयाघ्रं वसार्द्रं रुधिरोक्षितम्।\nत्रासनं सर्वभूतानां व्यादितास्यमिवान्तकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000198007, "chapter_id": 9198, "verse_number": "३-२-७", "content_sanskrit": "त्रीन् सिंहांश्चतुरो व्याघ्रान् द्वौ वृकौ पृषतान् दश।\nसविषाणं वसादिग्धं गजस्य च शिरो महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000198008, "chapter_id": 9198, "verse_number": "३-२-८", "content_sanskrit": "अवसज्यायसे शूले विनदन्तं महास्वनम्।\nस रामं लक्ष्मणं चैव सीतां दृष्ट्वा च मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000198009, "chapter_id": 9198, "verse_number": "३-२-९", "content_sanskrit": "अभ्यधावत् सुसंक्रुद्धः प्रजाः काल इवान्तकः\nस कृत्वा भैरवं नादं चालयन्निव मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000198010, "chapter_id": 9198, "verse_number": "३-२-१०", "content_sanskrit": "अङ्केनादाय वैदेहीमपक्रम्य तदाब्रवीत्।\nयुवां जटाचीरधरौ सभार्यौ क्षीणजीवितौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000198011, "chapter_id": 9198, "verse_number": "३-२-११", "content_sanskrit": "प्रविष्टौ दण्डकारण्यं शरचापासिपाणिनौ।\nकथं तापसयोर्वां च वासः प्रमदया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000198012, "chapter_id": 9198, "verse_number": "३-२-१२", "content_sanskrit": "अधर्मचारिणौ पापौ कौ युवां मुनिदूषकौ।\nअहं वनमिदं दुर्गं विराधो नाम राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000198013, "chapter_id": 9198, "verse_number": "३-२-१३", "content_sanskrit": "चरामि सायुधो नित्यमृषिमांसानि भक्षयन्।\nइयं नारी वरारोहा मम भार्या भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000198014, "chapter_id": 9198, "verse_number": "३-२-१४", "content_sanskrit": "युवयोः पापयोश्चाहं पास्यामि रुधिरं मृधे।\nतस्यैवं ब्रुवतो दुष्टं विराधस्य दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000198015, "chapter_id": 9198, "verse_number": "३-२-१५", "content_sanskrit": "श्रुत्वा सगर्वितं वाक्यं सम्भ्रान्ता जनकात्मजा।\nसीता प्रवेपितोद्वेगात् प्रवाते कदली यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000198016, "chapter_id": 9198, "verse_number": "३-२-१६", "content_sanskrit": "तां दृष्ट्वा राघवः सीतां विराधाङ्कगतां शुभाम्।\nअब्रवील्लक्ष्मणं वाक्यं मुखेन परिशुष्यता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000198017, "chapter_id": 9198, "verse_number": "३-२-१७", "content_sanskrit": "पश्य सौम्य नरेन्द्रस्य जनकस्यात्मसम्भवाम्।\nमम भार्यां शुभाचारां विराधाङ्के प्रवेशिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000198018, "chapter_id": 9198, "verse_number": "३-२-१८", "content_sanskrit": "अत्यन्तसुखसंवृद्धां राजपुत्रीं यशस्विनीम्।\nयदभिप्रेतमस्मासु प्रियं वरवृतं च यत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000198019, "chapter_id": 9198, "verse_number": "३-२-१९", "content_sanskrit": "कैकेय्यास्तु सुसंवृत्तं क्षिप्रमद्यैव लक्ष्मण।\nया न तुष्यति राज्येन पुत्रार्थे दीर्घदर्शिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000198020, "chapter_id": 9198, "verse_number": "३-२-२०", "content_sanskrit": "ययाहं सर्वभूतानां प्रियः प्रस्थापितो वनम्।\nअद्येदानीं सकामा सा या माता मध्यमा मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000198021, "chapter_id": 9198, "verse_number": "३-२-२१", "content_sanskrit": "परस्पर्शात् तु वैदेह्या न दुःखतरमस्ति मे।\nपितुर्विनाशात् सौमित्रे स्वराज्य हरणात् तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000198022, "chapter_id": 9198, "verse_number": "३-२-२२", "content_sanskrit": "इति ब्रुवति काकुत्स्थे बाष्पशोकपरिप्लुतः।\nअब्रवील्लक्ष्मणः क्रुद्धो रुद्धो नाग इव श्वसन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000198023, "chapter_id": 9198, "verse_number": "३-२-२३", "content_sanskrit": "अनाथ इव भूतानां नाथस्त्वं वासवोपमः।\nमया प्रेष्येण काकुत्स्थ किमर्थं परितप्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000198024, "chapter_id": 9198, "verse_number": "३-२-२४", "content_sanskrit": "शरेण निहतस्याद्य मया क्रुद्धेन रक्षसः।\nविराधस्य गतासोर्हि मही पास्यति शोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000198025, "chapter_id": 9198, "verse_number": "३-२-२५", "content_sanskrit": "राज्यकामे मम क्रोधो भरते यो बभूव ह।\nतं विराधे विमोक्ष्यामि वज्री वज्रमिवाचले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000198026, "chapter_id": 9198, "verse_number": "३-२-२६", "content_sanskrit": "मम भुजबलवेगवेगितः\nपततु शरोऽस्य महान् महोरसि।\nव्यपनयतु तनोश्च जीवितं\nपततु ततश्च महीं विघूर्णितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000198027, "chapter_id": 9198, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे द्वितीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]