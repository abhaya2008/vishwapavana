[{"id": 7005282000, "chapter_id": 25282, "verse_number": "७-४-१७-१", "content_sanskrit": "प्रह्लाद उवाच ।\nकृत्वाऽभिषेकं तीर्थेषु यथावद्दत्त दक्षिणः ।\nपूजयेच्च ततो देवं कृष्णाख्यं पुरुषं परम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005282001, "chapter_id": 25282, "verse_number": "७-४-१७-२", "content_sanskrit": "ऋषय ऊचुः ।\nपूजाविधिं तु कृष्णस्य श्रोतुकामाः समासतः ।\nकथयाऽचरणोपेतं यथावद्दैत्यसत्तम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005282002, "chapter_id": 25282, "verse_number": "७-४-१७-३", "content_sanskrit": "द्वारपालाश्च के तत्र कः पूर्वं कश्च पृष्ठतः ।\nपुरीयं सर्वतो दैत्य तिष्ठते केन पालिता ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005282003, "chapter_id": 25282, "verse_number": "७-४-१७-४", "content_sanskrit": "आनुपूर्व्यात्समासेन पूजनीया यथाविधि ।\nकथयस्व विधिज्ञोऽसि कृष्णैकचरणप्रियः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005282004, "chapter_id": 25282, "verse_number": "७-४-१७-५", "content_sanskrit": "श्रीप्रह्लाद उवाच ।\nश्रूयतां पूजनं विप्राः श्रुतपूर्वं विधानतः ।\nकलौ कृष्णस्य विप्रेन्द्रा यथावदनुपूर्वशः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005282005, "chapter_id": 25282, "verse_number": "७-४-१७-६", "content_sanskrit": "पूर्वद्वारस्थितान्देवाञ्छुणुध्वं सुसमाहिताः ।\nजयंतः प्रथमं पूज्यः सर्वपापहरः शुभः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005282006, "chapter_id": 25282, "verse_number": "७-४-१७-७", "content_sanskrit": "स्थापितो देवराजेन पूजार्थं केशवस्य हि ।\nतस्यैवानुचरान्वक्ष्ये तान्निबोधत सत्तमाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005282007, "chapter_id": 25282, "verse_number": "७-४-१७-८", "content_sanskrit": "वज्रनाभः सुनाभश्च वज्रबाहुर्महा हनुः ।\nवज्रदंष्ट्रो वज्रधारी वज्रहा वज्रलोचनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005282008, "chapter_id": 25282, "verse_number": "७-४-१७-९", "content_sanskrit": "श्वेतमूर्धा श्वेतमाली जयन्तानुचराश्च ते ।\nएते शस्त्रोद्यतकरा रक्षन्ते तमहर्निशम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005282009, "chapter_id": 25282, "verse_number": "७-४-१७-१०", "content_sanskrit": "पूर्वद्वारे सुसंनद्धा जयन्तोद्देशकारिणः ।\nपूर्वद्वारे च रक्षार्थं नरनाथो विनायकः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005282010, "chapter_id": 25282, "verse_number": "७-४-१७-११", "content_sanskrit": "तरुणार्कश्च वै सूर्यो देव्यो वै सहमातरः ।\nईश्वरश्चापि दुर्वासा नागराजस्तु तक्षकः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005282011, "chapter_id": 25282, "verse_number": "७-४-१७-१२", "content_sanskrit": "सेनानीः कार्तिकेयश्च राक्षसश्च महाहनुः ।\nतत्र दीर्घनखोनाम दानवः सुप्रतिष्ठितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005282012, "chapter_id": 25282, "verse_number": "७-४-१७-१३", "content_sanskrit": "विश्वावसुश्च गन्धर्वो मेनका च वराप्सराः ।\nसनत्कुमारसहितो वसिष्ठो भगवानृषिः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005282013, "chapter_id": 25282, "verse_number": "७-४-१७-१४", "content_sanskrit": "एते पूज्याः पूर्वतस्तु न्यग्रोधश्च महाद्रुमः ।\nपूर्वद्वारस्थिता ह्येत आग्नेयाञ्छृणुताथ मे ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005282014, "chapter_id": 25282, "verse_number": "७-४-१७-१५", "content_sanskrit": "ज्वालामुखोऽथ रक्ताक्षः स्मशाननिलयः क्रथः ।\nमांसादो रुधिराहारः कृष्णः कृष्णजटाधरः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005282015, "chapter_id": 25282, "verse_number": "७-४-१७-१६", "content_sanskrit": "त्रासनो भञ्जनश्चैव ह्याग्न्येय्यां दिशि संस्थिताः ।\nदिशं रक्षंति संनद्धा दक्षिणां शृणुताथ मे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005282016, "chapter_id": 25282, "verse_number": "७-४-१७-१७", "content_sanskrit": "दण्डपाणिर्महानादः पाशहस्तः सुलोचनः ।\nअनिवर्त्यक्रमश्चैव तथा दुंदुभिनिस्वनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005282017, "chapter_id": 25282, "verse_number": "७-४-१७-१८", "content_sanskrit": "खरस्वनो घर्घरवाक्तथा मौनप्रियः सदा ।\nमल्लिकाक्षश्च एतेषां प्रणतो द्वारपालकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005282018, "chapter_id": 25282, "verse_number": "७-४-१७-१९", "content_sanskrit": "दक्षिणद्वाररक्षार्थं दुन्दुभिश्च विनायकः ।\nमहिषार्कश्च वै सूर्यो भूषणश्च तथेश्वरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005282019, "chapter_id": 25282, "verse_number": "७-४-१७-२०", "content_sanskrit": "चण्डिका च तथा देवी ह्यूर्द्ध्वबाहुश्च राक्षसः ।\nपद्माक्षः क्षेत्रपालश्च नागश्चाश्वतरस्तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005282020, "chapter_id": 25282, "verse_number": "७-४-१७-२१", "content_sanskrit": "चित्रांगदश्च गन्धर्व उर्वशी च वराप्सराः ।\nयो राजा सर्ववृक्षाणां शालश्चापि महाद्रुमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005282021, "chapter_id": 25282, "verse_number": "७-४-१७-२२", "content_sanskrit": "सनातन ऋषिश्रेष्ठो ह्यगस्त्यश्च महातपाः ।\nएते याम्यदिशि द्वारं रक्षन्ति सुसमाहिताः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005282022, "chapter_id": 25282, "verse_number": "७-४-१७-२३", "content_sanskrit": "गीतकृन्नर्तको नग्नः कंबली दहनप्रियः ।\nहसनो नेत्रभंगश्च भ्रूविकारो विजृंभकः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005282023, "chapter_id": 25282, "verse_number": "७-४-१७-२४", "content_sanskrit": "मुशली प्रभुरेतेषां संनद्धो वर्तते द्विजाः ।\nरक्षन्ति नैरृतीमाशां पश्चिमां शृणुतापरान् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005282024, "chapter_id": 25282, "verse_number": "७-४-१७-२५", "content_sanskrit": "स्वस्तिकः शंखमूर्द्धा च नीलवासाः शुभाननः ।\nपाशहस्तः शूलहस्त एकपादैकलोचनः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005282025, "chapter_id": 25282, "verse_number": "७-४-१७-२६", "content_sanskrit": "पश्चिमायां दिशि तथा पुष्पदन्तो विनायकः ।\nउद्धवार्कश्च वै सूर्यः शिवः सत्राजितेश्वरः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005282026, "chapter_id": 25282, "verse_number": "७-४-१७-२७", "content_sanskrit": "तुंबरुर्नामगन्धर्वो घृताची च वराप्सराः ।\nमहोदरश्च नागेन्द्रो राक्षसश्च घटोत्कचः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005282027, "chapter_id": 25282, "verse_number": "७-४-१७-२८", "content_sanskrit": "दैत्यः पञ्चजनोनाम ऋषिः कश्यप एव च ।\nदेवी कपालिनीनाम अश्वत्थस्तु महाद्रुमः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005282028, "chapter_id": 25282, "verse_number": "७-४-१७-२९", "content_sanskrit": "कपिलः क्षेत्रपालश्च प्रतीचीं पाति वै दिशम् ।\nनमस्कार्यास्तथा पूज्या वायव्यो शृणुतापरान् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005282029, "chapter_id": 25282, "verse_number": "७-४-१७-३०", "content_sanskrit": "भंजनो भैरवश्चैव कालिकोऽथ घटोदरः ।\nझंझकामर्दनः पिंगो रुरुः सर्वभुजोव्रणी ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005282030, "chapter_id": 25282, "verse_number": "७-४-१७-३१", "content_sanskrit": "सुपार्श्वः प्रभुरेतेषां संनद्धः पालयन्दिशम् ।\nउदीच्यां दिशि विप्रेन्द्राः श्यामलश्च गणाधिपः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005282031, "chapter_id": 25282, "verse_number": "७-४-१७-३२", "content_sanskrit": "मन्वन्तको विरूपाक्षो गोलकः श्वेत संप्लुतः ।\nउन्मत्तः प्रभुरेतेषामुदीच्यां पालयन्दिशम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005282032, "chapter_id": 25282, "verse_number": "७-४-१७-३३", "content_sanskrit": "मूलस्थानश्च वै सूर्य्य इन्द्रेशश्च महेश्वरः ।\nदेवी कण्ठेश्वरीनाम क्षेत्रपालश्च खञ्जनः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005282033, "chapter_id": 25282, "verse_number": "७-४-१७-३४", "content_sanskrit": "वासुकिर्नागराजश्च कूर्मपृष्ठश्च दानवः ।\nसनकश्च ऋषिश्रेष्ठो गोलको राक्षसस्तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005282034, "chapter_id": 25282, "verse_number": "७-४-१७-३५", "content_sanskrit": "नारदोनाम गन्धर्वो रंभा चैव वराप्सराः ।\nएते पूज्याः प्रयत्नेन प्लक्षोनाम महाद्रुमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005282035, "chapter_id": 25282, "verse_number": "७-४-१७-३६", "content_sanskrit": "यक्षेशः सवितानाम श्यामः पूज्यः प्रयत्नतः ।\nऐशान्यां दिशि विप्रेन्द्राः स्थिता ये तान्वदाम्यहम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005282036, "chapter_id": 25282, "verse_number": "७-४-१७-३७", "content_sanskrit": "दुर्धरो भैरवारावः किंकिणीको महाबलः ।\nकरालो विकटो मूलो बलिभुक्तो बलिप्रियः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005282037, "chapter_id": 25282, "verse_number": "७-४-१७-३८", "content_sanskrit": "एतेषां क्षेत्रपालानां सस्त्रीणां च द्विजोत्तमाः ।\nनेता प्रभु श्च स्वामी च जयन्तः पालकस्तथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005282038, "chapter_id": 25282, "verse_number": "७-४-१७-३९", "content_sanskrit": "निगृह्णात्यनुगृह्णाति रक्षिता पुरवासिनाम् ।\nजयन्तादेशमादाय ते दुष्टान्घातयन्ति च ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005282039, "chapter_id": 25282, "verse_number": "७-४-१७-४०", "content_sanskrit": "नागस्थलस्थितः स्वामी जयन्तः पालकः सदा ।\nनागराजैः परिवृतः पूजनीयः प्रयत्नतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005282040, "chapter_id": 25282, "verse_number": "७-४-१७-४१", "content_sanskrit": "मांसप्रियमुखाश्चैत ऐशानीं पांति वै दिशम् ।\nसहस्रशीर्षको देवः शेषो नागस्थलस्थितः ।\nअनन्तो वासुकिश्चैव तक्षकः पद्म एव च ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005282041, "chapter_id": 25282, "verse_number": "७-४-१७-४२", "content_sanskrit": "शंखः कंबलकश्चैव नागश्चाश्वतरस्तथा ।\nमुक्तकः कालियश्चैव जनकोऽथापराजितः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005282042, "chapter_id": 25282, "verse_number": "७-४-१७-४३", "content_sanskrit": "कर्कोटकमुखा नागास्ते च सन्ति सहस्रशः ।\nते पूज्या गंधपुष्पैश्च बलिभिर्धूपदीपकैः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005282043, "chapter_id": 25282, "verse_number": "७-४-१७-४४", "content_sanskrit": "पायसेन च मांसेन ह्यन्नाद्यैः सुरया तथा ।\nततः संपूज्य देवशं जयंतं रक्षिणां वरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005282044, "chapter_id": 25282, "verse_number": "७-४-१७-४५", "content_sanskrit": "गंध पुष्पोपहारैश्च धूपवस्त्रादिभूषणैः ।\nततो गच्छेद्द्विजश्रेष्ठाः कृष्णं देवकिनन्दनम् ।\nसंपूज्यः प्रथमं तत्र गणेशो रुक्मिसंज्ञकः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005282045, "chapter_id": 25282, "verse_number": "७-४-१७-४६", "content_sanskrit": "ऋषय ऊचुः ।\nकथं स रुक्मिदैत्येन्द्रो यो दुष्टो गणतां गतः ।\nसाक्षाद्भगवतो द्वारि प्रत्यहं पूज्यते नरः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005282046, "chapter_id": 25282, "verse_number": "७-४-१७-४७", "content_sanskrit": "श्रीप्रह्लाद उवाच ।\nकृष्णाय रुक्मिणीं दातुं यदा भीष्मक उद्यतः ।\nतद्द्वेषात्क्रोधसंयुक्तो रुक्मी चैद्यममन्यत ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005282047, "chapter_id": 25282, "verse_number": "७-४-१७-४८", "content_sanskrit": "यदा जहार भगवान्रुक्मिणीमंबिकालयात् ।\nसर्वान्विद्राव्य वै भूपाञ्जरासन्धमुखान्रणे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005282048, "chapter_id": 25282, "verse_number": "७-४-१७-४९", "content_sanskrit": "तदा रुक्मी महाबाहुर्भीष्मकस्य सुतो बली ।\nनाहत्वा विनिवर्तिष्ये तमहं यादवं रणे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005282049, "chapter_id": 25282, "verse_number": "७-४-१७-५०", "content_sanskrit": "प्रतिज्ञां सर्वभूपानां शृण्वतां कृतवान्द्विजाः ।\nएवमुक्त्वा स सन्नद्धो युद्धाय परिधावितः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005282050, "chapter_id": 25282, "verse_number": "७-४-१७-५१", "content_sanskrit": "अक्षौहिण्या दलेनैवायुद्ध्यत्कृष्णेन भो द्विजाः ।\nस युध्यमानः कृष्णेन वध्यमानो हतौजसः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005282051, "chapter_id": 25282, "verse_number": "७-४-१७-५२", "content_sanskrit": "बद्धो भगवता तत्र कृत्वा वैरूप्यमेव च ।\nरामेण बंधनान्मुक्तो मरणाय मतिं दधौ ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005282052, "chapter_id": 25282, "verse_number": "७-४-१७-५३", "content_sanskrit": "रुक्मिणी भ्रातरं दृष्ट्वा मरणे कृतनिश्चयम् ।\nउवाच कृष्णं वैदर्भी भ्रातरं ह्यानयस्व मे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005282053, "chapter_id": 25282, "verse_number": "७-४-१७-५४", "content_sanskrit": "ततस्तत्प्रियकामार्थमनुमान्य जनार्द्दनः ।\nचकार पार्षदां मध्ये प्रवरं विघ्ननाशनम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005282054, "chapter_id": 25282, "verse_number": "७-४-१७-५५", "content_sanskrit": "एतस्मात्कारणाद्विप्राः प्रथमं पूज्यते सदा ।\nगंधधूपाक्षतैर्वस्त्रैर्मोदकैस्तं प्रतर्पयेत् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005282055, "chapter_id": 25282, "verse_number": "७-४-१७-५६", "content_sanskrit": "तस्मिंस्तुष्टे जगन्नाथस्तुष्टो भवति नान्यथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]