[{"id": 2081937, "chapter_id": 2736, "verse_number": "१२-२४१-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2081938, "chapter_id": 2736, "verse_number": "१२-२४१-१", "content_sanskrit": "त्रयीं विद्यामवेक्षेत वेदेपूत्तमतां गतः।\nऋक्सामवर्णाक्षरतो यजुषोऽथर्वणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2081939, "chapter_id": 2736, "verse_number": "१२-२४१-२", "content_sanskrit": "[तिष्ठत्येतेषु भगवान्षट्सु कर्मसु संस्थितः।]\nवेदवादेषु कुशला ह्यध्यात्मकुशलाश्च ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2081940, "chapter_id": 2736, "verse_number": "१२-२४१-३", "content_sanskrit": "सत्ववन्तो महाभागाः पश्यन्ति प्रभवाप्ययौ।\nएवं धर्मेण वर्तेत क्रियाः शिष्टवदाचरेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2081941, "chapter_id": 2736, "verse_number": "१२-२४१-४", "content_sanskrit": "असंरोधेन भूतानां वृत्तिं लिप्सेत वै द्विजः।\nसद्भ्य आगतविज्ञानः शिष्टः शास्त्रविचक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2081942, "chapter_id": 2736, "verse_number": "१२-२४१-५", "content_sanskrit": "स्वधर्मेण क्रिया लोके कुर्वाणः सोऽप्यसङ्करः।\nतिष्ठते तेषु गृहवान्षट्सु कर्मसु स द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2081943, "chapter_id": 2736, "verse_number": "१२-२४१-६", "content_sanskrit": "पञ्चभिः सततं यज्ञैः श्रद्दधानो यजेत च।\nधृतिमानप्रमत्तश्च दान्तो धर्मविदात्मवान्।\nवीतहर्षमदक्रोधो ब्राह्मणो नावसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2081944, "chapter_id": 2736, "verse_number": "१२-२४१-७", "content_sanskrit": "दानमध्ययनं यज्ञस्तपो ह्रीरार्जवं दमः।\nएतैर्विवर्धते तेजः पाप्मानं चापकर्षति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2081945, "chapter_id": 2736, "verse_number": "१२-२४१-८", "content_sanskrit": "धूतपाप्मा च मेधावी लघ्वाहारो जितेन्द्रियः।\nकामक्रोधौ वशे कृत्वा निनीषेद्ब्रह्मणः पदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2081946, "chapter_id": 2736, "verse_number": "१२-२४१-९", "content_sanskrit": "अग्नींश्च ब्राह्मणांश्चार्चेद्देवताः प्रणमेत च।\nवर्जयेदुशतीं वाचं हिंसां चाधर्मसंहिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2081947, "chapter_id": 2736, "verse_number": "१२-२४१-१०", "content_sanskrit": "एषा पूर्वतरा वृत्तिर्ब्राह्मणस्य विधीयते।\nज्ञानागमेन कर्माणि कुर्वन्कर्मसु सिद्ध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2081948, "chapter_id": 2736, "verse_number": "१२-२४१-११", "content_sanskrit": "पञ्चेन्द्रियजलां घोरां लोभकूलां सुदुस्तराम्।\nमन्युपङ्कामनाधृष्यां नदीं तरति बुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2081949, "chapter_id": 2736, "verse_number": "१२-२४१-१२", "content_sanskrit": "कालमभ्युद्यतं पश्येन्नित्यमत्यन्तमोहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2081950, "chapter_id": 2736, "verse_number": "१२-२४१-१३", "content_sanskrit": "महता विधिदृष्टेन बलिनाऽप्रतिघातिना।\nस्वभावस्रोतसा वृत्तमुह्यते सततं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2081951, "chapter_id": 2736, "verse_number": "१२-२४१-१४", "content_sanskrit": "कालोदकेन महता वर्षावर्तेन संततम्।\nमासोर्मिणर्तुवेगेन पक्षोलपतृणेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2081952, "chapter_id": 2736, "verse_number": "१२-२४१-१५", "content_sanskrit": "निर्मषोन्मेषफेनेन अहोरात्रजवेन च।\nकामग्राहेण घोरेण वेदयज्ञप्लवेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2081953, "chapter_id": 2736, "verse_number": "१२-२४१-१६", "content_sanskrit": "धर्मद्वीपेन भूतानां चार्थकामरवेण च।\nऋतवाङ्भोक्षतीरेण विहिंसातरुवाहिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2081954, "chapter_id": 2736, "verse_number": "१२-२४१-१७", "content_sanskrit": "युगह्रदौघमध्येन ब्रह्मप्रायभवेन च।\nधात्रा सृष्टानि भूतानि कृष्यन्ते यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2081955, "chapter_id": 2736, "verse_number": "१२-२४१-१८", "content_sanskrit": "एतत्प्रज्ञामयैर्धीरा निस्तरन्ति मनीषिणः।\nप्लवैरप्लववन्तो हि किं करिष्यन्त्यचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2081956, "chapter_id": 2736, "verse_number": "१२-२४१-१९", "content_sanskrit": "उपपन्नं हि यत्प्राज्ञो निस्तरेन्नेतरो जनः।\nदूरतो गुणदोषौ हि प्राज्ञः सर्वत्र पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2081957, "chapter_id": 2736, "verse_number": "१२-२४१-२०", "content_sanskrit": "संशयात्तु स कामात्मा चलचित्तोऽल्पचेतनः।\nअप्राज्ञो न तरत्येनं यो ह्यास्ते न स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2081958, "chapter_id": 2736, "verse_number": "१२-२४१-२१", "content_sanskrit": "अप्लवो हि महादोषं मुह्यमानो न गच्छति।\nकामग्राहगृहीतस्य ज्ञानमप्यस्य न प्लवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2081959, "chapter_id": 2736, "verse_number": "१२-२४१-२२", "content_sanskrit": "तस्मादुन्मज्जनस्यार्थे प्रयतेत विचक्षणः।\nएतदुन्मज्जनं तस्य यदयं ब्राह्मणो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2081960, "chapter_id": 2736, "verse_number": "१२-२४१-२३", "content_sanskrit": "त्र्यवदाते कुले जातस्त्रिसंदेहस्त्रिकर्मकृत्।\nतस्मादुन्मज्जनं तिष्ठेत्प्रज्ञया निस्तरेद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2081961, "chapter_id": 2736, "verse_number": "१२-२४१-२४", "content_sanskrit": "संस्कृतस्य हि दान्तस्य नियतस्य यतात्मनः।\nप्राज्ञस्यानन्तरा सिद्धिरिह लोके परत्र च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2081962, "chapter_id": 2736, "verse_number": "१२-२४१-२५", "content_sanskrit": "वर्तेत तेषु गृहवानक्रुध्यन्ननसूयकः।\nपञ्चभिः सततं यज्ञैर्विघसाशी यजेत च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2081963, "chapter_id": 2736, "verse_number": "१२-२४१-२६", "content_sanskrit": "सतां धर्मेण वर्तेत क्रियां शिष्टवदाचरेत्।\nअसंरोधेन लोकस्य वृत्तिं लिप्सेदगर्हिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2081964, "chapter_id": 2736, "verse_number": "१२-२४१-२७", "content_sanskrit": "श्रुतविज्ञानतत्त्वज्ञः शिष्टाचारविचक्षणः।\nस्वधर्मेण क्रियावांश्च कर्मणा सोऽप्यसंकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2081965, "chapter_id": 2736, "verse_number": "१२-२४१-२८", "content_sanskrit": "क्रियावाञ्श्रद्दधानो कहि दान्तः प्रायोऽनसूयकः।\nधमार्धर्मविशेषज्ञः सर्वं तरति दुस्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2081966, "chapter_id": 2736, "verse_number": "१२-२४१-२९", "content_sanskrit": "धृतिमानप्रमत्तश्च दान्तो धर्मविदात्मवान्।\nवीतहर्षमदक्रोधो ब्राह्मणो नावसीदति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2081967, "chapter_id": 2736, "verse_number": "१२-२४१-३०", "content_sanskrit": "एषा पुरातनी वृत्तिर्ब्राह्मणस्य विधीयते।\nज्ञानवृद्ध्यैव कर्माणि कुर्वन्सर्वत्र सिध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2081968, "chapter_id": 2736, "verse_number": "१२-२४१-३१", "content_sanskrit": "अधर्मं धर्मकामो हि करोति ह्यविचक्षणः।\nधर्मं वा धर्मसंकाशं शोचन्निव करोति सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2081969, "chapter_id": 2736, "verse_number": "१२-२४१-३२", "content_sanskrit": "धर्मं करोमीति करोत्यधर्म\nमधर्मकामश्च करोति धर्मम्।\nउभे बालः कर्मणी न प्रजानम्\nसंजायते म्रियते चापि देही॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2081970, "chapter_id": 2736, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि एकचत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]