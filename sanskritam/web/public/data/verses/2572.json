[{"id": 2074424, "chapter_id": 2572, "verse_number": "१२-७७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074425, "chapter_id": 2572, "verse_number": "१२-७७-१", "content_sanskrit": "केषां प्रभवते राजा वित्तस्य भरतर्षभ।\nकया च वृत्त्या वर्तेत तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074426, "chapter_id": 2572, "verse_number": "१२-७७-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074427, "chapter_id": 2572, "verse_number": "१२-७७-२", "content_sanskrit": "अब्राह्मणानां वित्तस्य स्वामी राजेति वैदिकम्।\nब्राह्मणानां च ये केचिद्विकर्मस्था भवन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074428, "chapter_id": 2572, "verse_number": "१२-७७-३", "content_sanskrit": "विकर्मस्थाश्च नोपेक्ष्या विप्रा राज्ञा कथंचन।\nइति राज्ञां पुरावृत्तमभिजल्पन्ति साधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074429, "chapter_id": 2572, "verse_number": "१२-७७-४", "content_sanskrit": "यस्य स्म विषये राज्ञः स्तेनो भवति वै द्विजः।\nराज्ञ एवापराधं तं मन्यन्ते किल्विषं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074430, "chapter_id": 2572, "verse_number": "१२-७७-५", "content_sanskrit": "अभिशस्तमिवात्मानं मन्यन्ते तेन कर्मणा।\nतस्माद्राजर्षयः सर्वे ब्राह्मणानन्वपालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074431, "chapter_id": 2572, "verse_number": "१२-७७-६", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nगीतं केकयराजेन हियमाणेन रक्षसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074432, "chapter_id": 2572, "verse_number": "१२-७७-७", "content_sanskrit": "केकयानामधिपतिं रक्षो जग्राह दारुणम्।\nस्वाध्यायेनान्वितं राजन्नरण्ये संशितव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074433, "chapter_id": 2572, "verse_number": "१२-७७-८x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074434, "chapter_id": 2572, "verse_number": "१२-७७-८", "content_sanskrit": "न मे स्तेनो जनपदे न कदर्यो न मद्यपः।\nनानाहिताग्निर्नायज्वा मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074435, "chapter_id": 2572, "verse_number": "१२-७७-९", "content_sanskrit": "न च मे ब्राह्मणोऽविद्वान्नाव्रती नाप्यसोमपः।\nद्विजातिर्विषये मह्यं मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074436, "chapter_id": 2572, "verse_number": "१२-७७-१०", "content_sanskrit": "नानाप्तदक्षिणैर्यज्ञैर्यजन्ते विषये मम।\nनाधीते चाव्रती कश्चिन्मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074437, "chapter_id": 2572, "verse_number": "१२-७७-११", "content_sanskrit": "अध्यापयन्त्यधीयन्ते यजन्ते याजयन्ति च।\nददति प्रतिगृह्णन्ति षट्सु कर्मस्ववस्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074438, "chapter_id": 2572, "verse_number": "१२-७७-१२", "content_sanskrit": "पूजिताः संविभक्ताश्च मृदवः सत्यवादिनः।\nब्राह्मणा मे स्वकर्मस्था मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074439, "chapter_id": 2572, "verse_number": "१२-७७-१३", "content_sanskrit": "न याचन्ते प्रयच्छन्ति सत्यधर्मविशारदाः।\nनाध्यापयन्त्यधीयन्ते यजन्ते याजयन्ति न॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074440, "chapter_id": 2572, "verse_number": "१२-७७-१४", "content_sanskrit": "ब्राह्मणान्परिरक्षन्ति सङ्ग्रामेष्वपलायिनः।\nक्षत्रिया मे स्वकर्मस्था मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074441, "chapter_id": 2572, "verse_number": "१२-७७-१५", "content_sanskrit": "कृषिगोरक्षवाणिज्यमुपजीवन्त्यमायया।\nअप्रमत्ताः क्रियावन्तः सुवृत्ताः सत्यवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074442, "chapter_id": 2572, "verse_number": "१२-७७-१६", "content_sanskrit": "संविभागं दमं शौचं सौहृदं च व्यपाश्रिताः।\nमम वैश्याः स्वकर्मस्था मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074443, "chapter_id": 2572, "verse_number": "१२-७७-१७", "content_sanskrit": "त्रीन्वर्णानुपतिष्ठन्ते यथावदनसूयकाः।\nमम शूद्राः स्वकर्मस्था मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074444, "chapter_id": 2572, "verse_number": "१२-७७-१८", "content_sanskrit": "कृपणानाथवृद्धानां दुर्बलातुरयोषिताम्।\nसंविभक्ताऽस्मि सर्वेषां मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074445, "chapter_id": 2572, "verse_number": "१२-७७-१९", "content_sanskrit": "कुलानुरूपधर्माणां प्रस्थितानां यथाविधि।\nअव्युच्छेत्ताऽस्मि सर्वेषां मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074446, "chapter_id": 2572, "verse_number": "१२-७७-२०", "content_sanskrit": "तपस्विनो मे विषये पूजिताः परिपालिताः।\nसंविभक्ताश्च सत्कृत्य मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074447, "chapter_id": 2572, "verse_number": "१२-७७-२१", "content_sanskrit": "नासंविभज्य भोक्ताऽस्मि न विशामि परस्त्रियम्।\nस्वतन्त्रो जातु न क्रीडे मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074448, "chapter_id": 2572, "verse_number": "१२-७७-२२", "content_sanskrit": "नाब्रह्मचारी भिक्षावान्भिक्षुर्वा ब्रह्मचर्यवान्।\nअनृत्विजा हुतं नास्ति मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074449, "chapter_id": 2572, "verse_number": "१२-७७-२३", "content_sanskrit": "`कृतं राज्यं मया सर्वं राज्यस्थेनापि कार्यवत्।\nनाहं व्युत्क्रामितः सत्यान्मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074450, "chapter_id": 2572, "verse_number": "१२-७७-२४", "content_sanskrit": "नावजानाम्यहं वैद्यान्न वृद्धान्न तपस्विनः।\nराष्ट्रे स्वपति जागर्मि मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074451, "chapter_id": 2572, "verse_number": "१२-७७-२५", "content_sanskrit": "`शुक्लकर्मास्मि सर्वत्र न दुर्गतिभयं मम।\nधर्मचारी गृहस्थश्च मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074452, "chapter_id": 2572, "verse_number": "१२-७७-२६", "content_sanskrit": "वेदाध्ययनसंपन्नस्तपस्वी सत्यधर्मवित्।\nस्वामी सर्वस्य राष्ट्रस्य धीमान्मम पुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074453, "chapter_id": 2572, "verse_number": "१२-७७-२७", "content_sanskrit": "दानेन दिव्यानभिवाञ्छामि लोकान्\nसत्येनाथ ब्राह्मणानां च गुप्त्या।\nशुश्रूषया चापि गुरूनुपैमि\nन मे भयं विद्यते राक्षसेभ्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074454, "chapter_id": 2572, "verse_number": "१२-७७-२८", "content_sanskrit": "न मे राष्ट्रे विधवा ब्रह्मबन्धु\nर्न ब्राह्मणः कितवो नोत चोरः।\nनायाज्ययाजी न च पापकर्मा\nन मे भयं विद्यते राक्षसेभ्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074455, "chapter_id": 2572, "verse_number": "१२-७७-२९", "content_sanskrit": "न मे शस्त्रैरनिर्भिन्नं गात्रे व्द्यङ्गुलमन्तरम्।\nधर्मार्थं युध्यमानस्य मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074456, "chapter_id": 2572, "verse_number": "१२-७७-३०", "content_sanskrit": "गोब्राह्मणेभ्यो यज्ञेभ्यो नित्यं स्वस्त्ययनं मम।\nआशासते जना राष्ट्रे मा ममान्तरमाविशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074457, "chapter_id": 2572, "verse_number": "१२-७७-३१x", "content_sanskrit": "राक्षस उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074458, "chapter_id": 2572, "verse_number": "१२-७७-३१", "content_sanskrit": "`नारीणां व्यभिचाराच्च अन्यायाच्च महीक्षिताम्।\nविप्राणां कर्मदोषाच्च प्रजानां जायते भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2074459, "chapter_id": 2572, "verse_number": "१२-७७-३२", "content_sanskrit": "अवृष्टिर्मारको दोषः सततं क्षुद्भयानि च।\nविग्रहश्च सदा तस्मिन्देशे भवति दारुणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2074460, "chapter_id": 2572, "verse_number": "१२-७७-३३", "content_sanskrit": "यक्षरक्षःपिशाचेभ्यो नासुरेभ्यः कथंचन।\nभयमुत्पद्यते तत्र यत्र विप्राः सुसंयताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2074461, "chapter_id": 2572, "verse_number": "१२-७७-३४", "content_sanskrit": "गन्धर्वाप्सरसः सिद्धाः पन्नगाश्च सरीसृपाः।\nमानवान्न जिघांसन्ति यत्र नार्यः पतिव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2074462, "chapter_id": 2572, "verse_number": "१२-७७-३५", "content_sanskrit": "ब्राह्मणः क्षत्रिया वैश्या यत्र शूद्राश्च धार्मिकाः।\nनाऽनावृष्टिभयं तत्र न दुर्भिक्षं न विभ्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2074463, "chapter_id": 2572, "verse_number": "१२-७७-३६", "content_sanskrit": "धार्मिको यत्र भूपालो न तत्रास्ति पराभवः।\nउत्पाता न च दृश्यन्ते न दिव्या न च मानुषाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2074464, "chapter_id": 2572, "verse_number": "१२-७७-३७", "content_sanskrit": "यस्मात्सर्वास्ववस्थासु धर्ममेवान्ववेक्षसे।\nतस्मात्प्राप्नुहि कैकेय गृहं स्वस्ति व्रजाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2074465, "chapter_id": 2572, "verse_number": "१२-७७-३८", "content_sanskrit": "येषां गोब्राह्मणा रक्ष्याः प्रजा रक्ष्याश्च केकय।\nन रक्षोऽभ्यो भयं तेषां कुत एव तु पातकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2074466, "chapter_id": 2572, "verse_number": "१२-७७-३९", "content_sanskrit": "येषां पुरोगमा विप्रा येषां ब्रह्म परं बलम्।\nसुरक्षितास्तथा विप्रास्ते वै स्वर्गजितो नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2074467, "chapter_id": 2572, "verse_number": "१२-७७-४०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2074468, "chapter_id": 2572, "verse_number": "१२-७७-४०", "content_sanskrit": "तस्माद्द्विजातीन्रक्षेत ते हि रक्षन्ति रक्षिताः।\nआशीरेषां भवेद्राजन्राज्ञां सम्यक्प्रवर्तताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2074469, "chapter_id": 2572, "verse_number": "१२-७७-४१", "content_sanskrit": "तस्माद्राज्ञा विशेषेण विकर्मस्था द्विजातयः।\nनियम्याः संविभज्याश्च प्रजानुग्रहकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2074470, "chapter_id": 2572, "verse_number": "१२-७७-४२", "content_sanskrit": "एवं यो वर्तते राजा पौरजानपदेष्विह।\nअनुभूयेह भद्राणि प्राप्नोतीन्द्रसलोकताम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2074471, "chapter_id": 2572, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि सप्तसप्ततितमोऽध्यायः॥ ७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]