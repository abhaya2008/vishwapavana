[{"id": 40012324, "chapter_id": 9141, "verse_number": "1", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा सीता रौद्रस्य रक्षसः। आर्ता दीनस्वरा दीनं प्रत्युवाच शनैर्वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40012325, "chapter_id": 9141, "verse_number": "2", "content_sanskrit": "दुःखार्ता रुदती सीता वेपमाना तपस्विनी। चिन्तयन्ती वरारोहा पतिमेव पतिव्रता ॥ तृणमन्तरतः कृत्वा प्रत्युवाच शुचिस्मिता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40012326, "chapter_id": 9141, "verse_number": "3", "content_sanskrit": "निवर्तय मनो मत्तः स्वजने क्रियतां मनः ॥ न मां प्रार्थयितुं युक्तं सुसिद्धिमिव पापकृत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40012327, "chapter_id": 9141, "verse_number": "4", "content_sanskrit": "अकार्यं न मया कार्यमेकपत्न्या विगर्हितम् ॥ कुलं सम्प्राप्तया पुण्यं कुले महति जातया।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40012328, "chapter_id": 9141, "verse_number": "5", "content_sanskrit": "एवमुक्त्वा तु वैदेही रावणं तं यशस्विनी ॥ राक्षसं पृष्ठतः कृत्वा भूयो वचनमब्रवीत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40012329, "chapter_id": 9141, "verse_number": "6", "content_sanskrit": "नाहमौपयिकी भार्या परभार्या सती तव ॥ साधु धर्ममवेक्षस्व साधु साधुव्रतं चर।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40012330, "chapter_id": 9141, "verse_number": "7", "content_sanskrit": "यथा तव तथान्येषां दारा रक्ष्या निशाचर ॥ आत्मानमुपमां कृत्वा स्वेषु दारेषु रम्यताम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40012331, "chapter_id": 9141, "verse_number": "8", "content_sanskrit": "अतुष्टं स्वेषु दारेषु चपलं चलितेन्द्रियम् ॥ नयन्ति निकृतिप्रज्ञं परदाराः पराभवम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40012332, "chapter_id": 9141, "verse_number": "9", "content_sanskrit": "इह सन्तो न वा सन्ति सतो वा नानुवर्तसे ॥ तथाहि विपरीता ते बुद्धिराचारवर्जिता।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40012333, "chapter_id": 9141, "verse_number": "10", "content_sanskrit": "वचो मिथ्याप्रणीतात्मा पथ्यमुक्तं विचक्षणैः ॥ राक्षसानामभावाय त्वं वा न प्रतिपद्यसे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40012334, "chapter_id": 9141, "verse_number": "11", "content_sanskrit": "अकृतात्मानमासाद्य राजानमनये रतम् ॥ समृद्धानि विनश्यन्ति राष्ट्राणि नगराणि च।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40012335, "chapter_id": 9141, "verse_number": "12", "content_sanskrit": "तथेयं त्वां समासाद्य लङ्का रत्नौघसङ्कुला ॥ अपराधात्तवैकस्य नचिराद्विनशिष्यति।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40012336, "chapter_id": 9141, "verse_number": "13", "content_sanskrit": "स्वकृतैर्हन्यमानस्य रावणादीर्घदर्शिनः ॥ अभिनन्दन्ति भूतानि विनाशे पापकर्मणः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40012337, "chapter_id": 9141, "verse_number": "14", "content_sanskrit": "एवं त्वां पापकर्माणं वक्ष्यन्ति निकृता जनाः ॥ दिष्ट्यैतद्व्यसनं प्राप्तो रौद्र इत्येव हर्षिताः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40012338, "chapter_id": 9141, "verse_number": "15", "content_sanskrit": "शक्या लोभयितुं नाहमैश्वर्येण धनेन वा ॥ अनन्या राघवेणाहं भास्करेण प्रभा यथा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40012339, "chapter_id": 9141, "verse_number": "16", "content_sanskrit": "उपधाय भुजं तस्य लोकनाथस्य सत्कृतम् ॥ कथं नामोपधास्यामि भुजमन्यस्य कस्य चित्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40012340, "chapter_id": 9141, "verse_number": "17", "content_sanskrit": "अहमौपयिकी भार्या तस्यैव वसुधापतेः ॥ व्रतस्नातस्य विप्रस्य विद्येव विदितात्मनः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40012341, "chapter_id": 9141, "verse_number": "18", "content_sanskrit": "साधु रावण रामेण मां समानय दुःखिताम् ॥ वने वाशितया सार्धं करेण्वेव गजाधिपम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40012342, "chapter_id": 9141, "verse_number": "19", "content_sanskrit": "मित्रमौपयिकं कर्तुं रामः स्थानं परीप्सता ॥ वधं चानिच्छता घोरं त्वयासौ पुरुषर्षभः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40012343, "chapter_id": 9141, "verse_number": "20", "content_sanskrit": "विदितः स हि धर्मज्ञः शरणागतवत्सलः ॥ तेन मैत्री भवतु ते यदि जीवितुमिच्छसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40012344, "chapter_id": 9141, "verse_number": "21", "content_sanskrit": "प्रसादयस्व त्वं चैनं शरणागतवत्सलम् ॥ मां चास्मै नियतो भूत्वा निर्यातयितुमर्हसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40012345, "chapter_id": 9141, "verse_number": "22", "content_sanskrit": "एवं हि ते भवेत्स्वस्ति सम्प्रदाय रघूत्तमे ॥ अन्यथा त्वं हि कुर्वाणो वधं प्राप्स्यसि रावण।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40012346, "chapter_id": 9141, "verse_number": "23", "content_sanskrit": "वर्जयेद्वज्रमुत्सृष्टं वर्जयेदन्तकश्चिरम् ॥ त्वद्विधं तु न सङ्कृद्धो लोकनाथः स राघवः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40012347, "chapter_id": 9141, "verse_number": "24", "content_sanskrit": "रामस्य धनुषः शब्दं श्रोष्यसि त्वं महास्वनम् ॥ शतक्रतुविसृष्टस्य निर्घोषमशनेरिव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40012348, "chapter_id": 9141, "verse_number": "25", "content_sanskrit": "इह शीघ्रं सुपर्वाणो ज्वलितास्या इवोरगा: ॥ इषवो निपतिष्यन्ति रामलक्ष्मणलक्षणाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40012349, "chapter_id": 9141, "verse_number": "26", "content_sanskrit": "रक्षांसि परिनिघ्नन्तः पुर्यामस्यां समन्ततः ॥ असंपातं करिष्यन्ति पतन्तः कङ्कवाससः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40012350, "chapter_id": 9141, "verse_number": "27", "content_sanskrit": "राक्षसेन्द्रमहासर्पान् स रामगरुडो महान् ॥ उद्धरिष्यति वेगेन वैनतेय इवोरगान्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40012351, "chapter_id": 9141, "verse_number": "28", "content_sanskrit": "अपनेष्यति मां भर्ता त्वत्तः शीघ्रमरिन्दमः ॥ असुरेभ्यः श्रियं दीप्तां विष्णुस्त्रिभिरिव क्रमैः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40012352, "chapter_id": 9141, "verse_number": "29", "content_sanskrit": "जनस्थाने हतस्थाने निहते रक्षसां बले ॥ अशक्तेन त्वया रक्षः कृतमेतदसाधु वै।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40012353, "chapter_id": 9141, "verse_number": "30", "content_sanskrit": "आश्रमं तु तयोः शून्यं प्रविश्य नरसिंहयोः ॥ गोचरं गतयोर्भ्रात्रोरपनीता त्वयाधम।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40012354, "chapter_id": 9141, "verse_number": "31", "content_sanskrit": "न हि गन्धमुपाघ्राय रामलक्ष्मणयोस्त्वया ॥ शक्यं संदर्शने स्थातुं शुना शार्दूलयोरिव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40012355, "chapter_id": 9141, "verse_number": "32", "content_sanskrit": "तस्य ते विग्रहे ताभ्यां युगग्रहणमस्थिरम् ॥ वृत्रस्येवेन्द्रबाहुभ्यां बाहोरेकस्य विग्रहे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40012356, "chapter_id": 9141, "verse_number": "33", "content_sanskrit": "क्षिप्रं तव स नाथो मे रामः सौमित्रिणा सह ॥ तोयमल्पमिवादित्यः प्राणानादास्यते शरैः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40012357, "chapter_id": 9141, "verse_number": "34", "content_sanskrit": "गिरिं कुबेरस्य गतोऽथ वालयं सभां गतो वा वरुणस्य राज्ञः। असंशयं दाशरथेर्न मोक्ष्यसे महाद्रुमः कालहतोऽशनेरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]