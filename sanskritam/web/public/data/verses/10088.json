[{"id": 6000088000, "chapter_id": 10088, "verse_number": null, "content_sanskrit": "अथ चतुर्विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000088001, "chapter_id": 10088, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.001.m4a", "display_order": 2}, {"id": 6000088002, "chapter_id": 10088, "verse_number": "४-२४-१", "content_sanskrit": "विजिताश्वोऽथ राजाऽऽसीत् पृथुपुत्रः पृथुश्रवाः।\nयवीयेभ्योऽददात् काष्ठा भ्रातृभ्यो भ्रातृवत्सलः॥ ४/२४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.002.m4a", "display_order": 3, "topics": [{"text": "पृथुवंशोत्पन्नस्य प्राचीनबर्हिषः कथारम्भः", "range": "१–१५"}]}, {"id": 6000088003, "chapter_id": 10088, "verse_number": "४-२४-२", "content_sanskrit": "हर्यक्षायादिशत् प्राचीं धूम्रकेशाय दक्षिणाम्।\nप्रतीचीं वृकसंज्ञाय तुर्यां द्रविणसे विभुः॥ ४/२४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.003.m4a", "display_order": 4}, {"id": 6000088004, "chapter_id": 10088, "verse_number": "४-२४-३", "content_sanskrit": "अन्तर्धानगतिं शक्राल्लब्ध्वाऽन्तर्धानसंज्ञितः।\nअपत्यत्रयमाधत्त शिखण्डिन्यां सुसंमतः॥ ४/२४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.004.m4a", "display_order": 5}, {"id": 6000088005, "chapter_id": 10088, "verse_number": "४-२४-४", "content_sanskrit": "पावकः पवमानश्च शुचिरित्यग्नयः पुरा।\nवसिष्ठशापादुत्पन्नाः पुनर्योगगतिं गताः॥ ४/२४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.005.m4a", "display_order": 6}, {"id": 6000088006, "chapter_id": 10088, "verse_number": "४-२४-५", "content_sanskrit": "अन्तर्धानो नभस्वत्यां हविर्धानमविन्दत।\nय इन्द्रमश्वहर्तारं विद्वानपि न जघ्निवान्॥ ४/२४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.006.m4a", "display_order": 7}, {"id": 6000088007, "chapter_id": 10088, "verse_number": "४-२४-६", "content_sanskrit": "राज्ञां वृत्तिकरादानं दण्डशुल्कादि दारुणम्।\nमन्यमानो दीर्घसत्रव्याजेन विससर्ज ह॥ ४/२४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.007.m4a", "display_order": 8}, {"id": 6000088008, "chapter_id": 10088, "verse_number": "४-२४-७", "content_sanskrit": "तत्रापि हंसं पुरुषं परमात्मानमात्मदृक्।\nयजंस्तल्लोकतामाप परमेण समाधिना॥ ४/२४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.008.m4a", "display_order": 9}, {"id": 6000088009, "chapter_id": 10088, "verse_number": "४-२४-८", "content_sanskrit": "हविर्धानाद्धविर्धानी विदुरासूत षट् सुतान्।\nबर्हिष्मन्तं गयं शुक्लं कृष्णं सत्यं जितव्रतम्॥ ४/२४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.009.m4a", "display_order": 10}, {"id": 6000088010, "chapter_id": 10088, "verse_number": "४-२४-९", "content_sanskrit": "बर्हिष्मत् तु महाभागो हाविर्धानिः प्रजापतिः।\nक्रियाकाण्डेषु निष्णातो योगेषु च कुरूद्वह॥ ४/२४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.010.m4a", "display_order": 11}, {"id": 6000088011, "chapter_id": 10088, "verse_number": "४-२४-१०", "content_sanskrit": "यस्येदं देवयजनमनुयज्ञं वितन्वतः।\nप्राचीनाग्रैः कुशैरासीदास्तृतं वसुधातलम्॥ ४/२४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.011.m4a", "display_order": 12}, {"id": 6000088012, "chapter_id": 10088, "verse_number": "४-२४-११", "content_sanskrit": "सामुद्रीं देवदेवोक्तामुपयेमे शतद्रुतिम्।\nयां वीक्ष्य चारुसर्वाङ्गीं किशोरीं सुष्ट्वलंकृताम्॥ ४/२४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.012.m4a", "display_order": 13}, {"id": 6000088013, "chapter_id": 10088, "verse_number": "४-२४-१२", "content_sanskrit": "परिक्रमन्तीमुद्वाहे चकमेऽग्निः शुकीमिव। विबुधासुरगन्धर्वमुनिसिद्धमहोरगाः।\nविजिताः सूर्यया दिक्षुक्‍वणयन्त्यैव नूपुरैः॥ ४/२४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.013.m4a", "display_order": 14}, {"id": 6000088014, "chapter_id": 10088, "verse_number": "४-२४-१३", "content_sanskrit": "प्राचीनबर्हिषः पुत्राः शतद्रुत्यां दशाभवन्।\nतुल्यनामव्रताः सर्वे वेदस्नाताः प्रचेतसः॥ ४/२४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.014.m4a", "display_order": 15}, {"id": 6000088015, "chapter_id": 10088, "verse_number": "४-२४-१४", "content_sanskrit": "पित्राऽऽदिष्टाः प्रजासर्गे तपसेऽर्णवमाविशन्।\nदशवर्षसहस्राणि तपसाऽऽर्चंस्तपस्विनः॥ ४/२४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.015.m4a", "display_order": 16}, {"id": 6000088016, "chapter_id": 10088, "verse_number": "४-२४-१५", "content_sanskrit": "यदुक्तं पथि दृष्टेन गिरिशेन प्रसीदता।\nतद् ध्यायन्तो जपन्तश्च पूजयन्तश्च संयताः॥ ४/२४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.016.m4a", "display_order": 17}, {"id": 6000088017, "chapter_id": 10088, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.017.m4a", "display_order": 18}, {"id": 6000088018, "chapter_id": 10088, "verse_number": "४-२४-१६", "content_sanskrit": "प्रचेतसां गिरित्रेण यथाऽऽसीत् पथि सङ्गमः।\nयद्वाऽप्याह हरः प्रीतस्तन्नो ब्रह्मन् वदार्थवत्॥ ४/२४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.018.m4a", "display_order": 19, "topics": [{"text": "प्राचीनबर्हिःपुत्राणां पित्रा प्रजासर्गे आदिष्टानां प्रचेतसां शिवानुग्रहः", "range": "१६–३०"}]}, {"id": 6000088019, "chapter_id": 10088, "verse_number": "४-२४-१७", "content_sanskrit": "संगमः खलु विप्रर्षे शिवेन हि शरीरिणाम्।\nदुर्लभो मुनयो दध्युरसङ्गा यमभीप्सितम्॥ ४/२४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.019.m4a", "display_order": 20}, {"id": 6000088020, "chapter_id": 10088, "verse_number": "४-२४-१८", "content_sanskrit": "आत्मारामोऽपि यस्त्वस्य लोककल्पस्य राधसे।\nशक्त्या युक्तो विचरति तीव्रया भगवान् भवः॥ ४/२४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.020.m4a", "display_order": 21}, {"id": 6000088021, "chapter_id": 10088, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.021.m4a", "display_order": 22}, {"id": 6000088022, "chapter_id": 10088, "verse_number": "४-२४-१९", "content_sanskrit": "प्रचेतसः पितुर्वाक्यं शिरसाऽऽधाय साधवः।\nदिशं प्रतीचीं प्रययुस्तपस्यादृतचेतसः॥ ४/२४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.022.m4a", "display_order": 23}, {"id": 6000088023, "chapter_id": 10088, "verse_number": "४-२४-२०", "content_sanskrit": "समुद्रमुप विस्तीर्णमपश्यन् सुमहत् सरः।\nमहन्मन इव स्वच्छं प्रसन्नसलिलाशयम्॥ ४/२४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.023.m4a", "display_order": 24}, {"id": 6000088024, "chapter_id": 10088, "verse_number": "४-२४-२१", "content_sanskrit": "नीलरक्तोत्पलाम्भोजकह्लारेन्दीवराकरम्।\nहंससारसचक्राह्वकारण्डवनिकूजितम्॥ ४/२४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.024.m4a", "display_order": 25}, {"id": 6000088025, "chapter_id": 10088, "verse_number": "४-२४-२२", "content_sanskrit": "मत्तभ्रमरसौस्वर्यहृष्टरोमलताङ्घ्रिपम्।\nपद्मकोशरजो दिक्षु विक्षिपत्पवनोत्सवम्॥ ४/२४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.025.m4a", "display_order": 26}, {"id": 6000088026, "chapter_id": 10088, "verse_number": "४-२४-२३", "content_sanskrit": "तत्र गान्धर्वमाकर्ण्य दिव्यमार्गमनोहरम्।\nविसिस्मिरे राजपुत्रा मृदङ्गपणवाद्यनु॥ ४/२४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.026.m4a", "display_order": 27}, {"id": 6000088027, "chapter_id": 10088, "verse_number": "४-२४-२४", "content_sanskrit": "तर्ह्येव सरसस्तस्मान्निष्क्रामन्तं सहानुगम्।\nउपगीयमानममरप्रवरं विबुधानुगैः॥ ४/२४/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.027.m4a", "display_order": 28}, {"id": 6000088028, "chapter_id": 10088, "verse_number": "४-२४-२५", "content_sanskrit": "तप्तहेमनिकर्षाभं शितिकण्ठं त्रिलोचनम्।\nप्रसादसुमुखं वीक्ष्य प्रणेमुर्जातकौतुकाः॥ ४/२४/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.028.m4a", "display_order": 29}, {"id": 6000088029, "chapter_id": 10088, "verse_number": "४-२४-२६", "content_sanskrit": "स तान् प्रपन्नार्तिहरो भगवान् धर्मवत्सलः।\nधर्मज्ञान् शीलसम्पन्नान् प्रीतान् प्रीत उवाच ह॥ ४/२४/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.029.m4a", "display_order": 30}, {"id": 6000088030, "chapter_id": 10088, "verse_number": null, "content_sanskrit": "रुद्र उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.030.m4a", "display_order": 31}, {"id": 6000088031, "chapter_id": 10088, "verse_number": "४-२४-२७", "content_sanskrit": "यूयं बर्हिषदः पुत्रा विदितं वश्चिकीर्षितम्।\nअनुग्रहाय भद्रं व एवं मे दर्शनं कृतम्॥ ४/२४/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.031.m4a", "display_order": 32}, {"id": 6000088032, "chapter_id": 10088, "verse_number": "४-२४-२८", "content_sanskrit": "यः परस्तमसः साक्षात् त्रिगुणाज्जीवसंज्ञितात्।\nभगवन्तं वासुदेवं प्रपन्नः स प्रियो हि मे॥ ४/२४/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.032.m4a", "display_order": 33}, {"id": 6000088033, "chapter_id": 10088, "verse_number": "४-२४-२९", "content_sanskrit": "स्वधर्मनिष्ठः शतजन्मभिः पुमान् विरिञ्चतामेति ततः परं हि माम्।\nअव्याकृतं भागवतोऽथ वैष्णवं पदं यथाऽर्हं विविधैः कलात्यये॥ ४/२४/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.033.m4a", "display_order": 34}, {"id": 6000088034, "chapter_id": 10088, "verse_number": "४-२४-३०", "content_sanskrit": "अथ भागवता यूयं प्रियाः स्थ भगवान् यथा।\nन मे भागवतानां च प्रेयानन्योऽस्ति कर्हिचित्॥ ४/२४/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.034.m4a", "display_order": 35}, {"id": 6000088035, "chapter_id": 10088, "verse_number": "४-२४-३१", "content_sanskrit": "इदं विविक्तं जप्तव्यं पवित्रं मङ्गलं परम्।\nनिःश्रेयसकरं चापि श्रूयतां यद् वदामि वः॥ ४/२४/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.035.m4a", "display_order": 36, "topics": [{"text": "श्रीरुद्रेण भगवन्महिमोपदेशः (रुद्रगीता)", "range": "३१–८०"}]}, {"id": 6000088036, "chapter_id": 10088, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.036.m4a", "display_order": 37}, {"id": 6000088037, "chapter_id": 10088, "verse_number": "४-२४-३२", "content_sanskrit": "इत्यनुक्रोशहृदयो भगवानाह ताञ्छिवः।\nबद्धाञ्जलीन् राजपुत्रान् नारायणपरो वचः॥ ४/२४/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.037.m4a", "display_order": 38}, {"id": 6000088038, "chapter_id": 10088, "verse_number": null, "content_sanskrit": "रुद्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.038.m4a", "display_order": 39}, {"id": 6000088039, "chapter_id": 10088, "verse_number": "४-२४-३३", "content_sanskrit": "जितं व आत्मविद्धुर्याः स्वस्तये स्वस्तिरस्तु वः।\nभवतां राधसे राध्यं सर्वस्मा आत्मने नमः॥ ४/२४/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.039.m4a", "display_order": 40}, {"id": 6000088040, "chapter_id": 10088, "verse_number": "४-२४-३४", "content_sanskrit": "नमः पङ्कजनाभाय भूतसूक्ष्मेन्द्रियात्मने।\nवासुदेवाय शान्ताय कूटस्थाय स्वरोचिषे॥ ४/२४/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.040.m4a", "display_order": 41}, {"id": 6000088041, "chapter_id": 10088, "verse_number": "४-२४-३५", "content_sanskrit": "संकर्षणाय सूक्ष्माय दुरन्तायान्तकाय च।\nनमो विश्वप्रबोधाय प्रद्युम्नायान्तरात्मने॥ ४/२४/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.041.m4a", "display_order": 42}, {"id": 6000088042, "chapter_id": 10088, "verse_number": "४-२४-३६", "content_sanskrit": "नमो नमोऽनिरुद्धाय हृषीकेशेन्द्रियात्मने।\nनमः परमहंसाय पूर्णाय निभृतात्मने॥ ४/२४/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.042.m4a", "display_order": 43}, {"id": 6000088043, "chapter_id": 10088, "verse_number": "४-२४-३७", "content_sanskrit": "स्वर्गापवर्गद्वाराय नित्यं शुचिषदे नमः।\nनमो हिरण्यवीर्याय चातुर्होत्राय तन्तवे॥ ४/२४/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.043.m4a", "display_order": 44}, {"id": 6000088044, "chapter_id": 10088, "verse_number": "४-२४-३८", "content_sanskrit": "नम ऊर्ज इषे त्रय्याः पतये यज्ञरेतसे।\nतृप्तिदाय च जीवानां नमः सर्वरसात्मने॥ ४/२४/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.044.m4a", "display_order": 45}, {"id": 6000088045, "chapter_id": 10088, "verse_number": "४-२४-३९", "content_sanskrit": "सर्वसत्त्वात्मदेहाय विशेषाय स्थवीयसे।\nनमस्‍त्रैलोक्यपालाय सहओजोबलाय च॥ ४/२४/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.045.m4a", "display_order": 46}, {"id": 6000088046, "chapter_id": 10088, "verse_number": "४-२४-४०", "content_sanskrit": "अर्थलिङ्गाय नभसे नमोऽन्तर्बहिरात्मने।\nनमः पुण्याय लोकाय अमुष्मै भूरिवर्चसे॥ ४/२४/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.046.m4a", "display_order": 47}, {"id": 6000088047, "chapter_id": 10088, "verse_number": "४-२४-४१", "content_sanskrit": "प्रवृत्ताय निवृत्ताय पितृदेवाय कर्मणे।\nनमो धर्मविपाकाय मृत्यवे दुःखदाय च॥ ४/२४/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.047.m4a", "display_order": 48}, {"id": 6000088048, "chapter_id": 10088, "verse_number": "४-२४-४२", "content_sanskrit": "नमस्त आशिषामीश मनवे कारणात्मने।\nनमो धर्माय बृहते कृष्णायाकुण्ठमेधसे॥ ४/२४/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.048.m4a", "display_order": 49}, {"id": 6000088049, "chapter_id": 10088, "verse_number": "४-२४-४३", "content_sanskrit": "पुरुषाय पुराणाय साङ्ख्ययोगेश्वराय च।\nशक्तित्रयसमेताय मीढुषेऽहङ्कृतात्मने॥ ४/२४/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.049.m4a", "display_order": 50}, {"id": 6000088050, "chapter_id": 10088, "verse_number": "४-२४-४४", "content_sanskrit": "चेतआकूतिरूपाय नमो वाचोविभूतये।\nदर्शनं नो दिदृक्षूणां देहि भागवतार्चितम्॥ ४/२४/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.050.m4a", "display_order": 51}, {"id": 6000088051, "chapter_id": 10088, "verse_number": "४-२४-४५", "content_sanskrit": "रूपं प्रियतमं स्वानां सर्वेन्द्रियगुणाञ्जनम्।\nस्निग्धप्रावृड्घनश्यामं सर्वसौन्दर्यसंग्रहम्॥ ४/२४/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.051.m4a", "display_order": 52}, {"id": 6000088052, "chapter_id": 10088, "verse_number": "४-२४-४६", "content_sanskrit": "चार्वायतचतुर्बाहुं सुजातरुचिराननम्।\nपद्मकोशपलाशाक्षं सुन्दरभ्रु सुनासिकम्॥ ४/२४/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.052.m4a", "display_order": 53}, {"id": 6000088053, "chapter_id": 10088, "verse_number": "४-२४-४७", "content_sanskrit": "सुद्विजं सुकपोलास्यं समकर्णविभूषितम्।\nप्रीतिप्रहसितापाङ्गमलकैरुपशोभितम्॥ ४/२४/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.053.m4a", "display_order": 54}, {"id": 6000088054, "chapter_id": 10088, "verse_number": "४-२४-४८", "content_sanskrit": "लसत्पङ्कजकिञ्जल्कदुकूलं मृष्टकुण्डलम्।\nस्फुरत्किरीटवलयहारनूपुरमेखलम्॥ ४/२४/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.054.m4a", "display_order": 55}, {"id": 6000088055, "chapter_id": 10088, "verse_number": "४-२४-४९", "content_sanskrit": "शङ्खचक्रगदापद्ममालामण्युत्तमर्द्धिमत्।\nसिंहस्कन्धमुरो बिभ्रत् सौभगग्रीवकौस्तुभम्॥ ४/२४/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.055.m4a", "display_order": 56}, {"id": 6000088056, "chapter_id": 10088, "verse_number": "४-२४-५०", "content_sanskrit": "श्रियाऽनपायिन्याऽऽक्षिप्तनिकषाश्मोरसोल्लसत्।\nपूररेचकसंविग्नवलिमत्पल्लवोदरम्॥ ४/२४/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.056.m4a", "display_order": 57}, {"id": 6000088057, "chapter_id": 10088, "verse_number": "४-२४-५१", "content_sanskrit": "प्रतिसङ्क्रामयद् विश्वं नाभ्याऽऽवर्तगभीरया।\nश्यामश्रोण्यधिरोचिष्णुदुकूलस्वर्णमेखलम्।\nसमचार्वङ्घ्रिजङ्घोरुनिम्नजानुसुदर्शनम्॥ ४/२४/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.057.m4a", "display_order": 58}, {"id": 6000088058, "chapter_id": 10088, "verse_number": "४-२४-५२", "content_sanskrit": "पदा शरत्पद्मपलाशरोचिषा नखद्युभिर्नोतुरघं विधुन्वता।\nप्रदर्शय स्वीयमपास्तसाध्वसं पदं पुरोमार्गगुरुस्तमोजुषाम्॥ ४/२४/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.058.m4a", "display_order": 59}, {"id": 6000088059, "chapter_id": 10088, "verse_number": "४-२४-५३", "content_sanskrit": "एतद् रूपमनुध्येयमात्मशुद्धिमभीप्सताम्।\nयद्भक्तियोगोऽभयदः स्वधर्ममनुतिष्ठताम्॥ ४/२४/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.059.m4a", "display_order": 60}, {"id": 6000088060, "chapter_id": 10088, "verse_number": "४-२४-५४", "content_sanskrit": "भवान् भक्तिमतां लभ्यो दुर्लभः सर्वदेहिनाम्।\nस्वाराज्यस्याप्यभिमता एकान्तेनात्मविद्गतिः॥ ४/२४/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.060.m4a", "display_order": 61}, {"id": 6000088061, "chapter_id": 10088, "verse_number": "४-२४-५५", "content_sanskrit": "त्वां दुराराध्यमाराध्य सतामपि दुरापया।\nएकान्तभक्त्या को वाञ्छेत् पादमूलं विना बहिः॥ ४/२४/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.061.m4a", "display_order": 62}, {"id": 6000088062, "chapter_id": 10088, "verse_number": "४-२४-५६", "content_sanskrit": "यत्र निर्विष्टम् अरणं कृतान्तो नाभिमन्यते।\nविश्वं विष्टम्भयन् वीर्यशौर्यविस्फुरितभ्रुवा॥ ४/२४/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.062.m4a", "display_order": 63}, {"id": 6000088063, "chapter_id": 10088, "verse_number": "४-२४-५७", "content_sanskrit": "क्षणार्धेनापि तुलये न स्वर्गं नापुनर्भवम्।\nभगवत्सङ्गिसङ्गस्य मर्त्यानां किमुताशिषः॥ ४/२४/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.063.m4a", "display_order": 64}, {"id": 6000088064, "chapter_id": 10088, "verse_number": "४-२४-५८", "content_sanskrit": "अथानघाङ्घ्र्योस्तव कीर्तितीर्थयोरन्तर्बहिःस्नानविधूतपाप्मनाम्।\nभूतेष्वनुक्रोशसुसत्त्वशीलिनां स्यात् सङ्गमोऽनुग्रह एष नस्तव॥ ४/२४/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.064.m4a", "display_order": 65}, {"id": 6000088065, "chapter_id": 10088, "verse_number": "४-२४-५९", "content_sanskrit": "न यस्य चित्तं बहिरर्थविभ्रमं मनोगुहायां च निविष्टमाविशेत्।\nयद्भक्तियोगानुगृहीतमञ्जसा मुनिर्विचष्टे ननु तत्र ते पदम्॥ ४/२४/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.065.m4a", "display_order": 66}, {"id": 6000088066, "chapter_id": 10088, "verse_number": "४-२४-६०", "content_sanskrit": "यत्रेदं व्यज्यते विश्वं विश्वस्मिन्न च भाति यत्।\nतत्त्वं ब्रह्म परं ज्योतिराकाश इव विस्तृतम्॥ ४/२४/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.066.m4a", "display_order": 67}, {"id": 6000088067, "chapter_id": 10088, "verse_number": "४-२४-६१", "content_sanskrit": "यो माययेदं पुरुरूपयाऽसृजद् बिभर्ति भूयः क्षपयेदविक्रियः।\nयद्भेदबुद्धिः सदिवाऽऽत्मसंस्थया तमात्मतन्त्रं भगवन् प्रतीमहि॥ ४/२४/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.067.m4a", "display_order": 68}, {"id": 6000088068, "chapter_id": 10088, "verse_number": "४-२४-६२", "content_sanskrit": "क्रियाकलापैरिदमेव योगिनः श्रद्धान्विताः साधु यजन्ति सिद्धये।\nभूतेन्द्रियान्तःकरणोपलक्षणं वेदे च तन्त्रे च त एव कोविदाः॥ ४/२४/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.068.m4a", "display_order": 69}, {"id": 6000088069, "chapter_id": 10088, "verse_number": "४-२४-६३", "content_sanskrit": "त्वमेक आद्यः पुरुषः सुप्तशक्तिस्तया रजःसत्त्वतमो विभिद्यते।\nमहानहं खं मरुदग्निवार्धराः सुरर्षयो भूतगणा इदं यतः॥ ४/२४/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.069.m4a", "display_order": 70}, {"id": 6000088070, "chapter_id": 10088, "verse_number": "४-२४-६४", "content_sanskrit": "सृष्टं स्वशक्त्येदमनुप्रविश्य चतुर्विधं पुरमात्मांशकेन।\nअथो विदुस्त्वां पुरुषं सन्तमत्र भुङ्क्ते हृषीकैर्मधु सारघं यतः॥ ४/२४/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.070.m4a", "display_order": 71}, {"id": 6000088071, "chapter_id": 10088, "verse_number": "४-२४-६५", "content_sanskrit": "स एष लोकानतिचण्डवेगो विकर्षसि त्वं खलु कालयानः।\nभूतानि भूतैरनुमेयतत्त्वो घनावलीर्वायुरिवाविषह्यः॥ ४/२४/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.071.m4a", "display_order": 72}, {"id": 6000088072, "chapter_id": 10088, "verse_number": "४-२४-६६", "content_sanskrit": "प्रमत्तमुच्चैरितिकृत्यचिन्तया प्रवृद्धलोभं विषयेषु लालसम्।\nत्वमप्रमत्तः सहसाऽभिपद्यसे क्षुल्लेलिहानोऽहिरिवाखुमन्तकः॥ ४/२४/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.072.m4a", "display_order": 73}, {"id": 6000088073, "chapter_id": 10088, "verse_number": "४-२४-६७", "content_sanskrit": "कस्त्वत्पदाब्जं विजहाति पण्डितो यत् ते पुमानप्ययमब्जकेतनः।\nविशङ्कयाऽस्मद्गुरुरर्चति स्म यद् विनोपपत्तिं मनवश्चतुर्दश॥ ४/२४/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.073.m4a", "display_order": 74}, {"id": 6000088074, "chapter_id": 10088, "verse_number": "४-२४-६८", "content_sanskrit": "यत्स्पृष्टोऽहरहर्मुक्तक्लेशः शेतेऽमृताम्बुधौ।\nतावद् वेदाथ तत् तेऽङ्घ्रिं जनो नु स्मरते च तत्॥ ४/२४/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.074.m4a", "display_order": 75}, {"id": 6000088075, "chapter_id": 10088, "verse_number": "४-२४-६९", "content_sanskrit": "अथ त्वमसि नो ब्रह्मन् परमात्मन् विपश्चिताम्।\nविश्वं रुद्रभयध्वस्तमकुतश्चिद्भया गतिः॥ ४/२४/६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.075.m4a", "display_order": 76}, {"id": 6000088076, "chapter_id": 10088, "verse_number": "४-२४-७०", "content_sanskrit": "इदं जपत भद्रं वो विस्रभ्य नृपनन्दनाः।\nस्वधर्ममनुतिष्ठन्तो भगवत्यर्पिताशयाः॥ ४/२४/७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.076.m4a", "display_order": 77}, {"id": 6000088077, "chapter_id": 10088, "verse_number": "४-२४-७१", "content_sanskrit": "तमेवात्मानमात्मस्थं सर्वभूतेष्ववस्थितम्।\nपूजयध्वं गृणन्तश्च ध्यायन्तश्चासकृद्धरिम्॥ ४/२४/७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.077.m4a", "display_order": 78}, {"id": 6000088078, "chapter_id": 10088, "verse_number": "४-२४-७२", "content_sanskrit": "योगादेशमुपासाद्य धारयन्तो मुनिव्रताः।\nसमाहितधियः सर्वे एतदभ्यसनादृताः॥ ४/२४/७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.078.m4a", "display_order": 79}, {"id": 6000088079, "chapter_id": 10088, "verse_number": "४-२४-७३", "content_sanskrit": "इदमाह पुराऽस्माकं भगवान् विश्वसृक्पतिः।\nभृग्वादीनामात्मजानां सिसृक्षुः संसिसृक्षताम्॥ ४/२४/७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.079.m4a", "display_order": 80}, {"id": 6000088080, "chapter_id": 10088, "verse_number": "४-२४-७४", "content_sanskrit": "ते वयं चोदिताः सर्वे प्रजासर्गे प्रजेश्वराः।\nअनेन ध्वस्ततमसः सिसृक्ष्म विविधाः प्रजाः॥ ४/२४/७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.080.m4a", "display_order": 81}, {"id": 6000088081, "chapter_id": 10088, "verse_number": "४-२४-७५", "content_sanskrit": "अथेदं नित्यदा युक्तो जपन्नवहितः पुमान्।\nअचिराच्छ्रेय आप्नोति वासुदेवपरायणः॥ ४/२४/७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.081.m4a", "display_order": 82}, {"id": 6000088082, "chapter_id": 10088, "verse_number": "४-२४-७६", "content_sanskrit": "श्रेयसामिह सर्वेषां ज्ञानं निःश्रेयसं स्मृतम्।\nसुखं तरति दुष्पारं ज्ञाननौर्व्यसनार्णवम्॥ ४/२४/७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.082.m4a", "display_order": 83}, {"id": 6000088083, "chapter_id": 10088, "verse_number": "४-२४-७७", "content_sanskrit": "य इदं श्रद्धया युक्तो मद्गीतं भगवत्स्तवम्।\nअधीयानो दुराराध्यं हरिमाराधयत्यसौ॥ ४/२४/७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.083.m4a", "display_order": 84}, {"id": 6000088084, "chapter_id": 10088, "verse_number": "४-२४-७८", "content_sanskrit": "विन्दते पुरुषोऽमुष्माद् यद् यदिच्छति सत्वरम्।\nमद्गीतगीतात् सुप्रीताच्छ्रेयसामेकवल्लभात्॥ ४/२४/७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.084.m4a", "display_order": 85}, {"id": 6000088085, "chapter_id": 10088, "verse_number": "४-२४-७९", "content_sanskrit": "य इदं कल्य उत्थाय प्राञ्जलिः श्रद्धयाऽन्वितः।\nशृणुयाच्छ्रावयेन्मर्त्यो मुच्यते कर्मबन्धनैः॥ ४/२४/७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.085.m4a", "display_order": 86}, {"id": 6000088086, "chapter_id": 10088, "verse_number": "४-२४-८०", "content_sanskrit": "गीतं मयेदं नरदेवनन्दनाः परस्य पुंसः परमात्मनः स्तवम्।\nजपन्त एकाग्रधियस्तपो महच्चरध्वमन्ते तत आप्स्यथेप्सितम्॥ ४/२४/८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_024/BhP_04.024.086.m4a", "display_order": 87}, {"id": 6000088087, "chapter_id": 10088, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे चतुर्विंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}]