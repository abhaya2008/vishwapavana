[{"id": 2022189, "chapter_id": 1463, "verse_number": "३-१०१-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022190, "chapter_id": 1463, "verse_number": "३-१०१-१", "content_sanskrit": "समुद्रं ते समाश्रित्य वरुणं निधमम्भसः।\nकालेयाः संप्रवर्तन्त त्रैलोक्यस्य विनाशने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022191, "chapter_id": 1463, "verse_number": "३-१०१-२", "content_sanskrit": "ते रात्रौ समभिक्रुद्धा भक्षयन्ति सदा मुनीन्।\nआश्रमेषु च ये सन्ति पुण्येष्वायतनेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022192, "chapter_id": 1463, "verse_number": "३-१०१-३", "content_sanskrit": "वसिष्ठस्याश्रमे विप्रा भक्षितास्तैर्दुरात्मभिः।\nअशीतिः शतमष्टौ च नव चान्ये तपस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022193, "chapter_id": 1463, "verse_number": "३-१०१-४", "content_sanskrit": "च्यवनस्याश्रमं गत्वा पुण्यं द्विजनिषेवितम्।\nफलमूलाशनानां हि मुनीनां भक्षितं शतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022194, "chapter_id": 1463, "verse_number": "३-१०१-५", "content_sanskrit": "एवं रात्रौ स्म कुर्वन्ति विविशुश्चार्णवं दिवा।\n`कालेयास्ते दुरात्मानो भक्षयन्तस्तपोधनान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022195, "chapter_id": 1463, "verse_number": "३-१०१-६", "content_sanskrit": "भरद्वाजाश्रमे चैव नियता ब्र्हमचारिणः।\nवाय्वाहाराम्बुभक्षाश्च विंशतिः संनिषूदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022196, "chapter_id": 1463, "verse_number": "३-१०१-७", "content_sanskrit": "एवं क्रमेण सर्वांस्तानाश्रमान्दानवास्तदा।\nनिशायां परिबाधन्ते समुद्राम्बुबलाश्रयात्।\nकालोपसृष्टाः कालेया घ्नन्तो द्विजगणान्बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022197, "chapter_id": 1463, "verse_number": "३-१०१-८", "content_sanskrit": "न चैनानन्वबुध्यन्त मनुजा मनुजोत्तम।\nएवं प्रवृत्तान्दैत्यांस्तांस्तापसेषु तपस्विषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022198, "chapter_id": 1463, "verse_number": "३-१०१-९", "content_sanskrit": "`क्षयाय जगतः क्रूराः पर्यटन्ति स्म मेदिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022199, "chapter_id": 1463, "verse_number": "३-१०१-१०", "content_sanskrit": "प्रभाते समदृश्यन्त नियताहारकर्शिताः।\nमहीतलस्था मुनयः शरीरैर्गतजीवितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022200, "chapter_id": 1463, "verse_number": "३-१०१-११", "content_sanskrit": "क्षीणमांसैर्विरुधिरैर्विमज्जान्त्रैर्विसन्धिभिः।\nआकीर्णैराचिता भूमिः शङ्खानामिव राशिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022201, "chapter_id": 1463, "verse_number": "३-१०१-१२", "content_sanskrit": "लशैर्विप्रविद्धैश्च स्रुवैर्भग्नैस्तथैव च।\nविकीर्णैरग्निहोत्रैश्च भूर्बभूव समावृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022202, "chapter_id": 1463, "verse_number": "३-१०१-१३", "content_sanskrit": "निःस्वाध्यायवपट्कारं नष्टयज्ञोत्सवक्रियम्।\nजगदासीन्निरुत्साहं कालेयभयपीडितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022203, "chapter_id": 1463, "verse_number": "३-१०१-१४", "content_sanskrit": "एवं संक्षीयमाणाश्च मानवा मनुजेश्वर।\nआत्मत्राणपपा भीताः प्राद्रवन्त दिशो भयात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022204, "chapter_id": 1463, "verse_number": "३-१०१-१५", "content_sanskrit": "केचिद्गुहाः प्रविविशुर्निर्भरांश्चापरे श्रिताः।\nअपरे मरणोद्विग्ना भयात्प्राणान्समुत्सृजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022205, "chapter_id": 1463, "verse_number": "३-१०१-१६", "content_sanskrit": "केचिदत्रमहेष्वासाः शूराः परमहर्षिताः।\nमार्गमाणआः परं यत्नं दानवानां प्रचक्रिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022206, "chapter_id": 1463, "verse_number": "३-१०१-१७", "content_sanskrit": "न चैतानधिजग्मुस्ते समुद्रं समुपाश्रितान्।\nश्रमं जग्मुश्च परममाजग्मुः क्षयमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022207, "chapter_id": 1463, "verse_number": "३-१०१-१८", "content_sanskrit": "जगत्युपशमं याते नष्टयज्ञोत्सवक्रिये।\nआजग्मुः परमामार्तिं त्रिदशा मनुजेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022208, "chapter_id": 1463, "verse_number": "३-१०१-१९", "content_sanskrit": "समेत्य समहेन्द्राश्च भयान्मन्त्रं प्रचक्रिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022209, "chapter_id": 1463, "verse_number": "३-१०१-२०", "content_sanskrit": "शरण्यं शरणं देवं नारायणमजं विभुम्।\nतेऽभिगम्य नमस्कृत्य वैकुण्ठमपराजितम्।\nततो देवाः समस्तास्ते तदोचुर्मधुसूदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022210, "chapter_id": 1463, "verse_number": "३-१०१-२१", "content_sanskrit": "त्वंनः स्रष्टा च भर्ता च हर्ता च जगतः प्रभो।\nत्वया सृष्टमिदं विश्वं यच्चेङ्गं यच्च नेङ्गति।\n`त्वय्येव पुण्डरीकाक्ष पुनस्तत्प्रविलीयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022211, "chapter_id": 1463, "verse_number": "३-१०१-२२", "content_sanskrit": "त्वया भूमिः पुरा नष्टा समुद्रात्पुष्करेक्षण।\nवाराहं वपुराश्रित्यजगदर्थे समुद्धृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022212, "chapter_id": 1463, "verse_number": "३-१०१-२३", "content_sanskrit": "आदिदैत्यो महावीर्यो हिरण्यकशिपुः पुरा।\nनारसिंहं वपुः कृत्वा सूदितः पुरुषोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022213, "chapter_id": 1463, "verse_number": "३-१०१-२४", "content_sanskrit": "अवध्यः सर्वभूतानां बलिश्चापि महासुरः।\nवामनं वपुराश्रित्य त्रैलोक्याद्धंशितस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022214, "chapter_id": 1463, "verse_number": "३-१०१-२५", "content_sanskrit": "असुरश्च महेष्वासो जम्भ इत्यभिविश्रुतः।\nयज्ञक्षोभकरः क्रूरस्त्वयैव विनिपातितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022215, "chapter_id": 1463, "verse_number": "३-१०१-२६", "content_sanskrit": "एवमादीनि कर्माणि येषां संख्या न विद्यते।\nअस्माकं भयभीतानां त्वं गतिर्मधुसूदन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022216, "chapter_id": 1463, "verse_number": "३-१०१-२७", "content_sanskrit": "तस्मात्त्वां देवदेवेश लोकार्थं ज्ञापयामहे।\nरक्ष लोकांश्च देवांश्च शक्रं च महतो भयात्।\n`शरणागतसंत्राणे त्वमेकोऽसि दृढव्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022217, "chapter_id": 1463, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि एकाधिकशततमोऽध्यायः ॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]