[{"id": 2145240, "chapter_id": 4128, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145241, "chapter_id": 4128, "verse_number": "१", "content_sanskrit": "कांस्तत्र सञ्जयापश्यः प्रीत्यर्थेन समागतान् ।\nये योत्स्यन्ते पाण्डवार्थे पुत्रस्य मम वाहिनीम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145242, "chapter_id": 4128, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145243, "chapter_id": 4128, "verse_number": "२", "content_sanskrit": "मुखमन्धकवृष्णीनामपश्यं कृष्णमागतम् ।\nचेकितानं च तत्रैव युयुधानं च सात्यकिम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145244, "chapter_id": 4128, "verse_number": "३", "content_sanskrit": "पृथगक्षोहिणीभ्यां तु पाण्डवानभिसंश्रितौ ।\nमहारथौ समाख्यातावुभौ पुरुषमानिनौ\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145245, "chapter_id": 4128, "verse_number": "४", "content_sanskrit": "अक्षोहिण्याऽथ पाञ्चाल्यो दशभिस्तनयैर्वृतः ।\nसत्यजित् प्रमुखैर्वीरैर्धृष्टद्युम्नपुरोगमैः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145246, "chapter_id": 4128, "verse_number": "५", "content_sanskrit": "द्रुपदो वर्धयन् मानं शिखण्डिपरिवारितः ।\nउपायात् सर्वसैन्यानां प्रतिच्छाद्य महीं तदा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145247, "chapter_id": 4128, "verse_number": "६", "content_sanskrit": "विराटः सह पुत्राभ्यां शङ्खैनैवोत्तरेण च ।\nसूर्यदत्तादिभिर्वीरैर्मदिराश्वपुरोगमैः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145248, "chapter_id": 4128, "verse_number": "७", "content_sanskrit": "सहितः पृथिवीपालो भ्रातृभिः तनयैस्तथा ।\nअक्षोहिण्यैव सैन्यानां वृतः पार्थं समाश्रितः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145249, "chapter_id": 4128, "verse_number": "८", "content_sanskrit": "जारासन्धिर्मागधश्च धृष्टकेतुश्च चेदिराट् ।\nपृथक्पृथगनुप्राप्तौ पृथगक्षोहिणीवृतौ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145250, "chapter_id": 4128, "verse_number": "९", "content_sanskrit": "केकया भ्रातरः पञ्च सर्वे लोहितकध्वजाः ।\nअक्षोहिणीपरिवृताः पाण्डवानभिसंश्रिताः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145251, "chapter_id": 4128, "verse_number": "१०", "content_sanskrit": "एतानेतावतस्तत्र तानपश्यं समागतान् ।\nये पाण्डवार्थे योत्स्यन्ति धार्तराष्ट्रस्य वाहिनीम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145252, "chapter_id": 4128, "verse_number": "११", "content_sanskrit": "यो वेद मानुषं व्यूहं दैवं गान्धर्वमासुरम् ।\nस तत्र सेनाप्रमुखे धृष्टद्युम्नो महारथः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145253, "chapter_id": 4128, "verse_number": "१२", "content_sanskrit": "भीष्मः शान्तनवो राजन् भागः क्लृप्तः शिखण्डिनः ।\nतं विराटोऽनुसंयाता सार्धं मत्स्यैः प्रहारिभिः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145254, "chapter_id": 4128, "verse_number": "१३", "content_sanskrit": "ज्येष्ठस्य पाण्डुपुत्रस्य भागो मद्राधिपो बली ।\nतौ तु तत्राब्रुवन् केचिद् विषमौ नो मताविति\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145255, "chapter_id": 4128, "verse_number": "१४", "content_sanskrit": "दुर्योधनः सहसुतः सार्धं भ्रातृशतेन च ।\nप्राच्याश्च दाक्षिणात्याश्च भीमसेनस्य भागतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145256, "chapter_id": 4128, "verse_number": "१५", "content_sanskrit": "अर्जुनस्य तु भागेन कर्णो वैकर्तनो मतः ।\nअश्वत्थामा विकर्णश्च सैन्धवश्च जयद्रथः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145257, "chapter_id": 4128, "verse_number": "१६", "content_sanskrit": "अशक्याश्चैव ये केचित् पृथिव्यां शूरमानिनः ।\nसर्वांस्तानर्जुनः पार्थः कल्पयामास भागतः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145258, "chapter_id": 4128, "verse_number": "१७", "content_sanskrit": "महेष्वासा राजपुत्राः भ्रातरः पञ्च केकयाः ।\nकेकयानेव भागेन कृत्वा योत्स्यन्ति संयुगे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145259, "chapter_id": 4128, "verse_number": "१८", "content_sanskrit": "तेषामेव कृतो भागो मालवाः साल्वकास्तथा ।\nत्रिगर्तानां च वै मुख्यौ यौ तौ संशप्तकाविति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2145260, "chapter_id": 4128, "verse_number": "१९", "content_sanskrit": "दुर्योधनसुताः सर्वे तथा दुःशासनस्य च ।\nसौभद्रेण कृतो भागो राजा चैव बृहद्बलः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2145261, "chapter_id": 4128, "verse_number": "२०", "content_sanskrit": "द्रौपदेया महेष्वासाः सुवर्णविकृतध्वजाः ।\nधृष्टद्युम्नमुखा द्रोणमभियास्यन्ति भारत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2145262, "chapter_id": 4128, "verse_number": "२१", "content_sanskrit": "चेकितानः सोमदत्तं द्वैरथे योद्धुमिच्छति ।\nभोजं तु कृतवर्माणं युयुधानो युयुत्सति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2145263, "chapter_id": 4128, "verse_number": "२२", "content_sanskrit": "सहदेवस्तु माद्रेयः शूरः सङ्क्रन्दनो युधि ।\nस्वमंशं कल्पयामास स्यालं ते सुबलात्मजम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2145264, "chapter_id": 4128, "verse_number": "२३", "content_sanskrit": "उलूकं चैव कैतव्यं ये च सारस्वता गणाः ।\nनकुलः कल्पयामास भागं माद्रवतीसुतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2145265, "chapter_id": 4128, "verse_number": "२४", "content_sanskrit": "ये चान्ये पार्थिवा राजन् प्रत्युद्यास्यन्ति सङ्गरे ।\nसमाह्वानेन तांश्चापि पाण्डुपुत्रा अकल्पयन्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2145266, "chapter_id": 4128, "verse_number": "२५", "content_sanskrit": "एवमेषामनीकानि प्रविभक्तानि भागशः ।\nयत् ते कार्यं सपुत्रस्य क्रियतां तदकालिकम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2145267, "chapter_id": 4128, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2145268, "chapter_id": 4128, "verse_number": "२६", "content_sanskrit": "न सन्ति सर्वे पुत्रा मे मूढाः दुर्द्यूतदेविनः ।\nयेषां युद्धं बलवता भीमेन रणमूर्धनि\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2145269, "chapter_id": 4128, "verse_number": "२७", "content_sanskrit": "राजानः पार्थिवाः सर्वे प्रोक्षिताः कालधर्मणा ।\nगाण्डीवाग्निं प्रवेक्ष्यन्ति पतङ्गा इव पावकम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2145270, "chapter_id": 4128, "verse_number": "२८", "content_sanskrit": "विद्रुतां वाहिनीं मन्ये कृतवैरैर्महात्मभिः ।\nतां रणे केऽनुयास्यन्ति प्रभग्नां पाण्डवैर्युधि\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2145271, "chapter_id": 4128, "verse_number": "२९", "content_sanskrit": "सर्वे ह्यतिरथाः शूराः कीर्तिमन्तः प्रतापिनः ।\nसूर्यपावकयोस्तुल्याः तेजसा समितिञ्जयाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2145272, "chapter_id": 4128, "verse_number": "३०", "content_sanskrit": "येषां युधिष्ठिरो नेता गोप्ता च मधुसूदनः ।\nयोधौ च पाण्डवौ वीरौ सव्यसाचिवृकोदरौ\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2145273, "chapter_id": 4128, "verse_number": "३१", "content_sanskrit": "नकुलः सहदेवश्च धृष्टद्युम्नश्च पार्षतः ।\nसात्यकिर्द्रुपदश्चैव धृष्टद्युम्नस्य चात्मजाः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2145274, "chapter_id": 4128, "verse_number": "३२", "content_sanskrit": "उत्तमौजाश्च पाञ्चालो युधामन्युश्च दुर्जयः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2145275, "chapter_id": 4128, "verse_number": "३३", "content_sanskrit": "शिखण्डी क्षत्रदेवश्च तथा वैराटिरुत्तरः ।\nकाशयश्चेदयश्चैव मत्स्याः सर्वे च सृञ्जयाः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2145276, "chapter_id": 4128, "verse_number": "३४", "content_sanskrit": "विराटपुत्रो बभ्रुश्च पाञ्चालाश्च प्रभद्रकाः ।\nतेषामिन्द्रोऽप्यकामानां न हरेत् पृथिवीमिमाम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2145277, "chapter_id": 4128, "verse_number": "३५", "content_sanskrit": "वीराणां रणधीराणां ये भिन्द्युः पर्वतानपि\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2145278, "chapter_id": 4128, "verse_number": "३६", "content_sanskrit": "तान् सर्वगुणसम्पन्नान् अमनुष्यप्रतापिनः ।\nक्रोशतो मम दुष्पुत्रो योद्धुमिच्छति सञ्जय\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2145279, "chapter_id": 4128, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2145280, "chapter_id": 4128, "verse_number": "३७", "content_sanskrit": "उभौ स्व एकजातीयौ तथोभौ भूमिगोचरौ ।\nअथ कस्मात् पाण्डवानामेकतो मन्यसे जयम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2145281, "chapter_id": 4128, "verse_number": "३८", "content_sanskrit": "पितामहं च द्रोणं च कृपं कर्णं च दुर्जयम् ।\nजयद्रथं सोमदत्तमश्वत्थामानमेव च\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2145282, "chapter_id": 4128, "verse_number": "३९", "content_sanskrit": "सुतेजसो महेष्वासान् इन्द्रोऽपि सहितोऽमरैः ।\nअशक्तः समरे जेतुं किं पुनस्तात पाण्डवाः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2145283, "chapter_id": 4128, "verse_number": "४०", "content_sanskrit": "सर्वे च पृथिवीपाला मदर्थे तात पाण्डवान् ।\nआर्याः शस्त्रभृतः शूराः समर्थाः प्रतिबाधितुम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2145284, "chapter_id": 4128, "verse_number": "४१", "content_sanskrit": "न मामकान् पाण्डवास्ते समर्थाः प्रतिवीक्षितुम् ।\nपराक्रान्तो ह्यहं पाण्डून् सपुत्रान् योद्धुमाहवे\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2145285, "chapter_id": 4128, "verse_number": "४२", "content_sanskrit": "मत्प्रियं पार्थिवाः सर्वे ये चिकीर्षन्ति भारत ।\nते तानावारयिष्यन्ति ऐणेयानिव तन्तुना\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2145286, "chapter_id": 4128, "verse_number": "४३", "content_sanskrit": "महता रथवंशेन शरजालैश्च मामकैः ।\nअभिद्रुता भविष्यन्ति पाञ्चालाः पाण्डवैः सह\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2145287, "chapter_id": 4128, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2145288, "chapter_id": 4128, "verse_number": "४४", "content_sanskrit": "उन्मत्त इव मे पुत्रो विलपत्येष सञ्जय ।\nन हि शक्तो युधा जेतुं धर्मराजं युधिष्ठिरम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2145289, "chapter_id": 4128, "verse_number": "४५", "content_sanskrit": "जानाति हि यथा भीष्मः पाण्डवानां यशस्विनाम् ।\nबलवत्तां सपुत्राणां धर्मज्ञानां महात्मनाम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2145290, "chapter_id": 4128, "verse_number": "४६", "content_sanskrit": "यतो नारोचयदयं विग्रहं तैर्महात्मभिः ।\nकिन्तु सञ्जय मे ब्रूहि पुनस्तेषां विचेष्टितम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2145291, "chapter_id": 4128, "verse_number": "४७", "content_sanskrit": "कस्तांस्तरस्विनो भूयः सन्दीपयति पाण्डवान् ।\nअर्चिष्मतो महेष्वासान् हविषा पावकानिव\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2145292, "chapter_id": 4128, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2145293, "chapter_id": 4128, "verse_number": "४८", "content_sanskrit": "धृष्टद्युम्नः सदैवैतान् सन्दीपयति भारत\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2145294, "chapter_id": 4128, "verse_number": "४९", "content_sanskrit": "युद्ध्यध्वमिति मा भैष्ट युद्धाद् भरतसत्तमाः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2145295, "chapter_id": 4128, "verse_number": "५०", "content_sanskrit": "ये केचित् पार्थिवास्तत्र धार्तराष्ट्रेण संवृताः ।\nयुद्धे समागमिष्यन्ति तुमुले शस्त्रसङ्कुले\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2145296, "chapter_id": 4128, "verse_number": "५१", "content_sanskrit": "तान् सर्वानाहवे क्रुद्धान् सानुबन्धान् समागतान् ।\nअहमेकः समादास्ये तिमिर्मत्स्यानिवौदकात्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2145297, "chapter_id": 4128, "verse_number": "५२", "content_sanskrit": "भीष्मं द्रोणं कृपं कर्णं द्रौणिं शल्यं सुयोधनम् ।\nएतांश्चापि निरोत्स्यामि वेलेव मकरालयम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2145298, "chapter_id": 4128, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2145299, "chapter_id": 4128, "verse_number": "५३", "content_sanskrit": "तथा ब्रुवन्तं धर्मात्मा प्राह राजा युधिष्ठिरः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2145300, "chapter_id": 4128, "verse_number": "५४", "content_sanskrit": "तव धैर्यं च वीर्यं च पाञ्चालाः पाण्डवैः सह ।\nसर्वे समधिरूढाः स्म सङ्ग्रामान्नः समुद्धर\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2145301, "chapter_id": 4128, "verse_number": "५५", "content_sanskrit": "जानामि त्वां महाबाहो क्षत्रधर्मे व्यवस्थितम् ।\nसमर्थमेकं पर्याप्तं कौरवाणां विनिग्रहे\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2145302, "chapter_id": 4128, "verse_number": "५६", "content_sanskrit": "पुरस्तादुपयातानां कौरवाणां युयुत्सताम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2145303, "chapter_id": 4128, "verse_number": "५७", "content_sanskrit": "भवता यद् विधातव्यं तन्नः श्रेयः परन्तप ।\nसङ्ग्रामादपयातानां भग्नानां शरणैषिणाम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2145304, "chapter_id": 4128, "verse_number": "५८", "content_sanskrit": "पौरुषं दर्शयन् शूरो यस्तिष्ठेदग्रतः पुमान् ।\nक्रीणीयात् तं सहस्रेण इति नीतिमतां मतम्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2145305, "chapter_id": 4128, "verse_number": "५९", "content_sanskrit": "स त्वं शूरश्च वीरश्च विक्रान्तश्च नरर्षभ ।\nभयार्तानां परित्राता संयुगेषु न संशयः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2145306, "chapter_id": 4128, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2145307, "chapter_id": 4128, "verse_number": "६०", "content_sanskrit": "एवं ब्रुवति कौन्तेये धर्मात्मनि युधिष्ठिरे ।\nधृष्टद्युम्न उवाचेदं मां वचो गतसाध्वसम्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2145308, "chapter_id": 4128, "verse_number": "६१", "content_sanskrit": "सर्वान् जनपदान् सूत योधा दुर्योधनस्य ये ।\nसबाह्लिकान् कुरून् ब्रूयाः प्रतिवीरान् शरद्वतः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2145309, "chapter_id": 4128, "verse_number": "६२", "content_sanskrit": "सूतपुत्रं तथा द्रोणं सहपुत्रं जयद्रथम् ।\nभीष्मं चैव ब्रूहि गत्वा आशु गच्छ च मा चिरम्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2145310, "chapter_id": 4128, "verse_number": "६३", "content_sanskrit": "युधिष्ठिरो साधुनैवाभ्युपैति\nमा वोऽवधीदर्जुनो देवगुप्तः ।\nवनं दग्धं देवराजस्य तूर्णं\nयाचध्वं वै पाण्डवं लोकवीरम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2145311, "chapter_id": 4128, "verse_number": "६४", "content_sanskrit": "नैतादृशो हि योधोऽस्ति पृथिव्यामिह कश्चन ।\nयथाविधः सव्यसाची पाण्डवः सत्यविक्रमः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2145312, "chapter_id": 4128, "verse_number": "६५", "content_sanskrit": "देवैर्हि सम्भृतो दिव्यो रथो गाण्डीवधन्वनः ।\nन स जेयो मनुष्येण मा स्म कृद्ध्वं मनो युधि\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2145313, "chapter_id": 4128, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोनषष्टितमोऽध्यायः ॥५९॥\nव्यासाभिगमनपर्वणि द्वादशोऽध्यायः ॥१२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}]