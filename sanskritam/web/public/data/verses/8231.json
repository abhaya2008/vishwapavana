[{"id": 900001288, "chapter_id": 8231, "verse_number": "5.1", "content_sanskrit": "यो ह वा आत्मानं पञ्चविधमुक्थं वेद..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001289, "chapter_id": 8231, "verse_number": "5.2", "content_sanskrit": "प्रथमे पञ्चाद्भागे स्थितो नारायणः स्वयम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001290, "chapter_id": 8231, "verse_number": "5.3", "content_sanskrit": "पृथिवी वायुराकाश आपो ज्योतींषीत्येष वा आत्मोक्थं पञ्चविधम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001291, "chapter_id": 8231, "verse_number": "5.4", "content_sanskrit": "यद्यप्यस्य हरेः सर्वरूपाण्यप्यखिलैर्गुणैः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001292, "chapter_id": 8231, "verse_number": "5.5", "content_sanskrit": "एतस्माद्धि हरेर्नित्यं जगदुत्तिष्ठति प्रभोः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001293, "chapter_id": 8231, "verse_number": "5.6", "content_sanskrit": "तस्मिन् योऽन्नं चान्नादं च वेदा हास्मिन्ननादो जायते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001294, "chapter_id": 8231, "verse_number": "5.7", "content_sanskrit": "तस्मिन् योऽन्नं चान्नादं च वेदा हास्मिन्नन्नादो जायते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001295, "chapter_id": 8231, "verse_number": "5.8", "content_sanskrit": "पुरुषस्य हरेर्ये तु तदाकारेण संस्थिताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001296, "chapter_id": 8231, "verse_number": "5.9", "content_sanskrit": "आत्मशब्दाच्च न भूतमात्रमत्रोच्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001297, "chapter_id": 8231, "verse_number": "5.10", "content_sanskrit": "तस्मिन् पश्ञ्चके योऽन्नमन्नादं च वेद ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900001298, "chapter_id": 8231, "verse_number": "5.11", "content_sanskrit": "क्षीराब्धिशयनं विष्णो रूपं यत्पुरुषाभिधम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900001299, "chapter_id": 8231, "verse_number": "5.12", "content_sanskrit": "तस्य य आत्मानमाविस्तरां वेद", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900001300, "chapter_id": 8231, "verse_number": "5.13", "content_sanskrit": "शिलायेषु स्थितो विष्णुर्भारदाढर्यादिकारणम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900001301, "chapter_id": 8231, "verse_number": "5.14", "content_sanskrit": "य आत्मानं परमात्मानमाविस्तरां आविर्भावतारतम्येन वेद स तस्य विष्णोरेव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900001302, "chapter_id": 8231, "verse_number": "5.15", "content_sanskrit": "स एष पुरुषः समुद्रः सर्वं लोकमति यद्ध किञ्चाश्नुतेत्येनं मन्यते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900001303, "chapter_id": 8231, "verse_number": "5.16", "content_sanskrit": "यद्यपि देवलोकाधिपत्यं तद्योग्यस्य विष्णुर्ददाति तदप्यनुवीतैव", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_or