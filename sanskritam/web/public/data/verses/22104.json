[{"id": 7002104000, "chapter_id": 22104, "verse_number": "१४९-१", "content_sanskrit": "ईश्वर उवाच ।\nहोमाद्रणादौ विजयो राज्याप्तिर्विघ्ननाशनं ।\nकृच्छ्रेण शुद्धिमुत्पाद्य प्राणायामशतेन च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002104001, "chapter_id": 22104, "verse_number": "१४९-२", "content_sanskrit": "अन्तर्जले च गायत्रीं जप्त्वा षोडशधाचरेत् ।\nप्राणायामांश्च पूर्वाह्णे जुहुयात्पावके हविः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002104002, "chapter_id": 22104, "verse_number": "१४९-३", "content_sanskrit": "भैक्ष्ययावकभक्षी च फलमूलाशनोऽपि वा ।\nक्षीरशक्तुघृताहार एकमाहारमाश्रयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002104003, "chapter_id": 22104, "verse_number": "१४९-४", "content_sanskrit": "यावत्समाप्तिर्भवति लक्षहोमस्य पार्वति ।\nदक्षिणा लक्षहोमान्ते गावो वस्त्राणि काञ्चनं ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002104004, "chapter_id": 22104, "verse_number": "१४९-५", "content_sanskrit": "सर्वोत्पातसमुत्पत्तौ पञ्चभिर्दशभिर्द्विजैः ।\nनास्ति लोके स उत्पातो यो ह्यनेन न शाम्यति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002104005, "chapter_id": 22104, "verse_number": "१४९-६", "content_sanskrit": "मङ्गल्यं परमं नास्ति यदस्मादतिरिच्यते ।\nकोटिहोमन्तु यो राजा कारयेत्पूर्ववद्द्विजैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002104006, "chapter_id": 22104, "verse_number": "१४९-७", "content_sanskrit": "न तस्य शत्रवः सङ्ख्ये जातु तिष्ठन्ति कर्हिचित् ।\nन तस्य मारको देशे व्याधिर्वा जायते क्वचित् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002104007, "chapter_id": 22104, "verse_number": "१४९-८", "content_sanskrit": "अतिवृष्टिरनावृष्टिर्मूषकाः शलभाः शुकाः ।\nराक्षसाद्याश्च शाम्यन्ति सर्वे च रिपवो रणे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002104008, "chapter_id": 22104, "verse_number": "१४९-९", "content_sanskrit": "कोटिहोमे तु वरयेद्ब्राह्मणान्विंशतिं तथा ।\nशतञ्चाथ सहस्रं वा यथेष्टाम्भूतिमाप्नुयात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002104009, "chapter_id": 22104, "verse_number": "१४९-१०", "content_sanskrit": "कोटिहोमन्तु यः कुर्याद्द्विजो भूपोऽथवा च विट् ।\nयदिच्छेत्प्राप्नुयात्तत्तत्सशरीरो दिवं व्रजेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002104010, "chapter_id": 22104, "verse_number": "१४९-११", "content_sanskrit": "गायत्र्या ग्रहमन्त्रैर्वा कुष्माण्डीजातवेदसैः ।\nऐन्द्रवारुणवायव्ययाम्याग्नेयैश्च वैष्णवैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002104011, "chapter_id": 22104, "verse_number": "१४९-१२", "content_sanskrit": "शाक्तेयैश्च शाम्भवैः सौरैर्मन्त्रैर्होमार्चनात्ततः ।\nअयुतेनाल्पसिद्धिः स्याल्लक्षहोमोऽखिलार्तिनुत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002104012, "chapter_id": 22104, "verse_number": "१४९-१३", "content_sanskrit": "सर्वपीडादिनशाय कोटिहोमोऽखिलार्थदः ।\nयवव्रीहितिलक्षीरघृतकुशप्रमातिकाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002104013, "chapter_id": 22104, "verse_number": "१४९-१४", "content_sanskrit": "पङ्कजोशीरविल्वाम्रदला होमे प्रकीर्तिताः ।\nअष्टहस्तप्रमाणेन कोटिहोमेषु खातकं ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002104014, "chapter_id": 22104, "verse_number": "१४९-१५", "content_sanskrit": "तस्मादर्धप्रमाणेन लक्षहोमे विधीयते ।\nहोमोऽयुतेन लक्षेण कोद्याज्याद्यैः प्रकीर्तितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]