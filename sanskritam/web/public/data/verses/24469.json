[{"id": 7004469000, "chapter_id": 24469, "verse_number": "५-३-१६३-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेन्महाराज नागतीर्थमनुत्तमम् ।\nआश्विनस्य सिते पक्षे पञ्चम्यां नियतः शुचिः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004469001, "chapter_id": 24469, "verse_number": "५-३-१६३-२", "content_sanskrit": "रात्रौ जागरणं कृत्वा गन्धधूपनिवेदनैः ।\nप्रभाते विमले स्नात्वा श्राद्धं कृत्वा यथाविधि॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004469002, "chapter_id": 24469, "verse_number": "५-३-१६३-३", "content_sanskrit": "मुच्यते सर्वपापेभ्यो नात्र कार्या विचारणा ।\nतत्र तीर्थे तु यो राजन्प्राणत्यागं करिष्यति॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004469003, "chapter_id": 24469, "verse_number": "५-३-१६३-४", "content_sanskrit": "अनिवर्तिका गतिस्तस्य प्रोवाचेति शिवः स्वयम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]