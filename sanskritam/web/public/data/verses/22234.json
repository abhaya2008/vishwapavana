[{"id": 7002234000, "chapter_id": 22234, "verse_number": "२७९-१", "content_sanskrit": "अग्निरुवाच ।\nआयुर्वेदं प्रवक्ष्यामि सुश्रुताय यमब्रवीत् ।\nदेवो धन्वन्तरिः सारं मृतसञ्जीवनीकरं ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002234001, "chapter_id": 22234, "verse_number": "२७९-२", "content_sanskrit": "सुश्रुत उवाच ।\nआयुर्वेदं मम ब्रूहि नराश्वेभरुगर्दनम् ।\nसिद्धयोगान् सिद्धमन्त्रान् मृतसञ्जीवनीकरान् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002234002, "chapter_id": 22234, "verse_number": "२७९-३", "content_sanskrit": "धन्वन्तरिरुवाच ।\nरक्षन् बलं हि ज्वरितं लङ्घितं भोजयेद्भिषक् ।\nसविश्वं लाजमण्डन्तु तृड्ज्वरान्तं श्रृतं जलम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002234003, "chapter_id": 22234, "verse_number": "२७९-४", "content_sanskrit": "मुस्तपर्पटकोशीरचन्दनोदीच्यनागरैः ।\nषड़हे च व्यतिक्रान्ते तिक्तकं पाययेद्ध्रुवम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002234004, "chapter_id": 22234, "verse_number": "२७९-५", "content_sanskrit": "स्नेहयेत्त्यक्तदोषन्तु ततस्तञ्च विरेचयेत् ।\nजीर्णाः षष्टिकनीवाररक्तशालिप्रमोदकाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002234005, "chapter_id": 22234, "verse_number": "२७९-६", "content_sanskrit": "तद्विधास्ते ज्वरेष्विष्टा यवानां विकृतिस्तथा ।\nमुद्गा मसूराश्चणकाः कुलत्थास्च सकुष्ठकाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002234006, "chapter_id": 22234, "verse_number": "२७९-७", "content_sanskrit": "आटक्यो नारकाद्याश्च कर्क्कोटककटोल्वकम् ।\nपटोलं सफलं निम्बं पर्पटं दाडिमं ज्वरे ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002234007, "chapter_id": 22234, "verse_number": "२७९-८", "content_sanskrit": "अधोगे वमनं शस्तमूद्र्ध्वगे च विरेचनम् ।\nरक्तपित्ते तथा पानं षडङ्गं शुण्ठिवर्ज्जितम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002234008, "chapter_id": 22234, "verse_number": "२७९-९", "content_sanskrit": "शक्रुगोधूमलाजाश्च यवशालिमसूरकाः ।\nसकुष्ठचणका मुद्गा भक्ष्या गोधूमका हिताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002234009, "chapter_id": 22234, "verse_number": "२७९-१०", "content_sanskrit": "साधिता घृतदुग्धाभ्यां क्षौद्रं वृषरसो मधु ।\nअतीसारे पुराणानां शालीनां भक्षणं हितं ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002234010, "chapter_id": 22234, "verse_number": "२७९-११", "content_sanskrit": "अनभिष्यन्दि यच्चान्नं लोध्रवल्कलसंयुतम् ।\nमारुतं वर्ज्जयेद् यत्नः कार्य्यो गुल्मेषु सर्वथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002234011, "chapter_id": 22234, "verse_number": "२७९-१२", "content_sanskrit": "वाट्यं क्षीरेण चाश्नीयाद्वास्तूकं घृतसाधितं ।\nगोधूमशालयस्तिक्ता हिता जठरिणामथ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002234012, "chapter_id": 22234, "verse_number": "२७९-१३", "content_sanskrit": "गोधूमशालयो मुद्गा ब्रह्मर्क्षखदिरोऽभया ।\nपञ्चकोलञ्जाङ्गलाश्च निम्बधात्र्याः पटोलकाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002234013, "chapter_id": 22234, "verse_number": "२७९-१४", "content_sanskrit": "मातुलङ्गरसाजातिशुष्कमूलकसैन्धवाः ।\nकुष्ठिनाञ्च तता शस्तं पानार्थे खदिरोदकं ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002234014, "chapter_id": 22234, "verse_number": "२७९-१५", "content_sanskrit": "मसूरमुद्गौ पेयार्थे भोज्या जीर्णाश्च शालयः ।\nनिम्बपर्पटकैः शाकैर्ज्जाङ्गलानां तथा रसः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002234015, "chapter_id": 22234, "verse_number": "२७९-१६", "content_sanskrit": "विडङ्गं मरिचं मुस्तं कुष्ठं लोध्रं सुवर्च्चिका ।\nमनः शिला च वालेयः कुष्ठहा मूत्रपेषितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002234016, "chapter_id": 22234, "verse_number": "२७९-१७", "content_sanskrit": "अपूपकुष्ठकुल्माषयवाद्या मेहिनां हिताः ।\nयवान्नविकृतिर्मुद्गा कुलत्था जीर्णशालयः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002234017, "chapter_id": 22234, "verse_number": "२७९-१८", "content_sanskrit": "तिक्तरुक्षाणि शाकानि तिक्तानि हरितानि च ।\nतैलानि तिलशिग्रुकविभीतकेङ्गुदानि च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002234018, "chapter_id": 22234, "verse_number": "२७९-१९", "content_sanskrit": "मुद्गाः सयवगोधूमा धान्यं वर्षस्थितञ्च यत् ।\nजाङ्गलस्य रसः शस्तो भोजने राजयक्ष्मिणां ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002234019, "chapter_id": 22234, "verse_number": "२७९-२०", "content_sanskrit": "कौलत्थमौद्गको रास्नाशुष्कमूलकजाङ्गलैः ।\nपूपैर्वा विस्किरैः सिद्धैर्दधिदाड़िमसाधितैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002234020, "chapter_id": 22234, "verse_number": "२७९-२१", "content_sanskrit": "मातुलङ्गरसक्षौद्रद्राक्षाव्योषादिसंस्कृतैः ।\nयवगोधूमशाल्यन्नैर्भोज्येच्छ्वासकासिनं ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002234021, "chapter_id": 22234, "verse_number": "२७९-२२", "content_sanskrit": "दशमूलवलारास्नाकुलत्थैरुपसाधिताः ।\nपेयाः पूपरसाः क्काथाः श्वासहिक्कानिवारणा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002234022, "chapter_id": 22234, "verse_number": "२७९-२३", "content_sanskrit": "शुष्कमूलककौलत्थमूलजाह्गलजै रसैः ।\nयवगोधूमशाल्यन्नं जीर्णं सोशीरमाचरेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002234023, "chapter_id": 22234, "verse_number": "२७९-२४", "content_sanskrit": "शोथवान् सगुड़ां पथ्यां खादेद्वा गुड़नागरम् ।\nतक्रञ्च चित्रकञ्चोभौ ग्रहणीरोगनाशनौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002234024, "chapter_id": 22234, "verse_number": "२७९-२५", "content_sanskrit": "पुराणयवगोधूमशालयो जाङ्गलो रसः ।\nमुद्गामलकखर्जूरमृद्वीकावदराणि च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002234025, "chapter_id": 22234, "verse_number": "२७९-२६", "content_sanskrit": "मधु सर्पिः पयः शक्र निम्बपर्पटकौ वृषम् ।\nतक्रारिष्टाश्च शस्यन्ते सततं वातरोगिणाम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002234026, "chapter_id": 22234, "verse_number": "२७९-२७", "content_sanskrit": "हृद्रोगिणो विरेच्यास्तु पिप्पल्यो हिक्किनां हिताः ।\nतक्रावलालसिन्धूनि मुक्तानि शिशिराम्भसा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002234027, "chapter_id": 22234, "verse_number": "२७९-२८", "content_sanskrit": "मुक्ताः सौवर्चलाजादि मद्यं शस्तं मदात्यये ।\nसक्षोद्रपयसा लाक्षआं पिवेच्च क्षचवान्नरः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002234028, "chapter_id": 22234, "verse_number": "२७९-२९", "content_sanskrit": "क्षयं मांसरसाहारो वह्निसंरक्षणाज्जयेत् ।\nशालयो भोजने रक्ता नीवारकलमादयः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002234029, "chapter_id": 22234, "verse_number": "२७९-३०", "content_sanskrit": "यवान्नविकृतिर्म्मांसं शाकं सौवर्चलं शटी ।\nपथ्या तथैवार्शसां यन्मण्डं तक्रञ्च वारिणा ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002234030, "chapter_id": 22234, "verse_number": "२७९-३१", "content_sanskrit": "मुस्ताभ्यासस्तथा लोपश्चित्रकेण हरिद्रया ।\nयवान्नविकृतिः शालिर्व्वास्तूकं ससुवर्च्चलम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002234031, "chapter_id": 22234, "verse_number": "२७९-३२", "content_sanskrit": "त्रपुषैर्वारुगोधूमाः क्षीरेक्षुघृतसंयुताः ।\nमूत्रकृच्छ्रे च शस्ताः स्युः पाने मण्डसुरादयः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002234032, "chapter_id": 22234, "verse_number": "२७९-३३", "content_sanskrit": "लाजाः शक्तुस्तथा क्षौद्रं शूल्यं मांसं परूषकम् ।\nवार्त्ताकुलावशिखिनश्छर्द्दिघ्नाः पानकानि च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002234033, "chapter_id": 22234, "verse_number": "२७९-३४", "content_sanskrit": "शाल्यन्नन्तोयपयसी केवलोष्णे श्रृतेऽपि वा ।\nतृष्णाघ्ने मुस्तगुड़योर्गुटिका वा मुखे धृता ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002234034, "chapter_id": 22234, "verse_number": "२७९-३५", "content_sanskrit": "यवान्नविकृतिः पूपं शुष्कमूलकजन्तथा ।\nशाकं पटोलवेत्राग्रमुरुस्तम्भविनाशनम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002234035, "chapter_id": 22234, "verse_number": "२७९-३६", "content_sanskrit": "मुद्गाढ़कमसूराणां सतिलैर्जाङ्गलै रसैः ।\nससैन्धवघृतद्राक्षाशुण्ठ्यामलककोलजैः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002234036, "chapter_id": 22234, "verse_number": "२७९-३७", "content_sanskrit": "यूषैः पुराणगोधूमयवशाल्यन्नमभ्यसेत् ।\nविसर्पी ससिताक्षौद्रमृद्वीकादाड़िमोदकम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002234037, "chapter_id": 22234, "verse_number": "२७९-३८", "content_sanskrit": "रक्तयष्टिकगोधूमयवमुद्गादिकं लघु ।\nकाकमारी च वेत्राग्रं वास्तुकञ्च सुवर्च्चला ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002234038, "chapter_id": 22234, "verse_number": "२७९-३९", "content_sanskrit": "वातशोणितनाशाय तोयं शस्तं मधु ।\nनाशारोगेषु च हितं घृतं दुर्व्वाप्रसाधितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002234039, "chapter_id": 22234, "verse_number": "२७९-४०", "content_sanskrit": "भृङ्गराजरसे सिद्धं तैलं धात्रीरसेऽपि वा ।\nनश्यं सर्वामयेष्विष्टं मूर्द्धजन्तूद्भवेषु च ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002234040, "chapter_id": 22234, "verse_number": "२७९-४१", "content_sanskrit": "शीततोयान्नपानञ्च तिलानां विप्र भक्षणम् ।\nद्विजजाढर्यकरं प्रोक्तं तथा तुष्टिकरम्परम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002234041, "chapter_id": 22234, "verse_number": "२७९-४२", "content_sanskrit": "गण्डूषं तिलतैलेन द्विजजार्ढ्यकरं परं ।\nविड़ङ्गचूर्णं गोमूत्रं सर्व्वंत्र कृमिनाशने ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002234042, "chapter_id": 22234, "verse_number": "२७९-४३", "content_sanskrit": "धात्रीफलान्यथाज्यञ्च शिरोलेपनमुत्तमम् ।\nशिरोरोगविनाशाय स्रिग्धमुष्णञ्च भोजनम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002234043, "chapter_id": 22234, "verse_number": "२७९-४४", "content_sanskrit": "तैलं वा वस्तमूत्रञ्च कर्णपूरणमुत्तमम् ।\nकर्णशूलविनाशाय सर्वशुक्तानि वा द्विज ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002234044, "chapter_id": 22234, "verse_number": "२७९-४५", "content_sanskrit": "गिरिमृच्चन्दनं लाक्षा मालती कलिका तथा ।\nसंयोज्या या कृता वर्त्तिः क्षतशुक्रहरी तु सा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002234045, "chapter_id": 22234, "verse_number": "२७९-४६", "content_sanskrit": "व्योषं त्रिफलया युक्तं तुच्छकञ्च तथा जलम् ।\nसर्वाक्षिरोगशमनं तथा चैव रसाञ्जनम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002234046, "chapter_id": 22234, "verse_number": "२७९-४७", "content_sanskrit": "आज्यभृष्टं शिलापिष्टं लोध्रकाञ्जीकसैन्धवैः ।\nआश्च्योतनाविनाशाय सर्वनेत्रामये हितम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002234047, "chapter_id": 22234, "verse_number": "२७९-४८", "content_sanskrit": "गिरिमृच्चन्दनैर्लेपो वरिर्नेत्रस्य शस्यते ।\nनेत्रामयविघातार्थं त्रिफलां शीलयेत् सदा ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002234048, "chapter_id": 22234, "verse_number": "२७९-४९", "content_sanskrit": "रात्रौ तु मधुसर्पिभ्यां दीर्घमायुर्ज्जिजीविषुः ।\nशतावरीरसे सिद्धौ वृष्यौ क्षीरघृतौ स्मृतौ ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002234049, "chapter_id": 22234, "verse_number": "२७९-५०", "content_sanskrit": "कलम्बिकानि माषाश्च वृष्यौ क्षीरघृतौ तथा ।\nआयुष्या त्रिफला ज्ञेया पूर्ववन्मधुकान्विता ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002234050, "chapter_id": 22234, "verse_number": "२७९-५१", "content_sanskrit": "मधुकादिरसोपेता बलीपलितनाशिनी ।\nवचासिद्धघृतं विप्रं भूतदोषविनाशनम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002234051, "chapter_id": 22234, "verse_number": "२७९-५२", "content_sanskrit": "कव्यं बुद्धिप्रदञ्चैव तथा सर्वार्थसाधनम् ।\nवलाकल्ककषायेण सिद्धमभ्यञ्जने हितम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002234052, "chapter_id": 22234, "verse_number": "२७९-५३", "content_sanskrit": "रास्नासहचरैर्वापि तैलं वातविकारिणाम् ।\nअनभिष्यन्दि यच्चान्नं तद्व्रणेषु प्रशस्यते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002234053, "chapter_id": 22234, "verse_number": "२७९-५४", "content_sanskrit": "शक्तुपिण्डी तथैवाम्ला पाचनाय प्रशस्यते ।\nपक्कस्य च तथा भेदे निम्बचूर्णञ्च रोपणे ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002234054, "chapter_id": 22234, "verse_number": "२७९-५५", "content_sanskrit": "तथा शूच्युपचारश्च बलिकर्म विशेषतः ।\nसूतिका च तथा रक्षा प्राणिनान्तु सदा हिता ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002234055, "chapter_id": 22234, "verse_number": "२७९-५६", "content_sanskrit": "भक्षणं निम्बपत्राणां सर्पदष्टस्य भेषजम् ।\nतालनिम्बदलङ्केश्यं जीर्णन्तैलं यवा घृतम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002234056, "chapter_id": 22234, "verse_number": "२७९-५७", "content_sanskrit": "धूपो वृश्चिकदष्टस्य शिखिपत्रघृतेन वा ।\nअर्कक्षीरेण संपिष्टं लोपा वीजं पलाशजं ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002234057, "chapter_id": 22234, "verse_number": "२७९-५८", "content_sanskrit": "वृश्चिकार्त्तस्य कृष्णा वा शिवा च फलसंयुता ।\nअर्कक्षीरं लितं तैल पललञ्च गुड़ं समम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002234058, "chapter_id": 22234, "verse_number": "२७९-५९", "content_sanskrit": "पानाज्जयति दुर्बारं श्वविषं शीघ्रमेव तु ।\nपीत्वा मूलं त्रिवृत्तुल्यं तण्डुलीयस्य सर्पिषा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002234059, "chapter_id": 22234, "verse_number": "२७९-६०", "content_sanskrit": "सर्पकीटविषाण्याशु जयत्यतिबलान्यपि ।\nचन्दनं पद्मकङ्कुष्ठं तलाम्बूशीरपाटलाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002234060, "chapter_id": 22234, "verse_number": "२७९-६१", "content_sanskrit": "निर्गुण्डी शारिवा सेलुर्लूताविषहरो गदः ।\nशिरोविरेचनं शस्तं गुड़नागरकं द्विज ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002234061, "chapter_id": 22234, "verse_number": "२७९-६२", "content_sanskrit": "स्नेहपाने तथा वस्तौ तैलं घृतमनुत्तमम् ।\nस्वेदनीयः परो वह्निः शीताम्भः स्तम्भनं परम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002234062, "chapter_id": 22234, "verse_number": "२७९-६३", "content_sanskrit": "त्रिवृद्धि रेचने श्रेष्ठा वमने मदनं तथा ।\nवस्तिर्विरेको वमनं तैलं सर्पिस्तथा मधु ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002234063, "chapter_id": 22234, "verse_number": "२७९-६४", "content_sanskrit": "वातपित्तबलाशानां क्रमेण परमौषधं ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}]