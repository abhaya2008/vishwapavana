[{"id": 7001729000, "chapter_id": 21729, "verse_number": "१-११५-१", "content_sanskrit": "सनातन उवाच ।\nश्रृणु विप्र प्रवक्ष्यामि षष्ठ्याश्चैव व्रतानि ते ।\nयानि सम्यग्विधायात्र लभेत्सर्वान्मनोरथान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001729001, "chapter_id": 21729, "verse_number": "१-११५-२", "content_sanskrit": "चैत्रमासे शुक्लषष्ठ्यां कुमारव्रतमुत्तमम् ।\nतत्रेष्ट्वा षण्मुखं देवं नानापूजा विधानतः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001729002, "chapter_id": 21729, "verse_number": "१-११५-३", "content_sanskrit": "पुत्रं सर्वगुणोपेतं प्राप्नुयाच्चिरजीविनम् ।\nवैशाखशुक्लषष्ठ्यां च पूजयित्वा च कार्तिकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001729003, "chapter_id": 21729, "verse_number": "१-११५-४", "content_sanskrit": "लभते मातृजं सौख्यं नात्र कार्या विचारणा ।\nज्येष्ठमासे शुक्लषष्ठ्यां विधिनेष्ट्वा दिवाकरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001729004, "chapter_id": 21729, "verse_number": "१-११५-५", "content_sanskrit": "लभते वांछितान्कामांस्तत्प्रसादान्न संशयः ।\nआषाढशुक्लषष्ठ्यां वै स्कंदव्रतमनुत्तमम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001729005, "chapter_id": 21729, "verse_number": "१-११५-६", "content_sanskrit": "उपोष्य पूजयित्वैनं शिवोमाप्रियमात्मजम् ।\nलभतेऽभीप्सितान्कामान्पुत्रपौत्रादिसंततीः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001729006, "chapter_id": 21729, "verse_number": "१-११५-७", "content_sanskrit": "श्रावणे शुक्लषष्ठ्यां तु शरजन्मानमर्चयेत् ।\nउपचारैः षोडशभिर्भक्त्या परमयान्वितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001729007, "chapter_id": 21729, "verse_number": "१-११५-८", "content_sanskrit": "लभतेऽभीप्सितानर्थान्षण्मुखस्य प्रसादतः ।\nभाद्रमासे कृष्णषष्ट्यां ललिताव्रतमुच्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001729008, "chapter_id": 21729, "verse_number": "१-११५-९", "content_sanskrit": "प्रातः स्नात्वा विधानेन नारी शुक्लाम्बरावृता ।\nशुक्लमाल्ययधरा वापि नद्याः संगमवालुकाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001729009, "chapter_id": 21729, "verse_number": "१-११५-१०", "content_sanskrit": "गृहीत्वा वंशपात्रे तु धृत्वा पिंडाकृतिं च ताम् ।\nपञ्चधा ललितां तत्र ध्यायेद्वनविलासिनीम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001729010, "chapter_id": 21729, "verse_number": "१-११५-११", "content_sanskrit": "पङ्कजं करवीरं च नेपालीं मालतीं तथा ।\nनीलोत्पलं केतकीं च संगृह्य तगरं तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001729011, "chapter_id": 21729, "verse_number": "१-११५-१२", "content_sanskrit": "एकैकाष्टशतं ग्राह्यमष्टाविंशतिरेव च ।\nअक्षताः कलिका गृह्य ताभिर्देवीं प्रपूजयेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001729012, "chapter_id": 21729, "verse_number": "१-११५-१३", "content_sanskrit": "प्रार्थयेदग्रतः स्थित्वा देवीं तां गिरिशप्रियाम् ।\nगंगाद्वारे कुशावर्त्ते विल्वके नीलपर्वते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001729013, "chapter_id": 21729, "verse_number": "१-११५-१४", "content_sanskrit": "स्नात्वा कनखले देवि हरिं लब्धवती पतिम् ।\nललिते सुभगं देवि सुखसौभाग्यदायिनि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001729014, "chapter_id": 21729, "verse_number": "१-११५-१५", "content_sanskrit": "अनंतं देहि सौभाग्ये मह्यं तुभ्यं नमोऽनमनः ।\nमंत्रेणानेन कुसुमैश्वंपकस्य सुशोभनैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001729015, "chapter_id": 21729, "verse_number": "१-११५-१६", "content_sanskrit": "अभ्यर्च्य विधिवत्तस्या नैवेद्यं पुरतो न्यसेत् ।\nत्रपुषैरपि कूष्माण्डैर्नालिकेरैः सुदाडिमैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001729016, "chapter_id": 21729, "verse_number": "१-११५-१७", "content_sanskrit": "बीजपूरैः सुतुंडीरैः कारवेल्लैः सचिर्भटैः ।\nफलैस्तत्कालसंभूतैः कृत्वा शोभां तदग्रतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001729017, "chapter_id": 21729, "verse_number": "१-११५-१८", "content_sanskrit": "विरूढधान्यांकुरकैः सुदीपावलिभिस्तथा ।\nसार्द्धै सर्गणकैधूपः सौहालककरंजकैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001729018, "chapter_id": 21729, "verse_number": "१-११५-१९", "content_sanskrit": "गुडपुष्पैः कर्णवेष्टैर्मोदकैरुपमोदकैः ।\nबहुप्रकारैर्नैवेद्यैर्यथा विभवसारतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001729019, "chapter_id": 21729, "verse_number": "१-११५-२०", "content_sanskrit": "एवमभ्यर्च्य विधिवद्रात्रौ जागरणोत्सवम् ।\nगीतवाद्यनटैर्नृत्यैः प्रोक्षणीयैरनेकधा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001729020, "chapter_id": 21729, "verse_number": "१-११५-२१", "content_sanskrit": "सखीभिः सहिता साध्वी तां रात्रिं प्रसभं नयेत् ।\nन च संमीलयेन्नेत्रे नारीयामचतुष्टयम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001729021, "chapter_id": 21729, "verse_number": "१-११५-२२", "content_sanskrit": "दुर्भगा दुष्कृता वंध्या नेत्रसंमीलनाद्भवेत् ।\nएवं जागरणं कृत्वा सप्तम्यां सरितं नयेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001729022, "chapter_id": 21729, "verse_number": "१-११५-२३", "content_sanskrit": "गन्धपुष्पैस्तथाभ्यर्च्य गीतवाद्यपुरःसरैः ।\nतच्च दद्याद्द्विजेन्द्राय नैवेद्यादि द्विजोत्तम ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001729023, "chapter_id": 21729, "verse_number": "१-११५-२४", "content_sanskrit": "स्नात्वा गृहं समागत्य हुत्वा वैश्वानरं ततः ।\nदेवान्पितॄन्मनुष्यांश्च पूजयित्वा सुवासिनीः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001729024, "chapter_id": 21729, "verse_number": "१-११५-२५", "content_sanskrit": "कन्यकाश्चैव संभोज्य ब्राह्मणान्दश पंच च ।\nभक्ष्यभोज्यैर्बहुविधैर्दत्वा दानानि भूरिशः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001729025, "chapter_id": 21729, "verse_number": "१-११५-२६", "content_sanskrit": "ललिता मेऽस्तु सुप्रीता इत्युक्त्वा तान्विसर्जयेत् ।\nयः कश्चिदाचरेदेतद्व्रतं सौभाग्यदं परम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001729026, "chapter_id": 21729, "verse_number": "१-११५-२७", "content_sanskrit": "नरो वा यदि वा नारी तस्य पुण्यफलं श्रृणु ।\nयद्व्रतैश्च तपोभिश्च दानैर्वा नियमैरपि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001729027, "chapter_id": 21729, "verse_number": "१-११५-२८", "content_sanskrit": "तदेतेनेह लभ्येत किं बहूक्तेन नारद ।\nमृतेरनंतरं प्राप्य शिवलोकं सनातनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001729028, "chapter_id": 21729, "verse_number": "१-११५-२९", "content_sanskrit": "मोदते ललितादेव्या शैवे वै सखिवच्चिरम् ।\nनभस्ये मासि या शुक्ला षष्ठी सा चंदनाह्वया ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001729029, "chapter_id": 21729, "verse_number": "१-११५-३०", "content_sanskrit": "तस्यां देवीं समभ्यर्च्य लभते तत्सलोकताम् ।\nरोहिणी पातभौमैस्तु संयुता कपिला भवेत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001729030, "chapter_id": 21729, "verse_number": "१-११५-३१", "content_sanskrit": "तस्यां रविं समभ्यर्च्य व्रती नियमतत्परः ।\nलभते वांछितान्कामान्भास्करस्य प्रसादतः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001729031, "chapter_id": 21729, "verse_number": "१-११५-३२", "content_sanskrit": "अन्नदानं जपो होमं पितृदेवर्षितर्पणम् ।\nसर्वमेवाक्षयं ज्ञेयं कृतं देवर्षिसत्तम ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001729032, "chapter_id": 21729, "verse_number": "१-११५-३३", "content_sanskrit": "कपिलां धेनुमभ्यर्च्य वस्त्रमाल्यानुलेपनैः ।\nप्रदद्याद्वेदविदुषे द्वादशात्मप्रतुष्टये ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001729033, "chapter_id": 21729, "verse_number": "१-११५-३४", "content_sanskrit": "अथेषुशुक्लषष्ठ्यां तु पूज्या कात्यायनी द्विज ।\nगंधाद्यैर्मंङ्गलद्रव्यैर्नैवेद्यैर्विविधैस्तथा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001729034, "chapter_id": 21729, "verse_number": "१-११५-३५", "content_sanskrit": "ततः क्षमाप्य देवेशीं प्रणिपत्य विसर्जयेत् ।\nपूज्यात्र सैकती मूर्तिर्यद्वा द्विजसती मुदा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001729035, "chapter_id": 21729, "verse_number": "१-११५-३६", "content_sanskrit": "वस्त्रालंकरणैर्भव्यैः कात्यायिन्याः प्रतुष्टये ।\nकन्या वरं प्राप्नुयाच्च वांचितं पुत्रमंगना ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001729036, "chapter_id": 21729, "verse_number": "१-११५-३७", "content_sanskrit": "कात्यायिनीप्रसादाद्वै नात्र कार्या विचारणा ।\nकार्तिके शुक्लषष्ठ्यां तु षण्मुखेन महात्मना ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001729037, "chapter_id": 21729, "verse_number": "१-११५-३८", "content_sanskrit": "देवसेना महाभागा लब्धा सर्वुसुरार्पिता ।\nअतस्तस्यां सुरश्रेष्ठां देवसेनां च षण्मुखम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001729038, "chapter_id": 21729, "verse_number": "१-११५-३९", "content_sanskrit": "संपूज्य निखिलैरेव उपचारैर्मनोहरैः ।\nप्राप्नुयादतुलां सिद्धिं मनोभीष्टां द्विजोत्तम ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001729039, "chapter_id": 21729, "verse_number": "१-११५-४०", "content_sanskrit": "अत्रैव वह्निपूजोक्तां तां च सम्पक्समाचरेत् ।\nविविधद्रव्यहोमैश्च वह्निपूजापुरः सरम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001729040, "chapter_id": 21729, "verse_number": "१-११५-४१", "content_sanskrit": "मार्गशीर्षे शक्लषष्ठ्यां निहतस्तारकासुरः ।\nस्कंदेन सत्कृतिः प्राप्ता ब्रहमाद्यैः परिकल्पिता ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001729041, "chapter_id": 21729, "verse_number": "१-११५-४२", "content_sanskrit": "ततोऽस्यां पूजयेत्स्कंदं गंधपुष्पाक्षतैः फलैः ।\nवस्त्रैराभूषणश्चापि नैवेद्यैर्विविधैस्तथा ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001729042, "chapter_id": 21729, "verse_number": "१-११५-४३", "content_sanskrit": "रविवारेण संयुक्ता तथा शतभिषान्विता ।\nयदि चेत्सा समुद्दिष्टा चंपाह्वा मुनिसत्तम ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001729043, "chapter_id": 21729, "verse_number": "१-११५-४४", "content_sanskrit": "तस्यां विश्वेश्वरो देवो द्रष्टव्यः पापनाशनः ।\nपूजनीयो वेदनीयः स्मर्तव्यः सौख्यमिच्छता ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001729044, "chapter_id": 21729, "verse_number": "१-११५-४५", "content_sanskrit": "स्नानदानादिकं चात्र सर्वमक्षय्यमुच्यते ।\nपौषमासे शुक्लषष्ठ्यां देवो दिनपतिर्द्विज ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001729045, "chapter_id": 21729, "verse_number": "१-११५-४६", "content_sanskrit": "विष्णुरूपी जगत्त्राता प्रदुर्भूताः सनातनः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001729046, "chapter_id": 21729, "verse_number": "१-११५-४७", "content_sanskrit": "स तस्मात्पूजनीयोऽस्यां द्रव्यैर्गंधपुरस्कृतैः ।\nनैवेद्यैर्वस्त्त्रभूषाद्यैः सर्वसौख्यमभीप्सुभिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001729047, "chapter_id": 21729, "verse_number": "१-११५-४८", "content_sanskrit": "माघमासे सिता षष्ठी वरुणाह्वा स्मृता तु सा ।\nतस्यां वरुणमभ्यर्च्येद्विष्णुरूपं सनातनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001729048, "chapter_id": 21729, "verse_number": "१-११५-४९", "content_sanskrit": "रक्तैर्गंधांशुकैः पुष्पैर्नैवेद्यैर्धूपदीपकैः ।\nएवमभ्यर्च्य विधिवद्यद्यच्चाभिलषेन्नरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001729049, "chapter_id": 21729, "verse_number": "१-११५-५०", "content_sanskrit": "तत्तच्च फलतो लब्ध्वा मोदते तत्प्रसादतः ।\nफाल्गुने शुक्लषष्ठ्यां तु देवं पशुपतिं द्विज ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001729050, "chapter_id": 21729, "verse_number": "१-११५-५१", "content_sanskrit": "मृन्मयं विधिना कृत्त्वा पूजयेदुपचारकैः ।\nसंस्नाप्य शतरुद्रेण पृथक्पंचामृतैर्जलैः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001729051, "chapter_id": 21729, "verse_number": "१-११५-५२", "content_sanskrit": "गन्धैरालिप्य सुश्वेतैरक्षतैः श्वेतपुष्पकैः ।\nबिल्वपत्रैश्च धत्तूरकुसुमैश्च फलैस्तथा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001729052, "chapter_id": 21729, "verse_number": "१-११५-५३", "content_sanskrit": "सम्पूज्य नानानैवेद्यैर्नीराज्य विधिवत्ततः ।\nक्षमाप्य प्रणिपत्यैनं कैलासाय विसर्जयेत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001729053, "chapter_id": 21729, "verse_number": "१-११५-५४", "content_sanskrit": "एवं कृत शिवार्चस्तु नरो नार्यथवा मुने ।\nइह भुक्त्वा वरान्भोगानन्ते शिवगतिं लभेत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]