[{"id": 2029688, "chapter_id": 1647, "verse_number": "३-२८५-०x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2029689, "chapter_id": 1647, "verse_number": "३-२८५-१", "content_sanskrit": "प्रभूतान्नोदकेतस्मिन्बहुमूलफले वने।\nसेनां निवेश्य काकुत्स्थो विधिवत्पर्यरक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2029690, "chapter_id": 1647, "verse_number": "३-२८५-२", "content_sanskrit": "रावणः संविधं चक्रे लङ्कायां शास्त्रनिर्मिताम्।\nप्रकृत्यैवदुराधर्षा दृढप्राकारतोरणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2029691, "chapter_id": 1647, "verse_number": "३-२८५-३", "content_sanskrit": "अगाधतोयाः परिखा मीननक्रसमाकुलाः।\nबभूवुः सप्त दुर्धर्षाः स्वादिरैः शङ्कुभिश्चिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2029692, "chapter_id": 1647, "verse_number": "३-२८५-४", "content_sanskrit": "कर्णाटयन्त्रा दुर्धर्षा बभूवुः सहुडोपलाः।\nसाशीविषघटायोधाः ससर्जरसपांसवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2029693, "chapter_id": 1647, "verse_number": "३-२८५-५", "content_sanskrit": "मुसलालातनाराचतोमरासिपरश्वथैः।\nअन्विताश्चशतघ्नीभिः समधूच्छिष्टमुद्गराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2029694, "chapter_id": 1647, "verse_number": "३-२८५-६", "content_sanskrit": "पुरद्वारेषु सर्वेषु गुल्माः स्थावरजङ्गमाः।\nबभूवुः पत्तिबहुलाः प्रभूतगजवाजिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2029695, "chapter_id": 1647, "verse_number": "३-२८५-७", "content_sanskrit": "अङ्गदस्त्वथ लङ्कायां द्वारदेशमुपागतः।\nविदितो रराक्षसेन्द्रस्य प्रविवेशगतव्यथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2029696, "chapter_id": 1647, "verse_number": "३-२८५-८", "content_sanskrit": "मध्ये राक्षसकोटीनां बह्वीनां सुमहाबलः।\nशुशुभे मेघमालाभिरादित्य इव संवृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2029697, "chapter_id": 1647, "verse_number": "३-२८५-९", "content_sanskrit": "ससमासाद्य पौलस्त्यममात्यैरभिसंवृतम्।\nरामसंदेशमामन्त्र्य वाग्मी वक्तुं प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2029698, "chapter_id": 1647, "verse_number": "३-२८५-१०", "content_sanskrit": "आह त्वां राघवो राजन्कोसलेन्द्रो महायशाः।\nप्राप्तकालमिदं वाक्यं तदादत्स्व सुदुर्मते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2029699, "chapter_id": 1647, "verse_number": "३-२८५-११", "content_sanskrit": "अकृतात्मानमासाद्य राजानमनये रतम्।\nविनश्यन्त्यनयाविष्टा देशाश्च नगराणि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2029700, "chapter_id": 1647, "verse_number": "३-२८५-१२", "content_sanskrit": "त्वयैकेनापराद्धं मे सीतामाहरता बलात्।\nवधायानपराद्धानामन्येषां तद्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2029701, "chapter_id": 1647, "verse_number": "३-२८५-१३", "content_sanskrit": "ये त्वया बलदर्पाभ्यामाविष्टेन वनेचराः।\nऋषयोहिंसिताः पूर्वंदेवाश्चाप्यवमानिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2029702, "chapter_id": 1647, "verse_number": "३-२८५-१४", "content_sanskrit": "राजर्षयश्च निहता रुदत्यश्चाहृताः स्त्रियः।\nतदिदं समनुप्राप्तं फलंतस्यानयस्य ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2029703, "chapter_id": 1647, "verse_number": "३-२८५-१५", "content_sanskrit": "हन्तास्मि त्वां सहामात्यैर्युध्यस्व पुरुषो भव।\nपश्य मे धनुषो वीर्यं मानुषस् निशाचर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2029704, "chapter_id": 1647, "verse_number": "३-२८५-१६", "content_sanskrit": "मुच्यतां जानकी सीता न मे मोक्ष्यमसि कर्हिचित्।\nअराक्षसमिमं लोकंकर्ताऽस्मि निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2029705, "chapter_id": 1647, "verse_number": "३-२८५-१७", "content_sanskrit": "इतितस् ब्रुवाणस् दूतस् परुषं वचः।\nश्रुत्वा न ममृषे राजा रावणः क्रोधमूर्च्छितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2029706, "chapter_id": 1647, "verse_number": "३-२८५-१८", "content_sanskrit": "हङ्गितज्ञास्ततो भर्तुश्चत्वारो रजनीचराः।\nचतुर्ष्वङ्गेषु जगृहुः शार्दूलमिव पक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2029707, "chapter_id": 1647, "verse_number": "३-२८५-१९", "content_sanskrit": "तांस्तथाङ्गेषु संसक्तानङ्गदो रजनीचरान्।\nआदायैव खमुत्पत्य प्रासादतलमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2029708, "chapter_id": 1647, "verse_number": "३-२८५-२०", "content_sanskrit": "वेगेनोत्पततस्तस्य पेतुस्ते रजनीचराः।\nभुवि संभिन्नहृदयाः प्रहारवरपीडिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2029709, "chapter_id": 1647, "verse_number": "३-२८५-२१", "content_sanskrit": "संसक्तोहर्म्यशिखरात्तस्मात्पुनरवापतत्।\nलङ्घयित्वा पुरं लङ्कां सुवेलस्य समीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2029710, "chapter_id": 1647, "verse_number": "३-२८५-२२", "content_sanskrit": "कोसलेन्द्रमथागम्य सर्वमावेद्य वानरः।\nविशश्राम स तेजस्वी राघवेणाभिनन्दितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2029711, "chapter_id": 1647, "verse_number": "३-२८५-२३", "content_sanskrit": "ततः सर्वाभिसारेण हरीणां वातरंहसाम्।\nभेदयामास लङ्कायाः ग्राकारं रघुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2029712, "chapter_id": 1647, "verse_number": "३-२८५-२४", "content_sanskrit": "विभीषणर्क्षाधिपती पुरस्कृत्याथ लक्ष्मणः।\nदक्षिणं नगरद्वारमवामृद्गाद्दुरासदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2029713, "chapter_id": 1647, "verse_number": "३-२८५-२५", "content_sanskrit": "करभारुणगात्राणां हरीणां युद्धशालिनाम्।\nकोटीशतसहस्रेण लङ्कामभ्यपतत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2029714, "chapter_id": 1647, "verse_number": "३-२८५-२६", "content_sanskrit": "प्रलम्बबाहूरुकरजङ्घान्तरविलम्बिनाम्।\nऋक्षाणआं धूम्रवर्णानां तिस्रः कोठ्यो व्यवस्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2029715, "chapter_id": 1647, "verse_number": "३-२८५-२७", "content_sanskrit": "उत्पतद्भिः पतद्भिश्च निपतद्भिश्च वानरैः।\nनादृश्यत तदा सूर्यो रजसा नाशितप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2029716, "chapter_id": 1647, "verse_number": "३-२८५-२८", "content_sanskrit": "शालिप्रसूनसदृशैः शिरीपकुसुमप्रभैः।\nतरुणादित्यसदृशैः शणगौरैश्च वैनरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2029717, "chapter_id": 1647, "verse_number": "३-२८५-२९", "content_sanskrit": "प्राकारं ददृशुस्ते तु समन्तात्कपिलीकृतम्।\nराक्षसा विस्मिता राजन्सस्त्रीवृद्धाः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2029718, "chapter_id": 1647, "verse_number": "३-२८५-३०", "content_sanskrit": "बिभिदुस्ते मणिस्तम्भान्कर्णाट्टशिखराणि च।\nभग्नोन्मथितशृङ्गाणि यन्त्राणि च विचिक्षिपुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2029719, "chapter_id": 1647, "verse_number": "३-२८५-३१", "content_sanskrit": "परिगृह्य शतघ्नीश्च सचक्राः सगुडोपलाः।\nचिक्षिपुर्भुजवेगेन लङ्कामध्येमहास्वनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2029720, "chapter_id": 1647, "verse_number": "३-२८५-३२", "content_sanskrit": "प्राकारस्थाश्चये केचिन्निशाचरगणास्तथा।\nप्रदुद्रुवुस्ते शतशः कपिभिः समभिद्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2029721, "chapter_id": 1647, "verse_number": "३-२८५-३३", "content_sanskrit": "ततस्तु राजवचनाद्राक्षसाः कामरूपिणः।\nनिर्ययुर्विकृताकाराः सहस्रशतसङ्घशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2029722, "chapter_id": 1647, "verse_number": "३-२८५-३४", "content_sanskrit": "शखवर्षाणि वर्षन्तो द्रावयित्वा वनौकसः।\nप्राकारं शोभयन्तस्ते परं विस्मयमास्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2029723, "chapter_id": 1647, "verse_number": "३-२८५-३५", "content_sanskrit": "स मापराशिसदृशैर्बभूव क्षणादाचरैः।\nकृतो निर्वानरो भूयः प्राकारो भीमदर्शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2029724, "chapter_id": 1647, "verse_number": "३-२८५-३६", "content_sanskrit": "पेतुः शलविभिन्नाङ्गा बहवो वानरर्पभाः।\nस्तम्भतोरणभग्नाश्चपेतुस्तत्रनिशाचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2029725, "chapter_id": 1647, "verse_number": "३-२८५-३७", "content_sanskrit": "केशाकेश्यभवद्युद्धं रक्षसां वानरैः सह।\nनखैर्दन्तैश्च वीराणां खादतां वै परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2029726, "chapter_id": 1647, "verse_number": "३-२८५-३८", "content_sanskrit": "निष्टनन्तो ह्युभयतस्तत्र वानरराक्षसाः।\nहतानिपतिता भूमौ न मुञ्चन्ति परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2029727, "chapter_id": 1647, "verse_number": "३-२८५-३९", "content_sanskrit": "रामस्तु शरजालानिववर्ष जलदो यथा।\nतानिलङ्कां समासाद्य जघ्रुस्तान्रजनीचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2029728, "chapter_id": 1647, "verse_number": "३-२८५-४०", "content_sanskrit": "सौमित्रिरपि नाराचैर्दृढधन्वा जितक्लमः।\nआदिश्यादिश्य दुर्गस्थान्पातयामास राक्षसान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2029729, "chapter_id": 1647, "verse_number": "३-२८५-४१", "content_sanskrit": "ततः प्रत्यवहारोऽभूत्सैन्यानां राधवाज्ञया।\nकृते विमर्दे लङ्कायां लब्धलक्ष्योजयोत्तरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2029730, "chapter_id": 1647, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि रामोपाख्यानपर्वणि पञ्चाशीत्यधिकाद्विशततमोऽध्यायः ॥ २८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]