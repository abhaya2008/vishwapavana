[{"id": 2210000, "chapter_id": 5492, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210001, "chapter_id": 5492, "verse_number": "१", "content_sanskrit": "शकुनेस्तनयो वीरो गान्धाराणां महारथः ।\nप्रत्युद्ययौ गुडाकेशं सैन्येन महता वृतः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210002, "chapter_id": 5492, "verse_number": "२", "content_sanskrit": "हस्त्यश्वरथपूर्णेण पताकाध्वजमालिना ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210003, "chapter_id": 5492, "verse_number": "३", "content_sanskrit": "अमृष्यमाणास्ते योधा नृपतेः शकुनेर्वधम् ।\nअभ्ययुः सहिताः पार्थं प्रगृहीतशरासनाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210004, "chapter_id": 5492, "verse_number": "४", "content_sanskrit": "तानुवाच स धर्मात्मा बीभत्सुरपराजितः ।\nयुधिष्ठिरस्य वचनं न च ते जगृहुस्तदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210005, "chapter_id": 5492, "verse_number": "५", "content_sanskrit": "वार्यमाणास्तु पार्थेन सान्त्वपूर्वममर्षिताः ।\nपरिवार्य हयं जह्रुस्ततश्चुक्रोध पाण्डवः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210006, "chapter_id": 5492, "verse_number": "६", "content_sanskrit": "ततः शिरांसि दीप्ताग्रैस्तेषां चिच्छेद पाण्डवः ।\nशनैर्गाण्डीवनिर्मुक्तैर्नातियत्नादिवार्जुनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210007, "chapter_id": 5492, "verse_number": "७", "content_sanskrit": "ते वध्यमानाः पार्थेन हयमुत्सृज्य सम्भ्रमात् ।\nन्यवर्तन्त महाराज शरवर्षार्दिता भृशम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210008, "chapter_id": 5492, "verse_number": "८", "content_sanskrit": "विरुद्ध्यमानस्तैश्चापि गान्धारैः पाण्डवर्षभः ।\nआदिश्यादिश्य तेजस्वी परानेव न्यपातयत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210009, "chapter_id": 5492, "verse_number": "९", "content_sanskrit": "वध्यमानेषु तेष्वाजौ गान्धारेषु समन्ततः ।\nस राजा शकुनेः पुत्रः पाण्डवं प्रत्यवारयत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210010, "chapter_id": 5492, "verse_number": "१०", "content_sanskrit": "तं युध्यमानं राजानं क्षत्रधर्मे व्यवस्थितम् ।\nपार्थोऽब्रवीन्न मे वध्या राजानो राजशासनात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210011, "chapter_id": 5492, "verse_number": "११", "content_sanskrit": "अलं युद्धेन ते वीर न तेऽद्यास्ति पराजयः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210012, "chapter_id": 5492, "verse_number": "१२", "content_sanskrit": "इत्युक्तस्तदनादृत्य वाक्यमज्ञानमोहितः ।\nस शक्रसमकर्माणमवाकिरत सायकैः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210013, "chapter_id": 5492, "verse_number": "१३", "content_sanskrit": "तस्य पार्थः शिरस्त्राणमर्धचन्द्रेण पत्रिणा ।\nअपाहरदमेयात्मा जयद्रथशिरो यथा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210014, "chapter_id": 5492, "verse_number": "१४", "content_sanskrit": "तं दृष्ट्वा विस्मयं जग्मुर्गान्धाराः सर्व एव ते ।\nइच्छता तेन न हतो राजेत्यपि च ते विदुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210015, "chapter_id": 5492, "verse_number": "१५", "content_sanskrit": "गान्धारराजपुत्रस्तु पलायनकृतक्षणः ।\nबभौ तैरेव सहितस्त्रस्तैः क्षुद्रमृगैरिव ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210016, "chapter_id": 5492, "verse_number": "१६", "content_sanskrit": "तेषां तु तरसा पार्थस्तत्रैव परिधावताम् ।\nविजहारोत्तमाङ्गानि भल्लैः सन्नतपर्वभिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210017, "chapter_id": 5492, "verse_number": "१७", "content_sanskrit": "उच्छ्रितांश्च भुजान् केचिन्नाबुध्यन्त शरैर्हतान् ।\nशितैर्गाण्डीवनिर्मुक्तैः पृथुभिः पार्थचोदितैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210018, "chapter_id": 5492, "verse_number": "१८", "content_sanskrit": "सम्भ्रान्तनरनागाश्वमथ तद् विद्रुतं बलम् ।\nहतविध्वस्तभूयिष्ठमवर्तत मुहुर्मुहुः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210019, "chapter_id": 5492, "verse_number": "१९", "content_sanskrit": "न ह्यदृश्यन्त वीरस्य केचिदग्रेऽग्र्यकर्मणः ।\nरिपवः पात्यमाना वै ये सहेरन् महाशरान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2210020, "chapter_id": 5492, "verse_number": "२०", "content_sanskrit": "ततो गान्धारराजस्य मन्त्रिवृद्धपुरःसरा ।\nजननी निर्ययौ भीता पुरस्कृत्यार्घ्यमुत्तमम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2210021, "chapter_id": 5492, "verse_number": "२१", "content_sanskrit": "सा न्यवारयदव्यग्रा तं पुत्रं युद्धदुर्मदम् ।\nप्रसादयामास च तं जिष्णुमक्लिष्टकर्मिणम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2210022, "chapter_id": 5492, "verse_number": "२२", "content_sanskrit": "तां पूजयित्वा कौन्तेयः प्रसादमकरोत् तदा ।\nशकुनेश्चापि तनयं सान्त्वयन्निदमब्रवीत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2210023, "chapter_id": 5492, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2210024, "chapter_id": 5492, "verse_number": "२३", "content_sanskrit": "न मे प्रियं महाबाहो यत् ते बुद्धिरियं कृता ।\nप्रतियोद्धुममित्रघ्न भ्रातैव त्वं ममानघ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2210025, "chapter_id": 5492, "verse_number": "२४", "content_sanskrit": "गान्धारीं मातरं स्मृत्वा धृतराष्ट्रकृतेन च ।\nतेन जीवसि राजंस्त्वं निहतास्त्वनुगास्तव ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2210026, "chapter_id": 5492, "verse_number": "२५", "content_sanskrit": "मैवं भूः शाम्यतां वैरं मा ते भूद् बुद्धिरीदृशी ।\nआगन्तव्यं परां चैत्रीमश्वमेधे नृपस्य नः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2210027, "chapter_id": 5492, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2210028, "chapter_id": 5492, "verse_number": "२६", "content_sanskrit": "इत्युक्त्वाऽनुययौ पार्थो हयं तं कामचारिणम् ।\nते न्यवर्तन्त गान्धारा हताशिष्टाः स्वकं पुरम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2210029, "chapter_id": 5492, "verse_number": "२७", "content_sanskrit": "न्यवर्तत ततो वाजी यत्र नागाह्वयं पुरम् ।\nतं निवृत्तं तु शुश्राव चारेणैव युधिष्ठिरः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2210030, "chapter_id": 5492, "verse_number": "२८", "content_sanskrit": "श्रुत्वाऽर्जुनं कुशलिनं स च हृष्टमना ह्यभूत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2210031, "chapter_id": 5492, "verse_number": "२९", "content_sanskrit": "विजयस्य च तत् कर्म गान्धारविषये तदा ।\nश्रुत्वा चान्येषु देशेषु स सुप्रीतोऽभवन्नृपः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2210032, "chapter_id": 5492, "verse_number": "३०", "content_sanskrit": "एतस्मिन्नेव काले तु द्वादशीं माघमासिकीम् ।\nइष्टं गृहीत्वा नक्षत्रं धर्मराजो युधिष्ठिरः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2210033, "chapter_id": 5492, "verse_number": "३१", "content_sanskrit": "समानाय्य महातेजाः सर्वान् भ्रातॄन् महामनाः ।\nभीमं च नकुलं चैव सहदेवं च कौरवम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2210034, "chapter_id": 5492, "verse_number": "३२", "content_sanskrit": "प्रोवाचेदं वचः काले तदा धर्मभृतां वरः ।\nआमन्त्र्य वदतां श्रेष्ठो भीमं भीमपराक्रमम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2210035, "chapter_id": 5492, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2210036, "chapter_id": 5492, "verse_number": "३३", "content_sanskrit": "आयाति भीमसेनासौ सहाश्वेन तवानुजः ।\nयथा मे पुरुषाः प्राहुर्ये धनञ्जयसारिणः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2210037, "chapter_id": 5492, "verse_number": "३४", "content_sanskrit": "उपस्थितश्च कालोऽयमभितो वर्तते हयः ।\nमाघी च पौर्णमासीयं मासः शेषो वृकोदर ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2210038, "chapter_id": 5492, "verse_number": "३५", "content_sanskrit": "प्रस्थाप्यन्तां हि विद्वांसो ब्राह्मणा वेदपारगाः ।\nवाजिमेधार्थसिद्ध्यर्थं देशं पश्यन्तु याज्ञियम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2210039, "chapter_id": 5492, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2210040, "chapter_id": 5492, "verse_number": "३६", "content_sanskrit": "इत्युक्तः स तु तच्चक्रे भीमो नृपतिशासनम् ।\nहृष्टः श्रुत्वा नरवरैरायान्तं सव्यसाचिनम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2210041, "chapter_id": 5492, "verse_number": "३७", "content_sanskrit": "ततो ययौ भीमसेनः प्राज्ञैः स्थपतिभिः सह ।\nब्राह्मणानग्रतः कृत्वा कुशलान् यज्ञकर्मसु ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2210042, "chapter_id": 5492, "verse_number": "३८", "content_sanskrit": "युतं सालवनग्रामं सुप्रतोलीविटङ्किनम् ।\nमापयामास कौरव्यो यज्ञवाटं यथाविधि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2210043, "chapter_id": 5492, "verse_number": "३९", "content_sanskrit": "प्रासादशतसम्बाधं मणिप्रवरकुट्टिमम् ।\nसदः सपत्नीसदनं साग्नीध्रमपि चोत्तरम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2210044, "chapter_id": 5492, "verse_number": "४०", "content_sanskrit": "कारयामास विधिवन्मणिहेमविभूषितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2210045, "chapter_id": 5492, "verse_number": "४१", "content_sanskrit": "स्तम्भान् कनकचित्रांश्च तोरणानि बृहन्ति च ।\nयज्ञायतनदेशेषु सर्वेष्वेव च काञ्चनम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2210046, "chapter_id": 5492, "verse_number": "४२", "content_sanskrit": "अन्तःपुराणि राज्ञां च नानादेशनिवासिनाम् ।\nकारयामास धर्मात्मा तत्र तत्र यथाविधि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2210047, "chapter_id": 5492, "verse_number": "४३", "content_sanskrit": "ब्राह्मणानां तु वेश्मानि नानादेशसमेयुषाम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2210048, "chapter_id": 5492, "verse_number": "४४", "content_sanskrit": "तथा सम्प्रेषयामास दूतान् नृपतिशासनात् ।\nभीमसेनो महाराज राज्ञामक्लिष्टकर्मणाम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2210049, "chapter_id": 5492, "verse_number": "४५", "content_sanskrit": "ते प्रियार्थं कुरुपतेराययुर्नृपसत्तमाः ।\nरत्नान्यनेकान्यादाय स्त्रियोऽश्वानायुधानि च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2210050, "chapter_id": 5492, "verse_number": "४६", "content_sanskrit": "तेषां निवसतां तेषु शिबिरेषु सहस्रशः ।\nनदतः सागरस्येव शब्दो दिवमिवास्पृशत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2210051, "chapter_id": 5492, "verse_number": "४७", "content_sanskrit": "प्रत्युद्गम्य नमस्कृत्य ब्राह्मणांश्च न्यवेदयत् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2210052, "chapter_id": 5492, "verse_number": "४८", "content_sanskrit": "तेषामभ्यागतानां च नानादेशनिवासिनाम् ।\nव्यादिदेशान्नपानानि शय्याश्चातीवमानुषाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2210053, "chapter_id": 5492, "verse_number": "४९", "content_sanskrit": "वाहनानां च विविधाः शालाः शालीक्षुगोरसैः ।\nउपेताः पुरुषव्याघ्र व्यादिदेश स धर्मराट् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2210054, "chapter_id": 5492, "verse_number": "५०", "content_sanskrit": "वर्णाः पृथक्सन्निविष्टा ह्युत्तरोत्तरपूजकाः ।\nतथा तस्मिन् महायज्ञे धर्मराजस्य धीमतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2210055, "chapter_id": 5492, "verse_number": "५१", "content_sanskrit": "समाजग्मुर्मुनिगणा बहवो ब्रह्मवादिनः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2210056, "chapter_id": 5492, "verse_number": "५२", "content_sanskrit": "ये च द्विजातिप्रवरास्तत्रासन् पृथिवीपते ।\nसमाजग्मुः सशिष्यास्तान् प्रतिजग्राह कौरवः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2210057, "chapter_id": 5492, "verse_number": "५३", "content_sanskrit": "सर्वांश्च ताननुययौ यावदावसथान्तिकम् ।\nस्वयमेव महातेजा दम्भं त्यक्त्वा युधिष्ठिरः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2210058, "chapter_id": 5492, "verse_number": "५४", "content_sanskrit": "ततः कृत्वा स्थपतयः शिल्पिनोऽन्ये च ते तदा ।\nकृत्स्नं यज्ञविधिं राजन् धर्मराज्ञे न्यवेदयन् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2210059, "chapter_id": 5492, "verse_number": "५५", "content_sanskrit": "तच्छ्रुत्वा धर्मराजः स कृतं सर्वमनिन्दितम् ।\nहृष्टरूपोऽभवद् राजा सह भ्रातृभिरच्युतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2210060, "chapter_id": 5492, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अश्वसम्भरणे शालानिर्माणकथनं नाम षडशीतितमोऽध्यायः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]