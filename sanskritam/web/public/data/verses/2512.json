[{"id": 2071701, "chapter_id": 2512, "verse_number": "१२-१७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071702, "chapter_id": 2512, "verse_number": "१२-१७-१", "content_sanskrit": "असंतोषः प्रमादश्च मदो रागोऽप्रशान्तता।\nबलं मोहोऽभिमानश्चाप्युद्वेगश्चैव सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071703, "chapter_id": 2512, "verse_number": "१२-१७-२", "content_sanskrit": "एभिः पाप्मभिराविष्टो राज्यं त्वमभिकाङ्क्षसे।\nनिरामिषो विनिर्मुक्तः प्रशान्तः सुसुखी भव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071704, "chapter_id": 2512, "verse_number": "१२-१७-३", "content_sanskrit": "य इमामखिलां भूमिं शिष्यादेको महीपतिः।\nतस्याप्युदरमेकं वै किमिदं त्वं प्रशंससि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071705, "chapter_id": 2512, "verse_number": "१२-१७-४", "content_sanskrit": "नाह्ना पूरयितुं शक्यां न मासैर्भरतर्षभ।\nअपूर्यां पूरयन्निच्छामायुषाऽपि न शक्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071706, "chapter_id": 2512, "verse_number": "१२-१७-५", "content_sanskrit": "यथेद्धः प्रज्वलत्यग्निरसमिद्धः प्रशाम्यति।\nअल्पाहारतयाग्निं त्वं शमयौदर्यमुत्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071707, "chapter_id": 2512, "verse_number": "१२-१७-६", "content_sanskrit": "आत्मोदरकृतेऽप्राज्ञः करोति विशसं बहु।\nजयोदरं पृथिव्या ते श्रेयो निर्जितया जितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071708, "chapter_id": 2512, "verse_number": "१२-१७-७", "content_sanskrit": "मानुषान्कामभोगांस्त्वमैश्वर्यं च प्रशंससि।\nअभोगिनोऽबलाश्चैव यान्ति स्थानमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071709, "chapter_id": 2512, "verse_number": "१२-१७-८", "content_sanskrit": "योगः क्षेमश्च राष्ट्रस्य धर्माधर्मौ त्वयि स्थितौ।\nमुच्यस्व महतो भारात्त्यागमेवाभिसंश्रय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071710, "chapter_id": 2512, "verse_number": "१२-१७-९", "content_sanskrit": "एकोदरकृते व्याघ्रः करोति विशसं बहु।\nतमन्येऽप्युपजीवन्ति मन्दवेगतरा मृगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071711, "chapter_id": 2512, "verse_number": "१२-१७-१०", "content_sanskrit": "विषयान्प्रतिसंगृह्य संन्यासे कुरुते मतिम्।\nन च तुष्यन्ति राजानः पश्य बुद्ध्यन्तरं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071712, "chapter_id": 2512, "verse_number": "१२-१७-११", "content_sanskrit": "पत्राहारैरश्मकुट्टैर्दन्तोलूखलिकैस्तथा।\nअब्भक्षैर्वायुभक्षैश्च तेरयं नरको जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071713, "chapter_id": 2512, "verse_number": "१२-१७-१२", "content_sanskrit": "यस्त्विमां वसुधां कृत्स्नां प्रशासेदखिलां नृपः।\nतुल्याश्मकाञ्चनो यश्च स कृतार्थो न पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071714, "chapter_id": 2512, "verse_number": "१२-१७-१३", "content_sanskrit": "संकल्पेषु निरारम्भो निराशीर्निर्ममो भव।\nअशोकं स्थानमातिष्ठ इह चामुत्र चाव्ययम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071715, "chapter_id": 2512, "verse_number": "१२-१७-१४", "content_sanskrit": "निरामिषा न शोचन्ति शोचन्ति त्वामिषैषिणः।\nपरित्यज्यामिषं सर्वं मृषावादात्प्रमोक्ष्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071716, "chapter_id": 2512, "verse_number": "१२-१७-१५", "content_sanskrit": "पन्थानौ पितृयानश्च देवयानश्च विश्रुतौ।\nईजानाः पितृयानेन देवयानेन मोक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071717, "chapter_id": 2512, "verse_number": "१२-१७-१६", "content_sanskrit": "तपसा ब्रह्मर्येण स्वाध्यायेन महर्षयः।\nविमुच्य देहांस्ते यान्ति मृत्योरविषयं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2071718, "chapter_id": 2512, "verse_number": "१२-१७-१७", "content_sanskrit": "आमिषं बन्धनं लोके कर्मेहोक्तं तथाऽऽमिषम्।\nताभ्यां विमुक्तः पापाभ्यां पदमाप्नोति तत्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2071719, "chapter_id": 2512, "verse_number": "१२-१७-१८", "content_sanskrit": "अपि गाथां पुरा गीतां जनकेन वदन्त्युत।\nनिर्द्वन्द्वेन विमुक्तेन मोक्षं समनुपश्यता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2071720, "chapter_id": 2512, "verse_number": "१२-१७-१९", "content_sanskrit": "अनन्तं बत मे वित्तं यस्य मे नास्ति किंचन।\nमिथिलायां प्रदीप्तायां न मे किंचित्प्रदह्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2071721, "chapter_id": 2512, "verse_number": "१२-१७-२०", "content_sanskrit": "प्रज्ञाप्रासादमारुह्य न शोचेच्छोचतो जनान्।\nजगतीस्थोऽथवाऽद्रिस्थो मन्दबुद्धिर्नचेक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2071722, "chapter_id": 2512, "verse_number": "१२-१७-२१", "content_sanskrit": "दृश्यं पश्यति यः पश्यन्स चक्षुष्मान्स बुद्धिमान्।\nअज्ञातानां च विज्ञानात्संबोधाद्रुद्धिरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2071723, "chapter_id": 2512, "verse_number": "१२-१७-२२", "content_sanskrit": "यस्तु मानं विजानाति बहुमानमियात्स वै।\nब्रह्मभावप्रभूतानां वैद्यानां भावितात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2071724, "chapter_id": 2512, "verse_number": "१२-१७-२३", "content_sanskrit": "यदा भूतपृथग्भावमेकस्थमनुपश्यति।\nतत एव च विस्तारं ब्रह्म संपद्यते तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2071725, "chapter_id": 2512, "verse_number": "१२-१७-२४", "content_sanskrit": "ते जनास्तां गतिं यान्ति नाविद्वांसोऽल्पचेतसः।\nनाबुद्धयो नातपसः सर्वं बुद्धौ प्रतिष्ठितम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2071726, "chapter_id": 2512, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि सप्तदशोऽध्यायः॥ १७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]