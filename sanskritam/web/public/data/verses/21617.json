[{"id": 7001617000, "chapter_id": 21617, "verse_number": "१-३-१", "content_sanskrit": "नारद उवाच ।\nकथं ससर्ज ब्रह्मादीनादिदेवः पुरा विभुः ।\nतन्ममाख्याहि सनक सर्वज्ञोऽस्ति यतो भवान् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001617001, "chapter_id": 21617, "verse_number": "१-३-२", "content_sanskrit": "श्रीसनक उवाचा ।\nनारायणोऽक्षरोऽनन्तः सर्वव्यापी निरञ्जनः ।\nतेनेदमखिलं व्याप्तं जगत्स्थावरजङ्गमम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001617002, "chapter_id": 21617, "verse_number": "१-३-३", "content_sanskrit": "आदिसर्गे महाविष्णुः स्वप्रकाशो जगन्मयः ।\nगुणभेदमधिष्ठाय मूर्त्तित्रिकमवासृजत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001617003, "chapter_id": 21617, "verse_number": "१-३-४", "content_sanskrit": "सृष्ट्यर्थं तु पुरा देवो दक्षिणाङ्गात्प्रजापतिम् ।\nमध्येरुद्राख्यमीथानं जगदन्तकरं मुने ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001617004, "chapter_id": 21617, "verse_number": "१-३-५", "content_sanskrit": "पालनायास्य जगतो वामाङ्गाद्विष्णुमव्ययम् ।\nतमादिदेवमजरं केचिदाहुः शिवाभिधम् ।\nकेचिद्विष्णुं सदा सत्यं ब्रह्माणं केचिदूचिरे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001617005, "chapter_id": 21617, "verse_number": "१-३-६", "content_sanskrit": "तस्य शक्तिः परा विष्णोर्जगत्कार्यप्रवर्तिनी ।\nभावाभावस्वरुपा सा विद्याविद्येति गीयते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001617006, "chapter_id": 21617, "verse_number": "१-३-७", "content_sanskrit": "यदा विश्वं महाविष्णोर्भिन्नत्वेन प्रतीयते ।\nतदा ह्यविद्या संसिद्धा भवेद्दुःखस्य साधनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001617007, "chapter_id": 21617, "verse_number": "१-३-८", "content_sanskrit": "ज्ञातृज्ञेयाद्युपाधिस्ते यदा नश्यति नारद ।\nसर्वैकभावना बुद्धिः सा विद्येत्यभिधीयते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001617008, "chapter_id": 21617, "verse_number": "१-३-९", "content_sanskrit": "एषं माया महाविष्णोर्भिन्ना संसारदायिनी ।\nअभेदबुद्ध्या दृष्टा चेत्संसारक्षयकारिणी ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001617009, "chapter_id": 21617, "verse_number": "१-३-१०", "content_sanskrit": "विष्णुशक्तिसमुद्भूतमेतत्सर्वं चराचरम् ।\nयस्माद्भिन्नमिदं सर्वं यच्चेङ्गेद्यच्चनेङ्गति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001617010, "chapter_id": 21617, "verse_number": "१-३-११", "content_sanskrit": "उपाधिभिर्यथाकाशो भिन्नत्वेन प्रतीयते ।\nअविद्योपाधियोगेनतथेदमखिलं जगत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001617011, "chapter_id": 21617, "verse_number": "१-३-१२", "content_sanskrit": "यथा हरिर्जगद्यापी तस्य शक्तिस्तथा मुने ।\nदाहशक्तिर्यथांगारे स्वाश्रयं व्याप्य तिष्टति ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001617012, "chapter_id": 21617, "verse_number": "१-३-१३", "content_sanskrit": "उमेति केचिदाहुस्तां शक्तिं लक्ष्मीं तथा परे ।\nभारतीत्यपरे चैनां गिरिजेत्यम्बिकेति च ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001617013, "chapter_id": 21617, "verse_number": "१-३-१४", "content_sanskrit": "दुर्गेति भद्रकालीति चण्डी माहेश्वरीत्यपि ।\nकौमारी वैष्णवी चेति वाराह्येन्द्री च शाम्भवी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001617014, "chapter_id": 21617, "verse_number": "१-३-१५", "content_sanskrit": "ब्राह्मीति विद्याविद्येति मायेति च तथा परे ।\nप्रकृतिश्च परा चेति वदन्ति परमर्षस्यः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001617015, "chapter_id": 21617, "verse_number": "१-३-१६", "content_sanskrit": "शेषशक्तिः परा विष्णोर्जगत्सर्गादिकारिणी ।\nव्यक्ताव्यक्तस्वरुपेण जगह्याप्य व्यवस्थिता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001617016, "chapter_id": 21617, "verse_number": "१-३-१७", "content_sanskrit": "प्रकृतिश्चपुमांश्चैव कालश्चेति विधिस्थितिः ।\nसृष्टिस्थितिविनाशानामेकः कारणतां गतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001617017, "chapter_id": 21617, "verse_number": "१-३-१८", "content_sanskrit": "येनेदमखिलं जातं ब्रह्मरुपधरेण वै ।\nतस्मात्परतरो देवो नित्यइत्यभिधीयते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001617018, "chapter_id": 21617, "verse_number": "१-३-१९", "content_sanskrit": "रक्षां करोति यो देवो नित्य इत्यभिधीयते ।\nरक्षां करोति यो देवो जगतां परतः पुमान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001617019, "chapter_id": 21617, "verse_number": "१-३-२०", "content_sanskrit": "तस्मात्परतरं यत्तदव्ययं परमं पदम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001617020, "chapter_id": 21617, "verse_number": "१-३-२१", "content_sanskrit": "अक्षरो निर्गुणः शुद्धः परिपूर्णः सनातनः ।\nयः परः कालपुपाख्यो योगिध्येयः परात्परः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001617021, "chapter_id": 21617, "verse_number": "१-३-२२", "content_sanskrit": "परमात्मा परानन्दः सर्वोपाधिविवर्जितः   ।\nज्ञानैकवेद्यः परमः सञ्चिदानन्दविग्रहः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001617022, "chapter_id": 21617, "verse_number": "१-३-२३", "content_sanskrit": "योऽसौ शुद्धोऽपि परमो ह्यहंकारेण संयुतः ।\nदेहीति प्रोच्यते मूढैरहोऽज्ञानविडम्बनम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001617023, "chapter_id": 21617, "verse_number": "१-३-२४", "content_sanskrit": "स देवः परमः शुद्धः सत्त्वदिगुणभेदतः ।\nमूर्तित्रयं समापन्नः सृष्टिस्थित्यन्तकारणम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001617024, "chapter_id": 21617, "verse_number": "१-३-२५", "content_sanskrit": "योऽसौ ब्रह्मा जगत्कर्ता यन्नाभिकमलोद्भवः ।\nस एवानन्दरुपात्मा तस्मान्नास्त्यपरो मुने ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001617025, "chapter_id": 21617, "verse_number": "१-३-२६", "content_sanskrit": "अन्तर्यामी जगद्यापी सर्वसाक्षी निरञ्जनः ।\nभिन्नाभिन्नस्वरुपेण स्थितो वै परमेश्वरः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001617026, "chapter_id": 21617, "verse_number": "१-३-२७", "content_sanskrit": "यस्य शक्तिर्महामाया जगद्विश्त्रम्भधारिणी ।\nविश्वोत्पत्तेर्निदानत्वात्प्रकृतिः प्रोच्यते बुधैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001617027, "chapter_id": 21617, "verse_number": "१-३-२८", "content_sanskrit": "आदिसर्गे महाविष्णोर्लोकान्कर्त्तुं समुद्यतः ।\nप्रकृतिः पुरुषश्चेति कालश्चेति त्रिधा भवेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001617028, "chapter_id": 21617, "verse_number": "१-३-२९", "content_sanskrit": "पश्यन्ति भावितात्मानो यं ब्रह्मत्यभिसंज्ञितम् ।\nशुद्धं यत्परमं धाम तद्विष्णोः परमं पदम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001617029, "chapter_id": 21617, "verse_number": "१-३-३०", "content_sanskrit": "एवं शुद्धोऽक्षरोऽनन्तः कालरुपी महेश्वरः ।\nगुणरुपीगुणाधारोजगतामादिकृद्विभुः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001617030, "chapter_id": 21617, "verse_number": "१-३-३१", "content_sanskrit": "प्रकृतिः क्षोभमापन्ना पुरुषाख्ये जगद्गुरौ ।\nमहान्प्रादुरभूद्धुद्धिस्ततोऽहं समवर्त्तत ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001617031, "chapter_id": 21617, "verse_number": "१-३-३२", "content_sanskrit": "अहंकाराश्च सूक्ष्माणि तन्मात्राणीन्द्रियाणि च ।\nतन्मात्रेभ्यो हि जातानि भूतानि जगतः कृते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001617032, "chapter_id": 21617, "verse_number": "१-३-३३", "content_sanskrit": "आकाशवाय्वग्रिजलभूमयोऽब्जभवात्मज ।\nयथाक्रमं कारणतामेकैकस्योपयान्ति च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001617033, "chapter_id": 21617, "verse_number": "१-३-३४", "content_sanskrit": "ततो ब्रह्या जगद्धाता तामसानसृजत्प्रभुः ।\nतिर्यग्योनिगताञ्जन्तून्पशुपक्षिमृगादिकान् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001617034, "chapter_id": 21617, "verse_number": "१-३-३५", "content_sanskrit": "तमप्यसाधकं मत्वा देवसर्गं सनातनात् ।\nततोवैमानुषं सर्गं कल्पयामास पव्मजः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001617035, "chapter_id": 21617, "verse_number": "१-३-३६", "content_sanskrit": "ततो दक्षादिकान्पुत्रान्सृष्टिसाधनतत्परान् ।\nएभिः पुत्रैरिदं व्याप्तं सदेवासुरमानुषम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001617036, "chapter_id": 21617, "verse_number": "१-३-३७", "content_sanskrit": "भुर्भुवश्च तथा स्वश्च महश्वैव जनस्तथा ।\nतपश्च सत्यमित्येवं लोकाः सत्योपरि स्थिताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001617037, "chapter_id": 21617, "verse_number": "१-३-३८", "content_sanskrit": "अतलं वितलं चैव सुतलं च तलातलम् ।\nमहातलं च विप्रेन्द्र ततोऽधच्च रसातलम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001617038, "chapter_id": 21617, "verse_number": "१-३-३९", "content_sanskrit": "पातालं चेति सप्तैव पातालानि क्रमादधः ।\nएष सर्वेषु लोकेषु लोकनाथांश्च सृष्टवान् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001617039, "chapter_id": 21617, "verse_number": "१-३-४०", "content_sanskrit": "कुलाचलान्नदीश्चासौ तत्तल्लोकनिवासिनाम् ।\nवर्त्तनादीनि सर्वाणि यथायोग्यंमकल्पयत् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001617040, "chapter_id": 21617, "verse_number": "१-३-४१", "content_sanskrit": "भूतले मध्यगो मेरुः सर्वदेवसमाश्रयः ।\nलोकालोकश्च भूम्यन्ते तन्मध्ये सत्प सागराः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001617041, "chapter_id": 21617, "verse_number": "१-३-४२", "content_sanskrit": "द्वीपाश्च सप्त विप्रेन्द्र द्वीपे कुलाचलाः ।\nबाह्या नद्यश्च विख्याता जनाश्चामरसन्निभाः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001617042, "chapter_id": 21617, "verse_number": "१-३-४३", "content_sanskrit": "जम्बूप्लक्षाभिधानौ च शाल्मलश्च कुशस्तथा ।\nक्रौञ्चशाकौ पुष्करश्च ते सर्वे देवभूमयः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001617043, "chapter_id": 21617, "verse_number": "१-३-४४", "content_sanskrit": "एते द्वीपाः समुद्रैस्तु सत्पसत्पभिरावृताः ।\nलवणेक्षुसुरासर्पिर्दधिक्षीरजलैः समम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001617044, "chapter_id": 21617, "verse_number": "१-३-४५", "content_sanskrit": "एते द्वीपाः समुद्राश्च पूर्वस्मादुत्तशेत्तराः ।\nज्ञेया द्विगुणविस्तरा लोकालोकाञ्च पर्वतात् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001617045, "chapter_id": 21617, "verse_number": "१-३-४६", "content_sanskrit": "क्षारोदधेरुपत्तरं यद्धि माद्रेश्चैव दक्षिणाम् ।\nज्ञेयं तद्भारतं वर्षं सर्वकर्मफलप्रदम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001617046, "chapter_id": 21617, "verse_number": "१-३-४७", "content_sanskrit": "अत्र कर्माणि कुर्वन्ति त्रिविधानि तु नारद ।\nतत्फलं भुज्यते चैव भोगभूमिष्वनुक्रमात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001617047, "chapter_id": 21617, "verse_number": "१-३-४८", "content_sanskrit": "भारते तु कृतं कर्म शुभं वाशुभमेव च ।\nतत्फलं क्षयि विप्रेन्द्र भुज्यतेऽन्यत्रजन्तुभिः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001617048, "chapter_id": 21617, "verse_number": "१-३-४९", "content_sanskrit": "अद्यापि देवा इच्छन्ति जन्म भारतभूतले ।\nसंचितं सुमहत्पुण्यमक्षय्यममलं शुभम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001617049, "chapter_id": 21617, "verse_number": "१-३-५०", "content_sanskrit": "कदा लभामहे जन्म वर्षभारतभूमिषु ।\nकदा पुण्येन महता यास्याम परमं पदम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001617050, "chapter_id": 21617, "verse_number": "१-३-५१", "content_sanskrit": "दानैर्वाविविधैर्यज्ञैस्तपोभिर्वाथवा हरिम् ।\nजगदीशंसमेष्यामो नित्यानन्दमनामयम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001617051, "chapter_id": 21617, "verse_number": "१-३-५२", "content_sanskrit": "यो भारतभुवं प्राप्य विष्णुपूजापरो भवेत् ।\nन तस्य सदृशोऽन्योऽस्ति त्रिषु लोकेषु नारद ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001617052, "chapter_id": 21617, "verse_number": "१-३-५३", "content_sanskrit": "हरिकीर्तनशीलो वा तद्भक्तानां प्रियोऽपि वा ।\nशुक्षषुर्वापि महतः सवेद्यो दिविजैरपि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001617053, "chapter_id": 21617, "verse_number": "१-३-५४", "content_sanskrit": "हरिपूजारतो नित्यं भक्तः पूजास्तोऽषि वा ।\nभक्तोच्छिष्टान्नसेवी च याति विष्णोः परं पदम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001617054, "chapter_id": 21617, "verse_number": "१-३-५५", "content_sanskrit": "नारायणेति कृष्णेति वासुदेवेति यो वदेत् ।\nअहिंसादिपरः शन्तः सोऽपि वन्द्यः सुरोत्तमैः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001617055, "chapter_id": 21617, "verse_number": "१-३-५६", "content_sanskrit": "शिवेति नीलकण्ठेति शङ्करेतिच यः स्मरेत् ।\nसर्वभूतहितो नित्यं सोऽभ्यर्च्यो दिविजैः स्मृतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001617056, "chapter_id": 21617, "verse_number": "१-३-५७", "content_sanskrit": "गुरुभक्तः शिवध्यानी स्वाश्रमाचारतत्परः ।\nअनसूयुःशुचिर्दक्षो यः सोऽप्यर्च्यःसुरेश्वरैः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001617057, "chapter_id": 21617, "verse_number": "१-३-५८", "content_sanskrit": "ब्राह्यणानां हितकरः श्रध्दावान्वर्णधर्मयोः ।\nवेदवादरतो नित्यं स ज्ञेयः पङ्किपावनः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001617058, "chapter_id": 21617, "verse_number": "१-३-५९", "content_sanskrit": "अभेददर्शी देवेशे नारायणशिवात्मके ।\nसर्वं यो ब्रह्मण नित्यमस्मदादिषु का कथा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001617059, "chapter_id": 21617, "verse_number": "१-३-६०", "content_sanskrit": "गोषु क्षान्तो ब्रह्मचारी परनिंदाविवर्जितः ।\nअपरिग्रहशी लश्च देवपूज्यः स नारद ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001617060, "chapter_id": 21617, "verse_number": "१-३-६१", "content_sanskrit": "स्तेयादिदोषविमुखः कृतज्ञः सत्यवाक् शुचिः ।\nपरोपकारनिरतः पूजनीयः सुरासुरैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001617061, "chapter_id": 21617, "verse_number": "१-३-६२", "content_sanskrit": "वेदार्थश्रवणे बुद्धिः पुराणश्रवणे तथा ।\nसत्संगेऽपि च यस्यास्ति सोऽपि वन्द्यः सुरोत्तमैः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001617062, "chapter_id": 21617, "verse_number": "१-३-६३", "content_sanskrit": "एवमादीन्यनेकानि कर्माणि श्रद्धयान्वितः ।\nकरोति भारते वर्षे संबन्धोऽस्माभिरेव च ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001617063, "chapter_id": 21617, "verse_number": "१-३-६४", "content_sanskrit": "एतेष्वन्यतमो विप्रमात्मानं नारभेत्तु यः ।\nस एव दुष्कृतिर्मूढो नास्त्यन्योऽस्मादचेतनः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001617064, "chapter_id": 21617, "verse_number": "१-३-६५", "content_sanskrit": "संप्राप्य भारते जन्म सत्कर्म सुपराङ्मुखः ।\nपीयूषकलशं सुक्त्वा विषभाण्डमुपाश्रितः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001617065, "chapter_id": 21617, "verse_number": "१-३-६६", "content_sanskrit": "श्रुतिस्मृत्युदितैर्द्धर्मैर्नात्मानं पावयेत्तु यः ।\nस एवात्मविधाती स्यात्पापिनामग्रणीर्मुने ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001617066, "chapter_id": 21617, "verse_number": "१-३-६७", "content_sanskrit": "कर्मभूमिं समासाद्य यो न धर्मं समाचरेत् ।\nस च सर्वाधमः प्रोक्तो वेदविद्भिर्मुनीश्वर ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001617067, "chapter_id": 21617, "verse_number": "१-३-६८", "content_sanskrit": "शुभं कर्म समुत्सृज्य दुष्कर्माणि करोति यः ।\nकामधेनुं परित्यज्य अर्कक्षीरं सं मार्गति ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001617068, "chapter_id": 21617, "verse_number": "१-३-६९", "content_sanskrit": "एवं भारतभूभागं प्रशंसन्ति दिवौकसः ।\nब्रह्माद्या अपि विप्रेन्द्र स्वभोगक्षयभीरवः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001617069, "chapter_id": 21617, "verse_number": "१-३-७०", "content_sanskrit": "तस्मात्पुण्यतमं ज्ञेयं भारतं वर्षमुत्तमम् ।\nदेवानां दुर्लभं वापि सर्वकर्मफलप्रदम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001617070, "chapter_id": 21617, "verse_number": "१-३-७१", "content_sanskrit": "अस्मिन्पुण्ये च भूभागे यस्तु सत्कर्मसूद्यतः ।\nन तस्य सदृशं कश्चित्रिषु लोकेषु विद्यते ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001617071, "chapter_id": 21617, "verse_number": "१-३-७२", "content_sanskrit": "अस्मिञ्जातो नरो यस्तु स्वंकर्मक्षपणोद्यतः ।\nनररुपपरिच्छन्नः स हरिर्नात्र संशयः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001617072, "chapter_id": 21617, "verse_number": "१-३-७३", "content_sanskrit": "परं लोकफलं प्रेप्सुः किर्यात्कर्माण्यतन्द्रितः ।\nनिवेद्य हरये भक्त्या तत्फलं ह्यक्षयं स्मृतम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001617073, "chapter_id": 21617, "verse_number": "१-३-७४", "content_sanskrit": "विरागी चेत्कर्मफलेष्वपि किंचित्र कारयेत् ।\nअर्पयेत्सुकृतं कर्म प्रीयतामितिं मे हरिः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001617074, "chapter_id": 21617, "verse_number": "१-३-७५", "content_sanskrit": "आब्रह्यभुवनाल्लोकाः पुनरुत्पत्तिदायकाः ।\nफलागृध्नुः कर्मणां तत्प्रात्प्रोति परमं पदम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001617075, "chapter_id": 21617, "verse_number": "१-३-७६", "content_sanskrit": "वेदोदितानि कर्माणि कुर्यादीश्वरतुष्टये ।\nयथाश्रमं त्यक्तुकामः प्रान्पोति पदमव्ययम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001617076, "chapter_id": 21617, "verse_number": "१-३-७७", "content_sanskrit": "निष्कामो वा सकामो वा कुर्यात्कर्म यथाविधि ।\nस्वाश्रमाचारशून्यश्च पतितः प्रोच्यते बुधैः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001617077, "chapter_id": 21617, "verse_number": "१-३-७८", "content_sanskrit": "सदाचारपरो विप्रो वर्द्धते ब्रह्मतेजसा ।\nतस्य विष्णुश्च तुष्टः स्याद्भक्तियुक्तस्य नारद ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001617078, "chapter_id": 21617, "verse_number": "१-३-७९", "content_sanskrit": "भारते जन्म संप्राप्य नात्मानं तारयेतु यः ।\nपच्यते निरये धोरे स त्वाचन्द्रार्कतारकम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001617079, "chapter_id": 21617, "verse_number": "१-३-८०", "content_sanskrit": "वासदेवपरो धर्मो वासुदेवपरं तपः ।\nवासुदेवपरं ज्ञानं वासुदेवपरा गतिः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001617080, "chapter_id": 21617, "verse_number": "१-३-८१", "content_sanskrit": "वासुदेवात्मकं सर्वं जगत्स्थावरजङ्गमम् ।\nआब्रह्मस्तम्बपर्यन्तं तस्मादन्यन्न विद्यते ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001617081, "chapter_id": 21617, "verse_number": "१-३-८२", "content_sanskrit": "स एव धाता त्रिपुरान्तकश्च स एव देवासुरयज्ञरुपः ।\nस एवब्रह्माण्डमिदं ततोऽन्यन्न किंचिदस्ति व्यतिरिक्तरुपम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001617082, "chapter_id": 21617, "verse_number": "१-३-८३", "content_sanskrit": "यस्मात्परं नापरमस्ति किंचिद्यस्मादणीयान्नतथा महीयान् ।\nव्यात्पं हि तेनेदमिदं विचित्रं तं देवदेवं प्रणमेत्समीङ्यम् ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]