[{"id": 2102934, "chapter_id": 3232, "verse_number": "१४-८८-१", "content_sanskrit": "युधिष्ठिर उवाच।\nश्रुतं प्रियमिदं कृष्ण यत्त्वमर्हसि भाषितुम्।\nतन्मेऽमृतरसं पुण्यं मनो ह्लादयति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102935, "chapter_id": 3232, "verse_number": "१४-८८-२", "content_sanskrit": "बहूनि किल युद्धानि विजयस्य नराधिपैः।\nपुनरासन्हृषीकेश तत्रतत्रेति न श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102936, "chapter_id": 3232, "verse_number": "१४-८८-३", "content_sanskrit": "किंनिमित्तं स नित्यं हि पार्थः सुखविवर्जितः।\nअतीव विजयो धीमानिति मे दूयते मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102937, "chapter_id": 3232, "verse_number": "१४-८८-४", "content_sanskrit": "संचिन्तयामि कौन्तेयं रहो जिष्णुं जनार्दन।\nअतीव दुःखभागी स सततं पाण्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102938, "chapter_id": 3232, "verse_number": "१४-८८-५", "content_sanskrit": "किंनु तस्य शरीरेऽस्ति सर्वलक्षणपूजिते।\nअनिष्टं लक्षणं कृष्ण येन दुःखान्युपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102939, "chapter_id": 3232, "verse_number": "१४-८८-६", "content_sanskrit": "अतीवासुखभोगी स सततं कुन्तिनन्दनः।\nन हि पश्यामि बीभत्सोर्निन्द्यं गात्रेषु किंचन।\nश्रोतव्यं चेन्मयैतद्वै तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102940, "chapter_id": 3232, "verse_number": "१४-८८-७", "content_sanskrit": "इत्युक्तः स हृषीकेशो ध्यात्वा सुमहदन्तरम्।\nराजानं भोजराजन्यवर्धनो विष्णुरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102941, "chapter_id": 3232, "verse_number": "१४-८८-८", "content_sanskrit": "न ह्यस्य नृपते किञ्चिदनिष्टमुपलक्षये।\nऋते पुरुषसिंहस्य पिण्डिकेऽस्याधिके यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102942, "chapter_id": 3232, "verse_number": "१४-८८-९", "content_sanskrit": "स ताभ्यां पुरुषव्याघ्रो नित्यमध्वसु वर्तते।\nन चान्यदनुपश्यामि येनासौ दुःखभाजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102943, "chapter_id": 3232, "verse_number": "१४-८८-१०", "content_sanskrit": "इत्युक्तः पुरुषश्रेष्ठस्तदा कृष्णेन धीमता।\nप्रोवाच वृष्णिशार्दूलमेवमेतदिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102944, "chapter_id": 3232, "verse_number": "१४-८८-११", "content_sanskrit": "कृष्णा तु द्रौप्दी कृष्णं तिर्यक्सासूयमैक्षत\nप्रतिजग्राह तस्यास्तं प्रणयं चापि केशिहा।\nप्रख्युः सखा हृषीकेशः साक्षादिव धनंजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102945, "chapter_id": 3232, "verse_number": "१४-८८-१२", "content_sanskrit": "तत्र भीमादयस्ते तु करवो याजकाश्च ये।\nरेमुः श्रुत्वा विचित्रां तां धनंजयकथां शुभाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102946, "chapter_id": 3232, "verse_number": "१४-८८-१३", "content_sanskrit": "तेषां कथयतामेव पुरुषोऽर्जुनसंकथाः।\nउपायाद्वचनाद्दूतो विजयस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102947, "chapter_id": 3232, "verse_number": "१४-८८-१४", "content_sanskrit": "सोभिगम्य कुरुश्रेष्ठं नमस्कृत्य च बुद्धिमान्।\nउपायातं नरव्याघ्रं फल्गुनं प्रत्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102948, "chapter_id": 3232, "verse_number": "१४-८८-१५", "content_sanskrit": "तच्छ्रुत्वा नृपतिस्तस्य हर्षबाष्पाकुलेक्षणः।\nप्रियाख्याननिमित्तं वै ददौ बहुधनं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102949, "chapter_id": 3232, "verse_number": "१४-८८-१६", "content_sanskrit": "ततो द्वितीये दिवसे महाञ्शब्दो व्यवर्धत।\nआगच्छति नरव्याघ्रे कौरवाणां धुरंधरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102950, "chapter_id": 3232, "verse_number": "१४-८८-१७", "content_sanskrit": "ततो रेणुः समुद्भुतो विबभौ तस्य वाजिनः।\nअभितो वर्तमानस्य यथोच्चैःश्रवसस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102951, "chapter_id": 3232, "verse_number": "१४-८८-१८", "content_sanskrit": "तत्र हर्षकरीर्वाचो नराणां शुश्रुवेऽर्जुनः।\nदिष्ट्याऽसि पार्थ कुशली धन्यो राजा युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102952, "chapter_id": 3232, "verse_number": "१४-८८-१९", "content_sanskrit": "कोन्योहि पृथिवीं कृत्स्नां जित्वाहि युधि पार्थिवान्\nचारयित्वा हयश्रेष्ठमुपागच्छेदृतेऽर्जुनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102953, "chapter_id": 3232, "verse_number": "१४-८८-२०", "content_sanskrit": "ये व्यतीता महात्मानो राजानः सगरादयः।\nतेषामपीदृशं कर्म न कदाचन शुश्रुम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102954, "chapter_id": 3232, "verse_number": "१४-८८-२१", "content_sanskrit": "नैतदन्ये करिष्यन्ति भविष्या वसुधाधिपाः।\nयत्त्वं कुरुकुलश्रेष्ठ दुष्करं कृतवानसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102955, "chapter_id": 3232, "verse_number": "१४-८८-२२", "content_sanskrit": "इत्येवं वदतां तेषां पुंसां कर्णसुखा गिरः।\nशृण्वन्विवेश धर्मात्मा फल्गुनो यज्ञसंस्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102956, "chapter_id": 3232, "verse_number": "१४-८८-२३", "content_sanskrit": "ततो राजा सहामात्यः कृष्णश्च यदुनन्दनः।\nधृतराष्ट्रं पुरस्कृत्य तं प्रत्युद्ययतुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102957, "chapter_id": 3232, "verse_number": "१४-८८-२४", "content_sanskrit": "सोऽभिवाद्य पितुः पादौ धर्मराजस्य धीमतः।\nभीमादींश्चापि संपूज्य पर्यष्वजत केशवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102958, "chapter_id": 3232, "verse_number": "१४-८८-२५", "content_sanskrit": "तैः समेत्यार्चितस्तांश्च प्रत्यर्च्याथ यथाविधि।\nविशश्राम महाबाहुस्तीरं लब्ध्वेव पारगः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2102959, "chapter_id": 3232, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि अष्टाशीतितमोऽध्यायः॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]