[{"id": 2002273, "chapter_id": 1047, "verse_number": "१-४८-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002274, "chapter_id": 1047, "verse_number": "१-४८-१", "content_sanskrit": "गतमात्रं तु भर्तारं जरत्कारुरवेदयत्।\nभ्रातुः सकाशमागत्य यथातथ्यं तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002275, "chapter_id": 1047, "verse_number": "१-४८-२", "content_sanskrit": "ततः स भुजगश्रेष्ठः श्रुत्वा सुमहदप्रियम्।\nउवाच भगिनीं दीनां तदा दीनतरः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002276, "chapter_id": 1047, "verse_number": "१-४८-३x", "content_sanskrit": "वासुकिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002277, "chapter_id": 1047, "verse_number": "१-४८-३", "content_sanskrit": "जानासि भद्रे यत्कार्यं प्रदाने कारणं च यत्।\nपन्नगानां हितार्थाय पुत्रस्ते स्यात्ततो यदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002278, "chapter_id": 1047, "verse_number": "१-४८-४", "content_sanskrit": "स सर्पसत्रात्किल नो मोक्षयिष्यति वीर्यवान्।\nएवं पितामहः पूर्वमुक्तवांस्तु सुरैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002279, "chapter_id": 1047, "verse_number": "१-४८-५", "content_sanskrit": "अप्यस्ति गर्भः सुभगे तस्मात्ते मुनिसत्तमात्।\nन चेच्छाम्यफलं तस्य दारकर्म मनीषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002280, "chapter_id": 1047, "verse_number": "१-४८-६", "content_sanskrit": "कामं च मम न न्याय्यं प्रष्टुं त्वां कार्यमीदृशम्।\nकिंतु कार्यगरीयस्त्वात्ततस्त्वाऽहमचूचुदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002281, "chapter_id": 1047, "verse_number": "१-४८-७", "content_sanskrit": "दुर्वार्यतां विदित्वा च भर्तुस्तेऽतितपस्विनः।\nनैनमन्वागमिष्यामि कदाचिद्धि शपेत्स माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002282, "chapter_id": 1047, "verse_number": "१-४८-८", "content_sanskrit": "आचक्ष्व भद्रे भर्तुः स्वं सर्वमेव विचेष्टितम्।\nउद्धरस्व च शल्यं मे घोरं हृदि चिरस्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002283, "chapter_id": 1047, "verse_number": "१-४८-९", "content_sanskrit": "जरत्कारुस्ततो वाक्यमित्युक्ता प्रत्यभाषत।\nआश्वासयन्ती सन्तप्तं वासुकिं पन्नगेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002284, "chapter_id": 1047, "verse_number": "१-४८-१०x", "content_sanskrit": "जरत्कारुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002285, "chapter_id": 1047, "verse_number": "१-४८-१०", "content_sanskrit": "पृष्टो मयाऽपत्यहेतोः स महात्मा महातपाः।\nअस्तीत्युत्तरमुद्दिश्य ममेदं गतवांश्च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002286, "chapter_id": 1047, "verse_number": "१-४८-११", "content_sanskrit": "स्वैरेष्वपि न तेनाहं स्मरामि वितथं वचः।\nउक्तपूर्वं कुतो राजन्सांपराये स वक्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002287, "chapter_id": 1047, "verse_number": "१-४८-१२", "content_sanskrit": "न संतापस्त्वया कार्यः कार्यं प्रति भुजंगमे।\nउत्पत्स्यति च ते पुत्रो ज्वलनार्कसमप्रभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002288, "chapter_id": 1047, "verse_number": "१-४८-१३", "content_sanskrit": "इत्युक्त्वा स हि मां भ्रातर्गतो भर्ता तपोधनः।\nतस्माद्व्येतु परं दुःखं तवेदं मनसि स्थितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002289, "chapter_id": 1047, "verse_number": "१-४८-१४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002290, "chapter_id": 1047, "verse_number": "१-४८-१४", "content_sanskrit": "एतच्छ्रुत्वा स नागेन्द्रो वासुकिः परया मुदा।\nएवमस्त्विति तद्वाक्यं भगिन्याः प्रत्यगृह्णत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002291, "chapter_id": 1047, "verse_number": "१-४८-१५", "content_sanskrit": "सान्त्वमानार्थदानैश्च पूजया चारुरूपया।\nसोदर्यां पूजयामास स्वसारं पन्नगोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002292, "chapter_id": 1047, "verse_number": "१-४८-१६", "content_sanskrit": "ततः प्रववृधे गर्भो महातेजा महाप्रभः।\nयथा मोमो द्विजश्रेष्ठ शुक्लपक्षोदितो दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002293, "chapter_id": 1047, "verse_number": "१-४८-१७", "content_sanskrit": "अथ काले तु सा ब्रह्मन्प्रजज्ञे भुजगस्वसा।\nकुमारं देवगर्भाभं पितृमातृभयापहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002294, "chapter_id": 1047, "verse_number": "१-४८-१८", "content_sanskrit": "ववृधे स तु तत्रैव नागराजनिवेशने।\nवेदांश्चाधिजगे साङ्गान्भार्गवच्यवनात्मजात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002295, "chapter_id": 1047, "verse_number": "१-४८-१९", "content_sanskrit": "चीर्णव्रतो बाल एव बुद्धिसत्त्वगुणान्वितः।\nनाम चास्याभवत्ख्यातं लोकेष्वास्तीक इत्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002296, "chapter_id": 1047, "verse_number": "१-४८-२०", "content_sanskrit": "अस्तीत्युक्त्वा गतो यस्मात्पिता गर्भस्थमेव तम्।\nवनं तस्मादिदं तस्य नामास्तीकेति विश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002297, "chapter_id": 1047, "verse_number": "१-४८-२१", "content_sanskrit": "स बाल एव तत्रस्थश्चरन्नमितबुद्धिमान्।\nगृहे पन्नगराजस्य प्रयत्नात्परिरक्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002298, "chapter_id": 1047, "verse_number": "१-४८-२२", "content_sanskrit": "भगवानिव देवेशः शूलपाणिर्हिरण्मयः।\nविवर्धमानः सर्वांस्तान्पन्नगानभ्यहर्षयत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002299, "chapter_id": 1047, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि अष्टचत्वारिंशोऽध्यायः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]