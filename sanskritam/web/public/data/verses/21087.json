[{"id": 7001087000, "chapter_id": 21087, "verse_number": "१-२३-१", "content_sanskrit": "ऋषय ऊचुः ।\nसूत सूत महाभाग व्यासशिष्य नमोस्तु ते ।\nतदेव व्यासतो ब्रूहि भस्ममाहात्म्यमुत्तमम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001087001, "chapter_id": 21087, "verse_number": "१-२३-२", "content_sanskrit": "तथा रुद्रा क्षमाहात्म्यं नाम माहात्म्यमुत्तमम् ।\nत्रितयं ब्रूहि सुप्रीत्या ममानंदयचेतसम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001087002, "chapter_id": 21087, "verse_number": "१-२३-३", "content_sanskrit": "सूत उवाच ।\nसाधुपृष्टं भवद्भिश्च लोकानां हितकारकम् ।\nभवंतो वै महाधन्याः पवित्राः कुलभूषणाः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001087003, "chapter_id": 21087, "verse_number": "१-२३-४", "content_sanskrit": "येषां चैव शिवः साक्षाद्दैवतं परमं शुभम् ।\nसदा शिवकथा लोके वल्लभा भवतां सदा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001087004, "chapter_id": 21087, "verse_number": "१-२३-५", "content_sanskrit": "ते धन्याश्च कृतार्थाश्च सफलं देहधारणम् ।\nउद्धृतञ्च कुलं तेषां ये शिवं समुपासते॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001087005, "chapter_id": 21087, "verse_number": "१-२३-६", "content_sanskrit": "मुखे यस्य शिवनाम सदाशिवशिवेति च ।\nपापानि न स्पृशंत्येव खदिरांगारंकयथा॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001087006, "chapter_id": 21087, "verse_number": "१-२३-७", "content_sanskrit": "श्रीशिवाय नमस्तुभ्यं मुखं व्याहरते यदा ।\nतन्मुखं पावनं तीर्थं सर्वपापविनाशनम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001087007, "chapter_id": 21087, "verse_number": "१-२३-८", "content_sanskrit": "तन्मुखञ्च तथा यो वै पश्यतिप्रीतिमान्नरः ।\nतीर्थजन्यं फलं तस्य भवतीति सुनिश्चितम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001087008, "chapter_id": 21087, "verse_number": "१-२३-९", "content_sanskrit": "यत्र त्रयं सदा तिष्ठेदेतच्छुभतरं द्विजा ।\nतस्य दर्शनमात्रेण वेणीस्नानफलंलभेत्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001087009, "chapter_id": 21087, "verse_number": "१-२३-१०", "content_sanskrit": "शिवनामविभूतिश्च तथा रुद्रा क्ष एव च ।\nएतत्त्रयं महापुण्यं त्रिवेणीसदृशं स्मृतम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001087010, "chapter_id": 21087, "verse_number": "१-२३-११", "content_sanskrit": "एतत्त्रयं शरीरे च यस्य तिष्ठति नित्यशः ।\nतस्यैव दर्शनं लोके दुर्लभं पापहारकम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001087011, "chapter_id": 21087, "verse_number": "१-२३-१२", "content_sanskrit": "तद्दर्शनं यथा वेणी नोभयोरंतरं मनाक् ।\nएवं योनविजानाति सपापिष्ठो न संशयः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001087012, "chapter_id": 21087, "verse_number": "१-२३-१३", "content_sanskrit": "विभूतिर्यस्य नो भाले नांगे रुद्रा क्षधारणम् ।\nनास्ये शिवमयी वाणी तं त्यजेदधमं यथा॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001087013, "chapter_id": 21087, "verse_number": "१-२३-१४", "content_sanskrit": "शैवं नाम यथा गंगा विभूतिर्यमुना मता ।\nरुद्रा क्षं विधिना प्रोक्ता सर्वपापाविनाशिनी॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001087014, "chapter_id": 21087, "verse_number": "१-२३-१५", "content_sanskrit": "शरीरे च त्रयं यस्य तत्फलं चैकतः स्थितम् ।\nएकतो वेणिकायाश्च स्नानजंतुफलं बुधैः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001087015, "chapter_id": 21087, "verse_number": "१-२३-१६", "content_sanskrit": "तदेवं तुलितं पूर्वं ब्रह्मणाहितकारिणा ।\nसमानं चैव तज्जातं तस्माद्धार्यं सदा बुधैः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001087016, "chapter_id": 21087, "verse_number": "१-२३-१७", "content_sanskrit": "तद्दिनं हि समारभ्य ब्रह्मविष्ण्वादिभिः सरैः ।\nधार्यते त्रितयं तच्च दर्शनात्पापहारकम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001087017, "chapter_id": 21087, "verse_number": "१-२३-१८", "content_sanskrit": "ऋष्य ऊचुः ।\nईदृशं हि फलं प्रोक्तं नामादित्रितयोद्भवम् ।\nतन्माहात्म्यं विशेषेण वक्तुमर्हसि सुव्रत॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001087018, "chapter_id": 21087, "verse_number": "१-२३-१९", "content_sanskrit": "सूत उवाच ।\nऋषयो हि महाप्राज्ञाः सच्छैवा ज्ञानिनां वराः ।\nतन्माहात्म्यं हि सद्भक्त्या शृणुतादरतो द्विजाः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001087019, "chapter_id": 21087, "verse_number": "१-२३-२०", "content_sanskrit": "सुगूढमपि शास्त्रेषु पुराणेषु श्रुतिष्वपि ।\nभवत्स्नेहान्मया विप्राः प्रकाशः क्रियतेऽधुना॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001087020, "chapter_id": 21087, "verse_number": "१-२३-२१", "content_sanskrit": "कस्तत्त्रितयमाहात्म्यं संजानाति द्विजोत्तमाः ।\nमहेश्वरं विना सर्वं ब्रह्माण्डे सदसत्परम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001087021, "chapter_id": 21087, "verse_number": "१-२३-२२", "content_sanskrit": "वच्म्यहं नाम माहात्म्यं यथाभक्ति समासतः ।\nशृणुत प्रीतितो विप्राः सर्वपापहरं परम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001087022, "chapter_id": 21087, "verse_number": "१-२३-२३", "content_sanskrit": "शिवेति नामदावाग्नेर्महापातकपर्वताः ।\nभस्मीभवंत्यनायासात्सत्यंसत्यं न संशयः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001087023, "chapter_id": 21087, "verse_number": "१-२३-२४", "content_sanskrit": "पापमूलानि दुःखानि विविधान्यपि शौनक ।\nशिवनामैकनश्यानि नान्यनश्यानि सर्वथा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001087024, "chapter_id": 21087, "verse_number": "१-२३-२५", "content_sanskrit": "स वैदिकः स पुण्यात्मा स धन्यस्स बुधो मतः ।\nशिवनामजपासक्तो यो नित्यं भुवि मानव॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001087025, "chapter_id": 21087, "verse_number": "१-२३-२६", "content_sanskrit": "भवंति विविधा धर्मास्तेषां सद्यः फलोन्मुखाः ।\nयेषां भवति विश्वासः शिवनामजपे मुने॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001087026, "chapter_id": 21087, "verse_number": "१-२३-२७", "content_sanskrit": "पातकानि विनश्यंति यावंति शिवनामतः ।\nभुवि तावंति पापानि क्रियंते न नरैर्मुने॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001087027, "chapter_id": 21087, "verse_number": "१-२३-२८", "content_sanskrit": "ब्रह्महत्यादिपापानां राशीनप्रमितान्मुने ।\nशिवनाम द्रुतं प्रोक्तं नाशयत्यखिलान्नरैः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001087028, "chapter_id": 21087, "verse_number": "१-२३-२९", "content_sanskrit": "शिवनामतरीं प्राप्य संसाराब्धिं तरंति ये ।\nसंसारमूलपापानि तानि नश्यंत्यसंशयम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001087029, "chapter_id": 21087, "verse_number": "१-२३-३०", "content_sanskrit": "संसारमूलभूतानां पातकानां महामुने ।\nशिवनामकुठारेण विनाशो जायते ध्रुवम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001087030, "chapter_id": 21087, "verse_number": "१-२३-३१", "content_sanskrit": "शिवनामामृतं पेयं पापदावानलार्दितैः ।\nपापदावाग्नितप्तानां शांतिस्तेन विना न हि॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001087031, "chapter_id": 21087, "verse_number": "१-२३-३२", "content_sanskrit": "शिवेति नामपीयूषवर्षधारापरिप्लुताः ।\nसंसारदवमध्येपि न शोचंति कदाचन॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001087032, "chapter_id": 21087, "verse_number": "१-२३-३३", "content_sanskrit": "शिवनाम्नि महद्भक्तिर्जाता येषां महात्मनाम् ।\nतद्विधानां तु सहसा मुक्तिर्भवति सर्वथा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001087033, "chapter_id": 21087, "verse_number": "१-२३-३४", "content_sanskrit": "अनेकजन्मभिर्येन तपस्तप्तं मुनीश्वर ।\nशिवनाम्नि भवेद्भक्तिः सर्वपापापहारिणी॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001087034, "chapter_id": 21087, "verse_number": "१-२३-३५", "content_sanskrit": "यस्या साधारणं शंभुनाम्नि भक्तिरखंडिता ।\nतस्यैव मोक्षः सुलभो नान्यस्येति मतिर्मम॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001087035, "chapter_id": 21087, "verse_number": "१-२३-३६", "content_sanskrit": "कृत्वाप्यनेकपापानि शिवनामजपादरः ।\nसर्वपापविनिर्मुक्तो भवत्येव न संशयः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001087036, "chapter_id": 21087, "verse_number": "१-२३-३७", "content_sanskrit": "भवंति भस्मसाद्वृक्षा दवदग्धा यथा वने ।\nतथा तावंति दग्धानि पापानि शिवनामतः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001087037, "chapter_id": 21087, "verse_number": "१-२३-३८", "content_sanskrit": "यो नित्यं भस्मपूतांगः शिवनामजपादरः ।\nसंतरत्येव संसारं सघोरमपि शौनक॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001087038, "chapter_id": 21087, "verse_number": "१-२३-३९", "content_sanskrit": "ब्रह्मस्वहरणं कृत्वा हत्वापि ब्राह्मणान्बहून् ।\nन लिप्यते नरः पापैः शिवनामजपादरः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001087039, "chapter_id": 21087, "verse_number": "१-२३-४०", "content_sanskrit": "विलोक्य वेदानखिलाञ्छिवनामजपः परम् ।\nसंसारतारणोपाय इति पूर्वैर्विनिश्चितः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001087040, "chapter_id": 21087, "verse_number": "१-२३-४१", "content_sanskrit": "किं बहूक्त्या मुनिश्रेष्ठाः श्लोकेनैकेन वच्म्यहम् ।\nशिवनाम्नो महिमानं सर्वपापापहारिणम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001087041, "chapter_id": 21087, "verse_number": "१-२३-४२", "content_sanskrit": "पापानां हरणे शंभोर्नामः शक्तिर्हि पावनी ।\nशक्नोति पातकं तावत्कर्तुं नापि नरः क्वचित्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001087042, "chapter_id": 21087, "verse_number": "१-२३-४३", "content_sanskrit": "शिवनामप्रभावेण लेभे सद्गतिमुत्तमाम् ।\nइन्द्र द्युम्ननृपः पूर्वं महापापः पुरामुने॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001087043, "chapter_id": 21087, "verse_number": "१-२३-४४", "content_sanskrit": "तथा काचिद्द्विजायोषा सौ मुने बहुपापिनी ।\nशिवनामप्रभावेण लेभे सद्गतिमुत्तमाम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001087044, "chapter_id": 21087, "verse_number": "१-२३-४५", "content_sanskrit": "इत्युक्तं वो द्विजश्रेष्ठा नाममाहात्म्यमुत्तमम् ।\nशृणुध्वं भस्ममाहात्म्यं सर्वपावनपावनम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]