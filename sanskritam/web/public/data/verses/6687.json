  {
    "id": 20011979,
    "chapter_id": 6687,
    "verse_number": "15.76",
    "content_sanskrit": "प्रसादात्तत्र गोविन्द कन्येयं प्रतिपादिता । बाहुयोनिप्रकण्डाय पाण्डवाय मयाऽर्हते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20011980,
    "chapter_id": 6687,
    "verse_number": "15.77",
    "content_sanskrit": "सोऽयमद्य समं वध्वा निजं जिगमिषुर्गृहम् । चिरदृष्टं दिदृक्षुस्स्वं प्रियं मातृमुखं जनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20011981,
    "chapter_id": 6687,
    "verse_number": "15.78",
    "content_sanskrit": "नन्वज्ञायिष्यताऽस्माभिस्स चेद्विरहकातरैः । अदुःखायिष्यताऽपश्यन् स्वजनोऽमुमतिप्रियम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20011982,
    "chapter_id": 6687,
    "verse_number": "15.79",
    "content_sanskrit": "यदि चाऽयमितो यास्यन् स्वपुरं सह जायया । अन्वभाविष्यताऽस्माऽभिर्दुःखमुग्रं वियोगजम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20011983,
    "chapter_id": 6687,
    "verse_number": "15.80",
    "content_sanskrit": "तदत्र सङ्कटे कार्यं यत् तद्वाच्यं त्वयाऽधुना । इत्युक्तः पितरं शौरिरुक्तवान् मुक्तसंशयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20011984,
    "chapter_id": 6687,
    "verse_number": "15.81",
    "content_sanskrit": "पुरं पुरन्दरप्रस्थं गम्यं वध्वा सहाऽमुना । वियोगदुखं त्वस्माभिस्सोढव्यं कार्यचिन्तया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20011985,
    "chapter_id": 6687,
    "verse_number": "15.82",
    "content_sanskrit": "संयोगाश्च वियोगाश्च दुःखानि च सुखानि च । बुधैर्न गणनीयानि धीरैः कार्यानुरोधिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20011986,
    "chapter_id": 6687,
    "verse_number": "15.83",
    "content_sanskrit": "अवत्स्यदिह चेदेष श्रुत्वा गूढं करग्रहम् । अक्रोत्स्यन् वृष्णयोऽस्मभ्यमिहत्त्येभ्यो बलादयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20011987,
    "chapter_id": 6687,
    "verse_number": "15.84",
    "content_sanskrit": "गूढमेषोऽगमिष्यच्चेदनया सह पाण्डवः । अवक्ष्यत् सर्वलोकोऽमुं कुमारीचोरमर्जुनम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20011988,
    "chapter_id": 6687,
    "verse_number": "15.85",
    "content_sanskrit": "सुभद्राचोदिताश्वस्तद्रथमारुह्य मामकम् । जित्वा शङ्खरावाहूतान् वृष्णीन् कार्योऽमुनाऽऽगमः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20011989,
    "chapter_id": 6687,
    "verse_number": "15.86",
    "content_sanskrit": "नाऽश्रद्धेयमजेष्यद्यत्पार्थोऽयं सर्वयादवान् । किमेकेन मृगेन्द्रेण न जय्या बहवो मृगाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20011990,
    "chapter_id": 6687,
    "verse_number": "15.87",
    "content_sanskrit": "किं नाम वृष्णयस्सर्वे व्यजेष्यन्ताऽमुमप्यमी । संहतैरपि सारङ्गैरणजय्यो हि मृगाधिपः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20011991,
    "chapter_id": 6687,
    "verse_number": "15.88",
    "content_sanskrit": "अमंस्ये पार्थगृह्यस्तैर्नाऽस्थास्यं यदि तैस्सह । दर्शयन् कृत्रिमं क्रोधं प्रहरंश्च शरै रणे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20011992,
    "chapter_id": 6687,
    "verse_number": "15.89",
    "content_sanskrit": "उपायमेतं यदि नाऽश्रयिष्यं क्रुद्धो मया नाशमयिष्यताऽऽर्यः । न च प्रसन्नस्सहितो मयाऽऽशु पुरन्दरप्रस्थमितोऽगमिष्यत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20011993,
    "chapter_id": 6687,
    "verse_number": "15.90",
    "content_sanskrit": "स चेदशामिष्यत न क्रुधा जितो मयाऽशमिष्यन्त नु वृष्णयोऽन्धिताः । मया जितेन त्वमुनाऽऽजिमूर्ध्नि तैस्सहाऽनुनेयः सह यादवैर्बलैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
