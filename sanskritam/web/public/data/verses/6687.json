[
  {
    "id": 20011904,
    "chapter_id": 6687,
    "verse_number": "15.1",
    "content_sanskrit": "दिनानि कतिचिन्नीत्वा द्वारवत्यामथाऽर्जुनः । जातो जिगमिषुर्जातु काले कंसजितोदिते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20011905,
    "chapter_id": 6687,
    "verse_number": "15.2",
    "content_sanskrit": "स सुभद्रामुपाहूय विविक्तेऽभ्युक्तवानिति । यास्यावः खाण्डवप्रस्थं द्रक्ष्यावः स्वजनं प्रिये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20011906,
    "chapter_id": 6687,
    "verse_number": "15.3",
    "content_sanskrit": "खैस्सार्धं विहरिष्यावस्तुभ्यं रोचिष्यते यदि । सख्यस्त्वाऽनुगमिष्यन्ति भ्रातरश्च यतीमितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20011907,
    "chapter_id": 6687,
    "verse_number": "15.4",
    "content_sanskrit": "इत्युक्तोक्तवती सा तमितः प्रस्थास्यसे कदा । आप्रक्ष्ये पितरौ कर्हि सकलाश्च सखीरहम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20011908,
    "chapter_id": 6687,
    "verse_number": "15.5",
    "content_sanskrit": "गमिष्यामीति सन्नद्धा प्रागेवाऽहमिह स्थिता । गमिष्यामीति सन्नद्धो नेदानीमपि किं भवान् ? ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20011909,
    "chapter_id": 6687,
    "verse_number": "15.6",
    "content_sanskrit": "वन्दिष्येऽहं पृथां कर्हि प्रेक्षिष्ये द्रौपदीं कदा । द्रक्ष्यामि पाण्डवान् कर्हि स्थितां चित्ते सदेति मे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20011910,
    "chapter_id": 6687,
    "verse_number": "15.7",
    "content_sanskrit": "कदाऽहमवलोकिष्ये महाराजं युधिष्ठिरम् । मुकुलीकृतराजन्यकराब्जस्मितचन्द्रिकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20011911,
    "chapter_id": 6687,
    "verse_number": "15.8",
    "content_sanskrit": "भोजयिष्यसि कान् राजन् केभ्यो दानानि दास्यसि । दास्यत्यन्नानि योऽर्थिभ्यः प्रेत्य सोऽन्नानि भोक्ष्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20011912,
    "chapter_id": 6687,
    "verse_number": "15.9",
    "content_sanskrit": "संवर्धयिष्यत्यस्वान् स्वैर्यस्स संपत्स्यते धनैः । अर्थिभ्योऽनुक्त एवेत्थं यः कामान्ददिताऽर्थवान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20011913,
    "chapter_id": 6687,
    "verse_number": "15.10",
    "content_sanskrit": "पाण्डवाऽऽखण्डलप्रस्थमितस्त्वं यदि यास्यसि । अथाऽहमनुढौके त्वां विशयो नाऽत्र मे हृदि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20011914,
    "chapter_id": 6687,
    "verse_number": "15.11",
    "content_sanskrit": "यद्यप्यूर्ध्वं मुहूर्तात् त्वं गृहमेष्यसि भारत ! तथाऽप्यनुव्रजानि त्वां त्वं हि मे शरणं पते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20011915,
    "chapter_id": 6687,
    "verse_number": "15.12",
    "content_sanskrit": "परिष्वज्योक्तवान् गाढमित्थमुक्तवतीं स ताम् । प्रेयस्यश्शीलसम्पन्नाः कियत्यास्सत्कृतेः पदम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20011916,
    "chapter_id": 6687,
    "verse_number": "15.13",
    "content_sanskrit": "स्वगृहं यास्यसि त्वं चेद्यास्याम्यहमपीति ते । वचो निशम्य साशंसं प्रीतोऽहं सम्प्रति प्रिये ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20011917,
    "chapter_id": 6687,
    "verse_number": "15.14",
    "content_sanskrit": "सन्नत्स्यसि यदि क्षिप्रं गन्तुमायतलोचने । यास्याम्यहमितस्तूर्णमादाय त्वामुदायुधः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20011918,
    "chapter_id": 6687,
    "verse_number": "15.15",
    "content_sanskrit": "यावज्जीवं गतावावां गृहे रंस्यावहे भृशम् । अर्थिब्रजानामाशाश्च पूरयन्तौ समृद्धिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20011919,
    "chapter_id": 6687,
    "verse_number": "15.16",
    "content_sanskrit": "आप्तृभिस्सहितो भूपाञ्जित्वाऽऽगामिनि वत्सरे । याजयिष्यामि राजानं राजसूयेन धर्मजम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20011920,
    "chapter_id": 6687,
    "verse_number": "15.17",
    "content_sanskrit": "विघ्नं क्रतोः करिष्यन्ति राजानो यदि शत्रवः । तानहं निहनिष्यामि शरैरेव न संशयः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20011921,
    "chapter_id": 6687,
    "verse_number": "15.18",
    "content_sanskrit": "साधवस्सुहृदोऽस्माकं कुलीना बुद्धिमत्तमाः । मखविघ्नाय कल्प्स्यन्ति कथं नः पृथिवीभृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20011922,
    "chapter_id": 6687,
    "verse_number": "15.19",
    "content_sanskrit": "बाल्यात्प्रभृति नो द्रोढा भ्रातृमान्नः सहायवान् । ध्रुवं दुर्योधनः पापो विजिघांसिष्यति क्रतुम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20011923,
    "chapter_id": 6687,
    "verse_number": "15.20",
    "content_sanskrit": "श्रुतपूर्वं त्वया ज्ञातमिदमिन्दुनिभानने । भीमं सुयोधनो बाल्ये विषान्नं भोजयिष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20011924,
    "chapter_id": 6687,
    "verse_number": "15.21",
    "content_sanskrit": "स्मृतश्चेदं त्वया तं स दंशयिष्यति पन्नगैः । दंष्ट्रास्तेषां भविष्यन्ति चूर्णास्तद्गात्रसङ्गताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20011925,
    "chapter_id": 6687,
    "verse_number": "15.22",
    "content_sanskrit": "अभिज्ञातं त्वयेदञ्च स तं गाङ्गे महाहृदे । पातयिष्यति यद्धध्वा पाशांञ्छिछूत्वेष्यते स यत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20011926,
    "chapter_id": 6687,
    "verse_number": "15.23",
    "content_sanskrit": "भरतस्य कुले जातः को नामैवं प्रवत्स्यति । सल्लक्षणोदाहरणक्षितिपालनिरन्तरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20011927,
    "chapter_id": 6687,
    "verse_number": "15.24",
    "content_sanskrit": "नाऽवकॢप्यमिदं पापं भरतो यच्चरिष्यति । कल्पिष्यते 'कुगन्धाय कतरन्नाम पुष्करम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20011928,
    "chapter_id": 6687,
    "verse_number": "15.25",
    "content_sanskrit": "न मृष्यन्नो हि लक्ष्मैवं यन्नः परिभविष्यति । किं नामाऽऽसिष्यते तूष्णीं क्रोधाक्रान्तो मृगाधिपः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20011929,
    "chapter_id": 6687,
    "verse_number": "15.26",
    "content_sanskrit": "भीष्मः किं किल नामैवं चरिष्यति पितामहः । विचित्रवीर्यो राजैवमस्ति नाम करिष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20011930,
    "chapter_id": 6687,
    "verse_number": "15.27",
    "content_sanskrit": "स्थास्यन्ति पुरतोऽमित्रा युद्धे किं किल नाम मे । विद्यते नाम कर्णो मा माहवेऽभिभविष्यति ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20011931,
    "chapter_id": 6687,
    "verse_number": "15.28",
    "content_sanskrit": "चित्रं शकुनिना नाम दर्शिष्येऽहं धनुर्धरः । दुश्शासनेन नामऽहं घानिष्ये पविणाऽसृतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20011932,
    "chapter_id": 6687,
    "verse_number": "15.29",
    "content_sanskrit": "किमत वाचालतया जेष्यन्ते सर्वपार्थिवाः । ग्राहिष्यन्ते करास्तेभ्यः कोदण्डसुहृदा मया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20011933,
    "chapter_id": 6687,
    "verse_number": "15.30",
    "content_sanskrit": "शिरोभिर्भूर्भृतां तेषां मही चायिष्यते मया । बद्धवीर्यमदान्धैर्मे दायिष्यन्ते न यैः कराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20011934,
    "chapter_id": 6687,
    "verse_number": "15.31",
    "content_sanskrit": "आहूताखिलभूपालकरौघेण नताङ्घ्रिणा । प्रियं भविष्णुना राज्ञो गुरोर्भाविष्यते मया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20011935,
    "chapter_id": 6687,
    "verse_number": "15.32",
    "content_sanskrit": "सोमै'र्मदिष्यते देवैः कामैर्मोदिष्यते द्विजैः । कुशैर्मेदिष्यतेऽन्धोभिर्यजमाने युधिष्ठिरे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20011936,
    "chapter_id": 6687,
    "verse_number": "15.33",
    "content_sanskrit": "भरतं कार्तवीर्यञ्च मान्धातारं भगीरथम् । सोमञ्च राजसूयेन धर्मराजो विजेष्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20011937,
    "chapter_id": 6687,
    "verse_number": "15.34",
    "content_sanskrit": "ज्वलत्किरीटकेयूरा विराटद्रुपदादयः । भोजयिष्यन्ति भूदेवांस्तत्र पात्रभृतस्वयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20011938,
    "chapter_id": 6687,
    "verse_number": "15.35",
    "content_sanskrit": "भुक्तयस्तत्र वर्त्स्यन्ति वर्त्स्यन्त्योदनपर्वताः । स्यन्दिष्यन्ते पयोनद्यः स्यन्त्स्यन्ति दधिसिन्धवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20011939,
    "chapter_id": 6687,
    "verse_number": "15.36",
    "content_sanskrit": "वक्ष्यन्ति धृतवाहिन्यो नर्त्स्यन्ति निपुणा नटाः । नर्तिष्यन्ति सुरूपाश्च पटवो नटयोषितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20011940,
    "chapter_id": 6687,
    "verse_number": "15.37",
    "content_sanskrit": "ऐश्वर्यमतुलं प्राप्य स्मेष्यते न सुहृज्जनैः । पूर्णैःस्मयिष्यते कामैर्ज्ञातिसंबन्धिभिस्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20011941,
    "chapter_id": 6687,
    "verse_number": "15.38",
    "content_sanskrit": "इष्टिभिस्सकला देवा वृष्टिभिश्चाऽखिलाः प्रजाः । मुदमासादयिष्यन्ति सौराज्ये धर्मजन्मनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20011942,
    "chapter_id": 6687,
    "verse_number": "15.39",
    "content_sanskrit": "तत्प्रस्थातास्वहे शीघ्रमावां श्व स्वपुरीमितः । सर्वान् नन्दयितास्वः स्वान् गुरून्स्तान् वन्दितास्वहे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20011943,
    "chapter_id": 6687,
    "verse_number": "15.40",
    "content_sanskrit": "पाण्डवं वासुदेवीति गदितोक्तवती पुनः । कदेक्षिताहे गत्वा स्वानिति मे चलितं मनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20011944,
    "chapter_id": 6687,
    "verse_number": "15.41",
    "content_sanskrit": "गन्ताऽस्मि पितरौ श्वोऽहमाप्रष्टाहे प्रणम्य च । अथ ताभ्यामनुज्ञाता वक्तास्मि स्वजनं गतिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20011945,
    "chapter_id": 6687,
    "verse_number": "15.42",
    "content_sanskrit": "लब्धानुज्ञा ततश्चालीर्भाषिताहे चिकीर्षितम् । गृहमेतास्म्यहं पत्युर्गणरात्रेऽतिवाहिते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20011946,
    "chapter_id": 6687,
    "verse_number": "15.43",
    "content_sanskrit": "तत्र स्वैरं विहर्ताऽस्मि पूजयन्ती पतिं प्रियम् । विहर्तास्थ हरिप्रख्ये तद्वयमपि मान्विताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20011947,
    "chapter_id": 6687,
    "verse_number": "15.44",
    "content_sanskrit": "न जातु मोदिताहेऽहं प्रियसख्योऽन्तरेण वः । मोदिताध्वे न यूयञ्च ननु जातु विहाय माम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20011948,
    "chapter_id": 6687,
    "verse_number": "15.45",
    "content_sanskrit": "इत्युक्ताः परिरब्धारो वक्तारश्चोढसम्पदाः । ता मां वयं त्वयेत्युक्ता विनयेनेव केवलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20011949,
    "chapter_id": 6687,
    "verse_number": "15.46",
    "content_sanskrit": "ननु छायापदांभोजपरागकणिका इव । विनापि वचनं नेया गृहनाथे त्वया वयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20011950,
    "chapter_id": 6687,
    "verse_number": "15.47",
    "content_sanskrit": "इत्युक्त्वा कल्पितारस्तास्तदाऽनुगमनाय मे । क्लप्तारश्चाखिला दास्यः प्रस्थानाय मुदाऽऽकुलाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20011951,
    "chapter_id": 6687,
    "verse_number": "15.48",
    "content_sanskrit": "स्मर्ता तदा मया भ्रातुः स्मारिता च त्वया हरेः । द्वीपादागत्य तेनाऽऽवां द्राक् तदा दर्शितास्वहे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20011952,
    "chapter_id": 6687,
    "verse_number": "15.49",
    "content_sanskrit": "स स्वं रथं प्रदाता नौ ददिता च निजान् हयान् । योक्तारौ सैन्यसुग्रीवौ रथस्याऽग्रे तदा मया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20011953,
    "chapter_id": 6687,
    "verse_number": "15.50",
    "content_sanskrit": "पृष्ठे च युक्तौ स्यातारौ मेघपुष्पवलाहकौ । मया चोदयितारश्च ते तदा कृतशिक्षया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20011954,
    "chapter_id": 6687,
    "verse_number": "15.51",
    "content_sanskrit": "तदा गृहं प्रयातासि योद्धा कश्चित्त्वया यदि । विक्रमेण विजेतासे तरसा तं कुरुद्वहान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20011955,
    "chapter_id": 6687,
    "verse_number": "15.52",
    "content_sanskrit": "प्रेयसीमिति जल्पन्तीं प्रोक्तवान् फल्गुनः पुनः । अद्यैवाऽऽमन्त्रणं कार्यं पित्रोर्नौ प्रेमनिघ्नयोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20011956,
    "chapter_id": 6687,
    "verse_number": "15.53",
    "content_sanskrit": "अद्यैवाऽऽश्वासनीयौ तौ कालेन महताऽऽवयोः । न त्वाश्वासयितारौ श्वः क्षुल्लके गत्यनेहसि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20011957,
    "chapter_id": 6687,
    "verse_number": "15.54",
    "content_sanskrit": "इत्युक्तया तयोक्तिं तामोमिति प्रतिपन्नया । सह गत्वा नतस्सोऽङ्घ्रि देवकीवसुदेवयोः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20011958,
    "chapter_id": 6687,
    "verse_number": "15.55",
    "content_sanskrit": "आघ्रातमस्तकस्ताभ्यां सह वध्वा कपिध्वजः । विनयेनोपविश्येदं वाग्मी वचनमुक्तवान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20011959,
    "chapter_id": 6687,
    "verse_number": "15.56",
    "content_sanskrit": "अद्य मे खाण्डवप्रस्थप्रस्थानेनोत्सुकं मनः । स्वजने कः स्वदेशे च चिरदृष्टे न विक्लबः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20011960,
    "chapter_id": 6687,
    "verse_number": "15.57",
    "content_sanskrit": "तद्दत्वा मातरं कुन्तीं भ्रातॄनप्यतिवत्सलान् । द्रष्टास्वो नन्दितास्वश्च सुहृद्वन्धुसमागतौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20011961,
    "chapter_id": 6687,
    "verse_number": "15.58",
    "content_sanskrit": "आगत्य च पुरीमेतां पुनस्संक्रीडितास्वहे । देयाऽनुज्ञा तदावाभ्यां युवाभ्यां वत्सलौ गुरू ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20011962,
    "chapter_id": 6687,
    "verse_number": "15.59",
    "content_sanskrit": "इत्युक्तावुक्तवन्तौ तौ सबभ्रूकं धनञ्जयम् । शोकानन्दोष्णशीताश्रुगद्गदस्खलदक्षरम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20011963,
    "chapter_id": 6687,
    "verse_number": "15.60",
    "content_sanskrit": "वत्सौ वां युक्तमेवेदमेतास्वो यन्निजं गृहम् । यच्च संक्रीडितासाथे तत् मित्रादिभिस्सह ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20011964,
    "chapter_id": 6687,
    "verse_number": "15.61",
    "content_sanskrit": "जीवितास्वः कथं न्वावामिह वत्सौ विसृज्य वाम् । तद्गतित्वरयेदानीं पुरूहूतज पूर्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20011965,
    "chapter_id": 6687,
    "verse_number": "15.62",
    "content_sanskrit": "आवां यदि प्रतिष्ठासू युवामरहयिष्यतम् । शुचा घोरां दशामावामटीकिष्यावहि ध्रुवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20011966,
    "chapter_id": 6687,
    "verse_number": "15.63",
    "content_sanskrit": "वात्सल्यं नौ विदन् पार्थ प्रातिष्ठासिष्यथाः कथम् । नाऽज्ञास्यस्त्वमिदं किं वा धुर्यस्सन्धिषणावताम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20011967,
    "chapter_id": 6687,
    "verse_number": "15.64",
    "content_sanskrit": "असंभाव्यमशोचिष्यत् किमिष्टविरहे जनः । नाऽश्रद्धेयमरोत्स्याव नन्वावां युवयोर्गतिम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20011968,
    "chapter_id": 6687,
    "verse_number": "15.65",
    "content_sanskrit": "कौन्तेय मर्षणीयन्तत् त्वया वचनमावयोः । अमर्षणीयमावाभ्यामवक्ष्यस्त्वञ्च किं वचः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20011969,
    "chapter_id": 6687,
    "verse_number": "15.66",
    "content_sanskrit": "किन्नामाऽनवक्लृप्यं यत् पृथाऽग्लास्यत्त्वया विना । नाऽश्रद्धेयं न शर्माऽऽप्स्यं जातु कृष्ण त्वया विना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20011970,
    "chapter_id": 6687,
    "verse_number": "15.67",
    "content_sanskrit": "नाऽश्रद्धेयं त्वया यच्च नाऽरंस्यत विना नृपः । नचाऽमृष्यं विना यत्न भीमो नाऽरंस्यत त्वया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20011971,
    "chapter_id": 6687,
    "verse_number": "15.68",
    "content_sanskrit": "नच चित्रं त्वया यत्न नाऽरंस्यत विना नृपः । न च चित्रं विना यच्च भीमो नाऽरंस्यत त्वया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20011972,
    "chapter_id": 6687,
    "verse_number": "15.69",
    "content_sanskrit": "नकुलो 'रहितः पार्थ किमुताऽभोक्ष्यत त्वया । अपि नाऽप्यहसिष्यद्वा स नूनं सहदेववत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20011973,
    "chapter_id": 6687,
    "verse_number": "15.70",
    "content_sanskrit": "तत्राऽयमावयोः कामो नाऽयासस्त्वमितोऽधुना । गन्तव्यं तु त्वया पश्चात् कदाचित् कृष्ण आगते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20011974,
    "chapter_id": 6687,
    "verse_number": "15.71",
    "content_sanskrit": "इति संवदतां तेषां पीतवासा वियत्प्रभः । सदनं सहसाहृष्टः प्रविष्टो विष्टरश्रवाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20011975,
    "chapter_id": 6687,
    "verse_number": "15.72",
    "content_sanskrit": "वीक्ष्य मेघमिव चन्द्रकवन्तस्ते मुकुन्दमभिवन्दितवन्तः । स्वागतोक्तिमधरीकृतकेकां बाष्पशीतलदृशोऽभिदधानाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20011976,
    "chapter_id": 6687,
    "verse_number": "15.73",
    "content_sanskrit": "सदापि दृश्यमानस्तैस्तदा दृष्टस्स विस्मितैः । पदार्था दर्शनीया हि दर्शने दर्शनेन वा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20011977,
    "chapter_id": 6687,
    "verse_number": "15.74",
    "content_sanskrit": "सत्रा माता परिष्वज्य मूर्ध्न्युपाघ्राय वन्दितः । विनयानम्रदेहन्तमथाऽऽहानकदुन्दुभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20011978,
    "chapter_id": 6687,
    "verse_number": "15.75",
    "content_sanskrit": "गृहे मम जगन्नाथ त्वया चेन्नाऽजनिष्यथ । इह नाऽहममोदिष्ये दिवि वाऽमरनायकः ॥",
