[{"id": 2096502, "chapter_id": 3064, "verse_number": "१३-१९४-१", "content_sanskrit": "भीष्म उवाच।\nततः सर्वे महाभागा देवाश्च पितरश्च ह।\nऋषयश्च महाभागाः प्रमथान्वाक्यमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096503, "chapter_id": 3064, "verse_number": "१३-१९४-२", "content_sanskrit": "भवन्तो वै महाभागा अपरोक्षनिशाचराः।\nउच्छिष्टानशुचीन्क्षुद्रान्कथं हिसथ मानवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096504, "chapter_id": 3064, "verse_number": "१३-१९४-३", "content_sanskrit": "के च स्मृताः प्रतीघाता येन मर्त्यान्न हिंसथ।\nरक्षोघ्नानि च कानि स्युर्यैर्गृहेषु प्रणश्यथ।\nश्रोतुमिच्छाम युष्माकं सर्वमेतन्निशाचराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096505, "chapter_id": 3064, "verse_number": "१३-१९४-४x", "content_sanskrit": "प्रमथा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096506, "chapter_id": 3064, "verse_number": "१३-१९४-४", "content_sanskrit": "मैथुनेन सदोच्छिष्टाः कृते चैवाधरोत्तरे।\nमोहान्मांसानि खादेत वृक्षमूले च यः स्वपेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096507, "chapter_id": 3064, "verse_number": "१३-१९४-५", "content_sanskrit": "आमिषं शीर्षतो यस्य पादतो यश्च संविशेत्।\nतत उच्छिष्टकाः सर्वे बहुच्छिद्राश्च मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096508, "chapter_id": 3064, "verse_number": "१३-१९४-६", "content_sanskrit": "उदके चाप्यमेध्यानि श्लेष्माणं च प्रमुञ्चति।\nएते भक्ष्याश्च वध्याश्च मानुषा नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096509, "chapter_id": 3064, "verse_number": "१३-१९४-७", "content_sanskrit": "एवं शीलसमाचारान्धर्षयामो हि मानवान्।\nश्रूयतां च प्रतीघातान्यैर्न शक्नुम हिंसितुम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096510, "chapter_id": 3064, "verse_number": "१३-१९४-८", "content_sanskrit": "गोरोचनासमालम्भो वचाहस्तश्च यो भवेत्।\nघृताक्षतं च यो दद्यान्मस्तके तत्परायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096511, "chapter_id": 3064, "verse_number": "१३-१९४-९", "content_sanskrit": "ये च मांसं न खादन्ति तान्न शक्नुम हिंसितुम्।\nयस्य चाग्निर्गृहे नित्यं दिवारात्रौ च दीप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096512, "chapter_id": 3064, "verse_number": "१३-१९४-१०", "content_sanskrit": "तरक्षोश्चर्मदंष्ट्राश्च तथैव गिरिकच्छपः।\nआज्यधूमो बिडालश्च च्छागः कृष्णोऽत पिङ्गलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2096513, "chapter_id": 3064, "verse_number": "१३-१९४-११", "content_sanskrit": "येषामेतानि तिष्ठन्ति गृहेषु गृहमेधिनाम्।\nतान्यधृष्याण्यगाराणि पिशिताशैः सुदारुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2096514, "chapter_id": 3064, "verse_number": "१३-१९४-१२", "content_sanskrit": "लोकानस्मद्विधा ये च विचरन्ति यथासुखम्।\nतस्मादेतानि गेहेषु रक्षोघ्नानि विशाम्पते।\nएतद्वः कथितं सर्वं यत्र वः संशयो महान्॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2096515, "chapter_id": 3064, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि चतुर्नवत्यधिकशततमोऽध्यायः॥ १९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]