[{"id": 2026149, "chapter_id": 1558, "verse_number": "३-१९६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2026150, "chapter_id": 1558, "verse_number": "३-१९६-१", "content_sanskrit": "मार्कण्डेयमृषयो ब्राह्मणा युधिष्ठिरश्च।\nपर्यपृच्छन्नृषिः केन दीर्घायुरासीद्बकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2026151, "chapter_id": 1558, "verse_number": "३-१९६-२", "content_sanskrit": "मार्कण्डेयस्तु तान्सर्वान्प्रत्युवाच महातपाः।\nदीर्घायुश्च बकोराजन्नृषिर्नात्र विचारणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2026152, "chapter_id": 1558, "verse_number": "३-१९६-३", "content_sanskrit": "एतच्छ्रुत्वा तु कौन्तेयो भ्रातृभिः सह भारत।\nमार्कण्डेयं पर्यपृच्छद्धर्मराजो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2026153, "chapter_id": 1558, "verse_number": "३-१९६-४", "content_sanskrit": "बकदाल्भ्यौ महात्मानौ श्रूयेते चिरजीविनौ।\nसखायौ देवराजस् यतावृषी लोकसंमतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2026154, "chapter_id": 1558, "verse_number": "३-१९६-५", "content_sanskrit": "एतदिच्छामि भगवन्बकशक्रसमागमम्।\nसुखदुःखसमायुक्तं तत्त्वेन कथितं त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2026155, "chapter_id": 1558, "verse_number": "३-१९६-६x", "content_sanskrit": "मार्कण्डेय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2026156, "chapter_id": 1558, "verse_number": "३-१९६-६", "content_sanskrit": "वृत्ते देवासुरे राजन्संग्रामे रोमहर्षणे।\nत्रयाणामपि लोकानामिन्द्रो लोकाधिपोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2026157, "chapter_id": 1558, "verse_number": "३-१९६-७", "content_sanskrit": "सम्यग्वर्षति पर्जन्ये सस्यसंपद उत्तमाः।\nनिरामयाः सुधर्मिष्ठाः प्रजा धर्मपरायणाः।\nमुदितश्च जनः सर्वः स्वधर्मेषु व्यवस्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2026158, "chapter_id": 1558, "verse_number": "३-१९६-८", "content_sanskrit": "ताः प्रजा मुदिताः सर्वा दृष्ट्रा बलनिषूदनः।\nततस्तु मुदितोराजन्देवराजः शतक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2026159, "chapter_id": 1558, "verse_number": "३-१९६-९", "content_sanskrit": "ऐरावतं समास्थाय अपश्यन्मुदिताः प्रजाः।\nआश्रमांश्च विचित्रांश् नदीश्च विविधाः शुभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2026160, "chapter_id": 1558, "verse_number": "३-१९६-१०", "content_sanskrit": "नगराणि समृद्धानि घेटाञ्जनपदांस्तथा।\nप्रजापालनदक्षांश्च नरेन्द्रान्धर्मचारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2026161, "chapter_id": 1558, "verse_number": "३-१९६-११", "content_sanskrit": "उदपानं प्रपा वापी तटाकानि सरांसि च।\nनानाब्रह्रह्मसमाचारैः सेवितानि द्विजोततमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2026162, "chapter_id": 1558, "verse_number": "३-१९६-१२", "content_sanskrit": "ततोऽवतीर्य रम्यायां पृथ्व्यां राजञ्छतक्रतुः।\nतत्र रम्ये शिवे देशे बहुवृक्षसमाकुले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2026163, "chapter_id": 1558, "verse_number": "३-१९६-१३", "content_sanskrit": "पूर्वस्यां दिशि रम्यायां समुद्राभ्याशतो नृप।\nतत्राश्रमपदं रम्यं मृगद्विजनिषेवितम्।\nतत्राश्रमपदे रम्ये बकं पश्यति देवराट् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2026164, "chapter_id": 1558, "verse_number": "३-१९६-१४", "content_sanskrit": "बकस्तु दृष्ट्वा देवेन्द्रं दृढं प्रीतमनाऽभवत्।\nपाद्यासनार्थदानेन फलमूलैरथार्चयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2026165, "chapter_id": 1558, "verse_number": "३-१९६-१५", "content_sanskrit": "सुखोपविष्टो वरदस्ततस्तु बलसूदनः।\nततः प्रश्नं बकं देवं उवाच त्रिदशेश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2026166, "chapter_id": 1558, "verse_number": "३-१९६-१६", "content_sanskrit": "शतं वर्षसहस्राणि मुने जातस्य तेऽनघ।\nसमाख्याहि मम ब्रह्मन्किं दुःखं चिरजीविनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2026167, "chapter_id": 1558, "verse_number": "३-१९६-१७x", "content_sanskrit": "बक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2026168, "chapter_id": 1558, "verse_number": "३-१९६-१७", "content_sanskrit": "अप्रियैः सह संवासः प्रियैश्चापि विनाभवः।\nअसद्भिः संप्रयोगश्च तद्दुःखं चिरजीविनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2026169, "chapter_id": 1558, "verse_number": "३-१९६-१८", "content_sanskrit": "पुत्रदारविनाशोऽत्र ज्ञातीनां सुहृदामपि।\nपरेष्वायत्तता कृच्छ्रं किंनु दुःखतरं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2026170, "chapter_id": 1558, "verse_number": "३-१९६-१९", "content_sanskrit": "नान्यद्दुःखतरं किंचिल्लोकेषु प्रतिभाति मे।\nअर्थैर्विहीनः पुरुषः एरैः संपरिभूयते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2026171, "chapter_id": 1558, "verse_number": "३-१९६-२०", "content_sanskrit": "अकुलानां कुले भावं कुलीनानां कुलक्षयम्।\nसंयोगं विप्रयोगं च पश्यन्ति चिरजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2026172, "chapter_id": 1558, "verse_number": "३-१९६-२१", "content_sanskrit": "अपिप्रत्यक्षमेवैतत्तव देघ शतक्रतो।\nअकुलानां समृद्धानां कथं कुलविपर्ययः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2026173, "chapter_id": 1558, "verse_number": "३-१९६-२२", "content_sanskrit": "देवदानवगन्धर्वमनुष्योरगराक्षसाः।\nप्राप्नुवन्ति विपर्यासं किंनु दुःखतरं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2026174, "chapter_id": 1558, "verse_number": "३-१९६-२३", "content_sanskrit": "कुले जाताश् क्लिश्यन्ते दौष्कुलेयवशानुगाः।\nआढ्यैर्दरिद्राऽवमताः किंनु दुःखतरं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2026175, "chapter_id": 1558, "verse_number": "३-१९६-२४", "content_sanskrit": "लोके वैधर्म्यमेतत्तु दृश्ते बहुविस्तरम्।\nहीनज्ञानाश्च हृष्यन्ते क्लिश्यन्ते प्राज्ञकोविदाः।\nबहुदुःखपरिक्लेशं मानुष्यमिह दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2026176, "chapter_id": 1558, "verse_number": "३-१९६-२५x", "content_sanskrit": "इन्द्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2026177, "chapter_id": 1558, "verse_number": "३-१९६-२५", "content_sanskrit": "पुनरेव महाभाग देवर्षिगणसेवित।\nसमाख्याहि मम ब्रह्मन्किं सुखं चिरजीविनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2026178, "chapter_id": 1558, "verse_number": "३-१९६-२६x", "content_sanskrit": "बक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2026179, "chapter_id": 1558, "verse_number": "३-१९६-२६", "content_sanskrit": "अष्टमे द्वादशे वाऽपि शाकं यः पचते गृहे।\nकुमित्राण्यनपाश्रित् किं वै सुखतरं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2026180, "chapter_id": 1558, "verse_number": "३-१९६-२७", "content_sanskrit": "यत्राहानि न गण्यन्ते नैनमाहुर्महाशनम्।\nअपि शाकं पचानस्य सुखं वै मघवन्गृहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2026181, "chapter_id": 1558, "verse_number": "३-१९६-२८", "content_sanskrit": "आर्जितं स्वेन वीर्येण नाप्यपाश्रित्य कंचन।\nफलशाकमपि श्रेयो भोक्तुं ह्यकृपणं गृहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2026182, "chapter_id": 1558, "verse_number": "३-१९६-२९", "content_sanskrit": "परस्य तु गृहे भोक्तुः परिभूतस् नित्यशः।\nसुमृष्टमपि न श्रेयो विकल्पोऽयमतः सताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2026183, "chapter_id": 1558, "verse_number": "३-१९६-३०", "content_sanskrit": "श्ववद्धि लोलुपो यस्तु परान्नं भोक्तुमिच्छति।\nधिगस्तु तस्य तद्भुक्तं कृपणस् दुरात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2026184, "chapter_id": 1558, "verse_number": "३-१९६-३१", "content_sanskrit": "यो दत्त्वाऽतिथिभृत्येभ्यः पितृभ्यश्च द्विजोत्तमः।\nशिष्टान्यन्नानि यो भुङ्क्ते किं वै सुखतरं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2026185, "chapter_id": 1558, "verse_number": "३-१९६-३२", "content_sanskrit": "अतो मृष्टतरं नान्यत्पूतं किंचितच्छतक्रतो।\nदत्त्वा यस्त्वतिथिभ्योऽन्नं भुङ्क्ते तेनैव नित्यशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2026186, "chapter_id": 1558, "verse_number": "३-१९६-३३", "content_sanskrit": "तावतां गोसहस्राणां फलं प्राप्नोति दायकः।\nयदेनो यौवनकृतंतत्सर्वं नश्यते ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2026187, "chapter_id": 1558, "verse_number": "३-१९६-३४", "content_sanskrit": "रसदक्षिणस् भुक्तस् द्विजस्य तु करे गतम्।\nयद्वारि वारिणा सिञ्चेत्तद्ध्येनस्तरते क्षणात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2026188, "chapter_id": 1558, "verse_number": "३-१९६-३५", "content_sanskrit": "एताश्चान्याश्च वै बह्वीः कथयित्वा कथाः शुभाः।\nबकेन सह देवेन्द्र आपृच्छ्य त्रिदिवं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2026189, "chapter_id": 1558, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि मार्कण्डेयसमास्यापर्वणि षणअणवत्यधिकशततमोऽध्यायः ॥ १९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]