[{"id": 7000611000, "chapter_id": 20611, "verse_number": "५-७०-१", "content_sanskrit": "पार्वत्युवाच ।\nयदाकर्णनमेतस्य ये वा पारिषदाः प्रभोः ।\nतदहं श्रोतुमिच्छामि कथयस्व दयानिधे॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000611001, "chapter_id": 20611, "verse_number": "५-७०-२", "content_sanskrit": "ईश्वर उवाच ।\nराधया सह गोविंदं स्वर्णसिंहासनेस्थितम् ।\nपूर्वोक्तरूपलावण्यं दिव्यभूषांबरस्रजम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000611002, "chapter_id": 20611, "verse_number": "५-७०-३", "content_sanskrit": "त्रिभंगी मंजु सुस्निग्धं गोपीलोचनतारकम् ।\nतद्बाह्ये योगपीठे च स्वर्णसिंहासनावृते॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000611003, "chapter_id": 20611, "verse_number": "५-७०-४", "content_sanskrit": "प्रत्यंगरभसावेशाः प्रधानाः कृष्णवल्लभाः ।\nललिताद्याः प्रकृत्यंशा मूलप्रकृतिराधिका॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000611004, "chapter_id": 20611, "verse_number": "५-७०-५", "content_sanskrit": "संमुखे ललिता देवी श्यामला वायुकोणके ।\nउत्तरे श्रीमती धन्या एशान्यां श्रीहरिप्रिया॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000611005, "chapter_id": 20611, "verse_number": "५-७०-६", "content_sanskrit": "विशाखा च तथा पूर्वे शैब्या चाग्नौ ततः परम् ।\nपद्मा च दक्षिणे पश्चान्नैरृते क्रमशः स्थिताः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000611006, "chapter_id": 20611, "verse_number": "५-७०-७", "content_sanskrit": "योगपीठे केसराग्रे चारु चंद्रावती प्रिया ।\nअष्टौ प्रकृतयः पुण्याः प्रधानाः कृष्णवल्लभाः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000611007, "chapter_id": 20611, "verse_number": "५-७०-८", "content_sanskrit": "प्रधानप्रकृतिस्त्वाद्या राधा चंद्रावती समा ।\nचंद्रावली चित्ररेखा चंद्रा मदनसुंदरी॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000611008, "chapter_id": 20611, "verse_number": "५-७०-९", "content_sanskrit": "प्रिया च श्रीमधुमती चंद्ररेखा हरिप्रिया ।\nषोडशाद्याः प्रकृतयः प्रधानाः कृष्णवल्लभाः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000611009, "chapter_id": 20611, "verse_number": "५-७०-१०", "content_sanskrit": "वृंदावनेश्वरी राधा तथा चंद्रावली प्रिया ।\nअभिन्नगुणलावण्य सौंदर्याश्चारुलोचनाः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000611010, "chapter_id": 20611, "verse_number": "५-७०-११", "content_sanskrit": "मनोहरा मुग्धवेषाः किशोरीवयसोज्ज्वलाः ।\nअग्रेतनास्तथा चान्या गोपकन्याः सहस्रशः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000611011, "chapter_id": 20611, "verse_number": "५-७०-१२", "content_sanskrit": "शुद्धकांचनपुंजाभाः सुप्रसन्नाः सुलोचनाः ।\nतद्रूपहृदयारूढास्तदाश्लेष समुत्सुकाः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000611012, "chapter_id": 20611, "verse_number": "५-७०-१३", "content_sanskrit": "श्यामामृतरसे मग्नाः स्फुरत्तद्भावमानसाः ।\nनेत्रोत्पलार्चिते कृष्णपादाब्जेऽपितचेतसः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000611013, "chapter_id": 20611, "verse_number": "५-७०-१४", "content_sanskrit": "श्रुतिकन्यास्ततो दक्षे सहस्रायुतसंयुताः ।\nजगन्मुग्धीकृताकारा हृद्वर्तिकृष्णलालसाः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000611014, "chapter_id": 20611, "verse_number": "५-७०-१५", "content_sanskrit": "नानासत्वस्वरालापमुग्धीकृतजगत्त्रयाः ।\nतत्र गूढरहस्यानि गायंत्यः प्रेमविह्वलाः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000611015, "chapter_id": 20611, "verse_number": "५-७०-१६", "content_sanskrit": "देवकन्यास्ततः सव्ये दिव्यवेषारसोज्ज्वलाः ।\nनानावैदिग्ध्यनिपुणा दिव्यभावभरान्विताः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000611016, "chapter_id": 20611, "verse_number": "५-७०-१७", "content_sanskrit": "सौंदर्यातिशयेनाढ्याः कटाक्षातिमनोहराः ।\nनिर्लज्जास्तत्र गोविंदे तदंगस्पर्शनोद्यताः॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000611017, "chapter_id": 20611, "verse_number": "५-७०-१८", "content_sanskrit": "तद्भावमग्नमनसः स्मितसाचि निरीक्षणाः ।\nमंदिरस्य ततो बाह्ये प्रियया विशदावृते॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000611018, "chapter_id": 20611, "verse_number": "५-७०-१९", "content_sanskrit": "समानवेषवयसः समानबलपौरुषाः ।\nसमानगुणकर्माणः समानाभरणप्रियाः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000611019, "chapter_id": 20611, "verse_number": "५-७०-२०", "content_sanskrit": "समानस्वरसंगीत वेणुवादनतत्पराः ।\nश्रीदामा पश्चिमे द्वारे वसुदामा तथोत्तरे॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000611020, "chapter_id": 20611, "verse_number": "५-७०-२१", "content_sanskrit": "सुदामा च तथा पूर्वे किंकिणी चापि दक्षिणे ।\nतद्बाह्ये स्वर्णपीठे च सुवर्णमंदिरावृते॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000611021, "chapter_id": 20611, "verse_number": "५-७०-२२", "content_sanskrit": "स्वर्णवेद्यंतरस्थे तु स्वर्णाभरणभूषिते ।\nस्तोककृष्णं सुभद्राद्यैर्गोपालैरयुतायुतैः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000611022, "chapter_id": 20611, "verse_number": "५-७०-२३", "content_sanskrit": "शृंगवीणावेणुवेत्रवयोवेषाकृतिस्वरैः ।\nतद्गुणध्यानसंयुक्तैर्गायद्भिरपि विह्वलैः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000611023, "chapter_id": 20611, "verse_number": "५-७०-२४", "content_sanskrit": "चित्रार्पितैश्चित्ररूपैः सदानंदाश्रुवर्षिभिः ।\nपुलकाकुलसर्वांगैर्योगींद्रैरिव विस्मितैः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000611024, "chapter_id": 20611, "verse_number": "५-७०-२५", "content_sanskrit": "क्षरत्ययोभिर्गोविंदैरसंख्यातैरुपावृतम् ।\nतद्बाह्ये स्वर्णप्राकारे कोटिसूर्यसमुज्जवले॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000611025, "chapter_id": 20611, "verse_number": "५-७०-२६", "content_sanskrit": "चतुर्दिक्षुमहोद्यानं मंजुसौरभमोहिते ।\nपश्चिमे संमुखे श्रीमत्पारिजातद्रुमाश्रये॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000611026, "chapter_id": 20611, "verse_number": "५-७०-२७", "content_sanskrit": "तदधस्तु स्वर्णपीठे स्वर्णमंडनमंडिते ।\nतन्मध्ये मणिमाणिक्य दिव्यसिंहासनोज्ज्वले॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000611027, "chapter_id": 20611, "verse_number": "५-७०-२८", "content_sanskrit": "तत्रोपरि परानंदं वासुदेवं जगत्प्रभुम् ।\nत्रिगुणातीतचिद्रूपं सर्वकारणकारणम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000611028, "chapter_id": 20611, "verse_number": "५-७०-२९", "content_sanskrit": "इंद्रनीलघनश्यामं नीलकुंचितकुंतलम् ।\nपद्मपत्रविशालाक्षं मकराकृतिकुंडलम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000611029, "chapter_id": 20611, "verse_number": "५-७०-३०", "content_sanskrit": "चतुर्भुजं तु चक्रासिगदाशंखांबुजायुधम् ।\nआद्यंतरहितं नित्यं प्रधानं पुरुषोत्तमम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000611030, "chapter_id": 20611, "verse_number": "५-७०-३१", "content_sanskrit": "ज्योतीरूपं महद्धाम पुराणं वनमालिनम् ।\nपीतांबरधरं स्निग्धं दिव्यभूषणभूषितम्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000611031, "chapter_id": 20611, "verse_number": "५-७०-३२", "content_sanskrit": "दिव्यानुलेपनं राजच्चित्रितांग मनोहरम् ।\nरुक्मिणी सत्यभामा च नाग्नजिती सुलक्षणा॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000611032, "chapter_id": 20611, "verse_number": "५-७०-३३", "content_sanskrit": "मित्रविंदानुविंदा सुनंदा जांबवती प्रिया ।\nसुशीला चाष्टमहिला वासुदेवप्रियास्ततः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000611033, "chapter_id": 20611, "verse_number": "५-७०-३४", "content_sanskrit": "उद्भ्राजिताः पारिषदा वृतयोर्भक्तितत्पराः ।\nउत्तरे सुमहोद्याने हरिचंदनसंश्रये॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000611034, "chapter_id": 20611, "verse_number": "५-७०-३५", "content_sanskrit": "तत्राधस्तु स्वर्णपीठे मणिमंडपमंडिते ।\nतन्मध्ये हेमनिर्माणदले सिंहासनोज्जवले॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000611035, "chapter_id": 20611, "verse_number": "५-७०-३६", "content_sanskrit": "तत्रैव सह रेवत्या संकर्षण हलायुधम् ।\nईश्वरस्य प्रियानंतमभिन्नगुणरूपिणम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000611036, "chapter_id": 20611, "verse_number": "५-७०-३७", "content_sanskrit": "शुद्धस्फटिकसंकाशं रक्तांबुज दलेक्षणम् ।\nनीलपट्टधरं स्निग्धं दिव्यभूषास्रगंबरम्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000611037, "chapter_id": 20611, "verse_number": "५-७०-३८", "content_sanskrit": "मधुपाने सदासक्तं मधुघूर्णितलोचनम् ।\nप्रवीरदक्षिणेभागे मंजुनाभ्यंतरस्थिते॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000611038, "chapter_id": 20611, "verse_number": "५-७०-३९", "content_sanskrit": "संतानवृक्षमूले तु मणिमंदिरमंडितम् ।\nतन्मध्ये मणिमाणिक्य दिव्यसिंहासनोज्ज्वले॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000611039, "chapter_id": 20611, "verse_number": "५-७०-४०", "content_sanskrit": "प्रद्युम्नं च रती देवं तत्रोपरिसुखस्थितम् ।\nजगन्मोहनसौंदर्य्यसारश्रेणीरसात्मकम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000611040, "chapter_id": 20611, "verse_number": "५-७०-४१", "content_sanskrit": "असितांभोजपुंजाभमरविंददलेक्षणम् ।\nदिव्यालंकारभूषाभिर्दिव्यगंधानुलेपनम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000611041, "chapter_id": 20611, "verse_number": "५-७०-४२", "content_sanskrit": "जगन्मुग्धीकृताशेष सौंदर्याश्चर्यविग्रहम् ।\nपूर्वोद्याने महारण्ये सुरद्रुम समाश्रये॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000611042, "chapter_id": 20611, "verse_number": "५-७०-४३", "content_sanskrit": "तत्राधस्तु स्वर्णपीठे हेममंडपमंडिते ।\nतस्य मध्ये स्थिरे राजद्दिव्यसिंहासनोज्ज्वले॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000611043, "chapter_id": 20611, "verse_number": "५-७०-४४", "content_sanskrit": "दिव्योषयासमं श्रीमदनिरुद्धं जगत्पतिम् ।\nसांद्रानंदघनश्यामं सुस्निग्धं नीलकुंतलम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000611044, "chapter_id": 20611, "verse_number": "५-७०-४५", "content_sanskrit": "सुभ्रून्नतलताभंगीं सुकपोलं सुनासिकम् ।\nसुग्रीवं सुंदरं वक्षो मनोहर मनोहरम्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000611045, "chapter_id": 20611, "verse_number": "५-७०-४६", "content_sanskrit": "किरीटिनं कुंडलिनं कंठभूषाविभूषितम् ।\nमंजुमंजीरमाधुर्यादतिसौंदर्य विग्रहम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000611046, "chapter_id": 20611, "verse_number": "५-७०-४७", "content_sanskrit": "प्रियभृत्यगणाराध्यं यत्र संगीतकप्रियम् ।\nपूर्णब्रह्मसदानंदं शुद्धसत्वस्वरूपकम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000611047, "chapter_id": 20611, "verse_number": "५-७०-४८", "content_sanskrit": "तस्योर्द्ध्वे चांतरिक्षे च विष्णुं सर्वेश्वरेश्वरम् ।\nअनादिमादिचिद्रूपं चिदानंदं परं विभुम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000611048, "chapter_id": 20611, "verse_number": "५-७०-४९", "content_sanskrit": "त्रिगुणातीतमव्यक्तं नित्यमक्षयमव्ययम् ।\nसमेघपुंजमाधुर्यसौंदर्यश्यामविग्रहम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000611049, "chapter_id": 20611, "verse_number": "५-७०-५०", "content_sanskrit": "नीलकुंचितसुस्निग्ध केशपाशातिसुंदरम् ।\nअरविंददलस्निग्ध सुदीर्घचारुलोचनम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000611050, "chapter_id": 20611, "verse_number": "५-७०-५१", "content_sanskrit": "किरीटकुंडलोद्गंड शुद्धसत्वात्मभिर्वृतम् ।\nआत्मारामैश्च चिद्रूपैस्तन्मूर्तिध्यानतत्परैः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000611051, "chapter_id": 20611, "verse_number": "५-७०-५२", "content_sanskrit": "हृदयारूढ तद्ध्य्नौर्नासाग्रन्यस्तलोचनैः ।\nक्रियतेऽहैतुकीभक्तिः कायहृद्वृत्तिभाषितैः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000611052, "chapter_id": 20611, "verse_number": "५-७०-५३", "content_sanskrit": "तत्सव्ये यक्षगंधर्वसिद्धविद्याधरादिभिः ।\nसुकांतैरप्सरःसंघैर्नृत्यसंगीततत्परैः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000611053, "chapter_id": 20611, "verse_number": "५-७०-५४", "content_sanskrit": "तदंगभजनं कामं वांछद्भिः कृष्णलालसैः ।\nतदग्रे वैष्णवैः सर्वैश्चांतरिक्षे सुखासने॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000611054, "chapter_id": 20611, "verse_number": "५-७०-५५", "content_sanskrit": "प्रह्लादनारदाद्यैश्च कुमारशुकवैष्णवैः ।\nजनकाद्यैर्लसद्भावैर्हृद्बाह्य स्फूर्तितत्परैः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000611055, "chapter_id": 20611, "verse_number": "५-७०-५६", "content_sanskrit": "पुलकाकुलसर्वांगैः स्फुरत्प्रेमसमाकुलैः ।\nरहस्यामृतसंसिक्तैरर्द्धयुग्माक्षरो मनुः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000611056, "chapter_id": 20611, "verse_number": "५-७०-५७", "content_sanskrit": "मंत्रचूडामणिः प्रोक्तः सर्वमंत्रैककारणम् ।\nसर्वदेवस्य मंत्राणां कैशोरं मंत्रहेतुकम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000611057, "chapter_id": 20611, "verse_number": "५-७०-५८", "content_sanskrit": "सर्वकैशोरमंत्राणां हेतुश्चूडामणिर्मनुः ।\nजपं कुर्वंति मनसा पूर्णप्रेमसुखाश्रयाः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000611058, "chapter_id": 20611, "verse_number": "५-७०-५९", "content_sanskrit": "वांछंति तत्पदांभोजे निश्चलं प्रेमसाधनम् ।\nतद्बाह्ये स्फटिकाद्युच्च प्रावारे सुमनोहरे॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000611059, "chapter_id": 20611, "verse_number": "५-७०-६०", "content_sanskrit": "कुंकुमैः सितरक्ताद्यैश्चतुर्दिक्षु समाकुलैः ।\nशुक्लं चतुर्भुजं विष्णुं पश्चिमे द्वारपालकम्॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000611060, "chapter_id": 20611, "verse_number": "५-७०-६१", "content_sanskrit": "शंखचक्रगदापद्मकिरीटादि विभूषितम् ।\nरक्तं चतुर्भुजं पद्मशंखचक्रगदायुधम्॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000611061, "chapter_id": 20611, "verse_number": "५-७०-६२", "content_sanskrit": "किरीटकुंडलोद्दीप्त द्वारपालकमुत्तरे ।\nगौरं चतुर्भुजं विष्णुं शुखचक्रगदायुधम्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000611062, "chapter_id": 20611, "verse_number": "५-७०-६३", "content_sanskrit": "किरीटकुंडलाद्यैश्च शोभितं वनमालिनम् ।\nपूर्वद्वारे द्वारपालं गौरं विष्णुं प्रकीर्तितम्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000611063, "chapter_id": 20611, "verse_number": "५-७०-६४", "content_sanskrit": "कृष्णवर्णं चतुर्बाहुं शंखचक्रादिभूषणम् ।\nदक्षिणद्वारपालं तु श्रीविष्णुंकृष्णवर्णकम्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000611064, "chapter_id": 20611, "verse_number": "५-७०-६५", "content_sanskrit": "श्रीकृष्णचरितं ह्येतद्यः पठेत्प्रयतः शुचिः ।\nशृणुयाद्वापि यो भक्त्या गोविंदे लभते रतिम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]