[{"id": 5000245000, "chapter_id": 9245, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे एकोनपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000245001, "chapter_id": 9245, "verse_number": "३-४९-१", "content_sanskrit": "सीताया वचनं श्रुत्वा दशग्रीवः प्रतापवान्।\nहस्ते हस्तं समाहत्य चकार सुमहद् वपुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000245002, "chapter_id": 9245, "verse_number": "३-४९-२", "content_sanskrit": "स मैथिलीं पुनर्वाक्यं बभाषे वाक्यकोविदः।\nनोन्मत्तया श्रुतौ मन्ये मम वीर्यपराक्रमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000245003, "chapter_id": 9245, "verse_number": "३-४९-३", "content_sanskrit": "उद्वहेयं भुजाभ्यां तु मेदिनीमम्बरे स्थितः।\nआपिबेयं समुद्रं च मृत्युं हन्यां रणे स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000245004, "chapter_id": 9245, "verse_number": "३-४९-४", "content_sanskrit": "अर्कं तुद्यां शरैस्तीक्ष्णैर्विभिन्द्यां हि महीतलम्।\nकामरूपेण उन्मत्ते पश्य मां कामरूपिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000245005, "chapter_id": 9245, "verse_number": "३-४९-५", "content_sanskrit": "एवमुक्तवतस्तस्य रावणस्य शिखिप्रभे।\nक्रुद्धस्य हरिपर्यन्ते रक्ते नेत्रे बभूवतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000245006, "chapter_id": 9245, "verse_number": "३-४९-६", "content_sanskrit": "सद्यः सौम्यं परित्यज्य तीक्ष्णरूपं स रावणः।\nस्वं रूपं कालरूपाभं भेजे वैश्रवणानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000245007, "chapter_id": 9245, "verse_number": "३-४९-७", "content_sanskrit": "संरक्तनयनः श्रीमांस्तप्तकाञ्चनभूषणः।\nक्रोधेन महताविष्टो नीलजीमूतसंनिभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000245008, "chapter_id": 9245, "verse_number": "३-४९-८", "content_sanskrit": "दशास्यो विंशतिभुजो बभूव क्षणदाचरः।\nस परिव्राजकच्छद्म महाकायो विहाय तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000245009, "chapter_id": 9245, "verse_number": "३-४९-९", "content_sanskrit": "प्रतिपेदे स्वकं रूपं रावणो राक्षसाधिपः।\nरक्ताम्बरधरस्तस्थौ स्त्रीरत्नं प्रेक्ष्य मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000245010, "chapter_id": 9245, "verse_number": "३-४९-१०", "content_sanskrit": "स तामसितकेशान्तां भास्करस्य प्रभामिव।\nवसनाभरणोपेतां मैथिलीं रावणोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000245011, "chapter_id": 9245, "verse_number": "३-४९-११", "content_sanskrit": "त्रिषु लोकेषु विख्यातं यदि भर्तारमिच्छसि।\nमामाश्रय वरारोहे तवाहं सदृशः पतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000245012, "chapter_id": 9245, "verse_number": "३-४९-१२", "content_sanskrit": "मां भजस्व चिराय त्वमहं श्लाघ्यः पतिस्तव।\nनैव चाहं क्वचिद् भद्रे करिष्ये तव विप्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000245013, "chapter_id": 9245, "verse_number": "३-४९-१३", "content_sanskrit": "त्यज्यतां मानुषो भावो मयि भावः प्रणीयताम्।\nराज्याच्च्युतमसिद्धार्थं रामं परिमितायुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000245014, "chapter_id": 9245, "verse_number": "३-४९-१४", "content_sanskrit": "कैर्गुणैरनुरक्तासि मूढे पण्डितमानिनि।\nयः स्त्रियो वचनाद् राज्यं विहाय ससुहृज्जनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000245015, "chapter_id": 9245, "verse_number": "३-४९-१५", "content_sanskrit": "अस्मिन् व्यालानुचरिते वने वसति दुर्मतिः।\nइत्युक्त्वा मैथिलीं वाक्यं प्रियार्हां प्रियवादिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000245016, "chapter_id": 9245, "verse_number": "३-४९-१६", "content_sanskrit": "अभिगम्य सुदुष्टात्मा राक्षसः काममोहितः।\nजग्राह रावणः सीतां बुधः खे रोहिणीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000245017, "chapter_id": 9245, "verse_number": "३-४९-१७", "content_sanskrit": "वामेन सीतां पद्माक्षीं मूर्धजेषु करेण सः।\nऊर्वोस्तु दक्षिणेनैव परिजग्राह पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000245018, "chapter_id": 9245, "verse_number": "३-४९-१८", "content_sanskrit": "तं दृष्ट्वा गिरिशृङ्गाभं तीक्ष्णदंष्ट्रं महाभुजम्।\nप्राद्रवन् मृत्युसंकाशं भयार्ता वनदेवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000245019, "chapter_id": 9245, "verse_number": "३-४९-१९", "content_sanskrit": "स च मायामयो दिव्यः खरयुक्तः खरस्वनः।\nप्रत्यदृश्यत हेमाङ्गो रावणस्य महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000245020, "chapter_id": 9245, "verse_number": "३-४९-२०", "content_sanskrit": "ततस्तां परुषैर्वाक्यैरभितर्ज्य महास्वनः।\nअंकेनादाय वैदेहीं रथमारोपयत् तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000245021, "chapter_id": 9245, "verse_number": "३-४९-२१", "content_sanskrit": "सा गृहीतातिचुक्रोश रावणेन यशस्विनी।\nरामेति सीता दुःखार्ता रामं दूरं गतं वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000245022, "chapter_id": 9245, "verse_number": "३-४९-२२", "content_sanskrit": "तामकामां स कामार्तः पन्नगेन्द्रवधूमिव।\nविचेष्टमानामादाय उत्पपाताथ रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000245023, "chapter_id": 9245, "verse_number": "३-४९-२३", "content_sanskrit": "ततः सा राक्षसेन्द्रेण ह्रियमाणा विहायसा।\nभृशं चुक्रोश मत्तेव भ्रान्तचित्ता यथातुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000245024, "chapter_id": 9245, "verse_number": "३-४९-२४", "content_sanskrit": "हा लक्ष्मण महाबाहो गुरुचित्तप्रसादक।\nह्रियमाणां न जानीषे रक्षसा कामरूपिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000245025, "chapter_id": 9245, "verse_number": "३-४९-२५", "content_sanskrit": "जीवितं सुखमर्थं च धर्महेतोः परित्यजन्।\nह्रियमाणामधर्मेण मां राघव न पश्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000245026, "chapter_id": 9245, "verse_number": "३-४९-२६", "content_sanskrit": "ननु नामाविनीतानां विनेतासि परंतप।\nकथमेवंविधं पापं न त्वं शाधि हि रावणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000245027, "chapter_id": 9245, "verse_number": "३-४९-२७", "content_sanskrit": "न तु सद्योऽविनीतस्य दृश्यते कर्मणः फलम्।\nकालोऽप्यङ्गीभवत्यत्र सस्यानामिव पक्तये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000245028, "chapter_id": 9245, "verse_number": "३-४९-२८", "content_sanskrit": "त्वं कर्म कृतवानेतत् कालोपहतचेतनः।\nजीवितान्तकरं घोरं रामाद् व्यसनमाप्नुहि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000245029, "chapter_id": 9245, "verse_number": "३-४९-२९", "content_sanskrit": "हन्तेदानीं सकामा तु कैकेयी बान्धवैः सह।\nह्रियेयं धर्मकामस्य धर्मपत्नी यशस्विनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000245030, "chapter_id": 9245, "verse_number": "३-४९-३०", "content_sanskrit": "आमन्त्रये जनस्थाने कर्णिकारांश्च पुष्पितान्।\nक्षिप्रं रामाय शंसध्वं सीतां हरति रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000245031, "chapter_id": 9245, "verse_number": "३-४९-३१", "content_sanskrit": "हंससारससंघुष्टां वन्दे गोदावरीं नदीम्।\nक्षिप्रं रामाय शंस त्वं सीतां हरति रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000245032, "chapter_id": 9245, "verse_number": "३-४९-३२", "content_sanskrit": "दैवतानि च यान्यस्मिन् वने विविधपादपे।\nनमस्करोम्यहं तेभ्यो भर्तुः शंसत मां हृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000245033, "chapter_id": 9245, "verse_number": "३-४९-३३", "content_sanskrit": "यानि कानिचिदप्यत्र सत्त्वानि विविधानि च।\nसर्वाणि शरणं यामि मृगपक्षिगणानि वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000245034, "chapter_id": 9245, "verse_number": "३-४९-३४", "content_sanskrit": "ह्रियमाणां प्रियां भर्तुः प्राणेभ्योऽपि गरीयसीम्।\nविवशा ते हृता सीता रावणेनेति शंसत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000245035, "chapter_id": 9245, "verse_number": "३-४९-३५", "content_sanskrit": "विदित्वा तु महाबाहुरमुत्रापि महाबलः।\nआनेष्यति पराक्रम्य वैवस्वतहृतामपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000245036, "chapter_id": 9245, "verse_number": "३-४९-३६", "content_sanskrit": "सा तदा करुणा वाचो विलपन्ती सुदुःखिता।\nवनस्पतिगतं गृध्रं ददर्शायतलोचना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000245037, "chapter_id": 9245, "verse_number": "३-४९-३७", "content_sanskrit": "सा तमुद्वीक्ष्य सुश्रोणी रावणस्य वशंगता।\nसमाक्रन्दद् भयपरा दुःखोपहतया गिरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000245038, "chapter_id": 9245, "verse_number": "३-४९-३८", "content_sanskrit": "जटायो पश्य मामार्य ह्रियमाणामनाथवत्।\nअनेन राक्षसेन्द्रेणाकरुणं पापकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000245039, "chapter_id": 9245, "verse_number": "३-४९-३९", "content_sanskrit": "नैष वारयितुं शक्यस्त्वया क्रूरो निशाचरः।\nसत्ववाञ्जितकाशी च सायुधश्चैव दुर्मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000245040, "chapter_id": 9245, "verse_number": "३-४९-४०", "content_sanskrit": "रामाय तु यथातत्त्वं जटायो हरणं मम।\nलक्ष्मणाय च तत् सर्वमाख्यातव्यमशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000245041, "chapter_id": 9245, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे एकोनपञ्चाशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]