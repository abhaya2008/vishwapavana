[{"id": 40016241, "chapter_id": 9245, "verse_number": "1", "content_sanskrit": "अकम्पनवधंश्रुत्वाक्रुद्धोवैराक्षसेश्वरः । किञ्चिददीनमुखश्चापिसचिवांस्तानुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40016242, "chapter_id": 9245, "verse_number": "2", "content_sanskrit": "सतुध्यात्वामुहूर्तंतुमन्त्रिभिस्संविचार्यच । ततस्तुरावणःपूर्वदिवसेराक्षसाधिपः ॥ पुरींपरिययौलङ्कांसर्वगुल्मानवेक्षितुम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40016243, "chapter_id": 9245, "verse_number": "3", "content_sanskrit": "तांराक्षसगणैर्गुप्तांगुल्मैर्बहुभिरावृताम् ॥ ददर्शनगरींलङ्कांपताकाध्वजमालिनीम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40016244, "chapter_id": 9245, "verse_number": "4", "content_sanskrit": "रुद्धांतुनगरींदृष्टवारावणोराक्षसेश्वरः ॥ उवाचात्महितंकालेप्रहस्तंयुद्धकोविदम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40016245, "chapter_id": 9245, "verse_number": "5", "content_sanskrit": "पुरस्योपनिविष्टस्यसहसापीडितस्यवा ॥ नान्यंयुद्धात्प्रपश्यामिमोक्षंयुद्धविशारद ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40016246, "chapter_id": 9245, "verse_number": "6", "content_sanskrit": "अहंवाकुम्भकर्णोवात्वंवासेनापतिर्मम ॥ इन्द्रजिद्वानिकुम्भोवावहेयुर्भारमीदृशम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40016247, "chapter_id": 9245, "verse_number": "7", "content_sanskrit": "सत्वंबलमतश्शीघ्रमादायपरिगृह्यच ॥ विजयायाभिनिर्याहियत्रसर्वेवनौकसः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40016248, "chapter_id": 9245, "verse_number": "8", "content_sanskrit": "निर्याणायादेवतेनूनंचपलाहरिवाहिनी ॥ नर्दतांराक्षसेन्द्राणांश्रुत्वानादंद्रविष्यति ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40016249, "chapter_id": 9245, "verse_number": "9", "content_sanskrit": "चपलाह्यविनीताश्चचलचित्ताश्चवानराः ॥ नसहिष्यन्तितेनादंसिंहनादमिवद्विपाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40016250, "chapter_id": 9245, "verse_number": "10", "content_sanskrit": "विद्रुतेचबलेतस्मिन् रामःसौमित्रिणासह ॥ अवशस्तेनिरालम्बःप्रहस्तवशमेष्यति ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40016251, "chapter_id": 9245, "verse_number": "11", "content_sanskrit": "आपत्संशयिताश्रेयोनात्रनिस्संशयीकृता ॥ प्रतिलोमानुलोमंवायद्वानोमन्यसेहितम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40016252, "chapter_id": 9245, "verse_number": "12", "content_sanskrit": "रावणेनैवमुक्तस्तुप्रहस्तोवाहिनीपतिः ॥ राक्षसेन्द्रमुवाचेदमसुरेन्द्रमिवोशना ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40016253, "chapter_id": 9245, "verse_number": "13", "content_sanskrit": "राजन्मन्त्रितपूर्वंनःकुशलैस्सहमन्त्रिभिः ॥ विवादश्चापिनोवृत्तस्समवेक्ष्यपरस्परम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40016254, "chapter_id": 9245, "verse_number": "14", "content_sanskrit": "प्रदानेनतुसीतायाःश्रेयोव्यवसितंमया ॥ अप्रदानेपुनर्युद्धंदृष्टमेत्तथैवनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40016255, "chapter_id": 9245, "verse_number": "15", 