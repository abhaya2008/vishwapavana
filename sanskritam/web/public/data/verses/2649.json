[{"id": 2077820, "chapter_id": 2649, "verse_number": "१२-१५४-०x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077821, "chapter_id": 2649, "verse_number": "१२-१५४-१", "content_sanskrit": "बन्धुत्वादथवा सख्याच्छाल्मले नात्र संशयः।\nकस्मात्त्वां रक्षते नित्यं भीमः सर्वत्रगोऽनिलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077822, "chapter_id": 2649, "verse_number": "१२-१५४-२", "content_sanskrit": "तद्भावं परमं वायोः शाल्मके त्वमुपागतः।\nतवाहमस्मीति सदा येन रक्षति मारुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077823, "chapter_id": 2649, "verse_number": "१२-१५४-३", "content_sanskrit": "न तं पश्याम्यहं वृक्षं पर्वतं वेश्म चेदृशम्।\nयं न वायुबलाद्भग्नं पृथिव्यामिति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077824, "chapter_id": 2649, "verse_number": "१२-१५४-४", "content_sanskrit": "त्वं पुनः कारणैर्नूनं रक्ष्यसे शाल्मले यथा।\nवायुना सपरीवारस्तेन तिष्ठस्यसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077825, "chapter_id": 2649, "verse_number": "१२-१५४-५x", "content_sanskrit": "शाल्मलिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077826, "chapter_id": 2649, "verse_number": "१२-१५४-५", "content_sanskrit": "न मे वायुः सखा ब्रह्मन्न बन्धुर्मम नारद।\nचिरं मे प्रीयते नैव येन मां रक्षतेऽनिलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077827, "chapter_id": 2649, "verse_number": "१२-१५४-६", "content_sanskrit": "मम तेजोबलं भीमं वायोरपि हि नारद।\nकलामष्टादशीं प्राणैर्न मे प्राप्नोति मारुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077828, "chapter_id": 2649, "verse_number": "१२-१५४-७", "content_sanskrit": "आगच्छन्परुषो वायुर्मया विष्टम्भितो बलात्।\nभञ्जन्द्रुमान्पर्वतांश्च यच्चान्यत्स्थाणुजङ्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077829, "chapter_id": 2649, "verse_number": "१२-१५४-८", "content_sanskrit": "स मया बहुशो भग्नः प्रभञ्जन्वै प्रभञ्जनः।\nतस्मान्न विभ्ये देवर्षे क्रुद्धादपि समीरणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077830, "chapter_id": 2649, "verse_number": "१२-१५४-९x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077831, "chapter_id": 2649, "verse_number": "१२-१५४-९", "content_sanskrit": "शाल्मले विपरीतं ते दर्शनं नात्र संशयः।\nन हि वायोर्बले नास्ति भूतं तुल्यबलं क्वचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077832, "chapter_id": 2649, "verse_number": "१२-१५४-१०", "content_sanskrit": "इन्द्रो यमो वैश्रवणो वरुणश्च जलेश्वरः।\nनैतेऽपि तुल्या मरुतः किं पुनस्त्वं वनस्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077833, "chapter_id": 2649, "verse_number": "१२-१५४-११", "content_sanskrit": "यश्च कश्चिदपि प्राणी चेष्टते शाल्मले भुवि।\nसर्वत्र भगवान्वायुश्चेष्टाप्राणकरः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077834, "chapter_id": 2649, "verse_number": "१२-१५४-१२", "content_sanskrit": "एष चेष्टयते सम्यक्प्राणिनः सम्यगायतः।\nअसम्यगायतो भूयश्चेष्टते विकृतं नृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077835, "chapter_id": 2649, "verse_number": "१२-१५४-१३", "content_sanskrit": "स त्वमेवंविधं वायुं सर्वसत्वभृतां वरम्।\nन पूजयसि पूज्यन्तं किमन्यद्वुद्धिलाघवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077836, "chapter_id": 2649, "verse_number": "१२-१५४-१४", "content_sanskrit": "असारश्चापि दुर्मेधाः केवलं बहु भाषसे।\nक्रोधादिभिरवच्छन्नो मिथ्या वदसि शाल्मले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077837, "chapter_id": 2649, "verse_number": "१२-१५४-१५", "content_sanskrit": "मम रोषः समुत्पन्नस्त्वय्येवं संप्रभाषति।\nब्रवीम्येष स्वयं वायोस्तव दुर्भाषितं बहु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077838, "chapter_id": 2649, "verse_number": "१२-१५४-१६", "content_sanskrit": "चन्दनैः स्यन्दनैः शालैः सरलैर्देवदारुभिः।\nवेतसैर्धन्वनैश्चापि ये चान्ये बलवत्तराः।\nतैश्चापि नैवं दुर्बुद्धे क्षिप्तो वायुः कृतात्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077839, "chapter_id": 2649, "verse_number": "१२-१५४-१७", "content_sanskrit": "तेऽपि जानन्ति वायोश्च बलमात्मन एव च।\nतस्मात्ते नावमन्यन्ते श्वसनं तरुसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077840, "chapter_id": 2649, "verse_number": "१२-१५४-१८", "content_sanskrit": "त्वं तु मोहान्न जानीपे वायोर्बलमनन्तकम्।\nएवं तस्माद्गमिष्यामि सकाशं मातरिश्वनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077841, "chapter_id": 2649, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि चतुःपञ्चाशदधिकशततमोऽध्यायः॥ १५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]