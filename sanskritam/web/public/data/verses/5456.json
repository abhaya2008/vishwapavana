[{"id": 2208539, "chapter_id": 5456, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208540, "chapter_id": 5456, "verse_number": "१", "content_sanskrit": "हन्त वः सम्प्रवक्ष्यामि यन्मां पृच्छथ सत्तमाः ।\nसमस्तमिह तत्त्वेन श्रुत्वा चैवावधार्यताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208541, "chapter_id": 5456, "verse_number": "२", "content_sanskrit": "अहिंसा सर्वभूतानामेतत् कृत्यतमं मतम् ।\nएतत्पदमनुद्विग्नं वरिष्ठं धर्मलक्षणम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208542, "chapter_id": 5456, "verse_number": "३", "content_sanskrit": "ज्ञानान्निःश्रेयसं प्राहुर्वृद्धा निश्चयदर्शिनः ।\nतस्माज्ज्ञानेन शुद्धेन मुच्यते सर्वकिल्बिषैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208543, "chapter_id": 5456, "verse_number": "४", "content_sanskrit": "हिंसापराश्च लोके ये ये च नास्तिकवृत्तयः ।\nलोभमोहसमायुक्तास्ते वै निरयगामिनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208544, "chapter_id": 5456, "verse_number": "५", "content_sanskrit": "आशीर्युक्तानि कर्माणि कुर्वते ये त्वतन्द्रिताः ।\nतेऽस्मिन् लोके प्रमोदन्ते जायमानाः पुनः पुनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208545, "chapter_id": 5456, "verse_number": "६", "content_sanskrit": "कुर्वते ये तु कर्माणि श्रद्दधाना विपश्चितः ।\nअनाशीर्योगसंयुक्तास्ते धीराः साधुदर्शिनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208546, "chapter_id": 5456, "verse_number": "७", "content_sanskrit": "अतः परं प्रवक्ष्यामि सत्वक्षेत्रज्ञयोर्यथा ।\nसंयोगो विप्रयोगश्च तन्निबोधत सत्तमाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208547, "chapter_id": 5456, "verse_number": "८", "content_sanskrit": "विषयो विषयित्वं च सम्बन्धोऽयमिहोच्यते ।\nविषयी पुरुषो नित्यं सत्वं च विषयः स्मृतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208548, "chapter_id": 5456, "verse_number": "९", "content_sanskrit": "व्याख्यातं पूर्वकल्पेन मशकोदुम्बरं यथा ।\nभुज्यमानं न जानीते नित्यं सत्वमचेतनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208549, "chapter_id": 5456, "verse_number": "१०", "content_sanskrit": "यस्त्वेवं तं विजानीते यो भुङ्क्ते यच्च भुज्यते ।\nअनित्यं द्वन्द्वसंयुक्तं सत्वमाहुर्मनीषिणः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208550, "chapter_id": 5456, "verse_number": "११", "content_sanskrit": "निर्द्वन्द्वो निष्कलो नित्यं क्षेत्रज्ञो निष्कलात्मकः ।\nसमासज्ञानतत्त्वेन यदा सर्वत्र दृश्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208551, "chapter_id": 5456, "verse_number": "१२", "content_sanskrit": "न सज्जते तदा सत्वमापः पुष्करपत्रवत् ।\nसर्वैरपि गुणैर्विद्वान् व्यतिषक्तो न लिप्यते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208552, "chapter_id": 5456, "verse_number": "१३", "content_sanskrit": "जलबिन्दुर्यथा लोलः पद्मिनीपत्रसंस्थितः ।\nएवमेवाप्यसंयुक्तः पुरुषः स्यान्न संशयः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208553, "chapter_id": 5456, "verse_number": "१४", "content_sanskrit": "द्रव्यमात्रमभूत् सत्वं पुरुषस्येति निश्चयः ।\nयथा द्रव्यं च कर्ता च संयोगोऽप्यनयोस्तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208554, "chapter_id": 5456, "verse_number": "१५", "content_sanskrit": "यथा प्रदीपमादाय कश्चित् तमसि गच्छति ।\nतथा सत्त्वप्रदीपेन गच्छन्ति परमर्षणः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208555, "chapter_id": 5456, "verse_number": "१६", "content_sanskrit": "यावद् द्रव्यं गुणस्तावत् प्रदीपः सम्प्रकाशते ।\nक्षीणे द्रव्ये गुणे ज्योतिरन्तर्धानाय गच्छति ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208556, "chapter_id": 5456, "verse_number": "१७", "content_sanskrit": "व्यक्तः सत्वगुणस्त्वेवं पुरुषो द्रव्यमुच्यते ।\nएतद् विप्रा विजानीत हन्त भूयो ब्रवीमि वः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208557, "chapter_id": 5456, "verse_number": "१८", "content_sanskrit": "सहस्रेणापि दुर्मेधा न बुद्धिमधिगच्छति ।\nचतुर्थेनाप्यथांशेन बुद्धिमान् सुखमेधते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2208558, "chapter_id": 5456, "verse_number": "१९", "content_sanskrit": "एवं धर्मस्य विज्ञेयं संसाधनमुपायतः ।\nउपायज्ञो हि मेधावी सुखमत्यन्तमश्नुते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2208559, "chapter_id": 5456, "verse_number": "२०", "content_sanskrit": "यथाऽधान्यमुपादेयं प्रवपन् मानवः क्वचित् ।\nक्लेशेन याति महता विनश्यत्यन्तराऽपि च ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2208560, "chapter_id": 5456, "verse_number": "२१", "content_sanskrit": "तथा कर्मसु विज्ञेयं फलं भवति वा न वा ।\nपुरुषस्यात्मनिःश्रेयः शुभाशुभनिदर्शनम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2208561, "chapter_id": 5456, "verse_number": "२२", "content_sanskrit": "यथा च दीर्घमध्वानं पद्भ्यामेव प्रवर्तते ।\nअदृष्टपूर्वं सहसा तत्त्वदर्शनवर्जितः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2208562, "chapter_id": 5456, "verse_number": "२३", "content_sanskrit": "तमेव च यथाऽध्वानं रथेनैवाशुगामिना ।\nयायादश्वप्रयुक्तेन तथा बुद्धिमतां गतिः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2208563, "chapter_id": 5456, "verse_number": "२४", "content_sanskrit": "ऊर्ध्वं पर्वतमारुह्य नान्ववेक्षेत भूतलम् ।\nरथेन रथिनं पश्येत् क्लिश्यमानमचेतनम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2208564, "chapter_id": 5456, "verse_number": "२५", "content_sanskrit": "यावद् रथपथस्तावद् रथेन स तु गच्छति ।\nक्षीणे रथपदे प्राज्ञो रथमुत्सृज्य गच्छति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2208565, "chapter_id": 5456, "verse_number": "२६", "content_sanskrit": "एवं गच्छति मेधावी तत्त्वज्ञो मोक्षमार्गवित् ।\nसमाज्ञाय महाबुद्धिरुत्तरादुत्तरोत्तरम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2208566, "chapter_id": 5456, "verse_number": "२७", "content_sanskrit": "यथा महार्णवं घोरमप्लवः सम्प्रगाहते ।\nबाहुभ्यामेव सम्मोहाद् वधमिच्छत्यसंशयम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2208567, "chapter_id": 5456, "verse_number": "२८", "content_sanskrit": "नावा कयापि च प्राज्ञः विभागज्ञस्त्वरित्रया ।\nअश्रान्तः सलिलं गाहेत् शीघ्रं सन्तरते ह्रदम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2208568, "chapter_id": 5456, "verse_number": "२९", "content_sanskrit": "तीर्णो गच्छेत् परं पारं नावमुत्सृज्य निर्ममः ।\nव्याख्यातं पूर्वकल्पेन यथा रथपदातिनोः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2208569, "chapter_id": 5456, "verse_number": "३०", "content_sanskrit": "स्नेहात् सम्मोहमापन्नो नावि दाशो यथा तथा ।\nममत्वेनाभिभूतस्तु स कथञ्चित् न मुह्यते(ति) ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2208570, "chapter_id": 5456, "verse_number": "३१", "content_sanskrit": "नावं न शक्यमारुह्य स्थले विपरिधावितुम् ।\nतथैव रथमारुह्य नाप्सु चर्या विधीयते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2208571, "chapter_id": 5456, "verse_number": "३२", "content_sanskrit": "एवं कर्मकृतं वृत्तं विविधस्थं पृथक् पृथक् ।\nयथा कर्मकृतं लोके तथा तदुपपद्यते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2208572, "chapter_id": 5456, "verse_number": "३३", "content_sanskrit": "यन्नैव गन्धि नो रसन् रूपसंस्पर्शशब्दवत् ।\nमन्यते न मनो बुद्ध्या तत् प्रधानं प्रचक्षते ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2208573, "chapter_id": 5456, "verse_number": "३४", "content_sanskrit": "तत्र प्रधानमव्यक्तमव्यक्तस्य गुणो महान् ।\nमहान् प्रधानभूतस्य गुणोऽहङ्कार एव च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2208574, "chapter_id": 5456, "verse_number": "३५", "content_sanskrit": "अहङ्कारात् प्रधानस्य महाभूतकृतो गुणः ।\nपृथक्त्वेन च भूतानां विषया वै गुणाः स्मृताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2208575, "chapter_id": 5456, "verse_number": "३६", "content_sanskrit": "बीजधर्मं यथाऽव्यक्तं तथैव प्रसवात्मकम् ।\nबीजधर्मी महानात्मा प्रसवश्चेति नः श्रुतम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2208576, "chapter_id": 5456, "verse_number": "३७", "content_sanskrit": "बीजधर्मी त्वहङ्कारः प्रसवश्च पुनः पुनः ।\nतथैव बीजधर्माणि महाभूतानि पञ्च वै ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2208577, "chapter_id": 5456, "verse_number": "३८", "content_sanskrit": "बीजधर्मिण इत्याहुः प्रसवं च प्रकुर्वते ।\nविशेषाः पञ्चभूतानां तेषां वित्त विशेषणम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2208578, "chapter_id": 5456, "verse_number": "३९", "content_sanskrit": "तत्रैकगुणमाकाशं द्विगुणो वायुरुच्यते ।\nत्रिगुणं ज्योतिरित्याहुरापश्चापि चतुर्गुणाः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2208579, "chapter_id": 5456, "verse_number": "४०", "content_sanskrit": "पृथ्वी पञ्चगुणा ज्ञेया तत्र स्थावरजङ्गमाः ।\nसर्वभूतकरी देवी शुभाशुभनिदर्शना ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2208580, "chapter_id": 5456, "verse_number": "४१", "content_sanskrit": "शब्दः स्पर्शस्तथा रूपं रसो गन्धश्च पञ्चमः ।\nएते पञ्च गुणा भूमेर्विज्ञेया द्विजसत्तमाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2208581, "chapter_id": 5456, "verse_number": "४२", "content_sanskrit": "पार्थिवश्च सदा गन्धो गन्धश्च बहुधा स्मृतः ।\nतस्य गन्धस्य वक्ष्यामि विस्तरेण बहून् गुणान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2208582, "chapter_id": 5456, "verse_number": "४३", "content_sanskrit": "इष्टश्चानिष्टगन्धश्च मधुरोऽम्लः कटुस्तथा ।\nनिर्हारी संहतः स्निग्धो रूक्षो विशद एव च ।\nएवं दशविधो ज्ञेयः पार्थिवो गन्ध इत्युत ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2208583, "chapter_id": 5456, "verse_number": "४४", "content_sanskrit": "शब्दः स्पर्शस्तथा रूपं रसश्चापां गुणाः स्मृताः ।\nरसज्ञानं तु वक्ष्यामि रसस्तु बहुधा स्मृतः ।\nमधुरोऽम्लः कटुस्तिक्तः कषायो लवणस्तथा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2208584, "chapter_id": 5456, "verse_number": "४५", "content_sanskrit": "एवं षड्विधविस्तारो रसो वारिसमुद्भवः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2208585, "chapter_id": 5456, "verse_number": "४६", "content_sanskrit": "शब्दः स्पर्शस्तथा रूपं त्रिगुणं ज्योतिरुच्यते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2208586, "chapter_id": 5456, "verse_number": "४७", "content_sanskrit": "ज्योतिषश्च गुणो रूपं रूपं च बहुधा स्मृतम् ।\nशुक्लं कृष्णं तथा रक्तं नीलं पीतारुणं तथा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2208587, "chapter_id": 5456, "verse_number": "४८", "content_sanskrit": "ह्रस्वं दीर्घं तथा स्थूलं चतुरश्राणुवृत्तकम् ।\nएवं द्वादशविस्तारं ज्योतिषां रूपमिष्यते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2208588, "chapter_id": 5456, "verse_number": "४९", "content_sanskrit": "विज्ञेयं ब्राह्मणैर्नित्यं धर्मज्ञैः सत्यवादिभिः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2208589, "chapter_id": 5456, "verse_number": "५०", "content_sanskrit": "शब्दस्पर्शौ च विज्ञेयौ द्विगुणो वायुरुच्यते ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2208590, "chapter_id": 5456, "verse_number": "५१", "content_sanskrit": "वायोश्चापि गुणः स्पर्शः स्पर्शश्च बहुधा स्मृतः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2208591, "chapter_id": 5456, "verse_number": "५२", "content_sanskrit": "उष्णः शीतः सुखो दुःखः स्निग्धो विशद एव च ।\nकठिनश्चिक्कणः श्लक्ष्णः पिच्छिलो दारुणो मृदुः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2208592, "chapter_id": 5456, "verse_number": "५३", "content_sanskrit": "एवं द्वादशविस्तारो वायव्यो गुण उच्यते ।\nविधिवद् ब्राह्मणैः सिद्धैर्धर्मज्ञैस्तत्त्वदर्शिभिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2208593, "chapter_id": 5456, "verse_number": "५४", "content_sanskrit": "तत्रैकगुण आकाशः शब्द इत्येव स स्मृतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2208594, "chapter_id": 5456, "verse_number": "५५", "content_sanskrit": "तस्य शब्दस्य वक्ष्यामि विस्तरेण बहून् गुणान् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2208595, "chapter_id": 5456, "verse_number": "५६", "content_sanskrit": "षड्जर्षभः सगान्धारो मध्यमः पञ्चमः स्मृतः ।\nअतःपरं तु विज्ञेयो निषादो धै(दै)वतस्तथा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2208596, "chapter_id": 5456, "verse_number": "५७", "content_sanskrit": "इष्टश्चानिष्टशब्दश्च संहतः प्रतिभानवान् ।\nएवं बहुविधो ज्ञेयः शब्द आकाशसम्भवः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2208597, "chapter_id": 5456, "verse_number": "५८", "content_sanskrit": "आकाशमुत्तमं भूतमहङ्कारस्ततः परः ।\nअहङ्कारात् परा बुद्धिः बुद्धेरात्मा ततः परः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2208598, "chapter_id": 5456, "verse_number": "५९", "content_sanskrit": "तस्मात् तु परमव्यक्तमव्यक्तात् पुरुषः परः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2208599, "chapter_id": 5456, "verse_number": "६०", "content_sanskrit": "परावरज्ञो भूतानां यं प्राप्यानन्त्यमश्नुते ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2208600, "chapter_id": 5456, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु गुणविस्तारकथनं नाम पञ्चाशोऽध्यायः ॥५०॥\nअनुगीतापर्वणि पञ्चत्रिंशोऽध्यायः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]