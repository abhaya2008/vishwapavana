[{"id": 7003946000, "chapter_id": 23946, "verse_number": "३-१-९-१", "content_sanskrit": "ततः स विप्रः प्रत्यूषे पुत्रशोकेन पीडितः ।\nअशोक दत्तसंयुक्तो भार्यया विललाप ह॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003946001, "chapter_id": 23946, "verse_number": "३-१-९-२", "content_sanskrit": "विलपंतं समालोक्य गोविंदस्वामिनं द्विजाः ।\nवणिक्समुद्रदत्ताख्यः समानिन्ये निजं गृहम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003946002, "chapter_id": 23946, "verse_number": "३-१-९-३", "content_sanskrit": "समानीय समाश्वास्य दयायुक्तो वणिग्वरः ।\nस्वधनानां हि सर्वेषां रक्षितारमकल्पयत्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003946003, "chapter_id": 23946, "verse_number": "३-१-९-४", "content_sanskrit": "स्मरन्महायतिवचः पुत्रदर्शनलालसः ।\nस तस्थौ वणिजो गेहे पुत्रभार्यासमन्वितः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003946004, "chapter_id": 23946, "verse_number": "३-१-९-५", "content_sanskrit": "अशोकदत्तनामा तु द्वितीयो विप्रनंदनः ।\nशस्त्रे चैव तथा शास्त्रे बभूवातिविचक्षणः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003946005, "chapter_id": 23946, "verse_number": "३-१-९-६", "content_sanskrit": "तथान्यास्वपि विद्यासु नास्ति तत्सदृशो भुवि ।\nकृतविद्यो द्विजसुतः प्रख्यातो नगरेऽभवत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003946006, "chapter_id": 23946, "verse_number": "३-१-९-७", "content_sanskrit": "अत्रांतरे नरपतिं प्रतापमुकुटाभिधम् ।\nकाशीदेशाधिपो मल्लः कश्चिदभ्याययौ बली॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003946007, "chapter_id": 23946, "verse_number": "३-१-९-८", "content_sanskrit": "प्रतापमुकुटो राजा मल्लस्यास्य जयाय सः ।\nबलिनं द्विजपुत्रं तमाह्वयामास भृत्यकैः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003946008, "chapter_id": 23946, "verse_number": "३-१-९-९", "content_sanskrit": "तमागतं समालोक्य प्रतापमुकुटोऽब्रवीत् ।\nअशोकदत्त सहसा मल्लमेनं बलोत्कटम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003946009, "chapter_id": 23946, "verse_number": "३-१-९-१०", "content_sanskrit": "दुर्जयं जहि संग्रामे त्वं वै वलवतां वरः ।\nदाक्षिणात्यमहामल्लपतावस्मिञ्जिते त्वया॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003946010, "chapter_id": 23946, "verse_number": "३-१-९-११", "content_sanskrit": "यदिष्टं तव तत्सर्वं दास्याम्यहं न संशयः ।\nइति तस्य वचः श्रुत्वा वलवान्द्विजनंदनः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003946011, "chapter_id": 23946, "verse_number": "३-१-९-१२", "content_sanskrit": "दाक्षिणात्यमहामल्लनृपतिं समताडयत् ।\nताडितो द्विजपुत्रेण मल्लः स बलिना बली॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003946012, "chapter_id": 23946, "verse_number": "३-१-९-१३", "content_sanskrit": "सद्यो विवृत्तनयनः परासुर्न्यपतद्भुवि ।\nद्विज पुत्रस्य तत्कर्म देवैरपि सुदुष्करम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003946013, "chapter_id": 23946, "verse_number": "३-१-९-१४", "content_sanskrit": "प्रतापमुकुटो दृष्ट्वा प्रसन्नहृदयोऽभवत् ।\nदत्त्वा वहुधनान्ग्रामान्समीपेऽस्थापयत्तदा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003946014, "chapter_id": 23946, "verse_number": "३-१-९-१५", "content_sanskrit": "स कदाचिन्महाराज सहितो द्विजसूनुना ।\nसंध्यायां विजने देशे चचार तुरगेण वै॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003946015, "chapter_id": 23946, "verse_number": "३-१-९-१६", "content_sanskrit": "द्विजसूनुसखस्तत्र दीनां वाणीमथाशृणोत् ।\nराजन्नल्पापराधोऽहं शत्रुप्रेरणयासकृत्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003946016, "chapter_id": 23946, "verse_number": "३-१-९-१७", "content_sanskrit": "दण्डपालेन निहितः शूले निर्घृणचेतसा ।\nदिनमद्य चतुर्थं मे शूलस्थस्यैव जीवतः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003946017, "chapter_id": 23946, "verse_number": "३-१-९-१८", "content_sanskrit": "प्राणाः सुखेन निर्यांति न हि दुष्कृतकर्मणाम् ।\nभृशं मां बाधते तृष्णा तां निवारय भूपते॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003946018, "chapter_id": 23946, "verse_number": "३-१-९-१९", "content_sanskrit": "इति दीनां समाकर्ण्य वाचं राजा द्विजा त्मजम् ।\nअशोकदत्तनामानं धैर्यवंतमभाषत॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003946019, "chapter_id": 23946, "verse_number": "३-१-९-२०", "content_sanskrit": "अस्मै निरपराधाय शूलप्रोताय जंतवे ।\nतृष्णार्दिताय दातव्यं द्विजसूनो त्वया जलम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003946020, "chapter_id": 23946, "verse_number": "३-१-९-२१", "content_sanskrit": "इत्यादिष्टो नरेन्द्रेण सहसा द्विजनन्दनः ।\nजलपूर्णं समादाय कलशं वेगवान्ययौ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003946021, "chapter_id": 23946, "verse_number": "३-१-९-२२", "content_sanskrit": "तच्छ्मशानं समासाद्य भूतवेतालसंकुलम् ।\nशूलप्रोताय वै तस्मै जलं दातुं समुत्सुकः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003946022, "chapter_id": 23946, "verse_number": "३-१-९-२३", "content_sanskrit": "ददर्शाथ स्थितां नारीं नवयौवनशालिनीम् ।\nउदैक्षत महाकांतिं मूर्तामिव रतिं द्विजः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003946023, "chapter_id": 23946, "verse_number": "३-१-९-२४", "content_sanskrit": "तामालोक्य ततः प्राह धैर्यवान्द्विजनंदनः ।\nकासि भद्रे वरारोहे श्मशाने विजने स्थिता॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003946024, "chapter_id": 23946, "verse_number": "३-१-९-२५", "content_sanskrit": "अस्याधस्तात्किमर्थं त्वं शूलप्रोतस्य तिष्ठसि ।\nइति तस्य वचः श्रुत्वा सा प्राह रुचिरानना॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003946025, "chapter_id": 23946, "verse_number": "३-१-९-२६", "content_sanskrit": "पुरुषो वल्लभोऽयं मे शूले राज्ञा समर्पितः ।\nधनं यथा च कृपणः पश्य प्राणान्न मुंचति॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003946026, "chapter_id": 23946, "verse_number": "३-१-९-२७", "content_sanskrit": "आसन्नमरणं चैनमनुयातुमिह स्थिता ।\nतृषितो याचते वारि मामयं व्यथते मुहुः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003946027, "chapter_id": 23946, "verse_number": "३-१-९-२८", "content_sanskrit": "शूलप्रोतो द्धतग्रीवं मुमूर्षुं प्राणनायकम् ।\nनास्मि पाययितुं शक्ता जलमेनमधःस्थिता॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003946028, "chapter_id": 23946, "verse_number": "३-१-९-२९", "content_sanskrit": "अशोकदत्तस्तच्छ्रुत्वा करुणावरुणालयः ।\nतत्कालसदृशं वाक्यं तां वधूमब्रवीत्तदा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003946029, "chapter_id": 23946, "verse_number": "३-१-९-३०", "content_sanskrit": "अशोकदत्त उवाच ।\nमातर्मत्स्कंधमारुह्य देह्यस्मै शीतलं जलम् ।\nसा तथेति तमाभाष्य तरुणी त्वरयान्विता॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003946030, "chapter_id": 23946, "verse_number": "३-१-९-३१", "content_sanskrit": "आनम्रवपुषस्तस्य स्कंधं पद्भ्यां रुरोह वै ।\nद्विजसूनुर्ददर्शाथ शोणितं नूतनं पतत्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003946031, "chapter_id": 23946, "verse_number": "३-१-९-३२", "content_sanskrit": "किमेतदिति सोपश्यदुन्नम्य सहसा मुखम् ।\nभक्ष्यमाणं तया तत्स विज्ञाय द्विजनंदनः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003946032, "chapter_id": 23946, "verse_number": "३-१-९-३३", "content_sanskrit": "अशोकदत्तो जग्राह तस्याः पादं सनूपुरम् ।\nततोऽगान्नूपुरं त्यक्त्वा बद्धरत्नं विहाय तत्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003946033, "chapter_id": 23946, "verse_number": "३-१-९-३४", "content_sanskrit": "प्रत्युप्तानेकरत्नाढ्यं तदादायच नूपुरम् ।\nअशोकदत्तः प्रययौ तच्छ्मशानान्नृपांतिकम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003946034, "chapter_id": 23946, "verse_number": "३-१-९-३५", "content_sanskrit": "स्मशानवृत्तं तत्सर्वं स नृपाय निवेद्य वै ।\nमहार्घ्यरत्नप्रत्युप्तं नूपुरं च ददौ तदा॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003946035, "chapter_id": 23946, "verse_number": "३-१-९-३६", "content_sanskrit": "ज्ञात्वा तद्वीरचरितं वीरैरन्यैः सुदुष्करम् ।\nददौ मदनलेखाख्यां सुतां तस्मै महीपतिः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003946036, "chapter_id": 23946, "verse_number": "३-१-९-३७", "content_sanskrit": "कदाचिदथ ताद्दिव्यं नूपुरं वीक्ष्य भूपतिः ।\nअस्य नूपुरवर्यस्य तुल्यं वै नूपुरांतरम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003946037, "chapter_id": 23946, "verse_number": "३-१-९-३८", "content_sanskrit": "कुतो वा लभ्यत इति सादरं समचिंतयत् ।\nअशोकदत्तस्तु तदा विज्ञाय नृपकांक्षितम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003946038, "chapter_id": 23946, "verse_number": "३-१-९-३९", "content_sanskrit": "नृपुरांतरसि द्ध्यर्थं चिंतयामास चेतसा ।\nश्मशाने नूपुरमिदं यतः प्राप्तं मया पुरा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003946039, "chapter_id": 23946, "verse_number": "३-१-९-४०", "content_sanskrit": "तां नूपुरांतरप्राप्त्यै कुत्र द्रक्ष्यामि सांप्रतम् ।\nइत्थं वितर्क्य बहुधा नि श्चिकाय महामतिः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003946040, "chapter_id": 23946, "verse_number": "३-१-९-४१", "content_sanskrit": "विक्रेष्यामि महामांसं समेत्य पितृकाननम् ।\nतत्र राक्षसवेतालपिशाचादिषु सर्वशः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003946041, "chapter_id": 23946, "verse_number": "३-१-९-४२", "content_sanskrit": "मंत्रैराहूयमानेषु साप्यायास्य ति राक्षसी ।\nतामागतां बलाद्गृह्य तद्ग्रहीष्यामि नूपुरम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003946042, "chapter_id": 23946, "verse_number": "३-१-९-४३", "content_sanskrit": "राक्षसानां सहस्रं वा पिशाचानां तथायुतम् ।\nवेतालानां तथा कोटिर्न लक्ष्यं बलिनो मम॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003946043, "chapter_id": 23946, "verse_number": "३-१-९-४४", "content_sanskrit": "इति निश्चित्य मनसा श्मशानं सहसा ययौ ।\nविक्रीणानो महामांसं मंत्रैराहूय राक्षसान्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003946044, "chapter_id": 23946, "verse_number": "३-१-९-४५", "content_sanskrit": "गृहाणेत्युच्चया वाचा चचार श्रावयन्दि शः ।\nविक्रीयते महामांसं गृह्यतांगृह्यतामिति॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003946045, "chapter_id": 23946, "verse_number": "३-१-९-४६", "content_sanskrit": "तत्र राक्षसवेतालाः कंकालाश्च पिशाचकाः ।\nअन्ये च भूतनिवहाः समाजग्मुः प्रहर्षिताः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003946046, "chapter_id": 23946, "verse_number": "३-१-९-४७", "content_sanskrit": "भक्षयिष्यामहे सर्वे मांसमिष्टतमं त्विति ।\nतत्रागच्छत्सु सर्वेषु रक्षःकन्यासमावृता॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003946047, "chapter_id": 23946, "verse_number": "३-१-९-४८", "content_sanskrit": "आययौ राक्षसी सापि मांसभक्षणलालसा ।\nगवेषयंस्तदा विप्रस्तां समुद्वीक्ष्य राक्षसीम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003946048, "chapter_id": 23946, "verse_number": "३-१-९-४९", "content_sanskrit": "सेयं दृष्टा पुरेत्येष प्रत्यभिज्ञानमाप्तवान् ।\nतामाह द्विजपुत्रोऽन्यद्देहि मे नूपुरं त्विति॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003946049, "chapter_id": 23946, "verse_number": "३-१-९-५०", "content_sanskrit": "सा तस्य वचनं श्रुत्वा प्रीता वाक्यमथाऽब्रवीत् ।\nममैव च त्वया नीतं पुरा वीरेंद्र नूपुरम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003946050, "chapter_id": 23946, "verse_number": "३-१-९-५१", "content_sanskrit": "गृहाण रत्नरुचिरं द्वितीयमपि नूपुरम् ।\nइत्युक्त्वा नूपुरं तस्मै स्वसुतां च ददौ प्रियाम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003946051, "chapter_id": 23946, "verse_number": "३-१-९-५२", "content_sanskrit": "विद्युत्केश्या तदा दत्तां प्रियां विद्युत्प्रभाभिधाम् ।\nविप्रः संप्राप्य मुमुदे रूपयौवनशालि नीम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003946052, "chapter_id": 23946, "verse_number": "३-१-९-५३", "content_sanskrit": "विद्युत्केशी तु जामात्रे हेमाब्जमपि सा ददौ ।\nविद्युत्प्रभां नूपुरं च हेमाब्जमपिलभ्य सः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003946053, "chapter_id": 23946, "verse_number": "३-१-९-५४", "content_sanskrit": "श्वश्रूमाभाष्य सहसा पुनः प्रायान्नृपांतिकम् ।\nततः प्रतापमुकुटो नूपुरप्राप्तिनंदितः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003946054, "chapter_id": 23946, "verse_number": "३-१-९-५५", "content_sanskrit": "शौर्यधैर्यसमायुक्तं प्रशशंस द्विजात्मजम् ।\nअथ विद्युत्प्रभां विप्रः सोऽब्रवीद्रहसि प्रियाम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003946055, "chapter_id": 23946, "verse_number": "३-१-९-५६", "content_sanskrit": "मात्रा तव कुतो लब्धमेतद्धेमांबुज प्रिये ।\nएतत्तुल्यानि चान्यानि यतः प्राप्स्ये वरानने॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003946056, "chapter_id": 23946, "verse_number": "३-१-९-५७", "content_sanskrit": "द्विजात्मजं ततः प्राह पतिं विद्युत्प्रभा रहः ।\nप्रभो कपालविस्फोटनाम्नो वेतालभूपतेः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003946057, "chapter_id": 23946, "verse_number": "३-१-९-५८", "content_sanskrit": "अस्ति दिव्यं सरः किंचिद्धेमांबुजपरिष्कृतम् ।\nतव श्वश्र्वा जलक्रीडां वितन्वं त्येदमाहृतम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003946058, "chapter_id": 23946, "verse_number": "३-१-९-५९", "content_sanskrit": "इति श्रुत्वा वचस्तत्र मां नयेति जगाद सः ।\nततः सा सहसा विप्रं निन्ये तत्कांचनं सरः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003946059, "chapter_id": 23946, "verse_number": "३-१-९-६०", "content_sanskrit": "ततः स हेमपद्मानामाजिहीर्षुर्द्विजात्मजः ।\nतद्विप्रकारिणः सर्वान्वेतालादींस्ततोऽवधीत्॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003946060, "chapter_id": 23946, "verse_number": "३-१-९-६१", "content_sanskrit": "स्वयं कपालविस्फोटं निहताशेषसैनिकम् ।\nददर्श वेतालपतिं तं च हंतुं प्रचक्रमे॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003946061, "chapter_id": 23946, "verse_number": "३-१-९-६२", "content_sanskrit": "अत्रांतरे महातेजा नाम्ना विज्ञप्तिकौतुकः ।\nविद्याधरपतिः प्राप्य विमानेनैनमब्रवीत्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003946062, "chapter_id": 23946, "verse_number": "३-१-९-६३", "content_sanskrit": "अशोकदत्तं विप्रेंद्र साहसं मा कृथा इति ।\nतदाकर्ण्य द्विजसुतो विमानवरसंस्थितम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003946063, "chapter_id": 23946, "verse_number": "३-१-९-६४", "content_sanskrit": "ददर्श प्रभया युक्तं विद्याधरपतिं दिवि ।\nतस्य दर्शनमात्रेण शापामुक्तो द्विजा त्मजः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003946064, "chapter_id": 23946, "verse_number": "३-१-९-६५", "content_sanskrit": "संत्यज्य मानुषं रूपं दिव्यं रूपमवाप्तवान् ।\nविमानवरमारूढं दिव्याभरणभूषितम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003946065, "chapter_id": 23946, "verse_number": "३-१-९-६६", "content_sanskrit": "शापान्मुक्तं सुकर्णं तं प्राह विज्ञप्ति कौतुकः ।\nअयं सुकर्ण ते भ्राता गालवस्य महामुनेः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003946066, "chapter_id": 23946, "verse_number": "३-१-९-६७", "content_sanskrit": "शापाद्वेतालतां प्राप तत्कन्यास्पर्शपातकी ।\nत्वं च शप्तः पुरा तेन तत्पापस्यानु मोदकः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003946067, "chapter_id": 23946, "verse_number": "३-१-९-६८", "content_sanskrit": "तवायमल्पपापस्य शापो मद्दर्शनावधिः ।\nकल्पिस्ततेन मुनिना शापांतो नास्य कल्पितः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003946068, "chapter_id": 23946, "verse_number": "३-१-९-६९", "content_sanskrit": "तदेहि मुक्तशापोसि सुकर्ण स्वर्गमारुह ।\nततः सुकर्णस्तं प्राह विद्याधरकुलाधिपम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003946069, "chapter_id": 23946, "verse_number": "३-१-९-७०", "content_sanskrit": "विद्याधरपते भ्रात्रा विना ज्येष्ठेन सांप्रतम् ।\nसर्वभोगयुतं स्वर्गं नैव गंतुं समुत्सहे॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003946070, "chapter_id": 23946, "verse_number": "३-१-९-७१", "content_sanskrit": "शापस्यांतो यथा भूयान्मम भ्रातुस्तथा वद ।\nतमुवाच महातेजास्तथा विज्ञप्तिकौतुकः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003946071, "chapter_id": 23946, "verse_number": "३-१-९-७२", "content_sanskrit": "दुर्निवारमिमं शापमन्यः को वा निवारयेत् ।\nकिं तु गुह्यतमं किंचित्तव वक्ष्यामि सांप्रतम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003946072, "chapter_id": 23946, "verse_number": "३-१-९-७३", "content_sanskrit": "ब्रह्मणा सनकादिभ्यो मुनिभ्यः कथितं पुरा ।\nसर्वतीर्थाश्रये पुण्ये दक्षिणस्यो दधेस्तटे॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003946073, "chapter_id": 23946, "verse_number": "३-१-९-७४", "content_sanskrit": "चक्रतीर्थसमीपे तु तीर्थमस्तिमहत्तरम् ।\nमहापातकसंघाश्च यस्य दर्शनमात्रतः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003946074, "chapter_id": 23946, "verse_number": "३-१-९-७५", "content_sanskrit": "नश्यंति तत्क्षणादेव न जाने स्नानजं फलम् ।\nतत्र गत्वा तव ज्येष्ठो यदि स्नायान्महत्तरे॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003946075, "chapter_id": 23946, "verse_number": "३-१-९-७६", "content_sanskrit": "वेतालत्वं त्यजेन्नूनं तदा गालवशापजम् ।\nसुकर्णस्तद्वचः श्रुत्वा भ्रात्रा वेतालरूपिणा॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003946076, "chapter_id": 23946, "verse_number": "३-१-९-७७", "content_sanskrit": "सहितः सहसा प्रायाद्दक्षिणस्योदधेस्तटम् ।\nदक्षिणं चक्रतीर्थाख्यादुत्तरं गंधमादनात्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003946077, "chapter_id": 23946, "verse_number": "३-१-९-७८", "content_sanskrit": "ब्रह्मणा सनकादिभ्यः कथितं तीर्थमभ्यगात् ।\nतत्तीर्थकूलमासाद्य भ्रातरं चेदमब्रवीत्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003946078, "chapter_id": 23946, "verse_number": "३-१-९-७९", "content_sanskrit": "भ्रातर्गालवशापस्य घोरस्यास्य निवृत्तये ।\nतीर्थेऽस्मिन्नचिरात्स्नाहि सर्वतीर्थोत्तमोत्तमे॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003946079, "chapter_id": 23946, "verse_number": "३-१-९-८०", "content_sanskrit": "तस्मिन्न वसरे विप्रास्तस्य तीर्थस्य शीकराः ।\nन्यपतंस्तस्य गात्रेषु वायुना वै समाहृताः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003946080, "chapter_id": 23946, "verse_number": "३-१-९-८१", "content_sanskrit": "स तच्छीकरसंस्पर्शात्त्यक्त्वा वेतालतां तदा ।\nतदेव मानुषं भावं द्विजपुत्रत्वमाप्तवान्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003946081, "chapter_id": 23946, "verse_number": "३-१-९-८२", "content_sanskrit": "ततः संकल्प्य सहसा तस्मिंस्तीर्थोत्तमोत्तमे ।\nमनुष्यत्वनिवृत्त्यर्थं निममज्ज द्विजात्मजः॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003946082, "chapter_id": 23946, "verse_number": "३-१-९-८३", "content_sanskrit": "उत्तिष्ठन्नेव सहसा दिव्यं रूपमवाप्तवान् ।\nविमानवरमारूढो देवस्त्रीपरिवारितः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003946083, "chapter_id": 23946, "verse_number": "३-१-९-८४", "content_sanskrit": "सर्वाभरणसंयुक्तः सह भ्रात्रा सुदर्शनः ।\nश्लाघमानश्च तत्तीर्थं नमस्कत्य पुनःपुनः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003946084, "chapter_id": 23946, "verse_number": "३-१-९-८५", "content_sanskrit": "विज्ञप्तिकौतुकं चापि पुरस्कृत्य दिवं ययौ ।\nतदाप्रभृति तत्तीर्थं वेतालवरदाभिधम्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003946085, "chapter_id": 23946, "verse_number": "३-१-९-८६", "content_sanskrit": "वेतालत्वं विनष्टं यच्छीकरस्पर्शमात्रतः ।\nय इदं तीर्थमासाद्य चक्रतीर्थस्य दक्षिणे॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003946086, "chapter_id": 23946, "verse_number": "३-१-९-८७", "content_sanskrit": "स्नानं कदाचित्कुर्वंति जीवन्मुक्ता भवंति ते ।\nएतत्तीर्थसमं पुण्यं न भूतं न भविष्यति॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003946087, "chapter_id": 23946, "verse_number": "३-१-९-८८", "content_sanskrit": "घोरां वेतालतां त्यक्त्वा दिव्यतां स यदाप्तवान्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003946088, "chapter_id": 23946, "verse_number": "३-१-९-८९", "content_sanskrit": "अत्र संकल्प्य च स्नात्वा वेतालवरदे शुभे ।\nपितृभ्यः पिंडदानं च कुर्याद्वै नियमान्वितः॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003946089, "chapter_id": 23946, "verse_number": "३-१-९-९०", "content_sanskrit": "एवं वः कथितं विप्रास्तस्य तीर्थस्य वैभवम् ।\nवेतालवरदाभिख्या यथा चास्य समागता॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003946090, "chapter_id": 23946, "verse_number": "३-१-९-९१", "content_sanskrit": "यः पठेदिममध्यायं शृणुयाद्वा स मुच्यते॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]