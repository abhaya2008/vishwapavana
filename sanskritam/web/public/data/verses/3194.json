[{"id": 2101653, "chapter_id": 3194, "verse_number": "१४-५०-१", "content_sanskrit": "ब्रह्मोवाच।\nहन्त वः सम्प्रक्ष्यामि यन्मां पृच्छथ सत्तमाः।\nगुरुणा शिष्यमासाद्य यदुक्तं तन्निबोधत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101654, "chapter_id": 3194, "verse_number": "१४-५०-२", "content_sanskrit": "समस्तमिह तच्छ्रुत्वा सम्यगेवावधार्यताम्।\nअहिंसा सर्वभूतानामेतत्कृत्यतमं मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101655, "chapter_id": 3194, "verse_number": "१४-५०-३", "content_sanskrit": "एतत्पदमनुद्विग्नं वरिष्ठं धर्मलक्षणम्।\nज्ञानं निःश्रेय इत्याहुर्वृद्धा निश्चितदर्शिनः।\nतस्माज्ज्ञानेन शुद्धेन मुच्यते सर्वकिल्बिषैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101656, "chapter_id": 3194, "verse_number": "१४-५०-४", "content_sanskrit": "हिंसापराश्च ये केचिद्ये च नास्तिकवृत्तयः।\nलोभमोहसमायुक्तास्ते वै निरयगामिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101657, "chapter_id": 3194, "verse_number": "१४-५०-५", "content_sanskrit": "आशीर्युक्तानि कर्माणि कुर्वते ये त्वतन्द्रिताः।\nतेऽस्मिन्लोके प्रमोदन्ते जायमानाः पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101658, "chapter_id": 3194, "verse_number": "१४-५०-६", "content_sanskrit": "कुर्वते ये तु कर्माणि श्रद्धधाना विपश्चितः।\nअनाशीर्योगसंयुक्तास्ते धीराः साधुदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101659, "chapter_id": 3194, "verse_number": "१४-५०-७", "content_sanskrit": "अतः परं प्रवक्ष्यामि सत्वक्षेत्रज्ञयोर्यथा।\nसंयोगो विप्रयोगश्च तन्निबोधत सत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101660, "chapter_id": 3194, "verse_number": "१४-५०-८", "content_sanskrit": "विषयो विषयित्वं च सम्बन्धोऽयमिहोच्यते।\nविषयी पुरुषो नित्यं सत्वं च विषयः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101661, "chapter_id": 3194, "verse_number": "१४-५०-९", "content_sanskrit": "व्याख्यातं पूर्वकल्पेनि मशकोदुम्बरं यथा।\nभुज्यमानं न जानीते नित्यं सत्वमचेतनम्।\nयस्त्वेवं तं विजानीते यो भुङ्क्ते यश्च भुज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101662, "chapter_id": 3194, "verse_number": "१४-५०-१०", "content_sanskrit": "अनित्यं द्वन्द्वसंयुक्तं सत्वमाहुर्मनीषिणः।\nनिर्द्वन्द्वो निष्कलो नित्यः क्षेत्रज्ञो निर्गुणात्मकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101663, "chapter_id": 3194, "verse_number": "१४-५०-११", "content_sanskrit": "समः संज्ञानुगश्चैव स सर्वत्र व्यवस्थितः।\nन सज्जते सदा सत्वमापः पुष्करपर्णवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101664, "chapter_id": 3194, "verse_number": "१४-५०-१२", "content_sanskrit": "सर्वैरपि गुणैर्विद्वान्व्यतिषक्तो न लिप्यते।\nजलबिन्दुर्यथा लोलः पद्मिनीपत्रसंस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101665, "chapter_id": 3194, "verse_number": "१४-५०-१३", "content_sanskrit": "एवमेवाप्यसंयुक्तः पुरुषः स्यान्न संशयः।\nद्रव्यमात्रमभूत्सत्वं पुरुषस्येति निश्चयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101666, "chapter_id": 3194, "verse_number": "१४-५०-१४", "content_sanskrit": "यथा द्रव्यं च कर्ता च संयोगोऽप्यनयोस्तथा।\nयथा प्रदीपमादाय कश्चित्तमसि गच्छति।\nतथा सत्त्वप्रदीपेन गच्छन्ति परमर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101667, "chapter_id": 3194, "verse_number": "१४-५०-१५", "content_sanskrit": "यावद्द्रव्यं गुणस्तावत्प्रदीपः सम्प्रकाशते।\nक्षीणे द्रव्ये गुणे ज्योतिरन्तर्धानाय गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101668, "chapter_id": 3194, "verse_number": "१४-५०-१६", "content_sanskrit": "व्यक्तः सत्वगुणस्त्वेवं पुरुषो द्रव्यमुच्यते।\nएतद्विप्रा विजानीत हन्त भूयो ब्रवीमि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101669, "chapter_id": 3194, "verse_number": "१४-५०-१७", "content_sanskrit": "सहस्रेणापि दुर्मेधा न बुद्धिमधिगच्छति।\nचतुर्थेनाप्यथांशेन बुद्धिमान्सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101670, "chapter_id": 3194, "verse_number": "१४-५०-१८", "content_sanskrit": "एवं धर्मस्य विज्ञेयं संसाधनमुपायतः।\nउपायज्ञो हि मेधावी सुखमत्यन्तमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101671, "chapter_id": 3194, "verse_number": "१४-५०-१९", "content_sanskrit": "यथाऽध्वानमपाथेयः प्रपन्नो मनुजः क्वचित्।\nक्लेशेन याति महता विनश्यत्यन्तराऽपि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101672, "chapter_id": 3194, "verse_number": "१४-५०-२०", "content_sanskrit": "तथा कर्मसु विज्ञेयं फलं भवति वा न वा।\nपुरुषस्यात्मनिःश्रेयः शुभाशुभनिदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101673, "chapter_id": 3194, "verse_number": "१४-५०-२१", "content_sanskrit": "यथा च दीर्घमध्वानं पद्म्यामेव प्रपद्यते।\nअदृष्टपूर्वं सहसा तत्त्वदर्शनवर्जितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101674, "chapter_id": 3194, "verse_number": "१४-५०-२२", "content_sanskrit": "तमेव च यथाऽध्वानं रथेनेहाशुगामिना।\nगच्छत्यश्वप्रयुक्तेन तथा बुद्धिमतां गतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101675, "chapter_id": 3194, "verse_number": "१४-५०-२३", "content_sanskrit": "ऊर्ध्वं पर्वतमारुह्य नान्ववेक्षेत भूतलम्।\nरथेन रथिनं पश्येत्क्लिश्यमानमचेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101676, "chapter_id": 3194, "verse_number": "१४-५०-२४", "content_sanskrit": "यावद्रथपथस्तावद्रथेन स तु गच्छति।\nक्षीणे रथपदे विद्वान्रथमुत्सृज्य गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101677, "chapter_id": 3194, "verse_number": "१४-५०-२५", "content_sanskrit": "एवं गच्छति मेधावी तत्त्वयोगविधानवित्।\nपरिज्ञाय गुणज्ञश्च उत्तरादुत्तरोत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101678, "chapter_id": 3194, "verse_number": "१४-५०-२६", "content_sanskrit": "यथाऽर्णवं महाघोरमप्लवः सम्प्रगाहते।\nबाहुभ्यामेव सम्मोहाद्वधं वाञ्छत्यसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101679, "chapter_id": 3194, "verse_number": "१४-५०-२७", "content_sanskrit": "नावा चापि यथा प्राज्ञो विभागज्ञः स्वरित्रया।\nअश्रान्तः सलिलं गहाच्छीध्रं संतरते ह्रदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2101680, "chapter_id": 3194, "verse_number": "१४-५०-२८", "content_sanskrit": "तीर्णो गच्छेत्परं पारं नावमुत्सृज्य निर्ममः।\nव्याख्यातं पूर्वकल्पेन यथा रथपदातिनोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2101681, "chapter_id": 3194, "verse_number": "१४-५०-२९", "content_sanskrit": "स्नेहात्सम्मोहमापन्नो नावि दाशो यथा तथा।\nममत्वेनाभिभूतः संस्तत्रैव परिवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2101682, "chapter_id": 3194, "verse_number": "१४-५०-३०", "content_sanskrit": "नावं न शक्यमारुह्य स्थले विपरिवर्तितुम्।\nतथैव रथमारुह्य नाप्सु चर्या विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2101683, "chapter_id": 3194, "verse_number": "१४-५०-३१", "content_sanskrit": "एवं कर्म कृतं वित्त विषयस्थं पृथक्पृथक्।\nयथा कर्म कृतं लोके तथा तदुपपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2101684, "chapter_id": 3194, "verse_number": "१४-५०-३२", "content_sanskrit": "यन्नैव गन्धि नो रस्यं न रूपस्पर्सशब्दवत्।\nमन्यते न मनो बुद्ध्या तत्प्रधानं प्रचक्षते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2101685, "chapter_id": 3194, "verse_number": "१४-५०-३३", "content_sanskrit": "तत्र प्रधानमव्यक्तमव्यक्तस्य गुणो महान्।\nमहप्रधानभूतस्य गुणोऽहङ्कार एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2101686, "chapter_id": 3194, "verse_number": "१४-५०-३४", "content_sanskrit": "अहङ्कारात्तु सम्भूतो महाभूतकृतो गुणः।\nपृथक्त्वेन हि भूतानां विषया वै गुणाःस्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2101687, "chapter_id": 3194, "verse_number": "१४-५०-३५", "content_sanskrit": "बीजधर्मं यथाऽव्यक्तं तथैव प्रसवात्मकम्।\nबीजधर्मा महानात्मा प्रसवश्चेति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2101688, "chapter_id": 3194, "verse_number": "१४-५०-३६", "content_sanskrit": "बीजधर्मात्साहङ्कारात्प्रसवश्च पुनःपुनः।\nबीजप्रसवधर्माणि महाभूतानि पञ्च वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2101689, "chapter_id": 3194, "verse_number": "१४-५०-३७", "content_sanskrit": "बीजधर्मिण इत्याहुः प्रसवं च प्रकुर्वते।\nविशेषाः पञ्चभूतानां तेषां वित्त विशेषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2101690, "chapter_id": 3194, "verse_number": "१४-५०-३८", "content_sanskrit": "तत्रैकगुणमाकाशं द्विगुणो वायुरुच्यते।\nत्रिगुणं ज्योतिरित्याहुरापश्चापि चतुर्गुणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2101691, "chapter_id": 3194, "verse_number": "१४-५०-३९", "content_sanskrit": "पृथ्वी पञ्चगुणा ज्ञेया चरस्थावरसङ्कुला।\nसर्वभूतकरी देवी शुभाशुभनिदर्शिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2101692, "chapter_id": 3194, "verse_number": "१४-५०-४०", "content_sanskrit": "शब्दः स्पर्शस्तथा रूपं रसो गन्धश्च पञ्चमः।\nएते पञ्चगुणा भूमेर्विज्ञेया द्विजसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2101693, "chapter_id": 3194, "verse_number": "१४-५०-४१", "content_sanskrit": "पार्थिवश्च सदा गन्धो गन्धश्च बहुधा स्मृतः।\nतस्य गन्धस्य वक्ष्यामि विस्तरेण बहून्गुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2101694, "chapter_id": 3194, "verse_number": "१४-५०-४२", "content_sanskrit": "इष्टश्चानिष्टगन्धश्च मधुरोऽम्लः कटुस्तथा।\nनिर्हारी संहतः स्निग्धो रूक्षो विशद एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2101695, "chapter_id": 3194, "verse_number": "१४-५०-४३", "content_sanskrit": "एवं दशविधो ज्ञेयः पार्थिवो गन्ध इत्युत।\nशब्दः स्पर्शस्तथा रूपं द्रवश्चापां गुणाः स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2101696, "chapter_id": 3194, "verse_number": "१४-५०-४४", "content_sanskrit": "रसज्ञानं तु वक्ष्यामि रसस्तु बहुधा स्मृतः।\nमधुरोऽम्लः कटुस्तिक्तः कषायो लवणस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2101697, "chapter_id": 3194, "verse_number": "१४-५०-४५", "content_sanskrit": "एवं षड्विधविस्तारो रसो वारिमयः स्मृतः।\nशब्दः स्पर्शस्तथा रूपं त्रिगुणं ज्योतिरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2101698, "chapter_id": 3194, "verse_number": "१४-५०-४६", "content_sanskrit": "ज्योतिषश्च गुणो रूपं रूपं च बहुधा स्मृतम्।\nशुक्लं कृष्णं तथा रक्तं नीलं पीतारुणं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2101699, "chapter_id": 3194, "verse_number": "१४-५०-४७", "content_sanskrit": "ह्रस्वं दीर्घं कृशं स्थूलं चतुरश्राणुवृत्तकम्।\nएवं द्वादशविस्तारं तेजसो रूपमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2101700, "chapter_id": 3194, "verse_number": "१४-५०-४८", "content_sanskrit": "विज्ञेयं ब्राह्मणैर्वृद्धैर्धर्मज्ञैः सत्यवादिभिः।\nशब्दस्पर्शौ च विज्ञेयौ द्विगुणो वायुरुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2101701, "chapter_id": 3194, "verse_number": "१४-५०-४९", "content_sanskrit": "वायोश्चापि गुणः स्पर्शः स्पर्सश्च बहुधा स्मृतः।\nउष्णः शीतः सुखो दुःखः स्निग्धो विशद एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2101702, "chapter_id": 3194, "verse_number": "१४-५०-५०", "content_sanskrit": "कठिनश्चिक्वणः श्लक्ष्णः पिच्छिलो दारुणो मृदुः।\nएवं द्वादशविस्तारो वायव्यो गुण उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2101703, "chapter_id": 3194, "verse_number": "१४-५०-५१", "content_sanskrit": "विधिवद्ब्राह्मणैः सिद्धैर्मन्त्रज्ञैस्तत्त्वदार्शिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2101704, "chapter_id": 3194, "verse_number": "१४-५०-५२", "content_sanskrit": "तत्रैकगुणमाकाशं शब्द इत्येव च स्मृतः।\nतस्य शब्दस्यि वक्ष्यामि विस्तरेण बहून्गुणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2101705, "chapter_id": 3194, "verse_number": "१४-५०-५३", "content_sanskrit": "षड्जर्षभः सगान्धारो मध्यमः पञ्चमस्तथा।\nअतः परं तु विज्ञेयो निषादो धैवतस्तथा।\nइष्टश्चानिष्टशब्दश्च संहतः प्रतिभानवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2101706, "chapter_id": 3194, "verse_number": "१४-५०-५४", "content_sanskrit": "एवं बहुविधो ज्ञेयः शब्द आकाशसम्भवः।\nआकाशमुत्तमं भूतमहङ्कारस्ततः परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2101707, "chapter_id": 3194, "verse_number": "१४-५०-५५", "content_sanskrit": "अहङ्कारात्परा बुद्धिर्बुद्धेरात्मा ततः परः।\nतस्मात्तु परमव्यक्तमव्यक्तात्पुरुषः परः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2101708, "chapter_id": 3194, "verse_number": "१४-५०-५६", "content_sanskrit": "परावरज्ञो भूतानां विधिज्ञः सर्वकर्मणाम्।\nसर्वभूतात्मभूतात्मा यं प्राप्यानन्त्यमश्नुते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2101709, "chapter_id": 3194, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि पञ्चाशोऽध्यायः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]