[{"id": 2146415, "chapter_id": 4158, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146416, "chapter_id": 4158, "verse_number": "१", "content_sanskrit": "तत आश्वासयामास पुत्राधिभिरभिप्लुताम् ।\nपितृष्वसारं शोचन्तीं पृथां पार्थसखो हरिः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146417, "chapter_id": 4158, "verse_number": "२", "content_sanskrit": "का नु सीमन्तिनी त्वादृग् लोकेष्वस्ति पितृष्वसः ।\nशूरस्य राज्ञो दुहिता आजमीढकुलं गता\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146418, "chapter_id": 4158, "verse_number": "३", "content_sanskrit": "महाकुलीना भवती ह्रदाद् ह्रदमिवागता ।\nईश्वरी सर्वकल्याणी भर्त्रा परमपूजिता\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146419, "chapter_id": 4158, "verse_number": "४", "content_sanskrit": "वीरसूर्वीरपत्नी त्वं सर्वैः समुदिता गुणैः ।\nसुखदुःखे महाप्राज्ञे त्वादृशी सोढुमर्हति\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146420, "chapter_id": 4158, "verse_number": "५", "content_sanskrit": "निद्रातन्द्रे क्रोधहर्षौ क्षुत्पिपासे हिमातपौ ।\nएतानि पार्था निर्जित्य नित्यं वीराः सुखे रताः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146421, "chapter_id": 4158, "verse_number": "६", "content_sanskrit": "त्यक्तग्राम्यसुखाः पार्था नित्यं वीरसुखप्रियाः ।\nन ते स्वल्पेन तुष्येयुः महोत्साहा महाबलाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146422, "chapter_id": 4158, "verse_number": "७", "content_sanskrit": "अन्तं धीरा निषेवन्ते मध्यं ग्राम्यसुखप्रियाः ।\nउत्तमाश्च परिक्लेशान् भोगांश्चैवातिमानुषान्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146423, "chapter_id": 4158, "verse_number": "८", "content_sanskrit": "अन्तेषु रेमिरे धीरा न ते मध्येषु रेमिरे ।\nअन्तप्राप्तिं सुखं प्राहुर्दुःखमन्तरमन्तयोः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146424, "chapter_id": 4158, "verse_number": "९", "content_sanskrit": "अभिवादयन्ति भवतीं पाण्डवाः सह कृष्णया ।\nआत्मानं ते कुशलिनं निवेद्याहुरनामयम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146425, "chapter_id": 4158, "verse_number": "१०", "content_sanskrit": "अरोगान् सर्वसिद्धार्थान् क्षिप्रं द्रक्ष्यति पाण्डवान् ।\nईश्वरान् सर्वलोकस्य हतामित्रान् श्रिया वृतान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146426, "chapter_id": 4158, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146427, "chapter_id": 4158, "verse_number": "११", "content_sanskrit": "एवमाश्वासिता कुन्ती प्रत्युवाच जनार्दनम् ।\nपुत्राधिभिरभिध्वस्ता निगृह्याबुद्धिजं तमः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146428, "chapter_id": 4158, "verse_number": "१२", "content_sanskrit": "यद्यत् तेषां महाबाहो पथ्यं स्यान्मधुसूदन ।\nयथा यथा त्वं मन्येथाः कुर्याः कृष्ण तथा तथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146429, "chapter_id": 4158, "verse_number": "१३", "content_sanskrit": "अविलोपेन धर्मस्य अनिकृत्या परन्तप\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146430, "chapter_id": 4158, "verse_number": "१४", "content_sanskrit": "प्रभावज्ञाऽस्मि ते कृष्ण सत्यस्याभिजनस्य च ।\nव्यवसायस्य मित्रेषु बुद्धिविक्रमयोस्तथा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146431, "chapter_id": 4158, "verse_number": "१५", "content_sanskrit": "त्वमेव नः कुले धर्मः त्वं सत्यं त्वं तपो महत् ।\nत्वं धाता त्वं महद्ब्रह्म त्वयि सर्वं प्रतिष्ठितम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146432, "chapter_id": 4158, "verse_number": "१६", "content_sanskrit": "यथैवात्थ तथैवैतत् त्वयि सत्यं भविष्यति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146433, "chapter_id": 4158, "verse_number": "१७", "content_sanskrit": "कुरूणां पाण्डवानां च लोकानां चापराजित ।\nसर्वस्यैतस्य वार्ष्णेय गतिस्त्वमसि माधव\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146434, "chapter_id": 4158, "verse_number": "१८", "content_sanskrit": "प्रभावो बुद्धिवीर्यं च तादृशं तव केशव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146435, "chapter_id": 4158, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146436, "chapter_id": 4158, "verse_number": "१९", "content_sanskrit": "तामामन्त्र्य च गोविन्दः कृत्वा चापि प्रदक्षिणम् ।\nप्रातिष्ठत महाबाहुः दुर्योधनगृहान् प्रति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146437, "chapter_id": 4158, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोननवतितमोऽध्यायः ॥८९॥\nभगवद्यानपर्वणि विंशोऽध्यायः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]