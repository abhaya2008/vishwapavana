[{"id": 2069429, "chapter_id": 2454, "verse_number": "१०-६-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069430, "chapter_id": 2454, "verse_number": "१०-६-१", "content_sanskrit": "द्वारदेशे ततो द्रौणिमवस्थितमवेक्ष्य तौ।\nअकुर्वतां भोजकृपौ किं सञ्जय वदस्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069431, "chapter_id": 2454, "verse_number": "१०-६-२x", "content_sanskrit": "स़ञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069432, "chapter_id": 2454, "verse_number": "१०-६-२", "content_sanskrit": "कृतवर्माणमामन्त्र्य कृपं च स महारथः।\nद्रौणिर्मन्युपरीतात्मा शिबिरद्वारमासदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069433, "chapter_id": 2454, "verse_number": "१०-६-३", "content_sanskrit": "तत्र भूतं महाकायं चन्द्रार्कसदृशद्युतिम्।\nसोऽपश्यद्द्वारमावृत्य तिष्ठन्तं रोमहर्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069434, "chapter_id": 2454, "verse_number": "१०-६-४", "content_sanskrit": "वसानं चर्म वैयाघ्रं वसारुधिरविस्रवम्।\nकृष्णाजिनोत्तरासङ्गं नागयज्ञोपवीतिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069435, "chapter_id": 2454, "verse_number": "१०-६-५", "content_sanskrit": "बाहुभिः स्वायतैर्भीमैर्नानाप्रहरणोद्यतैः।\nबद्धाङ्गदमहासर्पं ज्वालामालाकुलाननम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069436, "chapter_id": 2454, "verse_number": "१०-६-६", "content_sanskrit": "दंष्ट्राकरालवदनं व्यादितास्यं भयानकम्।\nनयनानां सहस्रैश्च विचित्रैरभिभूषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069437, "chapter_id": 2454, "verse_number": "१०-६-७", "content_sanskrit": "नैव तस्य वपुः शक्यं प्रवक्तुं वेष एव च।\nसर्वथा तु तदालक्ष्य स्फुटेयुरपि पर्वताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069438, "chapter_id": 2454, "verse_number": "१०-६-८", "content_sanskrit": "तस्यास्यनासिकाभ्यां च श्रवणाभ्यां च सर्वशः।\nतेभ्यश्चाक्षिसहस्रेभ्यः प्रादुरासन्महार्चिषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069439, "chapter_id": 2454, "verse_number": "१०-६-९", "content_sanskrit": "तथा तेजोमरीचिभ्यः शङ्खचक्रगदाधराः।\nप्रादुरासन्हृषीकेशाः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069440, "chapter_id": 2454, "verse_number": "१०-६-१०", "content_sanskrit": "तदत्यद्भुतमालोक्य भूतं लोकभयङ्करम्।\nद्रौणिरव्यथितो दिव्यैरस्त्रवर्षैरवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069441, "chapter_id": 2454, "verse_number": "१०-६-११", "content_sanskrit": "द्रौणिमुक्ताञ्छरांस्तांस्तु तद्भूतं महदग्रसत्।\nउदधेरिव वार्योघान्पावको बडबामुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069442, "chapter_id": 2454, "verse_number": "१०-६-१२", "content_sanskrit": "अश्वत्थामा तु सम्प्रेक्ष्य शरौघांस्तान्निरर्थकान्।\nरथशक्तिं मुमोचास्मै दीप्तामग्निशिखामिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069443, "chapter_id": 2454, "verse_number": "१०-६-१३", "content_sanskrit": "सा तमाहत्य दीप्ताग्रा रथशक्तिरदीर्यत।\nयुगान्ते सूर्यमाहत्य महोल्केव दिवश्च्युता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069444, "chapter_id": 2454, "verse_number": "१०-६-१४", "content_sanskrit": "अथ हेमत्सरुं दिव्यं खङ्गमाकाशवर्चसम्॥\nकोशात्समुद्बबर्हाशु बिलाद्दीप्तमिवोरगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069445, "chapter_id": 2454, "verse_number": "१०-६-१५", "content_sanskrit": "ततः खङ्गवरं धीमान्भूताय प्राहिणोत्तदा।\nस तदासाद्य भूतं वै विलयं तूलवद्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069446, "chapter_id": 2454, "verse_number": "१०-६-१६", "content_sanskrit": "ततः स कुपितो द्रौणिरिन्द्रकेतुनिभां गदाम्।\nज्वलन्तीं प्राहिणोत्तस्मै भूतं तामपि चाग्रसत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069447, "chapter_id": 2454, "verse_number": "१०-६-१७", "content_sanskrit": "ततः सर्वायुधाभावे वीक्षमाणस्ततस्ततः।\nअपश्यत्कृतमाकाशमनाकाशं जनार्दनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069448, "chapter_id": 2454, "verse_number": "१०-६-१८", "content_sanskrit": "तदद्भुततमं दृष्ट्वा द्रोणपुत्रो निरायुधः।\nअचिन्तयत्सुसन्त्रस्तः कृपभोजवचः स्मरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069449, "chapter_id": 2454, "verse_number": "१०-६-१९", "content_sanskrit": "ब्रुवतामप्रियं पथ्यं सुहृदां न शृमोति यः।\nस शोचत्यापदं प्राप्य थाऽहमवमत्य तौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069450, "chapter_id": 2454, "verse_number": "१०-६-२०", "content_sanskrit": "शास्त्रदृष्टानविद्वान्यः समतीत्य जिघांसति।\nस पथः प्रच्युतो धर्म्यात्कुपथे प्रतिहन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069451, "chapter_id": 2454, "verse_number": "१०-६-२१", "content_sanskrit": "गोब्राह्मणनृपस्त्रीषु सख्युर्मातुर्गुरोस्तथा।\nवृद्धबालजडान्धेषु सुप्तभीतोत्थितेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2069452, "chapter_id": 2454, "verse_number": "१०-६-२२", "content_sanskrit": "मत्तोन्मत्तप्रमत्तेषु न शस्त्राणि च मातयेत्।\nइत्येवं गुरुभिः पूर्वमुपदिष्टं नृणां सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2069453, "chapter_id": 2454, "verse_number": "१०-६-२३", "content_sanskrit": "सोऽहमुत्क्रम्य पन्थानं शास्त्रदृष्टं सनातनम्।\nअमार्गेणैवमारभ्य घोरामापदमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2069454, "chapter_id": 2454, "verse_number": "१०-६-२४", "content_sanskrit": "तां चापदं घोरतरां प्रवदन्ति मनीषिणः।\nयदुद्यम्य महत्कृत्यं भयादपि निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2069455, "chapter_id": 2454, "verse_number": "१०-६-२५", "content_sanskrit": "अशक्यं चैव कः कर्तुं शक्तः शक्तिबलादिह।\nन हि दैवाद्गरीयो वै मानुष्यं किञ्चिदिष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2069456, "chapter_id": 2454, "verse_number": "१०-६-२६", "content_sanskrit": "मानुष्यं कुर्वतः कर्म यदि दैवान्न सिध्यति।\nस पथः प्रच्युतो धर्म्याद्विपदं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2069457, "chapter_id": 2454, "verse_number": "१०-६-२७", "content_sanskrit": "प्रतिज्ञानं ह्यविज्ञानं प्रवदन्ति मनीषिणः।\nयदारभ्य क्रियां काञ्चिद्भयादिह निवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2069458, "chapter_id": 2454, "verse_number": "१०-६-२८", "content_sanskrit": "तदिदं दुष्प्रणीतेन भयं मा समुपस्थितम्।\nन हि द्रोणसुतः सङ्ख्ये निवर्तेत कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2069459, "chapter_id": 2454, "verse_number": "१०-६-२९", "content_sanskrit": "इदं च सुमहद्भूतं दैवदण्डमिवोद्यतम्।\nन चैतदभिजानामि चिन्तयन्नपि सर्वथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2069460, "chapter_id": 2454, "verse_number": "१०-६-३०", "content_sanskrit": "ध्रुवं येयमधर्मेण प्रहिता कलुषा मतिः।\nतस्याः फलमिदं घोरं प्रतिघाताय कल्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2069461, "chapter_id": 2454, "verse_number": "१०-६-३१", "content_sanskrit": "तदिदं दैवविहितं मम सङ्ख्ये निवर्तनम्।\nनान्यत्र दैवादुद्यन्तुमिह शक्यं कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2069462, "chapter_id": 2454, "verse_number": "१०-६-३२", "content_sanskrit": "सोऽहमद्य महादेवं प्रपद्ये शरणं विभुम्।\nदैवदण्डमिमं घोरं स हि मे नाशयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2069463, "chapter_id": 2454, "verse_number": "१०-६-३३", "content_sanskrit": "कपर्दिनं प्रपद्येऽहं देवदेवमुमापतिम्।\nकपालमालिनं रुद्रं भगनेत्रहरं हरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2069464, "chapter_id": 2454, "verse_number": "१०-६-३४", "content_sanskrit": "स हि देवोऽत्यगाद्देवांस्तपसा विक्रमेण च।\nतस्माच्छरणमभ्येष्ये गिरिशं शूलपाणिनम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2069465, "chapter_id": 2454, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि षष्ठोऽध्यायः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}]