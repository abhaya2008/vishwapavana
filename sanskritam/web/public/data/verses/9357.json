[{"id": 5000357000, "chapter_id": 9357, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे सुन्दरकाण्डे अष्टादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000357001, "chapter_id": 9357, "verse_number": "५-१८-१", "content_sanskrit": "तथा विप्रेक्षमाणस्य वनं पुष्पितपादपम्।\nविचिन्वतश्च वैदेहीं किञ्चिच्छेषा निशाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000357002, "chapter_id": 9357, "verse_number": "५-१८-२", "content_sanskrit": "षडंगवेदविदुषां क्रतुप्रवरयाजिनाम्।\nशुश्राव ब्रह्मघोषान् स विरात्रे ब्रह्मरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000357003, "chapter_id": 9357, "verse_number": "५-१८-३", "content_sanskrit": "अथ मंगलवादित्रैः शब्दैः श्रोत्रमनोहरैः।\nप्राबोध्यत महाबाहुर्दशग्रीवो महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000357004, "chapter_id": 9357, "verse_number": "५-१८-४", "content_sanskrit": "विबुध्य तु महाभागो राक्षसेन्द्रः प्रतापवान्।\nस्रस्तमाल्याम्बरधरो वैदेहीमन्वचिन्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000357005, "chapter_id": 9357, "verse_number": "५-१८-५", "content_sanskrit": "भृशं नियुक्तस्तस्यां च मदनेन मदोत्कटः।\nन तु तं राक्षसः कामं शशाकात्मनि गूहितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000357006, "chapter_id": 9357, "verse_number": "५-१८-६", "content_sanskrit": "स सर्वाभरणैर्युक्तो बिभ्रच्छ्रियमनुत्तमाम्।\nतां नगैर्विविधैर्जुष्टां सर्वपुष्पफलोपगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000357007, "chapter_id": 9357, "verse_number": "५-१८-७", "content_sanskrit": "वृतां पुष्करिणीभिश्च नानापुष्पोपशोभिताम्।\nसदा मत्तैश्च विहगैर्विचित्रां परमाद्भुतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000357008, "chapter_id": 9357, "verse_number": "५-१८-८", "content_sanskrit": "ईहामृगैश्च विविधैर्वृतां दृष्टिमनोहरैः।\nवीथीः सम्प्रेक्षमाणश्च मणिकाञ्चनतोरणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000357009, "chapter_id": 9357, "verse_number": "५-१८-९", "content_sanskrit": "नानामृगगणाकीर्णां फलैः प्रपतितैर्वृताम्।\nअशोकवनिकामेव प्राविशत् संततद्रुमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000357010, "chapter_id": 9357, "verse_number": "५-१८-१०", "content_sanskrit": "अंगनाः शतमात्रं तु तं व्रजन्तमनुव्रजन्।\nमहेन्द्रमिव पौलस्त्यं देवगन्धर्वयोषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000357011, "chapter_id": 9357, "verse_number": "५-१८-११", "content_sanskrit": "दीपिकाः काञ्चनीः काश्चिज्जगृहुस्तत्र योषितः।\nवालव्यजनहस्ताश्च तालवृन्तानि चापराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000357012, "chapter_id": 9357, "verse_number": "५-१८-१२", "content_sanskrit": "काञ्चनैश्चैव भृंगारैर्जह्रुः सलिलमग्रतः।\nमण्डलाग्रा बृसीश्चैव गृह्यान्याः पृष्ठतो ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000357013, "chapter_id": 9357, "verse_number": "५-१८-१३", "content_sanskrit": "काचिद् रत्नमयीं पात्रीं पूर्णां पानस्य भ्राजतीम्।\nदक्षिणा दक्षिणेनैव तदा जग्राह पाणिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000357014, "chapter_id": 9357, "verse_number": "५-१८-१४", "content_sanskrit": "राजहंसप्रतीकाशं छत्रं पूर्णशशिप्रभम्।\nसौवर्णदण्डमपरा गृहीत्वा पृष्ठतो ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000357015, "chapter_id": 9357, "verse_number": "५-१८-१५", "content_sanskrit": "निद्रामदपरीताक्ष्यो रावणस्योत्तमस्त्रियः।\nअनुजग्मुः पतिं वीरं घनं विद्युल्लता इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000357016, "chapter_id": 9357, "verse_number": "५-१८-१६", "content_sanskrit": "व्याविद्धहारकेयूराः समामृदितवर्णकाः।\nसमागलितकेशान्ताः सस्वेदवदनास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000357017, "chapter_id": 9357, "verse_number": "५-१८-१७", "content_sanskrit": "घूर्णन्त्यो मदशेषेण निद्रया च शुभाननाः।\nस्वेदक्लिष्टांगकुसुमाः समाल्याकुलमूर्धजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000357018, "chapter_id": 9357, "verse_number": "५-१८-१८", "content_sanskrit": "प्रयान्तं नैर्ऋतपतिं नार्यो मदिरलोचनाः।\nबहुमानाच्च कामाच्च प्रियभार्यास्तमन्वयुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000357019, "chapter_id": 9357, "verse_number": "५-१८-१९", "content_sanskrit": "स च कामपराधीनः पतिस्तासां महाबलः।\nसीतासक्तमना मन्दो मन्दाञ्चितगतिर्बभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000357020, "chapter_id": 9357, "verse_number": "५-१८-२०", "content_sanskrit": "ततः काञ्चीनिनादं च नूपुराणां च निःस्वनम्।\nशुश्राव परमस्त्रीणां कपिर्मारुतनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000357021, "chapter_id": 9357, "verse_number": "५-१८-२१", "content_sanskrit": "तं चाप्रतिमकर्माणमचिन्त्यबलपौरुषम्।\nद्वारदेशमनुप्राप्तं ददर्श हनुमान् कपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000357022, "chapter_id": 9357, "verse_number": "५-१८-२२", "content_sanskrit": "दीपिकाभिरनेकाभिः समन्तादवभासितम्।\nगन्धतैलावसिक्ताभिर्ध्रियमाणाभिरग्रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000357023, "chapter_id": 9357, "verse_number": "५-१८-२३", "content_sanskrit": "कामदर्पमदैर्युक्तं जिह्मताम्रायतेक्षणम्।\nसमक्षमिव कंदर्पमपविद्धशरासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000357024, "chapter_id": 9357, "verse_number": "५-१८-२४", "content_sanskrit": "मथितामृतफेनाभमरजोवस्त्रमुत्तमम्।\nसपुष्पमवकर्षन्तं विमुक्तं सक्तमंगदे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000357025, "chapter_id": 9357, "verse_number": "५-१८-२५", "content_sanskrit": "तं पत्रविटपे लीनः पत्रपुष्पशतावृतः।\nसमीपमुपसंक्रान्तं विज्ञातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000357026, "chapter_id": 9357, "verse_number": "५-१८-२६", "content_sanskrit": "अवेक्षमाणस्तु तदा ददर्श कपिकुञ्जरः।\nरूपयौवनसम्पन्ना रावणस्य वरस्त्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000357027, "chapter_id": 9357, "verse_number": "५-१८-२७", "content_sanskrit": "ताभिः परिवृतो राजा सुरूपाभिर्महायशाः।\nतन्मृगद्विजसंघुष्टं प्रविष्टः प्रमदावनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000357028, "chapter_id": 9357, "verse_number": "५-१८-२८", "content_sanskrit": "क्षीबो विचित्राभरणः शङ्कुकर्णो महाबलः।\nतेन विश्रवसः पुत्रः स दृष्टो राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000357029, "chapter_id": 9357, "verse_number": "५-१८-२९", "content_sanskrit": "वृतः परमनारीभिस्ताराभिरिव चन्द्रमाः।\nतं ददर्श महातेजास्तेजोवन्तं महाकपिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000357030, "chapter_id": 9357, "verse_number": "५-१८-३०", "content_sanskrit": "रावणोऽयं महाबाहुरिति संचिन्त्य वानरः।\nसोऽयमेव पुरा शेते पुरमध्ये गृहोत्तमे।\nअवप्लुतो महातेजा हनूमान् मारुतात्मजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000357031, "chapter_id": 9357, "verse_number": "५-१८-३१", "content_sanskrit": "स तथाप्युग्रतेजाः स निर्धूतस्तस्य तेजसा।\nपत्रे गुह्यान्तरे सक्तो मतिमान् संवृतोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000357032, "chapter_id": 9357, "verse_number": "५-१८-३२", "content_sanskrit": "स तामसितकेशान्तां सुश्रोणीं संहतस्तनीम्।\nदिदृक्षुरसितापांगीमुपावर्तत रावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000357033, "chapter_id": 9357, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये सुन्दरकाण्डे अष्टादशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]