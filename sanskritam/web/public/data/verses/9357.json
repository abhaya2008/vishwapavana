[{"id": 40021505, "chapter_id": 9357, "verse_number": "1", "content_sanskrit": "एवमास्ते महाबाहुरहन्यहनि राघवः । प्रशासत्सर्वकार्याणि पौरजानपदेषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40021506, "chapter_id": 9357, "verse_number": "2", "content_sanskrit": "ततः कतिपयाहःसु वैदेहं मिथिलाधिपम् । राघवः प्राञ्जलिर्भूत्वा वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40021507, "chapter_id": 9357, "verse_number": "3", "content_sanskrit": "भवान्हि गतिरव्यग्रा भवता पालिता वयम् । भवतस्तेजसोग्रेण रावणो निहतो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40021508, "chapter_id": 9357, "verse_number": "4", "content_sanskrit": "इक्ष्वाकूणां च सर्वेषां मैथिलानां च सर्वशः । अतुलाः प्रीतयो राजन्सम्बन्धकपुरोगमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40021509, "chapter_id": 9357, "verse_number": "5", "content_sanskrit": "तद्भवान्स्वपुरं यातु रत्नान्यादाय पार्थिव । भरतश्च सहायार्थं पृष्ठतस्ते ऽनुयास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40021510, "chapter_id": 9357, "verse_number": "6", "content_sanskrit": "स तथेति नृपः कृत्वा राघवं वाक्यमब्रवीत् । प्रीतो ऽस्मि भवतो राजन्दर्शनेन नयेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40021511, "chapter_id": 9357, "verse_number": "7", "content_sanskrit": "यान्येतानि तु रत्नानि मदर्थं सञ्चितानि वै । दुहित्रे तानि वै राजन्सर्वाण्येव ददामि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40021512, "chapter_id": 9357, "verse_number": "8", "content_sanskrit": "एवमुक्त्वा तु काकुत्स्थं जनको हृष्टमानसः । प्रययौ मिथिलां श्रीमांस्तमनुज्ञाय राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40021513, "chapter_id": 9357, "verse_number": "9", "content_sanskrit": "ततः प्रयाते जनके केकयं मातुलं प्रभुः । राघवः प्राञ्जलिर्भूत्वा वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40021514, "chapter_id": 9357, "verse_number": "10", "content_sanskrit": "इदं राज्यमहं चैव भरतश्च सलक्ष्मणः । आयत्तास्त्वं हि नो राजन्गतिश्च पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40021515, "chapter_id": 9357, "verse_number": "11", "content_sanskrit": "राजा हि वृद्धः सन्तापं त्वदर्थमुपयास्यति । तस्माद्गमनमद्यैव रोचते तव पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40021516, "chapter_id": 9357, "verse_number": "12", "content_sanskrit": "लक्ष्मणेनानुयात्रेण पृष्ठतो ऽनुगमिष्यते । धनमादाय विपुलं रत्नानि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40021517, "chapter_id": 9357, "verse_number": "13", "content_sanskrit": "युधाजित्तु तथेत्याह गमनं प्रति राघवम् । रत्नानि च धनं चैव त्वय्येवाक्षय्यमस्त्विति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40021518, "chapter_id": 9357, "verse_number": "14", "content_sanskrit": "प्रदक्षिणं स राजानं कृत्वा केकयवर्धनः । रामेण हि कृतः पूर्वमभिवाद्य प्रदक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40021519, "chapter_id": 9357, "verse_number": "15", "content_sanskrit": "लक्ष्मणेन सहायेन प्रयातः केकयेश्वरः । हते ऽसुरे यथा वृत्रे विष्णुना सह वासवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40021520, "chapter_id": 9357, "verse_number": "16", "content_sanskrit": "तं विसृज्य ततो रामो वयस्यमकुतोभयम् । प्रतर्दनं काशिपतिं परिष्वज्येदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40021521, "chapter_id": 9357, "verse_number": "17", "content_sanskrit": "दर्शिता भवता प्रीतिर्दर्शितं सौहृदं परम् । उद्योगश्च कृतो राजन्भरतेन त्वया सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40021522, "chapter_id": 9357, "verse_number": "18", "content_sanskrit": "तद्भवानद्य काशेय पुरीं वाराणसीं व्रज । रमणीयां त्वया गुप्तां सुप्रकाशां सुतोरणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40021523, "chapter_id": 9357, "verse_number": "19", "content_sanskrit": "एतावदुक्त्वा चोत्थाय काकुत्स्थः परमासनात् । पर्यष्वजत धर्मात्मा निरन्तरमुरोगतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40021524, "chapter_id": 9357, "verse_number": "20", "content_sanskrit": "विसर्जयामास तदा कौसल्यानन्दवर्धनः । राघवेणाभ्यनुज्ञातः काशीशो ऽप्यकुतोभयः । वाराणसीं ययौ तूर्णं राघवेण विसर्जितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40021525, "chapter_id": 9357, "verse_number": "21", "content_sanskrit": "विसृज्य तं काशिपतिं त्रिशतं पृथिवीपतीन् । प्रहसन्राघवो वाक्यमुवाच मधुराक्षरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40021526, "chapter_id": 9357, "verse_number": "22", "content_sanskrit": "भवतां प्रीतिरव्यग्रा तेजसा परिरक्षिता । धर्मश्च नियतो नित्यं सत्यं च भवतां सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40021527, "chapter_id": 9357, "verse_number": "23", "content_sanskrit": "युष्माकं चानुभावेन तेजसा च महात्मनाम् । हतो दुरात्मा दुर्बुद्धी रावणो राक्षसाधमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40021528, "chapter_id": 9357, "verse_number": "24", "content_sanskrit": "हेतुमात्रमहं तत्र भवतां तेजसा हतः । रावणः सगणो युद्धे सपुत्रामात्यबान्धवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40021529, "chapter_id": 9357, "verse_number": "25", "content_sanskrit": "भवन्तश्च समानीता भरतेन महात्मना । श्रुत्वा जनकराजस्य काननात्तनयां हृताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40021530, "chapter_id": 9357, "verse_number": "26", "content_sanskrit": "उद्युक्तानां च सर्वेषां पार्थिवानां महात्मनाम् । कालो व्यतीतः सुमहान्गमनं रोचयाम्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40021531, "chapter_id": 9357, "verse_number": "27", "content_sanskrit": "प्रत्यूचुस्तं च राजानो हर्षेण महता वृताः । दिष्ट्यां त्वं विजयी राम स्वराज्ये ऽपि प्रतिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40021532, "chapter_id": 9357, "verse_number": "28", "content_sanskrit": "दिष्ट्या प्रत्याहृता सीता दिष्ट्या शत्रुः पराजितः । एष नः परमः काम एषा नः पीतिरुत्तमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40021533, "chapter_id": 9357, "verse_number": "29", "content_sanskrit": "यत्त्वां विजयिनं राम पश्यामो हतशात्रवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40021534, "chapter_id": 9357, "verse_number": "30", "content_sanskrit": "एतत्त्वय्युपपन्नं च यदस्मांस्त्वं प्रशंससे । प्रशंसार्ह न जानीमः प्रशंसां वक्तुमीदृशीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40021535, "chapter_id": 9357, "verse_number": "31", "content_sanskrit": "आपृच्छामो गमिष्यामो हृदिस्थो नः सदा भवान् । वर्तामहे महाबाहो प्रीत्यात्र महता वृताः । भवेच्च ते महाराज प्रीतिरस्मासु नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40021536, "chapter_id": 9357, "verse_number": "32", "content_sanskrit": "बाढमित्येव राजानो हर्षेण परमान्विताः । उचुः प्राञ्जलयः सर्वे राघवं गमनोत्सुकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40021537, "chapter_id": 9357, "verse_number": "33", "content_sanskrit": "पूजिताश्चैव रामेण जग्मुर्देशान्स्वकान्स्वकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]