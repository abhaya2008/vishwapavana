[{"id": 2052301, "chapter_id": 2156, "verse_number": "७-८३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2052302, "chapter_id": 2156, "verse_number": "७-८३-१", "content_sanskrit": "सुखेन रजनी व्युष्टा कच्चित्ते मधुसूदन।\nकच्चिज्ज्ञानानि सर्वाणि प्रसन्नानि तवाच्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2052303, "chapter_id": 2156, "verse_number": "७-८३-२x", "content_sanskrit": "सञ्जाय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2052304, "chapter_id": 2156, "verse_number": "७-८३-२", "content_sanskrit": "वासुदेवोऽपि तद्युक्तं प्रत्युवाच युधिष्ठिरम्।\nदर्शनादेव ते सौम्य न किञ्चिदशुभं मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2052305, "chapter_id": 2156, "verse_number": "७-८३-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2052306, "chapter_id": 2156, "verse_number": "७-८३-३", "content_sanskrit": "ततश्च प्रकृतीः क्षत्ता न्यवेदयदुपस्थिताः।\nअनुज्ञातश्च राज्ञा स प्रावेशयत तं जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2052307, "chapter_id": 2156, "verse_number": "७-८३-४", "content_sanskrit": "विराटं भीमसेनं च धृष्टद्युम्नं च सात्यकिम्।\nचेदिपं धृष्टकेतुं च द्रुपदं च महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2052308, "chapter_id": 2156, "verse_number": "७-८३-५", "content_sanskrit": "शिखण़्डिनं यमौ चैव चेकितानं सकेकयम्।\nयुयुप्सुं चैव कौरव्यं पाञ्चाल्यं चोत्तमौजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2052309, "chapter_id": 2156, "verse_number": "७-८३-६", "content_sanskrit": "युधामन्यु सुबाहुं च द्रौपदेयांश्च सर्वशः।\nएतांश्च सुहृदश्चान्यान्दर्शयामास पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2052310, "chapter_id": 2156, "verse_number": "७-८३-७", "content_sanskrit": "अनुज्ञाताश्च पार्थेन स्वासीना आसनेषु ते।\nसर्वेष्वथ परार्ध्येषु यथार्हं वन्द्य पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2052311, "chapter_id": 2156, "verse_number": "७-८३-८", "content_sanskrit": "एकस्मिन्नासने वीरावुपविष्टौ महाबलौ।\nकृष्णश्च युयुधानश्च वेद्यामिव हुताशनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2052312, "chapter_id": 2156, "verse_number": "७-८३-९", "content_sanskrit": "ततो युधिष्ठिरस्तेषां शृण्वतां मधुसूदनम्।\nअब्रवीत्पुण्डरीकाक्षमाभाष्य मधुरं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2052313, "chapter_id": 2156, "verse_number": "७-८३-१०", "content_sanskrit": "एकं त्वां वयमाश्रित्य सहस्राक्षमिवामराः।\nप्रार्थयामो जयं युद्धे शाश्वतानि सुखानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2052314, "chapter_id": 2156, "verse_number": "७-८३-११", "content_sanskrit": "त्वं हि राज्यविनाशं च द्विषद्भिश्च निराक्रियाम्।\nक्लेशांश्च विविधान्कृष्ण सर्वांस्तानपि वेत्थ नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2052315, "chapter_id": 2156, "verse_number": "७-८३-१२", "content_sanskrit": "त्वयि सर्वेश सर्वेषामस्माकं भक्तवत्सल।\nसुखमायत्तमत्यर्थं यात्रा च मधुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2052316, "chapter_id": 2156, "verse_number": "७-८३-१३", "content_sanskrit": "स तथा कुरु वार्ष्णेय यथा त्वयि मनो मम।\nअर्जुनस्य यथा सत्या प्रतिज्ञा स्याच्चिकीर्षिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2052317, "chapter_id": 2156, "verse_number": "७-८३-१४", "content_sanskrit": "स भवांस्तारयत्वस्माद्दुःखामर्षमहार्णवात्।\nपरां तितीर्षतामद्य प्लुवो नो भव माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2052318, "chapter_id": 2156, "verse_number": "७-८३-१५", "content_sanskrit": "नहि तत्कुरुते योधः कार्तवीर्यसमोऽपि यः।\nयुधि यत्कुरुषे कृष्ण सारथ्यं त्वं समास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2052319, "chapter_id": 2156, "verse_number": "७-८३-१६", "content_sanskrit": "यथैव सर्वास्वापत्सु पासि वृष्णीञ्जनार्दन।\nतथैवास्मान्महाबाहो वृजिनात्त्रातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2052320, "chapter_id": 2156, "verse_number": "७-८३-१७", "content_sanskrit": "त्वमगाधेऽप्लवे मग्नान्पाण्डवान्कुरुसागरे।\nसमुद्धर प्लुवो भूत्वा शङ्खचक्रगदाधर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2052321, "chapter_id": 2156, "verse_number": "७-८३-१८", "content_sanskrit": "नमस्ते देवदेवेश सनातन विशातन।\nविष्णो जिष्णो हरे कृष्ण वैकुण्ठ पुरुषोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2052322, "chapter_id": 2156, "verse_number": "७-८३-१९", "content_sanskrit": "नारदस्त्वां समाचख्यौ पुराणमृषिसत्तमम्।\nवरदं शार्ङ्गिणं श्रेष्ठं तत्सत्यं कुरु माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2052323, "chapter_id": 2156, "verse_number": "७-८३-२०", "content_sanskrit": "इत्युक्तः पुण्डरीकाक्षो धर्मराजेन संसदि।\nतोयमेघस्वनो वाग्मी प्रत्युवाच युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2052324, "chapter_id": 2156, "verse_number": "७-८३-२१x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2052325, "chapter_id": 2156, "verse_number": "७-८३-२१", "content_sanskrit": "सामरेष्वपि लोकेषु सर्वेषु न तथाविधः।\nशरासनधरः कश्चिद्यथा पार्थो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2052326, "chapter_id": 2156, "verse_number": "७-८३-२२", "content_sanskrit": "वीर्यवानस्त्रसम्पन्नः पराक्रान्तो महाबलः।\nयुद्धशौण्डः सदामर्षी तेजसा परमो नृणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2052327, "chapter_id": 2156, "verse_number": "७-८३-२३", "content_sanskrit": "स युवा वृषभस्कन्धो दीर्घबाहुर्महाबलः।\nसिंहर्षभगतिः श्रीमान्द्विषतस्ते हनिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2052328, "chapter_id": 2156, "verse_number": "७-८३-२४", "content_sanskrit": "अहं च तत्करिष्यामि तथा कुन्तीसुतोऽर्जुनः।\nधार्तराष्ट्रस्य सैन्यानि धक्ष्यत्यग्निरिवेन्धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2052329, "chapter_id": 2156, "verse_number": "७-८३-२५", "content_sanskrit": "अद्य तं पापकर्माणं क्षुद्रं सौभद्रघातिनम्।\nअपुनर्दर्शनं मार्गमिषुभिः क्षेप्स्यतेऽर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2052330, "chapter_id": 2156, "verse_number": "७-८३-२६", "content_sanskrit": "तस्याद्य गृध्राः श्येनाश्च चण्डगोमायवस्तथा।\nभक्षयिष्यन्ति मांसानि ये चान्ये पुरुषादकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2052331, "chapter_id": 2156, "verse_number": "७-८३-२७", "content_sanskrit": "यद्यस्य देवा गोप्तारः सेन्द्राः सर्वे तथाऽप्यसौ।\nराजधानीं यमस्याद्य हतः प्राप्स्यति दुर्मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2052332, "chapter_id": 2156, "verse_number": "७-८३-२८", "content_sanskrit": "निहत्य सैन्धवं जिष्णुरद्य त्वामुपयास्यति।\nविशोको विज्वरो राजन्भव शान्ति पुरस्कृतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2052333, "chapter_id": 2156, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि प्रतिज्ञापर्वणि त्र्यशीतितमोऽध्यायः॥ ८३ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-८३-११ निराक्रियामपसारणम्॥ ५-८३-१२ यात्रा स्थितिः॥ ५-८३-१६ वृजिनात् व्यसनात्॥ ५-८३-१८ सनातन अनादिनिधन। विशा तन संहर्तः। कृष्ण संसारकर्षक। पुरुषोत्तम परमात्मन् ॥ ५-८३-२२ युद्धशौण्डः युद्धप्रवीणः॥ ५-८३-८३ त्र्यशीतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]