[{"id": 2119091, "chapter_id": 3559, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119092, "chapter_id": 3559, "verse_number": "१", "content_sanskrit": "अर्जुनो जयतां श्रेष्ठो मोक्षयित्वा मयं तदा ।\nकिं चकार महातेजास्तन्मे ब्रूहि द्विजोत्तम\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119093, "chapter_id": 3559, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119094, "chapter_id": 3559, "verse_number": "२", "content_sanskrit": "शृणु राजन् यथातत्त्वं चरितं पूर्वजस्य ते ।\nमोक्षयित्वा मयं तत्र पार्थः शस्त्रभृतां वरः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119095, "chapter_id": 3559, "verse_number": "३", "content_sanskrit": "गाण्डीवं कार्मुकश्रेष्ठं तूणी चाक्षयसायकौ ।\nदिव्यान्यस्त्राणि राजेन्द्र दुर्लभानि नृपैर्भुवि\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119096, "chapter_id": 3559, "verse_number": "४", "content_sanskrit": "रथं ध्वजं पताकाश्च श्वेताश्वैः सह वीर्यवान् ।\nएतानि पावकात् प्राप्य मुदा परमया युतः ।\nतस्थौ पार्थो महाबाहुस्तदा सह मयेन सः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119097, "chapter_id": 3559, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119098, "chapter_id": 3559, "verse_number": "५", "content_sanskrit": "ततोऽब्रवीन्मयः पार्थं वासुदेवस्य सन्निधौ ।\nपाण्डवेन परित्रातः तत्कृतं पर्यनुस्मरन् ।\nप्राञ्जलिः श्लक्ष्णया वाचा पूजयित्वा पुनःपुनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119099, "chapter_id": 3559, "verse_number": "६", "content_sanskrit": "अस्माच्च कृष्णात् सङ्क्रुद्धात् पावकाच्च दिधक्षतः ।\nत्वया त्रातोऽस्मि कौन्तेय ब्रूहि किं करवाणि ते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119100, "chapter_id": 3559, "verse_number": "७", "content_sanskrit": "अहं हि विश्वकर्मा वा असुराणां परन्तप ।\nतस्मात्ते विस्मयं किञ्चित् कुर्यामन्यैः सुदुष्करम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119101, "chapter_id": 3559, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119102, "chapter_id": 3559, "verse_number": "८", "content_sanskrit": "एवमुक्तो महावीर्यः पार्थो मायाविनं मयम् ।\nध्यात्वा मुहूर्तं कौन्तेयः प्रहसन् वाक्यमब्रवीत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119103, "chapter_id": 3559, "verse_number": "९", "content_sanskrit": "कृतमेव त्वया सर्वं स्वस्ति गच्छ महासुर ।\nप्रीतिमान् भव नो नित्यं प्रीतिमन्तो वयं त्वयि ।\nप्राप्तोपकारादर्थं हि नादास्यामीति मे व्रतम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119104, "chapter_id": 3559, "verse_number": "", "content_sanskrit": "मयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119105, "chapter_id": 3559, "verse_number": "१०", "content_sanskrit": "युक्तमेतत् त्वयि वचो यदात्थ पुरुषर्षभ ।\nप्रीतिपूर्वमहं किञ्चित् कर्तुमिच्छामि ते प्रियम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119106, "chapter_id": 3559, "verse_number": "११", "content_sanskrit": "अहं हि विश्वकर्मा वै दानवानां महाकविः ।\nसोऽहं वै तत्कृते किञ्चित् कर्तुमिच्छामि पाण्डव\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119107, "chapter_id": 3559, "verse_number": "१२", "content_sanskrit": "दानवानां पुरा पार्थ प्रासादा हि मया कृताः ।\nउद्यानानि च रम्याणि सरांसि विविधानि च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119108, "chapter_id": 3559, "verse_number": "१३", "content_sanskrit": "रम्याणि सुखदर्शानि भोगाढ्यानि सहस्रशः ।\nविचित्राणि च शस्त्राणि रथाः कामगमास्तथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119109, "chapter_id": 3559, "verse_number": "१४", "content_sanskrit": "नगराणि विशालानि साट्टप्राकारतोरणैः ।\nवाहनानि च मुख्यानि विचित्राणि सहस्रशः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119110, "chapter_id": 3559, "verse_number": "१५", "content_sanskrit": "बिलानि रमणीयानि सुखयुक्तानि वै भृशम् ।\nएते कृता मया सर्वे तस्मादिच्छामि फल्गुन\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119111, "chapter_id": 3559, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2119112, "chapter_id": 3559, "verse_number": "१६", "content_sanskrit": "प्राणकृच्छ्राद् विनिर्मुक्तम् आत्मानं मन्यसे मया ।\nएवं गते न शक्ष्यामि किञ्चित् कारयितुं त्वया\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2119113, "chapter_id": 3559, "verse_number": "१७", "content_sanskrit": "नचापि तव सङ्कल्पं मोघमिच्छामि दानव ।\nकृष्णस्य क्रियतां किञ्चित् तथा प्रतिकृतं मयि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2119114, "chapter_id": 3559, "verse_number": "", "content_sanskrit": "मयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119115, "chapter_id": 3559, "verse_number": "१८", "content_sanskrit": "वासुदेव मया कर्तुं किमिच्छसि शुभानन\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119116, "chapter_id": 3559, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119117, "chapter_id": 3559, "verse_number": "१९", "content_sanskrit": "चोदितो वासुदेवस्तु मयेन भरतर्षभ ।\nमुहूर्तमिव सन्दध्यौ किमयं चोद्यतामिति\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119118, "chapter_id": 3559, "verse_number": "२०", "content_sanskrit": "चोदयामास तं कृष्णः सभा वै क्रियतामिति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2119119, "chapter_id": 3559, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2119120, "chapter_id": 3559, "verse_number": "२१", "content_sanskrit": "धर्मराजस्य दयितां यादृशीमिव मन्यसे ।\nयां कृतां नानुकुर्युस्ते मानवाः प्रेक्ष्य विस्मिताः ।\nमनुष्यलोके कृत्स्नेऽस्मिन् तादृशीं कुरु वै सभाम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2119121, "chapter_id": 3559, "verse_number": "२२", "content_sanskrit": "यत्र दिव्यानभिप्रायान् पश्येम विहितांस्त्वया ।\nआसुरान् मानुषांश्चैव तादृशीं कुरु वै सभाम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2119122, "chapter_id": 3559, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2119123, "chapter_id": 3559, "verse_number": "२३", "content_sanskrit": "प्रतिगृह्य तु तद्वाक्यं सम्प्रहृष्टो मयस्तदा ।\nविमानप्रतिमां चक्रे पाण्डवस्य सभां मुदा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2119124, "chapter_id": 3559, "verse_number": "२४", "content_sanskrit": "ततः कृष्णश्च पार्थश्च धर्मराजे युधिष्ठिरे ।\nसर्वमेतद् यथाऽऽवेद्य दर्शयामासतुर्मयम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2119125, "chapter_id": 3559, "verse_number": "२५", "content_sanskrit": "तस्मै युधिष्ठिरः पूजां यथार्हमकरोत् तदा ।\nआसनं कल्पयामास पूजयामास च प्रभुः ।\nस च तां प्रतिजग्राह मयः सत्कृत्य सत्कृतः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2119126, "chapter_id": 3559, "verse_number": "२६", "content_sanskrit": "स पूर्वदेवचरितं तदा तत्र विशाम्पते ।\nकथयामास दैतेयः पाण्डुपुत्रेषु भारत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2119127, "chapter_id": 3559, "verse_number": "२७", "content_sanskrit": "स कालं कञ्चिदाश्वस्य विश्वकर्मा विचिन्त्य च ।\nसभां प्रचक्रमे कर्तुं पाण्डवानां महात्मनाम् ।\nअभिप्रायेण पार्थस्य कृष्णस्य च महात्मनः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2119128, "chapter_id": 3559, "verse_number": "२८", "content_sanskrit": "पुण्येऽहनि महाबाहुः कृतकौतुकमङ्गलः ।\nतर्पयित्वा द्विजश्रेष्ठान् पायसेन सहस्रशः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2119129, "chapter_id": 3559, "verse_number": "२९", "content_sanskrit": "धनं बहुविधं दत्वा तेभ्य एव च वीर्यवान् ।\nदश किष्कुसहस्राणि मापयामास सर्वतः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2119130, "chapter_id": 3559, "verse_number": "१", "content_sanskrit": "॥ इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2119131, "chapter_id": 3559, "verse_number": "१", "content_sanskrit": "॥ मन्त्रपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2119132, "chapter_id": 3559, "verse_number": "", "content_sanskrit": "— ०  —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]