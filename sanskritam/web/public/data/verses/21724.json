[{"id": 7001724000, "chapter_id": 21724, "verse_number": "१-११०-१", "content_sanskrit": "नारद उवाच ।\nपुराणसूत्रमखिलं श्रुतं तव मुखाद्विभो ।\nमरीचये यथा प्रोक्तं ब्रह्मणा परमेष्ठिना ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001724001, "chapter_id": 21724, "verse_number": "१-११०-२", "content_sanskrit": "अधुना तु महाभाग तिथीनां वै कथानकम् ।\nक्रमतो मह्यमाख्याहि यथा स्याद्वतनिश्चयः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001724002, "chapter_id": 21724, "verse_number": "१-११०-३", "content_sanskrit": "यस्मिन्मासे तु या पुण्या तिथिर्येन उपासिता ।\nयद्विधानं च पूजादेस्तत्सर्वं वद सांप्रतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001724003, "chapter_id": 21724, "verse_number": "१-११०-४", "content_sanskrit": "सनातन उवाच ।\nश्रृणु नारद वक्ष्यामि तिथीनां ते व्रतं पृथक् ।\nतिथीशानुक्रमादेव सर्वसिद्धिविधायकम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001724004, "chapter_id": 21724, "verse_number": "१-११०-५", "content_sanskrit": "चैत्रे मासि जगद्ब्रह्मा ससज प्रथमेऽहनि ।\nशुक्लपक्षे समग्रं वै तदा सूर्योदये सति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001724005, "chapter_id": 21724, "verse_number": "१-११०-६", "content_sanskrit": "वत्सरादौ वसंतादौ बलिराज्ये तथैव च ।\nपूर्वविद्धैव कर्तव्या प्रतिपत्सर्वदा बुधैः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001724006, "chapter_id": 21724, "verse_number": "१-११०-७", "content_sanskrit": "तत्र कार्या महाशांतिः सर्वकल्मषनाशिनी ।\nसर्वोत्पातप्रशमनी कलिदुष्कृतहारिणी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001724007, "chapter_id": 21724, "verse_number": "१-११०-८", "content_sanskrit": "आयुः प्रदापुष्टिकरी धनसौभाग्यवर्द्धिनी ।\nमंगल्या च पवित्रा च लोकद्वयमुखावहा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001724008, "chapter_id": 21724, "verse_number": "१-११०-९", "content_sanskrit": "तस्यामादौ तु संपूज्यो ब्रह्मा वह्निवपुर्धरः ।\nपाद्यार्ध्यपुष्पधूपैश्च वस्त्रालंकारभोजनैः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001724009, "chapter_id": 21724, "verse_number": "१-११०-१०", "content_sanskrit": "होमैर्बल्युपहारैश्च तथा ब्राह्मणतर्पणैः ।\nततः क्रमेण देवेभ्यः पूजा कार्या पृथक्पृथक् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001724010, "chapter_id": 21724, "verse_number": "१-११०-११", "content_sanskrit": "कृत्वोंकार नमस्कारं कुशोदकतिलाक्षतैः ।\nसवस्त्रं सहिरण्यं च ततो दद्याद्दिजातये ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001724011, "chapter_id": 21724, "verse_number": "१-११०-१२", "content_sanskrit": "दक्षिणां वेदविदुषे व्रतसंपूर्तिहेतवे ।\nएवं पूजाविशेषेण व्रतं स्यात्सौरिसंज्ञकम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001724012, "chapter_id": 21724, "verse_number": "१-११०-१३", "content_sanskrit": "आरोग्यदं नृणां विप्र तस्मिन्नेव दिने मुने ।\nविद्याव्रतमपि प्रोक्तमस्यामेव तिथौ मुने ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001724013, "chapter_id": 21724, "verse_number": "१-११०-१४", "content_sanskrit": "तिलकं नाम च प्रोक्तं कृष्णेनाजातशत्रवे ।\nअथ ज्येष्ठे सिते पक्षे पक्षत्यां दिवसोदये ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001724014, "chapter_id": 21724, "verse_number": "१-११०-१५", "content_sanskrit": "देवोद्यानभवं हृद्यं करवीरं समर्चयेत् ।\nरक्ततन्तुरीधानं गंधधूपविलेपनैः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001724015, "chapter_id": 21724, "verse_number": "१-११०-१६", "content_sanskrit": "प्ररूढसप्तधान्यैश्च नारगैर्बीजपूरकैः ।\nअभ्युक्ष्याक्षततोयेन मंत्रेणेत्थं क्षमापयेत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001724016, "chapter_id": 21724, "verse_number": "१-११०-१७", "content_sanskrit": "करवीर वृषावास नमस्ते भानुवल्लभ ।\nदंभोलिमृडदुर्गादिदेवानां सततं प्रिय ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001724017, "chapter_id": 21724, "verse_number": "१-११०-१८", "content_sanskrit": "आकृष्णेनेति वेदोक्तमंत्रेणेत्थं क्षमापयेत् ।\nएवं भक्त्या समभ्यर्च्य दत्त्वा विप्राय दक्षिणाम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001724018, "chapter_id": 21724, "verse_number": "१-११०-१९", "content_sanskrit": "प्रदक्षिणं ततः कुर्यात्पश्चात्स्वभवनं व्रजेत् ।\nनभः शुक्ले प्रतिपदि लक्ष्मीबुद्धिप्रदायकम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001724019, "chapter_id": 21724, "verse_number": "१-११०-२०", "content_sanskrit": "धर्मार्थकाममोक्षाणां निदानं परमं व्रतम् ।\nसोमवारं समारभ्य सार्धमासत्रयं द्विज ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001724020, "chapter_id": 21724, "verse_number": "१-११०-२१", "content_sanskrit": "कार्तिकासितभूतायामुपोष्यं व्रततत्परः ।\nपूर्णायां शिवमभ्यर्च्य सुवण वंशसंयुतम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001724021, "chapter_id": 21724, "verse_number": "१-११०-२२", "content_sanskrit": "वायनं सुमहत्पुण्यं देवताप्रीतिवर्धकम् ।\nदद्याद्विप्राय संकल्प्य धनवृद्ध्यै मुनीश्वर ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001724022, "chapter_id": 21724, "verse_number": "१-११०-२३", "content_sanskrit": "भाद्रशुक्लप्रतिपदि व्रतं नाम्ना महत्तमम् ।\nव्रतं मौनाह्वयं केचित्प्राहुरत्र शिवोऽर्च्यते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001724023, "chapter_id": 21724, "verse_number": "१-११०-२४", "content_sanskrit": "नैवेद्यं तु पचेन्मौनी षोडशत्रिगुणानि च ।\nफलानि पिष्टपक्वानि दद्याद्विप्राय षोडश ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001724024, "chapter_id": 21724, "verse_number": "१-११०-२५", "content_sanskrit": "देवाय षोडशान्यानि भुज्यंते षोडशात्मना ।\nसौवर्णं शिवमभ्यर्च्य कुम्भोपरि विधानवित् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001724025, "chapter_id": 21724, "verse_number": "१-११०-२६", "content_sanskrit": "तत्सर्वं धेनुसहितमाचार्य्याय प्रदापयेत् ।\nइदं कृत्वा व्रतं विप्र देव देवस्य शूलिनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001724026, "chapter_id": 21724, "verse_number": "१-११०-२७", "content_sanskrit": "चतुर्दशाब्दं देहांतं भुक्तभोगः शिवं व्रजेत् ।\nआश्विने सितपक्षत्यां कृत्वाशोकव्रतं नरः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001724027, "chapter_id": 21724, "verse_number": "१-११०-२८", "content_sanskrit": "अशोको जायते विप्रधनधान्यसमन्वितः ।\nअशोकपूजनं तत्र कार्यं नियमतत्परैः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001724028, "chapter_id": 21724, "verse_number": "१-११०-२९", "content_sanskrit": "व्रतांते द्वादशे वर्षे मूर्तिं चाशोकशाखिनः ।\nसमर्प्य गुरवे भक्त्या शिवलोके महीयते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001724029, "chapter_id": 21724, "verse_number": "१-११०-३०", "content_sanskrit": "अस्यामेव प्रतिपदि नवरात्रं समारभेत् ।\nपूर्वाह्णे पूजयेद्देवीं घटस्थापनपूर्वकम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001724030, "chapter_id": 21724, "verse_number": "१-११०-३१", "content_sanskrit": "अंकुरारोपणं कृत्वा यवैर्गोधूममिश्रितैः ।\nततः प्रतिदिनं कुर्यादेकभुक्तमयाचितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001724031, "chapter_id": 21724, "verse_number": "१-११०-३२", "content_sanskrit": "उपवासं यथाशक्ति पूजापाठजपादिकम् ।\nमार्कंण्डेय पुराणोक्तं चरितत्रितयं द्विज ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001724032, "chapter_id": 21724, "verse_number": "१-११०-३३", "content_sanskrit": "पठनीयं नवदिनं भुक्तिमुक्ती अभीप्सता ।\nकुमारीपूजनं तत्र प्रशस्तं भोजनादिभिः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001724033, "chapter_id": 21724, "verse_number": "१-११०-३४", "content_sanskrit": "इत्थं कृत्वा व्रतं विप्र सर्वसिद्ध्यालयो नरः ।\nजायते भुवि दुर्गायाः प्रसादान्नात्र संशयः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001724034, "chapter_id": 21724, "verse_number": "१-११०-३५", "content_sanskrit": "अथोर्जसितपक्षत्यां नवरात्रोदितं चरेत् ।\nविशेषादन्नकूटाख्यं विष्णुप्रीतिविवर्धनम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001724035, "chapter_id": 21724, "verse_number": "१-११०-३६", "content_sanskrit": "सर्वपाकैः सर्ददोहैः सर्वैः सर्वार्थसिद्धये ।\nकर्तव्यमन्नकूटं तु गोवर्द्धनसमर्चने ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001724036, "chapter_id": 21724, "verse_number": "१-११०-३७", "content_sanskrit": "सायं गोभिः सह श्रीमद्गोवर्द्धनधराधरम् ।\nसमर्च्य दक्षिणीकृत्य भुक्तिमुक्ती समाप्नुयात् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001724037, "chapter_id": 21724, "verse_number": "१-११०-३८", "content_sanskrit": "अथ मार्गसिताद्यायां धनव्रतमनुत्तमम् ।\nनक्तं विष्ण्वर्चनं होमैः सौवर्णीं हुतभुक्तनुम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001724038, "chapter_id": 21724, "verse_number": "१-११०-३९", "content_sanskrit": "रक्तवस्त्रयुगाच्छन्नां द्विजाय प्रतिपादयेत् ।\nएवं कृत्वा धनैर्धान्यैः समृद्धो जायते भुवि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001724039, "chapter_id": 21724, "verse_number": "१-११०-४०", "content_sanskrit": "वह्निना दग्धपापस्तु विष्णुलोके महीयते ।\nपौषशुक्लप्रतिपदि भानुमभ्यर्च्य भक्तितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001724040, "chapter_id": 21724, "verse_number": "१-११०-४१", "content_sanskrit": "एकभक्तव्रतो मर्त्यो भानुलोकमवाप्नुयात् ।\nमाघशुक्लाद्यदिवसे वह्निं साक्षान्महेश्वरम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001724041, "chapter_id": 21724, "verse_number": "१-११०-४२", "content_sanskrit": "समभ्यर्च्य विधानेन समृद्धो जायते भुवि ।\nअथ फाल्गुनशुक्लादौ देवदेवं दिगंबरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001724042, "chapter_id": 21724, "verse_number": "१-११०-४३", "content_sanskrit": "धूलिधूसरसर्वांगं जलैरुक्षेत्समंततः ।\nकर्मणा लौकिकेनापि संतुष्टो हि महेश्वरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001724043, "chapter_id": 21724, "verse_number": "१-११०-४४", "content_sanskrit": "स्वसायुज्यं प्रदिशति भक्त्या सम्यक्समर्चितः ।\nवैशाखे तु सिताद्यायां विष्णुं विश्वविहारिणम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001724044, "chapter_id": 21724, "verse_number": "१-११०-४५", "content_sanskrit": "समभ्यर्च्य विधानेन विप्रान्संभोजयेद्वती ।\nएवं शुचिसिताद्यायां ब्रह्माणं जगतां गुरुम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001724045, "chapter_id": 21724, "verse_number": "१-११०-४६", "content_sanskrit": "विष्णुना सहितो ब्रह्मा सर्वलोकेश्वरेश्वरः ।\nस्वसायुज्यं प्रदिशति सर्वसिद्धिमवाप्नुयात् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001724046, "chapter_id": 21724, "verse_number": "१-११०-४७", "content_sanskrit": "आसु द्वादशमासानां प्रतिपत्सु द्विजोत्तम ।\nव्रतानि तुभ्यं प्रोक्तानि भुक्तिमुक्तिप्रदानि च ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001724047, "chapter_id": 21724, "verse_number": "१-११०-४८", "content_sanskrit": "व्रतेष्वेतेषु सर्वेषु ब्रह्मचर्यं विधीयते ।\nभोजने तु हविष्यान्नं सामान्यत उदाहृतम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]