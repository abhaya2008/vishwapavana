[{"id": 2172738, "chapter_id": 4680, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2172739, "chapter_id": 4680, "verse_number": "१", "content_sanskrit": "एतच्छ्रुत्वा वचो राज्ञो मद्रराजः प्रतापवान् ।\nदुर्योधनं तदा राजन्निदं वचनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2172740, "chapter_id": 4680, "verse_number": "", "content_sanskrit": "शल्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2172741, "chapter_id": 4680, "verse_number": "२", "content_sanskrit": "दुर्योधन महाबाहो शृणु वाक्यमरिन्दम ।\nयावेतौ मन्यसे कृष्णौ रथस्थौ रथिनां वरौ ।\nन मे तुल्यावुभावेतौ बाहुवीर्ये कथञ्चन\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2172742, "chapter_id": 4680, "verse_number": "३", "content_sanskrit": "उद्यतां पृथिवीं सर्वां ससुरासुरमानवान् ।\nयोधयेयं रणमुखे सङ्क्रुद्धः किमु पाण्डवान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2172743, "chapter_id": 4680, "verse_number": "४", "content_sanskrit": "विजेष्ये च रणे पार्थान् सोमकांश्च समागतान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2172744, "chapter_id": 4680, "verse_number": "५", "content_sanskrit": "अहं सेनाप्रणेता वै भविष्यामि न संशयः ।\nतं च व्यूहं विधास्यामि न करिष्यन्ति यं परे\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2172745, "chapter_id": 4680, "verse_number": "६", "content_sanskrit": "अद्यैवाहं रणे सर्वान् पाञ्चालान् सह पाण्डवैः ।\nनिहनिष्यामि राजेन्द्र स्वर्गं यास्यामि वा हतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2172746, "chapter_id": 4680, "verse_number": "७", "content_sanskrit": "अद्य पश्यन्तु मां लोका विचरन्तमभीतवत् ।\nअद्य पाण्डुसुताः सर्वे वासुदेवोऽथ सात्यकिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2172747, "chapter_id": 4680, "verse_number": "८", "content_sanskrit": "पाञ्चालाश्चेदयश्चैव द्रौपदेयाश्च सर्वशः ।\nधृष्टद्युम्नः शिखण्डी च सर्वे चापि प्रभद्रकाः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2172748, "chapter_id": 4680, "verse_number": "९", "content_sanskrit": "विक्रमं मम पश्यन्तु धनुषश्च महद्बलम् ।\nलाघवं चास्त्रवीर्यं च भुजयोश्च बलं युधि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2172749, "chapter_id": 4680, "verse_number": "१०", "content_sanskrit": "अद्यः पश्यन्तु मे पार्थाः सिद्धाश्च सह चारणैः ।\nयादृशं मे बलं बाह्वोः सम्पदस्त्रेषु या च मे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2172750, "chapter_id": 4680, "verse_number": "११", "content_sanskrit": "अद्य मे विक्रमं दृष्ट्वा पाण्डवानां महारथाः ।\nप्रतीकारपरा भूत्वा चेष्टन्तां विविधाः क्रियाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2172751, "chapter_id": 4680, "verse_number": "१२", "content_sanskrit": "अद्य सैन्यानि पाण्डूनां द्रावयिष्ये समन्ततः ।\nभीष्मद्रोणावति विभो सूतपुत्रं च संयुगे\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2172752, "chapter_id": 4680, "verse_number": "१३", "content_sanskrit": "विचरिष्ये रणमुखे प्रियार्थं तव कौरव ।\nइति सत्यं ब्रवीम्येतद् दुर्योधन न संशयः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2172753, "chapter_id": 4680, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2172754, "chapter_id": 4680, "verse_number": "१४", "content_sanskrit": "एवमुक्तस्तदा राजा मद्राधिपतिमञ्जसा ।\nअभ्यषिञ्चच्च सेनायां मध्ये भारतसत्तम\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2172755, "chapter_id": 4680, "verse_number": "१५", "content_sanskrit": "विधिना शास्त्रदृष्टेन हृष्टरूपो विशाम्पते ।\nअभिषिक्ते ततः शल्ये सिंहनादो महानभूत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2172756, "chapter_id": 4680, "verse_number": "१६", "content_sanskrit": "तव सैन्येष्ववाद्यन्त वादित्राणि च सङ्घशः ।\nहृष्टाश्चासंस्तदा योधा मद्रकाश्च महारथाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2172757, "chapter_id": 4680, "verse_number": "१७", "content_sanskrit": "तुष्टुवुश्चैव राजानं शल्यमाहवशोभिनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2172758, "chapter_id": 4680, "verse_number": "", "content_sanskrit": "सैनिकाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2172759, "chapter_id": 4680, "verse_number": "१८", "content_sanskrit": "जय राजंश्चिरं जीव जहि शत्रून् समागतान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2172760, "chapter_id": 4680, "verse_number": "१९", "content_sanskrit": "तव बाहुबलं प्राप्य धार्तराष्ट्रो महाबलः ।\nनिखिलां पृथिवीं सर्वां प्रशास्तु निहतद्विषम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2172761, "chapter_id": 4680, "verse_number": "२०", "content_sanskrit": "त्वं हि शक्तो रणे जेतुं देवगन्धर्वदानवान् ।\nमर्त्यधर्माण इह तु किं न सोमकसृञ्जयान्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2172762, "chapter_id": 4680, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2172763, "chapter_id": 4680, "verse_number": "२१", "content_sanskrit": "एवं संस्तूयमानस्तु मद्राणामधिपो बली ।\nहर्षं प्राप तदा वीरो दुष्प्रापमकृतात्मभिः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2172764, "chapter_id": 4680, "verse_number": "२२", "content_sanskrit": "अद्य जेष्यामि कौरव्य सर्वान् शत्रून् तव प्रभो ।\nएतच्छ्रुत्वा सिंह(सिंह्य)नादमकरोद् बाहिनी तव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2172765, "chapter_id": 4680, "verse_number": "२३", "content_sanskrit": "अभिषिक्ते तदा शल्ये तव सैन्येषु मानद ।\nन कर्णव्यसनं किञ्चिन्मेनिरे तत्र भारत\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2172766, "chapter_id": 4680, "verse_number": "२४", "content_sanskrit": "हृष्टाः सुमनसश्चैव बभूवुस्तत्र सैनिकाः ।\nमेनिरे च तदा पार्थान् मद्रराजवशं गतान्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2172767, "chapter_id": 4680, "verse_number": "२५", "content_sanskrit": "प्रहर्षं प्राप्य सेना तु तावकी भरतर्षभ ।\nतां रात्रिं सुखिनी सुप्ता स्वस्थचित्तेव चाभवत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2172768, "chapter_id": 4680, "verse_number": "२६", "content_sanskrit": "सैन्यस्य तव तं श्रुत्वा शब्दं राजा युधिष्ठिरः ।\nवार्ष्णेयमब्रवीद् वाक्यं सर्वक्षत्रस्य पश्यतः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2172769, "chapter_id": 4680, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2172770, "chapter_id": 4680, "verse_number": "२७", "content_sanskrit": "मद्रराजः कृतः शल्यो धार्तराष्ट्रेण माधव ।\nसेनापतिर्महेष्वासः सर्वसैन्येषु पूजितः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2172771, "chapter_id": 4680, "verse_number": "२८", "content_sanskrit": "एतज्ज्ञात्वा तथा भूतं कुरु माधव नः क्षमम् ।\nभवान् नेता च गोप्ता च विधत्स्व यदनन्तरम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2172772, "chapter_id": 4680, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2172773, "chapter_id": 4680, "verse_number": "२९", "content_sanskrit": "तमब्रवीन्महाराज वासुदेवो महारथम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2172774, "chapter_id": 4680, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2172775, "chapter_id": 4680, "verse_number": "३०", "content_sanskrit": "आर्तायनिमहं जाने यथा तत्त्वेन भारत ।\nवीर्यवांश्च महेष्वासो महात्मा च विशेषतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2172776, "chapter_id": 4680, "verse_number": "३१", "content_sanskrit": "कृती च चित्रयोधी च संयुक्तो लाघवेन च\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2172777, "chapter_id": 4680, "verse_number": "३२", "content_sanskrit": "यादृग्भीष्मस्तथा द्रोणो यादृक् कर्णश्च संयुगे ।\nतादृशस्तद्विशिष्टो वा मद्रराजो न संशयः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2172778, "chapter_id": 4680, "verse_number": "३३", "content_sanskrit": "युध्यमानस्य तस्याजौ चिन्तयन्नेव भारत ।\nयोद्धारं नाधिगच्छामि तुल्यरूपं जनाधिपम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2172779, "chapter_id": 4680, "verse_number": "३४", "content_sanskrit": "शिखण्ड्यर्जुनभीमानां सात्वतस्य च भारत ।\nधृष्टद्युम्नस्य च तथा बलेनाभ्यधिको रणे\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2172780, "chapter_id": 4680, "verse_number": "३५", "content_sanskrit": "मद्रराजो महाराज सिंहद्विरदविक्रमः ।\nविचरिष्यत्यभीः काले कालः क्रुद्धः प्रजास्विव\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2172781, "chapter_id": 4680, "verse_number": "३६", "content_sanskrit": "तस्याद्य न प्रपश्यामि प्रतियोद्धारमाहवे ।\nत्वामृते पुरुषव्याघ्र शार्दूलसमविक्रमम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2172782, "chapter_id": 4680, "verse_number": "३७", "content_sanskrit": "स त्वमेको हि लोकेऽस्मिन् नान्यस्त्वत्तः पुमान् भवेत् ।\nमद्रराजं रणे क्रुद्धं यो हन्यात् कुरुनन्दन\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2172783, "chapter_id": 4680, "verse_number": "३८", "content_sanskrit": "अहन्यहनि युध्यन्तं क्षोभयन्तं बलं तव\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2172784, "chapter_id": 4680, "verse_number": "३९", "content_sanskrit": "तस्माज्जहि रणे शल्यं मघवानिव शम्बरम् ।\nअजेयश्चाप्यसौ वीरो धार्तराष्ट्रेण सत्कृतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2172785, "chapter_id": 4680, "verse_number": "४०", "content_sanskrit": "तवैव विजयो नूनं हतो मद्रेश्वरो भवेत् ।\nतस्मिन् हते हतं सर्वं धार्तराष्ट्रबलं महत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2172786, "chapter_id": 4680, "verse_number": "४१", "content_sanskrit": "एतच्छ्रुत्वा महाराज वचनं मम साम्प्रतम् ।\nप्रत्युद्याहि रणे पार्थ मद्रराजं महारथम्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2172787, "chapter_id": 4680, "verse_number": "४२", "content_sanskrit": "जहि चैनं महाबाहो वासवो नमुचिं यथा ।\nन चैवात्र दया कार्या मातुलोऽयं ममेति च\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2172788, "chapter_id": 4680, "verse_number": "४३", "content_sanskrit": "क्षत्रधर्मं पुरस्कृत्य जहि मद्रजनेश्वरम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2172789, "chapter_id": 4680, "verse_number": "४४", "content_sanskrit": "द्रोणभीष्मार्णवं तीर्त्वा कर्णपातालसम्भवम् ।\nमा निमज्जस्व सगणः शल्यमासाद्य गोष्पदम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2172790, "chapter_id": 4680, "verse_number": "४५", "content_sanskrit": "यच्च वै तपसो वीर्यं यच्च क्षत्रबलं तव ।\nतद्दर्शय रणे सर्वं जहि चैनं महाबलम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2172791, "chapter_id": 4680, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2172792, "chapter_id": 4680, "verse_number": "४६", "content_sanskrit": "एतावदुक्त्वा वचनं केशवः परवीरहा ।\nजगाम शिबिरं सायं पूज्यमानो हि पाण्डवैः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2172793, "chapter_id": 4680, "verse_number": "४७", "content_sanskrit": "केशवे तु तथा याते धर्मराजो युधिष्ठिरः ।\nविसृज्य सर्वान् भ्रातॄंश्च पाञ्चालानथ सोमकान्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2172794, "chapter_id": 4680, "verse_number": "४८", "content_sanskrit": "सुष्वाप रजनीं तां तु विशल्य इव कुञ्जरः\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2172795, "chapter_id": 4680, "verse_number": "४९", "content_sanskrit": "ते च सर्वे महेष्वासाः पाञ्चालाः पाण्डवास्तदा ।\nकर्णस्य निधने हृष्टाः सुषुपुस्तां निशां तदा\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2172796, "chapter_id": 4680, "verse_number": "५०", "content_sanskrit": "गतज्वरं महेष्वासं तीर्णपारं महारथम् ।\nबभूव पाण्डवेयानां सैन्यं प्रमुदितं निशि\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2172797, "chapter_id": 4680, "verse_number": "५१", "content_sanskrit": "सूतपुत्रस्य निधनाद् जयं लब्ध्वा च मारिष\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2172798, "chapter_id": 4680, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2172799, "chapter_id": 4680, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि सप्तमोऽध्यायः ॥७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]