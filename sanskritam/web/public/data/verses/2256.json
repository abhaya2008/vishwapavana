[{"id": 2058088, "chapter_id": 2256, "verse_number": "७-१८३-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2058089, "chapter_id": 2256, "verse_number": "७-१८३-१", "content_sanskrit": "एकवीरवधे मोघा शक्तिः सूतात्मजे यदा।\nकस्मात्सर्वान्समुत्सृज्य स तां पार्थे न मुक्तवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2058090, "chapter_id": 2256, "verse_number": "७-१८३-२", "content_sanskrit": "तस्मिन्हते हता हि स्युः सर्वे पाण्डवसृञ्जयाः।\nएकवीरवधे कस्माद्युद्धे न जयमादधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2058091, "chapter_id": 2256, "verse_number": "७-१८३-३", "content_sanskrit": "आहूतो न निवर्तेयमिति तस्य महाव्रतम्।\nस्वयं मार्गयितव्यः स सूतपुत्रेण फल्गुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2058092, "chapter_id": 2256, "verse_number": "७-१८३-४", "content_sanskrit": "ततो द्वैरथमानीय फल्गुनं शक्तदत्तया।\nजघान न वृषा कस्मात्तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2058093, "chapter_id": 2256, "verse_number": "७-१८३-५", "content_sanskrit": "नूनं बुद्धिविहीनश्चाप्यसहायश्च मे सुतः।\nशत्रुभिर्व्यंसितः पापः कथं नु स जयेदरीन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2058094, "chapter_id": 2256, "verse_number": "७-१८३-६", "content_sanskrit": "या ह्यस्य परमा शक्तिर्जयस्य च परायणम्।\nसा शख्तिर्वासुदेवेन व्यंसिता च घटोत्कचे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2058095, "chapter_id": 2256, "verse_number": "७-१८३-७", "content_sanskrit": "कुणेर्यथा हस्तगतं हियेद्बिल्वं बलीयसा।\nतथा शक्तिरमोघा सा मोघीभूता घटोत्कचे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2058096, "chapter_id": 2256, "verse_number": "७-१८३-८", "content_sanskrit": "यथा वराहस्य शुनश्च युध्यतो--\nस्तयोरभावे श्वपचस्य लाभः।\nमन्ये विद्वन्वासुदेवस्य तद्व--\nद्युद्धे लाभः कर्णहैडिम्बयोर्वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2058097, "chapter_id": 2256, "verse_number": "७-१८३-९", "content_sanskrit": "घटोत्कचो यदि हन्याद्वि कर्णं\nपरो लाभः स भवेत्पाण्डवानाम्।\nवैकर्तनो वा यदि तं निहन्या--\nत्तथापि कृत्यं शक्तिनाशात्कृतं स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2058098, "chapter_id": 2256, "verse_number": "७-१८३-१०", "content_sanskrit": "इति प्राज्ञः प्रज्ञयैतद्विचिन्त्य\nघटोत्कचं सूतपुत्रेण युद्धे।\nअघातयद्वासुदेवो नृसिंहः\nप्रियं कुर्वन्पाण्डवानां हितं च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2058099, "chapter_id": 2256, "verse_number": "७-१८३-११x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2058100, "chapter_id": 2256, "verse_number": "७-१८३-११", "content_sanskrit": "एतच्चिकीर्षितं ज्ञात्वा कर्णे मधुनिहा नृप।\nनियोजयामास तदा द्वैरथे राक्षसेश्वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2058101, "chapter_id": 2256, "verse_number": "७-१८३-१२", "content_sanskrit": "घटोत्कचं महावीर्यं महाबुद्धिर्जनार्दनः।\nअमोघाया विघातार्थं राजन्दुर्मन्त्रिते तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2058102, "chapter_id": 2256, "verse_number": "७-१८३-१३", "content_sanskrit": "तदैव कृतकार्या हि वयं स्याम कुरूद्वह।\nन रक्षेद्यदि कृष्णस्तं पार्थं कर्णान्महारथात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2058103, "chapter_id": 2256, "verse_number": "७-१८३-१४", "content_sanskrit": "साश्वध्वजरथः सङ्क्ये धृतराष्ट्र पतेद्भुवि।\nविना जनार्दनं पार्थो योगानामीश्वरं प्रभुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2058104, "chapter_id": 2256, "verse_number": "७-१८३-१५", "content_sanskrit": "तैस्तैरुपायैर्बहुभी रक्ष्यमाणः स पार्थिव।\nजयत्यभिमुखः शत्रून्पार्थः कृष्णेन पालितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2058105, "chapter_id": 2256, "verse_number": "७-१८३-१६", "content_sanskrit": "सविशेषं त्वमेयात्मा कृष्णो रक्षेन्न फल्गुनम्।\nहन्यात्क्षिप्रं हि कौन्तेयं शक्तिर्वृक्षमिवाशनिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2058106, "chapter_id": 2256, "verse_number": "७-१८३-१७x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2058107, "chapter_id": 2256, "verse_number": "७-१८३-१७", "content_sanskrit": "विरोधी च कुमन्त्री च प्राज्ञमानी ममात्मजः।\nयस्यैष समतिक्रान्तो वधोपायो जयं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2058108, "chapter_id": 2256, "verse_number": "७-१८३-१८", "content_sanskrit": "स वा कर्णो महाबुद्धिः सर्वशस्त्रभृतां वरः।\nन मुक्तवान्कथं सूत ताममोघां धनञ्जये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2058109, "chapter_id": 2256, "verse_number": "७-१८३-१९", "content_sanskrit": "तवापि समतिक्रान्तमेतद्गावल्गणे कथम्।\nएतमर्थं महाबुद्धे यत्त्वया नावबोधितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2058110, "chapter_id": 2256, "verse_number": "७-१८३-२०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2058111, "chapter_id": 2256, "verse_number": "७-१८३-२०", "content_sanskrit": "दुर्योधनस्य शकुनेर्मम दुःशासनस्य च।\nरात्रौ रात्रौ भवत्येषा नित्यमेव विकत्थना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2058112, "chapter_id": 2256, "verse_number": "७-१८३-२१", "content_sanskrit": "श्वः सर्वसैन्यानुत्सृज्य जहि कर्ण धनञ्जयम्।\nप्रेष्यवत्पाण्डुपाञ्चालानुपभोक्ष्यामहे ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2058113, "chapter_id": 2256, "verse_number": "७-१८३-२२", "content_sanskrit": "अथवा निहते पार्थं पाण्डवान्यतमं ततः।\nस्थापयेद्यदि वार्ष्णेयस्तस्मात्कृष्णो हि हन्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2058114, "chapter_id": 2256, "verse_number": "७-१८३-२३", "content_sanskrit": "कृष्णो हि मूलं पाण्डूनां पार्थः स्कन्ध इवोद्गतः।\nशाखा इवेतरे पार्थाः पाञ्चालाः पत्रसंज्ञिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2058115, "chapter_id": 2256, "verse_number": "७-१८३-२४", "content_sanskrit": "कृष्णाश्रयाः कृष्णबलाः कृष्णनाथाश्च पाण्डवाः।\nकृष्णः परायणं चैषां ज्योतिषामिव चन्द्रमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2058116, "chapter_id": 2256, "verse_number": "७-१८३-२५", "content_sanskrit": "तस्मात्पर्णानि शाखाश्च स्कन्धं चोत्सृज्य सूतज।\nकृष्णं हि विद्वि पाण्डूनां मूलं सर्वत्र सर्वदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2058117, "chapter_id": 2256, "verse_number": "७-१८३-२६", "content_sanskrit": "हन्याद्यदि हि दाशार्हं कर्णो यादवनन्दनम्।\nकृत्स्ना वसुमती राजन्वशे तस्य न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2058118, "chapter_id": 2256, "verse_number": "७-१८३-२७", "content_sanskrit": "यदि हि स निहतः शयीत भूमौ\nयदुकुलपाण्डवनन्दनो महात्मा।\nननु तव वसुधा नरेन्द्र सर्वा\nसगिरिसमुद्रवना वशं व्रजेत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2058119, "chapter_id": 2256, "verse_number": "७-१८३-२८", "content_sanskrit": "सा तु बुद्धिः कृताऽप्येवं जाग्रति त्रिदशेश्वरे।\nअप्रमेये हृषीकेशे युद्धकाले त्वमुह्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2058120, "chapter_id": 2256, "verse_number": "७-१८३-२९", "content_sanskrit": "अर्जुनं चापि राधेयात्सदा रक्षति केशवः।\nन ह्येनमैच्छत्प्रमुखे सौतेः स्थापयितुं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2058121, "chapter_id": 2256, "verse_number": "७-१८३-३०", "content_sanskrit": "अन्यांश्चास्मै रथोदारानुपास्थापयदच्युतः।\nअमोघां तां कथं शक्तिं मोघां कुर्यामिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2058122, "chapter_id": 2256, "verse_number": "७-१८३-३१", "content_sanskrit": "यश्चैवं रक्षते पार्थं कर्णात्कृष्णो महामनाः।\nआत्मानं स कथं राजन्न रक्षेत्पुरुपोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2058123, "chapter_id": 2256, "verse_number": "७-१८३-३२", "content_sanskrit": "परिचिन्त्य तु पश्यामि चक्रायुधमरिन्दमम्।\nन सोऽस्ति त्रिषु लोकेषु यो जयेत जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2058124, "chapter_id": 2256, "verse_number": "७-१८३-३३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2058125, "chapter_id": 2256, "verse_number": "७-१८३-३३", "content_sanskrit": "ततः कृष्णं महाबाहुं सात्यकिः सत्यविक्रमः।\nपप्रच्छ रथशार्दूलः कर्णं प्रति महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2058126, "chapter_id": 2256, "verse_number": "७-१८३-३४", "content_sanskrit": "अयं च प्रत्ययः कर्णे शक्तिश्चामितविक्रमा।\nकिमर्थं सूतपुत्रेण न मुक्ता फल्गुने तु सा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2058127, "chapter_id": 2256, "verse_number": "७-१८३-३५x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2058128, "chapter_id": 2256, "verse_number": "७-१८३-३५", "content_sanskrit": "दुःशासनश्च कर्णश्च शकुनिश्च मसैन्धवः।\nसततं मन्त्रयन्ति स्म दुर्योधनपुरोगमाः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2058129, "chapter_id": 2256, "verse_number": "७-१८३-३६", "content_sanskrit": "कर्णकर्ण महेष्वास रणेऽमितपराक्रम।\nनान्यस्य शक्तिरेषा ते मोक्तव्या जयतां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2058130, "chapter_id": 2256, "verse_number": "७-१८३-३७", "content_sanskrit": "ऋते महारथात्कर्ण कुन्तीपुत्राद्वनञ्जयात्।\nस हि तेषामतियशा देवानामिव वासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2058131, "chapter_id": 2256, "verse_number": "७-१८३-३८", "content_sanskrit": "तस्मिन्विनिहते पार्थे पाण्डवाः सृञ्जयैः सह।\nभविष्यन्ति गतात्मानः सुरा इव निरग्नयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2058132, "chapter_id": 2256, "verse_number": "७-१८३-३९", "content_sanskrit": "तथेति च प्रतिज्ञातं कर्णेन शिनिपुङ्गव।\nहृदि नित्यं च कर्णस्य वधो गाण्डीवधन्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2058133, "chapter_id": 2256, "verse_number": "७-१८३-४०", "content_sanskrit": "अहमेव तु राधेयं मोहयामि युधांवर।\nततो नावासृजच्छक्तिं पाण्डवे श्वेतवाहने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2058134, "chapter_id": 2256, "verse_number": "७-१८३-४१", "content_sanskrit": "फल्गुनस्य हि सा मृत्युरिति चिन्तयतोऽनिशम्।\nन निद्रा न च मे हार्षो मनसोऽस्ति युधांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2058135, "chapter_id": 2256, "verse_number": "७-१८३-४२", "content_sanskrit": "घटोत्कचे व्यंसितां तु दृष्ट्वा तां शिनिपुङ्गव।\nमृत्योरास्यान्तरान्मुक्तं पस्याम्यद्य धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2058136, "chapter_id": 2256, "verse_number": "७-१८३-४३", "content_sanskrit": "न पिता न च मे माता न यूयं भ्रातरस्तथा।\nन च प्राणास्तथा रक्ष्या यथा बीभत्सुराहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2058137, "chapter_id": 2256, "verse_number": "७-१८३-४४", "content_sanskrit": "त्रैलोक्यराज्याद्यत्किञ्चिद्भवेदन्यत्सुदुर्लभम्।\nनेच्छेयं सात्वताहं तद्विना पार्थं धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2058138, "chapter_id": 2256, "verse_number": "७-१८३-४५", "content_sanskrit": "अतः प्रहर्षः सुमहान्युयुधानाद्य मेऽभवत्।\nमृतं प्रत्यागतमिव दृष्ट्वा पार्थं धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2058139, "chapter_id": 2256, "verse_number": "७-१८३-४६", "content_sanskrit": "अतश्च प्रहितो युद्धे मया कर्णाय राक्षसः।\nन ह्यन्यः समरे रात्रौ शक्तः कर्णं प्रबाधितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2058140, "chapter_id": 2256, "verse_number": "७-१८३-४७x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2058141, "chapter_id": 2256, "verse_number": "७-१८३-४७", "content_sanskrit": "इति सात्यकये प्राह तदा देवकिनन्दनः।\nधनञ्जयहिते युक्तस्तत्प्रिये सततं रतः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2058142, "chapter_id": 2256, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि घटोत्कचवधपर्वणि चतुर्दशरात्रियुद्धे त्र्यशीत्यधिकशततमोऽध्यायः॥ १८३ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१८३-७ हियेत् हियेत॥ ५-१८३-११ एतत्प्रकृतशक्त्यार्जुनहननम्॥ ५-१८३-१७ सविशेषात्त्वमोघायाः कृष्णोऽरक्षत पाण्डवम इति झ. पाठः। एष कृत्स्नः जयम्प्रति अर्जुनस्येत्यर्थः॥ ५-१८३-३८ निरग्नयोऽग्निंविना मुखहीना इवेत्यर्थः॥ ५-१८३-४७ हिते आमुष्मिके श्रेयसि। प्रिये ऐहिके कल्याणे॥ ५-१८३-१८३ व्यशीत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]