[{"id": 2148854, "chapter_id": 4222, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148855, "chapter_id": 4222, "verse_number": "१", "content_sanskrit": "व्युषितायां रजन्यां तु राजा दुर्योधनस्ततः ।\nव्यभजत् तान्यनीकानि दश चैकं च भारत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148856, "chapter_id": 4222, "verse_number": "२", "content_sanskrit": "नरहस्तिरथाश्वानां सारं मध्यं च फल्गु च ।\nसर्वेष्वेतेष्वनीकेषु सन्दिदेश नराधिपः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148857, "chapter_id": 4222, "verse_number": "३", "content_sanskrit": "सानुकर्षाः सतूणीराः सवरूथाः सहर्ष्टयः ।\nसोपासङ्गाः सशक्तीकाः सनिषङ्गाः ससायकाः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148858, "chapter_id": 4222, "verse_number": "४", "content_sanskrit": "सध्वजाः सपताकाश्च सशरासनतोमराः ।\nरज्जुभिश्च विचित्राभिः सपाशाः सपरिच्छदाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148859, "chapter_id": 4222, "verse_number": "५", "content_sanskrit": "सकचग्रहविक्षेपाः सतैलगुडवालुकाः ।\nसाशीविषघटाः सर्वे ससर्जरसपांसवः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148860, "chapter_id": 4222, "verse_number": "६", "content_sanskrit": "सघण्टफलकाः सर्वे सायोगुडबलोपलाः ।\nकङ्कालभिण्डिपालाश्च समधूच्छिष्टमुद्गराः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148861, "chapter_id": 4222, "verse_number": "७", "content_sanskrit": "सकाण्डदण्डकाः सर्वे ससीरविषतोमराः ।\nसऋष्टिपिटकाः सर्वे सदात्राङ्कुशतोमराः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148862, "chapter_id": 4222, "verse_number": "८", "content_sanskrit": "सकीलक्रकचाः सर्वे वासीवृक्षादनान्विताः ।\nव्याघ्रचर्मपरीवारा वृता गोद्वीपिचर्मभिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148863, "chapter_id": 4222, "verse_number": "९", "content_sanskrit": "सवस्तयः सशृङ्गाश्च सप्रासविविधायुधाः ।\nसकुठाराः सकुद्दालाः सतैलक्षौद्रसर्पिषः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148864, "chapter_id": 4222, "verse_number": "१०", "content_sanskrit": "रुग्मजालप्रतिच्छन्ना नानामणिविभूषिताः ।\nचित्रानीका सुवपुषो ज्वलिता इव पावकाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148865, "chapter_id": 4222, "verse_number": "११", "content_sanskrit": "तथा कवचिनः शूराः शस्त्रेषु कृतनिश्रमाः ।\nकुलीना हययोनिज्ञाः सारथ्ये विनिवेशिताः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148866, "chapter_id": 4222, "verse_number": "१२", "content_sanskrit": "बद्धारिष्टा बद्धकक्ष्या बद्धध्वजपताकिनः ।\nबद्धाभरणनिर्यूहा बद्धवर्मासिपट्टसाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148867, "chapter_id": 4222, "verse_number": "१३", "content_sanskrit": "चतुर्युजो रथाः सर्वे सर्वे चोत्तमवाससः ।\nसंहृष्टवाहनाः सर्वे सर्वे शस्त्रसमायुताः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148868, "chapter_id": 4222, "verse_number": "१४", "content_sanskrit": "धुर्ययोर्हययोरेकः तथाऽन्यौ पार्ष्णिसारथी ।\nतौ चापि रथिनां श्रेष्ठौ रथी च हयवित् तथा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148869, "chapter_id": 4222, "verse_number": "१५", "content_sanskrit": "नगराणीव गुप्तानि दुराधर्षाणि शत्रुभिः ।\nआसन् रथसहस्राणि हेममालीनि सर्वशः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148870, "chapter_id": 4222, "verse_number": "१६", "content_sanskrit": "यथा रथास्तथा नागा बद्धकक्ष्याः स्वलङ्कृताः ।\nबभूवुः सप्तपुरुषा रत्नवन्त इवाद्रयः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148871, "chapter_id": 4222, "verse_number": "१७", "content_sanskrit": "द्वावङ्कुशधरौ तत्र द्वावुत्तमधनुर्धरौ ।\nद्वौ वरासिधरौ राजन्नेकश्छत्रपताकधृत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148872, "chapter_id": 4222, "verse_number": "१८", "content_sanskrit": "गजैर्मत्तैः समाकीर्णं सर्वमायुधकोशकैः ।\nतद् बभूव बलं राजन् कौरव्यस्य सहस्रशः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148873, "chapter_id": 4222, "verse_number": "१९", "content_sanskrit": "विचित्रकवचैर्युक्तैः सपताकैः स्वलङ्कृतैः ।\nसादिभिश्चोपपन्नास्तु आसन्नयुतशो हयाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148874, "chapter_id": 4222, "verse_number": "२०", "content_sanskrit": "सुसङ्ग्राहाः सुसन्तोषा हेमभाण्डपरिच्छदाः ।\nअनेकशतसाहस्राः सर्वे सादिवशे स्थिताः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148875, "chapter_id": 4222, "verse_number": "२१", "content_sanskrit": "नानारूपविकाराश्च नानाकवचशस्त्रिणः ।\nपदातिनो नरास्तत्र बभूवुर्हेममालिनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148876, "chapter_id": 4222, "verse_number": "२२", "content_sanskrit": "रथस्यासन् दश गजा गजस्य दश वाजिनः ।\nनरा दश हयस्यासन् पादरक्षाः समन्ततः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148877, "chapter_id": 4222, "verse_number": "२३", "content_sanskrit": "रथस्य नागाः पञ्चाशन्नागस्यासन् शतं हयाः ।\nहयस्य पुरुषाः सप्त भिन्नसन्धानकारिणः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148878, "chapter_id": 4222, "verse_number": "२४", "content_sanskrit": "पञ्चाशच्च शतञ्चाश्वा नराः पञ्चगुणास्ततः ।\nसेना पञ्चशतं नागा रथास्तावन्त एव च\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148879, "chapter_id": 4222, "verse_number": "२५", "content_sanskrit": "दश सेना च पृतना पृतना दश वाहिनी\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148880, "chapter_id": 4222, "verse_number": "२६", "content_sanskrit": "सेना तु वाहिनी चैव पृतना ध्वजिनी चमूः ।\nअक्षोहिणीति पर्यायैर्निरुक्ता च वरूथिनी\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148881, "chapter_id": 4222, "verse_number": "२७", "content_sanskrit": "एवं व्यूढान्यनीकानि कौरवेयेण धीमता\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148882, "chapter_id": 4222, "verse_number": "२८", "content_sanskrit": "अक्षोहिण्यस्तु सप्तैव पाण्डवानां महद् बलम् ।\nअक्षोहिण्यो दशैका च कौरवाणामभूद् बलम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2148883, "chapter_id": 4222, "verse_number": "२९", "content_sanskrit": "नराणां पञ्चपञ्चाशद् एषा पत्तिर्विधीयते ।\nसेनामुखं तु तिस्रस्ता गुल्म इत्यभिसञ्ज्ञिताः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2148884, "chapter_id": 4222, "verse_number": "३०", "content_sanskrit": "दश गुल्मा गणस्त्वासीद् गणास्त्वयुतशोऽभवन् ।\nदुर्योधनस्य सेनासु योत्स्यमानाः प्रहारिणः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148885, "chapter_id": 4222, "verse_number": "३१", "content_sanskrit": "तत्र दुर्योधनो राजा शूरान् बुद्धिमतो नरान् ।\nप्रसमीक्ष्य महाबाहुश्चक्रे सेनापतींस्तथा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2148886, "chapter_id": 4222, "verse_number": "३२", "content_sanskrit": "पृथगक्षोहिणीनां च प्रणेतॄन् नरसत्तमान् ।\nविधिवत् पूर्वमानीय पार्थिवानभ्यषेचयत्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2148887, "chapter_id": 4222, "verse_number": "३३", "content_sanskrit": "कृपं द्रोणं च शल्यं च सैन्धवं च जयद्रथम् ।\nसुदक्षिणं च काम्भोजं कृतवर्माणमेव च\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2148888, "chapter_id": 4222, "verse_number": "३४", "content_sanskrit": "द्रोणपुत्रं च कर्णं च भूरिश्रवसमेव च ।\nशकुनिं सौबलं चैव बाह्लीकं च महारथम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2148889, "chapter_id": 4222, "verse_number": "३५", "content_sanskrit": "दिवसे दिवसे तेषां प्रतिवेलं च भारत ।\nचक्रे स विविधाः सञ्ज्ञाः प्रत्यक्षं च पुनः पुनः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2148890, "chapter_id": 4222, "verse_number": "३६", "content_sanskrit": "तथैव नियताः सर्वे ये च तेषां पदानुगाः ।\nबभूवुः सैनिका राज्ञः प्रियं राजंश्चिकीर्षवः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2148891, "chapter_id": 4222, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि त्रिपञ्चाशोत्तरशततमोऽध्यायः ॥१५३॥ भीष्माभिषेचनपर्वणि प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]