[{"id": 2004634, "chapter_id": 1093, "verse_number": "१-९४-०x", "content_sanskrit": "दुष्यन्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2004635, "chapter_id": 1093, "verse_number": "१-९४-१", "content_sanskrit": "सुव्यक्तं राजपुत्री त्वं यथा कल्याणि भाषसे।\nभार्या मे भव सुश्रोणि ब्रूहि किं करवाणि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2004636, "chapter_id": 1093, "verse_number": "१-९४-२", "content_sanskrit": "सुवर्णमालां वासांसि कुण्डले परिहाटके।\nनानापत्तनजे शुभ्रे मणिरत्ने च शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2004637, "chapter_id": 1093, "verse_number": "१-९४-३", "content_sanskrit": "आहरामि तवाद्याहं निष्कादीन्यजिनानि च।\nसर्वं राज्यं तवाद्यास्तु भार्या मे भव शोभने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2004638, "chapter_id": 1093, "verse_number": "१-९४-४", "content_sanskrit": "गान्धर्वेण च मां भीरु विवाहेनैहि सुन्दरि।\nविवाहानां हि रम्भोरु गान्धर्वः श्रेष्ठ उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2004639, "chapter_id": 1093, "verse_number": "१-९४-५x", "content_sanskrit": "शकुन्तलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2004640, "chapter_id": 1093, "verse_number": "१-९४-५", "content_sanskrit": "फलाहारो गतो राजन्पिता मे इत आश्रमात्।\nमुहूर्तं संप्रतीक्षस्व स मां तुभ्यं प्रदास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2004641, "chapter_id": 1093, "verse_number": "१-९४-६", "content_sanskrit": "पिता हि मे प्रभुर्नित्यं दैवतं परमं मम।\nयस्मै मां दास्यति पिता स मे भर्ता भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2004642, "chapter_id": 1093, "verse_number": "१-९४-७", "content_sanskrit": "पिता रक्षति कौमारे भर्ता रक्षति यौवने।\nपुत्रस्तु स्थाविरे भावे न स्त्री स्वातन्त्र्यमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2004643, "chapter_id": 1093, "verse_number": "१-९४-८", "content_sanskrit": "समन्यमाना राजेन्द्र पितरं मे तपस्विनम्।\nअधर्मेण हि धर्मिष्ठ कथं वरमुपास्महे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2004644, "chapter_id": 1093, "verse_number": "१-९४-९x", "content_sanskrit": "दुष्यन्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2004645, "chapter_id": 1093, "verse_number": "१-९४-९", "content_sanskrit": "मामैवं वद कल्याणि तपोराशिं दमात्मकम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2004646, "chapter_id": 1093, "verse_number": "१-९४-९x", "content_sanskrit": "शकुन्तलोवाच।\nमन्युप्रहरणा विप्रा न विप्राः शस्त्रपाणयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2004647, "chapter_id": 1093, "verse_number": "१-९४-१०", "content_sanskrit": "मन्युना घ्नन्ति ते शत्रून्वज्रेणेन्द्र इवासुरान्।\nअग्निर्दहति तेजोभिः सूर्यो दहति रश्मिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2004648, "chapter_id": 1093, "verse_number": "१-९४-११", "content_sanskrit": "राजा दहति दण्डेन ब्राह्मणो मन्युना दहेत्।\nक्रोधिता मन्युना घ्नन्ति वज्रपाणिरिवासुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2004649, "chapter_id": 1093, "verse_number": "१-९४-१२x", "content_sanskrit": "दुष्यन्त उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2004650, "chapter_id": 1093, "verse_number": "१-९४-१२", "content_sanskrit": "जाने भद्रे महर्षिं तं तस्य मन्युर्न विद्यते।\nइच्छामि त्वां वरारोहे भजमानामनिन्दिते।\nत्वदर्थं मां स्थितं विद्धि त्वद्गतं हि मनो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2004651, "chapter_id": 1093, "verse_number": "१-९४-१३", "content_sanskrit": "आत्मनो बन्धुरात्मैव गतिरात्मैव चात्मनः।\nआत्मनैवात्मनो दानं कर्तुमर्हसि धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2004652, "chapter_id": 1093, "verse_number": "१-९४-१४", "content_sanskrit": "अष्टावेव समासेन विवाहा धर्मतः स्मृताः।\nब्राह्मो दैवस्तथैवार्षः प्राजापत्यस्तथाऽऽसुरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2004653, "chapter_id": 1093, "verse_number": "१-९४-१५", "content_sanskrit": "गान्धर्वो राक्षसश्चैव पैशाचश्चाष्टमः स्मृतः।\nतेषां धर्म्यान्यथापूर्वं मनुः स्वायंभुवोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2004654, "chapter_id": 1093, "verse_number": "१-९४-१६", "content_sanskrit": "प्रशस्तांश्चतुरः पूर्वान्ब्राह्मणस्योपधारय।\nषडानुपूर्व्या क्षत्रस्य विद्धि धर्म्याननिन्दिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2004655, "chapter_id": 1093, "verse_number": "१-९४-१७", "content_sanskrit": "राज्ञां तु राक्षसोऽप्युक्तो विट्शूद्रेष्वासुरः स्मृतः।\nपञ्चानां तु त्रयो धर्म्या अधर्म्यौ द्वौ स्मृताविह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2004656, "chapter_id": 1093, "verse_number": "१-९४-१८", "content_sanskrit": "पैशाच आसुरश्चैव न कर्तव्यौ कदाचन।\nअनेन विधिना कार्यो धर्मस्यैषा गतिः स्मृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2004657, "chapter_id": 1093, "verse_number": "१-९४-१९", "content_sanskrit": "गान्धर्वराक्षसौ क्षत्रे धर्म्यौ तौ मा विशङ्किथाः।\nपृथग्वा यदि वा मिश्रौ कर्तव्यौ नात्र संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2004658, "chapter_id": 1093, "verse_number": "१-९४-२०", "content_sanskrit": "सा त्वं मम सकामस्य सकामा वरवर्णिनी।\nगान्धर्वेण विवाहेन भार्या भवितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2004659, "chapter_id": 1093, "verse_number": "१-९४-२१x", "content_sanskrit": "शकुन्तलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2004660, "chapter_id": 1093, "verse_number": "१-९४-२१", "content_sanskrit": "यदि धर्मपथस्त्वेव यदि चात्मा प्रभुर्मम।\nप्रदाने पौरवश्रेष्ठ शृणु मे समयं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2004661, "chapter_id": 1093, "verse_number": "१-९४-२२", "content_sanskrit": "सत्यं मे प्रतिजानीहि यथा वक्ष्याम्यहं रहः।\nमयि जायेत यः पुत्रः स भवेत्त्वदनन्तरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2004662, "chapter_id": 1093, "verse_number": "१-९४-२३", "content_sanskrit": "युवराजो महाराज सत्यमेतद्ब्रवीमि ते।\nयद्येतदेवं दुष्यन्त अस्तु मे सङ्गमस्त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2004663, "chapter_id": 1093, "verse_number": "१-९४-२४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2004664, "chapter_id": 1093, "verse_number": "१-९४-२४", "content_sanskrit": "तस्यास्तु सर्वं संश्रुत्य यथोक्तं स विशांपतिः।\nदुष्यन्तः पुनरेवाह यद्यदिच्छसि तद्वद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2004665, "chapter_id": 1093, "verse_number": "१-९४-२५x", "content_sanskrit": "शकुन्तलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2004666, "chapter_id": 1093, "verse_number": "१-९४-२५", "content_sanskrit": "ख्यातो लोकप्रवादोयं विवाह इति शास्त्रतः।\nवैवाहिकीं क्रियां सन्तः प्रशंसन्ति प्रजाहिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2004667, "chapter_id": 1093, "verse_number": "१-९४-२६", "content_sanskrit": "लोकप्रवादशान्त्यर्थं विवाहं विधिना कुरु।\nसन्त्यत्र यज्ञपात्राणि दर्भाः सुमनसोऽक्षताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2004668, "chapter_id": 1093, "verse_number": "१-९४-२७", "content_sanskrit": "यथा युक्तो विवाहः स्यात्तथा युक्ता प्रजा भवेत्।\nतस्मादाज्यं हविर्लाजाः सिकता ब्राह्मणास्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2004669, "chapter_id": 1093, "verse_number": "१-९४-२८", "content_sanskrit": "वैवाहिकानि चान्यानि समस्तानीह पार्थिव।\nदुरुक्तमपि राजेन्द्र क्षन्तव्यं धर्मकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2004670, "chapter_id": 1093, "verse_number": "१-९४-२९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2004671, "chapter_id": 1093, "verse_number": "१-९४-२९", "content_sanskrit": "एवमस्त्विति तां राजा प्रत्युवाचाविचारयन्।\nअपि च त्वां हि नेष्यामि नगरं स्वं शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2004672, "chapter_id": 1093, "verse_number": "१-९४-३०", "content_sanskrit": "यथा त्वमर्हा सुश्रोणि मन्यसे तद्ब्रवीमि ते।\nएवमुक्त्वा स राजर्षिस्तामनिन्दितगामिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2004673, "chapter_id": 1093, "verse_number": "१-९४-३१", "content_sanskrit": "पुरोहितं समाहूय वचनं युक्तमब्रवीत्।\nराजपुत्र्या यदुक्तं वै न वृथा कर्तुमुत्सहे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2004674, "chapter_id": 1093, "verse_number": "१-९४-३२", "content_sanskrit": "क्रियाहीनो हि न भवेन्मम पुत्रो महाद्युतिः।\nतथा कुरुष्व शास्त्रोक्तं विवाहं मा चिरंकुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2004675, "chapter_id": 1093, "verse_number": "१-९४-३३", "content_sanskrit": "एवमुक्तो नृपतिना द्विजः परमयन्त्रितः।\nशोभनं राजराजेति विधिना कृतवान्द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2004676, "chapter_id": 1093, "verse_number": "१-९४-३४", "content_sanskrit": "शासनाद्विप्रमुख्यस्य कृतकौतुकमङ्गलः।\nजग्राह विधिवत्पाणावुवास च तया सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2004677, "chapter_id": 1093, "verse_number": "१-९४-३५", "content_sanskrit": "विश्वास्य चैनां स प्रायादब्रवीच्च पुनः पुनः।\nप्रेषयिष्ये तवार्थाय वाहिनीं चतुरङ्गिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2004678, "chapter_id": 1093, "verse_number": "१-९४-३६", "content_sanskrit": "त्रैविद्यवृद्धैः सहितां नानाराजजनैः सह।\nशिबिकासहस्रैः सहिता वयमायान्ति बान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2004679, "chapter_id": 1093, "verse_number": "१-९४-३७", "content_sanskrit": "मूकाश्चैव किराताश्च कुब्जा वामनकैः सह।\nसहिताः कञ्चुकिवरैर्वाहिनी सूतमागधैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2004680, "chapter_id": 1093, "verse_number": "१-९४-३८", "content_sanskrit": "शङ्खदुन्दुभिनिर्घोषैर्वनं च समुपैष्यति।\nतथा त्वामानयिष्यामि नगरं स्वं शुचिस्मिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2004681, "chapter_id": 1093, "verse_number": "१-९४-३९", "content_sanskrit": "अन्यथा त्वां न नेष्यामि स्वनिवेशमसत्कृताम्।\nसर्वमङ्गलसत्कारैः सुभ्रु सत्यं करोमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2004682, "chapter_id": 1093, "verse_number": "१-९४-४०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2004683, "chapter_id": 1093, "verse_number": "१-९४-४०", "content_sanskrit": "एवमुक्त्वा स राजर्षिस्तामनिन्दितगामिनीम्।\nपरिष्वज्य च बाहुभ्यां स्मितपूर्वमुदैक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2004684, "chapter_id": 1093, "verse_number": "१-९४-४१", "content_sanskrit": "प्रदक्षिणीकृतां देवीं पुनस्तां परिषस्वजे।\nशकुन्तला सा सुमुखी पपात नृपपादयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2004685, "chapter_id": 1093, "verse_number": "१-९४-४२", "content_sanskrit": "तां देवीं पुनरुत्थाप्य मा शुचेति पुनः पुनः।\nशपेयं सुकृतेनैव प्रापयिष्ये नृपात्मजे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2004686, "chapter_id": 1093, "verse_number": "१-९४-४३", "content_sanskrit": "इति तस्याः प्रतिश्रुत्य स नृपो जनमेजय।\nमनसा चिन्तयन्प्रायात्काश्यपं प्रति पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2004687, "chapter_id": 1093, "verse_number": "१-९४-४४", "content_sanskrit": "भगवांस्तपसा युक्तः श्रुत्वा किं नु करिष्यति।\nतं न प्रसाद्यागतोऽहं प्रसीदेति द्विजोत्तमम्।\nएवं संचिन्तयन्नेव प्रविवेश स्वकं पुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2004688, "chapter_id": 1093, "verse_number": "१-९४-४५", "content_sanskrit": "ततो मुहूर्ते याते तु कण्वोऽप्याश्रममागमत्।\nशकुन्तला च पितरं ह्रिया नोपजगाम तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2004689, "chapter_id": 1093, "verse_number": "१-९४-४६", "content_sanskrit": "शङ्कितेव च विप्रर्षिमुपचक्राम सा शनैः।\nततोऽस्य भारं जग्राह आसनं चाप्यकल्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2004690, "chapter_id": 1093, "verse_number": "१-९४-४७", "content_sanskrit": "प्राक्षालयच्च सा पादौ काश्यपस्य महात्मनः।\nन चैनं लज्जयाऽशक्नोदक्षिभ्यामभिवीक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2004691, "chapter_id": 1093, "verse_number": "१-९४-४८", "content_sanskrit": "शकुन्तला च सव्रीडा तमृषिं नाभ्यभाषत।\nतस्मात्स्वधर्मात्स्खलिता भीता सा भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2004692, "chapter_id": 1093, "verse_number": "१-९४-४९", "content_sanskrit": "अभवद्दोषदर्शित्वाद्ब्रह्मचारिण्ययन्त्रिता।\nस तदा व्रीडितां दृष्ट्वा ऋषिस्तां प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2004693, "chapter_id": 1093, "verse_number": "१-९५-५०x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2004694, "chapter_id": 1093, "verse_number": "१-९४-५०", "content_sanskrit": "सव्रीडैव च दीर्घायुः पुरेव भविता न च।\nवृत्तं कथय रम्भोरु मा त्रासं च प्रकल्पय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2004695, "chapter_id": 1093, "verse_number": "१-९४-५१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2004696, "chapter_id": 1093, "verse_number": "१-९४-५१", "content_sanskrit": "ततः प्रक्षाल्य पादौ सा विश्रान्तं पुनरब्रवीत्।\nनिधाय कामं तस्यर्षेः कन्दानि च फलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2004697, "chapter_id": 1093, "verse_number": "१-९४-५२", "content_sanskrit": "ततः संवाह्य पादौ सा विश्रान्तं वेदिमध्यमा।\nशकुन्तला पौरवाणां दुष्यन्तं जग्मुषी पतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2004698, "chapter_id": 1093, "verse_number": "१-९४-५३", "content_sanskrit": "ततः कृच्छ्रादतिशुभा सव्रीडा श्रमती तदा।\nसगद्गदमुवाचेदं काश्यपं सा शुचिस्मिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2004699, "chapter_id": 1093, "verse_number": "१-९४-५४x", "content_sanskrit": "शकुन्तलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2004700, "chapter_id": 1093, "verse_number": "१-९४-५४", "content_sanskrit": "राजा ताताजगामेह दुष्यन्त इलिलात्मजः।\nमया पतिर्वृतो योऽसौ दैवयोगादिहागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2004701, "chapter_id": 1093, "verse_number": "१-९४-५५", "content_sanskrit": "तस्य तात प्रसीद त्वं भर्ता मे सुमहायशाः।\nअतः सर्वं तु यद्वृत्तं दिव्यज्ञानेन पश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2004702, "chapter_id": 1093, "verse_number": "१-९४-५६", "content_sanskrit": "अभयं क्षत्रियकुले प्रसादं कर्तुमर्हसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2004703, "chapter_id": 1093, "verse_number": "१-९४-५६x", "content_sanskrit": "वैशम्पायन उवाच।\nचक्षुषा स तु दिव्येन सर्वं विज्ञाय काश्यपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2004704, "chapter_id": 1093, "verse_number": "१-९४-५७", "content_sanskrit": "ततो धर्मिष्ठतां मत्वा धर्मे चास्खलितं मनः।\nउवाच भगवान्प्रीतस्तद्वृत्तं सुमहातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2004705, "chapter_id": 1093, "verse_number": "१-९४-५८x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2004706, "chapter_id": 1093, "verse_number": "१-९४-५८", "content_sanskrit": "एवमेतन्मया ज्ञातं दृष्टं दिव्येन चक्षुषा।\nत्वयाऽद्य राजान्वयया मामनादृत्य यत्कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2004707, "chapter_id": 1093, "verse_number": "१-९४-५९", "content_sanskrit": "पुंसा सह समायोगो न स धर्मोपघातकः।\nन भयं विद्यते भद्रे मा शुचः सुकृतं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2004708, "chapter_id": 1093, "verse_number": "१-९४-६०", "content_sanskrit": "क्षत्रियस्य तु गान्धर्वो विवाहः श्रेष्ठ उच्यते।\nसकामायाः सकामेन निमन्त्रः श्रेष्ठ उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2004709, "chapter_id": 1093, "verse_number": "१-९४-६१", "content_sanskrit": "किं पुनर्विधिवत्कृत्वा सुप्रजस्त्वमवाप्स्यसि।\nधर्मात्मा च महात्मा च दुष्यन्तः पुरुषोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2004710, "chapter_id": 1093, "verse_number": "१-९४-६२", "content_sanskrit": "अभ्यागच्छत्पतिर्यस्त्वां भजमानां शकुन्तले।\nमहात्मा जनिता लोके पुत्रस्तव महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2004711, "chapter_id": 1093, "verse_number": "१-९४-६३", "content_sanskrit": "स च सर्वां समुद्रान्तां कृत्स्नां भोक्ष्यति मेदिनीम्।\nपरं चाभिप्रयातस्य चक्रं तस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2004712, "chapter_id": 1093, "verse_number": "१-९४-६४", "content_sanskrit": "भविष्यत्यप्रतिहतं सततं चक्रवर्तिनः।\nप्रसन्न एव तस्याहं त्वकृते वरवर्णिनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2004713, "chapter_id": 1093, "verse_number": "१-९४-६५", "content_sanskrit": "ऋतवो बहवस्ते वै गता व्यर्थाः शुचिस्मिते।\nसार्थकं सांप्रतं ह्येतन्न च पाप्मास्ति तेऽनघे।\nगृहाण च वरं मत्तस्तत्कृते यदभीप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2004714, "chapter_id": 1093, "verse_number": "१-९४-६६x", "content_sanskrit": "शकुन्तलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2004715, "chapter_id": 1093, "verse_number": "१-९४-६६", "content_sanskrit": "मया पतिर्वृतो योऽसौ दुष्यन्तः पुरुषोत्तमः।\nमम चैव पतिर्दृष्टो देवतानां समक्षतः।\nतस्मै ससचिवाय त्वं प्रसादं कर्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2004716, "chapter_id": 1093, "verse_number": "१-९४-६७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2004717, "chapter_id": 1093, "verse_number": "१-९४-६७", "content_sanskrit": "इत्येवमुक्त्वा मनसा प्रणिधाय मनस्विनी।\nततो धर्मिष्ठतां वव्रे राज्ये चास्खलनं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2004718, "chapter_id": 1093, "verse_number": "१-९४-६८", "content_sanskrit": "शकुन्तलां पौरवाणां दुष्यन्तहितकाम्यया।\nएवमस्त्विति तां प्राह कण्वो धर्मभृतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2004719, "chapter_id": 1093, "verse_number": "१-९४-६९", "content_sanskrit": "पस्पर्श चापि पाणिभ्यां सुतां श्रीमिवरूपिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2004720, "chapter_id": 1093, "verse_number": "१-९४-७०x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2004721, "chapter_id": 1093, "verse_number": "१-९४-७०", "content_sanskrit": "अद्यप्रभृति देवी त्वं दुष्यन्तस्य महात्मनः।\nपतिव्रतानां या वृत्तिस्तां वृत्तिमनुपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2004722, "chapter_id": 1093, "verse_number": "१-९४-७१x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2004723, "chapter_id": 1093, "verse_number": "१-९४-७१", "content_sanskrit": "इत्येवमुक्त्वा धर्मात्मा तां विशुद्ध्यर्थमस्पृशत्।\nस्पृष्टमात्रे शरीरे तु परं हर्षमवाप सा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2004724, "chapter_id": 1093, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि चतुर्नवतितमोऽध्यायः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]