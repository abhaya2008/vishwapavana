[{"id": 2024593, "chapter_id": 1525, "verse_number": "३-१६३-०x", "content_sanskrit": "धनद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024594, "chapter_id": 1525, "verse_number": "३-१६३-१", "content_sanskrit": "युधिष्ठिर धृतिर्दाक्ष्यं देशकालपराक्रमाः।\nलोकतन्त्रविधानानामेष पञ्चविधो विधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024595, "chapter_id": 1525, "verse_number": "३-१६३-२", "content_sanskrit": "धृतिमन्तश्च दक्षाश्च स्वे स्वे कर्मणि भारत।\nपराक्रमविधानज्ञा नराः कृतयुगेऽभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024596, "chapter_id": 1525, "verse_number": "३-१६३-३", "content_sanskrit": "धृतिमान्देशकालज्ञः सर्वधर्मविधानवित्।\nक्षत्रियः क्षत्रियश्रेष्ठ शास्ति वै पृथिवीमनु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024597, "chapter_id": 1525, "verse_number": "३-१६३-४", "content_sanskrit": "य एवं वर्तते पार्थ पुरुषः सर्वकर्मसु।\nस लोके लभते वीर यशः प्रेत्य च सद्गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024598, "chapter_id": 1525, "verse_number": "३-१६३-५", "content_sanskrit": "देशकालान्तरप्रेप्सुः कृत्वा शक्रः पराक्रमम्।\nसंप्राप्तस्त्रिदिवे राज्यं वृत्रहा वसुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024599, "chapter_id": 1525, "verse_number": "३-१६३-६", "content_sanskrit": "[यस्तु केवलसंरम्भात्प्रपातं न निरीक्षते।]\nपापात्मा पापबुद्धिर्यः पापमेवानुवर्तते।\nकर्मणामविभागज्ञः प्रेत्य चेह विनश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024600, "chapter_id": 1525, "verse_number": "३-१६३-७", "content_sanskrit": "अकालज्ञः सुदुर्मेधाः कार्याणामविशेषवित्।\nवृथाचारसमारम्भः प्रेत्य चेह विनश्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024601, "chapter_id": 1525, "verse_number": "३-१६३-८", "content_sanskrit": "साहसे वर्तमानानां निकृतीनां दुरात्मनाम्।\nसर्वेषामर्थलिप्सूनां पापो भवति निश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024602, "chapter_id": 1525, "verse_number": "३-१६३-९", "content_sanskrit": "अधर्मज्ञोऽवलिप्तश्च बालबुद्धिरमर्षणः।\nनिर्भयो भीमसेनोऽयं तं शाधि पुरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024603, "chapter_id": 1525, "verse_number": "३-१६३-१०", "content_sanskrit": "आर्ष्टिषेणस् राजर्षेः प्राप्य भूयस्त्वमाश्रमम्।\nतमिस्रां प्रथमां तत्र वीतशोकभयो वस ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024604, "chapter_id": 1525, "verse_number": "३-१६३-११", "content_sanskrit": "अलकां सह गन्धर्वैर्यक्षैश्च सह किन्नरैः।\n`गमिष्यामि महाबाहो त्वं चापि बदरीं व्रज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024605, "chapter_id": 1525, "verse_number": "३-१६३-१२", "content_sanskrit": "मन्नियुक्ता मनुष्येन्द्र सर्वे च गिरिवासिनः।\nरक्षन्तु त्वां महाबाहो सहितं द्विजसत्तमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024606, "chapter_id": 1525, "verse_number": "३-१६३-१३", "content_sanskrit": "साहसेषु च संतिष्ठंस्त्वया शैले वृकोदरः।\nवार्यतां साध्वयं राजंस्त्वया धर्मभृतांवर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024607, "chapter_id": 1525, "verse_number": "३-१६३-१४", "content_sanskrit": "इतः परं च वो राजन्द्रक्ष्यन्ति वनगोचराः।\nउपश्थास्यन्ति वो राजन्रक्षिष्यन्ते च वः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024608, "chapter_id": 1525, "verse_number": "३-१६३-१५", "content_sanskrit": "तथैव चान्नपानानि स्वादूनि च बबूनि च।\nआहरिष्यन्ति मत्प्रेष्याः सदा वः पुरुषर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024609, "chapter_id": 1525, "verse_number": "३-१६३-१६", "content_sanskrit": "यथा जिष्णुर्महेन्द्रस्य यथा वायोर्वृकोदरः।\nधर्मस्य त्वं यथा तात योगोत्पन्नो निजः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024610, "chapter_id": 1525, "verse_number": "३-१६३-१७", "content_sanskrit": "आत्मजावात्मसंपन्नौ यमौ चोभौ यथाश्विनोः।\nरक्ष्यास्तद्वन्ममापीह यूयं सर्वे युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024611, "chapter_id": 1525, "verse_number": "३-१६३-१८", "content_sanskrit": "अर्थतत्त्वविधानज्ञः सर्वधर्मविधानवित्।\nभीमसेनादवरजः पल्गुनः कुशली दिवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024612, "chapter_id": 1525, "verse_number": "३-१६३-१९", "content_sanskrit": "याः काश्चन मता लोके स्वर्ग्याः परमसंपदः।\nजनमप्रभृति ताः सर्वाः स्थितास्तात धनंजये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024613, "chapter_id": 1525, "verse_number": "३-१६३-२०", "content_sanskrit": "द्रमो दानं बलं बुद्धिर्ह्रीर्धृतिस्तेज उत्तमम्।\nएतान्यपि महासत्वे स्थितान्यमिततेजसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024614, "chapter_id": 1525, "verse_number": "३-१६३-२१", "content_sanskrit": "न मोहात्कुरुते जिष्णुः कर्म पाण्डव गर्हितम्।\nन पार्थस् मृषोक्तानि कथयन्ति नरा नृषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024615, "chapter_id": 1525, "verse_number": "३-१६३-२२", "content_sanskrit": "स देवपितृगन्धर्वैः कुरूणआं कीर्तिवर्धनः।\nआनीतः कुरुतेऽस्त्राणि शक्रसद्मनि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024616, "chapter_id": 1525, "verse_number": "३-१६३-२३", "content_sanskrit": "योऽसौ सर्वान्महीपालान्धर्मेण वशमानयत्।\nस शन्तनुर्महातेजाः पितुस्तव पितामहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2024617, "chapter_id": 1525, "verse_number": "३-१६३-२४", "content_sanskrit": "प्रीयते पार्थ पार्थेन दिवि गाण्डीवधन्वना।\nसम्यक्वासौ महावीर्यः कुलधुर्य इव स्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2024618, "chapter_id": 1525, "verse_number": "३-१६३-२५", "content_sanskrit": "पितॄन्देवानृषीन्विप्रान्पूजयित्वा महायशाः।\nसप्त मुख्यान्महामेधानाहरद्यमुनां प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2024619, "chapter_id": 1525, "verse_number": "३-१६३-२६", "content_sanskrit": "अधिराजः स राजंस्त्वां शन्तनुः प्रपितामहः।\nस्वर्गजिच्छक्रलोकस्थः कुशलं परिपृच्छति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2024620, "chapter_id": 1525, "verse_number": "३-१६३-२७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2024621, "chapter_id": 1525, "verse_number": "३-१६३-२७", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं धनदेन प्रभाषितम्।\nपाण्डवाश्च ततस्तेन बभूवः संप्रहर्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2024622, "chapter_id": 1525, "verse_number": "३-१६३-२८", "content_sanskrit": "ततः शक्तिं गदां खङ्गं धनुश्च भरतर्षभः।\nप्राध्वंकृत्वा नमश्चक्रे कुबेराय वृकोदरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2024623, "chapter_id": 1525, "verse_number": "३-१६३-२९", "content_sanskrit": "ततोऽब्रवीद्धनाध्यक्षः शरण्यः शरणागतम्।\nमानहा भव शत्रूणां सुहृदां नन्दिवर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2024624, "chapter_id": 1525, "verse_number": "३-१६३-३०", "content_sanskrit": "`विभयस्ताप शैलाग्रे वसानः सह बन्धुभिः।\nसुपर्णपितृदेवानां सततं मानकृद्भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2024625, "chapter_id": 1525, "verse_number": "३-१६३-३१", "content_sanskrit": "ऋजुं पश्यत मा वक्रं सत्यं वदत माऽनृतम्।\nदीर्घं पश्यत मा ह्रस्वं परं पश्यत माऽपरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2024626, "chapter_id": 1525, "verse_number": "३-१६३-३२", "content_sanskrit": "स्वेषु वेश्मसु रम्येषु वसतामित्रतापनाः।\nकामान्न परिहास्यन्ति यक्षा वोभरतर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2024627, "chapter_id": 1525, "verse_number": "३-१६३-३३", "content_sanskrit": "शीघ्रमेव गुडाकेशः कृतास्त्रः पुरुषर्षभः।\nसाक्षान्मघवतोत्सृष्टः संप्राप्स्यति धनंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2024628, "chapter_id": 1525, "verse_number": "३-१६३-३४", "content_sanskrit": "एवमुत्तमकर्माणमनुशिष्य युधिष्ठिरम्।\nअस्तं गिरिमिवादित्यः प्रययौ गुह्यकाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2024629, "chapter_id": 1525, "verse_number": "३-१६३-३५", "content_sanskrit": "तं परिस्तोमसंकीर्णैर्नानारत्नविभूषितैः।\nयानैरनुययुर्यक्षा राक्षसाश्च सहस्रशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2024630, "chapter_id": 1525, "verse_number": "३-१६३-३६", "content_sanskrit": "पक्षिणामिव कनिर्घोषः कुबेरसदनं प्रति।\nबभूव परमाश्वानामैरावतपथे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2024631, "chapter_id": 1525, "verse_number": "३-१६३-३७", "content_sanskrit": "ते जग्मुस्तूर्णमाकाशं धनाधिपतिवाजिनः।\nप्रकर्षन्त इवाभ्राणि पिबन्त इवमारुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2024632, "chapter_id": 1525, "verse_number": "३-१६३-३८", "content_sanskrit": "ततस्तानि शरीराणि गतसत्वानि रक्षसाम्।\nअपाकृष्यन्त शैलाग्राद्धनाधिपतिशासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2024633, "chapter_id": 1525, "verse_number": "३-१६३-३९", "content_sanskrit": "तेषां हि शापकालः स कृतोऽगस्त्येन धीमता।\nसमरे निहतास्तस्माच्छापस्यान्तोऽभवत्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2024634, "chapter_id": 1525, "verse_number": "३-१६३-४०", "content_sanskrit": "पाण्डवाश्महात्मानस्तेषु वेश्मसु तां क्षपाम्।\nसुखमूषुर्गतोद्वेगाः पूजिताः सह राक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2024635, "chapter_id": 1525, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि यक्षयुद्धपर्वणि त्रिषष्ट्यधिकशततमोऽध्यायः ॥ १६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]