[{"id": 2013222, "chapter_id": 1272, "verse_number": "२-१३-१", "content_sanskrit": "वैशम्पायन उवाच॥\nऋषेस्तद्वचनं श्रुत्वा निशश्वास युधिष्ठिरः।\nचिन्तयन्राजसूयेष्टिं न लेभे शर्म भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2013223, "chapter_id": 1272, "verse_number": "२-१३-२", "content_sanskrit": "राजर्षीणां च तं श्रुत्वा महिमानं महात्मनाम्।\nयज्वनां कर्मभिः पुण्यैर्लोकप्राप्तिं समीक्ष्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013224, "chapter_id": 1272, "verse_number": "२-१३-३", "content_sanskrit": "हरिश्चन्द्रं च राजर्षि रोजमानं विशेषतः।\nयज्वानं यज्ञमाहर्तुं राजसूयमियेष सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013225, "chapter_id": 1272, "verse_number": "२-१३-४", "content_sanskrit": "युधिष्ठिरस्ततः सर्वानर्चयित्वा सभासदः।\nप्रत्यर्चितश्च तैः सर्वैर्यज्ञायैव मनो दधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013226, "chapter_id": 1272, "verse_number": "२-१३-५", "content_sanskrit": "स राजसूयं राजेन्द्र कुरूणामृषभस्तदा।\nआहर्तुं प्रवणं चक्रे मनः सञ्चिन्त्य चासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013227, "chapter_id": 1272, "verse_number": "२-१३-६", "content_sanskrit": "भूयश्चाद्भुतवीर्यौजा धर्ममेवानुचिन्तयन्।\nकिं हितं सर्वलोकानां भवेदिति मनो दधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013228, "chapter_id": 1272, "verse_number": "२-१३-७", "content_sanskrit": "अनुगृह्णन्प्रजाः सर्वाः सर्वधर्मभृतां वरः।\nअविशेषेण सर्वेषां हितं चक्रे युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013229, "chapter_id": 1272, "verse_number": "२-१३-८", "content_sanskrit": "सर्वेषां दीयतां देयं मुष्णन्कोपमदावुभौ।\nसाधु धर्मेति धर्मेति नान्यच्छ्रूयेत भाषितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013230, "chapter_id": 1272, "verse_number": "२-१३-९", "content_sanskrit": "एवं गते ततस्तस्मिन्पितरीवाश्वसञ्जनाः।\nन तस्य विद्यते द्रेष्टा ततोऽस्याजातशत्रुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013231, "chapter_id": 1272, "verse_number": "२-१३-१०", "content_sanskrit": "परिग्रहान्नरेन्द्रस्य भीमस्य परिपालनात्।\nशत्रूणां क्षपणाच्चैव बीभत्सोः सव्यसाचिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013232, "chapter_id": 1272, "verse_number": "२-१३-११", "content_sanskrit": "बलीनां सम्यगुत्थानान्नकुलस्य यशस्विनः।\nधीमतः सहदेवस्य धर्माणामनुशासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013233, "chapter_id": 1272, "verse_number": "२-१३-१२", "content_sanskrit": "वैनत्यात्सर्वतश्चैव नकुलस्य स्वभावतः।\nअविग्रहा वीतभयाः स्वकर्मनिरताः सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013234, "chapter_id": 1272, "verse_number": "२-१३-१३", "content_sanskrit": "निकामवर्षाः स्फीताश्च आसञ्जनपदास्तथा।\nवार्धुषी यज्ञसत्वानि गोरक्षं कर्षणं वणिक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013235, "chapter_id": 1272, "verse_number": "२-१३-१४", "content_sanskrit": "विशेषात्सर्वमेवैतत्सञ्जज्ञे राजकर्मणा।\nअनुकर्षं च निष्कर्षं व्याधिपावकमूर्छनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013236, "chapter_id": 1272, "verse_number": "२-१३-१५", "content_sanskrit": "सर्वमेव न तत्रासीद्धर्मनित्ये युधिष्ठिरे।\nदस्युभ्यो वञ्चकेभ्यश्च राज्ञः प्रति परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013237, "chapter_id": 1272, "verse_number": "२-१३-१६", "content_sanskrit": "राजवल्लभतश्चैव नाश्रूयत मृषाकृतम्।\nप्रियं कर्तुमुपस्थातुं बलिकर्म स्वकर्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013238, "chapter_id": 1272, "verse_number": "२-१३-१७", "content_sanskrit": "अभिहर्तुं नृपाः षट्सु पृथक्जात्यैश्च नैगमैः।\nववृधे विषयस्तत्र धर्मनित्ये युधिष्ठिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013239, "chapter_id": 1272, "verse_number": "२-१३-१८", "content_sanskrit": "कामतोऽप्युपयुञ्जानै राजसैर्लोभजैर्जनैः।\nसर्वव्यापी सर्वगुणी सर्वसाहः स सर्वराट्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013240, "chapter_id": 1272, "verse_number": "२-१३-१९", "content_sanskrit": "यस्मिन्नधिकृतः सम्राड् भ्राजमानो महायशाः।\nयत्र राजन्दश दिशः पितृतो मातृतस्तथा।\nअनुरक्ताः प्रजा आसन्नागोपाला द्विजातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013241, "chapter_id": 1272, "verse_number": "२-१३-२०", "content_sanskrit": "स मन्त्रिणः समानाय्य भ्रातृंश्च वदतां वरः।\nराजसूयं प्रति तदा पुनः पुनरपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013242, "chapter_id": 1272, "verse_number": "२-१३-२१", "content_sanskrit": "ते पृच्छ्यमानाः सहिता वचोऽर्थ्यं मन्त्रिणस्तदा।\nयुधिष्ठिरं महाप्राज्ञं यियक्षुमिदमब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013243, "chapter_id": 1272, "verse_number": "२-१३-२२", "content_sanskrit": "येनाभिषिक्तो नृपतिर्वारुणं गुणमृच्छति।\nतेन राजाऽपि तं कुत्स्नं सम्राड्गुणमभीप्सृति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013244, "chapter_id": 1272, "verse_number": "२-१३-२३", "content_sanskrit": "तस्य सम्राड्गुणार्हस्य भवतः कुरुनन्दन।\nराजसूयस्य समयं मन्यन्ते सुहृदस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013245, "chapter_id": 1272, "verse_number": "२-१३-२४", "content_sanskrit": "तस्य यज्ञस्य समयः स्वाधीनः क्षत्रसम्पदा।\nसाम्ना षडग्नयो यस्मिंश्चीयन्ते शंसितव्रतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013246, "chapter_id": 1272, "verse_number": "२-१३-२५", "content_sanskrit": "दर्वीहोमानुपादाय सर्वान्यः प्राप्नुते क्रतून्।\nअभिषेकं च यज्ञान्ते सर्वजित्तेन चोच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013247, "chapter_id": 1272, "verse_number": "२-१३-२६", "content_sanskrit": "समर्थोऽसि महाबाहो सर्वे ते वशगा वयम्।\nअचिरात्त्वं महाराज राजसूयमवाप्स्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013248, "chapter_id": 1272, "verse_number": "२-१३-२७", "content_sanskrit": "अविचार्य महाराज राजसूये मनः कुरु।\nइत्येवं सुहृदः सर्वे पृथक्च सह चाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013249, "chapter_id": 1272, "verse_number": "२-१३-२८", "content_sanskrit": "स धर्म्यं पाण्डवस्तेषां वचः श्रुत्वा विशाम्पते।\nधृष्टमिष्टं वरिष्टं च जग्राह मनसाऽरिहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013250, "chapter_id": 1272, "verse_number": "२-१३-२९", "content_sanskrit": "श्रुत्वा सुहृद्वचस्तच्च जानंश्चाप्यात्मनः क्षमम्।\nस प्रशस्तक्रियारम्भः परीक्षामुपचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013251, "chapter_id": 1272, "verse_number": "२-१३-३०x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013252, "chapter_id": 1272, "verse_number": "२-१३-३०", "content_sanskrit": "चतुर्भिर्भीमसेनाद्यैर्भ्रातृभिः सहितो हितम्।\nएवमुक्तस्तथा पार्थो धर्म एव मनो दधे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013253, "chapter_id": 1272, "verse_number": "२-१३-३१", "content_sanskrit": "स राजसूयं राजेन्द्रः कुरूणामृषभः क्रतुम्।\nजगाम मनसा सद्य आहरिष्यन्युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013254, "chapter_id": 1272, "verse_number": "२-१३-३२", "content_sanskrit": "भूयस्त्वद्भुतवीर्योपि धर्ममेवानुपालयन् ।\nपुनः पुनर्मनो दध्रे राजसूयाय भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013255, "chapter_id": 1272, "verse_number": "२-१३-३३", "content_sanskrit": "स भ्रातृभिः पुनर्धीमानृत्विग्निश्च महात्मभिः।\nमन्त्रिभिश्चापि सहितो धर्मराजो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2013256, "chapter_id": 1272, "verse_number": "२-१३-३४", "content_sanskrit": "धौम्यद्वैपायनाद्यैश्च मन्त्रयामास मन्त्रवित्।\nविराटद्रुपदाभ्यां च सात्यकेन च धीमता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2013257, "chapter_id": 1272, "verse_number": "२-१३-३५", "content_sanskrit": "युधामन्यूत्तमौजोभ्यां सौभद्रेण च धीमता।\nद्रौपदेयैः परं शूरैर्मन्त्रयामास संवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2013258, "chapter_id": 1272, "verse_number": "२-१३-३६x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2013259, "chapter_id": 1272, "verse_number": "२-१३-३६", "content_sanskrit": "भवन्तो राजसूयस्य सम्राडर्हस्य सुक्रतोः।\nश्रद्दधानस्य वदत ममावाप्तिः कथं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2013260, "chapter_id": 1272, "verse_number": "२-१३-३७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2013261, "chapter_id": 1272, "verse_number": "२-१३-३७", "content_sanskrit": "एवमुक्तास्तु ते तेन राज्ञा राजीवलोचन।\nइदमूचुर्वचः काले धर्मराजं युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2013262, "chapter_id": 1272, "verse_number": "२-१३-३८", "content_sanskrit": "अर्हस्त्वमसि धर्मज्ञ राजसूयं महाक्रतुम्।\nअथैवमुक्ते नृपतावृत्विग्भिर्ऋषिभिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2013263, "chapter_id": 1272, "verse_number": "२-१३-३९", "content_sanskrit": "मन्त्रिणो भ्रातरश्चास्य तद्वचः प्रत्यपूजयन्।\nस तु राजा महाप्राज्ञः पुनरेवात्मनाऽऽत्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2013264, "chapter_id": 1272, "verse_number": "२-१३-४०", "content_sanskrit": "भूयो विममृशे पार्थो लोकानां हितकाम्यया।\nसामर्थ्ययोगं सम्प्रेक्ष्य देशकालौ व्ययागमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2013265, "chapter_id": 1272, "verse_number": "२-१३-४१", "content_sanskrit": "विमृश्य सम्यक् च धिया कुर्वन्प्राज्ञो न सीदति।\nनहि यज्ञसमारम्भः केवलात्मविनिश्चयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2013266, "chapter_id": 1272, "verse_number": "२-१३-४२", "content_sanskrit": "भवतीति समाज्ञाय यत्नतः कार्यमुद्वहन्।\nस निश्चयार्थं कार्यस्य कृष्णमेव जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2013267, "chapter_id": 1272, "verse_number": "२-१३-४३", "content_sanskrit": "सर्वलोकात्परं मत्वा जगाम मनसा हरिम्।\nअप्रमेयं महाबाहुं कामाञ्जातमजं नृषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2013268, "chapter_id": 1272, "verse_number": "२-१३-४४", "content_sanskrit": "पाण्डवस्तर्कयामास कर्मभिर्देवसंमतैः।\nनास्य किञ्चिदविज्ञातं नास्य किञ्चिदकर्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2013269, "chapter_id": 1272, "verse_number": "२-१३-४५", "content_sanskrit": "न स किञ्चिन्न विषहेदिति कृष्णममन्यत।\nस तु तां नैष्ठिकीं बुद्धिं कृत्वा पार्थो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2013270, "chapter_id": 1272, "verse_number": "२-१३-४६", "content_sanskrit": "गुरुवद्भूतगुरवे प्राहिणोद्दूतमञ्जसा।\nशीघ्रगेन रथेनाशु स दूतः प्राप्य यादवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2013271, "chapter_id": 1272, "verse_number": "२-१३-४७", "content_sanskrit": "द्वारकावासिनं कृष्णं द्वारवत्यां समासदत्।\nस प्रभुं प्राञ्जलिर्भूत्वा व्यज्ञापयत माधवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2013272, "chapter_id": 1272, "verse_number": "२-१३-४८x", "content_sanskrit": "दूत उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2013273, "chapter_id": 1272, "verse_number": "२-१३-४८", "content_sanskrit": "धर्मराजो हृषीकेश धौम्यव्यासादिभिः सह।\nपाञ्चालमात्स्यसहितैर्भ्रातृभिश्चैव सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2013274, "chapter_id": 1272, "verse_number": "२-१३-४९", "content_sanskrit": "त्वद्दर्शनं महाबाहो काङ्क्षते स युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2013275, "chapter_id": 1272, "verse_number": "२-१३-५०x", "content_sanskrit": "वैशम्पायन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2013276, "chapter_id": 1272, "verse_number": "२-१३-५०", "content_sanskrit": "इन्द्रसेनवचः श्रुत्वा यादवप्रवरो बली।\nदर्शनाकाङ्क्षिणं पार्थं दर्शनाकाङ्क्षयाच्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2013277, "chapter_id": 1272, "verse_number": "२-१३-५१", "content_sanskrit": "आमन्त्र्य राजन्सुहृदो वसुदेवं च माधवः।\nइन्द्रसेनेन सहित इन्द्रप्रस्थमगात्तदा।\nव्यतीत्य विविधान्देशांस्त्वरावान्क्षिप्रवाहनवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2013278, "chapter_id": 1272, "verse_number": "२-१३-५२", "content_sanskrit": "इन्द्रप्रस्थगतं पार्थमभ्यगच्छज्जनार्दनः।\nस गृहे पितृवद्धात्रा धर्मराजेन पूजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2013279, "chapter_id": 1272, "verse_number": "२-१३-५३", "content_sanskrit": "भीमेन च ततोऽपश्यत्स्वसारं प्रीतिमान्पितुः।\nप्रीतः प्रीतेन सुहृदा रेमे स सहितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2013280, "chapter_id": 1272, "verse_number": "२-१३-५४", "content_sanskrit": "अर्जुनेन यमाभ्यां च गुरुवत्पर्युपासितः।\nतं विश्रान्तं शुभे देशे क्षणिनं कल्पमच्युतम्।\nधर्मराजः समागम्य ज्ञापयत्स्वप्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2013281, "chapter_id": 1272, "verse_number": "२-१३-५x", "content_sanskrit": "युधिष्ठिर उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2013282, "chapter_id": 1272, "verse_number": "२-१३-५५", "content_sanskrit": "प्रार्थितो राजसूयो मे न चासौ केवलेप्सया।\nप्राप्यते येन तत्ते हि विदितं कृष्ण सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2013283, "chapter_id": 1272, "verse_number": "२-१३-५६", "content_sanskrit": "यस्मिन्सर्वं सम्भवति यश्च सर्वत्र पूज्यते।\nयश्च सर्वेश्वरो राजा राजसूयं स विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2013284, "chapter_id": 1272, "verse_number": "२-१३-५७", "content_sanskrit": "तं राजसूयं सुहृदः कार्यमाहुः समेत्य मे।\nतत्र मे निश्चिततमं तव कृष्ण गिरा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2013285, "chapter_id": 1272, "verse_number": "२-१३-५८", "content_sanskrit": "केचिद्धि सौहृदा देवे न दोषं परिचक्षते।\nस्वार्थहेतोस्तथैवान्ये प्रियमेव वदन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2013286, "chapter_id": 1272, "verse_number": "२-१३-५९", "content_sanskrit": "प्रियमेव परीप्सन्ते केचिदात्मनि यद्धितम्।\nएवम्प्रायाश्च दृश्यन्ते जनवादाः प्रयोजने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2013287, "chapter_id": 1272, "verse_number": "२-१३-६०", "content_sanskrit": "त्वं तु हेतूनतीत्यैतान्कामक्रोधौ व्युदस्य च।\nपरमं यत्क्षमं लोके यथावद्वक्तुमर्हसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2013288, "chapter_id": 1272, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि त्रयोदशोऽध्यायः॥ १३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]