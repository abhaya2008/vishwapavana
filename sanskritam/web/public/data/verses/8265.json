[{"id": 900002436, "chapter_id": 8265, "verse_number": "10.1", "content_sanskrit": "अथ यदिदमस्मिन् ब्रह्मपुरे दहरं पुण्डरीकं वेश्म ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900002437, "chapter_id": 8265, "verse_number": "10.2", "content_sanskrit": "तं चेद्ब्रूयुर्यदिदमस्मिन् ब्रह्मपुरे दहरं पुण्डरीकं वेश्म ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900002438, "chapter_id": 8265, "verse_number": "10.3", "content_sanskrit": "तं चेद्ब्रूयुरस्मिंश्चेदिदं ब्रह्मपुरे सर्वं समाहितं सर्वाणि च भूतानि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900002439, "chapter_id": 8265, "verse_number": "10.4", "content_sanskrit": "तद्यथेह कर्मजितो लोकः क्षीयत एवमेवामुत्र पुण्यजितो लोकः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900002440, "chapter_id": 8265, "verse_number": "10.5", "content_sanskrit": "स यदि पितृलोककामो भवति सङ्कल्पादेवास्य पितरः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900002441, "chapter_id": 8265, "verse_number": "10.6", "content_sanskrit": "त इमे सत्याः कामा अनृतापिधानास्तेषां सत्यानां ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900002442, "chapter_id": 8265, "verse_number": "10.7", "content_sanskrit": "अथ ये चास्येह जीवा ये च प्रेता यच्चान्यदिच्छन्न लभते सर्वं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900002443, "chapter_id": 8265, "verse_number": "10.8", "content_sanskrit": "अथ य एष सम्प्रसादोऽस्माच्छरीरात् समुत्थाय ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900002444, "chapter_id": 8265, "verse_number": "10.9", "content_sanskrit": "तानि ह वा एतानि त्रीण्यक्षराणि सत् ति यमिति तद्यत् सत् ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900002445, "chapter_id": 8265, "verse_number": "10.10", "content_sanskrit": "अथ य आत्मा स सेतुर्विधृतिरेषां लोकानामसम्भेदाय ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900002446, "chapter_id": 8265, "verse_number": "10.11", "content_sanskrit": "अथ यद्यज्ञ इत्याचक्षते ब्रह्मचर्यमेव तद्ब्रह्मचर्येण ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900002447, "chapter_id": 8265, "verse_number": "10.12", "content_sanskrit": "अथ या एता हृदयस्य नाड्यस्ताः पिङ्गलस्याणिम्नस्तिष्ठन्ति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900002448, "chapter_id": 8265, "verse_number": "10.13", "content_sanskrit": "तद्यथा महापथ आतत उभौ ग्रामौ गच्छतीमं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900002449, "chapter_id": 8265, "verse_number": "10.14", "content_sanskrit": "तद्यत्रैतत्सुप्तः समस्तः सम्प्रसन्नः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900002450, "chapter_id": 8265, "verse_number": "10.15", "content_sanskrit": "य आत्माऽपहतपाप्मा विजरो विमृत्युर्विशोकोऽविजिघत्सोऽपिपासः ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900002451, "chapter_id": 8265, "verse_number": "10.16", "content_sanskrit": "उदशराव आत्मानमवेक्ष्य यदात्मनो न विजानीथस्तन्मे प्रब्रूतमिति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900002452, "chapter_id": 8265, "verse_number": "10.17", "content_sanskrit": "अथ हेन्द्रोऽप्राप्यैव देवानेतद्भयं ददर्श ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900002453, "chapter_id": 8265, "verse_number": "10.18", "content_sanskrit": "य एष स्वप्ने महीयमानश्चरत्येष आत्मेति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900002454, "chapter_id": 8265, "verse_number": "10.19", "content_sanskrit": "तद्यत्रैतत्सुप्तः समस्तः सन् प्रसन्नः स्वप्नं न ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900002455, "chapter_id": 8265, "verse_number": "10.20", "content_sanskrit": "मघवन् मर्त्यं वाव इदं शरीरमात्तं मृत्युना ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900002456, "chapter_id": 8265, "verse_number": "10.21", "content_sanskrit": "अशरीरो वायुरभ्रं विद्युत्स्तनयित्नुरशरीराण्येतानि ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900002457, "chapter_id": 8265, "verse_number": "10.22", "content_sanskrit": "अथ यत्रैतदाकाशमनुविषण्णं चक्षुः स चाक्षुषः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900002458, "chapter_id": 8265, "verse_number": "10.23", "content_sanskrit": "उभौ लोकाववाप्नोतीति वचनान्न लोकायतिकमतं विरोचनोक्तम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900002459, "chapter_id": 8265, "verse_number": "10.24", "content_sanskrit": "नच विष्णोरत्र विवक्षितं प्रियम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900002460, "chapter_id": 8265, "verse_number": "10.25", "content_sanskrit": "स एष सम्प्रसादोsस्माच्छरीरात् समुत्थाय ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900002461, "chapter_id": 8265, "verse_number": "10.26", "content_sanskrit": "इदं ज्ञानमुपाश्रित्य मम साधर्म्यमागताः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900002462, "chapter_id": 8265, "verse_number": "10.27", "content_sanskrit": "नच जीवमात्रं देवा उपासते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900002463, "chapter_id": 8265, "verse_number": "10.28", "content_sanskrit": "भूतैर्महद्भिर्य इमाः पुरो विभुर्निर्माय शेते यदमूषु पूरुषः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900002464, "chapter_id": 8265, "verse_number": "10.29", "content_sanskrit": "इदं पश्यामि जिघ्राणीत्यपि जीवा न वै विदुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900002465, "chapter_id": 8265, "verse_number": "10.30", "content_sanskrit": "स्वप्ने महीमानश्चरति यत्रैतत्सुप्तः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900002466, "chapter_id": 8265, "verse_number": "10.31", "content_sanskrit": "श्यामाच्छबलं प्रपद्ये शबलाच्छयामं प्रपद्येऽश्व ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900002467, "chapter_id": 8265, "verse_number": "10.32", "content_sanskrit": "आकाशो वै नामरूपयोर्निर्वहिता ते यदन्तरा तद्ब्रह्म ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900002468, "chapter_id": 8265, "verse_number": "10.33", "content_sanskrit": "तद्धैतद्ब्रह्मा प्रजापतय उवाच प्रजापतिर्मनवे मनुः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]