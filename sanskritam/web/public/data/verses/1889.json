[{"id": 2040206, "chapter_id": 1889, "verse_number": "५-१३४-०x", "content_sanskrit": "विदुलोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2040207, "chapter_id": 1889, "verse_number": "५-१३४-१", "content_sanskrit": "अथैतस्यामवस्थायां पौरुषं हातुमिच्छसि।\nनिहीनसेवितं मार्गं गमिष्यस्यचिरादिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2040208, "chapter_id": 1889, "verse_number": "५-१३४-२", "content_sanskrit": "यो हि तेजो यथाशक्ति न कर्शयति विक्रमात्।\nक्षत्रियो जीविताकाङ्क्षी स्तेन इत्येव तं विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2040209, "chapter_id": 1889, "verse_number": "५-१३४-३", "content_sanskrit": "अर्थवन्त्युपपन्नानि वाक्यानि गुणवन्ति च।\nनैव संप्राप्नुवन्ति त्वां मुमूर्षुमिव भेषजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2040210, "chapter_id": 1889, "verse_number": "५-१३४-४", "content_sanskrit": "सन्ति वै सिन्धुराजस्य सन्तुष्टा न तथा जनाः।\nदौर्बल्यादासते मूढा व्यसतौघपतीक्षिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2040211, "chapter_id": 1889, "verse_number": "५-१३४-५", "content_sanskrit": "सहायोपचितिं कृत्वा व्यवसाय्य ततस्ततः ।\nअनुदुष्येयुरपरे पश्यन्तस्तव पौरुषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2040212, "chapter_id": 1889, "verse_number": "५-१३४-६", "content_sanskrit": "तैः कृत्वा सह संघातं गिरिदुर्गालयं चर ।\nकाले व्यसनमाकाङ्क्षन्नैवायमजरामरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2040213, "chapter_id": 1889, "verse_number": "५-१३४-७", "content_sanskrit": "सञ्जयो नामतश्च त्वं न च पश्यामि तत्त्वयि ।\nअन्वर्थनामा भव मे पुत्र मा व्यर्थनामकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2040214, "chapter_id": 1889, "verse_number": "५-१३४-८", "content_sanskrit": "सम्यग्दृष्टिर्महाप्राज्ञो बालं त्वां ब्राह्मणोऽब्रवीत्।\nअयं प्राप्य महत्कृच्छ्रं पुनर्वृद्धिं गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2040215, "chapter_id": 1889, "verse_number": "५-१३४-९", "content_sanskrit": "तस्य स्मरन्ती वचनमाशंसे विजयं तव।\nतस्मात्तात ब्रवीमि त्वां वक्ष्यामि च पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2040216, "chapter_id": 1889, "verse_number": "५-१३४-१०", "content_sanskrit": "यस्य ह्यर्थाभिनिर्वृत्तौ भवन्त्याप्यायिताः परे ।\nतस्यार्थसिद्धिर्नियता नयेष्वर्थानुसारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2040217, "chapter_id": 1889, "verse_number": "५-१३४-११", "content_sanskrit": "समृद्धिरसमृद्धिर्वा पूर्वेषां मम सञ्जय ।\nएवं विद्वान्युद्धमना भव मा प्रत्युपाहरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2040218, "chapter_id": 1889, "verse_number": "५-१३४-१२", "content_sanskrit": "नातः पापीयसीं कांचिदवस्थां शम्बरोऽब्रवीत्।\nयत्र नैवाद्य न प्रातर्भोजनं प्रतिदृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2040219, "chapter_id": 1889, "verse_number": "५-१३४-१३", "content_sanskrit": "पतिपुत्रवधादेतत्परमं दुःखमब्रवीत् ।\nदारिद्र्यमिति यत्प्रोक्तं पर्यायमरणं हि तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2040220, "chapter_id": 1889, "verse_number": "५-१३४-१४", "content_sanskrit": "अहं महाकुले जाता ह्रदाद्ध्रदमिवागता।\nईश्वरी सर्वकल्याणी भर्त्रा परमपूजिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2040221, "chapter_id": 1889, "verse_number": "५-१३४-१५", "content_sanskrit": "महार्हमाल्याभरणां सुमृष्टाम्बरवाससम् ।\nपुरा हृष्टः सुहृद्वर्गो मामपश्यत्सुहृद्गताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2040222, "chapter_id": 1889, "verse_number": "५-१३४-१६", "content_sanskrit": "यदा मां चैव भार्यां च द्रष्टासि भृशदुर्बलाम् ।\nन तदा जीवितेनार्थो भविता तव सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2040223, "chapter_id": 1889, "verse_number": "५-१३४-१७", "content_sanskrit": "दासकर्मकरान्भृत्यानाचार्यर्त्विक्पुरोहितान्।\nअवृत्त्याऽस्मान्प्रजहतो दृष्ट्वा किं जीवितेन ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2040224, "chapter_id": 1889, "verse_number": "५-१३४-१८", "content_sanskrit": "यदि कृत्यं न पश्यामि तवाद्याहं यथा पुरा ।\nश्लाघनीयं यशस्यं च का शान्तिर्हृदयस्य मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2040225, "chapter_id": 1889, "verse_number": "५-१३४-१९", "content_sanskrit": "नेति चेद्ब्राह्मणं ब्रूयां दीर्येत हृदयं मम।\nन ह्यद न च मे भर्ता नेति ब्राह्मणमुक्तवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2040226, "chapter_id": 1889, "verse_number": "५-१३४-२०", "content_sanskrit": "वयमाश्रयणीयाः स्म न श्रोतारः परस्य च।\nअन्यमासाद्य जीवन्ती परित्यक्ष्यामि जीवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2040227, "chapter_id": 1889, "verse_number": "५-१३४-२१", "content_sanskrit": "अपारे भव नः पारमप्लवे भव नः प्लवः ।\nकुरुष्व स्थानमस्थाने मृतान्सञ्जीवयस्व नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2040228, "chapter_id": 1889, "verse_number": "५-१३४-२२", "content_sanskrit": "सर्वे ते शत्रवः शक्या न चेञ्जीवितुमर्हसि ।\nअथ चेदीदृशीं वृत्तिं क्लीबामभ्युपपद्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2040229, "chapter_id": 1889, "verse_number": "५-१३४-२३", "content_sanskrit": "निर्विण्णात्मा हतमना मुञ्चैतां पापजीविकाम्।\nएकशत्रुवधेनैव शूरो गच्छति विश्रुतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2040230, "chapter_id": 1889, "verse_number": "५-१३४-२४", "content_sanskrit": "इन्द्रो वृत्रवधेनैव महेन्द्रः समपद्यत।\nमाहेन्द्रं च ग्रहं लेभे लोकानां चेश्वरोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2040231, "chapter_id": 1889, "verse_number": "५-१३४-२५", "content_sanskrit": "नाम विश्राव्य वै शङ्ख्ये शत्रूनाहूय दंशितान्।\nसेनाग्रं चापि विद्राव्य हत्वा वा पुरुषं वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2040232, "chapter_id": 1889, "verse_number": "५-१३४-२६", "content_sanskrit": "यदैव लभते वीरः सुयुद्धेन महद्यशः ।\nतदैव प्रव्यथन्तेऽस्य शत्रवो विनमन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2040233, "chapter_id": 1889, "verse_number": "५-१३४-२७", "content_sanskrit": "त्यक्त्वात्मानं रणे दक्षं शूरं कापुरुषा जनाः ।\nअवशास्तर्पयन्ति स्म सर्वकामसमृद्धिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2040234, "chapter_id": 1889, "verse_number": "५-१३४-२८", "content_sanskrit": "राज्यं चाप्युग्रवि भ्रंशं संशयो जीवितस्य वा।\nन लब्धस्य हि शत्रोर्वै शेषं कुर्वन्ति साधवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2040235, "chapter_id": 1889, "verse_number": "५-१३४-२९", "content_sanskrit": "स्वर्गद्वारोपमं राज्यमथवाप्यमृतोपमम् ।\nरुद्धमेकायनं मत्वा पतोल्मुक इवारिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2040236, "chapter_id": 1889, "verse_number": "५-१३४-३०", "content_sanskrit": "जहि शत्रून्रणे राजन्स्वधर्मनुपालय ।\nमा त्वा दृशं सुकृपणं शत्रूणां भयवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2040237, "chapter_id": 1889, "verse_number": "५-१३४-३१", "content_sanskrit": "अस्मदीयैश्च शोचिद्भिर्नदद्भिश्च परैर्वृतम् ।\nअपि त्वां नानुपश्येयं दीनाद्दीनमिवास्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2040238, "chapter_id": 1889, "verse_number": "५-१३४-३२", "content_sanskrit": "हृप्य सौवीरकन्याभिः श्लाघस्वार्थैर्यथा पुरा।\nमा च सैन्धवकन्यानामवसन्नो वशं गमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2040239, "chapter_id": 1889, "verse_number": "५-१३४-३३", "content_sanskrit": "युवा रूपेण संपन्नो विद्ययाभिजनेन च ।\nयत्त्वादृशो विकुर्वीत यशस्वी लोकविश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2040240, "chapter_id": 1889, "verse_number": "५-१३४-३४", "content_sanskrit": "अधुर्यवच्च वोढव्ये मन्ये मरणमेव तत्।\nयदि त्वामनुपश्यामि परस्य प्रियवादिनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2040241, "chapter_id": 1889, "verse_number": "५-१३४-३५", "content_sanskrit": "पृष्ठतोऽनुव्रजन्तं वा का शान्तिर्हृदयस्य मे।\nनास्मिञ्जातु कुले जातो गच्छेद्योन्यस्य पृष्ठतः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2040242, "chapter_id": 1889, "verse_number": "५-१३४-३६", "content_sanskrit": "न त्वं परस्यानुचरस्तात जीवितुमर्हसि ।\nअहं हि क्षत्रहृदयं वेद यत्परिशाश्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2040243, "chapter_id": 1889, "verse_number": "५-१३४-३७", "content_sanskrit": "पूर्वैः पूर्वतरैः प्रोक्तं परैः परतरैरपि।\nशाश्वतं चाव्ययं चैव प्रजापतिविनिर्मितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2040244, "chapter_id": 1889, "verse_number": "५-१३४-३८", "content_sanskrit": "यो वै कश्चिदिहाजातः क्षत्रियः क्षत्रधर्मवित् ।\nभयाद्वृत्तिसमीक्षो वा न नमेदिह कस्यचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2040245, "chapter_id": 1889, "verse_number": "५-१३४-३९", "content_sanskrit": "उद्यच्छेदेव न नमेदुद्यमो ह्येव पौरुषम् ।\nअप्यपर्वणि भज्येत न नमेतेह कस्यचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2040246, "chapter_id": 1889, "verse_number": "५-१३४-४०", "content_sanskrit": "मातङ्गो मत्त इव च परीयात्स महामनाः ।\nब्राह्मणेभ्यो नमेन्नित्यं धर्मायैव च सञ्जय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2040247, "chapter_id": 1889, "verse_number": "५-१३४-४१", "content_sanskrit": "नियच्छन्नितरान्वर्णान्विनिघ्नन्सर्वदुष्कृतः।\nससहायोऽसहायो वा यावज्जीवं तथा भवेत् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2040248, "chapter_id": 1889, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि चतुस्त्रिंशदधिकशततमोऽध्यायः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]