[{"id": 6000231000, "chapter_id": 10231, "verse_number": null, "content_sanskrit": "अथ पञ्चत्रिंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000231001, "chapter_id": 10231, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.001.m4a", "display_order": 2}, {"id": 6000231002, "chapter_id": 10231, "verse_number": "१०-३५-१", "content_sanskrit": "केशी तु कंसप्रहितः खुरैर्महीं महाहयो निर्दरयन् मनोजवः।\nसटावधूताभ्रविमानसङ्कुलं कुर्वन् नभो ह्रेषितभीषिताखिलः॥ १०/३५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णेन केशिनामकहयरूपासुरवधः", "range": "१–९"}]}, {"id": 6000231003, "chapter_id": 10231, "verse_number": "१०-३५-२", "content_sanskrit": "विशालनेत्रो विकटास्यकोटरो बृहद्गलो नीलमहाम्बुदोपमः।\nदुराशयः कंसहितं चिकीर्षुर्व्रजं स नन्दस्य जगाम कम्पयन्॥ १०/३५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.003.m4a", "display_order": 4}, {"id": 6000231004, "chapter_id": 10231, "verse_number": "१०-३५-३", "content_sanskrit": "तं त्रासयन्तं भगवान् स्वगोकुलं स्वह्रेषितैर्बालविघूर्णिताम्बुदम्।\nआत्मानमाजौ मृगयन्तमग्रणीरुपाह्वयन्स व्यनदन् मृगेन्द्रवत्॥ १०/३५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.004.m4a", "display_order": 5}, {"id": 6000231005, "chapter_id": 10231, "verse_number": "१०-३५-४", "content_sanskrit": "स तं निशम्याभिमुखो मुखेन खं पिबन्निवाभ्यद्रवदत्यमर्षणः।\nजघान पद्भ्यामरविन्दलोचनं दुरासदश्चण्डजवो दुरत्ययः॥ १०/३५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.005.m4a", "display_order": 6}, {"id": 6000231006, "chapter_id": 10231, "verse_number": "१०-३५-५", "content_sanskrit": "तद् वञ्चयित्वा तमधोक्षजो रुषा प्रगृह्य दोर्भ्यां परिविध्य पादयोः।\nसावज्ञमुत्सृज्य धनुःशतान्तरे यथोरगं तार्क्ष्यसुतो व्यवस्थितः॥ १०/३५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.006.m4a", "display_order": 7}, {"id": 6000231007, "chapter_id": 10231, "verse_number": "१०-३५-६", "content_sanskrit": "स लब्धसञ्ज्ञः पुनरुत्थितो मुखं व्यादाय केशी तरसाऽऽपतद् हरिम्।\nसोऽप्यस्य वक्त्रे भुजमुत्तरं स्मयन् प्रवेशयामास यथोरगं बिले॥ १०/३५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.007.m4a", "display_order": 8}, {"id": 6000231008, "chapter_id": 10231, "verse_number": "१०-३५-७", "content_sanskrit": "दन्ता निपेतुर्भगवद्भुजस्पृशस्ते केशिनस्तप्तमयःस्पृशो यथा।\nबाहुश्च तद्देहगतो महात्मनो यथाऽऽमयः संववृधे उपेक्षितः॥ १०/३५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.008.m4a", "display_order": 9}, {"id": 6000231009, "chapter_id": 10231, "verse_number": "१०-३५-८", "content_sanskrit": "समेधमानेन स कृष्णबाहुना निरुद्धवायुश्चरणांश्च विक्षिपन्।\nप्रस्विन्नगात्रः परिवृत्तलोचनः पपात लम्बं विसृजन् क्षितौ व्यसुः॥ १०/३५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.009.m4a", "display_order": 10}, {"id": 6000231010, "chapter_id": 10231, "verse_number": "१०-३५-९", "content_sanskrit": "तद्देहतः कर्कटिकाफलोपमाद् व्यसोरपाकृष्य भुजं महाभुजः।\nअविस्मितोऽयं निहतारिरुस्रियैः प्रसूनवर्षैर्ववृषद्भिरीडितः॥ १०/३५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.010.m4a", "display_order": 11}, {"id": 6000231011, "chapter_id": 10231, "verse_number": "१०-३५-१०", "content_sanskrit": "देवर्षिरुपसङ्गम्य भगवत्प्रवरो नृप।\nकृष्णमक्लिष्टकर्माणं रहसीदमभाषत॥ १०/३५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.011.m4a", "display_order": 12, "topics": [{"text": "नारदेन कृष्णेन करिष्यमाणकार्यैः तत्स्तुतिः", "range": "१०–२४"}]}, {"id": 6000231012, "chapter_id": 10231, "verse_number": "१०-३५-११", "content_sanskrit": "कृष्ण कृष्णाप्रमेयात्मन् योगेश जगदीश्वर।\nवासुदेवाखिलावास सात्वतां प्रवर प्रभो॥ १०/३५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.012.m4a", "display_order": 13}, {"id": 6000231013, "chapter_id": 10231, "verse_number": "१०-३५-१२", "content_sanskrit": "त्वमात्मा सर्वभूतानामेको ज्योतिरिवैधसाम्।\nगूढो गुहाशयः साक्षी महापुरुष ईश्वरः॥ १०/३५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.013.m4a", "display_order": 14}, {"id": 6000231014, "chapter_id": 10231, "verse_number": "१०-३५-१३", "content_sanskrit": "आत्मनाऽऽत्माश्रयः पूर्वं मायया सृजसे गुणान्।\nतैरिदं सत्यसङ्कल्पः सृजस्यत्स्यवसीश्वरः॥ १०/३५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.014.m4a", "display_order": 15}, {"id": 6000231015, "chapter_id": 10231, "verse_number": "१०-३५-१४", "content_sanskrit": "स त्वं भूभारभूतानां दैत्यप्रमथरक्षसाम्।\nअवतीर्णो विनाशाय साधूनां रक्षणाय च॥ १०/३५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.015.m4a", "display_order": 16}, {"id": 6000231016, "chapter_id": 10231, "verse_number": "१०-३५-१५", "content_sanskrit": "दिष्ट्या ते निहतो दैत्यो लीलयाऽयं हयाकृतिः।\nअस्य ह्रेषितसंत्रस्तास्त्यजन्त्यनिमिषा दिवम्॥ १०/३५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.016.m4a", "display_order": 17}, {"id": 6000231017, "chapter_id": 10231, "verse_number": "१०-३५-१६", "content_sanskrit": "चाणूरं मुष्टिकं चैव मल्लानन्यांश्च हस्तिपान्।\nकंसं च निहतं द्रक्ष्ये परश्वोऽहनि ते विभो॥ १०/३५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.017.m4a", "display_order": 18}, {"id": 6000231018, "chapter_id": 10231, "verse_number": "१०-३५-१७", "content_sanskrit": "तस्यानु शङ्खयवनमुराणां नरकस्य च।\nपारिजातस्य हरणमिन्द्रस्य च पराजयम्॥ १०/३५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.018.m4a", "display_order": 19}, {"id": 6000231019, "chapter_id": 10231, "verse_number": "१०-३५-१८", "content_sanskrit": "उद्वाहं वीरकन्यानां वीर्यशुल्कादिलक्षणम्।\nनृगस्य मोक्षणं पापाद् द्वारकायां जगत्पते॥ १०/३५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.019.m4a", "display_order": 20}, {"id": 6000231020, "chapter_id": 10231, "verse_number": "१०-३५-१९", "content_sanskrit": "स्यमन्तकस्य च मणेरादानं सह भार्यया।\nमृतपुत्रप्रदानं च ब्राह्मणस्य स्वधामतः॥ १०/३५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.020.m4a", "display_order": 21}, {"id": 6000231021, "chapter_id": 10231, "verse_number": "१०-३५-२०", "content_sanskrit": "पौण्ड्रकस्य वधं पश्चात् काशिपुर्याश्च दीपनम्।\nदन्तवक्रस्य निधनं चैद्यस्य च महाक्रतौ॥ १०/३५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.021.m4a", "display_order": 22}, {"id": 6000231022, "chapter_id": 10231, "verse_number": "१०-३५-२१", "content_sanskrit": "यानि चान्यानि वीर्याणि द्वारकामावसन् भवान्।\nकर्ता द्रक्ष्याम्यहं तानि गेयानि कविभिर्भुवि॥ १०/३५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.022.m4a", "display_order": 23}, {"id": 6000231023, "chapter_id": 10231, "verse_number": "१०-३५-२२", "content_sanskrit": "अथ ते कालरूपस्य क्षपयिष्णोरमुष्य वै।\nअक्षोहिणीनां निधनं द्रक्ष्याम्यर्जुनसारथेः॥ १०/३५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.023.m4a", "display_order": 24}, {"id": 6000231024, "chapter_id": 10231, "verse_number": "१०-३५-२३", "content_sanskrit": "विशुद्धविज्ञानघनं स्वसंस्थया समाप्तसर्वार्थममोघवर्तिनम्।\nस्वतेजसा नित्यनिवृत्तमायागुणप्रवाहं भगवन्तमीमहि॥ १०/३५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.024.m4a", "display_order": 25}, {"id": 6000231025, "chapter_id": 10231, "verse_number": "१०-३५-२४", "content_sanskrit": "त्वामीश्वरं स्वाश्रयमात्ममायया विनिर्मिताशेषविशेषकल्पनम्।\nक्रीडार्थमाद्यन्तमनुष्यविग्रहं नतोऽस्मि धुर्यं यदुवृष्णिसात्त्वताम्॥ १०/३५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.025.m4a", "display_order": 26}, {"id": 6000231026, "chapter_id": 10231, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.026.m4a", "display_order": 27}, {"id": 6000231027, "chapter_id": 10231, "verse_number": "१०-३५-२५", "content_sanskrit": "एवं यदुपतिं कृष्णं भगवतप्रवरो मुनिः।\nप्रणिपत्याभ्यनुज्ञातो ययौ तद्दर्शनोत्सवः॥ १०/३५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.027.m4a", "display_order": 28, "topics": [{"text": "निलायनक्रीडायां व्योमनाम्नोऽसुरस्य कृष्णेन वधः", "range": "२५–३४"}]}, {"id": 6000231028, "chapter_id": 10231, "verse_number": "१०-३५-२६", "content_sanskrit": "भगवानपि गोविन्दो हत्वा केशिनमाहवे।\nपशूनपालयत् पालैः प्रीतैर्व्रजसुखावहः॥ १०/३५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.028.m4a", "display_order": 29}, {"id": 6000231029, "chapter_id": 10231, "verse_number": "१०-३५-२७", "content_sanskrit": "एकदा ते पशून् पालाश्चारयन्तोऽद्रिसानुषु।\nचक्रुर्निलायनक्रीडां चोरपालापदेशतः॥ १०/३५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.029.m4a", "display_order": 30}, {"id": 6000231030, "chapter_id": 10231, "verse_number": "१०-३५-२८", "content_sanskrit": "तत्रासन् कतिचिच्चोराः पालाश्च कतिचिन्नृप।\nमेषायिताश्च तत्रैके विजह्रुरकुतोभयाः॥ १०/३५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.030.m4a", "display_order": 31}, {"id": 6000231031, "chapter_id": 10231, "verse_number": "१०-३५-२९", "content_sanskrit": "मयपुत्रो महामायो व्यामो गोपालरूपधृक्।\nमेषायितानपोवाह प्रायश्चोरायितो बहून्॥ १०/३५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.031.m4a", "display_order": 32}, {"id": 6000231032, "chapter_id": 10231, "verse_number": "१०-३५-३०", "content_sanskrit": "गिरिदर्यां विनिक्षिप्य नीतं नीतं महासुरः।\nशिलया पिदधे द्वारं चतुःपञ्चावशेषिताः॥ १०/३५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.032.m4a", "display_order": 33}, {"id": 6000231033, "chapter_id": 10231, "verse_number": "१०-३५-३१", "content_sanskrit": "तस्य तत् कर्म विज्ञाय कृष्णः शरणदः सताम्।\nगोपान् नयन्तं जग्राह वृकं हरिरिवौजसा॥ १०/३५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.033.m4a", "display_order": 34}, {"id": 6000231034, "chapter_id": 10231, "verse_number": "१०-३५-३२", "content_sanskrit": "स निजं रूपमास्थाय गिरीन्द्रसदृशं बली।\nइच्छन् विमोक्तुमात्मानं नाशक्नोद् ग्रहणातुरः॥ १०/३५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.034.m4a", "display_order": 35}, {"id": 6000231035, "chapter_id": 10231, "verse_number": "१०-३५-३३", "content_sanskrit": "तं निगृह्याच्युतो दोर्भ्यां पातयित्वा महीतले।\nपश्यतां दिवि देवानां पशुमारममारयत्॥ १०/३५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.035.m4a", "display_order": 36}, {"id": 6000231036, "chapter_id": 10231, "verse_number": "१०-३५-३४", "content_sanskrit": "गुहापिधानं निर्भिद्य गोपान् निस्सार्य कृच्छ्रतः।\nस्तूयमानः सुरैर्गोपैः प्रविवेश स्वगोकुलम्॥ १०/३५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_035/BhP_10.035.036.m4a", "display_order": 37}, {"id": 6000231037, "chapter_id": 10231, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे पञ्चत्रिंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]