[{"id": 7006264000, "chapter_id": 26264, "verse_number": "३-१८-१", "content_sanskrit": "अथ राजनायिका श्रिताज्वलिताङ्कुशा फणिसमानपाशभृत् ।\nकलनिक्वणद्वलयमैक्ष्वं धनुर्दधती प्रदीप्तकुसुमेषुपञ्चका ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006264001, "chapter_id": 26264, "verse_number": "३-१८-२", "content_sanskrit": "उदयत्सहत्स्रमहसा सहस्रतोऽप्यतिपाटलं निजवपुः प्रभाझरम् ।\nकिरती दिशासु वदनस्य कान्तिभिः सृजतीव चन्द्रमयमभ्रमण्डलम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006264002, "chapter_id": 26264, "verse_number": "३-१८-३", "content_sanskrit": "दशयोजनायतिमाता जगत्त्रयीमभिवृण्वता विशदमौक्तिकात्मना ।\nधवलातपत्रवलयेन भासुरा शशिमण्डलस्य सखितामुपेयुषा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006264003, "chapter_id": 26264, "verse_number": "३-१८-४", "content_sanskrit": "अभिवीजिता च मणिकान्तशोभिना विजयादिमुख्यपरिचारिकागणैः ।\nनवचन्द्रिकालहरिकान्तिकन्दलीचतुरेण चामरचतुष्टयेन च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006264004, "chapter_id": 26264, "verse_number": "३-१८-५", "content_sanskrit": "शक्त्यैकराज्यपदवीमभिसूचयन्ती साम्राज्यचिह्नशतमण्डितसैन्यदेशा ।\nसंगीतवाद्यरचनाभिरथामरीणां संस्तूयमानविभवा विशदप्रकाशा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006264005, "chapter_id": 26264, "verse_number": "३-१८-६", "content_sanskrit": "वाचामगोचरमगोचरमेव बुद्धेरीदृक्तया न कलनीयमनन्यतुल्यम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006264006, "chapter_id": 26264, "verse_number": "३-१८-७", "content_sanskrit": "त्रैलोक्यगर्भपरिपूरितशक्तिचक्रसाम्राज्यसंपदभिमानमभिस्पृशन्ती ।\nआबद्धभक्तिविपुलाञ्जलिशेखराणामारादहंप्रथमिका कृतसेवनानाम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006264007, "chapter_id": 26264, "verse_number": "३-१८-८", "content_sanskrit": "ब्रह्मेशविष्णुवृषमुख्यसुरोत्तमानां वक्त्राणिवर्षितनुतीनि कटाक्षयन्ती ।\nउद्दीप्तपुष्पशरपञ्चकतः समुत्थैज्योतिर्मयं त्रिभुवनं सहसा दधाना ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006264008, "chapter_id": 26264, "verse_number": "३-१८-९", "content_sanskrit": "विद्युत्समद्युतिभिरप्सरसां समूहैर्विक्षिप्यमाणजयमङ्गललाजवर्षा ।\nकामेश्वरीप्रभृतिभिः कमनीयभाभिः संग्रामवेषरचनासुमनोहराभिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006264009, "chapter_id": 26264, "verse_number": "३-१८-१०", "content_sanskrit": "दीप्तायुधद्युतितिरस्कृत भास्कराभिर्नित्याभिरङ्घ्रिसविधे समुपाक्यमाना ।\nश्रीचक्रनामतिलकं दशयोजनातितुङ्गध्वजोल्लिखितमेघकदंबमुच्चैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006264010, "chapter_id": 26264, "verse_number": "३-१८-११", "content_sanskrit": "तीव्राभिरावणसुशक्तिपरंपरभिर्युक्तं रथं समरकर्मणि चालयन्ती ।\nप्रोद्यत्पिशङ्गरुचिभागमलांशुकेन वीतामनोहररुचिस्समरे व्यभासीत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006264011, "chapter_id": 26264, "verse_number": "३-१८-१२", "content_sanskrit": "पञ्चाधिकैर्विशतिनामरत्नैः प्रपञ्चपापप्रशमातिदक्षैः ।\nसंस्तूयमाना ललिता मरुद्भिः संग्राममुद्दिश्य समुच्चचाल ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006264012, "chapter_id": 26264, "verse_number": "३-१८-१३", "content_sanskrit": "अगस्त्य उवाच वीजिवक्त्र महाबुद्धे पञ्चविंशतिनामभिः ।\nललितापरमेशान्या देहि कर्णरसायनम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006264013, "chapter_id": 26264, "verse_number": "३-१८-१४", "content_sanskrit": "हयग्रीव उवाच सिंहासना श्रीललिता महाराज्ञी पराङ्कुशा ।\nचापिनी त्रिपुरा चैव महात्रिपुरसुन्दरी ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006264014, "chapter_id": 26264, "verse_number": "३-१८-१५", "content_sanskrit": "सुन्दरी चक्रनाथा च साम्राजी चक्रिणी तथा ।\nचक्रेश्वरी महादेवी कामेशी परमेश्वरी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006264015, "chapter_id": 26264, "verse_number": "३-१८-१६", "content_sanskrit": "कामराजप्रिया कामकोटिगा चक्रवर्तिनी ।\nमहाविद्या शिवानङ्गवल्लभा सर्वपाटला ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006264016, "chapter_id": 26264, "verse_number": "३-१८-१७", "content_sanskrit": "कुलनाथाम्नायनाथा सर्वाम्नायनिवासिनी ।\nशृङ्गारनायिका चेति पञ्चविंशतिनामभिः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006264017, "chapter_id": 26264, "verse_number": "३-१८-१८", "content_sanskrit": "स्तुवन्ति ये महाभागां ललितां परमेश्वरीम् ।\nते प्राप्नुवन्ति सौभाग्यमष्टौ सिद्धीर्महद्यशः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006264018, "chapter_id": 26264, "verse_number": "३-१८-१९", "content_sanskrit": "इत्थं प्रचण्डसंरंभं चालयन्ती महद्बलम् ।\nभण्डासुरं प्रति क्रुद्धा चचाल ललितांबिका ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]