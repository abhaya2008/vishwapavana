[{"id": 7000877000, "chapter_id": 20877, "verse_number": "६-२२०-१", "content_sanskrit": "नारद उवाच ।\nशिवस्यतीर्थराजस्य प्रयागस्य तवाग्रतः ।\nमहिमानं महापुण्यं श्रद्धया वर्णयामि ते ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000877001, "chapter_id": 20877, "verse_number": "६-२२०-२", "content_sanskrit": "विश्वावसुर्महीपाल गंधर्वो लोकविश्रुतः ।\nएकदा स गतो गातुं सुमेरौ ब्रह्मणः सभाम् ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000877002, "chapter_id": 20877, "verse_number": "६-२२०-३", "content_sanskrit": "तत्र सर्वैः सुरश्रेष्ठमुपविष्टं सुविष्टरे ।\nजुष्टं सुरगणैर्भूप विश्वावसुरवैक्षत ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000877003, "chapter_id": 20877, "verse_number": "६-२२०-४", "content_sanskrit": "ब्रह्मासनसमीपे तु वरासनगतं नृप ।\nद्वितीयमिव लोकेशमिंद्रप्रस्थं स एक्षत ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000877004, "chapter_id": 20877, "verse_number": "६-२२०-५", "content_sanskrit": "सुरराजतीर्थराजौ ब्रह्मेंद्रप्रस्थयोर्नृप ।\nचामरोद्धूननं मूर्ध्नि कुर्वंतौ स ददर्श ह ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000877005, "chapter_id": 20877, "verse_number": "६-२२०-६", "content_sanskrit": "अन्यानि देवतीर्थानि तयोर्दूरे महीपते ।\nस्थितानि तेन दृष्टानि बद्धांजलिपुटानि तु ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000877006, "chapter_id": 20877, "verse_number": "६-२२०-७", "content_sanskrit": "तयोरग्रे जगौ राजन्गांधर्वं रागमुत्तमम् ।\nतीर्थैः सममगात्सत्यलोकं देवान्विसृज्य हि ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000877007, "chapter_id": 20877, "verse_number": "६-२२०-८", "content_sanskrit": "अथ विश्वावसुर्द्धीमान्दृष्ट्वा तीर्थस्य वैभवम् ।\nइंद्रप्रस्थस्य राजेंद्र हाहामेतदुवाच ह ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000877008, "chapter_id": 20877, "verse_number": "६-२२०-९", "content_sanskrit": "विश्वावसुरुवाच ।\nभोभो गंधर्वशार्दूल तीर्थमेतन्महाद्भुतम् ।\nइंद्रप्रस्थाख्यमेतस्मिन्संसारे तीर्थराशिषु ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000877009, "chapter_id": 20877, "verse_number": "६-२२०-१०", "content_sanskrit": "चराचरगुरुर्ब्रह्मा सुरवंद्य पदांबुजः ।\nतस्यासनसमीपस्थं यदतिष्ठ समासनम् ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000877010, "chapter_id": 20877, "verse_number": "६-२२०-११", "content_sanskrit": "तीर्थराजोऽपि पृष्ठस्थश्चामरं यस्य मस्तके ।\nअधुना भृत्यवज्जातस्तीर्थेष्वन्येषु का कथा ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000877011, "chapter_id": 20877, "verse_number": "६-२२०-१२", "content_sanskrit": "पृथिव्यां यानि तीर्थानि त्रिवर्गफलदानि तु ।\nइंद्रप्रस्थमिदं तीर्थं चतुर्वर्गफलप्रदम् ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000877012, "chapter_id": 20877, "verse_number": "६-२२०-१३", "content_sanskrit": "अत्र स्थितानि तीर्थानि तादृशानि गुणैर्ध्रुवः ।\nशेषेनापि न शक्यंते स्तोतुं तेषां महागुणाः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000877013, "chapter_id": 20877, "verse_number": "६-२२०-१४", "content_sanskrit": "नारद उवाच ।\nएवं विश्वावसुर्धीमान्दृष्ट्वेंद्रप्रस्थवैभवम् ।\nगत्वा तस्य गृहं राजन्पावनं सर्वकामदम् ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000877014, "chapter_id": 20877, "verse_number": "६-२२०-१५", "content_sanskrit": "यथा देवेषु सर्वेषु शक्रः श्रेष्ठः शचीपतिः ।\nतस्माद्ब्रह्मा च तीर्थेषु प्रयागोऽयं तथा वरः ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000877015, "chapter_id": 20877, "verse_number": "६-२२०-१६", "content_sanskrit": "तस्मादपि महाराज शक्रप्रस्थमिदं वरम् ।\nअस्यांतरगतो योऽयं प्रयागो नृप दृश्यते ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000877016, "chapter_id": 20877, "verse_number": "६-२२०-१७", "content_sanskrit": "कथयाम्यत्र यद्वृत्तं मोहिन्याः पण्ययोषितः ।\nनर्मदासरितस्तीरे पुरी माहिष्मती नृप ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000877017, "chapter_id": 20877, "verse_number": "६-२२०-१८", "content_sanskrit": "मोहिनीनाम तत्रासीद्वेश्या बहुधनान्विता ।\nरूपयौवनसंपन्ना निष्णाता नृत्यगीतयोः ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000877018, "chapter_id": 20877, "verse_number": "६-२२०-१९", "content_sanskrit": "तया बहूनि पापानि कृतानि धनलुब्धया ।\nब्रह्महत्याः कृताः सप्त दास्यश्च बहवो हताः ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000877019, "chapter_id": 20877, "verse_number": "६-२२०-२०", "content_sanskrit": "तासां च पातिता गर्भाः बहुशः पापया तया ।\nएवं तया सुतारुण्यं गमितं पापकर्मभिः ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000877020, "chapter_id": 20877, "verse_number": "६-२२०-२१", "content_sanskrit": "ततो जरा कियत्काले तद्देहे समपद्यत ।\nजराग्रस्तशरीरा सा निवृत्तविषयस्पृहा ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000877021, "chapter_id": 20877, "verse_number": "६-२२०-२२", "content_sanskrit": "न चक्रे मानसं यूनां ते च तां पतिभूपते ।\nपापार्जितं धनं स्वीयं न विश्वसिति कस्यचित् ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000877022, "chapter_id": 20877, "verse_number": "६-२२०-२३", "content_sanskrit": "न दत्ते न स्वयं भुंक्ते न निक्षिपति वै क्वचित् ।\nएकदा सा निशीथे तु विबुध्येति विचिंतयत् ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000877023, "chapter_id": 20877, "verse_number": "६-२२०-२४", "content_sanskrit": "मृतायां मयि कस्येदं धनं पापैरुपार्जितम् ।\nतं नयिष्यति मां घोरं नरकं भृशदारुणम् ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000877024, "chapter_id": 20877, "verse_number": "६-२२०-२५", "content_sanskrit": "दास्यस्तासां च भर्त्तारस्तद्भोक्ष्यंति धनं मम ।\nमयैव सद्गतिस्तस्य कथं न क्रियतेऽधुना ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000877025, "chapter_id": 20877, "verse_number": "६-२२०-२६", "content_sanskrit": "एवं विचिंत्य सा धर्मे विधाय मतिमुत्तमाम् ।\nचकारारामसरसि वापीकूपसुरालयान् ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000877026, "chapter_id": 20877, "verse_number": "६-२२०-२७", "content_sanskrit": "अभितः पुरमाधत्ते प्रपाः पथिकहेतवे ।\nनिदाघे च महाराज तेभ्योऽन्नं प्रददौ च सा ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000877027, "chapter_id": 20877, "verse_number": "६-२२०-२८", "content_sanskrit": "धर्मशालां गृहाभ्याशे निवासाय विदेशिनाम् ।\nविदधे सा पुनस्तेभ्यो ददावाहारमुत्तमम् ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000877028, "chapter_id": 20877, "verse_number": "६-२२०-२९", "content_sanskrit": "एवं प्रवर्त्तमाना हि धर्मे सा भूपमोहिनी ।\nज्वरातुराभवत्काले क्वचिच्चेति विचिंतयत् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000877029, "chapter_id": 20877, "verse_number": "६-२२०-३०", "content_sanskrit": "धर्मार्थे हि मया वित्तं व्ययितं भूरि यद्यपि ।\nतथापि स्वर्णरूप्यादि प्रचुरं वर्त्तते परम् ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000877030, "chapter_id": 20877, "verse_number": "६-२२०-३१", "content_sanskrit": "श्रोत्रियेभ्यो ददाम्येतज्ज्ञानेनेति व्यचिंतयत् ।\nविचिंत्येति समाहूता मोहिन्या नगरद्विजाः ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000877031, "chapter_id": 20877, "verse_number": "६-२२०-३२", "content_sanskrit": "नागतास्ते महीपाल ज्ञात्वा घोरं प्रतिग्रहम् ।\nयदा तदा द्विभागं च चक्रे तत्तु धनं स्वकम् ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000877032, "chapter_id": 20877, "verse_number": "६-२२०-३३", "content_sanskrit": "एको भागस्तु दासीनां दत्तोन्यश्च विदेशिनाम् ।\nस्वयं तु निर्द्धना राजन्नभवत्सा तु मोहिनी ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000877033, "chapter_id": 20877, "verse_number": "६-२२०-३४", "content_sanskrit": "तथा समागतं मृत्युं विज्ञायांतिकमंतिके ।\nमुक्त्वा दास्यो धनं नीत्वा यथेष्टगतयोऽभवत् ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000877034, "chapter_id": 20877, "verse_number": "६-२२०-३५", "content_sanskrit": "इति मत्वा यदा ह्येषा ज्वरमुक्ता भविष्यति ।\nतदानीं यद्धनं दत्तं नूनमादास्यते हि तत् ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000877035, "chapter_id": 20877, "verse_number": "६-२२०-३६", "content_sanskrit": "अथ सा लंघनान्यष्टादशकृत्वा महीपते ।\nनिजायुषस्तु शेषेण ज्वरमुक्ता तदाभवत् ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000877036, "chapter_id": 20877, "verse_number": "६-२२०-३७", "content_sanskrit": "एका जरद्गवानाम सखी तस्या महीपते ।\nसा तामुपचचाराशु पथ्यादिभिरतंद्रिता ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000877037, "chapter_id": 20877, "verse_number": "६-२२०-३८", "content_sanskrit": "कियद्भिर्वासरैः सा तु पूर्णाहारा व्यजायत ।\nतस्या जरद्गवायास्तु गृहे भुक्तं स्म लज्जया ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000877038, "chapter_id": 20877, "verse_number": "६-२२०-३९", "content_sanskrit": "मया स्थितं सुखेनात्र दुःखमद्य समागतम् ।\nदारिद्र्यान्न मया स्थेयं सचिंत्येति गतान्यतः ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000877039, "chapter_id": 20877, "verse_number": "६-२२०-४०", "content_sanskrit": "गच्छती सा वने राजन्मोहिनी पुरतस्करैः ।\nइति मत्वा विनिहता गृहीत्वा यात्यसौ धनम् ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000877040, "chapter_id": 20877, "verse_number": "६-२२०-४१", "content_sanskrit": "धनमप्राप्य तैस्तस्याः सकाशात्पुरतस्करैः ।\nश्वसती सा परित्यक्ता तस्मिन्नेव वने नृप ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000877041, "chapter_id": 20877, "verse_number": "६-२२०-४२", "content_sanskrit": "अथ वैखानसः कश्चित्प्रयागस्यास्य वै जलम् ।\nबिभ्रत्कमंडलौ राजन्नत्रारण्ये समाययौ ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000877042, "chapter_id": 20877, "verse_number": "६-२२०-४३", "content_sanskrit": "अथ तां पतितां वीक्ष्य शस्त्रविक्षतविग्रहाम् ।\nयाचमानामिदं राजन् जीवनं हस्तसंज्ञया ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000877043, "chapter_id": 20877, "verse_number": "६-२२०-४४", "content_sanskrit": "वैखानस उवाच ।\nका त्वं केन शितैः शस्त्रैः सक्षतीकृतविग्रहा ।\nएकाकिनी किमर्थं वा निर्जनारण्यमागता ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000877044, "chapter_id": 20877, "verse_number": "६-२२०-४५", "content_sanskrit": "इंद्रप्रस्थगतस्येदं प्रयागस्य जले शुभे ।\nभाग्योदयेन केनापि प्रापितं प्रियकाम्यया ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000877045, "chapter_id": 20877, "verse_number": "६-२२०-४६", "content_sanskrit": "इत्युक्ता तेन सा वक्तुमक्षमा व्याददे मुखम् ।\nपातुं तद्वारिमहिषी भवेयमिति वांछया ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000877046, "chapter_id": 20877, "verse_number": "६-२२०-४७", "content_sanskrit": "अथैतस्य प्रयागस्य पातितेंबुनि तन्मुखे ।\nतत्याज जीवितं सा तु मोहिनीगणिका नृप ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000877047, "chapter_id": 20877, "verse_number": "६-२२०-४८", "content_sanskrit": "प्राणप्रयाणकाले तु महिषीत्वं च वांच्छयत् ।\nअतः सा महिषी जाता द्राविडे वीरवर्मणः ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000877048, "chapter_id": 20877, "verse_number": "६-२२०-४९", "content_sanskrit": "संभूय केरलाधीश गृहे तीर्थांबुपानतः ।\nकुलशीलधनैश्वर्यसंयुक्तस्य महीपते ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000877049, "chapter_id": 20877, "verse_number": "६-२२०-५०", "content_sanskrit": "हेमगौरं ततः सांगं बभार कमलेक्षणा ।\nअतस्तस्य पिता नाम हेमांगीति चकार ह ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000877050, "chapter_id": 20877, "verse_number": "६-२२०-५१", "content_sanskrit": "एकदा सा तु हेमांगी हेमाभरणभूषिता ।\nकलायाः स्ववयस्याया मंत्रिपुत्र्या गृहं ययौ ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000877051, "chapter_id": 20877, "verse_number": "६-२२०-५२", "content_sanskrit": "तत्र यावकतैलेन स्नापिता भोजिता च सा ।\nविविधान्नैस्तदा राजन्निविष्टा वरविष्टरे ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000877052, "chapter_id": 20877, "verse_number": "६-२२०-५३", "content_sanskrit": "पुष्पोद्ग्रथित धमिल्ला क्षामक्षौमविभूषिता ।\nकलां प्रोवाच दधती मुखे तांबूलवीटिकाम् ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000877053, "chapter_id": 20877, "verse_number": "६-२२०-५४", "content_sanskrit": "हेमांग्युवाच ।\nकले कलय मे वाक्यं कोकिलाकलभाषिणि ।\nगृहे यदद्भुतं वस्तु तव मामभिदर्शय ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]