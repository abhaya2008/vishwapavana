[{"id": 6000191000, "chapter_id": 10191, "verse_number": null, "content_sanskrit": "अथ षोडशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000191001, "chapter_id": 10191, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.001.m4a", "display_order": 2}, {"id": 6000191002, "chapter_id": 10191, "verse_number": "९-१६-१", "content_sanskrit": "स इत्थमाचरन् कामांस्‍त्रैणोऽपह्नवमात्मनः।\nबुद्‌ध्वा प्रियायै निर्विण्णो गाथामेतामगायत॥ ९/१६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.002.m4a", "display_order": 3, "topics": [{"text": "भोगान्भुक्त्वा प्राप्तनिर्वेदेन ययातिना बस्ताजयोः कथाकथनव्याजेन कामिनः स्वस्य चेष्टां विनिन्द्य कनिष्ठं पुत्रं पूरुं राज्येऽभिषिच्य तपोवनगमनम्", "range": "१–२३"}]}, {"id": 6000191003, "chapter_id": 10191, "verse_number": "९-१६-२", "content_sanskrit": "शृणु भार्गव्यमूं गाथां मद्विधाचरितां भुवि।\nधीरा यस्यानुशोचन्ति वने ग्रामनिवासिनः॥ ९/१६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.003.m4a", "display_order": 4}, {"id": 6000191004, "chapter_id": 10191, "verse_number": "९-१६-३", "content_sanskrit": "बस्त एको वने कश्चिद् विचिन्वन् प्रियमात्मनः।\nददर्श कूपे पतितां स्वकर्मवशगामजाम्॥ ९/१६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.004.m4a", "display_order": 5}, {"id": 6000191005, "chapter_id": 10191, "verse_number": "९-१६-४", "content_sanskrit": "तस्या उद्धरणोपायं बस्तः कामी विचिन्तयन्। विवर्त्य तीर्थमुद्धृत्य विषाणाग्रेण रोधसि।\nसोत्तीर्य कूपात् सुश्रोणी तमेव चकमे किल॥ ९/१६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.005.m4a", "display_order": 6}, {"id": 6000191006, "chapter_id": 10191, "verse_number": "९-१६-५", "content_sanskrit": "तया वृतं समुद्वीक्ष्य बह्व्योऽजाः कान्तकामिनीः।\nपीवानं श्मश्रुलं प्रेष्ठं मीढ्वांसं यावकोविदम्॥ ९/१६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.006.m4a", "display_order": 7}, {"id": 6000191007, "chapter_id": 10191, "verse_number": "९-१६-६", "content_sanskrit": "स एकोऽजवृषस्तासां बह्वीनां रतिवर्धनः।\nरेमे कामग्रहग्रस्त आत्मानं नावबुध्यत॥ ९/१६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.007.m4a", "display_order": 8}, {"id": 6000191008, "chapter_id": 10191, "verse_number": "९-१६-७", "content_sanskrit": "तमेव प्रेष्ठतमया रममाणमजाऽन्यया।\nविलोक्य रूपसंलग्ना नामृष्यद् बस्तकर्म तत्॥ ९/१६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.008.m4a", "display_order": 9}, {"id": 6000191009, "chapter_id": 10191, "verse_number": "९-१६-८", "content_sanskrit": "तं दुर्हृदं सुहृद्रूपं कामिनं क्षणसौहृदम्।\nइन्द्रियाराममुत्सृज्य स्वामिनं दुःखिता ययौ॥ ९/१६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.009.m4a", "display_order": 10}, {"id": 6000191010, "chapter_id": 10191, "verse_number": "९-१६-९", "content_sanskrit": "सोऽपि चानुगतः स्‍त्रैणः कृपणस्तां प्रसादितुम्।\nकुर्वन् विलिबिलाकारं नाशक्नोत् पथि सन्धितुम्॥ ९/१६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.010.m4a", "display_order": 11}, {"id": 6000191011, "chapter_id": 10191, "verse_number": "९-१६-१०", "content_sanskrit": "तस्य तत्र द्विजः कश्चिदजास्वाम्यच्छिनद् रुषा।\nलम्बन्तं वृषणं भूयः सन्दधेऽर्थाय योगवित्॥ ९/१६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.011.m4a", "display_order": 12}, {"id": 6000191012, "chapter_id": 10191, "verse_number": "९-१६-११", "content_sanskrit": "संवृद्धवृषणः सोऽपि ह्यजया कूपलब्धया।\nकालं बहुतिथं भद्रे कामैर्नाद्यापि तुष्यति॥ ९/१६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.012.m4a", "display_order": 13}, {"id": 6000191013, "chapter_id": 10191, "verse_number": "९-१६-१२", "content_sanskrit": "तथाऽहं कृपणः सुभ्रु भवत्याः प्रेमयन्त्रितः।\nआत्मानं नाभिजानामि मोहितस्तव मायया॥ ९/१६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.013.m4a", "display_order": 14}, {"id": 6000191014, "chapter_id": 10191, "verse_number": "९-१६-१३", "content_sanskrit": "यत् पृथिव्यां व्रीहियवं हिरण्यं पशवः स्‍त्रियः।\nन दुह्यन्ति मनःप्रीतिं पुंसः कामहतस्य मे॥ ९/१६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.014.m4a", "display_order": 15}, {"id": 6000191015, "chapter_id": 10191, "verse_number": "९-१६-१४", "content_sanskrit": "न जातु कामः कामानाम् उपभोगेन शाम्यति।\nहविषा कृष्णवर्त्मेव भूय एवाभिवर्धते॥ ९/१६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.015.m4a", "display_order": 16}, {"id": 6000191016, "chapter_id": 10191, "verse_number": "९-१६-१५", "content_sanskrit": "यदा न कुरुते भावं सर्वभूतेष्वमङ्गलम्।\nसमदृष्टेस्तदा पुंसः सर्वाः सुखमया दिशः॥ ९/१६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.016.m4a", "display_order": 17}, {"id": 6000191017, "chapter_id": 10191, "verse_number": "९-१६-१६", "content_sanskrit": "या दुस्त्यजा दुर्मतिभिर्जीर्यतो या न जीर्यते।\nतां तृष्णां दुःखनिवहां शर्मकामो द्रुतं त्यजेत्॥ ९/१६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.017.m4a", "display_order": 18}, {"id": 6000191018, "chapter_id": 10191, "verse_number": "९-१६-१७", "content_sanskrit": "मात्रा स्वस्रा दुहित्रा वा नाविविक्तासनो भवेत्।\nबलवानिन्द्रियग्रामो विद्वांसमपि कर्षति॥ ९/१६/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.018.m4a", "display_order": 19}, {"id": 6000191019, "chapter_id": 10191, "verse_number": "९-१६-१८", "content_sanskrit": "पूर्णं वर्षसहस्‍त्रं मे विषयान् सेवतोऽसकृत्।\nतथापि चानुसवनं तृष्णा तेषूपजायते॥ ९/१६/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.019.m4a", "display_order": 20}, {"id": 6000191020, "chapter_id": 10191, "verse_number": "९-१६-१९", "content_sanskrit": "तस्मादेतामहं त्यक्त्वा ब्रह्मण्याधाय मानसम्।\nनिर्द्वन्द्वो निरहङ्कारश्चरिष्यामि मृगैः सह॥ ९/१६/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.020.m4a", "display_order": 21}, {"id": 6000191021, "chapter_id": 10191, "verse_number": "९-१६-२०", "content_sanskrit": "दृष्टं श्रुतमसद् विद्वान् नानुध्यायेन्न संविशेत्।\nसंसृतिं चात्मनाशं च तत्र विद्वान् स आत्मदृक्॥ ९/१६/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.021.m4a", "display_order": 22}, {"id": 6000191022, "chapter_id": 10191, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.022.m4a", "display_order": 23}, {"id": 6000191023, "chapter_id": 10191, "verse_number": "९-१६-२१", "content_sanskrit": "इत्युक्त्वा नाहुषो जायां तदीयं पूरवे वयः।\nदत्त्वा स्वां जरसं तस्मादाददे विगतस्पृहः॥ ९/१६/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.023.m4a", "display_order": 24}, {"id": 6000191024, "chapter_id": 10191, "verse_number": "९-१६-२२", "content_sanskrit": "दिशि दक्षिणपूर्वस्यां द्रुह्युं दक्षिणतो यदुम्।\nप्रतीच्यां तुर्वसुं चक्रे उदीच्यामनुमीश्वरम्॥ ९/१६/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.024.m4a", "display_order": 25}, {"id": 6000191025, "chapter_id": 10191, "verse_number": "९-१६-२३", "content_sanskrit": "भूमण्डलस्य सर्वस्य पूरुमर्हत्तमं विशाम्।\nअभिषिच्याग्रजांस्तस्य वशे स्थाप्य वनं ययौ॥ ९/१६/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.025.m4a", "display_order": 26}, {"id": 6000191026, "chapter_id": 10191, "verse_number": "९-१६-२४", "content_sanskrit": "आम्रेडितं वर्षपूगान् षड्वर्गं विषयेषु सः।\nक्षणेन मुमुचे नीडं जातपक्ष इव द्विजः॥ ९/१६/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.026.m4a", "display_order": 27, "topics": [{"text": "तत्र तपस्तप्त्वा तस्योत्तमगतिप्राप्तिः", "range": "२४–२९"}]}, {"id": 6000191027, "chapter_id": 10191, "verse_number": "९-१६-२५", "content_sanskrit": "स तत्र निर्मुक्तसमस्तसङ्गः आत्मानुभूत्या विधुतत्रिलिङ्गः।\nपरेऽमले ब्रह्मणि वासुदेवे लेभे गतिं भागवतीं प्रतीतः॥ ९/१६/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.027.m4a", "display_order": 28}, {"id": 6000191028, "chapter_id": 10191, "verse_number": "९-१६-२६", "content_sanskrit": "श्रुत्वा गाथां देवयानी मेने प्रस्तोभमात्मनः।\nस्‍त्रीपुंसोः स्नेहवैक्लव्यात् परिहासमिवोदितम्॥ ९/१६/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.028.m4a", "display_order": 29}, {"id": 6000191029, "chapter_id": 10191, "verse_number": "९-१६-२७", "content_sanskrit": "सा संनिवासं सुहृदां प्रपायामिव गच्छताम्।\nविज्ञायेश्वरतन्त्राणां मायाविरचितं प्रभो॥ ९/१६/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.029.m4a", "display_order": 30}, {"id": 6000191030, "chapter_id": 10191, "verse_number": "९-१६-२८", "content_sanskrit": "सर्वत्र सङ्गमुत्सृज्य स्वाप्नौपम्येन भार्गवी।\nकृष्णे मनः समावेश्य व्यधुनोल्लिङ्गमात्मनः॥ ९/१६/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.030.m4a", "display_order": 31}, {"id": 6000191031, "chapter_id": 10191, "verse_number": "९-१६-२९", "content_sanskrit": "नमस्तुभ्यं भगवते वासुदेवाय वेधसे।\nसर्वभूताधिवासाय शान्ताय बृहते नमः॥ ९/१६/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_09/adhyaya_016/BhP_09.016.031.m4a", "display_order": 32}, {"id": 6000191032, "chapter_id": 10191, "verse_number": null, "content_sanskrit": "इति श्रीमद्भागवते वैयासिक्यां संहितायां नवमस्कन्धे षोडशाध्यायः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]