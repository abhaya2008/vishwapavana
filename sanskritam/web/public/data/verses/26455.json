[{"id": 7006455000, "chapter_id": 26455, "verse_number": "२-११६-१", "content_sanskrit": "जनमेजय उवाच\nभूय एव महाबाहोर्यदुसिंहस्य धीमतः ।\nकर्माण्यपरिमेयाणि श्रुतानि द्विजसत्तम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006455001, "chapter_id": 26455, "verse_number": "२-११६-२", "content_sanskrit": "त्वत्तः श्रुतवतां श्रेष्ठ वासुदेवस्य धीमतः ।\nयत् त्वया कथितं पूर्वं बाणं प्रति महासुरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006455002, "chapter_id": 26455, "verse_number": "२-११६-३", "content_sanskrit": "कथं च देवदेवस्य पुत्रत्वमसुरो गतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006455003, "chapter_id": 26455, "verse_number": "२-११६-४", "content_sanskrit": "योऽभिगुप्तः स्वयं ब्रह्मञ्छङ्करेण महात्मना ।\nसहवासं गतेनैव सगणेन गुहेन तु ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006455004, "chapter_id": 26455, "verse_number": "२-११६-५", "content_sanskrit": "बलेर्बलवतः पुत्रो ज्येष्ठो भ्रातृशतस्य यः ।\nवृतो बाहुसहस्रेण दिव्यास्त्रशतधारिणा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006455005, "chapter_id": 26455, "verse_number": "२-११६-६", "content_sanskrit": "असंख्यैश्च महाकायैर्महाबलशतैर्वृतः ।\nवासुदेवेन स कथं बाणः संख्ये पराजितः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006455006, "chapter_id": 26455, "verse_number": "२-११६-७", "content_sanskrit": "संरब्धश्चैव युद्धार्थी जीवन्मुक्तः कथं च सः ।\nवैशम्पायन उवाच\nशृणुष्वावहितो राजन् कृष्णस्यामिततेजसः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006455007, "chapter_id": 26455, "verse_number": "२-११६-८", "content_sanskrit": "मनुष्यलोके बाणेन यथाभूद् विग्रहो महान् ।\nवासुदेवेन यत्रासौ रुद्रस्कन्दसहायवान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006455008, "chapter_id": 26455, "verse_number": "२-११६-९", "content_sanskrit": "बलिपुत्रो रणश्लाघी जित्वा जीवन्विसर्जितः ।\nयथा चास्य वरो दत्तः शंकरेण महात्मना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006455009, "chapter_id": 26455, "verse_number": "२-११६-१०", "content_sanskrit": "नित्यं सांनिध्यतां चैव गाणपत्यं तथाक्षयम् ।\nयथा बाणस्य तद् युद्धं जीवन्मुक्तो यथा च सः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006455010, "chapter_id": 26455, "verse_number": "२-११६-११", "content_sanskrit": "यथा च देवदेवस्य पुत्रत्वं सोऽसुरो गतः ।\nयदर्थं च महद् युद्धं तत् सर्वमखिलं शृणु ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006455011, "chapter_id": 26455, "verse_number": "२-११६-१२", "content_sanskrit": "दृष्ट्वा वपुः कुमारस्य क्रीडतश्च महात्मनः ।\nबलिपुत्रो महावीर्यो विस्मयं परमं गतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006455012, "chapter_id": 26455, "verse_number": "२-११६-१३", "content_sanskrit": "तस्य बुद्धिः समुत्पन्ना तपश्चर्तुं सुदुष्करम् ।\nरुद्रस्याराधनार्थाय देवस्य स्यां यथा सुतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006455013, "chapter_id": 26455, "verse_number": "२-११६-१४", "content_sanskrit": "ततोऽग्लपयदात्मानं तपसा श्लाघते च सः ।\nदेवश्च परमं तोषं जगाम च सहोमया ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006455014, "chapter_id": 26455, "verse_number": "२-११६-१५", "content_sanskrit": "नीलकण्ठः परां प्रीतिं गत्वा चासुरमब्रवीत् ।\nवरं वरय भद्रं ते यत् ते मनसि वर्तते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006455015, "chapter_id": 26455, "verse_number": "२-११६-१६", "content_sanskrit": "अथ बाणोऽब्रवीद् वाक्यं देवदेवं महेश्वरम् ।\nदेव्याः पुत्रत्वमिच्छामि त्वया दत्तं त्रिलोचन ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006455016, "chapter_id": 26455, "verse_number": "२-११६-१७", "content_sanskrit": "शंकरस्तु तथेत्युक्त्वा रुद्राणीमिदमब्रवीत् ।\nकनीयान् कार्तिकेयस्य पुत्रोऽयं प्रतिगृह्यताम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006455017, "chapter_id": 26455, "verse_number": "२-११६-१८", "content_sanskrit": "यत्रोत्थितो महासेनः सोऽग्निजो रुधिरे पुरे ।\nतत्रोद्देशे पुरं चास्य भविष्यति न संशयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006455018, "chapter_id": 26455, "verse_number": "२-११६-१९", "content_sanskrit": "नाम्ना तच्छोणितपुरं भविष्यति पुरोत्तमम् ।\nमयाभिगुप्तं श्रीमन्तं न कश्चित् प्रसहिष्यति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006455019, "chapter_id": 26455, "verse_number": "२-११६-२०", "content_sanskrit": "ततः स निवसन् बाणः पुरे शोणितसाह्वये ।\nराज्यं प्रशासते नित्यं क्षोभयन् सर्वदेवताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006455020, "chapter_id": 26455, "verse_number": "२-११६-२१", "content_sanskrit": "अथ वीर्यमदोत्सिक्तो बाणो बाहुसहस्रवान् ।\nअचिन्तयन् देवगणान् युद्धमाकाङ्क्षते सदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006455021, "chapter_id": 26455, "verse_number": "२-११६-२२", "content_sanskrit": "ध्वजं चास्य ददौ प्रीतः कुमारो ह्यग्नितेजसम् ।\nवाहनं चैव बाणस्य मयूरं दीप्ततेजसम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006455022, "chapter_id": 26455, "verse_number": "२-११६-२३", "content_sanskrit": "न देवा न च गन्धर्वा न यक्षा नापि पन्नगाः ।\nतस्य युद्धे व्यतिष्ठन्त देवदेवस्य तेजसा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006455023, "chapter_id": 26455, "verse_number": "२-११६-२४", "content_sanskrit": "त्र्यम्बकेणाभिगुप्तश्च दर्पोत्सिक्तो महासुरः ।\nभूयो मृगयते युद्धं शूलिनं सोऽभ्यगच्छत ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006455024, "chapter_id": 26455, "verse_number": "२-११६-२५", "content_sanskrit": "स रुद्रमभिगम्याथ प्रणिपत्याभिवाद्य च ।\nबलिसूनुरिदं वाक्यं पप्रच्छ वृषभध्वजम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006455025, "chapter_id": 26455, "verse_number": "२-११६-२६", "content_sanskrit": "असकृन्निर्जिता देवाः ससाध्याः समरुद्गणाः ।\nमया मदबलोत्सेकात् ससैन्येन तवाश्रयात् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006455026, "chapter_id": 26455, "verse_number": "२-११६-२७", "content_sanskrit": "इमं देशं समागम्य वसन्ति स्म पुरे सुखम् ।\nते पराजयसंत्रस्ता निराशा मत्पराजये ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006455027, "chapter_id": 26455, "verse_number": "२-११६-२८", "content_sanskrit": "नाकपृष्ठमुपागम्य निवसन्ति यथासुखम् ।\nसोऽहं निराशो युद्धस्य जीवितं नाद्य कामये ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006455028, "chapter_id": 26455, "verse_number": "२-११६-२९", "content_sanskrit": "अयुध्यतो वृथा ह्येषां बाहूनां धारणं मम ।\nतद् ब्रूहि मम युद्धस्य कच्चिदागमनं भवेत् ।\nन मे युद्धं विना देव रतिरस्ति प्रसीद मे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006455029, "chapter_id": 26455, "verse_number": "२-११६-३०", "content_sanskrit": "ततः प्रहस्य भगवानब्रवीद् वृषभध्वजः ।\nभविता बाण युद्धं वै यथा तच्छृणु दानव ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006455030, "chapter_id": 26455, "verse_number": "२-११६-३१", "content_sanskrit": "ध्वजस्यास्य यदा भङ्गस्तव तात भविष्यति ।\nस्वस्थाने स्थापितस्याथ तदा युद्धं भविष्यति ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006455031, "chapter_id": 26455, "verse_number": "२-११६-३२", "content_sanskrit": "इत्येवमुक्तः प्रहसन् बाणस्तु बहुशो मुदा ।\nप्रसन्नवदनो भूत्वा पादयोः पतितोऽब्रवीत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006455032, "chapter_id": 26455, "verse_number": "२-११६-३३", "content_sanskrit": "दिष्ट्या बाहुसहस्रस्य न वृथा धारणं मम ।\nदिष्ट्या सहस्राक्षमहं विजेता पुनराहवे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006455033, "chapter_id": 26455, "verse_number": "२-११६-३४", "content_sanskrit": "आनन्देनाश्रुपूर्णाभ्यां नेत्राभ्यामरिमर्दनः ।\nपञ्चाञ्जलिशतैर्देवं पूजयन् पतितो भुवि ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006455034, "chapter_id": 26455, "verse_number": "२-११६-३५", "content_sanskrit": "ईश्वर उवाच\nउत्तिष्ठोत्तिष्ठ बाहूनामात्मनः स्वकुलस्य तु ।\nसदृशं प्राप्स्यसे वीर युद्धमप्रतिमं महत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006455035, "chapter_id": 26455, "verse_number": "२-११६-३६", "content_sanskrit": "वैशम्पायन उवाच\nएवमुक्तस्ततो बाणस्त्र्यम्बकेण महात्मना ।\nहर्षेणात्युच्छ्रितः शीघ्रं ननाम वृषभध्वजम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006455036, "chapter_id": 26455, "verse_number": "२-११६-३७", "content_sanskrit": "शितिकण्ठविसृष्टस्तु बाणः परपुरंजयः ।\nययौ स्वभवनं तत्र यत्र ध्वजगृहं महत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006455037, "chapter_id": 26455, "verse_number": "२-११६-३८", "content_sanskrit": "तत्रोपविष्टः प्रहसन् कुम्भाण्डमिदमब्रवीत् ।\nप्रियमावेदयिष्यामि भवतो यन्मनोगतम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006455038, "chapter_id": 26455, "verse_number": "२-११६-३९", "content_sanskrit": "इत्येवमुक्तः प्रहसन् बाणमप्रतिमं रणे ।\nप्रोवाच राजन्किं त्वेतद्वक्तुकामोऽसि मत्प्रियम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006455039, "chapter_id": 26455, "verse_number": "२-११६-४०", "content_sanskrit": "विस्मयोत्फुल्लनयनः प्रहर्षादिव भाषसे ।\nत्वत्तः श्रोतुमिहेच्छामि वरं किं लब्धवानसि ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006455040, "chapter_id": 26455, "verse_number": "२-११६-४१", "content_sanskrit": "देवदेवप्रसादेन स्कन्दस्य च महात्मनः ।\nईप्सितं किं त्वया प्राप्तं तन्मे ब्रूहि महासुर ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006455041, "chapter_id": 26455, "verse_number": "२-११६-४२", "content_sanskrit": "शितिकण्ठप्रसादेन स्कन्दगोपायनेन च ।\nकच्चित्त्रैलोक्यराज्यं ते व्यादिष्टं शूलपाणिना ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006455042, "chapter_id": 26455, "verse_number": "२-११६-४३", "content_sanskrit": "कच्चिद् विष्णुपरित्रासं विमोक्ष्यन्ति दितेः सुताः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006455043, "chapter_id": 26455, "verse_number": "२-११६-४४", "content_sanskrit": "पातालवासमुत्सृज्य कच्चित्तव बलाश्रयात् ।\nविबुधावासनिरता भविष्यन्ति महासुराः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006455044, "chapter_id": 26455, "verse_number": "२-११६-४५", "content_sanskrit": "बलिर्विष्णुपराक्रान्तो बद्धस्तव पिता नृप ।\nसलिलौघाद् विनिष्क्रम्य कच्चिद्राज्यमवाप्स्यति॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006455045, "chapter_id": 26455, "verse_number": "२-११६-४६", "content_sanskrit": "दिव्यमाल्याम्बरधरं दिव्यस्रग्गन्धलेपनम् ।\nकच्चिद् वैरोचनिं तात द्रक्ष्यामः पितरं तव ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006455046, "chapter_id": 26455, "verse_number": "२-११६-४७", "content_sanskrit": "कच्चित्त्रिभिः क्रमैः पूर्वं हृताँल्लोकानिमान्प्रभो ।\nपुनः प्रत्यानयिष्यामो जित्वा सर्वान्दिवौकसः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006455047, "chapter_id": 26455, "verse_number": "२-११६-४८", "content_sanskrit": "स्निग्धगम्भीरनिर्घोषं शङ्खस्वनपुरोजवम् ।\nकच्चिन्नारायणं देवं जेष्यामः समितिंजयम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006455048, "chapter_id": 26455, "verse_number": "२-११६-४९", "content_sanskrit": "कच्चिद् वृषध्वजस्तात प्रसादसुमुखस्तव ।\nयथा ते हृदयोत्कम्पः साश्रुबिन्दुः प्रवर्तते ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006455049, "chapter_id": 26455, "verse_number": "२-११६-५०", "content_sanskrit": "कश्चिदीश्वरतोषेण कार्तिंकेयमतेन च ।\nप्राप्तवानसि सर्वेषामस्माकं राज्यसम्पदम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006455050, "chapter_id": 26455, "verse_number": "२-११६-५१", "content_sanskrit": "इति कुम्भाण्डवचनैश्चोदितः सोऽसुरोत्तमः ।\nबाणो वाणीमसंसक्तां प्रोवाच वदतां वरः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006455051, "chapter_id": 26455, "verse_number": "२-११६-५२", "content_sanskrit": "बाण उवाच\nचिरात्प्रभृति कुम्भाण्ड न युद्धं प्राप्यते मया ।\nततो मया मुदा पृष्टः शितिकण्ठः प्रतापवान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006455052, "chapter_id": 26455, "verse_number": "२-११६-५३", "content_sanskrit": "युद्धाभिलाषः सुमहान् देव संजायते मम ।\nअभिप्राप्स्याम्यहं युद्धं मनसस्तुष्टिवर्धनम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006455053, "chapter_id": 26455, "verse_number": "२-११६-५४", "content_sanskrit": "ततोऽहं देवदेवेन हरेणामित्रघातिना ।\nप्रहस्य सुचिरं कालमुक्तोऽस्मि वचनं प्रियम् ।\nप्राप्स्यसे सुमहद् युद्धं त्वं बाणाप्रतिमं महत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006455054, "chapter_id": 26455, "verse_number": "२-११६-५५", "content_sanskrit": "मयूरध्वजभङ्गस्ते भविष्यति यदासुर ।\nतदा त्वं प्राप्स्यसे युद्धं सुमहद् दितिनन्दन ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006455055, "chapter_id": 26455, "verse_number": "२-११६-५६", "content_sanskrit": "ततोऽहं परमप्रीतो भगवन्तं वृषध्वजम् ।\nप्रणम्य शिरसा देवं तवान्तिकमुपागतः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006455056, "chapter_id": 26455, "verse_number": "२-११६-५७", "content_sanskrit": "इत्येवमुक्तः कुम्भाण्डः प्रोवाच नृपतिं तदा ।\nअहो न शोभनं राजन यदेवं भाषसे वचः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006455057, "chapter_id": 26455, "verse_number": "२-११६-५८", "content_sanskrit": "एवं कथयतोस्तत्र तयोरन्योन्यमुच्छ्रितः ।\nध्वजः पपात वेगेन शक्राशनिसमाहतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006455058, "chapter_id": 26455, "verse_number": "२-११६-५९", "content_sanskrit": "तं तथा पतितं दृष्ट्वा सोऽसुरो ध्वजमुत्तमम् ।\nप्रहर्षमतुलं लेभे मेने चाहवमागतम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006455059, "chapter_id": 26455, "verse_number": "२-११६-६०", "content_sanskrit": "ततश्चकम्पे वसुधा शक्राशनिसमाहता ।\nननादान्तर्हितो भूमौ वृषदंशो जगर्ज च ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006455060, "chapter_id": 26455, "verse_number": "२-११६-६१", "content_sanskrit": "देवानामपि यो देवः सोऽप्यवर्षत वासवः ।\nशोणितं शोणितपुरे सर्वतः परमं ततः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006455061, "chapter_id": 26455, "verse_number": "२-११६-६२", "content_sanskrit": "सूर्य भित्त्वा महोल्का च पपात धरणीतले ।\nस्वपक्षे चोदितः सूर्यो भरणीं समपीडयत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006455062, "chapter_id": 26455, "verse_number": "२-११६-६३", "content_sanskrit": "चैत्यवृक्षेषु सहसा धाराः शतसहस्रशः ।\nशोणितस्य स्रवन् घोरा निपेतुस्तारका भृशम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006455063, "chapter_id": 26455, "verse_number": "२-११६-६४", "content_sanskrit": "राहुरग्रसदादित्यमपर्वणि विशाम्पते ।\nलोकक्षयकरे काले निर्घातश्चापतन्महान् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006455064, "chapter_id": 26455, "verse_number": "२-११६-६५", "content_sanskrit": "दक्षिणां दिशमास्थाय धूमकेतुः स्थितोऽभवत् ।\nअनिशं चाप्यविच्छिन्ना ववुर्वाताः सुदारुणाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006455065, "chapter_id": 26455, "verse_number": "२-११६-६६", "content_sanskrit": "श्वेतलोहितपर्यन्तः कृष्णग्रीवस्तडिद्द्युतिः ।\nत्रिवर्णपरिघो भानुः संध्यारागमथावृणोत् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006455066, "chapter_id": 26455, "verse_number": "२-११६-६७", "content_sanskrit": "वक्रमङ्गारकश्चक्रे कृत्तिकासु भयंकरः ।\nबाणस्य जन्मनक्षत्रं भर्त्सयन्निव सर्वशः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006455067, "chapter_id": 26455, "verse_number": "२-११६-६८", "content_sanskrit": "अनेकशाखश्चैत्यश्च निपपात महीतले ।\nअर्चितः सर्वकन्याभिर्दानवानां महात्मनाम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006455068, "chapter_id": 26455, "verse_number": "२-११६-६९", "content_sanskrit": "एवं विविधरूपाणि निमित्तानि निशामयन् ।\nबाणो बलमदोन्मत्तो निश्चयं नाधिगच्छति ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006455069, "chapter_id": 26455, "verse_number": "२-११६-७०", "content_sanskrit": "विचेतास्त्वभवत् प्राज्ञः कुम्भाण्डस्तत्त्वदर्शिवान् ।\nबाणस्य सचिवस्तत्र कीर्तयन् बहुकिल्बिषम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006455070, "chapter_id": 26455, "verse_number": "२-११६-७१", "content_sanskrit": "उत्पाता ह्यत्र दृश्यन्ते कथयन्तो न शोभनम् ।\nतव राज्यविनाशाय भविष्यन्ति न संशयः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006455071, "chapter_id": 26455, "verse_number": "२-११६-७२", "content_sanskrit": "वयं चान्ये च सचिवा भृत्यास्ते च तवानुगाः ।\nक्षयं यास्यन्ति नचिरात् सर्वे पार्थिव दुर्नयात् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006455072, "chapter_id": 26455, "verse_number": "२-११६-७३", "content_sanskrit": "यथा शक्रध्वजतरोः स्वदर्पात् पतनं भवेत् ।\nबलमाकाङ्क्षतो मोहात् तथा बाणस्य नर्दतः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006455073, "chapter_id": 26455, "verse_number": "२-११६-७४", "content_sanskrit": "देवदेवप्रसादात् तु त्रैलोक्यविजयं गतः ।\nउत्सेकाद् दृश्यते नाशो युद्धाकाङ्क्षी ननर्द ह ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006455074, "chapter_id": 26455, "verse_number": "२-११६-७५", "content_sanskrit": "बाणः प्रीतमनास्त्वेवं पपौ पानमनुत्तमम् ।\nदैत्यदानवनारीभिः सार्धमुत्तमविक्रमः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006455075, "chapter_id": 26455, "verse_number": "२-११६-७६", "content_sanskrit": "कुम्भाण्डश्चिन्तयाविष्टो राजवेश्माभ्ययात्तदा ।\nअचिन्तयच्च तत्त्वार्थं तैस्तैरुत्पातदर्शनैः ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7006455076, "chapter_id": 26455, "verse_number": "२-११६-७७", "content_sanskrit": "राजा प्रमादी दुर्बुद्धिर्जितकाशी महासुरः ।\nयुद्धमेवाभिलषते न दोषान्मन्यते मदात् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7006455077, "chapter_id": 26455, "verse_number": "२-११६-७८", "content_sanskrit": "महोत्पातभयं चैव न तन्मिथ्या भविष्यति ।\nअपीदानीं भवेन्मिथ्या सर्वमुत्पातदर्शनम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7006455078, "chapter_id": 26455, "verse_number": "२-११६-७९", "content_sanskrit": "इह त्वास्ते त्रिनयनः कार्तिकेयश्च वीर्यवान् ।\nतेनोत्पन्नोऽपि दोषो नः कच्चिद्गच्छेत्पराभवम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7006455079, "chapter_id": 26455, "verse_number": "२-११६-८०", "content_sanskrit": "उत्पन्नदोषप्रभवः क्षयोऽयं भविता महान् ।\nदोषाणां न भवेन्नाश इति मे धीयते मतिः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7006455080, "chapter_id": 26455, "verse_number": "२-११६-८१", "content_sanskrit": "नियतो दोष एवायं भविष्यति न संशयः ।\nदौरात्म्यान्नृपतेरस्य दोषभूता हि दानवाः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7006455081, "chapter_id": 26455, "verse_number": "२-११६-८२", "content_sanskrit": "देवदानवसंघानां यः कर्ता भुवनप्रभुः ।\nभगवान् कातिकेयश्च कृतवाँल्लोहिते पुरे ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7006455082, "chapter_id": 26455, "verse_number": "२-११६-८३", "content_sanskrit": "प्राणैः प्रियतरो नित्यं भविष्यति गुहः सदा ।\nतद्विशिष्टश्च बाणोऽपि शिवस्य सततं प्रियः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7006455083, "chapter_id": 26455, "verse_number": "२-११६-८४", "content_sanskrit": "दर्पोत्सेकात्तु नाशाय वरं याचितवान्भवम् ।\nयुद्धहेतोः स लुब्धस्तु सर्वथा न भविष्यति ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7006455084, "chapter_id": 26455, "verse_number": "२-११६-८५", "content_sanskrit": "यदि विष्णुपुरोगानामिन्द्रादीनां दिवौकसाम् ।\nभवित्री घनवत्प्राप्तिर्भवहस्तात्कृता भवेत् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7006455085, "chapter_id": 26455, "verse_number": "२-११६-८६", "content_sanskrit": "एतयोश्च हि को युद्धं कुमारभवयोरिह ।\nशक्तो दातुं समागम्य बाणसाहाय्यकाङ्क्षिणोः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7006455086, "chapter_id": 26455, "verse_number": "२-११६-८७", "content_sanskrit": "न च देववचो मिथ्या भविष्यति कदाचन ।\nभविष्यति महद् युद्धं सर्वदैत्यविनाशनम् ॥ ८७", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7006455087, "chapter_id": 26455, "verse_number": "२-११६-८८", "content_sanskrit": "स एवंचिन्तयाविष्टः कुम्भाण्डस्तत्त्वदर्शिवान् ।\nस्वस्तिप्रणिहितां बुद्धिं चकार स महासुरः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7006455088, "chapter_id": 26455, "verse_number": "२-११६-८९", "content_sanskrit": "ये हि देवैर्विरुध्यन्ते पुण्यकर्मभिराहवे ।\nयथा बलिर्नियमितस्तथा ते यान्ति संक्षयम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}]