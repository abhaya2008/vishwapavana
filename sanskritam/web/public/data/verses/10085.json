[{"id": 6000085000, "chapter_id": 10085, "verse_number": null, "content_sanskrit": "अथ एकविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000085001, "chapter_id": 10085, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.001.m4a", "display_order": 2}, {"id": 6000085002, "chapter_id": 10085, "verse_number": "४-२१-१", "content_sanskrit": "मौक्तिकैः कुसुमस्रग्भिर्दुकूलैः स्वर्णतोरणैः।\nमहासुरभिभिर्धूपैर्मण्डितं तत्र तत्र वै॥ ४/२१/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.002.m4a", "display_order": 3, "topics": [{"text": "पृथुना प्रजानामनुशासनम्", "range": "१–१८"}]}, {"id": 6000085003, "chapter_id": 10085, "verse_number": "४-२१-२", "content_sanskrit": "चन्दनागुरुतोयार्द्ररथ्याचत्वरमार्गवत्।\nपुष्पाक्षतफलैस्तोयैर्लाजैरर्चिभिरर्चितम्॥ ४/२१/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.003.m4a", "display_order": 4}, {"id": 6000085004, "chapter_id": 10085, "verse_number": "४-२१-३", "content_sanskrit": "संवृतैः कदलीस्तम्भैः पूगपोतैः परिष्कृतम्।\nतरुपल्लवमालाभिः सर्वतः समलंकृतम्॥ ४/२१/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.004.m4a", "display_order": 5}, {"id": 6000085005, "chapter_id": 10085, "verse_number": "४-२१-४", "content_sanskrit": "प्रजास्तं दीपबलिभिः सम्भृताशेषमङ्गलैः।\nअभीयुर्मृष्टकन्याश्च मृष्टकुण्डलमण्डिताः॥ ४/२१/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.005.m4a", "display_order": 6}, {"id": 6000085006, "chapter_id": 10085, "verse_number": "४-२१-५", "content_sanskrit": "शङ्खदुन्दुभिघोषेण ब्रह्मघोषेण चर्त्विजाम्।\nविवेश भवनं भूयः स्तूयमानो गतस्मयः॥ ४/२१/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.006.m4a", "display_order": 7}, {"id": 6000085007, "chapter_id": 10085, "verse_number": "४-२१-६", "content_sanskrit": "पूजितः पूजयामास तत्र तत्र महायशाः।\nपौरान् जानपदांस्तांस्तान् प्रीतः प्रियवरप्रदः॥ ४/२१/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.007.m4a", "display_order": 8}, {"id": 6000085008, "chapter_id": 10085, "verse_number": "४-२१-७", "content_sanskrit": "स एवमादीन्यनवद्यचेष्टितः कर्माणि भूयांसि महन्महत्तमः।\nकुर्वन् शशासावनिमण्डलं यशः स्फीतं निधायारुरुहे परं पदम्॥ ४/२१/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.008.m4a", "display_order": 9}, {"id": 6000085009, "chapter_id": 10085, "verse_number": null, "content_sanskrit": "सूत उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.009.m4a", "display_order": 10}, {"id": 6000085010, "chapter_id": 10085, "verse_number": "४-२१-८", "content_sanskrit": "श्रुत्वाऽऽदिराजस्य यशो विजृम्भितं गुणैरशेषैर्गुणवत्सभाजितम्।\nक्षत्ता महाभागवतः सदस्पते कौशारविं प्राह गुरुं समर्चयन्॥ ४/२१/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.010.m4a", "display_order": 11}, {"id": 6000085011, "chapter_id": 10085, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.011.m4a", "display_order": 12}, {"id": 6000085012, "chapter_id": 10085, "verse_number": "४-२१-९", "content_sanskrit": "सोऽभिषिक्तः पुथुर्विप्रैर्लब्धाशेषसुरार्हणः।\nबिभ्रच्च वैष्णवं तेजो बाह्वोर्याभ्यां दुदोह गाम्॥ ४/२१/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.012.m4a", "display_order": 13}, {"id": 6000085013, "chapter_id": 10085, "verse_number": "४-२१-१०", "content_sanskrit": "को न्वस्य कीर्तिं न शृृणोत्यभिज्ञो यद्विक्रमोच्छिष्टमशेषभूपाः।\nलोकाः सपाला उपजीवन्ति काममद्यापि तन्मे वद कर्म शुद्धम्॥ ४/२१/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.013.m4a", "display_order": 14}, {"id": 6000085014, "chapter_id": 10085, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.014.m4a", "display_order": 15}, {"id": 6000085015, "chapter_id": 10085, "verse_number": "४-२१-११", "content_sanskrit": "गङ्गायमुनयोर्नद्योरन्तरा क्षेत्रमावसन्।\nआरब्धानेव बुभुजे भोगान् पुण्यजिहासया॥ ४/२१/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.015.m4a", "display_order": 16}, {"id": 6000085016, "chapter_id": 10085, "verse_number": "४-२१-१२", "content_sanskrit": "सर्वत्रास्खलितादेशः सप्तद्वीपैकदण्डधृक्।\nअन्यत्र ब्राह्मणकुलादन्यत्राच्युतगोत्रतः॥ ४/२१/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.016.m4a", "display_order": 17}, {"id": 6000085017, "chapter_id": 10085, "verse_number": "४-२१-१३", "content_sanskrit": "एकदाऽऽसीन्महासत्रदीक्षा तत्र दिवौकसाम्।\nसमाजो ब्रह्मर्षीणां च देवर्षीणां च सत्तम॥ ४/२१/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.017.m4a", "display_order": 18}, {"id": 6000085018, "chapter_id": 10085, "verse_number": "४-२१-१४", "content_sanskrit": "तस्मिन्नर्हत्सु सर्वेषु स्वर्चितेषु यथार्हतः।\nउत्थितः स सदोमध्ये ताराणामुडुराडिव॥ ४/२१/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.018.m4a", "display_order": 19}, {"id": 6000085019, "chapter_id": 10085, "verse_number": "४-२१-१५", "content_sanskrit": "प्रांशुः पीनायतभुजो गौरः कञ्जारुणेक्षणः।\nसुनासः सुमुखः सौम्यः पीनांसः सुद्विजस्मितः॥ ४/२१/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.019.m4a", "display_order": 20}, {"id": 6000085020, "chapter_id": 10085, "verse_number": "४-२१-१६", "content_sanskrit": "व्यूढवक्षा बृहच्छ्रोणिर्वलीवल्गुतरोदरः।\nआवर्तनाभिरोजस्वी काञ्चनोरुरुदग्रवाक्॥ ४/२१/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.020.m4a", "display_order": 21}, {"id": 6000085021, "chapter_id": 10085, "verse_number": "४-२१-१७", "content_sanskrit": "सूक्ष्मवक्रासितस्निग्धमूर्धजः कम्बुकन्धरः।\nमहाधने दुकूलाग्र्ये परिधायोपधाय च॥ ४/२१/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.021.m4a", "display_order": 22}, {"id": 6000085022, "chapter_id": 10085, "verse_number": "४-२१-१८", "content_sanskrit": "व्यञ्जिताशेषगात्रश्रीर्नियमे न्यस्तभूषणः।\nकृष्णाजिनधरः श्रीमान् कुशपाणिः कृतोचितः॥ ४/२१/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.022.m4a", "display_order": 23}, {"id": 6000085023, "chapter_id": 10085, "verse_number": "४-२१-१९", "content_sanskrit": "शिशिरस्निग्धताराक्षः तानैक्षत समन्ततः। ऊचिवानिदमुर्वीशः सदस्यान् हर्षयन्निव।\nचारु चित्रपदं श्लक्ष्णं हृद्यं गूढमविक्लवम्॥ ४/२१/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.023.m4a", "display_order": 24, "topics": [{"text": "पृथुना प्रजाभ्यो धर्मोपदेशः", "range": "१९–४३"}]}, {"id": 6000085024, "chapter_id": 10085, "verse_number": null, "content_sanskrit": "पृथुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.024.m4a", "display_order": 25}, {"id": 6000085025, "chapter_id": 10085, "verse_number": "४-२१-२०", "content_sanskrit": "सभ्याः शृणुत भद्रं वः साधवो य इहागताः।\nसत्सु जिज्ञासुभिर्धर्ममावेद्यं स्वमनीषितम्॥ ४/२१/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.025.m4a", "display_order": 26}, {"id": 6000085026, "chapter_id": 10085, "verse_number": "४-२१-२१", "content_sanskrit": "अहं दण्डधरो धात्रा प्रजानामिह योजितः।\nरक्षिता वृत्तिदस्तेषु सेतुषु स्थापिता पृथक्॥ ४/२१/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.026.m4a", "display_order": 27}, {"id": 6000085027, "chapter_id": 10085, "verse_number": "४-२१-२२", "content_sanskrit": "तस्य मे तदनुष्ठानाद् यदाहुर्ब्रह्मवादिनः।\nलोकाः स्युः कामसंदोहा यस्य तुष्यति दिष्टदृक्॥ ४/२१/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.027.m4a", "display_order": 28}, {"id": 6000085028, "chapter_id": 10085, "verse_number": "४-२१-२३", "content_sanskrit": "य उद्धरेत् करं राजा प्रजा धर्मेष्वशिक्षयन्।\nप्रजानां शमलं भुङ्क्ते भागं च स्वं जहाति सः॥ ४/२१/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.028.m4a", "display_order": 29}, {"id": 6000085029, "chapter_id": 10085, "verse_number": "४-२१-२४", "content_sanskrit": "तत् प्रजा भर्तृपिण्डार्थं स्वार्थमप्यनसूयवः।\nकुरुताधोक्षजधियं तर्हि मेऽनुग्रहः कृतः॥ ४/२१/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.029.m4a", "display_order": 30}, {"id": 6000085030, "chapter_id": 10085, "verse_number": "४-२१-२५", "content_sanskrit": "यूयं तदनुमोदध्वं पितृदेवर्षयोऽमलाः।\nकर्तुः शास्तुरनुज्ञातुस्तुल्यं यत् प्रेत्य तत् फलम्॥ ४/२१/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.030.m4a", "display_order": 31}, {"id": 6000085031, "chapter_id": 10085, "verse_number": "४-२१-२६", "content_sanskrit": "अस्ति यज्ञपतिर्नाम केषांचिदिह सत्तमाः।\nइहामुत्र च लक्ष्यन्ते ज्योत्स्नावत्यः क्‍वचिद् भुवः॥ ४/२१/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.031.m4a", "display_order": 32}, {"id": 6000085032, "chapter_id": 10085, "verse_number": "४-२१-२७", "content_sanskrit": "मनोरुत्तानपादस्य ध्रुवस्यापि महीपतेः।\nप्रियव्रतस्य राजर्षेरङ्गस्यास्मत्पितुः पितुः॥ ४/२१/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.032.m4a", "display_order": 33}, {"id": 6000085033, "chapter_id": 10085, "verse_number": "४-२१-२८", "content_sanskrit": "ईदृशानामथान्येषामजस्य च भवस्य च।\nप्रह्लादस्य बलेश्चापि कृत्यमस्ति गदाभृतः॥ ४/२१/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.033.m4a", "display_order": 34}, {"id": 6000085034, "chapter_id": 10085, "verse_number": "४-२१-२९", "content_sanskrit": "राज्यस्वर्गापवर्गाणां प्रायेणैकात्महेतुता।\nदौहित्रादीनृते मृत्योः शोच्यान् धर्मविमोहितान्॥ ४/२१/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.034.m4a", "display_order": 35}, {"id": 6000085035, "chapter_id": 10085, "verse_number": "४-२१-३०", "content_sanskrit": "यत्पादसेवाभिरुचिस्तपस्विनामशेषजन्मोपचितं मलं धियः।\nसद्यः क्षिणोत्यन्वहमेधती सती यथा पदाङ्गुष्ठविनिःसृता सरित्॥ ४/२१/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.035.m4a", "display_order": 36}, {"id": 6000085036, "chapter_id": 10085, "verse_number": "४-२१-३१", "content_sanskrit": "विनिर्धुताशेषमनोमलः पुमानसङ्गविज्ञानविशेषवीर्यवान्।\nयदङ्घ्रिमूले कृतकेतनः पुनर्न संसृतिं क्लेशवहां प्रपद्यते॥ ४/२१/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.036.m4a", "display_order": 37}, {"id": 6000085037, "chapter_id": 10085, "verse_number": "४-२१-३२", "content_sanskrit": "तमेव यूयं भजतात्मवृत्तिभिर्मनोवचःकायगुणैः स्वकर्मभिः।\nअमायिनः कामदुघाङ्घ्रिपङ्कजं यथाधिकारावसितार्थसिद्धये॥ ४/२१/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.037.m4a", "display_order": 38}, {"id": 6000085038, "chapter_id": 10085, "verse_number": "४-२१-३३", "content_sanskrit": "असाविहानेकगुणाध्वरैः सता पृथग्विधैर्द्रव्यगुणक्रियोक्तिभिः।\nसम्पद्यतेऽर्थाशयलिङ्गनामभिर्विशुद्धविज्ञानघनस्वरूपतः॥ ४/२१/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.038.m4a", "display_order": 39}, {"id": 6000085039, "chapter_id": 10085, "verse_number": "४-२१-३४", "content_sanskrit": "प्रधानकालाशयकर्मसङ्ग्रहः शरीरशेषं प्रतिपद्य चेतनः।\nक्रियाफलत्वेन विभुर्विभाव्यते यथाऽनलो दारुषु तद्गुणात्मकः॥ ४/२१/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.039.m4a", "display_order": 40}, {"id": 6000085040, "chapter_id": 10085, "verse_number": "४-२१-३५", "content_sanskrit": "अहो बतामी वितरन्त्यनुग्रहं हरिं गुरुं यज्ञभुजामधीश्वरम्।\nस्वधर्मयोगेन यजन्ति मामका निरन्तरं क्षोणितले धृतव्रताः॥ ४/२१/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.040.m4a", "display_order": 41}, {"id": 6000085041, "chapter_id": 10085, "verse_number": "४-२१-३६", "content_sanskrit": "मा जातु तेजः प्रभवेन्महर्द्धिभिस्तितिक्षया तपसा विद्यया च।\nदेदीप्यमानेऽजितदेवतानां कुले स्वयं राजकुले द्विजानाम्॥ ४/२१/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.041.m4a", "display_order": 42}, {"id": 6000085042, "chapter_id": 10085, "verse_number": "४-२१-३७", "content_sanskrit": "ब्रह्मण्यदेवः पुरुषः पुरातनो नित्यं हरिर्यच्चरणाभिवन्दनात्।\nअवाप लक्ष्मीमनपायिनीं यशो जगत्पवित्रं च महत्तमाग्रणीः॥ ४/२१/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.042.m4a", "display_order": 43}, {"id": 6000085043, "chapter_id": 10085, "verse_number": "४-२१-३८", "content_sanskrit": "यत्सेवयाऽशेषगुणाश्रयः स्वराट् विप्रप्रियस्तुष्यति काममीश्वरः।\nतदेव तद्धर्मपरैर्विनीतैः सर्वात्मना ब्रह्मकुलं निषेव्यताम्॥ ४/२१/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.043.m4a", "display_order": 44}, {"id": 6000085044, "chapter_id": 10085, "verse_number": "४-२१-३९", "content_sanskrit": "पुमाल्‍ँलभेताप्यतिवेलमात्मनः प्रसादतोऽत्यन्तशमं स्वतः स्वयम्।\nयन्नित्यसम्बन्धनिषेवया ततः परं किमत्रास्ति सुखं हविर्भुजाम्॥ ४/२१/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.044.m4a", "display_order": 45}, {"id": 6000085045, "chapter_id": 10085, "verse_number": "४-२१-४०", "content_sanskrit": "अश्नात्यनन्तः खलु तत्त्वकोविदैः श्रद्धाहुतं यन्मुख ईड्यनामभिः।\nन वै तथा चेतनया बहिष्कृते हुताशने पारमहंस्यवर्यगुः॥ ४/२१/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.045.m4a", "display_order": 46}, {"id": 6000085046, "chapter_id": 10085, "verse_number": "४-२१-४१", "content_sanskrit": "यद् ब्रह्म नित्यं विरजं सनातनं श्रद्धातपोमङ्गलमौनसंयमैः।\nसमाधिना बिभ्रदिहार्थसिद्धये यत्रेदमादर्श इवावभासते॥ ४/२१/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.046.m4a", "display_order": 47}, {"id": 6000085047, "chapter_id": 10085, "verse_number": "४-२१-४२", "content_sanskrit": "तेषामहं पादसरोजरेणुमार्या वहेयाधिकिरीट आयुः।\nयं नित्यदा बिभ्रत आशुपापं नश्यत्यमुं सर्वगुणा भजन्ति॥ ४/२१/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.047.m4a", "display_order": 48}, {"id": 6000085048, "chapter_id": 10085, "verse_number": "४-२१-४३", "content_sanskrit": "गुणालयं शीलधनं कृतज्ञं श्रद्धाश्रयं संवृणते नु संपदः।\nप्रसीदतां ब्रह्मकुलं गवां च जनार्दनः सानुचरश्च मह्यम्॥ ४/२१/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.048.m4a", "display_order": 49}, {"id": 6000085049, "chapter_id": 10085, "verse_number": null, "content_sanskrit": "मैत्रय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.049.m4a", "display_order": 50}, {"id": 6000085050, "chapter_id": 10085, "verse_number": "४-२१-४४", "content_sanskrit": "इति ब्रुवाणं नृपतिं पितृदेवद्विजातयः।\nतुष्टुवुर्हृष्टमनसः साधुवादेन साधवः॥ ४/२१/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.050.m4a", "display_order": 51, "topics": [{"text": "देवब्राह्मणपितृभिः पृथुचक्रवर्तिनोऽभिनन्दनम्", "range": "४४–५१"}]}, {"id": 6000085051, "chapter_id": 10085, "verse_number": "४-२१-४५", "content_sanskrit": "पुत्रेण जयते लोकानिति सत्यवती श्रुतिः।\nब्रह्मदण्डहतः पापो यद् वेनोऽत्यतरत् तमः॥ ४/२१/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.051.m4a", "display_order": 52}, {"id": 6000085052, "chapter_id": 10085, "verse_number": "४-२१-४६", "content_sanskrit": "हिरण्यकशिपुश्चापि भगवन्निन्दया तमः।\nविविक्षुरत्यगात् सूनोः प्रह्लादस्यानुभावतः॥ ४/२१/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.052.m4a", "display_order": 53}, {"id": 6000085053, "chapter_id": 10085, "verse_number": "४-२१-४७", "content_sanskrit": "वीरवर्य पितः पृथ्व्याः समः संजीव शाश्वतीः।\nयस्येदृश्यच्युते भक्तिः सर्वलोकैकभर्तरि॥ ४/२१/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.053.m4a", "display_order": 54}, {"id": 6000085054, "chapter_id": 10085, "verse_number": "४-२१-४८", "content_sanskrit": "अहो वयं ह्यद्य पवित्रकीर्ते त्वयैव नाथेन मुकुन्दनाथाः।\nयदुत्तमश्लोकतमस्य विष्णोर्ब्रह्मण्यदेवस्य कथां व्यनक्षि॥ ४/२१/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.054.m4a", "display_order": 55}, {"id": 6000085055, "chapter_id": 10085, "verse_number": "४-२१-४९", "content_sanskrit": "नात्यन्तिकमिदं नाथ तव जीव्यानुशासनम्।\nप्रजानुरागो महतां प्रकृतिः करुणात्मनाम्॥ ४/२१/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.055.m4a", "display_order": 56}, {"id": 6000085056, "chapter_id": 10085, "verse_number": "४-२१-५०", "content_sanskrit": "अद्य नस्तमसः पारस्त्वयोपासादितः प्रभो।\nभ्राम्यतां नष्टदृष्टीनां कर्मभिर्दैवसंज्ञितैः॥ ४/२१/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.056.m4a", "display_order": 57}, {"id": 6000085057, "chapter_id": 10085, "verse_number": "४-२१-५१", "content_sanskrit": "नमो विवृद्धसत्त्वाय पुरुषाय महीयसे।\nयो ब्रह्म क्षत्रमाविश्य बिभर्तीदं स्वतेजसा॥ ४/२१/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_021/BhP_04.021.057.m4a", "display_order": 58}, {"id": 6000085058, "chapter_id": 10085, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे एकविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]