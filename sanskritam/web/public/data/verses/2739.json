[{"id": 2082044, "chapter_id": 2739, "verse_number": "१२-२४४-०x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2082045, "chapter_id": 2739, "verse_number": "१२-२४४-१", "content_sanskrit": "एषा पूर्वतरा वृत्तिर्ब्राह्मणस्य विधीयते।\nज्ञानवानेव कर्माणि कुर्वन्सर्वत्र सिद्ध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2082046, "chapter_id": 2739, "verse_number": "१२-२४४-२", "content_sanskrit": "तत्र चेन्न भवेदेवं संशयः कर्मनिश्चये।\nकिंतु कर्मस्वभावोऽयं ज्ञानं कर्मेति वा पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2082047, "chapter_id": 2739, "verse_number": "१२-२४४-३", "content_sanskrit": "तत्र वेदविवित्सायां ज्ञानं चेत्पुरुषं प्रति।\nउपपत्त्युपलब्धिभ्यां वर्णयिष्यामि तच्छॄणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2082048, "chapter_id": 2739, "verse_number": "१२-२४४-४", "content_sanskrit": "पौरुषं कारणं केचिदाहुः कर्मसु मानवाः।\nदैवमेके प्रशंसन्ति स्वभावमपरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2082049, "chapter_id": 2739, "verse_number": "१२-२४४-५", "content_sanskrit": "पौरुषं कर्म दैवं च फलवृत्तिस्वभावतः।\nत्रयमेतत्पृथग्भूतमविवेकं तु केचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2082050, "chapter_id": 2739, "verse_number": "१२-२४४-६", "content_sanskrit": "एतदेवं च नैवं न च चोभे नानुभे तथा।\nकर्मस्था विषयं ब्रूयुः सत्वस्थाः समदर्शिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2082051, "chapter_id": 2739, "verse_number": "१२-२४४-७", "content_sanskrit": "त्रेतायां द्वापरे चैव कलिजाश्च ससंशयाः।\nतपस्विनः प्रशान्ताश्च सत्वस्थाश्च कृते युगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2082052, "chapter_id": 2739, "verse_number": "१२-२४४-८", "content_sanskrit": "अपृथग्दर्शनाः सर्वे ऋक्सामसु यजुःषु च।\nकामद्वषौ पृथग्दृष्ट्वा तपः कृत उपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2082053, "chapter_id": 2739, "verse_number": "१२-२४४-९", "content_sanskrit": "तपोधर्मेण संयुक्तस्तपोनित्यः सुसंशितः।\nतेन सर्वानवाप्नोति कामान्यान्मनसेच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2082054, "chapter_id": 2739, "verse_number": "१२-२४४-१०", "content_sanskrit": "तपसा तदवाप्नोति यद्भूतं सृजते जगत्।\nतद्भूतश्च ततः सर्वभूतानां भवति प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2082055, "chapter_id": 2739, "verse_number": "१२-२४४-११", "content_sanskrit": "तदुक्तं वेदवादेषु गहनं वेददर्शिभिः।\nवेदान्तेषु पुनर्व्यक्तं क्रमयोगेन लक्ष्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2082056, "chapter_id": 2739, "verse_number": "१२-२४४-१२", "content_sanskrit": "आरम्भयज्ञाः क्षव्राश्च हविर्यज्ञा विशः स्मृताः।\nपरिचारयज्ञाः शूद्राश्च जपयज्ञा द्विजातयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2082057, "chapter_id": 2739, "verse_number": "१२-२४४-१३", "content_sanskrit": "परिनिष्ठितकार्यो हि स्वाध्यायेन द्विजो भवेत्।\nकुर्यादन्यन्न वा कुर्यान्मैत्रो ब्राह्मण उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2082058, "chapter_id": 2739, "verse_number": "१२-२४४-१४", "content_sanskrit": "त्रेतादौ सकला वेदा यज्ञा वर्णाश्रमास्तथा।\nसंरोधादायुषस्त्वेते व्यस्यन्ते द्वापरे युगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2082059, "chapter_id": 2739, "verse_number": "१२-२४४-१५", "content_sanskrit": "द्वापरे विप्लवं यान्ति वेदाः कलियुगे तथा।\nदृश्यन्ते नापि दृश्यन्ते कलेरन्ते पुनः किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2082060, "chapter_id": 2739, "verse_number": "१२-२४४-१६", "content_sanskrit": "उत्सीदन्ति स्वधर्माश्च तत्राधर्मेण पीडिताः।\nगवां भूमेश्च ये चापामोषधीनां च ये रसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2082061, "chapter_id": 2739, "verse_number": "१२-२४४-१७", "content_sanskrit": "अधर्मान्तर्हिता वेदा वेदधर्मास्तथाऽऽश्रमाः।\nविक्रियन्ते स्वधर्माश्च स्थावराणि चराणि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2082062, "chapter_id": 2739, "verse_number": "१२-२४४-१८", "content_sanskrit": "यथा सर्वाणि भूतानि वृष्टथा तृप्यन्ति प्रावृषि।\nसृजन्ते सर्वतोऽङ्गानि तथा वेदा युगेयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2082063, "chapter_id": 2739, "verse_number": "१२-२४४-१९", "content_sanskrit": "विहितं कालनानात्वमनादिनिधनं च यत्।\nकीर्तितं यत्पुरस्तात्ते यतः संयान्ति च प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2082064, "chapter_id": 2739, "verse_number": "१२-२४४-२०", "content_sanskrit": "यच्चेदं प्रभवः स्थानं भूतानां संयमो यमः।\nस्वभावेनैव वर्तन्ते द्वन्द्वसृष्टानि भूरिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2082065, "chapter_id": 2739, "verse_number": "१२-२४४-२१", "content_sanskrit": "सर्गः कालो धृतिर्वेदाः कर्ता कार्यं क्रियाफलम्।\nएतत्ते कथितं तात यन्मां त्वं परिपृच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2082066, "chapter_id": 2739, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि चतुश्चत्वारिंशदधिकद्विशततमोऽध्यायः॥ २४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]