[{"id": 2045996, "chapter_id": 2022, "verse_number": "६-७१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2045997, "chapter_id": 2022, "verse_number": "६-७१-१", "content_sanskrit": "दृष्ट्वा भीष्मेण संसक्तान्भ्रातॄनन्यांश्च पार्थिवान् ।\nसमभ्यधावद्गांङ्गेयमुद्यतास्त्रो धनञ्जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2045998, "chapter_id": 2022, "verse_number": "६-७१-२", "content_sanskrit": "पाञ्चजन्यस्य निर्घोषं धनुषो गाण्डिवस्य च।\nध्वजं च दृष्ट्वा पार्थस्य सर्वान्नो भयमाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2045999, "chapter_id": 2022, "verse_number": "६-७१-३", "content_sanskrit": "सिंहलाङ्गूलमाकाशे ज्वलन्तमिव पर्वतम्।\nअसञ्जमानं वृक्षेषु धूमकेतुमिवोत्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2046000, "chapter_id": 2022, "verse_number": "६-७१-४", "content_sanskrit": "बहुवर्णं विचित्रं च दिव्यं वानरलक्षणम् ।\nअपश्याम महाराज ध्वजं गाण्डीवधन्वनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2046001, "chapter_id": 2022, "verse_number": "६-७१-५", "content_sanskrit": "सुवर्णपृष्ठं गाण्डीवं रणे द्रक्ष्यामि भारत।\nविद्युतं मेघमध्यस्थां भ्राजमानामिवाम्बरे ।\nददृशुर्गाण्डिवं योधा रुक्मपृष्ठं महामृधे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2046002, "chapter_id": 2022, "verse_number": "६-७१-६", "content_sanskrit": "आशुश्रुम भृशं चास्य शक्रस्येवाभिगर्जतः।\nसुघोरं तलयोः शब्दं निघ्नतस्तव वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2046003, "chapter_id": 2022, "verse_number": "६-७१-७", "content_sanskrit": "चण्डवातो यथा मेघः सविद्युत्स्तनयित्नुमान् ।\nदिशः संप्लावयन्सर्वाः शरवर्षैः समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2046004, "chapter_id": 2022, "verse_number": "६-७१-८", "content_sanskrit": "समभ्यधावद्गाङ्गेयं भैरवास्त्रो धनञ्जयः ।\nदिशं प्राचीं प्रतीचीं च न जानीमोऽस्त्रमोहिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2046005, "chapter_id": 2022, "verse_number": "६-७१-९", "content_sanskrit": "कान्दिग्भूता श्रान्तपत्रा हताश्वा हतचेतसः।\nअन्योन्यमभिसंश्लिष्य योधास्ते भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2046006, "chapter_id": 2022, "verse_number": "६-७१-१०", "content_sanskrit": "भीष्ममेवाभ्यलीयन्त सह सर्वैस्तवात्मजैः ।\nतेषामार्तायनमभूद्भीष्मः शान्तनवो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2046007, "chapter_id": 2022, "verse_number": "६-७१-११", "content_sanskrit": "समुत्पतन्ति वित्रस्ता रथेभ्यो रथिनस्तथा ।\nसादिनश्चाश्वपृष्ठेभ्यो भूमौ चापि पदातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2046008, "chapter_id": 2022, "verse_number": "६-७१-१२", "content_sanskrit": "श्रुत्वा गाण्डीवनिर्घोषं विस्फूर्जितमिवाशनेः ।\nसर्वसैन्यानि भीतानि व्यवालीयन्त भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2046009, "chapter_id": 2022, "verse_number": "६-७१-१३", "content_sanskrit": "अथ काम्भोजैजरश्वैर्महद्भिः शीघ्रगामिभिः ।\nगोपानां बहुसाहस्त्रैर्बालैर्गापायनैर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2046010, "chapter_id": 2022, "verse_number": "६-७१-१४", "content_sanskrit": "मद्रसौवीरगान्धारैस्त्रैगर्तैश्च विशांपते ।\nसर्वकालिङ्गमुख्यैश्च कलिङ्गाधिपतिर्वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2046011, "chapter_id": 2022, "verse_number": "६-७१-१५", "content_sanskrit": "नानानरगणौघैश्च दुःशासनपुरःसरः ।\nजयद्रथश्च नृपतिः सहितः सर्वराजभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2046012, "chapter_id": 2022, "verse_number": "६-७१-१६", "content_sanskrit": "हयारोहवराश्चैव तव पुत्रेण चोदिताः ।\nचतुर्दशसहस्राणि सौबलं पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2046013, "chapter_id": 2022, "verse_number": "६-७१-१७", "content_sanskrit": "ततस्ते सहिताः सर्वे विभक्तरथवाहनाः ।\nअर्जुनं समरे जघ्नुस्तावका भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2046014, "chapter_id": 2022, "verse_number": "६-७१-१८", "content_sanskrit": "चेदिकाशिपदातैश्च रथैः पाञ्चालसृञ्जयैः ।\nपाण्डवाः सहिताः सर्वे धृष्टद्युम्नपुरोगमाः।\nतावकान्समरे जघ्नुर्धर्मपुत्रेण चोदिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2046015, "chapter_id": 2022, "verse_number": "६-७१-१९", "content_sanskrit": "रथिभिर्वारणैरश्वैः पादातैश्च समीरितम् ।\nघोरमायोधनं चक्रे महाभ्रसदृशं रजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2046016, "chapter_id": 2022, "verse_number": "६-७१-२०", "content_sanskrit": "तोमरप्रासनाराचगजाश्वरथयोधिनाम् ।\nबलेन महता भीष्मः समसञ्जत्किरीटिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2046017, "chapter_id": 2022, "verse_number": "६-७१-२१", "content_sanskrit": "आवन्त्यः काशिराजेन भीमसेनेन सैन्धवः ।\nअजातशत्रुर्मद्राणामृषभेण यशश्विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2046018, "chapter_id": 2022, "verse_number": "६-७१-२२", "content_sanskrit": "सहपुत्रः सहामात्यः शल्येन समसञ्जत।\nविकर्णः सहदेवेन चित्रसेनः शिखण्डिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2046019, "chapter_id": 2022, "verse_number": "६-७१-२३", "content_sanskrit": "मत्स्या दुर्योधनं जग्मुः शंकुनिं न विशांपते।\nद्रुपदश्चेकितानश्च सात्यकिश्चक महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2046020, "chapter_id": 2022, "verse_number": "६-७१-२४", "content_sanskrit": "द्रोणेन समसञ्जन्त सपुत्रेण महात्मना ।\nकृपश्च कृतवर्मा च धृष्टद्युम्नमभिद्रुतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2046021, "chapter_id": 2022, "verse_number": "६-७१-२५", "content_sanskrit": "एवं प्रव्रजिताश्वानि भ्रान्तनागरथानि च।\nसैन्यानि समसञ्जन्त प्रयुद्धानि समन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2046022, "chapter_id": 2022, "verse_number": "६-७१-२६", "content_sanskrit": "निरभ्रे विद्युतस्तीव्रा दिशश्च रजसा वृताः ।\nप्रादुरासन्महोत्काश्च सनिर्घाता विशांपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2046023, "chapter_id": 2022, "verse_number": "६-७१-२७", "content_sanskrit": "प्रादुर्भूतो महावातः पांसुवर्षं पपात च ।\nनभस्यन्तर्दधे सूर्यः सैन्येन सजसा वृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2046024, "chapter_id": 2022, "verse_number": "६-७१-२८", "content_sanskrit": "प्रमोहः सर्वसत्वानामतीव समपद्यत।\nरजसा चाभिभूतानामस्त्रजालैश्च तुद्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2046025, "chapter_id": 2022, "verse_number": "६-७१-२९", "content_sanskrit": "वीरबाहुविसृष्टानां सर्वावरणभेदिनाम् ।\nसंघातः शरजालानां तुमुलः समपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2046026, "chapter_id": 2022, "verse_number": "६-७१-३०", "content_sanskrit": "प्रकाशं चक्रुराकाशमुद्यतानि भुजोत्तमैः ।\nनक्षत्रविमलाभानि शस्त्राणि भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2046027, "chapter_id": 2022, "verse_number": "६-७१-३१", "content_sanskrit": "आर्षभाणि विचित्राणि रुक्मजालावृतानि च ।\nसंपेतुर्दिक्षु सर्वासु चर्माणि भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2046028, "chapter_id": 2022, "verse_number": "६-७१-३२", "content_sanskrit": "सूर्यवर्णैश्च निस्त्रिंशैः पात्यमानानि सर्वशः ।\nदिक्षु सर्वास्वदृश्यन्त शरीराणि शिरांसि च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2046029, "chapter_id": 2022, "verse_number": "६-७१-३३", "content_sanskrit": "भग्नचक्राक्षनीडाश्च निपातितमहाध्वजाः ।\nहताश्वाः पृथिवीं जग्मुस्तत्रतत्र महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2046030, "chapter_id": 2022, "verse_number": "६-७१-३४", "content_sanskrit": "परिपेतुर्हयाश्चात्र केचिच्छस्त्रकृतव्रणाः ।\nरथान्विपरिकर्षन्तो हतेषु रथयोधिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2046031, "chapter_id": 2022, "verse_number": "६-७१-३५", "content_sanskrit": "शराहता भिन्नदेहा बद्धयोक्रा हयोत्तमाः ।\nयुगानि पर्यकर्षन्त तत्रतत्र स्म भारत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2046032, "chapter_id": 2022, "verse_number": "६-७१-३६", "content_sanskrit": "अदृश्यन्त ससूताश्च साश्वाः सरथयोधिनः ।\nएकेन बलिना राजन्वारणेन विमर्दिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2046033, "chapter_id": 2022, "verse_number": "६-७१-३७", "content_sanskrit": "गन्धहस्तिमदस्रावमाघ्राय बहवो रणे।\nसन्निपाते बलौघानां गजैर्ममृदिरे गजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2046034, "chapter_id": 2022, "verse_number": "६-७१-३८", "content_sanskrit": "सतोमरैर्महामात्रैर्निपतद्भिर्गतासुभिः ।\nबभूवायोधनं छन्नं नाराचाभिहतैर्गजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2046035, "chapter_id": 2022, "verse_number": "६-७१-३९", "content_sanskrit": "सन्निपाते बलौघानां प्रेषितैर्वरवारणैः ।\nनिपेतुर्युधि संभग्नाः सयोधाः सध्वजा गजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2046036, "chapter_id": 2022, "verse_number": "६-७१-४०", "content_sanskrit": "नागराजोपमैर्हस्तैर्नागैराक्षिप्य संयुगे ।\nव्यदृश्यन्त महाराज संभग्ना रथकूबराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2046037, "chapter_id": 2022, "verse_number": "६-७१-४१", "content_sanskrit": "विशीर्णरथसङ्घाश्च केशेष्वाक्षिप्य दन्तिभिः ।\nद्रुमशाखा इवाविध्य निष्पिष्टा रथिनो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2046038, "chapter_id": 2022, "verse_number": "६-७१-४२", "content_sanskrit": "रथेषु च रथान्युद्धे संसक्तान्वरवारणाः ।\nविकर्षन्तो दिशः सर्वाः संपेतुः सर्वशब्दगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2046039, "chapter_id": 2022, "verse_number": "६-७१-४३", "content_sanskrit": "तेषां तथा कर्षतां तु गजानां रूपमाबभौ ।\nसरःसु नलिनीजालं विषक्तमिव कर्षताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2046040, "chapter_id": 2022, "verse_number": "६-७१-४४", "content_sanskrit": "एवं संछादितं तत्र बभूवायोधनं महत्।\nसादिभिश्च पदातैश्च सध्वजैश्च महारथैः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2046041, "chapter_id": 2022, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि पञ्चमदिवसयुद्धे एकसप्ततितमोऽध्यायः ॥\nMahabharata - Bhishma Parva - Chapter Footnotes\n६-७१-७ स्तनयित्नुर्गर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]