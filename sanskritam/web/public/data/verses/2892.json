[{"id": 2088613, "chapter_id": 2892, "verse_number": "१३-२२-१", "content_sanskrit": "`भीष्म उवाच।\nविनता तु तथेत्युक्त्वा कृतसंशयना पणे।\nकद्रूरपि तथेत्युक्त्वा पुत्रानिदमुवाच ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2088614, "chapter_id": 2892, "verse_number": "१३-२२-२", "content_sanskrit": "मया कृतः पणः पुत्रा मिथो विनतया सह।\nउच्चैरश्रवसि गान्धर्वे तच्छृणुध्वं भुजङ्गमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2088615, "chapter_id": 2892, "verse_number": "१३-२२-३", "content_sanskrit": "अब्रवं नैकवर्णं तं सैकवर्णमथाब्रवीत्।\nजिता दासी भवेत्पुत्राः सा वाऽहं वा न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2088616, "chapter_id": 2892, "verse_number": "१३-२२-४", "content_sanskrit": "एकवर्णश्च वाजी स चन्द्रकोकनदप्रभः।\nसाऽहं दासी भविष्यामि जिता पुत्रा न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2088617, "chapter_id": 2892, "verse_number": "१३-२२-५", "content_sanskrit": "ते यूयमश्वप्रवरमाविशध्वमतन्द्रिताः।\nसर्वश्वेतं वालधिषु वाला भूत्वाञ्जनप्रभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2088618, "chapter_id": 2892, "verse_number": "१३-२२-५x", "content_sanskrit": "सर्पा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2088619, "chapter_id": 2892, "verse_number": "१३-२२-६", "content_sanskrit": "निकृत्या न जयः श्रेयान्मातः सत्या गिरः शृणु।\nआयत्यां च तदात्वे च न च धर्मोऽत्र विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2088620, "chapter_id": 2892, "verse_number": "१३-२२-७", "content_sanskrit": "सा त्वं धर्मादपेतं वै कुलस्यैवाहितं तव।\nनिकृत्या विजयं मातर्मा स्म कार्षीः कथञ्चना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2088621, "chapter_id": 2892, "verse_number": "१३-२२-८", "content_sanskrit": "यद्यधर्मेण विजयं वयं काङ्क्षामहे क्वचित्।\nत्वया नाम निवार्याः स्म मा कुरुध्वमिति ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2088622, "chapter_id": 2892, "verse_number": "१३-२२-९", "content_sanskrit": "सा त्वमस्मानपि सतो विपापानृजुबुद्धिनः।\nकल्मषेणाभिसंयोक्तुं काङ्क्षसे लोभमोहिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2088623, "chapter_id": 2892, "verse_number": "१३-२२-१०", "content_sanskrit": "ते वयं त्वां परित्यज्य द्रविष्याम दिशो दश।\nयत्र वाक्यं न ते मातः पुनः श्रोष्याम ईदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2088624, "chapter_id": 2892, "verse_number": "१३-२२-११", "content_sanskrit": "गुरोरप्यवलिप्तस्य कार्याकार्यमजानतः।\nउत्पथं प्रतिपन्नस्य परित्यागो विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2088625, "chapter_id": 2892, "verse_number": "१३-२२-१२x", "content_sanskrit": "कद्रूरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2088626, "chapter_id": 2892, "verse_number": "१३-२२-१२", "content_sanskrit": "शृणोमि विविधा वाचो हेतुमत्यः समीरिताः।\nवक्रमार्गनिवृत्त्यर्थं तदहं वो न रोचये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2088627, "chapter_id": 2892, "verse_number": "१३-२२-१३", "content_sanskrit": "न च तत्पणितं मन्दाः शक्यं जेतुमतोऽन्वथा।\nजिते निकृत्या श्रुत्वैतत्क्षेमं कुरुत पुत्रकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2088628, "chapter_id": 2892, "verse_number": "१३-२२-१४", "content_sanskrit": "श्वोऽहं प्रभातसमये जिता धर्मेण पुत्रकाः।\nशैलूषिणी भविष्यामि विनताया न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2088629, "chapter_id": 2892, "verse_number": "१३-२२-१५", "content_sanskrit": "इह चामुत्र चार्थाय पुत्रानिच्छन्ति मातरः।\nसेयमीहा विपन्ना मे युष्मानासाद्य सङ्गताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2088630, "chapter_id": 2892, "verse_number": "१३-२२-१६", "content_sanskrit": "इह वा तारयेत्पुत्रः प्रेत्य वा तारयेत्पितॄन्।\nमात्र चित्रं भवेकिञ्चित्पुनातीति च पुत्रकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2088631, "chapter_id": 2892, "verse_number": "१३-२२-१७", "content_sanskrit": "ते यूयं तारणार्थाय मम पुत्रा मनोजवाः।\nआविशध्वं हयश्रेष्ठं वाला भूत्वाऽञ्जनप्रभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2088632, "chapter_id": 2892, "verse_number": "१३-२२-१८", "content_sanskrit": "जानाम्यधर्मं सकलं विजिता विनता भवेत्।\nनिकृत्या दासभावस्तु युष्मानप्यवपीडयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2088633, "chapter_id": 2892, "verse_number": "१३-२२-१९", "content_sanskrit": "निकृत्या विजयो वेति दासत्वं वा पराभवे।\nउभयं निश्चयं कृत्वा जयो वै धार्मिको वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2088634, "chapter_id": 2892, "verse_number": "१३-२२-२०", "content_sanskrit": "यद्यप्यधर्मो विजयो युष्मानेव स्पृशेत्पुनः।\nगुरोर्वचनमास्थाय धर्मो वा सम्भविष्यति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2088635, "chapter_id": 2892, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्वाविंशोऽध्यायः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]