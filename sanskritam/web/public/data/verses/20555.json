[{"id": 7000555000, "chapter_id": 20555, "verse_number": "५-१४-१", "content_sanskrit": "शेष उवाच ।\nअथ स्वागतसंतुष्टं शत्रुघ्नं प्राह भूमिपः ।\nरघुनाथकथां श्रेष्ठां शुश्रूषुः पुरुषर्षभः ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000555001, "chapter_id": 20555, "verse_number": "५-१४-२", "content_sanskrit": "सुमद उवाच ।\nकच्चिदास्ते सुखं रामः सर्वलोकशिरोमणिः ।\nभक्तरक्षावतारोऽयं ममानुग्रहकारकः ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000555002, "chapter_id": 20555, "verse_number": "५-१४-३", "content_sanskrit": "धन्या लोका इमे पुर्यां रघुनाथमुखांबुजम् ।\nये पिबंत्यनिशं चाक्षिपुटकैः परिमोदिताः ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000555003, "chapter_id": 20555, "verse_number": "५-१४-४", "content_sanskrit": "अर्थजातं मदीयं च नितरां पुरुषर्षभ ।\nकृतार्थं कुलभूम्यादि वस्तुजातं महामते ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000555004, "chapter_id": 20555, "verse_number": "५-१४-५", "content_sanskrit": "कामाक्षया प्रसादो मे कृतः पूर्वं दयार्द्रया ।\nरघुनाथमुखांभोजं द्रक्ष्येद्य सकुटुंबकः ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000555005, "chapter_id": 20555, "verse_number": "५-१४-६", "content_sanskrit": "इत्युक्तवति वीरे तु सुमदे पार्थिवोत्तमे ।\nसर्वं तत्कथयामास रघुनाथगुणोदयम् ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000555006, "chapter_id": 20555, "verse_number": "५-१४-७", "content_sanskrit": "त्रिरात्रं तत्र संस्थित्य रघुनाथानुजः परम् ।\nगंतुं चकार धिषणां राज्ञा सह महामतिः ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000555007, "chapter_id": 20555, "verse_number": "५-१४-८", "content_sanskrit": "तज्ज्ञात्वा सुमदः शीघ्रं पुत्रं राज्येऽभ्यषेचयत् ।\nशत्रुघ्नेन महाराज्ञा पुष्कलेनानुमोदितः ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000555008, "chapter_id": 20555, "verse_number": "५-१४-९", "content_sanskrit": "वासांसि बहुरत्नानि धनानि विविधानि च ।\nशत्रुघ्नसेवकेभ्योऽसौ प्रादात्तत्र महामतिः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000555009, "chapter_id": 20555, "verse_number": "५-१४-१०", "content_sanskrit": "ततो गमनमारेभे मंत्रिभिर्बहुवित्तमैः ।\nपत्तिभिर्वाजिभिर्नागैः सदश्वैरथ कोटिभिः ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000555010, "chapter_id": 20555, "verse_number": "५-१४-११", "content_sanskrit": "शत्रुघ्नः सहितस्तेन सुमदेन धनुर्भृता ।\nजगाम मार्गे विहसन्रघुनाथप्रतापभृत् ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000555011, "chapter_id": 20555, "verse_number": "५-१४-१२", "content_sanskrit": "पयोष्णीतीरमासाद्य जगाम स हयोत्तमः ।\nपृष्ठतोऽनुययुः सर्वे योधा वै हयरक्षिणः ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000555012, "chapter_id": 20555, "verse_number": "५-१४-१३", "content_sanskrit": "आश्रमान्विविधान्पश्यन्नृषीणां सुतपोभृताम् ।\nतत्रतत्र विशृण्वानो रघुनाथगुणोदयम् ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000555013, "chapter_id": 20555, "verse_number": "५-१४-१४", "content_sanskrit": "एष धीमान्हरिर्याति हरिणा परिरक्षितः ।\nहरिभिर्हरिभक्तैश्च हरिवर्यानुगैर्मुहुः ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000555014, "chapter_id": 20555, "verse_number": "५-१४-१५", "content_sanskrit": "इति शृण्वञ्छुभा वाचो मुनीनां परितः प्रभुः ।\nतुतोष भक्त्युत्कलितचित्तवृत्तिभृतां महान् ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000555015, "chapter_id": 20555, "verse_number": "५-१४-१६", "content_sanskrit": "ददर्श चाश्रमं शुद्धं जनजंतुसमाकुलम् ।\nवेदध्वनिहताशेषा मंगलं शृण्वतां नृणाम् ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000555016, "chapter_id": 20555, "verse_number": "५-१४-१७", "content_sanskrit": "अग्निहोत्रहविर्धूम पवित्रितनभोखिलम् ।\nमुनिवर्यकृतानेक यागयूपसुशोभितम् ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000555017, "chapter_id": 20555, "verse_number": "५-१४-१८", "content_sanskrit": "यत्र गावस्तु हरिणा पाल्यंते पालनोचिताः ।\nमूषका न खनंत्यस्मिन्बिडालस्य भयाद्बिलम् ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000555018, "chapter_id": 20555, "verse_number": "५-१४-१९", "content_sanskrit": "मयूरैर्नकुलैः सार्द्धं क्रीडंति फणिनोनिशम् ।\nगजैः सिंहैर्नित्यमत्र स्थीयते मित्रतां गतैः ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000555019, "chapter_id": 20555, "verse_number": "५-१४-२०", "content_sanskrit": "एणास्तत्रत्य नीवारभक्षणेषु कृतादराः ।\nन भयं कुर्वते कालाद्रक्षिता मुनिवृंदकैः ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000555020, "chapter_id": 20555, "verse_number": "५-१४-२१", "content_sanskrit": "गावः कुंभसमोधस्का नंदिनी समविग्रहाः ।\nकुर्वंति चरणोत्थेन रजसेलां पवित्रिताम् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000555021, "chapter_id": 20555, "verse_number": "५-१४-२२", "content_sanskrit": "मुनिवर्याः समित्पाणि पद्मैर्धर्मक्रियोचिताम् ।\nदृष्ट्वा पप्रच्छसुमतिं सर्वज्ञं राम मंत्रिणम् ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000555022, "chapter_id": 20555, "verse_number": "५-१४-२३", "content_sanskrit": "शत्रुघ्न उवाच ।\nसुमते कस्य संस्थानं मुनेर्भाति पुरोगतम् ।\nनिर्वैरिजंतु संसेव्यं मुनिवृंदसमाकुलम् ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000555023, "chapter_id": 20555, "verse_number": "५-१४-२४", "content_sanskrit": "श्रोष्यामि मुनिवार्तां च विदधामि पवित्रताम् ।\nनिजं वपुस्तदीयाभिर्वार्ताभिर्वर्णनादिभिः ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000555024, "chapter_id": 20555, "verse_number": "५-१४-२५", "content_sanskrit": "इति श्रुत्वा महद्वाक्यं शत्रुघ्नस्य महात्मनः ।\nकथयामास सचिवो रघुनाथस्य धीमतः ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000555025, "chapter_id": 20555, "verse_number": "५-१४-२६", "content_sanskrit": "सुमतिरुवाच ।\nच्यवनस्याश्रमं विद्धि महातापसशोभितम् ।\nनिर्वैरिजंतुसंकीर्णं मुनिपत्नीभिरावृतम् ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000555026, "chapter_id": 20555, "verse_number": "५-१४-२७", "content_sanskrit": "योऽसौ महामुनिः स्वर्गवैद्ययोर्भागमादधात् ।\nस्वायंभुवमहायज्ञे शक्रमानविभेदनः ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000555027, "chapter_id": 20555, "verse_number": "५-१४-२८", "content_sanskrit": "महामुनेः प्रभावोऽयं न केनापि समाप्यते ।\nतपोबलसमृद्धस्य वेदमूर्तिधरस्य ह ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000555028, "chapter_id": 20555, "verse_number": "५-१४-२९", "content_sanskrit": "श्रुत्वा रामानुजो वार्तां च्यवनस्य महामुनेः ।\nसर्वं पप्रच्छ सुमतिं शक्रमानादिभंजनम् ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000555029, "chapter_id": 20555, "verse_number": "५-१४-३०", "content_sanskrit": "शत्रुघ्न उवाच ।\nकदासौ दस्रयोर्भागं चकार सुरपंक्तिषु ।\nकिं कृतं देवराजेन स्वायंभुव महामखे ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000555030, "chapter_id": 20555, "verse_number": "५-१४-३१", "content_sanskrit": "सुमतिरुवाच ।\nब्रह्मवंशेऽतिविख्यातो मुनिर्भृगुरिति श्रुतः ।\nकदाचिद्गतवान्सायं समिदाहरणं प्रति ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000555031, "chapter_id": 20555, "verse_number": "५-१४-३२", "content_sanskrit": "तदा मखविनाशाय दमनो राक्षसो बली ।\nआगत्योच्चैर्जगादेदं महाभयकरं वचः ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000555032, "chapter_id": 20555, "verse_number": "५-१४-३३", "content_sanskrit": "कुत्रास्ति मुनिबंधुः स कुत्र तन्महिलानघा ।\nपुनः पुनरुवाचेदं वचो रोषसमाकुलः ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000555033, "chapter_id": 20555, "verse_number": "५-१४-३४", "content_sanskrit": "तदाहुतवहो ज्ञात्वा राक्षसाद्भयमागतम् ।\nदर्शयामास तज्जायामंतर्वत्नीमनिंदिताम् ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000555034, "chapter_id": 20555, "verse_number": "५-१४-३५", "content_sanskrit": "जहार राक्षसस्तां तु रुदंतीं कुररीमिव ।\nभृगो रक्षपते रक्ष रक्ष नाथ तपोनिधे ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000555035, "chapter_id": 20555, "verse_number": "५-१४-३६", "content_sanskrit": "एवं वदंतीमार्तां तां गृहीत्वा निरगाद्बहिः ।\nदुष्टो वाक्यप्रहारेण बोधयन्स भृगोः सतीम् ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000555036, "chapter_id": 20555, "verse_number": "५-१४-३७", "content_sanskrit": "ततो महाभयत्रस्तो गर्भश्चोदरमध्यतः ।\nपपात प्रज्वलन्नेत्रो वैश्वानर इवांगजः ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000555037, "chapter_id": 20555, "verse_number": "५-१४-३८", "content_sanskrit": "तेनोक्तं मा व्रजाशु त्वं भस्मी भव सुदुर्मते ।\nन हि साध्वी परामर्शं कृत्वा श्रेयोऽधियास्यसि ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000555038, "chapter_id": 20555, "verse_number": "५-१४-३९", "content_sanskrit": "इत्युक्तः स पपाताशु भस्मीभूतकलेवरः ।\nमाता तदार्भकं नीत्वा जगामाश्रममुन्मनाः ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000555039, "chapter_id": 20555, "verse_number": "५-१४-४०", "content_sanskrit": "भृगुर्वह्निकृतं सर्वं ज्ञात्वा कोपसमाकुलः ।\nशशाप सर्वभक्षस्त्वं भव दुष्टारिसूचक ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000555040, "chapter_id": 20555, "verse_number": "५-१४-४१", "content_sanskrit": "तदा शप्तोऽतिदुःखार्तो जग्राहांघ्र्याशुशुक्षणिः ।\nकुरु मेऽनुग्रहं स्वामिन्कृपार्णव महामते ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000555041, "chapter_id": 20555, "verse_number": "५-१४-४२", "content_sanskrit": "मयानृतं वचोभीत्या कथितं न गुरुद्रुहा ।\nतस्मान्ममोपरि कृपां कुरु धर्मशिरोमणे ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000555042, "chapter_id": 20555, "verse_number": "५-१४-४३", "content_sanskrit": "तदानुग्रहमाधाच्च सर्वभक्षो भवाञ्छुचिः ।\nइत्युक्तवान्हुतभुजं दयार्द्रो मुनितापसः ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000555043, "chapter_id": 20555, "verse_number": "५-१४-४४", "content_sanskrit": "गर्भाच्च्युतस्य पुत्रस्य जातकर्मादिकं शुचिः ।\nचकार विधिवद्विप्रो दर्भपाणिः सुमंगलः ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000555044, "chapter_id": 20555, "verse_number": "५-१४-४५", "content_sanskrit": "च्यवनाच्च्यवनं प्राहुः पुत्रं सर्वे तपस्विनः ।\nशनैःशनैः स ववृधे शुक्ले प्रतिपदिंदुवत् ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000555045, "chapter_id": 20555, "verse_number": "५-१४-४६", "content_sanskrit": "स जगाम तपः कर्तुं रेवां लोकैकपावनीम् ।\nशिष्यैः परिवृतः सर्वैस्तपोबलसमन्वितैः ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000555046, "chapter_id": 20555, "verse_number": "५-१४-४७", "content_sanskrit": "गत्वा तत्र तपस्तेपे वर्षाणामयुतं महान् ।\nअंसयोः किंशुकौ जातौ वल्मीकोपरिशोभितौ ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000555047, "chapter_id": 20555, "verse_number": "५-१४-४८", "content_sanskrit": "मृगा आगत्य तस्यांगे कंडूं विदधुरुत्सुकाः ।\nन किंचित्स हि जानाति दुर्वारतपसावृतः ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000555048, "chapter_id": 20555, "verse_number": "५-१४-४९", "content_sanskrit": "कदाचिन्मनुरुद्युक्तस्तीर्थयात्रां प्रति प्रभुः ।\nसकुटुंबो ययौ रेवां महाबलसमावृतः ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000555049, "chapter_id": 20555, "verse_number": "५-१४-५०", "content_sanskrit": "तत्र स्नात्वा महानद्यां संतर्प्य पितृदेवताः ।\nदानानि ब्राह्मणेभ्यश्च प्रादाद्विष्णुप्रतुष्टये ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000555050, "chapter_id": 20555, "verse_number": "५-१४-५१", "content_sanskrit": "तत्कन्या विचरंती सा वनमध्ये इतस्ततः ।\nसखीभिः सहिता रम्या तप्तहाटकभूषणा ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000555051, "chapter_id": 20555, "verse_number": "५-१४-५२", "content_sanskrit": "तत्र दृष्ट्वाथ वल्मीकं महातरुसुशोभितम् ।\nनिमेषोन्मेषरहितं तेजः किंचिद्ददर्श सा ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000555052, "chapter_id": 20555, "verse_number": "५-१४-५३", "content_sanskrit": "गत्वा तत्र शलाकाभिरतुदद्रुधिरं स्रवत् ।\nदृष्ट्वा राज्ञांगजा खेदं प्राप्तवत्यतिदुःखिता ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000555053, "chapter_id": 20555, "verse_number": "५-१४-५४", "content_sanskrit": "न जनन्यै तथा पित्रे शशंसाघेन विप्लुता ।\nस्वयमेवात्मनात्मानं सा शुशोच भयातुरा ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000555054, "chapter_id": 20555, "verse_number": "५-१४-५५", "content_sanskrit": "तदा भूश्चलिता राजन्दिवश्चोल्का पपात ह ।\nधूम्रा दिशो भवन्सर्वाः सूर्यश्च परिवेषितः ॥५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000555055, "chapter_id": 20555, "verse_number": "५-१४-५६", "content_sanskrit": "तदा राज्ञो हया नष्टा हस्तिनो बहवो मृताः ।\nधनं नष्टं रत्नयुतं कलहोभून्मिथस्तदा ॥५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000555056, "chapter_id": 20555, "verse_number": "५-१४-५७", "content_sanskrit": "तदालोक्य नृपो भीतः किंचिदुद्विग्नमानसः ।\nजनानपृच्छत्केनापि मुनये त्वपराधितम् ॥५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000555057, "chapter_id": 20555, "verse_number": "५-१४-५८", "content_sanskrit": "पारंपर्येण तज्ज्ञात्वा स्वपुत्र्याः परिचेष्टितम् ।\nययौ सुदुःखितस्तत्र समृद्धबलवाहनः ॥५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000555058, "chapter_id": 20555, "verse_number": "५-१४-५९", "content_sanskrit": "तं वै तपोनिधिं वीक्ष्य महता तपसायुतम् ।\nस्तुत्वा प्रसादयामास मुनिवर्य दयां कुरु ॥५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000555059, "chapter_id": 20555, "verse_number": "५-१४-६०", "content_sanskrit": "तस्मै तुष्टो जगादायं मुनिवर्यो महातपाः ।\nतवात्मजाकृतं सर्वमुत्पाताद्यमवेहि तत् ॥६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000555060, "chapter_id": 20555, "verse_number": "५-१४-६१", "content_sanskrit": "तव पुत्र्या महाराज चक्षुर्विस्फोटनं कृतम् ।\nबहुसुस्राव रुधिरं जानती त्वामुवाच न ॥६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000555061, "chapter_id": 20555, "verse_number": "५-१४-६२", "content_sanskrit": "तस्मादियं महाभूप मह्यं देया यथाविधि ।\nततश्चोत्पातशमनं भविष्यति न संशयः ॥६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000555062, "chapter_id": 20555, "verse_number": "५-१४-६३", "content_sanskrit": "तच्छ्रुत्वा दुःखितो राजा प्रज्ञाचाक्षुष आत्मजाम् ।\nददौ कुलवयोरूप शीललक्षणसंयुताम् ॥६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000555063, "chapter_id": 20555, "verse_number": "५-१४-६४", "content_sanskrit": "दत्ता यदा नृपेणेयं कन्या कमललोचना ।\nतदोत्पाताः शमं याताः सर्वे मुनिरुषोद्गताः ॥६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000555064, "chapter_id": 20555, "verse_number": "५-१४-६५", "content_sanskrit": "राजा दत्त्वात्मजां तस्मै मुनये तपसांनिधे ।\nप्राप स्वां नगरीं भूयो दुःखितोऽयं दयायुतः ॥६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]