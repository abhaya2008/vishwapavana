[{"id": 7001458000, "chapter_id": 21458, "verse_number": "७-१-३१-१", "content_sanskrit": "वायुरुवाच ।\nस्थने संशयितं विप्रा भवद्भिर्हेतुचोदितैः ।\nजिज्ञासा हि न नास्तिक्यं साधयेत्साधुबुद्धिषु॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001458001, "chapter_id": 21458, "verse_number": "७-१-३१-२", "content_sanskrit": "प्रमणमत्र वक्ष्यामि सताम्मोहनिवर्तकम् ।\nअसतां त्वन्यथाभावः प्रसादेन विना प्रभोः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001458002, "chapter_id": 21458, "verse_number": "७-१-३१-३", "content_sanskrit": "शिवस्य परिपूर्णस्य परानुग्रहमन्तरा ।\nन किंचिदपि कर्तव्यमिति साधु विनिश्चितम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001458003, "chapter_id": 21458, "verse_number": "७-१-३१-४", "content_sanskrit": "स्वभाव एव पर्याप्तः परानुग्रहकर्मणि ।\nअन्यथा निस्स्वभवेन न किमप्यनुगृह्यते॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001458004, "chapter_id": 21458, "verse_number": "७-१-३१-५", "content_sanskrit": "परं सर्वमनुग्राह्यं पशुपाशात्मकं जगत् ।\nपरस्यानुग्रहार्थं तु पत्युराज्ञासमन्वयः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001458005, "chapter_id": 21458, "verse_number": "७-१-३१-६", "content_sanskrit": "पतिराज्ञापकः सर्वमनुगृह्णाति सर्वदा ।\nतदर्थमर्थस्वीकारे परतंत्रः कथं शिवः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001458006, "chapter_id": 21458, "verse_number": "७-१-३१-७", "content_sanskrit": "अनुग्राह्यनपेक्षो ऽस्ति न हि कश्चिदनुग्रहः ।\nअतः स्वातन्त्र्यशब्दार्थाननपेक्षत्वलक्षणः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001458007, "chapter_id": 21458, "verse_number": "७-१-३१-८", "content_sanskrit": "एतत्पुनरनुग्राह्यं परतंत्रं तदिष्यते ।\nअनुग्रहादृते तस्य भुक्तिमुक्त्योरनन्वयात्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001458008, "chapter_id": 21458, "verse_number": "७-१-३१-९", "content_sanskrit": "मूर्तात्मनो ऽप्यनुग्राह्या शिवाज्ञाननिवर्तनात् ।\nअज्ञानाधिष्ठितं शम्भोर्न किंचिदिह विद्यते॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001458009, "chapter_id": 21458, "verse_number": "७-१-३१-१०", "content_sanskrit": "येनोपलभ्यते ऽस्माभिस्सकलेनापि निष्कलः ।\nस मूर्त्यात्मा शिवः शैवमूर्तिरित्युपचर्यते॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001458010, "chapter_id": 21458, "verse_number": "७-१-३१-११", "content_sanskrit": "न ह्यसौ निष्कलः साक्षाच्छिवः परमकारणम् ।\nसाकारेणानुभावेन केनाप्यनुपलक्षितः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001458011, "chapter_id": 21458, "verse_number": "७-१-३१-१२", "content_sanskrit": "प्रमाणगम्यतामात्रं तत्स्वभावोपपादकम् ।\nन तावतात्रोपेक्षाधीरुपलक्षणमंतरा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001458012, "chapter_id": 21458, "verse_number": "७-१-३१-१३", "content_sanskrit": "आत्मोपमोल्वणं साक्षान्मूर्तिरेव हि काचन ।\nशिवस्य मूर्तिर्मूर्त्यात्मा परस्तस्योपलक्षणम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001458013, "chapter_id": 21458, "verse_number": "७-१-३१-१४", "content_sanskrit": "यथा काष्ठेष्वनारूढो न वह्निरुपलभ्यते ।\nएवं शिवो ऽपि मूर्त्यात्मन्यनारूढ इति स्थितिः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001458014, "chapter_id": 21458, "verse_number": "७-१-३१-१५", "content_sanskrit": "यथाग्निमानयेत्युक्ते ज्वलत्काष्ठादृते स्वयम् ।\nनाग्निरानीयते तद्वत्पूज्यो मूर्त्यात्मना शिवः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001458015, "chapter_id": 21458, "verse_number": "७-१-३१-१६", "content_sanskrit": "अत एव हि पूजादौ मूर्त्यात्मपरिकल्पनम् ।\nमूर्त्यात्मनि कृतं साक्षाच्छिव एव कृतं यतः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001458016, "chapter_id": 21458, "verse_number": "७-१-३१-१७", "content_sanskrit": "लिंगादावपि तत्कृत्यमर्चायां च विशेषतः ।\nतत्तन्मूर्त्यात्मभावेन शिवो ऽस्माभिरुपास्यते॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001458017, "chapter_id": 21458, "verse_number": "७-१-३१-१८", "content_sanskrit": "यथानुगृह्यते सो ऽपि मूर्त्यात्मा पारमेष्ठिना ।\nतथा मूर्त्यात्मनिष्ठेन शिवेन पशवो वयम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001458018, "chapter_id": 21458, "verse_number": "७-१-३१-१९", "content_sanskrit": "लोकानुग्रहणायैव शिवेन परमेष्ठिना ।\nसदाशिवादयस्सर्वे मूर्त्यात्मनो ऽप्यधिष्ठिताः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001458019, "chapter_id": 21458, "verse_number": "७-१-३१-२०", "content_sanskrit": "आत्मनामेव भोगाय मोक्षाय च विशेषतः ।\nतत्त्वातत्त्वस्वरूपेषु मूर्त्यात्मसु शिवान्वयः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001458020, "chapter_id": 21458, "verse_number": "७-१-३१-२१", "content_sanskrit": "भोगः कर्मविपाकात्मा सुखदुःखात्मको मतः ।\nन च कर्म शिवो ऽस्तीति तस्य भोगः किमात्मकः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001458021, "chapter_id": 21458, "verse_number": "७-१-३१-२२", "content_sanskrit": "सर्वं शिवो ऽनुगृह्णाति न निगृह्णाति किंचन ।\nनिगृह्णतां तु ये दोषाश्शिवे तेषामसंभवात्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001458022, "chapter_id": 21458, "verse_number": "७-१-३१-२३", "content_sanskrit": "ये पुनर्निग्रहाः केचिद्ब्रह्मादिषु निदर्शिताः ।\nते ऽपि लोकहितायैव कृताः श्रीकण्ठमूर्तिना॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001458023, "chapter_id": 21458, "verse_number": "७-१-३१-२४", "content_sanskrit": "ब्रह्माण्डस्याधिपत्यं हि श्रीकण्ठस्य न संशयः ।\nश्रीकण्ठाख्यां शिवो मूर्तिं क्रीडतीमधितिष्ठति॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001458024, "chapter_id": 21458, "verse_number": "७-१-३१-२५", "content_sanskrit": "सदोषा एव देवाद्या निगृहीता यथोदितम् ।\nततस्तेपि विपाप्मानः प्रजाश्चापि गतज्वराः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001458025, "chapter_id": 21458, "verse_number": "७-१-३१-२६", "content_sanskrit": "निग्रहो ऽपि स्वरूपेण विदुषां न जुगुप्सितः ।\nअत एव हि दण्ड्येषु दण्डो राज्ञां प्रशस्यते॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001458026, "chapter_id": 21458, "verse_number": "७-१-३१-२७", "content_sanskrit": "यत्सिद्धिरीश्वरत्वेन कार्यवर्गस्य कृत्स्नशः ।\nन स चेदीशतां कुर्याज्जगतः कथमीश्वरः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001458027, "chapter_id": 21458, "verse_number": "७-१-३१-२८", "content_sanskrit": "ईशेच्छा च विधातृत्वं विधेराज्ञापनं परम् ।\nआज्ञावश्यमिदं कुर्यान्न कुर्यादिति शासनम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001458028, "chapter_id": 21458, "verse_number": "७-१-३१-२९", "content_sanskrit": "तच्छासनानुवर्तित्वं साधुभावस्य लक्षणम् ।\nविपरीतसमाधोः स्यान्न सर्वं तत्तु दृश्यते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001458029, "chapter_id": 21458, "verse_number": "७-१-३१-३०", "content_sanskrit": "साधु संरक्षणीयं चेद्विनिवर्त्यमसाधु यत् ।\nनिवर्तते च सामादेरंते दण्डो हि साधनम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001458030, "chapter_id": 21458, "verse_number": "७-१-३१-३१", "content_sanskrit": "हितार्थलक्षणं चेदं दण्डान्तमनुशासनम् ।\nअतो यद्विपरीतं तदहितं संप्रचक्षते॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001458031, "chapter_id": 21458, "verse_number": "७-१-३१-३२", "content_sanskrit": "हिते सदा निषण्णानामीश्वरस्य निदर्शनम् ।\nस कथं दुष्यते सद्भिरसतामेव निग्रहात्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001458032, "chapter_id": 21458, "verse_number": "७-१-३१-३३", "content_sanskrit": "अयुक्तकारिणो लोके गर्हणीयाविवेकिता ।\nयदुद्वेजयते लोकन्तदयुक्तं प्रचक्षते॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001458033, "chapter_id": 21458, "verse_number": "७-१-३१-३४", "content_sanskrit": "सर्वो ऽपि निग्रहो लोके न च विद्वेषपूर्वकः ।\nन हि द्वेष्टि पिता पुत्रं यो निगृह्याति शिक्षयेत्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001458034, "chapter_id": 21458, "verse_number": "७-१-३१-३५", "content_sanskrit": "माध्यस्थेनापि निग्राह्यान्यो निगृह्णाति मार्गतः ।\nतस्याप्यवश्यं यत्किंचिन्नैर्घृण्यमनुवर्तते॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001458035, "chapter_id": 21458, "verse_number": "७-१-३१-३६", "content_sanskrit": "अन्यथा न हिनस्त्येव सदोषानप्यसौ परान् ।\nहिनस्ति चायमप्यज्ञान्परं माध्यस्थ्यमाचरन्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001458036, "chapter_id": 21458, "verse_number": "७-१-३१-३७", "content_sanskrit": "तस्माद्दुःखात्मिकां हिंसां कुर्वाणो यः सनिर्घृणः ।\nइति निर्बंधयंत्येके नियमो नेति चापरे॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001458037, "chapter_id": 21458, "verse_number": "७-१-३१-३८", "content_sanskrit": "निदानज्ञस्य भिषजो रुग्णो हिंसां प्रयुंजतः ।\nन किंचिदपि नैर्घृण्यं घृणैवात्र प्रयोजिका॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001458038, "chapter_id": 21458, "verse_number": "७-१-३१-३९", "content_sanskrit": "घृणापि न गुणायैव हिंस्रेषु प्रतियोगिषु ।\nतादृशेषु घृणी भ्रान्त्या घृणान्तरितनिर्घृणः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001458039, "chapter_id": 21458, "verse_number": "७-१-३१-४०", "content_sanskrit": "उपेक्षापीह दोषाह रक्ष्येषु प्रतियोगिषु ।\nशक्तौ सत्यामुपेक्षातो रक्ष्यस्सद्यो विपद्यते॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001458040, "chapter_id": 21458, "verse_number": "७-१-३१-४१", "content_sanskrit": "सर्पस्यास्यगतम्पश्यन्यस्तु रक्ष्यमुपेक्षते ।\nदोषाभासान्समुत्प्रेक्ष्य फलतः सो ऽपि निर्घृणः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001458041, "chapter_id": 21458, "verse_number": "७-१-३१-४२", "content_sanskrit": "तस्माद्घृणा गुणायैव सर्वथेति न संमतम् ।\nसंमतं प्राप्तकामित्वं सर्वं त्वन्यदसम्मतम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001458042, "chapter_id": 21458, "verse_number": "७-१-३१-४३", "content_sanskrit": "मूर्त्यात्मस्वपि रागाद्या दोषाः सन्त्येव वस्तुतः ।\nतथापि तेषामेवैते न शिवस्य तु सर्वथा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001458043, "chapter_id": 21458, "verse_number": "७-१-३१-४४", "content_sanskrit": "अग्नावपि समाविष्टं ताम्रं खलु सकालिकम् ।\nइति नाग्निरसौ दुष्येत्ताम्रसंसर्गकारणात्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001458044, "chapter_id": 21458, "verse_number": "७-१-३१-४५", "content_sanskrit": "नाग्नेरशुचिसंसर्गादशुचित्वमपेक्षते ।\nअशुचेस्त्वग्निसंयोगाच्छुचित्वमपि जायते॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001458045, "chapter_id": 21458, "verse_number": "७-१-३१-४६", "content_sanskrit": "एवं शोध्यात्मसंसर्गान्न ह्यशुद्धः शिवो भवेत् ।\nशिवसंसर्गतस्त्वेष शोध्यात्मैव हि शुध्यति॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001458046, "chapter_id": 21458, "verse_number": "७-१-३१-४७", "content_sanskrit": "अयस्यग्नौ समाविष्टे दाहो ऽग्नेरेव नायसः ।\nमूर्तात्मन्येवमैश्वर्यमीश्वरस्यैव नात्मनाम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001458047, "chapter_id": 21458, "verse_number": "७-१-३१-४८", "content_sanskrit": "न हि काष्ठं ज्वलत्यूर्ध्वमग्निरेव ज्वलत्यसौ ।\nकाष्ठस्यांगारता नाग्नेरेवमत्रापि योज्यताम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001458048, "chapter_id": 21458, "verse_number": "७-१-३१-४९", "content_sanskrit": "अत एव जगत्यस्मिन्काष्ठपाषाणमृत्स्वपि ।\nशिवावेशवशादेव शिवत्वमुपचर्यते॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001458049, "chapter_id": 21458, "verse_number": "७-१-३१-५०", "content_sanskrit": "मैत्र्यादयो गुणा गौणास्तस्मात्ते भिन्नवृत्तयः ।\nतैर्गुणैरुपरक्तानां दोषाय च गुणाय च॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001458050, "chapter_id": 21458, "verse_number": "७-१-३१-५१", "content_sanskrit": "यत्तु गौणमगौणं च तत्सर्वमनुगृह्णतः ।\nन गुणाय न दोषाय शिवस्य गुणवृत्तयः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001458051, "chapter_id": 21458, "verse_number": "७-१-३१-५२", "content_sanskrit": "न चानुग्रहशब्दार्थं गौणमाहुर्विपश्चितः ।\nसंसारमोचनं किं तु शैवमाज्ञामयं हितम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001458052, "chapter_id": 21458, "verse_number": "७-१-३१-५३", "content_sanskrit": "हितं तदाज्ञाकरणं यद्धितं तदनुग्रहः ।\nसर्वं हिते नियुञ्जावः सर्वानुग्रहकारकः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001458053, "chapter_id": 21458, "verse_number": "७-१-३१-५४", "content_sanskrit": "यस्तूपकारशब्दार्थस्तमप्याहुरनुग्रहम् ।\nतस्यापि हितरूपत्वाच्छिवः सर्वोपकारकः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001458054, "chapter_id": 21458, "verse_number": "७-१-३१-५५", "content_sanskrit": "हिते सदा नियुक्तं तु सर्वं चिदचिदात्मकम् ।\nस्वभावप्रतिबन्धं तत्समं न लभते हितम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001458055, "chapter_id": 21458, "verse_number": "७-१-३१-५६", "content_sanskrit": "यथा विकासयत्येव रविः पद्मानि भानुभिः ।\nसमं न विकसन्त्येव स्वस्वभावानुरोधतः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001458056, "chapter_id": 21458, "verse_number": "७-१-३१-५७", "content_sanskrit": "स्वभावो ऽपि हि भावानां भाविनो ऽर्थस्य कारणम् ।\nन हि स्वभावो नश्यन्तमर्थं कर्तृषु साधयेत्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001458057, "chapter_id": 21458, "verse_number": "७-१-३१-५८", "content_sanskrit": "सुवर्णमेव नांगारं द्रावयत्यग्निसंगमः ।\nएवं पक्वमलानेव मोचयेन्न शिवपरान्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001458058, "chapter_id": 21458, "verse_number": "७-१-३१-५९", "content_sanskrit": "यद्यथा भवितुं योग्यं तत्तथा न भवेत्स्वयम् ।\nविना भावनया कर्ता स्वतन्त्रस्सन्ततो भवेत्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001458059, "chapter_id": 21458, "verse_number": "७-१-३१-६०", "content_sanskrit": "स्वभावविमलो यद्वत्सर्वानुग्राहकश्शिवः ।\nस्वभावमलिनास्तद्वदात्मनो जीवसंज्ञिताः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001458060, "chapter_id": 21458, "verse_number": "७-१-३१-६१", "content_sanskrit": "अन्यथा संसरन्त्येते नियमान्न शिवः कथम् ।\nकर्ममायानुबन्धोस्य संसारः कथ्यते बुधैः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001458061, "chapter_id": 21458, "verse_number": "७-१-३१-६२", "content_sanskrit": "अनुबन्धो ऽयमस्यैव न शिवस्येति हेतुमान् ।\nस हेतुरात्मनामेव निजो नागन्तुको मलः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001458062, "chapter_id": 21458, "verse_number": "७-१-३१-६३", "content_sanskrit": "आगन्तुकत्वे कस्यापि भाव्यं केनापि हेतुना ।\nयो ऽयं हेतुरसावेकस्त्वविचित्रस्वभावतः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001458063, "chapter_id": 21458, "verse_number": "७-१-३१-६४", "content_sanskrit": "आत्मतायाः समत्वे ऽपि बद्धा मुक्ताः परे यतः ।\nबद्धेष्वेव पुनः केचिल्लयभोगाधिकारतः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001458064, "chapter_id": 21458, "verse_number": "७-१-३१-६५", "content_sanskrit": "ज्ञानैश्वर्यादिवैषम्यं भजन्ते सोत्तराधराः ।\nकेचिन्मूर्त्यात्मतां यान्ति केचिदासन्नगोचराः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001458065, "chapter_id": 21458, "verse_number": "७-१-३१-६६", "content_sanskrit": "मूर्त्यात्मसु शिवाः केचिदध्वनां मूर्धसु स्थिताः ।\nमध्ये महेश्वरा रुद्रास्त्वर्वाचीनपदे स्थिताः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001458066, "chapter_id": 21458, "verse_number": "७-१-३१-६७", "content_sanskrit": "आसन्ने ऽपि च मायायाः परस्मात्कारणात्त्रयम् ।\nतत्राप्यात्मा स्थितो ऽधस्तादन्तरात्मा च मध्यतः॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001458067, "chapter_id": 21458, "verse_number": "७-१-३१-६८", "content_sanskrit": "परस्तात्परमात्मेति ब्रह्मविष्णुमहेश्वराः ।\nवर्तन्ते वसवः केचित्परमात्मपदाश्रयाः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001458068, "chapter_id": 21458, "verse_number": "७-१-३१-६९", "content_sanskrit": "अन्तरात्मपदे केचित्केचिदात्मपदे तथा ।\nशान्त्यतीतपदे शैवाः शान्ते माहेश्वरे ततः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001458069, "chapter_id": 21458, "verse_number": "७-१-३१-७०", "content_sanskrit": "विद्यायान्तु यथा रौद्राः प्रतिष्ठायां तु वैष्णवाः ।\nनिवृत्तौ च तथात्मानो ब्रह्मा ब्रह्मांगयोनयः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001458070, "chapter_id": 21458, "verse_number": "७-१-३१-७१", "content_sanskrit": "देवयोन्यष्टकं मुख्यं मानुष्यमथ मध्यमम् ।\nपक्ष्यादयो ऽधमाः पञ्चयोनयस्ताश्चतुर्दश॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001458071, "chapter_id": 21458, "verse_number": "७-१-३१-७२", "content_sanskrit": "उत्तराधरभावो ऽपि ज्ञेयस्संसारिणो मलः ।\nयथामभावो मुक्तस्य पूर्वं पश्चात्तु पक्वता॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001458072, "chapter_id": 21458, "verse_number": "७-१-३१-७३", "content_sanskrit": "मलो ऽप्यामश्च पक्वश्च भवेत्संसारकारणम् ।\nआमे त्वधरता पुंसां पक्वे तूत्तरता क्रमात्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001458073, "chapter_id": 21458, "verse_number": "७-१-३१-७४", "content_sanskrit": "पश्वात्मानस्त्रिधाभिन्ना एकद्वित्रिमलाः क्रमात् ।\nअत्रोत्तरा एकमला द्विमला मध्यमा मताः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001458074, "chapter_id": 21458, "verse_number": "७-१-३१-७५", "content_sanskrit": "त्रिमलास्त्वधमा ज्ञेया यथोत्तरमधिष्ठिताः ।\nत्रिमलानधितिष्ठंति द्विमलैकमलाः क्रमात्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001458075, "chapter_id": 21458, "verse_number": "७-१-३१-७६", "content_sanskrit": "इत्थमौपाधिको भेदो विश्वस्य परिकल्पितः ।\nएकद्वित्रिमलान्सर्वाञ्छिव एको ऽधितिष्ठति॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001458076, "chapter_id": 21458, "verse_number": "७-१-३१-७७", "content_sanskrit": "अशिवात्मकमप्येतच्छिवेनाधिष्ठितं यथा ।\nअरुद्रात्मकमित्येवं रुद्रैर्जगदधिष्ठितम्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001458077, "chapter_id": 21458, "verse_number": "७-१-३१-७८", "content_sanskrit": "अण्डान्ता हि महाभूमिश्शतरुद्राद्यधिष्ठिता ।\nमायान्तमन्तरिक्षं तु ह्यमरेशादिभिः क्रमात्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001458078, "chapter_id": 21458, "verse_number": "७-१-३१-७९", "content_sanskrit": "अंगुष्ठमात्रपर्यन्तैस्समंतात्संततं ततम् ।\nमहामायावसाना द्यौर्वाय्वाद्यैर्भुवनाधिपैः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001458079, "chapter_id": 21458, "verse_number": "७-१-३१-८०", "content_sanskrit": "अनाश्रितान्तैरध्वान्तर्वर्तिभिस्समधिष्ठिताः ।\nते हि साक्षाद्दिविषदस्त्वन्तरिक्षसदस्तथा॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001458080, "chapter_id": 21458, "verse_number": "७-१-३१-८१", "content_sanskrit": "पृथिवीपद इत्येवं देवा देवव्रतैः स्तुता ।\nएवन्त्रिभिर्मलैरामैः पक्वैरेव पृथक्पृथक्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001458081, "chapter_id": 21458, "verse_number": "७-१-३१-८२", "content_sanskrit": "निदानभूतैस्संसाररोगः पुंसां प्रवर्तते ।\nअस्य रोगस्य भैषज्यं ज्ञानमेव न चापरम्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001458082, "chapter_id": 21458, "verse_number": "७-१-३१-८३", "content_sanskrit": "भिषगाज्ञापकः शम्भुश्शिवः परमकारणम् ।\nअदुःखेना ऽपि शक्तो ऽसौ पशून्मोचयितुं शिवः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001458083, "chapter_id": 21458, "verse_number": "७-१-३१-८४", "content_sanskrit": "कथं दुःखं करोतीति नात्र कार्या विचारणा ।\nदुःखमेव हि सर्वो ऽपि संसार इति निश्चितम्॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001458084, "chapter_id": 21458, "verse_number": "७-१-३१-८५", "content_sanskrit": "कथं दुःखमदुःखं स्यात्स्वभावो ह्यविपर्ययः ।\nन हि रोगी ह्यरोगी स्याद्भिषग्भैषज्यकारणात्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001458085, "chapter_id": 21458, "verse_number": "७-१-३१-८६", "content_sanskrit": "रोगार्तं तु भिषग्रोगाद्भैषजैस्सुखमुद्धरेत् ।\nएवं स्वभावमलिनान्स्वभावाद्दुःखिनः पशून्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001458086, "chapter_id": 21458, "verse_number": "७-१-३१-८७", "content_sanskrit": "स्वाज्ञौषधविधानेन दुःखान्मोचयते शिवः ।\nन भिषक्कारणं रोगे शिवः संसारकारणम्॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001458087, "chapter_id": 21458, "verse_number": "७-१-३१-८८", "content_sanskrit": "इत्येतदपि वैषम्यं न दोषायास्य कल्पते ।\nदुःखे स्वभावसंसिद्धे कथन्तत्कारणं शिवः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001458088, "chapter_id": 21458, "verse_number": "७-१-३१-८९", "content_sanskrit": "स्वाभाविको मलः पुंसां स हि संसारयत्यमून् ।\nसंसारकारणं यत्तु मलं मायाद्यचेतनम्॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001458089, "chapter_id": 21458, "verse_number": "७-१-३१-९०", "content_sanskrit": "तत्स्वयं न प्रवर्तेत शिवसान्निध्यमन्तरा ।\nयथा मणिरयस्कांतस्सान्निध्यादुपकारकः॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001458090, "chapter_id": 21458, "verse_number": "७-१-३१-९१", "content_sanskrit": "अयसश्चलतस्तद्वच्छिवो ऽप्यस्येति सूरयः ।\nन निवर्तयितुं शक्यं सान्निध्यं सदकारणम्॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001458091, "chapter_id": 21458, "verse_number": "७-१-३१-९२", "content_sanskrit": "अधिष्ठाता ततो नित्यमज्ञातो जगतश्शिवः ।\nन शिवेन विना किंचित्प्रवृत्तमिह विद्यते॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001458092, "chapter_id": 21458, "verse_number": "७-१-३१-९३", "content_sanskrit": "तत्प्रेरितमिदं सर्वं तथापि न स मुह्यति ।\nशक्तिराज्ञात्मिका तस्य नियन्त्री विश्वतोमुखी॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001458093, "chapter_id": 21458, "verse_number": "७-१-३१-९४", "content_sanskrit": "तया ततमिदं शश्वत्तथापि स न दुष्यति ।\nअनिदं प्रथमं सर्वमीशितव्यं स ईश्वरः॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001458094, "chapter_id": 21458, "verse_number": "७-१-३१-९५", "content_sanskrit": "ईशनाच्च तदीयाज्ञा तथापि स न दुष्यति ।\nयो ऽन्यथा मन्यते मोहात्स विनष्यति दुर्मतिः॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001458095, "chapter_id": 21458, "verse_number": "७-१-३१-९६", "content_sanskrit": "तच्छक्तिवैभवादेव तथापि स न दुष्यति ।\nएतस्मिन्नंतरे व्योम्नः श्रुताः वागरीरिणी॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001458096, "chapter_id": 21458, "verse_number": "७-१-३१-९७", "content_sanskrit": "सत्यमोममृतं सौम्यमित्याविरभवत्स्फुटम् ।\nततो हृष्टतराः सर्वे विनष्टाशेषसंशयाः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001458097, "chapter_id": 21458, "verse_number": "७-१-३१-९८", "content_sanskrit": "मुनयो विस्मयाविष्टाः प्रेणेमुः पवनं प्रभुम् ।\nतथा विगतसन्देहान्कृत्वापि पवनो मुनीन्॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001458098, "chapter_id": 21458, "verse_number": "७-१-३१-९९", "content_sanskrit": "नैते प्रतिष्ठितज्ञाना इति मत्वैवमब्रवीत् ।\nवायुरुवाच्व ।\nपरोक्षमपरोक्षं च द्विविधं ज्ञानमिष्यते॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001458099, "chapter_id": 21458, "verse_number": "७-१-३१-१००", "content_sanskrit": "परोक्षमस्थिरं प्राहुरपरोक्षं तु सुस्थिरम् ।\nहेतूपदेशगम्यं यत्तत्परोक्षं प्रचक्षते॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001458100, "chapter_id": 21458, "verse_number": "७-१-३१-१०१", "content_sanskrit": "अपरोक्षं पुनः श्रेष्ठादनुष्ठानाद्भविष्यति ।\nनापरोक्षादृते मोक्ष इति कृत्वा विनिश्चयम्॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001458101, "chapter_id": 21458, "verse_number": "७-१-३१-१०२", "content_sanskrit": "श्रेष्ठानुष्ठानसिद्ध्यर्थं प्रयतध्वमतन्द्रिताः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}]