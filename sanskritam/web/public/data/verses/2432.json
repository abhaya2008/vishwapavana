[{"id": 2068261, "chapter_id": 2432, "verse_number": "९-५०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2068262, "chapter_id": 2432, "verse_number": "९-५०-१", "content_sanskrit": "इन्द्रतीर्थं ततो गत्वा यदूनां प्रवरो बली।\nविप्रेभ्यो धनरत्नानि ददौ स्नात्वा यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2068263, "chapter_id": 2432, "verse_number": "९-५०-२", "content_sanskrit": "तत्र ह्यमरराजो वै ईजे क्रतुशतेन ह।\nबृहस्पतेश्च देवेशः प्रददौ विपुलं धनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2068264, "chapter_id": 2432, "verse_number": "९-५०-३", "content_sanskrit": "अनर्गलान्सजारूथ्यान्सर्वान्विविधदक्षिणान्।\nआजहर क्रतूंस्तत्र यथोक्तं वेदपारगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2068265, "chapter_id": 2432, "verse_number": "९-५०-४", "content_sanskrit": "तान्क्रतून्भरतश्रेष्ठ शतकृत्वो महाद्युतिः।\nपूरयामास विधिवत्ततः ख्यातः शतक्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2068266, "chapter_id": 2432, "verse_number": "९-५०-५", "content_sanskrit": "तस्य नाम्ना तु तत्तीर्थं शिवं पुण्यं सनातनम्।\nइन्द्रतीर्थमिति ख्यातं सर्वपापप्रमोचनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2068267, "chapter_id": 2432, "verse_number": "९-५०-६", "content_sanskrit": "उपस्पृश्य च तत्रापि विधिवन्मुसलायुधः।\nब्राह्मणान्पूजयित्वा च पानाच्छादुनभोजनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2068268, "chapter_id": 2432, "verse_number": "९-५०-७", "content_sanskrit": "शुभं तीर्थवरं तस्माद्रामतीर्थं जगाम ह।\nयत्र रामो महाभागो भार्गवः सुमहातपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2068269, "chapter_id": 2432, "verse_number": "९-५०-८", "content_sanskrit": "असकृत्पृथिवीं कृत्वा हतक्षत्रियपुङ्गवाम्।\nउपाध्यायं पुरस्कृत्य काश्यपं मुनिसत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2068270, "chapter_id": 2432, "verse_number": "९-५०-९", "content_sanskrit": "अयजद्वाजपेयेन सोऽश्वमेधशतेन च।\nप्रददौ दक्षिणार्थं च पृथिवीं सागराम्बराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2068271, "chapter_id": 2432, "verse_number": "९-५०-१०", "content_sanskrit": "रामो दत्त्वा धनं तत्र द्विजेभ्यो जनमेजय।\nउपस्पृश्य यथान्यायं पूजयित्वा तथा द्विजान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2068272, "chapter_id": 2432, "verse_number": "९-५०-११", "content_sanskrit": "पुण्यतीर्थे शुभे देशे वसु दत्त्वा हलायुधः।\nमुनींश्चैवाभिवाद्याथ यमुनातीर्थमागमत्।\nयत्रानयामास तदा राजसूयमपाम्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2068273, "chapter_id": 2432, "verse_number": "९-५०-१२", "content_sanskrit": "दितेः सुतान्महाभागो वरुणो वै सितप्रभः।\nयत्र निर्जित्य सङ्ग्रामे मानुषान्दानवांस्तथा।\nगन्धर्वान्राक्षसांश्चैव वरुणः परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2068274, "chapter_id": 2432, "verse_number": "९-५०-१३", "content_sanskrit": "तस्मिन्क्रतुवरे वृत्ते सङ्ग्रामः समजायत।\nदेवानां दानवानां च त्रैलोक्यस्य भयावहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2068275, "chapter_id": 2432, "verse_number": "९-५०-१४", "content_sanskrit": "राजसूये क्रतुश्रेष्ठे निवृत्ते जनमेजय।\nजायते सुमहाघोरः संक्षयः क्षत्रियान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2068276, "chapter_id": 2432, "verse_number": "९-५०-१५", "content_sanskrit": "हलायुधस्तदा रामस्तस्मिंस्तीर्थवरे शुभे।\nतत्रस्नात्वा च दत्त्वा च द्विजेभ्यो वसु माधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2068277, "chapter_id": 2432, "verse_number": "९-५०-१६", "content_sanskrit": "वनमाली ततो हृष्टः स्तूयमानो द्विजातिभिः।\nतस्मादादित्यतीर्थं च जगाम कमलेक्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2068278, "chapter_id": 2432, "verse_number": "९-५०-१७", "content_sanskrit": "यत्रेष्ट्वा भगवाञ्ज्योतिर्भास्करो राजसत्तम।\nज्योतिषामाधिपत्यं च प्रभावं चाभ्यपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2068279, "chapter_id": 2432, "verse_number": "९-५०-१८", "content_sanskrit": "तस्या नद्यास्तु तीरे वै सर्वे देवाः सवासवाः।\nविश्वेदेवाः समरुतो गन्धर्वाप्सरसश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2068280, "chapter_id": 2432, "verse_number": "९-५०-१९", "content_sanskrit": "द्वैपायनः शुकश्चैव कृष्णश्च मधुसूदनः।\nयक्षाश्च राक्षसाश्चैव पिशाचाश्च विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2068281, "chapter_id": 2432, "verse_number": "९-५०-२०", "content_sanskrit": "एते चान्ये च बहवो योगसिद्धाः सहस्रशः।\nतस्मिंस्तीर्थे सरस्वत्याः शिवे पुण्ये परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2068282, "chapter_id": 2432, "verse_number": "९-५०-२१", "content_sanskrit": "तत्र हत्वा पुरा विष्णुरसुरौ मधुकैटभौ।\nआप्लुत्य भरतश्रेष्ठ तीर्थप्रवर उत्तमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2068283, "chapter_id": 2432, "verse_number": "९-५०-२२", "content_sanskrit": "द्वैपायनश्च धर्मात्मा तत्रैवाप्लुत्य भारत।\nसम्प्राप्तः परमं योगं सिद्धिं च परमां गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2068284, "chapter_id": 2432, "verse_number": "९-५०-२३", "content_sanskrit": "असितो देवलश्चैव तस्मिन्नेव महातपाः।\nपरमं योगमास्थाय ऋषिर्योगमवाप्तवान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2068285, "chapter_id": 2432, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शल्यपर्वणि ह्रदप्रवेशपर्वणि पञ्चाशोऽध्यायः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]