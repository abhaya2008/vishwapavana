[{"id": 7000590000, "chapter_id": 20590, "verse_number": "५-४९-१", "content_sanskrit": "शेष उवाच ।\nमासाः सप्ताभवंस्तस्य हयवर्यस्य हेलया ।\nचरतो भारतं वर्षमनेकनृपपूरितम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000590001, "chapter_id": 20590, "verse_number": "५-४९-२", "content_sanskrit": "स पूजितो भूपवरैः परीत्य वरभारतम् ।\nपरीवृतो वीरवरैः शत्रुघ्नादिभिरुद्भटैः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000590002, "chapter_id": 20590, "verse_number": "५-४९-३", "content_sanskrit": "स बभ्राम बहून्देशान्हिमालयसमीपतः ।\nन कोपि तं निजग्राह हयं रामबलं स्मरन्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000590003, "chapter_id": 20590, "verse_number": "५-४९-४", "content_sanskrit": "अंगवंगकलिंगानां राजभिः संस्तुतो हयः ।\nजगाम राज्ञो नगरे सुरथस्य मनोहरे॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000590004, "chapter_id": 20590, "verse_number": "५-४९-५", "content_sanskrit": "कुंडलं नाम नगरमदितेर्यत्र कुंडलम् ।\nकर्णयोः पतितं भूमौ हर्षभयसुकंपयोः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000590005, "chapter_id": 20590, "verse_number": "५-४९-६", "content_sanskrit": "यत्र धर्मव्यतिक्रांतिं न करोति कदापिना ।\nश्रीरामस्मरणं प्रेम्णा करोति जनतान्वहम्॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000590006, "chapter_id": 20590, "verse_number": "५-४९-७", "content_sanskrit": "अश्वत्थानां तु यत्रार्चा तुलस्याः प्रत्यहं नृभिः ।\nक्रियते रघुनाथस्य सेवकैः पापवर्जितैः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000590007, "chapter_id": 20590, "verse_number": "५-४९-८", "content_sanskrit": "यत्र देवालया रम्या राघवप्रतिमायुताः ।\nपूज्यंते प्रत्यहं शुद्धचित्तैः कपटवर्जितैः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000590008, "chapter_id": 20590, "verse_number": "५-४९-९", "content_sanskrit": "वाचि नाम हरेर्यत्र न वै कलहसंकथा ।\nहृदि ध्यानं तु तस्यैव न च कामफलस्मृतिः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000590009, "chapter_id": 20590, "verse_number": "५-४९-१०", "content_sanskrit": "देवनं यत्र रामस्य वार्त्ताभिः पूतदेहिनाम् ।\nन जातुचिन्नृणामस्ति सत्यव्यसनमानिनाम्॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000590010, "chapter_id": 20590, "verse_number": "५-४९-११", "content_sanskrit": "तस्मिन्वसति धर्मात्मा सुरथः सत्यवान्बली ।\nरघुनाथपदस्मारहृष्टचित्तः परोन्मदः॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000590011, "chapter_id": 20590, "verse_number": "५-४९-१२", "content_sanskrit": "किं वर्णयामि रामस्य सेवकं सुरथं वरम् ।\nयस्याशेषगुणा भूमौ विस्तृताः पावयंत्यघम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000590012, "chapter_id": 20590, "verse_number": "५-४९-१३", "content_sanskrit": "सेवकास्तस्य भूपस्य पर्यटंतः कदाचन ।\nअपश्यन्हयमेधस्य हयं चंदनचर्चितम्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000590013, "chapter_id": 20590, "verse_number": "५-४९-१४", "content_sanskrit": "ते दृष्ट्वा विस्मयं प्राप्ता हयपत्रमलोकयन् ।\nस्पष्टाक्षरसमायुक्तं चंदनादिकचर्चितम्॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000590014, "chapter_id": 20590, "verse_number": "५-४९-१५", "content_sanskrit": "ज्ञात्वा रामेण संमुक्तं हयं नेत्रमनोहरम् ।\nहृष्टा राज्ञे सभास्थाय कथयामासुरुत्सुकाः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000590015, "chapter_id": 20590, "verse_number": "५-४९-१६", "content_sanskrit": "स्वामिन्नयोध्यानगरीपतिस्तस्यास्तु राघवः ।\nहयमेधक्रतोर्योग्यो हयो मुक्तः परिभ्रमन्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000590016, "chapter_id": 20590, "verse_number": "५-४९-१७", "content_sanskrit": "स ते पुरस्य निकटे प्राप्तः सेवकसंयुतः ।\nगृहाण त्वं महाराज हयं तं सुमनोहरम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000590017, "chapter_id": 20590, "verse_number": "५-४९-१८", "content_sanskrit": "शेष उवाच ।\nइति श्रुत्वा निजप्रोक्तं वाक्यं हर्षपरिप्लुतः ।\nउवाच वीरान्बलिनो मेघगंभीरया गिरा॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000590018, "chapter_id": 20590, "verse_number": "५-४९-१९", "content_sanskrit": "सुरथ उवाच ।\nधन्या वयं राममुखं पश्यामः सह सेवकाः ।\nग्रहीष्यामि हयं तस्य भटकोटिपरीवृतम्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000590019, "chapter_id": 20590, "verse_number": "५-४९-२०", "content_sanskrit": "तदा मोक्ष्यामि वाहं तं यदा रामः समाव्रजेत् ।\nकृतार्थं मम भक्तस्य चिरं ध्यानरतस्य वै॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000590020, "chapter_id": 20590, "verse_number": "५-४९-२१", "content_sanskrit": "शेष उवाच ।\nइत्थमुक्त्वा महीपालः सेवकान्स्वयमादिशत् ।\nगृह्णंतु वाहं प्रसभं मोच्यो नाश्वोऽक्षिगोचरः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000590021, "chapter_id": 20590, "verse_number": "५-४९-२२", "content_sanskrit": "अनेन सुमहांल्लाभो भविष्यति तु मे मतम् ।\nयद्रामचरणौ प्रेक्षे ब्रह्मशक्रादिदुर्ल्लभौ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000590022, "chapter_id": 20590, "verse_number": "५-४९-२३", "content_sanskrit": "स एव धन्यः स्वजनः पुत्रो वा बांधवोऽथवा ।\nपशुर्वा वाहनं वापि रामाप्तिर्येन संभवेत्॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000590023, "chapter_id": 20590, "verse_number": "५-४९-२४", "content_sanskrit": "तस्माद्गृहीत्वा क्रत्वश्वं स्वर्णपत्रेण शोभितम् ।\nबध्नंतु वाजिशालायां कामवेगं मनोरमम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000590024, "chapter_id": 20590, "verse_number": "५-४९-२५", "content_sanskrit": "इत्युक्तास्ते ततो गत्वा वाहं रामस्य शोभितम् ।\nगृहीत्वा तरसा राज्ञे ददुः सर्वं शुभांगिनम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000590025, "chapter_id": 20590, "verse_number": "५-४९-२६", "content_sanskrit": "राजा प्राप्य मुदा चाश्वं रामस्य दनुजार्दनः ।\nसेवकान्प्राह बलिनो धर्मकृत्यविचक्षणः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000590026, "chapter_id": 20590, "verse_number": "५-४९-२७", "content_sanskrit": "वात्स्यायन महाबुद्धे शृणुष्वैकाग्रमानसः ।\nन तस्य विषये कश्चित्परदाररतो नरः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000590027, "chapter_id": 20590, "verse_number": "५-४९-२८", "content_sanskrit": "न परद्रव्यनिरतो न च कामेषु लंपटः ।\nन जिह्वाभिरतोन्मार्गे कीर्त्तयेद्रामकीर्तनात्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000590028, "chapter_id": 20590, "verse_number": "५-४९-२९", "content_sanskrit": "यः सेवकान्नृपो वक्ति यूयं सेवार्थमागताः ।\nकथयंतु भवच्चेष्टां धर्मकर्मविशारदाः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000590029, "chapter_id": 20590, "verse_number": "५-४९-३०", "content_sanskrit": "एकपत्नीव्रतधरा न परद्रव्यलोलुपाः ।\nपरापवादानिरता न च वेदोत्पथं गताः॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000590030, "chapter_id": 20590, "verse_number": "५-४९-३१", "content_sanskrit": "श्रीरामस्मरणादीनि कुर्वंति प्रत्यहं भटाः ।\nतानहं रामसेवार्थं रक्षाम्यंतक कोपवान्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000590031, "chapter_id": 20590, "verse_number": "५-४९-३२", "content_sanskrit": "एतद्विरुद्धधर्माणो ये नराः पापसंयुताः ।\nतानहं विषये मह्यं वासयामि न दुर्मतीन्॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000590032, "chapter_id": 20590, "verse_number": "५-४९-३३", "content_sanskrit": "तस्य देशे न पापिष्ठाः पापं कुर्वंति मानसे ।\nहरिध्यानहताशेष पातकामोदसंयुताः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000590033, "chapter_id": 20590, "verse_number": "५-४९-३४", "content_sanskrit": "यदैवमभवद्देशो राजा धर्मेण संयुतः ।\nतदा तत्स्था नराः सर्वे मृता गच्छंति निर्वृतिम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000590034, "chapter_id": 20590, "verse_number": "५-४९-३५", "content_sanskrit": "यमानुचरनिर्वेशो नाभवत्सौरथे पुरे ।\nतदा यमो मुनेरूपं धृत्वा प्रागान्महीश्वरम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000590035, "chapter_id": 20590, "verse_number": "५-४९-३६", "content_sanskrit": "वल्कलांबरधारी च जटाशोभितशीर्षकः ।\nसुरथं तु सभामध्ये ददर्श हरिसेवकम्॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000590036, "chapter_id": 20590, "verse_number": "५-४९-३७", "content_sanskrit": "तुलसीमस्तके यस्य वाचि नाम हरेः परम् ।\nधर्मकर्मरतां वार्त्तां श्रावयंतं निजाञ्जनान्॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000590037, "chapter_id": 20590, "verse_number": "५-४९-३८", "content_sanskrit": "तदा मुनिं नृपो दृष्ट्वा तपोमूर्तिमिव स्थितम् ।\nववंदे चरणौ तस्य पाद्यादिकमथाकरोत्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000590038, "chapter_id": 20590, "verse_number": "५-४९-३९", "content_sanskrit": "सुखोपविष्टं विश्रांतं मुनिं प्राह नृपाग्रणीः ।\nधन्यमद्य जनुर्मह्यं धन्यमद्य गृहं मम॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000590039, "chapter_id": 20590, "verse_number": "५-४९-४०", "content_sanskrit": "कथाः कथयतान्मह्यं रामस्य विविधा वराः ।\nयाः शृण्वतां पापहानिर्भविष्यति पदे पदे॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000590040, "chapter_id": 20590, "verse_number": "५-४९-४१", "content_sanskrit": "इत्थमुक्तं समाकर्ण्य जहास स मुनिर्भृशम् ।\nदंतान्प्रदर्शयन्सर्वांस्तालास्फालितपाणिकः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000590041, "chapter_id": 20590, "verse_number": "५-४९-४२", "content_sanskrit": "हसंतं तं मुनिं प्राह हसने कारणं किमु ।\nकथयस्व प्रसादेन यथा स्यान्मनसः सुखम्॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000590042, "chapter_id": 20590, "verse_number": "५-४९-४३", "content_sanskrit": "ततो मुनिर्नृपं प्राह शृणु राजन्धियायुतः ।\nयदहं तेऽभिधास्यामि स्मिते कारणमुत्तमम्॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000590043, "chapter_id": 20590, "verse_number": "५-४९-४४", "content_sanskrit": "त्वया प्रोक्तं हरेः कीर्तिं कथयस्व ममाग्रतः ।\nको हरिः कस्य वा कीर्तिः सर्वे कर्मवशा नराः॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000590044, "chapter_id": 20590, "verse_number": "५-४९-४५", "content_sanskrit": "कर्मणा प्राप्यते स्वर्गः कर्मणा नरकं व्रजेत् ।\nकर्मणैव भवेत्सर्वं पुत्रपौत्रादिकं बहु॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000590045, "chapter_id": 20590, "verse_number": "५-४९-४६", "content_sanskrit": "शक्रः शतं क्रतूनां तु कृत्वागात्परमं पदम् ।\nब्रह्मापि कर्मणा लोकं प्राप्य सत्याख्यमद्भुतम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000590046, "chapter_id": 20590, "verse_number": "५-४९-४७", "content_sanskrit": "अनेके कर्मणा सिद्धा मरुदादय ईशिनः ।\nकुर्वन्ति भोगसौख्यं च अप्सरोगणसेविताः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000590047, "chapter_id": 20590, "verse_number": "५-४९-४८", "content_sanskrit": "तस्मात्कुरुष्व यज्ञादीन्यजस्व किल देवताः ।\nयथा ते विमलाकीर्तिर्भविष्यति महीतले॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000590048, "chapter_id": 20590, "verse_number": "५-४९-४९", "content_sanskrit": "इति श्रुत्वा तु तद्वाक्यं कोपक्षुभितमानसः ।\nउवाच रामैकमना विप्रं कर्मविशारदम्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000590049, "chapter_id": 20590, "verse_number": "५-४९-५०", "content_sanskrit": "मा ब्रूहि कर्मणो वार्तां क्षयिष्णुफलदायिनीम् ।\nगच्छ मन्नगरोपांताद्बहिर्लोकविगर्हितः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000590050, "chapter_id": 20590, "verse_number": "५-४९-५१", "content_sanskrit": "इंद्रः पतिष्यति क्षिप्रं पतिष्यत्यपि पद्मजः ।\nन पतिष्यंति मनुजा रामस्य भजनोत्सुकाः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000590051, "chapter_id": 20590, "verse_number": "५-४९-५२", "content_sanskrit": "पश्य ध्रुवं च प्रह्लादं बिभीषणमथाद्भुतम् ।\nये चान्ये रामभक्ता वै कदापि न पतंति ते॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000590052, "chapter_id": 20590, "verse_number": "५-४९-५३", "content_sanskrit": "ये रामनिंदका दुष्टास्तानि मे यमकिंकराः ।\nताडयिष्यंति लोहस्य मुद्गरैः पाशबन्धनैः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000590053, "chapter_id": 20590, "verse_number": "५-४९-५४", "content_sanskrit": "ब्राह्मणत्वाद्देहदंडं न कुर्यां ते द्विजाधम ।\nगच्छ गच्छ मदालोकात्ताडयिष्यामि चान्यथा॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000590054, "chapter_id": 20590, "verse_number": "५-४९-५५", "content_sanskrit": "इत्थमुक्तवति श्रेष्ठे भूपे सुरथसंज्ञिते ।\nसेवका बाहुना धृत्वा निष्कासयितुमुद्यताः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000590055, "chapter_id": 20590, "verse_number": "५-४९-५६", "content_sanskrit": "तदा यमो निजं रूपं धृत्वा लोकैकवंदितम् ।\nप्राह भूपं प्रतुष्टोऽस्मि याचस्व हरिसेवक॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000590056, "chapter_id": 20590, "verse_number": "५-४९-५७", "content_sanskrit": "मया प्रलोभितो वाग्भिर्बह्वीभिरपि सुव्रत ।\nचलितोसि न रामस्य सेवायाः साधुसेवितः॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000590057, "chapter_id": 20590, "verse_number": "५-४९-५८", "content_sanskrit": "तदा प्रोवाच भूमीशो यमं दृष्ट्वा सुतोषितम् ।\nउवाच यदि तुष्टोसि देहि मे वरमुत्तमम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000590058, "chapter_id": 20590, "verse_number": "५-४९-५९", "content_sanskrit": "तावन्मम न वै मृत्युर्यावद्रामसमागमः ।\nन भयं मे भवत्तो हि कदाचन हि धर्मराट्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000590059, "chapter_id": 20590, "verse_number": "५-४९-६०", "content_sanskrit": "तदोवाच यमो भूपमिदं तव भविष्यति ।\nसर्वं त्वदीप्सितं तथ्यं करिष्यति रघोःपतिः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000590060, "chapter_id": 20590, "verse_number": "५-४९-६१", "content_sanskrit": "इत्युक्त्वांतर्हितो धर्मो जगाम स्वपुरं प्रति ।\nप्रशस्य तस्य चरितं हरिभक्तिपरात्मनः॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000590061, "chapter_id": 20590, "verse_number": "५-४९-६२", "content_sanskrit": "स राजा धार्मिको रामसेवकः परया मुदा ।\nगृहीत्वाश्वं प्रत्युवाच सेवकान्हरिसेवकान्॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000590062, "chapter_id": 20590, "verse_number": "५-४९-६३", "content_sanskrit": "मया गृहीतो वाहोऽसौ राघवस्य महीपतेः ।\nसज्जी भवंतु सर्वत्र यूयं रणविशारदाः॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000590063, "chapter_id": 20590, "verse_number": "५-४९-६४", "content_sanskrit": "इति प्रोक्तास्तु ते सर्वे भटा राज्ञो महाबलाः ।\nसज्जीभूताः क्षणादेव सभायां जग्मुरुत्सुकाः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000590064, "chapter_id": 20590, "verse_number": "५-४९-६५", "content_sanskrit": "राज्ञो वीरा दशसुताश्चंपको मोहकस्तथा ।\nरिपुंजयोऽतिदुर्वारः प्रतापीबलमोदकः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000590065, "chapter_id": 20590, "verse_number": "५-४९-६६", "content_sanskrit": "हर्यक्षः सहदेवश्च भूरिदेवः सुतापनः ।\nइति राज्ञो दश सुताः सज्जीभूता रणांगणे॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000590066, "chapter_id": 20590, "verse_number": "५-४९-६७", "content_sanskrit": "यातुमिच्छामकुर्वंस्ते महोत्साहसमन्विताः ।\nराजापि स्वरथं चित्रं हेमशोभाविनिर्मितम्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000590067, "chapter_id": 20590, "verse_number": "५-४९-६८", "content_sanskrit": "आह्वयामास सुजवैर्वाजिभिः समलंकृतम् ।\nरणोत्साहेन संयुक्तः सर्वसैन्यपरीवृतः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000590068, "chapter_id": 20590, "verse_number": "५-४९-६९", "content_sanskrit": "सभायां सेवकान्सर्वान्दिशन्नास्ते महीपतिः॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]