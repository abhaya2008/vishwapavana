[{"id": 2112527, "chapter_id": 3426, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2112528, "chapter_id": 3426, "verse_number": "१", "content_sanskrit": "भीष्मस्य वचनं श्रुत्वा धर्महेत्वर्थसंयुतम् ।\nमाता सत्यवती भीष्मं पुनरेवाभ्यभाषत \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2112529, "chapter_id": 3426, "verse_number": "२", "content_sanskrit": "औचथ्यमधिकृत्येदमङ्गं च यदुदाहृतम् ।\nपौराणश्रुतिरस्त्येषा प्राप्तकालमिदं कुरु \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2112530, "chapter_id": 3426, "verse_number": "३", "content_sanskrit": "त्वं हि पुत्रः कुलस्याद्य ज्येष्ठः श्रेष्ठश्च भारत ।\nयथा च ते पितुर्वाक्यं मम कुर्यास्तथाऽनघ \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2112531, "chapter_id": 3426, "verse_number": "४", "content_sanskrit": "मम पुत्रस्तव भ्राता यवीयान् स प्रियश्च ते ।\nबाल एव गतः स्वर्गं भरतो भरतर्षभ \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2112532, "chapter_id": 3426, "verse_number": "५", "content_sanskrit": "इमे महिष्यौ तस्येह काशिराजसुते उभे ।\nरूपयौवनसम्पन्ने पुत्रकामे च भारत \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2112533, "chapter_id": 3426, "verse_number": "६", "content_sanskrit": "धर्ममेतं परं ज्ञात्वा सन्तानाय कुलस्य च ।\nआभ्यां मम नियोगात् त्वं धर्मं चरितुमर्हसि \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2112534, "chapter_id": 3426, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2112535, "chapter_id": 3426, "verse_number": "७", "content_sanskrit": "असंशयं परो धर्मस्त्वया मातः प्रकीर्तितः ।\nत्वमप्येतां प्रतिज्ञां तु वेत्थ या परमा मयि \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2112536, "chapter_id": 3426, "verse_number": "८", "content_sanskrit": "जानीष्व यत् तदा वृत्तं शुल्कहेतोस्त्वदन्तिके ।\nयत् सत्यवति सत्यं वै पुनरेव ब्रवीमि ते \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2112537, "chapter_id": 3426, "verse_number": "९", "content_sanskrit": "तन्न जात्वन्यथा कुर्यां लोकानामपि सङ्क्षये ।\nपरित्यजेयं त्रैलोक्यं राज्यं देवेषु वा पुनः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2112538, "chapter_id": 3426, "verse_number": "१०", "content_sanskrit": "यद्वाऽभ्यधिकमेताभ्यां न च सत्यं परित्यजे ।\nत्यजेच्च पृथिवी गन्धमापश्च रसमुत्सृजेत् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2112539, "chapter_id": 3426, "verse_number": "११", "content_sanskrit": "ज्योतिश्च परमं रूपं वायुः स्पर्शगुणं त्यजेत् ।\nत्यजेच्च घोषमाकाशः सोमः शीतत्वमृत्सृजेत् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2112540, "chapter_id": 3426, "verse_number": "१२", "content_sanskrit": "प्रतापमुत्सृजेदर्को धूमकेतुरथोष्णताम् ।\nवृत्रहा विक्रमं जह्माद् धर्मं जह्मात् तु धर्मराट्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2112541, "chapter_id": 3426, "verse_number": "१३", "content_sanskrit": "अमरत्वस्य वा हेतोस्त्रैलोक्यसदनस्य वा ।\nउत्सृजेयमहं प्राणान् न तु सत्यं कथञ्चन \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2112542, "chapter_id": 3426, "verse_number": "", "content_sanskrit": "सत्यवती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2112543, "chapter_id": 3426, "verse_number": "१४", "content_sanskrit": "जानामि त्वयि धर्मज्ञ सत्यं सत्यपराक्रम ।\nइच्छेस्त्वमिह लोकांस्त्रीन् सृजेरन्यानरिन्दम \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2112544, "chapter_id": 3426, "verse_number": "१५", "content_sanskrit": "यथा तु वः कुलं चैव धर्मं च न पराभवेत् ।\nसुहृदश्च प्रहृष्टा स्युस्तथा त्वं कर्तुमर्हसि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2112545, "chapter_id": 3426, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2112546, "chapter_id": 3426, "verse_number": "१६", "content_sanskrit": "त्वमेव कुलवृद्धाऽसि गौरवं च परं त्वयि ।\nसोपायं कुलसन्ताने वक्तुमर्हसि नः परम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2112547, "chapter_id": 3426, "verse_number": "१७", "content_sanskrit": "स्त्रियो हि परमं गुह्यं धारयन्ति कुले कुले ।\nपुरुषं चापि मायाभिर्बह्वीभिरुपगृह्णते \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2112548, "chapter_id": 3426, "verse_number": "१८", "content_sanskrit": "सा सत्यवति सम्पश्य कर्म सत्यपरायणे ।\nयथा न जह्यात् सत्यं च न सीदेच्च कुलं हि नः \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2112549, "chapter_id": 3426, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2112550, "chapter_id": 3426, "verse_number": "१९", "content_sanskrit": "ततः सत्यवती भीष्मं वाचा वै सज्जमानया ।\nप्रवेपमाना सव्रीडमिदं वचनमब्रवीत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2112551, "chapter_id": 3426, "verse_number": "२०", "content_sanskrit": "सत्यमेतन्महाबाहो यदात्थ प्रमदां प्रति ।\nविश्वासं ते प्रवक्ष्यामि सन्तानाय कुलस्य नः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2112552, "chapter_id": 3426, "verse_number": "५३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nपञ्चाधिकशततमोऽध्यायः ॥१०५॥ ॥ इति सम्भवपर्वणि त्रिपञ्चाशोऽध्यायः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2112553, "chapter_id": 3426, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]