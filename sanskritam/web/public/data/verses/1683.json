[{"id": 2031409, "chapter_id": 1683, "verse_number": "४-६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2031410, "chapter_id": 1683, "verse_number": "४-६-१", "content_sanskrit": "तेऽग्निं प्रदक्षिणं कृत्वा ब्राह्मणं च पुरोहितम्।\nअभिवाद्य ततः सर्वे प्रस्थातुमुपचक्रमुः ॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2031411, "chapter_id": 1683, "verse_number": "४-६-२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2031412, "chapter_id": 1683, "verse_number": "४-६-२", "content_sanskrit": "अनुशिष्टोस्मि भद्रं ते नैतद्वक्ताऽस्ति कश्चन।\nकुन्तीमृते मातरं नः पितरं च यशस्विनम् ॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2031413, "chapter_id": 1683, "verse_number": "४-६-३", "content_sanskrit": "यदेवानन्तरं कार्यं तद्भवान्वक्तुमर्हति।\nतारणाय तु दुःखस्य प्रस्थानाय भवाय च ॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2031414, "chapter_id": 1683, "verse_number": "४-६-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2031415, "chapter_id": 1683, "verse_number": "४-६-४", "content_sanskrit": "तेषां प्रतिष्ठमानानां धौम्यो मन्त्रानथाजपत्।\nसर्वविघ्नप्रशमनानर्थसिद्धिकरांस्तथा।\nततः पावकमुञ्ज्वाल्य मन्त्रहव्यपुरुस्कृतम् ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2031416, "chapter_id": 1683, "verse_number": "४-६-५", "content_sanskrit": "याज्ञसेनीं पुरस्कृत्य सर्व एव महारथाः।\nप्राद्रवन्सह धौम्येन बद्धशस्त्रा वनाद्वनम् ॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2031417, "chapter_id": 1683, "verse_number": "४-६-६", "content_sanskrit": "ते वीरा बद्धनिस्त्रिंशा धनुर्बाणकलापिनः ।\nअगच्छन्भीमधन्वानः काम्यकाद्यमुनां नदीम् ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2031418, "chapter_id": 1683, "verse_number": "४-६-७", "content_sanskrit": "उत्तरेण दशार्णानां पाञ्चालान्दक्षिणेन तु।\nअन्तरेण यकृल्लोम्नः शूरसेनांश्च पाण्डवाः ॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2031419, "chapter_id": 1683, "verse_number": "४-६-८", "content_sanskrit": "ते तस्या दक्षिणं तीरमन्वगच्छन्पदातयः ।\nततः प्रत्यक्प्रयातास्ते संक्रामन्तो वनाद्वनम् ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2031420, "chapter_id": 1683, "verse_number": "४-६-९", "content_sanskrit": "वसाना वनदुर्गेषु रमणीयेषु धन्विनः ।\nपल्वलेषु च रम्येषु नदीनां संगमेषु च॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2031421, "chapter_id": 1683, "verse_number": "४-६-१०", "content_sanskrit": "द्रुमान्नानाविधाकारान्नानाविधलताकुलान् ।\nकुसुमाढ्यान्मनःकान्ताञ्शुभगन्धान्मनोरमान् ॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2031422, "chapter_id": 1683, "verse_number": "४-६-११", "content_sanskrit": "पार्था निरीक्षमाणाश्च तान्द्रुमान्पुष्पशालिनः।\nजिघ्रन्तः पुष्पगन्धांश्च फलगन्धान्मनोरमान् ॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2031423, "chapter_id": 1683, "verse_number": "४-६-१२", "content_sanskrit": "विध्यन्तो मृगजातानि महेप्वासा महाबलाः ।\nउपित्वा द्वादशसमा वने परपुरंजयाः ।\nलुब्धान्ब्रुवाणा मात्स्यस्य विपयं प्राविशंस्तदा ॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2031424, "chapter_id": 1683, "verse_number": "४-६-१३", "content_sanskrit": "तत्र धौम्यं महेप्वासाः पाण्डवेया व्यसर्जयन् ।\nअग्निहोत्रं परिचरन्सोऽबुद्धोऽवसदाश्रमे ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2031425, "chapter_id": 1683, "verse_number": "४-६-१४", "content_sanskrit": "ततस्तेषु प्रयातेषु पाण्डवेषु महात्मसु।\nइन्द्रसेनमुखाश्चैव यथोक्तं प्राप्य निर्वृताः।\nरथानश्वांश्च रक्षन्तः सुखमूषुः सुसंवृताः ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2031426, "chapter_id": 1683, "verse_number": "४-६-१५", "content_sanskrit": "ततो जनपदं प्राप्य कृष्णा राजानमब्रवीत् ॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2031427, "chapter_id": 1683, "verse_number": "४-६-१६", "content_sanskrit": "पश्यैकपद्यो दृश्यन्ते क्षेत्रे गोष्ठं समाश्रिताः ।\nवृक्षांश्चोपवनोपेतान्ग्रामाणां नगरस्य च ॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2031428, "chapter_id": 1683, "verse_number": "४-६-१७", "content_sanskrit": "व्यक्तं दूरे विराटम...राजधानी भविष्यति।\nवसामेहापरां रात्रिं बलवान्मे परिश्रमः ॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2031429, "chapter_id": 1683, "verse_number": "४-६-१८x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2031430, "chapter_id": 1683, "verse_number": "४-६-१८", "content_sanskrit": "इमां कमलपत्राक्षीं द्रौपदीं माद्रिनन्दन।\nमुहूर्तं परिगृह्यैनां घाहुभ्यां नकुल व्रज ॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2031431, "chapter_id": 1683, "verse_number": "४-६-१९", "content_sanskrit": "ततोऽदूरे विराटस्य नगरं भरतर्षभ ।\nराजधान्यां निवत्स्यामः प्रमुक्तमिव नो वनम् ॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2031432, "chapter_id": 1683, "verse_number": "४-६-२०x", "content_sanskrit": "नकुल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2031433, "chapter_id": 1683, "verse_number": "४-६-२०", "content_sanskrit": "पूर्वाह्णे मृगयां कृत्वा मया विद्धा मृगा वने।\nअटवी च मया दूरं धृता मृगवधेप्सुना ॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2031434, "chapter_id": 1683, "verse_number": "४-६-२१", "content_sanskrit": "विषमा ह्यतिदुर्गा च वेगवत्परिधावता।\nसोहं धर्माभितप्तो वै नैनामादातुमुत्सहे ॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2031435, "chapter_id": 1683, "verse_number": "४-६-२२x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2031436, "chapter_id": 1683, "verse_number": "४-६-२२", "content_sanskrit": "सहदेव त्वमादाय मुहूर्तं द्रौपदीं नय।\nराजधान्यां निवत्स्यामः सुमुक्तमिव नो वनम् ॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2031437, "chapter_id": 1683, "verse_number": "४-६-२३x", "content_sanskrit": "सहदेव उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2031438, "chapter_id": 1683, "verse_number": "४-६-२३", "content_sanskrit": "अहमप्यस्मि तृषितः क्षुधया परिपीडितः।\nपरिश्रान्तश्च भद्रं ते नैनामादातुमुत्सहे ॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2031439, "chapter_id": 1683, "verse_number": "४-६-२४x", "content_sanskrit": "युधिष्ठिर उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2031440, "chapter_id": 1683, "verse_number": "४-६-२४", "content_sanskrit": "एहि वीर विशालाश्च वीरसिंह इवार्जुन ।\nइमां कमलपत्राक्षीं द्रौपदीं द्रुपदात्मजाम् ॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2031441, "chapter_id": 1683, "verse_number": "४-६-२५", "content_sanskrit": "परिगृह्य मुहूर्तं त्वं बाहुभ्यां कुशलं व्रज ।\nराजधान्यां निवत्स्यामः प्रमुक्तमिव नो वनम् ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2031442, "chapter_id": 1683, "verse_number": "४-६-२६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2031443, "chapter_id": 1683, "verse_number": "४-६-२६", "content_sanskrit": "गुरोर्वचनमाज्ञाय संप्रहृष्टो जितेन्द्रियः।\nबाहुभ्यां परिगृह्याथ राजपुत्रीमनिन्दिताम् ।\nप्रवव्राज महाबाहुरर्जुनः प्रियदर्शनाम् ॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2031444, "chapter_id": 1683, "verse_number": "४-६-२७", "content_sanskrit": "जटिलो वल्कलधरः शततूणीधनुर्धरः।\nस्कन्धे कृत्वा वरारोहां बालामायतलोचनाम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2031445, "chapter_id": 1683, "verse_number": "४-६-२८", "content_sanskrit": "आनीय नगराभ्याशमवातारयदर्जुनः ॥ २७ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2031446, "chapter_id": 1683, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि पाण्डवप्रवेशपर्वणि षष्ठोऽध्यायः ॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]