[{"id": 7001683000, "chapter_id": 21683, "verse_number": "१-६९-१", "content_sanskrit": "सनत्कुमार उवाच ।\nअथ वक्ष्ये त्रयीमूर्तेर्विधानं त्वब्जिनीपतेः ।\nमन्त्राणां यत्समाराध्य सर्वेष्टं प्राप्नुयाद्भुवि ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001683001, "chapter_id": 21683, "verse_number": "१-६९-२", "content_sanskrit": "तारो रेचिकया युक्तो मेधानेत्रयुता रतिः ।\nससर्गा वामकर्णोढ्यो भृगुर्वढ्यासनो मरुत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001683002, "chapter_id": 21683, "verse_number": "१-६९-३", "content_sanskrit": "शेषोदित्य इति प्रोक्तो वस्वर्णो भुक्तिमुक्तिदः ।\nदेवभागो मुनिश्छन्दो गायत्री देवता रविः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001683003, "chapter_id": 21683, "verse_number": "१-६९-४", "content_sanskrit": "माया बीजं रमा शक्तिर्दृष्टादृष्टे नियोगकः ।\nसत्याय हृदयं पश्चाद्ब्रह्मणे शिर ईरितम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001683004, "chapter_id": 21683, "verse_number": "१-६९-५", "content_sanskrit": "विष्णवे तु शिखावर्म रुद्राय परिकीर्तितम् ।\nनेत्रं स्यादग्रये पश्चात्शर्वायास्रमुदाहृतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001683005, "chapter_id": 21683, "verse_number": "१-६९-६", "content_sanskrit": "नेत्रो ज्वाला मनो हुं फट्स्वाहांता मनवो गणाः ।\nपुनः षडर्णैर्ह्री लक्ष्म्याः कृत्वांतः स्थैः षडंगकम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001683006, "chapter_id": 21683, "verse_number": "१-६९-७", "content_sanskrit": "शिष्टारौजठरे पृष्टे तयोर्ङेंताख्यया न्यसेत् ।\nआदित्यं च रविं पश्चाद्भानुं भास्करमेव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001683007, "chapter_id": 21683, "verse_number": "१-६९-८", "content_sanskrit": "सूर्यं च मूर्ध्नि वदने हृदि गुह्ये च पादयोः ।\nसद्यादिपञ्च ह्रस्वाद्यान् न्यसेन्ङे हृदयोंऽतिमान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001683008, "chapter_id": 21683, "verse_number": "१-६९-९", "content_sanskrit": "ह्रीं रमामध्यगामष्टौ वर्णांस्तारादिकान्न्यसेत् ।\nमूर्द्धास्यकंठहृत्कुक्षिनाभिलिंगगुदेषु च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001683009, "chapter_id": 21683, "verse_number": "१-६९-१०", "content_sanskrit": "सचंद्रस्वरपूर्वं तु ङेतं शीतांशुमण्डलम् ।\nमूर्द्धादिकंठपर्यंतं न्यसेञ्चांद्रिमनुस्प्ररन् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001683010, "chapter_id": 21683, "verse_number": "१-६९-११", "content_sanskrit": "स्पर्शान्सेंदून्समुञ्चार्य ङेंतं भास्करमण्डलम् ।\nन्यसेत्कंठादिनाभ्यंतं ध्यायन्प्रद्योतनं हृदि ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001683011, "chapter_id": 21683, "verse_number": "१-६९-१२", "content_sanskrit": "यादीन्सचंद्रानुञ्चार्य ङेतं च वह्निमंडलम् ।\nनाभ्यादिपादपर्यंतं न्यसेद्वह्निमनुस्मरन् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001683012, "chapter_id": 21683, "verse_number": "१-६९-१३", "content_sanskrit": "प्रोक्तोऽयं मण्डलन्यासो महातेजोविधायकः ।\nआदिठांतार्णपूर्वं ङेंनमोंतं सोममण्डलम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001683013, "chapter_id": 21683, "verse_number": "१-६९-१४", "content_sanskrit": "मूर्द्धादिहृदयांतं तु विन्यसेत्साधकोत्तमः ।\nडकारादिक्षकारांतवर्णाद्यं वह्निमण्डलम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001683014, "chapter_id": 21683, "verse_number": "१-६९-१५", "content_sanskrit": "ङेंतं हृदादिपादान्तं विन्यसेत्सुसमाहितः ।\nअग्रीषोमात्मको न्यासः कथितः सर्वसिद्धिदः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001683015, "chapter_id": 21683, "verse_number": "१-६९-१६", "content_sanskrit": "न्यसेत्सेंदून्मातृकार्णाञ्जयांतपुरुषात्मने ।\nनमोंते व्यापकं मंत्री हंस्नयासोऽयमीरितः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001683016, "chapter_id": 21683, "verse_number": "१-६९-१७", "content_sanskrit": "अष्टावष्टौ स्वराञ्शेषान्पंचपञ्च मितान्पुनः ।\nउक्तादित्यमुखानेतान्विन्यसेञ्च नवग्रहान् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001683017, "chapter_id": 21683, "verse_number": "१-६९-१८", "content_sanskrit": "आधारलिंगयोर्नाभौ हृदि कंठे मुखांतरे ।\nभ्रूमध्ये च तथा भाले ब्रह्मरंघ्रे न्यसेत्क्रमात् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001683018, "chapter_id": 21683, "verse_number": "१-६९-१९", "content_sanskrit": "हंसाख्यमग्नीषोमाख्यं मंडलत्रयमेव च ।\nपुनर्न्यासत्रयं कुर्यान्मूलेन व्यापकं चरेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001683019, "chapter_id": 21683, "verse_number": "१-६९-२०", "content_sanskrit": "एवं न्यासविधिं कृत्वा ध्यायेत्सूर्यं हृदबुजे ।\nदानाभयाब्जयुगलं धारयंतं करै रविम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001683020, "chapter_id": 21683, "verse_number": "१-६९-२१", "content_sanskrit": "कुंडलां गदकेयूरहारिणं च त्रयीतनुम् ।\nध्यात्वैवं प्रजपेन्मंत्री वसुलक्षं दशांशतः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001683021, "chapter_id": 21683, "verse_number": "१-६९-२२", "content_sanskrit": "रक्तांभोजैस्तिलैर्वापि जुहुयाद्विधिवद्वसौ ।\nप्रथमं पीठयजने धर्मादीनां स्थले यजेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001683022, "chapter_id": 21683, "verse_number": "१-६९-२३", "content_sanskrit": "प्रभूतं विमलं शारं समाराध्यमनंतरम् ।\nपरमादिमुखं मध्ये खबिंबांतं प्रपूजयेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001683023, "chapter_id": 21683, "verse_number": "१-६९-२४", "content_sanskrit": "सोमाग्निमंडलं पूज्यरविमंडलमर्चयेत् ।\nदीप्ता सूक्ष्मा जया भद्रा विभूतिर्विमला तथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001683024, "chapter_id": 21683, "verse_number": "१-६९-२५", "content_sanskrit": "अमोघा विद्युता सर्वतोमुखी पीठशक्तयः ।\nह्रस्वत्रयोक्तिजाः क्लीबही ना वह्नींदुसंयुताः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001683025, "chapter_id": 21683, "verse_number": "१-६९-२६", "content_sanskrit": "स्वरा बीजानि शक्तीनां तदाद्याः पूजयेत्तुः ताः ।\nब्रह्मविष्णुशिवात्मा ते सृष्टिः शेषान्विताप्यसौ ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001683026, "chapter_id": 21683, "verse_number": "१-६९-२७", "content_sanskrit": "एवं चान्ते योग पीठात्मने हृदयमीरयेत् ।\nताराद्योऽयं पीठमंत्रस्त्वनेनासनमादिशेत् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001683027, "chapter_id": 21683, "verse_number": "१-६९-२८", "content_sanskrit": "ध्रुवो वियद्बिंदुयुतं खं खखोल्काय दृन्मनुः ।\nनवार्णाय च मनवे मूर्तिं संकल्पयेत्सुधीः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001683028, "chapter_id": 21683, "verse_number": "१-६९-२९", "content_sanskrit": "साक्षिणं जगतां तस्यामावाह्य विधिवद्यजेत् ।\nततः षडंगामाराध्य द्विक्ष्वष्टांगं प्रपूजयेत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001683029, "chapter_id": 21683, "verse_number": "१-६९-३०", "content_sanskrit": "संपूज्य मध्ये वादित्यं रविं भानुं च भास्करम् ।\nसूर्यं दिशासु सद्यादिपंच ह्रस्वादिकानिमान् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001683030, "chapter_id": 21683, "verse_number": "१-६९-३१", "content_sanskrit": "स्वस्वनामादिवर्णाद्याः शक्तयोऽर्च्या विदिक्षु च   ।\nउषां प्रज्ञां प्रभां संध्यां ततो ब्रह्मादिकान्यजेत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001683031, "chapter_id": 21683, "verse_number": "१-६९-३२", "content_sanskrit": "पुरतोऽरुणमभ्यर्च्य सोमं ज्ञं च गुरुं भृगुम् ।\nदिक्ष्वर्यमादिकानिष्ट्वा भूमिजं च शनैश्चरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001683032, "chapter_id": 21683, "verse_number": "१-६९-३३", "content_sanskrit": "राहुं केतुं च कोणेषु पूर्ववत्परिपूजयेत् ।\nइंद्राद्यानपि वज्राद्यान्पूजयेत्पूर्ववत्सुधीः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001683033, "chapter_id": 21683, "verse_number": "१-६९-३४", "content_sanskrit": "इत्थं संपूज्य विधिवद्भास्करं भक्तवत्सलम् ।\nसमाहितो दिनेशाय दद्यादर्ध्यं दिने दिने ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001683034, "chapter_id": 21683, "verse_number": "१-६९-३५", "content_sanskrit": "प्राणानायम्य सद्भूमौ न्यासान्कृत्वा पुरोदितान् ।\nविधाय मंडलं भानोः पीठं पूर्ववदर्चयेत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001683035, "chapter_id": 21683, "verse_number": "१-६९-३६", "content_sanskrit": "ध्यात्वार्कं प्रयजेद्द्विव्यैर्मानसैरुपचारकैः ।\nपात्रं ताम्रमयं प्रस्थतोयग्राहि सुशोभनम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001683036, "chapter_id": 21683, "verse_number": "१-६९-३७", "content_sanskrit": "निधाय मंडले रक्तचंदनादिविनिर्मिते ।\nविलोममातृकामूलमुञ्चरन्पूरयेज्जलैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001683037, "chapter_id": 21683, "verse_number": "१-६९-३८", "content_sanskrit": "सूर्यबिंबविनिर्गच्छत्सुधांबुधिविभावितैः ।\nकुंकुमं रोजनां राजीं चंदनं रक्तचंदनम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001683038, "chapter_id": 21683, "verse_number": "१-६९-३९", "content_sanskrit": "करवीरं जपाशालिकुशश्यामाकतंडुलान् ।\nतिलवेणुयवांश्चैव निक्षिपेत्सलिले शुभे ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001683039, "chapter_id": 21683, "verse_number": "१-६९-४०", "content_sanskrit": "सांगं सावरणं तत्रावाह्यार्कं पूर्ववद्यजेत् ।\nगंधपुष्पधूपदीपनैवेद्याद्यै र्विधानतः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001683040, "chapter_id": 21683, "verse_number": "१-६९-४१", "content_sanskrit": "प्राणायामत्रयं कृत्वा कुर्यादंगानि पूर्ववत् ।\nसुधाबीजं चंदनेन दक्षे करतले लिखेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001683041, "chapter_id": 21683, "verse_number": "१-६९-४२", "content_sanskrit": "तेनाच्छाद्यार्ध्यपात्रं च जपेन्मनुमनन्यधीः ।\nअष्टोत्तरशतावृत्त्या पुनः संपूज्य भास्करम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001683042, "chapter_id": 21683, "verse_number": "१-६९-४३", "content_sanskrit": "हस्ताभ्यां पात्रमादाय जानुभ्यामवनीं गतः ।\nआमूर्ध्नि पात्रमुद्धृत्यांबरेण वरणे रवेः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001683043, "chapter_id": 21683, "verse_number": "१-६९-४४", "content_sanskrit": "दृष्टिं चाधाय मनसा पूजयित्वा रविं पुनः ।\nसाधकेन स्वकैक्येन मूलमंत्रं धिया जपन् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001683044, "chapter_id": 21683, "verse_number": "१-६९-४५", "content_sanskrit": "अर्ध्यं दद्याद्रविं ध्यायव्रक्तचंदनमंडले ।\nदत्त्वा पुष्पांजलिं भूयो जपेदष्टोत्तरं शतम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001683045, "chapter_id": 21683, "verse_number": "१-६९-४६", "content_sanskrit": "नित्यं वा तद्विनेऽप्येवमर्ध्यं दद्याद्विवस्वते ।\nतेन तुष्टो दिनेशोऽस्मै दद्याद्वित्तं यशः सुखम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001683046, "chapter_id": 21683, "verse_number": "१-६९-४७", "content_sanskrit": "पुत्रान्पौत्रानभीष्टं च यद्यत्सर्वं प्रयच्छति ।\nअर्ध्यदानमिदं प्रोक्तमायुरारोग्यवर्द्धनम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001683047, "chapter_id": 21683, "verse_number": "१-६९-४८", "content_sanskrit": "धनधान्यपशुक्षेमक्षेत्रमित्रकलत्रदम् ।\nतेजोवीर्ययशःकीर्तिविद्याविभवभोगदम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001683048, "chapter_id": 21683, "verse_number": "१-६९-४९", "content_sanskrit": "गायत्र्याराधनासक्तः संध्यावंदनतत्परः ।\nएवं मनुं जपन्विप्रो दुःखं नैवाप्नुयात्क्वचित् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001683049, "chapter_id": 21683, "verse_number": "१-६९-५०", "content_sanskrit": "विकर्तनाय निर्माल्यमेवं संपूज्य दापयेत् ।\nवियद्वह्निमरुत्साद्यांतार्वीसेंदुसमन्वितम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001683050, "chapter_id": 21683, "verse_number": "१-६९-५१", "content_sanskrit": "मार्तंडभैरवाख्यं हि बीजं त्रैलोक्यमोहनम् ।\nबिंबबीजेन पुटितं सर्वकामफलप्रदम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001683051, "chapter_id": 21683, "verse_number": "१-६९-५२", "content_sanskrit": "पूर्ववत्सकलं चान्यदत्र ज्ञेयं मनीषिभिः ।\nभृगुर्जलेंदुमन्वाढ्यः सोमाय हृदयांतिमः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001683052, "chapter_id": 21683, "verse_number": "१-६९-५३", "content_sanskrit": "षडक्षरो मंत्रराजो मुनिरस्य भृगुर्मतः ।\nछंदः पंक्तिस्तु सोमोऽस्य देवता परिकीर्तिता ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001683053, "chapter_id": 21683, "verse_number": "१-६९-५४", "content_sanskrit": "आद्यं बीजं नमः शक्तिर्विनियोगोऽखिलाप्तये ।\nषड्दीर्घेण स्वबीजेन षडंगानि समाचरेत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001683054, "chapter_id": 21683, "verse_number": "१-६९-५५", "content_sanskrit": "पूर्णेद्वास्यं स्फटिकभं नीलालकलसन्मुखम् ।\nविभ्राणमिष्टं कुमुदं ध्यायेन्मुक्तास्रजं विधुम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001683055, "chapter_id": 21683, "verse_number": "१-६९-५६", "content_sanskrit": "ऋतुलक्षं जपेन्मंत्रं पायसेन ससर्पिषा ।\nजुहुयात्तद्दशांशेन पीठे सोमांतपूजिते ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001683056, "chapter_id": 21683, "verse_number": "१-६९-५७", "content_sanskrit": "मूर्तिमूलेन संकल्प्य पूजयेद्विधिवद्विधुम् ।\nकेसरेष्वंगपूजा स्यात्पत्रेष्वेताश्च शक्तयः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001683057, "chapter_id": 21683, "verse_number": "१-६९-५८", "content_sanskrit": "रोहिणी कृत्तिका चैव रेवती भरणी पुरः ।\nरात्रिरार्द्रा ततो ज्योत्स्ना कला हारसमप्रभा ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001683058, "chapter_id": 21683, "verse_number": "१-६९-५९", "content_sanskrit": "सुशुक्लमाल्यवसनामुक्ताहारविभूषिताः ।\nसर्वास्स्तनभराक्रांता रचितांजलयः शुभाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001683059, "chapter_id": 21683, "verse_number": "१-६९-६०", "content_sanskrit": "स्वप्रियासक्तमनसो मदविभ्रममंथराः ।\nसमभ्यर्च्याः सरोजाक्ष्यः पूर्णेंदुसदृशाननाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001683060, "chapter_id": 21683, "verse_number": "१-६९-६१", "content_sanskrit": "दलाग्रेषु समभ्यर्च्यास्त्वष्टौ सूर्यादिका ग्रहाः ।\nआदित्यभूसुतबुधमंददेवेज्यराहवः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001683061, "chapter_id": 21683, "verse_number": "१-६९-६२", "content_sanskrit": "शुक्रकेतुयुता ह्येते पूज्याः पत्रग्रगाग्रहाः ।\nरक्तारुणश्वेतनीलपीतधूम्रसिताऽसिताः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001683062, "chapter_id": 21683, "verse_number": "१-६९-६३", "content_sanskrit": "वामोरुन्यस्ततद्धस्ता दक्षिणेन धृताभयाः ।\nसोकपालांस्तदस्त्राणि तद्वाह्ये पूजयेत्सुधीः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001683063, "chapter_id": 21683, "verse_number": "१-६९-६४", "content_sanskrit": "एव संसाधितो मंत्रः प्रयच्छेदिष्टमात्मनः ।\nपौर्णमास्यां जिताहारो दद्यादर्ध्यं विधूदये ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001683064, "chapter_id": 21683, "verse_number": "१-६९-६५", "content_sanskrit": "मंडलत्रितर्यं कुर्यात्प्राक्प्रत्यगायतं भुवि ।\nपश्चिमे मंडले स्थित्वा पूजाद्रव्यं च मध्यमे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001683065, "chapter_id": 21683, "verse_number": "१-६९-६६", "content_sanskrit": "संस्थाप्य सोममन्यस्मिन्मंडलेऽब्जसमन्विते ।\nसमभ्यर्च्यं विधानेन पीठपूजनपूर्वकम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001683066, "chapter_id": 21683, "verse_number": "१-६९-६७", "content_sanskrit": "स्थापयेद्राजतं पात्रं पुरतस्तत्र मंत्रवित् ।\nसुरभीपयसापूर्य्य तं स्पृशन्प्रजपेन्मनुम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001683067, "chapter_id": 21683, "verse_number": "१-६९-६८", "content_sanskrit": "अष्टोत्तरशतं पश्चाद्विद्या मंत्रेण मंत्रवित् ।\nदद्यान्निशाकरायार्ध्यं सर्वाभीष्टार्थसिद्धये ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001683068, "chapter_id": 21683, "verse_number": "१-६९-६९", "content_sanskrit": "कुर्यादनेन विधिना प्रतिमासमतंद्रितः ।\nवर्षांतरेण सवष्टं प्राप्नोति भुविमानवः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001683069, "chapter_id": 21683, "verse_number": "१-६९-७०", "content_sanskrit": "विद्ये विद्यामालिनि स्यादंत चंद्रिणि कतवदेत् ।\nचंद्रमुखि द्विठांतोऽयं विद्यामंत्र उदाहृतः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001683070, "chapter_id": 21683, "verse_number": "१-६९-७१", "content_sanskrit": "एवं कुमुदिनीनाथमंत्रं यो जपति ध्रुवम् ।\nधनं धान्यं सुतान्पौत्रान्सौभाग्यं लभतेऽचिरात् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001683071, "chapter_id": 21683, "verse_number": "१-६९-७२", "content_sanskrit": "अथांगारकमंत्रं तु वक्ष्ये धनसुतप्रदम् ।\nतारो दीर्घेंदुयुग्व्योम तदेवेंदुयुतः पुनः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001683072, "chapter_id": 21683, "verse_number": "१-६९-७३", "content_sanskrit": "षांतः सर्गी च चंडीशौ क्रमार्दिदुविसर्गिणै ।\nषडर्णोऽयं महामंत्रो मंगलस्याखिलेष्टदः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001683073, "chapter_id": 21683, "verse_number": "१-६९-७४", "content_sanskrit": "विरूपाक्षो मुनिश्छंदोगायत्रं देवता कुजः ।\nमंत्रार्णैः षड्भिरंगानि क्रुर्वन्ध्यायेद्धरात्मजम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001683074, "chapter_id": 21683, "verse_number": "१-६९-७५", "content_sanskrit": "मेषस्थं रक्तवस्रांगं शूलशक्तिगदावरान् ।\nकरैर्बिभ्राणमीशानस्वेदजं भूंसुतं स्मरेत् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001683075, "chapter_id": 21683, "verse_number": "१-६९-७६", "content_sanskrit": "रसलक्षं जपेन्मंत्रं दशांशं खदिरोद्भवैः ।\nसमिद्भिर्जुहुयादग्नौ शैवे पीठे यजेत्कुजम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001683076, "chapter_id": 21683, "verse_number": "१-६९-७७", "content_sanskrit": "प्रागंगानि समाराध्य ह्येकविंशतिकोष्टकम् ।\nमंगलोभूमिपुत्रश्च ऋणहर्ता धनप्रदः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001683077, "chapter_id": 21683, "verse_number": "१-६९-७८", "content_sanskrit": "स्थिरासनो महाकायः सर्वकर्मावरोधकः ।\nलोहितो लोहिताक्षश्च सामगानां कृपाकरः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001683078, "chapter_id": 21683, "verse_number": "१-६९-७९", "content_sanskrit": "धरात्मजः कुजो भौमो भूमिदो भूमिनंदनः ।\nअंगारको महीसूनुः सर्वरोगापहारकः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001683079, "chapter_id": 21683, "verse_number": "१-६९-८०", "content_sanskrit": "वृष्टिकर्ता वृष्टिहर्ता सर्वकार्यार्थसिद्धिदः ।\nइत्येक र्विशतिः प्रोक्ता मूर्तयो भूसुतस्य वै ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001683080, "chapter_id": 21683, "verse_number": "१-६९-८१", "content_sanskrit": "मंगलादीन्यजेन्मंत्री स्वस्वस्थानस्थितान्क्रमात् ।\nइंद्राद्यानपि वज्रादीनेवं सिद्धो भवेन्मनुः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001683081, "chapter_id": 21683, "verse_number": "१-६९-८२", "content_sanskrit": "सुतकामा कुरंगाक्षी भौमव्रतमुपाचरेत् ।\nमार्गशीर्षेऽथ वैशाखे व्रतारंभः प्रशस्यते ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001683082, "chapter_id": 21683, "verse_number": "१-६९-८३", "content_sanskrit": "अरुणोदयवेलायामुत्थायावश्यकं पुनः ।\nविनिर्वर्त्य रदान्धावेदपामार्गेण वाग्यता ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001683083, "chapter_id": 21683, "verse_number": "१-६९-८४", "content_sanskrit": "स्नात्वा रक्तांबरधरा रक्तमाल्यविलेपना ।\nनैवेद्यादींश्च संभारान्रक्तान्सर्वान्प्रकल्पयेत् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001683084, "chapter_id": 21683, "verse_number": "१-६९-८५", "content_sanskrit": "योग्यं विप्रं समाहूय कुजमर्चेत्तदाज्ञया ।\nरक्तगोगोमयालिप्तभूमौ रक्तासने विशेत् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001683085, "chapter_id": 21683, "verse_number": "१-६९-८६", "content_sanskrit": "आचम्य देशकालौ च स्मृत्वा काम्य समुच्चरन् ।\nमङ्गलादीनि नामानि स्वकीयांगेषु विन्यसेत् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001683086, "chapter_id": 21683, "verse_number": "१-६९-८७", "content_sanskrit": "मुखे प्रविन्यसेत्साध्वी सामगानां कृपाकरम् ।\nधरात्मजं नसोरक्ष्णोः कुजं भौमं ललाटके ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001683087, "chapter_id": 21683, "verse_number": "१-६९-८८", "content_sanskrit": "भूमिदं तु भ्रुवोर्मध्ये मस्तके भूमिनन्दनम् ।\nअङ्गारकं शिखायां च सर्वांगे च महीसुतम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001683088, "chapter_id": 21683, "verse_number": "१-६९-८९", "content_sanskrit": "बाहुद्वये न्यसेत्पश्चात्सर्वरोगापहारकम् ।\nमूर्द्धादि वृष्टिकर्तारमापादांतं न्यसेत्सुधीः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001683089, "chapter_id": 21683, "verse_number": "१-६९-९०", "content_sanskrit": "विन्यसेद्रृष्टिहर्तारं मूर्द्धांतं चरणादितः ।\nन्यसेदंते ततो दिक्षु सर्वकार्यार्थसिद्धिदम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001683090, "chapter_id": 21683, "verse_number": "१-६९-९१", "content_sanskrit": "नाभौ हृदि शिरस्यारं वक्रे भूमिजमेव च ।\nविन्यस्यैवं निजे देहे ध्यायेत्प्राग्वद्धरात्मजम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001683091, "chapter_id": 21683, "verse_number": "१-६९-९२", "content_sanskrit": "मानसैरुपचारैश्च संपूज्यार्ध्यं निधापयेत् ।\nएकविंशतिकोष्ठाढ्ये त्रिकोणे ताम्रपत्रगे ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001683092, "chapter_id": 21683, "verse_number": "१-६९-९३", "content_sanskrit": "आवाह्याङ्गारकं तत्र रक्तपुष्पादिभिर्यजेत् ।\nअङ्गानि पूर्वमाराध्य मङ्गलादीन्प्रपूजयेत् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001683093, "chapter_id": 21683, "verse_number": "१-६९-९४", "content_sanskrit": "एकविंशतिकोष्ठेषु चक्रमारं च भूमिजम् ।\nत्रिकोणेषु च सम्पूज्य बहिरष्टौ च मातृकाः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001683094, "chapter_id": 21683, "verse_number": "१-६९-९५", "content_sanskrit": "इंद्रादीनथ वज्रादीन्बाह्ये संपूजयेत्पुनः ।\nधूपदीपौ समर्प्याथ गोधूमान्नं निवेदयेत् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001683095, "chapter_id": 21683, "verse_number": "१-६९-९६", "content_sanskrit": "ताम्रपात्रे शुद्धतोयपूरिते रक्तचंदनम् ।\nरक्तपुष्पाक्षतफलान्याक्षिप्यार्ध्यं समर्पयेत् ।\nमंगलाय ततो मंत्री इदं मंत्रद्वयं पठेत् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001683096, "chapter_id": 21683, "verse_number": "१-६९-९७", "content_sanskrit": "भूमिपुत्र महातेजः स्वेदोद्भवपिनाकिनः ।\nसुतार्थिनी प्रपन्ना त्वां गृहाणार्ध्यं नमोऽस्तु ते ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001683097, "chapter_id": 21683, "verse_number": "१-६९-९८", "content_sanskrit": "रक्तप्रवालसंकाश जपाकुसुमसन्निभ ।\nमहीसुत महाभाग गृहाणार्ध्यं नमोऽस्तु ते ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001683098, "chapter_id": 21683, "verse_number": "१-६९-९९", "content_sanskrit": "एकविंशतिपूर्वोक्तैर्ङेनमोंतैंश्च नामभिः ।\nताराद्यैः प्रणमेत्पश्चात्तावत्यश्च प्रदक्षिणाः ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001683099, "chapter_id": 21683, "verse_number": "१-६९-१००", "content_sanskrit": "धरणीगर्भसंभूतं विद्युत्तेजः समप्रभम् ।\nकुमारं शक्तिहस्तं च मङ्गलं प्रणमाम्यहम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001683100, "chapter_id": 21683, "verse_number": "१-६९-१०१", "content_sanskrit": "ततो रेखात्रयं कुर्यात्खदिरांगारकेण च ।\nमार्जयेद्वामपादेन मंत्राभ्यां च समाहिता ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001683101, "chapter_id": 21683, "verse_number": "१-६९-१०२", "content_sanskrit": "दुःखदौर्भाग्यनाशाय पुत्रसंतानहेतवे ।\nकृतरेखात्रयं वामपादेनैतत्प्रमार्ज्म्यहम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001683102, "chapter_id": 21683, "verse_number": "१-६९-१०३", "content_sanskrit": "ऋणदुः खविनाशाय मनोभीष्टार्थसिद्धिये ।\nमार्जयाम्यसिता रेखास्तिस्रो जन्मत्रयोद्भवाः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001683103, "chapter_id": 21683, "verse_number": "१-६९-१०४", "content_sanskrit": "स्तुवीत धरणीपुत्रं पुष्पांजलिकरा ततः ।\nध्यायंती तत्पदांभोजं पूजासांगत्वसिद्धये ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001683104, "chapter_id": 21683, "verse_number": "१-६९-१०५", "content_sanskrit": "ऋणहर्त्रे नमस्तुभ्यं दुःखदारिद्र्यनाशिने ।\nसौभाग्यसुखदो नित्यं भव मे धरणीसुत ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7001683105, "chapter_id": 21683, "verse_number": "१-६९-१०६", "content_sanskrit": "तप्तकांचनसंकाश तरुणार्कसमप्रभ ।\nसुखसौभाग्यधनद ऋणदारिद्य्रनाशक ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7001683106, "chapter_id": 21683, "verse_number": "१-६९-१०७", "content_sanskrit": "ग्रहराज नमस्तेऽस्तु सर्वकल्याणकारक ।\nप्रसादं कुरु देवेश सर्वकल्याणभाजन ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7001683107, "chapter_id": 21683, "verse_number": "१-६९-१०८", "content_sanskrit": "देवदानवगंधर्वयक्षराक्षसपन्नगाः ।\nआप्नुवन्ति शिवं सर्वे सदा पूर्णमनोरथाः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7001683108, "chapter_id": 21683, "verse_number": "१-६९-१०९", "content_sanskrit": "आचिरादेव लोकेऽस्मिन्यस्याराधनतो जनाः ।\nप्राप्नुवन्ति सुखं तस्मै नमो धरणिसूनवे ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7001683109, "chapter_id": 21683, "verse_number": "१-६९-११०", "content_sanskrit": "यो वक्रगतिमापन्नो नृणां दुःखं प्रयच्छति ।\nपूजितः सुखसौभाग्यं तस्मै क्ष्मासूनवे नमः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7001683110, "chapter_id": 21683, "verse_number": "१-६९-१११", "content_sanskrit": "नभसि द्योतमानाय सर्वकल्याणहेतवे ।\nमङ्गलाय नमस्तुभ्यं धनसंतानहेतवे ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7001683111, "chapter_id": 21683, "verse_number": "१-६९-११२", "content_sanskrit": "प्रसादं कुरु मे भौममंगलप्रद मंगल ।\nमेषवाहन रुद्रात्मन्देहि पुत्रान्धनं यशः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7001683112, "chapter_id": 21683, "verse_number": "१-६९-११३", "content_sanskrit": "एवं स्तुत्वा प्रणम्याथ विसृज्य धरणीसुतम् ।\nयथाशक्त्या प्रदाय स्वं गृह्णीयाद्ब्रणाशिषः ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7001683113, "chapter_id": 21683, "verse_number": "१-६९-११४", "content_sanskrit": "गुरवे दक्षिणां दत्त्वा भुञ्जीयात्तन्निवेदितम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7001683114, "chapter_id": 21683, "verse_number": "१-६९-११५", "content_sanskrit": "एवमावत्सरं कुर्यात्प्रतिमंगलवासरम् ।\nतिलैर्होमं विधायाथ शतार्द्धं भोजयोद्द्विजान् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7001683115, "chapter_id": 21683, "verse_number": "१-६९-११६", "content_sanskrit": "भौममूर्तिं स्वर्णमयीमाचार्याय समर्पयेत् ।\nमंडलस्थे घटेऽभ्यर्च्येत्सुतसौभाग्यसिद्धये ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7001683116, "chapter_id": 21683, "verse_number": "१-६९-११७", "content_sanskrit": "एवं व्रतपरा नारी प्राप्नुयात्सुभगान्सुतान् ।\nऋणनाशाय वित्तार्थं व्रतं कुर्यात्पुमानपि ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7001683117, "chapter_id": 21683, "verse_number": "१-६९-११८", "content_sanskrit": "ब्राह्मणः प्रजपेन्मन्त्रंमग्निर्मूर्द्धेति वैदिकम् ।\nअंगारकस्य गायत्रीं वक्ष्ये यजनसिद्धये ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7001683118, "chapter_id": 21683, "verse_number": "१-६९-११९", "content_sanskrit": "अंगारकाय शब्दांते विद्महे पदमीरयेत् ।\nशक्तिहस्ताय वर्णांते धीमहीति समुञ्चरेत् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7001683119, "chapter_id": 21683, "verse_number": "१-६९-१२०", "content_sanskrit": "तन्नो भौमः प्रचोवर्णान्दयांदिति च संवदेत् ।\nभौमस्यैषा तु गायत्री जप्तुः सर्वेष्टसिद्धिदा ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7001683120, "chapter_id": 21683, "verse_number": "१-६९-१२१", "content_sanskrit": "भौमोपासनमेतद्धि बुधमन्त्रमथोच्यते ।\nफांतः कर्णेंदुसंयुक्तो बुधो ङेंते हदंतिमः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7001683121, "chapter_id": 21683, "verse_number": "१-६९-१२२", "content_sanskrit": "रसाणों बुधमन्त्रोऽयं मुनिब्रह्मास्य कीर्तितः ।\nपंक्तिश्छैदो देवता तु बुधः सर्वेष्टदो नृणाम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7001683122, "chapter_id": 21683, "verse_number": "१-६९-१२३", "content_sanskrit": "आद्यं बीजं नमः शक्तिर्विनियोगोऽखिलाप्तये ।\nवंदे बुधं सदा भक्त्या पीताम्बरविभूषणम् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7001683123, "chapter_id": 21683, "verse_number": "१-६९-१२४", "content_sanskrit": "जानुस्थवामहस्ताढ्यं साभयेतरपाणिकम् ।\nध्यात्वेवं प्रजपेसहस्रं विजितेंद्रियः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7001683124, "chapter_id": 21683, "verse_number": "१-६९-१२५", "content_sanskrit": "दशांशं जुहुयादाज्यैः पीठे पूर्वोदितेऽर्चयेत् ।\nअङ्गमातृदिशापालहेतिभिर्बुधमर्चयेत् ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7001683125, "chapter_id": 21683, "verse_number": "१-६९-१२६", "content_sanskrit": "एवं सिद्धे मनौ मंत्री साधयेत्स्वमनोरथान् ।\nसहस्रं प्रजपेन्मंत्रं नित्यं दशदिनावधि ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7001683126, "chapter_id": 21683, "verse_number": "१-६९-१२७", "content_sanskrit": "तस्याशु ग्रहजा पीडा नश्यत्येव न संशयः ।\nबुधस्याराधनं प्रोक्तं गुरोराराधनं श्रृणु ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7001683127, "chapter_id": 21683, "verse_number": "१-६९-१२८", "content_sanskrit": "बृंहस्पतिपदं ङेंऽतं सेंद्वाद्यर्णाघमंडितम् ।\nनमोंतो वसुवर्णोऽयं मुनिर्ब्रह्मास्य संमतः ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7001683128, "chapter_id": 21683, "verse_number": "१-६९-१२९", "content_sanskrit": "छन्दोऽनुष्टुप्सुराचार्यो देवता बीजमादिमम् ।\nहृच्छक्तिर्दीर्घवह्नींदुयुगलेनांगकल्पना ॥१२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7001683129, "chapter_id": 21683, "verse_number": "१-६९-१३०", "content_sanskrit": "न्यस्तवामकरं राशौ रत्नानां दक्षिणात्करात् ।\nकिरंतं पीतपुष्पालंकारालेपांशुकार्चितम् ॥१३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7001683130, "chapter_id": 21683, "verse_number": "१-६९-१३१", "content_sanskrit": "सर्वविद्यानिधिं देवगुरुं स्वर्णद्युतिं स्मरेत् ।\nलक्षं जपो दशांशेन घृतेनान्नेन वा हुनेत् ॥१३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7001683131, "chapter_id": 21683, "verse_number": "१-६९-१३२", "content_sanskrit": "धर्मादिपीठे प्रयजेदंगदिक्पालहेतिभिः ।\nएवं सिद्धे मनौ मंत्री साधयेदिष्टमात्मनः ॥१३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7001683132, "chapter_id": 21683, "verse_number": "१-६९-१३३", "content_sanskrit": "विपरोगादिपीडासु कलहे स्वजनोद्भवे ।\nपिप्पलोत्थसमिद्भिश्च जुहुयात्तन्निवृत्तये ॥१३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7001683133, "chapter_id": 21683, "verse_number": "१-६९-१३४", "content_sanskrit": "हुत्वा दिनत्रयं मन्त्री निशापुष्पैर्घृतप्लुतैः ।\nस विंशतिशतं शीघ्रं वासांसि लभते महीम् ॥१३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7001683134, "chapter_id": 21683, "verse_number": "१-६९-१३५", "content_sanskrit": "गुरोराराधनं प्रोक्तं श्रृणु शुक्रस्य सांप्रतम् ।\nवस्रं मे देहि शुक्राय ठद्वयांतो ध्रुवादिकः ॥१३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7001683135, "chapter_id": 21683, "verse_number": "१-६९-१३६", "content_sanskrit": "रुद्रार्णोऽयं मनुर्ब्रह्मा मुनिश्छन्दो विराहुत ।\nदैत्येज्यो देवता बीजं ध्रुवः शक्तिर्वसुप्रिया ॥१३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7001683136, "chapter_id": 21683, "verse_number": "१-६९-१३७", "content_sanskrit": "भूनेत्र चन्द्रनेत्राग्निनेत्रार्णैः स्यात्षडंगकम् ।\nशुक्लांबरालेपभूषं करेण ददतं धनम् ॥१३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7001683137, "chapter_id": 21683, "verse_number": "१-६९-१३८", "content_sanskrit": "वामेन शुक्रं व्याख्यानमुद्रादोषं स्मरेत्सुधीः ।\nअयुतं प्रजपेन्मन्त्रं दशांशं जुहुयाद् घृतैः ॥१३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7001683138, "chapter_id": 21683, "verse_number": "१-६९-१३९", "content_sanskrit": "धर्मादिपीठे प्रयजेदंगेंद्रादितदायुधैः ।\nश्वेतपुष्पैः सुगंधैश्च जुहुयाद् भृगुवासरे ॥१३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7001683139, "chapter_id": 21683, "verse_number": "१-६९-१४०", "content_sanskrit": "एकविंशतिवारं यो लभतेसोंऽशुकं मणीन् ।\nमनवोऽमो सदा गोप्या न देया यस्य कस्यचित् ॥१४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7001683140, "chapter_id": 21683, "verse_number": "१-६९-१४१", "content_sanskrit": "भक्तियुक्ताय शिष्याय देया वा निजसूनवे ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}]