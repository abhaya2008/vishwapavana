[{"id": 7001772000, "chapter_id": 21772, "verse_number": "२-३३-१", "content_sanskrit": "वसिष्ठ उवाच ।\nसंध्यावली ततः पादौ भर्तुः संगृह्य भूपते ।\nउवाच वचनं देवी धर्मां गदविनाशनम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001772001, "chapter_id": 21772, "verse_number": "२-३३-२", "content_sanskrit": "बहुधाप्यनुशिष्टेयं मया भूप यथा त्वया ।\nमोहिन्या मोहरूपाया नान्यत्संरोचतेऽधुना ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001772002, "chapter_id": 21772, "verse_number": "२-३३-३", "content_sanskrit": "भोजनं वासरे विष्णोर्वधं वा तनयस्य वै ।\nधर्मत्यागाद्वरं नाथ पुत्रस्य विनिपातनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001772003, "chapter_id": 21772, "verse_number": "२-३३-४", "content_sanskrit": "यादृशी हि जनन्यास्तु पीडा भवति भूपते ।\nपुत्रस्योत्पादने तीव्रातादृशी न भवेत्पितुः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001772004, "chapter_id": 21772, "verse_number": "२-३३-५", "content_sanskrit": "गर्भसंधारणे राजन् खेदः स्नेहोऽधिको यथा ।\nमातुर्भवति भूपाल तथा नहि भवेत्पितुः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001772005, "chapter_id": 21772, "verse_number": "२-३३-६", "content_sanskrit": "बीजनिर्वाषकः प्रोक्तः पिता राजेंद्र भूतले ।\nजननी धारिणी क्लिष्टा वर्द्धने पालनेऽधिका ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001772006, "chapter_id": 21772, "verse_number": "२-३३-७", "content_sanskrit": "पितुः शतगुणः स्नेहो मातुः पुत्रे प्रवर्तते ।\nस्नेहाधिक्यं तु संप्रेक्ष्य मातरं महतीं विदुः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001772007, "chapter_id": 21772, "verse_number": "२-३३-८", "content_sanskrit": "साहं जाता गतस्नेहा परलोकजिगीषया ।\nपुत्रस्य नृपशार्दूल सत्यवाक्यस्य पालनात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001772008, "chapter_id": 21772, "verse_number": "२-३३-९", "content_sanskrit": "व्यापादय सुतं भूप स्नेहं त्यक्त्वा सुदूरतः ।\nमा सत्यलंघनं कार्षीः शापितोऽसि मयात्मना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001772009, "chapter_id": 21772, "verse_number": "२-३३-१०", "content_sanskrit": "निकषेषु ह्यषीकेशो भविष्यति फलप्रदः ।\nयस्मिंश्चीर्णे रुजा देहे नाल्पापि नृप जायते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001772010, "chapter_id": 21772, "verse_number": "२-३३-११", "content_sanskrit": "अधर्मान्मानवोऽवश्यं स्वर्गभ्रष्टो न संशयः ।\nप्राणानादाय पुत्रं वा सर्वस्वं वा महीपते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001772011, "chapter_id": 21772, "verse_number": "२-३३-१२", "content_sanskrit": "यश्चानुवर्तते दैवं स पुमान् गीयते महान् ।\nता आपदोऽपि भूपाल धन्या याः सत्यकारिकाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001772012, "chapter_id": 21772, "verse_number": "२-३३-१३", "content_sanskrit": "सत्तयसंरक्षणार्थत्वान्नृणां स्युर्मोक्षदायिकाः ।\nकीर्तिसंस्तरणार्थाय कर्त्तव्यं मनुजैः सदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001772013, "chapter_id": 21772, "verse_number": "२-३३-१४", "content_sanskrit": "कर्म भूपाल शास्त्रोक्तं स्नेहद्वेषविवर्जितम् ।\nतदलं परितापेन सत्यं पालय भूपते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001772014, "chapter_id": 21772, "verse_number": "२-३३-१५", "content_sanskrit": "सत्यस्य पालनाद्राजन्विष्णुदेहेन युज्यते ।\nदेवैरुत्पादिता ह्येषा निकषा ते विमोहिनी ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001772015, "chapter_id": 21772, "verse_number": "२-३३-१६", "content_sanskrit": "मन्ये भूपाल सा पत्न्या कृता तां त्वं न बुध्यसे ।\nपुत्रव्यपादनाद्देवा भविष्यंति ह्यवाङ्मुखाः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001772016, "chapter_id": 21772, "verse_number": "२-३३-१७", "content_sanskrit": "तेषां दत्वा पदं मूर्ध्नि यास्यसे परमं पदम् ।\nविष्णोरुद्वहतां भक्तिं देवताः परिपंथिनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001772017, "chapter_id": 21772, "verse_number": "२-३३-१८", "content_sanskrit": "भविष्यत्यंधता लोके तदेव प्रकटीकृतम् ।\nविरुद्धा विबुधा भूप सेश्वरास्तव चेष्टितैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001772018, "chapter_id": 21772, "verse_number": "२-३३-१९", "content_sanskrit": "मोक्षमार्गप्रभेत्तारस्तव निश्चया लोपकाः ।\nस त्वं भूप दृढो भूत्वा घातयस्व सुतं प्रियम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001772019, "chapter_id": 21772, "verse_number": "२-३३-२०", "content_sanskrit": "मोहिन्याः कुरु वाक्यं तु आत्मनः सत्यपालनात् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001772020, "chapter_id": 21772, "verse_number": "२-३३-२१", "content_sanskrit": "लुप्तेऽपि वाक्ये भविता नृपेश पापं समं ब्रह्मवधेन घोरम् ।\nतंतासि लोके शमनस्य भूप यशःप्रणाशो भविता धरायाम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001772021, "chapter_id": 21772, "verse_number": "२-३३-२२", "content_sanskrit": "वसिष्ठ उवाच ।\nभार्याया वचनं श्रुत्वा राजा रुक्मांगदस्तदा ।\nसंध्यावलीमुवाचेदं मोहिन्याः सन्निधौ नृप ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001772022, "chapter_id": 21772, "verse_number": "२-३३-२३", "content_sanskrit": "पुत्रहत्या महाहत्या ब्रह्महत्याधिका प्रिये ।\nघातयित्वा सुतं लोके का गतिर्म्मे भविष्यति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001772023, "chapter_id": 21772, "verse_number": "२-३३-२४", "content_sanskrit": "क्व गतो मंदरं शैलं क्व प्राप्ता मोहिनी मया ।\nधर्मांगदविनाशाय देवि कालप्रिया त्वियम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001772024, "chapter_id": 21772, "verse_number": "२-३३-२५", "content_sanskrit": "धर्मज्ञं विनयोपेतं प्रजारंजनकारकम् ।\nअप्रजं च सुतं हत्वा का गतिर्मे भविष्याति ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001772025, "chapter_id": 21772, "verse_number": "२-३३-२६", "content_sanskrit": "कुपुत्रस्यापि हननाद्देवि दुःखं भवेत्पितुः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001772026, "chapter_id": 21772, "verse_number": "२-३३-२७", "content_sanskrit": "किं पुनर्द्धर्मशीलस्य गुरुसेवाविधायिनः ।\nजम्बूद्वीपमिदं भुक्तं मया तु वरवर्णिनि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001772027, "chapter_id": 21772, "verse_number": "२-३३-२८", "content_sanskrit": "द्वीपानि सप्त भुक्तानि तनयेन तवाधुना ।\nविष्णोरंशो वरारोहे पितुरप्यधिको भवेत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001772028, "chapter_id": 21772, "verse_number": "२-३३-२९", "content_sanskrit": "पुराणेषु वरारोहे कविभिः परिकीर्तितः ।\nयोऽयमत्यधिकः पुत्रो धर्मांगद इति क्षितौ ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001772029, "chapter_id": 21772, "verse_number": "२-३३-३०", "content_sanskrit": "मम वंशस्य चार्वंगि किं पुनर्मम मानदः ।\nअहो दुःखमनुप्राप्तं पुत्रादप्यधिकं मया ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001772030, "chapter_id": 21772, "verse_number": "२-३३-३१", "content_sanskrit": "पुनरेव वरारोहे ब्रूहि त्वं वचनैः शुभैः ।\nमोहिनीं मोहसंप्राप्तां मम दुःखप्रदायिनीम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001772031, "chapter_id": 21772, "verse_number": "२-३३-३२", "content_sanskrit": "एवमुक्त्वा तु नृपतिः प्रियां सन्ध्यावलीं तदा ।\nसमीपमागत्य नृपो मोहिनीमिदमब्रवीत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001772032, "chapter_id": 21772, "verse_number": "२-३३-३३", "content_sanskrit": "न भोक्ष्ये वासरे विष्णोर्न हिंस्ये तनयं शुभे ।\nआत्मानं दारयिष्यामि देवीं सन्ध्यावलीं तथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001772033, "chapter_id": 21772, "verse_number": "२-३३-३४", "content_sanskrit": "अन्यद्वा दारुणं कर्म करोमि तव शासनात् ।\nदुष्टाग्रहमिमं सुभ्रु परित्यज सुतं प्रति ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001772034, "chapter_id": 21772, "verse_number": "२-३३-३५", "content_sanskrit": "किं फलं भविता तुभ्यं हत्वा धर्मांगदं सुतम् ।\nभोजयित्वा दिने विष्णोः को लाभो भविता वद ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001772035, "chapter_id": 21772, "verse_number": "२-३३-३६", "content_sanskrit": "दासोऽस्मि तव भृत्योऽस्मि वशगोऽस्मि वरानने ।\nअन्यं याचस्व सुभगे वरं त्वां शरणं गतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001772036, "chapter_id": 21772, "verse_number": "२-३३-३७", "content_sanskrit": "रक्ताशोकसमानाभ्यां तव चार्वंगिसर्वशः ।\nअन्यत्प्रयोजनं किंचित्कर्त्ताऽस्मि वशगस्तव ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001772037, "chapter_id": 21772, "verse_number": "२-३३-३८", "content_sanskrit": "प्रसादं कुरु मे देवि पुत्रभिक्षां प्रयच्छ मे ।\nदुर्लभो गुणवान्पुत्रो दुर्लभो हरिवासरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001772038, "chapter_id": 21772, "verse_number": "२-३३-३९", "content_sanskrit": "दुर्लभः जाह्नवीतोयं दुर्लभा जननी क्षितौ ।\nदुर्लभं हि कुले जन्म दुर्लभा वंशजा प्रिया ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001772039, "chapter_id": 21772, "verse_number": "२-३३-४०", "content_sanskrit": "दुर्लभं कांचनं दानं दुर्लभं हरिपूजनम् ।\nदुर्लभा वैष्णवी दीक्षा दुर्लभः स्मृतिसंग्रहः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001772040, "chapter_id": 21772, "verse_number": "२-३३-४१", "content_sanskrit": "दुर्लभः शौकरे वासो दुर्लभं हरिचिन्तनम्  ।\nदुर्लभो जागरो विष्णोर्दुर्लभा ह्यात्मसत्क्रिया ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001772041, "chapter_id": 21772, "verse_number": "२-३३-४२", "content_sanskrit": "दुर्लभा पुत्रसंप्राप्तिर्दुर्लभं पौष्करं जलम् ।\nदुर्लभः शिष्टसंसर्गो दुर्लभा भक्तिरुच्यते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001772042, "chapter_id": 21772, "verse_number": "२-३३-४३", "content_sanskrit": "दुर्लभं कपिलादानं दुर्लभं नीलमोक्षणम् ।\nकृतं श्राद्धं त्रयोदश्यां दुर्लभं वरवर्णिनि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001772043, "chapter_id": 21772, "verse_number": "२-३३-४४", "content_sanskrit": "दुर्लभा वसुधा चीर्णं व्रतं पातकनाशनम् ।\nधेनुस्तिलमयी सुभ्रु दुर्लभा विप्रगामिनी ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001772044, "chapter_id": 21772, "verse_number": "२-३३-४५", "content_sanskrit": "धात्रीस्नानं वरारोहे दुर्लभो हरिवासरः ।\nदुर्लभं पर्वकाले तु स्नानं शीतलवारिणा ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001772045, "chapter_id": 21772, "verse_number": "२-३३-४६", "content_sanskrit": "माघमासे विशेषेण प्रत्यूषसमये शुभे ।\nयथाशास्त्रोदितं कर्म तद्देवि भुवि दुर्लभम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001772046, "chapter_id": 21772, "verse_number": "२-३३-४७", "content_sanskrit": "दुर्लभं कुशलं पथ्यं दुर्लभं चौषधं तथा ।\nव्याधेर्विघातकरणं दुर्लभं शास्त्रमार्गतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001772047, "chapter_id": 21772, "verse_number": "२-३३-४८", "content_sanskrit": "दुर्लभं स्मरणं विष्णोर्मरणे वरवर्णिनि ।\nएवं वचो वरारोहे कुरु मे धर्मरक्षकम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001772048, "chapter_id": 21772, "verse_number": "२-३३-४९", "content_sanskrit": "किं वधेनेवै चार्वंगि प्रसादं कर्तुमर्हसि ।\nसेविता विषयाः सम्यक्कृतं राज्यमकंटकम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001772049, "chapter_id": 21772, "verse_number": "२-३३-५०", "content_sanskrit": "मया मूर्घ्नि पदं दत्तं देवगोविप्ररक्षिणाम् ।\nअदृष्टविषयं पुत्रं नाहं हिंस्ये कदाचन ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001772050, "chapter_id": 21772, "verse_number": "२-३३-५१", "content_sanskrit": "स्वहस्तेनेह चार्वंगि किं नु पापमतः परम् ।\nमोहिन्युवाच ।\nधर्मांगदो न मे शत्रुर्नाहं हन्मि सुतं तव ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001772051, "chapter_id": 21772, "verse_number": "२-३३-५२", "content_sanskrit": "पूर्वमेव मया प्रोक्तं भुंक्ष्वत्वं हरिवासरे ।\nवसुधां स्वेच्छया राजंस्त्वं शाधि बहुवत्सरम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001772052, "chapter_id": 21772, "verse_number": "२-३३-५३", "content_sanskrit": "नाहं व्यापादये पुत्रमर्थसिद्धिस्तु भोजने ।\nमम भूमिपते कार्यं न पुत्रनिधने तव ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001772053, "chapter_id": 21772, "verse_number": "२-३३-५४", "content_sanskrit": "यदि पुत्रः प्रियो राजन्भुज्यतां हरिवासरे ।\nकिं विलापैर्महीपाल एतैर्द्धर्मबहिष्कृतैः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001772054, "chapter_id": 21772, "verse_number": "२-३३-५५", "content_sanskrit": "सत्यं संरक्ष यत्नेन कुरुष्व वचनं मम ।\nएवं ब्रुवाणां तां राजन्मोहिनीं तनुमध्यमाम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001772055, "chapter_id": 21772, "verse_number": "२-३३-५६", "content_sanskrit": "धर्मांगदः प्रत्युवाच दृष्ट्वा नत्वाग्रतः स्थितः ।\nएतदेव गृहाण त्वं मा शंकां कुरु भामिनि ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001772056, "chapter_id": 21772, "verse_number": "२-३३-५७", "content_sanskrit": "गृहीत्वा निर्मलं खङ्गं विन्यस्य नृपतेः पुरः ।\nआत्मानं च प्रत्युवाच सत्यधर्मव्यवस्थितः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001772057, "chapter_id": 21772, "verse_number": "२-३३-५८", "content_sanskrit": "न विलंबः पितः कार्यस्त्वया मम निपातने ।\nमन्मातुर्वचनं सत्यं कुरु भूप प्रतिश्रुतम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001772058, "chapter_id": 21772, "verse_number": "२-३३-५९", "content_sanskrit": "आत्मा रक्ष्यो धनैर्दारैरथवापि निजात्मजैः ।\nअपत्यं धर्मकामार्थं श्रेयस्कामस्य भूपतेः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001772059, "chapter_id": 21772, "verse_number": "२-३३-६०", "content_sanskrit": "त्वदर्थे मरणं मह्यमक्षय्य गतिदायकम् ।\nतवापि निर्मला लोकाः स्ववाक्यपरिपालनात् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001772060, "chapter_id": 21772, "verse_number": "२-३३-६१", "content_sanskrit": "परित्यज्य परं दुःखं पुत्रव्यापादनोद्भवम् ।\nदेहत्यागे ममारंभो नरदेहे भविष्यति ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001772061, "chapter_id": 21772, "verse_number": "२-३३-६२", "content_sanskrit": "सर्वामयविनिर्मुक्ते शतक्रतुसमे विभो ।\nपितुरर्थे हता ये तु मातुरर्थे हतास्तथा ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001772062, "chapter_id": 21772, "verse_number": "२-३३-६३", "content_sanskrit": "गवार्थे ब्राह्यणार्थे वा प्रमदार्थे महीपते ।\nभूम्यर्थे पार्थिवार्थे वा देवतार्थे तथैव च ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001772063, "chapter_id": 21772, "verse_number": "२-३३-६४", "content_sanskrit": "बालार्थे विकलार्थे च यांति लोकान्सुभास्वरान् ।\nतदलं परितापेन जहि मां त्वं वरासिना ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001772064, "chapter_id": 21772, "verse_number": "२-३३-६५", "content_sanskrit": "सत्यं पालय राजेंद्र मा भुंक्ष्व हरिवासरे ।\nधर्मार्थे तनयं हन्याद्भार्यां वापि महीपते ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001772065, "chapter_id": 21772, "verse_number": "२-३३-६६", "content_sanskrit": "श्रूयते वेदवाक्येषु पुत्रं हन्यान्मखस्थितः ।\nअश्वमेघे मखवरे न दोषो जायते नृप ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001772066, "chapter_id": 21772, "verse_number": "२-३३-६७", "content_sanskrit": "यद्ब्रवीति महीपाल मोहिनी जननी मम ।\nतत्त्वया ह्यविचारेण कर्त्तव्यं वचनं ध्रुवम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001772067, "chapter_id": 21772, "verse_number": "२-३३-६८", "content_sanskrit": "प्रसीद राजेंद्र कुरुष्व वाक्यं मयेरितं चात्मवधाय सत्यम् ।\nविमोचयेथा नृपते सुघोराद्वाक्यानृतान्मोहिनिहस्तयोगात् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001772068, "chapter_id": 21772, "verse_number": "२-३३-६९", "content_sanskrit": "वधेन ते भूमिपते सुतस्य यशः प्रकाशं गमयिष्यते च ।\nयशः प्रकाशाद्भविता हि कीर्तिस्तथाक्षया तात न संशयोऽत्र ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]