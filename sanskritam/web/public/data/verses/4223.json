[{"id": 2148892, "chapter_id": 4223, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148893, "chapter_id": 4223, "verse_number": "१", "content_sanskrit": "ततः शान्तनवं भीष्मं प्राञ्जलिर्धृतराष्ट्रजः ।\nसह सर्वैर्महीपालैरिदं वचनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148894, "chapter_id": 4223, "verse_number": "२", "content_sanskrit": "ऋते सेनाप्रणेतारं पृतना सुमहत्यपि ।\nदीर्यते युद्धमासाद्य पिपीलिकगणो यथा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148895, "chapter_id": 4223, "verse_number": "३", "content_sanskrit": "न हि जातु द्वयोर्बुद्धिः समा भवति कर्हिचित् ।\nशौर्यं च जायते नॄणां स्पर्धते च परस्परम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148896, "chapter_id": 4223, "verse_number": "४", "content_sanskrit": "श्रूयते च महाप्राज्ञ हेहयानमितौजसः ।\nअभ्ययुर्ब्राह्मणाः सर्वे समुच्छ्रितकुशध्वजाः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148897, "chapter_id": 4223, "verse_number": "५", "content_sanskrit": "तानन्वयुस्तदा वैश्याः शूद्राश्चैव पितामह ।\nएकतस्तु त्रयो वर्णाः एकतः क्षत्रियर्षभाः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148898, "chapter_id": 4223, "verse_number": "६", "content_sanskrit": "ते स्म युद्धे प्रभज्यन्ते त्रयो वर्णाः पुनः पुनः ।\nक्षत्रियाश्च जयन्त्येव बहुलं चैकतो बलम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148899, "chapter_id": 4223, "verse_number": "७", "content_sanskrit": "ततस्ते क्षत्रियानेव पप्रच्छुर्द्विजसत्तमाः ।\nतेभ्यः शशंसुर्धर्मज्ञा याथातथ्यं पितामह\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148900, "chapter_id": 4223, "verse_number": "८", "content_sanskrit": "वयमेकस्य शृणुमो महाबुद्धिमतो रणे ।\nभवन्तस्तु पृथक् सर्वे स्वबुद्धिवशवर्तिनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148901, "chapter_id": 4223, "verse_number": "९", "content_sanskrit": "ततस्ते ब्राह्मणाश्चक्रुरेकं सेनापतिं द्विजम् ।\nनयेषु कुशलं शूरमजयन् क्षत्रियांस्ततः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148902, "chapter_id": 4223, "verse_number": "१०", "content_sanskrit": "एवं ये कुशलं शूरं हिते स्थितमकल्मषम् ।\nसेनापतिं प्रकुर्वन्ति ते जयन्ति रणे रिपून्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148903, "chapter_id": 4223, "verse_number": "११", "content_sanskrit": "भवानुशनसा तुल्यो हितैषी च सदा मम ।\nअसंहार्यः स्थितो धर्मे स नः सेनापतिर्भव\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148904, "chapter_id": 4223, "verse_number": "१२", "content_sanskrit": "रश्मीवतामिवादित्यो वीरुधामिव चन्द्रमाः ।\nकुबेर इव यक्षाणां देवानामिव वासवः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148905, "chapter_id": 4223, "verse_number": "१३", "content_sanskrit": "पर्वतानां यथा मेरुः सुपर्णः पततामिव ।\nकुमार इव भूतानां वसूनामिव हव्यवाट्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148906, "chapter_id": 4223, "verse_number": "१४", "content_sanskrit": "भवता हि वयं गुप्ताः शक्रेणेव दिवौकसः ।\nअनाधृष्या भविष्यामः त्रिदशानामपि ध्रुवम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148907, "chapter_id": 4223, "verse_number": "१५", "content_sanskrit": "प्रयातु नो भवानग्रे देवानामिव पावकिः ।\nवयं त्वामनुयास्यामः सौरभेया इवर्षभम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148908, "chapter_id": 4223, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148909, "chapter_id": 4223, "verse_number": "१६", "content_sanskrit": "एवमेतन्महाबाहो यथा वदसि भारत ।\nयथैव हि भवन्तो मे तथैव मम पाण्डवाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148910, "chapter_id": 4223, "verse_number": "१७", "content_sanskrit": "अपि चैव मया श्रेयो वाच्यं तेषां नराधिप ।\nसुयोद्धव्यं तवार्थाय यथा मे समयः कृतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148911, "chapter_id": 4223, "verse_number": "१८", "content_sanskrit": "न तु पश्यामि योद्धारमात्मनः सदृशं भुवि ।\nऋते तस्मान्नरव्याघ्रात् कुन्तीपुत्राद् धनञ्जयात्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148912, "chapter_id": 4223, "verse_number": "१९", "content_sanskrit": "स हि वेद महाबुद्धिर्दिव्यान्यस्त्राण्यनेकशः ।\nन तु मां विवृतो युद्धे जातु युध्येत पाण्डवः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148913, "chapter_id": 4223, "verse_number": "२०", "content_sanskrit": "अहं स च क्षणेनैव निर्मनुष्यमिदं जगत् ।\nकुर्यावास्त्रबलेनैव ससुरासुरराक्षसम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148914, "chapter_id": 4223, "verse_number": "२१", "content_sanskrit": "न त्वेवोत्सादनीया मे पाण्डोः पुत्रा जनाधिप ।\nतस्माद् योधान् हनिष्यामि प्रयोगेणायुतं सदा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148915, "chapter_id": 4223, "verse_number": "२२", "content_sanskrit": "एवमेषां करिष्यामि निधनं कुरुनन्दन ।\nन चेत् ते मां हनिष्यन्ति पूर्वमेव समागमे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148916, "chapter_id": 4223, "verse_number": "२३", "content_sanskrit": "सेनापतिस्त्वहं राजन् समयेनापरेण ते ।\nभविष्यामि यथाकामं तन्मे श्रोतुमिहार्हसि\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148917, "chapter_id": 4223, "verse_number": "२४", "content_sanskrit": "कर्णो वा युध्यतां पूर्वमहं वा पृथिवीपते ।\nस्पर्धते हि सदाऽत्यर्थं सूतपुत्रो मया रणे\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148918, "chapter_id": 4223, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148919, "chapter_id": 4223, "verse_number": "२५", "content_sanskrit": "नाहं जीवति गाङ्गेये राजन् योत्स्ये कथञ्चन ।\nहते भीष्मे तु योत्स्यामि सह गाण्डीवधन्वना\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148920, "chapter_id": 4223, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2148921, "chapter_id": 4223, "verse_number": "२६", "content_sanskrit": "ततः सेनापतिं चक्रे विधिवद् भूरिदक्षिणम् ।\nधृतराष्ट्रात्मजो भीष्मं सोऽभिषिक्तो व्यरोचत\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2148922, "chapter_id": 4223, "verse_number": "२७", "content_sanskrit": "ततो भेरीश्च शङ्खांश्च शतशश्चैव पुष्करान् ।\nवादयामासुरव्यग्रा वादका राजशासनात्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148923, "chapter_id": 4223, "verse_number": "२८", "content_sanskrit": "सिंहनादाश्च विविधा वाहनानां च निस्वनाः ।\nनिर्घाताः पृथिवीकम्पो गजबृंहितनिस्वनाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2148924, "chapter_id": 4223, "verse_number": "२९", "content_sanskrit": "आसंश्च सर्वयोधानां पीडयन्तो मनांस्युत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2148925, "chapter_id": 4223, "verse_number": "३०", "content_sanskrit": "वाचश्चाप्यशरीरिण्यो दिवश्चोल्काः प्रपेदिरे ।\nप्रादुरासीदनभ्रे च वर्षं रुधिरकर्दमम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2148926, "chapter_id": 4223, "verse_number": "३१", "content_sanskrit": "शिवाश्च भयवेदिन्यो नेदुर्दीप्ततरा भृशम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2148927, "chapter_id": 4223, "verse_number": "३२", "content_sanskrit": "सेनापत्ये यदा राजा गाङ्गेयमभिषिक्तवान् ।\nतदैतान्युग्ररूपाणि बभूवुः शतशो नृप\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2148928, "chapter_id": 4223, "verse_number": "३३", "content_sanskrit": "ततः सेनापतिं कृत्वा भीष्मं परबलार्दनम् ।\nवाचयित्वा द्विजश्रेष्ठान् गोभिर्निष्कैश्च भूरिशः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2148929, "chapter_id": 4223, "verse_number": "३४", "content_sanskrit": "पूज्यमानो जयाशीर्भिर्निर्ययौ सैनिकैर्वृतः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2148930, "chapter_id": 4223, "verse_number": "३५", "content_sanskrit": "आपगेयं पुरस्कृत्य भ्रातृभिः सहितस्तदा ।\nस्कन्धावारेण महता कुरुक्षेत्रं जगाम ह\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2148931, "chapter_id": 4223, "verse_number": "३६", "content_sanskrit": "परिक्रम्य कुरुक्षेत्रं कर्णेन सह कौरवः ।\nशिबिरं मापयामास समे देशे जनाधिपः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2148932, "chapter_id": 4223, "verse_number": "३७", "content_sanskrit": "मधुरानूपके देशे प्रभूतयवसेन्धने ।\nयथैव हस्तिनपुरं शिबिरं तत् तथाऽभवत्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2148933, "chapter_id": 4223, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि चतुः- पञ्चाशोत्तरशततमोऽध्यायः ॥१५४॥ भीष्माभिषेचनपर्वणि द्वितीयोऽध्यायः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]