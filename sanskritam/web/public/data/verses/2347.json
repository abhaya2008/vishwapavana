[{"id": 2063289, "chapter_id": 2347, "verse_number": "८-६८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2063290, "chapter_id": 2347, "verse_number": "८-६८-१", "content_sanskrit": "ततो जनार्दनः श्रुत्वा तस्य वाक्यं विशाम्पते।\nरथेनापययौ क्षिप्रं सङ्ग्रामादिति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2063291, "chapter_id": 2347, "verse_number": "८-६८-२", "content_sanskrit": "प्रत्यनीकमवस्थाप्य भीमं भीमपराक्रमम्।\nअलं विषहितुं ह्येष कुरूणां सम्प्रपश्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2063292, "chapter_id": 2347, "verse_number": "८-६८-३", "content_sanskrit": "कर्णं च समरे राजन्ग्राहयिष्यञ्श्रमं प्रति।\nविश्वमार्थं च कौरव्य पार्थस्य च महात्मनः।\nअपयातो रणाद्वीरो राजानं द्रष्टुमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2063293, "chapter_id": 2347, "verse_number": "८-६८-४", "content_sanskrit": "अर्जुनं चाब्रवीत्कृष्णो भृशं राजा परिक्षतः।\nतमाश्वास्य कुरुश्रेष्ठ ततः कर्णं हनिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2063294, "chapter_id": 2347, "verse_number": "८-६८-५", "content_sanskrit": "ततो धनञ्जयः श्रुत्वा राजानं शल्यपीडितम्।\nयाहियाहिति बहुशो वासुदेवमचोदयत्।\nराजानं प्रति वार्ष्णेय दूयते मे दृढं मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2063295, "chapter_id": 2347, "verse_number": "८-६८-६", "content_sanskrit": "स चोद्यमानः पार्थेन केशिघ्नो वृष्णिनन्दनः।\nरथेनापययौ क्षिप्रं सङ्ग्रामाद्धोरदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2063296, "chapter_id": 2347, "verse_number": "८-६८-७", "content_sanskrit": "गच्छन्नेव तु कौन्तेयो धर्मराजदिदृक्षया।\nसैन्यमालोकयामास नापश्यत्तत्र चाग्रजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2063297, "chapter_id": 2347, "verse_number": "८-६८-८", "content_sanskrit": "युद्धं कृत्वा तु कौन्तेयो द्रोणपुत्रेण भारत।\nदुःसहं वज्रिणा सङ्ख्ये पराजित्य गुरोः सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2063298, "chapter_id": 2347, "verse_number": "८-६८-९", "content_sanskrit": "द्रौणिं पराजित्य ततोग्रधन्वा\nकृत्वा महद्दुष्करं शूरकर्म।\nआलोकयामास ततः स्वसैन्यं\nधनञ्जयः शत्रुभिरप्रधृष्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2063299, "chapter_id": 2347, "verse_number": "८-६८-१०", "content_sanskrit": "संयुध्यमानान्पृतनामुखस्था--\nञ्शूरः शूरान्हर्षयन्सव्यसाची।\nपूर्वापदानैः प्रथितैः प्रशंस--\nन्स्थितांश्चकारात्मरथाननीके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2063300, "chapter_id": 2347, "verse_number": "८-६८-११", "content_sanskrit": "अपश्यमानस्तु किरीटमाली\nयुधिष्ठिरं भ्रातरमाजमीढम्।\nउवाच भीमं तरसाभ्युपेत्य\nराज्ञः प्रवृत्तिस्त्विह कुत्र चेति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2063301, "chapter_id": 2347, "verse_number": "८-६८-१२x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2063302, "chapter_id": 2347, "verse_number": "८-६८-१२", "content_sanskrit": "अपयात इतो राजा धर्मपुत्रो युधिष्ठिरः।\nकर्णबाणाभितप्ताङ्गो यदि जीवेत्कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2063303, "chapter_id": 2347, "verse_number": "८-६८-१३x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2063304, "chapter_id": 2347, "verse_number": "८-६८-१३", "content_sanskrit": "तस्माद्भवाञ्शीघ्रमितः प्रयातु\nज्ञातुं प्रवृत्तिं पुरुषर्षभस्य।\nनूनं स विद्धोऽतिभृशं पृषत्कैः\nकर्णेन राजा शिबिरं गतोऽसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2063305, "chapter_id": 2347, "verse_number": "८-६८-१४", "content_sanskrit": "यः सम्प्रहारैर्युधि सम्प्रवृत्ते\nद्रोणेन विद्धोऽतिभृशं तरस्वी।\nतस्थौ स तत्रापि जयप्रतीक्षो\nद्रोणेन यावन्न हतः किलासीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2063306, "chapter_id": 2347, "verse_number": "८-६८-१५", "content_sanskrit": "स संशयं गमितः पाण्डवाग्र्यः\nसङ्ख्येऽद्य कर्णेन महानुभावः।\nज्ञातुं प्रयाह्याशु तमद्य भीम\nस्थास्याम्यहं शत्रुगणान्निरुध्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2063307, "chapter_id": 2347, "verse_number": "८-६८-१६x", "content_sanskrit": "भीमसेन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2063308, "chapter_id": 2347, "verse_number": "८-६८-१६", "content_sanskrit": "त्वमेव जानीहि महानुभाव\nराज्ञः प्रवृत्तिं भरतर्षभस्य।\nअहं हि यद्यर्जुन याम्यमित्रा\nवदन्ति मां भीत इति प्रवीराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2063309, "chapter_id": 2347, "verse_number": "८-६८-१७", "content_sanskrit": "ततोऽब्रवीदर्जुनो भीमसेनं\nसंशप्तकाः प्रत्यनीकस्थिता मे।\nएतानहत्वाद्य मया न शक्य--\nमितोपयातुं रिपुसङ्खमध्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2063310, "chapter_id": 2347, "verse_number": "८-६८-१८", "content_sanskrit": "अथाब्रवीदर्जुनं भीमसेनः\nस्ववीर्यमासाद्य कुरुप्रवीर।\nसंशप्तकान्प्रतियोत्स्यामि सङ्ख्ये\nसर्वानहं याहि धनञ्जय त्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2063311, "chapter_id": 2347, "verse_number": "८-६८-१९", "content_sanskrit": "तद्भीमसेनस्य वचो निशम्य\nधनञ्जयो भ्रातुरमित्रमध्ये।\nद्रष्टुं कुरुश्रेष्ठमभिप्रयास्य--\nन्प्रोवाच वृष्णिप्रवरं तदानीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2063312, "chapter_id": 2347, "verse_number": "८-६८-२०x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2063313, "chapter_id": 2347, "verse_number": "८-६८-२०", "content_sanskrit": "`राजानं प्रति वार्ष्णेय दूयते मे दृढं मनः।\nचोदयाश्वान्हृषीकेश विहायैतद्बलार्णवम्।\nअजातशत्रुं राजानं द्रष्टुमिच्छामि केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2063314, "chapter_id": 2347, "verse_number": "८-६८-२१x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2063315, "chapter_id": 2347, "verse_number": "८-६८-२१", "content_sanskrit": "`तं रथ चोदयामास बीभत्सोर्वचनाद्धरिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2063316, "chapter_id": 2347, "verse_number": "८-६८-२२", "content_sanskrit": "ततो हयान्सर्वदाशार्हमुख्यः\nप्रचोदयन्भीममुवाच चेदम्।\nनैतच्चित्रं तव कर्माद्य भीम\nयास्यावहे जहि पार्थारिसङ्घान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2063317, "chapter_id": 2347, "verse_number": "८-६८-२३", "content_sanskrit": "ततो ययौ हृषीकेशो यत्र राजा युधिष्ठिरः।\nशीघ्राच्छीघ्रतरो राजन्वाजिभिर्गरुडोपमैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2063318, "chapter_id": 2347, "verse_number": "८-६८-२४", "content_sanskrit": "प्रत्यनीके त्ववस्थाप्य भीमसेनमरिन्दमम्।\nसन्दिश्य चैनं राजेन्द्र युद्धं प्रति वृकोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2063319, "chapter_id": 2347, "verse_number": "८-६८-२५", "content_sanskrit": "ततस्तु गत्वा पुरुषप्रवीरौ\nराजानमासाद्य शयानमेकम्।\nरथादुभौ प्रत्यवरुह्य तस्मा--\nद्ववन्दतुर्धर्मराजस्य पादौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2063320, "chapter_id": 2347, "verse_number": "८-६८-२६", "content_sanskrit": "`इत्येवमुपसङ्गृह्य उभौ तु पाञ्जली स्थितौ।\nशस्त्रक्षतौ महाराज रुधिरेण समुक्षितौ।\nनिहत्य वाहिनीं तुभ्यमपयातौ रणाजिरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2063321, "chapter_id": 2347, "verse_number": "८-६८-२७", "content_sanskrit": "तं दृष्ट्वा पुरुषव्याघ्रं क्षेमिणं पुरुषर्षभम्।\nमुदाभ्यनन्दतां कृष्णावश्विनाविव वासवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2063322, "chapter_id": 2347, "verse_number": "८-६८-२८", "content_sanskrit": "तावभ्यनन्दद्राजापि विवस्वानश्विनाविव।\nहते महासुरे जम्भे शक्रविष्णू यथा गुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2063323, "chapter_id": 2347, "verse_number": "८-६८-२९", "content_sanskrit": "मन्यमानो हतं कर्णं प्रीतः परपुरञ्जयः।\n`स भूत्वा पुरुषव्याघ्रो राजा तत्र युधिष्ठिरः।\nहर्षगद्गदया वाचा प्रीतः प्राह परन्तपः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2063324, "chapter_id": 2347, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे अष्टषष्टितमोऽध्यायः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]