[{"id": 7003021000, "chapter_id": 23021, "verse_number": "३-१-१", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम् ।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003021001, "chapter_id": 23021, "verse_number": "३-१-२", "content_sanskrit": "नारद उवाच ।\nश्रुतं प्रकृति खण्डं तदमृतार्णवमुत्तमम् ।\nसर्वोत्कृष्टमभीष्टं च मूढानां ज्ञानवर्दनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003021002, "chapter_id": 23021, "verse_number": "३-१-३", "content_sanskrit": "अधुना श्रीगणेशस्य खण्डं श्रोतुमिहागतः ।\nतज्जन्म चरितं नॄणां सर्वमङ्गलमङ्गलम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003021003, "chapter_id": 23021, "verse_number": "३-१-४", "content_sanskrit": "कथं जज्ञे सुरश्रेष्ठः पार्वत्या उदरे शुभे ।\nदेवी केन प्रकारेण चालभत्तादृशं सुतम्॥ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003021004, "chapter_id": 23021, "verse_number": "३-१-५", "content_sanskrit": "स चांशः कस्य देवस्य कथं जन्म ललाभ सः ।\nअयोनिसम्भवः किं वा किं वाऽसौ योनिसम्भवः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003021005, "chapter_id": 23021, "verse_number": "३-१-६", "content_sanskrit": "किं वा तद्ब्रह्मतेजो वा किं तस्य च पराक्रमः ।\nका तपस्या च कि ज्ञानं किं वा तन्निर्म्मलं यशः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003021006, "chapter_id": 23021, "verse_number": "३-१-७", "content_sanskrit": "कथं तस्य पुरःपूजा विश्वेषु निखिलेषु च ।\nस्थिते नारायणे शम्भौ जगदीशे च धातरि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003021007, "chapter_id": 23021, "verse_number": "३-१-८", "content_sanskrit": "पुराणेषु निगूढं च तज्जन्म परिकीर्त्तितम् ।\nकथं वा गजवक्त्रोऽयमेकदन्तो महोदरः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003021008, "chapter_id": 23021, "verse_number": "३-१-९", "content_sanskrit": "एतत्सर्वं समाचक्ष्व श्रोतुं कौतूहलं मम ।\nसुविस्तीर्णं महाभाग तदतीव मनोहरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003021009, "chapter_id": 23021, "verse_number": "३-१-१०", "content_sanskrit": "श्रीनारायण उवाच ।\nशृणु नारद वक्ष्यामि रहस्यं परमाद्भुतम् ।\nपापसन्तापहरणं सर्वविघ्नविनाशनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003021010, "chapter_id": 23021, "verse_number": "३-१-११", "content_sanskrit": "सर्वमङ्गलदं सारं सर्वश्रुतिमनोहरम् ।\nसुखदं मोक्षबीजं च पापमूलनिकृन्तनम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003021011, "chapter_id": 23021, "verse_number": "३-१-१२", "content_sanskrit": "दैत्यार्दितानां देवानां तेजोराशिसमुद्भवा ।\nदेवी संहृत्य दैत्यौघान्दक्षकन्या बभूव ह ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003021012, "chapter_id": 23021, "verse_number": "३-१-१३", "content_sanskrit": "सा च नाम्ना सती देवी स्वामिनो निन्दया पुरा ।\nदेहं संत्यज्य योगेन जाता शैलप्रियोदरे ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003021013, "chapter_id": 23021, "verse_number": "३-१-१४", "content_sanskrit": "शङ्कराय ददौ तां च पार्वतीं पर्वतो मुदा ।\nतां गृहीत्वा महादेवो जगाम विजनं वनम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003021014, "chapter_id": 23021, "verse_number": "३-१-१५", "content_sanskrit": "शय्यां रतिकरीं कृत्वा पुष्पचन्दनचर्चिताम् ।\nस रेमे नर्मदातीरे पुष्पोद्याने तया सह ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003021015, "chapter_id": 23021, "verse_number": "३-१-१६", "content_sanskrit": "सहस्रवर्षपर्य्यन्तं दैवमानेन नारद ।\nतयोर्बभूव शृंगारो विपरीतादिको महान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003021016, "chapter_id": 23021, "verse_number": "३-१-१७", "content_sanskrit": "दुर्गांगस्पर्शमात्रेण मदनान्मूर्च्छितः शिवः ।\nमूर्च्छिता सा शिवस्पर्शाद्बुबुधे न दिवानिशम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003021017, "chapter_id": 23021, "verse_number": "३-१-१८", "content_sanskrit": "हंसकारण्डवाकीर्णे पुंस्कोकिलरुताकुले ।\nनानापुष्पविकासाढ्ये भ्रमरध्वनिगुञ्जिते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003021018, "chapter_id": 23021, "verse_number": "३-१-१९", "content_sanskrit": "सुगन्धिकुसुमाश्लेषिवायुना सुरभीकृते ।\nअतीव सुखदे तत्र सर्वजन्तुविवर्जिते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003021019, "chapter_id": 23021, "verse_number": "३-१-२०", "content_sanskrit": "दृष्ट्वा तयोस्तच्छृङ्गारं चिन्तां प्रापुः सुराः पराम् ।\nब्रह्माणं च पुरस्कृत्य ययुर्नारायणान्तिकम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003021020, "chapter_id": 23021, "verse_number": "३-१-२१", "content_sanskrit": "तं नत्वा कथयामास ब्रह्मा वृत्तान्तमीप्सितम् ।\nसंतस्थुर्देवताः सर्वाश्चित्रपुत्तलिका यथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003021021, "chapter_id": 23021, "verse_number": "३-१-२२", "content_sanskrit": "ब्रह्मोवाच ।\nसहस्रवर्षपर्य्यन्तं देवमानेन शङ्करः ।\nरतौ रतश्च निश्चेष्टो न योगी विरराम ह ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003021022, "chapter_id": 23021, "verse_number": "३-१-२३", "content_sanskrit": "मैथुनस्य विरामे च दम्पत्योर्जगदीश्वर  ।\nकिम्भूतं भविताऽपत्यं तथ्यं कथितुमर्हसि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003021023, "chapter_id": 23021, "verse_number": "३-१-२४", "content_sanskrit": "श्रीभगवानुवाच ।\nचिन्ता नास्ति जगद्धातः सर्व भद्रं भविष्यति॥ ।\nमयि ये शरणापन्नास्तेषां दुखं कुतो विधे ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003021024, "chapter_id": 23021, "verse_number": "३-१-२५", "content_sanskrit": "येनोपायेन तद्वीर्यं भूमौ पतति निश्चितम् ।\nतत्कुरुष्व प्रयत्नेन सार्द्धं देवगणेन च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003021025, "chapter_id": 23021, "verse_number": "३-१-२६", "content_sanskrit": "यदा च शम्भोर्वीर्य्यं तत्पार्वत्या उदरे पतेत् ।\nततोऽपत्यं च भविता सुरासुरविमर्दकम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003021026, "chapter_id": 23021, "verse_number": "३-१-२७", "content_sanskrit": "ततः शक्रादयः सर्वे सुरा नारायणाज्ञया ।\nप्रययुर्नर्म्मदातीरं ययौ ब्रह्मा निजालयम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003021027, "chapter_id": 23021, "verse_number": "३-१-२८", "content_sanskrit": "तत्रैव पर्वतद्रोणीबहिर्देशे सुराः पराः ।\nविषण्णवदनाः सर्वे बभूवुर्भयकातराः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003021028, "chapter_id": 23021, "verse_number": "३-१-२९", "content_sanskrit": "शक्रो राजा कुबेरं च कुबेरो वरुणं तथा ।\nसमीरणं च वरुणो यमं चैव समीरणः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003021029, "chapter_id": 23021, "verse_number": "३-१-३०", "content_sanskrit": "हुताशनं यमश्चैव भास्करं च हुताशनः ।\nचन्द्रं तथा भास्करश्च त्वीशानं चन्द्र एव च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003021030, "chapter_id": 23021, "verse_number": "३-१-३१", "content_sanskrit": "एवं देवाः प्रेरयन्ति देवांश्च रतिभञ्जने ।\nहरशृंगार भंगं च कुर्वित्युक्त्वा परस्परम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003021031, "chapter_id": 23021, "verse_number": "३-१-३२", "content_sanskrit": "द्वारि स्थितो वक्रशिराः शक्रः प्राह महेश्वरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003021032, "chapter_id": 23021, "verse_number": "३-१-३३", "content_sanskrit": "इन्द्र उवाच ।\nकिं करोषि महादेव योगीश्वर नमोऽस्तु ते ।\nजगदीश जगद्बीज भक्तानां भयभञ्जन ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003021033, "chapter_id": 23021, "verse_number": "३-१-३४", "content_sanskrit": "हरिर्जगामेत्युक्त्वा तमाजगाम च भास्करः ।\nउवाच भीतो द्वारस्थो भयार्त्तो वक्रचक्षुषा ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003021034, "chapter_id": 23021, "verse_number": "३-१-३५", "content_sanskrit": "श्रीसूर्य्य उवाच ।\nकिं करोषि महादेव जगतां परिपालक ।\nसुरश्रेष्ठ महाभाग पार्वतीश नमोऽस्तु ते ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003021035, "chapter_id": 23021, "verse_number": "३-१-३६", "content_sanskrit": "इत्येवमुक्त्वा श्रीसूर्य्यः स जगाम भयात्ततः ।\nआजगाम तथा चन्द्र अवोचद्वक्रकन्धरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003021036, "chapter_id": 23021, "verse_number": "३-१-३७", "content_sanskrit": "चन्द्र उवाच ।\nकिं करोषि त्रिलोकेश त्रिलोचन नमोऽस्तु ते ।\nआत्माराम स्वयंपूर्ण पुण्यश्रवणकीर्त्तन ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003021037, "chapter_id": 23021, "verse_number": "३-१-३८", "content_sanskrit": "इत्येवमुक्त्वा भीतश्च विरराम निशापतिः ।\nसमीरणोऽपि द्वारस्थस्संवीक्ष्योवाच सादरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003021038, "chapter_id": 23021, "verse_number": "३-१-३९", "content_sanskrit": "पवन उवाच ।\nकिं करोषि जगन्नाथ जगद्बन्धो नमो ऽस्तु ते ।\nधर्मार्थकाममोक्षाणां बीजरूप सनातन ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003021039, "chapter_id": 23021, "verse_number": "३-१-४०", "content_sanskrit": "इत्येवं स्तवनं श्रुत्वा योगज्ञानविशारदः ।\nत्यक्तुकामो न तत्याज शृङ्गारं पार्वती भयात् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003021040, "chapter_id": 23021, "verse_number": "३-१-४१", "content_sanskrit": "दृष्ट्वा सुरान्भयार्त्तश्च पुनः स्तोतुं समुद्यतान ।\nविजहौ सुखसम्भोगं कण्ठलग्नां च पार्वतीम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003021041, "chapter_id": 23021, "verse_number": "३-१-४२", "content_sanskrit": "उत्तिष्ठतो महेशस्य त्रासलज्जायुतस्य च ।\nभूमौ पपात तद्वीर्य्यं ततः स्कन्दो बभूव ह ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003021042, "chapter_id": 23021, "verse_number": "३-१-४३", "content_sanskrit": "पश्चात्तां कथयिष्यामि कथामतिमनोहराम् ।\nस्कन्दजन्मप्रसङ्गे च साम्प्रतं वाञ्छितं शृणु ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]