ोत्तमः । रामस्यवचनंसर्वमाख्यातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40019157, "chapter_id": 9304, "verse_number": "7", "content_sanskrit": "वैदेही कुशलीरामस्सहसुग्रीवलक्ष्मणः । वभीषणसहायश्चहरीणांसहितोबलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40019158, "chapter_id": 9304, "verse_number": "8", "content_sanskrit": "कुशलंचाहसिद्धार्थोहतशत्रुरिमत्रजित् । विभीषणसहायेनरामेणहरिभिस्सह ॥ निहतोरावणोदेविलक्ष्मणेन च वीर्यवान् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40019159, "chapter_id": 9304, "verse_number": "9", "content_sanskrit": "प्रियमाख्यामितेदेविभूयश्चत्वांसभाजये ॥ तवप्रभावाद्धर्मजेमहान् रामेणसंयुगे । लब्धोऽयंविजयस्सीतेस्वस्थाभवगतज्वरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40019160, "chapter_id": 9304, "verse_number": "10", "content_sanskrit": "प्रियमाख्यामितेदेविभूयश्चत्वांसभाजये ॥ तवप्रभावाद्धर्मजेमहान् रामेणसंयुगे । लब्धोऽयंविजयस्सीतेस्वस्थाभवगतज्वरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40019161, "chapter_id": 9304, "verse_number": "11", "content_sanskrit": "रावणश्चहतश्शत्रुर्लङ्कचैववशीकृता । मयाह्यलब्न्दिद्रेणधृतेनतवनिर्जये ॥ प्रतिज्ञैषाविनिस्तीर्णाबद्ध्वासेतुंमहोदधौ ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40019162, "chapter_id": 9304, "verse_number": "12", "content_sanskrit": "सम्भ्रमश्च न कर्तव्योवर्तन्त्यारावणालये ॥ विभीषणविधेयंहिलङ्कैश्वर्यमिदंकृतम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40019163, "chapter_id": 9304, "verse_number": "13", "content_sanskrit": "तदाश्वसिहिविस्रब्धंस्वगृहेपरिवर्तसे ॥ अयंचाभ्येतिसम्हृष्टस्त्वद्धर्शनसमुत्सुकः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40019164, "chapter_id": 9304, "verse_number": "14", "content_sanskrit": "एवमुक्तासमुत्पत्यसीताशशिनिभानना ॥ प्रहर्षेणावरुद्धासाव्याहर्तुं न शशाक ह ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40019165, "chapter_id": 9304, "verse_number": "15", "content_sanskrit": "ततोऽब्रवीद्धरिवरःसीतामप्रतिजल्पतीम् ॥ किंत्वंचिन्तयसेदेविकिं च मांनाभिभाषसे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40019166, "chapter_id": 9304, "verse_number": "16", "content_sanskrit": "एवमुक्ताहनुमतासीताधर्मपथेस्थिता ॥ अब्रवीत्परमप्रीताबाष्पगद्गदयागिरा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40019167, "chapter_id": 9304, "verse_number": "17", "content_sanskrit": "प्रियमेतदुपश्रुत्यभर्तुर्विजयसंश्रयम् ॥ प्रहर्षवशमापन्नानिर्वाक्यास्मिक्षणान्तरम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40019168, "chapter_id": 9304, "verse_number": "18", "content_sanskrit": "न हिपश्यामिसदृशंचिन्तयन्तीप्लवङ्गमा ॥ मप्रतियाब्यानकस्येहदातुंप्रत्यभिनन्दनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40019169, "chapter_id": 9304, "verse_number": "19", "content_sanskrit": "नहिपश्यामिततसौम्यपृथिव्यामपिवानर ॥ सदृशंयत्प्रियाख्यानेतवदत्त्वाभवेत्सुखम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40019170, "chapter_id": 9304, "verse_number": "20", "content_sanskrit": "