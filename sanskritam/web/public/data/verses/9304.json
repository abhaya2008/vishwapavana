[{"id": 5000304000, "chapter_id": 9304, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे द्वात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000304001, "chapter_id": 9304, "verse_number": "४-३२-१", "content_sanskrit": "अङ्गदस्य वचः श्रुत्वा सुग्रीवः सचिवैः सह।\nलक्ष्मणं कुपितं श्रुत्वा मुमोचासनमात्मवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000304002, "chapter_id": 9304, "verse_number": "४-३२-२", "content_sanskrit": "स च तानब्रवीद् वाक्यं निश्चित्य गुरुलाघवम्।\nमन्त्रज्ञान् मन्त्रकुशलो मन्त्रेषु परिनिष्ठितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000304003, "chapter_id": 9304, "verse_number": "४-३२-३", "content_sanskrit": "न मे दुर्व्याहृतं किंचिन्नापि मे दुरनुष्ठितम्।\nलक्ष्मणो राघवभ्राता क्रुद्धः किमिति चिन्तये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000304004, "chapter_id": 9304, "verse_number": "४-३२-४", "content_sanskrit": "असुहृद्भिर्ममामित्रैर्नित्यमन्तरदर्शिभिः।\nमम दोषानसम्भूतान् श्रावितो राघवानुजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000304005, "chapter_id": 9304, "verse_number": "४-३२-५", "content_sanskrit": "अत्र तावद् यथाबुद्धिः सर्वैरेव यथाविधि।\nभावस्य निश्चयस्तावद् विज्ञेयो निपुणं शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000304006, "chapter_id": 9304, "verse_number": "४-३२-६", "content_sanskrit": "न खल्वस्ति मम त्रासो लक्ष्मणान्नापि राघवात्।\nमित्रं स्वस्थानकुपितं जनयत्येव सम्भ्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000304007, "chapter_id": 9304, "verse_number": "४-३२-७", "content_sanskrit": "सर्वथा सुकरं मित्रं दुष्करं प्रतिपालनम्।\nअनित्यत्वात् तु चित्तानां प्रीतिरल्पेऽपि भिद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000304008, "chapter_id": 9304, "verse_number": "४-३२-८", "content_sanskrit": "अतो निमित्तं त्रस्तोऽहं रामेण तु महात्मना।\nयन्ममोपकृतं शक्यं प्रतिकर्तुं न तन्मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000304009, "chapter_id": 9304, "verse_number": "४-३२-९", "content_sanskrit": "सुग्रीवेणैवमुक्ते तु हनूमान् हरिपुंगवः।\nउवाच स्वेन तर्केण मध्ये वानरमन्त्रिणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000304010, "chapter_id": 9304, "verse_number": "४-३२-१०", "content_sanskrit": "सर्वथा नैतदाश्चर्यं यत् त्वं हरिगणेश्वर।\nन विस्मरसि सुस्निग्धमुपकारं कृतं शुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000304011, "chapter_id": 9304, "verse_number": "४-३२-११", "content_sanskrit": "राघवेण तु वीरेण भयमुत्सृज्य दूरतः।\nत्वत्प्रियार्थं हतो वाली शक्रतुल्यपराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000304012, "chapter_id": 9304, "verse_number": "४-३२-१२", "content_sanskrit": "सर्वथा प्रणयात् क्रुद्धो राघवो नात्र संशयः।\nभ्रातरं सम्प्रहितवाँल्लक्ष्मणं लक्ष्मिवर्धनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000304013, "chapter_id": 9304, "verse_number": "४-३२-१३", "content_sanskrit": "त्वं प्रमत्तो न जानीषे कालं कालविदां वर।\nफुल्लसप्तच्छदश्यामा प्रवृत्ता तु शरच्छुभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000304014, "chapter_id": 9304, "verse_number": "४-३२-१४", "content_sanskrit": "निर्मलग्रहनक्षत्रा द्यौः प्रणष्टबलाहका।\nप्रसन्नाश्च दिशः सर्वाः सरितश्च सरांसि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000304015, "chapter_id": 9304, "verse_number": "४-३२-१५", "content_sanskrit": "प्राप्तमुद्योगकालं तु नावैषि हरिपुंगव।\nत्वं प्रमत्त इति व्यक्तं लक्ष्मणोऽयमिहागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000304016, "chapter_id": 9304, "verse_number": "४-३२-१६", "content_sanskrit": "आर्तस्य हृतदारस्य परुषं पुरुषान्तरात्।\nवचनं मर्षणीयं ते राघवस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000304017, "chapter_id": 9304, "verse_number": "४-३२-१७", "content_sanskrit": "कृतापराधस्य हि ते नान्यत् पश्याम्यहं क्षमम्।\nअन्तरेणाञ्जलिं बद्‍ध्वा लक्ष्मणस्य प्रसादनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000304018, "chapter_id": 9304, "verse_number": "४-३२-१८", "content_sanskrit": "नियुक्तैर्मन्त्रिभिर्वाच्यो ह्यवश्यं पार्थिवो हितम्।\nइत एव भयं त्यक्त्वा ब्रवीम्यवधृतं वचः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000304019, "chapter_id": 9304, "verse_number": "४-३२-१९", "content_sanskrit": "अभिक्रुद्धः समर्थो हि चापमुद्यम्य राघवः।\nसदेवासुरगन्धर्वं वशे स्थापयितुं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000304020, "chapter_id": 9304, "verse_number": "४-३२-२०", "content_sanskrit": "न स क्षमः कोपयितुं यः प्रसाद्यः पुनर्भवेत्।\nपूर्वोपकारं स्मरता कृतज्ञेन विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000304021, "chapter_id": 9304, "verse_number": "४-३२-२१", "content_sanskrit": "तस्य मूर्ध्ना प्रणम्य त्वं सपुत्रः ससुहृज्जनः।\nराजंस्तिष्ठ स्वसमये भर्तुर्भार्येव तद्वशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000304022, "chapter_id": 9304, "verse_number": "४-३२-२२", "content_sanskrit": "न रामरामानुजशासनं त्वया\nकपीन्द्र युक्तं मनसाप्यपोहितुम्।\nमनो हि ते ज्ञास्यति मानुषं बलं\nसराघवस्यास्य सुरेन्द्रवर्चसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000304023, "chapter_id": 9304, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे द्वात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]