[{"id": 2145970, "chapter_id": 4148, "verse_number": "", "content_sanskrit": "नकुलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145971, "chapter_id": 4148, "verse_number": "१", "content_sanskrit": "उक्तं बहुविधं वाक्यं धर्मराजेन माधव ।\nधर्मज्ञेन वदान्येन धर्मयुक्तं च तत्वतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145972, "chapter_id": 4148, "verse_number": "२", "content_sanskrit": "मतमाज्ञाय राज्ञश्च भीमसेनेन माधव ।\nसंशमं बाहुवीर्यं च ख्यापितं माधवात्मनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145973, "chapter_id": 4148, "verse_number": "३", "content_sanskrit": "तथैव फल्गुनेनापि यदुक्तं तत् त्वया श्रुतम् ।\nआत्मनश्च मतं वीर कथितं भवताऽसकृत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145974, "chapter_id": 4148, "verse_number": "४", "content_sanskrit": "सर्वमेतदतिक्रम्य श्रुत्वा परमतं भवान् ।\nयत् प्राप्तकालं मन्येथाः तत् कुर्याः पुरुषोत्तम\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145975, "chapter_id": 4148, "verse_number": "५", "content_sanskrit": "तस्मिंस्तस्मिन् निमित्ते हि मतं भवति केशव ।\nप्राप्तकालं मनुष्येण स्वयं कार्यमरिन्दम\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145976, "chapter_id": 4148, "verse_number": "६", "content_sanskrit": "अन्यथा चिन्तितो ह्यर्थः पुनर्भवति सोऽन्यथा ।\nअनित्यबुद्धयो लोके नराः पुरुषसत्तम\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145977, "chapter_id": 4148, "verse_number": "७", "content_sanskrit": "अन्यथाबुद्धयो ह्यासन्नस्मासु वनवासिषु ।\nअदृश्येष्वन्यथा कृष्ण दृश्येषु पुनरन्यथा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145978, "chapter_id": 4148, "verse_number": "८", "content_sanskrit": "अस्माकमपि वार्ष्णेय वने विचरतां तदा ।\nन तथा प्रणयो राज्ये यथा सम्प्रति वर्तते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145979, "chapter_id": 4148, "verse_number": "९", "content_sanskrit": "निवृत्तवनवासान् नः श्रुत्वा वीर समागताः ।\nअक्षोहिण्यो हि सप्तेमाः त्वत्प्रसादाज्जनार्दन\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145980, "chapter_id": 4148, "verse_number": "१०", "content_sanskrit": "इमान् हि पुरुषव्याघ्रान् अचिन्त्यबलपौरुषान् ।\nआत्तशस्त्रान् रणे दृष्ट्वा न व्यथेदिह कः पुमान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145981, "chapter_id": 4148, "verse_number": "११", "content_sanskrit": "स भवान् कुरुमध्ये तं सान्त्वपूर्वं भयोत्तरम् ।\nब्रूयाद् वाक्यं यथाऽस्मत्तो न व्यथेत सुयोधनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145982, "chapter_id": 4148, "verse_number": "१२", "content_sanskrit": "युधिष्ठिरं भीमसेनं बीभत्सुं चापराजितम् ।\nसहदेवं च मां चैव त्वां च रामं च केशव\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145983, "chapter_id": 4148, "verse_number": "१३", "content_sanskrit": "सात्यकिं च महावीर्यं विराटं च सहात्मजम् ।\nद्रुपदं च सहामात्यं धृष्टद्युम्नं च पार्षतम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145984, "chapter_id": 4148, "verse_number": "१४", "content_sanskrit": "काशिराजं च विक्रान्तं धृष्टकेतुं च चेदिपम् ।\nमांसशोणितभृन्मर्त्यः प्रतियुध्येत को युधि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145985, "chapter_id": 4148, "verse_number": "१५", "content_sanskrit": "स भवान् गमनादेव साधयिष्यत्यसंशयम् ।\nइष्टमर्थं महाबाहो धर्मराजस्य केवलम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145986, "chapter_id": 4148, "verse_number": "१६", "content_sanskrit": "विदुरश्चैव भीष्मश्च द्रोणश्च सहबाह्लिकः ।\nश्रेयः समर्था विज्ञातुमुच्यमानास्त्वयाऽनघ\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145987, "chapter_id": 4148, "verse_number": "१७", "content_sanskrit": "ते चैनमनुनेष्यन्ति धृतराष्ट्रं जनाधिपम् ।\nतं च पापसमाचारं सहामात्यं सुयोधनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145988, "chapter_id": 4148, "verse_number": "१८", "content_sanskrit": "श्रोता चार्थस्य विदुरः त्वं च वक्ता जनार्दन ।\nकिमिवार्थं निवर्तेथाः स्थापयेथा न वर्त्मनि\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145989, "chapter_id": 4148, "verse_number": "", "content_sanskrit": "सहदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2145990, "chapter_id": 4148, "verse_number": "१९", "content_sanskrit": "यदेतत् कथितं राज्ञा धर्म एष सनातनः ।\nयथा च युद्धमेव स्यात् तथा कार्यमरिन्दम\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2145991, "chapter_id": 4148, "verse_number": "२०", "content_sanskrit": "यदि प्रशममिच्छेयुः विनाशे पाण्डवैः सह ।\nतथापि युद्धं दाशार्ह योजयेथाः सहैव तैः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2145992, "chapter_id": 4148, "verse_number": "२१", "content_sanskrit": "कथं नु दृष्ट्वा पाञ्चालीं तथा क्लिष्टां सभागताम् ।\nअवधेन प्रशाम्येत मम मन्युः सुयोधने\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2145993, "chapter_id": 4148, "verse_number": "२२", "content_sanskrit": "यदि भीमार्जुनौ कृष्ण धर्मराजश्च धार्मिकः ।\nधर्ममुत्सृज्य तेनाहं योद्धुमिच्छामि संयुगे\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2145994, "chapter_id": 4148, "verse_number": "२३", "content_sanskrit": "ब्रूहि मद्वचनं कृष्ण सुयोधनमधार्मिकम् ।\nकृच्छ्रे वने वा वस्तव्यं पुरे वा नागसाह्वये\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2145995, "chapter_id": 4148, "verse_number": "", "content_sanskrit": "सात्यकिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2145996, "chapter_id": 4148, "verse_number": "२४", "content_sanskrit": "सत्यमाह महाबाहो सहदेवो महामतिः ।\nदुर्योधनवधे शान्तिस्तस्य कोपस्य मे भवेत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2145997, "chapter_id": 4148, "verse_number": "२५", "content_sanskrit": "न जानासि यथा दृष्ट्वा चीराजिनधरान् वने ।\nतवापि मन्युरुद्भूतो दुःखितान् प्रेक्ष्य पाण्डवान्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2145998, "chapter_id": 4148, "verse_number": "२६", "content_sanskrit": "तस्मान्माद्रीसुतः शूरो यदाह पुरुषर्षभ ।\nवचनं सर्वयोधानां तन्मतं पुरुषोत्तम\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2145999, "chapter_id": 4148, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2146000, "chapter_id": 4148, "verse_number": "२७", "content_sanskrit": "एवं वदति वाक्यं तु युयुधाने महामतौ ।\nसुभीमः सिंहनादोऽभूत् योधानां तत्र सर्वशः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2146001, "chapter_id": 4148, "verse_number": "२८", "content_sanskrit": "सर्वे हि सर्वशो वीराः तद्वचः प्रत्यपूजयन् ।\nसाधु साध्विति शेनैयं हर्षयन्तो युयुत्सवः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2146002, "chapter_id": 4148, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्याम् उद्योगपर्वणि एकोनाशीतितमोऽध्यायः ॥७९॥\nभगवद्यानपर्वणि दशमोऽध्यायः ॥१०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]