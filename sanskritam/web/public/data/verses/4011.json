[{"id": 2139135, "chapter_id": 4011, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2139136, "chapter_id": 4011, "verse_number": "१", "content_sanskrit": "अकीर्तयत सुश्रोणी धर्मं शक्रं दिवाकरम् ।\nमारुतं चाश्विनौ देवौ कुबेरं वरुणं यमम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2139137, "chapter_id": 4011, "verse_number": "२", "content_sanskrit": "रुद्रमग्निं भगं विष्णुं स्कन्दं पूषणमेव च ।\nसावित्रीसहितं चापि ब्रह्माणं पर्यकीर्तयत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2139138, "chapter_id": 4011, "verse_number": "३", "content_sanskrit": "इत्येवं मृगशाबाक्षी सुश्रोणी धर्मचारिणी ।\nउपातिष्ठत सा सूर्यं मुहूर्तमबला तदा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2139139, "chapter_id": 4011, "verse_number": "४", "content_sanskrit": "स तस्य तनुमध्यायाः सर्वं सूर्योऽवबुद्धवान् ।\nअन्तर्हितं ततस्तस्या रक्षो रक्षार्थमादिशत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2139140, "chapter_id": 4011, "verse_number": "५", "content_sanskrit": "तच्चैनां नाजहात् तत्र सर्वावस्थास्वनिन्दिताम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2139141, "chapter_id": 4011, "verse_number": "६", "content_sanskrit": "सा प्रतस्थे सुकेशान्ता त्वरमाणा पुनः पुनः ।\nविळम्बमाना विवशा कीचकस्य निवेशनम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2139142, "chapter_id": 4011, "verse_number": "७", "content_sanskrit": "तां मृगीमिव वित्रस्तां दृष्ट्वा हृष्टः समागताम् ।\nउत्पपातासनात् तूर्णं नावं लब्ध्वेव पारगः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2139143, "chapter_id": 4011, "verse_number": "८", "content_sanskrit": "श्लक्ष्णं चोवाच वाक्यं स कीचकः काममूर्च्छितः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2139144, "chapter_id": 4011, "verse_number": "९", "content_sanskrit": "स्वागतं ते सुकेशान्ते सुव्युष्टा रजनी मम ।\nसाधु मे त्वमनुप्राप्ता चिरस्य भवनं तु मे\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2139145, "chapter_id": 4011, "verse_number": "१०", "content_sanskrit": "कुरुष्व च मयि प्रीतिं वशं चोपानयस्व माम् ।\nप्रतिगृह्णीष्व मे भोगान् त्वदर्थमुपकल्पितान्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2139146, "chapter_id": 4011, "verse_number": "११", "content_sanskrit": "सर्वरुग्ममयीं मालां कुण्डले च हिरण्मये\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2139147, "chapter_id": 4011, "verse_number": "१२", "content_sanskrit": "अनर्घ्यानि च दिव्यानि कौशिकान्यजिनानि च ।\nअस्ति मे शयनं दिव्यं त्वदर्थमुपकल्पितम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2139148, "chapter_id": 4011, "verse_number": "१३", "content_sanskrit": "रोह तत्र मया सार्धं पिब शुद्धां च वारुणीम् ।\nवासांसि चन्दनं माल्यं धूपशुद्धां च वारुणीम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2139149, "chapter_id": 4011, "verse_number": "१४", "content_sanskrit": "प्रतिगृह्णीष्व सुश्रोणि विहर त्वं यथेच्छसि\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2139150, "chapter_id": 4011, "verse_number": "१५", "content_sanskrit": "प्रीत्या मे कुरु पद्माक्षि प्रसादं प्रियदर्शने\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2139151, "chapter_id": 4011, "verse_number": "१६", "content_sanskrit": "स्वास्तीर्णमस्ति शयनं सितसूक्ष्मोत्तरच्छदम् ।\nअत्रारुह्य मया सार्धं पिबेमां वरवारुणीम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2139152, "chapter_id": 4011, "verse_number": "१७", "content_sanskrit": "भजस्व मां विशालाक्षि भर्ता ते सदृशोऽस्म्यहम् ।\nउपसर्प वरारोहे मेरुमर्कप्रभा यथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2139153, "chapter_id": 4011, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2139154, "chapter_id": 4011, "verse_number": "१८", "content_sanskrit": "सम्मूढः कीचकस्तत्र प्राप्तां राजीवलोचनाम् ।\nअब्रवीद् द्रौपदीं दृष्ट्वा दुरात्मा ह्यात्मसम्मतेः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2139155, "chapter_id": 4011, "verse_number": "१९", "content_sanskrit": "कीचकेनैवमुक्ता तु पाञ्चाली वरभाषिणी ।\nअब्रवीत् तमनाचारं नेदृशं वक्तुमर्हसि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2139156, "chapter_id": 4011, "verse_number": "२०", "content_sanskrit": "नाहं शक्या त्वया स्प्रष्टुं श्वपाकेनेव ब्राह्मणी ।\nमा गमिष्यसि दुर्बुद्धे गतिं दुर्गान्तरान्तराम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2139157, "chapter_id": 4011, "verse_number": "२१", "content_sanskrit": "यत्र गच्छन्ति बहवः परदाराभिमर्शकाः ।\nनराः सम्भिन्नमर्यादाः कीटपुञ्जगुहाशयाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2139158, "chapter_id": 4011, "verse_number": "२२", "content_sanskrit": "अप्रैषीन्मां सुराहारीं सुदेष्णा त्वन्निवेशनम् ।\nतस्यै त्वं देहि मदिरां भगिनी तृषिता तव\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2139159, "chapter_id": 4011, "verse_number": "२३", "content_sanskrit": "पिपासिता च कैकेयी तूर्णं मामादिशत् ततः ।\nदीयतां मे सुरा शीघ्रं सूतपुत्र व्रजाम्यहम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2139160, "chapter_id": 4011, "verse_number": "", "content_sanskrit": "कीचकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2139161, "chapter_id": 4011, "verse_number": "२४", "content_sanskrit": "अन्या भद्रे हरिष्यन्ति राजपुत्र्याः सुरामिमाम् ।\nकिं त्वं यास्यसि सुश्रोणि मदर्थं त्वमिहागता\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2139162, "chapter_id": 4011, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2139163, "chapter_id": 4011, "verse_number": "२५", "content_sanskrit": "इत्युक्त्वा दक्षिणे पाणौ सूतपुत्रः परामृशत् ।\nसा गृहीता विधून्वन्ती भूमौ निक्षिप्य भाजनम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2139164, "chapter_id": 4011, "verse_number": "२६", "content_sanskrit": "सभां शरणमाधावद् यत्र राजा युधिष्ठिरः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2139165, "chapter_id": 4011, "verse_number": "२७", "content_sanskrit": "तां कीचकः प्रधावन्तीं केशपक्षे परामृशत् ।\nपातयित्वा च तां भूमौ सूतपुत्रः पदाऽवधीत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2139166, "chapter_id": 4011, "verse_number": "२८", "content_sanskrit": "सभायां पश्यतो राज्ञो विराटस्य महात्मनः ।\nब्राह्मणानां च वृद्धानां क्षत्रियाणां च पश्यताम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2139167, "chapter_id": 4011, "verse_number": "२९", "content_sanskrit": "तस्याः पादाभितप्ताया मुखाद् रुधिरमास्रवत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2139168, "chapter_id": 4011, "verse_number": "३०", "content_sanskrit": "ततो दिवाकरेणाशु राक्षसः सन्नियोजितः ।\nस कीचकमपोवाह वातवेगेन भारत\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2139169, "chapter_id": 4011, "verse_number": "३१", "content_sanskrit": "स पपात तदा भूमौ रक्षोबलसमीरितः ।\nविघूर्णमानो निश्चेष्टः छिन्नमूल इव द्रुमः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2139170, "chapter_id": 4011, "verse_number": "३२", "content_sanskrit": "तां दृष्ट्वा तत्र ते सभ्या हाहाभूताः समन्ततः ।\nन युक्तं सूतपुत्रेण कीचकेति च मानवाः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2139171, "chapter_id": 4011, "verse_number": "३३", "content_sanskrit": "किमिदं वध्यते बाला कृपणा चाप्यबान्धवा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2139172, "chapter_id": 4011, "verse_number": "३४", "content_sanskrit": "तत्रासीनौ ददृशतुर्युधिष्ठिरवृकोदरौ ।\nअमृष्यमाणौ कृष्णायाः कीचकेन पदा वधम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2139173, "chapter_id": 4011, "verse_number": "३५", "content_sanskrit": "तां दृष्ट्वा भीमसेनस्य क्रोधादस्तमवर्तत ।\nधूमोच्छ्वासः समभवन्नेत्रे चोच्छ्रितपक्ष्मणी\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2139174, "chapter_id": 4011, "verse_number": "३६", "content_sanskrit": "सस्वेदा भ्रुकुटी चोग्रा ललाटे समवर्तत\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2139175, "chapter_id": 4011, "verse_number": "३७", "content_sanskrit": "तस्य भीमो वधप्रेप्सुः कीचकस्य महामनाः ।\nदन्तैर्दन्तांस्तथा रोषान्निष्पिपेष महामनाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2139176, "chapter_id": 4011, "verse_number": "३८", "content_sanskrit": "अङ्गुष्ठेन परामृष्ट्वा ललाटं परवीरहा\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2139177, "chapter_id": 4011, "verse_number": "३९", "content_sanskrit": "भूयः सन्त्वरितः क्रुद्धः सहसोत्थाय चासनात् ।\nनिरैक्षत द्रुमं दीर्घं राजानं चान्ववैक्षत\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2139178, "chapter_id": 4011, "verse_number": "४०", "content_sanskrit": "वधमाकाङ्क्षमाणं तं कीचकस्य दुरात्मनः ।\nआकारेण तु भीमं स प्रत्यषेधद् युधिष्ठिरः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2139179, "chapter_id": 4011, "verse_number": "४१", "content_sanskrit": "तस्य राजा शनैः सञ्ज्ञां कुन्तीपुत्रो युधिष्ठिरः ।\nचकार भीमसेनस्य पाण्डुपुत्रस्य धीमतः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2139180, "chapter_id": 4011, "verse_number": "४२", "content_sanskrit": "उपासीनं तदा चाह कङ्को नाम युधिष्ठिरः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2139181, "chapter_id": 4011, "verse_number": "४३", "content_sanskrit": "सूद मा साहसं कार्षीः फलितोऽयं वनस्पतिः।\nनात्र शुष्काणि काष्ठानि साधनीयानि कानिचित्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2139182, "chapter_id": 4011, "verse_number": "४४", "content_sanskrit": "यदि ते दारुकृत्यं स्यान्निष्क्रम्य नगराद् बहिः ।\nसमूलं शातयेर्वृक्षं श्रमस्ते न भविष्यति\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2139183, "chapter_id": 4011, "verse_number": "४५", "content_sanskrit": "यस्य चार्द्रस्य वृक्षस्य शीतच्छायां समाश्रयेत् ।\nन तस्य पर्णे द्रुह्येत पूर्ववृत्तमनुस्मरन्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2139184, "chapter_id": 4011, "verse_number": "४६", "content_sanskrit": "न क्रोधकालसमयो जहि मा चापलं कुरु ।\nअपूर्णोऽयं विपक्षोनो नैतद् बलवतां बहु\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2139185, "chapter_id": 4011, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2139186, "chapter_id": 4011, "verse_number": "४७", "content_sanskrit": "अथाङ्गुष्ठेनेव गृह्णन् अङ्गुष्ठं तत्र धर्मराट् ।\nप्रबोधनभयाद् राजन् भीमस्य प्रत्यषेधयत्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2139187, "chapter_id": 4011, "verse_number": "४८", "content_sanskrit": "भीमसेनस्तु तद्वाक्यं श्रुत्वा परपुरञ्जयः ।\nसहसोत्पतितं कोपं न्ययच्छद् धृतिमान् बलात्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2139188, "chapter_id": 4011, "verse_number": "४९", "content_sanskrit": "इङ्गितज्ञः स तु भ्रातुः तूष्णीमासीद् वृकोदरः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2139189, "chapter_id": 4011, "verse_number": "५०", "content_sanskrit": "भीमस्य च समारम्भं दृष्ट्वा राज्ञश्च चेष्टितम् ।\nद्रौपद्यभ्यधिकं क्रुद्धा प्रारुदत् सा पुनः पुनः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2139190, "chapter_id": 4011, "verse_number": "५१", "content_sanskrit": "कीचकेनानुगमनात् कृष्णा ताम्रायतेक्षणा ।\nसभाद्वारमुपागम्य रुदन्ती वाक्यमब्रवीत्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2139191, "chapter_id": 4011, "verse_number": "५२", "content_sanskrit": "अवेक्षमाणा सुश्रोणी पतींस्तान् दीनमानसान् ।\nआकारं परिरक्षन्ती प्रतिज्ञां धर्मसंयुताम्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2139192, "chapter_id": 4011, "verse_number": "५३", "content_sanskrit": "दह्यमानेन रौद्रेण चक्षुषा द्रुपदात्मजा\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2139193, "chapter_id": 4011, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2139194, "chapter_id": 4011, "verse_number": "५४", "content_sanskrit": "प्रजारक्षणशीलानां राज्ञाममिततेजसाम् ।\nकार्यं हि पालनं नित्यं धर्मे सत्ये प्रतिष्ठताम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2139195, "chapter_id": 4011, "verse_number": "५५", "content_sanskrit": "स्वप्रजायां प्रजायां च विशेषं नाधिगच्छताम् ।\nप्रियेष्वपि च द्वेष्येषु समत्वं ये समाश्रिताः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2139196, "chapter_id": 4011, "verse_number": "५६", "content_sanskrit": "विवादेषु प्रवृत्तेषु समं कार्यानुदर्शिना ।\nराज्ञा धर्मासनस्थेन जितौ लोकावुभावपि\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2139197, "chapter_id": 4011, "verse_number": "५७", "content_sanskrit": "राजन् धर्मासनस्थोऽसि रक्ष मां त्वमनागसीम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2139198, "chapter_id": 4011, "verse_number": "५८", "content_sanskrit": "अहं त्वनपराधा च कीचकेन दुरात्मना ।\nपश्यतस्ते महाराज हता पादेन दासिवत्\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2139199, "chapter_id": 4011, "verse_number": "५९", "content_sanskrit": "त्वत्समक्षं नृपश्रेष्ठ निष्पिष्टा वसुधातळे ।\nअनागसीं कृपार्हां मां स्त्रियं त्वं परिपालय\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2139200, "chapter_id": 4011, "verse_number": "६०", "content_sanskrit": "रक्ष मां कीचकाद् भीतां धर्मं रक्ष नरेश्वर ।\nमत्स्याधिप प्रजा रक्ष पिता पुत्रानिवौरसान्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2139201, "chapter_id": 4011, "verse_number": "६१", "content_sanskrit": "यस्त्वधर्माणि कार्याणि मोहाद्वा कुरुते नृपः ।\nअचिरात् तं दुरात्मानं वशे कुर्वन्ति शत्रवः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2139202, "chapter_id": 4011, "verse_number": "६२", "content_sanskrit": "मात्स्यानां कुलजस्त्वं हि तेषां सत्यं परायणम् ।\nत्वं किलैवंविधे जातः कुले धर्मपरायणे\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2139203, "chapter_id": 4011, "verse_number": "६३", "content_sanskrit": "अतस्त्वाऽहमभिक्रन्दे शरणार्थं नराधिप ।\nत्राहि मामद्य राजेन्द्र कीचकात् पापपूरुषात्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2139204, "chapter_id": 4011, "verse_number": "६४", "content_sanskrit": "अनाथामिति मां ज्ञात्वा कीचकः पुरुषाधमः ।\nप्रहरत्येव नीचात्मा न च धर्ममवेक्षते\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2139205, "chapter_id": 4011, "verse_number": "६५", "content_sanskrit": "अकार्याणामनारम्भात् कार्याणामनुपालनात् ।\nप्रजासु ये प्रवृत्तास्ते स्वर्गमायान्ति भूमिपाः\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2139206, "chapter_id": 4011, "verse_number": "६६", "content_sanskrit": "कार्याकार्यविशेषज्ञाः कामकारेण पार्थिवाः ।\nप्रजासु किल्बिषं कृत्वा नरकं यान्त्यधोमुखाः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2139207, "chapter_id": 4011, "verse_number": "६७", "content_sanskrit": "नैव यज्ञैर्न वा दानैर्न गुरोरुपसेवया ।\nप्राप्नुवन्ति तथा धर्मं यथा कार्यानुपालनात्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2139208, "chapter_id": 4011, "verse_number": "६८", "content_sanskrit": "अपि चैतत् पुरा ब्रह्मा प्रोवाचेन्द्राय पृच्छते ।\nद्वन्द्वं कार्यमकार्यं च लोकेष्वासीत् परं यथा\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2139209, "chapter_id": 4011, "verse_number": "६९", "content_sanskrit": "धर्माधर्मौ पुनर्द्वन्द्वं विनियुक्तमथापि वै ।\nक्रियाणामक्रियाणां च प्रवणे पुण्यपापयोः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2139210, "chapter_id": 4011, "verse_number": "७०", "content_sanskrit": "प्रजायां सृज्यमानायां पुरा ह्येतदुदाहृतम् ।\nएतद्वै मानुषं सम्यक् कार्यं द्वन्द्वत्रयं भुवि\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2139211, "chapter_id": 4011, "verse_number": "७१", "content_sanskrit": "अस्मिन् सुनीते दुर्नीते सभ्यास्ते कर्मजं फलम् ।\nकल्याणकारी कल्याणं पापकारी च पापकम्\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2139212, "chapter_id": 4011, "verse_number": "७२", "content_sanskrit": "तेन गच्छति निस्सङ्गं स्वर्गाय नरकाय वा ।\nसुकृतं दुष्कृतं वाऽपि कृत्वा मोहेन मानवः\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2139213, "chapter_id": 4011, "verse_number": "७३", "content_sanskrit": "पश्चात्तापेन तप्येत सुबुद्धो मरणं गतः\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2139214, "chapter_id": 4011, "verse_number": "७४", "content_sanskrit": "एतदुक्त्वा परं वाक्यं विससर्ज शतक्रतुम् ।\nशक्रोऽप्यापृच्छ्य ब्रह्माणं देवराज्यमपालयत्\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2139215, "chapter_id": 4011, "verse_number": "७५", "content_sanskrit": "यथोक्तं देवदेवेन ब्रह्मणा परमेष्ठिना ।\nतथा त्वमपि राजेन्द्र कार्याकार्यस्थितो भव\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2139216, "chapter_id": 4011, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां\nवैयासिक्यां विराटपर्वणि एकोनविंशोऽध्यायः ॥१९॥\nकीचकवधपर्वणि चतुर्थोऽध्यायः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2139217, "chapter_id": 4011, "verse_number": "", "content_sanskrit": "* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}]