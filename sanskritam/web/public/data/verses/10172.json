[{"id": 6000172000, "chapter_id": 10172, "verse_number": null, "content_sanskrit": "अथ एकोनविंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000172001, "chapter_id": 10172, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.001.m4a", "display_order": 2}, {"id": 6000172002, "chapter_id": 10172, "verse_number": "८-१९-१", "content_sanskrit": "बलिरेवं गृहपतिः कुलाचार्येण भाषितः।\nतूष्णीं भूत्वा क्षणं राजन्नुवाचावहितो गुरुम्॥ ८/१९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.002.m4a", "display_order": 3, "topics": [{"text": "हरेः कपटं ज्ञातवताऽपि बलिनाऽनृतभयाद्विष्णवे तदपेक्षितपदत्रयमितभूदानम्", "range": "१–२०"}]}, {"id": 6000172003, "chapter_id": 10172, "verse_number": null, "content_sanskrit": "बलिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.003.m4a", "display_order": 4}, {"id": 6000172004, "chapter_id": 10172, "verse_number": "८-१९-२", "content_sanskrit": "सत्यं भगवता प्रोक्तं धर्मोऽयं गृहमेधिनाम्।\nअर्थं कामं यशो वृत्तं यो न बाधेत कर्हिचित्॥ ८/१९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.004.m4a", "display_order": 5}, {"id": 6000172005, "chapter_id": 10172, "verse_number": "८-१९-३", "content_sanskrit": "स चाहं वित्तलोभेन प्रत्याचक्षे कथं द्विजम्।\nप्रतिश्रुत्य ददामीति प्राह्लादिः कितवो यथा॥ ८/१९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.005.m4a", "display_order": 6}, {"id": 6000172006, "chapter_id": 10172, "verse_number": "८-१९-४", "content_sanskrit": "न ह्यसत्यात् परोऽधर्म इति होवाच भूरियम्।\nसर्वं वोढुमलं मन्ये ऋतेऽलीकपरं नरम्॥ ८/१९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.006.m4a", "display_order": 7}, {"id": 6000172007, "chapter_id": 10172, "verse_number": "८-१९-५", "content_sanskrit": "नाहं बिभेमि निरयान्नाधर्मादसुखार्णवात्।\nन स्थानच्यवनान्मृत्योर्यथा विप्रप्रलोभनात्॥ ८/१९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.007.m4a", "display_order": 8}, {"id": 6000172008, "chapter_id": 10172, "verse_number": "८-१९-६", "content_sanskrit": "यद्यत् हास्यति लोकेऽस्मिन् सम्परेतो धरादिकम्।\nतस्यात्यागे निमित्तं किं विप्रस्तुष्येत तेन चेत्॥ ८/१९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.008.m4a", "display_order": 9}, {"id": 6000172009, "chapter_id": 10172, "verse_number": "८-१९-७", "content_sanskrit": "श्रेयः कुर्वन्ति भूतानां साधवो दुस्त्यजासुभिः।\nदध्यङ्शिबिप्रभृतयः को विकल्पो धरादिषु॥ ८/१९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.009.m4a", "display_order": 10}, {"id": 6000172010, "chapter_id": 10172, "verse_number": "८-१९-८", "content_sanskrit": "यैरियं भुज्यते ब्रह्मन् दैत्येन्द्रैरनिवर्तिभिः।\nतेषां कालोऽग्रसील्लोकान् न यशोऽधिगतं भुवि॥ ८/१९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.010.m4a", "display_order": 11}, {"id": 6000172011, "chapter_id": 10172, "verse_number": "८-१९-९", "content_sanskrit": "सुलभा युधि विप्रर्षे ह्यनिवृत्तास्तनुत्यजः।\nन तथा तीर्थ आयाते श्रद्धया ये धनत्यजः॥ ८/१९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.011.m4a", "display_order": 12}, {"id": 6000172012, "chapter_id": 10172, "verse_number": "८-१९-१०", "content_sanskrit": "मनस्विनः कारुणिकस्य शोभनं यदर्थकामोपनयेन दुर्गतिः।\nकुतः पुनर्ब्रह्मविदां भवादृशां ततो वटोरस्य ददामि वाञ्छितम्॥ ८/१९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.012.m4a", "display_order": 13}, {"id": 6000172013, "chapter_id": 10172, "verse_number": "८-१९-११", "content_sanskrit": "यजन्ति यज्ञक्रतुभिर्यमादृता भवन्त आम्नायविधानकोविदाः।\nस एष विष्णुर्वरदोऽस्तु वा परो दास्याम्यमुष्मै क्षितिमीप्सितां मुने॥ ८/१९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.013.m4a", "display_order": 14}, {"id": 6000172014, "chapter_id": 10172, "verse_number": "८-१९-१२", "content_sanskrit": "यद्यप्यसावधर्मेण मां बध्नीयादनागसम्।\nतथाऽप्येनं न हिंसिष्ये भीतं ब्रह्मतनुं रिपुम्॥ ८/१९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.014.m4a", "display_order": 15}, {"id": 6000172015, "chapter_id": 10172, "verse_number": "८-१९-१३", "content_sanskrit": "एष वा उत्तमश्लोको न जिहासति यद् यशः।\nहत्वा मैनां हरेद् युद्धे शयीत निहतो मया॥ ८/१९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.015.m4a", "display_order": 16}, {"id": 6000172016, "chapter_id": 10172, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.016.m4a", "display_order": 17}, {"id": 6000172017, "chapter_id": 10172, "verse_number": "८-१९-१४", "content_sanskrit": "एवमश्रद्धितं शिष्यमनादेशकरं गुरुः।\nशशाप दैवप्रहितः सत्यसन्धं मनस्विनम्॥ ८/१९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.017.m4a", "display_order": 18}, {"id": 6000172018, "chapter_id": 10172, "verse_number": "८-१९-१५", "content_sanskrit": "दृढं पण्डितमान्यज्ञः स्तब्धोऽस्यस्मदुपेक्षया।\nमच्छासनातिगो यस्त्वमचिराद् भ्रश्यसे श्रियः॥ ८/१९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.018.m4a", "display_order": 19}, {"id": 6000172019, "chapter_id": 10172, "verse_number": "८-१९-१६", "content_sanskrit": "एवं शप्तः स गुरुणा सत्यान्न चलितो महान्।\nवामनाय ददावेतामर्चित्वोदकपूर्वकम्॥ ८/१९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.019.m4a", "display_order": 20}, {"id": 6000172020, "chapter_id": 10172, "verse_number": "८-१९-१७", "content_sanskrit": "विन्ध्यावलिस्तदागत्य पत्नी जालकमालिनी।\nआनिन्ये कलशं हैममावनेजन्यपां भृतम्॥ ८/१९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.020.m4a", "display_order": 21}, {"id": 6000172021, "chapter_id": 10172, "verse_number": "८-१९-१८", "content_sanskrit": "यजमानः स्वयं तस्य श्रीमत्पादयुगं मुदा।\nअवनिज्यावहन्मूर्ध्नि तदपो विश्वपावनीः॥ ८/१९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.021.m4a", "display_order": 22}, {"id": 6000172022, "chapter_id": 10172, "verse_number": "८-१९-१९", "content_sanskrit": "तदाऽसुरेन्द्रं दिवि देवतागणा गन्धर्वविद्याधरसिद्धचारणाः।\nतत्कर्म सर्वेऽपि गृणन्त आर्यं प्रसूनवर्षैः ववृषुर्मुदाऽन्विताः॥ ८/१९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.022.m4a", "display_order": 23}, {"id": 6000172023, "chapter_id": 10172, "verse_number": "८-१९-२०", "content_sanskrit": "नेदुर्मुहुर्दुन्दुभयः सहस्रशो गन्धर्वकिम्पूरुषकिन्नरा जगुः।\nमनस्विनाऽनेन कृतं सुदुष्करं विद्वानदाद् यद् रिपवे जगत्त्रयम्॥ ८/१९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.023.m4a", "display_order": 24}, {"id": 6000172024, "chapter_id": 10172, "verse_number": "८-१९-२१", "content_sanskrit": "तद् वामनं रूपमवर्धताद्भुतं हरेरनन्तस्य गुणत्रयात्मकम्।\nभूः खं दिशो द्यौर्विवराः पयोधयस्तिर्यङ्‌नृदेवा ऋषयः सदासन्॥ ८/१९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.024.m4a", "display_order": 25, "topics": [{"text": "प्राप्तपदत्रयेण वामनेन स्वीयविश्वरूपग्रहणेन भूलोकस्यैकेन पदाऽऽक्रमणम्", "range": "२१–३३"}]}, {"id": 6000172025, "chapter_id": 10172, "verse_number": "८-१९-२२", "content_sanskrit": "काये बलिस्तस्य महाविभूतेः सहर्त्विगाचार्यसदस्य एतत्।\nददर्श विश्वं त्रिगुणं गुणात्मके भूतेन्द्रियार्थाशयजीवयुक्तम्॥ ८/१९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.025.m4a", "display_order": 26}, {"id": 6000172026, "chapter_id": 10172, "verse_number": "८-१९-२३", "content_sanskrit": "रसामचष्टाङ्घ्रितलेऽथ पादयोः महीं महीध्रान् पुरुषस्य जङ्घयोः।\nपतत्त्रिणो जानुनि विश्वमूर्तेरूर्वोर्गणं मरुतामिन्द्रसेनः॥ ८/१९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.026.m4a", "display_order": 27}, {"id": 6000172027, "chapter_id": 10172, "verse_number": "८-१९-२४", "content_sanskrit": "सन्ध्यां विभोर्वाससि गुह्य ऐक्षत् प्रजापतीन् जघने स्वात्ममुख्यम्।\nनाभ्यां नभः कुक्षिषु सप्तसिन्धूनुरुक्रमस्योरसि ऋक्षमालाम्॥ ८/१९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.027.m4a", "display_order": 28}, {"id": 6000172028, "chapter_id": 10172, "verse_number": "८-१९-२५", "content_sanskrit": "हृद्यङ्ग धर्मं स्तनयोर्मुरारेर्ऋतं च सत्यं च मनस्यथेन्दुम्।\nश्रियं च वक्षस्यरविन्दहस्तां कण्ठे च सामानि समस्तरेफान्॥ ८/१९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.028.m4a", "display_order": 29}, {"id": 6000172029, "chapter_id": 10172, "verse_number": "८-१९-२६", "content_sanskrit": "इन्द्रप्रधानानमरान् भुजेषु तत्कर्णयोः ककुभो द्यौश्च मूर्धनि।\nकेशेषु मेघान् श्वसनं नासिकायामक्ष्णोश्च सूर्यं वदने च वह्निम्॥ ८/१९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.029.m4a", "display_order": 30}, {"id": 6000172030, "chapter_id": 10172, "verse_number": "८-१९-२७", "content_sanskrit": "वाण्यां च च्छन्दांसि रसे जलेशं भ्रुवोर्निषेधं च विधिं च पक्ष्मसु।\nअहश्च रात्रिं च परस्य पुंसो मन्युं ललाटेऽधर एव लोभम्॥ ८/१९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.030.m4a", "display_order": 31}, {"id": 6000172031, "chapter_id": 10172, "verse_number": "८-१९-२८", "content_sanskrit": "स्पर्शे च कामं नृप रेतस्यमम्भः पृष्ठे त्वधर्मं क्रमणेषु यज्ञम्।\nछायासु मृत्युं हसिते च मायां तनूरुहेष्वौषधिजातयश्च॥ ८/१९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.031.m4a", "display_order": 32}, {"id": 6000172032, "chapter_id": 10172, "verse_number": "८-१९-२९", "content_sanskrit": "नदीश्च नाडीषु शिला नखेषु बुद्धावजं देवगणानृषींश्च।\nप्राणेषु गात्रे स्थिरजङ्गमानि क्षणार्धमात्रेण विवृद्धमूर्तेः॥ ८/१९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.032.m4a", "display_order": 33}, {"id": 6000172033, "chapter_id": 10172, "verse_number": "८-१९-३०", "content_sanskrit": "सर्वात्मनीदं भुवनं निरीक्ष्य सर्वेऽसुराः कश्मलमापुरङ्ग।\nसुदर्शनं चक्रमसह्यतेजो धनुश्च शार्ङ्गं स्तनयित्नुघोषम्॥ ८/१९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.033.m4a", "display_order": 34}, {"id": 6000172034, "chapter_id": 10172, "verse_number": "८-१९-३१", "content_sanskrit": "पर्जन्यघोषो जलजः पाञ्चजन्यः कौमोदकी विष्णुगदा तरस्विनी।\nवैद्याधरोऽसिः शतचन्द्रयुक्तस्तूणोत्तमावक्षयसायकौ च॥ ८/१९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.034.m4a", "display_order": 35}, {"id": 6000172035, "chapter_id": 10172, "verse_number": "८-१९-३२", "content_sanskrit": "सुनन्दनन्दौ उपतस्थुरीशं पार्षादमुख्याः सहलोकपालाः।\nस्फुरत्किरीटाङ्गदमीनकुण्डलश्रीवत्सरत्नोत्तममेखलाम्बरैः।\nमधुव्रतस्रग्वनमालया वृतो रराज राजन् भगवानुरुक्रमः॥ ८/१९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.035.m4a", "display_order": 36}, {"id": 6000172036, "chapter_id": 10172, "verse_number": "८-१९-३३", "content_sanskrit": "क्षितिं पदैकेन बलेर्विचक्रमे नभः शरीरेण दिशश्च बाहुभिः।\nपदं द्वितीयं क्रमतस्‍त्रिविष्टपं न वै तृतीयस्य तदीयमण्वपि।\nउरुक्रमस्याङ्घ्रिरुपर्यथो दिवो महर्जनाभ्यां तपसः परं गतः॥ ८/१९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_08/adhyaya_019/BhP_08.019.036.m4a", "display_order": 37}, {"id": 6000172037, "chapter_id": 10172, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायाम्ऽष्टमस्कन्धे एकोनविंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]