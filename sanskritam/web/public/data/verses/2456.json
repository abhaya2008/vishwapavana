[{"id": 2069537, "chapter_id": 2456, "verse_number": "१०-८-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069538, "chapter_id": 2456, "verse_number": "१०-८-१", "content_sanskrit": "तथा प्रयाते शिबिरं द्रोणपुत्रे महारथे।\nकच्चित्कृपश्च भोजश्च भयार्तौ न व्यवर्तताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069539, "chapter_id": 2456, "verse_number": "१०-८-२", "content_sanskrit": "कच्चिन्न वारितौ क्षुद्रौ रक्षिभिर्नोपलक्षितौ।\nअसह्यमिति मन्वानौ न निवृत्तौ महारथौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069540, "chapter_id": 2456, "verse_number": "१०-८-३", "content_sanskrit": "कच्चिदुन्मथ्य शिबिरं हत्वा सोमकपाण्डवान्।\n`कृता प्रतिज्ञा सफला कच्चित्सञ्जय सा निशि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069541, "chapter_id": 2456, "verse_number": "१०-८-४", "content_sanskrit": "दुर्योधनस्य पदवीं कच्चित्परमिकां रणे।\n`गत्वातिष्ठदसौ द्रौणिः कृत्वा कर्म सुदुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069542, "chapter_id": 2456, "verse_number": "१०-८-५", "content_sanskrit": "धृष्टद्युम्नशिखण्डिभ्यां द्रौपद्याश्च सुतैः किल।\nसञ्छन्ना मेदिनी सुप्तैर्निहतैः पाण्डुसैनिकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069543, "chapter_id": 2456, "verse_number": "१०-८-६", "content_sanskrit": "पाञ्चालैर्वा विनिहतैः शयानै रुधिरोक्षितैः।\nकच्चिन्महीतलं छन्नं तन्ममाचक्ष्व सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069544, "chapter_id": 2456, "verse_number": "१०-८-७", "content_sanskrit": "[पाञ्चालैर्निहतौ वीरौ कच्चित्तु स्वपतां क्षितौ।\nकच्चित्ताभ्यां कृतं कर्म तन्ममाचक्ष्व सञ्जय॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069545, "chapter_id": 2456, "verse_number": "१०-८-८x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069546, "chapter_id": 2456, "verse_number": "१०-८-८", "content_sanskrit": "तस्मिन्प्रयाते शिबिरं द्रोणपुत्रे महात्मनि।\nकृपश्च कृतवर्मा च द्रौणिमेवाभ्यवर्तताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069547, "chapter_id": 2456, "verse_number": "१०-८-९", "content_sanskrit": "अश्वत्थामा तु तौ दृष्ट्वा यत्नवन्तौ महारथौ।\nप्रहृष्टः शनकै राजन्निदं वचनमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069548, "chapter_id": 2456, "verse_number": "१०-८-१०", "content_sanskrit": "यत्तौ भवन्तौ पर्याप्तौ सर्वक्षत्रस्य नाशने।\nकिम्पुनर्योधशेषस्य प्रसुप्तस्य विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069549, "chapter_id": 2456, "verse_number": "१०-८-११", "content_sanskrit": "अहं प्रवेक्ष्ये शिबिरं चरिष्यामि च कालवत्।\nयथा न कश्चिदपि वां जीवन्मुच्येत मानवः।\nतथा भवद्ध्यां कार्यं स्यादिति मे निश्चिता मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069550, "chapter_id": 2456, "verse_number": "१०-८-१२", "content_sanskrit": "इत्युक्त्वा प्राविशद्द्रौणिः पार्थानां शिबिरं महत्।\nअद्वारेणाभ्यवस्कन्द्य विहाय भयमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069551, "chapter_id": 2456, "verse_number": "१०-८-१३", "content_sanskrit": "स प्रविश्य महाबाहुरुद्देशज्ञश्च तस्य ह।\n`द्रौणिः परमसङ्क्रुद्धस्तेजसा प्रज्वलन्निव।\nततः पर्यचरत्सर्वं सम्प्रसुप्तं जनं निशि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069552, "chapter_id": 2456, "verse_number": "१०-८-१४", "content_sanskrit": "धृष्टद्युम्नस्य निलयं शनकैरभ्युपागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069553, "chapter_id": 2456, "verse_number": "१०-८-१५", "content_sanskrit": "ते तु कृत्वा महत्कर्म श्रान्ताश्च बलवद्रणे।\nप्रसुप्ता वै सुविश्वस्ताः स्वसैन्यपरिवारिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069554, "chapter_id": 2456, "verse_number": "१०-८-१६", "content_sanskrit": "अथ प्रविश्य तद्वेश्म धृष्टद्युम्नस्य भारत।\nपाञ्चाल्यं शयने द्रौणिरपश्यत्सुप्तमन्तिकात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069555, "chapter_id": 2456, "verse_number": "१०-८-१७", "content_sanskrit": "क्षौमावदाते महति स्पर्द्व्यास्तरणसंवृते।\nमाल्यप्रवरसंयुक्ते धूपैश्चूर्णैश्च वासिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069556, "chapter_id": 2456, "verse_number": "१०-८-१८", "content_sanskrit": "तं शयानं महात्मानं विस्रब्धमकुतोभयम्।\nअपोथयत पादेन शयनस्थं महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069557, "chapter_id": 2456, "verse_number": "१०-८-१९", "content_sanskrit": "सम्बुध्य चरणस्पर्शादुत्थाय रणदुर्मदः।\nअभ्यजानादमेयात्मा द्रोणपुत्रं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069558, "chapter_id": 2456, "verse_number": "१०-८-२०", "content_sanskrit": "तमुत्पतन्तं शयनादश्वत्थामा महाबलः।\nकेशेष्वालभ्य पाणिभ्यां निष्पिपेष महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069559, "chapter_id": 2456, "verse_number": "१०-८-२१", "content_sanskrit": "स बलात्तेन निष्पिष्टः साध्वसेन च भारत।\nअभ्याक्रान्तश्च निद्रान्धो नाशकच्चेष्टितुं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2069560, "chapter_id": 2456, "verse_number": "१०-८-२२", "content_sanskrit": "`निष्पिष्य तु ततो भूमौ पाञ्चाल्यं द्रौणिरञ्जसा।\nधनुषो ज्यां विमुच्याशु क्रूरबुद्धिरमर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2069561, "chapter_id": 2456, "verse_number": "१०-८-२३", "content_sanskrit": "तस्य कण्ठेऽथ बद्ध्वा तां त्वरितः क्रोधमूर्च्छितः।\nद्रौणिः क्रूरं मनः कृत्वा पाञ्चाल्यमवधीत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2069562, "chapter_id": 2456, "verse_number": "१०-८-२४", "content_sanskrit": "तमाक्रम्य पदा राजन्कण्ठे चोरसि पादयोः।\nतदन्तं विस्फुरन्तं च पशुमारममारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2069563, "chapter_id": 2456, "verse_number": "१०-८-२५", "content_sanskrit": "`स वार्यमाणस्तरसा बलाद्बलवता बली।\nतुदन्नखैस्तु स द्रौणिं नातिव्यक्तमुदाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2069564, "chapter_id": 2456, "verse_number": "१०-८-२६", "content_sanskrit": "आचार्यपुत्र शस्त्रेण जहि मां मा चिरं कृथाः।\nत्वत्कृते सुकृतां लोकान्गच्छेयं द्विपदांवर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2069565, "chapter_id": 2456, "verse_number": "१०-८-२७", "content_sanskrit": "एवमुक्त्वा तु वचनं विरराम परन्तपः।\nसुतः पाञ्चालराजस्य आक्रान्तो बलिना भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2069566, "chapter_id": 2456, "verse_number": "१०-८-२८", "content_sanskrit": "तस्याव्यक्तां तु तां वचं संश्रुत्य द्रौणिरब्रवीत्।\nआचार्यघातिनां लोका न सन्ति कुलपांसन।\nतस्माच्छस्त्रेण निधनं न त्वमर्हसि दुर्मते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2069567, "chapter_id": 2456, "verse_number": "१०-८-२९", "content_sanskrit": "`नृशंसेनातिवृत्तेन त्वया मे निहतः पिता।\nतस्मात्त्वमपि वध्यश्च नृशंसेन नृशंसकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2069568, "chapter_id": 2456, "verse_number": "१०-८-३०", "content_sanskrit": "एवं ब्रुवाणस्तं वीरं सिंहो मत्तमिव द्विपम्।\nमर्मस्वभ्यवधीत्क्रुद्धः पादघातैः सुदारुणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2069569, "chapter_id": 2456, "verse_number": "१०-८-३१", "content_sanskrit": "तस्य वीरस्य शब्देन मार्यमाणस्य वेश्मनि।\nअबुध्यन्त महाराज स्त्रियो ये चास्य रक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2069570, "chapter_id": 2456, "verse_number": "१०-८-३२", "content_sanskrit": "ते दृष्ट्वा धर्षयन्तं तमतिमानुषविक्रमम्।\nभूतमित्यध्यवस्यन्तो न स्म प्रव्याहरन्भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2069571, "chapter_id": 2456, "verse_number": "१०-८-३३", "content_sanskrit": "तं तु तेनाभ्युपायेन गमयित्वा यमक्षयम्।\nअध्यतिष्ठत तेजस्वी रथं प्राप्य सुदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2069572, "chapter_id": 2456, "verse_number": "१०-८-३४", "content_sanskrit": "स तस्य भवनाद्राजन्निष्क्रम्यानादयन्दिशः।\nरथेन शिबिरं प्रायाज्जिघांसुर्द्विषतो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2069573, "chapter_id": 2456, "verse_number": "१०-८-३५", "content_sanskrit": "अपक्रान्ते ततस्तस्मिन्द्रोणपुत्रे महारथे।\nसहितैः रक्षिभिः सर्वैः प्राणेदुर्योषितस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2069574, "chapter_id": 2456, "verse_number": "१०-८-३६", "content_sanskrit": "राजानं निहतं दृष्ट्वा भृशं शोकपरायणाः।\nव्याक्रोशन्क्षत्रियाः सर्वे धृष्टद्युम्नस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2069575, "chapter_id": 2456, "verse_number": "१०-८-३७", "content_sanskrit": "तासां तु तेन शब्देन समीपे क्षत्रियर्षभाः।\nसम्भ्रान्ताः समनह्यन्त किमेतदिति चाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2069576, "chapter_id": 2456, "verse_number": "१०-८-३८", "content_sanskrit": "स्त्रियस्तु राजन्वित्रस्ता भारद्वाजं निरीक्ष्य ताः।\nअब्रुन्दीनकण्ठेन क्षिप्रमाद्रवतेति वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2069577, "chapter_id": 2456, "verse_number": "१०-८-३९", "content_sanskrit": "राक्षसो वा मनुष्यो वा नैनं जानीम कोन्वयम्।\nहत्वा पाञ्चालराजानं रथमारुह्य तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2069578, "chapter_id": 2456, "verse_number": "१०-८-४०", "content_sanskrit": "ततस्ते योधमुख्यास्तं सहसा पर्यवारयन्।\nस तानापततः सर्वान्रुद्रास्त्रेण व्यपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2069579, "chapter_id": 2456, "verse_number": "१०-८-४१", "content_sanskrit": "धृष्टद्युम्नं च हत्वा स तांश्चैवास्य पदानुगान्।\nअपश्यच्छयने सुप्तमुत्तमौजसमन्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2069580, "chapter_id": 2456, "verse_number": "१०-८-४२", "content_sanskrit": "तमप्याक्रम्य पादेन कण्ठे चोरसि तेजसा।\nतथैव मारयामास विनर्दन्तमरिन्दमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2069581, "chapter_id": 2456, "verse_number": "१०-८-४३", "content_sanskrit": "युधामन्युश्च विक्रान्तो मत्वा तं राक्षसं स्म सः।\nगदामुद्यम्य वेगेन हृदि द्रौणिमताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2069582, "chapter_id": 2456, "verse_number": "१०-८-४४", "content_sanskrit": "`गदाप्रहाराभिहतो नाचलद्द्रौणिराहवे।\nतमभिद्रुत्य वेगेन क्षितौ चैनमपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2069583, "chapter_id": 2456, "verse_number": "१०-८-४५", "content_sanskrit": "विस्फुरन्तं च पशुवत्तथैवैनममारयत्।\nतथा स वीरो हत्वा तं ततोऽन्यान्समुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2069584, "chapter_id": 2456, "verse_number": "१०-८-४६", "content_sanskrit": "संसुप्तानेव राजेन्द्र तत्र तत्र महारथान्।\nपाञ्चालवीरानाक्रम्य क्रुद्धो न्यहनदन्तिके।\nस्फुरतो वेपमानांश्च शमितेव पशून्मखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2069585, "chapter_id": 2456, "verse_number": "१०-८-४७", "content_sanskrit": "ततो निस्त्रिंशमादाय जघानान्यान्पृथक्पृथक्।\nभागशो विचरन्मार्गानसियुद्वविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2069586, "chapter_id": 2456, "verse_number": "१०-८-४८", "content_sanskrit": "तथैव गुल्मे सम्प्रेक्ष्य शयानान्मध्यगौल्मिकान्।\nश्रान्तान्व्यस्तायुधान्सर्वानसिनैव व्यपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2069587, "chapter_id": 2456, "verse_number": "१०-८-४९", "content_sanskrit": "योधानश्वान्द्विपांश्चैव प्राच्छिनत्स वरासिना।\nरुधिरोक्षितसर्वाङ्गः कालसृष्ट इवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2069588, "chapter_id": 2456, "verse_number": "१०-८-५०", "content_sanskrit": "विस्फुरद्भिश्च तैर्द्रौणिर्निस्त्रिंशस्योद्यमेन च।\nअवक्षेपेण चैवासेस्त्रिधा रक्तोक्षितोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2069589, "chapter_id": 2456, "verse_number": "१०-८-५१", "content_sanskrit": "तस्य लोहितरक्तस्य दीप्तखङ्गस्य युध्यतः।\nअमानुष इवाकारो बभौ परमभीषणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2069590, "chapter_id": 2456, "verse_number": "१०-८-५२", "content_sanskrit": "ये त्वजाग्रन्त कौरव्य तेऽपि शब्देन मोहिताः।\nवीक्षमाणास्तु ते तत्र द्रौणिं दृष्ट्वा प्रविव्यथुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2069591, "chapter_id": 2456, "verse_number": "१०-८-५३", "content_sanskrit": "तद्रूपं तस्य ते दृष्ट्वा क्षत्रियाः शत्रुकर्शनम्।\nराक्षसं मन्यमानास्तं नयनानि न्यमीलयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2069592, "chapter_id": 2456, "verse_number": "१०-८-५४", "content_sanskrit": "स घोररूपो व्यचरत्कालवच्छिबिरे तदा।\nअपश्यद्द्रौपदीपुत्रानवशिष्टांश्च सोमकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2069593, "chapter_id": 2456, "verse_number": "१०-८-५५", "content_sanskrit": "तेन शब्देन वित्रस्ता धनुर्हस्ता महारथाः।\nधृष्टद्युम्नं हतं श्रुत्वा द्रौपदेया विशाम्पते।\nअवाकिरञ्शरव्रातैर्भारद्वाजमभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2069594, "chapter_id": 2456, "verse_number": "१०-८-५६", "content_sanskrit": "ततस्तेन निनादेन सम्प्रबुद्धाः प्रभद्रकाः।\nशिलीमुखैः शिखण्डी च द्रोणपुत्रं समार्दयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2069595, "chapter_id": 2456, "verse_number": "१०-८-५७", "content_sanskrit": "भारद्वाजः स तान्दृष्ट्वा शरवर्षाणि वर्षतः।\nननाद बलवन्नादं जिघांसुस्तान्महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2069596, "chapter_id": 2456, "verse_number": "१०-८-५८", "content_sanskrit": "ततः परमसङ्क्रुद्धः पितुर्वधमनुस्मरन्।\nअवरुह्य रथोपस्थात्त्वरमाणोऽभिदुद्रुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2069597, "chapter_id": 2456, "verse_number": "१०-८-५९", "content_sanskrit": "सहस्रचन्द्रविमलं गृहीत्वा चर्म संयुगे।\nखङ्गं च विमलं दिव्यं जातरूपपरिष्कृतम्।\nद्रौपदेयानभिद्रुत्य खङ्गेन व्यधमद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2069598, "chapter_id": 2456, "verse_number": "१०-८-६०", "content_sanskrit": "ततः स नरशार्दूलः प्रतिविन्ध्यं महाहवे।\nकुक्षिदेशेऽवधीद्राजन्स हतो न्यपतद्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2069599, "chapter_id": 2456, "verse_number": "१०-८-६१", "content_sanskrit": "प्रासेन विद्ध्वा द्रौणिं तु सुतसोमः प्रतापवान्।\nपुनश्चासिं समुद्यम्य द्रोणपुत्रमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2069600, "chapter_id": 2456, "verse_number": "१०-८-६२", "content_sanskrit": "सुतसोमस्य सासिं तं बाहुं छित्त्वा नरर्षभ।\nपुनरप्याहनत्पार्श्वे स भिन्नहृदयोऽपतत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2069601, "chapter_id": 2456, "verse_number": "१०-८-६३", "content_sanskrit": "नाकुलिस्तु शतानीको रथचक्रेण वीर्यवान्।\nदोर्भ्यामुत्क्षिप्य वेगेन वक्षस्येनमताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2069602, "chapter_id": 2456, "verse_number": "१०-८-६४", "content_sanskrit": "अताडयच्छतानीकं मुक्तचक्रं द्विजस्तु सः।\nस विह्वलो ययौ भूमिं ततोऽस्यापाहरच्छिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2069603, "chapter_id": 2456, "verse_number": "१०-८-६५", "content_sanskrit": "श्रुतकर्मा तु परिघं घोरं गृह्य दुरासदम्।\nअताडयत्समुद्यम्य वेगेन द्रौणिमुत्स्मयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2069604, "chapter_id": 2456, "verse_number": "१०-८-६६", "content_sanskrit": "स तु तं श्रुतकर्माणमास्ये जघ्ने वरासिना।\nस हतो न्यपतद्भूमौ विमूर्धा विकृताननः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2069605, "chapter_id": 2456, "verse_number": "१०-८-६७", "content_sanskrit": "तेन शब्देन वीरस्तु श्रुतकीर्तिरबुध्यत।\nअश्वत्थामानमासाद्य शरवर्षैरवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2069606, "chapter_id": 2456, "verse_number": "१०-८-६८", "content_sanskrit": "`शरैराच्छादितस्तेन द्रोणपुत्रो महारथः।\nअदृश्यत महाराज श्वाविच्छललतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2069607, "chapter_id": 2456, "verse_number": "१०-८-६९", "content_sanskrit": "तस्यापि शरवर्षाणि चर्मणा प्रतिवार्य सः।\nसकुण्डलं शिरः कायाद्वाजमानमपाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2069608, "chapter_id": 2456, "verse_number": "१०-८-७०", "content_sanskrit": "ततो भीष्मनिहन्तारं सह सर्वैः प्रभद्रकैः।\nआहनत्सर्वतो वीरं नानाप्रहरणैर्बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2069609, "chapter_id": 2456, "verse_number": "१०-८-७१", "content_sanskrit": "शिलीमुखेन चाप्येनं भ्रुवोर्मध्ये समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2069610, "chapter_id": 2456, "verse_number": "१०-८-७२", "content_sanskrit": "स तु क्रोधसमाविष्टो द्रोणपुत्रो महाबलः।\nशिखण्डिनं समासाद्य द्विधा चिच्छेद सोसिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2069611, "chapter_id": 2456, "verse_number": "१०-८-७३", "content_sanskrit": "शिखण़्डिनं ततो हत्वा क्रोधाविष्टः परन्तपः।\nप्रभद्रकगणान्सर्वानभिदुद्राव वेगवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2069612, "chapter_id": 2456, "verse_number": "१०-८-७४", "content_sanskrit": "यच्च शिष्टं विराटस्य बलं तु भृशमाद्रवत्।\nद्रुपदस्य च पुत्राणां पौत्राणां सुहृदामपि।\nचकार कदनं घोरं दृष्ट्वा तत्र महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2069613, "chapter_id": 2456, "verse_number": "१०-८-७५", "content_sanskrit": "अन्यानन्यांश्च पुरुषानभिसृत्याभिसृत्य च।\nन्यकृन्तदसिना द्रौणिरसिमार्गविशारदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2069614, "chapter_id": 2456, "verse_number": "१०-८-७६", "content_sanskrit": "कालीं रक्तास्यनयनां रक्तमाल्यानुलेपनाम्।\nरक्ताम्बरधरां घोरां पाशहस्तां कुटुम्बिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2069615, "chapter_id": 2456, "verse_number": "१०-८-७७", "content_sanskrit": "ददृशुः कालरात्रिं ते स्मयमानामिव स्थिताम्।\nनराश्वकुञ्जरान्पाशैर्बद्धा घोरैः प्रतस्थुषीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2069616, "chapter_id": 2456, "verse_number": "१०-८-७८", "content_sanskrit": "वहन्तीं विविधान्प्रेतान्पाशबद्वान्विमूर्धजान्।\nतथैव च सदा राजन्न्यस्तशस्त्रान्महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2069617, "chapter_id": 2456, "verse_number": "१०-८-७९", "content_sanskrit": "स्वप्ने सुप्तान्नयन्तीं तां रात्रिष्वन्यासु मारिष।\nददृशुर्योधमुख्यास्ते घ्नन्तं द्रौणिं च नित्यदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2069618, "chapter_id": 2456, "verse_number": "१०-८-८०", "content_sanskrit": "यतः प्रभृति सङ्ग्रामः कुरुपाण्डवसेनयोः।\nततः प्रभृति तां कन्यामपश्यन्द्रौणिमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2069619, "chapter_id": 2456, "verse_number": "१०-८-८१", "content_sanskrit": "तांस्तु दैवहतान्पूर्वं पश्चाद्द्रौणिर्व्यपातयत्।\nत्रासयन्सर्वभूतानि विनदन्भैरवान्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2069620, "chapter_id": 2456, "verse_number": "१०-८-८२", "content_sanskrit": "तदनुस्मृत्य ते वीरा दर्शनं पूर्वकालिकम्।\nइदं तदित्यमन्यन्त दैवेनोपनिपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2069621, "chapter_id": 2456, "verse_number": "१०-८-८३", "content_sanskrit": "ततस्तेन निनादेन प्रत्यबुध्यन्त धन्विनः।\nशिबिरे पाण्डवेयानां शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2069622, "chapter_id": 2456, "verse_number": "१०-८-८४", "content_sanskrit": "सोऽच्छिनत्कस्यचित्पदौ जघनं चैव कस्यचित्।\nकांश्चिद्बिभेदपार्श्वेषु कालसृष्ट इवान्तकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2069623, "chapter_id": 2456, "verse_number": "१०-८-८५", "content_sanskrit": "अत्युग्रप्रतिपिष्टैश्च नदद्भिश्च भृशोत्कटैः।\nगजाश्वमथितैश्चान्यैर्मही कीर्णाऽभवत्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2069624, "chapter_id": 2456, "verse_number": "१०-८-८६", "content_sanskrit": "क्रोशतां किमिदं कोऽयं कः शब्दः किन्नु किं कृतम्।\nपाञ्चालानां तथा द्रौणिरन्तकः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2069625, "chapter_id": 2456, "verse_number": "१०-८-८७", "content_sanskrit": "अपेतशस्त्रसन्नाहान्सन्नद्वान्पाण्डुसृञ्जयान्।\nप्राहिणोन्मृत्युलोकाय द्रौणिः प्रहरतां वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2069626, "chapter_id": 2456, "verse_number": "१०-८-८८", "content_sanskrit": "ततस्तच्छस्त्रवित्रस्ता भयादभ्यपतन्नराः।\nनिद्रान्धा नष्टसंज्ञाश्च तत्रतत्र निपेतिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2069627, "chapter_id": 2456, "verse_number": "१०-८-८९", "content_sanskrit": "ऊरुस्तम्भगृहीताश्च कश्मलाभिहतौजसः।\nविनदन्तो भृशं त्रस्ता निरैक्षन्त परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2069628, "chapter_id": 2456, "verse_number": "१०-८-९०", "content_sanskrit": "ततो रथं पुनर्द्रौणिरास्थितो भीमदर्शनः।\nधनुष्पाणिः शरैरन्यान्प्रैषयद्वै यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2069629, "chapter_id": 2456, "verse_number": "१०-८-९१", "content_sanskrit": "पुनरुत्पततश्चापि दूरादपि नरोत्तमान्।\nशूरान्सम्पततश्चान्यान्कालरात्र्यै न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2069630, "chapter_id": 2456, "verse_number": "१०-८-९२", "content_sanskrit": "तथैव स्यन्दनाग्रेण प्रमथन्स व्यरोचत।\nशरवर्षैश्च विविधैरवर्षच्छात्रवांस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2069631, "chapter_id": 2456, "verse_number": "१०-८-९३", "content_sanskrit": "पुनश्च सुविचित्रेण शतचन्द्रेण चर्मणा।\nतेन चाकाशवर्णेन तथाचरत सोऽसिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2069632, "chapter_id": 2456, "verse_number": "१०-८-९४", "content_sanskrit": "तथा स शिबिरं तेषां द्रौणिराहवदुर्मदः।\nव्यक्षोभयत राजेन्द्र महाह्दमिव द्विपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2069633, "chapter_id": 2456, "verse_number": "१०-८-९५", "content_sanskrit": "उत्पेतुस्तेन शब्देन योधा राजन्विचेतसः।\nनिद्रार्ताश्च भयार्ताश्च व्यधावन्त ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2069634, "chapter_id": 2456, "verse_number": "१०-८-९६", "content_sanskrit": "विस्वरं चुक्रुशुश्चान्ये बह्वबद्वं तथाऽवदन्।\nन च स्म प्रत्यपद्यन्त शस्त्राणि वसनानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2069635, "chapter_id": 2456, "verse_number": "१०-८-९७", "content_sanskrit": "विमुक्तकेशाश्चाप्यन्ये नाभ्यजानन्परस्परम्।\nउत्पतन्तोऽपतञ्श्रान्ताः केचित्तत्राभ्रमंस्तदा।\nपुरीषमसृजन्केचित्केचिन्मूत्रं प्रसुस्रुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2069636, "chapter_id": 2456, "verse_number": "१०-८-९८", "content_sanskrit": "बन्धनानि च राजेन्द्र सञ्छिद्य तुरगा द्विपाः।\nसमं पर्यपतंश्चान्ये कुर्वन्तो महदाकुलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2069637, "chapter_id": 2456, "verse_number": "१०-८-९९", "content_sanskrit": "तत्र केचिन्नरा भीता व्यलीयन्त महीतले।\nतथैव तान्निपतितानपिंषन्गजवाजिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2069638, "chapter_id": 2456, "verse_number": "१०-८-१००", "content_sanskrit": "तस्मिंस्तथा वर्तमाने रक्षांसि पुरुषर्षभ।\nहृष्टानि व्यनदन्नुच्चैर्मुदा युक्तानि सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2069639, "chapter_id": 2456, "verse_number": "१०-८-१०१", "content_sanskrit": "स शब्दः प्रेरितो राजन्भूतसङ्घैर्मुदा युतैः।\nअपूरयद्दिशः सर्वा दिवं चातिमहान्स्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2069640, "chapter_id": 2456, "verse_number": "१०-८-१०२", "content_sanskrit": "तेषामार्तरवं श्रुत्वा वित्रस्ता गजवाजिनः।\nमुक्ताः पर्यपतन्राजन्मृद्गन्तः शिबिरे जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2069641, "chapter_id": 2456, "verse_number": "१०-८-१०३", "content_sanskrit": "तैस्तत्र परिधावद्भिश्चरणोदीरितं रजः।\nअकरोच्छिबिरे तेषां रजन्यां द्विगुणं तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2069642, "chapter_id": 2456, "verse_number": "१०-८-१०४", "content_sanskrit": "तस्मिंस्तमसि सञ्जाते प्रमूढाः सर्वतो जनाः।\nनाजानन्पितरः पुत्रान्भ्रातॄन्भ्रातर एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2069643, "chapter_id": 2456, "verse_number": "१०-८-१०५", "content_sanskrit": "गजो राजानतिक्रम्य निर्मनुष्या हया हयान्।\nअताडयंस्तथाऽभञ्जंस्तथाऽमृद्गंश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2069644, "chapter_id": 2456, "verse_number": "१०-८-१०६", "content_sanskrit": "ते भग्नाः प्रपतन्ति स्म मृद्रन्तश्च परस्परम्।\nन्यपातयंस्तथा चान्यान्पातयित्वा तदाऽपिषन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2069645, "chapter_id": 2456, "verse_number": "१०-८-१०७", "content_sanskrit": "विचेतसः सनिद्राश्च तमसा चावृता नराः।\nजघ्रुः स्वानेव तत्राथ कालेनैव प्रचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2069646, "chapter_id": 2456, "verse_number": "१०-८-१०८", "content_sanskrit": "त्यक्त्वाद्वाराणि च द्वास्थास्तथागुल्मानिगौल्मिकाः।\nप्राद्रवन्त यथाशक्ति कांदिशीका विचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2069647, "chapter_id": 2456, "verse_number": "१०-८-१०९", "content_sanskrit": "विप्रनष्टाश्च तेऽन्योन्यं नाजानन्तस्तथा विभो।\nक्रोशन्तस्तात पुत्रेति दैवोपहतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2069648, "chapter_id": 2456, "verse_number": "१०-८-११०", "content_sanskrit": "पलायतां दिशस्तेषां स्वानप्युत्सृज्य बान्धवान्।\nगोत्रनामभिरन्योन्यमाक्रन्दन्त ततो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2069649, "chapter_id": 2456, "verse_number": "१०-८-१११", "content_sanskrit": "हाहाकारं च कुर्वाणाः पृथिव्यां शेरते परे।\nतान्बुद्धा रणमध्येऽसौ द्रोणपुत्रो व्यपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2069650, "chapter_id": 2456, "verse_number": "१०-८-११२", "content_sanskrit": "तत्रापरे वध्यमाना मुहुर्महुरचेतसः।\nशिबिरान्निष्पतन्ति स्म क्षत्रिया भयपीडिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2069651, "chapter_id": 2456, "verse_number": "१०-८-११३", "content_sanskrit": "तांस्तु निष्पतितांस्त्रस्ताञ्शिबिराज्जीवितैषिणः।\nकृतवर्मा कृपश्चैव द्वारदेशे निजघ्नतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2069652, "chapter_id": 2456, "verse_number": "१०-८-११४", "content_sanskrit": "विसस्तयन्त्रकवचान्मुक्तकेशान्कृताञ्जलीन्।\nवेपमानान्क्षितौ भीतान्त्रैव कांश्चिदमुच्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2069653, "chapter_id": 2456, "verse_number": "१०-८-११५", "content_sanskrit": "नामुच्यत तयोः कश्चिन्निष्क्रान्तः शिबिराद्बहिः॥\nकृपश्चैव महाराज हार्दिक्यश्चैव दुर्मतिः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2069654, "chapter_id": 2456, "verse_number": "१०-८-११६", "content_sanskrit": "भूयश्चैव चिकीर्षन्तौ द्रौणपुत्रस्य तौ प्रियम्।\nत्रिषु देशेषु ददतुः शिबिरस्य हुताशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2069655, "chapter_id": 2456, "verse_number": "१०-८-११७", "content_sanskrit": "ततः प्रकाशे शिबिरे खङ्गेन पितृनन्दनः।\nअश्वत्थामा महाराज व्यचरत्कृतहस्तवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2069656, "chapter_id": 2456, "verse_number": "१०-८-११८", "content_sanskrit": "कांश्चिदापततो वीरानपरांश्चैव धावतः।\nव्ययोजयत खङ्गेन प्राणैर्द्विजवरोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2069657, "chapter_id": 2456, "verse_number": "१०-८-११९", "content_sanskrit": "कांश्चिद्योधान्स खङ्गेन मध्ये सञ्छिद्य वीर्यवान्।\nअशातयद्द्रोणपुत्रः संरब्धस्तिलकाण्डवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2069658, "chapter_id": 2456, "verse_number": "१०-८-१२०", "content_sanskrit": "निनदद्भिर्भृशायस्तैर्नराश्वद्विरदोत्तमैः।\nपतितैरभवत्कीर्णा मेदिनी भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2069659, "chapter_id": 2456, "verse_number": "१०-८-१२१", "content_sanskrit": "मानुषाणां सहस्रेषु हतेषु पतितेषु च।\nउदतिष्ठन्कबन्धानि बहून्युत्थाय चापतन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2069660, "chapter_id": 2456, "verse_number": "१०-८-१२२", "content_sanskrit": "सायुधान्साङ्गदान्बाहून्विचकर्त शिरांसि च।\nहस्तिहस्तोपमानूरून्हस्तान्पादांश्च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2069661, "chapter_id": 2456, "verse_number": "१०-८-१२३", "content_sanskrit": "पृष्ठच्छिन्नान्पार्श्वच्छिन्नाञ्शिरश्छिन्नांस्तथापरान्।\nस महात्माकरोद्द्रौणिः कांश्चिच्चापि पराङ्मुखान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2069662, "chapter_id": 2456, "verse_number": "१०-८-१२४", "content_sanskrit": "मध्यदेशे नरानन्यांश्चिच्छेदान्यांश्च कर्णतः।\nअंसदेशे निहत्यान्यान्काये प्रावेशयच्छिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2069663, "chapter_id": 2456, "verse_number": "१०-८-१२५", "content_sanskrit": "एवं हि बहुभिः शस्त्रैर्घ्नतोऽपि बलवत्तरान्।\nतमसा रजनी घोरा बभौ दारुणदर्शना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2069664, "chapter_id": 2456, "verse_number": "१०-८-१२६", "content_sanskrit": "किञ्चित्प्राणैश्च पुरुषैर्हतैश्चान्यैः सहस्रशः।\nबहुना च गजाश्वेन भूतभूद्भीमदर्शना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2069665, "chapter_id": 2456, "verse_number": "१०-८-१२७", "content_sanskrit": "यक्षरक्षःसमाकीर्णे रथाश्वद्विपदारुणे।\nक्रुद्धेन द्रोणपुत्रेण सञ्छिन्नाः प्रापतन्भुवि।\nभ्रातॄनन्ये पितॄनन्ये पुत्रानन्ये विचुक्रुशुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2069666, "chapter_id": 2456, "verse_number": "१०-८-१२८", "content_sanskrit": "केचिदूचुर्न तत्क्रुद्धैर्धार्तराष्ट्रैः कृतं रणे।\nयत्कृतं नः प्रसुप्तानां रक्षोभिः क्रूग्कर्मभिः।\nअसान्निध्याद्वि पार्थानामिदं वः कदनं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2069667, "chapter_id": 2456, "verse_number": "१०-८-१२९", "content_sanskrit": "न चासुरैर्न गन्धर्वैर्न यक्षैर्न च राक्षसैः।\nशक्यो विजेतुं कौन्तेयो नेता यस्य जनार्दनः।\nब्रह्मण्यः मत्यवाग्दान्तः सर्वभूतानुकम्पकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2069668, "chapter_id": 2456, "verse_number": "१०-८-१३०", "content_sanskrit": "न च सुप्तं प्रमत्तं वा न्यस्तशस्त्रं कृताञ्जलिम्।\nधावन्तं मुक्तकेशं वा हन्ति पार्थो धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2069669, "chapter_id": 2456, "verse_number": "१०-८-१३१", "content_sanskrit": "तदिदं नः कृतं घोरं रक्षोभिः क्रूरकर्मभिः।\nइति लालप्यमानाः स्म शेरते बहवो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2069670, "chapter_id": 2456, "verse_number": "१०-८-१३२", "content_sanskrit": "स्तनतां च मनुष्याणामपरेषां च कूजताम्।\nततो मुहूर्तात्प्राशाम्यत्स शब्दस्तुमुलो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2069671, "chapter_id": 2456, "verse_number": "१०-८-१३३", "content_sanskrit": "शोणितव्यतिषिक्तायां वसुधायां च भूमिप।\nतद्रजस्तुमुलं घोरं क्षणेनान्तरधीयत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2069672, "chapter_id": 2456, "verse_number": "१०-८-१३४", "content_sanskrit": "स चेष्टमानानुद्विग्नान्निरुत्साहान्सहस्रशः।\nन्यपातयन्नरान्क्रुद्वः पशून्पशुपतिर्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2069673, "chapter_id": 2456, "verse_number": "१०-८-१३५", "content_sanskrit": "अन्योन्यं सम्परिष्वज्य शयानाञ्जीवतोऽपरान्।\nसंलीनान्युध्यमानांश्च सर्वान्द्रौणिरपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2069674, "chapter_id": 2456, "verse_number": "१०-८-१३६", "content_sanskrit": "ब्रह्ममाना हुताशेन वध्यमानाश्च तेन ते।\nपरस्परं तदा योधाननयद्यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2069675, "chapter_id": 2456, "verse_number": "१०-८-१३७", "content_sanskrit": "तस्या रजन्यास्त्वर्धेन पाण्डवानां महद्बलम्।\nगमयामास राजेन्द्र द्रौणिर्यमनिवेशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2069676, "chapter_id": 2456, "verse_number": "१०-८-१३८", "content_sanskrit": "निशाचराणां सत्वानां रात्रिः सा हर्षवर्धिनी।\nआसीन्नरगजाश्वानां रौद्री क्षयकरी भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2069677, "chapter_id": 2456, "verse_number": "१०-८-१३९", "content_sanskrit": "तत्रादृश्यन्त रक्षांसि पिशाचाश्च पृथग्विधाः।\nखादन्तो नरमांसानि पिबन्तः शोणितानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2069678, "chapter_id": 2456, "verse_number": "१०-८-१४०", "content_sanskrit": "करालाः पिङ्गला रौद्राः शैलदन्ता रजस्वलाः।\nजटिला भीमवक्त्राश्च पञ्चपादा महोदराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2069679, "chapter_id": 2456, "verse_number": "१०-८-१४१", "content_sanskrit": "पञ्चादङ्गुलयो रूक्षा विरूपा भैरवस्वनाः।\nगजाननाश्च हस्वाश्च नीलवर्णा बिभीषणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2069680, "chapter_id": 2456, "verse_number": "१०-८-१४२", "content_sanskrit": "सपुत्रदाराः सुक्रूराः सुदुर्दर्शाः सुनिर्घृणाः।\nविविधानि च रूपाणि तत्रादृश्यन्त रक्षसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2069681, "chapter_id": 2456, "verse_number": "१०-८-१४३", "content_sanskrit": "पीत्वा च शोणितं हृष्टाः प्रानृत्यन्गणशोऽपरे।\nइदं परमिदं मेध्यमिदं स्वाद्विति चाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 2069682, "chapter_id": 2456, "verse_number": "१०-८-१४४", "content_sanskrit": "मेदोमज्जास्थिरक्तानां मांसानां च भृशाशिताः।\nपरे मांसानि खादन्तः क्रव्यादा मांसजीविनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 2069683, "chapter_id": 2456, "verse_number": "१०-८-१४५", "content_sanskrit": "वसाश्चैवापरे पीत्वा पर्यधावन्विकुक्षिकाः।\nनानावक्त्रास्तथा रौद्राः क्रव्यादाः पिशिताशनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 2069684, "chapter_id": 2456, "verse_number": "१०-८-१४६", "content_sanskrit": "अयुतानि च तत्रासन्प्रयुतान्यर्बुदानि च।\nरक्षसां घोररूपाणां महतां क्रुरकर्मणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 2069685, "chapter_id": 2456, "verse_number": "१०-८-१४७", "content_sanskrit": "मुदितानां वितृप्तानां तस्मिन्महति वैशसे।\nसमेतानि बहून्यासन्भूतानि च जनाधिप।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 2069686, "chapter_id": 2456, "verse_number": "१०-८-१४८", "content_sanskrit": "एवंविधा हि सा रात्रिः सोमकानां जनक्षये।\nप्रसुप्तानां प्रमत्तानामासीत्सुभृशदारुणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 2069687, "chapter_id": 2456, "verse_number": "१०-८-१४९", "content_sanskrit": "असंशयं हि कालस्य पर्यायो दुरतिक्रमः।\nतादृशा निहता यत्र कृत्वाऽस्माकं जनक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 2069688, "chapter_id": 2456, "verse_number": "१०-८-१५०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 2069689, "chapter_id": 2456, "verse_number": "१०-८-१५०", "content_sanskrit": "प्रागेव सुमहत्कर्म द्रौणिरेतन्महारथः।\nनाकरोदीदृशं कस्मान्मत्पुत्रविजये धृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}, {"id": 2069690, "chapter_id": 2456, "verse_number": "१०-८-१५१", "content_sanskrit": "अथ कस्माद्वते क्षत्रे कर्मेदं कृतवानसौ।\nद्रोणपुत्रो महात्मा स तन्मे शंसितुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 154}, {"id": 2069691, "chapter_id": 2456, "verse_number": "१०-८-१५२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 155}, {"id": 2069692, "chapter_id": 2456, "verse_number": "१०-८-१५२", "content_sanskrit": "तेषां नूनं भयान्नासौ कृतवान्कुरुनन्दन।\nअसान्निध्याद्धि पार्थानां केशवस्य च धीमतः।\nसात्यकेश्चापि कर्मेदं द्रोमपुत्रेण साधितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 156}, {"id": 2069693, "chapter_id": 2456, "verse_number": "१०-८-१५३", "content_sanskrit": "को हि तेषां समक्षं तान्हन्यादपि मरुत्पतिः।\nएतदीदृशकं वृत्तं राजन्सुप्तजने विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 157}, {"id": 2069694, "chapter_id": 2456, "verse_number": "१०-८-१५४", "content_sanskrit": "ततो जनक्षयं कृत्वा पाण्डवानां महात्ययम्।\nप्रत्यूषकाले शिबिरात्प्रतिगन्तुमियेष सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 158}, {"id": 2069695, "chapter_id": 2456, "verse_number": "१०-८-१५५", "content_sanskrit": "नृशोणितावसिक्तस्य द्रौणेरासीदसित्सरुः।\nपाणिना सह संश्लिष्ट एकीभूत इव प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 159}, {"id": 2069696, "chapter_id": 2456, "verse_number": "१०-८-१५६", "content_sanskrit": "स निःशेषानरीन्कृत्वा विरराम निशाक्षये।\nयुगान्ते सर्वभूतानि भस्म कृत्वेव पावकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 160}, {"id": 2069697, "chapter_id": 2456, "verse_number": "१०-८-१५७", "content_sanskrit": "यथाप्रतिज्ञं तत्कर्म कृत्वा द्रौणायनिः प्रभो।\nदुर्गमां पदवीं गच्छन्पितुरासीद्गतज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 161}, {"id": 2069698, "chapter_id": 2456, "verse_number": "१०-८-१५८", "content_sanskrit": "यथैव संसुप्तजने शिबिरे प्राविशन्निशि।\nतथैव हत्वा निःशब्दो निश्चक्राम नरर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 162}, {"id": 2069699, "chapter_id": 2456, "verse_number": "१०-८-१५९", "content_sanskrit": "निष्क्रम्य शिबिरात्तस्मात्ताभ्यां सङ्गम्य वीर्यवान्।\nआचख्यौ कर्म तत्सर्वं हृष्टः संहर्षयन्विभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 163}, {"id": 2069700, "chapter_id": 2456, "verse_number": "१०-८-१६०", "content_sanskrit": "तावथाचख्यतुस्तस्मै प्रियं प्रियकरौ तदा।\nपाञ्चालान्सृञ्जयांश्चैव विनिकृत्तान्सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 164}, {"id": 2069701, "chapter_id": 2456, "verse_number": "१०-८-१६१", "content_sanskrit": "प्रीत्या चोच्चैरुद्रक्रोशंस्तथैवास्फोटयंस्तलान्।\nदिष्ट्यादिष्ट्येति चान्योन्यं समेत्योचुर्महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 165}, {"id": 2069702, "chapter_id": 2456, "verse_number": "१०-८-१६२", "content_sanskrit": "पर्यष्वजत्ततो द्रौणिस्ताभ्यां सम्प्रतिनन्दितः।\nइदं हर्षात्तु सुमहदाददे वाक्यमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 166}, {"id": 2069703, "chapter_id": 2456, "verse_number": "१०-८-१६३", "content_sanskrit": "पाञ्चाला निहताः सर्वे द्रौपदेयाश्च सर्वशः।\nसोमका मत्स्यशेषाश्च सर्वे विनिहता मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 167}, {"id": 2069704, "chapter_id": 2456, "verse_number": "१०-८-१६४", "content_sanskrit": "इदानीं कृतकृत्याः स्म याम तत्रैव मा चिरम्।\nयदि जीवति नो राजा तस्मै शंसामहे प्रियम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 168}, {"id": 2069705, "chapter_id": 2456, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि अष्टमोऽध्यायः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 169}]