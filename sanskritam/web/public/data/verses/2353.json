[{"id": 2063595, "chapter_id": 2353, "verse_number": "८-७४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2063596, "chapter_id": 2353, "verse_number": "८-७४-१", "content_sanskrit": "एतच्छ्रुत्वा पाण्डवो धर्मराजो\nभ्रातुर्वाक्यं परुषं फल्गुनस्य।\nउत्थाय तस्माच्छयनादुवाच\nपार्थं ततो दुःखपरीतचेताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2063597, "chapter_id": 2353, "verse_number": "८-७४-२", "content_sanskrit": "कृतं मया पार्थं न साधुकर्म\nयेन प्राप्तं व्यसनं वः सुघोरम्।\nतस्माच्छिरश्छिन्धि ममैतदद्य\nकुलान्तकस्याधमपूरुषस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2063598, "chapter_id": 2353, "verse_number": "८-७४-३", "content_sanskrit": "पापस्य पाप्मोहतस्य वीर\nविमूढबुद्धेरलसस्य भीरोः।\nवृद्धावमन्सुः परुषत्य चैव\nकिं ते चिरं मामनुसृज्य रूक्षम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2063599, "chapter_id": 2353, "verse_number": "८-७४-४", "content_sanskrit": "गच्छाम्यहं वनमद्यैव पापः\nसुखं भवान्वर्ततां मद्विहीनः।\nयोग्यो राजा भीमसेनो महात्मा\nक्लीबस्य किं वा मम राज्यकृत्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2063600, "chapter_id": 2353, "verse_number": "८-७४-५", "content_sanskrit": "न चापि शक्तः परुषाणि सोढुं\nपुनस्तवेमानि रुषान्वितस्य।\nभीमोऽस्तु राजा मम जीवितेन\nन कार्यमद्यावमतस्य वीर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2063601, "chapter_id": 2353, "verse_number": "८-७४-६", "content_sanskrit": "इत्येवमुक्त्वा सहसोत्पपात\nरुषान्वितस्तच्छयनं विहाय।\nइयेष निर्गन्तुमथो वनाय\nतं वासुदेवः प्रणतोऽभ्युवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2063602, "chapter_id": 2353, "verse_number": "८-७४-७", "content_sanskrit": "न राजन्विदितं तत्ते यथा गाण्डीवधन्वनः।\nप्रतिज्ञा सत्यसन्धस्य गाण्डीवं प्रति विश्रुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2063603, "chapter_id": 2353, "verse_number": "८-७४-८", "content_sanskrit": "ब्रूयाद्य एनं गाण्डीवं देह्यन्यस्मै त्वमित्युत।\nवध्योऽस्य स पुमाँल्लोके त्वया चोक्तोयमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2063604, "chapter_id": 2353, "verse_number": "८-७४-९", "content_sanskrit": "ततः सत्यां प्रतिज्ञां तां पार्थेन प्रतिरक्षता।\nमच्छन्दादवमानोऽयं कृतस्तव महीपते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2063605, "chapter_id": 2353, "verse_number": "८-७४-१०", "content_sanskrit": "गुरूणामवमानो हि वध इत्यभिधीयते।\nतस्मात्क्षम महाबाहो मम पार्थस्य चोभयोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2063606, "chapter_id": 2353, "verse_number": "८-७४-११", "content_sanskrit": "व्यतिक्रममिमं राजन्सत्यसंरक्षणं प्रति।\nशरणं त्वां महाराज प्रतिपन्नावुभावपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2063607, "chapter_id": 2353, "verse_number": "८-७४-१२", "content_sanskrit": "क्षन्तुमर्हसि मे राजन्प्रणतस्याभियाचतः।\nराधेयस्याद्य पापस्य भूमिः पास्यति शोणितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2063608, "chapter_id": 2353, "verse_number": "८-७४-१३", "content_sanskrit": "सत्यं ते प्रतिजानामि हतं विद्व्यद्य सूतजम्।\nयस्येच्छसि वधं तस्य गतमेवाद्य जिवीतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2063609, "chapter_id": 2353, "verse_number": "८-७४-१४", "content_sanskrit": "इति कृष्णवचः श्रुत्वा धर्मराजो युधिष्ठिरः।\nससम्भ्रमं हृषीकेशमुत्थाप्य प्रणतं तदा।\nकृताञ्जलिमुवाचेदं वाक्यं यत्समनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2063610, "chapter_id": 2353, "verse_number": "८-७४-१५", "content_sanskrit": "एवमेव यथात्थ त्वमस्त्येषोऽतिक्रमो मम।\nअनुनीतोऽस्मि गोविन्द तारितश्चास्मि माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2063611, "chapter_id": 2353, "verse_number": "८-७४-१६", "content_sanskrit": "मोचिता व्यसनाद्धोराद्वयमद्य त्वयाच्युत।\nभवन्तं नावमासाद्य ह्यावां व्यसनसागरात्।\nघोरादद्य समुत्तीर्णावुभावज्ञानमोहितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2063612, "chapter_id": 2353, "verse_number": "८-७४-१७", "content_sanskrit": "त्वद्बुद्धिप्लवमासाद्य दुःखशोकार्णवाद्वयम्।\nसमुत्तीर्णाः सहामात्याः सनाथाः स्म त्वयाच्युत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2063613, "chapter_id": 2353, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि चतुःसप्ततितमोऽध्यायः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]