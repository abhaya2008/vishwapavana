[{"id": 2036110, "chapter_id": 1786, "verse_number": "५-३१-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2036111, "chapter_id": 1786, "verse_number": "५-३१-१", "content_sanskrit": "उत सन्तमसन्तं वा बालं वृद्धं च सञ्जय।\nउताबलं बलीयांसं धाता प्रकुरुते वशे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2036112, "chapter_id": 1786, "verse_number": "५-३१-२", "content_sanskrit": "उत बालाय पाण्डित्यं पण्डितायोत बालताम्।\nददाति सर्वमीशानः पुरस्ताच्छुक्रमुच्चरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2036113, "chapter_id": 1786, "verse_number": "५-३१-३", "content_sanskrit": "बलं जिज्ञासमानस्य आचक्षीथा यथातथम्।\nअथ मन्त्र मन्त्रयित्वा याथातथ्येन हृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2036114, "chapter_id": 1786, "verse_number": "५-३१-४", "content_sanskrit": "गावल्गणे कुरून्गत्वा धृतराष्ट्रं महाबलम् ।\nअभिवाद्योपसंगृह्य ततः पृच्छेरनामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2036115, "chapter_id": 1786, "verse_number": "५-३१-५", "content_sanskrit": "ब्रूयाश्चैनं त्वमासीनं कुरुभिः परिवारितम् ।\nतवैव राजन्वीर्येण सुखं जीवन्ति पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2036116, "chapter_id": 1786, "verse_number": "५-३१-६", "content_sanskrit": "तव प्रसादाद्बालास्ते प्राप्ता राज्यमरिन्दम।\nराज्ये तान्स्थापयित्वाऽग्रे नोपेक्षस्व विनश्यतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2036117, "chapter_id": 1786, "verse_number": "५-३१-७", "content_sanskrit": "सर्वमप्येतदेकस्य नालं सञ्जय कस्यचित् ।\nतात संहत्य जीवामो द्विषतां मा वशं गमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2036118, "chapter_id": 1786, "verse_number": "५-३१-८", "content_sanskrit": "तथा भीष्मं शान्तनवं भारतानां पितामहम्।\nशिरसाऽभिवदेथास्त्वं मम नाम प्रकीर्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2036119, "chapter_id": 1786, "verse_number": "५-३१-९", "content_sanskrit": "अभिवाद्य च वक्तव्यस्ततोऽस्माकं पितामहः ।\nभवता शन्तनोर्वंशो निमग्नः पुनरुद्धृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2036120, "chapter_id": 1786, "verse_number": "५-३१-१०", "content_sanskrit": "स त्वं कुरु तथा तात स्वमतेन पितामह ।\nयथा जीवन्ति ते पौत्राः प्रीतिमन्तः परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2036121, "chapter_id": 1786, "verse_number": "५-३१-११", "content_sanskrit": "तथैव विदुरं ब्रूयाः कुरूणां मन्त्रधारिणम्।\nअयुद्धं सौम्य भाषस्व हितकामो युधिष्ठिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2036122, "chapter_id": 1786, "verse_number": "५-३१-१२", "content_sanskrit": "अथ दुर्योधनं ब्रूया राजपुत्रममर्षणम्।\nमध्ये कुरूणामासीनमनुनीय पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2036123, "chapter_id": 1786, "verse_number": "५-३१-१३", "content_sanskrit": "अपापां यदुपैक्षस्त्वं कृष्णामेतां सभागताम् ।\nतद्दुःखमतितिक्षाम मा वधीष्म कुरूनिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2036124, "chapter_id": 1786, "verse_number": "५-३१-१४", "content_sanskrit": "एवं पूर्वापरान्क्लेशानतितिक्षन्त पाण्डवाः।\nबलीयांसोऽपि सन्तो यत्तत्सर्वं कुरवो विदुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2036125, "chapter_id": 1786, "verse_number": "५-३१-१५", "content_sanskrit": "यन्नः प्रव्राजयेः सौम्य अजिनैः प्रतिवासितान्।\nतद्दुःखमतितिक्षाम मा वधीषय कुरूनिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2036126, "chapter_id": 1786, "verse_number": "५-३१-१६", "content_sanskrit": "यत्कुन्तीं समतिक्रम्य कृष्णां केशेष्वधर्षयत्।\nदुःशासनस्तेऽनुमते तच्चास्माभिरुपेक्षितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2036127, "chapter_id": 1786, "verse_number": "५-३१-१७", "content_sanskrit": "अथोचितं स्वकं भागं लभेमहि परन्तप।\nनिवर्तय परद्रव्याद्बुद्धिं गृद्धां नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2036128, "chapter_id": 1786, "verse_number": "५-३१-१८", "content_sanskrit": "शान्तिरेवं भवेद्राजन्प्रीतिश्चैव परस्परम् ।\nराज्यैकदेशमपि नः प्रयच्छ शममिच्छताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2036129, "chapter_id": 1786, "verse_number": "५-३१-१९", "content_sanskrit": "अविस्थलं वृकस्थलं माकन्दीं वारणावतम्।\nअवसानं भवत्वत्र किंचिदेकं च पञ्चमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2036130, "chapter_id": 1786, "verse_number": "५-३१-२०", "content_sanskrit": "भ्रातॄणां देहि पञ्चानां पञ्च ग्रामान्सुयोधन।\nशान्तिर्नोस्तु महाप्राज्ञ ज्ञातिभिः सह सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2036131, "chapter_id": 1786, "verse_number": "५-३१-२१", "content_sanskrit": "भ्राता भ्रातरमन्वेतु पिता पुत्रेण युज्यताम्।\nस्मयमानाः समायान्तु पाञ्चालाः कुरुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2036132, "chapter_id": 1786, "verse_number": "५-३१-२२", "content_sanskrit": "अक्षतान्कुरु पाञ्चालान्पश्येयमिति कामये।\nसर्वे सुमनसस्तात शाम्याय भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2036133, "chapter_id": 1786, "verse_number": "५-३१-२३", "content_sanskrit": "अलमेव शमायास्मि तथा युद्धाय सञ्जय।\nधर्मार्थयोरलं चाहं मृदवे दारुणाय च ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2036134, "chapter_id": 1786, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सञ्जययानपर्वणि एकत्रिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]