[{"id": 2055462, "chapter_id": 2214, "verse_number": "७-१४१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2055463, "chapter_id": 2214, "verse_number": "७-१४१-१", "content_sanskrit": "तमुद्यतं महाबाहुं दुःशासनरथं प्रति।\nत्वरितं त्वरणीयेषु धनञ्जयजयैषिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2055464, "chapter_id": 2214, "verse_number": "७-१४१-२", "content_sanskrit": "त्रिगर्तानां महेष्वासाः सुवर्णविकृतध्वजाः।\nसेनासमुद्रमाविष्टमनन्तं पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2055465, "chapter_id": 2214, "verse_number": "७-१४१-३", "content_sanskrit": "अथैनं रथवंशेन सर्वतः सन्निवार्य ते।\nअवाकिरञ्छरव्रातैः क्रुद्धाः परमधन्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2055466, "chapter_id": 2214, "verse_number": "७-१४१-४", "content_sanskrit": "अजयद्राजपुत्रांस्तान्भ्राजमानान्महारणे।\nएकः पञ्चाशतं शत्रून्सात्यकिः सत्यविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2055467, "chapter_id": 2214, "verse_number": "७-१४१-५", "content_sanskrit": "सम्प्राप्य भारतीमध्यं तलघोषसमाकुलम्।\nअसिशक्तिगदापूर्णमप्लुवं सागरं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2055468, "chapter_id": 2214, "verse_number": "७-१४१-६", "content_sanskrit": "`अथैनमनुवृत्तास्तु त्रिगर्ताः सहिताः पुनः।\nतीव्रेण रथवंशेन महता पर्यवारयन्।\nविकर्षन्तोऽतिमात्राणि चापानि भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2055469, "chapter_id": 2214, "verse_number": "७-१४१-७", "content_sanskrit": "तत्राद्भुतमपश्याम शैनेयचरितं रणे।\nप्रतीच्यां दिशि तं दृष्ट्वा प्राच्यां पश्यामि लाघवात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2055470, "chapter_id": 2214, "verse_number": "७-१४१-८", "content_sanskrit": "उदीचीं दक्षिणां प्राचीं प्रतीचीं विदिशस्तथा।\nपुनर्मध्यगतो वीर आहवे युद्धदुर्मदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2055471, "chapter_id": 2214, "verse_number": "७-१४१-९", "content_sanskrit": "एकः पर्यचरन्रङ्गे बहुधा स महाबलः।\nनृत्यन्निवाचरच्छूरो यथा रथशतं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2055472, "chapter_id": 2214, "verse_number": "७-१४१-१०", "content_sanskrit": "तद्दृष्ट्वा चरितं तस्य सिंहविक्रान्तगामिनः।\nत्रिगर्ताः सन्न्यवर्तन्त सन्तप्ताः स्वजनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2055473, "chapter_id": 2214, "verse_number": "७-१४१-११", "content_sanskrit": "तमन्ये शूरसेनानां शूराः सङ्ख्ये न्यवारयन्।\nनियच्छन्तः शरव्रातैर्मत्तं द्विपमिवाङ्कुशैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2055474, "chapter_id": 2214, "verse_number": "७-१४१-१२", "content_sanskrit": "तैर्व्यवाहरदार्यात्मा मुहूर्तादेव सात्यकिः।\nततः कलिङ्गैर्युयुधे सोऽचिन्त्यबलविक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2055475, "chapter_id": 2214, "verse_number": "७-१४१-१३", "content_sanskrit": "तां च सेनामतिक्रम्य कलिङ्गानां दुरत्ययाम्।\nअथ पार्थं महाबाहुर्धनञ्जयमुपासदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2055476, "chapter_id": 2214, "verse_number": "७-१४१-१४", "content_sanskrit": "तरन्निव जले श्रान्तो यथा स्थलमुपेयिवान्।\nतं दृष्ट्वा पुरुषव्याघ्रं युयुधानः समाश्वसत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2055477, "chapter_id": 2214, "verse_number": "७-१४१-१५", "content_sanskrit": "तमायान्तमभिप्रेक्ष्य केशवः पार्थमब्रवीत्।\nअसावायाति शैनेयस्तव पार्थ पदानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2055478, "chapter_id": 2214, "verse_number": "७-१४१-१६", "content_sanskrit": "एष शिष्यः सखा चैव तव सत्यपराक्रमः।\nसर्वान्योधांस्तृणीकृत्य विजिग्ये पुरुषर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2055479, "chapter_id": 2214, "verse_number": "७-१४१-१७", "content_sanskrit": "एष कौरवयोधानां कृत्वा घोरमुपद्रवम्।\nतव प्राणैः प्रियतमः किरीटिन्नेति सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2055480, "chapter_id": 2214, "verse_number": "७-१४१-१८", "content_sanskrit": "एष द्रोणं तथा भोजं कृतवर्माणमेव च।\nकदर्थीकृत्य विशिखैः फल्गुनाभ्येति सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2055481, "chapter_id": 2214, "verse_number": "७-१४१-१९", "content_sanskrit": "धर्मराजप्रियान्वेषी हत्वा योधान्वरान्वरान्।\nशूरश्चैव कृतास्त्रश्च फल्गुनाभ्येति सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2055482, "chapter_id": 2214, "verse_number": "७-१४१-२०", "content_sanskrit": "कृत्वा सुदुष्करं कर्म सैन्यमध्ये महाबलः।\nतव दर्शनमन्विच्छन्पाण्डवाभ्येति सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2055483, "chapter_id": 2214, "verse_number": "७-१४१-२१", "content_sanskrit": "बहूनेकरथेनाजौ योधयित्वा महारथान्।\nआचार्यप्रमुखान्पार्थ प्रयात्येष स सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2055484, "chapter_id": 2214, "verse_number": "७-१४१-२२", "content_sanskrit": "स्वबाहुबलमाश्रित्य विदार्य च वरूथिनीम्।\nप्रेषितो धर्मराजेन पार्थैषोऽभ्येति सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2055485, "chapter_id": 2214, "verse_number": "७-१४१-२३", "content_sanskrit": "प्रियः शिष्यश्च ते पार्थ त्वया तुल्यपराक्रमः।\nविद्राव्यं महतीं सेनामेष ह्यायाति सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2055486, "chapter_id": 2214, "verse_number": "७-१४१-२४", "content_sanskrit": "यस्य नास्ति समो योधः कौरवेषु कथञ्चन।\nसोऽयमायाति कौन्तेय सात्यकिर्युद्धदुर्मदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2055487, "chapter_id": 2214, "verse_number": "७-१४१-२५", "content_sanskrit": "कुरुसैन्याद्विमुक्तो वै सिंहो मध्याद्गवामिव।\nनिहत्य बहुलाः सेनाः पार्थैषोऽब्येति सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2055488, "chapter_id": 2214, "verse_number": "७-१४१-२६", "content_sanskrit": "एष राजसहस्राणां वक्त्रैः पङ्कजसन्निभैः।\nआस्तीर्य वसुधां पार्थ क्षिप्रमायाति सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2055489, "chapter_id": 2214, "verse_number": "७-१४१-२७", "content_sanskrit": "एष दुर्योधनं जित्वा भ्रातृभिः सहितं रणे।\nनिहत्य जलसन्धं च क्षिप्रमायाति सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2055490, "chapter_id": 2214, "verse_number": "७-१४१-२८", "content_sanskrit": "रुधिरौघवतीं कृत्वा नदीं शोणितकर्दमाम्।\nतृणवद्व्यस्य कौरव्यानेष ह्यायाति सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2055491, "chapter_id": 2214, "verse_number": "७-१४१-२९x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2055492, "chapter_id": 2214, "verse_number": "७-१४१-२९", "content_sanskrit": "ततः प्रहृष्टः कौन्तेयः केशवं वाक्यमब्रवीत्।\nन मे प्रियं महाबाहो यन्मामभ्येति सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2055493, "chapter_id": 2214, "verse_number": "७-१४१-३०", "content_sanskrit": "न हि जानामि वृत्तान्तं धर्मराजस्य केशव।\nसात्वतेन विहीनः स यदि जीवति वा न वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2055494, "chapter_id": 2214, "verse_number": "७-१४१-३१", "content_sanskrit": "एतेन हि महाबाहो रक्षितव्यः स पार्थिवः।\nतमेष कथमुत्सृज्य मम कृष्ण पदानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2055495, "chapter_id": 2214, "verse_number": "७-१४१-३२", "content_sanskrit": "राजा द्रोणाय चोत्सृष्टः सैन्धवश्चानिपातितः।\nप्रत्युद्याति च शैनेयमेष भूरिश्रवा रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2055496, "chapter_id": 2214, "verse_number": "७-१४१-३३", "content_sanskrit": "सोऽयं गुरुतरो भारः सैन्धवार्थे समाहितः।\nज्ञातव्यश्च हि मे राजा रक्षितव्यश्च सात्यकिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2055497, "chapter_id": 2214, "verse_number": "७-१४१-३४", "content_sanskrit": "जयद्रथश्च हन्तव्यो लम्बते च दिवाकरः।\nश्रान्तश्चैष महाबाहुरल्पप्राणश्च साम्प्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2055498, "chapter_id": 2214, "verse_number": "७-१४१-३५", "content_sanskrit": "परिश्रान्ता हयाश्चास्य हययन्ता च माधव।\nन च भूरिश्रवाः श्रान्तः ससहायश्च केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2055499, "chapter_id": 2214, "verse_number": "७-१४१-३६", "content_sanskrit": "अपीदानीं भवेदस्य क्षेममस्मिन्समागमे।\nकच्चिन्न सागरं तीर्त्वा सात्यकिः सत्यविक्रमः।\nगोष्पदं प्राप्य सीदेत महौजाः शिनिपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2055500, "chapter_id": 2214, "verse_number": "७-१४१-३७", "content_sanskrit": "अपि कौरवमुख्येन कृतास्त्रेण महात्मना।\nसमेत्य भूरिश्रवसा स्वस्तिमान्सात्यकिर्भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2055501, "chapter_id": 2214, "verse_number": "७-१४१-३८", "content_sanskrit": "व्यतिक्रममिमं मन्ये धर्मराजस्य केशव।\nआचार्याद्भयमुत्सृज्य यः प्रैषयत सात्यकिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2055502, "chapter_id": 2214, "verse_number": "७-१४१-३९", "content_sanskrit": "ग्रहणं धर्मराजस्य खगः श्येन इवामिषम्।\nनित्यमाशंसते द्रोणः कच्चित्स्यात्कुशली नृपः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2055503, "chapter_id": 2214, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे एकचत्वारिंशदधिकशततमोऽध्यायः॥ १४१ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१४१-१ तुरणीयेषु कृत्येषु॥ ५-१४१-१४१ एकचत्वारिंशदधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]