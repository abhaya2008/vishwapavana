[{"id": 2135673, "chapter_id": 3943, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2135674, "chapter_id": 3943, "verse_number": "१", "content_sanskrit": "सन्तिष्ठध्वं प्रहरत तूर्णं विपरिधावत ।\nइति स्म सैन्धवो राजा चोदयामास तान् नृपान् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2135675, "chapter_id": 3943, "verse_number": "२", "content_sanskrit": "ततो घोरतमः शब्दो रणे समभवत् तदा ।\nभीमार्जुनयमान् दृष्ट्वा सैन्यानां सयुधिष्ठिरान् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2135676, "chapter_id": 3943, "verse_number": "३", "content_sanskrit": "शिबिसिन्धुत्रिगर्तानां विषादश्चाप्यजायत ।\nतान् दृष्ट्वा पुरुषव्याघ्रान् व्याघ्रानिव बलोत्कटान् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2135677, "chapter_id": 3943, "verse_number": "४", "content_sanskrit": "हेमबिन्दुं महोत्सेधां सर्वशैक्यायसीं गदाम् ।\nप्रगृह्याभ्यद्रवद् भीमः सैन्धवं कालचोदितम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2135678, "chapter_id": 3943, "verse_number": "५", "content_sanskrit": "तदन्तरमथावृत्य कोटिकाश्योऽभ्यहारयत् ।\nमहता रथवंशेन परिवार्य वृकोदरम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2135679, "chapter_id": 3943, "verse_number": "६", "content_sanskrit": "शक्तितोमरनाराचैर्वीरबाहुप्रचोदितैः ।\nकीर्यमाणोऽपि बहुभिर्न स्म भीमोऽभ्यकम्पत \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2135680, "chapter_id": 3943, "verse_number": "७", "content_sanskrit": "गजं तु सगजारोहं पदातींश्च चतुर्दश ।\nजघान गदया भीमः सैन्धवध्वजिनीमुखे \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2135681, "chapter_id": 3943, "verse_number": "८", "content_sanskrit": "पार्थः पञ्च शतान् शूरान् पार्वतीयान् महारथान् ।\nपरीप्समानः सौवीरं जघान ध्वजिनीमुखे \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2135682, "chapter_id": 3943, "verse_number": "९", "content_sanskrit": "राजा स्वयं सुवीराणां प्रवराणां प्रहारिणाम् ।\nनिमेषमात्रेण शतं जघान समरे तदा \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2135683, "chapter_id": 3943, "verse_number": "१०", "content_sanskrit": "ददृशे नकुलस्तत्र रथात् प्रस्कन्द्य खड्गधृक्।\nशिरांसि पादरक्षाणां बीजवत् प्रवपन् मुहुः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2135684, "chapter_id": 3943, "verse_number": "११", "content_sanskrit": "सहदेवस्तु संयाय रथेन गजयोधिनः ।\nपातयामास नाराचैर्द्रुमेभ्य इव बर्हिणः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2135685, "chapter_id": 3943, "verse_number": "१२", "content_sanskrit": "ततस्त्रिगर्तः सधनुरवतीर्य महारथात् ।\nगदया चतुरो वाहान् राज्ञस्तस्य तदाऽवधीत् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2135686, "chapter_id": 3943, "verse_number": "१३", "content_sanskrit": "तमथाभ्यागतं राजा पदातिं कुन्तिनन्दनः ।\nअर्धचन्द्रेण बाणेन विव्याधोरसि धर्मराट् \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2135687, "chapter_id": 3943, "verse_number": "१४", "content_sanskrit": "स भिन्नहृदयो वीरो वक्त्राच्छोणितमुद्वमन्।\nपपाताभिमुखं प्राप्तश्छिन्नमूल इव द्रुमः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2135688, "chapter_id": 3943, "verse_number": "१५", "content_sanskrit": "इन्द्रसेनद्वितीयस्तु रथात् प्रस्कन्द्य धर्मराट् ।\nहताश्वः सहदेवस्य प्रतिपेदे महारथम् \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2135689, "chapter_id": 3943, "verse_number": "१६", "content_sanskrit": "नकुलं त्वभिसंवार्य क्षेमङ्करमहामुखौ ।\nउभावुभयतस्तीक्ष्णैः शरवर्षैरवर्षताम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2135690, "chapter_id": 3943, "verse_number": "१७", "content_sanskrit": "तौ शरैरभिवर्षन्तौ जीमूताविव वार्षिकौ ।\nएकैकेन विपाठेन जघ्ने माद्रवतीसुतः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2135691, "chapter_id": 3943, "verse_number": "१८", "content_sanskrit": "त्रिगर्तराजः सुरथस्तस्याथ गजधूर्गतः ।\nरथमाक्षेपयामास गजेन गजयानवित् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2135692, "chapter_id": 3943, "verse_number": "१९", "content_sanskrit": "नकुलस्त्वपभीस्तस्माद् रथाच्चर्मासिपाणिमान् ।\nउद्भ्राम्य स्थानमास्थाय तस्थौ गिरिरिवाचलः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2135693, "chapter_id": 3943, "verse_number": "२०", "content_sanskrit": "सुरथस्तं गजवरं वधाय नकुलस्य तु ।\nप्रेषयामास सक्रोधमत्युच्छ्रितकरं ततः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2135694, "chapter_id": 3943, "verse_number": "२१", "content_sanskrit": "नकुलस्तस्य नागस्य समीपपरिवर्तिनः।\nसविषाणं भुजं मूले खड्गेन निरकृन्तत \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2135695, "chapter_id": 3943, "verse_number": "२२", "content_sanskrit": "स विनद्य महानादं गजः किङ्किणिभूषणः।\nपतन्नवाक्शिरा भूमौ हस्त्यारोहमपोथयत् \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2135696, "chapter_id": 3943, "verse_number": "२३", "content_sanskrit": "स तत्कर्म महत्कृत्वा शूरो माद्रवतीसुतः ।\nभीमसेनरथं प्राप्य शर्म लेभे महारथः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2135697, "chapter_id": 3943, "verse_number": "२४", "content_sanskrit": "भीमस्त्वापततो राज्ञः कोटिकाश्यस्य सङ्गरे ।\nसूतस्य नुदतो वाहान् क्षुरेणापाहरच्छिरः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2135698, "chapter_id": 3943, "verse_number": "२५", "content_sanskrit": "न बुबोध हतं सूतं स राजा बाहुशालिना ।\nतस्याश्वा व्यद्रवन् सङ्खे हतसूतास्ततस्ततः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2135699, "chapter_id": 3943, "verse_number": "२६", "content_sanskrit": "विमुखं हतसूतं तं भीमः प्रहरतां वरः ।\nजघान तळयुक्तेन प्रासेनाभ्येत्य पाण्डवः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2135700, "chapter_id": 3943, "verse_number": "२७", "content_sanskrit": "द्वादशानां तु सर्वेषां सौवीराणां धनञ्जयः ।\nचकर्त निशितैर्भल्लैर्धनूंषि च शिरांसि च \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2135701, "chapter_id": 3943, "verse_number": "२८", "content_sanskrit": "शिबीनिक्ष्वाकुमुख्यांश्च त्रिगर्तान् सैन्धवानपि ।\nजघानातिरथः सङ्खे बाणगोचरमागतान् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2135702, "chapter_id": 3943, "verse_number": "२९", "content_sanskrit": "सादिताः प्रत्यदृश्यन्त बहुशः सव्यसाचिना ।\nसपताकाश्च मातङ्गाः सध्वजाश्च महारथाः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2135703, "chapter_id": 3943, "verse_number": "३०", "content_sanskrit": "प्रच्छाद्य पृथिवीं तस्थुः सर्वमायोधनं प्रति ।\nशरीराण्यशिरस्कानि विदेहानि शिरांसि च \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2135704, "chapter_id": 3943, "verse_number": "३१", "content_sanskrit": "श्वगृध्रकङ्ककाकोलभासगोमायुवायसाः ।\nअतृप्यंस्तत्र वीराणां हतानां मांसशोणितैः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2135705, "chapter_id": 3943, "verse_number": "३२", "content_sanskrit": "एवं तीक्ष्णशरज्वालैर्गाण्डिवानलचोदितैः ।\nसेनेन्धनं ददाहाशु सरोषः पार्थपावकः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2135706, "chapter_id": 3943, "verse_number": "३३", "content_sanskrit": "चक्राणां पतितानां च युगानां च महीपते ।\nतूणीराणां पताकानां ध्वजानां च रथैः सह\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2135707, "chapter_id": 3943, "verse_number": "३४", "content_sanskrit": "ईषाणमनुकर्षाणां त्रिवेणूनां तथैव च ।\nअक्षाणामथ योक्तॄणां प्रतोदानां च राशयः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2135708, "chapter_id": 3943, "verse_number": "३५", "content_sanskrit": "शिरसां पतितानां च कुण्डलोष्णीषधारिणाम् ।\nभुजानां च मकुटानां च हाराणामङ्गदैस्सह \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2135709, "chapter_id": 3943, "verse_number": "३६", "content_sanskrit": "छत्राणां व्यजनानां च चर्मणां वर्मणां तथा ।\nछिन्नानां कार्मुकानां च पट्टसानां तथैव च\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2135710, "chapter_id": 3943, "verse_number": "३७", "content_sanskrit": "शक्तीनामथ खड्गानां दण्डानां सह तोमरैः ।\nराशयश्चात्र दृश्यन्ते तत्र तत्र विशाम्पते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2135711, "chapter_id": 3943, "verse_number": "३८", "content_sanskrit": "पतितैश्चैव मातङ्गैः सयोधैः पर्वतोपमैः ।\nहयैर्द्विधाकृतैः सार्धं सादिभिः सायुधैस्तथा\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2135712, "chapter_id": 3943, "verse_number": "३९", "content_sanskrit": "विप्रविद्धैः रथैश्चैव निहतैश्च पदातिभिः ।\nअगम्यरूपा पृथिवी मांसशोणितकर्दमा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2135713, "chapter_id": 3943, "verse_number": "४०", "content_sanskrit": "हतेषु तेषु वीरेषु सिन्धुराजो जयद्रथः ।\nविमुच्य कृष्णां सन्त्रस्तः पलायनपरोऽभवत् \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2135714, "chapter_id": 3943, "verse_number": "४१", "content_sanskrit": "विद्राव्यमाने सैन्ये तु मकरैरर्णवो यथा ।\nस तस्मिन् सङ्कुले सैन्ये द्रौपदीमवतार्य ताम् ।\nप्राणप्रेप्सुरुपाधावद्वनं येन नराधमः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2135715, "chapter_id": 3943, "verse_number": "४२", "content_sanskrit": "द्रौपदीं धर्मराजस्तु दृष्ट्वा धौम्यपुरस्कृताम् ।\nमाद्रीपुत्रेण वीरेण रथमारोपयत् तदा \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2135716, "chapter_id": 3943, "verse_number": "४३", "content_sanskrit": "ततस्तद् विद्रुतं सैन्यमपयाते जयद्रथे ।\nआदिश्यादिश्य नाराचैराजघान वृकोदरः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2135717, "chapter_id": 3943, "verse_number": "४४", "content_sanskrit": "सव्यसाची तु तं दृष्ट्वा पलायन्तं जयद्रथम् ।\nवारयामास निघ्नन्तं भीमं सैन्धवसैनिकान् \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2135718, "chapter_id": 3943, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2135719, "chapter_id": 3943, "verse_number": "४५", "content_sanskrit": "यस्यापचारात् प्राप्तोऽयमस्मान् क्लेशो दुरासदः ।\nतमस्मिन् समरोद्देशे न पश्यामि जयद्रथम् \t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2135720, "chapter_id": 3943, "verse_number": "४६", "content_sanskrit": "(मूढं नैकृतिकं दुष्टं द्रौपद्याक्लेशकारिणम् ।)\nतमेवान्विष भद्रं ते किं ते योधैर्निपातितैः।\nअनामिषमिदं कर्म कथं वा मन्यते भवान् \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2135721, "chapter_id": 3943, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2135722, "chapter_id": 3943, "verse_number": "४७", "content_sanskrit": "इत्युक्तो भीमसेनस्तु गुडाकेशेन धीमता ।\nयुधिष्ठिरमभिप्रेक्ष्य वाग्मी वचनमब्रवीत् \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2135723, "chapter_id": 3943, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2135724, "chapter_id": 3943, "verse_number": "४८", "content_sanskrit": "हतप्रवीरा रिपवो भूयिष्ठं विद्रुता दिशः ।\nगृहीत्वा द्रौपदीं राजन् निवर्ततु भवानितः \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2135725, "chapter_id": 3943, "verse_number": "४९", "content_sanskrit": "यमाभ्यां सह राजेन्द्र धौम्येन च महात्मना ।\nप्राप्याश्रमपदं राजन् द्रौपदीं परिसान्त्वय \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2135726, "chapter_id": 3943, "verse_number": "५०", "content_sanskrit": "न हि मे मोक्ष्यते जीवन् मूढः सैन्धवको नृपः ।\nपाताळतळसंस्थोऽपि यदि शक्रोऽस्य सारथिः \t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2135727, "chapter_id": 3943, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2135728, "chapter_id": 3943, "verse_number": "५१", "content_sanskrit": "न हन्तव्यो महाबाहो दुरात्मापि स सैन्धवः ।\nदुःशलामभिसंस्मृत्य गान्धारीं च यशस्विनीम् \t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2135729, "chapter_id": 3943, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2135730, "chapter_id": 3943, "verse_number": "५२", "content_sanskrit": "तच्छ्रुत्वा द्रौपदी भीममुवाच व्याकुलेन्द्रिया ।\nकुपिता ह्रीमती प्राज्ञा पती भीमार्जुनावुभौ \t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2135731, "chapter_id": 3943, "verse_number": "", "content_sanskrit": "द्रौपदी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2135732, "chapter_id": 3943, "verse_number": "५३", "content_sanskrit": "कर्तव्यं चेत् प्रियं मह्यं वध्यः स पुरुषाधमः ।\nसैन्धवापसदः पापो दुर्मतिः कुलपांसनः \t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2135733, "chapter_id": 3943, "verse_number": "५४", "content_sanskrit": "भार्याभिमर्ष्टा निर्वैरो यश्च राज्यापहारकः ।\nयाचमानोऽपि सङ्ग्रामे न मोक्तव्यः कथञ्चन \t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2135734, "chapter_id": 3943, "verse_number": "", "content_sanskrit": "वैशम्पायनः-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2135735, "chapter_id": 3943, "verse_number": "५५", "content_sanskrit": "इत्युक्तौ तौ नरव्याघ्रौ ययतुर्यत्र सैन्धवः ।\nराजा निववृते कृष्णामादाय सपुरोहितः \t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2135736, "chapter_id": 3943, "verse_number": "५६", "content_sanskrit": "स प्रविश्याश्रमपदमपविद्धबृसीकट(मठ)म् ।\nमार्कण्डेयादिभिर्विप्रैरनुकीर्णं ददर्श ह \t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2135737, "chapter_id": 3943, "verse_number": "५७", "content_sanskrit": "द्रौपदीमनुशोचद्भिर्ब्राह्मणैस्तैः समाहितैः ।\nसमियाय महाप्राज्ञः सभार्यो भ्रातृमध्यगः \t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2135738, "chapter_id": 3943, "verse_number": "५८", "content_sanskrit": "ते स्म तं मुदिता दृष्ट्वा पुनरत्यागतं नृपम्।\nजित्वा तान्सिन्धुसौवीरान्द्रौपदीं चाहृतां पुनः।\nस तैः परिवृतो राजा तत्रैवोपविवेश ह \t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2135739, "chapter_id": 3943, "verse_number": "५९", "content_sanskrit": "प्रविवेशाश्रमं कृष्णा यमाभ्यां सह भामिनी \t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2135740, "chapter_id": 3943, "verse_number": "६०", "content_sanskrit": "भीमसेनार्जुनौ चापि श्रुत्वा क्रोशगतं रिपुम् ।\nस्वयमश्वांस्तुदन्तौ तौ जवेनैवाभ्यधावताम् \t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2135741, "chapter_id": 3943, "verse_number": "६१", "content_sanskrit": "इदमत्यद्भुतं चात्र चकार पुरुषोऽर्जुनः ।\nक्रोशमात्रगतानश्वान् सैन्धवस्य जघान यत् \t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2135742, "chapter_id": 3943, "verse_number": "६२", "content_sanskrit": "स हि दिव्यास्त्रसम्पन्नः कृच्छ्रकालेऽप्यसम्भ्रमः ।\nअकरोद् दुष्करं कर्म शरैरस्त्रानुमन्त्रितैः \t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2135743, "chapter_id": 3943, "verse_number": "६३", "content_sanskrit": "ततोऽभ्यधावतां वीरावुभौ भीमधनञ्जयौ ।\nहताश्वं सैन्धवं भीतमेकं व्याकुलचेतसम् \t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2135744, "chapter_id": 3943, "verse_number": "६४", "content_sanskrit": "सैन्धवस्तु हतान् दृष्ट्वा तथाऽश्वान् स्वान् सुदुःखितः ।\nरथात् प्रस्कन्द्य पद्भ्यां वै पलायनपरोऽभवत् \t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2135745, "chapter_id": 3943, "verse_number": "६५", "content_sanskrit": "दृष्ट्वा विक्लवकर्माणि कुर्वाणं च धनञ्जयम्।\nपलायनकृतोत्साहः प्राद्रवद्येन वै वनम् \t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2135746, "chapter_id": 3943, "verse_number": "६६", "content_sanskrit": "सैन्धवं त्वभिसम्प्रेक्ष्य पराक्रान्तं पलायने ।\nअनुयाय महाबाहुः फाल्गुनो वाक्यमब्रवीत् \t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2135747, "chapter_id": 3943, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2135748, "chapter_id": 3943, "verse_number": "६७", "content_sanskrit": "अनेन वीर्येण कथं स्त्रियं प्रार्थयसे बलात् ।\nराजपुत्र निवर्तस्व न ते युक्तं पलायनम् ।\nकथं ह्यनुचरान् हित्वा शत्रुमध्ये पलायसे \t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2135749, "chapter_id": 3943, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2135750, "chapter_id": 3943, "verse_number": "६८", "content_sanskrit": "इत्युच्यमानः पार्थेन सैन्धवो न न्यवर्तत \t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2135751, "chapter_id": 3943, "verse_number": "६९", "content_sanskrit": "तिष्ठ तिष्ठेति तं भीमः सहसाभ्यद्रवद् बली ।\nमा वधीरिति पार्थस्तं दयावान् प्रत्यभाषत \t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2135752, "chapter_id": 3943, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि द्रौपदीहरणपर्वणि जयद्रथपलायने एकोनषष्ट्यधिकद्विशततमोऽध्यायः ॥२५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2135753, "chapter_id": 3943, "verse_number": "", "content_sanskrit": "द्रौपदीहरणपर्वणि अष्टमोऽध्यायः ॥८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]