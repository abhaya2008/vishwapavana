[{"id": 7001267000, "chapter_id": 21267, "verse_number": "२-५-४०-१", "content_sanskrit": "श्रीसूत उवाच ।\nइति स विजितमन्योर्यादवेनोपमन्योरधिगतमभिधाय ज्ञानयोगं मुनिभ्यः ।\nप्रणतिमुपगतेभ्यस्तेभ्य उद्भावितात्मा सपदि वियति वायुः सायमन्तर्हितो ऽभूत्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001267001, "chapter_id": 21267, "verse_number": "२-५-४०-२", "content_sanskrit": "ततः प्रभातसमये नैमिषीयास्तपोधनाः ।\nसत्रान्ते ऽवभृथं कर्तुं सर्व एव समुद्ययुः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001267002, "chapter_id": 21267, "verse_number": "२-५-४०-३", "content_sanskrit": "तदा ब्रह्मसमादेशाद्देवी साक्षात्सरस्वती ।\nप्रसन्ना स्वादुसलिला प्रावर्तत नदीशुभा॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001267003, "chapter_id": 21267, "verse_number": "२-५-४०-४", "content_sanskrit": "सरस्वतीं नदीं दृष्ट्वा मुनयो हृष्टमानसाः ।\nसमाप्य सत्रं प्रारब्धं चक्रुस्तत्रावगाहनम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001267004, "chapter_id": 21267, "verse_number": "२-५-४०-५", "content_sanskrit": "अथ संतर्प्य देवादींस्तदीयैः सलिलैः शिवैः ।\nस्मरन्तः पूर्ववृत्तान्तं ययुर्वाराणसीं प्रति॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001267005, "chapter_id": 21267, "verse_number": "२-५-४०-६", "content_sanskrit": "तदा ते हिमवत्पादात्पंततीं दक्षिणामुखीम् ।\nदृष्ट्वा भागीरथी तत्र स्नात्वा तत्तीरतो ययुः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001267006, "chapter_id": 21267, "verse_number": "२-५-४०-७", "content_sanskrit": "ततो वाराणसीं प्राप्य मुदितास्सर्व एव ते ।\nतदोत्तरप्रवाहायां गंगायामवगाह्य च॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001267007, "chapter_id": 21267, "verse_number": "२-५-४०-८", "content_sanskrit": "अविमुक्तेश्वरं लिंगं दृष्ट्वाभ्यर्च्य विधानतः ।\nप्रयातुमुद्यतास्तत्र ददृशुर्दिवि भास्वरम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001267008, "chapter_id": 21267, "verse_number": "२-५-४०-९", "content_sanskrit": "सूर्यकोटिप्रतीकाशं तेजोदिव्यं महाद्भुतम् ।\nआत्मप्रभावितानेन व्याप्तसर्वदिगन्तरम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001267009, "chapter_id": 21267, "verse_number": "२-५-४०-१०", "content_sanskrit": "अथ पाशुपताः सिद्धाः भस्मसञ्छन्नविग्रहाः ।\nमुनयो ऽभ्येत्य शतशो लीनाः स्युस्तत्र तेजसि॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001267010, "chapter_id": 21267, "verse_number": "२-५-४०-११", "content_sanskrit": "तथा विलीयमानेषु तपस्विषु महात्मसु ।\nसद्यस्तिरोदधे तेजस्तदद्भुतमिवाभवत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001267011, "chapter_id": 21267, "verse_number": "२-५-४०-१२", "content_sanskrit": "तद्दृष्ट्वा महदाश्चर्यं नैमिषीया महर्षयः ।\nकिमेतदित्यजानन्तो ययुर्ब्रह्मवनं प्रति॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001267012, "chapter_id": 21267, "verse_number": "२-५-४०-१३", "content_sanskrit": "प्रागेवैषां तु गमनात्पवनो लोकपावनः ।\nदर्शनं नैमिषीयाणां संवादस्तैर्महात्मनः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001267013, "chapter_id": 21267, "verse_number": "२-५-४०-१४", "content_sanskrit": "शद्धां बुद्धिं ततस्तेषां सांबे सानुचरे शिवे ।\nसमाप्तिं चापि सत्रस्य दीर्घपूर्वस्य सत्रिणाम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001267014, "chapter_id": 21267, "verse_number": "२-५-४०-१५", "content_sanskrit": "विज्ञाप्य जगतां धात्रे ब्रह्मणे ब्रह्मयोनये ।\nस्वकार्ये तदनुज्ञातो जगाम स्वपुरं प्रति॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001267015, "chapter_id": 21267, "verse_number": "२-५-४०-१६", "content_sanskrit": "अथ स्थानगतो ब्रह्मा तुम्बुरोर्नारदस्य च ।\nपरस्पर स्पर्धितयोर्गाने विवदमानयोः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001267016, "chapter_id": 21267, "verse_number": "२-५-४०-१७", "content_sanskrit": "तदुद्भावितगानोत्थरसैर्माध्यस्थमाचरन् ।\nगन्धर्वैरप्सरोभिश्च सुखमास्ते निषेवितः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001267017, "chapter_id": 21267, "verse_number": "२-५-४०-१८", "content_sanskrit": "तदानवसरादेव द्वाःस्थैर्द्वारि निवारिताः ।\nमुनयो ब्रह्मभवनाद्बहिः पार्श्वमुपाविशन्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001267018, "chapter_id": 21267, "verse_number": "२-५-४०-१९", "content_sanskrit": "अथ तुम्बुरुणा गाने समतां प्राप्य नारदः ।\nसाहचर्येष्वनुज्ञातो ब्रह्मणा परमेष्ठिना॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001267019, "chapter_id": 21267, "verse_number": "२-५-४०-२०", "content_sanskrit": "त्यक्त्वा परस्परस्पर्धां मैत्रीं च परमां गतः ।\nसह तेनाप्सरोभिश्च गन्धर्वैश्च समावृतः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001267020, "chapter_id": 21267, "verse_number": "२-५-४०-२१", "content_sanskrit": "उपवीणयितुं देवं नकुलीश्वरमीश्वरम् ।\nभवनान्निर्ययौ धातुर्जलदादंशुमानिव॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001267021, "chapter_id": 21267, "verse_number": "२-५-४०-२२", "content_sanskrit": "तं दृष्ट्वा षट्कुलीयास्ते नारदं मुनिगोवृषम् ।\nप्रणम्यावसरं शंभोः पप्रच्छुः परमादरात्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001267022, "chapter_id": 21267, "verse_number": "२-५-४०-२३", "content_sanskrit": "स चावसर एवायमितोंतर्गम्यतामिति ।\nवदन्ययावन्यपरस्त्वरया परया युतः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001267023, "chapter_id": 21267, "verse_number": "२-५-४०-२४", "content_sanskrit": "ततो द्वारि स्थिता ये वै ब्रह्मणे तान्न्यवेदयन् ।\nतेन ते विविशुर्वेश्म पिंडीभूयांडजन्मनः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001267024, "chapter_id": 21267, "verse_number": "२-५-४०-२५", "content_sanskrit": "प्रविश्य दूरतो देवं प्रणम्य भुवि दंडवत् ।\nसमीपे तदनुज्ञाताः परिवृत्योपतस्थिरे॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001267025, "chapter_id": 21267, "verse_number": "२-५-४०-२६", "content_sanskrit": "तांस्तत्रावस्थितान् पृष्ट्वा कुशलं कमलासनः ।\nवृत्तांतं वो मया ज्ञातं वायुरेवाह नो यतः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001267026, "chapter_id": 21267, "verse_number": "२-५-४०-२७", "content_sanskrit": "भवद्भिः किं कृतं पश्चान्मारुतेंतर्हिते सति ।\nइत्युक्तवति देवेशे मुनयो ऽवभृथात्परम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001267027, "chapter_id": 21267, "verse_number": "२-५-४०-२८", "content_sanskrit": "गंगातीर्थेस्य गमनं यात्रां वाराणसीं प्रति ।\nदर्शनं तत्र लिंगानां स्थापितानां सुरेश्वरैः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001267028, "chapter_id": 21267, "verse_number": "२-५-४०-२९", "content_sanskrit": "अविमुक्तेश्वरस्यापि लिंगस्याभ्यर्चनं सकृत् ।\nआकाशे महतस्तस्य तेजोराशेश्च दर्शनम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001267029, "chapter_id": 21267, "verse_number": "२-५-४०-३०", "content_sanskrit": "मुनीनां विलयं तत्र निरोधं तेजसस्ततः ।\nयाथात्म्यवेदनं तस्य चिंतितस्यापि चात्मभिः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001267030, "chapter_id": 21267, "verse_number": "२-५-४०-३१", "content_sanskrit": "सर्वं सविस्तरं तस्मै प्रणम्याहुर्मुहुर्मुहुः ।\nमुनिभिः कथितं श्रुत्वा विश्वकर्मा चतुर्मुखः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001267031, "chapter_id": 21267, "verse_number": "२-५-४०-३२", "content_sanskrit": "कंपयित्वा शिरः किंचित्प्राह गंभीरया गिरा ।\nप्रत्यासीदति युष्माकं सिद्धिरामुष्मिकी परा॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001267032, "chapter_id": 21267, "verse_number": "२-५-४०-३३", "content_sanskrit": "भवद्भिर्दीर्घसत्रेण चिरमाराधितः प्रभुः ।\nप्रसादाभिमुखो भूत इति भुतार्थसूचितम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001267033, "chapter_id": 21267, "verse_number": "२-५-४०-३४", "content_sanskrit": "वाराणस्यां तु युष्माभिर्यद्दृष्टं दिवि दीप्तिमत् ।\nतल्लिंगसंज्ञितं साक्षात्तेजो माहेश्वरं परम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001267034, "chapter_id": 21267, "verse_number": "२-५-४०-३५", "content_sanskrit": "तत्र लीनाश्च मुनयः श्रौतपाशुपतव्रताः ।\nमुक्ता बभूवुः स्वस्थाश्च नैष्ठिका दग्धकिल्बिषाः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001267035, "chapter_id": 21267, "verse_number": "२-५-४०-३६", "content_sanskrit": "प्राप्यानेन यथा मुक्तिरचिराद्भवतामपि ।\nस चायमर्थः सूच्येत युष्मद्दृष्टेन तेजसा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001267036, "chapter_id": 21267, "verse_number": "२-५-४०-३७", "content_sanskrit": "तत्र वः काल एवैष दैवादुपनतः स्वयम् ।\nप्रयात दक्षिणं मेरोः शिखरं देवसेवितम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001267037, "chapter_id": 21267, "verse_number": "२-५-४०-३८", "content_sanskrit": "सनत्कुमारो यत्रास्ते मम पुत्रः परो मुनिः ।\nप्रतीक्ष्यागमनं साक्षाद्भूतनाथस्य नंदिनः॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001267038, "chapter_id": 21267, "verse_number": "२-५-४०-३९", "content_sanskrit": "पुरा सनत्कुमारोपि दृष्ट्वापि परमेश्वरम् ।\nअज्ञानात्सर्वयोगीन्द्रमानी विनयदूषितः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001267039, "chapter_id": 21267, "verse_number": "२-५-४०-४०", "content_sanskrit": "अभ्युत्थानादिकं युक्तमकुर्वन्नतिनिर्भयः ।\nततो ऽपराधात्क्रुद्धेन महोष्ट्रो नंदिना कृतः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001267040, "chapter_id": 21267, "verse_number": "२-५-४०-४१", "content_sanskrit": "अथ कालेन महता तदर्थे शोचता मया ।\nउपास्य देवं देवीञ्च नंदिनं चानुनीय वै॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001267041, "chapter_id": 21267, "verse_number": "२-५-४०-४२", "content_sanskrit": "कथंचिदुष्ट्रता तस्य प्रयत्नेन निवारिता ।\nप्रापितो हि यथापूर्वं सनत्पूर्वां कुमारताम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001267042, "chapter_id": 21267, "verse_number": "२-५-४०-४३", "content_sanskrit": "तदाह च महादेवः स्मयन्निव गणाधिपम् ।\nअवज्ञाय हि मामेव तथाहंकृतवान्मुनिः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001267043, "chapter_id": 21267, "verse_number": "२-५-४०-४४", "content_sanskrit": "अतस्त्वमेव याथात्म्यं ममास्मै कथयानघ ।\nब्रह्मणः पूर्वजः पुत्रो मां मूढ इव संस्मरन्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001267044, "chapter_id": 21267, "verse_number": "२-५-४०-४५", "content_sanskrit": "मयैव शिष्यते दत्तो मम ज्ञानप्रवर्तकः ।\nधर्माध्यक्षाभिषेकं च तव निर्वर्तयिष्यति॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001267045, "chapter_id": 21267, "verse_number": "२-५-४०-४६", "content_sanskrit": "स एवं व्याहृतो भूयस्सर्वभूतगणाग्रणीः ।\nयत्पराज्ञापनं मूर्ध्ना प्रातः प्रतिगृहीतवान्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001267046, "chapter_id": 21267, "verse_number": "२-५-४०-४७", "content_sanskrit": "तथा सनत्कुमारो ऽपि मेरौ मदनुशासनात् ।\nप्रसादार्थं गणस्यास्य तपश्चरति दुश्चरम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001267047, "chapter_id": 21267, "verse_number": "२-५-४०-४८", "content_sanskrit": "द्रष्टव्यश्चेति युष्माभिः प्राग्गणेशसमागमात् ।\nतत्प्रसादार्थमचिरान्नंदी तत्रागमिष्यति॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]