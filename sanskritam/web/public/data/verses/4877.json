[{"id": 2182847, "chapter_id": 4877, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2182848, "chapter_id": 4877, "verse_number": "१", "content_sanskrit": "कथं धर्मे स्थातुमिच्छन् राजा वर्तेत धार्मिकः ।\nपृच्छामि त्वा कुरुश्रेष्ठ तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2182849, "chapter_id": 4877, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2182850, "chapter_id": 4877, "verse_number": "२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nगीतं दृष्टार्थतत्त्वेन वामदेवेन धीमता\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2182851, "chapter_id": 4877, "verse_number": "३", "content_sanskrit": "राजा वसुमना नाम कौसल्यो बलवान् शुचिः ।\nमहर्षिं परिपप्रच्छ वामदेवं यशस्विनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2182852, "chapter_id": 4877, "verse_number": "४", "content_sanskrit": "धर्मार्थसहितं वाक्यं भगवन्ननुशाधि माम् ।\nयेन वृत्तेन वै तिष्ठन्न च्यवेयं स्वधर्मतः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2182853, "chapter_id": 4877, "verse_number": "५", "content_sanskrit": "तमब्रवीद् वामदेवस्तपस्वी जपतांवरः ।\nहेमवर्णं सुखासीनं ययातिमिव नाहुषम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2182854, "chapter_id": 4877, "verse_number": "६", "content_sanskrit": "धर्ममेवानुवर्तस्व न धर्माद् विद्यते परम् ।\nधर्मे स्थिता हि राजानो जयन्ति पृथिवीमिमाम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2182855, "chapter_id": 4877, "verse_number": "७", "content_sanskrit": "अर्थसिद्धेः परं धर्मं मन्यते यो महीपतिः ।\nऋतां च कुरुते बुद्धिं स धर्मेण विरोचते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2182856, "chapter_id": 4877, "verse_number": "८", "content_sanskrit": "अधर्मदर्शी यो राजा बलादेव प्रवर्तते ।\nक्षिप्रमेवापयातोऽस्मादुभौ प्रथममध्यमौ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2182857, "chapter_id": 4877, "verse_number": "९", "content_sanskrit": "असत्पापिष्ठसचिवो वध्यो लोकस्य धर्महा ।\nसहैव परिवारेण क्षिप्रमेवावसीदति\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2182858, "chapter_id": 4877, "verse_number": "१०", "content_sanskrit": "अर्थानामननुष्ठाता कामचारी विकत्थनः ।\nअपि सर्वां महीं लब्ध्वा क्षिप्रमेव विनश्यति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2182859, "chapter_id": 4877, "verse_number": "११", "content_sanskrit": "अथाददानः कल्याणमनसूयुर्जितेन्द्रियः ।\nवर्धते मतिमान् राजा स्रोतोभिरिव सागरः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2182860, "chapter_id": 4877, "verse_number": "१२", "content_sanskrit": "न पूर्णोऽस्मीति मन्येत धर्मतः कामतोऽर्थतः ।\nबुद्धितो मित्रतश्चापि सततं वसुधाधिपः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2182861, "chapter_id": 4877, "verse_number": "१३", "content_sanskrit": "एतेष्वेव हि सर्वेषु लोकयात्रा प्रतिष्ठिता ।\nएतानि शृण्वँल्लभते यशः कीर्तिं श्रियः प्रजाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2182862, "chapter_id": 4877, "verse_number": "१४", "content_sanskrit": "एवं यो धर्मसंरम्भी धर्मार्थपरिचिन्तकः ।\nअर्थान् समीक्ष्यारभते स ध्रुवं महदश्नुते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2182863, "chapter_id": 4877, "verse_number": "१५", "content_sanskrit": "अदाता ह्यनतिस्नेहो दण्डेनावर्तयन् प्रजाः ।\nसाहसप्रकृती राजा क्षिप्रमेव विनश्यति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2182864, "chapter_id": 4877, "verse_number": "१६", "content_sanskrit": "अथ पापं कृतं बुद्ध्या नच पश्यत्यबुद्धिमान् ।\nअकीर्त्यापि समायुक्तो मृतो नरकमश्नुते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2182865, "chapter_id": 4877, "verse_number": "१७", "content_sanskrit": "अथ मानयितुर्दातुः शुक्लस्य रसवेदिनः ।\nव्यसनं स्वमिवोत्पन्नं विजिघांसन्ति मानवाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2182866, "chapter_id": 4877, "verse_number": "१८", "content_sanskrit": "यस्य नास्ति गुरुर्धर्मे नचान्याननुपृच्छति ।\nसुखतन्त्रोऽर्थलाभेषु न चिरं महदश्नुते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2182867, "chapter_id": 4877, "verse_number": "१९", "content_sanskrit": "गुरुप्रधानो धर्मेषु स्वयमर्थान्ववेक्षिता ।\nधर्मप्रधानो लोकेषु सुचिरं महदश्नुते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2182868, "chapter_id": 4877, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे चतुर्नवतितमोऽध्यायः ॥ ९४ ॥\n–––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]