[{"id": 2054850, "chapter_id": 2201, "verse_number": "७-१२८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2054851, "chapter_id": 2201, "verse_number": "७-१२८-१", "content_sanskrit": "समुत्तीर्णं रथानीकं पाण्डवं विहसन्रणे।\nविवारयिषुराचार्यः शरवर्षैरवाकिरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2054852, "chapter_id": 2201, "verse_number": "७-१२८-२", "content_sanskrit": "पिबन्निव शरौघांस्तान्द्रोणचापपरिच्युतान्।\nसोऽभ्यद्रवत सोदर्यान्मोहयन्बलमायया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2054853, "chapter_id": 2201, "verse_number": "७-१२८-३", "content_sanskrit": "तं मृधे वेगमास्थाय परं परमधन्विनः।\nचोदितास्तव पुत्रैश्च सर्वतः पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2054854, "chapter_id": 2201, "verse_number": "७-१२८-४", "content_sanskrit": "स तैस्तु संवृतो भीमः क्रोधेन प्रदहन्निव।\nउद्यच्छन्स गदां तेभ्यः सुघोरां सिंहवन्नदन्।\nअवासृजच्च वेगेन शत्रुपक्षविनाशिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2054855, "chapter_id": 2201, "verse_number": "७-१२८-५", "content_sanskrit": "इन्द्राशनिरिवेन्द्रेण प्रविद्धा संहतात्मना।\nप्रामथ्नात्सा महाराज सैनिकांस्तव संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2054856, "chapter_id": 2201, "verse_number": "७-१२८-६", "content_sanskrit": "घोषेण महता राजन्पूरयन्तीव मेदिनीम्।\nज्वलन्ती तेजसा भीमा त्रासयामास ते सुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2054857, "chapter_id": 2201, "verse_number": "७-१२८-७", "content_sanskrit": "तां पतन्तीं महावेगां दृष्ट्वा तेजोभिसंवृताम्।\nप्राद्रवंस्तावकाः सर्वे नदन्तो बैरवान्रवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2054858, "chapter_id": 2201, "verse_number": "७-१२८-८", "content_sanskrit": "सिंहनादमसह्यं हि श्रुत्वा भीमस्य संयुगे।\nप्रापतन्मुनुजास्त्रस्ता रथेभ्यो रथिनस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2054859, "chapter_id": 2201, "verse_number": "७-१२८-९", "content_sanskrit": "ते हन्यमाना भीमेन गदाहस्तेन तावकाः।\nप्राद्रवन्त रणे भीता व्याघ्रघ्राता मृगा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2054860, "chapter_id": 2201, "verse_number": "७-१२८-१०", "content_sanskrit": "स तान्विद्राव्य कौन्तेयः सङ्ख्येऽमित्रान्दुरासदान्।\nसुपर्ण इव वेगेन पक्षिराडत्यगाच्चमूम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2054861, "chapter_id": 2201, "verse_number": "७-१२८-११", "content_sanskrit": "तथा तु विप्रकुर्वाणं रथयूथपयूथपम्।\nभारद्वाजो महाराज भीमसेनं समभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2054862, "chapter_id": 2201, "verse_number": "७-१२८-१२", "content_sanskrit": "भीमं तु समरे द्रोणो वारयित्वा शरोर्मिभिः।\nअकरोत्सहसा नादं षाण्डूनां भयमादधत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2054863, "chapter_id": 2201, "verse_number": "७-१२८-१३", "content_sanskrit": "तद्युद्धमासीत्सुमहद्धोरं देवासुरोपमम्।\nद्रोणस्य च महाराज भीमस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2054864, "chapter_id": 2201, "verse_number": "७-१२८-१४", "content_sanskrit": "यदा तु विशिखैस्तीक्ष्णैर्द्रोणचापविनिःसृतैः।\nवध्यन्ते समरे वीराः शतशोऽथ सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2054865, "chapter_id": 2201, "verse_number": "७-१२८-१५", "content_sanskrit": "ततो रथादवप्लुत्य वेगमास्थाय पाण्डवः।\nनिमील्य नयने राजन्पदातिर्द्रोणमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2054866, "chapter_id": 2201, "verse_number": "७-१२८-१६", "content_sanskrit": "अंसे शिरो भीमसेनः करौ कृत्वोरसि स्थिरौ।\nवेगमास्थाय बलवान्मनोनिलगरुत्मताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2054867, "chapter_id": 2201, "verse_number": "७-१२८-१७", "content_sanskrit": "यथा हि गोवृषो वर्षं प्रतिगृह्णाति लीलया।\nतथा भीमो नरव्याघ्रः शरवर्षं समग्रहीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2054868, "chapter_id": 2201, "verse_number": "७-१२८-१८", "content_sanskrit": "स वध्यमानः समरे रथं द्रोणस्य मारिष।\nईषायां पाणिना गृह्य प्रचिक्षेप महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2054869, "chapter_id": 2201, "verse_number": "७-१२८-१९", "content_sanskrit": "द्रोणस्तु सत्वरो राजन्क्षिप्तो भीमेन संयुगे।\n`ददृशे तावकैर्योधैर्विस्मयोत्फुल्ललोचनैः।\nपरिहृत्य रथं द्रोणश्चूर्णितं तं महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2054870, "chapter_id": 2201, "verse_number": "७-१२८-२०", "content_sanskrit": "रथमन्यं समारुह्य व्यूहद्वारं ययौ पुनः।\nतमायान्तं तथा दृष्ट्वा भग्नोत्साहं गुरुं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2054871, "chapter_id": 2201, "verse_number": "७-१२८-२१", "content_sanskrit": "गत्वा वेगात्पुनर्भीमो धुरं गृह्य रथस्य तु।\nतमप्यतिरथं भीमश्चिक्षेप भृशरोषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2054872, "chapter_id": 2201, "verse_number": "७-१२८-२२", "content_sanskrit": "एवमष्टौ रथाः क्षिप्ता भीमसेनेन लीलया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2054873, "chapter_id": 2201, "verse_number": "७-१२८-२३", "content_sanskrit": "व्यदृश्यत निमेषेण पुनः स्वरथमास्थितः।\nदृश्यते तावकैर्योधैर्विस्मयोत्फुल्ललोचनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2054874, "chapter_id": 2201, "verse_number": "७-१२८-२४", "content_sanskrit": "तस्मिन्क्षणे तस्य यन्ता तूर्णमश्वानचोदयत्।\nभीमसेनस्य कौरव्य तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2054875, "chapter_id": 2201, "verse_number": "७-१२८-२५", "content_sanskrit": "ततः स्वरथमास्थाय भीमसेनो महाबलः।\nअभ्यद्रवत वेगेन तव पुत्रस्य वाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2054876, "chapter_id": 2201, "verse_number": "७-१२८-२६", "content_sanskrit": "स मृद्गन्क्षत्रियानाजौ वातो वृक्षानिवोद्धतः।\nअगच्छद्दारयन्सेनां सिन्धुवेगो नगानिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2054877, "chapter_id": 2201, "verse_number": "७-१२८-२७", "content_sanskrit": "भोजानीकं समासाद्य हार्दिक्येनाभिरक्षितम्।\nप्रमथ्य तरसा वीरस्तदप्यतिबलोऽभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2054878, "chapter_id": 2201, "verse_number": "७-१२८-२८", "content_sanskrit": "सन्त्रासयन्ननीकानि तलशब्देन पाण्डवः।\nअजयत्सर्वसैन्यानि शार्दूल इव गोवृषान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2054879, "chapter_id": 2201, "verse_number": "७-१२८-२९", "content_sanskrit": "भोजानीकमतिक्रम्य दरदानां च वाहिनीम्।\nतथा म्लेच्छगणानन्यान्बहून्युद्धविशारदान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2054880, "chapter_id": 2201, "verse_number": "७-१२८-३०", "content_sanskrit": "सात्यकिं चैव सम्प्रेक्ष्य युध्यमानं महारथम्।\nरथेन यत्तः कौन्तेयो वेगेन प्रययौ तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2054881, "chapter_id": 2201, "verse_number": "७-१२८-३१", "content_sanskrit": "भीमसेनो महाराज द्रष्टुकामो धनञ्जयम्।\nअतीत्य समरे योधांस्तावकान्पाण्डुनन्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2054882, "chapter_id": 2201, "verse_number": "७-१२८-३२", "content_sanskrit": "सोऽपश्यदर्जुनं तत्र युध्यमानं महारथम्।\nसैन्धवस्य वधार्थं हि पराक्रान्तं पराक्रमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2054883, "chapter_id": 2201, "verse_number": "७-१२८-३३", "content_sanskrit": "तं दृष्ट्वा पुरुषव्याघ्रश्चुक्रोश महतो रवान्।\nप्रावृट्काले महाराज नर्दन्निव बलाहकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2054884, "chapter_id": 2201, "verse_number": "७-१२८-३४", "content_sanskrit": "तं तस्य निनदं घोरं पार्थः शुश्राव नर्दतः।\nवासुदेवश्च कौरव्य भीमसेनस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2054885, "chapter_id": 2201, "verse_number": "७-१२८-३५", "content_sanskrit": "तौ श्रुत्वा युगपद्वीरौ निनदं तस्य शुष्मिणः।\nपुनः पुनः प्राणदतां दिदृक्षन्तौ वृकोदरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2054886, "chapter_id": 2201, "verse_number": "७-१२८-३६", "content_sanskrit": "ततः पार्थो महानादं मुञ्चन्वै माधवश्च ह।\nअभ्ययातां महाराज नर्दन्तौ गोवृषाविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2054887, "chapter_id": 2201, "verse_number": "७-१२८-३७", "content_sanskrit": "भीमसेनरवं श्रुत्वा फल्गुनस्य च धन्विनः।\nअप्रीयत महाराज धर्मपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2054888, "chapter_id": 2201, "verse_number": "७-१२८-३८", "content_sanskrit": "विशोकश्चाभवद्राजा श्रुत्वा तं निनदं तयोः।\nधनञ्जयस्य समरे जयमाशास्तवान्विभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2054889, "chapter_id": 2201, "verse_number": "७-१२८-३९", "content_sanskrit": "तथा तु नर्दमाने वै भीमसेने मदोत्कटे।\nस्मितं कृत्वा महाबाहुर्धर्मपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2054890, "chapter_id": 2201, "verse_number": "७-१२८-४०", "content_sanskrit": "हृद्गतं मनसा प्राह ध्यात्वा धर्मभृतां वरः।\nदत्ता भीम त्वया संवित्कृतं गुरुवचस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2054891, "chapter_id": 2201, "verse_number": "७-१२८-४१", "content_sanskrit": "न हि तेषां जयो युद्धे येषां द्वेष्टाऽसि पाण्डव।\nदिष्ट्या जीवति सङ्ग्रमे सव्यसाची धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2054892, "chapter_id": 2201, "verse_number": "७-१२८-४२", "content_sanskrit": "दिष्ट्या च कुशली वीरः सात्यकिः सत्यविक्रमः।\nदिष्ट्या शृणोमि गर्जन्तौ वासुदेवधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2054893, "chapter_id": 2201, "verse_number": "७-१२८-४३", "content_sanskrit": "येन शक्रं रणे जित्वा तर्पितो हव्यवाहनः।\nस हन्ता द्विषतां सङ्ख्ये दिष्ट्या जीवति फल्गुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2054894, "chapter_id": 2201, "verse_number": "७-१२८-४४", "content_sanskrit": "यस्य बाहुबलं सर्वे वयमाश्रित्य जीविताः।\nस हन्ता रि पुसैन्यानां दिष्ट्या जीवति फल्गुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2054895, "chapter_id": 2201, "verse_number": "७-१२८-४५", "content_sanskrit": "निवातकवचा येन देवैरपि सुदुर्जयाः।\nनिर्जिता धनुषैकेन दिष्ट्या पार्थः स जीवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2054896, "chapter_id": 2201, "verse_number": "७-१२८-४६", "content_sanskrit": "कौरवान्सहितान्सर्वान्गोग्रहार्थे समागतान्।\nयोऽजयन्मत्स्यनगरे दिष्ट्या पार्थः स जीवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2054897, "chapter_id": 2201, "verse_number": "७-१२८-४७", "content_sanskrit": "कालकेयसहस्राणि चतुर्दश महारणे।\nयोऽवधीद्भुजवीर्येण दिष्ट्या पार्थः स जीवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2054898, "chapter_id": 2201, "verse_number": "७-१२८-४८", "content_sanskrit": "गन्धर्वराजं बलिनं दुर्योधनकृते च वै।\nजितवान्योऽस्त्रवीर्येण दिष्ट्या पार्थः स जीवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2054899, "chapter_id": 2201, "verse_number": "७-१२८-४९", "content_sanskrit": "किरीटमाली बलवाञ्छेताश्वः कृष्णसारथिः।\nमम प्रियश्च सततं दिष्ट्या पार्थः स जीवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2054900, "chapter_id": 2201, "verse_number": "७-१२८-५०", "content_sanskrit": "पुत्रशोकाभिसन्तप्तश्चिकीर्षन्कर्म दुष्करम्।\nजयद्रथवधान्वेषी प्रतिज्ञां कृतवान्हि यः।\nकच्चित्स सैन्धवं सङ्ख्ये हनिष्यति धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2054901, "chapter_id": 2201, "verse_number": "७-१२८-५१", "content_sanskrit": "कच्चित्तीर्णप्रतिज्ञं हि वासुदेवेन रक्षितम्।\nअनस्तमित आदित्ये समेष्याम्यहमर्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2054902, "chapter_id": 2201, "verse_number": "७-१२८-५२", "content_sanskrit": "कच्चित्सैन्धवको राजा दुर्योधनहिते रतः।\nनन्दयिष्यत्यमित्रान्हि फल्गुनेन निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2054903, "chapter_id": 2201, "verse_number": "७-१२८-५३", "content_sanskrit": "कच्चिद्दुर्योधनो राजा फल्गुनेन निपातितम्।\nदृष्ट्वा सैन्धवकं सङ्ख्ये शममस्मासु धास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2054904, "chapter_id": 2201, "verse_number": "७-१२८-५४", "content_sanskrit": "दृष्ट्वा विनिहतान्भ्रातॄन्भीमसेनेन संयुगे।\nकच्चिद्दुर्योधनो मन्दः शममस्मासु यास्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2054905, "chapter_id": 2201, "verse_number": "७-१२८-५५", "content_sanskrit": "दृष्ट्वा चान्यान्महायोधान्पातितान्धरणीतले।\nकच्चिद्दुर्योधनो मन्दः पश्चात्तापं गमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2054906, "chapter_id": 2201, "verse_number": "७-१२८-५६", "content_sanskrit": "शेषस्य रक्षणार्थं च सन्धास्यति सुयोधनः॥\nएवं बहुविधं तस्य राज्ञश्चिन्तयतस्तदा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2054907, "chapter_id": 2201, "verse_number": "७-१२८-५७", "content_sanskrit": "कृपयाऽभिपरीतस्य घोरं युद्धमवर्तत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2054908, "chapter_id": 2201, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे अष्टाविंशत्यधिकशततमोऽध्यायः॥ १२८ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१२८-२४ भीमसेनस्य कमेन्ति शेषः॥ ५-१२८-१२८ अष्टाविंशत्यधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]