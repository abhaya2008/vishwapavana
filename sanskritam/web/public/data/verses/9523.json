[{"id": 5000523000, "chapter_id": 9523, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे षोडशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000523001, "chapter_id": 9523, "verse_number": "६-११६-१", "content_sanskrit": "एवमुक्ता तु वैदेही परुषं रोमहर्षणम्।\nराघवेण सरोषेण श्रुत्वा प्रव्यथिताभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000523002, "chapter_id": 9523, "verse_number": "६-११६-२", "content_sanskrit": "सा तदाश्रुतपूर्वं हि जने महति मैथिली।\nश्रुत्वा भर्तुर्वचो घोरं लज्जयावनताभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000523003, "chapter_id": 9523, "verse_number": "६-११६-३", "content_sanskrit": "प्रविशन्तीव गात्राणि स्वानि सा जनकात्मजा।\nवाक्शरैस्तैः सशल्येव भृशमश्रूण्यवर्तयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000523004, "chapter_id": 9523, "verse_number": "६-११६-४", "content_sanskrit": "ततो बाष्पपरिक्लिन्नं प्रमार्जन्ती स्वमाननम्।\nशनैर्गद‍्गदया वाचा भर्तारमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000523005, "chapter_id": 9523, "verse_number": "६-११६-५", "content_sanskrit": "किं मामसदृशं वाक्यमीदृशं श्रोत्रदारुणम्।\nरूक्षं श्रावयसे वीर प्राकृतः प्राकृतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000523006, "chapter_id": 9523, "verse_number": "६-११६-६", "content_sanskrit": "न तथास्मि महाबाहो यथा मामवगच्छसि।\nप्रत्ययं गच्छ मे स्वेन चारित्रेणैव ते शपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000523007, "chapter_id": 9523, "verse_number": "६-११६-७", "content_sanskrit": "पृथक्स्त्रीणां प्रचारेण जातिं त्वं परिशङ्कसे।\nपरित्यजैनां शङ्कां तु यदि तेऽहं परीक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000523008, "chapter_id": 9523, "verse_number": "६-११६-८", "content_sanskrit": "यदहं गात्रसंस्पर्शं गतास्मि विवशा प्रभो।\nकामकारो न मे तत्र दैवं तत्रापराध्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000523009, "chapter_id": 9523, "verse_number": "६-११६-९", "content_sanskrit": "मदधीनं तु यत् तन्मे हृदयं त्वयि वर्तते।\nपराधीनेषु गात्रेषु किं करिष्याम्यनीश्वरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000523010, "chapter_id": 9523, "verse_number": "६-११६-१०", "content_sanskrit": "सह संवृद्धभावेन संसर्गेण च मानद।\nयदि तेऽहं न विज्ञाता हता तेनास्मि शाश्वतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000523011, "chapter_id": 9523, "verse_number": "६-११६-११", "content_sanskrit": "प्रेषितस्ते महावीरो हनुमानवलोककः।\nलङ्कास्थाहं त्वया राजन् किं तदा न विसर्जिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000523012, "chapter_id": 9523, "verse_number": "६-११६-१२", "content_sanskrit": "प्रत्यक्षं वानरस्यास्य तद्वाक्यसमनन्तरम्।\nत्वया संत्यक्तया वीर त्यक्तं स्याज्जीवितं मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000523013, "chapter_id": 9523, "verse_number": "६-११६-१३", "content_sanskrit": "न वृथा ते श्रमोऽयं स्यात् संशये न्यस्य जीवितम्।\nसुहृज्जनपरिक्लेशो न चायं विफलस्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000523014, "chapter_id": 9523, "verse_number": "६-११६-१४", "content_sanskrit": "त्वया तु नृपशार्दूल रोषमेवानुवर्तता।\nलघुनेव मनुष्येण स्त्रीत्वमेव पुरस्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000523015, "chapter_id": 9523, "verse_number": "६-११६-१५", "content_sanskrit": "अपदेशेन जनकान्नोत्पत्तिर्वसुधातलात्।\nमम वृत्तं च वृत्तज्ञ बहु ते न पुरस्कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000523016, "chapter_id": 9523, "verse_number": "६-११६-१६", "content_sanskrit": "न प्रमाणीकृतः पाणिर्बाल्ये मम निपीडितः।\nमम भक्तिश्च शीलं च सर्वं ते पृष्ठतः कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000523017, "chapter_id": 9523, "verse_number": "६-११६-१७", "content_sanskrit": "इति ब्रुवन्ती रुदती बाष्पगद‍्गदभाषिणी।\nउवाच लक्ष्मणं सीता दीनं ध्यानपरायणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000523018, "chapter_id": 9523, "verse_number": "६-११६-१८", "content_sanskrit": "चितां मे कुरु सौमित्रे व्यसनस्यास्य भेषजम्।\nमिथ्यापवादोपहता नाहं जीवितुमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000523019, "chapter_id": 9523, "verse_number": "६-११६-१९", "content_sanskrit": "अप्रीतेन गुणैर्भर्त्रा त्यक्ताया जनसंसदि।\nया क्षमा मे गतिर्गन्तुं प्रवेक्ष्ये हव्यवाहनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000523020, "chapter_id": 9523, "verse_number": "६-११६-२०", "content_sanskrit": "एवमुक्तस्तु वैदेह्या लक्ष्मणः परवीरहा।\nअमर्षवशमापन्नो राघवं समुदैक्षत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000523021, "chapter_id": 9523, "verse_number": "६-११६-२१", "content_sanskrit": "स विज्ञाय मनश्छन्दं रामस्याकारसूचितम्।\nचितां चकार सौमित्रिर्मते रामस्य वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000523022, "chapter_id": 9523, "verse_number": "६-११६-२२", "content_sanskrit": "नहि रामं तदा कश्चित् कालान्तकयमोपमम्।\nअनुनेतुमथो वक्तुं द्रष्टुं वाप्यशकत् सुहृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000523023, "chapter_id": 9523, "verse_number": "६-११६-२३", "content_sanskrit": "अधोमुखं स्थितं रामं ततः कृत्वा प्रदक्षिणम्।\nउपावर्तत वैदेही दीप्यमानं हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000523024, "chapter_id": 9523, "verse_number": "६-११६-२४", "content_sanskrit": "प्रणम्य दैवतेभ्यश्च ब्राह्मणेभ्यश्च मैथिली।\nबद्धाञ्जलिपुटा चेदमुवाचाग्निसमीपतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000523025, "chapter_id": 9523, "verse_number": "६-११६-२५", "content_sanskrit": "यथा मे हृदयं नित्यं नापसर्पति राघवात्।\nतथा लोकस्य साक्षी मां सर्वतः पातु पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000523026, "chapter_id": 9523, "verse_number": "६-११६-२६", "content_sanskrit": "यथा मां शुद्धचारित्रां दुष्टां जानाति राघवः।\nतथा लोकस्य साक्षी मां सर्वतः पातु पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000523027, "chapter_id": 9523, "verse_number": "६-११६-२७", "content_sanskrit": "कर्मणा मनसा वाचा यथा नातिचराम्यहम्।\nराघवं सर्वधर्मज्ञं तथा मां पातु पावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000523028, "chapter_id": 9523, "verse_number": "६-११६-२८", "content_sanskrit": "आदित्यो भगवान् वायुर्दिशश्चन्द्रस्तथैव च।\nअहश्चापि तथा संध्ये रात्रिश्च पृथिवी तथा।\nयथान्येऽपि विजानन्ति तथा चारित्रसंयुताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000523029, "chapter_id": 9523, "verse_number": "६-११६-२९", "content_sanskrit": "एवमुक्त्वा तु वैदेही परिक्रम्य हुताशनम्।\nविवेश ज्वलनं दीप्तं निःशङ्केनान्तरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000523030, "chapter_id": 9523, "verse_number": "६-११६-३०", "content_sanskrit": "जनश्च सुमहांस्तत्र बालवृद्धसमाकुलः।\nददर्श मैथिलीं दीप्तां प्रविशन्तीं हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000523031, "chapter_id": 9523, "verse_number": "६-११६-३१", "content_sanskrit": "सा तप्तनवहेमाभा तप्तकाञ्चनभूषणा।\nपपात ज्वलनं दीप्तं सर्वलोकस्य संनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000523032, "chapter_id": 9523, "verse_number": "६-११६-३२", "content_sanskrit": "ददृशुस्तां विशालाक्षीं पतन्तीं हव्यवाहनम्।\nसीतां सर्वाणि रूपाणि रुक्मवेदिनिभां तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000523033, "chapter_id": 9523, "verse_number": "६-११६-३३", "content_sanskrit": "ददृशुस्तां महाभागां प्रविशन्तीं हुताशनम्।\nऋषयो देवगन्धर्वा यज्ञे पूर्णाहुतीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000523034, "chapter_id": 9523, "verse_number": "६-११६-३४", "content_sanskrit": "प्रचुक्रुशुः स्त्रियः सर्वास्तां दृष्ट्वा हव्यवाहने।\nपतन्तीं संस्कृतां मन्त्रैर्वसोर्धारामिवाध्वरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000523035, "chapter_id": 9523, "verse_number": "६-११६-३५", "content_sanskrit": "ददृशुस्तां त्रयो लोका देवगन्धर्वदानवाः।\nशप्तां पतन्तीं निरये त्रिदिवाद् देवतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000523036, "chapter_id": 9523, "verse_number": "६-११६-३६", "content_sanskrit": "तस्यामग्निं विशन्त्यां तु हाहेति विपुलः स्वनः।\nरक्षसां वानराणां च सम्बभूवाद्भुतोपमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000523037, "chapter_id": 9523, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे षोडशाधिकशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]