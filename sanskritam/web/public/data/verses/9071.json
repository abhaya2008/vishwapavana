[{"id": 5000071000, "chapter_id": 9071, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे एकसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000071001, "chapter_id": 9071, "verse_number": "१-७१-१", "content_sanskrit": "एवं ब्रुवाणं जनकः प्रत्युवाच कृताञ्जलिः।\nश्रोतुमर्हसि भद्रं ते कुलं नः परिकीर्तितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000071002, "chapter_id": 9071, "verse_number": "१-७१-२", "content_sanskrit": "प्रदाने हि मुनिश्रेष्ठ कुलं निरवशेषतः।\nवक्तव्यं कुलजातेन तन्निबोध महामते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000071003, "chapter_id": 9071, "verse_number": "१-७१-३", "content_sanskrit": "राजाभूत् त्रिषु लोकेषु विश्रुतः स्वेन कर्मणा।\nनिमिः परमधर्मात्मा सर्वसत्त्ववतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000071004, "chapter_id": 9071, "verse_number": "१-७१-४", "content_sanskrit": "तस्य पुत्रो मिथिर्नाम जनको मिथिपुत्रकः।\nप्रथमो जनको राजा जनकादप्युदावसुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000071005, "chapter_id": 9071, "verse_number": "१-७१-५", "content_sanskrit": "उदावसोस्तु धर्मात्मा जातो वै नन्दिवर्धनः।\nनन्दिवर्धसुतः शूरः सुकेतुर्नाम नामतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000071006, "chapter_id": 9071, "verse_number": "१-७१-६", "content_sanskrit": "सुकेतोरपि धर्मात्मा देवरातो महाबलः।\nदेवरातस्य राजर्षेर्बृहद्रथ इति स्मृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000071007, "chapter_id": 9071, "verse_number": "१-७१-७", "content_sanskrit": "बृहद्रथस्य शूरोऽभून्महावीरः प्रतापवान्।\nमहावीरस्य धृतिमान् सुधृतिः सत्यविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000071008, "chapter_id": 9071, "verse_number": "१-७१-८", "content_sanskrit": "सुधृतेरपि धर्मात्मा धृष्टकेतुः सुधार्मिकः।\nधृष्टकेतोश्च राजर्षेर्हर्यश्व इति विश्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000071009, "chapter_id": 9071, "verse_number": "१-७१-९", "content_sanskrit": "हर्यश्वस्य मरुः पुत्रो मरोः पुत्रः प्रतीन्धकः।\nप्रतीन्धकस्य धर्मात्मा राजा कीर्तिरथः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000071010, "chapter_id": 9071, "verse_number": "१-७१-१०", "content_sanskrit": "पुत्रः कीर्तिरथस्यापि देवमीढ इति स्मृतः।\nदेवमीढस्य विबुधो विबुधस्य महीध्रकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000071011, "chapter_id": 9071, "verse_number": "१-७१-११", "content_sanskrit": "महीध्रकसुतो राजा कीर्तिरातो महाबलः।\nकीर्तिरातस्य राजर्षेर्महारोमा व्यजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000071012, "chapter_id": 9071, "verse_number": "१-७१-१२", "content_sanskrit": "महारोम्णस्तु धर्मात्मा स्वर्णरोमा व्यजायत।\nस्वर्णरोम्णस्तु राजर्षेर्ह्रस्वरोमा व्यजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000071013, "chapter_id": 9071, "verse_number": "१-७१-१३", "content_sanskrit": "तस्य पुत्रद्वयं राज्ञो धर्मज्ञस्य महात्मनः।\nज्येष्ठोऽहमनुजो भ्राता मम वीरः कुशध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000071014, "chapter_id": 9071, "verse_number": "१-७१-१४", "content_sanskrit": "मां तु ज्येष्ठं पिता राज्ये सोऽभिषिच्य पिता मम।\nकुशध्वजं समावेश्य भारं मयि वनं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000071015, "chapter_id": 9071, "verse_number": "१-७१-१५", "content_sanskrit": "वृद्धे पितरि स्वर्याते धर्मेण धुरमावहम्।\nभ्रातरं देवसंकाशं स्नेहात् पश्यन् कुशध्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000071016, "chapter_id": 9071, "verse_number": "१-७१-१६", "content_sanskrit": "कस्यचित्त्वथ कालस्य सांकाश्यादागतः पुरात्।\nसुधन्वा वीर्यवान् राजा मिथिलामवरोधकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000071017, "chapter_id": 9071, "verse_number": "१-७१-१७", "content_sanskrit": "स च मे प्रेषयामास शैवं धनुरनुत्तमम्।\nसीता च कन्या पद्माक्षी मह्यं वै दीयतामिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000071018, "chapter_id": 9071, "verse_number": "१-७१-१८", "content_sanskrit": "तस्याप्रदानान्महर्षे युद्धमासीन्मया सह।\nस हतोऽभिमुखो राजा सुधन्वा तु मया रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000071019, "chapter_id": 9071, "verse_number": "१-७१-१९", "content_sanskrit": "निहत्य तं मुनिश्रेष्ठ सुधन्वानं नराधिपम्।\nसांकाश्ये भ्रातरं शूरमभ्यषिञ्चं कुशध्वजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000071020, "chapter_id": 9071, "verse_number": "१-७१-२०", "content_sanskrit": "कनीयानेष मे भ्राता अहं ज्येष्ठो महामुने।\nददामि परमप्रीतो वध्वौ ते मुनिपुंगव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000071021, "chapter_id": 9071, "verse_number": "१-७१-२१", "content_sanskrit": "सीतां रामाय भद्रं ते ऊर्मिलां लक्ष्मणाय वै।\nवीर्यशुल्कां मम सुतां सीतां सुरसुतोपमाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000071022, "chapter_id": 9071, "verse_number": "१-७१-२२", "content_sanskrit": "द्वितीयामूर्मिलां चैव त्रिर्वदामि न संशयः।\nददामि परमप्रीतो वध्वौ ते मुनिपुंगव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000071023, "chapter_id": 9071, "verse_number": "१-७१-२३", "content_sanskrit": "रामलक्ष्मणयो राजन् गोदानं कारयस्व ह।\nपितृकार्यं च भद्रं ते ततो वैवाहिकं कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000071024, "chapter_id": 9071, "verse_number": "१-७१-२४", "content_sanskrit": "मघा ह्यद्य महाबाहो तृतीयदिवसे प्रभो।\nफल्गुन्यामुत्तरे राजंस्तस्मिन् वैवाहिकं कुरु।\nरामलक्ष्मणयोरर्थे दानं कार्यं सुखोदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000071025, "chapter_id": 9071, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे एकसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]