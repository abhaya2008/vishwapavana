[{"id": 33000357, "chapter_id": 7897, "verse_number": "1", "content_sanskrit": "वयते वयति व्यूतावूयतेऽथ विषीव्यति । स्यूतौ निषीव्यति तथा परिषीव्यति सीव्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "avatarnika": ""}, {"id": 33000358, "chapter_id": 7897, "verse_number": "2", "content_sanskrit": "तक्ष्णोति तक्षति तनयति त्वक्षति तक्षणे । तनूकरोत्यात्मनेऽपि परिवासयतीति षट्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2, "avatarnika": ""}, {"id": 33000359, "chapter_id": 7897, "verse_number": "3", "content_sanskrit": "उत्तेजयति तीक्ष्णत्वे सङ्क्ष्णुते क्ष्णौति निश्यति । निशिनोति निशीशांसत्यात्मनेऽपि मतं द्वयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3, "avatarnika": ""}, {"id": 33000360, "chapter_id": 7897, "verse_number": "4", "content_sanskrit": "लुनाति लुम्पति तथा च्छिनत्तीत्यात्मने त्रयम्‌ । त्रुटति च्छोटयति च चुटति च्छुटतीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4, "avatarnika": ""}, {"id": 33000361, "chapter_id": 7897, "verse_number": "5", "content_sanskrit": "छेदने वर्धयति च च्छ्यति वृश्चति कृन्तति । चतुर्दश त्रोटयति द्यति च्छेदयतीत्यमी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5, "avatarnika": ""}, {"id": 33000362, "chapter_id": 7897, "verse_number": "6", "content_sanskrit": "त्रोटति त्रुट्यति च्छेदे च्छिद्यते कर्मकर्तृके । भिन्ते विदारयति च भिनत्ति द्यति मुण्डति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6, "avatarnika": ""}, {"id": 33000363, "chapter_id": 7897, "verse_number": "7", "content_sanskrit": "बिलति स्फोटयति च दृणात्याखण्डयत्यपि । मुस्यति च्छिद्रयति च दारयत्यपि भेदने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7, "avatarnika": ""}, {"id": 33000364, "chapter_id": 7897, "verse_number": "8", "content_sanskrit": "दहति श्रेषति श्लेषत्यपि प्रोषति चूर्यते । तापयत्योषति तपत्यपि प्लुष्यति कुण्डते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8, "avatarnika": ""}, {"id": 33000365, "chapter_id": 7897, "verse_number": "9", "content_sanskrit": "दाहे कूटयति प्लोषत्यमी तत्र तु गर्हिते । दन्दह्यते दन्दहीति दन्दग्धीति पदत्रयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9, "avatarnika": ""}, {"id": 33000366, "chapter_id": 7897, "verse_number": "10", "content_sanskrit": "ग्रोचति स्तेनयति च चुरण्यति च रुण्टति । स्तेये चोरयति ग्लोचयति कोजति खोजति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10, "avatarnika": ""}, {"id": 33000367, "chapter_id": 7897, "verse_number": "11", "content_sanskrit": "मुष्णाति लुण्टयति च मूषत्यपहरत्यदः। आत्मनेऽप्यास्कन्दतीति जर्हर्तीति बलाद्धृतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11, "avatarnika": ""}, {"id": 33000368, "chapter_id": 7897, "verse_number": "12", "content_sanskrit": "प्रसहत्यात्मनेऽप्येष हठतीति बलात्कृतौ । धूर्तक्रियायां शठति द्राघते मङ्घते त्रयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12, "avatarnika": ""}, {"id": 33000369, "chapter_id": 7897, "verse_number": "13", "content_sanskrit": "निष्कुष्णाति च निष्कर्ष निष्कर्षति च तूलति । स्यान्निष्कुलाकरोत्येतदात्मने चाऽत्र सव्यथे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13, "avatarnika": ""}, {"id": 33000370, "chapter_id": 7897, "verse_number": "14", "content_sanskrit": "डाज्‌ निष्पत्रासपत्राभ्यां करोति कुरुते पर । सन्दानयति बध्नाति मूर्वत्यन्दति कीलति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14, "avatarnika": ""}, {"id": 33000371, "chapter_id": 7897, "verse_number": "15", "content_sanskrit": "पाशयत्यन्तति जुटति सिनुते च कञ्चते। कचते टङ्कयति च योजयत्यपि मव्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15, "avatarnika": ""}, {"id": 33000372, "chapter_id": 7897, "verse_number": "16", "content_sanskrit": "काञ्चते ग्रन्थयति च सिनाति च सिनोति च। संयच्छत्यात्मने षट्‌ स्युर्नह्यत्यपि दधाति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16, "avatarnika": ""}, {"id": 33000373, "chapter_id": 7897, "verse_number": "17", "content_sanskrit": "युनातीति मवते च बन्धे मवति योजति । स्तम्भते स्कम्भते स्तम्भे वस्यत्यपि च पीलति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17, "avatarnika": ""}, {"id": 33000374, "chapter_id": 7897, "verse_number": "18", "content_sanskrit": "स्तभ्नोति प्रतिबदध्नाति स्तभ्नाति स्तम्भयत्यपि । स्कभ्नोति चैव स्कभ्नाति स्तुभ्नोति स्कम्भयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18, "avatarnika": ""}, {"id": 33000375, "chapter_id": 7897, "verse_number": "19", "content_sanskrit": "स्तुभ्नाति चैव स्कुभ्नाति स्कुभ्नोत्येतानि षोडश । साहसिक्ये प्रकुरुते दुःखयत्यघयत्यपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19, "avatarnika": ""}, {"id": 33000376, "chapter_id": 7897, "verse_number": "20", "content_sanskrit": "कष्टायते दुष्कृतेऽमी प्रत्यवैति तु दुष्यति । विघ्ने विहन्त्यन्तरेति प्रत्यूहत्यात्मनेऽप्यदः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20, "avatarnika": ""}, {"id": 33000377, "chapter_id": 7897, "verse_number": "21", "content_sanskrit": "विघ्नयत्यन्तरयति विच्छिन्ते विच्छिनत्ति च। सन्ताने सन्तनोतीति निर्वहत्यात्मने द्वयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21, "avatarnika": ""}, {"id": 33000378, "chapter_id": 7897, "verse_number": "22", "content_sanskrit": "तथा सत्रयते सन्तानयतीति चतुष्टयम्‌ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22, "avatarnika": ""}]