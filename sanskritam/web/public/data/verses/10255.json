[{"id": 6000255000, "chapter_id": 10255, "verse_number": null, "content_sanskrit": "अथ एकोनषष्टितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000255001, "chapter_id": 10255, "verse_number": "१०-५९-१", "content_sanskrit": "तं मानिनः स्वाभिभवं यशःक्षयं परे जरासन्धवशा न सेहिरे।\nअहो धिगस्मद्यश आत्तधन्विनां गोपैर्हृतं केसरिणां मृगैरिव॥ १०/५९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.001.m4a", "display_order": 2, "topics": [{"text": "जरासन्धादयः अल्पयादवसैन्येन पराभूताः", "range": "१–१०"}]}, {"id": 6000255002, "chapter_id": 10255, "verse_number": "१०-५९-२", "content_sanskrit": "इति सर्वे सुसंरब्धा वाहानारुह्य दंशिताः।\nस्वैः स्वैर्बलैः परिक्रान्ता अन्वीयुर्धृतकार्मुकाः॥ १०/५९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.002.m4a", "display_order": 3}, {"id": 6000255003, "chapter_id": 10255, "verse_number": "१०-५९-३", "content_sanskrit": "तानापतत आलोक्य यादवानीकयूथपाः।\nतस्थुर्वै सम्मुखा राजन् विस्फूर्य स्वधनूंषि ते॥ १०/५९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.003.m4a", "display_order": 4}, {"id": 6000255004, "chapter_id": 10255, "verse_number": "१०-५९-४", "content_sanskrit": "अश्वपृष्ठे गजस्कन्धे रथोपस्थे च कोविदाः।\nमुमुचुः शरवर्षाणि मेघा अद्रिष्वपो यथा॥ १०/५९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.004.m4a", "display_order": 5}, {"id": 6000255005, "chapter_id": 10255, "verse_number": "१०-५९-५", "content_sanskrit": "पत्युर्बलं शरासारैश्छन्नं वीक्ष्य सुमध्यमा।\nसव्रीडमैक्षत् तद्वक्त्रं भयविह्वललोचना॥ १०/५९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.005.m4a", "display_order": 6}, {"id": 6000255006, "chapter_id": 10255, "verse_number": "१०-५९-६", "content_sanskrit": "प्रहस्य भगवानाह मा भैस्त्वं वामलोचने।\nविनङ्क्ष्यत्यधुनैवैतत् तावकैः शात्रवं बलम्॥ १०/५९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.006.m4a", "display_order": 7}, {"id": 6000255007, "chapter_id": 10255, "verse_number": "१०-५९-७", "content_sanskrit": "तेषां तद्विक्रमं वीरा गदसङ्कर्षणादयः।\nअमृष्यमाणा नाराचैर्जघ्नुर्हयगजान् रथान्॥ १०/५९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.007.m4a", "display_order": 8}, {"id": 6000255008, "chapter_id": 10255, "verse_number": "१०-५९-८", "content_sanskrit": "पेतुः शिरांसि रथिनामश्विनां गजिनां भुवि।\nसकुण्डलकिरीटानि सोष्णीषाणि च कोटिशः॥ १०/५९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.008.m4a", "display_order": 9}, {"id": 6000255009, "chapter_id": 10255, "verse_number": "१०-५९-९", "content_sanskrit": "हस्ताः सासिगदेष्वासाः करभा ऊरवोऽङ्घ्रयः।\nअश्वाश्वतरनागोष्ट्रखरमर्त्यशिरांसि च॥ १०/५९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.009.m4a", "display_order": 10}, {"id": 6000255010, "chapter_id": 10255, "verse_number": "१०-५९-१०", "content_sanskrit": "हन्यमानबलानीका वृष्णिभिर्जयकाङ्क्षिभिः।\nराजानो विमुखा जग्मुर्जरासन्धपुरःसराः॥ १०/५९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.010.m4a", "display_order": 11}, {"id": 6000255011, "chapter_id": 10255, "verse_number": "१०-५९-११", "content_sanskrit": "शिशुपालं समेत्याथ हृतदारमिवातुरम्।\nनष्टत्विषं हतोत्साहं शुष्यद्वदनमब्रुवन्॥ १०/५९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.011.m4a", "display_order": 12, "topics": [{"text": "राजानः शुष्यद्वदनं शिशुपालमसान्त्वयन्", "range": "११–१८"}]}, {"id": 6000255012, "chapter_id": 10255, "verse_number": null, "content_sanskrit": "राजान ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.012.m4a", "display_order": 13}, {"id": 6000255013, "chapter_id": 10255, "verse_number": "१०-५९-१२", "content_sanskrit": "भो भो पुरुषशार्दूल दौर्मनस्यमिदं त्यज।\nन प्रियाप्रिययो राजन् निष्ठा देहिषु दृश्यते॥ १०/५९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.013.m4a", "display_order": 14}, {"id": 6000255014, "chapter_id": 10255, "verse_number": "१०-५९-१३", "content_sanskrit": "यथा दारुमयी योषिन्नृत्यते कुहकेच्छया।\nएवमीश्वरतन्त्रोऽयमीहते सुखदुःखयोः॥ १०/५९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.014.m4a", "display_order": 15}, {"id": 6000255015, "chapter_id": 10255, "verse_number": "१०-५९-१४", "content_sanskrit": "शौरेः सप्तदशाहं वै संयुगानि पराजितः।\nत्रयोविंशतिभिः सैन्यैर्जिग्य एकमहं परम्॥ १०/५९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.015.m4a", "display_order": 16}, {"id": 6000255016, "chapter_id": 10255, "verse_number": "१०-५९-१५", "content_sanskrit": "तथाऽप्यहं न शोचामि न हृष्यामि च कर्हिचित्।\nकालेन दैवयोगेन जानन् विद्रावितं जगत्॥ १०/५९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.016.m4a", "display_order": 17}, {"id": 6000255017, "chapter_id": 10255, "verse_number": "१०-५९-१६", "content_sanskrit": "अधुनाऽपि वयं सर्वे वीरयूथपयूथपाः।\nपराजिताः फल्गुतन्त्रैर्यदुभिः कृष्णपालितैः॥ १०/५९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.017.m4a", "display_order": 18}, {"id": 6000255018, "chapter_id": 10255, "verse_number": "१०-५९-१७", "content_sanskrit": "रिपवो जिग्युरधुना काल आत्मानुसारिणि।\nतदा वयं तु जेष्यामो यदा कालः प्रदक्षिणः॥ १०/५९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.018.m4a", "display_order": 19}, {"id": 6000255019, "chapter_id": 10255, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.019.m4a", "display_order": 20}, {"id": 6000255020, "chapter_id": 10255, "verse_number": "१०-५९-१८", "content_sanskrit": "एवं प्रबोधितो मित्रैश्चैद्योऽगात् सानुगः पुरम्।\nहतशेषा पुनस्तेऽपि ययुः स्वं स्वं पुरं नृपाः॥ १०/५९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.020.m4a", "display_order": 21}, {"id": 6000255021, "chapter_id": 10255, "verse_number": "१०-५९-१९", "content_sanskrit": "रुग्मी तु राक्षसोद्वाहं कृष्णद्विडसहन् स्वसुः।\nपृष्ठतोऽन्वगमत् कृष्णमक्षौहिण्या वृतो बली॥ १०/५९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.021.m4a", "display_order": 22}, {"id": 6000255022, "chapter_id": 10255, "verse_number": "१०-५९-२०", "content_sanskrit": "रुग्म्यमर्षी सुसंरब्धः शृृण्वतां सर्वभूभुजाम्।\nप्रतिजज्ञे महाबाहुर्दंशितः सशरासनः॥ १०/५९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.022.m4a", "display_order": 23}, {"id": 6000255023, "chapter_id": 10255, "verse_number": "१०-५९-२१", "content_sanskrit": "अहत्वा समरे कृष्णमप्रत्यूह्य च रुग्मिणीम्।\nकुण्डिनं न प्रवेक्ष्यामि सत्यमेतद् ब्रवीमि वः॥ १०/५९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.023.m4a", "display_order": 24}, {"id": 6000255024, "chapter_id": 10255, "verse_number": "१०-५९-२२", "content_sanskrit": "इत्युक्त्वा रथमारुह्य सारथिं प्राह सत्वरः।\nचोदयाश्वान् यतः कृष्णस्तस्य मे संयुगं भवेत्॥ १०/५९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.024.m4a", "display_order": 25}, {"id": 6000255025, "chapter_id": 10255, "verse_number": "१०-५९-२३", "content_sanskrit": "अद्याहं निशितैर्बाणैर्गोपालस्य सुदुर्मतेः।\nनेष्ये वीर्यमदं येन स्वसा मे प्रसभं हृता॥ १०/५९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.025.m4a", "display_order": 26}, {"id": 6000255026, "chapter_id": 10255, "verse_number": "१०-५९-२४", "content_sanskrit": "विकत्थमानः कुमतिरीश्वरस्याप्रमाणवित्।\nरथेनैकेन गोविन्दमन्वधावत रंहसा॥ १०/५९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.026.m4a", "display_order": 27, "topics": [{"text": "नर्मदातीरे रुग्मिकृष्णयोः युद्धम्", "range": "२४–३३"}]}, {"id": 6000255027, "chapter_id": 10255, "verse_number": "१०-५९-२५", "content_sanskrit": "स गत्वा नर्मदां देवीं तरन्तं मधुसूदनम्।\nआसाद्य युद्धसन्नद्धस्तिष्ठ तिष्ठेति चाब्रवीत्॥ १०/५९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.027.m4a", "display_order": 28}, {"id": 6000255028, "chapter_id": 10255, "verse_number": "१०-५९-२६", "content_sanskrit": "धनुर्विकृष्य सुदृढं जघ्ने कृष्णं त्रिभिः शरैः।\nआह चारे क्षणं तिष्ठ यदूनां कुलपांसन॥ १०/५९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.028.m4a", "display_order": 29}, {"id": 6000255029, "chapter_id": 10255, "verse_number": "१०-५९-२७", "content_sanskrit": "कुत्र यासि स्वसारं मे मुषित्वा ध्वाङ्क्षवद्धविः।\nहरिष्येऽस्य मदं मन्द मायिनः कूटयोधिनः॥ १०/५९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.029.m4a", "display_order": 30}, {"id": 6000255030, "chapter_id": 10255, "verse_number": "१०-५९-२८", "content_sanskrit": "यावन्न मे हतो बाणैः शयीथा मुञ्च दारिकाम्।\nधनुर्विकृष्य सुदृढं जघ्ने कृष्णं त्रिभिः शरैः॥ १०/५९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.030.m4a", "display_order": 31}, {"id": 6000255031, "chapter_id": 10255, "verse_number": "१०-५९-२९", "content_sanskrit": "स्मयन् कृष्णो धनुश्छित्वा षड्भिर्विव्याध रुग्मिणम्।\nअष्टाभिश्चतुरो वाहान् द्वाभ्यां सूतं ध्वजं त्रिभिः॥ १०/५९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.031.m4a", "display_order": 32}, {"id": 6000255032, "chapter_id": 10255, "verse_number": "१०-५९-३०", "content_sanskrit": "स चान्यद् धनुरादाय कृष्णं विव्याध पञ्चभिः।\nतैस्ताडितः शरौघैस्तु चिच्छेद धनुरच्युतः॥ १०/५९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.032.m4a", "display_order": 33}, {"id": 6000255033, "chapter_id": 10255, "verse_number": "१०-५९-३१", "content_sanskrit": "पुनरन्यदुपादत्त तदप्यच्छिनदच्युतः।\nपरिघं पट्टिशं शूलं चर्मासी शक्तितोमरैः॥ १०/५९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.033.m4a", "display_order": 34}, {"id": 6000255034, "chapter_id": 10255, "verse_number": "१०-५९-३२", "content_sanskrit": "यद्यदायुधमादत्त तत्सर्वं सोऽच्छिनद् विभुः।\nततो रथादवप्लुत्य गृहीत्वा खड्गचर्मणी॥ १०/५९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.034.m4a", "display_order": 35}, {"id": 6000255035, "chapter_id": 10255, "verse_number": "१०-५९-३३", "content_sanskrit": "कृष्णमभ्यद्रवत् क्रुद्धः पतङ्ग इव पावकम्।\nतस्य चापततः खड्गं तिलशश्चर्म चेषुभिः॥ १०/५९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.035.m4a", "display_order": 36}, {"id": 6000255036, "chapter_id": 10255, "verse_number": "१०-५९-३४", "content_sanskrit": "छित्त्वाऽसिमाददे तिग्मं रुग्मिणं हन्तुमुद्यतः। दृष्ट्वा भ्रातृवधोद्योगं रुग्मिणी भयविह्वला।\nपतित्वा पादयोः पत्युरुवाच करुणं सती॥ १०/५९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.036.m4a", "display_order": 37}, {"id": 6000255037, "chapter_id": 10255, "verse_number": null, "content_sanskrit": "रुग्मिण्युवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.037.m4a", "display_order": 38}, {"id": 6000255038, "chapter_id": 10255, "verse_number": "१०-५९-३५", "content_sanskrit": "योगेश्वराप्रमेयात्मन् देवदेव जगत्पते।\nहन्तुं नार्हसि कल्याण भ्रातरं मे महाभुज॥ १०/५९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.038.m4a", "display_order": 39}, {"id": 6000255039, "chapter_id": 10255, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.039.m4a", "display_order": 40}, {"id": 6000255040, "chapter_id": 10255, "verse_number": "१०-५९-३६", "content_sanskrit": "इत्युक्त्वा जगृहे पादौ कृपणा दीनभाषिणी।\nभ्रातरं त्रातुकामा सा कृष्णस्य जगतीपतेः॥ १०/५९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.040.m4a", "display_order": 41}, {"id": 6000255041, "chapter_id": 10255, "verse_number": "१०-५९-३७", "content_sanskrit": "तया परित्रासविकम्पिताङ्गया शुचाऽवशुष्यन्मुखरुद्धकण्ठया।\nकातर्यविस्रंसितहेममालया गृहीतपादः करुणो न्यवर्तत॥ १०/५९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.041.m4a", "display_order": 42}, {"id": 6000255042, "chapter_id": 10255, "verse_number": "१०-५९-३८", "content_sanskrit": "चैलेन बद्ध्‍वा तमसाधुकारिणं सश्मश्रुकेशं प्रवपन् व्यरूपयत्।\nतावत् समीयुर्जितशत्रुसैन्या यदुप्रवीरा नलिनीं यथा गजाः॥ १०/५९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.042.m4a", "display_order": 43}, {"id": 6000255043, "chapter_id": 10255, "verse_number": "१०-५९-३९", "content_sanskrit": "कृष्णान्तिकमुपव्रज्य ददृशुस्तत्र रुग्मिणम्।\nतथाभूतं हतप्रायं दृष्ट्वा सङ्कर्षणो विभुः॥ १०/५९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.043.m4a", "display_order": 44}, {"id": 6000255044, "chapter_id": 10255, "verse_number": "१०-५९-४०", "content_sanskrit": "विमुच्य बद्धं करुणो भगवान् कृष्णमब्रवीत्॥ १०/५९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.044.m4a", "display_order": 45}, {"id": 6000255045, "chapter_id": 10255, "verse_number": null, "content_sanskrit": "बलभद्र उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.045.m4a", "display_order": 46}, {"id": 6000255046, "chapter_id": 10255, "verse_number": "१०-५९-४१", "content_sanskrit": "असाध्विदं त्वया कृष्ण कृतमस्मिन् जुगुप्सितम्।\nवपनं श्मश्रुकेशानां वैरूप्यं सुहृदो वधम्॥ १०/५९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.046.m4a", "display_order": 47}, {"id": 6000255047, "chapter_id": 10255, "verse_number": "१०-५९-४२", "content_sanskrit": "मैवास्मान् साध्व्यसूयेथा भ्रातुर्वैरुप्यचिन्तया।\nसुखदुःखदो न चान्योऽस्ति यतः स्वकृतभुक् पुमान्॥ १०/५९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.047.m4a", "display_order": 48, "topics": [{"text": "बलरामेण रुग्मिणीसान्त्वनम्", "range": "४२–५०"}]}, {"id": 6000255048, "chapter_id": 10255, "verse_number": "१०-५९-४३", "content_sanskrit": "बन्धुर्वधार्हदोषोऽपि न बन्धुर्वधमर्हति।\nत्याज्यस्तेनैव दोषेण हतः किं हन्यते पुनः॥ १०/५९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.048.m4a", "display_order": 49}, {"id": 6000255049, "chapter_id": 10255, "verse_number": "१०-५९-४४", "content_sanskrit": "क्षत्रियाणामयं धर्मः प्रजापतिविनिर्मितः।\nभ्राताऽपि भ्रातरं हन्याद् येन घोरतरस्ततः॥ १०/५९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.049.m4a", "display_order": 50}, {"id": 6000255050, "chapter_id": 10255, "verse_number": "१०-५९-४५", "content_sanskrit": "राज्यस्य भूमेर्वित्तस्य श्रियो मानस्य तेजसः।\nमानिनोऽन्यस्य वा हेतोः श्रीमदान्धाः क्षिपन्ति हि॥ १०/५९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.050.m4a", "display_order": 51}, {"id": 6000255051, "chapter_id": 10255, "verse_number": "१०-५९-४६", "content_sanskrit": "आत्ममोहो नृणामेष कल्प्यते देवमायया।\nसुहृच्छत्रुरुदासीन इति देहात्ममानिनाम्॥ १०/५९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.051.m4a", "display_order": 52}, {"id": 6000255052, "chapter_id": 10255, "verse_number": "१०-५९-४७", "content_sanskrit": "एक एव परो ह्यात्मा सर्वेषामपि देहिनाम्।\nनानेव गृह्यते मूढैर्यथा ज्योतिर्यथा नभः॥ १०/५९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.052.m4a", "display_order": 53}, {"id": 6000255053, "chapter_id": 10255, "verse_number": "१०-५९-४८", "content_sanskrit": "देह आद्यन्तवानेष द्रव्यप्राणगुणात्मकः।\nआत्मन्यविद्यया क्षिप्तः संसारयति देहिनम्॥ १०/५९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.053.m4a", "display_order": 54}, {"id": 6000255054, "chapter_id": 10255, "verse_number": "१०-५९-४९", "content_sanskrit": "यथा शयान आत्मानं विषयान् फलमेव च।\nअनुभुङ्क्तेऽप्यसत्यर्थे तथाऽऽत्माऽपि ध्रुवोऽध्रुवान्॥ १०/५९/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.054.m4a", "display_order": 55}, {"id": 6000255055, "chapter_id": 10255, "verse_number": "१०-५९-५०", "content_sanskrit": "तस्मादज्ञानजं शोकमात्मबोधविमोहनम्।\nतत्त्वज्ञानेन निर्हृत्य स्वस्था भव शुचिस्मिते॥ १०/५९/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.055.m4a", "display_order": 56}, {"id": 6000255056, "chapter_id": 10255, "verse_number": "१०-५९-५१", "content_sanskrit": "एवं भगवता तन्वी रामेण प्रतिबोधिता।\nवैमनस्यं परित्यज्य मनो बुद्ध्या समाददे॥ १०/५९/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.056.m4a", "display_order": 57}, {"id": 6000255057, "chapter_id": 10255, "verse_number": "१०-५९-५२", "content_sanskrit": "प्राणावशेष उत्सृष्टो द्विड्भिर्हतबलप्रभः। स्मरन् विरूपकरणं वितथात्ममनोरथः।\nचक्रे भोजकटं नाम निवासाय महत्पुरम्॥ १०/५९/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.057.m4a", "display_order": 58}, {"id": 6000255058, "chapter_id": 10255, "verse_number": "१०-५९-५३", "content_sanskrit": "अहत्वा दुर्मतिं कृष्णमप्रत्यूह्य यवीयसीम्।\nकुण्डिनं न प्रवेक्ष्यामीत्युक्त्वा तत्रावसद् रुषा॥ १०/५९/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.058.m4a", "display_order": 59}, {"id": 6000255059, "chapter_id": 10255, "verse_number": "१०-५९-५४", "content_sanskrit": "भगवान् भीष्मकसुतामेवं निर्जित्य भूमिपान्।\nपुरमानीय विधिवदुपयेमे कुरूद्वह॥ १०/५९/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.059.m4a", "display_order": 60, "topics": [{"text": "द्वारकायां विवाहमहोत्सवः", "range": "५४–६१"}]}, {"id": 6000255060, "chapter_id": 10255, "verse_number": "१०-५९-५५", "content_sanskrit": "तदा महोत्सवो नृृणां यदुपुर्यां गृहे गृहे।\nअभूदनन्यभावानां कृष्णे यदुपतौ नृप॥ १०/५९/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.060.m4a", "display_order": 61}, {"id": 6000255061, "chapter_id": 10255, "verse_number": "१०-५९-५६", "content_sanskrit": "नरा नार्यश्च मुदिताः प्रमृष्टमणिकुण्डलाः।\nपारिबर्हमुपाजह्रुर्वरयोश्चित्रवाससोः॥ १०/५९/५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.061.m4a", "display_order": 62}, {"id": 6000255062, "chapter_id": 10255, "verse_number": "१०-५९-५७", "content_sanskrit": "सा वृष्णिपुर्युत्तभितेन्द्रकेतुभिर्विचित्रमाल्याम्बररत्नतोरणैः।\nबभौ प्रतिद्वार्युपक्लृप्तमङ्गलैरापूर्णकुम्भैरगरुधूपदीपैः॥ १०/५९/५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.062.m4a", "display_order": 63}, {"id": 6000255063, "chapter_id": 10255, "verse_number": "१०-५९-५८", "content_sanskrit": "सिक्तमार्गा मदच्युद्भिराहूतप्रेष्ठभूभुजाम्।\nगजैर्वास्तुपरामृष्टा रम्भापूगोपशोभिता॥ १०/५९/५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.063.m4a", "display_order": 64}, {"id": 6000255064, "chapter_id": 10255, "verse_number": "१०-५९-५९", "content_sanskrit": "कुरुसृञ्जयकैकेयविदर्भयदुकुन्तयः।\nमिथो मुमुदिरे तस्मिन् सम्भ्रमात् परिधावतः॥ १०/५९/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.064.m4a", "display_order": 65}, {"id": 6000255065, "chapter_id": 10255, "verse_number": "१०-५९-६०", "content_sanskrit": "रुग्मिण्याहरणं श्रुत्वा गीयमानं ततस्ततः।\nराजानो राजकन्याश्च बभूवुर्भृशविस्मिताः॥ १०/५९/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.065.m4a", "display_order": 66}, {"id": 6000255066, "chapter_id": 10255, "verse_number": "१०-५९-६१", "content_sanskrit": "द्वारकायामभूद् राजन् महान् मोदः पुरौकसाम्।\nरुग्मिणीं रमणोपेतां दृष्ट्वा कृष्णं श्रियः पतिम्॥ १०/५९/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_059/BhP_10.059.066.m4a", "display_order": 67}, {"id": 6000255067, "chapter_id": 10255, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्ध एकोनषष्टितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]