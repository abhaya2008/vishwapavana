[{"id": 50024333, "chapter_id": 11850, "verse_number": "1", "content_sanskrit": "॥ मेधातिथिः काण्वः। अग्निर्मरुतश्च। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024334, "chapter_id": 11850, "verse_number": "2", "content_sanskrit": "प्रति॒ त्यं चारु॑मध्व॒रं गो॑पी॒थाय॒ प्र हू॑यसे। म॒रुद्भि॑रग्न॒ आ ग॑हि॥ १९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024335, "chapter_id": 11850, "verse_number": "3", "content_sanskrit": "न॒हि दे॒वो न मर्त्यो॑ म॒हस्तव॒ क्रतुं॑ प॒रः। म॒रुद्भि॑रग्न॒ आ ग॑हि॥ १९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024336, "chapter_id": 11850, "verse_number": "4", "content_sanskrit": "ये म॒हो रज॑सो वि॒दुर्विश्वे॑ दे॒वासो॑ अ॒द्रुह॑ः। म॒रुद्भि॑रग्न॒ आ ग॑हि॥ १९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024337, "chapter_id": 11850, "verse_number": "5", "content_sanskrit": "य उ॒ग्रा अ॒र्कमा॑नृ॒चुरना॑धृष्टास॒ ओज॑सा। म॒रुद्भि॑रग्न॒ आ ग॑हि॥ १९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024338, "chapter_id": 11850, "verse_number": "6", "content_sanskrit": "ये शु॒भ्रा घो॒रव॑र्पसः सुक्ष॒त्रासो॑ रि॒शाद॑सः। म॒रुद्भि॑रग्न॒ आ ग॑हि॥ १९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024339, "chapter_id": 11850, "verse_number": "7", "content_sanskrit": "ये नाक॒स्याधि॑ रोच॒ने दि॒वि दे॒वास॒ आस॑ते। म॒रुद्भि॑रग्न॒ आ ग॑हि॥ १९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024340, "chapter_id": 11850, "verse_number": "8", "content_sanskrit": "य ई॒ङ्खय॑न्ति॒ पर्व॑तान्ति॒रः स॑मु॒द्रम॑र्ण॒वम्। म॒रुद्भि॑रग्न॒ आ ग॑हि॥ १९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024341, "chapter_id": 11850, "verse_number": "9", "content_sanskrit": "आ ये त॒न्वन्ति॑ र॒श्मिभि॑स्ति॒रः स॑मु॒द्रमोज॑सा। म॒रुद्भि॑रग्न॒ आ ग॑हि॥ १९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024342, "chapter_id": 11850, "verse_number": "10", "content_sanskrit": "अ॒भि त्वा॑ पू॒र्वपी॑तये सृ॒जामि॑ सो॒म्यं मधु॑। म॒रुद्भि॑रग्न॒ आ ग॑हि॥ १९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}]