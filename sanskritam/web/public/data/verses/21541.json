[{"id": 7001541000, "chapter_id": 21541, "verse_number": "१-३८-१", "content_sanskrit": "॥सूत उवाच ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001541001, "chapter_id": 21541, "verse_number": "१-३८-२", "content_sanskrit": "अतः परं प्रवक्ष्यामि दक्षिणान्दिशमाश्रिताः ।\nया द्रोण्यः सिद्धचरिताः शृणु ता ह्यनुपूर्वशः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001541002, "chapter_id": 21541, "verse_number": "१-३८-३", "content_sanskrit": "शिशिरस्याचलेन्द्रस्य पतङ्गस्यान्तरेण च ।\nश्लक्ष्णभूमिश्रिया युक्तं लतालिङ्गितपादपम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001541003, "chapter_id": 21541, "verse_number": "१-३८-४", "content_sanskrit": "पृथुक्षेपोच्चशिखरैः पादपैरुपशोभितम् ।\nउदुम्बरवनं रम्यं पक्षिसङ्घनिषेवितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001541004, "chapter_id": 21541, "verse_number": "१-३८-५", "content_sanskrit": "पक्वैर्विद्रुमसङ्काशै र्मधुपूर्णैर्मनोरमैः ।\nज्वलितं तद्वनं भाति महाकुम्भोपमैः फलैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001541005, "chapter_id": 21541, "verse_number": "१-३८-६", "content_sanskrit": "तत् सिद्धयक्षगन्धर्वाः किन्नरा उरगास्तथा ।\nविद्याधराश्च मुदिता उपजीवन्ति नित्यशः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001541006, "chapter_id": 21541, "verse_number": "१-३८-७", "content_sanskrit": "प्रसन्नस्वादुसलिलास्तत्र नद्यो बहूदकाः ।\nसुरसामलतोयास्ताः सरांसि च समन्ततः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001541007, "chapter_id": 21541, "verse_number": "१-३८-८", "content_sanskrit": "तत्राश्रमं भगवतः कर्द्दमस्य प्रजापतेः ।\nरम्यं सुरगणाकीर्णं सर्वतश्चित्रकाननम् ।\nसमन्ताद्योजनशतं तद्वनं परिमण्डलम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001541008, "chapter_id": 21541, "verse_number": "१-३८-९", "content_sanskrit": "ताम्रवर्णस्य शैलस्य पतङ्गस्यान्तरेण तु ।\nशतयोजनविस्तीर्णं द्वियोजनशतायतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001541009, "chapter_id": 21541, "verse_number": "१-३८-१०", "content_sanskrit": "तरुणादित्यसङ्काशैः पुण्डरीकैः समन्ततः ।\nसहस्रपत्रैर्विकचैर्महापद्मैरलङ्कृतम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001541010, "chapter_id": 21541, "verse_number": "१-३८-११", "content_sanskrit": "तथा भ्रमरसंलीनैः शतपत्रैः सुगन्धिभिः ।\nप्रफुल्ल्लैः शोभितजलं रक्तनीलैर्महोत्पलैः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001541011, "chapter_id": 21541, "verse_number": "१-३८-१२", "content_sanskrit": "सरोवरं महापुण्यं देवदानवसेवितम् ।\nमहोरगैरध्युषितं नीलजाल विभूषितम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001541012, "chapter_id": 21541, "verse_number": "१-३८-१३", "content_sanskrit": "तस्य मध्ये जनपदो ह्यायतः शतयोजनः ।\nत्रिंशद्योजनविस्तीर्णो रक्तधातुविभूषितः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001541013, "chapter_id": 21541, "verse_number": "१-३८-१४", "content_sanskrit": "तस्योपरि महारम्या प्रांशु प्राकारतोरणा ।\nनरनारीगणाकीर्णा स्फीता विभवविस्तरैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001541014, "chapter_id": 21541, "verse_number": "१-३८-१५", "content_sanskrit": "वलभीकूटनिर्व्यूहैर्मणिभक्तिविचित्रितैः ।\nरत्नचित्रार्पिततलैः श्लक्ष्णचित्रोत्तरच्छदैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001541015, "chapter_id": 21541, "verse_number": "१-३८-१६", "content_sanskrit": "महाभवनमालाभिर्महाप्रांशुभिरुत्तमैः ।\nविद्याधरपुरं तत्र शोभते भ्राजयच्छुभम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001541016, "chapter_id": 21541, "verse_number": "१-३८-१७", "content_sanskrit": "विद्याधरपतिस्तत्र पुलोमा तत्र विश्रुतः ।\nचित्रवेषधरः स्रग्वी माहेन्द्रसदृशद्युतिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001541017, "chapter_id": 21541, "verse_number": "१-३८-१८", "content_sanskrit": "दीप्तानां चित्रवेषाणां सूर्यप्रतिमतेजसाम् ।\nविद्याधरसहस्राणामनेकेषां स राजराट् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001541018, "chapter_id": 21541, "verse_number": "१-३८-१९", "content_sanskrit": "विशाखस्याचलेन्द्रस्य पतङ्गस्यान्तरेण च ।\nसरसस्ताम्रवर्णस्य पूर्वे तीरे परिश्रुतम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001541019, "chapter_id": 21541, "verse_number": "१-३८-२०", "content_sanskrit": "पञ्चेषुक्षेपणैर्विद्धं सुशाखं वर्णशोभितम्  ।\nसर्व कालफलं तत्र स्फीतं चाम्रवणं महत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001541020, "chapter_id": 21541, "verse_number": "१-३८-२१", "content_sanskrit": "फलैः कनकसङ्काशैर्महास्वादैः सुगन्धिभिः ।\nमहाकुम्भप्रमाणैश्चातनुशाखैः समन्ततः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001541021, "chapter_id": 21541, "verse_number": "१-३८-२२", "content_sanskrit": "गन्धर्वकिन्नरा यक्षा नागा विद्याधरास्तथा ।\nपिबन्त्याम्ररसं तत्र सुस्वादुं ह्यमृतोपमम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001541022, "chapter_id": 21541, "verse_number": "१-३८-२३", "content_sanskrit": "तत्राम्ररसपीतानां मुदितानां महात्मनाम् ।\nश्रूयन्ते हृष्ट पुष्टानां नादास्तस्मिन् महावने ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001541023, "chapter_id": 21541, "verse_number": "१-३८-२४", "content_sanskrit": "सुमूलस्याचलेन्द्रस्य वसुधारस्य चान्तरे ।\nसमा सुरभिपूर्णाढ्या विहङ्गैरुपशोभिता ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001541024, "chapter_id": 21541, "verse_number": "१-३८-२५", "content_sanskrit": "त्रिंशद्योजनविस्तीर्णा पञ्चाशद्योजनायता ।\nतत्र बिल्वस्थली विप्राः शुद्धा निम्नफलद्रुमाः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001541025, "chapter_id": 21541, "verse_number": "१-३८-२६", "content_sanskrit": "सुस्वादैर्विद्रुमनिभैः फलैर्बिल्वैर्महोपमैः ।\nशीर्यमाणैर्विशीर्णैश्च प्रक्लिन्नतलमृत्तिकाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001541026, "chapter_id": 21541, "verse_number": "१-३८-२७", "content_sanskrit": "तां स्थलीमुपजीवन्ति यक्षगन्धर्वकिन्नराः ।\nसिद्धा नागाश्च बहुशो नित्यं बिल्वफलाशिनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001541027, "chapter_id": 21541, "verse_number": "१-३८-२८", "content_sanskrit": "अन्तरे वसुधारस्य रत्नधारस्य चान्तरे ।\nत्रिंशद्योजनविस्तीर्णमायतं शतयोजनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001541028, "chapter_id": 21541, "verse_number": "१-३८-२९", "content_sanskrit": "सुगन्धं किंशुकवनं नित्यं पुष्पितपादपम् ।\nपुष्पलक्ष्म्यावृतं भाति प्रदीप्तमिव सर्वतः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001541029, "chapter_id": 21541, "verse_number": "१-३८-३०", "content_sanskrit": "यस्य गन्धेन दिव्येन वास्यते परिमण्डलम् ।\nसमग्रं योजनशतं काननानि समन्ततः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001541030, "chapter_id": 21541, "verse_number": "१-३८-३१", "content_sanskrit": "तत् सिद्धचारणगणैरप्सरोभिश्च सेवितम्  ।\nरम्यं तत् किंशुक वनं जलाशयविभूषितम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001541031, "chapter_id": 21541, "verse_number": "१-३८-३२", "content_sanskrit": "तत्रादित्यस्य देवस्य दीप्तमायतनं महत्  ।\nमासे मासेऽनतरति तत्र सूर्यः प्रजापतिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001541032, "chapter_id": 21541, "verse_number": "१-३८-३३", "content_sanskrit": "तत्र कालस्य कर्त्तारं सहस्रांशुं सुरोत्तमम् ।\nसिद्धसङ्घा नमस्यन्ति सर्वलोकनमस्कृतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001541033, "chapter_id": 21541, "verse_number": "१-३८-३४", "content_sanskrit": "पञ्चकूटस्य शैलस्य कैलासस्यान्तरेण तु ।\nषट्‌त्रिंशद्योजनायामं विस्तीर्णं शतयोजनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001541034, "chapter_id": 21541, "verse_number": "१-३८-३५", "content_sanskrit": "क्षुद्रसत्त्वैरनाधृष्यं सर्वतो हंसपाण्डुरम् ।\nदुष्पारं सर्वसत्वानां दुर्गमं लोमहर्षणम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001541035, "chapter_id": 21541, "verse_number": "१-३८-३६", "content_sanskrit": "इत्येता ह्यन्तरद्रोण्यो दक्षिणे परिकीर्तिताः ।\nयथानुपूर्वमखिलाः सिद्धसङ्घनिषेविताः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001541036, "chapter_id": 21541, "verse_number": "१-३८-३७", "content_sanskrit": "पश्विमायां दिशितथा येऽन्तरद्रोणिविस्तराः ।\nतान् वर्ण्यमानांस्तत्वेन श्रृणुतेमान् द्विजोत्तमाः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001541037, "chapter_id": 21541, "verse_number": "१-३८-३८", "content_sanskrit": "अन्तराले गिरौ तस्मिन् सुवक्षः शिखिशैलयोः ।\nसमन्ताद्योजनशतमेकभूमं शिलातलम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001541038, "chapter_id": 21541, "verse_number": "१-३८-३९", "content_sanskrit": "नित्यतप्तं महाघोरं दुःस्पर्शं रोमहर्षणम् ।\nअगम्यं सर्वसत्त्वानामीश्वराणां सुदारुणम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001541039, "chapter_id": 21541, "verse_number": "१-३८-४०", "content_sanskrit": "मध्ये तस्यां शिलास्थल्यां त्रिंशद्योजनमण्डलम् ।\nज्वालासहस्रकलिलं वह्निस्थानं सुदारुणम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001541040, "chapter_id": 21541, "verse_number": "१-३८-४१", "content_sanskrit": "अनिन्धनस्तत्र सदा ज्वालामाली विभावसुः ।\nज्वलत्येष सदा देवः शश्वत्तत्र हुताशनः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001541041, "chapter_id": 21541, "verse_number": "१-३८-४२", "content_sanskrit": "अधिदेवकृते योऽसावग्नेर्भागो विधीयते ।\nस तत्र ज्वलते नित्यं लोकसंवर्त्तकोऽनलः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001541042, "chapter_id": 21541, "verse_number": "१-३८-४३", "content_sanskrit": "अन्तरे शैलवरयोर्देवा वापि तयोः शुभाः  ।\nमातुलुङ्गस्थली तत्र ह्यायामाद्दशयोजना ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001541043, "chapter_id": 21541, "verse_number": "१-३८-४४", "content_sanskrit": "मधुव्यञ्जनसंस्थानैः सुरसैः कनकप्रभैः ।\nफलैः परिणतैः सर्वा शोभिता सा महास्थली ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001541044, "chapter_id": 21541, "verse_number": "१-३८-४५", "content_sanskrit": "तत्राश्रमं महा पुण्यं सिद्धसङ्घनिषेवितम् ।\nबृहस्पतेः प्रमुदितं सर्वकामगुणैर्युतम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001541045, "chapter_id": 21541, "verse_number": "१-३८-४६", "content_sanskrit": "तथैव शैलवरयोः कुमुदाञ्जनयोरपि ।\nअन्तरे केसरद्रोणी ह्यनेकायाम योजना ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001541046, "chapter_id": 21541, "verse_number": "१-३८-४७", "content_sanskrit": "द्विबाहुपरिणाहैस्तैस्त्रिहस्तायतविस्तृतैः ।\nचन्द्रांशुवर्णैर्व्याकोशैर्मत्तषट्पदनादितैः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001541047, "chapter_id": 21541, "verse_number": "१-३८-४८", "content_sanskrit": "मधुसर्पीरजः पृक्तैर्महागन्धैर्मनोहरैः ।\nशबलं तद्वनं भाति कुसुमैः सर्वकालजैः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001541048, "chapter_id": 21541, "verse_number": "१-३८-४९", "content_sanskrit": "तत्र विष्णोः सुरगुरोर्दीप्तमायतनं महत् ।\nप्रकाशन्त्रिषु लोकेषु सर्वलोकनमस्कृतम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001541049, "chapter_id": 21541, "verse_number": "१-३८-५०", "content_sanskrit": "अन्तरे शैलवरयोः कृष्णपाण्डुरयोरपि ।\nत्रिंशद्योजनविस्तीर्णं नवत्यायतयोजनम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001541050, "chapter_id": 21541, "verse_number": "१-३८-५१", "content_sanskrit": "श्लक्ष्णमेकशिलं देशं वृक्षवीरुद्विवर्जितम्  ।\nसुखपादप्रचा रञ्च निम्नोन्नतविवर्जितम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001541051, "chapter_id": 21541, "verse_number": "१-३८-५२", "content_sanskrit": "मध्ये तु सरसस्तस्य रम्या तु स्थलपद्मिनी ।\nसहस्रपत्रैर्व्याकोशैः छत्रमात्रैरलङ्कृता ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001541052, "chapter_id": 21541, "verse_number": "१-३८-५३", "content_sanskrit": "पुण्डरीकैर्महापद्मै रुचिरैर्गन्धशालिभिः  ।\nशतपत्रैश्च विकचैरुत्पलैर्नीलपत्रकैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001541053, "chapter_id": 21541, "verse_number": "१-३८-५४", "content_sanskrit": "मदोत्कटैर्मधुकरैर्भ्रमरैश्च मदोत्कटैः ।\nमृदुगद्घदकण्ठानां किन्नराणाञ्च निस्वनैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001541054, "chapter_id": 21541, "verse_number": "१-३८-५५", "content_sanskrit": "उपगीतपद्मखण्डाढ्या विस्तीर्णा स्थलपद्मिनी ।\nयक्षगन्धर्वचरिता सिद्धचारणसेविता ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001541055, "chapter_id": 21541, "verse_number": "१-३८-५६", "content_sanskrit": "मध्ये तस्याश्च पद्मिन्याः पञ्चयोजनमण्डलः ।\nन्यग्रोधो विपुलस्कन्धो ह्यनेकारोहिमण्डितः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001541056, "chapter_id": 21541, "verse_number": "१-३८-५७", "content_sanskrit": "तत्र चन्द्रप्रभः श्रीमान् पूर्णचन्द्रनिभानन) ।\nसहस्रवदनो देवो नीलवासाः सुरारिहा ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001541057, "chapter_id": 21541, "verse_number": "१-३८-५८", "content_sanskrit": "पद्म माल्यधरस्थल्यां महाभागोऽपराजितः ।\nइज्यते यक्षगन्धर्वैर्विद्याधरगणैस्तथा ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001541058, "chapter_id": 21541, "verse_number": "१-३८-५९", "content_sanskrit": "तस्मिन्नायतने साक्षादनादिनिधनो हरिः ।\nपद्मोपहारौर्विविधै रिज्यते सिद्धचारणैः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001541059, "chapter_id": 21541, "verse_number": "१-३८-६०", "content_sanskrit": "तदनन्तसदो नाम सर्वलोकेषु विश्रुतम् ।\nपद्ममालावलम्बाभिर्मालाभिरुपशोभितम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001541060, "chapter_id": 21541, "verse_number": "१-३८-६१", "content_sanskrit": "तथा सहस्रशिखरकुमुदस्यान्तरेण च ।\nपञ्चाशद्योजनायामं त्रिंशद्योजनविस्तरम्  ।\nइषुक्षेपोच्चशिखरं नानाविहगसेवितम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001541061, "chapter_id": 21541, "verse_number": "१-३८-६२", "content_sanskrit": "महागन्धैर्महास्वादैर्गजदेहनिभैः फलैः ।\nमधुस्रवैर्महावृक्षैरुपेतं तत् समन्ततः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001541062, "chapter_id": 21541, "verse_number": "१-३८-६४", "content_sanskrit": "तत्राश्रमं महापुण्यं देवर्षिगणसेवितम् ।\nशुक्रस्य प्रथितं तत्र भास्वरं पुण्यकर्मणः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001541063, "chapter_id": 21541, "verse_number": "१-३८-६५", "content_sanskrit": "शङ्कुकूटस्य शैलस्य वृषभस्यान्तरेण च ।\nपरूषकस्थली रम्या ह्यनेकायतयोजना ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001541064, "chapter_id": 21541, "verse_number": "१-३८-६६", "content_sanskrit": "बिल्वप्रमाणैश्च शुभैर्महास्वादैः सुगन्धिभिः ।\nफलैः प्रक्लिद्यते भूमिः परुषैर्वृन्तविच्युतैः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001541065, "chapter_id": 21541, "verse_number": "१-३८-६७", "content_sanskrit": "तां स्थलीमुपजीवन्ति किन्नरोरगसाधवः ।\nपरूषकरसोन्मत्ता मानाढ्यास्तत्र चारणाः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001541066, "chapter_id": 21541, "verse_number": "१-३८-६८", "content_sanskrit": "कपिञ्जलस्य शैलस्य नागशैलस्य चान्तरे ।\nद्वियोजनशतायामा विस्तीर्णा शतयोजना ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001541067, "chapter_id": 21541, "verse_number": "१-३८-६९", "content_sanskrit": "स्थली मनोहरा सा हि नानावनविभूषिता  ।\nनानापुष्पफलोपेता किन्नरोरगसेविता ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001541068, "chapter_id": 21541, "verse_number": "१-३८-७०", "content_sanskrit": "द्राक्षावनानि रम्याणि तथा नागवनानि च ।\nखर्जूरवनखण्डानि नीलाशोकवनानि च ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001541069, "chapter_id": 21541, "verse_number": "१-३८-७१", "content_sanskrit": "दाडिमानाञ्च स्वादूनामक्षोटकवनानि च ।\nअतसीतिलकानाञ्च कदलीनां वनानि च ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001541070, "chapter_id": 21541, "verse_number": "१-३८-७२", "content_sanskrit": "बदरीणाञ्च स्वादूनां वनखण्डानि सर्वशः ।\nस्वादुशीताम्बुपूर्णाभिर्नदीभिः शोभितानि च ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001541071, "chapter_id": 21541, "verse_number": "१-३८-७३", "content_sanskrit": "तथा पुष्पकशैलस्य महामेघस्य चान्तरे ।\nषष्टियोजनविस्तीर्णा सा भूमिः शतमायता ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001541072, "chapter_id": 21541, "verse_number": "१-३८-७४", "content_sanskrit": "समा पाणितलप्रख्या कठिना पाण्डुरा घना ।\nवृक्षगुल्मलतागुल्मैस्तृणैश्वापि विवर्जिता ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001541073, "chapter_id": 21541, "verse_number": "१-३८-७५", "content_sanskrit": "वर्जिता विविधैः सत्वैर्न्नित्यमस्मिन् निराश्रया ।\nसा काननस्थली नाम दारुणा रोमहर्षणा ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001541074, "chapter_id": 21541, "verse_number": "१-३८-७६", "content_sanskrit": "महासरांसि च तथा महावृक्षास्तथैव च ।\nमहावनानि सर्वाणि कान्तनामानि सर्वशः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001541075, "chapter_id": 21541, "verse_number": "१-३८-७७", "content_sanskrit": "सरसाञ्च वनानाञ्च सा स्थली च प्रजापतेः ।\nक्षुद्राणां सरसाञ्चैव सङ्ख्या तत्र न विद्यते ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001541076, "chapter_id": 21541, "verse_number": "१-३८-७८", "content_sanskrit": "दश द्वादश सप्ताष्टौ विंशत्र्रिंशच्च योजनाः ।\nस्थल्यो द्रोण्यश्च विख्याताः सरांसि च वनानि च ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001541077, "chapter_id": 21541, "verse_number": "१-३८-७९", "content_sanskrit": "केचित् सन्ति महाघोराः श्यामाः पर्वतकुक्षयः ।\nसूर्यांशुजालैरस्पृष्टा नित्यं शीता दुरासदाः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001541078, "chapter_id": 21541, "verse_number": "१-३८-८०", "content_sanskrit": "तथा ह्यनलतप्तानि सरांसि द्विजसत्तमाः ।\nशैलकुक्ष्यन्तरस्थानि सहस्राणि शतानि च ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001541079, "chapter_id": 21541, "verse_number": "१-३८-८१", "content_sanskrit": "इति श्रीमहापुराणे वायुप्रोक्ते भुवनविन्यासो नामाष्टत्रिंशोऽध्यायः ॥ ३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]