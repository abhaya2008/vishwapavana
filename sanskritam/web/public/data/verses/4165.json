[{"id": 2146754, "chapter_id": 4165, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146755, "chapter_id": 4165, "verse_number": "१", "content_sanskrit": "जामदग्न्यवचः श्रुत्वा कण्वोऽपि भगवानृषिः ।\nदुर्योधनमिदं वाक्यमब्रवीत् कुरुसंसदि\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146756, "chapter_id": 4165, "verse_number": "२", "content_sanskrit": "अक्षयश्चाव्ययश्चैव ब्रह्मा लोकपितामहः ।\nतथैव भगवन्तौ तौ नरनारायणावृषी\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146757, "chapter_id": 4165, "verse_number": "३", "content_sanskrit": "आदित्यानां हि सर्वेषां विष्णुरेकः सनातनः ।\nअजय्यश्चाव्ययश्चैव शाश्वतः प्रभुरीश्वरः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146758, "chapter_id": 4165, "verse_number": "४", "content_sanskrit": "निमित्तमरणाश्चान्ये चन्द्रसूर्यौ मही जलम् ।\nवायुरग्निस्तथाऽऽकाशं ग्रहास्तारागणास्तथा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146759, "chapter_id": 4165, "verse_number": "५", "content_sanskrit": "ते च क्षयान्ते जगतो हित्वा लोकत्रयं सदा ।\nक्षयं गच्छन्ति वै सर्वे सृज्यन्ते च पुनः पुनः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146760, "chapter_id": 4165, "verse_number": "६", "content_sanskrit": "मुहूर्तमरणाश्चान्ये मानुषा मृगपक्षिणः ।\nतिर्यग्योन्यश्च ये चान्ये जीवलोकचराः स्मृताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146761, "chapter_id": 4165, "verse_number": "७", "content_sanskrit": "भूयिष्ठेन तु राजानः श्रियं भुक्त्वाऽऽयुषः क्षये ।\nमरणं प्रतिगच्छन्ति भोक्तुं सुकृतदुष्कृते\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146762, "chapter_id": 4165, "verse_number": "८", "content_sanskrit": "स भवान् धर्मपुत्रेण शमं कर्तुमिहार्हति ।\nपाण्डवाः कुरवश्चैव पालयन्तु वसुन्धराम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146763, "chapter_id": 4165, "verse_number": "९", "content_sanskrit": "बलवानहमित्येष न मन्तव्यं सुयोधन ।\nबलवन्तो बलिभ्यो हि दृश्यन्ते पुरुषर्षभ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146764, "chapter_id": 4165, "verse_number": "१०", "content_sanskrit": "न बलं बलिनां मध्ये बलं भवति कौरव ।\nबलवन्तो हि ते सर्वे पाण्डवा देवविक्रमाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146765, "chapter_id": 4165, "verse_number": "११", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nमातलेर्दातुकामस्य कन्यां मृगयतो वरम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146766, "chapter_id": 4165, "verse_number": "१२", "content_sanskrit": "मतस्त्रिलोकराजस्य मातलिर्नाम सारथिः ।\nतस्यैकैव कुले कन्या रूपतो लोकविश्रुता\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146767, "chapter_id": 4165, "verse_number": "१३", "content_sanskrit": "गुणकेशीति विख्याता नाम्ना सा देवरूपिणी ।\nश्रिया च वपुषा चैव स्त्रियोऽन्याः साऽतिरिच्यते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146768, "chapter_id": 4165, "verse_number": "१४", "content_sanskrit": "तस्याः प्रदानसमयं मातलिः सह भार्यया ।\nज्ञात्वा विममृशे राजन् तद्धितं परिचिन्तयन्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146769, "chapter_id": 4165, "verse_number": "", "content_sanskrit": "मातलिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146770, "chapter_id": 4165, "verse_number": "१५", "content_sanskrit": "धिक् खल्वलघुशीलानामुच्छ्रितानां यशस्विनाम् ।\nनराणामृद्धसत्वानां कुले कन्याप्ररोहणम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146771, "chapter_id": 4165, "verse_number": "१६", "content_sanskrit": "मातुः कुलं पितृकुलं यत्र चैव प्रदीयते ।\nकुलत्रयं संशयितं कुरुते कन्यका सती\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146772, "chapter_id": 4165, "verse_number": "१७", "content_sanskrit": "देवमानुषलोकौ द्वौ मनसा चैव चक्षुषा ।\nअवगाह्यैव विचितौ न च मे रोचते वरः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146773, "chapter_id": 4165, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146774, "chapter_id": 4165, "verse_number": "१८", "content_sanskrit": "न देवान् नैव दितिजान् न गन्धर्वान् न मानुषान् ।\nअरोचयद् वरकृते त्रिषु लोकेषु वै ऋषीन्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146775, "chapter_id": 4165, "verse_number": "१९", "content_sanskrit": "भार्यया तु स सम्मन्त्र्य सह रात्रौ सुधर्मया ।\nमातलिर्नागलोकाय चकार गमने मतिम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146776, "chapter_id": 4165, "verse_number": "२०", "content_sanskrit": "न मे देवमनुष्येषु गुणकेश्याः समो वरः ।\nरूपतो दृश्यते कश्चिन्नागेषु भविता ध्रुवम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146777, "chapter_id": 4165, "verse_number": "२१", "content_sanskrit": "इत्यामन्त्र्य सुधर्मां स कृत्वा चाभिप्रदक्षिणम् ।\nकन्यां शिरस्युपाघ्राय प्रविवेश महीतळम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146778, "chapter_id": 4165, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षण्णवतितमोऽध्यायः ॥९६॥\nभगवद्यानपर्वणि सप्तविंशोऽध्यायः ॥२७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]