[{"id": 2096433, "chapter_id": 3061, "verse_number": "१३-१९१-१", "content_sanskrit": "[वायुरुवाच।\nकिञ्चिद्धर्मं प्रवक्ष्यामि मानुषाणां सुखावहम्।\nसरहस्याश्च ये दोषास्ताञ्शृणुध्वं समाहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2096434, "chapter_id": 3061, "verse_number": "१३-१९१-२", "content_sanskrit": "अग्निकार्यं च कर्तव्यं परमान्नेन भोजनम्।\nदीपकश्चापि कर्तव्यः पितॄणां सतिलोदकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2096435, "chapter_id": 3061, "verse_number": "१३-१९१-३", "content_sanskrit": "एतेन विधिना मर्त्यः श्रद्दधानः समाहितः।\nचतुरो वार्षिकान्मासान्यो ददाति तिलोदकाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2096436, "chapter_id": 3061, "verse_number": "१३-१९१-४", "content_sanskrit": "भोजनं च यथाशक्त्या ब्राह्मणे वेदपारगे।\nपशुबन्धशतस्येह फलं प्राप्नोति पुष्कलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2096437, "chapter_id": 3061, "verse_number": "१३-१९१-५", "content_sanskrit": "इदं चैवापरं गुह्यमप्रशस्तं निबोधत।\nअग्नेस्तु वृषलो नेता हविर्मूढाश्च योषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2096438, "chapter_id": 3061, "verse_number": "१३-१९१-६", "content_sanskrit": "मन्यते धर्म एवेति च चाधर्मेणि लिप्यते।\nअग्नयस्तस्य कुप्यन्ति शूद्रयोनिं स गच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2096439, "chapter_id": 3061, "verse_number": "१३-१९१-७", "content_sanskrit": "पितरश्च न तुष्यन्ति सहदेवैर्विशेषतः।\nप्रायश्चित्तं तु यत्तत्र ब्रुवतस्तन्निबोध मे।\nयत्कृत्वा तु नरः सम्यक्सुखी भवति विज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2096440, "chapter_id": 3061, "verse_number": "१३-१९१-८", "content_sanskrit": "गवां मूत्रपुरीषेणि पयसा च घृतेन च।\nअग्निकार्यं त्र्यहं कुर्यान्निराहारः समाहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2096441, "chapter_id": 3061, "verse_number": "१३-१९१-९", "content_sanskrit": "ततः संवत्सरे पूर्णे प्रतिगृह्णन्ति देवताः।\nहृष्यन्ति पितरश्चास्य श्राद्धकाल उपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2096442, "chapter_id": 3061, "verse_number": "१३-१९१-१०", "content_sanskrit": "एष ह्यधर्मो धर्मश्च सरहस्यः प्रकीर्तितः।\nमर्त्यानां स्वर्गकामानां प्रेत्य स्वर्गसुखावह॥] ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2096443, "chapter_id": 3061, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकनवत्यधिकशततमोऽध्यायः॥ १९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}]