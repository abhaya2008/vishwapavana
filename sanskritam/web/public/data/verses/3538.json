[{"id": 2117880, "chapter_id": 3538, "verse_number": "", "content_sanskrit": "ब्राह्मणेभ्यः सर्वं वृत्तं कथयित्वा अर्जुनस्य मणलूरप्राप्तिः ।\nत्रयोदशे मासे पुत्रिकापुत्रन्यायेन चित्राङ्गदाया विवाहश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2117881, "chapter_id": 3538, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2117882, "chapter_id": 3538, "verse_number": "१", "content_sanskrit": "कथयित्वा तु तत् सर्वं ब्राह्मणेभ्यः स भारत ।\nप्रययौ हिमवत्पार्श्वे ततो वज्रधरात्मजः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2117883, "chapter_id": 3538, "verse_number": "२", "content_sanskrit": "अगस्त्यवटमासाद्य वसिष्ठस्य च पर्वतम् ।\nभृगुतीर्थे च कौरव्यः कृतवाञ्शौचमात्मनः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2117884, "chapter_id": 3538, "verse_number": "३", "content_sanskrit": "प्रददौ गोसहस्राणि यज्ञानुद्दिश्य दक्षिणाः ।\nनिवेशांश्च द्विजातिभ्यः सोऽददात् कुरुसत्तमः \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2117885, "chapter_id": 3538, "verse_number": "४", "content_sanskrit": "हिरण्यबिन्दोस्तीर्थानि स्नात्वा पुरुषसत्तमः ।\nदृष्टवान् पर्वतश्रेष्ठान् पुण्यान्यायतनानि च \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2117886, "chapter_id": 3538, "verse_number": "५", "content_sanskrit": "अवतीर्य नरश्रेष्ठो ब्राह्मणैः सह भारत ।\nप्राचीं दिशं प्रतिष्ठासुर्जगाम भरतर्षभः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2117887, "chapter_id": 3538, "verse_number": "६", "content_sanskrit": "आनुपूर्व्येण तीर्थानि दृष्टवान् कुरुसत्तमः ।\nनदीं चोत्पलिनीं रम्यामरण्यं नैमिशं प्रति \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2117888, "chapter_id": 3538, "verse_number": "७", "content_sanskrit": "नन्दामपरनन्दां च कौशिकीं च यशस्विनीम् ।\nमहानदीं गयां चैव गङ्गामपि च भारत \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2117889, "chapter_id": 3538, "verse_number": "८", "content_sanskrit": "एवं पुण्यानि सर्वाणि पश्यमानस्तथाऽऽश्रमान् ।\nआत्मनः पावनं कुर्वन् ब्राह्मणेभ्यो धनं ददौ \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2117890, "chapter_id": 3538, "verse_number": "९", "content_sanskrit": "अङ्गवङ्गकळिङ्गेषु यानि पुण्यानि कानि चित् ।\nजगाम तानि सर्वाणि तीर्थान्यायतनानि च \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2117891, "chapter_id": 3538, "verse_number": "१०", "content_sanskrit": "दृष्ट्वा च विधिवत् तानि धनं चापि ददौ पुनः ।\nकळिङ्गराष्ट्रद्वारे तु ब्राह्मणाः पाण्डवानुगाः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2117892, "chapter_id": 3538, "verse_number": "११", "content_sanskrit": "अभ्यनुज्ञाय कौन्तेयमुपावर्तन्त भारत ।\nस तु तैरभ्यनुज्ञातः कुन्तीपुत्रो धनञ्चयः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2117893, "chapter_id": 3538, "verse_number": "१२", "content_sanskrit": "सहायैरल्पकैः शूरैः प्रययौ लवणार्णवम् ।\nस कळिङ्गानतिक्रम्य देशानायतनानि च \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2117894, "chapter_id": 3538, "verse_number": "१३", "content_sanskrit": "धर्म्याणि रमणीयानि प्रेक्षमाणो ययौ प्रभुः ।\nशूर्पाकारमथाप्लुत्य सागरानूपमाश्रितः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2117895, "chapter_id": 3538, "verse_number": "१४", "content_sanskrit": "महेन्द्रपर्वतं दृष्ट्वा तापसैरुपशोभितम् ।\nगोदावर्यां ततः स्नात्वा तामतीत्य महाबलः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2117896, "chapter_id": 3538, "verse_number": "१५", "content_sanskrit": "कावेरीं तामथासाद्य सङ्गमे सागरस्य ह ।\nस्नात्वा सम्पूज्य देवांश्च ऋषींश्च पितृभिः सह \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2117897, "chapter_id": 3538, "verse_number": "१६", "content_sanskrit": "समुद्रतीरेण शनैर्मणलूरुं जगाम ह ।\nतत्र सर्वाणि तीर्थानि पुण्यान्यायतनानि च\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2117898, "chapter_id": 3538, "verse_number": "१७", "content_sanskrit": "अत्र त्रयोदशे मासे मणलूरेश्वरं प्रभुम् ।\nअनुगम्य महाबाहुमभ्यगच्छन्महीपतिम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2117899, "chapter_id": 3538, "verse_number": "१८", "content_sanskrit": "मणलूरेश्वरं राजन् धर्मज्ञं चित्रवाहनम् ।\nसर्वशास्त्रेषु नेतारं सर्वास्त्रज्ञमकल्मषम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2117900, "chapter_id": 3538, "verse_number": "१९", "content_sanskrit": "धर्मे सत्ये दमे शौचे शौर्ये चैव विशेषतः ।\nद्विजराजऋषीणां च धार्मिकाणां महास्थले \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2117901, "chapter_id": 3538, "verse_number": "२०", "content_sanskrit": "कीर्तने चोपमाभूतं क्षत्रधर्मविदुत्तमम् ।\nतस्य चित्राङ्गदा नाम दुहिता चारुदर्शना \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2117902, "chapter_id": 3538, "verse_number": "२१", "content_sanskrit": "तां ददर्श पुरे तस्मिन् विचरन्तीं यदृच्छया ।\nदृष्ट्वा च तां वरारेहां चकमे चैत्रवाहनीम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2117903, "chapter_id": 3538, "verse_number": "२२", "content_sanskrit": "अभिगम्य च राजानं ज्ञापयत् स्वं प्रयोजनम्\nतमुवाचाथ राजा स सान्त्वपूर्वमिदं वचः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2117904, "chapter_id": 3538, "verse_number": "२३", "content_sanskrit": "राजा प्रभाकरो नाम कुलेऽस्मिन् सम्बभूव ह ।\nअपुत्रः प्रसवेनार्थी तपस्तेपे स चोत्तमम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2117905, "chapter_id": 3538, "verse_number": "२४", "content_sanskrit": "उग्रेण तपसा तेन प्रणिपत्य प्रणम्य च ।\nईश्वरस्तोषितस्तात देवदेव उमापतिः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2117906, "chapter_id": 3538, "verse_number": "२५", "content_sanskrit": "स तस्मै भगवान् प्रादादेकप्रसवजं कुले ।\nएकैकः प्रसवस्तस्माद् भवत्यस्मिन् कुले सदा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2117907, "chapter_id": 3538, "verse_number": "२६", "content_sanskrit": "तेषां कुमाराः पूर्वेषां सर्वेषां मम जज्ञिरे ।\nकन्या तु मम जातेयं कुलस्योत्पादनी ध्रुवम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2117908, "chapter_id": 3538, "verse_number": "२७", "content_sanskrit": "पुत्रो ममैवेति मे भावना पुरुषोत्तम ।\nपुत्रिका हेति विधिना सम्मता भरतर्षभ \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2117909, "chapter_id": 3538, "verse_number": "२८", "content_sanskrit": "तस्मादेकः सुतो योऽस्यां जायते भारत त्वया ।\nएतच्छुल्कं भवत्वस्यां कुलकृज्जायतामिति ।\nएतेन समयेनेमां प्रतिगृह्णीष्व भारत \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2117910, "chapter_id": 3538, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2117911, "chapter_id": 3538, "verse_number": "२९", "content_sanskrit": "स तथेति प्रतिज्ञाय तां कन्यां प्रतिगृह्य च ।\nमासे त्रयोदशे पार्थः कृत्वा वैवाहिकीं क्रियाम् ।\nउवास नगरे तस्मिन् मासांस्त्रीन् स तया सह \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2117912, "chapter_id": 3538, "verse_number": "२१७", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nसप्तदशाधिकद्विशततमोऽध्यायः ॥२१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2117913, "chapter_id": 3538, "verse_number": "३", "content_sanskrit": "॥ इति अर्जुनवनवासपर्वणि तृतीयोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2117914, "chapter_id": 3538, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]