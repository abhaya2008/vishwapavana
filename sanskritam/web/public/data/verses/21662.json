[{"id": 7001662000, "chapter_id": 21662, "verse_number": "१-४८-१", "content_sanskrit": "नारद उवाच ।\nश्रुतं मया महामाग तापत्रयचिकित्सितम् ।\nतथापि मे मनो भ्रांतं न स्थितिं लभतेंऽजसा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001662001, "chapter_id": 21662, "verse_number": "१-४८-२", "content_sanskrit": "आत्मव्यतिक्रमं ब्रह्मन्दुर्जनाचरितं कथम् ।\nसोढुं शक्येत मनुजैस्तन्ममाख्याहि मानद ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001662002, "chapter_id": 21662, "verse_number": "१-४८-३", "content_sanskrit": "सूत उवाच ।\nतच्छ्रृत्वा नारदेनोक्तं ब्रह्मपुत्रः सनंदनः ।\nउवाच हर्षसंयुक्तः स्मरन्भरतचेष्टितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001662003, "chapter_id": 21662, "verse_number": "१-४८-४", "content_sanskrit": "सनंदन उवाच ।\nअत्र ते कथयिष्यामि इतिहासं पुरातनम् ।\nयं श्रुत्वा त्वन्मनो भ्रांतमास्थानं लभते भृशम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001662004, "chapter_id": 21662, "verse_number": "१-४८-५", "content_sanskrit": "आसीत्पुरा मुनिश्रेष्ट भरतो नाम भूपतिः ।\nआर्षभो यस्य नाम्नेदं भारतं खण्डमुच्यते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001662005, "chapter_id": 21662, "verse_number": "१-४८-६", "content_sanskrit": "स राजा प्राप्तराज्यस्तु पितृपैतामहं क्रमात् ।\nपालयामास धर्मेण पितृवद्रंजयन् प्रजाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001662006, "chapter_id": 21662, "verse_number": "१-४८-७", "content_sanskrit": "ईजे च विविधैर्यज्ञैर्भगवंतमधोक्षजम् ।\nसर्वदेवात्मकं ध्यायन्नानाकर्मसु तन्मतिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001662007, "chapter_id": 21662, "verse_number": "१-४८-८", "content_sanskrit": "ततः समुत्पाद्य सुतान्विरक्तो विषयेषु सः ।\nमुक्त्वा राज्यं ययौ विद्वान्पुलस्त्यपुहाश्रमम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001662008, "chapter_id": 21662, "verse_number": "१-४८-९", "content_sanskrit": "शालग्रामं महाक्षेत्रं मुमुक्षुजनसेवितम् ।\nतत्रासौ तापसो तापसो भूत्वा विष्णोराराधनं मुने ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001662009, "chapter_id": 21662, "verse_number": "१-४८-१०", "content_sanskrit": "चकार भक्तिभावेन यथालब्धसपर्यया ।\nनित्यं प्रातः समाप्लुत्य निर्मलेऽभलि नारद ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001662010, "chapter_id": 21662, "verse_number": "१-४८-११", "content_sanskrit": "उपतिष्टेद्रविं भक्त्या गृणन्ब्रह्माक्षरं परम् ।\nअथाश्रमे समागत्य वासुदेवं जगत्पतिम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001662011, "chapter_id": 21662, "verse_number": "१-४८-१२", "content_sanskrit": "समाहृतैः स्वयं द्रव्यैः समित्कुशमृदादिभिः ।\nफलैः पुष्पैंस्तथा पत्रैस्तुलस्याः स्वच्छवारिभिः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001662012, "chapter_id": 21662, "verse_number": "१-४८-१३", "content_sanskrit": "पूजयन्प्रयतो भूत्वा भक्तिप्रसरसंप्लुतः ।\nसचैकदा महाभागः स्नात्वा प्रातः समाहितः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001662013, "chapter_id": 21662, "verse_number": "१-४८-१४", "content_sanskrit": "चक्रनद्यां जपंस्तस्थौ मुहुर्तत्रयमंबुनि ।\nअथाजगाम तत्तीरं जलं पातुं पिपासिता ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001662014, "chapter_id": 21662, "verse_number": "१-४८-१५", "content_sanskrit": "आसन्नप्रसवा ब्रह्मन्नैकैव हिणी वनात् ।\nततः समभवत्तत्र पीतप्राये जले तया ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001662015, "chapter_id": 21662, "verse_number": "१-४८-१६", "content_sanskrit": "सिंहस्य नादः सुमहान् सर्वप्राणिभयंकरः ।\nततः सा सिंहसन्नादादुत्प्लुता निम्नगातटम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001662016, "chapter_id": 21662, "verse_number": "१-४८-१७", "content_sanskrit": "अत्युञ्चारोहणेनास्या नद्यां गर्भः पपात ह ।\nतमुह्यमानं वेगेन वीचिमालापरिप्लुतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001662017, "chapter_id": 21662, "verse_number": "१-४८-१८", "content_sanskrit": "जग्राह भरतो गर्भात्पतितं मृगपोतकम् ।\nगर्भप्रच्युतिदुःखेन प्रोत्तुंगाक्रणेन च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001662018, "chapter_id": 21662, "verse_number": "१-४८-१९", "content_sanskrit": "मुनीन्द्र सा तु हरिणी निपपात ममार च ।\nहरिणीं तां विलोक्याथ विपन्नां नृपतापसः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001662019, "chapter_id": 21662, "verse_number": "१-४८-२०", "content_sanskrit": "मृगपोतं समागृह्य स्वमाश्रममुपागतः ।\nचकारानुदिनं चासौ मृगपोतस्य वै नृपः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001662020, "chapter_id": 21662, "verse_number": "१-४८-२१", "content_sanskrit": "पोषणं पुष्यमाणश्च स तेन ववृधे मुने ।\nचचाराश्रमपर्यंतं तृणानि गहनेषु सः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001662021, "chapter_id": 21662, "verse_number": "१-४८-२२", "content_sanskrit": "दूरं गत्वा च शार्दूलत्रासादभ्याययौ पुनः ।\nप्रातर्गत्वादिदूरं च सायमायात्यथाश्रमम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001662022, "chapter_id": 21662, "verse_number": "१-४८-२३", "content_sanskrit": "पुनश्च भरतस्याभूदाश्रमस्योटजांतरे ।\nतस्यतस्मिन्मृगे दूरसमीपपरिवर्तिनि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001662023, "chapter_id": 21662, "verse_number": "१-४८-२४", "content_sanskrit": "आसीञ्चेतः समासक्तं न तथा ह्यच्युते मुने ।\nविमुक्तराज्यतनयः प्रोज्झिताशेषबांधवः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001662024, "chapter_id": 21662, "verse_number": "१-४८-२५", "content_sanskrit": "ममत्व स चकारोञ्चैस्तस्मिन्हरिणपोतके ।\nकिं वृकैभक्षितो व्याघ्नैः किं सिंहेन निपातितः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001662025, "chapter_id": 21662, "verse_number": "१-४८-२६", "content_sanskrit": "चिरायमाणे निष्कांते तस्यासीदिति मानसम् ।\nप्रीतिप्रसन्नवदनः पार्श्वस्थे चाभवन्मृगे ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001662026, "chapter_id": 21662, "verse_number": "१-४८-२७", "content_sanskrit": "समाधिभंगस्तस्यासीन्ममत्वाकृष्टमानसः ।\nकालेन गच्छता सोऽथ कालं चक्रे महीपतिः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001662027, "chapter_id": 21662, "verse_number": "१-४८-२८", "content_sanskrit": "पितेव सास्त्रं पुत्रेण मृगपोतेन वीक्षितः ।\nमृगमेव तदाद्राक्षीत्त्यजन्प्राणानसावपि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001662028, "chapter_id": 21662, "verse_number": "१-४८-२९", "content_sanskrit": "मृगो बभूव स मुने तादृशीं भावनां गतः ।\nजाति स्मरत्वादुद्विग्नः संसारस्य द्विजोत्तम ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001662029, "chapter_id": 21662, "verse_number": "१-४८-३०", "content_sanskrit": "विहाय मातरं भूयः शालग्राममुपाययौ ।\nशुष्कैस्तृणैस्तथा पर्णैः स कुर्वन्नात्मपोषणम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001662030, "chapter_id": 21662, "verse_number": "१-४८-३१", "content_sanskrit": "मृगत्वहेतुभूतस्य कर्मणो निष्कृतिं ययौ ।\nतत्र चोत्सृष्टदेहोऽसौ जज्ञे जातिस्मरो द्विजः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001662031, "chapter_id": 21662, "verse_number": "१-४८-३२", "content_sanskrit": "सदाचारवतां शुद्धे यागिनां प्रवरे कुले ।\nसर्वविज्ञान संपन्नः सर्वशास्त्रार्थतत्त्ववित् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001662032, "chapter_id": 21662, "verse_number": "१-४८-३३", "content_sanskrit": "अपश्यत्स मुनिश्रेष्टः स्वात्मानं प्रकृतेः परम् ।\nआत्मनोधिगतज्ञानाद्द्वेवादीनि महामुने ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001662033, "chapter_id": 21662, "verse_number": "१-४८-३४", "content_sanskrit": "सर्वभूतान्यभे देन ददर्श स महामतिः ।\nन पपाठ गुरुप्रोक्तं कृतोपनयनः श्रुतम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001662034, "chapter_id": 21662, "verse_number": "१-४८-३५", "content_sanskrit": "न ददर्श च कर्माणि शास्त्राणि जगृहे न च ।\nउक्तोऽपि बहुशः किंचिज्जंड वाक्यमभाषत ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001662035, "chapter_id": 21662, "verse_number": "१-४८-३६", "content_sanskrit": "तदप्यसंस्कारगुणं ग्रामभाषोक्तिसंयुतम् ।\nअपद्धस्तवपुः सोऽपि मलिनांबरधृङ् मुने ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001662036, "chapter_id": 21662, "verse_number": "१-४८-३७", "content_sanskrit": "क्लिन्नदंतांतरः सर्वैः परिभूतः स नागरैः ।\nसंमानेन परां हानिं योगर्द्धेः कुरुते यतः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001662037, "chapter_id": 21662, "verse_number": "१-४८-३८", "content_sanskrit": "जनेनावमतो योगी योगसिद्धिं च विंदति ।\nतस्माञ्चरेत वै योगी सतां धर्ममदूषयन् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001662038, "chapter_id": 21662, "verse_number": "१-४८-३९", "content_sanskrit": "जना यथावमन्येयुर्गच्छेयुर्नैव संगतिम् ।\nहिरण्यगर्भवचनं विचिंत्येत्थं महामतिः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001662039, "chapter_id": 21662, "verse_number": "१-४८-४०", "content_sanskrit": "आत्मानं दर्शयामास जडोन्मत्ताकृतिं जने ।\nभुंक्ते कुल्माषवटकान् शाकं त्रन्यफलं कणान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001662040, "chapter_id": 21662, "verse_number": "१-४८-४१", "content_sanskrit": "यद्यदाप्नोति स बहूनत्ति वै कालसंभवम् ।\nपितर्युपरते सोऽथ भ्रातृभ्रातृव्यबांधवैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001662041, "chapter_id": 21662, "verse_number": "१-४८-४२", "content_sanskrit": "कारितः क्षेत्रकर्मादि कदन्नाहारपोषितः ।\nसरूक्षपीनावयवो जडकारी च कर्मणि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001662042, "chapter_id": 21662, "verse_number": "१-४८-४३", "content_sanskrit": "सर्वलोकोपकरणं बभूवाहारवेतनः ।\nतं तादृशमसंस्कारं विप्राकृतिविचेष्टितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001662043, "chapter_id": 21662, "verse_number": "१-४८-४४", "content_sanskrit": "क्षत्ता सौवीरराज्यस्य विष्टियोग्यममन्यत ।\nस राजा शिबिकारूढो गंतुं कृतमतिर्द्विज ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001662044, "chapter_id": 21662, "verse_number": "१-४८-४५", "content_sanskrit": "बभूवेक्षुमतीतीरे कपिलर्षेर्वराश्रमम् ।\nश्रेयः किमत्र संसारे दुःखप्राये नृणामिति ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001662045, "chapter_id": 21662, "verse_number": "१-४८-४६", "content_sanskrit": "प्रष्टुं तं मोक्षधर्मज्ञं कपिलाख्यं महामुनिम् ।\nउवाह शिबिकामस्य क्षत्तुर्वचनचोदितः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001662046, "chapter_id": 21662, "verse_number": "१-४८-४७", "content_sanskrit": "नृणां विष्टिगृहीतानामन्येषां सोऽपि मध्यगः ।\nगृहीतो विष्टिना विप्र सर्वज्ञानैकभाजनम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001662047, "chapter_id": 21662, "verse_number": "१-४८-४८", "content_sanskrit": "जातिस्मरोऽसौ पापस्य क्षयकाम उवाह ताम् ।\nययौ जडगतिस्तत्र युगमात्रावलोकनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001662048, "chapter_id": 21662, "verse_number": "१-४८-४९", "content_sanskrit": "कुर्वन्मतिमतां श्रेष्टस्ते त्वन्ये त्वरितं ययुः ।\nविलोक्य नृपतिः सोऽथ विषमं शिबिकागतम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001662049, "chapter_id": 21662, "verse_number": "१-४८-५०", "content_sanskrit": "किमेतदित्याह समं गम्यतां शिबिकावहाः ।\nपुनस्तथैव शिबिकां विलोक्य विषमां हसन् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001662050, "chapter_id": 21662, "verse_number": "१-४८-५१", "content_sanskrit": "नृपः किमेऽतदित्याह भवद्भिर्गम्यतेऽन्यथा ।\nभूपतेर्वदतस्तस्य श्रुत्वेत्थं बहुशो वचः ।\nशिबिकावाहकाः प्रोचुरयं यातीत्यसत्वरम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001662051, "chapter_id": 21662, "verse_number": "१-४८-५२", "content_sanskrit": "राजोवाच ।\nकिं श्रांतोऽस्यल्पमध्वानं त्वयोढा शिबिका मम ।\nकिमायाससहो न त्वं पीवा नासि निरीक्ष्यसे ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001662052, "chapter_id": 21662, "verse_number": "१-४८-५३", "content_sanskrit": "ब्राह्मण उवाच ।\nनाहं पीवा न चैवोढा शिबिका भवतो मया ।\nन श्रांतोऽस्मि न चायासो वोढान्योऽस्ति महीपते ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001662053, "chapter_id": 21662, "verse_number": "१-४८-५४", "content_sanskrit": "राजोवाच ।\nप्रत्यक्षं दृश्यते पीवात्वद्यापि शिबिका त्वयि ।\nश्रमश्च भारो द्वहने भवत्येव हि देहिनाम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001662054, "chapter_id": 21662, "verse_number": "१-४८-५५", "content_sanskrit": "ब्राह्मण उवाच ।\nप्रत्यक्षं भवता भूप यद्दृष्टं मम तद्वद ।\nबलवानबलश्चेति वाच्यं पश्चाद्विशेषणम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001662055, "chapter_id": 21662, "verse_number": "१-४८-५६", "content_sanskrit": "त्वयोढा शिबिका चेति त्वय्यद्यापि च संस्थिता ।\nमिथ्या तदप्यत्र भवान् श्रृणोतु वचनं मम ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001662056, "chapter_id": 21662, "verse_number": "१-४८-५७", "content_sanskrit": "भूमौ पादयुगं चाथ जंघे पादद्वये स्थिते ।\nऊरु जंघाद्वयावस्थौ तदाधारं तथोदरम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001662057, "chapter_id": 21662, "verse_number": "१-४८-५८", "content_sanskrit": "वक्षस्थलं तथा बाहू स्कंधौ चोदरसंस्थितौ ।\nस्कंधाश्रितयें शिबिका ममाधारोऽत्र किंकृतः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001662058, "chapter_id": 21662, "verse_number": "१-४८-५९", "content_sanskrit": "शिबिकायां स्थितं चेदं देहं त्वदुपलक्षितम् ।\nतत्र त्वमहमप्यत्रेत्युच्यते चेदमन्यथा ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001662059, "chapter_id": 21662, "verse_number": "१-४८-६०", "content_sanskrit": "अहं त्वं च तथान्ये च भूतैरुह्याश्च पार्थिव ।\nगुणप्रवाहपतितो भूतवर्गोऽपि यात्ययम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001662060, "chapter_id": 21662, "verse_number": "१-४८-६१", "content_sanskrit": "कर्मवश्या गुणश्चैते सत्त्वाद्याः पृथिवीपते ।\nअविद्यासंचितं कर्मतश्चाशेषेषु जंतुषु ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001662061, "chapter_id": 21662, "verse_number": "१-४८-६२", "content_sanskrit": "आत्मा शुद्धोऽक्षरः शांतो निर्गुणः प्रकृते परः ।\nप्रवृद्ध्यपचयौ न स्त एकस्याखिलजंतुषु ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001662062, "chapter_id": 21662, "verse_number": "१-४८-६३", "content_sanskrit": "यदा नोपचयस्तस्य नचैवापचयो नृप ।\nतदापि बालिशोऽसि त्वं कया युक्त्या त्वयेरितम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001662063, "chapter_id": 21662, "verse_number": "१-४८-६४", "content_sanskrit": "भूपादजंघाकट्यूरुजठरादिषु संस्थिता ।\nशिबिकेयं यदा स्कंधे तदा भारः समस्त्वया ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001662064, "chapter_id": 21662, "verse_number": "१-४८-६५", "content_sanskrit": "तथान्यजंतुभिर्भूप शिबिकोढान केवलम् ।\nशैलद्रुमगृहोत्थोऽपि पृथिवीसंभवोऽपि च ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001662065, "chapter_id": 21662, "verse_number": "१-४८-६६", "content_sanskrit": "यथा पुंसः पृथग्भावः प्राकृतैः करणैर्नृप ।\nसोढव्यः सुमहान्भारः कतमो नृप ते मया ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001662066, "chapter_id": 21662, "verse_number": "१-४८-६७", "content_sanskrit": "यद्द्रव्यो शिबिका चेयं तद्द्रव्यो भूतसंग्रहः ।\nभवतो मेऽखिलस्यास्य समत्वेनोपबृंहितः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001662067, "chapter_id": 21662, "verse_number": "१-४८-६८", "content_sanskrit": "सनंदन उवाच ।\nएवमुक्त्वाऽभवंन्मौनी स वहञ्शिबिकां द्विजः ।\nसोऽपि राजाऽवतीर्योर्व्यां तत्पादौ जगृहे त्वरन् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001662068, "chapter_id": 21662, "verse_number": "१-४८-६९", "content_sanskrit": "राजोवाच ।\nभो भो विसृज्य शिबिकां प्रसादं कुरु मे द्विज ।\nकथ्यतां को भवानत्र जाल्मरुपधरः स्थितः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001662069, "chapter_id": 21662, "verse_number": "१-४८-७०", "content_sanskrit": "यो भवान्यदपत्यं वा यदागमनकारणम् ।\nतत्सर्वं कथ्यतां विद्वन्मह्यं शुश्रूषवे त्वया ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001662070, "chapter_id": 21662, "verse_number": "१-४८-७१", "content_sanskrit": "ब्राह्मण उवाच ।\nश्रूयतां कोऽहमित्येतद्वक्तुं भूप न शक्यते ।\nउपयोगनिमित्तं च सर्वत्रागमनक्रिया ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001662071, "chapter_id": 21662, "verse_number": "१-४८-७२", "content_sanskrit": "सुखदुःखोपभोगौ तु तौ देहाद्युपपादकौ ।\nधर्माधर्मोद्भवौ भोक्तुं जंतुर्देहादिमृच्छति ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001662072, "chapter_id": 21662, "verse_number": "१-४८-७३", "content_sanskrit": "सर्वस्यैव हि भूपाल जंतोः सर्वत्र कारणम् ।\nधर्माधर्मौ यतस्तस्मात्कारणं पृच्छ्यते कुतः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001662073, "chapter_id": 21662, "verse_number": "१-४८-७४", "content_sanskrit": "राजोवाच ।\nधर्माधर्मौ न संदेहः सर्वकार्येषु कारणम् ।\nउपभोगनिमित्तं च देहाद्देहांतरागमः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001662074, "chapter_id": 21662, "verse_number": "१-४८-७५", "content_sanskrit": "यत्त्वेतद्भवता प्रोक्तं कोऽहमित्येतदात्मनः ।\nवक्तुं न शक्यते श्रोतुं तन्ममेच्चा प्रवर्तते ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001662075, "chapter_id": 21662, "verse_number": "१-४८-७६", "content_sanskrit": "योऽस्ति योऽहमिति ब्रह्मन्कथं वक्तुं न शक्यते ।\nआत्मन्येव न दोषाय शब्दोऽहमिति यो द्विजा ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001662076, "chapter_id": 21662, "verse_number": "१-४८-७७", "content_sanskrit": "ब्राह्मण उवाच ।\nशब्दोऽहमिति दोषाय नात्मन्येवं तथैव तत् ।\nअनात्मन्यात्मविज्ञानं शब्दो वा श्रुतिलक्षणः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001662077, "chapter_id": 21662, "verse_number": "१-४८-७८", "content_sanskrit": "जिह्वा ब्रवीत्यहमिति दंतौष्टतालुक नृप ।\nएतेनाहं यतः सर्वे वाङ्निष्पादनहेतवः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001662078, "chapter_id": 21662, "verse_number": "१-४८-७९", "content_sanskrit": "किं हेतुभिर्वदूत्येषा वागेवाहमिति स्वयम् ।\nतथापि वागहमेद्वक्तुमित्थं न युज्यते ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001662079, "chapter_id": 21662, "verse_number": "१-४८-८०", "content_sanskrit": "पिंडः पृथग्यतः पुंसः शिरःपाण्यादिलक्षणः ।\nततोऽहमिति कुत्रैनां संज्ञां राजन्करोम्यहम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001662080, "chapter_id": 21662, "verse_number": "१-४८-८१", "content_sanskrit": "यद्यन्योऽस्ति परः कोऽपि मत्तः पार्थिवसत्तम् ।\nन देहोऽहमयं चान्ये वक्तुमेवमपीष्यते ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001662081, "chapter_id": 21662, "verse_number": "१-४८-८२", "content_sanskrit": "यदा समस्तदेहेषु पुमानेको व्यवस्थितः ।\nतददा हि को भवान्कोऽहमित्येतद्विफलं वचः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001662082, "chapter_id": 21662, "verse_number": "१-४८-८३", "content_sanskrit": "त्वं राजा शिबिका चेयं वयं वाहाः पुरः सराः ।\nअयं च भवतो लोको न सदेतन्नृपोच्यते ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001662083, "chapter_id": 21662, "verse_number": "१-४८-८४", "content_sanskrit": "वृक्षाद्दारु ततश्चेयं शिबिका त्वदधिष्टिता ।\nक्व वृक्षसंज्ञा वै तस्या दारुसंज्ञाथवा नृप ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001662084, "chapter_id": 21662, "verse_number": "१-४८-८५", "content_sanskrit": "वृक्षारूढो महाराजो नायं वदति ते जनः ।\nन च दारुणि सर्वस्त्वां ब्रवीति शिबिकागतम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001662085, "chapter_id": 21662, "verse_number": "१-४८-८६", "content_sanskrit": "शिबिकादारुसंघातो स्वनामस्थितिसंस्थितः ।\nअन्विष्यतां नृपश्रेष्टानन्ददाशिबिका त्वया ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001662086, "chapter_id": 21662, "verse_number": "१-४८-८७", "content_sanskrit": "एवं छत्रं शलाकाभ्यः पृथग्भावो विमृश्यताम् ।\nक्व जातं छत्रमित्येष न्यायस्त्वयि तथा मयि ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001662087, "chapter_id": 21662, "verse_number": "१-४८-८८", "content_sanskrit": "पुमान्स्त्री गौरजा बाजी कुंजरो विहगस्तरुः ।\nदेहेषु लोकसंज्ञेयं विज्ञेया कर्महेतुषु ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001662088, "chapter_id": 21662, "verse_number": "१-४८-८९", "content_sanskrit": "पुमान्न देवो न नरो न पशुर्न च पादपः ।\nशरीराकृतिभेदास्तु भूपैते कर्मयोनयः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001662089, "chapter_id": 21662, "verse_number": "१-४८-९०", "content_sanskrit": "वस्तु राजेति यल्लेके यञ्च राजभटात्मकम् ।\nतथान्यश्च नृपेत्थं तन्न सत्यं कल्पनामयम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001662090, "chapter_id": 21662, "verse_number": "१-४८-९१", "content_sanskrit": "यस्तु कालांतरेणापि नाशसंज्ञामुपैति वै ।\nपरिणामादिसंभूतं तद्वस्तु नृप तञ्च किम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001662091, "chapter_id": 21662, "verse_number": "१-४८-९२", "content_sanskrit": "त्वं राजा सर्वसोकस्य पितुः पुत्रो रिपो रिपुः ।\nपत्न्याः पतिः पिता सूनोः कस्त्वं भूप वदाम्यहम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001662092, "chapter_id": 21662, "verse_number": "१-४८-९३", "content_sanskrit": "त्वं किमेतच्चिरः किं तु शिरस्तव तथो दरम् ।\nकिमु पादादिकं त्वेतन्नैव किं ते महीपते ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001662093, "chapter_id": 21662, "verse_number": "१-४८-९४", "content_sanskrit": "समस्तावयवेभ्यस्त्वं पृथग्भूतो व्यवस्थितः ।\nकोऽहमित्यत्र निपुणं भूत्वा चिंतय पार्थिव ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001662094, "chapter_id": 21662, "verse_number": "१-४८-९५", "content_sanskrit": "एवं व्यवस्थिते तत्त्वे मयाहमिति भावितुम् ।\nपृथकूचरणनिष्पाद्यं शक्यं तु नृपते कथम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}]