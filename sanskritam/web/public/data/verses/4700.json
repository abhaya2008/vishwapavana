[{"id": 2174046, "chapter_id": 4700, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2174047, "chapter_id": 4700, "verse_number": "१", "content_sanskrit": "दुर्योधनो महाराज सुदर्शश्चापि ते सुतः ।\nहतशेषौ तदा सङ्खे वाजिमध्ये व्यवस्थितौ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2174048, "chapter_id": 4700, "verse_number": "२", "content_sanskrit": "ततो दुर्योधनं दृष्ट्वा वाजिमध्ये व्यवस्थितम् ।\nउवाच देवकीपुत्रः कुन्तीपुत्रं धनञ्जयम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2174049, "chapter_id": 4700, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2174050, "chapter_id": 4700, "verse_number": "३", "content_sanskrit": "शत्रवो हतभूयिष्ठाः ज्ञातयः परिपालिताः ।\nगृहीत्वा सञ्जयं चासौ निवृत्तः शिनिपुङ्गवः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2174051, "chapter_id": 4700, "verse_number": "४", "content_sanskrit": "परिश्रान्तश्च नकुलः सहदेवश्च भारत ।\nयोधयित्वा रणे पापान् धार्तराष्ट्रपदानुगान्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2174052, "chapter_id": 4700, "verse_number": "५", "content_sanskrit": "सुयोधनं परित्यज्य त्रय एते व्यवस्थिताः ।\nकृपश्च कृतवर्मा च द्रौणिश्चैव महारथः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2174053, "chapter_id": 4700, "verse_number": "६", "content_sanskrit": "असौ तिष्ठति पाञ्चाल्यः श्रिया परमया युतः ।\nदुर्योधनबलं हत्वा सहसर्वैः प्रभद्रकैः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2174054, "chapter_id": 4700, "verse_number": "७", "content_sanskrit": "असौ दुर्योधनः पार्थ वाजिमध्ये व्यवस्थितः ।\nछत्रेण ध्रियमाणेन प्रेक्षमाणो मुहुर्मुहुः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2174055, "chapter_id": 4700, "verse_number": "८", "content_sanskrit": "प्रतिव्यूह्य बलं सर्वं रणमध्ये व्यवस्थितः ।\nएनं हत्वा शितैर्बाणैः कृतकृत्यो भविष्यसि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2174056, "chapter_id": 4700, "verse_number": "९", "content_sanskrit": "गजानीकं हतं दृष्ट्वा त्वां च प्राप्तमरिन्दमम् ।\nयावन्नाभ्यतिवर्तेत तावज्जहि सुयोधनम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2174057, "chapter_id": 4700, "verse_number": "१०", "content_sanskrit": "यातु कश्चित्तु पाञ्चाल्यं क्षिप्रमागम्यतामिति ।\nपरिश्रान्तबलस्तात नैष मुच्येत किल्बिषी\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2174058, "chapter_id": 4700, "verse_number": "११", "content_sanskrit": "तव हत्वा बलं सर्वं सङ्ग्रामे धृतराष्ट्रजः ।\nजितान् पाण्डुसुतान् मत्वा रूपं धारयते महत्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2174059, "chapter_id": 4700, "verse_number": "१२", "content_sanskrit": "निहतं स्वबलं दृष्ट्वा पीडितं चापि पाण्डवैः ।\nध्रुवमेष्यति सङ्ग्रामे वधायैवात्मनो नृपः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2174060, "chapter_id": 4700, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2174061, "chapter_id": 4700, "verse_number": "१३", "content_sanskrit": "एवमुक्तः फल्गुनस्तु कष्णं वचनमब्रवीत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2174062, "chapter_id": 4700, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2174063, "chapter_id": 4700, "verse_number": "१४", "content_sanskrit": "धृतराष्ट्रसुताः सर्वे हता भीमेन मानद\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2174064, "chapter_id": 4700, "verse_number": "१५", "content_sanskrit": "यावेतावस्थितौ कृष्ण तावद्य न भविष्यतः ।\nहतो भीष्मो हतो द्रोणः कर्णो वैकर्तनो हतः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2174065, "chapter_id": 4700, "verse_number": "१६", "content_sanskrit": "मद्रराजो हतः शल्यो हतः कृष्णजयद्रथः ।\nहयाः पञ्चशताः शिष्टाः शकुनेः सौबलस्य च\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2174066, "chapter_id": 4700, "verse_number": "१७", "content_sanskrit": "रथानां च शते शिष्टे द्वे एव तु जनार्दन ।\nदन्तिनां च शतं साग्रं त्रिसहस्रं च पत्तयः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2174067, "chapter_id": 4700, "verse_number": "१८", "content_sanskrit": "अश्वत्थामा कृपश्चैव त्रिगर्ताधिपतिस्तथा ।\nउलूकः शकुनिश्चैव कृतवर्मा च सात्वतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2174068, "chapter_id": 4700, "verse_number": "१९", "content_sanskrit": "एतद् बलमभूच्छेषं धार्तराष्ट्रस्य माधव ।\nमोक्षो न नूनं कालाद्धि विद्यते भुवि कस्यचित्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2174069, "chapter_id": 4700, "verse_number": "२०", "content_sanskrit": "तथा विनिहते सैन्ये पश्य दुर्योधनं स्थितम् ।\nअद्याह्ना हि महाराजो हतामित्रो भविष्यति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2174070, "chapter_id": 4700, "verse_number": "२१", "content_sanskrit": "न हि मे मोक्ष्यते कश्चित् परेषामिति निश्चयः ।\nये त्वद्य समरं कृष्ण न हास्यन्ति रणोत्कटाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2174071, "chapter_id": 4700, "verse_number": "२२", "content_sanskrit": "तान् वै सर्वान् हनिष्यामि यद्यपि स्युरमानुषाः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2174072, "chapter_id": 4700, "verse_number": "२३", "content_sanskrit": "अद्य युद्धे समुन्नद्धं दीर्घं राज्ञः प्रजागरम् ।\nअपनेष्यामि गान्धारं पातयित्वा शितैः शरैः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2174073, "chapter_id": 4700, "verse_number": "२४", "content_sanskrit": "निकृत्या वै दुराचारो यानि रत्नानि सौबलः ।\nसभायामाहरद् द्यूते पुनस्तान्याहराम्यहम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2174074, "chapter_id": 4700, "verse_number": "२५", "content_sanskrit": "अद्य वेत्स्यन्ति मच्छक्तिं सर्वा नागपुरस्त्रियः ।\nश्रुत्वा पतींश्च पुत्रांश्च पाण्डवैर्निहतान् युधि\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2174075, "chapter_id": 4700, "verse_number": "२६", "content_sanskrit": "समाप्तमद्य वै कृष्णः सर्वं कर्म भविष्यति\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2174076, "chapter_id": 4700, "verse_number": "२७", "content_sanskrit": "अद्य दुर्योधनो दीप्तां श्रियं प्राणानपि त्यजेत् ।\nनापयाति भयात् कृष्ण सङ्ग्रामाद् यदि चेन्मम\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2174077, "chapter_id": 4700, "verse_number": "२८", "content_sanskrit": "निहतं विद्धि वार्ष्णेय धार्तराष्ट्रं सुबालिशम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2174078, "chapter_id": 4700, "verse_number": "२९", "content_sanskrit": "मम ह्येतदपर्याप्तं वाजिबृन्दमरिन्दम ।\nसोढुं ज्यातळनिर्घोषान् याहि यावन्निहन्म्यहम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2174079, "chapter_id": 4700, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2174080, "chapter_id": 4700, "verse_number": "३०", "content_sanskrit": "एवमुक्तस्तु दाशार्हः पाण्डवेन यशस्विना ।\nअचोदयद् हयान् राजन् दुर्योधनबलं प्रति\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2174081, "chapter_id": 4700, "verse_number": "३१", "content_sanskrit": "तदनीकमभिप्रेक्ष्य त्रयः सज्जा महारथाः ।\nभीमसेनोऽर्जुनश्चैव सहदेवश्च मारिष\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2174082, "chapter_id": 4700, "verse_number": "३२", "content_sanskrit": "प्रययुः सिंहनादेन दुर्योधनजिघांसया\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2174083, "chapter_id": 4700, "verse_number": "३३", "content_sanskrit": "तान् समीक्ष्य ततः सर्वान् जवेनोद्यतकार्मुकान् ।\nसौबलोऽभ्यद्रवद् युद्धे पाण्डवानाततायिनः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2174084, "chapter_id": 4700, "verse_number": "३४", "content_sanskrit": "सुदर्शनस्तव सुतो भीमसेनं समभ्ययात् ।\nसुशर्मा शकुनिश्चैव युयुधाते किरीटिना\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2174085, "chapter_id": 4700, "verse_number": "३५", "content_sanskrit": "सहदेवं तव सुतो हयपृष्ठगतोऽभ्ययात्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2174086, "chapter_id": 4700, "verse_number": "३६", "content_sanskrit": "ततोऽभ्यापततः क्षिप्रं तव पुत्रो जनाधिप ।\nसहदेवस्य शिरसि प्रासेन प्राहरद् भृशम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2174087, "chapter_id": 4700, "verse_number": "३७", "content_sanskrit": "सोपाविशद् रथोपस्थो तव पुत्रेण घातितः ।\nरुधिराप्लुतसर्वाङ्गो आशीविष इव श्वसन्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2174088, "chapter_id": 4700, "verse_number": "३८", "content_sanskrit": "प्रतिलभ्य ततः सञ्ज्ञां सहदेवो विशाम्पते ।\nदुर्योधनं शरैस्तीक्ष्णैः सङ्क्रुद्धः समवाकिरत्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2174089, "chapter_id": 4700, "verse_number": "३९", "content_sanskrit": "पार्थोऽपि युधि विक्रम्य कुन्तीपुत्रो धनञ्जयः ।\nशूराणामश्वपृष्ठेभ्यः शिरांसि निचकर्त ह\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2174090, "chapter_id": 4700, "verse_number": "४०", "content_sanskrit": "तदनीकं तदा पार्थो व्यधमद् बहुभिः शरैः ।\nपातयित्वा हयान् सर्वाः त्रिगर्तानां रथान्ययौ\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2174091, "chapter_id": 4700, "verse_number": "४१", "content_sanskrit": "ततस्ते सहिताः सर्वे त्रिगर्तानां महारथाः ।\nअर्जुनं वासुदेवं च शरवर्षैरवाकिरन्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2174092, "chapter_id": 4700, "verse_number": "४२", "content_sanskrit": "सत्यकर्माणमाक्षिप्य क्षुरप्रेण महायशाः ।\nततोऽस्य स्यन्दनस्यैषां चिच्छेद पाण्डुनन्दनः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2174093, "chapter_id": 4700, "verse_number": "४३", "content_sanskrit": "शिलाशितेन च विभो क्षुरप्रेण महारथः ।\nशिरश्चिच्छेद सहसा तप्तकुण्डलभूषितम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2174094, "chapter_id": 4700, "verse_number": "४४", "content_sanskrit": "अन्येषुमथ चादत्त योधानां मिषतां ततः ।\nयथा सिंहो वने राजन् मृगान् प्रति बुभुक्षितः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2174095, "chapter_id": 4700, "verse_number": "४५", "content_sanskrit": "तं निहत्य ततः पार्थः सुशर्माणं त्रिभिः शरैः ।\nविद्ध्वा च न्यहनत् सर्वान् रथान् रुग्मविभूषितान्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2174096, "chapter_id": 4700, "verse_number": "४६", "content_sanskrit": "ततस्तु प्रवरः पार्थो दीर्घकालसुसम्भृतम् ।\nमुञ्चन् क्रोधविषं तीव्रं त्रिगर्ताधिपतिं प्रति\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2174097, "chapter_id": 4700, "verse_number": "४७", "content_sanskrit": "तमर्जुनः पृषत्कानां शतेन नतपर्वणाम् ।\nपूरयित्वा ततो वाहान् न्यहनत् तत्र धन्विनः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2174098, "chapter_id": 4700, "verse_number": "४८", "content_sanskrit": "ततः शरं समादाय यमदण्डोपमं महत् ।\nसुशर्माणं समुद्दिश्य चिक्षेपाशु हसन्निव\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2174099, "chapter_id": 4700, "verse_number": "४९", "content_sanskrit": "स शरः प्रेषितस्तेन क्रोधदीप्तेन धन्विना ।\nसुशर्माणं समासाद्य बिभेद हृदयं रणे\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2174100, "chapter_id": 4700, "verse_number": "५०", "content_sanskrit": "स गतासुर्महाराज निपपात महीतळे ।\nनन्दयन् पाण्डवान् सर्वान् व्यथयंश्चैव तावकान्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2174101, "chapter_id": 4700, "verse_number": "५१", "content_sanskrit": "सुशर्माणं रणे हत्वा पुत्रानस्य महारथान् ।\nसप्त चाष्टौ च दश च सायकैरनयत् क्षयम्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2174102, "chapter_id": 4700, "verse_number": "५२", "content_sanskrit": "ततोऽस्य निशितैर्बाणैः सर्वान् हत्वा पदानुगान् ।\nअगच्छत् भारतीं सेनां हतशेषान् महारथान्\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2174103, "chapter_id": 4700, "verse_number": "५३", "content_sanskrit": "भीमस्तु समरे क्रुद्धः पुत्रं तव जनाधिप ।\nसुदर्शनमदृश्यन्तु शरैश्चक्रे हसन्निव\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2174104, "chapter_id": 4700, "verse_number": "५४", "content_sanskrit": "ततोऽस्य प्रहसन् क्रुद्धः शिरः कायादपाहरत् ।\nक्षुरप्रेण सुतीक्ष्णेन स हतः प्रापतद् भुवि\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2174105, "chapter_id": 4700, "verse_number": "५५", "content_sanskrit": "तस्मिंस्तु निहते वीरे ततस्तस्य पदानुगाः ।\nपरिवव्रू रणे भीमं किरन्तो विशिखान् शितान्\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2174106, "chapter_id": 4700, "verse_number": "५६", "content_sanskrit": "ततस्तु निशितैर्बाणैः तदनीकं वृकोदरः ।\nइन्द्राशनिसमस्पर्शैः समन्तात् पर्यवाकिरत्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2174107, "chapter_id": 4700, "verse_number": "५७", "content_sanskrit": "ततः क्षणेन तान् भीमो न्यहनद् भरतर्षभ\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2174108, "chapter_id": 4700, "verse_number": "५८", "content_sanskrit": "तेषु तूत्साद्यमानेषु सेनाध्यक्षा महाबलाः ।\nभीमसेनं समासाद्य ततोऽयुध्यन्त भारत\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2174109, "chapter_id": 4700, "verse_number": "५९", "content_sanskrit": "तांस्तु सर्वान् शरैर्घोरैरवाकिरत पाण्डवः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2174110, "chapter_id": 4700, "verse_number": "६०", "content_sanskrit": "तथैव तावका राजन् पाण्डवेयान् महारथान् ।\nशरवर्षेण महता समन्तात् पर्यवारयन्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2174111, "chapter_id": 4700, "verse_number": "६१", "content_sanskrit": "व्याकुलं तदभूत् सर्वं पाण्डवानां परैः सह ।\nतावकानां च समरे पाण्डवेयैर्युयुत्सताम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2174112, "chapter_id": 4700, "verse_number": "६२", "content_sanskrit": "तत्र योधास्तदा पेतुः परस्परसमाहताः ।\nउभयोः सेनयो राजन् संशोचन्ति स्म बान्धवान्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2174113, "chapter_id": 4700, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि सुशर्मवधो नाम सप्तविंशोऽध्यायः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2174114, "chapter_id": 4700, "verse_number": "", "content_sanskrit": "शल्यवधपर्वणि सप्तविंशोऽध्यायः ॥२७॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]