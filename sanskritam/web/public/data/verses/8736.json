[{"id": 900009246, "chapter_id": 8736, "verse_number": "26.1", "content_sanskrit": "यदुक्तं मणौ राजपुरुष इत्यादितत्पुरुषे राजपदस्य ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009247, "chapter_id": 8736, "verse_number": "26.2", "content_sanskrit": "यच्चोक्तं मणौ– चित्रगुमानयेत्यादिबहुव्रीहौ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009248, "chapter_id": 8736, "verse_number": "26.3", "content_sanskrit": "यच्चोक्तं मणौ– नीलोत्पलमिति कर्मधारये ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009249, "chapter_id": 8736, "verse_number": "26.4", "content_sanskrit": "यच्चोक्तं मणौ– ‘‘संसर्गाभावरूपे प्रसज्यप्रतिषेधे नञः शक्तिः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900009250, "chapter_id": 8736, "verse_number": "26.5", "content_sanskrit": "एवं द्वन्द्वेपि न लक्षणा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}]