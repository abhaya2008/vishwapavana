[{"id": 7001488000, "chapter_id": 21488, "verse_number": "७-२-२६-१", "content_sanskrit": "उपमन्युरुवाच ।\nब्रह्मघ्नो वा सुरापो वा स्तेयीवा गुरुतल्पगः ।\nमातृहा पितृहा वापि वीरहा भ्रूणहापि वा॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001488001, "chapter_id": 21488, "verse_number": "७-२-२६-२", "content_sanskrit": "संपूज्यामन्त्रकं भक्त्या शिवं परमकारणम् ।\nतैस्तैः पापैः प्रमुच्येत वर्षैर्द्वादशभिः क्रमात्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001488002, "chapter_id": 21488, "verse_number": "७-२-२६-३", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन पतितो ऽपि यजेच्छिवम् ।\nभक्तश्चेन्नापरः कश्चिद्भिक्षाहारो जितेंद्रियः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001488003, "chapter_id": 21488, "verse_number": "७-२-२६-४", "content_sanskrit": "कृत्वापि सुमहत्पापं भक्त्या पञ्चाक्षरेण तु ।\nपूजयेद्यदि देवेशं तस्मात्पापात्प्रमुच्यते॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001488004, "chapter_id": 21488, "verse_number": "७-२-२६-५", "content_sanskrit": "अब्भक्षा वायुभक्षाश्च ये चान्ये व्रतकर्शिताः ।\nतेषामेतैर्व्रतैर्नास्ति शिवलोकसमागमः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001488005, "chapter_id": 21488, "verse_number": "७-२-२६-६", "content_sanskrit": "भक्त्या पञ्चाक्षरेणैव यः शिवं सकृदर्चयेत् ।\nसोपि गच्छेच्छिवस्थानं शिवमन्त्रस्य गौरवात्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001488006, "chapter_id": 21488, "verse_number": "७-२-२६-७", "content_sanskrit": "तस्मात्तपांसि यज्ञांश्च सर्वे सर्वस्वदक्षिणाः ।\nशिवमूर्त्यर्चनस्यैते कोट्यंशेनापि नो समाः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001488007, "chapter_id": 21488, "verse_number": "७-२-२६-८", "content_sanskrit": "बद्धो वाप्यथ मुक्तो वा पश्चात्पञ्चाक्षरेण चेत् ।\nपूजयन्मुच्यते भक्तो नात्र कार्या विचारणा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001488008, "chapter_id": 21488, "verse_number": "७-२-२६-९", "content_sanskrit": "अरुद्रो वा सरुद्रो वा सूक्तेन शिवमर्चयेत् ।\nयः सकृत्पतितो वापिमूढो वा मुच्यते नरः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001488009, "chapter_id": 21488, "verse_number": "७-२-२६-१०", "content_sanskrit": "षडक्षरेण वा देवं सूक्तमन्त्रेण पूजयेत् ।\nशिवभक्तो जितक्रोधो ह्यलब्धो लब्ध एव च॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001488010, "chapter_id": 21488, "verse_number": "७-२-२६-११", "content_sanskrit": "अलब्धाल्लब्ध एवात्र विशिष्टो नात्र संशयः ।\nस ब्रह्मांगेन वा तेन सहंसेन विमुच्यते॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001488011, "chapter_id": 21488, "verse_number": "७-२-२६-१२", "content_sanskrit": "तस्मान्नित्यं शिवं भक्त्या सूक्तमन्त्रेण पूजयेत् ।\nएककालं द्विकालं वा त्रिकालं नित्यमेव वा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001488012, "chapter_id": 21488, "verse_number": "७-२-२६-१३", "content_sanskrit": "ये ऽर्चयंति महादेवं विज्ञेयास्ते महेश्वराः ।\nज्ञानेनात्मसहायेन नार्चितो भगवाञ्छिवः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001488013, "chapter_id": 21488, "verse_number": "७-२-२६-१४", "content_sanskrit": "स चिरं संसरत्यस्मिन्संसारे दुःखसागरे ।\nदुर्ल्लभं प्राप्य मानुष्यं मूढो नार्चयते शिवम्॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001488014, "chapter_id": 21488, "verse_number": "७-२-२६-१५", "content_sanskrit": "निष्फलं तस्य तज्जन्म मोक्षाय न भवेद्यतः ।\nदुर्ल्लभं प्राप्य मानुष्यं ये ऽर्चयन्ति पिनाकिनम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001488015, "chapter_id": 21488, "verse_number": "७-२-२६-१६", "content_sanskrit": "तेषां हि सफलं जन्म कृतार्थास्ते नरोत्तमाः ।\nभवभक्तिपरा ये च भवप्रणतचेतसः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001488016, "chapter_id": 21488, "verse_number": "७-२-२६-१७", "content_sanskrit": "भवसंस्मरणोद्युक्ता न ते दुःखस्य भागिनः ।\nभवनानि मनोज्ञानि विभ्रमाभरणाः स्त्रियः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001488017, "chapter_id": 21488, "verse_number": "७-२-२६-१८", "content_sanskrit": "धनं चातृप्तिपर्यन्तं शिवपूजाविधेः फलम् ।\nये वाञ्छन्ति महाभोगान्राज्यं च त्रिदशालये॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001488018, "chapter_id": 21488, "verse_number": "७-२-२६-१९", "content_sanskrit": "ते वाञ्छन्ति सदाकालं हरस्य चरणाम्बुजम् ।\nसौभाग्यं कान्तिमद्रूपं सत्त्वं त्यागार्द्रभावता॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001488019, "chapter_id": 21488, "verse_number": "७-२-२६-२०", "content_sanskrit": "शौर्यं वै जगति ख्यातिश्शिवमर्चयतो भवेत् ।\nतस्मात्सर्वं परित्यज्य शिवैकाहितमानसः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001488020, "chapter_id": 21488, "verse_number": "७-२-२६-२१", "content_sanskrit": "शिवपूजाविधिं कुर्याद्यदीच्छेच्छिवमात्मनः ।\nत्वरितं जीवितं याति त्वरितं याति यौवनम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001488021, "chapter_id": 21488, "verse_number": "७-२-२६-२२", "content_sanskrit": "त्वरितं व्याधिरभ्येति तस्मात्पूज्यः पिनाकधृक् ।\nयावन्नायाति मरणं यावन्नाक्रमते जरा॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001488022, "chapter_id": 21488, "verse_number": "७-२-२६-२३", "content_sanskrit": "यावन्नेन्द्रियवैकल्यं तावत्पूजय शंकरम् ।\nन शिवार्चनतुल्यो ऽस्ति धर्मो ऽन्यो भुवनत्रये॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001488023, "chapter_id": 21488, "verse_number": "७-२-२६-२४", "content_sanskrit": "इति विज्ञाय यत्नेन पूजनीयस्सदाशिवः ।\nद्वारयागं जवनिकां परिवारबलिक्रियाम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001488024, "chapter_id": 21488, "verse_number": "७-२-२६-२५", "content_sanskrit": "नित्योत्सवं च कुर्वीत प्रसादे यदि पूजयेत् ।\nहविर्निवेदनादूर्ध्वं स्वयं चानुचरो ऽपि वा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001488025, "chapter_id": 21488, "verse_number": "७-२-२६-२६", "content_sanskrit": "प्रसादपरिवारेभ्यो बलिं दद्याद्यथाक्रमम् ।\nनिर्गम्य सह वादित्रैस्तदाशाभिमुखः स्थितः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001488026, "chapter_id": 21488, "verse_number": "७-२-२६-२७", "content_sanskrit": "पुष्पं धूपं च दीपञ्च दद्यादन्नं जलैः सह ।\nततो दद्यान्महापीठे तिष्ठन्बलिमुदङ्मुखः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001488027, "chapter_id": 21488, "verse_number": "७-२-२६-२८", "content_sanskrit": "ततो निवेदितं देवे यत्तदन्नादिकं पुरा ।\nतत्सर्वं सावशेषं वा चण्डाय विनिवेदयेत्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001488028, "chapter_id": 21488, "verse_number": "७-२-२६-२९", "content_sanskrit": "हुत्वा च विधिवत्पश्चात्पूजाशेषं समापयेत् ।\nकृत्वा प्रयोगं विधिवद्यावन्मन्त्रं जपं ततः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001488029, "chapter_id": 21488, "verse_number": "७-२-२६-३०", "content_sanskrit": "नित्योत्सवं प्रकुर्वीत यथोक्तं शिवशासने ।\nविपुले तैजसे पात्रे रक्तपद्मोपशोभिते॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001488030, "chapter_id": 21488, "verse_number": "७-२-२६-३१", "content_sanskrit": "अस्त्रं पाशुपतं दिव्यं तत्रावाह्य समर्चयेत् ।\nशिवस्यारोप्यः तत्पात्रं द्विजस्यालंकृतस्य च॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001488031, "chapter_id": 21488, "verse_number": "७-२-२६-३२", "content_sanskrit": "न्यस्तास्त्रवपुषा तेन दीप्तयष्टिधरस्य च ।\nप्रासादपरिवारेभ्यो बहिर्मंगलनिःस्वनैः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001488032, "chapter_id": 21488, "verse_number": "७-२-२६-३३", "content_sanskrit": "नृत्यगेयादिभिश्चैव सह दीपध्वजादिभिः ।\nप्रदक्षिणत्रयं कृत्वा न द्रुतं चाविलम्बितम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001488033, "chapter_id": 21488, "verse_number": "७-२-२६-३४", "content_sanskrit": "महापीठं समावृत्य त्रिःप्रदक्षिणयोगतः ।\nपुनः प्रविष्टो द्वारस्थो यजमानः कृताञ्जलिः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001488034, "chapter_id": 21488, "verse_number": "७-२-२६-३५", "content_sanskrit": "आदायाभ्यंतरं नीत्वा ह्यस्त्रमुद्वासयेत्ततः ।\nप्रदक्षिणादिकं कृत्वा यथापूर्वोदितं क्रमात्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001488035, "chapter_id": 21488, "verse_number": "७-२-२६-३६", "content_sanskrit": "आदाय चाष्टपुष्पाणि पूजामथ समापयेत्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]