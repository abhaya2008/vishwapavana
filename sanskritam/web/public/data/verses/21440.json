[{"id": 7001440000, "chapter_id": 21440, "verse_number": "७-१-१३-१", "content_sanskrit": "ऋषय ऊचुः ।\nभवता कथिता सृष्टिर्भवस्य परमात्मनः ।\nचतुर्मुखमुखात्तस्य संशयो नः प्रजायते॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001440001, "chapter_id": 21440, "verse_number": "७-१-१३-२", "content_sanskrit": "देवश्रेष्ठो विरूपाक्षो दीप्तश्शूलधरो हरः ।\nकालात्मा भगवान् रुद्रः कपर्दी नीललोहितः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001440002, "chapter_id": 21440, "verse_number": "७-१-१३-३", "content_sanskrit": "सब्रह्मकमिमं लोकं सविष्णुमपि पावकम् ।\nयः संहरति संक्रुद्धो युगांते समुपस्थिते॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001440003, "chapter_id": 21440, "verse_number": "७-१-१३-४", "content_sanskrit": "यस्य ब्रह्मा च विष्णुश्च प्रणामं कुरुतो भयात् ।\nलोकसंकोचकस्यास्य यस्य तौ वशवर्तिनौ॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001440004, "chapter_id": 21440, "verse_number": "७-१-१३-५", "content_sanskrit": "यो ऽयं देवः स्वकादंगाद्ब्रह्मविष्णू पुरासृजत् ।\nस एव हि तयोर्नित्यं योगक्षेमकरः प्रभुः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001440005, "chapter_id": 21440, "verse_number": "७-१-१३-६", "content_sanskrit": "स कथं भगवान् रुद्र आदिदेवः पुरातनः ।\nपुत्रत्वमगमच्छंभुर्ब्रह्मणो ऽव्यक्तजन्मनः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001440006, "chapter_id": 21440, "verse_number": "७-१-१३-७", "content_sanskrit": "प्रजापतिश्च विष्णुश्च रुद्रस्यैतौ परस्परम् ।\nसृष्टौ परस्परस्यांगादिति प्रागपि शुश्रुम॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001440007, "chapter_id": 21440, "verse_number": "७-१-१३-८", "content_sanskrit": "कथं पुनरशेषाणां भूतानां हेतुभूतयोः ।\nगुणप्रधानभावेन प्रादुर्भावः परस्परात्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001440008, "chapter_id": 21440, "verse_number": "७-१-१३-९", "content_sanskrit": "नापृष्टं भवता किंचिन्नाश्रुतं च कथंचन ।\nभगवच्छिष्यभूतेन भवता सकलं स्मृतम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001440009, "chapter_id": 21440, "verse_number": "७-१-१३-१०", "content_sanskrit": "तत्त्वं वद यथा ब्रह्मा मुनीनामवदद्विभुः ।\nवयं श्रद्धालवस्तात श्रोतुमीश्वरसद्यशः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001440010, "chapter_id": 21440, "verse_number": "७-१-१३-११", "content_sanskrit": "वायुरुवाच ।\nस्थाने पृष्टमिदं विप्रा भवद्भिः प्रश्नकोविदैः ।\nइदमेव पुरा पृष्टो मम प्राह पितामहः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001440011, "chapter_id": 21440, "verse_number": "७-१-१३-१२", "content_sanskrit": "तदहं सम्प्रवक्ष्यामि यथा रुद्रसमुद्भवः ।\nयथा च पुनरुत्पत्तिर्ब्रह्मविष्ण्वोः परस्परम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001440012, "chapter_id": 21440, "verse_number": "७-१-१३-१३", "content_sanskrit": "त्रयस्ते कारणात्मानो जतास्साक्षान्महेश्वरात् ।\nचराचरस्य विश्वस्य सर्गस्थित्यंतहेतवः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001440013, "chapter_id": 21440, "verse_number": "७-१-१३-१४", "content_sanskrit": "परमैश्वर्यसंयुक्ताः परमेश्वरभाविताः ।\nतच्छक्त्याधिष्ठिता नित्यं तत्कार्यकरणक्षमाः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001440014, "chapter_id": 21440, "verse_number": "७-१-१३-१५", "content_sanskrit": "पित्रा नियमिताः पूर्वं त्रयोपि त्रिषु कर्मसु ।\nब्रह्मा सर्गे हरिस्त्राणे रुद्रः संहरणे तथा॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001440015, "chapter_id": 21440, "verse_number": "७-१-१३-१६", "content_sanskrit": "तथाप्यन्योन्यमात्सर्यादन्योन्यातिशयाशिनः ।\nतपसा तोषयित्वा स्वं पितरं परमेश्वरम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001440016, "chapter_id": 21440, "verse_number": "७-१-१३-१७", "content_sanskrit": "लब्ध्वा सर्वात्मना तस्य प्रसादात्परमेष्ठिनः ।\nब्रह्मनारायणौ पूर्वं रुद्रः कल्पान्तरे ऽसृजत्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001440017, "chapter_id": 21440, "verse_number": "७-१-१३-१८", "content_sanskrit": "कल्पान्तरे पुनर्ब्रह्मा रुद्रविष्णू जगन्मयः ।\nविष्णुश्च भगवान्रुद्रं ब्रह्माणमसृजत्पुनः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001440018, "chapter_id": 21440, "verse_number": "७-१-१३-१९", "content_sanskrit": "नारायणं पुनर्ब्रह्मा ब्रह्माणमसृजत्पुनः ।\nएवं कल्पेषु कल्पेषु ब्रह्मविष्णुमहेश्वराः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001440019, "chapter_id": 21440, "verse_number": "७-१-१३-२०", "content_sanskrit": "परस्परेण जायंते परस्परहितैषिणः ।\nतत्तत्कल्पान्तवृत्तान्तमधिकृत्य महर्षिभिः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001440020, "chapter_id": 21440, "verse_number": "७-१-१३-२१", "content_sanskrit": "प्रभावः कथ्यते तेषां परस्परसमुद्भवात् ।\nशृणु तेषां कथां चित्रां पुण्यां पापप्रमोचिनीम्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001440021, "chapter_id": 21440, "verse_number": "७-१-१३-२२", "content_sanskrit": "कल्पे तत्पुरुषे वृत्तां ब्रह्मणः परमेष्ठिनः ।\nपुरा नारायणो नाम कल्पे वै मेघवाहने॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001440022, "chapter_id": 21440, "verse_number": "७-१-१३-२३", "content_sanskrit": "दिव्यं वर्षसहस्रं तु मेघो भूत्वावहद्धराम् ।\nतस्य भावं समालक्ष्य विष्णोर्विश्वजगद्गुरुः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001440023, "chapter_id": 21440, "verse_number": "७-१-१३-२४", "content_sanskrit": "सर्वस्सर्वात्मभावेन प्रददौ शक्तिमव्ययाम् ।\nशक्तिं लब्ध्वा तु सर्वात्मा शिवात्सर्वेश्वरात्तदा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001440024, "chapter_id": 21440, "verse_number": "७-१-१३-२५", "content_sanskrit": "ससर्ज भगावन् विष्णुर्विश्वं विश्वसृजा सह ।\nविष्णोस्तद्वैभवं दृष्ट्वा सृष्टस्तेन पितामहः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001440025, "chapter_id": 21440, "verse_number": "७-१-१३-२६", "content_sanskrit": "ईर्ष्यया परया ग्रस्तः प्रहसन्निदमब्रवीत् ।\nगच्छ विष्णो मया ज्ञातं तव सर्गस्य कारणम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001440026, "chapter_id": 21440, "verse_number": "७-१-१३-२७", "content_sanskrit": "आवयोरधिकश्चास्ति स रुद्रो नात्र संशयः ।\nतस्य देवाधिदेवस्य प्रसादात्परमेष्ठिनः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001440027, "chapter_id": 21440, "verse_number": "७-१-१३-२८", "content_sanskrit": "स्रष्टा त्वं भगवानाद्यः पालकः परमार्थतः ।\nअहं च तपसाराध्य रुद्रं त्रिदशनायकम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001440028, "chapter_id": 21440, "verse_number": "७-१-१३-२९", "content_sanskrit": "त्वया सह जगत्सर्वं स्रक्ष्याम्यत्र न संशयः ।\nएवं विष्णुमुपालभ्य भगवानब्जसम्भवः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001440029, "chapter_id": 21440, "verse_number": "७-१-१३-३०", "content_sanskrit": "एवं विज्ञापयामास तपसा प्राप्य शंकरम् ।\nभगवन् देवदेवेश विश्वेश्वर महेश्वर॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001440030, "chapter_id": 21440, "verse_number": "७-१-१३-३१", "content_sanskrit": "तव वामांगजो विष्णुर्दक्षिणांगभवो ह्यहम् ।\nमया सह जगत्सर्वं तथाप्यसृजदच्युतः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001440031, "chapter_id": 21440, "verse_number": "७-१-१३-३२", "content_sanskrit": "स मत्सरादुपालब्धस्त्वदाश्रयबलान्मया ।\nमद्भावान्नाधिकस्तेति भावस्त्वयि महेश्वरे॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001440032, "chapter_id": 21440, "verse_number": "७-१-१३-३३", "content_sanskrit": "त्वत्त एव समुत्पत्तिरावयोस्सदृशी यतः ।\nतस्य भक्त्या यथापूर्वं प्रसादं कृतवानसि॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001440033, "chapter_id": 21440, "verse_number": "७-१-१३-३४", "content_sanskrit": "तथा ममापि तत्सर्वं दातुमर्हसि शंकर ।\nइति विज्ञापितस्तेन भगवान् भगनेत्रहा॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001440034, "chapter_id": 21440, "verse_number": "७-१-१३-३५", "content_sanskrit": "न्यायेन वै ददौ सर्वं तस्यापि स घृणानिधिः ।\nलब्ध्वैवमीश्वरादेव ब्रह्मा सर्वात्मतां क्षणात्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001440035, "chapter_id": 21440, "verse_number": "७-१-१३-३६", "content_sanskrit": "त्वरमाणोथ संगम्य ददर्श पुरुषोत्तमम् ।\nक्षीरार्णवालये शुभ्रे विमाने सूर्यसंनिभे॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001440036, "chapter_id": 21440, "verse_number": "७-१-१३-३७", "content_sanskrit": "हेमरत्नान्विते दिव्ये मनसा तेन निर्मिते ।\nअनंतभोगशय्यायां शयानं पंकजेक्षणम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001440037, "chapter_id": 21440, "verse_number": "७-१-१३-३८", "content_sanskrit": "चतुर्भुजमुदारांगं सर्वाभरणभूषितम् ।\nशंखचक्रधरं सौम्यं चन्द्रबिंबसमाननम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001440038, "chapter_id": 21440, "verse_number": "७-१-१३-३९", "content_sanskrit": "श्रीवत्सवक्षसं देवं प्रसन्नमधुरस्मितम् ।\nधरामृदुकरांभोजस्पर्शरक्तपदांबुजम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001440039, "chapter_id": 21440, "verse_number": "७-१-१३-४०", "content_sanskrit": "क्षीरार्णवामृतमिव शयानं योगनिद्रया ।\nतमसा कालरुद्राख्यं रजसा कनकांडजम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001440040, "chapter_id": 21440, "verse_number": "७-१-१३-४१", "content_sanskrit": "सत्त्वेन सर्वगं विष्णुं निर्गुणत्वे महेश्वरम् ।\nतं दृष्ट्वा पुरुषं ब्रह्मा प्रगल्भमिदमब्रवीत्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001440041, "chapter_id": 21440, "verse_number": "७-१-१३-४२", "content_sanskrit": "ग्रसामि त्वामहं विष्णो त्वमात्मानं यथा पुरा ।\nतस्य तद्वचनं श्रुत्वा प्रतिबुद्ध्य पितामहम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001440042, "chapter_id": 21440, "verse_number": "७-१-१३-४३", "content_sanskrit": "उदैक्षत महाबाहुस्स्मितमीषच्चकार च ।\nतस्मिन्नवसरे विष्णुर्ग्रस्तस्तेन महात्मना॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001440043, "chapter_id": 21440, "verse_number": "७-१-१३-४४", "content_sanskrit": "सृष्टश्च ब्रह्मणा सद्यो भ्रुवोर्मध्यादयत्नतः ।\nतस्मिन्नवसरे साक्षाद्भगवानिन्दुभूषणः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001440044, "chapter_id": 21440, "verse_number": "७-१-१३-४५", "content_sanskrit": "शक्तिं तयोरपि द्रष्टुमरूपो रूपमास्थितः ।\nप्रसादमतुलं कर्तुं पुरा दत्तवरस्तयोः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001440045, "chapter_id": 21440, "verse_number": "७-१-१३-४६", "content_sanskrit": "आगच्छत्तत्र यत्रेमौ ब्रह्मनारायणौ स्थितौ ।\nअथ तुष्टुवतुर्देवं प्रीतौ भीतौ च कौतुकात्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001440046, "chapter_id": 21440, "verse_number": "७-१-१३-४७", "content_sanskrit": "प्रणेमतुश्च बहुशो बहुमानेन दूरतः ।\nभवोपि भगवानेतावनुगृह्य पिनाकधृक्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001440047, "chapter_id": 21440, "verse_number": "७-१-१३-४८", "content_sanskrit": "सादरं पश्यतोरेव तयोरंतरधीयत॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]