[{"id": 5000289000, "chapter_id": 9289, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे किष्किन्धाकाण्डे सप्तदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000289001, "chapter_id": 9289, "verse_number": "४-१७-१", "content_sanskrit": "ततः शरेणाभिहतो रामेण रणकर्कशः।\nपपात सहसा वाली निकृत्त इव पादपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000289002, "chapter_id": 9289, "verse_number": "४-१७-२", "content_sanskrit": "स भूमौ न्यस्तसर्वाङ्गस्तप्तकाञ्चनभूषणः।\nअपतद् देवराजस्य मुक्तरश्मिरिव ध्वजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000289003, "chapter_id": 9289, "verse_number": "४-१७-३", "content_sanskrit": "अस्मिन् निपतिते भूमौ हर्यृक्षाणां गणेश्वरे।\nनष्टचन्द्रमिव व्योम न व्यराजत मेदिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000289004, "chapter_id": 9289, "verse_number": "४-१७-४", "content_sanskrit": "भूमौ निपतितस्यापि तस्य देहं महात्मनः।\nन श्रीर्जहाति न प्राणा न तेजो न पराक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000289005, "chapter_id": 9289, "verse_number": "४-१७-५", "content_sanskrit": "शक्रदत्ता वरा माला काञ्चनी रत्नभूषिता।\nदधार हरिमुख्यस्य प्राणांस्तेजः श्रियं च सा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000289006, "chapter_id": 9289, "verse_number": "४-१७-६", "content_sanskrit": "स तया मालया वीरो हैमया हरियूथपः।\nसंध्यानुगतपर्यन्तः पयोधर इवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000289007, "chapter_id": 9289, "verse_number": "४-१७-७", "content_sanskrit": "तस्य माला च देहश्च मर्मघाती च यः शरः।\nत्रिधेव रचिता लक्ष्मीः पतितस्यापि शोभते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000289008, "chapter_id": 9289, "verse_number": "४-१७-८", "content_sanskrit": "तदस्त्रं तस्य वीरस्य स्वर्गमार्गप्रभावनम्।\nरामबाणासनक्षिप्तमावहत् परमां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000289009, "chapter_id": 9289, "verse_number": "४-१७-९", "content_sanskrit": "तं तथा पतितं संख्ये गतार्चिषमिवानलम्।\nययातिमिव पुण्यान्ते देवलोकादिह च्युतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000289010, "chapter_id": 9289, "verse_number": "४-१७-१०", "content_sanskrit": "आदित्यमिव कालेन युगान्ते भुवि पातितम्।\nमहेन्द्रमिव दुर्धर्षमुपेन्द्रमिव दुःसहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000289011, "chapter_id": 9289, "verse_number": "४-१७-११", "content_sanskrit": "महेन्द्रपुत्रं पतितं वालिनं हेममालिनम्।\nव्यूढोरस्कं महाबाहुं दीप्तास्यं हरिलोचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000289012, "chapter_id": 9289, "verse_number": "४-१७-१२", "content_sanskrit": "लक्ष्मणानुचरो रामो ददर्शोपससर्प च।\nतं तथा पतितं वीरं गतार्चिषमिवानलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000289013, "chapter_id": 9289, "verse_number": "४-१७-१३", "content_sanskrit": "बहुमान्य च तं वीरं वीक्षमाणं शनैरिव।\nउपयातौ महावीर्यौ भ्रातरौ रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000289014, "chapter_id": 9289, "verse_number": "४-१७-१४", "content_sanskrit": "तं दृष्ट्वा राघवं वाली लक्ष्मणं च महाबलम्।\nअब्रवीत् परुषं वाक्यं प्रश्रितं धर्मसंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000289015, "chapter_id": 9289, "verse_number": "४-१७-१५", "content_sanskrit": "स भूमावल्पतेजोऽसुर्निहतो नष्टचेतनः।\nअर्थसंहितया वाचा गर्वितं रणगर्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000289016, "chapter_id": 9289, "verse_number": "४-१७-१६", "content_sanskrit": "त्वं नराधिपतेः पुत्रः प्रथितः प्रियदर्शनः।\nपराङ्मुखवधं कृत्वा कोऽत्र प्राप्तस्त्वया गुणः।\nयदहं युद्धसंरब्धस्त्वत्कृते निधनं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000289017, "chapter_id": 9289, "verse_number": "४-१७-१७", "content_sanskrit": "कुलीनः सत्त्वसम्पन्नस्तेजस्वी चरितव्रतः।\nरामः करुणवेदी च प्रजानां च हिते रतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000289018, "chapter_id": 9289, "verse_number": "४-१७-१८", "content_sanskrit": "सानुक्रोशो महोत्साहः समयज्ञो दृढव्रतः।\nइत्येतत् सर्वभूतानि कथयन्ति यशो भुवि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000289019, "chapter_id": 9289, "verse_number": "४-१७-१९", "content_sanskrit": "दमः शमः क्षमा धर्मो धृतिः सत्यं पराक्रमः।\nपार्थिवानां गुणा राजन् दण्डश्चाप्यपकारिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000289020, "chapter_id": 9289, "verse_number": "४-१७-२०", "content_sanskrit": "तान् गुणान् सम्प्रधार्याहमग्र्यं चाभिजनं तव।\nतारया प्रतिषिद्धः सन् सुग्रीवेण समागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000289021, "chapter_id": 9289, "verse_number": "४-१७-२१", "content_sanskrit": "न मामन्येन संरब्धं प्रमत्तं वेद‍्धुमर्हसि।\nइति मे बुद्धिरुत्पन्ना बभूवादर्शने तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000289022, "chapter_id": 9289, "verse_number": "४-१७-२२", "content_sanskrit": "स त्वां विनिहतात्मानं धर्मध्वजमधार्मिकम्।\nजाने पापसमाचारं तृणैः कूपमिवावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000289023, "chapter_id": 9289, "verse_number": "४-१७-२३", "content_sanskrit": "सतां वेषधरं पापं प्रच्छन्नमिव पावकम्।\nनाहं त्वामभिजानामि धर्मच्छद्माभिसंवृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000289024, "chapter_id": 9289, "verse_number": "४-१७-२४", "content_sanskrit": "विषये वा पुरे वा ते यदा पापं करोम्यहम्।\nन च त्वामवजानेऽहं कस्मात् तं हंस्यकिल्बिषम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000289025, "chapter_id": 9289, "verse_number": "४-१७-२५", "content_sanskrit": "फलमूलाशनं नित्यं वानरं वनगोचरम्।\nमामिहाप्रतियुध्यन्तमन्येन च समागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000289026, "chapter_id": 9289, "verse_number": "४-१७-२६", "content_sanskrit": "त्वं नराधिपतेः पुत्रः प्रतीतः प्रियदर्शनः।\nलिङ्गमप्यस्ति ते राजन् दृश्यते धर्मसंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000289027, "chapter_id": 9289, "verse_number": "४-१७-२७", "content_sanskrit": "कः क्षत्रियकुले जातः श्रुतवान् नष्टसंशयः।\nधर्मलिङ्गप्रतिच्छन्नः क्रूरं कर्म समाचरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000289028, "chapter_id": 9289, "verse_number": "४-१७-२८", "content_sanskrit": "त्वं राघवकुले जातो धर्मवानिति विश्रुतः।\nअभव्यो भव्यरूपेण किमर्थं परिधावसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000289029, "chapter_id": 9289, "verse_number": "४-१७-२९", "content_sanskrit": "साम दानं क्षमा धर्मः सत्यं धृतिपराक्रमौ।\nपार्थिवानां गुणा राजन् दण्डश्चाप्यपकारिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000289030, "chapter_id": 9289, "verse_number": "४-१७-३०", "content_sanskrit": "वयं वनचरा राम मृगा मूलफलाशिनः।\nएषा प्रकृतिरस्माकं पुरुषस्त्वं नरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000289031, "chapter_id": 9289, "verse_number": "४-१७-३१", "content_sanskrit": "भूमिर्हिरण्यं रूपं च विग्रहे कारणानि च।\nतत्र कस्ते वने लोभो मदीयेषु फलेषु वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000289032, "chapter_id": 9289, "verse_number": "४-१७-३२", "content_sanskrit": "नयश्च विनयश्चोभौ निग्रहानुग्रहावपि।\nराजवृत्तिरसंकीर्णा न नृपाः कामवृत्तयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000289033, "chapter_id": 9289, "verse_number": "४-१७-३३", "content_sanskrit": "त्वं तु कामप्रधानश्च कोपनश्चानवस्थितः।\nराजवृत्तेषु संकीर्णः शरासनपरायणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000289034, "chapter_id": 9289, "verse_number": "४-१७-३४", "content_sanskrit": "न तेऽस्त्यपचितिर्धर्मे नार्थे बुद्धिरवस्थिता।\nइन्द्रियैः कामवृत्तः सन् कृष्यसे मनुजेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000289035, "chapter_id": 9289, "verse_number": "४-१७-३५", "content_sanskrit": "हत्वा बाणेन काकुत्स्थ मामिहानपराधिनम्।\nकिं वक्ष्यसि सतां मध्ये कर्म कृत्वा जुगुप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000289036, "chapter_id": 9289, "verse_number": "४-१७-३६", "content_sanskrit": "राजहा ब्रह्महा गोघ्नश्चोरः प्राणिवधे रतः।\nनास्तिकः परिवेत्ता च सर्वे निरयगामिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000289037, "chapter_id": 9289, "verse_number": "४-१७-३७", "content_sanskrit": "सूचकश्च कदर्यश्च मित्रघ्नो गुरुतल्पगः।\nलोकं पापात्मनामेते गच्छन्ते नात्र संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000289038, "chapter_id": 9289, "verse_number": "४-१७-३८", "content_sanskrit": "अधार्यं चर्म मे सद्भी रोमाण्यस्थि च वर्जितम्।\nअभक्ष्याणि च मांसानि त्वद्विधैर्धर्मचारिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000289039, "chapter_id": 9289, "verse_number": "४-१७-३९", "content_sanskrit": "पञ्च पञ्चनखा भक्ष्या ब्रह्मक्षत्रेण राघव।\nशल्यकः श्वाविधो गोधा शशः कूर्मश्च पञ्चमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000289040, "chapter_id": 9289, "verse_number": "४-१७-४०", "content_sanskrit": "चर्म चास्थि च मे राम न स्पृशन्ति मनीषिणः।\nअभक्ष्याणि च मांसानि सोऽहं पञ्चनखो हतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000289041, "chapter_id": 9289, "verse_number": "४-१७-४१", "content_sanskrit": "तारया वाक्यमुक्तोऽहं सत्यं सर्वज्ञया हितम्।\nतदतिक्रम्य मोहेन कालस्य वशमागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000289042, "chapter_id": 9289, "verse_number": "४-१७-४२", "content_sanskrit": "त्वया नाथेन काकुत्स्थ न सनाथा वसुंधरा।\nप्रमदा शीलसम्पूर्णा पत्येव च विधर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000289043, "chapter_id": 9289, "verse_number": "४-१७-४३", "content_sanskrit": "शठो नैकृतिकः क्षुद्रो मिथ्याप्रश्रितमानसः।\nकथं दशरथेन त्वं जातः पापो महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000289044, "chapter_id": 9289, "verse_number": "४-१७-४४", "content_sanskrit": "छिन्नचारित्र्यकक्ष्येण सतां धर्मातिवर्तिना।\nत्यक्तधर्माङ्कुशेनाहं निहतो रामहस्तिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000289045, "chapter_id": 9289, "verse_number": "४-१७-४५", "content_sanskrit": "अशुभं चाप्ययुक्तं च सतां चैव विगर्हितम्।\nवक्ष्यसे चेदृशं कृत्वा सद्भिः सह समागतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000289046, "chapter_id": 9289, "verse_number": "४-१७-४६", "content_sanskrit": "उदासीनेषु योऽस्मासु विक्रमोऽयं प्रकाशितः।\nअपकारिषु ते राम नैवं पश्यामि विक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000289047, "chapter_id": 9289, "verse_number": "४-१७-४७", "content_sanskrit": "दृश्यमानस्तु युध्येथा मया युधि नृपात्मज।\nअद्य वैवस्वतं देवं पश्येस्त्वं निहतो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000289048, "chapter_id": 9289, "verse_number": "४-१७-४८", "content_sanskrit": "त्वयादृश्येन तु रणे निहतोऽहं दुरासदः।\nप्रसुप्तः पन्नगेनैव नरः पापवशं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000289049, "chapter_id": 9289, "verse_number": "४-१७-४९", "content_sanskrit": "सुग्रीवप्रियकामेन यदहं निहतस्त्वया।\nमामेव यदि पूर्वं त्वमेतदर्थमचोदयः।\nमैथिलीमहमेकाह्ना तव चानीतवान् भवेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000289050, "chapter_id": 9289, "verse_number": "४-१७-५०", "content_sanskrit": "राक्षसं च दुरात्मानं तव भार्यापहारिणम्।\nकण्ठे बद्‍ध्वा प्रदद्यां तेऽनिहतं रावणं रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000289051, "chapter_id": 9289, "verse_number": "४-१७-५१", "content_sanskrit": "न्यस्तां सागरतोये वा पाताले वापि मैथिलीम्।\nआनयेयं तवादेशाच्छ्वेतामश्वतरीमिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000289052, "chapter_id": 9289, "verse_number": "४-१७-५२", "content_sanskrit": "युक्तं यत्प्राप्नुयाद् राज्यं सुग्रीवः स्वर्गते मयि।\nअयुक्तं यदधर्मेण त्वयाहं निहतो रणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000289053, "chapter_id": 9289, "verse_number": "४-१७-५३", "content_sanskrit": "काममेवंविधो लोकः कालेन विनियुज्यते।\nक्षमं चेद्भवता प्राप्तमुत्तरं साधु चिन्त्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000289054, "chapter_id": 9289, "verse_number": "४-१७-५४", "content_sanskrit": "इत्येवमुक्त्वा परिशुष्कवक्त्रः\nशराभिघाताद् व्यथितो महात्मा।\nसमीक्ष्य रामं रविसंनिकाशं\nतूष्णीं बभौ वानरराजसूनुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000289055, "chapter_id": 9289, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये किष्किन्धाकाण्डे किष्किन्धाकाण्डे सप्तदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]