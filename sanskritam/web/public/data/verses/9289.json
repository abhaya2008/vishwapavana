[{"id": 40018569, "chapter_id": 9289, "verse_number": "1", "content_sanskrit": "तस्मिन्प्रतिहतेऽस्त्रेतुरावणोराक्षसाधिपः । क्रोधं च द्विगुणंचक्रेक्रोधाच्चास्त्रमनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40018570, "chapter_id": 9289, "verse_number": "2", "content_sanskrit": "मयेनविहितंरौद्रमन्यदस्त्रंमहाद्युतिः । उत्सृष्टुंरावणोभीमंराघवायप्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40018571, "chapter_id": 9289, "verse_number": "3", "content_sanskrit": "ततःशूलानिनिश्चेरुर्गदाश्चमुसलानि च । कार्मुकाद्दीप्यमानानिवज्रसाराणिसर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40018572, "chapter_id": 9289, "verse_number": "4", "content_sanskrit": "मुद्गराःकूटपाशाश्चदीप्ताश्चाशनयस्तथा । निष्पेतुर्विविधास्तीक्ष्णावाताइवयुगक्षये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40018573, "chapter_id": 9289, "verse_number": "5", "content_sanskrit": "तदस्त्रंराघव्श्रीमानुत्तमास्त्रविदांवरः । जघानपरमास्त्रणगान्धर्वेणमहाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40018574, "chapter_id": 9289, "verse_number": "6", "content_sanskrit": "तस्मिन्प्रतिहतेऽतुराघवेणमहात्मना । रावणःक्रोधाताम्राक्षस्सौरमस्त्रमुदैरयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40018575, "chapter_id": 9289, "verse_number": "7", "content_sanskrit": "ततश्चक्राणिनिष्पेतुर्भास्वराणिमहान्ति च । कार्मुकाद्भीमवेगस्यदशग्रीवस्यधीमतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40018576, "chapter_id": 9289, "verse_number": "8", "content_sanskrit": "तैरासीद्गगनंदीप्तंसन्ततद्भिःरितस्ततः । पतद्भिश्चदिशोदीप्ताश्चन्द्रसूर्यग्रहैरिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40018577, "chapter_id": 9289, "verse_number": "9", "content_sanskrit": "तानिचिच्छेदबाणौघैश्चक्राणितु स राघवः । आयुधानि च चित्राणिरावणस्यचमूमुखे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40018578, "chapter_id": 9289, "verse_number": "10", "content_sanskrit": "तदस्त्रंतुहतंदृष्टवारावणोराक्षसाधिपः । विव्याथदशभिर्बाणैरामंसर्वेषुमर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40018579, "chapter_id": 9289, "verse_number": "11", "content_sanskrit": "स विद्धोदशभिर्बाणैर्महाकार्मुकनिस्सृतैः । रावणेनमहातेजा न प्राकम्पतराघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40018580, "chapter_id": 9289, "verse_number": "12", "content_sanskrit": "ततोविव्याथगात्रेषुसर्वेषुसमितिञ्जयः । राघवस्तुसुसङ्क्रुद्धोरावणंबहुभिश्शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40018581, "chapter_id": 9289, "verse_number": "13", "content_sanskrit": "एतस्मिन्नन्तरेक्रुद्धोराघवस्यानुजोबली । लक्ष्मणःसायकान्सप्तजग्राहपरवीरहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40018582, "chapter_id": 9289, "verse_number": "14", "content_sanskrit": "तै: स्सायकैर्महावेगैरावणस्यमहाद्युति । ध्वजंमनुष्यशीर्षंतुतस्यचिच्छेदनैकधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40018583, "chapter_id": 9289, "verse_number": "15", "content_sanskrit": "सारदथेश्चापिबाणेनशिरोज्वलितकुण्डलम् । जहारलक्ष्मणःश्रीमान्नैरृतस्यमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40018584, "chapter_id": 9289, "verse_number": "16", "content_sanskrit": "तस्यबाणैश्चचिच्छेदधनुर्गजकरोपमम् । लक्ष्मणोराक्षसेन्द्रस्यपञ्चभिर्निशितैस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40018585, "chapter_id": 9289, "verse_number": "17", "content_sanskrit": "नीलमेघनिभांश्चास्यसदश्वान् पर्वतोपमान् । जघानाप्लुत्यगदयारावणस्यविभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40018586, "chapter_id": 9289, "verse_number": "18", "content_sanskrit": "हताश्वात्त्तुस्वोवेगादवप्लुत्यमहारथात् । कोपमाहारत्तीव्रंभ्रातरंप्रतिरावणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40018587, "chapter_id": 9289, "verse_number": "19", "content_sanskrit": "ततश्शक्तिंमहाशक्तिर्दीप्तार्दीप्ताशनीमिव । विभीषणस्यचिक्षेपराक्षसेन्द्रःप्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40018588, "chapter_id": 9289, "verse_number": "20", "content_sanskrit": "अप्राप्तामेवतांबाणैस्त्रिभिश्चिच्छेदलक्ष्मणः । अथोदतिष्ठत्सन्नादोवानराणांमहारणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40018589, "chapter_id": 9289, "verse_number": "21", "content_sanskrit": "स पपातत्रिधाछिन्नाशक्तिःकाञ्चनमालिनी । सविस्फुलिङ्गाज्वलितामहोल्केवदिवश्च्युता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40018590, "chapter_id": 9289, "verse_number": "22", "content_sanskrit": "ततःसम्भाविततरांकालेनापिदुरासदाम् । जग्राहविपुलांशक्तिंदीप्यमानांस्वतेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40018591, "chapter_id": 9289, "verse_number": "23", "content_sanskrit": "सावेगिताबलवतारावणेनदुरात्मना । जज्वालसुमहातेजादीप्ताशनिसमप्रभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40018592, "chapter_id": 9289, "verse_number": "24", "content_sanskrit": "एतस्मिन्नन्तरेवीरोलक्ष्मणस्तंविभीषणम् । प्राणसंशयमापन्नंतूर्णमभ्यवपद्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40018593, "chapter_id": 9289, "verse_number": "25", "content_sanskrit": "तंविमोक्षयितुंवीरश्चापमायम्यलक्ष्मणः । रावणंशक्तिहस्तंवैशरवर्षैरवाकिरत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40018594, "chapter_id": 9289, "verse_number": "26", "content_sanskrit": "कीर्यमाणश्शरौघेणविसृष्टेनमहात्मना । न प्रहर्तुंमनश्चक्रेविमुखीकृतविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40018595, "chapter_id": 9289, "verse_number": "27", "content_sanskrit": "मोक्षितंभ्रातरंदृष्टवालक्ष्मणेन स रावणः । लक्ष्मणाभिमुखस्तिष्ठन्निदंवचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40018596, "chapter_id": 9289, "verse_number": "28", "content_sanskrit": "मोक्षितस्तेबलश्लाघिन्यस्मादेवंविभीषणः । विमुच्यराक्षसंशक्तिस्त्वयीयंविनिपात्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40018597, "chapter_id": 9289, "verse_number": "29", "content_sanskrit": "एषातेहृदयंभित्त्वाशक्तिर्लोहितलक्षणा । मद्भाहुपरिघोत्सृष्टाप्राणानादाययास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40018598, "chapter_id": 9289, "verse_number": "30", "content_sanskrit": "इत्येवमुक्तातांशक्तिमष्टघण्टांमहास्वनाम् । मयेनमायाविहिताममोघंशत्रुघातिनीम् ॥ लक्ष्मणायसमुद्धिश्यज्वलन्तीमिवतेजसा । रावणःपरमक्रुद्धश्चिक्षेप च ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40018599, "chapter_id": 9289, "verse_number": "31", "content_sanskrit": "इत्येवमुक्तातांशक्तिमष्टघण्टांमहास्वनाम् । मयेनमायाविहिताममोघंशत्रुघातिनीम् ॥ लक्ष्मणायसमुद्धिश्यज्वलन्तीमिवतेजसा । रावणःपरमक्रुद्धश्चिक्षेप च ननाद च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40018600, "chapter_id": 9289, "verse_number": "32", "content_sanskrit": "साक्षिप्ताभीमवेगेनवज्राशनिसमस्वना । शक्तिरभ्यपतद्वेगाल्लक्ष्मणंरणमूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40018601, "chapter_id": 9289, "verse_number": "33", "content_sanskrit": "तामनुव्याहरच्छक्तिमापतन्तीं स राघवः । स्वस्त्यस्तुलक्ष्मणआयेतिमोघाभवहतोद्यमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40018602, "chapter_id": 9289, "verse_number": "34", "content_sanskrit": "रावणेनरणेशक्तिःक्रुद्धेनाशीविषोपमाः । मुक्ताशूरस्यभीतस्यलक्ष्मणस्यममज्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40018603, "chapter_id": 9289, "verse_number": "35", "content_sanskrit": "न्यपतत्सामहावेगालक्ष्मणस्यमहोरसि । जिह्वेवोरगराजस्यदीप्यमानामहाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40018604, "chapter_id": 9289, "verse_number": "36", "content_sanskrit": "ततोरावणवेगेनसुदूरमवगाढया । शक्त्याविभिन्नहृदयःपपातभुविलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40018605, "chapter_id": 9289, "verse_number": "37", "content_sanskrit": "तदवस्थंसमीपस्थोलक्ष्मणंप्रेक्ष्यराघवः । भ्रातृस्नेहान्महातेजाविषण्णहृदयोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40018606, "chapter_id": 9289, "verse_number": "38", "content_sanskrit": "स मुहूर्तमिवध्यात्वाबाष्पपर्याकुलेक्षणः । बभूवसम्रब्धतरोयुगान्तइवपावकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40018607, "chapter_id": 9289, "verse_number": "39", "content_sanskrit": "न विषादस्यकालोऽयमितिसञ्चिन्त्यराघवः । चक्रेसुतुमुलंयुद्धंरावणस्यवधेधृतः ॥ सर्वयत्नेनमहतालक्ष्मणंपरिवीक्ष्य च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40018608, "chapter_id": 9289, "verse_number": "40", "content_sanskrit": "सददर्शततोरामःशक्त्याभिन्नंमहाहवे ॥ लक्ष्मणंरुधिरादिग्धंसपन्नगमिवाचलम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40018609, "chapter_id": 9289, "verse_number": "41", "content_sanskrit": "तामपिप्रहितांशक्तिंरावणेनबलीयसा ॥ यत्नतस्तेहरिश्रेष्ठा न शेकुरवमर्दितुम् । अर्दिताश्चैवबाणौघैस्तेक्षिप्रहस्तेनरक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40018610, "chapter_id": 9289, "verse_number": "42", "content_sanskrit": "तामपिप्रहितांशक्तिंरावणेनबलीयसा ॥ यत्नतस्तेहरिश्रेष्ठा न शेकुरवमर्दितुम् । अर्दिताश्चैवबाणौघैस्तेक्षिप्रहस्तेनरक्षसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 40018611, "chapter_id": 9289, "verse_number": "43", "content_sanskrit": "सौमित्रिंसाविनिर्भिद्यप्रविष्टाधरणीतलम् । तांकराभ्यांपरामृश्यरामःशक्तिंभयावहाम् ॥ बभञ्जसमरेक्रुद्धोबलवान्विचकर्ष च ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 40018612, "chapter_id": 9289, "verse_number": "44", "content_sanskrit": "तस्यनिष्कर्षतःशक्तिंरावणेनबलीयसा ॥ शराःसर्वेषुगात्रेषुपातितामर्मभेदिनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 40018613, "chapter_id": 9289, "verse_number": "45", "content_sanskrit": "अचिन्तयित्वातान्बाणान्समालशिष्य च लक्ष्मणम् ॥ अब्रवीच्चहनूमन्तंसुग्रीवं च महाकपिम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 40018614, "chapter_id": 9289, "verse_number": "46", "content_sanskrit": "क्ष्मणंपरिवार्यैवतिष्ठध्वंवानरोत्तमाः ॥ पराक्रमस्यकालोऽयंसम्प्राप्तोमेचिरेप्सितः । पापात्मायंदशग्रीवोवध्यतांपापनिश्चयः ॥ काङ्क्षितस्स्तोककस्येवघर्मान्तेमेघदर्शनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]