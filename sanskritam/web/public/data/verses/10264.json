[{"id": 6000264000, "chapter_id": 10264, "verse_number": null, "content_sanskrit": "अथ अष्टषष्टितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000264001, "chapter_id": 10264, "verse_number": null, "content_sanskrit": "श्री शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.001.m4a", "display_order": 2}, {"id": 6000264002, "chapter_id": 10264, "verse_number": "१०-६८-१", "content_sanskrit": "आराध्य देवदेवेशं शङ्करं लोकशङ्करम्।\nतपसा तोषयित्वा तं कैलासगिरिवासिनम्॥ १०/६८/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.002.m4a", "display_order": 3, "topics": [{"text": "श्रीकृष्णस्य (श्रीशङ्करमाराध्य) रुग्मिण्यां प्रद्युम्नोत्पत्तिः", "range": "१–४"}]}, {"id": 6000264003, "chapter_id": 10264, "verse_number": "१०-६८-२", "content_sanskrit": "रुग्मिण्यां तनयं लेभे दग्धं कामं पुनर्हरिः।\nवीरं प्रद्युम्ननामानं रूपौदार्यगुणान्वितम्॥ १०/६८/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.003.m4a", "display_order": 4}, {"id": 6000264004, "chapter_id": 10264, "verse_number": null, "content_sanskrit": "पुत्रार्थमीश्वरं दृष्ट्वा स्वयं लब्धवरो हरिः।\nअवाप कीदृशं पुत्रं किंनामानं वदस्व मे॥ १०/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.004.m4a", "display_order": 5}, {"id": 6000264005, "chapter_id": 10264, "verse_number": "१०-६८-३", "content_sanskrit": "कामस्तु वासुदेवांशो दग्धः प्राग् रुद्रमन्युना।\nदेहोपपत्तये भूयस्तमेव प्रत्यपद्यत॥ १०/६८/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.005.m4a", "display_order": 6}, {"id": 6000264006, "chapter_id": 10264, "verse_number": "१०-६८-४", "content_sanskrit": "स एव जातो वैदर्भ्यां कृष्णवीर्यसमुद्भवः।\nप्रद्युम्न इति विख्यातः सर्वतोऽनवमः पितुः॥ १०/६८/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.006.m4a", "display_order": 7}, {"id": 6000264007, "chapter_id": 10264, "verse_number": "१०-६८-५", "content_sanskrit": "तं शम्बरः कामरूपी हृत्वा तोकमनिर्दशम्।\nस विदित्वाऽऽत्मनः शत्रुं पास्योदन्वत्यगाद् गृहम्॥ १०/६८/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.007.m4a", "display_order": 8, "topics": [{"text": "जातमात्रस्य तस्य शम्बरासुरेणापहारः", "range": "५"}]}, {"id": 6000264008, "chapter_id": 10264, "verse_number": "१०-६८-६", "content_sanskrit": "तं निर्जगार बलवान् मीनः सोऽप्यपरैः सह।\nवृतो जालेन महता गृहीतो मत्स्यजीविभिः॥ १०/६८/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.008.m4a", "display_order": 9, "topics": [{"text": "तत्र स्थितया मायावतीनाम्न्या रतिदेव्या स्वभर्तुः प्रद्युम्नस्य पोषणम्", "range": "६–११"}]}, {"id": 6000264009, "chapter_id": 10264, "verse_number": "१०-६८-७", "content_sanskrit": "तं शम्बराय कैवर्ता उपाजह्रुरुपायनम्।\nसूदा महानसं नीत्वाऽवद्यन् स्वधितिनाऽद्भुतम्॥ १०/६८/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.009.m4a", "display_order": 10}, {"id": 6000264010, "chapter_id": 10264, "verse_number": "१०-६८-८", "content_sanskrit": "दृष्ट्वा तदुदरे बालं मायावत्यै न्यवेदयन्।\nनारदोऽकथयत् सर्वं तस्याः शङ्कितचेतसः॥ १०/६८/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.010.m4a", "display_order": 11}, {"id": 6000264011, "chapter_id": 10264, "verse_number": "१०-६८-९", "content_sanskrit": "बालस्य तत्त्वमुत्पत्तिं मत्स्योदरनिवेशनम्।\nसा च कामस्य वै पत्नी रतिर्नाम यशस्विनी॥ १०/६८/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.011.m4a", "display_order": 12}, {"id": 6000264012, "chapter_id": 10264, "verse_number": "१०-६८-१०", "content_sanskrit": "पत्युर्निर्दग्धदेहस्य देहोत्पत्तिं प्रतीक्षती॥ १०/६८/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.012.m4a", "display_order": 13}, {"id": 6000264013, "chapter_id": 10264, "verse_number": "१०-६८-११", "content_sanskrit": "निरूपिता शम्बरेण सा सूपौदनसाधने।\nकामदेवं शिशुं बुद्ध्वा चक्रे स्नेहं सदाऽर्भके॥ १०/६८/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.013.m4a", "display_order": 14}, {"id": 6000264014, "chapter_id": 10264, "verse_number": "१०-६८-१२", "content_sanskrit": "नातिदीर्घेण कालेन स कार्ष्णी रूढयौवनः।\nजनयामास नारीणां वीक्षन्तीनां च विभ्रमम्॥ १०/६८/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.014.m4a", "display_order": 15, "topics": [{"text": "मायावत्याः सकाशात्प्राप्तमहामायस्य प्रद्युम्नस्य शम्बरवधपूर्वकं तया सह द्वारकामागत्य रुग्मिण्या अन्तःपुरप्रवेशः", "range": "१२–२९"}]}, {"id": 6000264015, "chapter_id": 10264, "verse_number": "१०-६८-१३", "content_sanskrit": "सा तं पतिं पद्मदलायतेक्षणं प्रलम्बबाहुं नरलोकसुन्दरम्।\nसव्रीडहासोत्तमविभ्रमेक्षितैः प्रीत्योपतस्थे रतिरात्मनो धनैः॥ १०/६८/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.015.m4a", "display_order": 16}, {"id": 6000264016, "chapter_id": 10264, "verse_number": "१०-६८-१४", "content_sanskrit": "तामाह भगवान् कार्ष्णिर्मातस्ते मतिरन्यथा।\nमातृभावमतिक्रम्य वर्तसे कामिनीव मे॥ १०/६८/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.016.m4a", "display_order": 17}, {"id": 6000264017, "chapter_id": 10264, "verse_number": null, "content_sanskrit": "रतिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.017.m4a", "display_order": 18}, {"id": 6000264018, "chapter_id": 10264, "verse_number": "१०-६८-१५", "content_sanskrit": "भवान् नारायणसुतः शम्बरेणाहृतो गृहात्।\nअहं तेऽधिकृता पत्नी रतिः कामो भवान् प्रभो॥ १०/६८/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.018.m4a", "display_order": 19}, {"id": 6000264019, "chapter_id": 10264, "verse_number": "१०-६८-१६", "content_sanskrit": "एष त्वां निर्दशं सिन्धावक्षिपच्छम्बरोऽसुरः।\nमत्स्योऽग्रसीत् तदुदरादिह प्राप्तो भवान् प्रभो॥ १०/६८/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.019.m4a", "display_order": 20}, {"id": 6000264020, "chapter_id": 10264, "verse_number": "१०-६८-१७", "content_sanskrit": "तमिमं जहि दुर्धर्षं दुर्जयं शत्रुमात्मनः।\nमायाशतविदं त्वं च मायाभिर्मोहनादिभिः॥ १०/६८/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.020.m4a", "display_order": 21}, {"id": 6000264021, "chapter_id": 10264, "verse_number": "१०-६८-१८", "content_sanskrit": "परिशोचति ते माता कुररीव गतप्रजा।\nपुत्रस्नेहाकुला दीना विवत्सा गौरिवातुरा॥ १०/६८/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.021.m4a", "display_order": 22}, {"id": 6000264022, "chapter_id": 10264, "verse_number": "१०-६८-१९", "content_sanskrit": "प्रभाष्यैवं ददौ विद्यां प्रद्युम्नाय महात्मने।\nमायावती महामाया सर्वमायाविनाशिनीम्॥ १०/६८/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.022.m4a", "display_order": 23}, {"id": 6000264023, "chapter_id": 10264, "verse_number": "१०-६८-२०", "content_sanskrit": "स च शम्बरमभ्येत्य संयुगाय समाह्वयत्।\nअवष्टभ्यौष्ठमाक्षेपैः क्षिपन् सञ्जनयन् कलिम्॥ १०/६८/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.023.m4a", "display_order": 24}, {"id": 6000264024, "chapter_id": 10264, "verse_number": "१०-६८-२१", "content_sanskrit": "सोऽधिक्षिप्तो दुर्वचोभिः पदाहत इवोरगः।\nनिश्चक्राम गदापाणिरमर्षात् ताम्रलोचनः॥ १०/६८/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.024.m4a", "display_order": 25}, {"id": 6000264025, "chapter_id": 10264, "verse_number": "१०-६८-२२", "content_sanskrit": "गदामाविध्य तरसा प्रद्युम्नाय महात्मने।\nप्रक्षिप्य व्यनदन्नादं वज्रनिष्पेषनिष्ठुरम्॥ १०/६८/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.025.m4a", "display_order": 26}, {"id": 6000264026, "chapter_id": 10264, "verse_number": "१०-६८-२३", "content_sanskrit": "तामापतन्तीं भगवान् प्रद्युम्नो गदया गदाम्।\nअपास्य शत्रवे क्रुद्धः प्राहिणोत् स्वगदां नदन्॥ १०/६८/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.026.m4a", "display_order": 27}, {"id": 6000264027, "chapter_id": 10264, "verse_number": "१०-६८-२४", "content_sanskrit": "स च मायां समाश्रित्य दैतेयीं मयदर्शिताम्।\nनिर्ममेऽश्ममयं वर्षं कार्ष्णौ वैहायसोऽसुरः॥ १०/६८/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.027.m4a", "display_order": 28}, {"id": 6000264028, "chapter_id": 10264, "verse_number": "१०-६८-२५", "content_sanskrit": "बाध्यमानोऽश्मवर्षेण रौग्मिणेयो महारथः।\nसत्त्वात्मिकां महाविद्यां सर्वमायोपमर्दिनीम्॥ १०/६८/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.028.m4a", "display_order": 29}, {"id": 6000264029, "chapter_id": 10264, "verse_number": "१०-६८-२६", "content_sanskrit": "ततो गौह्यकगान्धर्वपैशाचोरगराक्षसीः।\nप्रायुङ्क्त शतशो दैत्यः कार्ष्णिर्व्यधमयत् स ताः॥ १०/६८/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.029.m4a", "display_order": 30}, {"id": 6000264030, "chapter_id": 10264, "verse_number": "१०-६८-२७", "content_sanskrit": "निशातमसिमुद्यम्य सकीरीटं सकुण्डलम्।\nशम्बरस्य शिरः कायात् ताम्रश्मश्व्रोजसाऽहरत्॥ १०/६८/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.030.m4a", "display_order": 31}, {"id": 6000264031, "chapter_id": 10264, "verse_number": "१०-६८-२८", "content_sanskrit": "आकीर्यमाणो दिविजैः स्तुवद्भिः कुसुमोत्करैः।\nभार्ययाऽम्बरचारिण्या पुरं नीतो विहायसा॥ १०/६८/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.031.m4a", "display_order": 32}, {"id": 6000264032, "chapter_id": 10264, "verse_number": "१०-६८-२९", "content_sanskrit": "अन्तःपुरवरं राजन् ललनाशतसङ्कुलम्।\nविवेश पत्न्या गगनाद् विद्युतेव बलाहकः॥ १०/६८/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.032.m4a", "display_order": 33}, {"id": 6000264033, "chapter_id": 10264, "verse_number": "१०-६८-३०", "content_sanskrit": "तं दृष्ट्वा जलदश्यामं पीतकौशेयवाससम्।\nप्रलम्बबाहुं ताम्राक्षं सुस्मितं रुचिराननम्॥ १०/६८/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.033.m4a", "display_order": 34}, {"id": 6000264034, "chapter_id": 10264, "verse_number": "१०-६८-३१", "content_sanskrit": "अलङ्कृतमुखाम्भोजं नीलवक्त्रालकालिभिः।\nकृष्णं मत्वा स्‍त्रियो भीता निलिल्युस्तत्र तत्र ह॥ १०/६८/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.034.m4a", "display_order": 35}, {"id": 6000264035, "chapter_id": 10264, "verse_number": "१०-६८-३२", "content_sanskrit": "उपधार्य शनैरीशद्वैलक्षण्येन योषितः।\nउपजग्मुः प्रमुदिताः सस्‍त्रीरत्नं शुचिस्मिताः॥ १०/६८/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.035.m4a", "display_order": 36}, {"id": 6000264036, "chapter_id": 10264, "verse_number": "१०-६८-३३", "content_sanskrit": "अथ तत्रासितापाङ्गी वैदर्भी वल्गुभाषिणी।\nअस्मरत् स्वसुतं नष्टं स्नेहस्रुतपयोधरा॥ १०/६८/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.036.m4a", "display_order": 37}, {"id": 6000264037, "chapter_id": 10264, "verse_number": "१०-६८-३४", "content_sanskrit": "को न्वयं नरवैडूर्यः कस्य वा कमलेक्षणः।\nधृतः कया वा जठरे केयं लब्धाऽथ केन वा॥ १०/६८/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.037.m4a", "display_order": 38}, {"id": 6000264038, "chapter_id": 10264, "verse_number": "१०-६८-३५", "content_sanskrit": "मम चाप्यात्मजो नष्टो नीतो वा सूतिकागृहात्।\nएतत्तुल्यवयोरूपो यदि जीवति कुत्रचित्॥ १०/६८/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.038.m4a", "display_order": 39}, {"id": 6000264039, "chapter_id": 10264, "verse_number": "१०-६८-३६", "content_sanskrit": "कथं त्वनेन सम्प्राप्तं सारूप्यं शार्ङ्गधन्वनः।\nआकृत्याऽवयवैर्गत्या स्वरहासावलोकनैः॥ १०/६८/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.039.m4a", "display_order": 40}, {"id": 6000264040, "chapter_id": 10264, "verse_number": "१०-६८-३७", "content_sanskrit": "स एव वा भवेन्नूनं यो मे गर्भे धृतोऽर्भकः।\nअमुष्मिन् प्रीतिरधिका वामः स्फुरति मे भुजः॥ १०/६८/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.040.m4a", "display_order": 41}, {"id": 6000264041, "chapter_id": 10264, "verse_number": "१०-६८-३८", "content_sanskrit": "एवं मीमांसमानायां वैदर्भ्यां देवकीसुतः।\nदेवकीवसुदेवाभ्यां नारदेन महात्मना॥ १०/६८/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.041.m4a", "display_order": 42}, {"id": 6000264042, "chapter_id": 10264, "verse_number": "१०-६८-३९", "content_sanskrit": "अन्यैश्च यादवश्रेष्ठैरुत्तमश्लोक आविशत्।\nविदितार्थोऽपि भगवांस्तूष्णीमास जनार्दनः॥ १०/६८/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.042.m4a", "display_order": 43}, {"id": 6000264043, "chapter_id": 10264, "verse_number": "१०-६८-४०", "content_sanskrit": "नारदोऽकथयत् सर्वं शम्बराहरणादिकम्।\nतच्छ्रुत्वा महदाश्चर्यं कृष्णान्तःपुरयोषितः॥ १०/६८/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.043.m4a", "display_order": 44}, {"id": 6000264044, "chapter_id": 10264, "verse_number": "१०-६८-४१", "content_sanskrit": "देवकीवासुदेवौ च कृष्णरामौ तथा स्‍त्रियः।\nदम्पती तौ परिष्वज्य रुग्मिणी च ययुर्मुदम्॥ १०/६८/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.044.m4a", "display_order": 45}, {"id": 6000264045, "chapter_id": 10264, "verse_number": "१०-६८-४२", "content_sanskrit": "नष्टं प्रद्युम्नमायातमाकर्ण्य द्वारकौकसः।\nअहो मृत इवायातो बालो दिष्ट्येति चाब्रुवन्॥ १०/६८/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.045.m4a", "display_order": 46, "topics": [{"text": "पूर्वमदर्शनं गतस्य प्रद्युम्नस्य प्राप्त्या श्रीकृष्णरुग्मिण्यादीनां हर्षप्राप्तिः", "range": "४२–४३"}]}, {"id": 6000264046, "chapter_id": 10264, "verse_number": "१०-६८-४३", "content_sanskrit": "यं वै मुहुः पितृसरूपनिजेशभावा तन्मातरो मनसिजार्द्रहृदोरुभावाः।\nचित्रं न तत् खलु रमास्पदबिम्बभूते कामे स्मरेऽक्षविषये किमुतान्यनार्यः॥ १०/६८/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_068/BhP_10.068.046.m4a", "display_order": 47}, {"id": 6000264047, "chapter_id": 10264, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धेऽष्टषष्टितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]