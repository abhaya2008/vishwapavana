[{"id": 2012998, "chapter_id": 1267, "verse_number": "२-८-१", "content_sanskrit": "नारद उवाच।\nकथयिष्ये सभां याम्यां युधिष्ठिर निबोध ताम्।\nवैवस्वतस्य यां पार्थ विश्वकर्मा चकार ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2012999, "chapter_id": 1267, "verse_number": "२-८-२", "content_sanskrit": "तैजसी सा सभा राजन्बभूव शतयोजना।\nविस्तारायामसम्पन्ना भूयसी चापि पाण्डव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2013000, "chapter_id": 1267, "verse_number": "२-८-३", "content_sanskrit": "अर्कप्रकाशा भ्राजिष्णुः सर्वतः कामरूपिणी।\nनातिशीता च चात्युष्णा मनसश्च प्रहर्षिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2013001, "chapter_id": 1267, "verse_number": "२-८-४", "content_sanskrit": "न शोको न जरा तस्यां क्षुत्पिपासे न चाप्रियम्।\nन च दैन्यं क्लमो वाऽपि प्रतिकूलं न चाप्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2013002, "chapter_id": 1267, "verse_number": "२-८-५", "content_sanskrit": "सर्वे कामाः स्थितास्तस्यां ये दिव्या ये च मानुषाः।\nरसवच्च प्रभूतं च भक्ष्यं भोज्यमरिन्दम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2013003, "chapter_id": 1267, "verse_number": "२-८-६", "content_sanskrit": "लेह्यं चोप्यं च पेयं च हृद्यं स्वादु मनोहरम्।\nपुण्यगन्धाः स्रजस्तस्य नित्यं कामफला द्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2013004, "chapter_id": 1267, "verse_number": "२-८-७", "content_sanskrit": "रसवन्ति च तोयानि शीतान्युष्णानि चैव हि।\nतस्यां राजर्षयः पुण्यास्तथा ब्रह्मर्षयोऽमलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2013005, "chapter_id": 1267, "verse_number": "२-८-८", "content_sanskrit": "यमं वैवस्वतं तात प्रहृष्टाः पर्युपासते।\nययातिर्नहुषः पुरुर्मान्धाता सोमको नुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2013006, "chapter_id": 1267, "verse_number": "२-८-९", "content_sanskrit": "त्रसदस्युश्च राजर्षिः कृतवीर्यः श्रुतश्रवाः।\nअरिष्टनेमिः सिद्धश्च कृतवेगः कृतिर्निमिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2013007, "chapter_id": 1267, "verse_number": "२-८-१०", "content_sanskrit": "प्रतर्दनः शिबिर्मत्स्यः पृथुलाक्षो बृहद्रथः।\nवार्तो मरुत्तः कुषिकः साङ्काश्यः साङ्कृतिर्ध्रुवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2013008, "chapter_id": 1267, "verse_number": "२-८-११", "content_sanskrit": "चतुरश्चः सदस्योर्मिः कार्तवीर्यश्च पार्थिवः।\nभरतः सुरथश्चैव सुनीथो निशठोऽनलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2013009, "chapter_id": 1267, "verse_number": "२-८-१२", "content_sanskrit": "दिवोदासश्च सुमना अम्बरीषो भगीरथः।\nव्यश्वः सदश्वो वाघ्र्यश्वः पृथुवेगः पृथुश्रवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2013010, "chapter_id": 1267, "verse_number": "२-८-१३", "content_sanskrit": "पृपदश्वो वसुमनाः क्षुपश्च सुमहाबलः।\nरुषद्रुर्वृषसेनश्च पुरुकुत्सो ध्वजी रथी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2013011, "chapter_id": 1267, "verse_number": "२-८-१४", "content_sanskrit": "आर्ष्टिषेणो दिलीपश्च महात्मा चाप्युशीनरः।\nऔशीनरिः पुण्डरीकः शर्यातिः शरभः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2013012, "chapter_id": 1267, "verse_number": "२-८-१५", "content_sanskrit": "अङ्गो रिष्टश्च वेनश्च दुष्यन्तः सृञ्जयो जयः।\nभाङ्गासुरिः सुनीथश्च निषधोऽथ वहीनरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2013013, "chapter_id": 1267, "verse_number": "२-८-१६", "content_sanskrit": "करन्धमो बाह्लिकश्च सुद्युम्नो बलवान्मधुः।\nऐलो मरुत्तश्च तथा बलवान्पृथिवीपतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2013014, "chapter_id": 1267, "verse_number": "२-८-१७", "content_sanskrit": "कपोतरोमा तृणकः सहदेवार्जुनौ तथा।\nव्यश्वः साश्वः कृशाश्वश्च शशबिन्दुश्च पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2013015, "chapter_id": 1267, "verse_number": "२-८-१८", "content_sanskrit": "रामो दाशरथिश्चैव लक्ष्मणोऽथ प्रतर्दनः।\nअलर्कः कक्षसेनश्च गयो गौराओश्व एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2013016, "chapter_id": 1267, "verse_number": "२-८-१९", "content_sanskrit": "जामदग्न्यश्च रामश्च नाभागसगरौ तथा।\nभूरिद्युम्नो महाश्वश्च पृथाशअवो जनकस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2013017, "chapter_id": 1267, "verse_number": "२-८-२०", "content_sanskrit": "राजा वैन्यो वारिसेनः पुरिजिज्जनमेजयः।\nब्रह्मदत्तस्त्रिगर्तिश्च राजोपरिचरस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2013018, "chapter_id": 1267, "verse_number": "२-८-२१", "content_sanskrit": "इन्द्रद्युम्नो भीमजानुर्गौरपृष्ठोऽनघो लयः।\nपद्मोऽथ मुचुकुन्दश्च भूरिद्युम्नः प्रसेनजित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2013019, "chapter_id": 1267, "verse_number": "२-८-२२", "content_sanskrit": "अरिष्टनेमिः सुद्युम्नः पृथुलाश्वोऽष्टकस्तथा।\nशतं मत्स्या नृपतयः शतं नीपाः शतं हयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2013020, "chapter_id": 1267, "verse_number": "२-८-२३", "content_sanskrit": "धृतराष्ट्राश्चैकशतमशीतिर्जनमेजयाः।\nशतं च ब्रह्मदत्तानां वीरिणामीरिणां शतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2013021, "chapter_id": 1267, "verse_number": "२-८-२४", "content_sanskrit": "भीष्णाणां द्वे शतेऽप्यत्र भीमानां तु तथा शतम्।\nशतं च प्रतिविन्ध्यानां शतं नागाः शतं हयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2013022, "chapter_id": 1267, "verse_number": "२-८-२५", "content_sanskrit": "पलाशानां शतं ज्ञेयं शतं काशकुशादयः।\nशान्तनुश्चैव राजेन्द्र पाण्डुश्चैव पिता तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2013023, "chapter_id": 1267, "verse_number": "२-८-२६", "content_sanskrit": "उशङ्गवः शतरथो देवराजो जयद्रथः।\nवृषदर्भश्च राजर्षिर्बुद्धिमान्सहमन्त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2013024, "chapter_id": 1267, "verse_number": "२-८-२७", "content_sanskrit": "अथापरे सहस्राणि ये गताः शसबिन्दवः।\nइष्ट्वाऽश्वमेधैर्बहुभिर्महद्भिर्भूरिदक्षिणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2013025, "chapter_id": 1267, "verse_number": "२-८-२८", "content_sanskrit": "एते राजर्षयः पुण्याः कीर्तिमन्तो बहुश्रुताः।\nतस्यां सभायां राजेन्द्र वैवस्वतमुपासते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2013026, "chapter_id": 1267, "verse_number": "२-८-२९", "content_sanskrit": "अगस्त्योऽथ मतङ्गश्च कालो मृत्युस्तथैव च।\nयज्वानश्चैव सिद्धाश्च ये न योगशरीरिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2013027, "chapter_id": 1267, "verse_number": "२-८-३०", "content_sanskrit": "अग्निष्वात्ताश्च पितरः फेनपाश्वोष्मपाश्च ये।\nसुधावन्तो बर्हिषदो मूर्तिमन्तस्तथाऽपरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2013028, "chapter_id": 1267, "verse_number": "२-८-३१", "content_sanskrit": "कालचक्रं च साक्षाच्च भगवान्हव्यवाहनः।\nनरा दुष्कृतकर्माणो दक्षिणायनमृत्यवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2013029, "chapter_id": 1267, "verse_number": "२-८-३२", "content_sanskrit": "कालस्य नयने युक्ता यमस्य पुरुपाश्च ये।\nतस्यां शिंशुपपालाशास्तथा काशकुशादयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2013030, "chapter_id": 1267, "verse_number": "२-८-३३", "content_sanskrit": "उपासते धर्मराजं मूर्तिमन्तो जनाधिप।\nएते चान्ये च बहवः पितृराजसभासदः।\nन शक्याः परिसङ्ख्यातुं नामभिः कर्मभिस्तथा ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2013031, "chapter_id": 1267, "verse_number": "२-८-३४", "content_sanskrit": "असम्बाधा हि सा पार्थ रम्या कामगमा सभा।\nदीर्घकालं तपस्तप्त्वा निर्मिता विश्वकर्मणा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2013032, "chapter_id": 1267, "verse_number": "२-८-३५", "content_sanskrit": "ज्वलन्ती भासमाना च तेजसा स्वेन भारत।\nतामुग्रतपसो यान्ति सुव्रताः सत्यवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2013033, "chapter_id": 1267, "verse_number": "२-८-३६", "content_sanskrit": "शान्ताः सन्यासिनः शुद्धाः पूताः पुण्येन कर्मणा।\nसर्वे भास्वरदेहाश्च सर्वे च विरजोम्बराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2013034, "chapter_id": 1267, "verse_number": "२-८-३७", "content_sanskrit": "चित्राङ्गदाश्चित्रमाल्याः सर्वे ज्वलितकुण्डलाः।\nसुकृतैः कर्मभिः पुण्यैः पारिबर्हैश्च भूषिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2013035, "chapter_id": 1267, "verse_number": "२-८-३८", "content_sanskrit": "गन्धर्वाश्च महात्मानः सङ्घशश्चाप्सरोगणाः।\nवादित्रं नृत्तगीतं च हास्यं लास्यं च सर्वशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2013036, "chapter_id": 1267, "verse_number": "२-८-३९", "content_sanskrit": "पुण्याश्च गन्धाः शब्दाश्च तस्यां पार्थ समन्ततः।\nदिव्यानि चैव माल्यानि उपतिष्ठन्ति नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2013037, "chapter_id": 1267, "verse_number": "२-८-४०", "content_sanskrit": "शतं शतसहस्राणि धर्मिणां तं प्रजेश्वरम्।\nउपासते महात्मानं रूपयुक्ता मनस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2013038, "chapter_id": 1267, "verse_number": "२-८-४१", "content_sanskrit": "ईदृशी सा सभा राजन्पितृराज्ञो महात्मनः।\nवरुणस्यापि वक्ष्यामि सभां पुष्करमालिनीम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2013039, "chapter_id": 1267, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि मन्त्रपर्वणि अष्टमोऽध्यायः॥ ८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]