[{"id": 6000029000, "chapter_id": 10029, "verse_number": null, "content_sanskrit": "अथ नवमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "एवं परीक्षिता पृष्टेन शुकेन भगवता ब्रह्मणे प्रोक्तस्य श्रीभागवतस्य परीक्षितं प्रति कथनम्", "range": null}]}, {"id": 6000029001, "chapter_id": 10029, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.001.m4a", "display_order": 2}, {"id": 6000029002, "chapter_id": 10029, "verse_number": "२-९-१", "content_sanskrit": "आत्ममायामृते राजन्परस्यानुभवात्मनः।\nन घटेतार्थसम्बन्धः स्वप्ने द्रष्टुरिवाञ्जसा॥ २/९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.002.m4a", "display_order": 3}, {"id": 6000029003, "chapter_id": 10029, "verse_number": "२-९-२", "content_sanskrit": "बहुरूप इवाभाति मायया बहुरूपया।\nरममाणो गुणेष्वस्या ममाहमिति मन्यते॥ २/९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.003.m4a", "display_order": 4}, {"id": 6000029004, "chapter_id": 10029, "verse_number": "२-९-३", "content_sanskrit": "यर्हि चायं महित्वे स्वे परस्मिन्कालमाययोः।\nरमते गतसंमोहस्त्यक्त्वोदास्ते तदोभयम्॥ २/९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.004.m4a", "display_order": 5}, {"id": 6000029005, "chapter_id": 10029, "verse_number": "२-९-४", "content_sanskrit": "आत्मतत्त्वविशुद्ध्यर्थं यदाह भगवानृतम्।\nब्रह्मणेऽदर्शयद्रूपमव्यलीकव्रतादृतः॥ २/९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.005.m4a", "display_order": 6}, {"id": 6000029006, "chapter_id": 10029, "verse_number": "२-९-५", "content_sanskrit": "स आदिदेवो भजतां परो गुरुः स्वधिष्ण्यमास्थाय सिसृक्षयैक्षत।\nतां नाध्यगच्छद्दृशमत्र सम्मतां प्रपञ्चनिर्माणविधिर्यया भवेत्॥ २/९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.006.m4a", "display_order": 7}, {"id": 6000029007, "chapter_id": 10029, "verse_number": "२-९-६", "content_sanskrit": "सञ्चिन्तयन् द्व्यक्षरमेकदाऽम्भस्युपाशृृणोद् द्विर्गदितं वचो विभुः।\nस्पर्शेषु यत् षोडशमेकविंशं निष्किञ्चनानां नृप यद्धनं विदुः॥ २/९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.007.m4a", "display_order": 8}, {"id": 6000029008, "chapter_id": 10029, "verse_number": "२-९-७", "content_sanskrit": "निशम्य तद्वक्तृदिदृक्षया दिशो विलोक्य तत्रान्यदपश्यमानः।\nस्वधिष्ण्यमास्थाय विमृश्य तद्धितं तपस्युपादिष्ट इवादधे मनः॥ २/९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.008.m4a", "display_order": 9}, {"id": 6000029009, "chapter_id": 10029, "verse_number": "२-९-८", "content_sanskrit": "दिव्यं सहस्राब्दममोघदर्शनो जितानिलात्मा विजितोभयेन्द्रियः।\nअतप्यत स्माखिललोकतापनं तपस्तपीयांस्तपतां समाहितः॥ २/९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.009.m4a", "display_order": 10}, {"id": 6000029010, "chapter_id": 10029, "verse_number": "२-९-९", "content_sanskrit": "तस्मै स्वलोकं भगवान्सभाजितः सन्दर्शयामास परं न यत्पदम्।\nव्यपेतसंक्लेशविमोहसाध्वसं सन्दृष्टवद्भिर्विबुधैरभिष्टुतम्॥ २/९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.010.m4a", "display_order": 11}, {"id": 6000029011, "chapter_id": 10029, "verse_number": "२-९-१०", "content_sanskrit": "न वर्तते यत्र रजस्तमस्तयोः सत्त्वं च मिश्रं न च कालविक्रमः।\nन यत्र माया किमुतापरे हरेरनुव्रता यत्र सुरासुरार्चिताः॥ २/९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.011.m4a", "display_order": 12}, {"id": 6000029012, "chapter_id": 10029, "verse_number": "२-९-११", "content_sanskrit": "श्यामावदाताः शतपत्रलोचनाः पिशङ्गवस्‍त्राः सुरुचः सुपेशसः।\nसर्वे चतुर्बाहव उन्मिषन्मणिप्रवेकनिष्काभरणाः सुवर्चसः॥ २/९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.012.m4a", "display_order": 13}, {"id": 6000029013, "chapter_id": 10029, "verse_number": "२-९-१२", "content_sanskrit": "प्रवालवैदूर्यमृणालवर्चसां परिस्फुरत्कुण्डलमौलिमालिनाम्।\nभ्राजिष्णुभिर्यः परितो विराजते लसद्विमानावलिभिर्महात्मनाम्।\nविद्योतमानप्रमदोत्तमाभिः स विद्युदभ्रावलिभिर्यथा नभः॥ २/९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.013.m4a", "display_order": 14}, {"id": 6000029014, "chapter_id": 10029, "verse_number": "२-९-१३", "content_sanskrit": "श्रीर्यत्र रूपिण्युरुगायपादयोः करोति मानं बहुधा विभूतिभिः।\nप्रेङ्खश्रिता याः कुसुमाकरानुगैर्विगीयमाना प्रियकर्म गायती॥ २/९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.014.m4a", "display_order": 15}, {"id": 6000029015, "chapter_id": 10029, "verse_number": "२-९-१४", "content_sanskrit": "ददर्श तत्राखिलसात्वतां पतिं श्रियःपतिं यज्ञपतिं जगत्पतिम्।\nसुनन्दनन्दप्रबलार्हणादिभिः स्वपार्षदमुख्यैः परिसेवितं विभुम्॥ २/९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.015.m4a", "display_order": 16}, {"id": 6000029016, "chapter_id": 10029, "verse_number": "२-९-१५", "content_sanskrit": "भृत्यप्रसादाभिमुखं दृगासवैः प्रसन्नहासारुणलोचनाननम्।\nकिरीटिनं कुण्डलिनं चतुर्भुजं पीतांशुकं वक्षसि लक्षितं श्रिया॥ २/९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.016.m4a", "display_order": 17}, {"id": 6000029017, "chapter_id": 10029, "verse_number": "२-९-१६", "content_sanskrit": "अध्यर्हणीयासनमास्थितं विभुं वृतं चतुष्षोडशपञ्चशक्तिभिः।\nयुक्तं भगैः स्वैरितरत्र चाध्रुवैः स्व एव धामन् रममाणमीश्वरम्॥ २/९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.017.m4a", "display_order": 18}, {"id": 6000029018, "chapter_id": 10029, "verse_number": "२-९-१७", "content_sanskrit": "तद्दर्शनाह्लादपरिप्लुतान्तरो हृष्यत्तनुः प्रेमभराश्रुलोचनः।\nननाम पादाम्बुजमस्य विश्वसृक् यत्पारमहंस्येन पथाऽधिगम्यते॥ २/९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.018.m4a", "display_order": 19}, {"id": 6000029019, "chapter_id": 10029, "verse_number": "२-९-१८", "content_sanskrit": "तं प्रीयमाणं समुपस्थितं कविं प्रजाविसर्गे निजशासनार्हणम्।\nबभाष ईषत्स्मितशोचिषा गिरा प्रियः प्रियं प्रीतमनाः करे स्पृशन्॥ २/९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.019.m4a", "display_order": 20}, {"id": 6000029020, "chapter_id": 10029, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.020.m4a", "display_order": 21}, {"id": 6000029021, "chapter_id": 10029, "verse_number": "२-९-१९", "content_sanskrit": "त्वयाऽहं तोषितः सम्यग्वेदगर्भ सिसृक्षया।\nचिरं भृतेन तपसा दुस्तोषः कूटयोगिनाम्॥ २/९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.021.m4a", "display_order": 22}, {"id": 6000029022, "chapter_id": 10029, "verse_number": "२-९-२०", "content_sanskrit": "वरं वरय भद्रं ते वरेशं माऽभिवाञ्छितम्।\nसर्वश्रेयःपरिश्रामः पुंसां मद्दर्शनावधिः॥ २/९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.022.m4a", "display_order": 23}, {"id": 6000029023, "chapter_id": 10029, "verse_number": "२-९-२१", "content_sanskrit": "मनीषितानुभावोऽयं मम लोकावलोकनम्।\nयदुपश्रुत्य रहसि चकर्थ परमं तपः॥ २/९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.023.m4a", "display_order": 24}, {"id": 6000029024, "chapter_id": 10029, "verse_number": "२-९-२२", "content_sanskrit": "प्रत्यादिष्टं मया तत्र त्वयि कर्मविमोहिते।\nतपो मे हृदयं साक्षादात्माऽहं तपसोऽनघ॥ २/९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.024.m4a", "display_order": 25}, {"id": 6000029025, "chapter_id": 10029, "verse_number": "२-९-२३", "content_sanskrit": "सृजामि तपसैवेदं ग्रसामि तपसा पुनः।\nबिभर्मि तपसा विश्वं वीर्यं मे दुस्तरं तपः॥ २/९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.025.m4a", "display_order": 26}, {"id": 6000029026, "chapter_id": 10029, "verse_number": null, "content_sanskrit": "ब्रह्मोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.026.m4a", "display_order": 27}, {"id": 6000029027, "chapter_id": 10029, "verse_number": "२-९-२४", "content_sanskrit": "भगवन्सर्वभूतानामध्यक्षोऽवस्थितो गुहाम्।\nवेद ह्यप्रतिरुद्धेन प्रज्ञानेन चिकीर्षितम्॥ २/९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.027.m4a", "display_order": 28}, {"id": 6000029028, "chapter_id": 10029, "verse_number": "२-९-२५", "content_sanskrit": "अथापि नाथमानाय नाथ नाथय नाथितम्।\nपरावरे यथा रूपे जानीयां ते त्वरूपिणः॥ २/९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.028.m4a", "display_order": 29}, {"id": 6000029029, "chapter_id": 10029, "verse_number": "२-९-२६", "content_sanskrit": "यथाऽऽत्ममायायोगेन नानाशक्त्युपबृंहितः।\nविलुम्पन् विसृजन् गृह्णन् बिभ्रदात्मानमात्मना॥ २/९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.029.m4a", "display_order": 30}, {"id": 6000029030, "chapter_id": 10029, "verse_number": "२-९-२७", "content_sanskrit": "क्रीडस्यमोघसङ्कल्प ऊर्णनाभिर्यथोर्णुते।\nतथा तद्विषयां धेहि मनीषां मयि माधव॥ २/९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.030.m4a", "display_order": 31}, {"id": 6000029031, "chapter_id": 10029, "verse_number": "२-९-२८", "content_sanskrit": "भगवच्छिक्षितमहं करवाणि ह्यतन्द्रितः।\nनेहमानः प्रजासर्गं बध्येयं यदनुग्रहात्॥ २/९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.031.m4a", "display_order": 32}, {"id": 6000029032, "chapter_id": 10029, "verse_number": "२-९-२९", "content_sanskrit": "यावत्सखा सख्युरिवेश ते कृतः प्रजाविसर्गे विभजामि भोजनम्।\nअविक्लवस्ते परिकर्मणि स्थितो मा मे समुन्नद्धमदोऽजमानिनः॥ २/९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.032.m4a", "display_order": 33}, {"id": 6000029033, "chapter_id": 10029, "verse_number": null, "content_sanskrit": "भगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.033.m4a", "display_order": 34}, {"id": 6000029034, "chapter_id": 10029, "verse_number": "२-९-३०", "content_sanskrit": "ज्ञानं परमगुह्यं मे यद्विज्ञानसमन्वितम्।\nसरहस्यं तदङ्गं च गृहाण गदितं मया॥ २/९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.034.m4a", "display_order": 35}, {"id": 6000029035, "chapter_id": 10029, "verse_number": "२-९-३१", "content_sanskrit": "यावानहं यथा भावो यद्रूपगुणकर्मकः।\nतथैव तस्य विज्ञानमस्तु ते मदनुग्रहात्॥ २/९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.035.m4a", "display_order": 36}, {"id": 6000029036, "chapter_id": 10029, "verse_number": "२-९-३२", "content_sanskrit": "अहमेवासमग्रे च नान्यद् यत् सदसत् परम्।\nपश्चादहं त्वमेतच्च योऽवशिष्येत सोऽस्म्यहम्॥ २/९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.036.m4a", "display_order": 37}, {"id": 6000029037, "chapter_id": 10029, "verse_number": "२-९-३३", "content_sanskrit": "ऋतेऽर्थं यत्प्रतीयेत न प्रतीयेत चात्मनि।\nतद्विद्यादात्मनो मायां यथाऽऽभासो यथातमः॥ २/९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.037.m4a", "display_order": 38}, {"id": 6000029038, "chapter_id": 10029, "verse_number": "२-९-३४", "content_sanskrit": "यथा महान्ति भूतानि भूतेषूच्चावचेषु च।\nप्रविष्टान्यप्रविष्टानि तथा तेषु न तेष्वहम्॥ २/९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.038.m4a", "display_order": 39}, {"id": 6000029039, "chapter_id": 10029, "verse_number": "२-९-३५", "content_sanskrit": "एतावदेव जिज्ञास्यं तत्त्वजिज्ञासुनाऽऽत्मनः।\nअन्वयव्यतिरेकाभ्यां यत्स्यात्सर्वत्र सर्वदा॥ २/९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.039.m4a", "display_order": 40}, {"id": 6000029040, "chapter_id": 10029, "verse_number": "२-९-३६", "content_sanskrit": "एतन्मतं ममातिष्ठ परमेण समाधिना।\nभवान्कल्पविकल्पेषु न विमुह्यति कर्हिचित्॥ २/९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.040.m4a", "display_order": 41}, {"id": 6000029041, "chapter_id": 10029, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.041.m4a", "display_order": 42}, {"id": 6000029042, "chapter_id": 10029, "verse_number": "२-९-३७", "content_sanskrit": "सम्प्रदर्श्यैवमजनो जनानां परमेष्ठिनः।\nपश्यतस्तस्य तद्रूपमात्मनो न्यरुणद्धरिः॥ २/९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.042.m4a", "display_order": 43}, {"id": 6000029043, "chapter_id": 10029, "verse_number": "२-९-३८", "content_sanskrit": "अन्तर्हितेन्द्रियार्थाय हरयेऽवहिताञ्जलिः।\nसर्वभूतमयो विश्वं ससर्जेदं स पूर्ववत्॥ २/९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.043.m4a", "display_order": 44}, {"id": 6000029044, "chapter_id": 10029, "verse_number": "२-९-३९", "content_sanskrit": "प्रजापतिर्धर्मपतिरेकदा नियमान्यमान्।\nभद्रं प्रजानामन्विच्छन्नातिष्ठत्स्वार्थकाम्यया॥ २/९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.044.m4a", "display_order": 45}, {"id": 6000029045, "chapter_id": 10029, "verse_number": "२-९-४०", "content_sanskrit": "तं नारदः प्रियतमो रिक्थादानामनुव्रतः।\nशुश्रूषमाणः शीलेन प्रश्रयेण दमेन च॥ २/९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.045.m4a", "display_order": 46}, {"id": 6000029046, "chapter_id": 10029, "verse_number": "२-९-४१", "content_sanskrit": "मायां विविदिषुर्विष्णोः मायेशस्य महामुनिः।\nमहाभागवतो राजन् पितरं पर्यतोषयत्॥ २/९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.046.m4a", "display_order": 47}, {"id": 6000029047, "chapter_id": 10029, "verse_number": "२-९-४२", "content_sanskrit": "तुष्टं निशाम्य पितरं लोकानां प्रपितामहम्।\nदेवर्षिः परिपप्रच्छ भवान्यन्माऽनुपृच्छति॥ २/९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.047.m4a", "display_order": 48}, {"id": 6000029048, "chapter_id": 10029, "verse_number": "२-९-४३", "content_sanskrit": "तस्मा इदं भागवतं पुराणं दशलक्षणम्।\nप्रोक्तं भगवता प्राह प्रीतः पुत्राय भूतकृत्॥ २/९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.048.m4a", "display_order": 49}, {"id": 6000029049, "chapter_id": 10029, "verse_number": "२-९-४४", "content_sanskrit": "नारदः प्राह मुनये सरस्वत्यास्तटे नृप।\nध्यायते ब्रह्म परमं व्यासायामिततेजसे॥ २/९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.049.m4a", "display_order": 50}, {"id": 6000029050, "chapter_id": 10029, "verse_number": "२-९-४५", "content_sanskrit": "यदुताहं त्वया पृष्टो वैराजात्पुरुषादिदम्।\nयथाऽऽसीत्तदुपाख्यास्ये प्रश्नानन्यांश्च कृत्स्नशः॥ २/९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_009/BhP_02.009.050.m4a", "display_order": 51}, {"id": 6000029051, "chapter_id": 10029, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वितीयस्कन्धे नवमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]