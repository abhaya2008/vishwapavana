[{"id": 900004868, "chapter_id": 8371, "verse_number": "2.1", "content_sanskrit": "नत्वा नारायणं देवं पूर्णबोधाधिकान् गुरून् । व्याख्यास्यामि यथाबोधं पौरुषं सूक्तमुत्तमम् ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900004869, "chapter_id": 8371, "verse_number": "2.2", "content_sanskrit": "पुरुषसूक्तप्रतिपाद्यो विष्णुरेवेति समर्थनम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}]