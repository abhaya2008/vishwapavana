[{"id": 7001798000, "chapter_id": 21798, "verse_number": "२-५९-१", "content_sanskrit": "वसुरुवाच ।\nयोऽसौ निरंजनो देवश्चित्स्वरूपी जनार्दनः ।\nज्योतीरूपो महाभागे कृष्णस्तल्लक्षणं श्रृणु ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001798001, "chapter_id": 21798, "verse_number": "२-५९-२", "content_sanskrit": "गोलोके स विभुर्नित्यं ज्योतिरभ्यंतरे स्थितः ।\nएक एव परं ब्रह्म दृश्यादृष्यस्वरूपधृक् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001798002, "chapter_id": 21798, "verse_number": "२-५९-३", "content_sanskrit": "तस्मिँल्लोके तु गावो हि गोपा गोप्यश्च मोहिनि ।\nवृन्दावनं पूर्वतश्च शतश्रृंगस्तथा सरित् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001798003, "chapter_id": 21798, "verse_number": "२-५९-४", "content_sanskrit": "विरजा नाम वृक्षाश्च पक्षिणश्च पृथग्विधाः ।\nयावत्कालं तु प्रकृतिर्जागर्ति विधिनंदिनि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001798004, "chapter_id": 21798, "verse_number": "२-५९-५", "content_sanskrit": "तावत्कालं तु गोलोके दृश्य एव विभुः स्थितः ।\nलये सुप्ता गवाद्यास्तु न जानंति विभुं परम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001798005, "chapter_id": 21798, "verse_number": "२-५९-६", "content_sanskrit": "ज्योतिःसमूहांतरतः कमनीयवपुर्द्धरः ।\nकिशोरो जलदश्यामः पीतकौशांबरावृतः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001798006, "chapter_id": 21798, "verse_number": "२-५९-७", "content_sanskrit": "द्विभुजो मुरलीहस्तः किरूटादिविभूषितः ।\nआस्ते कैवल्यनाथस्तु राधावक्षस्थलोज्ज्वलः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001798007, "chapter_id": 21798, "verse_number": "२-५९-८", "content_sanskrit": "प्राणाधिकप्रियतमा सा राधाराधितो यया ।\nसुवर्णवर्णा देवी सा चिद्रूपा प्रकृतेः परा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001798008, "chapter_id": 21798, "verse_number": "२-५९-९", "content_sanskrit": "तयोर्देहस्थयोर्नास्ति भेदो नित्यस्वरूपयोः ।\nधावल्यदुग्धयोर्यद्वत्पृथिवीगंधयोर्यथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001798009, "chapter_id": 21798, "verse_number": "२-५९-१०", "content_sanskrit": "तत्कारणं कारणानां निर्द्देष्टुं नैव शक्यते ।\nवेदानिर्वचनीयं यत्तद्वक्तुं नैव शक्यते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001798010, "chapter_id": 21798, "verse_number": "२-५९-११", "content_sanskrit": "ज्योतिरंतरतः प्रोक्तं यद्रूपं श्यामसुंदरम् ।\nशिवेन दृष्टं तद्रूपं कदाचिद्ध्यानगोचरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001798011, "chapter_id": 21798, "verse_number": "२-५९-१२", "content_sanskrit": "ततः प्रभृति जानंति गोलोकाख्यानमीप्सितम् ।\nनारदाद्या विधिसुते सनकाद्याश्च योगिनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001798012, "chapter_id": 21798, "verse_number": "२-५९-१३", "content_sanskrit": "श्रुतं ध्यायंति तं सर्वे न तैर्दृष्टं कदाचन ।\nसाक्षाद्द्रष्टुं तु तपते शिवोऽद्यापि सनातनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001798013, "chapter_id": 21798, "verse_number": "२-५९-१४", "content_sanskrit": "नैव पश्यति तद्रूपं ध्यायति ध्यानगोचरम् ।\nकदाचित्क्रीडतोर्देवि राधामाधवयोर्वपुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001798014, "chapter_id": 21798, "verse_number": "२-५९-१५", "content_sanskrit": "द्विधाभूतमभूत्तत्र वामांगं तु चतुर्भुजम् ।\nसमानरूपावयवं समानांबरभूषणम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001798015, "chapter_id": 21798, "verse_number": "२-५९-१६", "content_sanskrit": "तद्वद्राधास्वरूपं च द्विधारूपमभूत्सति ।\nताभ्यां दृष्टं तत्स्वरूपं साक्षात्तावपि तत्समौ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001798016, "chapter_id": 21798, "verse_number": "२-५९-१७", "content_sanskrit": "चतुर्भुजं तु यद्रूपं लक्ष्मीकांतं मनोहरम् ।\nतद्दृष्टं तु शिवाद्यैश्च भक्तवृन्दैरनेकशः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001798017, "chapter_id": 21798, "verse_number": "२-५९-१८", "content_sanskrit": "सकृत्तु ब्रह्मणा दृष्टं देवि रूपं चतुर्भुजम् ।\nसृष्टिकार्यप्रमुग्धेन दर्शितं कृपया स्वयम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001798018, "chapter_id": 21798, "verse_number": "२-५९-१९", "content_sanskrit": "लक्ष्म्या सनात्कुमाराय वर्णितं विधिनंदिनि ।\nविष्वक्सेनाय तूद्दिष्टं स्वरूपं तत्त्वमूर्तये ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001798019, "chapter_id": 21798, "verse_number": "२-५९-२०", "content_sanskrit": "नारायणेन विधिजे ततो ध्यायंति सर्वशः ।\nधर्मपुत्रेण देवेशि नारदाय समीरितम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001798020, "chapter_id": 21798, "verse_number": "२-५९-२१", "content_sanskrit": "गोलोकवर्णनं सर्वं राधाकृष्णमयं तथा ।\nया तु राधा विधिसुते देवी देववरार्चिता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001798021, "chapter_id": 21798, "verse_number": "२-५९-२२", "content_sanskrit": "सा स्वयं शिवरूपाभूत्कौतुकेन वरानने ।\nतदृष्ट्वा सहसाश्चर्यं कृष्णो योगेश्वरेश्वरः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001798022, "chapter_id": 21798, "verse_number": "२-५९-२३", "content_sanskrit": "मूलप्रकृतिरूपं तु दध्रे तत्समयोचितम् ।\nविपरीतं वपुर्धृत्वा वामदेवो मुदान्वितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001798023, "chapter_id": 21798, "verse_number": "२-५९-२४", "content_sanskrit": "ध्यायेदहर्निशं देवं दुर्गारूप धरं हरिम् ।\nया राधा सैव लक्ष्मीस्तु सावित्री च सरस्वती ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001798024, "chapter_id": 21798, "verse_number": "२-५९-२५", "content_sanskrit": "गंगा च ब्रह्मतनये नैव भेदोऽस्ति वस्तुतः ।\nपंचधा सा स्थिता विद्याकामधेनुस्वरूपिणी ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001798025, "chapter_id": 21798, "verse_number": "२-५९-२६", "content_sanskrit": "यः कृष्णो राधिकानाथः स लक्ष्मीशः प्रकीर्तितः ।\nस एव ब्रह्मरूपश्च धर्मो नारायणस्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001798026, "chapter_id": 21798, "verse_number": "२-५९-२७", "content_sanskrit": "एवं तु पंचधा रूपमास्थितो भगवानजः ।\nकार्यकारणरूपोऽसौ ध्यांयंति जगतीतले ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001798027, "chapter_id": 21798, "verse_number": "२-५९-२८", "content_sanskrit": "तेन वै प्रेमसंबद्धो विषयी यः शिवः स तु ।\nराधेशं राधिकारूपं स्वयं सच्चित्सुखात्मकम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001798028, "chapter_id": 21798, "verse_number": "२-५९-२९", "content_sanskrit": "देवतेजः समुद्भूता मूलप्रकृतिरीश्वरी ।\nकृष्णरूपा महाभागे दैत्यसंहारकारिणी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001798029, "chapter_id": 21798, "verse_number": "२-५९-३०", "content_sanskrit": "सती दक्षसुता भूत्वा विषयेशं शिवं श्रिता ।\nभर्तुर्विनिंदनं श्रुत्वा सती त्यक्त्वा कलेवरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001798030, "chapter_id": 21798, "verse_number": "२-५९-३१", "content_sanskrit": "जज्ञे हिमवतः क्षेत्रे मेनायां पुनरेव च ।\nततस्तप्त्वा तपो भद्रे शिवं प्राप शिवप्रदा ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001798031, "chapter_id": 21798, "verse_number": "२-५९-३२", "content_sanskrit": "वस्तुतः कृष्णराधासौ शिवमोहनतत्परा ।\nजगदंबास्वरूपा च यतो माया स्वयं विभुः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001798032, "chapter_id": 21798, "verse_number": "२-५९-३३", "content_sanskrit": "अत एव ब्रह्मसुते स्कंदो गणपतिस्तथा ।\nस्वयं कृष्णो गणपतिः स्वयं स्कंदः शिवोऽभवत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001798033, "chapter_id": 21798, "verse_number": "२-५९-३४", "content_sanskrit": "शिवमेवं वदंत्येके राधारूपं समाश्रितम् ।\nकृष्णवक्षःस्थलस्थानं तयोर्भेदो न लक्ष्यते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001798034, "chapter_id": 21798, "verse_number": "२-५९-३५", "content_sanskrit": "कृष्णो वा मूलप्रकृतिः शिवो वा राधिका स्वयम् ।\nएवं वा मिथुनं वापि न केनापीति निश्चितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001798035, "chapter_id": 21798, "verse_number": "२-५९-३६", "content_sanskrit": "अनिर्देश्यं तु यद्वस्तु तन्निर्देष्टुं न च क्षमम् ।\nउपलक्षणमेतद्धि यन्निदेशनमैश्वरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001798036, "chapter_id": 21798, "verse_number": "२-५९-३७", "content_sanskrit": "शास्त्रं वेदाश्च सुभगे वर्णयंति यदीश्वरम् ।\nतत्सर्वं प्राकृतं विद्धिनिर्देष्टुं शक्यमेव च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001798037, "chapter_id": 21798, "verse_number": "२-५९-३८", "content_sanskrit": "अनिर्देश्यं तु यद्देवि तन्नेतीति निषिध्तयते ।\nनिषेधशेषः स विभुः कीर्तितः शरणागतैः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001798038, "chapter_id": 21798, "verse_number": "२-५९-३९", "content_sanskrit": "शास्त्रं नियामकं भद्रे सर्वेषां कर्मणां भवेत् ।\nकर्मी तु जीवः कथित ईश्वरांशो विभुः स्वयम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001798039, "chapter_id": 21798, "verse_number": "२-५९-४०", "content_sanskrit": "प्रकृतेस्तु परो नित्यो मायया मोहितः शुभे ।\nयस्तु साक्षी स्वयं पूर्णः सहानुशयिता स्थितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001798040, "chapter_id": 21798, "verse_number": "२-५९-४१", "content_sanskrit": "न वेत्ति तं चानुशयी वेदानुशयिनं स तु ।\nशंखचक्रगदापद्मैरलंकृतभुजद्वयाः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001798041, "chapter_id": 21798, "verse_number": "२-५९-४२", "content_sanskrit": "प्रपन्नास्ते तु विज्ञेयाः द्विविधा विधिनंदिनि ।\nआर्तदृप्तविभेदेन तत्रार्ता असहा मताः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001798042, "chapter_id": 21798, "verse_number": "२-५९-४३", "content_sanskrit": "दृप्ता जन्मांतरसहा निर्भयाः सदसज्जनाः ।\nये प्रपन्ना महालक्ष्म्यां सखिभावं समाश्रिताः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001798043, "chapter_id": 21798, "verse_number": "२-५९-४४", "content_sanskrit": "तेषां मंत्रं प्रवक्ष्यामि प्रयांति विधिबोधितम् ।\nगोपीजनपदस्यांते वल्लभेति समुच्चरेत् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001798044, "chapter_id": 21798, "verse_number": "२-५९-४५", "content_sanskrit": "चरणञ्च्छरणं पश्चात्प्रपद्ये पदमीरयेत् ।\nषोडशार्णो मंत्रराजः साक्षाल्लक्ष्म्या प्रकाशितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001798045, "chapter_id": 21798, "verse_number": "२-५९-४६", "content_sanskrit": "पूर्वं सनत्कुमाराय शंभवे तदनंतरम् ।\nसखिभावं समाश्रित्य गोपिकावृंदमध्यगम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001798046, "chapter_id": 21798, "verse_number": "२-५९-४७", "content_sanskrit": "आत्मानं चिंतयेद्भद्रे राधामाधवसंज्ञकम् ।\nगुरुष्वीश्वरभावेन वर्त्तेत प्रणतः सदा ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001798047, "chapter_id": 21798, "verse_number": "२-५९-४८", "content_sanskrit": "वैष्णवेषेु च सत्कृत्य तथा समतयान्यतः ।\nदिवानिशं चिंतनं च स्वामिनोः प्रेमबंधनात् ।\nकुर्यांत्पर्वस्वपि सदा यात्रापर्वमहोत्सवान् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]