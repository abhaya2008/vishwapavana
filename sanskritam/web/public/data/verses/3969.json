[{"id": 2136943, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2136944, "chapter_id": 3969, "verse_number": "१", "content_sanskrit": "ततः काले बहुतिथे व्यतिक्रान्ते कदाचन ।\nप्राप्तः स कालो मर्तव्यं यत्र सत्यवता नृप \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2136945, "chapter_id": 3969, "verse_number": "२", "content_sanskrit": "गणयन्त्याश्च सावित्र्या दिवसे दिवसे गते ।\nयद्वाक्यं नारदेनोक्तं वर्तते हृदि नित्यशः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2136946, "chapter_id": 3969, "verse_number": "३", "content_sanskrit": "चतुर्थेऽहनि मर्तव्यमिति सञ्चिन्त्य भाविनी ।\nव्रतं त्रिरात्रमुद्दिश्य दिवारात्रं स्थिताऽभवत् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2136947, "chapter_id": 3969, "verse_number": "४", "content_sanskrit": "त्रयोदश्यां चोपवासं प्रतिपत्सु च पारणम् ।\nआयुष्यं वर्धते भर्तुर्व्रतेनानेन भारत \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2136948, "chapter_id": 3969, "verse_number": "५", "content_sanskrit": "तं श्रुत्वा नियमं तस्या भृशं दुःखान्वितो नृपः ।\nउत्थाय वाक्यं सावित्रीमब्रवीत् परिसान्त्वयन् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2136949, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "द्युमत्सेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2136950, "chapter_id": 3969, "verse_number": "६", "content_sanskrit": "अतितीव्रोऽयमारम्भस्त्वयाऽऽरब्धो नृपात्मजे ।\nतिसॄणां वसतीनां हि स्थानं परमदुश्चरम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2136951, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2136952, "chapter_id": 3969, "verse_number": "७", "content_sanskrit": "न कार्यस्तात सन्तापः पारयिष्याम्यहं व्रतम् ।\nव्यवसायकृतं हीदं व्यवसायश्च कारणम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2136953, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "द्युमत्सेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2136954, "chapter_id": 3969, "verse_number": "८", "content_sanskrit": "व्रतं भिन्धीति वक्तुं त्वां नास्मि शक्तः कथञ्चन ।\nपारयस्वेति वचनं युक्तमस्मद्विधो वदेत् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2136955, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2136956, "chapter_id": 3969, "verse_number": "९", "content_sanskrit": "एवमुक्त्वा द्युमत्सेनो विरराम महामनाः ।\nतिष्ठन्ती सापि सावित्री काष्ठभूतेव लक्ष्यते \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2136957, "chapter_id": 3969, "verse_number": "१०", "content_sanskrit": "श्वोभूते भर्तृमरणे सावित्र्या भरतर्षभ ।\nदुःखान्वितायास्तिष्ठन्त्याः सा रात्रिर्व्यत्यवर्तत \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2136958, "chapter_id": 3969, "verse_number": "११", "content_sanskrit": "अद्य तद् दिवसं चेति हुत्वा दीप्तं हुताशनम् ।\nयुगमात्रोदिते सूर्ये कृत्वा पौर्वाह्णिकीः क्रियाः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2136959, "chapter_id": 3969, "verse_number": "१२", "content_sanskrit": "व्रतं समाप्य सावित्री स्नात्वा शुद्धा यशस्विनी ।\nततः सर्वान् द्विजान् वृद्धान् श्वश्रूं श्वशुरमेव च ।\nअभिवाद्यानुपूर्व्येण प्राञ्जलिर्नियता स्थिता \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2136960, "chapter_id": 3969, "verse_number": "१३", "content_sanskrit": "अवैधव्याशिषस्ते तु सावित्र्यर्थं हिताः शुभाः ।\nऊचुस्तपस्विनः सर्वे तपोवननिवासिनः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2136961, "chapter_id": 3969, "verse_number": "१४", "content_sanskrit": "एवमस्त्विति सावित्री ध्यानयोगपरायणा ।\nमनसा ता गिरः सर्वा प्रत्यगृह्णात् तपस्विनाम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2136962, "chapter_id": 3969, "verse_number": "१५", "content_sanskrit": "तं कालं तं मुहूर्तं च प्रतीक्षन्ती नृपात्मजा ।\nयथोक्तं नारदवचश्चिन्तयन्ती सुदुःखिता \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2136963, "chapter_id": 3969, "verse_number": "१६", "content_sanskrit": "ततस्तु श्वश्रूश्वशुरावूचतुस्तां नृपात्मजाम् ।\nएकान्तमास्थितां वाक्यं प्रीत्या भरतसत्तम \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2136964, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "श्वशुरौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2136965, "chapter_id": 3969, "verse_number": "१७", "content_sanskrit": "व्रतं यथोपदिष्टं तु तथा तत्पारितं त्वया ।\nआहारकालः सम्प्राप्तः क्रियतां यदनन्तरम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2136966, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2136967, "chapter_id": 3969, "verse_number": "१८", "content_sanskrit": "अस्तं गते मयाऽऽदित्ये भोक्तव्यं कृतकामया ।\nएष मे हृदि सङ्कल्पः समयश्च कृतो मया \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2136968, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2136969, "chapter_id": 3969, "verse_number": "१९", "content_sanskrit": "एवं सम्भाषमाणायाः सावित्र्या भोजनं प्रति ।\nस्कन्धे परशुमादाय सत्यवान् प्रस्थितो वनम् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2136970, "chapter_id": 3969, "verse_number": "२०", "content_sanskrit": "सावित्री त्वाह भर्तारं नैकस्त्वं गन्तुमर्हसि ।\nसह त्वया गमिष्यामि न हि त्वां हातुमुत्सहे \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2136971, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "सत्यवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2136972, "chapter_id": 3969, "verse_number": "२१", "content_sanskrit": "वनं न गतपूर्वं ते दुःखः पन्थाश्च भाविनि ।\nव्रतोपवासक्षामा च कथं पद्भ्यां गमिष्यसि \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2136973, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2136974, "chapter_id": 3969, "verse_number": "२२", "content_sanskrit": "उपवासान्न मे ग्लानिर्नास्ति चापि परिश्रमः ।\nगमने च कृतोत्साहां प्रतिषेद्धुं न मार्हसि \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2136975, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "सत्यवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2136976, "chapter_id": 3969, "verse_number": "२३", "content_sanskrit": "यदि ते गमनोत्साहः करिष्यामि तव प्रियम् ।\nमम त्वामन्त्रय गुरून्न मां दोषः स्पृशेदयम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2136977, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2136978, "chapter_id": 3969, "verse_number": "२४", "content_sanskrit": "साभिवाद्याब्रवीत् श्वश्रूं श्वशुरं च महाव्रता \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2136979, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "सावित्री", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2136980, "chapter_id": 3969, "verse_number": "२५", "content_sanskrit": "अयं गच्छति मे भर्ता फलाहारो महावनम् ।\nइच्छेयमभ्यनुज्ञाता आर्यया श्वशुरेण ह ।\nअनेन सह निर्गन्तुं न मेऽद्य विरहः क्षमः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2136981, "chapter_id": 3969, "verse_number": "२६", "content_sanskrit": "गुर्वग्निहोत्रार्थकृते प्रस्थितश्च सुतस्तव ।\nन निवार्यो निवार्यः स्यादन्यथा प्रस्थितो वनम् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2136982, "chapter_id": 3969, "verse_number": "२७", "content_sanskrit": "संवत्सरः किञ्चिदूनो न निष्क्रान्ताहमाश्रमात् ।\nवनं कुसुमितं द्रष्टुं परं कौतूहलं हि मे \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2136983, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "द्युमत्सेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2136984, "chapter_id": 3969, "verse_number": "२८", "content_sanskrit": "यतः प्रभृति सावित्री पित्रा दत्ता स्नुषा मम ।\nअनयाभ्यर्थनायुक्तमुक्तपूर्वं स्मराम्यहम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2136985, "chapter_id": 3969, "verse_number": "२९", "content_sanskrit": "तदेषा लभतां कामं यथाभिलषितं वधूः ।\nअप्रमादश्च कर्तव्यः पुत्रि सत्यवतः पथि \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2136986, "chapter_id": 3969, "verse_number": "", "content_sanskrit": "मार्कण्डेयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2136987, "chapter_id": 3969, "verse_number": "३०", "content_sanskrit": "उभाभ्यामभ्यनुज्ञाता सा जगाम यशस्विनी ।\nसह भर्त्रा हसन्तीव हृदयेन विदूयता \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2136988, "chapter_id": 3969, "verse_number": "३१", "content_sanskrit": "सा वनानि विचित्राणि रमणीयानि सर्वशः ।\nमयूरगणजुष्टानि ददर्श विपुलेक्षणा \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2136989, "chapter_id": 3969, "verse_number": "३२", "content_sanskrit": "नदीः पुण्यवहाश्चैव पुष्पितांश्च नगोत्तमान् ।\nसत्यवानाह पश्येति सावित्रीं मधुरं वचः \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2136990, "chapter_id": 3969, "verse_number": "३३", "content_sanskrit": "निरीक्षमाणा भर्तारं सर्वावस्थमनिन्दिता ।\nमृतमेव हि तं मेने काले मुनिवचः स्मरत् \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2136991, "chapter_id": 3969, "verse_number": "३४", "content_sanskrit": "अनुव्रजन्ती भर्तारं जगाम मृदुगामिनी ।\nद्विधेव हृदयं कृत्वा तं च कालमवेक्षती \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2136992, "chapter_id": 3969, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि पतिव्रता- माहात्म्यपर्वणि सावित्र्युपाख्याने पञ्चाशीत्यधिकद्विशततमोऽध्यायः ॥२८५॥\nसावित्र्युपाख्यानपर्वणि चतुर्थोऽध्यायः ॥४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]