[{"id": 2001781, "chapter_id": 1033, "verse_number": "१-३४-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001782, "chapter_id": 1033, "verse_number": "१-३४-१", "content_sanskrit": "इत्येवमुक्तो गरुडः प्रत्युवाच शचीपतिम्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001783, "chapter_id": 1033, "verse_number": "१-३४-१x", "content_sanskrit": "गरुड उवाच।\nसख्यं मेऽस्तु त्वया देव यथेच्छसि पुरंदर।\nबलं तु मम जानीहि महच्चासह्यमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001784, "chapter_id": 1033, "verse_number": "१-३४-२", "content_sanskrit": "कामं नैतत्प्रशंसन्ति सन्तः स्वबलसंस्तवम्।\nअनिमित्तं सुरश्रेष्ठ सद्यः प्राप्नोति गर्हणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001785, "chapter_id": 1033, "verse_number": "१-३४-३", "content_sanskrit": "गुणसंकीर्तनं चापि पृष्टेनान्येन गोपते।\nवक्तव्यं न तु वक्तव्यं स्वयमेव शतक्रतो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001786, "chapter_id": 1033, "verse_number": "१-३४-४", "content_sanskrit": "सखेति कृत्वा तु सखे पृष्टो वक्ष्याम्यहं त्वया।\nन ह्यात्मस्तवसंयुक्तं वक्तव्यमनिमित्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001787, "chapter_id": 1033, "verse_number": "१-३४-५", "content_sanskrit": "सपर्वतवनामुर्वीं ससागरजलामिमाम्।\nवहे पक्षेण वै शक्र त्वामप्यत्रावलम्बिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001788, "chapter_id": 1033, "verse_number": "१-३४-६", "content_sanskrit": "सर्वान्संपिण्डितान्वापि लोकान्सस्थाणुजङ्गमान्।\nवहेयमपरिश्रान्तो विद्धीदं मे महद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001789, "chapter_id": 1033, "verse_number": "१-३४-७x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001790, "chapter_id": 1033, "verse_number": "१-३४-७", "content_sanskrit": "इत्युक्तवचनं वीरं किरीटी श्रीमतां वरः।\nआह शौनक देवेन्द्रः सर्वलोकहितः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001791, "chapter_id": 1033, "verse_number": "१-३४-८", "content_sanskrit": "एवमेव यथात्थ त्वं सर्वं संभाव्यते त्वयि।\nसंगृह्यतामिदानीं मे सख्यमत्यन्तमुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001792, "chapter_id": 1033, "verse_number": "१-३४-९", "content_sanskrit": "न कार्यं यदि सोमेन मम सोमः प्रदीयताम्।\nअस्मांस्ते हि प्रबाधेयुर्येभ्यो दद्याद्भवानिमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001793, "chapter_id": 1033, "verse_number": "१-३४-१०x", "content_sanskrit": "गरुड उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001794, "chapter_id": 1033, "verse_number": "१-३४-१०", "content_sanskrit": "किंचित्कारणमुद्दिश्य सोमोऽयं नीयते मया।\nन दास्यामि समापातुं सोमं कस्मैचिदप्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001795, "chapter_id": 1033, "verse_number": "१-३४-११", "content_sanskrit": "यत्रेमं तु सहस्राक्ष निक्षिपेयमहं स्वयम्।\nत्वमादाय ततस्तृर्णं हरेथास्त्रिदिवेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001796, "chapter_id": 1033, "verse_number": "१-३४-१२x", "content_sanskrit": "शक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001797, "chapter_id": 1033, "verse_number": "१-३४-१२", "content_sanskrit": "वाक्येनानेन तुष्टोऽहं यत्त्वयोक्तमिहाण्डज।\nयमिच्छसि वरं मत्तस्तं गृहाण खगोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001798, "chapter_id": 1033, "verse_number": "१-३४-१३x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001799, "chapter_id": 1033, "verse_number": "१-३४-१३", "content_sanskrit": "इत्युक्तः प्रत्युवाचेदं कद्रूपुत्राननुस्मरन्।\nभवेयुर्भुजगाः शक्र मम भक्ष्या महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001800, "chapter_id": 1033, "verse_number": "१-३४-१४x", "content_sanskrit": "गरुड उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001801, "chapter_id": 1033, "verse_number": "१-३४-१४", "content_sanskrit": "ईशोऽहमपि सर्वस्य करिष्यामि तु तेऽर्थिताम्।\nभवेयुर्भुजगाः शक्र मम भक्ष्या महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001802, "chapter_id": 1033, "verse_number": "१-३४-१५x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001803, "chapter_id": 1033, "verse_number": "१-३४-१५", "content_sanskrit": "तथेत्युक्त्वाऽन्वगच्छत्तं ततो दानवसूदनः।\nदेवदेवं महात्मानं योगिनामीश्वरं हरिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001804, "chapter_id": 1033, "verse_number": "१-३४-१६", "content_sanskrit": "स चान्वमोदत्तं चार्थं यथोक्तं गरुडेन वै।\nइदं भूयो वचः प्राह भगवांस्त्रिदशेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001805, "chapter_id": 1033, "verse_number": "१-३४-१७", "content_sanskrit": "हरिष्यामि विनिक्षिप्तं सोममित्यनुभाष्य तम्।\nआजगाम ततस्तूर्णं सुपर्णी मातुरन्तिकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001806, "chapter_id": 1033, "verse_number": "१-३४-१८", "content_sanskrit": "विनयावनतो भूत्वा वचनं चेदमब्रवीत्।\nइदमानीतममृतं देवानां भवनान्मया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001807, "chapter_id": 1033, "verse_number": "१-३४-१९", "content_sanskrit": "प्रशाधि किमितो मातः करिष्यामि शुभव्रते।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001808, "chapter_id": 1033, "verse_number": "१-३४-१९x", "content_sanskrit": "विनतोवाच।\nपरितुष्टाऽहमेतेन कर्मणा तव पुत्रक॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001809, "chapter_id": 1033, "verse_number": "१-३४-२०", "content_sanskrit": "अजरश्चाभरश्चैव देवानां सुप्रियो भव।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2001810, "chapter_id": 1033, "verse_number": "१-३४-२०x", "content_sanskrit": "सौतिरुवाच।\nअथ सर्पानुवाचेदं सर्वान्परमहृष्टवत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2001811, "chapter_id": 1033, "verse_number": "१-३४-२०x", "content_sanskrit": "गरुड उवाच।\nइदमानीतममृतं निक्षेप्स्यामि कुशेषु वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2001812, "chapter_id": 1033, "verse_number": "१-३४-२१", "content_sanskrit": "स्नाता मङ्गलसंयुक्तास्ततः प्राश्नीत पन्नगाः।\nभवद्भिरिदमासीनैर्यदुक्तं तद्वचस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2001813, "chapter_id": 1033, "verse_number": "१-३४-२२", "content_sanskrit": "अदासी चैव मातेयमद्यप्रभृति चास्तु मे।\nयथोक्तं भवतामेतद्वचो मे प्रतिपादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2001814, "chapter_id": 1033, "verse_number": "१-३४-२३x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2001815, "chapter_id": 1033, "verse_number": "१-३४-२३", "content_sanskrit": "ततः स्नातुं गताः सर्पाः प्रत्युक्त्वा तं तथेत्युत।\nशक्रोऽप्यमृतमाक्षिप्य जगाम त्रिदिवं पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2001816, "chapter_id": 1033, "verse_number": "१-३४-२४", "content_sanskrit": "अथागतास्तमुद्देशं सर्पाः सोमार्थिनस्तदा।\nस्नाताश्च कुतजप्याश्च प्रहृष्टाः कृतमङ्गलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2001817, "chapter_id": 1033, "verse_number": "१-३४-२५", "content_sanskrit": "परस्परकृतद्वेषाः सोमप्राशनकर्मणि।\nअहं पूर्वमहं पूर्वमित्युक्त्वा ते समाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2001818, "chapter_id": 1033, "verse_number": "१-३४-२६", "content_sanskrit": "यत्रैतदमृतं चापि स्थापितं कुशसंस्तरे।\nतद्विज्ञाय हृतं सर्पाः प्रतिमायाकृतं च तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2001819, "chapter_id": 1033, "verse_number": "१-३४-२७", "content_sanskrit": "सोमस्थानमिदं चेति दर्भांस्ते लिलिहुस्तदा।\nततो द्विधा कृता जिह्वाः सर्पाणां तेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2001820, "chapter_id": 1033, "verse_number": "१-३४-२८", "content_sanskrit": "अभवंश्चामृतस्पर्शाद्दर्भास्तेऽथ पवित्रिणः।\nनागाश्च वञ्चिता भूत्वा विसृज्य विनतां ततः।\nविषादमगमंस्तीव्रं गरुडस्य बलात्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2001821, "chapter_id": 1033, "verse_number": "१-३४-२९", "content_sanskrit": "एवं तदमृतं तेन हृतमाहृतमेव च।\nद्विजिह्वाश्च कृताः सर्पा गरुडेन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2001822, "chapter_id": 1033, "verse_number": "१-३४-३०", "content_sanskrit": "ततः सुपर्णः परमप्रहर्षवा-\nन्विहृत्य मात्रा सह तत्र कानने।\nभुजंगभक्षः परमार्चितः खगै-\nरहीनकीर्तिर्विनतामनन्दयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2001823, "chapter_id": 1033, "verse_number": "१-३४-३१", "content_sanskrit": "इमां कथां यः शृणुयान्नरः सदा\nपठेत वा द्विजगणमुख्यसंसदि।\nअसंशयं त्रिदिवमियात्स पुण्यभा-\nङ्महात्मनः पतगपतेः प्रकीर्तनात्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2001824, "chapter_id": 1033, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि चतुस्त्रिंशोऽध्यायः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]