[{"id": 7002557000, "chapter_id": 22557, "verse_number": "२-३-१", "content_sanskrit": "सूत उवाच ।\nध्रुवादूर्ध्वं महर्लोकः कोटियोजनविस्तरः ।\nकल्पाभिकरणे तत्र संस्थिता द्विजपुङ्गवाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002557001, "chapter_id": 22557, "verse_number": "२-३-२", "content_sanskrit": "जनलोको महर्लोकात्तथा कोटिद्वयात्मकः ।\nसनंदनादयस्तत्र संस्थिता ब्रह्मणः सुताः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002557002, "chapter_id": 22557, "verse_number": "२-३-३", "content_sanskrit": "जनलोकात्तपोलोकः कोटित्रयसमन्वितः ।\nविराजंते तु देवा वै स्थिता दाह विवर्जिताः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002557003, "chapter_id": 22557, "verse_number": "२-३-४", "content_sanskrit": "प्राजापत्यात्तु भूर्लोकः कोटिषट्केन संयुतः ।\nसनत्कुमारकस्तत्र ब्रह्मलोकस्तु स स्मृतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002557004, "chapter_id": 22557, "verse_number": "२-३-५", "content_sanskrit": "तत्र लोके गुरुर्ब्रह्मा विश्वात्मा विश्वतोमुखः ।\nआस्ते यद्योगिभिः पीत्वा योगं मृत्योः परं गतम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002557005, "chapter_id": 22557, "verse_number": "२-३-६", "content_sanskrit": "गायंति यतयो गाथा ह्यास्तिका ब्रह्मवादिनः ।\nयोगिनस्तापसाः सिद्धा जापकाः परमेष्ठिनम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002557006, "chapter_id": 22557, "verse_number": "२-३-७", "content_sanskrit": "द्वारं तु योगिनामेकं गच्छतां परमं पदम् ।\nतत्र गत्वा न शोचंति स विष्णुः स च शंकरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002557007, "chapter_id": 22557, "verse_number": "२-३-८", "content_sanskrit": "सूर्यकोटिप्रतीकाशं पुरं तस्य दुरासदम् ।\nन मे वर्णयितुं शक्यं ज्वालामालासमाकुलम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002557008, "chapter_id": 22557, "verse_number": "२-३-९", "content_sanskrit": "तत्र नारायणस्यापि भवनं ब्रह्मणः पुरे ।\nशेषे तस्य हरिः श्रीमान्मायासहचरः परः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002557009, "chapter_id": 22557, "verse_number": "२-३-१०", "content_sanskrit": "स विष्णुर्लोककथितः पुनरावृत्तिवर्जितः ।\nप्रयांति च महात्मानो ये प्रपन्ना जनार्दनम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002557010, "chapter_id": 22557, "verse_number": "२-३-११", "content_sanskrit": "ऊर्ध्वं ब्रह्मासनात्पूर्वं परं ज्योतिर्मयं शुभम् ।\nवह्निना उपरि क्षिप्तं तत्रास्ते भगवान्भवः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002557011, "chapter_id": 22557, "verse_number": "२-३-१२", "content_sanskrit": "देव्या सह महादेवश्चिन्त्यमानो मनीषिभिः ।\nयोगिभिः शतसाहस्रैर्वृतैकत्वैश्च संवृतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002557012, "chapter_id": 22557, "verse_number": "२-३-१३", "content_sanskrit": "तत्र ते यांति नियता द्विजा वै ब्रह्मवादिनः ।\nमहादेवपरेशानास्तापसा ब्रह्मवादिनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002557013, "chapter_id": 22557, "verse_number": "२-३-१४", "content_sanskrit": "निर्ममा निरहंकाराः कामक्रोधविवर्जिताः ।\nद्रक्ष्यंति ब्रह्मणा युक्ता रुद्रलोकः स वै स्मृतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002557014, "chapter_id": 22557, "verse_number": "२-३-१५", "content_sanskrit": "एते सप्त महर्लोकाः पृथिव्यां परिकीर्तिताः ।\nमहीतलादयश्चाधः पातालाः संति वै द्विजाः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002557015, "chapter_id": 22557, "verse_number": "२-३-१६", "content_sanskrit": "महातलं हैमतलं सर्ववर्णोपशोभितम् ।\nप्रासादैर्विविधैः शुभ्रैर्देवतायतनैर्युतम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002557016, "chapter_id": 22557, "verse_number": "२-३-१७", "content_sanskrit": "अनंतेन समायुक्तं मुचुकुन्देन धीमता ।\nनृपेण बलिना चैव पातालं स्वर्गवासिना ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002557017, "chapter_id": 22557, "verse_number": "२-३-१८", "content_sanskrit": "शैलं रसातलं विप्राः शांकरं हि रसातलम् ।\nपीतं सुतलमित्युक्तं वितलं विद्रुमप्रभम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002557018, "chapter_id": 22557, "verse_number": "२-३-१९", "content_sanskrit": "सितं हि वितलं प्रोक्तं तलं चैव सितेतरम् ।\nसुवर्णेन मुनिश्रेष्ठास्तथा वासुकिना शुभम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002557019, "chapter_id": 22557, "verse_number": "२-३-२०", "content_sanskrit": "रसातलमिति ख्यातं सर्वशोभासमन्वितम् ।\nवैनतेयादिभिश्चैव कालनेमिपुरोगमैः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002557020, "chapter_id": 22557, "verse_number": "२-३-२१", "content_sanskrit": "शंकुकर्णेन संभिन्नं तथा नमुचिपूर्वकम् ।\nतथान्यैर्विवि धैर्नागैस्तलं चैव सुशोभनम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002557021, "chapter_id": 22557, "verse_number": "२-३-२२", "content_sanskrit": "तेषामधस्तान्नरका रौरवाद्याश्च कोटयः ।\nपापिनस्तेषु पात्यंते न तेऽवनमितुं क्षमाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002557022, "chapter_id": 22557, "verse_number": "२-३-२३", "content_sanskrit": "पाताला नामधश्चांते शेषाख्या वैष्णवी तनुः ।\nकालाग्निरुद्रयोगात्मा नारसिंहोऽपि माधवः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002557023, "chapter_id": 22557, "verse_number": "२-३-२४", "content_sanskrit": "योऽनंतः पठ्यते देवो नागरूपी जनार्दनः ।\nतदाधारमिदं सर्वं सकलाग्निमुपाश्रितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002557024, "chapter_id": 22557, "verse_number": "२-३-२५", "content_sanskrit": "तमाविश्य महायोगी कालस्तद्वदनानलः ।\nविषज्वालासमोऽनंतो जगत्संहरति स्वयम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002557025, "chapter_id": 22557, "verse_number": "२-३-२६", "content_sanskrit": "तामसी शांभवी मूर्तिः कालात्मा परमेश्वरः ।\nस एव गर्भमाश्रित्य प्रकाशयति नित्यशः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]