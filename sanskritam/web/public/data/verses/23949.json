[{"id": 7003949000, "chapter_id": 23949, "verse_number": "३-१-१२-१", "content_sanskrit": "श्रीसूत उवाच ।\nसीताकुण्डे महापुण्ये नरः स्नात्वा द्विजोत्तमाः ।\nततस्तु मंगलं तीर्थमभिगच्छेत्समाहितः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003949001, "chapter_id": 23949, "verse_number": "३-१-१२-२", "content_sanskrit": "सन्निधत्ते सदा यत्र कमला विष्णुवल्लभा ।\nअलक्ष्मीपरिहाराय यस्मिन्सरसि वै सुराः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003949002, "chapter_id": 23949, "verse_number": "३-१-१२-३", "content_sanskrit": "शतक्रतुमुखाः सर्वे समागच्छंति नित्यशः ।\nतदेतत्तीर्थमुद्दिश्य ऋषयो लोकपावनम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003949003, "chapter_id": 23949, "verse_number": "३-१-१२-४", "content_sanskrit": "इतिहासं प्रवक्ष्यामि पुण्यं पापविनाशनम् ।\nपुरा मनोजवो नाम राजा सोमकुलोद्भवः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003949004, "chapter_id": 23949, "verse_number": "३-१-१२-५", "content_sanskrit": "पालयामास धर्मेण धरां सागरमेखलाम् ।\nअयष्ट स सुरान्यज्ञै र्ब्राह्मणानन्नसंचयैः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003949005, "chapter_id": 23949, "verse_number": "३-१-१२-६", "content_sanskrit": "तर्पयामास कव्येन प्रत्यब्दं पितृदेवताः ।\nत्रयीमध्यैष्ट सततमपाठीच्छास्त्रमर्थवत्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003949006, "chapter_id": 23949, "verse_number": "३-१-१२-७", "content_sanskrit": "व्यजेष्ट शत्रून्वीर्येण प्राणं सीदीशकेशवौ ।\nअरंस्त नीतिशास्त्रेषु तथापाठीन्महामनून्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003949007, "chapter_id": 23949, "verse_number": "३-१-१२-८", "content_sanskrit": "एवं स धर्मतो राजा पालयामास मेदिनीम् ।\nरक्षतस्तस्य राज्ञोऽभूद्राज्यं निहत कंटकम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003949008, "chapter_id": 23949, "verse_number": "३-१-१२-९", "content_sanskrit": "अहंकारोऽभवत्तस्य पुत्रसंपद्विनाशनः ।\nअहंकारो भवेद्यत्र तत्र लोभो मदस्तथा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003949009, "chapter_id": 23949, "verse_number": "३-१-१२-१०", "content_sanskrit": "कामः क्रोधश्च हिंसा च तथाऽसूया विमोहिनी ।\nभवंत्येतानि विप्रेंद्राः संपदां नाशहेतवः॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003949010, "chapter_id": 23949, "verse_number": "३-१-१२-११", "content_sanskrit": "एतानि यत्र विद्यंते पुरुषे स विनश्यति ।\nक्षणेन पुत्रपौत्रैश्च सार्द्धं चाखिलसंपदा॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003949011, "chapter_id": 23949, "verse_number": "३-१-१२-१२", "content_sanskrit": "बभूव तस्यासूया च जनविद्वेषिणी सदा ।\nअसूयाकुलचित्तस्य वृथाहंकारिणस्तथा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003949012, "chapter_id": 23949, "verse_number": "३-१-१२-१३", "content_sanskrit": "लुब्धस्य कामदुष्टस्य मतिरेवं बभूव ह ।\nविप्रग्रामे करादानं करिष्यामीति निश्चितः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003949013, "chapter_id": 23949, "verse_number": "३-१-१२-१४", "content_sanskrit": "अकरोच्च तथा राजा निश्चित्य मनसा तदा ।\nधनं धान्यं च विप्राणां जहार किल लोभतः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003949014, "chapter_id": 23949, "verse_number": "३-१-१२-१५", "content_sanskrit": "शिवविष्ण्वादिदेवानां वित्तान्यादत्त रागतः ।\nशिवविष्ण्वादिदेवानां विप्राणां च महात्मनाम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003949015, "chapter_id": 23949, "verse_number": "३-१-१२-१६", "content_sanskrit": "क्षेत्राण्यपजहारायमहंकार विमूढधीः ।\nएवमन्याययुक्तस्य देवद्विजविरोधिनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003949016, "chapter_id": 23949, "verse_number": "३-१-१२-१७", "content_sanskrit": "दुष्कर्मपरिपाकेन क्रूरेण द्विजपुंगवाः ।\nपुरं रुरोध बलवान्परदेशाधिपो रिपुः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003949017, "chapter_id": 23949, "verse_number": "३-१-१२-१८", "content_sanskrit": "गोलभोनाम विप्रेंद्राश्चतुरंगबलैर्युतः ।\nषण्मासं युद्धमभवद्गोलभेन दुरात्मनः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003949018, "chapter_id": 23949, "verse_number": "३-१-१२-१९", "content_sanskrit": "मनोजवस्य नृपतेरहंकाररतात्मनः ।\nततः स गोलभेनाजौ जितो राज्यात्परिच्युतः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003949019, "chapter_id": 23949, "verse_number": "३-१-१२-२०", "content_sanskrit": "वनं सपुत्रदारः सन्प्रपेदे स मनोजवः ।\nगोलभः पालयन्नास्ते मनोजवपुरे चिरम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003949020, "chapter_id": 23949, "verse_number": "३-१-१२-२१", "content_sanskrit": "चतुरंगबलोपेतस्तमुद्वास्य रणे बली ।\nमनोजवोपि विप्रेंद्राः शोचन्स्त्रीपुत्रसंयुतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003949021, "chapter_id": 23949, "verse_number": "३-१-१२-२२", "content_sanskrit": "क्षुत्क्षामः प्रस्खलञ्छश्वत्प्रविवेश महावनम् ।\nझिल्लिकागणसंघुष्टं व्याघ्रश्वापद भीषणम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003949022, "chapter_id": 23949, "verse_number": "३-१-१२-२३", "content_sanskrit": "व्याप्तद्विरदचीत्कारं वराहमहिषाकुलम् ।\nतस्मिन्वने महाघोरे क्षुधया परिपीडितः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003949023, "chapter_id": 23949, "verse_number": "३-१-१२-२४", "content_sanskrit": "अयाचतान्नं पितरं मनोजवसुतः शिशुः ।\nअंब मेन्नं प्रयच्छ त्वं क्षुधा मां बाधते भृशम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003949024, "chapter_id": 23949, "verse_number": "३-१-१२-२५", "content_sanskrit": "एवं स्वजननीं चापि प्रार्थयामास बालकः ।\nतन्मातापितरौ तत्र श्रुत्वा पुत्रस्य भाषितम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003949025, "chapter_id": 23949, "verse_number": "३-१-१२-२६", "content_sanskrit": "शोकाभिभूतौ सहसा मोहं समुपजग्मतुः ।\nभार्यामथाब्रवीद्राजा सुमित्रानाम नामतः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003949026, "chapter_id": 23949, "verse_number": "३-१-१२-२७", "content_sanskrit": "मुह्यमानश्च स मुहुः शुष्ककंठौष्ठतालुकः ।\nसुमित्रे किं करिष्यामि कुत्र यास्यामि का गतिः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003949027, "chapter_id": 23949, "verse_number": "३-१-१२-२८", "content_sanskrit": "मरिष्यत्यचिरादेष सुतो मे क्षुधयार्दितः ।\nकिमर्थं ससृजे वेधा दुर्भाग्यं मां वृथा प्रिये॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003949028, "chapter_id": 23949, "verse_number": "३-१-१२-२९", "content_sanskrit": "को वा मोचयिता दुःखमेतद्दुष्कर्मजं मम ।\nन पूजितो मया शंभुर्हरिर्वा पूर्वजन्मसु॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003949029, "chapter_id": 23949, "verse_number": "३-१-१२-३०", "content_sanskrit": "तथान्या देवताः सूर्यविभावसुमुखाः प्रिये ।\nतेन पापेन चाद्याहमस्मिञ्जन्मनि शोभने॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003949030, "chapter_id": 23949, "verse_number": "३-१-१२-३१", "content_sanskrit": "अहंकाराभिभूतोऽस्मि विप्रक्षेत्राण्यपाहरम् ।\nशिवविष्ण्वादिदेवानां वित्तं चापहृतं मया॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003949031, "chapter_id": 23949, "verse_number": "३-१-१२-३२", "content_sanskrit": "एवं दुष्कर्मबाहुल्याद्गोलभेन पराजितः ।\nवनं यातोस्मि विजनं त्वया सह सुतेन च॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003949032, "chapter_id": 23949, "verse_number": "३-१-१२-३३", "content_sanskrit": "निरन्नो निर्धनो दुःखी क्षुधितो ऽहं पिपासितः ।\nकथमन्नं प्रदास्यामि क्षुधिताय सुताय मे॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003949033, "chapter_id": 23949, "verse_number": "३-१-१२-३४", "content_sanskrit": "न मयान्नानि दत्तानि ब्राह्मणेभ्यः शुचिस्मिते ।\nन मया पूजितः शंभुर्विष्णुर्वा देवतांतरम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003949034, "chapter_id": 23949, "verse_number": "३-१-१२-३५", "content_sanskrit": "तेन पापेन मे त्वद्य दुःखमेतत्समागतम् ।\nन मयाग्नौ हुतं पूर्वं न तीर्थमपि सेवितम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003949035, "chapter_id": 23949, "verse_number": "३-१-१२-३६", "content_sanskrit": "मातृश्राद्धं पितृश्राद्धं मृताह दिवसे तयोः ।\nनैकोद्दिष्टविधानेन पार्वणेनापि वै प्रिये॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003949036, "chapter_id": 23949, "verse_number": "३-१-१२-३७", "content_sanskrit": "कृतं न हि मया भद्रे भूरिभोजनमेव वा ।\nतेन पापेन मे त्वद्य दुःखमेतत्समागतम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003949037, "chapter_id": 23949, "verse_number": "३-१-१२-३८", "content_sanskrit": "चैत्रमासे प्रिये चित्रानक्षत्रे पानकं मया ।\nपनसानां फलं स्वादु कदलीफलमेव वा॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003949038, "chapter_id": 23949, "verse_number": "३-१-१२-३९", "content_sanskrit": "तथा छत्रं सदंडं च रम्यं पादुकयोर्द्वयम् ।\nतांबूलानि च पुष्पाणि चंदनं चानुलेपनम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003949039, "chapter_id": 23949, "verse_number": "३-१-१२-४०", "content_sanskrit": "न दत्तं वेदविद्भ्यस्तु चित्रगुप्तस्य तुष्टये ।\nतेन पापेन मे त्वद्य दुःखमेतत्समागतम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003949040, "chapter_id": 23949, "verse_number": "३-१-१२-४१", "content_sanskrit": "नाश्वत्थश्चूतवृक्षो वा न्यग्रोधस्तिंतिणी तथा ।\nपिचुमंदः कपित्थो वा तथैवामलकीतरुः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003949041, "chapter_id": 23949, "verse_number": "३-१-१२-४२", "content_sanskrit": "नारिकेलतरुर्वापि स्थापितोऽध्वगशांतये ।\nतेन पापेन मे त्वद्य दुःखमेतत्समागतम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003949042, "chapter_id": 23949, "verse_number": "३-१-१२-४३", "content_sanskrit": "सम्मार्जनं च न कृतं शिवविष्ण्वालये मया ।\nन खानितं तटाकं च न कूपोपि ह्रदोऽपिवा॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003949043, "chapter_id": 23949, "verse_number": "३-१-१२-४४", "content_sanskrit": "न रोपितं पुष्पवनं तथैव तुलसीवनम् ।\nशिवविष्ण्वालयौ वापि निर्मितो न मया प्रिये॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003949044, "chapter_id": 23949, "verse_number": "३-१-१२-४५", "content_sanskrit": "तेन पापेन मे त्वद्य दुःखमेतत्समागतम् ।\nन मया पैतृके मासि पितॄनुद्दिश्य शोभने ।\nमहालयं कृतं श्राद्धमष्टकाश्राद्धमेव वा॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003949045, "chapter_id": 23949, "verse_number": "३-१-१२-४६", "content_sanskrit": "नित्यश्राद्धं तथा काम्यं श्राद्धं नैमित्तिकं प्रिये ।\nन कृताः क्रतवश्चापि विधिवद्भूरिदक्षिणाः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003949046, "chapter_id": 23949, "verse_number": "३-१-१२-४७", "content_sanskrit": "मासोपवासो न कृतः एकादश्यामुपोषणम् ।\nधनुर्मासेप्युषःकाले शंभुविष्ण्वादिदेवताः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003949047, "chapter_id": 23949, "verse_number": "३-१-१२-४८", "content_sanskrit": "संपूज्य विधिवद्भद्रे नैवेद्यं न कृतं मया ।\nतेन पापेन मे त्वद्य दुःखमेतत्समा गतम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003949048, "chapter_id": 23949, "verse_number": "३-१-१२-४९", "content_sanskrit": "हरिशंकरयोर्नाम्नां कीर्तनं न मया कृतम् ।\nउद्धूलनं त्रिपुण्ड्रं च जाबालोक्तैश्च सप्तभिः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003949049, "chapter_id": 23949, "verse_number": "३-१-१२-५०", "content_sanskrit": "न धृतं भस्मना भद्रे रुद्राक्षं न धृतं मया ।\nजपश्च रुद्रसूक्तानां पंचाक्षरजपस्तथा॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003949050, "chapter_id": 23949, "verse_number": "३-१-१२-५१", "content_sanskrit": "तथा पुरुषसूक्तस्य जपोऽप्यष्टाक्षरस्य च ।\nनैवकारि मया भद्रे नैवान्यो धर्मसंचयः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003949051, "chapter_id": 23949, "verse_number": "३-१-१२-५२", "content_sanskrit": "तेन पापेन मे त्वद्य दुःखमेतत्समागतम् ।\nएवं स विलपन्राजा भार्यामाभाष्य खिन्नधीः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003949052, "chapter_id": 23949, "verse_number": "३-१-१२-५३", "content_sanskrit": "मूर्च्छामुपाययौ विप्राः पपात च धरातले ।\nसुमित्रा पतितं दृष्ट्वा भार्या सा पतिमंगना॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003949053, "chapter_id": 23949, "verse_number": "३-१-१२-५४", "content_sanskrit": "आलिंग्य विललापाथ सपुत्रा भृशदुःखिता ।\nमम नाथ महाराज सोमान्वयधुरंधर॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003949054, "chapter_id": 23949, "verse_number": "३-१-१२-५५", "content_sanskrit": "मां विहाय क्व यातोऽसि सपुत्रां विजने वने ।\nअनाथां त्वामनुगतां सिंहत्रस्तां मृगीमिव॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003949055, "chapter_id": 23949, "verse_number": "३-१-१२-५६", "content_sanskrit": "मृतोऽसि यदि राजेंद्र तर्हि त्वामहमप्यरम् ।\nअनुव्रजामि विधवा न स्थास्ये क्षणमप्युत॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003949056, "chapter_id": 23949, "verse_number": "३-१-१२-५७", "content_sanskrit": "पितरं पश्य पतितं चन्द्रकांत सुत क्षितौ ।\nइत्युक्तश्चंद्रकांतोऽपि सुतो राज्ञः क्षुधार्दितः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003949057, "chapter_id": 23949, "verse_number": "३-१-१२-५८", "content_sanskrit": "पितरं परिरभ्याथ निःशब्दं प्ररुरोद सः ।\nएतस्मिन्नंतरे विप्रा जटावल्कलसंवृतः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003949058, "chapter_id": 23949, "verse_number": "३-१-१२-५९", "content_sanskrit": "भस्मोद्धूलितसर्वांगस्त्रिपुण्ड्रांकितमस्तकः ।\nरुद्राक्षमालाभरणः सितयज्ञोपवीतवान्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003949059, "chapter_id": 23949, "verse_number": "३-१-१२-६०", "content_sanskrit": "पराशरोनाम मुनिराजगाम यदृच्छया ।\nतं शब्दमभिलक्ष्यासौ साधुसज्जनसंमतः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003949060, "chapter_id": 23949, "verse_number": "३-१-१२-६१", "content_sanskrit": "ततः सुमित्रा तं दृष्ट्वा पराशरमुपागतम् ।\nववंदे चरणौ तस्य सपुत्रा सा पतिव्रता॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003949061, "chapter_id": 23949, "verse_number": "३-१-१२-६२", "content_sanskrit": "ततः पराशरेणेयं सुमित्रा परिसांत्विता ।\nआश्वासिता च मुनिना मा शोचस्वेति भामिनि ।\nततः सुमित्रां पप्रच्छ शक्तिपुत्रो महामुनिः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003949062, "chapter_id": 23949, "verse_number": "३-१-१२-६३", "content_sanskrit": "पराशर उवाच ।\nका त्वं सुश्रोणि कश्चासौ यश्चायं पतितोऽग्रतः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003949063, "chapter_id": 23949, "verse_number": "३-१-१२-६४", "content_sanskrit": "अयं शिशुश्च कस्ते स्याद्वद तत्त्वेन मे शुभे ।\nपृष्टैवं मुनिना साध्वी तमुवाच महामुनिम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003949064, "chapter_id": 23949, "verse_number": "३-१-१२-६५", "content_sanskrit": "सुमित्रोवाच ।\nपतिर्ममायमस्याहं भार्या वै मुनिसत्तम ।\nआवाभ्यां जनितश्चायं चंद्रकांताभिधः सुतः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003949065, "chapter_id": 23949, "verse_number": "३-१-१२-६६", "content_sanskrit": "अयं मनोजवो नाम राजा सोमकुलोद्भवः ।\nविक्रमाढ्यस्य तनयः शौर्ये विष्णुसमो बली॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003949066, "chapter_id": 23949, "verse_number": "३-१-१२-६७", "content_sanskrit": "सुमित्रा नाम तस्याहं भार्या पतिमनुव्रता ।\nयुद्धे विनिर्जितो राजा गोलभेन मनोजवः॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003949067, "chapter_id": 23949, "verse_number": "३-१-१२-६८", "content_sanskrit": "राज्याद्भ्रष्टो निरालंबो मया पुत्रेण चान्वितः ।\nवनं विवेश ब्रह्मर्षे क्रूरसत्त्वभयानकम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003949068, "chapter_id": 23949, "verse_number": "३-१-१२-६९", "content_sanskrit": "क्षुधया पीडितः पुत्रो ह्यावामन्नमयाचत ।\nनिरन्नो विधुरो राजा दृष्ट्वा पुत्रं क्षुधार्दितम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003949069, "chapter_id": 23949, "verse_number": "३-१-१२-७०", "content_sanskrit": "शोकाकुलमना ब्रह्मन्मूर्च्छितः पतितो भुवि ।\nइति तद्वचनं श्रुत्वा शोकपर्याकुलाक्षरम्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003949070, "chapter_id": 23949, "verse_number": "३-१-१२-७१", "content_sanskrit": "शक्तिपुत्रो मुनिः प्राह सुमित्रां तां पतिव्रताम् ।\nमनोजवस्य नृपतेर्भार्यामग्निशिखोपमाम्॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003949071, "chapter_id": 23949, "verse_number": "३-१-१२-७२", "content_sanskrit": "पराशर उवाच ।\nमनोजवस्य भार्ये ते मा भीर्भूयात्कथंचन ।\nयुष्माकमशुभं सत्यमचिरान्नाशमेष्यति॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003949072, "chapter_id": 23949, "verse_number": "३-१-१२-७३", "content_sanskrit": "मूर्च्छां विहाय ते भद्रे क्षणादुत्थास्यते पतिः ।\nततः पराशरो विप्रः पाणिना तं नराधिपम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003949073, "chapter_id": 23949, "verse_number": "३-१-१२-७४", "content_sanskrit": "पस्पर्श मंत्रं प्रजपन्ध्यात्वा देवं त्रियंबकम् ।\nततो मनोजवो राजा करस्पृष्टो महामुनेः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003949074, "chapter_id": 23949, "verse_number": "३-१-१२-७५", "content_sanskrit": "उत्थितः सहसा तत्र त्यक्त्वा मूर्च्छां तमोमयीम् ।\nततः पराशरमुनिं प्रणम्य जगतीपतिः ।\nउवाच परमप्रीतः प्रांजलिर्विप्रसत्तमम्॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003949075, "chapter_id": 23949, "verse_number": "३-१-१२-७६", "content_sanskrit": "मनोजव उवाच ।\nपराशरमुने त्वद्य त्वत्पादाब्जनिषेवणात्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003949076, "chapter_id": 23949, "verse_number": "३-१-१२-७७", "content_sanskrit": "मूर्च्छा मे विगता सद्यः पातकं चैव नाशितम् ।\nत्वद्दर्शनमपुण्यानां नैव सिध्येत्कदाचन॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003949077, "chapter_id": 23949, "verse_number": "३-१-१२-७८", "content_sanskrit": "रक्ष मां करुणादृष्ट्या च्यावितं शत्रुभिः पुरात् ।\nइत्युक्तः स मुनिः प्राह राजानं तं मनोजवम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003949078, "chapter_id": 23949, "verse_number": "३-१-१२-७९", "content_sanskrit": "पराशर उवाच ।\nउपायं ते प्रवक्ष्यामि राजञ्च्छत्रुजयाय वै ।\nरामसेतौ महापुण्ये गंधमादनपर्वते॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003949079, "chapter_id": 23949, "verse_number": "३-१-१२-८०", "content_sanskrit": "विद्यते मंगलं तीर्थं सर्वैश्वर्यप्रदायकम् ।\nसर्वलोकोपकाराय तस्मिन्सरसि राघवः॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003949080, "chapter_id": 23949, "verse_number": "३-१-१२-८१", "content_sanskrit": "सन्निधत्ते सदा लक्ष्म्या सीतया राजसत्तम ।\nसपुत्रभार्यस्त्वं तत्र गत्वा स्नात्वा सभक्तिकम्॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003949081, "chapter_id": 23949, "verse_number": "३-१-१२-८२", "content_sanskrit": "क्षेत्रश्राद्धादिकं चापि तत्तीरे कुरु भूपते ।\nएवं कृते त्वया राजन्नलक्ष्मीः क्लेशकारिणी॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003949082, "chapter_id": 23949, "verse_number": "३-१-१२-८३", "content_sanskrit": "वैभवात्तस्य तीर्थस्य नाशं यास्यत्यसंशयम् ।\nमंगलानि च सर्वाणि प्राप्स्यसे न चिरान्नृप॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003949083, "chapter_id": 23949, "verse_number": "३-१-१२-८४", "content_sanskrit": "विजित्य शत्रूंश्च रणे पुनर्भूमिं प्रपत्स्यसे ।\nअतस्त्वं भार्यया सार्द्धं पुत्रेण च मनोजव॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003949084, "chapter_id": 23949, "verse_number": "३-१-१२-८५", "content_sanskrit": "गच्छ मंगलतीर्थं तद्गन्धमादनपर्वते ।\nअहमप्यागमिष्यामि तवानुग्रहकाम्यया॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003949085, "chapter_id": 23949, "verse_number": "३-१-१२-८६", "content_sanskrit": "पराशरस्त्वेवमुक्त्वा राजमुख्यैस्त्रिभिः सह ।\nप्रायात्सेतुं समुद्दिश्य स्नातुं मंगलतीर्थके॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003949086, "chapter_id": 23949, "verse_number": "३-१-१२-८७", "content_sanskrit": "राजादिभिः सह मुनिर्विलंघ्य विविधं वनम् ।\nवनप्रदेशदेशांश्च दस्युग्रामाननेकशः॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003949087, "chapter_id": 23949, "verse_number": "३-१-१२-८८", "content_sanskrit": "प्रययौ मंगलं तीर्थं गन्धमादनपर्वते ।\nतत्र संकल्प्य विधिवत्सस्नौ स मुनिपुंगवः॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003949088, "chapter_id": 23949, "verse_number": "३-१-१२-८९", "content_sanskrit": "तानपि स्नापयामास राजादीन्विधिपूर्वकम् ।\nतत्र श्राद्धं च भूपालश्चकार पितृतृप्तये॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003949089, "chapter_id": 23949, "verse_number": "३-१-१२-९०", "content_sanskrit": "तत्र मासत्रयं सस्नौ राजा पत्नीसुतस्तथा ।\nततः पराशरमुनिः सस्नौ नियमपूर्वकम्॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003949090, "chapter_id": 23949, "verse_number": "३-१-१२-९१", "content_sanskrit": "एवं मासत्रयं सस्नौ तैः साकं मुनिपुंगवः ।\nमंगलाख्ये महापुण्ये सर्वामंगलनाशने॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003949091, "chapter_id": 23949, "verse_number": "३-१-१२-९२", "content_sanskrit": "ततः पराशरमुनिः सर्वानर्थविनाशनम् ।\nरामस्यैकाक्षरं मंत्रं तदंते समुपादिशत्॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003949092, "chapter_id": 23949, "verse_number": "३-१-१२-९३", "content_sanskrit": "चत्वारिंशद्दिनं तत्र मंत्रमेकाक्षरं नृपः ।\nतत्र तीर्थे जजापासौ मुन्युक्तेनैव वर्त्मना॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003949093, "chapter_id": 23949, "verse_number": "३-१-१२-९४", "content_sanskrit": "एवमभ्यसतस्तस्य मंत्रमेकाक्षरं द्विजाः ।\nमुनिप्रसादात्पुरतो धनुः प्रादुरभूद्दृढम्॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003949094, "chapter_id": 23949, "verse_number": "३-१-१२-९५", "content_sanskrit": "अक्षयाविषुधी चापि खड्गौ च कनकत्सरू ।\nएकं चर्म गदा चैका तथैको मुसलोत्तमः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003949095, "chapter_id": 23949, "verse_number": "३-१-१२-९६", "content_sanskrit": "एकः शंखो महानादो वाजियुक्तो रथस्तथा ।\nससारथिः पताका च तीर्थादुत्तस्थुरग्रतः॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003949096, "chapter_id": 23949, "verse_number": "३-१-१२-९७", "content_sanskrit": "कवचं कांचनमयं वैश्वानरसमप्रभम् ।\nप्रादुर्बभूव तत्तीर्थात्प्रसादेन मुनेस्तथा॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003949097, "chapter_id": 23949, "verse_number": "३-१-१२-९८", "content_sanskrit": "हारकेयूरमुकुटकटकादिविभूषणम् ।\nतीर्थानां प्रवरात्तस्मादुत्थितं नृपतेः पुरः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003949098, "chapter_id": 23949, "verse_number": "३-१-१२-९९", "content_sanskrit": "दिव्यांबरसहस्रं च तीर्थात्प्रादुरभूत्तदा ।\nमाला च वैजयंत्याख्या स्वर्णपंकजशोभिता॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003949099, "chapter_id": 23949, "verse_number": "३-१-१२-१००", "content_sanskrit": "एतत्सर्वं समालोक्य मुनयेऽसौ न्यवेदयत् ।\nततः पराशरमुनिर्जलमादाय तीर्थतः॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003949100, "chapter_id": 23949, "verse_number": "३-१-१२-१०१", "content_sanskrit": "अभ्यषिंचन्नरपतिं मंत्रपूतेनवारिणा ।\nततोऽभिषिक्तो नृपतिर्मुनिना परिशोभितः॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003949101, "chapter_id": 23949, "verse_number": "३-१-१२-१०२", "content_sanskrit": "सन्नद्धः कवची खड्गी चापबाणधरो युवा ।\nहारकेयूरमुकुटकटकादिविभूषितः॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003949102, "chapter_id": 23949, "verse_number": "३-१-१२-१०३", "content_sanskrit": "दिव्यांबरधरश्चापि वाजियुक्त रथस्थितः ।\nशुशुभेऽतीव नृपतिर्मध्याह्न इव भास्करः॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003949103, "chapter_id": 23949, "verse_number": "३-१-१२-१०४", "content_sanskrit": "तस्मै नृपतये तत्र ब्रह्माद्यस्त्रं महामुनिः ।\nसांगं च सरहस्यं च सोत्सर्गं सोप संहृति॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003949104, "chapter_id": 23949, "verse_number": "३-१-१२-१०५", "content_sanskrit": "उपादिशच्छक्तिपुत्रः सुमित्राजानये तदा ।\nमनोजवोऽथ मुनिना ह्याशीर्वादपुरःसरम्॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003949105, "chapter_id": 23949, "verse_number": "३-१-१२-१०६", "content_sanskrit": "प्रेरितो रथमास्थाय प्रणम्य मुनिपुंगवम् ।\nप्रदक्षिणीकृत्य तदाभ्यनुज्ञातो महर्षिणा॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003949106, "chapter_id": 23949, "verse_number": "३-१-१२-१०७", "content_sanskrit": "सार्द्धं पत्न्या च पुत्रेण प्रययौ विजयाय सः ।\nस गत्वा स्वपुरं राजा प्रदध्मौ जलजं तदा॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003949107, "chapter_id": 23949, "verse_number": "३-१-१२-१०८", "content_sanskrit": "ततः शंखरवं श्रुत्वा गोलभस्तु ससैनिकः ।\nयुद्धाय निर्ययौ तूर्णं मनोजवनृपेण सः॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003949108, "chapter_id": 23949, "verse_number": "३-१-१२-१०९", "content_sanskrit": "दिनत्रयं रणं जज्ञे गोलभेन नृपस्य वै ।\nततश्चतुर्थे दिवसे गोलभं तु ससैनिकम्॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003949109, "chapter_id": 23949, "verse_number": "३-१-१२-११०", "content_sanskrit": "मनोजवो नृपो युद्धे ब्रह्मास्त्रेण व्यनाशयत् ।\nततः सपुत्र भार्योऽयं पुरं प्राप्य निजं नृपः॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003949110, "chapter_id": 23949, "verse_number": "३-१-१२-१११", "content_sanskrit": "पालयन्पृथिवीं सर्वां बुभुजे भार्यया सह ।\nतदाप्रभृति राजासौ नाहंकारं चकार वै॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003949111, "chapter_id": 23949, "verse_number": "३-१-१२-११२", "content_sanskrit": "असूयादींस्तथा दोषान्वर्जयामास भूपतिः ।\nअहिंसानिरतो दांतः सदा धर्मपरोऽभवत्॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003949112, "chapter_id": 23949, "verse_number": "३-१-१२-११३", "content_sanskrit": "सहस्रं वत्सरानेवं ररक्ष स महीपतिः ।\nततो विरक्तो राजेन्द्रः पुत्रे राज्यं निधाय तु॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003949113, "chapter_id": 23949, "verse_number": "३-१-१२-११४", "content_sanskrit": "जगाम मंगलं तीर्थं गन्धमादनपर्वते ।\nतपश्चचार तत्रासौ ध्यायन्हृदि सदाशिवम्॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003949114, "chapter_id": 23949, "verse_number": "३-१-१२-११५", "content_sanskrit": "ततोऽचिरेण कालेन त्यक्त्वा देहं मनोजवः ।\nशिवलोकं ययौ राजा तस्य तीर्थस्य वैभवात्॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003949115, "chapter_id": 23949, "verse_number": "३-१-१२-११६", "content_sanskrit": "तस्य भार्या सुमित्रापि तस्यालिंग्य तनुं तदा ।\nअन्वारूढा चितां विप्राः प्राप तल्लोकमेव सा॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003949116, "chapter_id": 23949, "verse_number": "३-१-१२-११७", "content_sanskrit": "श्रीसूत उवाच ।\nएवं प्रभावं तत्तीर्थं श्रीमन्मंगलनामकम् ।\nमनोजवो नृपो यत्र स्नात्वा तीर्थे महत्तरे॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003949117, "chapter_id": 23949, "verse_number": "३-१-१२-११८", "content_sanskrit": "शत्रून्विजित्य देहांते शिवलोकं ययौ स्त्रिया ।\nतस्मात्सर्वप्रयत्नेन सेव्यं मंगलतीर्थकम्॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003949118, "chapter_id": 23949, "verse_number": "३-१-१२-११९", "content_sanskrit": "तीर्थमेतदतिशोभनं शिवं भुक्तिमुक्तिफलदं नृणां सदा ।\nपापराशितृणतूलपावकं सेवत द्विजवरा विमुक्तये॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}]