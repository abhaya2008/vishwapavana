[{"id": 7006438000, "chapter_id": 26438, "verse_number": "२-९८-१", "content_sanskrit": "वैशम्पायन उवाच\nददर्शाथ पुरीं कृष्णो द्वारकां गरुडे स्थितः ।\nदेवसद्मप्रतीकाशां समन्तात् प्रतिनादिताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006438001, "chapter_id": 26438, "verse_number": "२-९८-२", "content_sanskrit": "मणिपर्वतयन्त्राणि तथा क्रीडागृहाणि च ।\nउद्यानवनमुख्यानि वलभीचत्वराणि च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006438002, "chapter_id": 26438, "verse_number": "२-९८-३", "content_sanskrit": "सम्प्राप्ते तु तदा कृष्णे पुरीं देवकिनन्दने ।\nविश्वकर्माणमाहूय देवराजोऽब्रवीदिदम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006438003, "chapter_id": 26438, "verse_number": "२-९८-४", "content_sanskrit": "प्रियमिच्छसि चेत् कर्तुं मह्यं शिल्पवतां वर ।\nकृष्णप्रियार्थं भूयस्त्वं प्रकुरुष्व मनोहराम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006438004, "chapter_id": 26438, "verse_number": "२-९८-५", "content_sanskrit": "उद्यानशतसम्बाधां द्वारकां स्वर्गसम्मिताम् ।\nकुरुष्व विबुधश्रेष्ठ यथा मम पुरी तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006438005, "chapter_id": 26438, "verse_number": "२-९८-६", "content_sanskrit": "यत्किंचित् त्रिषु लोकेषु रत्नभूतं प्रपश्यसि ।\nतेन संयुज्यतां क्षिप्रं पुरीं द्वारवतीं त्वया ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006438006, "chapter_id": 26438, "verse_number": "२-९८-७", "content_sanskrit": "कृष्णो हि सुरकार्येषु सर्वेषु सततोत्थितः ।\nसंग्रामान् घोररूपांश्च विगाहति महाबलः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006438007, "chapter_id": 26438, "verse_number": "२-९८-८", "content_sanskrit": "तामिन्द्रवचनाद् गत्वा विश्वकर्मा पुरीं ततः ।\nअलंचक्रे समन्ताद् वै यथेन्द्रस्यामरावती ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006438008, "chapter_id": 26438, "verse_number": "२-९८-९", "content_sanskrit": "तां ददर्श दशार्हाणामीश्वरः पक्षिवाहनः ।\nविश्वकर्मकृतैर्दिव्यैरभिप्रायैरलंकृताम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006438009, "chapter_id": 26438, "verse_number": "२-९८-१०", "content_sanskrit": "तां तदा द्वारकां दृष्ट्वा प्रभुर्नारायणो विभुः ।\nहृष्टः सर्वार्थसम्पन्नः प्रवेष्टुमुपचक्रमे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006438010, "chapter_id": 26438, "verse_number": "२-९८-११", "content_sanskrit": "सोऽपश्यद्वृक्षखण्डांश्च रम्यान् दृष्टिमनोहरान् ।\nद्वारकां प्रति दाशार्हश्चित्रितां विश्वकर्मणा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006438011, "chapter_id": 26438, "verse_number": "२-९८-१२", "content_sanskrit": "पद्मखण्डाकुलाभिश्च हंससेवितवारिभिः ।\nगङ्गासिन्धुप्रकाशाभिः परिखाभिर्वृतां पुरीम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006438012, "chapter_id": 26438, "verse_number": "२-९८-१३", "content_sanskrit": "प्राकारेणार्कवर्णेन शातकौम्भेन राजता ।\nचयमूर्घ्नि निविष्टेन द्यां यथैवाभ्रमालया ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006438013, "chapter_id": 26438, "verse_number": "२-९८-१४", "content_sanskrit": "काननैर्नन्दनप्रख्यैस्तथा चैत्ररथोपमैः ।\nबभौ चारुपरिक्षिप्ता द्वारका द्यौरिवाम्बुदैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006438014, "chapter_id": 26438, "verse_number": "२-९८-१५", "content_sanskrit": "वभौ रैवतकः शैलो रम्यसानुगुहाजिरः ।\nपूर्वस्यां दिशि लक्ष्मीवान् मणिकाञ्चनतोरणः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006438015, "chapter_id": 26438, "verse_number": "२-९८-१६", "content_sanskrit": "दक्षिणस्यां लतावेष्टः पञ्चवर्णो विराजते ।\nइन्द्रकेतुप्रतीकाशः पश्चिमां दिशमाश्रितः ।\nसुकक्षो राजतः शैलश्चित्रपुष्पमहावनः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006438016, "chapter_id": 26438, "verse_number": "२-९८-१७", "content_sanskrit": "उत्तरां दिशमत्यर्थं विभूषयति वेणुमान् ।\nमन्दराद्रिप्रतीकाशः पाण्डुरः पार्थिवर्षभ ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006438017, "chapter_id": 26438, "verse_number": "२-९८-१८", "content_sanskrit": "चित्रकं पञ्चवर्णं च पाञ्चजन्यं वनं महत् ।\nसर्वर्तुकवनं चैव भाति रैवतकं प्रति ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006438018, "chapter_id": 26438, "verse_number": "२-९८-१९", "content_sanskrit": "लतावेष्टितपर्यन्तं मेरुप्रभवनं महत् ।\nभाति भानुवनं चैव पुष्पकं च महद् वनम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006438019, "chapter_id": 26438, "verse_number": "२-९८-२०", "content_sanskrit": "अक्षकैर्बीजकैश्चैव मन्दारैश्चोपशोभितम् ।\nशतावर्तवनं चैव करवीराकरं तथा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006438020, "chapter_id": 26438, "verse_number": "२-९८-२१", "content_sanskrit": "भाति चैत्ररथं चैव नन्दनं च वनं महत् ।\nरमणं भावनं चैवं वेणुमन्तं समन्ततः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006438021, "chapter_id": 26438, "verse_number": "२-९८-२२", "content_sanskrit": "वैडूर्यपत्रैर्जलजैस्तदा मन्दाकिनी नदी ।\nभाति पुष्करिणी रम्या पूर्वस्यां दिशि भारत ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006438022, "chapter_id": 26438, "verse_number": "२-९८-२३", "content_sanskrit": "सानवो भूषितास्तत्र केशवस्य प्रियैषिभिः ।\nबहुभिर्देवगन्धर्वैश्चोदितैर्विश्वकर्मणा ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006438023, "chapter_id": 26438, "verse_number": "२-९८-२४", "content_sanskrit": "महानदी द्वारवतीं पञ्चाशद्भिर्महामुखैः ।\nप्रविष्टा पुण्यसलिला भावयन्ती समन्ततः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006438024, "chapter_id": 26438, "verse_number": "२-९८-२५", "content_sanskrit": "अप्रमेयां महोत्सेधामगाधपरिखायुताम् ।\nप्राकारवरसम्पन्नां सुधापाण्डुरलेपनाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006438025, "chapter_id": 26438, "verse_number": "२-९८-२६", "content_sanskrit": "तीक्ष्णयन्त्रशतघ्नीभिर्हेमजालैश्च भूषिता। ।\nआयसैश्च महाचक्रैर्ददर्श द्वारकां पुरीम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006438026, "chapter_id": 26438, "verse_number": "२-९८-२७", "content_sanskrit": "अष्टौ रथसहस्राणि नगरे किङ्किणीकिनाम् ।\nसमुच्छ्रितपताकानि यथा देवपुरे तथा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006438027, "chapter_id": 26438, "verse_number": "२-९८-२८", "content_sanskrit": "अष्टयोजनविस्तीर्णामचलां द्वादशायताम् ।\nद्विगुणोपनिवेशां च ददर्श द्वारकां पुरीम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006438028, "chapter_id": 26438, "verse_number": "२-९८-२९", "content_sanskrit": "अष्टमार्गमहारथ्यां महाषोडशचत्वराम् ।\nएवंमार्गपरिक्षिप्तां साक्षादुशनसा कृताम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006438029, "chapter_id": 26438, "verse_number": "२-९८-३०", "content_sanskrit": "स्त्रियोऽपि यस्यां युध्येरन् किमु वृष्णिमहारथाः ।\nव्यूहानामुत्तमा मार्गाः सप्त चैव महापथाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006438030, "chapter_id": 26438, "verse_number": "२-९८-३१", "content_sanskrit": "तत्र वै विहिताः साक्षाद् विविधा विश्वकर्मणा ।\nतस्मिन् पुरवरश्रेष्ठे दाशार्हाणां यशस्विनाम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006438031, "chapter_id": 26438, "verse_number": "२-९८-३२", "content_sanskrit": "वेश्मानि जहृषे दृष्ट्वा ततो देवकिनन्दनः ।\nकाञ्चनैर्मणिसोपानैरुपेतानि नृहर्षणैः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006438032, "chapter_id": 26438, "verse_number": "२-९८-३३", "content_sanskrit": "भीमघोषमहाघोषैः प्रासादवरचत्वरैः ।\nसमुच्छ्रितपताकानि पारिप्लववनानि च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006438033, "chapter_id": 26438, "verse_number": "२-९८-३४", "content_sanskrit": "काञ्चनाग्राणि भास्वन्ति प्रासादशिखराणि च ।\nगृहाणि रमणीयानि मेरुकूटनिभानि च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006438034, "chapter_id": 26438, "verse_number": "२-९८-३५", "content_sanskrit": "पाण्डुपाण्डुरशृङ्गैश्च शातकुम्भपरिष्कृतैः ।\nरन्नसानुगुहाशृङ्गैर्विचित्रैरिव पर्वतैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006438035, "chapter_id": 26438, "verse_number": "२-९८-३६", "content_sanskrit": "पञ्चवर्णैः सुवर्णैश्च पुष्पवृष्टिसमप्रभैः ।\nपर्जन्यतुल्यनिर्घोषैर्नानारूपैरिवाद्रिभिः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006438036, "chapter_id": 26438, "verse_number": "२-९८-३७", "content_sanskrit": "दावाग्निज्वलितप्रख्यैर्निर्मितैर्विश्वकर्मणा ।\nआलिखद्भिरिवाकाशमतिचन्द्रार्कभास्वरैः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006438037, "chapter_id": 26438, "verse_number": "२-९८-३८", "content_sanskrit": "तैर्दाशार्हैर्महाभागैर्बभासे तद्वनद्रुमैः ।\nवासुदेवेन्द्रपर्जन्यैर्गृहमेघैरलंकृता ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006438038, "chapter_id": 26438, "verse_number": "२-९८-३९", "content_sanskrit": "ददृशे द्वारका चारुमेघैर्द्यौरिव संवृता ।\nसाक्षाद् भगवतो वेश्म विहितं विश्वकर्मणा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006438039, "chapter_id": 26438, "verse_number": "२-९८-४०", "content_sanskrit": "ददृशे वासुदेवस्य चतुर्योजनमायतम् ।\nतावदेव च विस्तीर्णमप्रमेयमहाधनम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006438040, "chapter_id": 26438, "verse_number": "२-९८-४१", "content_sanskrit": "प्रासादवरसम्पन्नं युक्तं जगति पर्वतैः ।\nयश्चकार महाभागस्त्वष्टा वासवनोदितः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006438041, "chapter_id": 26438, "verse_number": "२-९८-४२", "content_sanskrit": "प्रासादं चैव हेमाभं सर्वभूतमनोहरम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006438042, "chapter_id": 26438, "verse_number": "२-९८-४३", "content_sanskrit": "मेरोरिव गिरः शृङ्गमुच्छ्रितं काञ्चनं महत् ।\nरुक्मिण्याः प्रवरं वासं विहितं विश्वकर्मणा ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006438043, "chapter_id": 26438, "verse_number": "२-९८-४४", "content_sanskrit": "सत्यभामा पुनर्वेश्म यदावसत पाण्डुरम् ।\nविचित्रमणिसोपानं तद् विदुर्भोगवानिति ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006438044, "chapter_id": 26438, "verse_number": "२-९८-४५", "content_sanskrit": "विमलादित्यवर्णाभिः पताकाभिरलंकृतम् ।\nव्यक्तसंजवनोद्देशो यश्चतुर्दिङ्महाध्वजः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006438045, "chapter_id": 26438, "verse_number": "२-९८-४६", "content_sanskrit": "स च प्रासादमुख्योऽथ जाम्बवत्या विभूषितः ।\nप्रभयाभ्यभवत् सर्वांस्तानन्यो भास्करो यथा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006438046, "chapter_id": 26438, "verse_number": "२-९८-४७", "content_sanskrit": "उद्यद्भास्करवर्णाभस्तयोरन्तरमाश्रितः ।\nविश्वकर्मकृतो दिव्यः कैलासशिखरोपमः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006438047, "chapter_id": 26438, "verse_number": "२-९८-४८", "content_sanskrit": "जाम्बूनद इवादीप्तः प्रदीप्तज्वलनो यथा ।\nसागरप्रतिमोऽतिष्ठन्मेरुरित्यभिविश्रुतः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006438048, "chapter_id": 26438, "verse_number": "२-९८-४९", "content_sanskrit": "तस्मिन् गान्धारराजस्य दुहिता कुलशालिनी ।\nगान्धारी भरतश्रेष्ठ केशवेन निवेशिता ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006438049, "chapter_id": 26438, "verse_number": "२-९८-५०", "content_sanskrit": "पद्मकूल इति ख्यातं पद्मवर्णं महाप्रभम् ।\nसुभीमाया महाकूटं वेश्मातिरुचिरप्रभम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006438050, "chapter_id": 26438, "verse_number": "२-९८-५१", "content_sanskrit": "सूर्यप्रभस्तु प्रासादः सर्वकामगुणैर्युतः ।\nलक्ष्मणाया नृपश्रेष्ठ निर्दिष्टः शार्ङ्गधन्वना ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006438051, "chapter_id": 26438, "verse_number": "२-९८-५२", "content_sanskrit": "वैडूर्यमणिवर्णाभः प्रासादो हरितप्रभः ।\nयं विदुः सर्वभूतानि परमित्येव भारत ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006438052, "chapter_id": 26438, "verse_number": "२-९८-५३", "content_sanskrit": "वासं तं मित्रविन्दाया देवर्षिगणपूजितम् ।\nमहिष्या वासुदेवस्य भूषणं तेषु वेश्मसु ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006438053, "chapter_id": 26438, "verse_number": "२-९८-५४", "content_sanskrit": "यस्तु प्रासादमुख्योऽत्र विहितो विश्वकर्मणा ।\nअतीव रम्यरम्योऽसौ धिष्ठितः पर्वतो यथा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006438054, "chapter_id": 26438, "verse_number": "२-९८-५५", "content_sanskrit": "सुवार्ताया निवासः स प्रशस्तः सर्वदैवतैः ।\nमहिष्या वासुदेवस्य केतुमानिति विश्रुतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7006438055, "chapter_id": 26438, "verse_number": "२-९८-५६", "content_sanskrit": "यस्तु प्रासादमुख्यो वै यं त्वष्टा विदधे स्वयम् ।\nयोजनायतविप्कम्भः सर्वरत्नमयः शुभः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7006438056, "chapter_id": 26438, "verse_number": "२-९८-५७", "content_sanskrit": "स श्रीमान् विरजा नाम व्यराजत्तत्र सुप्रभः ।\nउपस्थानगृहं यत्र केशवस्य महात्मनः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7006438057, "chapter_id": 26438, "verse_number": "२-९८-५८", "content_sanskrit": "तस्मिन् सुविहिताः सर्वे रुक्मदण्डाः पताकिनः ।\nसदने वासुदेवस्य मार्गसंजवनध्वजाः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7006438058, "chapter_id": 26438, "verse_number": "२-९८-५९", "content_sanskrit": "रत्नजालानि दिव्यानि तत्रैव च निवेशिताः ।\nआहृत्य यदुसिंहेन वैजयन्तोऽचलो महान् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7006438059, "chapter_id": 26438, "verse_number": "२-९८-६०", "content_sanskrit": "हंसकूटस्य यच्छृङ्गमिन्द्रद्युम्नसरः प्रति ।\nषष्टितालसमुत्सेधमर्धयोजनमायतम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7006438060, "chapter_id": 26438, "verse_number": "२-९८-६१", "content_sanskrit": "सकिन्नरमहानागं तदप्यमिततेजसा ।\nपश्यतां सर्वभूतानामानीतं लोकविश्रुतम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7006438061, "chapter_id": 26438, "verse_number": "२-९८-६२", "content_sanskrit": "आदित्यपथगं यत् तु मेरोः शिखरमुत्तमम् ।\nजाम्बूनदमयं दिव्यं त्रिषु लोकेषु विश्रुतम् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7006438062, "chapter_id": 26438, "verse_number": "२-९८-६३", "content_sanskrit": "तदप्युत्पाट्य कृष्णार्थमानीतं विश्वकर्मणा ।\nभ्राजमानमतीवाग्र्यं सर्वौषधिसमन्वितम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7006438063, "chapter_id": 26438, "verse_number": "२-९८-६४", "content_sanskrit": "तदिन्द्रवचनात् त्वष्टा कार्यहेतोः समानयत् ।\nपारिजातश्च तत्रैव केशवेनाहृतः स्वयम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7006438064, "chapter_id": 26438, "verse_number": "२-९८-६५", "content_sanskrit": "नीयमाने तु तत्रासीद् युद्धमद्भुतकर्मणः ।\nकृष्णस्य येऽभ्यरक्षंस्तु देवाः पादपमुत्तमम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7006438065, "chapter_id": 26438, "verse_number": "२-९८-६६", "content_sanskrit": "पुण्डरीकशतैर्जुष्टं विमानैश्च हिरण्मयैः ।\nविहिता वासुदेवार्थं रत्नपुष्पफलद्रुमाः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7006438066, "chapter_id": 26438, "verse_number": "२-९८-६७", "content_sanskrit": "पद्मखण्डजलोपेता रत्नसौगन्धिकोत्पलाः ।\nमणिहेमप्लवाकीर्णाः पुष्करिण्यः सरांसि च ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7006438067, "chapter_id": 26438, "verse_number": "२-९८-६८", "content_sanskrit": "तासां परमकूलानि शोभयन्ति महाद्रुमाः ।\nशालास्तालाः कदम्बाश्च शतशाखाश्च रौहिणाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7006438068, "chapter_id": 26438, "verse_number": "२-९८-६९", "content_sanskrit": "ये च हैमवता वृक्षा ये च मेरुरुहास्तथा ।\nआहृत्य यदुसिंहार्थं विहिता विश्वकर्मणा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7006438069, "chapter_id": 26438, "verse_number": "२-९८-७०", "content_sanskrit": "रक्तपीतारुणश्यामाः श्वेतपुष्पाश्च पादपाः ।\nसर्वर्तुफलसम्पन्नास्तेषु काननसन्धिषु ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7006438070, "chapter_id": 26438, "verse_number": "२-९८-७१", "content_sanskrit": "समकूलजलोपेताः शान्तशर्करवालुकाः ।\nतस्मिन् पुरवरे नद्यः प्रसन्नसलिला ह्रदाः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7006438071, "chapter_id": 26438, "verse_number": "२-९८-७२", "content_sanskrit": "पुष्पाकुलजलोपेता नानाद्रुमलताकुलाः ।\nअपराश्चाभवन् नद्यो हेमशर्करवालुकाः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7006438072, "chapter_id": 26438, "verse_number": "२-९८-७३", "content_sanskrit": "मत्तबर्हिणसंघैश्च कोकिलैश्च सदामदैः ।\nबभूवुः परमोपेतास्तस्यां पुर्यां च पादपाः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7006438073, "chapter_id": 26438, "verse_number": "२-९८-७४", "content_sanskrit": "तत्रैव गजयूथानि पुरे गोमहिषास्तथा ।\nनिवासश्च कृतस्तत्र वराहमृगपक्षिभिः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7006438074, "chapter_id": 26438, "verse_number": "२-९८-७५", "content_sanskrit": "पुर्यां तस्यां तु रम्यायां प्राकारो वै हिरण्मयः ।\nव्यक्तः किष्कुशतोत्सेधो विहितो विश्वकर्मणा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7006438075, "chapter_id": 26438, "verse_number": "२-९८-७६", "content_sanskrit": "अतीव रम्यः सोऽथासीद् वेष्टितः पर्वतो यथा ।\nते च ते च महाशैलाः सरितश्च सरांसि च ।\nपरिक्षिप्तानि भौमेन वनान्युपवनानि च ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]