[{"id": 50003243, "chapter_id": 10682, "verse_number": "1", "content_sanskrit": "॥ कर्मणां भोगतः क्षयासम्भवः, नापि फलाभावः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50003244, "chapter_id": 10682, "verse_number": "2", "content_sanskrit": "न कर्मणामनारम्भान्नैष्कर्म्यं पुरुषोऽश्नुते। नच सन्न्यसनादेव सिद्धिं समधिगच्छति॥ ३/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50003245, "chapter_id": 10682, "verse_number": "3", "content_sanskrit": "॥ कर्मणामकर्तुमशक्यत्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50003246, "chapter_id": 10682, "verse_number": "4", "content_sanskrit": "नहि कश्चित् क्षणमपि जातु तिष्ठत्यकर्मकृत्। कार्यते ह्यवशः कर्म सर्वः प्रकृतिजैर्गुणैः॥ ३/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50003247, "chapter_id": 10682, "verse_number": "5", "content_sanskrit": "॥ मिथ्याचारत्वप्रसङ्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50003248, "chapter_id": 10682, "verse_number": "6", "content_sanskrit": "कर्मेन्द्रियाणि संयम्य य आस्ते मनसा स्मरन्। इन्द्रियार्थान् विमूढात्मा मिथ्याचारः स उच्यते॥ ३/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50003249, "chapter_id": 10682, "verse_number": "7", "content_sanskrit": "यस्त्विन्द्रियाणि मनसा नियम्यारभतेऽर्जुन। कर्मेन्द्रियैः कर्मयोगमसक्तः स विशिष्यते॥ ३/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50003250, "chapter_id": 10682, "verse_number": "8", "content_sanskrit": "नियतं कुरु कर्म त्वं कर्म ज्यायो ह्यकर्मणः। शरीरयात्राऽपि च ते न प्रसिद्ध्येदकर्मणः॥ ३/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50003251, "chapter_id": 10682, "verse_number": "9", "content_sanskrit": "॥ अवैष्णवकर्मण एव बन्धकत्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50003252, "chapter_id": 10682, "verse_number": "10", "content_sanskrit": "यज्ञार्थात् कर्मणोऽन्यत्र लोकोऽयं कर्मबन्धनः। तदर्थं कर्म कौन्तेय मुक्तसङ्गः समाचर॥ ३/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50003253, "chapter_id": 10682, "verse_number": "11", "content_sanskrit": "॥ प्रजापतिवचनलङ्घनप्रसङ्गः, कृतघ्नत्वापत्तिश्च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50003254, "chapter_id": 10682, "verse_number": "12", "content_sanskrit": "सहयज्ञाः प्रजाः सृष्ट्वा पुरोवाच प्रजापतिः। अनेन प्रसविष्यध्वमेष वोऽस्त्विष्टकामधुक्॥ ३/१०॥ देवान् भावयतानेन ते देवा भावयन्तु वः। परस्परं भावयन्तः श्रेयः परमवाप्स्यथ॥ ३/११॥ इष्टान् भोगान् हि वो देवा दास्यन्ते यज्ञभाविताः। तैर्दत्तानप्रदायैभ्यो यो भुङ्क्ते स्तेन एव सः॥ ३/१२॥ यज्ञशिष्टाशिनः सन्तो मुच्यन्ते सर्वकिल्बिषैः। भुञ्जते ते त्वधं पापा ये पचन्त्यात्मकारणात्॥ ३/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50003255, "chapter_id": 10682, "verse_number": "13", "content_sanskrit": "॥ जगच्चक्रनिरूपणम्, तदप्रवर्तनेन विश्वहननदोषप्रसङ्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50003256, "chapter_id": 10682, "verse_number": "14", "content_sanskrit": "अन्नाद् भवन्ति भूतानि पर्जन्यादन्नसम्भवः। यज्ञाद् भवति पर्जन्यो यज्ञः कर्मसमुद्भवः॥ ३/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50003257, "chapter_id": 10682, "verse_number": "15", "content_sanskrit": "कर्म ब्रह्मोद्भवं विद्धि ब्रह्माक्षरसमुद्भवम्। तस्मात् सर्वगतं ब्रह्म नित्यं यज्ञे प्रतिष्ठितम्॥ ३/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50003258, "chapter_id": 10682, "verse_number": "16", "content_sanskrit": "एवं प्रवर्तितं चक्रं नानुवर्तयतीह यः। अघायुरिन्द्रियारामो मोघं पार्थ स जीवति॥ ३/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50003259, "chapter_id": 10682, "verse_number": "17", "content_sanskrit": "॥ असम्प्रज्ञातसमाधिस्थस्यैव कर्माभावः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50003260, "chapter_id": 10682, "verse_number": "18", "content_sanskrit": "यस्त्वात्मरतिरेव स्यादात्मतृप्तश्च मानवः। आत्मन्येव च सन्तुष्टस्तस्य कार्यं न विद्यते॥ ३/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50003261, "chapter_id": 10682, "verse_number": "19", "content_sanskrit": "नैव तस्य कृतेनार्थो नाकृतेनेह कश्चन। नचास्य सर्वभूतेषु कश्चिदर्थव्यपाश्रयः॥ ३/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]