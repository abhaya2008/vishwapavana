[{"id": 50002414, "chapter_id": 10586, "verse_number": "1", "content_sanskrit": "॥ ज्ञानस्य दुःसाध्यत्वम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50002415, "chapter_id": 10586, "verse_number": "2", "content_sanskrit": "विषया विनिवर्तन्ते निराहारस्य देहिनः। रसवर्जं रसोऽप्यस्य परं दृष्ट्वा निवर्तते॥ २/५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50002416, "chapter_id": 10586, "verse_number": "3", "content_sanskrit": "यततो ह्यपि कौन्तेय पुरुषस्य विपश्चितः। इन्द्रियाणि प्रमाथीनि हरन्ति प्रसभं मनः॥ २/६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50002417, "chapter_id": 10586, "verse_number": "4", "content_sanskrit": "तानि सर्वाणि संयम्य युक्त आसीत मत्परः। वशे हि यस्येन्द्रियाणि तस्य प्रज्ञा प्रतिष्ठिता॥ २/६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50002418, "chapter_id": 10586, "verse_number": "5", "content_sanskrit": "ध्यायतो विषयान् पुंसः सङ्गस्तेषूपजायते। सङ्गात् सञ्जायते कामः कामात् क्रोधोऽभिजायते॥ २/६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50002419, "chapter_id": 10586, "verse_number": "6", "content_sanskrit": "क्रोधाद् भवति सम्मोहः सम्मोहात् स्मृतिविभ्रमः। स्मृतिभ्रंशाद् बुद्धिनाशो बुद्धिनाशाद् विनश्यति॥ २/६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50002420, "chapter_id": 10586, "verse_number": "7", "content_sanskrit": "॥ रागादिदोषपरिहारेणेन्द्रियजयः, तेन च मनःप्रसादद्वारा ज्ञानम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50002421, "chapter_id": 10586, "verse_number": "8", "content_sanskrit": "रागद्वेषवियुक्तैस्तु विषयानिन्द्रियैश्चरन्। आत्मवश्यैर्विधेयात्मा प्रसादमधिगच्छति॥ २/६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50002422, "chapter_id": 10586, "verse_number": "9", "content_sanskrit": "प्रसादे सर्वदुःखानां हानिरस्योपजायते। प्रसन्नचेतसो ह्याशु बुद्धिः पर्यवतिष्ठति॥ २/६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50002423, "chapter_id": 10586, "verse_number": "10", "content_sanskrit": "॥ मनःप्रसादाभावे दोषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50002424, "chapter_id": 10586, "verse_number": "11", "content_sanskrit": "नास्ति बुद्धिरयुक्तस्य नचायुक्तस्य भावना। नचाभावयतः शान्तिरशान्तस्य कुतः सुखम्॥ २/६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50002425, "chapter_id": 10586, "verse_number": "12", "content_sanskrit": "इन्द्रियाणां हि चरतां यन्मनोऽनुविधीयते। तदस्य हरति प्रज्ञां वायुर्नावमिवाम्भसि॥ २/६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50002426, "chapter_id": 10586, "verse_number": "13", "content_sanskrit": "॥ उपसंहारः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50002427, "chapter_id": 10586, "verse_number": "14", "content_sanskrit": "तस्माद् यस्य महाबाहो निगृहीतानि सर्वशः। इन्द्रियाणीन्द्रियार्थेभ्यस्तस्य प्रज्ञा प्रतिष्ठिता॥ २/६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]