[{"id": 2094936, "chapter_id": 3030, "verse_number": "१३-१६०-१", "content_sanskrit": "युधिष्ठिर उवाच।\nदानं बहुविधाकारं शान्तिः सत्यमहिंसितम्।\nस्वदारतुष्टिश्चोक्ता ते फलं दानस्य वाऽपि यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2094937, "chapter_id": 3030, "verse_number": "१३-१६०-२", "content_sanskrit": "पितामहस्य विदितं किमन्यत्तपसो बलात्।\nतपसो यत्परं तेऽद्य तन्नो व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2094938, "chapter_id": 3030, "verse_number": "१३-१६०-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2094939, "chapter_id": 3030, "verse_number": "१३-१६०-३", "content_sanskrit": "तपसः प्रक्षयो यावत्ताल्लोको युधिष्ठिर।\nमतं ममात्र कौन्तेय तपो नानशनात्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2094940, "chapter_id": 3030, "verse_number": "१३-१६०-४", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nभगीरथस्य संवादं ब्रह्मणश्च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2094941, "chapter_id": 3030, "verse_number": "१३-१६०-५", "content_sanskrit": "अतीत्य सुरलोकं च गवां लोकं च भारत।\nऋषिलोकं च सोऽगच्छद्भगीरथ इति श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2094942, "chapter_id": 3030, "verse_number": "१३-१६०-६", "content_sanskrit": "तं तु दृष्ट्वा वचः प्राह ब्रह्मा राजन्भगीरथम्।\nकथं भगीरथाऽऽगास्त्वमिमं लोकं दुरासदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2094943, "chapter_id": 3030, "verse_number": "१३-१६०-७", "content_sanskrit": "न हि देवा न गन्धर्वा न मनुष्या भगीरथ।\nआयान्त्यतप्ततपसः कथं वै त्वमिहागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2094944, "chapter_id": 3030, "verse_number": "१३-१६०-८x", "content_sanskrit": "भगीरथ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2094945, "chapter_id": 3030, "verse_number": "१३-१६०-८", "content_sanskrit": "निश्शङ्कमन्नमददां ब्राह्मणोभ्यः\nशतं सहस्राणि सदैवतानाम्।\nब्राह्मं व्रतं नित्यमास्थाय विद्व-\nन्न त्वेवाहं तस्य फलादिहागाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2094946, "chapter_id": 3030, "verse_number": "१३-१६०-९", "content_sanskrit": "दशैकरात्रान्दशपञ्चरात्रा-\nनेकादशैकादशकान्क्रतूंश्च।\nज्योतिष्टोमानां च शतं यदिष्टं\nफलेन तेनापि च नागतोऽहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2094947, "chapter_id": 3030, "verse_number": "१३-१६०-१०", "content_sanskrit": "यच्चावसं जाह्नवीतीरनित्यः\nशतं समास्तप्यमानस्तपोऽहम्।\nअदां च तत्राश्वतरीसहस्रं\nनारीपुरं न च तेनाहमागाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2094948, "chapter_id": 3030, "verse_number": "१३-१६०-११", "content_sanskrit": "दशायुतानि चाश्वानां गोऽयुतानि च विंशतिम्।\nपुष्करेषु द्विजातिभ्यः प्रादां शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2094949, "chapter_id": 3030, "verse_number": "१३-१६०-१२", "content_sanskrit": "सुवर्णचन्द्रोत्तमधारिणीनां\nकन्योत्तमानामददं सहस्रम्।\nषष्टिं सहस्राणि विभूषितानां\nजाम्बूनदैराभरणैर्न तेन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2094950, "chapter_id": 3030, "verse_number": "१३-१६०-१३", "content_sanskrit": "दशार्बुदान्यददं गोसवेज्या-\nस्वेकैकशो दश गा ओकनाथ।\nसमानवत्साः पयसा समन्विताः\nसुवर्णकांस्योपदुहा न तेन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2094951, "chapter_id": 3030, "verse_number": "१३-१६०-१४", "content_sanskrit": "आप्तोर्यामेषु नियतमेकैकस्मिन्दशाददम्।\nगृष्टीनां क्षीरदोग्ध्रीणां रोहिणीनां शतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2094952, "chapter_id": 3030, "verse_number": "१३-१६०-१५", "content_sanskrit": "दोग्ध्रीणां वै गवां चापि प्रयुतानि दशैव ह।\nप्रादां दशगुणं ब्रह्मन्न तेनाहमिहागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2094953, "chapter_id": 3030, "verse_number": "१३-१६०-१६", "content_sanskrit": "वाजिनां बाह्लिजातानामयुतान्यददं दश।\nकर्काणां हेममालानां न च तेनाहमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2094954, "chapter_id": 3030, "verse_number": "१३-१६०-१७", "content_sanskrit": "कोटीश्च काञ्चनस्याष्टौ प्रादां ब्रह्मन्दशान्वहम्।\nएकैकस्मिन्क्रतौ तेन फलेनाहं न चागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2094955, "chapter_id": 3030, "verse_number": "१३-१६०-१८", "content_sanskrit": "वाजिनां श्यामकर्णानां हरितानां पितामह।\nप्रादां हेमस्रजां ब्रह्मन्कोटीर्दश च सप्त च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2094956, "chapter_id": 3030, "verse_number": "१३-१६०-१९", "content_sanskrit": "ईषादन्तान्महाकायान्काञ्चतस्रग्विभूषितान्।\nपद्मिनो वै सहस्राणि प्रादां दश च सप्त च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2094957, "chapter_id": 3030, "verse_number": "१३-१६०-२०", "content_sanskrit": "अलङ्कृतानां देवेश दिव्यैः कनकभूषणैः।\nरथानां काञ्चनाङ्गानां सहस्राण्यददं दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2094958, "chapter_id": 3030, "verse_number": "१३-१६०-२१", "content_sanskrit": "सप्त चान्यानि युक्तानि वाजिभिः समलङ्कृतैः।\nदक्षिणावयवाः केचिद्वेदैर्ये सम्प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2094959, "chapter_id": 3030, "verse_number": "१३-१६०-२२", "content_sanskrit": "वाजपेयेषु दशसु प्रादां तेष्वपि चाप्यहम्।\nशक्रतुल्यप्रभावाणामिज्यया विक्रमेण ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2094960, "chapter_id": 3030, "verse_number": "१३-१६०-२३", "content_sanskrit": "सहस्रं निष्ककण्ठानामददं दक्षिणामहम्।\nविजित्य भूपतीन्सर्वानर्थैरिष्ट्वा पितामह।\nअष्टभ्यो राजसूयेभ्यो न च तेनाहमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2094961, "chapter_id": 3030, "verse_number": "१३-१६०-२४", "content_sanskrit": "स्रोतश्च यावद्गङ्गायाश्छन्नमासीज्जगत्पते।\nदक्षिणाभिः प्रवृत्ताभिर्मम नागां च तत्कृते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2094962, "chapter_id": 3030, "verse_number": "१३-१६०-२५", "content_sanskrit": "वाजिनां च सहस्रे द्वे सुवर्णशतभूषिते।\nवरं ग्रामशतं चाहमेकैकस्यां तिथावदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2094963, "chapter_id": 3030, "verse_number": "१३-१६०-२६", "content_sanskrit": "तपस्वी नियताहारः शममास्थाय वाग्यतः।\nदीर्घकालं हिमवति गङ्गार्थमचरं तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2094964, "chapter_id": 3030, "verse_number": "१३-१६०-२७", "content_sanskrit": "मूर्ध्ना हरं महादेवं प्रणम्याभ्यर्चयन्नृपः।\nन तेनाप्यहमागच्छं फलेनेह पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2094965, "chapter_id": 3030, "verse_number": "१३-१६०-२८", "content_sanskrit": "शम्याक्षेपैरयजं यच्च देवा-\nञ्शतैः क्रतूनामयुतैश्चापि यच्च।\nत्रयोदशद्वादशाहैश्च देव\nसपौण्डरीकैर्न च तेषां फलेन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2094966, "chapter_id": 3030, "verse_number": "१३-१६०-२९", "content_sanskrit": "अष्टौ सहस्राणि ककुद्मिनामहं\nशुक्लर्षभाणामददं द्विजेभ्यः।\nएकैकं वै काञ्चनं शृङ्गमेभ्यः\nपत्नीश्चैषामददं निष्ककण्ठीः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2094967, "chapter_id": 3030, "verse_number": "१३-१६०-३०", "content_sanskrit": "हिरण्यरत्ननिचयानददं रत्नपर्वतान्।\nधनधान्यैः समृद्धांश्च ग्रामाञ्शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2094968, "chapter_id": 3030, "verse_number": "१३-१६०-३१", "content_sanskrit": "शतं शतानां गृष्टीनामददं चाप्यतन्द्रितः।\nइष्ट्वाऽनेकैर्महायज्ञैर्ब्राह्मणेभ्यो न तेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2094969, "chapter_id": 3030, "verse_number": "१३-१६०-३२", "content_sanskrit": "एकादशाहैरयजं सदक्षिणै-\nर्द्विर्द्वादशाहैरश्वमेधैश्च देव।\nगवां धनैः षोडशभिश्च ब्रह्मं-\nस्तेषां फलेनेह न चागतोऽस्मि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2094970, "chapter_id": 3030, "verse_number": "१३-१६०-३३", "content_sanskrit": "निष्कैककण्ठमददं योजनायतं\nतद्विस्तीर्णं काञ्चनपादपानाम्।\nवनं चूतानां रत्नविभूषितानां\nनचैव तेषामागतोऽहं फलेन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2094971, "chapter_id": 3030, "verse_number": "१३-१६०-३४", "content_sanskrit": "तुरायणं हि व्रतमप्यधृष्य-\nमक्रोधनोऽकरवं त्रिंशदब्दान्।\nशतं गवामष्टशतानि चैव\nदिनेदिने ह्यददं ब्राह्मणेभ्यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2094972, "chapter_id": 3030, "verse_number": "१३-१६०-३५", "content_sanskrit": "पयस्विनीनामथ रोहिणीनां\nतथैवान्याननडुहो लोकनाथ।\nप्रादां नित्यं ब्राह्मणेभ्यः सुरेश\nनेहागतस्तेन फलेन चाहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2094973, "chapter_id": 3030, "verse_number": "१३-१६०-३६", "content_sanskrit": "`शम्याक्षेपेण पृथिवीं त्रिधा पर्यचरं यजन्।\nत्रिंशदग्नीनहं ब्रह्मन्नयजं यच्च नित्यदा।\nअष्टाभिः सर्वमेधैश्च नरमेधैश्च सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2094974, "chapter_id": 3030, "verse_number": "१३-१६०-३७", "content_sanskrit": "दशभिर्विश्वजिद्भिश्च शतैरष्टादशोत्तरैः।\nन चैव तेषां देवेश फलेनाहमिहागमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2094975, "chapter_id": 3030, "verse_number": "१३-१६०-३८", "content_sanskrit": "सरय्वां बाहुदायां च गङ्गायामथ नैमिषे।\nगवां शतानामयुतमददं न च तेन वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2094976, "chapter_id": 3030, "verse_number": "१३-१६०-३९", "content_sanskrit": "इन्द्रेण गुह्यं निहितं वै गुहायां\nयद्भार्गवस्तपसेहाभ्यविन्दत्।\nजाज्वल्यमानमुशनस्तेजसेह\nतत्साधयामासमहं वरेण्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2094977, "chapter_id": 3030, "verse_number": "१३-१६०-४०", "content_sanskrit": "`ब्राह्मणार्थाय कर्माणि रणं चैव करोमि यत्।\nततो मे ब्राह्मणास्तुष्टास्तस्मिन्कर्मणि साधिते।\n`पूजितैर्ब्राह्मणैर्नित्यं न च तेनाहमागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2094978, "chapter_id": 3030, "verse_number": "१३-१६०-४१", "content_sanskrit": "सहस्रमृषयश्चासन्ये वै तत्र समागताः।\nउक्तस्तैरस्मि गच्छ त्वं ब्रह्मलोकमिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2094979, "chapter_id": 3030, "verse_number": "१३-१६०-४२", "content_sanskrit": "प्रीतेनोक्तः सहस्रेण ब्राह्मणानामहं प्रभो।\nइमं लोकमनुप्राप्तो मा भूत्तेऽत्र विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2094980, "chapter_id": 3030, "verse_number": "१३-१६०-४३", "content_sanskrit": "कामं यथावद्विहितं विधात्रा\nपृष्टेन वाच्यं तु मया यथावत्।\nतपो हि नान्यच्चानशनान्मतं मे\nनमोस्तु ते देववर प्रसीद॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2094981, "chapter_id": 3030, "verse_number": "१३-१६०-४४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2094982, "chapter_id": 3030, "verse_number": "१३-१६०-४४", "content_sanskrit": "इत्युक्तवन्तं ब्रह्मि तु राजानं स भगीरथम्।\nपूजयामास पूजार्हं विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2094983, "chapter_id": 3030, "verse_number": "१३-१६०-४५", "content_sanskrit": "तस्मादनशनैर्युक्तो विप्रान्पूज्य नित्यदा।\nविप्राणां वचनात्सर्वं परत्रेहं च सिध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2094984, "chapter_id": 3030, "verse_number": "१३-१६०-४६", "content_sanskrit": "वासोभिरन्नैर्गोभिस्च शुभैर्नैवेशिकैरपि।\nशुभैः सुरक्षणैश्चापि स्तोष्या एव द्विजास्तथा।\nएतदेव परं गुह्यमलोभेन समाचर॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2094985, "chapter_id": 3030, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि षष्ट्यधिकशततमोऽध्यायः॥ १६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]