[{"id": 7000956000, "chapter_id": 20956, "verse_number": "१-१८-१", "content_sanskrit": "तस्येवं दानबाशचेष्टां दृष्ट्वा दैत्यपतेर्भयात् ।\nआचचक्षुः स चोवाच सूदानाहूय सत्वरः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000956001, "chapter_id": 20956, "verse_number": "१-१८-२", "content_sanskrit": "हे सूदा मम पुत्रोऽसावन्येषामपि दुर्म्मतिः ।\nकुमार्गदेशको  दुष्टो हन्यतामविलम्बितम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000956002, "chapter_id": 20956, "verse_number": "१-१८-३", "content_sanskrit": "हालाहलं विषं तस्य सर्व्वभक्ष्येषु दीयताम् ।\nअविज्ञातमसौपापो हन्यतां  मा विचार्य्यताम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000956003, "chapter_id": 20956, "verse_number": "१-१८-४", "content_sanskrit": "ते तथैव ततश्वक्रुः प्रह्लादाय महात्मने ।\nविषदानं यथाज्ञप्तं पित्रा तस्य महात्मनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000956004, "chapter_id": 20956, "verse_number": "१-१८-५", "content_sanskrit": "हालाहलं विषं घोरमनन्तोज्वरणोन सः ।\nअभिमन्व्य सहान्नेन मैत्रेय बुभुजे तदा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000956005, "chapter_id": 20956, "verse_number": "१-१८-६", "content_sanskrit": "अविकारं स तदू भुक्त्वा प्रह्लादः स्वस्थमानसः ।\nअनन्तक्यातिनिर्वीर्य्य जरयामास तदूविषम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000956006, "chapter_id": 20956, "verse_number": "१-१८-७", "content_sanskrit": "ततस्तदा भयत्रस्ता जीर्णं दृष्ट्वा महद्रिषम् ।\nदैत्येश्वरमुपागम्य प्रणिपत्येदमब्रु वन् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000956007, "chapter_id": 20956, "verse_number": "१-१८-८", "content_sanskrit": "दैत्यराज! विष दत्तमस्माभिरतिभीषणम् ।\nजीर्णां तेन सहान्नेन प्रह्लादेन सुतेन ते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000956008, "chapter_id": 20956, "verse_number": "१-१८-९", "content_sanskrit": "त्वर्य्यतां त्वर्य्यां हे हे सद्यो दैत्यपुरोहिताः ।\nकृत्यां तस्य विनाशाय उत्पादयत मा चिरात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000956009, "chapter_id": 20956, "verse_number": "१-१८-१०", "content_sanskrit": "सकाशमागम्य ततः पह्लादं विनयान्वितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000956010, "chapter_id": 20956, "verse_number": "१-१८-११", "content_sanskrit": "जातस्त्रैलोक्यर्विख्यात् आयुष्मन्! ब्रह्मणः कुले ।\nदैत्यराजस्य तनयो हिरणयकशिपोर्भवान् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000956011, "chapter_id": 20956, "verse_number": "१-१८-१२", "content_sanskrit": "किं देवैः किमनन्तेन किमन्येन तवाश्वयः ।\nपिता ते सर्व्वलोकानां त्वं तथैव भविष्यसि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000956012, "chapter_id": 20956, "verse_number": "१-१८-१३", "content_sanskrit": "तस्मात् परित्यजैनां त्वं विपक्षस्तवसंहिताम् ।\nबाचं पिता समास्तानां गुरूणां परमो गुरुः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000956013, "chapter_id": 20956, "verse_number": "१-१८-१४", "content_sanskrit": "एवपमेतन्महाभागाः । श्लाच्यमेतन्महाकुलम् ।\nमरीचेः सकलेऽप्यस्मिन् त्रैलोक्ये कोऽन्यथा वदेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000956014, "chapter_id": 20956, "verse_number": "१-१८-१५", "content_sanskrit": "पिता च मम सर्व्वस्मिन् जगत्युत्कृष्टचेष्टतः ।\nएतदप्यवगच्छामि सत्यमत्रापि नानृतम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000956015, "chapter_id": 20956, "verse_number": "१-१८-१६", "content_sanskrit": "गुरूणामपि सर्व्वषां पिता परमको गुरुः ।\nयदुक्तं भ्रान्तिरत्रापि स्वल्पापि हि न विद्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000956016, "chapter_id": 20956, "verse_number": "१-१८-१७", "content_sanskrit": "पिता गुरुर्न सन्देहः पूजनीयः प्रयत्नतः ।\nतत्रापि नापराध्यामीत्येवं मनसि मे स्थितम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000956017, "chapter_id": 20956, "verse_number": "१-१८-१८", "content_sanskrit": "यदेतत् किमनन्तेनेत्युक्तं युष्माबिरीदृशम् ।\nको ब्रबीति यथायुक्तं किन्तु नैतद् वचोऽर्थवत् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000956018, "chapter_id": 20956, "verse_number": "१-१८-१९", "content_sanskrit": "इत्युक्त्वा सोऽभवन्मौनी तैषां गौखयन्त्रितः ।\nप्रहस्य च पुनः प्राह किमनन्तेन साध्विति ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000956019, "chapter_id": 20956, "verse_number": "१-१८-२०", "content_sanskrit": "साधु भोः किमनन्तेन साधु बो गुखो मम ।\nश्वूयतां यदनन्तेन यदि खेदं न यास्यथ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000956020, "chapter_id": 20956, "verse_number": "१-१८-२१", "content_sanskrit": "धर्म्मार्थकाममोक्षाख्याः पुरुषार्था उदाह्टताः ।\nचतुष्टयमिदं यस्मात् तस्मात् किं किमिदं वृथा ॥२१ ।.", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000956021, "chapter_id": 20956, "verse_number": "१-१८-२२", "content_sanskrit": "मरीचिमिश्रैर्दक्षण तथैवान्यैरनन्ततः ।\nधर्म्मः प्राप्तस्तथैवान्यैरर्थः कालस्तथापरैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000956022, "chapter_id": 20956, "verse_number": "१-१८-२३", "content_sanskrit": "तत्तत्त्ववेदिनो भूत्त्वा ज्ञानध्यानसमाधिभिः ।\nअवापुर्मुक्तिमपरे पुरुषा ध्वस्तबन्धनाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000956023, "chapter_id": 20956, "verse_number": "१-१८-२४", "content_sanskrit": "सम्पदैश्वर्य्यमाहात्म्यज्ञानसन्ततिकर्म्मणाम् ।\nविमुक्तेश्चैकतालब्यं मूलमाराधनं हरेः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000956024, "chapter_id": 20956, "verse_number": "१-१८-२५", "content_sanskrit": "यतो धर्म्मार्थकामाख्यं मुक्तिश्वापि फलं द्रिजाः ।\nतेनापि हि किमेत्येवमनन्तेनं किमुच्चते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000956025, "chapter_id": 20956, "verse_number": "१-१८-२६", "content_sanskrit": "किञ्चात्र बहनोक्तेन भवन्तो गरवो मम ।\nवदन्तु साधु वाऽसाधु विवेकोऽस्माकमाल्पकः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000956026, "chapter_id": 20956, "verse_number": "१-१८-२७", "content_sanskrit": "दह्ममानस्त्वसस्मभिरग्रिना बाल रक्षितः ।\nभूयो न वक्ष्यसीत्येवं नैव ज्ञातोऽस्यबुद्धिमान् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000956027, "chapter_id": 20956, "verse_number": "१-१८-२८", "content_sanskrit": "यदास्मदूवचनान्मोहग्राहं न त्यक्ष्यते भवान् ।\nततः कृत्यां विनाशाय तव स्त्रक्ष्याम दुर्म्मतेः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000956028, "chapter_id": 20956, "verse_number": "१-१८-२९", "content_sanskrit": "कः केन हन्यते जन्तुर्जन्तुः कः केन रक्ष्यते ।\nहन्ति रक्षति चैवात्मा ह्मसत् साधु सामाचरन् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000956029, "chapter_id": 20956, "verse_number": "१-१८-३०", "content_sanskrit": "इत्युक्तास्तेन ते क्रुद्धा दैत्यराजपुरोहिताः ।\nकृत्यामुत्पादयामासुर्ज्वालामालोज्ज्बलाकृतिम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000956030, "chapter_id": 20956, "verse_number": "१-१८-३१", "content_sanskrit": "अतिभीमा समागम्य पादन्यासक्षति) ।\nशूलेन सा सुसंक्रु द्धा तं जघानाशु वक्षसि ॥३१ ।.", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000956031, "chapter_id": 20956, "verse_number": "१-१८-३२", "content_sanskrit": "ततू तस्य ह्टदयं प्राप्य शूलं बालस्य दीप्तिमत् ।\nजगाम खणिडतं भूमौ तत्रापि शतधा गतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000956032, "chapter_id": 20956, "verse_number": "१-१८-३३", "content_sanskrit": "यत्रानपायी भगवान् ह्टद्यास्ते हरिरीख्वरः ।\nभङ्गो भवति वजूस्य तत्र शूलस्य का कथा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000956033, "chapter_id": 20956, "verse_number": "१-१८-३४", "content_sanskrit": "अपाये तत्र पापैश्च पातिता तत्र याजकैः ।\nतानेव सा जद्यानाशु कृत्या नाशं जगाम ष ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000956034, "chapter_id": 20956, "verse_number": "१-१८-३५", "content_sanskrit": "कृत्यया दह्ममानांस्तान् विलोक्य स महामतिः ।\nत्राहि कृष्णेत्यनन्तेति वदन्नभ्यवपद्यत ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000956035, "chapter_id": 20956, "verse_number": "१-१८-३६", "content_sanskrit": "सर्व्वव्यापिन् जगद्रपू जगतूस्त्रर्जनार्दन ।\nपाहि विप्रानिमानस्मादू दुःसहान्मन्त्रपावकात् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000956036, "chapter_id": 20956, "verse_number": "१-१८-३७", "content_sanskrit": "यथा सर्व्वेषुभूतेषु सर्व्वव्यापी जगदूगुरुः ।\nविष्णुरेव तथा सर्व्वे जीवन्त्वेते पुरोहिताः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000956037, "chapter_id": 20956, "verse_number": "१-१८-३८", "content_sanskrit": "यथा सर्व्वगतं विष्णुं मन्यमानो न पावकम् ।\nचिन्तयाम्यरिपक्षेऽपि जीवन्त्वेते पुरोहिताः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000956038, "chapter_id": 20956, "verse_number": "१-१८-३९", "content_sanskrit": "ये हन्तुमागता दत्तं यैर्विषं यैर्हु ताशनः ।\nयैर्द्दिगूगजैरहं क्षुणणो दष्टः सर्पैश्व यैरपि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000956039, "chapter_id": 20956, "verse_number": "१-१८-४०", "content_sanskrit": "तेष्वहं मित्रभावेन समः पापोऽस्मि न ववचित् ।\nतथा तेनाद्य सत्येन जीवन्त्वसुरयाजकाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000956040, "chapter_id": 20956, "verse_number": "१-१८-४१", "content_sanskrit": "इत्युक्तास्तेन ते सर्व्वै संस्पृष्टाश्व निरामयाः ।\nसमुत्तस्थुर्द्रिजा भूयस्तञ्चोचुः प्रश्वयान्वितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000956041, "chapter_id": 20956, "verse_number": "१-१८-४२", "content_sanskrit": "दीर्घायुरप्रतिहत-बलवीर्य्यसमन्वितः ।\nपुत्र-पौत्र-धनैश्वर्य्ययुक्तो वत्स! भवोत्तम ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000956042, "chapter_id": 20956, "verse_number": "१-१८-४३", "content_sanskrit": "इत्युत्तवा तं ततो गत्वा यथावृत्तं परोहिताः ।\nदैत्यराजाय सकलमाचचक्षु र्महामुने ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]