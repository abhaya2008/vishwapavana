[{"id": 7000966000, "chapter_id": 20966, "verse_number": "२-६-१", "content_sanskrit": "पराशर उवाच\nततश्च नरका विप्र भुवोधः सलिलस्य च ।\nपापिनो येषु पात्यन्ते ताञ्छृणुष्वमहामुने ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000966001, "chapter_id": 20966, "verse_number": "२-६-२", "content_sanskrit": "रौरवः सूकरो रोधस्तालो विशसनस्तथा ।\nमहाज्वालस्तप्तकुम्भो लवणेथ विलोहितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000966002, "chapter_id": 20966, "verse_number": "२-६-३", "content_sanskrit": "रुधिराम्भो वैतरणिः क्रिमिशः क्रिमिभोजनः ।\nअसिपत्रवनं कृष्णो लालाभक्षश्च दारुणः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000966003, "chapter_id": 20966, "verse_number": "२-६-४", "content_sanskrit": "तथा पूयवहः पापो वह्निज्वालो ह्यधः शिराः ।\nसंदंशः कालसूत्रश्च तमश्चावीचिरेव च ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000966004, "chapter_id": 20966, "verse_number": "२-६-५", "content_sanskrit": "श्वभोजनोथाप्रतिष्ठश्चाप्रचिश्च तथा परः ।\nइत्येवमादयश्चान्ये नरका भृशदारुणाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000966005, "chapter_id": 20966, "verse_number": "२-६-६", "content_sanskrit": "यमस्य विषये घोराः शस्त्राग्निभयदायिनः ।\nपतन्ति येषु पुरुषाः पापकर्मरतास्तु ये ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000966006, "chapter_id": 20966, "verse_number": "२-६-७", "content_sanskrit": "कूटसाक्षी तथासम्यक्पक्षपातेन यो वदेत् ।\nयश्चान्यदनृतं वक्ति स नरो याति रौरवम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000966007, "chapter_id": 20966, "verse_number": "२-६-८", "content_sanskrit": "भ्रूणहा पुरहन्ता च गौघ्नश्च मुनिसत्तम ।\nयान्ति ते नरकं रोधं यश्चोच्छ्वासनिरोधकः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000966008, "chapter_id": 20966, "verse_number": "२-६-९", "content_sanskrit": "सुरापो ब्रह्महा हर्ता सुवर्णस्य च सूकरे ।\nप्रयान्ति नरके यश्च तैः संसर्गमुपैति वै ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000966009, "chapter_id": 20966, "verse_number": "२-६-१०", "content_sanskrit": "राजन्यवैश्यहन्ता च तथैव गुरुतल्पगः ।\nतप्तकुण्डेस्वसृगामी हन्ति राजभटांश्च यः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000966010, "chapter_id": 20966, "verse_number": "२-६-११", "content_sanskrit": "साध्वीविक्रयकृद्बन्धपालः केसरिविक्रयी ।\nतप्तलोहे पतन्त्येते यश्च च भक्तं परित्यजेत्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000966011, "chapter_id": 20966, "verse_number": "२-६-१२", "content_sanskrit": "स्नुषां सुतां चापि गत्वा महाज्वाले निपात्यते ।\nअवमन्ता गुरूणां यो यश्चाक्रोष्टा नराधमः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000966012, "chapter_id": 20966, "verse_number": "२-६-१३", "content_sanskrit": "वेददूषयितायश्च वेदविक्रयकश्च यः ।\nअगम्यगामी यश्च स्यात्ते यान्ति लवणं द्विज ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000966013, "chapter_id": 20966, "verse_number": "२-६-१४", "content_sanskrit": "चोरो विलोहे पतति मर्यादादूषकस्तथा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000966014, "chapter_id": 20966, "verse_number": "२-६-१५", "content_sanskrit": "देवद्विजपितृद्वेष्टा रत्नदूषयिता च यः ।\nस याति क्रिमिभक्षे वै क्रिमीशे च दुरिष्टकृत्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000966015, "chapter_id": 20966, "verse_number": "२-६-१६", "content_sanskrit": "पितृदेवातिथींस्त्यक्त्वा पर्यश्नाति नराधमः ।\nलालाभक्षे स यात्युग्रे शरकर्ता च वेधके ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000966016, "chapter_id": 20966, "verse_number": "२-६-१७", "content_sanskrit": "करोति कर्णिनो यश्च यश्च खङ्गादिकृन्नरः ।\nप्रयान्त्येते विशसने नरके भृशदरुणे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000966017, "chapter_id": 20966, "verse_number": "२-६-१८", "content_sanskrit": "असत्प्रतिगृहीता तु नरके यात्यधोमुखे ।\nअयाज्ययाजकश्चैव तथा नक्षत्रसूचकः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000966018, "chapter_id": 20966, "verse_number": "२-६-१९", "content_sanskrit": "वेगी पूयवहे चैको याति मष्टान्नभुङ्गरः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000966019, "chapter_id": 20966, "verse_number": "२-६-२०", "content_sanskrit": "लाक्षामासरसानां च तिलानां लवणस्य च ।\nविक्रेता ब्रह्मणो याति तमेव नरकं द्विज ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000966020, "chapter_id": 20966, "verse_number": "२-६-२१", "content_sanskrit": "मार्जारकुक्कुटच्छाग श्ववराहविहङ्गमान् ।\nपोषयन्नरकं याति तमेव द्विजसत्तम ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000966021, "chapter_id": 20966, "verse_number": "२-६-२२", "content_sanskrit": "रङ्गोपजीवी कैवर्तः कुम्डाशी गरदस्तथा ।\nसूची माहिषकश्चैव पर्वकारी च यो द्विजः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000966022, "chapter_id": 20966, "verse_number": "२-६-२३", "content_sanskrit": "अगारदाही मित्रघ्नः शाकुनिर्ग्रमयाजकः ।\nरुधिरान्धे पतन्त्येते सोमं विक्रीणते च ये ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000966023, "chapter_id": 20966, "verse_number": "२-६-२४", "content_sanskrit": "मखहा ग्रामहन्ता च याति वैतरणीं नरः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000966024, "chapter_id": 20966, "verse_number": "२-६-२५", "content_sanskrit": "रेतः पातादिकर्तारो मर्यादाभेदिनो हि ये ।\nते कृष्णे यान्त्यशौचाश्च कुहकाजीविनश्च ये ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000966025, "chapter_id": 20966, "verse_number": "२-६-२६", "content_sanskrit": "असिपत्रवनं याति वनच्छेदी वृथैव यः ।\nऔरभ्रिको मृगव्याधो वह्निज्वाले पतन्ति वै ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000966026, "chapter_id": 20966, "verse_number": "२-६-२७", "content_sanskrit": "यान्त्येते द्विज तत्रैव ये चापाकेषु वह्निदाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000966027, "chapter_id": 20966, "verse_number": "२-६-२८", "content_sanskrit": "व्रतानां लोपको यश्चस्वाश्रमाद्विच्युतश्च यः ।\nसन्दंशयातनामध्ये पततस्तावुभावपि ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000966028, "chapter_id": 20966, "verse_number": "२-६-२९", "content_sanskrit": "दिवा स्वप्ने च स्कन्दन्ते ये नरा ब्रह्मचारिणः ।\nपुत्रैरध्यापिता ये च ते पतन्ति श्वभोजने ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000966029, "chapter_id": 20966, "verse_number": "२-६-३०", "content_sanskrit": "एते चान्ये च नरकाः शतशोथ सहस्रशः ।\nयेषु दुष्कृतकर्माणः पच्यन्ते यातनागताः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000966030, "chapter_id": 20966, "verse_number": "२-६-३१", "content_sanskrit": "यथैव पापान्येतानि तथान्यानि सहस्रशः ।\nभुज्यन्ते तानि पुरुषैर्नरकान्तरगोचरैः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000966031, "chapter_id": 20966, "verse_number": "२-६-३२", "content_sanskrit": "वर्णाश्रमविरुद्धं च कर्म कुर्वन्ति ये नराः ।\nकर्मणा मनसा वाचा निरयेषु पतन्ति ते ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000966032, "chapter_id": 20966, "verse_number": "२-६-३३", "content_sanskrit": "अधः शिरोभिदृश्यन्ते नारकैर्दिवि देवताः ।\nदेवाश्चाधोमुखान्सर्वानधः पश्यन्ति नारकान् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000966033, "chapter_id": 20966, "verse_number": "२-६-३४", "content_sanskrit": "स्थावराः क्रिमयोब्जाश्च पक्षिणः पशवो नराः ।\nधार्मिकास्त्रिदशास्तद्धन्मोक्षिणश्च यथाक्रमम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000966034, "chapter_id": 20966, "verse_number": "२-६-३५", "content_sanskrit": "सहस्रभागप्रथमा द्वितीयानुक्रमास्तथा ।\nसर्वे ह्येते महाभागा यावन्मुक्तिसमाश्रयाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000966035, "chapter_id": 20966, "verse_number": "२-६-३६", "content_sanskrit": "यावन्तो जन्तवः स्वर्गे तावन्तो नरकौकसः ।\nपापकृद्याति नरकं प्रायाश्चित्तपराङ्मुखः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000966036, "chapter_id": 20966, "verse_number": "२-६-३७", "content_sanskrit": "पापानामनुरूपाणि प्रायश्चित्तानि यद्यथा ।\nतथा तथैव संस्मृत्य प्रोक्तानि परमर्षिभिः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000966037, "chapter_id": 20966, "verse_number": "२-६-३८", "content_sanskrit": "पापे गुरूणि गुरुणि स्वल्पान्यल्पे च तद्विदः ।\nप्रायश्चित्तानि मैत्रेय जगुः स्वायंभुवादयः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000966038, "chapter_id": 20966, "verse_number": "२-६-३९", "content_sanskrit": "प्रायश्चित्तान्यशेषाणि तपःकर्मात्मकानि वै ।\nयानि तेषामशेषाणां कृष्णानुस्मरणम्परम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000966039, "chapter_id": 20966, "verse_number": "२-६-४०", "content_sanskrit": "कृते पापेऽनुतापो वै यस्य पुंसः प्रजायते ।\nप्रायश्चित्तं तु तस्यैकं हरिसंस्मरणं परम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000966040, "chapter_id": 20966, "verse_number": "२-६-४१", "content_sanskrit": "प्रातर्निशि तथा सन्ध्यामध्याह्नादिषु संस्मरन् ।\nनारायणमवाप्नोति सद्यः पापक्षयन्नरः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000966041, "chapter_id": 20966, "verse_number": "२-६-४२", "content_sanskrit": "विष्णुसंस्मरणात्क्षीणसमस्तक्लेशसञ्चयः ।\nमुक्तिं प्रयाति स्वर्गाप्तिस्तस्य विघ्नोनुमीयते ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000966042, "chapter_id": 20966, "verse_number": "२-६-४३", "content_sanskrit": "वासुदेवे मनो यस्यजपहोमार्चनादिषु ।\nतस्यान्तरायो मैत्रेय देवेन्द्रत्वादिकं फलम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000966043, "chapter_id": 20966, "verse_number": "२-६-४४", "content_sanskrit": "क्व नाकपृष्ठगमनं पुनरावृत्तिलक्षणम् ।\nक्व जपो वासुदेवेति मुक्तिबीजमनुत्तमम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000966044, "chapter_id": 20966, "verse_number": "२-६-४५", "content_sanskrit": "तस्मादहर्निशं विष्णुं संस्मरन्पुरुषो मुने ।\nन याति नरकं मर्त्यः संक्षीणाखिलपातकः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000966045, "chapter_id": 20966, "verse_number": "२-६-४६", "content_sanskrit": "मनः प्रीतिकरः स्वर्गो नरकस्तद्विपर्ययः ।\nनरकस्वर्गसंज्ञे वै पापपुण्ये द्विजोत्तम ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000966046, "chapter_id": 20966, "verse_number": "२-६-४७", "content_sanskrit": "वस्त्वेकमेव दुःखाय सुखायेर्ष्यागमाय च ।\nकोपाय च यतस्तस्माद्वस्तु वस्त्वात्मकं कुतः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000966047, "chapter_id": 20966, "verse_number": "२-६-४८", "content_sanskrit": "तदेव प्रीतये भूत्वा पुनर्दुःखाय जायते ।\nतदेव कोपाय यतः प्रसादाय च जायते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000966048, "chapter_id": 20966, "verse_number": "२-६-४९", "content_sanskrit": "तस्माद्दुःखात्मकं नास्ति न च किञ्चित्सुखात्मकम् ।\nमनसः परिणामोयं सुखदुःखादिलक्षणः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000966049, "chapter_id": 20966, "verse_number": "२-६-५०", "content_sanskrit": "ज्ञानमेव परं ब्रह्म ज्ञानं बन्धाय चेष्यते ।\nज्ञानात्मकमिदं विश्वं न ज्ञानाद्विद्यते परम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000966050, "chapter_id": 20966, "verse_number": "२-६-५१", "content_sanskrit": "विद्याविद्येति मैत्रेय ज्ञानमेवोपधारय ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000966051, "chapter_id": 20966, "verse_number": "२-६-५२", "content_sanskrit": "एवमेतन्मयाख्यातं भवतो मण्डलं भुवः ।\nपातालानि च सर्वाणि तथैव नरका द्विज ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000966052, "chapter_id": 20966, "verse_number": "२-६-५३", "content_sanskrit": "समुद्राः पर्वताश्चैव द्वीपा वर्षाणि निम्नगाः ।\nसंक्षेपात्सर्वमाख्यातं किं भूयः श्रोतुमिच्छसि ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]