[{"id": 2060933, "chapter_id": 2303, "verse_number": "८-२४-०x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2060934, "chapter_id": 2303, "verse_number": "८-२४-१", "content_sanskrit": "भूय एव तु मद्रेश यत्त्वा वक्ष्यामि तच्छृणु।\nयथा पुरावृत्तमिदं युद्धे देवासुरे प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2060935, "chapter_id": 2303, "verse_number": "८-२४-२", "content_sanskrit": "यदुक्तवान्पितुर्मह्यं मार्कण्डेयो महातपाः।\nब्रुवतस्तदशेषेण मम राजर्षिसत्तम।\nनिबोध मनसा चात्र न ते कार्या विचारणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2060936, "chapter_id": 2303, "verse_number": "८-२४-३", "content_sanskrit": "`समुत्पन्नो हि राजानः प्रमोह इति निश्चयम्।\nकृत्वा चैव व्यवस्यन्ति सर्वे धर्मार्थनिश्चयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2060937, "chapter_id": 2303, "verse_number": "८-२४-४", "content_sanskrit": "देवानामसुराणां च महानासीत्समुच्छ्रयः।\nसैंहिकेयास्तदोद्वृत्ता विबुधानवसूदयन्।\nते निरस्तः कृता देवैर्दानवा बलगर्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2060938, "chapter_id": 2303, "verse_number": "८-२४-५", "content_sanskrit": "तत्रासीत्प्रथमो राजन्सङ्ग्रामस्तारकामयः।\nनिर्जिताश्च ततो दैत्या दैवतैरिति नः श्रुतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2060939, "chapter_id": 2303, "verse_number": "८-२४-६", "content_sanskrit": "भग्नदर्पा निरुत्साहाः पातालं विविशुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2060940, "chapter_id": 2303, "verse_number": "८-२४-७", "content_sanskrit": "निर्जितेषु च दैत्येषु तारकस्य सुतास्त्रयः।\nताराक्षः कमलाक्षश्च विद्युन्माली च पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2060941, "chapter_id": 2303, "verse_number": "८-२४-८", "content_sanskrit": "तप उग्रं समास्थाय नियमे परमे स्थिताः।\nतपसा कर्णयामासुर्देहांस्ताञ्शत्रुकर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2060942, "chapter_id": 2303, "verse_number": "८-२४-९", "content_sanskrit": "दमेन तपसा चैव नियमेन समाधिना।\nतेषां पितामहः प्रीतो वरदः प्रददौ वरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2060943, "chapter_id": 2303, "verse_number": "८-२४-१०", "content_sanskrit": "अवध्यत्वं च ते सर्वे सर्वभूतेषु सर्वदा।\nसहिता वरयामासः सर्वलोकपितामहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2060944, "chapter_id": 2303, "verse_number": "८-२४-११", "content_sanskrit": "तानब्रवीत्तदा देवः सर्वलोकगुरुः प्रभुः।\nनास्ति सर्वामरत्वं वै निवर्तध्वमितोऽसुराः।\nअन्यं वरं वृणीध्वं वै रोचते यादृशो हि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2060945, "chapter_id": 2303, "verse_number": "८-२४-१२", "content_sanskrit": "ततस्ते सहिता राजन्सम्प्रधार्यासकृद्बहुः।\nसर्वलोकेश्वरं वाक्यं प्रणम्यैनमथाऽब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2060946, "chapter_id": 2303, "verse_number": "८-२४-१३", "content_sanskrit": "वस्तुमिच्छाम नगरं कर्तुं कामगमं शुभम्।\nसर्वकामसमृद्वार्थमवध्यं देवदानवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2060947, "chapter_id": 2303, "verse_number": "८-२४-१४", "content_sanskrit": "यक्षरक्षोरगगणैर्नानाजातिभिरेव च।\nन कृत्याभिर्न शस्त्रैश्च न शापैर्ब्रह्मवादिनाम्।\nवध्येत त्रिपुरं देव प्रयच्छेः प्रपितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2060948, "chapter_id": 2303, "verse_number": "८-२४-१५", "content_sanskrit": "वयं पुराणि त्रीण्येव समास्थाय महीमिमाम्।\nविचरिष्याम लोकेऽस्मिंस्त्वत्प्रसादपुरस्कृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2060949, "chapter_id": 2303, "verse_number": "८-२४-१६", "content_sanskrit": "ततो वर्षसहस्रेषु समेष्यामः परस्परम्।\nएकीभावं गभिष्यन्ति पुराण्येतानि चानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2060950, "chapter_id": 2303, "verse_number": "८-२४-१७", "content_sanskrit": "समागतानि चैतानि यो हन्याद्भगवांस्तदा।\nएकेषुणा देववरः स नो मृत्युर्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2060951, "chapter_id": 2303, "verse_number": "८-२४-१८x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2060952, "chapter_id": 2303, "verse_number": "८-२४-१८", "content_sanskrit": "तेषां तद्वचनं श्रुत्वा दानवानां पितामहः।\nएवमस्त्विति तान्देवः प्रत्युक्त्वा प्राविशद्दिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2060953, "chapter_id": 2303, "verse_number": "८-२४-१९", "content_sanskrit": "ते तु लब्धवराः प्रीताः सम्प्रधार्य परस्परम्।\nपुरत्रयविसृष्ट्यर्थं मयं वव्रुर्महारथाः।\nविश्वकार्माणमजरं दैत्यदानवपूजितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2060954, "chapter_id": 2303, "verse_number": "८-२४-२०", "content_sanskrit": "ततो मयः स्वतपसा चक्रे धीमान्पुराणि च।\nत्रीणि काञ्चनमेकं वै रौप्यं कार्ष्णायसं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2060955, "chapter_id": 2303, "verse_number": "८-२४-२१", "content_sanskrit": "काञ्चनं दिवि तत्रासीदन्तरिक्षे च राजतम्।\nआयसं चाभवद्भौमं तदा तेषां परन्तप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2060956, "chapter_id": 2303, "verse_number": "८-२४-२२", "content_sanskrit": "एकैकं योजनशतं विस्तृतं तावदायतम्।\nदृढं चाट्टालकयुतं बृहत्प्राकारतोरणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2060957, "chapter_id": 2303, "verse_number": "८-२४-२३", "content_sanskrit": "गृहप्रवरसम्बाधमसम्बाधमहापथम्।\nप्रासादैर्विविधैश्चापि द्वारैश्चैवोपशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2060958, "chapter_id": 2303, "verse_number": "८-२४-२४", "content_sanskrit": "त्रिपुरं तेषु चाप्यासन्राजानो वै पृथक्पृथक्।\nदिव्यमाल्याम्बरधरा दैतेया राजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2060959, "chapter_id": 2303, "verse_number": "८-२४-२५", "content_sanskrit": "काञ्चनं तारकाक्षस्य दिव्यमासीन्महात्मनः।\nराजतं कमलाक्षस्य विद्युन्मालिन आयसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2060960, "chapter_id": 2303, "verse_number": "८-२४-२६", "content_sanskrit": "त्रयस्ते दैत्यराजानस्त्रीँल्लोकानाशु तेजसा।\nआक्रम्य तस्थुरूचुश्च कश्च नाम प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2060961, "chapter_id": 2303, "verse_number": "८-२४-२७", "content_sanskrit": "तेषां दानवमुख्यानां प्रयुतान्यर्बुदानि च।\nकोट्याश्चाप्रतिवीराणां समाजग्मुस्ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2060962, "chapter_id": 2303, "verse_number": "८-२४-२८", "content_sanskrit": "मांसाशिनः सुदृप्ताश्च सुरैर्विनिकृताः पुरा।\nमहदैश्वर्यमिच्छन्तस्त्रिपुरं दुर्गमाश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2060963, "chapter_id": 2303, "verse_number": "८-२४-२९", "content_sanskrit": "सर्वेषां च पुनश्चैषां सर्वयोगवहो मयः।\nतमाश्रित्य हि ते सर्वेऽवर्तयन्नकुतोभयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2060964, "chapter_id": 2303, "verse_number": "८-२४-३०", "content_sanskrit": "यो हि यं मनसा कामं दध्यौ त्रिपुरसंश्रयः।\nतस्मै तस्मै मयस्तं तं विदधे मायया तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2060965, "chapter_id": 2303, "verse_number": "८-२४-३१", "content_sanskrit": "तारकाक्षसुतश्चासीद्वरिर्नाम महाबलः।\nतपस्तेपे परमकं येनातुष्यत्पितामहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2060966, "chapter_id": 2303, "verse_number": "८-२४-३२", "content_sanskrit": "सन्तुष्टमवृणोद्देवं वापी भवतुः नः पुरे।\nशस्त्रैर्विनिहता यत्र क्षिप्ताः स्युर्बलवत्तराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2060967, "chapter_id": 2303, "verse_number": "८-२४-३३", "content_sanskrit": "स तु लब्ध्वा वरं वीरस्तारकाक्षसुतो हरिः।\nससृजे तत्र वापीं तां मृतसञ्जीविनीं प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2060968, "chapter_id": 2303, "verse_number": "८-२४-३४", "content_sanskrit": "येन रूपेण यो दैत्यो येन वेषेण चाप्यथ।\nक्षिप्यते निहतो वाप्यां तादृशेनैव जायते।\nसम्पूर्णबलवीर्यस्तु राजञ्छौर्यसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2060969, "chapter_id": 2303, "verse_number": "८-२४-३५", "content_sanskrit": "एवं वीर्येण संयुक्तां कृतां तेन महात्मना।\nतां प्राप्य त्रैपुरा वापीं लोकान्सर्वान्बबाधिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2060970, "chapter_id": 2303, "verse_number": "८-२४-३६", "content_sanskrit": "महता तपसा सिद्धाः सुराणां भयवर्धनाः।\nएकस्मिन्निहते दैत्ये सृजन्ति स्म दशासुरान्।\nन तेषां विद्यते युद्वे क्षयो राजन्कथञ्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2060971, "chapter_id": 2303, "verse_number": "८-२४-३७", "content_sanskrit": "ततस्ते लोभमोहाभ्यामभिभूता विचेतसः।\nनिर्भीकाः सहिताः सर्वे स्थापिताः समलोलुपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2060972, "chapter_id": 2303, "verse_number": "८-२४-३८", "content_sanskrit": "विद्राव्य सगणान्देवांस्तत्रतत्र तदातदा।\nविचेरुः स्वेन कामेन वरदानेन दर्पिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2060973, "chapter_id": 2303, "verse_number": "८-२४-३९", "content_sanskrit": "देवोद्यानानि सर्वाणि स्थानानि च दिवौकसाम्।\nऋषीणामाश्रमान्पुण्यान्रम्याञ्चनपदांस्तथा।\nउत्सादयन्त मर्यादां दानवा दुष्टचारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2060974, "chapter_id": 2303, "verse_number": "८-२४-४०", "content_sanskrit": "निःस्थानाश्च कृता देवा ऋषयः पितृभिः सह।\nदैत्यैस्त्रिभिस्त्रयो लोका ह्याक्रान्तास्तैः सुरेतरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2060975, "chapter_id": 2303, "verse_number": "८-२४-४१", "content_sanskrit": "पीड्यमानेषु लोकेषु ततः शक्रो मरुद्वृतः।\nपुराण्यायोधयाञ्चक्रे वज्रहस्तः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2060976, "chapter_id": 2303, "verse_number": "८-२४-४२", "content_sanskrit": "नाशकत्तान्यभेद्यानि यदा भेत्तुं पुरन्दरः।\nपुराणि वरदत्तानि धात्रा तेन नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2060977, "chapter_id": 2303, "verse_number": "८-२४-४३", "content_sanskrit": "तदा भीतः सुरपतिर्मुक्त्वा तानि पुराण्यथ।\nतैरेव विबुधैः सार्धं पितामहमरिन्दम।\nजगामाथ तदाख्यातुं विप्रकारं सुरेतरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2060978, "chapter_id": 2303, "verse_number": "८-२४-४४", "content_sanskrit": "ते तत्त्वं सर्वमाख्याय शिरोभिः सम्प्रणम्य च।\nतद्वधोपायमाचक्ष्व भगवन्निति चाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2060979, "chapter_id": 2303, "verse_number": "८-२४-४५", "content_sanskrit": "श्रुत्वा तद्भगवान्देवो देवानिदमुवाच ह।\nश्रूयतां त्रिदशाः सर्वे यथेदं वाक्यगौरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2060980, "chapter_id": 2303, "verse_number": "८-२४-४६", "content_sanskrit": "दुरात्मानोऽसुरा नित्यं ते चापि विबुधा मम।\nन शक्नुवन्ति ते (ये) सर्वे युष्मान्वै पीडयन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2060981, "chapter_id": 2303, "verse_number": "८-२४-४७", "content_sanskrit": "अहं समस्तु सर्वेषां भूतानां नात्र संशयः।\nअविनीता निहन्तव्या इत्येवं प्रब्रवीमि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2060982, "chapter_id": 2303, "verse_number": "८-२४-४८", "content_sanskrit": "एकेषुणा (हि) विभेद्यानि तानि दुर्गाणि नान्यथा।\nशक्तस्तु तानि बाणेन भेत्तुं कामं त्रिलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2060983, "chapter_id": 2303, "verse_number": "८-२४-४९", "content_sanskrit": "ते यूयं स्थाणुमीशानं जिष्मुमक्लिष्टकारिणम्।\nयोद्वारं वृणुत क्षिप्रं स तान्हन्ता सुरेतरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2060984, "chapter_id": 2303, "verse_number": "८-२४-५०", "content_sanskrit": "ते देवास्तेन वाक्येन चोदिताः प्रणताः स्थिताः।\nदिव्यं वर्षसहस्रं वै तपस्तप्त्वा सुरर्षभाः।\nशुभात्मानो महात्मानो जग्मुर्वै वृषभध्वजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2060985, "chapter_id": 2303, "verse_number": "८-२४-५१", "content_sanskrit": "ब्रह्माणमग्रतः कृत्वा शरण्यं शरणागताः।\nतपः परममाजग्मुर्गृणन्तो ब्रह्म शाश्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2060986, "chapter_id": 2303, "verse_number": "८-२४-५२", "content_sanskrit": "अनङ्गमथनं सर्वे भवं सर्वात्मना गताः।\nदेवदेवं परं स्थाणुं वरदं त्र्यम्बकं शिवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2060987, "chapter_id": 2303, "verse_number": "८-२४-५३", "content_sanskrit": "शर्वमीड्यमजं रुद्रं शशाङ्काङ्कितमूर्धजम्।\nतुष्टुवुर्वाग्भिरुग्राभिर्भयेष्वभयमच्युतम्।\nसर्वात्मानं महात्मानं येनाप्तं विश्वमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2060988, "chapter_id": 2303, "verse_number": "८-२४-५४", "content_sanskrit": "तपोविशेषैर्विविधैर्योगं यो वेद चात्मनः।\nयः साङ्ख्यमात्मना वेत्ति यस्य चात्मा वेशे सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2060989, "chapter_id": 2303, "verse_number": "८-२४-५५", "content_sanskrit": "तं ते ददृशुरीशानं तेजोराशिमुमापतिम्।\n`परेण यत्नेन भवं त्रिदशाः शर्वमीश्वरम्।\nअनन्यसदृशं लोके प्रतपन्तमकल्मषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2060990, "chapter_id": 2303, "verse_number": "८-२४-५६", "content_sanskrit": "एकश्च भगवांस्तत्र नानारूपमकल्पयत्।\nआत्मनः प्रतिरूपाणि रूपाण्यथ महात्मनि।\nपरस्परस्य चापश्यन्सर्वे परमविस्मिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2060991, "chapter_id": 2303, "verse_number": "८-२४-५७", "content_sanskrit": "सर्वभूतमयं दृष्ट्वा तमजं जगतः परिम्।\nदेवा ब्रह्मर्षयश्चैव शिरोभिर्धरणीं गताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2060992, "chapter_id": 2303, "verse_number": "८-२४-५८", "content_sanskrit": "तान्स्वस्तिवाच्य चाभ्यर्च्य समुत्थाप्य च शङ्करः।\nब्रूतब्रूतेति भगवान्स्मयमानोऽभ्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2060993, "chapter_id": 2303, "verse_number": "८-२४-५९", "content_sanskrit": "त्र्यम्बकेणाभ्यनुज्ञातास्ततस्ते स्वस्थचेतसः।\nनमो नमो नमस्तेऽस्तु प्रभो इत्यब्रुवन्भवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2060994, "chapter_id": 2303, "verse_number": "८-२४-६०", "content_sanskrit": "नमो देवाधिदेवाय प्रियाधाघ्नेऽतिमन्यवे।\nप्रजापतिमखघ्नाय प्रजापतिभिरीड्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2060995, "chapter_id": 2303, "verse_number": "८-२४-६१", "content_sanskrit": "नमः स्तुताय स्तुत्याय स्तूयमानाय शम्भवे।\nविलोहिताय रुद्राय नीलग्रीवाय शूलिने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2060996, "chapter_id": 2303, "verse_number": "८-२४-६२", "content_sanskrit": "अमोघाय मृगाक्षाय प्रवरायुधयोधिने।\nअर्हाय चैव शुद्वाय क्षयाय क्रथनाय च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2060997, "chapter_id": 2303, "verse_number": "८-२४-६३", "content_sanskrit": "दुर्वारणाय शुक्राय ब्रह्मणे ब्रह्मचारिणे।\nईशानायाप्रमेयाय निहन्त्रे चर्मवाससे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2060998, "chapter_id": 2303, "verse_number": "८-२४-६४", "content_sanskrit": "तपोरताय पिङ्गाय व्रतिने कृत्तिवाससे।\nकुमारपित्रे त्र्यक्षाय प्रवरायुधधारिणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2060999, "chapter_id": 2303, "verse_number": "८-२४-६५", "content_sanskrit": "प्रपन्नार्तिविनाशाय ब्रह्मद्विट्सङ्घघातिने।\nवनस्पतीनां पतये वनानां पतये नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2061000, "chapter_id": 2303, "verse_number": "८-२४-६६", "content_sanskrit": "गवां च पतये नित्यं यज्ञानां पतये नमः।\nनमोस्तु ते ससैन्याय त्र्यम्बकायामितौजसे।\nमनोवाक्कर्मभिर्देव त्वां प्रपन्नान्भजस्व नः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2061001, "chapter_id": 2303, "verse_number": "८-२४-६७", "content_sanskrit": "ततः प्रसन्नो भगवान्स्वागतेनाभिनन्द्य च।\nप्रोवाच व्येतु वस्त्रासो ब्रूत किं करवाणि वः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2061002, "chapter_id": 2303, "verse_number": "८-२४-६८", "content_sanskrit": "`देवाः शर्वस्य वचनं श्रुत्वा हर्षमुपागताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2061003, "chapter_id": 2303, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि चतुर्विंशोऽध्यायः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]