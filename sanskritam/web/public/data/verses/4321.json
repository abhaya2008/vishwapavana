[{"id": 2153069, "chapter_id": 4321, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2153070, "chapter_id": 4321, "verse_number": "१", "content_sanskrit": "ततो व्यूढेष्वनीकेषु तावकेष्वितरेषु च ।\nधनञ्जयो रथानीकमवधीत् तव भारत ।\nशरैरतिरथो युद्धे पातयन् रथयूथपान् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2153071, "chapter_id": 4321, "verse_number": "२", "content_sanskrit": "ते वध्यमानाः पार्थेन कालेनेव युगक्षये ।\nधार्तराष्ट्रा रणे यत्ताः पाण्डवान् प्रत्ययोधयन् ।\nप्रार्थयाना यशो दीप्तं मृत्युं कृत्वाऽनिवर्तनम् \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2153072, "chapter_id": 4321, "verse_number": "३", "content_sanskrit": "एकाग्रमनसो भूत्वा पाण्डवानां वरूथिनीम् ।\nबभञ्जुर्बहुशो राजंस्ते चाभज्यन्त संयुगे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2153073, "chapter_id": 4321, "verse_number": "४", "content_sanskrit": "द्रवद्भिरथ भग्नैश्च परिवर्तद्भिरेव च ।\nपाण्डवैः कौरवैश्चैव न प्राज्ञायत किञ्चन\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2153074, "chapter_id": 4321, "verse_number": "५", "content_sanskrit": "उदतिष्ठद् रजो भौमं छादयानं दिवाकरम् ।\nदिशः प्रतिदिशो वापि तन्न जज्ञुः कथञ्चन\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2153075, "chapter_id": 4321, "verse_number": "६", "content_sanskrit": "अनुमानेन सञ्ज्ञाभिर्नामगोत्रैश्च संयुगे ।\nवर्तते स्म तदा युद्धं तत्रतत्र विशाम्पते\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2153076, "chapter_id": 4321, "verse_number": "७", "content_sanskrit": "न व्यूहो भिद्यते तत्र कौरवाणां कथञ्चन ।\nरक्षितः सत्यसन्धेन भारद्वाजेन धीमता\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2153077, "chapter_id": 4321, "verse_number": "८", "content_sanskrit": "तथैव पाण्डवेयानां रक्षितः सव्यसाचिना ।\nनाभिध्यत महाव्यूहो भीमेन च सुरक्षितः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2153078, "chapter_id": 4321, "verse_number": "९", "content_sanskrit": "सेनाग्रादभिनिष्पत्य प्रायुध्यंस्तत्र मानवाः ।\nउभयोः सेनयो राजन् व्यतिषक्तरथद्विपाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2153079, "chapter_id": 4321, "verse_number": "१०", "content_sanskrit": "हयारोहैर्हयारोहाः पात्यन्ते स्म महाहवे ।\nऋष्टिभिर्विमलाग्राभिः प्रासैरपि च संयुगे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2153080, "chapter_id": 4321, "verse_number": "११", "content_sanskrit": "रथी रथिनमासाद्य शरैः कनकभूषणैः ।\nपातयामास समरे तस्मिन्नतिभयङ्करे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2153081, "chapter_id": 4321, "verse_number": "१२", "content_sanskrit": "गजारोहा गजारोहान् नाराचशरतोमरैः ।\nसंसक्ताः पातयामासुस्तव तेषां च सङ्घशः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2153082, "chapter_id": 4321, "verse_number": "१३", "content_sanskrit": "कश्चिदुत्पत्य समरे वरवारणमास्थितः ।\nकेशपक्षे परामृश्य जहार समरे शिरः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2153083, "chapter_id": 4321, "verse_number": "१४", "content_sanskrit": "अन्ये द्विरददन्ताग्रनिर्भिन्नहृदया रणे ।\nवेमुश्च रुधिरं वीरा निःश्वसन्तः समन्ततः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2153084, "chapter_id": 4321, "verse_number": "१५", "content_sanskrit": "कश्चित् करिविषाणस्थो वीरो रणविशारदः ।\nप्रावेपच्छक्तिनिर्भिन्नो गजशिक्षास्त्रवेदिना \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2153085, "chapter_id": 4321, "verse_number": "१६", "content_sanskrit": "पत्तिसङ्घा रणे पत्तीन् भिण्डिपालपरश्वधैः ।\nन्यपातयन्त संहृष्टाः परस्परकृतायसः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2153086, "chapter_id": 4321, "verse_number": "१७", "content_sanskrit": "रथी च समरे राजन्नासाद्य गजयोधिनम् ।\nसगजं पातयामास गजी च रथिनं रथात् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2153087, "chapter_id": 4321, "verse_number": "१८", "content_sanskrit": "रथिनं च हयारोहः प्रासेन भरतर्षभ ।\nपातयामास समरे रथी च हयसादिनम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2153088, "chapter_id": 4321, "verse_number": "१९", "content_sanskrit": "पदाती रथिनं सङ्खे रथी चापि पदातिनम् ।\nन्यपातयच्छितैः शस्त्रैः सेनयोरुभयोरपि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2153089, "chapter_id": 4321, "verse_number": "२०", "content_sanskrit": "गजारोहा हयारोहान् पातयाञ्चक्रिरे तदा ।\nहयारोहा गजस्थांश्च तदद्भुतमिवाभवत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2153090, "chapter_id": 4321, "verse_number": "२१", "content_sanskrit": "गजारोहवरैश्चापि तत्रतत्र पदातयः ।\nपातिताः समदृश्यन्त तैश्चापि गजयोधिनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2153091, "chapter_id": 4321, "verse_number": "२२", "content_sanskrit": "पत्तिसङ्घा हयारोहैः सादिसङ्घाश्च पत्तिभिः ।\nपात्यमाना व्यदृश्यन्त शतशोऽथ सहस्रशः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2153092, "chapter_id": 4321, "verse_number": "२३", "content_sanskrit": "ध्वजैस्तत्रापविद्धैश्च कार्मुकैस्तोमरैस्तथा ।\nप्रासैस्तथा गदाभिश्च परिघैः कम्पनैस्तथा\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2153093, "chapter_id": 4321, "verse_number": "२४", "content_sanskrit": "शक्तिभिः कवचैश्चित्रैः कणपैरङ्कुशैरपि ।\nनिस्त्रिंशैर्विमलैश्चापि स्वर्णपुङ्खैः शरैस्तथा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2153094, "chapter_id": 4321, "verse_number": "२५", "content_sanskrit": "परिस्तोमैः कुथाभिश्च कम्बलैश्च महाधनैः ।\nभूर्भाति भरतश्रेष्ठ स्रग्दामैरिव चित्रिता\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2153095, "chapter_id": 4321, "verse_number": "२६", "content_sanskrit": "नराश्वकायैः पतितैर्दन्तिभिश्च महाहवे ।\nअगम्यरूपा पृथिवी मांसशोणितकर्दमा\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2153096, "chapter_id": 4321, "verse_number": "२७", "content_sanskrit": "प्रशशाम रजो भौमं व्युक्षितं रणशोणितैः ।\nदिशश्च विमलाः सर्वाः सम्बभूवुर्जनेश्वर\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2153097, "chapter_id": 4321, "verse_number": "२८", "content_sanskrit": "उत्थितान्यगणेयानि कबन्धानि समन्ततः ।\nचिह्नभूतानि जगतो विनाशार्थाय भारत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2153098, "chapter_id": 4321, "verse_number": "२९", "content_sanskrit": "तस्मिन् युद्धे महारौद्रे वर्तमाने सुदारुणे ।\nप्रत्यदृश्यन्त रथिनो धावमानाः समन्ततः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2153099, "chapter_id": 4321, "verse_number": "३०", "content_sanskrit": "ततो द्रोणश्च भीष्मश्च सैन्धवश्च जयद्रथः ।\nपुरुमित्रो विकर्णश्च शकुनिश्चापि सौबलः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2153100, "chapter_id": 4321, "verse_number": "३१", "content_sanskrit": "एते समरदुर्धर्षाः सिंहतुल्यपराक्रमाः ।\nपाण्डवानामनीकानि बभञ्जुः स्म पुनःपुनः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2153101, "chapter_id": 4321, "verse_number": "३२", "content_sanskrit": "तथैव भीमसेनोऽपि राक्षसश्च घटोत्कचः ।\nसात्यकिश्चेकितानश्च द्रौपदेयाश्च भारत\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2153102, "chapter_id": 4321, "verse_number": "३३", "content_sanskrit": "तावकांस्तव पुत्रांश्च सहितान् सर्वराजभिः ।\nद्रावयामासुराजौ ते त्रिदशा दानवानिव\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2153103, "chapter_id": 4321, "verse_number": "३४", "content_sanskrit": "तथा ते समरेऽन्योन्यं निघ्नन्तः क्षत्रियर्षभाः ।\nरक्तोक्षिता घोररूपा विरेजुर्दानवा इव\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2153104, "chapter_id": 4321, "verse_number": "३५", "content_sanskrit": "विनिर्जित्य रिपून् वीराः सेनयोरुभयोरपि ।\nव्यदृश्यन्त महामात्रा ग्रहा इव नभस्तळे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2153105, "chapter_id": 4321, "verse_number": "३६", "content_sanskrit": "ततो रथसहस्रेण पुत्रो दुर्योधनस्तव ।\nअभ्ययात् पाण्डवान् युद्धे राक्षसं च घटोत्कचम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2153106, "chapter_id": 4321, "verse_number": "३७", "content_sanskrit": "तथैव पाण्डवाः सर्वे महत्या सेनया सह ।\nद्रोणभीष्मौ रणे शूरौ प्रत्युद्ययुररिन्दमौ\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2153107, "chapter_id": 4321, "verse_number": "३८", "content_sanskrit": "किरीटी तु ययौ क्रुद्धः समर्थान् पार्थिवोत्तमान् ।\nआर्जुनिः सात्यकिश्चैव ययतुः सौबलं बलम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2153108, "chapter_id": 4321, "verse_number": "३९", "content_sanskrit": "ततः प्रववृते भूयः सङ्ग्रामो लोमहर्षणः ।\nतावकानां परेषां च समरे विजिगीषताम् \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2153109, "chapter_id": 4321, "verse_number": "१३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां भीष्मपर्वणि त्रिपञ्चाशोऽध्यायः ॥५३॥\n॥ इति भीष्मवधपर्वणि त्रयोदशोऽध्यायः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]