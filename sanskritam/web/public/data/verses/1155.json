[{"id": 2008064, "chapter_id": 1155, "verse_number": "१-१५६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2008065, "chapter_id": 1155, "verse_number": "१-१५६-१", "content_sanskrit": "धृतराष्ट्रप्रयुक्तेषु पाण्डुपुत्रेषु भारत।\nदुर्योधनः परं हर्षमगच्छत्स दुरात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2008066, "chapter_id": 1155, "verse_number": "१-१५६-२", "content_sanskrit": "ततः सुबलपुत्रश्च कर्णदुर्योधनावपि।\nदहने सह पुत्रायाः कुन्त्या मतिमकुर्वत।\nमन्त्रयित्वा स तैः सार्धं दुरात्मा धृतराष्ट्रजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2008067, "chapter_id": 1155, "verse_number": "१-१५६-३", "content_sanskrit": "स पुरोचनमेकान्तमानीय भरतर्षभ।\nगृहीत्वा दक्षिणे पाणौ सचिवं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2008068, "chapter_id": 1155, "verse_number": "१-१५६-४", "content_sanskrit": "ममेयं वसुसंपूर्णा पुरोचन वसुन्धरा।\nयथैव भविता तात तथा त्वं द्रष्टुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2008069, "chapter_id": 1155, "verse_number": "१-१५६-५", "content_sanskrit": "न हि मे कश्चिदन्योऽस्ति विश्वासिकतरस्त्वया।\nसहायो येन सन्धाय मन्त्रयेयं यथा त्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2008070, "chapter_id": 1155, "verse_number": "१-१५६-६", "content_sanskrit": "संरक्ष तात मन्त्रं च सपत्नांश्च ममोद्धर।\nनिपुणेनाभ्युपायेन यद्ब्रवीमि तथा कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2008071, "chapter_id": 1155, "verse_number": "१-१५६-७", "content_sanskrit": "पाण्डवा धृतराष्ट्रेण प्रेषिता वारणावतम्।\nउत्सवे विहरिष्यन्ति धृतराष्ट्रस्य शासनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2008072, "chapter_id": 1155, "verse_number": "१-१५६-८", "content_sanskrit": "स त्वं रासभयुक्तेन स्यन्दनेनाशुगामिना।\nवारणावतमद्यैव यथा यासि तया कुरु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2008073, "chapter_id": 1155, "verse_number": "१-१५६-९", "content_sanskrit": "तत्र गत्वा चतुःशालं गृहं परमसंवृतम्।\nनगरोपान्तमाश्रित्य कारयेथा महाधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2008074, "chapter_id": 1155, "verse_number": "१-१५६-१०", "content_sanskrit": "शणसर्जरसादीनि यानि द्रव्याणि कानिचित्।\nआग्नेयान्युत सन्तीह तानि तत्र प्रदापय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2008075, "chapter_id": 1155, "verse_number": "१-१५६-११", "content_sanskrit": "बल्वजेन च संमिश्रं मधूच्छिष्टेन चैव हि।\nसर्पिस्तैलवसाभिश्च लाक्षया चाप्यनल्पया।\nमृत्तिकां मिश्रयित्वा त्वं लेपं कुड्येषु दापय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2008076, "chapter_id": 1155, "verse_number": "१-१५६-१२", "content_sanskrit": "शणं तैलं घृतं चैव जतु दारूणि चैव हि।\nतस्मिन्वेश्मनि सर्वाणि निक्षिपेथाः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2008077, "chapter_id": 1155, "verse_number": "१-१५६-१३", "content_sanskrit": "लाक्षाशममधूच्छिष्टवेष्टितानि मृदापि च।\nलेपयित्वा गुरूण्याशु दारुयन्त्राणि दापय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2008078, "chapter_id": 1155, "verse_number": "१-१५६-१४", "content_sanskrit": "यथा च तन्न पश्येरन्परीक्षन्तोऽपि पाण्डवाः।\nआग्नेयमिति तत्कार्यमपि चान्येऽपि मानवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2008079, "chapter_id": 1155, "verse_number": "१-१५६-१५", "content_sanskrit": "वेश्मन्येवं कृते तत्र कृत्वा तान्परमार्चितान्।\nवासयेथाः पाण्डवेयान्कुन्तीं च ससुहृज्जनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2008080, "chapter_id": 1155, "verse_number": "१-१५६-१६", "content_sanskrit": "आसनानि च दिव्यानि यानानि शयनानि न।\nनिघातव्यानि पाण्डूनां यथा तुष्येच्च मे पिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2008081, "chapter_id": 1155, "verse_number": "१-१५६-१७", "content_sanskrit": "यथा च तन्न जानन्ति नगरे वारणावते।\nयथा रमेरन्विस्रब्धा नगरे वारणावते।\nतथा सर्वं विधातव्यं यावत्कालस्य पर्ययः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2008082, "chapter_id": 1155, "verse_number": "१-१५६-१८", "content_sanskrit": "ज्ञात्वा च तान्सुविश्वस्ताञ्शयानानकुतोभयान्।\nअग्निस्त्वया ततो देयो द्वारतस्तस्य वेश्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2008083, "chapter_id": 1155, "verse_number": "१-१५६-१९", "content_sanskrit": "दग्धानेवं स्वके गेहे दाहिताः पाण्डवा इति।\nन गर्हयेयुरस्मान्वै पाण्डवार्थाय कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2008084, "chapter_id": 1155, "verse_number": "१-१५६-२०", "content_sanskrit": "स तथेति प्रतिज्ञाय कौरवाय पुरोचनः।\nप्रायाद्रासभयुक्तेन स्यन्दनेनाशुगामिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2008085, "chapter_id": 1155, "verse_number": "१-१५६-२१", "content_sanskrit": "स गत्वा त्वरितं राजन्दुर्योधनमते स्थितः।\nयथोक्तं राजपुत्रेण सर्वं चक्रे पुरोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2008086, "chapter_id": 1155, "verse_number": "१-१५६-२२", "content_sanskrit": "तेषां तु पाण्डवेयानां गृहं रौद्रमकल्पयत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2008087, "chapter_id": 1155, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि जतुगृहपर्वणि षट्पञ्चाशदधिकशततमोऽध्यायः॥ १५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]