[{"id": 40014075, "chapter_id": 9186, "verse_number": "1", "content_sanskrit": "एवमुक्तो हनुमता रामो दशरथात्मज:। तं मणिं हृदये कृत्वा प्ररुरोद सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014076, "chapter_id": 9186, "verse_number": "2", "content_sanskrit": "तं तु दृष्ट्वा मणिश्रेष्ठं राघव श्शोककर्शितः। नेत्राभ्यामश्रुपूर्णाभ्यां सुग्रीवमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014077, "chapter_id": 9186, "verse_number": "3", "content_sanskrit": "यथैव धेनु स्स्रवति स्नेहाद्वत्सस्य वत्सला। तथा ममापि हृदयं मणिरत्नस्य दर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014078, "chapter_id": 9186, "verse_number": "4", "content_sanskrit": "मणिरत्नमिदं दत्तं वैदेह्याश्श्वशुरेण मे। वधूकाले यथाबद्धमधिकं मूर्ध्नि शोभते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014079, "chapter_id": 9186, "verse_number": "5", "content_sanskrit": "अयं हि जलसम्भूतो मणिस्सज्जनपूजितः। यज्ञे परमतुष्टेन दत्तश्शक्रेण धीमता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014080, "chapter_id": 9186, "verse_number": "6", "content_sanskrit": "इमं दृष्ट्वा मणिश्रेष्ठं यथा तातस्य दर्शनम्। अद्यास्म्यवगतस्सौम्य वैदेहस्य तथा विभोः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014081, "chapter_id": 9186, "verse_number": "7", "content_sanskrit": "अयं हि शोभते तस्याः प्रियाया मूर्ध्नि मे मणिः। अस्याद्य दर्शने नाहं प्राप्तां तामिव चिन्तये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014082, "chapter_id": 9186, "verse_number": "8", "content_sanskrit": "किमाह सीता वैदेही ब्रूहि सौम्य पुनः पुनः। पिपासुमिव तोयेन सिञ्चन्ती वाक्यवारिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014083, "chapter_id": 9186, "verse_number": "9", "content_sanskrit": "इतस्तु किं दुःखतरं यदिमं वारिसम्भवम्। मणिं पश्यामि सौमित्रे वैदेहीमागतां विना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014084, "chapter_id": 9186, "verse_number": "10", "content_sanskrit": "चिरं जीवति वैदेही यदि मासं धरिष्यति। क्षणं सौम्य न जीवेयं विना तामसितेक्षणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014085, "chapter_id": 9186, "verse_number": "11", "content_sanskrit": "नय मामपि तं देशं यत्र दृष्टा मम प्रिया। न तिष्ठेयं क्षणमपि प्रवृत्तिमुपलभ्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014086, "chapter_id": 9186, "verse_number": "12", "content_sanskrit": "कथं सा मम सुश्रोणी भीरुभीरु स्सती सदा। भयावहानां घोराणां मध्ये तिष्ठति रक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014087, "chapter_id": 9186, "verse_number": "13", "content_sanskrit": "शारद स्तिमिरोन्मुक्तो नूनं चन्द्रं इवांबुधैः। आवृतं वदनं तस्या न विराजति राक्षसैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014088, "chapter_id": 9186, "verse_number": "14", "content_sanskrit": "किमाह सीता हनुमंस्तत्त्वतः कथयाद्य मे। एतेन खलु जीविष्ये भेषजेनातुरो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014089, "chapter_id": 9186, "verse_number": "15", "content_sanskrit": "मधुरा मधुरालापा किमाह मम भामिनी। मद्विहीना वरारोहा हनुमन् कथयस्व मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]