[{"id": 50024141, "chapter_id": 11833, "verse_number": "1", "content_sanskrit": "॥ मधुच्छन्दा वैश्वामित्रः। १-३ वायुः, ४-६ इन्द्रवायू, ७-९ मित्रावरुणौ। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024142, "chapter_id": 11833, "verse_number": "2", "content_sanskrit": "वाय॒वा या॑हि दर्शते॒मे सोमा॒ अरं॑कृताः। तेषां॑ पाहि श्रु॒धी हव॑म्॥ २/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024143, "chapter_id": 11833, "verse_number": "3", "content_sanskrit": "वाय॑ उ॒क्थेभि॑र्जरन्ते॒ त्वामच्छा॑ जरि॒तार॑ः। सु॒तसो॑मा अह॒र्विद॑ः॥ २/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024144, "chapter_id": 11833, "verse_number": "4", "content_sanskrit": "वायो॒ तव॑ प्रपृञ्च॒ती धेना॑ जिगाति दा॒शुषे॑। उ॒रू॒ची सोम॑पीतये॥ २/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024145, "chapter_id": 11833, "verse_number": "5", "content_sanskrit": "इन्द्र॑वायू इ॒मे सु॒ता उप॒ प्रयो॑भि॒रा ग॑तम्। इन्द॑वो वामु॒शन्ति॒ हि॥ २/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024146, "chapter_id": 11833, "verse_number": "6", "content_sanskrit": "वाय॒विन्द्र॑श्च चेतथः सु॒तानां॑ वाजिनीवसू। तावा या॑त॒मुप॑ द्र॒वत्॥ २/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024147, "chapter_id": 11833, "verse_number": "7", "content_sanskrit": "ऋ॒तेन॑ मित्रावरुणावृतावृधावृतस्पृशा। क्रतुं॑ बृ॒हन्त॑माशाथे॥ २/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024148, "chapter_id": 11833, "verse_number": "8", "content_sanskrit": "क॒वी नो॑ मि॒त्रावरु॑णा तुविजा॒ता उ॑रु॒क्षया॑। दक्षं॑ दधाते अ॒पस॑म्॥ २/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]