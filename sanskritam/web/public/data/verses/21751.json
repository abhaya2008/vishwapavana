[{"id": 7001751000, "chapter_id": 21751, "verse_number": "२-१२-१", "content_sanskrit": "वसिष्ट उवाच ।\nव्याहृते शोभने वाक्ये मोहिन्या नृपतिस्तदा ।\nउन्मील्य नेत्रे राजेंद्र शतपत्रनिभे तथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001751001, "chapter_id": 21751, "verse_number": "२-१२-२", "content_sanskrit": "सगद्गदमुवाचेदं मुग्धो मोहिनिदर्शनात्  ।\nमया बाले सुबहुशः पूर्णचंद्रनिभाननाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001751002, "chapter_id": 21751, "verse_number": "२-१२-३", "content_sanskrit": "दृष्टास्तथानुभूताश्च नेदृग्दृष्टं वपुः क्वचित् ।\nयादृशं त्वं धारयसे रूपं लोकविमोहनम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001751003, "chapter_id": 21751, "verse_number": "२-१२-४", "content_sanskrit": "सोऽहं दर्शनमात्रेण त्वदीयेन वरानने ।\nमनोभवशरैर्विद्धः पतितः सहसा क्षितौ ।\nअजल्पितवचो देवि मोहितस्तव तेजसा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001751004, "chapter_id": 21751, "verse_number": "२-१२-५", "content_sanskrit": "कुरु प्रसादं करभोरु मह्यं दास्यामि सर्वं तव चित्तसंस्थम् ।\nनादेयमस्तीह जगत्त्रयेऽपि तवानुरागेण निबद्धचेतसः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001751005, "chapter_id": 21751, "verse_number": "२-१२-६", "content_sanskrit": "इमां धरां भूधरभूषितांगीं समुद्रवस्त्रां शशिसूर्यनेत्राम् ।\nघनस्तनीं व्योमसुबद्धदेहां निष्काननां सुंदरि वामशीलाम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001751006, "chapter_id": 21751, "verse_number": "२-१२-७", "content_sanskrit": "पातालगुह्यां बहुवृक्षरोम्णीं सप्ताधरां सुभ्रु तवास्मि दाता ।\nसकोशबद्धां गजवाजिपूर्णां समन्त्रिहृद्यां नगरैः समेताम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001751007, "chapter_id": 21751, "verse_number": "२-१२-८", "content_sanskrit": "आत्मानमपि दास्यामि तवा चार्वंगि संगमे ।\nकिं पुनर्द्धनरत्नादि प्रसीद मम मोहिनि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001751008, "chapter_id": 21751, "verse_number": "२-१२-९", "content_sanskrit": "नृपस्य वचनं श्रुत्वा मोहिनी मधुराक्षरम् ।\nसमुवाच स्मितं कृत्वा तमुत्थाप्य नृपं तदा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001751009, "chapter_id": 21751, "verse_number": "२-१२-१०", "content_sanskrit": "न धरां भूधरोपेतां वरये वसुधाधिप ।\nयद्विदिष्याम्यहं काले तत्कार्यमविशंकया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001751010, "chapter_id": 21751, "verse_number": "२-१२-११", "content_sanskrit": "भजिष्यामि न संदेहः कुरुष्व समयं मम ।\nराजोवाच ।\nयेन संतुष्यसे देवि समयं तं करोम्यहम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001751011, "chapter_id": 21751, "verse_number": "२-१२-१२", "content_sanskrit": "दशावस्थां गतो देहो मम त्वत्संगमं विना ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001751012, "chapter_id": 21751, "verse_number": "२-१२-१३", "content_sanskrit": "मोहिन्युवाच ।\nदीयतां दक्षिणो हस्तो बहुधर्मकरस्तव ।\nयेन मे प्रत्ययो राजन् वचने तावके भवेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001751013, "chapter_id": 21751, "verse_number": "२-१२-१४", "content_sanskrit": "राजा त्वं धर्मशीलोऽसि सत्यकीर्तिर्जगत्त्रये ।\nन वक्तास्यनृतं काले मार्गाऽयं लौकिकः कृतः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001751014, "chapter_id": 21751, "verse_number": "२-१२-१५", "content_sanskrit": "एवं ब्रवाणां राजेंद्रो मोहिनीं हृच्छयातुरः ।\nअब्रवीन्नृपतिस्तां तु सुप्रसन्नमना नृप ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001751015, "chapter_id": 21751, "verse_number": "२-१२-१६", "content_sanskrit": "जन्मप्रभृति वामोरु नानृतं भाषितं मया ।\nस्वैरेष्वपि विहारेषु कदापि वरवाणिंनि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001751016, "chapter_id": 21751, "verse_number": "२-१२-१७", "content_sanskrit": "अथवा व्याहृतैर्वाक्यैः किमेभिः प्रत्ययाक्षरैः ।\nदतो ह्येष मया हस्तो दक्षिणः पुण्यलांछनः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001751017, "chapter_id": 21751, "verse_number": "२-१२-१८", "content_sanskrit": "यन्मया सुकृतं किंचित्कृतमाजन्म सुन्दरि ।\nतत्सर्वं तव वामोरु यदि कुर्यान्न ते वचः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001751018, "chapter_id": 21751, "verse_number": "२-१२-१९", "content_sanskrit": "अन्तरे ह्येष दत्तो मे धर्मो भार्या भवांगने ।\nतव रूपेण मे क्षोभः सहसा प्रत्युपस्थितः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001751019, "chapter_id": 21751, "verse_number": "२-१२-२०", "content_sanskrit": "ऋतध्वजसुतश्चाहं नाम्ना रुक्मां गदो नृपः ।\nइक्ष्वाकुवशसंभूतः सुतो धर्मांगदो मम ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001751020, "chapter_id": 21751, "verse_number": "२-१२-२१", "content_sanskrit": "मृगव्याजेन गहनं प्रविष्टश्चारुलोचने ।\nततो दृष्टो वने हृद्यो वामदेवाश्रमो मया ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001751021, "chapter_id": 21751, "verse_number": "२-१२-२२", "content_sanskrit": "मुनिना जल्पितं तत्र किंचित्तेन विसर्जितः ।\nआरुह्य वाहनश्रेष्ठंमन्दरं द्रष्टुमागतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001751022, "chapter_id": 21751, "verse_number": "२-१२-२३", "content_sanskrit": "भ्रममाणो गिरिवरं कुतूहलमनास्तदा ।\nप्राप्तं मच्छ्रवणे गीतं तव वक्त्रविनिर्गतम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001751023, "chapter_id": 21751, "verse_number": "२-१२-२४", "content_sanskrit": "तेन गीतेन चाकृष्टस्त्वत्समीपमुपागतः ।\nदृष्टेः पथमनुप्राप्ता मम त्वं चारुलोचने ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001751024, "chapter_id": 21751, "verse_number": "२-१२-२५", "content_sanskrit": "ततोऽहं मूर्च्छितो देवि विसंज्ञः पतितः क्षितौ ।\nसांप्रतं चेतनायुक्तस्तव वाक्यामृतेन हि ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001751025, "chapter_id": 21751, "verse_number": "२-१२-२६", "content_sanskrit": "पुनर्जातमिवात्मानं मन्येऽहं लोकमोहिनि ।\nप्रत्युत्तरप्रदानेन प्रसादं कर्त्तुमर्हसि ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001751026, "chapter_id": 21751, "verse_number": "२-१२-२७", "content_sanskrit": "नृपेणैव समुद्दिष्टा मोहिन्याहोत्तरं वचः ।\nअहं ब्रह्मभवा राजंस्त्वदर्थं समुपागता ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001751027, "chapter_id": 21751, "verse_number": "२-१२-२८", "content_sanskrit": "श्रुत्वा कीर्ति स्मरोपेता मंदरं कनकाचलम् ।\nपरित्यज्य सुरान्सर्वान्विश्वंभरपुरोगमान् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001751028, "chapter_id": 21751, "verse_number": "२-१२-२९", "content_sanskrit": "समाहितमनास्त्वत्र तपस्यानिरता स्थिता ।\nसंपूजयंती देवेशं गीतदानेन शंकरम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001751029, "chapter_id": 21751, "verse_number": "२-१२-३०", "content_sanskrit": "गीतदानमहं मन्ये सुराणामतिवल्लभम् ।\nसर्वदानाधिकं भूप ह्यनंतगतिदायकम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001751030, "chapter_id": 21751, "verse_number": "२-१२-३१", "content_sanskrit": "येन तुष्टः पशुपतिः सद्यः प्रत्युपकारकः ।\nईप्सितोऽयं मया प्राप्तो भवानवनिपालकः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001751031, "chapter_id": 21751, "verse_number": "२-१२-३२", "content_sanskrit": "अभिप्रीतोऽसि मे राजन्नभिप्रीता ह्यहं तव ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001751032, "chapter_id": 21751, "verse_number": "२-१२-३३", "content_sanskrit": "तमेवं मुक्त्वा द्विजराजवक्त्रा करं गृहीत्वा नृपतेस्तु वेगात् ।\nउत्थापयामास धराशयानमिंद्रस्य यष्टीमिव मोहिनी सा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]