[{"id": 2036855, "chapter_id": 1796, "verse_number": "५-४१-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2036856, "chapter_id": 1796, "verse_number": "५-४१-१", "content_sanskrit": "अनुक्तं यदि ते किञ्चिद्वाचा विदुर विद्यते।\nतन्मे शुश्रूषतो ब्रूहि विचित्राणि हि भाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2036857, "chapter_id": 1796, "verse_number": "५-४१-२x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2036858, "chapter_id": 1796, "verse_number": "५-४१-२", "content_sanskrit": "धृतराष्ट्र कुमारो वै यः पुराणः सनातनः।\nतनत्सुजातः प्रोवाच मृत्युर्नास्तीति भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2036859, "chapter_id": 1796, "verse_number": "५-४१-३", "content_sanskrit": "स ते गुह्यान्प्रकाशांश्च सर्वान्हृदयसंश्रयान्।\nप्रवक्ष्यति महाराज सर्वबुद्धिमतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2036860, "chapter_id": 1796, "verse_number": "५-४१-४x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2036861, "chapter_id": 1796, "verse_number": "५-४१-४", "content_sanskrit": "किं त्वं न वेद तद्भूयो यन्मे ब्रूयात्सनातनः।\nत्वमेव विदुर ब्रूहि प्रज्ञाशेषोऽस्ति चेत्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2036862, "chapter_id": 1796, "verse_number": "५-४१-५x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2036863, "chapter_id": 1796, "verse_number": "५-४१-५", "content_sanskrit": "शूद्रयोनावहं जातो नातोऽन्यद्वक्तुमुत्सहे।\nकुमारस्य तु याबुद्धिर्वेद तां शाश्वतीमहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2036864, "chapter_id": 1796, "verse_number": "५-४१-६", "content_sanskrit": "ब्राह्मीं हि योनिमापन्नः सगुह्यमपि यो वदेत्।\nन तेन गर्ह्यो देवानां तस्मादेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2036865, "chapter_id": 1796, "verse_number": "५-४१-७x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2036866, "chapter_id": 1796, "verse_number": "५-४१-७", "content_sanskrit": "ब्रवीहि विदुर त्वं मे पुराणं तं सनातनम् ।\nकथमेतेन देहेन स्यादिहैव समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2036867, "chapter_id": 1796, "verse_number": "५-४१-८x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2036868, "chapter_id": 1796, "verse_number": "५-४१-८", "content_sanskrit": "चिन्तयामास विदुरस्तभृषिं शंसितव्रतम्।\nस च तच्चिन्तितं ज्ञात्वा दर्शयामास भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2036869, "chapter_id": 1796, "verse_number": "५-४१-९", "content_sanskrit": "स चैनं प्रतिजग्राह विधिदृष्टेन कर्मणा ।\nसुखोपविष्टं विश्रान्तमथैनं विदुरोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2036870, "chapter_id": 1796, "verse_number": "५-४१-१०", "content_sanskrit": "भगवन्संशयः कश्चिद्धृतराष्ट्रस्य मानसः ।\nयो न शक्यो मया वक्तुं त्वमस्मै वक्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2036871, "chapter_id": 1796, "verse_number": "५-४१-११", "content_sanskrit": "यं श्रत्वाऽयं मनुष्येन्द्रः सर्वदुःखातिगो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2036872, "chapter_id": 1796, "verse_number": "५-४१-१२", "content_sanskrit": "लाभालाभौ प्रियद्वेष्यौ यथैनं न जरान्तकौ।\nविषहेरन्भयामर्षौ श्रुत्पिपासे मदोद्भवौ ।\nअरतिश्चैव तन्द्री च कामक्रोधौ क्षयोदयौ ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2036873, "chapter_id": 1796, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सनत्सुजातपर्वणि एकचत्वारिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]