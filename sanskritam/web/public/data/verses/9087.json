[{"id": 5000087000, "chapter_id": 9087, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे दशमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000087001, "chapter_id": 9087, "verse_number": "२-१०-१", "content_sanskrit": "विदर्शिता यदा देवी कुब्जया पापया भृशम्।\nतदा शेते स्म सा भूमौ दिग्धविद्धेव किंनरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000087002, "chapter_id": 9087, "verse_number": "२-१०-२", "content_sanskrit": "(4)\nनिश्चित्य मनसा कृत्यं सा सम्यगिति भामिनी।\nमन्थरायै शनैः सर्वमाचचक्षे विचक्षणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000087003, "chapter_id": 9087, "verse_number": "२-१०-३", "content_sanskrit": "सा दीना निश्चयं कृत्वा मन्थरावाक्यमोहिता।\nनागकन्येव निःश्वस्य दीर्घमुष्णं च भामिनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000087004, "chapter_id": 9087, "verse_number": "२-१०-४", "content_sanskrit": "मुहूर्तं चिन्तयामास मार्गमात्मसुखावहम्।\nसा सुहृच्चार्थकामा च तं निशम्य विनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000087005, "chapter_id": 9087, "verse_number": "२-१०-५", "content_sanskrit": "बभूव परमप्रीता सिद्धिं प्राप्येव मन्थरा।\nअथ सा रुषिता देवी सम्यक् कृत्वा विनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000087006, "chapter_id": 9087, "verse_number": "२-१०-६", "content_sanskrit": "संविवेशाबला भूमौ निवेश्य भ्रुकुटिं मुखे।\nततश्चित्राणि माल्यानि दिव्यान्याभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000087007, "chapter_id": 9087, "verse_number": "२-१०-७", "content_sanskrit": "अपविद्धानि कैकेय्या तानि भूमिं प्रपेदिरे।\nतया तान्य् अपविद्धानि माल्यान्य् आभरणानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000087008, "chapter_id": 9087, "verse_number": "२-१०-८", "content_sanskrit": "अशोभयन्त वसुधां नक्षत्राणि यथा नभः।\nक्रोधागारे च पतिता सा बभौ मलिनाम्बरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000087009, "chapter_id": 9087, "verse_number": "२-१०-९", "content_sanskrit": "एकवेणीं दृढां बद‍्ध्वा गतसत्त्वेव किंनरी।\nआज्ञाप्य तु महाराजो राघवस्याभिषेचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000087010, "chapter_id": 9087, "verse_number": "२-१०-१०", "content_sanskrit": "उपस्थानमनुज्ञाप्य प्रविवेश निवेशनम्।\nअद्य रामाभिषेको वै प्रसिद्ध इति जज्ञिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000087011, "chapter_id": 9087, "verse_number": "२-१०-११", "content_sanskrit": "प्रियार्हां प्रियमाख्यातुं विवेशान्तःपुरं वशी।\nस कैकेय्या गृहं श्रेष्ठं प्रविवेश महायशाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000087012, "chapter_id": 9087, "verse_number": "२-१०-१२", "content_sanskrit": "पाण्डुराभ्रम् इवाकाशं राहुयुक्तं निशाकरः।\nशुक-बर्हिसमायुक्तं क्रौञ्चहंसरुतायुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000087013, "chapter_id": 9087, "verse_number": "२-१०-१३", "content_sanskrit": "वादित्ररवसङ्घुष्टं कुब्जावामनिकायुतम्।\nलतागृहैश्चित्रगृहैश्चम्पकाशोकशोभितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000087014, "chapter_id": 9087, "verse_number": "२-१०-१४", "content_sanskrit": "दान्तराजतसौवर्णवेदिकाभिः समायुतम्।\nनित्यपुष्पफलैर्वृक्षैर्वापीभिरुपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000087015, "chapter_id": 9087, "verse_number": "२-१०-१५", "content_sanskrit": "दान्तराजतसौवर्णैः संवृतं परमासनैः।\nविविधैरन्नपानैश्च भक्ष्यैश्च विविधैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000087016, "chapter_id": 9087, "verse_number": "२-१०-१६", "content_sanskrit": "उपपन्नं महार्हैश्च भूषणैस्त्रिदिवोपमम्।\nस प्रविश्य महाराजः स्वमन्तःपुरमृद्धिमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000087017, "chapter_id": 9087, "verse_number": "२-१०-१७", "content_sanskrit": "न ददर्श स्त्रियं राजा कैकेयीं शयनोत्तमे।\nस कामबलसंयुक्तो रत्यर्थी मनुजाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000087018, "chapter_id": 9087, "verse_number": "२-१०-१८", "content_sanskrit": "अपश्यन् दयितां भार्यां पप्रच्छ विषसाद च।\nनहि तस्य पुरा देवी तां वेलामत्यवर्तत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000087019, "chapter_id": 9087, "verse_number": "२-१०-१९", "content_sanskrit": "न च राजा गृहं शून्यं प्रविवेश कदाचन।\nततो गृहगतो राजा कैकेयीं पर्यपृच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000087020, "chapter_id": 9087, "verse_number": "२-१०-२०", "content_sanskrit": "यथापुरम् अविज्ञाय स्वार्थलिप्सुम् अपण्डिताम्।\nप्रतिहारी त्वथोवाच संत्रस्ता तु कृताञ्जलिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000087021, "chapter_id": 9087, "verse_number": "२-१०-२१", "content_sanskrit": "देव देवी भृशं क्रुद्धा क्रोधागारमभिद्रुता।\nप्रतीहार्या वचः श्रुत्वा राजा परमदुर्मनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000087022, "chapter_id": 9087, "verse_number": "२-१०-२२", "content_sanskrit": "विषसाद पुनर्भूयो लुलितव्याकुलेन्द्रियः।\nतत्र तां पतितां भूमौ शयानामतथोचिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000087023, "chapter_id": 9087, "verse_number": "२-१०-२३", "content_sanskrit": "प्रतप्त इव दुःखेन सोऽपश्यज्जगतीपतिः।\nस वृद्धस्तरुणीं भार्यां प्राणेभ्योऽपि गरीयसीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000087024, "chapter_id": 9087, "verse_number": "२-१०-२४", "content_sanskrit": "अपापः पापसंकल्पां ददर्श धरणीतले।\nलतामिव विनिष्कृत्तां पतितां देवतामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000087025, "chapter_id": 9087, "verse_number": "२-१०-२५", "content_sanskrit": "किन्नरीमिव निर्धूतां च्युताम् अप्सरसं यथा।\nमायाम् इव परिभ्रष्टां हरिणीम् इव संयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000087026, "chapter_id": 9087, "verse_number": "२-१०-२६", "content_sanskrit": "करेणुम् इव दिग्धेन विद्धां मृगयुना वने।\nमहागज इवारण्ये स्नेहात् परमदुःखिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000087027, "chapter_id": 9087, "verse_number": "२-१०-२७", "content_sanskrit": "परिमृज्य च पाणिभ्यामभिसंत्रस्तचेतनः।\nकामी कमलपत्राक्षीमुवाच वनितामिदम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000087028, "chapter_id": 9087, "verse_number": "२-१०-२८", "content_sanskrit": "न तेऽहमभिजानामि क्रोधमात्मनि संश्रितम्।\nदेवि केनाभियुक्तासि केन वासि विमानिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000087029, "chapter_id": 9087, "verse_number": "२-१०-२९", "content_sanskrit": "यदिदं मम दुःखाय शेषे कल्याणि पांसुषु।\nभूमौ शेषे किमर्थं त्वं मयि कल्याणचेतसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000087030, "chapter_id": 9087, "verse_number": "२-१०-३०", "content_sanskrit": "भूतोपहतचित्तेव मम चित्तप्रमाथिनि।\nसन्ति मे कुशला वैद्यास्त्वभितुष्टाश्च सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000087031, "chapter_id": 9087, "verse_number": "२-१०-३१", "content_sanskrit": "सुखितां त्वां करिष्यन्ति व्याधिमाचक्ष्व भामिनि।\nकस्य वापि प्रियं कार्यं केन वा विप्रियं कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000087032, "chapter_id": 9087, "verse_number": "२-१०-३२", "content_sanskrit": "कः प्रियं लभतामद्य को वा सुमहदप्रियम्।\nमा रौत्सीर्मा च कार्षीस्त्वं देवि सम्परिशोषणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000087033, "chapter_id": 9087, "verse_number": "२-१०-३३", "content_sanskrit": "अवध्यो वध्यतां को वा वध्यः को वा विमुच्यताम्।\nदरिद्रः को भवेदाढ्यो द्रव्यवान् वाप्यकिंचनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000087034, "chapter_id": 9087, "verse_number": "२-१०-३४", "content_sanskrit": "अहं च हि मदीयाश्च सर्वे तव वशानुगाः।\nन ते कंचिदभिप्रायं व्याहन्तुमहमुत्सहे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000087035, "chapter_id": 9087, "verse_number": "२-१०-३५", "content_sanskrit": "आत्मनो जीवितेनापि ब्रूहि यन्मनसि स्थितम्।\nबलमात्मनि जानन्ती न मां शङ्कितुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000087036, "chapter_id": 9087, "verse_number": "२-१०-३६", "content_sanskrit": "करिष्यामि तव प्रीतिं सुकृतेनापि ते शपे।\nयावदावर्तते चक्रं तावती मे वसुंधरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000087037, "chapter_id": 9087, "verse_number": "२-१०-३७", "content_sanskrit": "द्राविडाः सिन्धुसौवीराः सौराष्ट्रा दक्षिणापथाः।\nवङ्गाङ्गमगधा मत्स्याः समृद्धाः काशिकोसलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000087038, "chapter_id": 9087, "verse_number": "२-१०-३८", "content_sanskrit": "तत्र जातं बहु द्रव्यं धनधान्यमजाविकम्।\nततो वृणीष्व कैकेयि यद् यत् त्वं मनसेच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000087039, "chapter_id": 9087, "verse_number": "२-१०-३९", "content_sanskrit": "किमायासेन ते भीरु उत्तिष्ठोत्तिष्ठ शोभने।\nतत्त्वं मे ब्रूहि कैकेयि यतस्ते भयमागतम्।\nतत् ते व्यपनयिष्यामि नीहारमिव रश्मिवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000087040, "chapter_id": 9087, "verse_number": "२-१०-४०", "content_sanskrit": "तथोक्ता सा समाश्वस्ता वक्तुकामा तदप्रियम्।\nपरिपीडयितुं भूयो भर्तारमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000087041, "chapter_id": 9087, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे दशमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]