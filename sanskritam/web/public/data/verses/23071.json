[{"id": 7003071000, "chapter_id": 23071, "verse_number": "४-५-१", "content_sanskrit": "श्रीनारायण उवाच ।\nगोलोकं निखिलं दृष्ट्वा देवास्ते हृष्टमानसाः ।\nपुनराजग्मू राधायाः प्रधानद्वारमेव च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003071001, "chapter_id": 23071, "verse_number": "४-५-२", "content_sanskrit": "सद्रत्नमणिनिर्माणं वेदिकायुग्मसंयुतम् ।\nहरिद्राकारमणिना वज्रसंमिश्रितेन च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003071002, "chapter_id": 23071, "verse_number": "४-५-३", "content_sanskrit": "अमूल्यरत्नरचितकपाटेन विभूषितम् ।\nद्वारे नियुक्तं ददृशुर्वीरभानुमनुत्तमम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003071003, "chapter_id": 23071, "verse_number": "४-५-४", "content_sanskrit": "रत्नसिंहासनस्थं च रत्नाभरणभूषितम् ।\nपीतवस्त्रपरीधानं सद्रत्नमुकुटोज्ज्वलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003071004, "chapter_id": 23071, "verse_number": "४-५-५", "content_sanskrit": "द्वारं चित्रविचित्रेण विचित्रं परमाद्भुतम् ।\nसर्वं निवेदनं चक्रुर्देवा दौवारिकं मुदा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003071005, "chapter_id": 23071, "verse_number": "४-५-६", "content_sanskrit": "तानुवाच द्वारपालो निःशंकं त्रिदशेश्वरान् ।\nनाहं विनाऽऽज्ञया गंतुं दातुं सांप्रतमीश्वरः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003071006, "chapter_id": 23071, "verse_number": "४-५-७", "content_sanskrit": "किंकरान्प्रेषयामास श्रीकृष्णस्थानमेव च ।\nहरेरनुज्ञां संप्राप्य ददौ गंतुं सुरान्मुने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003071007, "chapter_id": 23071, "verse_number": "४-५-८", "content_sanskrit": "तं संभाष्य ययुर्देवा द्वितीयं द्वारमुत्तमम् ।\nततोऽधिकं विचित्रं च सुंदरं सुमनोहरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003071008, "chapter_id": 23071, "verse_number": "४-५-९", "content_sanskrit": "द्वारे नियुक्तं ददृशुश्चंद्रभानुं च नारद ।\nकिशोरं श्यामलं चारु स्वर्णवेत्रधरं वरम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003071009, "chapter_id": 23071, "verse_number": "४-५-१०", "content_sanskrit": "रत्नसिंहासनस्थं च रत्नभूषणभूषितम् ।\nगोपानां च समूहेन पंचलक्षेण शोभितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003071010, "chapter_id": 23071, "verse_number": "४-५-११", "content_sanskrit": "तं संभाष्य ययुर्देवास्तृतीयं द्वारमुत्तमम् ।\nततोऽतिसुन्दरं चित्रं ज्वलन्तं मणितेजसा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003071011, "chapter_id": 23071, "verse_number": "४-५-१२", "content_sanskrit": "द्वारे नियुक्तं ददृशुः सूर्यभानुं च नारद ।\nद्विभुजं मुरलीहस्तं किशोरं श्यामसुन्दरम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003071012, "chapter_id": 23071, "verse_number": "४-५-१३", "content_sanskrit": "मणिकुण्डलयुग्मेन कपोलस्थलराजितम् ।\nरत्नदंडकरं श्रेष्ठं प्रेष्यं राधेशयोः परम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003071013, "chapter_id": 23071, "verse_number": "४-५-१४", "content_sanskrit": "नवलक्षेण गोपानां वेष्टितं च नृपेंद्रवत् ।\nतं संभाष्य ययुर्देवाश्चतुर्थं द्वारमेव च ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003071014, "chapter_id": 23071, "verse_number": "४-५-१५", "content_sanskrit": "तेभ्यो विलक्षणं रम्यं सुदीप्तं मणितेजसा ।\nअत्यद्भुतविचित्रेण भूषितं सुमनोहरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003071015, "chapter_id": 23071, "verse_number": "४-५-१६", "content_sanskrit": "द्वारे नियुक्तं ददृशुर्वसुभानुं व्रजेश्वरम् ।\nकिशोरं सुन्दरवरं मणिदण्डकरं परम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003071016, "chapter_id": 23071, "verse_number": "४-५-१७", "content_sanskrit": "रत्नसिंहासनस्थं च रत्नभूषणभूषितम् ।\nपक्वबिंबाधरोष्ठं च सस्मितं सुमनोहरम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003071017, "chapter_id": 23071, "verse_number": "४-५-१८", "content_sanskrit": "तं संभाष्य ययुर्देवा पञ्चमं द्वारमेव च ।\nवज्रभित्तिस्थितैश्चित्रविचित्रैर्ज्वलितं परम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003071018, "chapter_id": 23071, "verse_number": "४-५-१९", "content_sanskrit": "द्वारपालं च ददृशुर्देवभानुं च तत्र वै ।\nचारु सिंहासनस्थं च रत्नभूषणभूषितम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003071019, "chapter_id": 23071, "verse_number": "४-५-२०", "content_sanskrit": "मयूरपिच्छचूडं च रत्नमालाविभूषितम् ।\nकदंबपुष्पसंसक्तसद्रत्नकुण्डलोज्ज्वलम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003071020, "chapter_id": 23071, "verse_number": "४-५-२१", "content_sanskrit": "चंदनागरुकस्तूरीकुङ्कुमद्रवचर्चितम् ।\nनृपेंद्रवरतुल्यं च दशलक्षप्रजान्वितम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003071021, "chapter_id": 23071, "verse_number": "४-५-२२", "content_sanskrit": "तं वेत्रपाणिं संभाष्य ययुर्देवा मुदाऽन्विताः ।\nविलक्षणं द्वारषट्कं चित्रराजिविराजितम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003071022, "chapter_id": 23071, "verse_number": "४-५-२३", "content_sanskrit": "वज्रभित्तियुग्मयुक्ते पुष्पमाल्यविभूषिते ।\nद्वारे नियुक्तं ददृशुः शुक्रभानुं व्रजेश्वरम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003071023, "chapter_id": 23071, "verse_number": "४-५-२४", "content_sanskrit": "नानालंकारशोभाढ्यं दशलक्षप्रजान्वितम् ।\nश्रीखंडपल्लवासक्तकपोलं कुण्डलोज्ज्वलम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003071024, "chapter_id": 23071, "verse_number": "४-५-२५", "content_sanskrit": "तूर्णं सुरास्तं सभाष्य ययुर्द्वारं च सप्तमम् ।\nनानाप्रकारचित्रं च षड्भ्यश्चातिविलक्षणम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003071025, "chapter_id": 23071, "verse_number": "४-५-२६", "content_sanskrit": "द्वारे नियुक्तं ददृशू रत्नभानुं हरेः प्रियम् ।\nचंदनोक्षितसर्वांगं पुष्पमालाविभूषितम् ।\nभूषितं भूषणै रम्यैर्मणिरत्नमनोहरैः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003071026, "chapter_id": 23071, "verse_number": "४-५-२७", "content_sanskrit": "गोपैर्द्वादशलक्षैश्च राजेंद्रमिव राजितम् ।\nरत्नसिंहासनस्थं च स्मेराननसरोरुहम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003071027, "chapter_id": 23071, "verse_number": "४-५-२८", "content_sanskrit": "तं वेत्रहस्तं संभाष्य जग्मुर्देवेश्वरा मुदा ।\nविचित्रमष्टमं द्वारं सप्तभ्योऽपि विलक्षणम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003071028, "chapter_id": 23071, "verse_number": "४-५-२९", "content_sanskrit": "दौवारिकं ते ददृशुः सुपार्श्वं सुमनोहरम् ।\nसस्मितं सुन्दरवरं श्रीखण्डतिलकोज्ज्वलम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003071029, "chapter_id": 23071, "verse_number": "४-५-३०", "content_sanskrit": "बन्धुजीवाधरोष्ठं च रत्नकुण्डलमंडितम् ।\nसर्वालंकारशोभाढ्यं रत्नदण्डधरं वरम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003071030, "chapter_id": 23071, "verse_number": "४-५-३१", "content_sanskrit": "गोपैर्द्वादशलक्षैश्च किशोरैश्च समन्वितम् ।\nततः शीघ्रं ययुर्देवा नवमं द्वारमीप्सितम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003071031, "chapter_id": 23071, "verse_number": "४-५-३२", "content_sanskrit": "वज्रसद्रत्नरचितं चतुर्वेदिसमन्वितम् ।\nअपूर्वचित्ररचितमालजालैर्विराजितम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003071032, "chapter_id": 23071, "verse_number": "४-५-३३", "content_sanskrit": "द्वारपालं च ददृशुः सुबलं ललिताकृतिम् ।\nनानाभूषणशोभाढ्यं भूषणार्हं मनोहरम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003071033, "chapter_id": 23071, "verse_number": "४-५-३४", "content_sanskrit": "वज्रैर्द्वादशलक्षैश्च संयुक्तं सुमनोहरम् ।\nतं दण्डहस्तं सम्भाष्य सुरा द्वारातरं ययुः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003071034, "chapter_id": 23071, "verse_number": "४-५-३५", "content_sanskrit": "विशिष्टं दशमं द्वारं दृष्ट्वा ते विस्मयं ययुः ।\nसर्वानिर्वचनीयं चाप्यदृष्टमश्रुतं मुने ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003071035, "chapter_id": 23071, "verse_number": "४-५-३६", "content_sanskrit": "ददृशुर्द्वारपालं च सुदामानं च सुन्दरम् ।\nअनिवर्चनीयरूपं कृष्णतुल्यं मनोहरम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003071036, "chapter_id": 23071, "verse_number": "४-५-३७", "content_sanskrit": "गोपविंशतिलक्षाणां समूहैः परिवारितम् ।\nतं दण्डहस्तं दृष्ट्वैव जग्मुर्द्वारांतरं सुराः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003071037, "chapter_id": 23071, "verse_number": "४-५-३८", "content_sanskrit": "द्वारमेकादशाख्यं च सुचित्रं महदद्भुतम् ।\nद्वारपालं च तत्रस्थं श्रीदामानं व्रजेश्वरम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003071038, "chapter_id": 23071, "verse_number": "४-५-३९", "content_sanskrit": "राधिकापुत्रतुल्यं च पीतवस्त्रेण भूषितम् ।\nअमूल्यरत्नरचितरत्नसिंहासनस्थितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003071039, "chapter_id": 23071, "verse_number": "४-५-४०", "content_sanskrit": "अमूल्यरत्नभूषाभिर्भूषितं सुमनोहरम् ।\nचन्दनागुरुकस्तूरीकुंकुमेन विराजितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003071040, "chapter_id": 23071, "verse_number": "४-५-४१", "content_sanskrit": "गण्डस्थलकपोलार्हसद्रत्नकुण्डलोज्ज्वलम् ।\nसद्रत्नश्रेष्ठरचितविचित्रमुकुटोज्ज्वलम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003071041, "chapter_id": 23071, "verse_number": "४-५-४२", "content_sanskrit": "प्रफुल्लमालतीमालाजालैः सर्वांगभूषितम् ।\nकोटिगोपैः परिवृतं राजेन्द्राधिकमुज्ज्वलम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003071042, "chapter_id": 23071, "verse_number": "४-५-४३", "content_sanskrit": "तं संभाष्य ययुर्द्वारं द्वादशाख्यं सुरा मुदा ।\nअमूल्यरत्नरचितवेदिकाभिः समन्वितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003071043, "chapter_id": 23071, "verse_number": "४-५-४४", "content_sanskrit": "सर्वेषां दुर्लभं चित्रमदृश्यमश्रुतं मुने ।\nवज्रभित्तिस्थितं चित्रं सुन्दरं सुमनोहरम् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003071044, "chapter_id": 23071, "verse_number": "४-५-४५", "content_sanskrit": "द्वारे नियुक्ता ददृशुर्देवा गोपांगना वराः ।\nनवयौवनसंपन्ना रत्नाभरणभूषिताः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003071045, "chapter_id": 23071, "verse_number": "४-५-४६", "content_sanskrit": "पीतवस्त्रपरीधानाः कबरीभारभूषिताः ।\nसुगंधिमालतीमाला जालैः सर्वांगभूषिताः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003071046, "chapter_id": 23071, "verse_number": "४-५-४७", "content_sanskrit": "रत्नकंकणकेयूररत्ननूपुरभूषिताः ।\nरत्नकुंडलयुग्मेन गण्डस्थलविराजिताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003071047, "chapter_id": 23071, "verse_number": "४-५-४८", "content_sanskrit": "चन्दनागुरु कस्तूरीकुंकुमद्रवचर्चिताः ।\nपीनश्रोणीभरानम्रा नितंबाभारपीडिताः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003071048, "chapter_id": 23071, "verse_number": "४-५-४९", "content_sanskrit": "गोपीनां शतकोटीनां श्रेष्ठाः प्रेष्ठा हरेरपि ।\nगोपीश्च कोटिशो दृष्ट्वा सुरास्ते विस्मयं ययुः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003071049, "chapter_id": 23071, "verse_number": "४-५-५०", "content_sanskrit": "संभाष्य ता मुदा युक्ता ययुर्द्वारातरं मुने ।\nततश्च क्रमशो विप्र त्रिषु द्वारेषु तत्र वै ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003071050, "chapter_id": 23071, "verse_number": "४-५-५१", "content_sanskrit": "गोपांगनानां श्रेष्ठाश्च ददृशुः सुमनोहराः ।\nवराणां च वरा रम्या धन्या मान्याश्च शोभनाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003071051, "chapter_id": 23071, "verse_number": "४-५-५२", "content_sanskrit": "सर्वाः सौभाग्ययुक्ताश्च राधिकायाः प्रियाश्च ताः ।\nभूषिता भूषणै रम्यैः प्रोद्भिन्ननवयौवनाः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003071052, "chapter_id": 23071, "verse_number": "४-५-५३", "content_sanskrit": "एवं द्वारत्रयं दृष्ट्वा स्वप्ना ज्ञानाद्भुताश्रुतम् ।\nअदृश्यमतिरम्यं चाप्यनिरूप्यं विचक्षणैः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003071053, "chapter_id": 23071, "verse_number": "४-५-५४", "content_sanskrit": "तास्ताः संभाष्य देवास्ते विस्मिता ययुरीश्वराः ।\nराधिकाभ्यंतरं द्वारं षोडशाख्यं मनोहरम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003071054, "chapter_id": 23071, "verse_number": "४-५-५५", "content_sanskrit": "सर्वासां च प्रधानं च गोप्यं गोपांगनागणैः ।\nत्रयस्त्रिंशद्वयस्यानां निकरैर्वेष्टितं मुने ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003071055, "chapter_id": 23071, "verse_number": "४-५-५६", "content_sanskrit": "तेषामनिर्वचनीयैर्नानागुणसमन्वितैः ।\nरूपयौवनसंपन्नै रत्नालंकारभूषितैः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003071056, "chapter_id": 23071, "verse_number": "४-५-५७", "content_sanskrit": "रत्नकंकणकेयूरत्ननूपुरभूषितैः ।\nसद्रत्नकिंकिणीजालैमर्ध्यदेशविभूषितैः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003071057, "chapter_id": 23071, "verse_number": "४-५-५८", "content_sanskrit": "रत्नकुंडलयुग्मेन गंडस्थलविराजितैः ।\nप्रफुल्लमालतीमालाजालैर्वक्षस्थलोज्ज्वलैः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003071058, "chapter_id": 23071, "verse_number": "४-५-५९", "content_sanskrit": "शरत्पार्वणपद्मानां प्रभां मुष्णन्मुखेंदुभिः ।\nपारिजातप्रसूनानां मालाजालेन वेष्टितैः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003071059, "chapter_id": 23071, "verse_number": "४-५-६०", "content_sanskrit": "पक्वबिंबाधरोष्ठैश्च स्मेराननसरोरुहैः ।\nपक्वदाडिमबीजाभिः शोभितैर्दंतपंक्तिभिः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003071060, "chapter_id": 23071, "verse_number": "४-५-६१", "content_sanskrit": "चारुचंपकवर्णाभिर्मध्यस्थलकृशैर्मुने ।\nगजमौक्तिकयुक्ताभिर्नासिकाभिर्विराजितैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003071061, "chapter_id": 23071, "verse_number": "४-५-६२", "content_sanskrit": "खगेंद्रचारुचंचूनां शोभामुष्णाभिरेव च ।\nगजेंद्रगंडकठिन स्तनभारभरानतैः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003071062, "chapter_id": 23071, "verse_number": "४-५-६३", "content_sanskrit": "पीनश्रोणिभरार्तैश्च मुकुंदपदमानसैः ।\nनिमेषरहिता देवा द्वारं च ददृशुश्च ताः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003071063, "chapter_id": 23071, "verse_number": "४-५-६४", "content_sanskrit": "लसद्रमणिरत्नैश्च वेदिकायुग्मशोभितम् ।\nहरिन्मणीनां स्तंभानां समूहैः संयुतं सदा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003071064, "chapter_id": 23071, "verse_number": "४-५-६५", "content_sanskrit": "सिंदूराकारमणिभिर्मध्यस्थलविराजितैः ।\nपारिजात प्रसूनानां मालाजालैर्विभूषितम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003071065, "chapter_id": 23071, "verse_number": "४-५-६६", "content_sanskrit": "तत्संस्पर्शैर्गंधवाहैः सर्वत्र सुरभीकृतम् ।\nदृष्ट्वा तत्परमाश्चर्यं राधिकाभ्यंतरं सुराः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003071066, "chapter_id": 23071, "verse_number": "४-५-६७", "content_sanskrit": "श्रीकृष्णचरणांभोजदर्शनैकमनोरथाः ।\nताः संभाष्य ययुः शीघ्रं पुलकांचितविग्रहाः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003071067, "chapter_id": 23071, "verse_number": "४-५-६८", "content_sanskrit": "भक्त्युद्रेकादश्रुपूर्णाः किंचिन्नम्रात्मकंधराः ।\nआरात्ते ददृशुर्देवा राधिकाभ्यंतरं वरम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003071068, "chapter_id": 23071, "verse_number": "४-५-६९", "content_sanskrit": "मंदिराणां च मध्यस्थं चतुःशालं मनोहरम् ।\nअमूल्यरत्नसाराणां सारेण रचितं परम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003071069, "chapter_id": 23071, "verse_number": "४-५-७०", "content_sanskrit": "नानारत्नमणिस्तंभैर्वज्रयुक्तैश्च भूषितम् ।\nपारिजातप्रसूनानां मालाजालैर्विराजितम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003071070, "chapter_id": 23071, "verse_number": "४-५-७१", "content_sanskrit": "मुक्तासमूहैर्माणिक्यैः श्वेतचामरदर्पणैः ।\nअमूल्यरत्नसाराणां कलशैर्भूषितं मुने ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003071071, "chapter_id": 23071, "verse_number": "४-५-७२", "content_sanskrit": "पट्टसूत्रग्रंथियुक्तश्रीखंडपल्लवान्वितैः ।\nमणिस्तंभसमूहैश्च रम्यप्रांगणभूषितम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003071072, "chapter_id": 23071, "verse_number": "४-५-७३", "content_sanskrit": "चंदनागुरुकस्तूरीकुंकुमद्रवसंयुतम् ।\nशु्क्लधान्यशुक्लपुष्पप्रवालफलतंडुलैः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003071073, "chapter_id": 23071, "verse_number": "४-५-७४", "content_sanskrit": "पर्णदूर्वाक्षतैर्लाजैर्निर्मंछनविभूषितैः ।\nफलयुक्तै रत्नकुंभैः सिंदूरकुंकुमान्वितैः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003071074, "chapter_id": 23071, "verse_number": "४-५-७५", "content_sanskrit": "पारिजातप्रसूनानां मालायुक्तैर्विराजितम् ।\nप्रसूनाक्तैर्गंधवाहैः सर्वत्र सुरभीकृतम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003071075, "chapter_id": 23071, "verse_number": "४-५-७६", "content_sanskrit": "सर्वानिर्वचनीयं च यद्द्रव्यमनिरूपितम् ।\nब्रह्मांडे दुर्लभं यद्यद्वस्तुभिस्तैर्विराजितम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003071076, "chapter_id": 23071, "verse_number": "४-५-७७", "content_sanskrit": "पारिजातप्रसूनानां मालाजालैः सुशोभितम् ।\nरत्नशय्यासु ललिताः सूक्ष्मवस्त्रपरिच्छदाः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003071077, "chapter_id": 23071, "verse_number": "४-५-७८", "content_sanskrit": "कोटिशो रत्नकुंभाश्च रत्नपात्राणि नारद ।\nअमूल्यानि च चारूणि तैस्तैरेव विभूषितम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003071078, "chapter_id": 23071, "verse_number": "४-५-७९", "content_sanskrit": "नानाप्रकारवाद्यानां कलनादैर्निनादितम्।\nस्वरयंत्रैश्च वीणाभिर्गोपीसंगीतसुश्रुत म्७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003071079, "chapter_id": 23071, "verse_number": "४-५-८०", "content_sanskrit": "मोहितं वाद्यशब्दैश्च मृदंगानां च नारद ।\nगोपानां कृष्णतुल्यानां समूहैः परिवारितम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003071080, "chapter_id": 23071, "verse_number": "४-५-८१", "content_sanskrit": "राधासखीनां गोपीनां वृंदैर्वृंदैर्विराजितम् ।\nराधाकृष्णगुणोद्रेकपदसंगीतसुश्रुतम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003071081, "chapter_id": 23071, "verse_number": "४-५-८२", "content_sanskrit": "एवमभ्यंतरं दृष्ट्वा बभूवुर्विस्मिताः सुराः। ।\nशुश्रुवुर्मधुरं गीतं ददृशुर्नृत्यमुत्तमम् ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003071082, "chapter_id": 23071, "verse_number": "४-५-८३", "content_sanskrit": "तत्र तस्थुः सुराः सर्वे ध्यानैकतानमानसाः ।\nरत्नसिंहासनं रम्यं ददृशुस्त्रिदशेश्वराः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003071083, "chapter_id": 23071, "verse_number": "४-५-८४", "content_sanskrit": "धनुःशतप्रमाणं च परितो वर्तुलाकृतिम्।\nसद्रत्नक्षुद्रकलशसमूहैश्च समन्वितम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003071084, "chapter_id": 23071, "verse_number": "४-५-८५", "content_sanskrit": "चित्रपुत्तलिकापुष्पचित्रकाननभूषितम् ।\nतत्र तेजःसमूहं च सूर्यकोटिसमप्रभम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003071085, "chapter_id": 23071, "verse_number": "४-५-८६", "content_sanskrit": "प्रभया ज्वलितं ब्रह्मन्नाश्चर्यं महदद्भुतम् ।\nसप्ततालप्रमाणं तद्व्याप्तमूर्ध्वं समन्ततः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003071086, "chapter_id": 23071, "verse_number": "४-५-८७", "content_sanskrit": "तेजोमुषं च सर्वेषां महाश्रमविवर्जितम् ।\nसर्वव्यापि सर्वबीजं चक्षूरोधकरं परम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003071087, "chapter_id": 23071, "verse_number": "४-५-८८", "content_sanskrit": "दृष्ट्वा तेजःस्वरूपं च ते देवा ध्यानतत्पराः ।\nप्रणेमुः परया भक्त्या भक्तिनम्रात्मकंधराः ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003071088, "chapter_id": 23071, "verse_number": "४-५-८९", "content_sanskrit": "परमानन्दसंयोगादश्रुपूर्णविलोचनाः ।\nपुलकांकितसर्वांगा वांछापूर्णमनोरथाः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003071089, "chapter_id": 23071, "verse_number": "४-५-९०", "content_sanskrit": "नत्वा तेजःस्वरूपं च तमीशं त्रिदशेश्वराः ।\nतत्रोत्थाय ध्यानयुक्ताः प्रतस्थुस्तेजसः पुरः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003071090, "chapter_id": 23071, "verse_number": "४-५-९१", "content_sanskrit": "ध्यात्वैवं जगतां धाता बभूव संपुटांजलिः ।\nदक्षिणे शंकरं कृत्वा वामे धर्मं च नारद ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003071091, "chapter_id": 23071, "verse_number": "४-५-९२", "content_sanskrit": "भक्त्युद्रेकात्प्रतुष्टाव ध्यानैकतानमानसः ।\nपरात्परं गुणातीतं परमात्मानमीश्वरम् ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003071092, "chapter_id": 23071, "verse_number": "४-५-९३", "content_sanskrit": "ब्रह्मोवाच ।\nवरं वरेण्यं वरदं वरदानां च कारणम् ।\nकारणं सर्वभूतानां तेजोरूपं नमाम्यहम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003071093, "chapter_id": 23071, "verse_number": "४-५-९४", "content_sanskrit": "मंगलं मंगलानां च मंगलं मंगलप्रदम् ।\nसमस्तमंगलाधारं तेजोरूपं नमाम्यह म्९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003071094, "chapter_id": 23071, "verse_number": "४-५-९५", "content_sanskrit": "स्थितं सर्वत्र निर्लिप्तमात्मरूपं परात्परम् ।\nनिरीहमवितर्क्यं च तेजोरूपं नमाम्यहम् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003071095, "chapter_id": 23071, "verse_number": "४-५-९६", "content_sanskrit": "सगुणं निर्गुणं ब्रह्म ज्योतीरूपं सनातनम् ।\nसाकारं च निराकारं तेजोरूपं नमाम्यहम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003071096, "chapter_id": 23071, "verse_number": "४-५-९७", "content_sanskrit": "तमनिर्वचनीयं च व्यक्तमव्यक्तमेककम् ।\nस्वेच्छामयं सर्वरूपं तेजोरूपं नमाम्यहम् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003071097, "chapter_id": 23071, "verse_number": "४-५-९८", "content_sanskrit": "गुणत्रयविभागाय रूपत्रयधरं परम् ।\nकलया ते कृताः सर्वे किं जानन्ति श्रुतेः परम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003071098, "chapter_id": 23071, "verse_number": "४-५-९९", "content_sanskrit": "सर्वाधारं सर्वरूपं सर्वबीजमबीजकम् ।\nसर्वांतकमनन्तं च तेजोरूपं नमाम्यहम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003071099, "chapter_id": 23071, "verse_number": "४-५-१००", "content_sanskrit": "लक्ष्यं षङ्गुणरूपं च वर्णनीयं विचक्षणैः ।\nकिं वर्णयामि लक्ष्यं च तेजोरूपं नमाम्यहम् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003071100, "chapter_id": 23071, "verse_number": "४-५-१०१", "content_sanskrit": "अशरीरं विग्रहवदिंद्रियं यदतींद्रियम् ।\nयदसाक्षि सर्वसाक्षि तेजोरूपं नमाम्यहम् ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003071101, "chapter_id": 23071, "verse_number": "४-५-१०२", "content_sanskrit": "गमनार्हमपादं यदचक्षुः सर्वदर्शनम् ।\nहस्तास्यहीनं यद्भोक्तृ तेजोरूपं नमाम्यहम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003071102, "chapter_id": 23071, "verse_number": "४-५-१०३", "content_sanskrit": "वेदे निरूपितं वस्तु सन्तः शक्ताश्च वर्णितुम् ।\nवेदेऽनिरूपितं यत्तत्तेजोरूपं नमाम्यहम् ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003071103, "chapter_id": 23071, "verse_number": "४-५-१०४", "content_sanskrit": "सर्वेशं यदनीशं यत्सर्वादि यदनादि यत् ।\nसर्वात्मकमनात्मं यत्तेजोरूपं नमाम्यहम् ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003071104, "chapter_id": 23071, "verse_number": "४-५-१०५", "content_sanskrit": "अहं विधाता जगतो वेदानां जनकः स्वयम् ।\nपाता धर्मो हरो हर्ता स्तोतुं शक्ता न केऽपि यत् ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7003071105, "chapter_id": 23071, "verse_number": "४-५-१०६", "content_sanskrit": "सेवया तव धर्मोऽयं पालने च निरूपितः।\nतवाज्ञया च संहर्ता त्वया काले निरूपिते ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7003071106, "chapter_id": 23071, "verse_number": "४-५-१०७", "content_sanskrit": "निःशेषोत्पत्तिकर्त्ताऽहं त्वत्पादांभोजसेवया ।\nकर्मिणां फलदाता च त्वं भक्तानां च नः प्रभुः ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7003071107, "chapter_id": 23071, "verse_number": "४-५-१०८", "content_sanskrit": "ब्रह्मांडे बिंबसदृशे भूत्वा विषयिणो वयम् ।\nएवं कतिविधाः संति तेष्वनन्तेषु सेवकाः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7003071108, "chapter_id": 23071, "verse_number": "४-५-१०९", "content_sanskrit": "यथा न संख्या रेणूनां तथा तेषामणीयसाम् ।\nसर्वेषां जनकश्चेशो यस्तं स्तोतुं च के क्षमाः ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7003071109, "chapter_id": 23071, "verse_number": "४-५-११०", "content_sanskrit": "एकैकलोमविवरे ब्रह्मांडमेकमेककम् ।\nयस्यैव महतो विष्णोः षोडशांशस्तवैव सः ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7003071110, "chapter_id": 23071, "verse_number": "४-५-१११", "content_sanskrit": "ध्यायंते योगिनः सर्वे तवैतद्रूपमीप्सितम् ।\nत्वद्भक्तदास्यनिरताः सेवंते चरणांबुजम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7003071111, "chapter_id": 23071, "verse_number": "४-५-११२", "content_sanskrit": "किशोरं सुंदरतरं यक्षं कमनीयकम् ।\nमंत्रध्यानानुरूपं च दर्शयास्माकमीश्वर ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7003071112, "chapter_id": 23071, "verse_number": "४-५-११३", "content_sanskrit": "नवीनजलदश्यामपीतांबरधरं वरम् ।\nद्विभुजं मुरलीहस्तं सस्मितं सुमनोहरम् ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7003071113, "chapter_id": 23071, "verse_number": "४-५-११४", "content_sanskrit": "मयूरपिच्छचूडं च मालतीजालमंडितम् ।\nचंदनागुरुकस्तूरीकुङ्कुमद्रवचर्चितम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7003071114, "chapter_id": 23071, "verse_number": "४-५-११५", "content_sanskrit": "अमूल्यरत्नसाराणां सारभूषणभूषितम् ।\nअमूल्यरत्नरचितकिरीटमुकुटोज्ज्वलम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7003071115, "chapter_id": 23071, "verse_number": "४-५-११६", "content_sanskrit": "शरत्प्रफुल्लपद्मानां प्रभामोष्यास्यचंद्रकम् ।\nपक्वबिंबसमानेन ह्यधरोष्ठेन राजितम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7003071116, "chapter_id": 23071, "verse_number": "४-५-११७", "content_sanskrit": "पक्वदाडिमबीजाभदंतपंक्तिमनोहरम् ।\nकेलीकदंबमूले च स्थितं रासरसोन्मुखम् ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7003071117, "chapter_id": 23071, "verse_number": "४-५-११८", "content_sanskrit": "गोपीवक्त्रस्मिततनुं राधावक्षःस्थलस्थितम् ।\nएवं वांछितरूपं ते दृष्टुं को वा न चोत्सुकः ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7003071118, "chapter_id": 23071, "verse_number": "४-५-११९", "content_sanskrit": "इत्येवमुक्त्वा विश्वसृट् प्रणनाम पुनः पुनः ।\nएवं स्तोत्रेण तुष्टाव धर्मोऽपि शंकरः स्वयम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7003071119, "chapter_id": 23071, "verse_number": "४-५-१२०", "content_sanskrit": "ननाम भूयोभूयश्च साश्रुपूर्णविलोचनः ।\nतिष्ठतोऽपि पुनः स्तोत्रं प्रचक्रुस्त्रिदशेश्वराः ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7003071120, "chapter_id": 23071, "verse_number": "४-५-१२१", "content_sanskrit": "व्याप्तास्तत्राश्रमे सर्वे श्रीकृष्णतेजसा मुने ।\nस्तवराजमिमं नित्यं ब्रह्मेशधर्मभिः कृतम् ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7003071121, "chapter_id": 23071, "verse_number": "४-५-१२२", "content_sanskrit": "पूजाकाले हरेरेवं भक्तियुक्तश्च यः पठेत् ।\nसुदुर्लभां दृढां भक्तिं निश्चलां लभते हरेः ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7003071122, "chapter_id": 23071, "verse_number": "४-५-१२३", "content_sanskrit": "सुरासुरमुनींद्राणां दुर्लभं दास्यमेव च ।\nअणिमादिकसिद्धिं च सालोक्यादि चतुष्टयम् ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7003071123, "chapter_id": 23071, "verse_number": "४-५-१२४", "content_sanskrit": "इहैव विष्णुतुल्यश्च विख्यातः पूजितो धुवम् ।\nवाक्सिद्धिर्मंत्रसिद्धिश्च भवेत्तस्य सुनिश्चितम् ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7003071124, "chapter_id": 23071, "verse_number": "४-५-१२५", "content_sanskrit": "सर्वसौभाम्यसंयुक्तं यशसा पूरितं जगत् ।\nपुत्रश्च विद्या कविता निश्चला कमला तथा ॥१२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7003071125, "chapter_id": 23071, "verse_number": "४-५-१२६", "content_sanskrit": "पत्नी पतिव्रता साध्वी सुशीला सुस्थिराः प्रजाः ।\nकीर्तिश्च चिरकालीना त्वंते कृष्णांतिके गतिः ॥१२६", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}]