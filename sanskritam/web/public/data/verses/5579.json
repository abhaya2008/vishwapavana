[{"id": 2214221, "chapter_id": 5579, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2214222, "chapter_id": 5579, "verse_number": "१", "content_sanskrit": "ततस्ते नियतात्मान उदीचीं दिशमास्थिताः ।\nददृशुर्योगयुक्ताश्च हिमवन्तं महागिरिम्\t ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2214223, "chapter_id": 5579, "verse_number": "२", "content_sanskrit": "तं चाप्यतिक्रमन्तस्ते ददृशुर्वालुकार्णवम् ।\nअवैक्षन्त महाशैलं मेरुं शिखरिणां वरम्\t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2214224, "chapter_id": 5579, "verse_number": "३", "content_sanskrit": "तेषां तु गच्छतां शीघ्रं सर्वेषां योगधर्मिणाम् ।\nयाज्ञसेनी भ्रष्टयोगा निपपात महीतळे\t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2214225, "chapter_id": 5579, "verse_number": "४", "content_sanskrit": "तां तु प्रपतितां दृष्ट्वा भीमसेनो महाबलः ।\nउवाच धर्मराजानं याज्ञसेनीमवेक्ष्य ह\t ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2214226, "chapter_id": 5579, "verse_number": "५", "content_sanskrit": "नाधर्मश्चरितः कश्चिद् राजपुत्र्या परन्तप ।\nकारणं किन्नु तद् ब्रूहि यत्कृष्णा पतिता भुवि\t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2214227, "chapter_id": 5579, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2214228, "chapter_id": 5579, "verse_number": "६", "content_sanskrit": "पक्षपातो महानस्या विशेषेण धनञ्जये ।\nतस्यैतत्फलमद्यैषा भुङ्क्ते पुरुषसत्तम\t ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2214229, "chapter_id": 5579, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2214230, "chapter_id": 5579, "verse_number": "७", "content_sanskrit": "एवमुक्त्वाऽनवेक्ष्यैनां ययौ भरतसत्तमः ।\nसमाधाय मनो धीमान् धर्मात्मा पुरुषर्षभः\t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2214231, "chapter_id": 5579, "verse_number": "८", "content_sanskrit": "सहदेवस्ततो विद्वान् निपपात महीतळे ।\nतं चापि पतितं दृष्ट्वा भीमो राजानमब्रवीत्\t ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2214232, "chapter_id": 5579, "verse_number": "९", "content_sanskrit": "योऽयमस्मासु सर्वेषु शुश्रूषुरनहङ्कृतः ।\nसोऽयं माद्रवतीपुत्रः कस्मान्निपतितो भुवि\t ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2214233, "chapter_id": 5579, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2214234, "chapter_id": 5579, "verse_number": "१०", "content_sanskrit": "आत्मनः सदृशं प्राज्ञं नैषोऽमन्यत कञ्चन ।\nतेन दोषेण पतितो विद्वानेष नृपात्मजः\t ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2214235, "chapter_id": 5579, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2214236, "chapter_id": 5579, "verse_number": "११", "content_sanskrit": "इत्युक्त्वा तं समुत्सृज्य सहदेवं ययौ तदा ।\nभ्रातृभिः सह कौन्तेयः शुना चैव युधिष्ठिरः\t ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2214237, "chapter_id": 5579, "verse_number": "१२", "content_sanskrit": "कृष्णां निपतितां दृष्ट्वा सहदेवं च पाण्डवम् ।\nआर्तो बन्धुप्रियः शूरो नकुलो निपपात ह\t ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2214238, "chapter_id": 5579, "verse_number": "१३", "content_sanskrit": "तस्मिन्निपतिते वीरे नकुले चारुदर्शने ।\nपुनरेव तदा भीमो राजानमिदमब्रवीत्\t ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2214239, "chapter_id": 5579, "verse_number": "१४", "content_sanskrit": "योऽयमक्षतधर्मात्मा भ्राता वचनकारकः ।\nरूपेणाप्रतिमो लोके नकुलः पतितो भुवि\t ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2214240, "chapter_id": 5579, "verse_number": "१५", "content_sanskrit": "इत्युक्तो भीमसेनेन प्रत्युवाच युधिष्ठिरः ।\nनकुलं प्रति धर्मात्मा सर्वबुद्धिमतांवरः\t ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2214241, "chapter_id": 5579, "verse_number": "१६", "content_sanskrit": "रूपेण मत्समो नास्ति कश्चिदित्यस्य दर्शनम् ।\nअधिकश्चाहमेवैक इत्यस्य मनसि स्थितम्\t ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2214242, "chapter_id": 5579, "verse_number": "१७", "content_sanskrit": "नकुलः पतितस्तस्मादागच्छ त्वं वृकोदर ।\nयस्य यद्विहितं वीर सोऽवश्यं तदुपाश्नुते\t ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2214243, "chapter_id": 5579, "verse_number": "१८", "content_sanskrit": "तांस्तु प्रपतितान् दृष्ट्वा पाण्डवः श्वेतवाहनः ।\nपपात शोकसन्तप्तस्ततोनु परवीरहा\t ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2214244, "chapter_id": 5579, "verse_number": "१९", "content_sanskrit": "तस्मिंस्तु पुरुषव्याघ्रे पतिते शक्रतेजसि ।\nम्रियमाणे दुराधर्षे भीमो राजानमब्रवीत्\t ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2214245, "chapter_id": 5579, "verse_number": "२०", "content_sanskrit": "अनृतं न स्मराम्यस्य स्वैरेष्वपि महात्मनः ।\nअथ कस्य विकारोऽयं येनायं पतितो भुवि\t ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2214246, "chapter_id": 5579, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2214247, "chapter_id": 5579, "verse_number": "२१", "content_sanskrit": "एकोहं निर्दहेयं वै शत्रूनित्यर्जुनोऽब्रवीत् ।\nन च तत्कृतवानेष शूरमानी ततोपतत्\t ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2214248, "chapter_id": 5579, "verse_number": "२२", "content_sanskrit": "अवमेने धनुर्ग्राहानेष सर्वांश्च फल्गुनः ।\nतथा चैतन्न तु तथा कर्तव्यं भूतिमिच्छता\t ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2214249, "chapter_id": 5579, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2214250, "chapter_id": 5579, "verse_number": "२३", "content_sanskrit": "इत्युक्त्वा प्रस्थितो राजा भीमोऽथ निपपात ह ।\nपतितश्चाब्रवीद् भीमो धर्मराजं युधिष्ठिरम्\t ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2214251, "chapter_id": 5579, "verse_number": "२४", "content_sanskrit": "भो भो राजन्नवेक्षस्व पतितोऽहं प्रियस्तव ।\nकिंनिमित्तं च पतनं ब्रूहि मे यदि वेत्थ ह\t ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2214252, "chapter_id": 5579, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2214253, "chapter_id": 5579, "verse_number": "२५", "content_sanskrit": "अतिभुक्तं च भवता प्राणेन च विकत्थसे ।\nअनवेक्ष्य परं पार्थ तेनासि पतितः क्षितौ\t ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2214254, "chapter_id": 5579, "verse_number": "२६", "content_sanskrit": "इत्युक्त्वा तं महाबाहुर्जगामानवलोकयन् ।\nश्वाप्येकोनुययौ यस्ते बहुशः कीर्तितो मया\t ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2214255, "chapter_id": 5579, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् महाप्रस्थानिकपर्वणि\nभीमार्जुननकुलसहदेवद्रौपदीदेहपतननिमित्तकथनं नाम तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]