[{"id": 2090443, "chapter_id": 2921, "verse_number": "१३-५१-१", "content_sanskrit": "भीष्म उवाच।\nअथ सा स्त्री तमुवाच विप्रमेवं भवत्विति।\nतैलं दिव्यमुपादाय स्नानशाटीमुपानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2090444, "chapter_id": 2921, "verse_number": "१३-५१-२", "content_sanskrit": "अनुज्ञाता च मुनिना सा स्त्री तेन महात्मना।\nअथास्य तैलेनाङ्गानि सर्वाण्येवाभ्यमृक्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2090445, "chapter_id": 2921, "verse_number": "१३-५१-३", "content_sanskrit": "शनैश्चाच्छादितस्तत्र स्नानशालामुपागमत्।\nभद्रासनं ततश्चित्रमृषिरन्वगमन्नवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2090446, "chapter_id": 2921, "verse_number": "१३-५१-४", "content_sanskrit": "अथोपविष्टश्च यदा तस्मिन्भद्रासने तदा।\nस्नापयामास शनकैस्तमृषिं सुखहस्तवत्।\nदिव्यं च विधिवच्चक्रे सोपचारं मुनेस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2090447, "chapter_id": 2921, "verse_number": "१३-५१-५", "content_sanskrit": "जलेन सुसुखोष्णेन तस्या हस्तसुखेन च।\nव्यतीतां रजनीं कृत्स्नां नाजानात्स महाव्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2090448, "chapter_id": 2921, "verse_number": "१३-५१-६", "content_sanskrit": "तत उत्थाय स मुनिस्तदा परमविस्मितः।\nपूर्वस्यां दिशि सूर्यं च सोऽपश्यदुदितं दिवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2090449, "chapter_id": 2921, "verse_number": "१३-५१-७", "content_sanskrit": "`सन्ध्योपासनमित्येव सर्वपापहरं न मे।\nतस्य बुद्धिरियं किन्तु मोहस्तत्त्वमिदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2090450, "chapter_id": 2921, "verse_number": "१३-५१-८", "content_sanskrit": "अथोपास्य सहस्रांशुं किं कोरमीत्युवाच ताम्।\nसा चामृतरसप्रख्यं क्रषेरन्नमुपाहरत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2090451, "chapter_id": 2921, "verse_number": "१३-५१-९", "content_sanskrit": "तस्य स्वादुतयाऽन्नस्य न प्रभूतं चकार सः।\nव्यगमच्चाप्यहःशेष ततः सन्ध्याऽऽगमत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2090452, "chapter_id": 2921, "verse_number": "१३-५१-१०", "content_sanskrit": "अथ सा स्त्री भगवन्तं सुप्यतामित्यचोदयत्।\nतत्र वै शयने दिव्ये तस्य तस्याश्च कल्पिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2090453, "chapter_id": 2921, "verse_number": "१३-५१-११", "content_sanskrit": "[पृथक्र्वैव तथा सुप्तौ सा स्त्री स च मुनिस्तदा।\nतथाऽर्थरात्रे सा स्त्री तु शयनं तदुपागमत्॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2090454, "chapter_id": 2921, "verse_number": "१३-५१-१२x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2090455, "chapter_id": 2921, "verse_number": "१३-५१-१२", "content_sanskrit": "न भद्रे परदारेषु मनो मे सम्प्रसज्जति।\nउत्तिष्ठ भद्रे भद्रं ते स्वापं वै विरमस्व च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2090456, "chapter_id": 2921, "verse_number": "१३-५१-१३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2090457, "chapter_id": 2921, "verse_number": "१३-५१-१३", "content_sanskrit": "सा तदा तेन विप्रेण तथा धृत्या निवर्तिता।\nस्वतन्त्राऽस्मीत्युवाचर्षिं न धर्मच्छलमस्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2090458, "chapter_id": 2921, "verse_number": "१३-५१-१४x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2090459, "chapter_id": 2921, "verse_number": "१३-५१-१४", "content_sanskrit": "नास्ति स्वतन्त्रता स्त्रीणामस्वतन्त्रा हि योषितः।\nप्रजापतिमतं ह्येतन्न स्त्री स्वातन्त्र्यमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2090460, "chapter_id": 2921, "verse_number": "१३-५१-१५x", "content_sanskrit": "स्त्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2090461, "chapter_id": 2921, "verse_number": "१३-५१-१५", "content_sanskrit": "बाधने मैथुनं विप्र मम भक्तिं च पश्य वै।\nअधर्मं प्राप्स्यसे विप्र यन्मां त्वं नाभिनन्दसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2090462, "chapter_id": 2921, "verse_number": "१३-५१-१६x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2090463, "chapter_id": 2921, "verse_number": "१३-५१-१६", "content_sanskrit": "हरन्ति दोषजातानि नरमिन्द्रियकिङ्करम्।\nप्रभवामि सदा धृत्या भद्रे स्वशयनं व्रज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2090464, "chapter_id": 2921, "verse_number": "१३-५१-१७x", "content_sanskrit": "स्त्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2090465, "chapter_id": 2921, "verse_number": "१३-५१-१७", "content_sanskrit": "शिरसा प्रणमे विप्र प्रसादं कर्तुमर्हसि।\nभूमौ निपतमानायाः शरणं भव मेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2090466, "chapter_id": 2921, "verse_number": "१३-५१-१८", "content_sanskrit": "यदि वा दोषजातं त्वं परदारेषु पश्यसि।\nआत्मानं स्पर्शयाम्यद्य पाणिं गृह्णीष्व मे द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2090467, "chapter_id": 2921, "verse_number": "१३-५१-१९", "content_sanskrit": "न दोषो भविता चैव सत्येनैतद्ब्रवीम्यहम्।\nस्वतन्त्रां मां विजानीहि यो धर्मः सोस्तु वै मयि।\nत्वय्यावेशितचित्ता च स्वतन्त्राऽस्मि भजस्व माम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2090468, "chapter_id": 2921, "verse_number": "१३-५१-२०x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2090469, "chapter_id": 2921, "verse_number": "१३-५१-२०", "content_sanskrit": "स्वतन्त्रा त्वं कथं भद्रे ब्रूहि कारणमत्र वै।\nनास्ति त्रिलोके स्त्री काचिद्या वै स्वातन्त्र्यमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2090470, "chapter_id": 2921, "verse_number": "१३-५१-२१", "content_sanskrit": "पिता रक्षति कौमारे भर्ता रक्षति यौवने।\nपुत्रस्तु स्थाविरे भावे न स्त्री स्वातन्त्र्यमर्हति।\n`न वृद्धामक्षतां मन्ये च चेच्छा त्वयि मेऽनघे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2090471, "chapter_id": 2921, "verse_number": "१३-५१-२२x", "content_sanskrit": "स्त्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2090472, "chapter_id": 2921, "verse_number": "१३-५१-२२", "content_sanskrit": "कौमारं ब्रह्मचर्यं मे कन्यैवास्मि न संशयः।\nपत्नीं कुरुष्व मां विप्र श्रद्धां विजहि मा मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2090473, "chapter_id": 2921, "verse_number": "१३-५१-२३x", "content_sanskrit": "अष्टावक्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2090474, "chapter_id": 2921, "verse_number": "१३-५१-२३", "content_sanskrit": "यथा मम तथा तुभ्यं यथा तुभ्यं तथा मम।\nजिज्ञासेयमृषेस्तस्य विघ्नः सत्यं नु किं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2090475, "chapter_id": 2921, "verse_number": "१३-५१-२४", "content_sanskrit": "आश्चर्यं परमं हीदं किन्नु श्रेयो हि मे भवेत्।\nदिव्याभरणवस्त्रा हि कन्येयं मामुपस्थिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2090476, "chapter_id": 2921, "verse_number": "१३-५१-२५", "content_sanskrit": "किं त्वस्याः परमं रूपं जीर्णमासीत्कथं पुनः।\nकन्यारूपमिहाद्यैवं किमिवात्रोत्तरं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2090477, "chapter_id": 2921, "verse_number": "१३-५१-२६", "content_sanskrit": "यथा मे परमा शक्तिर्न व्युत्थाने कथंचन।\nन रोचते हि व्युत्थानं सत्येनासादयाम्यहम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2090478, "chapter_id": 2921, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि एकपञ्चाशोऽध्यायः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]