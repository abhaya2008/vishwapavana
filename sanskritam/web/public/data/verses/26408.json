[{"id": 7006408000, "chapter_id": 26408, "verse_number": "२-६६-१", "content_sanskrit": "वैशम्पायन उवाच\nउपविष्टं मुनिं ज्ञात्वा रुक्मिण्या सह केशवः ।\nनिश्चक्रामाप्रमेयात्मा व्यपदेशेन सर्ववित् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006408001, "chapter_id": 26408, "verse_number": "२-६६-२", "content_sanskrit": "जगाम त्वरितश्चैव सत्यभामागृहं महत् ।\nरम्ये रैवतकोद्देशै निर्मितं विश्वकर्मणा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006408002, "chapter_id": 26408, "verse_number": "२-६६-३", "content_sanskrit": "अभिमानवतीमिष्टां प्राणैरपि गरीयसीम् ।\nजानन् सात्राजितीं विष्णुर्विवेश शनकैरिव ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006408003, "chapter_id": 26408, "verse_number": "२-६६-४", "content_sanskrit": "रुषितामिव तां देवीं स्नेहात् संकल्पयन्निव ।\nभीतभीतः स शनकैर्विवेश मधुसूदनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006408004, "chapter_id": 26408, "verse_number": "२-६६-५", "content_sanskrit": "सेवकं द्वारदेशे तु तिष्ठेत्युक्त्वा विवेश ह ।\nनारदस्योपचारार्थं प्रद्युम्नं विनियुज्य सः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006408005, "chapter_id": 26408, "verse_number": "२-६६-६", "content_sanskrit": "स ददर्श प्रियां दूरात् क्रोधागारगतां तदा ।\nप्रेष्यामिव स्थितां कोपान्निःश्वसन्तीं मुहुर्मुहुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006408006, "chapter_id": 26408, "verse_number": "२-६६-७", "content_sanskrit": "करजाग्रावलीढं तु पङ्कजं मुखपङ्कजे ।\nसंश्लेषयित्वा निःश्वस्य विहसन्तीं पुनः पुनः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006408007, "chapter_id": 26408, "verse_number": "२-६६-८", "content_sanskrit": "किंचिदाकुलिताग्रेण चरणेन वसुन्धराम् ।\nकृत्वा पृष्ठेऽथ वदनं विहरन्तीं पुनः पुनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006408008, "chapter_id": 26408, "verse_number": "२-६६-९", "content_sanskrit": "करपद्मे पुनः सव्ये मुखपद्मं निवेश्य च ।\nवनितां चारुसर्वाङ्गीं ध्यायन्तीं कमलेक्षणाम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006408009, "chapter_id": 26408, "verse_number": "२-६६-१०", "content_sanskrit": "सरसं चन्दनं गृह्य प्रेष्याहस्तादनिन्दिताम् ।\nप्रह्लादयित्वा हृदयं क्षिपन्तीं निर्दयं पुनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006408010, "chapter_id": 26408, "verse_number": "२-६६-११", "content_sanskrit": "पुनरुत्थाय शयनात् पतन्तीं च पुनः पुनः ।\nतास्ताश्चेष्टाः प्रियायाश्च तथान्या ददृशे हरिः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006408011, "chapter_id": 26408, "verse_number": "२-६६-१२", "content_sanskrit": "अवगुण्ठ्य यदा वक्त्रमुपधाने न्यवेशयत् ।\nइदमन्तरमित्येवं तदा गत्वा जनार्दनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006408012, "chapter_id": 26408, "verse_number": "२-६६-१३", "content_sanskrit": "प्रेष्याजनं स संज्ञाय अनाख्येयोऽस्मि संज्ञया ।\nस शङ्कितप्रचारश्च वारितोऽन्वगमत्स ताम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006408013, "chapter_id": 26408, "verse_number": "२-६६-१४", "content_sanskrit": "ग्रहाय व्यजनं चैव स्थित्वा स परिपार्श्वतः ।\nशनैरिवासृजद् वातं जहास शनकैरिव ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006408014, "chapter_id": 26408, "verse_number": "२-६६-१५", "content_sanskrit": "स पारिजातपुष्पस्य संसर्गादनुवासितः ।\nबभार भगवान् गन्धं दिव्यं मानुषदुर्लभम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006408015, "chapter_id": 26408, "verse_number": "२-६६-१६", "content_sanskrit": "अत्यद्भुतं सुगन्धं च जिघ्रित्वा विस्मयान्विता ।\nअपावृणोन्मुखं सत्या किमेतदिति चाब्रवीत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006408016, "chapter_id": 26408, "verse_number": "२-६६-१७", "content_sanskrit": "सोत्थिता पृष्ठतो देवमपश्यन्ती शुचिस्मिता ।\nपर्यपृच्छदथो प्रेष्या गन्धस्य प्रभवे तदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006408017, "chapter_id": 26408, "verse_number": "२-६६-१८", "content_sanskrit": "ताः पृष्टास्त्वप्रभाषन्त्यो जानुभ्यां धरणीं गताः ।\nअधोमुख्यस्ततस्तस्थुः कृताञ्जलिपुटास्तदा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006408018, "chapter_id": 26408, "verse_number": "२-६६-१९", "content_sanskrit": "तदपूर्वमदृष्ट्वैव गन्धं मुञ्चति मेदिनी ।\nकथमेकतरस्तस्या गन्धोऽयमिति तत् खलु ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006408019, "chapter_id": 26408, "verse_number": "२-६६-२०", "content_sanskrit": "किंन्विदं स्यादिति च सा विवेक्षन्ती समन्ततः ।\nददृशे केशवं देवी सहसा लोकभावनम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006408020, "chapter_id": 26408, "verse_number": "२-६६-२१", "content_sanskrit": "युज्यतीति ततोवाच सहसास्राविलेक्षणा ।\nअवतिक्तेव रोषेण बभूव प्रणयान्विता ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006408021, "chapter_id": 26408, "verse_number": "२-६६-२२", "content_sanskrit": "सा प्रस्फुरितचार्वोष्ठी निःश्वस्याधोमुखी तदा ।\nमुहूर्तमसितापाङ्गी तस्थावन्यमुखी शुभा ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006408022, "chapter_id": 26408, "verse_number": "२-६६-२३", "content_sanskrit": "निबध्य भ्रुकुटिं वामां सम्यग्विक्षिप्य लोचने ।\nनिवेश्य वदनं हस्ते शोभसीत्यब्रवीद्धरिम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006408023, "chapter_id": 26408, "verse_number": "२-६६-२४", "content_sanskrit": "तस्याः सुस्राव नेत्राभ्यां वारि प्रणयकोपजम् ।\nकुशेशयपलाशाभ्यामवश्यायजलं यथा ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006408024, "chapter_id": 26408, "verse_number": "२-६६-२५", "content_sanskrit": "समुत्पत्य जलं तत्र पतितं वदनाम्बुजात् ।\nप्रतिजग्राह पद्माक्षः कराभ्यामतिसत्वरः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006408025, "chapter_id": 26408, "verse_number": "२-६६-२६", "content_sanskrit": "अथोरसि पतत्तोयं श्रीवत्साङ्कोऽम्बुजेक्षणः ।\nप्रियानयनजं देवः परिमृज्येदमब्रवीत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006408026, "chapter_id": 26408, "verse_number": "२-६६-२७", "content_sanskrit": "स्रवत्यसितपत्राक्षि किमर्थं तव भामिनि ।\nतोयं सुन्दरि नेत्राभ्यां पुष्कराभ्यामिवोदकम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006408027, "chapter_id": 26408, "verse_number": "२-६६-२८", "content_sanskrit": "प्रभाते पूर्णचन्द्रस्य मध्याह्ने पङ्कजस्य च ।\nबिभर्ति तव किं वक्त्रं वपुस्तव मनोहरे ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006408028, "chapter_id": 26408, "verse_number": "२-६६-२९", "content_sanskrit": "किमर्थं कौङ्कुमं वासो महाराजतमेव च ।\nनानुगृह्णासि सुश्रोणि शुक्लं वासोऽनुगृह्यते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006408029, "chapter_id": 26408, "verse_number": "२-६६-३०", "content_sanskrit": "वासस्येते तवाभीष्टे महारजतकौंकुमे ।\nदेवाभिगमनादूर्ध्वं शुक्लं नेष्टं हि तत्स्त्रियाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006408030, "chapter_id": 26408, "verse_number": "२-६६-३१", "content_sanskrit": "किञ्चानाभरणं गात्रं सुगात्रि तव कथ्यताम् ।\nचित्रकस्थानमाक्रान्तं कस्मादवरवर्णिनि ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006408031, "chapter_id": 26408, "verse_number": "२-६६-३२", "content_sanskrit": "श्वेतेन तव पट्टेन वाससा प्रियदर्शने ।\nललाटं सेव्यते कस्माच्चन्दनेन सुगन्धिना ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006408032, "chapter_id": 26408, "verse_number": "२-६६-३३", "content_sanskrit": "सरसेनायतापाङ्गि कान्तेन हृदयप्रिये ।\nप्रभोपमर्दं केनापि कारणेनाननस्य च ।\nकरोषि मम वात्यर्थं मनो ग्लापयसि प्रिये ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006408033, "chapter_id": 26408, "verse_number": "२-६६-३४", "content_sanskrit": "प्रसृतश्चन्दनरसः कपोलप्रणयी तव ।\nपत्रलेखासपत्नत्वं प्राप्तो नातिविराजते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006408034, "chapter_id": 26408, "verse_number": "२-६६-३५", "content_sanskrit": "रत्नैश्चाभरणैर्मुक्ता तव ग्रीवा न शोभते ।\nग्रहनक्षत्ररहिता द्यौरिवाव्यक्तशारदी ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006408035, "chapter_id": 26408, "verse_number": "२-६६-३६", "content_sanskrit": "पूर्णचन्द्रसपत्नेन स्मेरेणाबहुभाषिणा ।\nकिमु नो भाषसे माद्य मुखेनोत्पलगन्धिना ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7006408036, "chapter_id": 26408, "verse_number": "२-६६-३७", "content_sanskrit": "अर्द्धाक्ष्णापि हि तावन्मां किमर्थं न निरीक्षसे ।\nमुञ्चस्येव सनिश्वासं तोयमञ्जनदुर्दिनम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7006408037, "chapter_id": 26408, "verse_number": "२-६६-३८", "content_sanskrit": "अलमिन्दीवरश्यामे रुदितेन मनस्विनि ।\nजलमञ्जनकल्माषं मा मोक्षीराननद्विषम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7006408038, "chapter_id": 26408, "verse_number": "२-६६-३९", "content_sanskrit": "त्वदीयोऽहं यदा देवि ख्यातो जगति किङ्करः ।\nनाज्ञापयसि किं मां त्वं पुरेव वरवर्णिनि ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7006408039, "chapter_id": 26408, "verse_number": "२-६६-४०", "content_sanskrit": "किमकार्षमहं देवि विप्रियं तव भामिनि ।\nयेनातिमात्रमात्मानमायासयसि सुन्दरि ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7006408040, "chapter_id": 26408, "verse_number": "२-६६-४१", "content_sanskrit": "मनसा कर्मणा वाचा न त्वामतिचराम्यहम् ।\nसर्वथा सर्वचार्वङ्गि सत्यमेतद् ब्रवीम्यहम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7006408041, "chapter_id": 26408, "verse_number": "२-६६-४२", "content_sanskrit": "बहुमानोपमान्यासु स्त्रीषु सर्वासु शोभने ।\nस्नेहश्च बहुमानश्च त्वामृतेऽन्यासु नास्ति मे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7006408042, "chapter_id": 26408, "verse_number": "२-६६-४३", "content_sanskrit": "नैव त्वां मदनो जह्यान्मृतेऽपि मयि मामकः ।\nइति मे निश्चितं विद्धि चेतः सुरसुतोपमे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7006408043, "chapter_id": 26408, "verse_number": "२-६६-४४", "content_sanskrit": "क्षमादयश्च मेदिन्यां शब्दाद्याश्चाम्बरे गुणाः ।\nध्रुवं पङ्कजगर्भाभे त्वयि स्नेहस्तथा मम ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7006408044, "chapter_id": 26408, "verse_number": "२-६६-४५", "content_sanskrit": "रुचिरग्नौ यथा दिव्या प्रभा चैव दिवाकरे ।\nकान्तिश्च शाश्वती चन्द्रे स्नेहस्त्वयि तथा मम॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7006408045, "chapter_id": 26408, "verse_number": "२-६६-४६", "content_sanskrit": "एवंवादिनमात्मेष्टं सत्यभामा जनार्दनम् ।\nशनैरुवाच नेत्राभ्यां प्रमृज्य सुभगा जलम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7006408046, "chapter_id": 26408, "verse_number": "२-६६-४७", "content_sanskrit": "मदीयस्त्वमिति ह्यासीन्मम नित्यं मनः प्रभो ।\nअद्य साधारणं स्नेहं त्वयि तावद्गतास्म्यहम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7006408047, "chapter_id": 26408, "verse_number": "२-६६-४८", "content_sanskrit": "नाज्ञासिषमहं पूर्वमनित्यं कालपर्ययम् ।\nअद्य लोकगतिं कृत्स्नामवगच्छामि न ध्रुवाम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7006408048, "chapter_id": 26408, "verse_number": "२-६६-४९", "content_sanskrit": "अमृताया द्वितीयोऽपि जन्मौहि मम सर्वथा ।\nकिमत्र बहुनोक्तेन हृदयं वेद्मि तेऽच्युत ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7006408049, "chapter_id": 26408, "verse_number": "२-६६-५०", "content_sanskrit": "वाङ्मात्रमेव पश्यामि माधुर्यं सम्प्रयुज्यते ।\nमयि स्नेहश्च कृतकस्तवान्यत्र न कृत्रिमः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7006408050, "chapter_id": 26408, "verse_number": "२-६६-५१", "content_sanskrit": "ऋजुस्वभावां भक्तां च सर्वथा पुरुषोत्तम ।\nअवजानासि जानन् मां कैतवीं वृत्तिमास्थितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7006408051, "chapter_id": 26408, "verse_number": "२-६६-५२", "content_sanskrit": "एतावदस्तु पर्याप्तं दृष्टं द्रष्टव्यमव्ययम् ।\nश्रुतं चाप्यद्य यच्छ्राव्यं दृष्टः स्नेहफलोदयः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7006408052, "chapter_id": 26408, "verse_number": "२-६६-५३", "content_sanskrit": "यदि त्वहमनुग्राह्या मामनुज्ञातुमर्हसि ।\nतपस्येऽहं परं कृत्वा निश्चयं पुरुषोत्तम ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7006408053, "chapter_id": 26408, "verse_number": "२-६६-५४", "content_sanskrit": "भर्तुश्छन्देन नारीणां तपो वा व्रतकानि वा ।\nनिष्फलं खलु यद् भर्तुरच्छन्देन क्रियेत हि ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7006408054, "chapter_id": 26408, "verse_number": "२-६६-५५", "content_sanskrit": "इतीदमुक्त्वा पुनरेव शोभना मुमोच तोयं नयनोद्भवं सती ।\nग्रहाय पीतं हरिवाससः शुभा पटान्तमाधाय मुखे शुचिस्मिता ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]