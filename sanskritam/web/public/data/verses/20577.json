[{"id": 7000577000, "chapter_id": 20577, "verse_number": "५-३६-१", "content_sanskrit": "शेषौवाच ।\nएतच्छ्रुत्वा तु विप्रेन्द्रो लोमशात्परमं महत् ।\nपुनः पप्रच्छ तमृषिं सर्वज्ञं योगिनां वरम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000577001, "chapter_id": 20577, "verse_number": "५-३६-२", "content_sanskrit": "आरण्यक उवाच ।\nमुनिश्रेष्ठ वदैतन्मे पृच्छामि त्वां महामते ।\nगुरवः कृपया युक्ता भाषंते सेवकेऽखिलम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000577002, "chapter_id": 20577, "verse_number": "५-३६-३", "content_sanskrit": "कोऽसौ रामो महाभाग यो नित्यं ध्यायते त्वया ।\nतस्य कानि चरित्राणि वदस्व त्वं द्विजर्षभ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000577003, "chapter_id": 20577, "verse_number": "५-३६-४", "content_sanskrit": "किमर्थमवतीर्णोऽसौ कस्मान्मानुषतां गतः ।\nतत्सर्वं कथयाशु त्वं मम संशयनुत्तये॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000577004, "chapter_id": 20577, "verse_number": "५-३६-५", "content_sanskrit": "शेष उवाच ।\nइति वाक्यं समाकर्ण्य मुनेः परमशोभनम् ।\nलोमशः कथयामास रामचारित्रमद्भुतम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000577005, "chapter_id": 20577, "verse_number": "५-३६-६", "content_sanskrit": "लोकान्निरयसंमग्नाञ्ज्ञात्वा योगेश्वरेश्वरः ।\nकीर्तिं प्रथयितुं लोके यया घोरं तरिष्यति॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000577006, "chapter_id": 20577, "verse_number": "५-३६-७", "content_sanskrit": "एवं ज्ञात्वा दयावार्धिः परमेशो मनोहरः ।\nअवतारं चकारात्र चतुर्धा सश्रियान्वितः॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000577007, "chapter_id": 20577, "verse_number": "५-३६-८", "content_sanskrit": "पुरा त्रेतायुगे प्राप्ते पूर्णांशो रघुनन्दनः ।\nसूर्यवंशे समुत्पन्नो रामो राजीवलोचनः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000577008, "chapter_id": 20577, "verse_number": "५-३६-९", "content_sanskrit": "स रामो लक्ष्मणसखः काकपक्षधरो युवा ।\nतातस्य वचनात्तौ तु विश्वामित्रमनुव्रतौ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000577009, "chapter_id": 20577, "verse_number": "५-३६-१०", "content_sanskrit": "यज्ञसंरक्षणार्थाय राज्ञा दत्तौ कुमारकौ ।\nदांतौ धनुर्धरौ वीरौ विश्वामित्रमनुव्रतौ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000577010, "chapter_id": 20577, "verse_number": "५-३६-११", "content_sanskrit": "पथि प्रव्रजतोस्तत्र ताटका नाम राक्षसी ।\nसंगता च वने घोरे तयोर्वै विघ्नकारणात्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000577011, "chapter_id": 20577, "verse_number": "५-३६-१२", "content_sanskrit": "ऋषेरनुज्ञया रामस्ताटकां यमयातनाम् ।\nप्रावेशयद्धनुर्वेदविद्याभ्यासेन राघवः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000577012, "chapter_id": 20577, "verse_number": "५-३६-१३", "content_sanskrit": "यस्य पादतलस्पर्शाच्छिला वासवयोगजा ।\nअहल्या गौतमवधूः पुनर्जाता स्वरूपिणी॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000577013, "chapter_id": 20577, "verse_number": "५-३६-१४", "content_sanskrit": "विश्वामित्रस्य यज्ञे तु सुप्रवृत्ते रघूत्तमः ।\nमारीचं च सुबाहुं च जघान परमेषुभिः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000577014, "chapter_id": 20577, "verse_number": "५-३६-१५", "content_sanskrit": "ईश्वरस्य धनुर्भग्नं जनकस्य गृहे स्थितम् ।\nरामः पंचदशे वर्षे षड्वर्षामथ मैथिलीम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000577015, "chapter_id": 20577, "verse_number": "५-३६-१६", "content_sanskrit": "उपयेमे विवाहेन रम्यां सीतामयोनिजाम् ।\nकृतकृत्यस्तदा जातः सीतां संप्राप्य राघवः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000577016, "chapter_id": 20577, "verse_number": "५-३६-१७", "content_sanskrit": "ततो द्वादश वर्षाणि रेमे रामस्तया सह ।\nसप्तविंशतिमे वर्षे यौवराज्यमकल्पयत्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000577017, "chapter_id": 20577, "verse_number": "५-३६-१८", "content_sanskrit": "राजानमथ कैकेयी वरद्वयमयाचत ।\nतयोरेकेन रामस्तु ससीतः सह लक्ष्मणः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000577018, "chapter_id": 20577, "verse_number": "५-३६-१९", "content_sanskrit": "जटाधरः प्रव्रजतुवर्षाणीह चतुर्दश ।\nभरतस्तु द्वितीयेन यौवराज्याधिपोऽस्तु मे॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000577019, "chapter_id": 20577, "verse_number": "५-३६-२०", "content_sanskrit": "जानकी लक्ष्मणसखं रामं प्राव्राजयन्नृपः ।\nत्रिरात्रमुदकाहारश्चतुर्थेऽह्नि फलाशनः॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000577020, "chapter_id": 20577, "verse_number": "५-३६-२१", "content_sanskrit": "पंचमे चित्रकूटे तु रामस्थानमकल्पयत् ।\nअथ त्रयोदशे वर्षे पंचवट्यां महामुने॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000577021, "chapter_id": 20577, "verse_number": "५-३६-२२", "content_sanskrit": "रामो विरूपयामास शूर्पणखां निशाचरीम् ।\nवने विचरतस्तस्य जानक्या सहितस्य च॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000577022, "chapter_id": 20577, "verse_number": "५-३६-२३", "content_sanskrit": "आगतो राक्षसस्तां तु हर्तुं पापविपाकतः ।\nततो माघासिताष्टम्यां मुहूर्ते वृंदसंज्ञिते॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000577023, "chapter_id": 20577, "verse_number": "५-३६-२४", "content_sanskrit": "राघवाभ्यां विना सीतां जहार दशकंधरः ।\nतेनैवं ह्रियमाणा सा चक्रंद कुररी यथा॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000577024, "chapter_id": 20577, "verse_number": "५-३६-२५", "content_sanskrit": "रामरामेति मां रक्ष रक्ष मां रक्षसा हृताम् ।\nयथा श्येनः क्षुधाक्रांतः क्रंदंतीं वर्तिकां नयेत्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000577025, "chapter_id": 20577, "verse_number": "५-३६-२६", "content_sanskrit": "तथा कामवशं प्राप्तो रावणो जनकात्मजाम् ।\nनयत्येवं जनकजां जटायुः पक्षिराट्तदा॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000577026, "chapter_id": 20577, "verse_number": "५-३६-२७", "content_sanskrit": "युयुधे राक्षसेंद्रेण स रावणहतोऽपतत् ।\nमार्गशुक्लनवम्यां तु वसंतीं रावणालये॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000577027, "chapter_id": 20577, "verse_number": "५-३६-२८", "content_sanskrit": "संपातिर्दशमे मास आचख्यौ वानरेषु ताम् ।\nएकादश्यां महेंद्राद्रे पुःप्लुवे शतयोजनम्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000577028, "chapter_id": 20577, "verse_number": "५-३६-२९", "content_sanskrit": "हनूमान्निशि तस्यां तु लंकायां पर्यकालयत् ।\nतद्रात्रिशेषे सीताया दर्शनं हि हनूमतः॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000577029, "chapter_id": 20577, "verse_number": "५-३६-३०", "content_sanskrit": "द्वादश्यां शिंशपावृक्षे हनूमान्पर्यवस्थितः ।\nतस्यां निशायां जानक्या विश्वासाय च संकथा॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000577030, "chapter_id": 20577, "verse_number": "५-३६-३१", "content_sanskrit": "अक्षादिभिस्त्रयोदश्यां ततो युद्धमवर्तत ।\nब्रह्मास्त्रेण चतुर्दश्यां बद्धः शक्रजिता कपिः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000577031, "chapter_id": 20577, "verse_number": "५-३६-३२", "content_sanskrit": "वह्निना पुच्छयुक्तेन लंकाया दहनं कृतम् ।\nपूर्णिमायां महेंद्राद्रौ पुनरागमनं कपेः॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000577032, "chapter_id": 20577, "verse_number": "५-३६-३३", "content_sanskrit": "मार्गासितप्रतिपदः पंचभिः पथिवासरैः ।\nपुनरागत्य षष्ठेऽह्नि ध्वस्तं मधुवनं किल॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000577033, "chapter_id": 20577, "verse_number": "५-३६-३४", "content_sanskrit": "सप्तम्यां प्रत्यभिज्ञानदानं सर्वनिवेदनम् ।\nअष्टम्युत्तरफल्गुन्यां मुहूर्ते विजयाभिधे॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000577034, "chapter_id": 20577, "verse_number": "५-३६-३५", "content_sanskrit": "मध्यं प्राप्ते सहस्रांशौ प्रस्थानं राघवस्य च ।\nरामः कृत्वा प्रतिज्ञां तु प्रयातो दक्षिणां दिशम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000577035, "chapter_id": 20577, "verse_number": "५-३६-३६", "content_sanskrit": "तीर्त्वाहं सागरमपि हनिष्ये राक्षसेश्वरम् ।\nदक्षिणाशां प्रयातस्य सुग्रीवोऽप्यभवत्सखा॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000577036, "chapter_id": 20577, "verse_number": "५-३६-३७", "content_sanskrit": "वासरैः सप्तभिः सिंधोः स्कंधावारनिवेशनम् ।\nपौषशुक्लप्रतिपदस्तृतीयायावदंबुधेः॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000577037, "chapter_id": 20577, "verse_number": "५-३६-३८", "content_sanskrit": "उपस्थानं ससैन्यस्य राघवस्य बभूव ह ।\nबिभीषणश्चतुर्थ्यां तु रामेण सह संगतः॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000577038, "chapter_id": 20577, "verse_number": "५-३६-३९", "content_sanskrit": "समुद्रतरणार्थाय पंचम्यां मंत्र उद्यतः ।\nप्रायोपवेशनं चक्रे रामो दिनचतुष्टयम्॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000577039, "chapter_id": 20577, "verse_number": "५-३६-४०", "content_sanskrit": "समुद्रवरलाभश्च सहोपायप्रदर्शनम् ।\nततो दशम्यामारंभस्त्रयोदश्यां समापनम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000577040, "chapter_id": 20577, "verse_number": "५-३६-४१", "content_sanskrit": "चतुर्दश्यां सुवेलाद्रौ रामः सैन्यं न्यवेशयत् ।\nपौर्णमास्यां द्वितीयां तं त्रिदिनैः सैन्यतारणम्॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000577041, "chapter_id": 20577, "verse_number": "५-३६-४२", "content_sanskrit": "तीर्त्वा तोयनिधिं रामो वानरेश्वरसैन्यवान् ।\nरुरोध च पुरीं लंकां सीतार्थं सह लक्ष्मणः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000577042, "chapter_id": 20577, "verse_number": "५-३६-४३", "content_sanskrit": "तृतीयादि दशम्यंतं निवेशश्च दिनाष्टकम् ।\nशुकसारणयोस्तत्र प्राप्तिरेकादशे दिने॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000577043, "chapter_id": 20577, "verse_number": "५-३६-४४", "content_sanskrit": "पौषासिताख्यद्वादश्यां सैन्यसंख्यानमेव च ।\nशार्दूलेन कपींद्राणां सहसारोपवर्णनम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000577044, "chapter_id": 20577, "verse_number": "५-३६-४५", "content_sanskrit": "त्रयोदश्या अमावास्यां लंकायां दिवसैस्त्रिभिः ।\nरावणः सैन्यसंख्यानं रणोत्साहं तदाकरोत्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000577045, "chapter_id": 20577, "verse_number": "५-३६-४६", "content_sanskrit": "प्रययावंगदो दौत्यं माघशुक्लाद्यवासरे ।\nसीतायाश्च ततो भर्तुर्मायामूर्द्धादिदर्शनम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000577046, "chapter_id": 20577, "verse_number": "५-३६-४७", "content_sanskrit": "माघद्वितीयादि दिनैः सप्तभिर्यावदष्टमी ।\nरक्षसां वानराणां च युद्धमासीच्च संकुलम्॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000577047, "chapter_id": 20577, "verse_number": "५-३६-४८", "content_sanskrit": "माघशुक्लनवम्यां तु रात्राविंद्रजिता रणे ।\nरामलक्ष्मणयोर्नागपाशबंधः कृतः किल॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000577048, "chapter_id": 20577, "verse_number": "५-३६-४९", "content_sanskrit": "आकुलेषु कपीशेषु निरुत्साहेषु सर्वशः ।\nनागपाशविमोक्षार्थं दशम्यां पवनोऽजपत्॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000577049, "chapter_id": 20577, "verse_number": "५-३६-५०", "content_sanskrit": "कर्णे स्वरूपं रामस्य गरुडागमनं ततः ।\nएकादश्यां च द्वादश्यां धूम्राक्षस्य वधः कृतः॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000577050, "chapter_id": 20577, "verse_number": "५-३६-५१", "content_sanskrit": "त्रयोदश्यां तु तेनैव निहतः कंपनो रणे ।\nमाघशुक्लचतुर्दश्या यावत्कृष्णादिवासरम्॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000577051, "chapter_id": 20577, "verse_number": "५-३६-५२", "content_sanskrit": "त्रिदिनेन प्रहस्तस्य नीलेन विहितो वधः ।\nमाघकृष्णद्वितीयायाश्चतुर्थ्यं तं त्रिभिर्दिनैः॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000577052, "chapter_id": 20577, "verse_number": "५-३६-५३", "content_sanskrit": "रामेण तुमुले युद्धे रावणो द्रावितो रणात् ।\nपंचम्या अष्टमीयावद्रावणेन प्रबोधितः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000577053, "chapter_id": 20577, "verse_number": "५-३६-५४", "content_sanskrit": "कुंभकर्णस्तदा चक्रेऽभ्यवहारं चतुर्दिनम् ।\nकुंभकर्णो दिनैः षड्भिर्नवम्यास्तु चतुर्दशीम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000577054, "chapter_id": 20577, "verse_number": "५-३६-५५", "content_sanskrit": "रामेण निहतो युद्धे बहुवानरभक्षकः ।\nअमावास्यादिने शोकादवहारो बभूव ह॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000577055, "chapter_id": 20577, "verse_number": "५-३६-५६", "content_sanskrit": "फाल्गुनादिप्रतिपदश्चतुर्थ्यंतं चतुर्दिनैः ।\nबिसतंतुप्रभृतयो निहताः पंचराक्षसाः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000577056, "chapter_id": 20577, "verse_number": "५-३६-५७", "content_sanskrit": "पंचम्याः सप्तमी यावदतिकायवधस्तथा ।\nअष्टम्याद्वादशी यावन्निहतौ दिनपंचकात्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000577057, "chapter_id": 20577, "verse_number": "५-३६-५८", "content_sanskrit": "निकुंभकुंभावूर्ध्वं तु मकराक्षस्त्रिभिर्दिनैः ।\nफाल्गुनासितद्वितीयायां दिने शक्रजिता जितम्॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000577058, "chapter_id": 20577, "verse_number": "५-३६-५९", "content_sanskrit": "तृतीयादिसप्तम्यंतं दिनपंचकमेव च ।\nओषध्यानयनव्यग्रादवहारो बभूव ह॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000577059, "chapter_id": 20577, "verse_number": "५-३६-६०", "content_sanskrit": "ततस्त्रयोदशीयावद्दिनैः पंचभिरिंद्रजित् ।\nलक्ष्मणेन हतो युद्धे विख्यातबलपौरुषः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000577060, "chapter_id": 20577, "verse_number": "५-३६-६१", "content_sanskrit": "चतुर्दश्यां दशग्रीवो दीक्षां प्रापावहारतः ।\nअमावास्यादिने प्रायाद्युद्धाय दशकंधरः॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000577061, "chapter_id": 20577, "verse_number": "५-३६-६२", "content_sanskrit": "चैत्रशुक्लप्रतिपदः पंचमीदिनपंचकैः ।\nरावणे युद्ध्यमाने तु प्रचुरो रक्षसां वधः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000577062, "chapter_id": 20577, "verse_number": "५-३६-६३", "content_sanskrit": "चैत्रषष्ठ्याष्टमी यावन्महापार्श्वादि मारणम् ।\nचैत्रशुक्लनवम्यां तु सौमित्रेः शक्तिभेदनम्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000577063, "chapter_id": 20577, "verse_number": "५-३६-६४", "content_sanskrit": "कोपाविष्टेन रामेण द्रावितो दशकंधरः ।\nद्रोणाद्रिरांजनेयेन लक्ष्मणार्थमुपाहृतः॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000577064, "chapter_id": 20577, "verse_number": "५-३६-६५", "content_sanskrit": "दशम्यामवहारोभूद्रात्रौ युद्धे तु रक्षसाम् ।\nएकादश्यां तु रामाय रथं मातलिसारथिः॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000577065, "chapter_id": 20577, "verse_number": "५-३६-६६", "content_sanskrit": "प्रेरितो वासवेनाजावर्पयामास भक्तितः ।\nकोपवानथ द्वादश्या यावत्कृष्णचतुर्दशी॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000577066, "chapter_id": 20577, "verse_number": "५-३६-६७", "content_sanskrit": "अष्टादशदिनै रामो रावणं द्वैरथेऽवधीत् ।\nसंग्रामे तुमुले जाते रामो जयमवाप्तवान्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000577067, "chapter_id": 20577, "verse_number": "५-३६-६८", "content_sanskrit": "माघशुक्लद्वितीयायाश्चैत्रकृष्ण चतुर्दशीम् ।\nसप्ताशीतिदिनेष्वेव मध्यं पंचदशाहकम्॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000577068, "chapter_id": 20577, "verse_number": "५-३६-६९", "content_sanskrit": "युद्धावहारः संग्रामो द्वासप्तति दिनान्यभूत् ।\nसंस्कारो रावणादीनाममावस्या दिनेऽभवत्॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000577069, "chapter_id": 20577, "verse_number": "५-३६-७०", "content_sanskrit": "वैशाखादि तिथौ राम उवास रणभूमिषु ।\nअभिषिक्तो द्वितीयायां लंकाराज्ये विभीषणः॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000577070, "chapter_id": 20577, "verse_number": "५-३६-७१", "content_sanskrit": "सीताशुद्धिस्तृतीयायां देवेभ्यो वरलंभनम् ।\nहत्वा चिरेण लंकेशं लक्ष्मणाग्रज एव सः॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000577071, "chapter_id": 20577, "verse_number": "५-३६-७२", "content_sanskrit": "गृहीत्वा जानकीं पुण्यां दुःखितां राक्षसेन तु ।\nआदाय परया प्रीत्या जानकीं स न्यवर्तत॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000577072, "chapter_id": 20577, "verse_number": "५-३६-७३", "content_sanskrit": "वैशाखस्य चतुर्थ्यां तु रामः पुष्पकमाश्रितः ।\nविहायसा निवृत्तस्तु भूयोऽयोध्यां पुरीं प्रति॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000577073, "chapter_id": 20577, "verse_number": "५-३६-७४", "content_sanskrit": "पूर्णे चतुर्दशे वर्षे पंचम्यां माधवस्य तु ।\nभरद्वाजाश्रमे रामः सगणः समुपाविशत्॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000577074, "chapter_id": 20577, "verse_number": "५-३६-७५", "content_sanskrit": "नंदिग्रामे तु षष्ठ्यां स भरतेन समागतः ।\nसप्तम्यामभिषिक्तोऽसावयोध्यायां रघूद्वहः॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000577075, "chapter_id": 20577, "verse_number": "५-३६-७६", "content_sanskrit": "दशैकाधिकमासांस्तुचतुर्दशाहानि मैथिली ।\nउवास राम रहिता रावणस्य निवेशने॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000577076, "chapter_id": 20577, "verse_number": "५-३६-७७", "content_sanskrit": "द्विचत्वारिंशक वर्षे रामो राज्यमकारयत् ।\nसीतायाश्च त्रयस्त्रिंशद्वत्सराश्च तदाभवन्॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000577077, "chapter_id": 20577, "verse_number": "५-३६-७८", "content_sanskrit": "स चतुर्दशवर्षांते प्रविश्य च पुरीं प्रभुः ।\nअयोध्यां मुदितो रामो हत्वा रावणमाहवे॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000577078, "chapter_id": 20577, "verse_number": "५-३६-७९", "content_sanskrit": "भ्रातृभिः सहितस्तत्र रामो राज्यमथाकरोत् ।\nराज्यं प्रकुर्वतस्तस्य पुरोधा वदतां वरः॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000577079, "chapter_id": 20577, "verse_number": "५-३६-८०", "content_sanskrit": "अगस्त्यः कुंभसंभूतिस्तमागंता रघोः पतिम् ।\nतद्वाक्याद्रघुनाथोऽसौ करिष्यति हयक्रतुम्॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000577080, "chapter_id": 20577, "verse_number": "५-३६-८१", "content_sanskrit": "तस्यागमिष्यति हयो ह्याश्रमे तव सुव्रत ।\nतस्य योधाः प्रमुदिता आयास्यंति तवाश्रमम्॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000577081, "chapter_id": 20577, "verse_number": "५-३६-८२", "content_sanskrit": "तेषामग्रे रामकथाः करिष्यसि मनोहराः ।\nतैः साकं त्वमयोध्यायां गंतासि वै द्विजर्षभ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000577082, "chapter_id": 20577, "verse_number": "५-३६-८३", "content_sanskrit": "दृष्ट्वा राममयोध्यायां पद्मपत्रनिभेक्षणम् ।\nतत्क्षणादेव संसारवार्धिनिस्तारवान्भव॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000577083, "chapter_id": 20577, "verse_number": "५-३६-८४", "content_sanskrit": "इत्युक्त्वा मां मुनिवरो लोमशः सर्वबुद्धिमान् ।\nउवाच ते किं प्रष्टव्यं तदाहमवदं हि तम्॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000577084, "chapter_id": 20577, "verse_number": "५-३६-८५", "content_sanskrit": "ज्ञातं त्वत्कृपया सर्वं रामचारित्रमद्भुतम् ।\nत्वत्प्रसादादवाप्स्येऽहं रामस्य चरणांबुजम्॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000577085, "chapter_id": 20577, "verse_number": "५-३६-८६", "content_sanskrit": "मया नमस्कृतः पश्चाज्जगाम स मुनीश्वरः ।\nतत्प्रसादान्मयावाप्तं रामस्य चरणार्चनम्॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000577086, "chapter_id": 20577, "verse_number": "५-३६-८७", "content_sanskrit": "सोऽहं स्मरामि रामस्य चरणावन्वहं मुहुः ।\nगायामि तस्य चरितं मुहुर्मुहुरतंद्रितः॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000577087, "chapter_id": 20577, "verse_number": "५-३६-८८", "content_sanskrit": "पावयामि जनानन्यान्गानेन स्वांतहारिणा ।\nहृष्यामि तन्मुनेर्वाक्यं स्मारंस्मारं तदीक्षया॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000577088, "chapter_id": 20577, "verse_number": "५-३६-८९", "content_sanskrit": "धन्योऽहं कृतकृत्योऽहं सभाग्योऽहं महीतले ।\nरामचंद्र पदांभोज दिदृक्षा मे भविष्यति॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000577089, "chapter_id": 20577, "verse_number": "५-३६-९०", "content_sanskrit": "तस्मात्सर्वात्मना रामो भजनीयो मनोहरः ।\nवंदनीयो हि सर्वेषां संसाराब्धितितीर्षया॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000577090, "chapter_id": 20577, "verse_number": "५-३६-९१", "content_sanskrit": "तस्माद्यूयं किमर्थं वै प्राप्ताः को वानराधिपः ।\nयागं करोति धर्मात्मा हयमेधं महाक्रतुम्॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000577091, "chapter_id": 20577, "verse_number": "५-३६-९२", "content_sanskrit": "तत्सर्वं कथयंत्वत्र यां तु वाहस्य पालने ।\nस्मरंतु रघुनाथांघ्रिं स्मृत्वा स्मृत्वा पुनः पुनः॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}]