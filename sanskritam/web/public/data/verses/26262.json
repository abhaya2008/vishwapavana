[{"id": 7006262000, "chapter_id": 26262, "verse_number": "३-१६-१", "content_sanskrit": "अथ सा जगतां माता ललिता परमेश्वरी ।\nत्रैलोक्यकण्टकं भण्डं दैत्यं जेतुं विनिर्ययौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006262001, "chapter_id": 26262, "verse_number": "३-१६-२", "content_sanskrit": "चकार मर्दलाकारानंभोराशींस्तु सप्त ते ।\nप्रभूतमर्द्दलध्वानैः पूरयामासुरंबरम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006262002, "chapter_id": 26262, "verse_number": "३-१६-३", "content_sanskrit": "मृदङ्गमुरजाश्चैव पटहोऽतुकुलीङ्गणाः ।\nसेलुकाझल्लरीराङ्घाहुहुकाहुण्डुकाघटाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006262003, "chapter_id": 26262, "verse_number": "३-१६-४", "content_sanskrit": "आनकाः पणवाश्चैव गोमुखाश्चार्धचन्द्रिकाः ।\nयवमध्या मुष्टिमध्या मर्द्दलाडिण्डिमा अपि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006262004, "chapter_id": 26262, "verse_number": "३-१६-५", "content_sanskrit": "झर्झराश्च बरीताश्च इङ्ग्यालिङ्ग्यप्रभेदजाः ।\nउद्धकाश्चैतुहुण्डाश्च निःसाणा बर्बराः परे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006262005, "chapter_id": 26262, "verse_number": "३-१६-६", "content_sanskrit": "हुङ्कारा काकतुण्डाश्च वाद्यभेदास्तथापरे ।\nदध्वनुः शक्तिसेनाभिराहताः समरोद्यमे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006262006, "chapter_id": 26262, "verse_number": "३-१६-७", "content_sanskrit": "ललितापरमेशान्या अङ्कुशास्त्रान्समुद्गता ।\nसंपत्करी नाम देवी चचाल सह शक्तिभिः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006262007, "chapter_id": 26262, "verse_number": "३-१६-८", "content_sanskrit": "अनेककोटिमातङ्गतुरङ्गरथपङ्क्तिभिः ।\nसेविता तरुणादित्यपाटला संपदीश्वरी ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006262008, "chapter_id": 26262, "verse_number": "३-१६-९", "content_sanskrit": "मत्तमुद्दण्डसंग्रामरसिकं शैलसन्निभम् ।\nरणकोलाहलं नाम सारुरोह मतङ्गजम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006262009, "chapter_id": 26262, "verse_number": "३-१६-१०", "content_sanskrit": "तामन्वगा ययौ सेना महती धोरराविणी ।\nलोलाभिः केतुमालाभिरुल्लिखन्ती धनाधनात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006262010, "chapter_id": 26262, "verse_number": "३-१६-११", "content_sanskrit": "तस्याश्च संपन्नाथायाः पीनस्तनसुसंकटः ।\nकण्टको घनसंनाहो रुरुचे वक्षसिस्थितः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006262011, "chapter_id": 26262, "verse_number": "३-१६-१२", "content_sanskrit": "कंपमाना खड्गलता व्यरुचत्तत्करे धृता ।\nकुटिला कालनाथस्य भृकुटीव भयङ्करा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006262012, "chapter_id": 26262, "verse_number": "३-१६-१३", "content_sanskrit": "उत्पातवातसंपाताच्चलिता इव पर्वताः ।\nतामन्वगा ययुः कोटिसंख्याकाः कुञ्जरोत्तमाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006262013, "chapter_id": 26262, "verse_number": "३-१६-१४", "content_sanskrit": "अथ श्रीललितादेव्या श्रीपाशायुधसंभवा ।\nअतित्वरितविक्रान्तिरश्वारूढाचलत्पुरः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006262014, "chapter_id": 26262, "verse_number": "३-१६-१५", "content_sanskrit": "तया सह हयप्रायं सैन्यं हेषातरङ्गितम् ।\nव्यचरत्खुरकुद्दालविदारितमहीतलम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006262015, "chapter_id": 26262, "verse_number": "३-१६-१६", "content_sanskrit": "वनायुजाश्च कांबोजाः पारदाः सिंधुदेशजाः ।\nटङ्कणाः पर्वतीयाश्च पारसीकास्तथा परे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006262016, "chapter_id": 26262, "verse_number": "३-१६-१७", "content_sanskrit": "अजानेया घट्टधरा दरदाः काल वन्दिजाः ।\nवाल्मीकयावनोद्भूता गान्धर्वाश्चाथ ये हयाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006262017, "chapter_id": 26262, "verse_number": "३-१६-१८", "content_sanskrit": "प्राग्देशजाताः कैराता प्रान्तदेशोद्भवास्तथा ।\nविनीताः साधुवोढारो वेगिनः स्थिरचेतसः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006262018, "chapter_id": 26262, "verse_number": "३-१६-१९", "content_sanskrit": "स्वामिचित्तविशेषज्ञा महायुद्धसहिष्णवः ।\nलक्षणैर्बहुभिर्युक्ता जितक्रोधा जितश्रमाः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006262019, "chapter_id": 26262, "verse_number": "३-१६-२०", "content_sanskrit": "पञ्चधारासु शक्षढ्या विनीताश्च प्लवान्विताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006262020, "chapter_id": 26262, "verse_number": "३-१६-२१", "content_sanskrit": "फलशुक्तिश्रिया युक्ताः श्वेतशुक्तिसमन्विताः ।\nदेवपद्मं देवमणिं देवस्वस्तिकमेव च ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006262021, "chapter_id": 26262, "verse_number": "३-१६-२२", "content_sanskrit": "अथ स्वस्तिकशुक्तिश्च गडुरं पुष्पगण्डिकाम् ।\nएतानि शुभलक्ष्माणि ज्यराज्यप्रदानि च ।\nवहन्तो वातजवना वाजिनस्तां समन्वयुः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006262022, "chapter_id": 26262, "verse_number": "३-१६-२३", "content_sanskrit": "अपराजितनामानमतितेजस्विनं चलम् ।\nअत्यन्तोत्तुङ्गवर्ष्माणं कविकाविलसन्मुखम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006262023, "chapter_id": 26262, "verse_number": "३-१६-२४", "content_sanskrit": "पार्श्वद्वयेऽपि पतितस्फुरत्केसरमण्डलम् ।\nस्थूलवालधिविक्षेपक्षिप्यमाणपयोधरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006262024, "chapter_id": 26262, "verse_number": "३-१६-२५", "content_sanskrit": "जङ्घाकाण्डसमुन्नद्धमणिकिङ्किणिभासुरम् ।\nवादयन्तमिवोच्चण्डैः खुरनिष्ठुरकुट्टनैः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006262025, "chapter_id": 26262, "verse_number": "३-१६-२६", "content_sanskrit": "भूमण्डलमहावाद्यं विजयस्य समृद्धये ।\nघोषमाणं प्रति मुहुः संदर्शितगतिक्रमम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006262026, "chapter_id": 26262, "verse_number": "३-१६-२७", "content_sanskrit": "आलोलचामरव्याजाद्वहन्तं पक्षती इव ।\nभाण्डैर्मनोहरैर्युक्तं घर्घरीजालमण्डितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006262027, "chapter_id": 26262, "verse_number": "३-१६-२८", "content_sanskrit": "एषां घोषस्य कपटाद्धुङ्कुर्वतीमि वासुरान् ।\nअश्वारूढा महादेवी समारूढा हयं ययौ ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006262028, "chapter_id": 26262, "verse_number": "३-१६-२९", "content_sanskrit": "चतुर्भिर्वाहुभिः पाशमङ्कुशं वेत्रमेव च ।\nहयवल्गां च दधती बहुविक्रमशोभिनी ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006262029, "chapter_id": 26262, "verse_number": "३-१६-३०", "content_sanskrit": "तरुणादित्यसङ्काशा ज्वलत्काञ्चीतरङ्गिणी ।\nसञ्चचाल हयारूढा नर्तयन्तीव वाजिनम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006262030, "chapter_id": 26262, "verse_number": "३-१६-३१", "content_sanskrit": "अथ श्रीदण्डनाथाया निर्याणपटहध्वनिः ।\nउद्दण्डसिन्धुनिस्वानश्चकार बधिरं जगत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006262031, "chapter_id": 26262, "verse_number": "३-१६-३२", "content_sanskrit": "वज्रबाणैः कठोरैश्चभिन्दन्त्यः ककुभो दश ।\nअन्युद्धतभुजाश्मानः शक्तयः काश्चिदुच्छ्रिताः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006262032, "chapter_id": 26262, "verse_number": "३-१६-३३", "content_sanskrit": "काश्चिच्छ्रीदण्डनाथायाः सेनानासीरसङ्गताः ।\nखड्गं फलकमादाय पुप्लुवुश्चण्डसक्तयः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006262033, "chapter_id": 26262, "verse_number": "३-१६-३४", "content_sanskrit": "अत्यन्तसैन्यसम्बाधं वेत्रसंताडनैः शतैः ।\nनिवारयन्त्यो वेत्रिण्यो व्युच्छलन्ति स्मशक्तयः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7006262034, "chapter_id": 26262, "verse_number": "३-१६-३५", "content_sanskrit": "अथ तुङ्गध्वजश्रेणीर्महिषाङ्का मृगाङ्किकाम् ।\nसिहाङ्काश्चैव बिभ्राणाः शक्तयो व्यचलन्पुरा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7006262035, "chapter_id": 26262, "verse_number": "३-१६-३६", "content_sanskrit": "ततः श्रीदण्डनाथायाः श्वेतच्छत्रं सहस्रशः ।\nस्फुरत्कराः प्रचलिताः शक्तयः काश्चिदाददुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]