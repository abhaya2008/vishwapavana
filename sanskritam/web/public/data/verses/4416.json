[{"id": 2157674, "chapter_id": 4416, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2157675, "chapter_id": 4416, "verse_number": "१", "content_sanskrit": "भारद्वाजेन भग्नेषु पाण्डवेषु महात्मसु ।\nपाञ्चालेषु च सर्वेषु कश्चिन्नान्यो न्यवर्तत\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2157676, "chapter_id": 4416, "verse_number": "", "content_sanskrit": "स एष पुरुषव्याघ्रो यो भग्नेषु निवर्तते ।\nअहो नासीत् पुमान् कश्चिद् द्रोणं दृष्ट्वा व्यवस्थितम्\t।३।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2157677, "chapter_id": 4416, "verse_number": "४", "content_sanskrit": "जृम्भमाणमिव व्याघ्रं प्रभिन्नमिव कुञ्जरम् ।\nत्यजन्तमाहवे प्राणान् सन्नद्धं चित्रयोधिनम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2157678, "chapter_id": 4416, "verse_number": "५", "content_sanskrit": "महेष्वासं नरव्याघ्रं द्विषतां भयवर्धनम् ।\nकृतज्ञं सत्यनिरतं दुर्योधनहितैषिणम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2157679, "chapter_id": 4416, "verse_number": "६", "content_sanskrit": "भारद्वाजं रथानीके शूरं दृष्ट्वा व्यवस्थितम्॥\nके वीराः सन्न्यवर्तन्त तन्ममाचक्ष्व सञ्जय\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2157680, "chapter_id": 4416, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2157681, "chapter_id": 4416, "verse_number": "७", "content_sanskrit": "तान् दृष्ट्वा चलितान् सङ्खे प्रणुन्नान् द्रोणसायकैः ।\nपाञ्चालान् पाण्डवान् मात्स्यान् सृञ्जयांश्च सकेकयान्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2157682, "chapter_id": 4416, "verse_number": "८", "content_sanskrit": "द्रोणचापप्रमुक्तेन शरौघेणासुहारिणा ।\nसिन्धोरिव महौघेन ह्रियमाणान् यथा प्लवान्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2157683, "chapter_id": 4416, "verse_number": "९", "content_sanskrit": "कौरवाः सिंहनादेन नानावाद्यरवेण च ।\nरथद्विपनराश्चैव सर्वतः पर्यवारयन्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2157684, "chapter_id": 4416, "verse_number": "१०", "content_sanskrit": "तान् पश्यन् सैन्यमध्यस्थो राजा स्वजननिर्जितान् ।\nदुर्योधनोऽब्रवीत् कर्णं प्रहृष्टः प्रहसन्निव\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2157685, "chapter_id": 4416, "verse_number": "११", "content_sanskrit": "पश्य राधेय पाञ्चालान् प्रणुन्नान् द्रोणसायकैः ।\nसिंहेनेव मृगानस्त्रैः त्रासितान् दृढधन्वना\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2157686, "chapter_id": 4416, "verse_number": "१२", "content_sanskrit": "नैते जातु पुनर्योद्धुमीहिष्यन्तीति मे मतिः ।\nतथा हि भग्ना द्रोणेन वातेनेव महाद्रुमाः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2157687, "chapter_id": 4416, "verse_number": "१३", "content_sanskrit": "अर्द्यमानाः शरैरेते रुग्मपुङ्खैर्महात्मना ।\nपथा नैकेन गच्छन्ति घूर्णमाना इतस्ततः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2157688, "chapter_id": 4416, "verse_number": "१४", "content_sanskrit": "सन्निरुद्धाश्च कौरव्यैः द्रोणेन च महात्मना ।\nएतेऽन्ये मण्डलीभूताः पावकेनेव कुञ्जराः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2157689, "chapter_id": 4416, "verse_number": "१५", "content_sanskrit": "भ्रमरैरिव चाविष्टा द्रोणस्य निशितैः शरैः ।\nअन्योन्यमवलीयन्ते पलायनपरायणाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2157690, "chapter_id": 4416, "verse_number": "१६", "content_sanskrit": "एष भीमो दृढक्रोधो हीनः पाण्डवसृञ्जयैः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2157691, "chapter_id": 4416, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2157692, "chapter_id": 4416, "verse_number": "१७", "content_sanskrit": "तत्र नादो महानासीद् एकं द्रोणं जिघांसताम् ।\nपाण्डवानां निवृत्तानां नानावर्णैर्हयोत्तमैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2157693, "chapter_id": 4416, "verse_number": "", "content_sanskrit": "कर्णः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2157694, "chapter_id": 4416, "verse_number": "१८", "content_sanskrit": "नैष जातु महाबाहुः जीवन्नाहवमुत्सृजेत् ।\nन चेमान् पुरुषव्याघ्रः सिंहनादान् सहिष्यते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2157695, "chapter_id": 4416, "verse_number": "१९", "content_sanskrit": "न चापि पाण्डवा युद्धे भज्येरन्निति मे मतिः ।\nशूराश्च बलवन्तश्च कृतास्त्रा युद्धदुर्मदाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2157696, "chapter_id": 4416, "verse_number": "२०", "content_sanskrit": "विषाग्निद्यूतसङ्क्लेशान् वनवासं च पाण्डवाः ।\nस्मरमाणा न हास्यन्ति सङ्ग्राममिति मे मतिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2157697, "chapter_id": 4416, "verse_number": "२१", "content_sanskrit": "आवृतोऽपि महाबाहुरमितौजा वृकोदरः ।\nवरान् वरान् हि कौन्तेयो रथोदारान् वधिष्यति\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2157698, "chapter_id": 4416, "verse_number": "२२", "content_sanskrit": "असिना धनुषा शक्त्या रथैर्नागैर्हयैर्नरैः ।\nआयसेन च दण्डेन प्राप्तान् प्राप्तान् हनिष्यति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2157699, "chapter_id": 4416, "verse_number": "२३", "content_sanskrit": "त इमे विनिवर्तन्ते सात्यकिप्रमुखा रथाः ।\nपाञ्चालाः केकया मत्स्याः पाण्डवाश्च विशेषतः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2157700, "chapter_id": 4416, "verse_number": "२४", "content_sanskrit": "शूराश्च बलवन्तश्च विक्रान्ताश्च महारथाः ।\nविशेषतश्च भीमेन संरब्धेनाभिचोदिताः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2157701, "chapter_id": 4416, "verse_number": "२५", "content_sanskrit": "तं द्रोणमभिवर्तन्ते सिंहं मोहान्मृगा इव ।\nवृकोदरं परीप्सन्तः सूर्यं कृष्णघना इव\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2157702, "chapter_id": 4416, "verse_number": "२६", "content_sanskrit": "समरेषु तु निर्दिष्टाः पाण्डवाः कृष्णबान्धवाः ।\nपाञ्चालाः केकया मत्स्याः पाण्डवेयाश्च सर्वशः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2157703, "chapter_id": 4416, "verse_number": "२७", "content_sanskrit": "शूराश्च बलवन्तश्च विक्रान्ताश्च महारथाः ।\nह्रीमन्तः शत्रुमरणे निपुणाः पुण्यलक्षणाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2157704, "chapter_id": 4416, "verse_number": "२८", "content_sanskrit": "बहवः पार्थिवा राजन् तेषां वशगता रणे ।\nमाऽवमंस्थाः पाण्डवांस्त्वं नारायणपुरोगमान्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2157705, "chapter_id": 4416, "verse_number": "२९", "content_sanskrit": "एकायनगतास्त्वेते पीडयेयुर्यतव्रतम् ।\nअरक्ष्यमाणं शलभा यथा दीपं मुमूर्षवः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2157706, "chapter_id": 4416, "verse_number": "३०", "content_sanskrit": "असंशयं कृतास्त्राश्च पर्याप्ताश्चारिनिग्रहे ।\nअतिभारं त्विमं मन्ये भारद्वाजे समाहितम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2157707, "chapter_id": 4416, "verse_number": "३१", "content_sanskrit": "ते शीघ्रमनुगच्छामो यत्र द्रोणो व्यवस्थितः ।\nकाका इव महानागं मा च हन्युर्महारथम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2157708, "chapter_id": 4416, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2157709, "chapter_id": 4416, "verse_number": "३२", "content_sanskrit": "कर्णस्य तु वचः श्रुत्वा राजा दुर्योधनस्तथा ।\nभ्रातृभिः सहितो वीरैः प्रायाद् द्रोणरथं प्रति\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2157710, "chapter_id": 4416, "verse_number": "३३", "content_sanskrit": "तत्र नादो महानासीदेकं द्रोणं जिघांसताम् ।\nपाण्डवानां निवृत्तानां नानावर्णैर्हयोत्तमैः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2157711, "chapter_id": 4416, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि एकविंशोऽध्यायः ॥ २१ ॥\nसंशप्तकवधपर्वणि षष्ठोऽध्यायः ॥ ६ ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]