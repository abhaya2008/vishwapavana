[{"id": 7003144000, "chapter_id": 23144, "verse_number": "४-८०-१", "content_sanskrit": "अथाशोतितमोऽध्यायः ।\nश्रीकृष्ण उवाच ।\nपुरा तारा गुरोः पत्नी नवयौवनसंयुता ।\nरत्नभूषणभूषाढ्या वरसूक्ष्माम्बरा सती ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003144001, "chapter_id": 23144, "verse_number": "४-८०-२", "content_sanskrit": "सुश्रोणी सस्मिता रम्य सुन्दरी सुमनोहरा ।\nअतीव कबरीरम्या मालतीमाल्यभूषिता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003144002, "chapter_id": 23144, "verse_number": "४-८०-३", "content_sanskrit": "मिन्दूरबिन्दुना साकं चारुचंदनबिन्दुभि। ।\nकस्तूरीबिन्दुनाऽधश्च भालमध्यस्थलोज्ज्वला ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003144003, "chapter_id": 23144, "verse_number": "४-८०-४", "content_sanskrit": "रत्नेन्द्रसारनिर्माणक्वणन्मञ्जीररञ्जिता ।\nसुवक्रलोचना श्यामा सुचारुकज्जलोज्ज्वला ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003144004, "chapter_id": 23144, "verse_number": "४-८०-५", "content_sanskrit": "सुचारुसारमुक्ताभदन्तपङ्क्तिमनोहरा ।\nरत्नकुण्डलयुग्मेन चारुगण्डस्थलोज्ज्वला ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003144005, "chapter_id": 23144, "verse_number": "४-८०-६", "content_sanskrit": "कामिनीष्वतुला बाला गजेन्द्रमन्दगामिनी ।\nसुकोमला चन्द्रमुखी कामाधारा च कामुकी ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003144006, "chapter_id": 23144, "verse_number": "४-८०-७", "content_sanskrit": "स्वर्गमन्दाकिनीतीरे स्नाता स्निग्धाम्बरा वरा ।\nध्यायन्ती गुरुपादं सा स्वगृहं गमनोन्मुखी ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003144007, "chapter_id": 23144, "verse_number": "४-८०-८", "content_sanskrit": "दृष्ट्वा तस्याश्च सर्वाङ्गमनङ्गबाणपीडितः ।\nभाद्रे चतुर्थ्यां चन्द्रश्च जहार चेतनां व्रज ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003144008, "chapter_id": 23144, "verse_number": "४-८०-९", "content_sanskrit": "ज्ञानं क्षणेन संप्राप्य रथस्थो रमिको बली ।\nरथमारोहयामास करे धृत्वा च तारकम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003144009, "chapter_id": 23144, "verse_number": "४-८०-१०", "content_sanskrit": "कामोन्मत्तः कामिनीं तां समाश्लिष्य चुचुम्ब च ।\nशृङ्गारं कर्तुमुद्युक्तं तमुवाच गुरुप्रिया ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003144010, "chapter_id": 23144, "verse_number": "४-८०-११", "content_sanskrit": "तारकोवाच ।\nत्यज मां त्यज मां चन्द्र सुरेषु कुलपांसन ।\nगुरुपत्नीं ब्राह्मणीं च पातिव्रत्यपरायणाम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003144011, "chapter_id": 23144, "verse_number": "४-८०-१२", "content_sanskrit": "गुरुपत्नीसंगमने ब्रह्महत्याशतं भवेत् ।\nगुरुपत्नी विप्रपत्नी यदि सा च पतिव्रता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003144012, "chapter_id": 23144, "verse_number": "४-८०-१३", "content_sanskrit": "ब्रह्महत्यासहस्रं च तस्याः संगमने लभेत् ।\nपुत्रस्त्वं तव माताऽहं धैर्य कुरु सुरेश्वार ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003144013, "chapter_id": 23144, "verse_number": "४-८०-१४", "content_sanskrit": "धिक्त्वां श्रुत्वा सुरगुरुर्भस्मीभूतं करिष्यति ।\nपुत्राधिकश्च शिष्यश्च प्रियो मत्स्वामिनो भवान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003144014, "chapter_id": 23144, "verse_number": "४-८०-१५", "content_sanskrit": "स्वधर्म रक्ष पापिष्ठ मामेवं मातरं त्यज ।\nदास्यामि स्त्रीवधं तुम्यं यदिमां संग्रहीष्यसि ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003144015, "chapter_id": 23144, "verse_number": "४-८०-१६", "content_sanskrit": "विलङ्ध्य तारावचनं तां च संभोक्तुमुद्यतम् ।\nशशाप तारा कोपेन निष्कामा सा पतिव्रता ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003144016, "chapter_id": 23144, "verse_number": "४-८०-१७", "content_sanskrit": "राहुग्रस्तो घनग्रस्तः पापदृश्यो भवान्भव ।\nकलङ्की यक्ष्मणा ग्रस्तो भविष्यसि न संशयः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003144017, "chapter_id": 23144, "verse_number": "४-८०-१८", "content_sanskrit": "चन्द्रं शप्त्वा तदा तूर्ण कामदेवं शशाप सा ।\nतेजस्विना केनचित्त्वं भस्मीभूतो भविष्यसि ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003144018, "chapter_id": 23144, "verse_number": "४-८०-१९", "content_sanskrit": "चन्द्रस्तारां गृहीत्वा च कृत्वाऽपि रमणं व्रज ।\nक्रोडेनिधाय प्रययौ रुदतीं ता शुचाऽन्विताम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003144019, "chapter_id": 23144, "verse_number": "४-८०-२०", "content_sanskrit": "निर्जने निर्जने रम्ये शैले शैले मनोहरे ।\nसरोनदनदीनां च तीरे तीरे मनोहरे ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003144020, "chapter_id": 23144, "verse_number": "४-८०-२१", "content_sanskrit": "मधुव्रतपिकोक्ते च पुष्पोद्याने सुपुष्पिते ।\nरम्यायां पुष्पशथ्यायां स रेमे रामया सह ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003144021, "chapter_id": 23144, "verse_number": "४-८०-२२", "content_sanskrit": "चदनोक्षितसर्वाङ्गो मधुपानरतः सुरः ।\nसुखसंभोगसंसक्तो बुबुधे न दिवानिशम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003144022, "chapter_id": 23144, "verse_number": "४-८०-२३", "content_sanskrit": "मलये मलयारण्ये मलयानिलसंयुते ।\nस्यन्दने चन्दनवने पश्चिमोदधिसंनिधौ ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003144023, "chapter_id": 23144, "verse_number": "४-८०-२४", "content_sanskrit": "त्रिकूटे वटमूले च तत्र चन्द्रसरोवरे ।\nसुचारुशतपत्राणां पत्रे चन्दनचर्चिते ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003144024, "chapter_id": 23144, "verse_number": "४-८०-२५", "content_sanskrit": "सुचारुचम्पकोद्याने चम्पकानिलपूजिते ।\nक्षीरोदकाञ्चनीभूमौ क्रौञ्चकाञ्चनपर्वते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003144025, "chapter_id": 23144, "verse_number": "४-८०-२६", "content_sanskrit": "रत्नशैले मणिमये मणिमन्दिरसुन्दरे ।\nमाणिक्यमुक्तासारेण हीरहारेण शोभिते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003144026, "chapter_id": 23144, "verse_number": "४-८०-२७", "content_sanskrit": "सुचारुवस्त्रचित्राढ्ये श्वेतचामारदर्पणैः ।\nभूषिते रत्नदीपैश्च देवक्रीडे प्रियस्थले ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003144027, "chapter_id": 23144, "verse_number": "४-८०-२८", "content_sanskrit": "वारुणीं मदिरां पीत्वा वरुणानीसमन्वितः ।\nबरुणो रमते यत्र तत्र रेमे तया सह ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003144028, "chapter_id": 23144, "verse_number": "४-८०-२९", "content_sanskrit": "पावने पवनोद्याने परिजातानिलेन च ।\nसुगन्धिमोहिते रत्नमालातीरे च निर्मले ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003144029, "chapter_id": 23144, "verse_number": "४-८०-३०", "content_sanskrit": "ऋक्षशैले कल्पवृक्षवने वह्निप्रियाश्रमे ।\nपपौ च कामधेनूनां क्षीरं क्षीरोदधेस्तटे ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003144030, "chapter_id": 23144, "verse_number": "४-८०-३१", "content_sanskrit": "वह्निशुद्धांशुकयुगं वह्निस्तस्मै ददौ मुदा ।\nवरुणो रत्नमालां च नत्नच्छत्रं समीरणः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003144031, "chapter_id": 23144, "verse_number": "४-८०-३२", "content_sanskrit": "तत्र दृष्ट्वाऽसुरगुरं बलिगेहात्समागतम् ।\nप्रणम्य सर्वमुक्त्वा च चन्द्रस्तं शरणं ययौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003144032, "chapter_id": 23144, "verse_number": "४-८०-३३", "content_sanskrit": "शुक्रस्तं बोधयामास वचनं नीतियुक्तितः ।\nनिरपेक्षो सुनिश्रेष्ठो वेदवेदाङ्गपारगः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003144033, "chapter_id": 23144, "verse_number": "४-८०-३४", "content_sanskrit": "शुक्र उवाच ।\nशृणु वत्स प्रवक्ष्यामि गुरवे देहि तारकाम् ।\nशंभोश्च सुरुपुत्राय पौत्राय ब्रह्मणश्च वै ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003144034, "chapter_id": 23144, "verse_number": "४-८०-३५", "content_sanskrit": "पूजिताय सुरार्णा च देया तस्मै निशापते ।\nप्रियाय तत्प्रिर्यां दत्तवा शीघ्रं त्वं शरणं व्रज ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003144035, "chapter_id": 23144, "verse_number": "४-८०-३६", "content_sanskrit": "गुरुपत्नीं मातृतुल्यां त्यज सद्वचनाद्विधो ।\nकुरु पापक्षयं पापनिवृत्तिस्तु महाफला ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003144036, "chapter_id": 23144, "verse_number": "४-८०-३७", "content_sanskrit": "सतीनां गुरुपत्नीर्नां ग्रहणे च बलेन च ।\nब्रह्महत्यासहस्रार्णां पातकं लभते जनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003144037, "chapter_id": 23144, "verse_number": "४-८०-३८", "content_sanskrit": "कुम्भीपाके च पच्यन्ते यावद्वै ब्रह्मणः शतम् ।\nसाम्यं नारायणस्थाने तृणपर्वतयोः सुर ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003144038, "chapter_id": 23144, "verse_number": "४-८०-३९", "content_sanskrit": "कस्त्वं वत्स हरेः स्थाने कर्मभोगोऽस्ति ब्रह्मणः ।\nनारायणाश्रीताः सर्वे जीविनस्त्रिविधा भवे ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]