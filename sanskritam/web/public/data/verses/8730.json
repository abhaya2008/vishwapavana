[{"id": 900009147, "chapter_id": 8730, "verse_number": "20.1", "content_sanskrit": "किं च त्वन्मतेऽपि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900009148, "chapter_id": 8730, "verse_number": "20.2", "content_sanskrit": "न च घटत्वं संस्थानरूपावयवसंयोगवृत्तीति ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900009149, "chapter_id": 8730, "verse_number": "20.3", "content_sanskrit": "ननु च– ज्ञेयत्वादीनि..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900009150, "chapter_id": 8730, "verse_number": "20.4", "content_sanskrit": "किं चात्यन्तव्यावृत्तैकस्वभावेष्वन्त्यविशेषेषु ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}]