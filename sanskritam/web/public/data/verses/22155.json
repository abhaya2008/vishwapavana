[{"id": 7002155000, "chapter_id": 22155, "verse_number": "२००-१", "content_sanskrit": "अग्निरुवाच ।\nदीपदानव्रतं वक्ष्ये भुक्तिमुक्तिप्रदायकं ।\nदेवद्विजातिकगृहे दीपदोऽब्दं स सर्वभाक् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002155001, "chapter_id": 22155, "verse_number": "२००-२", "content_sanskrit": "चतुर्मासं विष्णुलोकी कार्त्तिके स्वर्गलोक्यपि ।\nदीपदानात्परं नास्ति न भूतं न भविष्यति ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002155002, "chapter_id": 22155, "verse_number": "२००-३", "content_sanskrit": "दीपेनायुष्यचक्षुष्मान्दीपाल्लक्ष्मीसुतादिकं ।\nसौभाग्यं दीपदः प्राप्य स्वर्गलोके महीयते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002155003, "chapter_id": 22155, "verse_number": "२००-४", "content_sanskrit": "विदर्भराजदुहिता ललिता दीपदात्मभाक् ।\nचारुधर्मक्ष्मापपत्नी शतभार्याधिकाभवत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002155004, "chapter_id": 22155, "verse_number": "२००-५", "content_sanskrit": "ददौ दीपसहस्रं सा विष्णोरायतने सती ।\nपृष्टा सा दीपमाहात्म्यं सपत्नीभ्य उवाच ह ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002155005, "chapter_id": 22155, "verse_number": "२००-६", "content_sanskrit": "ललितोवाच ।\nसौवीरराजस्य पुरा मैत्रेयोऽभूत्पुरोहितः ।\nतेन चायतनं विष्णोः कारितं देविकातटे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002155006, "chapter_id": 22155, "verse_number": "२००-७", "content_sanskrit": "कार्त्तिके दीपकस्तेन दत्तः सम्प्रेरितो मया ।\nवक्त्रप्रान्तेन नश्यन्त्या मार्जारस्य तदा भयात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002155007, "chapter_id": 22155, "verse_number": "२००-८", "content_sanskrit": "निर्वाणवान् प्रदीप्तोऽभूद्वर्त्या मूषिकया तदा ।\nमृता राजात्मजा जाता राजपत्नी शताधिका ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002155008, "chapter_id": 22155, "verse_number": "२००-९", "content_sanskrit": "असङ्कल्पितमप्यस्य प्रेरणं यत्कृतं मया ।\nविष्ण्वायतनदीपस्य तस्येदं भुज्यते फलं ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002155009, "chapter_id": 22155, "verse_number": "२००-१०", "content_sanskrit": "जातिस्मरा ह्यतो दीपान् प्रयच्छामि त्वहर्निशं ।\nएकदश्यां दीपदो वै विमाने दिवि मोदते ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002155010, "chapter_id": 22155, "verse_number": "२००-११", "content_sanskrit": "जायते दीपहर्ता तु मूको वा जड एव च ।\nअन्धे तमसि दुष्पारे नरके पतते किल ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002155011, "chapter_id": 22155, "verse_number": "२००-१२", "content_sanskrit": "विक्रोशमानांश्च नरान् यमकिङ्कराहतान् ।\nविलापैरलमत्रापि किं वो विलपिते फलं ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002155012, "chapter_id": 22155, "verse_number": "२००-१३", "content_sanskrit": "यदा प्रमादिभिः पूर्वमत्यन्तसमुपेक्षितः ।\nजन्तुर्जन्मसहस्रेभ्यो ह्येकस्मिन्मानुषो यदि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002155013, "chapter_id": 22155, "verse_number": "२००-१४", "content_sanskrit": "तत्राप्यतिविमूढात्मा किं भोगानभिधावति ।\nस्वहितं विषयास्वादैः क्रन्दनं तदिहागतं ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002155014, "chapter_id": 22155, "verse_number": "२००-१५", "content_sanskrit": "भुज्यते च कृतं पूर्वमेतत्किं वो न चिन्तितं ।\nपरस्त्रीषु कुचाभ्यङ्गं प्रीतये दुःखदं हि वः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002155015, "chapter_id": 22155, "verse_number": "२००-१६", "content_sanskrit": "मुहूर्तविषयास्वादोऽनेककोट्यब्ददुःखदः ।\nपरस्त्रीहारि यद्गीतं हा मातः किं विलप्यते ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002155016, "chapter_id": 22155, "verse_number": "२००-१७", "content_sanskrit": "कोऽतिभारो हरेर्नाम्नि जिह्वया परिकीर्तने ।\nवर्तितैलेऽल्पमूल्येऽपि यदग्निर्लभ्यते सदा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002155017, "chapter_id": 22155, "verse_number": "२००-१८", "content_sanskrit": "दानाशक्तैर्हरेर्दीपो हृतस्तद्वोऽस्ति दुःखदं ।\nइदानीं किं विलापेन सहध्वं यदुपागतं ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002155018, "chapter_id": 22155, "verse_number": "२००-१९", "content_sanskrit": "अग्निरुवाच ।\nललितोक्तञ्च ताः श्रुत्वा दीपदानाद्दिवं ययुः ।\nतस्माद्दीपप्रदानेन व्रतानामधिकं फलं ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]