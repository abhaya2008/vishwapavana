[{"id": 5000637000, "chapter_id": 9637, "verse_number": "७-१०२-१", "content_sanskrit": "तच्छ्रुत्वा हर्षमापेदे राघवो भ्रातृभिः सह ।\nवाक्यं चाद्भुतसङ्काशं तदा प्रोवाच लक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000637001, "chapter_id": 9637, "verse_number": "७-१०२-२", "content_sanskrit": "इमौ कुमारौ सौमित्रे तव धर्मविशारदौ ।\nअङ्गदश्चन्द्रकेतुश्च राज्यार्थे दृढविक्रमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000637002, "chapter_id": 9637, "verse_number": "७-१०२-३", "content_sanskrit": "इमौ राज्ये ऽभिषेक्ष्यामि देशः साधु विधीयताम् ।\nरमणीयो ह्यसम्बाधो रमेतां यत्र धन्विनौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000637003, "chapter_id": 9637, "verse_number": "७-१०२-४", "content_sanskrit": "न राज्ञो यत्र पीडा स्यान्नाश्रमाणां विनाशनम् ।\nस देशो दृश्यतां सौम्य नापराध्यामहे यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000637004, "chapter_id": 9637, "verse_number": "७-१०२-५", "content_sanskrit": "तथोक्तवति रामे तु भरतः प्रत्युवाच ह ।\nअयं कारुपथो देशो रमणीयो निरामयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000637005, "chapter_id": 9637, "verse_number": "७-१०२-६", "content_sanskrit": "निवेश्यतां तत्र पुरमङ्गदस्य महात्मनः ।\nचन्द्रकेतोः सुरुचिरं चन्द्रकान्तं निरामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000637006, "chapter_id": 9637, "verse_number": "७-१०२-७", "content_sanskrit": "तद्वाक्यं भरतेनोक्तं प्रतिजग्राह राघवः ।\nतं च कृत्वा वशे देशमङ्गदस्य न्यवेशयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000637007, "chapter_id": 9637, "verse_number": "७-१०२-८", "content_sanskrit": "अङ्गदीया पुरी रम्याप्यङ्गदस्य निवेशिता ।\nरमणीया सुगुप्ता च रामेणाक्लिष्टकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000637008, "chapter_id": 9637, "verse_number": "७-१०२-९", "content_sanskrit": "चन्द्रकेतोश्च मल्लस्य मल्लभूम्यां निवेशिता ।\nचन्द्रकान्तेति विख्याता दिव्या स्वर्गपुरी यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000637009, "chapter_id": 9637, "verse_number": "७-१०२-१०", "content_sanskrit": "ततो रामः परां प्रीतिं लक्ष्मणो भरतस्तथा ।\nययुर्युद्धे दुराधर्षा अभिषेकं च चक्रिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000637010, "chapter_id": 9637, "verse_number": "७-१०२-११", "content_sanskrit": "अभिषिच्य कुमारौ स प्रस्थापयति राघवः ।\nअङ्गदं पश्चिमां भूमिं चन्द्रकेतुमुदङ्मुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000637011, "chapter_id": 9637, "verse_number": "७-१०२-१२", "content_sanskrit": "अङ्गदं चापि सौमित्रिर्लक्ष्मणो ऽनुजगाम ह ।\nचन्द्रकेतोस्तु भरतः पार्ष्णिग्राहो बभूव ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000637012, "chapter_id": 9637, "verse_number": "७-१०२-१३", "content_sanskrit": "लक्ष्मणस्त्वङ्गदीयायां संवत्सरमथोषितः ।\nपुत्रे स्थिते दुराधर्षे अयोध्यां पुनरागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000637013, "chapter_id": 9637, "verse_number": "७-१०२-१४", "content_sanskrit": "भरतो ऽपि तथैवोष्य संवत्सरमतो ऽधिकम् ।\nअयोध्यां पुनरागम्य रामपादावुपास्त सः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000637014, "chapter_id": 9637, "verse_number": "७-१०२-१५", "content_sanskrit": "उभौ सौमित्रिभरतौ रामपादावनुव्रतौ ।\nकालं गतमपि स्नेहान्न जज्ञाते ऽतिधार्मिकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000637015, "chapter_id": 9637, "verse_number": "७-१०२-१६", "content_sanskrit": "एवं वर्षसहस्राणि दश तेषां ययुस्तदा ।\nधर्मे प्रयतमानानां पौरकार्येषु नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000637016, "chapter_id": 9637, "verse_number": "७-१०२-१७", "content_sanskrit": "विहृत्य कालं परिपूर्णमानसाः श्रिया वृता धर्मपुरे सुसंस्थिताः ।\nत्रयः समिद्धा इव दीप्ततेजसो महाध्वरे साधु हुतास्त्रयो ऽग्नयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000637017, "chapter_id": 9637, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे व्द्युत्तरशततमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]