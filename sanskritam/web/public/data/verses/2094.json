[{"id": 2049865, "chapter_id": 2094, "verse_number": "७-२१-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2049866, "chapter_id": 2094, "verse_number": "७-२१-१", "content_sanskrit": "ततो युधिष्ठिरो द्रोणं दृष्ट्वान्तिकमुपागतम्।\nमहता शरवर्षेण प्रत्यगृह्णादभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2049867, "chapter_id": 2094, "verse_number": "७-२१-२", "content_sanskrit": "ततो हलहलाशब्द आसीद्यौधिष्ठिरे बले।\nजिघृक्षति महासिंहे गजानामिव यूथपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2049868, "chapter_id": 2094, "verse_number": "७-२१-३", "content_sanskrit": "दृष्ट्वा द्रोणं ततः शूरः सत्यजित्सत्यविक्रमः।\nयुधिष्ठिरमभिप्रेप्सुराचार्यं समुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2049869, "chapter_id": 2094, "verse_number": "७-२१-४", "content_sanskrit": "तत आचार्यपाञ्चाल्यौ युयुधाते महाबलौ।\nविक्षोभयन्तौ तत्सैन्यमिन्द्रवैरोचनाविव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2049870, "chapter_id": 2094, "verse_number": "७-२१-५", "content_sanskrit": "ततो द्रोणं महेष्वासः सत्यजित्सत्यविक्रमः।\nअविध्यन्निशिताग्रेण परमास्त्रं विदर्शयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2049871, "chapter_id": 2094, "verse_number": "७-२१-६", "content_sanskrit": "तथास्य सारथेः पञ्च शरान्सर्पविषोपमान्।\nअमुञ्चदन्तकप्रख्यान्संमुमोहास्य सारथिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2049872, "chapter_id": 2094, "verse_number": "७-२१-७", "content_sanskrit": "अथास्य सहसाऽविध्यद्धयान्दशभिराशुगैः।\nदशभिर्दशभिः क्रुद्ध उभौ च पार्ष्णिसारथी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2049873, "chapter_id": 2094, "verse_number": "७-२१-८", "content_sanskrit": "मण्डलं तु समावृत्य विचरन्पृतनामुखे।\nध्वजं चिच्छेद च क्रुद्धो द्रोणस्यामित्रकर्षणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2049874, "chapter_id": 2094, "verse_number": "७-२१-९", "content_sanskrit": "द्रोणस्तु तत्समालोक्य चरितं तस्य संयुगे।\nमनसा चिन्तयामास प्राप्तकालमरिन्दमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2049875, "chapter_id": 2094, "verse_number": "७-२१-१०", "content_sanskrit": "ततः सत्यजितं तीक्ष्णैर्दशभिर्मर्मभेदभिः।\nअविध्यच्छीघ्रमाचार्यश्छित्त्वाऽस्य सशरं धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2049876, "chapter_id": 2094, "verse_number": "७-२१-११", "content_sanskrit": "स शीघ्रतरमादाय धनुरन्यत्प्रतापवान्।\nद्रोणमब्यहनद्राजंस्त्रिंशता कङ्कपत्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2049877, "chapter_id": 2094, "verse_number": "७-२१-१२", "content_sanskrit": "दृष्ट्वा सत्यजिता द्रोणं ग्रस्यमानमिवाहवे।\nवृकः शरशतैस्तीक्ष्णैः पाञ्चाल्यो द्रोणमार्दयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2049878, "chapter_id": 2094, "verse_number": "७-२१-१३", "content_sanskrit": "सञ्छाद्यमानं समरे द्रोणं दृष्ट्वा महारथम्।\nचुक्रुशुः पाण्डवा राजन्वस्त्राणि दुधुवुश्च ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2049879, "chapter_id": 2094, "verse_number": "७-२१-१४", "content_sanskrit": "वृकस्तु परमक्रुद्धो द्रोणं षष्ट्या स्तनान्तरे।\nविव्याध बलवान्राजंस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2049880, "chapter_id": 2094, "verse_number": "७-२१-१५", "content_sanskrit": "द्रोणस्तु शरवर्षेण च्छाद्यमानो महारथः।\nवेगं चक्रे महावेगः क्रोधादुद्वृत्य चक्षुषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2049881, "chapter_id": 2094, "verse_number": "७-२१-१६", "content_sanskrit": "ततः सत्यजितश्चापं छित्त्वा द्रोणो वृकस्य च।\nषड्भिः ससूतं सहयं शरैर्द्रोणोऽवधीद्वृकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2049882, "chapter_id": 2094, "verse_number": "७-२१-१७", "content_sanskrit": "अथान्यद्धनुरादाय सत्यजिद्वेगवत्तरम्।\nसाश्वं ससूतं विशिखैर्द्रोणं विव्याध सध्वजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2049883, "chapter_id": 2094, "verse_number": "७-२१-१८", "content_sanskrit": "स तन्न ममृषे द्रोणः पाञ्चाल्येनार्दितो मृधे।\nततस्तस्य विनाशाय सत्वरं व्यसृजच्छरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2049884, "chapter_id": 2094, "verse_number": "७-२१-१९", "content_sanskrit": "हयान्ध्वजं धनुर्मुष्टिमुभौ च पार्ष्णिसारथी।\nअवाकिरत्ततो द्रोणः शरवर्षैः सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2049885, "chapter_id": 2094, "verse_number": "७-२१-२०", "content_sanskrit": "तथा सञ्छिद्यमानेषु कार्मुकेषु पुनःपुनः।\nपाञ्चाल्यः परमास्त्रज्ञः शोणाश्वं समयोधयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2049886, "chapter_id": 2094, "verse_number": "७-२१-२१", "content_sanskrit": "स सत्यजितमालोक्य तथोदीर्णं महाहवे।\nअर्धचन्द्रेण चिच्छेद शिरस्तस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2049887, "chapter_id": 2094, "verse_number": "७-२१-२२", "content_sanskrit": "तस्मिन्हते महामात्रे पाञ्चालानां महारथे।\nअपायाज्जवनैरश्वैर्द्रोणात्त्रस्तो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2049888, "chapter_id": 2094, "verse_number": "७-२१-२३", "content_sanskrit": "पाञ्चालाः केकया मात्स्याश्चेदिकारूशकोसलाः।\nयुधिष्ठिरमभीप्सन्तो दृष्ट्वा द्रोणमुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2049889, "chapter_id": 2094, "verse_number": "७-२१-२४", "content_sanskrit": "ततो युधिष्ठिरं प्रेप्सुराचार्यः शत्रुपूगहा।\nव्यधमत्तान्यनीकानि तूलराशिमिवानलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2049890, "chapter_id": 2094, "verse_number": "७-२१-२५", "content_sanskrit": "निर्दहन्तमनीकानि तानि तानि पुनःपुनः।\nद्रोणं मत्स्यादवरजः शतानीकोऽभ्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2049891, "chapter_id": 2094, "verse_number": "७-२१-२६", "content_sanskrit": "सूर्यरश्मिप्रतीकाशैः कर्मारपरिमार्जितैः।\nषड्भिः ससूतं सहयं द्रोणं विद्ध्वाऽनदद्भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2049892, "chapter_id": 2094, "verse_number": "७-२१-२७", "content_sanskrit": "क्रूराय कर्मणे युक्तश्चिकीर्षुः कर्म दुष्करम्।\nअवाकिरच्छरशतैर्भारद्वाजं महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2049893, "chapter_id": 2094, "verse_number": "७-२१-२८", "content_sanskrit": "तस्य नानदतो द्रोणः शिरः कायात्सकुण्डलम्।\nक्षुरेणापाहरत्तुर्णं ततो मत्स्याः प्रदुद्रुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2049894, "chapter_id": 2094, "verse_number": "७-२१-२९", "content_sanskrit": "मत्स्याञ्जित्वाऽजयच्चेदीन्करूशान्केकयानपि।\nपाञ्चालान्सृञ्जयान्पाण्डून्भारद्वाजः पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2049895, "chapter_id": 2094, "verse_number": "७-२१-३०", "content_sanskrit": "तं दहन्तमनीकानि क्रुद्धमग्निं यथा वनम्।\nदृष्ट्वा रुक्मरथं वीरं समकम्पन्त सृञ्जयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2049896, "chapter_id": 2094, "verse_number": "७-२१-३१", "content_sanskrit": "उभाभ्यां सन्दधानस्य धनुरस्याशुकारिणः।\nज्याघोषो निघ्नतोऽमित्रान्दिक्षुसर्वासु शुश्रुवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2049897, "chapter_id": 2094, "verse_number": "७-२१-३२", "content_sanskrit": "नागानश्वान्पदातींश्च रथिनो गजसादिनः।\nरौद्रा हस्तवता मुक्ताः प्रमथ्नन्ति स्म सायकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2049898, "chapter_id": 2094, "verse_number": "७-२१-३३", "content_sanskrit": "नानद्यमानः पर्जन्यो मिश्रवातो हिमात्यये।\nअश्मवर्षमिवावर्षन्परेषां भयमादधत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2049899, "chapter_id": 2094, "verse_number": "७-२१-३४", "content_sanskrit": "सर्वा दिशः समचरत्सैन्यं विक्षोभयन्निव।\nबली शूरो महेष्वासो मित्राणामभयङ्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2049900, "chapter_id": 2094, "verse_number": "७-२१-३५", "content_sanskrit": "तस्य विद्युदिवाभ्रेषु चापं हेमपरिष्कृतम्।\nदिक्षु सर्वासु पश्यामो द्रोणस्यामिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2049901, "chapter_id": 2094, "verse_number": "७-२१-३६", "content_sanskrit": "शोभमानां ध्वजे चास्य वेदीमद्राक्ष्य भारत।\nहिमवच्छिखराकारं चरतः संयुगे भृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2049902, "chapter_id": 2094, "verse_number": "७-२१-३७", "content_sanskrit": "द्रोणस्तु पाण्डवानीके चकार कदनं महत्।\nयथा दैत्यगणे विष्णुः सुरासुरनमस्कृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2049903, "chapter_id": 2094, "verse_number": "७-२१-३८", "content_sanskrit": "स शूरः सत्यवाक्प्राज्ञो बलवान्सत्यविक्रमः।\nमहानुभावः कल्पान्ते रौद्रां भीरुविभीषणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2049904, "chapter_id": 2094, "verse_number": "७-२१-३९", "content_sanskrit": "कवचोर्मिध्वजावर्तां मर्त्यकूलापहारिणीम्॥\nगजवाजिमहाग्राहामसिमीनां दुरासदाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2049905, "chapter_id": 2094, "verse_number": "७-२१-४०", "content_sanskrit": "वीरास्यिशर्करां रौद्रां भेरीमुरजकच्छपाम्।\nचर्मवर्मप्लवां घोरां केशशैवलशाद्वलाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2049906, "chapter_id": 2094, "verse_number": "७-२१-४१", "content_sanskrit": "शरौघिणीं धनुःस्रोतां बाहुपन्नगसङ्कुलाम्।\nरणभूमिवहां तीव्रां कुरुसृञ्जयवाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2049907, "chapter_id": 2094, "verse_number": "७-२१-४२", "content_sanskrit": "मनुष्यशीर्षपाषाणां शक्तिमीनां गदोडुपाम्।\nउष्णीषफेनवसनां विकीर्णान्त्रसरीसृपाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2049908, "chapter_id": 2094, "verse_number": "७-२१-४३", "content_sanskrit": "वीरापहारिणीमुग्रां मांसशोमितकर्दमाम्।\nहस्तिग्राहां केतुवृक्षां क्षत्रियाणां निमज्जनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2049909, "chapter_id": 2094, "verse_number": "७-२१-४४", "content_sanskrit": "क्रूरां शरीरसङ्घाटां सादिनक्रां दुरत्ययाम्।\nद्रोणः प्रावर्तयत्तत्र नदीमन्तकगामिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2049910, "chapter_id": 2094, "verse_number": "७-२१-४५", "content_sanskrit": "क्रव्यादगणसञ्जुष्टां श्वशृगालगणायुताम्।\nनिषेवितां महारौद्रैः पिशिताशैः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2049911, "chapter_id": 2094, "verse_number": "७-२१-४६", "content_sanskrit": "तं दहन्तमनीकानि रथोदारं कृतान्तवत्।\nसर्वतोऽभ्यद्रवन्द्रोणं कुन्तीपुत्रपुरोगमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2049912, "chapter_id": 2094, "verse_number": "७-२१-४७", "content_sanskrit": "ते द्रोणं सहिताः शूराः सर्वतः प्रत्यवारयन्।\nगभस्तिभिरिवादित्यं तपन्तं भुवनं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2049913, "chapter_id": 2094, "verse_number": "७-२१-४८", "content_sanskrit": "तं तु शूरं महेष्वासं तावकाऽभ्युद्यतायुधाः।\nराजानो राजपुत्राश्च समन्तात्पर्यवारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2049914, "chapter_id": 2094, "verse_number": "७-२१-४९", "content_sanskrit": "शिखण्डी तु ततो द्रोणं पञ्चभिर्नतपर्वभिः।\nक्षत्रवर्मा च विंशत्या वसुदानश्च पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2049915, "chapter_id": 2094, "verse_number": "७-२१-५०", "content_sanskrit": "उत्तमौजास्त्रिभिर्बाणैः क्षत्रदेवश्च सप्तभिः।\nसात्यकिश्च शतेनाजौ युधामन्युस्तथाऽष्टभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2049916, "chapter_id": 2094, "verse_number": "७-२१-५१", "content_sanskrit": "युधिष्ठिरो द्वादशभिर्द्रोणं विव्याध सायकैः।\nधृष्टद्युम्नश्च दशभिश्चेकितानस्त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2049917, "chapter_id": 2094, "verse_number": "७-२१-५२", "content_sanskrit": "ततो द्रोणः सत्यसन्धः प्रभिन्न इव कुञ्जरः।\nअभ्यतीत्य स्थानीकं दृढसेनमपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2049918, "chapter_id": 2094, "verse_number": "७-२१-५३", "content_sanskrit": "ततो राजानमासाद्य प्रहरन्तमभीतवत्।\nअविध्यन्नवभिः क्षेमं स हतःप्रापतद्रथात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2049919, "chapter_id": 2094, "verse_number": "७-२१-५४", "content_sanskrit": "स मध्यं प्राप्य सैन्यानां सर्वाः प्रविचरन्दिशः।\nत्राता ह्यभवदन्येषां न त्रातव्यः कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2049920, "chapter_id": 2094, "verse_number": "७-२१-५५", "content_sanskrit": "शिखण्डिनं द्वादशभिर्विंशत्या चोत्तमौजसम्।\nवसुदानं च भल्लेन प्रैषयद्यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2049921, "chapter_id": 2094, "verse_number": "७-२१-५६", "content_sanskrit": "अशीत्या क्षत्रवर्माणं षड्विंशत्या सुदक्षिणम्।\nक्षत्रदेवं तु भल्लेन रथनीडाडपातयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2049922, "chapter_id": 2094, "verse_number": "७-२१-५७", "content_sanskrit": "युधामन्युं चतुःषष्ट्या त्रिंशता चैव सात्यकिम्।\nविद्ध्वा रुक्मरथस्तूर्णं युधिष्ठिरमुपाद्रवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2049923, "chapter_id": 2094, "verse_number": "७-२१-५८", "content_sanskrit": "ततो युधिष्ठिरः क्षिप्रं गुरुतो राजसत्तमः।\nअपायाञ्जवनैरश्वैः पाञ्चाल्यो द्रोणमभ्ययात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2049924, "chapter_id": 2094, "verse_number": "७-२१-५९", "content_sanskrit": "तं द्रोणः सधनुष्कं तु साश्वयन्तारमाक्षिणोत्।\nस हतः प्रापतद्भूमौ रथाज्ज्योतिरिवाम्बरात्।\n`हत्वा तं विबभौ द्रोणः कुरुभिः परिवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2049925, "chapter_id": 2094, "verse_number": "७-२१-६०", "content_sanskrit": "वार्धक्षेमिस्तु वार्ष्णेयो द्रोणं विद्ध्वा शरोत्तमैः।\nनवभिश्च महीपालः पुनर्विव्याध पञ्चभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2049926, "chapter_id": 2094, "verse_number": "७-२१-६१", "content_sanskrit": "स सात्यकिश्चतुष्षष्ट्या राजन्विव्याध सायकैः।\nसुचित्रो दशभिर्बाणैर्द्रोणं विद्व्वाऽनदद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2049927, "chapter_id": 2094, "verse_number": "७-२१-६२", "content_sanskrit": "तं द्रोणः समरे राजञ्शरवर्षैरवाकिरत्।\nअपातयत्तयो द्रोणः सुचित्रं सहसारथिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2049928, "chapter_id": 2094, "verse_number": "७-२१-६३", "content_sanskrit": "साश्वं च समरे राजन्हतो वै प्रापतत्क्षितौ।\nपात्यमानो महाराज बभौ ज्योतिरिवाम्बरात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2049929, "chapter_id": 2094, "verse_number": "७-२१-६४", "content_sanskrit": "तस्मिन्हते राजपुत्रे पाञ्चालानां यशस्करे।\nहत द्रोणं हत द्रोणमित्यासीन्निःस्वनो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2049930, "chapter_id": 2094, "verse_number": "७-२१-६५", "content_sanskrit": "तांस्तथा भृशसंरब्धान्पाञ्चालान्मत्स्यकेकयान्।\nसृञ्जयान्पाण्डवांश्चैव द्रोणो व्यक्षोभयद्बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2049931, "chapter_id": 2094, "verse_number": "७-२१-६६", "content_sanskrit": "सात्यकिं चेकितानं च धृष्टद्युम्नशिखण़्डिनौ।\nवार्धक्षेमिं चैत्रसेनिं सेनाबिन्दुं सुवर्चसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2049932, "chapter_id": 2094, "verse_number": "७-२१-६७", "content_sanskrit": "एतांश्चान्यांश्च सुबहून्नानाजनपदेश्वरान्।\nसर्वान्द्रोणोऽजयद्युद्धे कुरुभिः परिवारितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2049933, "chapter_id": 2094, "verse_number": "७-२१-६८", "content_sanskrit": "तावकाश्च महाराज जयं लब्ध्वा महाहवे।\nपाण्डवेयान्रणे जघ्नुर्द्रवमाणान्समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2049934, "chapter_id": 2094, "verse_number": "७-२१-६९", "content_sanskrit": "ते दानवा इवेन्द्रेण वध्यमाना महात्मना।\nपाञ्चालाः केकया मात्स्याः समकम्पन्त भारत॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2049935, "chapter_id": 2094, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि संशप्तकवधपर्वणि द्वादशदिवसयुद्धे एकविंशोऽध्यायः॥ २१ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-२१-५५ उभयत्र विद्व्वेति शेषः॥ ५-२१-५८ पाञ्चाल्यो नाम्ना॥ ५-२१-२१ एकविंशोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}]