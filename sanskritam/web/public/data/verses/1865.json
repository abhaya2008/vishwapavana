[{"id": 2039359, "chapter_id": 1865, "verse_number": "५-११०-०x", "content_sanskrit": "सुपर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039360, "chapter_id": 1865, "verse_number": "५-११०-१", "content_sanskrit": "इयं दिग्दियिता राज्ञो वरुणस्य तु गोपतेः ।\nसदा सलिलराजस्य प्रतिष्ठा चादिरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039361, "chapter_id": 1865, "verse_number": "५-११०-२", "content_sanskrit": "अत्र पश्चादहः सूर्यो विसर्जयति गाः स्वयम् ।\nपश्चिमेत्यभिविख्याता दिगियं द्विजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039362, "chapter_id": 1865, "verse_number": "५-११०-३", "content_sanskrit": "यादसामत्र राज्येन सलिलस्य च गुप्तये ।\nकश्यपो भगवान्देवो वरुणं स्माभ्यषेचयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039363, "chapter_id": 1865, "verse_number": "५-११०-४", "content_sanskrit": "अत्र पीत्वा समस्तान्वै वरुणस्य रसांस्तु षट् ।\nजायते तरुणः सोमः शुक्लस्यादौ तमिस्रहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039364, "chapter_id": 1865, "verse_number": "५-११०-५", "content_sanskrit": "अत्र पञ्चात्कृता दैत्या वायुना संयतास्तदा ।\nनिश्चसन्तो महावातैरर्दिताः सुषुपुर्द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039365, "chapter_id": 1865, "verse_number": "५-११०-६", "content_sanskrit": "अत्र सूर्यं प्रणयिनं प्रतिगृह्णाति पर्वतः ।\nअस्तो नाम यतः सन्ध्या पश्चिमा प्रतिसर्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039366, "chapter_id": 1865, "verse_number": "५-११०-७", "content_sanskrit": "अतो रात्रिश्च निद्रा च निर्गता दिवसक्षये।\nजायते जीवलोकस्य हर्तुमर्धमिवायुषः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039367, "chapter_id": 1865, "verse_number": "५-११०-८", "content_sanskrit": "अत्र देवीं दितिं सुप्तामात्मप्रसवधारिणीम् ।\nविगर्भामकरोच्छक्रो यत्र जातो मरुद्गणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039368, "chapter_id": 1865, "verse_number": "५-११०-९", "content_sanskrit": "अत्र मूलं हिमवतो मन्दरं याति शाश्वतम् ।\nअपि वर्षसहस्रेण न चास्यान्तोऽधिगम्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039369, "chapter_id": 1865, "verse_number": "५-११०-१०", "content_sanskrit": "अत्र काञ्चनशैलस्य काञ्चनाम्बुरुहस्य च।\nउदधेस्तीरमासाद्य सुरभिः क्षरते पयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039370, "chapter_id": 1865, "verse_number": "५-११०-११", "content_sanskrit": "अत्र मध्ये समुद्रस्य कबन्धः प्रतिदृश्यते।\nस्वर्भानोः सूर्यकल्पस्य सोमसूर्यौ जिघांसतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039371, "chapter_id": 1865, "verse_number": "५-११०-१२", "content_sanskrit": "सुवर्णशिरसोऽप्यत्र हरिरोम्णः प्रगायतः ।\nअदृश्यस्याप्रमेयस्य श्रूयते विपुलो ध्वनिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039372, "chapter_id": 1865, "verse_number": "५-११०-१३", "content_sanskrit": "अत्र ध्वजवती नाम कुमारी हरिमेधसः।\nआकाशे तिष्ठतिष्ठेति तस्थौ सूर्यस्य शासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039373, "chapter_id": 1865, "verse_number": "५-११०-१४", "content_sanskrit": "अत्र वायुस्तथा वह्निरापः खं चापि गालव ।\nआह्निकं चैव नैशं च दुःखं स्पर्शं विमुञ्चति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039374, "chapter_id": 1865, "verse_number": "५-११०-१५", "content_sanskrit": "अतःप्रभृति सूर्यस्य तिर्यगावर्तते गतिः।\nअत्र ज्योतींषि सर्वाणि विशन्त्यादित्यमण्डलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039375, "chapter_id": 1865, "verse_number": "५-११०-१६", "content_sanskrit": "अष्टाविंशतिरात्रं च क्रम्य सह भानुना।\nनिष्पतन्ति पुनः सूर्यात्सोमसंयोगयोगतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039376, "chapter_id": 1865, "verse_number": "५-११०-१७", "content_sanskrit": "अत्र नित्यं स्रवन्तीनां प्रभवः सागरोदयः ।\nअत्र लोकत्रयस्यापस्तिष्ठन्ति वरुणालये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039377, "chapter_id": 1865, "verse_number": "५-११०-१८", "content_sanskrit": "अत्र पन्नगराजस्याप्यनन्तस्य निवेशनम् ।\nअनादिनिधनस्यात्र विष्णोः स्थानमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039378, "chapter_id": 1865, "verse_number": "५-११०-१९", "content_sanskrit": "अत्रानलसखस्यापि पवनस्य निवेशनम्।\nमहर्षेः कश्यपस्यात्र मारीचस्य निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039379, "chapter_id": 1865, "verse_number": "५-११०-२०", "content_sanskrit": "एष ते पश्चिमो मार्गो दिग्द्वारेण प्रकीर्तितः।\nब्रूहि गालव गच्छावो बुद्धिः का द्विजसत्तम ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039380, "chapter_id": 1865, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि दशाधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]