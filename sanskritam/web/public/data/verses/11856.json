[{"id": 50024422, "chapter_id": 11856, "verse_number": "1", "content_sanskrit": "॥ आजीगर्तिः शुनःशेपः। वरुणः। गायत्री॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 50024423, "chapter_id": 11856, "verse_number": "2", "content_sanskrit": "यच्चि॒द्धि ते॒ विशो॑ यथा॒ प्र दे॑व वरुण व्र॒तम्। मि॒नी॒मसि॒ द्यवि॑द्यवि॥ २५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 50024424, "chapter_id": 11856, "verse_number": "3", "content_sanskrit": "मा नो॑ व॒धाय॑ ह॒त्नवे॑ जिहीळा॒नस्य॑ रीरधः। मा हृ॑णा॒नस्य॑ म॒न्यवे॑॥ २५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 50024425, "chapter_id": 11856, "verse_number": "4", "content_sanskrit": "वि मृ॑ळी॒काय॑ ते॒ मनो॑ र॒थीरश्वं॒ न संदि॑तम्। गी॒र्भिर्व॑रुण सीमहि॥ २५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 50024426, "chapter_id": 11856, "verse_number": "5", "content_sanskrit": "परा॒ हि मे॒ विम॑न्यव॒ः पत॑न्ति॒ वस्य॑इष्टये। वयो॒ न व॑स॒तीरुप॑॥ २५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 50024427, "chapter_id": 11856, "verse_number": "6", "content_sanskrit": "क॒दा क्ष॑त्र॒श्रियं॒ नर॒मा वरु॑णं करामहे। मृ॒ळी॒कायो॑रु॒चक्ष॑सम्॥ २५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 50024428, "chapter_id": 11856, "verse_number": "7", "content_sanskrit": "तदित्स॑मा॒नमा॑शाते॒ वेन॑न्ता॒ न प्र यु॑च्छतः। धृ॒तव्र॑ताय दा॒शुषे॑॥ २५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 50024429, "chapter_id": 11856, "verse_number": "8", "content_sanskrit": "वेदा॒ यो वी॒नां प॒दम॒न्तरि॑क्षेण॒ पत॑ताम्। वेद॑ ना॒वः स॑मु॒द्रिय॑ः॥ २५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 50024430, "chapter_id": 11856, "verse_number": "9", "content_sanskrit": "वेद॑ मा॒सो धृ॒तव्र॑तो॒ द्वाद॑श प्र॒जाव॑तः। वेदा॒ य उ॑प॒जाय॑ते॥ २५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 50024431, "chapter_id": 11856, "verse_number": "10", "content_sanskrit": "वेद॒ वात॑स्य वर्त॒निमु॒रोरृ॒ष्वस्य॑ बृह॒तः। वेदा॒ ये अ॒ध्यास॑ते॥ २५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 50024432, "chapter_id": 11856, "verse_number": "11", "content_sanskrit": "नि ष॑साद धृ॒तव्र॑तो॒ वरु॑णः प॒स्त्या॒३॒॑स्वा। साम्रा॑ज्याय सु॒क्रतु॑ः॥ २५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 50024433, "chapter_id": 11856, "verse_number": "12", "content_sanskrit": "अतो॒ विश्वा॒न्यद्भु॑ता चिकि॒त्वाँ अ॒भि प॑श्यति। कृ॒तानि॒ या च॒ कर्त्वा॑॥ २५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 50024434, "chapter_id": 11856, "verse_number": "13", "content_sanskrit": "स नो॑ वि॒श्वाहा॑ सु॒क्रतु॑रादि॒त्यः सु॒पथा॑ करत्। प्र ण॒ आयूं॑षि तारिषत्॥ २५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 50024435, "chapter_id": 11856, "verse_number": "14", "content_sanskrit": "बिभ्र॑द्द्रा॒पिं हि॑र॒ण्ययं॒ वरु॑णो वस्त नि॒र्णिज॑म्। परि॒ स्पशो॒ नि षे॑दिरे॥ २५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 50024436, "chapter_id": 11856, "verse_number": "15", "content_sanskrit": "न यं दिप्स॑न्ति दि॒प्सवो॒ न द्रुह्वा॑णो॒ जना॑नाम्। न दे॒वम॒भिमा॑तयः॥ २५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 50024437, "chapter_id": 11856, "verse_number": "16", "content_sanskrit": "उ॒त यो मानु॑षे॒ष्वा यश॑श्च॒क्रे असा॒म्या। अ॒स्माक॑मु॒दरे॒ष्वा॥ २५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 50024438, "chapter_id": 11856, "verse_number": "17", "content_sanskrit": "परा॑ मे यन्ति धी॒तयो॒ गावो॒ न गव्यू॑ती॒रनु॑। इ॒च्छन्ती॑रुरु॒चक्ष॑सम्॥ २५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 50024439, "chapter_id": 11856, "verse_number": "18", "content_sanskrit": "सं नु वो॑चावहै॒ पुन॒र्यतो॑ मे॒ मध्वाभृ॑तम्। होते॑व॒ क्षद॑से प्रि॒यम्॥ २५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 50024440, "chapter_id": 11856, "verse_number": "19", "content_sanskrit": "दर्शं॒ नु वि॒श्वद॑र्शतं॒ दर्शं॒ रथ॒मधि॒ क्षमि॑। ए॒ता जु॑षत मे॒ गिर॑ः॥ २५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 50024441, "chapter_id": 11856, "verse_number": "20", "content_sanskrit": "इ॒मं मे॑ वरुण श्रुधी॒ हव॑म॒द्या च॑ मृळय। त्वाम॑व॒स्युरा च॑के॥ २५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 50024442, "chapter_id": 11856, "verse_number": "21", "content_sanskrit": "त्वं विश्व॑स्य मेधिर दि॒वश्च॒ ग्मश्च॑ राजसि। स याम॑नि॒ प्रति॑ श्रुधि॥ २५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 50024443, "chapter_id": 11856, "verse_number": "22", "content_sanskrit": "उदु॑त्त॒मं मु॑मुग्धि नो॒ वि पाशं॑ मध्य॒मं चृ॑त। अवा॑ध॒मानि॑ जी॒वसे॑॥ २५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]