[{"id": 7003353000, "chapter_id": 23353, "verse_number": "२-४८-१", "content_sanskrit": "सूत उवाच  ।\nसर्वेषामपि देवानां प्रतिष्ठामपि विस्तरात् ।\nस्वैर्मत्रैर्यागकुंडानि विन्यस्यैकैकमेव च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003353001, "chapter_id": 23353, "verse_number": "२-४८-२", "content_sanskrit": "स्थापयेदुत्सवं कृत्वा पूजयेच्च विधानतः ।\nभानोः पंचाग्निना कार्यं द्वादशाग्निक्रमेण वा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003353002, "chapter_id": 23353, "verse_number": "२-४८-३", "content_sanskrit": "सर्वकुंडानि वृत्तानि पद्माकाराणि सुव्रताः ।\nअंबाया योनिकुंडं स्याद्वर्धन्येका विधीयते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003353003, "chapter_id": 23353, "verse_number": "२-४८-४", "content_sanskrit": "शक्तीकार्येषु योनिकुंडं विधीयते  ।\nगायत्रीं कल्पयेच्छंभोः सर्वेषामपि यत्नतः ।\nसर्वे रुद्रांशजा यस्मात्संक्षेपेण वदामि वः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003353004, "chapter_id": 23353, "verse_number": "२-४८-५", "content_sanskrit": "गायत्रीभेदाः  ।\nतत्पुरुषाय विद्महे वाग्विशुद्धाय धीमहि ।\nतन्नः शिवः प्रचोदयात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003353005, "chapter_id": 23353, "verse_number": "२-४८-६", "content_sanskrit": "गणांबिकायै विद्महे कर्मसिद्ध्यै च धीमहि ।\nतन्नो गौरी प्रचोदयात् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003353006, "chapter_id": 23353, "verse_number": "२-४८-७", "content_sanskrit": "तत्पुरुषाय विद्महे महादेवाय धीमहि ।\nतन्नो रुद्रः प्रचोदयात् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003353007, "chapter_id": 23353, "verse_number": "२-४८-८", "content_sanskrit": "तत्पुरुषाय विद्महे वक्रतुंडाय धीमहि ।\nतन्नो दंतिः प्रचोदयात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003353008, "chapter_id": 23353, "verse_number": "२-४८-९", "content_sanskrit": "महासेनाय विद्महे वाग्विशुद्धाय धीमहि ।\nतन्नः स्कंदः प्रोचदयात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003353009, "chapter_id": 23353, "verse_number": "२-४८-१०", "content_sanskrit": "तीक्ष्णश्रृंगाय विद्महे वेदपादाय धीमहि ।\nतन्नो वृषः प्रचोदयात् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003353010, "chapter_id": 23353, "verse_number": "२-४८-११", "content_sanskrit": "हरिवक्त्राय विद्महे रुद्रवक्त्राय धीमहि ।\nतन्नो नंदी प्रचोदयात् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003353011, "chapter_id": 23353, "verse_number": "२-४८-१२", "content_sanskrit": "नारायणाय विद्महे वासुदेवाय धीमहि ।\nतन्नो विष्णुः प्रचोदयात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003353012, "chapter_id": 23353, "verse_number": "२-४८-१३", "content_sanskrit": "महांबिकायै विद्महे कर्मसिद्ध्यै च धीमहि ।\nतन्नो लक्ष्मीः प्रचोदयात् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003353013, "chapter_id": 23353, "verse_number": "२-४८-१४", "content_sanskrit": "समुद्धृतायै विद्महे विष्णुनैकेन धीमहि ।\nतन्नो धरा प्रचोदयात् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003353014, "chapter_id": 23353, "verse_number": "२-४८-१५", "content_sanskrit": "वैनतेयाय विद्महे सुवर्णपक्षाय धीमहि ।\nतन्नो गरुडः प्रचोदयात् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003353015, "chapter_id": 23353, "verse_number": "२-४८-१६", "content_sanskrit": "पद्मोद्भवाय विद्महे वेदवक्त्राय धीमहि ।\nतन्नः स्रष्टा प्रचोदयात् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003353016, "chapter_id": 23353, "verse_number": "२-४८-१७", "content_sanskrit": "शिवास्यजायै विद्महे देवरूपायै धीमहि ।\nतन्नो वाचा प्रचोदयात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003353017, "chapter_id": 23353, "verse_number": "२-४८-१८", "content_sanskrit": "देवराजाय विद्महे वज्रहस्ताय धीमहि ।\nतन्नः शक्रः प्रचोदयात् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003353018, "chapter_id": 23353, "verse_number": "२-४८-१९", "content_sanskrit": "रुद्रनेत्राय विद्महे शक्तिहस्ताय धीमहि ।\nतन्नो वह्निः प्रचोदयात् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003353019, "chapter_id": 23353, "verse_number": "२-४८-२०", "content_sanskrit": "वैवस्वताय विद्महे दंडहस्ताय धीमहि ।\nतन्नो यमः प्रचोदयात् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003353020, "chapter_id": 23353, "verse_number": "२-४८-२१", "content_sanskrit": "निशाचराय विद्महे खड्गहस्ताय धीमहि ।\nतन्नो निर्ऋतिः प्रचोदयात् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003353021, "chapter_id": 23353, "verse_number": "२-४८-२२", "content_sanskrit": "शुद्धहस्ताय विद्महे पाशहस्ताय धीमहि ।\nतन्नो वरुणः प्रचोदयात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003353022, "chapter_id": 23353, "verse_number": "२-४८-२३", "content_sanskrit": "सर्वप्राणाय विद्महे यष्टिहस्ताय धीमहि ।\nतन्नो वायुः प्रचोदयात् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003353023, "chapter_id": 23353, "verse_number": "२-४८-२४", "content_sanskrit": "यक्षेश्वराय विद्महे गदाहस्ताय धीमहि ।\nतन्नो यक्षः प्रचोदयात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003353024, "chapter_id": 23353, "verse_number": "२-४८-२५", "content_sanskrit": "सर्वेश्वराय विद्महे शूलहस्ताय धीमहि ।\nतन्नो रुद्रः प्रचोदयात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003353025, "chapter_id": 23353, "verse_number": "२-४८-२६", "content_sanskrit": "कात्यायन्यै विद्महे कन्याकुमार्यै धीमहि ।\nतन्नो दुर्गा प्रचोदयात् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003353026, "chapter_id": 23353, "verse_number": "२-४८-२७", "content_sanskrit": "एवं प्रभिद्य गायत्रीं तत्तदेवानुरूपतः ।\nपूजयेत् स्थापयेत्तेषामासनं प्रणवं स्मृतम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003353027, "chapter_id": 23353, "verse_number": "२-४८-२८", "content_sanskrit": "अथवा विष्णुमतुलं सूक्तेन पुरुषेण वा ।\nविष्णुं चैव महाविष्णुं सदाविष्णुमनुक्रमात् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003353028, "chapter_id": 23353, "verse_number": "२-४८-२९", "content_sanskrit": "स्थापयेद्देवगायत्र्या परिकल्प्य विधानतः ।\nवासुदेवः प्रधानस्तु ततः संकर्षणः स्वयम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003353029, "chapter_id": 23353, "verse_number": "२-४८-३०", "content_sanskrit": "प्रद्युम्नो ह्यनिरुद्धश्च मूर्तिभेदास्तु वै प्रभोः ।\nबहूनि विविधानीह तस्य शापोद्भवानि च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003353030, "chapter_id": 23353, "verse_number": "२-४८-३१", "content_sanskrit": "सर्वावर्तेषु रूपाणि जगतां च हिताय वै ।\nमत्स्यः कूर्मोऽथ वाराहो नारसिंहोऽथ वामनः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003353031, "chapter_id": 23353, "verse_number": "२-४८-३२", "content_sanskrit": "रामो रामश्च कृष्णश्च बौद्धः कल्की तथैव च ।\nतथान्यानि न देवस्य हरेः सापोद्भवानि च ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003353032, "chapter_id": 23353, "verse_number": "२-४८-३३", "content_sanskrit": "तेषामपि च गायत्रीं कृत्वा स्थाप्य च पूजयेत् ।\nगुह्यानि देवदेवस्य हरेर्नारायणस्य च ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003353033, "chapter_id": 23353, "verse_number": "२-४८-३४", "content_sanskrit": "विज्ञानानि च यंत्राणि मंत्रोपनिषदानि च ।\nपंच ब्रह्मांगजानीह पंचभूतमयानि च ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003353034, "chapter_id": 23353, "verse_number": "२-४८-३५", "content_sanskrit": "नमो नारायणायेति मंत्रः परमशोभनः ।\nहरेरष्टाक्षराणीह प्रणवेन समासतः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003353035, "chapter_id": 23353, "verse_number": "२-४८-३६", "content_sanskrit": "ओं नमो वासुदेवाय नमः संकर्षणाय च ।\nप्रद्युम्नाय प्रधानाय अनिरुद्धाय वै नमः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003353036, "chapter_id": 23353, "verse_number": "२-४८-३७", "content_sanskrit": "एकमेकेन मंत्रेण स्थापयेत्परमेश्वरम् ।\nबिंबानियानि देवस्य शिवस्य परमेष्ठिनः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003353037, "chapter_id": 23353, "verse_number": "२-४८-३८", "content_sanskrit": "प्रतिष्ठा चैव पूजा च लिंगवन्मुनिसत्तमाः ।\nरत्नविन्याससहितं कौतुकानि हरेरपि ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003353038, "chapter_id": 23353, "verse_number": "२-४८-३९", "content_sanskrit": "अचले कारयेत्सर्वं चलेप्येवं विधानतः ।\nतन्नेत्रोन्मीलनं कुर्यान्नेत्रमंत्रेण सुव्रताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003353039, "chapter_id": 23353, "verse_number": "२-४८-४०", "content_sanskrit": "क्षेत्रप्रदक्षिणं चैव आरामस्य पुरस्य च ।\nजलाधिवासनं चैव पूर्ववत्परिकीर्तितम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003353040, "chapter_id": 23353, "verse_number": "२-४८-४१", "content_sanskrit": "कुंडमंडपनिर्माणं शयनं च विधीयते ।\nहुत्वा नवाग्निभागेन नवकुंडे यताविधि ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003353041, "chapter_id": 23353, "verse_number": "२-४८-४२", "content_sanskrit": "अथवा पंचकुंडेषु प्रधाने केवलेऽथ वा ।\nप्रतिष्ठा कथिता दिव्या पारंपर्यक्रमागता ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003353042, "chapter_id": 23353, "verse_number": "२-४८-४३", "content_sanskrit": "शिलोद्भवानां बिंबानां चित्राभासस्य वा पुनः ।\nजलाधिवासनं प्रोक्तं वृषेंद्रस्य प्रकीर्तितम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003353043, "chapter_id": 23353, "verse_number": "२-४८-४४", "content_sanskrit": "प्रासादस्य प्रतिष्ठायां प्रतिष्ठा परिकीर्तिता ।\nप्रासादांगस्य सर्वस्य यथांगानां तनोरिव ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003353044, "chapter_id": 23353, "verse_number": "२-४८-४५", "content_sanskrit": "वृषाग्निमातृविघ्नेशकुमारानपि यत्नतः ।\nश्रेष्ठां दुर्गां तथा चंडीं गायत्र्या वै यथाविधि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003353045, "chapter_id": 23353, "verse_number": "२-४८-४६", "content_sanskrit": "प्रागाद्यं स्थापयेच्छंभोरष्टावरणमुत्तमम् ।\nलोकपालगणेशाद्यानपि शंभोः प्रविन्यसेत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003353046, "chapter_id": 23353, "verse_number": "२-४८-४७", "content_sanskrit": "उमा चंडी च नंदी च महाकालो महामुनिः ।\nविघ्नेश्वरो महाभृंगी स्कंदः सौम्यादितः क्रमात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003353047, "chapter_id": 23353, "verse_number": "२-४८-४८", "content_sanskrit": "इंद्रादीन्स्वेषु स्थानेषु ब्रह्माणं च जनार्दनम् ।\nस्थापयेच्चैव यत्नेन क्षेत्रेशं वेशगोचरे ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003353048, "chapter_id": 23353, "verse_number": "२-४८-४९", "content_sanskrit": "सिंहासने ह्यनंतादीन् विद्येशामपि च क्रमात् ।\nस्थापयेत्प्रणवेनैव गुह्यांगादीनि पंकजे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003353049, "chapter_id": 23353, "verse_number": "२-४८-५०", "content_sanskrit": "एवं संक्षेपतः प्रोक्तं चलस्थापनसुत्तमम् ।\nसर्वेषामपि देवानां देवीनां च विशेषतः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]