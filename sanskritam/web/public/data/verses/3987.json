[{"id": 2137696, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2137697, "chapter_id": 3987, "verse_number": "१", "content_sanskrit": "नापदामस्ति मर्यादा न निमित्तं न कारणम् ।\nधर्मस्तु विभजत्यर्थमुभयोः पुण्यपापयोः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2137698, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "भीमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2137699, "chapter_id": 3987, "verse_number": "२", "content_sanskrit": "प्रातिकाम्येन यत् कृष्णां सभायां प्रेष्यवत् तदा ।\nन मया निहतस्तत्र तेन प्राप्ताः स्म संशयम् \t ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2137700, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2137701, "chapter_id": 3987, "verse_number": "३", "content_sanskrit": "वाचस्तीक्ष्णास्थिभेदिन्यः सूतपुत्रेण भाषिताः ।\nअतितीव्रा मया क्षान्तास्तेन प्राप्ताः स्म संशयम् \t ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2137702, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "सहदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2137703, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "शकुनिस्त्वां यदाजैषीदक्षद्यूतेन भारत ।\nस मया न हतस्तत्र तेन प्राप्ताः स्म संशयम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2137704, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2137705, "chapter_id": 3987, "verse_number": "४", "content_sanskrit": "ततो युधिष्ठिरो राजा नकुलं वाक्यमब्रवीत् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2137706, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2137707, "chapter_id": 3987, "verse_number": "५", "content_sanskrit": "आरुह्य वृक्षं माद्रेय निरीक्षस्व दिशो दश \t ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2137708, "chapter_id": 3987, "verse_number": "६", "content_sanskrit": "पानीयमन्तिके पश्य वृक्षांश्चाप्युदकाश्रितान् ।\nएते हि भ्रातरः श्रान्तास्तव तात पिपासिताः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2137709, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2137710, "chapter_id": 3987, "verse_number": "७", "content_sanskrit": "नकुलस्तु तथेत्युक्त्वा भ्रातुर्ज्येष्ठस्य शासनात् ।\nतत उत्थाय मतिमान् शीघ्रमारुह्य पादपम् ।\nअब्रवीद् भ्रातरं ज्येष्ठमभिवीक्ष्य समन्ततः \t ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2137711, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "नकुलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2137712, "chapter_id": 3987, "verse_number": "८", "content_sanskrit": "पश्यामि बहुलान् राजन् वृक्षानुदकसंश्रयान् ।\nसारसानां च निर्ह्रादमत्रोदकमसंशयम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2137713, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2137714, "chapter_id": 3987, "verse_number": "९", "content_sanskrit": "ततोऽब्रवीत्सत्यधृतिः कुन्तीपुत्रो युधिष्ठिरः ।\nगच्छ सौम्य ततः शीघ्रं तूणैः पानीयमानय \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2137715, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2137716, "chapter_id": 3987, "verse_number": "१०", "content_sanskrit": "नकुलस्तु तथेत्युक्त्वा भ्रातुर्ज्येष्ठस्य शासनात् ।\nप्राद्रवद् यत्र पानीयं शीघ्रं चैवान्वपद्यत \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2137717, "chapter_id": 3987, "verse_number": "११", "content_sanskrit": "स दृष्ट्वा विमलं तोयं सारसैः परिवारितम् ।\nपातुकामस्ततो वाचमन्तरिक्षात् स शुश्रुवे \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2137718, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "यक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2137719, "chapter_id": 3987, "verse_number": "१२", "content_sanskrit": "मा तात साहसं कार्षीर्मम पूर्वपरिग्रहः ।\nप्रश्नानुक्त्वा तु माद्रेय ततः पिब हरस्व च \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2137720, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2137721, "chapter_id": 3987, "verse_number": "१३", "content_sanskrit": "अनादृत्य तु तद्वाक्यं नकुलः सुपिपासितः ।\nअपिबच्छीतलं तोयं पीत्वा च निपपात ह \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2137722, "chapter_id": 3987, "verse_number": "१४", "content_sanskrit": "चिरायमाणे नकुले कुन्तीपुत्रो युधिष्ठिरः ।\nअब्रवीद् भ्रातरं वीरं सहदेवमरिन्दमम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2137723, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2137724, "chapter_id": 3987, "verse_number": "१५", "content_sanskrit": "भ्राता हि चिरयातो नः सहदेव तवाग्रजः ।\nतथैवानय सोदर्यं पानीयं च त्वमानय \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2137725, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2137726, "chapter_id": 3987, "verse_number": "१६", "content_sanskrit": "सहदेवस्तथेत्युक्त्वा तां दिशं प्रत्यपद्यत ।\nददर्श च हतं भूमौ भ्रातरं नकुलं तदा \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2137727, "chapter_id": 3987, "verse_number": "१७", "content_sanskrit": "भ्रातृशोकाभिसन्तप्तस्तृषया च प्रपीडितः ।\nअभिदुद्राव पानीयं ततो वागभ्यभाषत \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2137728, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "यक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2137729, "chapter_id": 3987, "verse_number": "१८", "content_sanskrit": "मा तात साहसं कार्षीर्मम पूर्वपरिग्रहः ।\nप्रश्नानुक्त्वा यथाकामं पिबस्व च हरस्व च \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2137730, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2137731, "chapter_id": 3987, "verse_number": "१९", "content_sanskrit": "अनादृत्य तु तद्वाक्यं सहदेवः पिपासितः ।\nअपिबच्छीतलं तोयं पीत्वा च निपपात ह \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2137732, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "चिरायमाणे माद्रेये कुन्तीपुत्रो युधिष्ठिरः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2137733, "chapter_id": 3987, "verse_number": "२०", "content_sanskrit": "अथाब्रवीत् स विजयं कुन्तीपुत्रो युधिष्ठिरः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2137734, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2137735, "chapter_id": 3987, "verse_number": "२१", "content_sanskrit": "भ्रातरौ ते चिरगतौ बीभत्सो शत्रुकर्शन ।\nतौ चैवानय भद्रं ते पानीयं च त्वमानय \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2137736, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "वैशम्पायनः-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2137737, "chapter_id": 3987, "verse_number": "२२", "content_sanskrit": "एवमुक्तो गुडाकेशः प्रगृह्य सशरं धनुः ।\nआमुक्तखड्गो मेधावी तत्सरः प्रत्यपद्यत \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2137738, "chapter_id": 3987, "verse_number": "२३", "content_sanskrit": "ततः पुरुषशार्दूलौ पानीयहरणे गतौ ।\nतौ ददर्श हतौ तत्र भ्रातरौ श्वेतवाहनः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2137739, "chapter_id": 3987, "verse_number": "२४", "content_sanskrit": "विगतासू नरव्याघ्रौ शयानौ वसुधातले ।\nप्रसुप्ताविव तौ दृष्ट्वा नरसिंहः सुदुःखितः ।\nधनुरुद्यम्य कौन्तेयो व्यलोकयत तद्वनम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2137740, "chapter_id": 3987, "verse_number": "२५", "content_sanskrit": "नापश्यत् तत्र किञ्चित् स भूतमस्मिन् महावने ।\nसव्यसाची ततः श्रान्तः पानीयं सोऽभ्यधावत \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2137741, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "अभिधावंस्ततो वाक्यमन्तरिक्षात् स शुश्रुवे ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2137742, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "यक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2137743, "chapter_id": 3987, "verse_number": "२६", "content_sanskrit": "यत् त्वमिच्छसि पानीयं नैतच्छक्यं नरर्षभ \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2137744, "chapter_id": 3987, "verse_number": "२७", "content_sanskrit": "किमासीदसि पानीयं नैतच्छक्यं बलात् त्वया ।\nकौन्तेय यदि प्रश्नांस्तान्मयोक्तान् प्रतिपत्स्यसे ।\nततः पास्यसि पानीयं हरिष्यसि च भारत \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2137745, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2137746, "chapter_id": 3987, "verse_number": "२८", "content_sanskrit": "वारितस्त्वब्रवीत् पार्थो दृश्यमानो निवारय ।\nयावद् बाणैर्विनिर्भिन्नः पुनर्नैवं वदिष्यसि \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2137747, "chapter_id": 3987, "verse_number": "२९", "content_sanskrit": "एवमुक्त्वा ततः पार्थः शरैरस्त्रानुमन्त्रितैः ।\nप्रववर्ष दिशः कृत्स्नाः शब्दवेधं च दर्शयन् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2137748, "chapter_id": 3987, "verse_number": "३०", "content_sanskrit": "कर्णिनालीकनाराचानुत्सृजन् भरतर्षभ ।\nस त्वमोघानिषून् मुक्त्वा तृष्णायाऽभिप्रपीडितः ।\nअनेकैरिषुसङ्घातैरन्तरिक्षे ववर्ष ह \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2137749, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "यक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2137750, "chapter_id": 3987, "verse_number": "३१", "content_sanskrit": "किं विद्या वै न ते पार्थ प्रश्नानुक्त्वा ततः पिब ।\nअनुक्त्वा तु ततः प्रश्नान्पीत्वैव न भविष्यसि \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2137751, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2137752, "chapter_id": 3987, "verse_number": "३२", "content_sanskrit": "एवमुक्तस्ततः पार्थः सव्यसाची धनञ्जयः ।\nस च मोघानिषून् दृष्ट्वा तृष्णया च प्रपीडितः ।\nअवज्ञायैव तां वाचं पीत्वैव निपपात ह \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2137753, "chapter_id": 3987, "verse_number": "३३", "content_sanskrit": "अथाब्रवीद् भीमसेनं कुन्तीपुत्रो युधिष्ठिरः \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2137754, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2137755, "chapter_id": 3987, "verse_number": "३४", "content_sanskrit": "नकुलः सहदेवश्च बीभत्सुश्च परन्तप ।\nचिरं गतास्तोयहेतोर्न चागच्छन्ति भारत ।\nतांश्चैवानय भद्रं ते पानीयं च त्वमानय \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2137756, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2137757, "chapter_id": 3987, "verse_number": "३५", "content_sanskrit": "भीमसेनस्तथेत्युक्त्वा तं देशं प्रत्यपद्यत ।\nयत्र ते पुरुषव्याघ्रा भ्रातरोऽस्य निपातिताः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2137758, "chapter_id": 3987, "verse_number": "३६", "content_sanskrit": "तान् दृष्ट्वा दुःखितो भीमस्तृषया च प्रपीडितः ।\nअमन्यत महाबाहुः कर्म तद् यक्षरक्षसाम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2137759, "chapter_id": 3987, "verse_number": "३७", "content_sanskrit": "स चिन्तयामास तदा योद्धव्यं ध्रुवमद्य वै ।\nपास्यामि तावत् पानीयमिति पार्थो वृकोदरः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2137760, "chapter_id": 3987, "verse_number": "३८", "content_sanskrit": "ततोऽभ्यधावत् पानीयं पिपासुः पुरुषर्षभः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2137761, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "वागुवाचाथ सुस्पष्टमदृश्या पाण्डुनन्दनम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2137762, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "यक्षः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2137763, "chapter_id": 3987, "verse_number": "३९", "content_sanskrit": "मा तात साहसं कार्षीर्मम पूर्वपरिग्रहः ।\nप्रश्नानुक्त्वा तु कौन्तेय ततः पिब हरस्व च \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2137764, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2137765, "chapter_id": 3987, "verse_number": "४०", "content_sanskrit": "एवमुक्तस्तदा भीमो यक्षेणामिततेजसा ।\nअनुक्त्वैव तु तान् प्रश्नान् पीत्वैव निपपात ह \t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2137766, "chapter_id": 3987, "verse_number": "४१", "content_sanskrit": "ततः कुन्तीसुतो राजा धर्मपुत्रो युधिष्ठिरः ।\nआत्मनात्मानमन्विष्य विचारमकरोत् प्रभुः ।\nततश्चिरगतान् भ्रातॄनथ ज्ञातुं युधिष्ठिरः \t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2137767, "chapter_id": 3987, "verse_number": "४२", "content_sanskrit": "चिरायमानान् बहुशः पुनः पुनरुवाच ह ।\nमाद्रेयौ किं चिरायेते गाण्डीवी किं चिरायते \t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2137768, "chapter_id": 3987, "verse_number": "४३", "content_sanskrit": "महाबलधरस्तत्र किं नु भीमश्चिरायते ।\nगच्छाम्येषां पदं द्रष्टुमिति कृत्वा युधिष्ठिरः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2137769, "chapter_id": 3987, "verse_number": "४४", "content_sanskrit": "(ततः कुन्तीसुतो राजा प्रचिन्त्य पुरुषर्षभः ।\nगच्छामेषां पदं द्रष्टुमति कृत्वा युधिष्ठिरः ।)\nसमुत्थाय महाबाहुर्दह्यमानेन चेतसा \t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2137770, "chapter_id": 3987, "verse_number": "४५", "content_sanskrit": "व्यपेतजननिर्घोषं प्रविवेश महावनम् ।\nरुरुभिश्च वराहैश्च पक्षिभिश्च निषेवितम् ।\nनीलभास्वरवर्णैश्च पादपैरुपशोभितम् \t ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2137771, "chapter_id": 3987, "verse_number": "४६", "content_sanskrit": "भ्रमरैरुपगीतं च पक्षिभिश्च समन्ततः ।\nभ्रमरैरुपगीतं च पक्षिभिश्च महायशाः \t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2137772, "chapter_id": 3987, "verse_number": "४७", "content_sanskrit": "स गच्छन् कानने तस्मिन् हेमजालपरिष्कृतम् ।\nददर्श तत्सरः श्रीमान् विश्वकर्मकृतं यथा \t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2137773, "chapter_id": 3987, "verse_number": "४८", "content_sanskrit": "उपेतं नलिनीजालैः सिन्धुवारैः सवेतसैः ।\nकेतकैः करवीरैश्च पिप्पलैश्चैव संवृतम् \t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2137774, "chapter_id": 3987, "verse_number": "४९", "content_sanskrit": "श्रमार्तस्तदुपागम्य सरो दृष्ट्वाथ विस्मितः ।\nततो धर्मसुतः श्रीमान् भ्रातृदर्शनलालसः ।\nश्रमार्तस्तदुपाक्रामत् सरो दृष्ट्वा सुविस्मितः \t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2137775, "chapter_id": 3987, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि आरणेयपर्वणि नकुलादिपतने एकाधिकत्रिशततमोऽध्यायः ॥३०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2137776, "chapter_id": 3987, "verse_number": "", "content_sanskrit": "आरणेयपर्वणि द्वितीयोऽध्यायः ॥२॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}]