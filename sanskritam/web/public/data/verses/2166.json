[{"id": 2052731, "chapter_id": 2166, "verse_number": "७-९३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2052732, "chapter_id": 2166, "verse_number": "७-९३-१", "content_sanskrit": "हते सुदक्षिणे राजन्वीरे चैव श्रुतायुधे।\nजवेनाभ्यद्रवन्पार्थं कुपिताः सैनिकास्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2052733, "chapter_id": 2166, "verse_number": "७-९३-२", "content_sanskrit": "अभीषाहाः शूरसेनाः शिबयोऽथ वसातयः।\nअभ्यवर्षंस्ततो राजञ्शरवर्षैर्धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2052734, "chapter_id": 2166, "verse_number": "७-९३-३", "content_sanskrit": "तेषां षष्टिशतानन्यान्प्रामथ्नात्पाण्डवः शरैः।\nते स्म भीताः पलायन्ते व्याघ्रात्क्षुद्रमृगा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2052735, "chapter_id": 2166, "verse_number": "७-९३-४", "content_sanskrit": "ते निवृत्ताः पुनः पार्थं सर्वतः पर्यवारयन्।\nरणे सपत्नान्निघ्नन्तं जिगीषन्तं परान्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2052736, "chapter_id": 2166, "verse_number": "७-९३-५", "content_sanskrit": "तेषामापततां तूर्णं गाण्डीवप्रेषितैः शरैः।\nशिरांसि पातयामास बाहूंश्चापि धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2052737, "chapter_id": 2166, "verse_number": "७-९३-६", "content_sanskrit": "शिरोभिः पातितैस्तत्र भूमिरासीन्निरन्तरा।\nअभ्रच्छायेव चैवासीद्ध्वाङ्क्षगृध्रबलैर्युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2052738, "chapter_id": 2166, "verse_number": "७-९३-७", "content_sanskrit": "तेषु तूत्साद्यमानेषु क्रोधामर्षसमन्वितौ।\nस्रुतायुश्चाश्रुतायुश्च धनञ्जयमयुध्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2052739, "chapter_id": 2166, "verse_number": "७-९३-८", "content_sanskrit": "बलिनौ स्पर्धिनौ वीरौ कुलजौ बाहुशालिनौ।\nतावेनं शरवर्षाणि सव्यदक्षिणमस्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2052740, "chapter_id": 2166, "verse_number": "७-९३-९", "content_sanskrit": "त्वरायुक्तौ महराज प्रार्थयानौ महद्यशः।\nअर्जुनस्य वधप्रेप्सू पुत्रार्थे तव धन्विनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2052741, "chapter_id": 2166, "verse_number": "७-९३-१०", "content_sanskrit": "तावर्जुनं सहस्रेण पत्रिणां नतपर्वणाम्।\nपूरयामासतुः क्रुद्धौ तटाकं जलदौ यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2052742, "chapter_id": 2166, "verse_number": "७-९३-११", "content_sanskrit": "श्रुतायुश्च ततः क्रुद्धस्तोमरेण धनञ्जयम्।\nआजघान रथश्रेष्ठः पीतेन निशितेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2052743, "chapter_id": 2166, "verse_number": "७-९३-१२", "content_sanskrit": "सोऽतिविद्धो बलवता शत्रुणा शत्रुकर्शनः।\nजगाम परमं मोहं मोहयन्केशवं रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2052744, "chapter_id": 2166, "verse_number": "७-९३-१३", "content_sanskrit": "एतस्मिन्नेव काले तु सोऽश्रुतायुर्महारथः।\nशूलेन भृशतीक्ष्णेन ताडयामास पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2052745, "chapter_id": 2166, "verse_number": "७-९३-१४", "content_sanskrit": "क्षते क्षारं स हि ददौ पाण्डवस्य महात्मनः।\nपार्थोऽपि भृशसंविद्धो ध्वजयष्टिं समाश्रितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2052746, "chapter_id": 2166, "verse_number": "७-९३-१५", "content_sanskrit": "ततः सर्वस्य सैन्यस्य तावकस्य विशाम्पते।\nसिंहनादो महानासीद्धतं मत्वा धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2052747, "chapter_id": 2166, "verse_number": "७-९३-१६", "content_sanskrit": "कृष्णश्च भृशसन्तप्तो दृष्ट्वा पार्थं विचेतनम्।\nआश्वासयत्सुहृद्याभिर्वाग्भिस्तत्र धनञ्जयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2052748, "chapter_id": 2166, "verse_number": "७-९३-१७", "content_sanskrit": "ततस्तौ रथिनां श्रेष्ठौ लब्धलक्षौ धनञ्जयम्।\nवासुदेवं च वार्ष्णेयं शरवर्षैः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2052749, "chapter_id": 2166, "verse_number": "७-९३-१८", "content_sanskrit": "सचक्रकूबररथं साश्वध्वजपताकिनम्।\nअदृश्यं चक्रतुर्युद्धे तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2052750, "chapter_id": 2166, "verse_number": "७-९३-१९", "content_sanskrit": "प्रत्याश्वस्तस्तु बीभत्सुः शनकैरिव भारत।\nप्रेतराजपुरं प्राप्य पुनः प्रत्यागतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2052751, "chapter_id": 2166, "verse_number": "७-९३-२०", "content_sanskrit": "सञ्छन्नं शरजालेन रथं दृष्ट्वा सकेशवम्।\nशत्रू चाभिमुखौ दृष्ट्वा दीप्यमानाविवानलौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2052752, "chapter_id": 2166, "verse_number": "७-९३-२१", "content_sanskrit": "प्रादुश्चक्रे ततः पार्थः शाक्रमस्त्रं महारथः।\nतस्मादासन्सहस्राणि शराणां नतपर्वणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2052753, "chapter_id": 2166, "verse_number": "७-९३-२२", "content_sanskrit": "ते जघ्नुस्तौ महेष्वासौ ताभ्यां मुक्तांश्च सायकान्।\nविचेरुराकाशगताः पार्थचापविनिःसृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2052754, "chapter_id": 2166, "verse_number": "७-९३-२३", "content_sanskrit": "प्रतिहत्य सरांस्तूर्णं शरवेगेन पाण्डवः।\nप्रतस्थे तत्रतत्रैव योधयन्वै महारथान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2052755, "chapter_id": 2166, "verse_number": "७-९३-२४", "content_sanskrit": "तौ च फल्गुनबाणौघैर्विबाहुशिरसौ कृतौ।\nवसुधामन्वपद्येतां वातनुन्नाविव द्रुमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2052756, "chapter_id": 2166, "verse_number": "७-९३-२५", "content_sanskrit": "श्रुतायुषश्च निधनं वधश्चेवाश्रुतायुषः।\nलोकविस्मापनमभूत्समुद्रस्येव शोषणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2052757, "chapter_id": 2166, "verse_number": "७-९३-२६", "content_sanskrit": "तयोः पदानुगान्हत्वा पुनः पञ्चशतं रथान्।\nप्रत्यगाद्भारतीं सेनां निघ्नन्पार्थो वरान्वरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2052758, "chapter_id": 2166, "verse_number": "७-९३-२७", "content_sanskrit": "श्रुतायुषं च निहतं प्रेक्ष्य चैवाश्रुतायुषम्।\nनियतायुश्च सङ्क्रुद्धो दीर्घायुश्चैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2052759, "chapter_id": 2166, "verse_number": "७-९३-२८", "content_sanskrit": "पुत्रौ तयोर्नरश्रेष्ठौ कौन्तेयं प्रति जग्मतुः।\nकिरन्तौ विविधान्बाणान्पितृव्यसनकर्शितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2052760, "chapter_id": 2166, "verse_number": "७-९३-२९", "content_sanskrit": "तावर्जुनो मुहूर्तेन शरैः सन्नतपर्वभिः।\nप्रैषयत्परमक्रुद्धो यमस्य सदनं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2052761, "chapter_id": 2166, "verse_number": "७-९३-३०", "content_sanskrit": "लोडयन्तमनीकानि द्विपं पद्मसरो यथा।\nनाशक्नुवन्वारयितुं पार्थं क्षत्रियपुङ्गवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2052762, "chapter_id": 2166, "verse_number": "७-९३-३१", "content_sanskrit": "अङ्गास्तु गजसङ्घैश्च पाण्डवं पर्यवारयन्।\nक्रुद्धाः सहस्रशो राजञ्शिक्षिता हस्तिसादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2052763, "chapter_id": 2166, "verse_number": "७-९३-३२", "content_sanskrit": "दुर्योधनसमादिष्टाः कुञ्जरैः पर्वतोपमैः।\nप्राच्याश्च दाक्षिणात्याश्च कलिङ्गप्रमुखा नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2052764, "chapter_id": 2166, "verse_number": "७-९३-३३", "content_sanskrit": "तेषामापततां शीघ्रं गाण्डीवप्रेषितैः शरैः।\nनिचकर्त शिरांस्युग्रो बाहूनपि सुभूषणान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2052765, "chapter_id": 2166, "verse_number": "७-९३-३४", "content_sanskrit": "तैः शिरोभिर्मही कीर्णा बाहुभिश्च सहाङ्गदैः।\nबभौ कनकपाषाणा भुजगैरिव संवृता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2052766, "chapter_id": 2166, "verse_number": "७-९३-३५", "content_sanskrit": "बाहवो विशिखैश्छिन्नाः शिरांस्युन्मथितानि च।\nपतमानान्यदृश्यन्त द्रुमेभ्य इव पक्षिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2052767, "chapter_id": 2166, "verse_number": "७-९३-३६", "content_sanskrit": "शरैः सहस्रशो विद्धा द्विपाः प्रसृतशोणिताः।\nअदृश्यन्ताद्रयः काले गैरिकाम्बुस्रवा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2052768, "chapter_id": 2166, "verse_number": "७-९३-३७", "content_sanskrit": "निहताः शेरते स्मान्ये बीभत्सोर्निशितैः शरैः।\nगजपृष्ठगता म्लेच्छा नानाविकृतदर्शनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2052769, "chapter_id": 2166, "verse_number": "७-९३-३८", "content_sanskrit": "नानावेषधरा राजन्नानाशस्त्रौघसंवृताः।\nरुधिरेणानुलिप्ताङ्गा भान्ति चित्रैः शरैर्हताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2052770, "chapter_id": 2166, "verse_number": "७-९३-३९", "content_sanskrit": "शोणितं निर्वमन्ति स्म द्विपाः पार्थशराहताः।\nसहस्रशश्छिन्नगात्राः सारोहाः सपदानुगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2052771, "chapter_id": 2166, "verse_number": "७-९३-४०", "content_sanskrit": "चुक्रुशुश्च निपेतुश्च बभ्रमुश्चापरे दिशः।\nभृशं त्रस्ताश्च बहवः स्वानेव ममृदुर्गजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2052772, "chapter_id": 2166, "verse_number": "७-९३-४१", "content_sanskrit": "सोत्तरायुधिनश्चैव द्विपास्तीक्ष्णविषोपमाः।\nविदन्त्यसुरमायां ये सुघोरा घोरचक्षुषः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2052773, "chapter_id": 2166, "verse_number": "७-९३-४२", "content_sanskrit": "यवनाः पारदाश्चैव शकाश्च सह बाह्लिकैः।\nकाकवर्णा दुराचाराः स्त्रीलोलाः कलहप्रियाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2052774, "chapter_id": 2166, "verse_number": "७-९३-४३", "content_sanskrit": "द्राविडास्तत्र युध्यन्ते मत्तमातङ्गविक्रमाः।\nगोयोनिप्रभवा म्लेच्छाः कालकल्पाः प्रहारिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2052775, "chapter_id": 2166, "verse_number": "७-९३-४४", "content_sanskrit": "दार्वातिसारा दरदाः पुण्ड्राश्चैव सहस्रशः।\nते न शक्याः स्म सङ्ख्यातुं व्राताः शतसहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2052776, "chapter_id": 2166, "verse_number": "७-९३-४५", "content_sanskrit": "अभ्यवर्षन्त ते सर्वे पाण्डवं निशितैः शरैः।\nअवाकिरंश्च ते म्लेच्छा नानायुद्धविशारदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2052777, "chapter_id": 2166, "verse_number": "७-९३-४६", "content_sanskrit": "तेषामपि ससर्जाशु शरवृष्टिं धनञ्जयः।\nसृष्टिस्तथाविधा ह्यासीच्छलभानामिवायतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2052778, "chapter_id": 2166, "verse_number": "७-९३-४७", "content_sanskrit": "अभ्रच्छायामिव शरैः सैन्ये कृत्वा धनञ्जयः।\nमुण्डार्धमुण्डाञ्जटिलानशुचीञ्जटिलाननान्।\nम्लेच्छानशातयत्सर्वान्समेतानस्त्रतेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2052779, "chapter_id": 2166, "verse_number": "७-९३-४८", "content_sanskrit": "शरैश्च शतशो विद्धास्ते सङ्घा गिरिचारिणः।\nप्राद्रवन्त रणे भीता गिरिगह्वरवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2052780, "chapter_id": 2166, "verse_number": "७-९३-४९", "content_sanskrit": "गजाश्वसादिम्लेच्छानां पतितानां शितैः शरैः।\nबकाः कङ्का वृका भूमावपिबन्रुधिरं मुदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2052781, "chapter_id": 2166, "verse_number": "७-९३-५०", "content_sanskrit": "पत्त्यश्वरथनागैश्च प्रच्छन्नकृतसङ्क्रमाम्।\nशरवर्षप्लवां घोरां केशशैवलशाद्वलाम्।\nप्रावर्तयन्नदीमुग्रां शोणितौघतरङ्गिणीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2052782, "chapter_id": 2166, "verse_number": "७-९३-५१", "content_sanskrit": "छिन्नाङ्गुलीक्षुद्रमत्स्यां युगान्ते कालसन्निभाम्।\nप्राकरोद्गजसम्बाधां नदीमुत्तरशोणिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2052783, "chapter_id": 2166, "verse_number": "७-९३-५२", "content_sanskrit": "देहेभ्यो राजपुत्राणां नागाश्वरथसादिनाम्।\nयथा स्थलं च निम्नं च न स्याद्वर्षति वासवे।\nतथाऽऽसीत्पृथिवी सर्वा शोणितेन परिप्लुता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2052784, "chapter_id": 2166, "verse_number": "७-९३-५३", "content_sanskrit": "षट्सहस्रान्हयान्वीरान्पुनर्दशशतान्वरान्।\nप्राहिणोन्मृत्युलोकाय क्षत्रियान्क्षत्रियर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2052785, "chapter_id": 2166, "verse_number": "७-९३-५४", "content_sanskrit": "शरैः सहस्रशो विद्धा विधिवत्कल्पिता द्विपाः।\nशेरते भूमिमासाद्य शैला वज्रहता इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2052786, "chapter_id": 2166, "verse_number": "७-९३-५५", "content_sanskrit": "स वाजिरथमातङ्गान्निघ्नन्व्यचरदर्जुनः।\nप्रभिन्न इव मातङ्गो मृद्गन्नलवनं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2052787, "chapter_id": 2166, "verse_number": "७-९३-५६", "content_sanskrit": "भुरिद्रुमलतागुल्मं शुष्केन्धनतृणोलपम्।\nनिर्दहेदनलोऽरण्यं यथा वायुसमीरितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2052788, "chapter_id": 2166, "verse_number": "७-९३-५७", "content_sanskrit": "सेनारण्यं तव तथा कृष्णानिलसमीरितः।\nशरार्चिरदहत्क्रुद्धः पाण्डवोऽग्निर्धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2052789, "chapter_id": 2166, "verse_number": "७-९३-५८", "content_sanskrit": "शून्यान्कुर्वन्रथोपस्थान्मानवैः संस्तरन्महीम्।\nप्रानृत्यदिव सम्बाधे चापहस्तो धनञ्जयः।\nवज्रकल्पैः शरैर्भूमिं कुर्वन्नुत्तरशोणिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2052790, "chapter_id": 2166, "verse_number": "७-९३-५९", "content_sanskrit": "`ततः प्रावर्तत नदी शोणितौघतरङ्गिणी।\nनराश्वद्विपकायेभ्यः पर्वतेभ्य इवापगा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2052791, "chapter_id": 2166, "verse_number": "७-९३-६०", "content_sanskrit": "अस्थिशर्करसम्बाधा ध्वजवृक्षा रथहदा।\nसञ्छिन्नशीर्षपाणाणा हस्तिहस्तमहाग्रहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2052792, "chapter_id": 2166, "verse_number": "७-९३-६१", "content_sanskrit": "मांसमज्जास्थिपङ्काढ्यां हताश्वमकराकुला।\nउष्णीषफेनसञ्छन्ना शरघोरझषाकुला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2052793, "chapter_id": 2166, "verse_number": "७-९३-६२", "content_sanskrit": "रुद्रस्याक्रीडसदृशीं भूमिं कुर्वन्विभीषणाम्।\nप्राविशद्भारतीं सेनां सङ्क्रुद्धो वै धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2052794, "chapter_id": 2166, "verse_number": "७-९३-६३", "content_sanskrit": "तं श्रुतायुस्तथाम्बष्ठो व्रजमानं न्यवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2052795, "chapter_id": 2166, "verse_number": "७-९३-६४", "content_sanskrit": "तस्यार्जुनः शरैस्तीक्ष्णैः कङ्कपत्रपरिच्छदैः।\nन्यपातयद्धयाञ्शीघ्रं यतमानस्य मारिष।\nधनुश्चास्यापरैश्छित्त्वा शरैः पार्थो विचक्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2052796, "chapter_id": 2166, "verse_number": "७-९३-६५", "content_sanskrit": "अम्बष्ठस्तु गदां गृह्य क्रोधपर्याकुलेक्षणः।\nआससाद रणे पार्थं केशवं च महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2052797, "chapter_id": 2166, "verse_number": "७-९३-६६", "content_sanskrit": "ततः सम्प्रहरन्वीरो गदामुद्यम्य भारत।\nरथमावार्य गदया केशवं समताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2052798, "chapter_id": 2166, "verse_number": "७-९३-६७", "content_sanskrit": "गदया ताडितं दृष्ट्वा केशवं परवीरहा।\nअर्जुनोऽथ भृशं क्रुद्धः सोऽम्बष्ठं प्रति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2052799, "chapter_id": 2166, "verse_number": "७-९३-६८", "content_sanskrit": "ततः शरैर्हेमपुङ्खैः सगदं रथिनां वरम्।\nछादयामास समरे मेघः सूर्यमिवोदितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2052800, "chapter_id": 2166, "verse_number": "७-९३-६९", "content_sanskrit": "अथापरैः शरैश्चापि गदां तस्य महात्मनः।\nअचूर्णयत्तदा पार्थस्तिदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2052801, "chapter_id": 2166, "verse_number": "७-९३-७०", "content_sanskrit": "अथ तां पतितां दृष्ट्वा गृह्यान्यां च महागदाम्।\nअर्जुनं वासुदेवं च पुनः पुनरताडयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2052802, "chapter_id": 2166, "verse_number": "७-९३-७१", "content_sanskrit": "तस्यार्जुनः क्षुरप्राभ्यां सगदावुद्यतौ भुजौ।\nचिच्छेदेन्द्रध्वजाकारौ शिरश्चान्येन पत्रिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2052803, "chapter_id": 2166, "verse_number": "७-९३-७२", "content_sanskrit": "स पपात हतो राजन्वसुधामनुनादयन्।\nइन्द्रध्वज इवोत्सृष्टो यन्त्रनिर्मुक्तबन्धनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2052804, "chapter_id": 2166, "verse_number": "७-९३-७३", "content_sanskrit": "अम्बष्ठे तु तदा भग्ने तव सैन्यमभज्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2052805, "chapter_id": 2166, "verse_number": "७-९३-७४", "content_sanskrit": "रथानीकावगाढश्च वारणाश्वशतैर्वृतः।\nअदृश्यत पदा पार्थो घनैः सूर्य इवावृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2052806, "chapter_id": 2166, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्धशदिवसयुद्धे त्रिनवतितमोऽध्यायः॥ ९३ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-९३-४३ गोयोनिप्रभवा नन्दिन्यां जाताः॥ ५-९३-४६ सृष्टिः संसृष्टिः॥ ५-९३-४७ जटिलाननान् जटिलानि रूढश्मश्रूण्याननानि येषाम्॥ ५-९३-५० प्रच्छन्नेन प्रच्छादनेन कृतो रचितः सङ्कमो यस्याम्॥ ५-९३-५१ उत्तरशोणित्तां शोणितप्रधानाम्॥ ५-९३-५३ हयान् अश्वारोहान्॥ ५-९३-९३ त्रिनवतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]