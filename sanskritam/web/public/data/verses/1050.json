[{"id": 2002404, "chapter_id": 1050, "verse_number": "१-५१-०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002405, "chapter_id": 1050, "verse_number": "१-५१-१", "content_sanskrit": "एवमुक्त्वा ततः श्रीमान्मन्त्रिभिश्चानुमीदितः।\nआरुरोह प्रतिज्ञां स सर्पसत्राय पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002406, "chapter_id": 1050, "verse_number": "१-५१-२", "content_sanskrit": "ब्रह्मन्भरतशार्दूलो राजा पारिक्षितस्तदा।\nपुरोहितमथाहूय ऋत्विजो वसुधाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002407, "chapter_id": 1050, "verse_number": "१-५१-३", "content_sanskrit": "अब्रवीद्वाक्यसंपन्नः कार्यसंपत्करं वचः।\nयो मे हिंसितवांस्तातं तक्षकः स दुरात्मवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002408, "chapter_id": 1050, "verse_number": "१-५१-४", "content_sanskrit": "प्रतिकुर्यां यथा तस्य तद्भवन्तो ब्रुवन्तु मे।\nअपि तत्कर्म विदितं भवतां येन पन्नगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002409, "chapter_id": 1050, "verse_number": "१-५१-५", "content_sanskrit": "तक्षकं संप्रदीप्तेऽग्नौ प्रक्षिपेयं सबान्धवम्।\nयथा तेन पिता मह्यं पूर्वं दग्धो विषाग्निना॥\nतथाऽहमपि तं पापं दग्धुमिच्छामि पन्नगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002410, "chapter_id": 1050, "verse_number": "१-५१-६x", "content_sanskrit": "ऋत्विज ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002411, "chapter_id": 1050, "verse_number": "१-५१-६", "content_sanskrit": "अस्ति राजन्महात्सत्रं त्वदर्थं देवनिर्मितम्।\nसर्वसत्रमिति ख्यातं पुराणे परिपठ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002412, "chapter_id": 1050, "verse_number": "१-५१-७", "content_sanskrit": "आहर्ता तस्य सत्रस्य त्वन्नान्योऽस्ति नराधिप।\nइति पौराणिकाः प्राहुरस्माकं चास्ति स क्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002413, "chapter_id": 1050, "verse_number": "१-५१-८", "content_sanskrit": "एवमुक्तः स राजर्षिर्मेने दग्धं हि तक्षकम्।\nहुताशनमुखे दीप्ते प्रविष्टमिति सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002414, "chapter_id": 1050, "verse_number": "१-५१-९", "content_sanskrit": "ततोऽब्रवीन्मन्त्रविदस्तान्राजा ब्राह्मणांस्तदा।\nआहरिष्यामि तत्सत्रं संभाराः संभ्रियन्तु मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002415, "chapter_id": 1050, "verse_number": "१-५१-१०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002416, "chapter_id": 1050, "verse_number": "१-५१-१०", "content_sanskrit": "ततस्त ऋत्विजस्तस्य शास्त्रतो द्विजसत्तम।\nतं देशं मापयामासुर्यज्ञायतनकारणात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002417, "chapter_id": 1050, "verse_number": "१-५१-११", "content_sanskrit": "यथावद्वेदविद्वांसः सर्वे बुद्धेः परंगताः।\nऋद्ध्या परमया युक्तमिष्टं द्विजगणैर्युतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002418, "chapter_id": 1050, "verse_number": "१-५१-१२", "content_sanskrit": "प्रभूतधनधान्याढ्यमृत्विग्भिः सुनिषेवितम्।\nनिर्माय चापि विधिवद्यज्ञायतनमीप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002419, "chapter_id": 1050, "verse_number": "१-५१-१३", "content_sanskrit": "राजानं दीक्षयामासुः सर्पसत्राप्तये तदा।\nइदं चासीत्तत्र पूर्वं सर्पसत्रे भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002420, "chapter_id": 1050, "verse_number": "१-५१-१४", "content_sanskrit": "निमित्तं महदुत्पन्नं यज्ञविघ्नकरं तदा।\nयज्ञस्यायतने तस्मिन्क्रियमाणे वचोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002421, "chapter_id": 1050, "verse_number": "१-५१-१५", "content_sanskrit": "स्थपतिर्बुद्धिसंपन्नो वास्तुविद्याविशारदः।\nइत्यब्रवीत्सूत्रधारः सूतः पौराणिकस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002422, "chapter_id": 1050, "verse_number": "१-५१-१६", "content_sanskrit": "यस्मिन्देशे च काले च मापनेयं प्रवर्तिता।\nब्राह्मणं कारणं कृत्वा नायं संस्थास्यते क्रतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002423, "chapter_id": 1050, "verse_number": "१-५१-१७", "content_sanskrit": "एतच्छ्रुत्वा तु राजासौ प्राग्दीक्षाकालमब्रवीत्।\nक्षत्तारं न हि मे कश्चिदज्ञातः प्रविशेदिति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002424, "chapter_id": 1050, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि एकपञ्चाशत्तमोऽध्यायः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]