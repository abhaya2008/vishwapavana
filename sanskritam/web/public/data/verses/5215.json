[{"id": 2198262, "chapter_id": 5215, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198263, "chapter_id": 5215, "verse_number": "१", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nशक्रशम्बरसंवादं तन्निबोध युधिष्ठिर\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198264, "chapter_id": 5215, "verse_number": "२", "content_sanskrit": "शक्रो ह्यज्ञातरूपेण जटी भूत्वा रजोरुणः ।\nविरूपं रूपमास्थाय प्रश्नं पप्रच्छ शम्बरम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198265, "chapter_id": 5215, "verse_number": "३", "content_sanskrit": "केन शम्बर वृत्तेन स्वजात्यानधितिष्ठसि ।\nश्रेष्ठं त्वां केन मन्यन्ते तन्मे प्रब्रूहि पृच्छतः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198266, "chapter_id": 5215, "verse_number": "", "content_sanskrit": "शम्बरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198267, "chapter_id": 5215, "verse_number": "४", "content_sanskrit": "नासूयामि सदा विप्रान् ब्रह्माणं च पितामहम् ।\nशास्त्राणि वदतो विप्रान् सम्मन्यामि यथासुखम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198268, "chapter_id": 5215, "verse_number": "५", "content_sanskrit": "श्रुत्वा च नावजानामि नापराध्यामि कर्हिचित् ।\nअभ्यर्च्याननुपृच्छामि पादौ गृह्णामि धीमताम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198269, "chapter_id": 5215, "verse_number": "६", "content_sanskrit": "ते विस्रब्धाः प्रभाषन्ते संयच्छन्ति च मां सदा ।\nप्रमत्तेष्वप्रमत्तोऽस्मि सदा सुप्तेषु जागृमि\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198270, "chapter_id": 5215, "verse_number": "७", "content_sanskrit": "ते मां शास्त्रपथे युक्तं ब्रह्मण्यमनसूयकम् ।\nसमासिञ्चन्ति शास्तारः क्षौद्रं मध्विव मक्षिकाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198271, "chapter_id": 5215, "verse_number": "८", "content_sanskrit": "यच्च भाषन्ति ते तुष्टास्तत्तद् गृह्णामि मेधया ।\nसमाधिमात्मनो नित्यमनुलोममचिन्तयन्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198272, "chapter_id": 5215, "verse_number": "९", "content_sanskrit": "सोऽहमग्रप्रशिष्टानां रसानामवलेहकः ।\nस्वजात्यानधितिष्ठामि नक्षत्राणीव चन्द्रमाः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198273, "chapter_id": 5215, "verse_number": "१०", "content_sanskrit": "एतत् पृथिव्याममृतमेतच्चक्षुरनुत्तमम् ।\nयद् ब्राह्मणमुखाच्छास्त्रमिह श्रुत्वा प्रवर्तते\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198274, "chapter_id": 5215, "verse_number": "११", "content_sanskrit": "एतत्कारणमाज्ञाय दृष्ट्वा देवासुरं पुरा ।\nयुद्धं पिता मे हृष्टात्मा विस्मितः प्रत्यपद्यत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198275, "chapter_id": 5215, "verse_number": "१२", "content_sanskrit": "दृष्ट्वा च ब्राह्मणानां तु महिमानं महात्मनाम् ।\nपर्यपृच्छत् कथमिमे सिद्धा इति निशाकरम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198276, "chapter_id": 5215, "verse_number": "", "content_sanskrit": "सोमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198277, "chapter_id": 5215, "verse_number": "१३", "content_sanskrit": "ब्राह्मणास्तपसा सर्वे सिध्यन्ते वाग्बलाः सदा ।\nभुजवीर्या हि राजानो वागस्त्राश्च द्विजातयः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2198278, "chapter_id": 5215, "verse_number": "१४", "content_sanskrit": "प्रवसन् वाऽप्यधीयीत बह्वीर्दुर्वसतीर्वसन् ।\nनिर्मन्युरपि निर्मानो यतिः स्यात् समदर्शनः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2198279, "chapter_id": 5215, "verse_number": "१५", "content_sanskrit": "अपि चेज्जातिसम्पन्नः सर्वान् वेदान् पितुर्गृहे ।\nश्लाघमान इवाधीयेद् ग्राम्य इत्येव तं विदुः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2198280, "chapter_id": 5215, "verse_number": "१६", "content_sanskrit": "भूमिरेतौ निगिरति सर्पो बिलशयानिव ।\nराजानं चाप्ययोद्धारं ब्राह्मणं चाप्रवासिनम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2198281, "chapter_id": 5215, "verse_number": "१७", "content_sanskrit": "अतिमानः श्रियं हन्ति पुरुषस्याल्पमेधसः ।\nगर्भेण दुष्यते कन्या गृहवासेन च द्विजः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2198282, "chapter_id": 5215, "verse_number": "", "content_sanskrit": "शम्बरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2198283, "chapter_id": 5215, "verse_number": "१८", "content_sanskrit": "इत्येतन्मे पिता श्रुत्वा सोमादद्भुतदर्शनात् ।\nब्राह्मणान् पूजयामास तथैवाहं महाव्रतान्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2198284, "chapter_id": 5215, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2198285, "chapter_id": 5215, "verse_number": "१९", "content_sanskrit": "श्रुत्वैतद्वचनं शक्रो दानवेन्द्रमुखाच्च्युतम् ।\nद्विजान् सम्पूजयामास महेन्द्रत्वमवाप च\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2198286, "chapter_id": 5215, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे शक्रशम्बरसंवादो नाम षट्षष्टितमोऽध्यायः ॥६६॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]