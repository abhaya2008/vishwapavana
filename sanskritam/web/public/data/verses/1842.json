[{"id": 2038516, "chapter_id": 1842, "verse_number": "५-८७-०x", "content_sanskrit": "विदुर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2038517, "chapter_id": 1842, "verse_number": "५-८७-१", "content_sanskrit": "राजन्बहुमतश्चासि त्रैलोक्यस्यापि सत्तमः।\nसंभावितश्च लोकस्य संमतश्चासि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2038518, "chapter_id": 1842, "verse_number": "५-८७-२", "content_sanskrit": "यत्त्वमेवंगते ब्रूयाः पश्चिमे वयसि स्थितः।\nशास्त्राद्वा सुप्रतर्काद्वा सुस्थिरः स्थविरो ह्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2038519, "chapter_id": 1842, "verse_number": "५-८७-३", "content_sanskrit": "लेखा शशिनिभाः सूर्ये महोर्मिरिव सागरे।\nधर्मस्त्वयि तथा राजन्निति व्यवसिताः प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2038520, "chapter_id": 1842, "verse_number": "५-८७-४", "content_sanskrit": "सदैव भावितो लोको गुणौघैस्तव पार्थिव ।\nगुणानां रक्षणे नित्यं प्रयतस्व सबान्धवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2038521, "chapter_id": 1842, "verse_number": "५-८७-५", "content_sanskrit": "आर्जवं प्रतिपद्यस्व मा बाल्याद्ब्रहु नीनशः।\nराजन्पुत्रांश्च पौत्रांश्च सुहृदश्चैव सुप्रियान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2038522, "chapter_id": 1842, "verse_number": "५-८७-६", "content_sanskrit": "यत्त्वं दित्ससि कृष्णाय राजन्नतिथये बहु ।\nएतदन्यच्च दाशार्हः पृथिवीमपि चार्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2038523, "chapter_id": 1842, "verse_number": "५-८७-७", "content_sanskrit": "न तु त्वं धर्ममुद्दिश्य तस्य वा प्रियकारणात्।\nएतद्दित्ससि कृष्णाय सत्येनात्मानमालभे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2038524, "chapter_id": 1842, "verse_number": "५-८७-८", "content_sanskrit": "मायैषा सत्यमेवैतच्छद्मैतद्भूरिदक्षिणा ।\nजानामि त्वन्मतं राजन्गूढं बाह्येन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2038525, "chapter_id": 1842, "verse_number": "५-८७-९", "content_sanskrit": "पञ्च पञ्चैव लिप्स्यन्ति ग्रामकान्पाण्डवा नृप ।\nन च दित्ससि तेभ्यस्तांस्तच्छमं न करिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2038526, "chapter_id": 1842, "verse_number": "५-८७-१०", "content_sanskrit": "अर्थेन तु महाबाहुं वार्ष्णेयं त्वं जिहीर्षसि ।\nअनेन चाप्युपायेन पाण्डवेभ्यो विभेत्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2038527, "chapter_id": 1842, "verse_number": "५-८७-११", "content_sanskrit": "न च वित्तेन शक्योऽसौ नोद्यमेन न गर्हया।\nअन्यो धनञ्जयात्कर्तुमेतत्तत्त्वं ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2038528, "chapter_id": 1842, "verse_number": "५-८७-१२", "content_sanskrit": "वेद कृष्णस्य माहात्म्यं वेदास्य दृढभक्तिताम्।\nअत्याज्यमस्य जानामि प्राणैस्तुल्यं धनञ्जयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2038529, "chapter_id": 1842, "verse_number": "५-८७-१३", "content_sanskrit": "अन्यत्कुम्भादपांपूर्णादन्यत्पादावसेचनात्।\nअन्यत्कुशलसंप्रश्नान्नैवेक्ष्यति जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2038530, "chapter_id": 1842, "verse_number": "५-८७-१४", "content_sanskrit": "यत्त्वस्य प्रियमातिथ्यं मानार्हस्य महात्मनः ।\nतदस्मै क्रियतां राजन्मानार्होऽसौ जनार्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2038531, "chapter_id": 1842, "verse_number": "५-८७-१५", "content_sanskrit": "आशंसमानः कल्याणं कुरूनभ्येति केशवः ।\nयेनैव राजन्नर्थेन तदेवास्मा उपाकुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2038532, "chapter_id": 1842, "verse_number": "५-८७-१६", "content_sanskrit": "शममिच्छति दाशार्हस्तव दुर्योधनस्य च।\nपाण्डवानां च राजेन्द्र तदस्य वचनं कुरु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2038533, "chapter_id": 1842, "verse_number": "५-८७-१७", "content_sanskrit": "पिताऽसि राजन्पुत्रास्ते वृद्धस्त्वं शिशवः परे।\nवर्तस्व पितृवत्तेषु वर्तन्ते ते हि पुत्रवत् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2038534, "chapter_id": 1842, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि सप्ताशीतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]