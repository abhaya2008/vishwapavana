[{"id": 7001903000, "chapter_id": 21903, "verse_number": "८२-१", "content_sanskrit": "ऋषिरुवाच ।\nदेवासुरमभूद् युद्धं पूर्णमब्दशतं पुरा ।\nमहिषेऽसुराणामधिपे देवानां च पुरन्दरे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001903001, "chapter_id": 21903, "verse_number": "८२-२", "content_sanskrit": "तत्रासुरैर्महावीर्यैर्देवसैन्यं पराजितम् ।\nजित्वा च सकलान् देवानिन्द्रोऽभून्महिषासुरः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001903002, "chapter_id": 21903, "verse_number": "८२-३", "content_sanskrit": "ततः पराजिता देवाः पद्मयोनिं प्रजापतिम् ।\nपुरस्कृत्य गतास्तत्र यत्रेश-गरुडध्वजौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001903003, "chapter_id": 21903, "verse_number": "८२-४", "content_sanskrit": "यथावृत्तं तयोस्तद्वन्महिषासुरचेष्टितम् ।\nत्रिदशाः कथयामासुर्देवाभिभवविस्तरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001903004, "chapter_id": 21903, "verse_number": "८२-५", "content_sanskrit": "सूर्येन्द्रग्न्यनिलेन्दूनां यमस्य वरुणस्य च ।\nअन्येषां चाधिकारान् स स्वयमेवाधितिष्ठिति ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001903005, "chapter_id": 21903, "verse_number": "८२-६", "content_sanskrit": "स्वर्गान्निराकृताः सर्वे तेन देवगणा भुवि ।\nविचरन्ति यथा मर्त्या महिषेण दुरात्मना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001903006, "chapter_id": 21903, "verse_number": "८२-७", "content_sanskrit": "एतद्वः कथितं सर्वममरारिविचेष्टितम् ।\nशरणं वः प्रपन्नाः स्मो वधस्तस्य विचिन्त्यताम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001903007, "chapter_id": 21903, "verse_number": "८२-८", "content_sanskrit": "ऋषिरुवाच ।\nइत्थं निशम्य देवानां वचांसि मधुसूदनः ।\nचकार कोपं शम्भुश्च भ्रुकुटीकुटिलाननौ ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001903008, "chapter_id": 21903, "verse_number": "८२-९", "content_sanskrit": "ततोऽतिकोपपूर्णस्य चक्रिणो वदनात्ततः ।\nनिश्चक्राम महत्तेजो ब्रह्मणः शङ्करस्य च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001903009, "chapter_id": 21903, "verse_number": "८२-१०", "content_sanskrit": "अन्येषाञ्चैव देवानां शक्रादीनां शरीरतः ।\nनिर्गतं सुमहत्तेजस्तच्चैक्यं समगच्छत ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001903010, "chapter_id": 21903, "verse_number": "८२-११", "content_sanskrit": "अतीव तेजसः कूटं ज्वलन्तमिव पर्वतम् ।\nददृशुस्ते सुरास्तत्र ज्वालाव्याप्तदिगन्तरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001903011, "chapter_id": 21903, "verse_number": "८२-१२", "content_sanskrit": "अतुलं तत्र तत्तेजः सर्वदेवशरीरजम् ।\nएकस्थं तदभून्नारी व्याप्तलोकत्रयं त्विषा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001903012, "chapter_id": 21903, "verse_number": "८२-१३", "content_sanskrit": "यदभूच्छाम्भवं तेजस्तेनाजायत तन्मुखम् ।\nयाम्येन चाभवन् केशा बहवो विष्णुतेजसा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001903013, "chapter_id": 21903, "verse_number": "८२-१४", "content_sanskrit": "सौम्येन स्तनयोर्युग्मं मध्यं चैन्द्रेण चाभवत् ।\nवारुणेन च जङ्घोरू नितम्बस्तेजसा भुवः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001903014, "chapter_id": 21903, "verse_number": "८२-१५", "content_sanskrit": "ब्रह्मणस्तेजसा पादौ तदङ्गुल्योऽर्कतेजसा ।\nवसूनाञ्च कराङ्गुल्यः कौबेरेण च नासिका ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001903015, "chapter_id": 21903, "verse_number": "८२-१६", "content_sanskrit": "तस्यास्तु दन्ताः सम्भूताः प्राजापत्येन तेजसा ।\nनयनत्रितयं जज्ञे तथा पावकतेजसा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001903016, "chapter_id": 21903, "verse_number": "८२-१७", "content_sanskrit": "भ्रुवौ च सन्ध्ययोस्तेजः श्रवणावनिलस्य च ।\nअन्येषां चैव देवानां सम्भवस्तेजसां शिवा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001903017, "chapter_id": 21903, "verse_number": "८२-१८", "content_sanskrit": "ततः समस्तदेवानां तेजोराशिसमुद्भवाम् ।\nतां विलोक्य मुदं प्रापुरमरा महिषार्दिताः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001903018, "chapter_id": 21903, "verse_number": "८२-१९", "content_sanskrit": "ततो देवा ददुस्तस्यै स्वानि स्वान्यायुधानि च ।\nऊचुर्जयजयेत्युच्चैर्जयन्तीं ते जयैषिणः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001903019, "chapter_id": 21903, "verse_number": "८२-२०", "content_sanskrit": "शूलं शूलाद्विनिष्कृष्य ददौ तस्यै पिनाकधृक् ।\nचक्रं च दत्तवान् कृष्णः समुत्पाद्य स्वचक्रतः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001903020, "chapter_id": 21903, "verse_number": "८२-२१", "content_sanskrit": "शङ्खञ्च वरुणः शक्तिं ददौ तस्यै हुताशनः ।\nमारुतो दत्तवांश्चापं बाणपूर्णे तथेषुधी ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001903021, "chapter_id": 21903, "verse_number": "८२-२२", "content_sanskrit": "वज्रमिन्द्रः समुत्पाद्य कुलिशादमराधिपः ।\nददौ तस्यै सहस्राक्षो घण्टामैरावताद् गजात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001903022, "chapter_id": 21903, "verse_number": "८२-२३", "content_sanskrit": "कालदण्डाद्यमो दण्डं माशं चाम्बुपतिर्ददौ ।\nप्रजापतिश्चाक्षमालां ददौ ब्रह्मा कमण्डलुम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001903023, "chapter_id": 21903, "verse_number": "८२-२४", "content_sanskrit": "समस्तरोमकूपेषु निजरश्मीन् दिवाकरः ।\nकालख्च दत्तवान् खड्गं तस्याश्चर्म च निर्मलम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001903024, "chapter_id": 21903, "verse_number": "८२-२५", "content_sanskrit": "क्षीरोदश्चामलं हारमजरे च तथाम्बरे ।\nचूडामणिं तथा दिव्यं कुण्डले कटकानि च ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001903025, "chapter_id": 21903, "verse_number": "८२-२६", "content_sanskrit": "अर्धचन्द्रं तथा शुभ्रं केयूरान् सर्वबाहुषु ।\nनूपुरौ विमलौ तद्वद् ग्रैवेयकमनुत्तमम् ।\nअङ्गुलीयकरत्नानि समस्तास्वङ्गुलीषु च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001903026, "chapter_id": 21903, "verse_number": "८२-२७", "content_sanskrit": "विश्वकर्मा ददौ तस्यै परशुञ्चातिनिर्मलम् ।\nअस्त्राण्यनेकरूपाणि तथाभेद्यं च दंशनम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001903027, "chapter_id": 21903, "verse_number": "८२-२८", "content_sanskrit": "अम्लानपङ्कजां मालां शिरस्युरसि चापराम् ।\nअददज्जलधिस्तस्यै पङ्कजं चातिशोभनम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001903028, "chapter_id": 21903, "verse_number": "८२-२९", "content_sanskrit": "हिमवान् वाहनं सिंहं रत्नानि विविधानि च ।\nददावशून्यं सुरया पानपात्रं धनाधिपः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001903029, "chapter_id": 21903, "verse_number": "८२-३०", "content_sanskrit": "शेषश्च सर्वनागेशो महामणिविभूषितम् ।\nनागहारं ददौ तस्यै धत्ते यः पृथिवीमिमाम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001903030, "chapter_id": 21903, "verse_number": "८२-३१", "content_sanskrit": "अन्यैरपि सुरैर्देवी भूषणैरायुधैस्तथा ।\nसंमानिता ननादोच्चैः साट्टहासं मुहुर्मुहुः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001903031, "chapter_id": 21903, "verse_number": "८२-३२", "content_sanskrit": "तस्या नादेन घोरेण कृत्स्त्रमापूरितं नभः ।\nअमायतातिमहता प्रतिशब्दो महानभूत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001903032, "chapter_id": 21903, "verse_number": "८२-३३", "content_sanskrit": "चुक्षुभुः सकला लोकाः समुद्राश्च चकम्पिरे ।\nचचाल वसुधा चेलुः सकलाश्च महीधराः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001903033, "chapter_id": 21903, "verse_number": "८२-३४", "content_sanskrit": "जयेति देवाश्च मुदा तामूचुः सिंहवाहिनीम् ।\nतुष्टुवुर्मुनयश्चैनां भक्तिनम्रात्ममूर्तयः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001903034, "chapter_id": 21903, "verse_number": "८२-३५", "content_sanskrit": "दृष्ट्वा समस्तं संक्षुब्धं त्रैलोक्यममरारयः ।\nसन्नद्धाखिलसैन्यास्ते समुत्तस्थुरुदायुधाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001903035, "chapter_id": 21903, "verse_number": "८२-३६", "content_sanskrit": "आः किमेतदिति क्रोधादाभाष्य महिषासुरः ।\nअभ्यधावत तं शब्दमशेषैरसुरैर्वृतः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001903036, "chapter_id": 21903, "verse_number": "८२-३७", "content_sanskrit": "स ददर्श ततो देवीं व्याप्तलोकत्रयां त्विषा ।\nपादाक्रान्त्या नतभुवं किरीटोल्लिखिताम्बराम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001903037, "chapter_id": 21903, "verse_number": "८२-३८", "content_sanskrit": "क्षोभिताशेषपातालां धनुर्ज्यानिः स्वनेन ताम् ।\nदिशो भुजसहस्रेण समन्ताद् व्याप्य संस्थिताम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001903038, "chapter_id": 21903, "verse_number": "८२-३९", "content_sanskrit": "ततः प्रववृते युद्धं तया देव्या सुरद्विषाम् ।\nशस्त्रास्त्रैर्बहुधा मुक्तैरादीपितदिगन्तरम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001903039, "chapter_id": 21903, "verse_number": "८२-४०", "content_sanskrit": "महिषासुरसेनानीश्चिक्षुराख्यो महासुरः ।\nयुयुधे चामरश्चान्यैश्चतुरङ्गबलान्वितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001903040, "chapter_id": 21903, "verse_number": "८२-४१", "content_sanskrit": "रथानामयुतैः षड्भिरुदग्राख्यो महासुरः ।\nअयुध्यतायुतानाञ्च सहस्रेण महाहनुः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001903041, "chapter_id": 21903, "verse_number": "८२-४२", "content_sanskrit": "पञ्चाशद्भिश्च नियुतैरसिलोमा महासुरः ।\nअयुतानां शतैः षड्भिर्वाष्कलो युयुधे रणे ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001903042, "chapter_id": 21903, "verse_number": "८२-४३", "content_sanskrit": "गजवाजिसहस्रौघैरनेकैरुग्रदर्शनः ।\nवृतो रथानां कोट्या च युद्धे तस्मिन्नयुध्यत ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001903043, "chapter_id": 21903, "verse_number": "८२-४४", "content_sanskrit": "बिडालाक्षोऽयुतानाञ्च पञ्चाशद्भिरथायुतैः ।\nयुयुधे संयुगे तत्र रथानां परिवारितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001903044, "chapter_id": 21903, "verse_number": "८२-४५", "content_sanskrit": "वृतः कालो रथानाञ्च रणे पञ्चाशतायुतैः ।\nयुयुधे संयुगे तत्र तावद्भिः परिवारितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001903045, "chapter_id": 21903, "verse_number": "८२-४६", "content_sanskrit": "अन्ये च तत्रायुतशो रथनागहयैर्वृताः ।\nयुयुधुः संयुगे देव्या सह तत्र महासुराः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001903046, "chapter_id": 21903, "verse_number": "८२-४७", "content_sanskrit": "कोटिकोटिसहस्रैस्तु रथानां दन्तिनां तथा ।\nहयानाञ्च वृतो युद्धे तत्राभून्महिषासुरः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001903047, "chapter_id": 21903, "verse_number": "८२-४८", "content_sanskrit": "तोमरैर्भिन्दिपालैश्च शक्तिभिर्मुसलैस्तथा ।\nयुयुधुः संयुगे देव्या खड्गैः परशुपट्टिशैः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001903048, "chapter_id": 21903, "verse_number": "८२-४९", "content_sanskrit": "केचिच्च चिक्षिपुः शक्तीः केचित् पाशांस्तथापरे ।\nदेवीं खड्गप्रहारैस्तु ते तां हन्तुं प्रचक्रमुः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001903049, "chapter_id": 21903, "verse_number": "८२-५०", "content_sanskrit": "सापि देवी ततस्तानि शस्त्राण्यस्त्राणि चण्डिका ।\nलीलयैव प्रचिच्छेद निजशस्त्रास्त्रवर्षिणी ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001903050, "chapter_id": 21903, "verse_number": "८२-५१", "content_sanskrit": "अनायस्तानना देवी स्तूयमाना सुरर्षिभिः ।\nमुमोचासुरदेहेषु शस्त्राण्यस्त्राणि चेश्वरी ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001903051, "chapter_id": 21903, "verse_number": "८२-५२", "content_sanskrit": "सोऽपि क्रुद्धो धुतसटो देव्या वाहनकेशरी ।\nचचारासुरसैन्येषु वनेष्विव हुताशनः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001903052, "chapter_id": 21903, "verse_number": "८२-५३", "content_sanskrit": "निश्वसान्मुमुचे यांश्च युध्यमाना रणेऽम्बिका ।\nत एव सद्यः सम्भूता गणाः शतसहस्रशः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001903053, "chapter_id": 21903, "verse_number": "८२-५४", "content_sanskrit": "युयुधुस्ते परशुभिर्भिन्दिपालासिपट्टिशैः ।\nनाशयन्तोऽसुरगणान् देवीशक्त्युपबृंहिताः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001903054, "chapter_id": 21903, "verse_number": "८२-५५", "content_sanskrit": "अवादयन्त पटहान् गणाः शङ्खांस्तथापरे ।\nमृदङ्गांश्च तथैवान्ये तस्मिन् युद्धमहोत्सवे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001903055, "chapter_id": 21903, "verse_number": "८२-५६", "content_sanskrit": "ततो देवी त्रिशूलेन गदया शक्तिवृष्टिभिः ।\nशड्गादिभिश्च शतशो निजघान महासुरान् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001903056, "chapter_id": 21903, "verse_number": "८२-५७", "content_sanskrit": "पातयामास चैवान्यान् घण्टास्वनविमोहितान् ।\nअसुरान् भुवि पाशेन बद्ध्वा चान्यानकर्षयत् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001903057, "chapter_id": 21903, "verse_number": "८२-५८", "content_sanskrit": "केचिद् द्विधा कृतास्तीक्ष्णैः खड्गपातैस्तथापरे ।\nविपोथिता निपातेन गदया भुवि शेरते ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001903058, "chapter_id": 21903, "verse_number": "८२-५९", "content_sanskrit": "वेमुश्च केचिद्रुधिरं मुसले भृशं हताः ।\nकेचिन्नपातिता भूमौ भिन्नाः शूलेन वक्षसि ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001903059, "chapter_id": 21903, "verse_number": "८२-६०", "content_sanskrit": "निरन्तराः शरौघेण कृताः केचिद्रणाजिरे ।\nशैलानुकारिणः प्राणान् मुमुचुस्त्रिदशार्दनाः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001903060, "chapter_id": 21903, "verse_number": "८२-६१", "content_sanskrit": "केषाञ्चिद्वाहवश्छिन्नाश्छिन्नग्रीवास्तथापरे ।\nशिरांसि पेतुरन्येषामन्ये मध्ये विदारिताः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001903061, "chapter_id": 21903, "verse_number": "८२-६२", "content_sanskrit": "विच्छिन्नजङ्घास्त्वपरे पेतुरुर्व्यां महासुराः ।\nएकबाह्वक्षिचरणाः केचिद्देव्या द्विधा कृताः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001903062, "chapter_id": 21903, "verse_number": "८२-६३", "content_sanskrit": "छिन्नेऽपि चान्ये शिरसि पतिताः पुनरुत्थिताः ।\nकबन्धा युयुधुर्देव्या गृहीतपरमायुधाः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001903063, "chapter_id": 21903, "verse_number": "८२-६४", "content_sanskrit": "ननृतुश्चापरे तत्र युद्धे तूर्यलयाश्रिताः ।\nकबन्धाश्छिन्नखिरसः खड्ग-शक्त्यृष्टिपाणयः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001903064, "chapter_id": 21903, "verse_number": "८२-६५", "content_sanskrit": "तिष्ठ तिष्ठेति भाषन्तो देवीमन्ये महासुराः ।\nरुधिरौघविलुप्ताङ्गाः संग्रामे लोमहर्षणे ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001903065, "chapter_id": 21903, "verse_number": "८२-६६", "content_sanskrit": "पातितै रथनागाश्वैरसुरैश्च वसुन्धरा ।\nअगम्या साभवत् तत्र यत्राभूत् स महारणः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001903066, "chapter_id": 21903, "verse_number": "८२-६७", "content_sanskrit": "शोणितौघा महानद्यः सद्यस्तत्र विसुस्त्रुवुः ।\nमध्ये चासुरसैन्यस्य वारणासुरवाजिनाम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001903067, "chapter_id": 21903, "verse_number": "८२-६८", "content_sanskrit": "क्षणेन तन्महासैन्यमसुराणां तथाम्बिका ।\nनिन्ये क्षयं यथा वह्निस्तृणदारुमहाचयम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001903068, "chapter_id": 21903, "verse_number": "८२-६९", "content_sanskrit": "स च सिंहो महानादमुत्सृजन् धुतकेसरः ।\nशरीरेभ्योऽमरारीणामसूनिव विचिन्वति ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001903069, "chapter_id": 21903, "verse_number": "८२-७०", "content_sanskrit": "देव्या गणैश्च तैस्तत्र कृतं युद्धं तथासुरैः ।\nयथैषां तुतुषुर्देवाः पुष्पवृष्टिमुचो दिवि ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]