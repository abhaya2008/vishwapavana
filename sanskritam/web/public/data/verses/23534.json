[{"id": 7003534000, "chapter_id": 23534, "verse_number": "१७४-१", "content_sanskrit": "श्रीवराह उवाच ।\nपुनरन्यत्प्रवक्ष्यामि महापातकनाशनम् ।\nसंगमस्य प्रभावं हि पापिनामपि मुक्तिदम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003534001, "chapter_id": 23534, "verse_number": "१७४-२", "content_sanskrit": "अत्रैव श्रूयते पूर्वं ब्राह्मणः संशितव्रतः ।\nमहानामेति विख्यातः स्थितोऽसौ वनमाश्रितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003534002, "chapter_id": 23534, "verse_number": "१७४-३", "content_sanskrit": "स्वाध्याययुक्तो होमे च नित्ययुक्तः सः योगवित् ।\nजपहोमपरो नित्यं स्वकालं क्षपते च सः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003534003, "chapter_id": 23534, "verse_number": "१७४-४", "content_sanskrit": "एवं कर्माणि कुर्वन्स ब्रह्मलोकजिगीषया।\nबहून्यब्दान्यतीतानि ब्राह्मणस्य वने तदा ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003534004, "chapter_id": 23534, "verse_number": "१७४-५", "content_sanskrit": "तस्य बुद्धिरियं जाता तीर्थाभिगमनं प्रति ।\nपुनस्तीर्थजलैरेतत्क्षालयामि कलेवरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003534005, "chapter_id": 23534, "verse_number": "१७४-६", "content_sanskrit": "प्रयातो विधिवत्साक्षात् सूर्यस्योदयनं प्रति ।\nअसिकुण्डादितः कृत्वा दक्षिणां कोटिकां ततः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003534006, "chapter_id": 23534, "verse_number": "१७४-७", "content_sanskrit": "तथा चोत्तरकोट्यां तु तथा मन्माथुरं च यत् ।\nक्रमेण सर्वतीर्थानि स्नात्वा मामपि पुष्करम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003534007, "chapter_id": 23534, "verse_number": "१७४-८", "content_sanskrit": "गत्वा सर्वाणि तीर्थानि स्नात्वा पूतो भवाम्यहम् ।\nइति कृत्वा मथुराया निर्जगामाथ स द्विजः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003534008, "chapter_id": 23534, "verse_number": "१७४-९", "content_sanskrit": "कृतपूजानमस्कारः अध्वानं प्रत्यपद्यत ।\nअध्वप्रपन्नो ह्यदृशत्पंचप्रेतान्सुभीषणान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003534009, "chapter_id": 23534, "verse_number": "१७४-१०", "content_sanskrit": "अरण्ये कण्टकवृते निर्जने शब्दवर्जिते ।\nतान्दृष्ट्वा विकृताकारानतितीव्रभयङ्करान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003534010, "chapter_id": 23534, "verse_number": "१७४-११", "content_sanskrit": "ईषदुत्त्रस्तहृदयस्तिष्ठदुन्मील्य चक्षुषी ।\nआलम्ब्य स ततो धैर्यं त्रासमुत्सृज्य दूरतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003534011, "chapter_id": 23534, "verse_number": "१७४-१२", "content_sanskrit": "पप्रच्छ मधुरालापः के यूयं रौद्रमूर्त्तयः ।\nभवन्तः कर्मणा केन दुष्कृतेन भयावहाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003534012, "chapter_id": 23534, "verse_number": "१७४-१३", "content_sanskrit": "एकस्थानात्सदा यूयं प्रस्थिताः कुत्र वा सदा ।\nप्रेता ऊचुः ।\nक्षुत्पिपासातुरा नित्यं बहुदुःखसमन्विताः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003534013, "chapter_id": 23534, "verse_number": "१७४-१४", "content_sanskrit": "दुर्बुद्ध्या च वृताः सर्वे हीनज्ञाना विचेतसः ।\nन जानीमो दिशं काचिद्विदिशं चापि चाध्वनि ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003534014, "chapter_id": 23534, "verse_number": "१७४-१५", "content_sanskrit": "नान्तरिक्षं महीं चापि जानीमो दिवसं तथा ।\nयदेतद्दुःखमापन्नं सुखोदर्कफलं भवेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003534015, "chapter_id": 23534, "verse_number": "१७४-१६", "content_sanskrit": "अप्रकाममिदं भाति भास्करोदयनं प्रति ।\nअहं पर्युषितो नाम परः सूचीमुखस्ततः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003534016, "chapter_id": 23534, "verse_number": "१७४-१७", "content_sanskrit": "शीघ्रगो रोधकश्चैव पंचमो लेखकस्तथा ।\nब्राह्मण उवाच ।\nप्रेतानां कर्मजातानां नाम्नां वै सम्भवः कुतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003534017, "chapter_id": 23534, "verse_number": "१७४-१८", "content_sanskrit": "किं तत्कारणमेतद्धि यूयं सर्वे सनामकाः ।\nप्रेत उवाच ।\nअहं स्वादु सदाश्नामि दद्मि पर्युषितं द्विजे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003534018, "chapter_id": 23534, "verse_number": "१७४-१९", "content_sanskrit": "एतत्कारणमुद्दिश्य नाम पर्युषितं द्विज ।\nसूचीता बहवोऽनेन विप्राश्चान्नादिकांक्षिणः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003534019, "chapter_id": 23534, "verse_number": "१७४-२०", "content_sanskrit": "एतत्कारणमुद्दिश्य परः सूचीमुखस्ततः ।\nसमर्थितो द्विजेनैव शीघ्रं याति यतो हि सः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003534020, "chapter_id": 23534, "verse_number": "१७४-२१", "content_sanskrit": "एतत्कारणमुद्दिश्य शीघ्रगस्तेन सोच्यते ।\nएको गृहस्य मध्ये तु भुङ्क्ते द्विजभयेन हि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003534021, "chapter_id": 23534, "verse_number": "१७४-२२", "content_sanskrit": "समारुह्योद्विग्नमना रोधकस्तेन चोच्यते ।\nमौनेनापि स्थितो नित्यं याचितोऽपि लिखेन्महीम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003534022, "chapter_id": 23534, "verse_number": "१७४-२३", "content_sanskrit": "अस्माकमपि पापिष्ठो लेखकस्तेन नाम वै ।\nमदेन लेखको याति रोधकस्तु ह्यवाक्छिराः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003534023, "chapter_id": 23534, "verse_number": "१७४-२४", "content_sanskrit": "शीघ्रगः पङ्गुतां प्राप्तः परं सूचीमुखस्ततः ।\nउषितः केवलग्रीवो लम्बौष्ठो वै महोदरः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003534024, "chapter_id": 23534, "verse_number": "१७४-२५", "content_sanskrit": "बृहद्वृषणशुष्काङ्गः पापादेव प्रजायते ।\nएतत्ते सर्वमाख्यातमात्मवृत्तान्त सम्भवम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003534025, "chapter_id": 23534, "verse_number": "१७४-२६", "content_sanskrit": "यदि ते श्रवणे श्रद्धा पृच्छ चान्यद्यदिच्छसि ।\nब्राह्मण उवाच ।\nये जीवा भुवि तिष्ठन्ति सर्व आहारजीविनः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003534026, "chapter_id": 23534, "verse_number": "१७४-२७", "content_sanskrit": "युष्माकमपि चाहारं श्रोतुमिच्छामि तत्त्वतः ।\nप्रेता ऊचुः ।\nशृणु चाहारमस्माकं सर्वभूतदयापर ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003534027, "chapter_id": 23534, "verse_number": "१७४-२८", "content_sanskrit": "यच्छ्रुत्वा निन्दसे नित्यं भूयो भूयश्च नित्यशः ।\nश्लेष्ममूत्रपुरीषेण योषितां च समन्ततः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003534028, "chapter_id": 23534, "verse_number": "१७४-२९", "content_sanskrit": "गृहाणि त्यक्तशौचानि प्रेता भुञ्जन्ति तत्र वै ।\nबलिमन्त्रविहीनानि दानहीनानि यानि च ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003534029, "chapter_id": 23534, "verse_number": "१७४-३०", "content_sanskrit": "गुरवो नैव पूज्यन्ते स्त्रीजितानि गृहाणि च ।\nयानि प्रकीर्णभाण्डानि प्रकीर्णोच्छेषणानि च ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003534030, "chapter_id": 23534, "verse_number": "१७४-३१", "content_sanskrit": "नित्यं च कलहो यत्र प्रेता भुञ्जन्ति तत्र वै ।\nअपात्रे प्रतिदत्तानि विधिहीनानि यानि च ।\nनिन्दितानां द्विजातीनां जुगुप्सितकुलोद्भवे ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003534031, "chapter_id": 23534, "verse_number": "१७४-३२", "content_sanskrit": "जातानां विहितानां च दुष्कृतं कर्म कुर्वताम् ।\nतेभ्यो दत्तं तदस्माकमुपतिष्ठति भोजने ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003534032, "chapter_id": 23534, "verse_number": "१७४-३३", "content_sanskrit": "एतत्पापतरं चान्यद्भोजनं दुष्टकर्मिणाम् ।\nनिर्विण्णाः प्रेतभावेन पृच्छामः सुदृढव्रत ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003534033, "chapter_id": 23534, "verse_number": "१७४-३४", "content_sanskrit": "प्रेतो यथा न भवति तथा ब्रूहि तपोधन ।\nब्राह्मण उवाच ।\nएकरात्रत्रिरात्रेण कृच्छ्रचान्द्रायणादिभिः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003534034, "chapter_id": 23534, "verse_number": "१७४-३५", "content_sanskrit": "व्रतैरभ्युद्यतः पूतो न प्रेतो जायते नरः ।\nमिष्टान्नपानदाता च सततं श्रद्धयान्वितः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003534035, "chapter_id": 23534, "verse_number": "१७४-३६", "content_sanskrit": "यतीनां पूजको नित्यं न प्रेतो जायते नरः ।\nत्रीनद्भिः पंच चैकं वा प्रतिनित्यं तु पोषयेत् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003534036, "chapter_id": 23534, "verse_number": "१७४-३७", "content_sanskrit": "सर्वभूतदयालुश्च न प्रेतो जायते नरः ।\nदेवातिथिषु पूजासु गुरुपूजासु नित्यशः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003534037, "chapter_id": 23534, "verse_number": "१७४-३८", "content_sanskrit": "रतो वै पितृपूजायां न प्रेतो जायते नरः ।\nजितक्रोधो ह्यमात्सर्यस्तृष्णासङ्गविवर्जितः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003534038, "chapter_id": 23534, "verse_number": "१७४-३९", "content_sanskrit": "क्षमायुक्तो दानशीलो न प्रेतो जायते नरः ।\nएकादशीं सितां कृष्णां सप्तमीं वा चतुर्दशीम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003534039, "chapter_id": 23534, "verse_number": "१७४-४०", "content_sanskrit": "उपवासपरो नित्यं न स प्रेतोऽभिजायते ।\nगां ब्राह्मणं च तीर्थानि पर्वतांश्च नदीस्तथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003534040, "chapter_id": 23534, "verse_number": "१७४-४१", "content_sanskrit": "देवांश्च वन्दते नित्यं न प्रेतो जायते हि सः ।\nप्रेता ऊचुः ।\nत्वत्तस्तच्छ्रुतमस्माभिर्यो न प्रेतोऽभिजायते ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003534041, "chapter_id": 23534, "verse_number": "१७४-४२", "content_sanskrit": "प्रेतस्तु जायते केन तद्वद त्वं महामुने ।\nविप्र उवाच ।\nशूद्रान्नेन तु भुक्तेन ब्राह्मणो म्रियते यदि ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003534042, "chapter_id": 23534, "verse_number": "१७४-४३", "content_sanskrit": "तेनैव चोदरस्थेन स प्रेतो जायते ध्रुवम् ।\nनग्नकापालिपाषण्डसङ्गतासनभोजनैः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003534043, "chapter_id": 23534, "verse_number": "१७४-४४", "content_sanskrit": "मनुष्यः प्रेततां याति स्पर्शेन सुतरां तथा ।\nपूर्वपुण्यं विनश्येत्तु प्रेतो भवति नित्यशः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003534044, "chapter_id": 23534, "verse_number": "१७४-४५", "content_sanskrit": "पाषण्डाश्रमसंस्थश्च मद्यपः पारदारिकः ।\nवृथामांसरतो नित्यं स च प्रेतोऽभिजायते ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003534045, "chapter_id": 23534, "verse_number": "१७४-४६", "content_sanskrit": "देवस्वं ब्राह्मणस्वं च गुरोर्द्रव्यं हरेत्तु यः ।\nकन्यां ददाति शुल्केन स च प्रेतोऽभिजायते ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003534046, "chapter_id": 23534, "verse_number": "१७४-४७", "content_sanskrit": "मातरं पितरं भ्रातृभगिन्यौ च स्त्रियं सुतम् ।\nअदुष्टान्यस्त्यजेत्सोऽपि प्रेतो भवति च ध्रुवम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003534047, "chapter_id": 23534, "verse_number": "१७४-४८", "content_sanskrit": "अयाज्ययाजनाच्चैव याज्यानां परिवर्जनात् ।\nरतो वा शूद्रसेवायां स प्रेतो जायते नरः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003534048, "chapter_id": 23534, "verse_number": "१७४-४९", "content_sanskrit": "ब्रह्महा च कृतघ्नश्च गोघ्नो वै पञ्चपातकी ।\nभूमिकन्यापहर्ता च स प्रेतो जायते नरः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003534049, "chapter_id": 23534, "verse_number": "१७४-५०", "content_sanskrit": "गुरोर्धर्म्मोपदेष्टुश्च नित्यं हितमभीप्सतः ।\nन करोति वचस्तस्य स प्रेतो जायते नरः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003534050, "chapter_id": 23534, "verse_number": "१७४-५१", "content_sanskrit": "असद्भ्यः प्रतिगृह्णाति नास्तिकेभ्यो विशेषतः ।\nस पापो जायते प्रेत आहारादिविवर्जितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003534051, "chapter_id": 23534, "verse_number": "१७४-५२", "content_sanskrit": "प्रेता ऊचुः ।\nय एतत्कर्म कुर्वन्ति मूढाऽधर्मपरायणाः ।\nविरुद्धकारिणः पापास्तेषां कांचिद्गतिं वद ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003534052, "chapter_id": 23534, "verse_number": "१७४-५३", "content_sanskrit": "ब्राह्मण उवाच ।\nये धर्मविमुखा मूढा दयादानविवर्जिताः ।\nतेषां गतिर्भवेदेका मथुरायान्तु सङ्गमे ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003534053, "chapter_id": 23534, "verse_number": "१७४-५४", "content_sanskrit": "श्रवणद्वादशीयोगे मासि भाद्रपदे तथा ।\nवामनं तत्र देवं तु पूजयेज्जुहुयात्तथा ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003534054, "chapter_id": 23534, "verse_number": "१७४-५५", "content_sanskrit": "सुवर्णमन्नं वस्त्रं च च्छत्रोपानत्सुसंयुतम् ।\nतत्र स्नातो पितॄंस्तर्प्य दत्त्वा करकमेव च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003534055, "chapter_id": 23534, "verse_number": "१७४-५६", "content_sanskrit": "न ते प्रेता भविष्यन्ति मार्गस्थो यो नमस्यते ।\nविमानवरमारुह्य विष्णुलोकं स गच्छति ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003534056, "chapter_id": 23534, "verse_number": "१७४-५७", "content_sanskrit": "तत्र तीर्थे नरः स्नातो हृष्टपुष्टो यथाश्रुतः ।\nध्यातश्च कीर्त्तितो वापि तेन गङ्गावगाहिता ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003534057, "chapter_id": 23534, "verse_number": "१७४-५८", "content_sanskrit": "तीर्थस्यैव तु माहात्म्यं प्रेतो भूत्वा शृणोति यः ।\nतस्याक्षयपदं विष्णोर्भवतीति मया श्रुतम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003534058, "chapter_id": 23534, "verse_number": "१७४-५९", "content_sanskrit": "प्रेता ऊचुः ।\nअस्माकं वद कल्याण व्रतस्यास्य विधिं परम् ।\nयेन वै क्रियमाणेन प्रेतत्वात्तु विमुच्यते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003534059, "chapter_id": 23534, "verse_number": "१७४-६०", "content_sanskrit": "ब्राह्मण उवाच ।\nएवमेव व्रतस्यास्य विधानं कर्मसंहितम् ।\nपुराणं कथितं राज्ञे मान्धात्रे पृच्छते पुरा ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003534060, "chapter_id": 23534, "verse_number": "१७४-६१", "content_sanskrit": "वसिष्ठेन महाभागाः शृणुध्वं कथयाम्यहम् ।\nप्रेतानां मोक्षणं पुण्यं गतिप्रवरदायकम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003534061, "chapter_id": 23534, "verse_number": "१७४-६२", "content_sanskrit": "मासि भाद्रपदे शुद्धा द्वादशी श्रवणान्विता ।\nतस्यां दत्तं हुतं स्नानं सर्वं लक्षगुणं भवेत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003534062, "chapter_id": 23534, "verse_number": "१७४-६३", "content_sanskrit": "सङ्गमे च पुनः स्नात्वा पूजयित्वा तु वामनम् ।\nकलशं विधिना दत्त्वा तस्य पुण्यफलं शृणु ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003534063, "chapter_id": 23534, "verse_number": "१७४-६४", "content_sanskrit": "कपिलानां शतं दत्त्वा हिरण्योपस्कराञ्चितम् ।\nतेन यत्फलमाप्नोति तद्द्वादश्यामखण्डितम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003534064, "chapter_id": 23534, "verse_number": "१७४-६५", "content_sanskrit": "राक्षसत्वं न गच्छेत्तु श्रवणद्वादशीव्रतात् ।\nस्वर्गे च वसते तावद्यावदिन्द्राश्चतुर्दश ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003534065, "chapter_id": 23534, "verse_number": "१७४-६६", "content_sanskrit": "ततः स्वर्गात्परिभ्रष्टो ब्राह्मणो वेदपारगः ।\nजातिस्मरो महायोगी मोक्षमार्गपरायणः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003534066, "chapter_id": 23534, "verse_number": "१७४-६७", "content_sanskrit": "ध्यानयुक्तेन भावेन मुक्तो यात्यपुनर्भवम् ।\nकनकं च सुसंपीतं सान्नं रत्नसमन्वितम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003534067, "chapter_id": 23534, "verse_number": "१७४-६८", "content_sanskrit": "यथालाभोपपन्नेन सौवर्णो वामनः  कृतः ।\nउपानच्छत्रसंयुक्तो विधिमन्त्रपुरःसरः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003534068, "chapter_id": 23534, "verse_number": "१७४-६९", "content_sanskrit": "कृत्वा च विधिवत्तस्य स्नानपूजादिकं नरः ।\nमन्त्रैस्तथाविधैर्होमैर्ब्राह्मणं चोपपादयेत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003534069, "chapter_id": 23534, "verse_number": "१७४-७०", "content_sanskrit": "आगच्छ वरदानन्त श्रीपते मदनुग्रहात् ।\nसर्वगोपि निजांशेन स्थानमेतदलङ्कुरु ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003534070, "chapter_id": 23534, "verse_number": "१७४-७१", "content_sanskrit": "(आवाहनम्)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003534071, "chapter_id": 23534, "verse_number": "१७४-७२", "content_sanskrit": "यत्त्वं नक्षत्ररूपेण दवादश्यां नभसि स्थितः ।\nतन्नक्षत्रमहं वन्दे मनोवाञ्छितसिद्धये ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003534072, "chapter_id": 23534, "verse_number": "१७४-७३", "content_sanskrit": "( नक्षत्रम्)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003534073, "chapter_id": 23534, "verse_number": "१७४-७४", "content_sanskrit": "नमः कमलनाभाय कमलालय केशव ।\n( स्नानम् )", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003534074, "chapter_id": 23534, "verse_number": "१७४-७५", "content_sanskrit": "अमूर्त्ते सर्वतोव्यापिन्नारायण नमोऽस्तु ते ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003534075, "chapter_id": 23534, "verse_number": "१७४-७६", "content_sanskrit": "सर्वव्यापिन्जगद्योने नमः सर्वमयाच्युत ।\n( पूजा)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003534076, "chapter_id": 23534, "verse_number": "१७४-७७", "content_sanskrit": "श्रवणद्वादशीयोगे पूजां गृह्णीष्व केशव ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003534077, "chapter_id": 23534, "verse_number": "१७४-७८", "content_sanskrit": "धूपोऽयं देवदेवेश शंखचक्रगदाधर ।\n(धूपं) अच्युतानन्त गोविन्द वासुदेव नमोऽस्तु ते ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003534078, "chapter_id": 23534, "verse_number": "१७४-७९", "content_sanskrit": "तेजसा सर्वलोकाश्च विवृताः सन्तु तेऽव्ययाः ।\n( दीपम्)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003534079, "chapter_id": 23534, "verse_number": "१७४-८०", "content_sanskrit": "त्वं हि सर्वगतं तेजो जनार्दन नमोऽस्तु ते ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7003534080, "chapter_id": 23534, "verse_number": "१७४-८१", "content_sanskrit": "अदितेर्गर्भमाधाय वैरोचनिशमाय च ।\nत्रिभिः क्रमैर्जिता लोका वामनाय नमोऽस्तु ते ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7003534081, "chapter_id": 23534, "verse_number": "१७४-८२", "content_sanskrit": "देवानां सम्मतश्चापि योगिनां परमां गतिः ।\nजलशायी जगद्योने अर्घ्यं मे प्रति गृह्यताम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7003534082, "chapter_id": 23534, "verse_number": "१७४-८३", "content_sanskrit": "हव्यभुग्घव्यकर्त्ता त्वं होता हव्यं त्वमेव च ।\nसर्वमूर्त्ते जगद्योने नमस्ते केशवाय च ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7003534083, "chapter_id": 23534, "verse_number": "१७४-८४", "content_sanskrit": "हिरण्यमन्नं त्वं देव जलवस्त्रमयो भवान्॥( दक्षिणाम्)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7003534084, "chapter_id": 23534, "verse_number": "१७४-८५", "content_sanskrit": "उपानच्छत्रदानेन प्रीतो भव जनार्दन ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7003534085, "chapter_id": 23534, "verse_number": "१७४-८६", "content_sanskrit": "पर्जन्यो वरुणः सूर्यः सलिलं केशवः शिवः ।\nअग्निर्वैश्रवणो देवः पापं हरतु मेऽव्ययः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7003534086, "chapter_id": 23534, "verse_number": "१७४-८७", "content_sanskrit": "अन्नं प्रजापतिर्विष्णुरुद्रचन्द्रेन्द्रभास्कराः ।\nअन्नं त्वष्टा यमोऽग्निश्च पापं हरतु मेऽव्ययः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7003534087, "chapter_id": 23534, "verse_number": "१७४-८८", "content_sanskrit": "वामनो बुद्धिदाता च द्रवस्थो वामनः स्वयम् ।\nवामनस्तारकोभाभ्यां वामनाय नमोऽस्तु ये ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7003534088, "chapter_id": 23534, "verse_number": "१७४-८९", "content_sanskrit": "वामनं प्रतिगृह्णामि वामनो मे प्रयच्छति ।\nवामनस्तारकोभाभ्यां वामनाय नमो नमः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7003534089, "chapter_id": 23534, "verse_number": "१७४-९०", "content_sanskrit": "कपिलाङ्गेषु तिष्ठन्ति भुवनानि चतुर्दश ।\nदत्त्वा कामदुघां लोका भवन्ति सफला नृणाम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7003534090, "chapter_id": 23534, "verse_number": "१७४-९१", "content_sanskrit": "मम पापच्छिदे तुभ्यं देवगर्भ सुपूजित ।\nमया विसर्जितो देव स्थानमन्यदलङ्कुरु ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7003534091, "chapter_id": 23534, "verse_number": "१७४-९२", "content_sanskrit": "एवं विद्वांस्तु द्वादश्यां यो नरः श्रद्धयान्वितः ।\nयत्र तत्र नभस्ये तु कृत्वा फलमवाप्नुयात् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7003534092, "chapter_id": 23534, "verse_number": "१७४-९३", "content_sanskrit": "ब्राह्मण उवाच ।\nयस्तु सारस्वते तीर्थे यमुनायाश्च सङ्गमे ।\nकरोति विधिनानेन तस्य पुण्यं शतोत्तरम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7003534093, "chapter_id": 23534, "verse_number": "१७४-९४", "content_sanskrit": "मयापि श्रद्धया चैतत्कालं तीर्थस्य सेवनम् ।\nक्षेत्रसंन्यासरूपेण कृतभक्तिसमन्वितम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7003534094, "chapter_id": 23534, "verse_number": "१७४-९५", "content_sanskrit": "येन यूयं न शक्ता मां बाधितुं पापकर्मिणः ।\nश्रवणद्वादशीयोगे व्रतं तिथिसमन्वितम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7003534095, "chapter_id": 23534, "verse_number": "१७४-९६", "content_sanskrit": "तावद्व्रतं तु कर्त्तव्यं यावदेकं क्षयं व्रजेत् ।\nतीर्थस्यैव प्रभावो हि प्रत्यक्षमिह दृश्यते ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7003534096, "chapter_id": 23534, "verse_number": "१७४-९७", "content_sanskrit": "श्रवणाद्वो गतिः साक्षात्साधु लक्ष्यामि चाऽधुना ।\nश्रीवराह उवाच ।\nएवं ब्रुवति विप्रे तु आकाशे दुन्दुभिस्वनः ।\nपुष्पवृष्टिर्भुव्यपतद्देवैर्मुक्ता सहस्रशः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7003534097, "chapter_id": 23534, "verse_number": "१७४-९८", "content_sanskrit": "प्रेतानां तु विमानानि आगतानि समन्ततः ।\nदेवदूत उवाचेदं प्रेतानां शृण्वतां तदा ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7003534098, "chapter_id": 23534, "verse_number": "१७४-९९", "content_sanskrit": "अस्य विप्रस्य सम्भाषात्पुण्यसत्कीर्त्तितेन च ।\nप्रेतभावविमुक्ताः स्थ तीर्थस्य श्रवणादपि ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7003534099, "chapter_id": 23534, "verse_number": "१७४-१००", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन सता सम्भाषणं वरम् ।\nकर्त्तव्यस्तीर्थभावश्च व्रतभावश्च मानसे ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7003534100, "chapter_id": 23534, "verse_number": "१७४-१०१", "content_sanskrit": "तीर्थाभिषेकिपुरुषाद्यथा तेषां दुरात्मनाम् ।\nप्रेतानामक्षयः स्वर्गः सरस्वत्याश्च सङ्गमात् ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7003534101, "chapter_id": 23534, "verse_number": "१७४-१०२", "content_sanskrit": "प्राप्तं तीर्थप्रभावस्य श्रवणान्मुक्तिदं फलम् ।\nतिलकं सर्वधर्माणां पंचप्रेतत्वमुक्तिदम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7003534102, "chapter_id": 23534, "verse_number": "१७४-१०३", "content_sanskrit": "यः पठेत्परया भक्त्या शृणुयाद्भक्तितत्परः ।\nकरोति श्रद्धया युक्तो न प्रेतो जायते नरः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7003534103, "chapter_id": 23534, "verse_number": "१७४-१०४", "content_sanskrit": "पिशाचसंज्ञकं नाम तीर्थं त्रैलोक्यविश्रुतम् ।\nयस्य श्रवणमात्रेण न प्रेतो जायते नरः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7003534104, "chapter_id": 23534, "verse_number": "१७४-१०५", "content_sanskrit": "इति श्रीवराहपुराणे मधु०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}]