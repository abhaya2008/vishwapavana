[{"id": 2084019, "chapter_id": 2787, "verse_number": "१२-२९२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2084020, "chapter_id": 2787, "verse_number": "१२-२९२-१", "content_sanskrit": "शोकाद्दुःखाच्च मृत्योश्च त्रसन्ते प्राणिनः सदा।\nउभयं नो यथा न स्यात्तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2084021, "chapter_id": 2787, "verse_number": "१२-२९२-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2084022, "chapter_id": 2787, "verse_number": "१२-२९२-२", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nनारदस्य च संवादं समङ्गस्य च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2084023, "chapter_id": 2787, "verse_number": "१२-२९२-३x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2084024, "chapter_id": 2787, "verse_number": "१२-२९२-३", "content_sanskrit": "उरसेव प्रणमसे बाहुभ्यां तरसीव च।\nसंप्रहृष्टमना नित्यं विशोक इव लक्ष्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2084025, "chapter_id": 2787, "verse_number": "१२-२९२-४", "content_sanskrit": "उद्वेगं न हि ते किंचित्सुसूक्ष्ममपि लक्षये।\nनित्यतृप्त इव स्वस्थो बालवच्च विचेष्टसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2084026, "chapter_id": 2787, "verse_number": "१२-२९२-५x", "content_sanskrit": "समङ्ग उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2084027, "chapter_id": 2787, "verse_number": "१२-२९२-५", "content_sanskrit": "भूतं भव्यं भविष्यच्च सर्वभूतेषु नारद।\nतेषां तत्त्वानि जानामि ततो न विमना ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2084028, "chapter_id": 2787, "verse_number": "१२-२९२-६", "content_sanskrit": "उपक्रमानहं वेद पुनरेव फलोदयान्।\nलोके फलानि चित्राणि ततो न विमना ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2084029, "chapter_id": 2787, "verse_number": "१२-२९२-७", "content_sanskrit": "अनाथाश्चाप्रतिष्ठाश्च गतिमन्तश्च नारद।\nअन्धा जडाश्च जीवन्ति पश्यास्मानपि जीवतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2084030, "chapter_id": 2787, "verse_number": "१२-२९२-८", "content_sanskrit": "विहितेनैव जीवन्ति अरोगाङ्गा दिवौकसः।\nबलवन्तोऽबलाश्चैव तद्वदस्मान्सभाजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2084031, "chapter_id": 2787, "verse_number": "१२-२९२-९", "content_sanskrit": "सहस्रिणोऽपि जीवन्ति जीवन्ति शतिनस्तथा।\nशाकेन चान्ये जीवन्ति पश्यास्मानपि जीवतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2084032, "chapter_id": 2787, "verse_number": "१२-२९२-१०", "content_sanskrit": "यदा न शोचेमहि किं नु नः स्या\nद्धर्मेण वा नारद कर्मणा वा।\nकृतान्तवश्यानि यदा सुखानि\nदुःखानि वा यन्न विधर्षयन्ति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2084033, "chapter_id": 2787, "verse_number": "१२-२९२-११", "content_sanskrit": "यस्मै प्राज्ञाः कथयन्ते मनुष्याः\nप्रज्ञामूलं हीन्द्रियाणां प्रसादः।\nमुह्यन्ति शोचन्ति तथेन्द्रियाणि\nप्रज्ञालाभो नास्ति मूढेन्द्रियस्य॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2084034, "chapter_id": 2787, "verse_number": "१२-२९२-१२", "content_sanskrit": "मूढस्य दर्पः स पुनर्मोह एव\nमूढस्य नायं न परोऽस्ति लोकः।\nन ह्येव दुःखानि सदा भवन्ति\nसुखस्य वा नित्यशो लाभ एव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2084035, "chapter_id": 2787, "verse_number": "१२-२९२-१३", "content_sanskrit": "भावात्मकं संपरिवर्तमानं\nन मादृशः संज्वरं जातु कुर्यात्।\nइष्टान्भोगान्नानुरुध्येत्सुखं वा\nन चिन्तयेद्दुःखमभ्यागतं वा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2084036, "chapter_id": 2787, "verse_number": "१२-२९२-१४", "content_sanskrit": "समाहितो न स्पृहयेत्परेषां\nनानागतं चाभिनन्देच्च लाभम्।\nन चापि हृष्येद्विपुलेऽर्थलाभे\nतथाऽर्थनाशे च न वै विषीदेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2084037, "chapter_id": 2787, "verse_number": "१२-२९२-१५", "content_sanskrit": "न बान्धवा न च वित्तं न कौल्यं\nन च श्रुतं न च मन्त्रा न वीर्यम्।\nदुःखान्त्रातुं सर्व एवोत्सहन्ते\nपरत्र शीलेन तु यान्ति शान्तिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2084038, "chapter_id": 2787, "verse_number": "१२-२९२-१६", "content_sanskrit": "नास्ति बुद्धिरयुक्तस्य नायोगाद्विन्दते सुखम्।\nधृतिश्च दुःखत्यागश्चेत्युभयं तु सुखं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2084039, "chapter_id": 2787, "verse_number": "१२-२९२-१७", "content_sanskrit": "प्रियं हि हर्षजननं हर्ष उत्सेकवर्धनः।\nउत्सेको नरकायैव तस्मात्तान्संत्यजाम्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2084040, "chapter_id": 2787, "verse_number": "१२-२९२-१८", "content_sanskrit": "एताञ्शोकभयोत्सेकान्मोहनान्सुखदुःखयोः।\nपश्यामि साक्षिवल्लोके देहस्यास्य विचेष्टनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2084041, "chapter_id": 2787, "verse_number": "१२-२९२-१९", "content_sanskrit": "अर्थकामौ परित्यज्य विशोको विगतज्वरः।\nतृष्णामोहौ तु संत्यज्य चरामि पृथिवीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2084042, "chapter_id": 2787, "verse_number": "१२-२९२-२०", "content_sanskrit": "न च मृत्योर्न चाधर्मान्न लोभान्न कुतश्चन।\nपीतामृतस्येवात्यन्तमिह वामुत्र वा भयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2084043, "chapter_id": 2787, "verse_number": "१२-२९२-२१", "content_sanskrit": "एतद्ब्रह्मन्विजानामि महत्कृत्वा तपोऽव्ययम्।\nतेन नारद संप्राप्तो न मां शोकः प्रबाधते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2084044, "chapter_id": 2787, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि द्विनवत्यधिकद्विशततमोऽध्यायः॥ २९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]