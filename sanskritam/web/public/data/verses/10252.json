[{"id": 6000252000, "chapter_id": 10252, "verse_number": null, "content_sanskrit": "अथ षट्पञ्चाशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1, "topics": [{"text": "कृष्णप्रेषितः कृतवर्मा हस्तिनपुरं प्राप्य", "range": null}]}, {"id": 6000252001, "chapter_id": 10252, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.001.m4a", "display_order": 2}, {"id": 6000252002, "chapter_id": 10252, "verse_number": "१०-५६-१", "content_sanskrit": "कदाचिद् देवकीपुत्रो रामशैनेयसंयुतः।\nसेव्यमानः सभायां वै नानादेशेश्वरैर्नृपैः॥ १०/५६/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.002.m4a", "display_order": 3}, {"id": 6000252003, "chapter_id": 10252, "verse_number": "१०-५६-२", "content_sanskrit": "पाञ्चालराजं द्रुपदं बालैः कुन्तीसुतैर्मृधे।\nबद्धं शुश्राव कौरव्य ब्राह्मणैः सत्रयाजिभिः॥ १०/५६/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.003.m4a", "display_order": 4, "topics": [{"text": "कृष्णेन पाण्डवकृतपाञ्चालराजबन्धनस्य श्रवणम्", "range": "२"}]}, {"id": 6000252004, "chapter_id": 10252, "verse_number": "१०-५६-३", "content_sanskrit": "तच्छ्रुत्वा हृष्टहृदयः कृतवर्माणमच्युतः।\nनगरं हस्तिनपुरं प्रेषयामास वेदितुम्॥ १०/५६/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.004.m4a", "display_order": 5}, {"id": 6000252005, "chapter_id": 10252, "verse_number": "१०-५६-४", "content_sanskrit": "स गत्वा हस्तिनपुरं वृद्धं कुरुपितामहम्।\nददर्श द्रोणविदुरधृतराष्ट्रकृपैर्युतम्॥ १०/५६/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.005.m4a", "display_order": 6}, {"id": 6000252006, "chapter_id": 10252, "verse_number": "१०-५६-५", "content_sanskrit": "युधिष्ठिरं च राजानं चतुर्भिर्भ्रातृभिर्वृतम्।\nसभाजयमास भृशं कुन्तीं च हृदिकात्मजः॥ १०/५६/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.006.m4a", "display_order": 7}, {"id": 6000252007, "chapter_id": 10252, "verse_number": "१०-५६-६", "content_sanskrit": "युधिष्ठिरोऽपि पप्रच्छ सानुगं कंसमर्दनम्।\nहतं च कालयवनं जरासन्धं च निर्जितम्॥ १०/५६/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.007.m4a", "display_order": 8, "topics": [{"text": "पाण्डवेभ्यो कृष्णवृत्तान्तं अवदत्", "range": "६–११"}]}, {"id": 6000252008, "chapter_id": 10252, "verse_number": "१०-५६-७", "content_sanskrit": "वासुदेवं च निहतं करवीरपुरेश्वरम्।\nद्वारवत्याश्च करणं नगर्या वरुणालये॥ १०/५६/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.008.m4a", "display_order": 9}, {"id": 6000252009, "chapter_id": 10252, "verse_number": "१०-५६-८", "content_sanskrit": "हतौ च हंसडिभिकौ ब्रह्मदत्तं च दुर्जयम्।\nश्रुत्वा हार्दिक्यवचनाद् याथार्थ्येन युधिष्ठिरः॥ १०/५६/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.009.m4a", "display_order": 10}, {"id": 6000252010, "chapter_id": 10252, "verse_number": "१०-५६-९", "content_sanskrit": "मेने त्रैलोक्यसाम्राज्यं स्वहस्तगतमक्षयम्।\nसभाजितश्च हार्दिक्यः सुखसम्भाषणादिभिः॥ १०/५६/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.010.m4a", "display_order": 11}, {"id": 6000252011, "chapter_id": 10252, "verse_number": "१०-५६-१०", "content_sanskrit": "पाण्डुपुत्रैस्तथा कुन्त्या सौहार्दस्रुतबाष्पया।\nहार्दिक्यस्ताननुज्ञाप्य बान्धवान् पृथया सह॥ १०/५६/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.011.m4a", "display_order": 12}, {"id": 6000252012, "chapter_id": 10252, "verse_number": "१०-५६-११", "content_sanskrit": "मातृष्वसेयान् धर्मज्ञानभिवन्द्य यथावयः।\nगाङ्गेयेनाभ्यनुज्ञातो धृतराष्ट्रेण चानघ॥ १०/५६/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.012.m4a", "display_order": 13}, {"id": 6000252013, "chapter_id": 10252, "verse_number": "१०-५६-१२", "content_sanskrit": "विदुरेणाङ्गराजेन द्रोणेन च कृपेण च।\nप्राज्ञेनाचार्यपुत्रेण तथा दुर्योधनेन च॥ १०/५६/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.013.m4a", "display_order": 14}, {"id": 6000252014, "chapter_id": 10252, "verse_number": "१०-५६-१३", "content_sanskrit": "कृतवर्माऽभ्यनुज्ञातो निर्गत्य गजसाह्वयात्।\nद्वारकां वृष्णिनिलयामाजगाम दिनात्यये॥ १०/५६/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.014.m4a", "display_order": 15, "topics": [{"text": "कृतवर्मा द्वारकाम् आगत्य तत्र दृष्टमखिलं कृष्णाय आचचष्टे", "range": "१३–१५"}]}, {"id": 6000252015, "chapter_id": 10252, "verse_number": "१०-५६-१४", "content_sanskrit": "स प्रविश्य सभां दिव्यामनेकनृपसेविताम्।\nदृष्ट्वा गोविन्दमासीनं काञ्चने परमासने॥ १०/५६/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.015.m4a", "display_order": 16}, {"id": 6000252016, "chapter_id": 10252, "verse_number": "१०-५६-१५", "content_sanskrit": "वीजच्चामरसङ्घातसहितं वनमालिनम्। आचचष्टेऽखिलं तस्य यथादृष्टं यथाश्रुतम्।\nवृत्तान्तं कौरवेयाणां नगरे गजसाह्वये॥ १०/५६/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.016.m4a", "display_order": 17}, {"id": 6000252017, "chapter_id": 10252, "verse_number": "१०-५६-१६", "content_sanskrit": "तदाकर्ण्य हरिः सर्वं वृत्तान्तं जगदीश्वरः।\nपौरुषं पाण्डुपुत्राणां बभूवानन्दनिर्भरः॥ १०/५६/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_056/BhP_10.056.017.m4a", "display_order": 18}, {"id": 6000252018, "chapter_id": 10252, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे षट्पञ्चाशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]