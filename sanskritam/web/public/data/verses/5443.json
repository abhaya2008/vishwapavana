[{"id": 2208129, "chapter_id": 5443, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208130, "chapter_id": 5443, "verse_number": "१", "content_sanskrit": "तदव्यक्तमनुद्रिक्तं सर्वव्यापि ध्रुवं स्थिरम् ।\nनवद्वारं पुरं विद्यात् त्रिगुणं पञ्चधातुकम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208131, "chapter_id": 5443, "verse_number": "२", "content_sanskrit": "एकादशपरिक्षेपं मनोव्याकरणात्मकम् ।\nबुद्धिस्वामिकमित्येतत् परमेकादशाद् भवेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208132, "chapter_id": 5443, "verse_number": "३", "content_sanskrit": "त्रीणि स्रोतांसि यान्यस्मिन्नाप्यायन्ते पुनः पुनः ।\nप्रनाड्यस्तिस्र एतेषां प्रवर्तन्ते गुणात्मिकाः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208133, "chapter_id": 5443, "verse_number": "४", "content_sanskrit": "तमो रजस्तथा सत्वं गुणानेतान् प्रचक्षते ।\nअन्योन्यमिथुनाः सर्वे तथाऽन्योन्यानुजीविनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208134, "chapter_id": 5443, "verse_number": "५", "content_sanskrit": "अन्योन्याश्रयिणश्चैव तथाऽन्योन्यानुवर्तिनः ।\nअन्योन्यव्यतिषक्ताश्च त्रिगुणाः पञ्चधातवः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208135, "chapter_id": 5443, "verse_number": "६", "content_sanskrit": "तमसो मिथुनं सत्वं सत्वस्य मिथुनं रजः ।\nरजसश्चापि सत्वं स्यात् सत्वस्य मिथुनं तमः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208136, "chapter_id": 5443, "verse_number": "७", "content_sanskrit": "नियम्यते तमो यत्र रजस्तत्र प्रवर्तते ।\nनियम्यते रजो यत्र सत्वं तत्र प्रवर्तते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208137, "chapter_id": 5443, "verse_number": "८", "content_sanskrit": "नैशात्मकं तमो विद्यात् त्रिगुणं मोहसञ्ज्ञितम् ।\nअधर्मलक्षणं चैव नियतं पापकर्मसु ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208138, "chapter_id": 5443, "verse_number": "९", "content_sanskrit": "प्रकृत्यात्मकमेवाभूद् रजः पर्यायकारणम् ।\nप्रवृत्तं सर्वभूतेषु पश्यत्युत्पत्तिलक्षणम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208139, "chapter_id": 5443, "verse_number": "१०", "content_sanskrit": "प्रकाशं सर्वभूतेषु लाघवं श्रद्धदानता ।\nसात्विकं रूपमेवं तु लाघवं साधुसम्मितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208140, "chapter_id": 5443, "verse_number": "११", "content_sanskrit": "एतेषां गुणतत्त्वं हि वक्ष्यते प्राप्तहेतुभिः ।\nसमासव्यासयुक्तानि तत्त्वतस्तानि वित्त मे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208141, "chapter_id": 5443, "verse_number": "१२", "content_sanskrit": "सम्मोहो मनसस्त्यागः कर्मणामविनिर्णयः ।\nसप्तः स्तम्भो भयं लोभः शोकः सुकृतदूषणम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208142, "chapter_id": 5443, "verse_number": "१३", "content_sanskrit": "विस्मृतिश्चाविवेकश्च नास्तिक्यं भिन्नवृत्तिता ।\nनिर्विशेषत्वमन्धत्वं जघन्यगुणवृत्तिता ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208143, "chapter_id": 5443, "verse_number": "१४", "content_sanskrit": "अकृते कृतमानित्वमज्ञाने ज्ञानमानिता ।\nअमैत्री विकृतो भावो ह्यश्रद्धा गूढभावना ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208144, "chapter_id": 5443, "verse_number": "१५", "content_sanskrit": "अनार्जनमसञ्ज्ञत्वं कर्म पापमचेतना ।\nगुरुत्वं सन्नभावत्वमशीतत्वमवाग्गतिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208145, "chapter_id": 5443, "verse_number": "१६", "content_sanskrit": "सर्व एते गुणाश्चैव तामसाः परिकीर्तिताः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208146, "chapter_id": 5443, "verse_number": "१७", "content_sanskrit": "ये चान्ये नियता भावा लोकेऽस्मिन् मूढसञ्ज्ञिताः ।\nतत्र तत्र नियम्यन्ते सर्वे ते तामसा गुणाः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208147, "chapter_id": 5443, "verse_number": "१८", "content_sanskrit": "परिवादकथा नित्यं देवब्राह्मणवैरिता ।\nअत्यागश्चातिमानश्च मोहो मन्युस्तथाऽक्षमा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2208148, "chapter_id": 5443, "verse_number": "१९", "content_sanskrit": "मत्सरश्चैव भूतेषु तामसं वृत्तमिष्यते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2208149, "chapter_id": 5443, "verse_number": "२०", "content_sanskrit": "वृथाऽऽरम्भा हि ये केचिद् वृथा दानानि यानि च ।\nवृथा भक्षणमित्येतत् तामसं वृत्तमिष्यते ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2208150, "chapter_id": 5443, "verse_number": "२१", "content_sanskrit": "अतिवादोऽतितिक्षा च मात्सर्यमतिमानिता ।\nअश्रद्दधानता चैव तामसं वृत्तमिष्यते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2208151, "chapter_id": 5443, "verse_number": "२२", "content_sanskrit": "एवंविधास्तु ये केचिल्लोकेऽस्मिन् पापकर्मिणः ।\nमनुष्या भिन्नमर्यादास्ते सर्वे तामसा जनाः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2208152, "chapter_id": 5443, "verse_number": "२३", "content_sanskrit": "तेषां योनिं प्रवक्ष्यामि नियतां पापकर्मिणाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2208153, "chapter_id": 5443, "verse_number": "२४", "content_sanskrit": "अवाङ्निरयभागा वै तिर्यङ्निरयगामिनः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2208154, "chapter_id": 5443, "verse_number": "२५", "content_sanskrit": "स्थावराणि च भूतानि पशवो वाहनानि च ।\nक्रव्यादा दन्दशूकाश्च कृमिकीटविहङ्गमाः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2208155, "chapter_id": 5443, "verse_number": "२६", "content_sanskrit": "अपरे जन्तवो ये च सर्वे चापि चतुष्पदाः ।\nउन्मत्ता बधिरा मूका ये चान्ये पापरोगिणः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2208156, "chapter_id": 5443, "verse_number": "२७", "content_sanskrit": "मग्नास्तमसि दुर्वृत्ताः स्वकर्मकृतलक्षणाः ।\nअवाक् स्रोतस इत्येते मग्नास्तमसि तामसाः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2208157, "chapter_id": 5443, "verse_number": "२८", "content_sanskrit": "तेषामुत्कर्षमुद्रेकं वक्ष्याम्यहमतः परम् ।\nयथा ते सुकृतां लोकान् लभन्ते पुण्यकर्मणाम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2208158, "chapter_id": 5443, "verse_number": "२९", "content_sanskrit": "अन्यथा प्रतिपन्नास्तु विवृद्धा ये च कर्मसु ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2208159, "chapter_id": 5443, "verse_number": "३०", "content_sanskrit": "स्वकर्मनिरतानां च ब्राह्मणानां शुभैषिणाम् ।\nसंस्कारेणोर्ध्वमायान्ति यतमानाः सलोकताम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2208160, "chapter_id": 5443, "verse_number": "३१", "content_sanskrit": "स्वर्गं गच्छन्ति देवानामित्येषा वैदिकी श्रुतिः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2208161, "chapter_id": 5443, "verse_number": "३२", "content_sanskrit": "अन्यथा प्रतिपन्नास्तु विबुद्धाः स्वेषु कर्मसु ।\nपुनरावृत्तिधर्माणस्ते भवन्तीह मानुषाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2208162, "chapter_id": 5443, "verse_number": "३३", "content_sanskrit": "पापयोनिं समापन्नाश्चण्डाला वृकचूचुकाः ।\nवर्णान् पर्यायतश्चैव प्राप्नुवन्त्युत्तरोत्तरम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2208163, "chapter_id": 5443, "verse_number": "३४", "content_sanskrit": "शूद्रयोनिमतिक्रम्य ये चान्ये तामसा गुणाः ।\nस्रोतोमध्यमथागम्य वर्तन्ते तामसे गुणे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2208164, "chapter_id": 5443, "verse_number": "३५", "content_sanskrit": "अभिष्वङ्गस्तु कामेषु महामोह इति स्मृतः ।\nऋषयो मुनयो देवा मुह्यन्त्यत्र सुखेप्सवः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2208165, "chapter_id": 5443, "verse_number": "३६", "content_sanskrit": "तमोमोहो महामोहः तामिस्रो ह्यन्धसञ्ज्ञितः ।\nमरणं त्वन्धतामिस्रस्तामिस्रः क्रोध उच्यते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2208166, "chapter_id": 5443, "verse_number": "३७", "content_sanskrit": "भावतो गुणतश्चैव योनितश्चैव तत्त्वतः ।\nसर्वमेतत् तमो विप्राः कीर्तितं वो यथाविधि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2208167, "chapter_id": 5443, "verse_number": "३८", "content_sanskrit": "को न्वेतद् बुध्यते साधु कोन्वेतत् साधु पश्यति ।\nअतत्त्वे तत्त्वदर्शी यस्तमसस्तच्च लक्षणम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2208168, "chapter_id": 5443, "verse_number": "३९", "content_sanskrit": "तमोगुणा वो बहवोऽनुकीर्तिता\nयथावदुक्तं च तमः परावरम् ।\nनरो हि यो वेद गुणानिमान् सदा\nस तामसैः सर्वगुणैर्विमुच्यते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2208169, "chapter_id": 5443, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अनुगीतासु तमोगुणविचारकथनं नाम सप्तत्रिंशोऽध्यायः ॥३७॥\nअनुगीतापर्वणि द्वाविंशोऽध्यायः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]