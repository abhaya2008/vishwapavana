[{"id": 7002163000, "chapter_id": 22163, "verse_number": "२०८-१", "content_sanskrit": "अग्निरुवाच ।\nव्रतदानानि सामान्यं प्रवदामि समासतः ।\nतिथौ प्रतिपदादौ च सूर्यादौ कृत्तिकासु च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002163001, "chapter_id": 22163, "verse_number": "२०८-२", "content_sanskrit": "विष्कम्भादौ च मेषादौ काले च ग्रहणादिके ।\nयत्काले यद्व्रतं दानं यद्द्रव्यं नियमादि यत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002163002, "chapter_id": 22163, "verse_number": "२०८-३", "content_sanskrit": "तद्द्रव्याख्यञ्च कालाख्यं सर्वं वै विष्णुदैवतं ।\nरवीशब्रह्मलक्ष्म्याद्याः सर्वे विष्णोर्विभूतयः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002163003, "chapter_id": 22163, "verse_number": "२०८-४", "content_sanskrit": "तमुद्दिश्य व्रतं दानं पूजादि स्यात्तु सर्वदं ।\nजगत्पते समागच्छ आसनं पाद्यमर्घ्यकं ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002163004, "chapter_id": 22163, "verse_number": "२०८-५", "content_sanskrit": "मधुपर्कं तथाचामं स्नानं वस्तञ्च गन्धकं ।\nपुष्पं धूपश्च दीपश्च नैवेद्यादि नमोऽस्तु ते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002163005, "chapter_id": 22163, "verse_number": "२०८-६", "content_sanskrit": "इति पूजाव्रते दाने दानवाक्यं समं शृणु ।\nअद्यामुकसगोत्राय विप्रायामुकशर्मणे ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002163006, "chapter_id": 22163, "verse_number": "२०८-७", "content_sanskrit": "एतद्द्रव्यं विष्णुदैवं सर्वपापोपशान्तय् ।\nआयुरारोग्यवृद्ध्यर्थं सौभाग्यादिविवृद्धये ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002163007, "chapter_id": 22163, "verse_number": "२०८-८", "content_sanskrit": "गोत्रसन्ततिवृद्ध्यर्थं विजयाय धनाय च ।\nधर्मायैश्वर्यकामाय तत्पापशमनाय च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002163008, "chapter_id": 22163, "verse_number": "२०८-९", "content_sanskrit": "संसारमुक्तये दानन्तुभ्यं सम्प्रददे ह्यहं ।\nएतद्दानप्रतिष्ठार्थं तुभ्यमेतद्ददाम्यहं ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002163009, "chapter_id": 22163, "verse_number": "२०८-१०", "content_sanskrit": "एतेन प्रीयतां नित्यं सर्वलोकपतिः प्रभुः ।\nयज्ञदानव्रतपते विद्याकीर्त्यादि देहि मे ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002163010, "chapter_id": 22163, "verse_number": "२०८-११", "content_sanskrit": "धर्मकामार्थमोक्षांश्च देहि मे मनसेप्सितं ।\nयः पठेच्छृणुयान्नित्यं व्रतदानसमुच्चयं ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002163011, "chapter_id": 22163, "verse_number": "२०८-१२", "content_sanskrit": "स प्राप्तकामो विमलो भुक्तिमुक्तिमवाप्नुयात् ।\nतिथिवारर्क्षसङ्क्रान्तियोगमन्वादिकं व्रतं ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}]