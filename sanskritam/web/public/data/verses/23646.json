[{"id": 7003646000, "chapter_id": 23646, "verse_number": "१-२-३३-१", "content_sanskrit": "नारद उवाच ।\nततस्तं गिरिवर्ष्माणं पतितं वसुधोपरि ।\nआलिंगितमिव पृथ्व्या गुणिन्या गुणिनं यथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003646001, "chapter_id": 23646, "verse_number": "१-२-३३-२", "content_sanskrit": "दृष्ट्वा देवा विस्मितास्ते जयं जगुस्तथा मुहुः ।\nकेचित्समीपमागंतुं बिभ्यति त्रिदिवौकसः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003646002, "chapter_id": 23646, "verse_number": "१-२-३३-३", "content_sanskrit": "उत्थाय तारको दैत्यः कदा चिन्नो निहंति चेत् ।\nतं तथा पतितं दृष्ट्वा वसुधामण्डले गुहः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003646003, "chapter_id": 23646, "verse_number": "१-२-३३-४", "content_sanskrit": "आसीद्दीनमनाः पार्थ शुशोच च महामतिः ।\nस्तवनं चापि देवानां वारयित्वा वचोऽब्रवीत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003646004, "chapter_id": 23646, "verse_number": "१-२-३३-५", "content_sanskrit": "शोच्यं पातकिनं मां च संस्तुवध्वं कथं सुराः ।\nपंचानामपि यो भर्ता प्राकृतोऽसौ न कीर्त्यते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003646005, "chapter_id": 23646, "verse_number": "१-२-३३-६", "content_sanskrit": "स तु रुद्रांशजः प्रोक्तस्तस्य द्रुह्यन्न रुद्रंवत् ।\nस्वायंभुवेन गीतश्च श्लोकः संश्रूयते तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003646006, "chapter_id": 23646, "verse_number": "१-२-३३-७", "content_sanskrit": "वीरं हि पुरुषं हत्वा गोसहस्रेण मुच्यते ।\nयथाकथंचित्पुरुषो न हंतव्यस्ततो बुधैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003646007, "chapter_id": 23646, "verse_number": "१-२-३३-८", "content_sanskrit": "पापशीलस्य हनने दोषो यद्यपि नास्ति च ।\nतथापि रुद्रभक्तोऽयं संस्मरन्निति शोचिमि ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003646008, "chapter_id": 23646, "verse_number": "१-२-३३-९", "content_sanskrit": "तदहं श्रोतुमिच्छामि प्रायाश्चित्तं च किंचन ।\nप्रायश्चित्तैरपैत्येनो यतोपि महदर्जितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003646009, "chapter_id": 23646, "verse_number": "१-२-३३-१०", "content_sanskrit": "इति संशोचतस्तस्य शिवपुत्रस्य धीमतः ।\nवासुदेवो गुरुः पुंसां देवमध्ये वचोऽब्रवीत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003646010, "chapter_id": 23646, "verse_number": "१-२-३३-११", "content_sanskrit": "श्रुतिः स्मृतिश्चेतिहासाः पुराणं च शिवात्मज ।\nप्रमाणं चेत्ततो दुष्टवधे दोषो न विद्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003646011, "chapter_id": 23646, "verse_number": "१-२-३३-१२", "content_sanskrit": "स्वप्राणान्यः परप्राणैः प्रपुष्णात्यघृणः पुमान् ।\nतद्वधस्तस्य हि श्रेयो यद्दोषाद्यात्यधः पुमान् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003646012, "chapter_id": 23646, "verse_number": "१-२-३३-१३", "content_sanskrit": "अन्नादे भ्रूणहा मार्ष्टि पत्यौ भार्या पचारिणी ।\nगुरौ शिष्यश्च याज्यश्च स्तेनो राजनि किल्बिषम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003646013, "chapter_id": 23646, "verse_number": "१-२-३३-१४", "content_sanskrit": "पापिनं पुरुषं यो हि समर्थो न निहंति च ।\nतस्य तावंति पापानि तदर्धं सोऽप्यवाश्रुते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003646014, "chapter_id": 23646, "verse_number": "१-२-३३-१५", "content_sanskrit": "पापिनो यदि वध्यंते नैव पालनसंस्थितैः ।\nततोऽयमक्षमो लोकः कं याति शरणं गुह ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003646015, "chapter_id": 23646, "verse_number": "१-२-३३-१६", "content_sanskrit": "कथं यज्ञाश्च वेदाश्च वर्तते विश्वधारकाः ।\nतस्मात्त्वया पुण्यमाप्तं न च पापं कथंचन ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003646016, "chapter_id": 23646, "verse_number": "१-२-३३-१७", "content_sanskrit": "अथ चेद्रुद्रभक्तेषु बहुमानस्तव प्रभो ।\nतत्र ते कीर्तयिष्यामि प्रायश्चित्तं महोत्तमम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003646017, "chapter_id": 23646, "verse_number": "१-२-३३-१८", "content_sanskrit": "आजन्मसंभवैः पापैः पुमान्येन विमुच्यते ।\nआकल्पांत च वा येन रुद्रलोके प्रमोदते ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003646018, "chapter_id": 23646, "verse_number": "१-२-३३-१९", "content_sanskrit": "कृते पापेऽनुतापो वै यस्य स्कन्द प्रजायते ।\nरुद्राराधनतोऽन्यच्च प्रायश्तित्तं परं न हि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003646019, "chapter_id": 23646, "verse_number": "१-२-३३-२०", "content_sanskrit": "न यस्यालमपि ब्रह्मामहिमानं विवर्णितुम् ।\nश्रुतिश्च भीता यं वक्ति किं तस्मात्परमं भवेत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003646020, "chapter_id": 23646, "verse_number": "१-२-३३-२१", "content_sanskrit": "अकांडे यच्च ब्रह्मांडक्षयोद्युक्तं हलाहलम् ।\nकण्ठे दधार श्रीकण्ठः कस्तस्मात्परमो भवेत् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003646021, "chapter_id": 23646, "verse_number": "१-२-३३-२२", "content_sanskrit": "दुःखतांडवदीनोऽभूदण्डसंकीर्णमानसः ।\nमारमारश्च यो देवः कस्तस्मात्परमो भवेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003646022, "chapter_id": 23646, "verse_number": "१-२-३३-२३", "content_sanskrit": "वियद्व्यापी सुरसरित्प्रवाहो विप्रुषाकृतिः ।\nबभूव यस्य शिरसि कस्तस्मात्परमो भवेत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003646023, "chapter_id": 23646, "verse_number": "१-२-३३-२४", "content_sanskrit": "यज्ञादिकाश्च ये धर्मा विना यस्यार्चनं वृथा ।\nदक्षोऽत्र सत्यदृष्टांतः कस्तस्मात्परमो भवेत् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003646024, "chapter_id": 23646, "verse_number": "१-२-३३-२५", "content_sanskrit": "क्षोणी रथो विधिर्यंता शरोऽहं मन्दरो धनुः ।\nरथांगे चापि चंद्रार्कौ युद्धे यस्य च त्रैपुरे ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003646025, "chapter_id": 23646, "verse_number": "१-२-३३-२६", "content_sanskrit": "आराधनं तस्य केचिद्योगमार्गेण कुर्वते ।\nदुःखसाध्यं हि तत्तेषां नित्यं शून्यमुपासताम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003646026, "chapter_id": 23646, "verse_number": "१-२-३३-२७", "content_sanskrit": "तस्मात्तस्यार्चयेल्लिंगं भुक्तिमुक्ती य इच्छति ।\nसृष्ट्यादौ लिंगरूपी स विवादो मम ब्रह्मणः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003646027, "chapter_id": 23646, "verse_number": "१-२-३३-२८", "content_sanskrit": "अभूद्यस्य परिच्छेदे नालमावां बभूविव ।\nचराचरं जगत्सर्वं यतो लीनं सदात्र च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003646028, "chapter_id": 23646, "verse_number": "१-२-३३-२९", "content_sanskrit": "तस्माल्लिंगमिति प्रोक्तं देवै रुद्रस्य धीमतः ।\nतोयेन स्नापयेल्लिंगं श्रद्धया शुचिना च यः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003646029, "chapter_id": 23646, "verse_number": "१-२-३३-३०", "content_sanskrit": "ब्रह्मादितृणपर्यंतं तेनेदं तर्पितं जगत् ।\nपंचामृतेन तल्लिंगं स्नापयेद्यश्च बुद्धिमान् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003646030, "chapter_id": 23646, "verse_number": "१-२-३३-३१", "content_sanskrit": "तर्पितं तेन विश्वं स्यात्सुधया पितृभिः समम् ।\nपुष्पैरभ्यर्चयेल्लिंगं यथाकालोद्भवैश्चयः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003646031, "chapter_id": 23646, "verse_number": "१-२-३३-३२", "content_sanskrit": "तेन संपूजितं विश्वं सकलं नात्र संशयः ।\nनैवेद्यं तत्र यो दद्याल्लिंगस्याग्रे विचक्षणः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003646032, "chapter_id": 23646, "verse_number": "१-२-३३-३३", "content_sanskrit": "भोजितं तेन विश्वं स्याल्लिंगस्यैवं फलं महत् ।\nकिमत्र बहुनोक्तेन स्वल्पं वा यदि व बहु ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003646033, "chapter_id": 23646, "verse_number": "१-२-३३-३४", "content_sanskrit": "लिंगस्य क्रियते यच्च तत्सर्वं विश्वप्रीतिदम् ।\nतच्च लिगं स्थापयेद्यः शुचौ देशे सुभक्तितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003646034, "chapter_id": 23646, "verse_number": "१-२-३३-३५", "content_sanskrit": "स सर्वपापनिर्मुक्तो रुद्रलोके प्रमोदते ।\nयन्नित्यं यजतो यज्ञैः फलमाहुर्मनीषिणः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003646035, "chapter_id": 23646, "verse_number": "१-२-३३-३६", "content_sanskrit": "तच्च स्थापयतो लिंगं शिवस्य शुभलक्षणम् ।\nयथाग्निः सर्वदेवानां मुखं स्कन्द प्रकीर्त्यते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003646036, "chapter_id": 23646, "verse_number": "१-२-३३-३७", "content_sanskrit": "तथैव सर्वजगतां मुखं लिंगं न संशयः ।\nप्रारंभान्मुच्यते पापैः सर्वजन्मकृतैरपि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003646037, "chapter_id": 23646, "verse_number": "१-२-३३-३८", "content_sanskrit": "अतीतं च तथागामि कुलानां तारयेच्छतम् ।\nमृन्मयं काष्ठनिष्पन्नं पक्वेष्टं शैलमेव च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003646038, "chapter_id": 23646, "verse_number": "१-२-३३-३९", "content_sanskrit": "कृतमायतनं दद्यात्क्रमाच्छतगुणं फलम् ।\nकलशं तत्र चारोप्य एकविंशत्कुलैर्युतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003646039, "chapter_id": 23646, "verse_number": "१-२-३३-४०", "content_sanskrit": "आकल्पांतं रुद्रलोके मोदते रुद्रवत्सुखी ।\nएवंविधफलं लिंगमतो भूयोऽप्यधो न हि ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003646040, "chapter_id": 23646, "verse_number": "१-२-३३-४१", "content_sanskrit": "तस्मादत्र महासेन लिंगं स्थापितुमर्हसि ।\nयदुक्तमेतदश्लीलं यदि किंचन चात्र चेत् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003646041, "chapter_id": 23646, "verse_number": "१-२-३३-४२", "content_sanskrit": "तद्ब्रवीतु महा सेन स्वयं साक्षी महेश्वरः ।\nएवं वदति गोविंदे साधुवादो महानभूत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003646042, "chapter_id": 23646, "verse_number": "१-२-३३-४३", "content_sanskrit": "महादेवो ह्यथालिंग्य स्कन्दं वचनब्रवीत् ।\nयद्भवान्मम भक्तेषु प्रकरोति कृपां पराम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003646043, "chapter_id": 23646, "verse_number": "१-२-३३-४४", "content_sanskrit": "तेनापि परमा प्रीतिर्मम जाता तवोपरि ।\nकिं तु यद्भगवानाह वासुदेवो जगद्गुरुः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003646044, "chapter_id": 23646, "verse_number": "१-२-३३-४५", "content_sanskrit": "तत्त्था नान्यथा किंचिदत्र प्रोक्तं हि विष्णुना ।\nयो ह्यहं स हरिर्ज्ञेयो यो हरिः सोऽहमित्युता ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003646045, "chapter_id": 23646, "verse_number": "१-२-३३-४६", "content_sanskrit": "नावयोरंतरं किंचिद्दीपयोरिव सुव्रत ।\nएनं द्वेष्टि स मां द्वेष्टियोन्वेत्येनं स माऽनुगः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003646046, "chapter_id": 23646, "verse_number": "१-२-३३-४७", "content_sanskrit": "इति स्कन्द विजानाति स मद्भक्तोन्यथा न हि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003646047, "chapter_id": 23646, "verse_number": "१-२-३३-४८", "content_sanskrit": "स्कन्द उवाच ।\nएवमेवास्मि जानामि त्वां च विष्णुं च शंकर ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003646048, "chapter_id": 23646, "verse_number": "१-२-३३-४९", "content_sanskrit": "यच्च लिंगकृते प्राह हरिर्मां धर्मवत्सलः ।\nखे वाणी तारकवधे एवमेव पुराह माम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003646049, "chapter_id": 23646, "verse_number": "१-२-३३-५०", "content_sanskrit": "लिंगं संस्थापयिष्यामि सर्वपापा पहं ततः ।\nएकं यत्र प्रतिज्ञा मे गृहीतास्य वधाय च ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003646050, "chapter_id": 23646, "verse_number": "१-२-३३-५१", "content_sanskrit": "द्वितीयं यत्र निःसत्त्वसत्यक्तः शक्त्याऽसुरोऽभवत् ।\nतृतीयं यत्र निहतो हत्या पापोपशांतिदम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003646051, "chapter_id": 23646, "verse_number": "१-२-३३-५२", "content_sanskrit": "इत्युक्त्वा विश्वकर्माणमाहूय प्राह पावकिः ।\nत्रीणि लिंगानि शुद्धानि शीघ्रं त्वं कर्तुमर्हसि ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003646052, "chapter_id": 23646, "verse_number": "१-२-३३-५३", "content_sanskrit": "वचनाद्बाहुलेयस्य निर्ममे देववर्द्धकिः ।\nत्रीणि लिंगानि शुद्धानि न्यवेदयत तानि च ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003646053, "chapter_id": 23646, "verse_number": "१-२-३३-५४", "content_sanskrit": "ततो ब्रह्मादिभिः सार्धं विष्णुना शंकरेण च ।\nपूर्वं संस्थापयामास पश्चिमायामदूरतः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003646054, "chapter_id": 23646, "verse_number": "१-२-३३-५५", "content_sanskrit": "प्रतिज्ञेश्वरमित्येव लिंगं परमशोभनम् ।\nअष्टम्यां बहुले चात्र चैत्रे स्नात्वा उपोष्य च ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003646055, "chapter_id": 23646, "verse_number": "१-२-३३-५६", "content_sanskrit": "पूजां च जागरं कृत्वा मुच्येत्पारुष्यपापतः ।\nइत्याह स्कंदप्रीत्यर्थं स्वयं तत्र महेश्वरः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003646056, "chapter_id": 23646, "verse_number": "१-२-३३-५७", "content_sanskrit": "ततो द्वितीयं लिंगं तु वह्निकोणाश्रितं तथा ।\nस्थापयामास सरसो यत्र शक्तिर्विनिर्ययौ ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003646057, "chapter_id": 23646, "verse_number": "१-२-३३-५८", "content_sanskrit": "कपालेश्वरमित्येव लिंगं पापापहं शुभम् ।\nशक्तिं च तामभिष्टूय स्थापयामास तत्र च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003646058, "chapter_id": 23646, "verse_number": "१-२-३३-५९", "content_sanskrit": "कपालेश्वरसांनिध्यं देवीं कापालिकेश्वरीम् ।\nतत्र चोत्तरदिग्भागे शक्तिच्छिद्रं प्रचक्षते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003646059, "chapter_id": 23646, "verse_number": "१-२-३३-६०", "content_sanskrit": "पातालगंगा यत्रास्तिं सर्वपापहरा शिवा ।\nतत्र स्नात्वा ददौ स्कंदः कृपयाभिपरिप्लुतः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003646060, "chapter_id": 23646, "verse_number": "१-२-३३-६१", "content_sanskrit": "तदा तोयं तारकाय सहितः सर्वदैवतैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003646061, "chapter_id": 23646, "verse_number": "१-२-३३-६२", "content_sanskrit": "काश्यपेयाय वज्रांगतनयाय महात्मने ।\nरुद्रभक्ताय सतिलमक्षय्योदकमस्त्विति ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003646062, "chapter_id": 23646, "verse_number": "१-२-३३-६३", "content_sanskrit": "ततो महेश्वरः प्रीतः प्राह स्कंदस्य श्रृण्वतः ।\nचतुर्दश्यां कृष्णपक्षे मधौ चैवात्र यो नरः ।\nस्नात्वोपोष्य समभ्यर्च्य कपालेश्वरमीश्वरीम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003646063, "chapter_id": 23646, "verse_number": "१-२-३३-६४", "content_sanskrit": "तेजोवधसमुद्भूतपातकेन स मुच्यते ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003646064, "chapter_id": 23646, "verse_number": "१-२-३३-६५", "content_sanskrit": "अस्यामेव तिथौ सोमः शिवयोगश्च तैतिलम् ।\nषड्योगः शक्तिच्छिद्रेयो दिनं रुद्रं जपन्निशि ।\nस्नात्वात्र सशरीरो वै रुद्रलोकं व्रजीष्यति ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003646065, "chapter_id": 23646, "verse_number": "१-२-३३-६६", "content_sanskrit": "कपालेशस्य सांनिध्ये शक्तिच्छिद्रं हि कीर्त्यते ।\nतस्य तुल्यं परं तीर्थं पृथिव्यां नैव विद्यते ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003646066, "chapter_id": 23646, "verse_number": "१-२-३३-६७", "content_sanskrit": "इति श्रुत्वा रुद्रवाक्यं स्कंदः प्रीतोऽभवद्भृशम् ।\nदेवाश्च मुदिताः सर्वे साधुसाध्विति ते जगुः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]