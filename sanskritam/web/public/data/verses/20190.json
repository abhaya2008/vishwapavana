[{"id": 7000190000, "chapter_id": 20190, "verse_number": "१९०-१", "content_sanskrit": "केशिवधनिरूपणम् व्यास उवाच ककुद्‌मिनि हतेऽरिष्टे धेनुके च निपातिते ।\nप्रलम्बे निधनं नीते धृते गोवर्धनाचले ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000190001, "chapter_id": 20190, "verse_number": "१९०-२", "content_sanskrit": "दमिते कालिये नागे भग्ने तुङ्गद्रुमद्वये ।\nहतायां पूतनायां च शकटे परिवर्तिते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000190002, "chapter_id": 20190, "verse_number": "१९०-३", "content_sanskrit": "कंसाय नारदः प्राह यथावृत्तमनुक्रमात् ।\nयशोदादेवकीगर्भपरिवर्ताद्यशेषतः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000190003, "chapter_id": 20190, "verse_number": "१९०-४", "content_sanskrit": "श्रुत्वा तत्सकलं कंसो नारदाद्देवदर्शनात् ।\nवसुदेवं प्रति तदा कोपं चक्रे स दुर्मतिः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000190004, "chapter_id": 20190, "verse_number": "१९०-५", "content_sanskrit": "सोऽतिकोपादुपालभ्य सर्वयादवसंसदि ।\nजगर्हे यादवांश्चापि कार्यं चैतदचिन्तयत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000190005, "chapter_id": 20190, "verse_number": "१९०-६", "content_sanskrit": "यावन्न बालमारूढौ बलकृष्णौ सुबालकौ ।\nतावदेव मया वध्यावसाध्यौ रुढयौवनौ ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000190006, "chapter_id": 20190, "verse_number": "१९०-७", "content_sanskrit": "चाणूरोऽत्र महावीर्यो मुष्टिकश्च महाबलः ।\nएताभ्यां मल्लयुद्धे तौ घातयिष्यामि दुर्मदौ ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000190007, "chapter_id": 20190, "verse_number": "१९०-८", "content_sanskrit": "धनुर्महमहायागव्याजेनाऽऽनीय तौ व्रजात् ।\nतथा तथा करिष्यामि यास्यतः संक्षयं यथा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000190008, "chapter_id": 20190, "verse_number": "१९०-९", "content_sanskrit": "व्यास उवाच इत्यलोच्य स दुष्टात्मा कंसो रामजनार्दनौ ।\nहन्तुं कृतमतिर्वीरमक्रूरं वाक्यमब्रवीत् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000190009, "chapter_id": 20190, "verse_number": "१९०-१०", "content_sanskrit": "कंस उवाच भो भो दानपते वाक्यं क्रियतां प्रीतये मम ।\nइतः स्यन्दनमारुह्य गम्यतां नन्दगोकुलम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000190010, "chapter_id": 20190, "verse_number": "१९०-११", "content_sanskrit": "वसुदेवसुतौ तत्र विष्णोरंशसमुद्‌भवौ ।\nनाशाय संभूतौ मम दुष्टौ प्रवर्धतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000190011, "chapter_id": 20190, "verse_number": "१९०-१२", "content_sanskrit": "धनुर्महमहायागश्चतुर्दश्यां भविष्यति ।\nआनेयौ भवता तौ तु मल्लयुन्नद्वाय तत्र वै ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000190012, "chapter_id": 20190, "verse_number": "१९०-१३", "content_sanskrit": "चाणूरमुष्टिकौ मल्लौ नियुद्धकुशलौ मम ।\nताभ्यां सहानयोर्युद्धं सर्वलोकोऽत्र पश्यतु ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000190013, "chapter_id": 20190, "verse_number": "१९०-१४", "content_sanskrit": "नागः कुवलयापीडो महामात्रप्रचोदितः ।\nस तौ निहंस्यते पापौ वसुदेवात्मजौ शिशू ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000190014, "chapter_id": 20190, "verse_number": "१९०-१५", "content_sanskrit": "तौ हत्वा वसुदेवं च नन्दगोपं च दुर्मतिम् ।\nहनिष्ये पितरं चैव उग्रसेनं च दुर्मतिम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000190015, "chapter_id": 20190, "verse_number": "१९०-१६", "content_sanskrit": "ततः समस्तगोपानां गोधनान्यखिलान्यहम् ।\nवित्तं चापहरिष्यामि दुष्टानां मद्वधैषिणाम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000190016, "chapter_id": 20190, "verse_number": "१९०-१७", "content_sanskrit": "त्वामृते यादवाश्चेमे दुष्टा दानपते मम ।\nएतेषां च वधायाहं प्रयतिष्याम्यनुक्रमात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000190017, "chapter_id": 20190, "verse_number": "१९०-१८", "content_sanskrit": "ततो निष्कण्टकं सर्वं राज्यमेतदयादवम् ।\nप्रसाधिष्ये त्वया तस्मान्मत्प्रीत्या वीर गम्यताम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000190018, "chapter_id": 20190, "verse_number": "१९०-१९", "content_sanskrit": "यथा च महिषं सर्पिर्दधि चाप्युपहार्य वै ।\nगोपाः समानयन्त्याशु त्वया वाच्यास्तथा तथा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000190019, "chapter_id": 20190, "verse_number": "१९०-२०", "content_sanskrit": "व्यास उवाच इत्याज्ञप्तस्तदाऽक्रूरो महाभागवतो द्विजाः ।\nप्रीतिमानभवत्कृष्णं श्वो द्रक्ष्यामीति सत्वरः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000190020, "chapter_id": 20190, "verse_number": "१९०-२१", "content_sanskrit": "तथेत्युक्त्वा तु राजानं रथमारुह्य सत्वरः ।\nनिश्चक्राम तदा पूर्या मथुराया मधुप्रियः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000190021, "chapter_id": 20190, "verse_number": "१९०-२२", "content_sanskrit": "व्यास उवाच केशी चापि बलोदग्रः कंसदूतः प्रचोदितः ।\nकृष्णस्य निधनाकाङ्क्षी वृन्दावनमुपागमत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000190022, "chapter_id": 20190, "verse_number": "१९०-२३", "content_sanskrit": "सखुरक्षतभूपृष्ठः सटाक्षेपधुताम्बुदः ।\nपुनर्विक्रान्तचन्द्रार्कमार्गो गोपान्तमागमत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000190023, "chapter_id": 20190, "verse_number": "१९०-२४", "content_sanskrit": "तस्य ह्रेषितशब्देन गोपाला दैत्यवाजिनः ।\nगोप्यश्च भयसंविग्ना गोविन्दं शरणं ययुः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000190024, "chapter_id": 20190, "verse_number": "१९०-२५", "content_sanskrit": "त्राहि त्राहीति गोविन्दस्तेषां श्रुत्वा तु तद्वचः ।\nसतोयजलदध्वानागम्भीरमिदमुक्तवान् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000190025, "chapter_id": 20190, "verse_number": "१९०-२६", "content_sanskrit": "गोविन्द उवाच अलं त्रासेन गोपालाः केशिनः किं भयातुरैः ।\nभवद्‌भिर्गोपजातीयैर्वोरवीर्यं विलोप्यते ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000190026, "chapter_id": 20190, "verse_number": "१९०-२७", "content_sanskrit": "किमनेनाल्पसारेण ह्रेषितारोपकारिणा ।\nदैतेयबलवाह्येन वल्गता दुष्टवाजिना ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000190027, "chapter_id": 20190, "verse_number": "१९०-२८", "content_sanskrit": "एह्येहि दुष्ट कृष्णोऽहं पूष्णस्त्विव पिनाकधृक् ।\nपातयिष्यामि दशनान्वदनादखिलांस्तव ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000190028, "chapter_id": 20190, "verse_number": "१९०-२९", "content_sanskrit": "व्यास उवाच इत्युक्त्वा स तु गोविन्दः केशिनः संमुखं ययौ ।\nविवृतास्यश्च सोऽप्येनं दैतेयश्च उपाद्रवत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000190029, "chapter_id": 20190, "verse_number": "१९०-३०", "content_sanskrit": "बाहुमाभोगिनं कृत्वा मुखे तस्य जनार्दनः ।\nप्रवेशयामास तदा केशिनो दुष्टवाजिनः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000190030, "chapter_id": 20190, "verse_number": "१९०-३१", "content_sanskrit": "केशिनो वदनं तेन विशता कृष्णबाहुना ।\nशातिता दशनास्तस्य सिताभ्रावयवा इव ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000190031, "chapter_id": 20190, "verse_number": "१९०-३२", "content_sanskrit": "कृष्णस्य ववृधे बाहुः केशिदेहगतो द्विजाः ।\nविनाशाय यथा व्याधिराप्तभूतैरुपेक्षितः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000190032, "chapter_id": 20190, "verse_number": "१९०-३३", "content_sanskrit": "विपाटितौष्ठो बहुलं सफेनं रुधिरं वमन् ।\nसृक्कणी विवृते चक्रे विश्लिष्टे मुक्तबन्धने ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000190033, "chapter_id": 20190, "verse_number": "१९०-३४", "content_sanskrit": "जगाम धरणीं पादैः शकृन्मूत्रं समुत्सृजन् ।\nस्वेदार्द्रगात्रः श्रान्तश्च निर्यत्नः सोऽभवत्ततः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000190034, "chapter_id": 20190, "verse_number": "१९०-३५", "content_sanskrit": "व्यादितास्यो महारौद्रः सोऽसुरः कृष्णबाहुना ।\nनिपपात द्विधाभूतो वैद्युतेन यथा द्रुमः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000190035, "chapter_id": 20190, "verse_number": "१९०-३६", "content_sanskrit": "द्विपादपृष्ठपुच्छार्धश्रवणैकाक्षनासिके ।\nकेशिनस्ते द्विधा भूते शकले च विरेजतुः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000190036, "chapter_id": 20190, "verse_number": "१९०-३७", "content_sanskrit": "हत्वा तु केशिनं कृष्णो मुदितैर्गोपकैर्वृतः ।\nअनायस्ततनुः पुण्डरीकाक्षमनुरागमनोरमम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000190037, "chapter_id": 20190, "verse_number": "१९०-३८", "content_sanskrit": "ततो गोपाश्च गोप्यश्च हते केशिनि विस्मिताः ।\nतुष्टुवुः पुण्डरीकाक्षमनुरागमनोरमम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000190038, "chapter_id": 20190, "verse_number": "१९०-३९", "content_sanskrit": "आययौ त्वरितो विप्रो नारदो जलदस्थितः ।\nकेशिनं निहतं दृष्ट्वा हर्षनिर्भरमानसः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000190039, "chapter_id": 20190, "verse_number": "१९०-४०", "content_sanskrit": "नारद उवाच साधु साधु जगन्नाथ लीलयैव यदच्युत ।\nनिहतोऽयं त्वया केशी क्लेशदस्त्रिदिवौकसाम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000190040, "chapter_id": 20190, "verse_number": "१९०-४१", "content_sanskrit": "सुकर्माण्यवतारे तु कृतानि मधुसूदन ।\nयानि वै विस्मितं चेतस्तोषमेतेन मे गतम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000190041, "chapter_id": 20190, "verse_number": "१९०-४२", "content_sanskrit": "तुरगस्यास्य शक्रोऽपि कृष्ण देवाश्च बिभ्यति ।\nधनुकेसरजालस्य ह्रेषतोऽभ्रावलोकिनः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000190042, "chapter_id": 20190, "verse_number": "१९०-४३", "content_sanskrit": "यस्मात्त्वयैष दुष्टात्मा हतः केशी जनार्दन ।\nतस्मात्केशवनाम्ना त्वं लोके गेयो भविष्यसि ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000190043, "chapter_id": 20190, "verse_number": "१९०-४४", "content_sanskrit": "स्वस्त्यस्तु ते गमिष्यामि कंसयुद्धेऽधुना पुनः ।\nपरश्वोऽहं समेष्यामि त्वया केशिनिषूदन ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000190044, "chapter_id": 20190, "verse_number": "१९०-४५", "content_sanskrit": "उग्रसेनसुते कंसे सानुगे विनिपातिते ।\nभारावतारकर्ता त्वं पृथिव्या धरणीधर ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000190045, "chapter_id": 20190, "verse_number": "१९०-४६", "content_sanskrit": "तत्रानेकप्रकारेण युद्धानि पृथिवीक्षिताम् ।\nद्रष्टव्यानि मया युष्मत्प्रणीतानि जनार्दन ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000190046, "chapter_id": 20190, "verse_number": "१९०-४७", "content_sanskrit": "सोऽहं यास्यामि गोविन्द देवकार्यं महत्कृतम् ।\nत्वया सभाजितश्चाहं स्वस्ति तेऽस्तु व्रजाम्यहम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000190047, "chapter_id": 20190, "verse_number": "१९०-४८", "content_sanskrit": "व्यास उवाच नारदे तु गते कृष्णः सह गोपैरविस्मितः ।\nविवेश गोकुलं गोपीनेत्रपानैकभाजनम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}]