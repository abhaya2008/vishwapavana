[{"id": 7004207000, "chapter_id": 24207, "verse_number": "५-१-५६-१", "content_sanskrit": "सनत्कुमार उवाच ।\nतीर्थमन्यतरं व्यास क्षातासंगमसंभवम् ।\nयत्र तु स्नानमात्रेण महापापैः प्रमुच्यते॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004207001, "chapter_id": 24207, "verse_number": "५-१-५६-२", "content_sanskrit": "अमा वै शनिवारेण यदायाति समाहितः ।\nपितॄनुद्दिश्य यः कुर्याच्छ्राद्धं चैव तिलोदकम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004207002, "chapter_id": 24207, "verse_number": "५-१-५६-३", "content_sanskrit": "पश्येच्छनैश्चरं देवं स्थावरं लिंगमुत्तमम् ।\nतस्य शानैश्चरी पीडा न भवेत्तु कदाचन॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004207003, "chapter_id": 24207, "verse_number": "५-१-५६-४", "content_sanskrit": "व्यास उवाच ।\nमहातीर्थं समाख्यातं महाकालवने शुभे ।\nभूयस्तु श्रोतुमिच्छामि विस्तरेण तपोधन॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004207004, "chapter_id": 24207, "verse_number": "५-१-५६-५", "content_sanskrit": "सनत्कुमार उवाच ।\nश्रूयतां भो द्विजश्रेष्ठ कथा पौराणिकी शुभा ।\nयस्याः श्रवणमात्रेण महापापक्षयो भवेत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004207005, "chapter_id": 24207, "verse_number": "५-१-५६-६", "content_sanskrit": "रेवा चर्मण्वती क्षाता तिस्रो नद्यः पुराऽनघ ।\nजातास्त्रैलोक्यपावन्यो भुवि चामरकंटकात्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004207006, "chapter_id": 24207, "verse_number": "५-१-५६-७", "content_sanskrit": "पुण्याः पुण्यजला रम्याः पवित्राः पापहारकाः ।\nपुनंत्यः सर्वलोकानां स्नानात्पानात्तथापगाः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004207007, "chapter_id": 24207, "verse_number": "५-१-५६-८", "content_sanskrit": "एकदोपवने रम्ये मांधातृक्षेत्र उत्तमे ।\nमिथो रमंति संहृष्टाः परस्परजिगीषया॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004207008, "chapter_id": 24207, "verse_number": "५-१-५६-९", "content_sanskrit": "किंचिद्दोषप्रसंगेन मिथो भेदो ह्यजायत ।\nरेवासंगं परित्यक्ता भित्त्वा विंध्यगिरिं वरम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004207009, "chapter_id": 24207, "verse_number": "५-१-५६-१०", "content_sanskrit": "महाकालवने रम्ये समा याता सरिद्वरा ।\nयत्र शिप्रा महापुण्या पुरी ह्येषाऽमरावती॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004207010, "chapter_id": 24207, "verse_number": "५-१-५६-११", "content_sanskrit": "सर्वतीर्थवरं श्रेष्ठं नामा रुद्रसरः स्मृतम् ।\nभुक्तिमुक्तिप्रदं नित्यं सिद्धर्षिगण सेवितम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004207011, "chapter_id": 24207, "verse_number": "५-१-५६-१२", "content_sanskrit": "तत्रागत्य पुरा क्षाता शिप्रासंगं समाश्रिता ।\nतत्र तीर्थं परं जातं क्षातासंगमसंज्ञितम् ।\nयत्र धूतरजा जातः सद्यः प्रोक्तो विभावसुः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004207012, "chapter_id": 24207, "verse_number": "५-१-५६-१३", "content_sanskrit": "व्यास उवाच ।\nकथं सूर्यस्त्वया प्रोक्तो विरजो ह्यभवत्पुरा ।\nएतद्वेदितुमिच्छामि त्वत्तो ब्रह्मविदांवर॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004207013, "chapter_id": 24207, "verse_number": "५-१-५६-१४", "content_sanskrit": "सनत्कुमार उवाच ।\nपुरानुसूर्यां सावित्रीं त्वष्टा स्वतनयां ददौ॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004207014, "chapter_id": 24207, "verse_number": "५-१-५६-१५", "content_sanskrit": "पतिधर्मरता नित्यं सिषेवे लोकचक्षुषे ।\nतस्यां वै मिथुनं जज्ञे लोकसाक्षिविभावसोः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004207015, "chapter_id": 24207, "verse_number": "५-१-५६-१६", "content_sanskrit": "यमो वैवस्वतो जातो यमुना लोकपावनी ।\nततस्त्वष्टाऽब्रवीच्छायां स्वकीयां सूनृतां गिरम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004207016, "chapter_id": 24207, "verse_number": "५-१-५६-१७", "content_sanskrit": "मिथुनं मे तवोत्संगे धृतं त्वं परिपालय ।\nतावदेवमिह च्छाये यावत्पितुर्गृहेचरी॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004207017, "chapter_id": 24207, "verse_number": "५-१-५६-१८", "content_sanskrit": "रविभक्तिरता नित्यं चर त्वं मम वेश्मनि ।\nनो वाच्याहं कदा च्छाये पितुर्वेश्मगता रवेः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004207018, "chapter_id": 24207, "verse_number": "५-१-५६-१९", "content_sanskrit": "एवं सा समयं कृत्वा सावित्री ह्यगमत्तदा ।\nपितुर्वेश्मगता बाला सवितुर्भयविह्वला॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004207019, "chapter_id": 24207, "verse_number": "५-१-५६-२०", "content_sanskrit": "पित्र निवारिता सद्यो वडवारूपधारिणी ।\nविचचार वने रम्ये बहुलोदकशाड्वले॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004207020, "chapter_id": 24207, "verse_number": "५-१-५६-२१", "content_sanskrit": "एकदा याचिता तेन वैवस्वतेन बुभुक्षता ।\nनोदनं वै तया दत्तं याचमानाय तत्क्षणात्॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004207021, "chapter_id": 24207, "verse_number": "५-१-५६-२२", "content_sanskrit": "तदा पदाहता तेन च्छाया तं च शशाप ह ।\nयतस्त्वं मे पदाघातं कृतवान्बालभावनात्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004207022, "chapter_id": 24207, "verse_number": "५-१-५६-२३", "content_sanskrit": "तस्मात्त्वं च पदा खंजो भविष्यसि न संशयः ।\nएवं शप्तो रुजाक्रांतो विललाप शुचार्दितः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004207023, "chapter_id": 24207, "verse_number": "५-१-५६-२४", "content_sanskrit": "एतस्मिन्नंतरे व्यास परिभूय वसुंधराम् ।\nभावयन्सकलांल्लोकान्ग्रहचारी विभावसुः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004207024, "chapter_id": 24207, "verse_number": "५-१-५६-२५", "content_sanskrit": "दृष्ट्वा च तनयं पंगुमित्युवाच विभावसुः ।\nकिमिदं वत्स ते कष्टं कुतः प्राप्तं त्वयाऽनघ॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004207025, "chapter_id": 24207, "verse_number": "५-१-५६-२६", "content_sanskrit": "इति पृष्टो यदा तेन सवित्रा लोकभास्वता ।\nउवाच गद्गदा वाचं यमः संयमिनीपतिः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004207026, "chapter_id": 24207, "verse_number": "५-१-५६-२७", "content_sanskrit": "प्रातराशाय मे नाथ याचितं मातुरंतिकात् ।\nनो दत्तं भोजनं क्षिप्रं बालभावेन ताडिता॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004207027, "chapter_id": 24207, "verse_number": "५-१-५६-२८", "content_sanskrit": "पादौ मे गलितौ सद्यो मातुः शापपराभवौ ।\nतच्छ्रुत्वा मोहमापन्नो रविर्ध्यानपरायणः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004207028, "chapter_id": 24207, "verse_number": "५-१-५६-२९", "content_sanskrit": "विचित्रमिदमाख्यातं मातुः शापस्य कारणम् ।\nएवं ध्यात्वा चिरं कालं ज्ञातवान्रविरंशुमान्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004207029, "chapter_id": 24207, "verse_number": "५-१-५६-३०", "content_sanskrit": "नेयं सा रुचिरापांगी त्वाष्ट्री लोकस्य पावनी ।\nकेयं वा कुत आयाता कासि त्वं च शुचिस्मिते॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004207030, "chapter_id": 24207, "verse_number": "५-१-५६-३१", "content_sanskrit": "छायोवाच ।\nनानुसूर्या महाराज छाया तस्याः स्वसंभवा ।\nगता वै सा पितुर्गेहे वारिताहं तयाऽनघ॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004207031, "chapter_id": 24207, "verse_number": "५-१-५६-३२", "content_sanskrit": "सवित्रे नैव वक्तव्यं छाये किंचित्कथंचन ।\nएष मे समयो नाथ तेनाहं मौनमास्थिता॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004207032, "chapter_id": 24207, "verse_number": "५-१-५६-३३", "content_sanskrit": "तच्छ्रुत्वा भगवांस्त्वष्टुः समीपं रोषमास्थितः ।\nजगाम सहसा भानुर्बहुरोषसमन्वितः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004207033, "chapter_id": 24207, "verse_number": "५-१-५६-३४", "content_sanskrit": "तं दृष्ट्वा सहसोत्थाय त्वष्टा लोकपितामहः ।\nपाद्यार्घ्याचमनीयं च मधुपर्कैरपूजयत्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004207034, "chapter_id": 24207, "verse_number": "५-१-५६-३५", "content_sanskrit": "नत्वा पादौ परिक्रम्य बहुमानपुरः सरम् ।\nउवाच मधुरया वाचा प्रियं ते करवाम किम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004207035, "chapter_id": 24207, "verse_number": "५-१-५६-३६", "content_sanskrit": "रविरुवाच ।\nक्व सानुसूर्या सावित्री ममानुप्रियकारिणी ।\nआगता ते गृहं तात मम मार्गानुमोदिनी॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004207036, "chapter_id": 24207, "verse_number": "५-१-५६-३७", "content_sanskrit": "त्वष्टोवाच ।\nन जानीमो वयं तात प्रिया मे क्व गता सुता ।\nइत्युक्ते वचने त्वष्ट्रा रविर्दुश्चिंतमानसः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004207037, "chapter_id": 24207, "verse_number": "५-१-५६-३८", "content_sanskrit": "किं करोमि क्व गच्छामि क्व च प्रियतरा मम ।\nइति संभाषमाणे तु त्वष्टा वाक्यमथाब्रवीत्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004207038, "chapter_id": 24207, "verse_number": "५-१-५६-३९", "content_sanskrit": "तव तेजः परिभ्रष्टा भग्ना क्वापि गताबला ।\nयदि ते वल्लभा भार्या तेजस्त्वं परिशामय॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004207039, "chapter_id": 24207, "verse_number": "५-१-५६-४०", "content_sanskrit": "सूर्य उवाच ।\nयद्येवं दुस्सहं तेजो मम पूर्वपितामह ।\nतदा ते रोचते सम्यग्यथा स्याद्वै तथा कुरु॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004207040, "chapter_id": 24207, "verse_number": "५-१-५६-४१", "content_sanskrit": "इति सूर्यवचः श्रुत्वा शाणं कृत्वा सुदर्शनम् ।\nघृष्टितः क्षुरधारेण लघीयान्निर्मलोऽभवत्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004207041, "chapter_id": 24207, "verse_number": "५-१-५६-४२", "content_sanskrit": "तस्य घृष्टितमात्रेण त्वष्टा चक्रे विवस्वतः ।\nशाणं सुदर्शनं चक्रं सैकता मणिजातयः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004207042, "chapter_id": 24207, "verse_number": "५-१-५६-४३", "content_sanskrit": "तदा त्वष्टाऽब्रवीद्वाक्यं मधुरं सूर्यसंनिधौ ।\nमहाकाल वने रम्ये वडवारूपगीरणी॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004207043, "chapter_id": 24207, "verse_number": "५-१-५६-४४", "content_sanskrit": "गृह्यतां भोः सुरश्रेष्ठ शीघ्रं गच्छतु शाड्वले ।\nयत्र शिप्रा सरिच्छ्रेष्ठा यत्र क्षाता समागता॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004207044, "chapter_id": 24207, "verse_number": "५-१-५६-४५", "content_sanskrit": "उभयोः संगमो यत्र तत्र मुक्तिर्न संशयः ।\nतत्र तां सुभगां पत्नीं प्राप्स्यसि त्वं न संशयः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004207045, "chapter_id": 24207, "verse_number": "५-१-५६-४६", "content_sanskrit": "इति तस्य वचः श्रुत्वा सविता सर्वतापनः ।\nतत्रागमद्वनं यत्र महाकालस्य पावनम्॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004207046, "chapter_id": 24207, "verse_number": "५-१-५६-४७", "content_sanskrit": "क्षातासंगमसंयुक्ता यत्र शिप्रा पयस्विनी ।\nतत्र भुक्तिश्च मुक्तिश्च धनधान्यसमागमः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004207047, "chapter_id": 24207, "verse_number": "५-१-५६-४८", "content_sanskrit": "तत्रागत्य प्रियां भार्यां वडवारूपधारिणीम् ।\nददर्श तां पुनः श्यामां हरिरूपधरो हरिः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004207048, "chapter_id": 24207, "verse_number": "५-१-५६-४९", "content_sanskrit": "नासिकाघ्राणमात्रेण यत्र जातौ सुतावुभौ ।\nदर्शनीयौ सुनृम्णांगौ भिषजौ तौ दिवौकसाम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004207049, "chapter_id": 24207, "verse_number": "५-१-५६-५०", "content_sanskrit": "छाया च सुषुवे तत्र मिथुनं द्विजसत्तम ।\nतापीं शनैश्चरं चैव सर्वलोकप्रतापनम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004207050, "chapter_id": 24207, "verse_number": "५-१-५६-५१", "content_sanskrit": "शनि योगे यदामा वै जायते सर्वकामदा ।\nतदा स्नानं च दानं च श्राद्धं चैव तु कारयेत्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004207051, "chapter_id": 24207, "verse_number": "५-१-५६-५२", "content_sanskrit": "तस्य हस्तगता लक्ष्मीर्जायते सर्वदा भुवि ।\nक्षाता संगमे नरः स्नात्वा दानं दत्त्वा च शक्तितः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004207052, "chapter_id": 24207, "verse_number": "५-१-५६-५३", "content_sanskrit": "स्थावरेशं समभ्यर्च्य तस्य पापक्षयो भवेत् ।\nसौरिः शनैश्चरो मंदः कृष्णोऽनंतोंऽतको यमः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004207053, "chapter_id": 24207, "verse_number": "५-१-५६-५४", "content_sanskrit": "पिंगश्छायासुतो बभ्रुः स्थावरः पिप्पलायनः ।\nएतानि शनिनामानि प्रातःकाले पठेन्नरः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004207054, "chapter_id": 24207, "verse_number": "५-१-५६-५५", "content_sanskrit": "तस्य शानैश्चरी पीडा न भवेत्तु कदाचन ।\nयमधर्मोऽपि चात्रैव तपस्तेपे सुदुस्तरम्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004207055, "chapter_id": 24207, "verse_number": "५-१-५६-५६", "content_sanskrit": "यज्ञकुण्डोत्तरे भागे यत्र तिष्ठति मारुतिः ।\nधर्मसरेति विख्यातं नाम्ना तत्तीर्थमुत्तमम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004207056, "chapter_id": 24207, "verse_number": "५-१-५६-५७", "content_sanskrit": "यत्र सिद्धिं परां प्राप्तस्तपसा पवनात्मजः ।\nतस्मिंस्तीर्थे नरः स्नात्वा दत्त्वा वै कांस्यभाजनम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004207057, "chapter_id": 24207, "verse_number": "५-१-५६-५८", "content_sanskrit": "सवासो मणिमु क्ताभिः कांचनालंकृतं वरम् ।\nब्राह्मणेभ्यः स्वलंकृत्य वेदविद्भ्यश्च सादरम्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004207058, "chapter_id": 24207, "verse_number": "५-१-५६-५९", "content_sanskrit": "मातृलोकं समुत्तीर्णो ब्रह्मलोके महीयते ।\nश्रावणे मास्युभे पक्षे एकादश्यां तु यो नरः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004207059, "chapter_id": 24207, "verse_number": "५-१-५६-६०", "content_sanskrit": "धर्मतीर्थे सदाचारी स्नानदानादिकाः क्रियाः ।\nकरोति सततं तस्य विष्णुलोकः सनातनः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004207060, "chapter_id": 24207, "verse_number": "५-१-५६-६१", "content_sanskrit": "च्यवनाश्रमे नरः स्नात्वा च्यवनेश्वरं विलोकयेत् ।\nयत्र सिद्धिं गतौ पुण्यावश्विनौ भिषजां वरौ॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004207061, "chapter_id": 24207, "verse_number": "५-१-५६-६२", "content_sanskrit": "च्यवनस्य प्रसादेन देवपंक्तिमवापतुः ।\nच्यवनेन पुरा दृष्टिः प्राप्ता वै देवभेषजात्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004207062, "chapter_id": 24207, "verse_number": "५-१-५६-६३", "content_sanskrit": "तस्मिंस्तीर्थे द्विजश्रेष्ठ दिव्यदृष्टिर्भवेन्नरः ।\nअत्रैव प्राप्तवान्सूर्यः साग्निहोत्राश्रमं परम्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004207063, "chapter_id": 24207, "verse_number": "५-१-५६-६४", "content_sanskrit": "अनु सूर्यां महाभागां सावित्रीं लोकविश्रुताम् ।\nसूर्यलोकं समासाद्य बुभुजे विपुलां श्रियम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004207064, "chapter_id": 24207, "verse_number": "५-१-५६-६५", "content_sanskrit": "तस्माद्व्यास परं तीर्थं क्षातासंगमसंज्ञितम् ।\nसर्वपापहरं पुण्यं सर्वकामवरप्रदम्॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004207065, "chapter_id": 24207, "verse_number": "५-१-५६-६६", "content_sanskrit": "य एतां तु कथां पुण्यां शृणोति भुवि भक्तितः ।\nपठेद्वा प्रातरुत्थाय तस्य पुण्यफलं शृणु॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004207066, "chapter_id": 24207, "verse_number": "५-१-५६-६७", "content_sanskrit": "कपिलागोसहस्रेण फलं भवति पर्वणि ।\nतत्फलं समवाप्नोति नात्र कार्या विचारणा॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}]