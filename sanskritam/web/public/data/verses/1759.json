[{"id": 2035124, "chapter_id": 1759, "verse_number": "५-४-०x", "content_sanskrit": "द्रुपद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2035125, "chapter_id": 1759, "verse_number": "५-४-१", "content_sanskrit": "एवमेतन्महाबाहो भविष्यति न संशयः।\nन हि दुर्योधनो राज्यं मधुरेण प्रदास्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2035126, "chapter_id": 1759, "verse_number": "५-४-२", "content_sanskrit": "अनुवर्त्स्यति तं चापि धृतराष्ट्रः सुतप्रियः।\nभीष्मद्रोणौ च कार्पण्यान्मौर्ख्याद्राधेयसौबलौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2035127, "chapter_id": 1759, "verse_number": "५-४-३", "content_sanskrit": "बलदेवस्य वाक्यं तु मम ज्ञाने न युज्यते।\nएतद्धि पुरुषेणाग्रे कार्यं सुनयमिच्छता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2035128, "chapter_id": 1759, "verse_number": "५-४-४", "content_sanskrit": "न तु वाच्यो मृदुवचो धार्तराष्ट्रः कथंचन ।\nनहि मार्दवसाध्योऽसौ पापबुद्धिर्मतो मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2035129, "chapter_id": 1759, "verse_number": "५-४-५", "content_sanskrit": "गर्दभे मार्दवं कुर्याद्गोषु तीक्ष्णं समाचरेत् ।\nमृदु दुर्योधने वाक्यं यो ब्रूयात्पापचेतसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2035130, "chapter_id": 1759, "verse_number": "५-४-६", "content_sanskrit": "मृदुं वै मन्यते पापो भाषमाणमशक्तिकम् ।\nहितमर्थं न जानीयादबुद्धिर्मार्दवे सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2035131, "chapter_id": 1759, "verse_number": "५-४-७", "content_sanskrit": "एतच्चैव करिष्यामो यत्नश्च क्रियतामिह ।\nप्रस्थापयाम मित्रेभ्यो बलान्युद्योजयन्तु नः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2035132, "chapter_id": 1759, "verse_number": "५-४-८", "content_sanskrit": "शल्यस्य धृष्टकेतोश्च जयत्सेनस्य वा विभो ।\nकेकयानां च सर्वेषां दूता गच्छन्तु शीघ्रगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2035133, "chapter_id": 1759, "verse_number": "५-४-९", "content_sanskrit": "स च दुर्योधनो नूनं प्रेषयिष्यति सर्वशः ।\nपूर्वाभिपन्नाः सन्तश्च भजन्ते पूर्वचोदनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2035134, "chapter_id": 1759, "verse_number": "५-४-१०", "content_sanskrit": "तत्वरध्वं नरेन्द्राणां पूर्वमेव प्रचोदने ।\nमहद्धि कार्यं वोढव्यमिति मे वर्तते मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2035135, "chapter_id": 1759, "verse_number": "५-४-११", "content_sanskrit": "शल्यस्य प्रेष्यतां शीघ्रं ये च तस्यानुगा नृपाः ।\nभगदत्ताय राज्ञे च पूर्वसागरवासिने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2035136, "chapter_id": 1759, "verse_number": "५-४-१२", "content_sanskrit": "अमितौजसे तथोग्राय हार्दिक्यायान्धकाय च।\nदीर्घप्रज्ञाय शूराय रोचमानाय वा विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2035137, "chapter_id": 1759, "verse_number": "५-४-१३", "content_sanskrit": "आनीयतां बृहन्तश्च सेनाबिन्दुश्च पार्थिवः ।\nसेनजित्प्रतिबिन्ध्यश्च चित्रवर्मा सुवास्तुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2035138, "chapter_id": 1759, "verse_number": "५-४-१४", "content_sanskrit": "बाह्लीको मुञ्जकेशश्च चैद्याधिपतिरेव च।\nसुपार्श्वश्च सुबाहुश्च पौरवश्च महारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2035139, "chapter_id": 1759, "verse_number": "५-४-१५", "content_sanskrit": "शकानां पह्लवानां कर्णवेष्टश्च पार्थिवः ॥\nसुरारिश्च नदीजश्च कर्णवेष्टश्च पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2035140, "chapter_id": 1759, "verse_number": "५-४-१६", "content_sanskrit": "नीलश्च वीरधर्मा च भूमिपालश्च वीर्यवान् ।\nदुर्जयो दन्तवक्रश्च रुक्मी च जनमेजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2035141, "chapter_id": 1759, "verse_number": "५-४-१७", "content_sanskrit": "आषाढो वायुवेगश्च पूर्वपाली च पार्थिवः ।\nभूरितेजा देवकश्च एकलव्यः सहात्मजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2035142, "chapter_id": 1759, "verse_number": "५-४-१८", "content_sanskrit": "कारूषकाश्च राजानः क्षेमधूर्तिश्च वीर्यवान् ।\nकाम्भोजा ऋषिका ये च पश्चिमानूपकाश्च ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2035143, "chapter_id": 1759, "verse_number": "५-४-१९", "content_sanskrit": "जयत्सेनश्च काश्यश्च तथा पञ्चनदा नृपाः ॥\nजानकिश्च दुर्धर्षः पार्वतीयाश्च ये नृपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2035144, "chapter_id": 1759, "verse_number": "५-४-२०", "content_sanskrit": "जानकिश्च सुशर्मा च मणिमान्योतिमत्सकः।\nपांशुराष्ट्राधिपश्चैव धृष्टकेतुश्च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2035145, "chapter_id": 1759, "verse_number": "५-४-२१", "content_sanskrit": "तुण्डश्च दण्डधारश्च बृहत्सेनश्च वीर्यवान्।\nअपराजितो निषादश्च श्रेणिमान्वसुमानपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2035146, "chapter_id": 1759, "verse_number": "५-४-२२", "content_sanskrit": "बृहद्बलो महौजाश्च बाहुः परपुरंजयः ।\nसमुद्रसेनो राजा च सह पुत्रेण वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2035147, "chapter_id": 1759, "verse_number": "५-४-२३", "content_sanskrit": "उद्भवः क्षेमकश्चैव वाटधानश्च पार्थिवः ।\nश्रुतायुश्च दृढायुश्च साल्वपुत्रश्च वीर्यवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2035148, "chapter_id": 1759, "verse_number": "५-४-२४", "content_sanskrit": "कुमारश्च कलिङ्गानामीश्वरो युद्धदुर्मदः ।\nएतेषां प्रेष्यतां शीघ्रमेतद्धि मम रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2035149, "chapter_id": 1759, "verse_number": "५-४-२५", "content_sanskrit": "अयं च ब्राह्मणो विद्वान्मम राजन्पुरोहितः।\nप्रेष्यतां धृतराष्ट्राय वाक्यमस्मै प्रदीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2035150, "chapter_id": 1759, "verse_number": "५-४-२६", "content_sanskrit": "यथा दुर्योधनो वाच्यो यथा सान्तनवो नृपः ।\nधृतराष्ट्रो यथा वाच्यो द्रोणश्च रथिनां वरः ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2035151, "chapter_id": 1759, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि सेनोद्योगपर्वणि चतुर्थोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]