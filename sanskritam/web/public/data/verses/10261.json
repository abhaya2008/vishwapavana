[{"id": 6000261000, "chapter_id": 10261, "verse_number": null, "content_sanskrit": "अथ पञ्चषष्टितमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000261001, "chapter_id": 10261, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.001.m4a", "display_order": 2}, {"id": 6000261002, "chapter_id": 10261, "verse_number": "१०-६५-१", "content_sanskrit": "हत्वा नरकमत्युग्रं दानवं दानवान्तकः।\nआरुह्य गरुडं प्रायात् प्राग्ज्योतिषपुरान्नृप॥ १०/६५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.002.m4a", "display_order": 3, "topics": [{"text": "नरकासुरवधानन्तरम् अदित्यै कुण्डलं दातुं सत्यभामया सह श्रीकृष्णेनेन्द्रलोकगमनम्", "range": "१–२"}]}, {"id": 6000261003, "chapter_id": 10261, "verse_number": "१०-६५-२", "content_sanskrit": "स गच्छन् गगने विष्णुर्वन्दितुं देवमातरम्।\nजगाम त्रिदशावासं सहितः सत्यभामया॥ १०/६५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.003.m4a", "display_order": 4}, {"id": 6000261004, "chapter_id": 10261, "verse_number": "१०-६५-३", "content_sanskrit": "स्वर्गद्वारं गतो विष्णुर्दध्मौ शङ्खं महास्वनम्।\nउपाजग्मुस्तदाकर्ण्य सार्घ्यपाद्या दिवौकसः॥ १०/६५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.004.m4a", "display_order": 5, "topics": [{"text": "तत्र शचीपुरन्दराभ्यां पूजितस्य श्रीकृष्णस्य अदित्या गृहगमनम्", "range": "३–६"}]}, {"id": 6000261005, "chapter_id": 10261, "verse_number": "१०-६५-४", "content_sanskrit": "पूजितस्तैः सुरैः कृष्णो भक्तिनम्रैर्गतज्वरैः।\nसुरेन्द्रभवनं दिव्यं प्रविवेश मनोरमम्॥ १०/६५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.005.m4a", "display_order": 6}, {"id": 6000261006, "chapter_id": 10261, "verse_number": "१०-६५-५", "content_sanskrit": "तत्र शक्रः समं शच्या पूजयामास केशवम्।\nरत्नैराभरणैर्दिव्यैर्गन्धमाल्यैश्च शोभनैः॥ १०/६५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.006.m4a", "display_order": 7}, {"id": 6000261007, "chapter_id": 10261, "verse_number": "१०-६५-६", "content_sanskrit": "ततः प्रायात् पुरीं मातुरदित्याः सह भार्यया।\nदृष्ट्वोपतस्थे तं देवी पुत्रमायान्तमच्युतम्॥ १०/६५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.007.m4a", "display_order": 8}, {"id": 6000261008, "chapter_id": 10261, "verse_number": "१०-६५-७", "content_sanskrit": "ववन्दे तां हरिस्तं सा पूजयामास भामिनी।\nआशीर्भिः परमप्रीता चिरदृष्टं यदूत्तमम्॥ १०/६५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.008.m4a", "display_order": 9, "topics": [{"text": "सत्यभामया श्वश्र्वै नरकासुरापहृतयोः कुण्डलयोः समर्पणम्", "range": "७–८"}]}, {"id": 6000261009, "chapter_id": 10261, "verse_number": "१०-६५-८", "content_sanskrit": "सत्यभामाऽपि कौरव्य श्वश्व्राः कृष्णेन चोदिता।\nपादयोः कुण्डले तस्या निधाय प्रणनाम वै॥ १०/६५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.009.m4a", "display_order": 10}, {"id": 6000261010, "chapter_id": 10261, "verse_number": "१०-६५-९", "content_sanskrit": "स्नुषामाश्लिष्य सन्तुष्टा सा पुनर्लब्धकुण्डला।\nआनन्दबाष्पप्रचुरा प्राहेदं कश्यपप्रिया॥ १०/६५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.010.m4a", "display_order": 11}, {"id": 6000261011, "chapter_id": 10261, "verse_number": "१०-६५-१०", "content_sanskrit": "न ते जरा न वैरूप्यं कान्तेन सह विप्रियम्।\nभूयात् कल्याणि सुव्यक्तं मत्प्रसादात् कदाचन॥ १०/६५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.011.m4a", "display_order": 12}, {"id": 6000261012, "chapter_id": 10261, "verse_number": "१०-६५-११", "content_sanskrit": "ततोऽनुज्ञाप्य तां देवीं त्रिदशानपि केशवः।\nआरुह्य प्रययौ तार्क्ष्यं सहितः सत्यभामया॥ १०/६५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.012.m4a", "display_order": 13}, {"id": 6000261013, "chapter_id": 10261, "verse_number": "१०-६५-१२", "content_sanskrit": "महात्मना गगने देवदेव्यौ गरुत्मता नीयमाने विचित्रम्।\nअपश्यतां नन्दनं चारगुप्तं शचीभर्तुर्दयितं हृद्यगन्धम्॥ १०/६५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.013.m4a", "display_order": 14, "topics": [{"text": "ततः प्रतिनिवृत्तयोस्तयोर्दम्पत्योर्मार्गे नन्दनवनदर्शनम्", "range": "१२–२०"}]}, {"id": 6000261014, "chapter_id": 10261, "verse_number": "१०-६५-१३", "content_sanskrit": "वनं दृष्ट्वा दिव्यगन्धं सुपुष्पं कृष्णं सत्या प्राह पाणौ गृहीत्वा।\nप्रविश्यास्मिन् साधुचित्तं विहर्तुं मुहूर्तं मे कामयते केशवेति॥ १०/६५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.014.m4a", "display_order": 15}, {"id": 6000261015, "chapter_id": 10261, "verse_number": "१०-६५-१४", "content_sanskrit": "अथावरुह्य गरुडात् तस्या वचनगौरवात्।\nप्रविवेश वनं कृष्णः पालितं शक्रकिङ्करैः॥ १०/६५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.015.m4a", "display_order": 16}, {"id": 6000261016, "chapter_id": 10261, "verse_number": "१०-६५-१५", "content_sanskrit": "तत्रापश्यत् तरून् दिव्यान् मत्तसारङ्गनादितान्।\nफलभारनतान् भूरिप्रसूनरजसाऽऽवृतान्॥ १०/६५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.016.m4a", "display_order": 17}, {"id": 6000261017, "chapter_id": 10261, "verse_number": "१०-६५-१६", "content_sanskrit": "चलत्किसलयोपेतान् विहङ्गध्वनिशोभितान्।\nविचरन्ती तथा तत्र पारिजातं महाद्रुमम्॥ १०/६५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.017.m4a", "display_order": 18}, {"id": 6000261018, "chapter_id": 10261, "verse_number": "१०-६५-१७", "content_sanskrit": "दृष्ट्वा पप्रच्छ गोविन्दं विस्मयाकुललोचना।\nकिन्नामाऽयं तरुर्देव विचित्रो भुवनत्रये॥ १०/६५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.018.m4a", "display_order": 19}, {"id": 6000261019, "chapter_id": 10261, "verse_number": "१०-६५-१८", "content_sanskrit": "सत्यमेतस्य वृक्षस्य कृतार्थाः फलभागिनः।\nप्रवालमूलो विपुलो जातरूपमहातनुः॥ १०/६५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.019.m4a", "display_order": 20}, {"id": 6000261020, "chapter_id": 10261, "verse_number": "१०-६५-१९", "content_sanskrit": "इन्द्रनीलच्छदच्छन्नो लसद्वैडूर्यवेदिकः।\nमाणिक्यपुष्पो विविधमुक्ताफलफलान्वितः॥ १०/६५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.020.m4a", "display_order": 21}, {"id": 6000261021, "chapter_id": 10261, "verse_number": "१०-६५-२०", "content_sanskrit": "गोमेदपक्‍वप्रकरो वज्रकिञ्जल्करञ्जितः।\nस्फुरन्मरकतस्थूलशाखाशतविराजितः॥ १०/६५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.021.m4a", "display_order": 22}, {"id": 6000261022, "chapter_id": 10261, "verse_number": "१०-६५-२१", "content_sanskrit": "तरुरेष जगन्नाथ मनो मे हरते भृशम्।\nनेतव्योऽयं पुरीं वृक्षो यद्यहं ते प्रिया प्रभो॥ १०/६५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.022.m4a", "display_order": 23, "topics": [{"text": "सत्यभामाप्रार्थितेन कृष्णेन पारिजातापहरणम्", "range": "२१–३०"}]}, {"id": 6000261023, "chapter_id": 10261, "verse_number": "१०-६५-२२", "content_sanskrit": "छायायामुपविष्टां मामन्यपत्न्यस्तवानघ।\nदृष्ट्वा मंस्यन्ति दयितां सर्वाभ्यो मां तवाच्युत॥ १०/६५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.023.m4a", "display_order": 24}, {"id": 6000261024, "chapter_id": 10261, "verse_number": "१०-६५-२३", "content_sanskrit": "इत्युक्तो देवकीपुत्रः सत्यया प्रियकान्तया।\nप्राह नायं तरुर्भद्रे नेतव्यो नन्दनाद् वनात्॥ १०/६५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.024.m4a", "display_order": 25}, {"id": 6000261025, "chapter_id": 10261, "verse_number": "१०-६५-२४", "content_sanskrit": "पुरा क्षीराम्बुधेर्जातो मथ्यमानात् सुरासुरैः।\nशक्राय दत्तः सकलैस्तदा तत्फलभोक्तृभिः॥ १०/६५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.025.m4a", "display_order": 26}, {"id": 6000261026, "chapter_id": 10261, "verse_number": "१०-६५-२५", "content_sanskrit": "तन्नाहार्यमनादृत्य मया मित्रं शतक्रतुम्।\nतरुरत्नं सरोजाक्षि धर्ममेवानुतिष्ठता॥ १०/६५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.026.m4a", "display_order": 27}, {"id": 6000261027, "chapter_id": 10261, "verse_number": "१०-६५-२६", "content_sanskrit": "नीयमाने च वृक्षेऽस्मिन् पारिजाते शुचिस्मिते।\nसङ्ग्रामो जायते घोरस्‍त्रिदशैर्जयकाङ्क्षिभिः॥ १०/६५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.027.m4a", "display_order": 28}, {"id": 6000261028, "chapter_id": 10261, "verse_number": "१०-६५-२७", "content_sanskrit": "इत्युक्तो देवदेवेन सत्यभामा पुनर्हरिम्।\nप्राह भीषयसे किं मां व्यलीकैः कंसमर्दन॥ १०/६५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.028.m4a", "display_order": 29}, {"id": 6000261029, "chapter_id": 10261, "verse_number": "१०-६५-२८", "content_sanskrit": "नाभ्यनन्दद् दुराचारा शची मां गृहमागताम्।\nहेतुर्हि वृक्षस्तस्यायं भर्तृपौरुषगर्विता॥ १०/६५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.029.m4a", "display_order": 30}, {"id": 6000261030, "chapter_id": 10261, "verse_number": "१०-६५-२९", "content_sanskrit": "नेतव्यः सर्वथा वृक्षः पारिजातोऽयमच्युत।\nप्रियाऽहं तव चेन्नाथ नो चेद् विरम साम्प्रतम्॥ १०/६५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.030.m4a", "display_order": 31}, {"id": 6000261031, "chapter_id": 10261, "verse_number": "१०-६५-३०", "content_sanskrit": "इत्युक्तः सत्यया कृष्णस्ताननादृत्य रक्षकान्।\nउत्पाट्यारोपयामास पारिजातं गरुत्मति॥ १०/६५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.031.m4a", "display_order": 32}, {"id": 6000261032, "chapter_id": 10261, "verse_number": "१०-६५-३१", "content_sanskrit": "ततो निवारयामासुर्गोविन्दं वनपालकाः।\nकेचिद् द्रुततरं जग्मुर्देवेन्द्राय निवेदितुम्॥ १०/६५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.032.m4a", "display_order": 33, "topics": [{"text": "वनरक्षकैर्निवेदितपारिजातहरणवृत्तान्तस्येन्द्रस्य दिक्पालकैः सह युद्धायागमनम्", "range": "३१–५१"}]}, {"id": 6000261033, "chapter_id": 10261, "verse_number": "१०-६५-३२", "content_sanskrit": "कृष्ण कृष्ण न हर्त्तव्यस्तरुरेषोऽमरार्चितः।\nहरसे यदि तस्य त्वं फलं सद्योऽनुभोक्ष्यसि॥ १०/६५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.033.m4a", "display_order": 34}, {"id": 6000261034, "chapter_id": 10261, "verse_number": "१०-६५-३३", "content_sanskrit": "प्राप्नोषि न पुरीं कृष्ण सहानेन महीरुहा।\nसद्यः पश्यसि देवेन्द्रं पृष्ठतोऽभ्युद्यतायुधम्॥ १०/६५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.034.m4a", "display_order": 35}, {"id": 6000261035, "chapter_id": 10261, "verse_number": "१०-६५-३४", "content_sanskrit": "सुरेन्द्रान्तिकमासाद्य द्रुतं ते वनरक्षकाः।\nउपविष्टं समं शच्या शक्रं दृष्ट्वाऽब्रुवन् नृप॥ १०/६५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.035.m4a", "display_order": 36}, {"id": 6000261036, "chapter_id": 10261, "verse_number": null, "content_sanskrit": "वनरक्षका ऊचुः—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.036.m4a", "display_order": 37}, {"id": 6000261037, "chapter_id": 10261, "verse_number": "१०-६५-३५", "content_sanskrit": "अवज्ञायाखिलान् देवानिन्द्राणीं च त्वया सह।\nजहार कृष्णदयिता पारिजातं महाद्रुमम्॥ १०/६५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.037.m4a", "display_order": 38}, {"id": 6000261038, "chapter_id": 10261, "verse_number": "१०-६५-३६", "content_sanskrit": "उक्ताऽस्माभिर्भृशं देव वारयद्भिर्हरिप्रिया।\nउपालभ्याहरद् वृक्षं भर्तृपौरुषगर्विता॥ १०/६५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.038.m4a", "display_order": 39}, {"id": 6000261039, "chapter_id": 10261, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.039.m4a", "display_order": 40}, {"id": 6000261040, "chapter_id": 10261, "verse_number": "१०-६५-३७", "content_sanskrit": "इत्याकर्ण्याप्रियं शक्रो दण्डाहत इवोरगः।\nशचीं विलोक्य पार्श्वस्थां नामृष्यत् तत्पराभवम्॥ १०/६५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.040.m4a", "display_order": 41}, {"id": 6000261041, "chapter_id": 10261, "verse_number": "१०-६५-३८", "content_sanskrit": "सन्नाहोद्योगमाघोष्य सन्निपात्य च सैनिकान्।\nलोकपालान् समाहूय निश्चक्राम सुरेश्वरः॥ १०/६५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.041.m4a", "display_order": 42}, {"id": 6000261042, "chapter_id": 10261, "verse_number": "१०-६५-३९", "content_sanskrit": "ऐरावतं चतुर्दन्तमारुह्य वरवारणम्।\nगृहीतवज्रं गच्छन्तमनुजग्मुर्दिवौकसः॥ १०/६५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.042.m4a", "display_order": 43}, {"id": 6000261043, "chapter_id": 10261, "verse_number": "१०-६५-४०", "content_sanskrit": "वैश्वानरस्तु तुरगमारुह्य दृढदंशितः।\nघोरां शतघ्नीमादाय स्रुवपुच्छां ययौ रणम्॥ १०/६५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.043.m4a", "display_order": 44}, {"id": 6000261044, "chapter_id": 10261, "verse_number": "१०-६५-४१", "content_sanskrit": "यमस्त्वारुह्य महिषं दण्डमादाय वीर्यवान्।\nमृत्युकालादिभिर्युक्तो युद्धार्थी शक्रमन्वगात्॥ १०/६५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.044.m4a", "display_order": 45}, {"id": 6000261045, "chapter_id": 10261, "verse_number": "१०-६५-४२", "content_sanskrit": "निर्ऋतिश्च महातेजा घोरमारुह्य पौरुषम्।\nअसिहस्तो महाबाहुर्युद्धाय प्रययौ नृप॥ १०/६५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.045.m4a", "display_order": 46}, {"id": 6000261046, "chapter_id": 10261, "verse_number": "१०-६५-४३", "content_sanskrit": "मकरं भीषणाकारमारुह्य वरुणस्त्वरन्।\nपाशोद्यतकरः प्रायाद् युद्धायानु शचीपतिम्॥ १०/६५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.046.m4a", "display_order": 47}, {"id": 6000261047, "chapter_id": 10261, "verse_number": "१०-६५-४४", "content_sanskrit": "वायुः कृष्णमृगारूढो दंशितस्तोमरायुधः।\nसुरेश्वरमनुप्रायाद् योद्धुं चक्रभृता सह॥ १०/६५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.047.m4a", "display_order": 48}, {"id": 6000261048, "chapter_id": 10261, "verse_number": "१०-६५-४५", "content_sanskrit": "ऊढां चतुर्भिः पुरुषैः शिबिकां नरवाहनः।\nयोद्धुकामस्त्वरन् प्रायाद् विष्णुना मुद्गरायुधः॥ १०/६५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.048.m4a", "display_order": 49}, {"id": 6000261049, "chapter_id": 10261, "verse_number": "१०-६५-४६", "content_sanskrit": "ईशानो वृषभं तुङ्गमारुह्य शितशूलभृत्।\nवासवेन समं प्रायात् भूतकोटिसमन्वितः॥ १०/६५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.049.m4a", "display_order": 50}, {"id": 6000261050, "chapter_id": 10261, "verse_number": "१०-६५-४७", "content_sanskrit": "भेरीशङ्खमृदङ्गैश्च पणवानकगोमुखैः।\nसुवर्णसुषिरैर्दिव्यैः कांस्यतालैश्च भूरिभिः॥ १०/६५/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.050.m4a", "display_order": 51}, {"id": 6000261051, "chapter_id": 10261, "verse_number": "१०-६५-४८", "content_sanskrit": "रथनेमिनिनादैश्च हयानां खुरनिःस्वनैः।\nक्ष्वेलितास्फोटितैर्घोरैः सङ्ग्रामाह्वानगर्जनैः॥ १०/६५/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.051.m4a", "display_order": 52}, {"id": 6000261052, "chapter_id": 10261, "verse_number": "१०-६५-४९", "content_sanskrit": "तिष्ठ तिष्ठेति मा याहि क्‍व यासीति पुनः पुनः।\nप्रवदद्भिः सुरगणैः शतशोऽथ सहस्रशः॥ १०/६५/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.052.m4a", "display_order": 53}, {"id": 6000261053, "chapter_id": 10261, "verse_number": "१०-६५-५०", "content_sanskrit": "कम्पयद्भिश्च शस्‍त्रौघैः प्रेषयद्भिश्च वाहनम्।\nपुरोऽहमिति गच्छद्भिः शतशोऽथ सहस्रशः॥ १०/६५/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.053.m4a", "display_order": 54}, {"id": 6000261054, "chapter_id": 10261, "verse_number": "१०-६५-५१", "content_sanskrit": "घोरैर्ज्याघातनिर्घोषैः सिंहनादैश्च भूरिभिः।\nअभिदुद्रुवुरुद्वृत्ताः सिंहं गोमायवो यथा॥ १०/६५/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_065/BhP_10.065.054.m4a", "display_order": 55}, {"id": 6000261055, "chapter_id": 10261, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्ध उत्तरार्धे पञ्चषष्टितमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}]