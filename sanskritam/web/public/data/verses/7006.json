    "avatarnika": ""
  },
  {
    "id": 20131509,
    "chapter_id": 7006,
    "verse_number": "24.87",
    "content_sanskrit": "ईदृशः प्राड्विवाकास्तु स्थाप्या धर्मासने द्विजाः । उत्थिताश्च प्रमत्ताश्च त्यक्तालस्या जितश्रमाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
