    "chapter_id": 7006,
    "verse_number": "24.89",
    "content_sanskrit": "सर्वशात्रार्थसंपन्नाः कुमाराधिकृतास्तथा । बृहस्पतिमतादेषां गुणांश्चाभिकांक्षयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
