    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20131505,
    "chapter_id": 7006,
    "verse_number": "24.83",
    "content_sanskrit": "पुरोधो मन्त्रिणस्त्वेभिर्गुणैर्युक्ता भवन्ति हि । बुद्धिमान्नीतिसंपन्नस्त्यक्तालस्यः प्रियंवदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
