[
  {
    "id": 20131423,
    "chapter_id": 7006,
    "verse_number": "24.1",
    "content_sanskrit": "चतुर्विंशो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20131424,
    "chapter_id": 7006,
    "verse_number": "24.2",
    "content_sanskrit": "समासतस्तु प्रकृतिस्त्रिविधा परिकीर्तिता । पुरुषाणामथ स्त्रीणामुत्तमाधममध्यमा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20131425,
    "chapter_id": 7006,
    "verse_number": "24.3",
    "content_sanskrit": "जितेन्द्रिय ज्ञानवती नानाशिल्पविचक्षणा । दक्षिणाधमहालक्ष्या भीतानां परिसान्त्वनी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20131426,
    "chapter_id": 7006,
    "verse_number": "24.4",
    "content_sanskrit": "नानाशास्त्रार्थसंपन्ना गाम्भीर्यौदार्यशालिनी । स्थैर्यत्यागगुणोपेता ज्ञेया प्रकृतिरुत्तमा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20131427,
    "chapter_id": 7006,
    "verse_number": "24.5",
    "content_sanskrit": "लोकोपचारचतुरा शिल्पशास्त्रविशारदा । विज्ञानमाधुर्ययुता मध्यमा प्रकृतिः स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20131428,
    "chapter_id": 7006,
    "verse_number": "24.6",
    "content_sanskrit": "रूक्षवाचो ऽथ दुःशीलाः कुसत्त्वाः स्थूलबुद्धयः । क्रोधनाघातकाश्चैव मित्रघ्नाश्छिद्रमानिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20131429,
    "chapter_id": 7006,
    "verse_number": "24.7",
    "content_sanskrit": "पिशुनास्तूद्धतैर्वाक्यैरकृतज्ञास्तथालसाः । मान्यामान्या विशेषज्ञा स्त्रीलोलाः कलहप्रियाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20131430,
    "chapter_id": 7006,
    "verse_number": "24.8",
    "content_sanskrit": "सूचकाः पापकर्माणः परद्रव्यापहारिणः । एभिर्दोषैस्तुसंपन्ना भवन्तीहाधमा नराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20131431,
    "chapter_id": 7006,
    "verse_number": "24.9",
    "content_sanskrit": "एवं तु शीलतो नॄणां प्रकृतिस्त्रिविधा स्मृता । स्त्रीणां पुनश्च प्रकृतिं व्याख्यास्याम्यनुपूर्वशः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20131432,
    "chapter_id": 7006,
    "verse_number": "24.10",
    "content_sanskrit": "मृदुभाबा चाचपला स्मितभाषिण्यनिष्ठुरा । गुरूणां वचने दक्षा सलज्जा विनयान्विता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20131433,
    "chapter_id": 7006,
    "verse_number": "24.11",
    "content_sanskrit": "रूपाभिजनमाधुर्यैर्गुणैः स्वाभाविकेर्युता । गाम्भीर्यधैर्यसम्पन्ना विज्ञेया प्रमदोत्तमा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20131434,
    "chapter_id": 7006,
    "verse_number": "24.12",
    "content_sanskrit": "नात्युत्कृष्टैरनिखिलैरेभिरेवान्विता गुणैः । अल्पदोषानुविद्धा च मध्यमा प्रकृतिः स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20131435,
    "chapter_id": 7006,
    "verse_number": "24.13",
    "content_sanskrit": "अधमा प्रकृतिर्या तु पुरुषाणां प्रकीर्तिता । विज्ञेया सैव नारीणामधमानां समासतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20131436,
    "chapter_id": 7006,
    "verse_number": "24.14",
    "content_sanskrit": "नपुंसकस्तु विज्ञेयः संकीर्णो ऽधम एव च । प्रेष्यादिरपि विज्ञेया संकीर्णा प्रकृतिद्विजाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20131437,
    "chapter_id": 7006,
    "verse_number": "24.15",
    "content_sanskrit": "शकारश्च विटश्चैव ये चान्येप्येवमादयः । संकीर्णास्ते ऽपि विज्ञेया ह्यधमा नाटके बुधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20131438,
    "chapter_id": 7006,
    "verse_number": "24.16",
    "content_sanskrit": "एता ज्ञेयाः प्रकृतयः पुरुषस्त्रीनपुंसकैः । आसां तु संप्रवक्ष्यामि विधानं शीलसंश्रयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20131439,
    "chapter_id": 7006,
    "verse_number": "24.17",
    "content_sanskrit": "अत्र चत्वार एव स्युर्नायकाः परिकीर्तिताः । मध्यमोत्तमप्रकृतौ नानालक्षणलक्षिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20131440,
    "chapter_id": 7006,
    "verse_number": "24.18",
    "content_sanskrit": "धीरोद्धता धीरललिता धीरोदात्तास्तथैव च । धीरप्रशान्तकाश्चैव नायकाः परिकीर्तिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20131441,
    "chapter_id": 7006,
    "verse_number": "24.19",
    "content_sanskrit": "देवा धीरोद्धता ज्ञेयाः स्युर्धीरललिता नृपाः । सेनापतिरमात्यश्च धीरोदात्तौ प्रकीर्तितौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20131442,
    "chapter_id": 7006,
    "verse_number": "24.20",
    "content_sanskrit": "धीरप्रशान्ता विज्ञेया ब्राह्मणा वाणिजस्तथा । एतेषां तु पुनर्ज्ञेयाश्चत्वारस्तु विदूषकः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20131443,
    "chapter_id": 7006,
    "verse_number": "24.21",
    "content_sanskrit": "लिंगी द्विजो राजजीवी शिष्यश्चेति यथाक्रमम् । देवक्षितिभृतामात्यब्राह्मणानां प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20131444,
    "chapter_id": 7006,
    "verse_number": "24.22",
    "content_sanskrit": "विप्रलंभसुहृदोमी संकथालापपेशलाः । व्यसनी प्राप्य दुःखं वा युज्यते ऽभ्युदयेन यः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20131445,
    "chapter_id": 7006,
    "verse_number": "24.23",
    "content_sanskrit": "तथा पुरुषमाहुस्तं प्रधानं नायकं बुधाः । यत्रानेकस्य भवतो व्यसनाभ्युदयौ पुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20131446,
    "chapter_id": 7006,
    "verse_number": "24.24",
    "content_sanskrit": "सपुष्टौ यत्र तौ स्यातां न भवेत्तत्र नायकः । दिव्या च नृपपत्नी च कुलस्त्री गणिका तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20131447,
    "chapter_id": 7006,
    "verse_number": "24.25",
    "content_sanskrit": "एतास्तु नायिका ज्ञेय नानाप्रकृतिलक्षणाः । धीरा च ललिता च स्यादुदात्ता निभृता तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20131448,
    "chapter_id": 7006,
    "verse_number": "24.26",
    "content_sanskrit": "दिव्या राजाङ्गनाश्चैव गुणैर्युक्ता भवन्ति हि । उदात्ता निभृता चैव भवेत्तु कुलजाङ्गना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20131449,
    "chapter_id": 7006,
    "verse_number": "24.27",
    "content_sanskrit": "ललिते चाभ्युदात्ते च गणिकाशिल्पकारिके । प्रकृतीनां तु सर्वासामुपचाराद् द्विधा स्मृताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20131450,
    "chapter_id": 7006,
    "verse_number": "24.28",
    "content_sanskrit": "बाह्यश्चाभ्यन्तरश्चैव तयोर्वक्ष्यामि लक्षणम् । तत्र राजोपचारो यो भवेदाभ्यन्तरो हि सः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20131451,
    "chapter_id": 7006,
    "verse_number": "24.29",
    "content_sanskrit": "ततो वाक्योपचारस्तु यस्य बाह्यः स उच्यते । अथ राजोपचारे च राज्ञामन्तःपुराश्रितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20131452,
    "chapter_id": 7006,
    "verse_number": "24.30",
    "content_sanskrit": "स्त्रीविभागं प्रवक्ष्यामि विभक्तमुपचारतः । राजोपचारं वक्ष्यामि ह्यन्तःपुरसमाश्रयम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20131453,
    "chapter_id": 7006,
    "verse_number": "24.31",
    "content_sanskrit": "महादेवी तथा देव्यः स्वामिन्यः स्थापिता अपि । भोगिन्यः शिल्पकारिण्यो नाटकीयाः सनर्तकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20131454,
    "chapter_id": 7006,
    "verse_number": "24.32",
    "content_sanskrit": "अनुचारिकाश्च विज्ञेयास्तथा च परिचारिकाः । तथा संचारिकाश्चैव तथा प्रेषणकारिकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20131455,
    "chapter_id": 7006,
    "verse_number": "24.33",
    "content_sanskrit": "महत्तर्यः प्रतीहार्यः कुमार्यः स्थविरा अपि । आयुक्तिकाश्च नृपतेरयमन्तःपुरो जनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20131456,
    "chapter_id": 7006,
    "verse_number": "24.34",
    "content_sanskrit": "अत्र मूर्धाभिषिक्ता या कुलशीलसमन्विता । गुणैर्युक्ता वयस्स्था च मध्यस्था क्रोधना तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20131457,
    "chapter_id": 7006,
    "verse_number": "24.35",
    "content_sanskrit": "मुक्तेर्ष्या नृपशीलज्ञा सुखदुःखसहा समा । शान्तिस्वस्त्ययनैर्भर्तुस्सततं मङ्गलैषिणी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20131458,
    "chapter_id": 7006,
    "verse_number": "24.36",
    "content_sanskrit": "शान्ता पतिव्रता धीरा अन्तःपुरहिते रता । एभिर्गुणैस्तु संयुक्ता महदेवीत्युदाहृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20131459,
    "chapter_id": 7006,
    "verse_number": "24.37",
    "content_sanskrit": "एभिरेव गुणैर्युक्तास्तत्संस्कारविवर्जिताः । गर्विताश्चातिसौभाग्याः पतिसंभोगतत्पराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20131460,
    "chapter_id": 7006,
    "verse_number": "24.38",
    "content_sanskrit": "शुचिनित्योज्वलाकाराः पतिपक्षाभ्यसूयकाः । वयोरूपगुणाढ्या यास्ता देव्य इति भाषिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20131461,
    "chapter_id": 7006,
    "verse_number": "24.39",
    "content_sanskrit": "सेनापतेरमात्यानां भृत्यानामथवा पुनः । भवेयुस्तनया यास्तु प्रतिसम्मानवर्जिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20131462,
    "chapter_id": 7006,
    "verse_number": "24.40",
    "content_sanskrit": "शीलरूपगुणैर्यास्तु संपन्ना नृपतेर्हिताः । स्वगुणैर्लब्धसम्माना स्वामिन्य इति ताः स्मृताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20131463,
    "chapter_id": 7006,
    "verse_number": "24.41",
    "content_sanskrit": "रूपयौवनशालिन्यः कर्कशा विभ्रमान्विताः । रतिसंभोगकुशलाः प्रतिपक्षाभ्यसूयकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20131464,
    "chapter_id": 7006,
    "verse_number": "24.42",
    "content_sanskrit": "दक्षा भर्तुश्च चित्तज्ञा गन्धमाल्योज्वलास्सदा । नृपतेश्छन्दवर्तिन्यो न हीर्ष्यामानगर्विताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20131465,
    "chapter_id": 7006,
    "verse_number": "24.43",
    "content_sanskrit": "उत्थिताश्च प्रमत्ताश्च त्यक्तालस्या न निष्ठुराः । मान्यामान्यविशेषज्ञाः स्थापिता इति ताः स्मृताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20131466,
    "chapter_id": 7006,
    "verse_number": "24.44",
    "content_sanskrit": "कुलशीललब्धपूजामृदवो नातिचोद्भटाः । मध्यस्था निभृताः क्षान्ता भोगिन्य इति ताः स्मृताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20131467,
    "chapter_id": 7006,
    "verse_number": "24.45",
    "content_sanskrit": "नानाकलाविशेषज्ञा नानाशिल्पविचक्षणाः । गन्धपुष्पविभागज्ञा लेख्यालेख्यविकल्पिकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20131468,
    "chapter_id": 7006,
    "verse_number": "24.46",
    "content_sanskrit": "शयनासनभागज्ञाश्चतुरा मधुरास्तथा । दक्षाः सौम्याः स्फुटाः श्लिष्ठा निभृताः शिल्पकारिकाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20131469,
    "chapter_id": 7006,
    "verse_number": "24.47",
    "content_sanskrit": "ग्रहमोक्षलयज्ञा या रसभावविकल्पिकाः । चतुरानाट्यकुशलाश्चोहापोहविचक्षणाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20131470,
    "chapter_id": 7006,
    "verse_number": "24.48",
    "content_sanskrit": "रूपयौवनसंपन्ना नाटकीयास्तु ताः स्मृताः । हेलाभावविशेषाढ्या सत्वेनाभिनयेन च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20131471,
    "chapter_id": 7006,
    "verse_number": "24.49",
    "content_sanskrit": "माधुर्येन च संपन्ना ह्यातोद्यकुशला तथा । अङ्गप्रत्यङ्गसंपन्ना चतुष्षष्ठिकलान्विता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20131472,
    "chapter_id": 7006,
    "verse_number": "24.50",
    "content_sanskrit": "चतुराः प्रश्नयोपेताः स्त्रीदोषैश्च विवर्जिताः । सदा प्रगल्भा च तथा त्यक्तालस्या जितश्रमा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20131473,
    "chapter_id": 7006,
    "verse_number": "24.51",
    "content_sanskrit": "नानाशिल्पप्रयोगज्ञा नृत्तगीतविचक्षणा । अथ रूपगुणौदार्यधैर्यसौभाग्यशीलसंपन्ना ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20131474,
    "chapter_id": 7006,
    "verse_number": "24.52",
    "content_sanskrit": "पेशलमधुरस्निग्धानुनादिकलचित्रकण्ठा च । समागतासु नारीषु रूपयौवनकन्तिभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20131475,
    "chapter_id": 7006,
    "verse_number": "24.53",
    "content_sanskrit": "न दृश्यते गुणैर्स्तुल्या यस्याः सा नर्तकी स्मृता । सर्वावस्थोपचारेषु या न मुञ्चति पर्थिवम्। ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20131476,
    "chapter_id": 7006,
    "verse_number": "24.54",
    "content_sanskrit": "विज्ञेया दक्षिणा दक्षा नाट्यज्ञैरनुचारिका । शय्यापाली छत्रधारी तथा व्यजनधारिणी ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20131477,
    "chapter_id": 7006,
    "verse_number": "24.55",
    "content_sanskrit": "संवाहिका गन्धयोक्त्री तथा चैव प्रसाधिका । तथाभरणयोक्त्री च माल्यसंयोजिका तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20131478,
    "chapter_id": 7006,
    "verse_number": "24.56",
    "content_sanskrit": "एवं विधा भवेयुर्याः ता ज्ञेयाः परिचारिकाः । नानाकक्ष्या विचारिण्यः तथोअपवनसंचराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20131479,
    "chapter_id": 7006,
    "verse_number": "24.57",
    "content_sanskrit": "देवतायतनक्रीडा प्रासादपरिचारिकाः । यामकिन्यस्तथा चैव याश्चैवं लक्षणाः स्त्रियः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20131480,
    "chapter_id": 7006,
    "verse_number": "24.58",
    "content_sanskrit": "संचारिकास्तु विज्ञेया नाट्यज्ञैः समुदाहृताः । प्रेषणे ऽकामसंयुक्ते गुह्यागुह्यसमुत्थिते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20131481,
    "chapter_id": 7006,
    "verse_number": "24.59",
    "content_sanskrit": "नृपैर्यास्तु नियुज्यन्ते ताः ज्ञेयाः परिचारिकाः । सर्वान्तःपुररक्षासु स्तुतिस्वस्त्ययनेन च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20131482,
    "chapter_id": 7006,
    "verse_number": "24.60",
    "content_sanskrit": "या वृद्धिमभिनन्दन्ति ता विज्ञेया महत्तराः । सन्धिविग्रहसंबद्धनानाचारसमुत्थितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20131483,
    "chapter_id": 7006,
    "verse_number": "24.61",
    "content_sanskrit": "निवेदयन्ति याः कार्यं प्रतिहार्यस्तु ताः स्मृताः । अप्राप्तरससंभोगा न संभ्रान्ता न चोद्भटाः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20131484,
    "chapter_id": 7006,
    "verse_number": "24.62",
    "content_sanskrit": "निभृताश्च सलज्जाश्च कुमार्यो बालिकाः स्मृताः । पुर्वराजनयज्ञा याः पुर्वराजाभिपूजिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20131485,
    "chapter_id": 7006,
    "verse_number": "24.63",
    "content_sanskrit": "पुर्वराजानुचरितास्ता वृद्धा इति सुज्ञिताः । भाण्डागारेष्वधिकृताश्चायुधाधिकृतास्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20131486,
    "chapter_id": 7006,
    "verse_number": "24.64",
    "content_sanskrit": "फलमूलौषधीनां च तथा चैवान्ववेक्षकी । गन्धाभरणवस्त्राणां माल्यानां चैव चिन्तिका ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20131487,
    "chapter_id": 7006,
    "verse_number": "24.65",
    "content_sanskrit": "बह्वाश्रये तथा युक्ता ज्ञेया ह्यायुक्तिकास्तु ताः । इत्यन्तःपुरचारिण्यः स्त्रियः प्रोक्ता समासतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20131488,
    "chapter_id": 7006,
    "verse_number": "24.66",
    "content_sanskrit": "विशेषणविशेषेण तासां वक्ष्यामि वै द्विजाः । अनुरक्ताश्च भक्ताश्च नानापार्श्वसमुत्थिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20131489,
    "chapter_id": 7006,
    "verse_number": "24.67",
    "content_sanskrit": "या नियुक्ता नियोगेषु कार्येषु विविधेषु च । न चोद्भटा असंभ्रान्ता न लुब्धा नापि निष्ठुराः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20131490,
    "chapter_id": 7006,
    "verse_number": "24.68",
    "content_sanskrit": "दान्ताः क्षान्ताः प्रसन्नाश्च जितक्रोधा जितेन्द्रियाः । अकामा लोभडीनाश्च स्त्रीदोषैश्च विवर्जिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20131491,
    "chapter_id": 7006,
    "verse_number": "24.69",
    "content_sanskrit": "सा त्वन्तःपुरसंचारे योज्या पार्थिववेश्मनि । कारुकाः कञ्चुकीयाश्च तथा वर्षवराः पुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20131492,
    "chapter_id": 7006,
    "verse_number": "24.70",
    "content_sanskrit": "औपस्थायिकनिर्मुण्डा स्त्रीणा प्रेषणकर्मणि । रक्षणं च कुमारीणां बालिकानां प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20131493,
    "chapter_id": 7006,
    "verse_number": "24.71",
    "content_sanskrit": "अन्तःपुराधिकारेषु राजचर्यानुवर्त्तिनाम् । सर्ववृत्तान्तसंवाहाः पत्यागारे नियोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20131494,
    "chapter_id": 7006,
    "verse_number": "24.72",
    "content_sanskrit": "विनीताः स्वल्पसत्त्वा ये क्लीबा वै स्त्रीस्वभाविकाः । जात्या न दोषिणश्चैव ते वै वर्षवराः स्मृताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20131495,
    "chapter_id": 7006,
    "verse_number": "24.73",
    "content_sanskrit": "ब्रह्माणाः कुशला वृद्धाः कामदोषविवर्जिताः । प्रयोजनेषु देवीनां प्रयोक्तव्या नृपैः सदा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20131496,
    "chapter_id": 7006,
    "verse_number": "24.74",
    "content_sanskrit": "एतदष्टादशविधं प्रोक्तमन्तःपुरं मया । अतः परं प्रवक्ष्यामि बाह्यं पुरुषसंभवम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20131497,
    "chapter_id": 7006,
    "verse_number": "24.75",
    "content_sanskrit": "राजा सेनापतिश्चैव पुरोधा मन्त्रिणस्तथा । सचिवाः प्राड्विवाकाश्च कुमाराधिकृतास्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20131498,
    "chapter_id": 7006,
    "verse_number": "24.76",
    "content_sanskrit": "एके चान्ये च बहवो मान्या ज्ञेया नृपस्य तु । वेशेषमेषां वक्ष्यामि लक्षणेन निबोधत ॥",
