  },
  {
    "id": 20131499,
    "chapter_id": 7006,
    "verse_number": "24.77",
    "content_sanskrit": "बलवान् बुद्धिसंपन्नः सत्यवादी जितेन्द्रियः । दक्षः प्रगल्भो धृतिमान् विक्रान्तो मतिमाञ्छुचिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20131500,
    "chapter_id": 7006,
    "verse_number": "24.78",
    "content_sanskrit": "दीर्घदर्शी महोत्साहः कृतज्ञः प्रियवाङ्मृदुः । लोकपालव्रतधरः कर्ममार्गविशारदः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
