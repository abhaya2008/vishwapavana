    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20131506,
    "chapter_id": 7006,
    "verse_number": "24.84",
    "content_sanskrit": "पररन्ध्रविधिज्ञश्च यात्राकालविशेषवित् । अर्थशास्त्रार्थकुशलो ह्यनुरक्तः कुलोद्भवः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20131507,
    "chapter_id": 7006,
    "verse_number": "24.85",
    "content_sanskrit": "देशवित्कालविच्चैव कर्तव्यः क्षितिपैः सदा । व्यवहारार्थतत्त्वज्ञा बुद्धिमन्तो बहुश्रुताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20131508,
    "chapter_id": 7006,
    "verse_number": "24.86",
    "content_sanskrit": "मध्यस्था धार्मिका धीराः कार्याकार्यविवेकिनः । क्षान्ता दान्ता जितक्रोधा सर्वत्र समदर्शिनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
