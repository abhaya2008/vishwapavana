    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20131501,
    "chapter_id": 7006,
    "verse_number": "24.79",
    "content_sanskrit": "उत्थितश्चाप्रमत्तश्च वृद्धसेव्यर्थशास्त्रवित् । परभावेङ्गिताभिज्ञः शूरो रक्षासमन्वितः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20131502,
    "chapter_id": 7006,
    "verse_number": "24.80",
    "content_sanskrit": "ऊहापोहविचारी च नानाशिल्पप्रयोजकः । नीतिशास्त्रार्थकुशलस्तथा चैवानुरागवान् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20131503,
    "chapter_id": 7006,
    "verse_number": "24.81",
    "content_sanskrit": "धर्मज्ञो ऽव्यसनी चैव गुणैरेतेर्भवेन्नृपः । कुलीना बुद्धिसंपन्ना नानाशास्त्रविपश्चिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20131504,
    "chapter_id": 7006,
    "verse_number": "24.82",
    "content_sanskrit": "स्निग्धा परेरहार्यश्च न प्रमत्ताश्च देशजाः । अलुब्धाश्च विनीताश्च शुचयो धार्मिकास्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
