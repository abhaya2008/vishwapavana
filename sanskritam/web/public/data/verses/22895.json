[{"id": 7002895000, "chapter_id": 22895, "verse_number": "९-१८०-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nभगवन्क्षत्रियैः शूरैः स्ववीर्योपात्तसंचयैः ।\nकानि दानानि देयानि पवित्राणि शुभानि च ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002895001, "chapter_id": 22895, "verse_number": "९-१८०-२", "content_sanskrit": "अन्यैर्वा पुरुषैः कृष्ण अधर्मभयभीरुभिः ।\nग्रहपीडाङिसंतप्तैर्दुःस्वप्नाद्युपतापितैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002895002, "chapter_id": 22895, "verse_number": "९-१८०-३", "content_sanskrit": "इह लोके परे चैव विहितं सर्वकामदम् ।\nविशेषविहितं दानं कथयस्व महामते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002895003, "chapter_id": 22895, "verse_number": "९-१८०-४", "content_sanskrit": "श्रीकृष्ण उवाच ।\nशृणु भूपाल भद्रं ते दानधर्ममनुत्तमम् ।\nविशेषेण महीपानां हिताय च न संशयः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002895004, "chapter_id": 22895, "verse_number": "९-१८०-५", "content_sanskrit": "दानानि बहुरूपाणि नानाशास्त्रोदितानि च ।\nगोदानादीनि राजेन्द्र प्रधानानि न संशयः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002895005, "chapter_id": 22895, "verse_number": "९-१८०-६", "content_sanskrit": "किं तु प्रधानमेकं ते दानं वक्ष्यामि भारत ।\nवैरोचनाय यत्सर्वं शुक्रः प्रोवाच भारत ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002895006, "chapter_id": 22895, "verse_number": "९-१८०-७", "content_sanskrit": "शुक्र उवाच ।\nशृणु दैत्यपते दानं सर्वपापप्रणाशनम् ।\nआधयो व्याधयश्चैव ग्रहपीडा सुदारुणाः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002895007, "chapter_id": 22895, "verse_number": "९-१८०-८", "content_sanskrit": "येन दत्तेन नश्यंति पुण्यमाप्नोति चोत्तमम् ।\nकार्त्तिक्यामयने चैव ग्रहणे शशिसूर्ययोः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002895008, "chapter_id": 22895, "verse_number": "९-१८०-९", "content_sanskrit": "दानमेतत्प्रदातव्यं विषुवे सूर्यसंक्रमे ।\nपुण्यं दिनमथासाद्य जितक्रोधो जितेंद्रियः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002895009, "chapter_id": 22895, "verse_number": "९-१८०-१०", "content_sanskrit": "संस्थाप्य दारुजं दिव्यं हेमपट्टैरलंकृतम् ।\nरथं सुचक्राक्षधरं युगयोक्त्रसमन्वितम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002895010, "chapter_id": 22895, "verse_number": "९-१८०-११", "content_sanskrit": "सुवर्णध्वजसंयुक्तं सितासितपताकिनम् ।\nपुष्पप्रकरसंकीर्णे प्रागुदक्प्रवणे शुभे ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002895011, "chapter_id": 22895, "verse_number": "९-१८०-१२", "content_sanskrit": "नद्यास्तीरेऽथ वा गोष्ठे विचित्रे वा गृहांगणे ।\nरथस्य पूर्वभागे तु कृत्वा वेदीमनुत्तमाम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002895012, "chapter_id": 22895, "verse_number": "९-१८०-१३", "content_sanskrit": "पुराणवेदविद्यावान्विनयाचारसंयुतः ।\nतस्यां संस्थापयेद्देवान्ब्रह्मादीन्कथयामि ते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002895013, "chapter_id": 22895, "verse_number": "९-१८०-१४", "content_sanskrit": "मध्ये ब्रह्मा प्रतिष्ठाप्यः पूजयेत्प्रणवेन तम् ।\nविष्णुरुत्तरतः स्थाप्यः पौरुषेण तमर्चयेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002895014, "chapter_id": 22895, "verse_number": "९-१८०-१५", "content_sanskrit": "सूक्तेन रुद्रं रौद्रेण दक्षिणस्यां समर्चयेत् ।\nग्रहान्सूर्यमुखांश्चैव विधिवत्पूजयेत्तथा ।\nपुष्पैर्गंधैः फलैर्भक्ष्यैर्दीपमालाभिरेव च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002895015, "chapter_id": 22895, "verse_number": "९-१८०-१६", "content_sanskrit": "पूजयेद्गंधकुसुमैः श्वेतवस्त्रैः सचंदनैः ।\nशंखभेरीमृदंगानां शब्दैः सर्वत्रगामिभिः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002895016, "chapter_id": 22895, "verse_number": "९-१८०-१७", "content_sanskrit": "ब्रह्मघोषविमिश्रैश्च कारयेत महोत्सवम् ।\nकुंडं कृत्वा विधानेन हस्तमात्रप्रमाणतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002895017, "chapter_id": 22895, "verse_number": "९-१८०-१८", "content_sanskrit": "आग्नेय्यां दिशि राजेंद्र ब्राह्मणांस्तत्र पूजयेत् ।\nचतुश्चारणिकान्विप्रान्पूजितान्ब्रह्मभूषणैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002895018, "chapter_id": 22895, "verse_number": "९-१८०-१९", "content_sanskrit": "चतुरोष्टौ महाराज गुरुरेकोऽथवा भवेत् ।\nहोमोपकरणं सर्वं मेलयित्वा तिलान्घृतम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002895019, "chapter_id": 22895, "verse_number": "९-१८०-२०", "content_sanskrit": "अग्निकार्यं ततः कुर्याद्यथावद्विधिपूर्वकम् ।\nआघारावाज्यभागौ तु हुत्वा प्राग्वच्च तौ ततः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002895020, "chapter_id": 22895, "verse_number": "९-१८०-२१", "content_sanskrit": "विष्णवे शितिकण्ठाय मंत्रैः पूर्वोदितैः शुभैः ।\nग्रहयज्ञोदितैश्चैव ग्रहाणां होम इष्यते ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002895021, "chapter_id": 22895, "verse_number": "९-१८०-२२", "content_sanskrit": "एवं यज्ञविधिं कृत्वा यजमानो द्विजैः सह ।\nयोजयेत रथे दांतौ गजौ लक्षणसंयुतौ ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002895022, "chapter_id": 22895, "verse_number": "९-१८०-२३", "content_sanskrit": "विचित्रतनुसंवीतौ शुभकक्षौ सुघंटिकी ।\nहेमपट्टैः सुतिलकैः शोभितौ शंखचामरैः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002895023, "chapter_id": 22895, "verse_number": "९-१८०-२४", "content_sanskrit": "दिव्यमुक्तापरिच्छन्नौ दिव्यांकुशसमन्वितौ ।\nमहामात्रान्वितौ चैव सर्वाभरणभूषितौ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002895024, "chapter_id": 22895, "verse_number": "९-१८०-२५", "content_sanskrit": "एवं विधिं ततः कृत्वा रथं तं सगजं नरः ।\nआरोपयेत्ततस्तस्मिन्ब्राह्मणं शंसितव्रतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002895025, "chapter_id": 22895, "verse_number": "९-१८०-२६", "content_sanskrit": "भूषितं कण्ठकटकैः कर्णवेष्टांगुलीयकैः ।\nआगुप्तचोलकच्छत्र वस्त्रायुधसमन्वितम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002895026, "chapter_id": 22895, "verse_number": "९-१८०-२७", "content_sanskrit": "बद्धतूणिं धनुष्पाणिं बहुचर्मविभूषितम् ।\nखड्गधेनुकया नद्धं हारालंकृतविग्रहम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002895027, "chapter_id": 22895, "verse_number": "९-१८०-२८", "content_sanskrit": "यजमानस्ततः प्राज्ञः शुक्लांबरधरः शुचिः ।\nरथं प्रदक्षिणीकृत्य गृहीतकुसुमांजलिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002895028, "chapter_id": 22895, "verse_number": "९-१८०-२९", "content_sanskrit": "इममुच्चारयेन्मन्त्रं सर्वपापप्रणाशनम् ।\nकुमुदैरावणौ पद्मः पुष्पदंतोऽथ वामनः ।\nसुप्रतीकोंजनः सार्वभौमोऽष्टौ देवयोनयः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002895029, "chapter_id": 22895, "verse_number": "९-१८०-३०", "content_sanskrit": "तेषां वंशप्रसूतौ तु बलरूपसमन्वितौ ।\nतद्युक्तरथदानेन मम स्यातां वरप्रदौ ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002895030, "chapter_id": 22895, "verse_number": "९-१८०-३१", "content_sanskrit": "रथोऽयं यज्ञपुरुषो ब्राह्मणोत्र शिवः स्वयम् ।\nममेभरथदानेन प्रीयेतां शिवकेशवौ ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002895031, "chapter_id": 22895, "verse_number": "९-१८०-३२", "content_sanskrit": "इत्युच्चार्य महाभागे पूजयित्वा पुनःपुनः ।\nआरोपयेत्ततस्तस्मिन्ब्राह्मणं शंसितव्रतम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002895032, "chapter_id": 22895, "verse_number": "९-१८०-३३", "content_sanskrit": "स्वदारनिरतं शांतं वेदवेदांगपारगम् ।\nपञ्चाग्न्यभिमतं चैव अव्यंगं व्याधिवर्जितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002895033, "chapter_id": 22895, "verse_number": "९-१८०-३४", "content_sanskrit": "पुनः प्रदक्षिणीकृत्य रथस्थं द्विजसत्तमम् ।\nआद्वारमनुगच्छेच्च प्रणिपत्य गृहं विशेत् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002895034, "chapter_id": 22895, "verse_number": "९-१८०-३५", "content_sanskrit": "ततो यज्ञावसाने तु दीनांधादीञ्जडान्कृशान् ।\nपूजयेद्विविधैर्दानैर्वस्त्रगोदानभोजनैः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002895035, "chapter_id": 22895, "verse_number": "९-१८०-३६", "content_sanskrit": "अनेनैव विधानेन संकल्प्य रथमुत्तमम् ।\nकुण्डमंडपसंभारभूषणाच्छादनादिकम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002895036, "chapter_id": 22895, "verse_number": "९-१८०-३७", "content_sanskrit": "तदेव होमद्रव्यं च होममंत्रास्त एव हि ।\nविशेषोऽश्वरथे राजन्कथ्यमानो निबोध्यताम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002895037, "chapter_id": 22895, "verse_number": "९-१८०-३८", "content_sanskrit": "हयौ लक्षणसंयुक्तौ खलीनालंकृताननौ ।\nविचित्रवस्तुसंवीतौ कण्ठाभरणभूषितौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002895038, "chapter_id": 22895, "verse_number": "९-१८०-३९", "content_sanskrit": "सुप्रग्रहयुतौ योज्यौ दाता तस्मिन्नथोत्तमे ।\nतं प्रदक्षिणमावृत्त्य मंत्रमेतमुदीरयेत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002895039, "chapter_id": 22895, "verse_number": "९-१८०-४०", "content_sanskrit": "नमोस्तु ते वेदतुरंगमाय त्रयीमयाय त्रिगुणात्मकाय ।\nसुदुर्गमार्गे सुखपानपात्रे नमोऽस्तु ते वाजिधराय नित्यम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002895040, "chapter_id": 22895, "verse_number": "९-१८०-४१", "content_sanskrit": "रथोऽयं सविता साक्षाद्वेदाश्चामी तुरंगमाः ।\nअरुणो ब्राह्मणश्चायं प्रयच्छंतु सुखं मम ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002895041, "chapter_id": 22895, "verse_number": "९-१८०-४२", "content_sanskrit": "इत्युच्चार्य ततस्तस्मिन्रथे ब्राह्मणसत्तमम् ।\nआरोपयेद्गृहाद्द्वारं यावदेतमनुव्रजेत् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002895042, "chapter_id": 22895, "verse_number": "९-१८०-४३", "content_sanskrit": "अनेन विधिना यस्तु दद्याद्वाजिरथं बुधः ।\nतस्माद्वाहरथं राज्यं तस्य पुण्यफलं शृणु ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002895043, "chapter_id": 22895, "verse_number": "९-१८०-४४", "content_sanskrit": "सर्वपापविनिर्मुक्तः सर्वामयविवर्जितः ।\nमन्वंतरशतं यावत्सर्वभोगसमन्वितः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002895044, "chapter_id": 22895, "verse_number": "९-१८०-४५", "content_sanskrit": "अप्सरोगणसंकीर्णे विमाने सूर्यवर्चसे ।\nदिव्यभोगान्वितः श्रीमान्कामचारी वसेद्दिवि ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002895045, "chapter_id": 22895, "verse_number": "९-१८०-४६", "content_sanskrit": "पुण्यक्षयादिहाभ्येत्य राजा भवति धार्मिकः ।\nपुत्रपौत्रान्वितश्चैव चिरंजीवी प्रियातिथिः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002895046, "chapter_id": 22895, "verse_number": "९-१८०-४७", "content_sanskrit": "गजेनैकेन निर्दिष्टः कश्चिद्गजरथो नृप ।\nएकेनाश्वेनाश्वरथः कथ्यते वेदवादिभिः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002895047, "chapter_id": 22895, "verse_number": "९-१८०-४८", "content_sanskrit": "दानमंत्रास्त एवोक्ताः फलं तत्र निगद्यते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002895048, "chapter_id": 22895, "verse_number": "९-१८०-४९", "content_sanskrit": "यच्छंति ये रथवरं सुधुराक्षचक्रं विक्रांतवारणयुतं तुरगान्वितं वा ।\nसोपस्करं कनकपट्टविचित्रितागं ते स्यंदनेन सुरराजपुरं प्रयांति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]