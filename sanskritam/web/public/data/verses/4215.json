[{"id": 2148517, "chapter_id": 4215, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2148518, "chapter_id": 4215, "verse_number": "१", "content_sanskrit": "आगम्य हस्तिनपुरादुपप्लाव्यमरिन्दमः ।\nपाण्डवानां यथावृत्तं केशवः पूर्वमुक्तवान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2148519, "chapter_id": 4215, "verse_number": "२", "content_sanskrit": "सम्भाष्य सुचिरं कालं मन्त्रयित्वा पुनः पुनः ।\nस्वमेव भवनं शौरिर्विश्रमार्थं जगाम ह\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2148520, "chapter_id": 4215, "verse_number": "३", "content_sanskrit": "विसृज्य सर्वान् नृपतीन् विराटप्रमुखांस्तदा ।\nपाण्डवा भ्रातरः पञ्च भानावस्तं गते सति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2148521, "chapter_id": 4215, "verse_number": "४", "content_sanskrit": "सन्ध्यामुपास्य ध्यायन्तस्तमेव गतमानसाः ।\nआनाय्य कृष्णं दाशार्हं पुनर्मन्त्रममन्त्रयन्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2148522, "chapter_id": 4215, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2148523, "chapter_id": 4215, "verse_number": "५", "content_sanskrit": "त्वया नागपुरं गत्वा सभायां धृतराष्ट्रजः ।\nकिमुक्तः पुण्डरीकाक्ष तं नः शंसितुमर्हसि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2148524, "chapter_id": 4215, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2148525, "chapter_id": 4215, "verse_number": "६", "content_sanskrit": "मया नागपुरं गत्वा सभायां धृतराष्ट्रजः ।\nतथ्यं पथ्यं हितं चोक्तो न च गृह्णाति दुर्मतिः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2148526, "chapter_id": 4215, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2148527, "chapter_id": 4215, "verse_number": "७", "content_sanskrit": "तस्मिन्नुत्पथमापन्ने कुरुवृद्धः पितामहः ।\nकिमुक्तवान् हृषीकेश दुर्योधनममर्षणम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2148528, "chapter_id": 4215, "verse_number": "८", "content_sanskrit": "आचार्यो वा महाबाहो भारद्वाजः किमब्रवीत् ।\nपिता वा धृतराष्ट्रस्तं गान्धारी वा किमब्रवीत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2148529, "chapter_id": 4215, "verse_number": "९", "content_sanskrit": "पिता यवीयानस्माकं क्षत्ता धर्मविदां वरः ।\nपुत्रशोकाभिसन्तप्तः किमाह धृतराष्ट्रजम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2148530, "chapter_id": 4215, "verse_number": "१०", "content_sanskrit": "किञ्च सर्वे नृपतयः सभायां ये समागताः ।\nउक्तवन्तो यथातत्त्वं तद् ब्रूहि त्वं जनार्दन\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2148531, "chapter_id": 4215, "verse_number": "११", "content_sanskrit": "उक्तवान् हि भवान् सर्वं वचनं कुरुमुख्ययोः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2148532, "chapter_id": 4215, "verse_number": "१२", "content_sanskrit": "धार्तराष्ट्रस्य तेषां हि वचनं कुरुसंसदि ।\nकामलोभाभिभूतस्य मन्दस्य प्राज्ञमानिनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2148533, "chapter_id": 4215, "verse_number": "१३", "content_sanskrit": "अप्रियं हृदये तस्य किं नु तिष्ठति केशव\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2148534, "chapter_id": 4215, "verse_number": "१४", "content_sanskrit": "तेषां वाक्यानि सर्वेषां श्रोतुमिच्छाम्यहं विभो ।\nयथा च नातिपद्येत कालस्तात तथा कुरु\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2148535, "chapter_id": 4215, "verse_number": "१५", "content_sanskrit": "भवान् हि नो बलं कृष्ण भवान् नाथो भवान् गतिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2148536, "chapter_id": 4215, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2148537, "chapter_id": 4215, "verse_number": "१६", "content_sanskrit": "शृणु राजन् यथा वाक्यमुक्तो राजा सुयोधनः ।\nमध्ये कुरूणां राजेन्द्र सभायां तन्निबोध मे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2148538, "chapter_id": 4215, "verse_number": "१७", "content_sanskrit": "मया विश्राविते वाक्ये जहास धृतराष्ट्रजः ।\nअथ भीष्मः सुसङ्क्रुद्ध इदं वचनमब्रवीत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2148539, "chapter_id": 4215, "verse_number": "१८", "content_sanskrit": "दुर्योधन निबोधेदं कुलार्थे यद् ब्रवीमि ते ।\nतच्छ्रुत्वा राजशार्दूल स्वकुलस्य हितं कुरु\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2148540, "chapter_id": 4215, "verse_number": "१९", "content_sanskrit": "मम तात पिता राजन् शन्तनुर्लोकविश्रुतः ।\nतस्याहमेक एवासं पुत्रः पुत्रवतां वर\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2148541, "chapter_id": 4215, "verse_number": "२०", "content_sanskrit": "तस्य बुद्धिः समुत्पन्ना द्वितीयः स्यात् कथं सुतः ।\nएकं पुत्रमपुत्रं वै प्रवदन्ति मनीषिणः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2148542, "chapter_id": 4215, "verse_number": "२१", "content_sanskrit": "न चोच्छेदं कुलं यायाद् विस्तीर्येत कथं यशः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2148543, "chapter_id": 4215, "verse_number": "२२", "content_sanskrit": "तस्याहमीप्सितं बुद्ध्वा काळीं मातरमावहम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2148544, "chapter_id": 4215, "verse_number": "२३", "content_sanskrit": "प्रतिज्ञां दुष्करां कृत्वा पितुरर्थे कुलस्य च ।\nअराजा चोर्ध्वरेताश्च यथा सुविदितं तव\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2148545, "chapter_id": 4215, "verse_number": "२४", "content_sanskrit": "प्रतीतो निवसाम्येष प्रतिज्ञामनुपालयन्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2148546, "chapter_id": 4215, "verse_number": "२५", "content_sanskrit": "तस्यां जज्ञे महाबाहुः श्रीमान् कुरुकुलोद्वहः ।\nविचित्रवीर्यो धर्मात्मा कनीयान् मम पार्थिवः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2148547, "chapter_id": 4215, "verse_number": "२६", "content_sanskrit": "स्वर्यातेऽहं पितरि तं स्वराज्ये सन्निवेशयम् ।\nविचित्रवीर्यं राजानं भृत्यो भूत्वा ह्यधश्चरः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2148548, "chapter_id": 4215, "verse_number": "२७", "content_sanskrit": "तस्याहं सदृशान् दारान् राजेन्द्र समुदावहम् ।\nजित्वा पार्थिवसङ्घातमपि ते बहुशः श्रुतम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2148549, "chapter_id": 4215, "verse_number": "२८", "content_sanskrit": "ततो रामेण समरे द्वन्द्वयुद्धमुपागमम् ।\nस हि रामभयादेभिर्नागरैर्विप्रवासितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2148550, "chapter_id": 4215, "verse_number": "२९", "content_sanskrit": "दारेष्वप्यतिसक्तश्च यक्ष्माणं समपद्यत\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2148551, "chapter_id": 4215, "verse_number": "३०", "content_sanskrit": "यदा त्वराजके राष्ट्रे न ववर्ष सुरेश्वरः ।\nतदाऽभ्यधावन् मामेव प्रजाः क्षुद्भयपीडिताः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2148552, "chapter_id": 4215, "verse_number": "", "content_sanskrit": "प्रजाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2148553, "chapter_id": 4215, "verse_number": "३१", "content_sanskrit": "उपक्षीणाः प्रजाः सर्वा राजा भव भवाय नः ।\nईतयो नुद भद्रं ते शन्तनोः कुलवर्धन\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2148554, "chapter_id": 4215, "verse_number": "३२", "content_sanskrit": "पीड्यन्ते ते प्रजाः सर्वा व्याधिभिर्भृशदारुणैः ।\nअल्पावशिष्टा गाङ्गेय ताः परित्रातुमर्हसि\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2148555, "chapter_id": 4215, "verse_number": "३३", "content_sanskrit": "व्याधीन् प्रणुद्य वीर त्वं प्रजा धर्मेण पालय ।\nत्वयि जीवति मा राष्ट्रं विनाशमुपगच्छतु\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2148556, "chapter_id": 4215, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2148557, "chapter_id": 4215, "verse_number": "३४", "content_sanskrit": "प्रजानां क्रोशतीनां वै नैवाक्षुभ्यत मे मनः ।\nप्रतिज्ञां रक्षमाणस्य सद्वृत्तं स्मरतस्तथा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2148558, "chapter_id": 4215, "verse_number": "३५", "content_sanskrit": "ततः पौरा महाराज माता काळी च मे शुभा ।\nभृत्याः पुरोहिताचार्या ब्राह्मणाश्च बहुश्रुताः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2148559, "chapter_id": 4215, "verse_number": "३६", "content_sanskrit": "मामूचुर्भृशसन्तप्ता भव राजेति सन्ततम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2148560, "chapter_id": 4215, "verse_number": "३७", "content_sanskrit": "प्रतीपरक्षितं राज्यं त्वां प्राप्य विनशिष्यति ।\nस त्वमस्मद्धितार्थं वै राजा भव महामते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2148561, "chapter_id": 4215, "verse_number": "३८", "content_sanskrit": "इत्युक्तः प्राञ्जलिर्भूत्वा दुःखितो भृशमातुरः ।\nतेभ्यो न्यवेदयं तत्र प्रतिज्ञां पितृगौरवात्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2148562, "chapter_id": 4215, "verse_number": "३९", "content_sanskrit": "ऊर्ध्वरेता ह्यराजा च कुलस्यार्थे पुनः पुनः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2148563, "chapter_id": 4215, "verse_number": "४०", "content_sanskrit": "ततोऽहं प्राञ्जलिर्भूत्वा मातरं सम्प्रसादयम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2148564, "chapter_id": 4215, "verse_number": "४१", "content_sanskrit": "नाम्ब शन्तनुना जातः कौरवं वंशमुद्वहन् ।\nप्रतिज्ञां वितथां कुर्यामिति राजन् पुनः पुनः\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2148565, "chapter_id": 4215, "verse_number": "४२", "content_sanskrit": "विशेषतस्तदर्थं च धुरि मा मां नियोजय ।\nअहं प्रेष्यश्च दासश्च तवाम्ब सुतवत्सले\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2148566, "chapter_id": 4215, "verse_number": "४३", "content_sanskrit": "एवं तामनुनीयाहं मातरं जनमेव च ।\nअहं च भ्रातृदारेषु तदा व्यासं महामुनिम्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2148567, "chapter_id": 4215, "verse_number": "४४", "content_sanskrit": "सह मात्रा महाराज प्रसाद्य तमृषिं तदा ।\nअपत्यार्थमयाचं वै प्रसादं कृतवांश्च सः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2148568, "chapter_id": 4215, "verse_number": "४५", "content_sanskrit": "त्रीन् पुत्रानजनयद् व्यासस्तदा भरतसत्तम\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2148569, "chapter_id": 4215, "verse_number": "४६", "content_sanskrit": "अन्धः करणहीनत्वान्न वै राजा पिता तव ।\nराजा तु पाण्डुरभवन्महात्मा लोकविश्रुतः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2148570, "chapter_id": 4215, "verse_number": "४७", "content_sanskrit": "स राजा तस्य ते पुत्राः पितुर्दायाद्यहारिणः ।\nमा तात कलहं कार्षी राज्यस्यार्धं प्रदीयताम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2148571, "chapter_id": 4215, "verse_number": "४८", "content_sanskrit": "मयि जीवति राज्यं कः सम्प्रशासेत् पुमानिह ।\nमाऽवमंस्था वचो मह्यं शममिच्छामि वः सदा\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2148572, "chapter_id": 4215, "verse_number": "४९", "content_sanskrit": "न विशेषोऽस्ति मे पुत्र त्वयि तेषु च पार्थिव ।\nमतमेतत् पितुस्तुभ्यं गान्धार्या विदुरस्य च\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2148573, "chapter_id": 4215, "verse_number": "५०", "content_sanskrit": "श्रोतव्यं खलु वृद्धानां मा विशङ्कीर्वचो मम ।\nनाशयिष्यन्निमं सर्वमात्मानं पृथिवीपते\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2148574, "chapter_id": 4215, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि षट्चत्वारिंशोत्तरशततमोऽध्यायः ॥१४६॥\nविवादपर्वणि अष्टमोऽध्यायः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}]