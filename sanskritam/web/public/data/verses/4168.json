[{"id": 2146832, "chapter_id": 4168, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146833, "chapter_id": 4168, "verse_number": "१", "content_sanskrit": "हिरण्यपुरमित्येतत् ख्यातं पुरवरं महत् ।\nदैत्यानां दानवानां च मायाशतविहारिणाम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146834, "chapter_id": 4168, "verse_number": "२", "content_sanskrit": "अनल्पेन प्रयत्नेन निर्मितं विश्वकर्मणा ।\nमयेन मनसा सृष्टं पाताळतळमाश्रितम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146835, "chapter_id": 4168, "verse_number": "३", "content_sanskrit": "अत्र मायासहस्राणि विकुर्वाणा महौजसः ।\nदानवा निवसन्ति स्म शूरा दत्तवराः पुरा\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146836, "chapter_id": 4168, "verse_number": "४", "content_sanskrit": "नैते शक्रेण नान्येन यमेन वरुणेन वा ।\nशक्यन्ते वशमानेतुं तथैव धनदेन च\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146837, "chapter_id": 4168, "verse_number": "५", "content_sanskrit": "पौलोमाः कालकेयाश्च कश्यपस्य कुलोद्भवाः ।\nनैर्ऋता यातुधानाश्च ब्रह्मपादोद्भवाश्च ये\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146838, "chapter_id": 4168, "verse_number": "६", "content_sanskrit": "दंष्ट्रिणो भीमवेगाश्च वायुवेगपराक्रमाः ।\nमायावीर्योपसम्पन्ना निवसन्त्यात्मरक्षिणः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146839, "chapter_id": 4168, "verse_number": "७", "content_sanskrit": "निवातकवचा नाम दानवा युद्धदुर्मदाः ।\nजानासि च यथा शक्रो नैतान् शक्नोति बाधितुम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146840, "chapter_id": 4168, "verse_number": "८", "content_sanskrit": "बहुशो मातले त्वं च तव पुत्रश्च गोमुखः ।\nनिर्भग्नो देवराजश्च सहपुत्रः शचीपतिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146841, "chapter_id": 4168, "verse_number": "९", "content_sanskrit": "पश्य वेश्मानि रौक्माणि मातले राजतानि च ।\nकर्मणा विधियुक्तेन युक्तान्युपगतानि च\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146842, "chapter_id": 4168, "verse_number": "१०", "content_sanskrit": "वैडूर्यहरितानीव प्रवाळरुचिराणि च ।\nअर्कस्फटिकशुभ्राणि वज्रसारोज्ज्वलानि च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146843, "chapter_id": 4168, "verse_number": "११", "content_sanskrit": "पार्थिवानीव चाभान्ति पद्मरागमयानि च ।\nशैलानीव च दृश्यन्ते तारकाणीव चाप्युत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146844, "chapter_id": 4168, "verse_number": "१२", "content_sanskrit": "सूर्यरूपाणि चाभान्ति दीप्ताग्निसदृशानि च ।\nमणिजालविचित्राणि प्रांशूनि विविधानि च\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146845, "chapter_id": 4168, "verse_number": "१३", "content_sanskrit": "नैतानि शक्यं निर्देष्टुं रूपतो द्रव्यतस्तथा ।\nगुणतश्चैव सिद्धानि प्रमाणगुणवन्ति च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146846, "chapter_id": 4168, "verse_number": "१४", "content_sanskrit": "आक्रीडान् पश्य दैत्यानां तथैव शयनान्युत ।\nरत्नवन्ति महार्हाणि भाजनान्यासनानि च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146847, "chapter_id": 4168, "verse_number": "१५", "content_sanskrit": "जलदाभांस्तथा शैलान् तोयप्रस्रवणान्वितान् ।\nकामपुष्पफलांश्चापि पादपान् कामचारिणः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146848, "chapter_id": 4168, "verse_number": "१६", "content_sanskrit": "मातले कश्चिदत्रापि रुचिरस्ते वरो भवेत् ।\nअथवाऽन्यां दिशं भूमेः गच्छाव यदि मन्यसे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146849, "chapter_id": 4168, "verse_number": "", "content_sanskrit": "कण्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146850, "chapter_id": 4168, "verse_number": "१७", "content_sanskrit": "मातलिस्त्वब्रवीदेनं भाषमाणं तथाविधम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146851, "chapter_id": 4168, "verse_number": "१८", "content_sanskrit": "देवर्षे नैव मे कार्यं विप्रियं त्रिदिवौकसाम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146852, "chapter_id": 4168, "verse_number": "१९", "content_sanskrit": "नित्यानुषक्तवैरा हि भ्रातरो देवदानवाः ।\nअरिपक्षेण सम्बन्धं रोचयिष्याम्यहं कथम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146853, "chapter_id": 4168, "verse_number": "२०", "content_sanskrit": "अन्यत्र साधु गच्छामो द्रष्टुं नार्हसि दानवान् ।\nजानामि तव चात्मानं इच्छसे कलहानिति\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146854, "chapter_id": 4168, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि एकोनशततमोऽध्यायः ॥९९॥\nभगवद्यानपर्वणि त्रिंशोऽध्यायः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]