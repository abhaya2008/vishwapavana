[{"id": 2023154, "chapter_id": 1495, "verse_number": "३-१३३-०x", "content_sanskrit": "श्येन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023155, "chapter_id": 1495, "verse_number": "३-१३३-१", "content_sanskrit": "धर्मात्मानं त्वाहुरेकं सर्वे राजन्महीक्षितः।\nस वै धर्मविरुद्धं त्वं कस्मात्कर्म चिकीर्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023156, "chapter_id": 1495, "verse_number": "३-१३३-२", "content_sanskrit": "विहितं भक्षणं राजन्पीड्यमानस्य मे क्षुधा।\nमाहिंसीर्धर्मलोभेन धर्ममुत्सृज्य मा नशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023157, "chapter_id": 1495, "verse_number": "३-१३३-३x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023158, "chapter_id": 1495, "verse_number": "३-१३३-३", "content_sanskrit": "संत्रस्तरूपस्त्राणार्थी त्वत्तो भीतो महाद्विज।\nमत्सकाशमनुप्रप्तः प्राणगृध्नुरयं द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023159, "chapter_id": 1495, "verse_number": "३-१३३-४", "content_sanskrit": "एवमभ्यागतस्येह कपोतस्याभयार्थिनः।\nअप्रदाने परो धर्मः किं त्वं श्येनेह पश्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023160, "chapter_id": 1495, "verse_number": "३-१३३-५", "content_sanskrit": "प्रस्पन्दमानः संभ्रान्तः कपोतः श्येन लक्ष्यते।\nमत्सकाशं जीवितार्थी तस्य त्यागो विगर्हितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023161, "chapter_id": 1495, "verse_number": "३-१३३-६", "content_sanskrit": "[यो हि कश्चिद्द्विजान्हन्याद्गां वा लोकस्य मातरम्।\nशरणागतं च त्यजते तुल्यं तेषां हि पातकम्]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023162, "chapter_id": 1495, "verse_number": "३-१३३-७x", "content_sanskrit": "श्येन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023163, "chapter_id": 1495, "verse_number": "३-१३३-७", "content_sanskrit": "आहारत्सर्वभूतानि संभवन्ति महीपते।\nआहारेण विवर्धन्ते तेन जीवन्ति जन्तवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023164, "chapter_id": 1495, "verse_number": "३-१३३-८", "content_sanskrit": "शक्यते दुस्त्यजेऽप्यर्थे चिररात्राय जीवितुम्।\nन तु भोजनमुत्सृज्य शक्यं वर्तयितुं चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023165, "chapter_id": 1495, "verse_number": "३-१३३-९", "content_sanskrit": "भक्ष्याद्विलोपितस्याद्य मम प्राणा विशांपते।\nविसृज्यकायमेष्यन्ति पन्थानमपुनर्भवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023166, "chapter_id": 1495, "verse_number": "३-१३३-१०", "content_sanskrit": "प्रमृते मयि धर्मात्मन्पुत्रदारादि नङ्क्ष्यति।\nरक्षमाणः कपोतं त्वं बहून्प्राणान्न रक्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023167, "chapter_id": 1495, "verse_number": "३-१३३-११", "content_sanskrit": "बहून्यो बाधते धर्मो न स धर्मः कुवर्त्म तत्।\nअविरोधी तु यो धर्मः स धर्मः सत्यविक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023168, "chapter_id": 1495, "verse_number": "३-१३३-१२", "content_sanskrit": "विरोधिषु महीपाल निश्चित्य गुरुलाघवम्।\nन बाधा विद्यते यत्र तं धर्मं समुपाचरेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023169, "chapter_id": 1495, "verse_number": "३-१३३-१३", "content_sanskrit": "गुरुलाघवमाज्ञाय धर्माधर्मविनिश्चये।\nयतो भूयांस्ततो राजन्कुरु धर्मविनिश्चयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023170, "chapter_id": 1495, "verse_number": "३-१३३-१४x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023171, "chapter_id": 1495, "verse_number": "३-१३३-१४", "content_sanskrit": "बहुकल्याणसंयुक्तं भाषसे विहगोत्तम।\nसुपर्णः पक्षिराट् किं त्वं धर्मं ज्ञात्वाऽभिभाषसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023172, "chapter_id": 1495, "verse_number": "३-१३३-१५", "content_sanskrit": "तथाहि धर्मसंयुक्तं बहुचित्रं च भाषसे।\nन तेऽस्त्यविदितं किंचिदिति त्वां लक्षयाम्यहम्।\nशरणैषिपरित्यागं कथं साध्विति मन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023173, "chapter_id": 1495, "verse_number": "३-१३३-१६", "content_sanskrit": "आहारार्थं समारम्भस्तव चायं विहंगम।\nशक्यश्चाप्यन्यथा कर्तुमाहारोऽप्यधिकस्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023174, "chapter_id": 1495, "verse_number": "३-१३३-१७", "content_sanskrit": "गोवृषो वा वराहो वा मृगो वा महिषोपि वा।\nत्वदर्थमद्य क्रियतां यच्चान्यदिह काङ्क्षसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023175, "chapter_id": 1495, "verse_number": "३-१३३-१८x", "content_sanskrit": "श्येन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023176, "chapter_id": 1495, "verse_number": "३-१३३-१८", "content_sanskrit": "न वराहं न चोक्षाणं न मृगान्विविधांस्तथा।\nभक्षयामि महाराज किं ममान्येन केचचित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023177, "chapter_id": 1495, "verse_number": "३-१३३-१९", "content_sanskrit": "यस्तु मे दैवविहितो भक्षः क्षत्रियपुङ्गव।\nतमुत्सृज महीपाल कपोतमिममेव मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023178, "chapter_id": 1495, "verse_number": "३-१३३-२०", "content_sanskrit": "श्येनाः कपोतान्स्वादन्ति श्रुतिरेषा सनातनी।\nमा राजन्सारमज्ञात्वा कदलीस्कन्धमासज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023179, "chapter_id": 1495, "verse_number": "३-१३३-२१x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023180, "chapter_id": 1495, "verse_number": "३-१३३-२१", "content_sanskrit": "राष्ट्रं शिवीनामृद्धं वै शाधि पक्षिभिरर्चितः।\nकृत्स्नमेतन्मया दत्तं राजवद्विहगोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023181, "chapter_id": 1495, "verse_number": "३-१३३-२२", "content_sanskrit": "यं वा कामयसे कामं श्येन सर्वं ददानि ते।\nविनेमं पक्षिणं श्यन शरणार्थिनमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023182, "chapter_id": 1495, "verse_number": "३-१३३-२३", "content_sanskrit": "येनेमं स्थापयेथास्त्वं कर्मणा पक्षिसत्तम।\nतदाचक्ष्व करिष्यामि न हि दास्ये कपोतकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2023183, "chapter_id": 1495, "verse_number": "३-१३३-२४x", "content_sanskrit": "श्येन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2023184, "chapter_id": 1495, "verse_number": "३-१३३-२४", "content_sanskrit": "उशीनर कपोते ते यदि स्नेहो नराधिप।\nआत्मनो मांसमुत्कृत्य कपोततुलया धृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2023185, "chapter_id": 1495, "verse_number": "३-१३३-२५", "content_sanskrit": "यदा समं कपोतेन तव मांसं नृपोत्तम।\nत्वया प्रदेयं तन्मह्यं सा मे तुष्टिर्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2023186, "chapter_id": 1495, "verse_number": "३-१३३-२६x", "content_sanskrit": "राजोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2023187, "chapter_id": 1495, "verse_number": "३-१३३-२६", "content_sanskrit": "अनुग्रहमिमं मन्ये श्येन यन्माभियाचसे।\nतस्मात्तेऽद्य प्रदास्यामि स्वमांसं तुलया धृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2023188, "chapter_id": 1495, "verse_number": "३-१३३-२७x", "content_sanskrit": "लेमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2023189, "chapter_id": 1495, "verse_number": "३-१३३-२७", "content_sanskrit": "अथोत्कृत्य स्वमांसं तु राजा परमधर्मवित्।\nतुलयामास कौन्तेय कपोतेन समं विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2023190, "chapter_id": 1495, "verse_number": "३-१३३-२८", "content_sanskrit": "ध्रियमाणः कपोतस्तु मांसेनात्यतिरिच्यते।\nपुनश्चोत्कृत्यमांसानि राजा प्रादादुशीनरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2023191, "chapter_id": 1495, "verse_number": "३-१३३-२९", "content_sanskrit": "न विद्यते यदा मांसं कपोतेन समं धृतम्।\nतत उत्कृत्तमांसोऽसावारुरोह स्वयं तुलाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2023192, "chapter_id": 1495, "verse_number": "३-१३३-३०x", "content_sanskrit": "श्येन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2023193, "chapter_id": 1495, "verse_number": "३-१३३-३०", "content_sanskrit": "इन्द्रोऽहमस्मि धर्मज्ञ कपोतो हव्यवाडयम्।\nजिज्ञासमानौ धर्म त्वां यज्ञवाटमुपागतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2023194, "chapter_id": 1495, "verse_number": "३-१३३-३१", "content_sanskrit": "यत्ते मांसानि गात्रेभ्य उक्तृत्तानि विशांपते।\nएषा ते शाश्वती कीर्तिर्लोकानभिभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2023195, "chapter_id": 1495, "verse_number": "३-१३३-३२", "content_sanskrit": "यावल्लोके मनुष्यास्त्वां कथयिष्यन्ति पार्थिव।\nतावत्कीर्तिश्च लोकाश्च स्थास्यन्ति तव शाश्वताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2023196, "chapter_id": 1495, "verse_number": "३-१३३-३३", "content_sanskrit": "इत्युक्त्वा भूमिपतये तस्मै दत्त्वा यथेप्सितम्।\nप्रशस्य जग्मतू राजन्निन्द्राग्री तुष्टमानसौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2023197, "chapter_id": 1495, "verse_number": "३-१३३-३४", "content_sanskrit": "उशीनरोऽपिधर्मात्मा धर्मेणावृत्यरोदसी।\nविभ्राजमानो वपुषाऽप्यारुरोह त्रिविष्टपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2023198, "chapter_id": 1495, "verse_number": "३-१३३-३५", "content_sanskrit": "तदेतत्सदनं राजन्राज्ञस्तस्य महात्मनः।\nपश्यस्वैतन्मया सार्धं पुण्यं पापप्रमोचनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2023199, "chapter_id": 1495, "verse_number": "३-१३३-३६", "content_sanskrit": "तत्र वै सततं देवा मुनयश्च सनातनाः।\nदृश्यन्ते ब्राह्मणै राजन्पुण्यवद्भिर्महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2023200, "chapter_id": 1495, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि त्रयस्त्रिंशदधिकशततमोऽध्यायः ॥ १३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]