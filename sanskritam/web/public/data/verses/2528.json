[{"id": 2072448, "chapter_id": 2528, "verse_number": "१२-३३-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072449, "chapter_id": 2528, "verse_number": "१२-३३-१", "content_sanskrit": "कानि कृत्वेह कर्माणि प्रायश्चित्तीयते नरः।\nकिं कृत्वा मुच्यते तत्र तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072450, "chapter_id": 2528, "verse_number": "१२-३३-२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072451, "chapter_id": 2528, "verse_number": "१२-३३-२", "content_sanskrit": "अकुर्वन्विहितं कर्म प्रतिषिद्धानि चाचरन्।\nप्रायश्चित्तीयते ह्येवं नरो मिथ्याऽनुवर्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072452, "chapter_id": 2528, "verse_number": "१२-३३-३", "content_sanskrit": "सूर्येणाभ्युदितो यश्च ब्रह्मचारी भवत्युत।\nतथा सूर्याभिनिर्मुक्तः कुनखी श्यावदन्नपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072453, "chapter_id": 2528, "verse_number": "१२-३३-४", "content_sanskrit": "परिवित्तिः परिवेत्ता ब्रह्मेज्यायाश्च दूषकः।\nदिधिषूपतिस्तथा यः स्यादग्रेदिधिषुरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072454, "chapter_id": 2528, "verse_number": "१२-३३-५", "content_sanskrit": "अवकीर्णी भवेद्यश्च द्विजातिवधकस्तथा।\nअतीर्थे ब्राह्मणस्त्यागी तीर्थे चाप्रतिपादकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072455, "chapter_id": 2528, "verse_number": "१२-३३-६", "content_sanskrit": "ग्रामयाजी च कौन्तेय मांसस्य परिविक्रयी।\nयश्चाग्नीनपविध्येत तथैव ब्रह्मविक्रयी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072456, "chapter_id": 2528, "verse_number": "१२-३३-७", "content_sanskrit": "शूद्रस्त्रीवधको यश्च पूर्वः पूर्वस्तु गर्हितः।\nवृथा पशुसमालम्भी वनदाहस्य कारकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072457, "chapter_id": 2528, "verse_number": "१२-३३-८", "content_sanskrit": "अनृतेनोपवर्ती च प्रतिषेद्धा गुरोस्तथा।\n`स्वदत्तस्यापहर्ता च परदत्तनिरोधकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072458, "chapter_id": 2528, "verse_number": "१२-३३-९", "content_sanskrit": "वाग्दत्तं च मनोदत्तं धारादत्तं च यो हरेत्।\nपाकभेदेन भोक्ता च भुञ्जानस्याप्यनादरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072459, "chapter_id": 2528, "verse_number": "१२-३३-१०", "content_sanskrit": "स्वजनैः कलहं चैव आश्रितानामरक्षणम्।\nएतान्येनांसि सर्वाणि व्युत्क्रान्तसमयश्च यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072460, "chapter_id": 2528, "verse_number": "१२-३३-११", "content_sanskrit": "अकार्याणि तु वक्ष्यामि यानि तानि निबोध मे।\nलोकवेदविरुद्धानि तान्येकाग्रमनाः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072461, "chapter_id": 2528, "verse_number": "१२-३३-१२", "content_sanskrit": "स्वधर्मस्य परित्यागः परधर्मस्य च क्रिया।\nअयाज्ययाजनं चैव तथाऽभक्ष्यस्य भक्षणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072462, "chapter_id": 2528, "verse_number": "१२-३३-१३", "content_sanskrit": "शरणागतसंत्यागो भृत्यस्याभरणं तथा।\nरसानां विक्रयश्चापि तिर्यग्योनिवधस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072463, "chapter_id": 2528, "verse_number": "१२-३३-१४", "content_sanskrit": "आधानादीनि कर्माणि शक्तिमान्न करोति यः।\nअप्रयच्छंश्च सर्वाणि नित्यदेयानि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072464, "chapter_id": 2528, "verse_number": "१२-३३-१५", "content_sanskrit": "दक्षिणानामदानं च ब्राह्मणस्वाभिमर्शनम्।\nसर्वाण्येतान्यकार्याणि प्राहुर्धर्मविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072465, "chapter_id": 2528, "verse_number": "१२-३३-१६", "content_sanskrit": "पित्रा विवदते पुत्रो यश्च स्याद्गुरुतल्पगः।\nअप्रजायन्नरव्याघ्र भवत्यधार्मिको नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072466, "chapter_id": 2528, "verse_number": "१२-३३-१७", "content_sanskrit": "उक्तान्येतानि कर्माणि विस्तरेणेतरेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072467, "chapter_id": 2528, "verse_number": "१२-३३-१८", "content_sanskrit": "यानि कुर्वन्निकुर्वंश्च प्रायश्चित्तीयते नरः।\nएतान्येव तु कर्माणि क्रियमाणानि मानवैः।\nयेषुयेषु निमित्तेषु न लिप्यन्तेऽथ ताञ्शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072468, "chapter_id": 2528, "verse_number": "१२-३३-१९", "content_sanskrit": "प्रगृह्य शस्त्रमायान्तमपि वेदान्तगं रणे।\nजिघांसन्तं जिघांसीयान्न तेन ब्रह्महा भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072469, "chapter_id": 2528, "verse_number": "१२-३३-२०", "content_sanskrit": "इति चाप्यत्र कौन्तेय मन्त्रो वेदेषु पठ्यते।\nवेदप्रमाणविहितं धर्मं च प्रब्रवीमि ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072470, "chapter_id": 2528, "verse_number": "१२-३३-२१", "content_sanskrit": "अपेतं ब्राह्मणं वृत्ताद्यो हन्यादाततायिनम्।\nन तेन ब्रह्महा स स्यान्मन्युस्तन्मन्युमृच्छति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072471, "chapter_id": 2528, "verse_number": "१२-३३-२२", "content_sanskrit": "प्राणात्यये तथा ज्ञानादाचरन्मदिरामपि।\nआदेशितो धर्मपरैः पुनः संस्कारमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072472, "chapter_id": 2528, "verse_number": "१२-३३-२३", "content_sanskrit": "एतत्ते सर्वमाख्यातं कौन्तेयाभक्ष्यभक्षणम्।\nप्रायश्चित्तविधानेन सर्वमेतेन शुद्ध्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072473, "chapter_id": 2528, "verse_number": "१२-३३-२४", "content_sanskrit": "गुरुतल्पं हि गुर्वर्थं न दूषयति मानवम्।\nउद्दालकः श्वेतकेतुं जनयामास शिष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2072474, "chapter_id": 2528, "verse_number": "१२-३३-२५", "content_sanskrit": "स्तेयं कुर्वंश्च गुर्वर्थमापत्सु न निषिध्यते।\nबहुशः कामकारेण न चेद्यः संप्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2072475, "chapter_id": 2528, "verse_number": "१२-३३-२६", "content_sanskrit": "अन्यत्र ब्राह्मणस्वेभ्य आददानो न दुष्यति।\nस्वयमप्राशिता यश्च न स पापेन लिप्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2072476, "chapter_id": 2528, "verse_number": "१२-३३-२७", "content_sanskrit": "प्राणत्राणेऽनृतं वाच्यमात्मनो वा परस्य च।\nगुर्वर्थे स्त्रीषु चैव स्याद्विवाहकरणेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2072477, "chapter_id": 2528, "verse_number": "१२-३३-२८", "content_sanskrit": "नावर्तते व्रतं स्वप्ने शुक्रमोक्षे कथंचन।\nआज्यहोमः समिद्धेऽग्नौ प्रायश्चित्तं विधीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2072478, "chapter_id": 2528, "verse_number": "१२-३३-२९", "content_sanskrit": "पारिवित्त्यं तु पतिते नास्ति प्रव्रजिते तथा।\nभिक्षिते पारदार्यं च तद्धर्मस्य न दूषकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2072479, "chapter_id": 2528, "verse_number": "१२-३३-३०", "content_sanskrit": "वृथा पशुसमालम्भं नैव कुर्यान्न कारयेत्।\nभ्रनुग्रहः पशूनां हि संस्कारो विधिनोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2072480, "chapter_id": 2528, "verse_number": "१२-३३-३१", "content_sanskrit": "अनर्हे ब्राह्मणे दत्तमज्ञानात्तन्न दूषकम्।\nसत्काराणां तथा तीर्थे नित्यं वा प्रतिपादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2072481, "chapter_id": 2528, "verse_number": "१२-३३-३२", "content_sanskrit": "स्त्रियास्तथापचारिण्या निष्कृतिः स्याददूषिका।\nअपि सा पूयते तेन न तु भर्ता प्रदुष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2072482, "chapter_id": 2528, "verse_number": "१२-३३-३३", "content_sanskrit": "तत्त्वं ज्ञात्वा तु सोमस्य विक्रयः स्याददोषवान्।\nअसमर्थस्य भृत्यस्य विसर्गः स्याददोषवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2072483, "chapter_id": 2528, "verse_number": "१२-३३-३४", "content_sanskrit": "वनदाहो गवामर्थे क्रियमाणो न दूषकः।\nउक्तान्येतानि कर्माणि यानि कुर्वन्न दुष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2072484, "chapter_id": 2528, "verse_number": "१२-३३-३५", "content_sanskrit": "प्रायश्चित्तानि वक्ष्यामि विस्तरेणैव भारत।\n`यानि कृत्वा नरः पूतो भविष्यति नराधिप॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2072485, "chapter_id": 2528, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि त्रयस्त्रिंशोऽध्यायः॥ ३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]