[{"id": 900003178, "chapter_id": 8278, "verse_number": "12.1", "content_sanskrit": "एवं सततयुक्ता ये भक्तास्त्वां पर्युपासते । ये चाप्यक्षरमव्यक्तं तेषां के योगवित्तमाः ।। १ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900003179, "chapter_id": 8278, "verse_number": "12.2", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900003180, "chapter_id": 8278, "verse_number": "12.3", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900003181, "chapter_id": 8278, "verse_number": "12.4", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900003182, "chapter_id": 8278, "verse_number": "12.5", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900003183, "chapter_id": 8278, "verse_number": "12.6", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900003184, "chapter_id": 8278, "verse_number": "12.7", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900003185, "chapter_id": 8278, "verse_number": "12.8", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900003186, "chapter_id": 8278, "verse_number": "12.9", "content_sanskrit": "मय्यावेश्य मनो ये मां नित्ययुक्ता उपासते । श्रद्धया परयोपेतास्ते मे युक्ततमा मताः ।। २ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900003187, "chapter_id": 8278, "verse_number": "12.10", "content_sanskrit": "ये त्वक्षरमनिर्देश्यमव्यक्तं पर्युपासते । सर्वत्रगमचिन्त्यं च कूटस्थमचलं ध्रुवम् ।। ३ ।। संनियम्येन्द्रियग्रामं सर्वत्र समबुद्धयः । ते प्राप्नुवन्ति मामेव सर्वभूतहिते रताः ।। ४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900003188, "chapter_id": 8278, "verse_number": "12.11", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900003189, "chapter_id": 8278, "verse_number": "12.12", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900003190, "chapter_id": 8278, "verse_number": "12.13", "content_sanskrit": "क्लेशोऽधिकतरस्तेषामव्यक्तासक्तचेतसाम् । अव्यक्ता हि गतिर्दुःखं देहवद्भिरवाप्यते ।। ५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900003191, "chapter_id": 8278, "verse_number": "12.14", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900003192, "chapter_id": 8278, "verse_number": "12.15", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 900003193, "chapter_id": 8278, "verse_number": "12.16", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 900003194, "chapter_id": 8278, "verse_number": "12.17", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 900003195, "chapter_id": 8278, "verse_number": "12.18", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 900003196, "chapter_id": 8278, "verse_number": "12.19", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 900003197, "chapter_id": 8278, "verse_number": "12.20", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 900003198, "chapter_id": 8278, "verse_number": "12.21", "content_sanskrit": "ये तु सर्वाणि कर्माणि मयि सन्न्यस्य मत्पराः । अनन्येनैव योगेन मां ध्यायन्त उपासते ।। ६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 900003199, "chapter_id": 8278, "verse_number": "12.22", "content_sanskrit": "तेषामहं समुद्धर्ता मृत्युसंसारसागरात् । भवामि न चिरात्पार्थ मय्यावेशितचेतसाम् ।। ७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 900003200, "chapter_id": 8278, "verse_number": "12.23", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 900003201, "chapter_id": 8278, "verse_number": "12.24", "content_sanskrit": "मय्येव मन आधत्स्व मयि बुद्धिं निवेशय । निवसिष्यसि मय्येव अत ऊर्ध्वं न संशयः ।। ८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 900003202, "chapter_id": 8278, "verse_number": "12.25", "content_sanskrit": "अथ चित्तं समाधातुं न शक्नोषि मयि स्थिरम् । अभ्यासयोगेन ततो मामिच्छाप्तुं धनञ्जय ।। ९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 900003203, "chapter_id": 8278, "verse_number": "12.26", "content_sanskrit": "अभ्यासेऽप्यसमर्थोऽसि मत्कर्मपरमो भव । मदर्थमपि कर्माणि कुर्वन् सिद्धिमवाप्स्यसि ।। १० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 900003204, "chapter_id": 8278, "verse_number": "12.27", "content_sanskrit": "अथैदप्यशक्तोऽसि कर्तुं मद्योगमाश्रितः । सर्वकर्मफलत्यागं ततः कुरु यतात्मवान् ।। ११ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 900003205, "chapter_id": 8278, "verse_number": "12.28", "content_sanskrit": "श्रेयो हि ज्ञानमभ्यासात् ज्ञानाद् ध्यानं विशिष्यते । ध्यानात् कर्मफलत्यागस्त्यागाच्छान्तिरनन्तरम् ।। १२ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 900003206, "chapter_id": 8278, "verse_number": "12.29", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 900003207, "chapter_id": 8278, "verse_number": "12.30", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 900003208, "chapter_id": 8278, "verse_number": "12.31", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 900003209, "chapter_id": 8278, "verse_number": "12.32", "content_sanskrit": "ओष्टा सर्वभूतानां मैत्रः करुण एव च । निर्ममो निरहङ्कारः समदुःखसुखः क्षमी ।। १३ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 900003210, "chapter_id": 8278, "verse_number": "12.33", "content_sanskrit": "सन्तुष्टः सततं योगी यतात्मा दृढनिश्चयः । मय्यर्पितमनोबुद्धिर्यो मद्भक्तः स मे प्रियः ।। १४ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 900003211, "chapter_id": 8278, "verse_number": "12.34", "content_sanskrit": "यस्मान्नोद्विजते लोको लोकान्नोद्विजते च यः । हर्षमर्षभयोद्वेगैर्मुक्तो य स च मे प्रियः ।। १५ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 900003212, "chapter_id": 8278, "verse_number": "12.35", "content_sanskrit": "अनपेक्षः शुचिर्दक्ष उदासीनो गतव्यथः । सर्वारम्भपरित्यागी यो मद्भक्तः स मे प्रियः ।। १६ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 900003213, "chapter_id": 8278, "verse_number": "12.36", "content_sanskrit": "यो न हृष्यति न द्वेष्टि न शोचति न काङ्क्षति । शुभाशुभपरित्यागी भक्तिमान् यः स मे प्रियः ।। १७ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 900003214, "chapter_id": 8278, "verse_number": "12.37", "content_sanskrit": "भाष्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 900003215, "chapter_id": 8278, "verse_number": "12.38", "content_sanskrit": "समः शत्रौ च मित्रे च तथा मानापमानयोः । शीतोष्णसुखदुःखेषु समः सङ्गविवर्जितः ।। १८ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 900003216, "chapter_id": 8278, "verse_number": "12.39", "content_sanskrit": "तुल्यनिन्दास्तुतिर्मौनी सन्तुष्टो येन केनचित् । अनिकेतः स्थिरमतिर्भक्तिमान् मे प्रियो नरः ।। १९ ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 900003217, "chapter_id": 8278, "verse_number": "12.40", "content_sanskrit": "ये तु धर्म्यामृतमिदं यथोक्तं पर्युपासते । श्रद्दधाना मत्परमा भक्तास्तेऽतीव मे प्रियाः ।। २० ।।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}]