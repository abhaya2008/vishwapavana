[{"id": 7002997000, "chapter_id": 22997, "verse_number": "२-४४-१", "content_sanskrit": "नारायण उवाच ।\nकथितं षष्ठ्युपाख्यानं ब्रह्मपुत्र यथागमम् ।\nदेवी मङ्गलचण्डी च तदाख्यानं निशामय ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002997001, "chapter_id": 22997, "verse_number": "२-४४-२", "content_sanskrit": "तस्याः पूजादिकं सर्वं धर्मवक्त्राच्च यच्छ्रुतम् ।\nश्रुतिसम्मतमेवेष्टं सर्वेषां विदुषामपि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002997002, "chapter_id": 22997, "verse_number": "२-४४-३", "content_sanskrit": "चण्डायां वर्त्तते चण्डी जाग्रती शत्रुमण्डले ।\nमङ्गलेषु च या दक्षा मङ्गला सैव चण्डिका ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002997003, "chapter_id": 22997, "verse_number": "२-४४-४", "content_sanskrit": "दुर्गायां विद्यते चण्डी मङ्गलोऽपि महीसुते ।\nमङ्गलाऽभीष्टदेवी या सा स्यान्मङ्गलचण्डिका ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002997004, "chapter_id": 22997, "verse_number": "२-४४-५", "content_sanskrit": "मंगलो मनुवंशश्च सप्तद्वीपावनीपतिः ।\nतस्य पूज्याऽभीष्टदेवी तेन मंगलचण्डिका ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002997005, "chapter_id": 22997, "verse_number": "२-४४-६", "content_sanskrit": "मूर्त्तिभेदेन सा दुर्गा मूलप्रकृतिरीश्वरी ।\nकृपारूपाऽतिप्रत्यक्षा योषितामिष्टदेवता ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002997006, "chapter_id": 22997, "verse_number": "२-४४-७", "content_sanskrit": "प्रथमे पूजिता सा च शङ्करेण पुरा परा ।\nत्रिपुरस्य वधे घोरं विष्णुना प्रेरितेन च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002997007, "chapter_id": 22997, "verse_number": "२-४४-८", "content_sanskrit": "ब्रह्मन्ब्रह्मोपदेशेन दुर्गप्रस्थे च सङ्कटे ।\nआकाशात्पतिते याने रुषा दैत्येन पातिते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002997008, "chapter_id": 22997, "verse_number": "२-४४-९", "content_sanskrit": "ब्रह्मविष्णूपदिष्टश्च दुर्गां तुष्टाव शङ्करः ।\nसा च मंगलचण्डीयमभवद्रूपभेदतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002997009, "chapter_id": 22997, "verse_number": "२-४४-१०", "content_sanskrit": "उवाच पुरतः शम्भोर्भयं नास्तीति ते प्रभो ।\nभगवान्वृषरूपश्च सर्वेशश्च बभूव ह ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002997010, "chapter_id": 22997, "verse_number": "२-४४-११", "content_sanskrit": "युद्धशक्तिस्वरूपाऽहं भविष्यामि तदाज्ञया ।\nमयाऽऽत्मना च हरिणा सहायेन वृषध्वज ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002997011, "chapter_id": 22997, "verse_number": "२-४४-१२", "content_sanskrit": "जहि दैत्यं च देवेश सुराणां पदघातकम् ।\nइत्युक्त्वाऽन्तर्हिता देवी शम्भोः शक्तिर्बभूव सा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002997012, "chapter_id": 22997, "verse_number": "२-४४-१३", "content_sanskrit": "विष्णुदत्तेन शस्त्रेण जघान तमुमापतिः ।\nमुनीन्द्र पतिते दैत्ये सर्वे देवा महर्षयः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002997013, "chapter_id": 22997, "verse_number": "२-४४-१४", "content_sanskrit": "तुष्टुवुः शंकरं देवा भक्तिनम्रात्मकन्धराः ।\nसद्यः शिरसि शम्भोश्च पुष्पवृष्टिर्बभूव ह ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002997014, "chapter_id": 22997, "verse_number": "२-४४-१५", "content_sanskrit": "ब्रह्मा विष्णुश्च सन्तुष्टो ददौ तस्मै शुभाशिषम् ।\nब्रह्मविष्णूपदिष्टश्च सुस्नातः शङ्करः शुचिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002997015, "chapter_id": 22997, "verse_number": "२-४४-१६", "content_sanskrit": "पूजयामास तां शक्तिं देवीं मङ्गलचण्डिकाम् ।\nपाद्यार्घ्याचमनीयैश्च बलिभिर्विविधैरपि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002997016, "chapter_id": 22997, "verse_number": "२-४४-१७", "content_sanskrit": "पुष्पचन्दननैवेद्यैर्भक्त्या नानाविधैर्मुने ।\nछागैर्मेषैश्च महिषैर्गण्डैर्मायाविभिर्वरैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002997017, "chapter_id": 22997, "verse_number": "२-४४-१८", "content_sanskrit": "वस्त्रालङ्कारमाल्यैश्च पायसैः पिष्टकैरपि ।\nमधुभिश्च सुधाभिश्च पक्वैर्नानाविधैः फलैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002997018, "chapter_id": 22997, "verse_number": "२-४४-१९", "content_sanskrit": "सङ्गीतैर्नर्त्तनैर्वाद्यैरुत्सवैः कृष्णकीर्त्तनैः ।\nध्यात्वा माध्यन्दिनोक्तेन ध्यानेन विधिपूर्वकम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002997019, "chapter_id": 22997, "verse_number": "२-४४-२०", "content_sanskrit": "ददौ द्रव्याणि मूलेन मन्त्रेणैव च नारद ।\nॐ  ह्रीं श्रीं क्लीं सर्वपूज्ये देवि मङ्गलचण्डिके ।\nऐं क्रूं फट्स्वाहेत्येवं चाप्येकविंशाक्षरो मनुः॥ ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002997020, "chapter_id": 22997, "verse_number": "२-४४-२१", "content_sanskrit": "पूज्यः कल्पतरुश्चैव भक्तानां सर्वकामदः ।\nदशलक्षजपेनैव मन्त्रसिद्धिर्भवेन्नृणाम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002997021, "chapter_id": 22997, "verse_number": "२-४४-२२", "content_sanskrit": "मन्त्रसिद्धिर्भवेद्यस्य स विष्णुः सर्वकामदः ।\nध्यानं च श्रूयतां ब्रह्मन्वेदोक्तं सर्वसम्मतम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002997022, "chapter_id": 22997, "verse_number": "२-४४-२३", "content_sanskrit": "देवीं षोडशवर्षीयां रम्यां सुस्थिरयौवनाम् ।\nसर्वरूपगुणाढ्यां च कोमलांगीं मनोहराम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002997023, "chapter_id": 22997, "verse_number": "२-४४-२४", "content_sanskrit": "श्वेतचम्पकवर्णाभां चन्द्रकोटिसमप्रभाम् ।\nवह्निशुद्धांशुकाधानां रत्नभूषणभूषिताम्॥ ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002997024, "chapter_id": 22997, "verse_number": "२-४४-२५", "content_sanskrit": "बिभ्रतीं कबरीभारं मल्लिकामाल्यभूषितम् ।\nबिम्बोष्ठीं सुदतीं शुद्धां शरत्पद्मनिभाननाम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002997025, "chapter_id": 22997, "verse_number": "२-४४-२६", "content_sanskrit": "ईषद्धास्यप्रसन्नास्यां सुनीलोत्पललोचनाम् ।\nजगद्धात्रीं च दात्रीं च सर्वेभ्यः सर्वसम्पदाम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002997026, "chapter_id": 22997, "verse_number": "२-४४-२७", "content_sanskrit": "संसारसागरे घोरे पोतरूपां वरां भजे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002997027, "chapter_id": 22997, "verse_number": "२-४४-२८", "content_sanskrit": "देव्याश्च ध्यानमित्येवं स्तवनं श्रूयतां मुने ।\nप्रयतः सङ्कटग्रस्तो येन तुष्टाव शङ्करः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002997028, "chapter_id": 22997, "verse_number": "२-४४-२९", "content_sanskrit": "शङ्कर उवाच ।\nरक्ष रक्ष जगन्मातर्देवि मंगलचण्डिके ।\nसंहर्त्रि विपदां राशेर्हर्षमंगलकारिके ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002997029, "chapter_id": 22997, "verse_number": "२-४४-३०", "content_sanskrit": "हर्षमंगलदक्षे च हर्षमंगलचण्डिके ।\nशुभे मंगलदक्षे च शुभमंगल चण्डिके ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002997030, "chapter_id": 22997, "verse_number": "२-४४-३१", "content_sanskrit": "मंगले मङ्गलार्हे च सर्वमंगलमंगले ।\nसतां मंगलदे देवि सर्वेषां मंगलालये ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002997031, "chapter_id": 22997, "verse_number": "२-४४-३२", "content_sanskrit": "पूज्या मंगलवारे च मंगलाभीष्टदैवते ।\nपूज्ये मंगलभूपस्य मनुवंशस्य सन्ततम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002997032, "chapter_id": 22997, "verse_number": "२-४४-३३", "content_sanskrit": "मंगलाधिष्ठातृदेवि मंगलानां च मंगले ।\nसंसारे मंगलाधारे मोक्षमंगलदायिनि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002997033, "chapter_id": 22997, "verse_number": "२-४४-३४", "content_sanskrit": "सारे च मंगलाधारे पारे त्वं सर्वकर्मणाम् ।\nप्रतिमंगलवारं च पूज्ये त्वं मंगलप्रदे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002997034, "chapter_id": 22997, "verse_number": "२-४४-३५", "content_sanskrit": "स्तोत्रेणानेन शम्भुश्च स्तुत्वा मगलचण्डिकाम् ।\nप्रतिमंगलवारे च पूजां कृत्वा गतः शिवः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002997035, "chapter_id": 22997, "verse_number": "२-४४-३६", "content_sanskrit": "देव्याश्च मंगलस्तोत्रं यः शृणोति समाहितः ।\nतन्मंगलं भवेच्छश्वन्न भवेत्तदमंगलम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002997036, "chapter_id": 22997, "verse_number": "२-४४-३७", "content_sanskrit": "प्रथमे पूजिता देवी शम्भुना सर्वमंगला ।\nद्वितीये पूजिता देवी मंगलेन ग्रहेण च ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002997037, "chapter_id": 22997, "verse_number": "२-४४-३८", "content_sanskrit": "तृतीये पूजिता भद्रा मंगलेन नृपेण च ।\nचतुर्थे मंगले वारे सुन्दरीभिश्च पूजिता ।\nपञ्चमे मङ्गलाकांक्षैर्नरैर्मंगलचण्डिका ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002997038, "chapter_id": 22997, "verse_number": "२-४४-३९", "content_sanskrit": "पूजिता प्रतिविश्वेषु विश्वेशैः पूजिता सदा ।\nततः सर्वत्र संपूज्य सा बभूव सुरेश्वरी ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002997039, "chapter_id": 22997, "verse_number": "२-४४-४०", "content_sanskrit": "देवादिभिश्च मुनिभिर्मनुभिर्मानवैर्मुने ।\nदेव्याश्च मङ्गलस्तोत्रं यः शृणोति समाहितः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002997040, "chapter_id": 22997, "verse_number": "२-४४-४१", "content_sanskrit": "तन्मंगलं भवेच्छश्वन्न भवेत्तदमंगलम् ।\nवर्द्धन्ते तत्पुत्रपौत्रा मंगलं च दिने दिने ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]