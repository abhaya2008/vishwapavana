[{"id": 2114848, "chapter_id": 3470, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2114849, "chapter_id": 3470, "verse_number": "१", "content_sanskrit": "एतस्मिन्नेव काले तु यथासम्प्रत्ययं कविः ।\nविदुरः प्रेषयामास तद्वनं पुरुषं शुचिम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2114850, "chapter_id": 3470, "verse_number": "२", "content_sanskrit": "स गत्वा तु यथोद्देशं वने प्रैक्षत पाण्डवान् ।\nसह मात्रा नरव्याघ्राननयज्जाह्नवीं ततः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2114851, "chapter_id": 3470, "verse_number": "३", "content_sanskrit": "विदितं तन्महाबुद्धेर्विदुरस्य महात्मनः ।\nतत्रस्थस्यापि चारेण पापानां वै चिकीर्षितम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2114852, "chapter_id": 3470, "verse_number": "४", "content_sanskrit": "ततो धर्मविदा तेन प्रहितः पुरुषः शिवः ।\nसर्ववातसहां नावं युक्तां चित्रपताकिनीम् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2114853, "chapter_id": 3470, "verse_number": "५", "content_sanskrit": "शिवे भागीरथीतीरे विश्वास्यैरनुगैर्वृताम् ।\nपाण्डवान् दर्शयामास वचनं चेदमब्रवीत् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2114854, "chapter_id": 3470, "verse_number": "६", "content_sanskrit": "कक्षघ्नं शिशिरघ्नं च महाकुक्षि बलौजसम् ।\nबोद्धव्यमिति यत् प्राह विदुरस्तदिदं तथा \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2114855, "chapter_id": 3470, "verse_number": "७", "content_sanskrit": "तेन मां प्रेषितं विद्धि विश्वासजननाय वै ।\nभूयश्च स्माह वः क्षत्ता विदुरः सर्वधर्मवित् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2114856, "chapter_id": 3470, "verse_number": "८", "content_sanskrit": "अधिक्षिपन् धार्तराष्ट्रं सभ्रातृकमुदारधीः ।\nकर्णं च दुर्मतिं क्रूरं शकुनिं चापि सौबलम् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2114857, "chapter_id": 3470, "verse_number": "९", "content_sanskrit": "दुर्योधनः कुलस्यास्य कीर्तिधर्मप्रणाशकः ।\nगान्धारराजसहितः पितरं पातयिष्यति \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2114858, "chapter_id": 3470, "verse_number": "१०", "content_sanskrit": "राजा चाप्यपरिज्ञानस्नेहबद्धो दुरात्मवान् ।\nधृतराष्ट्रः परीतात्मा धर्मं त्यजति शाश्वतम् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2114859, "chapter_id": 3470, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2114860, "chapter_id": 3470, "verse_number": "११", "content_sanskrit": "पाण्डवाश्चापि गत्वाऽथ गङ्गायास्तीरमुत्तरम् ।\nनिषादाधिपतिं वीरं दाशं परमधार्मिकम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2114861, "chapter_id": 3470, "verse_number": "१२", "content_sanskrit": "दीपिकाभिः कृतालोकं मार्गमाणं च पाण्डवान् ।\nददृशुः पाण्डवेयास्ते नाविकं त्वरयाऽन्वितम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2114862, "chapter_id": 3470, "verse_number": "१३", "content_sanskrit": "निषादस्तत्र कौन्तेयानभिज्ञानं न्यवेदयत् ।\nविदुरस्य महाबुद्धेर्म्लेच्छभाषादि यत् तदा \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2114863, "chapter_id": 3470, "verse_number": "", "content_sanskrit": "नाविकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2114864, "chapter_id": 3470, "verse_number": "१४", "content_sanskrit": "विदुरेणापि सन्दिष्टो दत्वा बहु धनं महत् ।\nगङ्गातीरे निविष्टस्त्वं पाण्डवान् तारयेस्त्विति \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2114865, "chapter_id": 3470, "verse_number": "१५", "content_sanskrit": "सोऽहं चतुर्दशीमद्य गङ्गाया नविदूरतः ।\nचारैरन्वेषयाम्यस्मिन् वने मृगगणान्विते \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2114866, "chapter_id": 3470, "verse_number": "१६", "content_sanskrit": "प्रभवन्तोऽत्र भद्रं वो नावमारुह्य गम्यताम् ।\nयुक्तारित्रपताकां वै निश्छिद्रां मन्दिरोपमाम् \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2114867, "chapter_id": 3470, "verse_number": "१७", "content_sanskrit": "इयं वारिपथे युक्ता नौरस्तु सुखगामिनी ।\nमोचयिष्यति वः सर्वान् मृत्युपाशात् समातृकान् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2114868, "chapter_id": 3470, "verse_number": "१८", "content_sanskrit": "ततस्तान् व्यथितान् सर्वान् सह मात्रा परन्तपान् ।\nनावमारोप्य गङ्गायां प्रयातान् पुनरब्रवीत् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2114869, "chapter_id": 3470, "verse_number": "१९", "content_sanskrit": "विदुरो मूर्ध्न्युपाघ्राय परिष्वज्य वचो मुहुः ।\nअरिष्टं गच्छताव्यग्राः पन्थानमिति चाब्रवीत् \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2114870, "chapter_id": 3470, "verse_number": "२०", "content_sanskrit": "इत्युक्ता सह मात्रा ते तस्मान्मुक्ता महाभयात् ।\nगङ्गामुत्तीर्य कौन्तेया वनं जग्मुर्यथासुखम् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2114871, "chapter_id": 3470, "verse_number": "१४९", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nएकोनपञ्चाशदधिकशततमोऽध्यायः ॥१४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2114872, "chapter_id": 3470, "verse_number": "७", "content_sanskrit": "॥ इति जतुगृहदाहपर्वणि सप्तमोऽध्यायः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2114873, "chapter_id": 3470, "verse_number": "", "content_sanskrit": "—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]