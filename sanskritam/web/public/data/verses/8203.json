[{"id": 900001014, "chapter_id": 8203, "verse_number": "2.1", "content_sanskrit": "आनन्दमजरं नित्यमजमक्षयमच्युतम् । अनन्तशक्तिं सर्वज्ञं नमस्ये पुरुषोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001015, "chapter_id": 8203, "verse_number": "2.2", "content_sanskrit": "ब्रह्मा देवानां प्रथमः सम्बभूव विश्वस्य कर्ता भुवनस्य गोप्ता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001016, "chapter_id": 8203, "verse_number": "2.3", "content_sanskrit": "अथर्वणे यां प्रवदेत ब्रह्माथर्वा..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001017, "chapter_id": 8203, "verse_number": "2.4", "content_sanskrit": "तस्मै शौनको ह वै महाशालोऽङ्गिरसं ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001018, "chapter_id": 8203, "verse_number": "2.5", "content_sanskrit": "'ऋग्भिर्होत्रेण शंसन्ति तथैौद्गात्रैः स्तुवन्ति ये", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001019, "chapter_id": 8203, "verse_number": "2.6", "content_sanskrit": "वेदे रामायणे चैव पुराणे भारते तथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001020, "chapter_id": 8203, "verse_number": "2.7", "content_sanskrit": "पञ्चरात्रमृगाद्याश्च सर्वमेकं पुराऽभवत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900001021, "chapter_id": 8203, "verse_number": "2.8", "content_sanskrit": "तस्माद् ब्रह्मादयः सर्वे मनवो मानवास्तथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900001022, "chapter_id": 8203, "verse_number": "2.9", "content_sanskrit": "तदेतत्सत्यम् मन्त्रेषु कर्माणि कवयो यान्यपश्यन्..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900001023, "chapter_id": 8203, "verse_number": "2.10", "content_sanskrit": "यत्तदद्रेश्यमग्राह्यमगोत्रमवर्णमचक्षुः..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900001024, "chapter_id": 8203, "verse_number": "2.11", "content_sanskrit": "यथोर्णनाभिः सृजते गृह्णते ..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900001025, "chapter_id": 8203, "verse_number": "2.12", "content_sanskrit": "तपसा चीयते ब्रह्म ततोऽन्नमभिजायते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900001026, "chapter_id": 8203, "verse_number": "2.13", "content_sanskrit": "यः सर्वज्ञः सर्वविद् यस्य ज्ञानमयं तपः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]