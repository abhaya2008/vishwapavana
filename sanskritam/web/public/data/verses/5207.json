[{"id": 2198007, "chapter_id": 5207, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2198008, "chapter_id": 5207, "verse_number": "१", "content_sanskrit": "प्रज्ञाश्रुताभ्यां वृत्तेन शीलेन च यथा भवान् ।\nगुणैः समुदितः सर्वैर्वयसा च समन्वितः ।\nतस्माद् भवन्तं पृच्छामि धर्मं धर्मभृतांवर\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2198009, "chapter_id": 5207, "verse_number": "२", "content_sanskrit": "क्षत्रियो यदि वा वैश्यः शूद्रो वा राजसत्तम ।\nब्राह्मण्यं प्राप्नुयात् केन तन्मे व्याख्यातुमर्हसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2198010, "chapter_id": 5207, "verse_number": "३", "content_sanskrit": "तपसा वा सुमहता कर्मणा वा श्रुतेन वा ।\nब्राह्मण्यमथ चेदिच्छेत् तन्मे ब्रूहि पितामह\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2198011, "chapter_id": 5207, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2198012, "chapter_id": 5207, "verse_number": "४", "content_sanskrit": "ब्राह्मण्यं तात दुष्प्रापं वर्णैः क्षत्रादिभिस्त्रिभिः ।\nपरं हि सर्वभूतानां स्थानमेतद् युधिष्ठिर\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2198013, "chapter_id": 5207, "verse_number": "५", "content_sanskrit": "बह्वीस्तु संसरन् योनीर्जायमानः पुनः पुनः ।\nपर्याये तात कस्मिंश्चिद् ब्राह्मणो नाम जायते\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2198014, "chapter_id": 5207, "verse_number": "६", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nमतङ्गस्य च संवादं गर्दभ्याश्च युधिष्ठिर\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2198015, "chapter_id": 5207, "verse_number": "७", "content_sanskrit": "द्विजातेः कस्यचित् तात तुल्यवर्णः सुतः प्रभुः ।\nमतङ्गो नाम नाम्नाऽभूत् सर्वैः समुदितो गुणैः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2198016, "chapter_id": 5207, "verse_number": "८", "content_sanskrit": "स यज्ञकारः कौन्तेय पित्रा सृष्टः परन्तप ।\nप्रायाद् गर्दभयुक्तेन रथेनेहाशुगामिना\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2198017, "chapter_id": 5207, "verse_number": "९", "content_sanskrit": "स बालं गर्दभं राजन् वहन्तं मातुरन्तिके ।\nनिरविध्यत् प्रतोदेन नासिकायां पुनः पुनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2198018, "chapter_id": 5207, "verse_number": "१०", "content_sanskrit": "तं तु तीव्रव्रणं दृष्ट्वा गर्दभी पुत्रगृद्धिनी ।\nउवाच मा शुचः पुत्र चण्डालस्त्वाऽधितिष्ठति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2198019, "chapter_id": 5207, "verse_number": "११", "content_sanskrit": "ब्राह्मणे दारुणं नास्ति मैत्रो ब्राह्मण उच्यते ।\nआचार्यः सर्वभूतानां शास्ता किं प्रहरिष्यति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2198020, "chapter_id": 5207, "verse_number": "१२", "content_sanskrit": "अयं तु पापप्रकृतिर्बाले न कुरुते दयाम् ।\nस्वयोनिं मानयत्येष भावो भावं निगच्छति\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2198021, "chapter_id": 5207, "verse_number": "१३", "content_sanskrit": "एतच्छ्रुत्वा मतङ्गस्तु दारुणं रासभीवचः ।\nअवतीर्य रथात् तूर्णं रासभीं प्रत्यभाषत\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2198022, "chapter_id": 5207, "verse_number": "१४", "content_sanskrit": "ब्रूहि रासभि कल्याणि माता मे येन दूषिता ।\nकथं मां वेत्सि चण्डालं क्षिप्रं रासभि शंस मे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2198023, "chapter_id": 5207, "verse_number": "१५", "content_sanskrit": "केन जातोऽस्मि चण्डालो ब्राह्मण्यं येन मेऽनशत् ।\nतत्त्वेनैतन्महाप्राज्ञे ब्रूहि सर्वमशेषतः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2198024, "chapter_id": 5207, "verse_number": "", "content_sanskrit": "गर्दभी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2198025, "chapter_id": 5207, "verse_number": "१६", "content_sanskrit": "ब्राह्मण्यां वृषलेन त्वं मत्तायां नापितेन ह ।\nजातस्त्वमसि चण्डालो ब्राह्मण्यं तेन तेऽनशत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2198026, "chapter_id": 5207, "verse_number": "१७", "content_sanskrit": "एवमुक्तो मतङ्गस्तु प्रत्युपायाद् गृहं प्रति ।\nतमागतमभिप्रेक्ष्य पिता वाक्यमथाब्रवीत्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2198027, "chapter_id": 5207, "verse_number": "१८", "content_sanskrit": "मया त्वं यज्ञसंसिद्धौ नियुक्तो गुरुकर्मणि ।\nकस्मात् प्रतिनिवृत्तोऽसि कच्चिन्न कुशलं तव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2198028, "chapter_id": 5207, "verse_number": "", "content_sanskrit": "मतङ्गः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2198029, "chapter_id": 5207, "verse_number": "१९", "content_sanskrit": "अयोनिरभियोनिर्वा यः स्यात्स कुशली भवेत् ।\nकुशलं तु कुतस्तस्य यस्येयं जननी पितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2198030, "chapter_id": 5207, "verse_number": "२०", "content_sanskrit": "ब्राह्मण्यां वृषलाज्जातं पितर्वेदयतीह माम् ।\nअमानुषी गर्दभीयं तस्मात् तप्स्ये तपो महत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2198031, "chapter_id": 5207, "verse_number": "२१", "content_sanskrit": "एवमुक्त्वा स पितरं प्रतस्थे कृतनिश्चयः ।\nततो गत्वा महारण्यमतप्यत महत्तपः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2198032, "chapter_id": 5207, "verse_number": "२२", "content_sanskrit": "ततः सन्तापयामास विबुधांस्तपसाऽन्वितः ।\nमतङ्गः सुसुखं प्रेप्सुः स्थानं सुचरितादपि\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2198033, "chapter_id": 5207, "verse_number": "२३", "content_sanskrit": "तं तथा तपसा युक्तमुवाच हरिवाहनः ।\nमतङ्ग तप्यसे किं त्वं भोगानुत्सृज्य मानुषान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2198034, "chapter_id": 5207, "verse_number": "२४", "content_sanskrit": "वरं ददानि ते हन्त वृणीष्व त्वं यदिच्छसि ।\nयच्चाप्यवाप्यमन्यत् ते सर्वं प्रब्रूहि माचिरम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2198035, "chapter_id": 5207, "verse_number": "", "content_sanskrit": "मतङ्गः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2198036, "chapter_id": 5207, "verse_number": "२५", "content_sanskrit": "ब्राह्मण्यं कामयानोऽहमिदमारब्धवांस्तपः ।\nगच्छेयं तदवाप्येह वर एष वृतो मया\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2198037, "chapter_id": 5207, "verse_number": "२६", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं तमुवाच पुरन्दरः ।\nब्राह्मण्यं प्रार्थयानस्त्वमप्राप्यमकृतात्मभिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2198038, "chapter_id": 5207, "verse_number": "२७", "content_sanskrit": "श्रेष्ठं यत् सर्वभूतेषु तपो यन्नातिवर्तते ।\nतदग्र्यं प्रार्थयानस्त्वमचिराद् विनशिष्यसि\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2198039, "chapter_id": 5207, "verse_number": "२८", "content_sanskrit": "देवतासुरमर्त्येषु यत् पवित्रं परं स्मृतम् ।\nचण्डालयोनौ जातेन न तत् प्राप्यं कथञ्चन\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2198040, "chapter_id": 5207, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि\nदानधर्मे इन्द्रमतङ्गसंवादो नाम अष्टपञ्चाशोऽध्यायः ॥५८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]