[{"id": 5000268000, "chapter_id": 9268, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे एकसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000268001, "chapter_id": 9268, "verse_number": "३-७१-१", "content_sanskrit": "पुरा राम महाबाहो महाबलपराक्रमम्।\nरूपमासीन्ममाचिन्त्यं त्रिषु लोकेषु विश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000268002, "chapter_id": 9268, "verse_number": "३-७१-२", "content_sanskrit": "यथा सूर्यस्य सोमस्य शक्रस्य च यथा वपुः।\nसोऽहं रूपमिदं कृत्वा लोकवित्रासनं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000268003, "chapter_id": 9268, "verse_number": "३-७१-३", "content_sanskrit": "ऋषीन् वनगतान् राम त्रासयामि ततस्ततः।\nततः स्थूलशिरा नाम महर्षिः कोपितो मया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000268004, "chapter_id": 9268, "verse_number": "३-७१-४", "content_sanskrit": "स चिन्वन् विविधं वन्यं रूपेणानेन धर्षितः।\nतेनाहमुक्तः प्रेक्ष्यैवं घोरशापाभिधायिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000268005, "chapter_id": 9268, "verse_number": "३-७१-५", "content_sanskrit": "एतदेवं नृशंसं ते रूपमस्तु विगर्हितम्।\nस मया याचितः क्रुद्धः शापस्यान्तो भवेदिति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000268006, "chapter_id": 9268, "verse_number": "३-७१-६", "content_sanskrit": "अभिशापकृतस्येति तेनेदं भाषितं वचः।\nयदा छित्त्वा भुजौ रामस्त्वां दहेद् विजने वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000268007, "chapter_id": 9268, "verse_number": "३-७१-७", "content_sanskrit": "तदा त्वं प्राप्स्यसे रूपं स्वमेव विपुलं शुभम्।\nश्रिया विराजितं पुत्रं दनोस्त्वं विद्धि लक्ष्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000268008, "chapter_id": 9268, "verse_number": "३-७१-८", "content_sanskrit": "इन्द्रकोपादिदं रूपं प्राप्तमेवं रणाजिरे।\nअहं हि तपसोग्रेण पितामहमतोषयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000268009, "chapter_id": 9268, "verse_number": "३-७१-९", "content_sanskrit": "दीर्घमायुः स मे प्रादात् ततो मां विभ्रमोऽस्पृशत् ।\nदीर्घमायुर्मया प्राप्तं किं मां शक्रः करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000268010, "chapter_id": 9268, "verse_number": "३-७१-१०", "content_sanskrit": "इत्येवं बुद्धिमास्थाय रणे शक्रमधर्षयम्।\nतस्य बाहुप्रमुक्तेन वज्रेण शतपर्वणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000268011, "chapter_id": 9268, "verse_number": "३-७१-११", "content_sanskrit": "सक्थिनी च शिरश्चैव शरीरे सम्प्रवेशितम्।\nस मया याच्यमानः सन् नानयद् यमसादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000268012, "chapter_id": 9268, "verse_number": "३-७१-१२", "content_sanskrit": "पितामहवचः सत्यं तदस्त्विति ममाब्रवीत्।\nअनाहारः कथं शक्तो भग्नसक्थिशिरोमुखः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000268013, "chapter_id": 9268, "verse_number": "३-७१-१३", "content_sanskrit": "वज्रेणाभिहतः कालं सुदीर्घमपि जीवितुम्।\nस एवमुक्तः शक्रो मे बाहू योजनमायतौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000268014, "chapter_id": 9268, "verse_number": "३-७१-१४", "content_sanskrit": "तदा चास्यं च मे कुक्षौ तीक्ष्णदंष्ट्रमकल्पयत् ।\nसोऽहं भुजाभ्यां दीर्घाभ्यां संक्षिप्यास्मिन् वनेचरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000268015, "chapter_id": 9268, "verse_number": "३-७१-१५", "content_sanskrit": "सिंहद्वीपिमृगव्याघ्रान् भक्षयामि समन्ततः।\nस तु मामब्रवीदिन्द्रो यदा रामः सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000268016, "chapter_id": 9268, "verse_number": "३-७१-१६", "content_sanskrit": "छेत्स्यते समरे बाहू तदा स्वर्गं गमिष्यसि।\nअनेन वपुषा तात वनेऽस्मिन् राजसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000268017, "chapter_id": 9268, "verse_number": "३-७१-१७", "content_sanskrit": "यद् यत् पश्यामि सर्वस्य ग्रहणं साधु रोचये।\nअवश्यं ग्रहणं रामो मन्येऽहं समुपैष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000268018, "chapter_id": 9268, "verse_number": "३-७१-१८", "content_sanskrit": "इमां बुद्धिं पुरस्कृत्य देहन्यासकृतश्रमः।\nस त्वं रामोऽसि भद्रं ते नाहमन्येन राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000268019, "chapter_id": 9268, "verse_number": "३-७१-१९", "content_sanskrit": "शक्यो हन्तुं यथा तत्त्वमेवमुक्तं महर्षिणा।\nअहं हि मतिसाचिव्यं करिष्यामि नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000268020, "chapter_id": 9268, "verse_number": "३-७१-२०", "content_sanskrit": "मित्रं चैवोपदेक्ष्यामि युवाभ्यां संस्कृतोऽग्निना।\nएवमुक्तस्तु धर्मात्मा दनुना तेन राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000268021, "chapter_id": 9268, "verse_number": "३-७१-२१", "content_sanskrit": "इदं जगाद वचनं लक्ष्मणस्य च पश्यतः।\nरावणेन हृता भार्या सीता मम यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000268022, "chapter_id": 9268, "verse_number": "३-७१-२२", "content_sanskrit": "निष्क्रान्तस्य जनस्थानात् सह भ्रात्रा यथासुखम्।\nनाममात्रं तु जानामि न रूपं तस्य रक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000268023, "chapter_id": 9268, "verse_number": "३-७१-२३", "content_sanskrit": "निवासं वा प्रभावं वा वयं तस्य न विद्महे।\nशोकार्तानामनाथानामेवं विपरिधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000268024, "chapter_id": 9268, "verse_number": "३-७१-२४", "content_sanskrit": "कारुण्यं सदृशं कर्तुमुपकारेण वर्तताम्।\nकाष्ठान्यानीय भग्नानि काले शुष्काणि कुञ्जरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000268025, "chapter_id": 9268, "verse_number": "३-७१-२५", "content_sanskrit": "धक्ष्यामस्त्वां वयं वीर श्वभ्रे महति कल्पिते।\nस त्वं सीतां समाचक्ष्व येन वा यत्र वा हृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000268026, "chapter_id": 9268, "verse_number": "३-७१-२६", "content_sanskrit": "कुरु कल्याणमत्यर्थं यदि जानासि तत्त्वतः।\nएवमुक्तस्तु रामेण वाक्यं दनुरनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000268027, "chapter_id": 9268, "verse_number": "३-७१-२७", "content_sanskrit": "प्रोवाच कुशलो वक्ता वक्तारमपि राघवम्।\nदिव्यमस्ति न मे ज्ञानं नाभिजानामि मैथिलीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000268028, "chapter_id": 9268, "verse_number": "३-७१-२८", "content_sanskrit": "यस्तां वक्ष्यति तं वक्ष्ये दग्धः स्वं रूपमास्थितः।\nयोऽभिजानाति तद्रक्षस्तद् वक्ष्ये राम तत्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000268029, "chapter_id": 9268, "verse_number": "३-७१-२९", "content_sanskrit": "अदग्धस्य हि विज्ञातुं शक्तिरस्ति न मे प्रभो।\nराक्षसं तु महावीर्यं सीता येन हृता तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000268030, "chapter_id": 9268, "verse_number": "३-७१-३०", "content_sanskrit": "विज्ञानं हि महद् भ्रष्टं शापदोषेण राघव।\nस्वकृतेन मया प्राप्तं रूपं लोकविगर्हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000268031, "chapter_id": 9268, "verse_number": "३-७१-३१", "content_sanskrit": "किं तु यावन्न यात्यस्तं सविता श्रान्तवाहनः।\nतावन्मामवटे क्षिप्त्वा दह राम यथाविधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000268032, "chapter_id": 9268, "verse_number": "३-७१-३२", "content_sanskrit": "दग्धस्त्वयाहमवटे न्यायेन रघुनन्दन।\nवक्ष्यामि तं महावीर यस्तं वेत्स्यति राक्षसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000268033, "chapter_id": 9268, "verse_number": "३-७१-३३", "content_sanskrit": "तेन सख्यं च कर्तव्यं न्याय्यवृत्तेन राघव।\nकल्पयिष्यति ते वीर साहाय्यं लघुविक्रम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000268034, "chapter_id": 9268, "verse_number": "३-७१-३४", "content_sanskrit": "नहि तस्यास्त्यविज्ञातं त्रिषु लोकेषु राघव।\nसर्वान् परिवृतो लोकान् पुरा वै कारणान्तरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000268035, "chapter_id": 9268, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे एकसप्ततितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]