[{"id": 40017727, "chapter_id": 9268, "verse_number": "1", "content_sanskrit": "मकराक्षंहतंश्रुत्वारावणस्समितिञ्जयः । रोषेणमहताविष्टोदन्ताङ्कटकटाय्य च ॥ कोपितश्चतदातत्रकिंकार्यमितिचिन्तयन् । आदिदेशाथसङ्क्रुद्धोरणायेजितंसुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40017728, "chapter_id": 9268, "verse_number": "2", "content_sanskrit": "मकराक्षंहतंश्रुत्वारावणस्समितिञ्जयः । रोषेणमहताविष्टोदन्ताङ्कटकटाय्य च ॥ कोपितश्चतदातत्रकिंकार्यमितिचिन्तयन् । आदिदेशाथसङ्क्रुद्धोरणायेजितंसुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40017729, "chapter_id": 9268, "verse_number": "3", "content_sanskrit": "जहिवीर महावीर्यौभ्रातरौरामलक्ष्मणौ । अदृश्योदृश्यमानोवासर्वथात्वंबलाधिकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40017730, "chapter_id": 9268, "verse_number": "4", "content_sanskrit": "त्वमप्रतिमकर्माणमिन्द्रंजयसिसंयुगे । किंपुनर्मानुषौदृष्टवा न वधिष्यसिसंयुगे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40017731, "chapter_id": 9268, "verse_number": "5", "content_sanskrit": "तथोक्तोराक्षसेन्द्रेणप्रतिगृह्यपितुर्वचः । यज्ञभूमौ स विधिवत् पावकंजुहवेन्द्रजित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40017732, "chapter_id": 9268, "verse_number": "6", "content_sanskrit": "जुह्वतश्चापितत्राग्निंरक्तोष्णीषधरास्त्रिरियः । आजग्मुस्तत्रसम्भ्रान्ताराक्षस्योयत्ररावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40017733, "chapter_id": 9268, "verse_number": "7", "content_sanskrit": "शस्त्राणिशरपत्राणिसमिधोऽथविभीतकाः । लोहितानि च वासांहिस्रुवंकार्ष्णायसंतथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40017734, "chapter_id": 9268, "verse_number": "8", "content_sanskrit": "सर्वतोऽग्निंसमास्तीर्यशरपत्रैस्सतोमरैः । छागस्यसर्वकृष्णस्यगळंजग्राहजीवतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40017735, "chapter_id": 9268, "verse_number": "9", "content_sanskrit": "सकृदेवसमिद्धस्यविधूमस्यमहार्चिषः । बभूवुस्तानिलिङ्गानिविजयंदर्शयन्ति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40017736, "chapter_id": 9268, "verse_number": "10", "content_sanskrit": "प्रदक्षिणावर्तशिखस्तप्तहाटकसन्निभः । हविस्तत्प्रतिजग्राहपावकस्स्वयमुत्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40017737, "chapter_id": 9268, "verse_number": "11", "content_sanskrit": "हुत्वाग्निंतर्पयित्वाथदेवदानवराक्षसान् । आरुरोहरथश्रेष्ठमन्तर्थानगतंशुभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40017738, "chapter_id": 9268, "verse_number": "12", "content_sanskrit": "स वाजिभिश्चतुर्भिस्तुबाणैश्चनिशितैर्युतः । आरोपितमहाचापश्शुशुभेस्यन्दनोत्तमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40017739, "chapter_id": 9268, "verse_number": "13", "content_sanskrit": "जाज्वल्यमानोवपुषातपनीयपरिच्छदः । मृगैश्चन्द्रार्धचन्द्रैश्च स रथस्समलङ्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40017740, "chapter_id": 9268, "verse_number": "14", "content_sanskrit": "जाम्बूनदमहाकम्बुर्दीप्तपावकसन्निभः । बभूवेन्द्रजितःकेतुर्वैदूर्यसमलङ्कृतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40017741, "chapter_id": 9268, "verse_number": "15", "content_sanskrit": "तेनचादित्यकल्पेनब्रह्मास्त्रण च पालितः । स बभूवदुराधर्षोरावणिस्सुमहाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40017742, "chapter_id": 9268, "verse_number": "16", "content_sanskrit": "सोऽभिनिर्यायनगरादिन्द्रजित्समितिञ्जयः । हत्वाग्निंराक्षसैर्मन्त्रैरन्तर्धानगतोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40017743, "chapter_id": 9268, "verse_number": "17", "content_sanskrit": "अद्यहत्वारणेयौतौमिथ्याप्रव्रजितौवने । जयंपित्रेप्रदास्यामिरावणायरणार्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40017744, "chapter_id": 9268, "verse_number": "18", "content_sanskrit": "अद्यनिर्वानरमुर्वींहत्वारामंसलक्ष्मणम् । करिष्येपरमांप्रीतिमित्युक्त्वान्तरधीयत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40017745, "chapter_id": 9268, "verse_number": "19", "content_sanskrit": "आपपातथसङ्कृद्धोदशग्रीवेणचोदितः । तीक्षणकार्मुकनाराचैस्तीक्षणस्त्विन्द्ररिपूरणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40017746, "chapter_id": 9268, "verse_number": "20", "content_sanskrit": "स ददर्शमहावीर्यौनागौत्रिशिरसानिव । सृजन्ताविषुजालानिवीरौवानरमध्यगौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40017747, "chapter_id": 9268, "verse_number": "21", "content_sanskrit": "इमौतावितिसञ्चिन्त्यसज्जंकृत्वा च कार्मुकम् । सन्ततानेषुधाराभिःपर्जन्यइववृष्टिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40017748, "chapter_id": 9268, "verse_number": "22", "content_sanskrit": "तुवैहायसंप्राप्यसरथोरामलक्ष्मणौ । आचक्षुर्विषयेतिष्ठवनिव्याधनिशितैश्शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40017749, "chapter_id": 9268, "verse_number": "23", "content_sanskrit": "तौतस्यशरवेगेनपरीतौरामलक्ष्मणौ । धनुषीसशरेकृत्वादिव्यमस्त्रंप्रचक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40017750, "chapter_id": 9268, "verse_number": "24", "content_sanskrit": "प्रच्छादयन्तौगगनंशरजालैर्महाबलौ । तमस्त्रःसूर्यसङ्काशैर्नैवपस्पृशतुश्शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40017751, "chapter_id": 9268, "verse_number": "25", "content_sanskrit": "स हिधूमान्धकारं च चक्रेप्रच्चादयन्नभः । दिशश्चान्तर्दधेश्रीमान्नीहारतमसावृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40017752, "chapter_id": 9268, "verse_number": "26", "content_sanskrit": "नैवज्यातलनिर्घोषा न च नेमिखुरस्वनः । शुश्रुवेचरतस्तस्य न च रूपंप्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40017753, "chapter_id": 9268, "verse_number": "27", "content_sanskrit": "घनान्धकारेतिमिरेशरावर्षमिवाद्भुतम् । स ववर्षमहाबाहुर्नाराचशरवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40017754, "chapter_id": 9268, "verse_number": "28", "content_sanskrit": "स रामंसूर्यसङ्काशैश्शरैर्धत्तवरोर्भृशम् । विव्याधसमरेक्रुद्धःसर्वगात्रेषुरावणिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40017755, "chapter_id": 9268, "verse_number": "29", "content_sanskrit": "तौहन्यमानौनाराचैर्धाराभिरिवपर्वतौ । हेमपुङ्खान्नरव्याघ्रौतिग्मान्मुमुचतुःशरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40017756, "chapter_id": 9268, "verse_number": "30", "content_sanskrit": "अन्तरिक्षेसमासाद्यरावणिंकङ्कपत्रिणः । निकृत्यपतगाभूमौसेतुस्तेशोणितोक्षिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40017757, "chapter_id": 9268, "verse_number": "31", "content_sanskrit": "अतिमात्रंशरौघेणपीड्यमानौनरोत्तमौ । तानिषून्पततोभल्लैरनेकैर्विचकर्ततुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40017758, "chapter_id": 9268, "verse_number": "32", "content_sanskrit": "यतोहिददृशातेतौशरान् निपतितान्शितान् । ततस्तुतौदाशरथीससृजातेऽस्त्रमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 40017759, "chapter_id": 9268, "verse_number": "33", "content_sanskrit": "रावणिस्तुदिशस्सर्वारथेनातिरथोऽपतत् । विव्याधतौदाशरथीलघ्वस्त्रनिशितैःशरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 40017760, "chapter_id": 9268, "verse_number": "34", "content_sanskrit": "तेनातिविद्धौतौवीरौरुक्मपुङ्खैःसुसम्हतैः । बभूवतुर्धाशरथीपुष्पितामिवकिंशुकौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 40017761, "chapter_id": 9268, "verse_number": "35", "content_sanskrit": "नास्यवेगगतिंकचशिन्न च रूपंधनुश्शरान् । न चान्यद्विदितंकिञ्चित्सूर्यस्येवाभ्रसम्प्लवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 40017762, "chapter_id": 9268, "verse_number": "36", "content_sanskrit": "तेनविद्धाश्चहरयोनिहताश्चगतासवः । बभूवुःशतशस्तत्रपतिताधरणीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 40017763, "chapter_id": 9268, "verse_number": "37", "content_sanskrit": "लक्ष्मणस्तुततस्सुङ्क्रृद्धोभ्रातरंवाक्यमब्रवीत् । ब्राह्ममस्त्रंप्रयोक्ष्यामिवधार्थंसर्वरक्षसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 40017764, "chapter_id": 9268, "verse_number": "38", "content_sanskrit": "तमुवाचततोरामोलक्ष्मणंशुभलक्षणम् । नैकस्यहेतोरक्षांसिपृथिव्यांहन्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 40017765, "chapter_id": 9268, "verse_number": "39", "content_sanskrit": "अयुध्यमानंप्रच्छन्नंप्राञ्जलिंशरणागतम् । पलायमानंमत्तंवा न हन्तुंत्वमिहार्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 40017766, "chapter_id": 9268, "verse_number": "40", "content_sanskrit": "अस्यैवतुवधेयत्नंकरिष्यावोमहाभुज । आदेक्ष्यावोमहावेगावस्त्रानाशीविषोपमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 40017767, "chapter_id": 9268, "verse_number": "41", "content_sanskrit": "तमेनंमायिनंक्षुद्रमन्तर्हितरथंबलात् । राक्षसंनिहनिष्यन्तिदृष्टवावानरयूथपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 40017768, "chapter_id": 9268, "verse_number": "42", "content_sanskrit": "यद्येषभूमिंविशतेदिवंवारसातलंवापिनभस्स्थलंवा । एवंनिगूढोऽममास्त्रदग्धःपतिष्यतेभूमितलेगतासुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]