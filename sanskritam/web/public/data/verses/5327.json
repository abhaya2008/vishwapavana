[{"id": 2203129, "chapter_id": 5327, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2203130, "chapter_id": 5327, "verse_number": "१", "content_sanskrit": "केन ते च भवेत् प्रीतिः कथं तुष्टिं तु गच्छसि ।\nइति पृष्टः सुरेन्द्रेण प्रोवाच हरिरव्ययः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2203131, "chapter_id": 5327, "verse_number": "२", "content_sanskrit": "ब्राह्मणानां परीवादो मम विद्वेषणं महत् ।\nब्राह्मणैः पूजितैर्नित्यं पूजितोऽहं न संशयः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2203132, "chapter_id": 5327, "verse_number": "३", "content_sanskrit": "नित्याभिवाद्या विप्रेन्द्रा भुक्त्वा पादौ तथाऽऽत्मनः ।\nतेषां तुष्यामि मर्त्यानां यश्चक्रे च बलिं हरेत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2203133, "chapter_id": 5327, "verse_number": "४", "content_sanskrit": "वामनं ब्राह्मणं दृष्ट्वा वराहं च जटोच्छ्रितम् ।\nउद्धृतां धरणीं चैव मूर्ध्ना धारयते तु यः ।\nन तेषामशुभं किञ्चित् कल्मषं चोपपद्यते\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2203134, "chapter_id": 5327, "verse_number": "५", "content_sanskrit": "अश्वत्थं रोचनां गां च पूजयेद् यो नरः सदा ।\nपूजितं च जगत् तेन सदेवासुरमानुषम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2203135, "chapter_id": 5327, "verse_number": "६", "content_sanskrit": "तेन रूपेण तेषां च पूजां गृह्णामि तत्त्वतः ।\nपूजा ममैषा नास्त्यन्या यावल्लोकाः प्रतिष्ठिताः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2203136, "chapter_id": 5327, "verse_number": "७", "content_sanskrit": "अन्यथा हि वृथा मर्त्याः पूजयन्त्यल्पबुद्धयः ।\nनाहं तत् प्रतिगृह्णामि न सा तुष्टिकरी मम\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2203137, "chapter_id": 5327, "verse_number": "", "content_sanskrit": "इन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2203138, "chapter_id": 5327, "verse_number": "८", "content_sanskrit": "चक्रं पादौ वराहं च ब्राह्मणं चापि वामनम् ।\nउद्धृतां धरणीं चैव किमर्थं त्वं प्रशंससि\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2203139, "chapter_id": 5327, "verse_number": "९", "content_sanskrit": "भवान् सृजति भूतानि भवान् संहरति प्रजाः ।\nप्रकृतिः सर्वभूतानां समर्त्यानां सनातनी\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2203140, "chapter_id": 5327, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2203141, "chapter_id": 5327, "verse_number": "१०", "content_sanskrit": "सम्प्रहस्य ततो विष्णुरिदं वचनमब्रवीत् ।\nचक्रेण निहता दैत्याः पद्भ्यां क्रान्ता वसुन्धरा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2203142, "chapter_id": 5327, "verse_number": "११", "content_sanskrit": "वाराहं रूपमास्थाय उद्धृता च वसुन्धरा ।\nवामनं रूपमास्थाय जितो राजा मया बलिः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2203143, "chapter_id": 5327, "verse_number": "१२", "content_sanskrit": "परितुष्टो भवाम्येवं मानुषाणां महात्मनाम् ।\nतन्मां ये पूजयिष्यन्ति नास्ति तेषां पराभवः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2203144, "chapter_id": 5327, "verse_number": "१३", "content_sanskrit": "अपि वा ब्राह्मणं दृष्ट्वा ब्रह्मचारिणमागतम् ।\nब्राह्मणायाहुतिं दत्त्वा अमृतं तस्य भोजनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2203145, "chapter_id": 5327, "verse_number": "१४", "content_sanskrit": "ऐन्द्रीं संध्यामुपासित्वा आदित्याभिमुखःस्थितः ।\nसर्वतीर्थेषु स स्नातो मुच्यते सर्वकिल्बिषैः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2203146, "chapter_id": 5327, "verse_number": "१५", "content_sanskrit": "एतद् वः कथितं गुह्यमखिलेन तपोधनाः ।\nसंशयं पृच्छमानानां किं भूयः कथयाम्यहम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2203147, "chapter_id": 5327, "verse_number": "", "content_sanskrit": "बलदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2203148, "chapter_id": 5327, "verse_number": "१६", "content_sanskrit": "श्रूयतां परमं गुह्यं मानुषाणां सुखावहम् ।\nअजानन्तो यदबुधाः क्लिश्यन्ते भूतपीडिताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2203149, "chapter_id": 5327, "verse_number": "१७", "content_sanskrit": "कल्य उत्थाय यो मर्त्यः स्पृशेद् गां वै घृतं दधि ।\nसर्षपं च प्रियङ्गुं च कल्मषात् प्रतिमुच्यते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2203150, "chapter_id": 5327, "verse_number": "१८", "content_sanskrit": "भूतानि चैव सर्वाणि अग्रतः पृष्ठतोऽपि वा ।\nउच्छिष्टं वाऽपि च्छिद्रेषु वर्जयन्ति तपोधनाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2203151, "chapter_id": 5327, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2203152, "chapter_id": 5327, "verse_number": "१९", "content_sanskrit": "प्रगृह्यौदुम्बरं पात्रं तोयपूर्णमुदङ्मुखः ।\nउपवासं तु गृह्णीयाद् यद्वा सङ्कल्पयेद् व्रतम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2203153, "chapter_id": 5327, "verse_number": "२०", "content_sanskrit": "देवतास्तस्य तुष्यन्ति कामिकं चापि सिद्ध्यति ।\nअन्यथा हि वृथा मर्त्याः कुर्वते स्वल्पबुद्धयः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2203154, "chapter_id": 5327, "verse_number": "२१", "content_sanskrit": "उपवासे बलौ चापि ताम्रपात्रं विशिष्यते ।\nबलिर्भिक्षा तथाऽर्ध्यं च पितॄणां च तिलोदकम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2203155, "chapter_id": 5327, "verse_number": "२२", "content_sanskrit": "ताम्रपात्रेण दातव्यमन्यथाऽल्पफलं भवेत् ।\nगुह्यमेतत् समुद्दिष्टं यथा तुष्यन्ति देवताः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2203156, "chapter_id": 5327, "verse_number": "", "content_sanskrit": "धर्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2203157, "chapter_id": 5327, "verse_number": "२३", "content_sanskrit": "राजपौरुषिके विप्रे घाण्टिके परिचारिके ।\nगोरक्षके वाणिजके तथा कारुकुशीलवे\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2203158, "chapter_id": 5327, "verse_number": "२४", "content_sanskrit": "मित्रद्रुह्यनधीयाने यश्च स्याद् वृषलीपतिः ।\nएतेषु दैवं पित्र्यं वा न देयं स्यात् कथञ्चन ।\nपिण्डदास्तस्य हीयन्ते न च प्रीणाति वै पितॄन्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2203159, "chapter_id": 5327, "verse_number": "२५", "content_sanskrit": "अतिथिर्यस्य भग्नाशो गृहात् प्रतिनिवर्तते ।\nपितरस्तस्य देवाश्च अग्नयश्च तथैव हि ।\nनिराशाः प्रतिगच्छन्ति अतिथेरप्रतिग्रहात्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2203160, "chapter_id": 5327, "verse_number": "२६", "content_sanskrit": "स्त्रीघ्नैर्गोघ्नैः कृतघ्नैश्च ब्रह्मघ्नैर्गुरुतल्पगैः ।\nतुल्यदोषो भवत्येभिर्यस्यातिथिरनर्चितः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2203161, "chapter_id": 5327, "verse_number": "", "content_sanskrit": "अग्निः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2203162, "chapter_id": 5327, "verse_number": "२७", "content_sanskrit": "पादमुद्यम्य यो मर्त्यः स्पृशेद् गाश्च सुदुर्मतिः ।\nब्राह्मणं वा महाभागं दीप्यमानं तथाऽनलम् ।\nतस्य दोषान् प्रवक्ष्यामि तच्छृणुध्वं समाहिताः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2203163, "chapter_id": 5327, "verse_number": "२८", "content_sanskrit": "दिवं स्पृशत्यशब्दोऽस्य त्रस्यन्ति पितरश्च वै ।\nवैमनस्यं च देवानां कृतं भवति पुष्कळम् ।\nपावकश्च महातेजा हव्यं न प्रतिगृह्णति\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2203164, "chapter_id": 5327, "verse_number": "२९", "content_sanskrit": "आजन्मनां शतं चैव नरके पच्यते तु सः ।\nनिष्कृतिं च न तस्यापि अनुमन्यन्ति कर्हिचित्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2203165, "chapter_id": 5327, "verse_number": "३०", "content_sanskrit": "तस्माद् गावो न पादेन स्प्रष्टव्या वै कदाचन ।\nब्राह्मणश्च महातेजा दीप्यमानस्तथाऽनलः ।\nश्रद्दधानेन मर्त्येन आत्मनो हितमिच्छता\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2203166, "chapter_id": 5327, "verse_number": "३१", "content_sanskrit": "एते दोषा मया प्रोक्तास्त्रिषु यः पादमुत्सृजेत् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2203167, "chapter_id": 5327, "verse_number": "", "content_sanskrit": "विश्वामित्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2203168, "chapter_id": 5327, "verse_number": "३२", "content_sanskrit": "श्रूयतां परमं गुह्यं रहस्यं धर्मसंहितम् ।\nपरमान्नेन यो दद्यात् पितॄणामौपहारिकम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2203169, "chapter_id": 5327, "verse_number": "३३", "content_sanskrit": "गजच्छायायां पूर्वस्यां कुतपे दक्षिणामुखः ।\nयदा भाद्रपदे मासि भवते बहुले मघा\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2203170, "chapter_id": 5327, "verse_number": "३४", "content_sanskrit": "श्रूयतां तस्य दानस्य यादृशो गुणविस्तरः ।\nकृतं तेन महच्छ्राद्धं वर्षाणीह त्रयोदश\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2203171, "chapter_id": 5327, "verse_number": "३५", "content_sanskrit": "बहुले समङ्गे ह्यकुतोभये च\nक्षेमे च सङ्ख्येव(?) हि भूयसी च ।\nयथा पुरा ब्रह्मपुरे सवत्सा\nशतक्रतोर्वज्रधरस्य यज्ञे\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2203172, "chapter_id": 5327, "verse_number": "३६", "content_sanskrit": "भूयश्च या विष्णुपदे स्थिता या\nविभावसोश्चापि पथे स्थिता याः ।\nदेवाश्च सर्वे सह नारदेन\nप्रकुर्वते सर्वसहेति नाम\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2203173, "chapter_id": 5327, "verse_number": "३७", "content_sanskrit": "मन्त्रेणैतेनाभिवन्देत यो वै\nविमुच्यते पापकृतेन कर्मणा ।\nलोकानवाप्नोति पुरन्दरस्य\nगवां फलं चन्द्रमसो द्युतिं च\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2203174, "chapter_id": 5327, "verse_number": "३८", "content_sanskrit": "एवं हि मन्त्रं त्रिदशाभिजुष्टं\nपठेत यः पर्वसु गोष्ठमध्ये ।\nन तस्य पापं न भयं न शोकः\nसहस्रनेत्रस्य च याति लोकम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2203175, "chapter_id": 5327, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2203176, "chapter_id": 5327, "verse_number": "३९", "content_sanskrit": "अथ सप्त महाभाग ऋषयो लोकविश्रुताः ।\nवसिष्ठप्रमुखाः सर्वे ब्रह्माणं पद्मसम्भवम् ।\nप्रदक्षिणमभिक्रम्य सर्वे प्राञ्जलयः स्थिताः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2203177, "chapter_id": 5327, "verse_number": "४०", "content_sanskrit": "उवाच वचनं तेषां वसिष्ठो ब्रह्मवित्तमः ।\nसर्वप्राणिहितं प्रश्नं ब्रह्मक्षत्रे विशेषतः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2203178, "chapter_id": 5327, "verse_number": "४१", "content_sanskrit": "द्रव्यहीनाः कथं मर्त्या दरिद्राः साधुवृत्तयः ।\nप्राप्नुवन्तीह यज्ञस्य फलं केन च कर्मणा\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2203179, "chapter_id": 5327, "verse_number": "४२", "content_sanskrit": "एतच्छ्रुत्वा वचस्तेषां ब्रह्मा वचनमब्रवीत्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2203180, "chapter_id": 5327, "verse_number": "४३", "content_sanskrit": "अहो प्रश्नो महाभाग गूढार्थः परमः शुभः ।\nसूक्ष्मः श्रेयांश्च मर्त्यानां भवद्भिः समुदाहृतः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2203181, "chapter_id": 5327, "verse_number": "४४", "content_sanskrit": "श्रूयतां सर्वमाख्यास्ये निखिलेन तपोधनाः ।\nयथा यज्ञफलं मर्त्यो लभते नात्र संशयः\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2203182, "chapter_id": 5327, "verse_number": "४५", "content_sanskrit": "पौषमासस्य शुक्ले वै यदा युज्येत रोहिणी ।\nतेन नक्षत्रयोगेन आकाशशयनो भवेत्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2203183, "chapter_id": 5327, "verse_number": "४६", "content_sanskrit": "एकवस्त्रः शुचिः स्नातः श्रद्दधानः समाहितः ।\nसोमस्य रश्मयः पीत्वा महायज्ञफलं लभेत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2203184, "chapter_id": 5327, "verse_number": "४७", "content_sanskrit": "एतद् वः परमं गुह्यं कथितं द्विजसत्तमाः ।\nयन्मां भवन्तः पृच्छन्ति सूक्ष्मतत्त्वार्थदर्शिनः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2203185, "chapter_id": 5327, "verse_number": "", "content_sanskrit": "॥इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे देवैर्धर्मोपदेशो नाम अष्टसप्तत्युत्तरशततमोऽध्यायः ॥१७८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]