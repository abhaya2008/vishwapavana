[{"id": 2213448, "chapter_id": 5558, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213449, "chapter_id": 5558, "verse_number": "१", "content_sanskrit": "वनवासं गते विप्र धृतराष्ट्रे महीपतौ ।\nसभार्ये नृपशार्दूले वध्वा कुन्त्या समन्विते\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213450, "chapter_id": 5558, "verse_number": "२", "content_sanskrit": "विदुरे चापि धर्मज्ञे धर्मराजं व्यपाश्रिते ।\nवसत्सु पाण्डुपुत्रेषु सर्वेष्वाश्रममण्डले\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213451, "chapter_id": 5558, "verse_number": "३", "content_sanskrit": "यत्तदाश्चर्यमिति वै करिष्यामीत्युवाच ह ।\nव्यासः परमतेजस्वी महर्षिस्तद्वदस्व मे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213452, "chapter_id": 5558, "verse_number": "४", "content_sanskrit": "वनवासे च कौरव्यः कियन्तं कालमच्युतः ।\nयुधिष्ठिरो नरपतिर्न्यवसत्सजनस्तदा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213453, "chapter_id": 5558, "verse_number": "५", "content_sanskrit": "किमाहाराश्च ते तत्र ससैन्या न्यवसन् प्रभो ।\nसान्तःपुरा महात्मान एतदिच्छामि वेदितुम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213454, "chapter_id": 5558, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213455, "chapter_id": 5558, "verse_number": "६", "content_sanskrit": "वनवासगतं राजन् धृतराष्ट्रं महीपतिम् ।\nयुधिष्ठिरोऽभ्ययाद् द्रष्टुं ससैन्यो भ्रातृभिः सह\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213456, "chapter_id": 5558, "verse_number": "७", "content_sanskrit": "प्रथमे दिवसे चैषामापो मूलं फलं तथा ।\nभोजनं भूमिशय्या च तत्रासीद् भरतर्षभ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213457, "chapter_id": 5558, "verse_number": "८", "content_sanskrit": "तेऽनुज्ञातास्तदा राजन् कुरुराजेन पाण्डवाः ।\nविविधान्यन्नपानानि शय्याश्चैवाभजन् वने\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213458, "chapter_id": 5558, "verse_number": "९", "content_sanskrit": "मासमेकं विजह्रुस्ते ससैन्यान्तःपुरा वने ।\nअथ तत्रागमद् व्यासो यथोक्तं ते मयाऽनघ\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213459, "chapter_id": 5558, "verse_number": "१०", "content_sanskrit": "तथा च तेषां सर्वेषां कथाभिर्नृपसन्निधौ ।\nव्यासमन्वास्य तं राजन्नाजग्मुर्मुनयोऽपरे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213460, "chapter_id": 5558, "verse_number": "११", "content_sanskrit": "नारदः पर्वतश्चैव देवलश्च महातपाः ।\nविश्वावसुस्तुम्बुरुश्च चित्रसेनश्च भारत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213461, "chapter_id": 5558, "verse_number": "१२", "content_sanskrit": "तेषामपि यथान्यायं पूजां चक्रे महातपाः ।\nधृतराष्ट्राभ्यनुज्ञातः कुरुराजो युधिष्ठिरः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213462, "chapter_id": 5558, "verse_number": "१३", "content_sanskrit": "निषेदुस्ते ततः सर्वे पूजां प्राप्य युधिष्ठिरात् ।\nआसनेषु च पुण्येषु बर्हिष्केषु नवेषु च\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213463, "chapter_id": 5558, "verse_number": "१४", "content_sanskrit": "तेषु तत्रोपविष्टेषु स तु राजा महामतिः ।\nपाण्डुपुत्रैः परिवृतो निषसाद कुरूद्वह\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213464, "chapter_id": 5558, "verse_number": "१५", "content_sanskrit": "गान्धारी चैव कुन्ती च द्रौपदी सात्वती तथा ।\nस्त्रियश्चान्यास्तथाऽन्याभिः सहोपविविशुस्ततः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213465, "chapter_id": 5558, "verse_number": "१६", "content_sanskrit": "तेषां तत्र कथा दिव्या धर्मिष्ठाश्चाभवन्नृप ।\nराजर्षीणां पुराणानां देवासुरविमिश्रिताः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213466, "chapter_id": 5558, "verse_number": "१७", "content_sanskrit": "ततः कथान्ते व्यासस्तं प्रज्ञाचक्षुषमीश्वरम् ।\nप्रोवाच वदतां श्रेष्ठः पुनरेव स तद्वचः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213467, "chapter_id": 5558, "verse_number": "", "content_sanskrit": "(प्रीयमाणो महातेजाः सर्ववेदविदां वरः\t॥१८॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213468, "chapter_id": 5558, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213469, "chapter_id": 5558, "verse_number": "१९", "content_sanskrit": "विदितं मम राजेन्द्र यत्ते हृदि विवक्षितम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213470, "chapter_id": 5558, "verse_number": "२०", "content_sanskrit": "दह्यमानस्य शोकेन तव पुत्रकृतेन वै ।\nगान्धार्याश्चैव यद् दुःखं हृदि तिष्ठति नित्यदा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213471, "chapter_id": 5558, "verse_number": "२१", "content_sanskrit": "कुन्त्याश्च यन्महाराज द्रौपद्याश्च हृदि स्थितम् ।\nयच्च धारयते तीव्रं दुःखं पुत्रविनाशजम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213472, "chapter_id": 5558, "verse_number": "२२", "content_sanskrit": "सुभद्रा कृष्णभगिनी तच्चापि विदितं मम\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213473, "chapter_id": 5558, "verse_number": "२३", "content_sanskrit": "श्रुत्वा समागममिमं सर्वेषां वस्ततो नृप ।\nसंशयच्छेदनार्थाय प्राप्तः कौरवनन्दन\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2213474, "chapter_id": 5558, "verse_number": "२४", "content_sanskrit": "इमे च देवगन्धर्वाः सर्वे चेमे महर्षयः ।\nपश्यन्तु तपसो वीर्यमद्य मे चिरसम्भृतम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2213475, "chapter_id": 5558, "verse_number": "२५", "content_sanskrit": "तदुच्यतां महाप्राज्ञ कं कामं प्रददामि ते ।\nप्रवणोस्मि वरं दातुं पश्य मे तपसो बलम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2213476, "chapter_id": 5558, "verse_number": "२६", "content_sanskrit": "एवमुक्तः स राजेन्द्रो व्यासेनामितबुद्धिना ।\nमुहूर्तमिव सञ्चिन्त्य वचनायोपचक्रमे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2213477, "chapter_id": 5558, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2213478, "chapter_id": 5558, "verse_number": "२७", "content_sanskrit": "धन्योस्म्यनुगृहीतश्च सफलं जीवितं च मे ।\nयन्मे समागमोऽद्येह भवद्भिः सह साधुभिः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2213479, "chapter_id": 5558, "verse_number": "२८", "content_sanskrit": "अद्य चाप्यवगच्छामि गतिमिष्टामिहात्मनः ।\nब्रह्मकल्पैर्भवद्भिर्यत्समेतोऽहं तपोधनाः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2213480, "chapter_id": 5558, "verse_number": "२९", "content_sanskrit": "दर्शनादेव भवतां पूतोऽहं नात्र संशयः ।\nविद्यते न भयं चापि परलोके ममानघाः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2213481, "chapter_id": 5558, "verse_number": "३०", "content_sanskrit": "किन्तु तस्य सुदुर्बुद्धेर्मन्दस्यापनयैर्भृशम् ।\nदूयते मे मनो नित्यं स्मरतः पुत्रगृद्धिनः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2213482, "chapter_id": 5558, "verse_number": "३१", "content_sanskrit": "अपापाः पाण्डवा येन निकृताः पापबुद्धिना ।\nघातिता पृथिवी येन सहया सनरद्विपा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2213483, "chapter_id": 5558, "verse_number": "३२", "content_sanskrit": "राजानश्च महात्मानो नानाजनपदेश्वराः ।\nआगम्य मम पुत्रार्थे सर्वे मृत्युवशं गताः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2213484, "chapter_id": 5558, "verse_number": "३३", "content_sanskrit": "ये ते पितॄंश्च दारांश्च प्राणांश्च मनसः प्रियान् ।\nपरित्यज्य गताः शूराः प्रेतराजनिवेशनम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2213485, "chapter_id": 5558, "verse_number": "३४", "content_sanskrit": "का नु तेषां गतिर्ब्रह्मन् मित्रार्थे ये हता मृधे ।\nतथैव पुत्रपौत्राणां मम ये निहता युधि\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2213486, "chapter_id": 5558, "verse_number": "३५", "content_sanskrit": "दूयते मे मनोऽभीक्ष्णं घातयित्वा महाबलम् ।\nभीष्मं शान्तनवं वृद्धं द्रोणं च द्विजसत्तमम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2213487, "chapter_id": 5558, "verse_number": "३६", "content_sanskrit": "मम पुत्रेण मूढेन पापेनाकृतबुद्धिना ।\nक्षयं नीतं कुलं दीप्तं पृथिवीराज्यमिच्छता\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2213488, "chapter_id": 5558, "verse_number": "३७", "content_sanskrit": "(एते मदर्थे पुत्रांश्च दारांश्च मनसः प्रियान् ।\nभोगांश्च विविधांस्तात इष्टापूर्तांस्तथैव च\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2213489, "chapter_id": 5558, "verse_number": "", "content_sanskrit": "परित्यज्य गताः शूराः प्रेतराजनिवेशनम्\t॥३८॥)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2213490, "chapter_id": 5558, "verse_number": "३९", "content_sanskrit": "एतत्सर्वमनुस्मृत्य दह्यमानो दिवानिशम् ।\nन शान्तिमधिगच्छामि दुःखशोकसमाहतः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2213491, "chapter_id": 5558, "verse_number": "समाप्तिः", "content_sanskrit": "इति मे चिन्तयानस्य पितः शान्तिर्न विद्यते\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2213492, "chapter_id": 5558, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि\nधृतराष्ट्रस्य शोकवचनं नाम चतुस्त्रिंशोऽध्यायः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2213493, "chapter_id": 5558, "verse_number": "", "content_sanskrit": "पुत्रदर्शनपर्वणि प्रथमोऽध्यायः ॥१॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]