[{"id": 7002149000, "chapter_id": 22149, "verse_number": "१९४-१", "content_sanskrit": "अग्निरुवाच ।\nअशोकपूर्णिमां वक्ष्ये भूधरं च भुवं यजेत् ।\nफाल्गुन्यां सितपक्षायां वर्षं स्याद्भुक्तिमुक्तिभाक् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002149001, "chapter_id": 22149, "verse_number": "१९४-२", "content_sanskrit": "कार्त्तिक्यान्तु वृषोत्सर्गं कृत्वा नक्तं समाचरेत् ।\nशैवं पदमवाप्नोति वृषव्रतमिदं परं ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002149002, "chapter_id": 22149, "verse_number": "१९४-३", "content_sanskrit": "पित्र्या यामावसी तस्यां पितॄणां दत्तमक्षयं ।\nउपोष्याब्दं पितॄनिष्ट्वा निष्पापः स्वर्गमाप्नुयात् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002149003, "chapter_id": 22149, "verse_number": "१९४-४", "content_sanskrit": "पञ्चदश्यां च माघस्य पूज्याजं सर्वमाप्नुयात् ।\nवक्ष्ये सावित्र्यमावास्याम्भुक्तिमुक्तिकरीं शुभां ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002149004, "chapter_id": 22149, "verse_number": "१९४-५", "content_sanskrit": "पञ्चदश्यां व्रती ज्यैष्ठे वटमूले महासतीं ।\nत्रिरात्रोपोषिता नारी सप्तधान्यैः प्रपूजयेत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002149005, "chapter_id": 22149, "verse_number": "१९४-६", "content_sanskrit": "प्ररूढैः कण्ठसूत्रैश्च रजन्यां कुङ्कुमादिभिः ।\nवटावलम्बनं कृत्वा नृत्यगीतैः प्रभातके ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002149006, "chapter_id": 22149, "verse_number": "१९४-७", "content_sanskrit": "नमः सावित्र्यै सत्यवते नैवेद्यं चार्पयेद्द्विजे ।\nवेश्म गत्वा द्विजान् भोज्य स्वयं भुक्त्वा विसर्जयेत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002149007, "chapter_id": 22149, "verse_number": "१९४-८", "content_sanskrit": "सावित्री प्रीयतां देवी सौभाग्यादिकमाप्नुयात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}]