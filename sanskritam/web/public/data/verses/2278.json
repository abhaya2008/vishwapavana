[{"id": 2059720, "chapter_id": 2278, "verse_number": "८-१-०x", "content_sanskrit": "श्रीकृष्णाय नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2059721, "chapter_id": 2278, "verse_number": "८-१-१", "content_sanskrit": "[नारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं चैव ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2059722, "chapter_id": 2278, "verse_number": "८-१-२x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2059723, "chapter_id": 2278, "verse_number": "८-१-२", "content_sanskrit": "ततो द्रोणे हते राजन्दुर्योधनमुखा नृपाः।\nभृशमुद्विग्नमनसो द्रोणपुत्रमुपागमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2059724, "chapter_id": 2278, "verse_number": "८-१-३", "content_sanskrit": "ते द्रोणमनुशोचन्तः कश्मलाभिहतौजसः।\nपर्युपासन्त शोकार्तास्ततः शारद्वतीसुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2059725, "chapter_id": 2278, "verse_number": "८-१-४", "content_sanskrit": "ते मुहूर्तं समाश्वस्य हेतुभिः शास्त्रसम्मितैः।\nरात्र्यागमे महीपालाः स्वानि वेश्मानि भेजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2059726, "chapter_id": 2278, "verse_number": "८-१-५", "content_sanskrit": "ते वेश्मस्वपि कौरव्य पृथ्वीशा नाप्नुवन्सुखम्।\nचिन्तयन्तः क्षयं तीव्रं दुःखशोकसमन्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2059727, "chapter_id": 2278, "verse_number": "८-१-६", "content_sanskrit": "विशेषतः सूतपुत्रो राजा चैव सुयोधनः।\nदुःशासनश्च शकुनिः सौबलश्च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2059728, "chapter_id": 2278, "verse_number": "८-१-७", "content_sanskrit": "उषितास्ते निशां तां तु दुर्योधननिवेशने।\nचिन्तयन्तः परिक्लेशान्पाण्डवानां महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2059729, "chapter_id": 2278, "verse_number": "८-१-८", "content_sanskrit": "यत्तद्द्यूते परिक्लिष्टा कृष्णा चानायिता सभाम्।\nतत्स्मरन्तोऽनुशोचन्तो भृशमुद्विग्नचतेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2059730, "chapter_id": 2278, "verse_number": "८-१-९", "content_sanskrit": "तथा तु सञ्चिन्तयतां तान्क्लेशान्द्यूतकारितान्।\nदुःखेन क्षणदा राजञ्जगामाब्दशतोपमा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2059731, "chapter_id": 2278, "verse_number": "८-१-१०", "content_sanskrit": "ततः प्रभाते विमले स्थिता दिष्टस्य शासने।\nचक्रुरावश्यकं सर्वे विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2059732, "chapter_id": 2278, "verse_number": "८-१-११", "content_sanskrit": "ते कृत्वाऽवश्यकार्याणि समाश्वस्य च भारत।\nयोगमाज्ञापयामासुर्युद्वाय च विनिर्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2059733, "chapter_id": 2278, "verse_number": "८-१-१२", "content_sanskrit": "कर्णं सेनापतिं कृत्वा कृतकौतुकमङ्गलाः।\nपूजयित्वा द्विजश्रेष्ठान्दधिपात्रघृताक्षतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2059734, "chapter_id": 2278, "verse_number": "८-१-१३", "content_sanskrit": "गोभिरश्वैश्च निष्कैश्च वासोभिश्च महाधनैः।\nवन्द्यमाना जयाशीर्भिः सूतमागधबन्दिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2059735, "chapter_id": 2278, "verse_number": "८-१-१४", "content_sanskrit": "तथैव पाण्डवा राजन्कृतपूर्वाह्णिकक्रियाः।\nशिबिरान्निर्ययुस्तूर्णं युद्वाय कृतनिश्चयाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2059736, "chapter_id": 2278, "verse_number": "८-१-१५", "content_sanskrit": "ततः प्रववृते युद्वं तुमुलं रोमहर्षणम्।\nकुरूणां पाण्डवानां च परस्परजयैषिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2059737, "chapter_id": 2278, "verse_number": "८-१-१६", "content_sanskrit": "तयोर्द्वौ दिवसौ युद्वं कुरुपाण्डवसेनयोः।\nकर्णे सेनापतौ राजन्बभूवाद्भुतदर्शनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2059738, "chapter_id": 2278, "verse_number": "८-१-१७", "content_sanskrit": "ततः शत्रुक्षयं कृत्वा सुमहान्तं रणे वृषः।\nपश्यतां धार्तराष्ट्राणां फल्गुनेन निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2059739, "chapter_id": 2278, "verse_number": "८-१-१८", "content_sanskrit": "ततस्तु सञ्जयः सर्वं गत्वा नागपुरं द्रुतम्।\nआचष्ट धृतराष्ट्राय यद्वृत्तं कुरुजाङ्गले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2059740, "chapter_id": 2278, "verse_number": "८-१-१९x", "content_sanskrit": "जनमयेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2059741, "chapter_id": 2278, "verse_number": "८-१-१९", "content_sanskrit": "आपगेयं हतं श्रुत्वा द्रोणं चापि महारथम्।\nआजगाम परामार्तिं वृद्वो राजाऽम्बिकासुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2059742, "chapter_id": 2278, "verse_number": "८-१-२०", "content_sanskrit": "स श्रुत्वा निहतं कर्णं दुर्योधनहितैषिणम्।\nकथं द्विजवर प्राणानधारयत दुःखितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2059743, "chapter_id": 2278, "verse_number": "८-१-२१", "content_sanskrit": "यस्मिञ्जयाशां पुत्राणां सममन्यत पार्थिवः।\nतस्मिन्हते स कौरव्यः कथं प्राणानधारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2059744, "chapter_id": 2278, "verse_number": "८-१-२२", "content_sanskrit": "दुर्मरं तदहं मन्ये नृणां कृच्छ्रेऽपि वर्तताम्।\nयत्र कर्णं हतं श्रुत्वा नात्यजज्जीवितं नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2059745, "chapter_id": 2278, "verse_number": "८-१-२३", "content_sanskrit": "तथा शान्तनवं वृद्वं ब्रह्मन्बाह्लीकमेव च।\nद्रोणं च सोमदत्तं च भूरिश्रवसमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2059746, "chapter_id": 2278, "verse_number": "८-१-२४", "content_sanskrit": "तथैव चान्यान्सुहृदः पुत्रान्पौत्रांश्च पातितान्।\nश्रुत्वा यन्नाजहात्प्राणांस्तन्मन्ये दुष्करं द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2059747, "chapter_id": 2278, "verse_number": "८-१-२५", "content_sanskrit": "एतन्मे सर्वमाचक्ष्व विस्तरेण महामुने।\nन हि तृप्यामि पूर्वेषां शृण्वानश्चरितं महत्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2059748, "chapter_id": 2278, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि षोडशदिवसयुद्धारम्भे प्रथमोऽध्यायः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]