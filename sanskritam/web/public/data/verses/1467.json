[{"id": 2022298, "chapter_id": 1467, "verse_number": "३-१०५-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022299, "chapter_id": 1467, "verse_number": "३-१०५-१", "content_sanskrit": "तानुवाच समेतांस्तु ब्रह्मा लोकपितामहः।\n`निर्ह्रादिन्या गिरा राजन्देवानाश्वासयंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022300, "chapter_id": 1467, "verse_number": "३-१०५-२", "content_sanskrit": "गच्छध्वं विबुधाः सर्वे यथाकामं यथेप्सितम्।\nमहता कालयोगेन प्रकृतिं यास्यतेऽर्णवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022301, "chapter_id": 1467, "verse_number": "३-१०५-३", "content_sanskrit": "ज्ञातींश्च कारणं कृत्वा महाराजो भगीथः।\n`पूरयिष्यति तोयौघैः समुद्रं निधिमम्भसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022302, "chapter_id": 1467, "verse_number": "३-१०५-४", "content_sanskrit": "पितामहवचः श्रुत्वा सर्वे विबुधसत्तमाः।\nकालयोगं प्रतीक्षन्तो जग्मुश्चापि यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022303, "chapter_id": 1467, "verse_number": "३-१०५-५x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022304, "chapter_id": 1467, "verse_number": "३-१०५-५", "content_sanskrit": "कथं वै ज्ञातयोब्रह्मन्कारणं चात्र किं मुने।\nकथं समुद्रः पूर्णश्च भगीरथपरिश्रमात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022305, "chapter_id": 1467, "verse_number": "३-१०५-६", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं विस्तरेण तपोधन।\nकथ्यमानं त्वया विप्र राज्ञां चरितमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022306, "chapter_id": 1467, "verse_number": "३-१०५-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022307, "chapter_id": 1467, "verse_number": "३-१०५-७", "content_sanskrit": "एवमुक्तस्तु विप्रेन्द्रो धर्मराज्ञा महात्मना।\nकथयामास माहात्म्यं सगरस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022308, "chapter_id": 1467, "verse_number": "३-१०५-८x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022309, "chapter_id": 1467, "verse_number": "३-१०५-८", "content_sanskrit": "इक्ष्वाकूणां कुले जातः सगरो नाम पार्थिवः।\nरूपसत्वबलोपेतः स चापुत्रः प्रतापवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022310, "chapter_id": 1467, "verse_number": "३-१०५-९", "content_sanskrit": "स हैहयान्समुत्साद्य तालजङ्घांश्च भारत।\nवशे च कृत्वा राजन्यान्स्वराज्यमनुशिष्टवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022311, "chapter_id": 1467, "verse_number": "३-१०५-१०", "content_sanskrit": "तस्य भार्ये त्वभवतां रूपयौवनदर्पिते।\nवैदर्भी भरतश्रेष्ठ शैव्या च भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022312, "chapter_id": 1467, "verse_number": "३-१०५-११", "content_sanskrit": "सपुत्रकामो नृपतिस्तप्यते स्म महत्तपः।\nपत्नीभ्यां सह राजेन्द्र कैलासं गिरिमाश्रितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022313, "chapter_id": 1467, "verse_number": "३-१०५-१२", "content_sanskrit": "स तप्यमानः सुमहत्तपोयोगसमन्वितः।\nआससाद महात्मानं त्र्यक्षं त्रिपुरमर्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022314, "chapter_id": 1467, "verse_number": "३-१०५-१३", "content_sanskrit": "शंकरं भवमीशानं पिनाकिं शूलपाणिनम्।\nत्र्यम्बकं शिवमुग्रेशं बहुरूपमुमापतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022315, "chapter_id": 1467, "verse_number": "३-१०५-१४", "content_sanskrit": "स तं दृष्ट्वैव वरदं पत्नीभ्यां सहितो नृपः।\nप्रणिपत्य महाबाहुः पुत्रार्थे समयाचत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022316, "chapter_id": 1467, "verse_number": "३-१०५-१५", "content_sanskrit": "तं प्रीतिमान्हरः प्राह सभार्यं नृपसत्तमम्।\nयस्मिन्वृतो मुहूर्तेऽहं त्वयेह नृपते वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022317, "chapter_id": 1467, "verse_number": "३-१०५-१६", "content_sanskrit": "षष्टिः पुत्रसहस्राणि शूराः परमदर्पिताः।\nएकस्यां संभविष्यन्ति पत्न्यां नरवरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022318, "chapter_id": 1467, "verse_number": "३-१०५-१७", "content_sanskrit": "ते चैवसर्वे सहिताः क्षयं यास्यन्ति पार्थिव।\nएको वंशधरः शूर एकस्यां संभविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022319, "chapter_id": 1467, "verse_number": "३-१०५-१८", "content_sanskrit": "एवमुक्त्वा तु तं रुद्रस्तत्रैवान्तरधीयत।\nस चापि सगरो राजा जगाम स्वं निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022320, "chapter_id": 1467, "verse_number": "३-१०५-१९", "content_sanskrit": "पत्नीभ्यां सहितस्तत्र होऽतिहृष्टमनास्तदा।\n`कालं शंभुवरप्राप्तं प्रतीक्षन्सगरोऽनयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022321, "chapter_id": 1467, "verse_number": "३-१०५-२०", "content_sanskrit": "तस्य तेमनुजश्रेष्ठ भार्ये कललोचने।\nवैदर्भी चैव शैब्या च गर्भिण्यौ संबभूवतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022322, "chapter_id": 1467, "verse_number": "३-१०५-२१", "content_sanskrit": "ततः कालेन वैदर्भी गर्भालाबुं व्यजायत।\nशैव्या च सुषुवे पुत्रं कुमारं देवरूपिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022323, "chapter_id": 1467, "verse_number": "३-१०५-२२", "content_sanskrit": "तदाऽलाबुं समुत्स्रष्टुं मनश्चक्रे स पार्थिवः।\nअथान्तरिक्षाच्छुश्राव वाचं गंभीरनिःस्वनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022324, "chapter_id": 1467, "verse_number": "३-१०५-२३", "content_sanskrit": "राजन्मा साहसंकार्षीः पुत्रान्न त्यक्तुमर्हसि।\nअलाबुमध्यान्निष्कृष्य वीजं यत्नेन गोप्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022325, "chapter_id": 1467, "verse_number": "३-१०५-२४", "content_sanskrit": "सोपस्वेदेषु पात्रेषु घृतपूर्णेषु भागशः।\nततः पुत्रसहस्राणि षष्टिं प्राप्स्यसि पार्थिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022326, "chapter_id": 1467, "verse_number": "३-१०५-२५", "content_sanskrit": "महादेवेन दिष्टं ते पुत्रजन्म नराधिप।\nअनेन क्रमयोगेन मा ते बुद्धिरतोऽन्यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022327, "chapter_id": 1467, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि पञ्चाधिकशततमोऽध्यायः ॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]