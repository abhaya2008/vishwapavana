[{"id": 2146153, "chapter_id": 4151, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2146154, "chapter_id": 4151, "verse_number": "१", "content_sanskrit": "कथं प्रयातो दाशार्हो महात्मा मधुसूदनः ।\nकानि वा व्रजतस्तस्य निमित्तानि महौजसः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2146155, "chapter_id": 4151, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2146156, "chapter_id": 4151, "verse_number": "२", "content_sanskrit": "तस्य प्रयातो यान्यासन् निमित्तानि महात्मनः ।\nतानि मे शृणु दिव्यानि दैवान्यौत्पातिकानि च\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2146157, "chapter_id": 4151, "verse_number": "३", "content_sanskrit": "अनभ्रेऽशनिनिर्घोषः सविद्युत् समजायत ।\nअन्वगेव च पर्जन्यः प्रावर्षद् विघने भृशम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2146158, "chapter_id": 4151, "verse_number": "४", "content_sanskrit": "प्रत्यगूहुर्महानद्यः प्राङ्मुखाः सिन्धुसत्तमाः ।\nविपरीता दिशः सर्वा न प्राज्ञायत किञ्चन\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2146159, "chapter_id": 4151, "verse_number": "५", "content_sanskrit": "प्राज्वलन् नाग्नयो राजन् पृथिवी समकम्पत ।\nउदपानाश्च कुम्भाश्च प्रासिञ्चन् शतशो जलम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2146160, "chapter_id": 4151, "verse_number": "६", "content_sanskrit": "तमःसंवृतमप्यासीत् सर्वं जगदिदं तदा ।\nन दिशो विदिशो राजन् प्रज्ञायन्ते स्म रेणुना\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2146161, "chapter_id": 4151, "verse_number": "७", "content_sanskrit": "प्रादुरासीन्महान् शब्दः खे शरीरमदृश्यत ।\nसर्वेषु राजन् देशेषु तदद्भुतमिवाभवत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2146162, "chapter_id": 4151, "verse_number": "८", "content_sanskrit": "प्रामथ्नाद् हस्तिनपुरं वातो दक्षिणपश्चिमः ।\nआरुजन् गणशो वृक्षान् परुषो भीमनिस्वनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2146163, "chapter_id": 4151, "verse_number": "९", "content_sanskrit": "यत्र यत्र च वार्ष्णेयो वर्तते पथि भारत ।\nतत्र तत्र सुखो वायुः सर्वं चासीत् प्रदक्षिणम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2146164, "chapter_id": 4151, "verse_number": "१०", "content_sanskrit": "ववर्ष पुष्पवर्षं च कमलानि च भूरिशः ।\nसमश्च पन्था निर्दुःखो व्यपेतकुशकण्टकः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2146165, "chapter_id": 4151, "verse_number": "११", "content_sanskrit": "सञ्च्छन्नो ब्राह्मणैः राजन् तत्र तत्र महाभुजः ।\nअर्च्यते मधुपर्कैश्च वसुभिश्च वसुप्रदः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2146166, "chapter_id": 4151, "verse_number": "१२", "content_sanskrit": "तं किरन्ति महात्मानं वन्यैः पुष्पैः सुगन्धिभिः ।\nस्त्रियः पथि समागम्य सर्वभूतहिते रतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2146167, "chapter_id": 4151, "verse_number": "१३", "content_sanskrit": "स शालिभवनं रम्यं सर्वसस्यसमाचितम् ।\nसुखं परमधर्मिष्ठमत्यगान्मधुसूदनः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2146168, "chapter_id": 4151, "verse_number": "१४", "content_sanskrit": "पश्यन् बहुपशून् ग्रामान् रम्यान् हृदयतोषणान् ।\nपुराणि व्यतिचक्राम राष्ट्राणि नगराणि च\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2146169, "chapter_id": 4151, "verse_number": "१५", "content_sanskrit": "नित्यं हृष्टाः सुमनसो भारतैरभिरक्षिताः ।\nनोद्विग्नाः परचक्रेभ्यो ह्यनयानामकोविदाः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2146170, "chapter_id": 4151, "verse_number": "१६", "content_sanskrit": "उपप्लाव्यादथागम्य जनाः पुरनिवासिनः ।\nपथ्यतिष्ठन्त सहिता विष्वक्सेनदिदृक्षया\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2146171, "chapter_id": 4151, "verse_number": "१७", "content_sanskrit": "ते तु सर्वे सुनामानमग्निमिद्धमिव प्रभुम् ।\nअर्चयामासुरर्चार्हं देशातिथिमुपस्थितम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2146172, "chapter_id": 4151, "verse_number": "१८", "content_sanskrit": "कुशस्थलं समासाद्य केशवः परवीरहा ।\nप्रकीर्णरश्मावादित्ये विमले लोहितायति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2146173, "chapter_id": 4151, "verse_number": "१९", "content_sanskrit": "अवतीर्य रथात् तूर्णं कृत्वा शौचं यथाविधि ।\nरथमोचनमादिश्य सन्ध्यामुपविवेश ह\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2146174, "chapter_id": 4151, "verse_number": "२०", "content_sanskrit": "दारुकोऽपि हयान् मुक्त्वा परिवार्य च शास्त्रतः ।\nमुमोच सर्ववर्माणि मुक्त्वा चैतानवासृजत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2146175, "chapter_id": 4151, "verse_number": "२१", "content_sanskrit": "अभ्यतीत्य तु तत् सर्वमुवाच मधुसूदनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2146176, "chapter_id": 4151, "verse_number": "२२", "content_sanskrit": "युधिष्ठिरस्य कार्यार्थमिह वत्स्यामहे वयम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2146177, "chapter_id": 4151, "verse_number": "२३", "content_sanskrit": "तस्य तन्मतमाज्ञाय चक्रुरावसथं नराः ।\nक्षणेन चान्नपानानि रसवन्ति समार्जयन्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2146178, "chapter_id": 4151, "verse_number": "२४", "content_sanskrit": "तस्मिन् ग्रामे प्रधानास्तु य आसन् ब्राह्मणा नृप ।\nआर्याः कुलीना ह्रीमन्तो ब्राह्मीं वृत्तिमनुष्ठिताः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2146179, "chapter_id": 4151, "verse_number": "२५", "content_sanskrit": "तेऽभिगम्य महात्मानं हृषीकेशमरिन्दमम् ।\nपूजां चक्रुर्यथान्यायमाशीर्मङ्गलसंयुतम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2146180, "chapter_id": 4151, "verse_number": "२६", "content_sanskrit": "ते पूजयित्वा दाशार्हं सर्वलोकेषु पूजितम् ।\nन्यवेदयन्त वेश्मानि गुणवन्ति महान्ति च\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2146181, "chapter_id": 4151, "verse_number": "२७", "content_sanskrit": "तान् प्रभुः कृतमित्युक्त्वा सत्कृत्य च यथार्हतः ।\nअभ्येत्य चैषां वेश्मानि पुनरायात् सहैव तैः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2146182, "chapter_id": 4151, "verse_number": "२८", "content_sanskrit": "सुमृष्टं भोजयित्वा च ब्राह्मणांस्तत्र केशवः ।\nभुक्त्वा च सह तैः सर्वैरवसत् तां क्षपां सुखम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2146183, "chapter_id": 4151, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि द्व्यशीतितमोऽध्यायः ॥८२॥\nभगवद्यानपर्वणि त्रयोदशोऽध्यायः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]