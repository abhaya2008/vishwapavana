[{"id": 2145139, "chapter_id": 4126, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2145140, "chapter_id": 4126, "verse_number": "१", "content_sanskrit": "न भेतव्यं महाराज न शोच्या भवता वयम् ।\nसमर्थाः स्म परान् जेतुं बलिनः समरे विभो\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2145141, "chapter_id": 4126, "verse_number": "२", "content_sanskrit": "वने प्रव्राजितान् पार्थान् यदायान्मधुसूदनः ।\nमहता बलचक्रेण परराष्ट्रावमर्दिना\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2145142, "chapter_id": 4126, "verse_number": "३", "content_sanskrit": "केकया धृष्टकेतुश्च धृष्टद्युम्नश्च पार्षतः ।\nराजानश्चान्वयुः पार्थान् बहवोऽन्येऽनुयायिनः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2145143, "chapter_id": 4126, "verse_number": "४", "content_sanskrit": "इन्द्रप्रस्थश्च(स्य) चादूरात् समाजग्मुर्महारथाः ।\nव्यगर्हयंश्च सङ्गम्य भवन्तं कुरुभिः सह\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2145144, "chapter_id": 4126, "verse_number": "५", "content_sanskrit": "ते युधिष्ठिरमासीनमजिनैः परिवारितम् ।\nकृष्णप्रधानाः संहत्य पर्युपासत भारत\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2145145, "chapter_id": 4126, "verse_number": "६", "content_sanskrit": "प्रत्यादानं च राज्यस्य कार्यमूचुर्नराधिपाः ।\nभवतः सानुबन्धस्य समुच्छेदं चिकीर्षवः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2145146, "chapter_id": 4126, "verse_number": "७", "content_sanskrit": "श्रुत्वा चैतन्मयोक्तास्तु भीष्मद्रोणकृपास्तथा ।\nज्ञातिक्षयभयाद् राजन् भीतेन भरतर्षभ\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2145147, "chapter_id": 4126, "verse_number": "८", "content_sanskrit": "न च स्थास्यन्ति समये पाण्डवा इति मे मतिः ।\nसमुच्छेदं हि नः कृत्स्नं वासुदेवश्चिकीर्षति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2145148, "chapter_id": 4126, "verse_number": "९", "content_sanskrit": "ऋते च विदुरात् सर्वे यूयं वध्या मता मम ।\nधृतराष्ट्रस्तु धर्मज्ञो न वध्यः कुरुसत्तमः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2145149, "chapter_id": 4126, "verse_number": "१०", "content_sanskrit": "समुच्छेदं च कृत्स्नं नः कृत्वा तात जनार्दनः ।\nएकराज्यं कुरूणां स्म चिकीर्षति युधिष्ठिरे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2145150, "chapter_id": 4126, "verse_number": "११", "content_sanskrit": "तत्र किं प्राप्तकालं नः प्रणिपातः पलायनम् ।\nप्राणान् वा सम्परित्यज्य प्रतियुध्यामहे परान्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2145151, "chapter_id": 4126, "verse_number": "१२", "content_sanskrit": "प्रतियुद्धे तु नियतः स्यादस्माकं पराजयः ।\nयुधिष्ठिरस्य सर्वे हि पार्थिवा वशवर्तिनः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2145152, "chapter_id": 4126, "verse_number": "१३", "content_sanskrit": "विरक्तराष्ट्राश्च वयं मित्राणि कुपितानि नः ।\nधिक्कृताः पार्थिवैः सर्वैः स्वजनेन च सर्वशः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2145153, "chapter_id": 4126, "verse_number": "१४", "content_sanskrit": "प्रणिपाते न दोषोऽस्ति सन्धिर्नः शाश्वतीः समाः ।\nपितरं त्वेव शोचामि प्रज्ञानेत्रं जनाधिपम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2145154, "chapter_id": 4126, "verse_number": "१५", "content_sanskrit": "मत्कृते दुःखमापन्नं क्लेशं प्राप्तमनुत्तमम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2145155, "chapter_id": 4126, "verse_number": "१६", "content_sanskrit": "कृतं हि तव पुत्रैश्च परेषामवरोधनम् ।\nमत्प्रियार्थं पुरैवैतद् विदितं ते नरोत्तम\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2145156, "chapter_id": 4126, "verse_number": "१७", "content_sanskrit": "ते राज्ञो धृतराष्ट्रस्य सामात्यस्य महारथाः ।\nवैरं प्रतिकरिष्यन्ति कुलोच्छेदेन पाण्डवाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2145157, "chapter_id": 4126, "verse_number": "१८", "content_sanskrit": "ततो द्रोणोऽब्रवीद् भीष्मः कृपो द्रौणिश्च भारत ।\nमत्वा मां महतीं चिन्तामास्थितं व्यथितेन्द्रियम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2145158, "chapter_id": 4126, "verse_number": "१९", "content_sanskrit": "अभिदुग्धाः परे चेन्नो न भेतव्यं परन्तप ।\nअसमर्थाः परे जेतुमस्मान् युधि समास्थितान्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2145159, "chapter_id": 4126, "verse_number": "२०", "content_sanskrit": "एकैकशः समर्थाः स्मो विजेतुं सर्वपार्थिवान् ।\nआगच्छन्तु विनेष्यामो दर्पमेषां शितैः शरैः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2145160, "chapter_id": 4126, "verse_number": "२१", "content_sanskrit": "पुरैकेन हि भीष्मेण विजिताः सर्वपार्थिवाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2145161, "chapter_id": 4126, "verse_number": "२२", "content_sanskrit": "मृते पितर्यतिक्रुद्धो रथेनैकेन भारत ।\nजघान सुबहूंस्तेषां संरब्धः कुरुसत्तमः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2145162, "chapter_id": 4126, "verse_number": "२३", "content_sanskrit": "ततस्ते शरणं जग्मुर्देवव्रतमिमं भयात्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2145163, "chapter_id": 4126, "verse_number": "२४", "content_sanskrit": "स भीष्मः सुसमर्थोऽयमस्माभिः सहितो रणे ।\nपरान् विजेतुं तस्मात् ते व्येतु भीर्भरतर्षभ\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2145164, "chapter_id": 4126, "verse_number": "२५", "content_sanskrit": "इत्येषां निश्चयो ह्यासीत् तत्कालेऽमिततेजसाम् ।\nपुरा परेषां पृथिवी कृत्स्नाऽऽसीद् वशवर्तिनी\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2145165, "chapter_id": 4126, "verse_number": "२६", "content_sanskrit": "अस्मान् पुनरमी नाद्य समर्था जेतुमाहवे ।\nछिन्नपक्षाः परे ह्यद्य वीर्यहीनाश्च पाण्डवाः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2145166, "chapter_id": 4126, "verse_number": "२७", "content_sanskrit": "अस्मत्संस्था च पृथिवी वर्तते भरतर्षभ ।\nएकार्थाः सुखदुःखेषु समानीताश्च पार्थिवाः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2145167, "chapter_id": 4126, "verse_number": "२८", "content_sanskrit": "अप्यग्निं प्रविशेयुस्ते समुद्रं वा परन्तप ।\nमदर्थं पार्थिवाः सर्वे तद् विद्धि कुरुसत्तम\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2145168, "chapter_id": 4126, "verse_number": "२९", "content_sanskrit": "उन्मत्तमिव चापि त्वां प्रहसन्तीह दुःखितम् ।\nविलपन्तं बहुविधं भीतं परविकत्थने\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2145169, "chapter_id": 4126, "verse_number": "३०", "content_sanskrit": "एषां ह्येकैकशो राज्ञां समर्थः पाण्डवान् प्रति ।\nआत्मानं मन्यते सर्वो व्येतु ते भयमागतम्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2145170, "chapter_id": 4126, "verse_number": "३१", "content_sanskrit": "जेतुं समग्रां सेनां मे वासवोऽपि न शक्नुयात् ।\nहन्तुमक्षय्यरूपेयं ब्रह्मणोऽपि स्वयम्भुवः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2145171, "chapter_id": 4126, "verse_number": "३२", "content_sanskrit": "युधिष्ठिरः पुरं हित्वा पञ्च ग्रामान् प्रयाचते ।\nभीतो हि मामकात् सैन्यात् प्रभावाच्चैव मे विभो\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2145172, "chapter_id": 4126, "verse_number": "३३", "content_sanskrit": "समर्थं मन्यसे यच्च कुन्तीपुत्रं वृकोदरम् ।\nतन्मिथ्या न हि मे कृत्स्नं प्रभावं वेत्सि भारत\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2145173, "chapter_id": 4126, "verse_number": "३४", "content_sanskrit": "मत्समो हि गदायुद्धे पृथिव्यां नास्ति कश्चन ।\nनासीत् कश्चिदतिक्रान्तो भविता न च कश्चन\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2145174, "chapter_id": 4126, "verse_number": "३५", "content_sanskrit": "युक्तो दुःखोषितश्चाहं विद्यापारगतस्तथा ।\nतस्मान्न भीमान्नान्येभ्यो भयं मे विद्यते क्वचित्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2145175, "chapter_id": 4126, "verse_number": "३६", "content_sanskrit": "दुर्योधनसमो नास्ति गदायामिति निश्चयः ।\nसङ्कर्षणस्य भवने यत्तदैनमुपावसम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2145176, "chapter_id": 4126, "verse_number": "३७", "content_sanskrit": "युद्धे सङ्कर्षणसमो बले नास्त्यधिको भुवि ।\nगदाप्रहारं भीमो मे न जातु विषहेद् युधि\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2145177, "chapter_id": 4126, "verse_number": "३८", "content_sanskrit": "एकं प्रहारं यं दद्यां भीमाय रुषितो नृप ।\nस एवैनं नयेद् घोरः क्षिप्रं वैवस्वतक्षयम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2145178, "chapter_id": 4126, "verse_number": "३९", "content_sanskrit": "इच्छेयं च गदाहस्तं राजन् द्रष्टुं वृकोदरम् ।\nसुचिरं प्रार्थितो ह्येष मम नित्यं मनोरथः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2145179, "chapter_id": 4126, "verse_number": "४०", "content_sanskrit": "गदया निहतो ह्याजौ मया पार्थो वृकोदरः ।\nविशीर्णगात्रः पृथिवीं परासुः प्रपतिष्यति\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2145180, "chapter_id": 4126, "verse_number": "४१", "content_sanskrit": "गदाप्रहाराभिहतो हिमवानपि पर्वतः ।\nसकृन्मया विदीर्येत गिरिः शतसहस्रधा\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2145181, "chapter_id": 4126, "verse_number": "४२", "content_sanskrit": "स चाप्येतद् विजानाति वासुदेवार्जुनौ तथा ।\nदुर्योधनसमो नास्ति गदायामिति निश्चयः\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2145182, "chapter_id": 4126, "verse_number": "४३", "content_sanskrit": "तत् ते वृकोदरमयं भयं व्येतु महाहवे ।\nव्यपनेष्याम्यहं ह्येनं मा राजन् विमना भव\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2145183, "chapter_id": 4126, "verse_number": "४४", "content_sanskrit": "तस्मिन् मया हते क्षिप्रमर्जुनं बहवो रथाः ।\nतुल्यरूपा विशिष्टाश्च क्षेप्स्यन्ति भरतर्षभ\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2145184, "chapter_id": 4126, "verse_number": "४५", "content_sanskrit": "भीष्मो द्रोणः कृपो द्रौणिः कर्णो भूरिश्रवास्तथा ।\nप्राग्ज्योतिषाधिपः शल्यः सिन्धुराजो जयद्रथः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2145185, "chapter_id": 4126, "verse_number": "४६", "content_sanskrit": "एकैक एषां शक्तस्तु हन्तुं भारत पाण्डवान् ।\nसमेतास्तु क्षणेनैतान् नेष्यन्ति यमसादनम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2145186, "chapter_id": 4126, "verse_number": "४७", "content_sanskrit": "समग्रा पार्थिवी सेना पार्थिवानां धनञ्जयम् ।\nकस्मादशक्ता निर्जेतुमिति हेतुर्न विद्यते\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2145187, "chapter_id": 4126, "verse_number": "४८", "content_sanskrit": "शरव्रातैस्तु भीष्मेण शतशोऽथ सहस्रशः ।\nद्रोणद्रौणिकृपैश्चैव गन्ता पार्थो यमक्षयम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2145188, "chapter_id": 4126, "verse_number": "४९", "content_sanskrit": "पितामहोऽपि गाङ्गेयः शन्तनो रथिनां वरः ।\nब्रह्मर्षिसदृशो जज्ञे देवैरपि सुदुःसहः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2145189, "chapter_id": 4126, "verse_number": "५०", "content_sanskrit": "न हन्ता विद्यते चापि राजन् भीष्मस्य कश्चन ।\nपित्राऽप्युक्तः प्रसन्नेन नाकामस्त्वं मरिष्यसि\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2145190, "chapter_id": 4126, "verse_number": "५१", "content_sanskrit": "ब्रह्मर्षेश्च भरद्वाजाद् द्रोणो द्रोण्यामजायत ।\nद्रोणाज्जज्ञे महाराज द्रौणिश्च परमास्त्रवित्\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2145191, "chapter_id": 4126, "verse_number": "५२", "content_sanskrit": "कृपश्चाचार्यमुख्योऽयं महर्षेर्गौतमादपि ।\nशरस्तम्बोद्भवः श्रीमानवध्य इति मे मतिः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2145192, "chapter_id": 4126, "verse_number": "५३", "content_sanskrit": "अयोनिजास्त्रयो ह्येते पिता माता च मातुलः\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2145193, "chapter_id": 4126, "verse_number": "५४", "content_sanskrit": "अश्वत्थामा महाराज स च शूरःस्थितो मम\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2145194, "chapter_id": 4126, "verse_number": "५५", "content_sanskrit": "सर्व एते महाराज देवकल्पा महारथाः ।\nशक्रस्यापि व्यथां कुर्युः संयुगे भरतर्षभ\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2145195, "chapter_id": 4126, "verse_number": "५६", "content_sanskrit": "नैतेषामर्जुनः शक्त एकैकं प्रतिवीक्षितुम् ।\nसहितास्तु नरव्याघ्रा हनिष्यन्ति धनञ्जयम्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2145196, "chapter_id": 4126, "verse_number": "५७", "content_sanskrit": "भीष्मद्रोणकृपाणां च तुल्यः कर्णो मतो मम ।\nअनुज्ञातश्च रामेण मत्समोऽसीति भारत\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2145197, "chapter_id": 4126, "verse_number": "५८", "content_sanskrit": "कुण्डले रुचिरे चास्तां कर्णस्य सहजे शुभे ।\nते शक्त्यर्थे महेन्द्रेण याचितः स परन्तपः\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2145198, "chapter_id": 4126, "verse_number": "५९", "content_sanskrit": "अमोघया महाराज शक्त्या परमभीमया ।\nतस्य शक्त्योपगूढस्य कस्माज्जीवेद् धनञ्जयः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2145199, "chapter_id": 4126, "verse_number": "६०", "content_sanskrit": "विजयो मे ध्रुवं राजन् फलं पाणाविवाहितम् ।\nअभिव्यक्तः परेषां च कृत्स्नो भुवि पराजयः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2145200, "chapter_id": 4126, "verse_number": "६१", "content_sanskrit": "अह्ना ह्येकेन भीष्मोऽयं प्रयुतं हन्ति भारत ।\nतत्समाश्च महेष्वासा द्रोणद्रौणिकृपा अपि\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2145201, "chapter_id": 4126, "verse_number": "६२", "content_sanskrit": "संशप्तकानां बृन्दानि क्षत्रियाणां परन्तप ।\nअर्जुनं वयमस्मान् वा निहन्यात् कपिकेतनः\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2145202, "chapter_id": 4126, "verse_number": "६३", "content_sanskrit": "तांश्चालमिति मन्यन्ते सव्यसाचिवधे धृताः ।\nपार्थिवाः स भवांस्तेभ्यो ह्यकस्माद् व्यथते कथम्\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2145203, "chapter_id": 4126, "verse_number": "६४", "content_sanskrit": "भीमसेने च निहते कोऽन्यो युध्येत भारत ।\nपाञ्चालेषु च भग्नेषु को नु स्थातुमिहार्हति\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2145204, "chapter_id": 4126, "verse_number": "६५", "content_sanskrit": "परेषां तन्ममाचक्ष्व यदि वेत्थ परन्तप\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2145205, "chapter_id": 4126, "verse_number": "६६", "content_sanskrit": "पञ्च ते भ्रातरः सर्वे धृष्टद्युम्नोऽथ सात्यकिः ।\nपरेषां सप्त ये राजन् योधाः सारं बलं मतम्\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2145206, "chapter_id": 4126, "verse_number": "६७", "content_sanskrit": "अस्माकं तु विशिष्टा ये भीष्मद्रोणकृपादयः ।\nद्रौणिर्वैकर्तनः कर्णः बाह्लिकश्च बृहद्रथः\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2145207, "chapter_id": 4126, "verse_number": "६८", "content_sanskrit": "प्राग्ज्योतिषाधिपः शल्य आवन्त्योऽथ जयद्रथः ।\nदुःशासनो दुर्मुखश्च दुःसहश्च विशाम्पते\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2145208, "chapter_id": 4126, "verse_number": "६९", "content_sanskrit": "श्रुतायुश्चित्रसेनश्च पुरुमित्रो विविंशतिः ।\nशलो भूरिश्रवाश्चैव विकर्णश्च तवात्मजः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2145209, "chapter_id": 4126, "verse_number": "७०", "content_sanskrit": "अक्षोहिण्योऽपि मे राजन् दशैका च समाश्रिताः ।\nन्यूनाः परेषां सप्तैव कस्मान्मे स्यात् पराजयः\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2145210, "chapter_id": 4126, "verse_number": "७१", "content_sanskrit": "बलं त्रिगुणतो हीनं योध्यं प्राह बृहस्पतिः ।\nपरेभ्यस्त्रिगुणा चेयं मम राजन्ननीकिनी\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2145211, "chapter_id": 4126, "verse_number": "७२", "content_sanskrit": "गुणहीनं परेषां च बहु पश्यामि भारत ।\nगुणोदयं बहुगुणमात्मनश्च विशाम्पते\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2145212, "chapter_id": 4126, "verse_number": "७३", "content_sanskrit": "एतत्सर्वं समाज्ञाय बलाग्र्यं मम भारत ।\nन्यूनतां पाण्डवानां च न मोहं गन्तुमर्हसि\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2145213, "chapter_id": 4126, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2145214, "chapter_id": 4126, "verse_number": "७४", "content_sanskrit": "इत्युक्त्वा सञ्जयं भूयः पर्यपृच्छत भारत ।\nविवित्सुः प्राप्तकालानि ज्ञात्वा परपुरञ्जयः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2145215, "chapter_id": 4126, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि सप्तपञ्चाशोऽध्यायः ॥५७॥ व्यासाभिगमनपर्वणि दशमोऽध्यायः ॥१०॥\n॥ इति उद्योगपर्वणि प्रथमो भागः ॥\n- - - - -\n॥ श्रीमध्वेशार्पणमस्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]