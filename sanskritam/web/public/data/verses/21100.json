[{"id": 7001100000, "chapter_id": 21100, "verse_number": "२-१-११-१", "content_sanskrit": "ऋषय ऊचुः ।\nसूतसूत महाभाग व्यासशिष्य नमोस्तु ते ।\nश्राविताद्याद्भुता शैवकथा परमपावनी॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001100001, "chapter_id": 21100, "verse_number": "२-१-११-२", "content_sanskrit": "तत्राद्भुता महादिव्या लिंगोत्पत्तिः श्रुता शुभा ।\nश्रुत्वा यस्याः प्रभावं च दुःखनाशो भवेदिह॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001100002, "chapter_id": 21100, "verse_number": "२-१-११-३", "content_sanskrit": "ब्रह्मनारदसंवादमनुसृत्य दयानिधे ।\nशिवार्चनविधिं ब्रूहि येन तुष्टो भवेच्छिवः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001100003, "chapter_id": 21100, "verse_number": "२-१-११-४", "content_sanskrit": "ब्राह्मणैः क्षत्रियैर्वैश्यैः शूद्रैर्वा पूज्यते शिवः ।\nकथं कार्यं च तद् ब्रूहि यथा व्यासमुखाच्छ्रुतम्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001100004, "chapter_id": 21100, "verse_number": "२-१-११-५", "content_sanskrit": "तच्छ्रुत्वा वचनं तेषां शर्मदं श्रुतिसंमतम् ।\nउवाच सकलं प्रीत्या मुनि प्रश्नानुसारतः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001100005, "chapter_id": 21100, "verse_number": "२-१-११-६", "content_sanskrit": "सूत उवाच ।\nसाधु पृष्टं भवद्भिश्च तद्रहस्यं मुनीश्वराः ।\nतदहं कथयाम्यद्य यथाबुद्धि यथाश्रुतम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001100006, "chapter_id": 21100, "verse_number": "२-१-११-७", "content_sanskrit": "भवद्भिः पृच्छयते तद्वत्तथा व्यासेन वै पुरा ।\nपृष्टं सनत्कुमाराय तच्छ्रुतं ह्युपमन्युना॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001100007, "chapter_id": 21100, "verse_number": "२-१-११-८", "content_sanskrit": "ततो व्यासेन वै श्रुत्वा शिवपूजादिकं च यत् ।\nमह्यं च पाठितं तेन लोकानां हितकाम्यया॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001100008, "chapter_id": 21100, "verse_number": "२-१-११-९", "content_sanskrit": "तच्छ्रुतं चैव कृष्णेन ह्युपमन्योर्महात्मनः ।\nतदहं कथयिष्यामि यथा ब्रह्मावदत्पुरा॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001100009, "chapter_id": 21100, "verse_number": "२-१-११-१०", "content_sanskrit": "ब्रह्मोवाच ।\nशृणु नारद वक्ष्यामि संक्षेपाल्लिंगपूजनम् ।\nवक्तुं वर्षशतेनापि न शक्यं विस्तरान्मुने॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001100010, "chapter_id": 21100, "verse_number": "२-१-११-११", "content_sanskrit": "एवं तु शांकरं रूपं मुखं स्वच्छं सनातनम् ।\nपूजयेत्परया भक्त्या सर्वकामफलाप्तये॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001100011, "chapter_id": 21100, "verse_number": "२-१-११-१२", "content_sanskrit": "दारिद्र्यं रोगदुःखं च पीडनं शत्रुसंभवम् ।\nपापं चतुर्विधं तावद्यावन्नार्चयते शिवम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001100012, "chapter_id": 21100, "verse_number": "२-१-११-१३", "content_sanskrit": "सम्पूजिते शिवे देवे सर्वदुःखं विलीयते ।\nसंपद्यते सुखं सर्वं पश्चान्मुक्तिरवाप्यते॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001100013, "chapter_id": 21100, "verse_number": "२-१-११-१४", "content_sanskrit": "ये वै मानुष्यमाश्रित्य मुख्यं संतानतस्सुखम् ।\nतेन पूज्यो महादेवः सर्वकार्यार्थसाधकः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001100014, "chapter_id": 21100, "verse_number": "२-१-११-१५", "content_sanskrit": "ब्राह्मणाः क्षत्रिया वैश्याश्शूद्राश्च विधिवत्क्रमात् ।\nशंकरार्चां प्रकुर्वंतु सर्वकामार्थसिद्धये॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001100015, "chapter_id": 21100, "verse_number": "२-१-११-१६", "content_sanskrit": "प्रातःकाले समुत्थाय मुहूर्ते ब्रह्मसंज्ञके ।\nगुरोश्च स्मरणं कृत्वा शंभोश्चैव तथा पुनः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001100016, "chapter_id": 21100, "verse_number": "२-१-११-१७", "content_sanskrit": "तीर्थानां स्मरणं कृत्वा ध्यानं चैव हरेरपि ।\nममापि निर्जराणां वै मुन्यादीनां तथा मुने॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001100017, "chapter_id": 21100, "verse_number": "२-१-११-१८", "content_sanskrit": "ततः स्तोत्रं शुभं नाम गृह्णीयाद्विधिपूर्वकम् ।\nततोत्थाय मलोत्सर्गं दक्षिणस्यां चरेद्दिशि॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001100018, "chapter_id": 21100, "verse_number": "२-१-११-१९", "content_sanskrit": "एकान्ते तु विधिं कुर्यान्मलोत्सर्गस्स यच्छ्रुतम् ।\nतदेव कथयाम्यद्य शृण्वाधाय मनो मुने॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001100019, "chapter_id": 21100, "verse_number": "२-१-११-२०", "content_sanskrit": "शुद्धां मृदं द्विजो लिप्यात्पंचवारं विशुद्धये ।\nक्षत्रियश्च चतुर्वारं वैश्यो वरत्रयं तथा॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001100020, "chapter_id": 21100, "verse_number": "२-१-११-२१", "content_sanskrit": "शूद्रो द्विवारं च मृदं गृह्णीयाद्विधिशुद्धये ।\nगुदे वाथ सकृल्लिंगे वारमेकं प्रयत्नतः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001100021, "chapter_id": 21100, "verse_number": "२-१-११-२२", "content_sanskrit": "दशवारं वामहस्ते सप्तवारं द्वयोस्तथा ।\nप्रत्येकम्पादयोस्तात त्रिवारं करयोः पुनः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001100022, "chapter_id": 21100, "verse_number": "२-१-११-२३", "content_sanskrit": "स्त्रीभिश्च शूद्रवत्कार्यं मृदाग्रहणमुत्तमम् ।\nहस्तौ पादौ च प्रक्षाल्य पूर्ववन्मृदमाहरेत्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001100023, "chapter_id": 21100, "verse_number": "२-१-११-२४", "content_sanskrit": "दंतकाष्ठं ततः कुर्यात्स्ववर्णक्रमतो नरः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001100024, "chapter_id": 21100, "verse_number": "२-१-११-२५", "content_sanskrit": "विप्रः कुर्याद्दंतकाष्ठं द्वादशांगुलमानतः ।\nएकादशांगुलं राजा वैश्यः कुर्याद्दशांगुलम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001100025, "chapter_id": 21100, "verse_number": "२-१-११-२६", "content_sanskrit": "शूद्रो नवागुलं कुर्यादिति मानमिदं स्मृतम् ।\nकालदोषं विचार्य्यैव मनुदृष्टं विवर्जयेत्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001100026, "chapter_id": 21100, "verse_number": "२-१-११-२७", "content_sanskrit": "षष्ट्याद्यामाश्च नवमी व्रतमस्तं रवेर्दिनम् ।\nतथा श्राद्धदिनं तात निषिद्धं रदधावने॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001100027, "chapter_id": 21100, "verse_number": "२-१-११-२८", "content_sanskrit": "स्नानं तु विधिवत्कार्यं तीर्थादिषु क्रमेण तु ।\nदेशकालविशेषेण स्नानं कार्यं समंत्रकम्॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001100028, "chapter_id": 21100, "verse_number": "२-१-११-२९", "content_sanskrit": "आचम्य प्रथमं तत्र धौतवस्त्रेण चाधरेत् ।\nएकान्ते सुस्थले स्थित्वा संध्याविधिमथाचरेत्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001100029, "chapter_id": 21100, "verse_number": "२-१-११-३०", "content_sanskrit": "यथायोग्यं विधिं कृत्वा पूजाविधिमथारभेत् ।\nमनस्तु सुस्थिरं कृत्वा पूजागारं प्रविश्य च॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001100030, "chapter_id": 21100, "verse_number": "२-१-११-३१", "content_sanskrit": "पूजाविधिं समादाय स्वासने ह्युपविश्य वै ।\nन्यासादिकं विधायादौ पूजयेत्क्रमशो हरम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001100031, "chapter_id": 21100, "verse_number": "२-१-११-३२", "content_sanskrit": "प्रथमं च गणाधीशं द्वारपालांस्तथैव च ।\nदिक्पालांश्च सुसंपूज्य पश्चात्पीठं प्रकल्पयेत्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001100032, "chapter_id": 21100, "verse_number": "२-१-११-३३", "content_sanskrit": "अथ वाऽष्टदलं कृत्वा पूजाद्रव्यं समीपतः ।\nउपविश्य ततस्तत्र उपवेश्य शिवम् प्रभुम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001100033, "chapter_id": 21100, "verse_number": "२-१-११-३४", "content_sanskrit": "आचमनत्रयं कृत्वा प्रक्षाल्य च पुनः करौ ।\nप्राणायामत्रयं कृत्वा मध्ये ध्यायेच्च त्र्यम्बकम्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001100034, "chapter_id": 21100, "verse_number": "२-१-११-३५", "content_sanskrit": "पंचवक्त्रं दशभुजं शुद्धस्फटिकसन्निभम् ।\nसर्वाभरणसंयुक्तं व्याघ्रचर्मोत्तरीयकम्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001100035, "chapter_id": 21100, "verse_number": "२-१-११-३६", "content_sanskrit": "तस्य सारूप्यतां स्मृत्वा दहेत्पापं नरस्सदा ।\nशिवं ततः समुत्थाप्य पूजयेत्परमेश्वरम्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001100036, "chapter_id": 21100, "verse_number": "२-१-११-३७", "content_sanskrit": "देहशुद्धिं ततः कृत्वा मूल मंत्रं न्यसेत्क्रमात् ।\nसर्वत्र प्रणवेनैव षडंगन्यासमाचरेत्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001100037, "chapter_id": 21100, "verse_number": "२-१-११-३८", "content_sanskrit": "कृत्वा हृदि प्रयोगं च ततः पूजां समारभेत् ।\nपाद्यार्घाचमनार्थं च पात्राणि च प्रकल्पयेत्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001100038, "chapter_id": 21100, "verse_number": "२-१-११-३९", "content_sanskrit": "स्थापयेद्विविधान्कुंभान्नव धीमान्यथाविधि ।\nदर्भैराच्छाद्य तैरेव संस्थाप्याभ्युक्ष्य वारिणा॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001100039, "chapter_id": 21100, "verse_number": "२-१-११-४०", "content_sanskrit": "तेषु तेषु च सर्वेषु क्षिपेत्तोयं सुशीतलम् ।\nप्रणवेन क्षिपेत्तेषु द्रव्याण्यालोक्य बुद्धिमान्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001100040, "chapter_id": 21100, "verse_number": "२-१-११-४१", "content_sanskrit": "उशीरं चन्दनं चैव पाद्ये तु परिकल्पयेत् ।\nजातीकं कोलकर्पूरवटमूल तमालकम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001100041, "chapter_id": 21100, "verse_number": "२-१-११-४२", "content_sanskrit": "चूर्णयित्वा यथान्यायं क्षिपेदाचमनीयके ।\nएतत्सर्वेषु पात्रेषु दापयेच्चन्दनान्वितम्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001100042, "chapter_id": 21100, "verse_number": "२-१-११-४३", "content_sanskrit": "पार्श्वयोर्देवदेवस्य नंदीशं तु समर्चयेत् ।\nगंधैर्धूपैस्तथा दीपैर्विविधैः पूजयेच्छिवम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001100043, "chapter_id": 21100, "verse_number": "२-१-११-४४", "content_sanskrit": "लिंगशुद्धिं ततः कृत्वा मुदा युक्तो नरस्तदा ।\nयथोचितं तु मंत्रौघैः प्रणवादिर्नमोंतकैः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001100044, "chapter_id": 21100, "verse_number": "२-१-११-४५", "content_sanskrit": "कल्पयेदासनं स्वस्तिपद्मादि प्रणवेन तु ।\nतस्मात्पूर्वदिशं साक्षादणिमामयमक्षरम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001100045, "chapter_id": 21100, "verse_number": "२-१-११-४६", "content_sanskrit": "लघिमा दक्षिणं चैव महिमा पश्चिमं तथा ।\nप्राप्तिश्चैवोत्तरं पत्रं प्राकाम्यं पावकस्य च॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001100046, "chapter_id": 21100, "verse_number": "२-१-११-४७", "content_sanskrit": "ईशित्वं नैरृतं पत्रं वशित्वं वायुगोचरे ।\nसर्वज्ञत्वं तथैशान्यं कर्णिका सोम उच्यते॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001100047, "chapter_id": 21100, "verse_number": "२-१-११-४८", "content_sanskrit": "सोमस्याधस्तथा सूर्यस्तस्याधः पावकस्त्वयम् ।\nधर्मादीनपि तस्याधो भवतः कल्पयेत् क्रमात्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001100048, "chapter_id": 21100, "verse_number": "२-१-११-४९", "content_sanskrit": "अव्यक्तादि चतुर्दिक्षु सोमस्यांते गुणत्रयम् ।\nसद्योजातं प्रवक्ष्यामीत्यावाह्य परमेश्वरम्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001100049, "chapter_id": 21100, "verse_number": "२-१-११-५०", "content_sanskrit": "वामदेवेन मंत्रेण तिष्ठेच्चैवासनोपरि ।\nसान्निध्यं रुद्रगायत्र्या अघोरेण निरोधयेत्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001100050, "chapter_id": 21100, "verse_number": "२-१-११-५१", "content_sanskrit": "ईशानं सर्वविद्यानामिति मंत्रेण पूजयेत् ।\nपाद्यमाचनीयं च विधायार्घ्यं प्रदापयेत्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001100051, "chapter_id": 21100, "verse_number": "२-१-११-५२", "content_sanskrit": "स्थापयेद्विधिना रुद्रं गंधचंदनवारिणा ।\nपञ्चागव्यविधानेन गृह्यपात्रेऽभिमंत्र्य च॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001100052, "chapter_id": 21100, "verse_number": "२-१-११-५३", "content_sanskrit": "प्रणवेनैव गव्येन स्नापयेत्पयसा च तम् ।\nदध्ना च मधुना चैव तथा चेक्षुरसेन तु॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001100053, "chapter_id": 21100, "verse_number": "२-१-११-५४", "content_sanskrit": "घृतेन तु यथा पूज्य सर्वकामहितावहम् ।\nपुण्यैर्द्रव्यैर्महादेवं प्रणवेनाभिषेचयेत्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001100054, "chapter_id": 21100, "verse_number": "२-१-११-५५", "content_sanskrit": "पवित्रजलभाण्डेषु मंत्रैः तोयं क्षिपेत्ततः ।\nशुद्धीकृत्य यथान्यायं सितवस्त्रेण साधकः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001100055, "chapter_id": 21100, "verse_number": "२-१-११-५६", "content_sanskrit": "तावद्दूरं न कर्तव्यं न यावच्चन्दनं क्षिपेत् ।\nतंदुलैस्सुन्दरैस्तत्र पूजयेच्छंकरम्मुदा॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001100056, "chapter_id": 21100, "verse_number": "२-१-११-५७", "content_sanskrit": "कुशापामार्गकर्पूर जातिचंपकपाटलैः ।\nकरवीरैस्सितैश्चैव मल्लिकाकमलोत्पलैः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001100057, "chapter_id": 21100, "verse_number": "२-१-११-५८", "content_sanskrit": "अपूर्वपुष्पैर्विविधैश्चन्दनाद्यैस्तथैव च ।\nजलेन जलधाराञ्च कल्पयेत्परमेश्वरे॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001100058, "chapter_id": 21100, "verse_number": "२-१-११-५९", "content_sanskrit": "पात्रैश्च विविधैर्देवं स्नापयेच्च महेश्वरम् ।\nमंत्रपूर्वं प्रकर्तव्या पूजा सर्वफलप्रदा॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001100059, "chapter_id": 21100, "verse_number": "२-१-११-६०", "content_sanskrit": "मंत्रांश्च तुभ्यं तांस्तात सर्वकामार्थसिद्धये ।\nप्रवक्ष्यामि समासेन सावधानतया शृणु॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001100060, "chapter_id": 21100, "verse_number": "२-१-११-६१", "content_sanskrit": "पाठयमानेन मंत्रेण तथा वाङ्मयकेन च ।\nरुद्रेण नीलरुद्रेण सुशुक्लेन सुभेन च॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001100061, "chapter_id": 21100, "verse_number": "२-१-११-६२", "content_sanskrit": "होतारेण तथा शीर्ष्णा शुभेनाथर्वणेन च ।\nशांत्या वाथ पुनश्शांत्यामारुणेनारुणेन च॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001100062, "chapter_id": 21100, "verse_number": "२-१-११-६३", "content_sanskrit": "अर्थाभीष्टेन साम्ना च तथा देवव्रतेन च॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001100063, "chapter_id": 21100, "verse_number": "२-१-११-६४", "content_sanskrit": "रथांतरेण पुष्पेण सूक्तेन युक्तेन च ।\nमृत्युंजयेन मंत्रेण तथा पंचाक्षरेण च॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001100064, "chapter_id": 21100, "verse_number": "२-१-११-६५", "content_sanskrit": "जलधाराः सहस्रेण शतेनैकोत्तरेण वा ।\nकर्तव्या वेदमार्गेण नामभिर्वाथ वा पुनः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001100065, "chapter_id": 21100, "verse_number": "२-१-११-६६", "content_sanskrit": "ततश्चंदनपुष्पादि रोपणीयं शिवोपरि ।\nदापयेत्प्रणवेनैव मुखवासादिकं तथा॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001100066, "chapter_id": 21100, "verse_number": "२-१-११-६७", "content_sanskrit": "ततः स्फटिकसंकाशं देवं निष्कलमक्षयम् ।\nकारणं सर्वलोकानां सर्वलोकमयं परम्॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001100067, "chapter_id": 21100, "verse_number": "२-१-११-६८", "content_sanskrit": "ब्रह्मेन्द्रोपेन्द्रविष्ण्वाद्यैरपि देवैरगोचरम् ।\nवेदविद्भिर्हि वेदांते त्वगोचर मिति स्मृतम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001100068, "chapter_id": 21100, "verse_number": "२-१-११-६९", "content_sanskrit": "आदिमध्यान्तरहितं भेषजं सर्वरोगिणाम् ।\nशिवतत्त्वमिति ख्यातं शिवलिंगं व्यवस्थितम्॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001100069, "chapter_id": 21100, "verse_number": "२-१-११-७०", "content_sanskrit": "प्रणवेनैव मंत्रेण पूजयेल्लिंगमूर्द्धनि ।\nधूपैर्दीपैश्च नैवैद्यैस्ताम्बूलैः सुन्दरैस्तथा॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001100070, "chapter_id": 21100, "verse_number": "२-१-११-७१", "content_sanskrit": "नीराजनेन रम्येण यथोक्तविधिना ततः ।\nनमस्कारैः स्तवैश्चान्यैर्मंत्रैर्नानाविधैरपि॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001100071, "chapter_id": 21100, "verse_number": "२-१-११-७२", "content_sanskrit": "अर्घ्यं दत्त्वा तु पुष्पाणि पादयोस्सुविकीर्य च ।\nप्रणिपत्य च देवेशमात्मनाराधयेच्छिवम्॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001100072, "chapter_id": 21100, "verse_number": "२-१-११-७३", "content_sanskrit": "हस्ते गृहीत्वा पुष्पाणि समुत्थाय कृतांजलिः ।\nप्रार्थयेत्पुनरीशानं मंत्रेणानेन शंकरम्॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001100073, "chapter_id": 21100, "verse_number": "२-१-११-७४", "content_sanskrit": "अज्ञानाद्यदि वा ज्ञानाज्जपपूजादिकं मया ।\nकृतं तदस्तु सफलं कृपया तव शंकर॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001100074, "chapter_id": 21100, "verse_number": "२-१-११-७५", "content_sanskrit": "पठित्वैवं च पुष्पाणि शिवोपरि मुदा न्यसेत् ।\nस्वस्त्ययनं ततः कृत्वा ह्याशिषो विविधास्तथा॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001100075, "chapter_id": 21100, "verse_number": "२-१-११-७६", "content_sanskrit": "मार्जनं तु ततः कार्यं शिवस्योपरि वै पुनः ।\nनमस्कारं ततः क्षांतिं पुनराचमनाय च॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001100076, "chapter_id": 21100, "verse_number": "२-१-११-७७", "content_sanskrit": "अघोच्चारणमुच्चार्य नमस्कारं प्रकल्पयेत् ।\nप्रार्थयेच्च पुनस्तत्र सर्वभावसमन्वितः॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001100077, "chapter_id": 21100, "verse_number": "२-१-११-७८", "content_sanskrit": "शिवे भक्तिश्शिवे भक्तिश्शिवे भक्तिर्भवे भवे ।\nअन्यथा शरणं नास्ति त्वमेव शरणं मम॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001100078, "chapter_id": 21100, "verse_number": "२-१-११-७९", "content_sanskrit": "इति संप्रार्थ्य देवेशं सर्वसिद्धिप्रदायकम् ।\nपूजयेत्परया भक्त्या गलनादैर्विशेषतः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001100079, "chapter_id": 21100, "verse_number": "२-१-११-८०", "content_sanskrit": "नमस्कारं ततः कृत्वा परिवारगणैस्सह ।\nप्रहर्षमतुलं लब्ध्वा कार्यं कुर्याद्यथासुखम्॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001100080, "chapter_id": 21100, "verse_number": "२-१-११-८१", "content_sanskrit": "एवं यः पूजयेन्नित्यं शिवभक्तिपरायणः ।\nतस्य वै सकला सिद्धिर्जायते तु पदे पदे॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001100081, "chapter_id": 21100, "verse_number": "२-१-११-८२", "content_sanskrit": "वाग्मी स जायते तस्य मनोभी ष्टफलं ध्रुवम् ।\nरोगं दुःखं च शोकं च ह्युद्वेगं कृत्रिमं तथा॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001100082, "chapter_id": 21100, "verse_number": "२-१-११-८३", "content_sanskrit": "कौटिल्यं च गरं चैव यद्यदुःखमुपस्थितम् ।\nतद्दुःखं नाश यत्येव शिवः शिवकरः परः॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001100083, "chapter_id": 21100, "verse_number": "२-१-११-८४", "content_sanskrit": "कल्याणं जायते तस्य शुक्लपक्षे यथा शशी ।\nवर्द्धते सद्गुणस्तत्र ध्रुवं शंकरपूजनात्॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001100084, "chapter_id": 21100, "verse_number": "२-१-११-८५", "content_sanskrit": "इति पूजाविधिश्शंभोः प्रोक्तस्ते मुनिसत्तम ।\nअतः परं च शुश्रूषुः किं प्रष्टासि च नारद॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}]