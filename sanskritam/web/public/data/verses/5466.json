[{"id": 2209086, "chapter_id": 5466, "verse_number": "", "content_sanskrit": "वसुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2209087, "chapter_id": 5466, "verse_number": "१", "content_sanskrit": "श्रुतवानस्मि वार्ष्णेय सङ्ग्रामं परमाद्भुतम् ।\nनराणां वदतां पुत्र कथोद्घातेषु नित्यशः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2209088, "chapter_id": 5466, "verse_number": "२", "content_sanskrit": "त्वं तु प्रत्यक्षदर्शी च कार्यज्ञश्च महाभुज ।\nतस्मात् प्रब्रूहि सङ्ग्रामं याथातथ्येन मेऽनघ ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2209089, "chapter_id": 5466, "verse_number": "३", "content_sanskrit": "कथं तदभवद् युद्धं पाण्डवानां महात्मनाम् ।\nभीष्मकर्णकृपद्रोणशल्यादिभिरनुत्तमम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2209090, "chapter_id": 5466, "verse_number": "४", "content_sanskrit": "अन्येषां क्षत्रियाणां च कृतास्त्राणामनेकशः ।\nनानावेषाकृतिमतां नानादेशनिवासिनाम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2209091, "chapter_id": 5466, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2209092, "chapter_id": 5466, "verse_number": "५", "content_sanskrit": "इत्युक्तः पुण्डरीकाक्षः पित्रा मातुस्तथाऽन्तिके ।\nशशंस कुरुवीराणां सङ्ग्रामे निधनं यथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2209093, "chapter_id": 5466, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2209094, "chapter_id": 5466, "verse_number": "६", "content_sanskrit": "अत्यद्भुतानि कर्माणि क्षत्रियाणां महात्मनाम् ।\nबहुलत्वान्न सङ्ख्यातुं शक्यान्यब्दगणैरपि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2209095, "chapter_id": 5466, "verse_number": "७", "content_sanskrit": "प्राधान्यतस्तु गदतः समासेनैव मे शृणु ।\nकर्माणि कुरुवीराणां यथावदमरद्युते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2209096, "chapter_id": 5466, "verse_number": "८", "content_sanskrit": "भीष्मः सेनापतिरभूद् एकादशचमूपतिः ।\nकौरव्यः कौरवेयाणां देवानामिव पावकिः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2209097, "chapter_id": 5466, "verse_number": "९", "content_sanskrit": "शिखण्डी पाण्डुपुत्राणां नेता सप्तचमूपतिः ।\nबभूव रक्षितो नित्यं धीमता सव्यसाचिना ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2209098, "chapter_id": 5466, "verse_number": "१०", "content_sanskrit": "तेषां तदभवद्युद्धं दशाहानि महात्मनाम् ।\nकुरूणां पाण्डवेयानां सुमहद् रोमहर्षणम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2209099, "chapter_id": 5466, "verse_number": "११", "content_sanskrit": "अयुध्यमानं गाङ्गेयं शिखण्डी तं महाद्युतिम् ।\nजघान बहुभिर्बाणैः सह गाण्डीवधन्वना ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2209100, "chapter_id": 5466, "verse_number": "१२", "content_sanskrit": "अकरोत् स ततः कालं शरतल्पगतो मुनिः ।\nअयनं दक्षिणं हित्वा सम्प्राप्ते चोत्तरायणे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2209101, "chapter_id": 5466, "verse_number": "१३", "content_sanskrit": "ततः सेनापतिरभूद् द्रोणो ब्रह्मविदां वरः ।\nविप्रेन्द्रः कौरवेन्द्रस्य काव्यो दैत्यपतेरिव ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2209102, "chapter_id": 5466, "verse_number": "१४", "content_sanskrit": "अक्षौहिणीभिः शिष्टाभिर्नवभिर्द्विजसत्तमः।\nसंवृतः समरश्लाघी गुप्तः कृपसुतादिभिः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2209103, "chapter_id": 5466, "verse_number": "१५", "content_sanskrit": "धृष्टद्युम्नस्त्वभून्नेता पाण्डवानां महास्त्रवित् ।\nगुप्तो भीमेन मेधावी मित्रेण वरुणो यथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2209104, "chapter_id": 5466, "verse_number": "१६", "content_sanskrit": "पाण्डुसेनापरिवृतो द्रोणप्रेप्सुर्महामनाः ।\nपितुर्निकारान् संस्मृत्य रणे कर्माकरोन्महत् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2209105, "chapter_id": 5466, "verse_number": "१७", "content_sanskrit": "तस्मिंस्ते पृथिवीपाला द्रोणपार्षतसङ्गमे ।\nनानादेशागता वीराः प्रायशो निधनं गताः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2209106, "chapter_id": 5466, "verse_number": "१८", "content_sanskrit": "दिनानि पञ्च तद्युद्धमभूत् परमदारुणम् ।\nततो द्रोणः परिश्रान्तो धृष्टद्युम्नवशं गतः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2209107, "chapter_id": 5466, "verse_number": "१९", "content_sanskrit": "ततः सेनापतिरभूत् कर्णो दौर्यौधने बले ।\nअक्षौहिणीभिः शिष्टाभिः वृतः पञ्चभिराहवे ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2209108, "chapter_id": 5466, "verse_number": "२०", "content_sanskrit": "तिस्रस्तु पाण्डुपुत्राणां शिष्टा बीभत्सुपालिताः ।\nहतप्रवीरभूयिष्ठा बभूवुः पर्यवस्थिताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2209109, "chapter_id": 5466, "verse_number": "२१", "content_sanskrit": "ततः पार्थं समासाद्य पतङ्ग इव पावकम् ।\nस द्वितीयेऽहनि तदा फल्गुनेन निपातितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2209110, "chapter_id": 5466, "verse_number": "२२", "content_sanskrit": "हते कर्णे तु कौरव्या निरुत्साहा हतौजसः ।\nअक्षोहिणीभिस्तिसृभिः मद्रेशं पर्यवारयन् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2209111, "chapter_id": 5466, "verse_number": "२३", "content_sanskrit": "हतवाहनभूयिष्ठाः पाण्डवास्तु युधिष्ठिरम् ।\nअक्षोहिण्या निरुत्साहाः शिष्टया पर्यवारयन् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2209112, "chapter_id": 5466, "verse_number": "२४", "content_sanskrit": "अवधीन्मद्रराजानं कुरुराजो युधिष्ठिरः ।\nतस्मिंस्तदाऽर्धदिवसे कृत्वा कर्म सुदुष्करम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2209113, "chapter_id": 5466, "verse_number": "२५", "content_sanskrit": "हते शल्ये तु शकुनिं सहदेवो महामनाः ।\nआहर्तारं कलेस्तस्य जघानामितविक्रमः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2209114, "chapter_id": 5466, "verse_number": "२६", "content_sanskrit": "निहते शकुनौ राजा धार्तराष्ट्रः सुदुर्मनाः ।\nअपाक्रामद् गदापाणिर्हतभूयिष्ठसैनिकः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2209115, "chapter_id": 5466, "verse_number": "२७", "content_sanskrit": "तमन्वधावत् सङ्क्रुद्धो भीमसेनः प्रतापवान् ।\nह्रदे द्वैपायने चैव सलिलस्थं ददर्श सः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2209116, "chapter_id": 5466, "verse_number": "२८", "content_sanskrit": "ततः शिष्टेन सैन्येन समन्तात् पर्यवारयत् ।\nउपोपविविशुर्हृष्टा ह्रदस्थं पञ्च पाण्डवाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2209117, "chapter_id": 5466, "verse_number": "२९", "content_sanskrit": "विगाह्य सलिलं त्वाशु वाग्बाणैर्भृशविक्षतः ।\nउत्थाय स गदापाणिर्युद्धाय समुपस्थितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2209118, "chapter_id": 5466, "verse_number": "३०", "content_sanskrit": "ततः स निहतो राजा धार्तराष्ट्रो महामृधे ।\nभीमसेनेन विक्रम्य पश्यतां पृथिवीक्षिताम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2209119, "chapter_id": 5466, "verse_number": "३१", "content_sanskrit": "ततस्तत् पाण्डवं सैन्यं संसुप्तं शिबिरे निशि ।\nनिहतं द्रोणपुत्रेण पितुर्वधममृष्यता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2209120, "chapter_id": 5466, "verse_number": "३२", "content_sanskrit": "हतपुत्रा हतबला हतमित्रा मया सह ।\nयुयुधानद्वितीयेन पञ्च शिष्टास्तु पाण्डवाः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2209121, "chapter_id": 5466, "verse_number": "३३", "content_sanskrit": "सहैव कृपभोजाभ्यां द्रौणिर्युद्धादमुच्यत ।\nयुयुत्सुश्चापि कौरव्यो मुक्तः पाण्डवसंश्रयात् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2209122, "chapter_id": 5466, "verse_number": "३४", "content_sanskrit": "निहते कौरवेन्द्रे च सानुबन्धे सुयोधने ।\nविदुरः सञ्जयश्चैव धर्मराजमुपस्थितौ ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2209123, "chapter_id": 5466, "verse_number": "३५", "content_sanskrit": "एवं तदभवद् युद्धमहान्यष्टादश प्रभो ।\nयत्र ते पृथिवीपाला निहताः स्वर्गमावसन् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2209124, "chapter_id": 5466, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2209125, "chapter_id": 5466, "verse_number": "३६", "content_sanskrit": "शृण्वतां तु तथा तेषां कथां तां रोमहर्षणीम् ।\nदुःखामर्षपरिक्लेशो वृष्णीनामभवत् तदा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2209126, "chapter_id": 5466, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि पुनर्युद्धप्रकारकथनं नाम षष्टितमोऽध्यायः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]