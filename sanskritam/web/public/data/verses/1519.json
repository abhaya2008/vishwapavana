[{"id": 2024191, "chapter_id": 1519, "verse_number": "३-१५७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2024192, "chapter_id": 1519, "verse_number": "३-१५७-१", "content_sanskrit": "तस्मिन्निवसमानोऽथ धर्मराजो युधिष्ठिरः।\nआमन्त्र्य सहितान्भ्रातृनित्युवाच सहद्विजान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2024193, "chapter_id": 1519, "verse_number": "३-१५७-२", "content_sanskrit": "दृष्टानि तीर्थान्यस्माभिः पुण्यानि च शिवानि च।\nमनसो ह्लादनीयानि वनानि च पृथक्पृथक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2024194, "chapter_id": 1519, "verse_number": "३-१५७-३", "content_sanskrit": "देवैः पूर्वं विचीर्णानि मुनिभिश्च महात्मभिः।\nयथाक्रममशेषेण द्विजैः संपूजितानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2024195, "chapter_id": 1519, "verse_number": "३-१५७-४", "content_sanskrit": "ऋषीणां पूर्वचरितं तपोधर्मविचेष्टितम्।\nराजर्षीणां च चरितं कथाश्च विविधाः शुभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2024196, "chapter_id": 1519, "verse_number": "३-१५७-५", "content_sanskrit": "शृण्वानास्तत्रतत्र स्म आश्रमेषु शिवेषु च।\nअभिषेकं द्विजैः सार्धं कृतवन्तो विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2024197, "chapter_id": 1519, "verse_number": "३-१५७-६", "content_sanskrit": "अर्चिताः सततं देवाः पुष्पैरद्भिः सदा च वः।\nयथालब्धैर्मूलफलैः पितरश्चापि तर्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2024198, "chapter_id": 1519, "verse_number": "३-१५७-७", "content_sanskrit": "पर्वतेषु च रम्येषु सर्वेषु च सरस्सु च।\nउदधौ च महापुण्ये सूपस्पृष्टं महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2024199, "chapter_id": 1519, "verse_number": "३-१५७-८", "content_sanskrit": "इला सरस्वती सिन्धुर्यमुना नर्मदा तथा।\nनानातीर्थेषु रम्येषु सूपस्पृष्टं सह द्विजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2024200, "chapter_id": 1519, "verse_number": "३-१५७-९", "content_sanskrit": "गङ्गाद्वारमतिक्रम्य बहवः पर्वताः शुभाः।\nहिमवान्पर्वतश्चैव नानाद्विजगणायुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2024201, "chapter_id": 1519, "verse_number": "३-१५७-१०", "content_sanskrit": "विशाला बदरी दृष्टा नरनारायणाश्रमः।\nदिव्यपुष्करिणी दृष्टा सिद्धदेवर्षिपूजिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2024202, "chapter_id": 1519, "verse_number": "३-१५७-११", "content_sanskrit": "यथाक्रमविशेषेण सर्वाण्यायतनानि च।\nदर्शितानि द्विजेनद्रेण लोमशेन महात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2024203, "chapter_id": 1519, "verse_number": "३-१५७-१२", "content_sanskrit": "इमं वैश्रवणावासं दुर्गमं गन्धमादनम्।\nकथं भीम गमिष्यामो मतिरत्र विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2024204, "chapter_id": 1519, "verse_number": "३-१५७-१३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2024205, "chapter_id": 1519, "verse_number": "३-१५७-१३", "content_sanskrit": "एवं ब्रुवति राजेन्द्रे वागुवाचाशरीरिणी।\nन शक्यो दुर्गमो गन्तुं पर्वतो गन्धमादनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2024206, "chapter_id": 1519, "verse_number": "३-१५७-१४", "content_sanskrit": "अननैव पथा राजन्प्रतिगच्छ यथागतम्।\nनरनारायणस्थानं बदरीत्यभिविश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2024207, "chapter_id": 1519, "verse_number": "३-१५७-१५", "content_sanskrit": "तस्माद्यास्यसि कौन्तेय सिद्धचारणसेवितम्।\nबहुपुष्पफलं रम्यमाश्रमं वृषपर्वणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2024208, "chapter_id": 1519, "verse_number": "३-१५७-१६", "content_sanskrit": "अतिक्रम्य च तं पार्थ त्वार्ष्टिषेणाश्रमे वसेः।\nततो द्रक्ष्यसि कौन्तेय निवेशं धनदस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2024209, "chapter_id": 1519, "verse_number": "३-१५७-१७", "content_sanskrit": "एतस्मिन्नन्तरे वायुर्दिव्यगन्धवहः शुभः।\nभनःप्रह्लादनः शीतः पुष्पवर्षं ववर्ष वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2024210, "chapter_id": 1519, "verse_number": "३-१५७-१८", "content_sanskrit": "तच्छ्रुत्वा दिव्यमाकाशाद्विस्मयः समपद्यत।\nऋषीणां ब्राह्मणानां च पार्थिवानां विशेषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2024211, "chapter_id": 1519, "verse_number": "३-१५७-१९", "content_sanskrit": "श्रुत्वा तन्महदाश्चर्यं द्विजो धौम्यस्त्वभाषत।\nन शक्यमुत्तरं गन्तुं प्रतिगच्छाम पाण्डव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2024212, "chapter_id": 1519, "verse_number": "३-१५७-२०", "content_sanskrit": "ततो युधिष्ठिरो राजा विस्मयोत्फुल्ललोचनः।\n[प्रत्यागम्य पुनस्तं तु नरनारायणाश्रमम् ॥]", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2024213, "chapter_id": 1519, "verse_number": "३-१५७-२१", "content_sanskrit": "भीमसेनादिभिः सर्वैर्भ्रातृभिः परिवारितः।\nपाञ्चाल्या ब्राह्मणैश्चैव न्यवसत्सुसुखं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2024214, "chapter_id": 1519, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि सप्तपञ्चाशदधिकशततमोऽध्यायः ॥ १५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}]