[{"id": 2033742, "chapter_id": 1728, "verse_number": "४-५१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2033743, "chapter_id": 1728, "verse_number": "४-५१-१", "content_sanskrit": "ततः शान्तनवस्तत्र धर्मार्थकुशलं हितम् ।\nदुर्योधनमिदं वाक्यमब्रवीत्कुरुसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2033744, "chapter_id": 1728, "verse_number": "४-५१-२", "content_sanskrit": "साधु पश्यति वै द्रोणः कृपः साध्वनुपश्यति ।\nआचार्यपुत्रः सहजं निश्चितं साधु भाषते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2033745, "chapter_id": 1728, "verse_number": "४-५१-३", "content_sanskrit": "कर्णस्तु क्षत्रधर्मेण केवलं योद्धुमिच्छति।\nआचार्यो नावमन्तव्यः पुरुषेण विजानता।\nदेशकालौ तु संप्रेक्ष्य योद्धव्यमिति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2033746, "chapter_id": 1728, "verse_number": "४-५१-४", "content_sanskrit": "यस्य सूर्यसमाः प़ञ्च सपत्नाः स्युः प्रहारिणः।\nकथमभ्युदये तेषां न प्रमुह्येत पण्डितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2033747, "chapter_id": 1728, "verse_number": "४-५१-५", "content_sanskrit": "स्वार्थे सर्वे विमुह्यन्ति येऽपि धर्मविदो जनाः ।\nतस्मात्तत्वं न जानाति यत्तु कार्यं नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2033748, "chapter_id": 1728, "verse_number": "४-५१-६", "content_sanskrit": "धार्तराष्ट्रोपि दुर्बुद्धिः पश्यन्नपि धनञ्जयम् ।\nनैव पश्यति नाघ्राति मन्दः क्रोधवशं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2033749, "chapter_id": 1728, "verse_number": "४-५१-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2033750, "chapter_id": 1728, "verse_number": "४-५१-७", "content_sanskrit": "एवमुक्त्वा तु राजानं पुनर्द्रौणिमुवाच ह।\nप्राञ्जलिर्भरतश्रेष्ठः साम्ना बुद्धिमतांवरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2033751, "chapter_id": 1728, "verse_number": "४-५१-८", "content_sanskrit": "कर्णो हि यदवोचत्त्वां तेजस्संजननाय तत्।\nआचार्यपुत्रः क्षमतां महत्कार्यमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2033752, "chapter_id": 1728, "verse_number": "४-५१-९", "content_sanskrit": "नायं कालो विरोधस्य कौन्तेये समुपस्थिते ।\nक्षन्तव्यं भवता सर्वमाचार्येण कृपेण च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2033753, "chapter_id": 1728, "verse_number": "४-५१-१०", "content_sanskrit": "भवतां हि कृतास्त्रत्वं यथाऽऽदित्ये प्रभा तथा ।\nयथा चन्द्रमसो लक्ष्मीः सर्वथा नापकृष्यते ।\nएवं भवत्सु ब्राह्मण्यं ब्रह्मास्त्रं च प्रतिष्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2033754, "chapter_id": 1728, "verse_number": "४-५१-११", "content_sanskrit": "चत्वार एकतो वेदाः क्षात्रमेकत्र दृश्यते।\nनैतत्समस्तमुभयं कस्मिंश्चिदनुशुश्रुम।\nअन्यत्र भारताचार्यात्सुपुत्रादिति मे मतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2033755, "chapter_id": 1728, "verse_number": "४-५१-१२", "content_sanskrit": "वेदान्ताश्च पुराणानि इतिहासं पुरातनम् ।\nजामदग्न्यमृते राजन्को द्रोणादधिको भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2033756, "chapter_id": 1728, "verse_number": "४-५१-१३", "content_sanskrit": "ब्रह्मास्त्रं चैव वेदाश्च नैतदन्यत्र दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2033757, "chapter_id": 1728, "verse_number": "४-५१-१४", "content_sanskrit": "आचार्यपुत्रः क्षमतां नायं कालो विभेदने ।\nसर्वे संहत्य युद्ध्यामः पाकशासनिमागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2033758, "chapter_id": 1728, "verse_number": "४-५१-१५", "content_sanskrit": "बलस्य व्यसनानीह यान्युक्तानि मनीषिभिः ।\nमुख्यो भेदोहि तेषां तु पापिष्ठो विदुषां मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2033759, "chapter_id": 1728, "verse_number": "४-५१-१६x", "content_sanskrit": "अश्वत्थामोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2033760, "chapter_id": 1728, "verse_number": "४-५१-१६", "content_sanskrit": "नैवं न्याय्यमिदं वाच्यमस्माकं पुरुषर्षभ ।\nकिंतु रोषपरीतेन गुरुणा भाषिता गुणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2033761, "chapter_id": 1728, "verse_number": "४-५१-१७", "content_sanskrit": "शत्रोरपि गुणा ग्राह्या दोषा वाच्या गुरोरपि ।\nसर्वथा सर्वयत्नेन पुत्रे शिष्ये हितं वदेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2033762, "chapter_id": 1728, "verse_number": "४-५१-१८", "content_sanskrit": "आचार्य एष क्षमतां शान्तिरत्र विधीयताम् ।\nअभिद्यमाने तु गुरौ निवृत्तं रोषकारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2033763, "chapter_id": 1728, "verse_number": "४-५१-१९x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2033764, "chapter_id": 1728, "verse_number": "४-५१-१९", "content_sanskrit": "ततो दुर्योधनो द्रोणं क्षमयामास भारत।\nसह कर्णेन भीष्मेण कृपं चैव महाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2033765, "chapter_id": 1728, "verse_number": "४-५१-२०x", "content_sanskrit": "द्रोण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2033766, "chapter_id": 1728, "verse_number": "४-५१-२०", "content_sanskrit": "यदेतत्प्रथमं वाक्यं भीष्मः शान्तनवोऽब्रवीत्।\nतेनैवाहं प्रसन्नो वै परमत्र विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2033767, "chapter_id": 1728, "verse_number": "४-५१-२१", "content_sanskrit": "यथा दुर्योधनं पार्थो नोपसर्पति संगरे।\nसाहसाद्यदि वा मोहात्तथा नीतिर्विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2033768, "chapter_id": 1728, "verse_number": "४-५१-२२", "content_sanskrit": "वनवासे ह्यनिर्वृत्ते दर्शयेन्न धनञ्जयः ।\nधनं चालभमानोऽत्र नाद्य तत्क्षन्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2033769, "chapter_id": 1728, "verse_number": "४-५१-२३", "content_sanskrit": "यथा नायं समायुञ्ज्याद्धार्तराष्ट्रं कथंचन ।\nन च सेनां पराजय्यात्तथा नीतिर्विधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2033770, "chapter_id": 1728, "verse_number": "४-५१-२४", "content_sanskrit": "उक्तं दुर्योधनेनापि पुरस्ताद्वाक्यमीदृशम् ।\nतदनुस्मृत्य गाङ्गेय यथावद्वक्तुमर्हसि ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2033771, "chapter_id": 1728, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि एकपञ्चाशोऽध्यायः ॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}]