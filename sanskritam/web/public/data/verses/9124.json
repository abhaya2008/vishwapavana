[{"id": 5000124000, "chapter_id": 9124, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे सप्तचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000124001, "chapter_id": 9124, "verse_number": "२-४७-१", "content_sanskrit": "प्रभातायां तु शर्वर्यां पौरास्ते राघवं विना।\nशोकोपहतनिश्चेष्टा बभूवुर्हतचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000124002, "chapter_id": 9124, "verse_number": "२-४७-२", "content_sanskrit": "शोकजाश्रुपरिद्यूना वीक्षमाणास्ततस्ततः।\nआलोकमपि रामस्य न पश्यन्ति स्म दुःखिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000124003, "chapter_id": 9124, "verse_number": "२-४७-३", "content_sanskrit": "ते विषादार्तवदना रहितास्तेन धीमता।\nकृपणाः करुणा वाचो वदन्ति स्म मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000124004, "chapter_id": 9124, "verse_number": "२-४७-४", "content_sanskrit": "धिगस्तु खलु निद्रां तां ययापहतचेतसः।\nनाद्य पश्यामहे रामं पृथूरस्कं महाभुजम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000124005, "chapter_id": 9124, "verse_number": "२-४७-५", "content_sanskrit": "कथं रामो महाबाहुः स तथावितथक्रियः।\nभक्तं जनमभित्यज्य प्रवासं तापसो गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000124006, "chapter_id": 9124, "verse_number": "२-४७-६", "content_sanskrit": "यो नः सदा पालयति पिता पुत्रानिवौरसान्।\nकथं रघूणां स श्रेष्ठस्त्यक्त्वा नो विपिनं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000124007, "chapter_id": 9124, "verse_number": "२-४७-७", "content_sanskrit": "इहैव निधनं याम महाप्रस्थानमेव वा।\nरामेण रहितानां नो किमर्थं जीवितं हितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000124008, "chapter_id": 9124, "verse_number": "२-४७-८", "content_sanskrit": "सन्ति शुष्काणि काष्ठानि प्रभूतानि महान्ति च।\nतैः प्रज्वाल्य चितां सर्वे प्रविशामोऽथवा वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000124009, "chapter_id": 9124, "verse_number": "२-४७-९", "content_sanskrit": "किं वक्ष्यामो महाबाहुरनसूयः प्रियंवदः।\nनीतः स राघवोऽस्माभिरिति वक्तुं कथं क्षमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000124010, "chapter_id": 9124, "verse_number": "२-४७-१०", "content_sanskrit": "सा नूनं नगरी दीना दृष्ट्वास्मान् राघवं विना।\nभविष्यति निरानन्दा सस्त्रीबालवयोऽधिका ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000124011, "chapter_id": 9124, "verse_number": "२-४७-११", "content_sanskrit": "निर्यातास्तेन वीरेण सह नित्यं महात्मना।\nविहीनास्तेन च पुनः कथं द्रक्ष्याम तां पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000124012, "chapter_id": 9124, "verse_number": "२-४७-१२", "content_sanskrit": "इतीव बहुधा वाचो बाहुमुद्यम्य ते जनाः।\nविलपन्ति स्म दुःखार्ता हृतवत्सा इवाग्र्यगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000124013, "chapter_id": 9124, "verse_number": "२-४७-१३", "content_sanskrit": "ततो मार्गानुसारेण गत्वा किंचित् ततः क्षणम्।\nमार्गनाशाद् विषादेन महता समभिप्लुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000124014, "chapter_id": 9124, "verse_number": "२-४७-१४", "content_sanskrit": "रथमार्गानुसारेण न्यवर्तन्त मनस्विनः।\nकिमिदं किं करिष्यामो दैवेनोपहता इति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000124015, "chapter_id": 9124, "verse_number": "२-४७-१५", "content_sanskrit": "तदा यथागतेनैव मार्गेण क्लान्तचेतसः।\nअयोध्यामगमन् सर्वे पुरीं व्यथितसज्जनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000124016, "chapter_id": 9124, "verse_number": "२-४७-१६", "content_sanskrit": "आलोक्य नगरीं तां च क्षयव्याकुलमानसाः।\nआवर्तयन्त तेऽश्रूणि नयनैः शोकपीडितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000124017, "chapter_id": 9124, "verse_number": "२-४७-१७", "content_sanskrit": "एषा रामेण नगरी रहिता नातिशोभते।\nआपगा गरुडेनेव ह्रदादुद्‍धृतपन्नगा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000124018, "chapter_id": 9124, "verse_number": "२-४७-१८", "content_sanskrit": "चन्द्रहीनमिवाकाशं तोयहीनमिवार्णवम्।\nअपश्यन् निहतानन्दं नगरं ते विचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000124019, "chapter_id": 9124, "verse_number": "२-४७-१९", "content_sanskrit": "ते तानि वेश्मानि महाधनानि\nदुःखेन दुःखोपहता विशन्तः।\nनैव प्रजग्मुः स्वजनं परं वा\nनिरीक्ष्यमाणाः प्रविनष्टहर्षाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000124020, "chapter_id": 9124, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे सप्तचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]