[{"id": 2101831, "chapter_id": 3197, "verse_number": "१४-५३-१", "content_sanskrit": "वैशम्पायन उवाच।\nतथा प्रयान्तं वार्ष्णेयं द्वारकां भरतर्षभाः।\nपरिष्वज्य न्यवर्तन्त सानुयात्राः परंतपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2101832, "chapter_id": 3197, "verse_number": "१४-५३-२", "content_sanskrit": "पुनःपुनश्च वार्ष्णेयं पर्यष्वजत फल्गुनः।\nआचक्षुर्विषयाच्चैनं स ददर्श पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2101833, "chapter_id": 3197, "verse_number": "१४-५३-३", "content_sanskrit": "कृच्छ्रेणैव तु तां पार्तो गोविन्दे विनिवेशिताम्।\nसंजहार ततो दृष्टिं कृष्णश्चाप्यपराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2101834, "chapter_id": 3197, "verse_number": "१४-५३-४", "content_sanskrit": "तस्य प्रयाणे यान्यासन्निमित्तानि महात्मनः।\nबहून्यद्भुतरूपाणि तानि मे गदतः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2101835, "chapter_id": 3197, "verse_number": "१४-५३-५", "content_sanskrit": "वायुर्वेगेन महता रथस्य पुरतो ववौ।\nकुर्वन्निःशर्करं मार्गं विरजस्कमकण्टकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2101836, "chapter_id": 3197, "verse_number": "१४-५३-६", "content_sanskrit": "ववर्ष वासवश्चैव तोयं शुचि सुगन्धि च।\nदिव्यानि चैव पुष्पाणि पुरतः शाङ्गधन्वनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2101837, "chapter_id": 3197, "verse_number": "१४-५३-७", "content_sanskrit": "स प्रयातो महाबाहुः समेषु मरुधन्वसु।\nददर्शाथ मुनिश्रेष्ठमुदङ्कममितौजसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2101838, "chapter_id": 3197, "verse_number": "१४-५३-८", "content_sanskrit": "`महर्षिं सिद्धतपसं सर्वलोकान्तविश्रुतम्।\nस तं सम्पूज्य तेजस्वी मुनिं पृथुललोचनः।\nपूजितस्तेन च तदा पर्यपृच्छदनामयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2101839, "chapter_id": 3197, "verse_number": "१४-५३-९", "content_sanskrit": "स पृष्टः कुशलं तेन सम्पूज्य मधुसूदनम्।\nउदङ्को ब्राह्मणश्रेष्ठस्ततः पप्रच्छ माधवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2101840, "chapter_id": 3197, "verse_number": "१४-५३-१०", "content_sanskrit": "कच्चिच्छौरे त्वया गत्वा कुरुपाण्डवसद्म तत्।\nकृतं सौभ्रात्रमचलं तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2101841, "chapter_id": 3197, "verse_number": "१४-५३-११", "content_sanskrit": "अपि सन्धाय तान्वीरानुपावृत्तोसि केशव।\nसम्बन्दिनःक स्वदयितान्सततं वृष्णिपुङ्गव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2101842, "chapter_id": 3197, "verse_number": "१४-५३-१२", "content_sanskrit": "कच्चित्पाण्डुसुताः पञ्च धृतराष्ट्रस्य चात्मजाः।\nलोकेषु विहरिष्यन्ति त्वया सह परंतप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2101843, "chapter_id": 3197, "verse_number": "१४-५३-१३", "content_sanskrit": "स्वराष्ट्रे ते च राजानः कच्चित्प्राप्स्यन्ति वै सुखम्।\nकौरवेषु प्रशान्तेषु त्वया नाथेन केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2101844, "chapter_id": 3197, "verse_number": "१४-५३-१४", "content_sanskrit": "या मे सम्भावना तात त्वयि नित्यमवर्तत।\nअपि सा सफला तात कृता ते भरतान्प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2101845, "chapter_id": 3197, "verse_number": "१४-५३-१५x", "content_sanskrit": "श्रीभगवानुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2101846, "chapter_id": 3197, "verse_number": "१४-५३-१५", "content_sanskrit": "कृतो यत्नो मया पूर्वं सौशाम्ये कौरवान्प्रति।\nनाशक्यन्त यदा साम्ये ते स्थापयितुमञ्जसा।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2101847, "chapter_id": 3197, "verse_number": "१४-५३-१६", "content_sanskrit": "न दिष्टमप्यतिक्रान्तुं शक्यं बुद्ध्या बलेन वा।\nमहर्षे विदितं भूयः सर्वमेतत्तवानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2101848, "chapter_id": 3197, "verse_number": "१४-५३-१७", "content_sanskrit": "तेऽत्यक्रामन्मतिं मह्यं भीष्मस्य विदुरस्य च।\nततो यमक्षयं जग्मुः समासाद्येतरेतरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2101849, "chapter_id": 3197, "verse_number": "१४-५३-१८", "content_sanskrit": "पञ्चैव पाण्डवाः शिष्टा इतमित्रा हतात्मजाः।\nधार्तराष्ट्राश्च निहताः सर्वे ससुतबान्धवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2101850, "chapter_id": 3197, "verse_number": "१४-५३-१९", "content_sanskrit": "इत्युक्तवचने कृष्णे भृशं क्रोधसमन्वितः।\nउदङ्क इत्युवाचैनं रोषादुत्फुल्ललोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2101851, "chapter_id": 3197, "verse_number": "१४-५३-२०", "content_sanskrit": "यस्माच्छक्तेन ते कृष्ण न त्राताः कुरुपुङ्गवाः।\nसम्बन्धिनः प्रियास्तस्माच्छप्स्येऽहं त्वामसंशयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2101852, "chapter_id": 3197, "verse_number": "१४-५३-२१", "content_sanskrit": "न च ते प्रसभं यस्मात्ते निगृह्य निवारिताः।\nतस्मान्मन्युपरीतस्त्वां शप्स्यामि मधुसूदन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2101853, "chapter_id": 3197, "verse_number": "१४-५३-२२", "content_sanskrit": "त्वया शक्तेन हि सता मिथ्याचारेणि माधव।\nते परीताः कुरुश्रेष्ठा नश्यन्तः स्म ह्युपेक्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2101854, "chapter_id": 3197, "verse_number": "१४-५३-२३x", "content_sanskrit": "वासुदेव उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2101855, "chapter_id": 3197, "verse_number": "१४-५३-२३", "content_sanskrit": "शृणु मे विस्तरेणेदं यद्वक्ष्ये भृगुनन्दन।\nगृहाणानुनयं चापि तपस्वी ह्यसि भार्गवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2101856, "chapter_id": 3197, "verse_number": "१४-५३-२४", "content_sanskrit": "श्रुत्वा च मे तदध्यात्मं मुञ्चेथाः शापमद्य वै।\nन च मां तपसाऽल्पेन शक्तोऽभिभवितुं पुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2101857, "chapter_id": 3197, "verse_number": "१४-५३-२५", "content_sanskrit": "न च ते तपसो नाशमिच्छामि तपतां वर।\nतपस्ते सुमहद्दीप्तं गुरवश्चापि तोषिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2101858, "chapter_id": 3197, "verse_number": "१४-५३-२६", "content_sanskrit": "कौमारं ब्रह्मचर्यं ते जानामि द्विजसत्तम।\nदुःखार्जितस्य तपसस्तस्मान्नेच्चामि तेऽव्ययम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2101859, "chapter_id": 3197, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि त्रिपञ्चाशोऽध्यायः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]