[{"id": 7003553000, "chapter_id": 23553, "verse_number": "१९३-१", "content_sanskrit": "अथ नचिकेतः प्रयाणवर्णनम् ।\nलोमहर्षण उवाच ।\nव्यासशिष्यं महाप्राज्ञं वेदवेदाङ्गपारगम् ।\nद्वारदेशे समासीनं कृतपूर्वाह्णिकक्रियम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003553001, "chapter_id": 23553, "verse_number": "१९३-२", "content_sanskrit": "अश्वमेधे तथा वृत्ते राजा वै जनमेजयः ।\nब्रह्मवध्याभिभूतस्य दीक्षां द्वादशवार्षिकीम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003553002, "chapter_id": 23553, "verse_number": "१९३-३", "content_sanskrit": "प्रायश्चित्तं चरित्वैवमागतो गजसाह्वयम् ।\nउपगम्य महात्मानं जाह्नवीतीरसंश्रयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003553003, "chapter_id": 23553, "verse_number": "१९३-४", "content_sanskrit": "ऋषिं परमसम्पन्नं वैशम्पायनमञ्जसा ।\nकर्मणा प्रेरितस्तेन चिन्ताव्याकुललोचनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003553004, "chapter_id": 23553, "verse_number": "१९३-५", "content_sanskrit": "कुरूणां पश्चिमो राजा पश्चात्तापेन पीडितः।\nव्यासशिष्यमुपागम्य प्रश्नमेनमपृच्छत ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003553005, "chapter_id": 23553, "verse_number": "१९३-६", "content_sanskrit": "जनमेजय उवाच ।\nभगवञ्जायते तीव्रं चिन्तयानस्य सुव्रत ।\nकर्मपाकफलं यस्मिन्मानुषैरुप भुज्यते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003553006, "chapter_id": 23553, "verse_number": "१९३-७", "content_sanskrit": "एतदिच्छाम्यहं श्रोतुं कीदृशं तु यमालयम् ।\nकिं प्रमाणं च किं रूपं कथं गत्वा स पश्यति ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003553007, "chapter_id": 23553, "verse_number": "१९३-८", "content_sanskrit": "न गच्छेयं कथं विप्र प्रेतराज्ञो निवेशनम् ।\nधर्मराजस्य धीरस्य सर्वलोकानुशासिनः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003553008, "chapter_id": 23553, "verse_number": "१९३-९", "content_sanskrit": "सूत उवाच ।\nएवं पृष्टो महातेजास्तेन राज्ञा द्विजोत्तमः ।\nउवाच मधुरं वाक्यं राजानं जनमेजयम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003553009, "chapter_id": 23553, "verse_number": "१९३-१०", "content_sanskrit": "वैशम्पायन उवाच ।\nशृणु राजन्पुरावृत्तां कथां परमशोभनाम् ।\nधर्मवृद्धिकरीं नित्यां यशस्यां कीर्तिवर्द्धिनीम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003553010, "chapter_id": 23553, "verse_number": "१९३-११", "content_sanskrit": "पावनीं सर्वपापानां प्रवृत्तौ शुभकारिणीम् ।\nइतिहासपुराणानां कथां वै विदुषां प्रियाम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003553011, "chapter_id": 23553, "verse_number": "१९३-१२", "content_sanskrit": "कश्चिदासीत्पुरा राजनृषिः परमधार्मिकः ।\nउद्दालक इति ख्यातः सर्ववेदाङ्गतत्त्ववित् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003553012, "chapter_id": 23553, "verse_number": "१९३-१३", "content_sanskrit": "तस्य पुत्रो महातेजा योगमास्थाय बुद्धिमान् ।\nनाचिकेत इति ख्यातः सर्ववेदाङ्गतत्त्ववित् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003553013, "chapter_id": 23553, "verse_number": "१९३-१४", "content_sanskrit": "तेन रुष्टेन शप्तोऽभूत्पुत्रः परमधार्मिकः ।\nगच्छ शीघ्रं यमं पश्य मम क्रोधेन दुर्मते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003553014, "chapter_id": 23553, "verse_number": "१९३-१५", "content_sanskrit": "तथेत्युक्त्वा महातेजाः पुत्रः परमधार्मिकः ।\nचिन्तयित्वा मुहुर्तं तु योगमास्थाय बुद्धिमान् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003553015, "chapter_id": 23553, "verse_number": "१९३-१६", "content_sanskrit": "क्षणेनान्तर्हितो जातः पितरं प्रत्युवाच ह ।\nविनयात्पृष्ठतो वाक्यं भावेन च समन्वितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003553016, "chapter_id": 23553, "verse_number": "१९३-१७", "content_sanskrit": "मा भूद्वाक्यं च ते मिथ्या धार्मिकस्य कदाचन ।\nगमिष्यामि पुरं रम्यं धर्मराजस्य धीमतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003553017, "chapter_id": 23553, "verse_number": "१९३-१८", "content_sanskrit": "इह चैव पुनस्तावदागमिष्ये न संशयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003553018, "chapter_id": 23553, "verse_number": "१९३-१९", "content_sanskrit": "पितोवाच ।\nएकस्त्वमसि वत्सश्च नान्यो बन्धुर्विधीयते ।\nअधर्मं चानृतं चास्तु त्वकीर्त्तिर्वापि पुत्रक ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003553019, "chapter_id": 23553, "verse_number": "१९३-२०", "content_sanskrit": "मिथ्याभिशंसिनं तात यथेष्टं तारयिष्यति ।\nरोषेण हि मृषावादी निर्दयः कुलपांसनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003553020, "chapter_id": 23553, "verse_number": "१९३-२१", "content_sanskrit": "अप्रवृत्तस्त्वसम्भाष्यो योऽहं मिथ्या प्रयुक्तवान् ।\nत्वां वै धर्मसमाचारमभिधानेन शप्तवान् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003553021, "chapter_id": 23553, "verse_number": "१९३-२२", "content_sanskrit": "अहं पुत्र न सद्वादी न क्षमे धर्मदूषितम् ।\nमम त्वं हि महाभाग नित्यं चित्तानुपालकः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003553022, "chapter_id": 23553, "verse_number": "१९३-२३", "content_sanskrit": "धर्मज्ञश्च यशस्वी च नित्यं क्षान्तो जितेन्द्रियः।\nशु्श्रूषुरनहंवादी शक्तस्तारयितुं मम ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003553023, "chapter_id": 23553, "verse_number": "१९३-२४", "content_sanskrit": "याचितस्त्वं मया पुत्र गन्तुं वै तत्र नार्हसि ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003553024, "chapter_id": 23553, "verse_number": "१९३-२५", "content_sanskrit": "यदि वैवस्वतो राजा तत्र प्राप्तं यदृच्छया।\nरोषेण त्वां महातेजा विसृजेन्न कदाचन ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003553025, "chapter_id": 23553, "verse_number": "१९३-२६", "content_sanskrit": "विनश्येयमहं पश्य कुलसेतुविनाशनः।\nधिक्कृतः सर्वलोकेन पापकर्त्ता नराधमः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003553026, "chapter_id": 23553, "verse_number": "१९३-२७", "content_sanskrit": "नरकस्य पुदित्याख्या दुःखेन नरकं विदुः ।\nपुतित्राणं भवेत्पुत्रादिहेष्यति परत्र च ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003553027, "chapter_id": 23553, "verse_number": "१९३-२८", "content_sanskrit": "हुतं दत्तं तपस्तप्तं पितरश्चापि पोषिताः ।\nअपुत्रस्य हि तत्सर्वं मोघं भवति निश्चयः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003553028, "chapter_id": 23553, "verse_number": "१९३-२९", "content_sanskrit": "शुश्रूषावान्भवेच्छूद्रो वैश्यो वा कृषिजीवनः॥।\nसस्यगोप्ता तु राजन्यो ब्राह्मणो वा स्वकर्मकृत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003553029, "chapter_id": 23553, "verse_number": "१९३-३०", "content_sanskrit": "तपो वा विपुलं तप्त्वा दत्त्वा दानमनुत्तमम् ।\nअपुत्रो नाप्नुयात्स्वर्गं यथा तात मया श्रुतम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003553030, "chapter_id": 23553, "verse_number": "१९३-३१", "content_sanskrit": "पुत्रेण लभते जन्म पौत्रेण तु पितामहः ।\nपुत्रस्य च प्रपौत्रेण मोदते प्रपितामहः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003553031, "chapter_id": 23553, "verse_number": "१९३-३२", "content_sanskrit": "न हास्यामीति वत्स त्वां मम वंशविवर्द्धनम् ।\nयाच्यमानः प्रयत्नेन तत्र गन्तुं न चार्हति ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003553032, "chapter_id": 23553, "verse_number": "१९३-३३", "content_sanskrit": "वैशम्पायन उवाच ।\nएवं विलपमानं तं पितरं प्रत्युवाच ह ।\nहृष्टपुष्ट वपुर्भूत्वा पुत्रः परमधार्मिकः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003553033, "chapter_id": 23553, "verse_number": "१९३-३४", "content_sanskrit": "पुत्र उवाच ।\nन विषादस्त्वया कार्यो द्रक्ष्यसे मामिहागतम् ।\nदृष्ट्वा च तमहं देवं सर्वलोकनमस्कृतम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003553034, "chapter_id": 23553, "verse_number": "१९३-३५", "content_sanskrit": "आगच्छामि पुनश्चात्र न भयं मेऽस्ति मृत्युतः ।\nपूजयिष्यति मां तात राजा त्वदनुकंपया ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003553035, "chapter_id": 23553, "verse_number": "१९३-३६", "content_sanskrit": "सत्ये तिष्ठ महाभाग सत्यं च परिपालय ।\nसत्यं स्वर्गस्य सोपानं पारावारस्य नौरिव ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003553036, "chapter_id": 23553, "verse_number": "१९३-३७", "content_sanskrit": "सूर्यस्तपति सत्येन वातः सत्येन वाति च ।\nअग्निर्दहति सत्येन सत्येन पृथिवी स्थिता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003553037, "chapter_id": 23553, "verse_number": "१९३-३८", "content_sanskrit": "उदधिर्ल्लङ्घयेन्नैव मर्यादां सत्यपालितः ।\nमन्त्रः प्रयुक्तः सत्येन सर्वलोकहितायते ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003553038, "chapter_id": 23553, "verse_number": "१९३-३९", "content_sanskrit": "सत्येन यज्ञा वर्त्तन्ते मन्त्रपूताः सुपूजिताः ।\nसत्येन वेदा गायन्ति सत्ये लोकाः प्रतिष्ठिताः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003553039, "chapter_id": 23553, "verse_number": "१९३-४०", "content_sanskrit": "सत्यं गाति तथा साम सर्वं सत्ये प्रतिष्ठितम् ।\nसत्यं स्वर्गश्च धर्मश्च सत्यादन्यन्न विद्यते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003553040, "chapter_id": 23553, "verse_number": "१९३-४१", "content_sanskrit": "सत्येन सर्वं लभते यथा तात मया श्रुतम् ।\nन हि सत्यमतिक्रम्य विद्यते किंचिदुत्तमम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003553041, "chapter_id": 23553, "verse_number": "१९३-४२", "content_sanskrit": "देवदेवेन रुद्रेण वेदगर्भः पुरा किल ।\nसत्यस्थितेन देवानां परित्यक्तो महात्मना ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003553042, "chapter_id": 23553, "verse_number": "१९३-४३", "content_sanskrit": "दीक्षां धारयते ब्रह्मा स तेनैव सुयन्त्रितः ।\nऔर्वेणाग्निस्तथा क्षिप्तः सत्येन वडवामुखे ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003553043, "chapter_id": 23553, "verse_number": "१९३-४४", "content_sanskrit": "संवर्तेन पुरा तात सर्वे लोकाः सदैवताः ।\nदेवानामनुकंपार्थं धृता वीर्यवता तदा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003553044, "chapter_id": 23553, "verse_number": "१९३-४५", "content_sanskrit": "पाताले पालयन् सत्यं बद्धो वैरोचनो वसन् ।\nवर्द्धमानो महाशृङ्गैः शतशृङ्गो महागिरिः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003553045, "chapter_id": 23553, "verse_number": "१९३-४६", "content_sanskrit": "स्थितः सत्ये महाविन्ध्यो वर्द्धमानो न वर्द्धते ।\nसर्वं चराचरमिदं सत्येन श्रीयते जगत् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003553046, "chapter_id": 23553, "verse_number": "१९३-४७", "content_sanskrit": "गृहधर्माश्च ये दृष्टा वानप्रस्थाश्च शोभिताः ।\nयतीनां च गतिः शुद्धा ये चान्ये व्रतसंस्थिताः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003553047, "chapter_id": 23553, "verse_number": "१९३-४८", "content_sanskrit": "अश्वमेधसहस्रं च सत्यं च तुलया धृतम् ।\nअश्वमेधसहस्राद्धि सत्यमेव विशिष्यते ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003553048, "chapter_id": 23553, "verse_number": "१९३-४९", "content_sanskrit": "सत्येन पाल्यते धर्मो धर्मो रक्षति रक्षितः ।\nतस्मात् सत्यं कुरुष्वाद्य रक्ष आत्मानमात्मना ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003553049, "chapter_id": 23553, "verse_number": "१९३-५०", "content_sanskrit": "एवमुक्त्वा हृष्टपुष्टः स्वेन देहेन सुव्रत ।\nतपसा प्राप्तयोगस्तु जितात्मा कृतसंयमः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003553050, "chapter_id": 23553, "verse_number": "१९३-५१", "content_sanskrit": "ऋषिपुत्रो महातेजा सत्यवागनसूयकः ।\nप्राप्तश्च परमं स्थानं यत्र राज्ञो यमस्य तु ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]