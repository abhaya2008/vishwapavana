[{"id": 7005786000, "chapter_id": 25786, "verse_number": "२५९-१", "content_sanskrit": "अतः परं प्रवक्ष्यामि देवाकारान् विशेषतः ।\nदशतालः स्मृतो रामो बलिर्वैरोचनिस्तथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005786001, "chapter_id": 25786, "verse_number": "२५९-२", "content_sanskrit": "वराहो नारसिंहश्च सप्ततालस्तु वामनः ।\nमत्स्यकूर्मौ च निर्दिष्टौ यथा शोभं स्वयम्भुवा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005786002, "chapter_id": 25786, "verse_number": "२५९-३", "content_sanskrit": "अतः परं प्रवक्ष्यामि रुद्राद्याकारमुत्तमम् ।\nस पीनोरुभुजस्कन्ध स्तप्तकाञ्चनसप्रभः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005786003, "chapter_id": 25786, "verse_number": "२५९-४", "content_sanskrit": "शुक्लोऽर्करश्मिसंघात श्चन्द्राङ्कितजटो विभुः ।\nजटामुकुटधारी च द्व्यष्टवर्षाकृतिश्च सः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005786004, "chapter_id": 25786, "verse_number": "२५९-५", "content_sanskrit": "बाहुवारणहस्ताभो वृतजङ्घोरुमण्डलः ।\nऊद्‌र्ध्वकेशश्च कर्तव्यो दीर्घायतविलोचनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005786005, "chapter_id": 25786, "verse_number": "२५९-६", "content_sanskrit": "व्याघ्रचर्मपरीधानः कटिसूत्र त्रयान्वितः ।\nहारकेयूरसम्पन्नो भुजङ्गाभरणस्तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005786006, "chapter_id": 25786, "verse_number": "२५९-७", "content_sanskrit": "बाहवश्चापि कर्तव्या नानाभरणभूषिताः ।\nपीनोरुगण्डफलकः कुण्डलाभ्यामलंकृतः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005786007, "chapter_id": 25786, "verse_number": "२५९-८", "content_sanskrit": "आजानुलम्बबाहुश्च सौम्यमूर्तिः सुशोभनः ।\nखेटकं वामहस्ते तु शङ्खञ्चैव तु दक्षिणे ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005786008, "chapter_id": 25786, "verse_number": "२५९-९", "content_sanskrit": "शक्तिं दण्डं त्रिशूल़ञ्च दक्षिणेषु निवेशयेत् ।\nकपालं वामपर्श्वे तु नागं खट्वाङ्गमेव च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005786009, "chapter_id": 25786, "verse_number": "२५९-१०", "content_sanskrit": "एकश्च वरदो हस्तस्तथाक्षवलयोऽपरः ।\nवैशाखस्थानकं कृत्वा नृत्याभिनयसंस्थितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005786010, "chapter_id": 25786, "verse_number": "२५९-११", "content_sanskrit": "नृत्यन्दशभुजः कार्यो गजचर्मधरस्तथा ।\nतथा त्रिपुरदाहे च बाहवः षोड़शैव तु ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005786011, "chapter_id": 25786, "verse_number": "२५९-१२", "content_sanskrit": "शङ्खं चक्रं गदाशार्ङ्गं घण्टा तत्राधिका भवेत् ।\nतथा धनुः पिनाकञ्च शरो विष्णुमयस्तथा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005786012, "chapter_id": 25786, "verse_number": "२५९-१३", "content_sanskrit": "चतुर्भुजोऽष्ट बाहुर्वा ज्ञानयोगेश्वरो मतः ।\nतीक्ष्णनासाग्रदशनः करालवदनो महान् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005786013, "chapter_id": 25786, "verse_number": "२५९-१४", "content_sanskrit": "भैरवः शस्यते लोके प्रत्यायतनसंस्थितः ।\nन मूलायतने कार्ये भैरवस्तु भयङ्करः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005786014, "chapter_id": 25786, "verse_number": "२५९-१५", "content_sanskrit": "नारसिंह वराहो वा तथान्येऽपि भयङ्कराः ।\nनाधिकाङ्गां न हीनाङ्गां कर्तव्या देवताः क्वचित् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005786015, "chapter_id": 25786, "verse_number": "२५९-१६", "content_sanskrit": "स्वामिनं घातयेन्न्यूना करालवदना तथा ।\nअधिका शिल्पिनं हन्यात् कृशा चैवार्थनाशिनी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005786016, "chapter_id": 25786, "verse_number": "२५९-१७", "content_sanskrit": "कृशोदरी तु दुर्भिक्षं निर्मांसा धननाशिनी ।\nवक्रनासा तु दुःखाय सङ्क्षिप्ताङ्गी भयङ्करी ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005786017, "chapter_id": 25786, "verse_number": "२५९-१८", "content_sanskrit": "चिपिटा दुःखशोकाय अनेत्रा नेत्रनाशिनी ।\nदुःखदा हीनवक्त्रा तु पाणिपादकृशा तथा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005786018, "chapter_id": 25786, "verse_number": "२५९-१९", "content_sanskrit": "हीनाङ्गी हीनजङ्घा च भ्रमोन्मादकरी नृणाम् ।\nशुष्कवक्त्रा तु राजानं कटिहीना च या भवेत् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005786019, "chapter_id": 25786, "verse_number": "२५९-२०", "content_sanskrit": "पाणिपादविहीनो यो जायते मारको महान् ।\nजङ्घाजानुवीहिना च शत्रुकल्याणकारिणी ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005786020, "chapter_id": 25786, "verse_number": "२५९-२१", "content_sanskrit": "पुत्रमित्रविनाशाय हीनवक्षस्थला तु या ।\nसम्पूर्णावयवा या तु आयुर्लक्ष्मी प्रदा सदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005786021, "chapter_id": 25786, "verse_number": "२५९-२२", "content_sanskrit": "एवं लक्षणमासाद्य कर्तव्यः परमेश्वरः ।\nस्तूयमानः सुरैः सर्वैः समन्ताद्दर्शयेद् भवम् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005786022, "chapter_id": 25786, "verse_number": "२५९-२३", "content_sanskrit": "शक्रेण नन्दिना चैव महाकालेन शङ्करम् ।\nप्रणता लोकपालास्तु पार्श्वे तु गणनायकाः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005786023, "chapter_id": 25786, "verse_number": "२५९-२४", "content_sanskrit": "नृत्यद्भृङ्गीरिटिश्चैव भूतवेतालसंवृताः ।\nसर्वे हृष्टास्तु कर्तव्याः स्तुवन्तः परमेश्वरम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005786024, "chapter_id": 25786, "verse_number": "२५९-२५", "content_sanskrit": "गन्धर्व विद्याधर किन्नराणामथाप्सरो गुह्यकनायकानाम् ।\nगणैरनेकैः शतशो महेन्द्रैर्मुनिप्रवीरैरपि नम्यमानम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005786025, "chapter_id": 25786, "verse_number": "२५९-२६", "content_sanskrit": "धृताक्षसूत्रैः शतशः प्रबाल पुष्पोपहार प्रचयन्ददद्भिः ।\nसंस्तूयमानं भगवन्तमीड्यं नेत्रत्रयेणामरमर्त्यपूज्यम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]