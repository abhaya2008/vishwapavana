[{"id": 6000321000, "chapter_id": 10321, "verse_number": null, "content_sanskrit": "अथ विंशाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000321001, "chapter_id": 10321, "verse_number": null, "content_sanskrit": "उद्धव उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.001.m4a", "display_order": 2}, {"id": 6000321002, "chapter_id": 10321, "verse_number": "११-२०-१", "content_sanskrit": "विधिश्च प्रतिषेधश्च निगमो हीश्वरस्य ते।\nअपेक्षतेऽरविन्दाक्ष गुणदोषं च कर्मणाम्॥ ११/२०/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.002.m4a", "display_order": 3, "topics": [{"text": "भक्तिज्ञानक्रियात्मकयोगकथनम्", "range": "१–३८"}]}, {"id": 6000321003, "chapter_id": 10321, "verse_number": "११-२०-२", "content_sanskrit": "वर्णाश्रमविकल्पं च प्रतिलोमानुलोमजम्।\nद्रव्यदेशवयःकालान् स्वर्गं नरकमेव च॥ ११/२०/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.003.m4a", "display_order": 4}, {"id": 6000321004, "chapter_id": 10321, "verse_number": "११-२०-३", "content_sanskrit": "गुणदोषभिदादृष्टिमन्तरेण वचस्तव।\nनैःश्रेयसं कथं नु स्यान्निषेधविधिलक्षणम्॥ ११/२०/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.004.m4a", "display_order": 5}, {"id": 6000321005, "chapter_id": 10321, "verse_number": "११-२०-४", "content_sanskrit": "पितृदेवमनुष्याणां वेदश्चक्षुस्तवेश्वर।\nश्रेयस्त्वनुपलब्धेऽर्थे साध्यसाधनयोरपि॥ ११/२०/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.005.m4a", "display_order": 6}, {"id": 6000321006, "chapter_id": 10321, "verse_number": "११-२०-५", "content_sanskrit": "गुणदोषभिदादृष्टिर्नियमात् तेन हि स्वतः।\nनियमेनापवादश्च भिदाया इति हि भ्रमः॥ ११/२०/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.006.m4a", "display_order": 7}, {"id": 6000321007, "chapter_id": 10321, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.007.m4a", "display_order": 8}, {"id": 6000321008, "chapter_id": 10321, "verse_number": "११-२०-६", "content_sanskrit": "योगास्त्रयो मया प्रोक्ता नृणां श्रेयोविधित्सया।\nज्ञानं कर्म च भक्तिश्च नोपायोऽन्योऽस्ति कुत्रचित्॥ ११/२०/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.008.m4a", "display_order": 9}, {"id": 6000321009, "chapter_id": 10321, "verse_number": "११-२०-७", "content_sanskrit": "निर्विण्णानां ज्ञानयोगो न्यासिनामिह कर्मसु।\nतेष्वनिर्विण्णचित्तानां कर्मयोगस्तु कर्मिणाम्॥ ११/२०/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.009.m4a", "display_order": 10}, {"id": 6000321010, "chapter_id": 10321, "verse_number": "११-२०-८", "content_sanskrit": "यदृच्छया मत्कथादौ जातश्रद्धस्तु यः पुमान्।\nन निर्विण्णो नातिसक्तो भक्तियोगोऽस्य मुक्तिदः॥ ११/२०/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.010.m4a", "display_order": 11}, {"id": 6000321011, "chapter_id": 10321, "verse_number": "११-२०-९", "content_sanskrit": "तावत् कर्माणि कुर्वीत न निर्विद्येत यावता।\nमत्कथाश्रवणादौ वा श्रद्धा यावन्न जायते॥ ११/२०/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.011.m4a", "display_order": 12}, {"id": 6000321012, "chapter_id": 10321, "verse_number": "११-२०-१०", "content_sanskrit": "स्वधर्मस्थो यजन् यज्ञैरनाशीःकाम उद्धव।\nन याति स्वर्गनरकौ यद्यन्यन्न समाचरेत्॥ ११/२०/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.012.m4a", "display_order": 13}, {"id": 6000321013, "chapter_id": 10321, "verse_number": "११-२०-११", "content_sanskrit": "अस्मिंल्लोके वर्तमानः स्वधर्मस्थोऽनघः शुचिः।\nज्ञानं विशुद्धमाप्नोति मद्भक्तिं वा यदृच्छया॥ ११/२०/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.013.m4a", "display_order": 14}, {"id": 6000321014, "chapter_id": 10321, "verse_number": "११-२०-१२", "content_sanskrit": "स्वर्गिणोऽप्येतमिच्छन्ति लोकं निरयिणस्तथा।\nसाधकं ज्ञानभक्तिभ्यामुभयं तदसाधकम्॥ ११/२०/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.014.m4a", "display_order": 15}, {"id": 6000321015, "chapter_id": 10321, "verse_number": "११-२०-१३", "content_sanskrit": "न नरः स्वर्गतिं काङ्क्षेन्नारकीं च विचक्षणः।\nनेमं लोकं च काङ्क्षेत देहावेशात् प्रमाद्यति॥ ११/२०/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.015.m4a", "display_order": 16}, {"id": 6000321016, "chapter_id": 10321, "verse_number": "११-२०-१४", "content_sanskrit": "एवं विद्वान् पुरा मृत्योरभावाय घटेत सः।\nअप्रमत्त इदं ज्ञात्वा मर्त्यमप्यर्थसिद्धिदम्॥ ११/२०/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.016.m4a", "display_order": 17}, {"id": 6000321017, "chapter_id": 10321, "verse_number": "११-२०-१५", "content_sanskrit": "छिद्यमानं कालावयवैः कृतनीडं वनस्पतिम्।\nखगः स्वदेहमुत्सृज्य क्षेमं याति ह्यलम्पटः॥ ११/२०/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.017.m4a", "display_order": 18}, {"id": 6000321018, "chapter_id": 10321, "verse_number": "११-२०-१६", "content_sanskrit": "अहोरात्रैश्छिद्यमानं बुद्ध्वाऽयुर्भयवेपथुः।\nमुक्तसङ्गः परं बुद्ध्वा निरीह उपशाम्यति॥ ११/२०/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.018.m4a", "display_order": 19}, {"id": 6000321019, "chapter_id": 10321, "verse_number": "११-२०-१७", "content_sanskrit": "नृदेहमासाद्य सुदुर्लभं यः प्लवं सुकल्पं गुरुकर्णधारम्।\nमयाऽनुकूलेन नभस्वतेरितं पुमान् भवाब्धिं न तरेत् स मार्गणः॥ ११/२०/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.019.m4a", "display_order": 20}, {"id": 6000321020, "chapter_id": 10321, "verse_number": "११-२०-१८", "content_sanskrit": "यदाऽऽरम्भेषु निर्विण्णो विरक्तः संयतेन्द्रियः।\nअभ्यासेनात्मनो योगी धारयेदचलं मनः॥ ११/२०/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.020.m4a", "display_order": 21}, {"id": 6000321021, "chapter_id": 10321, "verse_number": "११-२०-१९", "content_sanskrit": "धार्यमाणं मनो यर्हि भ्राम्यदाश्वनवस्थितम्।\nअतन्द्रितोऽनुरोधेन मार्गेणात्मवशं नयेत्॥ ११/२०/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.021.m4a", "display_order": 22}, {"id": 6000321022, "chapter_id": 10321, "verse_number": "११-२०-२०", "content_sanskrit": "मनोऽगतिं न विसृजेज्जितप्राणो जितेन्द्रियः।\nसत्वसम्पन्नया बुद्ध्या मन आत्मवशं नयेत्॥ ११/२०/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.022.m4a", "display_order": 23}, {"id": 6000321023, "chapter_id": 10321, "verse_number": "११-२०-२१", "content_sanskrit": "एष वै परमो योगो मनसः सङ्ग्रहः स्मृतः।\nहृदयज्ञत्वमन्विच्छन् दमश्चैवेच्छतो मुहुः॥ ११/२०/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.023.m4a", "display_order": 24}, {"id": 6000321024, "chapter_id": 10321, "verse_number": "११-२०-२२", "content_sanskrit": "साङ्ख्येन सर्वभावानां प्रतिलोमानुलोमतः।\nभवाप्ययावनुध्यायेन्मनो यावत् प्रसीदति॥ ११/२०/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.024.m4a", "display_order": 25}, {"id": 6000321025, "chapter_id": 10321, "verse_number": "११-२०-२३", "content_sanskrit": "निर्विण्णस्य विरक्तस्य पुरुषस्यात्मवेदिनः।\nमनस्त्यजति दौरात्म्यं चिन्तितस्यानुचिन्तया॥ ११/२०/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.025.m4a", "display_order": 26}, {"id": 6000321026, "chapter_id": 10321, "verse_number": "११-२०-२४", "content_sanskrit": "यमादिभिर्योगपथैरान्वीक्षिक्या च विद्यया।\nममार्चोपासनाभिर्वा नान्यैर्योगं स्मरेन्मनः॥ ११/२०/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.026.m4a", "display_order": 27}, {"id": 6000321027, "chapter_id": 10321, "verse_number": "११-२०-२५", "content_sanskrit": "यदि कुर्यात् प्रमादेन योगी कर्म विगर्हितम्।\nयोगेनैव दहेदंहो नान्यं यत्नं कदाचन॥ ११/२०/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.027.m4a", "display_order": 28}, {"id": 6000321028, "chapter_id": 10321, "verse_number": "११-२०-२६", "content_sanskrit": "स्वे स्वेऽधिकारे या निष्ठा स गुणः परिकीर्तितः।\nविपर्ययस्तु दोषः स्यादुभयोरेष निर्णयः॥ ११/२०/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.028.m4a", "display_order": 29}, {"id": 6000321029, "chapter_id": 10321, "verse_number": "११-२०-२७", "content_sanskrit": "कर्मणां जात्यशुद्धानामनेन नियमः कृतः।\nगुणदोषविधानेन त्वंहसां त्याजनेच्छया॥ ११/२०/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.029.m4a", "display_order": 30}, {"id": 6000321030, "chapter_id": 10321, "verse_number": "११-२०-२८", "content_sanskrit": "जातश्रद्धो मत्कथासु निर्विण्णः सर्वकर्मसु।\nवेद दुःखात्मकान् कामान् परित्यागेऽप्यनीश्वरः॥ ११/२०/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.030.m4a", "display_order": 31}, {"id": 6000321031, "chapter_id": 10321, "verse_number": "११-२०-२९", "content_sanskrit": "ततो भजेत मां प्रीतः श्रद्धालुर्दृढनिश्चयः।\nजुषमाणश्च तान् कामान् दुःखोदर्कांश्च गर्हयन्॥ ११/२०/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.031.m4a", "display_order": 32}, {"id": 6000321032, "chapter_id": 10321, "verse_number": "११-२०-३०", "content_sanskrit": "प्रोक्तेन भक्तियोगेन भजतो माऽसकृन्मुनेः।\nकामा हृदिस्था नश्यन्ति सर्वे मयि हृदि स्थिते॥ ११/२०/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.032.m4a", "display_order": 33}, {"id": 6000321033, "chapter_id": 10321, "verse_number": "११-२०-३१", "content_sanskrit": "भिद्यते हृदयग्रन्थिश्छिद्यन्ते सर्वसंशयाः।\nक्षीयन्ते चास्य कर्माणि मयि दृष्टेऽखिलात्मनि॥ ११/२०/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.033.m4a", "display_order": 34}, {"id": 6000321034, "chapter_id": 10321, "verse_number": "११-२०-३२", "content_sanskrit": "तस्मान्मद्भक्तियुक्तस्य योगिनो वै मदात्मनः।\nन ज्ञानान्न च वैराग्यात् प्रायः श्रेयो भवेदिह॥ ११/२०/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.034.m4a", "display_order": 35}, {"id": 6000321035, "chapter_id": 10321, "verse_number": "११-२०-३३", "content_sanskrit": "यत् कर्मभिर्यत् तपसा ज्ञानवैराग्यतश्च यत्।\nयोगेन दानधर्मेण श्रेयोभिरितरैरपि॥ ११/२०/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.035.m4a", "display_order": 36}, {"id": 6000321036, "chapter_id": 10321, "verse_number": "११-२०-३४", "content_sanskrit": "सर्वं मद्भक्तियोगेन मद्भक्तो लभतेऽञ्जसा।\nस्वर्गापवर्गं मद्धाम कथञ्चिद् यदि वाञ्छति॥ ११/२०/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.036.m4a", "display_order": 37}, {"id": 6000321037, "chapter_id": 10321, "verse_number": "११-२०-३५", "content_sanskrit": "न किञ्चित् साधवो धीरा भक्ता ह्येकान्तिनो मम।\nवाञ्छन्त्यपि मया दत्तं कैवल्यमपुनर्भवम्॥ ११/२०/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.037.m4a", "display_order": 38}, {"id": 6000321038, "chapter_id": 10321, "verse_number": "११-२०-३६", "content_sanskrit": "नैरपेक्ष्यं परं प्राहुर्निःश्रेयसमकल्मषम्।\nतस्मान्निराशिषो भक्तिर्निरपेक्षस्य मे भवेत्॥ ११/२०/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.038.m4a", "display_order": 39}, {"id": 6000321039, "chapter_id": 10321, "verse_number": "११-२०-३७", "content_sanskrit": "न मय्येकान्तभक्तानां गुणदोषोद्भवा गुणाः ।\nसाधूनां समचित्तानां बुद्धेः पारमुपेयुषाम्॥ ११/२०/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.039.m4a", "display_order": 40}, {"id": 6000321040, "chapter_id": 10321, "verse_number": "११-२०-३८", "content_sanskrit": "एवमेतान् मयाऽऽदिष्टाननुतिष्ठन्ति मे पथः।\nक्षेमं विन्दन्ति मत्स्थानं यद् ब्रह्म परमं विदुः॥ ११/२०/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_020/BhP_11.020.040.m4a", "display_order": 41}, {"id": 6000321041, "chapter_id": 10321, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे विंशाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}]