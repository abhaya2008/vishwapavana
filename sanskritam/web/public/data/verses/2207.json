[{"id": 2055171, "chapter_id": 2207, "verse_number": "७-१३४-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2055172, "chapter_id": 2207, "verse_number": "७-१३४-१", "content_sanskrit": "सर्वथा विरथः कर्णः पुनर्भीमेन निर्जितः।\nरथमन्यं समास्थाय पुनर्विव्याध पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2055173, "chapter_id": 2207, "verse_number": "७-१३४-२", "content_sanskrit": "महागजाविवासाद्य विषाणाग्रैः परस्परम्।\nशरैः पूर्णायतोत्सृष्टैरन्योन्यमभिजघ्नतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2055174, "chapter_id": 2207, "verse_number": "७-१३४-३", "content_sanskrit": "अथ कर्णः शरव्रातैर्भीमसेनं समार्पयत्।\nननाद च महानादं पुनर्विव्याध चोरसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2055175, "chapter_id": 2207, "verse_number": "७-१३४-४", "content_sanskrit": "तं भीमो दशभिर्बाणैः प्रत्यविध्यदजिह्मगैः।\nपुनर्विव्याध सप्तत्या शराणां नतपर्वणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2055176, "chapter_id": 2207, "verse_number": "७-१३४-५", "content_sanskrit": "कर्णस्तु नवभिर्भीमं भित्त्वा राजंस्तनान्तरे।\nध्वजमेकेन विव्याध विशोकं च त्रिभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2055177, "chapter_id": 2207, "verse_number": "७-१३४-६", "content_sanskrit": "सायकानां ततः पार्थस्त्रिषष्ट्या प्रत्यविध्यत।\nतोत्रैरिव महानागं कशाभिरिव वाजिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2055178, "chapter_id": 2207, "verse_number": "७-१३४-७", "content_sanskrit": "सोऽतिविद्धो महाराज पाण्डवेन यशस्विना।\nसृक्विणी लेलिहन्वीरः क्रोधरक्तान्तलोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2055179, "chapter_id": 2207, "verse_number": "७-१३४-८", "content_sanskrit": "ततः शरं महाराज सर्वकायावदारणम्।\nप्राहिणोद्भीमसेनाय बलायेन्द्र इवाशनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2055180, "chapter_id": 2207, "verse_number": "७-१३४-९", "content_sanskrit": "स निर्भिद्य रणे पार्थं सूतपुत्रधनुश्च्युतः।\nअगच्छद्दारयन्भूमिं चित्रपुङ्खः शिलीमुखः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2055181, "chapter_id": 2207, "verse_number": "७-१३४-१०", "content_sanskrit": "ततो भीमो महाबाहुः क्रोधसंरक्तलोचनः।\nवज्रकल्पां चतुष्किष्कुं गुर्वी रुक्माङ्गदां गदाम्।\nप्राहिणोत्मूतपुत्राय षडस्रामविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2055182, "chapter_id": 2207, "verse_number": "७-१३४-११", "content_sanskrit": "तया जघानाधिरथेः सदश्वान्साधुवाहिनः।\nगदया भारतः क्रुद्धो वज्रेणेन्द्र इवासुरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2055183, "chapter_id": 2207, "verse_number": "७-१३४-१२", "content_sanskrit": "ततो भीमो महाबाहुः क्षुराभ्यां भरतर्षभ।\nध्वजमाघिरथेश्छित्त्वा सूतमभ्यहनच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2055184, "chapter_id": 2207, "verse_number": "७-१३४-१३", "content_sanskrit": "हताश्वसूतमुत्सृज्य स रथं पतितध्वजम्।\nविष्फारयन्धनुः कर्णस्तस्थौ भारत दुर्मनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2055185, "chapter_id": 2207, "verse_number": "७-१३४-१४", "content_sanskrit": "तत्राद्भुतमपश्याम राधेयस्य पराक्रमम्।\nविरथो रथिनां श्रेष्ठो वारयामास यद्रिपुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2055186, "chapter_id": 2207, "verse_number": "७-१३४-१५", "content_sanskrit": "विरथं तं नरश्रेष्ठं दृष्ट्वाऽऽधिरथिमाहवे।\nदुर्योधनस्ततो राजन्नभ्यभाषत दुर्मुखम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2055187, "chapter_id": 2207, "verse_number": "७-१३४-१६", "content_sanskrit": "एष दुर्मुख राधेयो भीमेन विरथीकृतः।\nतं रथेन नरश्रेष्ठ सम्पादय महारथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2055188, "chapter_id": 2207, "verse_number": "७-१३४-१७", "content_sanskrit": "ततो दुर्योधनवचः श्रुत्वा भारत दुर्मुखः।\nत्वरमाणोऽभ्ययात्कर्णं भीमं चावारयच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2055189, "chapter_id": 2207, "verse_number": "७-१३४-१८", "content_sanskrit": "दुर्मुखं प्रेक्ष्य सङ्ग्रामे सूतपुत्रपदानुगम्।\nवायुपुत्रः प्रहृष्टोऽभूत्सृक्विणी परिसंलिहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2055190, "chapter_id": 2207, "verse_number": "७-१३४-१९", "content_sanskrit": "ततः कर्णं महाराज वारयित्वा शिलीमुखैः।\nदुर्मुखाय रथं तूर्णं प्रेषयामास पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2055191, "chapter_id": 2207, "verse_number": "७-१३४-२०", "content_sanskrit": "तस्मिन्क्षणे महाराज नवभिर्नतपर्वभिः।\nसुमुखैर्दुर्मुखं भीमः शरैर्निन्ये यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2055192, "chapter_id": 2207, "verse_number": "७-१३४-२१", "content_sanskrit": "ततस्तमेवाधिरथिः स्यन्दनं दुर्मुखे हते।\nआस्थितः प्रबभौ राजन्दीप्यमान इवांशुमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2055193, "chapter_id": 2207, "verse_number": "७-१३४-२२", "content_sanskrit": "शयानं भिन्नमर्माणं दुर्मुखं शोणितोक्षितम्।\nदृष्ट्वा कर्णोऽश्रुपूर्णाक्षो मुहूर्तं नाभ्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2055194, "chapter_id": 2207, "verse_number": "७-१३४-२३", "content_sanskrit": "तं गतासुमतिक्रम्य कृत्वा कर्णः प्रदक्षिणम्।\nदीर्घमुष्णं श्वसन्वीरो न किञ्चित्प्रत्यपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2055195, "chapter_id": 2207, "verse_number": "७-१३४-२४", "content_sanskrit": "तस्मिंस्तु विवरे राजन्नाराचान्गार्धवाससः।\nप्राहिणोत्सूतपुत्राय भीमसेनश्चतुर्दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2055196, "chapter_id": 2207, "verse_number": "७-१३४-२५", "content_sanskrit": "ते तस्य कवचं भित्त्वा स्वर्णचित्रं महोजसः।\nहेमपुङ्खा महाराज व्यशोभन्त दिशो दश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2055197, "chapter_id": 2207, "verse_number": "७-१३४-२६", "content_sanskrit": "अपिबन्सूत पुत्रस्य शोणितं रक्तभोजनाः।\nक्रुद्धा इव मनुष्येन्द्र भुजङ्गाः कालचोदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2055198, "chapter_id": 2207, "verse_number": "७-१३४-२७", "content_sanskrit": "प्रसर्पमाणा मेदिन्यां ते व्यरोचन्त मार्गणाः।\nअर्धप्रविष्टाः संरब्धा बिलानीव महोरगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2055199, "chapter_id": 2207, "verse_number": "७-१३४-२८", "content_sanskrit": "तं प्रत्यविध्यद्राधेयो जाम्बूनदविभूषितैः।\nचतुर्दशभिरत्युग्रैर्नाराचैरविचारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2055200, "chapter_id": 2207, "verse_number": "७-१३४-२९", "content_sanskrit": "ते भीमसेनस्य भुजं सव्यं निर्भिद्य पत्रिणः।\nप्राविशन्मेदिनीं भीमाः क्रौञ्चं पत्ररथा इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2055201, "chapter_id": 2207, "verse_number": "७-१३४-३०", "content_sanskrit": "ते व्यरोचन्त नाराचाः प्रविशन्तो वसुन्धराम्।\nगच्छत्यस्तं दिनकरे दीप्यमाना इवांशवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2055202, "chapter_id": 2207, "verse_number": "७-१३४-३१", "content_sanskrit": "स निर्भिन्नो रणे भीमो नाराचैर्मर्मभेदिभिः।\nसुस्राव रुधिरं भूरि पर्वतः सलिलं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2055203, "chapter_id": 2207, "verse_number": "७-१३४-३२", "content_sanskrit": "स भीमस्त्रिभिरायस्तः सूतपुत्रं पतत्रिभिः।\nसुपर्णवेगैर्विव्याध सारथिं चास्य सप्तभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2055204, "chapter_id": 2207, "verse_number": "७-१३४-३३", "content_sanskrit": "स विह्वलो महाराज कर्णो भीमशराहतः।\nप्राद्रवज्जवनैरश्वै रणं हित्वा महाभयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2055205, "chapter_id": 2207, "verse_number": "७-१३४-३४", "content_sanskrit": "भीमसेनस्तु विष्फार्य चापं हेमपरिष्कृतम्।\nआहवेऽतिरथोऽतिष्ठज्ज्वलन्निव हुताशनः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2055206, "chapter_id": 2207, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे चतुस्त्रिंशदधिकशततमोऽध्यायः॥ १३४ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-१३४-१० ततः शैक्यां चतुष्किष्कुं इति क.ख.ङ.पाठः॥ ५-१३४-३२ सुष्ठु पर्णानां पत्राणां वेगो येषाम्॥ ३२ ॥ ५-१३४-१३४ चतुस्त्रिंशदधिकशततमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]