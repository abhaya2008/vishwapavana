[{"id": 2052491, "chapter_id": 2161, "verse_number": "७-८८-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2052492, "chapter_id": 2161, "verse_number": "७-८८-१", "content_sanskrit": "व्यूढेषु तव सैन्येषु समुत्क्रुष्टेषु मारिष।\nताड्यमानासु भेरीषु मृदङ्गेष्वानकेषु च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2052493, "chapter_id": 2161, "verse_number": "७-८८-२", "content_sanskrit": "अनीकानां च संह्रादे वादित्राणां च निःस्वने।\nप्रध्मापितेषु शङ्खेषु सन्नादे रोमहर्षणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2052494, "chapter_id": 2161, "verse_number": "७-८८-३", "content_sanskrit": "प्रगृहीतेषु शस्त्रेषु भारतेषु युयुत्सुषु।\nरौद्रे मुहूर्ते सम्प्राप्ते सव्यसाची व्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2052495, "chapter_id": 2161, "verse_number": "७-८८-४", "content_sanskrit": "बलानां वायसानां च पुरस्तात्सव्यसाचिनः।\nपिशितासृग्भुजां सङ्घाः प्रलीयन्ते सहस्रशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2052496, "chapter_id": 2161, "verse_number": "७-८८-५", "content_sanskrit": "मृगाश्च घोरसन्नादः शिवाश्चाशिवदर्शनाः॥\nदक्षिणेन प्रयातानामस्माकं नेदुरध्वनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2052497, "chapter_id": 2161, "verse_number": "७-८८-६", "content_sanskrit": "`लोकक्षये महाराज यादृशास्तादृशा हि ते।\nअशिवा धार्तराष्ट्राणां शिवाः पार्थस्य संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2052498, "chapter_id": 2161, "verse_number": "७-८८-७", "content_sanskrit": "सनिर्घाता ज्वलन्त्यश्च पेतुरुल्काः सहस्रशः।\nचचाल च मही कृत्स्ना भये घोरे समुत्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2052499, "chapter_id": 2161, "verse_number": "७-८८-८", "content_sanskrit": "विष्वग्वाताः सनीहारा रूक्षाः शर्करकर्षिणः।\nववुरायाति कौन्तेये सङ्ग्रामे समुपस्थिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2052500, "chapter_id": 2161, "verse_number": "७-८८-९", "content_sanskrit": "नाकुलिश्च शतानीको धृष्टद्युम्नश्च पार्षतः।\nपाण्डवानामनीकानि प्राज्ञौ तौ व्यूहतुस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2052501, "chapter_id": 2161, "verse_number": "७-८८-१०", "content_sanskrit": "ततो रथसहस्रेण द्विरदानां शतेन च।\nत्रिभिरश्वसहस्रैश्च पदातीनां शतैः शतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2052502, "chapter_id": 2161, "verse_number": "७-८८-११", "content_sanskrit": "अध्यर्धमात्रे धनुषां सहस्रे तनयस्तव।\nअग्रतः सर्वसैन्यानां स्थित्वा दुर्मर्षणोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2052503, "chapter_id": 2161, "verse_number": "७-८८-१२", "content_sanskrit": "अद्य गाण्डीवधन्वानं तपन्तं युद्धदुर्मदम्।\nअहमावारयिष्यामि वेलेव मकरालयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2052504, "chapter_id": 2161, "verse_number": "७-८८-१३", "content_sanskrit": "अद्य पश्यन्तु सङ्ग्रामे धनञ्जयममर्षणम्।\nविषक्तं मयि दुर्धर्षं भिन्नं कुम्भमिवाश्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2052505, "chapter_id": 2161, "verse_number": "७-८८-१४", "content_sanskrit": "तिष्ठध्वं रथिनो यूयं सङ्ग्राममभिकाङ्क्षिणः।\nयुध्यामि संहतानेतान्यशो मानं च वर्धयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2052506, "chapter_id": 2161, "verse_number": "७-८८-१५", "content_sanskrit": "एवं ब्रुवन्महाराज महात्मा स महीपतिः।\nमहेष्वासैर्वृतो राजन्महेष्वासो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2052507, "chapter_id": 2161, "verse_number": "७-८८-१६", "content_sanskrit": "ततोऽर्जुनो महाराज महात्मा महतां पतिः।\nमहारथसमाख्यातो महेष्वासो व्यवस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2052508, "chapter_id": 2161, "verse_number": "७-८८-१७", "content_sanskrit": "कक्षाग्निरिव दुःस्पर्शः सवज्र इव वासवः।\nदण्डपाणिरिवासह्यो मृत्युः कालेन चोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2052509, "chapter_id": 2161, "verse_number": "७-८८-१८", "content_sanskrit": "शूलपाणिरिवाक्षोभ्यो वरुणः पाशवानिव।\nयुगान्ताग्निरिवार्चिष्मान्दिधक्षुः स्थास्नुजङ्गमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2052510, "chapter_id": 2161, "verse_number": "७-८८-१९", "content_sanskrit": "क्रोधामर्षबलोद्धूतो निवातकवचान्तकः।\nयुद्धे जेता स्थितः सत्ये पारयिष्यन्महाव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2052511, "chapter_id": 2161, "verse_number": "७-८८-२०", "content_sanskrit": "आमुक्तकवचः खङ्गी जाम्बूनदकिरीटभृत्।\nशुभ्रमाल्याम्बरधरः स्वङ्गदश्चारुकुण़्डलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2052512, "chapter_id": 2161, "verse_number": "७-८८-२१", "content_sanskrit": "रथप्रवरमास्थाय नरो नारायणानुगः।\nविधुन्वन्गाण्डिवं सङ्ख्ये बभौ सूर्य इवोदितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2052513, "chapter_id": 2161, "verse_number": "७-८८-२२", "content_sanskrit": "अग्रानीकस्य सोऽध्यर्ध इषुपाते धनञ्जयः।\nव्यवस्थाप्य रथं राजञ्शङ्खं दध्मौ प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2052514, "chapter_id": 2161, "verse_number": "७-८८-२३", "content_sanskrit": "अथ कृष्णोऽप्यसम्भ्रान्तः पार्थेन सह मारिष।\nप्राध्मापयत्पाञ्चजन्यं शङ्खप्रवरमोजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2052515, "chapter_id": 2161, "verse_number": "७-८८-२४", "content_sanskrit": "तयोः शङ्खप्रणादेन तव सैन्ये विशाम्पते।\nआसन्संहृष्टरोमाणः कम्पिता गतचेतसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2052516, "chapter_id": 2161, "verse_number": "७-८८-२५", "content_sanskrit": "यथा त्रस्यन्ति भूतानि सर्वाण्यशनिनिःस्वनात्।\nतथा शङ्खप्रणादेन वित्रेसुस्तव सैनिकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2052517, "chapter_id": 2161, "verse_number": "७-८८-२६", "content_sanskrit": "प्रसुस्रुवुः शकृन्मूत्रं वाहनानि च सर्वशः।\nएवं सवाहनं सर्वमाविग्नमभवद्बलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2052518, "chapter_id": 2161, "verse_number": "७-८८-२७", "content_sanskrit": "सीदन्ति स्म नरा राजञ्शङ्खशब्देन मारिष।\nविसंज्ञाश्चाभवन्केचित्केचिद्राजन्वितत्रसुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2052519, "chapter_id": 2161, "verse_number": "७-८८-२८", "content_sanskrit": "ततः कपिर्महानादं सहभूतैर्ध्वजालयैः।\nअकरोद्व्यादितास्यश्च भीषयंस्तव सैनिकान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2052520, "chapter_id": 2161, "verse_number": "७-८८-२९", "content_sanskrit": "ततः शङ्खाश्च भेर्यश्च मृदङ्गाश्चानकैः सह।\nपुनरेवाभ्यहन्यन्त तव सैन्यप्रहर्षणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2052521, "chapter_id": 2161, "verse_number": "७-८८-३०", "content_sanskrit": "नानावादित्रसंहादैः क्ष्वेडितास्फोटिताकुलैः।\nसिंहनादैः समुत्क्रुष्टैः समाधूतैर्महारथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2052522, "chapter_id": 2161, "verse_number": "७-८८-३१", "content_sanskrit": "तस्मिंस्तु तुमुले शब्दे भीरूणां भयवर्धने।\nअतीव हृष्टो दाशार्हमब्रवीत्पाकशासनिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2052523, "chapter_id": 2161, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे अष्टांशीतितमोऽध्यायः॥ ८८ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-८८-१० शतैः शतैर्दशसहस्रैः॥ ५-८८-३० समाधूतैः सञ्चालितैः॥ ५-८८-८८ अष्टाशीतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]