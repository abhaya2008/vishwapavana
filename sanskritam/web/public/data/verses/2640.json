[{"id": 2077490, "chapter_id": 2640, "verse_number": "१२-१४५-०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2077491, "chapter_id": 2640, "verse_number": "१२-१४५-१", "content_sanskrit": "सपत्न्या वचनं श्रुत्वा धर्मयुक्तिसमन्वितम्।\nहर्षेण महता युक्तो वाक्यं व्याकुललोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2077492, "chapter_id": 2640, "verse_number": "१२-१४५-२", "content_sanskrit": "तं वै शाकुनिकं दृष्ट्वा विधिदृष्टेन कर्मणा।\nस पक्षी पूजयामास यत्नात्तं पक्षिजीविनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2077493, "chapter_id": 2640, "verse_number": "१२-१४५-३", "content_sanskrit": "उवाच स्वागतं तेऽद्य ब्रूहि किं करवाणि ते।\nसतांपश्च न कर्तव्यः स्वगृहे वर्तते भवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2077494, "chapter_id": 2640, "verse_number": "१२-१४५-४", "content_sanskrit": "तद्ब्रवीतु भवान्क्षिप्रं किं करोमि किमिच्छसि।\nप्रणयेन ब्रवीमि त्वां त्वं हि नः शरणागतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2077495, "chapter_id": 2640, "verse_number": "१२-१४५-५", "content_sanskrit": "अरावप्युचितं कार्यमातिथ्यं गृहमागते।\nछेत्तुमप्यागते छायां नोपसंहरते द्रुमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2077496, "chapter_id": 2640, "verse_number": "१२-१४५-६", "content_sanskrit": "शरणागतस्य कर्तव्यमातिथ्यं हि प्रयत्नतः।\nपञ्चयज्ञप्रवृत्तेन गृहस्थेन विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2077497, "chapter_id": 2640, "verse_number": "१२-१४५-७", "content_sanskrit": "पञ्चयज्ञांस्तु यो मोहान्न करोति गृहाश्रमी।\nतस्य नायं न च परो लोको भवति धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2077498, "chapter_id": 2640, "verse_number": "१२-१४५-८", "content_sanskrit": "तद्ब्रूहि मां सुविस्रब्धो यत्त्वं वाचा वदिष्यसि।\nतत्करिष्याम्यहं सर्वं मा त्वं शोके मनः कृथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2077499, "chapter_id": 2640, "verse_number": "१२-१४५-९", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा शकुनेर्लुब्धकोऽब्रवीत्।\nबाधते खलु मां शीतं संत्राणं हि विधीयताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2077500, "chapter_id": 2640, "verse_number": "१२-१४५-१०", "content_sanskrit": "एवमुक्तस्तनः पक्षी पर्णान्यास्तीर्य भूतले।\nयथा शुष्काणि यत्नेन ज्वलनार्थं द्रुतं ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2077501, "chapter_id": 2640, "verse_number": "१२-१४५-११", "content_sanskrit": "स---वाऽङ्गारकर्मान्तं गृहीत्वाऽग्निमथागमत्।\nतथा शुष्केषु पर्णेषु पावकं सोऽप्यदीपयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2077502, "chapter_id": 2640, "verse_number": "१२-१४५-१२", "content_sanskrit": "स--प्तं महत्कृत्वा तमाह शरणागतम्।\n----- सुविस्रब्धः स्वगात्राण्यकुतोभयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2077503, "chapter_id": 2640, "verse_number": "१२-१४५-१३", "content_sanskrit": "-- तथोक्तस्तथेत्युक्त्वा लुब्धो गात्राण्यतापयत्।\nअग्निप्रत्यागतप्राणस्ततः प्राह विहंगमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2077504, "chapter_id": 2640, "verse_number": "१२-१४५-१४", "content_sanskrit": "हर्षेण महताऽऽविष्टो वाक्यं व्याकुललोचनः।\nतथेमं शकुनिं दृष्ट्वा विधिदृष्टेन कर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2077505, "chapter_id": 2640, "verse_number": "१२-१४५-१५", "content_sanskrit": "दत्तमाहारमिच्छामि त्वया क्षुद्बाधते हि माम्।\nस तद्वचः प्रतिश्रुत्य वाक्यमाह विहंगमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2077506, "chapter_id": 2640, "verse_number": "१२-१४५-१६", "content_sanskrit": "न मेऽस्ति विभवो येन नाशयेयं क्षुधां तव।\nउत्पन्नेन हि जीवामो वयं नित्यं वनौकसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2077507, "chapter_id": 2640, "verse_number": "१२-१४५-१७", "content_sanskrit": "संचयो नास्ति चास्माकं मुनीनामिव कानने।\nइत्युक्त्वा तं तदा तत्र विवर्णवदनोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2077508, "chapter_id": 2640, "verse_number": "१२-१४५-१८", "content_sanskrit": "कथं नु खलु कर्तव्यमिति चिन्तापरस्तदा।\nबभूव भरतश्रेष्ठ गर्हयन्वृत्तिमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2077509, "chapter_id": 2640, "verse_number": "१२-१४५-१९", "content_sanskrit": "मुहूर्ताल्लब्धसंज्ञस्तु स पक्षी पक्षिघातिनम्।\nउवाच तर्पयिष्ये त्वां मुहूर्तं प्रतिपालय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2077510, "chapter_id": 2640, "verse_number": "१२-१४५-२०", "content_sanskrit": "इत्युक्त्वा शुष्कपर्णैस्तु समुज्ज्वाल्य हुताशनम्।\nहर्षेण महताऽऽविष्टः कपोतः पुनरब्रबीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2077511, "chapter_id": 2640, "verse_number": "१२-१४५-२१", "content_sanskrit": "ऋषीणां देवतानां च पितृणां च महात्मनाम्।\nयुतः पूर्वं मया धर्मो महानतिथिपूजने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2077512, "chapter_id": 2640, "verse_number": "१२-१४५-२२", "content_sanskrit": "कुरुष्वानुग्रहं सौम्य सत्यमेतद्ब्रबीमि ते।\nनिश्चिता खलु मे बुद्धिरतिथिप्रतिपूजने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2077513, "chapter_id": 2640, "verse_number": "१२-१४५-२३", "content_sanskrit": "ततः कृतप्रतिज्ञो वै स पक्षी प्रहसन्निव।\nतमग्निं त्रिः परिक्रम्य प्रविवेश महामतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2077514, "chapter_id": 2640, "verse_number": "१२-१४५-२४", "content_sanskrit": "अग्निमध्ये प्रविष्टं तु लुब्धो दृष्ट्वा च पक्षिणम्।\nचिन्तयामास मनसा किमिदं वै मया कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2077515, "chapter_id": 2640, "verse_number": "१२-१४५-२५", "content_sanskrit": "अहो मम नृशंसस्य गर्हितस्य स्वकर्मणा।\nअधर्मः सुमहान्धोरो भविष्यति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2077516, "chapter_id": 2640, "verse_number": "१२-१४५-२६", "content_sanskrit": "एवं बहुविधं भूरि विललाप स लुब्धकः।\nगर्हयन्स्वानि कर्माणि द्विजं दृष्ट्वा तथाऽऽगतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2077517, "chapter_id": 2640, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि आपद्धर्मपर्वणि पञ्चचत्वारिंशदधिकशततमोऽध्यायः॥ १४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]