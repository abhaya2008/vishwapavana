[{"id": 2178487, "chapter_id": 4774, "verse_number": "", "content_sanskrit": "गान्धारी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178488, "chapter_id": 4774, "verse_number": "१", "content_sanskrit": "पश्य माधव पुत्रान् मे शतसङ्ख्यान् जितक्लमान् ।\nगदया भीमसेनेन भूयिष्ठं निहतान् रणे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178489, "chapter_id": 4774, "verse_number": "२", "content_sanskrit": "इदं दुःखतरं मेऽद्य यदिमा मुक्तमूर्धजाः ।\nहतभर्त्र्यो रणे बालाः परिधावन्ति मे स्नुषाः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178490, "chapter_id": 4774, "verse_number": "३", "content_sanskrit": "प्रासादतळचारिण्यः चरणैर्भूषणान्वितैः ।\nकायेनाद्य स्पृशन्तीमां रुधिरार्द्रां वसुन्धराम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178491, "chapter_id": 4774, "verse_number": "४", "content_sanskrit": "गृध्रानुत्सारयन्त्यश्च गोमायूंश्च तथाऽपराः ।\nशोकेनार्ता विघूर्णन्त्यो मत्ता इव चरन्त्युत\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178492, "chapter_id": 4774, "verse_number": "५", "content_sanskrit": "एषां या त्वनवद्याङ्गी करसम्मितमध्यमा ।\nघोरमायोधनं दृष्ट्वा पतत्यसुखिता भुवि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178493, "chapter_id": 4774, "verse_number": "६", "content_sanskrit": "दृष्ट्वा मे पार्थिवसुतामेनां लक्ष्मणमातरम् ।\nराजपत्नीं महाबाहो मनो मेऽभ्युपताम्यति\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178494, "chapter_id": 4774, "verse_number": "७", "content_sanskrit": "भ्रातॄंश्चान्याः पितॄंश्चान्याः पुत्रांश्च निहतान् भुवि ।\nदृष्ट्वा परिपतन्त्येताः प्रगृह्य सुभुजा भुजान्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178495, "chapter_id": 4774, "verse_number": "८", "content_sanskrit": "मध्यानामथ वृद्धानां बालानां चापराजित ।\nआक्रन्दं हतबन्धूनां दारुणे वैशसे शृणु\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178496, "chapter_id": 4774, "verse_number": "९", "content_sanskrit": "रथनीडांश्च देहांश्च हतानां गजवाजिनाम् ।\nआश्रित्य श्रममोहार्ताः स्थिता पश्य महाभुज\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178497, "chapter_id": 4774, "verse_number": "१०", "content_sanskrit": "अन्या ह्यपहृतं कायाच्चारुकुण्डलमुन्नसम् ।\nस्वस्य बन्धोः शिरः कृष्ण गृहीत्वा पश्य तिष्ठति\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178498, "chapter_id": 4774, "verse_number": "११", "content_sanskrit": "पूर्वजन्मकृतं पापं मन्ये नाल्पमिवानघ ।\nएताभिरनवद्याभिर्मया चैवाल्पपुण्यया\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178499, "chapter_id": 4774, "verse_number": "१२", "content_sanskrit": "तदिदं धर्मराजेन घातितं नो जनार्दन ।\nन हि नाशोऽस्ति वार्ष्णेय कर्मणोः शुभपापयोः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178500, "chapter_id": 4774, "verse_number": "१३", "content_sanskrit": "प्रत्यग्रवयसः पश्य दर्शनीयकुचाननाः ।\nकुलेषु जाता ह्रीमत्यः कृष्णपक्ष्माक्षिमूर्धजाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178501, "chapter_id": 4774, "verse_number": "१४", "content_sanskrit": "हंसगद्गदभाषिण्यो दुःखशोकप्रमोहिताः ।\nसारस्य इव पश्यन्त्यः पतिताः पश्य माधव\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178502, "chapter_id": 4774, "verse_number": "१५", "content_sanskrit": "फुल्लपद्मप्रकाशानि पुण्डरीकाक्ष योषिताम् ।\nअनवद्यानि वक्त्राणि तपत्यंशुभिरंशुमान्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178503, "chapter_id": 4774, "verse_number": "१६", "content_sanskrit": "सेर्ष्याणां मम पुत्राणां वासुदेवावरोधनम् ।\nमत्तमातङ्गदर्पाणां पश्यन्त्यद्य पृथग्जनाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178504, "chapter_id": 4774, "verse_number": "१७", "content_sanskrit": "शतचन्द्राणि चर्माणि ध्वजांश्चादित्यसन्निभान् ।\nरौग्माणि चैव वर्माणि निष्कानपि च काञ्चनान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178505, "chapter_id": 4774, "verse_number": "१८", "content_sanskrit": "शिरस्त्राणानि चैतानि पुत्राणां च महीतळे ।\nपश्य दीप्तानि गोविन्द पावकान् सुहुतानिव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178506, "chapter_id": 4774, "verse_number": "१९", "content_sanskrit": "एष दुःशासनः शेते शूरेणामित्रघातिना ।\nपीतशोणितसर्वाङ्गो भीमसेनेन पातितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178507, "chapter_id": 4774, "verse_number": "२०", "content_sanskrit": "द्यूतक्लेशाननुस्मृत्य द्रौपदीचोदितेन च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178508, "chapter_id": 4774, "verse_number": "२१", "content_sanskrit": "उक्ता ह्यनेन पाञ्चाली सभायां द्यूतनिर्जिता ।\nप्रियं चिकीर्षता भ्रातुः कर्णस्य च जनार्दन\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178509, "chapter_id": 4774, "verse_number": "२२", "content_sanskrit": "सहैव सहदेवेन नकुलेनार्जुनेन च\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2178510, "chapter_id": 4774, "verse_number": "२३", "content_sanskrit": "दासभूताऽसि पाञ्चालि क्षिप्रं प्रविश नो गृहान् ।\nततोऽहमब्रुवं कृष्ण तदा दुर्योधनं नृपम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2178511, "chapter_id": 4774, "verse_number": "२४", "content_sanskrit": "मृत्युपाशपरिक्षिप्तं शकुनिं पुत्र वर्जय ।\nगान्धारराजं दुर्बुद्धिं मातुलं कलहप्रियम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2178512, "chapter_id": 4774, "verse_number": "२५", "content_sanskrit": "क्षिप्रमेनं परित्यज्य पुत्र संशाम्य पाण्डवैः ।\nन त्वं बुद्ध्यसि दुर्बुद्धे भीमसेनममर्षिणम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2178513, "chapter_id": 4774, "verse_number": "२६", "content_sanskrit": "वाङ्नाराचैस्तुदंस्तीक्ष्णैरुल्काभिरिव कुञ्जरम् ।\nतानेवं रहसि क्रुद्धो वाक्यशल्यान् अवधारयन्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2178514, "chapter_id": 4774, "verse_number": "२७", "content_sanskrit": "उत्ससर्ज विषं तेषु सर्पो गोवृषभेष्विव\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2178515, "chapter_id": 4774, "verse_number": "२८", "content_sanskrit": "एष दुःशासनः शेते निक्षिप्य विपुलौ भुजौ ।\nनिहतो भीमसेनेन सिंहेनेव महर्षभः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2178516, "chapter_id": 4774, "verse_number": "२९", "content_sanskrit": "अत्यर्थमकरोद् रौद्रं भीमसेनोऽत्यमर्षणः ।\nदुःशासनस्य यत् क्रुद्धोऽपिबच्छोणितमाहवे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2178517, "chapter_id": 4774, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nअष्टादशोऽध्यायः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2178518, "chapter_id": 4774, "verse_number": "", "content_sanskrit": "स्त्रीपर्वणि तृतीयोऽध्यायः ॥३॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]