[{"id": 5000633000, "chapter_id": 9633, "verse_number": "७-९८-१", "content_sanskrit": "रसातलं प्रविष्टायां वैदेह्यां सर्ववानराः ।\nचुक्रुशुः साधु साध्वीति मुनयो रामसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000633001, "chapter_id": 9633, "verse_number": "७-९८-२", "content_sanskrit": "दण्डकाष्ठमवष्टभ्य बाष्पव्याकुलितेक्षणः ।\nअवाक्छिरा दीनमना रामो ह्यासीत्सुदुःखितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000633002, "chapter_id": 9633, "verse_number": "७-९८-३", "content_sanskrit": "स रुदित्वा चिरं कालं बहुशो बाष्पमुत्सृजन् ।\nक्रोधशोकसमाविष्टो रामो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000633003, "chapter_id": 9633, "verse_number": "७-९८-४", "content_sanskrit": "अभूतपूर्वं शोकं मे मनः स्प्रष्टुमिवेच्छति ।\nपश्यतो मे यथा नष्टा सीता श्रीरिव रूपिणी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000633004, "chapter_id": 9633, "verse_number": "७-९८-५", "content_sanskrit": "सा ऽदर्शनं पुरा सीता लङ्कापारे महोदधेः ।\nततश्चापि मयानीता किं पुनर्वसुधातलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000633005, "chapter_id": 9633, "verse_number": "७-९८-६", "content_sanskrit": "वसुधे देवि भवति सीता निर्यात्यतां मम ।\nदर्शयिष्यामि वा रोषं यथा मामवगच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000633006, "chapter_id": 9633, "verse_number": "७-९८-७", "content_sanskrit": "कामं श्वश्रूर्ममैव त्वं त्वत्सकाशाद्धि मैथिली ।\nकर्षता हलहस्तेन जनकेनोद्धृता पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000633007, "chapter_id": 9633, "verse_number": "७-९८-८", "content_sanskrit": "तस्मान्निर्यात्यतां सीता विवरं वा प्रयच्छ मे ।\nपाताले नाकपृष्ठे वा वसेयं सहितस्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000633008, "chapter_id": 9633, "verse_number": "७-९८-९", "content_sanskrit": "आनय त्वं हि तां सीतां मत्तो ऽहं मैथिलीकृते ।\nन मे दास्यसि चेत्सीतां यथारूपां महीतले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000633009, "chapter_id": 9633, "verse_number": "७-९८-१०", "content_sanskrit": "सपर्वतवनां कृत्स्नां विधमिष्यामि ते स्थितम् ।\nनाशयिष्याम्यहं भूमिं सर्वमापो भवत्विह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000633010, "chapter_id": 9633, "verse_number": "७-९८-११", "content_sanskrit": "एवं ब्रुवाणे काकुत्स्थे क्रोधशोकसमन्विते ।\nब्रह्मा सुरगणैः सार्धमुवाच रघुनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000633011, "chapter_id": 9633, "verse_number": "७-९८-१२", "content_sanskrit": "राम राम न सन्तापं कर्तुमर्हसि सुव्रत ।\nस्मर त्वं पूर्वकं भावं मन्त्रं चामित्रकर्शन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000633012, "chapter_id": 9633, "verse_number": "७-९८-१३", "content_sanskrit": "न खलु त्वां महाबाहो स्मारयेयमनुत्तमम् ।\nइमं मुहूर्तं दुर्धर्ष स्मर त्वं जन्म वैष्णवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000633013, "chapter_id": 9633, "verse_number": "७-९८-१४", "content_sanskrit": "सीता हि विमला साध्वी तव पूर्वपरायणा ।\nनागलोकं सुखं प्रायात्त्वदाश्रयतपोबलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000633014, "chapter_id": 9633, "verse_number": "७-९८-१५", "content_sanskrit": "स्वर्गे ते सङ्गमो भूयो भविष्यति न संशयः ।\nअस्यास्तु परिषन्मध्ये यद्ब्रवीमि निबोध तत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000633015, "chapter_id": 9633, "verse_number": "७-९८-१६", "content_sanskrit": "एतदेव हि काव्यं ते काव्यानामुत्तमं श्रुतम् ।\nसर्वं विस्तरतो राम व्याख्यास्यति न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000633016, "chapter_id": 9633, "verse_number": "७-९८-१७", "content_sanskrit": "जन्मप्रभृति ते वीर सुखदुःखोपसेवनम् ।\nभविष्यदुत्तरं चेह सर्वं वाल्मीकिना कृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000633017, "chapter_id": 9633, "verse_number": "७-९८-१८", "content_sanskrit": "आदिकाव्यमिदं राम त्वयि सर्वं प्रतिष्ठितम् ।\nनह्यन्यो ऽर्हति काव्यानां यशोभाग्राघवादृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000633018, "chapter_id": 9633, "verse_number": "७-९८-१९", "content_sanskrit": "श्रुतं ते पूर्वमेतद्धि मया सर्वं सुरैः सह ।\nदिव्यमद्भुतरूपं च सत्यवाक्यमनावृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000633019, "chapter_id": 9633, "verse_number": "७-९८-२०", "content_sanskrit": "स त्वं पुरुषशार्दूल धर्मेण सुसमाहितः ।\nशेषं भविष्यं काकुत्स्थ काव्यं रामायणं शृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000633020, "chapter_id": 9633, "verse_number": "७-९८-२१", "content_sanskrit": "उत्तरं नाम काव्यस्य शेषमत्र महायशः ।\nतच्छृणुष्व महातेज ऋषिभिः सार्धमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000633021, "chapter_id": 9633, "verse_number": "७-९८-२२", "content_sanskrit": "न खल्वन्येन काकुत्स्थ श्रोतव्यमिदमुत्तमम् ।\nपरमम् ऋषिणा वीर त्वयैव रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000633022, "chapter_id": 9633, "verse_number": "७-९८-२३", "content_sanskrit": "एतावदुक्त्वा वचनं ब्रह्मा त्रिभुवनेश्वरः ।\nजगाम त्रिदिवं देवो देवैः सह सबान्धवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000633023, "chapter_id": 9633, "verse_number": "७-९८-२४", "content_sanskrit": "ये च तत्र महात्मान ऋषयो ब्राह्मलौकिकाः ।\nब्रह्मणा समनुज्ञाता न्यवर्तन्त महौजसः ।\nउत्तरं श्रोतुमनसो भविष्यं यच्च राघवे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000633024, "chapter_id": 9633, "verse_number": "७-९८-२५", "content_sanskrit": "ततो रामः शुभां वाणीं देवदेवस्य भाषिताम् ।\nश्रुत्वा परमतेजस्वी वाल्मीकिमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000633025, "chapter_id": 9633, "verse_number": "७-९८-२६", "content_sanskrit": "भगवन् श्रोतुमनस ऋषयो ब्राह्मलौकिकाः ।\nभविष्यदुत्तरं यन्मे श्वोभूते सम्प्रवर्तताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000633026, "chapter_id": 9633, "verse_number": "७-९८-२७", "content_sanskrit": "एवं विनिश्चयं कृत्वा सम्प्रगृह्य कुशीलवौ ।\nतं जनौघं विसृज्याथ पर्णशालामुपागमत् ।\nतामेव शोचतः सीतां सा व्यतीयाय शर्वरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000633027, "chapter_id": 9633, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे ऽष्टनवतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]