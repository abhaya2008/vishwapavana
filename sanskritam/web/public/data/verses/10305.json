[{"id": 6000305000, "chapter_id": 10305, "verse_number": null, "content_sanskrit": "चतुर्थाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000305001, "chapter_id": 10305, "verse_number": null, "content_sanskrit": "राजोवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.001.m4a", "display_order": 2}, {"id": 6000305002, "chapter_id": 10305, "verse_number": "११-४-१", "content_sanskrit": "यानि यानीह कर्माणि यैर्यैः स्वच्छन्दजन्मभिः।\nचक्रे करोति कर्ता वा हरिस्तानि ब्रुवन्तु नः॥ ११/४/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.002.m4a", "display_order": 3, "topics": [{"text": "जायन्तेयेन द्रुमिलेन निमिराजं प्रति भगवदवतारवर्णनम्", "range": "१–२३"}]}, {"id": 6000305003, "chapter_id": 10305, "verse_number": null, "content_sanskrit": "द्रुमिल उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.003.m4a", "display_order": 4}, {"id": 6000305004, "chapter_id": 10305, "verse_number": "११-४-२", "content_sanskrit": "यो वा अनन्तस्य गुणाननन्ताननुक्रमिष्येत् स तु बालबुद्धिः।\nरजांसि भूमेर्गणयेत् कथञ्चित् कालेन नैवाखिलसत्त्वधाम्नः॥ ११/४/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.004.m4a", "display_order": 5}, {"id": 6000305005, "chapter_id": 10305, "verse_number": "११-४-३", "content_sanskrit": "भूतैर्यदा पञ्चभिरात्मसृष्टैः पुरं विराजं विरचय्य तस्मिन्।\nस्वांशेन विष्टः पुरुषाभिधानमवाप नारायण आदिदेवः॥ ११/४/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.005.m4a", "display_order": 6}, {"id": 6000305006, "chapter_id": 10305, "verse_number": "११-४-४", "content_sanskrit": "यत्काय एष भुवनत्रयसन्निवेशो यस्येन्द्रियैस्तनुभृतामुभयेन्द्रियाणि।\nज्ञानांशकेन विशतो बलमोज ईहा सत्त्वादिभिः स्थितिलयोद्भव आदिकर्ता॥ ११/४/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.006.m4a", "display_order": 7}, {"id": 6000305007, "chapter_id": 10305, "verse_number": "११-४-५", "content_sanskrit": "आदावभूच्छतधृती रजसाऽस्य सर्गे विष्णुः स्थितौ क्रतुपतिर्द्विजधर्मसेतुः।\nरुद्रोऽप्ययाय तमसा पुरुषः स आद्य इत्युद्भवस्थितिलयाः सततं प्रजासु॥ ११/४/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.007.m4a", "display_order": 8}, {"id": 6000305008, "chapter_id": 10305, "verse_number": "११-४-६", "content_sanskrit": "धर्मस्य दक्षदुहितर्यजनि स्वमूर्त्या नारायणो नर इति स्वतपःप्रभावः।\nनैष्कर्म्यलक्षणमुवाच चचार योगं योऽद्यापि चास्त ऋषिवर्यनिषेविताङ्घ्रिः॥ ११/४/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.008.m4a", "display_order": 9}, {"id": 6000305009, "chapter_id": 10305, "verse_number": "११-४-७", "content_sanskrit": "इन्द्रोऽपि नाक्यसुखमेष जिघृक्षतीति कामं न्ययुङ्क्त सगणं च स बदर्युपाख्यम्।\nगत्वाऽप्सरोगणवसन्तसुमन्दवातैः स्‍त्रीप्रेक्षणेषुभिरविध्यदतन्महिज्ञः॥ ११/४/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.009.m4a", "display_order": 10}, {"id": 6000305010, "chapter_id": 10305, "verse_number": "११-४-८", "content_sanskrit": "विज्ञाय शक्रकृतमक्रममादिदेवः प्राह प्रहस्य गतविस्मय एजमानान्।\nमा भैर्विभो मदनमारुतदेववध्वो गृह्णीत नो बलिमशून्यमिमं कुरुध्वम्॥ ११/४/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.010.m4a", "display_order": 11}, {"id": 6000305011, "chapter_id": 10305, "verse_number": "११-४-९", "content_sanskrit": "इत्थं ब्रुवत्यभयदे नरदेवदेवे सव्रीडनम्रशिरसः सघृणं तमूचुः।\nनेयं विभो त्वयि परेऽविकृतिर्विचित्रा स्वारामधीरनिकरानतपादपद्मे॥ ११/४/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.011.m4a", "display_order": 12}, {"id": 6000305012, "chapter_id": 10305, "verse_number": "११-४-१०", "content_sanskrit": "त्वां सुन्वतां सुरकृता बहवोऽन्तरायाः कस्तान् विलङ्घ्य व्रजतात् परमं पदं ते।\nनान्यस्य बर्हिषि बलिं ददतः स्वभागं धत्ते पदं त्वमविता यदि विघ्नमूर्ध्नि॥ ११/४/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.012.m4a", "display_order": 13}, {"id": 6000305013, "chapter_id": 10305, "verse_number": "११-४-११", "content_sanskrit": "क्षुत्तृट्त्रिकालगुणमारुतजैह्वशैश्न्यादस्मादपारजलधेरतितीर्य केचित्।\nक्रोधस्य यान्ति विफलस्य वशे पदे गोर्मज्जन्ति दुश्चरतपश्च वृथोत्सृजन्ति॥ ११/४/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.013.m4a", "display_order": 14}, {"id": 6000305014, "chapter_id": 10305, "verse_number": "११-४-१२", "content_sanskrit": "इति प्रगृणतां तेषां स्‍त्रियोऽत्यद्भुतदर्शनाः।\nदर्शयामास शुश्रूषां स्वार्चने कुर्वतीर्विभुः॥ ११/४/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.014.m4a", "display_order": 15}, {"id": 6000305015, "chapter_id": 10305, "verse_number": "११-४-१३", "content_sanskrit": "ते देवानुचरा दृष्ट्वा स्‍त्रियः श्रीरिव रूपिणीः।\nगन्धेन मुमुहुस्तासां रूपौदार्यहृतश्रियः॥ ११/४/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.015.m4a", "display_order": 16}, {"id": 6000305016, "chapter_id": 10305, "verse_number": "११-४-१४", "content_sanskrit": "तानाह देवदेवेशः प्रणतान् प्रहसन्निव।\nआसामेकतमां वृङ्ध्वं सुवर्णां स्वर्गभूषणाम्॥ ११/४/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.016.m4a", "display_order": 17}, {"id": 6000305017, "chapter_id": 10305, "verse_number": "११-४-१५", "content_sanskrit": "ओमित्यादेशमादाय नत्वा तं सुरबन्दिनः।\nउर्वशीमप्सरःश्रेष्ठां पुरस्कृत्य दिवं ययुः॥ ११/४/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.017.m4a", "display_order": 18}, {"id": 6000305018, "chapter_id": 10305, "verse_number": "११-४-१६", "content_sanskrit": "इन्द्रायानम्य सदसि शृण्वतां त्रिदिवौकसाम्।\nऊचुर्नारायणबलं शक्रस्तत्रास विस्मितः॥ ११/४/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.018.m4a", "display_order": 19}, {"id": 6000305019, "chapter_id": 10305, "verse_number": "११-४-१७", "content_sanskrit": "हंसस्वरूप्यवददच्युत आत्मयोगं दत्तः कुमार ऋषभो भगवान् पिता नः।\nविष्णुः शिवाय जगतां कलयाऽवतीर्णस्तेनाहृता मधुभिदा श्रुतयो हयास्ये॥ ११/४/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.019.m4a", "display_order": 20}, {"id": 6000305020, "chapter_id": 10305, "verse_number": "११-४-१८", "content_sanskrit": "गुप्ताऽप्यये मनुरिला ऋषभश्च मात्स्ये क्रोडे हतो दिविज उद्धरतोऽम्भसे क्ष्माम्।\nकौर्मे धृतोऽद्रिरमृतोन्मथने स्वपृष्ठे ग्राहात् प्रपन्नमिभराजममुञ्चदार्तम्॥ ११/४/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.020.m4a", "display_order": 21}, {"id": 6000305021, "chapter_id": 10305, "verse_number": "११-४-१९", "content_sanskrit": "संस्तुन्वतोऽब्धिपतितांच्छ्रमणान् ऋषींश्च शक्रं च वृत्रवधतस्तमसि प्रविष्टम्।\nदेवस्‍त्रियोऽसुरगृहे पिहिता अनाथा जघ्नेऽसुरेन्द्रमभयाय सतां नृसिंहे॥ ११/४/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.021.m4a", "display_order": 22}, {"id": 6000305022, "chapter_id": 10305, "verse_number": "११-४-२०", "content_sanskrit": "देवासुरे युधि स दैत्यपतीन् सुरार्थे हत्वाऽन्तरेषु भवनान्यदधात् कलाभिः।\nभूत्वाऽथ वामन इमामहरद् बलेः क्ष्मां याञ्चाछलेन समदाददितेः सुतेभ्यः॥ ११/४/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.022.m4a", "display_order": 23}, {"id": 6000305023, "chapter_id": 10305, "verse_number": "११-४-२१", "content_sanskrit": "निःक्षत्रियामकृत गां च त्रिः सप्तकृत्वः रामस्तु हैहयकुलाप्ययभार्गवाग्निः।\nयोऽब्धिं बबन्ध दशवक्त्रमहन् स लङ्कां सीतापतिर्जयति लोकमलङ्घ्यकीर्तिः॥ ११/४/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.023.m4a", "display_order": 24}, {"id": 6000305024, "chapter_id": 10305, "verse_number": "११-४-२२", "content_sanskrit": "भूमेर्भरावतरणाय यदुष्वजन्मा जातः करिष्यति सुरैरपि दुष्कराणि।\nवादैर्विमोहयति यज्ञकृतोऽतदर्हान् शूद्रान् कलेः क्षितिभुजो न्यहनिष्यदन्ते॥ ११/४/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.024.m4a", "display_order": 25}, {"id": 6000305025, "chapter_id": 10305, "verse_number": "११-४-२३", "content_sanskrit": "एवं विधानि कर्माणि जन्मानि च जगत्पतेः।\nभूरीणि भूरियशसो वर्णितानि महाभुज॥ ११/४/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_11/adhyaya_004/BhP_11.004.025.m4a", "display_order": 26}, {"id": 6000305026, "chapter_id": 10305, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायाम् एकादशस्कन्धे चतुर्थाध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]