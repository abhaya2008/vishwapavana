[{"id": 2129984, "chapter_id": 3801, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129985, "chapter_id": 3801, "verse_number": "१", "content_sanskrit": "क्रोशमात्रं प्रयातेषु पाण्डवेषु महात्मसु ।\nपद्भ्यामनुचिता गन्तुं द्रौपदी समुपाविशत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129986, "chapter_id": 3801, "verse_number": "२", "content_sanskrit": "श्रान्ता दुःखपरीता च वातवर्षेण तेन च ।\nसौकुमार्याच्च पाञ्चाली सम्मुमोह तपस्विनी\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129987, "chapter_id": 3801, "verse_number": "३", "content_sanskrit": "सा कम्पमाना मोहेन बाहुभ्यामसितेक्षणा ।\nवृत्ताभ्यामनुरूपाभ्यामूरू समवलम्बत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129988, "chapter_id": 3801, "verse_number": "४", "content_sanskrit": "आलम्बमाना सहितावूरू गजकरोपमौ ।\nपपात सहसा भूमौ वेपन्ती कदळी यथा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129989, "chapter_id": 3801, "verse_number": "५", "content_sanskrit": "तां पतन्तीं वरारोहां भज्यमानां लतामिव ।\nनकुलः समभिद्रुत्य परिजग्राह वीर्यवान्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129990, "chapter_id": 3801, "verse_number": "", "content_sanskrit": "नकुलः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129991, "chapter_id": 3801, "verse_number": "६", "content_sanskrit": "राजन् पाञ्चालराजस्य सुतेयमसितेक्षणा ।\nश्रान्ता निपतिता भूमौ तामवेक्षस्व भारत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129992, "chapter_id": 3801, "verse_number": "७", "content_sanskrit": "अदुःखार्हा परं दुःखं प्राप्तेयं मृदुगामिनी ।\nआश्वासय महाराज तामिमां श्रमकर्शिताम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129993, "chapter_id": 3801, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129994, "chapter_id": 3801, "verse_number": "८", "content_sanskrit": "राजा तु वचनात् तस्य भृशं दुःखसमन्वितः ।\nभीमश्च सहदेवश्च सहसा समुपाद्रवन्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129995, "chapter_id": 3801, "verse_number": "९", "content_sanskrit": "तामवेक्ष्य तु कौन्तेयो विवर्णवदनां कृशाम् ।\nअङ्कमानीय धर्मात्मा पर्यदेवयदातुरः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129996, "chapter_id": 3801, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129997, "chapter_id": 3801, "verse_number": "१०", "content_sanskrit": "कथं वेश्मसु गुप्तेषु स्वास्तीर्णशयनोचिता ।\nभूमौ निपतिता शेते सुखार्हा वरवर्णिनी\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129998, "chapter_id": 3801, "verse_number": "११", "content_sanskrit": "सुकुमारौ कथं पादौ मुखं च कमलप्रभम् ।\nमत्कृतेऽद्य वरार्हायाः श्यामतां समुपागतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129999, "chapter_id": 3801, "verse_number": "१२", "content_sanskrit": "किमिदं द्यूतकामेन मया कृतमबुद्धिना ।\nआदाय कृष्णां चरता वने मृगगणायुते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2130000, "chapter_id": 3801, "verse_number": "१३", "content_sanskrit": "सुखं प्राप्स्यसि कल्याणि पाण्डवान् प्राप्य वै पतीन् ।\nइति द्रुपदराजेन पित्रा दत्ताऽऽयतेक्षणा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2130001, "chapter_id": 3801, "verse_number": "१४", "content_sanskrit": "तत्सर्वमनवाप्येयं श्रमशोकाध्वकर्शिता ।\nशेते निपतिता भूमौ पापस्य मम कर्मभिः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2130002, "chapter_id": 3801, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2130003, "chapter_id": 3801, "verse_number": "१५", "content_sanskrit": "तथा लालप्यमाने तु धर्मराजे युधिष्ठिरे ।\nधौम्यप्रभृतयः सर्वे तत्राजग्मुर्द्विजोत्तमाः \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2130004, "chapter_id": 3801, "verse_number": "१६", "content_sanskrit": "ते समाश्वासयामासुराशीर्भिश्चाप्यपूजयन् ।\nरक्षोघ्नांश्च तथा मन्त्रान् जेपुश्चक्रुश्च ते क्रियाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2130005, "chapter_id": 3801, "verse_number": "", "content_sanskrit": "पठ्यमानेषु मन्त्रेषु शान्त्यर्थं परमर्षिभिः ।\nस्पृश्यमाना करैः शीतैः पाण्डवैश्च मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2130006, "chapter_id": 3801, "verse_number": "१८", "content_sanskrit": "सेव्यमाना च शीतेन जलमिश्रेण वायुना ।\nपाञ्चाली सुखमासाद्य लेभे चेतः शनैः शनैः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2130007, "chapter_id": 3801, "verse_number": "१९", "content_sanskrit": "परिगृह्य च तां दीनां कृष्णामजिनसंस्तरे ।\nपार्था विश्रामयामासुर्लब्धसञ्ज्ञां तपस्विनीम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2130008, "chapter_id": 3801, "verse_number": "२०", "content_sanskrit": "तस्या यमौ रक्ततळौ पादौ पूजितलक्षणौ ।\nकराभ्यां किणजाताभ्यां शनकैः संववाहतुः \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2130009, "chapter_id": 3801, "verse_number": "२१", "content_sanskrit": "पर्याश्वासयदप्येनां धर्मराजो युधिष्ठिरः ।\nउवाच च कुरुश्रेष्ठो भीमसेनमिदं वचः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2130010, "chapter_id": 3801, "verse_number": "२२", "content_sanskrit": "बहवः पर्वता भीम विषमा हिमदुर्गमाः ।\nतेषु कृष्णा महाबाहो कथं नु विचरिष्यति\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2130011, "chapter_id": 3801, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2130012, "chapter_id": 3801, "verse_number": "२३", "content_sanskrit": "त्वां राजन् राजपुत्रीं च यमौ च पुरुषर्षभ ।\nस्वयं नेष्यामि राजेन्द्र मा विषादे मनः कृथाः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2130013, "chapter_id": 3801, "verse_number": "२४", "content_sanskrit": "हैडिम्बश्च महावीर्यो विहगो मद्बलोपमः ।\nवहेदनघ सर्वान् नो वचनात् ते घटोत्कचः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2130014, "chapter_id": 3801, "verse_number": "", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं भीमसेनस्य धर्मराट् ।\nभीमं सम्पूजयंस्तुष्ट एवमस्त्वित्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2130015, "chapter_id": 3801, "verse_number": "२५", "content_sanskrit": "सोऽनुज्ञातो धर्मराज्ञा पुत्रं सस्मार राक्षसम् ।\nघटोत्कचंश्च धर्मात्मा स्मृतमात्रः पितॄन् तदा\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2130016, "chapter_id": 3801, "verse_number": "२६", "content_sanskrit": "कृताञ्जलिरूपातिष्ठदभिवाद्य च पाण्डवान् ।\nब्राह्मणांश्च महाबाहुः सर्वं कर्ताऽस्म्यसंशयः ।\nतच्छ्रुत्वा भीमसेनस्तु राक्षसं परिषस्वजे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2130017, "chapter_id": 3801, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि एकचत्वारिंशदधिकशततमोऽध्यायः ॥१४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2130018, "chapter_id": 3801, "verse_number": "९७", "content_sanskrit": "॥ इति तीर्थयात्रापर्वणि सप्तनवतितमोऽध्यायः ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]