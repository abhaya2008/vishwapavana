[{"id": 7002095000, "chapter_id": 22095, "verse_number": "१४०-१", "content_sanskrit": "ईश्वर उवाच ।\nवश्यादियोगान् वक्ष्यामि लिखेद्द्व्यष्टपदे त्विमान् ।\nभृङ्गराजः सहदेवी मयूरस्य शिखा तथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002095001, "chapter_id": 22095, "verse_number": "१४०-२", "content_sanskrit": "पुत्रञ्जीवकृतञ्जली ह्यधःपुष्पा रुदन्तिका ।\nकुमारी रुद्रजटा स्याद्विष्णुक्रान्ता शितोऽर्ककः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002095002, "chapter_id": 22095, "verse_number": "१४०-३", "content_sanskrit": "लज्जालुका मोहलता कृष्णधुस्तूरसञ्ज्ञिता ।\nगोरक्षः कर्कटो चैव मेषशृङ्गी स्नुही तथा ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002095003, "chapter_id": 22095, "verse_number": "१४०-४", "content_sanskrit": "ऋत्विजो १६ वह्नये ३ नागाः ८ पक्षौ २ मुनि ३ मनू १४ शिवः ११ ।\nवसवो ८ दिक्१० रसा ६ वेदा ४ ग्रह ९ र्तु६ अवि १२ चन्द्रमाः १ ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002095004, "chapter_id": 22095, "verse_number": "१४०-५", "content_sanskrit": "तिथयश्च १५ क्रमाद्भागा ओषधीनां प्रदक्षिणं ।\nप्रथमेन चतुष्केण धूपश्चोद्वर्तनं परं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002095005, "chapter_id": 22095, "verse_number": "१४०-६", "content_sanskrit": "तृतीयेनाञ्जनं कुर्यात्स्नानं कुर्याच्चतुष्कतः ।\nभृङ्गराजानुलोमाच्च चतुर्धा लेपनं स्मृतं ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002095006, "chapter_id": 22095, "verse_number": "१४०-७", "content_sanskrit": "मुनयो दक्षणे पार्श्वे युगाद्याश्चोत्तराः स्मृताः ।\nभुजगाः पादसंस्थाश्च ईश्वरा मूर्ध्नि संस्थिताः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002095007, "chapter_id": 22095, "verse_number": "१४०-८", "content_sanskrit": "मध्येन सार्कशशिभिर्धूपः स्यात्सर्वकार्यके ।\nएतैर्विलिप्तदेहस्तु त्रिदशैरपि पूज्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002095008, "chapter_id": 22095, "verse_number": "१४०-९", "content_sanskrit": "धूपस्तु षोडशाद्यस्तु गृहाद्युद्वर्तने स्मृतः ।\nयुगाद्याश्चाञ्जने प्रोक्ता वाणाद्याः स्नानकर्मणि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002095009, "chapter_id": 22095, "verse_number": "१४०-१०", "content_sanskrit": "रुद्राद्या भक्षणे प्रोक्ताः पक्षाद्याः पानके स्मृताः ।\nऋत्विग्वेदर्तुनयनैस्तिलकं लोकमोहनं ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002095010, "chapter_id": 22095, "verse_number": "१४०-११", "content_sanskrit": "सूर्यत्रिदशपक्षैश्च शैलैः स्त्री लेपतो वशा ।\nचन्द्रेन्द्रफणिरुद्रैश्च योनिलेपाद्वशाः स्त्रियः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002095011, "chapter_id": 22095, "verse_number": "१४०-१२", "content_sanskrit": "तिथिदिग्युगवाणैश्च गुटिका तु वशङ्करी ।\nभक्ष्ये भोज्ये तथा पाने दातव्या गुटिका वशे ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002095012, "chapter_id": 22095, "verse_number": "१४०-१३", "content_sanskrit": "ऋत्विग्ग्रहाक्षिशैलैश्च शस्त्रस्तम्भे मुखे धृता ।\nशैलेन्द्रवेदरन्ध्रैश्च अङ्गलेपाज्जले वसेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002095013, "chapter_id": 22095, "verse_number": "१४०-१४", "content_sanskrit": "वाणाक्षिमनुरुद्रैश्च गुटिका क्षुत्तृषादिनुत् ।\nत्रिषोडशदिशावाणैर्लेपात्स्त्री दुर्भगा शुभा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002095014, "chapter_id": 22095, "verse_number": "१४०-१५", "content_sanskrit": "त्रिदशाक्षिदिशानेत्रैर्लेपात्क्रीडेच्च पत्रगैः ।\nत्रिदशाक्षेशभुजगैर्लेपात्स्त्री सूयते सुखं ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002095015, "chapter_id": 22095, "verse_number": "१४०-१६", "content_sanskrit": "सप्तदिङ्मुनिरन्ध्रैश्च द्यूतजिह्वस्त्रलेपतः ।\nत्रिदशाक्ष्यब्धिमुनिभिर्ध्वजलेपात् रतौ सुतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002095016, "chapter_id": 22095, "verse_number": "१४०-१७", "content_sanskrit": "ग्रहाब्धिसर्प्यत्रिदशैर्गुटिका स्याद्वशङ्करी ।\nऋत्विक्पदस्थितौषध्याः प्रभावः प्रतिपादितः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]