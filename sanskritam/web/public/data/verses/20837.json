[{"id": 7000837000, "chapter_id": 20837, "verse_number": "६-१८०-१", "content_sanskrit": "श्रीभगवानुवाच ।\nषष्ठाध्यायस्य माहात्म्यं प्रवक्ष्यामि वरानने ।\nयदाकर्णयतां नॄणां मुक्तिः करतले स्थिता॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000837001, "chapter_id": 20837, "verse_number": "६-१८०-२", "content_sanskrit": "अस्ति गोदावरी तीरे प्रतिष्ठानं पुरं महत् ।\nपिप्पलेशाभिधानोऽहं यत्रास्मि स्मेरलोचने॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000837002, "chapter_id": 20837, "verse_number": "६-१८०-३", "content_sanskrit": "यत्र गोदावरी तीर शीकरैरवशीतलैः ।\nहंसाः पक्षपुटैः कीर्णैर्हरंति यमिनां श्रमम्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000837003, "chapter_id": 20837, "verse_number": "६-१८०-४", "content_sanskrit": "स्फुरत्पद्मावलीकोशपरागसुरभीकृतम् ।\nश्लाघ्यं गोदावरीतोयं येन ते निर्जरा नराः॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000837004, "chapter_id": 20837, "verse_number": "६-१८०-५", "content_sanskrit": "धिक्सुधामौषधीशस्य विकृत्क्षयविधायिनीम् ।\nमहाराष्ट्रवधूकानां मज्जंतीनां मुनीश्वराः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000837005, "chapter_id": 20837, "verse_number": "६-१८०-६", "content_sanskrit": "स्पृशंति यत्र वक्त्राणि फुल्लपंकजशंकया ।\nयत्रखेलन्महाराष्ट्राः क्वणत्कंकणसुंदराः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000837006, "chapter_id": 20837, "verse_number": "६-१८०-७", "content_sanskrit": "हरंति ध्वनयो लीनां मनांस्यपि तपस्विनाम् ।\nअत्युच्चसौधशिखरविहारि वनितामुखम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000837007, "chapter_id": 20837, "verse_number": "६-१८०-८", "content_sanskrit": "पश्यन्ननुदिनं यत्र क्षीयते मृगलांच्छनः ।\nअत्युच्चसौधवलभी महामणिमरीचिभिः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000837008, "chapter_id": 20837, "verse_number": "६-१८०-९", "content_sanskrit": "चुंब्यंते मुनिगंधर्वैर्दूर्वाचंदनचंचलैः ।\nयस्मिन्नाधूयमानानां पताकानां समीरणैः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000837009, "chapter_id": 20837, "verse_number": "६-१८०-१०", "content_sanskrit": "गतश्रमा रवेर्याने भवंति रथवाजिनः ।\nराशीकृतैर्मलयजैरसंख्यातैर्वणिग्गणैः॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000837010, "chapter_id": 20837, "verse_number": "६-१८०-११", "content_sanskrit": "यस्मिन्नुपलशेषोऽसौ लक्ष्यते मलयाचलः ।\nपुंजीकृतानि दृश्यंते यत्र मुक्ताफलान्यपि॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000837011, "chapter_id": 20837, "verse_number": "६-१८०-१२", "content_sanskrit": "नगरीदेवता हास्य स्तबका इव सर्वतः ।\nतत्र ज्ञानश्रुतिर्नाम्ना मेदिनीवल्लभोऽभवत्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000837012, "chapter_id": 20837, "verse_number": "६-१८०-१३", "content_sanskrit": "यस्मिन्नुद्धरति क्षोणीं शेषोऽयं मणिसंनिभां ।\nअपि प्रतापमार्तंडमंडली तीव्रतेजसि॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000837013, "chapter_id": 20837, "verse_number": "६-१८०-१४", "content_sanskrit": "नित्यमध्वरधूमेन श्यामलाः कल्पशाखिनः ।\nअसाधारणदातृत्वं पश्यंत इव लज्जया॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000837014, "chapter_id": 20837, "verse_number": "६-१८०-१५", "content_sanskrit": "यदध्वरपुरोडाश चर्वणास्वादलंपटाः ।\nन तत्यजुः सुपर्वाणः प्रतिष्ठानपुरं मनाक्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000837015, "chapter_id": 20837, "verse_number": "६-१८०-१६", "content_sanskrit": "यस्यदानांबुधाराभिः प्रतापज्योत्स्नयानिशम् ।\nमखधूमैश्च संपुष्टा ववृषुः समये घनाः॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000837016, "chapter_id": 20837, "verse_number": "६-१८०-१७", "content_sanskrit": "स्वल्पमात्रमपि क्वापि न पदं प्रापुरीतयः ।\nनीतयः प्रसरंति स्म यस्मिन्शासति मेदिनीम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000837017, "chapter_id": 20837, "verse_number": "६-१८०-१८", "content_sanskrit": "वापिकूपतडागानां च्छद्मना योऽनुवासरम् ।\nहृदयस्थानि मेदिन्या निधानानि व्यलोकयत्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000837018, "chapter_id": 20837, "verse_number": "६-१८०-१९", "content_sanskrit": "पांडुराभिः पताकाभिः प्रासादो यस्य राजते ।\nवियद्गंगातरंगोघैर्हिमाद्रिरिव सानुमान्॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000837019, "chapter_id": 20837, "verse_number": "६-१८०-२०", "content_sanskrit": "दानैस्तपोभिर्यज्ञैश्च प्रजानां पालनेन च ।\nतुष्टाः स्वर्गौकसस्तस्मै वरं दातुं समागमन्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000837020, "chapter_id": 20837, "verse_number": "६-१८०-२१", "content_sanskrit": "ततोंतरिक्षमार्गेण धुन्वानाः पक्षसंहतीः ।\nमृणालधवला देवी देवहंसा विनिर्गताः॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000837021, "chapter_id": 20837, "verse_number": "६-१८०-२२", "content_sanskrit": "त्वरया गच्छतां तेषामन्योन्यं तत्र भाषिणाम् ।\nभद्राश्वप्रमुखा द्वित्राः पुरस्तान्निर्ययुर्जवात्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000837022, "chapter_id": 20837, "verse_number": "६-१८०-२३", "content_sanskrit": "सर्वैर्मिलद्भिरूचुस्ते पुरस्ताद्गच्छतो जवात् ।\nकथं वेगेन निर्याता भवंतः पुरतः स्थिताः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000837023, "chapter_id": 20837, "verse_number": "६-१८०-२४", "content_sanskrit": "सर्वैर्मिलित्वा गंतव्यमस्मिन्नध्वनि दुर्गमे ।\nप्रकाशमानं पुरतस्तेजःपुंजं न पश्यथ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000837024, "chapter_id": 20837, "verse_number": "६-१८०-२५", "content_sanskrit": "ज्ञानश्रुतेर्महीभर्तुः पुण्यमूर्त्तेरतिस्फुटम् ।\nनिशम्येति वचः सम्यक्पाश्चात्याना पुरः स्थिताः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000837025, "chapter_id": 20837, "verse_number": "६-१८०-२६", "content_sanskrit": "हंसा हसित्वा सावज्ञमूचुर्वचनमुच्चकैः ।\nरैक्याभिधस्य दुर्द्धर्ष तेजसो ब्रह्मवादिनः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000837026, "chapter_id": 20837, "verse_number": "६-१८०-२७", "content_sanskrit": "किं नु ज्ञानश्रुतेरस्य राज्ञस्तीव्रतरं महः ।\nइति शुश्राव हंसानां गिरो ज्ञानश्रुतिर्नृपः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000837027, "chapter_id": 20837, "verse_number": "६-१८०-२८", "content_sanskrit": "अत्युच्चसौधभवनमारुह्य च सुखं स्थितः ।\nततः सारथिमाहूय भूपालो विस्मयान्वितः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000837028, "chapter_id": 20837, "verse_number": "६-१८०-२९", "content_sanskrit": "संदिदेश महात्माऽसौ रैक्य आनीयतामिति ।\nततोऽवधार्य भूपालवचः पीयूषगर्भितम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000837029, "chapter_id": 20837, "verse_number": "६-१८०-३०", "content_sanskrit": "निर्जगाममहो नाम्ना सारथिः प्रथयन्मुदम् ।\nयत्र वाराणसीनाम नगरी मुक्तिदायिनी॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000837030, "chapter_id": 20837, "verse_number": "६-१८०-३१", "content_sanskrit": "यत्र विश्वेश्वरो नाम ह्युपदेष्टा जगत्पतिः ।\nततो गयाभिधे क्षेत्रे यत्र देवो गदाधरः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000837031, "chapter_id": 20837, "verse_number": "६-१८०-३२", "content_sanskrit": "उद्धर्तुमखिलान्लोकान्वसत्युत्फुल्ललोचनः ।\nततो गौरीगुरोः पार्श्वे सर्वैस्तीर्थैरनेकधा॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000837032, "chapter_id": 20837, "verse_number": "६-१८०-३३", "content_sanskrit": "पर्यटन्गतवान्यत्र केदारः पापदारणः ।\nयमालोक्य सकृन्मर्त्या मुक्ताः स्युर्नात्र संशयः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000837033, "chapter_id": 20837, "verse_number": "६-१८०-३४", "content_sanskrit": "महापापविर्निमुक्ता भुक्त्वा भोगान्यथेप्सितान् ।\nततो गौडेषु निर्यातो यत्रास्ते पुरुषोत्तमः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000837034, "chapter_id": 20837, "verse_number": "६-१८०-३५", "content_sanskrit": "यस्यावलोकनादेव नराः स्वर्लोकगामिनः ।\nततो द्वारावतीं प्रागान्नगरीं मुक्तिदायिनीम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000837035, "chapter_id": 20837, "verse_number": "६-१८०-३६", "content_sanskrit": "यत्रास्ते गोमती तीरे रुक्मिणीवल्लभो हरिः ।\nस्नात्वा च गोमतीतीर्थे पंचकृष्णान्विलोक्य च॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000837036, "chapter_id": 20837, "verse_number": "६-१८०-३७", "content_sanskrit": "मर्त्यो मुक्तिमवाप्नोति भुक्त्वा भोगान्यथेप्सितान् ।\nततः समुद्रमासाद्य सोमनाथं विलोक्य च॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000837037, "chapter_id": 20837, "verse_number": "६-१८०-३८", "content_sanskrit": "भुक्तिमुक्तिप्रदं देवं ततो निरगमन्सुधीः ।\nअवंतिकां पुरीं प्राप्तो भुक्तिमुक्तिप्रदायिनीम्॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000837038, "chapter_id": 20837, "verse_number": "६-१८०-३९", "content_sanskrit": "यत्रोमया सुखं क्रीडन्महाकालोस्ति शंकरः ।\nअथोंकारं समासाद्य शर्मदं नर्मदातटे ।\nभुक्तिमुक्तिप्रदातारं त्वरया निर्गतस्ततः॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000837039, "chapter_id": 20837, "verse_number": "६-१८०-४०", "content_sanskrit": "अश्वमेधकरं नाम्ना नगरं पर्यटंस्ततः ।\nयत्र शार्ङ्गधरः साक्षादास्ते लक्ष्मीपतिः स्वयम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000837040, "chapter_id": 20837, "verse_number": "६-१८०-४१", "content_sanskrit": "ततो विष्णुगयां प्राप्तः कुण्डं लोणारसंज्ञितम् ।\nयत्र स्नात्वा च पीत्वा च मुच्यते बन्धनान्नरः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000837041, "chapter_id": 20837, "verse_number": "६-१८०-४२", "content_sanskrit": "ततः कोल्हापुरं नाम गतो रुद्रगयां प्रति ।\nआस्ते भगवती यत्र लक्ष्मीर्भक्तिप्रदायिनी॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000837042, "chapter_id": 20837, "verse_number": "६-१८०-४३", "content_sanskrit": "पञ्चनद्यां नरः स्नात्वा महालक्ष्मीं विलोक्य च ।\nभुक्त्वा भोगान्यथाकामं भक्तिं च प्रतिपद्यते॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000837043, "chapter_id": 20837, "verse_number": "६-१८०-४४", "content_sanskrit": "ततोऽमलगिरिं नाम नगरीं प्रतिपद्य च ।\nनन्दिकेश्वरमारुह्य सोमनाथोऽस्ति यत्र तु॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000837044, "chapter_id": 20837, "verse_number": "६-१८०-४५", "content_sanskrit": "दृष्ट्वा चतुर्भुजं देवं वरदानोद्यतं शिवम् ।\nसोमनाथं नृणां मुक्तिर्भवत्येव न संशयः॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000837045, "chapter_id": 20837, "verse_number": "६-१८०-४६", "content_sanskrit": "तुङ्गभद्रानदी तीरे दृष्ट्वा हरिहरं ततः ।\nयुगेयुगे भुजा यस्य पतन्त्यवनिमण्डले॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000837046, "chapter_id": 20837, "verse_number": "६-१८०-४७", "content_sanskrit": "यद्विलोक्य नराः सर्वे रम्यं हरिहरं वपुः ।\nभुक्त्वा भोगान्यथाकामं मुच्यन्ते बन्धनान्नराः॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000837047, "chapter_id": 20837, "verse_number": "६-१८०-४८", "content_sanskrit": "स्वर्गे कल्पशतं स्थित्वा मुक्तसंसारबन्धनाः ।\nततः स्वामिनमालोक्य लोकानां स्वामिनं विभुम्॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000837048, "chapter_id": 20837, "verse_number": "६-१८०-४९", "content_sanskrit": "यमालोक्य न पश्यन्ति निरयं जातुचिन्नराः ।\nस्वर्गे कल्पशतं स्थित्वा मुक्तसंसारवासनाः॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000837049, "chapter_id": 20837, "verse_number": "६-१८०-५०", "content_sanskrit": "मुक्तिं च प्रतिदद्यन्ते नात्र कार्या विचारणा ।\nततः श्रीशैलमासाद्य सिद्धगन्धर्वसेवितम्॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000837050, "chapter_id": 20837, "verse_number": "६-१८०-५१", "content_sanskrit": "गिरिजावल्लभो यत्र मल्लिनाथोऽभिधानतः ।\nउद्धर्तुमखिलांल्लोकान्संसाराम्भोधिमध्यतः॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000837051, "chapter_id": 20837, "verse_number": "६-१८०-५२", "content_sanskrit": "स्वर्गे कल्पशतं स्थित्वा मुक्तसंसारबंधनाः ।\nमुक्तिं च प्रतिपद्यंते नात्र कार्या विचारणा॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000837052, "chapter_id": 20837, "verse_number": "६-१८०-५३", "content_sanskrit": "ततः श्रीशैलमासाद्य सिद्धगंधर्वसेवितम् ।\nगिरिजावल्लभो यत्र मल्लिनाथोऽभिधानतः॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000837053, "chapter_id": 20837, "verse_number": "६-१८०-५४", "content_sanskrit": "उद्धर्तुमखिलांल्लोकान्संसारांबुधिमध्यतः ।\nकालेकाले परं ज्योतिर्यः संदर्शयते स्वयम्॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000837054, "chapter_id": 20837, "verse_number": "६-१८०-५५", "content_sanskrit": "अवलोकयतां नॄणां यमनुस्मरतामपि ।\nदूरे तिष्ठंति संत्रस्ता दूरं निरययातनाः॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000837055, "chapter_id": 20837, "verse_number": "६-१८०-५६", "content_sanskrit": "स्वर्गे लोके सुखं भुक्त्वा मुक्तसंसारबंधनाः ।\nमुक्तिं च प्रतिपद्यंते मानवा नात्र संशयः॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000837056, "chapter_id": 20837, "verse_number": "६-१८०-५७", "content_sanskrit": "रामोस्ति सानुजः सार्द्धं जानक्यापि ततो गतः ।\nतत्र स्नात्वा च पीत्वा च मुच्यते नरकाद्ध्रुवम्॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000837057, "chapter_id": 20837, "verse_number": "६-१८०-५८", "content_sanskrit": "कल्पकोटिशतं भुक्त्वा स्वर्गलोकसुखं नराः ।\nमुक्तसंसारवर्त्मानो मुक्तिं यांति न संशयः॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000837058, "chapter_id": 20837, "verse_number": "६-१८०-५९", "content_sanskrit": "ततो निवृत्य आयातः पश्यन्भीमरथी तटे ।\nद्विभुजं विठ्ठलं देवं भुक्तिमुक्तिप्रदायकम्॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000837059, "chapter_id": 20837, "verse_number": "६-१८०-६०", "content_sanskrit": "यत्र गोदावरीजन्मस्थानं ब्रह्मगिरिर्महान् ।\nगौतमालयमासाद्य यत्रास्ते त्र्यंबको हरः॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000837060, "chapter_id": 20837, "verse_number": "६-१८०-६१", "content_sanskrit": "अरुणावरुणयोर्मध्ये यत्र गोदावरी नदी ।\nतत्र स्नात्वा च पीत्वा च ब्रह्महत्या विलीयते॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000837061, "chapter_id": 20837, "verse_number": "६-१८०-६२", "content_sanskrit": "असंख्यतीर्थसंपन्नं दृष्ट्वा ब्रह्मगिरिं नराः ।\nमुक्तिमेव प्रपद्यंते मुक्ताः संसारदुःखतः॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000837062, "chapter_id": 20837, "verse_number": "६-१८०-६३", "content_sanskrit": "गौतम्युभयतीरस्थ तीर्थान्वेषणकौतुकी ।\nततो जगाम सूतस्तु मथुरां पापनाशिनीम्॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000837063, "chapter_id": 20837, "verse_number": "६-१८०-६४", "content_sanskrit": "यत्र स्वायंभुवं देवं भजंति सुरमानवाः ।\nआद्यं भगवतः स्थानं महन्मुक्तिप्रदायकम्॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000837064, "chapter_id": 20837, "verse_number": "६-१८०-६५", "content_sanskrit": "त्रैलोक्येश जनिस्थानं विख्यातं वेदशास्त्रयोः ।\nनानादेवगणैर्जुष्टं द्विजर्षिगणसेवितम्॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000837065, "chapter_id": 20837, "verse_number": "६-१८०-६६", "content_sanskrit": "कालिंदीकूलसंशोभि ह्यर्द्धचंद्र प्रभाकृति ।\nसर्वतीर्थनिवासैक पूर्णमानंदसुंदरम्॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000837066, "chapter_id": 20837, "verse_number": "६-१८०-६७", "content_sanskrit": "गोवर्द्धनगिरिप्रख्यं पुण्यद्रुमलतावृतम् ।\nद्विषड्वनं महापुण्यं विश्रांति श्रुतिसारभृत्॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000837067, "chapter_id": 20837, "verse_number": "६-१८०-६८", "content_sanskrit": "ततः काश्मीरनगरमपश्यत्प्रत्यगुत्तरम् ।\nदृष्ट्वा धर्मधुरं क्षेत्रं कुरुक्षेत्रं समंततः॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000837068, "chapter_id": 20837, "verse_number": "६-१८०-६९", "content_sanskrit": "यत्राभ्रंलिहगेहानां पंक्तयः शंखपाण्डुराः ।\nता जाता धूर्जटेः स्पष्ट अट्टहासदशा इव॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000837069, "chapter_id": 20837, "verse_number": "६-१८०-७०", "content_sanskrit": "भक्तिप्रसादमालानां सुवर्णकलशैर्वृतम् ।\nस्वः सिंधोः पतितानीव हेमपद्मानि मारुतैः॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000837070, "chapter_id": 20837, "verse_number": "६-१८०-७१", "content_sanskrit": "यत्र प्रासादशिखरे नीलपट्टपताकिकाः ।\nशैवालवलयाभांति स्वः सिंधोर्लतिका इव॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000837071, "chapter_id": 20837, "verse_number": "६-१८०-७२", "content_sanskrit": "यत्र काश्मीरमाश्रित्य नित्यं वसति भारती ।\nनौचेद्युगपदेवेदं कथं लिखति वाङ्मयम्॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000837072, "chapter_id": 20837, "verse_number": "६-१८०-७३", "content_sanskrit": "विश्रामंत्याः सरस्वत्याश्चिरं यत्र मदालसाः ।\nमृणालचंचवो हंसा वाहनानि चरंत्यमी॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000837073, "chapter_id": 20837, "verse_number": "६-१८०-७४", "content_sanskrit": "कलाविशेषं प्रहिता यत्र बोद्धुं विरंचिना ।\nतारा इव विराजंते हंसा याताः समंततः॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000837074, "chapter_id": 20837, "verse_number": "६-१८०-७५", "content_sanskrit": "स्थलपद्मानि दृश्यंते करस्पर्शसुखानि च ।\nशयनाय नितंबिन्या यस्मिन्दानववैरिणा॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000837075, "chapter_id": 20837, "verse_number": "६-१८०-७६", "content_sanskrit": "उपन्यासैर्द्विजातीनां यत्र न श्रूयते स्फुटम् ।\nमूकोऽपि निर्जरो वाचा पदकल्लोलडंबरः॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000837076, "chapter_id": 20837, "verse_number": "६-१८०-७७", "content_sanskrit": "यस्मिन्नध्वरधूमेन व्याप्तं गगनमंडलम् ।\nअपि च क्षालितं मेघैः कालिमानं न मुंचति॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000837077, "chapter_id": 20837, "verse_number": "६-१८०-७८", "content_sanskrit": "गलितायाः सुधायास्तु यत्राध्वरमहार्चिषा ।\nलांछितं छद्मनास्थानं दृश्यते तुहिनत्विषि॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000837078, "chapter_id": 20837, "verse_number": "६-१८०-७९", "content_sanskrit": "जन्माभ्यासवशादेव पठंति बटवः स्वयम् ।\nयत्रोपाध्यायसान्निध्यमाश्रित्य सकलाः कलाः॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000837079, "chapter_id": 20837, "verse_number": "६-१८०-८०", "content_sanskrit": "यत्र ब्राह्मणपत्नीनां कंकणध्वनि हुंकृतिः ।\nलुंपत्यनुदिनं भ्राम्यद्भ्रमराणां च गर्जितम्॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000837080, "chapter_id": 20837, "verse_number": "६-१८०-८१", "content_sanskrit": "यत्र ब्राह्मणपत्नीनां कपोलफलकं मुहुः ।\nस्पृशन्समीरणो मंदं वाति शापभयादिव॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000837081, "chapter_id": 20837, "verse_number": "६-१८०-८२", "content_sanskrit": "माणिक्येश्वरनामासौ यत्र शीतांशुशेखरः ।\nवसत्यनुदिनं देवो वरदानाय देहिनाम्॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000837082, "chapter_id": 20837, "verse_number": "६-१८०-८३", "content_sanskrit": "अर्चितो भूपतीन्जित्वा मणिकेशेन चादृतः ।\nमाणिक्येश्वर इत्याख्यां तदाप्रभृति यो दधौ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000837083, "chapter_id": 20837, "verse_number": "६-१८०-८४", "content_sanskrit": "राज्ञा काश्मीरदेवेश दिग्जयोत्सवकारिणा ।\nअसौ सुपूजितो यस्मान्माणिक्यैर्भूरिभूतिभिः॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000837084, "chapter_id": 20837, "verse_number": "६-१८०-८५", "content_sanskrit": "संसेवमानं तद्वारि छायां शकटिकोपरि ।\nकंडूयमानमंगानि यंता रैक्यमपश्यत॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000837085, "chapter_id": 20837, "verse_number": "६-१८०-८६", "content_sanskrit": "राज्ञापि कथितैस्तैस्तैश्चिह्नैः परिचितं जवात् ।\nप्रणतः सारथी रैक्यं प्रणम्य तमभाषत॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000837086, "chapter_id": 20837, "verse_number": "६-१८०-८७", "content_sanskrit": "सारथिरुवाच ।\nकस्मिन्ब्रह्मन्किन्नामासि स्वछंदोऽसि निरंतरम् ।\nकिमर्थमत्र विश्रांतः किं च कर्तुं चिकीर्षसि॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000837087, "chapter_id": 20837, "verse_number": "६-१८०-८८", "content_sanskrit": "इत्याकर्ण्य च तद्वाक्यं परमानंदनिर्भरः ।\nस्मृत्वा सारथिमित्यूचे वयं पूर्णमनोरथाः॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000837088, "chapter_id": 20837, "verse_number": "६-१८०-८९", "content_sanskrit": "परं केनापि बहुना परिचर्याविधायिना ।\nभवितव्यं मनोवृत्तिं जानतास्माकमेव हि॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000837089, "chapter_id": 20837, "verse_number": "६-१८०-९०", "content_sanskrit": "हृदयस्थितमादाय रैक्याभिप्रायमादरात् ।\nशनैर्निरगमद्यंता यत्रास्ते वसुधाधिपः॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000837090, "chapter_id": 20837, "verse_number": "६-१८०-९१", "content_sanskrit": "ततः प्रणम्य भूपालं यथावृत्तं न्यवेदयत् ।\nबद्धांजलिपुटो हृष्टः सारथिः स्वामिदर्शनात्॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000837091, "chapter_id": 20837, "verse_number": "६-१८०-९२", "content_sanskrit": "ततो निशम्य तद्वाक्यं विस्मयस्मेरलोचनः ।\nश्रद्धालुरभवद्भूपो रैक्यसंभावनाविधौ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000837092, "chapter_id": 20837, "verse_number": "६-१८०-९३", "content_sanskrit": "आदायाश्वतरीयुग्मयुक्तां शकटिकामगात् ।\nमुक्ताहारदुकूलानि सहस्रं च गवां नृपः॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000837093, "chapter_id": 20837, "verse_number": "६-१८०-९४", "content_sanskrit": "गतोऽसौ तत्र यत्रास्ते योगी काश्मीरमंडले ।\nतन्निवेद्य पुरो राजा दंडवत्पतितो भुवि॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000837094, "chapter_id": 20837, "verse_number": "६-१८०-९५", "content_sanskrit": "आनम्य परया भक्त्या रैक्यो राज्ञे चुकोप ह ।\nरे शूद्र मामकं वृत्तं न जानासि दुरीश्वर॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000837095, "chapter_id": 20837, "verse_number": "६-१८०-९६", "content_sanskrit": "गृहाण शकटीमेतामुत्थाप्याश्वतरी युताम् ।\nवस्त्राणि मुक्ताहारांश्च गाश्च दोग्ध्रीरपि स्वयम्॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000837096, "chapter_id": 20837, "verse_number": "६-१८०-९७", "content_sanskrit": "इत्थमाज्ञतवान्भूपो रैक्यस्य भयमादधे ।\nततः शापभयाद्राजा तत्पदांभोरुहद्वयम्॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000837097, "chapter_id": 20837, "verse_number": "६-१८०-९८", "content_sanskrit": "गृह्णन्भक्त्या प्रसीदेति ब्रह्मन्नित्यूचिवान्स्वयम्॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000837098, "chapter_id": 20837, "verse_number": "६-१८०-९९", "content_sanskrit": "राजोवाच ।\nभगवंस्तव माहात्म्यमेतदत्युद्भुतं कुतः ।\nप्रसन्नीभूय भगवन्नाख्याहि मम तत्त्वतः॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000837099, "chapter_id": 20837, "verse_number": "६-१८०-१००", "content_sanskrit": "रैक्य उवाच ।\nगीतानां षष्ठमध्यायं जपामि प्रत्यहं नृप ।\nतेनैव तेजोराशिर्मे सुराणामपि दुःसहः॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000837100, "chapter_id": 20837, "verse_number": "६-१८०-१०१", "content_sanskrit": "गीतानां षष्ठमध्यायं रैक्यादभ्यस्य यत्नतः ।\nज्ञानश्रुतिर्महीपालो मुक्तिमाप ततः सुधीः॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000837101, "chapter_id": 20837, "verse_number": "६-१८०-१०२", "content_sanskrit": "रैक्योऽपि सुखमालेभे माणिक्येश्वरसन्निधौ ।\nगीतानां षष्ठमध्यायं जपन्मोक्षप्रदायकम्॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000837102, "chapter_id": 20837, "verse_number": "६-१८०-१०३", "content_sanskrit": "मरालवेषमास्थाय वरदानार्थमागताः ।\nदिवौकसोऽपि निर्जग्मुः स्वैरं विस्मयकारिताः॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000837103, "chapter_id": 20837, "verse_number": "६-१८०-१०४", "content_sanskrit": "इममध्यायमप्येकं यो जपेत्सततं नरः ।\nसोऽपि तत्पदवीमेति विष्णोरेव न संशयः॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}]