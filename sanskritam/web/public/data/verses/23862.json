[{"id": 7003862000, "chapter_id": 23862, "verse_number": "२-५-१३-१", "content_sanskrit": "श्रीभगवानुवाच ।\nशृणु पुत्र प्रवक्ष्यामि जागरस्य च लक्षणम् ।\nयेन विज्ञातमात्रेण सुलभोऽहं सदा कलौ ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003862001, "chapter_id": 23862, "verse_number": "२-५-१३-२", "content_sanskrit": "गीतं वाद्यं च नृत्यं च पुराणपठनं तथा ।\nधूपं दीपं च नैवेद्यं पुष्पं गन्धानुलेपनम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003862002, "chapter_id": 23862, "verse_number": "२-५-१३-३", "content_sanskrit": "फलार्पणं च श्रद्धां च दानमिंद्रियसंयमम् ।\nसत्यान्वितं विनिद्रं च मुदा मद्यजनान्वितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003862003, "chapter_id": 23862, "verse_number": "२-५-१३-४", "content_sanskrit": "साश्चर्यं चैव सोत्साहं पापालस्यादिवर्जनम् ।\nप्रदक्षिणासमायुक्तं नमस्कारपुरःसरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003862004, "chapter_id": 23862, "verse_number": "२-५-१३-५", "content_sanskrit": "नीराजनसमायुक्तमतिहृष्टेन चेतसा ।\nयामेयामे महाभाग कुर्यादारार्तिकं मम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003862005, "chapter_id": 23862, "verse_number": "२-५-१३-६", "content_sanskrit": "षड्विंशद्गुणसंयुक्तमेकादश्यां च जागरम् ।\nयः करोति नरो भक्त्या न पुनर्जायते भुवि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003862006, "chapter_id": 23862, "verse_number": "२-५-१३-७", "content_sanskrit": "य एवं कुरुते भक्त्या वित्तशाठ्यविवर्जितः ।\nजागरं परया भक्त्या स लीनो जायते मयि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003862007, "chapter_id": 23862, "verse_number": "२-५-१३-८", "content_sanskrit": "दष्टाः कलिभुजंगेन स्वपन्ते ये दिने मम ।\nकुर्वंति जागरं नैव मायापाशविमोहिताः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003862008, "chapter_id": 23862, "verse_number": "२-५-१३-९", "content_sanskrit": "प्राप्ताप्येकादशी येषां कलौ जागरणं विना ।\nते विनष्टा न संदेहो यस्माज्जीवितमध्रुवम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003862009, "chapter_id": 23862, "verse_number": "२-५-१३-१०", "content_sanskrit": "उद्धृतं नेत्रयुग्मं च दत्त्वा वै हृदये पदम् ।\nकृतं ये नैव पश्यंति पापिनो मम जागरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003862010, "chapter_id": 23862, "verse_number": "२-५-१३-११", "content_sanskrit": "अभावे वाचकस्याऽथ गीतं नृत्यं च कारयेत् ।\nवाचके सति देवेश पुराणं प्रथमं पठेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003862011, "chapter_id": 23862, "verse_number": "२-५-१३-१२", "content_sanskrit": "अश्वमेधसहस्रस्य वाजपेयशतस्य च ।\nपुण्यं कोटिगुणं पुत्र मम जागरणे कृते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003862012, "chapter_id": 23862, "verse_number": "२-५-१३-१३", "content_sanskrit": "पितृपक्षे मातृपक्षे भार्यापक्षे च मानद ।\nकुलान्युद्धरते चैतन्मम जागरणे कृते ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003862013, "chapter_id": 23862, "verse_number": "२-५-१३-१४", "content_sanskrit": "उपोषणदिने विघ्ने प्रारब्धे जागरे सति ।\nविहाय स्थानं तत्राहं शापं दत्त्वा व्रजाम्यहम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003862014, "chapter_id": 23862, "verse_number": "२-५-१३-१५", "content_sanskrit": "अविद्धवासरे ये मे प्रकुर्वंति हि जागरम् ।\nतेषां मध्ये प्रहृष्टः सन्नृत्यं वै प्रकरोम्यहम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003862015, "chapter_id": 23862, "verse_number": "२-५-१३-१६", "content_sanskrit": "यावद्दिनानि कुरुते जागरं मम सन्निधौ ।\nयुगाऽयुतानि तावंति वसते मम वेश्मनि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003862016, "chapter_id": 23862, "verse_number": "२-५-१३-१७", "content_sanskrit": "न गयापिंडदानेन न तीर्थैर्बहुभिर्मखैः ।\nपूर्वजा मुक्तिमायांति विनैकादशिजागरात् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003862017, "chapter_id": 23862, "verse_number": "२-५-१३-१८", "content_sanskrit": "यः कुर्याज्जागरे पूजां कुसुमैर्मम वासरे ।\nपुष्पेपुष्पेऽश्वमेधस्य फलमाप्नोति मानवः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003862018, "chapter_id": 23862, "verse_number": "२-५-१३-१९", "content_sanskrit": "यः कुर्याद्दीपदानं च रात्रौ जागरणे मम ।\nनिमिषे निमिषे पुत्र लभते गोऽयुतं फलम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003862019, "chapter_id": 23862, "verse_number": "२-५-१३-२०", "content_sanskrit": "यो दद्याज्जागरे पुत्र हविष्यान्नसमुद्भवम् ।\nनैवेद्यं लभते पुण्यं शालिशैलसमुद्भवम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003862020, "chapter_id": 23862, "verse_number": "२-५-१३-२१", "content_sanskrit": "पक्वान्नानि च यो दद्यात्फलानि विविधनि च ।\nजागरे मे चतुर्वक्त्र लभते गोशतं फलम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003862021, "chapter_id": 23862, "verse_number": "२-५-१३-२२", "content_sanskrit": "कर्पूरेण च तांबूलं ददाति मम जागरे ।\nमद्भक्तो मत्प्रसादेन सप्तद्वीपाऽधिपो भवेत् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003862022, "chapter_id": 23862, "verse_number": "२-५-१३-२३", "content_sanskrit": "जागरे मम देवेश यः कुर्यात्पुष्पमण्डपम् ।\nस पुष्पकविमानेन क्रीडते मम सद्मनि ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003862023, "chapter_id": 23862, "verse_number": "२-५-१३-२४", "content_sanskrit": "जागरे मे तु यो धूपं सकर्पूरं सगुग्गुलम् ।\nददाति दहते पापं जन्मलक्षसमुद्भवम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003862024, "chapter_id": 23862, "verse_number": "२-५-१३-२५", "content_sanskrit": "स्नापयेज्जागरे यो मां दधिक्षीरघृतांबुकैः ।\nभोगानिह लभेद्वै स ह्यन्ते च परमां गतिम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003862025, "chapter_id": 23862, "verse_number": "२-५-१३-२६", "content_sanskrit": "दिव्यांऽबराणि यो दद्यात्फलानि विविधानि च ।\nस चिरं वसते स्वर्गे तं तु संख्यासमानि वै ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003862026, "chapter_id": 23862, "verse_number": "२-५-१३-२७", "content_sanskrit": "दद्यादाभरणं यो मे हेमजं रत्नसंभवम् ।\nसप्तकल्पानि वसते सोत्संगे मत्प्रियो मम ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003862027, "chapter_id": 23862, "verse_number": "२-५-१३-२८", "content_sanskrit": "घृतेन दीपकं यो मे गव्येन च विशेषतः ।\nज्वालयेज्जागरे रात्रौ निमिषे गोयुतं फलम् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003862028, "chapter_id": 23862, "verse_number": "२-५-१३-२९", "content_sanskrit": "जागरे मे चतुर्वक्त्र कर्पूरेण च दीपकम् ।\nयो ज्वालयेत नीराजं कपिलादानजं फलम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003862029, "chapter_id": 23862, "verse_number": "२-५-१३-३०", "content_sanskrit": "यः पुनः कुरुते दीपं गीतं नृत्यं च पूजनम् ।\nशतक्रतुसमं पुण्यं व्रतैर्दानशतैरपि ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003862030, "chapter_id": 23862, "verse_number": "२-५-१३-३१", "content_sanskrit": "स्वयं यः कुरुते गीतं विलज्जो नृत्यते यदि ।\nस लभेन्निमिषार्धेन कोटियज्ञकृतं फलम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003862031, "chapter_id": 23862, "verse_number": "२-५-१३-३२", "content_sanskrit": "निवारयति यो गीतं नृत्यं जागरणे मम ।\nषष्टियुगसहस्राणि पच्यते रौरवादिषु ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003862032, "chapter_id": 23862, "verse_number": "२-५-१३-३३", "content_sanskrit": "नृत्यमानस्य मर्त्यस्य ये केचिन्निकटे गताः ।\nविमुक्ता धर्मराजेन मुक्ता यांति च मत्पदम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003862033, "chapter_id": 23862, "verse_number": "२-५-१३-३४", "content_sanskrit": "नृत्यमानस्य मर्त्यस्य उपहासं करोति यः ।\nजागरे यांति निरयं यावदिंद्राश्चतुर्दश ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003862034, "chapter_id": 23862, "verse_number": "२-५-१३-३५", "content_sanskrit": "जागरे मम यः कुर्याद्भक्त्या पुस्तकवाचनम् ।\nश्लोकसंख्यायुगान्येव स वसेन्मम सन्निधौ ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003862035, "chapter_id": 23862, "verse_number": "२-५-१३-३६", "content_sanskrit": "प्रदक्षिणाप्रदानेन यत्फलं कथितं बुधैः ।\nन तत्कोटिमखैः पुण्यं युगसंख्यैरवाप्यते ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003862036, "chapter_id": 23862, "verse_number": "२-५-१३-३७", "content_sanskrit": "दीपमाला ममाग्रे वै यः कुर्याज्जागरे सुत ।\nविमानकोटिसंयुक्त आकल्पं वसते दिवि ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003862037, "chapter_id": 23862, "verse_number": "२-५-१३-३८", "content_sanskrit": "मम बालचरित्राणि जागरे पठते हि यः ।\nयुगकोटिसहस्राणि श्वेतद्वीपे वसेन्नरः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003862038, "chapter_id": 23862, "verse_number": "२-५-१३-३९", "content_sanskrit": "तस्माज्जागरणं कार्यं पक्षयोः शुक्लकृष्णयोः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003862039, "chapter_id": 23862, "verse_number": "२-५-१३-४०", "content_sanskrit": "यो गीतां पठते रात्रौ मम नामसहस्रकम् ।\nवेदोक्तानां पुराणानां जागरात्पुण्यमाप्नुयात् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003862040, "chapter_id": 23862, "verse_number": "२-५-१३-४१", "content_sanskrit": "धेनुदानं तु यः कुर्याज्जागरे मम पु्त्रक ।\nलभते नात्र संदेहः सप्तद्वीपवतीफलम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003862041, "chapter_id": 23862, "verse_number": "२-५-१३-४२", "content_sanskrit": "सर्वेषामेव पुण्यानां महत्पुण्यं महीतले ।\nद्वादशीजागरं पुत्र प्रसिद्धं भुवनत्रये ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003862042, "chapter_id": 23862, "verse_number": "२-५-१३-४३", "content_sanskrit": "जागरं ये च कुर्वंति कर्मणा मनसा गिरा ।\nन तेषां पुनरावृत्तिर्मम लोकात्कथंचन ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003862043, "chapter_id": 23862, "verse_number": "२-५-१३-४४", "content_sanskrit": "प्रोत्साहयित्वा लोकान्यः कुरुते जागरं निशि ।\nप्राप्नोति चक्रवर्तित्वं सत्यं मे व्याहृतं सुत ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003862044, "chapter_id": 23862, "verse_number": "२-५-१३-४५", "content_sanskrit": "संमानिताः ककुत्स्थेन रात्रौ जागरकारिणः ।\nस्वशक्त्या चैव दानेन प्राप्तं राज्यं सुदुर्लभम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003862045, "chapter_id": 23862, "verse_number": "२-५-१३-४६", "content_sanskrit": "ये केचिद्गायका विप्रा वादका नर्तकाश्च ये ।\nनर्तकीसहिता यांति मम लोके सनातने ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003862046, "chapter_id": 23862, "verse_number": "२-५-१३-४७", "content_sanskrit": "दुर्योनिषु गतैः सर्वैः कृत्वा जागरणं मम ।\nसंप्राप्तं पृथिवीशत्वं कामुकैर्मुनिसत्तम ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003862047, "chapter_id": 23862, "verse_number": "२-५-१३-४८", "content_sanskrit": "निष्कामा मुक्तिमापन्नाः श्वपचाद्याश्च जागरात् ।\nविवेको नास्ति वर्णानां मम जागरकारिणाम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003862048, "chapter_id": 23862, "verse_number": "२-५-१३-४९", "content_sanskrit": "न कलौ पावनं ध्यानं न कलौ जाह्नवीजलम् ।\nन कलौ पावनं जाप्यं मुक्त्वैकं जागरं मम ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003862049, "chapter_id": 23862, "verse_number": "२-५-१३-५०", "content_sanskrit": "द्वादशीदिवसे प्राप्ते ये कुर्वंति हि जागरम् ।\nते धन्यास्ते कृतार्था वै कलिकाले न संशयः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003862050, "chapter_id": 23862, "verse_number": "२-५-१३-५१", "content_sanskrit": "न भूयान्मानुषे लोके द्वादशीविमुखो नरः ।\nअतीतानागतान्वाऽपि पातयेन्नरके हि सः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003862051, "chapter_id": 23862, "verse_number": "२-५-१३-५२", "content_sanskrit": "वरमेको गुणैर्युक्तः किं जातैर्बहुभिः सुतैः ।\nद्वादशीजागरात्सर्वांस्तारयेद्यो हि पूर्वजान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003862052, "chapter_id": 23862, "verse_number": "२-५-१३-५३", "content_sanskrit": "माहात्म्यं पठते भक्त्या मयोक्तं जागरोद्भवम् ।\nद्वादशीसंभवः पुत्रः कुलानां तारयेच्छतम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003862053, "chapter_id": 23862, "verse_number": "२-५-१३-५४", "content_sanskrit": "अगम्यागमने पापमभक्ष्यस्यापि भक्षणे ।\nपापं विलयमायाति कृते जागरणे सुत ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003862054, "chapter_id": 23862, "verse_number": "२-५-१३-५५", "content_sanskrit": "अज्ञानाद्यत्कृतं पापं ज्ञात्वा यत्पातकं कृतम् ।\nपूर्वजन्मार्जितं पापमिह जन्मनि यत्कृतम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003862055, "chapter_id": 23862, "verse_number": "२-५-१३-५६", "content_sanskrit": "सिद्ध्यंति सर्वकार्याणि मनसा चिंतितान्यपि ।\nद्वादश्यां वै चतुर्वक्त्र रात्रौ जागरणे कृते ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003862056, "chapter_id": 23862, "verse_number": "२-५-१३-५७", "content_sanskrit": "द्वादशीजागरेणैव मुक्तिं गच्छंति मानवाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003862057, "chapter_id": 23862, "verse_number": "२-५-१३-५८", "content_sanskrit": "न तत्पुण्यं कुरुक्षेत्रे प्रयागे वसतां कलौ ।\nमाहात्म्यं वसतां पुंसां यत्फलं द्वादशीषु च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003862058, "chapter_id": 23862, "verse_number": "२-५-१३-५९", "content_sanskrit": "नाऽश्वमेधसहस्रैस्तु तीर्थकोट्यवगाहनात् ।\nतत्फलं प्राप्यते पुत्र द्वादशीजागरे कृते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003862059, "chapter_id": 23862, "verse_number": "२-५-१३-६०", "content_sanskrit": "पठेद्वा शृणुयाद्वाऽपि माहात्म्यं द्वादशीभवम् ।\nसर्वपापविशुद्धात्मा स लभेच्छाश्वतीं गतिम् ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003862060, "chapter_id": 23862, "verse_number": "२-५-१३-६१", "content_sanskrit": "सर्वे दुष्टाः समस्ताश्च सौम्यास्तस्य सदा ग्रहाः ।\nसंततेर्न वियोगस्तु द्वादशी यस्य कारणम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003862061, "chapter_id": 23862, "verse_number": "२-५-१३-६२", "content_sanskrit": "मम कीर्तिरुचिर्नित्यं न विपद्येत कर्हिचित् ।\nरणे राजकुले चैव सर्वदा विजयी भवेत् ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003862062, "chapter_id": 23862, "verse_number": "२-५-१३-६३", "content_sanskrit": "धर्मोपरि मतिर्नित्यं भक्तिर्मयि सुनिर्मला ।\nपातकं नैव लिप्येत द्वादशीभक्तितो नरम् ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003862063, "chapter_id": 23862, "verse_number": "२-५-१३-६४", "content_sanskrit": "प्रेतत्वं नैव तस्याऽस्ति कृते जागरणे मम ।\nएकादश्या विहीनस्य परलोकगतिर्नहि ।\nतस्मात्सर्वप्रयत्नेन कलौ कार्यं हि तद्दिनम् ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003862064, "chapter_id": 23862, "verse_number": "२-५-१३-६५", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे ब्रह्मविष्णु संवादे मार्गशीर्षमासमाहात्म्य एकादशीव्रतजागरणफलकथनंनाम त्रयोदशोऽध्यायः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]