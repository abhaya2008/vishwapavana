[{"id": 2152056, "chapter_id": 4303, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2152057, "chapter_id": 4303, "verse_number": "१", "content_sanskrit": "पुरुषं प्रकृतिं चैव क्षेत्रं क्षेत्रज्ञमेव च ।\nएतद्वेदितुमिच्छामि ज्ञानं ज्ञेयं च केशव॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2152058, "chapter_id": 4303, "verse_number": "२", "content_sanskrit": "इदं शरीरं कौन्तेय क्षेत्रमित्यभिधीयते ।\nएतद् यो वेत्ति तं प्राहुः क्षेत्रज्ञ इति तद्विदः॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2152059, "chapter_id": 4303, "verse_number": "३", "content_sanskrit": "क्षेत्रज्ञं चापि मां विद्धि सर्वक्षेत्रेषु भारत ।\nक्षेत्रक्षेत्रज्ञयोर्ज्ञानं यत् तज्ज्ञानं मतं मम॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2152060, "chapter_id": 4303, "verse_number": "४", "content_sanskrit": "तत्क्षेत्रं यच्च यादृक् च यद्विकारि यतश्च यत् ।\nस च यो यत्प्रभावश्च तत्समासेन मे शृणु॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2152061, "chapter_id": 4303, "verse_number": "५", "content_sanskrit": "ऋषिभिर्बहुधा गीतं छन्दोभिर्विविधैः पृथक् ।\nब्रह्मसूत्रपदैश्चैव हेतुमद्भिर्विनिश्चितैः॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2152062, "chapter_id": 4303, "verse_number": "६", "content_sanskrit": "महाभूतान्यहङ्कारो बुद्धिख्यक्तमेव च ।\nइन्द्रियाणि दशैकं च पञ्च चेन्द्रियगोचराः॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2152063, "chapter_id": 4303, "verse_number": "७", "content_sanskrit": "इच्छा द्वेषः सुखं दुःखं सङ्घातश्चेतना धृतिः ।\nएतत् क्षेत्रं समासेन सविकारमुदाहृतम्॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2152064, "chapter_id": 4303, "verse_number": "८", "content_sanskrit": "अमानित्वमदम्भित्वमहिंसा क्षान्तिरार्जवम् ।\nआचार्योपासनं शौचं स्थैर्यमात्मविनिग्रहः॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2152065, "chapter_id": 4303, "verse_number": "९", "content_sanskrit": "इन्द्रियार्थेषु वैराग्यमनहङ्कार एव च ।\nजन्ममृत्युजराव्याधिदुःखदोषानुदर्शनम्॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2152066, "chapter_id": 4303, "verse_number": "१०", "content_sanskrit": "असक्तिरनभिष्वङ्गः पुत्रदारगृहादिषु ।\nनित्यं च समचित्तत्वमिष्टानिष्टोपपत्तिषु॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2152067, "chapter_id": 4303, "verse_number": "११", "content_sanskrit": "मयि चानन्ययोगेन भक्तिख्यभिचारिणी ।\nविविक्तदेशसेवित्वमरतिर्जनसंसदि॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2152068, "chapter_id": 4303, "verse_number": "१२", "content_sanskrit": "अध्यात्मज्ञाननित्यत्वं तत्त्वज्ञानार्थदर्शनम् ।\nएतज्ज्ञानमिति प्रोक्तमज्ञानं यदतोऽन्यथा॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2152069, "chapter_id": 4303, "verse_number": "१३", "content_sanskrit": "ज्ञेयं यत् तत् प्रवक्ष्यामि यज्ज्ञात्वाऽमृतमश्नुते ।\nअनादिमत् परं ब्रह्म न सत् तन्नासदुच्यते॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2152070, "chapter_id": 4303, "verse_number": "१४", "content_sanskrit": "सर्वतःपाणिपादं तत् सर्वतोऽक्षिशिरोमुखम् ।\nसर्वतः श्रुतिमल्लोके सर्वमावृत्य तिष्ठति॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2152071, "chapter_id": 4303, "verse_number": "१५", "content_sanskrit": "सर्वेन्द्रियगुणाभासं सर्वेन्द्रियविवर्जितम् ।\nअसक्तं सर्वभुक् चैव निर्गुणं गुणभोक्तृ च॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2152072, "chapter_id": 4303, "verse_number": "१६", "content_sanskrit": "बहिरन्तश्च भूतानामचरं चरमेव च ।\nसूक्ष्मत्वात् तदविज्ञेयं दूरस्थं चान्तिके च तत्॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2152073, "chapter_id": 4303, "verse_number": "१७", "content_sanskrit": "अविभक्तं च भूतेषु विभक्तमिव च स्थितम् ।\nभूतभर्तृ च तज्ज्ञेयं ग्रसिष्णु प्रभविष्णु च॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2152074, "chapter_id": 4303, "verse_number": "१८", "content_sanskrit": "ज्योतिषामपि तज्ज्योतिस्तमसः परमुच्यते ।\nज्ञानं ज्ञेयं ज्ञानगम्यं हृदि सर्वस्य विष्ठितम्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2152075, "chapter_id": 4303, "verse_number": "समाप्तिः", "content_sanskrit": "इति क्षेत्रं तथा ज्ञानं ज्ञेयं चोक्तं समासतः ।\nमद्भक्त एतद्विज्ञाय मद्भावायोपपद्यते॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2152076, "chapter_id": 4303, "verse_number": "२०", "content_sanskrit": "प्रकृतिं पुरुषं चैव विद्ध्यनादी उभावपि ।\nविकारांश्च गुणांश्चैव विद्धि प्रकृतिसम्भवान्॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2152077, "chapter_id": 4303, "verse_number": "२१", "content_sanskrit": "कार्यकारणकर्तृत्वे हेतुः प्रकृतिरुच्यते ।\nपुरुषः सुखदुःखानां भोक्तृत्वे हेतुरुच्यते॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2152078, "chapter_id": 4303, "verse_number": "२२", "content_sanskrit": "पुरुषः प्रकृतिस्थो हि भुङ्क्ते प्रकृतिजान् गुणान् ।\nकारणं गुणसङ्गोऽस्य सदसद्योनिजन्मसु॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2152079, "chapter_id": 4303, "verse_number": "२३", "content_sanskrit": "उपद्रष्टाऽनुमन्ता च भर्ता भोक्ता महेश्वरः ।\nपरमात्मेति चाप्युक्तो देहेऽस्मिन् पुरुषः परः॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2152080, "chapter_id": 4303, "verse_number": "२४", "content_sanskrit": "य एवं वेत्ति पुरुषं प्रकृतिं च गुणैः सह ।\nसर्वथा वर्तमानोऽपि न स भूयोऽभिजायते॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2152081, "chapter_id": 4303, "verse_number": "२५", "content_sanskrit": "ध्यानेनात्मनि पश्यन्ति केचिदात्मानमात्मना ।\nअन्ये साङ्ख्येन योगेन कर्मयोगेन चापरे॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2152082, "chapter_id": 4303, "verse_number": "२६", "content_sanskrit": "अन्ये त्वेवमजानन्तः श्रुत्वाऽन्येभ्य उपासते ।\nतेऽपि चातितरन्त्येव मृत्युं श्रुतिपरायणाः॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2152083, "chapter_id": 4303, "verse_number": "२७", "content_sanskrit": "यावत् सञ्जायते किञ्चित् सत्वं स्थावरजङ्गमम् ।\nक्षेत्रक्षेत्रज्ञसंयोगात् तद्विद्धि भरतर्षभ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2152084, "chapter_id": 4303, "verse_number": "२८", "content_sanskrit": "समं सर्वेषु भूतेषु तिष्ठन्तं परमेश्वरम् ।\nविनश्यत्स्वविनश्यन्तं यः पश्यति स पश्यति॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2152085, "chapter_id": 4303, "verse_number": "२९", "content_sanskrit": "समं पश्यन् हि सर्वत्र समवस्थितमीश्वरम् ।\nन हिनस्त्यात्मनाऽऽत्मानं ततो याति परां गतिम्॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2152086, "chapter_id": 4303, "verse_number": "३०", "content_sanskrit": "प्रकृत्यैव च कर्माणि क्रियमाणानि सर्वशः ।\nयः पश्यति तथाऽऽत्मानमकर्तारं स पश्यति॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2152087, "chapter_id": 4303, "verse_number": "३१", "content_sanskrit": "यदा भूतपृथग्भावमेकस्थमनुपश्यति ।\nतत एव च विस्तारं ब्रह्म सम्पद्यते तदा॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2152088, "chapter_id": 4303, "verse_number": "३२", "content_sanskrit": "अनादित्वान्निर्गुणत्वात् परमात्माऽयमव्ययः ।\nशरीरस्थोऽपि कौन्तेय न करोति न लिप्यते॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2152089, "chapter_id": 4303, "verse_number": "३३", "content_sanskrit": "यथा सर्वगतं सौक्ष्म्यादाकाशं नोपलिप्यते ।\nसर्वत्रावस्थितो देहे तथाऽऽत्मा नोपलिप्यते॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2152090, "chapter_id": 4303, "verse_number": "३४", "content_sanskrit": "यथा प्रकाशयत्येकः कृत्स्नं लोकमिमं रविः ।\nक्षेत्रं क्षेत्री तथा कृत्स्नं प्रकाशयति भारत॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2152091, "chapter_id": 4303, "verse_number": "३५", "content_sanskrit": "क्षेत्रक्षेत्रज्ञयोरेवमन्तरं ज्ञानचक्षुषा ।\nभूतप्रकृतिमोक्षं च ये विदुर्यान्ति ते परम्॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2152092, "chapter_id": 4303, "verse_number": "३५", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां भीष्मपर्वणि पञ्चत्रिंशोऽध्यायः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2152093, "chapter_id": 4303, "verse_number": "२२", "content_sanskrit": "॥ इति श्रीमद्भगवद्गीतापर्वणि द्वाविंशोऽध्यायः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2152094, "chapter_id": 4303, "verse_number": "", "content_sanskrit": "–०–", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]