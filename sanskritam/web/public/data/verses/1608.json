[{"id": 2028166, "chapter_id": 1608, "verse_number": "३-२४६-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2028167, "chapter_id": 1608, "verse_number": "३-२४६-१", "content_sanskrit": "ततो दिव्यास्त्रसंपन्ना गन्धर्वा हेममालिनः।\nविसृजन्तः शरान्दीप्तान्समन्तात्पर्यवारयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2028168, "chapter_id": 1608, "verse_number": "३-२४६-२", "content_sanskrit": "चतुरः पाण्डवान्वीरान्गन्धर्वाश्च सहस्रशः।\nरणे संन्यपतन्राजंस्तदद्भुतमिवाभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2028169, "chapter_id": 1608, "verse_number": "३-२४६-३", "content_sanskrit": "यथा कर्णस्य च रथो धार्तराष्ट्रस् चोभयोः।\nगन्धर्वैः शतशश्छिन्नौ तथा तेषां प्रचक्रितरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2028170, "chapter_id": 1608, "verse_number": "३-२४६-४", "content_sanskrit": "तान्समापततो राजन्गधर्वाञ्छतशो रणे।\nप्रत्यगृह्णन्नरव्याघ्राः शरवर्षैरनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2028171, "chapter_id": 1608, "verse_number": "३-२४६-५", "content_sanskrit": "ते कीर्यमाणाः खगमाः शरवर्षैः समन्ततः।\nन शेकुः पाण्डुपुत्राणां समीपे परिवर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2028172, "chapter_id": 1608, "verse_number": "३-२४६-६", "content_sanskrit": "अभिक्रुद्धानभिक्रुद्धो गन्धर्वानर्जुनस्तदा।\nलक्षयित्वाऽथ दिव्यानि महास्त्राण्युपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2028173, "chapter_id": 1608, "verse_number": "३-२४६-७", "content_sanskrit": "सहस्राणां सहस्राणि प्राहिणोद्यमसादनम्।\nअजेयानर्जुनः सङ्ख्ये गन्धर्वाणां बलोत्कटः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2028174, "chapter_id": 1608, "verse_number": "३-२४६-८", "content_sanskrit": "तथा भीमो महेष्वासः संयुगे बलिनांवरः।\nगन्धर्वाञ्शतशो राजञ्चघान निशितैः शरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2028175, "chapter_id": 1608, "verse_number": "३-२४६-९", "content_sanskrit": "माद्रीपुत्रावपि तथा युध्मानौ बलोत्कटौ।\nपरिगृह्याग्रतो राजञ्जघ्नतुः शतशः परान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2028176, "chapter_id": 1608, "verse_number": "३-२४६-१०", "content_sanskrit": "तेवध्यमाना गन्धर्वा दिव्यैरस्त्रैर्महारथैः।\nउत्पेतुः खमुपादाय धृतराष्ट्रसुतांस्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2028177, "chapter_id": 1608, "verse_number": "३-२४६-११", "content_sanskrit": "सतानुत्पतितानदृष्ट्वा कुन्तीपुत्रो धनंजयः।\nमहता शरजालेन समन्तात्पर्यवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2028178, "chapter_id": 1608, "verse_number": "३-२४६-१२", "content_sanskrit": "ते ब्रद्धाः शरजालेन शकुन्ता इव पञ्जरे\nववर्पुरर्जुनं क्रोधाद्गदाशक्त्यृष्टिवृष्टिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2028179, "chapter_id": 1608, "verse_number": "३-२४६-१३", "content_sanskrit": "गदाशक्त्यृष्टिवृष्टीस्ता निहत्य परमास्त्रवित्।\nगात्राणि चाहनद्भल्लैर्गन्धर्वाणां धनंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2028180, "chapter_id": 1608, "verse_number": "३-२४६-१४", "content_sanskrit": "शिरोभिः प्रपतद्भिश्च चरणैर्बाहुभिस्तथा।\nअश्मवृष्टिरिवाभाति परेषामभवद्भयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2028181, "chapter_id": 1608, "verse_number": "३-२४६-१५", "content_sanskrit": "ते वध्यमाना गन्धर्वाः पाण्डवेन महात्मना।\nभूमिष्ठमन्तरिक्षस्थाः शरवर्षैरवाकिरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2028182, "chapter_id": 1608, "verse_number": "३-२४६-१६", "content_sanskrit": "तेषां तु शरवर्षाणि सव्यसाची परंतपः।\nअस्त्रैः संवार्य तेजस्वी गन्धर्वान्प्रत्यविध्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2028183, "chapter_id": 1608, "verse_number": "३-२४६-१७", "content_sanskrit": "स्थूणाकर्णेन्द्रजालं च सौरं चापि तथाऽर्जुनः।\nआग्नेयं चापि सौम्यं च ससर्ज कुरुननदनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2028184, "chapter_id": 1608, "verse_number": "३-२४६-१८", "content_sanskrit": "ते दह्यमाना गन्धर्वाः कुन्तीपुत्रस्य सायकैः।\nदैतेया इव शक्रेण विषादमगमन्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2028185, "chapter_id": 1608, "verse_number": "३-२४६-१९", "content_sanskrit": "ऊर्ध्वमाक्रममाणाश्च शरजालेन वारिताः।\nविसर्पमाणा भल्लैश्च वार्यन्ते सव्यसाचिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2028186, "chapter_id": 1608, "verse_number": "३-२४६-२०", "content_sanskrit": "गन्धर्वांस्त्रासितान्दृष्ट्वा कुन्तीपुत्रेण भारत।\nचित्रसेनो गदां गृह्य सव्यसाचिनमनाद्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2028187, "chapter_id": 1608, "verse_number": "३-२४६-२१", "content_sanskrit": "तस्याभिपततस्तूर्णं गदाहस्तस्य संयुगे।\nगदां सर्वायसीं पार्थः शरैश्चिच्छेद सप्तधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2028188, "chapter_id": 1608, "verse_number": "३-२४६-२२", "content_sanskrit": "स गदां बहुधा दृष्ट्वा कृत्तां बाणैस्तरस्विना।\nसंवृत्य विद्ययाऽऽत्मानं योधयामास पाण्डवं ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2028189, "chapter_id": 1608, "verse_number": "३-२४६-२३", "content_sanskrit": "अस्त्राणइ तस्य दिव्यानि संप्रयुक्तानि सर्वशः।\nदिव्यैरस्त्रैस्तदा वीरः पर्यवारयदर्जुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2028190, "chapter_id": 1608, "verse_number": "३-२४६-२४", "content_sanskrit": "स वार्यमाणस्तैरस्त्रैरर्जुनेन महात्मना।\nगन्धर्वराजो बलवान्माययाऽन्तर्हितस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2028191, "chapter_id": 1608, "verse_number": "३-२४६-२५", "content_sanskrit": "अन्तर्हितं तमालक्ष्य प्रहरन्तमथार्जुनः।\nताडयामास खचरैर्दिव्यास्त्रप्रतिमन्त्रितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2028192, "chapter_id": 1608, "verse_number": "३-२४६-२६", "content_sanskrit": "अन्तर्धानवधं चास्य चक्रे क्रुद्धोऽर्जुनस्तदा।\nशब्दवेषं समाश्रित्य बहुरूपो धनंजयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2028193, "chapter_id": 1608, "verse_number": "३-२४६-२७", "content_sanskrit": "रस वध्यमानस्तैरस्त्रैरर्जुनेन महात्मना।\nततोऽस्य दर्शयामास तदाऽऽत्मानं प्रियः सखा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2028194, "chapter_id": 1608, "verse_number": "३-२४६-२८", "content_sanskrit": "चित्रसेनस्तथोवाच सखायं युधि विद्धि माम्।\nचित्रसेनमथालक्ष्य सखायमिति विस्मितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2028195, "chapter_id": 1608, "verse_number": "३-२४६-२९", "content_sanskrit": "संजहारास्त्रमथं तत्प्रसृष्टं पाण्डवर्षभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2028196, "chapter_id": 1608, "verse_number": "३-२४६-३०", "content_sanskrit": "दृष्ट्वा तु पाण्डवाः सर्वे संहृतास्त्रं धनंजयम्।\nसंजह्रुः प्रद्रुतानश्वाञ्शरवेगान्धनूंषि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2028197, "chapter_id": 1608, "verse_number": "३-२४६-३१", "content_sanskrit": "चित्रसेनश्च भीमश्च सव्यसाची यमावपि।\nपृष्ट्वा कौशलमन्योन्यं रथेष्वेवावतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2028198, "chapter_id": 1608, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि घोषयात्रापर्वणि षट्चत्वारिंशदधिकद्विशततमोऽध्यायः ॥ २४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]