[{"id": 2092685, "chapter_id": 2972, "verse_number": "१३-१०२-१", "content_sanskrit": "युधिष्ठिर उवाच।\nश्रुतं दानफलं तात यत्त्वया परिकीर्तितम्।\nअन्नदानं विशेषेण प्रशस्तमिह भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2092686, "chapter_id": 2972, "verse_number": "१३-१०२-२", "content_sanskrit": "पानीयदानमेवैतत्कथं चेह महाफलम्।\nइत्येतच्छ्रोतुमिच्छामि विस्तरेण पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2092687, "chapter_id": 2972, "verse_number": "१३-१०२-३x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2092688, "chapter_id": 2972, "verse_number": "१३-१०२-३", "content_sanskrit": "हन्त ते वर्तयिष्यामि यथावद्भरतर्षभ।\nगदतस्तन्ममाद्येह शृणु सत्यपराक्रम।\nपानीयदानात्प्रभृति सर्वं वक्ष्यामि तेऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2092689, "chapter_id": 2972, "verse_number": "१३-१०२-४", "content_sanskrit": "यदन्नं यच्च पानीयं सम्प्रदायाश्नुते फलम्।\nन ताभ्यां परमं दानं किञ्चिदस्तीति मे मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2092690, "chapter_id": 2972, "verse_number": "१३-१०२-५", "content_sanskrit": "अन्नात्प्राणभृतस्तात प्रवर्तन्ते हि सर्वशः।\nतस्मादन्नं परं लोके सर्वदानेषु कथ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2092691, "chapter_id": 2972, "verse_number": "१३-१०२-६", "content_sanskrit": "अन्नाद्बलं च तेजश्च प्राणिनां वर्धते सदा।\nअन्नादानमतस्तस्माच्छ्रेष्ठमाह प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2092692, "chapter_id": 2972, "verse_number": "१३-१०२-७", "content_sanskrit": "सावित्र्या ह्यपि कौन्तेय श्रूयते वचनं शुभम्।\nयच्चेदं नान्यथा चैतद्देव सत्रे महामखे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2092693, "chapter_id": 2972, "verse_number": "१३-१०२-८", "content_sanskrit": "अन्ने दत्ते नरेणेह प्राणा दत्ता भवन्त्युत।\nप्राणदानाद्धि परमं न दानमिह विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2092694, "chapter_id": 2972, "verse_number": "१३-१०२-९", "content_sanskrit": "श्रुतं हि ते महाबाहो लोमशस्यापि तद्वचः।\nप्राणान्दत्त्वा कपोताय यत्प्राप्तं शिबिना पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2092695, "chapter_id": 2972, "verse_number": "१३-१०२-१०", "content_sanskrit": "यां गतिं लभते दत्त्वा द्विजस्यान्न विशाम्पते।\nततो विशिष्टां गच्छन्ति प्राणदा इति नः श्रुतं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2092696, "chapter_id": 2972, "verse_number": "१३-१०२-११", "content_sanskrit": "अन्नं चापि प्रभवति पानीयात्कुरुसत्तम।\nनीरजातेन हि विना न किञ्चित्सम्प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2092697, "chapter_id": 2972, "verse_number": "१३-१०२-१२", "content_sanskrit": "नीरजातश्च भगवान्सोमो ग्रहगणेश्वरः।\nअमृतं च सुधा चैव सुधा चैवामृतं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2092698, "chapter_id": 2972, "verse_number": "१३-१०२-१३", "content_sanskrit": "अन्नौषध्यो महाराज वीरुधश्च जलोद्भवाः।\nयतः प्राणभृतां प्राणाः सम्भवन्ति विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2092699, "chapter_id": 2972, "verse_number": "१३-१०२-१४", "content_sanskrit": "देवानाममृतं ह्यन्नं नागानां च सुधा तथा।\nपितॄणां च स्वधा प्रोक्ता पशूनां चापि वीरुधः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2092700, "chapter_id": 2972, "verse_number": "१३-१०२-१५", "content_sanskrit": "अन्नमेव मनुष्याणां प्राणानाहुर्मनीषिणः।\nतच्च सर्वं नरव्याघ्र पानीयात्सम्प्रवर्तते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2092701, "chapter_id": 2972, "verse_number": "१३-१०२-१६", "content_sanskrit": "तस्मात्पानीयदानाद्वै न परं विद्यते क्वचित्।\nतच्च दद्यान्नरो नित्यं यदीच्छेद्भूतिमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2092702, "chapter_id": 2972, "verse_number": "१३-१०२-१७", "content_sanskrit": "धन्यं यशस्यमायुष्यं जलदानमिहोच्यते।\nशत्रूंश्चाप्यधि कौन्तेय सदा तिष्ठति तोयदः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2092703, "chapter_id": 2972, "verse_number": "१३-१०२-१८", "content_sanskrit": "सर्वकामानवाप्नोति कीर्तिं चैव हि शाश्वतीम्।\nप्रेत्य चानन्त्यमश्नाति पापेभ्यश्च प्रमुच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2092704, "chapter_id": 2972, "verse_number": "१३-१०२-१९", "content_sanskrit": "तोयदो मनुजव्याघ्र स्वर्गं गत्वा महाद्युते।\nअक्षयान्समवाप्नोति लोकानित्यब्रवीन्मनुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2092705, "chapter_id": 2972, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि द्व्यधिकशततमोऽध्यायः॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]