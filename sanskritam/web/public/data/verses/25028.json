[{"id": 7005028000, "chapter_id": 25028, "verse_number": "७-१-२११-१", "content_sanskrit": "ईश्वर उवाच ।\nपुलस्त्येश्वरात्ततो देवि नैरृते धनुषाष्टके ।\nपुलहेश्वरनामानं तं च भक्त्या प्रपूजयेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005028001, "chapter_id": 25028, "verse_number": "७-१-२११-२", "content_sanskrit": "हिरण्यदानं दत्त्वा वै सम्यग्यात्राफलं लभेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005028002, "chapter_id": 25028, "verse_number": "७-१-२११-३", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये पुलहेश्वरमाहात्म्यवर्णनंनामैकादशोत्तरद्विशततमोऽध्यायः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}]