[{"id": 2059871, "chapter_id": 2282, "verse_number": "८-३-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2059872, "chapter_id": 2282, "verse_number": "८-३-१", "content_sanskrit": "आख्याता मामकास्तात निहता युधि पाण्डवैः।\nहतांश्च पाण्डवेयानां मामकैर्ब्रूहि सञ्जय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2059873, "chapter_id": 2282, "verse_number": "८-३-२x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2059874, "chapter_id": 2282, "verse_number": "८-३-२", "content_sanskrit": "कृतिनो युधि विक्रान्ता महासत्वा महाबलाः।\nसानुबन्धाः सहामात्या गाङ्गेयेन निपातिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2059875, "chapter_id": 2282, "verse_number": "८-३-३", "content_sanskrit": "नारायणा वल्लवाश्च रामाश्च शतशो परे।\nअनुरक्ताश्च वीरेण भीष्मेण युधि पातिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2059876, "chapter_id": 2282, "verse_number": "८-३-४", "content_sanskrit": "समः किरीटिना सङ्ख्ये वीर्येण च बलेन च।\nसत्यजित्सत्यसन्धेन द्रोणेन निहतो युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2059877, "chapter_id": 2282, "verse_number": "८-३-५", "content_sanskrit": "पाञ्चालानां महेष्वासाः सर्वे युद्वविशारदाः।\nद्रोणेन सह सङ्गम्य गता वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2059878, "chapter_id": 2282, "verse_number": "८-३-६", "content_sanskrit": "तथा विराटद्रुपदौ वृद्वौ सहसुतौ नृपौ।\nपराक्रमन्तौ मित्रार्थे द्रोणेन निहतौ रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2059879, "chapter_id": 2282, "verse_number": "८-३-७", "content_sanskrit": "यो बाल एव समरे सम्मितः सव्यसाचिना।\nकेशवेन च दुर्धर्षो बलदेवेन चाभिभूः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2059880, "chapter_id": 2282, "verse_number": "८-३-८", "content_sanskrit": "परेषां कदनं कृत्वा महद्रणविशारदः।\nपरिवार्य मदामात्रैः षड्भिः परमकै रथैः।\nअशक्नुवद्भिर्बीभत्सुमभिमन्युर्निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2059881, "chapter_id": 2282, "verse_number": "८-३-९", "content_sanskrit": "कृतं तं विरथं वीरं क्षत्रधर्मे व्यवस्थितम्।\nदौःशासनिर्महाराज सौभद्रं हतवान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2059882, "chapter_id": 2282, "verse_number": "८-३-१०", "content_sanskrit": "पटच्चरनिहन्ता च महत्या सेनया वृतः।\nअम्बष्ठस्य सुतः श्रीमान्मित्रहेतोः पराक्रमन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2059883, "chapter_id": 2282, "verse_number": "८-३-११", "content_sanskrit": "आसाद्य लक्ष्मणं वीरं दुर्योधनसुतं रणे।\nसुमहत्कदनं कृत्वा गतो वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2059884, "chapter_id": 2282, "verse_number": "८-३-१२", "content_sanskrit": "बृहन्तः सुमहेष्वासः कृतास्त्रो युद्वदुर्मदः।\nदुःशासनेन विक्रम्य गमितो यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2059885, "chapter_id": 2282, "verse_number": "८-३-१३", "content_sanskrit": "मणिमान्दण्डधारश्च राजानौ युद्धदुर्मदौ।\nपराक्रमन्तौ मित्रार्थे द्रोणेन युधि पातितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2059886, "chapter_id": 2282, "verse_number": "८-३-१४", "content_sanskrit": "अंशुमान्भोजराजस्तु सहसैन्यो महारथः।\nभारद्वाजेन विक्रम्य गमितो यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2059887, "chapter_id": 2282, "verse_number": "८-३-१५", "content_sanskrit": "सामुद्रश्चित्रसेनश्च सह पुत्रेण भारत।\nसमुद्रसेनेन बलाद्गमितो यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2059888, "chapter_id": 2282, "verse_number": "८-३-१६", "content_sanskrit": "अनूपवासी नीलश्च व्याध्रदत्तश्च वीर्यवान्।\nअश्वत्थाम्ना विकर्णेन गमितौ यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2059889, "chapter_id": 2282, "verse_number": "८-३-१७", "content_sanskrit": "चित्रायुधश्चित्रयोधी कृत्वा च कदनं महत्।\nचित्रमार्गेण विक्रम्य विकर्णेन हतो मृधे।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2059890, "chapter_id": 2282, "verse_number": "८-३-१८", "content_sanskrit": "वृकोदरसमो युद्धे वृतः केकयजो युधि।\nकेकयेन च विक्रम्य भ्राता भ्रात्रा निपातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2059891, "chapter_id": 2282, "verse_number": "८-३-१९", "content_sanskrit": "जनमेजयो गदायोधी पार्वतीयः प्रतापवान्।\nदुर्मुखेन महाराज तव पुत्रेण पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2059892, "chapter_id": 2282, "verse_number": "८-३-२०", "content_sanskrit": "रोचमानौ नरव्याघ्रौ रोचमानौ ग्रहाविव।\nद्रौणेन युगपद्राजन्दिवं सम्प्रातितौ शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2059893, "chapter_id": 2282, "verse_number": "८-३-२१", "content_sanskrit": "नृपाश्च प्रतियुध्यन्तः पराक्रान्ता विशाम्पते।\nकृत्वा नसुकरं कर्म गता वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2059894, "chapter_id": 2282, "verse_number": "८-३-२२", "content_sanskrit": "पुरुजित्कृन्तिभोजश्च मातुलौ सव्यसाचिनः।\nसंग्रामनिर्जिताँल्लोकान्गमितौ द्रोणसायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2059895, "chapter_id": 2282, "verse_number": "८-३-२३", "content_sanskrit": "अभिभूः काशिराजश्च काशिकैर्बहुभिर्वृतः।\nवसुदानस्य पुत्रेण त्याजितो देहमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2059896, "chapter_id": 2282, "verse_number": "८-३-२४", "content_sanskrit": "अमितौजा युधामन्युरुत्तमौजाश्च वीर्यवान्।\nनिहत्य शतशः सूरानस्मदीयैर्निपातिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2059897, "chapter_id": 2282, "verse_number": "८-३-२५", "content_sanskrit": "मित्रवर्मा च पाञ्चाल्यः क्षत्रधर्मा च भारत।\nद्रोणेन परमेष्वासौ गमितौ यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2059898, "chapter_id": 2282, "verse_number": "८-३-२६", "content_sanskrit": "शिखण्डितनयो युद्धे क्षत्रदेवो युधाम्पतिः।\nलक्ष्मणेन हतो राजंस्तव पौत्रेण भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2059899, "chapter_id": 2282, "verse_number": "८-३-२७", "content_sanskrit": "सुचित्रश्चित्रवर्मा च पितापुत्रौ महारथौ।\nप्रचरन्तौ महावीरौ द्रोणेन निहतौ रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2059900, "chapter_id": 2282, "verse_number": "८-३-२८", "content_sanskrit": "वार्धक्षेमिर्महाराज समुद्र इव पर्वणि।\nआयुधक्षयमासाद्य प्रशान्तिं परमां गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2059901, "chapter_id": 2282, "verse_number": "८-३-२९", "content_sanskrit": "सेनाबिन्दुसुतः श्रेष्ठः शास्त्रवान्प्रहरन्युधि।\nबाह्लिकेन महाराज कौरवेन्द्रेण पातितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2059902, "chapter_id": 2282, "verse_number": "८-३-३०", "content_sanskrit": "धृष्टकेतुर्महाराज चेदीनां प्रवरो रथः।\nकृत्वा नसुकरं कर्म गतो वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2059903, "chapter_id": 2282, "verse_number": "८-३-३१", "content_sanskrit": "तथा सत्यधृतिर्वीरः कृत्वा कदनमाहवे।\nपाण्डवार्थे पराक्रान्तो गमितो यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2059904, "chapter_id": 2282, "verse_number": "८-३-३२", "content_sanskrit": "पुत्रस्तु शिशुपालस्य सुकेतुः पृथिवीपतिः।\nनिहत्य शात्रवान्सङ्ख्ये द्रोणेन निहतो युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2059905, "chapter_id": 2282, "verse_number": "८-३-३३", "content_sanskrit": "तथा सत्यधृतिर्वीरो मदिराश्वश्च वीर्यवान्।\nसूर्यदत्तश्च विक्रान्तो निहतो द्रोणसायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2059906, "chapter_id": 2282, "verse_number": "८-३-३४", "content_sanskrit": "`मात्स्यादवरजः श्रीमाञ्शतानीको निपातितः।\nश्रेणिमांश्च महाराज युध्यमानः पराक्रमी।\nकृत्वा नसुकरं कर्म गतो वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2059907, "chapter_id": 2282, "verse_number": "८-३-३५", "content_sanskrit": "तथैव युधि विक्रान्तो मागधः परमास्त्रवित्।\nभीष्मेण निहतो राजञ्शेतेऽद्य परवीरहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2059908, "chapter_id": 2282, "verse_number": "८-३-३६", "content_sanskrit": "विराटपुत्रः शङ्खस्तु उत्तरश्च महारथः।\nकुर्वन्तौ सुमहत्कर्म गतौ वैवस्वतक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2059909, "chapter_id": 2282, "verse_number": "८-३-३७", "content_sanskrit": "वसुदानश्च कदनं कुर्वाणोऽतीव संयुगे।\nभारद्वाजेन विक्रम्य गमितो यमसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2059910, "chapter_id": 2282, "verse_number": "८-३-३८", "content_sanskrit": "एते चान्ये च बहवः पाण्डवानां महारथाः।\nहता द्रोणेन विक्रम्य यन्मां त्वं परिपृच्छसि॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2059911, "chapter_id": 2282, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि तृतीयोऽध्यायः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]