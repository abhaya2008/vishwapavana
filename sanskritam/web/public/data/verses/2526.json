[{"id": 2072366, "chapter_id": 2526, "verse_number": "१२-३१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2072367, "chapter_id": 2526, "verse_number": "१२-३१-१", "content_sanskrit": "तूष्णींभूतं तु राजानं शोचमानं युधिष्ठिरम्।\nतपस्वी धर्मतत्त्वज्ञः कृष्णद्वैपायनोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2072368, "chapter_id": 2526, "verse_number": "१२-३१-२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2072369, "chapter_id": 2526, "verse_number": "१२-३१-२", "content_sanskrit": "प्रजानां पालनं धर्मो राज्ञां राजीवलोचन।\nधर्मः प्रमाणं लोकस्य नित्यं धर्मोऽनुवर्त्यताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2072370, "chapter_id": 2526, "verse_number": "१२-३१-३", "content_sanskrit": "अनुतिष्ठस्व तद्राजन्पितृपैतामहं पदम्।\nब्राह्मणेषु तु यो धर्मः स नित्यो वेदनिश्चितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2072371, "chapter_id": 2526, "verse_number": "१२-३१-४", "content_sanskrit": "तत्प्रमाणं प्रमाणानां शाश्वतं भरतर्षभ।\nतस्य धर्मस्य कृत्स्नस्य क्षत्रियः परिरक्षिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2072372, "chapter_id": 2526, "verse_number": "१२-३१-५", "content_sanskrit": "तथा यः प्रतिहन्त्यस्य शासनं विषये नरः।\nस बाहुभ्यां विनिग्राह्यो लोकयात्राविघातकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2072373, "chapter_id": 2526, "verse_number": "१२-३१-६", "content_sanskrit": "प्रमाणमप्रमाणं यः कुर्यान्मोहवशं गतः।\nभृत्यो वा यदि वा पुत्रस्तपस्वी वाऽथ कश्चन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2072374, "chapter_id": 2526, "verse_number": "१२-३१-७", "content_sanskrit": "पापान्सर्वैरुपायैस्तान्नियच्छेच्छातयीत वा।\nअतोऽन्यथा वर्तमानो राजा प्राप्नोति किल्विषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2072375, "chapter_id": 2526, "verse_number": "१२-३१-८", "content_sanskrit": "धर्मं विनश्यमानं हि यो न रक्षेत्स धर्महा।\nते त्वया धर्महन्तारो निहताः सपदानुगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2072376, "chapter_id": 2526, "verse_number": "१२-३१-९", "content_sanskrit": "स्वधर्मे वर्तमानस्त्वं किंनु शोचसि पाण्डव।\nराजा हि हन्याद्दद्याच्च प्रजा रक्षेच्च धर्मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2072377, "chapter_id": 2526, "verse_number": "१२-३१-१०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2072378, "chapter_id": 2526, "verse_number": "१२-३१-१०", "content_sanskrit": "न तेऽतिशङ्के वचनं यद्ब्रवीषि तपोधन।\nअपरोक्षो हि ते धर्मः सर्वधर्मविदां वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2072379, "chapter_id": 2526, "verse_number": "१२-३१-११", "content_sanskrit": "मया त्ववध्या बहवो घातिता राज्यकारणात्।\nतानि कर्माणि मे ब्रह्मन्दहन्ति च पचन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2072380, "chapter_id": 2526, "verse_number": "१२-३१-१२x", "content_sanskrit": "व्यास उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2072381, "chapter_id": 2526, "verse_number": "१२-३१-१२", "content_sanskrit": "ईश्वरो वा भवेत्कर्ता पुरुषो वाऽपि भारत।\nहठो वा वर्तते लोके कर्मजं वा फलं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2072382, "chapter_id": 2526, "verse_number": "१२-३१-१३", "content_sanskrit": "ईश्वरेण नियुक्तो हि साध्वसाधु च भारत।\nकुरुते पुरुषः कर्म फलमीश्वरगामि तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2072383, "chapter_id": 2526, "verse_number": "१२-३१-१४", "content_sanskrit": "यथाहि पुरुषश्छिन्द्याद्वृक्षं परशुना वने।\nछेत्तुरेव भवेत्पापं परशोर्न कथंचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2072384, "chapter_id": 2526, "verse_number": "१२-३१-१५", "content_sanskrit": "अथवा तदुपादानात्प्राप्नुयात्कर्मणः फलम्।\nदण्डशस्त्रकृतं पापं पुरुषे तन्न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2072385, "chapter_id": 2526, "verse_number": "१२-३१-१६", "content_sanskrit": "न चैतदिष्टं कौन्तेय यदन्येन कृतं फलम्।\nप्राप्नुयादिति तस्माच्च ईश्वरे तन्निवेशय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2072386, "chapter_id": 2526, "verse_number": "१२-३१-१७", "content_sanskrit": "अथापि पुरुषः कर्ता कर्मणोः शुभपापयोः।\nन परो विद्यते तस्मादेवमप्यशुभं कुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2072387, "chapter_id": 2526, "verse_number": "१२-३१-१८", "content_sanskrit": "न हि कश्चित्क्वचिद्राजन्दिष्टं प्रतिनिवर्तते।\nदण्डशस्त्रकृतं पापं पुरुषे तन्न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2072388, "chapter_id": 2526, "verse_number": "१२-३१-१९", "content_sanskrit": "यदि वा मन्यसे राजन्हतमेकं प्रतिष्ठितम्।\nएवमप्यशुभं कर्म न भूतं न भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2072389, "chapter_id": 2526, "verse_number": "१२-३१-२०", "content_sanskrit": "अथाभिपत्तिर्लोकस्य कर्तव्या पुण्यपापयोः।\nअभिपन्नमिदं लोके राज्ञामुद्यतदण्डनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2072390, "chapter_id": 2526, "verse_number": "१२-३१-२१", "content_sanskrit": "तथापि लोके कर्माणि समावर्तन्ति भारत।\nशुभाशुभफलं चैते प्राप्नुवन्तीति मे मतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2072391, "chapter_id": 2526, "verse_number": "१२-३१-२२", "content_sanskrit": "एवं पश्य शुभादेशं कर्मणस्तत्फलं ध्रुवम्।\nत्यज त्वं राजशार्दूल मैवं शोके मनः कृथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2072392, "chapter_id": 2526, "verse_number": "१२-३१-२३", "content_sanskrit": "स्वधर्मे वर्तमानस्य सापवादेऽपि भारत।\nएवमात्मपरित्यागस्तव राजन्न शोभनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2072393, "chapter_id": 2526, "verse_number": "१२-३१-२४", "content_sanskrit": "विहितानि हि कौन्तेय प्रायश्चित्तानि कर्मणाम्।\nशरीरवांस्तानि कुर्यादशरीरः पराभवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2072394, "chapter_id": 2526, "verse_number": "१२-३१-२५", "content_sanskrit": "तद्राजञ्जीवमानस्त्वं प्रायश्चित्तं करिष्यसि।\nप्रायश्चित्तमकृत्वा तु प्रेत्य तप्ताऽसि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2072395, "chapter_id": 2526, "verse_number": "१२-३१-२६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2072396, "chapter_id": 2526, "verse_number": "१२-३१-२६", "content_sanskrit": "हताः पुत्राश्च पौत्राश्च भ्रातरः पितरस्तथा।\nश्वशुरा गुरवश्चैव मातुलाश्च पितामहाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2072397, "chapter_id": 2526, "verse_number": "१२-३१-२७", "content_sanskrit": "क्षत्रियाश्च महात्मानः संबन्धिसुहृदस्तथा।\nवयस्या भागिनेयाश्च ज्ञातयश्च पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2072398, "chapter_id": 2526, "verse_number": "१२-३१-२८", "content_sanskrit": "बहवश्च मनुष्येन्द्रा नानादेशसमागताः।\nघातिता राज्यलुब्धेन मयैकेन पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2072399, "chapter_id": 2526, "verse_number": "१२-३१-२९", "content_sanskrit": "तांस्तादृशानहं हत्वा धर्मनित्यान्महीक्षितः।\nअसकृत्सोमपान्वीरान्क्रिं प्राप्स्यामि तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2072400, "chapter_id": 2526, "verse_number": "१२-३१-३०", "content_sanskrit": "दह्याम्यनिशमद्यापि चिन्तयानः पुन पुनः।\nहीनां पार्थिवसिंहैस्तैः श्रीमद्भिः पृथिवीमिमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2072401, "chapter_id": 2526, "verse_number": "१२-३१-३१", "content_sanskrit": "दृष्ट्वा ज्ञातिवधं घोरं हतांश्च शतशः परान्।\nकोटिशश्च नरानन्यान्परितप्ये पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2072402, "chapter_id": 2526, "verse_number": "१२-३१-३२", "content_sanskrit": "का नु तासां वरस्त्रीणामवस्थाऽद्य भविष्यति।\nविहीनानां तु तनयैः पतिभिर्भ्रातृभिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2072403, "chapter_id": 2526, "verse_number": "१२-३१-३३", "content_sanskrit": "अस्मानन्तकरान्घोरान्पाण्डवान्वृष्णिसंहतान्।\nआक्रोशन्त्यः कृशा दीनाः प्रपतिष्यन्ति भूतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2072404, "chapter_id": 2526, "verse_number": "१२-३१-३४", "content_sanskrit": "अपश्यन्त्यः पितॄन्भ्रातॄन्पतीन्पुत्रांश्च योषितः।\nत्यक्त्वा प्राणान्स्त्रियः सर्वागमिष्यन्ति यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2072405, "chapter_id": 2526, "verse_number": "१२-३१-३५", "content_sanskrit": "वत्सलत्वाद्द्विजश्रेष्ठ तत्र ये नास्ति संसयः।\nव्यक्तं सौक्ष्म्याच्च धर्मस्य प्राप्स्यामः स्त्रीवधं वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2072406, "chapter_id": 2526, "verse_number": "१२-३१-३६", "content_sanskrit": "ते वयं सुहृदो हत्वा कृत्वा पापमनन्तकम्।\nनकरे निपतिष्यामो ह्यधः शिरस एव ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2072407, "chapter_id": 2526, "verse_number": "१२-३१-३७", "content_sanskrit": "शरीराणि विमोक्ष्यामस्तपसोग्रेण सत्तम।\nआश्रमाणां विशेषं त्वमथाचक्ष्व पितामह॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2072408, "chapter_id": 2526, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि एकत्रिंशोऽध्यायः॥ ३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]