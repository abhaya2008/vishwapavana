[{"id": 2119728, "chapter_id": 3572, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2119729, "chapter_id": 3572, "verse_number": "१", "content_sanskrit": "चतुर्भिर्भीमसेनाद्यैर्भ्रातृभिः सहितैर्हितम् ।\nएवमुक्तस्तदा पार्थो धर्म एव मनो दधे\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2119730, "chapter_id": 3572, "verse_number": "२", "content_sanskrit": "स राजसूयं राजेन्द्रः कुरूणामृषभः क्रतुम् ।\nजगाम मनसा सम्यगाहरिष्यन् युधिष्ठिरः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2119731, "chapter_id": 3572, "verse_number": "३", "content_sanskrit": "भूयस्त्वद्भुतवीर्यौजा धर्ममेवानुपालयन् ।\nकिं हितं सर्वलोकस्य धर्मराजो मनो दधे\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2119732, "chapter_id": 3572, "verse_number": "४", "content_sanskrit": "स सर्वशः महाप्राज्ञैः ऋत्विग्भिश्च महात्मभिः ।\nधौम्यद्वैपायनमुखैर्मन्त्रयामास मन्त्रिभिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2119733, "chapter_id": 3572, "verse_number": "५", "content_sanskrit": "विराटद्रुपदाभ्यां च सात्यकेन च धीमता ।\nयुधामन्यूत्तमौजाभ्यां सौभद्रेण च धीमता ।\nद्रौपदेयैः परं शूरैर्मन्त्रयामास संवृतः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2119734, "chapter_id": 3572, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2119735, "chapter_id": 3572, "verse_number": "६", "content_sanskrit": "भवन्तो राजसूयस्य सम्राडर्हस्य सुक्रतोः ।\nश्रद्दधानस्य तत्त्वेन ममावाप्तिः कथं भवेत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2119736, "chapter_id": 3572, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2119737, "chapter_id": 3572, "verse_number": "", "content_sanskrit": "एवमुक्तास्तु ते तेन राज्ञा राजीवलोचनाः ।\nऋषयो भ्रातरश्चैव तद्वाक्यं प्रत्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2119738, "chapter_id": 3572, "verse_number": "७", "content_sanskrit": "इदमूचुर्वचः काले धर्मात्मानं युधिष्ठिरम् ।\nअर्हस्त्वमसि राजेन्द्र राजसूयं महाक्रतुम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2119739, "chapter_id": 3572, "verse_number": "८", "content_sanskrit": "सामर्थ्ययोगौ सम्प्रेक्ष्य देशकालौ व्ययागमौ ।\nविमृश्य सम्यक् च धिया कुर्वन् राजा न सीदति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2119740, "chapter_id": 3572, "verse_number": "९", "content_sanskrit": "एवमुक्तस्तु धर्मात्मा पुनरात्मानमात्मनि ।\nअवेक्ष्य च विमृश्यैव संशयेषु पुनःपुनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2119741, "chapter_id": 3572, "verse_number": "१०", "content_sanskrit": "सर्वैस्तैर्निश्चितमतिः काल इत्येव भारत ।\nभूयो विममृशे पार्थो लोकात्महितकारणात्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2119742, "chapter_id": 3572, "verse_number": "११", "content_sanskrit": "न हि यज्ञसमारम्भः केवलात्मविवृद्धये ।\nभवतीति समाज्ञाय यत्नतः कार्यमुद्वहन्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2119743, "chapter_id": 3572, "verse_number": "१२", "content_sanskrit": "स निश्चयार्थं कार्यस्य कृष्णमेव जनार्दनम् ।\nसर्वलोकात् परं मत्वा जगाम मनसा हरिम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2119744, "chapter_id": 3572, "verse_number": "१३", "content_sanskrit": "अप्रमेयमनाद्यन्तं कामाज्जातमजं नृषु ।\nपाण्डवस्तर्कयामास कर्मभिर्देवनिर्मितैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2119745, "chapter_id": 3572, "verse_number": "१४", "content_sanskrit": "नास्य किञ्चिदविज्ञेयं नास्य किञ्चिदकर्मजम् ।\nनास्य किञ्चिद् भवेन्मोघं इति कृष्णममन्यत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2119746, "chapter_id": 3572, "verse_number": "१५", "content_sanskrit": "स तु तां नैष्ठिकीं बुद्धिं कृत्वा पार्थो युधिष्ठिरः ।\nगुरुवद् भूतगुरवे प्राहिणोद् दूतमञ्जसा\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2119747, "chapter_id": 3572, "verse_number": "१६", "content_sanskrit": "शीघ्रगेन रथेनाशु दूतः सम्प्राप्य यादवान् ।\nद्वारकावासिनं कृष्णं द्वारवत्यां समासदत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2119748, "chapter_id": 3572, "verse_number": "१७", "content_sanskrit": "स प्रह्वः प्राञ्जलिर्भूत्वा व्यज्ञापयत माधवम् ।\nधर्मराजो हृषीकेश धौम्यव्यासादिभिः सह\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2119749, "chapter_id": 3572, "verse_number": "१८", "content_sanskrit": "पाञ्चालमात्स्यसहितैर्भ्रातृभिः स्वैश्च सर्वशः ।\nत्वद्दर्शनं महाबाहो काङ्क्षते स युधिष्ठिरः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2119750, "chapter_id": 3572, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2119751, "chapter_id": 3572, "verse_number": "१९", "content_sanskrit": "इन्द्रसेनवचः श्रुत्वा यादवप्रवरो बली ।\nदर्शनाकाङ्क्षिणं पार्थं दर्शनाकाङ्क्षणोऽच्युतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2119752, "chapter_id": 3572, "verse_number": "२०", "content_sanskrit": "आमन्त्र्य वसुदेवं च बलदेवं च माधवः ।\nइन्द्रसेनेन सहित इन्द्रप्रस्थं ययौ तदा\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2119753, "chapter_id": 3572, "verse_number": "२१", "content_sanskrit": "व्यतीत्य देशान् विविधान् त्वरावान् क्षिप्रवाहनः ।\nइन्द्रप्रस्थगतं पार्थमभ्यगच्छज्जनार्दनः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2119754, "chapter_id": 3572, "verse_number": "२२", "content_sanskrit": "स्वगृहे पितृवद् भ्रात्रा धर्मराजेन पूजितः ।\nभीमेन च ततोऽपश्यत् स्वसारं प्रीतिमान् प्रभुः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2119755, "chapter_id": 3572, "verse_number": "२३", "content_sanskrit": "प्रीतः प्रियेण वै सख्या रेमे स सहितस्तदा ।\nअर्जुनेन यमाभ्यां च शिष्यवत् समुपस्थितः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2119756, "chapter_id": 3572, "verse_number": "२४", "content_sanskrit": "तं विश्रान्तं समे देशे क्षणिनं कल्यमच्युतम् ।\nधर्मराजः समागम्य ज्ञापयत् स्वं प्रयोजनम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2119757, "chapter_id": 3572, "verse_number": "२५", "content_sanskrit": "प्रार्थितो राजसूयो मे नचासौ केवलेप्सया ।\nप्राप्यते येन केनेह विदितं तव चाच्युत\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2119758, "chapter_id": 3572, "verse_number": "२६", "content_sanskrit": "यस्मिन् सर्वं सम्भवति यदा सर्वेश उच्यते ।\nराजसूयाभिषेकोऽयं तदा साम्राज्यमिष्यते\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2119759, "chapter_id": 3572, "verse_number": "२७", "content_sanskrit": "तं राजसूयं सुहृदः प्राप्यमाहुः समेत्य माम् ।\nतत्र मे निश्चिता बुद्धिस्तव कृष्ण गिरा भवेत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2119760, "chapter_id": 3572, "verse_number": "२८", "content_sanskrit": "केचिद्धि सौहृदादेव दोषं न परिचक्षते ।\nअर्थहेतोस्तथा चान्ये प्रियमेव वदन्त्युत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2119761, "chapter_id": 3572, "verse_number": "२९", "content_sanskrit": "प्रियमेव प्रतीक्षन्ते केचिन्नात्मनि यद्धितम् ।\nएवं प्रायः प्रदृश्यन्ते जनवादाः प्रयोजने\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2119762, "chapter_id": 3572, "verse_number": "३०", "content_sanskrit": "त्वं तु सर्वानतीत्यैतान् कामं क्रोधमतीत्य च ।\nपरमं नः क्षमं काले यथावद् वक्तुमर्हसि\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2119763, "chapter_id": 3572, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nसभापर्वणि चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2119764, "chapter_id": 3572, "verse_number": "१४", "content_sanskrit": "॥ मन्त्रपर्वणि चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2119765, "chapter_id": 3572, "verse_number": "", "content_sanskrit": "—— ०  ——", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]