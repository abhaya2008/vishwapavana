[{"id": 2213696, "chapter_id": 5566, "verse_number": "", "content_sanskrit": "जनमेजयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2213697, "chapter_id": 5566, "verse_number": "१", "content_sanskrit": "दृष्ट्वा पुत्रांस्तथा पौत्रान् सानुबन्धान् जनाधिपः ।\nधृतराष्ट्रः किमकरोद् राजा चैव युधिष्ठिरः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2213698, "chapter_id": 5566, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2213699, "chapter_id": 5566, "verse_number": "२", "content_sanskrit": "तद् दृष्ट्वा महदाश्चर्यं पुत्राणां दर्शनं पुनः ।\nवीतशोकः स राजर्षिः पुनराश्रममागमत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2213700, "chapter_id": 5566, "verse_number": "३", "content_sanskrit": "इतरस्तु जनः सर्वस्ते चैव परमर्षयः ।\nप्रतिजग्मुर्यथाकामं धृतराष्ट्राभ्यनुज्ञया\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2213701, "chapter_id": 5566, "verse_number": "४", "content_sanskrit": "पाण्डवास्तु महात्मानो लघुभूयिष्ठसैनिकाः ।\nअनुजग्मुर्महात्मानं सदारास्तं महीपतिम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2213702, "chapter_id": 5566, "verse_number": "५", "content_sanskrit": "तमाश्रमगतं धीमान् ब्रह्मर्षिर्लोकपूजितः ।\nद्वैपायनोऽभ्युपागम्य राजानमिदमब्रवीत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2213703, "chapter_id": 5566, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2213704, "chapter_id": 5566, "verse_number": "६", "content_sanskrit": "धृतराष्ट्र महाबाहो शृणु कौरवनन्दन ।\nश्रुतास्ते ज्ञानवृद्धानामृषीणां पुण्यकर्मणाम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2213705, "chapter_id": 5566, "verse_number": "७", "content_sanskrit": "अद्धाभिजनवृद्धानां वेदवेदाङ्गवेदिनाम् ।\nधर्मज्ञानां पुराणानां वदतां विविधाः कथाः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2213706, "chapter_id": 5566, "verse_number": "८", "content_sanskrit": "मा स्म शोके मनः कार्षीर्दिष्टे न व्यथते बुधः ।\nश्रुतं देवरहस्यं ते नारदाद् देवदर्शनात्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2213707, "chapter_id": 5566, "verse_number": "९", "content_sanskrit": "गतास्ते क्षत्रधर्मेण शस्त्रपूतां गतिं शुभाम् ।\nयथा दृष्टास्त्वया पुत्रास्तथा कामविहारिणः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2213708, "chapter_id": 5566, "verse_number": "१०", "content_sanskrit": "युधिष्ठिरः स्वयं धीमान् भवन्तमनुरुद्ध्यते ।\nसहितो भ्रातृभिः सर्वैः सदारः ससुहृज्जनः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2213709, "chapter_id": 5566, "verse_number": "११", "content_sanskrit": "विसर्जयैनं यात्वेष स्वराज्यमनुशासताम् ।\nमासः समधिकस्तेषामतीतो वसतां वने\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2213710, "chapter_id": 5566, "verse_number": "१२", "content_sanskrit": "एतद्धि नित्यं यत्नेन पदं रक्ष्यं नराधिप ।\nबहुप्रत्यर्थिकं ह्येतद् राज्यं नाम कुरूद्वह\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2213711, "chapter_id": 5566, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2213712, "chapter_id": 5566, "verse_number": "१३", "content_sanskrit": "इत्युक्तः कौरवो राजा व्यासेनामितबुद्धिना ।\nयुधिष्ठिरमथाहूय वाग्मी वचनमब्रवीत्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2213713, "chapter_id": 5566, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2213714, "chapter_id": 5566, "verse_number": "१४", "content_sanskrit": "अजातशत्रो भद्रं ते शृणु मे भ्रातृभिः सह ।\nत्वत्प्रसादान्महीपाल शोको नास्मान् प्रबाधते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2213715, "chapter_id": 5566, "verse_number": "१५", "content_sanskrit": "रमे चाहं त्वया पुत्र पुरेव गजसाह्वये ।\nनाथेनानुगतो विद्वन् प्रियेषु परिवर्तिना\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2213716, "chapter_id": 5566, "verse_number": "१६", "content_sanskrit": "प्राप्तं पुत्रफलं त्वत्तः प्रीतिर्मे परमा त्वयि ।\nन मे मन्युर्महाबाहो गम्यतां मा चिरं कृथाः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2213717, "chapter_id": 5566, "verse_number": "१७", "content_sanskrit": "भवन्तं चेह सम्प्रेक्ष्य तपो मे परिहीयते ।\nउपयुक्तं शरीरं च त्वां दृष्ट्वा धारितं पुनः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2213718, "chapter_id": 5566, "verse_number": "१८", "content_sanskrit": "मातरौ ते तथैवेमे शीर्णपर्णकृताशने ।\nमम तुल्यव्रते पुत्र न चिरं वर्तयिष्यतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2213719, "chapter_id": 5566, "verse_number": "१९", "content_sanskrit": "दुर्योधनप्रभृतयो दृष्टा लोकान्तरं गताः ।\nव्यासस्य तपसो वीर्याद् भवतश्च समागमात्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2213720, "chapter_id": 5566, "verse_number": "२०", "content_sanskrit": "प्रयोजनं चिरं वृत्तं जीवितस्य ममानघ ।\nउग्रं तपः समास्थास्ये त्वमनुज्ञातुमर्हसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2213721, "chapter_id": 5566, "verse_number": "२१", "content_sanskrit": "त्वय्यद्य पिण्डः कीर्तिश्च कुलं चेदं प्रतिष्ठितम् ।\nश्वो वाऽद्य वा महाबाहो गम्यतां मा चिरं कृथाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2213722, "chapter_id": 5566, "verse_number": "२२", "content_sanskrit": "राजनीतिः सुबहुशः श्रुता ते भरतर्षभ ।\nसन्देष्टव्यं न पश्यामि कृतमेतावता विभो\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2213723, "chapter_id": 5566, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2213724, "chapter_id": 5566, "verse_number": "२३", "content_sanskrit": "इत्युक्तवचनं तं तु नृपो राजानमब्रवीत् ।\nन मामर्हसि धर्मज्ञ परित्यक्तुमनागसम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2213725, "chapter_id": 5566, "verse_number": "२४", "content_sanskrit": "कामं गच्छन्तु मे सर्वे भ्रातरोऽनुचरास्तथा ।\nभवन्तमहमन्विष्ये मातरौ च यतव्रतः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2213726, "chapter_id": 5566, "verse_number": "२५", "content_sanskrit": "तमुवाचाथ गान्धारी मैवं पुत्र श्रुणुष्व च ।\nत्वय्यधीनं कुरुकुलं पिण्डश्च श्वशुरस्य मे\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2213727, "chapter_id": 5566, "verse_number": "२६", "content_sanskrit": "गम्यतां पुत्र पर्याप्तमेतावत्पूजिता वयम् ।\nराजा यदाह तत्कार्यं त्वया पुत्र पितुर्वचः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2213728, "chapter_id": 5566, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2213729, "chapter_id": 5566, "verse_number": "२७", "content_sanskrit": "इत्युक्तः स तु गान्धार्या कुन्तीमिदमभाषत ।\nस्नेहबाष्पाकुले नेत्रे परिमृज्य विनीतवत्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2213730, "chapter_id": 5566, "verse_number": "२८", "content_sanskrit": "विसर्जयति मां राजा गान्धारी च यशस्विनी ।\nभवतां बद्धचित्तस्तु कथं यास्यामि दुःखितः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2213731, "chapter_id": 5566, "verse_number": "२९", "content_sanskrit": "न चोत्सहे तपोविघ्नं कर्तुं ते धर्मचारिणि ।\nतपसो हि परं नास्ति तपसा विन्दते महत्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2213732, "chapter_id": 5566, "verse_number": "३०", "content_sanskrit": "ममापि न तथा राज्ञि राज्ये बुद्धिर्यथा पुरा ।\nतपस्येवानुरक्तं मे मनः सर्वात्मना तथा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2213733, "chapter_id": 5566, "verse_number": "३१", "content_sanskrit": "शून्येयं च मही कृत्स्ना न मे प्रीतिकरी शुभे ।\nबान्धवाः नः परिक्षीणा बलं नो न यथा पुरा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2213734, "chapter_id": 5566, "verse_number": "३२", "content_sanskrit": "पाञ्चालाः सुभृशं क्षीणाः कन्यामात्रावशेषिताः ।\nन तेषां कुलकर्तारं कञ्चित् पश्याम्यहं शुभे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2213735, "chapter_id": 5566, "verse_number": "३३", "content_sanskrit": "सर्वे हि भस्मसान्नीतास्ते द्रोणेन रणाजिरे ।\nअवशिष्टाश्च निहता द्रोणपुत्रेण वै निशि\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2213736, "chapter_id": 5566, "verse_number": "३४", "content_sanskrit": "चेदयश्चैव मत्स्याश्च दृष्टपूर्वास्तथैव नः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2213737, "chapter_id": 5566, "verse_number": "३५", "content_sanskrit": "केवलं वृष्णिचक्रं च वासुदेवपरिग्रहात् ।\nयद् दृष्ट्वा स्थातुमिच्छामि धर्मार्थं नार्थहेतुतः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2213738, "chapter_id": 5566, "verse_number": "३६", "content_sanskrit": "शिवेन पश्य नः सर्वान् दुर्लभं तव दर्शनम् ।\nभविष्यत्येव राजा हि तीव्रं चारप्स्यते तपः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2213739, "chapter_id": 5566, "verse_number": "३७", "content_sanskrit": "एतच्छ्रुत्वा महाबाहुः सहदेवो युधाम्पतिः ।\nयुधिष्ठिरमुवाचेदं बाष्पव्याकुललोचनः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2213740, "chapter_id": 5566, "verse_number": "३८", "content_sanskrit": "नोत्सहेऽहं परित्यक्तुं मातरं भरतर्षभ ।\nप्रतियातु भवान् क्षिप्रं तपस्तप्स्याम्यहं वने\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2213741, "chapter_id": 5566, "verse_number": "३९", "content_sanskrit": "इहैव शोषयिष्यामि तपसेदं कलेवरम् ।\nपादशुश्रूषणे रक्तो राज्ञो मात्रोस्तथाऽनयोः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2213742, "chapter_id": 5566, "verse_number": "४०", "content_sanskrit": "तमुवाच ततः कुन्ती परिष्वज्य महाभुजम् ।\nगम्यतां पुत्र मैवं त्वं वोचः कुरु वचो मम\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2213743, "chapter_id": 5566, "verse_number": "४१", "content_sanskrit": "आगमा वः शिवाः सन्तु स्वस्था भवत पुत्रकाः ।\nउपरोधो भवेदेवमस्माकं तपसः कृते\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2213744, "chapter_id": 5566, "verse_number": "४२", "content_sanskrit": "त्वत्स्नेहपाशबद्धा च हीयेयं तपसः परात् ।\nतस्मात्पुत्रक गच्छ त्वं शिष्टमल्पं च नः प्रभो\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2213745, "chapter_id": 5566, "verse_number": "४३", "content_sanskrit": "एवं संस्तम्भितं वाक्यैः कुन्त्या बहुविधैर्मनः ।\nसहदेवस्य राजेन्द्र राज्ञश्चैव विशेषतः\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2213746, "chapter_id": 5566, "verse_number": "४४", "content_sanskrit": "ते मात्रा समनुज्ञाता राज्ञा च कुरुपुङ्गवाः ।\nअभिवाद्य कुरुश्रेष्ठमामन्त्रयितुमारभन्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2213747, "chapter_id": 5566, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2213748, "chapter_id": 5566, "verse_number": "४५", "content_sanskrit": "राज्यं प्रति गमिष्यामः शिवेन प्रतिनन्दिताः ।\nअनुज्ञातास्त्वया राजन् गमिष्यामो विकल्मषाः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2213749, "chapter_id": 5566, "verse_number": "४६", "content_sanskrit": "एवमुक्तः स राजर्षिर्धर्मराज्ञा महात्मना ।\nअनुजज्ञे जयाशीर्भिः पूजयित्वा युधिष्ठिरम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2213750, "chapter_id": 5566, "verse_number": "४७", "content_sanskrit": "भीमं च बलिनं श्रेष्ठं सान्त्वयामास पार्थिवः ।\nस चास्य सम्यङ् मेधावी प्रत्यपद्यत वीर्यवान्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2213751, "chapter_id": 5566, "verse_number": "४८", "content_sanskrit": "अर्जुनं च समाश्लिष्य यमौ च भरतर्षभौ ।\nअनुजज्ञे स कौरव्यः परिष्वज्याभिनन्द्य च\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2213752, "chapter_id": 5566, "verse_number": "४९", "content_sanskrit": "गान्धार्या चाभ्यनुज्ञाताः कृतपादाभिवादनाः ।\nजनन्या समुपाघ्राताः परिष्वक्ताश्च ते नृपम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2213753, "chapter_id": 5566, "verse_number": "५०", "content_sanskrit": "चक्रुः प्रदक्षिणं सर्वे वत्सा इव निवारणे ।\nपुनः पुनर्निरीक्षन्तः प्रचक्रुस्ते प्रदक्षिणम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2213754, "chapter_id": 5566, "verse_number": "५१", "content_sanskrit": "द्रौपदीप्रमुखाश्चैव सर्वाः कौरवयोषितः ।\nन्यायतः श्वशुरे वृत्तिं प्रयुज्य प्रययुस्ततः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2213755, "chapter_id": 5566, "verse_number": "५२", "content_sanskrit": "श्वश्रूभ्यां समनुज्ञाताः परिष्वज्याभिनन्दिताः ।\nसन्दिष्टाश्चेतिकर्तव्यं प्रययुर्भर्तृभिः सह\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2213756, "chapter_id": 5566, "verse_number": "५३", "content_sanskrit": "ततः प्रजज्ञे निनदः सूतानां युज्यतामिति ।\nउष्ट्राणां क्रोशतां चापि हयानां हेषतामपि\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2213757, "chapter_id": 5566, "verse_number": "५४", "content_sanskrit": "ततो युधिष्ठिरो राजा सदारः सहसैनिकः ।\nनगरं हस्तिनपुरं पुनरायात् सबान्धवः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2213758, "chapter_id": 5566, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्रमवासिकपर्वणि\nहस्तिनपुरं प्रति युधिष्ठिरपुनरागमनं नाम द्विचत्वारिंशोऽध्यायः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2213759, "chapter_id": 5566, "verse_number": "९", "content_sanskrit": "पुत्रदर्शनपर्वणि नवमोऽध्यायः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2213760, "chapter_id": 5566, "verse_number": "", "content_sanskrit": "॥ समाप्तं पुत्रदर्शनपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]