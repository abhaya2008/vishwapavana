[{"id": 2133666, "chapter_id": 3883, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2133667, "chapter_id": 3883, "verse_number": "१", "content_sanskrit": "भूय एव महाभाग्यं कथ्यतामित्यब्रवीत् पाण्डवः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2133668, "chapter_id": 3883, "verse_number": "२", "content_sanskrit": "अथाचष्ट मार्कण्डेयो महाराज वृषदर्भसेदुकनामानौ राजानौ नीतिमार्गरतावस्त्रोपास्त्रकृतिनौ \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2133669, "chapter_id": 3883, "verse_number": "३", "content_sanskrit": "सेदुको वृषदर्भस्य बालस्यैव उपांशुव्रतमभ्यजानात् कुप्यमदेयं ब्राह्मणस्य \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2133670, "chapter_id": 3883, "verse_number": "४", "content_sanskrit": "अथ तं सेदुकं ब्राह्मणः कश्चिद् वेदाध्ययनसम्पन्न आशिषं दत्त्वा गुर्वर्थी भिक्षितवान् \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2133671, "chapter_id": 3883, "verse_number": "५", "content_sanskrit": "अश्वसहस्रं मे भवान् ददात्विति । कूप्यार्थितोऽयं ब्राह्मणस्य तं सेदुको ब्राह्मणमब्रवीत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2133672, "chapter_id": 3883, "verse_number": "६", "content_sanskrit": "नास्ति सम्भवो गुर्वर्थं दातुमिति \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2133673, "chapter_id": 3883, "verse_number": "७", "content_sanskrit": "स त्वं गच्छ वृषदर्भसकाशम् । राजा परमधर्मज्ञो ब्राह्मण तं भिक्षस्व । स ते दास्यति तस्यैतदुपांशुव्रतमिति \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2133674, "chapter_id": 3883, "verse_number": "८", "content_sanskrit": "अथ ब्राह्मणो वृषदर्भसकाशं गत्वा अश्वसहस्रमयाचत । स राजा तं कंसेनाताडयत् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2133675, "chapter_id": 3883, "verse_number": "९", "content_sanskrit": "तं ब्राह्मणोऽब्रवीत् । किं हिंस्यनागसं मामिति \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2133676, "chapter_id": 3883, "verse_number": "१०", "content_sanskrit": "एवमुक्त्या तं शपन्तं राजाऽऽह । विप्र किं यो न ददाति तुभ्यमुताहोस्विद् ब्राह्मण मैतत् \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2133677, "chapter_id": 3883, "verse_number": "", "content_sanskrit": "ब्राह्मणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2133678, "chapter_id": 3883, "verse_number": "११", "content_sanskrit": "राजाधिराजसमीपं सेदुकेन प्रेषितो भिक्षितुमागतः तेनानुशिष्टेन मया त्वं भिक्षितोऽसि \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2133679, "chapter_id": 3883, "verse_number": "", "content_sanskrit": "राजा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2133680, "chapter_id": 3883, "verse_number": "१२", "content_sanskrit": "पूर्वाह्णे ते दास्यामि योऽमोघबलिरागमिष्यति । यो हन्यते कशया कथं मोघं क्षेपणं तस्य स्यात् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2133681, "chapter_id": 3883, "verse_number": "१३", "content_sanskrit": "इत्युक्त्वा ब्राह्मणाय तामश्विकामुत्पत्तिं प्रादात् । अधिकस्या- श्वसहस्रस्य मूल्यमेवाददादिति \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2133682, "chapter_id": 3883, "verse_number": "२०४", "content_sanskrit": "॥ श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि\nचतुरधिकद्विशततमोऽध्यायः ॥२०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2133683, "chapter_id": 3883, "verse_number": "", "content_sanskrit": "॥ इति मार्कण्डेयसमास्यापर्वणि एकोनत्रिंशोऽध्यायः ॥२९॥\n* * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]