[{"id": 7002763000, "chapter_id": 22763, "verse_number": "९-४८-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nभगवन्दुर्गसंसारसागरोत्तारकारकम् ।\nकिञ्चिद्व्रतं समाचक्ष्व स्वर्गारोग्यसुखप्रदम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002763001, "chapter_id": 22763, "verse_number": "९-४८-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nयदा तु शुक्लसप्तम्यामादि त्यस्य दिनं भवेत् ।\nतदा सा तु महापुण्या विजया तु निगद्यते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002763002, "chapter_id": 22763, "verse_number": "९-४८-३", "content_sanskrit": "प्रातर्गव्येन पयसा स्नानमस्यां समाचरेत् ।\nशुक्लांबरधरः पद्ममक्षतैः परिक ल्पयेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002763003, "chapter_id": 22763, "verse_number": "९-४८-४", "content_sanskrit": "प्राङ्मुखोष्टदलं मध्ये तद्विचित्रां च कर्णिकाम् ।\nसर्वेष्वपि दलेष्वेव विन्यसेत्पूर्वतः क्रमात् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002763004, "chapter_id": 22763, "verse_number": "९-४८-५", "content_sanskrit": "पूर्वेण तपनायेति मार्तण्डायेति वै नमः ।\nयाम्ये दिवाकरायेति विधात्रे नैरृतेन च ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002763005, "chapter_id": 22763, "verse_number": "९-४८-६", "content_sanskrit": "पश्चिमे वरुणायेति भास्करायेति वानिले ।\nसौम्ये च वरुणायेति रवयेत्यऽष्टमे दले ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002763006, "chapter_id": 22763, "verse_number": "९-४८-७", "content_sanskrit": "आदावंते च तन्मध्ये नमोऽस्तु परमात्मने ।\nमंत्रैरेवं समभ्यर्च्य नमस्कारांतदीपितैः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002763007, "chapter_id": 22763, "verse_number": "९-४८-८", "content_sanskrit": "शुक्लवस्त्रफलैर्भक्ष्यैर्धूपमाल्यानुलेपनैः ।\nस्थंडिले पूजयेद्भक्त्या गुडेन लवणेन च ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002763008, "chapter_id": 22763, "verse_number": "९-४८-९", "content_sanskrit": "ततो व्याहृतिहोमेन विभज्य द्विजपुङ्गवान् ।\nशक्तितस्तर्पयेद्भक्त्या गुडक्षीरघृतादिभिः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002763009, "chapter_id": 22763, "verse_number": "९-४८-१०", "content_sanskrit": "तिलपात्रं हिरण्यं च गुरवे च निवेदयेत् ।\nएवं नियमकृत्स्नात्वा प्रातरुत्थाय मानवः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002763010, "chapter_id": 22763, "verse_number": "९-४८-११", "content_sanskrit": "कृतस्नानजपो विप्रैः सहैव घृतपायसम् ।\nभुक्त्वा च वेदविद्वद्भिर्बैडालव्रतव र्जितैः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002763011, "chapter_id": 22763, "verse_number": "९-४८-१२", "content_sanskrit": "एवं संवत्सरस्यांते कृत्वैतदखिलं नृप ।\nउद्यापयेद्यथाशक्ति भास्करं संस्मरन्हृदि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002763012, "chapter_id": 22763, "verse_number": "९-४८-१३", "content_sanskrit": "घृतपात्रं सकरकं सोदकुम्भं निवेद येत् ।\nवस्त्रालंकारसंयुक्तां सुवर्णास्यां पयस्विनीम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002763013, "chapter_id": 22763, "verse_number": "९-४८-१४", "content_sanskrit": "एकामपि प्रदद्याद्गां वित्तहीनो विमत्सरः ।\nवित्तशाठ्यं न कुर्वीत ततो मोहात्पत त्यधः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002763014, "chapter_id": 22763, "verse_number": "९-४८-१५", "content_sanskrit": "अनेन विधिना यस्तु कुर्यात्कल्याणसप्तमीम् ।\nशृणुयाद्वा पठेद्वापि सोऽपि पापैः प्रमुच्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002763015, "chapter_id": 22763, "verse_number": "९-४८-१६", "content_sanskrit": "यश्चाष्टपत्रकमलोदरकर्णिकायां संपूजयेत्कुसुमधूपविलेपनायैः ।\nषष्ठ्याः परेहनि नवार्तिहरं दिनेशं कल्याणभाजनमसौ भवते हि जंतुः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]