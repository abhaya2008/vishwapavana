[{"id": 7003167000, "chapter_id": 23167, "verse_number": "४-१०३-१", "content_sanskrit": "अथ त्र्यधिकशततमोऽध्यायः ।\nनारायण उवाच ।\nअथाऽऽगत्य मधुपुरीं प्रणम्य पितरं विभुः ।\nसबलो वटमूले च सस्मार गरुडं हरिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003167001, "chapter_id": 23167, "verse_number": "४-१०३-२", "content_sanskrit": "सादरं लवणोदं च विश्वकर्मणमीप्सितम् ।\nतत्याज गोपवेषं च नृपवेषं दधार सः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003167002, "chapter_id": 23167, "verse_number": "४-१०३-३", "content_sanskrit": "एतस्मिन्नन्तरे चक्रमाजगाम् हरिं स्वयम् ।\nपरं सुदर्शनं नाम सूर्यकोटिसमप्रभम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003167003, "chapter_id": 23167, "verse_number": "४-१०३-४", "content_sanskrit": "तेजसा हरिणा तुल्यं परं वैरिविमर्दनम् ।\nअव्यर्थमस्त्रमस्त्राणां प्रवरं परमं परम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003167004, "chapter_id": 23167, "verse_number": "४-१०३-५", "content_sanskrit": "रत्नयानं पुरः कृत्वा गरुडो हरिसंनिधिम् ।विश्वकर्मा सशिष्यश्च जलधिः कम्पितस्तथा ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003167005, "chapter_id": 23167, "verse_number": "४-१०३-६", "content_sanskrit": "हरिं प्रणेमुस्ते सर्वे मुर्ध्ना च भक्तिपूर्वकम् ।\nसस्मितः सादरं यत्नात्तानुवाच क्रमाद्विभुः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003167006, "chapter_id": 23167, "verse_number": "४-१०३-७", "content_sanskrit": "श्रीकृष्ण उवाच ।\nहे समुद्र महाभाग स्थलं च शातयोजनम् ।\nदेहि मे नगरार्थ च पश्चाद्दास्यामि निश्चितम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003167007, "chapter_id": 23167, "verse_number": "४-१०३-८", "content_sanskrit": "नगरं कुरु हे कारो त्रिषु लोकेषु दुर्लभम् ।\nरमणीयं च सर्वेषां कमनीयं च योषिताम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003167008, "chapter_id": 23167, "verse_number": "४-१०३-९", "content_sanskrit": "वाञ्चितं चापि भक्तानां वैकुण्ठसदृशं परम् ।\nसर्वेषामपि स्वर्गाणां परं पारमभीप्सितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003167009, "chapter_id": 23167, "verse_number": "४-१०३-१०", "content_sanskrit": "दिवानिशं खगश्रेष्ठ संनिधौ विश्वकर्मणः ।\nस्थितिं कुरु महाभाग यावन्निर्माति द्वारकाम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003167010, "chapter_id": 23167, "verse_number": "४-१०३-११", "content_sanskrit": "दिवानिशं च मत्पार्श्वे चक्रश्रेष्ठ स्थितिं कुरु ।\nओमित्युकत्वा तु प्रययुः सर्वे चकं विना मुने ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003167011, "chapter_id": 23167, "verse_number": "४-१०३-१२", "content_sanskrit": "कंसस्य पितरं भद्रमुग्रसेनं महाबलम् ।\nनृपं चकार नगरे क्षत्रियाणां सतामपि ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003167012, "chapter_id": 23167, "verse_number": "४-१०३-१३", "content_sanskrit": "विजित्य च जरासंधं निहत्य यवनं तथा ।\nउपायेन महाभाग निर्माणक्रममीश्वरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003167013, "chapter_id": 23167, "verse_number": "४-१०३-१४", "content_sanskrit": "श्रीभगवानुवाच ।\nशतयोजनपर्यन्तं नगरं सुमनोहरम् ।\nपद्मरागैर्मरकतैरिन्द्रनीलैरनुत्तमैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003167014, "chapter_id": 23167, "verse_number": "४-१०३-१५", "content_sanskrit": "रुचकैः पारिभद्रैश्च पलङ्कैश्च स्यमन्तकैः ।\nगन्धकैर्गालिमैश्चैव चन्द्रकान्तादिभिस्तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003167015, "chapter_id": 23167, "verse_number": "४-१०३-१६", "content_sanskrit": "सूर्यकान्तादिभिश्चैव पुत्रैश्च स्फटिकाकृतैः ।\nहरिद्वर्णैश्च मणिभिः श्यामैर्गोरमुखैश्चषैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003167016, "chapter_id": 23167, "verse_number": "४-१०३-१७", "content_sanskrit": "गोरोचनाभिः पीतैश्च दाडिमीबीजरूपकैः ।\nपद्मबीजनिभैश्चैव नीलैः कमलवर्णकैः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003167017, "chapter_id": 23167, "verse_number": "४-१०३-१८", "content_sanskrit": "मणिभिः कज्जलाकारैरुज्ज्वलैश्च परिष्कृतैः ।\nश्वेतचम्पकवर्णाभैस्तप्तकाञ्चनसंनिभैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003167018, "chapter_id": 23167, "verse_number": "४-१०३-१९", "content_sanskrit": "स्वर्णमूल्यशतगुणैरीषद्रक्तैः सुशोभनैः ।\nगरिष्ठैश्च वरिष्ठैश्चम णिश्रेष्ठैश्च पूजितैः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003167019, "chapter_id": 23167, "verse_number": "४-१०३-२०", "content_sanskrit": "यथाविधानं यद्योगं यत्र यन्मुक्तमीप्सितम् ।\nमणीनां हरणं चैव यक्षसंघा हिमालयात् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003167020, "chapter_id": 23167, "verse_number": "४-१०३-२१", "content_sanskrit": "दिवानिशं करिष्यन्ति यावन्निर्माणपूर्वकम् ।\nयक्षैश्च सप्तभिर्लक्षैः कुबेरप्रेरितैरपि ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003167021, "chapter_id": 23167, "verse_number": "४-१०३-२२", "content_sanskrit": "वेताललक्षैः कूष्माण्डलक्षैः शंकरयोजितैः ।\nदानवैर्ब्रह्मरक्षोभिः शैलकन्यानियोजितैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003167022, "chapter_id": 23167, "verse_number": "४-१०३-२३", "content_sanskrit": "कुरु दिव्यं च पत्नीनां सहस्राणां च षोडश ।\nअन्यपत्नीजनस्यापि चाष्टाधिकशतस्य च ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003167023, "chapter_id": 23167, "verse_number": "४-१०३-२४", "content_sanskrit": "शिबिरं परिखयुक्तमुच्चै प्राकारवेष्टितम् ।\nयुक्तद्वादशशालं च सिंहद्वारपरिष्कृतम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003167024, "chapter_id": 23167, "verse_number": "४-१०३-२५", "content_sanskrit": "युक्तं चित्रैर्विचित्रैश्च कृत्रिमैश्च कपाटकैः ।\nनिषिद्धवृक्षरहितं प्रसिद्धैश्च परिष्कृतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003167025, "chapter_id": 23167, "verse_number": "४-१०३-२६", "content_sanskrit": "सुलक्षणं चन्द्रवेधं प्राङ्गणं च तथैव च ।\nयदूनामाश्रमं दिव्यं किंकराणां तथैव च ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003167026, "chapter_id": 23167, "verse_number": "४-१०३-२७", "content_sanskrit": "सर्वत्र सिद्धं निलयमुग्रसेनस्य भूभृतः ।\nआश्रमं सर्वतोभद्रं वसुदेवस्य मत्पितुः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003167027, "chapter_id": 23167, "verse_number": "४-१०३-२८", "content_sanskrit": "विश्वकर्मोवाच ।\nके ते वृक्षाः प्रशस्ताश्च निषिद्धाश्चापि केचन ।\nभद्राभद्रप्रदाश्चापि तान्वदस्व जगद्गुरो ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003167028, "chapter_id": 23167, "verse_number": "४-१०३-२९", "content_sanskrit": "केषामस्थिनियुक्तं च शिबिरं च शुभाशुभम् ।\nदिशि कुत्र जलं भद्रमभद्रं च वद प्रभो ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003167029, "chapter_id": 23167, "verse_number": "४-१०३-३०", "content_sanskrit": "भद्रप्रदश्च को वृक्षो दिशि कृत्र प्रवर्तते ।\nकिं प्रमाणं गृहाणां च प्राङ्गणानां सुरेश्वर ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003167030, "chapter_id": 23167, "verse_number": "४-१०३-३१", "content_sanskrit": "मङ्गलं कुसुमोद्यानं दिशि कुत्र तरोस्तथा ।\nप्राकाराणां किं प्रमाणं परिखाणां सुरेश्वर ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003167031, "chapter_id": 23167, "verse_number": "४-१०३-३२", "content_sanskrit": "द्वाराणां च गृहाणां च प्राकाराणां प्रमाणकम् ।\nकस्य कस्य तरोः काष्ठं प्रशस्तं शिबिरे प्रभो ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003167032, "chapter_id": 23167, "verse_number": "४-१०३-३३", "content_sanskrit": "अमङ्गलं वा केषां च सर्व मां वक्तुमर्हसि ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003167033, "chapter_id": 23167, "verse_number": "४-१०३-३४", "content_sanskrit": "श्रीभगवानुवाच ।\nआश्रमे लारिकेलश्च गृहिणां च धनप्रदः ।\nशिबिरस्य यदीशाने पूर्वे पुत्रप्रदस्तरुः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003167034, "chapter_id": 23167, "verse_number": "४-१०३-३५", "content_sanskrit": "सर्वत्र मङ्गलार्हश्च तरुराजो मनोहरः ।\nरसालवृक्षः पूर्वस्मिन्नृणां संपत्प्रदस्तथा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003167035, "chapter_id": 23167, "verse_number": "४-१०३-३६", "content_sanskrit": "शुभप्रदश्च सर्वत्र सुरकारो निशामय ।\nबिल्वश्च पनसश्चैवजम्बीरो बदरी तथा ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003167036, "chapter_id": 23167, "verse_number": "४-१०३-३७", "content_sanskrit": "प्रजाप्रदश्च पूर्वस्मिन्दक्षिणे धनदस्तथा ।\nसंपत्प्रदश्च सर्वत्र यतो हि बर्धते गृही ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003167037, "chapter_id": 23167, "verse_number": "४-१०३-३८", "content_sanskrit": "जम्बूवृक्षश्च दाडिम्बः कदल्याम्रातकस्तथा ।\nबन्धुप्रदश्च पूर्वस्मिन्दक्षिणे मित्रदस्तथा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003167038, "chapter_id": 23167, "verse_number": "४-१०३-३९", "content_sanskrit": "सर्वत्र शुभदश्चैव धनपुत्रशुभप्रदः ।\nहर्षप्रदो गुवाकश्च दक्षिणे पश्चिमे तथा ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003167039, "chapter_id": 23167, "verse_number": "४-१०३-४०", "content_sanskrit": "ईशाने सुखदश्चैव सर्वत्रैव निशामय ।\nसर्वत्र चम्पकः शुद्धो भुवि भद्रप्रदस्तथा ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003167040, "chapter_id": 23167, "verse_number": "४-१०३-४१", "content_sanskrit": "अलाबुश्चापि कूष्माण्डमायाम्बुश्च सकिंशुकः ।\nखर्जूरी कर्कटी चापि शिबिरे मङ्गलप्रदा ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003167041, "chapter_id": 23167, "verse_number": "४-१०३-४२", "content_sanskrit": "वास्तूककारबिल्वश्च वार्ताकश्च शुभप्रदः ।\nलताफलं च शुभदं सर्वं सर्वत्र निश्चितम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003167042, "chapter_id": 23167, "verse_number": "४-१०३-४३", "content_sanskrit": "प्रशस्तं कथितं कारो निषिद्धं च निशामय ।\nवन्यवृक्षो निषिद्धश्च शिबिरे नगरेऽपि च ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003167043, "chapter_id": 23167, "verse_number": "४-१०३-४४", "content_sanskrit": "वटो निषिद्धः शिबिरे नित्यं चोरभयं यतः ।\nनगरेषु प्रसिद्धश्च दर्शनात्पुण्यदस्तथा ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003167044, "chapter_id": 23167, "verse_number": "४-१०३-४५", "content_sanskrit": "निषिद्धः शाल्मरिश्चैव शिबिरे नगरे पुरे ।\nदुःखप्रदश्च सततं भूमिपानां सदाऽपि च ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003167045, "chapter_id": 23167, "verse_number": "४-१०३-४६", "content_sanskrit": "न निषिद्धः प्रसिद्धश्च ग्रामेषु नगरेषु च ।\nविद्यामतिनिषिद्धस्तु सततं दुःखदस्तदा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003167046, "chapter_id": 23167, "verse_number": "४-१०३-४७", "content_sanskrit": "हे कारो तिन्तिडीवृक्षो यत्नात्तं परिवर्जयेत् ।\nशतेन धनहानिः स्यात्प्रजाहानिर्भवेद्ध्रुवम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003167047, "chapter_id": 23167, "verse_number": "४-१०३-४८", "content_sanskrit": "शिबिरेऽतिनिषिद्धश्च नगरे किंचिदेव च ।\nन निषिद्धः प्रसिद्धश्च ग्रामेषु नगरेषु च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003167048, "chapter_id": 23167, "verse_number": "४-१०३-४९", "content_sanskrit": "विद्यामतिनिषिद्धश्च प्राज्ञस्तं परिवर्जयेत् ।\nखर्जूरश्च गहश्चैव निषिद्धः शिबिरे तथा ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003167049, "chapter_id": 23167, "verse_number": "४-१०३-५०", "content_sanskrit": "न निषिद्धः प्रसिद्धश्च ग्रामेषु नगलेषु च ।\nवृक्षश्च चणकादीनां धान्यं च मङ्गलप्रदम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003167050, "chapter_id": 23167, "verse_number": "४-१०३-५१", "content_sanskrit": "ग्रामेषु नगरे चापि शिबिरे च तथैव च ।\nइक्षुवृक्षश्च शुभदः संततं शुभदस्तथा ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003167051, "chapter_id": 23167, "verse_number": "४-१०३-५२", "content_sanskrit": "अशोकश्च शिरीषश्च कदम्बश्च शुभप्रदः ।\nकच्चिद्धरिद्रा शुभदा शुभदश्चाऽऽर्द्रकस्तथा ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003167052, "chapter_id": 23167, "verse_number": "४-१०३-५३", "content_sanskrit": "हरीतकी च शुभदा ग्रामेषु नगरेषु च ।\nन वाद्या भद्रदा नित्यं चाऽऽमलकी घ्रुवम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003167053, "chapter_id": 23167, "verse_number": "४-१०३-५४", "content_sanskrit": "गजानामस्थि शुभदमश्वानां च तथैव च ।\nकल्याणमुच्चैःश्रवसां वास्तौ स्थापनकारिणाम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003167054, "chapter_id": 23167, "verse_number": "४-१०३-५५", "content_sanskrit": "न शुभप्रदमन्येषामुच्छिन्नकारणं परम् ।\nवानराणां नराणां च गर्दभानां गवामपि ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003167055, "chapter_id": 23167, "verse_number": "४-१०३-५६", "content_sanskrit": "कुक्कुराणां शृगालानां मार्जाराणामभद्रकम् ।\nभेटकानां सूकराणां कर्वेषां च शुभपदम् ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003167056, "chapter_id": 23167, "verse_number": "४-१०३-५७", "content_sanskrit": "ईशाने चापि पूर्वस्मिन्पश्चिमे च तथोत्तरे ।\nशिबिरस्य जलं भद्रमन्यत्राशुभमेव च ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003167057, "chapter_id": 23167, "verse_number": "४-१०३-५८", "content_sanskrit": "दीर्घे प्रस्थे समानं च न कुर्यान्मन्दिरे बुधः ।\nचतुरस्रे गृहे कारो गृहिणां धननाशनम् ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003167058, "chapter_id": 23167, "verse_number": "४-१०३-५९", "content_sanskrit": "दीर्घप्रस्थः परिमितो नेत्राङ्केनापि संहृतम् ।\nशून्येन रहितं भद्रं शून्यं शून्यप्रदं नृणाम् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003167059, "chapter_id": 23167, "verse_number": "४-१०३-६०", "content_sanskrit": "प्रस्थे हस्तद्वयात्पूर्वं दीर्घे हस्तत्रयं तथा ।\nगृहाणां शुभदं द्वारं प्राकारस्य गृहस्य च ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003167060, "chapter_id": 23167, "verse_number": "४-१०३-६१", "content_sanskrit": "न मध्यदेशे कर्तव्यं किंचिन्न्यूनाधिके शुभम् ।\nचतुरस्रं चन्द्रवेधं शिबिरं मङ्गलप्रदम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003167061, "chapter_id": 23167, "verse_number": "४-१०३-६२", "content_sanskrit": "अभद्रदं सूर्यवेधं शिबिरं मङ्गलप्रदम् ।\nअभद्रदं सूर्यवेधं प्राङ्गणं च तथैव च ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003167062, "chapter_id": 23167, "verse_number": "४-१०३-६३", "content_sanskrit": "शिबिराम्यन्तरे भद्रा स्थापिता तुलसी नृणाम् ।\nधनपुत्रप्रदात्री च पुण्यदा हरिभक्तिदा ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003167063, "chapter_id": 23167, "verse_number": "४-१०३-६४", "content_sanskrit": "प्रभाते तुलसीं दृष्ट्वा स्वर्णदानफलं लभेत् ।\nमालती यूथिका कुन्दं माधवी केतकी तथा ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003167064, "chapter_id": 23167, "verse_number": "४-१०३-६५", "content_sanskrit": "नागेश्वरं मल्लिकां च काञ्चनं बकुलं शुभम् ।\nअपराजिता च शुभदा तेषामुद्यानमीप्सितम् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003167065, "chapter_id": 23167, "verse_number": "४-१०३-६६", "content_sanskrit": "पूर्वे च दक्षिणे चैव शुभदं नात्र संशयः ।\nऊर्ध्वं षोडशहस्तेभ्यो नैव कुर्याद्गृहं गृही ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003167066, "chapter_id": 23167, "verse_number": "४-१०३-६७", "content_sanskrit": "उर्ध्वं विंशतिहस्तेभ्यः प्राकारं न शुभप्रदम् ।\nसूत्रधारं तैलकारं स्वर्णकारं च हीरकम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003167067, "chapter_id": 23167, "verse_number": "४-१०३-६८", "content_sanskrit": "वाटीमूले ग्राममध्ये न कुर्यात्स्थापनं बुध ।\nब्राह्मणं क्षभियं वैश्यं सच्छूद्रं गणकं शुभम् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003167068, "chapter_id": 23167, "verse_number": "४-१०३-६९", "content_sanskrit": "भट्टं वैद्यं पुष्पकारं स्थापयेच्छिबिरान्तिके ।\nप्रस्थे च परिखामानं शतहस्तं प्रशस्तकम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7003167069, "chapter_id": 23167, "verse_number": "४-१०३-७०", "content_sanskrit": "पारतः शिबिराणां च गम्भीरं दशहस्तकम् ।\nसेकेतपूर्वकं चैव परिखाद्वारमीप्सितम् ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7003167070, "chapter_id": 23167, "verse_number": "४-१०३-७१", "content_sanskrit": "शत्रोरगम्यं मित्रस्य गम्यमेव सुखेन च ।\nशाल्मलीनां तिन्तिडीनां हिन्तालानां तथैव च ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7003167071, "chapter_id": 23167, "verse_number": "४-१०३-७२", "content_sanskrit": "निम्बाणां सिन्धुवाराणां बदरीणामभद्रकम् ।\nधत्तूराणां वटानां चाप्येरण्डानामवाञ्छितम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7003167072, "chapter_id": 23167, "verse_number": "४-१०३-७३", "content_sanskrit": "एतेषामतिरिक्तानां शिबिरे काष्ठमीप्सितम् ।\nवृक्षं च वज्रहस्तं च भूधरो वर्जयेदधः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7003167073, "chapter_id": 23167, "verse_number": "४-१०३-७४", "content_sanskrit": "पुत्रदारधनं हन्यादित्याह कमलोद्भवः ।\nकथितं लोकशिक्षार्थं कुरुकाष्ठं विना पुरीम् ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7003167074, "chapter_id": 23167, "verse_number": "४-१०३-७५", "content_sanskrit": "शुभक्षणं चाप्यधुना गच्छ वत्स यथासुखम् ।\nविश्वकर्मा हरिं नत्वा जगाम् पक्षिणा सह ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7003167075, "chapter_id": 23167, "verse_number": "४-१०३-७६", "content_sanskrit": "समुद्रस्य समीपं च वटमूलं मनोहरम् ।\nसुष्वाप तत्र नक्तं च कारुश्च पक्षिणा सह ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7003167076, "chapter_id": 23167, "verse_number": "४-१०३-७७", "content_sanskrit": "स्वप्ने द्वारवतीं रम्यां ददर्श गरुडस्तथा ।\nयत्किंचित्कथितं कारुं कृष्णेन परमात्मना ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7003167077, "chapter_id": 23167, "verse_number": "४-१०३-७८", "content_sanskrit": "तदेव लक्षणं सर्वं ददर्श नगरे मुने ।\nकारुं हमन्ति स्वप्ने च सर्वे ते शिल्पकारिणः ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7003167078, "chapter_id": 23167, "verse_number": "४-१०३-७९", "content_sanskrit": "गरुडं गरुडाश्चान्ये बरवन्तश्च पक्षिणः ।\nबुद्धो ददर्श गरुडो विश्वकर्मा च लज्जितः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7003167079, "chapter_id": 23167, "verse_number": "४-१०३-८०", "content_sanskrit": "अतीव द्वारकां रम्यां शतयोजनविस्तृताम् ।\nब्रह्मादीनां च नगरं विजित्य च विराजिताम् ।\nतेजसाऽऽच्छादितां सूर्यं रत्नानां च परिष्कृताम् ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}]