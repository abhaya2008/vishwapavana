[{"id": 2115229, "chapter_id": 3479, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2115230, "chapter_id": 3479, "verse_number": "१", "content_sanskrit": "युधिष्ठिरेणैवमुक्ता कुन्त्या चाङ्केऽधिरोपिता ।\nभीमार्जुनान्तरगता यमाभ्यां च पुरस्कृता \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2115231, "chapter_id": 3479, "verse_number": "२", "content_sanskrit": "तिर्यग् युधिष्ठिरं याति हिडिम्बा भीमगामिनी ।\nशालिहोत्रसरो रम्यमासेदुस्ते जलार्थिनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2115232, "chapter_id": 3479, "verse_number": "३", "content_sanskrit": "तत् तथेति प्रतिज्ञाय हिडिम्बा राक्षसी तदा ।\nवनस्पतितळं गत्वा परिमृज्य यथा गृहान् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2115233, "chapter_id": 3479, "verse_number": "४", "content_sanskrit": "पाण्डवानां च वासं सा कृत्वा पर्णमयं तथा ।\nआत्मनश्च तथा कुन्त्या एकोद्देशे चकार सा \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2115234, "chapter_id": 3479, "verse_number": "५", "content_sanskrit": "सहितान् पाण्डवानां सा कृत्वा शयनपञ्चकान् ।\nआत्मनश्च तथा कुन्त्या एकोद्देशे कृतं द्विधा \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2115235, "chapter_id": 3479, "verse_number": "६", "content_sanskrit": "पाण्डवास्तु ततः स्नात्वा शुद्धाः सन्ध्यामुपास्य च ।\nतृषिताः क्षुत्पिपासार्ता जलमात्रेण वर्तयन् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2115236, "chapter_id": 3479, "verse_number": "७", "content_sanskrit": "शालिहोत्रस्ततो ज्ञात्वा क्षुधार्तान् पाण्डवांस्तदा ।\nमनसा चिन्तयामास पानीयं भोजनं महत् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2115237, "chapter_id": 3479, "verse_number": "८", "content_sanskrit": "ततस्ते पाण्डवाः सर्वे विश्रान्ताः पृथया सह ।\nयथा जतुगृहे वृत्तं राक्षसेन कृतं च यत् \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2115238, "chapter_id": 3479, "verse_number": "९", "content_sanskrit": "कृत्वा कथा बहुविधाः कथान्ते पाण्डुनन्दनम् ।\nकुन्ती राजसुता वाक्यं भीमसेनमथाब्रवीत् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2115239, "chapter_id": 3479, "verse_number": "१०", "content_sanskrit": "यथा पाण्डुस्तथा मान्यस्तव ज्येष्ठो युधिष्ठिरः ।\nअहं धर्मविधानेन मान्या गुरुतरी तव \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2115240, "chapter_id": 3479, "verse_number": "११", "content_sanskrit": "तस्मात् पाण्डुहितार्थं मे युवराज हितं कुरु ।\nनिकृता धार्तराष्ट्रेण पापेनाकृतबुद्धिना\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2115241, "chapter_id": 3479, "verse_number": "१२", "content_sanskrit": "दुष्कृतस्य प्रतीकारं न पश्यामि वृकोदर ।\nतस्मात् कतिपयाहेन योगक्षेमं भविष्यति \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2115242, "chapter_id": 3479, "verse_number": "१३", "content_sanskrit": "क्षेमं दुर्गमिमं वासं वसिष्यामो यथासुखम् ।\nइदमद्य महद्दुःखं धर्मकृच्छ्रं वृकोदर \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2115243, "chapter_id": 3479, "verse_number": "१४", "content_sanskrit": "दृष्ट्वैव त्वां महाप्राज्ञ अनङ्गाभिप्रचोदिता ।\nयुधिष्ठिरं च मां चैव वरयामास धर्मतः \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2115244, "chapter_id": 3479, "verse_number": "१५", "content_sanskrit": "धर्मार्थं देहि पुत्रं त्वं स नः श्रेयः करिष्यति ।\nप्रतिवाक्यं तु नेच्छामि आवाभ्यां वचनं कुरु \t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2115245, "chapter_id": 3479, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2115246, "chapter_id": 3479, "verse_number": "१६", "content_sanskrit": "तथेति तत् प्रतिज्ञाय भीमसेनोऽब्रवीदिदम् ।\nशासनं ते करिष्यामि वेदशासनमित्यपि \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2115247, "chapter_id": 3479, "verse_number": "१७", "content_sanskrit": "समक्षं भ्रातृमध्ये तु भीमसेनोऽब्रवीदिदम् ।\nशृणु राक्षसि सत्येन समयं ते वदाम्यहम् \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2115248, "chapter_id": 3479, "verse_number": "१८", "content_sanskrit": "यावत्कालेन भवति अपत्योत्पादनं शुभे ।\nतावत्कालं चरिष्यामि त्वया सह सुमध्यमे \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2115249, "chapter_id": 3479, "verse_number": "१९", "content_sanskrit": "विशेषतो मत्सकाशे मा प्रकाशय नीचताम् ।\nउत्तमस्त्रीगुणोपेता भजेथा वरवर्णिनि\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2115250, "chapter_id": 3479, "verse_number": "२०", "content_sanskrit": "सा तथेति प्रतिज्ञाय हिडिम्बी राक्षसी तदा ।\nगताऽहनि निवेशेषु भोज्यं राजार्हमानयत् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2115251, "chapter_id": 3479, "verse_number": "२१", "content_sanskrit": "सा कदाचिद् विहारार्थं हिडिम्बी कामचारिणी ।\nभीमसेनमुपादाय ऊर्ध्वमाचक्रमे ततः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2115252, "chapter_id": 3479, "verse_number": "२२", "content_sanskrit": "वनेषु च सशैलेषु देवतायतनेषु च ।\nमृगपक्षिविघुष्टेषु रमणीयेषु सर्वतः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2115253, "chapter_id": 3479, "verse_number": "२३", "content_sanskrit": "कृत्वा सा परमं रूपं सर्वाभरणभूषिता ।\nसञ्जल्पन्ती सुमधुरं रमयामास पाण्डवम् \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2115254, "chapter_id": 3479, "verse_number": "२४", "content_sanskrit": "तथैव वनदुर्गेषु पर्वतद्रुमसानुषु ।\nसरस्सु रमणीयेषु पद्मोत्पलवनेषु च \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2115255, "chapter_id": 3479, "verse_number": "२५", "content_sanskrit": "नदीद्वीपप्रदेशेषु मणिहेमयुतेषु च ।\nपत्तनेषु च रम्येषु महासालवनेषु च\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2115256, "chapter_id": 3479, "verse_number": "२६", "content_sanskrit": "देवारण्येषु पुण्येषु तापसायतनेषु च ।\nगुह्यकानां निवासेषु कुलपर्वतसानुषु \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2115257, "chapter_id": 3479, "verse_number": "२७", "content_sanskrit": "सर्वर्तुफलवृक्षेषु मानसेषु वनेषु च ।\nबिभ्रती परमं रूपं रमयामास पाण्डवम् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2115258, "chapter_id": 3479, "verse_number": "२८", "content_sanskrit": "यथा च सुकृती स्वर्गे मोदतेऽप्सरसा सह ।\nस तथा परमप्रीतस्तया रेमे महाद्युतिः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2115259, "chapter_id": 3479, "verse_number": "२९", "content_sanskrit": "रमयन्ती ततो भीमं तत्रतत्र मनोजवा ।\nसा रेमे तेन संहर्षादतृप्यन्ती मुहुर्मुहुः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2115260, "chapter_id": 3479, "verse_number": "३०", "content_sanskrit": "अहस्सु विचरन्ती सा निशाकालेषु पाण्डवम् ।\nआनीय वै स्वके गेहे दर्शयामास मातरम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2115261, "chapter_id": 3479, "verse_number": "३१", "content_sanskrit": "भ्रातृभिः सहितो नित्यं स्वपते पाण्डवस्तदा ।\nकुन्त्याः परिचरन्ती स तस्याः पार्श्वेऽवसन्निशाम् ।\nकामांश्च मुखवासादीनानयिष्यति भोजनम् \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]