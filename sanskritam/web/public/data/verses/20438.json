[{"id": 7000438000, "chapter_id": 20438, "verse_number": "२-११०-१", "content_sanskrit": "कुंजल उवाच ।\nआमंत्र्य स मुनीन्सर्वान्वशिष्ठं तपतांवरम् ।\nसमुत्सुको गंतुकामो नहुषो दानवं प्रति॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000438001, "chapter_id": 20438, "verse_number": "२-११०-२", "content_sanskrit": "ततस्ते मुनयः सर्वे वशिष्ठाद्यास्तपोधनाः ।\nआशीर्भिरभिनंद्यैनमायुपुत्रं महाबलम्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000438002, "chapter_id": 20438, "verse_number": "२-११०-३", "content_sanskrit": "आकाशे देवताः सर्वा जघ्नुर्वै दुंदुभीन्मुदा ।\nपुष्पवृष्टिं प्रचक्रुस्ते नहुषस्य च मूर्धनि॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000438003, "chapter_id": 20438, "verse_number": "२-११०-४", "content_sanskrit": "अथ देवः सहस्राक्षः सुरैः सार्द्धं समागतः ।\nददौ शस्त्राणि चास्त्राणि सूर्यतेजोपमानि च॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000438004, "chapter_id": 20438, "verse_number": "२-११०-५", "content_sanskrit": "देवेभ्यो नृपशार्दूलो जगृहे द्विजसत्तम ।\nतानि दिव्यानि चास्त्राणि दिव्यरूपोपमोऽभवत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000438005, "chapter_id": 20438, "verse_number": "२-११०-६", "content_sanskrit": "अथ ता देवताः सर्वाः सहस्राक्षमथाब्रुवन् ।\nस्यंदनो दीयतामस्मै नहुषाय सुरेश्वर॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000438006, "chapter_id": 20438, "verse_number": "२-११०-७", "content_sanskrit": "देवानां मतमाज्ञाय वज्रपाणिः स्वसारथिम् ।\nआहूय मातलि तं तु आदिदेश ततो द्विज॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000438007, "chapter_id": 20438, "verse_number": "२-११०-८", "content_sanskrit": "एनं गच्छ महात्मानमुह्यतां स्यंदनेन वै ।\nसध्वजेन महाप्राज्ञमायुजं समरोद्यतम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000438008, "chapter_id": 20438, "verse_number": "२-११०-९", "content_sanskrit": "स चोवाच सहस्राक्षं करिष्ये तवशासनम् ।\nएवमुक्त्वा जगामाशु ह्यायुपुत्रं रणोद्यतम्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000438009, "chapter_id": 20438, "verse_number": "२-११०-१०", "content_sanskrit": "राजानं प्रत्युवाचैव देवराजस्य भाषितम् ।\nविजयी भव धर्मज्ञ रथेनानेन संगरे॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000438010, "chapter_id": 20438, "verse_number": "२-११०-११", "content_sanskrit": "इत्युवाच सहस्राक्षस्त्वामेव नृपतीश्वर ।\nजहि त्वं दानवं संख्ये तं हुंडं पापचेतनम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000438011, "chapter_id": 20438, "verse_number": "२-११०-१२", "content_sanskrit": "समाकर्ण्य स राजेंद्र सानंदपुलकोद्गमः ।\nप्रसादाद्देवदेवस्य वशिष्ठस्य महात्मनः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000438012, "chapter_id": 20438, "verse_number": "२-११०-१३", "content_sanskrit": "दानवं सूदयिष्यामि समरे पापचेतनम् ।\nदेवानां च विशेषेण मम मायापचारितम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000438013, "chapter_id": 20438, "verse_number": "२-११०-१४", "content_sanskrit": "एवमुक्ते महावाक्ये नहुषेण महात्मना ।\nअथायातः स्वयं देवः शंखचक्रगदाधरः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000438014, "chapter_id": 20438, "verse_number": "२-११०-१५", "content_sanskrit": "चक्राच्चक्रं समुत्पाट्य सूर्यबिंबोपमं महत् ।\nज्वलता तेजसा दीप्तं सुवृत्तारं शुभावहम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000438015, "chapter_id": 20438, "verse_number": "२-११०-१६", "content_sanskrit": "नहुषाय ददौ देवो हर्षेण महता किल ।\nतस्मै शूलं ददौ शंभुः सुतीक्ष्णं तेजसान्वितम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000438016, "chapter_id": 20438, "verse_number": "२-११०-१७", "content_sanskrit": "तेन शूलवरेणासौ शोभते समरोद्यतः ।\nद्वितीयः शंकरश्चासौ त्रिपुरघ्नो यथा प्रभुः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000438017, "chapter_id": 20438, "verse_number": "२-११०-१८", "content_sanskrit": "ब्रह्मास्त्रं दत्तवान्ब्रह्मा वरुणः पाशमुत्तमम् ।\nचंद्र तेजःप्रतीकाशं शंखं च नादमंगलम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000438018, "chapter_id": 20438, "verse_number": "२-११०-१९", "content_sanskrit": "वज्रमिंद्रस्तथा शक्तिं वायुश्चापं समार्गणम् ।\nआग्नेयास्त्रं तथा वह्निर्ददौ तस्मै महात्मने॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000438019, "chapter_id": 20438, "verse_number": "२-११०-२०", "content_sanskrit": "शस्त्राण्यस्त्राणि दिव्यानि बहूनि विविधानि च ।\nददुर्देवा महात्मानस्तस्मै राज्ञे महौजसे॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000438020, "chapter_id": 20438, "verse_number": "२-११०-२१", "content_sanskrit": "कुंजल उवाच ।\nअथ आयुसुतो वीरो दैवतैः परिमानितः ।\nआशीर्भिर्नंदितश्चापि मुनिभिस्तत्त्ववेदिभिः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000438021, "chapter_id": 20438, "verse_number": "२-११०-२२", "content_sanskrit": "आरुरोह रथं दिव्यं भास्वरं रत्नमालिनम् ।\nघंटारवैः प्रणदंतं क्षुद्रघंटासमाकुलम्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000438022, "chapter_id": 20438, "verse_number": "२-११०-२३", "content_sanskrit": "रथेन तेन दिव्येन शुशुभे नृपनदंनः ।\nदिविमार्गे यथा सूर्यस्तेजसा स्वेन वै किल॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000438023, "chapter_id": 20438, "verse_number": "२-११०-२४", "content_sanskrit": "प्रतपंस्तेजसा तद्वद्दैत्यानां मस्तकेषु सः ।\nजगाम शीघ्रं वेगेन यथा वायुः सदागतिः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000438024, "chapter_id": 20438, "verse_number": "२-११०-२५", "content_sanskrit": "यत्रासौ दानवः पापस्तिष्ठते स्वबलैर्युतः ।\nतेन मातलिना सार्द्धं वाहकेन महात्मना॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]