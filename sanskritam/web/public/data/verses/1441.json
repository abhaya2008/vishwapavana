[{"id": 2020995, "chapter_id": 1441, "verse_number": "३-७९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020996, "chapter_id": 1441, "verse_number": "३-७९-१", "content_sanskrit": "`धनञ्जयोत्सुकास्ते तु वने तस्मिन्महारथाः।\nन्यवसन्त महाभागा द्रौपद्या सह कृष्णया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020997, "chapter_id": 1441, "verse_number": "३-७९-२", "content_sanskrit": "धनं जयोत्सुकानां तु भ्रातॄणां कृष्णया सह।\nश्रुत्वा वाक्यानि विमना धर्मराजोप्यजायत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020998, "chapter_id": 1441, "verse_number": "३-७९-३", "content_sanskrit": "अथापश्यन्महात्मानं देवर्षिं तत्र नारदम्।\nदीप्यमानं श्रिया ब्राह्म्या दीप्ताग्निसमतेजसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020999, "chapter_id": 1441, "verse_number": "३-७९-४", "content_sanskrit": "तमागतमभिप्रेक्ष्य भ्रातृभिः सह धर्मराट्।\nप्रत्युत्थाय यथान्यायं पूजां चक्रे महात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2021000, "chapter_id": 1441, "verse_number": "३-७९-५", "content_sanskrit": "स तैः परिवृतः श्रीमान्भ्रातृभिः कुरुसत्तमः।\nविबभावतिदीप्तौजा देवैरिव शतक्रतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2021001, "chapter_id": 1441, "verse_number": "३-७९-६", "content_sanskrit": "यथा च वेदान्सावित्री याज्ञसेनी तथा पतीन्।\nन जहौ धर्मतः पार्थान्मेरुमर्कप्रभा यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2021002, "chapter_id": 1441, "verse_number": "३-७९-७", "content_sanskrit": "`अर्ध्यं पाद्यमथानीय त्वभ्यवायदच्युतः।\nनारदस्तु महातेजाः स्वस्त्यस्त्वित्यभ्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2021003, "chapter_id": 1441, "verse_number": "३-७९-८", "content_sanskrit": "ततो युधिष्ठिरो राजा दृष्ट्वा देवर्षिसत्तमम्।\nयथार्हं पूजयामास विधिवत्कुरुनन्दनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2021004, "chapter_id": 1441, "verse_number": "३-७९-९", "content_sanskrit": "प्रतिगृह्य च तां पूजां नारदो भगवानृषिः।\nआश्वासयद्धर्मसुतं युक्तरूपमिवानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2021005, "chapter_id": 1441, "verse_number": "३-७९-१०", "content_sanskrit": "उवाच च महात्मानं धर्मराजं युधिष्ठिरम्।\nब्रूहि धर्मभृतां श्रेष्ठ केनार्थः किं ददानि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2021006, "chapter_id": 1441, "verse_number": "३-७९-११", "content_sanskrit": "अथ धर्मसुतो राजा प्रणम्य भ्रातृभिः सह।\nउवाच प्राञ्जलिर्भूत्वा नारदं देवसंमितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2021007, "chapter_id": 1441, "verse_number": "३-७९-१२", "content_sanskrit": "न्वयि तुष्टे महाभाग सर्वलोकाभिपूजिते।\nकृतमित्येव मन्येऽहं प्रसादात्तव सुव्रत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2021008, "chapter_id": 1441, "verse_number": "३-७९-१३", "content_sanskrit": "यदि त्वहमनुग्राह्यो भ्रातृभिः सहितोऽनघ।\nसंदेहं मे सुनिश्रेष्ठ तत्वतश्छेत्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2021009, "chapter_id": 1441, "verse_number": "३-७९-१४", "content_sanskrit": "प्रदक्षिणां यः कुरुते पृथिवीं तीर्थतत्परः।\nकिं फलं तस्य कार्त्स्न्येन तद्भवान्वक्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2021010, "chapter_id": 1441, "verse_number": "३-७९-१५x", "content_sanskrit": "नारद उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2021011, "chapter_id": 1441, "verse_number": "३-७९-१५", "content_sanskrit": "शृणु राजन्नवहितो यथा भीष्मेण धीमता।\nपुलस्त्यस्य सकाशाद्वै सर्वमेतदुपश्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2021012, "chapter_id": 1441, "verse_number": "३-७९-१६", "content_sanskrit": "पुरा भागीरथीतीरे भीष्मो धर्मभृतांवरः।\nपित्र्यं व्रतं समास्थाय न्यवसन्मुनिभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2021013, "chapter_id": 1441, "verse_number": "३-७९-१७", "content_sanskrit": "शुभे देशे तथा राजन्पुण्ये देवर्षिसेविते।\nगङ्गाद्वारे महाभाग देवगन्धर्वसेविते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2021014, "chapter_id": 1441, "verse_number": "३-७९-१८", "content_sanskrit": "स पितॄंस्तर्पयामास देवांश्च परमद्युतिः।\nऋषींश्च तर्पयामास विधिदृष्टेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2021015, "chapter_id": 1441, "verse_number": "३-७९-१९", "content_sanskrit": "कस्य चित्त्वथ कालस्य जपन्नेव महायशाः।\nददर्शाद्भुतसंकाशं पुलस्त्यमृषिसत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2021016, "chapter_id": 1441, "verse_number": "३-७९-२०", "content_sanskrit": "स तं दृष्ट्वोग्रतपसं दीप्यमानमिव श्रिया।\nप्रहर्षमतुलं लेभे विस्मयं परमं ययौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2021017, "chapter_id": 1441, "verse_number": "३-७९-२१", "content_sanskrit": "उपस्थितं महाभागं पूजयामास भारत।\nभीष्मो धर्मभृतां श्रेष्ठो विधिदृष्टेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2021018, "chapter_id": 1441, "verse_number": "३-७९-२२", "content_sanskrit": "शिरसा चाघमादाय शुचिः प्रयतमानसः।\nनाम संकीर्तयामास तस्मिन्ब्रह्मर्षिसत्तमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2021019, "chapter_id": 1441, "verse_number": "३-७९-२३", "content_sanskrit": "भीष्मोऽहमस्मि भद्रं ते दासोऽस्मि तव सुव्रत।\nतव संदर्शनादेव मुक्तोऽहं सर्वकिल्वपैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2021020, "chapter_id": 1441, "verse_number": "३-७९-२४", "content_sanskrit": "रएवमुक्त्वा महाराज भीष्मो धर्मभृतांवरः।\nवाग्यतः प्राञ्जलिर्भूत्वातूष्णीमासीद्युधिष्ठिर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2021021, "chapter_id": 1441, "verse_number": "३-७९-२५", "content_sanskrit": "तं दृष्ट्वा नियमेनाथ स्वाध्यायाम्नायकर्शितम्।\nभीष्मं कुरुकुलश्रेष्ठं मुनिः प्रीतमनाऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2021022, "chapter_id": 1441, "verse_number": "३-७९-२६", "content_sanskrit": "`ततः स मधुरेणाथ स्वरेण सुमहातपाः।\nउवाच वाक्यं धर्मज्ञः पुलस्त्यः प्रीतमानसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2021023, "chapter_id": 1441, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्माहाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि एकोनाशीतितमोऽध्यायः ॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]