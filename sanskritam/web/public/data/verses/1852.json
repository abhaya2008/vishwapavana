[{"id": 2039012, "chapter_id": 1852, "verse_number": "५-९७-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039013, "chapter_id": 1852, "verse_number": "५-९७-१", "content_sanskrit": "जामदग्न्यवचः श्रुत्वा कण्वेऽपि भगवानृषिः ।\nदुर्योधनमिदं वाक्यमब्रवीत्कुरुसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039014, "chapter_id": 1852, "verse_number": "५-९७-२x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039015, "chapter_id": 1852, "verse_number": "५-९७-२", "content_sanskrit": "अक्षयश्चाव्ययश्चैव ब्रह्मा लोकपितामहः।\nतथैव भगवन्तौ तौ नरनारायणावृषी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039016, "chapter_id": 1852, "verse_number": "५-९७-३", "content_sanskrit": "आदित्यानां हि सर्वेषां विष्णुरेकः सनातनः।\nअजथ्यश्चाव्ययश्चैव शाश्वतः प्रभुरीश्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039017, "chapter_id": 1852, "verse_number": "५-९७-४", "content_sanskrit": "निमित्तमरणाश्चान्ये चन्द्रसूर्यौ मही जलम् ।\nवायुरग्निस्तथाऽऽकाशं ग्रहास्तारागणास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039018, "chapter_id": 1852, "verse_number": "५-९७-५", "content_sanskrit": "ते च क्षयान्ते जगतो हित्वा लोकत्रयं सदा।\nक्षयं गच्छन्ति वै सर्वे सृज्यन्ते च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039019, "chapter_id": 1852, "verse_number": "५-९७-६", "content_sanskrit": "मुहूर्तमरणास्त्वन्ये मानुषा मूगपक्षिणः।\nतैर्यग्योन्याश्च ये चान्ये जीवलोकचरास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039020, "chapter_id": 1852, "verse_number": "५-९७-७", "content_sanskrit": "भूयिष्ठेन तु राजानः श्रियं भुक्त्वाऽऽयुषः क्षये।\nतरुणाः प्रतिपद्यन्ते भोक्तुं सुकृतदुष्कृते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039021, "chapter_id": 1852, "verse_number": "५-९७-८", "content_sanskrit": "स भवान्धर्मपुत्रेण शमं कर्तुमिहार्हसि ।\nपाण्डवाः कुरवश्चैव पालयन्तु वसुन्धरान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039022, "chapter_id": 1852, "verse_number": "५-९७-९", "content_sanskrit": "बलवानहमित्येव न मन्तव्यं सुयोधन ।\nबलवन्तो बलिभ्यो हि दृश्यन्ते पूरुषर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039023, "chapter_id": 1852, "verse_number": "५-९७-१०", "content_sanskrit": "न बलं बलिनां मध्ये बलं भवति कौरव ।\nबलवन्तो हि ते सर्वे पाण्डवा देवविक्रमाः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039024, "chapter_id": 1852, "verse_number": "५-९७-११", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम् ।\nमातलेर्दातुकामस्य कन्यां मृगयतो वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039025, "chapter_id": 1852, "verse_number": "५-९७-१२", "content_sanskrit": "मतस्त्रिलोकराजस्य मातलिर्नाम सारथिः।\nतस्यैकैव कुले मन्या रूपतो लोकविश्रुता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039026, "chapter_id": 1852, "verse_number": "५-९७-१३", "content_sanskrit": "गुणकेशीति विख्याता नाम्ना सा देवरूपिणी ।\nश्रिया च वपुषा चैव स्त्रियोऽन्याःसाऽतिरिच्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039027, "chapter_id": 1852, "verse_number": "५-९७-१४", "content_sanskrit": "तस्याः प्रदानसमयं मातलिः सह भार्यया ।\nज्ञात्वा विममृशे राजंस्तत्परः परिचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039028, "chapter_id": 1852, "verse_number": "५-९७-१५", "content_sanskrit": "धिक्खल्वलघुशीलानामुच्छ्रितानां यशस्विनाम्।\nनराणां मृदुसत्वानां कुले कन्याप्ररोहणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039029, "chapter_id": 1852, "verse_number": "५-९७-१६", "content_sanskrit": "मातुः कुलं पितृकुलं यत्र चैव प्रदीयते।\nकुलत्रयं संशयितं कुरुते कन्यका सताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039030, "chapter_id": 1852, "verse_number": "५-९७-१७", "content_sanskrit": "देवमानुषलोकौ द्वौ मानुषेणैव चक्षुषा।\nअपगाह्यैव विचितौ न च मे रोचते वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039031, "chapter_id": 1852, "verse_number": "५-९७-१८x", "content_sanskrit": "कण्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039032, "chapter_id": 1852, "verse_number": "५-९७-१८", "content_sanskrit": "न देवान्नैव दितिजान्न गन्धर्वान्न मानुषान्।\nअरोचयद्वरकृते तथैव बहुलानृषीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039033, "chapter_id": 1852, "verse_number": "५-९७-१९", "content_sanskrit": "भार्यया तु स संमन्त्र्य सह रात्रौ सुधर्मया ।\nमातलिर्नागलोकाय चकार गमने मतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039034, "chapter_id": 1852, "verse_number": "५-९७-२०", "content_sanskrit": "न मे देवमनुष्येषु गुणकेश्याः समो वरः।\nरूपतो दृश्यते कश्चिन्नागेषु भविता ध्रुवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2039035, "chapter_id": 1852, "verse_number": "५-९७-२१", "content_sanskrit": "इत्यामन्त्र्य सुधर्मां स कृत्वा चाभिप्रदक्षिणम्।\nकन्यां शिरस्युपाघ्राय प्रविवेश महीतलम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2039036, "chapter_id": 1852, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते उद्योगपर्वणि भगवद्यानपर्वणि सप्तनवतितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]