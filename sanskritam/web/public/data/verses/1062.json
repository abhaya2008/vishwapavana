[{"id": 2002802, "chapter_id": 1062, "verse_number": "१-६३-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2002803, "chapter_id": 1062, "verse_number": "१-६३-१", "content_sanskrit": "पूरोर्वंशमहं धन्यं राज्ञाममिततेजसाम्।\nप्रवक्ष्यामि पितॄणां ते तेषां नामानि मे शृमु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2002804, "chapter_id": 1062, "verse_number": "१-६३-२", "content_sanskrit": "अव्यक्तप्रभवो ब्रह्मा शाश्वतो नित्य अव्ययः।\nतस्मान्मरीचिः संजज्ञे दक्षश्चैव प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2002805, "chapter_id": 1062, "verse_number": "१-६३-३", "content_sanskrit": "अङ्गुष्ठाद्दक्षमसृजच्चक्षुर्भ्यां च मरीचिनम्।\nमरीचेः कश्यपः पुत्रो दक्षस्य दुहिताऽऽदितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2002806, "chapter_id": 1062, "verse_number": "१-६३-४", "content_sanskrit": "अदित्यां कश्यपाद्विवस्थान्।\nविवस्वतो मनुर्मनोरिला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2002807, "chapter_id": 1062, "verse_number": "१-६३-५", "content_sanskrit": "इलायाः पुरूरवाः।\nपुरूरवस आयुः।\nआयुषो नहुषः।\nनहुषस्य ययातिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2002808, "chapter_id": 1062, "verse_number": "१-६३-६", "content_sanskrit": "ययातेर्द्वे भार्ये बभूवतुः।\nउशनसो दुहिता देवयानी वृषपर्वणश्च दुहिता शर्मिष्ठा नाम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2002809, "chapter_id": 1062, "verse_number": "१-६३-७", "content_sanskrit": "तत्रानुवंशो भवति।\nयदुं च तुर्वसुं चैव देवयानी व्यजायत।\nद्रुह्यं चानुं च पूरुं च शर्मिष्ठा वार्षपर्वणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2002810, "chapter_id": 1062, "verse_number": "१-६३-८", "content_sanskrit": "तत्र यदोर्यादवाः।\nपूरोः पौरवाः।\nपूरोर्भार्या कौसल्या बभूव।\nतस्यामस्य जज्ञे जनमेजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2002811, "chapter_id": 1062, "verse_number": "१-६३-९", "content_sanskrit": "स त्रीन्हयमेधानाजहार।\nविश्वजिता चेष्ट्वा वनं प्रविवेश॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2002812, "chapter_id": 1062, "verse_number": "१-६३-१०", "content_sanskrit": "जनमेजयस्तु सुनन्दां नामोपयेमे मागधीं।\nतस्यामस्य जज्ञे प्राचीन्वान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2002813, "chapter_id": 1062, "verse_number": "१-६३-११", "content_sanskrit": "यः प्राचीं दिशं जिगाय।\nयावत्सूर्यादयात् तत्तस्य प्राचीनत्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2002814, "chapter_id": 1062, "verse_number": "१-६३-१२", "content_sanskrit": "प्राचीन्वांस्तु खल्वाश्मकीमुपयेमे यादवीम्।\nतस्यामस्य जज्ञे शस्यातिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2002815, "chapter_id": 1062, "verse_number": "१-६३-१३", "content_sanskrit": "शय्यातिस्तु त्रिशङ्कोर्दुहितरं वराङ्गीं नामोपयेमे तस्यामस्य जज्ञेऽहंयातिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2002816, "chapter_id": 1062, "verse_number": "१-६३-१४", "content_sanskrit": "अहंयातिस्तु खलु कृतवीर्यदुहितरं भानुमतीं नामोपयेमे।\nतस्यामस्य जज्ञे सार्वभौमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2002817, "chapter_id": 1062, "verse_number": "१-६३-१५", "content_sanskrit": "सार्वभौमस्तु खलु जित्वाऽऽजहार कैकयीं सुन्दरां नाम तामुपयेमे।\nतस्यामस्य जज्ञे जयत्सेनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2002818, "chapter_id": 1062, "verse_number": "१-६३-१६", "content_sanskrit": "जयत्सेनस्तु खलु वैदर्भीमुपयेमे सुश्रवां नाम।\nतस्यामस्य जज्ञेऽपराचीनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2002819, "chapter_id": 1062, "verse_number": "१-६३-१७", "content_sanskrit": "अपराचीनस्तु खलु वैदर्भीमपरामुपयेमे मर्यादां नाम।\nतस्यामस्य जज्ञेऽरिहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2002820, "chapter_id": 1062, "verse_number": "१-६३-१८", "content_sanskrit": "अरिहः खल्वाङ्गीमुपेयेमे।\nतस्यामस्य जज्ञे महाभौमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2002821, "chapter_id": 1062, "verse_number": "१-६३-१९", "content_sanskrit": "महाभौमस्तु खलु प्रसेनजिद्दुहितरमुपयेमे सुयज्ञां नाम।\nतस्यामस्य जज्ञे अयुतानायी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2002822, "chapter_id": 1062, "verse_number": "१-६३-२०", "content_sanskrit": "यः पुरुषमेधे पुरुषाणामयुतमानयत्तत्तस्यायुतानायित्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2002823, "chapter_id": 1062, "verse_number": "१-६३-२१", "content_sanskrit": "अयुतानायी तु खलु पृथुश्रवसो दुहितरमुपयेमे भासां नाम।\nतस्यामस्य जज्ञेऽक्रोधनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2002824, "chapter_id": 1062, "verse_number": "१-६३-२२", "content_sanskrit": "अक्रोधनस्तु खलु कालिङ्गीं कण्डूं नामोपयेमे।\nतस्यामस्य जज्ञे देवातिथिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2002825, "chapter_id": 1062, "verse_number": "१-६३-२३", "content_sanskrit": "देवातिथिस्तु खलु वैदर्भीमुपयेमे मर्यादां नाम तस्यामस्य जज्ञे ऋचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2002826, "chapter_id": 1062, "verse_number": "१-६३-२४", "content_sanskrit": "ऋचस्तु खलु वामदेव्यामङ्गराजकन्यायामृक्षं पुत्रमजीजनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2002827, "chapter_id": 1062, "verse_number": "१-६३-२५", "content_sanskrit": "ऋक्षस्तु खलु तक्षकदुहितरं ज्वलन्तीं नामोपयेमे।\nतस्यामन्त्यनारमुत्पादयामास॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2002828, "chapter_id": 1062, "verse_number": "१-६३-२६", "content_sanskrit": "अन्त्यनारस्तु खलु सरस्वत्यां द्वादशवार्षिकं सत्रमाजहार।\nतमुदवसाने सरस्वत्यभिगम्य भर्तारं वरयामास॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2002829, "chapter_id": 1062, "verse_number": "१-६३-२७", "content_sanskrit": "तस्यां पुत्रं जनयामास त्रस्नुं नाम।\nअत्रानुवंशो भवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2002830, "chapter_id": 1062, "verse_number": "१-६३-२८", "content_sanskrit": "त्रस्नुं सरस्वती पुत्रमन्त्यनारादजीजनत्।\nइलिलं जनयामास कालिन्द्यांत्रस्नुरात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2002831, "chapter_id": 1062, "verse_number": "१-६३-२९", "content_sanskrit": "इलिलस्तु रथन्तर्यां दुष्यन्तादीन्पञ्च पुत्रानजीजनत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2002832, "chapter_id": 1062, "verse_number": "१-६३-३०", "content_sanskrit": "दुष्यन्तस्तु लाक्षीं नाम भागीरथीमुपयेमे तस्यामस्य जज्ञे जनमेजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2002833, "chapter_id": 1062, "verse_number": "१-६३-३१", "content_sanskrit": "सएव दुष्यन्तो विश्वामित्रदुहितरं शकुन्तलां नामोपयेमे।\nतस्यामस्य जज्ञे भरतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2002834, "chapter_id": 1062, "verse_number": "१-६३-३२", "content_sanskrit": "तत्रेमौ श्लोकौ भवतः।\nमाता भस्त्रा पितुः पुत्रो यस्माज्जातः स एव सः।\nभरस्व पुत्रं दौष्यन्तिं सत्यमाह शकुन्तला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2002835, "chapter_id": 1062, "verse_number": "१-६३-३३", "content_sanskrit": "रेतोधाः पुत्र उन्नयति नरदेव यमक्षयात्।\nत्वं चास्य धाता गर्भस्य सत्यमाह शकुन्तला॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2002836, "chapter_id": 1062, "verse_number": "१-६३-३४", "content_sanskrit": "ततोऽस्य भरतत्वम्।\nभरतस्तु खलु काशेयीं सार्वसेनीमुपयेमे सुनन्दां नाम।\nतस्यामस्य जज्ञे भुमन्युः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2002837, "chapter_id": 1062, "verse_number": "१-६३-३५", "content_sanskrit": "भुमन्युस्तु खलु दाशार्हीमुपयेमे सुवर्णां नाम।\nतस्यामस्य जज्ञे सुहोत्रः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2002838, "chapter_id": 1062, "verse_number": "१-६३-३६", "content_sanskrit": "सुहोत्रस्तु खल्वैक्ष्वाकीमुपयेमे जयन्तीं नाम।\nतस्यामस्य जज्ञे हस्ती।\nय इदं पुरं निर्मापयामास॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2002839, "chapter_id": 1062, "verse_number": "१-६३-३७", "content_sanskrit": "तस्माद्धास्तिनपुरत्वम्।\nहस्ती खलु त्रैगर्तीमुपयेमे यशोदां नाम तस्यामस्य जज्ञे विकुञ्जतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2002840, "chapter_id": 1062, "verse_number": "१-६३-३८", "content_sanskrit": "विकुञ्जनस्तु खलु दाशार्हीमुपयेमे सुन्दरां नाम।\nतस्यामस्य जज्ञेऽजमीढः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2002841, "chapter_id": 1062, "verse_number": "१-६३-३९", "content_sanskrit": "अजमीढस्य तु चतुर्विंशतिपुत्रशतं बभूव।\nकैकय्यां नागायां गान्धार्यां विमलायामृक्षायामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2002842, "chapter_id": 1062, "verse_number": "१-६३-४०", "content_sanskrit": "पृथग्वंशकर्तारो नृपतयः।\nतत्र अजमीढादृक्षायां संवरणो जज्ञे स वंशकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2002843, "chapter_id": 1062, "verse_number": "१-६३-४१", "content_sanskrit": "सवरणस्तु वैवस्वतीं तपतीं नामोपयेमे।\nतस्यामस्य जज्ञे कुरुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2002844, "chapter_id": 1062, "verse_number": "१-६३-४२", "content_sanskrit": "कुरुस्तु खलु दाशार्हीमुपयेमे शुभाङ्गीं नाम।\nतस्यामस्य जज्ञे विदूरथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2002845, "chapter_id": 1062, "verse_number": "१-६३-४३", "content_sanskrit": "विदूरथस्तु खलु मागधीमुपयेमे संप्रियां नाम।\nतस्यामस्य जज्ञेऽनश्वान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2002846, "chapter_id": 1062, "verse_number": "१-६३-४४", "content_sanskrit": "अनश्वांस्तु खलु मागधीमुपयेमेऽमृतां नाम।\nतस्यामस्य जज्ञे परिक्षित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2002847, "chapter_id": 1062, "verse_number": "१-६३-४५", "content_sanskrit": "परिक्षित्खलु बाहुकामुपयेमे सुवेषां नाम।\nतस्यामस्य जज्ञे भीमसेनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2002848, "chapter_id": 1062, "verse_number": "१-६३-४६", "content_sanskrit": "भीमसेनस्तु खलु कैकयीमुपयेमे सुकुमारीं नाम।\nतस्यामस्य जज्ञे परिश्रवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2002849, "chapter_id": 1062, "verse_number": "१-६३-४७", "content_sanskrit": "यमाहुः प्रतीप इति।\nप्रतीपस्तु खलु शैब्यामुपयेमे सुनन्दीं नाम।\nतस्यां त्रीन्पुत्रानुत्पादयामास देवापिं शन्तनुं बाह्लीकं चेति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2002850, "chapter_id": 1062, "verse_number": "१-६३-४८", "content_sanskrit": "देवापिस्तु खलु बाल एवारण्यं प्रविवेश।\nशन्तनुस्तु महीपालोऽभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2002851, "chapter_id": 1062, "verse_number": "१-६३-४९", "content_sanskrit": "तत्र श्लोको भवति।\nयं यं कराभ्यां स्पृशति जीर्णं स सुखमश्नुते।\nपुनर्युवा च भवति तस्मात्तं शन्तनुं विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2002852, "chapter_id": 1062, "verse_number": "१-६३-५०", "content_sanskrit": "तदस्य शन्तनुत्वं।\nशन्तनुस्तु खलु गङ्गां भागीरथीमुपयेमे तस्यामस्य जज्ञे देवव्रतः।\nयमाहुर्भीष्म इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2002853, "chapter_id": 1062, "verse_number": "१-६३-५१", "content_sanskrit": "भीष्मस्तु खलु पितुः प्रियचिकीर्षया सत्यवतीमानयामास मातरं।\nयामाहुः कालीति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2002854, "chapter_id": 1062, "verse_number": "१-६३-५२", "content_sanskrit": "तस्यां पूर्वं पुराशरात्कन्यागर्भो द्वैपायनः।\nतस्यामेव शन्तनोर्द्वौ पुत्रौ बभूवतुः चित्राङ्गदो विचित्रवीर्यश्च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2002855, "chapter_id": 1062, "verse_number": "१-६३-५३", "content_sanskrit": "चित्राङ्गदस्तु प्राप्तराज्य एव गन्धर्वेण निहृतः।\nततो विचित्रवीर्यो राजा बभूव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2002856, "chapter_id": 1062, "verse_number": "१-६३-५४", "content_sanskrit": "विचित्रवीर्यस्तु खलुकाशिराजस्य सुते अम्बिकाम्बालिके उदवहत्।\nविचित्रवीर्योऽनुत्पन्नापत्य एव विदेहत्वं प्राप्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2002857, "chapter_id": 1062, "verse_number": "१-६३-५५", "content_sanskrit": "ततः सत्यवती चिन्तयामास कथं नु खलु शन्तनोः पिण्डविच्छेदो न स्यादिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2002858, "chapter_id": 1062, "verse_number": "१-६३-५६", "content_sanskrit": "साथ द्वैपायनं चिन्तयामास सोऽग्रतः स्थितः किं करवाणीति।\nतं सत्यवत्युवाच भ्राता तेऽनपत्य एव स्वर्गतः तस्यार्थेऽपत्यमुत्पादयेति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2002859, "chapter_id": 1062, "verse_number": "१-६३-५७", "content_sanskrit": "स परमित्युवाच स तत्र त्रीन्पुत्रानुत्पादयामास धृतराष्ट्रं पाण्डुं विदुरं चेति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2002860, "chapter_id": 1062, "verse_number": "१-६३-५८", "content_sanskrit": "धृतराष्ट्रात्पुत्रशतं बभूव गान्धार्यां वरदानाद्द्वैपायनस्य तेषां च धार्तराष्ट्राणां चत्वारः प्रधानाः दुर्योधनो दुश्शासनो विकर्णश्चित्रसेनश्चेति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2002861, "chapter_id": 1062, "verse_number": "१-६३-५९", "content_sanskrit": "पाण्डोस्तु कुन्ती माद्रीति स्त्रीरत्ने बभूवतुः।\nस मृगयां चरन्मैथुनगतमृषिं मृगचारिणं बाणेन जघान॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2002862, "chapter_id": 1062, "verse_number": "१-६३-६०", "content_sanskrit": "स बाणविद्ध उवाच पाण्डुम्।\nअत्र श्लोको भवति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2002863, "chapter_id": 1062, "verse_number": "१-६३-६१", "content_sanskrit": "योऽकृतार्थं हि मां ग्रूर बाणेनाघ्ना मृगव्रतम्।\nत्वामप्येतादृशो भावः क्षिप्रमेवागमिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2002864, "chapter_id": 1062, "verse_number": "१-६३-६२", "content_sanskrit": "इति मृगव्रतचारिणा ऋषिणा शप्तः।\nस विषण्णरूपः पाण्डुस्तं शापं परिहरन्नोपसर्पति भार्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2002865, "chapter_id": 1062, "verse_number": "१-६३-६३", "content_sanskrit": "कदाचित्स आह।\nस्वचापल्यादिदं प्राप्तवानहम्।\nपुराणेषु पठ्यमानं शृणोमि नानपत्यस्य लोकाः सन्तीति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2002866, "chapter_id": 1062, "verse_number": "१-६३-६४", "content_sanskrit": "सा त्वं मदर्थे पुत्रानुत्पादयेति कुन्तीमुवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2002867, "chapter_id": 1062, "verse_number": "१-६३-६५", "content_sanskrit": "सा कुन्ती पुत्रानुत्पादयामास धर्माद्युधिष्ठिरं मारुताद्भीमसेनमिन्द्रादर्जुनमिति।\nस हृष्टरूपः पाण्डुरुवाच।\nइयं ते सपत्नी भवति माद्र्यनपत्या व्रीडिता साध्वी अस्यामपत्यमुत्पाद्यतामिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2002868, "chapter_id": 1062, "verse_number": "१-६३-६६", "content_sanskrit": "सा कुन्ती तस्यै माद्र्यै तथेति व्रतमादिदेश।\nततस्तस्यां नकुलसहदेवौ यमावश्विभ्यां जज्ञाते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2002869, "chapter_id": 1062, "verse_number": "१-६३-६७", "content_sanskrit": "माद्रीं तु खलु स्वलङ्कृतां दृष्ट्वा पाण्डुर्भावं चक्रे।\nस तां प्राप्यैव विदेहत्वं प्राप्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2002870, "chapter_id": 1062, "verse_number": "१-६३-६८", "content_sanskrit": "ततस्तेन सह चितामन्वारुरोह माद्री।\nकुन्तीं चोवाच यमयोरार्ययाऽप्रमत्तया भवितव्यमिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2002871, "chapter_id": 1062, "verse_number": "१-६३-६९", "content_sanskrit": "ततः पञ्चपाण्डवान्सह कुन्त्या हास्तिनपुरं नयन्ति स्म तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2002872, "chapter_id": 1062, "verse_number": "१-६३-७०", "content_sanskrit": "तत्र भीष्माय धृतराष्ट्रविदुरयोः पाण्डोः स्वर्गगमनं याथातथ्यं निवेदयन्तिस्म तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2002873, "chapter_id": 1062, "verse_number": "१-६३-७१", "content_sanskrit": "पाण्डवान्सह कुन्त्या जतुगृहे दाहयितुकामो धृतराष्ट्रात्मजोऽभूत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2002874, "chapter_id": 1062, "verse_number": "१-६३-७२", "content_sanskrit": "तांश्च विदुरो मोक्षयामास।\nततो भीमो हिडिम्बं हत्वा पुत्रमुत्पादयामास हिडिम्बायां घटोत्कचं नाम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2002875, "chapter_id": 1062, "verse_number": "१-६३-७३", "content_sanskrit": "ततश्चैकचक्रां जग्मुः कुशलिनः।\nततः पाञ्चालविषयं गत्वा स्वयंवरे द्रौपदीं लब्ध्वाऽर्धराज्यं प्राप्येन्द्रप्रस्थनिवासिनस्तस्यां पुत्रानुत्पादयामासुर्द्रौपद्याम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2002876, "chapter_id": 1062, "verse_number": "१-६३-७४", "content_sanskrit": "प्रतिविन्ध्यां युधिष्ठिरः।\nसुतसोमं वृकोदरः।\nश्रुतकीर्तिमर्जुनः।\nशतानीकं नकुलः।\nश्रुतसेनं सहदेव इति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2002877, "chapter_id": 1062, "verse_number": "१-६३-७५", "content_sanskrit": "शैव्यस्य कन्यां देवकीं नामोपयेमे युधिष्ठिरः।\nतस्यां पुत्रं जनयामास यौधेयं नाम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2002878, "chapter_id": 1062, "verse_number": "१-६३-७६", "content_sanskrit": "भीमसेनस्तु वाराणस्यां काशिराजकन्यां जलन्धरां नामोपयेमे स्वयंवरस्थां।\nतस्यामस्य जज्ञे शर्वत्रातः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2002879, "chapter_id": 1062, "verse_number": "१-६३-७७", "content_sanskrit": "अर्जुनस्तु खलु द्वारवतीं गत्वा भगवतो वासुदेवस्य भगिनीं सुभद्रां नामोदवहद्भार्यां।\nतस्यामभिमन्युं नाम पुत्रं जनयामास॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2002880, "chapter_id": 1062, "verse_number": "१-६३-७८", "content_sanskrit": "नकुलस्तु खलु चैद्यां रेणुमतीं नामोदवहत्।\nतस्यां पुत्रं जनयामास निरमित्रं नाम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2002881, "chapter_id": 1062, "verse_number": "१-६३-७९", "content_sanskrit": "सहदेवस्तु खलु माद्रीमेव स्वयंवरे विजयां नामोदवहद्भार्याम्।\nतस्यां पुत्रं जनयामास सुहोत्रं नाम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2002882, "chapter_id": 1062, "verse_number": "१-६३-८०", "content_sanskrit": "भीमसेनश्च पूर्वमेव हिडिम्बायां राक्षस्यां पुत्रमुत्पादयामास घटोत्कचं नाम।\nअर्जुनस्तु नागकन्यायामुलूप्यामिरावन्तं नाम पुत्रं जनयामास॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2002883, "chapter_id": 1062, "verse_number": "१-६३-८१", "content_sanskrit": "ततो मणलूरुपतिकन्यायां चित्राङ्गदायामर्जुनः पुत्रमुत्पादयामास बभ्रुवाहनं नाम।\nएते त्रयोदश पुत्राः पाण्डवानाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2002884, "chapter_id": 1062, "verse_number": "१-६३-८२", "content_sanskrit": "विराटस्य दुहितरमुत्तरां नामाभिमन्युरुपेयेमे।\nतस्यामस्य परासुर्गर्भोऽजायत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2002885, "chapter_id": 1062, "verse_number": "१-६३-८३", "content_sanskrit": "तमुत्सङ्गे प्रतिजग्राह पृथा नियोगात्पुरुषोत्तमस्य।\nषाण्मासिकं गर्भमहं जीवयामि पादस्पर्शादिति वासुदेव उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2002886, "chapter_id": 1062, "verse_number": "१-६३-८४", "content_sanskrit": "अहं जीवयामि कुमारमनन्तवीर्यं जात एवायमजायत।\nअभिमन्योः सत्येन चेयं पृथिवी धारयत्विति वासुदेवस्य पादस्पर्शात्सजीवोऽजायत।\nनाम तस्याकरोत्सुभद्रा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2002887, "chapter_id": 1062, "verse_number": "१-६३-८५", "content_sanskrit": "परिक्षीणे कुले जात उत्तरायां परंतपः।\nपरिक्षिदभवत्तस्मात्सौभद्रात्तु यशस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2002888, "chapter_id": 1062, "verse_number": "१-६३-८६", "content_sanskrit": "परीक्षित्तु खलु भद्रवतीं नामोपयेमे।\nतस्यां तत्र भवाञ्जनमेजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2002889, "chapter_id": 1062, "verse_number": "१-६३-८७", "content_sanskrit": "जनमेजयात्तु भवतः खलु वपुष्टमायां पुत्रौ द्वौ शतानीकः शङ्कुकर्णश्च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2002890, "chapter_id": 1062, "verse_number": "१-६३-८८", "content_sanskrit": "शतानीकस्तु खलु वैदेहीमुपयेमे।\nतस्यामस्य जज्ञे पुत्रोऽश्वमेधदत्तः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2002891, "chapter_id": 1062, "verse_number": "१-६३-८९", "content_sanskrit": "इत्येष पूरोर्वंशस्तु पाण्डवानां च कीर्तितः।\nपूरोर्वंशमिमं श्रुत्वा सर्वपापैः प्रमुच्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2002892, "chapter_id": 1062, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि अंशावतरणपर्वणि त्रिषष्टितमोऽध्यायः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}]