[{"id": 5000043000, "chapter_id": 9043, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे बालकाण्डे त्रिचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000043001, "chapter_id": 9043, "verse_number": "१-४३-१", "content_sanskrit": "देवदेवे गते तस्मिन् सोऽङ्गुष्ठाग्रनिपीडिताम् ।\nकृत्वा वसुमतीं राम वत्सरं समुपासत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000043002, "chapter_id": 9043, "verse_number": "१-४३-२", "content_sanskrit": "अथ संवत्सरे पूर्णे सर्वलोकनमस्कृतः ।\nउमापतिः पशुपती राजानमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000043003, "chapter_id": 9043, "verse_number": "१-४३-३", "content_sanskrit": "प्रीतस्तेऽहं नरश्रेष्ठ करिष्यामि तव प्रियम् ।\nशिरसा धारयिष्यामि शैलराजसुतामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000043004, "chapter_id": 9043, "verse_number": "१-४३-४", "content_sanskrit": "ततो हैमवती ज्येष्ठा सर्वलोकनमस्कृता ।\nतदा सातिमहद्रूपं कृत्वा वेगं च दुःसहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000043005, "chapter_id": 9043, "verse_number": "१-४३-५", "content_sanskrit": "आकाशादपतद् राम शिवे शिवशिरस्युत ।\nअचिन्तयच्च सा देवी गङ्गा परमदुर्धरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000043006, "chapter_id": 9043, "verse_number": "१-४३-६", "content_sanskrit": "विशाम्यहं हि पातालं स्त्रोतसा गृह्य शङ्करम् ।\nतस्यावलेपनं ज्ञात्वा क्रुद्धस्तु भगवान् हरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000043007, "chapter_id": 9043, "verse_number": "१-४३-७", "content_sanskrit": "तिरोभावयितुं बुद्धिं चक्रे त्रिनयनस्तदा ।\nसा तस्मिन् पतिता पुण्या पुण्ये रुद्रस्य मूर्धनि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000043008, "chapter_id": 9043, "verse_number": "१-४३-८", "content_sanskrit": "हिमवत्प्रतिमे राम जटामण्डलगह्वरे ।\nसा कथंचिन्महीं गन्तुं नाशक्नोद् यत्नमास्थिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000043009, "chapter_id": 9043, "verse_number": "१-४३-९", "content_sanskrit": "नैव सा निर्गमं लेभे जटामण्डलमन्ततः ।\nतत्रैवाबभ्रमद् देवी संवत्सरगणान् बहून् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000043010, "chapter_id": 9043, "verse_number": "१-४३-१०", "content_sanskrit": "तामपश्यत् पुनस्तत्र तपः परममास्थितः ।\nस तेन तोषितश्चासीदत्यन्तं रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000043011, "chapter_id": 9043, "verse_number": "१-४३-११", "content_sanskrit": "विससर्ज ततो गङ्गां हरो बिन्दुसरः प्रति ।\nतस्यां विसृज्यमानायां सप्त स्रोतांसि जज्ञिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000043012, "chapter_id": 9043, "verse_number": "१-४३-१२", "content_sanskrit": "ह्लादिनी पावनी चैव नलिनी च तथैव च ।\nतिस्रः प्राचीं दिशं जग्मुर्गङ्गाः शिवजलाः शुभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000043013, "chapter_id": 9043, "verse_number": "१-४३-१३", "content_sanskrit": "सुचक्षुश्चैव सीता च सिन्धुश्चैव महानदी ।\nतिस्रश्चैता दिशं जग्मुः प्रतीचीं तु दिशं शुभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000043014, "chapter_id": 9043, "verse_number": "१-४३-१४", "content_sanskrit": "सप्तमी चान्वगात् तासां भगीरथरथं तदा ।\nभगीरथोऽपि राजर्षिर्दिव्यं स्यंदनमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000043015, "chapter_id": 9043, "verse_number": "१-४३-१५", "content_sanskrit": "प्रायादग्रे महातेजा गङ्गा तं चाप्यनुव्रजत् ।\nगगनाच्छङ्करशिरस्ततो धरणिमागता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000043016, "chapter_id": 9043, "verse_number": "१-४३-१६", "content_sanskrit": "असर्पत जलं तत्र तीव्रशब्दपुरस्कृतम् ।\nमत्स्यकच्छपसङ्घैश्च शिंशुमारगणैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000043017, "chapter_id": 9043, "verse_number": "१-४३-१७", "content_sanskrit": "पतद्भिः पतितैश्चैव व्यरोचत वसुंधरा ।\nततो देवर्षिगन्धर्वा यक्षसिद्धगणास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000043018, "chapter_id": 9043, "verse_number": "१-४३-१८", "content_sanskrit": "व्यलोकयन्त ते तत्र गगनाद् गां गतां तदा ।\nविमानैर्नगराकारैर्हयैर्गजवरैस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000043019, "chapter_id": 9043, "verse_number": "१-४३-१९", "content_sanskrit": "पारिप्लवगताश्चापि देवतास्तत्र विष्ठिताः ।\nतदद्भुतमिमं लोके गङ्गावतरमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000043020, "chapter_id": 9043, "verse_number": "१-४३-२०", "content_sanskrit": "दिदृक्षवो देवगणाः समीयुरमितौजसः ।\nसम्पतद्भिः सुरगणैस्तेषां चाभरणौजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000043021, "chapter_id": 9043, "verse_number": "१-४३-२१", "content_sanskrit": "शतादित्यमिवाभाति गगनं गततोयदम् ।\nशिंशुमारोरगगणैर्मीनैरपि च चञ्चलैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000043022, "chapter_id": 9043, "verse_number": "१-४३-२२", "content_sanskrit": "विद्युद्भिरिव विक्षिप्तैराकाशमभवत् तदा ।\nपाण्डुरैः सलिलोत्पीडैः कीर्यमाणैः सहस्रधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000043023, "chapter_id": 9043, "verse_number": "१-४३-२३", "content_sanskrit": "शारदाभ्रैरिवाकीर्णं गगनं हंससम्प्लवैः ।\nक्वचिद् द्रुततरं याति कुटिलं क्वचिदायतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000043024, "chapter_id": 9043, "verse_number": "१-४३-२४", "content_sanskrit": "विनतं क्वचिदुद्भूतं क्वचिद् याति शनैः शनैः ।\nसलिलेनैव सलिलं क्वचिदभ्याहतं पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000043025, "chapter_id": 9043, "verse_number": "१-४३-२५", "content_sanskrit": "मुहुरूर्ध्वपथं गत्वा पपात वसुधां पुनः ।\nतच्छङ्करशिरोभ्रष्टं भ्रष्टं भूमितले पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000043026, "chapter_id": 9043, "verse_number": "१-४३-२६", "content_sanskrit": "व्यरोचत तदा तोयं निर्मलं गतकल्मषम् ।\nतत्रर्षिगणगन्धर्वा वसुधातलवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000043027, "chapter_id": 9043, "verse_number": "१-४३-२७", "content_sanskrit": "भवाङ्गपतितं तोयं पवित्रमिति पस्पृशुः ।\nशापात् प्रपतिता ये च गगनाद् वसुधातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000043028, "chapter_id": 9043, "verse_number": "१-४३-२८", "content_sanskrit": "कृत्वा तत्राभिषेकं ते बभूवुर्गतकल्मषाः ।\nधूपपापाः पुनस्तेन तोयेनाथ शुभान्विताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000043029, "chapter_id": 9043, "verse_number": "१-४३-२९", "content_sanskrit": "पुनराकाशमाविश्य स्वाँल्लोकान् प्रतिपेदिरे ।\nमुमुदे मुदितो लोकस्तेन तोयेन भास्वता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000043030, "chapter_id": 9043, "verse_number": "१-४३-३०", "content_sanskrit": "कृताभिषेको गङ्गायां बभूव गतकल्मषः ।\nभगीरथो हि राजर्षिर्दिव्यं स्यन्दनमास्थितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000043031, "chapter_id": 9043, "verse_number": "१-४३-३१", "content_sanskrit": "प्रायादग्रे महाराजास्तं गङ्गा पृष्ठतोऽन्वगात् ।\nदेवाः सर्षिगणाः सर्वे दैत्यदानवराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000043032, "chapter_id": 9043, "verse_number": "१-४३-३२", "content_sanskrit": "गन्धर्वयक्षप्रवराः सकिन्नरमहोरगाः ।\nसर्वाश्चाप्सरसो राम भगीरथरथानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000043033, "chapter_id": 9043, "verse_number": "१-४३-३३", "content_sanskrit": "गङ्गामन्वगमन् प्रीताः सर्वे जलचराश्च ये ।\nयतो भगीरथो राजा ततो गङ्गा यशस्विनी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000043034, "chapter_id": 9043, "verse_number": "१-४३-३४", "content_sanskrit": "जगाम सरितां श्रेष्ठा सर्वपापप्रणाशिनी ।\nततो हि यजमानस्य जह्नोरद्भुतकर्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000043035, "chapter_id": 9043, "verse_number": "१-४३-३५", "content_sanskrit": "गङ्गा सम्प्लावयामास यज्ञवाटं महत्मनः ।\nतस्यावलेपनं ज्ञात्वा क्रुद्धो जह्नुश्च राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000043036, "chapter_id": 9043, "verse_number": "१-४३-३६", "content_sanskrit": "अपिबत् तु जलं सर्वं गङ्गयाः परमाद्भुतम् ।\nततो देवाः सगन्घर्वा ऋषयश्च सुविस्मिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000043037, "chapter_id": 9043, "verse_number": "१-४३-३७", "content_sanskrit": "पूजयन्ति महात्मानं जह्नुं पुरुषसत्तमम् ।\nगङ्गां चापि नयन्ति स्म दुहितृत्वे महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000043038, "chapter_id": 9043, "verse_number": "१-४३-३८", "content_sanskrit": "ततस्तुष्टो महातेजाः श्रोत्राभ्यामसृजत् प्रभुः ।\nतस्माज्जह्नुसुता गङ्गा प्रोच्यते जाह्नवीति च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000043039, "chapter_id": 9043, "verse_number": "१-४३-३९", "content_sanskrit": "जगाम च पुनर्गङ्गा भगीरथरथानुगा ।\nसागरं चापि सम्प्रप्ता सा सरित्प्रवरा तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000043040, "chapter_id": 9043, "verse_number": "१-४३-४०", "content_sanskrit": "रसातलमुपागच्छत् सिद्ध्यर्थं तस्य कर्मणः ।\nभगीरथोऽपि राजार्षिर्गङ्गामादाय यत्नतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000043041, "chapter_id": 9043, "verse_number": "१-४३-४१", "content_sanskrit": "पितमहान् भस्मकृतानपश्यद् गतचेतनः ।\nअथ तद्भस्मनां राशिं गङ्गासलिलमुत्तमम् ।\nप्लावयत् पूतपाप्मानः स्वर्गं प्राप्ता रघूत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000043042, "chapter_id": 9043, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये बालकाण्डे त्रिचत्वारिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]