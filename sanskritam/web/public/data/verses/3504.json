[{"id": 2116367, "chapter_id": 3504, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2116368, "chapter_id": 3504, "verse_number": "१", "content_sanskrit": "राज्ञा कल्माषपादेन गुरौ ब्रह्मविदां वरे ।\nकारणं किं पुरस्कृत्य भार्या वै सन्नियोजिता\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2116369, "chapter_id": 3504, "verse_number": "२", "content_sanskrit": "जानता च परं धर्मं लौक्यं तेन महर्षिणा ।\nअगम्यागमनं कस्माद् वसिष्ठेन महात्मना ।\nकृतं तेन पुरा सर्वं वक्तुमर्हसि पृच्छतः \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2116370, "chapter_id": 3504, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2116371, "chapter_id": 3504, "verse_number": "३", "content_sanskrit": "धनञ्जय निबोधेदं यन्मां त्वं परिपृच्छसि ।\nवसिष्ठं प्रति दुर्धर्षं तथा मित्रसहं नृपम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2116372, "chapter_id": 3504, "verse_number": "४", "content_sanskrit": "कथितं ते मया सर्वं यथा शप्तः स पार्थिवः ।\nशक्तिना भरतश्रेष्ठ वासिष्ठेन महात्मना \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2116373, "chapter_id": 3504, "verse_number": "५", "content_sanskrit": "स तु शापवशं प्राप्तः क्रोधपर्याकुलेक्षणः ।\nनिर्जगाम पुराद् राजन् सहदारः परन्तपः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2116374, "chapter_id": 3504, "verse_number": "६", "content_sanskrit": "अरण्यं निर्जनं गत्वा सदारः परिचक्रमे ।\nनानामृगसमाकीर्णं नानापक्षिसमाकुलम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2116375, "chapter_id": 3504, "verse_number": "७", "content_sanskrit": "नानागुल्मलताच्छन्नं नानाद्रुमसमाकुलम् ।\nअरण्यं घोरसन्नादं शापग्रस्तः परिभ्रमन्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2116376, "chapter_id": 3504, "verse_number": "८", "content_sanskrit": "स कदाचित् क्षुधाऽऽविष्टो मृगयन् भक्ष्यमात्मनः ।\nददर्श सुपरिक्लिष्टः कस्मिंश्चिद् वननिर्झरे \t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2116377, "chapter_id": 3504, "verse_number": "९", "content_sanskrit": "ब्राह्मणं ब्राह्मणीं चैव मिथुनायोपसङ्गतौ ।\nतौ समीक्ष्य च सन्त्रस्तावकृतार्थौ प्रधावितौ \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2116378, "chapter_id": 3504, "verse_number": "१०", "content_sanskrit": "तयोः प्रद्रवतोर्विप्रं जगृहे नृपतिर्बलात् ।\nदृष्ट्वा गृहीतं भर्तारमथ ब्राह्मण्यभाषत \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2116379, "chapter_id": 3504, "verse_number": "११", "content_sanskrit": "शृणु राजन् वचो मह्यं यत् त्वां वक्ष्यामि सुव्रत ।\nआदित्यवंशप्रभवस्त्वं हि लोके च विश्रुतः \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2116380, "chapter_id": 3504, "verse_number": "१२", "content_sanskrit": "अप्रमत्तः स्थितो धर्मे गुरुशुश्रूषणे रतः ।\nशापं प्राप्तोऽसि दुर्धर्ष न पापं कर्तुमर्हसि \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2116381, "chapter_id": 3504, "verse_number": "१३", "content_sanskrit": "ऋतुकाले तु सम्प्राप्ते भर्त्राऽहं समुपागता ।\nअकृतार्थिन्यहं भद्र प्रसवार्थश्च मे भवेत् ।\nप्रसीद नृपतिश्रेष्ठ भर्ता मम विसृज्यताम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2116382, "chapter_id": 3504, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2116383, "chapter_id": 3504, "verse_number": "१४", "content_sanskrit": "एवं विक्रोशमाणायां तस्यां स सुनृशंसकृत् ।\nभर्तारं भक्षयामास व्याघ्रो मृगमिवेप्सितम् \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2116384, "chapter_id": 3504, "verse_number": "१५", "content_sanskrit": "तस्याः क्रोधाभिभूतायास्तत्राश्रूण्यपतन् भुवि ।\nसोऽग्निः समभवद् दीप्तः तं च देशं व्यदीपयत्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2116385, "chapter_id": 3504, "verse_number": "१६", "content_sanskrit": "ततः सा शोकसन्तप्ता भर्तृव्यसनदुःखिता ।\nकल्माषपादं राजर्षिमशपद् ब्राह्मणी रुषा \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2116386, "chapter_id": 3504, "verse_number": "१७", "content_sanskrit": "यस्मान्ममाकृतार्थायाः त्वया क्षुद्र नृशंसवत् ।\nप्रेक्षन्त्या भक्षितो मेऽद्य प्रभुर्भर्ता महायशाः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2116387, "chapter_id": 3504, "verse_number": "१८", "content_sanskrit": "तस्मात् त्वमपि दुर्बुद्धे मच्छापपरिविक्षतः ।\nपत्नीमृतावनुप्राप्य सम्यक् त्यक्षसि जीवितम् \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2116388, "chapter_id": 3504, "verse_number": "१९", "content_sanskrit": "तेन प्रसाद्यमाना सा प्रसादमकरोद् तदा ।\nयस्य चर्षेर्वसिष्ठस्य त्वया पुत्रा विनाशिताः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2116389, "chapter_id": 3504, "verse_number": "२०", "content_sanskrit": "तेन सङ्गत्य ते भार्या तनयं जनयिष्यति ।\nस ते वंशकरः पुत्रो भविष्यति नृपाधम \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2116390, "chapter_id": 3504, "verse_number": "", "content_sanskrit": "गन्धर्वः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2116391, "chapter_id": 3504, "verse_number": "२१", "content_sanskrit": "एवं शप्त्वा तु राजानं सा तदाऽऽङ्गिरसी शुभा ।\nतस्यैव सन्निधौ दीप्तं प्रविवेश हुताशनम् \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2116392, "chapter_id": 3504, "verse_number": "२२", "content_sanskrit": "वसिष्ठश्च महाभागः सर्वमेतदपश्यत ।\nज्ञानयोगेन महता तपसा च परन्तप \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2116393, "chapter_id": 3504, "verse_number": "२३", "content_sanskrit": "मुक्तशापश्च राजर्षिः कालेन महता ततः ।\nऋतुकाले निपतितो भार्यया सन्निवारितः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2116394, "chapter_id": 3504, "verse_number": "२४", "content_sanskrit": "न हि सस्मार नृपतिस्तं शापं काममोहितः ।\nदेव्याः सोऽथ वचः श्रुत्वा विसञ्ज्ञः समपद्यत \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2116395, "chapter_id": 3504, "verse_number": "२५", "content_sanskrit": "तं शापमनुसंस्मृत्य पर्यतप्यद् भृशं तदा ।\nएतस्मात् कारणाद् राजा वसिष्ठं सन्न्ययोजयत् \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2116396, "chapter_id": 3504, "verse_number": "२६", "content_sanskrit": "स्वदारे भरतश्रेष्ठ शापदोषसमन्वितः ।\nयदा कल्माषपादस्तु राक्षसत्वमवाप सः \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2116397, "chapter_id": 3504, "verse_number": "२७", "content_sanskrit": "तदा वसिष्ठः कुरुणा यज्ञार्थे स वृतोऽभवत् ।\nयदा कल्माषपादस्तु राक्षसत्वं विसृष्टवान् ।\nतदा तेनैव राज्ञा तु वसिष्ठः स वृतोऽभवत् \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2116398, "chapter_id": 3504, "verse_number": "१८३", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यामादिपर्वणि\nत्र्यशीत्यदधिकशततमोऽध्यायः ॥१८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2116399, "chapter_id": 3504, "verse_number": "१६", "content_sanskrit": "॥ इति चैत्ररथपर्वणि षोडशोऽध्यायः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2116400, "chapter_id": 3504, "verse_number": "", "content_sanskrit": "॥ चैत्ररथपर्व समाप्तम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]