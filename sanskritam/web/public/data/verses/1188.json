[{"id": 2009533, "chapter_id": 1188, "verse_number": "१-१८९-०x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009534, "chapter_id": 1188, "verse_number": "१-१८९-१", "content_sanskrit": "एवमुक्त्वा ततस्तूर्णं जगामोर्ध्वमनिन्दिता।\nतपतीतपतीत्येव विललापातुरो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009535, "chapter_id": 1188, "verse_number": "१-१८९-२", "content_sanskrit": "प्रास्स्वलच्चासकृद्राजा पुनरुत्थाय धावति।\nधावमानस्तु तपतीमदृष्ट्वैव महीपतिः।\nस तु राजा पुनर्भूमौ तत्रैव निपपात ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009536, "chapter_id": 1188, "verse_number": "१-१८९-३", "content_sanskrit": "अन्वेषमाणः सबलस्तं राजानं नृपोत्तमम्।\nअमात्यः सानुयात्रश्च तं ददर्श महावने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009537, "chapter_id": 1188, "verse_number": "१-१८९-४", "content_sanskrit": "क्षितौ निपतितं काले शक्रध्वजमिवोच्छ्रितम्।\nत हि दृष्ट्वा महेष्वासं निरस्तं पतितं भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009538, "chapter_id": 1188, "verse_number": "१-१८९-५", "content_sanskrit": "बभूव सोऽस्य सचिवः संप्रदीप्त इवाग्निना।\nत्वरया चोपसङ्गम्य स्नेहादागतसंभ्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009539, "chapter_id": 1188, "verse_number": "१-१८९-६", "content_sanskrit": "तं समुत्थापयामास नृपतिं काममोहितम्।\nभूतलाद्भूमिपालेशं पितेव पतितं सुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009540, "chapter_id": 1188, "verse_number": "१-१८९-७", "content_sanskrit": "प्रज्ञया वयसा चैव वृद्धः कीर्त्या नयेन च।\nअमात्यस्तं समुत्थाप्य बभूव विगतज्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009541, "chapter_id": 1188, "verse_number": "१-१८९-८", "content_sanskrit": "उवाच चैनं कल्याण्या वाचा मधुरयोत्थिम्।\nमा भैर्मनुजशार्दूल भद्रमस्तु तवानघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009542, "chapter_id": 1188, "verse_number": "१-१८९-९", "content_sanskrit": "क्षुत्पिपासापरिश्रान्तं तर्कयामास वै नृपम्।\nपतितं पातनं सङ्ख्ये शात्रवाणां महीतले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009543, "chapter_id": 1188, "verse_number": "१-१८९-१०", "content_sanskrit": "वारिणा च सुशीतेन शिरस्तस्याभ्यषेचयत्।\nअस्पृशन्मुकुटं राज्ञः पुण्डरीकसुगन्धिना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009544, "chapter_id": 1188, "verse_number": "१-१८९-११", "content_sanskrit": "ततः प्रत्यागतप्राणस्तद्बलं बलवान्नृपः।\nसर्वं विसर्जयामास तमेकं सचिवं विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009545, "chapter_id": 1188, "verse_number": "१-१८९-१२", "content_sanskrit": "ततस्तस्याज्ञया राज्ञो विप्रतस्थे महद्बलम्।\nस तु राजा गिरिप्रस्थे तस्मिन्पुनरुपाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009546, "chapter_id": 1188, "verse_number": "१-१८९-१३", "content_sanskrit": "ततस्तस्मिन् गिरिवरे शुचिर्भूत्वा कृताञ्जलिः।\nआरिराधयिषुः सूर्यं तस्थावूर्ध्वमुखः क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009547, "chapter_id": 1188, "verse_number": "१-१८९-१४", "content_sanskrit": "जगाम मनसा चैव वसिष्ठमृषिसत्तमम्।\nपुरोहितममित्रघ्नं तदा संवरणो नृपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009548, "chapter_id": 1188, "verse_number": "१-१८९-१५", "content_sanskrit": "नक्तन्दिनमथैकत्र स्थिते तस्मिञ्जनाधिपे।\nअथाजगाम विप्रर्षिस्तदा द्वादशमेऽहनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009549, "chapter_id": 1188, "verse_number": "१-१८९-१६", "content_sanskrit": "स विदित्वैव नृपतिं तपत्या हृतमानसम्।\nदिव्येन विधिना ज्ञात्वा भावितात्मा महानृपिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009550, "chapter_id": 1188, "verse_number": "१-१८९-१७", "content_sanskrit": "तथा तु नियतात्मानं तं नृपं मुनिसत्तमः।\nआबभाषे स धर्मात्मा तस्यैवार्थचिकीर्षया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009551, "chapter_id": 1188, "verse_number": "१-१८९-१८", "content_sanskrit": "स तस्य मनुजेन्द्रस्य पश्यतो भगवानृषिः।\nऊर्ध्वमाचक्रमे द्रष्टुं भास्करं भास्करद्युतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009552, "chapter_id": 1188, "verse_number": "१-१८९-१९", "content_sanskrit": "योजनानां तु नियुतं क्षणाद्गत्वा तपोधनः।\nसहस्रांशुं ततो विप्रः कृताञ्जलिरुपस्थितः।\nवसिष्ठोहमिति प्रीत्या स चात्मानं न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009553, "chapter_id": 1188, "verse_number": "१-१८९-२०", "content_sanskrit": "तमुवाच महातेजा विवस्वान्मुनिसत्तमम्।\nमहर्षे स्वागतं तेऽस्तु कथयस्व यथेप्सितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009554, "chapter_id": 1188, "verse_number": "१-१८९-२१", "content_sanskrit": "यदिच्छसि महाभाग मत्तः प्रवदतां वर।\nतत्ते दद्यामभिप्रेतं यद्यपि स्यात्सुदुर्लभम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009555, "chapter_id": 1188, "verse_number": "१-१८९-२२", "content_sanskrit": "एवमुक्तः स तेनर्षिर्वसिष्ठः संस्तुवन्गिरा।\nप्रणिपत्य विवस्वन्तं भानुमन्तमथाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009556, "chapter_id": 1188, "verse_number": "१-१८९-२३", "content_sanskrit": "योजनानां चतुष्षष्टिं निमेषात्त्रिशतं तथा।\nअश्वैर्गच्छति नित्यं यस्तत्पार्श्वस्थोऽब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009557, "chapter_id": 1188, "verse_number": "१-१८९-२४x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009558, "chapter_id": 1188, "verse_number": "१-१८९-२४", "content_sanskrit": "अजाय लोकत्रयपावनाय\nभूतात्मने गोपतये वृषाय।\nसूर्याय सर्गप्रलयालयाय\nनमो महाकारुणिकोत्तमाय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009559, "chapter_id": 1188, "verse_number": "१-१८९-२५", "content_sanskrit": "विवस्वते ज्ञानभृतेऽन्तरात्मने\nजगत्प्रदीपाय जगद्धितैषिणे।\nस्वयंभुवे दीप्तसहस्रचक्षुषे\nसुरोत्तमायामिततेजसे नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009560, "chapter_id": 1188, "verse_number": "१-१८९-२६", "content_sanskrit": "नमः सवित्रे जगदेकचक्षुषे\nजगत्प्रसूतिस्थितिनाशहेतवे।\nत्रयीमयाय त्रिगुणात्मधारिणे\nविरिञ्चनारायणशङ्करात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009561, "chapter_id": 1188, "verse_number": "१-१८९-२७x", "content_sanskrit": "सूर्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2009562, "chapter_id": 1188, "verse_number": "१-१८९-२७", "content_sanskrit": "संस्तुतो वरदः सोऽहं वरं वरय सुव्रत।\nस्तुतिस्त्वयोक्ता भक्तानां जप्येयं वग्दोस्म्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2009563, "chapter_id": 1188, "verse_number": "१-१८९-२८x", "content_sanskrit": "वसिष्ठ उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2009564, "chapter_id": 1188, "verse_number": "१-१८९-२८", "content_sanskrit": "यैषा ते तपती नाम सावित्र्यवरजा सुता।\nतां त्वां संवरणस्यार्थे वरयामि विभावसो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2009565, "chapter_id": 1188, "verse_number": "१-१८९-२९", "content_sanskrit": "स हि राजा बृहत्कीर्तिर्धर्मार्थविदुदारधीः।\nयुक्तः संवरणो भर्ता दुहितुस्ते विहङ्गम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2009566, "chapter_id": 1188, "verse_number": "१-१८९-३०x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2009567, "chapter_id": 1188, "verse_number": "१-१८९-३०", "content_sanskrit": "इत्युक्तः स तदा तेन ददानीत्येव निश्चितः।\nप्रत्यभाषत तं विप्रं प्रतीनन्द्य दिवाकरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2009568, "chapter_id": 1188, "verse_number": "१-१८९-३१", "content_sanskrit": "वरः संवरणो राज्ञां त्वमृषीणां वरो मुने।\nतपती योषितां श्रेष्ठा किमन्यत्रापवर्जनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2009569, "chapter_id": 1188, "verse_number": "१-१८९-३२", "content_sanskrit": "ततः सर्वानवद्याङ्गीं तपतीं तपनः स्वयम्।\nददौ संवरणस्यार्थे वसिष्ठाय महात्मने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2009570, "chapter_id": 1188, "verse_number": "१-१८९-३३", "content_sanskrit": "प्रतिजग्राह तां कन्यां महर्षिस्तपतीं तदा।\nवसिष्ठोऽथ विसृष्टस्तु पुनरेवाजगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2009571, "chapter_id": 1188, "verse_number": "१-१८९-३४", "content_sanskrit": "यत्र विख्यातकीर्तिः स कुरूणामृषभोऽभवत्।\nस राजा मन्मथाविष्टस्तद्गतेनान्तरात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2009572, "chapter_id": 1188, "verse_number": "१-१८९-३५", "content_sanskrit": "दृष्ट्वा च देवकन्यां तां तपतीं चारुहासिनीम्।\nवसिष्ठेन सहायान्तीं संहृष्टोऽभ्यधिकं बभौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2009573, "chapter_id": 1188, "verse_number": "१-१८९-३६", "content_sanskrit": "रुरुचे साऽधिकं सुभ्रूरापतन्ती नभस्तलात्।\nसौदामनीव विभ्रष्टा द्योतयन्ती दिशस्त्विषा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2009574, "chapter_id": 1188, "verse_number": "१-१८९-३७", "content_sanskrit": "कृच्छ्राद्द्वादशरात्रे तु तस्य राज्ञः समाहिते।\nआजगाम विशुद्धात्मा वसिष्ठो भगवानृषिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2009575, "chapter_id": 1188, "verse_number": "१-१८९-३८", "content_sanskrit": "तपसाऽऽराध्य वरदं देवं गोपतिमीश्वरम्।\nलेभे संवरणो भार्यां वसिष्ठस्यैव तेजसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2009576, "chapter_id": 1188, "verse_number": "१-१८९-३९", "content_sanskrit": "ततस्तस्मिन्गिरिश्रेष्ठे देवगन्धर्वसेविते।\nजग्राह विधिवत्पाणिं तपत्याः स नरर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2009577, "chapter_id": 1188, "verse_number": "१-१८९-४०", "content_sanskrit": "वसिष्ठेनाभ्यनुज्ञातस्तस्मिन्नेव धराधरे।\nसोऽकामयत राजर्षिर्विहर्तुं सह भार्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2009578, "chapter_id": 1188, "verse_number": "१-१८९-४१", "content_sanskrit": "ततः पुरे च राष्ट्रे च वनेषूपवनेषु च।\nआदिदेश महीपालस्तमेव सचिवं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2009579, "chapter_id": 1188, "verse_number": "१-१८९-४२", "content_sanskrit": "नृपतिं त्वभ्यनुज्ञाप्य वसिष्ठोऽथापचक्रमे।\nसोऽथ राजा गिरौ तस्मिन्विजहारामरो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2009580, "chapter_id": 1188, "verse_number": "१-१८९-४३", "content_sanskrit": "ततो द्वादशवर्षाणि काननेषु वनेषु च।\nरेमे तस्मिन्गिरौ राजा तयैव सह भार्यया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2009581, "chapter_id": 1188, "verse_number": "१-१८९-४४", "content_sanskrit": "तस्य राज्ञः पुरे तस्मिन्समा द्वादश सत्तम।\nन ववर्ष सहस्राक्षो राष्ट्रे चैवास्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2009582, "chapter_id": 1188, "verse_number": "१-१८९-४५", "content_sanskrit": "ततस्तस्यामनावृष्ट्यां प्रवृत्तायामरिन्दम।\nप्रजाः क्षयमुपाजग्मुः सर्वाः सस्थाणुजङ्गमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2009583, "chapter_id": 1188, "verse_number": "१-१८९-४६", "content_sanskrit": "तस्मिंस्तथाविधे काले वर्तमाने सुदारुणे।\nनावश्यायः पपातोर्व्यां ततः सस्यानि नाऽरुहन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2009584, "chapter_id": 1188, "verse_number": "१-१८९-४७", "content_sanskrit": "ततो विभ्रान्तमनसो जनाः क्षुद्भपीडिताः।\nगृहाणि संपरित्यज्य बभ्रमुः प्रदिशो दिशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2009585, "chapter_id": 1188, "verse_number": "१-१८९-४८", "content_sanskrit": "ततस्तस्मिन्पुरे राष्ट्रे त्यक्तदारपरिग्रहाः।\nपरस्परममर्यादाः क्षुधार्ता जघ्निरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2009586, "chapter_id": 1188, "verse_number": "१-१८९-४९", "content_sanskrit": "तत्क्षुधार्तैर्निरानन्दैः शवभूतैस्तथा नरैः।\nअभवत्प्रेतराजस्य पुरं प्रेतैरिवावृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2009587, "chapter_id": 1188, "verse_number": "१-१८९-५०", "content_sanskrit": "ततस्तत्तादृशं दृष्ट्वा स एव भगवानृषिः।\nअभ्याद्रवत धर्मात्मा वसिष्ठो मुनिसत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2009588, "chapter_id": 1188, "verse_number": "१-१८९-५१", "content_sanskrit": "तं च पार्थिवशार्दूलमानयामास तत्पुरम्।\nतपत्या सहितं राजन्वर्षे द्वादशमे गते।\nततः प्रवृष्टस्तत्रासीद्यथापूर्वं सुरारिहा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2009589, "chapter_id": 1188, "verse_number": "१-१८९-५२", "content_sanskrit": "तस्मिन्नृपतिशार्दूले प्रविष्टे नगरं पुनः।\nप्रववर्ष सहस्राक्षः सस्यानि जनयन्प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2009590, "chapter_id": 1188, "verse_number": "१-१८९-५३", "content_sanskrit": "ततः सराष्ट्रं मुमुदे तत्पुरं परया मुदा।\nतेन पार्थिवमुख्येन भावितं भावितात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2009591, "chapter_id": 1188, "verse_number": "१-१८९-५४", "content_sanskrit": "ततो द्वादश वर्षाणि पुनरीजे नराधिपः।\nतपत्या सहितः पत्न्या यथा शच्या मरुत्पतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2009592, "chapter_id": 1188, "verse_number": "१-१८९-५५x", "content_sanskrit": "गन्धर्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2009593, "chapter_id": 1188, "verse_number": "१-१८९-५५", "content_sanskrit": "एवमासीन्महाभागा तपती नाम पौर्विकी।\nतव वैवस्वती पार्थ तापत्यस्त्वं यया मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2009594, "chapter_id": 1188, "verse_number": "१-१८९-५६", "content_sanskrit": "तस्यां संजनयामास कुरुं संवरणो नृपः।\nतपत्यां तपतां श्रेष्ठ तापत्यस्त्वं ततोऽर्जुन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2009595, "chapter_id": 1188, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि चैत्ररथपर्वणि एकोननवत्यधिकशततमोऽध्यायः॥ १८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}]