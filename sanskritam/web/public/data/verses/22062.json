[{"id": 7002062000, "chapter_id": 22062, "verse_number": "१०७-१", "content_sanskrit": "अग्निरुवाच ।\nवक्ष्ये भुवनकोषञ्च पृथ्वीद्वीपादिलक्षणं ।\nअग्निध्रश्चाग्निबाहुश्च वपुष्मान्द्युतिमांस्तथा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002062001, "chapter_id": 22062, "verse_number": "१०७-२", "content_sanskrit": "मेधा मेधातिथिर्भव्यः सवनः पुत्र एव च ।\nज्योतिष्मान् दशमस्तेषां सत्यनामा सुतोऽभवत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002062002, "chapter_id": 22062, "verse_number": "१०७-३", "content_sanskrit": "प्रियव्रतसुताः ख्याताः सप्तद्वीपान्ददौ पिता ।\nजम्बुद्वीपमथाग्नीध्रे प्लक्षं मेधातिथेर्ददौ ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002062003, "chapter_id": 22062, "verse_number": "१०७-४", "content_sanskrit": "वपुष्मते शाल्मलञ्च ज्योतिष्मते कुशाह्वयं ।\nक्रौञ्चद्वीपं द्युतिमते शाकं भव्याय दत्तवान् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002062004, "chapter_id": 22062, "verse_number": "१०७-५", "content_sanskrit": "पुष्करं सवनायादादग्नीध्रेऽदात्सुते शतं ।\nजम्बूद्वीपं पिता लक्षं नाभेर्दत्तं हिमाह्वयं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002062005, "chapter_id": 22062, "verse_number": "१०७-६", "content_sanskrit": "हेमकूटं किम्पुरुषे हरिवर्षाय नैषधं ।\nइलावृते मेरुमध्ये रम्ये नीलाचलश्रितं ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002062006, "chapter_id": 22062, "verse_number": "१०७-७", "content_sanskrit": "हिरण्वते श्वेतवर्षं कुरूंस्तु कुरवे ददौ ।\nभद्राश्वाय च भद्राश्वं केतुमालाय पश्चिमं ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002062007, "chapter_id": 22062, "verse_number": "१०७-८", "content_sanskrit": "मेरोः प्रियव्रतः पुत्रानभिषिच्य ययौ वनं ।\nशालग्रामे तपस्तप्त्वा ययौ विष्णोर्लयं नृपः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002062008, "chapter_id": 22062, "verse_number": "१०७-९", "content_sanskrit": "यानि कुम्पुरुषाद्यानि ह्यष्टवर्षाणि सत्तम ।\nतेषां स्वाभाविकी सिद्धिः सुखप्राया ह्ययत्नतः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002062009, "chapter_id": 22062, "verse_number": "१०७-१०", "content_sanskrit": "जरामृत्युभयं नास्ति धर्माधर्मौ युगादिकं ।\nनाधमं मध्यमन्तुल्या हिमाद्देशात्तु नाभितः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002062010, "chapter_id": 22062, "verse_number": "१०७-११", "content_sanskrit": "ऋषभो मेरुदेव्याञ्च ऋषभाद्भरतोऽभवत् ।\nऋषभो दत्तश्रीः पुत्रे शालग्रामे हरिङ्गतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002062011, "chapter_id": 22062, "verse_number": "१०७-१२", "content_sanskrit": "भरताद्भारतं वर्षं भरतात्सुमतिस्त्वभूत् ।\nभरतो दत्तलक्ष्मीकः शालग्रामे हरिं गतः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002062012, "chapter_id": 22062, "verse_number": "१०७-१३", "content_sanskrit": "स योगी योगप्रस्तावे वक्ष्ये तच्चरितं पुनः ।\nसुमतेस्तेजसस्तस्मादिन्द्रद्युम्नो व्यजायत ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002062013, "chapter_id": 22062, "verse_number": "१०७-१४", "content_sanskrit": "परमेष्ठी ततस्तस्मात्प्रतीहारस्तदन्वयः ।\nप्रतीहारात्प्रतीहर्ता प्रतिहर्तुर्भुवस्ततः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002062014, "chapter_id": 22062, "verse_number": "१०७-१५", "content_sanskrit": "उद्गीतोथ च प्रस्तारो विभुः प्रस्तारतः सुतः ।\nपृथुश्चैव ततो नक्तो नक्तस्यापि गयः सुतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002062015, "chapter_id": 22062, "verse_number": "१०७-१६", "content_sanskrit": "नरो गयस्य तनयः तत्पुत्रोऽभूद्विराट्ततः ।\nतस्य पुत्रो महावीर्यो धीमांस्तस्मादजायत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002062016, "chapter_id": 22062, "verse_number": "१०७-१७", "content_sanskrit": "महान्तस्तत्सुतश्चाभून्मनस्यस्तस्य चात्मजः ।\nत्वष्टा त्वष्टुश्च विरजा रजस्तस्याप्यभूत्सुतः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002062017, "chapter_id": 22062, "verse_number": "१०७-१८", "content_sanskrit": "सत्यजिद्रजसस्तस्य जज्ञे पुत्रशतं मुने ।\nविश्वज्योतिःप्रधानास्ते भारतन्तैर्विवर्धितं ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}]