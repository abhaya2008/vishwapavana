[{"id": 7003832000, "chapter_id": 23832, "verse_number": "२-४-१९-१", "content_sanskrit": "नारद उवाच ।\nते गणाधिपतीन्दृष्ट्वा नंदीभमुखषण्मुखान् ।\nअमर्षादभ्यधावंत द्वंद्वयुद्धाय दानवाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003832001, "chapter_id": 23832, "verse_number": "२-४-१९-२", "content_sanskrit": "नंदिनं कालनेमिश्च शुम्भो लंबोदरं तथा ।\nनिशुम्भः षण्मुखं वेगादभ्यधावत दंशितः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003832002, "chapter_id": 23832, "verse_number": "२-४-१९-३", "content_sanskrit": "निशुम्भः कार्तिकेयस्य मयूरं पंचभिः शरैः ।\nहृदि विव्याध वेगेन मूर्च्छितः स पपात च ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003832003, "chapter_id": 23832, "verse_number": "२-४-१९-४", "content_sanskrit": "ततः शक्तिधरः शक्तिं यावज्जग्राह रोषितः ।\nतावन्निशुंभो वेगेन स्वशक्त्या तमपातयत् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003832004, "chapter_id": 23832, "verse_number": "२-४-१९-५", "content_sanskrit": "नंदीश्वरः शरव्रातैः कालनेमिमवध्यत ।\nसप्तभिश्च हयान्केतुं त्रिभिः सारथिमच्छिनत् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003832005, "chapter_id": 23832, "verse_number": "२-४-१९-६", "content_sanskrit": "कालनेमिस्तु संक्रुद्धो धनुश्चिच्छेद नंदिनः ।\nतदपास्य स शूलेन तं वक्षस्यहनद्बली ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003832006, "chapter_id": 23832, "verse_number": "२-४-१९-७", "content_sanskrit": "स शूलभिन्नहृदयो हताश्वो हतसारथिः ।\nअद्रेः शिखरमामुच्य शैलादिं सोऽप्यपातयत् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003832007, "chapter_id": 23832, "verse_number": "२-४-१९-८", "content_sanskrit": "अथ शुम्भो गणेशश्च रथमूषकवाहनौ ।\nयुध्यमानौ शरव्रातैः परस्परमविध्यताम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003832008, "chapter_id": 23832, "verse_number": "२-४-१९-९", "content_sanskrit": "गणेशस्तु तदा शुम्भं हृदि विव्याध पत्रिणा ।\nसारथिं च त्रिभिर्बाणैः पातयामास भूतले ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003832009, "chapter_id": 23832, "verse_number": "२-४-१९-१०", "content_sanskrit": "ततोऽतिक्रुद्धः शुम्भोऽपि बाणषष्ट्या गणाधिपम् ।\nमूषकं च त्रिभिर्विद्ध्वा ननाद जलदस्वनः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003832010, "chapter_id": 23832, "verse_number": "२-४-१९-११", "content_sanskrit": "मूषकः शरभिन्नांगश्चचाल दृढवेदनः ।\nलंबोदरश्च पतितः पदातिरभवन्नृप ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003832011, "chapter_id": 23832, "verse_number": "२-४-१९-१२", "content_sanskrit": "ततो लंबोदरः शुम्भं हत्वा परशुना हृदि ।\nअपातयत्तदा भूमौ मूषकं चारुहत्पुनः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003832012, "chapter_id": 23832, "verse_number": "२-४-१९-१३", "content_sanskrit": "कालनेमिर्निशुंभश्चाऽप्युभौ लंबोदरं शरैः ।\nयुगपज्जघ्नतुः क्रोधात्तोत्रैरिव महाद्विपम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003832013, "chapter_id": 23832, "verse_number": "२-४-१९-१४", "content_sanskrit": "तं पीडयमानमालोक्य वीरभद्रो महाबलः ।\nअभ्यधावत वेगेन भूतकोटियुतस्तदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003832014, "chapter_id": 23832, "verse_number": "२-४-१९-१५", "content_sanskrit": "कूष्मांडभैरवाश्चाऽपि वेताला योगिनीगणाः ।\nपिशाचयोगिनीसंघा गणाश्चाऽपि तमन्वयुः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003832015, "chapter_id": 23832, "verse_number": "२-४-१९-१६", "content_sanskrit": "ततः किलकिलाशब्दैः सिंहनादैः सुघर्घरैः ।\nभेरीतालमृदंगैश्च पृथिवी समकंपत ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003832016, "chapter_id": 23832, "verse_number": "२-४-१९-१७", "content_sanskrit": "ततो भूतान्यधावंत भक्षयंतिस्म दानवान् ।\nउत्पतंत्यापतंति स्म ननृतुश्च रणांगणे ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003832017, "chapter_id": 23832, "verse_number": "२-४-१९-१८", "content_sanskrit": "नन्दी च कार्तिकेयश्च समाश्वस्य त्वरत्वितौ ।\nनिजघ्नतू रणे दैत्यान्निरंतरशरव्रजैः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003832018, "chapter_id": 23832, "verse_number": "२-४-१९-१९", "content_sanskrit": "छिन्नभिन्ना हतैर्देत्यैः पतितैर्भक्षितैस्तदा ।\nव्याकुला साऽभवत्सेना विषण्णवदना तदा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003832019, "chapter_id": 23832, "verse_number": "२-४-१९-२०", "content_sanskrit": "प्रविध्वस्तां तदा सेनां दृष्ट्वा सागरनंदनः ।\nरथेनाऽतिपताकेन गणानभिययौ बली ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003832020, "chapter_id": 23832, "verse_number": "२-४-१९-२१", "content_sanskrit": "हस्त्यश्वरथसंह्रादाः शंखभेरीस्वनास्तथा ।\nअभवन्सिंहनादाश्च सेनयोरुभयोस्तदा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003832021, "chapter_id": 23832, "verse_number": "२-४-१९-२२", "content_sanskrit": "जलंधरशरव्रातैर्नीहारपटलैरिव ।\nद्यावापृथिव्योराच्छिन्नमंतरं समपद्यत ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003832022, "chapter_id": 23832, "verse_number": "२-४-१९-२३", "content_sanskrit": "गणेशं पंचभिर्विद्ध्वा शैलादिं नवभिः शरैः ।\nवीरभद्रं च विंशत्या ननाद जलदस्वनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003832023, "chapter_id": 23832, "verse_number": "२-४-१९-२४", "content_sanskrit": "कार्तिकेयस्तदा दैत्यं शक्त्या विव्याध सत्वरः ।\nयुयुधे शक्तिनिर्भिन्नः किंचिद्व्याकुलमानसः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003832024, "chapter_id": 23832, "verse_number": "२-४-१९-२५", "content_sanskrit": "ततः क्रोधपरीताक्षः कार्तिकेयं जलंधरः ।\nगदया ताडयामास स च भूमितलेऽपतत् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003832025, "chapter_id": 23832, "verse_number": "२-४-१९-२६", "content_sanskrit": "तथैव नंदिनं वेगादपातयत भूतले ।\nततो गणेश्वरः क्रुद्धो गदां परशुनाऽहनत् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003832026, "chapter_id": 23832, "verse_number": "२-४-१९-२७", "content_sanskrit": "वीरभद्रस्त्रिभिर्बाणैर्हृदि विव्याध दानवम् ।\nसप्तभिश्च हयान्केतुं धनुश्छत्रं च चिच्छिदे ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003832027, "chapter_id": 23832, "verse_number": "२-४-१९-२८", "content_sanskrit": "ततोऽतिक्रुद्धो दैत्येंद्रः शक्तिमुद्यम्य दारुणाम् ।\nगणेशं पातयामास रथं चाऽन्यमथाऽरुहत् ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003832028, "chapter_id": 23832, "verse_number": "२-४-१९-२९", "content_sanskrit": "अभ्ययादथ वेगेन वीरभद्रं रुषान्वितः ।\nततस्तौ सूर्यसंकाशौ युयुधाते परस्परम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003832029, "chapter_id": 23832, "verse_number": "२-४-१९-३०", "content_sanskrit": "वीरभद्रः पुनस्तस्य हयान्बाणैरपातयत् ।\nधनुश्चिच्छेद दैत्येंद्रः पुप्लुवे परिघायुधः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003832030, "chapter_id": 23832, "verse_number": "२-४-१९-३१", "content_sanskrit": "स वीरभद्रं त्वरयाऽभिगम्य जघान दैत्यः परिघेण मूर्ध्नि ।\nस चाऽपि वीरः प्रविभिन्नमूर्द्धा पपात भूमौ रुधिरं समुद्गिरन् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003832031, "chapter_id": 23832, "verse_number": "२-४-१९-३२", "content_sanskrit": "इति श्रीस्कान्दे महापुराण एकाशीतिसाहस्र्यां संहितायां द्वितीये वैष्णवखण्डे कार्तिकमासमाहात्म्ये जलंधरोपाख्याने वीरभद्रपतननामैकोनविंशोऽध्यायः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]