[{"id": 2162955, "chapter_id": 4518, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2162956, "chapter_id": 4518, "verse_number": "१", "content_sanskrit": "महानपनयः सूत ममैवात्र विशेषतः ।\nस इदानीमनुप्राप्तो मन्ये सञ्जय शोचतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2162957, "chapter_id": 4518, "verse_number": "२", "content_sanskrit": "यद्गतं तद्गतमिति ममासीन्मनसि स्थितम् ।\nइदानीमत्र किं कार्यं प्रकरिष्यामि सञ्जय\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2162958, "chapter_id": 4518, "verse_number": "३", "content_sanskrit": "यथा त्वेष क्षयो वृत्तो ममापनयसम्भवः ।\nवीराणां तन्ममाचक्ष्व स्थिरीभूतोऽस्मि सञ्जय\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2162959, "chapter_id": 4518, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2162960, "chapter_id": 4518, "verse_number": "४", "content_sanskrit": "कर्णभीमौ महाराज पराक्रान्तौ महाहवे ।\nबाणवर्षाण्यवर्षेतां वृष्टिमन्ताविवाम्बुदौ\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2162961, "chapter_id": 4518, "verse_number": "५", "content_sanskrit": "भीमनामाङ्किता बाणाः स्वर्णपुङ्खाः शिलाशिताः ।\nविविशुः कर्णमासाद्य भिन्दन्त इव जीवितम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2162962, "chapter_id": 4518, "verse_number": "६", "content_sanskrit": "तथैव कर्णनिर्मुक्तैः सविषैरिव पन्नगैः ।\nआकीर्यत रणे भीमः शतशोऽथ सहस्रशः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2162963, "chapter_id": 4518, "verse_number": "७", "content_sanskrit": "तयोः शरैर्महाराज सम्पतद्भिः समन्ततः ।\nबभूव तव सैन्यानां सङ्क्षोभः सागरोपमः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2162964, "chapter_id": 4518, "verse_number": "८", "content_sanskrit": "भीमचापच्युतैर्बाणैस्तव सैन्यमरिन्दम ।\nअवध्यत चमूमध्ये घोरैराशीविषोपमैः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2162965, "chapter_id": 4518, "verse_number": "९", "content_sanskrit": "वारणैः पतितै राजन् वाजिभिश्च नरैः सह ।\nअदृश्यत मही कीर्णा वातनुन्नैर्द्रुमैरिव\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2162966, "chapter_id": 4518, "verse_number": "१०", "content_sanskrit": "ते वध्यमानाः समरे भीमचापच्युतैः शरैः ।\nप्राद्रवंस्तावका योधाः किमेतदिति चाब्रुवन्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2162967, "chapter_id": 4518, "verse_number": "११", "content_sanskrit": "ततो व्युदस्तं तत् सैन्यं सिन्धुसौवीरकौरवम् ।\nप्रोत्सारितं महावेगैः कर्णपाण्डवयोः शरैः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2162968, "chapter_id": 4518, "verse_number": "१२", "content_sanskrit": "ते शरातुरभूयिष्ठा हताश्वनरवाहनाः ।\nउत्सृज्य कर्णं भीमं च प्राद्रवन् सर्वतोदिशम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2162969, "chapter_id": 4518, "verse_number": "१३", "content_sanskrit": "नूनं पार्थार्थमेवास्मान् मोहयन्ति दिवौकसः ।\nयत् कर्णभीमप्रभवैर्वध्यते नो बलं शरैः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2162970, "chapter_id": 4518, "verse_number": "१४", "content_sanskrit": "एवं ब्रुवन्तो योधास्ते तावका भयपीडिताः ।\nशरपातं समुत्सृज्य स्थिता युद्धदिदृक्षवः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2162971, "chapter_id": 4518, "verse_number": "१५", "content_sanskrit": "ततः प्रावर्तत नदी घोररूपा महाहवे ।\nबभूव च विशेषेण भीरूणां भयवर्धिनी\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2162972, "chapter_id": 4518, "verse_number": "१६", "content_sanskrit": "वारणाश्वमनुष्याणां रुधिरौघसमुद्भवा ।\nसंवृता गतसत्त्वैश्च मनुष्यगजवाजिभिः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2162973, "chapter_id": 4518, "verse_number": "१७", "content_sanskrit": "सानुकर्षपताकैश्च द्विपाश्वरथभूषणैः ।\nस्यन्दनैरपविद्धैश्च भग्नचक्राक्षकूबरैः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2162974, "chapter_id": 4518, "verse_number": "१८", "content_sanskrit": "जातरूपपरिष्कारैर्धनुर्भिः सुमहाधनैः ।\nसुवर्णपुङ्खैरिषुभिर्नाराचैश्च सहस्रशः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2162975, "chapter_id": 4518, "verse_number": "१९", "content_sanskrit": "कर्णपाण्डवनिर्मुक्तैर्निर्मुक्तैरिव पन्नगैः ।\nप्रासतोमरसङ्घातैः खड्गैश्च सपरश्वधैः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2162976, "chapter_id": 4518, "verse_number": "२०", "content_sanskrit": "सुवर्णविकृतैश्चापि गदामुसलपट्टिशैः ।\nवज्रैश्च विविधाकारैः शक्तिभिः परिघैरपि ।\nशतघ्नीभिश्च चित्राभिर्बभौ भारत मेदिनी\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2162977, "chapter_id": 4518, "verse_number": "२१", "content_sanskrit": "कनकाङ्गदकेयूरैः कुण्डलैर्मणिभिः शुभैः ।\nतनुत्रैः सतळत्रैश्च हारैर्निष्कैश्च भारत\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2162978, "chapter_id": 4518, "verse_number": "२२", "content_sanskrit": "वस्त्रैश्छत्रैश्च विध्वस्तैश्चामरव्यजनैरपि ।\nगजाश्वमनुजैर्भिन्नैः शस्त्रैः स्यन्दनभूषणैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2162979, "chapter_id": 4518, "verse_number": "२३", "content_sanskrit": "तैस्तैश्च विविधैर्भावैस्तत्र तत्र वसुन्धरा ।\nपतितैरपविद्धैश्च सम्बभौ द्यौरिव ग्रहैः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2162980, "chapter_id": 4518, "verse_number": "२४", "content_sanskrit": "अचिन्त्यमद्भुतं चैव तयोः कर्मातिमानुषम् ।\nदृष्ट्वा चारणसिद्धानां विस्मयः समपद्यत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2162981, "chapter_id": 4518, "verse_number": "२५", "content_sanskrit": "अग्नेर्वायुसहायस्य गतिः कक्ष इवाहवे ।\nआसीद् भीमसहायस्य रौद्रमाधिरथेर्गतम् ।\nनिपातितध्वजरथं हतवाजिनरद्विपम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2162982, "chapter_id": 4518, "verse_number": "२६", "content_sanskrit": "गजाभ्यां सम्प्रयुक्ताभ्यामासीन्नडवनं यथा ।\nतथाभूतं महत् सैन्यमासीद् भारत संयुगे ।\nविमर्दः कर्णभीमाभ्यामासीच्च परमो रणे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2162983, "chapter_id": 4518, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि त्रयोविंशत्यधिकशततमोऽध्यायः ॥ १२३ ॥\nजयद्रथवधपर्वणि सप्तचत्वारिंशोऽध्यायः ॥ ४७ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]