[{"id": 2130329, "chapter_id": 3810, "verse_number": "", "content_sanskrit": "भीमसेनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2130330, "chapter_id": 3810, "verse_number": "१", "content_sanskrit": "पूर्वरूपमदृष्ट्वा ते न यास्यामि कथञ्चन ।\nयदि तेऽहमनुग्राह्यो दर्शयात्मानमात्मना\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2130331, "chapter_id": 3810, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2130332, "chapter_id": 3810, "verse_number": "२", "content_sanskrit": "एवमुक्तस्तु भीमेन स्मितं कृत्वा प्लवङ्गमः ।\nतद्रूपं दर्शयामास यद्वै सागरलङ्घने\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2130333, "chapter_id": 3810, "verse_number": "३", "content_sanskrit": "भ्रातुः प्रियमभीप्सन् वै चकार सुमहद् वपुः ।\nतद्रूपं यत्पुरा तस्य बभूवौदधिलङ्घने\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2130334, "chapter_id": 3810, "verse_number": "४", "content_sanskrit": "देहस्तस्य ततोऽतीव वर्धत्यायामविस्तरैः ।\nसद्रुमं कदलीषण्डं छादयन्नमितद्युतिः ।\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2130335, "chapter_id": 3810, "verse_number": "५", "content_sanskrit": "गिरेश्चोच्छ्रयमाक्रम्य तस्थौ तत्र च वानरः ।\nसमुच्छ्रितमहाकायो द्वितीय इव पर्वतः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2130336, "chapter_id": 3810, "verse_number": "६", "content_sanskrit": "ताम्रेक्षणस्तीक्ष्णदंष्ट्रो भ्रुकुटीकुटिलाननः ।\nदीर्घलाङ्गूलमाविध्य दिशो व्याप्य स्थितः कपिः \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2130337, "chapter_id": 3810, "verse_number": "७", "content_sanskrit": "तद्रूपं महदालक्ष्य भ्रातुः कौरवनन्दनः ।\nविसिस्मिये तदा भीमो जहृषे च पुनः पुनः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2130338, "chapter_id": 3810, "verse_number": "८", "content_sanskrit": "तमर्कमिव तेजोभिः सौवर्णमिव पर्वतम् ।\nप्रदीप्तमिव चाकाशं दृष्ट्वा भीमो न्यमीलयत्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2130339, "chapter_id": 3810, "verse_number": "९", "content_sanskrit": "आबभाषे च हनूमान् भीमसेनं स्मयन्निव ।\nएतावदिह शक्तस्त्वं द्रष्टुं रूपं ममानघ \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2130340, "chapter_id": 3810, "verse_number": "१०", "content_sanskrit": "वर्धेऽहं चाप्यतो भूयो यावन्मे मनसि स्थितम्।\nभीम शत्रुषु चात्यर्थं वर्धते मूर्तिरोजसा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2130341, "chapter_id": 3810, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2130342, "chapter_id": 3810, "verse_number": "११", "content_sanskrit": "तदद्भुतं महारौद्रं विन्ध्यपर्वतसन्निभम् ।\nदृष्ट्वा हनूमतो वर्ष्म सम्भ्रान्तः पवनात्मजः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2130343, "chapter_id": 3810, "verse_number": "१२", "content_sanskrit": "प्रत्युवाच ततो भीमः सम्प्रहृष्टतनूरुहः ।\nकृताञ्जलिरदीनात्मा हनूमन्तमवस्थितम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2130344, "chapter_id": 3810, "verse_number": "१३", "content_sanskrit": "दृष्टं प्रमाणं विपुलं शरीरस्यास्य ते विभो ।\nसंहरस्व महावीर्य स्वयमात्मानमात्मना\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2130345, "chapter_id": 3810, "verse_number": "१४", "content_sanskrit": "न हि शक्नोमि त्वां द्रष्टुं दिवाकरमिवोदितम् ।\nअप्रमेयमनाधृष्यं मैनाकमिव पर्वतम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2130346, "chapter_id": 3810, "verse_number": "१५", "content_sanskrit": "विस्मयश्चैव मे वीर सुमहान् मनसोऽद्य वै ।\nयद् रामस्त्वयि पार्श्वस्थे स्वयं रावणमभ्यगात्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2130347, "chapter_id": 3810, "verse_number": "१६", "content_sanskrit": "त्वमेव शक्तस्तां लङ्कां सयोधां सहवाहनाम् ।\nस्वबाहुबलमाश्रित्य विनाशयितुमञ्जसा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2130348, "chapter_id": 3810, "verse_number": "१७", "content_sanskrit": "न हि ते किञ्चिदप्राप्यं मारुतात्मज विद्यते।\nतव नैकस्य पर्याप्तो रावणः सगणो युधि\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2130349, "chapter_id": 3810, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2130350, "chapter_id": 3810, "verse_number": "१८", "content_sanskrit": "एवमुक्तस्तु भीमेन हनूमान् प्लवगोत्तमः ।\nप्रत्युवाच ततो वाक्यं स्निग्धगम्भीरया गिरा\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2130351, "chapter_id": 3810, "verse_number": "१९", "content_sanskrit": "एवमेतन्महाबाहो यथा वदसि भारत ।\nभीमसेन न पर्याप्तो ममासौ राक्षसाधमः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2130352, "chapter_id": 3810, "verse_number": "२०", "content_sanskrit": "मया तु निहते तस्मिन् रावणे लोककण्टके ।\nकीर्तिर्नश्येद् राघवस्य तत एतदुपेक्षितम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2130353, "chapter_id": 3810, "verse_number": "२१", "content_sanskrit": "तेन वीरेण तं हत्वा सगणं राक्षसाधमम् ।\nआनीता स्वपुरं सीता कीर्तिश्चाख्यापिता नृषु\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2130354, "chapter_id": 3810, "verse_number": "२२", "content_sanskrit": "तद् गच्छ विपुलप्रज्ञ भ्रातुः प्रियहिते रतः ।\nअरिष्टं क्षेममध्वानं वायुना परिरक्षितः \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2130355, "chapter_id": 3810, "verse_number": "२३", "content_sanskrit": "एष पन्थाः कुरुश्रेष्ठ सौगन्धिकवनाय ते ।\nद्रक्ष्यसे धनदोद्यानं रक्षितं यक्षराक्षसैः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2130356, "chapter_id": 3810, "verse_number": "२४", "content_sanskrit": "न च ते तरसा कार्यः कुसुमावचयः स्वयम् ।\nदैवतानि हि मान्यानि पुरुषेण विशेषतः \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2130357, "chapter_id": 3810, "verse_number": "२५", "content_sanskrit": "बलिहोमनमस्कारैर्मन्त्रैश्च भरतर्षभ ।\nदैवतानि प्रसादं हि भक्त्या कुर्वन्ति भारत\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2130358, "chapter_id": 3810, "verse_number": "२६", "content_sanskrit": "मा तात साहसं कार्षीः स्वधर्मं परिपालय ।\nस्वधर्मस्थः परं धर्मं बुध्यस्व गमयस्व च \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2130359, "chapter_id": 3810, "verse_number": "२७", "content_sanskrit": "न हि धर्ममविज्ञाय वृद्धाननुपसेव्य च ।\nधर्मार्थौ वि(वे)दितुं शक्यौ बृहस्पतिसमैरपि\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2130360, "chapter_id": 3810, "verse_number": "२८", "content_sanskrit": "अधर्मो यत्र धर्माख्यो धर्मश्चाधर्मसञ्ज्ञितः ।\nस विज्ञेयो विभागेन यत्र मुह्यन्त्यबुद्धयः \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2130361, "chapter_id": 3810, "verse_number": "२९", "content_sanskrit": "आचारसम्भवो धर्मो धर्मे वेदाः प्रतिष्ठिताः ।\nवेदैर्यज्ञाः समुत्पन्ना यज्ञैर्देवाः प्रतिष्ठिताः \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2130362, "chapter_id": 3810, "verse_number": "३०", "content_sanskrit": "वेदाचारविधानोक्तैर्यज्ञैर्धार्यन्ति देवताः ।\nबृहस्पत्युशनःप्रोक्तैर्नयैर्धार्यन्ति मानवाः \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2130363, "chapter_id": 3810, "verse_number": "३१", "content_sanskrit": "पण्याकरवणिज्याभिः कृष्यागोजाविपोषणैः ।\nविद्यया धार्यते सर्वं धर्मैरेतैर्द्विजातिभिः \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2130364, "chapter_id": 3810, "verse_number": "३२", "content_sanskrit": "त्रयी वार्ता दण्डनीतिस्तिस्रो विद्या विजानताम् ।\nताभिः सम्यक्प्रयुक्ताभिर्लोकयात्रा विधीयते\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2130365, "chapter_id": 3810, "verse_number": "३३", "content_sanskrit": "सा चेद् धर्मकृता न स्यात् त्रयीधर्ममृते भुवि।\nदण्डनीतिमृते चापि निर्मर्यादमिदं भवेत्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2130366, "chapter_id": 3810, "verse_number": "३४", "content_sanskrit": "वार्ताधर्मे ह्यवर्तिन्यो विनश्येयुरिमाः प्रजाः ।\nसुप्रवृत्तैस्त्रिभिर्ह्येतैर्धर्मं सूयन्ति वै प्रजाः \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2130367, "chapter_id": 3810, "verse_number": "३५", "content_sanskrit": "द्विजानाममृतं धर्मो ह्येकश्चैवैकलक्षणः ।\nयज्ञाध्ययनदानानि त्रयः साधारणाः स्मृताः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2130368, "chapter_id": 3810, "verse_number": "३६", "content_sanskrit": "याजनाध्यापनं विप्रे धर्मश्चैव प्रतिग्रहः ।\nपालनं क्षत्रियाणां वै वैश्यधर्मश्च पोषणम्\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2130369, "chapter_id": 3810, "verse_number": "३७", "content_sanskrit": "शुश्रूषा च द्विजातीनां शूद्राणां धर्म उच्यते ।\nभैक्ष्यहोमव्रतैर्हीनास्तथैव गुरुवासिताः \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2130370, "chapter_id": 3810, "verse_number": "३८", "content_sanskrit": "क्षत्रधर्मोऽत्र कौन्तेय तव धर्मोऽत्र रक्षणम् ।\nस्वधर्मं प्रतिपद्यस्व विनीतो नियतेन्द्रियः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2130371, "chapter_id": 3810, "verse_number": "३९", "content_sanskrit": "वृद्धैः सम्मन्त्र्य सद्भिश्च बुद्धिमद्भिः श्रुतान्वितैः ।\nआस्थितः शास्ति दण्डेन व्यसनी परिभूयते\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2130372, "chapter_id": 3810, "verse_number": "४०", "content_sanskrit": "निग्रहानुग्रहैः सम्यग् यदा राजा प्रवर्तते।\nतदा भवन्ति लोकस्य मर्यादाः सुव्यवस्थिताः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2130373, "chapter_id": 3810, "verse_number": "४१", "content_sanskrit": "तस्माद् देशे च दुर्गे च शत्रुमित्रबलेषु च ।\nनित्यं चारेण बोद्धव्यं स्थानं वृद्धिः क्षयस्तथा\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2130374, "chapter_id": 3810, "verse_number": "४२", "content_sanskrit": "राज्ञामुपायश्चारश्च बुद्धिमन्त्रपराक्रमाः ।\nनिग्रहप्रग्रहौ चैव दाक्ष्यं वै कार्यसाधकम्\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2130375, "chapter_id": 3810, "verse_number": "४३", "content_sanskrit": "साम्ना दानेन भेदेन दण्डेनोपेक्षणेन च ।\nसाधनीयानि कर्माणि समासव्यासयोगतः \t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2130376, "chapter_id": 3810, "verse_number": "४४", "content_sanskrit": "मन्त्रमूला नयाः सर्वे चाराश्च भरतर्षभ ।\nसुमन्त्रितेन या सिद्धिस्तां द्विजैः सह मन्त्रयेत्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2130377, "chapter_id": 3810, "verse_number": "४५", "content_sanskrit": "स्त्रिया मूढेन बालेन लुब्धेन लघुनापि वा ।\nन मन्त्रयीत गुह्यानि येषु चोन्मादलक्षणम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2130378, "chapter_id": 3810, "verse_number": "४६", "content_sanskrit": "मन्त्रयेत् सह विद्वद्भिः शक्तैः कर्माणि कारयेत् ।\nस्निग्धैश्च नीतिविन्यासान् मूर्खान् सर्वत्र वर्जयेत्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2130379, "chapter_id": 3810, "verse_number": "४७", "content_sanskrit": "धार्मिकान्धर्मकार्येषु अर्थकार्येषु पण्डितान् ।\nस्त्रीषु क्लीबान् नियुञ्जीत क्रूरान् क्रूरेषु कर्ममु\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2130380, "chapter_id": 3810, "verse_number": "४८", "content_sanskrit": "स्वेभ्यश्चैव परेभ्यश्च कार्याकार्यसमुद्भवा ।\nबुद्धिः कर्मसु विज्ञेया रिपूणां च बलाबलम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2130381, "chapter_id": 3810, "verse_number": "४९", "content_sanskrit": "बुद्ध्या स्वप्रतिपन्नेषु कुर्यात् साधुष्वनुग्रहम् ।\nनिग्रहं चाप्यशिष्टेषु निर्मर्यादेषु कारयेत्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2130382, "chapter_id": 3810, "verse_number": "५०", "content_sanskrit": "निग्रहे प्रग्रहे सम्यग्यदा राजा प्रवर्तते ।\nतदा भवति लोकस्य मर्यादा सुव्यवस्थिता\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2130383, "chapter_id": 3810, "verse_number": "५१", "content_sanskrit": "एष तेऽभिहितः पार्थ घोरो धर्मो दुरन्वयः ।\nतं स्वधर्मं विभागेन विनयस्थोऽनुपालय\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2130384, "chapter_id": 3810, "verse_number": "", "content_sanskrit": "साम्ना मित्राणि दानेन ब्राह्मणं कृत्रिमानि च ।\nभेदेनारीन् प्रदमयेत् कुण्डेन साधयेत् प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2130385, "chapter_id": 3810, "verse_number": "५२", "content_sanskrit": "तपोधर्मदमेज्याभिर्विप्रा यान्ति यथा दिवम् ।\nक्षत्रिया हि तथा स्वर्गं भुवि बन्धनपालनैः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2130386, "chapter_id": 3810, "verse_number": "५३", "content_sanskrit": "दानातिथ्यक्रियाधर्मैर्यान्ति वैश्याश्च सद्गतिम् ।\nद्विजशुश्रूषया शूद्रा लभन्ते गतिमुत्तमाम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2130387, "chapter_id": 3810, "verse_number": "५४", "content_sanskrit": "सम्यक्प्रणीतदण्डा हि कामद्वेषविवर्जिताः ।\nअलुब्धा विगतक्रोधाः सतां यान्ति सलोकताम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2130388, "chapter_id": 3810, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि सप्तचत्वारिंशदधिकशततमोऽध्यायः ॥ १४७ ॥\n॥ इति तीर्थयात्रापर्वणि त्र्यधिकशततमोऽध्यायः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2130389, "chapter_id": 3810, "verse_number": "", "content_sanskrit": "* * * * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]