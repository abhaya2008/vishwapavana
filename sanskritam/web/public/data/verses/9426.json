[{"id": 5000426000, "chapter_id": 9426, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे एकोनविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000426001, "chapter_id": 9426, "verse_number": "६-१९-१", "content_sanskrit": "राघवेणाभये दत्ते संनतो रावणानुजः।\nविभीषणो महाप्राज्ञो भूमिं समवलोकयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000426002, "chapter_id": 9426, "verse_number": "६-१९-२", "content_sanskrit": "खात् पपातावनिं हृष्टो भक्तैरनुचरैः सह।\nस तु रामस्य धर्मात्मा निपपात विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000426003, "chapter_id": 9426, "verse_number": "६-१९-३", "content_sanskrit": "पादयोर्निपपाताथ चतुर्भिः सह राक्षसैः।\nअब्रवीच्च तदा वाक्यं रामं प्रति विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000426004, "chapter_id": 9426, "verse_number": "६-१९-४", "content_sanskrit": "धर्मयुक्तं च युक्तं च साम्प्रतं सम्प्रहर्षणम्।\nअनुजो रावणस्याहं तेन चास्म्यवमानितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000426005, "chapter_id": 9426, "verse_number": "६-१९-५", "content_sanskrit": "भवन्तं सर्वभूतानां शरण्यं शरणं गतः।\nपरित्यक्ता मया लङ्का मित्राणि च धनानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000426006, "chapter_id": 9426, "verse_number": "६-१९-६", "content_sanskrit": "भवद‍्गतं हि मे राज्यं जीवितं च सुखानि च।\nतस्य तद् वचनं श्रुत्वा रामो वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000426007, "chapter_id": 9426, "verse_number": "६-१९-७", "content_sanskrit": "वचसा सान्त्वयित्वैनं लोचनाभ्यां पिबन्निव।\nआख्याहि मम तत्त्वेन राक्षसानां बलाबलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000426008, "chapter_id": 9426, "verse_number": "६-१९-८", "content_sanskrit": "एवमुक्तं तदा रक्षो रामेणाक्लिष्टकर्मणा।\nरावणस्य बलं सर्वमाख्यातुमुपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000426009, "chapter_id": 9426, "verse_number": "६-१९-९", "content_sanskrit": "अवध्यः सर्वभूतानां गन्धर्वोरगपक्षिणाम्।\nराजपुत्र दशग्रीवो वरदानात् स्वयम्भुवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000426010, "chapter_id": 9426, "verse_number": "६-१९-१०", "content_sanskrit": "रावणानन्तरो भ्राता मम ज्येष्ठश्च वीर्यवान्।\nकुम्भकर्णो महातेजाः शक्रप्रतिबलो युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000426011, "chapter_id": 9426, "verse_number": "६-१९-११", "content_sanskrit": "राम सेनापतिस्तस्य प्रहस्तो यदि ते श्रुतः।\nकैलासे येन समरे मणिभद्रः पराजितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000426012, "chapter_id": 9426, "verse_number": "६-१९-१२", "content_sanskrit": "बद्धगोधाङ्गुलित्राणस्त्ववध्यकवचो युधि।\nधनुरादाय यस्तिष्ठन्नदृश्यो भवतीन्द्रजित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000426013, "chapter_id": 9426, "verse_number": "६-१९-१३", "content_sanskrit": "संग्रामे सुमहद‍्व्यूहे तर्पयित्वा हुताशनम्।\nअन्तर्धानगतः श्रीमानिन्द्रजिद्धन्ति राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000426014, "chapter_id": 9426, "verse_number": "६-१९-१४", "content_sanskrit": "महोदरमहापार्श्वौ राक्षसश्चाप्यकम्पनः।\nअनीकपास्तु तस्यैते लोकपालसमा युधि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000426015, "chapter_id": 9426, "verse_number": "६-१९-१५", "content_sanskrit": "दशकोटिसहस्राणि रक्षसां कामरूपिणाम्।\nमांसशोणितभक्ष्याणां लङ्कापुरनिवासिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000426016, "chapter_id": 9426, "verse_number": "६-१९-१६", "content_sanskrit": "स तैस्तु सहितो राजा लोकपालानयोधयत्।\nसह देवैस्तु ते भग्ना रावणेन दुरात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000426017, "chapter_id": 9426, "verse_number": "६-१९-१७", "content_sanskrit": "विभीषणस्य तु वचस्तच्छ्रुत्वा रघुसत्तमः।\nअन्वीक्ष्य मनसा सर्वमिदं वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000426018, "chapter_id": 9426, "verse_number": "६-१९-१८", "content_sanskrit": "यानि कर्मापदानानि रावणस्य विभीषण।\nआख्यातानि च तत्त्वेन ह्यवगच्छामि तान्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000426019, "chapter_id": 9426, "verse_number": "६-१९-१९", "content_sanskrit": "अहं हत्वा दशग्रीवं सप्रहस्तं सहात्मजम्।\nराजानं त्वां करिष्यामि सत्यमेतच्छृणोतु मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000426020, "chapter_id": 9426, "verse_number": "६-१९-२०", "content_sanskrit": "रसातलं वा प्रविशेत् पातालं वापि रावणः।\nपितामहसकाशं वा न मे जीवन् विमोक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000426021, "chapter_id": 9426, "verse_number": "६-१९-२१", "content_sanskrit": "अहत्वा रावणं संख्ये सपुत्रजनबान्धवम्।\nअयोध्यां न प्रवेक्ष्यामि त्रिभिस्तैर्भ्रातृभिः शपे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000426022, "chapter_id": 9426, "verse_number": "६-१९-२२", "content_sanskrit": "श्रुत्वा तु वचनं तस्य रामस्याक्लिष्टकर्मणः।\nशिरसाऽऽवन्द्य धर्मात्मा वक्तुमेवं प्रचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000426023, "chapter_id": 9426, "verse_number": "६-१९-२३", "content_sanskrit": "राक्षसानां वधे साह्यं लङ्कायाश्च प्रधर्षणे।\nकरिष्यामि यथाप्राणं प्रवेक्ष्यामि च वाहिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000426024, "chapter_id": 9426, "verse_number": "६-१९-२४", "content_sanskrit": "इति ब्रुवाणं रामस्तु परिष्वज्य विभीषणम्।\nअब्रवील्लक्ष्मणं प्रीतः समुद्राज्जलमानय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000426025, "chapter_id": 9426, "verse_number": "६-१९-२५", "content_sanskrit": "तेन चेमं महाप्राज्ञमभिषिञ्च विभीषणम्।\nराजानं रक्षसां क्षिप्रं प्रसन्ने मयि मानद ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000426026, "chapter_id": 9426, "verse_number": "६-१९-२६", "content_sanskrit": "एवमुक्तस्तु सौमित्रिरभ्यषिञ्चद् विभीषणम्।\nमध्ये वानरमुख्यानां राजानं राजशासनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000426027, "chapter_id": 9426, "verse_number": "६-१९-२७", "content_sanskrit": "तं प्रसादं तु रामस्य दृष्ट्वा सद्यः प्लवङ्गमाः।\nप्रचुक्रुशुर्महात्मानं साधुसाध्विति चाब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000426028, "chapter_id": 9426, "verse_number": "६-१९-२८", "content_sanskrit": "अब्रवीच्च हनूमांश्च सुग्रीवश्च विभीषणम्।\nकथं सागरमक्षोभ्यं तराम वरुणालयम्।\nसैन्यैः परिवृताः सर्वे वानराणां महौजसाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000426029, "chapter_id": 9426, "verse_number": "६-१९-२९", "content_sanskrit": "उपायैरभिगच्छाम यथा नदनदीपतिम्।\nतराम तरसा सर्वे ससैन्या वरुणालयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000426030, "chapter_id": 9426, "verse_number": "६-१९-३०", "content_sanskrit": "एवमुक्तस्तु धर्मात्मा प्रत्युवाच विभीषणः।\nसमुद्रं राघवो राजा शरणं गन्तुमर्हति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000426031, "chapter_id": 9426, "verse_number": "६-१९-३१", "content_sanskrit": "खानितः सगरेणायमप्रमेयो महोदधिः।\nकर्तुमर्हति रामस्य ज्ञातेः कार्यं महोदधिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000426032, "chapter_id": 9426, "verse_number": "६-१९-३२", "content_sanskrit": "एवं विभीषणेनोक्तो राक्षसेन विपश्चिता।\nआजगामाथ सुग्रीवो यत्र रामः सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000426033, "chapter_id": 9426, "verse_number": "६-१९-३३", "content_sanskrit": "ततश्चाख्यातुमारेभे विभीषणवचः शुभम्।\nसुग्रीवो विपुलग्रीवः सागरस्योपवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000426034, "chapter_id": 9426, "verse_number": "६-१९-३४", "content_sanskrit": "प्रकृत्या धर्मशीलस्य रामस्यास्याप्यरोचत।\nसलक्ष्मणं महातेजाः सुग्रीवं च हरीश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000426035, "chapter_id": 9426, "verse_number": "६-१९-३५", "content_sanskrit": "सत्क्रियार्थं क्रियादक्षं स्मितपूर्वमभाषत।\nविभीषणस्य मन्त्रोऽयं मम लक्ष्मण रोचते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000426036, "chapter_id": 9426, "verse_number": "६-१९-३६", "content_sanskrit": "सुग्रीवः पण्डितो नित्यं भवान् मन्त्रविचक्षणः।\nउभाभ्यां सम्प्रधार्यार्थं रोचते यत् तदुच्यताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000426037, "chapter_id": 9426, "verse_number": "६-१९-३७", "content_sanskrit": "एवमुक्तौ ततो वीरावुभौ सुग्रीवलक्ष्मणौ।\nसमुदाचारसंयुक्तमिदं वचनमूचतुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000426038, "chapter_id": 9426, "verse_number": "६-१९-३८", "content_sanskrit": "किमर्थं नौ नरव्याघ्र न रोचिष्यति राघव।\nविभीषणेन यत् तूक्तमस्मिन् काले सुखावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000426039, "chapter_id": 9426, "verse_number": "६-१९-३९", "content_sanskrit": "अबद्‍ध्वा सागरे सेतुं घोरेऽस्मिन् वरुणालये।\nलङ्का नासादितुं शक्या सेन्द्रैरपि सुरासुरैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000426040, "chapter_id": 9426, "verse_number": "६-१९-४०", "content_sanskrit": "विभीषणस्य शूरस्य यथार्थं क्रियतां वचः।\nअलं कालात्ययं कृत्वा सागरोऽयं नियुज्यताम्।\nयथा सैन्येन गच्छाम पुरीं रावणपालिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000426041, "chapter_id": 9426, "verse_number": "६-१९-४१", "content_sanskrit": "एवमुक्तः कुशास्तीर्णे तीरे नदनदीपतेः।\nसंविवेश तदा रामो वेद्यामिव हुताशनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000426042, "chapter_id": 9426, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमद्युद्धकाण्डे एकोनविंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]