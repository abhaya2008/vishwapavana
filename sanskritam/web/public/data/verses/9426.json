[{"id": 40023157, "chapter_id": 9426, "verse_number": "1", "content_sanskrit": "विसृज्य लक्ष्मणं रामो दुःखशोकसमन्वितः । पुरोधसं मन्त्रिणश्च नैगमांश्चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40023158, "chapter_id": 9426, "verse_number": "2", "content_sanskrit": "अद्य राज्ये ऽभिषेक्ष्यामि भरतं धर्मवत्सलम् । अयोध्यायाः पतिं वीरं ततो यास्याम्यहं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40023159, "chapter_id": 9426, "verse_number": "3", "content_sanskrit": "प्रवेशयत सम्भारान्माभूत्कालस्य पर्ययः । अद्यैवाहं गमिष्यामि लक्ष्मणेन गतां गतिम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40023160, "chapter_id": 9426, "verse_number": "4", "content_sanskrit": "तच्छ्रुत्वा राघवेणोक्तं सर्वाः प्रकृतयो भृशम् । मूर्धभिः प्रणता भूमौ गतसत्त्वा इवाभवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40023161, "chapter_id": 9426, "verse_number": "5", "content_sanskrit": "भरतश्च विसञ्ज्ञो ऽभूच्छ्रुत्वा रामस्य भाषितम् । राज्यं विगर्हयामास राघवं चेदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40023162, "chapter_id": 9426, "verse_number": "6", "content_sanskrit": "सत्येनाहं शपे राजन्स्वर्गलोके न चैव हि । न कामये यथा राज्यं त्वां विना रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40023163, "chapter_id": 9426, "verse_number": "7", "content_sanskrit": "इमौ कुशलवौ राजन्नभिषिञ्च नराधिप । कोसलेषु कुशं वीरमुत्तरेषु तथा लवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40023164, "chapter_id": 9426, "verse_number": "8", "content_sanskrit": "शत्रुघ्नस्य तु गच्छन्तु दूतास्त्वरितविक्रमाः । इदं गमनमस्माकं स्वर्गायाख्यातु मा चिरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40023165, "chapter_id": 9426, "verse_number": "9", "content_sanskrit": "तच्छ्रुत्वा भरतेनोक्तं दृष्ट्वा चापि ह्यधोमुखान् । पौरान्दुःखेन सन्तप्तान्वसिष्ठो वाक्यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40023166, "chapter_id": 9426, "verse_number": "10", "content_sanskrit": "वत्स राम इमाः पश्य धरणीं प्रकृतीर्गताः । ज्ञात्वैषामीप्सितं कार्यं मा चैषां विप्रियं कृथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40023167, "chapter_id": 9426, "verse_number": "11", "content_sanskrit": "वसिष्ठस्य तु वाक्येन उत्थाप्य प्रकृतीजनम् । किं करोमीति काकुत्स्थः सर्वा वचनमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40023168, "chapter_id": 9426, "verse_number": "12", "content_sanskrit": "ततः सर्वाः प्रकृतयो रामं वचनमब्रुवन् । गच्छन्तमनुगच्छामो यत्र राम गमिष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40023169, "chapter_id": 9426, "verse_number": "13", "content_sanskrit": "पौरेषु यदि ते प्रीतिर्यदि स्नेहो ह्यनुत्तमः । सपुत्रदाराः काकुत्स्थ समागच्छाम सत्पथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40023170, "chapter_id": 9426, "verse_number": "14", "content_sanskrit": "तपोवनं वा दुर्गं वा नदीमम्भोनिधिं तथा । वयं ते यदि न त्याज्याः सर्वान्नो नय ईश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40023171, "chapter_id": 9426, "verse_number": "15", "content_sanskrit": "एषा नः परमा प्रीतिरेष नः परमो वरः । हृद्गता नः सदा प्रीतिस्तवानुगमने नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40023172, "chapter_id": 9426, "verse_number": "16", "content_sanskrit": "पौराणां दृढभक्तिं च बाढमित्येव सो ऽब्रवीत् । स्वकृतान्तं चान्ववेक्ष्य तस्मिन्नहनि राघवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40023173, "chapter_id": 9426, "verse_number": "17", "content_sanskrit": "कोसलेषु कुशं वीरमुत्तरेषु तथा लवम् । अभिषिच्य महात्मानावुभौ रामः कुशीलवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40023174, "chapter_id": 9426, "verse_number": "18", "content_sanskrit": "अभिषिक्तौ सुतावङ्के प्रतिष्ठाप्य पुरे ततः । परिष्वज्य महाबाहुर्मूर्ध्न्युपाघ्राय चासकृत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40023175, "chapter_id": 9426, "verse_number": "19", "content_sanskrit": "रथानां तु सहस्राणि नागानामयुतानि च । दशायुतानि चाश्वानामेकैकस्य धनं ददौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40023176, "chapter_id": 9426, "verse_number": "20", "content_sanskrit": "बहुरत्नौ बहुधनौ हृष्टपुष्टजनावृतौ । स्वे पुरे प्रेषयामास भ्रातरौ तु कुशीलवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40023177, "chapter_id": 9426, "verse_number": "21", "content_sanskrit": "अभिषिच्य सुतौ वीरौ प्रतिष्ठाप्य पुरे तदा । दूतान्सम्प्रेषयामास शत्रुघ्नाय महात्मने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]