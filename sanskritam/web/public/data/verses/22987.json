[{"id": 7002987000, "chapter_id": 22987, "verse_number": "२-३४-१", "content_sanskrit": "सावित्र्युवाच ।\nहरिभक्तिं देहि मह्यं सारभूतां सुदुर्लभाम् ।\nत्वत्तः सर्वं श्रुतं देव नावशिष्टोऽधुना मम ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002987001, "chapter_id": 22987, "verse_number": "२-३४-२", "content_sanskrit": "किंचित्कथय मे धर्मं श्रीकृष्णगुणकीर्त्तगम् ।\nपुंसां लक्षोद्धारबीजं नरकार्णवतारकम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002987002, "chapter_id": 22987, "verse_number": "२-३४-३", "content_sanskrit": "कारणं मुक्तिकार्याणां सर्वाशुभनिवारणम् ।\nदारणं कर्मवृक्षाणां कृत पापौघहारकम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002987003, "chapter_id": 22987, "verse_number": "२-३४-४", "content_sanskrit": "मुक्तयः कतिधा सन्ति किं वा तासां च लक्षणम् ।\nहरिभक्तेर्मूर्तिभेदं निषेकस्यापि लक्षणम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002987004, "chapter_id": 22987, "verse_number": "२-३४-५", "content_sanskrit": "तत्त्वज्ञानविहीना च स्त्रीजातिर्विधिनिर्मिता ।\nकिं तज्ज्ञानं सारभूतं वद वेदविदां वर ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002987005, "chapter_id": 22987, "verse_number": "२-३४-६", "content_sanskrit": "सर्वदानं ह्यनशनं तीर्थस्नानं व्रतं तपः ।\nअज्ञाने ज्ञानदानस्य कलां नार्हन्ति षोडशीम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002987006, "chapter_id": 22987, "verse_number": "२-३४-७", "content_sanskrit": "पितुः शतगुणा माता गौरवेणातिरिच्यते ।\nमातुः शतगुणैः पूज्यो ज्ञानदाता गुरुः प्रभो ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002987007, "chapter_id": 22987, "verse_number": "२-३४-८", "content_sanskrit": "यम उवाच ।\nपूर्वं सर्वो वरो दत्तो यस्ते मनसि वाञ्छितः ।\nअधुना हरिभक्तिस्ते वत्से भवतु मद्वरात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002987008, "chapter_id": 22987, "verse_number": "२-३४-९", "content_sanskrit": "श्रोतुमिच्छसि कल्याणि श्रीकृष्णगुणकीर्त्तनम् ।\nवक्तॄणां प्रश्नकर्तॄणां श्रोतॄणां कुलतारकम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002987009, "chapter_id": 22987, "verse_number": "२-३४-१०", "content_sanskrit": "शेषो वक्त्रसहस्रेण नहि यद्वक्तु मीश्वरः ।\nमृत्युञ्जयो न क्षमश्च वक्तुं पञ्चमुखेन च ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002987010, "chapter_id": 22987, "verse_number": "२-३४-११", "content_sanskrit": "धाता चतुर्णां वेदानां विधाता जगतामपि ।\nब्रह्मा चतुर्मुखेनैव नालं विष्णुश्च सर्ववित् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002987011, "chapter_id": 22987, "verse_number": "२-३४-१२", "content_sanskrit": "कार्तिकेयः षण्मुखेन नापि वक्तुमलं ध्रुवम् ।\nन गणेशः समर्थश्च योगीन्द्राणां गुरोर्गुरुः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002987012, "chapter_id": 22987, "verse_number": "२-३४-१३", "content_sanskrit": "सारभूताश्च शास्त्राणां वेदाश्चत्वार एव च ।\nकलामात्रं यद्गणानां न विदन्ति बुधाश्च ये ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002987013, "chapter_id": 22987, "verse_number": "२-३४-१४", "content_sanskrit": "सरस्वती च यत्नेन नालं यद्गुणवर्णने ।\nसनत्कुमारो धर्मश्च सनकश्च सनातनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002987014, "chapter_id": 22987, "verse_number": "२-३४-१५", "content_sanskrit": "सनन्दः कपिलः सूर्य्यो ये चान्ये ब्रह्मणः सुताः ।\nविचक्षणा न यद्वक्तुं के वाऽन्ये जडबुद्धयः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002987015, "chapter_id": 22987, "verse_number": "२-३४-१६", "content_sanskrit": "न यद्वक्तुं क्षमाः सिद्धा मुनीन्द्रा योगिनस्तथा ।\nके वाऽन्ये  च वयं के वा भगवद्गुणवर्णने ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002987016, "chapter_id": 22987, "verse_number": "२-३४-१७", "content_sanskrit": "ध्यायन्ति यत्पदाम्भोजं ब्रह्मविष्णुशिवादयः ।\nअतिसाध्यं स्वभक्तानां तदन्येषां सुदुर्लभम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002987017, "chapter_id": 22987, "verse_number": "२-३४-१८", "content_sanskrit": "कश्चित्किंचिद्विजानाति तद्गुणोत्कीर्त्तनं महत् ।\nअतिरिक्तं विजानाति ब्रह्मा ब्रह्मसुतादयः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002987018, "chapter_id": 22987, "verse_number": "२-३४-१९", "content_sanskrit": "ततोऽतिरिक्तं जानाति गणेशो ज्ञानिनां गुरुः ।\nसर्वातिरिक्तं जानाति सर्वज्ञः शम्भुरेव च ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002987019, "chapter_id": 22987, "verse_number": "२-३४-२०", "content_sanskrit": "तस्मै दत्तं पुरा ज्ञानं कृष्णेन परमात्मना ।\nअतीव निर्जने रम्ये गोलोके रासमण्डले ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002987020, "chapter_id": 22987, "verse_number": "२-३४-२१", "content_sanskrit": "तत्रैव कथितं किंचिद्यद्गुणोत्कीर्त्तनं पुनः ।\nधर्माय कथयायास शिवलोके शिवः स्वयम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002987021, "chapter_id": 22987, "verse_number": "२-३४-२२", "content_sanskrit": "धर्मस्तत्कथयामास पुष्करे भास्कराय च ।\nपिता मम यमाराध्य गां प्राप तपसा सति ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002987022, "chapter_id": 22987, "verse_number": "२-३४-२३", "content_sanskrit": "पूर्वं स्वविषयं चाहं न गृह्णामि प्रयत्नतः ।\nवैराग्ययुक्तस्तपसे गन्तुमिच्छामि सुव्रते ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002987023, "chapter_id": 22987, "verse_number": "२-३४-२४", "content_sanskrit": "तदा मां कथयामास पिता तद्गुणकीर्त्तनम् ।\nयथागमं तद्वदामि निबोधातीव दुर्गमम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002987024, "chapter_id": 22987, "verse_number": "२-३४-२५", "content_sanskrit": "तद्गुणं स न जानाति तदन्यस्य च का कथा ।\nयथाऽऽकाशं न जानाति स्वान्तमेव वरानने ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002987025, "chapter_id": 22987, "verse_number": "२-३४-२६", "content_sanskrit": "सर्वान्तरात्मा भगवान्सर्वकारणकारणम् ।\nसर्वेश्वरश्च सर्वाद्यः सर्ववित्सर्वरूपधृक् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002987026, "chapter_id": 22987, "verse_number": "२-३४-२७", "content_sanskrit": "नित्यरूपी नित्यदेही नित्यानन्दो निराकृतिः ।\nनिरंकुशश्च निश्शृङ्गो निर्गुणश्च निराश्रयः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7002987027, "chapter_id": 22987, "verse_number": "२-३४-२८", "content_sanskrit": "निर्लिप्तः सर्वसाक्षी च सर्वाधारः परात्परः ।\nप्रकृतिस्तद्विकारा च प्राकृतास्तद्विकारजाः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7002987028, "chapter_id": 22987, "verse_number": "२-३४-२९", "content_sanskrit": "स्वयं पुमांश्च प्रकृतिः स्वयं च प्रकृतेः परः ।\nरूपं विधत्तेऽरूपश्च भक्तानुग्रहहेतवे ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7002987029, "chapter_id": 22987, "verse_number": "२-३४-३०", "content_sanskrit": "अतीव कमनीयं च सुन्दरं सुमनोहरम् ।\nनवीननीरदश्यामं किशोरं गोपवेषकम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7002987030, "chapter_id": 22987, "verse_number": "२-३४-३१", "content_sanskrit": "कन्दर्पकोटिलावण्यलीलाधाम मनोहरम् ।\nशरन्मध्याह्नपद्मानां शोभामोषकलोचनम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7002987031, "chapter_id": 22987, "verse_number": "२-३४-३२", "content_sanskrit": "शरत्पार्वणकोटीन्दुशोभासंशोभिताननम् ।\nअमूल्यरत्नखचितरत्नाभरणभूषितम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7002987032, "chapter_id": 22987, "verse_number": "२-३४-३३", "content_sanskrit": "सस्मितं शोभितं शश्वदमूल्याऽऽपीतवाससा ।\nपरं ब्रह्मस्वरूपं च ज्वलन्तं ब्रह्मतेजसा ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7002987033, "chapter_id": 22987, "verse_number": "२-३४-३४", "content_sanskrit": "सुखदृश्यं च शान्तं च राधाकान्तमनन्तकम् ।\nगोपीभिर्वीक्ष्यमाणं च सस्मिताभिः समन्ततः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7002987034, "chapter_id": 22987, "verse_number": "२-३४-३५", "content_sanskrit": "रासमण्डलमध्यस्थं रत्नसिंहासनस्थितम् ।\nवंशीं क्वणन्तं द्विभुजं वनमालाविभूषितम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7002987035, "chapter_id": 22987, "verse_number": "२-३४-३६", "content_sanskrit": "कौस्तुभेन मणीन्द्रेण सुन्दरं वक्षसोज्ज्वलम् ।\nकुङ्कुमागरुकस्तूरीचन्दनार्चितविग्रहम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7002987036, "chapter_id": 22987, "verse_number": "२-३४-३७", "content_sanskrit": "चारुचम्पकमालाब्जमालतीमाल्यमण्डितम् ।\nचारुचम्पकशोभाढ्यचूडावक्त्रिमराजितम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7002987037, "chapter_id": 22987, "verse_number": "२-३४-३८", "content_sanskrit": "ध्यायन्ति चैवम्भूतं वै भक्ता भक्तिपरिप्लुताः ।\nयद्भयाज्जगतां धाता विधत्ते सृष्टिमेव च ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7002987038, "chapter_id": 22987, "verse_number": "२-३४-३९", "content_sanskrit": "करोति लेखनं कर्मानुरूपं सर्वदेहिनाम् ।\nतपसां फलदाता च कर्मणां च यदाज्ञया ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7002987039, "chapter_id": 22987, "verse_number": "२-३४-४०", "content_sanskrit": "विष्णुः पाता च सर्वेषां यद्भयात्पाति सन्ततम् ।\nकालाग्निरुद्रः संहर्त्ता सर्वविश्वेषु यद्भयात् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7002987040, "chapter_id": 22987, "verse_number": "२-३४-४१", "content_sanskrit": "शिवो मृत्युञ्जयश्चैव ज्ञानिनां च गुरोर्गुरुः ।\nयज्ज्ञानदानात्सिद्धेशो योगीशः सर्ववित्स्वयम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7002987041, "chapter_id": 22987, "verse_number": "२-३४-४२", "content_sanskrit": "परमानन्द युक्तश्च भक्तिवैराग्यसंयुतः ।\nयत्प्रसादाद्वाति वातः प्रवरः शीघ्रगामिनाम् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7002987042, "chapter_id": 22987, "verse_number": "२-३४-४३", "content_sanskrit": "तपनश्च प्रतपति यद्भयात्सन्ततं सति ।\nयदाज्ञया वर्षतीन्द्रो मृत्युश्चरति जन्तुषु ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7002987043, "chapter_id": 22987, "verse_number": "२-३४-४४", "content_sanskrit": "यदाज्ञया दहेद्वह्निर्जलमेव सुशीतलम् ।\nदिशो रक्षन्ति दिक्पाला महाभीता यदाज्ञया ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7002987044, "chapter_id": 22987, "verse_number": "२-३४-४५", "content_sanskrit": "भ्रमन्ति राशिचक्राणि ग्रहा वै यद्भयेन च ।\nभयात्फलन्ति वृक्षाश्च पुष्पन्त्यपि च यद्भयात् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7002987045, "chapter_id": 22987, "verse_number": "२-३४-४६", "content_sanskrit": "भयात्फलानि पक्वानि निष्फलास्तरवो भयात् ।\nयदाज्ञया स्थलस्थाश्च न जीवन्ति जलेषु च ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7002987046, "chapter_id": 22987, "verse_number": "२-३४-४७", "content_sanskrit": "तथा स्थले जलस्थाश्च न जीवन्ति यदाज्ञया ।\nअहं नियमकर्त्ता च धर्माधर्मं च यद्भयात् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7002987047, "chapter_id": 22987, "verse_number": "२-३४-४८", "content_sanskrit": "कालश्च कलयेत्सर्वं भ्रमत्येव यदाज्ञया ।\nअकाले हरेत्कालो मृत्युर्वै यद्भयेन च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7002987048, "chapter_id": 22987, "verse_number": "२-३४-४९", "content_sanskrit": "ज्वलदग्नौ पतन्तं च गभीरे च जलार्णवे ।\nवृक्षाग्रात्तीक्ष्णखड्गे च सर्पादीनां मुखेषु च ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7002987049, "chapter_id": 22987, "verse_number": "२-३४-५०", "content_sanskrit": "नानाशस्त्रास्त्रविद्धं च रणेषु विषमेषु च ।\nपुष्पचन्दनतल्पे च बन्धुवर्गैश्च रक्षितम् ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7002987050, "chapter_id": 22987, "verse_number": "२-३४-५१", "content_sanskrit": "शयानं तन्त्रमन्त्रैश्च काले कालो हरेद्भयात् ।\nधत्ते वायुस्तोयराशिं तोयं कूर्मं यदाज्ञया ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7002987051, "chapter_id": 22987, "verse_number": "२-३४-५२", "content_sanskrit": "कूर्मोऽनन्तं स च क्षोणीं समुद्रान्सप्तपर्वतान् ।\nसर्वांश्चैव क्षमारूपो नानारूपं बिभर्त्ति सः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7002987052, "chapter_id": 22987, "verse_number": "२-३४-५३", "content_sanskrit": "यतः सर्वाणि भूतानि लीयन्तेऽन्ते च तत्र वै ।\nइन्द्रायुश्चैव दिव्यानां युगानामेकसप्ततिः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7002987053, "chapter_id": 22987, "verse_number": "२-३४-५४", "content_sanskrit": "अष्टाविंशच्छक्रपाते ब्रह्मणस्स्यादहर्निशम् ।\nषष्ट्याधिके पञ्चशते सहस्रे पञ्चविंशतौ ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7002987054, "chapter_id": 22987, "verse_number": "२-३४-५५", "content_sanskrit": "युगे नराणां शक्रायुरेवं संख्याविदो विदुः ।\nएवं त्रिंशद्दिनैर्मासो द्वाभ्यां ताभ्यामृतुः स्मृतः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7002987055, "chapter_id": 22987, "verse_number": "२-३४-५६", "content_sanskrit": "ऋतुभिः षड्भिरेवाब्दं शताब्दं ब्रह्मणो वयः ।\nब्रह्मणश्च निपाते वै चक्षुरुन्मीलनं हरेः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7002987056, "chapter_id": 22987, "verse_number": "२-३४-५७", "content_sanskrit": "चक्षुर्निमीलने तस्य लयं प्राकृतिकं विदुः ।\nप्रलये प्राकृताः सर्वे देवाद्याश्च चराचराः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7002987057, "chapter_id": 22987, "verse_number": "२-३४-५८", "content_sanskrit": "लीना धातरि धाता च श्रीकृष्णे नाभिपङ्कजे ।\nविष्णुः क्षीरोदशायी च वैकुण्ठे यश्चतुर्भुजः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7002987058, "chapter_id": 22987, "verse_number": "२-३४-५९", "content_sanskrit": "विलीना वामपार्श्वे च कृष्णस्य परमात्मनः ।\nरुद्राद्या भैरवाद्याश्च यावन्तश्च शिवानुगाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7002987059, "chapter_id": 22987, "verse_number": "२-३४-६०", "content_sanskrit": "शिवाधारे शिवे लीना ज्ञानानन्दे सनातने ।\nज्ञानाधिदेवः कृष्णस्य महादेवस्य चात्मनः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7002987060, "chapter_id": 22987, "verse_number": "२-३४-६१", "content_sanskrit": "तस्य ज्ञाने विलीनश्च बभूवाथ क्षणं हरेः ।\nदुर्गायां विष्णुमायायां विलीनाः सर्व शक्तयः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7002987061, "chapter_id": 22987, "verse_number": "२-३४-६२", "content_sanskrit": "सा च कृष्णस्य बुद्धौ च बुद्ध्यधिष्ठातृदेवता ।\nनारायणांशः स्कन्दश्च लीनो वक्षसि तस्य च ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7002987062, "chapter_id": 22987, "verse_number": "२-३४-६३", "content_sanskrit": "श्रीकृष्णांशश्च तद्बाहौ देवाधीशो गणेश्वरः ।\nपद्मांशभूता पद्मायां सा राधायां च सुव्रते ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7002987063, "chapter_id": 22987, "verse_number": "२-३४-६४", "content_sanskrit": "गोप्यश्चापि च तस्यां च सर्वा वै देवयोषितः ।\nकृष्णप्राणाधिदेवी सा तस्य प्राणेषु सा स्थिता ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7002987064, "chapter_id": 22987, "verse_number": "२-३४-६५", "content_sanskrit": "सावित्री च सरस्वत्यां वेदशास्त्राणि यानि च ।\nस्थिता वाणी च जिह्वायां तस्यैव परमात्मनः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7002987065, "chapter_id": 22987, "verse_number": "२-३४-६६", "content_sanskrit": "गोलोकस्थस्य गोपाश्च विलीनास्तस्य लोमसु ।\nतत्प्राणेषु च सर्वेषां प्राणा वाता हुताशनः ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7002987066, "chapter_id": 22987, "verse_number": "२-३४-६७", "content_sanskrit": "जठराग्नौ विलीनश्च जलं तद्रसनाग्रतः ।\nवैष्णवाश्चरणाम्भोजे परमानन्दसंयुताः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7002987067, "chapter_id": 22987, "verse_number": "२-३४-६८", "content_sanskrit": "सारात्सारतरा भक्तिरसपीयूषपायिनः ।\nविराट् क्षुद्रश्च महति लीनः कृष्णे महान्विराट् ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7002987068, "chapter_id": 22987, "verse_number": "२-३४-६९", "content_sanskrit": "यस्यैव लोमकूपेषु विश्वानि निखिलानि च ।\nयस्य चक्षु निमेषेण महांश्च प्रलयो भवेत् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7002987069, "chapter_id": 22987, "verse_number": "२-३४-७०", "content_sanskrit": "चक्षुरुन्मीलने सृष्टिर्यस्यैव परमात्मनः ।\nयावन्निमेषे सृष्टिस्स्यात्तावदुन्मीलने व्ययः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7002987070, "chapter_id": 22987, "verse_number": "२-३४-७१", "content_sanskrit": "ब्रह्मणश्च शताब्देन सृष्टिस्तत्र लयः पुनः ।\nब्रह्मसृष्टिलयानां च संख्या नास्त्येव सुव्रते ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7002987071, "chapter_id": 22987, "verse_number": "२-३४-७२", "content_sanskrit": "यथा भूरजसां चैव संख्यानं च निशामय ।\nचक्षुर्निमेषे प्रलयो यस्य सर्वान्तरात्मनः ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7002987072, "chapter_id": 22987, "verse_number": "२-३४-७३", "content_sanskrit": "उन्मीलने पुनः सृष्टिर्भवेदेवेश्वरेच्छया ।\nतद्गुणोत्कीर्त्तनं वक्तुं ब्रह्माण्डेषु च कः क्षमः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7002987073, "chapter_id": 22987, "verse_number": "२-३४-७४", "content_sanskrit": "यथा श्रुतं तातवक्त्रात्तथोक्तं च यथागमम् ।\nमुक्तयश्च चतुर्वेदैर्निरुक्ताश्च चतुर्विधाः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7002987074, "chapter_id": 22987, "verse_number": "२-३४-७५", "content_sanskrit": "तत्प्रधाना हरेर्भक्तिर्मुक्तेरपि गरीयसी ।\nसालोक्यदा हरेरेका चान्या सारूप्यदा परा ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7002987075, "chapter_id": 22987, "verse_number": "२-३४-७६", "content_sanskrit": "सामीप्यदा च निर्वाणदात्री चैवमिति स्मृतिः ।\nभक्तास्ता नहि वाञ्छन्ति विना तत्सेवनादिकम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7002987076, "chapter_id": 22987, "verse_number": "२-३४-७७", "content_sanskrit": "सिद्धत्वममरत्वं च ब्रह्मत्वं चावहेलया ।\nजन्ममृत्युजराव्याधिभयशोकादिखण्डनम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7002987077, "chapter_id": 22987, "verse_number": "२-३४-७८", "content_sanskrit": "धारणं दिव्यरूपस्य विदुर्निर्वाणमोक्षदम् ।\nमुक्तिश्च सेवारहिता भक्तिः सेवाविवर्द्धिनी ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7002987078, "chapter_id": 22987, "verse_number": "२-३४-७९", "content_sanskrit": "भक्तिमुक्त्योरयं भेदो निषेके लक्षणं शृणु ।\nविदुर्बुधा निषेकं च भोगं च कृतकर्मणाम् ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7002987079, "chapter_id": 22987, "verse_number": "२-३४-८०", "content_sanskrit": "तत्खण्डनं च शुभदं परं श्रीकृष्णसेवनम् ।\nतत्त्वज्ञानमिदं साध्वि सारं वै लोकवेदयोः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7002987080, "chapter_id": 22987, "verse_number": "२-३४-८१", "content_sanskrit": "विघ्नघ्नं शुभदं चोक्तं गच्छ वत्से यथासुखम् ।\nइत्युक्त्वा सूर्य्यपुत्रश्च जीवयित्वा च तत्पतिम् ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7002987081, "chapter_id": 22987, "verse_number": "२-३४-८२", "content_sanskrit": "तस्यै शुभाशिषं दत्त्वा गमनं कर्तुमुद्यतः ।\nदृष्ट्वा यमं च गच्छन्तं सावित्री तं प्रणम्य च ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7002987082, "chapter_id": 22987, "verse_number": "२-३४-८३", "content_sanskrit": "रुरोद चरणे धृत्वा सद्विच्छेदोऽतिदुःखदः ।\nसावित्रीरोदनं दृष्ट्वा यमस्सोऽयं कृपानिधिः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7002987083, "chapter_id": 22987, "verse_number": "२-३४-८४", "content_sanskrit": "तामित्युवाच सन्तुष्टस्त्वरोदीच्चापि नारद ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7002987084, "chapter_id": 22987, "verse_number": "२-३४-८५", "content_sanskrit": "यम उवाच ।\nलक्षवर्षं सुखं भुक्त्वा पुण्यक्षेत्रे च भारते ।\nअन्ते यास्यसि गोलोके श्रीकृष्णभवनं शुभे ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7002987085, "chapter_id": 22987, "verse_number": "२-३४-८६", "content_sanskrit": "गत्वा च स्वगृहं भद्रे सावित्र्याश्च व्रतं कुरु ।\nद्द्विसप्तवर्षपर्य्यन्तं नारीणां मोक्षकारणम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7002987086, "chapter_id": 22987, "verse_number": "२-३४-८७", "content_sanskrit": "ज्येष्ठे शुक्लचतुर्दश्यां सावित्र्याश्च व्रतं शुभम् ।\nशुक्लाष्टम्यां भाद्रपदे महालक्ष्म्या व्रतं शुभम् ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7002987087, "chapter_id": 22987, "verse_number": "२-३४-८८", "content_sanskrit": "द्व्यष्टवर्षव्रतं चेदं प्रत्यब्दं पक्षमेव च ।\nकरोति परया भक्त्या सा याति च हरेः पदम् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7002987088, "chapter_id": 22987, "verse_number": "२-३४-८९", "content_sanskrit": "प्रतिमङ्गलवारे च देवीं मङ्गलचण्डिकाम् ।\nप्रतिमासं शुक्लषष्ठ्यां षष्ठीं मङ्गलदायिकाम् ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7002987089, "chapter_id": 22987, "verse_number": "२-३४-९०", "content_sanskrit": "तथा चाषाढसंक्रान्त्यां मनसा सर्वसिद्धिदाम् ।\nराधां रासे च कार्तिक्यां कृष्णप्राणाधिकां प्रियाम् ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7002987090, "chapter_id": 22987, "verse_number": "२-३४-९१", "content_sanskrit": "उपोष्य शुक्लाष्टम्यां च प्रतिमासे वरप्रदाम् ।\nविष्णुमायां भगवतीं दुर्गां दुर्गार्तिनाशिनीम् ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7002987091, "chapter_id": 22987, "verse_number": "२-३४-९२", "content_sanskrit": "प्रकृतिं जगदम्बां च पतिपुत्रवतीं सतीम् ।\nपतिव्रतासु शुद्धासु यन्त्रेषु प्रतिमासु च ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7002987092, "chapter_id": 22987, "verse_number": "२-३४-९३", "content_sanskrit": "या नारी पूजयेद्भक्त्या धनसन्तानहेतवे ।\nइह लोके सुखं भुक्त्वा यात्यन्ते श्रीहरेः पदम् ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7002987093, "chapter_id": 22987, "verse_number": "२-३४-९४", "content_sanskrit": "इत्युक्त्वा तां धर्मराजो जगाम निजमन्दिरम् ।\nगृहीत्वा स्वामिनं सा च सावित्री च निजालयम् ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7002987094, "chapter_id": 22987, "verse_number": "२-३४-९५", "content_sanskrit": "सावित्री सत्यवन्तं च वृत्तान्तं च यथाक्रमम् ।\nअन्यांश्च कथयामास बान्धवांश्चैव नारद ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7002987095, "chapter_id": 22987, "verse_number": "२-३४-९६", "content_sanskrit": "सावित्रीजनकः पुत्रान्स प्रापद्वै क्रमेण च ।\nश्वशुरश्चक्षुषी राज्यं सा च पुत्रान्वरेण च ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7002987096, "chapter_id": 22987, "verse_number": "२-३४-९७", "content_sanskrit": "लक्षवर्षं सुखं भुक्त्वा पुण्यक्षेत्रे च भारते ।\nजगाम स्वामिना सार्द्धं गोलोकं सा पतिव्रता ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7002987097, "chapter_id": 22987, "verse_number": "२-३४-९८", "content_sanskrit": "सवितुश्चाधिदेवी या मन्त्राधिष्ठातृदेवता ।\nसावित्री चापि वेदानां सावित्री तेन कीर्त्तिता ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7002987098, "chapter_id": 22987, "verse_number": "२-३४-९९", "content_sanskrit": "इत्येवं कथितं वत्स सावित्र्याख्यानमुत्तमम् ।\nजीवकर्मविपाकं च किं पुनः श्रोतुमिच्छसि ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7002987099, "chapter_id": 22987, "verse_number": "२-३४-१००", "content_sanskrit": "इति सावित्र्युपाख्यानम् ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}]