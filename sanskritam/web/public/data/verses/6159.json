  },
  {
    "id": 16759053,
    "chapter_id": 6159,
    "verse_number": "11.53",
    "content_sanskrit": "नाहं वेदैर्न तपसा\nन दानेन न चेज्यया ।\nशक्य एवंविधो द्रष्टुं\nदृष्टवानसि मां यथा ॥ ५३ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "base_unit_id": "BG_C11_V53"
  },
  {
    "id": 16759054,
    "chapter_id": 6159,
    "verse_number": "11.54",
    "content_sanskrit": "भक्त्या त्वनन्यया शक्य\nअहमेवंविधोऽर्जुन ।\nज्ञातुं द्रष्टुं च तत्त्वेन\nप्रवेष्टुं च परन्तप ॥ ५४ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "base_unit_id": "BG_C11_V54"
  },
  {
    "id": 16759055,
    "chapter_id": 6159,
    "verse_number": "11.55",
    "content_sanskrit": "मत्कर्मकृन्मत्परमो\nमद्भक्तः सङ्गवर्जितः ।\nनिर्वैरः सर्वभूतेषु\nयः स मामेति पाण्डव ॥ ५५ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "base_unit_id": "BG_C11_V55"
  }
]