[{"id": 2206334, "chapter_id": 5394, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2206335, "chapter_id": 5394, "verse_number": "१", "content_sanskrit": "तूष्णीमासीदर्जुनस्तु पवनस्त्वब्रवीत् पुनः ।\nशृणु मे ब्राह्मणेष्वेव मुख्यं कर्म जनाधिप\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2206336, "chapter_id": 5394, "verse_number": "२", "content_sanskrit": "मदस्यास्यमनुप्राप्ता यदा सेन्द्रा दिवौकसः ।\nतदेयं च्यवनेनेह हृता तेषां वसुन्धरा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2206337, "chapter_id": 5394, "verse_number": "३", "content_sanskrit": "उभौ लोकौ हृतौ मत्वा ते देवा दुःखिताभवन् ।\nशोकार्ताश्च महात्मानं ब्रह्माणं शरणं ययुः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2206338, "chapter_id": 5394, "verse_number": "", "content_sanskrit": "देवाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2206339, "chapter_id": 5394, "verse_number": "४", "content_sanskrit": "मदास्यव्यतिषिक्तानामस्माकं लोकपूजित ।\nच्यवनेन हृता भूमिः कपैश्चापि दिवं प्रभो\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2206340, "chapter_id": 5394, "verse_number": "", "content_sanskrit": "ब्रह्मा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2206341, "chapter_id": 5394, "verse_number": "५", "content_sanskrit": "गच्छध्वं शरणं विप्रानाशु सेन्द्रा दिवौकसः ।\nप्रसाद्य तानुभौ लोकाववाप्स्यथ यथा पुरा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2206342, "chapter_id": 5394, "verse_number": "६", "content_sanskrit": "ते ययुः शरणं विप्रांस्त ऊचुः कान् जयामहे ।\nइत्युक्तास्ते द्विजान् प्राहुर्जयतेह कपानिति ।\nभूगतान् हि विजेतारो वयमित्येव पार्थिव\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2206343, "chapter_id": 5394, "verse_number": "७", "content_sanskrit": "ततः कर्म समारब्धं ब्राह्मणैः कपनाशनम् ।\nतच्छ्रुत्वा प्रेषितो दूतो ब्राह्मणेभ्यो धनी कपैः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2206344, "chapter_id": 5394, "verse_number": "८", "content_sanskrit": "स च तान् ब्राह्मणानाह धनी कपवचो यथा ।\nभवद्भिः सदृशाः सर्वे कपाः किमिह वर्तते\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2206345, "chapter_id": 5394, "verse_number": "९", "content_sanskrit": "सर्वे वेदविदः प्राज्ञाः सर्वे च क्रतुयाजिनः ।\nसर्वे सत्यव्रताश्चैव सर्वे तुल्या महर्षिभिः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2206346, "chapter_id": 5394, "verse_number": "१०", "content_sanskrit": "श्रीश्चैव रमते तेषु धारयन्ति श्रियं च ते ।\nवृथा दारान् न गच्छन्ति निवृत्ता मांसभक्षणे\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2206347, "chapter_id": 5394, "verse_number": "११", "content_sanskrit": "दीप्तमग्निं जुह्वति च गुरूणां वचने स्थिताः ।\nसर्वे च नियतात्मानो बालानां संविभागिनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2206348, "chapter_id": 5394, "verse_number": "१२", "content_sanskrit": "उपेत्य शकटैर्यान्ति न सेवन्ते रजस्वलाः ।\nअभुक्तवत्सु नाश्नन्ति दिवा चैव न शेरते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2206349, "chapter_id": 5394, "verse_number": "१३", "content_sanskrit": "एतैश्चान्यैश्च बहुभिर्गुणैर्युक्तान् कथं कपान् ।\nविजेष्यथ निवर्तध्वं निवृत्तानां शुभं हि वः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2206350, "chapter_id": 5394, "verse_number": "", "content_sanskrit": "ब्राह्मणाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2206351, "chapter_id": 5394, "verse_number": "१४", "content_sanskrit": "कपान् वयं विजेष्यामो ये देवास्ते वयं स्मृताः ।\nतस्माद् वध्याः कपास्माकं धनिन् याहि यथागतम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2206352, "chapter_id": 5394, "verse_number": "१५", "content_sanskrit": "धनी गत्वा कपानाह न वो विप्राः प्रियङ्कराः ।\nगृहीत्वाऽस्त्राण्यथो विप्रान् कपाः सर्वे समाद्रवन्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2206353, "chapter_id": 5394, "verse_number": "१६", "content_sanskrit": "समुदग्रध्वजान् दृष्ट्वा कपान् सर्वे द्विजातयः ।\nव्यसृजन् ज्वलितानग्नीन् कपानां प्राणनाशनान्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2206354, "chapter_id": 5394, "verse_number": "१७", "content_sanskrit": "ब्रह्मसृष्टा हव्यभुजः कपान् भुक्त्वा सनातनाः ।\nनभसीव यथाभ्राणि व्यभ्राजन्त नराधिप ।\nप्रशशंसुर्द्विजांश्चैव ब्रह्माणं च यशस्विनम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2206355, "chapter_id": 5394, "verse_number": "१८", "content_sanskrit": "तेषां तेजस्तथा वीर्यं देवानां ववृधे ततः ।\nअवाप्नुवंश्च देवत्वं त्रिषु लोकेषु पूजितम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2206356, "chapter_id": 5394, "verse_number": "१९", "content_sanskrit": "इत्युक्तवचनं वायुमर्जुनः प्रत्यभाषत ।\nप्रतिपूज्य महाबाहो यत्तच्छृणु नराधिप\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2206357, "chapter_id": 5394, "verse_number": "२०", "content_sanskrit": "जीवाम्यहं ब्राह्मणार्थे सर्वथा सततं प्रभो ।\nब्रह्मणे ब्राह्मणेभ्यश्च प्रणमामि च नित्यशः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2206358, "chapter_id": 5394, "verse_number": "२१", "content_sanskrit": "दत्तात्रेयप्रसादाच्च मया प्राप्तमिदं यशः ।\nलोके च परमा कीर्तिर्धर्मश्च परमो महान्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2206359, "chapter_id": 5394, "verse_number": "२२", "content_sanskrit": "अहो ब्राह्मणकर्माणि यथा मारुत तत्त्वतः ।\nत्वया प्रोक्तानि कार्त्स्न्येन श्रुतानि प्रयतेन ह\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2206360, "chapter_id": 5394, "verse_number": "", "content_sanskrit": "वायुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2206361, "chapter_id": 5394, "verse_number": "२३", "content_sanskrit": "ब्राह्मणान् क्षत्रधर्मेण पालयस्वेन्द्रियाणि च ।\nभृगुभ्यस्ते भयं घोरं तत् तु कालाद् भविष्यति\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2206362, "chapter_id": 5394, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम्\nअनुशासनपर्वणि दानधर्मे पवनार्जुनसंवादे ब्राह्मणप्रशंसा नाम पञ्चचत्वारिंशोत्तरद्विशततमोऽध्यायः ॥२४५॥\nपवनार्जुनसंवादः समाप्तः ॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}]