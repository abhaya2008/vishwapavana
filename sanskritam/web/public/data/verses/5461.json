[{"id": 2208810, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208811, "chapter_id": 5461, "verse_number": "१", "content_sanskrit": "अभिजानामि जगतः कर्तारं त्वां जनार्दन ।\nनूनं भवत्प्रसादोऽयमिति मे नात्र संशयः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208812, "chapter_id": 5461, "verse_number": "२", "content_sanskrit": "चित्तं च सुप्रसन्नं मे त्वद्भावगतमच्युत ।\nविनिवृत्तश्च मे शाप इति विद्धि यदूत्तम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208813, "chapter_id": 5461, "verse_number": "३", "content_sanskrit": "यदि त्वनुग्रहं कञ्चित् त्वत्तोऽर्होऽहं जनार्दन ।\nद्रष्टुमिच्छामि ते रूपं वैष्णवं मां निदर्शय ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208814, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208815, "chapter_id": 5461, "verse_number": "४", "content_sanskrit": "ततः स तस्मै प्रीतात्मा दर्शयामास तद् वपुः ।\nशाश्वतं वैष्णवं धीमान् यद् ददर्श धनञ्जयः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208816, "chapter_id": 5461, "verse_number": "५", "content_sanskrit": "स ददर्श महात्मानं विश्वरूपं महाभुजम् ।\nविस्मयं च ययौ विप्रस्तद् दृष्ट्वा रूपमैश्वरम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208817, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208818, "chapter_id": 5461, "verse_number": "६", "content_sanskrit": "नमो नमस्ते सर्वात्मन् नारायण परात्पर ।\nपरमात्मन् पद्मनाभ पुण्डरीकाक्ष माधव ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208819, "chapter_id": 5461, "verse_number": "७", "content_sanskrit": "हिरण्यगर्भरूपाय संसारोत्तारणाय च ।\nपुरुषाय पुराणाय चान्तर्यामाय ते नमः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208820, "chapter_id": 5461, "verse_number": "८", "content_sanskrit": "अविद्यातिमिरादित्यं भवव्याधिमहौषधिम् ।\nसंसारार्णवपारं त्वां प्रणमामि गतिर्भव ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208821, "chapter_id": 5461, "verse_number": "९", "content_sanskrit": "सर्ववेदैकवेद्याय सर्वदेवमयाय च ।\nवासुदेवाय नित्याय नमो भक्तप्रियाय ते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208822, "chapter_id": 5461, "verse_number": "१०", "content_sanskrit": "दयया दुःखमोहान्मां समुद्धर्तुमिहार्हसि ।\nकर्मभिर्बहुभिः पापैर्बद्धं पाहि जनार्दन ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208823, "chapter_id": 5461, "verse_number": "११", "content_sanskrit": "विश्वरूप नमस्तेऽस्तु यस्य ते रूपमैश्वरम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208824, "chapter_id": 5461, "verse_number": "१२", "content_sanskrit": "पद्भ्यां ते पृथिवी व्याप्ता शिरसा चावृतं नभः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208825, "chapter_id": 5461, "verse_number": "१३", "content_sanskrit": "द्यावापृथिव्योर्यन्मध्यं जठरेण तदावृतम् ।\nभुजाभ्यामावृताश्चाशास्त्वमिदं सर्वमच्युत ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208826, "chapter_id": 5461, "verse_number": "१४", "content_sanskrit": "संहरस्व पुनर्देव रूपमक्षय्यमुत्तमम् ।\nपुनस्त्वां स्वेन रूपेण द्रष्टुमिच्छामि शाश्वतम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208827, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208828, "chapter_id": 5461, "verse_number": "१५", "content_sanskrit": "तमुवाच प्रसन्नात्मा गोविन्दो जनमेजय ।\nवरं वृणीष्वेति तदा तमुदङ्कोऽब्रवीदिदम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2208829, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2208830, "chapter_id": 5461, "verse_number": "१६", "content_sanskrit": "पर्याप्त एष एवाद्य वरस्त्वत्तो महाद्युते ।\nयत् ते रूपमिदं कृष्ण पश्यामि प्रभवाप्ययम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2208831, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2208832, "chapter_id": 5461, "verse_number": "१७", "content_sanskrit": "तमब्रवीत् पुनः कृष्णो मा त्वमत्र विचारय ।\nअवश्यमेतत् कर्तव्यममोघं दर्शनं मम ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2208833, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2208834, "chapter_id": 5461, "verse_number": "१८", "content_sanskrit": "अवश्यं करणीयं चेद् यदेवं मन्यसे विभो ।\nतोयमिच्छामि यत्रेष्टं मरुष्वेतद्धि दुर्लभम् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2208835, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2208836, "chapter_id": 5461, "verse_number": "१९", "content_sanskrit": "ततः संहृत्य तत् तेजः प्रोवाचोदङ्कमीश्वरः ।\nएष्टव्ये सति चिन्त्योऽहमित्युक्त्वा द्वारकां ययौ ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2208837, "chapter_id": 5461, "verse_number": "२०", "content_sanskrit": "ततः कदाचिद् भगवान् उदङ्कस्तोयकाङ्क्षया ।\nतृषितः परिचक्राम मरौ सस्मर चाच्युतम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2208838, "chapter_id": 5461, "verse_number": "२१", "content_sanskrit": "ततो दिग्वाससं धीमान् मातङ्गं मलपङ्किनम् ।\nअपश्यत मरौ तस्मिन् श्वगणैः परिवारतिम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2208839, "chapter_id": 5461, "verse_number": "२२", "content_sanskrit": "भीषणं बद्धनिस्त्रिंशं बाणकार्मुकधारिणम् ।\nतस्याथ स्रोतसोऽपश्यद् वारि भूरि द्विजोत्तमः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2208840, "chapter_id": 5461, "verse_number": "२३", "content_sanskrit": "स्मरन्तं स च तं प्राह मातङ्गः प्रहसन्निव ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2208841, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "मातङ्गः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2208842, "chapter_id": 5461, "verse_number": "२४", "content_sanskrit": "एह्युदङ्क प्रतीच्छस्व मत्तो वारि भृगूद्वह ।\nकृपा हि मे सुमहती त्वां दृष्ट्वा तृट्समन्वितम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2208843, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2208844, "chapter_id": 5461, "verse_number": "२५", "content_sanskrit": "इत्युक्तस्तेन स मुनिः तत्तोयं नाभ्यनन्दत ।\nचुकोप च स तं धीमान् वाग्भिरुग्राभिरच्युतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2208845, "chapter_id": 5461, "verse_number": "२६", "content_sanskrit": "पुनः पुनश्च मातङ्गः पिबस्वेति तमब्रवीत् ।\nन चापिबत् स च क्रोधात् क्षुभितेनान्तरात्मना ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2208846, "chapter_id": 5461, "verse_number": "२७", "content_sanskrit": "स तथा निश्चयात् तेन प्रत्याख्यातो महामनाः ।\nश्वभिः सह महाराज तत्रैवान्तरधीयत ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2208847, "chapter_id": 5461, "verse_number": "२८", "content_sanskrit": "उदङ्कस्तं तथा दृष्ट्वा ततो व्रीडितमानसः ।\nमेने प्रलब्धमात्मानं कृष्णेनामिततेजसा ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2208848, "chapter_id": 5461, "verse_number": "२९", "content_sanskrit": "अथ तेनैव मार्गेण शङ्खचक्रगदाधरः ।\nआजगाम महाबाहुरुदङ्कश्चैनमब्रवीत् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2208849, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "उदङ्कः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2208850, "chapter_id": 5461, "verse_number": "३०", "content_sanskrit": "न युक्तं तादृशं दातुं त्वया पुरुषसत्तम ।\nसलिलं विप्रमुख्येभ्यो मातङ्गस्रोतसा विभो ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2208851, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2208852, "chapter_id": 5461, "verse_number": "३१", "content_sanskrit": "इत्युक्तवचनं तं तु महाबुद्धिर्जनार्दनः ।\nउदङ्कं श्लक्ष्णया वाचा सान्त्वयन्निदमब्रवीत् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2208853, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2208854, "chapter_id": 5461, "verse_number": "३२", "content_sanskrit": "यादृशेनैव रूपेण योग्यं दातुमनेन वै ।\nतादृशं खलु ते दत्तं त्वं तु तन्नावबुध्यसे ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2208855, "chapter_id": 5461, "verse_number": "३३", "content_sanskrit": "मया त्वदर्थमुक्तो हि वज्रपाणिः पुरन्दरः ।\nउदङ्कायामृतं देहि तोयरूपमिति प्रभुः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2208856, "chapter_id": 5461, "verse_number": "३४", "content_sanskrit": "स मामुवाच देवेन्द्रो न मर्त्योऽमर्त्यतां व्रजेत् ।\nअन्यमस्मै वरं देहीत्यसकृद् भृगुनन्दन ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2208857, "chapter_id": 5461, "verse_number": "३५", "content_sanskrit": "अमृतं देयमित्येव मयोक्तः स शचीपतिः ।\nस मां प्रसाद्य देवेन्द्रः पुनरेवेदमब्रवीत् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2208858, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "देवेन्द्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2208859, "chapter_id": 5461, "verse_number": "३६", "content_sanskrit": "यदि देयमवश्यं चेन्मातङ्गोऽहं महाद्युते ।\nभूत्वाऽमृतं प्रदास्यामि भार्गवाय महात्मने ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2208860, "chapter_id": 5461, "verse_number": "३७", "content_sanskrit": "यद्येतत् प्रतिगृह्णाति भार्गवोऽमृतमद्य वै ।\nप्रदातुमेष गच्छामि भार्गवायामृतं विभो ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2208861, "chapter_id": 5461, "verse_number": "३८", "content_sanskrit": "प्रत्याख्यातस्त्वहं तेन न दास्यामीति भार्गव ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2208862, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2208863, "chapter_id": 5461, "verse_number": "३९", "content_sanskrit": "स तथा समयं कृत्वा तेन रूपेण वासवः ।\nउपस्थितस्त्वया चापि प्रत्याख्यातोऽमृतं ददत् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2208864, "chapter_id": 5461, "verse_number": "४०", "content_sanskrit": "चाण्डालरूपी भगवान् सुमहांस्ते व्यतिक्रमः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2208865, "chapter_id": 5461, "verse_number": "४१", "content_sanskrit": "यत्तु शक्यं मया कर्तुं भूय एव तवेप्सितम् ।\nतोयेप्सा तव दुर्धर्षां करिष्ये सफलामहम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2208866, "chapter_id": 5461, "verse_number": "४२", "content_sanskrit": "येष्वहःसु तव ब्रह्मन् सलिलेप्सा भविष्यति ।\nतदा मरौ भविष्यन्ति जलपूर्णाः पयोधराः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2208867, "chapter_id": 5461, "verse_number": "४३", "content_sanskrit": "रसवच्च प्रदास्यन्ति तोयं ते भृगुनन्दन ।\nउदङ्कमेघा इत्युक्ताः ख्यातिं यास्यन्ति चापि ते ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2208868, "chapter_id": 5461, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2208869, "chapter_id": 5461, "verse_number": "४४", "content_sanskrit": "इत्युक्तः प्रीतिमान् विप्रः कृष्णेन स बभूव ह ।\nअद्याप्युदङ्कमेघाश्च मरौ वर्षन्ति भारत ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2208870, "chapter_id": 5461, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि उदङ्कस्य जलदानप्रकारकथनं नाम पञ्चपञ्चाशोऽध्यायः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]