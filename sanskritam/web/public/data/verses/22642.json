[{"id": 7002642000, "chapter_id": 22642, "verse_number": "६-२०-१", "content_sanskrit": "सूत उवाच ।\nइति श्रुत्वा स वैतालो नृपं प्राह पुनः कथाम् ।\nविशालनगरे रम्ये विपुलेशो महीपतिः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002642001, "chapter_id": 22642, "verse_number": "६-२०-२", "content_sanskrit": "तस्य ग्रामेवसद्वैश्योर्थदत्तोविपणे रतः ।\nअनंगमंजरी कन्या तस्य जाता मनोरमा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002642002, "chapter_id": 22642, "verse_number": "६-२०-३", "content_sanskrit": "सुवर्णनाम्ने वैश्याय पिता वै दत्तवान्स्वयम् ।\nकदाचित्कमलग्रामात्सुवर्णो द्वीपमागमत् ।\nद्रव्यलाभाय न्यवसच्चिरं कालं स लुब्धवान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002642003, "chapter_id": 22642, "verse_number": "६-२०-४", "content_sanskrit": "अनंगमंजरीगेहे दैवयोगाद्द्विजोत्तमः ।\nकमलाकरनामासौ कृत्ययोगात्समागतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002642004, "chapter_id": 22642, "verse_number": "६-२०-५", "content_sanskrit": "होमांते सुन्दरी नारी मार्जनार्थे सुता गता ।\nदृष्ट्वा तां कामकलिकां मुमोह द्विजसत्तमः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002642005, "chapter_id": 22642, "verse_number": "६-२०-६", "content_sanskrit": "सुतापि मदघूर्णाक्षी विप्राय समयं ददौ ।\nनिशीथे तमौद्भूते त्वं मां प्राप्य सुखी भव ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002642006, "chapter_id": 22642, "verse_number": "६-२०-७", "content_sanskrit": "इति श्रुत्वा द्विजो वाक्यं तस्या ध्यानं तदाकरोत् ।\nकामाग्निना चिरं तप्तः सुष्वाप परमासने ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002642007, "chapter_id": 22642, "verse_number": "६-२०-८", "content_sanskrit": "अर्द्धरात्रे तु सा नारी द्विजागमनतत्परा ।\nमार्गमन्वेषमाणा सा प्रियस्य स्मरपीडिता ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002642008, "chapter_id": 22642, "verse_number": "६-२०-९", "content_sanskrit": "नागतः स द्विजो दैवात्तदा सा मरणं गता ।\nकमलाकर एवाशु समयान्ते समाययौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002642009, "chapter_id": 22642, "verse_number": "६-२०-१०", "content_sanskrit": "दृष्ट्वा मृत्युवशां सुभ्रूं स्वयं मरणमागतः ।\nप्रभाते चार्थदत्तो वै दाहयामास तां शुचा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002642010, "chapter_id": 22642, "verse_number": "६-२०-११", "content_sanskrit": "सुवर्णश्च तदागत्य विललाप प्रियां प्रति ।\nचितायां भस्मसाद्भूत्वा स्वर्गलोके तु सा ययौ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002642011, "chapter_id": 22642, "verse_number": "६-२०-१२", "content_sanskrit": "इत्युक्त्वा स तु वैतालो नृपतिं प्राह विक्रमम् ।\nकस्य स्नेहोऽधिकस्तेषां कुतः स्वर्गपुरं ययौ ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002642012, "chapter_id": 22642, "verse_number": "६-२०-१३", "content_sanskrit": "राजोवाच ।\nपति स्नेहोधिकस्तेषां मध्यमौ नारिविप्रकौ ।\nद्विजस्नेहेन सा नारी मृता स्वर्गपुरं ययौ ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002642013, "chapter_id": 22642, "verse_number": "६-२०-१४", "content_sanskrit": "वैश्यवर्णैः सदा पूज्यो ब्राह्मणो ब्रह्ममूर्तिमान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002642014, "chapter_id": 22642, "verse_number": "६-२०-१५", "content_sanskrit": "द्विजोऽपि नाप्तवान्नारीं तदा स्वर्गगतिं हरिम् ।\nहृदि कृत्वा च निधनं प्राप्तो ह्यस्मात्त्रिविष्टपम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002642015, "chapter_id": 22642, "verse_number": "६-२०-१६", "content_sanskrit": "सुवर्णो हृदि संज्ञाय मत्प्रिया ब्रह्मवत्सला ।\nमां त्यक्ता तु दिवं याता वह्निदाहप्रभावतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]