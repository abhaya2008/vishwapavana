[{"id": 2005090, "chapter_id": 1100, "verse_number": "१-१०१-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2005091, "chapter_id": 1100, "verse_number": "१-१०१-१", "content_sanskrit": "दुष्यन्ताद्भरतो राज्यं यथान्यायमवाप सः।\nतस्य तत्प्रथितं कर्म प्रावर्तत महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2005092, "chapter_id": 1100, "verse_number": "१-१०१-२", "content_sanskrit": "भास्वरं दिव्यमजितं लोकसंनादनं महत्।\nस विजित्य महीपालांश्चकार वशवर्तिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2005093, "chapter_id": 1100, "verse_number": "१-१०१-३", "content_sanskrit": "चचार च सतां धर्मं प्राप्य चानुत्तमं यशः।\nस राजा चक्रवर्त्यासीत्सार्वभौमः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2005094, "chapter_id": 1100, "verse_number": "१-१०१-४", "content_sanskrit": "ईजे च बहुभिर्यज्ञैर्यथा शक्रो मरुत्पतिः।\nयाजयामास तं कण्वो दक्षवद्भूरिदक्षिणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2005095, "chapter_id": 1100, "verse_number": "१-१०१-५", "content_sanskrit": "श्रीमद्गोविततं नाम वाजिमेधमवाप सः।\nयस्मिन्सहस्रं पद्मानां कण्वाय भरतो ददौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2005096, "chapter_id": 1100, "verse_number": "१-१०१-६", "content_sanskrit": "सोऽश्वमेधशतैरीजे यमुनामनु तीरगः।\nत्रिशतैश्च सरस्वत्यां गङ्गामनु चतुःशतैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2005097, "chapter_id": 1100, "verse_number": "१-१०१-७", "content_sanskrit": "दौष्यन्तिर्भरतो यज्ञैरीजे शाकुन्तलो नृपः।\nतस्माद्भरतवंशस्य विप्रतस्थे महद्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2005098, "chapter_id": 1100, "verse_number": "१-१०१-८", "content_sanskrit": "भरतस्य वरस्त्रीषु पुत्राः संजज्ञिरे पृथक्।\nनाभ्यनन्दत्तदा राजा नानुरूपा ममेति तान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2005099, "chapter_id": 1100, "verse_number": "१-१०१-९", "content_sanskrit": "ततस्तान्मातरः क्रुद्धाः पुत्रान्निन्युर्यमक्षयम्।\nततस्तस्य नरेन्द्रस्य वितथं पुत्रजन्म तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2005100, "chapter_id": 1100, "verse_number": "१-१०१-१०", "content_sanskrit": "ततो महद्भिः क्रतुभिरीजानो भरतस्तदा।\nलेभे पुत्रं भरद्पाजाद्भुमन्युं नाम भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2005101, "chapter_id": 1100, "verse_number": "१-१०१-११", "content_sanskrit": "ततः पुत्रिणमात्मानं ज्ञात्वा पौरवनन्दनः।\nभुमन्युं भरतश्रेष्ठ यौवराज्येऽभ्यषेचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2005102, "chapter_id": 1100, "verse_number": "१-१०१-१२", "content_sanskrit": "ततो दिविरथो नाम भुमन्योरभवत्सुतः।\nसुहोत्रश्च सुहोता च सुहविः सुयजुस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2005103, "chapter_id": 1100, "verse_number": "१-१०१-१३", "content_sanskrit": "पुष्करिण्यामृचीकश्च भुमन्योरभवन्सुताः।\nतेषां ज्येष्ठः सुहोत्रस्तु राज्यमाप महीक्षिताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2005104, "chapter_id": 1100, "verse_number": "१-१०१-१४", "content_sanskrit": "राजसूयाश्वमेधाद्यैः सोऽयजद्बहुभिः सवैः।\nसुहोत्रः पृथिवीं कृत्स्नां बुभुजे सागराम्बराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2005105, "chapter_id": 1100, "verse_number": "१-१०१-१५", "content_sanskrit": "पूर्णां हस्तिगवाश्वैश्च बहुरत्नसमाकुलाम्।\nममज्जेव मही तस्य भूरिभारावपीडिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2005106, "chapter_id": 1100, "verse_number": "१-१०१-१६", "content_sanskrit": "हस्त्यश्वरथसंपूर्णा मनुष्यकलिला भृशम्।\nसुहोत्रे राजनि तदा धर्मतः शासति प्रजाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2005107, "chapter_id": 1100, "verse_number": "१-१०१-१७", "content_sanskrit": "चैत्ययूपाङ्किता चासीद्भूमिः शतसहस्रशः।\nप्रवृद्धजनसस्या च सर्वदैव व्यरोचत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2005108, "chapter_id": 1100, "verse_number": "१-१०१-१८", "content_sanskrit": "ऐक्ष्वाकी जनयामास सुहोत्रात्पृथिवीपतेः।\nअजमीढं सुमीढं च पुरुमीढं च भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2005109, "chapter_id": 1100, "verse_number": "१-१०१-१९", "content_sanskrit": "अजमीढो वरस्तेषां तस्मिन्वंशः प्रतिष्ठितः।\nषट् पुत्रान्सोप्यजनयत्तिसृषु स्त्रीषु भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2005110, "chapter_id": 1100, "verse_number": "१-१०१-२०", "content_sanskrit": "ऋक्षं धूमिन्यथो नीली दुष्यन्तपरमेष्ठइनौ।\nकेशिन्यजनयज्जह्नुं सुतौ च जनरूषिणौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2005111, "chapter_id": 1100, "verse_number": "१-१०१-२१", "content_sanskrit": "विदुः संवरणं वीरमृक्षाद्राथन्तरीसुतम्।\nतथेमे सर्वपञ्चाला दुष्यन्तपरमेष्ठिनोः।\nअन्वयाः कुशिका राजञ्जन्होरमिततेजसः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2005112, "chapter_id": 1100, "verse_number": "१-१०१-२२", "content_sanskrit": "जनरूषणयोर्ज्येष्ठमृक्षमाहुर्जनाधिपम्।\nऋक्षात्संवरणो जज्ञे राजन्वंशकरस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2005113, "chapter_id": 1100, "verse_number": "१-१०१-२३", "content_sanskrit": "आर्क्षे संवरणे राजन्प्रशासति वसुन्धराम्।\nसंक्षयः सुमहानासीत्प्रजानामिति नः श्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2005114, "chapter_id": 1100, "verse_number": "१-१०१-२४", "content_sanskrit": "व्यशीर्यत ततो राष्ट्रं क्षयैर्नानाविधैस्तदा।\nक्षुन्मृत्युभ्यामनावृष्ट्या व्याधिभिश्च समाहतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2005115, "chapter_id": 1100, "verse_number": "१-१०१-२५", "content_sanskrit": "अभ्यघ्नन्भारतांश्चैव सपत्नानां बलानि च।\nचालयन्वसुधां चेमां बलेन चतुरङ्गिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2005116, "chapter_id": 1100, "verse_number": "१-१०१-२६", "content_sanskrit": "अभ्ययात्तं च पाञ्चल्यो विजित्य तरसा महीम्।\nअक्षौहिणीभिर्दशभिः स एनं समरेऽजयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2005117, "chapter_id": 1100, "verse_number": "१-१०१-२७", "content_sanskrit": "ततः सदारः सामात्यः सपुत्रः ससुहृज्जनः।\nराजा संवरणस्तस्मात्पलायत महाभयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2005118, "chapter_id": 1100, "verse_number": "१-१०१-२८", "content_sanskrit": "ते प्रतीचीं पराभूताः प्रपन्ना भारता दिशम्।\nसिन्धोर्नदस्य महतो निकुञ्जे न्यवसंस्तदा।\nनदीविपयपर्यन्ते पर्वतस्य समीपतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2005119, "chapter_id": 1100, "verse_number": "१-१०१-२९", "content_sanskrit": "तत्रावसन्बहून्कालान्भारता दुर्गमाश्रिताः।\nतेषां निवसतां तत्र सहस्रं परिवत्सरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2005120, "chapter_id": 1100, "verse_number": "१-१०१-३०", "content_sanskrit": "अथाभ्यगच्छद्भरतान्वसिष्ठो भगवानृषिः।\nतमागतं प्रयत्नेन प्रत्युद्गम्याभिवाद्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2005121, "chapter_id": 1100, "verse_number": "१-१०१-३१", "content_sanskrit": "अर्घ्यमभ्याहरंस्तस्मै ते सर्वे भारतास्तदा।\nनिवेद्य सर्वमृषये सत्कारेण सुवर्चसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2005122, "chapter_id": 1100, "verse_number": "१-१०१-३२", "content_sanskrit": "तमासने चोपविष्टं राजा वव्रे स्वयं तदा।\nपुरोहितो भवान्नोऽस्तु राज्याय प्रयतेमहि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2005123, "chapter_id": 1100, "verse_number": "१-१०१-३३", "content_sanskrit": "ओमित्येवं वसिष्ठोऽपि भारतान्प्रत्यपद्यत।\nअथाभ्यषिञ्चत्साम्राज्ये सर्वक्षत्रस्य पौरवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2005124, "chapter_id": 1100, "verse_number": "१-१०१-३४", "content_sanskrit": "विषाणभूतं सर्वस्यां पृथिव्यामिति नः श्रुतम्।\nभरताध्युषितं पूर्वं सोऽध्यतिष्ठत्पुरोतोतमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2005125, "chapter_id": 1100, "verse_number": "१-१०१-३५", "content_sanskrit": "पुनर्बलिभृतश्चैव चक्रे सर्वमहीक्षितः।\nततः स पृथिवीं प्राप्य पुनरीजे महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2005126, "chapter_id": 1100, "verse_number": "१-१०१-३६", "content_sanskrit": "आजमीढो महायज्ञैर्बहुभिर्भूरिदक्षिणैः।\nततः संवरणात्सौरी तपती सुषुवे कुरुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2005127, "chapter_id": 1100, "verse_number": "१-१०१-३७", "content_sanskrit": "राजत्वे तं प्रजाः सर्वा धर्मज्ञ इति वव्रिरे।\nमहिम्ना तस्य कुरवो लेभिरे प्रत्ययं भृशम्।\nतस्य नाम्नाऽभिविख्यातं पृथिव्यां कुरुजाङ्गलं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2005128, "chapter_id": 1100, "verse_number": "१-१०१-३८", "content_sanskrit": "कुरुक्षेत्रं स तपसा पुण्यं चक्रे महातपाः।\nअश्ववन्तमभिष्यन्तं तथा चैत्ररथं मुनिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2005129, "chapter_id": 1100, "verse_number": "१-१०१-३९", "content_sanskrit": "जनमेजयं च विख्यातं पुत्रांश्चास्यानुशुश्रुम।\nपञ्चैतान्वाहिनी पुत्रान्व्यजायत मनस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2005130, "chapter_id": 1100, "verse_number": "१-१०१-४०", "content_sanskrit": "अविक्षितः परिक्षित्तु शबलाश्वस्तु वीर्यवान्।\nआदिराजो विराजश्च शाल्मलिश्च महाबलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2005131, "chapter_id": 1100, "verse_number": "१-१०१-४१", "content_sanskrit": "उच्चैःश्रवा भङ्गकारो जितारिश्चाष्टमः स्मृतः।\nएतेषामन्ववाये तु ख्यातास्ते कर्मजैर्गुणैः।\nजनमेजयादयः सप्त तथैवान्ये महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2005132, "chapter_id": 1100, "verse_number": "१-१०१-४२", "content_sanskrit": "परीक्षितोऽभवन्पुत्राः सर्वे धर्मार्थकोविदाः।\nकक्षसेनोग्रसेनौ तु चित्रसेनश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2005133, "chapter_id": 1100, "verse_number": "१-१०१-४३", "content_sanskrit": "इन्द्रसेनः सुषेणश्च भीमसेनश्च नामतः।\nजनमेजयस्य तनया भुवि ख्याता महाबलाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2005134, "chapter_id": 1100, "verse_number": "१-१०१-४४", "content_sanskrit": "धृतराष्ट्रः प्रथमजः पाण्डुर्बाह्लीक एव च।\nनिषधश्च महातेजास्तथा जाम्बूनदो बली॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2005135, "chapter_id": 1100, "verse_number": "१-१०१-४५", "content_sanskrit": "कुण्डोदरः पदातिश्च वसातिश्चाष्टमः स्मृतः।\nसर्वे धर्मार्थकुशलाः सर्वभूतहिते रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2005136, "chapter_id": 1100, "verse_number": "१-१०१-४६", "content_sanskrit": "धृतराष्ट्रोऽथ राजासीत्तस्य पुत्रोऽथ कुण्डिकः।\nहस्ती वितर्कः क्राथश्च कुण्डिनश्चापि पञ्चमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2005137, "chapter_id": 1100, "verse_number": "१-१०१-४७", "content_sanskrit": "हविश्रवास्तथेन्द्राभो भुमन्युश्चापराजितः।\nधृतराष्ट्रसुतानां तु त्रीनेतान्प्रथितान्भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2005138, "chapter_id": 1100, "verse_number": "१-१०१-४८", "content_sanskrit": "प्रतीपं धर्मनेत्रं च सुनेत्रं चापि भारत।\nप्रतीपः प्रथितस्तेषां बभूवाप्रतिमो भुवि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2005139, "chapter_id": 1100, "verse_number": "१-१०१-४९", "content_sanskrit": "प्रतीपस्य त्रयः पुत्रा जज्ञिरे भरतर्षभ।\nदेवापिः शन्तनुश्चैव बाह्लीकश्च महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2005140, "chapter_id": 1100, "verse_number": "१-१०१-५०", "content_sanskrit": "देवापिस्तु प्रवव्राज तेषां धर्महितेप्सया।\nशन्तनुश्च महीं लेभे बाह्लीकश्च महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2005141, "chapter_id": 1100, "verse_number": "१-१०१-५१", "content_sanskrit": "भरतस्यान्वयास्त्वेते देवकल्पा महारथाः।\nबभूवुर्ब्रह्मकल्पाश्च बहवो राजसत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2005142, "chapter_id": 1100, "verse_number": "१-१०१-५२", "content_sanskrit": "एवंविधा महाभागा देवरूपाः प्रहारिणः।\nअन्ववाये महाराज ऐलवंशविवर्धनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2005143, "chapter_id": 1100, "verse_number": "१-१०१-५३", "content_sanskrit": "गङ्गातीरं समागम्य दीक्षितो जनमेजय।\nअश्वमेधसहस्राणि वाजपेयशतानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2005144, "chapter_id": 1100, "verse_number": "१-१०१-५४", "content_sanskrit": "पुनरीजे महायज्ञैः समाप्तवरदक्षिणैः।\nअग्निष्टोमातिरात्राणामुक्थानां सोमवत्पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2005145, "chapter_id": 1100, "verse_number": "१-१०१-५५", "content_sanskrit": "वाजपेयेष्टिसत्राणां सहस्रैश्च सुसंभृतैः।\nदृष्ट्वा शाकुन्तलो राजा तर्पयित्वा द्विजान्धनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2005146, "chapter_id": 1100, "verse_number": "१-१०१-५६", "content_sanskrit": "पुनः सहस्रं पद्मानां कण्वाय भरतो ददौ।\nजम्बूनदस्य शुद्धस्य कनकस्य महायशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2005147, "chapter_id": 1100, "verse_number": "१-१०१-५७", "content_sanskrit": "यस्य यूपाः शतव्यामाः परिणाहेऽथ काञ्चनाः।\nसहस्रव्याममुद्वृद्धाः सेन्द्रैर्देवैः समुच्छ्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2005148, "chapter_id": 1100, "verse_number": "१-१०१-५८", "content_sanskrit": "स्वलङ्कृता भ्राजमानाः सर्वरत्नैर्मनोरमैः।\nहिरण्यं द्विरदानश्वान्महिषोष्ट्रगजाविकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2005149, "chapter_id": 1100, "verse_number": "१-१०१-५९", "content_sanskrit": "दासीदासं धनं धान्यं गाः सुशीलाः सवत्सकाः।\nभूमिं यूपसहस्राङ्कां कण्वाय बहुदक्षिणाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2005150, "chapter_id": 1100, "verse_number": "१-१०१-६०", "content_sanskrit": "बहूनां ब्रह्मकल्पानां धनं दत्त्वा क्रतून्बहून्।\nग्रामान्गृहाणि शुभ्राणि कोटिशोथाददत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2005151, "chapter_id": 1100, "verse_number": "१-१०१-६१", "content_sanskrit": "भरताद्भारती कीर्तिर्येनेदं भारतं कुलम्।\nभरतस्यान्वये जाता देवकल्पा महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2005152, "chapter_id": 1100, "verse_number": "१-१०१-६२", "content_sanskrit": "बहवो ब्रह्मकल्पाश्च बभूवुः क्षत्रसत्तमाः।\nतेषामपरिमेयानि नामधेयानि सन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2005153, "chapter_id": 1100, "verse_number": "१-१०१-६३", "content_sanskrit": "तेषां कुले यथा मुख्यान्कीर्तयिष्यामि भारत।\nमहाभागान्देवकल्पान्सत्यार्जवपरायणान्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2005154, "chapter_id": 1100, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि एकोत्तरशततमोऽध्यायः॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}]