[{"id": 2039336, "chapter_id": 1864, "verse_number": "५-१०९-०x", "content_sanskrit": "सुपर्ण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2039337, "chapter_id": 1864, "verse_number": "५-१०९-१", "content_sanskrit": "इयं विवस्वदा पूर्वं श्रौतेन विधिना किल।\nगुरवे दक्षिणा दत्ता दक्षिणेत्युच्यते च दिक् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2039338, "chapter_id": 1864, "verse_number": "५-१०९-२", "content_sanskrit": "अत्र लोकत्रयस्यास्य पितृपक्षः प्रतिष्ठितः।\nअत्रोष्मपाणां देवानां निवासः श्रूयते द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2039339, "chapter_id": 1864, "verse_number": "५-१०९-३", "content_sanskrit": "अत्र विश्वे सदा देवाः पितृभिः सार्धमासते।\nइज्यमानाः स्म लोकेषु संप्राप्तास्तुल्यभागताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2039340, "chapter_id": 1864, "verse_number": "५-१०९-४", "content_sanskrit": "एतद्द्वितीयं देवस्य द्वारमाचक्षते द्विज।\nत्रुटिशो लवशश्चापि गण्यते कालनिश्चयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2039341, "chapter_id": 1864, "verse_number": "५-१०९-५", "content_sanskrit": "अत्र देवर्षयो नित्यं पितृलोकर्षयस्तथा।\nतथा राजर्षयः सर्वे निवसन्ति गतव्यथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2039342, "chapter_id": 1864, "verse_number": "५-१०९-६", "content_sanskrit": "अत्र धर्मश्च सत्यं च कर्म चात्र निगद्यते।\nगतिरेषा द्विजश्रेष्ठ कर्मणामवसायिनाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2039343, "chapter_id": 1864, "verse_number": "५-१०९-७", "content_sanskrit": "एषा दिक्सा द्विजश्रेष्ठ यां सर्वः प्रतिपद्यते।\nवृता त्वनवबोधेन सुखं तेन न गम्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2039344, "chapter_id": 1864, "verse_number": "५-१०९-८", "content_sanskrit": "नैर्ऋतानां सहस्रामि बहून्यत्र द्विजर्षभ ।\nसृष्टानि प्रतिकूलानि द्रष्टव्यान्यकृतात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2039345, "chapter_id": 1864, "verse_number": "५-१०९-९", "content_sanskrit": "अत्र मन्दरकुञ्जेषु विप्रर्षिसदनेषु च।\nगायन्ति गाथा गन्धर्वाश्चित्तबुद्धिहरा द्विज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2039346, "chapter_id": 1864, "verse_number": "५-१०९-१०", "content_sanskrit": "अत्र सामानि गाथाभिः श्रुत्वा गीतानि रैवतः ।\nगतदारो गतामात्यो गतराज्यो वनं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2039347, "chapter_id": 1864, "verse_number": "५-१०९-११", "content_sanskrit": "अत्र सावर्मिना चैव यवक्रीतात्मजेन च।\nमर्यादा स्थापिता ब्रह्मन्यां सूर्यो नातिवर्तते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2039348, "chapter_id": 1864, "verse_number": "५-१०९-१२", "content_sanskrit": "अत्र राक्षसराजेन पौलस्त्येन महात्मना ।\nरावणेन तपः कृत्वा सुरेभ्योऽमरता वृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2039349, "chapter_id": 1864, "verse_number": "५-१०९-१३", "content_sanskrit": "अत्र वृत्तेन वृत्रोऽपि शक्रशत्रुत्वमेयिवान् ।\nअत्र सर्वासवः प्राप्ताः पुनर्गच्छन्ति पञ्चधा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2039350, "chapter_id": 1864, "verse_number": "५-१०९-१४", "content_sanskrit": "अत्र दुष्कृतकर्माणो नराः पच्यन्ति गालव ।\nअत्र वैतरणी नाम नदी वैतरणैर्वृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2039351, "chapter_id": 1864, "verse_number": "५-१०९-१५", "content_sanskrit": "अत्र गत्वा सुखस्यान्तं दुःखस्यान्तं प्रपद्यते।\nअत्रावृत्तो दिनकरः सुरसं क्षरते पयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2039352, "chapter_id": 1864, "verse_number": "५-१०९-१६", "content_sanskrit": "काष्ठां चासाद्य वासिष्ठीं हिममुत्सृजते पुनः।\nअत्राहं गालव पुरा क्षुधाऽऽर्तः परिचिन्तयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2039353, "chapter_id": 1864, "verse_number": "५-१०९-१७", "content_sanskrit": "लब्धवान्युध्यमानौ द्वौ बृहन्तौ गजकच्छपौ ।\nअत्र चक्रधनुर्नाम सूर्याञ्जातो महानृषिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2039354, "chapter_id": 1864, "verse_number": "५-१०९-१८", "content_sanskrit": "विदुर्यं कपिलं देवं येनार्ताः सगरात्मजाः ।\nअत्र सिद्धाः शिवा नाम ब्राह्मणा वेदपारगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2039355, "chapter_id": 1864, "verse_number": "५-१०९-१९", "content_sanskrit": "अधीत्य सकलान्वेदाँल्लेभिरे मोक्षमक्षयम्।\nअत्र भोगवती नाम पुरी वासुकिपालिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2039356, "chapter_id": 1864, "verse_number": "५-१०९-२०", "content_sanskrit": "तक्षकेण च नागेन तथैवैरावतेन च।\nअत्र निर्याणकालेऽपि तमः संप्राप्यते महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2039357, "chapter_id": 1864, "verse_number": "५-१०९-२१", "content_sanskrit": "अभेद्यं भास्करेणापि स्वयं वा कृष्णवर्त्मना ।\nएष तस्यापि ते मार्गः परिचारस्य गालव ।\nब्रूहि मे यदि गन्तव्यं प्रतीचीं शृणु चापराम् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2039358, "chapter_id": 1864, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभरते उद्योगपर्वणि भगवद्यानपर्वणि नवाधिकशततमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]