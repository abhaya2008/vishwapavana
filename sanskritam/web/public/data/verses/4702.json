[{"id": 2174196, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2174197, "chapter_id": 4702, "verse_number": "१", "content_sanskrit": "ततः क्रुद्धा महाराज सौबलस्य पदानुगाः ।\nत्यक्त्वा जीवितमाक्रन्दे पाण्डवान् पर्यवारयन्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2174198, "chapter_id": 4702, "verse_number": "२", "content_sanskrit": "तानर्जुनः प्रत्यगृह्णाद् सहदेवजये धृतः ।\nभीमसेनश्च तेजस्वी क्रुद्धाशीविषदर्शनः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2174199, "chapter_id": 4702, "verse_number": "३", "content_sanskrit": "शक्त्यृष्टिप्रासहस्तानां सहदेवं जिघांसताम् ।\nसङ्कल्पमकरोन्मोघं गाण्डीवेन धनञ्जयः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2174200, "chapter_id": 4702, "verse_number": "४", "content_sanskrit": "प्रगृहीतायुधान् बाहून् योधानामभिधावताम् ।\nभल्लैश्चिच्छेद बीभत्सुः शिरांस्यपि भुजानपि\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2174201, "chapter_id": 4702, "verse_number": "५", "content_sanskrit": "ते हताः प्रत्यपद्यन्त वसुधां विगतासवः ।\nत्वरता लोकवीरेण निहताः सव्यसाचिना\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2174202, "chapter_id": 4702, "verse_number": "६", "content_sanskrit": "ततो दुर्योधनो राजा दृष्ट्वा स्वबलसङ्क्षयम् ।\nहतशेषान् समानीय रथान् नवशतान् विभो\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2174203, "chapter_id": 4702, "verse_number": "७", "content_sanskrit": "कुञ्जरांश्च हयांश्चैव पादातांश्च परन्तपः ।\nउवाच दुखितान् सर्वान् धार्तराष्ट्रो महीपतिः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2174204, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2174205, "chapter_id": 4702, "verse_number": "८", "content_sanskrit": "समासाद्य रणे सर्वान् पाण्डवान् ससुहृद्गणान् ।\nपाञ्चाल्यं चापि सबलं हत्वा शीघ्रं निवर्तत\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2174206, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2174207, "chapter_id": 4702, "verse_number": "९", "content_sanskrit": "तस्यैते शिरसा गृह्य शासनं युद्धदुर्मदाः ।\nप्रत्युद्ययू रणे पार्थान् तव पुत्रस्य शासनात्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2174208, "chapter_id": 4702, "verse_number": "१०", "content_sanskrit": "तानभ्यापततः शीघ्रं हतशेषान् महारणे ।\nशरैराशीविषाकारैः पाण्डवाः समवाकिरन्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2174209, "chapter_id": 4702, "verse_number": "११", "content_sanskrit": "ततः सैन्यं समरे तस्मिन् मुहूर्तेन महात्मभिः ।\nअविध्यत रणं प्राप्य त्रातारं नाभ्यविन्दत\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2174210, "chapter_id": 4702, "verse_number": "१२", "content_sanskrit": "पलायमानं तु भयान्नावतिष्ठति दंसितम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2174211, "chapter_id": 4702, "verse_number": "१३", "content_sanskrit": "अश्वैर्विपरिधावद्भिः सैन्येन रजसा वृते ।\nन प्राज्ञायन्त समरे दिशश्च प्रदिशस्तथा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2174212, "chapter_id": 4702, "verse_number": "१४", "content_sanskrit": "ततस्तु पाण्डवानीकान्निःसृत्य बहवो जनाः ।\nअभ्यघ्नन् तावकान् युद्धे मुहूर्तादिव भारत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2174213, "chapter_id": 4702, "verse_number": "१५", "content_sanskrit": "ततो निःशेषमभवत् तव सैन्यं विशाम्पते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2174214, "chapter_id": 4702, "verse_number": "१६", "content_sanskrit": "अक्षोहिण्यः समेतास्तु तव पुत्रस्य भारत ।\nएकादश हता युद्धे ताः प्रभो पाण्डुसृञ्जयैः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2174215, "chapter_id": 4702, "verse_number": "१७", "content_sanskrit": "तेषु राजसहस्रेषु तावकेषु महात्मसु ।\nएको दुर्योधनो राजन्नदृश्यत भृशं क्षतः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2174216, "chapter_id": 4702, "verse_number": "१८", "content_sanskrit": "ततो वीक्ष्य दिशः सर्वा दृष्ट्वा शून्यां च मेदिनीम् ।\nविहीनः सर्वयोधैश्च पाण्डवान् वीक्ष्य संयुगे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2174217, "chapter_id": 4702, "verse_number": "१९", "content_sanskrit": "मुदितान् सर्वसिद्धार्थान् नर्दमानान् समन्ततः ।\nबाणशब्दरवांश्चैव श्रुत्वा तेषां महात्मनाम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2174218, "chapter_id": 4702, "verse_number": "२०", "content_sanskrit": "दुर्योधनो महाराज कश्मलेनाभिसंवृतः ।\nअपयाने मनश्चक्रे विहीनबलवाहनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2174219, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "धृतराष्ट्रः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2174220, "chapter_id": 4702, "verse_number": "२१", "content_sanskrit": "निहते मामके सैन्ये निःशेषे शिबिरे कृते ।\nपाण्डवानां बलं सूत किं शेषमभवत् तदा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2174221, "chapter_id": 4702, "verse_number": "२२", "content_sanskrit": "एतन्मे पृच्छतो ब्रूहि कुशलो ह्यसि सञ्जय\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2174222, "chapter_id": 4702, "verse_number": "२३", "content_sanskrit": "यश्च दुर्योधनो मन्दः कृतवांस्तनयो मम ।\nबलक्षयं तदा दृष्ट्वाऽकुशलः पृथिवीपतिः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2174223, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2174224, "chapter_id": 4702, "verse_number": "२४", "content_sanskrit": "द्वे सहस्रे रथानां तु सप्त नागशतानि च ।\nपञ्च चाश्वसहस्राणि पत्तीनामयुतं तथा\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2174225, "chapter_id": 4702, "verse_number": "२५", "content_sanskrit": "एतच्छेषमभूद् राजन् पाण्डवानां बलं तदा ।\nपरिगृह्य हि यद्युद्धे धृष्टद्युम्नो व्यवस्थितः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2174226, "chapter_id": 4702, "verse_number": "२६", "content_sanskrit": "एकाकी भरतश्रेष्ठ ततो दुर्योधनो नृपः ।\nनापश्यत् समरे कञ्चित् सहायं रथिनां वरः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2174227, "chapter_id": 4702, "verse_number": "२७", "content_sanskrit": "नर्दमानान् परान् दृष्ट्वा स्वबलस्य च सङ्क्षयम् ।\nदृष्ट्वा भरतशार्दूल कश्मलेनाभिसंवृतः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2174228, "chapter_id": 4702, "verse_number": "२८", "content_sanskrit": "हतं स्वहयमुत्सृज्य प्रोत्प्लुत्य प्राद्रवद् भयात्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2174229, "chapter_id": 4702, "verse_number": "२९", "content_sanskrit": "एकादश चमूभर्ता पुत्रो दुर्योधनस्तव ।\nगदामादाय तेजस्वी पदातिः प्रस्थितो ह्रदम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2174230, "chapter_id": 4702, "verse_number": "३०", "content_sanskrit": "नातिदूरं ततो गत्वा पद्भ्यामेव जनाधिपः ।\nसस्मार वचनं क्षत्तुः धर्मशीलस्य धीमतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2174231, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2174232, "chapter_id": 4702, "verse_number": "३१", "content_sanskrit": "इदं नूनं महाप्राज्ञो विदुरो दृष्टवान् पुरा ।\nमहद्व्यसनमस्माकं क्षत्रियाणां च सर्वशः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2174233, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2174234, "chapter_id": 4702, "verse_number": "३२", "content_sanskrit": "एवं विचिन्तयानश्च प्रविवेश ह्रदं नृप ।\nदुःखसन्तप्तहृदयो दृष्ट्वा राजन् बलक्षयम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2174235, "chapter_id": 4702, "verse_number": "३३", "content_sanskrit": "दशैकाक्षोहिणीभर्ता स्वयं दुर्योधनोऽपि सन् ।\nप्राप्तवान् व्यसनं तीव्रं दैवं हि बलवत्तरम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2174236, "chapter_id": 4702, "verse_number": "३४", "content_sanskrit": "पाण्डवाः तु महाराज धृष्टद्युम्नपुरोगमाः ।\nअभ्यधावन्त सङ्क्रुद्धाः तव राजन् बलं प्रति\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2174237, "chapter_id": 4702, "verse_number": "३५", "content_sanskrit": "शक्त्यृष्टिप्रासहस्तानां योधानामभिगर्जताम् ।\nसङ्कल्पमकरोन्मोघं गाण्डीवेन धनञ्जयः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2174238, "chapter_id": 4702, "verse_number": "३६", "content_sanskrit": "तान् हत्वा निशितैर्बाणैः सामात्यान् सह बन्धुभिः ।\nरथे श्वेतहये तिष्ठन्नर्जुनो बह्वशोभत\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2174239, "chapter_id": 4702, "verse_number": "३७", "content_sanskrit": "सुबलस्य हते पुत्रे सवाजिरथकुञ्जरे ।\nमहावनमिव च्छिन्नमभवत् तावकं बलम्\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2174240, "chapter_id": 4702, "verse_number": "३८", "content_sanskrit": "अनेकशतसाहस्रे बले दुर्योधनार्जिते ।\nनान्यो महारथो राजन् जीवमानोऽप्यदृश्यत\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2174241, "chapter_id": 4702, "verse_number": "३९", "content_sanskrit": "द्रोणपुत्रादृते वीरान् तथैव कृतवर्मणः ।\nकृपाच्च गौतमाद् राजन् पार्थिवाच्च तवात्मजात्\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2174242, "chapter_id": 4702, "verse_number": "४०", "content_sanskrit": "धृष्टद्युम्नस्तु मां दृष्ट्वा हसन् सात्यकिमब्रवीत्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2174243, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "धृष्टद्युम्नः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2174244, "chapter_id": 4702, "verse_number": "४१", "content_sanskrit": "किमनेन गृहीतेन नानेनार्थोऽस्ति जीवता\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2174245, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2174246, "chapter_id": 4702, "verse_number": "४२", "content_sanskrit": "धृष्टद्युम्नवचः श्रुत्वा शिनेर्नप्ता महारथः ।\nउद्यम्य निशितं खड्गं हन्तुं मामुद्यतस्तदा\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2174247, "chapter_id": 4702, "verse_number": "४३", "content_sanskrit": "तदाऽऽगम्य महाप्राज्ञः कृष्णद्वैपायनोऽब्रवीत्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2174248, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2174249, "chapter_id": 4702, "verse_number": "४४", "content_sanskrit": "मुच्यतां सञ्जयो जीवन् न हन्तव्यः कथञ्चन\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2174250, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2174251, "chapter_id": 4702, "verse_number": "४५", "content_sanskrit": "द्वैपायनवचः श्रुत्वा शिनेर्नप्ता कृताञ्जलिः ।\nततो मामब्रवीन्मुक्त्वा स्वस्ति सञ्जय साधय\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2174252, "chapter_id": 4702, "verse_number": "४६", "content_sanskrit": "अनुज्ञातो ह्यहं तेन न्यस्तवर्मा निरायुधः ।\nप्रातिष्ठं येन नगरं सायाह्ने रुधिरोक्षितः\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2174253, "chapter_id": 4702, "verse_number": "४७", "content_sanskrit": "क्रोशमात्रमपक्रान्तं गदापाणिमवस्थितम् ।\nएकं दुर्योधनं राजन्नपश्यं भृशविक्षतम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2174254, "chapter_id": 4702, "verse_number": "४८", "content_sanskrit": "स तु मामश्रुपूर्णाक्षो नाशक्नोदभिवीक्षितुम् ।\nउपप्रैक्षत मां दृष्ट्वा तदा दीनमुपस्थितम्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2174255, "chapter_id": 4702, "verse_number": "४९", "content_sanskrit": "तं चाहमनुशोचानो दृष्ट्वैकाकिनमाहवे ।\nमुहूर्तं नाशकं वक्तुं किञ्चिद् दुःखपरिप्लुतः\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2174256, "chapter_id": 4702, "verse_number": "५०", "content_sanskrit": "यस्य मूर्धाभिषिक्तानां सहस्रं मणिमौलिनाम् ।\nआहृत्य च करं सर्वं स्वस्य वै वशमागतम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2174257, "chapter_id": 4702, "verse_number": "५१", "content_sanskrit": "चतुःसागरपर्यन्ता पृथिवी रत्नभूषिता ।\nकर्णेनैकेन यस्यार्थे करमाहारिता पुरा\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2174258, "chapter_id": 4702, "verse_number": "५२", "content_sanskrit": "यस्याज्ञा परराष्ट्रेषु कर्णेनैव प्रसारिता ।\nनाभवद् यस्य शस्त्रेषु खेदो राज्ञः प्रशासतः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2174259, "chapter_id": 4702, "verse_number": "५३", "content_sanskrit": "आसीनो हस्तिनापुरे क्षेमं राज्यमकण्टकम् ।\nअन्वपालयदैश्वर्यात् कुबेरमपि नास्मरत्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2174260, "chapter_id": 4702, "verse_number": "५४", "content_sanskrit": "भवनाद् भवनं राजन् प्रयातुः पृथिवीपते ।\nदेवालयप्रवेशे च पन्था यस्य हिरण्मयः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2174261, "chapter_id": 4702, "verse_number": "५५", "content_sanskrit": "पताकावृतसूर्यांशुः तोरणोच्छ्रितशोभनः ।\nप्रयाणे पृथिवीभर्तुर्धन्यानामभवन् गृहाः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2174262, "chapter_id": 4702, "verse_number": "५६", "content_sanskrit": "आरुह्यैरावतप्रख्यं नागमिन्द्रसमो बली ।\nविभूत्या सुमहत्या यः प्रयाति पृथिवीपतिः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2174263, "chapter_id": 4702, "verse_number": "५७", "content_sanskrit": "तं भृशक्षतमिन्द्राभं पद्भ्यामेव धरातळे ।\nतिष्ठन्तमेकं दृष्ट्वा तु ममाभूत् क्लेश उत्तमः\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2174264, "chapter_id": 4702, "verse_number": "५८", "content_sanskrit": "तस्य चैवंविधस्यास्य जगन्नाथस्य भूपतेः ।\nविपदप्रतिमाऽभूद्या बलीयान् विधिरेव हि\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2174265, "chapter_id": 4702, "verse_number": "५९", "content_sanskrit": "ततोऽस्य तदहं सर्वमुक्तवान् नृपतेस्तदा ।\nद्वैपायनप्रसादाच्च जीवतो मोक्षमाहवे\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2174266, "chapter_id": 4702, "verse_number": "६०", "content_sanskrit": "स मुहूर्तमिव ध्यात्वा प्रतिलभ्य च चेतनाम् ।\nभ्रातॄंश्च सर्वसैन्यांश्च पर्यपृच्छत मां ततः\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2174267, "chapter_id": 4702, "verse_number": "६१", "content_sanskrit": "तस्मै तदहमाचक्षे सर्वं प्रत्यक्षदर्शिवान् ।\nभ्रातॄणां निधनं सर्वं सैन्यानां च निपातनम्\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2174268, "chapter_id": 4702, "verse_number": "६२", "content_sanskrit": "त्रयः किल रथाः शिष्टाः तावकानां नराधिप ।\nइति प्रस्थानकाले मां कृष्णद्वैपायनोऽब्रवीत्\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2174269, "chapter_id": 4702, "verse_number": "६३", "content_sanskrit": "स दीर्घमिव निःश्वस्य सम्प्रेक्ष्य च पुनः पुनः ।\nअंसे मां पाणिना गृह्य पुत्रस्ते पर्यभाषत\t॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2174270, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2174271, "chapter_id": 4702, "verse_number": "६४", "content_sanskrit": "त्वदन्यो नेह सङ्ग्रामे कश्चिज्जीवति सञ्जय ।\nद्वितीयं नैव पश्यामि ससहायाश्च पाण्डवाः\t॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2174272, "chapter_id": 4702, "verse_number": "६५", "content_sanskrit": "ब्रूयाः सञ्जय राजानं प्रज्ञाचक्षुषमीश्वरम् ।\nदुर्योधनस्तव पुत्रः प्रविष्टो ह्रदमित्युत\t॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2174273, "chapter_id": 4702, "verse_number": "६६", "content_sanskrit": "सुहृद्भिस्तादृशैर्हीनः पुत्रैर्भ्रातृभिरेव च ।\nपाण्डवैश्च हृते राज्ये को नु जीवेत मादृशः\t॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2174274, "chapter_id": 4702, "verse_number": "६७", "content_sanskrit": "आचक्षेथाः सर्वमिदं मां च मुक्तं महाभयात् ।\nअस्मिंस्तोयह्रदे सुप्तं जीवन्तं भृशविक्षतम्\t॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2174275, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2174276, "chapter_id": 4702, "verse_number": "६८", "content_sanskrit": "एवमुक्त्वा महाराज प्राविशत् तं ह्रदं नृप ।\nअस्तम्भयत तोयं च मायया मनुजाधिपः\t॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2174277, "chapter_id": 4702, "verse_number": "६९", "content_sanskrit": "तस्मिन् ह्रदं प्रविष्टे तु त्रीन् रथान् श्रान्तवाहनान् ।\nअपश्यं सहितानेकः तं देशं समुपेयुषः\t॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2174278, "chapter_id": 4702, "verse_number": "७०", "content_sanskrit": "कृपं शारद्वतं वीरं द्रौणिं च रथिनां वरम् ।\nभोजं च कृतवर्माणं सहितान् शरविक्षतान्\t॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2174279, "chapter_id": 4702, "verse_number": "७१", "content_sanskrit": "ते सर्वे मामभिप्रेक्ष्य तूर्णमश्वानचोदयन् ।\nउपेत्य चैव मामूचुर्दिष्ट्या जीवसि सञ्जय\t॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2174280, "chapter_id": 4702, "verse_number": "७२", "content_sanskrit": "अपृच्छंश्चैव मां सर्वे पुत्रं तव जनाधिपम् ।\nकच्चिद् दुर्योधनो राजा स नो जीवति सञ्जय\t॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2174281, "chapter_id": 4702, "verse_number": "७३", "content_sanskrit": "आख्यातवानहं तेभ्यः तदा कुशलिनं नृपम् ।\nतच्चैव सर्वमाचक्षे यन्मां दुर्योधनोऽब्रवीत्\t॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2174282, "chapter_id": 4702, "verse_number": "७४", "content_sanskrit": "ह्रदं चैवाचचक्षेऽहं यं प्रविष्टो जनाधिपः\t॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2174283, "chapter_id": 4702, "verse_number": "७५", "content_sanskrit": "अश्वत्थामा तु तद् राजन् निशम्य वचनं मम ।\nह्रदप्रवेशं श्रुत्वा च करुणं पर्यदेवयत्\t॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2174284, "chapter_id": 4702, "verse_number": "७६", "content_sanskrit": "अहो धिक् स न जानाति जीवतोऽस्मान् नराधिपः ।\nपर्याप्ता हि वयं तेन सह योधयितुं परान्\t॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2174285, "chapter_id": 4702, "verse_number": "७७", "content_sanskrit": "ते तु तत्र चिरं कालं विलप्य च महारथाः ।\nप्राद्रवन् रथिनां श्रेष्ठा दृष्ट्वा पाण्डुसुतान् रणे\t॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2174286, "chapter_id": 4702, "verse_number": "७८", "content_sanskrit": "ते तु मां रथमारोप्य कृपस्य तु परिक्षतम् ।\nसेनानिवेशमाजग्मुर्हतशेषास्त्रयो रथाः\t॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2174287, "chapter_id": 4702, "verse_number": "७९", "content_sanskrit": "तत्र गुल्माः परिक्षिप्ताः सूर्ये चास्तमिते सति ।\nसर्वे विचुक्रुशुः श्रुत्वा पुत्राणां तव सङ्क्षयम्\t॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2174288, "chapter_id": 4702, "verse_number": "८०", "content_sanskrit": "ततो वृद्धा महाराज योषितां रक्षणे रताः ।\nराजदारानुपादाय प्रययुर्नगरं प्रति\t॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2174289, "chapter_id": 4702, "verse_number": "८१", "content_sanskrit": "तत्र विक्रोशतीनां च रुदन्तीनां च निःस्वनः ।\nप्रादुरासीन्महाघोरः श्रुत्वा तं बलसङ्क्षयम्\t॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2174290, "chapter_id": 4702, "verse_number": "८२", "content_sanskrit": "ततस्तु योषितो राजन् क्रन्दन्त्यो वै मुहुर्मुहुः ।\nकुरर्य इव शब्देन नादयन्त्यो महीतळम्\t॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2174291, "chapter_id": 4702, "verse_number": "८३", "content_sanskrit": "आजघ्नुः करजैश्चापि पाणिभिश्च शिरांस्युत ।\nलुलुवुश्च तदा केशान् क्रोशन्त्यस्त्रत्र तत्र ह\t॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2174292, "chapter_id": 4702, "verse_number": "८४", "content_sanskrit": "हाहाकारं विकुर्वाणा विनिघ्नन्त्य उरांसि च ।\nक्रोशन्त्यस्त्रत्र रुरुदुः क्रन्दमाना विशाम्पते\t॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2174293, "chapter_id": 4702, "verse_number": "८५", "content_sanskrit": "ततो दुर्योधनामात्याः सास्रकण्ठा भृशातुराः ।\nराजदारानुपादाय प्रययुर्नगरं प्रति\t॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2174294, "chapter_id": 4702, "verse_number": "८६", "content_sanskrit": "वेत्रझर्झरहस्ताश्च द्वाराध्यक्षा विशाम्पते ।\nशयनीयानि शुभ्राणि मृद्वास्तरणवन्ति च\t॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2174295, "chapter_id": 4702, "verse_number": "८७", "content_sanskrit": "समादाय ययुस्तूर्णं नगरं जनरक्षिणः\t॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2174296, "chapter_id": 4702, "verse_number": "८८", "content_sanskrit": "आस्थायाश्वतरीयुक्तान् स्यन्दनानपरे पुनः ।\nस्वान् स्वान् दारानुपादाय प्रययुर्नगरं प्रति\t॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2174297, "chapter_id": 4702, "verse_number": "८९", "content_sanskrit": "अदृष्टपूर्वा या नार्यो भास्करेणापि वेश्मसु ।\nददृशुस्ता महाराज जना यान्तीः पुरं प्रति\t॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2174298, "chapter_id": 4702, "verse_number": "९०", "content_sanskrit": "ताः स्त्रियो भरतश्रेष्ठ सौकुमार्यसमन्विताः ।\nप्रययुर्नगरं तूर्णं हतस्वजनबान्धवाः\t॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2174299, "chapter_id": 4702, "verse_number": "९१", "content_sanskrit": "आगोपालाविपालेभ्यो द्रवन्तो नगरं प्रति ।\nययुर्मनुष्याः सम्भ्रान्ता भीमसेनभयार्दिताः\t॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2174300, "chapter_id": 4702, "verse_number": "९२", "content_sanskrit": "अपि चैषां भयं तीव्रं पार्थेभ्योऽभूत् सुदारुणम् ।\nप्रेक्षमाणस्तदाऽन्योन्यमधावन् नगरं प्रति\t॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2174301, "chapter_id": 4702, "verse_number": "९३", "content_sanskrit": "तस्मिंस्तदा वर्तमाने विप्लवे भृशदारुणे ।\nयुयुत्सुः शोकसम्मूढः प्राप्तकालमचिन्तयन्\t॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2174302, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "युयुत्सुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2174303, "chapter_id": 4702, "verse_number": "९४", "content_sanskrit": "जितो दुर्योधनः सङ्खे पाण्डवैर्भीमविक्रमैः ।\nएकादशचमूभर्ता भ्रातरश्चास्य सूदिताः\t॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2174304, "chapter_id": 4702, "verse_number": "९५", "content_sanskrit": "हताश्च कुरवः सर्वे भीष्मद्रोणपुरःसराः ।\nअहमेको विमुक्तश्च भाग्ययोगाद् यदृच्छया\t॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2174305, "chapter_id": 4702, "verse_number": "९६", "content_sanskrit": "विद्रुतानि च सैन्यानि शिबिराद् वै समन्ततः\t॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2174306, "chapter_id": 4702, "verse_number": "९७", "content_sanskrit": "दुर्योधनस्य सचिवा ये केचिदवशेषिताः ।\nराजदारानुपादाय व्यधावन् नगरं प्रति\t॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2174307, "chapter_id": 4702, "verse_number": "९८", "content_sanskrit": "प्राप्तकालमहं मन्ये प्रवेशं तैः सहाभि भो ।\nयुधिष्ठिरमनुज्ञाप्य वासुदेवं तथैव च\t॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2174308, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2174309, "chapter_id": 4702, "verse_number": "९९", "content_sanskrit": "एवमेतन्महाबाहुरुभयोः सन्न्यवेदयत्\t॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2174310, "chapter_id": 4702, "verse_number": "१००", "content_sanskrit": "तस्य प्रीतोऽभवद् राजा नित्यं करुणवेदिनः ।\nपरिष्वज्य महाबाहुर्वेश्यापुत्रं व्यसर्जयत्\t॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2174311, "chapter_id": 4702, "verse_number": "१०१", "content_sanskrit": "ततः स रथमास्थाय द्रुतमश्वानचोदयत् ।\nसम्भावयित्वा तांश्चापि राजदारान् पुरं प्रति\t॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2174312, "chapter_id": 4702, "verse_number": "१०२", "content_sanskrit": "तैश्चैव सहितः क्षिप्रमस्तं गच्छति भास्करे ।\nप्रविष्टो हस्तिनपुरं बाष्पकण्ठाश्रुलोचनः\t॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2174313, "chapter_id": 4702, "verse_number": "१०३", "content_sanskrit": "अपश्यच्च महाप्राज्ञं विदुरं साश्रुलोचनम् ।\nराज्ञः समीपान्निष्क्रान्तं शोकोपहतचेतसम्\t॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2174314, "chapter_id": 4702, "verse_number": "१०४", "content_sanskrit": "तमब्रवीत् सत्यधृतिः प्रणतं त्वग्रतः स्थितम्\t॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 2174315, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 2174316, "chapter_id": 4702, "verse_number": "१०५", "content_sanskrit": "अस्मिन् कुरुक्षये वृत्ते दिष्ट्या त्वं पुत्र जीवसि ।\nविना राज्ञः प्रवेशाद्वै किमसि त्वमिहागतः\t॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 2174317, "chapter_id": 4702, "verse_number": "१०६", "content_sanskrit": "एतद् वै कारणं सर्वं विस्तरेण निवेदय\t॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 2174318, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "युयुत्सुः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 2174319, "chapter_id": 4702, "verse_number": "१०७", "content_sanskrit": "निहते शकुनौ तात सज्ञातिसुतबान्धवे ।\nहतशेषपरीवारो राजा दुर्योधनस्ततः\t॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 2174320, "chapter_id": 4702, "verse_number": "१०८", "content_sanskrit": "स्वकं हयं समुत्सृज्य प्राङ्मुखः प्राद्रवद् भयात्\t॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 2174321, "chapter_id": 4702, "verse_number": "१०९", "content_sanskrit": "अपक्रान्ते तु नृपतौ स्कन्धावारनिवेशनात् ।\nभयव्याकुलितं सैन्यं प्राद्रवन्नगरं प्रति\t॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 2174322, "chapter_id": 4702, "verse_number": "११०", "content_sanskrit": "ततो राज्ञः कळत्राणि भ्रातॄणां चापि सर्वशः ।\nवाहनेषु समारोप्य स्त्र्यध्यक्षाः प्राद्रवन् भयात्\t॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 2174323, "chapter_id": 4702, "verse_number": "१११", "content_sanskrit": "ततोऽहं समनुज्ञाप्य राजानं सहकेशवम् ।\nप्रविष्टो हस्तिनापुरं रक्षन् लोकस्य वाच्यताम्\t॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 2174324, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 2174325, "chapter_id": 4702, "verse_number": "११२", "content_sanskrit": "एतच्छ्रुत्वा तु वचनं वेश्यापुत्रेण भाषितम् ।\nप्राप्तकालमिति ज्ञात्वा विदुरः सर्वधर्मवित्\t॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 2174326, "chapter_id": 4702, "verse_number": "११३", "content_sanskrit": "अपूजयदमेयात्मा युयुत्सुं वाक्यकोविदम्\t॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 2174327, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "विदुरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 2174328, "chapter_id": 4702, "verse_number": "११४", "content_sanskrit": "प्राप्तकालमिदं सर्वं भवतो भरतक्षये ।\nसंस्मृतः कुलधर्मश्च सानुक्रोशतया तदा\t॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 2174329, "chapter_id": 4702, "verse_number": "११५", "content_sanskrit": "अद्याहमपि विश्रान्तः श्वो गन्तास्मि युधिष्ठिरम्\t॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 2174330, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 2174331, "chapter_id": 4702, "verse_number": "११६", "content_sanskrit": "एतावदुक्त्वा वचनं विदुरः सर्वधर्मवित् ।\nयुयुत्सुं समनुज्ञाप्य विवेश नृपतेः क्षयम्\t॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 2174332, "chapter_id": 4702, "verse_number": "११७", "content_sanskrit": "पौरजानपदैर्दुखाद् हाहेति भृशनादितम् ।\nनिरानन्दं गतश्रीकं हृतनागमिवाशयम्\t॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 2174333, "chapter_id": 4702, "verse_number": "११८", "content_sanskrit": "शून्यरूपमवध्वस्तं दृष्ट्वा ध्वस्तरतोऽभवत्\t॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 2174334, "chapter_id": 4702, "verse_number": "११९", "content_sanskrit": "विदुरः सर्वधर्मज्ञो व्याकुलेनान्तरात्मना ।\nविवेश नृपतेर्वेश्म निशश्वास शनैः शनैः\t॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 2174335, "chapter_id": 4702, "verse_number": "१२०", "content_sanskrit": "युयुत्सुरपि तां रात्रिं स्वगृहे न्यवसत् तदा\t॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 2174336, "chapter_id": 4702, "verse_number": "१२१", "content_sanskrit": "वन्द्यमानः स्वकैश्चापि नाभ्यनन्दत् सुदुःखितः ।\nचिन्तयानो महाराज हतानां च परस्परम्\t॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 2174337, "chapter_id": 4702, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशल्यपर्वणि शकुनिवधो नाम एकोनत्रिंशोऽध्यायः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 2174338, "chapter_id": 4702, "verse_number": "१", "content_sanskrit": "ह्रदप्रवेशपर्वणि प्रथमोऽध्यायः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 2174339, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "॥ समाप्तं ह्रदप्रवेशपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 2174340, "chapter_id": 4702, "verse_number": "", "content_sanskrit": "॥ समाप्तं शल्यपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}]