[{"id": 2140991, "chapter_id": 4042, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140992, "chapter_id": 4042, "verse_number": "१", "content_sanskrit": "ततः शान्तनवस्तत्र धर्मार्थकुशलं हितम् ।\nदुर्योधनमिदं वाक्यमब्रवीत् कुरुसन्निधौ\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140993, "chapter_id": 4042, "verse_number": "२", "content_sanskrit": "साधु पश्यति वै द्रोणः कृपः साध्वनुपश्यति ।\nआचार्यपुत्रः सहजं निश्चितं साधु भाषते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140994, "chapter_id": 4042, "verse_number": "३", "content_sanskrit": "कर्णस्तु क्षत्रधर्मेण केवलं योद्धुमिच्छति ।\nआचार्यो नावमन्तव्यः पुरुषेण विजानता\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140995, "chapter_id": 4042, "verse_number": "४", "content_sanskrit": "देशकालौ तु सम्प्रेक्ष्य योद्धव्यमिति मे मतिः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140996, "chapter_id": 4042, "verse_number": "५", "content_sanskrit": "यस्य सूर्यसमाः पञ्च सपत्नाः स्युः प्रहारिणः ।\nकथमभ्युदये तेषां न प्रमुह्येत पण्डितः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140997, "chapter_id": 4042, "verse_number": "६", "content_sanskrit": "स्वार्थे हि सर्वे मुह्यन्ति येऽपि धर्मविदो जनाः ।\nतस्मात् तत्त्वं न जानाति यत्तु कार्यं नराधिपः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140998, "chapter_id": 4042, "verse_number": "७", "content_sanskrit": "धार्तराष्ट्रोऽपि दुर्बुद्धिः पश्यन्नपि धनञ्जयम् ।\nनैव पश्यति नाघ्राति मन्दः क्रोधवशं गतः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140999, "chapter_id": 4042, "verse_number": "८", "content_sanskrit": "एवमुक्त्वा तु राजानं पुनर्द्रौणिमथाब्रवीत् ।\nप्राञ्जलिर्भरतश्रेष्ठः साम्ना बुद्धिमतां वरः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2141000, "chapter_id": 4042, "verse_number": "९", "content_sanskrit": "कर्णो यद्यदवोचद्धि तेजःसञ्जननाय नः ।\nआचार्यपुत्रः क्षमतां महत् कार्यमुपस्थितम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2141001, "chapter_id": 4042, "verse_number": "१०", "content_sanskrit": "नायं कालो विरोधस्य कौन्तेये समुपस्थिते ।\nक्षन्तव्यं भवता सर्वमाचार्येण कृपेण च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2141002, "chapter_id": 4042, "verse_number": "११", "content_sanskrit": "बलस्य व्यसनान्याहुर्यानि वीरा मनीषिणः ।\nमुख्यं भेदं तु तेषां च पापिष्ठं विदुषां मतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2141003, "chapter_id": 4042, "verse_number": "१२", "content_sanskrit": "भवत्सु हि कृतास्त्रत्वं यथाऽऽदित्ये प्रभा तथा ।\nयथा चन्द्रमसो लक्ष्मीः सर्वथा नापकृष्यते\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2141004, "chapter_id": 4042, "verse_number": "१३", "content_sanskrit": "एवं भवत्सु ब्रह्मास्त्रं ब्रह्म चैव प्रतिष्ठितम् ।\nएकत्र चतुरो वेदाः क्षात्रमेकत्र दृश्यते\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2141005, "chapter_id": 4042, "verse_number": "१४", "content_sanskrit": "नैतत् समस्तमुभयं कस्मिंश्चिदनुशुश्रुम ।\nअन्यत्र भारताचार्यात् सपुत्रादिति मे मतिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2141006, "chapter_id": 4042, "verse_number": "१५", "content_sanskrit": "ब्रह्मास्त्रं चैव वेदाश्च नैतदन्यत्र दृश्यते\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2141007, "chapter_id": 4042, "verse_number": "१६", "content_sanskrit": "वेदान्ताश्च पुराणानि इतिहासं पुरातनम् ।\nजामदग्न्याद् ऋते रामात् को द्रोणादधिको भवेत्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2141008, "chapter_id": 4042, "verse_number": "१७", "content_sanskrit": "आचार्यपुत्रः क्षमतां नायं कालो विभेदने ।\nसर्वे सङ्गत्य युद्ध्यामः पाकशासनिमागतम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2141009, "chapter_id": 4042, "verse_number": "१८", "content_sanskrit": "बलस्य व्यसनानीह यान्युक्तानि मनीषिभिः ।\nमुख्यो भेदो हि तेषां वै पापिष्ठो विदुषां मतः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2141010, "chapter_id": 4042, "verse_number": "", "content_sanskrit": "अश्वत्थामा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2141011, "chapter_id": 4042, "verse_number": "१९", "content_sanskrit": "नैव न्याय्यमिदं वाच्यमस्माकं पुरुषर्षभ ।\nकिन्तु रोषपरीतेन गुरुणा भाषिता गुणाः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2141012, "chapter_id": 4042, "verse_number": "२०", "content_sanskrit": "शत्रोरपि गुणा ग्राह्या दोषा वाच्या गुरोरपि ।\nसर्वथा सर्वयत्नेन पुत्रे शिष्ये हितं वदेत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2141013, "chapter_id": 4042, "verse_number": "२१", "content_sanskrit": "आचार्य एव क्षमतां शान्तिरत्र विधीयताम् ।\nपश्यतो हि गुरोर्मत्स्यान् निवृत्तं कोपकारितम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2141014, "chapter_id": 4042, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2141015, "chapter_id": 4042, "verse_number": "२२", "content_sanskrit": "ततो दुर्योधनो द्रोणं क्षमयामास भारत ।\nसह कर्णेन भीष्मेण कृपं च सुमहाबलम्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2141016, "chapter_id": 4042, "verse_number": "", "content_sanskrit": "द्रोणः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2141017, "chapter_id": 4042, "verse_number": "२३", "content_sanskrit": "यदैव प्रथमं वाक्यं भीष्मः शान्तनवोऽब्रवीत् ।\nतदैवावां प्रसन्नौ वै परमत्र विधीयताम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2141018, "chapter_id": 4042, "verse_number": "२४", "content_sanskrit": "यथा दुर्योधनो राजा न गच्छेत् काञ्चिदापदम् ।\nसाहसाद् यदि वा मोहात् तथा नीतिर्विधीयताम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2141019, "chapter_id": 4042, "verse_number": "२५", "content_sanskrit": "वनवासे तु निवृत्ते दृश्यते तु धनञ्जयः ।\nधनं चालभमानोऽत्र नाद्य नः क्षन्तुमर्हति\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2141020, "chapter_id": 4042, "verse_number": "२६", "content_sanskrit": "यथा नायशसा युञ्ज्यात् धार्तराष्ट्रः कथञ्चन ।\nयथा न नः पराजैषीदर्जुनस्तद् विधीयताम्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2141021, "chapter_id": 4042, "verse_number": "२७", "content_sanskrit": "उक्तं दुर्योधनेनापि पुरस्ताद् वाक्यमीदृशम् ।\nतदनुस्मृत्य गाङ्गेय यथावद् वक्तुमर्हति\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2141022, "chapter_id": 4042, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि पञ्चाशोऽध्यायः ॥५०॥ गोग्रहणपर्वणि त्रयोविंशोऽध्यायः ॥१३॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]