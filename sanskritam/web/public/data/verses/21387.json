[{"id": 7001387000, "chapter_id": 21387, "verse_number": "५-३४-१", "content_sanskrit": "॥ शौनक उवाच  ।\nमन्वंतराणि सर्वाणि विस्तरेणानुकीर्तय ।\nयावंतो मनवश्चैव श्रोतुमिच्छामि तानहम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001387001, "chapter_id": 21387, "verse_number": "५-३४-२", "content_sanskrit": "सूत उवाच ।\nस्वायंभुवो मनुश्चैव ततस्स्त्वारोचिषस्तथा ।\nउत्तमस्तामसश्चैव रैवतश्चाक्षुषस्तथा॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001387002, "chapter_id": 21387, "verse_number": "५-३४-३", "content_sanskrit": "एते च मनवः षट् ते संप्रोक्ता मुनिपुंगव ।\nवैवस्वतो मुनिश्रेष्ठ सांप्रतं मनुरुच्यते॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001387003, "chapter_id": 21387, "verse_number": "५-३४-४", "content_sanskrit": "सावर्णिश्च मनुश्चैव ततो रौच्यस्तथा परः ।\nतथैव ब्रह्मसावर्णिश्चत्वारो मनवस्तथा॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001387004, "chapter_id": 21387, "verse_number": "५-३४-५", "content_sanskrit": "तथैव धर्मसावर्णी रुद्रसावर्णिरेव च ।\nदेवसावर्णिराख्यातं इंद्रसावर्णिरेव च॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001387005, "chapter_id": 21387, "verse_number": "५-३४-६", "content_sanskrit": "अतीता वर्तमानाश्च तथैवानागताश्च ये ।\nकीर्तिता मनवश्चापि मयैवैते यथा श्रुताः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001387006, "chapter_id": 21387, "verse_number": "५-३४-७", "content_sanskrit": "मुने चतुर्दशैतानि त्रिकालानुगतानि ते ।\nप्रोक्तानि निर्मितः कल्पो युगसाहस्रपर्य्ययः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001387007, "chapter_id": 21387, "verse_number": "५-३४-८", "content_sanskrit": "ऋषींस्तेषां प्रवक्ष्यामि पुत्त्रान्देवगणांस्तथा ।\nशृणु शौनक सुप्रीत्या क्रमशस्तान्यशस्विनः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001387008, "chapter_id": 21387, "verse_number": "५-३४-९", "content_sanskrit": "मरीचिरत्रिर्भगवानङ्गिराः पुलहः क्रतुः ।\nपुलस्त्यश्च वसिष्ठश्च सप्तैते ब्रह्मणस्सुताः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001387009, "chapter_id": 21387, "verse_number": "५-३४-१०", "content_sanskrit": "उत्तरस्यां दिशि तथा मुने सप्तर्ष यस्तथा ।\nयामा नाम तथा देवा आसन्स्वायंभुवेंतरे॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001387010, "chapter_id": 21387, "verse_number": "५-३४-११", "content_sanskrit": "आग्नीध्रश्चाग्निबाहुश्च मेधा मेधातिथिर्वसुः ।\nज्योतिष्मान्धृतिमान्हव्यः सवनश्शुभ्र एव च॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001387011, "chapter_id": 21387, "verse_number": "५-३४-१२", "content_sanskrit": "स्वायंभुवस्य पुत्रास्ते मनोर्दश महात्मनः ।\nकीर्तिता मुनिशार्दूल तत्रेन्द्रो यज्ञ उच्यते॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001387012, "chapter_id": 21387, "verse_number": "५-३४-१३", "content_sanskrit": "प्रथमं कथितं तात दिव्यं मन्वतरं तथा ।\nद्वितीयं ते प्रवक्ष्यामि तन्निबोध यथातथम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001387013, "chapter_id": 21387, "verse_number": "५-३४-१४", "content_sanskrit": "ऊर्जस्तंभः परस्तंभ ऋषभो वसुमां स्तथा ।\nज्योतिष्मान्द्युतिमांश्चैव रोचिष्मान्सप्तमस्तथा॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001387014, "chapter_id": 21387, "verse_number": "५-३४-१५", "content_sanskrit": "एते महर्षयो ज्ञेयास्तत्रेन्द्रो रोचनस्तथा ।\nदेवाश्च तुषिता नाम स्मृताः स्वारोचिषेंऽतरे॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001387015, "chapter_id": 21387, "verse_number": "५-३४-१६", "content_sanskrit": "हरिघ्नस्सुकृतिर्ज्योतिरयोमूर्तिरयस्मयः ।\nप्रथितश्च मनस्युश्च नभस्सूर्यस्तथैव च॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001387016, "chapter_id": 21387, "verse_number": "५-३४-१७", "content_sanskrit": "स्वारोचिषस्य पुत्रास्ते मनोर्दशमहात्मनः ।\nकीर्तिता मुनिशार्दूल महावीर्यपराक्रमाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001387017, "chapter_id": 21387, "verse_number": "५-३४-१८", "content_sanskrit": "द्वितीयमेतत्कथितं मुने मन्वन्तरं मया ।\nतृतीयं तव वक्ष्यामि तन्निबोध यथातथम्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001387018, "chapter_id": 21387, "verse_number": "५-३४-१९", "content_sanskrit": "वसिष्ठपुत्राः सप्तासन्वासिष्ठा इति विश्रुताः ।\nहिरण्यगर्भस्य सुता ऊर्जा नाम महौजसः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001387019, "chapter_id": 21387, "verse_number": "५-३४-२०", "content_sanskrit": "ऋषयोऽत्र समाख्याताः कीर्त्यमानान्निबोध मे ।\nऔत्तमेया ऋषिश्रेष्ठ दशपुत्रा मनोः स्मृताः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001387020, "chapter_id": 21387, "verse_number": "५-३४-२१", "content_sanskrit": "इष ऊर्जित ऊर्जश्च मधुर्माधव एव च ।\nशुचिश्शुक्रवहश्चैव नभसो नभ एव च॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001387021, "chapter_id": 21387, "verse_number": "५-३४-२२", "content_sanskrit": "ऋषभस्तत्र देवाश्च सत्यवेद श्रुतादयः ।\nतत्रेन्द्रस्सत्यजिन्नाम त्रैलोक्याधिपतिर्मुने॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001387022, "chapter_id": 21387, "verse_number": "५-३४-२३", "content_sanskrit": "तृतीयमेतत्परमं मन्वतरमुदाहृतम् ।\nमन्वतरं चतुर्थं ते कथयामि मुने शृणु॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001387023, "chapter_id": 21387, "verse_number": "५-३४-२४", "content_sanskrit": "गार्ग्यः पृथुस्तथा वाग्मी जयो धाता कपीनकः ।\nकपीवान्सप्तऋषयः सत्या देवगणास्तथा॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001387024, "chapter_id": 21387, "verse_number": "५-३४-२५", "content_sanskrit": "तत्रेंद्रस्त्रिशिखो ज्ञेयो मनुपुत्रान्मुने शृणु ।\nद्यूतिपोतस्सौतपस्यस्तमश्शूलश्च तापनः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001387025, "chapter_id": 21387, "verse_number": "५-३४-२६", "content_sanskrit": "तपोरतिरकल्माषो धन्वी खड्गी महानृषिः ।\nतामसस्य स्मृता एते दश पुत्रा महाव्रताः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001387026, "chapter_id": 21387, "verse_number": "५-३४-२७", "content_sanskrit": "तामसस्यांतरं चैव मनो मे कथितं तव ।\nचतुर्थं पञ्चमं तात शृणु मन्वंतरं परम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001387027, "chapter_id": 21387, "verse_number": "५-३४-२८", "content_sanskrit": "देवबाहुर्जयश्चैव मुनिर्वेदशिरास्तथा ।\nहिरण्यरोमा पर्जन्य ऊर्ध्वबाहुश्च सोमपाः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001387028, "chapter_id": 21387, "verse_number": "५-३४-२९", "content_sanskrit": "सत्यनेत्ररताश्चान्ये एते सप्तर्षयोऽपरे ।\nदेवाश्च भूतरजसस्तपःप्रकृतयस्तथा॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001387029, "chapter_id": 21387, "verse_number": "५-३४-३०", "content_sanskrit": "तत्रेंद्रो विभुनामा च त्रैलोक्याधिपतिस्तथा ।\nरैवताख्यो मनुस्तत्र ज्ञेयस्तामससोदरः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001387030, "chapter_id": 21387, "verse_number": "५-३४-३१", "content_sanskrit": "अर्जुनः पंक्तिविंध्यो वा दयायास्त नया मुने ।\nमहता तपसा युक्ता मेरुपृष्ठे वसंति हि॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001387031, "chapter_id": 21387, "verse_number": "५-३४-३२", "content_sanskrit": "रुचेः प्रजापतिः पुत्रो रौच्यो नाम मनुः स्मृतः ।\nभूत्या चोत्पादितो देव्यां भौत्यो नामाभवत्सुतः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001387032, "chapter_id": 21387, "verse_number": "५-३४-३३", "content_sanskrit": "अनागताश्च सप्तैते कल्पेऽस्मिन्मनवस्स्मृताः ।\nअनागताश्च सप्तैव स्मृता दिवि महर्षयः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001387033, "chapter_id": 21387, "verse_number": "५-३४-३४", "content_sanskrit": "रामो व्यासस्तथात्रेयो दीप्तिमान्सु बहुश्रुतः ।\nभरद्वाजस्तथा द्रौणिरश्वत्थामा महाद्युतिः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001387034, "chapter_id": 21387, "verse_number": "५-३४-३५", "content_sanskrit": "गौतमस्यात्मजश्चैव शरद्वान् गौतमः कृपः ।\nकौशिको गालवश्चैव रुरुः कश्यप एव च॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001387035, "chapter_id": 21387, "verse_number": "५-३४-३६", "content_sanskrit": "एते सप्त महात्मानो भविष्या मुनिसत्तमाः ।\nदेवाश्चानागतास्तत्र त्रयः प्रोक्तास्स्वयंभुवा॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001387036, "chapter_id": 21387, "verse_number": "५-३४-३७", "content_sanskrit": "मरीचेश्चैव पुत्रास्ते कश्यपस्य महात्मनः ।\nतेषां विरोचनसुतो बलिरिंद्रो भविष्यति॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001387037, "chapter_id": 21387, "verse_number": "५-३४-३८", "content_sanskrit": "विषांङ्गश्चावनीवांश्च सुमंतो धृतिमान्वसुः ।\nसूरिः सुराख्यो विष्णुश्च राजा सुमतिरेव च॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001387038, "chapter_id": 21387, "verse_number": "५-३४-३९", "content_sanskrit": "सावर्णेश्च मनोः पुत्रा भविष्या दश शौनक ।\nइहाष्टमं हि कथितं नवमं चान्तरं शृणु॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001387039, "chapter_id": 21387, "verse_number": "५-३४-४०", "content_sanskrit": "प्रथमं दक्षसावर्णि प्रवक्ष्यामि मनुं शृणु ।\nमेधातिथिश्च पौलस्त्यो वसुः कश्यप एव च॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001387040, "chapter_id": 21387, "verse_number": "५-३४-४१", "content_sanskrit": "ज्योतिष्मान्भार्गवश्चैव धृतिमानंगिरास्तथा ।\nसवनश्चैव वासिष्ठ आत्रेयो हव्य एव च॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001387041, "chapter_id": 21387, "verse_number": "५-३४-४२", "content_sanskrit": "पुलहस्सप्त इत्येते ऋषयो रौहितेंतरे ।\nदेवतानां गणास्तत्र त्रय एव महामुने॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001387042, "chapter_id": 21387, "verse_number": "५-३४-४३", "content_sanskrit": "दीक्षापुत्रस्य पुत्रास्ते रोहितस्य प्रजापतेः ।\nधृष्टकेतुर्दीप्तकेतुः पंचहस्तो निराकृतिः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001387043, "chapter_id": 21387, "verse_number": "५-३४-४४", "content_sanskrit": "पृथुश्रवा भूरिद्युम्नो ऋचीको बृहतो गयः ।\nप्रथमस्य तु सावर्णेर्नव पुत्रा महौजस॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001387044, "chapter_id": 21387, "verse_number": "५-३४-४५", "content_sanskrit": "दशमे त्वथ पर्याये द्वितीयस्यांतरे मनोः ।\nहविष्मान्पुलहश्चैव प्रकृतिश्चैव भार्गवः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001387045, "chapter_id": 21387, "verse_number": "५-३४-४६", "content_sanskrit": "आयो मुक्तिस्तथात्रेयो वसिष्ठश्चाव्ययस्स्मृतः ।\nपौलस्त्यः प्रयतिश्चैव भामारश्चैव कश्यपः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001387046, "chapter_id": 21387, "verse_number": "५-३४-४७", "content_sanskrit": "अङ्गिरानेनसस्सत्यः सप्तैते परमर्षयः ।\nदेवतानां गणाश्चापि द्विषिमंतश्च ते स्मृताः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001387047, "chapter_id": 21387, "verse_number": "५-३४-४८", "content_sanskrit": "तेषामिन्द्रस्स्मृतः शम्भुस्त्वयमेव महेश्वरः ।\nअक्षत्वानुत्तमौजाश्च भूरिषेणश्च वीर्यवान्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001387048, "chapter_id": 21387, "verse_number": "५-३४-४९", "content_sanskrit": "शतानीको निरामित्रो वृषसेनो जयद्रथः ।\nभूरिद्युम्नः सुवर्चार्चिर्दश त्वेते मनोस्सुताः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001387049, "chapter_id": 21387, "verse_number": "५-३४-५०", "content_sanskrit": "एकादशे तु पर्याये तृतीयस्यांतरे मनोः ।\nतस्यापि सप्त ऋषयः कीर्त्यमानान्निबोध मे॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001387050, "chapter_id": 21387, "verse_number": "५-३४-५१", "content_sanskrit": "हविष्मान्कश्यपश्चापि वपुष्मांश्चैव वारुणः ।\nअत्रेयोऽथ वसिष्ठश्च ह्यनयस्त्वंगिरास्तथा॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001387051, "chapter_id": 21387, "verse_number": "५-३४-५२", "content_sanskrit": "चारुधृष्यश्च पौलस्त्यो निःस्वरोऽग्निस्तु तैजसः ।\nसप्तैते ऋषयः प्रोक्तास्त्रयो देवगणास्स्मृताः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001387052, "chapter_id": 21387, "verse_number": "५-३४-५३", "content_sanskrit": "ब्रह्मणस्तु सुतास्ते हि त इमे वैधृताः स्मृताः ।\nसर्वगश्च सुशर्म्मा च देवानीकस्तु क्षेमकः॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001387053, "chapter_id": 21387, "verse_number": "५-३४-५४", "content_sanskrit": "दृढेषुः खंडको दर्शः कुहुर्बाहुर्मनोः स्मृताः ।\nसावर्णस्य तु पौत्रा वै तृतीयस्य नव स्मृताः॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001387054, "chapter_id": 21387, "verse_number": "५-३४-५५", "content_sanskrit": "चतुर्थस्य तु सावर्णेरृषीन्सप्त निबोध मे ।\nद्युतिर्वसिष्ठपुत्रश्च आत्रेयस्सुतपास्तथा॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001387055, "chapter_id": 21387, "verse_number": "५-३४-५६", "content_sanskrit": "अंगिरास्तपसो मूर्तिस्तपस्वी कश्यपस्तथा ।\nतपोधनश्च पौलस्त्यः पुलहश्च तपोरतिः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001387056, "chapter_id": 21387, "verse_number": "५-३४-५७", "content_sanskrit": "भार्गवस्सप्तमस्तेषां विज्ञेय तपसो निधिः ।\nपंच देवगणाः प्रोक्ता मानसा ब्रह्मणस्सुताः॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001387057, "chapter_id": 21387, "verse_number": "५-३४-५८", "content_sanskrit": "ऋतधामा तदिन्द्रो हि त्रिलोकी राज्यकृत्सुखी ।\nद्वादशे चैव पर्याये भाव्ये रौच्यांतरे मुने॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001387058, "chapter_id": 21387, "verse_number": "५-३४-५९", "content_sanskrit": "अंगिराश्चैव धृतिमान्पौलस्त्यो हव्यवांस्तु यः ।\nपौलहस्तत्त्वदर्शी च भार्गवश्च निरुत्सवः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001387059, "chapter_id": 21387, "verse_number": "५-३४-६०", "content_sanskrit": "निष्प्रपंचस्तथात्रेयो निर्देहः कश्यपस्तथा ।\nसुतपाश्चैव वासिष्ठस्सप्तैवैते महर्षयः॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001387060, "chapter_id": 21387, "verse_number": "५-३४-६१", "content_sanskrit": "त्रय एव गणाः प्रोक्ता देवतानां स्वयंभुवा ।\nदिवस्पतिस्तमिन्द्रो वै विचित्रश्चित्र एव च॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001387061, "chapter_id": 21387, "verse_number": "५-३४-६२", "content_sanskrit": "नयो धर्मो धृतोंध्रश्च सुनेत्रः क्षत्रवृद्धकः ।\nनिर्भयस्सुतपा द्रोणो मनो रौच्यस्य ते सुताः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001387062, "chapter_id": 21387, "verse_number": "५-३४-६३", "content_sanskrit": "चतुर्द्दशे तु पर्याये सत्यस्यैवांतरे मनोः ।\nआग्नीध्रः काश्यपश्चैव पौलस्त्यो मागधश्च यः॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001387063, "chapter_id": 21387, "verse_number": "५-३४-६४", "content_sanskrit": "भार्गवोऽप्यतिवाह्यश्च शुचिरांगिरसस्तथा ।\nयुक्तश्चैव तथात्रेयः पौत्रो वाशिष्ठ एव च॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001387064, "chapter_id": 21387, "verse_number": "५-३४-६५", "content_sanskrit": "अजितः पुलहश्चैव ह्यंत्यास्सप्तर्षयश्च ते ।\nपवित्राश्चाक्षुषा देवाः शुचिरिन्द्रो भविष्यति॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001387065, "chapter_id": 21387, "verse_number": "५-३४-६६", "content_sanskrit": "एतेषां कल्य उत्थाय कीर्तनात्सुखमेधते ।\nअतीतानागतानां वै महर्षीणां नरैस्सदा॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001387066, "chapter_id": 21387, "verse_number": "५-३४-६७", "content_sanskrit": "देवतानां गणाः प्रोक्ताश्शृणु पंच महामुने ।\nतुरंगभीरुर्बुध्नश्च तनुग्रोऽनूग्र एव च॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001387067, "chapter_id": 21387, "verse_number": "५-३४-६८", "content_sanskrit": "अतिमानी प्रवीणश्च विष्णुस्संक्रंदनस्तथा ।\nतेजस्वी सबलश्चैव सत्यस्त्वेते मनोस्सुता॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001387068, "chapter_id": 21387, "verse_number": "५-३४-६९", "content_sanskrit": "भौमस्यैवाधिकारे वै पूर्वकल्पस्तु पूर्यते ।\nइत्येतेऽनागताऽतीता मनवः कीर्तिता मया॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001387069, "chapter_id": 21387, "verse_number": "५-३४-७०", "content_sanskrit": "उक्तास्सनत्कुमारेण व्यासायामिततेजसा ।\nपूर्णे युगसहस्रांते परिपाल्यः स्वधर्मतः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001387070, "chapter_id": 21387, "verse_number": "५-३४-७१", "content_sanskrit": "प्रजाभिस्तपसा युक्ता ब्रह्मलोकं व्रजंति ते ।\nयुगानि सप्रतिस्त्वेकं साग्राण्यंतरमुच्यते॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001387071, "chapter_id": 21387, "verse_number": "५-३४-७२", "content_sanskrit": "चतुर्दशैते मनवः कीर्तिता कीर्तिवर्धनाः ।\nमन्वंतरेषु सर्वेषु संहारांते पुनर्भवः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001387072, "chapter_id": 21387, "verse_number": "५-३४-७३", "content_sanskrit": "न शक्यमन्तरं तेषां वक्तुं वर्षशतैरपि ।\nपूर्णे शतसहस्रे तु कल्पो निःशेष उच्यते॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001387073, "chapter_id": 21387, "verse_number": "५-३४-७४", "content_sanskrit": "तत्र सर्वाणि भूतानि दग्धान्यादित्यरश्मिभिः ।\nब्रह्माणमग्रतः कृत्वा सदादित्यगणैर्मुने॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001387074, "chapter_id": 21387, "verse_number": "५-३४-७५", "content_sanskrit": "प्रविशंति सुरश्रेष्ठ हरिं नारायणं परम् ।\nस्रष्टारं सर्व भूतानां कल्पांतेषु पुनःपुनः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001387075, "chapter_id": 21387, "verse_number": "५-३४-७६", "content_sanskrit": "भूयोपि भगवान् रुद्रस्संहर्ता काल एव हि ।\nकल्पांते तत्प्रवक्ष्यामि मनोर्वैवस्वतस्य वै॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001387076, "chapter_id": 21387, "verse_number": "५-३४-७७", "content_sanskrit": "इति ते कथितं सर्वं मन्वंतरसमुद्भवम् ।\nविसर्गं पुण्यमाख्यानं धन्यं कुलविवर्द्धनम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]