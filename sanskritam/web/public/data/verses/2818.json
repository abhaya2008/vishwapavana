[{"id": 2085330, "chapter_id": 2818, "verse_number": "१२-३२३-०x", "content_sanskrit": "याज्ञवल्क्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2085331, "chapter_id": 2818, "verse_number": "१२-३२३-१", "content_sanskrit": "अव्यक्तस्थं परं यत्तत्पृष्टस्तेऽहं नराधिप।\nपरं गुह्यमिमं प्रश्नं शृणुष्वावहितो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2085332, "chapter_id": 2818, "verse_number": "१२-३२३-२", "content_sanskrit": "यथार्षेणेह विधिना चरताऽवमतेन ह।\nमयाऽऽदित्यादवाप्तानि यजूंषि मिथिलाधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2085333, "chapter_id": 2818, "verse_number": "१२-३२३-३", "content_sanskrit": "महता तपसा देवस्तपिष्णुः सेवितो मया।\nप्रीतेन चाहं विभुना सूर्येणोक्तस्तदाऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2085334, "chapter_id": 2818, "verse_number": "१२-३२३-४", "content_sanskrit": "वरं वृणीष्व विप्रर्षे यदिष्टं ते सुदुर्लभम्।\nतं ते दास्यामि प्रीतात्मा मत्प्रसादो हि दुर्लभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2085335, "chapter_id": 2818, "verse_number": "१२-३२३-५", "content_sanskrit": "ततः प्रणम्य शिरसा मयोक्तस्तपतांवरः।\nयजूंषि नोपयुक्तानि क्षिप्रमिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2085336, "chapter_id": 2818, "verse_number": "१२-३२३-६", "content_sanskrit": "ततो मां भगवानाह वितरिष्यामि ते द्विज।\nसरस्वतीह वाग्भूता शरीरं ते प्रवेक्ष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2085337, "chapter_id": 2818, "verse_number": "१२-३२३-७", "content_sanskrit": "ततो मामाह भगवानास्यं स्वं विवृतं कुरु।\nविवृतं च ततो मेऽऽस्यं प्रविष्टा च सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2085338, "chapter_id": 2818, "verse_number": "१२-३२३-८", "content_sanskrit": "ततो विदह्यमानोऽहं प्रविष्टोऽम्भस्तदाऽनघ।\nअविज्ञानादमर्षाच्च भास्करस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2085339, "chapter_id": 2818, "verse_number": "१२-३२३-९", "content_sanskrit": "ततो विदह्यमानं मामुवाच भगवान्रविः।\nमुहूर्तं सह्यतां दाहस्ततः शीतीभविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2085340, "chapter_id": 2818, "verse_number": "१२-३२३-१०", "content_sanskrit": "शीतीभूतं च मां दृष्ट्वा भगवानाह भास्करः।\nप्रतिभास्यति ते वेदः सखिलः सोत्तरो द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2085341, "chapter_id": 2818, "verse_number": "१२-३२३-११", "content_sanskrit": "कृत्स्नं शतपथं चैव प्रणेष्यसि द्विजर्षभ।\nतस्यान्ते चाषुनर्भावे बुद्धिस्तव भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2085342, "chapter_id": 2818, "verse_number": "१२-३२३-१२", "content_sanskrit": "प्राप्स्यसे च यदिष्टं तत्साङ्ख्ययोगेप्सितं पदम्।\nएतावदुक्त्वा भगवानस्तमेवाभ्यवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2085343, "chapter_id": 2818, "verse_number": "१२-३२३-१३", "content_sanskrit": "ततोऽनुव्याहृतं श्रुत्वा गते देवे विभावसौ।\nगृहमागत्य संहृष्टोऽचिन्तयं वै सरस्वतीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2085344, "chapter_id": 2818, "verse_number": "१२-३२३-१४", "content_sanskrit": "ततः प्रवृत्ताऽतिशुभा स्वरव्यञ्जनभूषिता।\nओंकारमादितः कृत्वा मम देवी सरस्वती॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2085345, "chapter_id": 2818, "verse_number": "१२-३२३-१५", "content_sanskrit": "ततोऽहमर्ध्यं विधिवत्सरस्वत्यै न्यवेदयम्।\nपरं यत्नमवाप्यैव निषण्णस्तत्परायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2085346, "chapter_id": 2818, "verse_number": "१२-३२३-१६", "content_sanskrit": "ततः शतपथं कृत्स्नं सरहस्यं ससंग्रहम्।\nचक्रे सपरिशेषं च हर्षेण परमेण ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2085347, "chapter_id": 2818, "verse_number": "१२-३२३-१७", "content_sanskrit": "कृत्वा चाध्ययनं तेषां शिष्याणां शतमुत्तमम्।\nविप्रियार्थं सशिष्यस्य मातुलस्य महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2085348, "chapter_id": 2818, "verse_number": "१२-३२३-१८", "content_sanskrit": "ततः सशिष्येण मया सूर्येणेव गभस्तिभिः।\nव्यस्तो यज्ञो महाराज पितुस्तव महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2085349, "chapter_id": 2818, "verse_number": "१२-३२३-१९", "content_sanskrit": "मिषतो देवलस्यापि ततोऽर्धं हृतवान्वसु।\nस्ववेददक्षिणायार्थे विमर्दे मातुलेन ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2085350, "chapter_id": 2818, "verse_number": "१२-३२३-२०", "content_sanskrit": "सुमन्तुनाऽथ पैलेन तथा जैमिनिना च वै।\nपित्रा ते मुनिभिश्चैव ततोऽहमनुमानितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2085351, "chapter_id": 2818, "verse_number": "१२-३२३-२१", "content_sanskrit": "दश पञ्च च प्राप्तानि यजूंष्यर्कान्मयाऽनघ।\nतथैव रोमहर्षेण पुराणमवधारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2085352, "chapter_id": 2818, "verse_number": "१२-३२३-२२", "content_sanskrit": "बीजमेतत्पुरस्कृत्य देवीं चैव सरस्वतीम्।\nसूर्यस्य चानुभावेन प्रवृत्तोऽहं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2085353, "chapter_id": 2818, "verse_number": "१२-३२३-२३", "content_sanskrit": "कर्तुं शतपथं चेदमपूर्वं च कृतं मया।\nयथाभिलपितं मार्गं तथा तच्चोपपादितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2085354, "chapter_id": 2818, "verse_number": "१२-३२३-२४", "content_sanskrit": "शिष्याणामखिलं कृत्स्नमनुज्ञातं ससंग्रहम्।\nसर्वे च शिष्याः शुचयो गताः परमहर्षिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2085355, "chapter_id": 2818, "verse_number": "१२-३२३-२५", "content_sanskrit": "शाखाः पञ्चदशेमास्तु विद्या भास्करदर्शिता।\nप्रतिष्ठाप्य यथाकामं वेद्यं तदनुचितयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2085356, "chapter_id": 2818, "verse_number": "१२-३२३-२६", "content_sanskrit": "किमत्र ब्रह्मण्यमृतं किंच वेद्यमनुत्तमम्।\nचिन्तयंस्तत्र चागत्य गन्धर्वो मामपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2085357, "chapter_id": 2818, "verse_number": "१२-३२३-२७", "content_sanskrit": "विश्वावसुस्ततो राजन्वेदान्तज्ञानकोविदः।\nचतुर्विशांस्ततोऽपृच्छत्प्रश्नान्वेदस्य पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2085358, "chapter_id": 2818, "verse_number": "१२-३२३-२८", "content_sanskrit": "पञ्चविंशतिमं प्रश्नं पप्रच्छान्वीक्षिकीं तदा।\n`तथैव पुरुषव्याघ्र मित्रं वरुणमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2085359, "chapter_id": 2818, "verse_number": "१२-३२३-२९", "content_sanskrit": "ज्ञानं ज्ञेयं तथा ज्ञोऽज्ञः कस्तपा अतपास्तथा।\nसूर्यातिसूर्य इति च विद्याविद्ये तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2085360, "chapter_id": 2818, "verse_number": "१२-३२३-३०", "content_sanskrit": "वेद्यावेद्यं तथा राजन्नचलं चलमेव च।\nअव्ययं चाक्षरं क्षेम्यमेतत्प्रश्नमनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2085361, "chapter_id": 2818, "verse_number": "१२-३२३-३१", "content_sanskrit": "अथोक्तश्च महाराज राजा गन्धर्वसत्तमः।\nपृष्टवानानुपूर्व्येण प्रश्नमर्थवदुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2085362, "chapter_id": 2818, "verse_number": "१२-३२३-३२", "content_sanskrit": "मुहूर्तमुष्यतां तावद्यावदेनं विचिन्तये।\nबाढमित्येव कृत्वा स तूर्ष्णीं गन्धर्व आस्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2085363, "chapter_id": 2818, "verse_number": "१२-३२३-३३", "content_sanskrit": "ततोऽनुचिन्तयमहं भूयो देवीं सरस्वतीम्।\nमनसा स च मे प्रश्नो दध्नो धृतमिवोद्धृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2085364, "chapter_id": 2818, "verse_number": "१२-३२३-३४", "content_sanskrit": "तत्रोपनिषदं चैव परिशेषं च पार्थिव।\nमथ्नामि मनसा तात दृष्ट्वा चान्वीक्षिकीं पराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2085365, "chapter_id": 2818, "verse_number": "१२-३२३-३५", "content_sanskrit": "चतुर्थी राजशार्दूल विद्यैषा सांपरायिकी।\nउदीरिता मया तुभ्यं पञ्चविंशाऽधितिष्ठता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2085366, "chapter_id": 2818, "verse_number": "१२-३२३-३६", "content_sanskrit": "अथोक्तस्तु मया राजन्राजा विश्वावसुस्तदा।\nश्रूयतां यद्भवानस्मान्प्रश्नं संपृष्टवानिह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2085367, "chapter_id": 2818, "verse_number": "१२-३२३-३७", "content_sanskrit": "विश्वाविश्वेति यदिदं गन्धर्वेन्द्रानुपृच्छसि।\nविश्वाव्यक्तं परं विद्याद्भूतभव्यभयंकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2085368, "chapter_id": 2818, "verse_number": "१२-३२३-३८", "content_sanskrit": "त्रिगुणं गुणकर्तृत्वाद्विश्वान्यो निष्कलस्तथा।\nविश्वाविश्वेति मिथुनमेवमेवानुदृश्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2085369, "chapter_id": 2818, "verse_number": "१२-३२३-३९", "content_sanskrit": "अव्यक्तं प्रकृतिः प्राहुः पुरुषेति च निर्गुणम्।\nतथैव मित्रं पुरुषं वरुणं प्रकृतिं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2085370, "chapter_id": 2818, "verse_number": "१२-३२३-४०", "content_sanskrit": "ज्ञानं तु प्रकृतिं प्राहुर्ज्ञेयं पुरुषमेव च।\nअज्ञमव्यक्तमित्युक्तं ज्ञस्तु निष्कल उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2085371, "chapter_id": 2818, "verse_number": "१२-३२३-४१", "content_sanskrit": "कस्तपा अतपाः प्रोक्तः कोसौ पुरुष उच्यते।\nतपास्तु प्रकृतिं प्राहुरतपा निष्कलः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2085372, "chapter_id": 2818, "verse_number": "१२-३२३-४२", "content_sanskrit": "`सूर्यमव्यक्तमित्युक्तमतिसूर्यस्तु निष्कलः।\nअविद्या प्रोक्तमव्यक्तं विद्या पुरुष उच्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2085373, "chapter_id": 2818, "verse_number": "१२-३२३-४३", "content_sanskrit": "तथैवावेद्यमव्यक्तं वेद्यः पुरुष उच्यते।\nचलाचलमिति प्रोक्तं त्वया तदपि मे शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2085374, "chapter_id": 2818, "verse_number": "१२-३२३-४४", "content_sanskrit": "चलां तु प्रकृतिं प्राहुः कारणं क्षेपसर्गयोः।\nअक्षेपसर्गयोः कर्ता निश्चलः पुरुषः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2085375, "chapter_id": 2818, "verse_number": "१२-३२३-४५", "content_sanskrit": "अज्ञावुभौ ध्रुवौ चैव अक्षयौ चाप्युभावपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2085376, "chapter_id": 2818, "verse_number": "१२-३२३-४६", "content_sanskrit": "अजौ नित्यावुभौ प्राहुरध्यात्मगतिनिश्चयाः।\nअक्षयत्वात्प्रजनने अजमत्राहुरव्ययम्।\nअक्षयं पुरुषं प्राहुः क्षयो ह्यस्य न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2085377, "chapter_id": 2818, "verse_number": "१२-३२३-४७", "content_sanskrit": "गुणक्षयत्वात्प्रकृतिः कर्तृत्वादक्षयं बुधाः।\nएषा तेऽन्वीक्षिकी विद्या चतुर्थी सांपरायिकी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2085378, "chapter_id": 2818, "verse_number": "१२-३२३-४८", "content_sanskrit": "विद्योपेतं धनं कृत्वा कर्मणा नित्यकर्मणि।\nएकान्तदर्शना वेदाः सर्वे विश्वावसो स्मृताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2085379, "chapter_id": 2818, "verse_number": "१२-३२३-४९", "content_sanskrit": "जायन्ते च म्रियन्ते च यस्मिन्नेते यतश्च्युताः।\nवेदार्थं ये न जानीते वेद्यं गन्धर्वसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2085380, "chapter_id": 2818, "verse_number": "१२-३२३-५०", "content_sanskrit": "साङ्गोपाङ्गानपि यदि पञ्च वेदानधीयते।\nवेदवेद्यं न जानीते वेदभारवहो हि सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2085381, "chapter_id": 2818, "verse_number": "१२-३२३-५१", "content_sanskrit": "यो घृतार्थी खराक्षीरं मथेद्गन्धर्वसत्तम।\nविष्ठां तत्रानुपश्येत न मण़्डं न च वै घृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2085382, "chapter_id": 2818, "verse_number": "१२-३२३-५२", "content_sanskrit": "तथा वेद्यमवेद्यं च वेदविद्यो न विन्दति।\nस केवलं मूढमतिर्वेदभारवहः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2085383, "chapter_id": 2818, "verse_number": "१२-३२३-५३", "content_sanskrit": "द्रष्टव्यौ नित्यमेवैतौ तत्परेणान्तरात्मना।\nयथाऽस्य जन्मनिधने न भवेतां पुनः पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2085384, "chapter_id": 2818, "verse_number": "१२-३२३-५४", "content_sanskrit": "अजस्रं जन्मनिधनं चिन्तयित्वा त्रयीमिमाम्।\nपरित्यज्य क्षयमिह अक्षयं धर्ममास्थितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2085385, "chapter_id": 2818, "verse_number": "१२-३२३-५५", "content_sanskrit": "यदाऽनुपश्यतेऽत्यन्तमहन्यहनि काश्यप।\nतदा स केवलीभूतः षङ्विंशमनुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2085386, "chapter_id": 2818, "verse_number": "१२-३२३-५६", "content_sanskrit": "अन्यश्च शाश्वतो व्यक्तस्तथाऽन्यः पञ्चविंशकः।\nतत्स्थं समनुपश्यन्ति तमेकमिति साधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2085387, "chapter_id": 2818, "verse_number": "१२-३२३-५७", "content_sanskrit": "तेनैतं नाभिनन्दन्ति पञ्चविंसकमच्युतम्।\nजन्ममृत्युभयाद्योगाः साख्याश्च परमैषिणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2085388, "chapter_id": 2818, "verse_number": "१२-३२३-५८x", "content_sanskrit": "विश्वावसुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2085389, "chapter_id": 2818, "verse_number": "१२-३२३-५८", "content_sanskrit": "पञ्चविंशं यदेतत्ते प्रोक्तं ब्राह्मणसत्तम।\nतदहं न तथा वेद्मि तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2085390, "chapter_id": 2818, "verse_number": "१२-३२३-५९", "content_sanskrit": "जैगीषव्यस्यासितस्य देवलस्य मया श्रुतम्।\nपराशरस्य विप्रर्षेर्वार्षगण्यस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2085391, "chapter_id": 2818, "verse_number": "१२-३२३-६०", "content_sanskrit": "भिक्षोः पञ्चशिखस्यास्य कपिलस्य शुकस्य च।\nगौतमस्याष्टिंषेणस्य गर्गस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2085392, "chapter_id": 2818, "verse_number": "१२-३२३-६१", "content_sanskrit": "नारदस्यासुरेश्चैव पुलस्त्यस्य च धीमतः।\nसनत्कुमारस्य ततः शुक्रस्य च महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2085393, "chapter_id": 2818, "verse_number": "१२-३२३-६२", "content_sanskrit": "कश्यपस्य पितुश्चैव पूर्वमेव मया श्रुतम्।\nतदनन्तरं च रुद्रस्य विश्वरूपस्य धीमतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2085394, "chapter_id": 2818, "verse_number": "१२-३२३-६३", "content_sanskrit": "दैवतेभ्यः पितृभ्यश्च दैतेयेभ्यस्ततस्ततः।\nप्राप्तमेतन्मया कृत्स्नं वेद्यं नित्यं वदन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2085395, "chapter_id": 2818, "verse_number": "१२-३२३-६४", "content_sanskrit": "तस्मात्तद्वै भवद्बुद्ध्या श्रोतुमिच्छामि ब्राह्मण।\nभवान्प्रबर्हः शास्त्राणां प्रगल्भश्चातिबुद्धिमान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2085396, "chapter_id": 2818, "verse_number": "१२-३२३-६५", "content_sanskrit": "न तवाविदितं किंचिद्भवाञ्श्रुतिनिधिः स्मृतः।\nकथ्यसे देवलोके च पितृलोके च ब्राह्मण॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2085397, "chapter_id": 2818, "verse_number": "१२-३२३-६६", "content_sanskrit": "ब्रह्मलोकगताश्चैव कथयन्ति महर्षयः।\nपतिश्च तपतां शश्वदादित्यस्तव भाषिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2085398, "chapter_id": 2818, "verse_number": "१२-३२३-६७", "content_sanskrit": "साङ्ख्यज्ञानं त्वया ब्रह्मन्नवाप्तं कृत्स्नमेव च।\nतथैव योगशास्त्रं च याज्ञवल्क्य विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2085399, "chapter_id": 2818, "verse_number": "१२-३२३-६८", "content_sanskrit": "निःसंदिग्धं प्रबुद्धस्त्वं बुध्यमानश्चराचरम्।\nश्रोतुमिच्छामि तज्ज्ञानं घृतं मण्डमयं यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2085400, "chapter_id": 2818, "verse_number": "१२-३२३-६९x", "content_sanskrit": "याज्ञवल्क्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2085401, "chapter_id": 2818, "verse_number": "१२-३२३-६९", "content_sanskrit": "कृत्स्नधारिणमेव त्वां मन्ये गन्धर्वसत्तम।\nजिज्ञासमे च मां राजंस्तन्निबोध यथाश्रुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2085402, "chapter_id": 2818, "verse_number": "१२-३२३-७०", "content_sanskrit": "बुध्यमानो हि प्रकृतिं बुध्यते पञ्चविंशकः।\nन तु बुध्यति गन्धर्वप्रकृतिः पञ्चविंशकम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2085403, "chapter_id": 2818, "verse_number": "१२-३२३-७१", "content_sanskrit": "अनेन प्रतिबोधेन प्रधानं प्रवदन्ति तत्।\nसाङ्ख्ययोगार्थतत्त्वज्ञा यथ्नाश्रुतिनिदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2085404, "chapter_id": 2818, "verse_number": "१२-३२३-७२", "content_sanskrit": "पश्यंस्तथैव चापश्यन्पश्यत्यन्यः सदाऽनघ।\nषङ्विंशं पञ्चविंशं च चतुर्विशं च पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2085405, "chapter_id": 2818, "verse_number": "१२-३२३-७३", "content_sanskrit": "न तु पश्यति पश्यंस्तु यश्चैनमनुपश्यति।\nपञ्चविंशोऽभिमन्येत नान्योऽस्ति परतो मम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2085406, "chapter_id": 2818, "verse_number": "१२-३२३-७४", "content_sanskrit": "न चतुर्विशको ग्राह्यो मनुजैर्ज्ञानदर्शिभिः।\nमत्स्यो वोदकमन्वेति प्रवर्तेत प्रवर्तनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2085407, "chapter_id": 2818, "verse_number": "१२-३२३-७५", "content_sanskrit": "यथैव बुध्यते मत्स्यस्तथैषोऽप्यनुबुध्यते।\nस स्नेहात्सहवासाच्च साभिमानाच्च नित्यशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2085408, "chapter_id": 2818, "verse_number": "१२-३२३-७६", "content_sanskrit": "स निमज्जति कालस्य यदैकत्वं न बुध्यते।\nउन्मज्जति हि कालस्य समत्वेनाभिसंवृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2085409, "chapter_id": 2818, "verse_number": "१२-३२३-७७", "content_sanskrit": "यदा तु मन्यतेऽन्योऽहमन्य एष इति द्वजिः।\nतदा स केवलीभूतः षङ्विंशमनुपश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2085410, "chapter_id": 2818, "verse_number": "१२-३२३-७८", "content_sanskrit": "अन्यश्च राजन्परमस्तथाऽन्यः पञ्चविंशकः।\nतत्स्थत्वादनुपश्यन्ति एक एवेति साधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2085411, "chapter_id": 2818, "verse_number": "१२-३२३-७९", "content_sanskrit": "तेनैतन्नाभिनन्दन्ति पञ्चविंशकमच्युतम्।\nजन्ममृत्युभयाद्भीता योगाः साङ्ख्याश्च काश्यप।\nषङ्विंशमनुपश्यन्तः शुचयस्तत्परायणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2085412, "chapter_id": 2818, "verse_number": "१२-३२३-८०", "content_sanskrit": "यदा स केवलीभूतः षङ्विंशमनुपश्यति।\nतदा स सर्वविद्विद्वान्न पुनर्जन्म विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2085413, "chapter_id": 2818, "verse_number": "१२-३२३-८१", "content_sanskrit": "एवमप्रतिबुद्धश्च बुध्यमानश्च तेऽनघ।\nबुद्धिश्चोक्ता यथातत्त्वं मया श्रुतिनिदर्शनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2085414, "chapter_id": 2818, "verse_number": "१२-३२३-८२", "content_sanskrit": "पश्यापश्यं यो न पश्येत्क्षेम्यं तत्वं च काश्यप।\nकेवलाकेवलं चान्यत्पञ्चविंशं परं च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2085415, "chapter_id": 2818, "verse_number": "१२-३२३-८३x", "content_sanskrit": "विश्वावसुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2085416, "chapter_id": 2818, "verse_number": "१२-३२३-८३", "content_sanskrit": "तथ्यं शुभं चैतदुक्तं त्वया विभो।\nसम्यक्क्षेम्यं दैवताद्यं यथावत्।\nस्वस्त्यक्षयं भवतश्चास्तु नित्यं\nबुद्ध्या सदा बुद्धियुक्तं नमस्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2085417, "chapter_id": 2818, "verse_number": "१२-३२३-८४x", "content_sanskrit": "याज्ञवल्क्य उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2085418, "chapter_id": 2818, "verse_number": "१२-३२३-८४", "content_sanskrit": "एवमुक्त्वा संप्रयातो दिवं स\nविभ्राजन्वै श्रीमता दर्शनेन।\nदृष्टश्च तुष्ट्या परयाऽभिनन्द्य\nप्रदक्षिणं मम कृत्वा महात्मा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2085419, "chapter_id": 2818, "verse_number": "१२-३२३-८५", "content_sanskrit": "ब्रह्मादीनां खेचराणां क्षितौ च\nये चाधस्तात्संवसन्ते नरेन्द्र।\nतत्रैव तद्दर्शनं दर्शयन्वै\nसम्यक्क्षेम्यं ये पथं संश्रिता वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2085420, "chapter_id": 2818, "verse_number": "१२-३२३-८६", "content_sanskrit": "साङ्ख्याः सर्वे साङ्ख्यधर्मे रताश्च\nतद्वद्योगा योगधर्मे रताश्च।\nये चाप्यन्ये मोक्षकामा मनुष्या\nस्तेषामेतद्दर्शनं ज्ञानदृष्टम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2085421, "chapter_id": 2818, "verse_number": "१२-३२३-८७", "content_sanskrit": "ज्ञानान्मोक्षो जायते राजसिंह\nनास्त्यज्ञानादेवमाहुर्नरेन्द्र।\nतस्माज्ज्ञानं तत्त्वतोऽन्तेषितव्यं\nयेनात्मानं मोक्षयेज्जन्ममृत्योः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2085422, "chapter_id": 2818, "verse_number": "१२-३२३-८८", "content_sanskrit": "प्राप्य ज्ञानं ब्राह्मणात्क्षत्रियाद्वा\nवैश्याच्छ्रद्रादपि नीचादभीक्ष्णम्।\nश्रद्धातव्यं श्रद्दधानेन नित्यं\nन श्रद्धिनं जन्ममृत्यू विशेताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2085423, "chapter_id": 2818, "verse_number": "१२-३२३-८९", "content_sanskrit": "सर्वे वर्णा ब्राह्मणा ब्रह्मजाश्च\nसर्वे नित्यं व्याहरन्ते च ब्रह्म।\n` येनात्मानं मोक्षयेज्जन्ममृत्यो\nस्तत्त्वं शास्त्रं ब्रह्मबुद्ध्या ब्रवीमि।\nतत्त्वं शास्त्रं ब्रह्मबुद्ध्या ब्रवीमि\nसर्वं विश्वं ब्रह्म चैतत्समस्तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2085424, "chapter_id": 2818, "verse_number": "१२-३२३-९०", "content_sanskrit": "ब्रह्मास्यतो ब्राह्मणाः संप्रसूता\nबाहुभ्यां वै क्षत्रियाः संप्रसूताः।\nनाभ्यां वैश्याः पादतश्चापि शूद्राः\nसर्वे वर्णा नान्यथा वेदितव्याः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2085425, "chapter_id": 2818, "verse_number": "१२-३२३-९१", "content_sanskrit": "अज्ञानतः कर्मयोनिं भजन्ते\nतांतां राजंस्ते यथा यान्त्यभावम्।\nतथा वर्णा ज्ञानहीनाः पतन्ते\nघोरादज्ञानात्प्राकृतं योनिजालम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2085426, "chapter_id": 2818, "verse_number": "१२-३२३-९२", "content_sanskrit": "तस्माज्ज्ञानं सर्वतो मार्गितव्यं\nसर्वत्रस्थं चैतदुक्तं मया ते।\nतत्स्थो ब्रह्मा तस्थिवांश्चापरो य\nस्तस्मै नित्यं मोक्षमाहुर्नरेन्द्र॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2085427, "chapter_id": 2818, "verse_number": "१२-३२३-९३", "content_sanskrit": "यत्ते पृष्टं तन्मया चोपदिष्टं\nयाथातथ्यं तद्विशोको भजस्व।\nराजन्गच्छस्वैतदर्थस्य पारं\nसम्यक्प्रोक्तं स्वस्ति ते त्वस्तु नित्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2085428, "chapter_id": 2818, "verse_number": "१२-३२३-९४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2085429, "chapter_id": 2818, "verse_number": "१२-३२३-९४", "content_sanskrit": "स एवमनुशिष्टस्तु याज्ञवल्क्येन धीमता।\nप्रीतिमानभवद्राजा मिथिलाधिपतिस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2085430, "chapter_id": 2818, "verse_number": "१२-३२३-९५", "content_sanskrit": "गते मुनिवरे तस्मिन्कृते चापि प्रदक्षिणम्।\nदैवरातिर्नरपतिरासीनस्तत्र मोक्षवित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2085431, "chapter_id": 2818, "verse_number": "१२-३२३-९६", "content_sanskrit": "गोकोटिं स्पर्शयामास हिरण्यस्य तथैव च।\nरत्नाञ्जलिमथैकैकं ब्राह्मणेभ्यो ददौ तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2085432, "chapter_id": 2818, "verse_number": "१२-३२३-९७", "content_sanskrit": "वेदहराज्यं च तदा प्रतिष्ठाप्य सुतस्य वै।\nयतिधर्ममुपास्यंश्चाप्यवसन्मिथिलाधिपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2085433, "chapter_id": 2818, "verse_number": "१२-३२३-९८", "content_sanskrit": "साङ्ख्यज्ञानमधीयानो योगशास्त्रं च कृत्स्नशः।\nधर्माधर्मं च राजेन्द्र प्राकृतं परिगर्हयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2085434, "chapter_id": 2818, "verse_number": "१२-३२३-९९", "content_sanskrit": "अनन्त इति कृत्वा स नित्यं केवलमेव च।\nधर्माधर्मौ पुण्यपापे सत्यासत्ये तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2085435, "chapter_id": 2818, "verse_number": "१२-३२३-१००", "content_sanskrit": "जन्ममृत्यू च राजेन्द्र प्राकृतं तदचिन्तयत्।\nब्रह्माव्यक्तस्य कर्मेदमिति नित्यं नराधिप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2085436, "chapter_id": 2818, "verse_number": "१२-३२३-१०१", "content_sanskrit": "पश्यन्ति योगाः साङ्ख्याश्च स्वशास्त्रकृतलक्षणाः।\nइष्टानिष्टविमुक्तं हि तस्थौ ब्रह्म परात्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2085437, "chapter_id": 2818, "verse_number": "१२-३२३-१०२", "content_sanskrit": "नित्यं तदाहुर्विद्वांसः शुचि तस्माच्छुचिर्भव।\nदीयते यच्च लभते दत्तं यच्चानुमन्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2085438, "chapter_id": 2818, "verse_number": "१२-३२३-१०३", "content_sanskrit": "`अव्यक्तेनेति तच्चिन्त्यमन्यथा मा विचन्तय।\nददाति च नरश्रेष्ठ प्रतिगृह्णाति यच्च ह।\nददात्यव्यक्त इत्येतत्प्रतिगृह्णाति यच्च वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2085439, "chapter_id": 2818, "verse_number": "१२-३२३-१०४", "content_sanskrit": "आत्मा ह्येवात्मनो ह्येकः कोऽन्यस्तस्मात्परो भवेत्।\nएवं मन्यस्व सततमन्यथा मा विचिन्तय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2085440, "chapter_id": 2818, "verse_number": "१२-३२३-१०५", "content_sanskrit": "यस्याव्यक्तं न विदितं सगुणं निर्गुणं पुनः।\nतेन तीर्थानि यज्ञाश्च सेवितव्या विपश्चिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2085441, "chapter_id": 2818, "verse_number": "१२-३२३-१०६", "content_sanskrit": "न स्वाध्यायैस्तपोभिर्वा यज्ञैर्वा कुरुनन्दन।\nलभतेऽव्यक्तिकं स्थानं ज्ञात्वाऽव्यक्तं महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2085442, "chapter_id": 2818, "verse_number": "१२-३२३-१०७", "content_sanskrit": "तथैव महतः स्थानमाहंकारिकमेव च।\nअहंकारात्परं चापि स्थानानि समवाप्नुयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2085443, "chapter_id": 2818, "verse_number": "१२-३२३-१०८", "content_sanskrit": "ये त्वव्यक्तात्परं नित्यं जानते शास्त्रतत्पराः।\nजन्ममृत्युविमुक्तं च विमुक्तं सदसच्च यत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 2085444, "chapter_id": 2818, "verse_number": "१२-३२३-१०९", "content_sanskrit": "एतन्मयाऽऽप्तं जनकात्पुरस्ता\nत्तेनापि चाप्तं नृप याज्ञवल्क्यात्।\nज्ञातं विशिष्टं न तथा हि यज्ञा\nज्ञानेन दुर्गं तरते न यज्ञैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 2085445, "chapter_id": 2818, "verse_number": "१२-३२३-११०", "content_sanskrit": "दुर्गं जन्म निधनं चापि राज\nन्न भौतिकं ज्ञानविदो वदन्ति।\nयज्ञैस्तपोभिर्नियमैर्व्रतैश्च\nदिवं समासाद्य पतन्ति भूमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 2085446, "chapter_id": 2818, "verse_number": "१२-३२३-१११", "content_sanskrit": "तस्मादुपासस्व परं महच्छुचि\nशिवं विमोक्षं विमलं पवित्रम्।\nक्षेत्रं ज्ञात्वा पार्थिव ज्ञानयज्ञ\nमुपास्य वै तत्त्वमृषिर्भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 2085447, "chapter_id": 2818, "verse_number": "१२-३२३-११२", "content_sanskrit": "युदुपनिषदमुपाकरोत्तथाऽसौ\nजनकनृपस्य पुरा हि याज्ञवल्क्यः।\nयदुपगणितशाश्वताव्ययं त\nच्छुभममृतत्वमशोकमर्च्छति॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 2085448, "chapter_id": 2818, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि त्रयोविंशत्यधिकत्रिशततमोऽध्यायः॥ ३२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}]