[{"id": 7005445000, "chapter_id": 25445, "verse_number": "१-१५-१", "content_sanskrit": "नैमिषेया ऊचुः ।\nदेवानां दानवानां च गन्धर्वोरगरक्षसाम् ।\nउत्पत्तिं विस्तरात् ब्रूहि सूत वैवस्वतेऽन्तरे ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005445001, "chapter_id": 25445, "verse_number": "१-१५-२", "content_sanskrit": "स शप्तः शंभुना पूर्वं दक्षः प्राचेतसो नृपः ।\nकिमकार्षोन्महाबुद्धे श्रोतुमिच्छाम सांप्रतम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005445002, "chapter_id": 25445, "verse_number": "१-१५-३", "content_sanskrit": "सूत उवाच ।\nवक्ष्ये नारायणेनोक्तं पूर्वकल्पानुषङ्गिकम् ।\nत्रिकालबद्धं पापघ्नं प्रजासर्गस्य विस्तरम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005445003, "chapter_id": 25445, "verse_number": "१-१५-४", "content_sanskrit": "स शप्तः शंभुना पूर्वं दक्षः प्राचेतसो नृपः ।\nविनिन्द्य पूर्ववैरेण गङ्गाद्वरेऽयजद्‌ भवम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005445004, "chapter_id": 25445, "verse_number": "१-१५-५", "content_sanskrit": "देवाश्च सर्वे भागार्थमाहूता विष्णुना सह ।\nसहैव मुनिभिः सर्वैरागता मुनिपुंगवाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005445005, "chapter_id": 25445, "verse_number": "१-१५-६", "content_sanskrit": "दृष्ट्वा देवकुलं कृत्स्नं शंकरेण विनागतम् ।\nदधीचो नाम विप्रर्षिः प्राचेतसमथाब्रवीत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005445006, "chapter_id": 25445, "verse_number": "१-१५-७", "content_sanskrit": "दधीच उवाच ।\nब्रह्माद्यस्तु पिशाचान्ता यस्याज्ञानुविधायिनः ।\nस देवः सांप्रतं रुद्रो विधिना किं न पूज्यते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005445007, "chapter_id": 25445, "verse_number": "१-१५-८", "content_sanskrit": "दक्ष उवाच ।\nसर्वेष्वेव हि यज्ञेषु न भागः परिकल्पितः ।\nन मन्त्रा भार्यया सार्द्धं शंकरस्येति नेज्यते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005445008, "chapter_id": 25445, "verse_number": "१-१५-९", "content_sanskrit": "विहस्य दक्षं कुपितो वचः प्राह महामुनिः ।\nश्रृण्वतां सर्वदेवानां सर्वज्ञानमयः स्वयम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005445009, "chapter_id": 25445, "verse_number": "१-१५-१०", "content_sanskrit": "दधीच उवाच ।\nयतः प्रवृत्तिर्विश्वात्मा यश्चास्य परमेश्वरः ।\nसंपूज्यते सर्वयज्ञैर्विदित्वा किन्न शंकरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005445010, "chapter_id": 25445, "verse_number": "१-१५-११", "content_sanskrit": "न ह्यं शंकरो रुद्रः संहर्त्ता तामसो हरः ।\nनग्नः कपाली विदितो विश्वात्मा नोपपद्यते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005445011, "chapter_id": 25445, "verse_number": "१-१५-१२", "content_sanskrit": "ईश्वरो हि जगत्स्रष्टा प्रभुर्नारायणः स्वराट् ।\nसत्त्वात्मकोऽसौ भगवानिज्यते सर्वकर्मसु ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005445012, "chapter_id": 25445, "verse_number": "१-१५-१३", "content_sanskrit": "दधीच उवाच ।\nकिं त्वया भगवानेष सहस्त्रांशुर्न दृश्यते ।\nसर्वलोकैकसंहर्त्ता कालात्मा परमेश्वरः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005445013, "chapter_id": 25445, "verse_number": "१-१५-१४", "content_sanskrit": "यं गृणन्तीह विद्वांसो धार्मिका ब्रह्मवादिनः ।\nसोऽयं साक्षी तीव्ररोचिः कालात्मा शांकरीतनुः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005445014, "chapter_id": 25445, "verse_number": "१-१५-१५", "content_sanskrit": "एष रुद्रो महादेवः कपर्दो च घृणी हरः ।\nआदित्यो भगवान् सूर्यो नीलग्रीवो विलोहितः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005445015, "chapter_id": 25445, "verse_number": "१-१५-१६", "content_sanskrit": "संस्तूयते सहस्रांशुः सामगाध्वर्युहोतृभिः ।\nपश्यैनं विश्वकर्माणं रुद्रमूर्ति त्रयीमयम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005445016, "chapter_id": 25445, "verse_number": "१-१५-१७", "content_sanskrit": "दक्ष उवाच ।\nय एते द्वादशादित्या आगता यज्ञभागिनः ।\nसर्वे सूर्या इति ज्ञेया न ह्यान्यो विद्यते रविः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005445017, "chapter_id": 25445, "verse_number": "१-१५-१८", "content_sanskrit": "एवमुक्ते तु मुनयः समायाता दिदृक्षवः ।\nबाढमित्यब्रुवन् दक्षं तस्य साहाय्यकारिणः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005445018, "chapter_id": 25445, "verse_number": "१-१५-१९", "content_sanskrit": "तमसाविष्टमनसो न पश्यन्ति वृषध्वजम् ।\nसहस्त्रशोऽथ शतशो भूय एव विनिन्द्यते ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7005445019, "chapter_id": 25445, "verse_number": "१-१५-२०", "content_sanskrit": "निन्दन्तो वैदिकान् मन्त्रान् सर्वभूतपतिं हरम् ।\nअपूजयन् दक्षवाक्यं मोहिता विष्णुमायया ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7005445020, "chapter_id": 25445, "verse_number": "१-१५-२१", "content_sanskrit": "देवाश्च सर्वे भागार्थमागता वासवादयः ।\nनापश्यन् देवमीशानमृते नारायणं हरिम् ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7005445021, "chapter_id": 25445, "verse_number": "१-१५-२२", "content_sanskrit": "हिरण्यगर्भो भगवान् ब्रह्मा ब्रह्मविदां वरः ।\nपश्यतामेव सर्वेषां क्षणादन्तरधीयत ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7005445022, "chapter_id": 25445, "verse_number": "१-१५-२३", "content_sanskrit": "अन्तर्हिते भगवति दक्षो नारायणं हरिम् ।\nरक्षकं जगतां देवं जगाम शरणं स्वयम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7005445023, "chapter_id": 25445, "verse_number": "१-१५-२४", "content_sanskrit": "प्रवर्त्तयामास च तं यज्ञं दक्षोऽथ निर्भयः ।\nरक्षते भगवान् विष्णुः शरणागतरक्षकः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7005445024, "chapter_id": 25445, "verse_number": "१-१५-२५", "content_sanskrit": "पुनः प्राह च तं दक्षं दधीचो भगवानृषिः ।\nसंप्रेक्ष्यर्षिगणान् देवान् सर्वान् वै रुद्रविद्विषः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7005445025, "chapter_id": 25445, "verse_number": "१-१५-२६", "content_sanskrit": "अपूज्यपूजने चैव पूज्यानां चाप्यपूजने ।\nनरः पापमवाप्नोति महद् वै नात्र संशयः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7005445026, "chapter_id": 25445, "verse_number": "१-१५-२७", "content_sanskrit": "असतां प्रग्रहो यत्र सतां चैव विमानना ।\nदण्डो दैवकृतस्तत्र सद्यः पतति दारुणः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7005445027, "chapter_id": 25445, "verse_number": "१-१५-२८", "content_sanskrit": "एवमुक्त्वा तु विप्रर्षिः शशापेश्वरविद्विषः ।\nसमागतान् ब्राह्मणांस्तान् दक्षसाहाय्यकारिणः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7005445028, "chapter_id": 25445, "verse_number": "१-१५-२९", "content_sanskrit": "यस्माद् बहिष्कृता वेदात्भवद्भिः परमेश्वरः ।\nविनिन्दितो महादेवः शंकरो लोकवन्दितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7005445029, "chapter_id": 25445, "verse_number": "१-१५-३०", "content_sanskrit": "भविष्यध्वं त्रयीबाह्याः सर्वेऽपीश्वरविद्विषः ।\nनिन्दन्तो ह्यैश्वरं मार्गं कुशास्त्रासक्तमानसाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7005445030, "chapter_id": 25445, "verse_number": "१-१५-३१", "content_sanskrit": "मिथ्याधीतसमाचारा मिथ्याज्ञानप्रलापिनः ।\nप्राप्य घोरं कलियुगं कलिजैः किल पीडिताः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7005445031, "chapter_id": 25445, "verse_number": "१-१५-३२", "content_sanskrit": "त्यक्त्वा तपोबलं कृत्स्नं गच्छध्वं नरकान् पुनः ।\nभविष्यति हृषीकेशः स्वाश्रितोऽपि पराङ्‌मुखः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7005445032, "chapter_id": 25445, "verse_number": "१-१५-३३", "content_sanskrit": "एवमुक्त्वा तु विप्रर्षिर्विरराम तपोनिधिः ।\nजगाम मनसा रुद्रमशेषाघविनाशनम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7005445033, "chapter_id": 25445, "verse_number": "१-१५-३४", "content_sanskrit": "एतस्मिन्नन्तरे देवी महादेवं महेश्वरम् ।\nपतिं पशुपतिं देवं ज्ञात्वैतत् प्राह सर्वदृक् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7005445034, "chapter_id": 25445, "verse_number": "१-१५-३५", "content_sanskrit": "देव्युवाच ।\nदक्षो यज्ञेन यजते पिता मे पूर्वजन्मनि ।\nविनिन्द्य भवतो भावमात्मानं चापि शंकर ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7005445035, "chapter_id": 25445, "verse_number": "१-१५-३६", "content_sanskrit": "देवाः सहर्षिभिश्चासंस्तत्र साहाय्यकारिणः ।\nविनाशयाशु तं यज्ञं वरमेकं वृणोम्यहम् ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7005445036, "chapter_id": 25445, "verse_number": "१-१५-३७", "content_sanskrit": "एवं विज्ञापितो देव्या देवदेव परः प्रभुः ।\nससर्ज सहसा रुद्रं दक्षयज्ञजिघांसया ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7005445037, "chapter_id": 25445, "verse_number": "१-१५-३८", "content_sanskrit": "सहस्रशीर्षपादं च सहस्राक्षं महाभुजम् ।\nसहस्त्रपाणिं दुर्धर्षं युगान्तानलसन्निभम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7005445038, "chapter_id": 25445, "verse_number": "१-१५-३९", "content_sanskrit": "दंष्ट्राकरालं दुष्प्रेक्ष्यं शङ्खचक्रगदाधरम् ।\nदण्डहस्तं महानादं शार्ङ्गिणं भूतिभूषणम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7005445039, "chapter_id": 25445, "verse_number": "१-१५-४०", "content_sanskrit": "वीरभद्र इति ख्यातं देवदेवसमन्वितम् ।\nस जातमात्रो देवेशमुपतस्थे कृताञ्जलिः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7005445040, "chapter_id": 25445, "verse_number": "१-१५-४१", "content_sanskrit": "तमाह दक्षस्य मखं विनाशय शिवोऽस्तु ते ।\nविनिन्द्य मां स यजते गङ्गाद्वारे गणेश्वर ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7005445041, "chapter_id": 25445, "verse_number": "१-१५-४२", "content_sanskrit": "ततो बन्धुप्रयुक्तेन सिंहेनैकेन लीलया ।\nवीरभद्रेण दक्षस्य विनाशमगमत् क्रतुः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7005445042, "chapter_id": 25445, "verse_number": "१-१५-४३", "content_sanskrit": "मन्युना चोमया सृष्टा भद्रकाली महेश्वरी ।\nतया च सार्द्धं वृषभं समारुह्य ययौ गणः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7005445043, "chapter_id": 25445, "verse_number": "१-१५-४४", "content_sanskrit": "अन्ये सहस्रशो रुद्रा निसृष्टास्तेन धीमता ।\nरोमजा इति विख्यातास्तस्य साहाय्यकारिणः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7005445044, "chapter_id": 25445, "verse_number": "१-१५-४५", "content_sanskrit": "शूलशक्तिगदाहस्ताष्टङ्कोपलकरास्तथा ।\nकालाग्निरुद्रसंकाशा नादयन्तो दिशो दश ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7005445045, "chapter_id": 25445, "verse_number": "१-१५-४६", "content_sanskrit": "सर्वे वृषभमारूढाः सभार्याश्चातिभीषणाः ।\nसमावृत्य गणश्रेष्ठं ययुर्दक्षमखं प्रति ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7005445046, "chapter_id": 25445, "verse_number": "१-१५-४७", "content_sanskrit": "सर्वे शंप्राप्य तं देशं गङ्गाद्वारमिति श्रुतम् ।\nददृशुर्यज्ञदेशं तं दक्षस्यामिततेजसः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7005445047, "chapter_id": 25445, "verse_number": "१-१५-४८", "content_sanskrit": "देवाङ्गनासहस्त्राढ्यमप्सरोगीतनादितम् ।\nवेणुवीणानिनादाढ्यं वेदवादाभिनादितम् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7005445048, "chapter_id": 25445, "verse_number": "१-१५-४९", "content_sanskrit": "दृष्ट्वा सहर्षिभिर्देवैः समासीनं प्रजापतिम् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7005445049, "chapter_id": 25445, "verse_number": "१-१५-५०", "content_sanskrit": "उवाच भद्रया रुद्रैर्वीरभद्रः स्मयन्निव ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7005445050, "chapter_id": 25445, "verse_number": "१-१५-५१", "content_sanskrit": "वयं ह्यनुचराः सर्वे शर्वस्यामिततेजसः ।\nभागाभिलिप्सया भागान् प्राप्ता यच्छध्वमीप्सितान् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7005445051, "chapter_id": 25445, "verse_number": "१-१५-५२", "content_sanskrit": "अथ चेत् कस्यचिदियमाज्ञा मुनिसुरोत्तमाः ।\nभागो भवद्भ्यो देयस्तु नास्मभ्यमिति कथ्यताम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7005445052, "chapter_id": 25445, "verse_number": "१-१५-५३", "content_sanskrit": "तं ब्रूताज्ञापयति यो वेत्स्यामो हि वयं ततः ।\nएवमुक्ता गणेशेन प्रजापतिपुरः सराः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7005445053, "chapter_id": 25445, "verse_number": "१-१५-५४", "content_sanskrit": "देवा ऊचुः नेज्यते र्यज्ञभागेन न च मन्त्रा इति प्रभुः ।\nमन्त्रा ऊचुः सुरा यूयं तमोपहतचेतसः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7005445054, "chapter_id": 25445, "verse_number": "१-१५-५५", "content_sanskrit": "येनाध्वरस्य राजानं पूजयध्वं महेश्वरम् ।\nईश्वरः सर्वभूतानां सर्वभूततनुर्हरः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7005445055, "chapter_id": 25445, "verse_number": "१-१५-५६", "content_sanskrit": "पूज्यते सर्वयज्ञेषु सर्वाभ्युदसिद्धिदः ।\nएवमुक्त्वा महीशानं मायया नष्टचेतनाः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7005445056, "chapter_id": 25445, "verse_number": "१-१५-५७", "content_sanskrit": "न मेनिरे ययुर्मन्त्रा देवान् मुक्त्वा स्वमालयम् ।\nततः स रुद्रो भगवान् सभार्यः सगणेश्वरः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7005445057, "chapter_id": 25445, "verse_number": "१-१५-५८", "content_sanskrit": "स्पृशन् कराभ्यां ब्रह्मर्षि दधीचं प्राह देवताः ।\nमन्त्राः प्रमाणं न कृता युष्माभिर्बलदर्पितैः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7005445058, "chapter_id": 25445, "verse_number": "१-१५-५९", "content_sanskrit": "यस्मात् प्रसह्य तस्माद्‌ वो नाशयाम्यद्य गर्वितान् ।\nइत्युक्त्वा यज्ञशालां तां ददाह गणपुंगवः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7005445059, "chapter_id": 25445, "verse_number": "१-१५-६०", "content_sanskrit": "गणेश्वराश्च संक्रुद्धा यूपानुत्पाट्य चिक्षिपुः ।\nप्रस्तोत्रा सह होत्रा च अश्वं चैव गणेश्वराः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7005445060, "chapter_id": 25445, "verse_number": "१-१५-६१", "content_sanskrit": "गृहीत्वा भीषणाः सर्वे गङ्गास्त्रोतसि चिक्षिपुः ।\nवीरभद्रोऽपि दीप्तात्मा शक्रस्योद्यच्छतं करम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7005445061, "chapter_id": 25445, "verse_number": "१-१५-६२", "content_sanskrit": "व्यष्टम्भयददीनात्मा तथाऽन्येषां दिवौकसाम् ।\nभगस्य नेत्रे चोत्पाट्य कराग्रेणैव लीलया ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7005445062, "chapter_id": 25445, "verse_number": "१-१५-६३", "content_sanskrit": "निहत्य मुष्टिना दन्तान् पूष्णश्चैवमपातयत् ।\nतथा चन्द्रमसं देवं पादाङ्‌गुष्ठेन लीलया ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7005445063, "chapter_id": 25445, "verse_number": "१-१५-६४", "content_sanskrit": "धर्षयामास बलवान् स्मयमानो गणेश्वरः ।\nवह्नेर्हस्तद्वयं छित्त्वा जिह्वामुत्पाट्य लीलया ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7005445064, "chapter_id": 25445, "verse_number": "१-१५-६५", "content_sanskrit": "जघान मूर्ध्नि पादेन मुनीनपि मुनीश्वराः ।\nतथा विष्णुं सहरुडं समायान्तं महाबलः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7005445065, "chapter_id": 25445, "verse_number": "१-१५-६६", "content_sanskrit": "विव्याध निशेतैर्बाणैः स्तम्भयित्वा सुदर्शनम् ।\nसमालोक्य महाबाहुरागत्य गरुडो गणम् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7005445066, "chapter_id": 25445, "verse_number": "१-१५-६७", "content_sanskrit": "जघान पक्षैः सहसा ननादाम्बुनिधिर्यथा ।\nततः सहस्त्रशो भद्रः ससर्ज गरुडान् स्वयम् ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7005445067, "chapter_id": 25445, "verse_number": "१-१५-६८", "content_sanskrit": "वैनतेयादभ्यधिकान् गरुडं ते प्रदुद्रुवुः ।\nतान् दृष्ट्वा गरुडो धीमान् पलायत महाजवः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7005445068, "chapter_id": 25445, "verse_number": "१-१५-६९", "content_sanskrit": "विसृज्य माधवं वेगात् तदद्‌भुतमिवाभवत् ।\nअन्तर्हिते वैनतेये भगवान् पद्मसंभवः ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7005445069, "chapter_id": 25445, "verse_number": "१-१५-७०", "content_sanskrit": "आगत्य वारयामास वीरभद्रं च केशवम् ।\nप्रसादयामास च तं गौरवात् परमेष्ठिनः ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7005445070, "chapter_id": 25445, "verse_number": "१-१५-७१", "content_sanskrit": "संस्तूय भगवानीशं साम्बस्तत्रागमत् स्वयम् ।\nवीक्ष्य देवाधिदेवं तमुमां सर्वगणैर्वृताम् ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7005445071, "chapter_id": 25445, "verse_number": "१-१५-७२", "content_sanskrit": "तुष्टाव भगवान् ब्रह्मा दक्षः सर्वे दिवौकसः ।\nविशेषात् पार्वतीं देवीमीश्वरार्द्धशरीरिणीम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7005445072, "chapter_id": 25445, "verse_number": "१-१५-७३", "content_sanskrit": "स्तोत्रैर्नानाविधैर्दक्षः प्रणम्य च कृताञ्जलिः ।\nततो भगवती देवी प्रहसन्ती महेश्वरम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7005445073, "chapter_id": 25445, "verse_number": "१-१५-७४", "content_sanskrit": "प्रसन्नमानसा रुद्रं वचः प्राह घृणानिधिः ।\nत्वमेव जगतः स्त्रष्टा शासिता चैव रक्षकः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7005445074, "chapter_id": 25445, "verse_number": "१-१५-७५", "content_sanskrit": "अनुग्राह्यो भगवता दक्षश्चापि दिवौकसः ।\nततः प्रहस्य भगवान् कपर्दी नीललोहितः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7005445075, "chapter_id": 25445, "verse_number": "१-१५-७६", "content_sanskrit": "उवाच प्रणतान् देवान् प्राचेतसमथो हरः ।\nगच्छध्वं देवताः सर्वाः प्रसन्नो भवतामहम् ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7005445076, "chapter_id": 25445, "verse_number": "१-१५-७७", "content_sanskrit": "संपूज्यः सर्वयज्ञेषु न निन्द्योऽहं विशेषतः ।\nत्वं चापि श्रृणु मे दक्ष वचनं सर्वरक्षणम् ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7005445077, "chapter_id": 25445, "verse_number": "१-१५-७८", "content_sanskrit": "त्यक्त्वा लोकैषणामेतां मद्भक्तो भव यत्नतः ।\nभविष्यसि गणेशानः कल्पान्तेऽनुग्रहान्मम ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7005445078, "chapter_id": 25445, "verse_number": "१-१५-७९", "content_sanskrit": "तावत् तिष्ठ ममादेशात् स्वाधिकारेषु निर्वृतः ।\nएवमुक्त्वा स भगवान् सपत्नीकः सहानुगः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7005445079, "chapter_id": 25445, "verse_number": "१-१५-८०", "content_sanskrit": "अदर्शनमनुप्राप्तो दक्षस्यामिततेजसः ।\nअन्तर्हिते महादेवे शंकरे पद्मसंभवः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7005445080, "chapter_id": 25445, "verse_number": "१-१५-८१", "content_sanskrit": "व्याजहार स्वयं दक्षमशेषजगतो हितम् ।\nब्रह्मोवाच ।\nकिं तवापगतो मोहः प्रसन्ने वृषभध्वजे ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7005445081, "chapter_id": 25445, "verse_number": "१-१५-८२", "content_sanskrit": "यदाचष्टे स्वयं देवः पालयैतदतन्द्रितः ।\nसर्वेषामेव भूतानां हृद्येष वसतीश्वरः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7005445082, "chapter_id": 25445, "verse_number": "१-१५-८३", "content_sanskrit": "पश्यन्त्येनं ब्रह्मभूता विद्वांसो वेदवादिनः ।\nस आत्मा सर्वभूतानां स बीजं परमा गतिः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7005445083, "chapter_id": 25445, "verse_number": "१-१५-८४", "content_sanskrit": "स्तूयते वैदिकैर्मन्त्रैर्देवदेवो महेश्वरः ।\nतमर्चयति यो रुद्रं स्वात्मन्येकं सनातनम् ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7005445084, "chapter_id": 25445, "verse_number": "१-१५-८५", "content_sanskrit": "चेतसा भावयुक्तेन स याति परमं पदम् ।\nतस्मादनादिमध्यान्तं विज्ञाय परमेश्वरम् ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7005445085, "chapter_id": 25445, "verse_number": "१-१५-८६", "content_sanskrit": "कर्मणा मनसा वाचा समाराधय यत्नतः ।\nयत्नात् परिहरेशस्य निन्दामात्मविनाशनीम् ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7005445086, "chapter_id": 25445, "verse_number": "१-१५-८७", "content_sanskrit": "भवन्ति सर्वदोषाय निन्दकस्य क्रिया यतः ।\nयस्तु चैष महायोगी रक्षको विष्णुरव्ययः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7005445087, "chapter_id": 25445, "verse_number": "१-१५-८८", "content_sanskrit": "स देवदेवो भगवान् महादेवो न संशयः ।\nमन्यन्ते ये जगद्योनिं विभिन्नं विष्णुमीश्वरात् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7005445088, "chapter_id": 25445, "verse_number": "१-१५-८९", "content_sanskrit": "मोहादवेदनिष्ठत्वात् ते यान्ति नरकं नराः ।\nवेदानुवर्तिनो रुद्रं देवं नारायणं तथा ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7005445089, "chapter_id": 25445, "verse_number": "१-१५-९०", "content_sanskrit": "एकीभावेन पश्यन्ति मुक्तिभाजो भवन्ति ते ।\nयो विष्णुः स स्वयं रुद्रो यो रुद्रः स जनार्दनः ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7005445090, "chapter_id": 25445, "verse_number": "१-१५-९१", "content_sanskrit": "इति मत्वा यजेद् देवं स याति परमां गतिम् ।\nसृजत्येष जगत्सर्वं विष्णुस्तत् पश्यतीश्वरः ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7005445091, "chapter_id": 25445, "verse_number": "१-१५-९२", "content_sanskrit": "इत्थं जगत् सर्वमिदं रुद्रनारायणोद्भवम् ।\nतस्मात् त्यक्त्वा हरेर्निन्दां विष्णावपि समाहितः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7005445092, "chapter_id": 25445, "verse_number": "१-१५-९३", "content_sanskrit": "समाश्रय्महादेवं शरण्यं ब्रह्मवादिनाम् ।\nउपश्रुत्याथ वचनं विरिञ्चस्य प्रजापतिः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7005445093, "chapter_id": 25445, "verse_number": "१-१५-९४", "content_sanskrit": "जगाम शरणं देवं गोपतिं कृत्तिवाससम् ।\nयेऽन्ये शापाग्निनिर्दग्धा दधीचस्य महर्षयः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7005445094, "chapter_id": 25445, "verse_number": "१-१५-९५", "content_sanskrit": "द्विषन्तो मोहिता देवं संबभूवुः कलिष्वथ ।\nत्यक्त्वा तपोबलं कृत्स्नं विप्राणां कुलसंभवाः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7005445095, "chapter_id": 25445, "verse_number": "१-१५-९६", "content_sanskrit": "पूर्वसंस्कारमहात्म्याद् ब्रह्मणो वचनादिह ।\nमुक्तशापास्ततः सर्वे कल्पान्ते रौरवादिषु ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7005445096, "chapter_id": 25445, "verse_number": "१-१५-९७", "content_sanskrit": "निपात्यमानाः कालेन संप्राप्यादित्यवर्चसम् ।\nब्रह्माणं जगतामीशमनुज्ञाताः स्वयंभुवा ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7005445097, "chapter_id": 25445, "verse_number": "१-१५-९८", "content_sanskrit": "समाराध्य तपोयोगादीशानं त्रिदशाधिपम् ।\nभविष्यन्ति यथा पूर्वं शंकरस्य प्रसादतः ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7005445098, "chapter_id": 25445, "verse_number": "१-१५-९९", "content_sanskrit": "एतद्वः कथितं सर्वं दक्षयज्ञनिषूदनम् ।\nश्रृणुध्वं दक्षपुत्रीणां सर्वासां चैव संततिम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}]