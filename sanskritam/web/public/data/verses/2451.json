[{"id": 2069309, "chapter_id": 2451, "verse_number": "१०-३-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2069310, "chapter_id": 2451, "verse_number": "१०-३-१", "content_sanskrit": "कृपस्य वचनं श्रुत्वा धर्मार्थसहितं शुभम्।\nअश्वत्थामा महाराज दुःखशोकसमन्वितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2069311, "chapter_id": 2451, "verse_number": "१०-३-२", "content_sanskrit": "दह्यमानस्तु शोकेन प्रदीप्तेनाग्निना यथा।\nक्रूरं मनस्ततः कृत्वा तावभौ प्रत्यभाषत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2069312, "chapter_id": 2451, "verse_number": "१०-३-३", "content_sanskrit": "पुरुषेपुरुषे बुद्धिर्याया भवति शोभना।\nतुष्यन्ति च पृथक्सर्वे प्रज्ञया ते स्वयास्वया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2069313, "chapter_id": 2451, "verse_number": "१०-३-४", "content_sanskrit": "सर्वो हि मन्यते लोक आत्मानं बुद्धिमत्तरम्।\nसर्वस्यात्मा बहुमतः सर्वोत्मानं प्रशंसति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2069314, "chapter_id": 2451, "verse_number": "१०-३-५", "content_sanskrit": "सर्वस्य हि स्वका प्रज्ञा साधुवादे प्रतिष्ठिता।\nपरबुद्धिं च निन्दन्ति स्वां प्रशंसन्ति चासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2069315, "chapter_id": 2451, "verse_number": "१०-३-६", "content_sanskrit": "कारणान्तरयोगेन येषां संवदते मतिः।\nतेऽन्योन्येन च तुष्यन्ति बहुमन्यन्ति चासकृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2069316, "chapter_id": 2451, "verse_number": "१०-३-७", "content_sanskrit": "तस्यैव तु मनुष्यस्य सासा बुद्धिस्तदातदा।\nकालयोगे विपर्यासं प्राप्यान्योन्यं विपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2069317, "chapter_id": 2451, "verse_number": "१०-३-८", "content_sanskrit": "अनित्यत्वात्तु चित्तानां मनुष्याणां विशेषतः।\nचित्तवैक्लब्यमासाद्य सासा बुद्धिः प्रजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2069318, "chapter_id": 2451, "verse_number": "१०-३-९", "content_sanskrit": "यथा हि वैद्यः कुशलो ज्ञात्वा व्याधिं यथाविधि।\nभैषज्यं कुरुते योगात्प्रशमार्थमिति प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2069319, "chapter_id": 2451, "verse_number": "१०-३-१०", "content_sanskrit": "एवं कार्यस्य योगात्प्रशमार्थमिति प्रभो॥\nप्रज्ञया च स्वया युक्त्या तां च गृह्णन्ति वै बुधाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2069320, "chapter_id": 2451, "verse_number": "१०-३-११", "content_sanskrit": "अन्यया यौवने बाल्ये बुद्ध्या भवति मोहितः।\nमध्येऽन्यया जरायां तु सोन्यां रोचयते मतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2069321, "chapter_id": 2451, "verse_number": "१०-३-१२", "content_sanskrit": "व्यसन वा महाघोरं समृद्धिं चापि तादृशीम्।\nअवाप्य पुरुषो भोज कुरुते बुद्धिवैकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2069322, "chapter_id": 2451, "verse_number": "१०-३-१३", "content_sanskrit": "एकस्मिन्नेव पुरुषे सासा बुद्धिस्तदातदा।\nभवत्यनित्या प्रज्ञा हि सा तस्यैव न रोचते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2069323, "chapter_id": 2451, "verse_number": "१०-३-१४", "content_sanskrit": "निश्चित्य तु यथाप्रज्ञं यां मतिं साधु पश्यति।\nतया प्रकुरुते भावं सा तस्योद्योगकारिका॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2069324, "chapter_id": 2451, "verse_number": "१०-३-१५", "content_sanskrit": "सर्वो हि पुरुषो भोज साध्वेतदिति निश्चितः।\nकर्तुमारभते प्रीतिं मरणादिषु कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2069325, "chapter_id": 2451, "verse_number": "१०-३-१६", "content_sanskrit": "सर्वे हि युक्तां विज्ञाय प्रज्ञां वापि स्वकां नराः।\nचेष्टन्ते विविधां चेष्टां हितमित्येव जानते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2069326, "chapter_id": 2451, "verse_number": "१०-३-१७", "content_sanskrit": "उपजाता व्यसनजा येयमद्य मतिर्मम।\nयुवयोस्तां प्रवक्ष्यामि सर्वेषां शोकनाशिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2069327, "chapter_id": 2451, "verse_number": "१०-३-१८", "content_sanskrit": "प्रजापतिः प्रजाः सृष्ट्वा कर्म तासु विधाय च।\nवर्णेवर्णे समाधत्त ह्येकैकं गुणवत्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2069328, "chapter_id": 2451, "verse_number": "१०-३-१९", "content_sanskrit": "ब्राह्मणे वेदमग्र्यं तु क्षत्रिये तेज उत्तमम्।\nदाक्ष्यं वैश्ये च शूद्रे च सर्ववर्णानुकूलताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2069329, "chapter_id": 2451, "verse_number": "१०-३-२०", "content_sanskrit": "अदान्तो ब्राह्मणोऽसाधुर्निस्तेजाः क्षत्रियो मृतः।\nअदक्षो निन्द्यते वैश्यः शूद्रश्च प्रतिकूलवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2069330, "chapter_id": 2451, "verse_number": "१०-३-२१", "content_sanskrit": "सोऽस्मि जातः कुले श्रेष्ठे ब्राह्मणैरभिपूजिते।\nमन्दभाग्यतयाऽस्म्येतं क्षत्रधर्ममनुष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2069331, "chapter_id": 2451, "verse_number": "१०-३-२२", "content_sanskrit": "क्षत्रधर्मं विदित्वाऽहं यदि ब्राह्मण्यमाश्रितः।\nप्रकरिष्ये महत्कर्म न मे तत्साधुसम्मतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2069332, "chapter_id": 2451, "verse_number": "१०-३-२३", "content_sanskrit": "धारयित्वा धनुर्दिव्यं दिव्यान्यस्त्राणि चाहवे।\nपितरं निहतं दृष्ट्वा किन्नु वक्ष्यामि संसदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2069333, "chapter_id": 2451, "verse_number": "१०-३-२४", "content_sanskrit": "सोऽहमद्य यथाकामं क्षत्रधर्ममवाप्य च।\nगन्ताऽस्मि पदवीं राज्ञः पितुश्चापि महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2069334, "chapter_id": 2451, "verse_number": "१०-३-२५", "content_sanskrit": "अद्य स्वप्स्यन्ति पाञ्चाला विश्वस्ता जितकाशिनः।\nविमुक्तयुग्यकवचा हर्षेण च समन्विताः।\nवयं जिता मताश्चैषां श्रान्ता व्यायामकर्शिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2069335, "chapter_id": 2451, "verse_number": "१०-३-२६", "content_sanskrit": "तेषां निशि प्रसुप्तानां सुस्थानां शिबिरे स्वके।\nअवस्कन्दं करिष्यामि शिबिरस्याद्य दुष्करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2069336, "chapter_id": 2451, "verse_number": "१०-३-२७", "content_sanskrit": "तानवस्कन्द्य शिबिरे प्रेतभूतानचेतसः।\nसूदयिष्यामि विक्रम्य मघवानिव दानवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2069337, "chapter_id": 2451, "verse_number": "१०-३-२८", "content_sanskrit": "अद्य तान्सहितान्सर्वान्धृष्टद्युम्नपुरोगमान्।\nसूदयिष्यामि विक्रम्य कक्षं दीप्त इवानलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2069338, "chapter_id": 2451, "verse_number": "१०-३-२९", "content_sanskrit": "निहत्य चैव पाञ्चालाञ्शान्तिं लब्धाऽस्मि सत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2069339, "chapter_id": 2451, "verse_number": "१०-३-३०", "content_sanskrit": "पाञ्चालेषु चरिष्यामि सूदयन्नद्य संयुगे।\nपिनाकपाणिः सङ्क्रुद्धः स्वयं रुद्रः पशुष्विव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2069340, "chapter_id": 2451, "verse_number": "१०-३-३१", "content_sanskrit": "अद्याहं सर्वपाञ्चालान्निकृत्या च निकृष्य च।\nअर्दयिष्यामि संहृष्टो रणे पाण्डुसुतांस्तथा।\n`सूदयिष्यामि सङ्क्रुद्धः पशूनिव पिनाकधृत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2069341, "chapter_id": 2451, "verse_number": "१०-३-३२", "content_sanskrit": "अद्याहं सर्वपाञ्चालैः कृत्वा भूमिं शरीरिणीम्।\nप्रहृत्यैकेन शस्त्रेण भविष्याम्यनृणः पितुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2069342, "chapter_id": 2451, "verse_number": "१०-३-३३", "content_sanskrit": "दुर्योधनस्य कर्णस्य भीष्मसैन्धवयोरपि।\nगमिष्यामि निशावेलां पदवीमद्य दुर्गमाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2069343, "chapter_id": 2451, "verse_number": "१०-३-३४", "content_sanskrit": "अद्य पाञ्चालराजस्य धृष्टद्युम्नस्य वै निशि।\nविरात्रे प्रमथिष्यामि पशोरिव शिरो बलात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2069344, "chapter_id": 2451, "verse_number": "१०-३-३५", "content_sanskrit": "अद्य पाञ्चालपाण्डूनां शयितानां शिरो निशि।\nखङ्गेन निशितेनाजौ प्रमथिष्यामि गौतम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2069345, "chapter_id": 2451, "verse_number": "१०-३-३६", "content_sanskrit": "अद्य पाञ्चालसेनां तां निहत्य निशि सौप्तिके।\nकृतकृत्यः सुखी चैव भविष्यामि महामते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2069346, "chapter_id": 2451, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सौप्तिकपर्वणि तृतीयोऽध्यायः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]