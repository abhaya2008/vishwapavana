[{"id": 7002239000, "chapter_id": 22239, "verse_number": "२८४-१", "content_sanskrit": "धन्वन्तरिरुवाच ।\nआयुरारोग्यकर्तार ओंकारद्याश्च नाकदाः ।\nओंकारः परमो मन्त्रस्तं जप्त्वा चामरो भवेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002239001, "chapter_id": 22239, "verse_number": "२८४-२", "content_sanskrit": "गायत्री परमो मन्त्रस्तं जप्त्वा भुक्तिमुक्तिभाक् ।\nॐ नमो नारायणाय मन्त्रः सर्वार्थसाधकः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002239002, "chapter_id": 22239, "verse_number": "२८४-३", "content_sanskrit": "ॐ नमो भगवते वासुदेवाय सर्वदः ।\nॐ ह्रूं नमो विष्णवे मन्त्रोयञ्चौषधं परं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002239003, "chapter_id": 22239, "verse_number": "२८४-४", "content_sanskrit": "अनेन देवा ह्यसुराः सश्रियो निरुजोऽभवन् ।\nभूतानामुपकारश्च तथा धर्मो महौषधम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002239004, "chapter_id": 22239, "verse_number": "२८४-५", "content_sanskrit": "धर्म्मः सद्धर्म्मकृद्धर्मी एतैर्धर्म्मैश्च निर्म्मलः ।\nश्रीदः श्रीशः श्रीनिवासः श्रीधरः श्रीनिकेतनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002239005, "chapter_id": 22239, "verse_number": "२८४-६", "content_sanskrit": "श्रियः पतिः श्रीपरम् एतैः श्रियमवाप्नुयात् ।\nकामी कामप्रदः कामः कामपालस्तथा हरिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002239006, "chapter_id": 22239, "verse_number": "२८४-७", "content_sanskrit": "आनन्दो माधवश्चैव नाम कामाय वै हरेः ।\nरामः परशुरामश्च नृसिंहो विष्णुरेव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002239007, "chapter_id": 22239, "verse_number": "२८४-८", "content_sanskrit": "त्रिविक्रमश्च नामानि जप्तव्यानि जिगीषुभिः ।\nविद्यामभ्यस्यतां नित्यं जप्तव्यः पुरुषोत्तमः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002239008, "chapter_id": 22239, "verse_number": "२८४-९", "content_sanskrit": "दामोदरो बन्धहरः पुष्कराक्षोऽक्षिरोगनुत् ।\nहृषीकेशो भयहरो जपेदौषधकर्म्मणि ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002239009, "chapter_id": 22239, "verse_number": "२८४-१०", "content_sanskrit": "अच्युतञ्चामृतं मन्त्रं सङ्ग्रामे चापराजितः ।\nजलतारे नारसिंहं पूर्व्वादौ क्षेमकामवान् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002239010, "chapter_id": 22239, "verse_number": "२८४-११", "content_sanskrit": "चक्रिणङ्गदिनञ्चैव शार्ङ्गिणं खड्गिनं स्मरेत् ।\nनारायणं सर्वकाले नृसिंहोऽखिलभीतिनुत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002239011, "chapter_id": 22239, "verse_number": "२८४-१२", "content_sanskrit": "गरुडध्वजश्च विषहृत् वासुदेवं सदा जपेत् ।\nधान्यादिस्थापने स्वप्ने अनन्ताच्युतमीरयेत् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002239012, "chapter_id": 22239, "verse_number": "२८४-१३", "content_sanskrit": "नारायणञ्च दुःस्वप्ने दाहादौ जलशायिनं ।\nहयग्रीवञ्च विद्यार्थी जगत्सृतिं सुताप्तये ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002239013, "chapter_id": 22239, "verse_number": "२८४-१४", "content_sanskrit": "बलभद्रं शौर्यकार्य्ये एकं नामार्थसाधकम् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]