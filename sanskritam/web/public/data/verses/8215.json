[{"id": 900001124, "chapter_id": 8215, "verse_number": "4.1", "content_sanskrit": "अथ हैनं कौसल्यश्चाश्वलायनः पप्रच्छ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001125, "chapter_id": 8215, "verse_number": "4.2", "content_sanskrit": "तस्मै स होवाचातिप्रश्नान् पृच्छसि ब्रह्मिष्ठोऽसीति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001126, "chapter_id": 8215, "verse_number": "4.3", "content_sanskrit": "मनोकृतेनायात्यस्मिञ्छरीरे", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001127, "chapter_id": 8215, "verse_number": "4.4", "content_sanskrit": "पायूपस्थेऽपानं चक्षुः श्रोत्रे मुखनासिकाभ्यां प्राणः स्वयं प्रतिष्ठते", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001128, "chapter_id": 8215, "verse_number": "4.5", "content_sanskrit": "अत्रैतदेकशतं नाडीनाम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001129, "chapter_id": 8215, "verse_number": "4.6", "content_sanskrit": "आदित्यो ह वै बाह्यः प्राण..", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900001130, "chapter_id": 8215, "verse_number": "4.7", "content_sanskrit": "यच्चित्तस्तेनैष प्राणमायति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}]