[{"id": 5000540000, "chapter_id": 9540, "verse_number": "७-५-१", "content_sanskrit": "सुकेशं धार्मिकं दृष्ट्वा वरलब्धं च राक्षसम् ।\nग्रामणीर्नाम गन्धर्वो विश्वावसुसमप्रभः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000540001, "chapter_id": 9540, "verse_number": "७-५-२", "content_sanskrit": "तस्य देववती नाम द्वितीया श्रीरिवात्मजा ।\nत्रिषु लोकेषु विख्याता रूपयौवनशालिनी ।\nतां सुकेशाय धर्मेण ददौ रक्षःश्रियं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000540002, "chapter_id": 9540, "verse_number": "७-५-३", "content_sanskrit": "वरदानकृतैश्वर्यं सा तं प्राप्य पतिं प्रियम् ।\nआसीद्देववती तुष्टा धनं प्राप्येव निर्धनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000540003, "chapter_id": 9540, "verse_number": "७-५-४", "content_sanskrit": "स तया सह संयुक्तो रराज रजनीचरः ।\nअञ्जनादभिनिष्क्रान्तः करेण्वेव महागजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000540004, "chapter_id": 9540, "verse_number": "७-५-५", "content_sanskrit": "देववत्यां सुकेशस्तु जनयामास राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000540005, "chapter_id": 9540, "verse_number": "७-५-६", "content_sanskrit": "त्रीन् पुत्रान् जनयामास त्रेताग्निसमविग्रहान् ।\nमाल्यवन्तं सुमालिं च मालिं च बलिनां वरम् ।\nत्रींस्त्रिनेत्रसमान्पुत्रान्राक्षसान्राक्षसाधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000540006, "chapter_id": 9540, "verse_number": "७-५-७", "content_sanskrit": "त्रयो लोका इवाव्यग्राः स्थितास्त्रय इवाग्नयः ।\nत्रयो मन्त्रा इवात्युग्रास्त्रयो घोरा इवामयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000540007, "chapter_id": 9540, "verse_number": "७-५-८", "content_sanskrit": "त्रयः सुकेशस्य सुतास्त्रेताग्निसमतेजसः ।\nविवृद्धिमगमंस्तत्र व्याधयोपेक्षिता इव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000540008, "chapter_id": 9540, "verse_number": "७-५-९", "content_sanskrit": "वरप्राप्तिं पितुस्ते तु ज्ञात्वेश्वरतपोबलात् ।\nतपस्तप्तुं गता मेरुं भ्रातरः कृतनिश्चयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000540009, "chapter_id": 9540, "verse_number": "७-५-१०", "content_sanskrit": "प्रगृह्य नियमान्घोरान्राक्षसा नृपसत्तम ।\nविचेरुस्ते तपो घोरं सर्वभूतभयावहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000540010, "chapter_id": 9540, "verse_number": "७-५-११", "content_sanskrit": "सत्यार्जवशमोपेतैस्तपोभिरतिदुष्करैः ।\nसन्तापयन्तस्त्रील्लोँकान्सदेवासुरमानुषान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000540011, "chapter_id": 9540, "verse_number": "७-५-१२", "content_sanskrit": "ततो विभुश्चतुर्वक्त्रो विमानवरमास्थितः ।\nसुकेशपुत्रानामन्त्र्य वरदो ऽस्मीत्यभाषत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000540012, "chapter_id": 9540, "verse_number": "७-५-१३", "content_sanskrit": "ब्रह्माणं वरदं ज्ञात्वा सेन्द्रैर्देवगणैर्वृतम् ।\nऊचुः प्राञ्जलयः सर्वे वेपमाना इव द्रुमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000540013, "chapter_id": 9540, "verse_number": "७-५-१४", "content_sanskrit": "तपसाराधितो देव यदि नो दिशसे वरम् ।\nअजेयाः शत्रुहन्तारस्तथैव चिरजीविनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000540014, "chapter_id": 9540, "verse_number": "७-५-१५", "content_sanskrit": "प्रभविष्ण्वो भवामेति परस्परमनुव्रताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000540015, "chapter_id": 9540, "verse_number": "७-५-१६", "content_sanskrit": "एवं भविष्यतीत्युक्त्वा सुकेशतनयान्विभुः ।\nस ययौ ब्रह्मलोकाय ब्रह्मा ब्राह्मणवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000540016, "chapter_id": 9540, "verse_number": "७-५-१७", "content_sanskrit": "वरं लब्ध्वा तु ते सर्वे राम रात्रिञ्चरास्तदा ।\nसुरासुरान्प्रबाधन्ते वरदानसुनिर्भयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000540017, "chapter_id": 9540, "verse_number": "७-५-१८", "content_sanskrit": "तैर्वध्यमानास्त्रिदशाः सर्षिसङ्घाः सचारणाः ।\nत्रातारं नाधिगच्छन्ति निरयस्था यथा नराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000540018, "chapter_id": 9540, "verse_number": "७-५-१९", "content_sanskrit": "अथ ते विश्वकर्माणं शिल्पिनां वरमव्ययम् ।\nऊचुः समेत्य संहृष्टा राक्षसा रघुसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000540019, "chapter_id": 9540, "verse_number": "७-५-२०", "content_sanskrit": "ओजस्तेजोबलवतां महतामात्मतेजसा ।\nगृहकर्ता भवानेव देवानां हृदयेप्सितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000540020, "chapter_id": 9540, "verse_number": "७-५-२१", "content_sanskrit": "अस्माकमपि तावत्त्वं गृहं कुरु महामते ।\nहिमवन्तमपाश्रित्य मेरुमन्दरमेव वा ।\nमहेश्वरगृहप्रख्यं गृहं नः क्रियतां महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000540021, "chapter_id": 9540, "verse_number": "७-५-२२", "content_sanskrit": "विश्वकर्मा ततस्तेषां राक्षसानां महाभुजः ।\nनिवासं कथयामास शक्रस्येवामरावतीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000540022, "chapter_id": 9540, "verse_number": "७-५-२३", "content_sanskrit": "दक्षिणस्योदधेस्तीरे त्रिकूटो नाम पर्वतः ।\nसुवेल इति चाप्यन्यो द्वितीयस्तत्र सत्तमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000540023, "chapter_id": 9540, "verse_number": "७-५-२४", "content_sanskrit": "शिखरे तस्य शैलस्य मध्यमे ऽम्बुदसन्निभे ।\nशकुनैरपि दुष्प्रापे टङ्कच्छिन्नचतुर्दिशि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000540024, "chapter_id": 9540, "verse_number": "७-५-२५", "content_sanskrit": "त्रिंशद्योजनक्स्तीर्णा शतयोजनमायता ।\nस्वर्णप्राकारसंवीता हेमतोरणसंवृता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000540025, "chapter_id": 9540, "verse_number": "७-५-२६", "content_sanskrit": "मया लङ्केति नगरी शक्राज्ञप्तेन निर्मिता ।\nतस्यां वसत दुर्धर्षा यूयं राक्षसपुङ्गवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000540026, "chapter_id": 9540, "verse_number": "७-५-२७", "content_sanskrit": "अमरावतीं समासाद्य सेन्द्रा इव दिवौकसः ।\nलङ्कादुर्गं समासाद्य राक्षसैर्बहुभिर्वृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000540027, "chapter_id": 9540, "verse_number": "७-५-२८", "content_sanskrit": "भविष्यथ दुराधर्षाः शत्रूणां शत्रुसूदनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000540028, "chapter_id": 9540, "verse_number": "७-५-२९", "content_sanskrit": "विश्वकर्मवचः श्रुत्वा ततस्ते राक्षसोत्तमाः ।\nसहस्रानुचरा भूत्वा गत्वा तामवसन्पुरीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000540029, "chapter_id": 9540, "verse_number": "७-५-३०", "content_sanskrit": "दृढप्राकारपरिखां हैमैर्गृहशतैर्वृताम् ।\nलङ्कामवाप्य ते हृष्टा न्यवसन्रजनीचराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000540030, "chapter_id": 9540, "verse_number": "७-५-३१", "content_sanskrit": "एतस्मिन्नेव काले तु यथाकामं च राघव ।\nनर्मदा नाम गन्धर्वी बभूव रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000540031, "chapter_id": 9540, "verse_number": "७-५-३२", "content_sanskrit": "तस्याः कान्यात्रयं ह्यासीत् धीश्रीकिर्तिसमद्युति ।\nज्येष्ठक्रमेण सा तेषां राक्षसानामराक्षसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000540032, "chapter_id": 9540, "verse_number": "७-५-३३", "content_sanskrit": "कन्यास्ताः प्रददौ हृष्टा पूर्णचन्द्रनिभाननाः ।\nत्रयाणां राक्षसेन्द्राणां तिस्रो गन्धर्वकन्यकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000540033, "chapter_id": 9540, "verse_number": "७-५-३४", "content_sanskrit": "दत्ता मात्रा महाभागा नक्षत्रे भगदैवते ।\nकुतदारास्तु ते राम सुकेशतनयास्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000540034, "chapter_id": 9540, "verse_number": "७-५-३५", "content_sanskrit": "चिक्रीडुः सह भार्याभिरप्सरोभिरिवामराः ।\nततो माल्यवतो भार्या सुन्दरी नाम सुन्दरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000540035, "chapter_id": 9540, "verse_number": "७-५-३६", "content_sanskrit": "स तस्यां जनयामास यदपत्यं निबोध तत् ।\nवज्रमुष्टिर्विरूपाक्षोदुर्मुखश्चैव राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000540036, "chapter_id": 9540, "verse_number": "७-५-३७", "content_sanskrit": "सुप्तघ्नो यज्ञकोपश्च मत्तोन्मत्तौ तथैव च ।\nअनला चाभवत्कन्या सुन्दर्यां राम सुन्दरी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000540037, "chapter_id": 9540, "verse_number": "७-५-३८", "content_sanskrit": "सुमालिनो ऽपि भार्यासीत्पूर्णचद्रनिभानना ।\nनाम्ना केतुमती राम प्राणेभ्यो ऽपि गरीयसी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000540038, "chapter_id": 9540, "verse_number": "७-५-३९", "content_sanskrit": "सुमाली जनयामास यदपत्यं निशाचरः ।\nकेतुमत्यां महाराज तन्निबोधानुपूर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000540039, "chapter_id": 9540, "verse_number": "७-५-४०", "content_sanskrit": "प्रहस्तो ऽकम्पनश्चैव विकटः कालकार्मुखः ।\nधूम्राक्षश्चैव दण्डश्च सुपार्श्वश्च महाबलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000540040, "chapter_id": 9540, "verse_number": "७-५-४१", "content_sanskrit": "संह्रादिः प्रघसश्चैव भासकर्णश्च राक्षसः ।\nराका पुष्पोत्कटा चैव कैकसी च शुचिस्मिता ॥\nकुम्भीनसी च इत्येते सुमालेः प्रसवाः स्मृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000540041, "chapter_id": 9540, "verse_number": "७-५-४२", "content_sanskrit": "मालेस्तु वसुधा नाम गन्धर्वी रूपशालिनी ।\nभार्यासीत्पद्मपत्राक्षी स्वक्षी यक्षीवरोपमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000540042, "chapter_id": 9540, "verse_number": "७-५-४३", "content_sanskrit": "सुमालेरनुजस्तस्यां जनयामास यत् प्रभो ।\nअपत्यं कथ्यमानं तु मया त्वं शृणु राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000540043, "chapter_id": 9540, "verse_number": "७-५-४४", "content_sanskrit": "अनिलश्चानलश्चैव हरः सम्पातिरेव च ।\nएते विभीषणामात्या मालेयास्तु निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000540044, "chapter_id": 9540, "verse_number": "७-५-४५", "content_sanskrit": "ततस्तु ते राक्षसपुङ्गवास्त्रयो निशाचरैः पुत्रशतैश्च संवृताः ।\nसुरान्सहेन्द्रानृषिनागयक्षान्बबाधिरे तान्बहुवीर्यदर्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000540045, "chapter_id": 9540, "verse_number": "७-५-४६", "content_sanskrit": "जगद्भ्रमन्तो ऽनिलवद्दुरासदा रणेषु मृत्युप्रतिमानतेजसः ।\nवरप्रदानादतिगर्विता भृशं क्रतुक्रियाणां प्रशमङ्कराः सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000540046, "chapter_id": 9540, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे पञ्चमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}]