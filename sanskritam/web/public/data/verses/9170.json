[{"id": 5000170000, "chapter_id": 9170, "verse_number": "२-९३-१", "content_sanskrit": "तया महत्या यायिन्या ध्वजिन्या वनवासिन: ।\nअर्द्दिता यूथपा मत्ता: सयूथा: सम्प्रदुद्रुवु: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000170001, "chapter_id": 9170, "verse_number": "२-९३-२", "content_sanskrit": "ऋक्षा: पृषतसङ्घाश्च रुरवश्च समतन्त: ।\nदृश्यन्ते वनराजीषु गिरिष्वपि नदीषु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000170002, "chapter_id": 9170, "verse_number": "२-९३-३", "content_sanskrit": "स सम्प्रतस्थे धर्मात्मा प्रीतो दशरथात्मज: ।\nवृतो महत्या नादिन्या सेनया चतुरङ्गया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000170003, "chapter_id": 9170, "verse_number": "२-९३-४", "content_sanskrit": "सागरौघनिभा सेना भरतस्य महात्मन: ।\nमहीं सञ्छादयामास प्रावृषि द्यामिवाम्बुद: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000170004, "chapter_id": 9170, "verse_number": "२-९३-५", "content_sanskrit": "चिरकालमित्यनेन कदाचिल्लक्ष्यत इति गम्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000170005, "chapter_id": 9170, "verse_number": "२-९३-६", "content_sanskrit": "स यात्वा दूरमध्वानं सुपरिश्रान्तवाहन: ।\nउवाच भरत: श्रीमान् वसिष्ठं मन्त्रिणां वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000170006, "chapter_id": 9170, "verse_number": "२-९३-७", "content_sanskrit": "यादृशं लक्ष्यते रूपं यथा चैव श्रुतं मया ।\nव्यक्तं प्राप्ता: स्म तं देशं भरद्वाजो यमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000170007, "chapter_id": 9170, "verse_number": "२-९३-८", "content_sanskrit": "अयं गिरिश्चित्रकूट इयं मन्दाकिनी नदी ।\nएतत् प्रकाशते दूरान्नीलमेघनिभं वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000170008, "chapter_id": 9170, "verse_number": "२-९३-९", "content_sanskrit": "गिरे: सानूनि रम्याणि चित्रकूटस्य सम्प्रति ।\nवारणैरवमृद्यन्ते मामकै: पर्वतोपमै: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000170009, "chapter_id": 9170, "verse_number": "२-९३-१०", "content_sanskrit": "मुञ्चन्ति कुसुमान्येते नगा: पर्वतसानुषु ।\nनीला इवातपापाये तोयं तोयधरा घना: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000170010, "chapter_id": 9170, "verse_number": "२-९३-११", "content_sanskrit": "किन्नराचरितं देशं पश्य शत्रुघ्न पर्वतम् ।\nमृगै: समन्तादाकीर्णं मकरैरिव सागरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000170011, "chapter_id": 9170, "verse_number": "२-९३-१२", "content_sanskrit": "एते मृगगणा भान्ति शीघ्रवेगा: प्रचोदिता: ।\nवायुप्रविद्धा शरदि मेघराजिरिवाम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000170012, "chapter_id": 9170, "verse_number": "२-९३-१३", "content_sanskrit": "कुर्वन्ति कुसुमापीडान् शिरस्सु सुरभीनमी ।\nमेघप्रकाशै: फलकैर्दाक्षिणात्या यथा नरा: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000170013, "chapter_id": 9170, "verse_number": "२-९३-१४", "content_sanskrit": "निष्कूजमिव भूत्वेदं वनं घोरप्रदर्शनम् ।\nअयोध्येव जनाकीर्णा सम्प्रति प्रतिभाति मा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000170014, "chapter_id": 9170, "verse_number": "२-९३-१५", "content_sanskrit": "खुरैरुदीरितो रेणुर्दिवं प्रच्छाद्य तिष्ठति ।\nतं वहत्यनिल: शीघ्रं कुर्वन्निव मम प्रियम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000170015, "chapter_id": 9170, "verse_number": "२-९३-१६", "content_sanskrit": "स्यन्दनांस्तुरगोपेतान् सूतमुख्यैरधिष्ठितान् ।\nएतान् सम्पतत: शीघ्रं पश्य शत्रुघ्न कानने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000170016, "chapter_id": 9170, "verse_number": "२-९३-१७", "content_sanskrit": "एतान् वित्रासितान् पश्य बर्हिण: प्रियदर्शनान् ।\nएतमाविशत: शीघ्रमधिवासं पतत्ऺित्रण: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000170017, "chapter_id": 9170, "verse_number": "२-९३-१८", "content_sanskrit": "अतिमात्रमयं देशो मनोज्ञ: प्रतिभाति मा ।\nतापसानां निवासो ऽयं व्यक्तं स्वर्गपथो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000170018, "chapter_id": 9170, "verse_number": "२-९३-१९", "content_sanskrit": "मृगा मृगीभि: सहिता बहव: पृषता वने ।\nमनोज्ञरूपा लक्ष्यन्ते कुसुमैरिव चित्रिता: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000170019, "chapter_id": 9170, "verse_number": "२-९३-२०", "content_sanskrit": "साधुसैन्या: प्रतिष्ठन्तां विचिन्वन्तु च कानने ।\nयथा तौ पुरुषव्याघ्रौ दृश्येते रामलक्ष्मणौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000170020, "chapter_id": 9170, "verse_number": "२-९३-२१", "content_sanskrit": "भरतस्य वच: श्रुत्वा पुरुषा: शस्त्रपाणय: ।\nविविशुस्तद्वनं शूरा धूमं च ददृशुस्तत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000170021, "chapter_id": 9170, "verse_number": "२-९३-२२", "content_sanskrit": "ते समालोक्य धूमाग्रमूचुर्भरतमागता: ।\nनामनुष्ये भवत्याग्निर्व्यक्तमत्रैव राघवौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000170022, "chapter_id": 9170, "verse_number": "२-९३-२३", "content_sanskrit": "अथ नात्र नरव्याघ्रौ राजपुत्रौ परन्तपौ ।\nमन्ये रामोपमा: सन्ति व्यक्तमत्र तपस्विन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000170023, "chapter_id": 9170, "verse_number": "२-९३-२४", "content_sanskrit": "तच्छ्रुत्वा भरतस्तेषां वचनं साधुसम्मतम् ।\nसैन्यानुवाच सर्वांस्तानमित्रबलमर्दन: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000170024, "chapter_id": 9170, "verse_number": "२-९३-२५", "content_sanskrit": "यत्ता भवन्तस्तिष्ठन्तु नेतो गन्तव्यमग्रत: ।\nअहमेव गमिष्यामि सुमन्त्रो गुरुरेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000170025, "chapter_id": 9170, "verse_number": "२-९३-२६", "content_sanskrit": "एवमुक्तास्तत: सर्वे तत्र तस्थु: समन्तत: ।\nभरतो यत्र धूमाग्रं तत्र दृष्टिं समादधात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000170026, "chapter_id": 9170, "verse_number": "२-९३-२७", "content_sanskrit": "व्यवस्थिता या भरतेन सा चमूर्निरीक्षमाणापि च धूममग्रत: ।\nबभूव हृष्टा नचिरेण जानती प्रियस्य रामस्य समागमं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000170027, "chapter_id": 9170, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदयोध्याकाण्डे त्रिनवतितम: सर्ग: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]