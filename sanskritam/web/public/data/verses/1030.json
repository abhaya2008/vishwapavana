[{"id": 2001675, "chapter_id": 1030, "verse_number": "१-३१-०x", "content_sanskrit": "शौनक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2001676, "chapter_id": 1030, "verse_number": "१-३१-१", "content_sanskrit": "कोऽपराधो महेन्द्रस्य कः प्रमादश्च सूतज।\nतपसा वालखिल्यानां संभूतो गरुडः कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2001677, "chapter_id": 1030, "verse_number": "१-३१-२", "content_sanskrit": "कश्यपस्य द्विजातेश्च कथं वै पक्षिराट् सुतः।\nअधृष्टः सर्वभूतानामवध्यस्चाभवत्कथम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2001678, "chapter_id": 1030, "verse_number": "१-३१-३", "content_sanskrit": "कथं च कामचारी स कामवीर्यश्च खेचरः।\nएतदिच्छाम्यहं श्रोतुं पुराणे यदि पठ्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2001679, "chapter_id": 1030, "verse_number": "१-३१-४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2001680, "chapter_id": 1030, "verse_number": "१-३१-४", "content_sanskrit": "विषयोऽयं पुराणस्य यन्मां त्वं परिपृच्छसि।\nशृणु मे वदतः सर्वमेतत्संक्षेपतों द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2001681, "chapter_id": 1030, "verse_number": "१-३१-५", "content_sanskrit": "यजतः पुत्रकामस्य कश्यपस्य प्रजापतेः।\nसाहाय्यमृषयो देवा गन्धर्वाश्च ददुः किल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2001682, "chapter_id": 1030, "verse_number": "१-३१-६", "content_sanskrit": "तत्रेध्मानयने शक्रो नियुक्तः कश्यपेन ह।\nमुनयो वालखिल्याश्च ये चान्ये देवतागणाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2001683, "chapter_id": 1030, "verse_number": "१-३१-७", "content_sanskrit": "शक्रस्तु वीर्यसदृशमिध्यभारं गिरिप्रभम्।\nसमुद्यम्यानयामास नातिकृच्छ्रादिव प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2001684, "chapter_id": 1030, "verse_number": "१-३१-८", "content_sanskrit": "अथापश्यदृषीन्ह्रस्वानङ्गुष्ठोदरवर्ष्मणः।\nपलाशवर्तिकामेकां वहतः संहतान्पथि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2001685, "chapter_id": 1030, "verse_number": "१-३१-९", "content_sanskrit": "प्रलीनान्स्वेष्विवाङ्गेषु निराहारांस्तपोधनान्।\nक्लिश्यमानान्मन्दबलान्गोष्पदे संप्लुतोदके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2001686, "chapter_id": 1030, "verse_number": "१-३१-१०", "content_sanskrit": "तान्सर्वान्विस्मयाविष्टो वीर्योन्मत्तः पुरन्दरः।\nअपहास्याभ्यगाच्छीघ्रं लम्बयित्वाऽवमन्य च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2001687, "chapter_id": 1030, "verse_number": "१-३१-११", "content_sanskrit": "तेऽथ रोषसमाविष्टाः सुभृशं जातमन्यवः।\nआरेभिरे महत्कर्म तदा शक्रभयंकरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2001688, "chapter_id": 1030, "verse_number": "१-३१-१२", "content_sanskrit": "जुहुवुस्ते सुतपसो विधिवज्जातवेदसम्।\nमन्त्रैरुच्चावचैर्विप्रा येन कामेन तच्छृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2001689, "chapter_id": 1030, "verse_number": "१-३१-१३", "content_sanskrit": "कामवीर्यः कामगमो देवराजभयप्रदः।\nइन्द्रोऽन्यः सर्वदेवानां भवेदिति यतव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2001690, "chapter_id": 1030, "verse_number": "१-३१-१४", "content_sanskrit": "इन्द्राच्छतगुणः शौर्ये वीर्ये चैव मनोजवः।\nतपसो नः फलेनाद्य दारुणः संभवित्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2001691, "chapter_id": 1030, "verse_number": "१-३१-१५", "content_sanskrit": "तद्बुद्ध्वा भृशसंतप्तो देवराजः शतक्रतुः।\nजगाम शरणं तत्र कश्यपं संशितव्रतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2001692, "chapter_id": 1030, "verse_number": "१-३१-१६", "content_sanskrit": "तच्छ्रुत्वा देवराजस्य कश्यपोऽथ प्रजापतिः।\nवालखिल्यानुपागम्य कर्मसिद्धिमपृच्छत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2001693, "chapter_id": 1030, "verse_number": "१-३१-१७x", "content_sanskrit": "कश्यप उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2001694, "chapter_id": 1030, "verse_number": "१-३१-१७", "content_sanskrit": "केन कामेन चारब्धं भवद्भिर्होमकर्म च।\nयाथातथ्येन मे ब्रूत श्रोतुं कौतूहलं हि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2001695, "chapter_id": 1030, "verse_number": "१-३१-१८x", "content_sanskrit": "वालखिल्या ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2001696, "chapter_id": 1030, "verse_number": "१-३१-१८", "content_sanskrit": "अवज्ञाताः सुरेन्द्रेण मूढेनाकृतबुद्धिना।\nऐश्वर्यमदमत्तेन सदाचारान्निरस्यता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2001697, "chapter_id": 1030, "verse_number": "१-३१-१९", "content_sanskrit": "तद्विघातार्थमारम्भो विधिवत्तस्य कश्यप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2001698, "chapter_id": 1030, "verse_number": "१-३१-२०x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2001699, "chapter_id": 1030, "verse_number": "१-३१-२०", "content_sanskrit": "एवमस्त्विति तं चापि प्रत्यूचुः सत्यवादिनः।\nतान्कश्यप उवाचेदं सान्त्वपूर्वं प्रजापतिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2001700, "chapter_id": 1030, "verse_number": "१-३१-२१", "content_sanskrit": "अयमिन्द्रस्त्रिभुवने नियोगाद्ब्रह्मणः कृतः।\nइन्द्रार्थे च भवन्तोऽपि यत्नवन्तस्तपोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2001701, "chapter_id": 1030, "verse_number": "१-३१-२२", "content_sanskrit": "न मिथ्या ब्रह्मणो वाक्यं कर्तुमर्हथ सत्तमाः।\nभवतां हि न मिथ्याऽयं संकल्पो वै चिकीर्षितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2001702, "chapter_id": 1030, "verse_number": "१-३१-२३", "content_sanskrit": "भवत्वेष पतत्रीणामिन्द्रोऽतिबलसत्त्ववान्।\nप्रसादः क्रियतामस्य देवराजस्य याचतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2001703, "chapter_id": 1030, "verse_number": "१-३१-२४x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2001704, "chapter_id": 1030, "verse_number": "१-३१-२४", "content_sanskrit": "एवमुक्ताः कश्यपेन वालखिल्यास्तपोधनाः।\nप्रत्यूचुरभिसंपूज्य मुनिश्रेष्ठं प्रजापतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2001705, "chapter_id": 1030, "verse_number": "१-३१-२५x", "content_sanskrit": "वालखिल्या ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2001706, "chapter_id": 1030, "verse_number": "१-३१-२५", "content_sanskrit": "इन्द्रार्थोऽयं समारम्भः सर्वेषां नः प्रजापते।\nअपत्यार्थं समारम्भो भवतश्चायमीप्सितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2001707, "chapter_id": 1030, "verse_number": "१-३१-२६", "content_sanskrit": "तदिदं सफलं कर्म त्वयैव प्रतिगृह्यताम्।\nतथा चैवं विधत्स्वात्र यथा श्रेयोऽनुपश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2001708, "chapter_id": 1030, "verse_number": "१-३१-२७x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2001709, "chapter_id": 1030, "verse_number": "१-३१-२७", "content_sanskrit": "एतस्मिन्नेव काले तु देवी दाक्षायणी शुभा।\nविनता नाम कल्याणी पुत्रकामा यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2001710, "chapter_id": 1030, "verse_number": "१-३१-२८", "content_sanskrit": "तपस्तप्त्वा व्रतपरा स्नाता पुंसवने शुचिः।\nउपचक्राम भर्तारं तामुवाचाथ कश्यपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2001711, "chapter_id": 1030, "verse_number": "१-३१-२९", "content_sanskrit": "आरम्भः सफलो देवि भविता यस्त्वयेप्सितः।\nजनयिष्यसि पुत्रौ द्वौ वीरौ त्रिभुवनेश्वरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2001712, "chapter_id": 1030, "verse_number": "१-३१-३०", "content_sanskrit": "तपसा वालखिल्यानां मम संकल्पतस्तथा।\nभविष्यतो महाभागौ पुत्रौ त्रैलोक्यपूजितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2001713, "chapter_id": 1030, "verse_number": "१-३१-३१", "content_sanskrit": "उवाच चैनां भगवान्कश्यपः पुनरेव ह।\nधार्यतामप्रमादेन गर्भोऽयं सुमहोदयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2001714, "chapter_id": 1030, "verse_number": "१-३१-३२", "content_sanskrit": "एकः सर्वपतत्रीणामिन्द्रत्वं कारयिष्यति।\nलोकसंभावितो वीरः कामरूपो विहङ्गमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2001715, "chapter_id": 1030, "verse_number": "१-३१-३३x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2001716, "chapter_id": 1030, "verse_number": "१-३१-३३", "content_sanskrit": "शतक्रतुमथोवाच प्रीयमाणः प्रजापतिः।\nत्वत्सहायौ महावीर्यौ भ्रातरौ ते भविष्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2001717, "chapter_id": 1030, "verse_number": "१-३१-३४", "content_sanskrit": "नैताभ्यां भविता दोषः सकाशात्ते पुरंदर।\nव्येतु ते शक्र संतापस्त्वमेवेन्द्रो भविष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2001718, "chapter_id": 1030, "verse_number": "१-३१-३५", "content_sanskrit": "न चाप्येवं त्वया भूयः क्षेप्तव्या ब्रह्मवादिनः।\nन चावमान्या दर्पात्ते वाग्वज्रा भृशकोपनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2001719, "chapter_id": 1030, "verse_number": "१-३१-३६x", "content_sanskrit": "सौतिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2001720, "chapter_id": 1030, "verse_number": "१-३१-३६", "content_sanskrit": "एवमुक्तो जगामेन्द्रो निर्विशङ्कस्त्रिविष्टपम्।\nविनता चापि सिद्धार्था बभूव मुदिता तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2001721, "chapter_id": 1030, "verse_number": "१-३१-३७", "content_sanskrit": "जनयामास पुत्रौ द्वावरुणं गरुडं तथा।\nविकलाङ्गोऽरुणस्तत्र भास्करस्य पुरःसरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2001722, "chapter_id": 1030, "verse_number": "१-३१-३८", "content_sanskrit": "पतत्त्रीणां च गरुडमिन्द्रत्वेनाभ्यषिञ्चत।\nतस्यैतत्कर्म सुमहच्छ्रूयतां भृगुनन्दन॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2001723, "chapter_id": 1030, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि आस्तीकपर्वणि एकत्रिंशोऽध्यायः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}]