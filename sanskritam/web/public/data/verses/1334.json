[{"id": 2015857, "chapter_id": 1334, "verse_number": "२-७५-१", "content_sanskrit": "शकुनिरुवाच॥\nदुर्योधन न तेऽमर्षः कार्यः प्रति युधिष्ठिरम्।\nभागधेयानि हि स्वानि पाण्डवा भुञ्जते सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015858, "chapter_id": 1334, "verse_number": "२-७५-२", "content_sanskrit": "विधानं विविधाकारं परं तेषां विधानतः।\nअनेकैरभ्युपायैश्च त्वया न शकिताः पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015859, "chapter_id": 1334, "verse_number": "२-७५-३", "content_sanskrit": "आरब्धा हि महाराज पुनः पुनररिन्दम।\nविमुक्ताश्च नरव्याघ्रा भगधेयपुरस्कृताः।\nउत्साहवन्तः पुरुषा नावसीदन्ति कर्मसु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015860, "chapter_id": 1334, "verse_number": "२-७५-४", "content_sanskrit": "तैर्लब्धा द्रौपदी भार्या द्रुपदश्च सुतैः सह।\nसहायाः पृथिवीपाला वासुदेवश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015861, "chapter_id": 1334, "verse_number": "२-७५-५", "content_sanskrit": "लब्धश्चानभिभूतार्थैः पित्र्योंशः पृथिवीपते।\nविवृद्धस्तेजसा तेषां तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015862, "chapter_id": 1334, "verse_number": "२-७५-६", "content_sanskrit": "धनञ्जयेन गाण्डीवमक्षय्यौ च महेषुधी।\nलब्धान्यस्त्राणि दिव्यानि तोषयित्वा हुताशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015863, "chapter_id": 1334, "verse_number": "२-७५-७", "content_sanskrit": "तेन कार्मुकमुख्येन बाहुवीर्येण चात्मनः।\nकृता वशे महीपालास्तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015864, "chapter_id": 1334, "verse_number": "२-७५-८", "content_sanskrit": "अग्निदाहान्मयं चापि मोक्षयित्वा स दानवम्।\nसभां तां कारयामास सव्यसाची परन्तपः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015865, "chapter_id": 1334, "verse_number": "२-७५-९", "content_sanskrit": "तेन चैव मयेनोक्ताः किङ्करा नाम राक्षसाः।\nवहन्ति तां सभां भीमास्तत्र का परिदेवना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015866, "chapter_id": 1334, "verse_number": "२-७५-१०", "content_sanskrit": "यच्चासहायतां राजन्नुक्तवानसि भारत।\nतन्मिथ्या भ्रातरो हीमे तव सर्वे वशानुगाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015867, "chapter_id": 1334, "verse_number": "२-७५-११", "content_sanskrit": "द्रोणस्तव महेष्वासः सह पुत्रेण वीर्यवान्।\nमूतपुत्रश्च राधेयो दृढधन्वा महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015868, "chapter_id": 1334, "verse_number": "२-७५-१२", "content_sanskrit": "स एकः समरे सर्वान्पाण्डवान्सहसोमकान्।\nविजेष्यति महाबाहो किं सहायैः करिष्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015869, "chapter_id": 1334, "verse_number": "२-७५-१३", "content_sanskrit": "भीष्मश्च पुरुषव्याघ्रो गौतमश्च महारथः।\nजयद्रथश्च बलावान्सोमदत्तस्तथैव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015870, "chapter_id": 1334, "verse_number": "२-७५-१४", "content_sanskrit": "अहं च सह सोदर्यैः सौमदत्तिश्च पार्थिवः।\nएतैस्त्वं सहितः सर्वैर्जय कृत्स्नं वसुन्दराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015871, "chapter_id": 1334, "verse_number": "२-७५-१५x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015872, "chapter_id": 1334, "verse_number": "२-७५-१५", "content_sanskrit": "त्वया च सहितो राजन्नेतैश्चान्यैर्महारथैः।\nएतानहं विजेष्यामि यदि त्वमनुमन्यसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015873, "chapter_id": 1334, "verse_number": "२-७५-१६", "content_sanskrit": "एतेषु विजितेष्वद्य भविष्यति मही मम।\nसर्वे च पृथिवीपालाः सभा सा च महाधना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015874, "chapter_id": 1334, "verse_number": "२-७५-१७x", "content_sanskrit": "शकुनिरुवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015875, "chapter_id": 1334, "verse_number": "२-७५-१७", "content_sanskrit": "धनञ्जयो वासुदेवो भीमसेनो युधिष्ठिरः।\nनकुलः सहदेवश्च द्रुपदश्च सहात्मजैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015876, "chapter_id": 1334, "verse_number": "२-७५-१८", "content_sanskrit": "नैते युधि पराजेतुं शक्या देवगणैरपि।\nमहारथा महेष्वासाः कृतास्त्रा युद्धदुर्मदाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015877, "chapter_id": 1334, "verse_number": "२-७५-१९", "content_sanskrit": "अहं तु तद्विजानामि विजेतुं येन शक्यते।\nयुधिष्ठिरं स्वयं राजंस्तन्निबोध जुषस्व च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015878, "chapter_id": 1334, "verse_number": "२-७५-२०x", "content_sanskrit": "दुर्योधन उवाच॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015879, "chapter_id": 1334, "verse_number": "२-७५-२०", "content_sanskrit": "अप्रमादेन सुहृदामन्येषां च महात्मनाम्।\nयदि शक्या विजेतुं ते तन्ममाचक्ष्व मातुल॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015880, "chapter_id": 1334, "verse_number": "२-७५-२१x", "content_sanskrit": "शकुनिरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015881, "chapter_id": 1334, "verse_number": "२-७५-२१", "content_sanskrit": "द्यूतप्रियश्च कौन्तेयो न स जानाति देवितुम्।\nसमाहूतश्च राजेन्द्रो न शक्ष्यति तिवर्तितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015882, "chapter_id": 1334, "verse_number": "२-७५-२२", "content_sanskrit": "देवने कुशलश्चाहं न मेऽस्ति सदृशो भुवि।\nत्रिषु लोकेषु कौरव्य तं त्वं द्यूते समाह्वय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015883, "chapter_id": 1334, "verse_number": "२-७५-२३", "content_sanskrit": "तस्याक्षकुशलो राजन्नादास्येऽहमसंशयम्।\nराज्यं श्रियं च तां दीप्तां त्वदर्थं पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015884, "chapter_id": 1334, "verse_number": "२-७५-२४", "content_sanskrit": "इदं तु सर्वं त्वं राज्ञे दुर्योधन निवेदय।\nअनुज्ञातस्तु ते पित्रा विजेष्ये तान्न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015885, "chapter_id": 1334, "verse_number": "२-७५-२५x", "content_sanskrit": "दुर्योधन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015886, "chapter_id": 1334, "verse_number": "२-७५-२५", "content_sanskrit": "त्वमेव करुमुख्याय धृतराष्ट्राय सौबल।\nनिवेदय यथान्यायं नाहं शक्ष्ये निवेदितुम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015887, "chapter_id": 1334, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि द्यूतपर्वणि पञ्चसप्ततितमोऽध्यायः॥७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]