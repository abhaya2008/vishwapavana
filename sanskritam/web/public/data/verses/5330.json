[{"id": 2203240, "chapter_id": 5330, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2203241, "chapter_id": 5330, "verse_number": "१", "content_sanskrit": "ततस्त्वृषिगणाः सर्वे पितरश्च सदेवताः ।\nअरुन्धतीं तपोवृद्धामपृच्छन्त समाहिताः ।\nसमानशीलां वीर्येण वसिष्ठस्य महात्मनः \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2203242, "chapter_id": 5330, "verse_number": "२", "content_sanskrit": "त्वत्तो धर्मरहस्यानि श्रोतुमिच्छामहे वयम् ।\nयत्ते गुह्यतमं भद्रे तत् प्रभाषितुमर्हसि\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2203243, "chapter_id": 5330, "verse_number": "", "content_sanskrit": "अरुन्धती", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2203244, "chapter_id": 5330, "verse_number": "३", "content_sanskrit": "तपोवृद्धिर्मया प्राप्ता भवतां स्मरणेन वै ।\nभवतां च प्रसादेन धर्मान् वक्ष्यामि शाश्वतान्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2203245, "chapter_id": 5330, "verse_number": "४", "content_sanskrit": "सगुह्यान् सरहस्यांश्च तान् शृणुध्वमशेषतः ।\nश्रद्दधाने प्रयोक्तव्या यस्य शुद्धं तथा मनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2203246, "chapter_id": 5330, "verse_number": "५", "content_sanskrit": "अश्रद्दधानो मानी च ब्रह्महा गुरुतल्पगः ।\nअसम्भाष्या हि चत्वारो नैषां धर्मं प्रकाशयेत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2203247, "chapter_id": 5330, "verse_number": "६", "content_sanskrit": "अहन्यहनि यो दद्यात् कपिलां द्वादशीः समाः ।\nमासिमासि च सत्रेण यो यजेत सदा नरः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2203248, "chapter_id": 5330, "verse_number": "७", "content_sanskrit": "गवां शतसहस्रं च यो दद्याज्ज्येष्ठपुष्करे ।\nन तद्धर्मफलं तुल्यमतिथिर्यस्य तुष्यति\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2203249, "chapter_id": 5330, "verse_number": "८", "content_sanskrit": "श्रूयतां चापरो धर्मो मनुष्याणां सुखावहः ।\nश्रद्दधानेन कर्तव्यः सरहस्यो महाफलः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2203250, "chapter_id": 5330, "verse_number": "९", "content_sanskrit": "कल्यमुत्थाय गोमध्ये गृह्य दर्भान् सहोदकान् ।\nनिषिञ्चेत गवां शृङ्गे मस्तकेन च तज्जलम् ।\nप्रतीच्छेत निराहारस्तस्य धर्मफलं शृणु\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2203251, "chapter_id": 5330, "verse_number": "१०", "content_sanskrit": "श्रूयन्ते यानि तीर्थानि त्रिषु लोकेषु कानिचित् ।\nसिद्धचारणजुष्टानि सेवितानि महर्षिभिः ।\nअभिषेकः समस्तेषां गवां शृङ्गोदकस्य च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2203252, "chapter_id": 5330, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2203253, "chapter_id": 5330, "verse_number": "११", "content_sanskrit": "साधुसाध्विति चोद्दिष्टं दैवतैः पितृभिस्तथा ।\nभूतैश्चैव सुसंहृष्टैः पूजिता साऽप्यरुन्धती\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2203254, "chapter_id": 5330, "verse_number": "", "content_sanskrit": "पितामहः(ब्रह्मा)", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2203255, "chapter_id": 5330, "verse_number": "१२", "content_sanskrit": "अहो धर्मो महाभागे सरहस्य उदाहृतः ।\nवरं ददामि ते धन्ये तपस्ते वर्धतां सदा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2203256, "chapter_id": 5330, "verse_number": "", "content_sanskrit": "यमः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2203257, "chapter_id": 5330, "verse_number": "१३", "content_sanskrit": "रमणीया कथा दिव्या युष्मत्तो या मया श्रुता ।\nश्रूयतां चित्रगुप्तस्य भाषितं मम च प्रियम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2203258, "chapter_id": 5330, "verse_number": "१४", "content_sanskrit": "रहस्यं धर्मसंयुक्तं शक्यं श्रोतुं महर्षिभिः ।\nश्रद्दधानेन मर्त्येन आत्मनो हितमिच्छता\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2203259, "chapter_id": 5330, "verse_number": "१५", "content_sanskrit": "न हि पुण्यं तथा पापं कृतं किञ्चिद् विनश्यति ।\nपर्वकाले च यत् किञ्चिदादित्यं चाधितिष्ठति\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2203260, "chapter_id": 5330, "verse_number": "१६", "content_sanskrit": "प्रेतलोकं गते मर्त्ये तत्तत् सर्वं विभावसुः ।\nप्रतिजानाति पुण्यात्मा तच्च तत्रोपयुज्यते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2203261, "chapter_id": 5330, "verse_number": "१७", "content_sanskrit": "किञ्चिद्धर्मं प्रवक्ष्यामि चित्रगुप्तमतं शुभम् ।\nपानीयं चैव दीपं च दातव्यं सततं तथा\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2203262, "chapter_id": 5330, "verse_number": "१८", "content_sanskrit": "उपानहौ च च्छत्रं च कपिला च यथातथम् ।\nपुष्करे कपिला देया ब्राह्मणे वेदपारगे\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2203263, "chapter_id": 5330, "verse_number": "१९", "content_sanskrit": "अग्निहोत्रं च यत्नेन सर्वशः प्रतिपालयेत् ।\nअयं चैवापरो धर्मश्चित्रगुप्तेन भाषितः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2203264, "chapter_id": 5330, "verse_number": "२०", "content_sanskrit": "फलमस्य पृथक्त्वेन श्रोतुमर्हन्ति सत्तमाः ।\nप्रलयं सर्वभूतैश्च गन्तव्यं कालपर्ययात्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2203265, "chapter_id": 5330, "verse_number": "२१", "content_sanskrit": "तत्र दुर्गमनुप्राप्ताः क्षुत्तृष्णापरिपीडिताः ।\nदह्यमाना विपच्यन्ते न तत्रास्ति पलायनम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2203266, "chapter_id": 5330, "verse_number": "२२", "content_sanskrit": "अन्धकारं तमो घोरं प्रविशन्त्यल्पबुद्धयः ।\nतत्र धर्मं प्रवक्ष्यामि येन दुर्गाणि सन्तरेत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2203267, "chapter_id": 5330, "verse_number": "२३", "content_sanskrit": "अल्पव्ययं महार्थं च प्रेत्य चैव सुखोदयम् ।\nपानीयस्य गुणा दिव्याः प्रेतलोके विशेषतः\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2203268, "chapter_id": 5330, "verse_number": "२४", "content_sanskrit": "तत्र पुण्योदका नाम नदी तेषां विधीयते ।\nअक्षयं सलिलं तत्र शीतलं ह्यमृतोपमम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2203269, "chapter_id": 5330, "verse_number": "२५", "content_sanskrit": "स तत्र तोयं पिबति पानीयं यः प्रयच्छति ।\nप्रदीपस्य प्रदानेन श्रूयतां गुणविस्तरः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2203270, "chapter_id": 5330, "verse_number": "२६", "content_sanskrit": "तमोन्धकारं नियतं दीपदो न प्रपश्यति ।\nप्रभां चास्य प्रयच्छन्ति सोमभास्करपावकाः ।\nदेवताश्चास्य मन्यन्ते विमलाः सर्वतो दिशः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2203271, "chapter_id": 5330, "verse_number": "२७", "content_sanskrit": "द्योतते च यथाऽऽदित्यः प्रेतलोकगतो नरः ।\nतस्माद् दीपः प्रदातव्यः पानीयं च विशेषतः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2203272, "chapter_id": 5330, "verse_number": "२८", "content_sanskrit": "कपिलां ये प्रयच्छन्ति ब्राह्मणे वेदपारगे ।\nपुष्करे च विशेषेण श्रूयतां तस्य यत्फलम् ।\nगोशतं सवृषं तेन दत्तं भवति शाश्वतम् \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2203273, "chapter_id": 5330, "verse_number": "२९", "content_sanskrit": "पापं कर्म च यत्किञ्चिद् ब्रह्महत्यासमं भवेत् ।\nशोधयेत् कपिला ह्येका प्रदत्तं गोशतं यथा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2203274, "chapter_id": 5330, "verse_number": "३०", "content_sanskrit": "तस्मात्तु कपिला देया कौमुद्यां ज्येष्ठपुष्करे ।\nन तेषां विषमं किञ्चिन्न दुःखं न च कण्टकाः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2203275, "chapter_id": 5330, "verse_number": "३१", "content_sanskrit": "उपानहौ च यो दद्यात् पात्रभूते द्विजोत्तमे ।\nछत्रदाने सुखां छायां लभते परलोकगः\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2203276, "chapter_id": 5330, "verse_number": "३२", "content_sanskrit": "न हि दत्तस्य दानस्य नाशोऽस्तीह कदाचन ।\nचित्रगुप्तमतं श्रुत्वा हृष्टरोमा विभावसुः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2203277, "chapter_id": 5330, "verse_number": "३३", "content_sanskrit": "उवाच देवताः सर्वाः पितॄंश्चैव महाद्युतिः ।\nश्रुतं हि चित्रगुप्तस्य धर्मगुह्यं महात्मनः\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2203278, "chapter_id": 5330, "verse_number": "३४", "content_sanskrit": "श्रद्दधानाश्च ये मर्त्या ब्राह्मणेषु महात्मसु ।\nदानमेतत् प्रयच्छन्ति न तेषां विद्यते भयम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2203279, "chapter_id": 5330, "verse_number": "३५", "content_sanskrit": "धर्मदोषास्त्विमे पञ्च येषां नास्तीह निष्कृतिः ।\nअसम्भाष्या अनाचारा वर्जनीया नराधमाः \t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2203280, "chapter_id": 5330, "verse_number": "३६", "content_sanskrit": "ब्रह्महा चैव गोघ्नश्च परदाररतश्च यः ।\nअश्रद्दधानश्च नरः स्त्रियं यश्चोपजीवति\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2203281, "chapter_id": 5330, "verse_number": "३७", "content_sanskrit": "प्रेतलोकगता ह्येते नरके पापकर्मिणः ।\nपच्यन्ते वै यथा मीनाः पूयशोणितभोजनाः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2203282, "chapter_id": 5330, "verse_number": "३८", "content_sanskrit": "असम्भाष्याः पितॄणां च देवानां चैव पञ्च ते ।\nस्नातकानां च विप्राणां ये चान्ये च तपोधनाः \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2203283, "chapter_id": 5330, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् अनुशासनपर्वणि दानधर्मे अरुन्धत्याद्युपदेशो नाम एकाशीत्युत्तरशततमोऽध्यायः ॥१८१॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}]