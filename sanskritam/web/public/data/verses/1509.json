[{"id": 2023740, "chapter_id": 1509, "verse_number": "३-१४७-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023741, "chapter_id": 1509, "verse_number": "३-१४७-१", "content_sanskrit": "धर्मज्ञो बलवाञ्शूरः सद्यो राक्षसपुङ्गवः।\nभक्तोऽस्मानौरसः पुत्रो नेतुमर्हति मातरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023742, "chapter_id": 1509, "verse_number": "३-१४७-२", "content_sanskrit": "तव भीम सुतेनाहं नीतो भीमपराक्रम।\nअक्षतः सह पाञ्चाल्या गच्छेयं गन्धमादनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023743, "chapter_id": 1509, "verse_number": "३-१४७-३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023744, "chapter_id": 1509, "verse_number": "३-१४७-३", "content_sanskrit": "भ्रातुर्वचनमाज्ञाय भीमसेनो घटोत्कचम्।\n`चिन्तयामास बलवान्महाबलपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023745, "chapter_id": 1509, "verse_number": "३-१४७-४", "content_sanskrit": "घटोत्कचश्च धर्मात्मा स्मृतमात्रः पितुस्तदा।\nकृताञ्जलिरुषातिष्ठदभिवाद्याथ पाण्डवान्।\nब्राह्मणांश्च महाबाहुः स च तैरमिनन्दितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023746, "chapter_id": 1509, "verse_number": "३-१४७-५", "content_sanskrit": "उवाच भीमसेनं स पितरं सत्यविक्रमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023747, "chapter_id": 1509, "verse_number": "३-१४७-६", "content_sanskrit": "स्मृतोऽस्मि भवता शीघ्रं शुश्रूषुरहमागतः।\nआज्ञापय महाबाहो सर्वं कर्ताऽस्म्यसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023748, "chapter_id": 1509, "verse_number": "३-१४७-७", "content_sanskrit": "तच्छ्रुत्वा भीमसेनस्तु राक्षसं परिषस्वजे।\nचिन्ताया समनप्राप्तमित्युवाच वृकोदरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023749, "chapter_id": 1509, "verse_number": "३-१४७-८", "content_sanskrit": "हैडिम्बेय परिश्रान्ता तव माताऽपराजिता।\nत्वं कच कामगमस्तात बलवान्वह तां खग ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023750, "chapter_id": 1509, "verse_number": "३-१४७-९", "content_sanskrit": "स्कन्धमारोप्य भद्रं ते मध्येऽस्माकं विहायसा।\nगच्छ नीचिकया गत्या यथा चैनां न पीडयेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023751, "chapter_id": 1509, "verse_number": "३-१४७-१०x", "content_sanskrit": "घटोत्कच उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023752, "chapter_id": 1509, "verse_number": "३-१४७-१०", "content_sanskrit": "धर्मराजं च धौम्यं च कृष्णां च यमजौ तथा।\nएकोप्यहमलं वोढुं किमुताद्य सहायवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023753, "chapter_id": 1509, "verse_number": "३-१४७-११", "content_sanskrit": "[अन्ये च शतशः शूरा विहङ्गाः कामरूपिणः।\nसर्वान्वो ब्राह्मणैः सार्धं वक्ष्यन्ति सहिताऽनघ।\n`मन्दंमन्दं गमिष्यामि वहन्द्रुपदनन्दिनीम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023754, "chapter_id": 1509, "verse_number": "३-१४७-१२x", "content_sanskrit": "वैश्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023755, "chapter_id": 1509, "verse_number": "३-१४७-१२", "content_sanskrit": "एवमुक्त्वा ततः कृष्णामुवाह स घटोत्कचः।\nपाण्डूनां मध्यगो वीरः पाण्डवानपि चापरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023756, "chapter_id": 1509, "verse_number": "३-१४७-१३", "content_sanskrit": "लोमशः सिद्धमार्गेण जगामानुपमद्युतिः।\nस्वेनैव स प्रभावेण द्वीतीय इव भास्करः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023757, "chapter_id": 1509, "verse_number": "३-१४७-१४", "content_sanskrit": "ब्राह्मणांश्चापि तान्सर्वान्समुपादाय राक्षसाः।\nनियोगाद्राक्षसेनद्रस्य जग्मुर्भीमपराक्रमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023758, "chapter_id": 1509, "verse_number": "३-१४७-१५", "content_sanskrit": "एवं सुरमणीयानि वनान्युपवनानि च।\nआलोकयन्तस्ते जग्मुर्विशालां बदरीमनु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023759, "chapter_id": 1509, "verse_number": "३-१४७-१६", "content_sanskrit": "ते त्वाशुगतिभिर्वीरा राक्षसैस्तैर्महाजवैः।\nउह्यमाना ययुः शीघ्रं महदध्वानमल्पवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023760, "chapter_id": 1509, "verse_number": "३-१४७-१७", "content_sanskrit": "देशान्म्लेच्छजनाकीर्णान्नानारत्नाकरायुतान्।\nददृशुर्गिरिपादांश्च नानाधातुसमाचितान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023761, "chapter_id": 1509, "verse_number": "३-१४७-१८", "content_sanskrit": "विद्याघरमाकीर्णआन्युतान्वानरकिन्नरैः।\nतथा किंपुरुषैश्चैव गन्धर्वैश्चसमन्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023762, "chapter_id": 1509, "verse_number": "३-१४७-१९", "content_sanskrit": "मयूरैश्चभरैश्चैव हरिणै रुरुभिस्तथा।\nवराहैर्गवयैश्चैव महिषैश्च समावृतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023763, "chapter_id": 1509, "verse_number": "३-१४७-२०", "content_sanskrit": "नदीजालसमाकीर्णान्नानापक्षियुतान्बहून्।\nनानाविधमृगैर्जुष्टांश्चारणैश्चोपशोभितान्।\nसमदैश्च्यशि विहगैः उपैरन्वितांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023764, "chapter_id": 1509, "verse_number": "३-१४७-२१", "content_sanskrit": "तेऽवतीर्य बहून्देशानुत्तरांश्च कुरूनपि।\nददृशुर्विविधाश्चर्यं कैलासं पर्वतोत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023765, "chapter_id": 1509, "verse_number": "३-१४७-२२", "content_sanskrit": "तस्याभ्याशे तु ददृशुर्नरनारायणाश्रमम्।\nउपेतं पादपैर्दिव्यैः सदापुष्पफलोपगैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023766, "chapter_id": 1509, "verse_number": "३-१४७-२३", "content_sanskrit": "ददृशुस्तां च बदरीं वृत्तस्कन्धां मनोरमाम्।\nस्निग्धामविरलच्छायां श्रिया परमया युताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023767, "chapter_id": 1509, "verse_number": "३-१४७-२४", "content_sanskrit": "पत्रैः स्निग्धैरविरलैरुपेतां मृदुभिः शुभाम्।\nविशालशाखां विस्तीर्णामतिद्युतिसमन्विताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023768, "chapter_id": 1509, "verse_number": "३-१४७-२५", "content_sanskrit": "फलैरुपचितैर्दिव्यैराचितां स्वादुभिर्भृशम्।\nमधुस्रवैः सदा दिव्यां महर्षिगणसेविताम्।\nमदप्रमुदितैर्नित्यं नानाद्विजगणैर्युताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2023769, "chapter_id": 1509, "verse_number": "३-१४७-२६", "content_sanskrit": "अदंशमशके देशे बहुमूलफलोदके।\nनीलशाद्वलसंछन्ने देवगन्धर्वसेविते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2023770, "chapter_id": 1509, "verse_number": "३-१४७-२७", "content_sanskrit": "सुभूमिभागविशदे स्वभावविदिते शुभे।\nजातां हिममृदुस्पर्शे देशेऽपहतकण्टके ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2023771, "chapter_id": 1509, "verse_number": "३-१४७-२८", "content_sanskrit": "तामुपेत्य महात्मानः सह तैर्ब्राह्मणर्षभैः।\nअवतेरुस्ततः सर्वे राक्षसस्कन्धतः शनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2023772, "chapter_id": 1509, "verse_number": "३-१४७-२९", "content_sanskrit": "ततस्तमाश्रमं पुण्यं नरनारायणाश्रितम्।\nददृशुः पाण्डवा राजन्सहिता द्विजपुङ्गवैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2023773, "chapter_id": 1509, "verse_number": "३-१४७-३०", "content_sanskrit": "तमसा रहितं पुण्यमनामृष्टं रवेः करैः।\nक्षुत्तृट्शीतोष्णदोषैश्च वर्जितं शोकनाशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2023774, "chapter_id": 1509, "verse_number": "३-१४७-३१", "content_sanskrit": "महर्षिगणसंबाधं ब्राह्म्या लक्ष्म्या समन्वितम्।\nदुष्प्रवेशं महाराज नरैर्धर्मबहिष्कृतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2023775, "chapter_id": 1509, "verse_number": "३-१४७-३२", "content_sanskrit": "बलिहोमार्चितं दिव्यं सुसंमृष्टानुलेपनम्।\nदिव्यपुष्पोपहारैश्च सर्वतोऽभिविराजितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2023776, "chapter_id": 1509, "verse_number": "३-१४७-३३", "content_sanskrit": "विशालैरग्निशरणैः स्रुग्भाण्डैराचितं शुभैः।\nमहद्भिस्तोयकलशैः कठिनैश्चोपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2023777, "chapter_id": 1509, "verse_number": "३-१४७-३४", "content_sanskrit": "शरण्यं सर्वभूतानां ब्रह्मघोपनिनादितम्।\nदिव्यमाश्रयणीयं तमाश्रमं श्रमनाशनम्।\nश्रिया युतमनिर्देश्यं देववर्योपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2023778, "chapter_id": 1509, "verse_number": "३-१४७-३५", "content_sanskrit": "फलमूलाशनैर्दान्तैश्चारुकृष्णाजिनाम्बरैः।\nसूर्यवैश्वानरसमैस्तपसा भावितात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2023779, "chapter_id": 1509, "verse_number": "३-१४७-३६", "content_sanskrit": "महर्षिभिर्मोक्षपरैर्यतिभिर्नियतेन्द्रियैः।\nब्रह्मभूतैर्महाभागैरुपेतं ब्रह्मवादिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2023780, "chapter_id": 1509, "verse_number": "३-१४७-३७", "content_sanskrit": "सोऽभ्यगच्छन्महातेजास्तानृषीन्नियतः शुचिः।\nभ्रातृभिः सहितो धीमान्धर्मपुत्रो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2023781, "chapter_id": 1509, "verse_number": "३-१४७-३८", "content_sanskrit": "दिव्यज्ञानोपपन्नास्ते दृष्ट्वा प्राप्तं युधिष्ठिरम्।\nअभ्यगच्छन्त सुप्रीता दिव्या देवमहर्षयः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2023782, "chapter_id": 1509, "verse_number": "३-१४७-३९", "content_sanskrit": "प्रीतास्ते तस्य सत्कारं विधिना पावकापमाः।\nउपाजह्रुश्च सलिलं पुष्पमूलफलं शुचि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2023783, "chapter_id": 1509, "verse_number": "३-१४७-४०", "content_sanskrit": "स तैः प्रीत्याऽथ सत्कारमुपनीतं महर्षिभिः।\nप्रयतः प्रतिगृह्याथ धर्मराजो युधिष्ठिरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2023784, "chapter_id": 1509, "verse_number": "३-१४७-४१", "content_sanskrit": "तं शक्रसदनप्रख्यं दिव्यगन्धं मनोरमम्।\nप्रीतः स्वर्गोपमं पुण्यं पाण्डवः सह कृष्णया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2023785, "chapter_id": 1509, "verse_number": "३-१४७-४२", "content_sanskrit": "रविवेश शोभया युक्तं भ्रातृभिश्च सहानघ।\nब्राह्मणैर्वेदवेदाङ्गपारगैश्च सहार्चितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2023786, "chapter_id": 1509, "verse_number": "३-१४७-४३", "content_sanskrit": "तत्रापश्यत्स धर्मात्मा देवदेवर्पिपूजितम्।\nनरनारायणस्थानं भागीरथ्योपशोभितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2023787, "chapter_id": 1509, "verse_number": "३-१४७-४४", "content_sanskrit": "तस्मिन्मधृस्रवफलां ब्रह्मर्षिगणभाविनीम्।\nवदरीं तामुपाश्रित्य पाण्डवो भ्रातृभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2023788, "chapter_id": 1509, "verse_number": "३-१४७-४५", "content_sanskrit": "मुदा युक्ता महात्मानो रेमिरे तत्र ते तदा।\nआलोकयन्तो मैनाकं नानाद्विजगणायुतम्।\nहिरण्यशिखरं चैव मध्ये विन्दुसरः शिवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2023789, "chapter_id": 1509, "verse_number": "३-१४७-४६", "content_sanskrit": "भागीरथीं सुतीर्थां च शीतामलजलां शिवाम्।\nमणिप्रवालप्रस्तारां पादपैरुषशोभिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2023790, "chapter_id": 1509, "verse_number": "३-१४७-४७", "content_sanskrit": "दिव्यपुष्पसमाकीर्णां मनःप्रीतिविवर्धनीम्।\nवीक्षमाणा महात्मानो विजह्रुस्तत्र पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2023791, "chapter_id": 1509, "verse_number": "३-१४७-४८", "content_sanskrit": "तस्मिन्देवर्षिचरिते देशे परमदुर्गमे।\nभागीरथीपुण्यजलेतर्पयांचक्रिरे पितॄन्।\nदेवानृषींश्च कौन्तेयाः परमं शौचमास्थिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2023792, "chapter_id": 1509, "verse_number": "३-१४७-४९", "content_sanskrit": "तत्र ते तर्पयन्तश्च जपन्तश्च कुरूद्वहाः।\nब्राह्मणैः सहिता वीरा ह्यवसन्पुरुपर्षभाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2023793, "chapter_id": 1509, "verse_number": "३-१४७-५०", "content_sanskrit": "कृष्णायास्तत्रपशय्न्तः क्रीडितान्यमरप्रभाः।\nविचित्राणि नरव्याघ्रा रेमिरे तत्र पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2023794, "chapter_id": 1509, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि सप्तचत्वारिंशदधिकशततमोऽध्यायः ॥ १४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}]