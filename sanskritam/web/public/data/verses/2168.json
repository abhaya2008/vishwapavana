[{"id": 2052898, "chapter_id": 2168, "verse_number": "७-९५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2052899, "chapter_id": 2168, "verse_number": "७-९५-१", "content_sanskrit": "प्रविष्टयोर्महाराज पार्थवार्ष्णेययो रणे।\nदुर्योधने प्रयाते च पृष्ठतः पुरुषर्षभे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2052900, "chapter_id": 2168, "verse_number": "७-९५-२", "content_sanskrit": "जवेनाभ्यद्रवन्द्रोणं महता निःस्वनेन च।\nपाण्डवाः सोमकैः सार्धं ततो युद्धमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2052901, "chapter_id": 2168, "verse_number": "७-९५-३", "content_sanskrit": "तद्युद्धमभवत्तीव्रं तुमुलं रोमहर्षणम्।\nकुरूणां पाण्डवानां च व्यूहस्य पुरतोऽद्भुतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2052902, "chapter_id": 2168, "verse_number": "७-९५-४", "content_sanskrit": "राजन्कदाचिन्नास्माभिर्दृष्टं तादृङ्क च श्रुतम्।\nयादृङ्मध्यगते सूर्ये युद्धमासीद्विशाम्पते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2052903, "chapter_id": 2168, "verse_number": "७-९५-५", "content_sanskrit": "धृष्टद्युम्नमुखाः पार्था व्यूढानीकाः प्रहारिणः।\nद्रोणस्य सैन्यं ते सर्वे शरवर्षैरवाकिरन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2052904, "chapter_id": 2168, "verse_number": "७-९५-६", "content_sanskrit": "वयं द्रोणं पुरस्कृत्य सर्वशस्त्रभृतां वरम्।\nपार्षतप्रमुखान्पार्थानभ्यवर्षाम सायकैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2052905, "chapter_id": 2168, "verse_number": "७-९५-७", "content_sanskrit": "महामेघाविवोदीर्णौ मिश्रवातौ हिमात्यये।\nसेनाग्रे प्रचकाशेते रुचिरे रथभूषिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2052906, "chapter_id": 2168, "verse_number": "७-९५-८", "content_sanskrit": "समेत्य तु महासेने चक्रतुर्वेगमुत्तमम्।\nजाह्नवीयमुने नद्यौ प्रावृषीवोल्बणोदके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2052907, "chapter_id": 2168, "verse_number": "७-९५-९", "content_sanskrit": "नानाशस्त्रपुरोवातो द्विपाश्वरथसंवृतः।\nगदाविद्युन्महारौद्रः सङ्ग्रामजलदो महान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2052908, "chapter_id": 2168, "verse_number": "७-९५-१०", "content_sanskrit": "भारद्वाजानिलोद्भूतः शरधारासहस्रवान्।\nअभ्यवर्षन्महारौद्रं पाण्डुसेनाग्निमुद्धतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2052909, "chapter_id": 2168, "verse_number": "७-९५-११", "content_sanskrit": "समुद्रमिव घर्मान्ते विशन्घोरो महानिलः।\nव्यक्षोभयदनीकानि पाण्डवानां द्विजोत्तमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2052910, "chapter_id": 2168, "verse_number": "७-९५-१२", "content_sanskrit": "तेऽपि सर्वप्रयत्नेन द्रोणमेव समाद्रवन्।\nबिभित्सन्तो महासेतुं वार्योघाः प्रबला इव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2052911, "chapter_id": 2168, "verse_number": "७-९५-१३", "content_sanskrit": "वारयामास तान्द्रोणो जलौघमचलो यथा।\nपाण्डवान्समरे क्रुद्धान्पाञ्चालांश्च सकेकयान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2052912, "chapter_id": 2168, "verse_number": "७-९५-१४", "content_sanskrit": "अथापरे च राजानः परिवृत्य समन्ततः।\nमहाबला रणे शूराः पाञ्चालानन्ववारयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2052913, "chapter_id": 2168, "verse_number": "७-९५-१५", "content_sanskrit": "ततो रणे नरव्याघ्रः पार्षतः पाण्डवैः सह।\nसञ्जघानासकृद्द्रोणं बिभित्सुररिवाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2052914, "chapter_id": 2168, "verse_number": "७-९५-१६", "content_sanskrit": "यथैव शरवर्षाणि द्रोणो वर्षति पार्षते।\nतथैव शरवर्षाणि धृष्टद्युम्नोऽप्यवर्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2052915, "chapter_id": 2168, "verse_number": "७-९५-१७", "content_sanskrit": "सनिस्त्रिंशपुरोवातः शक्तिप्रासर्ष्टिसंवृतः।\nज्याविद्युच्चापसंहादो धृष्टद्युम्नबलाहकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2052916, "chapter_id": 2168, "verse_number": "७-९५-१८", "content_sanskrit": "शरधाराश्मवर्षाणि व्यसृजत्सर्वतो दिशम्।\nनिघ्नन्रथवराश्वौघान्प्लावयामास वाहिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2052917, "chapter_id": 2168, "verse_number": "७-९५-१९", "content_sanskrit": "यंयमार्च्छच्छरैर्द्रोणः पाण्डवानां रथव्रजम्।\nततस्ततः शरैर्द्रोणमपाकर्षत पार्षतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2052918, "chapter_id": 2168, "verse_number": "७-९५-२०", "content_sanskrit": "तथा तु यतमानस्य द्रोणस्य युधि भारत।\nधृष्टद्युम्नं समासाद्य त्रिधा सैन्यमभिद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2052919, "chapter_id": 2168, "verse_number": "७-९५-२१", "content_sanskrit": "भोजमेकेऽभ्यवर्तन्त जलसन्धं तथाऽपरे।\nपाण्डवैर्हन्यमानाश्च द्रोणमेवापरे ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2052920, "chapter_id": 2168, "verse_number": "७-९५-२२", "content_sanskrit": "सङ्घट्टयति सैन्यानि द्रोणस्तु रथिनां वरः।\nव्यधमच्चापि तान्यस्य धृष्टद्युम्नो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2052921, "chapter_id": 2168, "verse_number": "७-९५-२३", "content_sanskrit": "धार्तराष्ट्रास्तथा भूता वध्यन्ते पाण्डुसृञ्जयैः।\nअगोपाः पशवोऽरण्ये बहुभिः श्वापदैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2052922, "chapter_id": 2168, "verse_number": "७-९५-२४", "content_sanskrit": "कालः स्म ग्रसते योधान्धृष्टद्युम्नेन मोहितान्।\nसङ्ग्रामे तुमुले तस्मिन्निति सम्मेनिरे जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2052923, "chapter_id": 2168, "verse_number": "७-९५-२५", "content_sanskrit": "कुनृपस्य यथा राष्ट्रं दुर्भिक्षव्याधितस्करैः।\nद्राव्यते तद्वदापन्ना पाण्डवैस्तव वाहिनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2052924, "chapter_id": 2168, "verse_number": "७-९५-२६", "content_sanskrit": "अर्करश्मिविमिश्रेषु शस्त्रेषु कवचेषु च।\nचक्षूंषि प्रत्यहन्यन्त सैन्येन रजसा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2052925, "chapter_id": 2168, "verse_number": "७-९५-२७", "content_sanskrit": "त्रिधा भूतेषु सैन्येषु वध्यमानेषु पाण्डवैः।\nअमर्षितस्ततो द्रोणः पाञ्चालान्व्यधमच्छरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2052926, "chapter_id": 2168, "verse_number": "७-९५-२८", "content_sanskrit": "मृद्गतस्तान्यनीकानि निघ्नतश्चापि सायकैः।\nबभूव रूपं द्रोणस्य कालाग्नेरिव दीप्यतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2052927, "chapter_id": 2168, "verse_number": "७-९५-२९", "content_sanskrit": "रथं नागं हयं चापि पत्तिनश्च विशाम्पते।\nएकैकेनेषुणा सङ्ख्ये निर्बिभेद महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2052928, "chapter_id": 2168, "verse_number": "७-९५-३०", "content_sanskrit": "पाण़्डवानां तु सैन्येषु नास्ति कश्चित्स भारत।\nदधार यो रणे बाणान्द्रोणचापच्युतान्प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2052929, "chapter_id": 2168, "verse_number": "७-९५-३१", "content_sanskrit": "तत्पच्यमानमर्केण द्रोणसायकतापितम्।\nबभ्राम पार्षतं सैन्यं तत्रतत्रैव भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2052930, "chapter_id": 2168, "verse_number": "७-९५-३२", "content_sanskrit": "`हन्यमानं तु तत्सैन्यं भारद्वाजेन सर्वतः।\nशरैरग्निशिखाकारैर्दह्यते भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2052931, "chapter_id": 2168, "verse_number": "७-९५-३३", "content_sanskrit": "तथैव पार्षतेनापि काल्यमानं बलं तव।\nअभवत्सर्वतो दीप्तं शुष्कं वनमिवाग्निना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2052932, "chapter_id": 2168, "verse_number": "७-९५-३४", "content_sanskrit": "बाध्यमानेषु सैन्येषु द्रोणपार्षतसायकैः।\nत्यक्त्वा प्राणान्परं शक्त्या युध्यन्ते स्वर्गलिप्सवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2052933, "chapter_id": 2168, "verse_number": "७-९५-३५", "content_sanskrit": "तावकानां परेषां च युध्यतां भरतर्षभ।\nनासीत्कश्चिन्महाराज योऽत्याक्षीत्संयुगं भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2052934, "chapter_id": 2168, "verse_number": "७-९५-३६", "content_sanskrit": "भीमसेनं तु कौन्तेयं सोदर्याः पर्यवारयन्।\nविविंशतिश्चित्रसेनो विकर्णश्च महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2052935, "chapter_id": 2168, "verse_number": "७-९५-३७", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ क्षेमधूर्तिश्च वीर्यवान्।\nत्रयाणां तव पुत्राणां त्रय एवानुयायिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2052936, "chapter_id": 2168, "verse_number": "७-९५-३८", "content_sanskrit": "बाह्लीकराजस्तेजस्वी कुलपुत्रो महारथः।\nसहसेनः सहामात्यो द्रौपदेयानवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2052937, "chapter_id": 2168, "verse_number": "७-९५-३९", "content_sanskrit": "शैब्यो गोवासनो राजा योधैर्दशशतावरैः।\nकाश्यस्याभिभुवः पुत्रं पराक्रान्तमवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2052938, "chapter_id": 2168, "verse_number": "७-९५-४०", "content_sanskrit": "अजातशत्रुं कौन्तेयं ज्वलन्तमिव पावकम्।\nमद्राणामीश्वरः शल्यो राजा राजानमावृणोत्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2052939, "chapter_id": 2168, "verse_number": "७-९५-४१", "content_sanskrit": "दुःशासनस्त्ववस्थाप्य स्वमनीकममर्षणः।\nसात्यकिं प्रययौ क्रुद्धः शूरो रथवरं युधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2052940, "chapter_id": 2168, "verse_number": "७-९५-४२", "content_sanskrit": "स्वकेनाहमनीकेन सन्नद्धः कवचावृतः।\nचतुःशतैर्महेष्वासैश्चेकितानमवारयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2052941, "chapter_id": 2168, "verse_number": "७-९५-४३", "content_sanskrit": "शकुनिस्तु सहानीको माद्रीपुत्राववारयत्।\nगान्धारकैः सप्तशतैश्चापशक्त्यसिपाणिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2052942, "chapter_id": 2168, "verse_number": "७-९५-४४", "content_sanskrit": "विन्दानुविन्दावावन्त्यौ विराटं मत्स्यमार्च्छताम्।\nप्राणांस्तक्त्वा महेष्वासौ मित्रार्थेऽभ्युद्यतायुधौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2052943, "chapter_id": 2168, "verse_number": "७-९५-४५", "content_sanskrit": "शिखण्डिनं याज्ञसेनिं रुन्धानमपराजितम्।\nबाह्लीकः प्रतिसंयत्तः पराक्रान्तमवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2052944, "chapter_id": 2168, "verse_number": "७-९५-४६", "content_sanskrit": "धृष्टद्युम्नं तु पाञ्चाल्यं क्रूरैः सार्धं प्रभद्रकैः।\nआवन्त्यः सहसौवीरैः क्रुद्धरूपमवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2052945, "chapter_id": 2168, "verse_number": "७-९५-४७", "content_sanskrit": "घटोत्कचं तथा शूरं राक्षसं क्रूरकर्मिणम्।\nअलामुधोऽद्रवत्तूर्णं क्रुद्धमायान्तमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2052946, "chapter_id": 2168, "verse_number": "७-९५-४८", "content_sanskrit": "अलम्बुसं राक्षसेन्द्रं कुन्तिभोजो महारथः।\nसैन्येन महता युक्तः क्रुद्धरूपमवारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2052947, "chapter_id": 2168, "verse_number": "७-९५-४९", "content_sanskrit": "सैन्धवः पृष्ठतस्त्वासीत्सर्वसैन्यस्य भारत।\nरक्षितः परमेष्वासैः कृपप्रभृतिभी रथैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2052948, "chapter_id": 2168, "verse_number": "७-९५-५०", "content_sanskrit": "तस्यास्तां चक्ररक्षौ द्वौ सैन्धवस्य बृहत्तमौ।\nद्रौणिर्दक्षिणतो राजन्सूतपुत्रश्च वामतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2052949, "chapter_id": 2168, "verse_number": "७-९५-५१", "content_sanskrit": "पृष्ठगोपास्तु तस्यासन्सौमदत्तिपुरोगमाः।\nकृपश्च वृषसेनश्च शलः शल्यश्च दुर्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2052950, "chapter_id": 2168, "verse_number": "७-९५-५२", "content_sanskrit": "नीतिमन्तो महेष्वासाः सर्वे युद्धविशारदाः।\nसैन्धवस्य विधायैवं रक्षां युयुधिरे ततः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2052951, "chapter_id": 2168, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे पञ्चनवतितमोऽध्यायः॥ ९५ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-९५-७ हिमात्यये शिशिरे। सेनाग्रे प्रधाने सेने॥ ५-९५-१८ प्लावयामास विद्रावितवान्॥ ५-९५-१९ अपाकर्षत व्यावर्तितवान्॥ ५-९५-२२ सङ्घट्टयति सम्मेलयति॥ ५-९५-३९ काश्यस्य काशिराजस्य॥ ५-९५-४६ आवन्त्योऽन्यः॥ ५-९५-९५ पञ्चनवतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]