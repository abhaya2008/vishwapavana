[{"id": 7002117000, "chapter_id": 22117, "verse_number": "१६२-१", "content_sanskrit": "धर्मशास्त्रकथनं ।\nपुष्कर उवाच ।\nमनुर्विष्णुर्याज्ञवल्को हारीतोऽत्रिर्यमोऽङिगिराः ।\nवसिष्ठदक्षसंवर्तशातातपपराशराः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002117001, "chapter_id": 22117, "verse_number": "१६२-२", "content_sanskrit": "आपस्तम्बोशनोव्यासाः कात्ययनबृहस्पती ।\nगोतमः शङ्खलिखितौ धर्ममेते यथाब्रुवन् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002117002, "chapter_id": 22117, "verse_number": "१६२-३", "content_sanskrit": "तथा वक्ष्ये समासेन भुक्तिमुक्तिप्रदं शृणु ।\nप्रवृत्तञ्च निवृत्तञ्च द्विविधङ्कर्म वैदिकं ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002117003, "chapter_id": 22117, "verse_number": "१६२-४", "content_sanskrit": "काम्यं कर्म प्रवृत्तं स्यान्निवृत्तं ज्ञानपूर्वकं ।\nवेदाभ्यासस्तपो ज्ञानमिन्दियाणाञ्च संयमः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002117004, "chapter_id": 22117, "verse_number": "१६२-५", "content_sanskrit": "अहिंसा गुरुसेवा च निःश्रेयसकरं परं ।\nसर्वेषामपि चैतेषामत्मज्ञानं परं स्मृतं ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002117005, "chapter_id": 22117, "verse_number": "१६२-६", "content_sanskrit": "तच्चग्र्यं सर्वविद्यानां प्राप्यते ह्यमृतं ततः ।\nसर्वभूतेषु चात्मानं सर्वभूतानि चात्मनि ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002117006, "chapter_id": 22117, "verse_number": "१६२-७", "content_sanskrit": "समम्पश्यन्नात्मयाजी स्वाराज्यमधिगच्छति ।\nआत्मज्ञाने समे च स्याद्वेदाभ्यासे च यत्नवान् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002117007, "chapter_id": 22117, "verse_number": "१६२-८", "content_sanskrit": "एतद्द्विजन्मसामर्थ्यं ब्राह्मणस्य विशेषतः ।\nवेदशास्त्रार्थतत्त्वज्ञो यत्र तत्राश्रमे वसन् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002117008, "chapter_id": 22117, "verse_number": "१६२-९", "content_sanskrit": "इहैव लोके तिष्ठन् हि ब्रह्मभूयाय कल्प्यते ।\nस्वाध्यायानामुपाकर्म श्रावण्यां श्रावणेन तु ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002117009, "chapter_id": 22117, "verse_number": "१६२-१०", "content_sanskrit": "हस्ते चौषधिवारे च पञ्चम्यां श्रावणस्य वा ।\nपौषमासस्य रोहिण्यामष्टकायामथापि वा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002117010, "chapter_id": 22117, "verse_number": "१६२-११", "content_sanskrit": "जलान्ते छन्दसाङ्कुर्यादुत्सर्गं विधिवद्वहिः ।\nत्र्यहं प्रेतेष्वनध्यायः शिष्यर्त्विग्गुरुबन्धुषु ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002117011, "chapter_id": 22117, "verse_number": "१६२-१२", "content_sanskrit": "उपाकर्मणि चोत्सर्गं स्वशाखाश्रोत्रिये तथा ।\nसन्ध्यागर्जितनिर्घाते भूकम्पोल्कानिपातने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002117012, "chapter_id": 22117, "verse_number": "१६२-१३", "content_sanskrit": "समाप्य वेदं ह्यनिशमारण्यकमधीत्य च ।\nपञ्चदश्यां चतुर्दश्यामष्टम्यां राहुसूतके ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002117013, "chapter_id": 22117, "verse_number": "१६२-१४", "content_sanskrit": "ऋतुसन्धिषु भुक्त्वा वा श्राद्विकं प्रतिगृह्य च ।\nपशुमण्डूकनकुलश्वाहिमार्जारशूकरैः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002117014, "chapter_id": 22117, "verse_number": "१६२-१५", "content_sanskrit": "कृतेन्तरे त्वहोरात्रं शक्रपाते तथोच्छ्रिये ।\nश्वक्रोष्टुगर्धभोलूकमासवाणर्तुनिस्वने ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002117015, "chapter_id": 22117, "verse_number": "१६२-१६", "content_sanskrit": "अमेध्यशवशूद्रान्त्यश्मशानपतितान्तिके ।\nअशुभासु च तारासु विद्युत्स्तनितसम्प्लवे ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002117016, "chapter_id": 22117, "verse_number": "१६२-१७", "content_sanskrit": "भुत्क्वार्द्रपाणिरम्भोन्तरर्धरात्रेऽतिमारुते ।\nपांशुवर्षे दिशान्दाहे सन्ध्यानीहारभीतिषु ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002117017, "chapter_id": 22117, "verse_number": "१६२-१८", "content_sanskrit": "धावतः प्राणिबाधे च विशिष्टे गृहमागते ।\nखरोष्ट्रयानहस्त्यश्वनौकावृक्षादिरोहणे ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002117018, "chapter_id": 22117, "verse_number": "१६२-१९", "content_sanskrit": "सप्तत्रिंशदनध्यायानेतांस्तात्कालिकान्विदुः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]