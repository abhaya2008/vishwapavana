[{"id": 7000519000, "chapter_id": 20519, "verse_number": "४-४-१", "content_sanskrit": "शौनक उवाच ।\nजयंत्याः सूत माहात्म्यं कदा सा क्रियते जनैः ।\nकथयस्व मयि त्वं वै पोतः संसारसागरे॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000519001, "chapter_id": 20519, "verse_number": "४-४-२", "content_sanskrit": "सूत उवाच ।\nशृणु विप्र प्रवक्ष्यामि यत्पृष्टो मुनिसत्तम ।\nपुरा ब्रह्मा नारदेन पृष्ट एतत्सुरालये॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000519002, "chapter_id": 20519, "verse_number": "४-४-३", "content_sanskrit": "नारद उवाच ।\nजयंत्याश्चैव माहात्म्यं कथयस्व पितामह ।\nयच्छ्रुत्वाहं गमिष्यामि तद्विष्णोः परमं पदम्॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000519003, "chapter_id": 20519, "verse_number": "४-४-४", "content_sanskrit": "ब्रह्मोवाच ।\nशृणुष्वावहितो विप्र तवाग्रे कथयाम्यहम् ।\nजयंत्या उपवासेन विष्णुलोकं स गच्छति॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000519004, "chapter_id": 20519, "verse_number": "४-४-५", "content_sanskrit": "स्मरणात्कीर्तनात्पापं सप्तजन्मार्जितं मुने ।\nजयंती दहते तच्च किं पुनः सोपवासकृत्॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000519005, "chapter_id": 20519, "verse_number": "४-४-६", "content_sanskrit": "जन्माष्टमी च नवमी चैत्रे मासि सिता शुभा ।\nकृष्णा चतुर्दशी कुंभे मेषे शुक्ला चतुर्दशी॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000519006, "chapter_id": 20519, "verse_number": "४-४-७", "content_sanskrit": "दुर्गाष्टम्याश्विने शुक्ला द्वादशी श्रवणान्विता ।\nमहापुण्याश्च शुभदा जयंत्यः षट्प्रकीर्तिताः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000519007, "chapter_id": 20519, "verse_number": "४-४-८", "content_sanskrit": "कृष्णजन्माष्टमी पूर्वा प्रसिद्धा पापनाशिनी ।\nक्रतुकोटिसमा ह्येषा तीर्थानामयुतैः समा॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000519008, "chapter_id": 20519, "verse_number": "४-४-९", "content_sanskrit": "कर्ता गवां सहस्रं तु यो ददाति दिनेदिने ।\nतत्फलं समवाप्नोति जयंत्यां समुपोषणे॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000519009, "chapter_id": 20519, "verse_number": "४-४-१०", "content_sanskrit": "हेमभारसहस्रं तु कुरुक्षेत्रे रविग्रहे ।\nतत्फलं समवाप्नोति जयंत्यां समुपोषणे॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000519010, "chapter_id": 20519, "verse_number": "४-४-११", "content_sanskrit": "कृष्णाजिनसहस्राणि तिलधेनुशतानि च ।\nतत्फलं समवाप्नोति जयंत्यां समुपोषणे॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000519011, "chapter_id": 20519, "verse_number": "४-४-१२", "content_sanskrit": "कन्याकोटिसहस्राणां दाने भवति यत्फलम् ।\nतत्फलं समवाप्नोति जयंत्यां समुपोषणे॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000519012, "chapter_id": 20519, "verse_number": "४-४-१३", "content_sanskrit": "ससागरामिमां पृथ्वीं दत्वा यल्लभते फलम् ।\nतत्फलं समवाप्नोति जयंत्यां समुपोषणे॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000519013, "chapter_id": 20519, "verse_number": "४-४-१४", "content_sanskrit": "वापीकूपतडागदि कर्तव्यं देवतालये ।\nतत्फलं समवाप्नोति जयंत्यां समुपोषणे॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000519014, "chapter_id": 20519, "verse_number": "४-४-१५", "content_sanskrit": "मातापित्रोर्गुरूणां च भक्तिं युक्तः करोति यः ।\nतत्फलं समवाप्नोति जयंत्यां समुपोषणे॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000519015, "chapter_id": 20519, "verse_number": "४-४-१६", "content_sanskrit": "आपदाहरणार्थाय तीर्थसेवाकृतात्मनाम् ।\nसत्यव्रतानां यत्पुण्यं जयंत्यां समुपोषणे॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000519016, "chapter_id": 20519, "verse_number": "४-४-१७", "content_sanskrit": "गंगायां नर्मदायां यत्पुण्यं सारस्वते जले ।\nस्नात्वा पुण्यमवाप्नोति जयंत्यां समुपोषणे॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000519017, "chapter_id": 20519, "verse_number": "४-४-१८", "content_sanskrit": "यत्पुण्यं श्राद्धकर्तॄणां पितॄणामिंदुसंक्षये ।\nतत्फलं समवाप्नोति जयंत्यां समुपोषणे॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000519018, "chapter_id": 20519, "verse_number": "४-४-१९", "content_sanskrit": "नारद उवाच ।\nकेनकेन कृता पूर्वं कथयस्व पितामह ।\nब्रह्मोवाच ।\nकार्तवीर्येण कर्णेन कुमारेण च धीमता॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000519019, "chapter_id": 20519, "verse_number": "४-४-२०", "content_sanskrit": "सगरेण दिलीपेन काकुस्थेन कृता पुरा ।\nगौतमेन च गार्ग्येण जामदग्न्येन धीमता॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000519020, "chapter_id": 20519, "verse_number": "४-४-२१", "content_sanskrit": "वाल्मीकिना कृता पूर्वं द्रौपदेयेन साधुना ।\nददाति वांछितान्कामान्भाद्रपस्य सिताष्टमी॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000519021, "chapter_id": 20519, "verse_number": "४-४-२२", "content_sanskrit": "प्राजापत्यर्क्षसंयुक्ता विशेषेण मताष्टमी ।\nवर्षेवर्षे प्रकर्तव्या प्रीत्यर्थे चक्रपाणिनः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000519022, "chapter_id": 20519, "verse_number": "४-४-२३", "content_sanskrit": "कोटिजन्मार्जितं पापं मुहूर्तेन विलीयते ।\nरात्रौ जागरणं कृत्वा निष्ठापूर्वं जितेंद्रियः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000519023, "chapter_id": 20519, "verse_number": "४-४-२४", "content_sanskrit": "गंधपुष्पादिनैवेद्यैः पूजनीयः पृथक्पृथक् ।\nएवं यः कुरुते विप्र जयंतीसमुपोषणम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000519024, "chapter_id": 20519, "verse_number": "४-४-२५", "content_sanskrit": "कोटिजन्मार्जितं पापं ज्ञानतोऽज्ञानतः कृतम्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000519025, "chapter_id": 20519, "verse_number": "४-४-२६", "content_sanskrit": "प्रसादाद्देवकीसूनोर्यामार्द्धेन विलीयते ।\nजयंतीतिथिसंप्राप्तौ भुंजते ये नराधमाः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000519026, "chapter_id": 20519, "verse_number": "४-४-२७", "content_sanskrit": "त्रैलोक्यसंभवं पापं भुंजते ते न संशयः ।\nसागराद्यानि तीर्थानि मुक्तस्थानानि सर्वशः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000519027, "chapter_id": 20519, "verse_number": "४-४-२८", "content_sanskrit": "गृहे तिष्ठंति सर्वांगे जयंतीव्रतकारिणः ।\nतस्य सर्वाणि तीर्थानि देहे तिष्ठंति देवताः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000519028, "chapter_id": 20519, "verse_number": "४-४-२९", "content_sanskrit": "करोति यो नरो भक्त्या जयंतीं कृष्णवल्लभाम् ।\nन वेदेन पुराणेन मया दृष्टं महामुने॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000519029, "chapter_id": 20519, "verse_number": "४-४-३०", "content_sanskrit": "तत्समं नाधिकं वापि कृष्णराधाष्टमीव्रतम् ।\nन करोति नरो भक्त्या स भवेत्क्रूरराक्षसः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000519030, "chapter_id": 20519, "verse_number": "४-४-३१", "content_sanskrit": "यो नरोऽश्नाति मूढात्मा जयंतीवासरे द्विज ।\nमहानरकमश्नाति यथा च हरिवासरे॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000519031, "chapter_id": 20519, "verse_number": "४-४-३२", "content_sanskrit": "अतीतमागतं यस्तु कुलमेकोत्तरं शतम् ।\nपतेत्तु नरके घोरे जयंत्यां भोजनेन वै॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000519032, "chapter_id": 20519, "verse_number": "४-४-३३", "content_sanskrit": "जयंती बुधवारे च रोहिण्या सहिता यदा ।\nभवेच्च मुनिशार्दूल किं कृतैर्व्रतकोटिभिः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000519033, "chapter_id": 20519, "verse_number": "४-४-३४", "content_sanskrit": "कृते त्रेतायुगे चैव द्वापरे च कलौ युगे ।\nकृता सम्यग्विधानेन जयंती पापनाशिनी॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000519034, "chapter_id": 20519, "verse_number": "४-४-३५", "content_sanskrit": "जागरे पद्मनाभस्य पुराणं पाठयेत्तु यः ।\nआजन्मोपार्जितं पापं दहते तूलराशिवत्॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000519035, "chapter_id": 20519, "verse_number": "४-४-३६", "content_sanskrit": "यः शृणोति नरो भक्त्या पुराणं हरिवासरे ।\nकोटिजन्मार्जितं तस्य पापं नश्यति तत्क्षणात्॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000519036, "chapter_id": 20519, "verse_number": "४-४-३७", "content_sanskrit": "वासरे पद्मनाभस्य पूजयेद्वाचकं मुने ।\nकुलकोटिं समुद्धृत्य विष्णुलोके स पूज्यते॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000519037, "chapter_id": 20519, "verse_number": "४-४-३८", "content_sanskrit": "जयंत्यामुपवासेन यो नरोऽत्र पराङ्मुखः ।\nसर्वधर्मविनिर्मुक्तो यात्यसौ नरकं ध्रुवम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000519038, "chapter_id": 20519, "verse_number": "४-४-३९", "content_sanskrit": "गंधपुष्पैश्च धूपैश्च घृतपूर्णप्रदीपकैः ।\nपूजयेद्भक्तिभावैश्च दद्याद्विप्राय दक्षिणाम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000519039, "chapter_id": 20519, "verse_number": "४-४-४०", "content_sanskrit": "विधिनानेन यो विप्र जयंतीं प्रकरोति च ।\nनरो वै तारयेद्भक्त्या पुरुषानेकविंशतिम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000519040, "chapter_id": 20519, "verse_number": "४-४-४१", "content_sanskrit": "न दौर्भाग्यं न वैधव्यं न भवेत्कलहो गृहे ।\nसंततेर्न विरोधं च न पश्यति धनक्षयम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000519041, "chapter_id": 20519, "verse_number": "४-४-४२", "content_sanskrit": "यान्यांश्चिकीर्षते कामान्जयंती समुपोषकः ।\nतांस्तान्प्राप्नोति सकलान्विष्णुलोकं स गच्छति॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000519042, "chapter_id": 20519, "verse_number": "४-४-४३", "content_sanskrit": "विष्णुभक्तिपरा नित्यं जयंतीव्रत मानसाः ।\nते धन्यास्ते कुलीनास्ते ईश्वरास्ते च पंडिताः॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000519043, "chapter_id": 20519, "verse_number": "४-४-४४", "content_sanskrit": "यानि कानि च तीर्थानि व्रतानि नियमानि च ।\nजयंतीवासरस्यैव कलां नार्हंति षोडशीम्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000519044, "chapter_id": 20519, "verse_number": "४-४-४५", "content_sanskrit": "भाद्रे वै चोभये पक्षे यः करोति सभार्यकः ।\nराधाकृष्णाष्टमीं वत्स प्राप्नोति हरिसन्निधिम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000519045, "chapter_id": 20519, "verse_number": "४-४-४६", "content_sanskrit": "व्रतं च पुण्यकारं च यः करोति सदा हरेः ।\nस याति विष्णोर्वैकुंठं जयंतीसमुपोषकः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000519046, "chapter_id": 20519, "verse_number": "४-४-४७", "content_sanskrit": "आचारहीनं कुलभ्रष्टं कीर्तिहीनं कुयोनिजम् ।\nनाशयत्याशु पापं च जयंती हरिवल्लभा॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000519047, "chapter_id": 20519, "verse_number": "४-४-४८", "content_sanskrit": "मेरुतुल्यानि पापानि ब्रह्महत्यादिकानि च ।\nस निर्दहति सर्वाणि जयंत्यां समुपोषकः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000519048, "chapter_id": 20519, "verse_number": "४-४-४९", "content_sanskrit": "पुत्रार्थी लभते पुत्रं धनार्थी लभते धनम् ।\nमोक्षार्थी लभते मोक्षं जयंत्यां समुपोषकः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000519049, "chapter_id": 20519, "verse_number": "४-४-५०", "content_sanskrit": "जयंतीकरणे चित्तं येषां भवति तत्परम् ।\nयमोऽपि शंकते नित्यं ते यांति परमां गतिम्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000519050, "chapter_id": 20519, "verse_number": "४-४-५१", "content_sanskrit": "सूत उवाच ।\nकथयित्वा नारदं तु ययौ स च यथागतः ।\nमयापि कथितं ब्रह्मन्यत्पृष्टोऽहं त्वया मुने॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000519051, "chapter_id": 20519, "verse_number": "४-४-५२", "content_sanskrit": "माहात्म्यं च जयंत्या ये शृण्वंति भक्तिभावतः ।\nतेपि यांति परं धाम विमुक्ताः सर्वपातकैः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000519052, "chapter_id": 20519, "verse_number": "४-४-५३", "content_sanskrit": "पुराणवाचकं ब्रह्मन्जयंतीव्रतिनं तथा ।\nये पश्यंति नराः पापास्ते यांति परमं पदम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}]