[
  {
    "id": 20129410,
    "chapter_id": 6993,
    "verse_number": "10.1",
    "content_sanskrit": "अथ दशमो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 1,
    "avatarnika": ""
  },
  {
    "id": 20129411,
    "chapter_id": 6993,
    "verse_number": "10.2",
    "content_sanskrit": "एवं पादस्य जङ्घाया ऊर्वोः कट्यास्तथैव च । समानकरणे चेष्टा सा चारीत्यभिधीयते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 2,
    "avatarnika": ""
  },
  {
    "id": 20129412,
    "chapter_id": 6993,
    "verse_number": "10.3",
    "content_sanskrit": "विधानोपगताश्चार्यो व्यायच्छन्ते परस्परम् । यस्मादङ्गसमायुक्तास्तस्माद्व्यायाम उच्यते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 3,
    "avatarnika": ""
  },
  {
    "id": 20129413,
    "chapter_id": 6993,
    "verse_number": "10.4",
    "content_sanskrit": "एकपादप्रचारो यः सा चारीत्यभिसंज्ञिता । द्विपादक्रमणं यत्तु करणं नाम तद्भवेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 4,
    "avatarnika": ""
  },
  {
    "id": 20129414,
    "chapter_id": 6993,
    "verse_number": "10.5",
    "content_sanskrit": "करणानां समायोगः खण्डमित्यभिधीयते । खण्डैस्त्रिभिश्चतुर्भिर्वा संयुक्तं मण्डलं भवेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 5,
    "avatarnika": ""
  },
  {
    "id": 20129415,
    "chapter_id": 6993,
    "verse_number": "10.6",
    "content_sanskrit": "चारीभिः प्रसृतं नृत्तं चारीभिश्चेष्टितं तथा । चारीभिः शस्त्रमोक्षश्च चार्यो युद्धे च कीर्तिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 6,
    "avatarnika": ""
  },
  {
    "id": 20129416,
    "chapter_id": 6993,
    "verse_number": "10.7",
    "content_sanskrit": "यदेतत्प्रस्तुतं नाट्यं तच्चारीष्वेव संज्ञितम् । नहि चार्या विना किञ्चिन्नाट्ये ऽङ्गं संप्रवर्तते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 7,
    "avatarnika": ""
  },
  {
    "id": 20129417,
    "chapter_id": 6993,
    "verse_number": "10.8",
    "content_sanskrit": "तस्माच्चारीविधानस्य सम्प्रवक्ष्यामि लक्षणम् । या यस्मिंस्तु यथा योज्या नृत्ते युद्धे गतौ तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 8,
    "avatarnika": ""
  },
  {
    "id": 20129418,
    "chapter_id": 6993,
    "verse_number": "10.9",
    "content_sanskrit": "समपादा स्थितावर्ता शकटास्या तथैव च । अध्यर्धिका चाषगतिर्विच्यवा च तथापरा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 9,
    "avatarnika": ""
  },
  {
    "id": 20129419,
    "chapter_id": 6993,
    "verse_number": "10.10",
    "content_sanskrit": "एडकाक्रीडिता बद्धा उरुद्वृत्ता तथाड्डिता । उत्स्पन्दिता च जनिता स्यन्दिता चापस्यन्दिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 10,
    "avatarnika": ""
  },
  {
    "id": 20129420,
    "chapter_id": 6993,
    "verse_number": "10.11",
    "content_sanskrit": "समोत्सरितमत्तल्ली मत्तल्ली चेति षोडश । एता भौम्यः स्मृताश्चार्यः शृणुताकाशिकीः पुनः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 11,
    "avatarnika": ""
  },
  {
    "id": 20129421,
    "chapter_id": 6993,
    "verse_number": "10.12",
    "content_sanskrit": "अतिक्रान्ता ह्यपक्रान्ता पार्श्वक्रान्ता तथैव च । ऊर्ध्वजानुश्च सूची च तथा नूपुरपादिका ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 12,
    "avatarnika": ""
  },
  {
    "id": 20129422,
    "chapter_id": 6993,
    "verse_number": "10.13",
    "content_sanskrit": "डोलपादा तथाक्षिप्ता आविद्धोद्वृत्तसंज्ञिते । विद्युद्भ्रान्ता ह्यलाता च भुजङ्गत्रासिता तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 13,
    "avatarnika": ""
  },
  {
    "id": 20129423,
    "chapter_id": 6993,
    "verse_number": "10.14",
    "content_sanskrit": "मृगप्लुता च दण्डा च भ्रमरी चेति षोडश । आकाशिक्यः स्मृता ह्येता लक्षणं च निबोधत ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 14,
    "avatarnika": ""
  },
  {
    "id": 20129424,
    "chapter_id": 6993,
    "verse_number": "10.15",
    "content_sanskrit": "पादैर्निरन्तरकृतैस्तथा समनखैरपि । समपादा स्मृता चारी विज्ञेया स्थानसंश्रया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 15,
    "avatarnika": ""
  },
  {
    "id": 20129425,
    "chapter_id": 6993,
    "verse_number": "10.16",
    "content_sanskrit": "भूमिघृष्टेन पादेन कृत्वाभ्यन्तरमण्डलम् । पुनरुत्सादयेदन्यं स्थितावर्त्ता तु सा स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 16,
    "avatarnika": ""
  },
  {
    "id": 20129426,
    "chapter_id": 6993,
    "verse_number": "10.17",
    "content_sanskrit": "निषण्णाङ्गस्तु चरणं प्रसार्य तलसञ्चरम् । उद्वाहितमुरः कृत्वा शकटास्यां प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 17,
    "avatarnika": ""
  },
  {
    "id": 20129427,
    "chapter_id": 6993,
    "verse_number": "10.18",
    "content_sanskrit": "सव्यस्य पृष्ठतो वामश्चरणस्तु यदा भवेत् । तस्यापसर्पणं चैव ज्ञेया साध्यर्धिका बुधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 18,
    "avatarnika": ""
  },
  {
    "id": 20129428,
    "chapter_id": 6993,
    "verse_number": "10.19",
    "content_sanskrit": "पादः प्रसारितः सव्यः पुनश्चैवोपसर्पितः । वामः सव्यापसर्पी च चाषगत्यां विधीयते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 19,
    "avatarnika": ""
  },
  {
    "id": 20129429,
    "chapter_id": 6993,
    "verse_number": "10.20",
    "content_sanskrit": "विच्यवात् समपादाया विच्यवां सम्प्रयोजयेत् । निकुट्टयंस्तलाग्रेण पादस्य धरणीतलम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 20,
    "avatarnika": ""
  },
  {
    "id": 20129430,
    "chapter_id": 6993,
    "verse_number": "10.21",
    "content_sanskrit": "तलसञ्चरपादाभ्यामुत्प्लुत्य पतनं तु यत् । पर्यायतश्च क्रियते एडकाक्रीडिता तु सा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 21,
    "avatarnika": ""
  },
  {
    "id": 20129431,
    "chapter_id": 6993,
    "verse_number": "10.22",
    "content_sanskrit": "अन्योन्यजङ्घासंवेगात् कृत्वा तु स्वस्तिकं ततः । ऊरुभ्याम् वलनं यस्मात् सा बद्धा चार्युदाहृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 22,
    "avatarnika": ""
  },
  {
    "id": 20129432,
    "chapter_id": 6993,
    "verse_number": "10.23",
    "content_sanskrit": "तलसञ्चरपादस्य पार्ष्णिर्बाह्योन्मुखी यदा । जङ्घाञ्चिता तथोद्वृत्ता ऊरुद्वृत्तेति सा स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 23,
    "avatarnika": ""
  },
  {
    "id": 20129433,
    "chapter_id": 6993,
    "verse_number": "10.24",
    "content_sanskrit": "अग्रतः पृष्ठतो वापि पादस्तु तलसञ्चरः । द्वितीयपादो निर्घृष्टः यस्यां स्यादड्डिता तु सा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 24,
    "avatarnika": ""
  },
  {
    "id": 20129434,
    "chapter_id": 6993,
    "verse_number": "10.25",
    "content_sanskrit": "शनैः पादो निवर्तेत बाह्येनाभ्यन्तरेण च । यद्रेचकानुसारेण सा चार्युत्स्यन्दिता स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 25,
    "avatarnika": ""
  },
  {
    "id": 20129435,
    "chapter_id": 6993,
    "verse_number": "10.26",
    "content_sanskrit": "मुष्टिहस्तश्च वक्षःस्थः करो ऽन्यश्च प्रवर्तितः । तलसञ्चरपादश्च जनिता चार्युदाहृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 26,
    "avatarnika": ""
  },
  {
    "id": 20129436,
    "chapter_id": 6993,
    "verse_number": "10.27",
    "content_sanskrit": "पञ्चतालान्तरं पादं प्रसार्य स्यन्दितां न्यसेत् । द्वितीयेन तु पादेन तथापस्यन्दितामपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 27,
    "avatarnika": ""
  },
  {
    "id": 20129437,
    "chapter_id": 6993,
    "verse_number": "10.28",
    "content_sanskrit": "तलसञ्चरपादाभ्याम् घूर्णमानोपसर्पणैः । समोत्सरितमत्तल्ली व्यायामे समुदाहृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 28,
    "avatarnika": ""
  },
  {
    "id": 20129438,
    "chapter_id": 6993,
    "verse_number": "10.29",
    "content_sanskrit": "उभाभ्यामपि पादाभ्यां घूर्णमानोपसर्पणैः । उद्वेष्टितापविद्धैश्च हस्तैर्मत्तल्ल्युदाहृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 29,
    "avatarnika": ""
  },
  {
    "id": 20129439,
    "chapter_id": 6993,
    "verse_number": "10.30",
    "content_sanskrit": "एता भौम्यः स्मृताश्चार्यो नियुद्धकरणाश्रयाः । आकाशकीनां चारीणां सम्प्रवक्ष्यामि लक्षणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 30,
    "avatarnika": ""
  },
  {
    "id": 20129440,
    "chapter_id": 6993,
    "verse_number": "10.31",
    "content_sanskrit": "कुञ्चितं पादमुत्क्षिप्य पुरतः सम्प्रसारयेत् । उत्क्षिप्य पातयेच्चैनमतिक्रान्ता तु सा स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 31,
    "avatarnika": ""
  },
  {
    "id": 20129441,
    "chapter_id": 6993,
    "verse_number": "10.32",
    "content_sanskrit": "ऊरुभ्यां वलनं कृत्वा कुञ्चितं पादमुद्धरेत् । पार्श्वे विनिक्षिपेच्चैनमपक्रान्ता तु सा स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 32,
    "avatarnika": ""
  },
  {
    "id": 20129442,
    "chapter_id": 6993,
    "verse_number": "10.33",
    "content_sanskrit": "कुञ्चितं पादमुत्क्षिप्य पार्श्वेनोत्पतनं न्यसेत् । उद्घट्टितेन पादेन पार्श्वक्रान्ता विधीयते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 33,
    "avatarnika": ""
  },
  {
    "id": 20129443,
    "chapter_id": 6993,
    "verse_number": "10.34",
    "content_sanskrit": "कुञ्चितं पादमुत्क्षिप्य जानुस्तनसमं न्यसेत् । द्वितीयं च क्रमात् स्तब्धमूर्ध्वजानुः प्रकीर्तिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 34,
    "avatarnika": ""
  },
  {
    "id": 20129444,
    "chapter_id": 6993,
    "verse_number": "10.35",
    "content_sanskrit": "कुञ्चितं पादमुत्क्षिप्य जानूर्ध्वं सम्प्रसारयेत् । पातयेच्चाग्रयोगेन सा सूची परिकीर्तिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 35,
    "avatarnika": ""
  },
  {
    "id": 20129445,
    "chapter_id": 6993,
    "verse_number": "10.36",
    "content_sanskrit": "पृष्ठतो ह्यञ्चितं कृत्वा पादमग्रतलेन तु । द्रुतं निर्यातयेद्भूमौ चारी नूपुरपादिका ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 36,
    "avatarnika": ""
  },
  {
    "id": 20129446,
    "chapter_id": 6993,
    "verse_number": "10.37",
    "content_sanskrit": "कुञ्चितं पादमुत्क्षिप्य पार्श्वात्पार्श्वं तु दोलयेत् । पातयेदञ्चितं चैवं दोलपादा तु सा स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 37,
    "avatarnika": ""
  },
  {
    "id": 20129447,
    "chapter_id": 6993,
    "verse_number": "10.38",
    "content_sanskrit": "कुञ्चितं पादमुत्क्षिप्य आक्षिप्य त्वञ्चितं न्यसेत् । जङ्घास्वस्तिकसंयुक्ता चाक्षिप्ता नाम सा स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 38,
    "avatarnika": ""
  },
  {
    "id": 20129448,
    "chapter_id": 6993,
    "verse_number": "10.39",
    "content_sanskrit": "स्वस्तिकस्याग्रतः पादः कुञ्चितस्तु प्रसारितः । निपतेदञ्चिताविद्ध आविद्धा नाम सा स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 39,
    "avatarnika": ""
  },
  {
    "id": 20129449,
    "chapter_id": 6993,
    "verse_number": "10.40",
    "content_sanskrit": "पादमाविद्धमावेष्ट्य समुत्क्षिप्य निपातयेत् । परिवृत्त्य द्वितीयं च सोद्वृत्ता चार्युदाहृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 40,
    "avatarnika": ""
  },
  {
    "id": 20129450,
    "chapter_id": 6993,
    "verse_number": "10.41",
    "content_sanskrit": "पृष्ठतो वलितं पादं शिरोघृष्टं प्रसारयेत् । सर्वतो मण्डलाविद्धं विद्युद्भ्रान्ता तु सा स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 41,
    "avatarnika": ""
  },
  {
    "id": 20129451,
    "chapter_id": 6993,
    "verse_number": "10.42",
    "content_sanskrit": "पृष्ठः प्रसारितः पादो वलितो ऽभ्यन्तरीकृतः । पार्ष्णिप्रपतितश्चैव ह्यलाता सम्प्रकीर्तिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 42,
    "avatarnika": ""
  },
  {
    "id": 20129452,
    "chapter_id": 6993,
    "verse_number": "10.43",
    "content_sanskrit": "कुञ्चितं पादमुत्क्षिप्य त्र्यश्रमूरुं विवर्तयेत् । कटिजानुविवर्ताच्च भुजङ्गत्रासिता भवेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 43,
    "avatarnika": ""
  },
  {
    "id": 20129453,
    "chapter_id": 6993,
    "verse_number": "10.44",
    "content_sanskrit": "अतिक्रान्तक्रमं कृत्वा समुत्प्लुत्य निपातयेत् । जङ्घाञ्चितोपरिक्षिप्ता सा ज्ञेया हरिणप्लुता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 44,
    "avatarnika": ""
  },
  {
    "id": 20129454,
    "chapter_id": 6993,
    "verse_number": "10.45",
    "content_sanskrit": "नूपुरं चरणं कृत्वा पुरतः सम्प्रसारयेत् । क्षिप्रमाविद्धकरणं दण्डपादा तु सा स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 45,
    "avatarnika": ""
  },
  {
    "id": 20129455,
    "chapter_id": 6993,
    "verse_number": "10.46",
    "content_sanskrit": "अतिक्रान्तक्रमं कृत्वा त्रिकं तु परिवर्तयेत् । द्वितीयपादभ्रमणात्तलेन भ्रमरी स्मृता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 46,
    "avatarnika": ""
  },
  {
    "id": 20129456,
    "chapter_id": 6993,
    "verse_number": "10.47",
    "content_sanskrit": "आकाशिक्यः स्मृता ह्येता ललिताङ्गक्रियात्मकाः । धनुर्वज्रासिशस्त्राणां प्रयोक्तव्या प्रयोक्तृभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 47,
    "avatarnika": ""
  },
  {
    "id": 20129457,
    "chapter_id": 6993,
    "verse_number": "10.48",
    "content_sanskrit": "अग्रगौ पृष्ठगौ वापि ह्यनुगौ चापि योगतः । पादयोस्तु द्विजा हस्तौ कर्तव्यौ नाट्ययोक्तृभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 48,
    "avatarnika": ""
  },
  {
    "id": 20129458,
    "chapter_id": 6993,
    "verse_number": "10.49",
    "content_sanskrit": "यतः पादस्ततो हस्तो यतो हस्तस्ततस्त्रिकम् । पादस्य निर्गमं ज्ञात्वा तथोपाङ्गानि योजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 49,
    "avatarnika": ""
  },
  {
    "id": 20129459,
    "chapter_id": 6993,
    "verse_number": "10.50",
    "content_sanskrit": "पादचार्यां यथा पादो धरणीमेव गच्छति । एवं हस्तश्चरित्वा तु कटिदेशं समाश्रयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 50,
    "avatarnika": ""
  },
  {
    "id": 20129460,
    "chapter_id": 6993,
    "verse_number": "10.51",
    "content_sanskrit": "एताश्चार्यो मया प्रोक्ता ललिताङ्गक्रियात्मकाः । स्थानान्यासां प्रवक्ष्यामि सर्वशस्त्रविमोक्षणे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 51,
    "avatarnika": ""
  },
  {
    "id": 20129461,
    "chapter_id": 6993,
    "verse_number": "10.52",
    "content_sanskrit": "वैष्णवं समपादं च वैशाखं मण्डलं तथा । प्रत्यालीढं तथालीढं स्थानान्येतानि षण् नृणां ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 52,
    "avatarnika": ""
  },
  {
    "id": 20129462,
    "chapter_id": 6993,
    "verse_number": "10.53",
    "content_sanskrit": "द्वौ तालावर्धतालश्च पादयोरन्तरं भवेत् । तयोः समस्थितस्त्वेकः त्र्यश्रः पक्षस्थितो ऽपरः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 53,
    "avatarnika": ""
  },
  {
    "id": 20129463,
    "chapter_id": 6993,
    "verse_number": "10.54",
    "content_sanskrit": "किञ्चिदञ्चितजङ्घं च सौष्ठवाङ्गपुरस्कृतम् । वैष्णवं स्थानमेतद्धि विष्णुरत्राधिदैवतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 54,
    "avatarnika": ""
  },
  {
    "id": 20129464,
    "chapter_id": 6993,
    "verse_number": "10.55",
    "content_sanskrit": "स्थानेनानेन कर्तव्यः संल्लापस्तु स्वभावजः । नानाकार्यान्तरापेतैर्नृभिरुत्तममध्यमैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 55,
    "avatarnika": ""
  },
  {
    "id": 20129465,
    "chapter_id": 6993,
    "verse_number": "10.56",
    "content_sanskrit": "चक्रस्य मोक्षणे चैव धारणे धनुषस्तथा । धैर्यदानाङ्गलीलासु तथा क्रोधे प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 56,
    "avatarnika": ""
  },
  {
    "id": 20129466,
    "chapter_id": 6993,
    "verse_number": "10.57",
    "content_sanskrit": "इदमेव विपर्यस्तं प्रणयक्रोध इष्यते । उपालम्भकृते चैव प्रणयोद्वेगयोस्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 57,
    "avatarnika": ""
  },
  {
    "id": 20129467,
    "chapter_id": 6993,
    "verse_number": "10.58",
    "content_sanskrit": "शङ्कासूयोग्रताचिन्तामतिस्मृतिषु चैव हि । दैन्ये चपलतायोगे गर्वाभीष्टेषु शक्तिषु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 58,
    "avatarnika": ""
  },
  {
    "id": 20129468,
    "chapter_id": 6993,
    "verse_number": "10.59",
    "content_sanskrit": "शृङ्गाराद्भुतबीभत्सवीरप्राधान्ययोजितम् । समपादे समौ पादौ तालमात्रान्तरस्थितौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 59,
    "avatarnika": ""
  },
  {
    "id": 20129469,
    "chapter_id": 6993,
    "verse_number": "10.60",
    "content_sanskrit": "स्वभावसौष्ठवोपेतौ ब्रह्मा चात्राधिदैवतम् । अनेन कार्यं स्थानेन विप्रमङ्गलधारणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 60,
    "avatarnika": ""
  },
  {
    "id": 20129470,
    "chapter_id": 6993,
    "verse_number": "10.61",
    "content_sanskrit": "रूपणे पक्षिणां चैव वरं कौतुकमेव च । स्वस्थानं स्यन्दनस्थानां विमानस्थायिनामपि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 61,
    "avatarnika": ""
  },
  {
    "id": 20129471,
    "chapter_id": 6993,
    "verse_number": "10.62",
    "content_sanskrit": "लिङ्गस्थानां व्रतस्थानां स्थानमेतत्तु कारयेत् । तालास्त्रयो ऽर्धतालश्च पादयोरन्तरं भवेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 62,
    "avatarnika": ""
  },
  {
    "id": 20129472,
    "chapter_id": 6993,
    "verse_number": "10.63",
    "content_sanskrit": "तालांस्त्रीनर्धतालांश्च निषण्णोरुं प्रकल्पयेत् । त्र्यश्रौ वक्षःस्थितौ चैव तत्र पादो प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 63,
    "avatarnika": ""
  },
  {
    "id": 20129473,
    "chapter_id": 6993,
    "verse_number": "10.64",
    "content_sanskrit": "वैशाखस्थानमेतद्धि स्कन्दश्चात्राधिदैवतम् । स्थानेनानेन कर्तव्यमश्वानां वाहनं बुधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 64,
    "avatarnika": ""
  },
  {
    "id": 20129474,
    "chapter_id": 6993,
    "verse_number": "10.65",
    "content_sanskrit": "व्यायामनिर्गमश्चैव स्थूलपक्षिनिरूपणम् । शराणां च समुत्क्षेपो व्यायामकरणे तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 65,
    "avatarnika": ""
  },
  {
    "id": 20129475,
    "chapter_id": 6993,
    "verse_number": "10.66",
    "content_sanskrit": "रेचकेषु च कर्तव्यमिदमेव प्रयोक्तृभिः । ऐन्द्रे तु मण्डले पादौ चतुस्तालान्तरस्थितौ ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 66,
    "avatarnika": ""
  },
  {
    "id": 20129476,
    "chapter_id": 6993,
    "verse_number": "10.67",
    "content_sanskrit": "त्र्यश्रौ पक्षःस्थितौ चैव कटिजानू समौ तथा । धनुर्वज्रासिशस्त्राणि मण्डलेन प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 67,
    "avatarnika": ""
  },
  {
    "id": 20129477,
    "chapter_id": 6993,
    "verse_number": "10.68",
    "content_sanskrit": "वाहनं कुञ्जराणां तु स्थूलपक्षिनिरूपणम् । अस्यैव दक्षिणं पादं पञ्च तालान् प्रसार्य तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 68,
    "avatarnika": ""
  },
  {
    "id": 20129478,
    "chapter_id": 6993,
    "verse_number": "10.69",
    "content_sanskrit": "आलीढं स्थानकं कुर्याद् रुद्रश्चात्राधिदैवतम् । अनेन कार्यं स्थानेन वीररौद्रकृतं तु यत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 69,
    "avatarnika": ""
  },
  {
    "id": 20129479,
    "chapter_id": 6993,
    "verse_number": "10.70",
    "content_sanskrit": "उत्तरोत्तरसञ्जल्पो रोषामर्षकृतस्तु यः । मल्लानाञ्चैव संफेटः शत्रूणां च निरूपणम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 70,
    "avatarnika": ""
  },
  {
    "id": 20129480,
    "chapter_id": 6993,
    "verse_number": "10.71",
    "content_sanskrit": "तथाभिद्रवणं चैव शस्त्राणां चैव मोक्षणम् । कुञ्चितं दक्षिणं कृत्वा वामं पादं प्रसार्य च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 71,
    "avatarnika": ""
  },
  {
    "id": 20129481,
    "chapter_id": 6993,
    "verse_number": "10.72",
    "content_sanskrit": "आलीढपरिवर्तस्तु प्रत्यालीढमिति स्मृतम् । आलीढसंहितं शस्त्रं प्रत्यालीढेन मोक्षयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 72,
    "avatarnika": ""
  },
  {
    "id": 20129482,
    "chapter_id": 6993,
    "verse_number": "10.73",
    "content_sanskrit": "नानाशस्त्रविमोक्षो हि कार्यो ऽनेन प्रयोक्तृभिः । न्यायाच्चैव हि विज्ञेयाश्चत्वारः शस्त्रमोक्षणे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 73,
    "avatarnika": ""
  },
  {
    "id": 20129483,
    "chapter_id": 6993,
    "verse_number": "10.74",
    "content_sanskrit": "भारतः सात्वतश्चैव वार्षगण्यो ऽथ कैशिकः । भारते तु कटीच्छेद्यं पादच्छेद्यं तु सात्वते ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 74,
    "avatarnika": ""
  },
  {
    "id": 20129484,
    "chapter_id": 6993,
    "verse_number": "10.75",
    "content_sanskrit": "वक्षसो वार्षगण्ये तु शिरश्छेद्यन्तु कैशिके । एभिः प्रयोक्तृभिर्न्यायैर्नानाचारीसमुत्थितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 75,
    "avatarnika": ""
  },
  {
    "id": 20129485,
    "chapter_id": 6993,
    "verse_number": "10.76",
    "content_sanskrit": "प्रविचार्य प्रयोक्तव्यं नानाशस्त्रविमोक्षणे । न्यायाश्रितैरङ्गहारैर्न्यायाच्चैव समुत्थितैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 76,
    "avatarnika": ""
  },
  {
    "id": 20129486,
    "chapter_id": 6993,
    "verse_number": "10.77",
    "content_sanskrit": "यस्माद् युद्धानि वर्तन्ते तस्मान्न्यायाः प्रकीर्तिताः । वामहस्ते विनिक्षिप्य खेटकं शस्त्रफेटकम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 77,
    "avatarnika": ""
  },
  {
    "id": 20129487,
    "chapter_id": 6993,
    "verse_number": "10.78",
    "content_sanskrit": "शस्त्रमादाय हस्तेन प्रविचारमथाचरेत् । प्रसार्य च करौ सम्यक् पुनराक्षिप्य चैव हि ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 78,
    "avatarnika": ""
  },
  {
    "id": 20129488,
    "chapter_id": 6993,
    "verse_number": "10.79",
    "content_sanskrit": "खेटकं भ्रामयेत् पश्चात् पार्श्वात् पार्श्वमथापि च । शिरःपरिगमश्चापि कार्यः शस्त्रेण योक्तृभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 79,
    "avatarnika": ""
  },
  {
    "id": 20129489,
    "chapter_id": 6993,
    "verse_number": "10.80",
    "content_sanskrit": "कपोलस्यान्तरे वापि शस्त्रस्योद्वेष्टनं तथा । पुनश्च खड्गहस्तेन ललितोद्वेष्टितेन च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 80,
    "avatarnika": ""
  },
  {
    "id": 20129490,
    "chapter_id": 6993,
    "verse_number": "10.81",
    "content_sanskrit": "खेटकेन च कर्तव्यः शिरःपरिगमो बुधैः । एवं प्रचारः कर्तव्यो भारते शस्त्रमोक्षणे ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 81,
    "avatarnika": ""
  },
  {
    "id": 20129491,
    "chapter_id": 6993,
    "verse_number": "10.82",
    "content_sanskrit": "सात्वते च प्रवक्ष्यामि प्रविचारं यथाविधिः । स एव प्रविचारस्तु खड्गखेटकयोः स्मृतः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 82,
    "avatarnika": ""
  },
  {
    "id": 20129492,
    "chapter_id": 6993,
    "verse_number": "10.83",
    "content_sanskrit": "केवलं पृष्ठतः शस्त्रं कर्तव्यं खलु सात्वते । गतिश्च वार्षगण्ये ऽपि सात्वतेन क्रमेण तु ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 83,
    "avatarnika": ""
  },
  {
    "id": 20129493,
    "chapter_id": 6993,
    "verse_number": "10.84",
    "content_sanskrit": "शस्त्रखेटकयोश्चापि भ्रमणं संविधीयते । शिरः परिगमस्तद्वच्छस्त्रस्येह भवेत्तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 84,
    "avatarnika": ""
  },
  {
    "id": 20129494,
    "chapter_id": 6993,
    "verse_number": "10.85",
    "content_sanskrit": "उरस्युद्वेष्टनं कार्यं शस्त्रस्यांशे ऽथवा पुनः । भारते प्रविचारो ऽयं कर्तव्यः स तु कैशिके ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 85,
    "avatarnika": ""
  },
  {
    "id": 20129495,
    "chapter_id": 6993,
    "verse_number": "10.86",
    "content_sanskrit": "विभ्रमय्य तथा शस्त्रं केवलं मूर्ध्नि पातयेत् । प्रविचारा प्रयोक्तव्या ह्येवमेते ऽङ्गलीलया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 86,
    "avatarnika": ""
  },
  {
    "id": 20129496,
    "chapter_id": 6993,
    "verse_number": "10.87",
    "content_sanskrit": "धनुर्वज्रासिशस्त्राणां प्रयोक्तव्या विमोक्षणे । न भेद्यं नापि तु च्छेद्यं न चापि रुधिरस्रुतिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 87,
    "avatarnika": ""
  },
  {
    "id": 20129497,
    "chapter_id": 6993,
    "verse_number": "10.88",
    "content_sanskrit": "रङ्गे प्रहरणे कार्यो न चापि व्यक्तघातनम् । संज्ञामात्रेण कर्तव्यं शस्त्राणां मोक्षणं बुधैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 88,
    "avatarnika": ""
  },
  {
    "id": 20129498,
    "chapter_id": 6993,
    "verse_number": "10.89",
    "content_sanskrit": "अथवाभिनयोपेतं कुर्याच्छेद्यं विधानतः । अङ्गसौष्ठवसंयुक्तैरङ्गहारैर्विभूषितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 89,
    "avatarnika": ""
  },
  {
    "id": 20129499,
    "chapter_id": 6993,
    "verse_number": "10.90",
    "content_sanskrit": "व्यायामं कारयेत् सम्यक् लयतालसमन्वितम् । सौष्ठवे हि प्रयत्नस्तु कार्यो व्यायामसेविभिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 90,
    "avatarnika": ""
  },
  {
    "id": 20129500,
    "chapter_id": 6993,
    "verse_number": "10.91",
    "content_sanskrit": "सौष्ठवे लक्षणं प्रोक्तं वर्तनाक्रमयोजितम् । शोभा सर्वैव नित्यं हि सौष्ठवं समुपाश्रिता ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 91,
    "avatarnika": ""
  },
  {
    "id": 20129501,
    "chapter_id": 6993,
    "verse_number": "10.92",
    "content_sanskrit": "अचञ्चलमकुब्जं चासन्नगात्रमथापि च । नात्युच्चं चलपादञ्च सौष्ठवाङ्गं प्रयोजयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 92,
    "avatarnika": ""
  },
  {
    "id": 20129502,
    "chapter_id": 6993,
    "verse_number": "10.93",
    "content_sanskrit": "कटी कर्णसमा यत्र कूर्परांसशिरस्तथा । समुन्नतमुरश्चैव सौष्ठवं नाम तद्भवेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 93,
    "avatarnika": ""
  },
  {
    "id": 20129503,
    "chapter_id": 6993,
    "verse_number": "10.94",
    "content_sanskrit": "नहि सौष्ठवहीनाङ्गः शोभते नाट्यनृत्तयोः । अत्र नित्यं प्रयत्नो हि विधेयो मध्यमोत्तमैः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 94,
    "avatarnika": ""
  },
  {
    "id": 20129504,
    "chapter_id": 6993,
    "verse_number": "10.95",
    "content_sanskrit": "नाट्यं नृत्तं च सर्वं हि सौष्ठवे संप्रतिष्ठितम् । कटीनामभिचरौ हस्तौ वक्षश्चैव समुन्नतम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 95,
    "avatarnika": ""
  },
  {
    "id": 20129505,
    "chapter_id": 6993,
    "verse_number": "10.96",
    "content_sanskrit": "वैष्णवं स्थानमित्यङ्गं चतुरश्रमुदाहृतम् । परिमार्जनमादानं सन्धानं मोक्षणम् तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 96,
    "avatarnika": ""
  },
  {
    "id": 20129506,
    "chapter_id": 6993,
    "verse_number": "10.97",
    "content_sanskrit": "धनुषस्तु प्रयोक्तव्यं करणं तु चतुर्विधम् । संमार्जनं परामर्षमादानं ग्रहणं क्रिया ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 97,
    "avatarnika": ""
  },
  {
    "id": 20129507,
    "chapter_id": 6993,
    "verse_number": "10.98",
    "content_sanskrit": "सन्धानं शरविन्यासो विक्षेपो मोक्षणं भवेत् । तैलाभ्यक्तेन गात्रेण यवागूमृदितेन च ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 98,
    "avatarnika": ""
  },
  {
    "id": 20129508,
    "chapter_id": 6993,
    "verse_number": "10.99",
    "content_sanskrit": "व्यायामं कारयेत् श्रीमान् भित्तावाकालिके तथा । योग्यायां मातृका भित्तिस्तस्माद्भित्तिं समाश्रयेत् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 99,
    "avatarnika": ""
  },
  {
    "id": 20129509,
    "chapter_id": 6993,
    "verse_number": "10.100",
    "content_sanskrit": "भित्तौ प्रसारिताङ्गन्तु व्यायामं कारयेन्नरम् । बलार्थं च निषेवेत नस्यं बस्तिविधिं तथा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 100,
    "avatarnika": ""
  },
  {
    "id": 20129510,
    "chapter_id": 6993,
    "verse_number": "10.101",
    "content_sanskrit": "स्निग्धान्यन्यानि च तथा रसकं पानकं तथा । आहारे ऽधिष्ठिताः प्राणाः प्राणे योग्याः प्रतिष्ठिताः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 101,
    "avatarnika": ""
  },
  {
    "id": 20129511,
    "chapter_id": 6993,
    "verse_number": "10.102",
    "content_sanskrit": "तस्माद्योग्याप्रसिध्यर्थमाहारे यत्नवान् भवेत् । अशुद्धकायं प्रक्लान्तमतीवक्षुत्पिपासितम् ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 102,
    "avatarnika": ""
  },
  {
    "id": 20129512,
    "chapter_id": 6993,
    "verse_number": "10.103",
    "content_sanskrit": "अतिपीतं तथा भुक्तं व्यायामं नैव कारयेत् । अचलैर्मधुरैगात्रैश्चतुरश्रेण वक्षसा ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 103,
    "avatarnika": ""
  },
  {
    "id": 20129513,
    "chapter_id": 6993,
    "verse_number": "10.104",
    "content_sanskrit": "व्यायामं कारयेद्धीमान् नरमङ्गक्रियात्मकम् । एवं व्यायामसंयोगे कार्यश्चारीकृतो विधिः ॥",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 104,
    "avatarnika": ""
  },
  {
    "id": 20129514,
    "chapter_id": 6993,
    "verse_number": "10.105",
    "content_sanskrit": "अत ऊर्ध्वं प्रवक्ष्यामि मण्डलानां विकल्पनम्",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 105,
    "avatarnika": ""
  },
  {
    "id": 20129515,
    "chapter_id": 6993,
    "verse_number": "10.106",
    "content_sanskrit": "इति भारतीये नाट्यशास्त्रे चारीविधानो नाम दशमो ऽध्यायः",
    "padaccheda": "",
    "anvaya": "",
    "meaning_sanskrit": "",
    "meaning_english": "",
    "audio_url": null,
    "display_order": 106,
    "avatarnika": ""
  }
]