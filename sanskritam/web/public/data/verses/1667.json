[{"id": 2030540, "chapter_id": 1667, "verse_number": "३-३०५-०x", "content_sanskrit": "कुन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030541, "chapter_id": 1667, "verse_number": "३-३०५-१", "content_sanskrit": "ब्राह्मणं यन्त्रिता राजन्नुपस्थास्यामि पूजया।\nयथाप्रतिज्ञं राजेन्द्रन च मिथ्या ब्रवीम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030542, "chapter_id": 1667, "verse_number": "३-३०५-२", "content_sanskrit": "एष चैव स्वभावो मे पूजयेयं द्विजानिति।\nतव चैव प्रियं कार्यं श्रेयश्च परमं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030543, "chapter_id": 1667, "verse_number": "३-३०५-३", "content_sanskrit": "यद्येवैष्यति सायाह्ने यदि प्रातरथो निशि।\nयद्यर्धरात्रे भगवान्न मे कोपं करिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030544, "chapter_id": 1667, "verse_number": "३-३०५-४", "content_sanskrit": "लाभो ममैष राजेन्द्र यद्वैपूजयितुं द्विजान्।\nआदेशे तव तिष्ठन्ती हितं कुर्यां नरोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030545, "chapter_id": 1667, "verse_number": "३-३०५-५", "content_sanskrit": "विस्रब्धो भवराजेन्द्र न व्यलीकं द्विजोत्तमः।\nवसन्प्राप्स्यति ते गेहे सत्यमेतद्ब्रवीमि ते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030546, "chapter_id": 1667, "verse_number": "३-३०५-६", "content_sanskrit": "यत्प्रियं च द्विजस्यास्य हितं चैव तवानघ।\nयतिष्यामि तथा राजन्व्येतु ते मानसो ज्वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030547, "chapter_id": 1667, "verse_number": "३-३०५-७", "content_sanskrit": "ब्राह्मणा हि महाभागाः पूजिताः पृथिवीपते।\nतारणाय समर्थाः स्युर्विपरीते वधाय च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030548, "chapter_id": 1667, "verse_number": "३-३०५-८", "content_sanskrit": "रसाऽहमेतद्विजानन्ती तोषयिष्ये द्विजोत्तमम्।\nन मत्कृतेव्यथां राजन्प्राप्स्यसि द्विजसत्तमात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030549, "chapter_id": 1667, "verse_number": "३-३०५-९", "content_sanskrit": "अपराधेऽपि राजेन्द्र राज्ञामश्रेयसे द्विजाः।\nभवन्ति च्यवनो यद्वत्सुकन्यायाः कृते पुरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030550, "chapter_id": 1667, "verse_number": "३-३०५-१०", "content_sanskrit": "नियमेन परेणाहमुपस्थास्ये द्विजोत्तमम्।\nयथा त्वया नरेन्द्रेदं भापितं ब्राह्मणं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030551, "chapter_id": 1667, "verse_number": "३-३०५-११", "content_sanskrit": "एवं ब्रुवन्तीं बहुशः परिष्वज्य समर्थ्य च।\nइतिचेति च क्रतव्यं राजा सर्वमथादिशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030552, "chapter_id": 1667, "verse_number": "३-३०५-१२", "content_sanskrit": "एवमेतत्त्वया भद्रे कर्तव्यमविशङ्कया।\nमद्धितार्थं तथाऽऽत्मार्थंकुलार्थं चाप्यनिन्दिते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030553, "chapter_id": 1667, "verse_number": "३-३०५-१३", "content_sanskrit": "एवमुक्त्वा तु तां कन्यां कुन्तिभोजो महायशाः।\nपृथां परिददौ तस्मै द्विजाय द्विजवत्सलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030554, "chapter_id": 1667, "verse_number": "३-३०५-१४", "content_sanskrit": "इयं ब्रह्मन्मम सुता बाला सुखविवर्धिता।\nअपराध्येत यत्किंचिन्न कार्यं हृदि तत्त्वया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030555, "chapter_id": 1667, "verse_number": "३-३०५-१५", "content_sanskrit": "द्विजातयो महाभागा वृद्धबालतपस्विषु।\nभवन्त्यक्रोधनाः प्रायो ह्यपराद्धेषु नित्यदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030556, "chapter_id": 1667, "verse_number": "३-३०५-१६", "content_sanskrit": "सुमहत्यपराधेऽपि क्षान्तिः कार्या द्विजातिभिः।\nयथाशक्ति यथोत्साहं पूजा ग्राह्या द्विजोत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030557, "chapter_id": 1667, "verse_number": "३-३०५-१७", "content_sanskrit": "तथेति ब्राह्मणेनोक्ते स राजा प्रीतमानसः।\nहंसचन्द्रांशुसंकाशं गृहमस्मै न्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030558, "chapter_id": 1667, "verse_number": "३-३०५-१८", "content_sanskrit": "तत्राग्निशरणे क्लृप्तमासनं तस्य भानुमत्।\nआहारादि च सर्वं तत्तथैव प्रत्यवेदयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030559, "chapter_id": 1667, "verse_number": "३-३०५-१९", "content_sanskrit": "निक्षिप्य राजपुत्री तु तन्द्रीं मानं तथैव च।\nआतस्थे परमं यत्नं ब्राह्मणस्याभिराधने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030560, "chapter_id": 1667, "verse_number": "३-३०५-२०", "content_sanskrit": "तत्रसा ब्राह्मणं गत्वा पृथा शौचपरा सती।\nविधिवत्परिचारार्हं देववत्पर्यतोषयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030561, "chapter_id": 1667, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि कुण्डलाहरणपर्वणि पञ्चाधिकत्रिशततमोऽध्यायः ॥ ३०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]