[{"id": 2022451, "chapter_id": 1473, "verse_number": "३-१११-०x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2022452, "chapter_id": 1473, "verse_number": "३-१११-१", "content_sanskrit": "एषा देवनदी पुण्या कौशिकी भरतर्षभ।\nविश्वामित्राश्रमो रम्य एष चात्र प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2022453, "chapter_id": 1473, "verse_number": "३-१११-२", "content_sanskrit": "आश्रमश्चैव पुण्याख्यः काश्यपस्य महात्मनः।\nऋश्यशृङ्गः सुतो यस् तपस्वी संयतेन्द्रियः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2022454, "chapter_id": 1473, "verse_number": "३-१११-३", "content_sanskrit": "तपसो यः प्रभावेन वर्षयामास वासवम्।\nअनावृष्ठ्यां भयाद्यस्य ववर्ष बलवृत्रहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2022455, "chapter_id": 1473, "verse_number": "३-१११-४", "content_sanskrit": "मृग्यां जातः स तेजस्वी काश्यपस्य सुतः प्रभुः।\nविषये लोमपादस्य यश्चकाराद्भुतं महत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2022456, "chapter_id": 1473, "verse_number": "३-१११-५", "content_sanskrit": "निर्वर्तितेषु सस्येषु यस्मै शान्तां ददौ नृपः।\nलोमपादो दुहितरं सावित्रीं सविता यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2022457, "chapter_id": 1473, "verse_number": "३-१११-६x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2022458, "chapter_id": 1473, "verse_number": "३-१११-६", "content_sanskrit": "ऋश्यशृङ्गः कथं मृग्यामुत्पन्नः काश्यपात्मजः।\nविरुद्धयोनिसंसर्गः कथं च तपसा युतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2022459, "chapter_id": 1473, "verse_number": "३-१११-७", "content_sanskrit": "किमर्थं च भयाच्छक्रस्तस्य बालस्य धीमतः।\nअनावृष्ट्यां प्रवृत्तायां ववर्ष बलवृत्रहा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2022460, "chapter_id": 1473, "verse_number": "३-१११-८", "content_sanskrit": "कथंरूपा च सा शान्ता राजपुत्री पतिव्रता।\nलोभयामास या चेतो मृगभूस्य तस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2022461, "chapter_id": 1473, "verse_number": "३-१११-९", "content_sanskrit": "लोमपादश्च राजर्षिर्यदाऽश्रूयत धार्मिकः।\nकथं वै विषये तस्य नावर्षत्पाकशासनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2022462, "chapter_id": 1473, "verse_number": "३-१११-१०", "content_sanskrit": "एतन्मे भगवन्सर्वं विस्तरेण यथातथम्।\nवक्तुमर्हसि शुश्रूषोर्ऋश्यशृङ्गस् चेष्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2022463, "chapter_id": 1473, "verse_number": "३-१११-११x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2022464, "chapter_id": 1473, "verse_number": "३-१११-११", "content_sanskrit": "विभाण्डकस्य ब्रह्मर्षेस्तपसा भावितात्मनः।\nअमोघवीर्यस्य सतः प्रजापतिसमद्युतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2022465, "chapter_id": 1473, "verse_number": "३-१११-१२", "content_sanskrit": "शृणु पुत्रो यथा जात ऋश्यशृङ्गः प्रतापवान्।\nमहाह्रदे महातेजा बालः स्थविरसंभतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2022466, "chapter_id": 1473, "verse_number": "३-१११-१३", "content_sanskrit": "महाह्रदं समासाद्य काश्यपस्तपसि स्थितः।\nदीर्घकालं रिश्रान्त ऋषिर्देवर्षिसंमितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2022467, "chapter_id": 1473, "verse_number": "३-१११-१४", "content_sanskrit": "तस्य रेतः प्रचस्कन्द दृष्ट्वाऽप्सरसमुर्वशीम्।\nअप्सूपस्पृशतो राजन्मृगी तच्चापिबत्तदा।\nसह तोयेन तृषिता गर्भिणी चाभवत्ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2022468, "chapter_id": 1473, "verse_number": "३-१११-१५", "content_sanskrit": "सा पुरोक्ता भगवता ब्रह्मणा लोककर्तृणा।\nदेवकन्या मृगी भूत्वा मुनिं सूय विमोक्ष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2022469, "chapter_id": 1473, "verse_number": "३-१११-१६", "content_sanskrit": "अमोघत्वाद्विधेश्चैव भावित्वाद्दैवनिर्मितात्।\nतस्यां मृग्यां समभवत्तस्व पुत्रो महानृषिः।\nऋश्यशृङ्गस्तपोनित्यो वन एवाभ्यवर्धत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2022470, "chapter_id": 1473, "verse_number": "३-१११-१७", "content_sanskrit": "तस्य शृङ्गं शिरसि वै राजन्नासीन्महात्मनः।\nतेनर्श्यशृङ्ग इत्येवं तदा स प्रथितोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2022471, "chapter_id": 1473, "verse_number": "३-१११-१८", "content_sanskrit": "न तेन दृष्टपूर्वोऽन्यः पितुरन्यत्रमानुषः।\nतस्मात्तस्य मनो नित्यं ब्रह्मचर्येऽभवन्नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2022472, "chapter_id": 1473, "verse_number": "३-१११-१९", "content_sanskrit": "एतस्मिन्नेव काले तु सखा दशरशस्य वै।\nकलोमपाद इतिख्यातो ह्यङ्गानामीश्वरोऽभवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2022473, "chapter_id": 1473, "verse_number": "३-१११-२०", "content_sanskrit": "तेन कामः कृतो मिथ्या ब्राह्मणेभ्य इति श्रुतिः।\n`दैवोपहतसत्त्वेन धर्मज्ञेनापि भारत।\nस ब्राह्मणैः परित्यक्तस्तदा भरतसत्तम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2022474, "chapter_id": 1473, "verse_number": "३-१११-२१", "content_sanskrit": "पुरोहितापचाराच्च तस्य राज्ञो यदच्छया।\nन ववर्ष सहस्राक्षस्ततोऽपीड्यन्त वै प्रजाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2022475, "chapter_id": 1473, "verse_number": "३-१११-२२", "content_sanskrit": "स ब्राह्मणान्पर्यपृच्छत्तपोयुक्तान्मनीषिणः।\nप्रवर्षणे सुरेन्द्रस्य समर्थान्पृथिवीपते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2022476, "chapter_id": 1473, "verse_number": "३-१११-२३", "content_sanskrit": "कथं प्रवर्षेत्पर्जन्य उपायः परिमृश्यताम्।\nतमूचुश्चोदितास्ते तु स्वमतानि मनीषिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2022477, "chapter_id": 1473, "verse_number": "३-१११-२४", "content_sanskrit": "तत्र त्वेको रमुनिवरस्तं राजानमुवाच ह।\nकुपितास्तव राजेन्द्र ब्राह्मणा निष्कृतिं चर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2022478, "chapter_id": 1473, "verse_number": "३-१११-२५", "content_sanskrit": "ऋश्यशृङ्गं मुनिसुतमानयस्व च पार्थिव।\nऐणेयमनभिज्ञं च नारीणामार्जवे रतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2022479, "chapter_id": 1473, "verse_number": "३-१११-२६", "content_sanskrit": "स चेदवतरेद्राजन्विषयं ते महातपाः।\nसद्यः प्रवर्षेत्पर्जन्य इति मे नास्ति संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2022480, "chapter_id": 1473, "verse_number": "३-१११-२७", "content_sanskrit": "एतच्छ्रुत्वा वचो राजन्कृत्वा निष्कृतिमात्मनः।\nस गत्वा पुनरागच्छत्प्रसन्नेषु द्विजातिषु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2022481, "chapter_id": 1473, "verse_number": "३-१११-२८", "content_sanskrit": "राजानमागतं ज्ञात्वा प्रतिसंजगृहुः प्रजाः।\n`स च ता प्रतिजग्राह पितेव हितकृत्सदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2022482, "chapter_id": 1473, "verse_number": "३-१११-२९", "content_sanskrit": "ततोऽङ्गपतिराहूय सचिवान्मन्त्रकोविदान्।\nऋश्यशृङ्गागमे यत्नमकरोन्मन्त्रनिश्चये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2022483, "chapter_id": 1473, "verse_number": "३-१११-३०", "content_sanskrit": "सोऽध्यगच्छदुपायं तु तैरमात्यैः सहाच्युतः।\nशास्त्रज्ञैरलमर्थज्ञौर्नीत्यां च परिनिष्ठितैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2022484, "chapter_id": 1473, "verse_number": "३-१११-३१", "content_sanskrit": "ततश्चानाययामास वारमुख्या महीपतिः।\nवेश्याः सर्वत्रनिष्णातास्ता उवाच स पार्थिवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2022485, "chapter_id": 1473, "verse_number": "३-१११-३२", "content_sanskrit": "ऋश्यशृङ्गमृषेः पुत्रमानयध्वमुपायतः।\nलोभयित्वाऽभिविश्चास्य विषयं मम शोभनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2022486, "chapter_id": 1473, "verse_number": "३-१११-३३", "content_sanskrit": "ता राजभयभीताश्च शापभीताश्च योषितः।\nअशक्यमूचुस्तत्कार्यं विषण्णा गतचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2022487, "chapter_id": 1473, "verse_number": "३-१११-३४", "content_sanskrit": "तत्र त्वेका जरद्योषा राजानमिदमब्रवीत्।\nप्रयतिष्ये महाराज तमानेतुं तपोधनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2022488, "chapter_id": 1473, "verse_number": "३-१११-३५", "content_sanskrit": "अभिप्रेतांस्तु मे कामांस्त्वमनुज्ञातुमर्हसि।\nततः शक्ष्याम्यानयितुमृश्यशृङ्गमृषेः सुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2022489, "chapter_id": 1473, "verse_number": "३-१११-३६", "content_sanskrit": "तस्याः सर्वमभिप्रेतमन्वजानात्स पार्थिवः।\nधनं च प्रददौ भूरि रत्नानि विविधानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2022490, "chapter_id": 1473, "verse_number": "३-१११-३७", "content_sanskrit": "ततो रूपेण सपन्ना वयसा च महीपते।\nस्त्रिय आदाय काश्चित्सा जगाम वनमञ्जसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2022491, "chapter_id": 1473, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि एकादशाधिकशततमोऽध्यायः ॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]