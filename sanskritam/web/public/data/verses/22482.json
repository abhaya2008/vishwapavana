[{"id": 7002482000, "chapter_id": 22482, "verse_number": "१-१४४-१", "content_sanskrit": "सुमन्तुरुवाच ।\nअथाजगाम भगवान्व्यासो द्वारवतीं पुरीम् ।\nद्रष्टुं नारायणं देवं शङ्खचक्रगदाधरम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002482001, "chapter_id": 22482, "verse_number": "१-१४४-२", "content_sanskrit": "तमागतमृषिं दृष्ट्वा वासुदेवो विशांपते ।\nअभ्युत्थाय महातेजाः पूजयामास भारत ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002482002, "chapter_id": 22482, "verse_number": "१-१४४-३", "content_sanskrit": "स्वयमेवासनं दत्त्वा पाद्यमर्घ्यं तथैव च ।\nपप्रच्छ प्रयतो भूत्वा व्यासं सत्यवतीसुतम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002482003, "chapter_id": 22482, "verse_number": "१-१४४-४", "content_sanskrit": "य एते भोजका विप्रा आनीता मत्सुतेन वै ।\nशाकद्वीपमितो गत्वा ज्ञानिनो मोक्षगामिनः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002482004, "chapter_id": 22482, "verse_number": "१-१४४-५", "content_sanskrit": "तान्दृष्ट्वा रूपतो विप्र प्रवेशात्कर्मतस्तथा ।\nकौतूहलं समुत्पन्नं हर्षश्च परमो मम ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002482005, "chapter_id": 22482, "verse_number": "१-१४४-६", "content_sanskrit": "कथमेते क्षणमपि तिष्ठन्ते पृथिवीतले ।\nयेषां रविः सदा पूज्यस्तेषां मुक्तिः सदा वसेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002482006, "chapter_id": 22482, "verse_number": "१-१४४-७", "content_sanskrit": "नागत्वा भोजकत्वं हि मोक्षमाप्नोति कश्चन ।\nइदं मे मनसो ब्रह्मन्सदा सम्प्रतिभाति वै ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002482007, "chapter_id": 22482, "verse_number": "१-१४४-८", "content_sanskrit": "व्यास उवाच ।\nएवमेव यथात्थ त्वं शङ्खचक्रगदाधर ।\nधन्या एते महात्मानो भोजका नात्र संशयः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002482008, "chapter_id": 22482, "verse_number": "१-१४४-९", "content_sanskrit": "ये पूजयन्ति सततं भानुमन्तं दिवाकरम् ।\nज्ञानिनः कर्मनिष्ठाश्च सदा मोक्षगतिं गताः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002482009, "chapter_id": 22482, "verse_number": "१-१४४-१०", "content_sanskrit": "यजन्ते सततं भानुं बलिपुष्पफलैस्तथा ।\nअन्नेनौषधिभिश्चैव आज्यहोमैश्च कृत्स्नशः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002482010, "chapter_id": 22482, "verse_number": "१-१४४-११", "content_sanskrit": "होमं च शाश्वतं कृत्वा परं होमं ततः श्रिताः ।\nपरहोमस्य करणात्पूतात्मानो ह्यकल्मषाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002482011, "chapter_id": 22482, "verse_number": "१-१४४-१२", "content_sanskrit": "विशन्ति परमां दिव्यां भास्करीं तैजसीं कलाम् ।\nकर्मणः साधने चैका तत्र चाग्नौ प्रतिष्ठिता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002482012, "chapter_id": 22482, "verse_number": "१-१४४-१३", "content_sanskrit": "वायुमार्गस्थिता व्योम्नि द्वितीयान्तः प्रकाशिका ।\nततः परं तृतीया तु तत्स्मृतं सूर्यमण्डले ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002482013, "chapter_id": 22482, "verse_number": "१-१४४-१४", "content_sanskrit": "मण्डलं तच्च सवितुर्दिव्यं ह्यजरमव्ययम् ।\nतस्याऽसौ पुरुषो मध्ये योऽसौ सदसदात्मकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002482014, "chapter_id": 22482, "verse_number": "१-१४४-१५", "content_sanskrit": "क्षराक्षरस्तु विज्ञेयो महासूर्यस्तथैव च ।\nनिष्कलः सकलश्चापि द्वौ च तस्य प्रकल्पितौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002482015, "chapter_id": 22482, "verse_number": "१-१४४-१६", "content_sanskrit": "अक्षरः सकलश्चैव सर्वभूतव्यवस्थितः ।\nसतत्त्वः सकलः प्रोक्तस्तत्त्वहीनस्तु निष्कलः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002482016, "chapter_id": 22482, "verse_number": "१-१४४-१७", "content_sanskrit": "तृणगुल्मलतावृक्षवृकसिंहद्विजाधिपान् ।\nसुरसिद्धमनुष्यांश्च स्थलजाञ्जलजान्हरेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002482017, "chapter_id": 22482, "verse_number": "१-१४४-१८", "content_sanskrit": "व्यवस्थितः स सर्वत्र सर्वेषामन्तरात्मनि ।\nयदा कल्पात्मकश्चैव द्वितीयां तनुमाश्रितः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002482018, "chapter_id": 22482, "verse_number": "१-१४४-१९", "content_sanskrit": "निष्कलस्तु सदा ज्ञेयः संस्थितस्तैजसीं कलाम् ।\nहिमं घर्मं च वर्षं च त्रैलोक्ये कुरुते सदा ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002482019, "chapter_id": 22482, "verse_number": "१-१४४-२०", "content_sanskrit": "द्वितीया या तनुस्तस्य अक्षरं तत्परं पदम् ।\nदेवयानं तु पन्थानं कर्मयोगेन संस्थिता ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002482020, "chapter_id": 22482, "verse_number": "१-१४४-२१", "content_sanskrit": "आदित्यसिद्धान्तरिताः साङ्ख्ययोगविदश्च ये ।\nतेऽभिगच्छन्ति तत्स्थानं स मोक्षः परिकीर्तितः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002482021, "chapter_id": 22482, "verse_number": "१-१४४-२२", "content_sanskrit": "निर्द्वन्द्वो निर्गमश्चैव तत्र गत्वा न शोचति ।\nवेदेषु ब्रह्म वदन्ति ध्यायन्ते तत्त्ववेदिनः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002482022, "chapter_id": 22482, "verse_number": "१-१४४-२३", "content_sanskrit": "अकारं तत्त्वतश्चापि ध्यायन्ते पुरुषोत्तम ।\nत्र्यक्षरं च तमोंकारं सार्धमात्रात्रये स्थितम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002482023, "chapter_id": 22482, "verse_number": "१-१४४-२४", "content_sanskrit": "वदन्ति चार्धमात्रस्थं मकारं व्यञ्जनात्मकम् ।\nध्यायन्ति ये मकारीयं ज्ञानं ते हि सदात्मकम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002482024, "chapter_id": 22482, "verse_number": "१-१४४-२५", "content_sanskrit": "मकारो भगवान्देवो भास्करः परिकीर्तितः ।\nमकारध्यानयोगाच्च मगा ह्येते प्रकीर्तिताः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002482025, "chapter_id": 22482, "verse_number": "१-१४४-२६", "content_sanskrit": "धूपमाल्यैर्युतश्चापि उपहारैस्तथैव च ।\nभोजयन्ति सहस्रांशुं तेन ते भोजकाः स्मृताः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]