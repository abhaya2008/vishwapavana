[{"id": 6000147000, "chapter_id": 10147, "verse_number": null, "content_sanskrit": "अथ नवमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000147001, "chapter_id": 10147, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.001.m4a", "display_order": 2}, {"id": 6000147002, "chapter_id": 10147, "verse_number": "७-९-१", "content_sanskrit": "एवं सुरादयः सर्वे ब्रह्मरुद्रपुरस्सराः।\nनोपेतुमशकन् मन्युसङ्ग्रहं सुदुरासदम्॥ ७/९/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.002.m4a", "display_order": 3, "topics": [{"text": "कुपितं नृसिहं शमयितुं ब्रह्मणा प्रेषितेन प्रह्लादेन श्रीनृसिंहस्तुतिः", "range": "१–५५"}]}, {"id": 6000147003, "chapter_id": 10147, "verse_number": "७-९-२", "content_sanskrit": "साक्षाच्छ्रीः प्रेषिता देवैर्दृष्ट्वा तन्महदद्भुतम्।\nअदृष्टाश्रुतपूर्वत्वात् सा नोपेयाय शङ्किता॥ ७/९/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.003.m4a", "display_order": 4}, {"id": 6000147004, "chapter_id": 10147, "verse_number": "७-९-३", "content_sanskrit": "प्रह्लादं प्रेषयामास ब्रह्माऽवस्थितमन्तिके।\nतात प्रशमयोपेहि स्वपित्रे कुपितं प्रभुम्॥ ७/९/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.004.m4a", "display_order": 5}, {"id": 6000147005, "chapter_id": 10147, "verse_number": "७-९-४", "content_sanskrit": "तथेति शनकै राजन् महाभागवतोऽर्भकः।\nउपेत्य भुवि कायेन ननाम विधृताञ्जलिः॥ ७/९/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.005.m4a", "display_order": 6}, {"id": 6000147006, "chapter_id": 10147, "verse_number": "७-९-५", "content_sanskrit": "स्वपादमूले पतितं तमर्भकं विलोक्य देवः कृपया परिप्लुतः।\nउत्थाप्य तच्छीर्ष्ण्यदधात् कराम्बुजं कालाहिनिर्दष्टधियां कृताभयम्॥ ७/९/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.006.m4a", "display_order": 7}, {"id": 6000147007, "chapter_id": 10147, "verse_number": "७-९-६", "content_sanskrit": "स तत्करस्पर्शधुताखिलाशुभः सपद्यभिव्यक्तपरात्मदर्शनः।\nतत्पादपद्मं हृदि निर्वृतो दधौ हृष्यत्तनुः क्लिन्नहृदश्रुलोचनः॥ ७/९/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.007.m4a", "display_order": 8}, {"id": 6000147008, "chapter_id": 10147, "verse_number": "७-९-७", "content_sanskrit": "अस्तौषीद् हरिमेकाग्रमनसा सुसमाहितः।\nप्रेमगद्गदया वाचा तन्न्यस्तहृदयेक्षणः॥ ७/९/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.008.m4a", "display_order": 9}, {"id": 6000147009, "chapter_id": 10147, "verse_number": null, "content_sanskrit": "प्रह्लाद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.009.m4a", "display_order": 10}, {"id": 6000147010, "chapter_id": 10147, "verse_number": "७-९-८", "content_sanskrit": "ब्रह्मादयः सुरगणाः मुनयोऽथ सिद्धाः सत्त्वैकतानमतयो वचसां प्रवाहैः।\nनान्तं परस्य परतोऽप्यधुनाऽपि यान्ति किं तोष्टुमर्हति स मे हरिरुग्रजातेः॥ ७/९/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.010.m4a", "display_order": 11}, {"id": 6000147011, "chapter_id": 10147, "verse_number": "७-९-९", "content_sanskrit": "मन्ये धनाभिजनरूपतपःश्रुतौजस्तेजःप्रभावबलपौरुषबुद्धियोगाः।\nनाराधनाय हि भवन्ति परस्य पुंसो भक्त्या तुतोष भगवान् ननु यूथपाय॥ ७/९/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.011.m4a", "display_order": 12}, {"id": 6000147012, "chapter_id": 10147, "verse_number": "७-९-१०", "content_sanskrit": "विप्राद् द्विषड्गुणयुतादरविन्दनाभपादारविन्दविमुखाच्छ्वपचं वरिष्ठम्।\nमन्ये तदर्पितमनोवचनात्मगेहप्राणः पुनाति सकलं न तु भूरिमानः॥ ७/९/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.012.m4a", "display_order": 13}, {"id": 6000147013, "chapter_id": 10147, "verse_number": "७-९-११", "content_sanskrit": "नैवात्मनः प्रभुरयं निजलाभपूर्णो मानं जनादविदुषः करुणो वृणीते।\nयद् यज्जनो भगवते विदधीत मानं तच्चात्मने प्रतिमुखस्य यथा मुखश्रीः॥ ७/९/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.013.m4a", "display_order": 14}, {"id": 6000147014, "chapter_id": 10147, "verse_number": "७-९-१२", "content_sanskrit": "तस्मादहं विगतविक्लव ईश्वरस्य सर्वात्मना न हि गृणामि यथामनीषम्।\nनीचोऽजया गुणविसर्गमनुप्रविष्टः पूयेत येन हि पुमाननुवर्णितेन॥ ७/९/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.014.m4a", "display_order": 15}, {"id": 6000147015, "chapter_id": 10147, "verse_number": "७-९-१३", "content_sanskrit": "सर्वे ह्यमी विधिकरास्तव सत्वधाम्नो ब्रह्मादयो वयमिवेश न चोद्विजन्तः।\nक्षेमाय भूतय उतात्मसुखाय चाऽस्य विक्रीडितं भगवतो रुचिरावतारैः॥ ७/९/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.015.m4a", "display_order": 16}, {"id": 6000147016, "chapter_id": 10147, "verse_number": "७-९-१४", "content_sanskrit": "तद् यच्छ मन्युमसुरश्च हतस्त्वयाऽद्य मोदेत साधुरपि वृश्चिकसर्पहत्या।\nलोकाश्च निर्वृतिमिताः प्रतियान्तु सर्वे रूपं नृसिंह विभवाय जनाः स्मरन्ति॥ ७/९/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.016.m4a", "display_order": 17}, {"id": 6000147017, "chapter_id": 10147, "verse_number": "७-९-१५", "content_sanskrit": "नाहं बिभेम्यजित तेऽतिभयानकास्य जिह्माग्निनेत्रभ्रुकुटीरभसोग्रदंष्ट्रात्।\nआन्त्रस्रजः क्षतजकेसरशङ्कुकर्णान्निर्ह्रादभीतदिगिभादरिभिन्नखाग्रात्॥ ७/९/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.017.m4a", "display_order": 18}, {"id": 6000147018, "chapter_id": 10147, "verse_number": "७-९-१६", "content_sanskrit": "त्रस्तोऽस्म्यहं कृपणवत्सल दुःसहोग्रसंसारचक्रकदनात् कृशतां प्रणीतः।\nबद्धः स्वकर्मभिरुशत्तम तेऽङ्घ्रिमूलं भीतापवर्गमरणं समियां कदा नु॥ ७/९/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.018.m4a", "display_order": 19}, {"id": 6000147019, "chapter_id": 10147, "verse_number": "७-९-१७", "content_sanskrit": "यस्मात् प्रियाप्रियवियोगसुयोगजन्मशोकाग्निना सकलयोनिषु दह्यमानः।\nदुःखौषधं तदपि दुःखमतद्धियाऽहं भूमन् भ्रमामि वद मे तव दास्ययोगम्॥ ७/९/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.019.m4a", "display_order": 20}, {"id": 6000147020, "chapter_id": 10147, "verse_number": "७-९-१८", "content_sanskrit": "सोऽहं प्रियस्य सुहृदः परदेवताया लीलाकथास्तव नृसिंह विरिञ्चगीताः।\nअञ्जस्तराम्यनुगृणन् गुणविप्रमुक्तो दुर्गाणि ते पदयुगालयहंससङ्गः॥ ७/९/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.020.m4a", "display_order": 21}, {"id": 6000147021, "chapter_id": 10147, "verse_number": "७-९-१९", "content_sanskrit": "बालस्य चेह शरणं पितरौ नृसिंह आर्तस्य चागदमुदन्वति मज्जतो नौः।\nतप्तस्य तर्पणविधिर्यदिहाञ्जसेष्टस्तद्वत्प्रभो तनुभृतां त्वदुपासकानाम्॥ ७/९/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.021.m4a", "display_order": 22}, {"id": 6000147022, "chapter_id": 10147, "verse_number": "७-९-२०", "content_sanskrit": "यस्मिन् यतो यर्हि च येन यस्य यस्मै यथा यमुत यस्त्वपरः परो वा।\nभावं करोति विकरोति पृथक् स्वभावः सञ्चोदितस्तदखिलं भवतः स्वरूपम्॥ ७/९/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.022.m4a", "display_order": 23}, {"id": 6000147023, "chapter_id": 10147, "verse_number": "७-९-२१", "content_sanskrit": "माया मनः सृजति कर्ममयं बलीयः कालेन चोदितगुणानुमतेन पुंसः।\nछन्दोमयं यदजयार्पितषोडशारं संसारचक्रमज कोऽतितरेत्त्वदन्यः॥ ७/९/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.023.m4a", "display_order": 24}, {"id": 6000147024, "chapter_id": 10147, "verse_number": "७-९-२२", "content_sanskrit": "स त्वं हि नित्यविजितात्मगुणः स्वधाम्ना कालो वशीकृतविसृज्यविसर्गशक्तिः।\nचक्रे विसृष्टमजयेश्वर षोडशारे निष्पीड्यमानमुपकर्ष विभो प्रपन्नम्॥ ७/९/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.024.m4a", "display_order": 25}, {"id": 6000147025, "chapter_id": 10147, "verse_number": "७-९-२३", "content_sanskrit": "दृष्टा मया दिवि विभोऽखिलधिष्ण्यपानामायुः श्रियो विभव इच्छति यान् जनोऽयम्।\nयेऽस्मत्पितुः कुपितहासविजृम्भितभ्रूविस्फूर्जितेन लुलिताः, स तु ते निरस्तः॥ ७/९/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.025.m4a", "display_order": 26}, {"id": 6000147026, "chapter_id": 10147, "verse_number": "७-९-२४", "content_sanskrit": "तस्मादमूस्तनुभृतामहमाशिषो ज्ञः आयुः श्रियं विभवमैन्द्रियमाविरिञ्चात्।\nनेच्छामि ते विलुलिता गुरुविक्रमेण कालात्मनोपनय मां निजभृत्यपार्श्वम्॥ ७/९/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.026.m4a", "display_order": 27}, {"id": 6000147027, "chapter_id": 10147, "verse_number": "७-९-२५", "content_sanskrit": "कुत्राशिषः श्रुतिसुखा मृगतृष्णरूपाः क्‍वेदं कलेवरमशेषरुजां विरोहम्।\nनिर्विद्यते न तु जनो यदपीह विद्वान् कामानलं मधुलवैः शमयन् दुरापैः॥ ७/९/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.027.m4a", "display_order": 28}, {"id": 6000147028, "chapter_id": 10147, "verse_number": "७-९-२६", "content_sanskrit": "क्‍वाहं रजःप्रभव ईश तमोऽधिकेऽस्मिन् जातः सुरेतरकुले क्‍व तवानुकम्पा।\nन ब्रह्मणो न तु भवस्य न वै रमाया यन्मेऽर्पितः शिरसि पद्मकरप्रसादः॥ ७/९/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.028.m4a", "display_order": 29}, {"id": 6000147029, "chapter_id": 10147, "verse_number": "७-९-२७", "content_sanskrit": "नैषा परावरमतिर्भवतो ननु स्यात् जन्तोर्यथाऽऽत्मसुहृदो जगतस्तथाऽपि।\nसंसेवया सुरतरोरिव ते प्रसादः सेवानुरूप उदयो न परावरत्वम्॥ ७/९/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.029.m4a", "display_order": 30}, {"id": 6000147030, "chapter_id": 10147, "verse_number": "७-९-२८", "content_sanskrit": "एवं जनं निपतितं प्रभवाहिकूपे कामाभिकाममनु यः प्रपतन् प्रसङ्गात्।\nकृत्वाऽऽत्मसात् सुरर्षिणा भगवन् गृहीतः सोऽहं कथं नु विसृजे तव भृत्यसेवाम्॥ ७/९/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.030.m4a", "display_order": 31}, {"id": 6000147031, "chapter_id": 10147, "verse_number": "७-९-२९", "content_sanskrit": "मत्प्राणरक्षणमनन्त पितुर्वधं च मन्ये स्वभृत्यऋषिवाक्यमृतं विधातुम्।\nखड्गं प्रगृह्य यदवोचदसद्विधित्सुस्त्वामीश्वरो मदपरोऽवतु कं हरामि॥ ७/९/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.031.m4a", "display_order": 32}, {"id": 6000147032, "chapter_id": 10147, "verse_number": "७-९-३०", "content_sanskrit": "एकस्त्वमेव जगदेतदमुष्य यत् त्वमाद्यन्तयोः पृथगवस्यसि मध्यतश्च।\nसृष्ट्वा गुणव्यतिकरं निजमाययेदं नानेव तैरवसितस्तदनुप्रविष्टः॥ ७/९/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.032.m4a", "display_order": 33}, {"id": 6000147033, "chapter_id": 10147, "verse_number": "७-९-३१", "content_sanskrit": "त्वं वा इदं सदसदीश भवांस्ततोऽन्यो माया यदात्मपरबुद्धिरियं ह्यपार्था।\nयद् यस्य जन्मनिधनं स्थितिरीक्षणं च तद् वै तदेव खलु कालवदुष्टितर्वोः॥ ७/९/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.033.m4a", "display_order": 34}, {"id": 6000147034, "chapter_id": 10147, "verse_number": "७-९-३२", "content_sanskrit": "न्यस्येदमात्मनि जगद् विलयाम्बुमध्ये शेषासनो निजसुखानुभवो निरीहः।\nयोगेन मीलितदृगात्मनि वीतनिद्रस्तुर्यः स्थितो ननु तमोऽनु गुणांश्च युङ्‍क्षे॥ ७/९/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.034.m4a", "display_order": 35}, {"id": 6000147035, "chapter_id": 10147, "verse_number": "७-९-३३", "content_sanskrit": "तस्यैव ते वपुरिदं निजकालशक्त्या सञ्चोदितं प्रकृतिधर्मिण आत्मगूढम्।\nअम्भस्यनन्तशयनाद्विरमत्समाधेः नाभेरभूत् स्वकणिकाद्वटवन्महाब्जम्॥ ७/९/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.035.m4a", "display_order": 36}, {"id": 6000147036, "chapter_id": 10147, "verse_number": "७-९-३४", "content_sanskrit": "तत्सम्भवः कविरतोऽन्यदपश्यमानस्त्वां बीजमात्मनि ततं स बहिर्विचिन्वन्।\nनाविन्ददब्दशतमप्सु निमज्जमानो जातेऽङ्कुरे कथमिहोपलभेत बीजम्॥ ७/९/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.036.m4a", "display_order": 37}, {"id": 6000147037, "chapter_id": 10147, "verse_number": "७-९-३५", "content_sanskrit": "स त्वात्मयोनिरतिविस्मित आश्रितोऽब्जं कालेन तीव्रतपसा परिशुद्धभावः।\nत्वामात्मनीश भुवि गन्धमिवातिसूक्ष्मं भूतेन्द्रियाशयमये विततं ददर्श॥ ७/९/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.037.m4a", "display_order": 38}, {"id": 6000147038, "chapter_id": 10147, "verse_number": "७-९-३६", "content_sanskrit": "एवं सहस्रवदनाङ्घ्रिशिरःकरोरुनासास्यकर्णनयनाभरणायुधाढ्यम्।\nमायामयं सदुपलक्षणसन्निवेशं दृष्ट्वा महापुरुषमाप मुदं विरिञ्चः॥ ७/९/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.038.m4a", "display_order": 39}, {"id": 6000147039, "chapter_id": 10147, "verse_number": "७-९-३७", "content_sanskrit": "तस्मै भवान् हयशिरस्तनुवं च बिभ्रद् वेदद्रुहावतिबलौ मधुकैटभाख्यौ।\nहत्वाऽनयत् श्रुतिगणांश्च रजस्तमश्च सत्त्वं तव प्रियतमां तनुमामनन्ति॥ ७/९/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.039.m4a", "display_order": 40}, {"id": 6000147040, "chapter_id": 10147, "verse_number": "७-९-३८", "content_sanskrit": "इत्थं नृतिर्यगृषिदेवझषावतारैर्लोकान् विभावयसि हंसि जगत्प्रतीपान्।\nधर्मं महापुरुष पासि युगानुवृत्तं छन्नः कलौ यदभवस्‍त्रियुगोऽथ स त्वम्॥ ७/९/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.040.m4a", "display_order": 41}, {"id": 6000147041, "chapter_id": 10147, "verse_number": "७-९-३९", "content_sanskrit": "नैतन्मनस्तव कथासु विकुण्ठनाथ सम्प्रीयते दुरितदुष्टमसाधु तीव्रम्।\nकामातुरं हर्षशोकभयेषणार्तं तस्मिन् कथं तव गतिं विमृशामि दीनः॥ ७/९/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.041.m4a", "display_order": 42}, {"id": 6000147042, "chapter_id": 10147, "verse_number": "७-९-४०", "content_sanskrit": "जिह्वैकतोऽच्युत विकर्षति मा वितृप्ता शिश्नोऽन्यतस्त्वगुदरं श्रवणं कुतश्चित्।\nघ्राणोऽन्यतश्चपलदृक्क्‍व च कर्मशक्तिर्बह्व्यः सपत्न्य इव गेहपतिं लुनन्ति॥ ७/९/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.042.m4a", "display_order": 43}, {"id": 6000147043, "chapter_id": 10147, "verse_number": "७-९-४१", "content_sanskrit": "एवं स्वकर्मपतितं भववैतरण्यामन्योन्यजन्ममरणाशनिभीतभीतम्।\nपश्यन् जनं स्वपरविग्रहवैरमैत्रं हन्तेति पारमतिपीपृहि मूढसत्त्वम्॥ ७/९/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.043.m4a", "display_order": 44}, {"id": 6000147044, "chapter_id": 10147, "verse_number": "७-९-४२", "content_sanskrit": "कोऽन्वत्र तेऽखिलगुरो भगवन् प्रयास उत्तारणेऽस्य भवसम्भवलोपहेतोः।\nमूढेषु वै महदनुग्रह आर्तबन्धो किं तेन ते प्रियजनाननुसेवमानः॥ ७/९/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.044.m4a", "display_order": 45}, {"id": 6000147045, "chapter_id": 10147, "verse_number": "७-९-४३", "content_sanskrit": "नैवोद्विजे भवदुरत्यययवैतरण्यास्त्वत्तीर्थगायनमहामृतमत्तचित्तः ।\nशोचे नु ते विमुखचेतस इन्द्रियार्थ मायासुखाय भरमुद्वहतो विमूढान्॥ ७/९/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.045.m4a", "display_order": 46}, {"id": 6000147046, "chapter_id": 10147, "verse_number": "७-९-४४", "content_sanskrit": "प्रायेण देवमुनयः स्वविमुक्तिकामा मौनं चरन्ति विजने न परार्थनिष्ठाः।\nनैतान् विहाय कृपणान् विमुमुक्ष एको नान्यं त्वदस्य शरणं भ्रमतोऽनुपश्ये॥ ७/९/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.046.m4a", "display_order": 47}, {"id": 6000147047, "chapter_id": 10147, "verse_number": "७-९-४५", "content_sanskrit": "यन्मैथुनादि गृहमेधिसुखं हि तुच्छं कण्डूयनेन करयोरिव दुःखदुःखम्।\nतृप्यन्ति देहकृपणा बहुदुःखभाजः कण्डूतिवन्मनसिजं विषहेत धीरः॥ ७/९/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.047.m4a", "display_order": 48}, {"id": 6000147048, "chapter_id": 10147, "verse_number": "७-९-४६", "content_sanskrit": "मौनव्रतश्रुततपोऽध्ययनस्वधर्मव्याख्यारहोजपसमाधय आपवर्ग्याः।\nप्रायः, परं पुरुष ते त्वजितेन्द्रियाणां वार्ता भवन्त्युत न वाऽत्र तु दाम्भिकानाम्॥ ७/९/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.048.m4a", "display_order": 49}, {"id": 6000147049, "chapter_id": 10147, "verse_number": "७-९-४७", "content_sanskrit": "रूपे इमे सदसती तव वेददृष्टे बीजाङ्कुराविव न चान्यदरूपकस्य।\nयुक्ताः समक्षमुभयत्र विचिन्वते त्वां योगेन वह्निमिव दारुषु नान्यतः स्यात्॥ ७/९/४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.049.m4a", "display_order": 50}, {"id": 6000147050, "chapter_id": 10147, "verse_number": "७-९-४८", "content_sanskrit": "त्वं वायुरग्निरवनिर्वियदम्बुमात्राः प्राणेन्द्रियाणि हृदयं चिदनुग्रहश्च।\nसर्वं त्वमेव सगुणो विगुणश्च भूमन् नान्यत् त्वदस्त्यपि मनोवचसा निरुक्तम्॥ ७/९/४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.050.m4a", "display_order": 51}, {"id": 6000147051, "chapter_id": 10147, "verse_number": "७-९-४९", "content_sanskrit": "नैते गुणानुगुणिनो महदादयो ये सर्वे मनःप्रभृतयः सहदेवमर्त्याः।\nआद्यन्तवन्त उरुगाय विदन्ति हि त्वामेवं विमृश्य सुधियो विरमन्ति शब्दात्॥ ७/९/४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.051.m4a", "display_order": 52}, {"id": 6000147052, "chapter_id": 10147, "verse_number": "७-९-५०", "content_sanskrit": "तत्वे मनो दर्शने दृगपि स्तुतौ च वाक् कर्मणि ह्यपि करौ श्रवणं कथायाम्।\nसंसेवया त्वयि विनेति षडङ्गया किं भक्तिं जनः परमहंसगतौ लभेत॥ ७/९/५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.052.m4a", "display_order": 53}, {"id": 6000147053, "chapter_id": 10147, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.053.m4a", "display_order": 54}, {"id": 6000147054, "chapter_id": 10147, "verse_number": "७-९-५१", "content_sanskrit": "एतावद्वर्णितगुणो भक्त्या भक्तेन निर्गुणः।\nप्रह्लादं प्रणतं प्रीतो गतमन्युरभाषत॥ ७/९/५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.054.m4a", "display_order": 55}, {"id": 6000147055, "chapter_id": 10147, "verse_number": null, "content_sanskrit": "श्रीभगवानुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.055.m4a", "display_order": 56}, {"id": 6000147056, "chapter_id": 10147, "verse_number": "७-९-५२", "content_sanskrit": "प्रह्लाद भद्र भद्रं ते प्रीतोऽहं तेऽसुरोत्तम।\nवरं वृणीष्वाभिमतं कामपूरोऽस्म्यहं नृणाम्॥ ७/९/५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.056.m4a", "display_order": 57}, {"id": 6000147057, "chapter_id": 10147, "verse_number": "७-९-५३", "content_sanskrit": "मामप्रीणत आयुष्मन् दर्शनं दुर्लभं हि मे।\nदृष्ट्वा मां न पुनर्जन्तुरात्मानं तप्तुमर्हति॥ ७/९/५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.057.m4a", "display_order": 58}, {"id": 6000147058, "chapter_id": 10147, "verse_number": "७-९-५४", "content_sanskrit": "प्रीणन्ति ह्यथ मां धीराः सर्वभावेन माधवम्।\nश्रेयस्कामा महाभागाः सर्वेषामाशिषां पतिम्॥ ७/९/५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.058.m4a", "display_order": 59}, {"id": 6000147059, "chapter_id": 10147, "verse_number": null, "content_sanskrit": "नारद उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.059.m4a", "display_order": 60}, {"id": 6000147060, "chapter_id": 10147, "verse_number": "७-९-५५", "content_sanskrit": "एवं प्रलोभ्यमानोऽपि वरैर्लोकप्रलोभनैः।\nएकान्तित्वाद् भगवति नैच्छत् तानसुरोत्तमः॥ ७/९/५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_07/adhyaya_009/BhP_07.009.060.m4a", "display_order": 61}, {"id": 6000147061, "chapter_id": 10147, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां सप्तमस्कन्धे नवमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}]