[{"id": 7004042000, "chapter_id": 24042, "verse_number": "३-३-१३-१", "content_sanskrit": "सूत उवाच ।\nदशार्णाधिपतेस्तस्य वज्रबाहोर्महाभुजः ।\nबभूव शत्रुर्बलवान्राजा मगधराट् ततः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004042001, "chapter_id": 24042, "verse_number": "३-३-१३-२", "content_sanskrit": "स वै हेमरथो नाम बाहुशाली रणोत्कटः ।\nबलेन महतावृत्य दशार्णं न्यरुधद्बली॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004042002, "chapter_id": 24042, "verse_number": "३-३-१३-३", "content_sanskrit": "चमूपास्तस्य दुर्धर्षाः प्राप्य देशं दशार्णकम् ।\nव्यलुंपन्वसुरत्नानि गृहाणि ददहुः परे॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004042003, "chapter_id": 24042, "verse_number": "३-३-१३-४", "content_sanskrit": "केचिद्धनानि जगृहुः केचिद्बालान्स्त्रियोऽपरे ।\nगोधनान्यपरेऽगृह्णन्केचिद्धान्यपरिच्छदान् ।\nकेचिदारामसस्यानि गृहोद्यानान्यनाशयत्॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004042004, "chapter_id": 24042, "verse_number": "३-३-१३-५", "content_sanskrit": "एवं विनाश्य तद्राज्यं स्त्रीगोधनजिघृक्षवः ।\nआवृत्य तस्य नगरीं वज्रबाहोस्तु मागधः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004042005, "chapter_id": 24042, "verse_number": "३-३-१३-६", "content_sanskrit": "एवं पर्याकुलं वीक्ष्य राजा नगरमेव च ।\nयुद्धाय निर्जगामाशु वज्रबाहुः ससै निकः॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004042006, "chapter_id": 24042, "verse_number": "३-३-१३-७", "content_sanskrit": "वज्रबाहुश्च भूपालस्तथा मंत्रिपुरःसराः ।\nयुयुधुर्मागधैः सार्धं निजघ्नुः शत्रुवाहिनीम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004042007, "chapter_id": 24042, "verse_number": "३-३-१३-८", "content_sanskrit": "वज्रबाहुर्महेष्वासो दंशितो रथमास्थितः ।\nविकिरन्बाणवर्षाणि चकार कदनं महत्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004042008, "chapter_id": 24042, "verse_number": "३-३-१३-९", "content_sanskrit": "दशार्णराजं युध्यंतं दृष्ट्वा युद्धे सुदुःसहम् ।\nतमेव तरसा वव्रुः सर्वे मागधसैनिकाः॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004042009, "chapter_id": 24042, "verse_number": "३-३-१३-१०", "content_sanskrit": "कृत्वा तु सुचिरं युद्धं मागधा दृढविक्रमाः ।\nतत्सैन्यं नाशयामासुर्लेभिरे च जयश्रियम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004042010, "chapter_id": 24042, "verse_number": "३-३-१३-११", "content_sanskrit": "केचित्तस्य रथं जघ्नुः केचित्तद्धनुराच्छिनम् ।\nसूतं तस्य जघानैकस्त्वपरः खड्गमाच्छिनत्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004042011, "chapter_id": 24042, "verse_number": "३-३-१३-१२", "content_sanskrit": "संछिन्नखड्गधन्वानं विरथं हतसारथिम् ।\nबलाद्गृहीत्वा बलिनो बबंधुर्नृपतिं रुषा॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004042012, "chapter_id": 24042, "verse_number": "३-३-१३-१३", "content_sanskrit": "तस्य मंत्रिगणं सर्वं तत्सैन्यं च विजित्य ते ।\nमागधास्तस्य नगरीं विविशुर्जयकाशिनः॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004042013, "chapter_id": 24042, "verse_number": "३-३-१३-१४", "content_sanskrit": "अश्वान्नरान्गजानुष्ट्रान्पशूंश्चैव धनानि च ।\nजगृहुर्युवतीः सर्वाश्चार्वंगीश्चैव कन्यकाः॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004042014, "chapter_id": 24042, "verse_number": "३-३-१३-१५", "content_sanskrit": "राज्ञो बबंधुर्महिषीर्दासीश्चैव सहस्रशः ।\nकोशं च रत्नसंपूर्णं जह्रुस्तेऽप्याततायिनः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004042015, "chapter_id": 24042, "verse_number": "३-३-१३-१६", "content_sanskrit": "एवं विनाश्य नगरीं हृत्वा स्त्रीगोधनादिकम् ।\nवज्रबाहुं बलाद्बद्ध्वा रथे स्थाप्य विनिर्ययुः॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004042016, "chapter_id": 24042, "verse_number": "३-३-१३-१७", "content_sanskrit": "एवं कोलाहले जाते राष्ट्रनाशे च दारुणे ।\nराजपुत्रोऽथ भद्रायुस्तद्वार्तामशृणोद्बली॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004042017, "chapter_id": 24042, "verse_number": "३-३-१३-१८", "content_sanskrit": "पितरं शत्रुनिर्बद्धं पितृपत्नीस्तथा हृताः ।\nनष्टं दशार्णराष्ट्रं च श्रुत्वा चुक्रोश सिंहवत्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004042018, "chapter_id": 24042, "verse_number": "३-३-१३-१९", "content_sanskrit": "स खड्गशंखावादाय वैश्यपुत्रसहायवान् ।\nदंशितो हयमारुह्य कुमारो विजिगीषया॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004042019, "chapter_id": 24042, "verse_number": "३-३-१३-२०", "content_sanskrit": "जवेनागत्य तं देशं मागधैरभिपूरितम् ।\nदह्यमानं क्रंदमानं हृतस्त्रीसुतगोधनम्॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004042020, "chapter_id": 24042, "verse_number": "३-३-१३-२१", "content_sanskrit": "दृष्ट्वा राजजनं सर्वं राज्यं शून्यं भयाकुलम् ।\nक्रोधाध्मातमनास्तूर्णं प्रविश्य रिपुवाहिनीम् ।\nआकर्णाकृष्टकोदंडो ववर्ष शरसंततीः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004042021, "chapter_id": 24042, "verse_number": "३-३-१३-२२", "content_sanskrit": "ते हन्यमाना रिपवो राजपुत्रेण सायकैः ।\nतमभिद्रुत्य वेगेन शरैर्विव्यधुरुल्बणैः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004042022, "chapter_id": 24042, "verse_number": "३-३-१३-२३", "content_sanskrit": "हन्यमानोऽस्त्रपूगेन रिपुभिर्युद्धदुर्मदैः ।\nन चचाल रणे धीरः शिववर्माभिरक्षितः॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004042023, "chapter_id": 24042, "verse_number": "३-३-१३-२४", "content_sanskrit": "सोऽस्त्रकर्षं प्रसह्याशु प्रविश्य गजलीलया ।\nजघानाशु रथान्नागान्पदातीनपि भूरिशः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004042024, "chapter_id": 24042, "verse_number": "३-३-१३-२५", "content_sanskrit": "तत्रैकं रथिनं हत्वा ससूतं नृपनंदनः ।\nतमेव रथमास्थाय वैश्यनंदनसारथिः ।\nविचचार रणे धीरः सिंहो मृगकुलं यथा॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004042025, "chapter_id": 24042, "verse_number": "३-३-१३-२६", "content_sanskrit": "अथ सर्वे सुसंरब्धाः शूराः प्रोद्यतकार्मुकाः ।\nअभिसस्रुस्तमेवैकं चमूपा बलशालिनः॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004042026, "chapter_id": 24042, "verse_number": "३-३-१३-२७", "content_sanskrit": "तेषामापततामग्रे खड्गमुद्यम्य दारुणम् ।\nअभ्युद्ययौ महावीरान्दर्शयन्निव पौरुषम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004042027, "chapter_id": 24042, "verse_number": "३-३-१३-२८", "content_sanskrit": "करालांतकजिह्वाभं तस्य खड्गं महोज्ज्वलम् ।\nदृष्ट्वैव सहसा मम्रुश्च मूपास्तत्प्रभावतः॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004042028, "chapter_id": 24042, "verse_number": "३-३-१३-२९", "content_sanskrit": "येये पश्यंति तं खड्गं प्रस्फुरंतं रणांगणे ।\nते सर्वे निधनं जग्मुर्वज्रं प्राप्येव कीटकः॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004042029, "chapter_id": 24042, "verse_number": "३-३-१३-३०", "content_sanskrit": "अथासौ सर्वसैन्यानां विनाशाय महाभुजः ।\nशंखं दध्मौ महारावं पूरयन्निव रोदसी॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004042030, "chapter_id": 24042, "verse_number": "३-३-१३-३१", "content_sanskrit": "तेन शंखनिनादेन विषाक्तेनैव भूयसा ।\nश्रुतमात्रेण रिपवो मूर्च्छिताः पतिता भुवि॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004042031, "chapter_id": 24042, "verse_number": "३-३-१३-३२", "content_sanskrit": "येऽश्वपृष्ठे रथे ये च ये च दंतिषु संस्थिताः ।\nते विसंज्ञाः क्षणात्पेतुः शंखनादहतौजसः॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004042032, "chapter_id": 24042, "verse_number": "३-३-१३-३३", "content_sanskrit": "तान्भूमौ पतितान्सर्वान्नष्टसंज्ञा न्निरायुधान् ।\nविगणय्य शवप्रायाननावधीद्धर्मशास्त्रवित्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004042033, "chapter_id": 24042, "verse_number": "३-३-१३-३४", "content_sanskrit": "आत्मनः पितरं बद्धं मोचयित्वा रणाजिरे ।\nतत्पत्नीः शत्रुवशगाः सर्वाः सद्यो व्यमोचयत्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004042034, "chapter_id": 24042, "verse_number": "३-३-१३-३५", "content_sanskrit": "पत्नीश्च मंत्रिमुख्यानां तथान्येषां पुरौकसाम् ।\nस्त्रियो बालांश्च कन्याश्च गोधनादीन्यनेकशः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004042035, "chapter_id": 24042, "verse_number": "३-३-१३-३६", "content_sanskrit": "मोचयित्वा रिपुभयात्तमाश्वासयदाकुलः ।\nअथारिसैन्येषु चरंस्तेषां जग्राह योषितः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004042036, "chapter_id": 24042, "verse_number": "३-३-१३-३७", "content_sanskrit": "मरुन्मनोजवानश्वान्मातंगान्गिरिसन्निभान् ।\nस्यंदनानि च रौक्माणि दासीश्च रुचिराननाः॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004042037, "chapter_id": 24042, "verse_number": "३-३-१३-३८", "content_sanskrit": "युग्मम् ।\nसर्वमाहृत्य वेगेन गृहीत्वा तद्धनं बहु ।\nमागधेशं हेमरथं निर्बबंध पराजितम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004042038, "chapter_id": 24042, "verse_number": "३-३-१३-३९", "content_sanskrit": "तन्मंत्रिणश्च भूपांश्च तत्र मुख्यांश्च नायकान् ।\nगृहीत्वा तरसा बद्ध्वा पुरीं प्रावेशयद्द्रुतम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004042039, "chapter_id": 24042, "verse_number": "३-३-१३-४०", "content_sanskrit": "पूर्वं ये समरे भग्ना विवृत्ताः सर्वतोदिशम् ।\nते मंत्रिमुख्या विश्वस्ता नायकाश्च समाययुः॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004042040, "chapter_id": 24042, "verse_number": "३-३-१३-४१", "content_sanskrit": "कुमारविक्रमं दृष्ट्वा सर्वे विस्मितमानसाः ।\nतं मेनिरे सुरश्रेष्ठं कारणादागतं भुवम्॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004042041, "chapter_id": 24042, "verse_number": "३-३-१३-४२", "content_sanskrit": "अहो नः सुमहाभाग्यमहो नस्तपसः फलम् ।\nकेनाप्यनेन वीरेण मृताः संजीविताः खलु॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004042042, "chapter_id": 24042, "verse_number": "३-३-१३-४३", "content_sanskrit": "एष किं योगसिद्धो वा तपःसिद्धो ऽथवाऽमरः ।\nअमानुषमिद कर्म यदनेन कृतं महत्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004042043, "chapter_id": 24042, "verse_number": "३-३-१३-४४", "content_sanskrit": "नूनमस्य भवेन्माता सा गौरीति शिवः पिता ।\nअक्षौहिणीनां नवकं जिगायानंतशक्तिधृक्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004042044, "chapter_id": 24042, "verse_number": "३-३-१३-४५", "content_sanskrit": "इत्याश्चर्ययुतैर्हृष्टैः प्रशंसद्भिः परस्परम् ।\nपृष्टोऽमात्यजनेनासावात्मानं प्राह तत्त्वतः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004042045, "chapter_id": 24042, "verse_number": "३-३-१३-४६", "content_sanskrit": "समागतं स्वपितरं विस्मयाह्लादविप्लुतम् ।\nमुंचंतमानंदजलं ववंदे प्रेमविह्वलः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004042046, "chapter_id": 24042, "verse_number": "३-३-१३-४७", "content_sanskrit": "स राजा निजपुत्रेण प्रणयादभिवंदितः ।\nआश्लिष्य गाढं तरसा बभाषे प्रेमकातरः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004042047, "chapter_id": 24042, "verse_number": "३-३-१३-४८", "content_sanskrit": "कस्त्वं देवो मनुष्यो वा गन्धर्वो वा महामते ।\nका माता जनकः को वा को देशस्तव नाम किम्॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004042048, "chapter_id": 24042, "verse_number": "३-३-१३-४९", "content_sanskrit": "कस्मान्न शत्रुभिर्बद्धान्मृतानिव हतौजसः ।\nकारुण्यादिह संप्राप्य सपत्नीकान्मुमोच यः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004042049, "chapter_id": 24042, "verse_number": "३-३-१३-५०", "content_sanskrit": "कुतो लब्धमिदं शौर्यं धैर्यं तेजो बलोन्नतिः ।\nजिगीषसीव लोकांस्त्रीन्सदेवासुरमानुषान्॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004042050, "chapter_id": 24042, "verse_number": "३-३-१३-५१", "content_sanskrit": "अपि जन्मसहस्रेण तवानृण्यं महौजसः ।\nकर्तुं नाहं समर्थोस्मि सहैभिर्दारबांधवैः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7004042051, "chapter_id": 24042, "verse_number": "३-३-१३-५२", "content_sanskrit": "इमान्पुत्रानिमाः पत्नीरिदं राज्यमिदं पुरम् ।\nसर्वं विहाय मच्चित्तं त्वय्येव प्रेमबंधनम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7004042052, "chapter_id": 24042, "verse_number": "३-३-१३-५३", "content_sanskrit": "सर्वं कथय मे तात मत्प्राणपरिरक्षक ।\nएतासां मम पत्नीनां त्वदधीनं हि जीवितम्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7004042053, "chapter_id": 24042, "verse_number": "३-३-१३-५४", "content_sanskrit": "सूत उवाच ।\nइति पृष्टः स भद्रायुः स्वपित्रा तमभाषत ।\nएष वैश्यसुतो राजन्सुनयो नाम मत्सखा॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7004042054, "chapter_id": 24042, "verse_number": "३-३-१३-५५", "content_sanskrit": "अहमस्य गृहे रम्ये वसामि सहमातृकः ।\nभद्रायुर्नाम मद्वृत्तं पश्चाद्विज्ञापयामि ते॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7004042055, "chapter_id": 24042, "verse_number": "३-३-१३-५६", "content_sanskrit": "पुरं प्रविश्य भद्रं ते सदारः ससुहृज्जनः ।\nत्यक्त्वा भयमरातिभ्यो विहरस्व यथासुखम्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7004042056, "chapter_id": 24042, "verse_number": "३-३-१३-५७", "content_sanskrit": "नैतान्मुंच रिपूंस्तावद्यावदागमनं मम ।\nअहमद्य गमिष्यामि शीघ्रमात्मनिवेशनम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7004042057, "chapter_id": 24042, "verse_number": "३-३-१३-५८", "content_sanskrit": "इत्युक्त्वा नृपमामंत्र्य भद्रायुर्नृपनंदनः ।\nआजगाम स्वभवनं मात्रे सर्वं न्यवेदयत्॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7004042058, "chapter_id": 24042, "verse_number": "३-३-१३-५९", "content_sanskrit": "सापि हृष्टा स्वतनयं परिरेभेऽश्रुलोचना ।\nस च वैश्यपतिः प्रेम्णा परिष्वज्याभ्यपूजयत्॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7004042059, "chapter_id": 24042, "verse_number": "३-३-१३-६०", "content_sanskrit": "वज्रबाहुश्च राजेंद्रः प्रविष्टो निजमंदिरम् ।\nस्त्रीपुत्रामात्य सहितः प्रहर्षमतुलं ययौ॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7004042060, "chapter_id": 24042, "verse_number": "३-३-१३-६१", "content_sanskrit": "तस्यां निशायां व्युष्टायामृषभो योगिनां वरः ।\nचंद्रांगदं समागत्य सीमंतिन्याः पतिं नृपम्॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7004042061, "chapter_id": 24042, "verse_number": "३-३-१३-६२", "content_sanskrit": "भद्रायुषः समुत्पत्तिं तस्य कर्माप्यमानुषम् ।\nआवेद्य रहसि प्रेम्णा त्वत्सुतां कीर्तिमालिनीम्॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7004042062, "chapter_id": 24042, "verse_number": "३-३-१३-६३", "content_sanskrit": "भद्रायुषे प्रयच्छेति बोधयित्वा च नैषधम् ।\nऋषभो निर्जगामाथ देशकालार्थतत्त्ववित्॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7004042063, "chapter_id": 24042, "verse_number": "३-३-१३-६४", "content_sanskrit": "विशेषकम् ।\nअथ चंद्रांगदो राजा मुहूर्त्ते मंगलोचिते ।\nभद्रायुषं समाहूय प्रायच्छत्कीर्त्तिमालिनीम्॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7004042064, "chapter_id": 24042, "verse_number": "३-३-१३-६५", "content_sanskrit": "कृतोद्वाहः स राजेंद्रतनयः सह भार्यया ।\nहेमासनस्थः शुशुभे रोहिण्येव निशाकरः॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7004042065, "chapter_id": 24042, "verse_number": "३-३-१३-६६", "content_sanskrit": "वज्रबाहुं तत्पितरं समाहूय स नैषधः ।\nपुरं प्रवेश्य सामात्यः प्रत्युद्गम्याभ्यपूजयत्॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7004042066, "chapter_id": 24042, "verse_number": "३-३-१३-६७", "content_sanskrit": "तत्रापश्यत्कृतोद्वाहं भद्रायुषमरिंदमम् ।\nपादयोः पतितं प्रेम्णा हर्षात्तं परिषस्वजे॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7004042067, "chapter_id": 24042, "verse_number": "३-३-१३-६८", "content_sanskrit": "एष मे प्राणदो वीर एष शत्रुनिषूदनः ।\nअथाप्यज्ञातवंशोऽयं मयानंतपराक्रमः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7004042068, "chapter_id": 24042, "verse_number": "३-३-१३-६९", "content_sanskrit": "एष ते नृप जामाता चंद्रांगद महाबलः ।\nअस्य वंशमथोत्पत्तिं श्रोतुमिच्छामि तत्त्वतः॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7004042069, "chapter_id": 24042, "verse_number": "३-३-१३-७०", "content_sanskrit": "इत्थं दशार्णराजेन प्रार्थितो निषधाधिपः ।\nविविक्त उपसंगम्य प्रहसन्निदमब्रवीत्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7004042070, "chapter_id": 24042, "verse_number": "३-३-१३-७१", "content_sanskrit": "एष ते तनयो राजञ्छैशवे रोगपीडितः ।\nत्वया वने परित्यक्तः सह मात्रा रुजार्तया॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7004042071, "chapter_id": 24042, "verse_number": "३-३-१३-७२", "content_sanskrit": "परिभ्रमंती विपिने सा नारी शिशुनामुना ।\nदैवाद्वैश्यगृहं प्राप्ता तेन वैश्येन रक्षिता॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7004042072, "chapter_id": 24042, "verse_number": "३-३-१३-७३", "content_sanskrit": "अथासौ बहुरोगार्तो मृतस्तव कुमारकः ।\nकेनापि योगिराजेन मृतः संजीवितः पुनः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7004042073, "chapter_id": 24042, "verse_number": "३-३-१३-७४", "content_sanskrit": "ऋषभाख्यस्य तस्यैव प्रभावाच्छिवयोगिनः ।\nरूपं च देवसदृशं प्राप्तौ मातृकुमारकौ॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7004042074, "chapter_id": 24042, "verse_number": "३-३-१३-७५", "content_sanskrit": "तेन दत्तेन खड्गेन शंखेन रिपुघातिना ।\nजिगाय समरे शत्रूञ्छिववर्माभिरक्षितः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7004042075, "chapter_id": 24042, "verse_number": "३-३-१३-७६", "content_sanskrit": "द्विषट्सहस्रनागानां बलमेको बिभर्त्यसौ ।\nसर्वविद्यासु निष्णातो मम जामातृतां गतः॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7004042076, "chapter_id": 24042, "verse_number": "३-३-१३-७७", "content_sanskrit": "अत एनं समादाय मातरं चास्य सुव्रताम् ।\nगच्छस्व नगरीं राजन्प्राप्स्यसि श्रेय उत्तमम्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7004042077, "chapter_id": 24042, "verse_number": "३-३-१३-७८", "content_sanskrit": "इति चंद्रांगदः सर्वमाख्यायांतर्गृहे स्थिताम् ।\nतस्याग्र पत्नीमाहूय दर्शयामास भूषिताम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7004042078, "chapter_id": 24042, "verse_number": "३-३-१३-७९", "content_sanskrit": "इत्यादि सर्वमाकर्ण्य दृष्ट्वा च स महीपतिः ।\nव्रीडितो नितरां मौढ्यात्स्वकृतं कर्म गर्हयन्॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7004042079, "chapter_id": 24042, "verse_number": "३-३-१३-८०", "content_sanskrit": "प्राप्तश्च परमानन्दं तयोर्दर्शनकौतुकात् ।\nपुलकांकितसर्वांगस्तावुभौ परिषस्वजे॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7004042080, "chapter_id": 24042, "verse_number": "३-३-१३-८१", "content_sanskrit": "युग्मम् ।\nएवं निषधराजेन पूजितश्चाभिनन्दितः ।\nस भोजयित्वा तं सम्यक्स्वयं च सह मंत्रिभिः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7004042081, "chapter_id": 24042, "verse_number": "३-३-१३-८२", "content_sanskrit": "तामात्मनोग्रमहिषीं पुत्रं तमपि तां स्नुषाम् ।\nआदाय सपरीवारो वज्रबाहुः पुरीं ययौ॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7004042082, "chapter_id": 24042, "verse_number": "३-३-१३-८३", "content_sanskrit": "स संभ्रमेण महता भद्रायुः पितृमंदिरम् ।\nसंप्राप्य परमानंदं चक्रे सर्वपुरौकसाम्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7004042083, "chapter_id": 24042, "verse_number": "३-३-१३-८४", "content_sanskrit": "कालेन दिवमारूढे पितरि प्राप्तयौवनः ।\nभद्रायुः पृथिवीं सर्वां शशासाद्भुतविक्रमः॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7004042084, "chapter_id": 24042, "verse_number": "३-३-१३-८५", "content_sanskrit": "मागधेशं हेमरथं मोचयामास बंधनात् ।\nसंधाय मैत्रीं परमां ब्रह्मर्षीणां च सन्निधौ॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7004042085, "chapter_id": 24042, "verse_number": "३-३-१३-८६", "content_sanskrit": "इत्थं त्रिलोकमहितां शिवयोगिपूजां कृत्वा पुरातनभवेऽपि स राजसूनुः ।\nनिस्तीर्य दुःसहविपद्गणमाप्तराज्यश्चंद्रांगदस्य सुतया सह साधु रेमे॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}]