[{"id": 7005853000, "chapter_id": 25853, "verse_number": "१-३६-१", "content_sanskrit": "हरिरुवाच ।\nसन्ध्याविधिं प्रवक्ष्यामि श्रृणु रुद्राघनाशनम्।\nप्राणायामत्रयं कृत्वा सन्ध्यास्नानमुपक्रमेत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005853001, "chapter_id": 25853, "verse_number": "१-३६-२", "content_sanskrit": "सप्रणवां सव्याहृतिं गायत्त्रीं शिरसा सह ।\nत्रिः पठेदायतप्रणः प्राणायामः स उच्यते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005853002, "chapter_id": 25853, "verse_number": "१-३६-३", "content_sanskrit": "मनोवाक्रायजं दोषं प्राणायामैर्दहेद्द्विजः ।\nतस्मात्सर्वेषु कालेषु प्राणायामपरो भवेत् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005853003, "chapter_id": 25853, "verse_number": "१-३६-४", "content_sanskrit": "सायमग्निश्च मेत्युक्ता प्रातः सूर्य्येत्यपः पबेत्।\nआपः पुनन्तु मध्याह्ने उपस्पृश्य यथाविधि ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005853004, "chapter_id": 25853, "verse_number": "१-३६-५", "content_sanskrit": "आपोहिष्ठेत्यृचा कुर्य्यान्मार्जनं तु कुशोदकैः।\nप्रणवेन तु संयुक्तं क्षिपेद्वारि पदेपदे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005853005, "chapter_id": 25853, "verse_number": "१-३६-६", "content_sanskrit": "रजस्तमः स्वमोहोत्थाञ्जाग्रत्स्वप्नसुषुप्तिजन्।\nवाङ्‌मनः कर्मजान्दोषान्नवैतान्नवभिर्दहेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005853006, "chapter_id": 25853, "verse_number": "१-३६-७", "content_sanskrit": "समुद्धृत्योदकं पाणौ जप्त्वा च द्रुपदां क्षिपत्।\nत्रिपडष्टौ द्वादशधा वर्त्तयेदघमर्पणम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005853007, "chapter_id": 25853, "verse_number": "१-३६-८", "content_sanskrit": "उदुत्यंचित्रमित्याभ्यामुपतिष्ठेद्दिवाकरम् ।\nदिवा रात्रौ च यत्पापं सर्वं नश्यति तत्क्षणात् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005853008, "chapter_id": 25853, "verse_number": "१-३६-९", "content_sanskrit": "पूर्वसंध्यां जपंस्तिष्ठेत्पश्चिमामुपविश्य च ।\nमहाव्याहृतिसंयुक्तां गायत्त्रीं प्रणवान्विताम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005853009, "chapter_id": 25853, "verse_number": "१-३६-१०", "content_sanskrit": "दशभिर्जन्मजनितं शतेन तु पुरा कृतम् ।\nत्रियुगं तु सहस्त्रेण गायत्त्रीं हन्ति दुष्कृतम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005853010, "chapter_id": 25853, "verse_number": "१-३६-११", "content_sanskrit": "रक्ता भवति गायत्त्री सावित्री शुक्लवर्णिका ।\nकृष्णा सरस्वती ज्ञेया संध्यात्रयमुदाहृतम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005853011, "chapter_id": 25853, "verse_number": "१-३६-१२", "content_sanskrit": "ॐ भूर्विन्यस्य हृदये ॐ भुवः शिरसि न्यसेत् ।\nॐ स्वरिति शिखायां च गायत्र्याः प्रथमं पदम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005853012, "chapter_id": 25853, "verse_number": "१-३६-१३", "content_sanskrit": "विन्यसेत्कवचे विद्वान्द्वितीयं नेत्रयोर्न्यसेत।\nतृतीयेनाङ्गविन्यासं चतुर्थं सर्वतो न्यसेत् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005853013, "chapter_id": 25853, "verse_number": "१-३६-१४", "content_sanskrit": "संध्याकाले तु विन्यस्य जपेद्वै वेदमातरम् ।\nशिवस्तस्यास्तु सर्वाह्णे प्राणायामपरं न्यसेत् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7005853014, "chapter_id": 25853, "verse_number": "१-३६-१५", "content_sanskrit": "त्रिपदा या तु गायत्त्री ब्रह्मविष्णुमहेश्र।\nविनियोगमृषिच्छन्दो ज्ञात्वा तु जपमारभेत् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7005853015, "chapter_id": 25853, "verse_number": "१-३६-१६", "content_sanskrit": "सर्वपापविनिर्मुक्तो ब्रह्मलोकमवाप्नयत्।\nपरोरजसि सारं तं तुरीयपदमीरितम् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7005853016, "chapter_id": 25853, "verse_number": "१-३६-१७", "content_sanskrit": "तं हन्ति सूर्य्यः सन्ध्यायां नोपास्तिं कुरुतेत यः।\nतुरीयस्य पदस्यापि ऋषिर्निर्मल एव च ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7005853017, "chapter_id": 25853, "verse_number": "१-३६-१८", "content_sanskrit": "छन्दस्तु देवी गायत्त्री परमात्मा च देवता ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7005853018, "chapter_id": 25853, "verse_number": "१-३६-१९", "content_sanskrit": "इति श्रीगारुडे महापुराणे पूर्वखण्डे प्रथमांशाख्ये आचारकाण्डे संध्याविधिर्नाम षट्‌त्रिंशोऽध्यायः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]