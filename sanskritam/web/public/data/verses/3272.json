[{"id": 2105339, "chapter_id": 3272, "verse_number": "१६-१-१", "content_sanskrit": "श्रीवेदव्यासाय नमः।\nनारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं व्यासं ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2105340, "chapter_id": 3272, "verse_number": "१६-१-१x", "content_sanskrit": "जनमेजय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2105341, "chapter_id": 3272, "verse_number": "१६-१-१", "content_sanskrit": "प्राप्य पैतामहं राज्यं मम पूर्वपितामहाः।\nकथमासन्महाराजे धृतराष्ट्रे महात्मनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2105342, "chapter_id": 3272, "verse_number": "१६-१-२", "content_sanskrit": "स तु राजा हतामात्यो हतपुत्रो निराश्रयः।\nकथमासीद्धतैश्वर्यो गान्धारी च तपस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2105343, "chapter_id": 3272, "verse_number": "१६-१-३", "content_sanskrit": "कियन्तं चैव कालं ते मम पूर्वपितामहाः।\nस्थिता राज्ये महात्मानस्तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2105344, "chapter_id": 3272, "verse_number": "१६-१-४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2105345, "chapter_id": 3272, "verse_number": "१६-१-४", "content_sanskrit": "प्राप्य राज्यं महात्मानः पाण्डवा हतशत्रवः।\nधृतराष्ट्रं पुरस्कृत्य पृथिवीं पर्यपालयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2105346, "chapter_id": 3272, "verse_number": "१६-१-५", "content_sanskrit": "धृतराष्ट्रमुपातिष्ठद्विदुरः संजयस्तथा।\nवैश्यापुत्रश्च मेधावी युयुत्सुः कुरुसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2105347, "chapter_id": 3272, "verse_number": "१६-१-६", "content_sanskrit": "पाण्डवाः सर्वकार्येषु पर्यपृच्चन्त तं नृपम्।\nचक्रुस्तेनाभ्यनुज्ञाता वर्षाणि दश पञ्च च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2105348, "chapter_id": 3272, "verse_number": "१६-१-७", "content_sanskrit": "सदाऽभिगम्य ते वीराः पर्युपासन्त तं नृपम्।\nपादाभिवादनं कृत्वा धर्मिराजमते स्थिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2105349, "chapter_id": 3272, "verse_number": "१६-१-८", "content_sanskrit": "ते मूर्ध्नि समुपाघ्राताः सर्वकार्याणि चक्रिरे।\nकुन्तिभोजसुता चैव गान्धारीमन्ववर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2105350, "chapter_id": 3272, "verse_number": "१६-१-९", "content_sanskrit": "द्रौपदी च सुभद्रा च याश्चान्याः पाण्डवस्त्रियः।\nसमां वृत्तिमवर्तन्त तयोः श्वश्र्वोर्यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2105351, "chapter_id": 3272, "verse_number": "१६-१-१०", "content_sanskrit": "शयनानि महार्हाणि वासांस्याभरणानि च।\nराजार्हाणि च सर्वाणि भक्ष्यभोज्यान्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2105352, "chapter_id": 3272, "verse_number": "१६-१-११", "content_sanskrit": "युधिष्ठिरो महाराज धृतराष्ट्रेऽभ्युपाहरत्।\nतथैव कुन्ती गान्धार्यां गुरुवृत्तिमवर्तत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2105353, "chapter_id": 3272, "verse_number": "१६-१-१२", "content_sanskrit": "विदुरः संजयश्चैव युयुत्सुश्चैव कौरव।\nउपासते स्म तं वृद्धं हतपुत्रं जनाधिपम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2105354, "chapter_id": 3272, "verse_number": "१६-१-१३", "content_sanskrit": "श्यालो द्रोणस्य यश्चासीद्दयितो ब्राह्ममो महान्।\nस च तस्मिन्महेष्वासः कृपः समभवत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2105355, "chapter_id": 3272, "verse_number": "१६-१-१४", "content_sanskrit": "व्यासश्च भगवान्नित्यमासांचक्रे नृपेण ह।\nकथाः कुर्वन्पुराणर्षिर्देवर्षिपितृरक्षसाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2105356, "chapter_id": 3272, "verse_number": "१६-१-१५", "content_sanskrit": "धर्मयुक्तानि कार्याणि व्यवहारान्वितानि च।\nधृतराष्ट्राभ्यनुज्ञातो विदुरस्तान्यकारयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2105357, "chapter_id": 3272, "verse_number": "१६-१-१६", "content_sanskrit": "सामन्तेभ्यः प्रियाण्यस्य कार्याणि सुबहून्यपि।\nप्राप्यन्तेऽर्थेः सुलघुभिः सुनयाद्विदुरस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2105358, "chapter_id": 3272, "verse_number": "१६-१-१७", "content_sanskrit": "अकरोद्बन्धमोक्षं च वध्यानां मोक्षणं तथा।\nन च धर्मसुतो राजा कदाचित्किञ्चिदब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2105359, "chapter_id": 3272, "verse_number": "१६-१-१८", "content_sanskrit": "विहारयात्रासु पुनः कुरुराजो युधिष्ठिरः।\nसर्वान्कामानुपस्थाप्य धृतराष्ट्रे न्यवेदयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2105360, "chapter_id": 3272, "verse_number": "१६-१-१९", "content_sanskrit": "आरालिकाः सूपकारा रागषाडविकास्तथा।\nउपातिष्ठन्त राजानं धृतराष्ट्रं यथापुरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2105361, "chapter_id": 3272, "verse_number": "१६-१-२०", "content_sanskrit": "वासांसि च महार्हाणि माल्यानि विविधानि च।\nउपाजह्रुर्यथाकालं धृतराष्ट्रस्य पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2105362, "chapter_id": 3272, "verse_number": "१६-१-२१", "content_sanskrit": "मैरेयमधुमांसानि पानकानि लघूनि च।\nचित्रान्भक्ष्यविकारांश्च चक्रुस्तस्य यथा पुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2105363, "chapter_id": 3272, "verse_number": "१६-१-२२", "content_sanskrit": "ये चापि पृथिवीपालाः समाजग्मुस्ततस्ततः।\nउपातिष्ठन्त ते सर्वे कौरवेन्द्रं यथापुरा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2105364, "chapter_id": 3272, "verse_number": "१६-१-२३", "content_sanskrit": "कुन्ती च द्रौपदी चैव सात्वती च यशस्विनी।\nउलूपी नागकन्या च देवी चित्राङ्गदा तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2105365, "chapter_id": 3272, "verse_number": "१६-१-२४", "content_sanskrit": "धृष्टकेतोश्च भगिनी जरासन्धसुता तथा।\nएताश्चान्याश्च बह्व्यो वै योषितः पुरुषर्षभ।\nकिंकराः पर्युपातिष्ठन्सर्वाः सुबलजां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2105366, "chapter_id": 3272, "verse_number": "१६-१-२५", "content_sanskrit": "यथा पुत्रवियुक्तोऽयं न किञ्चिद्दुःखमाप्नुयात्।\nइति तानन्वशाद्भातॄन्नित्यमेव युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2105367, "chapter_id": 3272, "verse_number": "१६-१-२६", "content_sanskrit": "एवं ते धर्मराजस्य श्रुत्वा वचनमर्थवत्।\nसविशेषमवर्तन्ति भीममेकं तदा विना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2105368, "chapter_id": 3272, "verse_number": "१६-१-२७", "content_sanskrit": "न हि तत्तस्य वीरस्य हृदयादपसर्पति।\nधृतराष्ट्रस्य दुर्बुद्ध्या यद्वृत्तं द्यूतमण्डले॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2105369, "chapter_id": 3272, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्रमवासिकपर्वणि आश्रमवासपर्वणि प्रथमोऽध्यायः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]