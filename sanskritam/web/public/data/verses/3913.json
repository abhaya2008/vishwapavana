[{"id": 2134786, "chapter_id": 3913, "verse_number": "", "content_sanskrit": "युधिष्ठिरः-", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2134787, "chapter_id": 3913, "verse_number": "१", "content_sanskrit": "अस्मानभिगतांस्तात भयार्ताञ्छरणैषिणः ।\nकौरवान् विषमप्राप्तान् कथं ब्रूयास्त्वमिदृशम् \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2134788, "chapter_id": 3913, "verse_number": "२", "content_sanskrit": "रक्षणीया महाबाहो मैवं वद महामते ।\nभवन्ति भेदा ज्ञातीनां कलहाश्च वृकोदर ।\nप्रसक्तानि च वैराणि कुलधर्मो न नश्यति \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2134789, "chapter_id": 3913, "verse_number": "३", "content_sanskrit": "यदा तु कश्चिज्ज्ञातीनां बाह्यः प्रार्थयते कुलम्।\nन मर्षयन्ति तत् सन्तो बाह्येनाभिप्रधर्षणम् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2134790, "chapter_id": 3913, "verse_number": "४", "content_sanskrit": "परैः परिभवे प्राप्ते वयं पञ्चोत्तरं शतम् ।\nपरस्परविरोधे तु वयं पञ्च शतं तु ते \t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2134791, "chapter_id": 3913, "verse_number": "५", "content_sanskrit": "जानात्येष हि दुर्बुद्धिरस्मानिह चिरोषितान् ।\nस एवं परिभूयास्मानकार्षीदिदमप्रियम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2134792, "chapter_id": 3913, "verse_number": "६", "content_sanskrit": "दुर्योधनस्य ग्रहणाद् गन्धर्वेण बलात् प्रभो ।\nस्त्रीणां बाह्याभिमर्शाद्धि हतं भवति नः कुलम् \t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2134793, "chapter_id": 3913, "verse_number": "७", "content_sanskrit": "शरणं च प्रपन्नानां त्राणार्थं च कुलस्य च ।\nउत्तिष्ठध्वं(त) नरव्याघ्राः सज्जीभवत माचिरम् \t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2134794, "chapter_id": 3913, "verse_number": "८", "content_sanskrit": "अर्जुनश्च यमौ चैव त्वं च वीरापराजितः ।\nमोक्षयध्वं नरव्याघ्रा ह्रियमाणं सुयोधनम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2134795, "chapter_id": 3913, "verse_number": "९", "content_sanskrit": "एते रथा नरव्याघ्राः सर्वशस्त्रसमन्विताः ।\nइन्द्रसेनादिभिः सूतैः कृतशस्त्रैरधिष्ठितान् \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2134796, "chapter_id": 3913, "verse_number": "१०", "content_sanskrit": "एतानास्थाय वै यत्ता गन्धर्वान् योद्धुमाहवे ।\nसुयोधनस्य मोक्षाय प्रयतध्वमतन्द्रिताः \t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2134797, "chapter_id": 3913, "verse_number": "११", "content_sanskrit": "य एव कश्चिद् राजन्यः शरणार्थमिहागतम् ।\nपरं शक्त्याऽभिरक्षेत किं पुनस्त्वं वृकोदर \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2134798, "chapter_id": 3913, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2134799, "chapter_id": 3913, "verse_number": "१२", "content_sanskrit": "एवमुक्तस्तु कौन्तेयः पुनर्वाक्यमभाषत ।\nकोपसंरक्तनयनः पूर्ववैरमनुस्मरन् \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2134800, "chapter_id": 3913, "verse_number": "१३", "content_sanskrit": "पुरा जतुगृहेऽनेन दग्धुमस्मान् युधिष्ठिर ।\nदुर्बुद्धिर्हि कृता वीरा तदा दैवेन रक्षिताः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2134801, "chapter_id": 3913, "verse_number": "१४", "content_sanskrit": "कालकूटं विषं तीक्ष्णं भोजने मम भारत ।\nउप्त्वा गङ्गां लतापाशैर्बद्ध्वा च प्राक्षिपत् प्रभो \t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2134802, "chapter_id": 3913, "verse_number": "१५", "content_sanskrit": "रसातलं च सम्प्राप्य तदा वासुकिमञ्जसा ।\nतत्र दृष्ट्वा तु राजेन्द्र पुनः प्राप्तो महीतळम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2134803, "chapter_id": 3913, "verse_number": "१६", "content_sanskrit": "द्यूतकालेऽपि कौन्तेय वृजिनानि कृतानि वै ।\nद्रौपद्याश्च परामर्शः केशग्रहणमेव च ।\nवस्त्रापहरणं चैव सभामध्ये कृतानि वै \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2134804, "chapter_id": 3913, "verse_number": "१७", "content_sanskrit": "पुरा कृतानां पापानां फलं भुङ्क्ते सुयोधनः \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2134805, "chapter_id": 3913, "verse_number": "१८", "content_sanskrit": "अस्माभिरेव कर्तव्यो धार्तराष्ट्रस्य निग्रहः ।\nअन्येन तु कृतं तद्वै(च्च) मैत्र्यमस्माभिरिच्छता ।\nउपकारी तु गन्धर्वो मा राजन् विमना भव \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2134806, "chapter_id": 3913, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2134807, "chapter_id": 3913, "verse_number": "१९", "content_sanskrit": "एतस्मिन्नन्तरे राजंश्चित्रसेनेन वै हृतः ।\nविललाप सुदुःखार्तो ह्रियमाणः सुयोधनः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2134808, "chapter_id": 3913, "verse_number": "", "content_sanskrit": "दुर्योधनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2134809, "chapter_id": 3913, "verse_number": "", "content_sanskrit": "युधिष्ठिर महाबाहो सर्वधर्मभृता वर ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2134810, "chapter_id": 3913, "verse_number": "", "content_sanskrit": "स पुत्रान् सहदायांश्च गन्धर्वेण हृतान् बलात् ।\nपाण्डुपुत्र महाबाहो पौरवाणां यशस्कर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2134811, "chapter_id": 3913, "verse_number": "२०", "content_sanskrit": "सर्वधर्मभृतां श्रेष्ठ गन्धर्वेण हृतं बलात् \t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2134812, "chapter_id": 3913, "verse_number": "२१", "content_sanskrit": "रक्षस्व पुरुषव्याघ्र युधिष्ठिर महायशः \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2134813, "chapter_id": 3913, "verse_number": "२२", "content_sanskrit": "भ्रातरं ते महाबाहो बद्ध्वा नयति मामयम् ।\nदुःशासनं दुर्विषहं दुर्मुखं दुर्जयं तथा \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2134814, "chapter_id": 3913, "verse_number": "२३", "content_sanskrit": "बद्ध्वा हरन्ति गन्धर्वा अस्मद्दारांश्च सर्वशः ।\nअनुधावत मां क्षिप्रं रक्षध्वं पुरुषोत्तमाः ।\nवृकोदर महाबाहो धनञ्जय महायशः \t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2134815, "chapter_id": 3913, "verse_number": "२४", "content_sanskrit": "यमौ मामनुधावेतां रक्षार्थं मम सायुधौ ।\nकुरुवंशस्य सुमहदयशः प्राप्तमीदृशम् \t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2134816, "chapter_id": 3913, "verse_number": "२५", "content_sanskrit": "व्यपोहयध्वं गन्धर्वान् जित्वा वीर्येण पाण्डवाः \t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2134817, "chapter_id": 3913, "verse_number": "", "content_sanskrit": "वैशम्पयानः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2134818, "chapter_id": 3913, "verse_number": "२६", "content_sanskrit": "एवं विलपमानस्य कौरवस्यार्तया गिरा।\nश्रुत्वा विलापं सम्भ्रान्तो घृणयाऽभिपरिप्लुतः ।\nयुधिष्ठिरः पुनर्वाक्यं भीमसेनमथाब्रवीत् \t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2134819, "chapter_id": 3913, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2134820, "chapter_id": 3913, "verse_number": "२७", "content_sanskrit": "सुयोधनस्य मोक्ष्याय प्रयतध्वमतन्द्रिताः \t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2134821, "chapter_id": 3913, "verse_number": "२८", "content_sanskrit": "य एव कश्चिद् राजन्यः शरणार्थमिहागतम् ।\nपरं शक्त्याऽभिरक्षेत किं पुनस्त्वं वृकोदर \t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2134822, "chapter_id": 3913, "verse_number": "२९", "content_sanskrit": "क इहार्यो वदेत् प्राणानभिधावेति चोदिता(तः)।\nप्राञ्जलिं शरणापन्नं दृष्ट्वा शत्रुमपि ध्रुवम् \t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2134823, "chapter_id": 3913, "verse_number": "३०", "content_sanskrit": "वरप्रदानं राज्यं च पुत्रजन्म च पाण्डवाः ।\nशत्रोश्च मोक्षणं क्लेशात् त्रीणि चैकं च तत्समम् \t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2134824, "chapter_id": 3913, "verse_number": "३१", "content_sanskrit": "किमभ्यधिकमेतस्माद् यदापन्नः सुयोधनः ।\nत्वद्बाहुबलमाश्रित्य जीवितं परिमार्गते \t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2134825, "chapter_id": 3913, "verse_number": "३२", "content_sanskrit": "स्वयमेव प्रधावेयं यदि न स्याद् वृकोदर ।\nविततो मे क्रतुर्वीर न हि मेऽत्र विचारणा \t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2134826, "chapter_id": 3913, "verse_number": "३३", "content_sanskrit": "साम्नैव तु यथा भीम मोक्षयेथाः सुयोधनम् ।\nतथा सर्वैरुपायैस्त्वं यतेथाः कुरुनन्दन \t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2134827, "chapter_id": 3913, "verse_number": "३४", "content_sanskrit": "न साम्ना प्रतिपद्येत यदि गन्धर्वराडसौ ।\nपराक्रमेण मृदुना मोक्षयेथाः सुयोधनम् \t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2134828, "chapter_id": 3913, "verse_number": "३५", "content_sanskrit": "अथासौ मृदुयुद्धेन न मुञ्चेद् भीम कौरवान् ।\nसर्वोपायैर्विमोच्यास्ते निगृह्य परिपन्थिनः ।\nएतावद्धि मया शक्यं सन्देष्टुं वै वृकोदर\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2134829, "chapter_id": 3913, "verse_number": "३६", "content_sanskrit": "वैताने कर्मणि तते वर्तमाने च भारत ।\nवरप्रदानं सुमहद् याचकस्य प्रकीर्तितम् \t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2134830, "chapter_id": 3913, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2134831, "chapter_id": 3913, "verse_number": "३७", "content_sanskrit": "अजातशत्रोर्वचनं तच्छ्रुत्वा तु धनञ्जयः ।\nप्रतिजज्ञे गुरोर्वाक्यं कौरवाणां विमोक्षणे(णम्) \t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2134832, "chapter_id": 3913, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2134833, "chapter_id": 3913, "verse_number": "३८", "content_sanskrit": "यदि साम्ना न मोक्ष्यन्ति गन्धर्वा धृतराष्ट्रजान् ।\nअद्य गन्धर्वराजस्य भूमिः पास्यति शोणितम् \t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2134834, "chapter_id": 3913, "verse_number": "३९", "content_sanskrit": "अर्जुनस्य तु तां श्रुत्वा प्रतिज्ञां सत्यवादिनः ।\nकौरवाणां तदा राजन् पुनः प्रत्यागतं मनः \t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2134835, "chapter_id": 3913, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि द्वात्रिंशदधिकद्विशततमोऽध्यायः ॥२३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2134836, "chapter_id": 3913, "verse_number": "", "content_sanskrit": "घोषयात्रापर्वणि दुर्योधनमोचनानुज्ञायां अष्टमोऽध्यायः ॥८॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]