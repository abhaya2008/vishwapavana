[{"id": 5000619000, "chapter_id": 9619, "verse_number": "७-८४-१", "content_sanskrit": "तथोक्तवति रामे तु भरते च महात्मनि ।\nलक्ष्मणो ऽथ शुभं वाक्यमुवाच रघुनन्दनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000619001, "chapter_id": 9619, "verse_number": "७-८४-२", "content_sanskrit": "अश्वमेधो महायज्ञः पावनः सर्वपाप्मनाम् ।\nपावनस्तव दुर्धर्षो रोचतां रघुनन्दन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000619002, "chapter_id": 9619, "verse_number": "७-८४-३", "content_sanskrit": "श्रूयते हि पुरावृत्तं वासवे सुमहात्मनि ।\nब्रह्महत्यावृतः शक्रो हयमेधेन पावितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000619003, "chapter_id": 9619, "verse_number": "७-८४-४", "content_sanskrit": "पुरा किल महाबाहो देवासुरसमागमे ।\nवृत्रो नाम महानासीद्दैतेयो लोकसम्मतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000619004, "chapter_id": 9619, "verse_number": "७-८४-५", "content_sanskrit": "विस्तीर्णो योजनशतमुच्छ्रितस्त्रिगुणं ततः ।\nअनुरागेण लोकांस्त्रीन्स्नेहात्पश्यति सर्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000619005, "chapter_id": 9619, "verse_number": "७-८४-६", "content_sanskrit": "धर्मज्ञश्च कृतज्ञश्च बुद्ध्या च परिनिष्ठितः ।\nशशास पृथिवीं स्फीतां धर्मेण सुसमाहितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000619006, "chapter_id": 9619, "verse_number": "७-८४-७", "content_sanskrit": "तस्मिन्प्रशासति तदा सर्वकामदुघा मही ।\nरसवन्ति प्रभूनानि मूलानि च फलानि च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000619007, "chapter_id": 9619, "verse_number": "७-८४-८", "content_sanskrit": "अकृष्टपच्या पृथिवी सुसम्पन्ना महात्मनः ।\nस राज्यं तादृशं भुङ्क्ते स्फीतमद्भुतदर्शनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000619008, "chapter_id": 9619, "verse_number": "७-८४-९", "content_sanskrit": "तस्य बुद्धिः समुप्तन्ना तपः कुर्यामनुत्तमम् ।\nतपो हि परमं श्रेयः सम्मोहमितरत्सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000619009, "chapter_id": 9619, "verse_number": "७-८४-१०", "content_sanskrit": "स निक्षिप्य सुतं ज्येष्ठं पौरेषु मधुरेश्वरम् ।\nतप उग्रं समातिष्ठत्तापयन्सर्वदेवताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000619010, "chapter_id": 9619, "verse_number": "७-८४-११", "content_sanskrit": "तपस्तप्यति वृत्रे तु वासवः परमार्तवत् ।\nविष्णुं समुपसङ्क्रम्य वाक्यमेतदुवाच ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000619011, "chapter_id": 9619, "verse_number": "७-८४-१२", "content_sanskrit": "तपस्यता महाबाहो लोकाः वृत्रेण निर्जिताः ।\nबलवान्स हि धर्मात्मा नैनं शक्ष्यामि शासितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000619012, "chapter_id": 9619, "verse_number": "७-८४-१३", "content_sanskrit": "यद्यसौ तप आतिष्ठेद्भूय एवासुरेश्वर ।\nयावल्लोका धरिष्यन्ति तावदस्य वशानुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000619013, "chapter_id": 9619, "verse_number": "७-८४-१४", "content_sanskrit": "तं चैनं परमोदारमुपेक्षसि महाबलम् ।\nक्षणं हि न भवेद्वृत्रः क्रुद्धे त्वयि सुरेश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000619014, "chapter_id": 9619, "verse_number": "७-८४-१५", "content_sanskrit": "यदा हि प्रीतिसंयोगं त्वया विष्णो समागतः ।\nतदाप्रभृति लोकानां नाथत्वमुपलब्धवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000619015, "chapter_id": 9619, "verse_number": "७-८४-१६", "content_sanskrit": "स त्वं प्रसादं लोकानां कुरुष्व सुसमाहितः ।\nत्वत्कृतेन हि सर्वं स्याप्रशान्तमरुजं जगत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000619016, "chapter_id": 9619, "verse_number": "७-८४-१७", "content_sanskrit": "इमे हि सर्वे विष्णो त्वां निरीक्षन्ते दिवौकसः ।\nवृत्रघातेन महता तेषां साह्यं कुरुष्व ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000619017, "chapter_id": 9619, "verse_number": "७-८४-१८", "content_sanskrit": "त्वया हि नित्यशः साह्यं कृतमेषां महात्मनाम् ।\nअसह्यमिदमन्येषामगतीनां गतिर्भवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000619018, "chapter_id": 9619, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये श्रीमदुत्तरकाण्डे चतुरशीतितमः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}]