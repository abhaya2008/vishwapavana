[{"id": 2170458, "chapter_id": 4640, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2170459, "chapter_id": 4640, "verse_number": "१", "content_sanskrit": "कर्णोऽथ शरजालेन केकयानां महारथान् ।\nव्यधमत् परमेष्वासानग्रतः पर्यवस्थितान्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2170460, "chapter_id": 4640, "verse_number": "२", "content_sanskrit": "तेषां प्रयतमानानां राधेयस्य निवारणे ।\nरथान् पञ्चशतान् कर्णः प्राहिणोद् यमसादनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2170461, "chapter_id": 4640, "verse_number": "३", "content_sanskrit": "अविषह्यं ततो दृष्ट्वा राधेयं युधि योधिनः ।\nभीमसेनमुपागच्छन् कर्णबाणप्रपीडिताः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2170462, "chapter_id": 4640, "verse_number": "४", "content_sanskrit": "रथानीकं विदार्यैव शरजालैरनेकधा ।\nकर्णस्त्वेको रथेनैव पुनरायाद् युधिष्ठिरम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2170463, "chapter_id": 4640, "verse_number": "५", "content_sanskrit": "सेनानिवेशमार्च्छन्तं मार्गणैः क्षतविक्षतम् ।\nयमयोर्मध्यगं वीरं शनैर्यान्तं विचेतसम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2170464, "chapter_id": 4640, "verse_number": "६", "content_sanskrit": "समासाद्य तु राजानं दुर्योधनहितेप्सया ।\nसूतपुत्रस्त्रिभिस्तीक्ष्णैर्विव्याध परमेषुभिः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2170465, "chapter_id": 4640, "verse_number": "७", "content_sanskrit": "तथैव राजा राधेयं प्रत्यविध्यत्स्तनान्तरे ।\nशरैस्त्रिभिश्च यन्तारं चतुर्भिश्चतुरो हयान्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2170466, "chapter_id": 4640, "verse_number": "८", "content_sanskrit": "चक्ररक्षौ तु पार्थस्य माद्रीपुत्रौ परन्तपौ ।\nतावप्यधावतां कर्णं राजानं मा वधीरिति\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2170467, "chapter_id": 4640, "verse_number": "९", "content_sanskrit": "आवां रणे विनिर्जित्य पातयाद्य महाभुज ।\nत्वं धर्मशास्त्रविद् वीर ब्रह्मण्यस्त्वमनुत्तमः \t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2170468, "chapter_id": 4640, "verse_number": "१०", "content_sanskrit": "त्वं दानशूरो विक्रान्तस्त्वं धुनुर्वेदविद्वरः ।\nमावधीर्धर्मराजानमिति चाकुलतां गतौ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2170469, "chapter_id": 4640, "verse_number": "११", "content_sanskrit": "तौ पृथक्शरवर्षाभ्यां राधेयमभ्यवर्षताम् ।\nनकुलः सहदेवश्च परमं यत्नमास्थितौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2170470, "chapter_id": 4640, "verse_number": "१२", "content_sanskrit": "तथैव तौ प्रत्यविध्यत् सूत्रपुत्रः प्रतापवान् ।\nभल्लाभ्यां शितधाराभ्यां महात्मानावरिन्दमौ\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2170471, "chapter_id": 4640, "verse_number": "१३", "content_sanskrit": "दन्तवर्णांस्तु राधेयो निजघान मनोजवान् ।\nयुधिष्ठिरस्य सङ्ग्रामे कालवालान् हयोत्तमान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2170472, "chapter_id": 4640, "verse_number": "१४", "content_sanskrit": "ततोऽपरेण भल्लेन शिरस्त्राणमपातयत् ।\nकौन्तेयस्य महेष्वासः प्रहसन्निव सूतजः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2170473, "chapter_id": 4640, "verse_number": "१५", "content_sanskrit": "तथैव नकुलस्यापि हयान् हत्वा प्रतापवान् ।\nईषां धनुश्च चिच्छेद माद्रीपुत्रस्य धीमतः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2170474, "chapter_id": 4640, "verse_number": "१६", "content_sanskrit": "तौ हताश्वौ हतरथौ पाण्डवौ भृशविक्षतौ ।\nभ्रातरावारुरुहतुः सहदेवरथं तदा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2170475, "chapter_id": 4640, "verse_number": "१७", "content_sanskrit": "तौ दृष्ट्वा मातुलस्तत्र विरथौ परवीरहा ।\nअभ्यभाषत राधेयं मद्रराजोऽनुकम्पया\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2170476, "chapter_id": 4640, "verse_number": "१८", "content_sanskrit": "योद्धव्यमद्य पार्थेन फल्गुनेन त्वया सह ।\nकिमर्थं धर्मराजेन युध्यसे भृशरोषितः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2170477, "chapter_id": 4640, "verse_number": "१९", "content_sanskrit": "क्षीणशस्त्रास्त्रकवचः क्षीणबाणो विबाणधिः ।\nश्रान्तसारथिवाहश्च च्छन्नोऽस्त्रैररिभिस्तथा\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2170478, "chapter_id": 4640, "verse_number": "२०", "content_sanskrit": "पार्थमासाद्य राधेय उपहास्यो भविष्यसि\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2170479, "chapter_id": 4640, "verse_number": "२१", "content_sanskrit": "एवमुक्तोऽपि कर्णस्तु मद्रराजेन संयुगे ।\nतथैव कर्णः संरब्धो युधिष्ठिरमताडयत्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2170480, "chapter_id": 4640, "verse_number": "२२", "content_sanskrit": "शरैस्तीक्ष्णैः पराविध्य माद्रीपुत्रौ च पाण्डवौ ।\nप्रहस्य समरे कर्णश्चकार विमुखौ शरैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2170481, "chapter_id": 4640, "verse_number": "२३", "content_sanskrit": "ततः शल्यः प्रहस्येदं कर्णं पुनरुवाच ह ।\nरथस्थमतिसंरब्धं युधिष्ठिरवधे धृतम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2170482, "chapter_id": 4640, "verse_number": "२४", "content_sanskrit": "यदर्थं धार्तराष्ट्रेण सततं मानितो भवान् ।\nतं पार्थं जहि राधेय किं ते हत्वा युधिष्ठिरम्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2170483, "chapter_id": 4640, "verse_number": "२५", "content_sanskrit": "शङ्खयोर्ध्मायतोः शब्दः सुमहानेष कृष्णयोः ।\nश्रूयते चापघोषोऽयं प्रावृषीवाम्बुदस्य ह\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2170484, "chapter_id": 4640, "verse_number": "२६", "content_sanskrit": "असौ निघ्नन् रथोदारानर्जुनः शरवृष्टिभिः ।\nसर्वां ग्रसति नः सेनां कर्ण पश्यैनमाहवे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2170485, "chapter_id": 4640, "verse_number": "२७", "content_sanskrit": "पृष्ठरक्षौ च शूरस्य युधामन्यूत्तमौजसौ ।\nउत्तरं चास्य वै शूरश्चक्रं रक्षति सात्यकिः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2170486, "chapter_id": 4640, "verse_number": "२८", "content_sanskrit": "धृष्टद्युम्नस्तथा चास्य चक्रं रक्षति दक्षिणम्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2170487, "chapter_id": 4640, "verse_number": "२९", "content_sanskrit": "भीमसेनश्च वै राज्ञा धार्तराष्ट्रेण युध्यते ।\nयथा न हन्यात्तं भीमः सर्वेषां नोऽद्य पश्यताम् ।\nतथा राधेय क्रियतां राजा मुच्येत नो यथा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2170488, "chapter_id": 4640, "verse_number": "३०", "content_sanskrit": "पश्यैनं भीमसेनेन ग्रस्तमाहवशोभिना ।\nयदि त्वासाद्य मुच्येत विस्मयः सुमहान् भवेत्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2170489, "chapter_id": 4640, "verse_number": "३१", "content_sanskrit": "परित्राह्येनमभ्येत्य संशयं परमं गतम् ।\nकिं नु माद्रीसुतौ हत्वा राजानं च युधिष्ठिरम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2170490, "chapter_id": 4640, "verse_number": "समाप्तिः", "content_sanskrit": "इति शल्यवचः श्रुत्वा राधेयः पृथिवीपते ।\nदृष्ट्वा दुर्योधनं चैव भीमग्रस्तं महाहवे\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2170491, "chapter_id": 4640, "verse_number": "३३", "content_sanskrit": "राजगृद्धी भृशं चैव शल्यवाक्यप्रचोदितः ।\nअजातशत्रुमुत्सृज्य माद्रीपुत्रौ च पाण्डवौ\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2170492, "chapter_id": 4640, "verse_number": "३४", "content_sanskrit": "तव पुत्रं परित्रातुमभ्यधावत वीर्यवान् ।\nमद्रराजप्रणुदितैरश्वैराकाशगैरिव\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2170493, "chapter_id": 4640, "verse_number": "३५", "content_sanskrit": "गते कर्णे तु कौन्तेयः पाण्डुपुत्रो युधिष्ठिरः ।\nअपायाज्जवनैरश्वैः सहदेवस्य मारिष\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2170494, "chapter_id": 4640, "verse_number": "३६", "content_sanskrit": "ताभ्यां स सहितस्तूर्णं व्रीडन्निव नरेश्वरः ।\nप्राप्य सेनानिवेशं च मार्गणैः क्षतविक्षतः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2170495, "chapter_id": 4640, "verse_number": "३७", "content_sanskrit": "अवतीर्णो रथात् तूर्णमाविशच्छयनं शुभम् ।\nअपेतशल्यः सुभृशं हृच्छल्याभिनिपीडितः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2170496, "chapter_id": 4640, "verse_number": "३८", "content_sanskrit": "सोऽब्रवीद् भ्रातरौ राजा माद्रीपुत्रौ महारथौ ।\nअनीकं भीमसेनस्य पाण्डवावाशु गच्छताम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2170497, "chapter_id": 4640, "verse_number": "३९", "content_sanskrit": "जीमूत इव नर्दंस्तु युध्यते स वृकोदरः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2170498, "chapter_id": 4640, "verse_number": "४०", "content_sanskrit": "ततोऽन्यं रथमास्थाय नकुलो रथपुङ्गवः ।\nसहदेवश्च तेजस्वी भ्रातरौ शत्रुकर्शनौ\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2170499, "chapter_id": 4640, "verse_number": "४१", "content_sanskrit": "तुरगैरग्र्यरंहोभिर्यात्वा भीमस्य शुष्मिणौ ।\nअनीकं सहितौ तत्र भ्रातरौ पर्यवस्थितौ\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2170500, "chapter_id": 4640, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nषष्टितमोऽध्यायः ॥६०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]