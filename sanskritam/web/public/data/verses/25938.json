[{"id": 7005938000, "chapter_id": 25938, "verse_number": "१-१२१-१", "content_sanskrit": "ब्रह्मोवाच ।\nचातुर्मास्यव्रतान्यूचे एकादश्यां समाचरेत् ।\nआषाढ्यां पौर्णमास्यां वा सर्वेणहरिमर्च्यच ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005938001, "chapter_id": 25938, "verse_number": "१-१२१-२", "content_sanskrit": "इदं व्रतं मया देव गृहीतं पुरतस्तव ।\nनिर्विघ्नं सिद्धिमाप्नोतु प्रसन्ने त्वयि केशव ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005938002, "chapter_id": 25938, "verse_number": "१-१२१-३", "content_sanskrit": "गृहीतेऽस्मिन्व्रते देव यद्यपूर्णे म्रियाम्यहम्। ।\nतन्मे भवतु सम्पूर्णं त्वत्प्रसादाज्जनार्दन ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005938003, "chapter_id": 25938, "verse_number": "१-१२१-४", "content_sanskrit": "एवमभ्यर्च्य गृह्णीयाद्व्रतार्चनजपादिकम् ।\nसर्वाघं च क्षयं याति चिकीर्षेद्यो हरेर्व्रतम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005938004, "chapter_id": 25938, "verse_number": "१-१२१-५", "content_sanskrit": "स्नात्वायोभ्यच्य गृह्णीयाद्व्रतार्चनजपादिकम् ।\nस्नात्वा यच्चतुरो मासानेकभक्तेन पूजयेत् ।\nविष्णुं स याति विष्णोर्व लोकं मलविवर्जितम् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005938005, "chapter_id": 25938, "verse_number": "१-१२१-६", "content_sanskrit": "मद्यमांससुरात्यगी वेदविद्धरिपूजनात् ।\nतैलवर्जि विष्णुलोकं विष्णुभाक्कृच्छ्रपादकृत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005938006, "chapter_id": 25938, "verse_number": "१-१२१-७", "content_sanskrit": "एकरात्रोपवासाच्च देवो वैमानिको भवेत् ।\nश्वेतद्वीपं त्रिरात्रात्तु व्रजेत्षष्ठान्नकृन्नरः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005938007, "chapter_id": 25938, "verse_number": "१-१२१-८", "content_sanskrit": "चान्द्रायणाद्धरेर्धाम लभेन्मुक्तिमयाचिताम् ।\nप्राजापत्यं विष्णुलोकं पराकव्रतकृद्धरिम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005938008, "chapter_id": 25938, "verse_number": "१-१२१-९", "content_sanskrit": "सक्तुयावकभिक्षाशी पयोदधिघृताशनः ।\nगोमूत्रयावकाहारः पञ्चगव्यकृताशनः ।\nशाकमलफलाद्याशी रसवर्जो च विष्णुभाक् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}]