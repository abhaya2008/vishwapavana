[{"id": 2095183, "chapter_id": 3033, "verse_number": "१३-१६३-१", "content_sanskrit": "युधिष्ठिर उवाच।\nसर्वेषामेव वर्णानां म्लेच्छानां च पितामह।\nउपवासे मतिरियं कारणं च न विद्महे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2095184, "chapter_id": 3033, "verse_number": "१३-१६३-२", "content_sanskrit": "ब्रह्मक्षत्रेण नियमाः कर्तव्या इति नः श्रुतम्।\nउपवासे कथं तेषां कृतमस्ति पितामह।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2095185, "chapter_id": 3033, "verse_number": "१३-१६३-३", "content_sanskrit": "नियमांश्चोपवासांश्च सर्वेषां ब्रूहि पार्थिव।\nआप्नोति कां गतिं तात उपवासपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2095186, "chapter_id": 3033, "verse_number": "१३-१६३-४", "content_sanskrit": "उपवासः परं पुण्यं पवित्रमपि चोत्तमम्॥\nउपोष्येह नरश्रेष्ठ किं फलं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2095187, "chapter_id": 3033, "verse_number": "१३-१६३-५", "content_sanskrit": "अधर्मान्मुच्यते केन धर्ममाप्नोति वा कथम्।\nस्वर्गं पुण्यं च लभते कथं भरतसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2095188, "chapter_id": 3033, "verse_number": "१३-१६३-६", "content_sanskrit": "उपोष्य चापि किं तेन प्रयोज्यं स्यान्नराधिप।\nधर्मेण च सुखानर्थाँल्लभेद्येन ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2095189, "chapter_id": 3033, "verse_number": "१३-१६३-७x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2095190, "chapter_id": 3033, "verse_number": "१३-१६३-७", "content_sanskrit": "एवं ब्रुवाणं कौन्तेयं धर्मज्ञं धर्मतत्त्ववित्।\nधर्मपुत्रमिदं वाक्यं भीष्मः शान्तनवोऽब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2095191, "chapter_id": 3033, "verse_number": "१३-१६३-८", "content_sanskrit": "इदं खलु महाराज श्रुतमासीत्पुरातनम्।\nउपावासविधौ श्रेष्ठा गुणा ये भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2095192, "chapter_id": 3033, "verse_number": "१३-१६३-९", "content_sanskrit": "प्राजापत्यमाङ्गिरसं पृष्टवानस्मि भारत।\nयथा मां त्वं तथैवाहं पृष्टवांस्तं तपोधनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2095193, "chapter_id": 3033, "verse_number": "१३-१६३-१०", "content_sanskrit": "प्रश्नमेतं मया पृष्टो भगवानग्निसम्भवः।\nउपवासविधिं पुण्यमाचष्ट भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2095194, "chapter_id": 3033, "verse_number": "१३-१६३-११x", "content_sanskrit": "अङ्गिरा उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2095195, "chapter_id": 3033, "verse_number": "१३-१६३-११", "content_sanskrit": "ब्रह्मक्षत्रे त्रिरात्रं तु विहितं कुरुनन्दन।\nद्विस्त्रिरात्रमथैकाहं निर्दिष्टं पुरुषर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2095196, "chapter_id": 3033, "verse_number": "१३-१६३-१२", "content_sanskrit": "वैश्याः शूद्राश्च यन्मोहादुपवासं प्रकुर्वते।\nत्रिरात्रं वा द्विराइत्रं वा तयोर्व्युष्टिर्न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2095197, "chapter_id": 3033, "verse_number": "१३-१६३-१३", "content_sanskrit": "चतुर्थभक्तक्षपणं वैश्ये शूद्रे विधीयते।\nत्रिरात्रं न तु धर्मज्ञैर्विहितं ब्रह्मवादिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2095198, "chapter_id": 3033, "verse_number": "१३-१६३-१४", "content_sanskrit": "पञ्चम्यां वाऽपि षष्ठ्यां च पौर्णमास्यां च भारत।\nउपोष्य एकभक्तेन नियतात्मा जितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2095199, "chapter_id": 3033, "verse_number": "१३-१६३-१५", "content_sanskrit": "क्षमावान्रूपसम्पन्नः सुरभिश्चैव जायते।\nनानपत्यो भवेत्प्राज्ञो दरिद्रो वा कदाचन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2095200, "chapter_id": 3033, "verse_number": "१३-१६३-१६", "content_sanskrit": "यजिष्णुः पञ्चमीं षष्ठीं कुले भोजयते द्विजान्।\nअष्टमीमथ कौरव्य कृष्णपक्षे चतुर्दशीम्।\nउपोष्य व्याधिरहितो वीर्यवानभिजायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2095201, "chapter_id": 3033, "verse_number": "१३-१६३-१७", "content_sanskrit": "मार्गशीर्षं तु वै मासमेकभक्तेन यः क्षिपेत्।\nभोजयेच्च द्विजाञ्शक्त्या स मुच्येद्व्याधिकिल्बिषैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2095202, "chapter_id": 3033, "verse_number": "१३-१६३-१८", "content_sanskrit": "सर्वकल्याणसम्पूर्णः सर्वौषधिसमन्वितः।\nकृषिभागी बहुधनो बहुधान्यश्च जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2095203, "chapter_id": 3033, "verse_number": "१३-१६३-१९", "content_sanskrit": "पौषमासं तु कौन्तेय भक्तेनैकेन यः क्षिपेत्।\nसुभगो दर्शनीयश्च यशोभागी च जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2095204, "chapter_id": 3033, "verse_number": "१३-१६३-२०", "content_sanskrit": "पितृभक्तो माघमासं यः क्षिपेदेकभोजनः।\nश्रीमत्कुले ज्ञातिमध्ये सुभगत्वं प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2095205, "chapter_id": 3033, "verse_number": "१३-१६३-२१", "content_sanskrit": "भगदैवतमासं तु एकभक्तेन यः क्षिपेत्।\n`सुभगो दर्शनीयश्च यशोभागी च जायते।\nस्त्रीषु वल्लभतां याति वश्याश्चास्य भवन्ति ताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2095206, "chapter_id": 3033, "verse_number": "१३-१६३-२२", "content_sanskrit": "चैत्रं तु नियतो मासमेकभक्तेन यः क्षिपेत्।\nसुवर्णमणिमुक्ताढ्ये कुले महति जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2095207, "chapter_id": 3033, "verse_number": "१३-१६३-२३", "content_sanskrit": "निस्तरेदेकभक्तेन वैशाखं यो जितेन्द्रियः।\nनरो वा यदि वा नरी ज्ञातीनां श्रेष्ठतां व्रजेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2095208, "chapter_id": 3033, "verse_number": "१३-१६३-२४", "content_sanskrit": "ज्येष्ठामूलं तु यो मासमेकभक्तेन संक्षिपेत्।\nऐश्वर्यमतुलं श्रेष्ठं पुमान्स्त्री वा प्रपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2095209, "chapter_id": 3033, "verse_number": "१३-१६३-२५", "content_sanskrit": "आषाढमेकभक्तेन स्थित्वा मासमतन्द्रितः।\nबहुधान्यो बहुधनो बहुपुत्रश्च जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2095210, "chapter_id": 3033, "verse_number": "१३-१६३-२६", "content_sanskrit": "श्रावणं नियतो मासमेकभक्तेन यः क्षिपेत्।\nरूपद्रविणसम्पन्नः सुखी भवति नित्यशः।\nबहुभार्यो बहुधनो बहुपुत्रश्चि जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2095211, "chapter_id": 3033, "verse_number": "१३-१६३-२७", "content_sanskrit": "प्रौष्ठपादं तु यो मासमेकाहारो भवेन्नरः।\nगवाढ्यं स्फीतमचलमैश्वर्यं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2095212, "chapter_id": 3033, "verse_number": "१३-१६३-२८", "content_sanskrit": "तथैवाश्वयुजं मासमेकभक्तेन यः क्षिपेत्।\nप्रज्ञावान्वाहनाढ्यश्च बहुपुत्रश्च जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2095213, "chapter_id": 3033, "verse_number": "१३-१६३-२९", "content_sanskrit": "कार्तिकं तु नरो मासं यः कुर्यादेकभोजनम्।\nशूरश्च बहुभार्यश्च कीर्तिमांश्चैव जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2095214, "chapter_id": 3033, "verse_number": "१३-१६३-३०", "content_sanskrit": "इति मासा नरव्याघ्र क्षिपतां परिकीर्तिताः।\nतिथीनां नियमा ये तु शृणु तानपि पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2095215, "chapter_id": 3033, "verse_number": "१३-१६३-३१", "content_sanskrit": "पक्षेपक्षे गते यस्तु भक्तमश्नाति भारत।\nगवाढ्यो बहुपुत्रश्च दीर्घायुश्च स जायते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2095216, "chapter_id": 3033, "verse_number": "१३-१६३-३२", "content_sanskrit": "मासिमासि त्रिरात्राणि कृत्वा वर्षाणि द्वादश।\nगणाधिपत्यं प्राप्नोति निःसपत्नमनाविलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2095217, "chapter_id": 3033, "verse_number": "१३-१६३-३३", "content_sanskrit": "एते तु नियमाः सर्वे कर्तव्याः शरदो दश।\nद्वे चान्ये भरतश्रेष्ठ प्रवृत्तिरनुकीर्तिता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2095218, "chapter_id": 3033, "verse_number": "१३-१६३-३४", "content_sanskrit": "यस्तु प्रातस्तथा सायं भुञ्जानो नान्तरा पिबेत्।\nअहिंसानिरतो नित्यं जुह्वानो जातवेदसम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2095219, "chapter_id": 3033, "verse_number": "१३-१६३-३५", "content_sanskrit": "षड्भिः स वर्षैर्नृपते सिध्यते नाइत्र संशयः।\nअग्निष्टोमस्य यज्ञस्य फलं प्राप्नोति मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2095220, "chapter_id": 3033, "verse_number": "१३-१६३-३६", "content_sanskrit": "अधिवासे सोप्सरसां नृत्यगीतविनादिते।\nरमते स्त्रीसहस्राढ्ये सुकुती विरजा नरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2095221, "chapter_id": 3033, "verse_number": "१३-१६३-३७", "content_sanskrit": "तप्तकाञ्चनवर्णाभं विमानमधिरोहति।\nपूर्णं वर्षसहस्रं च ब्रह्मिलोके महीयते।\nतत्क्षयादिह चागम्य माहात्म्यं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2095222, "chapter_id": 3033, "verse_number": "१३-१६३-३८", "content_sanskrit": "यस्तु संवत्सरं पूर्णमेकाहारो भवेन्नरः।\nअतिरात्रस्य यज्ञस्य स फलं समुपाश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2095223, "chapter_id": 3033, "verse_number": "१३-१६३-३९", "content_sanskrit": "त्रिंशद्वर्षसहस्राणि स्वर्गे च स महीयते।\nतत्क्षयादिह चागम्य माहात्म्यं प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2095224, "chapter_id": 3033, "verse_number": "१३-१६३-४०", "content_sanskrit": "यस्तु संवत्सरं पूर्णं चतुर्थं भक्तमश्नुते।\nअहिंसानिरतो नित्यं सत्यवाग्विजितेन्द्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2095225, "chapter_id": 3033, "verse_number": "१३-१६३-४१", "content_sanskrit": "वाजपेयस्य यज्ञस्य स फलं समुपाश्नुते।\nत्रिंशद्वर्षसहस्राणि स्वर्गलोके महीयते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2095226, "chapter_id": 3033, "verse_number": "१३-१६३-४२", "content_sanskrit": "षष्ठे काले तु कौन्तेय नरः संवत्सरं क्षिपन्।\nअश्वमेधस्य यज्ञस्य फलं प्राप्नोति मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2095227, "chapter_id": 3033, "verse_number": "१३-१६३-४३", "content_sanskrit": "चक्रवाकप्रयुक्तेन विमानेन स गच्छति।\nचत्वारिंशत्सहस्राणि वर्षाणि दिवि मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2095228, "chapter_id": 3033, "verse_number": "१३-१६३-४४", "content_sanskrit": "अष्टमेन तु भक्तेन जीवन्संवत्सरं नृप।\nगवामयनयज्ञस्य फलं प्राप्नोति मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2095229, "chapter_id": 3033, "verse_number": "१३-१६३-४५", "content_sanskrit": "हंससारसयुक्तेन विमानेन स गच्छति।\nपञ्चाशतं सहस्राणि वर्षाणां दिवि मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2095230, "chapter_id": 3033, "verse_number": "१३-१६३-४६", "content_sanskrit": "पक्षेपक्षे गते राजन्योऽश्नीयाद्वर्षमेव तु।\nषण्मासानशनं तस्य भगवानङ्गिराऽब्रवीत्।\nषष्टिं वर्षसहस्राणि दिवमावसते च सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2095231, "chapter_id": 3033, "verse_number": "१३-१६३-४७", "content_sanskrit": "विणानां वल्लकीनां च वेणूनां च विशाम्पते।\nसुघोषैर्मधुरैः शब्दैः सुप्तः स प्रतिबोध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2095232, "chapter_id": 3033, "verse_number": "१३-१६३-४८", "content_sanskrit": "संवत्सरमिहैकं तु मासिमासि पिबेदपः।\nफलं विश्वजितस्तात प्राप्नोति स नरो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2095233, "chapter_id": 3033, "verse_number": "१३-१६३-४९", "content_sanskrit": "सिंहव्याघ्रप्रयुक्तेन विमानेन स गच्छति।\nसप्ततिं च सहस्राणि वर्षाणां दिवि मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2095234, "chapter_id": 3033, "verse_number": "१३-१६३-५०", "content_sanskrit": "मासादूर्ध्वं नरव्याघ्र नोपवासो विधीयते।\nविधिं त्वनशनस्याहुः पार्थ धर्मविदो जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2095235, "chapter_id": 3033, "verse_number": "१३-१६३-५१", "content_sanskrit": "अनार्तो व्याधिरहितो गच्छेदनशनं तु यः।\nपदेपदे यज्ञफलं स प्राप्नोति न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2095236, "chapter_id": 3033, "verse_number": "१३-१६३-५२", "content_sanskrit": "दिवं हंसप्रयुक्तेन विमानेन स गच्छति।\nशतं वर्षसहस्राणां मोदते स दिवि प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2095237, "chapter_id": 3033, "verse_number": "१३-१६३-५३", "content_sanskrit": "शतं चाप्सरसः कन्या रमयन्त्यपि तं नरम्।\nआर्तो वा व्याधितो वाऽपि गच्छेदनशनं तु यः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2095238, "chapter_id": 3033, "verse_number": "१३-१६३-५४", "content_sanskrit": "शतं वर्षसहस्राणां मोदते स दिवि प्रभो।\nकाञ्चीनूपुरशब्देन सुप्तश्चैव प्रबोध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2095239, "chapter_id": 3033, "verse_number": "१३-१६३-५५", "content_sanskrit": "सहस्रहंसयुक्तेन विमानेन तु गच्छति।\nस गत्वा स्त्रीशताकीर्णे रमते भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2095240, "chapter_id": 3033, "verse_number": "१३-१६३-५६", "content_sanskrit": "क्षीणस्याप्यायनं दृष्टं क्षतस्य क्षतरोहणम्।\nव्याधितस्यौषधग्रामः क्रुद्धस्य च प्रसादनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2095241, "chapter_id": 3033, "verse_number": "१३-१६३-५७", "content_sanskrit": "दुःखितस्यार्तपूर्वस्य द्रव्याणां प्रतिपादनम्।\nन चैतद्रोचते तेषां ये धनैः सुखमेधिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2095242, "chapter_id": 3033, "verse_number": "१३-१६३-५८", "content_sanskrit": "अतः स कामसंयुक्ते विमाने हेमसन्निभे।\nरमते स्त्रीशताकीर्णे पुरुषोऽलङ्कृतः शुचिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2095243, "chapter_id": 3033, "verse_number": "१३-१६३-५९", "content_sanskrit": "स्वस्थः सफलसङ्कल्पः सुखी विगतकल्मषः।\nअनश्नन्देहमुत्सृज्य फलं प्राप्नोति मानवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2095244, "chapter_id": 3033, "verse_number": "१३-१६३-६०", "content_sanskrit": "बालसूर्यप्रतीकाशे विमाने सोमवर्चसि।\nवैदूर्यमुक्ताखचिते वीणामुरजनादिते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2095245, "chapter_id": 3033, "verse_number": "१३-१६३-६१", "content_sanskrit": "पताकादीपिकाकीर्णे दिव्यघण्टानिनादिते।\nस्त्रीसहस्रानुचरिते स नरः सुखमेधते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2095246, "chapter_id": 3033, "verse_number": "१३-१६३-६२", "content_sanskrit": "यावन्ति रोमकूपाणि तस्य गात्रेषु पाण्डव।\nतावन्त्येव सहस्राणि वर्षाणां दिवि मोदते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2095247, "chapter_id": 3033, "verse_number": "१३-१६३-६३", "content_sanskrit": "नास्ति वेदात्परं शास्त्रं नास्ति मातृसमो गुरुः।\nन धर्मात्परमो लाभस्तपो नानशनात्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2095248, "chapter_id": 3033, "verse_number": "१३-१६३-६४", "content_sanskrit": "ब्राह्मणेभ्यः परं नास्ति पावनं दिवि चेह च।\nउपवासैस्तथा तुल्यं तपःकर्म न विद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2095249, "chapter_id": 3033, "verse_number": "१३-१६३-६५", "content_sanskrit": "उपोष्य विधिवद्देवास्त्रिदिवं प्रतिपेदिरे।\nऋषयश्च परां सिद्धिमुपवासैरवाप्नुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2095250, "chapter_id": 3033, "verse_number": "१३-१६३-६६", "content_sanskrit": "दिव्यवर्षसहस्राणि विश्वामित्रेण धीमता।\nक्षान्तमेकेन भक्तेन तेन विप्रत्वमागतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2095251, "chapter_id": 3033, "verse_number": "१३-१६३-६७", "content_sanskrit": "च्यवनो जमदग्निश्च वसिष्ठो गौतमो भृगुः।\nसर्व एव दिवं प्राप्ताः क्षमावन्तो महर्षयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2095252, "chapter_id": 3033, "verse_number": "१३-१६३-६८", "content_sanskrit": "इदमङ्गीरसा पूर्वं महर्षिभ्यः प्रदर्शितम्।\nयः प्रदर्शयते नित्यं न स दुःखमवाप्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2095253, "chapter_id": 3033, "verse_number": "१३-१६३-६९", "content_sanskrit": "इमं तु कौन्तेय यथाक्रमं विधिं\nप्रवर्तितं ह्यङ्गिरसा महर्षिणा।\nपठेच्च यो वै शृणुयाच्च नित्यदा\nन विद्यते तस्य नरस्य किल्बिषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2095254, "chapter_id": 3033, "verse_number": "१३-१६३-७०", "content_sanskrit": "विमुच्यते चापि स सर्वसङ्करै-\nर्न चास्य दोषैरभिभूयते मनः।\nवियोनिजानां च विजानते रुतं\nध्रुवां च कीर्तिं लभते नरोत्तमः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2095255, "chapter_id": 3033, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि त्रिष्ट्यधिकशततमोऽध्यायः॥ १६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}]