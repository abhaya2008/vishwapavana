[{"id": 6000022000, "chapter_id": 10022, "verse_number": null, "content_sanskrit": "अथ द्वितीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000022001, "chapter_id": 10022, "verse_number": null, "content_sanskrit": "शुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.001.m4a", "display_order": 2}, {"id": 6000022002, "chapter_id": 10022, "verse_number": "२-२-१", "content_sanskrit": "एवं पुरा धारणयाऽऽत्मयोनिर्नष्टां स्मृतिं प्रत्यवरुह्य तुष्यन्।\nतथा ससर्जेदममोघदृष्टिर्यथाऽप्ययात्प्राग्व्यवसायबुद्धिः॥ २/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.002.m4a", "display_order": 3, "topics": [{"text": "शुकेन परीक्षितं प्रति हृदयकमले भगवदुपासनाप्रकारतत्फलयोः कथनम्", "range": "१–१९"}]}, {"id": 6000022003, "chapter_id": 10022, "verse_number": "२-२-२", "content_sanskrit": "शब्दस्य हि ब्रह्मण एष पन्था यन्नामभिर्ध्यायति धीरपार्थैः।\nपरिभ्रमंस्तत्र न विन्दतेऽर्थान् मायामये वासनया शयानः॥ २/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.003.m4a", "display_order": 4}, {"id": 6000022004, "chapter_id": 10022, "verse_number": "२-२-३", "content_sanskrit": "अतः कविर्नामसु यावदर्थः स्यादप्रमत्तो व्यवसायबुद्धिः।\nसिद्धेऽन्यथाऽर्थे न यतेत तत्तत्परिश्रमं तत्र समीक्षमाणः॥ २/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.004.m4a", "display_order": 5}, {"id": 6000022005, "chapter_id": 10022, "verse_number": "२-२-४", "content_sanskrit": "सत्यां क्षितौ किं कशिपोः प्रयासैर्बाहौ स्वसिद्धे ह्युपबर्हणैः किम्।\nसत्यञ्जलौ किं पुरुपर्णपात्रैर्दिग्वस्‍त्रलाभे सति किं दुकूलैः॥ २/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.005.m4a", "display_order": 6}, {"id": 6000022006, "chapter_id": 10022, "verse_number": "२-२-५", "content_sanskrit": "चीराणि किं पथि न सन्ति दिशन्ति भिक्षां नो वाऽङ्घ्रिपाः परभृतः सरितोऽप्यशुष्यन्।\nरुद्धा गुहाः किमवधूतसुहृन्न कृष्णः कस्माद्भजन्ति कवयो धनदुर्मदान्धान्॥ २/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.006.m4a", "display_order": 7}, {"id": 6000022007, "chapter_id": 10022, "verse_number": "२-२-६", "content_sanskrit": "एवं स्वचित्ते स्वत एव सिद्ध आत्मा प्रियोऽर्थो भगवाननन्तः।\nतं निर्वृतो नियतार्थो भजेत संसारहेतूपरमश्च यत्र॥ २/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.007.m4a", "display_order": 8}, {"id": 6000022008, "chapter_id": 10022, "verse_number": "२-२-७", "content_sanskrit": "स सर्वविद्हृद्यनुभूश्च सर्व आत्मा यथा सुप्तजनेक्षितैकः।\nतं सत्यमानन्दनिधिं भजेत सर्वात्मनाऽतोऽन्यत आत्मघातः॥ २/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.008.m4a", "display_order": 9}, {"id": 6000022009, "chapter_id": 10022, "verse_number": "२-२-८", "content_sanskrit": "कस्तं त्वनादृत्य परानुचिन्तामृते पशुत्वमसतीं नाम युञ्ज्यात्।\nपश्यन् जनं पतितं वैतरण्यां स्वकर्मजान्परितापाञ्जुषाणम्॥ २/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.009.m4a", "display_order": 10}, {"id": 6000022010, "chapter_id": 10022, "verse_number": "२-२-९", "content_sanskrit": "केचित्स्वदेहान्तर्हृदयावकाशे प्रादेशमात्रं पुरुषं वसन्तम्।\nचतुर्भुजं कञ्जरथाङ्गशङ्खगदाधरं धारणया स्मरन्ति॥ २/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.010.m4a", "display_order": 11}, {"id": 6000022011, "chapter_id": 10022, "verse_number": "२-२-१०", "content_sanskrit": "प्रसन्नवक्त्रं नलिनायतेक्षणं कदम्बकिञ्जल्कपिशङ्गवाससम्।\nलसन्महाहारहिरण्मयाङ्गदं स्फुरन्महारत्नकिरीटकुण्डलम्॥ २/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.011.m4a", "display_order": 12}, {"id": 6000022012, "chapter_id": 10022, "verse_number": "२-२-११", "content_sanskrit": "उन्निद्रहृत्पङ्कजकर्णिकालये योगेश्वरास्थापितपादपल्‍लवम्।\nश्रीलक्षणं कौस्तुभरत्नकन्धरमम्लानलक्ष्म्या वनमालयाऽञ्चितम्॥ २/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.012.m4a", "display_order": 13}, {"id": 6000022013, "chapter_id": 10022, "verse_number": "२-२-१२", "content_sanskrit": "विभूषितं मेखलयाऽङ्गुलीयकैर्महाधनैर्नूपुरकङ्कणादिभिः।\nस्निग्धामलैः कुञ्चितनीलकुन्तलैर्विरोचमानाननहासपेशलम्॥ २/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.013.m4a", "display_order": 14}, {"id": 6000022014, "chapter_id": 10022, "verse_number": "२-२-१३", "content_sanskrit": "अदीनलीलाहसितेक्षणोल्‍लसद्‌भ्रूभङ्गसंसूचितभूर्यनुग्रहम्।\nईक्षेत चिन्तामयमेनमीश्वरं यावन्मनो धारणयाऽवतिष्ठते॥ २/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.014.m4a", "display_order": 15}, {"id": 6000022015, "chapter_id": 10022, "verse_number": "२-२-१४", "content_sanskrit": "एकैकशोऽङ्गानि धियाऽनुभावयेत्पादादि यावद्धसितं गदाभृतः।\nजितं जितं स्थानमपोह्य धारयेत् परं परं शुध्यति धीर्यथा यथा॥ २/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.015.m4a", "display_order": 16}, {"id": 6000022016, "chapter_id": 10022, "verse_number": "२-२-१५", "content_sanskrit": "यावन्न जायेत परावरेऽस्मिन् विश्वेश्वरे द्रष्टरि भक्तियोगः।\nतावत्स्थवीयः पुरुषस्य रूपं क्रियावसाने प्रयतः स्मरेत॥ २/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.016.m4a", "display_order": 17}, {"id": 6000022017, "chapter_id": 10022, "verse_number": "२-२-१६", "content_sanskrit": "स्थिरं सुखञ्चासनमास्थितो यतिः यदा जिहासुरिममङ्ग लोकम्।\nकाले च देशे च मनो न सज्जेत् प्राणान्नियच्छेन्मनसा जितासुः॥ २/२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.017.m4a", "display_order": 18}, {"id": 6000022018, "chapter_id": 10022, "verse_number": "२-२-१७", "content_sanskrit": "मनश्च बुद्ध्याऽमलया नियम्य क्षेत्रज्ञ एतां निनयेत्तमात्मनि।\nआत्मानमात्मन्यवरुध्य धीरो लब्धोपशान्तिर्विरमेत कृत्यात्॥ २/२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.018.m4a", "display_order": 19}, {"id": 6000022019, "chapter_id": 10022, "verse_number": "२-२-१८", "content_sanskrit": "न यत्र कालोऽनिमिषप्रभुः प्रभुः कुतो नु देवा जगतां य ईशिरे।\nन यत्र सत्त्वं न रजस्तमश्च न वै विकारो न महान्प्रधानम्॥ २/२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.019.m4a", "display_order": 20}, {"id": 6000022020, "chapter_id": 10022, "verse_number": "२-२-१९", "content_sanskrit": "परं पदं वैष्णवमामनन्ति तद् यन्नेति नेतीत्यतदुत्सिसृक्षवः।\nविसृज्य दौरात्म्यमनन्यसौहृदा हृदोपगुह्यापुरमुं पदे पदे॥ २/२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.020.m4a", "display_order": 21}, {"id": 6000022021, "chapter_id": 10022, "verse_number": "२-२-२०", "content_sanskrit": "इत्थं मुनिस्तूपरमेद्व्यवस्थितो विज्ञानदृग्वीर्यसुरन्धिताशयः।\nस्वपार्ष्णिनाऽऽपीड्य गुदं ततोऽनिलं स्थानेषु षट्सून्नमयेज्जितक्लमः॥ २/२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.021.m4a", "display_order": 22, "topics": [{"text": "तथा जीवस्य देहादुत्क्रान्ति-कथनम्", "range": "२०–३५"}]}, {"id": 6000022022, "chapter_id": 10022, "verse_number": "२-२-२१", "content_sanskrit": "नाभ्यां स्थितं हृद्यवरोप्य तस्माद् उदानगत्योरसि तं नयेन्मुनिः।\nततोऽनुसन्धाय धिया मनस्वी स्वतालुमूलं शनकैर्नयेत॥ २/२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.022.m4a", "display_order": 23}, {"id": 6000022023, "chapter_id": 10022, "verse_number": "२-२-२२", "content_sanskrit": "तस्माद्भ्रुवोरन्तरमुन्नयेत निरुद्धसप्ताश्वपथोऽनपेक्षः।\nस्थित्वा मुहूर्तार्धमकुण्ठदृष्टिर्निर्भिद्य मूर्धन्विसृजेत्परं गतः॥ २/२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.023.m4a", "display_order": 24}, {"id": 6000022024, "chapter_id": 10022, "verse_number": "२-२-२३", "content_sanskrit": "यदि प्रयास्यत्यथ पारमेष्ठ्यं वैहायसानामुत यद्विहारम्।\nअष्टाधिपत्यं गुणसन्निवाये सहैव गच्छेन्मनसेन्द्रियैश्च॥ २/२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.024.m4a", "display_order": 25}, {"id": 6000022025, "chapter_id": 10022, "verse_number": "२-२-२४", "content_sanskrit": "योगेश्वराणां गतिमामनन्ति बहिस्‍त्रिलोक्याः पवनान्तरात्मा।\nन कर्मभिस्तां गतिमाप्नुवन्ति विद्यातपोयोगसमाधिभाजाम्॥ २/२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.025.m4a", "display_order": 26}, {"id": 6000022026, "chapter_id": 10022, "verse_number": "२-२-२५", "content_sanskrit": "वैश्वानरं याति विहायसा गतः सुषुम्नया ब्रह्मपथेन शोचिषा।\nविधूतकल्कोऽथ हरेरुदस्तात् प्रयाति चक्रं नृप शैंशुमारम्॥ २/२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.026.m4a", "display_order": 27}, {"id": 6000022027, "chapter_id": 10022, "verse_number": "२-२-२६", "content_sanskrit": "योऽन्तः पचति भूतानां यस्तपत्यण्डमध्यगः।\nसोऽग्निर्वैश्वानरो मार्गो देवानां पितृणां मुनेः॥ २/२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.027.m4a", "display_order": 28}, {"id": 6000022028, "chapter_id": 10022, "verse_number": "२-२-२७", "content_sanskrit": "देवयानं पिङ्गलाभिरहान्येति शतायुषा।\nरात्रीरिडाभिः पितृणां विषुवत्तां सुषुम्नया॥ २/२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.028.m4a", "display_order": 29}, {"id": 6000022029, "chapter_id": 10022, "verse_number": "२-२-२८", "content_sanskrit": "तद्विश्वनाभिं त्वभिपद्य विष्णोरणीयसा विरजेनात्मनैकम्।\nनमस्कृतं ब्रह्मविदामुपैति कल्पायुषो यद् विबुधा रमन्ते॥ २/२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.029.m4a", "display_order": 30}, {"id": 6000022030, "chapter_id": 10022, "verse_number": "२-२-२९", "content_sanskrit": "अथो अनन्तस्य मुखानलेन दन्दह्यमानं स निरीक्ष्य विश्वम्।\nनिर्याति सिद्धेश्वरजुष्टधिष्ण्यं यद्वै परार्ध्यं तदु पारमेष्ठ्यम्॥ २/२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.030.m4a", "display_order": 31}, {"id": 6000022031, "chapter_id": 10022, "verse_number": "२-२-३०", "content_sanskrit": "न यत्र शोको न जरा न मृत्युर्नाधिर्न चोद्वेग ऋते कुतश्चित्।\nयश्चित्ततोदः क्रिययाऽनिदंविदां दुरन्तदुःखप्रभवानुदर्शनात्॥ २/२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.031.m4a", "display_order": 32}, {"id": 6000022032, "chapter_id": 10022, "verse_number": "२-२-३१", "content_sanskrit": "ततो विशेषं प्रतिपद्य निर्भयस्तेनात्मनाऽपोऽनलमूर्ध्नि च त्वरन्।\nज्योतिर्मयो वायुमुपेत्य काले वाय्वात्मना खं बृहदात्मलिङ्गम्॥ २/२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.032.m4a", "display_order": 33}, {"id": 6000022033, "chapter_id": 10022, "verse_number": "२-२-३२", "content_sanskrit": "घ्राणेन गन्धं रसनेन वै रसं रूपं तु दृष्ट्या स्पर्शं त्वचैव।\nश्रोत्रेण चोपेत्य नभोगुणं तत्प्रायेण नावृत्तिमुपैति योगी॥ २/२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.033.m4a", "display_order": 34}, {"id": 6000022034, "chapter_id": 10022, "verse_number": "२-२-३३", "content_sanskrit": "स भूतसूक्ष्मेन्द्रियसन्निकर्षात् सनातनोऽसौ भगवाननादिः।\nमनोमयं देवमयं विकार्यं संसाद्य मत्या सह तेन याति॥ २/२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.034.m4a", "display_order": 35}, {"id": 6000022035, "chapter_id": 10022, "verse_number": "२-२-३४", "content_sanskrit": "विज्ञानतत्त्वं गुणसन्निरोधं तेनात्मनाऽऽत्मानमुपैति शान्तिम्।\nआनन्दमानन्दमयोऽवसाने सर्वात्मके ब्रह्मणि वासुदेवे।\nएतां गतिं भागवतो गतो यः स वै पुनर्नेह विषज्जतेऽङ्ग॥ २/२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.035.m4a", "display_order": 36}, {"id": 6000022036, "chapter_id": 10022, "verse_number": "२-२-३५", "content_sanskrit": "एते सृती ते नृप वेदगीते त्वयाऽभिपृष्टेऽथ सनातने च।\nये द्वे पुरा ब्रह्मण आह पृष्ट आराधितो भगवान्वासुदेवः॥ २/२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.036.m4a", "display_order": 37}, {"id": 6000022037, "chapter_id": 10022, "verse_number": "२-२-३६", "content_sanskrit": "न ह्यतोऽन्यः शिवः पन्थाः विश्रुतः संसृताविह।\nवासुदेवे भगवति भक्तियोगो यतो भवेत्॥ २/२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.037.m4a", "display_order": 38, "topics": [{"text": "भगवत्प्रसादार्थं भक्तिविरक्तितच्चरित्रश्रवणादीनाम् अत्यवश्यकर्तव्यत्वस्य कथनम्", "range": "३६–४०"}]}, {"id": 6000022038, "chapter_id": 10022, "verse_number": "२-२-३७", "content_sanskrit": "भगवान्ब्रह्म कार्त्स्न्येन त्रिरन्वीक्ष्य मनीषया।\nतद्धि ह्यपश्यत् कूटस्थे रतिरात्मन्यतो भवेत्॥ २/२/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.038.m4a", "display_order": 39}, {"id": 6000022039, "chapter_id": 10022, "verse_number": "२-२-३८", "content_sanskrit": "भगवान्सर्वभूतेषु लक्षितश्चात्मना हरिः।\nदृश्यैर्बुद्ध्यादिभिर्द्रष्टा लक्षणैरनुमापकैः॥ २/२/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.039.m4a", "display_order": 40}, {"id": 6000022040, "chapter_id": 10022, "verse_number": "२-२-३९", "content_sanskrit": "तस्मात्सर्वात्मना राजन्हरिः सर्वत्र सर्वदा।\nश्रोतव्यः कीर्तितव्यश्च स्मर्तव्यो भगवान्नृणाम्॥ २/२/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.040.m4a", "display_order": 41}, {"id": 6000022041, "chapter_id": 10022, "verse_number": "२-२-४०", "content_sanskrit": "पिबन्ति ये भगवत आत्मनः सतां कथामृतं श्रवणपुटेषु सम्भृतम्।\nपुनन्ति ते विषयविदूषिताशयं व्रजन्ति तच्चरणसरोरुहान्तिकम्॥ २/२/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_02/adhyaya_002/BhP_02.002.041.m4a", "display_order": 42}, {"id": 6000022042, "chapter_id": 10022, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां द्वितीयस्कन्धे द्वितीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]