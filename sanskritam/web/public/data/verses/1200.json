[{"id": 2010043, "chapter_id": 1200, "verse_number": "१-२०१-०x", "content_sanskrit": "धृष्टद्युम्न उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2010044, "chapter_id": 1200, "verse_number": "१-२०१-१", "content_sanskrit": "दुर्योधनो दुर्विषहो दुर्मुखो दुष्प्रधर्षणः।\nविविंशतिर्विकर्णश्च सहो दुःशासनस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2010045, "chapter_id": 1200, "verse_number": "१-२०१-२", "content_sanskrit": "युयुत्सुर्वायुवेगश्च भीमवेगरवस्तथा।\nउग्रायुधो बलाकी च करकायुर्विरोचनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2010046, "chapter_id": 1200, "verse_number": "१-२०१-३", "content_sanskrit": "कुण्डकश्चित्रसेनश्च सुवर्चाः कनकध्वजः।\nनन्दको बाहुशाली च तुहुण्डो विकटस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2010047, "chapter_id": 1200, "verse_number": "१-२०१-४", "content_sanskrit": "एते चान्ये च बहवो धार्तराष्ट्रा महाबलाः।\nकर्णेन सहिता वीरास्त्वदर्थं समुपागताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2010048, "chapter_id": 1200, "verse_number": "१-२०१-५", "content_sanskrit": "असङ्ख्याता महात्मानः पार्थिवाः क्षत्रियर्षभाः।\nशकुनिः सौबलश्चैव वृषकोऽथ बृहद्बलः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2010049, "chapter_id": 1200, "verse_number": "१-२०१-६", "content_sanskrit": "एते गान्धारराजस्य सुताः सर्वे समागताः।\nअश्वत्थामा च भोजश्च सर्वशस्त्रभृतां वरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2010050, "chapter_id": 1200, "verse_number": "१-२०१-७", "content_sanskrit": "समवेतौ महात्मानौ त्वदर्थे समलङ्कृतौ।\nबृहन्तो मणिमांश्चैव दण्डधारश्च पार्थिवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2010051, "chapter_id": 1200, "verse_number": "१-२०१-८", "content_sanskrit": "सहदेवजयत्सेनौ मेघसन्धिश्च पार्थिवः।\nविराटः सह पुत्राभ्यां शङ्खेनैवोत्तरेण च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2010052, "chapter_id": 1200, "verse_number": "१-२०१-९", "content_sanskrit": "वार्धक्षेमिः सुशर्मा च सेनाबिन्दुश्च पार्थिवः।\nसुकेतुः सह पुत्रेण सुनाम्ना च सुवर्चसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2010053, "chapter_id": 1200, "verse_number": "१-२०१-१०", "content_sanskrit": "सुचित्रः सुकुमारश्च वृकः सत्यधृतिस्तथा।\nसूर्यध्वजो रोचमानो नीलश्चित्रायुधस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2010054, "chapter_id": 1200, "verse_number": "१-२०१-११", "content_sanskrit": "अंशुमांश्चेकितानश्च श्रेणिमांश्च महाबलः।\nसमुद्रसेनपुत्रश्च चन्द्रसेनः प्रतापवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2010055, "chapter_id": 1200, "verse_number": "१-२०१-१२", "content_sanskrit": "जलसन्धः पितापुत्रौ विदण्डो दण्ड एव च।\nपौण्ड्रको वासुदेवश्च भगदत्तश्च वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2010056, "chapter_id": 1200, "verse_number": "१-२०१-१३", "content_sanskrit": "कलिङ्गस्ताम्रलिप्तश्च पत्तनाधिपतिस्तथा।\nमद्रराजस्तथा शल्यः सहपुत्रो महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2010057, "chapter_id": 1200, "verse_number": "१-२०१-१४", "content_sanskrit": "रुक्माङ्गदेन वीरेण तथा रुक्मरथेन च।\nकौरव्यः सोमदत्तश्च पुत्रश्चास्य महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2010058, "chapter_id": 1200, "verse_number": "१-२०१-१५", "content_sanskrit": "समवेतास्त्रयः शूरा भूरिर्भूरिश्रवाः शलः।\nसुदक्षिणश्च काम्भोजो दृढधन्वा च पौरवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2010059, "chapter_id": 1200, "verse_number": "१-२०१-१६", "content_sanskrit": "बृहद्बलः सुषेणश्च शिबिरौशीनस्तथा।\nपटच्चरनिहन्ता च कारूषाधिपतिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2010060, "chapter_id": 1200, "verse_number": "१-२०१-१७", "content_sanskrit": "सङ्कर्षणो वासुदेवो रौक्मिणेयश्च वीर्यवान्।\nसाम्बश्च चारुदेष्णश्च प्राद्युम्निः सगदस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2010061, "chapter_id": 1200, "verse_number": "१-२०१-१८", "content_sanskrit": "अक्रूरः सात्यकिश्चैव उद्धवश्च महामतिः।\nकृतवर्मा च हार्दिक्यः पृथुर्विपृथुरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2010062, "chapter_id": 1200, "verse_number": "१-२०१-१९", "content_sanskrit": "विदूरथश्च कङ्कश्च शङ्कुश्च सगवेषणः।\nआशावहोऽनिरुद्धश्च समीकः सारिमेजयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2010063, "chapter_id": 1200, "verse_number": "१-२०१-२०", "content_sanskrit": "वीरो वातपतिश्चैव झिल्लीपिण्डारकस्तथा।\nउशीनरश्च विक्रान्तो वृष्णयस्ते प्रकीर्तिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2010064, "chapter_id": 1200, "verse_number": "१-२०१-२१", "content_sanskrit": "भगीरथो बृहत्क्षत्रः सैन्धवश्च जयद्रथः।\nबृहद्रथो बाह्लिकश्च श्रउतायुश्च महारथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2010065, "chapter_id": 1200, "verse_number": "१-२०१-२२", "content_sanskrit": "उलूकः कैतवो राजा चित्राङ्गदशुभाङ्गदौ।\nवत्सराजश्च मतिमान्कोसलाधिपतिस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2010066, "chapter_id": 1200, "verse_number": "१-२०१-२३", "content_sanskrit": "शिशुपालख्च विक्रान्तो जरासन्धस्तथैव च।\nएते चान्ये च बहवो नानाजनपदेश्वराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2010067, "chapter_id": 1200, "verse_number": "१-२०१-२४", "content_sanskrit": "त्वदर्थमागता भद्रे क्षत्रियाः प्रथिता भुवि।\nएते भेत्स्यन्ति विक्रान्तास्त्वदर्थे लक्ष्यमुत्तमम्।\nविध्यते य इदं लक्ष्यं वरयेथाः शुभेऽद्य तम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2010068, "chapter_id": 1200, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि स्वयंवरपर्वणि एकाधिकद्विशततमोऽध्यायः॥ २०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}]