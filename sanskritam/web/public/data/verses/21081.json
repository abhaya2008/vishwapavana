[{"id": 7001081000, "chapter_id": 21081, "verse_number": "१-१७-१", "content_sanskrit": "ऋषय ऊचुः ।\nप्रणवस्य च माहात्म्यं षड्लिंगस्य महामुने ।\nशिवभक्तस्य पूजां च क्रमशो ब्रूहि नःप्रभो॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001081001, "chapter_id": 21081, "verse_number": "१-१७-२", "content_sanskrit": "सूत उवाच ।\nतपोधनैर्भवद्भिश्च सम्यक्प्रश्नस्त्वयं कृतः ।\nअस्योत्तरं महादेवो जानाति स्म न चापरः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001081002, "chapter_id": 21081, "verse_number": "१-१७-३", "content_sanskrit": "अथापि वक्ष्ये तमहं शिवस्य कृपयैव हि ।\nशिवोऽस्माकं च युष्माकं रक्षां गृह्णातु भूरिशः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001081003, "chapter_id": 21081, "verse_number": "१-१७-४", "content_sanskrit": "प्रो हि प्रकृतिजातस्य संसारस्य महोदधेः ।\nनवं नावांतरमिति प्रणवं वै विदुर्बुधाः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001081004, "chapter_id": 21081, "verse_number": "१-१७-५", "content_sanskrit": "प्रः प्रपंचो न नास्तिवो युष्माकं प्रणवं विदुः ।\nप्रकर्षेण नयेद्यस्मान्मोक्षं वः प्रणवं विदुः॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001081005, "chapter_id": 21081, "verse_number": "१-१७-६", "content_sanskrit": "स्वजापकानां योगिनां स्वमंत्रपूजकस्य च ।\nसर्वकर्मक्षयं कृत्वा दिव्यज्ञानं तु नूतनम्॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001081006, "chapter_id": 21081, "verse_number": "१-१७-७", "content_sanskrit": "तमेव मायारहितं नूतनं परिचक्षते ।\nप्रकर्षेण महात्मानं नवं शुद्धस्वरूपकम्॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001081007, "chapter_id": 21081, "verse_number": "१-१७-८", "content_sanskrit": "नूतनं वै करोतीति प्रणवं तं विदुर्बुधाः ।\nप्रणवं द्विविधं प्रोक्तं सूक्ष्मस्थूलविभेदतः॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001081008, "chapter_id": 21081, "verse_number": "१-१७-९", "content_sanskrit": "सूक्ष्ममेकाक्षरं विद्यात्स्थूलं पंचाक्षरं विदुः ।\nसूक्ष्ममव्यक्तपंचार्णं सुव्यक्तार्णं तथेतरत्॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001081009, "chapter_id": 21081, "verse_number": "१-१७-१०", "content_sanskrit": "जीवन्मुक्तस्य सूक्ष्मं हि सर्वसारं हि तस्य हि ।\nमंत्रेणार्थानुसंधानं स्वदेहविलयावधि॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001081010, "chapter_id": 21081, "verse_number": "१-१७-११", "content_sanskrit": "स्वदेहेगलिते पूर्णं शिवं प्राप्नोति निश्चयः ।\nकेवलं मंत्रजापी तु योगं प्राप्नोति निश्चयः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001081011, "chapter_id": 21081, "verse_number": "१-१७-१२", "content_sanskrit": "षट्त्रिंशत्कोटिजापी तु निश्चयं योगमाप्नुयात् ।\nसूक्ष्मं च द्विविधं ज्ञेयं ह्रस्वदीर्घविभेदतः॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001081012, "chapter_id": 21081, "verse_number": "१-१७-१३", "content_sanskrit": "अकारश्च उकारश्च मकारश्च ततः परम् ।\nबिंदुनादयुतं तद्धि शब्दकालकलान्वितम्॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001081013, "chapter_id": 21081, "verse_number": "१-१७-१४", "content_sanskrit": "दीर्घप्रणवमेवं हि योगिनामेव हृद्गतम् ।\nमकारं तंत्रितत्त्वं हि ह्रस्वप्रणव उच्यते॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001081014, "chapter_id": 21081, "verse_number": "१-१७-१५", "content_sanskrit": "शिवः शक्तिस्तयोरैक्यं मकारं तु त्रिकात्मकम् ।\nह्रस्वमेवं हि जाप्यं स्यात्सर्वपापक्षयैषिणाम्॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001081015, "chapter_id": 21081, "verse_number": "१-१७-१६", "content_sanskrit": "भूवायुकनकार्णोद्योःशब्दाद्याश्च तथा दश ।\nआशान्वयेदशपुनः प्रवृत्ता इति कथ्यते॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001081016, "chapter_id": 21081, "verse_number": "१-१७-१७", "content_sanskrit": "ह्रस्वमेव प्रवृत्तानां निवृत्तानां तु दीर्घकम् ।\nव्याहृत्यादौ च मंत्रादौ कामं शब्दकलायुतम्॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001081017, "chapter_id": 21081, "verse_number": "१-१७-१८", "content_sanskrit": "वेदादौ च प्रयोज्यं स्याद्वंदने संध्ययोरपि ।\nनवकौटिजपाञ्जप्त्वा संशुद्धः पुरुषो भवेत्॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001081018, "chapter_id": 21081, "verse_number": "१-१७-१९", "content_sanskrit": "पुनश्च नवकोट्या तु पृथिवीजयमाप्नुयात् ।\nपुनश्च नवकोट्या तु ह्यपांजयमवाप्नुयात्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001081019, "chapter_id": 21081, "verse_number": "१-१७-२०", "content_sanskrit": "पुनश्च नवकोट्या तु तेजसांजयमाप्नुयात् ।\nपुनश्च नवकोट्या तु वायोर्जयमवाप्नुयात् ।\nआकाशजयमाप्नोति नवकोटिजपेन वै॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001081020, "chapter_id": 21081, "verse_number": "१-१७-२१", "content_sanskrit": "गंधादीनांक्रमेणैवनवकोटिजपेणवै ।\nअहंकारस्य च पुनर्नव कोटिजपेन वै॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001081021, "chapter_id": 21081, "verse_number": "१-१७-२२", "content_sanskrit": "सहस्रमंत्रजप्तेन नित्यशुद्धो भवेत्पुमान् ।\nततः परं स्वसिद्ध्यर्थं जपो भवति हि द्विजाः॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001081022, "chapter_id": 21081, "verse_number": "१-१७-२३", "content_sanskrit": "एवमष्टोत्तरशतकोटिजप्तेन वै पुनः ।\nप्रणवेन प्रबुद्धस्तु शुद्धयोगमवाप्नुयात्॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001081023, "chapter_id": 21081, "verse_number": "१-१७-२४", "content_sanskrit": "शुद्धयोगेन संयुक्तो जीवन्मुक्तो न संशयः ।\nसदा जपन्सदाध्यायञ्छिवं प्रणवरूपिणम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001081024, "chapter_id": 21081, "verse_number": "१-१७-२५", "content_sanskrit": "समाधिस्थो महायोगीशिव एव न संशयः ।\nऋषिच्छंदोदेवतादि न्यस्य देहेपुनर्जपेत्॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001081025, "chapter_id": 21081, "verse_number": "१-१७-२६", "content_sanskrit": "प्रणवं मातृकायुक्तं देहे न्यस्य ऋषिर्भवेत् ।\nदशमातृषडध्वादि सर्वं न्यासफलं लभेत्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001081026, "chapter_id": 21081, "verse_number": "१-१७-२७", "content_sanskrit": "प्रवृत्तानां च मिश्राणां स्थूलप्रणवमिष्यते ।\nक्रियातपोजपैर्युक्तास्त्रिविधाः शिवयोगिनः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001081027, "chapter_id": 21081, "verse_number": "१-१७-२८", "content_sanskrit": "धनादिविभवैश्चैव कराद्यंगैर्नमादिभिः ।\nक्रियया पूजया युक्तः क्रियायोगीति कथ्यते॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001081028, "chapter_id": 21081, "verse_number": "१-१७-२९", "content_sanskrit": "पूजायुक्तश्च मितभुग्बाह्येंद्रि यजयान्वितः ।\nपरद्रो हादिरहितस्तपोयोगीति कथ्यते॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001081029, "chapter_id": 21081, "verse_number": "१-१७-३०", "content_sanskrit": "एतैर्युक्तः सदा क्रुद्धः सर्वकामादिवर्जितः ।\nसदा जपपरः शांतोजपयोगीति तं विदुः॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001081030, "chapter_id": 21081, "verse_number": "१-१७-३१", "content_sanskrit": "उपचारैः षोडशभिः पूजया शिवयोगिनाम् ।\nसालोक्यादिक्रमेणैव शुद्धो मुक्तिं लभेन्नरः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001081031, "chapter_id": 21081, "verse_number": "१-१७-३२", "content_sanskrit": "जपयोगमथो वक्ष्ये गदतः शृणुत द्विजाः ।\nतपःकर्तुर्जपः प्रोक्तो यज्जपन्परिमार्जते॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001081032, "chapter_id": 21081, "verse_number": "१-१७-३३", "content_sanskrit": "शिवनाम नमःपूर्वं चतुर्थ्यां पंचतत्त्वकम् ।\nस्थूलप्रणवरूपं हि शिवपंचाक्षरं द्विजाः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001081033, "chapter_id": 21081, "verse_number": "१-१७-३४", "content_sanskrit": "पंचाक्षरजपेनैव सर्वसिद्धिं लभेन्नरः ।\nप्रणवेनादिसंयुक्तं सदा पंचाक्षरं जपेत्॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001081034, "chapter_id": 21081, "verse_number": "१-१७-३५", "content_sanskrit": "गुरूपदेशं संगम्य सुखवासे सुभूतले ।\nपूर्वपक्षे समारभ्य कृष्णभूतावधि द्विजाः॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001081035, "chapter_id": 21081, "verse_number": "१-१७-३६", "content_sanskrit": "माघं भाद्रं विशिष्टं तु सर्वकालोत्तमोत्तमम् ।\nएकवारं मिताशीतु वाग्यतो नियतेंद्रि यः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001081036, "chapter_id": 21081, "verse_number": "१-१७-३७", "content_sanskrit": "स्वस्य राजपितृणां च शुश्रूषणं च नित्यशः ।\nसहस्रजपमात्रेण भवेच्छुद्धोऽन्यथा ऋणी॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001081037, "chapter_id": 21081, "verse_number": "१-१७-३८", "content_sanskrit": "पंचाक्षरं पंचलक्षं जपेच्छिवमनुस्मरन् ।\nपद्मासनस्थं शिवदं गंगाचंद्र कलान्वितम्॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001081038, "chapter_id": 21081, "verse_number": "१-१७-३९", "content_sanskrit": "वामोरुस्थितशक्त्या च विराजं तं महागणैः ।\nमृगटंकधरं देवं वरदाभयपाणिकम्॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001081039, "chapter_id": 21081, "verse_number": "१-१७-४०", "content_sanskrit": "सदानुग्रहकर्त्तारं सदा शिवमनुस्मरन् ।\nसंपूज्य मनसा पूर्वं हृदिवासूर्यमंडले॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001081040, "chapter_id": 21081, "verse_number": "१-१७-४१", "content_sanskrit": "जपेत्पंचाक्षरीं विद्यां प्राण्मुखः शुद्धकर्मकृत् ।\nप्रातः कृष्णचतुर्दश्यां नित्यकर्मसमाप्य च॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001081041, "chapter_id": 21081, "verse_number": "१-१७-४२", "content_sanskrit": "मनोरमे शुचौ देशे नियतः शुद्धमानसः ।\nपंचाक्षरस्य मंत्रस्य सहस्रं द्वादशं जपेत्॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001081042, "chapter_id": 21081, "verse_number": "१-१७-४३", "content_sanskrit": "वरयेच्च सपत्नीकाञ्छैवान्वै ब्राह्मणोत्तमान् ।\nएकं गुरुवरं शिष्टं वरयेत्सांबमूर्तिकम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001081043, "chapter_id": 21081, "verse_number": "१-१७-४४", "content_sanskrit": "ईशानं चाथ पुरुषमघोरं वाममेव च ।\nसद्योजातं च पंचैव शिवभक्तान्द्विजोत्तमान्॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001081044, "chapter_id": 21081, "verse_number": "१-१७-४५", "content_sanskrit": "पूजाद्र व्याणि संपाद्य शिवपूजां समारभेत् ।\nशिवपूजां च विधिवत्कृत्वा होमं समारभेत्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001081045, "chapter_id": 21081, "verse_number": "१-१७-४६", "content_sanskrit": "मुखांतं च स्वसूत्रेण कृत्वा होमं समारभेत् ।\nदशैकं वा शतैकं वा सहस्रैकमथापि वा॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001081046, "chapter_id": 21081, "verse_number": "१-१७-४७", "content_sanskrit": "कापिलेन घृतेनैव जुहुयात्स्वयमेव हि ।\nकारयेच्छिवभक्तैर्वाप्यष्टोत्तरशतं बुधः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001081047, "chapter_id": 21081, "verse_number": "१-१७-४८", "content_sanskrit": "होमान्ते दक्षिणा देया गुरोर्गोमिथुनं तथा ।\nईशानादिस्वरूपांस्तान्गुरुं सांबं विभाव्य च॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001081048, "chapter_id": 21081, "verse_number": "१-१७-४९", "content_sanskrit": "तेषां पत्सिक्ततोयेन स्वशिरः स्नानमाचरेत् ।\nषट्त्रिंशत्कोटितीर्थेषु सद्यः स्नानफलं लभेत्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001081049, "chapter_id": 21081, "verse_number": "१-१७-५०", "content_sanskrit": "दशांगमन्नं तेषां वै दद्याद्वैभक्तिपूर्वकम् ।\nपराबुद्ध्या गुरोः पत्नीमीशानादिक्रमेण तु॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001081050, "chapter_id": 21081, "verse_number": "१-१७-५१", "content_sanskrit": "परमान्नेन संपूज्य यथाविभवविस्तरम् ।\nरुद्रा क्षवस्त्रपूर्वं च वटकापूपकैर्युतम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001081051, "chapter_id": 21081, "verse_number": "१-१७-५२", "content_sanskrit": "बलिदानं ततः कृत्वा भूरिभोजनमाचरेत् ।\nततः संप्रार्थ्य देवेशं जपं तावत्समापयेत्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001081052, "chapter_id": 21081, "verse_number": "१-१७-५३", "content_sanskrit": "पुरश्चरणमेवं तु कृत्वा मन्त्रीभवेन्नरः ।\nपुनश्च पंचलक्षेण सर्वपापक्षयो भवेत्॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001081053, "chapter_id": 21081, "verse_number": "१-१७-५४", "content_sanskrit": "अतलादि समारभ्य सत्यलोकावधिक्रमात् ।\nपंचलक्षजपात्तत्तल्लोकैश्वर्यमवाप्नुयात्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001081054, "chapter_id": 21081, "verse_number": "१-१७-५५", "content_sanskrit": "मध्ये मृतश्चेद्भोगांते भूमौ तज्जापको भवेत् ।\nपुनश्च पंचलक्षेण ब्रह्मसामीप्यमाप्नुयात्॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001081055, "chapter_id": 21081, "verse_number": "१-१७-५६", "content_sanskrit": "पुनश्च पंचलक्षेण सारूप्यैश्वर्यमाप्नुयात् ।\nआहत्य शतलक्षेण साक्षाद्ब्रह्मसमो भवेत्॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001081056, "chapter_id": 21081, "verse_number": "१-१७-५७", "content_sanskrit": "कार्यब्रह्मण एवं हि सायुज्यं प्रतिपद्य वै ।\nयथेष्टं भोगमाप्नोति तद्ब्रह्मप्रलयावधि॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001081057, "chapter_id": 21081, "verse_number": "१-१७-५८", "content_sanskrit": "पुनः कल्पांतरे वृत्ते ब्रह्मपुत्रः सजायते ।\nपुनश्च तपसा दीप्तः क्रमान्मुक्तो भविष्यति॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001081058, "chapter_id": 21081, "verse_number": "१-१७-५९", "content_sanskrit": "पृथ्व्यादिकार्यभूतेभ्यो लोका वै निर्मिताः क्रमात् ।\nपातालादि च सत्यांतं ब्रह्मलोकाश्चतुर्दश॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7001081059, "chapter_id": 21081, "verse_number": "१-१७-६०", "content_sanskrit": "सत्यादूर्ध्वं क्षमांतं वैविष्णुलोकाश्चतुर्दश ।\nक्षमलोके कार्यविष्णुर्वैकुंठे वरपत्तने॥ ६० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7001081060, "chapter_id": 21081, "verse_number": "१-१७-६१", "content_sanskrit": "कार्यलक्ष्म्या महाभोगिरक्षां कृत्वाऽधितिष्ठति ।\nतदूर्ध्वगाश्च शुच्यंतां लोकाष्टाविंशतिः स्थिताः॥ ६१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7001081061, "chapter_id": 21081, "verse_number": "१-१७-६२", "content_sanskrit": "शुचौ लोके तु कैलासे रुद्रो वै भूतहृत्स्थितः ।\nषडुत्तराश्च पंचाशदहिंसांतास्तदूर्ध्वगाः॥ ६२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7001081062, "chapter_id": 21081, "verse_number": "१-१७-६३", "content_sanskrit": "अहिंसालोकमास्थाय ज्ञानकैलासके पुरे ।\nकार्येश्वरस्तिरोभावं सर्वान्कृत्वाधितिष्ठति॥ ६३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7001081063, "chapter_id": 21081, "verse_number": "१-१७-६४", "content_sanskrit": "तदंते कालचक्रं हि कालातीतस्ततः परम् ।\nशिवेनाधिष्ठितस्तत्र कालश्चक्रेश्वराह्वयः॥ ६४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7001081064, "chapter_id": 21081, "verse_number": "१-१७-६५", "content_sanskrit": "माहिषं धर्ममास्थाय सर्वान्कालेन युंजति ।\nअसत्यश्चाशुचिश्चैव हिंसा चैवाथ निर्घृणा॥ ६५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7001081065, "chapter_id": 21081, "verse_number": "१-१७-६६", "content_sanskrit": "असत्यादिचतुष्पादः सर्वांशः कामरूपधृक् ।\nनास्तिक्यलक्ष्मीर्दुःसंगो वेदबाह्यध्वनिः सदा॥ ६६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7001081066, "chapter_id": 21081, "verse_number": "१-१७-६७", "content_sanskrit": "क्रोधसंगः कृष्णवर्णो महामहिषवेषवान् ।\nतावन्महेश्वरः प्रोक्तस्तिरोधास्तावदेव हि॥ ६७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7001081067, "chapter_id": 21081, "verse_number": "१-१७-६८", "content_sanskrit": "तदर्वाक्कर्मभोगो हि तदूर्ध्वं ज्ञानभोगकम् ।\nतदर्वाक्कर्ममाया हि ज्ञानमाया तदूर्ध्वकम्॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7001081068, "chapter_id": 21081, "verse_number": "१-१७-६९", "content_sanskrit": "मा लक्ष्मीः कर्मभोगो वै याति मायेति कथ्यते ।\nमा लक्ष्मीर्ज्ञानभोगो वै याति मायेति कथ्यते॥ ६९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7001081069, "chapter_id": 21081, "verse_number": "१-१७-७०", "content_sanskrit": "तदूर्ध्वं नित्यभोगो हि तदर्वाण्नश्वरं विदुः ।\nतदर्वाक्च तिरोधानं तदूर्ध्वं न तिरोधनम्॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7001081070, "chapter_id": 21081, "verse_number": "१-१७-७१", "content_sanskrit": "तदर्वाक्पाशबंधो हि तदूर्ध्वं न हि बंधनम् ।\nतदर्वाक्परिवर्तंते काम्यकर्मानुसारिणः॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7001081071, "chapter_id": 21081, "verse_number": "१-१७-७२", "content_sanskrit": "निष्कामकर्मभोगस्तु तदूर्ध्वं परिकीर्तितः ।\nतदर्वाक्परिवर्तंते बिंदुपूजापरायणाः॥ ७२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7001081072, "chapter_id": 21081, "verse_number": "१-१७-७३", "content_sanskrit": "तदूर्ध्वं हि व्रजंत्येव निष्कामा लिंगपूजकाः ।\nतदर्वाक्परिवर्तंते शिवान्यसुरपूजकाः॥ ७३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7001081073, "chapter_id": 21081, "verse_number": "१-१७-७४", "content_sanskrit": "शिवैकनिरता ये च तदूर्ध्वं संप्रयांति ते ।\nतदर्वाग्जीवकोटिः स्यात्तदूर्ध्वं परकोटिकाः॥ ७४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7001081074, "chapter_id": 21081, "verse_number": "१-१७-७५", "content_sanskrit": "सांसारिकास्तदर्वाक्च मुक्ताः खलु तदूर्ध्वगाः ।\nतदर्वाक्परिवर्तंते प्राकृतद्र व्यपूजकाः॥ ७५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7001081075, "chapter_id": 21081, "verse_number": "१-१७-७६", "content_sanskrit": "तदूर्ध्वं हि व्रजंत्येते पौरुषद्र व्यपूजकाः ।\nतदर्वाक्छक्तिलिंगं तु शिवलिंगं तदूर्ध्वकम्॥ ७६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7001081076, "chapter_id": 21081, "verse_number": "१-१७-७७", "content_sanskrit": "तदर्वागावृतं लिंगं तदूर्ध्वं हि निरावृति ।\nतदर्वाक्कल्पितं लिंगं तदूर्ध्वं वै न कल्पितम्॥ ७७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7001081077, "chapter_id": 21081, "verse_number": "१-१७-७८", "content_sanskrit": "तदर्वाग्बाह्यलिंगं स्यादंतरंगं तदूर्ध्वकम् ।\nतदर्वाक्छक्तिलोका हि शतं वै द्वादशाधिकम्॥ ७८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7001081078, "chapter_id": 21081, "verse_number": "१-१७-७९", "content_sanskrit": "तदर्वाग्बिंदुरूपं हि नादरूपं तदुत्तरम् ।\nतदर्वाक्कर्मलोकस्तु तदूर्ध्वं ज्ञानलोककः॥ ७९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7001081079, "chapter_id": 21081, "verse_number": "१-१७-८०", "content_sanskrit": "नमस्कारस्तदूर्ध्वं हि मदाहंकारनाशनः ।\nजनिजं वै तिरोधानं नानिषिद्ध्यातते इति॥ ८० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7001081080, "chapter_id": 21081, "verse_number": "१-१७-८१", "content_sanskrit": "ज्ञानशब्दार्थ एवं हि तिरोधाननिवारणात् ।\nतदर्वाक्परिवर्तंते ह्याधिभौतिकपूजकाः॥ ८१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7001081081, "chapter_id": 21081, "verse_number": "१-१७-८२", "content_sanskrit": "आध्यात्मिकार्चका एव तदूर्ध्वं संप्रयांतिवै ।\nतावद्वै वेदिभागं तन्महालोकात्मलिंगके॥ ८२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7001081082, "chapter_id": 21081, "verse_number": "१-१७-८३", "content_sanskrit": "प्रकृत्याद्यष्टबंधोपि वेद्यंते संप्रतिष्ठतः ।\nएवमेतादृशं ज्ञेयं सर्वं लौकिकवैदिकम्॥ ८३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7001081083, "chapter_id": 21081, "verse_number": "१-१७-८४", "content_sanskrit": "अधर्ममहिषारूढं कालचक्रं तरंति ते ।\nसत्यादिधर्मयुक्ता ये शिवपूजापराश्च ये॥ ८४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7001081084, "chapter_id": 21081, "verse_number": "१-१७-८५", "content_sanskrit": "तदूर्ध्वं वृषभो धर्मो ब्रह्मचर्यस्वरूपधृक् ।\nसत्यादिपादयुक्तस्तु शिवलोकाग्रतः स्थितः॥ ८५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7001081085, "chapter_id": 21081, "verse_number": "१-१७-८६", "content_sanskrit": "क्षमाशृङ्गः शमश्रोत्रो वेदध्वनिविभूषितः ।\nआस्तिक्यचक्षुर्निश्वासगुरुबुद्धिमना वृषः॥ ८६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7001081086, "chapter_id": 21081, "verse_number": "१-१७-८७", "content_sanskrit": "क्रियादिवृषभा ज्ञेयाः कारणादिषु सर्वदा ।\nतं क्रियावृषभं धर्मं कालातीतोधितिष्ठति॥ ८७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7001081087, "chapter_id": 21081, "verse_number": "१-१७-८८", "content_sanskrit": "ब्रह्मविष्णुमहेशानां स्वस्वायुर्दिनमुच्यते ।\nतदूर्ध्वं न दिनं रात्रिर्न जन्ममरणादिकम्॥ ८८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7001081088, "chapter_id": 21081, "verse_number": "१-१७-८९", "content_sanskrit": "पुनः कारणसत्यांताः कारणब्रह्मणस्तथा ।\nगंधादिभ्यस्तु भूतेभ्यस्तदूर्ध्वं निर्मिताः सदा॥ ८९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7001081089, "chapter_id": 21081, "verse_number": "१-१७-९०", "content_sanskrit": "सूक्ष्मगंधस्वरूपा हि स्थिता लोकाश्चतुर्दश ।\nपुनः कारणविष्णोर्वै स्थिता लोकाश्चतुर्दश॥ ९० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7001081090, "chapter_id": 21081, "verse_number": "१-१७-९१", "content_sanskrit": "पुनःकारणरुद्र स्य लोकाष्टाविंशका मताः ।\nपुनश्च कारणेशस्य षट्पंचाशत्तदूर्ध्वगाः॥ ९१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7001081091, "chapter_id": 21081, "verse_number": "१-१७-९२", "content_sanskrit": "ततः परं ब्रह्मचर्यलोकाख्यं शिवसंमतम् ।\nतत्रैव ज्ञानकैलासे पंचावरणसंयुते॥ ९२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7001081092, "chapter_id": 21081, "verse_number": "१-१७-९३", "content_sanskrit": "पंचमंडलसंयुक्तं पंचब्रह्मकलान्वितम् ।\nआदिशक्तिसमायुक्तमादिलिंगं तु तत्र वै॥ ९३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7001081093, "chapter_id": 21081, "verse_number": "१-१७-९४", "content_sanskrit": "शिवालयमिदं प्रोक्तं शिवस्य परमात्मनः ।\nपरशक्त्यासमायुक्तस्तत्रैव परमेश्वरः॥ ९४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7001081094, "chapter_id": 21081, "verse_number": "१-१७-९५", "content_sanskrit": "सृष्टिः स्थितिश्च संहारस्तिरोभावोप्यनुग्रहः ।\nपंचकृत्यप्रवीणोऽसौ सच्चिदानंदविग्रहः॥ ९५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7001081095, "chapter_id": 21081, "verse_number": "१-१७-९६", "content_sanskrit": "ध्यानधर्मः सदा यस्य सदानुग्रहतत्परः ।\nसमाध्यासनमासीनः स्वात्मारामो विराजते॥ ९६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7001081096, "chapter_id": 21081, "verse_number": "१-१७-९७", "content_sanskrit": "तस्य संदर्शनं सांध्यं कर्मध्यानादिभिः क्रमात् ।\nनित्यादिकर्मयजनाच्छिवकर्ममतिर्भवेत्॥ ९७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7001081097, "chapter_id": 21081, "verse_number": "१-१७-९८", "content_sanskrit": "क्रियादिशिवकर्मभ्यः शिवज्ञानं प्रसाधयेत् ।\nतद्दर्शनगताः सर्वे मुक्ता एव न संशयः॥ ९८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7001081098, "chapter_id": 21081, "verse_number": "१-१७-९९", "content_sanskrit": "मुक्तिरात्मस्वरूपेण स्वात्मारामत्वमेव हि ।\nक्रियातपोजपज्ञानध्यानधर्मेषु सुस्थितः॥ ९९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7001081099, "chapter_id": 21081, "verse_number": "१-१७-१००", "content_sanskrit": "शिवस्य दर्शनं लब्धा स्वात्मारामत्वमेव हि ।\nयथा रविः स्वकिरणादशुद्धिमपनेष्यति॥ १०० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7001081100, "chapter_id": 21081, "verse_number": "१-१७-१०१", "content_sanskrit": "कृपाविचक्षणः शंभुरज्ञानमपनेष्यति ।\nअज्ञानविनिवृत्तौ तु शिवज्ञानं प्रवर्तते॥ १०१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7001081101, "chapter_id": 21081, "verse_number": "१-१७-१०२", "content_sanskrit": "शिवज्ञानात्स्वस्वरूपमात्मारामत्वमेष्यति ।\nआत्मारामत्वसंसिद्धौ कृतकृत्यो भवेन्नरः॥ १०२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7001081102, "chapter_id": 21081, "verse_number": "१-१७-१०३", "content_sanskrit": "पुनश्च शतलक्षेण ब्रह्मणः पदमाप्नुयात् ।\nपुनश्च शतलक्षेण विष्णोः पदमवाप्नुयात्॥ १०३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7001081103, "chapter_id": 21081, "verse_number": "१-१७-१०४", "content_sanskrit": "पुनश्च शतलक्षेण रुद्र स्य पदमाप्नुयात् ।\nपुनश्च शतलक्षेण ऐश्वर्यं पदमाप्नुयात्॥ १०४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7001081104, "chapter_id": 21081, "verse_number": "१-१७-१०५", "content_sanskrit": "पुनश्चैवंविधेनैव जपेन सुसमाहितः ।\nशिवलोकादिभूतं हि कालचक्रमवाप्नुयात्॥ १०५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7001081105, "chapter_id": 21081, "verse_number": "१-१७-१०६", "content_sanskrit": "कालचक्रं पंचचक्रमेकैकेन क्रमोत्तरे ।\nसृष्टिमोहौ ब्रह्मचक्रं भोगमोहौ तु वैष्णवम्॥ १०६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7001081106, "chapter_id": 21081, "verse_number": "१-१७-१०७", "content_sanskrit": "कोपमोहौ रौद्र चक्रं भ्रमणं चैश्वरं विदुः ।\nशिवचक्रं ज्ञानमोहौ पंचचक्रं विदुर्बुधाः॥ १०७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7001081107, "chapter_id": 21081, "verse_number": "१-१७-१०८", "content_sanskrit": "पुनश्च दशकोट्या हि कारणब्रह्मणः पदम् ।\nपुनश्च दशकोट्या हि तत्पदैश्वर्यमाप्नुयात्॥ १०८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7001081108, "chapter_id": 21081, "verse_number": "१-१७-१०९", "content_sanskrit": "एवं क्रमेण विष्ण्वादेः पदं लब्ध्वा महौजसः ।\nक्रमेण तत्पदैश्वर्यं लब्ध्वा चैव महात्मनः॥ १०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7001081109, "chapter_id": 21081, "verse_number": "१-१७-११०", "content_sanskrit": "शतकोटिमनुं जप्त्वा पंचोत्तरमतंद्रि तः ।\nशिवलोकमवाप्नोति पंचमावरणाद्बहिः॥ ११० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7001081110, "chapter_id": 21081, "verse_number": "१-१७-१११", "content_sanskrit": "राजसं मंडपं तत्र नंदीसंस्थानमुत्तमम् ।\nतपोरूपश्च वृषभस्तत्रैव परिदृश्यते॥ १११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7001081111, "chapter_id": 21081, "verse_number": "१-१७-११२", "content_sanskrit": "सद्योजातस्य तत्स्थानं पंचमावरणं परम् ।\nवामदेवस्य च स्थानं चतुर्थावरणं पुनः॥ ११२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7001081112, "chapter_id": 21081, "verse_number": "१-१७-११३", "content_sanskrit": "अघोरनिलयं पश्चात्तृतीयावरणं परम् ।\nपुरुषस्यैव सांबस्य द्वितीयावरणं शुभम्॥ ११३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7001081113, "chapter_id": 21081, "verse_number": "१-१७-११४", "content_sanskrit": "ईशानस्य परस्यैव प्रथमावरणं ततः ।\nध्यानधर्मस्य च स्थानं पंचमं मंडपं ततः॥ ११४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7001081114, "chapter_id": 21081, "verse_number": "१-१७-११५", "content_sanskrit": "बलिनाथस्य संस्थानं तत्र पूर्णामृतप्रदम् ।\nचतुर्थं मंडपं पश्चाच्चंद्र शेखरमूर्तिमत्॥ ११५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7001081115, "chapter_id": 21081, "verse_number": "१-१७-११६", "content_sanskrit": "सोमस्कंदस्य च स्थानं तृतीयं मंडपं परम् ।\nद्वितीयं मंडपं नृत्यमंडपं प्राहुरास्तिकाः॥ ११६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7001081116, "chapter_id": 21081, "verse_number": "१-१७-११७", "content_sanskrit": "प्रथमं मूलमायायाः स्थानं तत्रैव शोभनम् ।\nततः परं गर्भगृहं लिंगस्थानं परं शुभम्॥ ११७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7001081117, "chapter_id": 21081, "verse_number": "१-१७-११८", "content_sanskrit": "नंदिसंस्थानतः पश्चान्न विदुः शिववैभवम् ।\nनंदीश्वरो बहिस्तिष्ठन्पंचाक्षरमुपासते॥ ११८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7001081118, "chapter_id": 21081, "verse_number": "१-१७-११९", "content_sanskrit": "एवं गुरुक्रमाल्लब्धं नंदीशाच्च मया पुनः ।\nततः परं स्वसंवेद्यं शिवे नैवानुभावितम्॥ ११९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7001081119, "chapter_id": 21081, "verse_number": "१-१७-१२०", "content_sanskrit": "शिवस्य कृपया साक्षाच्छिव लोकस्य वैभवम् ।\nविज्ञातुं शक्यते सर्वैर्नान्यथेत्याहुरास्तिकाः॥ १२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7001081120, "chapter_id": 21081, "verse_number": "१-१७-१२१", "content_sanskrit": "एवंक्रमेणमुक्ताः स्युर्ब्राह्मणा वै जितेंद्रि यः ।\nअन्येषां च क्रमं वक्ष्ये गदतः शृणुतादरात्॥ १२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7001081121, "chapter_id": 21081, "verse_number": "१-१७-१२२", "content_sanskrit": "गुरूपदेशाज्जाप्यं वै ब्राह्मणानां नमोऽतकम् ।\nपंचाक्षरं पंचलक्षमायुष्यं प्रजपेद्विधिः॥ १२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7001081122, "chapter_id": 21081, "verse_number": "१-१७-१२३", "content_sanskrit": "स्त्रीत्वापनयनार्थं तु पंचलक्षं जपेत्पुनः ।\nमंत्रेण पुरुषो भूत्वा क्रमान्मुक्तो भवेद्बुधः॥ १२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7001081123, "chapter_id": 21081, "verse_number": "१-१७-१२४", "content_sanskrit": "क्षत्रियः पंचलक्षेण क्षत्त्रत्वमपनेष्यति ।\nपुनश्च पंचलक्षेण क्षत्त्रियो ब्राह्मणो भवेत्॥ १२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7001081124, "chapter_id": 21081, "verse_number": "१-१७-१२५", "content_sanskrit": "मंत्रसिद्धिर्जपाच्चैव क्रमान्मुक्तो भवैन्नरः ।\nवैश्यस्तु पंचलक्षेण वैश्यत्वमपनेष्यति॥ १२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7001081125, "chapter_id": 21081, "verse_number": "१-१७-१२६", "content_sanskrit": "पुनश्च पंचलक्षेण मंत्रक्षत्त्रिय उच्यते ।\nपुनश्च पंचलक्षेण क्षत्त्रत्वमपनेष्यति॥ १२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7001081126, "chapter_id": 21081, "verse_number": "१-१७-१२७", "content_sanskrit": "पुनश्च पंचलक्षेण मंत्रब्राह्मण उच्यते ।\nशूद्र श्चैव नमओंतेन पंचविंशतिलक्षतः॥ १२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7001081127, "chapter_id": 21081, "verse_number": "१-१७-१२८", "content_sanskrit": "मंत्रविप्रत्वमापद्य पश्चाच्छुद्धो भवेद्द्विजः ।\nनारीवाथ नरो वाथ ब्राह्मणो वान्य एव वा॥ १२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}, {"id": 7001081128, "chapter_id": 21081, "verse_number": "१-१७-१२९", "content_sanskrit": "नमोन्तं वा नमःपूर्वमातुरः सर्वदा जपेत् ।\nततः स्त्रीणां तथैवोह्यगुरुर्निर्दर्शयेत्क्रमात्॥ १२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 129}, {"id": 7001081129, "chapter_id": 21081, "verse_number": "१-१७-१३०", "content_sanskrit": "साधकः पंचलक्षान्ते शिवप्रीत्यर्थमेव हि ।\nमहाभिषेक नैवेद्यं कृत्वा भक्तांश्च पूजयेत्॥ १३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 130}, {"id": 7001081130, "chapter_id": 21081, "verse_number": "१-१७-१३१", "content_sanskrit": "पूजया शिवभक्तस्य शिवः प्रीततरो भवेत् ।\nशिवस्य शिवभक्तस्य भेदो नास्ति शिवो हि सः॥ १३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 131}, {"id": 7001081131, "chapter_id": 21081, "verse_number": "१-१७-१३२", "content_sanskrit": "शिवस्वरूपमंत्रस्य धारणाच्छिव एव हि ।\nशिवभक्तशरीरे हि शिवे तत्परमो भवेत्॥ १३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 132}, {"id": 7001081132, "chapter_id": 21081, "verse_number": "१-१७-१३३", "content_sanskrit": "शिवभक्ताः क्रियाः सर्वा वेदसर्वक्रियां विदुः ।\nयावद्यावच्छिवं मंत्रं येन जप्तं भवेत्क्रमात्॥ १३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 133}, {"id": 7001081133, "chapter_id": 21081, "verse_number": "१-१७-१३४", "content_sanskrit": "तावद्वै शिवसान्निध्यं तस्मिन्देहे न संशयः ।\nदेवीलिंगं भवेद्रू पं शिवभक्तस्त्रियास्तथा॥ १३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 134}, {"id": 7001081134, "chapter_id": 21081, "verse_number": "१-१७-१३५", "content_sanskrit": "यावन्मंत्रं जपेद्देव्यास्तावत्सान्निध्यमस्ति हि ।\nशिवं संपूजयेद्धीमान्स्वयं वै शब्दरूपभाक्॥ १३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 135}, {"id": 7001081135, "chapter_id": 21081, "verse_number": "१-१७-१३६", "content_sanskrit": "स्वयं चैव शिवो भूत्वा परां शक्तिं प्रपूजयेत् ।\nशक्तिं बेरं च लिंगं च ह्यालेख्या मायया यजेत्॥ १३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 136}, {"id": 7001081136, "chapter_id": 21081, "verse_number": "१-१७-१३७", "content_sanskrit": "शिवलिंगं शिवं मत्वा स्वात्मानं शक्तिरूपकम् ।\nशक्तिलिंगं च देवीं च मत्वा स्वं शिवरूपकम्॥ १३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 137}, {"id": 7001081137, "chapter_id": 21081, "verse_number": "१-१७-१३८", "content_sanskrit": "शिवलिंगं नादरूपं बिंदुरूपं तु शक्तिकम् ।\nउपप्रधानभावेन अन्योन्यासक्तलिंगकम्॥ १३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 138}, {"id": 7001081138, "chapter_id": 21081, "verse_number": "१-१७-१३९", "content_sanskrit": "पूजयेच्च शिवं शक्तिं स शिवो मूलभावनात् ।\nशिवभक्ताञ्छिवमंत्ररूपकाञ्छिवरूपकान्॥ १३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 139}, {"id": 7001081139, "chapter_id": 21081, "verse_number": "१-१७-१४०", "content_sanskrit": "षोडशैरुपचारैश्च पूजयेदिष्टमाप्नुयात् ।\nयेन शुश्रूषणाद्यैश्च शिवभक्तस्य लिंगिनः॥ १४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 140}, {"id": 7001081140, "chapter_id": 21081, "verse_number": "१-१७-१४१", "content_sanskrit": "आनंदं जनयेद्विद्वाञ्छिवः प्रीततरो भवेत् ।\nशिवभक्तान्सपत्नीकान्पत्न्या सह सदैव तत्॥ १४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 141}, {"id": 7001081141, "chapter_id": 21081, "verse_number": "१-१७-१४२", "content_sanskrit": "पूजयेद्भोजनाद्यैश्च पंच वा दश वा शतम् ।\nधने देहे च मंत्रे च भावनायामवंचकः॥ १४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 142}, {"id": 7001081142, "chapter_id": 21081, "verse_number": "१-१७-१४३", "content_sanskrit": "शिवशक्तिस्वरूपेण न पुनर्जायते भुवि ।\nनाभेरधो ब्रह्मभागमाकंठं विष्णुभागकम्॥ १४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 143}, {"id": 7001081143, "chapter_id": 21081, "verse_number": "१-१७-१४४", "content_sanskrit": "मुखं लिंगमिति प्रोक्तं शिवभक्तशरीरकम् ।\nमृतान्दाहादियुक्तान्वा दाहादिरहितान्मृतान्॥ १४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 144}, {"id": 7001081144, "chapter_id": 21081, "verse_number": "१-१७-१४५", "content_sanskrit": "उद्दिश्य पूजयेदादिपितरं शिवमेव हि ।\nपूजां कृत्वादिमातुश्च शिवभक्तांश्च पूजयेत्॥ १४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 145}, {"id": 7001081145, "chapter_id": 21081, "verse_number": "१-१७-१४६", "content_sanskrit": "पितृलोकं समासाद्यक्रमान्मुक्तो भवेन्मृतः ।\nक्रियायुक्तदशभ्यश्च तपोयुक्तो विशिष्यते॥ १४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 146}, {"id": 7001081146, "chapter_id": 21081, "verse_number": "१-१७-१४७", "content_sanskrit": "तपोयुक्तशतेभ्यश्च जपयुक्तो विशिष्यते ।\nजपयुक्तसहस्रेभ्यः शिवज्ञानी विशिष्यते॥ १४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 147}, {"id": 7001081147, "chapter_id": 21081, "verse_number": "१-१७-१४८", "content_sanskrit": "शिवज्ञानिषु लक्षेषु ध्यानयुक्तो विशिष्यते ।\nध्यानयुक्तेषु कोटिभ्यः समाधिस्थो विशिष्यते॥ १४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 148}, {"id": 7001081148, "chapter_id": 21081, "verse_number": "१-१७-१४९", "content_sanskrit": "उत्तरोत्तर वै शिष्ट्यात्पूजायामुत्तरोत्तरम् ।\nफलं वैशिष्ट्यरूपं च दुर्विज्ञेयं मनीषिभिः॥ १४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 149}, {"id": 7001081149, "chapter_id": 21081, "verse_number": "१-१७-१५०", "content_sanskrit": "तस्माद्वै शिवभक्तस्य माहात्म्यं वेत्ति को नरः ।\nशिवशक्त्योः पूजनं च शिवभक्तस्य पूजनम्॥ १५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 150}, {"id": 7001081150, "chapter_id": 21081, "verse_number": "१-१७-१५१", "content_sanskrit": "कुरुते यो नरो भक्त्या स शिवः शिवमेधते ।\nय इमं पठतेऽध्यायमर्थवद्वेदसंमतम्॥ १५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 151}, {"id": 7001081151, "chapter_id": 21081, "verse_number": "१-१७-१५२", "content_sanskrit": "शिवज्ञानी भवेद्विप्रः शिवेन सह मोदते ।\nश्रावयेच्छिवभक्तांश्च विशेषज्ञो मनीश्वराः॥ १५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 152}, {"id": 7001081152, "chapter_id": 21081, "verse_number": "१-१७-१५३", "content_sanskrit": "शिवप्रसादशिद्धिः स्याच्छिवस्य कृपया बुधाः॥ १५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 153}]