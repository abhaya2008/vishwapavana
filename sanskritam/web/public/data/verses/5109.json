[{"id": 2193242, "chapter_id": 5109, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2193243, "chapter_id": 5109, "verse_number": "१", "content_sanskrit": "ततः स राजा जनकोमन्त्रिभिः सह भारत ।\nपुरः पुरोहितं कृत्वासर्वाण्यन्तःपुराणि च\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2193244, "chapter_id": 5109, "verse_number": "२", "content_sanskrit": "आसनं च पुरस्कृत्य रत्नानि विविधानि च ।\nशिरसा चार्घ्यमादाय गुरुपुत्रं समभ्यगात्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2193245, "chapter_id": 5109, "verse_number": "३", "content_sanskrit": "स तदासनमादायबहुरत्नविभूषितम् ।\nस्पर्ध्यास्तरणसंस्तीर्णंसर्वतोभद्रमृद्धिमत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2193246, "chapter_id": 5109, "verse_number": "४", "content_sanskrit": "पुरोधसा सङ्गृहीतं हस्तेनालभ्य पार्थिवः ।\nप्रददौ गुरुपुत्राय शुकाय परमार्चितम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2193247, "chapter_id": 5109, "verse_number": "५", "content_sanskrit": "तत्रोपविष्टं तं कार्ष्णिं शास्त्रतः प्रत्यपूजयत्।\nपाद्यं निवेद्य प्रथममर्घ्यं गां च न्यवेदयत्॥\nस च तां मन्त्रवत् पूजां प्रत्यगृह्णाद् यथाविधि\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2193248, "chapter_id": 5109, "verse_number": "६", "content_sanskrit": "प्रतिगृह्य च तां पूजां जनकाद् द्विजसत्तमः ।\nगां चैव समनुज्ञाय राजानमनुमान्यच\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2193249, "chapter_id": 5109, "verse_number": "७", "content_sanskrit": "पर्यपृच्छन्महातेजा राज्ञः कुशलमव्ययम् ।\nअनामयं च राजेन्द्रशुकः सानुचरस्य ह\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2193250, "chapter_id": 5109, "verse_number": "८", "content_sanskrit": "अनुज्ञातः स तेनाथ निषसाद सहानुगः।\nउदारसत्त्वाभिजनो भूमौ राजा कृताञ्जलिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2193251, "chapter_id": 5109, "verse_number": "९", "content_sanskrit": "कुशलं चाव्ययं चैव पृष्ट्वा वैयासकिं नृपः ।\nकिमागमनमित्येव पर्यपृच्छत पार्थिवः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2193252, "chapter_id": 5109, "verse_number": "", "content_sanskrit": "शुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2193253, "chapter_id": 5109, "verse_number": "१०", "content_sanskrit": "पित्राहमुक्तो भद्रं ते मोक्षधर्मार्थकोविदः ।\nविदेहराजो याज्यो मेजनको नाम विश्रुतः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2193254, "chapter_id": 5109, "verse_number": "११", "content_sanskrit": "तत्र गच्छस्व वै तूर्णं यदि ते हृदि संशयः ।\nप्रवृत्तौ वा निवृत्तौ वा स ते छेत्स्यति संशयम्॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2193255, "chapter_id": 5109, "verse_number": "१२", "content_sanskrit": "सोऽहं पितुर्नियोगात्त्वामुपप्रष्टुमिहागतः।\nतन्मे धर्मभृतां श्रेष्ठ यथावद् वक्तुमर्हसि\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2193256, "chapter_id": 5109, "verse_number": "१३", "content_sanskrit": "किं कार्यं ब्राह्मणेनेह मोक्षार्थश्च किमात्मकः।\nकथं च मोक्षः कर्तव्यो ज्ञानेन तपसापि वा\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2193257, "chapter_id": 5109, "verse_number": "", "content_sanskrit": "जनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2193258, "chapter_id": 5109, "verse_number": "१४", "content_sanskrit": "यत् कार्यं ब्राह्मणेनेह जन्मप्रभृति तच्छृणु ।\nकृतोपनयनस्तात भवेद्वेदपरायणः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2193259, "chapter_id": 5109, "verse_number": "१५", "content_sanskrit": "तपसा गुरुवृत्त्या च ब्रह्मचर्येण चाभिभो ।\nदेवतानां पितॄणांचाप्यनृणश्चानसूयकः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2193260, "chapter_id": 5109, "verse_number": "१६", "content_sanskrit": "वेदानधीत्य नियतो दक्षिणामपवर्ज्य च ।\nअभ्यनुज्ञामथ प्राप्य समावर्तेत वै द्विजः\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2193261, "chapter_id": 5109, "verse_number": "१७", "content_sanskrit": "समावृत्तस्तु गार्हस्थ्ये सदारो नियतो वसेत् ।\nअनसूयुर्यथान्यायमाहिताग्निस्तथैव च॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2193262, "chapter_id": 5109, "verse_number": "१८", "content_sanskrit": "उत्पाद्य पुत्रपौत्रं तु वन्याश्रमपदे वसेत्।\nतानेवाग्नीन् यथाशास्त्रमर्चयन्नतिथिप्रियः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2193263, "chapter_id": 5109, "verse_number": "१९", "content_sanskrit": "स वनेऽग्नीन् यथान्यायमात्मन्यारोप्यधर्मवित् ।\nनिर्द्वंद्वो वीतरागात्मा ब्रह्माश्रमपदे वसेत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2193264, "chapter_id": 5109, "verse_number": "", "content_sanskrit": "शुकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2193265, "chapter_id": 5109, "verse_number": "२०", "content_sanskrit": "उत्पन्ने ज्ञानविज्ञाने प्रत्यक्षे हृदि शाश्वते ।\nकिमवश्यं निवस्तव्यमाश्रमेषु वनेषु च॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2193266, "chapter_id": 5109, "verse_number": "२१", "content_sanskrit": "एतद् भवन्तं पृच्छामि तद् भवान् वक्तुमर्हति ।\nयथावेदार्थतत्त्वेन ब्रूहि मे त्वं जनाधिप\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2193267, "chapter_id": 5109, "verse_number": "", "content_sanskrit": "जनकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2193268, "chapter_id": 5109, "verse_number": "२२", "content_sanskrit": "न विना ज्ञानविज्ञानंमोक्षस्याधिगमो भवेत् ।\nन विना गुरुसम्बन्धं ज्ञानस्याधिगमः स्मृतः॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2193269, "chapter_id": 5109, "verse_number": "२३", "content_sanskrit": "आचार्यः प्लाविता तस्य ज्ञानं प्लव इहोच्यते ।\nविज्ञाय कृतकृत्यस्तु तीर्णस्तदुभयंत्यजेत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2193270, "chapter_id": 5109, "verse_number": "२४", "content_sanskrit": "अनुच्छेदाय लोकानामनुच्छेदाय कर्मणाम् ।\nपूर्वैराचरितो धर्मश्चातुराश्रम्यसङ्कथः॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2193271, "chapter_id": 5109, "verse_number": "२५", "content_sanskrit": "अनेन क्रमयोगेन बहुजातिषु कर्मणा ।\nकृत्वाशुभाशुभं कर्म मोक्षो नामेह लभ्यते\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2193272, "chapter_id": 5109, "verse_number": "२६", "content_sanskrit": "भवितैः कारणैश्चायं बहुसंसारयोनिषु ।\nआसादयति शुद्धात्मामोक्षं वै प्रथमाश्रमे\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2193273, "chapter_id": 5109, "verse_number": "२७", "content_sanskrit": "तमासाद्य तु मुक्तस्यदृष्टार्थस्य विपश्चितः ।\nत्रिष्वाश्रमेषु को न्वर्थो भवेत् परमभीप्सतः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2193274, "chapter_id": 5109, "verse_number": "२८", "content_sanskrit": "राजसांस्तामसांश्चैव नित्यं दोषान् विवर्जयेत् ।\nसात्त्विकं मार्गमास्थाय पश्येदात्मानमात्मना\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2193275, "chapter_id": 5109, "verse_number": "२९", "content_sanskrit": "सर्वभूतेषु चात्मानं सर्वभूतानि चात्मनि ।\nसम्पश्यन्नोपलिप्येत जले वारिचरो यथा\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2193276, "chapter_id": 5109, "verse_number": "३०", "content_sanskrit": "पक्षीव प्लवनादूर्ध्वममुत्रानन्त्यमश्नुते ।\nविहाय देहं निर्मुक्तो निर्द्वंद्वः प्रशमंगतः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2193277, "chapter_id": 5109, "verse_number": "३१", "content_sanskrit": "अत्र गाथाः पुरा गीताः शृणु राज्ञा ययातिना ।\nधार्यन्ते या द्विजैस्तात मोक्षशास्त्रविशारदैः॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2193278, "chapter_id": 5109, "verse_number": "३२", "content_sanskrit": "ज्योतिरात्मनि नान्यत्र रतं तत्रैव चैव तत् ।\nस्वयं च शक्यं तद्द्रष्टुं सुसमाहितचेतसा॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2193279, "chapter_id": 5109, "verse_number": "३३", "content_sanskrit": "न बिभेति परो यस्मान्न बिभेति पराच्च यः ।\nयश्च नेच्छति न द्वेष्टि ब्रह्म सम्पद्यते तदा॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2193280, "chapter_id": 5109, "verse_number": "३४", "content_sanskrit": "यदा भावं न कुरुते सर्वभूतेषु पापकम् ।\nकर्मणा मनसा वाचा ब्रह्म सम्पद्यते तदा\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2193281, "chapter_id": 5109, "verse_number": "३५", "content_sanskrit": "संयोज्य तपसात्मानमीर्ष्यामुत्सृज्य मोहिनीम् ।\nत्यक्त्वा कामं च लोभं च ततोब्रह्मत्वमश्नुते\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2193282, "chapter_id": 5109, "verse_number": "३६", "content_sanskrit": "यदा श्रव्ये च दृश्ये च सर्वभूतेषु चाप्ययम्।\nसमो भवति निर्द्वन्द्वो ब्रह्म सम्पद्यते तदा\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2193283, "chapter_id": 5109, "verse_number": "३७", "content_sanskrit": "यदा स्तुतिं च निन्दां च समत्वेनैव पश्यति ।\nकाञ्चनं चायसं चैव सुखदुःखेतथैव च\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2193284, "chapter_id": 5109, "verse_number": "३८", "content_sanskrit": "शीतमुष्णंतथैवार्थमनर्थं प्रियमप्रियम् ।\nजीवितं मरणं चैव ब्रह्म सम्पद्यते तदा\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2193285, "chapter_id": 5109, "verse_number": "३९", "content_sanskrit": "प्रसार्येह यथाङ्गानि कूर्मः संहरतेपुनः ।\nतथेन्द्रियाणि मनसा संयन्तव्यानिभिक्षुणा\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2193286, "chapter_id": 5109, "verse_number": "४०", "content_sanskrit": "तमःपरिगतं वेश्म यथा दीपेन दृश्यते ।\nतथा बुद्धिप्रदीपेन शक्य आत्मा निरीक्षितुम्॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2193287, "chapter_id": 5109, "verse_number": "४१", "content_sanskrit": "एतत् सर्वं प्रपश्यामि त्वयि बुद्धिमतांवर ।\nयच्चान्यदपि वेत्तव्यं तत्त्वतो वेद तद् भवान्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2193288, "chapter_id": 5109, "verse_number": "४२", "content_sanskrit": "ब्रह्मर्षे विदितश्चासि विषयान्तमुपागतः ।\nगुरोस्तव प्रसादेन तव चैवोपशिक्षया॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2193289, "chapter_id": 5109, "verse_number": "४३", "content_sanskrit": "तस्यैव च प्रसादेन प्रादुर्भूतं महामुने ।\nज्ञानं दिव्यं ममापीदंतेनासि विदितो मम\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2193290, "chapter_id": 5109, "verse_number": "४४", "content_sanskrit": "अधिकं तव विज्ञानमधिका च गतिस्तव ।\nअधिकं च तवैश्वर्यं तच्च त्वंनावबुध्यसे\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2193291, "chapter_id": 5109, "verse_number": "४५", "content_sanskrit": "बाल्याद्वा संशयाद्वापि भयाद्वाप्यविमोक्षजात् ।\nउत्पन्ने चापि विज्ञाने नाधिगच्छति तां गतिम्\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2193292, "chapter_id": 5109, "verse_number": "४६", "content_sanskrit": "व्यवसायेन शुद्धेन मद्विधैश्छिन्नसंशयः ।\nविमुच्य हृदयग्रन्थीनासादयति तां गतिम्\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2193293, "chapter_id": 5109, "verse_number": "४७", "content_sanskrit": "भवांश्चोत्पन्नविज्ञानः स्थिरबुद्धिरलोलुपः ।\nव्यवसायादृते ब्रह्मन्नासादयति तत्परम्\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2193294, "chapter_id": 5109, "verse_number": "४८", "content_sanskrit": "नास्ति ते सुखदुःखेषु विशेषो नास्ति लोलुपा।\nनौत्सुक्यं नृत्तगीतेषु न राग उपजायते\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2193295, "chapter_id": 5109, "verse_number": "४९", "content_sanskrit": "न बन्धुषुनिबन्धस्ते न भयेष्वस्ति ते भयम् ।\nपश्यामि त्वां महाभाग तुल्यलोष्टाश्मकाञ्चनम्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2193296, "chapter_id": 5109, "verse_number": "५०", "content_sanskrit": "अहं च त्वानुपश्यामि ये चाप्यन्ये मनीषिणः ।\nआस्थितंपरमं मार्गमक्षयं तमनामयम्\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2193297, "chapter_id": 5109, "verse_number": "५१", "content_sanskrit": "यत्फलं ब्राह्मणस्येह मोक्षार्थश्चयदात्मकः ।\nतस्मिन् वै वर्तसे विप्र किमन्यत् परिपृच्छसि\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2193298, "chapter_id": 5109, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां शान्तिपर्वणि मोक्षधर्मे शुकजनकसंवादे ब्रह्मप्रतिपादनं नाम अष्टपञ्चाशोत्तरशततमोऽध्यायः ॥१५८॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]