[{"id": 7002296000, "chapter_id": 22296, "verse_number": "३४१-१", "content_sanskrit": "अग्निरुवाच ।\nचेष्टाविशेषमप्यङ्गप्रत्यङ्गे कर्म्म चानयोः ।\nशरीरारम्भमिच्छन्ति प्रायः पूर्व्वोऽवलाश्रयः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002296001, "chapter_id": 22296, "verse_number": "३४१-२", "content_sanskrit": "लीला विलासो विच्छित्तिर्विभ्रमं किलकिञ्चितं ।\nमोट्टायितं कुट्टमितं विव्वोको ललितन्तथा ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002296002, "chapter_id": 22296, "verse_number": "३४१-३", "content_sanskrit": "विकृतं क्रीड़ितं केलिरिति द्वादशधैव सः ।\nलीलेष्टजनचेष्टानुकरणं संवृतक्षये ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002296003, "chapter_id": 22296, "verse_number": "३४१-४", "content_sanskrit": "विशेषान् दर्शयन् किञ्चिद्विलासः सद्भिरिष्यते ।\nहसितक्रन्दितादीनां सङ्करः किलकिञ्चितं ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002296004, "chapter_id": 22296, "verse_number": "३४१-५", "content_sanskrit": "विकारः कोपि विव्वोको ललितं सौकुमार्य्यतः ।\nशिरः पाणिरुपः पार्श्वङ्गटिरङ्घ्रिरिति क्रमात् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002296005, "chapter_id": 22296, "verse_number": "३४१-६", "content_sanskrit": "अङ्गनि भ्रूलतादीनि प्रत्यङ्गान्यभिजानते ।\nअड्गप्रत्यङ्गयोः कर्म्म प्रयलजनितं विना ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002296006, "chapter_id": 22296, "verse_number": "३४१-७", "content_sanskrit": "न प्रयोगः क्कचिन्मुख्यन्तिरश्चीनञ्च तत् क्कचिच् ।\nआकम्पितं कम्पितञ्च१ धूतं विधूतमेव च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002296007, "chapter_id": 22296, "verse_number": "३४१-८", "content_sanskrit": "परिवाहिनमाधूतमवधूतमथाचितं ।\nनिकुञ्चितं परवृत्तमुत्क्षिप्तञ्चाप्यधोगतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002296008, "chapter_id": 22296, "verse_number": "३४१-९", "content_sanskrit": "ललितञ्चेति विज्ञेयं त्रयोदशविधं शिरः ।\nभ्रूकर्म्म सप्तधा ज्ञेयं पातनं भ्रूकुटीमुखं ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002296009, "chapter_id": 22296, "verse_number": "३४१-१०", "content_sanskrit": "दृष्टिस्त्रिधा रसस्थायिसञ्चारिप्रतिबन्धना ।\nषट्त्रिंशद्भेदविधुरा रसजा तत्र चाष्टधा ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002296010, "chapter_id": 22296, "verse_number": "३४१-११", "content_sanskrit": "नवधा तारकाकर्म्म भ्रमणञ्चलनादिकं ।\nषोढ़ा च नासिका ज्ञेया निश्वासो नवदा मतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002296011, "chapter_id": 22296, "verse_number": "३४१-१२", "content_sanskrit": "षोढौष्ठकर्म्मकं पापं सप्तधा चिवुकक्रिया ।\nकलुषादिमुखं षोढ़ा ग्रीवा नवविधा स्मृता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002296012, "chapter_id": 22296, "verse_number": "३४१-१३", "content_sanskrit": "असंयुतः संयुतश्च भूम्ना हस्तः प्रमुच्यते ।\nपताकस्त्रिपताकश्च तथा वै कर्त्तरीमुखः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002296013, "chapter_id": 22296, "verse_number": "३४१-१४", "content_sanskrit": "अर्द्धचन्द्रोत्करालश्च शुक्तुण्डस्तथैव च ।\nमुष्टिश्च शिखरश्चैव कपित्थः खेटकामुखः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002296014, "chapter_id": 22296, "verse_number": "३४१-१५", "content_sanskrit": "सूच्यास्यः पद्मकोषो हि शिराः समृगशीर्षकाः ।\nकांमूलकालपद्मौ च चतुरभ्रमरौ तथा ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002296015, "chapter_id": 22296, "verse_number": "३४१-१६", "content_sanskrit": "हंसास्यहंसपक्षौ च सन्दंशमुकुलौ तथा ।\nउर्णनाभस्तात्रचूडश्चतुर्विंशतिरित्यमी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002296016, "chapter_id": 22296, "verse_number": "३४१-१७", "content_sanskrit": "असंयुतकराः प्रोक्ताः संयुतास्तु त्रयोदश ।\nअञ्जलिश्च कपोतश्च कर्कटः स्वस्तिकस्तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002296017, "chapter_id": 22296, "verse_number": "३४१-१८", "content_sanskrit": "कटको वर्द्धमानश्चाप्यसङ्गो निषधस्तथा ।\nदोलः पुष्पपुटश्चैव तथा मकर एव च ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002296018, "chapter_id": 22296, "verse_number": "३४१-१९", "content_sanskrit": "गजदन्तो वहिस्तम्भो वर्द्धमानोऽपरे कराः ।\nउरः पञ्चविधं स्यात्तु आभुग्ननर्त्तनादिकम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002296019, "chapter_id": 22296, "verse_number": "३४१-२०", "content_sanskrit": "उदरन्दुरतिक्षामं खण्डं पूर्णमिति त्रिधा ।\nपार्श्वयोः पञ्चकर्म्माणि जङ्घाकर्म च पञ्चवा ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]