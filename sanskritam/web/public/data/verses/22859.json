[{"id": 7002859000, "chapter_id": 22859, "verse_number": "९-१४४-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nशांतिं कथय देवेश गणनाथस्य मे विभो ।\nयां कृत्वा सर्वदुर्गाणि तरते मानवोऽखिलः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002859001, "chapter_id": 22859, "verse_number": "९-१४४-२", "content_sanskrit": "श्रीकृष्ण उवाच ।\nशांतिं वक्ष्यामि राजेन्द्र गणनाथप्रियां पराम् ।\nयस्या आचरणेनैव सर्वारिष्टक्षयो भवेत् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002859002, "chapter_id": 22859, "verse_number": "९-१४४-३", "content_sanskrit": "विनायकं कर्माविघ्नसिद्ध्यर्थं विनिबोधत ।\nस्वप्नेऽवगाहतेऽत्यर्थं जलं मुंडांश्च पश्यति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002859003, "chapter_id": 22859, "verse_number": "९-१४४-४", "content_sanskrit": "काषायवाससश्चैव क्रव्यादानधिरोहति ।\nअपमूर्धैः शवे रुद्रैः सहैकत्र च तिष्ठति ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002859004, "chapter_id": 22859, "verse_number": "९-१४४-५", "content_sanskrit": "व्रजन्नपि तथात्मानं मन्यतेनुगतं परैः ।\nविमना विफलारंभः संसीदत्यनिमित्ततः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002859005, "chapter_id": 22859, "verse_number": "९-१४४-६", "content_sanskrit": "तेनोपसृष्टो लभते न राज्यं राजनंदनः ।\nकुमारी न च भर्तारमपत्यं गर्भिणी तथा ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002859006, "chapter_id": 22859, "verse_number": "९-१४४-७", "content_sanskrit": "आचार्यत्वं श्रोत्रियश्च न शिष्योऽध्यापनं तथा ।\nवणिग्लाभं न चाप्नोति न कृषिं च कृषीवलः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002859007, "chapter_id": 22859, "verse_number": "९-१४४-८", "content_sanskrit": "स्नपनं तस्य कर्तव्यं पुण्येऽह्नि विधिपूर्वकम् ।\nगौरसर्षपकल्केन साज्येनोत्सादितस्य तु ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002859008, "chapter_id": 22859, "verse_number": "९-१४४-९", "content_sanskrit": "सुगन्धकुंकुमालिप्तशरीरशिरसस्तथा ।\nभद्रासनोपविष्टस्य स्वस्ति वाच्य द्विजाञ्छुभान् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002859009, "chapter_id": 22859, "verse_number": "९-१४४-१०", "content_sanskrit": "अश्वस्थानाद्गजस्थानाद्वल्मीकात्संगमाद्ध्रदात् ।\nमृत्तिकां रोचनां गंधान्गुग्गुलं चाप्सु निक्षिपेत् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002859010, "chapter_id": 22859, "verse_number": "९-१४४-११", "content_sanskrit": "यदा हृता ह्येकवणैर्मनुभिः कलशैर्ह्रदात् ।\nचर्मण्यानडुहे रक्ते स्थाप्य भद्रासनं तथा ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002859011, "chapter_id": 22859, "verse_number": "९-१४४-१२", "content_sanskrit": "सहस्राक्षं शतधारमृषिणा वचनं कृतम् ।\nतेन त्वामभिषिंचामि पावमान्यः पुनंतु ते ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002859012, "chapter_id": 22859, "verse_number": "९-१४४-१३", "content_sanskrit": "भगं ते वरुणो राजा भगं सूर्यो बृहस्पतिः ।\nभगमिन्द्रश्च वायुश्च भगं सप्तर्षयो ददुः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002859013, "chapter_id": 22859, "verse_number": "९-१४४-१४", "content_sanskrit": "यत्ते केशेषु दौर्भाग्यं सीमंते यच्च मूर्द्धनि ।\nललाटे कर्णयोरक्ष्णोरापस्तद्घ्नन्तु ते सदा ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002859014, "chapter_id": 22859, "verse_number": "९-१४४-१५", "content_sanskrit": "स्नातस्य सार्षपं तैलं स्रुवेणौदुम्बरेण च ।\nजुहुयान्मूर्द्धनि कुशान्सव्येन परिगृह्य च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002859015, "chapter_id": 22859, "verse_number": "९-१४४-१६", "content_sanskrit": "मितश्च समितश्चैव तथा सालकटंकटौ ।\nकूष्मांडो राजपुत्रश्च अंते स्वाहासमन्वितैः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002859016, "chapter_id": 22859, "verse_number": "९-१४४-१७", "content_sanskrit": "नामभिर्बलिमंत्रैश्च नमस्कारसमन्वितैः ।\nदद्याच्चतुष्पथे शूर्पे कुशानास्तीर्य सर्वशः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7002859017, "chapter_id": 22859, "verse_number": "९-१४४-१८", "content_sanskrit": "कृता कृतांस्तंडुलांश्च पललौदनमेव च ।\nमत्स्यान्पक्वांस्तथैवामान्मांसमेतावदेव तु ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7002859018, "chapter_id": 22859, "verse_number": "९-१४४-१९", "content_sanskrit": "पुष्पं चित्रं सुगन्धं च सुरां च त्रिविधामपि ।\nमूलकं पूरि कापूपं तथैवोंडेरकस्रजम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7002859019, "chapter_id": 22859, "verse_number": "९-१४४-२०", "content_sanskrit": "दूर्वां सर्वप्रपुष्पाणां दत्त्वार्घ्यं पूर्णमडलाम् ।\nविनायकस्य जननीमुपतिष्ठेत्ततोंऽबिकाम् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7002859020, "chapter_id": 22859, "verse_number": "९-१४४-२१", "content_sanskrit": "रूपं देहि यशो देहि भगं भवति देहि मे ।\nपुत्रान्देहि धनं देहि सर्वकामांश्च देहि मे ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7002859021, "chapter_id": 22859, "verse_number": "९-१४४-२२", "content_sanskrit": "ततः शुक्लांबरधरः शुक्लमाल्यानुलेपनः ।\nभोजयेद्ब्राह्मणान्दद्याद्वस्त्रयुग्मं गुरोरपि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7002859022, "chapter_id": 22859, "verse_number": "९-१४४-२३", "content_sanskrit": "एवं विनायकं पूज्य ग्रहांश्चैव विधानतः ।\nकर्मणां फलमाप्नोति श्रियमाप्नोति चोत्तमाम् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7002859023, "chapter_id": 22859, "verse_number": "९-१४४-२४", "content_sanskrit": "आदित्यस्य तथा पूजां तिलकं स्वामिनस्तथा ।\nमहागणपतेश्चैव कुर्वन्सिद्धिमवाप्नुयात् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7002859024, "chapter_id": 22859, "verse_number": "९-१४४-२५", "content_sanskrit": "श्वेतार्कस्य तु यो मूले महागणपतिः कृतः ।\nसर्वलक्षणसंपूर्णः सोऽपि सिद्धिकरः स्मृतः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7002859025, "chapter_id": 22859, "verse_number": "९-१४४-२६", "content_sanskrit": "संजप्यते शुचौ देशे विघ्नं नात्र हि देहिनः ।\nपरमं पूजयेन्नित्यं गन्धमाल्यस्रगादिभिः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7002859026, "chapter_id": 22859, "verse_number": "९-१४४-२७", "content_sanskrit": "क्षीणभाग्योऽपि पुरुषः पूजितश्च नरेश्वरः ।\nसर्वसिद्धिमवाप्नोति जयी भवति सर्वदा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]