[{"id": 2178178, "chapter_id": 4766, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2178179, "chapter_id": 4766, "verse_number": "१", "content_sanskrit": "विदुरस्य तु तद्वाक्यं श्रुत्वा तु पुरुषर्षभः ।\nयुज्यतां यानमित्युक्त्वा पुनर्वचनमब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2178180, "chapter_id": 4766, "verse_number": "२", "content_sanskrit": "क्षिप्रमानय गान्धारीं सर्वाश्च भरतस्त्रियः ।\nकुन्तीं चैव तथा क्षत्तः समानय ममान्तिकम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2178181, "chapter_id": 4766, "verse_number": "३", "content_sanskrit": "एवमुक्त्वा तु धर्मात्मा विदुरं धर्मवित्तमम् ।\nशोकविप्रहतज्ञानो यानमेवान्वरोहत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2178182, "chapter_id": 4766, "verse_number": "४", "content_sanskrit": "गान्धारी चैव शोकार्ता भर्तुर्वचनचोदिता ।\nसह कुन्त्या यतो राजा सह स्त्रीभिः समाद्रवत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2178183, "chapter_id": 4766, "verse_number": "५", "content_sanskrit": "ताः समासाद्य राजानं भृशं शोकसमन्विताः ।\nआमन्त्र्यान्योन्यमायस्ता भृशं वै चुक्रुशुस्तथा\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2178184, "chapter_id": 4766, "verse_number": "६", "content_sanskrit": "ताः समाश्वासयत् क्षत्ता ताभ्यश्चार्ततरःस्वयम् ।\nअश्रुकण्ठीः समारोप्य ततस्ता निर्ययुः पुरात्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2178185, "chapter_id": 4766, "verse_number": "७", "content_sanskrit": "ततः प्रणादः सञ्जज्ञे सर्वेषु कुरुवेश्मसु ।\nआकुमारं पुरं तच्चाप्यभवच्छोककर्शितम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2178186, "chapter_id": 4766, "verse_number": "८", "content_sanskrit": "अदृष्टपूर्वा या नार्यः पुरा देवगणैरपि ।\nपृथग्जनेन दृश्यन्ते तास्तदा निहितेश्वराः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2178187, "chapter_id": 4766, "verse_number": "९", "content_sanskrit": "प्रकीर्य केशानसितान् भूषणान्यवमुच्य च ।\nएकवस्त्रधरा नार्यः परिपेतुरनाथवत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2178188, "chapter_id": 4766, "verse_number": "१०", "content_sanskrit": "श्वेतपर्वतरूपेभ्यो गृहेभ्यस्ता निराक्रमन् ।\nगुहाभ्य इव शैलानां पृषत्यो हतयूथपाः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2178189, "chapter_id": 4766, "verse_number": "११", "content_sanskrit": "तान्युदीर्णानि नारीणां तदा बृन्दान्यनेकशः ।\nशोकार्तान्यरुदन् घोरं किशोराणामिवाङ्कणे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2178190, "chapter_id": 4766, "verse_number": "१२", "content_sanskrit": "प्रगृह्य बाहून् क्रोशन्त्यः पुत्रान् भ्रातॄन् पितॄनपि ।\nदर्शयन्त्य इवाभस्म युगान्ते लोकसङ्क्षये\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2178191, "chapter_id": 4766, "verse_number": "१३", "content_sanskrit": "विलपन्त्यो रुदन्त्यश्च धावमाना इतस्ततः ।\nशोकेन विहतज्ञानाः कर्तव्यं न प्रजज्ञिरे\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2178192, "chapter_id": 4766, "verse_number": "१४", "content_sanskrit": "व्रीळां जग्मुः पुरा याः स्म सखीनामपि योषितः ।\nनिर्लज्जास्तास्तु राजेन्द्र श्वश्रूणामपि सन्निधौ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2178193, "chapter_id": 4766, "verse_number": "१५", "content_sanskrit": "परस्परं सुसूक्ष्मेषु शोकेष्वाश्वासयन्ति याः ।\nताः शोकविह्वला राजन् नावैक्षन्त परस्परम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2178194, "chapter_id": 4766, "verse_number": "१६", "content_sanskrit": "ताभिः परिवृतो राजा रुदन्तीभिः सहस्रशः ।\nनिर्ययौ नगरात् तूर्णं दीनस्त्वायोधनं प्रति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2178195, "chapter_id": 4766, "verse_number": "१७", "content_sanskrit": "शिल्पिनो वणिजो वैश्याः सर्वकर्मोपजीविनः ।\nते पार्थिवं पुरस्कृत्य निर्ययुर्नगराद् बहिः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2178196, "chapter_id": 4766, "verse_number": "१८", "content_sanskrit": "तेषां विक्रोशमानानामार्तानां कुरुसङ्क्षये ।\nप्रादुरासीन्महान् शब्दो व्यथयन् भुवनान्युत\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2178197, "chapter_id": 4766, "verse_number": "१९", "content_sanskrit": "युगान्तकाले सम्प्राप्ते भूतानां दह्यतामिव ।\nअभावस्योदयं प्राप्त इति भूतानि मेनिरे\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2178198, "chapter_id": 4766, "verse_number": "२०", "content_sanskrit": "भृशमुद्विग्नमनसस्ते पौरा जनसङ्क्षये ।\nप्राक्रोशन्त महाराज स्वनुरक्तास्तदा भृशम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2178199, "chapter_id": 4766, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां स्त्रीपर्वणि\nदशमोऽध्यायः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2178200, "chapter_id": 4766, "verse_number": "", "content_sanskrit": "जलप्रदानपर्वणि दशमोऽध्यायः ॥१०॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]