[{"id": 2023608, "chapter_id": 1506, "verse_number": "३-१४४-०x", "content_sanskrit": "[लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2023609, "chapter_id": 1506, "verse_number": "३-१४४-१", "content_sanskrit": "द्रष्टारः पर्वताः सर्वे नद्यः सपुरकाननाः।\nतीर्थानि चैव श्रीमन्ति स्पृष्टं च सलिलं करैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2023610, "chapter_id": 1506, "verse_number": "३-१४४-२", "content_sanskrit": "पर्वतं मन्दरं दिव्यमेष पन्थाः प्रयास्यति।\nसमाहीता निरुद्विग्नाः सर्वे भवत पाण्डवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2023611, "chapter_id": 1506, "verse_number": "३-१४४-३", "content_sanskrit": "अयं देवनिवासो वै गन्तव्यो वो भविष्यति।\nऋषीणां चैव दिव्यानां निवासः पुण्यकर्मणां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2023612, "chapter_id": 1506, "verse_number": "३-१४४-४", "content_sanskrit": "एषा शिवजला पुण्या याति सौम्य महानदी।\nबदरीप्रभवा राजन्देवर्षिगणसेविता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2023613, "chapter_id": 1506, "verse_number": "३-१४४-५", "content_sanskrit": "एषा वैहायसैर्नित्यं वालखिल्यैर्महात्मभिः।\nअर्चिता चोपयाता च गन्धर्वैश्च महात्मभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2023614, "chapter_id": 1506, "verse_number": "३-१४४-६", "content_sanskrit": "अत्रसाम स्म गायन्ति सामगाः पुण्यनिःस्वनाः।\nमरीचिः पुलहश्चैव भृगुश्चैवाङ्गिरास्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2023615, "chapter_id": 1506, "verse_number": "३-१४४-७", "content_sanskrit": "अत्राह्निकं सुरश्रेष्ठो जपते समरुद्गणः।\nसाध्याश्चैवाश्विनौ चैव परिधावन्ति तं तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2023616, "chapter_id": 1506, "verse_number": "३-१४४-८", "content_sanskrit": "चन्द्रमाः सह सूर्येण ज्योतीषि च ग्रहैः सह।\nअहोरात्रविभागेन नदीमेनामनुव्रजन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2023617, "chapter_id": 1506, "verse_number": "३-१४४-९", "content_sanskrit": "एतस्याः सलिलं मूर्ध्नि वृषाङ्कः पर्यधारयत्।\nगङ्गाद्वारे महाभाग येन लोकस्थितिर्भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2023618, "chapter_id": 1506, "verse_number": "३-१४४-१०", "content_sanskrit": "एतां भगवतीं देवीं भवन्तः सर्व एव हि।\nप्रयतेनात्मना तात प्रतिगम्याभिवादत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2023619, "chapter_id": 1506, "verse_number": "३-१४४-११", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा लोमशस्य महात्मनः।\nआकाशगङ्गां प्रयताः पाण्डवास्तेऽभ्यवादयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2023620, "chapter_id": 1506, "verse_number": "३-१४४-१२", "content_sanskrit": "अभिवाद्य च ते सर्वे पाण्डवा धर्मचारिणः।\nपुनः प्रयाताः संहृष्टाः सर्वैर्ऋषिगणैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2023621, "chapter_id": 1506, "verse_number": "३-१४४-१३", "content_sanskrit": "ततो दूरात्प्रकाशन्तं पाण्डुरं मेरुसंनिभम्।\nददृशुस्ते नरश्रेष्ठा विकीर्णं सर्वतोदिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2023622, "chapter_id": 1506, "verse_number": "३-१४४-१४", "content_sanskrit": "तान्प्रष्टुकामान्विज्ञाय पाण्डवान्स तु लोमशः।\nउवाच वाक्यं वाक्यज्ञः शृणुध्वं पाण्डुनन्दनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2023623, "chapter_id": 1506, "verse_number": "३-१४४-१५", "content_sanskrit": "एतद्विकीर्णं सुश्रीमत्कैलासशिखरोपमम्।\nयत्पश्यसि नरश्रेष्ठ पर्वतप्रतिमं स्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2023624, "chapter_id": 1506, "verse_number": "३-१४४-१६", "content_sanskrit": "एतान्यस्थीनि दैत्यस्य नरकस्य महात्मनः।\nपर्वतप्रतिमं भाति पर्वतप्रस्तराश्रितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2023625, "chapter_id": 1506, "verse_number": "३-१४४-१७", "content_sanskrit": "पुरातनेन देवेन विष्णुना परमात्मना।\nरदैत्यो विनिहतस्तेन सुरराजहितैषिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2023626, "chapter_id": 1506, "verse_number": "३-१४४-१८", "content_sanskrit": "दशवर्षसहस्राणि तपस्तप्यन्महामनाः।\nऐनद्रं प्रार्थयते स्थानं तपःस्वाध्यायविक्रमात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2023627, "chapter_id": 1506, "verse_number": "३-१४४-१९", "content_sanskrit": "तपोबलेन महता बाहुवेगबलेन च।\nनित्यमेव दुराधर्षो धर्षयन्स दितेः सुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2023628, "chapter_id": 1506, "verse_number": "३-१४४-२०", "content_sanskrit": "स तु तस्य बलं ज्ञात्वा धर्मे च चरितव्रतम्।\nभयाभिभूतः संविग्नः शक्र आसीत्तदाऽनघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2023629, "chapter_id": 1506, "verse_number": "३-१४४-२१", "content_sanskrit": "तेन संचिन्तितो देवो मनसा विष्णुरव्ययः।\nसर्वत्रगः प्रभुः श्रीमानागतश्च स्थितो बभौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2023630, "chapter_id": 1506, "verse_number": "३-१४४-२२", "content_sanskrit": "ऋषयश्चापि तं सर्वे तुष्टुवुश्च दिवौकसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2023631, "chapter_id": 1506, "verse_number": "३-१४४-२३", "content_sanskrit": "तं दृष्ट्वा ज्वलमानश्रीर्भगवान्हव्यवाहनः।\nनष्टतेजाः समभवत्तस्य तेजोभिभर्त्सितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2023632, "chapter_id": 1506, "verse_number": "३-१४४-२४", "content_sanskrit": "तं दृष्ट्वा वरदं देवं विष्णुं देवगणेश्वरम्।\nप्राञ्जलिः प्रणतो भूत्वा नमस्कृत्य च वज्रभृत्।\nप्राह वाक्यं ततस्तत्त्वं यतस्तस्य भयं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2023633, "chapter_id": 1506, "verse_number": "३-१४४-२५x", "content_sanskrit": "विष्णुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2023634, "chapter_id": 1506, "verse_number": "३-१४४-२५", "content_sanskrit": "जानामि ते भयं शक्र दैत्येन्द्रान्नरकात्ततः।\nऐन्द्रं रप्रार्थयते स्थानं तपःसिद्धेन कर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2023635, "chapter_id": 1506, "verse_number": "३-१४४-२६", "content_sanskrit": "सोहमेनं तव प्रीत्या तपःसिद्धमपि ध्रुवम्।\nवियुनज्मि देहाद्देवेनद्र मुहूर्तं प्रतिपालय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2023636, "chapter_id": 1506, "verse_number": "३-१४४-२७x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2023637, "chapter_id": 1506, "verse_number": "३-१४४-२७", "content_sanskrit": "तस्य विष्णुर्महातेजाः पाणिना चेतनां हरत्।\nस पपात ततो भूमौ गिरिराज इवाहतः।\nतस्यैतदस्थिसंघातं मायाविनिहतस्य वै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2023638, "chapter_id": 1506, "verse_number": "३-१४४-२८", "content_sanskrit": "इदं द्वितीयमपरं विष्णो कर्म प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2023639, "chapter_id": 1506, "verse_number": "३-१४४-२९", "content_sanskrit": "नष्टा वसुमती कृत्स्ना पाताले चैव मज्जिता।\nपुनरुद्धरिता तेन वाराहेणैकशृङ्गिणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2023640, "chapter_id": 1506, "verse_number": "३-१४४-३०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2023641, "chapter_id": 1506, "verse_number": "३-१४४-३०", "content_sanskrit": "मगवन्विस्तरेणेमां कथां कथय तत्त्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2023642, "chapter_id": 1506, "verse_number": "३-१४४-३१", "content_sanskrit": "कथं तेन सुरेशेन नष्टा वसुमती तदा।\nयोजनानां शतं ब्रह्मन्पुनरुद्धरिता तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2023643, "chapter_id": 1506, "verse_number": "३-१४४-३२", "content_sanskrit": "केन चैव प्रकारेण जगतो धरणी ध्रुवा।\nशिवा देवी महाभागा सर्वसस्यप्ररोहिणी।\nकस्य चैव प्रभावाद्धि योजनानां शतं गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2023644, "chapter_id": 1506, "verse_number": "३-१४४-३३", "content_sanskrit": "श्रोतुं विस्तरशः सर्वं त्वं हि तस्य प्रतिश्रयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2023645, "chapter_id": 1506, "verse_number": "३-१४४-३४x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2023646, "chapter_id": 1506, "verse_number": "३-१४४-३४", "content_sanskrit": "यत्तेऽहं परिपृष्टोऽस्मि कथामेतां युधिष्ठिर।\nतत्सर्वमखिलेनेह श्रूयतां मम भाषतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2023647, "chapter_id": 1506, "verse_number": "३-१४४-३५", "content_sanskrit": "पुरा कृतयुगे तात वर्तमाने भयंकरे।\nयमत्वं कारयामास आदिदेवः पुरातनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2023648, "chapter_id": 1506, "verse_number": "३-१४४-३६", "content_sanskrit": "यमत्वं कुर्वतस्तस्य देवदेवस्य धीमतः।\nन तत्र म्रियते कश्चिज्जायते वा तथाऽच्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2023649, "chapter_id": 1506, "verse_number": "३-१४४-३७", "content_sanskrit": "वर्धन्ते पक्षिसङ्घाश्च तथा पशुगवेडकम्।\nगवाश्वं च मृगाश्चैव सर्वे ते पिशिताशनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2023650, "chapter_id": 1506, "verse_number": "३-१४४-३८", "content_sanskrit": "तथा पुरुषशार्दूल मानुपाश्च परंतप।\nसहस्रशो ह्ययुतशो वर्धन्ते सलिलं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2023651, "chapter_id": 1506, "verse_number": "३-१४४-३९", "content_sanskrit": "एतस्मिन्संकुले तात वर्तमाने भयंकरे।\nअतिभाराद्वसुमती योजनानां शतं गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2023652, "chapter_id": 1506, "verse_number": "३-१४४-४०", "content_sanskrit": "सा वै व्यथितसर्वाङ्गी भारेणाक्रान्तचेतना।\nनारायणं वरं देवं प्रपन्ना शरणं गता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2023653, "chapter_id": 1506, "verse_number": "३-१४४-४१x", "content_sanskrit": "पृथिव्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2023654, "chapter_id": 1506, "verse_number": "३-१४४-४१", "content_sanskrit": "भगवंस्त्वत्प्रसादाद्धि तिष्ठेयं सुचिरं त्विह।\nभारेणास्मि समाक्रान्ता न शक्नोस्मि स्म वर्तितुम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2023655, "chapter_id": 1506, "verse_number": "३-१४४-४२", "content_sanskrit": "ममेमं भगवन्भारं व्यपनेतुं त्वमर्हसि।\nशरणागताऽस्मि ते देव प्रसादं कुरु मे विभो ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2023656, "chapter_id": 1506, "verse_number": "३-१४४-४३", "content_sanskrit": "तस्यास्तद्वचनं श्रुत्वा भगवानक्षरः प्रभुः।\nप्रोवाच वचनं हृष्टः श्राव्यारसमीरितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2023657, "chapter_id": 1506, "verse_number": "३-१४४-४४", "content_sanskrit": "न ते महि भयं कार्यं भारार्ते वसुधारिणि।\nअयमेवं तथा कुर्मि यथा लध्वी भविष्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2023658, "chapter_id": 1506, "verse_number": "३-१४४-४५x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2023659, "chapter_id": 1506, "verse_number": "३-१४४-४५", "content_sanskrit": "स तां विसर्जयित्वा तु वसुधां शैलकुण्डलाम्।\nततो वराहः संवृत्त एकशृङ्गो महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2023660, "chapter_id": 1506, "verse_number": "३-१४४-४६", "content_sanskrit": "रक्ताभ्यां नयनाभ्यां तु भयमुत्पादयन्निव।\nधूमं च ज्वलयँल्लक्ष्म्या तत्र देशे व्यवर्धत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2023661, "chapter_id": 1506, "verse_number": "३-१४४-४७", "content_sanskrit": "स गृहीत्वा वसुमतीं शृङ्गेणैकेन भास्वता।\nयोजनानां शतं वीर समुद्धरति सोऽक्षरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2023662, "chapter_id": 1506, "verse_number": "३-१४४-४८", "content_sanskrit": "तस्यां चोद्धार्यमाणायां संक्षोभः समजायत।\nदेवाः संक्षुभिताः सर्वे ऋषयश्च तपोधनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2023663, "chapter_id": 1506, "verse_number": "३-१४४-४९", "content_sanskrit": "हाहाभूतमभूत्सर्वं त्रिदिवं व्योम भूस्तथा।\nन पर्यवस्थितः कश्चिद्देवो वा मानुषोपि वा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2023664, "chapter_id": 1506, "verse_number": "३-१४४-५०", "content_sanskrit": "ततो ब्रह्माणमासीनं ज्वलमानमिव श्रिया।\nदेवाः सर्षिगणाश्चैव उपतस्थुरनेकशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2023665, "chapter_id": 1506, "verse_number": "३-१४४-५१", "content_sanskrit": "उपसर्प्य च देवेशं ब्रह्माणं लोकसाक्षिकम्।\nभूत्वा प्राञ्जलयः सर्वे वाक्यमुच्चारयंस्तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2023666, "chapter_id": 1506, "verse_number": "३-१४४-५२", "content_sanskrit": "लोकाः संक्षुभिताः सर्वे व्याकुलं च चराचरम्।\nसमुद्राणां च संक्षोभस्त्रिदशेश प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2023667, "chapter_id": 1506, "verse_number": "३-१४४-५३", "content_sanskrit": "सैषा वसुमती कृत्स्ना योजनानां शतं गता।\nकिमेतत्किंप्रभावेण येनेदं रव्याकुलं जगत्।\nआख्यातु नो भवाञ्शीघ्रं विसंज्ञाः स्मेह सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2023668, "chapter_id": 1506, "verse_number": "३-१४४-५४x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2023669, "chapter_id": 1506, "verse_number": "३-१४४-५४", "content_sanskrit": "असुरेभ्यो भयं नास्ति युष्माकं कुत्रचित्क्वचित्।\nश्रूयतां यत्कृते त्वेष संक्षोभो जायतेऽमराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2023670, "chapter_id": 1506, "verse_number": "३-१४४-५५", "content_sanskrit": "योसौ सर्वत्रगः श्रीमानक्षरात्मा व्यवस्थितः।\nतस्य प्रभावात्संक्षोभस्त्रिदिवस्य प्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2023671, "chapter_id": 1506, "verse_number": "३-१४४-५६", "content_sanskrit": "यैषा वसुमती कृत्स्ना योजनानां शतं गता।\nसमुद्धृता पुनस्तेन विष्णुना परमात्मना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2023672, "chapter_id": 1506, "verse_number": "३-१४४-५७", "content_sanskrit": "तस्यामुद्धार्यमाणायां संक्षोभः समजायत।\nएवं भवन्तो जानन्तु च्छिद्यतां संशयश्च वः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2023673, "chapter_id": 1506, "verse_number": "३-१४४-५८x", "content_sanskrit": "देवा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2023674, "chapter_id": 1506, "verse_number": "३-१४४-५८", "content_sanskrit": "क्व तद्भूतं वसुमतीं समुद्धरति हृष्टवत्।\nतं देशं भगवन्ब्रूहि तत्र यास्यामहे वयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2023675, "chapter_id": 1506, "verse_number": "३-१४४-५९x", "content_sanskrit": "ब्रह्मोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2023676, "chapter_id": 1506, "verse_number": "३-१४४-५९", "content_sanskrit": "हन्त गच्छत भद्रं वो नन्दने पशय्त स्थितम्।\nएषोत्र भगवाञ्श्रीमान्मुपर्णः संप्रकाशते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2023677, "chapter_id": 1506, "verse_number": "३-१४४-६०", "content_sanskrit": "वारादेणैव रूपेण भगवाँल्लोकभावनः।\nकालानल इवाभाति पृथिवीतलमुद्धरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2023678, "chapter_id": 1506, "verse_number": "३-१४४-६१", "content_sanskrit": "एतस्योरसि सुव्यक्तं श्रीवत्समभिराजते।\nपश्यध्वं विबुधाः सर्वे भूतमेतदनामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2023679, "chapter_id": 1506, "verse_number": "३-१४४-६२x", "content_sanskrit": "लोमश उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2023680, "chapter_id": 1506, "verse_number": "३-१४४-६२", "content_sanskrit": "ततो दृष्ट्वा महात्मानं श्रुत्वा चामन्त्र्य चामराः।\nपितामहं पुरस्कृत्य जग्मुर्देवा यथागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2023681, "chapter_id": 1506, "verse_number": "३-१४४-६३x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2023682, "chapter_id": 1506, "verse_number": "३-१४४-६३", "content_sanskrit": "श्रुत्वा तु तां कथां सर्वे पाण्डवा जनमेजय।\nलोमशादेशितेनाशु यथा जग्मुः प्रहृष्टवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2023683, "chapter_id": 1506, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि तीर्थयात्रापर्वणि चतुश्चत्वारिंशदधिकशततमोऽध्यायः ॥ १४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}]