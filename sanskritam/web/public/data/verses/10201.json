[{"id": 6000201000, "chapter_id": 10201, "verse_number": null, "content_sanskrit": "अथ पञ्चमाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000201001, "chapter_id": 10201, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.001.m4a", "display_order": 2}, {"id": 6000201002, "chapter_id": 10201, "verse_number": "१०-५-१", "content_sanskrit": "बहिरन्तः पुरद्वारः सर्वाः पूर्ववदावृताः।\nततो बालध्वनिं श्रुत्वा गृहपालाः समुत्थिताः॥ १०/५/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.002.m4a", "display_order": 3, "topics": [{"text": "देवकीप्रसवं श्रुतवता कंसेन तत्कन्याहननोद्योगः", "range": "१–८"}]}, {"id": 6000201003, "chapter_id": 10201, "verse_number": "१०-५-२", "content_sanskrit": "ते तु तूर्णमुपव्रज्य देवक्या गर्भजन्म तत्।\nआचख्युर्भोजराजाय यदुद्विग्नः प्रतीक्षते॥ १०/५/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.003.m4a", "display_order": 4}, {"id": 6000201004, "chapter_id": 10201, "verse_number": "१०-५-३", "content_sanskrit": "स तल्पात् तूर्णमुत्थाय कालोऽयमिति विह्वलः।\nसूतीगृहमगाच्छीघ्रं प्रस्खलन् मुक्तमूर्धजः॥ १०/५/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.004.m4a", "display_order": 5}, {"id": 6000201005, "chapter_id": 10201, "verse_number": "१०-५-४", "content_sanskrit": "तमाह भ्रातरं देवी करुणं कृपणा सती।\nस्नुषेयं तव कल्याण स्‍त्रियं मा हन्तुमर्हसि॥ १०/५/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.005.m4a", "display_order": 6}, {"id": 6000201006, "chapter_id": 10201, "verse_number": "१०-५-५", "content_sanskrit": "बहवो हिंसिता भ्रातः शिशवः पावकोपमाः।\nत्वया दैवनिसृष्टेन पुत्रिकैका प्रदीयताम्॥ १०/५/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.006.m4a", "display_order": 7}, {"id": 6000201007, "chapter_id": 10201, "verse_number": "१०-५-६", "content_sanskrit": "नन्वहं ते ह्यवरजा दीना हतसुता प्रभो।\nदातुमर्हसि मन्दाया अङ्गेमां चरमां प्रजाम्॥ १०/५/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.007.m4a", "display_order": 8}, {"id": 6000201008, "chapter_id": 10201, "verse_number": null, "content_sanskrit": "श्रीशुक उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.008.m4a", "display_order": 9}, {"id": 6000201009, "chapter_id": 10201, "verse_number": "१०-५-७", "content_sanskrit": "उपगूह्यात्मजामेवं रुदन्त्या दीनदीनवत्।\nयाचितस्तां विनिर्भर्त्स्य हस्तादाचिच्छिदे खलः॥ १०/५/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.009.m4a", "display_order": 10}, {"id": 6000201010, "chapter_id": 10201, "verse_number": "१०-५-८", "content_sanskrit": "तां गृहीत्वा चरणयोर्जातमात्रां स्वसुः सुताम्।\nअपोथयच्छिलापृष्ठे स्वार्थोन्मूलितसौहृदः॥ १०/५/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.010.m4a", "display_order": 11}, {"id": 6000201011, "chapter_id": 10201, "verse_number": "१०-५-९", "content_sanskrit": "सा तद्धस्तात् समुत्प्लुत्य सद्यो देव्यम्बरं गता।\nअदृश्यतानुजा विष्णोः सायुधाष्टमहाभुजा॥ १०/५/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.011.m4a", "display_order": 12, "topics": [{"text": "हस्तादुत्पतिताया यशोदासुताया दुर्गाया आकाश गमनम्", "range": "९–१०"}]}, {"id": 6000201012, "chapter_id": 10201, "verse_number": "१०-५-१०", "content_sanskrit": "दिव्यस्रगम्बरालेपरत्नाभरणभूषिता।\nधनुःशूलेषुचर्मासिशङ्खचक्रगदाधरा॥ १०/५/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.012.m4a", "display_order": 13}, {"id": 6000201013, "chapter_id": 10201, "verse_number": "१०-५-११", "content_sanskrit": "सिद्धचारणगन्धर्वैरप्सरःकिन्नरोरगैः।\nउपाहृतोरुबलिभिः स्तूयमानेदमब्रवीत्॥ १०/५/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.013.m4a", "display_order": 14, "topics": [{"text": "तन्मुखात्स्वशत्रोर्यत्र क्वचनोत्पत्तिं ज्ञातवता कंसेन सर्वबालकहननाय मन्त्रिभिः सह मन्त्रणम्", "range": "११–४३"}]}, {"id": 6000201014, "chapter_id": 10201, "verse_number": "१०-५-१२", "content_sanskrit": "किं मया हतया मन्द जातः खलु तवान्तकः।\nयत्र क्‍वचित् पूर्वशत्रुर्मा हिंसीः कृपणान् वृथा॥ १०/५/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.014.m4a", "display_order": 15}, {"id": 6000201015, "chapter_id": 10201, "verse_number": "१०-५-१३", "content_sanskrit": "इति प्रभाष्य तं देवी माया भगवती भुवि।\nबहुनामनिकेतेषु बहुनामा बभूव ह॥ १०/५/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.015.m4a", "display_order": 16}, {"id": 6000201016, "chapter_id": 10201, "verse_number": "१०-५-१४", "content_sanskrit": "तयाऽभिहितमाकर्ण्य कंसः परमविस्मितः।\nदेवकीं वसुदेवं च विमुच्य प्रश्रितोऽब्रवीत्॥ १०/५/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.016.m4a", "display_order": 17}, {"id": 6000201017, "chapter_id": 10201, "verse_number": "१०-५-१५", "content_sanskrit": "अहो भगिन्यहो भाम मया वां बत पाप्मना।\nपुरुषादैरिवाभ्येत्य सुहृदोर्हिंसिताः सुताः॥ १०/५/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.017.m4a", "display_order": 18}, {"id": 6000201018, "chapter_id": 10201, "verse_number": "१०-५-१६", "content_sanskrit": "स त्वहं त्यक्तकारुण्यस्त्यक्तज्ञातिसुहृत् खलः।\nहा कान् लोकान् गमिष्यामि ब्रह्महेव मृतः श्वसन्॥ १०/५/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.018.m4a", "display_order": 19}, {"id": 6000201019, "chapter_id": 10201, "verse_number": "१०-५-१७", "content_sanskrit": "दैवमप्यनृतं वक्ति न मर्त्या एव केवलम्।\nयद्विस्रम्भादहं पापः स्वसुर्निहतवान् सुतान्॥ १०/५/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.019.m4a", "display_order": 20}, {"id": 6000201020, "chapter_id": 10201, "verse_number": "१०-५-१८", "content_sanskrit": "मा शोचेथां महाभागावात्मजान् स्वकृतम्भुजः।\nजन्तवो न सदैकत्र दैवाधीनाः सहासते॥ १०/५/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.020.m4a", "display_order": 21}, {"id": 6000201021, "chapter_id": 10201, "verse_number": "१०-५-१९", "content_sanskrit": "भुवि भौमानि भूतानि यथाऽऽयान्त्यपयान्ति च।\nनायमात्मा तथैतेषु विपर्येति यथैव भूः॥ १०/५/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.021.m4a", "display_order": 22}, {"id": 6000201022, "chapter_id": 10201, "verse_number": "१०-५-२०", "content_sanskrit": "यतोऽनेकविधोऽभेदो यत आत्मविपर्ययः।\nदेहयोगवियोगश्च संसृतिर्न निवर्तते॥ १०/५/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.022.m4a", "display_order": 23}, {"id": 6000201023, "chapter_id": 10201, "verse_number": "१०-५-२१", "content_sanskrit": "तस्माद्भद्रे स्वतनयान् मया व्यापादितानपि।\nमाऽनुशोच यतः सर्वः स्वकृतं विन्दतेऽवशः॥ १०/५/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.023.m4a", "display_order": 24}, {"id": 6000201024, "chapter_id": 10201, "verse_number": "१०-५-२२", "content_sanskrit": "यावद् हतोऽस्मि हन्ताऽस्मीत्यात्मानं मन्यतेऽस्वदृक्।\nतावत् तदभिमान्यज्ञो बाध्यबाधकतामियात्॥ १०/५/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.024.m4a", "display_order": 25}, {"id": 6000201025, "chapter_id": 10201, "verse_number": "१०-५-२३", "content_sanskrit": "क्षमध्वं मम दौरात्म्यं साधवो बन्धुवत्सलाः।\nइत्युक्त्वाऽश्रुमुखः पादौ श्यालस्वस्रोरथाग्रहीत्॥ १०/५/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.025.m4a", "display_order": 26}, {"id": 6000201026, "chapter_id": 10201, "verse_number": "१०-५-२४", "content_sanskrit": "मोक्षयामास निगडाद् विस्रब्धः कन्यकागिरा।\nदेवकीं वसुदेवं च दर्शयन्नात्मसौहृदम्॥ १०/५/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.026.m4a", "display_order": 27}, {"id": 6000201027, "chapter_id": 10201, "verse_number": "१०-५-२५", "content_sanskrit": "भ्रातुर्वचनमाश्रित्य क्षान्त्वा रोषं च देवकी।\nव्यसृजद् वसुदेवश्च प्रहस्य तमुवाच ह॥ १०/५/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.027.m4a", "display_order": 28}, {"id": 6000201028, "chapter_id": 10201, "verse_number": "१०-५-२६", "content_sanskrit": "एवमेतन्महाराज यथा वदसि देहिनाम्।\nअज्ञानप्रभवा हन्ति स्वपरेति भिदा यतः॥ १०/५/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.028.m4a", "display_order": 29}, {"id": 6000201029, "chapter_id": 10201, "verse_number": "१०-५-२७", "content_sanskrit": "शोकहर्षभयद्वेषलोभमोहमदान्विताः।\nमिथो घ्नन्तो न पश्यन्ति भावैर्भावान् पृथग्दृशः॥ १०/५/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.029.m4a", "display_order": 30}, {"id": 6000201030, "chapter_id": 10201, "verse_number": "१०-५-२८", "content_sanskrit": "कंस एवं प्रसन्नाभ्यां विस्रब्धः प्रतिभाषितः।\nदेवकीवसुदेवाभ्यामनुज्ञातोऽविशद् गृहम्॥ १०/५/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.030.m4a", "display_order": 31}, {"id": 6000201031, "chapter_id": 10201, "verse_number": "१०-५-२९", "content_sanskrit": "तस्यां रात्र्यां व्यतीतायां कंस आहूय मन्त्रिणः।\nतेभ्य आचष्ट तत् सर्वं यदुक्तं योगनिद्रया॥ १०/५/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.031.m4a", "display_order": 32}, {"id": 6000201032, "chapter_id": 10201, "verse_number": "१०-५-३०", "content_sanskrit": "आकर्ण्य भर्तुर्गदितं तमूचुर्देवशत्रवः।\nदेवान् प्रति कृतामर्षा दैतेया नातिकोविदाः॥ १०/५/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.032.m4a", "display_order": 33}, {"id": 6000201033, "chapter_id": 10201, "verse_number": "१०-५-३१", "content_sanskrit": "एवं चेत् तर्हि भोजेन्द्र पुरग्रामव्रजादिषु।\nअनिर्दशान् निर्दशांश्च हनिष्यामोऽद्य बालकान्॥ १०/५/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.033.m4a", "display_order": 34}, {"id": 6000201034, "chapter_id": 10201, "verse_number": "१०-५-३२", "content_sanskrit": "किमुद्यमैः करिष्यन्ति देवाः समरभीरवः।\nनित्यमुद्विग्नमनसो ज्याघोषैर्धनुषस्तव॥ १०/५/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.034.m4a", "display_order": 35}, {"id": 6000201035, "chapter_id": 10201, "verse_number": "१०-५-३३", "content_sanskrit": "अस्यतस्ते शरव्रातैर्हन्यमानाः समन्ततः।\nजिजीविषव उत्सृज्य पलायनपरा ययुः॥ १०/५/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.035.m4a", "display_order": 36}, {"id": 6000201036, "chapter_id": 10201, "verse_number": "१०-५-३४", "content_sanskrit": "केचित् प्राञ्जलयो भीता न्यस्तशस्‍त्रा दिवौकसः।\nमुक्तकक्ष्यशिखाः केचिद् भीताः स्म इति वादिनः॥ १०/५/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.036.m4a", "display_order": 37}, {"id": 6000201037, "chapter_id": 10201, "verse_number": "१०-५-३५", "content_sanskrit": "न त्वं विस्मृतशस्‍त्रास्‍त्रान् विरथान् भयसन्नतान्।\nहंस्यन्यासक्तमनसो भग्नचापानयुध्यतः॥ १०/५/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.037.m4a", "display_order": 38}, {"id": 6000201038, "chapter_id": 10201, "verse_number": "१०-५-३६", "content_sanskrit": "किं क्षेमशूरैर्विबुधैरसंयुगविकत्थनैः।\nरहोजुषा किं हरिणा शम्भुना वा वनौकसा॥ १०/५/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.038.m4a", "display_order": 39}, {"id": 6000201039, "chapter_id": 10201, "verse_number": "१०-५-३७", "content_sanskrit": "किमिन्द्रेणाल्पवीर्येण ब्रह्मणा वा तपस्यता। तथापि देवाः सापत्न्यान्नोपेक्ष्या इति मन्महे।\nततस्तन्मूलखनने नियुङ्क्ष्वास्माननुव्रतान्॥ १०/५/३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.039.m4a", "display_order": 40}, {"id": 6000201040, "chapter_id": 10201, "verse_number": "१०-५-३८", "content_sanskrit": "यथाऽऽमयोऽङ्गे समुपेक्षितो नृभिर्न शक्यते रूढपदश्चिकित्सितुम्।\nयथेन्द्रियग्राम उपेक्षितस्तथा रिपुर्महान् लब्धबलो न चाल्यते॥ १०/५/३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.040.m4a", "display_order": 41}, {"id": 6000201041, "chapter_id": 10201, "verse_number": "१०-५-३९", "content_sanskrit": "मूलं विष्णुर्हि देवानां यत्र धर्मः सनातनः।\nतस्य च ब्रह्मगोविप्रास्तपो यज्ञाः सदक्षिणाः॥ १०/५/३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.041.m4a", "display_order": 42}, {"id": 6000201042, "chapter_id": 10201, "verse_number": "१०-५-४०", "content_sanskrit": "तस्मात् सर्वात्मना राजन् ब्राह्मणान् ब्रह्मवादिनः।\nतपस्विनो यज्ञशीलान् गाश्च हन्मो हविर्दुघाः॥ १०/५/४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.042.m4a", "display_order": 43}, {"id": 6000201043, "chapter_id": 10201, "verse_number": "१०-५-४१", "content_sanskrit": "विप्रा गावश्च वेदाश्च तपः सत्यं दमः शमः।\nश्रद्धा दया तितिक्षा च क्रतवश्च हरेस्तनूः॥ १०/५/४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.043.m4a", "display_order": 44}, {"id": 6000201044, "chapter_id": 10201, "verse_number": "१०-५-४२", "content_sanskrit": "स हि सर्वसुराध्यक्षो ह्यसुरद्विड् गुहाचरः।\nतन्मूला देवताः सर्वाः सेश्वराः सचतुर्मुखाः॥ १०/५/४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.044.m4a", "display_order": 45}, {"id": 6000201045, "chapter_id": 10201, "verse_number": "१०-५-४३", "content_sanskrit": "अयं वै तद्वधोपायो यदृषीणां विहिंसनम्। एवं दुर्मन्त्रिभिः कंसः सह सम्मन्त्र्य दुर्मतिः।\nब्रह्महिंसां हितं मेने कालपाशावृतोऽसुरः॥ १०/५/४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.045.m4a", "display_order": 46}, {"id": 6000201046, "chapter_id": 10201, "verse_number": "१०-५-४४", "content_sanskrit": "सन्दिश्य साधुलोकस्य कदने कदनप्रियान्।\nकामरूपधरान् दिक्षु दानवान् गृहमाविशत्॥ १०/५/४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.046.m4a", "display_order": 47}, {"id": 6000201047, "chapter_id": 10201, "verse_number": "१०-५-४५", "content_sanskrit": "ते वै रजःप्रकृतयस्तमसा मूढचेतसः।\nसतां विद्वेषमाचेरुरारादागतमृत्यवः॥ १०/५/४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.047.m4a", "display_order": 48}, {"id": 6000201048, "chapter_id": 10201, "verse_number": "१०-५-४६", "content_sanskrit": "आयुः श्रियं यशो धर्मं लोकानाशिष एव च।\nहन्ति श्रेयांसि सर्वाणि पुंसो महदतिक्रमः॥ १०/५/४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_10/adhyaya_005/BhP_10.005.048.m4a", "display_order": 49}, {"id": 6000201049, "chapter_id": 10201, "verse_number": null, "content_sanskrit": "॥इति श्रीमद्भागवते वैयासिक्यां संहितायां दशमस्कन्धपूर्वार्धे पञ्चमाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]