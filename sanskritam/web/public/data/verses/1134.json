[{"id": 2006857, "chapter_id": 1134, "verse_number": "१-१३५-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2006858, "chapter_id": 1134, "verse_number": "१-१३५-१", "content_sanskrit": "पाण्डोरुपरमं दृष्ट्वा देवकल्पा महर्षयः।\nततो मन्त्रविदः सर्वे मन्त्रयांचक्रिरे मिथः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2006859, "chapter_id": 1134, "verse_number": "१-१३५-२x", "content_sanskrit": "तापसा ऊचुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2006860, "chapter_id": 1134, "verse_number": "१-१३५-२", "content_sanskrit": "हित्वा राज्यं च राष्ट्रं च स महात्मा महायशाः।\nअस्मिंस्थाने तपस्तप्त्वा तापसाञ्शरणं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2006861, "chapter_id": 1134, "verse_number": "१-१३५-३", "content_sanskrit": "स जातमात्रान्पुत्रांश्च दारांश्च भवतामिह।\nप्रादायोपनिधिं राजा पाण्डुः स्वर्गमितो गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2006862, "chapter_id": 1134, "verse_number": "१-१३५-४", "content_sanskrit": "तस्येमानात्मजान्देहं भार्यां च सुमहात्मनः।\nस्वराष्ट्रं गृह्य गच्छामो धर्म एष हि नः स्मृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2006863, "chapter_id": 1134, "verse_number": "१-१३५-५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2006864, "chapter_id": 1134, "verse_number": "१-१३५-५", "content_sanskrit": "ते परस्परमामन्त्र्य देवकल्पा महर्षयः।\nपाण्डोः पुत्रान्पुरस्कृत्य नगरं नागसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2006865, "chapter_id": 1134, "verse_number": "१-१३५-६", "content_sanskrit": "उदारमनसः सिद्धा गमने चक्रिरे मनः।\nभीष्माय पण्डवान्दातुं धृतराष्ट्राय चैव हि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2006866, "chapter_id": 1134, "verse_number": "१-१३५-७", "content_sanskrit": "तस्मिन्नेव क्षणे सर्वे तानादाय प्रतस्थिरे।\nपाण्डोर्दारांश्च पुत्रांश्च शरीरे ते च तापसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2006867, "chapter_id": 1134, "verse_number": "१-१३५-८", "content_sanskrit": "सुखिनी सा पुरा भूत्वा सततं पुत्रवत्सला।\nप्रपन्ना दीर्घमध्वानं संक्षिप्तं तदमन्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2006868, "chapter_id": 1134, "verse_number": "१-१३५-९", "content_sanskrit": "सा त्वदीर्घेण कालेन संप्राप्ता कुरुजाङ्गलम्।\nवर्धमानपुरद्वारमाससाद यशस्विनी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2006869, "chapter_id": 1134, "verse_number": "१-१३५-१०", "content_sanskrit": "द्वारिणं तापसा ऊचू राजानं च प्रकाशय।\nते तु गत्वा क्षणेनैव सभायां विनिवेदिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2006870, "chapter_id": 1134, "verse_number": "१-१३५-११", "content_sanskrit": "तं चारणसहस्राणां मुनीनामागमं तदा।\nश्रुत्वा नागपुरे नॄणां विस्मयः समपद्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2006871, "chapter_id": 1134, "verse_number": "१-१३५-१२", "content_sanskrit": "मुहूर्तोदित आदित्ये सर्वे बालपुरस्कृताः।\nसदारास्तापसान्द्रष्टुं निर्ययुः पुरवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2006872, "chapter_id": 1134, "verse_number": "१-१३५-१३", "content_sanskrit": "स्त्रीसङ्घाः क्षत्रसङ्घाश्च यानसङ्घसमास्थिताः।\nब्राह्मणैः सह निर्जग्मुर्ब्राह्मणानां च योषितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2006873, "chapter_id": 1134, "verse_number": "१-१३५-१४", "content_sanskrit": "तथा विट्शूद्रसङ्घानां महान्यतिकरोऽभवत्।\nन कश्चिदकरोदीर्ष्यामभवन्धर्मबुद्धयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2006874, "chapter_id": 1134, "verse_number": "१-१३५-१५", "content_sanskrit": "तथा भीष्मः शान्तनवः सोमदत्तो।ञथ बाह्लिकः।\nप्रज्ञाचक्षुश्च राजर्षिः क्षत्ता च विदुरः स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2006875, "chapter_id": 1134, "verse_number": "१-१३५-१६", "content_sanskrit": "सा च सत्यवती देवी कौसल्या च यशस्विनी।\nराजदारैः परिवृता गान्धारी चापि निर्ययौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2006876, "chapter_id": 1134, "verse_number": "१-१३५-१७", "content_sanskrit": "धृतराष्ट्रस्य दायादा दुर्योधनपुरोगमाः।\nभूषिता भूषणैश्चित्रैः शतसङ्ख्या विनिर्ययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2006877, "chapter_id": 1134, "verse_number": "१-१३५-१८", "content_sanskrit": "तान्महर्षिगणान्दृष्ट्वा शिरोभिरभिवाद्य च।\nउपोपविविशुः सर्वे कौरव्याः सपुरोहिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2006878, "chapter_id": 1134, "verse_number": "१-१३५-१९", "content_sanskrit": "तथैव शिरसा भूमावभिवाद्य प्रणम्य च।\nउपोपविविशुः सर्वे पौरजानपदा अपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2006879, "chapter_id": 1134, "verse_number": "१-१३५-२०", "content_sanskrit": "तमकूजमभिज्ञाय जनौघं सर्वशस्तदा।\nपूजयित्वा यथान्यायं पाद्येनार्घ्येण च प्रभो॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2006880, "chapter_id": 1134, "verse_number": "१-१३५-२१", "content_sanskrit": "भीष्मो राज्यं च राष्ट्रं च महर्षिभ्यो न्यवेदयत्।\nतेषामथो वृद्धतमः प्रत्युत्थाय जटाजिनी।\nऋषीणां मतमाज्ञाय महर्षिरिदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2006881, "chapter_id": 1134, "verse_number": "१-१३५-२२", "content_sanskrit": "यः स कौरव्यदायादः पाण्डुर्नाम नराधिपः।\nकामभोगान्परित्यज्य शतशृङ्गमितो गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2006882, "chapter_id": 1134, "verse_number": "१-१३५-२३", "content_sanskrit": "राजा भोगान्परित्यज्य तपस्वी संबभूव ह।\nस यथोक्तं तपस्तेपे पत्रमूलफलाशनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2006883, "chapter_id": 1134, "verse_number": "१-१३५-२४", "content_sanskrit": "पत्नीभ्यां सह धर्मात्मा संचित्कालमतन्द्रितः।\nतेन वृत्तसमाचारैस्तपसा च तपस्विनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2006884, "chapter_id": 1134, "verse_number": "१-१३५-२५", "content_sanskrit": "तोषितास्तापसास्तत्र शतशृङ्गनिवासिनः।\nस्वर्गलोकं गन्तुकामं तापसाः संनिवार्य तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2006885, "chapter_id": 1134, "verse_number": "१-१३५-२६", "content_sanskrit": "उद्यन्तं सह पत्नीभ्यां विप्रा वचनमब्रुवन्।\nअनपत्यस्य राजेन्द्र पुण्या लोका न सन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2006886, "chapter_id": 1134, "verse_number": "१-१३५-२७", "content_sanskrit": "तस्माद्धर्मं च वायुं च महेन्द्रं च तथाऽश्विनौ।\nआराधयस्व राजेन्द्र पत्नीभ्यां सह देवताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2006887, "chapter_id": 1134, "verse_number": "१-१३५-२८", "content_sanskrit": "प्रीताः पुत्रान्प्रदास्यन्ति ऋणमुक्तो भविष्यसि।\nतपसा दिव्यचक्षुष्ट्वात्पश्यामस्ते तथा सुतान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2006888, "chapter_id": 1134, "verse_number": "१-१३५-२९", "content_sanskrit": "अस्माकं वचनं श्रुत्वा देवानाराधयत्तदा।\nब्रह्मचर्यव्रतस्थस्य तस्य दिव्येन हेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2006889, "chapter_id": 1134, "verse_number": "१-१३५-३०", "content_sanskrit": "साक्षाद्धर्मादयं पुत्रस्तत्र जातो युधिष्ठिरः।\nतथैनं बलिनां श्रेष्ठं तस्य राज्ञो महात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2006890, "chapter_id": 1134, "verse_number": "१-१३५-३१", "content_sanskrit": "मातरिश्वा ददौ पुत्रं भीमं नाम महाबलम्।\nपुरन्दरादयं जज्ञे कुन्त्यां सत्यपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2006891, "chapter_id": 1134, "verse_number": "१-१३५-३२", "content_sanskrit": "अस्मिञ्जाते महेष्वासे पृथामिन्द्रस्तदाऽब्रवीत्।\nमत्प्रसादादयं जातः कुन्ति सत्यपराक्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2006892, "chapter_id": 1134, "verse_number": "१-१३५-३३", "content_sanskrit": "अजेयानपि जेताऽरीन्देवतादीन्न संशयः।\nयस्य कीर्तिर्महेष्वासान्सर्वानभिभविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2006893, "chapter_id": 1134, "verse_number": "१-१३५-३४", "content_sanskrit": "युधिष्ठिरो राजसूयं भ्रातृवीर्यादवाप्स्यति।\nएष जेता मनुष्यांश्च सर्वान्गन्धर्वराक्षसान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2006894, "chapter_id": 1134, "verse_number": "१-१३५-३५", "content_sanskrit": "एष दुर्योधनादीनां कौरवाणां च जेष्यति।\nवीरस्यैतस्य विक्रान्तैर्धर्मपुत्रो युधिष्ठिरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2006895, "chapter_id": 1134, "verse_number": "१-१३५-३६", "content_sanskrit": "यक्ष्यते राजसूयाद्यैर्धर्म एव परः सदा।\nयौ तु माद्री महेष्वासावसूत पुरुषोत्तमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2006896, "chapter_id": 1134, "verse_number": "१-१३५-३७", "content_sanskrit": "अश्विभ्यां पुरुषव्याघ्राविमौ तावपि तिष्ठतः।\nनकुलः सहदेवश्च तावप्यमिततेजसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2006897, "chapter_id": 1134, "verse_number": "१-१३५-३८", "content_sanskrit": "चरता धर्मनित्येन वनवासं यशस्विना।\nएष पैतामहो वंशः पाण्डुना पुनरुद्धृतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2006898, "chapter_id": 1134, "verse_number": "१-१३५-३९", "content_sanskrit": "पुत्राणां जन्म वृद्धिं च वैदिकाध्ययनानि च।\nपश्यन्तः सततं पाण्डोः परां प्रीतिमवाप्स्यथ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2006899, "chapter_id": 1134, "verse_number": "१-१३५-४०", "content_sanskrit": "वर्तमानः सतां वृत्ते पुत्रलाभमवाप च।\nपितृलोकं गतः पाण्डुरितः सप्तदशेऽहनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2006900, "chapter_id": 1134, "verse_number": "१-१३५-४१", "content_sanskrit": "तं चितागतमाज्ञाय वैश्वानरमुखे हुतम्।\nप्रविष्टा पावकं माद्री हित्वा जीवितमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2006901, "chapter_id": 1134, "verse_number": "१-१३५-४२", "content_sanskrit": "सा गता सह तेनैव पतिलोकमनुव्रता।\nतस्यास्तस्य च यत्कार्यं क्रियतां तदनन्तरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2006902, "chapter_id": 1134, "verse_number": "१-१३५-४३", "content_sanskrit": "पृथां च शरणं प्राप्तां पाण्डवांश्च यशस्विनः।\nयथावदनुमन्यन्तां धर्मो ह्येष सनातनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2006903, "chapter_id": 1134, "verse_number": "१-१३५-४४", "content_sanskrit": "इमे तयोः शरीरे द्वे पुत्राश्चेमे तयोर्वराः।\nक्रियाभिरनुगृह्यन्तां सह मात्रा परंतपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2006904, "chapter_id": 1134, "verse_number": "१-१३५-४५", "content_sanskrit": "प्रेतकार्ये निवृत्ते तु पितृमेधं महायशाः।\nलभतां सर्वधर्मज्ञः पाण्डुः कुरुकुलोद्वहः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2006905, "chapter_id": 1134, "verse_number": "१-१३५-४६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2006906, "chapter_id": 1134, "verse_number": "१-१३५-४६", "content_sanskrit": "एवमुक्त्वा कुरून्सर्वान्कुरूणामेव पश्यताम्।\nक्षणेनान्तर्हिताः सर्वे तापसा गुह्यकैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2006907, "chapter_id": 1134, "verse_number": "१-१३५-४७", "content_sanskrit": "गन्धर्वनगराकारं तथैवान्तर्हितं पुनः।\nऋषिसिद्धगणं दृष्ट्वा विस्मयं ते परं ययुः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2006908, "chapter_id": 1134, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि संभवपर्वणि पञ्चत्रिंशदधिकशततमोऽध्यायः॥ १३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}]