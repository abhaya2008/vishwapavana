[{"id": 2149561, "chapter_id": 4237, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2149562, "chapter_id": 4237, "verse_number": "१", "content_sanskrit": "द्रौपदेया महाराज सर्वे पञ्च महारथाः ।\nवैराटिरुत्तरश्चैव रथो मम महान् मतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2149563, "chapter_id": 4237, "verse_number": "२", "content_sanskrit": "अभिमन्युर्महाबाहू रथयूथपयूथपः ।\nसमः पार्थेन समरे वासुदेवेन वा भवेत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2149564, "chapter_id": 4237, "verse_number": "३", "content_sanskrit": "लघ्वस्त्रश्चित्रयोधी च मनस्वी दृढविक्रमः ।\nसंस्मरन् वै परिक्लेशं स्वपितुर्विक्रमिष्यति\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2149565, "chapter_id": 4237, "verse_number": "४", "content_sanskrit": "सात्यकिर्माधवः शूरो रथयूथपयूथपः ।\nएष वृष्णिप्रवीराणाममर्षी जितसाध्वसः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2149566, "chapter_id": 4237, "verse_number": "५", "content_sanskrit": "उत्तमौजास्तथा राजन् रथो मम महान् मतः ।\nयुधामन्युश्च विक्रान्तो रथोदारो नरर्षभः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2149567, "chapter_id": 4237, "verse_number": "६", "content_sanskrit": "एतेषां बहुसाहस्रा रथा नागा हयास्तथा ।\nयोत्स्यन्ते ते तनुं त्यक्त्वा कुन्तीपुत्रप्रियेप्सया\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2149568, "chapter_id": 4237, "verse_number": "७", "content_sanskrit": "पाण्डवैः सह राजेन्द्र तव सेनासु भारत ।\nअग्निमारुतवद् राजन्नाह्वयन्तः परस्परम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2149569, "chapter_id": 4237, "verse_number": "८", "content_sanskrit": "अजेयौ समरे वृद्धौ विराटद्रुपदावुभौ ।\nमहारथौ महावीर्यौ मतौ मे पुरुषर्षभौ\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2149570, "chapter_id": 4237, "verse_number": "९", "content_sanskrit": "वयोवृद्धावपि हि तौ क्षत्रधर्मपरायणौ ।\nयतिष्येते परं शक्त्या स्थितौ वीरगते पथि\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2149571, "chapter_id": 4237, "verse_number": "१०", "content_sanskrit": "सम्बन्धकेन राजेन्द्र तौ तु वीर्यबलान्वयात् ।\nआर्यवृत्तौ महेष्वासौ स्नेहपाशयुतावुभौ\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2149572, "chapter_id": 4237, "verse_number": "११", "content_sanskrit": "कारणं प्राप्य तु नराः सर्व एव महाभुजाः ।\nशूरा वा कातरा वाऽपि भवन्ति नरपुङ्गवाः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2149573, "chapter_id": 4237, "verse_number": "१२", "content_sanskrit": "एकायनगतावेतौ पार्थिवौ दृढधन्विनौ ।\nप्राणांस्त्यक्त्वा परं शक्त्या घट्टितारौ नराधिप\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2149574, "chapter_id": 4237, "verse_number": "१३", "content_sanskrit": "पृथगक्षोहिणीभ्यां तावुभौ संयति दारुणौ ।\nसम्बन्धिभावं रक्षन्तौ महत् कर्म करिष्यतः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2149575, "chapter_id": 4237, "verse_number": "१४", "content_sanskrit": "लोकवीरौ महेष्वासौ त्यक्तात्मानौ च भारत ।\nप्रत्ययं परिरक्षन्तौ महत् कर्म करिष्यतः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2149576, "chapter_id": 4237, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् उद्योगपर्वणि अष्टषष्ट्युत्तरशततमोऽध्यायः ॥१६८॥\nरथातिरथसङ्ख्यानपर्वणि षष्ठोऽध्यायः ॥६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}]