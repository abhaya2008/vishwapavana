[{"id": 2129313, "chapter_id": 3782, "verse_number": "", "content_sanskrit": "सोमकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2129314, "chapter_id": 3782, "verse_number": "१", "content_sanskrit": "ब्रह्मन् यद्यद्यथा कार्यं तत्तत् कुरु तथातथा ।\nपुत्रकामतया सर्वं करिष्यामि वचस्तव \t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2129315, "chapter_id": 3782, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2129316, "chapter_id": 3782, "verse_number": "२", "content_sanskrit": "ततः स याजयामास सोमकं तेन जन्तुना ।\nमातरः स्म बलात् पुत्रमपाकार्षुः कृपान्विताः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2129317, "chapter_id": 3782, "verse_number": "३", "content_sanskrit": "हा हताः स्मेति वाशन्त्यः तीव्रशोकसमन्विताः ।\nतं मातरः पर्यकर्षन् गृहीत्वा दक्षिणे करे ।\nसव्ये पाणौ गृहीत्वा तु याजकोऽपि स्म कर्षति \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2129318, "chapter_id": 3782, "verse_number": "४", "content_sanskrit": "कुररीणामिवार्तानामपाकृष्य तु तं सुतम् ।\nविशस्य चैनं विधिना वपामस्य जुहाव सः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2129319, "chapter_id": 3782, "verse_number": "५", "content_sanskrit": "जन्तोर्वपायां हूयन्त्यां धूममाघ्राय मातरः ।\nआर्ता निपेतुः सहसा पृथिव्यां कुरुनन्दन ।\nसर्वाश्च गर्भानलभन् ततस्ताः पार्थिवाङ्गनाः \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2129320, "chapter_id": 3782, "verse_number": "६", "content_sanskrit": "ततो दशसु मासेषु सोमकस्य विशांपते ।\nजज्ञे पुत्रशतं पूर्णं तासु सर्वासु भारत\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2129321, "chapter_id": 3782, "verse_number": "७", "content_sanskrit": "जन्तुर्ज्येष्ठः समभवत् जनित्र्यामेव भारत ।\nस तासामिष्ट एवासीन्न तथाऽन्ये निजाः सुताः\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2129322, "chapter_id": 3782, "verse_number": "८", "content_sanskrit": "तच्च लक्षणमप्यासीत् सौवर्णं पार्श्व उत्तरे ।\nतस्मिन् पुत्रशते चाग्र्यः स बभूव गुणैर्युतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2129323, "chapter_id": 3782, "verse_number": "९", "content_sanskrit": "ततः स कालमगमत् सोमकस्य गुरुर्नृप ।\nअथ काले व्यतीते तु सोमकोऽप्यगमत् परम्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2129324, "chapter_id": 3782, "verse_number": "१०", "content_sanskrit": "नरके पच्यमानं तु ददर्श स तु सोमकः\nतमपृच्छत् कथं नु त्वं नरके पच्यसे द्विज\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2129325, "chapter_id": 3782, "verse_number": "११", "content_sanskrit": "तमब्रवीद् गुरुः सोऽथ पच्यमानोऽग्निना भृशम् ।\nत्वं मया याजितो राजन् तस्येदं कर्मणः फलम् \t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2129326, "chapter_id": 3782, "verse_number": "१२", "content_sanskrit": "एतच्छ्रुत्वा तु राजर्षिर्धर्मराजमथाब्रवीत् ।\nअहं तत्र प्रवेक्ष्यामि मुच्यतां मम याजकः \t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2129327, "chapter_id": 3782, "verse_number": "१३", "content_sanskrit": "मत्कृते हि महाभागः पच्यते नरकाग्निना ।\tसोऽहमात्मानमाधास्ये नरकान्मुच्यतां गुरुः \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2129328, "chapter_id": 3782, "verse_number": "", "content_sanskrit": "धर्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2129329, "chapter_id": 3782, "verse_number": "१४", "content_sanskrit": "नान्यः कर्तुः फलं राजन्नुपभुङ्क्ते कदाचन ।\nइमानि तव दृश्यन्ते फलानि वदतां वर\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2129330, "chapter_id": 3782, "verse_number": "", "content_sanskrit": "सोमकः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2129331, "chapter_id": 3782, "verse_number": "१५", "content_sanskrit": "पुण्यान्न कामये लोकान् ऋतेऽहं ब्रह्मवादिनम् ।\nइच्छाम्यहमनेनैव सह वस्तुं सुरालये\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2129332, "chapter_id": 3782, "verse_number": "१६", "content_sanskrit": "नरके वा धर्मराज कर्मणाऽस्य समो ह्यहम् ।\nपुण्यापुण्यफलं देव सममस्त्वावयोरिदम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2129333, "chapter_id": 3782, "verse_number": "", "content_sanskrit": "धर्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2129334, "chapter_id": 3782, "verse_number": "१७", "content_sanskrit": "यद्येवमीप्सितो राजन् भुङ्क्ष्वाद्य सहितः फलम् ।\nतुल्यकालं सहानेन पश्चात् प्राप्स्यसि सद्गतिम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2129335, "chapter_id": 3782, "verse_number": "", "content_sanskrit": "लोमशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2129336, "chapter_id": 3782, "verse_number": "१८", "content_sanskrit": "स चकार तथा सर्वं राजा राजीवलोचन \t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2129337, "chapter_id": 3782, "verse_number": "१९", "content_sanskrit": "पुनश्च लेभे लोकान् स्वान् कर्मणा निर्जितान् शुभान् ।\nसह तेनैव विप्रेण गुरुणा स गुरुप्रियः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2129338, "chapter_id": 3782, "verse_number": "२०", "content_sanskrit": "एष तस्याश्रमः पुण्यो य एषोऽत्र प्रकाशते ।\nक्षान्त्या उष्यात्र षड्रात्रं प्राप्नोति सुगतिं नरः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2129339, "chapter_id": 3782, "verse_number": "२१", "content_sanskrit": "एतस्मिन्नेव राजेन्द्र वत्स्यामो विगतज्वराः ।\nषड्रात्रं नियताहाराः सज्जीभव कुरूत्तम\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2129340, "chapter_id": 3782, "verse_number": "", "content_sanskrit": "॥ इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां वनपर्वणि चतुर्विंशोत्तरशततमोऽध्यायः ॥१२४॥\n॥ तीर्थयात्रापर्वणि अशीतितमोऽध्यायः ॥८०॥\n—०—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]