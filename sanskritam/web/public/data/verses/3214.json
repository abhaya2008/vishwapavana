[{"id": 2102375, "chapter_id": 3214, "verse_number": "१४-७०-१", "content_sanskrit": "वैशम्पायन उवाच।\nब्रह्मास्त्रं तु यदा राजन्कृष्णेन प्रतिसंहृतम्।\nतदा तद्वेश्म ते पित्रा तेजसाऽभिविदीपितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102376, "chapter_id": 3214, "verse_number": "१४-७०-२", "content_sanskrit": "ततो रक्षांसि सर्वाणि नेशुस्त्यक्त्वा गृहं तु तत्।\nअन्तरिक्षे च वागासीत्साधु केशव साध्विति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102377, "chapter_id": 3214, "verse_number": "१४-७०-३", "content_sanskrit": "तदस्त्रं ज्वलितं चापि पितामहमगात्तदा।\nततः प्राणान्पुनर्लेभे पिता तव नरेश्वर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102378, "chapter_id": 3214, "verse_number": "१४-७०-४", "content_sanskrit": "व्यचेष्टत च बालोसौ यथोत्साहं यताबलम्।\nबभूवुर्मुदिता राजंस्ततस्ता भरतस्त्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102379, "chapter_id": 3214, "verse_number": "१४-७०-५", "content_sanskrit": "ब्राह्मणा वाचयामासुर्गोविन्दस्यैव शासनात्।\nततस्ता मुदिताः सर्वाः प्रशशंसुर्जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102380, "chapter_id": 3214, "verse_number": "१४-७०-६", "content_sanskrit": "स्त्रियो भरतसिंहानां नावं लब्ध्वेव पारगाः।\nकुन्ती द्रुपदपुत्री च सुभद्रा चोत्तरा तथा।\nस्त्रियश्चान्या नृसिंहानां बभूवुर्हृष्टमानसाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102381, "chapter_id": 3214, "verse_number": "१४-७०-७", "content_sanskrit": "तत्र मल्ला नटाश्चैव ग्रन्थिकाः सौख्यशायिकाः।\nसूतमागधसङ्घाश्चाप्यस्तुवंस्तं जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102382, "chapter_id": 3214, "verse_number": "१४-७०-८", "content_sanskrit": "कुरुवंशस्तवाख्याभिराशीर्भिर्भरतर्षभ।\n`सभाजयत संहृष्टो महाराज महाजनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102383, "chapter_id": 3214, "verse_number": "१४-७०-९", "content_sanskrit": "उत्थाय तु यथाकालमुत्तरा यदुनन्दनम्।\nअभ्यवादयत प्रीता सह पुत्रेण भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102384, "chapter_id": 3214, "verse_number": "१४-७०-१०", "content_sanskrit": "ततस्तस्यै ददौ प्रीतो बहुरत्नं विशेषतः।\nतथैव वृष्णिशार्दूलो नाम चास्याकरोत्प्रभुः।\nपितुस्तव महाराज सत्यसन्धो जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102385, "chapter_id": 3214, "verse_number": "१४-७०-११", "content_sanskrit": "परिक्षीणे कुले यस्माज्जातोऽयमभिमन्युजः।\nपरिक्षिदिति नामास्य भवत्वित्यब्रवीत्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102386, "chapter_id": 3214, "verse_number": "१४-७०-१२", "content_sanskrit": "सोऽवर्धत यथाकालं पिता तव जनाधिप।\nमनःप्रह्लादनश्चासीत्सर्वलोकस्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102387, "chapter_id": 3214, "verse_number": "१४-७०-१३", "content_sanskrit": "मासजातस्तु ते वीर पिता भवति भारत।\nअथाजग्मुः सुबहुलं रत्नमादाय पाण्डवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102388, "chapter_id": 3214, "verse_number": "१४-७०-१४", "content_sanskrit": "`मेरुकूटनिभान्भाण्डान्कलशान्भाजनानि च।\nकृताकृतं महद्भीममादाय पुरुषोत्तमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102389, "chapter_id": 3214, "verse_number": "१४-७०-१५", "content_sanskrit": "भारतैर्वाहनैस्तत्र गोरुते गोरुते पथि।\nनिवसन्तो ययुर्देवं स्मरन्तः परमेष्ठिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102390, "chapter_id": 3214, "verse_number": "१४-७०-१६", "content_sanskrit": "नासीत्तत्र नृपः कश्चिदभारार्तो नृपं विना।\nभीमादयोऽपि यज्ञार्थं वहन्ते किं पुनर्जनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102391, "chapter_id": 3214, "verse_number": "१४-७०-१७", "content_sanskrit": "तान्समीपगताञ्श्रुत्वा निर्ययुर्वृष्णिपुङ्गवाः।\nअलञ्चक्रुश्च माल्यौघैर्नगरं नागसाह्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102392, "chapter_id": 3214, "verse_number": "१४-७०-१८", "content_sanskrit": "पताकाभिर्विचित्राभिर्ध्वजैश्च विविधैरपि।\nवेश्मानि समलञ्चक्रुः पौराश्चापि जनेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102393, "chapter_id": 3214, "verse_number": "१४-७०-१९", "content_sanskrit": "देवतायतनानां च पूजाः सुविविधास्तथा।\nसंदिदेशाथ विदुरः पाण्डुपुत्रप्रियेप्सया॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102394, "chapter_id": 3214, "verse_number": "१४-७०-२०", "content_sanskrit": "राजमार्गाश्च तत्रासन्सुमनोभिरलङ्कृताः।\nशुशुभे तत्पुरं चापि समुद्रौघनिभस्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102395, "chapter_id": 3214, "verse_number": "१४-७०-२१", "content_sanskrit": "नर्तकैश्चापि नृत्यद्भिर्गायकानां च निःस्वनैः।\nआसीद्वैश्रवणस्येव निवासस्तत्पुरं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102396, "chapter_id": 3214, "verse_number": "१४-७०-२२", "content_sanskrit": "बन्दिभिश्च नरै राजन्स्त्रीसहायैश्च सर्वशः।\nतत्रतत्र विविक्तेषु समन्तादुपशोभितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102397, "chapter_id": 3214, "verse_number": "१४-७०-२३", "content_sanskrit": "पताका धूयमानाश्च समन्तान्मातरिश्वना।\nअदर्शयन्निव तदा कुरून्वै दक्षिणोत्तरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102398, "chapter_id": 3214, "verse_number": "१४-७०-२४", "content_sanskrit": "अघोषयंस्तदा चाप पुरुषा राजमार्गतः।\nसर्वरात्रविहारोऽद्य रत्नाभरणलक्षणः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102399, "chapter_id": 3214, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि सप्ततितमोऽध्यायः॥ ७० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]