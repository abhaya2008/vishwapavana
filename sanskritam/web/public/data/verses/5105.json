[{"id": 2193110, "chapter_id": 5105, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2193111, "chapter_id": 5105, "verse_number": "१", "content_sanskrit": "यद्यस्ति दत्तमिष्टं वा तपस्तप्तं तथैव च ।\nगुरूणां वापि शुश्रूषा तन्मे ब्रूहि पितामह\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2193112, "chapter_id": 5105, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2193113, "chapter_id": 5105, "verse_number": "२", "content_sanskrit": "आत्मनाऽनर्थयुक्तेन पापे निविशते मनः ।\nस कर्म कलुषं कृत्वा क्लेशे महति धीयते \t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2193114, "chapter_id": 5105, "verse_number": "३", "content_sanskrit": "दुर्भिक्षादेव दुर्भिक्षं क्लेशात् क्लेशं भयाद् भयम् ।\nमृतेभ्यः प्रमृता यान्ति दरिद्राः पापकर्मिणः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2193115, "chapter_id": 5105, "verse_number": "४", "content_sanskrit": "उत्सवादुत्सवं यान्ति स्वर्गात् स्वर्गं सुखात् सुखम् ।\nश्रद्दधानाश्च दान्ताश्च धनस्थाः शुभकारिणः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2193116, "chapter_id": 5105, "verse_number": "५", "content_sanskrit": "व्यालकुञ्जरदुर्गषु सर्पचोरभयेषु च ।\nहस्तावापेन गच्छन्ति नास्तिकाः किमतःपरम् \t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2193117, "chapter_id": 5105, "verse_number": "६", "content_sanskrit": "प्रियदेवातिथेयाश्च वदान्याः प्रियसाधवः ।\nक्षेम्यमात्मवता मार्गमास्थिता हस्तदक्षिणाः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2193118, "chapter_id": 5105, "verse_number": "७", "content_sanskrit": "पुलाका इव धान्येषु प्रत्यण्डा इव पक्षिषु ।\nतद्विधास्ते मनुष्येषु येषां धर्मो न कारणम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2193119, "chapter_id": 5105, "verse_number": "८", "content_sanskrit": "सुशीघ्रमपि धावन्तं विधानमनुधावति ।\nशेते सह शयानेन येन येन यथाकृतम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2193120, "chapter_id": 5105, "verse_number": "९", "content_sanskrit": "पापं तिष्ठति तिष्ठन्तं धावन्तमनुधावति ।\nकरोति कुर्वतः कर्म च्छायेवानुविधीयते\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2193121, "chapter_id": 5105, "verse_number": "१०", "content_sanskrit": "येनयेन यथा यद्यत् पुरा कर्म सुनिश्चितम् ।\nतत्तदेव नरो भुङ्क्ते नित्यं विहितमात्मना\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2193122, "chapter_id": 5105, "verse_number": "११", "content_sanskrit": "समानकर्मनिक्षेपं विधानपरिरक्षणम् ।\nभूतग्राममिमं कालः समन्तादपकर्षति\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2193123, "chapter_id": 5105, "verse_number": "१२", "content_sanskrit": "अचोद्यमानानि यथा पुष्पाणि च फलानि च ।\nस्वं कालं नातिवर्तन्ते तथा कर्म पुराकृतम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2193124, "chapter_id": 5105, "verse_number": "१३", "content_sanskrit": "समानश्चावमानश्च लाभालाभौ जयाजयौ ।\nप्रवृत्ता न निवर्तन्ते निधनान्ताः पदेपदे \t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2193125, "chapter_id": 5105, "verse_number": "१४", "content_sanskrit": "आत्मना विहितं दुःखमात्मना विहितं सुखम् ।\nगर्भशय्यामुपादाय भजते पूर्वदेहिकम्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2193126, "chapter_id": 5105, "verse_number": "१५", "content_sanskrit": "बालो युवा वा वृद्धश्च यत्करोति शुभाशुभम् ।\nतस्यांतस्यामवस्थायां भुङ्क्ते जन्मनिजन्मनि\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2193127, "chapter_id": 5105, "verse_number": "१६", "content_sanskrit": "यथा धेनुसहस्रेषु वत्सो विन्दति मातरम् ।\nतथा पूर्वकृतं कर्म कर्तारमनुगच्छति\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2193128, "chapter_id": 5105, "verse_number": "१७", "content_sanskrit": "मलिनं हि यथा वस्त्रं पश्चाच्छुध्यति वारिणा ।\nउपवासैः प्रतप्तानां दीर्घं सुखमनन्तकम्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2193129, "chapter_id": 5105, "verse_number": "१८", "content_sanskrit": "दीर्घकालेन तपसा सेवितेन तपोवने ।\nधर्मनिर्धूतपापानां संसिद्ध्यन्ते मनोरथाः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2193130, "chapter_id": 5105, "verse_number": "१९", "content_sanskrit": "शकुनानामिवाकाशे मत्स्यानामिव चोदके ।\nपदं यथा न दृश्येत तथा पुण्यकृतां गतिः \t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2193131, "chapter_id": 5105, "verse_number": "२०", "content_sanskrit": "अल्पमन्यैरुपालब्धैः कीर्तितैश्च व्यतिक्रमैः ।\nपेशलं चानुरूपं च कर्तव्यं हितमात्मनः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2193132, "chapter_id": 5105, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि मोक्षधर्मे चतुःपञ्चाशोत्तरशततमोध्यायः ॥१५४॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]