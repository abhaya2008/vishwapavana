[{"id": 2052985, "chapter_id": 2170, "verse_number": "७-९७-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2052986, "chapter_id": 2170, "verse_number": "७-९७-१", "content_sanskrit": "तथा तस्मिन्प्रवृत्ते तु सङ्ग्रमे रोमहर्षणे।\nकौरवेयांस्त्रिधाभूतान्पाण्डवाः समुपाद्रवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2052987, "chapter_id": 2170, "verse_number": "७-९७-२", "content_sanskrit": "जलसन्धं महाबाहुं भीमसेनोऽभ्यवर्तत।\nयुधिष्ठिरः सहानीकः कृतवर्माणमाहवे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2052988, "chapter_id": 2170, "verse_number": "७-९७-३", "content_sanskrit": "किरंस्तु शरवर्षाणि रोचमान इवांशुमान्।\nधृष्टद्युम्नो महाराज द्रोणमभ्यद्रवद्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2052989, "chapter_id": 2170, "verse_number": "७-९७-४", "content_sanskrit": "ततः प्रववृते युद्धं त्वरतां सर्वधन्विनाम्।\nकुरूणां पाण्डवानां च सङ्क्रुद्धानां परस्परम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2052990, "chapter_id": 2170, "verse_number": "७-९७-५", "content_sanskrit": "सङ्क्षये तु तथाभूते वर्तमाने महाभये।\nद्वन्दवीभूतेषु सैन्येषु युध्यमानेष्वभीतवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2052991, "chapter_id": 2170, "verse_number": "७-९७-६", "content_sanskrit": "द्रोणः पाञ्चालपुत्रेण बली बलवता सह।\nयदक्षिपत्पृषत्कौघांस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2052992, "chapter_id": 2170, "verse_number": "७-९७-७", "content_sanskrit": "पुण्डरीकवनानीव विध्वस्तानि समन्ततः।\nचक्राते द्रोणपाञ्चाल्यौ नृणां शीर्षाण्यनेकशः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2052993, "chapter_id": 2170, "verse_number": "७-९७-८", "content_sanskrit": "विनिकीर्णानि वीराणामनीकेषु समन्ततः।\nवस्त्राभरणशस्त्राणि ध्वजवर्मायुधानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2052994, "chapter_id": 2170, "verse_number": "७-९७-९", "content_sanskrit": "तपनीयतनुत्राणाः संसिक्ता रुधिरेण च।\nकोविदारा इवाभान्ति पुष्पितास्तत्र भारत।\nतावकाः समरे योधाः पाण्डवेयाश्च विक्षताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2052995, "chapter_id": 2170, "verse_number": "७-९७-१०", "content_sanskrit": "कुञ्जराश्वनरान्ये पातयन्ति स्म पत्रिभिः।\nतालमात्राणि चापानि विकर्षन्तो महारथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2052996, "chapter_id": 2170, "verse_number": "७-९७-११", "content_sanskrit": "असिचर्माणि चापानि शिरांशि कवचानि च।\nविप्रकीर्यन्त शूराणां सम्प्रहारे महात्मनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2052997, "chapter_id": 2170, "verse_number": "७-९७-१२", "content_sanskrit": "उत्थितान्यगणेयानि कबन्धानि समन्ततः।\nअदृश्यन्त महाराज तस्मिन्परमसङ्कुले॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2052998, "chapter_id": 2170, "verse_number": "७-९७-१३", "content_sanskrit": "गृध्राः कङ्का बकाः श्येना वायसा जम्बुकास्तथा।\nबहुशः पिशिताशाश्च तत्रादृश्यन्त मारिष॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2052999, "chapter_id": 2170, "verse_number": "७-९७-१४", "content_sanskrit": "भक्षयन्तश्च मांसानि पिबन्तश्चापि शोणितम्।\nविलुम्पमानाः केशांश्च मज्जाश्च बहुधा नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2053000, "chapter_id": 2170, "verse_number": "७-९७-१५", "content_sanskrit": "आकर्षन्तः शरीराणि शरीरावयवांस्तथा।\nनराश्वगजसङ्घानां शिरांशि च ततस्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2053001, "chapter_id": 2170, "verse_number": "७-९७-१६", "content_sanskrit": "कृतास्त्रा रणशिक्षाभिर्दीक्षिता रणशालिनः।\nरणे जयं प्रार्थयाना भृशं युयुधिरे तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2053002, "chapter_id": 2170, "verse_number": "७-९७-१७", "content_sanskrit": "असिमार्गान्बहुविधान्विचेरुः सैनिका रणे।\nऋष्टिभिः शक्तिभिः प्रासैः शूलतोमरपट्टसैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2053003, "chapter_id": 2170, "verse_number": "७-९७-१८", "content_sanskrit": "गदाभिः परिघैश्चान्यैरायुधैश्च भुजैरपि।\nअन्योन्यं जघ्निरे क्रुद्धा युद्धरङ्गता नराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2053004, "chapter_id": 2170, "verse_number": "७-९७-१९", "content_sanskrit": "रथिनो रथिभिः सार्धमश्वारोहाश्च सादिभिः।\nमातङ्गा वरमातङ्गैः पदाताश्च पदातिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2053005, "chapter_id": 2170, "verse_number": "७-९७-२०", "content_sanskrit": "क्षीबा इवान्ये चोन्मत्ता रङ्गेष्विव च वारणाः।\nउच्चुक्रुशुरथान्योन्यं जघ्नुरन्योन्यमेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2053006, "chapter_id": 2170, "verse_number": "७-९७-२१", "content_sanskrit": "वर्तमाने तथा युद्धे निर्मर्यादे विशाम्पते।\nधृष्टद्युम्नो हयानश्चैर्द्रोणस्य व्यत्यमिश्रयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2053007, "chapter_id": 2170, "verse_number": "७-९७-२२", "content_sanskrit": "ते हयाः साध्वशोभन्त मिश्रिता वातरंहसः।\nपारावतसवर्णाश्च रक्तशोणाश्च संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2053008, "chapter_id": 2170, "verse_number": "७-९७-२३", "content_sanskrit": "पारावतसवर्णास्ते रक्तशोणविमिश्रिताः।\nहयाः शुशुभिरे राजन्मेघा इव सविद्युतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2053009, "chapter_id": 2170, "verse_number": "७-९७-२४", "content_sanskrit": "धृष्टद्युम्नस्तु सम्प्रेक्ष्य द्रोणमभ्याशमागतम्।\nअसिचर्माददे वीरो धनुरुत्सृज्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2053010, "chapter_id": 2170, "verse_number": "७-९७-२५", "content_sanskrit": "चिकीर्षुर्दुष्करं कर्म पार्षतः परवीरहा।\nईषायाः समतिक्रम्य द्रोणस्य रथमाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2053011, "chapter_id": 2170, "verse_number": "७-९७-२६", "content_sanskrit": "अतिष्ठद्युगमध्ये स युगसन्नहनेषु च।\nजघनार्धेषु चाश्वानां तत्सैन्यान्यभ्यपूजयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2053012, "chapter_id": 2170, "verse_number": "७-९७-२७", "content_sanskrit": "खङ्गेन चरतस्तस्य शोणाश्वानधितिष्ठतः।\nन ददार्शान्तरं द्रोणस्तदद्भुतमिवाभवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2053013, "chapter_id": 2170, "verse_number": "७-९७-२८", "content_sanskrit": "यथा श्येनस्य पतनं वनेष्वामिषगृद्धिनः।\nतथैवासीदभीसारस्तस्य द्रोणं जिघांसतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2053014, "chapter_id": 2170, "verse_number": "७-९७-२९", "content_sanskrit": "ततः शरशतेनास्य शतचन्द्रं समाक्षिपत्।\nद्रोणो द्रुपद पुत्रस्य खङ्गं च दशभिः शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2053015, "chapter_id": 2170, "verse_number": "७-९७-३०", "content_sanskrit": "हयांश्चैव चतुःषष्ट्या शराणां जघ्निवान्बली।\nध्वजं छत्रं च भल्लाभ्यां तथा तौ पार्ष्णिसारथी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2053016, "chapter_id": 2170, "verse_number": "७-९७-३१", "content_sanskrit": "अथास्मै त्वरितो बाणमपरं जीवितान्तकम्।\nधृष्टद्युम्नाय चिक्षेप वज्रं वज्रधरो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2053017, "chapter_id": 2170, "verse_number": "७-९७-३२", "content_sanskrit": "तं चतुर्दशभिस्तीक्ष्णैर्बाणैश्चिच्छेद सात्यकिः।\nग्रस्तमाचार्यमुख्येन धृष्टद्युम्नं व्यमोचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2053018, "chapter_id": 2170, "verse_number": "७-९७-३३", "content_sanskrit": "सिंहेनेव मृगं ग्रस्तं नरसिंहेन मारिष।\nद्रोणाद्वै मोचयामास पाञ्चाल्यं शिनिपुङ्गवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2053019, "chapter_id": 2170, "verse_number": "७-९७-३४", "content_sanskrit": "सात्यकिं प्रेक्ष्य गोप्तारं पाञ्चाल्यं च महाहवे।\nशराणां त्वरितो द्रोणः षड्विंशत्या समार्पयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2053020, "chapter_id": 2170, "verse_number": "७-९७-३५", "content_sanskrit": "ततो द्रोणं शिनेः पौत्रो ग्रसन्तमपि सृञ्जयान्।\nप्रत्यविध्यच्छितैर्बाणैः षड्विंशत्या स्तनान्तरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2053021, "chapter_id": 2170, "verse_number": "७-९७-३६", "content_sanskrit": "ततः सर्वे रथास्तूर्णं पाञ्चाल्या जयगृद्धिनः।\nसात्वताभिसृते द्रोणे धृष्टद्युम्नमवाक्षिपन्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2053022, "chapter_id": 2170, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते द्रोणपर्वणि जयद्रथवधपर्वणि चतुर्दशदिवसयुद्धे सप्तनवतितमोऽध्यायः॥ ९७ ॥\nMahabharata - Drona Parva - Chapter Footnotes\n५-९७-२६ युगसन्नहनेषु युगबन्धेषु॥ ५-९७-३६ अवाक्षित् अपनीतवन्तः॥ ५-९७-९७ सप्तनवतितमोऽध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}]