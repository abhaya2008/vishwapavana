[{"id": 2015284, "chapter_id": 1320, "verse_number": "२-६१-१", "content_sanskrit": "भीष्ण उवाच॥\nसूदिता द्वारपालाश्च निशुम्भनरकौ हतौ।\nकृतक्षेमः पुनः पन्थाः पुरं प्राग्ज्योतिषं प्रति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015285, "chapter_id": 1320, "verse_number": "२-६१-२", "content_sanskrit": "शौरिणा पृथिवीपालास्त्रासिता भरतर्षभ।\nधनुषश्च प्रणादेन पाञ्चजन्यस्वनेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015286, "chapter_id": 1320, "verse_number": "२-६१-३", "content_sanskrit": "मेघप्रख्यैरनेकैश्च दाक्षिणात्याभिसंवृतम्।\nरुक्मिणं त्रासयामास केशवो भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015287, "chapter_id": 1320, "verse_number": "२-६१-४", "content_sanskrit": "ततः पर्जन्यघोषेण रथेनादित्यवर्चसा।\nउवाह महिषीं भोज्यामेष चक्रगदाधरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015288, "chapter_id": 1320, "verse_number": "२-६१-५", "content_sanskrit": "जारूथ्य आहृतक्रोधः शिशुपालश्च निर्जितः।\nवक्रश्च स हतः सङ्ख्ये शतधन्वा च क्षत्रियः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015289, "chapter_id": 1320, "verse_number": "२-६१-६", "content_sanskrit": "इन्द्रद्युम्नो हतः कोपाद्यवनश्च कशेरुकः।\nहतः सौभपतिश्चैव साल्वश्च कृतधन्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015290, "chapter_id": 1320, "verse_number": "२-६१-७", "content_sanskrit": "पर्वतानां सहस्रं च चक्रेण पुरुषोत्तमः।\nविभज्य पुण्डरीकाक्षो द्युमत्सेनमपोथयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015291, "chapter_id": 1320, "verse_number": "२-६१-८", "content_sanskrit": "महेन्द्रशिखरे चैव निमेषान्तरचारिणौ।\nजग्राह भरतश्रेष्ठ वानरावभितश्चरौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015292, "chapter_id": 1320, "verse_number": "२-६१-९", "content_sanskrit": "इरावत्यां महाभोजो वह्निसूर्यसमो बले।\nगोपतिस्तालकेतुश्च निहतौ शार्ङ्गधन्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015293, "chapter_id": 1320, "verse_number": "२-६१-१०", "content_sanskrit": "अक्षप्रपत्तने राजन्नवहेलनतत्परौ।\nउभौ तावपि कृष्णेन स्वराष्ट्रे विनिपातितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015294, "chapter_id": 1320, "verse_number": "२-६१-११", "content_sanskrit": "दग्धा वाराणसी तात केशवेन महात्मना।\nपाण्ड्यं पौण्ड्रं च मात्स्यं च कलिङ्गं च जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015295, "chapter_id": 1320, "verse_number": "२-६१-१२", "content_sanskrit": "जघान सहितान्सर्वानङ्गराजं च माधवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015296, "chapter_id": 1320, "verse_number": "२-६१-१३", "content_sanskrit": "एष चैव शतं हत्वा रथेन क्षत्रपुङ्गवान्।\nगान्धारीमवहत्कृष्णो महिषीं यादवर्षभः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015297, "chapter_id": 1320, "verse_number": "२-६१-१४", "content_sanskrit": "अथ गाण्डीवधन्वानं क्रीडार्थं मधुसूदनः।\nजिगाय भरतश्रेष्ठ कुन्त्याश्च प्रमुखे विभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015298, "chapter_id": 1320, "verse_number": "२-६१-१५", "content_sanskrit": "द्रौणिं कृपं च कर्णं च भीमसेनं सुयोधनम्।\nयुद्धाय सहितान्त्राजञ्जिगाय भरतर्षभ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015299, "chapter_id": 1320, "verse_number": "२-६१-१६", "content_sanskrit": "बभ्रोश्च प्रियमन्विच्छन्नेष चक्रगदाधरः।\nवेणुदारिवृतां भार्यां प्रममाथ युधिष्ठिर॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015300, "chapter_id": 1320, "verse_number": "२-६१-१७", "content_sanskrit": "पर्याप्तां पृथिवीं सर्वां साश्वां सरथकुञ्जराम्।\nवेणुदारिवशे युक्तां जिगाय मधुसूदनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015301, "chapter_id": 1320, "verse_number": "२-६१-१८", "content_sanskrit": "अवाप्य तपसा वीर्यं बलमोजश्च भारत।\nत्रासिताः सगणाः सर्वे बाणेन विबुधाधिपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015302, "chapter_id": 1320, "verse_number": "२-६१-१९", "content_sanskrit": "वज्राशनिगदाबामैस्ताडयद्भिरनेकशः।\nतस्य नासीद्रणे मृत्युर्देवैरपि सवासवैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015303, "chapter_id": 1320, "verse_number": "२-६१-२०", "content_sanskrit": "सोऽभिभूतश्च कृष्णेन न हतश्च मगात्मना।\nछित्वा बाहुसहस्रं तु गोविन्देन महात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2015304, "chapter_id": 1320, "verse_number": "२-६१-२१", "content_sanskrit": "एषोऽपीडन्महाबाहुः कंसं च मधुसूदनः।\nअवाप्तं तपसा वीर्यं बलमोजश्च भारत।\nकैटभं चातिलोमानि निजघान जनार्दनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2015305, "chapter_id": 1320, "verse_number": "२-६१-२२", "content_sanskrit": "जम्बुमैरावतं चैव विरूपं च महायशाः। २-६१-२२bजघान भरतश्रेष्ठ शम्बरं चारिमर्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2015306, "chapter_id": 1320, "verse_number": "२-६१-२३", "content_sanskrit": "एष भोगवतीं गत्वा वासुकिं भरतर्षभ।\nनिर्जित्य पुण्डरीकाक्षो रौक्मिणेयममोचयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2015307, "chapter_id": 1320, "verse_number": "२-६१-२४", "content_sanskrit": "एवं बहूनि कर्माणि शिशुरेव जनार्दनः।\nकृतवान्पुण्डरीकाक्षः सङ्कर्षणसहायवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2015308, "chapter_id": 1320, "verse_number": "२-६१-२५", "content_sanskrit": "एवमेषोऽसुराणां चसुराणामपि सर्वशः।\nभयामयकरः कृष्णः सर्वलोकेश्वरः प्रभुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2015309, "chapter_id": 1320, "verse_number": "२-६१-२६", "content_sanskrit": "एवमेव महाबाहुः शास्ता सर्वदुरात्मनाम्।\nकृत्वा देवार्थममितं स्वस्थानं प्राप्स्यते पुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2015310, "chapter_id": 1320, "verse_number": "२-६१-२७", "content_sanskrit": "एष भोगवतीं पुण्यां रविकान्तिं महायशाः।\nद्वारकामात्मसात्कृत्वा सागरं प्लावयिष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2015311, "chapter_id": 1320, "verse_number": "२-६१-२८", "content_sanskrit": "सुरासुरमनुष्येषु नाभून्न भविता क्वचित्।\nयस्तामध्यवसद्राजा नान्यत्र मधुसूदनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2015312, "chapter_id": 1320, "verse_number": "२-६१-२९", "content_sanskrit": "भ्राजमानास्तु वै सर्वे वृष्ण्यन्धकमहारथाः।\nतेजिष्ठं प्रतिपत्स्यन्ते नाकपृष्टं गतासवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2015313, "chapter_id": 1320, "verse_number": "२-६१-३०", "content_sanskrit": "एवमेव दशार्हाणां विधाय विधिना विधिम्।\nविष्णुर्नारायणः साक्षात्स्वस्थानं प्राप्स्यते ध्रुवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2015314, "chapter_id": 1320, "verse_number": "२-६१-३१", "content_sanskrit": "अप्रमेयोऽनियोज्यश्च यत्र कामगमो वशी। २-६१-३२ab मोदते भगवान्प्रीतो वालः क्रीडानकैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2015315, "chapter_id": 1320, "verse_number": "२-६१-३२", "content_sanskrit": "नैष गर्भत्वमापेदे न योन्यामावसत्प्रभुः।\nआत्मनस्तेजसा कृष्णः सर्वेषां कुरुते गतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2015316, "chapter_id": 1320, "verse_number": "२-६१-३३", "content_sanskrit": "यथा बुद्बुद उत्थाय तत्रैव प्रविलीयते।\nचराचराणि भूतानि तथा नारायणे सदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2015317, "chapter_id": 1320, "verse_number": "२-६१-३४", "content_sanskrit": "न प्रमातुं महाबाहुः शक्यो भारत केशवः।\nपरं हि परतस्तस्माद्विश्वरूपान्न विद्यते॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2015318, "chapter_id": 1320, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि एकषष्टितमोऽध्यायः॥ ६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]