[{"id": 7000456000, "chapter_id": 20456, "verse_number": "३-३-१", "content_sanskrit": "ऋषय ऊचुः ।\nनदीनां पर्वतानां च नामधेयानि सर्वशः ।\nतथा जनपदानां च ये चान्ये भूमिमाश्रिताः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000456001, "chapter_id": 20456, "verse_number": "३-३-२", "content_sanskrit": "प्रमाणं च प्रमाणज्ञ पृथिव्याः किल सर्वतः ।\nनिखिलेन समाचक्ष्व काननानि च सत्तम ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000456002, "chapter_id": 20456, "verse_number": "३-३-३", "content_sanskrit": "सूत उवाच ।\nपंचेमानि महाप्राज्ञ महाभूतानि संग्रहात् ।\nजगतीस्थानि सर्वाणि समान्याहुर्मनीषिणः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000456003, "chapter_id": 20456, "verse_number": "३-३-४", "content_sanskrit": "भूमिरापस्तथा वायुरग्निराकाशमेव च ।\nगुणोत्तराणि सर्वाणि तेषां भूमिः प्रधानतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000456004, "chapter_id": 20456, "verse_number": "३-३-५", "content_sanskrit": "शब्दस्पर्शश्च रूपं च रसो गंधश्च पंचमः ।\nभूमेरेतेगुणाः प्रोक्ता ऋषिभिस्तत्त्ववेदिभिः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000456005, "chapter_id": 20456, "verse_number": "३-३-६", "content_sanskrit": "चत्वारोप्सुगुणा विप्रा गंधस्तत्र न विद्यते ।\nशब्दः स्पर्शश्च रूपं च तेजसोथ गुणास्त्रयः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000456006, "chapter_id": 20456, "verse_number": "३-३-७", "content_sanskrit": "शब्दः स्पर्शश्च वायोस्तु आकाशे शब्द एव च ।\nएते पंच गुणा विप्रा महाभूतेषु पंचसु ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000456007, "chapter_id": 20456, "verse_number": "३-३-८", "content_sanskrit": "वर्तंते सर्वलोकेषु येषु भूताः प्रतिष्ठिताः ।\nअन्योन्यं नातिवर्तंते साम्यं भवति वै तदा ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000456008, "chapter_id": 20456, "verse_number": "३-३-९", "content_sanskrit": "यदा तु विषमीभावमाविशंति परस्परम् ।\nतदा देहैर्देहवंतो व्यतिरोहंति नान्यथा ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000456009, "chapter_id": 20456, "verse_number": "३-३-१०", "content_sanskrit": "आनुपूर्व्या विनश्यंति जायंते चानुपूर्वशः ।\nसर्वाण्यपरिमेयाणि तदेषां रूपमैश्वरम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000456010, "chapter_id": 20456, "verse_number": "३-३-११", "content_sanskrit": "यत्रयत्र हि दृश्यंते धावंति पांचभौतिकाः ।\nतेषां मनुष्यास्तर्केण प्रमाणानि प्रचक्षते ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000456011, "chapter_id": 20456, "verse_number": "३-३-१२", "content_sanskrit": "अचिंत्याः खलु ये भावास्तान्न तर्केण साधयेत् ।\nसुदर्शनं प्रवक्ष्यामि द्वीपं तु मुनिपुंगवाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000456012, "chapter_id": 20456, "verse_number": "३-३-१३", "content_sanskrit": "परिमंडलो महाभागा द्वीपोऽसौ चक्रसंस्थितः ।\nनदीजलपरिच्छिन्नः पर्वतैश्चाब्धिसन्निभैः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000456013, "chapter_id": 20456, "verse_number": "३-३-१४", "content_sanskrit": "पुरैश्च विविधाकारै रम्यैर्जनपदैस्तथा ।\nवृक्षैः पुष्पफलोपेतैः संपन्नो धनधान्यवान् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000456014, "chapter_id": 20456, "verse_number": "३-३-१५", "content_sanskrit": "लवणेन समुद्रेण समंतात्परिवारितः ।\nयथा हि पुरुषः पश्येदादर्शे मुखमात्मनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000456015, "chapter_id": 20456, "verse_number": "३-३-१६", "content_sanskrit": "एवं सुदर्शनो द्वीपो दृश्यते चक्रमंडलः ।\nद्विरंशे पिप्पलस्तस्य द्विरंशे च शशो महान् ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000456016, "chapter_id": 20456, "verse_number": "३-३-१७", "content_sanskrit": "सर्वौषधिं समादाय सर्वतः परिवारितः ।\nआपस्ततोन्या विज्ञेयाः शेषः संक्षेप उच्यते ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000456017, "chapter_id": 20456, "verse_number": "३-३-१८", "content_sanskrit": "ऋषय ऊचुः ।\nउक्तो यस्य च संक्षेपो बुद्धिमन्विधिवत्त्वया ।\nतत्त्वज्ञश्चासि सर्वस्य विस्तरं सूत नो वद ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000456018, "chapter_id": 20456, "verse_number": "३-३-१९", "content_sanskrit": "यावान्भूम्यवकाशोयं दृश्यते शशलक्षणे ।\nतस्य प्रमाणं प्रब्रूहि ततो वक्ष्यसि पिप्पलम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000456019, "chapter_id": 20456, "verse_number": "३-३-२०", "content_sanskrit": "एवं तैः किल पृष्टः स सूतो वाक्यमथाब्रवीत् ।\nसूत उवाच ।\nप्रागायता महाप्राज्ञाः षडेते रत्नपर्वताः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000456020, "chapter_id": 20456, "verse_number": "३-३-२१", "content_sanskrit": "अवगाढा ह्युभयतः समुद्रौ पूर्वपश्चिमौ ।\nहिमवान्हिमकूटश्च निषधश्च नगोत्तमः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000456021, "chapter_id": 20456, "verse_number": "३-३-२२", "content_sanskrit": "नीलश्च वैडूर्यमयः श्वेतश्च शशिसन्निभः ।\nसर्वधातुपिनद्धश्च शृंगवान्नामपर्वतः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000456022, "chapter_id": 20456, "verse_number": "३-३-२३", "content_sanskrit": "एते वै पर्वता विप्राः सिद्धचारणसेविताः ।\nतेषामंतरविष्कुंभौ योजनानि सहस्रशः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000456023, "chapter_id": 20456, "verse_number": "३-३-२४", "content_sanskrit": "तत्र पुण्या जनपदास्तानि वर्षाणि सत्तमाः ।\nवसंति तेषां सत्त्वानि नानाजातीनि सर्वशः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000456024, "chapter_id": 20456, "verse_number": "३-३-२५", "content_sanskrit": "इदं तु भारतं वर्षं ततो हैमवतं परम् ।\nहेमकूटात्परं चैव हरिवर्षं प्रचक्षते ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000456025, "chapter_id": 20456, "verse_number": "३-३-२६", "content_sanskrit": "दक्षिणेन तु नीलस्य निषधस्योत्तरेण च ।\nप्रागायतो महाभागा माल्यवान्नाम पर्वतः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000456026, "chapter_id": 20456, "verse_number": "३-३-२७", "content_sanskrit": "ततः परं माल्यवतः पर्वतो गंधमादनः ।\nपरिमंडलस्तयोर्मध्ये मेरुः कनकपर्वतः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000456027, "chapter_id": 20456, "verse_number": "३-३-२८", "content_sanskrit": "आदित्यतरुणाभासो विधूम इव पावकः ।\nयोजनानां सहस्राणि चतुरशीतिरुच्छ्रितः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000456028, "chapter_id": 20456, "verse_number": "३-३-२९", "content_sanskrit": "अधस्ताच्चतुरशीतिर्योजनानां द्विजोत्तमाः ।\nऊर्ध्वमधश्च तिर्यक्च लोकानावृत्य तिष्ठति ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000456029, "chapter_id": 20456, "verse_number": "३-३-३०", "content_sanskrit": "तस्य पार्श्वेष्वमी द्वीपाश्चत्वारः संस्थिता द्विजाः ।\nभद्राश्वः केतुमालश्च जंबूद्वीपश्च सत्तमाः ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000456030, "chapter_id": 20456, "verse_number": "३-३-३१", "content_sanskrit": "उत्तराश्चैव कुरुवः कृतपुण्य प्रतिश्रयाः ।\nविहंगसुमुखो यस्तु सुपार्श्वस्यात्मजः किल ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000456031, "chapter_id": 20456, "verse_number": "३-३-३२", "content_sanskrit": "स वै विचिंतयामास सौवर्णान्प्रेक्ष्य वायसान् ।\nमेरुरुत्तममध्यानामधमानां च पक्षिणाम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000456032, "chapter_id": 20456, "verse_number": "३-३-३३", "content_sanskrit": "अविशेषकरो यस्मात्तस्मादेनं त्यजाम्यहम् ।\nतमादित्योनुपर्येति सततं ज्योतिषां वरः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000456033, "chapter_id": 20456, "verse_number": "३-३-३४", "content_sanskrit": "चंद्रमाश्च सनक्षत्रो वायुश्चैव प्रदक्षिणः ।\nस पर्वतो महाप्राज्ञा दिव्यपुष्पसमन्वितः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000456034, "chapter_id": 20456, "verse_number": "३-३-३५", "content_sanskrit": "भवनैरावृतैः सर्वैः र्जांबूनदमयैः शुभैः ।\nतत्र देवगणा विप्रा गंधर्वासुरराक्षसाः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000456035, "chapter_id": 20456, "verse_number": "३-३-३६", "content_sanskrit": "अप्सरोगणसंयुक्ताः शैले क्रीडंति सर्वदा ।\nतत्र ब्रह्मा च रुद्रश्च शक्रश्चापि सुरेश्वरः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000456036, "chapter_id": 20456, "verse_number": "३-३-३७", "content_sanskrit": "समेत्य विविधैर्यज्ञैर्यजंतेऽनेक दक्षिणैः ।\nतुंबुरुर्नारदश्चैव विश्वावसुर्हाहा हूहूः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000456037, "chapter_id": 20456, "verse_number": "३-३-३८", "content_sanskrit": "अभिगम्यामरश्रेष्ठं स्तुवंति विविधैः स्तवैः ।\nसप्तर्षयो महात्मानः कश्यपश्च प्रजापतिः ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000456038, "chapter_id": 20456, "verse_number": "३-३-३९", "content_sanskrit": "तत्र गच्छंति भद्रं वः सदा पर्वणि पर्वणि ।\nतस्यैव मूर्द्धन्युशना काव्यो दैत्यैर्महीयते ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000456039, "chapter_id": 20456, "verse_number": "३-३-४०", "content_sanskrit": "तस्य हैमानि रत्नानि तस्यैते रत्नपर्वताः ।\nतस्मात्कुबेरो भगवांश्चतुर्थं भागमश्नुते ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000456040, "chapter_id": 20456, "verse_number": "३-३-४१", "content_sanskrit": "ततः कलांशं वित्तस्य मनुष्येभ्यः प्रयच्छति ।\nपर्वतस्यांतरे दिव्यं सर्वर्तुकुसुमैश्चितम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000456041, "chapter_id": 20456, "verse_number": "३-३-४२", "content_sanskrit": "कर्णिकारवनं रम्यं शिलाजालसमुच्छ्रितम् ।\nतत्र साक्षात्पशुपतिर्दिव्यभूतैः समावृतः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000456042, "chapter_id": 20456, "verse_number": "३-३-४३", "content_sanskrit": "उमासहायोभगवान्रमते भूतभावनः ।\nकर्णिकारमयीं मालां बिभ्रदापादलंबिनीम् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000456043, "chapter_id": 20456, "verse_number": "३-३-४४", "content_sanskrit": "त्रिभिर्नेत्रैः कृतोद्द्योतस्त्रिभिः सूर्यैरिवोदितैः ।\nतमुग्रतपसः सिद्धाः सुव्रताः सत्यवादिनः ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000456044, "chapter_id": 20456, "verse_number": "३-३-४५", "content_sanskrit": "पश्यंति नहि दुर्वृत्तैः शक्यो द्रष्टुं महेश्वरः ।\nतस्य शैलस्य शिखरात्क्षीरधारा द्विजोत्तमाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000456045, "chapter_id": 20456, "verse_number": "३-३-४६", "content_sanskrit": "विश्वरूपात्परमिता भीमनिर्घातनिस्वना ।\nपुण्यापुण्यतमैर्जुष्टा गंगा भागीरथी शुभा ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000456046, "chapter_id": 20456, "verse_number": "३-३-४७", "content_sanskrit": "प्लवंती च प्रवेगेन ह्रदे चंद्रमसः शुभे ।\nतया ह्युत्पादितः पुण्यः स ह्रदः सागरोपमः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000456047, "chapter_id": 20456, "verse_number": "३-३-४८", "content_sanskrit": "तां धारयामास तदा दुर्द्धरां पर्वतैरपि ।\nशतं वर्षसहस्राणि शिरसैव पिनाकधृक् ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000456048, "chapter_id": 20456, "verse_number": "३-३-४९", "content_sanskrit": "मेरोस्तु पश्चिमे पार्श्वे केतुमालो द्विजोत्तमाः ।\nजंबूखंडे तु तत्रैव महाजनपदो द्विजाः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000456049, "chapter_id": 20456, "verse_number": "३-३-५०", "content_sanskrit": "आयुर्दशसहस्राणि वर्षाणां तत्र सत्तमाः ।\nसुवर्णवर्णाश्च नरा स्त्रियश्चाप्सरसां समाः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000456050, "chapter_id": 20456, "verse_number": "३-३-५१", "content_sanskrit": "अनामया वीतशोका नित्यं मुदितमानसाः ।\nजायंते मानवास्तत्र निस्तप्तकनकप्रभाः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000456051, "chapter_id": 20456, "verse_number": "३-३-५२", "content_sanskrit": "गंधमादनशृंगेषु कुबेरः सह राक्षसैः ।\nसंवृतोप्सरसां संघैर्मोदते गुह्यकाधिपः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000456052, "chapter_id": 20456, "verse_number": "३-३-५३", "content_sanskrit": "गंधमादनपार्श्वे तु परे विगतपातकाः ।\nएकादशसहस्राणि वर्षाणां परमायुषः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000456053, "chapter_id": 20456, "verse_number": "३-३-५४", "content_sanskrit": "तत्र कृष्णा नरा विप्रास्तेजोयुक्ता महाबलाः ।\nस्त्रियश्चोत्पलपत्राभाः सर्वाः सुप्रियदर्शनाः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000456054, "chapter_id": 20456, "verse_number": "३-३-५५", "content_sanskrit": "नीलोत्पलधरं श्वेतं श्वेताद्धैरण्यकं वरम् ।\nवर्षमैरावतं विप्रा नानाजनपदावृतम् ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000456055, "chapter_id": 20456, "verse_number": "३-३-५६", "content_sanskrit": "धनुखंडेः महाभागा द्वे वर्षे दक्षिणोत्तरे ।\nइलावृत्तं मध्यगं तु पंचवर्षाणि चैव हि ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000456056, "chapter_id": 20456, "verse_number": "३-३-५७", "content_sanskrit": "उत्तरोत्तरमेतेभ्यो वर्षमुद्रिच्यते गुणैः ।\nआयुः प्रमाणमारोग्यं धर्मतः कामतोऽर्थतः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000456057, "chapter_id": 20456, "verse_number": "३-३-५८", "content_sanskrit": "समन्वितानि भूतानि तेषु सर्वेषु सत्तमाः ।\nएवमेषा महाभागाः पर्वतैः पृथिवी चिता ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000456058, "chapter_id": 20456, "verse_number": "३-३-५९", "content_sanskrit": "हेमकूटस्तु सुमहान्कैलासो नाम पर्वतः ।\nतत्र वैश्रवणो देवो गुह्यकैः सह मोदते ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000456059, "chapter_id": 20456, "verse_number": "३-३-६०", "content_sanskrit": "अस्त्युत्तरेण कैलासं मैनाकं पर्वतं प्रति ।\nहिरण्यशृंगः सुमहान्दिव्यो मणिमयो गिरिः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000456060, "chapter_id": 20456, "verse_number": "३-३-६१", "content_sanskrit": "तस्य पार्श्वे महद्दिव्यं शुभ्रं कांचनवालुकम् ।\nरम्यं विष्णुसरो नाम यत्र राजा भगीरथः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000456061, "chapter_id": 20456, "verse_number": "३-३-६२", "content_sanskrit": "दृष्ट्वा भागीरथीं गंगामुवास बहुलाः समाः ।\nयूपा मणिमयास्तत्र क्षेत्राश्चापि हिरण्मयाः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000456062, "chapter_id": 20456, "verse_number": "३-३-६३", "content_sanskrit": "तत्रेष्ट्वा तु गतः सिद्धिं सहस्राक्षो महायशाः ।\nस्रष्टा भूतिपतिर्यत्र सर्वलोकैः सनातनः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000456063, "chapter_id": 20456, "verse_number": "३-३-६४", "content_sanskrit": "उपास्यते तिग्मतेजा यत्र भूतः समंततः ।\nनरनारायणौ ब्रह्मा मनुः स्थाणुश्च पंचमः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000456064, "chapter_id": 20456, "verse_number": "३-३-६५", "content_sanskrit": "तत्र दिव्या त्रिपथगा प्रथमं तु प्रतिष्ठिता ।\nब्रह्मलोकादपाक्रांता सप्तधा प्रतिपद्यते ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000456065, "chapter_id": 20456, "verse_number": "३-३-६६", "content_sanskrit": "वटोदका सा नलिनी पार्वती च सरस्वती ।\nजंबूनदी च सीता च गंगा सिंधुश्च सप्तमी ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000456066, "chapter_id": 20456, "verse_number": "३-३-६७", "content_sanskrit": "अचिंत्या दिव्यसंज्ञा सा प्रभावैश्च समन्विता ।\nउपास्यते यत्र सत्रं सहस्रयुगपर्यये ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000456067, "chapter_id": 20456, "verse_number": "३-३-६८", "content_sanskrit": "दृश्यादृश्या च भवति तत्रतत्र सरस्वती ।\nएता दिव्याः सप्तगंगास्त्रिषुलोकेषु विश्रुताः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000456068, "chapter_id": 20456, "verse_number": "३-३-६९", "content_sanskrit": "रक्षांसि वै हिमवती हेमकूटे च गुह्यकाः ।\nसर्पा नागाश्च निषधे गोकर्णं च तपोवनम् ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000456069, "chapter_id": 20456, "verse_number": "३-३-७०", "content_sanskrit": "देवासुराणां सर्वेषां श्वेतः पर्वतमुच्यते ।\nगंधर्वा निषधे नित्यं नीले ब्रह्मर्षयस्तथा ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000456070, "chapter_id": 20456, "verse_number": "३-३-७१", "content_sanskrit": "शृंगवांस्तु महाभागा देवानां प्रतिसंचरः ।\nइत्येतानि महाभागाः सप्तवर्षाणि भागशः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000456071, "chapter_id": 20456, "verse_number": "३-३-७२", "content_sanskrit": "भूतान्युपनिविष्टानि गतिमंति ध्रुवाणि च ।\nतेषामृद्धिर्बहुविधा दृश्यते देवमानुषा ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000456072, "chapter_id": 20456, "verse_number": "३-३-७३", "content_sanskrit": "अशक्यं परिसंख्यातुं श्रद्धे या तु विभूषिता ।\nयां तु पृच्छथ मां विप्रा दिव्यमेनां शशाकृतिम् ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000456073, "chapter_id": 20456, "verse_number": "३-३-७४", "content_sanskrit": "पार्श्वे शशस्य द्वे वर्षे उक्ते ये दक्षिणोत्तरे ।\nकर्णे तु नागद्वीपश्च काश्यपद्वीप एव च ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000456074, "chapter_id": 20456, "verse_number": "३-३-७५", "content_sanskrit": "कर्णद्वीपशिलो विप्राः श्रीमान्मलयपर्वतः ।\nएतद्द्वितीयं द्वीपस्य दृश्यते शशिसंस्थितम् ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}]