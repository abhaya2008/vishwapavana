[{"id": 2087215, "chapter_id": 2849, "verse_number": "१२-३५४-०x", "content_sanskrit": "नरनारायणावूचतुः।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087216, "chapter_id": 2849, "verse_number": "१२-३५४-१", "content_sanskrit": "धन्योस्यनुगृहीतोसि यत्ते दृष्टः स्वयंप्रभुः।\nन हि तं दृष्टवान्कश्चित्पद्मयोनिरपि स्वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087217, "chapter_id": 2849, "verse_number": "१२-३५४-२", "content_sanskrit": "अव्यक्तयोनिर्भगवान्दुर्दर्शः पुरुषोत्तमः।\nनारदैतद्धि नौ सत्यं वचनं समुदाहृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087218, "chapter_id": 2849, "verse_number": "१२-३५४-३", "content_sanskrit": "नास्य भक्तात्प्रियतरो लोके कश्चन विद्यते।\nततः स्वयं दर्शितवान्स्वमात्मानं द्विजोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087219, "chapter_id": 2849, "verse_number": "१२-३५४-४", "content_sanskrit": "तपो हि तप्यतस्तस्य यत्स्थानं परमात्मनः।\nन तत्संप्राप्नुते कश्चिदृते ह्यावां द्वितोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087220, "chapter_id": 2849, "verse_number": "१२-३५४-५", "content_sanskrit": "या हि सूर्यसहस्रस्य समस्तस्य भवेद्द्युतिः।\nस्थानस्य सा भवेत्तस्य स्वयं तेन विराजता॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087221, "chapter_id": 2849, "verse_number": "१२-३५४-६", "content_sanskrit": "तस्मादुत्तिष्ठते विप्र देवाद्विश्वभुवः पतेः।\nक्षमा क्षमावतां श्रेष्ठ यया भूमिस्तु युज्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087222, "chapter_id": 2849, "verse_number": "१२-३५४-७", "content_sanskrit": "तस्माच्चोत्तिष्ठते देवात्सर्वभूतहिताद्रसः।\nआपो हि तेन युज्यन्ते द्रवत्वं प्राप्नुवन्ति च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087223, "chapter_id": 2849, "verse_number": "१२-३५४-८", "content_sanskrit": "तस्मादेव समुद्भूतं तेजो रूपगुणात्मकम्।\nयेन संयुज्यते सूर्यस्ततो लोके विराजते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087224, "chapter_id": 2849, "verse_number": "१२-३५४-९", "content_sanskrit": "तस्माद्देवात्समुद्भूतः स्पर्शस्तु पुरुषोत्तमात्।\nयेन स्म युज्यते वायुस्ततो लोकान्विवात्यसौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087225, "chapter_id": 2849, "verse_number": "१२-३५४-१०", "content_sanskrit": "तस्माच्चोत्तिष्ठते शब्दः सर्वलोकेश्वरात्प्रभोः।\nआकाशं युज्यते येन ततस्तिष्ठत्यसंवृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087226, "chapter_id": 2849, "verse_number": "१२-३५४-११", "content_sanskrit": "तस्माच्चोत्तिष्ठते देवात्सर्वभूतगतं मनः।\nचन्द्रमा येन संयुक्तः प्रकाशगुणधारणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087227, "chapter_id": 2849, "verse_number": "१२-३५४-१२", "content_sanskrit": "सद्भूतोत्पादकं नाम तत्स्थानं वेदसंज्ञितम्।\nविद्यासहायो यत्रास्ते भगवान्हव्यकव्यभुक्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087228, "chapter_id": 2849, "verse_number": "१२-३५४-१३", "content_sanskrit": "ये हि निष्कल्मषा लोके पुण्यपापविवर्जिताः।\nतेषां वै क्षेममध्वानं गच्छतां द्विजसत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087229, "chapter_id": 2849, "verse_number": "१२-३५४-१४", "content_sanskrit": "सर्वलोके तमोहन्ता आदित्यो द्वारमुच्यते।\n` ज्वालामाली महातेजा येनेदं धार्यते जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087230, "chapter_id": 2849, "verse_number": "१२-३५४-१५", "content_sanskrit": "आदित्यदग्धसर्वाङ्गा अदृश्याः केनचित्क्वचित्।\nपरमाणुभूता भूत्वा तु तं देवं प्रविशन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087231, "chapter_id": 2849, "verse_number": "१२-३५४-१६", "content_sanskrit": "तस्मादपि च निर्मुक्ता अनिरुद्धतनौ स्थिताः।\nमनोभूतास्ततो भूत्वा प्रद्युम्नं प्रविशन्त्युत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087232, "chapter_id": 2849, "verse_number": "१२-३५४-१७", "content_sanskrit": "प्रद्युम्नाच्चापि निर्मुक्ता जीवं संकर्षणं ततः।\nविशन्ति विप्रप्रवराः साङ्ख्या भागवतैः सह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2087233, "chapter_id": 2849, "verse_number": "१२-३५४-१८", "content_sanskrit": "ततस्त्रैगुण्यहीनास्ते परमात्मानमञ्जसा।\nप्रविशन्ति द्विजश्रेष्ठाः क्षेत्रज्ञं निर्गुणात्मकम्।\nसर्वावासं वासुदेवं क्षेत्रज्ञं विद्धि तत्त्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2087234, "chapter_id": 2849, "verse_number": "१२-३५४-१९", "content_sanskrit": "समाहितमनस्काश्च नियताः संयतेन्द्रियाः।\nएकान्तभावोपगता वासुदेवं विशन्ति ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2087235, "chapter_id": 2849, "verse_number": "१२-३५४-२०", "content_sanskrit": "आवामपि च धर्मस्य गुहे जातौ द्विजोत्तम।\nरम्यां विशालामाश्रित्य तप उग्रं समास्थितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2087236, "chapter_id": 2849, "verse_number": "१२-३५४-२१", "content_sanskrit": "ये तु तस्यैव देवस्य प्रादुर्भावाः सुरप्रियाः।\nभविष्यन्ति त्रिलोकस्थास्तेषां स्वस्तीत्यथो द्विज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2087237, "chapter_id": 2849, "verse_number": "१२-३५४-२२", "content_sanskrit": "विधिना स्वेन युक्ताभ्यां यथापूर्वं द्विजोत्तम।\nआस्थिताभ्यां सर्वकृच्छ्रं व्रतं सम्यगनुत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2087238, "chapter_id": 2849, "verse_number": "१२-३५४-२३", "content_sanskrit": "`स्वार्थेन विधिना युक्तः सर्वकृच्छ्रव्रते स्थितः।\nआवाभ्यामपि दृष्टस्त्वं श्वेतद्वीपे तपोधन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2087239, "chapter_id": 2849, "verse_number": "१२-३५४-२४", "content_sanskrit": "समागतो भगवता संकल्पं कृतवांस्तथा।\nसर्वं हि नौ संविदितं त्रैलोक्ये सचराचरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2087240, "chapter_id": 2849, "verse_number": "१२-३५४-२५", "content_sanskrit": "यद्भविष्यति वृत्तं वा वर्तते वा शुभाशुभम्।\nसर्वं स ते कथितवान्देवदेवो महामुने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2087241, "chapter_id": 2849, "verse_number": "१२-३५४-२६x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2087242, "chapter_id": 2849, "verse_number": "१२-३५४-२६", "content_sanskrit": "एतच्छ्रुत्वा तयोर्वाक्यं तपस्युग्रे च वर्ततोः।\nनारदः प्राञ्जलिर्भूत्वा नारायणपरायणः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2087243, "chapter_id": 2849, "verse_number": "१२-३५४-२७", "content_sanskrit": "जजाप विधिवन्मन्त्रान्नारायणगतान्बहून्।\nदिव्यं वर्षसहस्रं हि नरनारायणाश्रमे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2087244, "chapter_id": 2849, "verse_number": "१२-३५४-२८", "content_sanskrit": "अवसत्स महातेजा नारदो भगवानृषिः।\nतावेवाभ्यर्चयन्देवौ नरनारायणौ च तौ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2087245, "chapter_id": 2849, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि नारायणीये चतुःपञ्चादशधिकत्रिशततमोऽध्यायः॥ ३५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]