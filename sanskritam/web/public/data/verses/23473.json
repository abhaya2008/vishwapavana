[{"id": 7003473000, "chapter_id": 23473, "verse_number": "११३-१", "content_sanskrit": "अथ भगवत्स्तुतिः ।\nॐ नमो वराहाय नमो ब्रह्मपुत्राय सनत्कुमाराय नमः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7003473001, "chapter_id": 23473, "verse_number": "११३-२", "content_sanskrit": "नमस्तस्मै वराहाय लीलयोद्धरते महीम् ।\nसुरमध्यगतो यस्य मेरुः खणखणायते ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7003473002, "chapter_id": 23473, "verse_number": "११३-३", "content_sanskrit": "दंष्ट्राग्रेणोद्धृता गोरुदधिपरिवृता पर्वतैर्निम्नगाभिर्भक्तानां भीतिहानौ सुरनरकदशास्यान्तकः क्रोडरूपी ।\nविष्णुः सर्वेश्वरोऽयं यमिह हतमला लीलया प्राप्नुवन्ति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7003473003, "chapter_id": 23473, "verse_number": "११३-४", "content_sanskrit": "त्यक्तात्मानो न पापे प्रभु भवतु मुदितारातिपक्षक्षितीशम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7003473004, "chapter_id": 23473, "verse_number": "११३-५", "content_sanskrit": "यस्मिन्काले क्षितिः पूर्वकल्पे वाराह मूर्तिना ।\nउद्धृता च यया भक्त्या पप्रच्छ परमेश्वरम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7003473005, "chapter_id": 23473, "verse_number": "११३-६", "content_sanskrit": "धरण्युवाच ।\nकल्पे कल्पे भवानेव मां समुद्धरते भवान् ।\nन बाहुश्चेष्टते मूर्तिर्मादृशीं गां च केशव ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7003473006, "chapter_id": 23473, "verse_number": "११३-७", "content_sanskrit": "स तेन सान्त्वितायां वै पृथिव्यां यः समागतः ।\nसनत्कुमारस्तत्क्षेत्रे दृष्ट्वा तां संस्थितां महीम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7003473007, "chapter_id": 23473, "verse_number": "११३-८", "content_sanskrit": "स्वस्ति वाच्याह पुण्याग्रे प्रत्युवाच वसुन्धराम् ।\nसनत्कुमार उवाच ।\nयं दृष्ट्वा वर्द्धसे देवि त्वं च यस्यासि माधवि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7003473008, "chapter_id": 23473, "verse_number": "११३-९", "content_sanskrit": "विष्णुना धार्यमाणा च किं त्वया दृष्टमद्भुतम् ।\nएतदाचक्ष्व तत्त्वेन यत्ते हरिमुखाच्छ्रुतम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7003473009, "chapter_id": 23473, "verse_number": "११३-१०", "content_sanskrit": "ब्रह्मपुत्रवचः श्रुत्वा पृथिवी वाक्यमब्रवीत् ।\nधरण्युवाच ।\nयद्गुह्यं स मया पृष्टो यच्च मे सम्प्रभाषितम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7003473010, "chapter_id": 23473, "verse_number": "११३-११", "content_sanskrit": "शृणु तत्त्वेन विप्रेन्द्र गुह्यं धर्मं महौजसम् ।\nभगवत्प्रोक्तधर्मेषु यद्गुह्यं कथयाम्यहम्॥ 113.१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7003473011, "chapter_id": 23473, "verse_number": "११३-१२", "content_sanskrit": "तेन मे कथितं ह्येतत्संसारात्तु विमोक्षणम् ।\nविष्णुभक्तेन यत्कार्यं यत्क्रिया परितिष्ठता ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7003473012, "chapter_id": 23473, "verse_number": "११३-१३", "content_sanskrit": "उवाच परमं गुह्यं धर्माणां व्याप्तनिश्चयम् ।\nअयं धर्मो मया ह्येतच्छ्रुते धर्मे सनातने ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7003473013, "chapter_id": 23473, "verse_number": "११३-१४", "content_sanskrit": "ततो महीवचः श्रुत्वा ब्रह्मपुत्रो महातपाः ।\nकोकामुखे मम क्षेत्रं जपन्तो ब्रह्मवादिनः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7003473014, "chapter_id": 23473, "verse_number": "११३-१५", "content_sanskrit": "तान्सर्वानानयामास यत्र देवी व्यवस्थिता ।\nसनत्कुमारः पूतात्मा प्रत्युवाच महीं प्रति ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7003473015, "chapter_id": 23473, "verse_number": "११३-१६", "content_sanskrit": "सनत्कुमार उवाच ।\nयन्मया पूवर्मुक्तासि कथयस्व वरानने ।\nअप्रमेयगतिं चैव धर्ममाचक्ष्व तत्त्वतः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7003473016, "chapter_id": 23473, "verse_number": "११३-१७", "content_sanskrit": "ततस्तस्य वचः श्रुत्वा प्रणम्य ऋषिपुंगवम् ।\nउवाच परमप्रीता धात्री मधुरया गिरा ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7003473017, "chapter_id": 23473, "verse_number": "११३-१८", "content_sanskrit": "धरण्युवाच ।\nशृण्वन्तु ऋषयः सर्वे यत्तद्विष्णुमुखाच्छ्रुतम् ।\nबाढमित्येव तां देवि स्वस्ति ब्रूहीति सोऽब्रवीत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7003473018, "chapter_id": 23473, "verse_number": "११३-१९", "content_sanskrit": "नष्टचन्द्रानिले लोके नष्टभास्करतारके ।\nस्तम्भिताश्च दिशः सर्वा न प्राज्ञायत किञ्चन ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7003473019, "chapter_id": 23473, "verse_number": "११३-२०", "content_sanskrit": "न वाति पवनस्तत्र नैव चाग्निर्न विद्युतः ।\nन किंचित्तत्र विद्येत न तारा न च राशयः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7003473020, "chapter_id": 23473, "verse_number": "११३-२१", "content_sanskrit": "वेदेषु चैव नष्टेषु मत्स्यो भूत्वा रसातलम् ।\nप्रविश्य तानथोत्कृष्य ब्रह्मणे दत्तवानसि ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7003473021, "chapter_id": 23473, "verse_number": "११३-२२", "content_sanskrit": "अन्यद्देवः कूर्मरूपस्त्वं समुद्रस्य मन्थने ।\nधृतवानसि कौर्मेण मन्दरं मधुसूदन ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7003473022, "chapter_id": 23473, "verse_number": "११३-२३", "content_sanskrit": "पुनर्वराहरूपेण मां गच्छन्तीं रसातले ।\nउज्जहारेकदंष्ट्रेण भवानेव महार्णवात् ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7003473023, "chapter_id": 23473, "verse_number": "११३-२४", "content_sanskrit": "अन्यद्धिरण्यकशिपुर्वरदानेन दर्पितः ।\nअसावपि नृसिंहेण वपुरास्थाय नाशितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7003473024, "chapter_id": 23473, "verse_number": "११३-२५", "content_sanskrit": "पुनर्निःक्षत्ररूपेण त्वयाऽहं विकृता पुरा ।\nजामदग्न्येन रामेण त्वया दृष्टा सकृत्प्रभो ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7003473025, "chapter_id": 23473, "verse_number": "११३-२६", "content_sanskrit": "पुनश्च रावणो रक्षः क्षयितं स्वेन तेजसा ।\nबलिश्च बद्धो भगवन्त्वया वामनरूपिणा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7003473026, "chapter_id": 23473, "verse_number": "११३-२७", "content_sanskrit": "न च जानाम्यहं देव तव किंचिद्विचेष्टितम् ।\nउद्धृत्य मां कथं देव सृजसे किंच कारणम् ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7003473027, "chapter_id": 23473, "verse_number": "११३-२८", "content_sanskrit": "सृष्ट्वा किमादिशः सर्वां न प्राज्ञायत किंचन ।\nन वाति पवनस्तत्र न चैवाग्निर्ज्वलत्यपि ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7003473028, "chapter_id": 23473, "verse_number": "११३-२९", "content_sanskrit": "अंशवश्चन विद्यन्ते न नक्षत्रा न वा ग्रहाः ।\nन चैवाङ्गारकस्तत्र न शुक्रो   न बृहस्पतिः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7003473029, "chapter_id": 23473, "verse_number": "११३-३०", "content_sanskrit": "शनैश्चरो बुधो नात्र न चेन्द्रो धनदो यमः ।\nवरुणोऽपि न विद्येत नान्ये केचिद्दिवौकसः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7003473030, "chapter_id": 23473, "verse_number": "११३-३१", "content_sanskrit": "वर्जयित्वात्र त्रीन्देवान् ब्रह्मविष्णुमहेश्वरान् ।\nपृथिवी भारसन्तप्ता ब्रह्माणं शरणं गता ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7003473031, "chapter_id": 23473, "verse_number": "११३-३२", "content_sanskrit": "गत्वा च शरणं देवी दैन्यं वदति माधवी ।\nप्रसीद मम देवेन्द्र मग्नाहं भारपीडिता ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7003473032, "chapter_id": 23473, "verse_number": "११३-३३", "content_sanskrit": "सपर्वतवनैः सार्द्धं मां तारय पितामह ।\nपृथिव्या वचनं श्रुत्वा ब्रह्मा लोकपितामहः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7003473033, "chapter_id": 23473, "verse_number": "११३-३४", "content_sanskrit": "मुहुर्तं ध्यानमास्थाय पृथिवीं तामुवाच ह ।\nनाहं तारयितुं शक्तो विषमस्थां वसुन्धरे ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7003473034, "chapter_id": 23473, "verse_number": "११३-३५", "content_sanskrit": "लोकनाथं सुरश्रेष्ठमादिकर्त्तारमञ्जसा ।\nलोकेशं धन्विनं श्रेष्ठं याहि मायाकरण्डकम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7003473035, "chapter_id": 23473, "verse_number": "११३-३६", "content_sanskrit": "सर्वेषामेव नः कार्यं यच्च किञ्चित्प्रवर्त्तते ।\nसर्वांस्तारयितुं शक्तः कि पुनस्त्वां वसुन्धरे ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7003473036, "chapter_id": 23473, "verse_number": "११३-३७", "content_sanskrit": "अनन्तशयने देवं शयानं योगशायिनम् ।\nततः कमलपत्राक्षी नानाभरणभूषिता ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7003473037, "chapter_id": 23473, "verse_number": "११३-३८", "content_sanskrit": "कृताञ्जलिपुटा देवी प्रसादयति माधवम् ।\nधरण्युवाच ।\nअहं भारसमायुक्ता ब्रह्माणं शरणङ्गता ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7003473038, "chapter_id": 23473, "verse_number": "११३-३९", "content_sanskrit": "प्रत्याख्याता भगवता तेनाप्युक्तमिदं वचः ।\nनाहं तारयितुं शक्तः सुश्रोणि व्रज माधवम् ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7003473039, "chapter_id": 23473, "verse_number": "११३-४०", "content_sanskrit": "स त्वां तारयितुं शक्तो मग्नासि यदि सागरे ।\nप्रसीद मम देवेश लोकनाथ जगत्प्रभो ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7003473040, "chapter_id": 23473, "verse_number": "११३-४१", "content_sanskrit": "भक्त्या त्वां शरणं यामि प्रसीद मम माधव।\nत्वमादित्यश्च चन्द्रश्च त्वं यमो धनदस्तु वै ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7003473041, "chapter_id": 23473, "verse_number": "११३-४२", "content_sanskrit": "वासवो वरुणश्चासि ह्यग्निर्मारुत एव च ।\nअक्षरश्च क्षरश्चासि त्वं दिशो विदिशो भवान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7003473042, "chapter_id": 23473, "verse_number": "११३-४३", "content_sanskrit": "मत्स्यः कूर्म्मो वराहश्च नरसिंहोऽसि वामनः ।\nरामो रामश्च कृष्णश्च बुद्धः कल्की महात्मवान् ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7003473043, "chapter_id": 23473, "verse_number": "११३-४४", "content_sanskrit": "एवं पश्यसि योगेन श्रूयते त्वं महायशाः ।\nयुगायुग सहस्राणि व्यतीतान्यसि संस्थितः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7003473044, "chapter_id": 23473, "verse_number": "११३-४५", "content_sanskrit": "पृथिवी वायुराकाशमापोज्योतिश्च पञ्चमम्।\nशब्दस्पर्शस्वरूपोऽसि रसो गन्धोऽसि नो भवान् ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7003473045, "chapter_id": 23473, "verse_number": "११३-४६", "content_sanskrit": "सग्रहाणि च ऋक्षाणि कलाकाष्ठामुहूर्त्तकाः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7003473046, "chapter_id": 23473, "verse_number": "११३-४७", "content_sanskrit": "सग्रहा ये च नक्षत्रा कला कालमुहूर्त्तकाः ।\nज्योतिश्चक्रं ध्रुवश्चाऽसि सर्वेषु द्योतते भवान् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7003473047, "chapter_id": 23473, "verse_number": "११३-४८", "content_sanskrit": "मासः पक्षमहोरात्रमृतुः संवत्सराण्यपि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7003473048, "chapter_id": 23473, "verse_number": "११३-४९", "content_sanskrit": "कला काष्ठापि षण्मासाः षड्रसाश्चापि संयमः ।\nसरितः सागराश्च त्वं पर्वताश्च महोरगाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7003473049, "chapter_id": 23473, "verse_number": "११३-५०", "content_sanskrit": "त्वं मेरुर्मन्दरो विन्ध्यो मलयो दर्दुरो भवान् ।\nहिमवान्निषधश्चासि सचक्रोऽसि वरायुधः ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7003473050, "chapter_id": 23473, "verse_number": "११३-५१", "content_sanskrit": "धनुषां च पिनाकोऽसि सांख्ययोगोऽसि चोत्तमः ।\nपरम्परोऽसि लोकानां नारायणः परायणः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7003473051, "chapter_id": 23473, "verse_number": "११३-५२", "content_sanskrit": "संक्षिप्तश्चैव विस्तारो गोप्ता  यज्ञश्च शश्वतः ।\nयज्ञानां च महायज्ञो यूपानामसि संस्थितः ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7003473052, "chapter_id": 23473, "verse_number": "११३-५३", "content_sanskrit": "वेदानां सामवेदोऽसि साङ्गोपाङ्गो महाव्रतः ।\nगर्जनं वर्षणं चासि त्वं वेधा अनृतानृते ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7003473053, "chapter_id": 23473, "verse_number": "११३-५४", "content_sanskrit": "अमृतं सृजसे विष्णो येन लोकानधारयत् ।\nत्वं प्रीतिस्त्वं परा प्रीतिः पुराणः पुरुषो भवान् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7003473054, "chapter_id": 23473, "verse_number": "११३-५५", "content_sanskrit": "धेयाधेयं जगत्सर्वं यच्च किंचित् प्रवर्त्तते ।\nसप्तानामपि लोकानां त्वं नाथस्त्वमसंग्रहः ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7003473055, "chapter_id": 23473, "verse_number": "११३-५६", "content_sanskrit": "त्वं च कालश्च मृत्युश्च त्वं भूतो भूतभावनः।\nआदिमध्यान्तरूपोऽसि मेधा बुद्धिः स्मृतिर्भवान् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7003473056, "chapter_id": 23473, "verse_number": "११३-५७", "content_sanskrit": "आदित्यस्त्वं युगावर्त्तास्त्वं तपस्वी महातपाः ।\nअप्रमाणः प्रमेयोऽसि ऋषीणां च महानृषिः ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7003473057, "chapter_id": 23473, "verse_number": "११३-५८", "content_sanskrit": "अनन्तश्चासि नागानां सर्पाणामसि तक्षकः ।\nउद्वहः प्रवहश्चासि वरुणो वारुणो भवान् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7003473058, "chapter_id": 23473, "verse_number": "११३-५९", "content_sanskrit": "क्रीडाविक्षेपणश्चासि गृहेषु गृहदेवताः ।\nसर्वात्मकः सर्वगतो वर्द्धनो मन एव च ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7003473059, "chapter_id": 23473, "verse_number": "११३-६०", "content_sanskrit": "साङ्गस्त्वं विद्युतीनां च वैद्युतानां महाद्युतिः ।\nयुगे मन्वन्तरे चापि वृक्षाणां च वनस्पतिः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7003473060, "chapter_id": 23473, "verse_number": "११३-६१", "content_sanskrit": "श्रद्धासि त्वं च देवेश दोषहन्तासि माधव ।\nअण्डजोद्भिज्जस्वेदानां जरायूनां च माधव ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7003473061, "chapter_id": 23473, "verse_number": "११३-६२", "content_sanskrit": "गरुडोऽसि महात्मानं वहसि त्वं परायणः ।\nदुन्दुभिर्नेमिघोषैश्च आकाशममलो भवान् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7003473062, "chapter_id": 23473, "verse_number": "११३-६३", "content_sanskrit": "जयश्च विजयश्चासि गृहेषु गृहदेवताः ।\nसर्वात्मकः सर्वगतश्चेतनो मन एव च ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7003473063, "chapter_id": 23473, "verse_number": "११३-६४", "content_sanskrit": "भगस्त्वं विषलिङ्गश्च परस्त्वं परमात्मकः ।\nसर्वभूतनमस्कार्यो नमो देव नमो नमः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7003473064, "chapter_id": 23473, "verse_number": "११३-६५", "content_sanskrit": "मां त्वं मग्नामसि त्रातुं लोकनाथ इहार्हसि ।\nआदिकालात्मकः कृष्णः सर्वलोकात्मको विभुः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7003473065, "chapter_id": 23473, "verse_number": "११३-६६", "content_sanskrit": "य इदं पठते स्तोत्रं केशवस्य दृढव्रतः ।\nव्याधितो मुच्यते रोगाद्बद्धो मुच्येत बन्धनात् ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7003473066, "chapter_id": 23473, "verse_number": "११३-६७", "content_sanskrit": "अपुत्रो लभते पुत्रं दरिद्रो धनमाप्नुयात् ।\nअभार्यो लभते भार्यामपतिः पतिमाप्नुयात् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7003473067, "chapter_id": 23473, "verse_number": "११३-६८", "content_sanskrit": "उभे सन्ध्ये पठेत्स्तोत्रं माधवस्य महात्मनः ।\nस गच्छेद्विष्णुलोकं च नात्र कार्या विचारणा ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7003473068, "chapter_id": 23473, "verse_number": "११३-६९", "content_sanskrit": "एवं तु अक्षरोक्तोऽपि भवेत्तु परिकल्पना ।\nतावद्वर्षसहस्राणि स्वर्गलोके महीयते ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}]