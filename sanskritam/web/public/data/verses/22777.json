[{"id": 7002777000, "chapter_id": 22777, "verse_number": "९-६२-१", "content_sanskrit": "श्रीकृष्ण उवाच ।\nउल्काख्यं नवमीं राजन्कथयामि निबोध ताम् ।\nया काश्यपेन कथिता तारकस्यार्तिनाशिनी ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7002777001, "chapter_id": 22777, "verse_number": "९-६२-२", "content_sanskrit": "अश्वयुक्छुक्लपक्षे या नवमी लोकविश्रुता ।\nनद्यां स्नात्वा समभ्यर्च्य पितृदेवीं यथाविधि ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7002777002, "chapter_id": 22777, "verse_number": "९-६२-३", "content_sanskrit": "पश्चात्संपूजयेद्देवीं चामुण्डां भैरवप्रियाम् ।\nपुष्पैर्धूपैस्सनैवेद्यैर्मांसमत्स्यसुरासवैः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7002777003, "chapter_id": 22777, "verse_number": "९-६२-४", "content_sanskrit": "पूजयित्वा स्तवं कुर्यान्मन्त्रेणानेन मानवः ।\nसमारोप्याञ्जलिं मूर्ध्नि जानुभ्यामवनीं गतः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7002777004, "chapter_id": 22777, "verse_number": "९-६२-५", "content_sanskrit": "महिषघ्नि महामाये चामुण्डे मुण्डमालिनि ।\nद्रव्यमारोग्यविजयौ देहि देवि नमोऽस्तु ते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7002777005, "chapter_id": 22777, "verse_number": "९-६२-६", "content_sanskrit": "कुमारीर्भोजयेत्पश्चान्नवनीलसुकंचुकैः ।\nपरिधानैर्भूषणैश्च भूषयित्वा क्षमापयेत् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7002777006, "chapter_id": 22777, "verse_number": "९-६२-७", "content_sanskrit": "सप्त पञ्चाप्यथैकां वा चित्तवित्तानुरूपतः ।\nश्रद्धया तुष्यते देवी इति वीरानुशासनम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7002777007, "chapter_id": 22777, "verse_number": "९-६२-८", "content_sanskrit": "अभ्युक्ष्य मण्डलं कृत्वा गोमयेन शुचिस्मितः ।\nदत्तासने चोपविशेत्पात्रं च पुरतो न्यसेत् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7002777008, "chapter_id": 22777, "verse_number": "९-६२-९", "content_sanskrit": "ततः सुसिद्धमन्नं यत्तत्सर्वं परिवेषयेत् ।\nसघृतं पायसं चापि स्थापयेत्पात्रस न्निधौ ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7002777009, "chapter_id": 22777, "verse_number": "९-६२-१०", "content_sanskrit": "तृणानि षष्टिमादाय चादाय धमनीं तथा ।\nप्रज्वालयेत्तत्तो भोज्यं यावज्ज्वलति पावकः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7002777010, "chapter_id": 22777, "verse_number": "९-६२-११", "content_sanskrit": "प्रशांते भोजनं त्यक्त्वा समाचम्य प्रसन्नधीः ।\nचामुंडां हृदये ध्यात्वा गृहकृत्यपरो भवेत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7002777011, "chapter_id": 22777, "verse_number": "९-६२-१२", "content_sanskrit": "अनेन विधिना सर्वं मासिमासि समाचरेत् ।\nततः संवत्सरस्यांते भोज यित्वा कुमारिकाः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7002777012, "chapter_id": 22777, "verse_number": "९-६२-१३", "content_sanskrit": "वस्त्रैराभरणैः पूज्य प्रणिपत्य क्षमापयेत् ।\nसुवर्णं शक्तितो दद्याद्गां च विप्राय शोभनाम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7002777013, "chapter_id": 22777, "verse_number": "९-६२-१४", "content_sanskrit": "य एवं कुरुते पार्थ पुरुषो नवमीव्रतम् ।\nन तस्य शत्रवो नार्तिः स राजा नष्टतस्करः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7002777014, "chapter_id": 22777, "verse_number": "९-६२-१५", "content_sanskrit": "भूताः प्रेताः पिशाचा नो जनयंति भयं गृहे ।\nसमुद्यतेषु शस्त्रेषु हंता तस्य न विद्यते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7002777015, "chapter_id": 22777, "verse_number": "९-६२-१६", "content_sanskrit": "तं रक्षति सदोद्युक्ता सर्वास्वापत्सु चंडिका ।\nनरो वा यदि वा नारी व्रतमेतत्समाचरेत् ।\nउल्कावत्स सपत्नानां ज्वलन्नास्ते सदा हृदि ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7002777016, "chapter_id": 22777, "verse_number": "९-६२-१७", "content_sanskrit": "तां शुष्ककोहरमुखीं प्रकटोरुदंष्ट्रां कापालिनीं समवलंबितमुण्डमालाम् ।\nउक्तव्रतेषु पुरुषो नवमीषु चण्डीं संपूज्य कस्य हृदये न च शं करोति ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]