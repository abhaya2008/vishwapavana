[{"id": 2015319, "chapter_id": 1321, "verse_number": "२-६२-१", "content_sanskrit": "वैशम्पायन उवाच॥\nएवमुक्त्वा ततो भीष्णो विरराम महाबलः।\nव्याजहारोत्तरं तत्र सहदेवोऽर्थवद्वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2015320, "chapter_id": 1321, "verse_number": "२-६२-२", "content_sanskrit": "केशवं केशिहन्तारमप्रमेयपराक्रमम्।\nपूज्यमानं मया यो वः कृष्णं न सहते नृपाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2015321, "chapter_id": 1321, "verse_number": "२-६२-३", "content_sanskrit": "सर्वेषां बलिनां मूर्ध्नि मयेदं निहितं पदम्।\nएवमुक्ते मया सम्यगुत्तरं प्रब्रवीतु सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2015322, "chapter_id": 1321, "verse_number": "२-६२-४", "content_sanskrit": "स एव हि मया वध्यो भविष्यति न संशयः।\nमतिमन्तश्च ये केचिदाचार्यं पितरं गुरुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2015323, "chapter_id": 1321, "verse_number": "२-६२-५", "content_sanskrit": "अर्च्यमर्चितमर्घार्हमनुजानन्तु ते नृपाः।\nततो न व्याजहारैषां कश्चिद्बुद्धिमतां सताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2015324, "chapter_id": 1321, "verse_number": "२-६२-६", "content_sanskrit": "मानिनां बलिनां राज्ञां मध्ये वै दर्शिते पदे।\nततोऽपतत्पुष्पवृष्टिः सहदेवस्य मूर्धनि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2015325, "chapter_id": 1321, "verse_number": "२-६२-७", "content_sanskrit": "अदृश्यरूपा वाचश्चाप्यब्रुवन्साधुसाध्विति।\nअविध्यदजिनं कृष्णं भविष्यद्भूतजल्पनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2015326, "chapter_id": 1321, "verse_number": "२-६२-८", "content_sanskrit": "सर्वसंशयनिर्मोक्ता नारदः सर्वलोकवित्।\nउवाचाखिलभूतानां मध्ये स्पष्टतरं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2015327, "chapter_id": 1321, "verse_number": "२-६२-९", "content_sanskrit": "कृष्णं कमलपत्राक्षं नार्चयिष्यन्ति ये नराः।\nजीवन्मृतास्तु ते ज्ञेया न सभाष्याः कदाचना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2015328, "chapter_id": 1321, "verse_number": "२-६२-१०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2015329, "chapter_id": 1321, "verse_number": "२-६२-१०", "content_sanskrit": "पूजयित्वा च पूजार्हान्ब्रह्मक्षत्रविशेषवित्।\nसहदेवो नृणां देवः समापयत कर्म तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2015330, "chapter_id": 1321, "verse_number": "२-६२-११", "content_sanskrit": "तस्मिन्नभ्यर्चिते कृष्णे सुनीथः शत्रुकर्षणः।\nअतिताम्रेक्षणः कोपादुवाच मनुजाधिपान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2015331, "chapter_id": 1321, "verse_number": "२-६२-१२", "content_sanskrit": "स्थितः सेनापतिर्योऽहं मन्वध्वं किं तु साम्प्रतम्।\nयुधि तिष्ठाम सन्नह्य समेतान्वृष्णिपाण्डवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2015332, "chapter_id": 1321, "verse_number": "२-६२-१३", "content_sanskrit": "इति सर्वान्समुत्साद्य राज्ञस्तांशअचेदिपुङ्गवः।\nयज्ञोपघाताय ततः सोऽमन्त्रतय राजभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2015333, "chapter_id": 1321, "verse_number": "२-६२-१४", "content_sanskrit": "तत्राहूतागताः सर्वे सुनीथप्रमुखा गणाः.\nसमदृश्यन्त सङ्क्रुद्धा विवर्णवदनास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2015334, "chapter_id": 1321, "verse_number": "२-६२-१५", "content_sanskrit": "युधिष्ठिराभिषेकं च वासुदेवस्य चार्हणम्।\nन स्याद्यथा तथा कार्यमेवं सर्वे तदाऽब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2015335, "chapter_id": 1321, "verse_number": "२-६२-१६", "content_sanskrit": "निष्कर्षान्निश्चयात्सर्वे राजानः क्रोधमूर्छिताः।\nअब्रुवंस्तत्र राजानो निर्वेदादात्मनिश्चयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2015336, "chapter_id": 1321, "verse_number": "२-६२-१७", "content_sanskrit": "सुहृद्भिर्वार्यमाणानां तेषां हि वपुराबभौ।\nआमिषादपकृष्टानां सिहानामिव गर्जताम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2015337, "chapter_id": 1321, "verse_number": "२-६२-१८", "content_sanskrit": "तं बलौघमपर्यन्तं राजसागारमक्षयम्।\nकुर्वाणं समयं कृष्णो युद्धाय बुबुधे तदा॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2015338, "chapter_id": 1321, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते सभापर्वणि अर्घाहरणपर्वणि द्विषष्टितमोऽध्यायः॥ ६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]