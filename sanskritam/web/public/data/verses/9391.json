[{"id": 40022355, "chapter_id": 9391, "verse_number": "1", "content_sanskrit": "तं शयानं नरव्याघ्रं निद्रा नाभ्यागमत्तदा । चिन्तयन्तमनेकार्थं रामगीतमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40022356, "chapter_id": 9391, "verse_number": "2", "content_sanskrit": "तस्य शब्दं सुमधुरं तन्त्रीलयसमन्वितम् । श्रुत्वा रात्रिर्जगामाशु शत्रुघ्नस्य महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40022357, "chapter_id": 9391, "verse_number": "3", "content_sanskrit": "तस्यां निशायां व्युष्टायां कृत्वा पौर्वाह्णिकं क्रमम् । उवाच प्राञ्जलिर्वाक्यं शत्रुघ्नो मुनिपुङ्गवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40022358, "chapter_id": 9391, "verse_number": "4", "content_sanskrit": "भगवन्द्रष्टुमिच्छामि राघवं रघुनन्दनम् । त्वया ऽनुज्ञातुमिच्छामि सहैभिः संशितव्रतैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40022359, "chapter_id": 9391, "verse_number": "5", "content_sanskrit": "इत्येवंवादिनं तं तु शत्रुघ्नं शत्रुतापनम् । वाल्मीकिः सम्परिष्वज्य विससर्ज च राघवम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40022360, "chapter_id": 9391, "verse_number": "6", "content_sanskrit": "सो ऽभिवाद्य मुनिश्रेष्ठं रथमारुह्य सुप्रभम् । अयोध्यामगमत्तूर्णं राघवोत्सुकदर्शनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40022361, "chapter_id": 9391, "verse_number": "7", "content_sanskrit": "स प्रविष्टः पुरीं रम्यां श्रीमानिक्ष्वाकुनन्दनः । प्रविवेश महाबाहुर्यत्र रामो महाद्युतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40022362, "chapter_id": 9391, "verse_number": "8", "content_sanskrit": "स रामं मन्त्रिमध्यस्थं पूर्णचन्द्रनिभाननम् । पश्यन्नमरमध्यस्थं सहस्रनयनं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40022363, "chapter_id": 9391, "verse_number": "9", "content_sanskrit": "सो ऽभिवाद्य महात्मानं ज्वलन्तमिव तेजसा । उवाच प्राञ्जलिर्वाक्यं रामं सत्यपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40022364, "chapter_id": 9391, "verse_number": "10", "content_sanskrit": "यदाज्ञप्तं महाराज सर्वं तत्कृतवानहम् । हतः स लवणः पापः पुरी चास्य निवेशिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40022365, "chapter_id": 9391, "verse_number": "11", "content_sanskrit": "द्वादशैते गता वर्षास्त्वां विना रघुनन्दन । नोत्सहेयमहं वस्तुं त्वया विरहितो नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40022366, "chapter_id": 9391, "verse_number": "12", "content_sanskrit": "स मे प्रसादं काकुत्स्थ कुरुष्वामितविक्रम । मातृहीनो यथा वत्सो न चिरं प्रवसाम्यहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40022367, "chapter_id": 9391, "verse_number": "13", "content_sanskrit": "एवं ब्रुवाणं शत्रुघ्नं परिष्वज्येदमब्रवीत् । मा विषादं कृथाः शूर नैतत्क्षत्रियचेष्टितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40022368, "chapter_id": 9391, "verse_number": "14", "content_sanskrit": "नावसीदन्ति राजानो विप्रवासेषु राघव । प्रजा नः परिपाल्या हि क्षत्रधर्मेण राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40022369, "chapter_id": 9391, "verse_number": "15", "content_sanskrit": "काले काले तु मां वीर अयोध्यामवलोकितुम् । आगच्छ त्वं नरश्रेष्ठ गन्तासि च पुरं तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40022370, "chapter_id": 9391, "verse_number": "16", "content_sanskrit": "ममापि त्वं सुदयितः प्राणैरपि न संशयः । अवश्यं करणीयं च राज्यस्य परिपालनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40022371, "chapter_id": 9391, "verse_number": "17", "content_sanskrit": "तस्मात्त्वं वस काकुत्स्थ सप्तरात्रमिहावस । ऊर्ध्वं गन्तासि मधुरां सभृत्यबलवाहनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40022372, "chapter_id": 9391, "verse_number": "18", "content_sanskrit": "रामस्यैतद्वचः श्रुत्वा धर्मयुक्तं मनोगतम् । शत्रुघ्नो दीनया वाचा बाढमित्येव चाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40022373, "chapter_id": 9391, "verse_number": "19", "content_sanskrit": "सप्तरात्रं च काकुत्स्थो राघवस्य यथाज्ञया । उष्य तत्र महेष्वासो गमनायोपचक्रमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40022374, "chapter_id": 9391, "verse_number": "20", "content_sanskrit": "आमन्त्र्य तु महात्मानं रामं सत्यपराक्रमम् । भरतं लक्ष्मणं चैव महारथमुपारुहत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40022375, "chapter_id": 9391, "verse_number": "21", "content_sanskrit": "दूरमाभ्यामनुगतो लक्ष्मणेन महात्मना । भरतेन च शत्रुघ्नो जगामाशु पुरं ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}]