[{"id": 2140103, "chapter_id": 4024, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2140104, "chapter_id": 4024, "verse_number": "१", "content_sanskrit": "ततस्तेषां तदा राजन् तत्रैवामिततेजसाम् ।\nछद्मलिङ्गप्रविष्टानां पाण्डवानां महात्मनाम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2140105, "chapter_id": 4024, "verse_number": "२", "content_sanskrit": "व्यतीतः समयः सम्यग् विराटनगरे सताम् ।\nकुर्वतां तस्य कर्माणि विराटस्य महीपतेः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2140106, "chapter_id": 4024, "verse_number": "३", "content_sanskrit": "ततस्त्रयोदशस्यान्ते तस्य वर्षस्य भारत ।\nसुशर्मणा गृहीतं तु मत्स्यराजस्य गोधनम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2140107, "chapter_id": 4024, "verse_number": "४", "content_sanskrit": "ततः शब्दो महानासीद् रेणुश्च दिवमस्पृशत् ।\nशङ्खदुन्दुभिघोषश्च भेरीणां च महास्वनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2140108, "chapter_id": 4024, "verse_number": "५", "content_sanskrit": "गवाश्वरथनागानां नराणां च पदातिनाम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2140109, "chapter_id": 4024, "verse_number": "६", "content_sanskrit": "एवं तैस्त्वभिनिर्याय मत्स्यराजस्य गोधने ।\nत्रिगर्तैर्गृह्यमाणे तु गोपालाः प्रत्यषेधयन्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2140110, "chapter_id": 4024, "verse_number": "७", "content_sanskrit": "अथ त्रिगर्ता बहवः परिगृह्य धनं बहु ।\nपरिक्षिप्य हयैः शीघ्रै रथव्रातैश्च भारत\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2140111, "chapter_id": 4024, "verse_number": "८", "content_sanskrit": "गोपालान् प्रत्ययुध्यन्त रणे कृत्वा जये धृतिम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2140112, "chapter_id": 4024, "verse_number": "९", "content_sanskrit": "ते हन्यमाना रथिभिः सादिभिः प्रासधारिभिः ।\nगोपाला गोकुले भक्ता वारयामासुरोजसा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2140113, "chapter_id": 4024, "verse_number": "१०", "content_sanskrit": "परश्वथैश्च मुसलैः भिण्डिपालैश्च मुद्गरैः ।\nगोपालाः कर्षणैश्चित्रैर्जघ्नुरश्वान् समन्ततः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2140114, "chapter_id": 4024, "verse_number": "११", "content_sanskrit": "ते हन्यमानाः सङ्क्रुद्धाः त्रिगर्ता रथयोधिनः ।\nविसृज्य शरवर्षाणि गोपालान् द्रावयन् रणे\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2140115, "chapter_id": 4024, "verse_number": "१२", "content_sanskrit": "ततो युवानः सम्भीताः श्वसन्तो रेणुकुण्ठिताः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2140116, "chapter_id": 4024, "verse_number": "१३", "content_sanskrit": "जवेन महता चैव गोपालाः पुरमाव्रजन्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2140117, "chapter_id": 4024, "verse_number": "१४", "content_sanskrit": "विराटनगरं प्राप्य नरा राजानमब्रुवन्\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2140118, "chapter_id": 4024, "verse_number": "१५", "content_sanskrit": "सभायां राजशार्दूलमासीनं पाण्डवैः सह ।\nशूरैः परिवृतं योधैः कुण्डलाङ्गदधारिभिः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2140119, "chapter_id": 4024, "verse_number": "१६", "content_sanskrit": "सद्भिश्च मन्त्रिभिः सार्धं मन्त्रिभिश्चापि संवृतम् ।\nदृष्ट्वा शीघ्रं तु गोपाला विराटमिदमब्रुवन्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2140120, "chapter_id": 4024, "verse_number": "१७", "content_sanskrit": "अस्मान् युधि विनिर्जित्य परिभूय सबान्धवान् ।\nषष्टिं गवां सहस्राणि त्रिगर्ताः कालयन्ति ते\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2140121, "chapter_id": 4024, "verse_number": "१८", "content_sanskrit": "ताः परीप्स महाराज मा नेशुः पशवस्तव\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2140122, "chapter_id": 4024, "verse_number": "१९", "content_sanskrit": "श्रुत्वा तु वचनं तेषां गोपालानामरिन्दमः ।\nस राजा महतीं सेनां मत्स्यानां समवाहयत्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2140123, "chapter_id": 4024, "verse_number": "२०", "content_sanskrit": "रथनागाश्वकलिलां पत्तिध्वजसमाकुलाम्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2140124, "chapter_id": 4024, "verse_number": "२१", "content_sanskrit": "राजानो राजपुत्राश्च तनुत्राण्यनुभेजिरे ।\nभानुमन्ति निवातानि सूपसेव्यानि भागशः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2140125, "chapter_id": 4024, "verse_number": "२२", "content_sanskrit": "पृथक्काञ्चनसन्नाहान् रथेष्वश्वानयोजयन् ।\nउत्कृत्य पाशान् मौर्वीणां वीराश्चापेष्वयोजयन्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2140126, "chapter_id": 4024, "verse_number": "२३", "content_sanskrit": "दृढमायसगर्भं तु कवचं तप्तकाञ्चनम् ।\nविराटस्य प्रियो भ्राता शतानीकोऽभ्यहारयत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2140127, "chapter_id": 4024, "verse_number": "२४", "content_sanskrit": "सर्वभारसहं वर्म कल्याणपटलं दृढम् ।\nशतानीकादवरजो मदिराश्वोऽभ्यहारयत्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2140128, "chapter_id": 4024, "verse_number": "२५", "content_sanskrit": "दृढमायसगर्भं तु श्वेतं रुग्मपरिष्कृतम् ।\nविराटस्य सुतो ज्येष्ठो वीरः शङ्खोऽभ्यहारयत्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2140129, "chapter_id": 4024, "verse_number": "२६", "content_sanskrit": "शतसूर्यं शतावर्तं शतबिन्दु शताक्षिमत् ।\nअभेद्यकल्पं मत्स्यानां राजा कवचमाहरत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2140130, "chapter_id": 4024, "verse_number": "२७", "content_sanskrit": "ततो नानातनुत्राणि स्वानि स्वान्यत्र क्षत्रियाः ।\nयुयुत्सवोऽभ्यपद्यन्त देवकल्पाः प्रहारिणः\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2140131, "chapter_id": 4024, "verse_number": "२८", "content_sanskrit": "सोपस्करेषु शुभ्रेषु महत्सु समलङ्कृतान् ।\nमहत्काञ्चनसन्नाहान् रथेष्वश्वानयोजयन्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2140132, "chapter_id": 4024, "verse_number": "२९", "content_sanskrit": "सूर्यचन्द्रप्रतीकाशं मणिकाञ्चनभूषितम् ।\nमत्स्यस्योरुप्रमाणं च ध्वजमुच्छ्रियते रथे\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2140133, "chapter_id": 4024, "verse_number": "३०", "content_sanskrit": "ध्वजान् बहुविधाकारान् सौवर्णान् हेममालिनः ।\nयथास्वं क्षत्रियाः शूरा रथेषु समयोजयन्\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2140134, "chapter_id": 4024, "verse_number": "३१", "content_sanskrit": "रथेषु युज्यमानेषु कङ्को राजानमब्रवीत्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2140135, "chapter_id": 4024, "verse_number": "३२", "content_sanskrit": "मयाऽप्यस्त्रं चतुर्मार्गमवाप्तमृषिसत्तमात् ।\nदंसितो रथमास्थाय पदं निर्याम्यहं गवाम्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2140136, "chapter_id": 4024, "verse_number": "३३", "content_sanskrit": "अयं च बलवान् शूरो वललो दृश्यतेऽनघ ।\nगोसङ्ख्यमश्वबन्धं च संयोजय रथेषु वै\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2140137, "chapter_id": 4024, "verse_number": "३४", "content_sanskrit": "नैते न जातु युद्ध्येयुर्गवार्थमिति मे मतिः\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2140138, "chapter_id": 4024, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2140139, "chapter_id": 4024, "verse_number": "३५", "content_sanskrit": "अथ मात्स्योऽब्रवीद् राजा शतानीकं जघन्यजम्\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2140140, "chapter_id": 4024, "verse_number": "३६", "content_sanskrit": "कङ्कश्च वललः सूदो दामग्रन्थिश्च वीर्यवान् ।\nशूराः सुवीराः पुरुषा नागराजवरोपमाः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2140141, "chapter_id": 4024, "verse_number": "३७", "content_sanskrit": "युद्ध्येयुरिति मे बुद्धिर्वर्तते नात्र संशयः\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2140142, "chapter_id": 4024, "verse_number": "३८", "content_sanskrit": "एतेषामपि दीयन्तां रथा ध्वजपताकिनः ।\nकवचानि विचित्राणि सुदृढानि लघूनि च\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2140143, "chapter_id": 4024, "verse_number": "३९", "content_sanskrit": "प्रतिमुञ्चन्तु गात्रेषु दीयन्तामायुधानि च ।\nनेमे जातु न युद्ध्येयुरिति मे धीयते मतिः\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2140144, "chapter_id": 4024, "verse_number": "४०", "content_sanskrit": "वीराङ्गरागाः पुरुषा नागराजकरोपमाः\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2140145, "chapter_id": 4024, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2140146, "chapter_id": 4024, "verse_number": "४१", "content_sanskrit": "तच्छ्रुत्वा नृपतेर्वाक्यं शीघ्रं त्वरितमानसः ।\nशतानीकः स पार्थेभ्यो रथान् राजाज्ञयाऽऽदिशत्\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2140147, "chapter_id": 4024, "verse_number": "४२", "content_sanskrit": "सहदेवाय राज्ञे च भीमाय नकुलाय च\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2140148, "chapter_id": 4024, "verse_number": "४३", "content_sanskrit": "तान् दृष्ट्वा सहसा शूरा राजभक्तिपुरस्सराः ।\nनिर्दिष्टा नरदेवेन रथान् शीघ्रमयोजयन्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2140149, "chapter_id": 4024, "verse_number": "४४", "content_sanskrit": "कवचानि विचित्राणि नवानि च दृढानि च ।\nविराटः प्रादिशद् राजा तेषामक्लिष्टकारिणाम्\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2140150, "chapter_id": 4024, "verse_number": "४५", "content_sanskrit": "तान्यामुच्य शरीरेषु दंसितास्ते महारथाः ।\nतरस्विनश्छन्नरूपाः सर्वशस्त्रविशारदाः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2140151, "chapter_id": 4024, "verse_number": "४६", "content_sanskrit": "रथान् हेमपरिष्कारान् समास्थाय महारथाः ।\nपाण्डवा निर्ययुर्हृष्टा दंसिता राजसत्तम\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2140152, "chapter_id": 4024, "verse_number": "४७", "content_sanskrit": "विराटमन्वयुः पश्चात् सहिताः कुरुपुङ्गवाः ।\nचत्वारो भ्रातरः शूराः पाण्डवाः सत्यविक्रमाः\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2140153, "chapter_id": 4024, "verse_number": "४८", "content_sanskrit": "दीर्घानां च दृढानां च धनुषां ते यथाबलम् ।\nउत्कृत्य पाशान् मौर्वीणां वीराश्चापेष्वयोजयन्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2140154, "chapter_id": 4024, "verse_number": "४९", "content_sanskrit": "ततः सुवाससः सर्वे ते वीराश्चन्दनोक्षिताः ।\nचोदिता नरदेवेन क्षिप्रमश्वानयोजयन्\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2140155, "chapter_id": 4024, "verse_number": "५०", "content_sanskrit": "ते हया हेमसञ्छन्ना बृहन्तः साधुवाहिनः ।\nचोदिताः प्रत्यदृश्यन्त पत्रिणामिव पङ्क्तयः\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2140156, "chapter_id": 4024, "verse_number": "५१", "content_sanskrit": "भीमरूपाश्च मातङ्गाः प्रभिन्नकरटीमुखाः ।\nस्वारूढा युद्धकुशलैर्महामात्राधिरोहिताः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2140157, "chapter_id": 4024, "verse_number": "५२", "content_sanskrit": "क्षरन्त इव जीमूताः सुदन्ताः षष्टिहायनाः ।\nराजानमन्वयुः पश्चात् क्रमन्त इव पर्वताः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2140158, "chapter_id": 4024, "verse_number": "५३", "content_sanskrit": "दृढायुधजनाकीर्णं रथाश्वगजसङ्कुलम् ।\nतद् बलाग्र्यं विराटस्य शक्रस्येव तदा बभौ\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2140159, "chapter_id": 4024, "verse_number": "५४", "content_sanskrit": "तं प्रयान्तं महाराजं निनीषन्तं गवां पदम्\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2140160, "chapter_id": 4024, "verse_number": "५५", "content_sanskrit": "विशारदानां वश्यानां प्रकृष्टानां तदा नृप ।\nविंशतिस्तु सहस्राणि नराणामनुयायिरे\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2140161, "chapter_id": 4024, "verse_number": "५६", "content_sanskrit": "अष्टौ रथसहस्राणि दश नागशतानि च ।\nविंशाच्चाश्वसहस्राणि मत्स्यानां त्वरितं ययुः\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2140162, "chapter_id": 4024, "verse_number": "५७", "content_sanskrit": "तदनीकं विराटस्य शुशुभेऽतीव भारत ।\nवसन्ते बहुपुष्पाढ्यं काननं चित्रितं यथा\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2140163, "chapter_id": 4024, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां विराटपर्वणि द्वात्रिंशोऽध्यायः ॥३२॥ गोग्रहणपर्वणि पञ्चमोऽध्यायः ॥५॥\n* * * * *", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]