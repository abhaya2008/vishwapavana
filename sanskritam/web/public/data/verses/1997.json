[{"id": 2044550, "chapter_id": 1997, "verse_number": "६-४६-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2044551, "chapter_id": 1997, "verse_number": "६-४६-१", "content_sanskrit": "राजञ्शतसहस्राणि तत्रतत्र पदातिनाम् ।\nनिर्मर्यादं प्रयुद्धानि तत्ते वक्ष्यामि भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2044552, "chapter_id": 1997, "verse_number": "६-४६-२", "content_sanskrit": "न पुत्रः पितरं जज्ञे पिता वा पुत्रमौरसम् ।\nन भ्राता भ्रातरं तत्र स्वस्त्रीयं न च मातुलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2044553, "chapter_id": 1997, "verse_number": "६-४६-३", "content_sanskrit": "न मातुलं च स्वस्रीयो न सखायं सखा तथा।\nआविष्टा इव युध्यन्ते पाण्डवाः कुरुभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2044554, "chapter_id": 1997, "verse_number": "६-४६-४", "content_sanskrit": "रथानीकं नरव्याघ्राः केचिदभ्यपतन्रथैः ।\nअभज्यन्त युगैरेव युगानि भरतर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2044555, "chapter_id": 1997, "verse_number": "६-४६-५", "content_sanskrit": "रथेषाश्च रतेषाभिः कूरा रथकूबरैः।\nसंगतैः सहिताः केचित्परस्परजिघांसवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2044556, "chapter_id": 1997, "verse_number": "६-४६-६", "content_sanskrit": "न शेकुश्चलितुं केचित्सन्निपत्य रथा रथैः ।\nप्रभिन्नास्तु महाकायाः सन्निपत्य गजा गजैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2044557, "chapter_id": 1997, "verse_number": "६-४६-७", "content_sanskrit": "बहुधा दारयन्क्रुद्धा विषाणैरितरेतरम्।\nसतोरणपताकैश्च वारणा वरवारणैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2044558, "chapter_id": 1997, "verse_number": "६-४६-८", "content_sanskrit": "अभिसृत्य महाराज वेगवद्भिर्महागजैः ।\nदन्तैरभिहतास्तत्र चुक्रुशुः परमातुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2044559, "chapter_id": 1997, "verse_number": "६-४६-९", "content_sanskrit": "अभिनीताश्च शिक्षाभिस्तोत्राङ्कुशसमाहताः।\nअप्रभिन्नाः प्रभिन्नानां संमुखाभिमुखा ययुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2044560, "chapter_id": 1997, "verse_number": "६-४६-१०", "content_sanskrit": "प्रभिन्नैरपि संसक्ताः केचित्तत्र महागजाः ।\nक्रौञ्चवन्निनदं कृत्वा दुद्रुवुः सर्वतो दिशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2044561, "chapter_id": 1997, "verse_number": "६-४६-११", "content_sanskrit": "सम्यक्प्रणीता नागाश्च प्रभिन्नकरटामुखाः ।\nऋषितोमरनाराचैर्निर्विद्धा वरवारणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2044562, "chapter_id": 1997, "verse_number": "६-४६-१२", "content_sanskrit": "प्रणेदुर्भिन्नमर्माणो निपेतुश्च गतासवः।\nप्राद्रवन्त दिशः केचिन्नदन्तो भैरवान्रवान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2044563, "chapter_id": 1997, "verse_number": "६-४६-१३", "content_sanskrit": "गजानां पादरक्षास्तु व्यूढोरस्काः प्रहारिणः ।\nऋष्टिभिश्च धनुर्भिश्च विमलैश्च परश्वथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2044564, "chapter_id": 1997, "verse_number": "६-४६-१४", "content_sanskrit": "गदाभिर्मुसलैश्चैव भिन्दिपालैः सतोमरैः ।\nआयसैः परिघैश्चैव निस्तिरंशैर्विमलै शितैः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2044565, "chapter_id": 1997, "verse_number": "६-४६-१५", "content_sanskrit": "प्रगृहीतैः सुसंरब्धा द्रवमाणास्ततस्ततः।\nव्यदृश्यन्त महाराज परस्परजिघांसवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2044566, "chapter_id": 1997, "verse_number": "६-४६-१६", "content_sanskrit": "राजमानाश्च निस्त्रिंशाः संसिक्ता नरशोणितैः।\nप्रत्यदृश्यन्त शूराणामन्योन्यमभिधावताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2044567, "chapter_id": 1997, "verse_number": "६-४६-१७", "content_sanskrit": "अवक्षिप्तावधूतानामसीनां वीरबाहुभिः ।\nसंजज्ञे तुमुलः शब्दः पततां परमर्मसु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2044568, "chapter_id": 1997, "verse_number": "६-४६-१८", "content_sanskrit": "गदामुसलरुग्णानां भिन्नानां च वरासिभिः ।\nदन्तिदन्तावभिन्नानां मृदितानां च दन्तिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2044569, "chapter_id": 1997, "verse_number": "६-४६-१९", "content_sanskrit": "तत्र तत्र नरौघाणां क्रोशतामितरेतरम् ।\nशुश्रुवुर्दारुणा वाचः प्रेतानामिव भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2044570, "chapter_id": 1997, "verse_number": "६-४६-२०", "content_sanskrit": "हयैरपि हयारोहाश्चामरापीडधारिभिः ।\nहंसैरिव महावेगैरन्योन्यमभिविद्रुताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2044571, "chapter_id": 1997, "verse_number": "६-४६-२१", "content_sanskrit": "तैर्विमुक्ता महाप्रासा जाम्बूनदविभूषणाः ।\nआशुगा विमलास्तीक्ष्णाः संपेतुर्भुजगोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2044572, "chapter_id": 1997, "verse_number": "६-४६-२२", "content_sanskrit": "अश्वैरग्न्यजवैः केचिदाप्लुत्य महतो रथात् ।\nशिरांस्याददिरे वीरा रथिनामश्वसादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2044573, "chapter_id": 1997, "verse_number": "६-४६-२३", "content_sanskrit": "बहूनपि हयारोहान्भल्लैः सन्नतपर्वभिः ।\nरथी जघान संप्राप्य बाणगोचरमागतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2044574, "chapter_id": 1997, "verse_number": "६-४६-२४", "content_sanskrit": "नवमेघप्रतीकाशाश्चाक्षिप्य तुरगान्गजाः ।\nपादैरेव विमृद्गन्ति मत्ताः कनकभूषणाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2044575, "chapter_id": 1997, "verse_number": "६-४६-२५", "content_sanskrit": "पाठ्यमानेषु कुम्भेषु पार्श्वेष्वपि च वारणाः।\nप्रासैर्विनिहताः केचिद्विनेदुः परमातुराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2044576, "chapter_id": 1997, "verse_number": "६-४६-२६", "content_sanskrit": "साश्वारोहान्हयान्कांश्चिदुन्मथ्य वरवारणाः ।\nसहसा चिक्षिपुस्तत्र संकुले भैरवे सति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2044577, "chapter_id": 1997, "verse_number": "६-४६-२७", "content_sanskrit": "साश्वारोहान्विषाणाग्रैरुत्क्षिप्य तुरगान्गजाः ।\nरथौघानभिमृद्गन्तः सध्वजानभिचक्रमुः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2044578, "chapter_id": 1997, "verse_number": "६-४६-२८", "content_sanskrit": "पुंस्त्वादतिमदत्वाच्च केचित्तत्र महागजाः ।\nसाश्वारोहान्हयाञ्जघ्नुः करैः सचरणैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2044579, "chapter_id": 1997, "verse_number": "६-४६-२९", "content_sanskrit": "अश्वारोहैश्च समरे हस्तिसादिभिरेव च ।\nप्रतिमानेषु गात्रेषु पार्श्वष्वभि च वारणान् ।\nआशुगा विमलास्तीक्ष्णाः संपेतुर्भुजगोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2044580, "chapter_id": 1997, "verse_number": "६-४६-३०", "content_sanskrit": "नराश्वकायान्निर्भिद्य लौहानि कवचानि च।\nनिपेतुर्विमलाः शक्त्यो वीरबाहुभिरर्पिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2044581, "chapter_id": 1997, "verse_number": "६-४६-३१", "content_sanskrit": "महोल्ककाप्रतिमा घोरास्तत्र तत्र विशांपते।\nद्वीपिचर्मावनद्धैश्च व्याघ्रचर्मच्छदैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2044582, "chapter_id": 1997, "verse_number": "६-४६-३२", "content_sanskrit": "विकोशैर्विमलैः खङ्गैरभिजध्नुः परान्रणे ।\nअभिप्लुतमभिक्रुद्धमेकपार्श्वावदारितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2044583, "chapter_id": 1997, "verse_number": "६-४६-३३", "content_sanskrit": "विदर्शयन्तः संपेतुः खङ्गचर्मपरश्वथैः।\nकेचिदाक्षिप्य करिणः साश्वानपि रथान्करैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2044584, "chapter_id": 1997, "verse_number": "६-४६-३४", "content_sanskrit": "विकर्षन्तो दिशः सर्वाः संपेतुः सर्वशब्दगाः।\nशङ्कुभिर्दारिताः केचित्संभिन्नाश्च परश्वथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2044585, "chapter_id": 1997, "verse_number": "६-४६-३५", "content_sanskrit": "हस्तिभिर्मृदिताः केचित्क्षुण्णाश्चान्ये तुरंगमैः ।\nरथनेमिनिकृत्ताश्च निकृत्ताश्च परश्वथैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2044586, "chapter_id": 1997, "verse_number": "६-४६-३६", "content_sanskrit": "व्याक्रोशन्त नरा राजंस्तत्रतत्र स्म बान्धवान्।\nपुत्रानन्ये पितॄनन्ये भ्रातॄंश्च सह बन्धुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2044587, "chapter_id": 1997, "verse_number": "६-४६-३७", "content_sanskrit": "मातुलान्भागिनेयांश्च परानपि च संयुगे ।\nविकीर्णान्त्राः सुबहवो भग्नसक्थाश्च भारत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2044588, "chapter_id": 1997, "verse_number": "६-४६-३८", "content_sanskrit": "बाहुभिश्चापरे छिन्नैः पार्श्वेषु च विदारिताः ।\nक्रन्दन्तः समदृश्यन्त तृषिता जीवितेप्सवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2044589, "chapter_id": 1997, "verse_number": "६-४६-३९", "content_sanskrit": "तृषापरिगताः केचिदल्पसत्वा विशांपते।\nभूमौ निपतिताः सङ्ख्ये मृगयांचक्रिरे जलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2044590, "chapter_id": 1997, "verse_number": "६-४६-४०", "content_sanskrit": "रुधिरौघपरिक्लिन्नाः क्लिश्यमानाश्च भारत ।\nव्यनिन्दन्भृशमात्मानं तव पुत्रांश्च संगतान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2044591, "chapter_id": 1997, "verse_number": "६-४६-४१", "content_sanskrit": "अपरे क्षत्रिकयाः शूराः कृतवैराः परस्परम् ।\nनैव शस्त्रं विमुञ्चन्ति नैव क्रन्दन्ति मारिष ।\nतर्जयन्ति च संहृष्टास्तत्रतत्र परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2044592, "chapter_id": 1997, "verse_number": "६-४६-४२", "content_sanskrit": "आदश्य दशनैश्चापि क्रोधात्स्वरदनच्छदम् ।\nभ्रुकुटीकुटिलैर्वक्रैः प्रेक्षन्ति च परस्परम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2044593, "chapter_id": 1997, "verse_number": "६-४६-४३", "content_sanskrit": "अपरे क्लिश्यमानास्तु शरार्ता व्रणपीडिताः।\nनिष्कूजाः समपद्यन्त दृढसत्वा महाबलाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2044594, "chapter_id": 1997, "verse_number": "६-४६-४४", "content_sanskrit": "अन्ये च विरथाः शूरा रथमन्यस्य संयुगे।\nप्रार्थयाना निपतिताः संक्षुण्णा वरवारणैः ।\nअशोभन्त महाराज सपुष्पा इव किंशुकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2044595, "chapter_id": 1997, "verse_number": "६-४६-४५", "content_sanskrit": "संबभूवुरनीकेषु बहवो भैरवस्वनाः।\nवर्तमाने महाभीमे तस्मिन्वीरवरक्षये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2044596, "chapter_id": 1997, "verse_number": "६-४६-४६", "content_sanskrit": "निजघान पिता पुत्रं पुत्रश्च पितरं रणे।\nस्वस्त्रीयो मातुलं चापि स्वस्रीयं चापि मातुलः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2044597, "chapter_id": 1997, "verse_number": "६-४६-४७", "content_sanskrit": "सखा सखायं च तथा संबन्धी बान्धवं तथा।\nएवं युयुधिरे तत्र कुरवः पाण्डवैः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2044598, "chapter_id": 1997, "verse_number": "६-४६-४८", "content_sanskrit": "वर्तमाने तथा तस्मिन्निर्मर्यादे भयानके ।\nभीष्ममासाद्य पार्थानां वाहिनी समकम्पत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2044599, "chapter_id": 1997, "verse_number": "६-४६-४९", "content_sanskrit": "केतुना पञ्चतारेण तालेन भारतर्षभ ।\nराजतेन महाबाहुरुच्छ्रितेन महारथे ।\nबभौ भीष्मस्तदा राजंश्चन्द्रमा इव मेरुणा ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2044600, "chapter_id": 1997, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भीष्मवधपर्वणि प्रथमदिवसयुद्धे षट्चत्वारिंशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]