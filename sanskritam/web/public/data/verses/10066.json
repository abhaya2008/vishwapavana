[{"id": 6000066000, "chapter_id": 10066, "verse_number": null, "content_sanskrit": "अथ द्वितीयाध्यायः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 6000066001, "chapter_id": 10066, "verse_number": null, "content_sanskrit": "विदुर उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.001.m4a", "display_order": 2}, {"id": 6000066002, "chapter_id": 10066, "verse_number": "४-२-१", "content_sanskrit": "भवे शीलवतां श्रेष्ठे दक्षो दुहितृवत्सलः।\nविद्वेषमकरोत् कस्मादनादृत्यात्मजां सतीम्॥ ४/२/१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.002.m4a", "display_order": 3, "topics": [{"text": "रुद्रदक्षयोर्द्वेषकारणकथनारम्भः", "range": "१"}]}, {"id": 6000066003, "chapter_id": 10066, "verse_number": "४-२-२", "content_sanskrit": "कस्तं चराचरगुरुं निर्वैरं शान्तविग्रहम्।\nआत्मारामं कथं द्वेष्टि जगतो दैवतं महत्॥ ४/२/२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.003.m4a", "display_order": 4, "topics": [{"text": "विश्वसृजां सत्रं प्रति दक्षस्यागमनम्", "range": "२–७"}]}, {"id": 6000066004, "chapter_id": 10066, "verse_number": "४-२-३", "content_sanskrit": "एतदाख्याहि मे ब्रह्मन् जामातुः श्वशुरस्य च।\nविद्वेषस्तु यतः प्राणान् अत्यजद् दुस्त्यजान् सती॥ ४/२/३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.004.m4a", "display_order": 5}, {"id": 6000066005, "chapter_id": 10066, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.005.m4a", "display_order": 6}, {"id": 6000066006, "chapter_id": 10066, "verse_number": "४-२-४", "content_sanskrit": "पुरा विश्वसृजां सत्रे समेताः परमर्षयः।\nतथाऽमरगणाः सर्वे सानुगा मुनयोऽग्नयः॥ ४/२/४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.006.m4a", "display_order": 7}, {"id": 6000066007, "chapter_id": 10066, "verse_number": "४-२-५", "content_sanskrit": "तत्र प्रविष्टं मुनयो दृष्ट्वाऽर्कमिव रोचिषा।\nभ्राजमानं वितिमिरं कुर्वन्तं तन्महत् सदः॥ ४/२/५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.007.m4a", "display_order": 8}, {"id": 6000066008, "chapter_id": 10066, "verse_number": "४-२-६", "content_sanskrit": "उदतिष्ठन् सदस्यास्ते स्वधिष्ण्येभ्यः सहाग्नयः।\nऋते विरिञ्चिं शर्वं च तद्भासा क्षिप्तचेतसः॥ ४/२/६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.008.m4a", "display_order": 9}, {"id": 6000066009, "chapter_id": 10066, "verse_number": "४-२-७", "content_sanskrit": "सदसस्पतिभिर्दक्षो भगवान् साधु सत्कृतः।\nअजं लोकगुरुं नत्वा निषसाद तदाज्ञया॥ ४/२/७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.009.m4a", "display_order": 10}, {"id": 6000066010, "chapter_id": 10066, "verse_number": "४-२-८", "content_sanskrit": "प्राङ् निषण्णं मृडं दृष्ट्वा नामृष्यत् तदनादृतः।\nउवाच वाचं चक्षुर्भ्यामभिवीक्ष्य दहन्निव॥ ४/२/८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.010.m4a", "display_order": 11, "topics": [{"text": "तत्र पूर्वमागतेन तज्जामात्रा रुद्रेण तस्मै प्रत्युत्थानाद्यकरणात् क्रोधेन तं विनिन्द्य शप्त्वा च दक्षस्य बहिर्गमनम्", "range": "८–२०"}]}, {"id": 6000066011, "chapter_id": 10066, "verse_number": null, "content_sanskrit": "दक्ष उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.011.m4a", "display_order": 12}, {"id": 6000066012, "chapter_id": 10066, "verse_number": "४-२-९", "content_sanskrit": "श्रूयतां ब्रह्मर्षयो मे सहसभ्याः सहाग्नयः।\nसाधूनां ब्रुवतो वृत्तं नाज्ञानान्न च मत्सरात्॥ ४/२/९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.012.m4a", "display_order": 13}, {"id": 6000066013, "chapter_id": 10066, "verse_number": "४-२-१०", "content_sanskrit": "अयं तु लोकपालानां यशोघ्नो निरपत्रपः।\nसद्भिराचरितः पन्था येन स्तब्धेन दूषितः॥ ४/२/१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.013.m4a", "display_order": 14}, {"id": 6000066014, "chapter_id": 10066, "verse_number": "४-२-११", "content_sanskrit": "एष मे शिष्यतां प्राप्तो यन्मे दुहितुरग्रहीत्।\nपाणिं विप्राग्निमुखतः सावित्र्या इव साधुवत्॥ ४/२/११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.014.m4a", "display_order": 15}, {"id": 6000066015, "chapter_id": 10066, "verse_number": "४-२-१२", "content_sanskrit": "गृहीत्वा मृगशावाक्ष्याः पाणिं मर्कटलोचनः।\nप्रत्युत्थानाभिवादार्हे वाचाऽप्यकृत नोचितम्॥ ४/२/१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.015.m4a", "display_order": 16}, {"id": 6000066016, "chapter_id": 10066, "verse_number": "४-२-१३", "content_sanskrit": "लुप्तक्रियायाशुचये मानिने भिन्नसेतवे।\nअनिच्छन्नप्यदां बालां शूद्रायेवोशतीं गिरम्॥ ४/२/१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.016.m4a", "display_order": 17}, {"id": 6000066017, "chapter_id": 10066, "verse_number": "४-२-१४", "content_sanskrit": "प्रेतावासेषु घोरेषु घोरैर्भूतगणैर्वृतः।\nअटत्युन्मत्तवन्नग्नो व्युप्तकेशो हसन् रुदन्॥ ४/२/१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.017.m4a", "display_order": 18}, {"id": 6000066018, "chapter_id": 10066, "verse_number": "४-२-१५", "content_sanskrit": "चिताभस्मकृतस्नानः प्रेतास्थिग्रन्थिभूषणः।\nशिवापदेशो ह्यशिवो मत्तो मत्तजनप्रियः॥ ४/२/१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.018.m4a", "display_order": 19}, {"id": 6000066019, "chapter_id": 10066, "verse_number": "४-२-१६", "content_sanskrit": "पतिः प्रमथभूतानां तमोमात्रात्मिकात्मनाम्।\nतस्मा उन्मादनाथाय नष्टशौचाय दुर्हृदे॥ ४/२/१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.019.m4a", "display_order": 20}, {"id": 6000066020, "chapter_id": 10066, "verse_number": "४-२-१७", "content_sanskrit": "दत्ता बत मया साध्वी चोदिते परमेष्ठिना॥ ४/२/१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.020.m4a", "display_order": 21}, {"id": 6000066021, "chapter_id": 10066, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.021.m4a", "display_order": 22}, {"id": 6000066022, "chapter_id": 10066, "verse_number": "४-२-१८", "content_sanskrit": "विनिन्द्यैवं स गिरिशमप्रतीपमवस्थितम्।\nदक्षो ह्यप उपस्पृश्य क्रुद्धः शप्तुं प्रचक्रमे॥ ४/२/१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.022.m4a", "display_order": 23}, {"id": 6000066023, "chapter_id": 10066, "verse_number": "४-२-१९", "content_sanskrit": "अयं तु देवयजन इन्द्रोपेन्द्रादिभिर्भवः।\nयज्ञभागं न लभतां देवैर्देवगणाधमः॥ ४/२/१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.023.m4a", "display_order": 24}, {"id": 6000066024, "chapter_id": 10066, "verse_number": "४-२-२०", "content_sanskrit": "निषिध्यमानः स सदस्यमुख्यैर्दक्षो गिरित्राय विसृज्य शापम्।\nतस्माद् विनिष्क्रम्य विवृद्धमन्युर्जगाम कौरव्य निजं निकेतनम्॥ ४/२/२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.024.m4a", "display_order": 25}, {"id": 6000066025, "chapter_id": 10066, "verse_number": "४-२-२१", "content_sanskrit": "विज्ञाय शापं गिरिशानुगाग्रणीर्नन्दीश्वरो रोषकषायदूषितः।\nदक्षाय शापं विससर्ज दारुणं ये चान्वमोदंस्तदवाच्यतां द्विजाः॥ ४/२/२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.025.m4a", "display_order": 26, "topics": [{"text": "नन्दीश्वरेण दक्षादिब्राह्मणानां प्रतिशापे दत्ते रुद्रेण यज्ञशालातो बहिर्गमनम्", "range": "२१–३६"}]}, {"id": 6000066026, "chapter_id": 10066, "verse_number": null, "content_sanskrit": "नन्दिरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.026.m4a", "display_order": 27}, {"id": 6000066027, "chapter_id": 10066, "verse_number": "४-२-२२", "content_sanskrit": "य एतन्मर्त्यमुद्दिश्य भगवत्यप्रतिद्रुहि।\nद्रुह्यत्यज्ञः पृथग्दृष्टिस्तत्त्वतो विमुखो भवेत्॥ ४/२/२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.027.m4a", "display_order": 28}, {"id": 6000066028, "chapter_id": 10066, "verse_number": "४-२-२३", "content_sanskrit": "गृहेषु कूटधर्मेषु सक्तो ग्राम्यसुखेच्छया।\nकर्मतन्त्रं वितनुताद् वेदवादविपन्नधीः॥ ४/२/२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.028.m4a", "display_order": 29}, {"id": 6000066029, "chapter_id": 10066, "verse_number": "४-२-२४", "content_sanskrit": "बुद्ध्या पराभिध्यायिन्या विस्मृतात्मगतिः पशुः।\nस्‍त्रीकामः सोऽस्तु नितरां दक्षो बस्तमुखोऽचिरात्॥ ४/२/२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.029.m4a", "display_order": 30}, {"id": 6000066030, "chapter_id": 10066, "verse_number": "४-२-२५", "content_sanskrit": "विद्याबुद्धिरविद्यायां कर्ममय्यामसावजः।\nसंसरन्त्विह ये चामुमनु शर्वावमानिनम्॥ ४/२/२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.030.m4a", "display_order": 31}, {"id": 6000066031, "chapter_id": 10066, "verse_number": "४-२-२६", "content_sanskrit": "गिरेः सुतायाः पुष्पिण्या मधुगन्धेन भूरिणा।\nमथ्ना चोन्मथितात्मानः संमुह्यन्तु हरद्विषः॥ ४/२/२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.031.m4a", "display_order": 32}, {"id": 6000066032, "chapter_id": 10066, "verse_number": "४-२-२७", "content_sanskrit": "सर्वभक्षा द्विजा वृत्त्यै धृतविद्यातपोव्रताः।\nवित्तदेहेन्द्रियारामा याचका विचरन्त्विह॥ ४/२/२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.032.m4a", "display_order": 33}, {"id": 6000066033, "chapter_id": 10066, "verse_number": "४-२-२८", "content_sanskrit": "तस्यैवं वदतः शापं श्रुत्वा द्विजकुलाय वै।\nभृगुः प्रत्यसृजच्छापं ब्रह्मदण्डं दुरत्ययम्॥ ४/२/२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.033.m4a", "display_order": 34}, {"id": 6000066034, "chapter_id": 10066, "verse_number": null, "content_sanskrit": "भृगुरुवाच—", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.034.m4a", "display_order": 35}, {"id": 6000066035, "chapter_id": 10066, "verse_number": "४-२-२९", "content_sanskrit": "भवव्रतधरा ये च य एतान् समनुव्रताः।\nपाखण्डिनस्ते भवन्तु सच्छास्‍त्रपरिपन्थिनः॥ ४/२/२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.035.m4a", "display_order": 36}, {"id": 6000066036, "chapter_id": 10066, "verse_number": "४-२-३०", "content_sanskrit": "नष्टशौचा मूढधियो जटाभस्मास्थिधारिणः।\nविशन्तु शिवदीक्षायां यत्र दैवं सुरासवम्॥ ४/२/३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.036.m4a", "display_order": 37}, {"id": 6000066037, "chapter_id": 10066, "verse_number": "४-२-३१", "content_sanskrit": "ब्रह्म च ब्राह्मणांश्चैव ये यूयं परिनिन्दथ।\nसेतुं विधारणं पुंसामतः पाखण्डमाश्रिताः॥ ४/२/३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.037.m4a", "display_order": 38}, {"id": 6000066038, "chapter_id": 10066, "verse_number": "४-२-३२", "content_sanskrit": "एष एव हि लोकानां शिवः पन्थाः सनातनः।\nयं पूर्वे चानुसंतस्थुर्यत्प्रमाणं जनार्दनः॥ ४/२/३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.038.m4a", "display_order": 39}, {"id": 6000066039, "chapter_id": 10066, "verse_number": "४-२-३३", "content_sanskrit": "तद् ब्रह्म परमं शुद्धं सतां वर्त्म सनातनम्।\nविगर्ह्य यात पाखण्डं दैवं वो भूतराट् सदा॥ ४/२/३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.039.m4a", "display_order": 40}, {"id": 6000066040, "chapter_id": 10066, "verse_number": null, "content_sanskrit": "मैत्रेय उवाच —", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.040.m4a", "display_order": 41}, {"id": 6000066041, "chapter_id": 10066, "verse_number": "४-२-३४", "content_sanskrit": "तस्यैवं वदतः शापं भृगोः स भगवान् भवः।\nनिश्चक्राम ततः किंचिद् विमना इव सानुगः॥ ४/२/३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.041.m4a", "display_order": 42}, {"id": 6000066042, "chapter_id": 10066, "verse_number": "४-२-३५", "content_sanskrit": "तेऽपि विश्वसृजः सत्रं सहस्रपरिवत्सरान्।\nसंविधाय महेश्वासा यत्रेज्य ऋषभो हरिः॥ ४/२/३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.042.m4a", "display_order": 43}, {"id": 6000066043, "chapter_id": 10066, "verse_number": "४-२-३६", "content_sanskrit": "आप्लुत्यावभृथं यत्र गङ्गा यमुनयाऽन्विता।\nविरजेनात्मना सर्वे स्वं स्वं धाम ययुस्ततः॥ ४/२/३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": "https://pub-303f7559721c4b40bf6712eb557e350c.r2.dev/Bhagavata_Audio/skandha_04/adhyaya_002/BhP_04.002.043.m4a", "display_order": 44}, {"id": 6000066044, "chapter_id": 10066, "verse_number": null, "content_sanskrit": "॥ इति श्रीमद्भागवते वैयासिक्यां संहितायां चतुर्थस्कन्धे द्वितीयाध्यायः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}]