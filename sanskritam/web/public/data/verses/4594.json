[{"id": 2167372, "chapter_id": 4594, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2167373, "chapter_id": 4594, "verse_number": "१", "content_sanskrit": "श्रुतकर्मा महाराज चित्रसेनं महीपतिम् ।\nआजघान रणे क्रुद्धः पञ्चाशद्भिः शिलीमुखैः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2167374, "chapter_id": 4594, "verse_number": "२", "content_sanskrit": "अभिसारस्तु तं राजन् नवभिर्निशितैः शरैः ।\nश्रुतकर्माणमाहत्य सूतं विव्याध पञ्चभिः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2167375, "chapter_id": 4594, "verse_number": "३", "content_sanskrit": "श्रुतकर्मा ततः क्रुद्धः चित्रसेनं चमूमुखे ।\nनाराचेन सुतीक्ष्णेन मर्मदेशे समार्पयत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2167376, "chapter_id": 4594, "verse_number": "४", "content_sanskrit": "सोऽतिविद्धो महाराज तदा तेन महात्मना ।\nमूर्च्छामपि जगामाशु कश्मलं च समाविशत्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2167377, "chapter_id": 4594, "verse_number": "५", "content_sanskrit": "एतस्मिन्नन्तरे चैव श्रुतकर्मा महायशाः ।\nनवत्या जगतीपालं छादयामास पत्रिभिः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2167378, "chapter_id": 4594, "verse_number": "६", "content_sanskrit": "प्रतिलभ्य ततः सञ्ज्ञां चित्रसेनो महाबलः ।\nधनुश्चिच्छेद भल्लेन तं च विव्याध सप्तभिः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2167379, "chapter_id": 4594, "verse_number": "७", "content_sanskrit": "सोऽन्यत् कार्मुकमादाय वेगघ्नं रुग्मभूषितम् ।\nचित्रसेनं शरैश्चित्रैश्चित्ररूपमथाकरोत्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2167380, "chapter_id": 4594, "verse_number": "८", "content_sanskrit": "स शरैश्चित्रितो राजा चित्रमाल्यधरो युवा ।\nअशोभत महारङ्गे श्वाविच्छललतो यथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2167381, "chapter_id": 4594, "verse_number": "९", "content_sanskrit": "राजा तु श्रुतकर्माणं नाराचेन स्तनान्तरे ।\nबिभेद समरे क्रूरः तिष्ठ तिष्ठेति चाब्रवीत्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2167382, "chapter_id": 4594, "verse_number": "१०", "content_sanskrit": "श्रुतकर्मा तु समरे नाराचेन समर्पितः ।\nसुस्राव रुधिरं तत्र गैरिकाम्बु यथाऽचलः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2167383, "chapter_id": 4594, "verse_number": "११", "content_sanskrit": "ततः स रुधिराक्ताङ्गो रुधिरार्द्रीकृतच्छविः ।\nरराज समरे राजन् सपुष्प इव किंशुकः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2167384, "chapter_id": 4594, "verse_number": "१२", "content_sanskrit": "श्रुतकर्मा महाराज शत्रुणा समभिद्रुतः ।\nशत्रुसंवरणं क्रुद्धो द्विधा चिच्छेद कार्मुकम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2167385, "chapter_id": 4594, "verse_number": "१३", "content_sanskrit": "अथैनं छिन्नधन्वानं नाराचानां शतैस्त्रिभिः ।\nविव्याध भरतश्रेष्ठ श्रुतकर्मा महायशाः\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2167386, "chapter_id": 4594, "verse_number": "१४", "content_sanskrit": "नवत्या जगतीपालं छादयन्नतपर्वभिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2167387, "chapter_id": 4594, "verse_number": "१५", "content_sanskrit": "ततोऽपरेण भल्लेन भृशं तीक्ष्णेन सत्वरः ।\nजहार सशिरस्त्राणं शिरस्तस्य महात्मनः\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2167388, "chapter_id": 4594, "verse_number": "१६", "content_sanskrit": "तच्छिरो न्यपतद् भूमौ चित्रसेनस्य दीप्तिमत् ।\nयदृच्छया यथा चन्द्रः च्युतः स्वर्गान्महीतळे\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2167389, "chapter_id": 4594, "verse_number": "१७", "content_sanskrit": "राजानं निहतं दृष्ट्वा अभिसारास्तु मारिष ।\nअभ्यद्रवन्त वेगेन श्रुतकर्माणमाहवे\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2167390, "chapter_id": 4594, "verse_number": "१८", "content_sanskrit": "ततः क्रुद्धो महेष्वासः तत्सैन्यं समभिद्रवत् ।\nअन्तकाले यथा क्रुद्धः सर्वभूतानि चान्तकः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2167391, "chapter_id": 4594, "verse_number": "१९", "content_sanskrit": "ते वध्यमानाः समरे तव पौत्रेण धन्विना ।\nव्यद्रवन्त दिशस्तूर्णं मृगा व्याघ्रार्दिता इव\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2167392, "chapter_id": 4594, "verse_number": "२०", "content_sanskrit": "तांस्तु विद्रवतो दृष्ट्वा निरुत्साहान् द्विषज्जये ।\nद्रावयन्निषुभिस्तूर्णं श्रुतकर्मा व्यरोचत\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2167393, "chapter_id": 4594, "verse_number": "२१", "content_sanskrit": "प्रतिविन्ध्यस्ततश्चित्रं विद्ध्वा पञ्चभिरायसैः ।\nसारथिं त्रिभिरानर्च्छद् ध्वजमेकेन पत्रिणा\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2167394, "chapter_id": 4594, "verse_number": "२२", "content_sanskrit": "तं चित्रो नवभिर्बाणैर्बाह्वोरुरसि चार्पयत् ।\nस्वर्णपुङ्खैः शिलाधौतैः कङ्कबर्हिणवाजितैः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2167395, "chapter_id": 4594, "verse_number": "२३", "content_sanskrit": "प्रतिविन्ध्यो धनुस्तस्य च्छित्वा भारत सायकैः ।\nपञ्चभिर्निशितैर्बाणैरथैनमभिजघ्निवान्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2167396, "chapter_id": 4594, "verse_number": "२४", "content_sanskrit": "ततः शक्तिं महाराज हेमदण्डां दुरासदाम् ।\nप्राहिणोत् प्रतिविन्ध्याय विचिन्वन्तीमसूनिव\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2167397, "chapter_id": 4594, "verse_number": "२५", "content_sanskrit": "तामापतन्तीं सहसा शक्तिमुल्कामिवाम्बरात् ।\nत्रिधा चिच्छेद समरे प्रतिविन्ध्यो हसन्निव\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2167398, "chapter_id": 4594, "verse_number": "२६", "content_sanskrit": "सा पपात त्रिधा च्छिन्ना प्रतिविन्ध्यशरैः त्रिभिः ।\nयुगान्ते सर्वभूतानि त्रासयन्ती यथाऽशनिः\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2167399, "chapter_id": 4594, "verse_number": "२७", "content_sanskrit": "शक्तिं विनिहतां दृष्ट्वा चित्रो गृह्य महागदाम् ।\nप्रतिविन्ध्याय चिक्षेप रुग्मपट्टैर्विभूषिताम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2167400, "chapter_id": 4594, "verse_number": "२८", "content_sanskrit": "सा हत्वा सहसा सूतं हयांस्तस्य महात्मनः ।\nरथं प्रमृद्य वेगेन धरणीमन्वपद्यत\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2167401, "chapter_id": 4594, "verse_number": "२९", "content_sanskrit": "प्रतिविन्ध्यस्ततः क्रुद्धो रथादाप्लुत्य भारत ।\nशक्तिं चिक्षेप चित्राय स्वर्णदण्डामलङ्कृताम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2167402, "chapter_id": 4594, "verse_number": "३०", "content_sanskrit": "तामापतन्तीं जग्राह चित्रो राजन् महामनाः ।\nततस्तामेव चिक्षेप प्रतिविन्ध्याय पार्थिवः\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2167403, "chapter_id": 4594, "verse_number": "३१", "content_sanskrit": "सा समासाद्य तं शूरं प्रतिविन्ध्यं महाप्रभा ।\nनिर्भिद्य दक्षिणं बाहुं निपपात महीतळे\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2167404, "chapter_id": 4594, "verse_number": "३२", "content_sanskrit": "पतिताऽभासयच्चैव तं देशमशनिर्यथा\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2167405, "chapter_id": 4594, "verse_number": "३३", "content_sanskrit": "प्रतिविन्ध्यस्ततो राजन् तोमरं स्वर्णभूषितम् ।\nप्रेषयामास सङ्क्रुद्धश्चित्रस्य वधकाङ्क्षया\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2167406, "chapter_id": 4594, "verse_number": "३४", "content_sanskrit": "स तस्य देहावरणं भित्त्वा हृदयमेव च ।\nजगाम धरणीं तूर्णं महोरग इवाशयम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2167407, "chapter_id": 4594, "verse_number": "३५", "content_sanskrit": "स पपात तदा राजा तोमरेण समाहतः ।\nप्रसार्य विपुलौ बाहू महापरिघसन्निभौ\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2167408, "chapter_id": 4594, "verse_number": "३६", "content_sanskrit": "चित्रं सम्प्रेक्ष्य निहतं तावका रणशोभिनम् ।\nअभ्यधावन्त वेगेन प्रतिविन्ध्यं समन्ततः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2167409, "chapter_id": 4594, "verse_number": "३७", "content_sanskrit": "सृजन्तो विविधान् बाणान् शतघ्नीश्च सकिङ्किणीः ।\nतमेकं छादयामासुः सूर्यमभ्रगणा इव\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2167410, "chapter_id": 4594, "verse_number": "३८", "content_sanskrit": "तान् विव्याध महाबाहुः शरजालैर्महाहवे ।\nव्यद्रावयत् तव चमूं वज्रहस्त इवासुरान्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2167411, "chapter_id": 4594, "verse_number": "३९", "content_sanskrit": "ते वध्यमानाः समरे तावकाः पाण्डवैर्नृप ।\nविप्रकीर्यन्त सहसा वातनुन्ना घना इव\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2167412, "chapter_id": 4594, "verse_number": "४०", "content_sanskrit": "विद्रुते तु बले तस्मिन् वध्यमाने समन्ततः ।\nद्रौणिरेकोऽद्रवत् तूर्णं भीमसेनं महाबलम्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2167413, "chapter_id": 4594, "verse_number": "४१", "content_sanskrit": "तयोः समागमो घोरो बभूव समरे नृप ।\nयथा दैवासुरे युद्धे वृत्रवासवयोरिव\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2167414, "chapter_id": 4594, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां कर्णपर्वणि\nचित्र(चित्रसेनयोः)वधो नाम चतुर्दशोऽध्यायः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}]