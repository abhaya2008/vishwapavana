[{"id": 2102323, "chapter_id": 3212, "verse_number": "१४-६८-१", "content_sanskrit": "वैशम्पायन उवाच।\nएवमुक्तस्तु राजेन्द्र केशिहा दुःखमुर्च्छितः।\nतथेति व्याजहारोच्चैर्ह्लादयन्निव तं जनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2102324, "chapter_id": 3212, "verse_number": "१४-६८-२", "content_sanskrit": "वाक्येनैतेन हि तदा तं जनं पुरुषर्षभः।\nह्लादयामास स विभुर्घर्मार्तं सलिलैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2102325, "chapter_id": 3212, "verse_number": "१४-६८-३", "content_sanskrit": "ततः स प्राविशत्तूर्णं जन्मवेश्म पितुस्तव।\nअर्चितं पुरुषव्याघ्र सितैर्माल्यैर्यथाविधि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2102326, "chapter_id": 3212, "verse_number": "१४-६८-४", "content_sanskrit": "अपां कुम्भैः सुपूर्णैश्च विन्यस्तैः सर्वतोदिशम्।\nघृतेन तिन्दुकालातैः सर्षपैश्च महाभुज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2102327, "chapter_id": 3212, "verse_number": "१४-६८-५", "content_sanskrit": "अस्त्रैश्च विमलैर्न्यस्तैः पावकैश्च समन्ततः।\nवृद्धाभिश्चापि रामाभिः परिवारार्थमावृतः।\nदक्षैश्च परितो धीर भिषग्भिः कुशलैस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2102328, "chapter_id": 3212, "verse_number": "१४-६८-६", "content_sanskrit": "ददर्श च स तेजस्वी रक्षोघ्रान्यपि सर्वशः।\nद्रव्याणि स्थापितानि स्म विधिवत्कुशलैर्जनैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2102329, "chapter_id": 3212, "verse_number": "१४-६८-७", "content_sanskrit": "तथायुक्तं च तद्दृष्ट्वा जन्मवेश्म पितुस्तव।\nहृष्टोऽभवद्धृषीकेशः साधुसाध्विति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2102330, "chapter_id": 3212, "verse_number": "१४-६८-८", "content_sanskrit": "तथा ब्रुवति वार्ष्णेये प्रहृष्टवदने तदा।\nद्रौपदी त्वरिता गत्वा वैराटीं वाक्यमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2102331, "chapter_id": 3212, "verse_number": "१४-६८-९", "content_sanskrit": "अयमायाति ते भर्तुर्मातुलो मधुसूदनः।\nपुराणर्षिरचिन्त्यात्मा समीपमपराजितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2102332, "chapter_id": 3212, "verse_number": "१४-६८-१०", "content_sanskrit": "साऽपि बाष्पकलां वाचं निगृह्याश्रूपि चैव ह।\nअसंवीताऽभवद्देवी देववत्कृष्णमीयुषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2102333, "chapter_id": 3212, "verse_number": "१४-६८-११", "content_sanskrit": "सा तथा दूयमानेन हृदयेन तपस्विनी।\nदृष्ट्वा गोविन्दमायान्तं कृपणं पर्यदेवयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2102334, "chapter_id": 3212, "verse_number": "१४-६८-१२", "content_sanskrit": "पुण्डरीकाक्ष पश्यावां बालेन हि विनाकृतौ।\nअभिमन्युं च मां चैव हठात्तुल्यं जनार्दन॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2102335, "chapter_id": 3212, "verse_number": "१४-६८-१३", "content_sanskrit": "वार्ष्णेयमधुहन्वीर शिरसा त्वां प्रसादये।\nद्रोणपुत्रास्त्रनिर्दग्धं जीवयैनं ममात्मजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2102336, "chapter_id": 3212, "verse_number": "१४-६८-१४", "content_sanskrit": "यदि स्म धर्मराज्ञा वा भीमसेनेन वा पुनः।\nत्वया वा पुण्डरीकाक्ष वाक्यमुक्तमिदं भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2102337, "chapter_id": 3212, "verse_number": "१४-६८-१५", "content_sanskrit": "अजानतीमिषीकेयं जनित्रीं हन्त्विति प्रभो।\nअहमेव विनष्टा स्यां नायमेवं गतो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2102338, "chapter_id": 3212, "verse_number": "१४-६८-१६", "content_sanskrit": "गर्भस्थस्यास्य बालस्य ब्रह्मास्त्रेण निपातनम्।\nकृत्वा नृशंसं दुर्बुद्धिर्द्रौणिः किं फलमश्नुते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2102339, "chapter_id": 3212, "verse_number": "१४-६८-१७", "content_sanskrit": "सा त्वां प्रसाद्य शिरसा याचे शत्रुनिबर्हण।\nप्राणांस्त्यक्ष्यामि गोविन्द नायं संजीवते यदि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2102340, "chapter_id": 3212, "verse_number": "१४-६८-१८", "content_sanskrit": "अस्मिन्हि बहवः साधो ये ममासन्मनोरथाः।\nते द्रोणपुत्रेण हताः किंनु जीवामि केशव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2102341, "chapter_id": 3212, "verse_number": "१४-६८-१९", "content_sanskrit": "आसीन्मम मतिः कृष्ण पूर्णोत्सङ्गा जनार्दन।\nअभिवादयिष्ये हृष्टेति तदिदं वितथीकृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2102342, "chapter_id": 3212, "verse_number": "१४-६८-२०", "content_sanskrit": "चपलाक्षस्य दायादे मृतेऽस्मिन्पुरुषर्षभ।\nविफला मे कृताः कृष्ण हृदि सर्वे मनोरथाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2102343, "chapter_id": 3212, "verse_number": "१४-६८-२१", "content_sanskrit": "चपलाक्षः किलातीव प्रियस्ते मधुसूदन।\nसुतं पश्य त्वमस्यैनं ब्रह्मास्त्रेण निपातितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2102344, "chapter_id": 3212, "verse_number": "१४-६८-२२", "content_sanskrit": "कृतघ्नोऽयं नृशंसोऽयं यथाऽस्य जनकस्तथा।\nयः पाण्डवीं श्रियं त्यक्त्वा गतोऽद्य यमसादनं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2102345, "chapter_id": 3212, "verse_number": "१४-६८-२३", "content_sanskrit": "मया चैतत्प्रतिज्ञातं रणमूर्धनि केशव।\nअभिमन्यौ हते वीर त्वामेष्याम्यचिरादिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2102346, "chapter_id": 3212, "verse_number": "१४-६८-२४", "content_sanskrit": "तच्च नाकरवं कृष्ण नृशंसा जीवितप्रिया।\nइदानीं मां गतां तत्र किंनु वक्ष्यति फाल्गुनिः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2102347, "chapter_id": 3212, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आश्वमेधिकपर्वणि अनुगीतापर्वणि अष्टषष्टितमोऽध्यायः॥ ६८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}]