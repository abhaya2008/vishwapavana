[{"id": 2030662, "chapter_id": 1671, "verse_number": "३-३०९-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2030663, "chapter_id": 1671, "verse_number": "३-३०९-१", "content_sanskrit": "ततो गर्भः समभवत्पृथायाः पृथिवीपते।\nशुक्ले दशोत्तरे पक्षे तारापतिरिवाम्बरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2030664, "chapter_id": 1671, "verse_number": "३-३०९-२", "content_sanskrit": "सा बान्धवभयाद्बाला गर्भं तं विनिगूहती।\nधारयामास सुश्रोणी न चैनां बुबुधे जनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2030665, "chapter_id": 1671, "verse_number": "३-३०९-३", "content_sanskrit": "न हि तां वेद नार्यन्या काचिद्धात्रेयिकामृते।\nकन्यापुरगतां बालां निपुणां परिरक्षणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2030666, "chapter_id": 1671, "verse_number": "३-३०९-४", "content_sanskrit": "ततः कालेन सा गर्भं सुषुवे वरवर्णिनी।\nकन्यैव तस्य देवस्य प्रसादादमरप्रभम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2030667, "chapter_id": 1671, "verse_number": "३-३०९-५", "content_sanskrit": "तथैवाबद्धकवचं कनकोज्ज्वलकुण्डलम्।\nहर्यक्षं वृषभस्कन्धं यथास्य पितरं तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2030668, "chapter_id": 1671, "verse_number": "३-३०९-६", "content_sanskrit": "जातमात्रं च तं गर्भं धात्र्या संमन्त्र्य भामिनी।\n`उत्स्रष्टुकामा तं गर्भं कारयामास भारत।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2030669, "chapter_id": 1671, "verse_number": "३-३०९-७", "content_sanskrit": "मञ्जूषां शिल्पिभिस्तूर्णं सुनद्धां सुप्रतिष्ठिताम् ॥\nप्लवैर्बहुविधैर्बद्धां प्लवनार्थं जले नृप।\nअजिनैर्मृदुभिश्चैवं संस्तीर्णशयनां तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2030670, "chapter_id": 1671, "verse_number": "३-३०९-८", "content_sanskrit": "मञ्जूषायां समाधाय स्वास्तीर्णायां समन्ततः।\nमधूच्चिष्टस्थितायां तं सुखायां रुदती तथा।\nश्लक्ष्णायां सुपिधानायामश्वनद्यामवासृजत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2030671, "chapter_id": 1671, "verse_number": "३-३०९-९", "content_sanskrit": "जानती चाप्यकर्तव्यं कन्याया गर्भधारणम्।\nपुत्रस्नेहेन सा राजन्करुणं पर्यदेवयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2030672, "chapter_id": 1671, "verse_number": "३-३०९-१०", "content_sanskrit": "समुत्सृजन्ती मञ्जूपामश्वनद्यां तदा जले।\nउवाच रुदतीकुन्ती यानि वाक्यानि तच्छृणु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2030673, "chapter_id": 1671, "verse_number": "३-३०९-११", "content_sanskrit": "स्वस्ति तेऽस्त्वान्तरिक्षेभ्यः पार्थिवेभ्यश्च पुत्रक।\nदिव्येभ्यश्चैव भूतेभ्यस्तथा तोयचराश्च ये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2030674, "chapter_id": 1671, "verse_number": "३-३०९-१२", "content_sanskrit": "शिवास्ते सन्तु पन्थानो मा च ते परिपन्थिनः।\nआगताश्च तथा पुत्र भवन्त्यद्रोहचेतसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2030675, "chapter_id": 1671, "verse_number": "३-३०९-१३", "content_sanskrit": "पातु त्वां वरुणो राजा सलिले सलिलेश्वरः।\nअन्तरिक्षेऽन्तरिक्षस्थः पवनः सर्वगस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2030676, "chapter_id": 1671, "verse_number": "३-३०९-१४", "content_sanskrit": "पिता त्वां पातु सर्वत्र तपनस्तपतांवरः।\nयेन दत्तोसि मे पुत्र दिव्येन विधिना किल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2030677, "chapter_id": 1671, "verse_number": "३-३०९-१५", "content_sanskrit": "आदित्या वसवो रुद्राः साध्या विश्वे च देवताः।\nमरुतश्च सहेन्द्रेण दिशश्च सदिदीश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2030678, "chapter_id": 1671, "verse_number": "३-३०९-१६", "content_sanskrit": "रक्षन्तु त्वां सुराः सर्वे समेषु विषमेषु च।\nवेत्स्यामि त्वांविदेशेपि कवचेनाभिसूचितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2030679, "chapter_id": 1671, "verse_number": "३-३०९-१७", "content_sanskrit": "धन्यस्ते पुत्र जनरको देवो भानुर्विभावसुः।\nस्त्वां द्रक्ष्यति दिव्येन चक्षुषा वाहिनीगतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2030680, "chapter_id": 1671, "verse_number": "३-३०९-१८", "content_sanskrit": "धन्या सा प्रमदा या त्वां पुत्रत्वे कल्पयिष्यति।\nयस्यास्त्वं तृषितः पुत्र स्तनं पास्यसि देवज ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2030681, "chapter_id": 1671, "verse_number": "३-३०९-१९", "content_sanskrit": "कोनु स्वप्नस्तया दृष्टो या त्वामादित्यवर्चसम्।\nदिव्यवर्मसमायुक्तं दिव्यकृण्डलभूषितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2030682, "chapter_id": 1671, "verse_number": "३-३०९-२०", "content_sanskrit": "पद्मायतविशालाक्षं पद्मताम्रदलोज्ज्वलम्।\nसुललाटं सुकेशान्तं पुत्रत्वे कल्पयिष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2030683, "chapter_id": 1671, "verse_number": "३-३०९-२१", "content_sanskrit": "धन्या द्रक्ष्यन्ति पुत्र त्वां भूमौ संसर्पमाणकम्।\nअव्यक्तकलवाक्यानि वदन्तं रेणुगुण्ठितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2030684, "chapter_id": 1671, "verse_number": "३-३०९-२२", "content_sanskrit": "धन्या द्रक्ष्यन्ति पुत्र त्वां पुनर्यौवनगोचरम्।\nहिमवद्वनसंभूतं सिंहं केसरिणं यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2030685, "chapter_id": 1671, "verse_number": "३-३०९-२३", "content_sanskrit": "एवं बहुविधं राजन्विलप्य करुणं पृथा।\nअवामृजतमज्जूषामश्वनद्यां तदा जले ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2030686, "chapter_id": 1671, "verse_number": "३-३०९-२४", "content_sanskrit": "रुदती पुत्रशोकार्ता निशीथे कमलेक्षणा।\nधात्र्या सह पृथा राजन्पुत्रदर्शनलालसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2030687, "chapter_id": 1671, "verse_number": "३-३०९-२५", "content_sanskrit": "विसर्जयित्वा मञ्जूषां संबोधनभयात्पितुः।\nविवेश राजभवनं पुनः शोकातुरा ततः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2030688, "chapter_id": 1671, "verse_number": "३-३०९-२६", "content_sanskrit": "मञ्जूषा त्वश्वनद्याः सा ययौ चर्मयण्वतीं नदीम्।\nचर्मण्वत्याश्चयमुनां ततो गङ्गां जगाम ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2030689, "chapter_id": 1671, "verse_number": "३-३०९-२७", "content_sanskrit": "गङ्गायाः सूतविषयं चम्पामनुययौ पुरीम्।\nस मञ्जूषागतो गर्भस्तरङ्गैरुह्यमानकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2030690, "chapter_id": 1671, "verse_number": "३-३०९-२८", "content_sanskrit": "अमृतादुत्थितं दिव्यं तनुवर्म सकुण्डलम्।\nधारयामास तं गर्भं दैवं च विधिनिर्मितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2030691, "chapter_id": 1671, "verse_number": "३-३०९-२९", "content_sanskrit": "एतद्गुह्यं महाराज सूर्यस्यासीन्महात्मनः।\nस सूर्यसंभवो गर्भः कुन्त्या गर्भेण धारितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2030692, "chapter_id": 1671, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि कुण्डलाहरणपर्वणि नवाधिकत्रिशततमोऽध्यायः ॥ ३०९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}]