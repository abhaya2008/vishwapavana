[{"id": 7001756000, "chapter_id": 21756, "verse_number": "२-१७-१", "content_sanskrit": "पुत्र उवाच ।\nतस्मादीर्ष्यां परित्यज्य मोहिनीमनुभोजय ।\nन मातरीदृशो धर्मो लोकेषु त्रिषु लभ्यते ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001756001, "chapter_id": 21756, "verse_number": "२-१७-२", "content_sanskrit": "स्वहस्तेन प्रियां भर्तुर्भार्यां या तु प्रभोजयेत् ।\nसपत्नीं तु सपत्नी हि किंचिदन्नं ददाति च ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001756002, "chapter_id": 21756, "verse_number": "२-१७-३", "content_sanskrit": "तदनंतं भवेद्देवि मातरित्याह नाभिजः ।\nकुरु वाक्यं मयोक्तं हि स्वामिनि त्वं प्रसीद मे ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001756003, "chapter_id": 21756, "verse_number": "२-१७-४", "content_sanskrit": "तातस्य सौख्यं कर्तव्यमावाभ्यां वरवर्णिनी ।\nभवेत्पापक्षयः सम्यक् स्वर्गप्राप्तिस्तथाक्षया ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001756004, "chapter_id": 21756, "verse_number": "२-१७-५", "content_sanskrit": "पुत्रस्य वचनं श्रुत्वा देवी संध्यावली तदा ।\nअभिमंत्र्य परिष्वज्य तनयं सा पुनः पुनः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001756005, "chapter_id": 21756, "verse_number": "२-१७-६", "content_sanskrit": "मूर्ध्नि चैनमुपाघ्राय वचनं चेदमब्रवीत् ।\nकरिष्ये वचनं पुत्र त्वदीयं धर्मसंयुतम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001756006, "chapter_id": 21756, "verse_number": "२-१७-७", "content_sanskrit": "इर्ष्यां मानं परित्यज्य भोजयिष्यामि मोहिनीम् ।\nशतपुत्रा ह्यहं पुत्र त्वयैकेन सुतेन हि ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001756007, "chapter_id": 21756, "verse_number": "२-१७-८", "content_sanskrit": "नियमैर्बहुभिर्जातो देहक्लेशकरैर्भवान् ।\nव्रतराजेन चीर्णेन प्राप्तस्त्वमचिरात्सुतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001756008, "chapter_id": 21756, "verse_number": "२-१७-९", "content_sanskrit": "नहीदृशं व्रतं लोके फलदायि प्रदृश्यते ।\nसद्यः प्रत्ययकारीदं महापातकनाशनम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001756009, "chapter_id": 21756, "verse_number": "२-१७-१०", "content_sanskrit": "किं जातैर्बहुभिः पुत्रैः शोकसंतापकारकैः ।\nवरमेकः कुलालंबी यत्र विश्रमते कुलम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001756010, "chapter_id": 21756, "verse_number": "२-१७-११", "content_sanskrit": "त्रैलोक्यादुपरिष्ठाहं त्वां प्राप्य जठरे स्थितम् ।\nधन्यानि तानि शूलानि यैर्जातस्त्वं सुतोऽनघ ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001756011, "chapter_id": 21756, "verse_number": "२-१७-१२", "content_sanskrit": "सप्तद्वीपपतिः शूरः पितुर्वचनकारकः ।\nआह्लादयति यस्तातं जननीं वापि पुत्रकः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001756012, "chapter_id": 21756, "verse_number": "२-१७-१३", "content_sanskrit": "तं पुत्रं कवयः प्राहुर्वाचाख्यमपरं सुतम् ।\nएवमुक्त्वा तु वचनं देवी संध्यावली तदा ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001756013, "chapter_id": 21756, "verse_number": "२-१७-१४", "content_sanskrit": "वीक्षां चक्रेऽथ भांडानि षड्रसस्य तु हेतवे ।\nतस्या वीक्षणमात्रेण परिपूर्णानि भूपते ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001756014, "chapter_id": 21756, "verse_number": "२-१७-१५", "content_sanskrit": "षड्रस्य सुखोष्णस्य मोहिनीभोजनेच्छया ।\nअमृतस्वादुकल्पस्य जनस्य तु महीपते ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001756015, "chapter_id": 21756, "verse_number": "२-१७-१६", "content_sanskrit": "ततो दर्वीं समादाय कांचनीं रत्नसंयुताम् ।\nपरिवेषयदव्यग्रा मोडिन्याश्चारुहासिनी ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001756016, "chapter_id": 21756, "verse_number": "२-१७-१७", "content_sanskrit": "कांचने भाजने श्लक्ष्णे मानभोजनवेष्टिते ।\nशनैः शनैश्च बुभुजे इष्टमन्नं सुसंस्कृतम् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001756017, "chapter_id": 21756, "verse_number": "२-१७-१८", "content_sanskrit": "उपविश्यासने देवी शातकौभमये शुभे ।\nवीज्यमाना वरारोहा व्याजनेन सुगीतिना ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001756018, "chapter_id": 21756, "verse_number": "२-१७-१९", "content_sanskrit": "धर्मांगदगृही तेन शिखिपुच्छभवेन तु ।\nसा भुक्ता ब्रह्मतनया तदन्नममृतोपमम् ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001756019, "chapter_id": 21756, "verse_number": "२-१७-२०", "content_sanskrit": "चतुर्गुणेन शीतेन कृत्वा शौचमथात्मनः ।\nजगृहे पुत्रदत्तं तु तांबूलं तत्सुगंधिमत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001756020, "chapter_id": 21756, "verse_number": "२-१७-२१", "content_sanskrit": "वरचंदनयुक्तेन हस्तेन वरवर्णिनी ।\nततः प्रहस्य शनकैः प्राह संध्यावलीं नृप ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001756021, "chapter_id": 21756, "verse_number": "२-१७-२२", "content_sanskrit": "जननी किं तु देवि त्वं वृषांगदनृपस्य तु ।\nन मया हि परिज्ञाता श्रमस्वेदितया शुभे ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001756022, "chapter_id": 21756, "verse_number": "२-१७-२३", "content_sanskrit": "वदत्येवं ब्रह्मसुता यावत्संध्यावलीं नप ।\nतावत्प्रणम्य नृपतेः पुत्रो वचनमब्रवीत् ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001756023, "chapter_id": 21756, "verse_number": "२-१७-२४", "content_sanskrit": "उदरे ह्यनया देव्या धृतः संवत्सरत्रयम् ।\nतव भर्तुः प्रसादेन वृद्धिं संप्राप्तवानहम् ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001756024, "chapter_id": 21756, "verse_number": "२-१७-२५", "content_sanskrit": "संत्यनेकानि मातॄणां शतानि मम सुंदरि ।\nअस्याः पीतं पयो भूरि कुचयोः स्नेहसंप्लुतम् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001756025, "chapter_id": 21756, "verse_number": "२-१७-२६", "content_sanskrit": "अनया सा रुजा तीव्रा विधृता प्रायशो जरा ।\nइयं मां जनयित्वैव जाता शिथिलबंधना ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001756026, "chapter_id": 21756, "verse_number": "२-१७-२७", "content_sanskrit": "तन्नास्ति त्रिषु लोकेषु यद्दत्वा चानृणो भवेत् ।\nमातुः पुत्रस्य चार्वंगि सत्यमेतन्मयेरितम् ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001756027, "chapter_id": 21756, "verse_number": "२-१७-२८", "content_sanskrit": "सोऽहं धन्यतरो लोके नास्ति मत्तोऽधिकः पुमान् ।\nउत्संगे वर्तयिष्यामि मातृसंघस्य नित्यशः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001756028, "chapter_id": 21756, "verse_number": "२-१७-२९", "content_sanskrit": "नोत्संगे चेज्जनन्या हि तनयो विशति क्वचित् ।\nमातृसौख्यं न जानाति कुमारी भर्तृजं यथा ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001756029, "chapter_id": 21756, "verse_number": "२-१७-३०", "content_sanskrit": "मातुरुत्संगमारूढः पुत्रो दर्पान्वितो भवेत् ।\nहारमुत्तमदेहस्थं हस्तेनाहर्तुमिच्छति ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001756030, "chapter_id": 21756, "verse_number": "२-१७-३१", "content_sanskrit": "पाल्यमानो जनन्या हि पितृहीनोऽपि दर्पितः ।\nसमीहते जगद्धर्तुं सवीर्यं मातृजं पयः ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001756031, "chapter_id": 21756, "verse_number": "२-१७-३२", "content_sanskrit": "एतज्जठरसंसर्गि भवत्युत्संगशंकितः ।\nअस्याश्चैवापराणां च विशेषो यदि मे न चेत् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001756032, "chapter_id": 21756, "verse_number": "२-१७-३३", "content_sanskrit": "तेन सत्येन मे तातो जीवताच्छरदां शतम् ।\nएवं ब्रुवाणे तनये मोहिनी विस्मयं गता ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001756033, "chapter_id": 21756, "verse_number": "२-१७-३४", "content_sanskrit": "कथमस्य प्रहर्तव्यं मया निर्घृणशीलया ।\nविनीतस्य ह्यपापस्य औचित्यं पापिनो गृहे ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001756034, "chapter_id": 21756, "verse_number": "२-१७-३५", "content_sanskrit": "पितुः शुश्रूषणं यस्य न तस्य सदृशं क्षितौ ।\nएवं गुणाधिकस्याहं कर्तुं कर्म जुगुप्सिताम् ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001756035, "chapter_id": 21756, "verse_number": "२-१७-३६", "content_sanskrit": "पुत्रस्य धर्मशीलस्य भूत्त्वा तु जननी क्षितौ ।\nएवं विमृश्य बहुधा मोहिनी लोकसुंदरी ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001756036, "chapter_id": 21756, "verse_number": "२-१७-३७", "content_sanskrit": "उवाच तनयं बाला शीघ्रमानय मे पतिम् ।\nन शक्नोमि विना तेन मुहूर्तमपि वर्तितुम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001756037, "chapter_id": 21756, "verse_number": "२-१७-३८", "content_sanskrit": "ततः स त्वरितं गत्वा प्रणम्य पितरं नृप ।\nकनिष्ठा जननी तात शीघ्रं त्वां द्रष्टुमिच्छति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001756038, "chapter_id": 21756, "verse_number": "२-१७-३९", "content_sanskrit": "प्रसादः क्रियतां तस्याः पूज्यतां ब्रह्मणः सुता ।\nपुत्रवाक्येन नृपतिरतत्क्षणाद्गंतुमुद्यतः ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001756039, "chapter_id": 21756, "verse_number": "२-१७-४०", "content_sanskrit": "प्रहृष्टवदनो भूत्वा संध्यावल्या निवेशनम् ।\nसंप्रविश्य गृहे राजा ददर्श शयनस्थिताम् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001756040, "chapter_id": 21756, "verse_number": "२-१७-४१", "content_sanskrit": "मोहिनीं मोहसंयुक्तां तप्तकांचनसप्रभाम् ।\nउपास्य मानां प्रियया संध्यावल्या शनैः शनैः ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001756041, "chapter_id": 21756, "verse_number": "२-१७-४२", "content_sanskrit": "पुत्रवाक्यात्परित्यज्य क्रोधं सापत्न्यजं तथा ।\nदृष्ट्वा रुक्मांगदं प्राप्तं शयने मोह्य सुंदरी ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001756042, "chapter_id": 21756, "verse_number": "२-१७-४३", "content_sanskrit": "प्रहृष्टवदना प्राह राजानं भूरिदक्षिणम् ।\nइहोपविश्यतां कांत पर्यंके मृदुतूलके ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001756043, "chapter_id": 21756, "verse_number": "२-१७-४४", "content_sanskrit": "सर्वं निरीक्षितं भूप राज्यतन्त्रं त्वया चिरम् ।\nअद्यापि नहि ते वांछा राज्ये परिनिवर्तते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001756044, "chapter_id": 21756, "verse_number": "२-१७-४५", "content_sanskrit": "मन्ये दुष्कृतिनं भूप त्वामत्र धरणीतले ।\nयः समर्थं सुतं ज्ञात्वा स्वयं पश्येन्नृपश्रियम् ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001756045, "chapter_id": 21756, "verse_number": "२-१७-४६", "content_sanskrit": "तस्मात्त्वत्तोऽधिको नास्ति दुःखी लोकेषु कश्चन ।\nसुपुत्राणां पितॄणां हि सुखं याति क्षणं नृप ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001756046, "chapter_id": 21756, "verse_number": "२-१७-४७", "content_sanskrit": "दुःखेन पापभोक्तॄणां विषयासक्तचेतसाम् ।\nसर्वाश्च प्रकृती राजंस्तवेष्टाः पूर्णपुण्यजाः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001756047, "chapter_id": 21756, "verse_number": "२-१७-४८", "content_sanskrit": "धर्मांगदे पालयाने कथं त्वं वीक्षसेऽधुना ।\nपरित्यज्य प्रियासौख्यं कीनाश इव दुर्बलः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001756048, "chapter_id": 21756, "verse_number": "२-१७-४९", "content_sanskrit": "यदि पालयसे राज्यं मया किं ते प्रयोजनम् ।\nनिष्प्रयोजनमानीता क्षीरसागरमस्तकात् ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001756049, "chapter_id": 21756, "verse_number": "२-१७-५०", "content_sanskrit": "विड्भोज्या हि भविष्यामि पक्षिणामामिषं यथा ।\nयो भार्यां यौवनोपेतां न सेवेदिह दुर्मतिः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001756050, "chapter_id": 21756, "verse_number": "२-१७-५१", "content_sanskrit": "कृत्याचरणसक्तस्तु कुतस्तस्य भवेत्प्रिया ।\nअसेविता व्रजेद्भार्या अदत्तं हि धनं व्रजेत् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001756051, "chapter_id": 21756, "verse_number": "२-१७-५२", "content_sanskrit": "अरक्षितं व्रजेद्राज्यं अनभ्यस्तं श्रुतं व्रजेत् ।\nनालसैः प्राप्यते विद्या न भार्या व्रतसंस्थितैः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001756052, "chapter_id": 21756, "verse_number": "२-१७-५३", "content_sanskrit": "नानुष्ठानं विना लक्ष्मीर्नाभक्तैः प्राप्यते यशः ।\nनोद्यमी सुखमाप्नोति नाभार्यः संततिं लभेत् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001756053, "chapter_id": 21756, "verse_number": "२-१७-५४", "content_sanskrit": "नाशुचिर्द्धर्ममाप्नोति न विप्रोऽप्रियवाग्धनम् ।\nअपृच्छन्नैव जानाति अगच्छन्न क्वचिद्व्रजेत् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001756054, "chapter_id": 21756, "verse_number": "२-१७-५५", "content_sanskrit": "अशिष्यो न क्रियां वेत्ति न भयं वेत्ति जागरी ।\nकस्माद्भूपाल मां त्यक्त्वा धर्मांगदगृहे शुभे ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001756055, "chapter_id": 21756, "verse_number": "२-१७-५६", "content_sanskrit": "वीक्ष्यसे राज्यपदवीं समर्थे तनये विभो ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001756056, "chapter_id": 21756, "verse_number": "२-१७-५७", "content_sanskrit": "एवं ब्रुबाणां तनयां विधेस्तु रतिप्रियां चारुविशालनेत्राम् ।\nव्रीडान्वितः पुत्रसमीपवर्ती प्रोवाच वाक्यं नृपतिः प्रियां ताम् ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}]