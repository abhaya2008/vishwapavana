[{"id": 2179044, "chapter_id": 4789, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2179045, "chapter_id": 4789, "verse_number": "१", "content_sanskrit": "एतावदुक्त्वा देवर्षिर्विरराम स नारदः ।\nयुधिष्ठिरस्तु राजर्षिर्दध्यौ शोकपरिप्लुतः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2179046, "chapter_id": 4789, "verse_number": "२", "content_sanskrit": "तं दीनमनसं वीरमधोवदनमातुरम् ।\nनिःश्वसन्तं यथा नागं पर्यश्रुनयनं तथा\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2179047, "chapter_id": 4789, "verse_number": "३", "content_sanskrit": "कुन्ती शोकपरीताङ्गी दुःखोपहतचेतना ।\nअब्रवीन्मधुराभाषा काले वचनमर्थवत्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2179048, "chapter_id": 4789, "verse_number": "४", "content_sanskrit": "युधिष्ठिर महाबाहो नैनं शोचितुमर्हसि ।\nजहि शोकं महाप्राज्ञ शृणु चेदं वचो मम\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2179049, "chapter_id": 4789, "verse_number": "५", "content_sanskrit": "यतितः स मया पूर्वं भ्रात्र्यं ज्ञापयितुं तव ।\nभास्करेण च देवेन पित्रा धर्मभृतां वर\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2179050, "chapter_id": 4789, "verse_number": "६", "content_sanskrit": "यद्वान्यं हितकामेन सुहृदा भूतिमिच्छता ।\nतथा दिवाकरेणोक्तः स्वप्नान्ते मम चाग्रतः\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2179051, "chapter_id": 4789, "verse_number": "७", "content_sanskrit": "नचैनमशकद् भानुरहं वा स्नेहकारणैः ।\nपुरा प्रत्यनुनेतुं वा नेतुं वाप्येकता त्वया\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2179052, "chapter_id": 4789, "verse_number": "८", "content_sanskrit": "ततः कालपरीतः स वैरस्यो..क्षणे रतः ।\nप्रतीपकारी युष्माकमिति चोपेक्षितो मया\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2179053, "chapter_id": 4789, "verse_number": "९", "content_sanskrit": "इत्युक्तो धर्मराजस्तु मात्रा बाष्पाकुलेक्षणः ।\nउवाच वाक्यं धर्मात्मा शोकव्याकुलचेतनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2179054, "chapter_id": 4789, "verse_number": "१०", "content_sanskrit": "भवत्या गूढमन्त्रत्वात् पीडितोऽस्मीत्युवाच ताम् ।\nशशाप च महातेजाः सर्वलोकेषु च स्त्रियः ।\nन गुह्यं धारयिष्यन्तीत्यतिदुःखसमन्वितः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2179055, "chapter_id": 4789, "verse_number": "११", "content_sanskrit": "स राजा पुत्रपौत्राणां सम्बन्धिसुहृतां तथा ।\nस्मरन्नुद्विग्नहृदयो बभूवास्वस्थचेतनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2179056, "chapter_id": 4789, "verse_number": "१२", "content_sanskrit": "ततः शोकपरीतात्मा सधूम इव पावकः ।\nनिर्वेदमकरोद्धीमान् राजा सन्तापपीडितः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2179057, "chapter_id": 4789, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे षष्ठोऽध्यायः ॥६॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]