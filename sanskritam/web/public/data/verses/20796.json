[{"id": 7000796000, "chapter_id": 20796, "verse_number": "६-१३९-१", "content_sanskrit": "महादेव उवाच ।\nसाभ्रमत्युत्तरे कूले अग्नितीर्थमिति श्रुतम् ।\nतस्याश्चोत्तरपूर्वेण नातिदूरे कृतास्पदम्॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000796001, "chapter_id": 20796, "verse_number": "६-१३९-२", "content_sanskrit": "तीर्थं पालेश्वरं नाम चंडी यत्र प्रतिष्ठिता ।\nपीठं तद्योगमातॄणां सर्वसिद्धिविधायकम्॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000796002, "chapter_id": 20796, "verse_number": "६-१३९-३", "content_sanskrit": "यत्र ताः सर्वदेवानां कार्यार्थे मातरः स्थिताः ।\nपरमं यत्नमास्थाय लोकानुग्रहकारणात्॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000796003, "chapter_id": 20796, "verse_number": "६-१३९-४", "content_sanskrit": "त्रिरात्रमुषितो भूत्वा तस्मिंस्तीर्थे दृढव्रतः ।\nअभिगच्छेत्तमीशानं देवेशं चंडिकेश्वरम्॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000796004, "chapter_id": 20796, "verse_number": "६-१३९-५", "content_sanskrit": "साभ्रमत्यां कृतस्नानो मातृतीर्थस्य संनिधौ ।\nसमाधिविधिना युक्तो गच्छेद्वै मातृमंडलम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000796005, "chapter_id": 20796, "verse_number": "६-१३९-६", "content_sanskrit": "गोसहस्रप्रदानस्य फलं प्राप्नोति मानवः ।\nअग्नितीर्थे नरः स्नात्वा चामुंडादर्शने कृते॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000796006, "chapter_id": 20796, "verse_number": "६-१३९-७", "content_sanskrit": "न भयं जायते तस्य रक्षोभूतपिशाचजम् ।\nगोखुरा च नदी यत्र साभ्रमत्यां तु संगता॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000796007, "chapter_id": 20796, "verse_number": "६-१३९-८", "content_sanskrit": "तत्र तीर्थसहस्राणि तिष्ठंतीति सुरेश्वरि ।\nश्राद्धं तत्र प्रकर्त्तव्यं तिलचूर्णेन पार्वति॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000796008, "chapter_id": 20796, "verse_number": "६-१३९-९", "content_sanskrit": "पिंडान्दत्त्वा द्विजान्भोज्य अक्षयं पदमाप्नुयात् ।\nयत्र कुकर्दमो राजा पापिष्ठो दुर्द्धरः खलः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000796009, "chapter_id": 20796, "verse_number": "६-१३९-१०", "content_sanskrit": "मूढोऽहंकारसंयुक्तो द्विजानां परिनिंदकः ।\nगोघ्नोऽपि बलहा चैव पापिष्ठो दुर्दमः सदा॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000796010, "chapter_id": 20796, "verse_number": "६-१३९-११", "content_sanskrit": "राज्यं च कुर्वतस्तस्य पुरे पिंडारसंज्ञके ।\nतदा मृत्तिः समापन्ना धर्मे योगे सुरेश्वरि॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000796011, "chapter_id": 20796, "verse_number": "६-१३९-१२", "content_sanskrit": "मृतोऽसौ तत्र संजातः प्रेतरूपो महेश्वरि ।\nपीतास्यः शुष्कतुंडश्च पीतरोमाऽथ कर्कशः॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000796012, "chapter_id": 20796, "verse_number": "६-१३९-१३", "content_sanskrit": "उच्चस्तरो बहुरोमा क्षुत्पिपासाप्रपीडितः ।\nवायुभक्षं प्रकुर्वाणः प्रगच्छति इतस्ततः॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000796013, "chapter_id": 20796, "verse_number": "६-१३९-१४", "content_sanskrit": "बहुप्रेतैः समायुक्तो हाहेति करुणो रुदन् ।\nकिं कर्तव्यमिति प्राहुः प्रेतास्ते वै समीपगाः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000796014, "chapter_id": 20796, "verse_number": "६-१३९-१५", "content_sanskrit": "तेऽपि तदा रोदमानाः क्षुत्पिपासादि पीडिताः ।\nअन्ये प्रेता दुरात्मानो राज्ञः संगतिमाययुः॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000796015, "chapter_id": 20796, "verse_number": "६-१३९-१६", "content_sanskrit": "राज्ञा सार्द्धं च गच्छंति लोकान्विजनकान्बहून् ।\nनोदकमथवा चान्नं न मार्गे दृश्यते कदा॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000796016, "chapter_id": 20796, "verse_number": "६-१३९-१७", "content_sanskrit": "ते प्रेता दुष्टरूपाश्च विचरंति महीतले ।\nभक्षंति शवमांसानि पिबंति रुधिरं सदा॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000796017, "chapter_id": 20796, "verse_number": "६-१३९-१८", "content_sanskrit": "एवं कुकर्दमो राजा सदा तैः परिवारितः ।\nकदाचिद्दैवयोगेन गुरोराश्रममन्वगात्॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000796018, "chapter_id": 20796, "verse_number": "६-१३९-१९", "content_sanskrit": "पूर्वजन्मकृतं पुण्यं तेन योगेन संगतः ।\nपार्वत्युवाच ।\nकिं कृतं तेन वै पुण्यं वद विश्वेश्वर प्रभो॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000796019, "chapter_id": 20796, "verse_number": "६-१३९-२०", "content_sanskrit": "अयं पापी दुरात्मा च ब्राह्मणानां च दुःखदः ।\nसत्संगतिः कथं जाता तन्मे दुस्तरतो वद॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000796020, "chapter_id": 20796, "verse_number": "६-१३९-२१", "content_sanskrit": "महादेव उवाच ।\nएतेन नरदेवेन पूर्वजन्मनि यत्कृतम् ।\nतत्सर्वं कथयिष्यामि शृणु त्वं नगनंदिनि॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000796021, "chapter_id": 20796, "verse_number": "६-१३९-२२", "content_sanskrit": "पूर्वजन्मन्ययं देवि ब्राह्मणो वेदपाठकः ।\nसंपूज्य च महादेवं कृत्वा चातिथिपूजनम्॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000796022, "chapter_id": 20796, "verse_number": "६-१३९-२३", "content_sanskrit": "भोजनं कुरुते नित्यमसौ वाडवसत्तमः ।\nतेन पुण्यप्रभावेन पुरो पिंडारसंज्ञके॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000796023, "chapter_id": 20796, "verse_number": "६-१३९-२४", "content_sanskrit": "राजा वै तत्र संजातः कुकर्दम इति श्रुतः ।\nकर्मणा मनसा चैव न कृतं पुण्यमेव च॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000796024, "chapter_id": 20796, "verse_number": "६-१३९-२५", "content_sanskrit": "तेन देवाभियोगेन मृतो वै प्रेतराडभूत् ।\nशुष्कास्यः शुष्करूपश्च पीतवर्णः करालकः॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000796025, "chapter_id": 20796, "verse_number": "६-१३९-२६", "content_sanskrit": "पूर्वजन्मकृतं पुण्यं न नश्यति सुरेश्वरि ।\nतेन पुण्याभियोगेन संगतो गुरुणाश्रमे॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000796026, "chapter_id": 20796, "verse_number": "६-१३९-२७", "content_sanskrit": "कहोडो वर्तते तत्र तेन दृष्टोऽथ प्रेतराट् ।\nशुष्कास्यः शुष्करूपश्च पीतवर्णः करालकः॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000796027, "chapter_id": 20796, "verse_number": "६-१३९-२८", "content_sanskrit": "गंभीराक्षो महापापी दुष्टैः प्रेतैश्च संयुतः ।\nऊर्द्ध्वरोमा जटायुक्तः कालरूपो भयंकरः॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000796028, "chapter_id": 20796, "verse_number": "६-१३९-२९", "content_sanskrit": "एवं दृष्ट्वा तदा देवि विह्वलो वाडवोऽभवत् ।\nकहोड उवाच ।\nअस्मिन्मनोरमे चाहं स्थाने वै परमाद्भुते॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000796029, "chapter_id": 20796, "verse_number": "६-१३९-३०", "content_sanskrit": "अग्निपालेश्वरे तीर्थे नित्यं तिष्ठामि भूमिप ।\nयजमानस्त्वमस्माकं कथं जातोऽसि प्रेतराट्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000796030, "chapter_id": 20796, "verse_number": "६-१३९-३१", "content_sanskrit": "दुरात्मा दुष्टरूपश्च कालरूपो भयंकरः ।\nकेन कर्मविपाकेन जातो वै भूतले शुभे॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000796031, "chapter_id": 20796, "verse_number": "६-१३९-३२", "content_sanskrit": "प्रेत उवाच ।\nशृणु वाडव मे पापं पूर्वजन्मनि यत्कृतम् ।\nअहं कुकर्दमो राजा पुरे पिंडारसंज्ञके॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000796032, "chapter_id": 20796, "verse_number": "६-१३९-३३", "content_sanskrit": "तत्रस्थेन मया देव यत्कृतं तच्छृणुष्व हि ।\nब्रह्मणां हिंसनं चैव पुराऽसत्यादिभाषणम्॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000796033, "chapter_id": 20796, "verse_number": "६-१३९-३४", "content_sanskrit": "प्रजानां पीडनं चैव जीवानां हिंसनं सदा ।\nगवां वै दुःखकर्ताऽहं ब्राह्मणव्रतलोपनः॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000796034, "chapter_id": 20796, "verse_number": "६-१३९-३५", "content_sanskrit": "अस्नातः सर्वदा विप्र सज्जनानां विदूषकः ।\nविष्णुनिंदापरो नित्यं वैष्णवानां च निंदकः॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000796035, "chapter_id": 20796, "verse_number": "६-१३९-३६", "content_sanskrit": "दुराचारो दुरात्मा च वृषलीसंयुतः सदा ।\nतत्र तत्र प्रभुंजानो नाऽहं शौचपरायणः॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000796036, "chapter_id": 20796, "verse_number": "६-१३९-३७", "content_sanskrit": "तेन कर्माभियोगेन मृतो वै द्विजराट्ततः ।\nप्रेतयोनिं प्रपन्नोऽस्मि दुःखी जातो ह्यनेकधा॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000796037, "chapter_id": 20796, "verse_number": "६-१३९-३८", "content_sanskrit": "यस्य माता पिता नास्ति यस्य स्वजनबांधवाः ।\nतस्य बंधुर्गुरुर्माता पितापि गुरुरेव च॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000796038, "chapter_id": 20796, "verse_number": "६-१३९-३९", "content_sanskrit": "इति ज्ञात्वा तु भो ब्रह्मन्मुक्तिं दातुं त्वमर्हसि॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000796039, "chapter_id": 20796, "verse_number": "६-१३९-४०", "content_sanskrit": "कहोड उवाच ।\nशृणु त्वं नृपतिश्रेष्ठ करिष्ये वचनं तव ।\nमुक्तिं यास्यति वै सद्यो भवांस्त्विह न संशयः॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000796040, "chapter_id": 20796, "verse_number": "६-१३९-४१", "content_sanskrit": "एकादश पुरोगाश्च प्रेता ये तव संगताः ।\nते चापि मुक्तिमायांति सुतीर्थेऽस्मिन्विशेषतः॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000796041, "chapter_id": 20796, "verse_number": "६-१३९-४२", "content_sanskrit": "तदा वै तेन विप्रेण तीर्थे गत्वा सुरेश्वरि ।\nसर्वैश्चकारयामास तिलपिंडोदकक्रियाः॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000796042, "chapter_id": 20796, "verse_number": "६-१३९-४३", "content_sanskrit": "न मासो न तिथिर्देवी तीर्थे गत्वा पुनः पुनः ।\nकर्त्तव्यं श्राद्धकर्मादि ब्रह्मणोक्तं पुरा मम॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000796043, "chapter_id": 20796, "verse_number": "६-१३९-४४", "content_sanskrit": "कृते कर्मणि देवेशि मुक्तास्ते तीर्थराजके ।\nविमानवरमारूढास्ते गता मामकीं पुरीम्॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000796044, "chapter_id": 20796, "verse_number": "६-१३९-४५", "content_sanskrit": "संगता गोखुरा यत्र साभ्रमत्या सुरेश्वरि ।\nतत्र स्नानं च दानं च कोटियज्ञफलं लभेत्॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000796045, "chapter_id": 20796, "verse_number": "६-१३९-४६", "content_sanskrit": "यत्राग्नितीर्थं वर्तेत कपालेश्वरसंज्ञकम् ।\nतत्र मुक्तिस्तु संप्रोक्ता सत्यं सत्यं भवेद्ध्रुवम्॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]