[{"id": 7000214000, "chapter_id": 20214, "verse_number": "२१४-१", "content_sanskrit": "नरकवर्णनम् मुनय ऊचुः न तृप्तिमधिगच्छामः पुण्यधर्मामृतस्य च ।\nमुने त्वन्मुखगीतस्य तथा कौतूहलं हि नः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000214001, "chapter_id": 20214, "verse_number": "२१४-२", "content_sanskrit": "उत्पत्तिं प्रलयं चैव भूतानां कर्मणो गतिम् ।\nवेत्सि सर्वं मुने तेन पृच्छामस्त्वां महामतिम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000214002, "chapter_id": 20214, "verse_number": "२१४-३", "content_sanskrit": "श्रूयते यमलोकस्य मार्गः परमदुर्गमः ।\nदुःखक्लेशकरः शश्वत्सर्वभूतभयावहः ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000214003, "chapter_id": 20214, "verse_number": "२१४-४", "content_sanskrit": "कथं तेन नरा यान्ति मार्गेण यमसादनम् ।\nप्रमाणं चैव मार्गस्य ब्रूहि नो वदनां वर ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000214004, "chapter_id": 20214, "verse_number": "२१४-५", "content_sanskrit": "मुने पृच्छाम सर्वज्ञ ब्रूहि सर्वमशेषतः ।\nकथं नरकदुःखानि नाऽऽप्नुवन्ति नरान्मुने ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000214005, "chapter_id": 20214, "verse_number": "२१४-६", "content_sanskrit": "केनोपायेन दानेन धर्मेण नियमेन च ।\nमानुषस्य च याम्यस्य लोकस्य कियदन्तरम् ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000214006, "chapter_id": 20214, "verse_number": "२१४-७", "content_sanskrit": "कथं च स्वर्गतिं यान्ति नरकं केन कर्मणा ।\nस्वर्गस्थानानि कियन्ति कियन्ति नरकाणि च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000214007, "chapter_id": 20214, "verse_number": "२१४-८", "content_sanskrit": "कथं सुकृतिनो यान्ति कथं दुष्कृतकारिणः ।\nकिं रूपं किं प्रमाणं वा को वर्णस्तूभयोरपि ।\nजीवस्य नीयमानस्य यमलोकं ब्रवीहि नः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000214008, "chapter_id": 20214, "verse_number": "२१४-९", "content_sanskrit": "व्यास उवाच शृणुध्वं मुनिशार्दूला वदतो मम सुव्रताः ।\nसंसारचक्रमजरं स्थितिर्यस्य न विद्यते ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000214009, "chapter_id": 20214, "verse_number": "२१४-१०", "content_sanskrit": "सोऽहं वदामि वः सर्वं यममार्गस्य निर्णयम् ।\nउत्क्रान्तिकालादारभ्य यथा नान्यो वदिष्यति ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000214010, "chapter_id": 20214, "verse_number": "२१४-११", "content_sanskrit": "स्वरूपं चैव मार्गस्य यन्मां पृच्छथ सत्तमाः ।\nयमलोकस्य चाध्वानमन्तरं मानुषस्य च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000214011, "chapter_id": 20214, "verse_number": "२१४-१२", "content_sanskrit": "योजनानां सहस्राणि षडशीतिस्तदन्तरम् ।\nतप्तताम्रमिवाऽऽतप्तं तदध्वानमुदाहृतम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000214012, "chapter_id": 20214, "verse_number": "२१४-१३", "content_sanskrit": "तदवश्यं हि गन्तव्यं प्रामिभिर्जीवसंज्ञकैः ।\nपुण्यान्पुण्यकृतो यान्ति पापान्पापकृतोऽधमाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000214013, "chapter_id": 20214, "verse_number": "२१४-१४", "content_sanskrit": "द्वाविंशतिश्च नरका यमस्य विषये स्थिताः ।\nयेषु दुष्कृतकर्माणो विपच्यन्ते पृथक्पृथक् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000214014, "chapter_id": 20214, "verse_number": "२१४-१५", "content_sanskrit": "नरको रौरवो रौद्रः शूकरस्ताल एव च ।\nकुम्भीपाको महाघोरः शाल्मलोऽथ विमाहनः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000214015, "chapter_id": 20214, "verse_number": "२१४-१६", "content_sanskrit": "कीटादः कृमिभक्षश्च ना(ला)लाभक्षो भ्रमस्तथा ।\nनद्यः पूयवहाश्चान्या रुधिराम्भस्तथैव च ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000214016, "chapter_id": 20214, "verse_number": "२१४-१७", "content_sanskrit": "अग्निज्वाला महाघोरः संदंशः शुनभोजनः ।\nघोरा वैतरणी चैव असिपत्रवनं तथा ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000214017, "chapter_id": 20214, "verse_number": "२१४-१८", "content_sanskrit": "न तत्र वृक्षच्छाया वा न तडागाः सरांसि च ।\nन वाप्यो दीर्घिका वाऽपि न कूपो न प्रपा सभा ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000214018, "chapter_id": 20214, "verse_number": "२१४-१९", "content_sanskrit": "न मण्डपो नाऽऽयतनं न नद्यो न च पर्वताः ।\nन किंचिदाश्रमस्थानं विद्यते तत्र वर्त्मनि ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000214019, "chapter_id": 20214, "verse_number": "२१४-२०", "content_sanskrit": "यत्र विश्रमते श्रान्तः पुरुषोऽतीवकर्षितः ।\nअवश्यमेव गन्तव्यः स सर्वैस्तु महापथः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000214020, "chapter_id": 20214, "verse_number": "२१४-२१", "content_sanskrit": "प्राप्ते काले तु संत्यज्य सुहृद्‌बन्धुधनादिकम् ।\nजरायुजाण्डजाश्चैव स्वेदजाश्चोद्‌भिजास्तथा ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000214021, "chapter_id": 20214, "verse_number": "२१४-२२", "content_sanskrit": "जङ्गमाजङ्गमाश्चैव गमिष्यन्ति महापथम् ।\nदेवासुरमनुष्यैश्च वैवस्वतवशानुगैः ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000214022, "chapter_id": 20214, "verse_number": "२१४-२३", "content_sanskrit": "स्त्रीपुंनपुंसकैश्चैव पृथिव्यां जीवसंज्ञितैः ।\nपूर्वाह्‌णे चापराह्‌णे वा मध्याह्ने वा तथा पुनः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000214023, "chapter_id": 20214, "verse_number": "२१४-२४", "content_sanskrit": "संध्याकालेऽर्धरात्रे वा प्रत्यूषे वाऽप्युपस्तिते ।\nवृद्धैर्वा मध्यमैर्वाऽपि यौवनस्थैस्तथैव च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000214024, "chapter_id": 20214, "verse_number": "२१४-२५", "content_sanskrit": "गर्भवासेऽथ बाल्ये वा गन्तव्यः स महापथः ।\nप्रवासस्थैगृर्हस्थैर्वा पर्वतस्थैः स्थलेऽपि वा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000214025, "chapter_id": 20214, "verse_number": "२१४-२६", "content_sanskrit": "क्षेत्रस्तैर्वा जलस्थैर्वा गृहमध्यगतैस्तथा ।\nआसीनैश्चास्थितैर्वापि शयनीयगतैस्तथा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000214026, "chapter_id": 20214, "verse_number": "२१४-२७", "content_sanskrit": "जाग्रद्‌भिर्वा प्रसुप्तैर्वा गन्तव्यः स महापथः ।\nइहानुभूय निर्दिष्टमायुर्जन्तुः स्वयं तदा ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000214027, "chapter_id": 20214, "verse_number": "२१४-२८", "content_sanskrit": "तस्यान्ते च स्वयं प्राणैरनिच्छन्नपि मुच्यते ।\nजलमग्निर्विषं शस्त्रं क्षुद्‌व्याधिः पतनं गिरेः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000214028, "chapter_id": 20214, "verse_number": "२१४-२९", "content_sanskrit": "निमित्तं किंचिदासाद्य देही प्राणैर्विमुच्यते ।\nविहाय सुमहत्कृत्स्नं शरीरं पाञ्चभौतिकम् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000214029, "chapter_id": 20214, "verse_number": "२१४-३०", "content_sanskrit": "अन्यच्छरीरमादत्ते यातनीयं स्वकर्मजम् ।\nदृढं शरीरमाप्नोति सुखदुःखोपभुक्तये ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000214030, "chapter_id": 20214, "verse_number": "२१४-३१", "content_sanskrit": "तेन भुङ्क्ते स कृच्छ्राणि पापकर्ता नरो भृशम् ।\nसुखानि धार्मिको हृष्ट इह नीतो यमक्षये ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000214031, "chapter_id": 20214, "verse_number": "२१४-३२", "content_sanskrit": "ऊष्मा प्रकुपितः काये तीव्रवायुसमीरितः ।\nभीनत्ति मर्मस्थानानि दीप्यमानो निरन्धनः ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000214032, "chapter_id": 20214, "verse_number": "२१४-३३", "content_sanskrit": "उदानो नाम पवनस्ततश्चोर्ध्वं प्रवर्तते ।\nभुज्यता(क्ताना)मम्बुभक्ष्याणामधोगतिनिरोधकृत् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000214033, "chapter_id": 20214, "verse_number": "२१४-३४", "content_sanskrit": "ततो येनाम्बुदानानि कृतान्यन्नरसास्तथा ।\nदत्ताः स तस्यामाह्लादमापदि प्रतिपद्यते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000214034, "chapter_id": 20214, "verse_number": "२१४-३५", "content_sanskrit": "अन्नानि येन दत्तानि श्रद्धापूतेन चेतसा ।\nसोऽपि तृप्तिमवाप्नोति विनाऽप्यन्नेन वै तदा ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000214035, "chapter_id": 20214, "verse_number": "२१४-३६", "content_sanskrit": "येनानृतानि नोक्तानि प्रीतिभेदः कृतो न च ।\nआस्तिकः श्रद्दधानश्च सुखमृत्युं स गच्छति ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000214036, "chapter_id": 20214, "verse_number": "२१४-३७", "content_sanskrit": "देवब्राह्मणपूजायां निरताश्चानसूयकाः ।\nशुक्ला वदान्या ह्रीमन्तस्ते नराः सुखमृत्यवः ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000214037, "chapter_id": 20214, "verse_number": "२१४-३८", "content_sanskrit": "यः कामान्नापि संरम्भान्न द्वेषाद्धर्ममुत्सृजेत् ।\nयथोक्तकारी सौम्यश्च स सुखं मृत्युमृच्छति ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000214038, "chapter_id": 20214, "verse_number": "२१४-३९", "content_sanskrit": "वारिदास्तृषितानां ये क्षुधितान्नप्रदायिनः ।\nप्राप्नुवन्ति नराः काले मृत्युं सुखसमन्वितम् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000214039, "chapter_id": 20214, "verse_number": "२१४-४०", "content_sanskrit": "शीतं जयन्ति धनदास्तापं चन्दनदायिनः ।\nप्राणघ्नीं वेदनां कष्टां ये चान्योद्वेगधारिणः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000214040, "chapter_id": 20214, "verse_number": "२१४-४१", "content_sanskrit": "मोहं ज्ञानप्रदातारस्तथा दीपप्रदास्तमः ।\nकूटसाक्षी मृषावादी यो गुरुर्नानुशास्ति वै ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000214041, "chapter_id": 20214, "verse_number": "२१४-४२", "content_sanskrit": "ते मोहमृत्यवः सर्वे तथा ये वेदनिन्दकाः ।\nविभिषीणाः पूतिगन्धाः कूटमुद्‌गरपाणयः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000214042, "chapter_id": 20214, "verse_number": "२१४-४३", "content_sanskrit": "आगच्छन्ति दुरात्मानो यमस्य पुरुषास्तथा ।\nप्राप्तेषु दृक्पथं तेषु जायते तस्य वेपथुः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000214043, "chapter_id": 20214, "verse_number": "२१४-४४", "content_sanskrit": "क्रन्दत्यविरतः सोऽथ भ्रातृमातपितॄस्तथा ।\nसा तु वागस्फुटा विप्रा एकवर्णा विभाव्यते ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000214044, "chapter_id": 20214, "verse_number": "२१४-४५", "content_sanskrit": "दृष्टिर्विभ्राम्यते त्रासात्कासावृष्ट्यत्य(विष्टम)थाऽऽननम् ।\nततः स वेदनाविष्टं तच्छरीरं विमुञ्चति ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000214045, "chapter_id": 20214, "verse_number": "२१४-४६", "content_sanskrit": "वाय्वग्रसारी तद्रूपदेहमन्यत्प्रपद्यते ।\nतत्कर्मयानतार्थे च न मातृपितृसंभवम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000214046, "chapter_id": 20214, "verse_number": "२१४-४७", "content_sanskrit": "तत्प्रमाणवयोवस्थासंस्थानैः प्राप्यते व्यथा ।\nततो दूतो यमस्याथ पाशैर्बध्नाति दारुणैः ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000214047, "chapter_id": 20214, "verse_number": "२१४-४८", "content_sanskrit": "जन्तोः संप्राप्तकालस्य वेदनार्तस्य वै भृशम् ।\nभूतैः संत्यक्तदेहस्य कण्ठप्राप्तानिलस्य च ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000214048, "chapter_id": 20214, "verse_number": "२१४-४९", "content_sanskrit": "शरीराच्चयावितो जीवो रोरवीति तथोल्बणम् ।\nनिर्गतो वायुभूतस्तु षाट्कौशिककलेवरे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000214049, "chapter_id": 20214, "verse_number": "२१४-५०", "content_sanskrit": "मातृभिः पितृभिश्चैव भ्रातृभिर्मातुलैस्तथा ।\nदारैः पुत्रर्वयस्यैश्च गुरुभिस्त्यज्यते भुवि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000214050, "chapter_id": 20214, "verse_number": "२१४-५१", "content_sanskrit": "दृश्यमानश्च तैर्दीनैरश्रुपूर्णेक्षणैर्भृशम् ।\nस्वशरीतं समुत्सृज्य वायुभूतस्तु गच्छति ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000214051, "chapter_id": 20214, "verse_number": "२१४-५२", "content_sanskrit": "अन्धकारमपारं च महाघोरं तमोवृतम् ।\nसुखदुःप्रदातारं दुर्गमं पापकर्मणाम् ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000214052, "chapter_id": 20214, "verse_number": "२१४-५३", "content_sanskrit": "दुःसहं च दुरन्तं च दुर्निरीक्षं दुरासदम् ।\nदुरापमतिदुर्गं च पापिष्ठानां सदाऽहितम् ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000214053, "chapter_id": 20214, "verse_number": "२१४-५४", "content_sanskrit": "कृष्यमाणाश्च तैर्भूतैर्याम्यैः पाशैस्तु संयताः ।\nमुद्‌गरैस्ताड्यमानाश्च नीयन्ते तं महापथम् ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7000214054, "chapter_id": 20214, "verse_number": "२१४-५५", "content_sanskrit": "क्षीणायुषं समालोक्य प्राणिनं चाऽऽयुषक्षये ।\nनिनीषवः समायान्ति यमदूता भयङ्कराः ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7000214055, "chapter_id": 20214, "verse_number": "२१४-५६", "content_sanskrit": "आरुढा यानकाले तु ऋक्षव्याघ्रखरेषु च ।\nउष्ट्रेषु वानरेष्वन्ये वृश्चिकेषु वृकेषु च ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7000214056, "chapter_id": 20214, "verse_number": "२१४-५७", "content_sanskrit": "उलूकसर्पमार्जारं तथाऽन्ये गृध्रवाहनाः ।\nश्येनशृगालमारूढाः सरघाकङ्कवाहनाः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7000214057, "chapter_id": 20214, "verse_number": "२१४-५८", "content_sanskrit": "वराहपशुवेतालमहिषास्यास्तथा परे ।\nनानारूपधरा घोराः सर्पप्राणिभयंकराः ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7000214058, "chapter_id": 20214, "verse_number": "२१४-५९", "content_sanskrit": "दीर्घमुष्काः करालास्या वक्रनासास्त्रिलोचनाः ।\nमहाहनुकपोलास्याः प्रलम्बदशनच्छदाः ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 7000214059, "chapter_id": 20214, "verse_number": "२१४-६०", "content_sanskrit": "निर्गतैर्विकृताकारैर्दशनैरङ्कुरोपमैः ।\nमांसशोणितदिग्धाङ्गा दंष्ट्राभिर्भृशमुलबणैः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 7000214060, "chapter_id": 20214, "verse_number": "२१४-६१", "content_sanskrit": "मुखैः पातालसदृशैर्ज्वलज्जिह्‌वैर्भयंकरैः ।\nनेत्रैः सुविकृताकारैर्ज्वलत्पिङ्गलचञ्चलैः ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 7000214061, "chapter_id": 20214, "verse_number": "२१४-६२", "content_sanskrit": "मार्जारोलूकखद्योतशक्रगोपवदुद्धतैः ।\nकेकरैः संकुलैस्तब्धैर्लोचनैः पावकोपमैः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 7000214062, "chapter_id": 20214, "verse_number": "२१४-६३", "content_sanskrit": "भृशमाभरणैर्भीमैराबद्धैर्भुजगोपमैः ।\nशोणासरलगात्रैश्च मुण्डमालाविभूषितैः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 7000214063, "chapter_id": 20214, "verse_number": "२१४-६४", "content_sanskrit": "कण्ठस्थकृष्णसपैश्च फूत्काररवभीषणैः ।\nवह्निज्वालोपमैः केशैस्तब्धरूक्षैर्भयंकरैः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 7000214064, "chapter_id": 20214, "verse_number": "२१४-६५", "content_sanskrit": "बभ्रुपिङ्गललोलैश्च कद्रुश्मश्रुभिरावृताः ।\nभुजदण्डैर्महाघोरैः प्रलम्बैः परिघोपमैः ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 7000214065, "chapter_id": 20214, "verse_number": "२१४-६६", "content_sanskrit": "केचिद् द्विबाहवस्तत्र तथाऽन्ये च चतुर्भुजाः ।\nद्विरष्टबाहवश्चान्ये दशविंशभुजास्तथा ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 7000214066, "chapter_id": 20214, "verse_number": "२१४-६७", "content_sanskrit": "असंख्यातभुजाश्चानये केचिद्‌बाहुमसहस्रिणः ।\nआयुधैर्विकृताकारैः प्रज्वलद्‌भिर्भयानकैः ॥६७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 7000214067, "chapter_id": 20214, "verse_number": "२१४-६८", "content_sanskrit": "शक्तितोमरचक्राद्यैः सुदीप्तैर्विविधायुधैः ।\nपाशश्रृंखलदण्डैश्च भीषयन्तो महाबलाः ॥६८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 7000214068, "chapter_id": 20214, "verse_number": "२१४-६९", "content_sanskrit": "आगच्छन्ति महारौद्रा मर्त्यानामायुषः क्षये ।\nग्रहीतुं प्राणिनः सर्वं यमस्याऽऽज्ञाकरास्तथा ॥६९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 7000214069, "chapter_id": 20214, "verse_number": "२१४-७०", "content_sanskrit": "यत्तच्छरीरमादत्ते यातनीयं स्वकर्मजम् ।\nतदस्य नीयते जन्तोर्यमस्य सदनं प्रति ॥७०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 7000214070, "chapter_id": 20214, "verse_number": "२१४-७१", "content_sanskrit": "बद्‌ध्वा तत्कालपाशैश्च निगडैर्वज्रश्रृङ्खलैः ।\nताडयित्वा भृशं क्रुद्धैर्नीयते यमकिंकरैः ॥७१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 7000214071, "chapter_id": 20214, "verse_number": "२१४-७२", "content_sanskrit": "प्रस्खलन्तं रुदन्तं च आक्रोशन्तं मुहुर्मुहुः ।\nहा तात पुत्रेति वदन्तं कर्मदूषितम् ॥७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 7000214072, "chapter_id": 20214, "verse_number": "२१४-७३", "content_sanskrit": "आहत्य निशितैः शूलैर्मुद्‌गरैर्निशितैर्घनैः ।\nखड्गाशक्तिप्रहारैश्च वज्रदण्डैः सुदारुणैः ॥७३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 7000214073, "chapter_id": 20214, "verse_number": "२१४-७४", "content_sanskrit": "भर्त्स्यमानो महारावैर्वज्रशक्तिसमन्वितैः ।\nएकैकशो भृशं क्रुद्धैस्ताडयद्‌भिः समन्ततः ॥७४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 7000214074, "chapter_id": 20214, "verse_number": "२१४-७५", "content_sanskrit": "स मुह्यमानो दुःखार्तः प्रतपंश्च इतस्ततः ।\nआकृष्य नीयते जन्तुरध्वानं सुभयंकरैः ॥७५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 7000214075, "chapter_id": 20214, "verse_number": "२१४-७६", "content_sanskrit": "कुशकण्टकवल्मीकशङ्कुपाषाणशर्करे ।\nतथा प्रदीप्तज्वलने क्षारवज्रशतोऽकटे ॥७६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 7000214076, "chapter_id": 20214, "verse_number": "२१४-७७", "content_sanskrit": "प्रदीप्तादित्यतप्तेन दह्यमानस्तदंशुभिः ।\nकृष्यते यमदूतैश्च शिवासंनादभीषणैः ॥७७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 7000214077, "chapter_id": 20214, "verse_number": "२१४-७८", "content_sanskrit": "विकृष्यमाणस्तैर्घोरैर्भक्ष्यमाणः शिवशतैः ।\nप्रयाति दारुणे मार्गे पापकर्मा यमालयम् ॥७८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 7000214078, "chapter_id": 20214, "verse_number": "२१४-७९", "content_sanskrit": "क्वचिद्भीतैः क्वचित्त्रस्तैः प्रस्खलद्‌भिः क्वचित्क्वचित् ।\nदुःखेनाऽक्रनाऽक्रन्दमानैश्च गन्तव्यः स महापथः ॥७९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 7000214079, "chapter_id": 20214, "verse_number": "२१४-८०", "content_sanskrit": "निर्भर्त्स्यमानैरुद्विग्नैर्विद्रुतैर्भयविह्‌वलैः ।\nकम्पमानशरीरैस्तु गन्तव्यं जीवसंज्ञकैः ॥८०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 7000214080, "chapter_id": 20214, "verse_number": "२१४-८१", "content_sanskrit": "कष्टकाकीर्णमार्गेण संतप्तसिकतेन च ।\nदह्यमानैस्तु गन्तव्यं जीवसंज्ञकैः ॥८१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 7000214081, "chapter_id": 20214, "verse_number": "२१४-८२", "content_sanskrit": "मेदःशोणितदुर्गन्धैर्बस्तगात्रैश्च पुगशः ।\nदग्धस्फुटत्वचाऽऽकीर्णैर्गन्तव्यं जीवघातकैः ॥८२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 7000214082, "chapter_id": 20214, "verse_number": "२१४-८३", "content_sanskrit": "कूजद्‌भिः क्रन्दमानैश्च विक्रोशद्‌भिश्च विस्वरम् ।\nवेदनार्तैश्च सद्‌भिश्च गन्तव्यं जीवघातकैः ॥८३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 7000214083, "chapter_id": 20214, "verse_number": "२१४-८४", "content_sanskrit": "शक्तिभिर्भिन्दिपालैश्च खड्गतोमरसायकैः ।\nभिद्यद्भिस्तीक्ष्णशूलाग्रैर्गन्तव्यं जीवघातकैः ॥८४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 7000214084, "chapter_id": 20214, "verse_number": "२१४-८५", "content_sanskrit": "श्वानैर्व्याघ्रैर्वृकैः कङ्कैर्भक्ष्यमाणैश्च पापिभिः ॥८५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 7000214085, "chapter_id": 20214, "verse_number": "२१४-८६", "content_sanskrit": "कृन्तद्‌भिः क्रकचाघतैर्गन्तव्यं मांसखादिभिः ।\nमहिषर्षभशृङ्गाग्रैर्भिद्यमानैः समन्ततः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 7000214086, "chapter_id": 20214, "verse_number": "२१४-८७", "content_sanskrit": "उल्लिखद्भिः शूकरैश्च गन्तव्यं मांसखादकैः ।\nसूचीभ्रमरकाकोलमक्षिकाभिश्च संघशः ॥८७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 7000214087, "chapter_id": 20214, "verse_number": "२१४-८८", "content_sanskrit": "भुज्यमानैस्च गन्तव्यं पापिष्ठैर्मधुघातकैः ।\nविश्वस्तं स्वामिनं मित्रं स्त्रियं वा यस्तु घातयेत् ॥८८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 7000214088, "chapter_id": 20214, "verse_number": "२१४-८९", "content_sanskrit": "शस्त्रैर्निकृत्यमानैश्च गन्तव्यं चातुरैर्नरैः ।\nघातयन्ति च ये जन्तूंस्ताडयन्ति निरागसः ॥८९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 7000214089, "chapter_id": 20214, "verse_number": "२१४-९०", "content_sanskrit": "राक्षसैर्भक्ष्यमाणास्ते यान्ति याम्यपथं नराः ।\nये हरन्ति परस्त्रीणां वरप्रावरणानि च ॥९०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 7000214090, "chapter_id": 20214, "verse_number": "२१४-९१", "content_sanskrit": "ते यान्ति विद्रुता नग्नाः प्रेतीभूता यमालयम् ।\nवासो धान्यं हिरण्यं वा गृहक्षेत्रमथापि वा ॥९१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 7000214091, "chapter_id": 20214, "verse_number": "२१४-९२", "content_sanskrit": "ये हरन्ति दुरात्मानः पापिष्ठाः पापकर्मिणः ।\nपाषाणैर्लगुडैर्दण्डैस्ताड्यमानैस्तु जर्जरैः ॥९२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 7000214092, "chapter_id": 20214, "verse_number": "२१४-९३", "content_sanskrit": "हद्भिः शोणिनं भूरि गन्तव्यं तु यमालयम् ।\nब्रह्मास्वं ये हरन्तीह नरा नरकनिर्भयाः ॥९३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 7000214093, "chapter_id": 20214, "verse_number": "२१४-९४", "content_sanskrit": "ताडान्ति तथा विप्रानाक्रोशन्ति नराधमाः ।\nशुष्ककाष्ठनिबद्धास्ते धिन्नकर्णाक्षिनासिकाः ॥९४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 7000214094, "chapter_id": 20214, "verse_number": "२१४-९५", "content_sanskrit": "पूयशोणितदिग्धास्ते कालगृधैश्च जम्बुकैः ।\nकिंकरैर्भीषणैश्चण्डैस्ताड्यमानाश्च दारुणैः ॥९५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 7000214095, "chapter_id": 20214, "verse_number": "२१४-९६", "content_sanskrit": "विक्रोशमाना गच्छन्ति पापिनस्ते यमालयम् ।\nएवं परमदुर्धर्षमध्वानं ज्वलनप्रभम् ॥९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 7000214096, "chapter_id": 20214, "verse_number": "२१४-९७", "content_sanskrit": "रौरवं दुर्गविषमं निर्दिष्टं मानुषस्य च ।\nप्रतप्तताम्रवर्णाभं वह्निज्वालास्फुलिङ्गवत् ॥९७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 7000214097, "chapter_id": 20214, "verse_number": "२१४-९८", "content_sanskrit": "कुरण्टकण्टकाकीर्णं पृथुविकटताडनैः ।\nशक्तिवज्रैश्च संकीर्णमुज्ज्वलं तीव्रकण्टकम् ॥९८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 7000214098, "chapter_id": 20214, "verse_number": "२१४-९९", "content_sanskrit": "अङ्गारवालुकामिश्रं वहिनकीटकदुर्गमम् ।\nज्वालामालाकुलं रौद्रं सूर्यरश्मिप्रतापितम् ॥९९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 7000214099, "chapter_id": 20214, "verse_number": "२१४-१००", "content_sanskrit": "अध्वानं नीयते देही कृष्यमाणः सुनिष्ठुरैः यदैव क्रन्दते जन्तुर्दुःखार्तः पतितः क्वचित् ॥१००॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 7000214100, "chapter_id": 20214, "verse_number": "२१४-१०१", "content_sanskrit": "तदैवाऽऽहन्यते सर्वैरायुधैर्यमकिंकरैः ।\nएवं संताड्यमानश्च लुब्धः पापेषु योऽनयः ॥१०१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 7000214101, "chapter_id": 20214, "verse_number": "२१४-१०२", "content_sanskrit": "अवशो नीयते जन्तुर्दुर्धरैर्यमकिंकरैः ।\nसवैरेव हि गन्तव्यमध्वानं तत्सुदुर्गमम् ॥१०२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 7000214102, "chapter_id": 20214, "verse_number": "२१४-१०३", "content_sanskrit": "नीयते विविधैर्घोरैर्यमदूतैरवज्ञया ।\nनीत्वा सुदारुणं मार्गं प्राणिनं यमकिंकरैः ॥१०३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 7000214103, "chapter_id": 20214, "verse_number": "२१४-१०४", "content_sanskrit": "प्रवेश्यते पुरीं घोरं ताम्रायसमयीं द्विजाः ।\nसा पुरी विपुलाकारा लक्षयोजनमायता ॥१०४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 7000214104, "chapter_id": 20214, "verse_number": "२१४-१०५", "content_sanskrit": "चतुर्स्रा विनिर्दिष्टा चतुर्द्वारवती शुभा ।\nप्राकाराः काञ्चनास्तस्या योजनायुतमुच्छ्रिताः ॥१०५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 7000214105, "chapter_id": 20214, "verse_number": "२१४-१०६", "content_sanskrit": "इन्द्रनीलमहानीलपद्‌मरागोपशोभिता ।\nसा पुरी विविधैः संघैर्घोरा घोरैः समाकुला ॥१०६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 7000214106, "chapter_id": 20214, "verse_number": "२१४-१०७", "content_sanskrit": "देवदानगन्धर्वैर्यक्षराक्षसपन्नगैः ।\nपूर्वर्द्वारं शुभं तस्याः पताकाशतशोभितम् ॥१०७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 7000214107, "chapter_id": 20214, "verse_number": "२१४-१०८", "content_sanskrit": "वज्रेन्द्रनीलवैदूर्यमुक्ताफलविभूषितम् ।\nगीतनृत्यैः समाकीर्णं गन्धर्वाप्सरसां गणैः ॥१०८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 7000214108, "chapter_id": 20214, "verse_number": "२१४-१०९", "content_sanskrit": "प्रवेशस्तेन देवानामृषीणां योगिनां तथा ।\nगन्धर्वसिद्धयक्षाणां विद्याधरविसर्पिणाम् ॥१०९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 7000214109, "chapter_id": 20214, "verse_number": "२१४-११०", "content_sanskrit": "उत्तरं नगरद्वारं घण्टाचामरभूषितम् ।\nछत्रचामरविन्यासं नानारत्नैरलंकृतम् ॥११०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 7000214110, "chapter_id": 20214, "verse_number": "२१४-१११", "content_sanskrit": "वीणारेणुरवै रम्यैर्गीतमङ्गलनादितैः ।\nऋग्जुःसामनिर्घोषैर्मुनिवृन्दसमाकुलम् ॥१११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 7000214111, "chapter_id": 20214, "verse_number": "२१४-११२", "content_sanskrit": "विशन्ति येन धर्मज्ञाः सत्यव्रतपरायणाः ।\nग्रीष्मे वारिप्रदा ये च शीते चाग्निप्रदा नराः ॥११२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 7000214112, "chapter_id": 20214, "verse_number": "२१४-११३", "content_sanskrit": "श्रान्तसंवाहका ये च प्रियवादरताश्च ये ।\nये च दानरताः शूरा मातापितृपराश्च ये ॥११३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 7000214113, "chapter_id": 20214, "verse_number": "२१४-११४", "content_sanskrit": "द्विजशुश्रूषणे युक्ता नित्यं येऽतिथिपूजकाः ।\nपश्चिमं तु महाद्वारं पुर्या रत्नैर्विभूषितम् ॥११४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}, {"id": 7000214114, "chapter_id": 20214, "verse_number": "२१४-११५", "content_sanskrit": "विचित्रमणिसोपानं तोमरैः समलंकृतम् ।\nभेरीमृदङ्गसमनादैः शङ्खकाहलनादितम् ॥११५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 115}, {"id": 7000214115, "chapter_id": 20214, "verse_number": "२१४-११६", "content_sanskrit": "सिद्धवृन्दैः सदा हृष्टैर्मङ्गलैः प्रणिनादितम् ।\nप्रवेशस्तेन हृष्टानां शिवभक्तिमतांनृणाम् ॥११६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 116}, {"id": 7000214116, "chapter_id": 20214, "verse_number": "२१४-११७", "content_sanskrit": "सर्वतीर्थप्लुता ये च पञ्चाग्नेर्ये च सेवकाः ।\nप्रस्थाने ये मृता वीरा मृताः कालंजरे गिरौ ॥११७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 117}, {"id": 7000214117, "chapter_id": 20214, "verse_number": "२१४-११८", "content_sanskrit": "अग्नौ विपन्ना ये वीराः साधितं वैरनाशकम् ।\nये स्वामिमित्रलोकार्थे गोग्रहे संकुले हता ॥११८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 118}, {"id": 7000214118, "chapter_id": 20214, "verse_number": "२१४-११९", "content_sanskrit": "ते विशन्ति नराः शूराः पश्चिमेन तपोधनाः ।\nपूर्यां तस्या महाघोरं सर्वमत्त्वभयंकरम् ॥११९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 119}, {"id": 7000214119, "chapter_id": 20214, "verse_number": "२१४-१२०", "content_sanskrit": "हाहाकारसमाक्रुष्टं दक्षिणं द्वारमीदृशम् ।\nअन्धकारसमायुक्तं तीक्ष्णश्ङ्गैः समन्वितम् ॥१२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 120}, {"id": 7000214120, "chapter_id": 20214, "verse_number": "२१४-१२१", "content_sanskrit": "कण्टकैर्वृश्चिकैः सर्पैर्वज्रकीटैः सुदुर्गमैः ।\nविलुम्पद्भिर्वृकैर्व्याध्रैर्ऋर्क्षैः सिंहैः सजम्बुकैः ॥१२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 121}, {"id": 7000214121, "chapter_id": 20214, "verse_number": "२१४-१२२", "content_sanskrit": "श्वानमार्जारगृध्रैश्च सज्वालकवलैर्मुखैः ।\nप्रवेशस्तेन वै नित्यं सर्वेषामपकारिणाम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 122}, {"id": 7000214122, "chapter_id": 20214, "verse_number": "२१४-१२३", "content_sanskrit": "ये घातयन्ति विप्रान्गा बालं वृद्धं तथाऽऽतुरम् ।\nशरणागतं विश्वस्तं स्त्रियं मित्रं निरायुधम् ॥१२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 123}, {"id": 7000214123, "chapter_id": 20214, "verse_number": "२१४-१२४", "content_sanskrit": "येऽगम्यागामिनो मूढाः परद्रव्यापहारिणः ।\nनिक्षेपस्यापहर्तारो विषवहिनप्रदाश्च ये ॥१२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 124}, {"id": 7000214124, "chapter_id": 20214, "verse_number": "२१४-१२५", "content_sanskrit": "परभूमिं गृहं शय्यां वस्त्रालंकारहारिणः ।\nपररन्ध्रेषु ये क्रूरा ये सदाऽनृतवादिनः ॥१२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 125}, {"id": 7000214125, "chapter_id": 20214, "verse_number": "२१४-१२६", "content_sanskrit": "ग्रामराष्ट्रपुरस्थाने महादुःखप्रदा हि ये ।\nकूटसाक्षिप्रदादातारः कन्याविक्रयमकारकाः ॥१२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 126}, {"id": 7000214126, "chapter_id": 20214, "verse_number": "२१४-१२७", "content_sanskrit": "अभक्ष्यभक्षणरता ये गच्छन्ति सुतां स्नुषाम् ।\nमातरं पितरं चैवये वदन्ति च पौरुषम् ॥१२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 127}, {"id": 7000214127, "chapter_id": 20214, "verse_number": "२१४-१२८", "content_sanskrit": "अन्ये ये चैव निर्दिष्टा महापातककारिणः ।\nदक्षिणेन तु ते सर्वे द्वारेण प्रविशन्ति वै ॥१२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 128}]