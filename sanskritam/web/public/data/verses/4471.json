[{"id": 2160084, "chapter_id": 4471, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2160085, "chapter_id": 4471, "verse_number": "१", "content_sanskrit": "तथा सम्भाषतां तेषां प्रादुरासीद् धनञ्जयः ।\nदिदृक्षुर्भरतश्रेष्ठं राजानं ससुहृद्गणम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2160086, "chapter_id": 4471, "verse_number": "२", "content_sanskrit": "तं प्रविष्टं शुभां कक्ष्यामभिवन्द्याग्रतः स्थितम् ।\nसमुत्थायासनात् प्रेम्णा सस्वजे पाण्डवोऽर्जुनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2160087, "chapter_id": 4471, "verse_number": "३", "content_sanskrit": "मूर्ध्नि चैनमुपाघ्राय परिमृज्य च पाणिना ।\nआशिषः परमाः प्रोच्य स्मयमानोऽभ्यभाषत\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2160088, "chapter_id": 4471, "verse_number": "४", "content_sanskrit": "व्यक्तमर्जुन सङ्ग्रामे ध्रुवस्तव जयो महान् ।\nतादृग्रूपा हि त्वच्छाया प्रसन्नश्च जनार्दनः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2160089, "chapter_id": 4471, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2160090, "chapter_id": 4471, "verse_number": "५", "content_sanskrit": "तमब्रवीत् ततो जिष्णुर्महदाश्चर्यमुत्तमम् ।\nदृष्टवानस्मि भद्रं ते केशवस्य प्रसादजम्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2160091, "chapter_id": 4471, "verse_number": "६", "content_sanskrit": "ततस्तत् कथयामास यथादृष्टं धनञ्जयः ।\nआश्वासनार्थं सुहृदां त्र्यम्बकेण समागमम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2160092, "chapter_id": 4471, "verse_number": "७", "content_sanskrit": "ततः शिरोभिरवनिं स्पृष्ट्वा सर्वे सुविस्मिताः ।\nनमस्कृत्य वृषाङ्काय साधु साध्वित्यथाब्रुवन्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2160093, "chapter_id": 4471, "verse_number": "८", "content_sanskrit": "अनुज्ञातास्ततः सर्वे सुहृदो धर्मसूनुना ।\nत्वरमाणाः सुसन्नद्धाः तुष्टा युद्धाय निर्ययुः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2160094, "chapter_id": 4471, "verse_number": "९", "content_sanskrit": "अभिवाद्य तु राजानं युयुधानाच्युतार्जुनाः ।\nहृष्टा विनिर्ययुस्ते वै युधिष्ठिरनिवेशनात्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2160095, "chapter_id": 4471, "verse_number": "१०", "content_sanskrit": "रथेनैकेन दुर्धर्षौ युयुधानजनार्दनौ ।\nजग्मतुः सहितौ वीरावर्जुनस्य निवेशनम्\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2160096, "chapter_id": 4471, "verse_number": "११", "content_sanskrit": "तत्र गत्वा हृषीकेशः कल्पयामास शास्त्रवित् ।\nरथं महारथस्याजौ वानरर्षभलक्षणम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2160097, "chapter_id": 4471, "verse_number": "१२", "content_sanskrit": "स मेघसमनिर्घोषः तप्तकाञ्चनभूषणः ।\nबभौ रथवरः क्लृप्तः शशी दिवसकृद् यथा\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2160098, "chapter_id": 4471, "verse_number": "१३", "content_sanskrit": "ततः पुरुषशार्दूलः सज्जं सर्वं न्यवेदयत् ।\nरथं पुरुषसिंहस्य सध्वजं सपताकिनम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2160099, "chapter_id": 4471, "verse_number": "१४", "content_sanskrit": "स तु लोके वरः पुंसां किरीटी हेमवर्मधृक् ।\nबाणी बाणासनी वाहं प्रदक्षिणमवर्तत\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2160100, "chapter_id": 4471, "verse_number": "१५", "content_sanskrit": "अथ विद्यावयोवृद्धैः क्रियावद्भिर्जितेन्द्रियैः ।\nस्तूयमानो जयाशीर्भिरारुरोहार्जुनो रथम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2160101, "chapter_id": 4471, "verse_number": "१६", "content_sanskrit": "जैत्रैः साङ्ग्रामिकैर्मन्त्रैः पूर्वमेव रथोत्तमम् ।\nअभिमन्त्रितमर्चिष्मानुदयं भास्करो यथा\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2160102, "chapter_id": 4471, "verse_number": "१७", "content_sanskrit": "स रथे रथिनां श्रेष्ठः काञ्चने काञ्चनावृतः ।\nविबभौ बहुलार्चिष्मान् मेराविव दिवाकरः\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2160103, "chapter_id": 4471, "verse_number": "१८", "content_sanskrit": "अन्वारूढौ ततः पार्थं तत्र गोविन्दसात्यकौ ।\nशर्यातियज्ञं गच्छन्तं यथा च्यवनमश्विनौ\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2160104, "chapter_id": 4471, "verse_number": "१९", "content_sanskrit": "अथ जग्राह गोविन्दो रथरश्मीन् रथर्षभः ।\nमातलिर्वासवस्येव वृत्रं हन्तुं प्रयास्यतः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2160105, "chapter_id": 4471, "verse_number": "२०", "content_sanskrit": "स ताभ्यां शुशुभे पार्थो रथप्रवरमास्थितः ।\nसहितो बुधशुक्राभ्यां तमो निघ्नन् यथा शशी\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2160106, "chapter_id": 4471, "verse_number": "२१", "content_sanskrit": "सैन्धवस्य वधप्रेप्सुः प्रयातः शत्रुपूगहा ।\nसहाम्बुपतिमित्राभ्यां यथेन्द्रस्तारकामये\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2160107, "chapter_id": 4471, "verse_number": "२२", "content_sanskrit": "ततो वादित्रघोषैश्च मङ्गलैश्च शुभैः स्तवैः ।\nप्रयान्तमर्जुनं सूता मागधाश्चापि तुष्टुवुः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2160108, "chapter_id": 4471, "verse_number": "२३", "content_sanskrit": "सजयाशीःसुपुण्याहः सूतमागधनिस्वनैः ।\nयुक्तो वादित्रघोषेण तेषां प्रीतिकरोऽभवत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2160109, "chapter_id": 4471, "verse_number": "२४", "content_sanskrit": "तमनुप्रवणो वायुः पुण्यगन्धः शिवः शुचिः ।\nववौ संहर्षयन् पार्थं द्विषतश्चापि शोषयन्\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2160110, "chapter_id": 4471, "verse_number": "२५", "content_sanskrit": "प्रादुरासन्निमित्तानि बहूनि विजयाय च ।\nपाण्डवानां त्वदीयानां विपरीतानि मारिष\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2160111, "chapter_id": 4471, "verse_number": "२६", "content_sanskrit": "दृष्ट्वार्जुनो निमित्तानि विजयस्य प्रदक्षिणम् ।\nसैन्येषु सात्यकं सत्यमिदं वचनमब्रवीत्\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2160112, "chapter_id": 4471, "verse_number": "२७", "content_sanskrit": "यथैव च परं कृत्यं सैन्धवस्य वधे धृतम् ।\nतथैव हि परं कृत्यं धर्मराजस्य रक्षणम्\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2160113, "chapter_id": 4471, "verse_number": "२८", "content_sanskrit": "स त्वमद्य महाबाहो राजानं परिपालय ।\nयथैव हि मया गुप्तः त्वया गुप्तस्तथा भवेत्\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2160114, "chapter_id": 4471, "verse_number": "२९", "content_sanskrit": "त्वयि चाहं पराश्वस्तः प्रद्युम्ने वा महारथे ।\nशक्नुयां सैन्धवं हन्तुमनपेक्षो नरर्षभ\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2160115, "chapter_id": 4471, "verse_number": "३०", "content_sanskrit": "मय्यपेक्षा न कर्तव्या गोप्ताऽयं मम केशवः ।\nराज्ञ एव परा गुप्तिः कार्या सात्यक सर्वदा\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2160116, "chapter_id": 4471, "verse_number": "३१", "content_sanskrit": "न हि यत्र महाबाहुर्वासुदेवो व्यवस्थितः ।\nकिञ्चिद् व्यापद्यते तत्र यत्राहमपि च ध्रुवम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2160117, "chapter_id": 4471, "verse_number": "३२", "content_sanskrit": "एवमुक्तस्तु पार्थेन सात्यकः परवीरहा ।\nतथेत्युक्त्वाऽगमत् तत्र यत्र राजा युधिष्ठिरः\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2160118, "chapter_id": 4471, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि षट्सप्ततितमोऽध्यायः ॥ ७६ ॥\nप्रतिज्ञापर्वणि अष्टमोऽध्यायः ॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2160119, "chapter_id": 4471, "verse_number": "", "content_sanskrit": "॥ समाप्तं प्रतिज्ञापर्व ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]