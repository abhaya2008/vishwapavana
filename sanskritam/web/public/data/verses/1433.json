[{"id": 2020671, "chapter_id": 1433, "verse_number": "३-७१-०x", "content_sanskrit": "बृहदश्व उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2020672, "chapter_id": 1433, "verse_number": "३-७१-१", "content_sanskrit": "ततो विदर्भान्संप्राप्तं सायाह्ने सत्यविक्रमम्।\nऋतुपर्णं जना राज्ञे भीमाय प्रत्यवेदयन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2020673, "chapter_id": 1433, "verse_number": "३-७१-२", "content_sanskrit": "स भीमवचनाद्राजा कुण्डिनं प्राविशत्पुरम्।\nनादयन्रथघोषेण सर्वाः स विदिशो दिशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2020674, "chapter_id": 1433, "verse_number": "३-७१-३", "content_sanskrit": "ततस्तं रथनिर्घोषं नलाश्वास्तत्र शुश्रुवुः।\nश्रुत्वा तु समहृष्यन्त पुरेव नलसन्निधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2020675, "chapter_id": 1433, "verse_number": "३-७१-४", "content_sanskrit": "दमयन्ती तु शुश्राव रथघोषं नलस्य तम्।\nयथा मेघस्य नदतो गम्भीरं जलदागमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2020676, "chapter_id": 1433, "verse_number": "३-७१-५", "content_sanskrit": "परं विस्मयमापन्ना श्रुत्वा नादं महास्वनम्।\nनलेन संगृहीतेषु पुरेव नलवाजिषु।\nसदृशं रथनिर्घोषं मेने भैमी तथा हयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2020677, "chapter_id": 1433, "verse_number": "३-७१-६", "content_sanskrit": "प्रासादस्थाश्च शिखिनः शालास्थाश्चैव वारणाः।\nहयाश्च शुश्रुवुस्तस्य रथघोषं महीपतेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2020678, "chapter_id": 1433, "verse_number": "३-७१-७", "content_sanskrit": "तच्छ्रुत्वा रथनिर्घोषं वारणाः शिखिनस्तथा।\nप्रवेदुरुन्मुखा राजन्दृष्ट्वेव जलदोदयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2020679, "chapter_id": 1433, "verse_number": "३-७१-८x", "content_sanskrit": "दमयन्त्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2020680, "chapter_id": 1433, "verse_number": "३-७१-८", "content_sanskrit": "यथाऽसौ रथनिर्घोषः पूरयन्निव मेदिनीम्।\nममाह्लादयते चेतो नल एव महीपतिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2020681, "chapter_id": 1433, "verse_number": "३-७१-९", "content_sanskrit": "अद्य नन्द्राभवक्रं तं न पश्यामि नलं यदि।\nअसंख्येयगुणं वीरं विनङ्क्ष्यामि न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2020682, "chapter_id": 1433, "verse_number": "३-७१-१०", "content_sanskrit": "यदि वै तस्य वीरस्य हाह्वोर्नाद्याहमन्तरम्।\nप्रविशामि सुखस्पर्शं नभविष्याम्यसंशयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2020683, "chapter_id": 1433, "verse_number": "३-७१-११", "content_sanskrit": "यदि मां मेघनिर्घोषो नोपगच्छति नैषधः।\nअद्य चामीकरप्रख्यं प्रवेक्ष्यामि हुताशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2020684, "chapter_id": 1433, "verse_number": "३-७१-१२", "content_sanskrit": "यदि मां सिंहविक्रान्तो मत्तवारणविक्रमः।\nनाभिगच्छतिराजेन्द्रो विनङ्क्ष्यामि न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2020685, "chapter_id": 1433, "verse_number": "३-७१-१३", "content_sanskrit": "न स्मराम्यनृतं किंचिन्न स्मराम्यपकारताम्।\nन च पर्युषितं वाक्यं स्वैरेष्वपि महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2020686, "chapter_id": 1433, "verse_number": "३-७१-१४", "content_sanskrit": "प्रभुः क्षमावान्वीरश्च दाता चाप्यधिको नृपैः।\nअहो नीचानुवर्ती च क्लीबवन्मम नैषध ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2020687, "chapter_id": 1433, "verse_number": "३-७१-१५", "content_sanskrit": "गुणांस्तस्य स्मरन्त्या मे तत्पराया दिवानिशम्।\nहृदयं दीर्यत इदं शोकात्प्रियविनाकृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2020688, "chapter_id": 1433, "verse_number": "३-७१-१६", "content_sanskrit": "एवं विलपमाना सा नष्टसंज्ञेव भारत।\nआरुरोह महद्वेश्म पुण्यश्लोकदिदृक्षया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2020689, "chapter_id": 1433, "verse_number": "३-७१-१७", "content_sanskrit": "ततो मध्यमकक्षायां ददर्श रथमास्थितम्।\nऋतुपर्णं महीपालं सहवार्ष्णेयबाहुकम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2020690, "chapter_id": 1433, "verse_number": "३-७१-१८", "content_sanskrit": "ततोऽवतीर्य वार्ष्णएयो बाहुकश्च रथोत्तमात्।\nहयांस्तानवमुच्याथ स्थापयामासतू रथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2020691, "chapter_id": 1433, "verse_number": "३-७१-१९", "content_sanskrit": "सोऽवतीर्य रथोपस्थादृतुपर्णो नराधिपः।\nउपतस्थे महाराजं भीमं भीमपराक्रमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2020692, "chapter_id": 1433, "verse_number": "३-७१-२०", "content_sanskrit": "तं भीमः प्रतिजग्राह पूजया परया मुदा।\nस तेन पूजितो राज्ञा ऋतुपर्णो नराधिपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2020693, "chapter_id": 1433, "verse_number": "३-७१-२१", "content_sanskrit": "स तत्र कुण्डिने रम्ये वसमानो महीपतिः।\nन च किंचित्तदाऽपश्यत्प्रेक्षमाणो मुहुर्मुहुः।\nस तु राज्ञा समागम्य विदर्भपतिना तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2020694, "chapter_id": 1433, "verse_number": "३-७१-२२", "content_sanskrit": "किं कार्यं स्वागतं तेऽस्तु राज्ञा पृष्टः स भारत।\nनाभिजज्ञे स नृपतिर्दुहित्रर्थे समागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2020695, "chapter_id": 1433, "verse_number": "३-७१-२३", "content_sanskrit": "ऋतुपर्णोपि राजा स धीमान्सत्यपराक्रमः।\nराजानं राजपुत्रं वा न स्म पश्यति कंचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2020696, "chapter_id": 1433, "verse_number": "३-७१-२४", "content_sanskrit": "नैव स्वयंवरकथां न च विप्रसमागमम्।\n`न चान्यं कंचिदारम्भं स्वयंवरविधिं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2020697, "chapter_id": 1433, "verse_number": "३-७१-२५", "content_sanskrit": "ततो विगणयद्राजा मनसा कोसलाधिपः।\nआगतोस्मीत्युवाचैनं भवन्तमभिवादुकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2020698, "chapter_id": 1433, "verse_number": "३-७१-२६", "content_sanskrit": "राजापि च स्मयन्भीमो मनसा समचिन्तयत्।\nअधिकं योजनशतं तस्यागमनकारणम्।\nग्रामान्बहूनतिक्रम्य नाध्यगच्छद्यथातथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2020699, "chapter_id": 1433, "verse_number": "३-७१-२७", "content_sanskrit": "अल्पकार्यं विनिर्दिष्टं तस्यागमनकारणम्।\nपश्चादुदर्के ज्ञास्याप्रि कारणं यद्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2020700, "chapter_id": 1433, "verse_number": "३-७१-२८", "content_sanskrit": "नैतदेवं स नृपतिस्तं सत्कृत्य व्यसर्जयत्।\nविश्राम्यतामित्युवाच क्लान्तोसीति पुनःपुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2020701, "chapter_id": 1433, "verse_number": "३-७१-२९", "content_sanskrit": "स सत्कृतः प्रहृष्टात्मा प्रीतः प्रीतेन पार्थिवः।\nराजप्रेष्यैरनुगतो दिष्टं वेश्म समाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2020702, "chapter_id": 1433, "verse_number": "३-७१-३०", "content_sanskrit": "ऋतुपर्णे गते राजन्वार्ष्णेयसहिते नृपे।\nबाहुको रथमादाय रथशालामुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2020703, "chapter_id": 1433, "verse_number": "३-७१-३१", "content_sanskrit": "स मोचयित्वा तानश्वानुपचर्य च शास्त्रतः।\nस्वयं चैतान्समाश्वास्य रथोपस्थ उपाविशत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2020704, "chapter_id": 1433, "verse_number": "३-७१-३२", "content_sanskrit": "दमयन्त्यपि शोकार्ता दृष्ट्वा भागस्वरिं नृपम्।\nसूतपुत्रं च वार्ष्णेयं बाहुकं च तथाविधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2020705, "chapter_id": 1433, "verse_number": "३-७१-३३", "content_sanskrit": "चिन्तयामास वैदर्भी कस्यैष रथनिःस्वनः।\nनलस्येव महानासीन्न च पश्यामि नैषधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2020706, "chapter_id": 1433, "verse_number": "३-७१-३४", "content_sanskrit": "वार्ष्णोयेन भवेन्नूनं विद्या सैवोपशिक्षिता।\nतेनाद्य रथनिर्घोषो नलस्येव महानभूत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2020707, "chapter_id": 1433, "verse_number": "३-७१-३५", "content_sanskrit": "कआहोस्विदृतुपर्णोऽपि यथा राजा नलस्यथा।\nयथाऽयंरथनिर्घोषो नैषधस्येव लक्ष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2020708, "chapter_id": 1433, "verse_number": "३-७१-३६", "content_sanskrit": "एवं सा तर्कयित्वा तु दमयन्ती विशांपते।\nदूतीं प्रस्थापयामास नैषधान्वेषणे शुभा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2020709, "chapter_id": 1433, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अरण्यपर्वणि नलोपाख्यानपर्वणि एकसप्ततितमोऽध्यायः ॥ ७१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}]