[{"id": 2074201, "chapter_id": 2567, "verse_number": "१२-७२-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2074202, "chapter_id": 2567, "verse_number": "१२-७२-१", "content_sanskrit": "`कीदृशो ब्राह्मणो राजा कार्याकार्यविचारणे।\nक्षमः कर्तुं समर्थो वा तन्मे ब्रूहि पितामह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2074203, "chapter_id": 2567, "verse_number": "१२-७२-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2074204, "chapter_id": 2567, "verse_number": "१२-७२-२", "content_sanskrit": "य एव तु सतो रक्षेदसतश्च निवर्तयेत्।\nस एव राज्ञा कर्तव्यो राजन्राजपुरोहितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2074205, "chapter_id": 2567, "verse_number": "१२-७२-३", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nपुरूरवस ऐलस्य संवादं मातरिश्वना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2074206, "chapter_id": 2567, "verse_number": "१२-७२-४x", "content_sanskrit": "पुरूरवा उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2074207, "chapter_id": 2567, "verse_number": "१२-७२-४", "content_sanskrit": "कुतः स्विद्ब्राह्मणो जातो वर्णाश्चापि कुतस्त्रयः।\nकस्माच्च भवति श्रेयांस्तन्मे व्याख्यातुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2074208, "chapter_id": 2567, "verse_number": "१२-७२-५x", "content_sanskrit": "मातरिश्वोवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2074209, "chapter_id": 2567, "verse_number": "१२-७२-५", "content_sanskrit": "ब्राह्मणो मुखतः सृष्टो ब्रह्मणो राजसत्तम।\nबाहुभ्यां क्षत्रियः सृष्ट ऊरुभ्यां वैश्य एव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2074210, "chapter_id": 2567, "verse_number": "१२-७२-६", "content_sanskrit": "वर्णानां परिचर्यार्यं त्रयाणां भरतर्षभ।\nवर्णश्चतुर्थः पश्चात्तु पभ्द्यां शूद्रो विनिर्मितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2074211, "chapter_id": 2567, "verse_number": "१२-७२-७", "content_sanskrit": "ब्राह्मणो जायमानो हि पृथिव्यामनुजायते।\nईश्वरः सर्वभूतानां धर्मकोशस्य गुप्तये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2074212, "chapter_id": 2567, "verse_number": "१२-७२-८", "content_sanskrit": "`सर्वस्वं ब्राह्मणस्येदं यत्किंचिदिह दृश्यते।\nधर्मयुक्तं प्रशस्तं च जगत्यस्मिन्नृपात्मज॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2074213, "chapter_id": 2567, "verse_number": "१२-७२-९", "content_sanskrit": "ततः पृथिव्या यन्तारं क्षत्रियं दण्डधारणे।\nद्वितीयं वर्णमकरोत्प्रजानामनुगुप्तये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2074214, "chapter_id": 2567, "verse_number": "१२-७२-१०", "content_sanskrit": "वैश्यस्तु धनधान्येन त्रीन्वर्णान्बिभृयादिमान्।\nशूद्रो ह्येतान्परिचरेदिति ब्रह्मानुशासनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2074215, "chapter_id": 2567, "verse_number": "१२-७२-११x", "content_sanskrit": "ऐल उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2074216, "chapter_id": 2567, "verse_number": "१२-७२-११", "content_sanskrit": "द्विजस्य क्षत्रबन्धोर्वा कस्येयं पृथिवी भवेत्।\nधर्मतः सह वित्तेन सम्यग्वायो प्रचक्ष्व मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2074217, "chapter_id": 2567, "verse_number": "१२-७२-१२x", "content_sanskrit": "वायुरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2074218, "chapter_id": 2567, "verse_number": "१२-७२-१२", "content_sanskrit": "विप्रस्य सर्वमेवैतद्यत्किंचिज्जगतीगतम्।\n`धनं धान्यं हिरण्यं च स्त्रियो रत्नानि वाहनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2074219, "chapter_id": 2567, "verse_number": "१२-७२-१३", "content_sanskrit": "मङ्गलं च प्रशस्तं च यच्चान्यदपि विद्यते।\nज्येष्ठेनाभिजनेनेह तद्धर्मकुशला विदुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2074220, "chapter_id": 2567, "verse_number": "१२-७२-१४", "content_sanskrit": "स्वमेव ब्राह्मणो भुङ्क्ते स्वं वस्ते स्वं ददाति च।\nगुरुर्हि सर्ववर्णानां ज्येष्ठः श्रेष्ठश्च वै द्विजः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2074221, "chapter_id": 2567, "verse_number": "१२-७२-१५", "content_sanskrit": "पत्यभावे यथैव स्त्री देवरं कुरुते पतिम्।\n`आनन्तर्यात्तथा क्षत्रं पृथिवी कुरुते पतिम्।\nएष ते प्रथमः कल्प आपद्यन्यो भवेदतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2074222, "chapter_id": 2567, "verse_number": "१२-७२-१६", "content_sanskrit": "यदि स्वर्गे परं स्थानं धर्मतः परिमार्गसि।\nयत्किंचिज्जयसे भूमिं ब्राह्मणाय निवेदय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2074223, "chapter_id": 2567, "verse_number": "१२-७२-१७", "content_sanskrit": "श्रुतवृत्तोपपन्नाय धर्मज्ञाय तपस्विने।\nस्वधर्मपरितृप्ताय यो न वित्तपरो भवेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2074224, "chapter_id": 2567, "verse_number": "१२-७२-१८", "content_sanskrit": "यो राजानं नयेद्बुद्ध्या सर्वतः परिपूर्णया।\nब्राह्मणो हि कुले जातः कृतप्रज्ञो विनीतवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2074225, "chapter_id": 2567, "verse_number": "१२-७२-१९", "content_sanskrit": "श्रेयो नयति राजानं ब्रुवंश्चित्रां सरस्वतीम्।\nराजा चरति यं धर्मं ब्राह्मणेन निदर्शितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2074226, "chapter_id": 2567, "verse_number": "१२-७२-२०", "content_sanskrit": "शुश्रूषुरनहंवादी क्षत्रधर्मव्रते स्थितः।\nतावता सत्कृतः प्राज्ञश्चिरं यशसि तिष्ठति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2074227, "chapter_id": 2567, "verse_number": "१२-७२-२१", "content_sanskrit": "तस्य धर्मस्य सर्वस्य भागी राजपुरोहितः।\nएवमेव प्रजाः सर्वा राजानमभिसंश्रिताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2074228, "chapter_id": 2567, "verse_number": "१२-७२-२२", "content_sanskrit": "`ब्राह्मणं च सविद्वांसं राजशास्त्रविपश्चितम्।\nसम्यग्वृत्ताः स्वधर्मस्था न कुतश्चिद्भयान्विताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2074229, "chapter_id": 2567, "verse_number": "१२-७२-२३", "content_sanskrit": "राष्ट्रे चरन्ति यं धर्मं राज्ञा साध्वभिरक्षिताः।\nचतुर्थं तस्य धर्मस्य राजा भागं तु विन्दति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2074230, "chapter_id": 2567, "verse_number": "१२-७२-२४", "content_sanskrit": "देवा मनुष्याः पितरो गन्धर्वोरगराक्षसाः।\nयज्ञमेवोपजीवन्ति नास्ति यष्टा ह्यराजके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2074231, "chapter_id": 2567, "verse_number": "१२-७२-२५", "content_sanskrit": "इतो दत्तेन जीवन्ति देवताः पितरस्तथा।\nराजन्येवास्य धर्मस्य योगक्षेमः प्रतिष्ठितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2074232, "chapter_id": 2567, "verse_number": "१२-७२-२६", "content_sanskrit": "छायायामप्सु वायौ च सुखमुष्णेऽधिगच्छति।\nअग्नौ वाससि सूर्ये च सुखं शीतेऽधिगच्छति।\nशब्दे स्पर्शे रसे रूपे गन्धे च रमते मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2074233, "chapter_id": 2567, "verse_number": "१२-७२-२७", "content_sanskrit": "तेषु भोगेषु सर्वेषु न भीतो लभते सुखम्।\nअभयस्य हि यो दाता तस्यैव सुमहत्फलम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2074234, "chapter_id": 2567, "verse_number": "१२-७२-२८", "content_sanskrit": "न हि प्राणसमं दानं त्रिषु लोकेषु विद्यते।\nइन्द्रो राजा यमो राजा धर्मो राजा तथैव च।\nराजा बिभर्ति भूतानि राज्ञा सर्वमिदं धृतम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2074235, "chapter_id": 2567, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि द्विसप्ततितमोऽध्यायः॥ ७२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}]