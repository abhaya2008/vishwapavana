[{"id": 7000700000, "chapter_id": 20700, "verse_number": "६-४३-१", "content_sanskrit": "युधिष्ठिर उवाच ।\nसाधु कृष्ण त्वया प्रोक्तमादिदेवो भवान्प्रभो ।\nस्वेदजा अंडजाश्चैव उद्भिज्जाश्च जरायुजाः ॥१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000700001, "chapter_id": 20700, "verse_number": "६-४३-२", "content_sanskrit": "तेषां कर्त्ता विकर्त्ता त्वं पालकः क्षयकारकः ।\nमाघस्य कृष्णपक्षे तु षट्तिला कथिता त्वया ॥२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000700002, "chapter_id": 20700, "verse_number": "६-४३-३", "content_sanskrit": "शुक्ले च का भवेद्देव कथयस्व प्रसादतः ।\nकिं नाम को विधिस्तस्याः को देवस्तत्र पूज्यते ॥३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000700003, "chapter_id": 20700, "verse_number": "६-४३-४", "content_sanskrit": "श्रीकृष्ण उवाच ।\nकथयिष्यामि राजेंद्र शुक्ले माघस्य या भवेत् ।\nजया नामेति विख्याता सर्वपापहरा परा ॥४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000700004, "chapter_id": 20700, "verse_number": "६-४३-५", "content_sanskrit": "पवित्रा पापहंत्री च कामदा मोक्षदा नृणाम् ।\nब्रह्महत्यापहंत्री च पिशाचत्वविनाशिनी ॥५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000700005, "chapter_id": 20700, "verse_number": "६-४३-६", "content_sanskrit": "नैव तस्या व्रते चीर्णे प्रेतत्वं जायते नृणाम् ।\nनातः परतरा काचित्पापघ्नी मोक्षदायिनी ॥६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000700006, "chapter_id": 20700, "verse_number": "६-४३-७", "content_sanskrit": "एतस्मात्कारणाद्राजन्कर्त्तव्या सा प्रयत्नतः ।\nश्रूयतां राजशार्दूल कथा पौराणिकी शुभा ॥७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000700007, "chapter_id": 20700, "verse_number": "६-४३-८", "content_sanskrit": "पंकजे च पुराणेऽस्या महिमा कथितो मया ।\nएकदा नाकलोके वै इंद्रो राज्यं चकार ह ॥८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000700008, "chapter_id": 20700, "verse_number": "६-४३-९", "content_sanskrit": "देवास्तत्र सुखेनैव निवसंति मनोरमे ।\nपीयूषपाननिरता अप्सरोगणसेविताः ॥९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000700009, "chapter_id": 20700, "verse_number": "६-४३-१०", "content_sanskrit": "नंदनं तु वनं तत्र पारिजातोपसेवितम् ।\nरमयंति रमंतेऽत्र अप्सरोभिर्दिवौकसः ॥१० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000700010, "chapter_id": 20700, "verse_number": "६-४३-११", "content_sanskrit": "एकदा रममाणोऽसौ देवेंद्रः स्वेच्छया नृप ।\nनर्त्तयामास वै हर्षात्पंचाशत्कोटिनायकः ॥११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000700011, "chapter_id": 20700, "verse_number": "६-४३-१२", "content_sanskrit": "गंधर्वास्तत्र गायंति गंधर्वः पुष्पदंतकः ।\nचित्रसेनस्तु तत्रैव चित्रसेनसुता तथा ॥१२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000700012, "chapter_id": 20700, "verse_number": "६-४३-१३", "content_sanskrit": "मालिनीति च नाम्ना तु चित्रसेनस्य योषिता ।\nमालिन्यास्तु समुत्पन्ना पुष्पदंती च नामतः ॥१३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000700013, "chapter_id": 20700, "verse_number": "६-४३-१४", "content_sanskrit": "पुष्पदंतस्य पुत्रोऽसौ माल्यवान्नाम नामतः ।\nपुष्पदंत्याश्च रूपेण माल्यवानतिमोहितः ॥१४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000700014, "chapter_id": 20700, "verse_number": "६-४३-१५", "content_sanskrit": "तया ह्येवं कटाक्षैश्च माल्यवांश्च वशीकृतः ।\nलावण्यं रूपसंपन्नं तस्या रूपं निशामय ॥१५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000700015, "chapter_id": 20700, "verse_number": "६-४३-१६", "content_sanskrit": "बाहू तस्याश्च कामेन कंठपाशौ कृताविव ।\nकर्णायते तु नयने रक्तांते घूर्णिते तथा ॥१६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000700016, "chapter_id": 20700, "verse_number": "६-४३-१७", "content_sanskrit": "कर्णौ तु शोभनौ तस्याः कुण्डलाभ्यां नृपोत्तम ।\nकंबुग्रीवायुता सैव दिव्याभरणभूषिता ॥१७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000700017, "chapter_id": 20700, "verse_number": "६-४३-१८", "content_sanskrit": "पीनोन्नतौ कुचौ तस्यास्तौ हेमकलशाविव ।\nमध्यं क्षामं च चार्वंग्या मुष्टिग्राह्यमनुत्तमम् ॥१८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000700018, "chapter_id": 20700, "verse_number": "६-४३-१९", "content_sanskrit": "नितंबौ विस्तृतौ चास्या विस्तीर्णा जघनस्थली ।\nचरणौ शोभमानौ च रक्तोत्पलसमद्युती ॥१९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000700019, "chapter_id": 20700, "verse_number": "६-४३-२०", "content_sanskrit": "ईदृश्या पुष्पवत्या स माल्यवानतिमोहितः ।\nशक्रस्य परितोषाय नृत्यार्थं तौ समागतौ ॥२० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000700020, "chapter_id": 20700, "verse_number": "६-४३-२१", "content_sanskrit": "गायमानौ तु तौ तत्र अप्सरोगणसेवितौ ।\nमदनाभिपरीतांगौ पुष्पदंती च माल्यवान् ॥२१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000700021, "chapter_id": 20700, "verse_number": "६-४३-२२", "content_sanskrit": "परस्परानुरागेण व्यामोहवशमागतौ ।\nन शुद्धगानं गायेतां चित्तभ्रमसमन्वितौ ॥२२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000700022, "chapter_id": 20700, "verse_number": "६-४३-२३", "content_sanskrit": "बद्धदृष्टी तथान्योन्यं कामबाणवशं गतौ ।\nज्ञात्वा लेखर्षभस्तत्र संगतं मानसं तयोः ॥२३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000700023, "chapter_id": 20700, "verse_number": "६-४३-२४", "content_sanskrit": "तालक्रियामानलोपात्तथा गीतविसर्जनात् ।\nचिंतयित्वा तु मघवा ह्यवमानं तथात्मनः ॥२४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000700024, "chapter_id": 20700, "verse_number": "६-४३-२५", "content_sanskrit": "कुपितश्च तयोरर्थे शापं दास्यन्निदं जगौ ।\nधिग्धिग्वां पतितौ मूढावाज्ञाभंग कृतौ मम ॥२५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000700025, "chapter_id": 20700, "verse_number": "६-४३-२६", "content_sanskrit": "युवां पिशाचौ भवतां दंपतीभावधारिणौ ।\nमर्त्यलोकमनुप्राप्तौ भुंजानौ कर्मणः फलम् ॥२६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000700026, "chapter_id": 20700, "verse_number": "६-४३-२७", "content_sanskrit": "एवं मघवता शप्तावुभौ दुःखितमानसौ ।\nहिमवंतं गिरिं प्राप्ताविंद्रशापाद्विमोहितौ ॥२७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000700027, "chapter_id": 20700, "verse_number": "६-४३-२८", "content_sanskrit": "उभौ पिशाचतां प्राप्तौ दारुणं दुःखमेव च ।\nसंतप्तमानसौ तत्र हिमकृच्छ्रगतावुभौ ॥२८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000700028, "chapter_id": 20700, "verse_number": "६-४३-२९", "content_sanskrit": "गंधर्वत्वमप्सरस्त्वं न जानीतो विमौहितौ ।\nपीड्यमानौ निदाघेन देहपातकजेन च ॥२९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000700029, "chapter_id": 20700, "verse_number": "६-४३-३०", "content_sanskrit": "न निशायां सुखं शांतिं लभेते कर्मपीडितौ ।\nपरस्परं वादमानौ चेरतुर्गिरिगह्वरे ॥३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000700030, "chapter_id": 20700, "verse_number": "६-४३-३१", "content_sanskrit": "पीड्यमानौ तु शीतेन तुषारप्रभवेन तौ ।\nदंतघर्षं प्रकुर्वाणौ रोमांचितवपुर्द्धरौ ॥३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000700031, "chapter_id": 20700, "verse_number": "६-४३-३२", "content_sanskrit": "ऊचे पिशाचः स तदा तां पत्नीं स्वां पिशाचिकाम् ।\nकिमनल्पकृतं पापं दारुणं रोमहर्षणम् ॥३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000700032, "chapter_id": 20700, "verse_number": "६-४३-३३", "content_sanskrit": "येन प्राप्तं पिशाचत्वं स्वेन दुष्कृतकर्मणा ।\nनरकं दारुणं मत्वा पिशाचत्वं च दुःखदम् ॥३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000700033, "chapter_id": 20700, "verse_number": "६-४३-३४", "content_sanskrit": "तस्मात्सर्वप्रयत्नेन पातकं न समाचरेत् ।\nइति चिंतापरौ तत्र तावास्तां दुःखकर्षितौ ॥३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000700034, "chapter_id": 20700, "verse_number": "६-४३-३५", "content_sanskrit": "दैवयोगात्तयोः प्राप्ता माघस्यैकादशी तिथिः ।\nजयानामेति विख्याता तिथीनामुत्तमा तिथिः ॥३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000700035, "chapter_id": 20700, "verse_number": "६-४३-३६", "content_sanskrit": "तस्मिन्दिने तु संप्राप्ते तावाहारविवर्जितौ ।\nआसाते तत्र नृपते जलपानविवर्जितौ ॥३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7000700036, "chapter_id": 20700, "verse_number": "६-४३-३७", "content_sanskrit": "न कृतो जीवघातश्च न पत्रफलभक्षणम् ।\nअश्वत्थस्य समीपे तौ सर्वदा दुःखसंयुतौ ॥३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7000700037, "chapter_id": 20700, "verse_number": "६-४३-३८", "content_sanskrit": "रविरस्तंगतो राजंस्तथैव स्थितयोस्तयोः ।\nप्राप्ता चैव निशा घोरा दारुणा प्राणहारिणी ॥३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7000700038, "chapter_id": 20700, "verse_number": "६-४३-३९", "content_sanskrit": "वेपमानौ ततस्तौ तु ततः सुषुपतः क्षितौ ।\nपरस्परेण संलग्नौ गात्रयोर्भुजयोरपि ॥३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7000700039, "chapter_id": 20700, "verse_number": "६-४३-४०", "content_sanskrit": "न निद्रा न रतं तत्र न तौ सौख्यमविंदताम् ।\nएवं तौ राजशार्दूल शापेनेंद्रस्य पीडितौ ॥४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7000700040, "chapter_id": 20700, "verse_number": "६-४३-४१", "content_sanskrit": "इत्थं तयोर्दुःखितयोर्निर्जगाम निशीथिनी ।\nमार्तंड उदयं प्राप्तो द्वादशी दिवसागमे ॥४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7000700041, "chapter_id": 20700, "verse_number": "६-४३-४२", "content_sanskrit": "मया तु राजशार्दूल तयोर्मुक्तिर्धृता हृदि ।\nजयायाः सुव्रतं चीर्णं रात्रौ जागरणं कृतम् ॥४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7000700042, "chapter_id": 20700, "verse_number": "६-४३-४३", "content_sanskrit": "तस्माद्व्रतप्रभावाच्च यथाजातं तथा शृणु ।\nद्वादशीदिवसे प्राप्ते तथा चीर्णे जया व्रते ॥४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7000700043, "chapter_id": 20700, "verse_number": "६-४३-४४", "content_sanskrit": "विष्णोः प्रभावान्नृपते पिशाचत्वं तयोर्गतम् ।\nपुष्पदंती माल्यवतौ पूर्वरूपौ बभूवतुः ॥४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7000700044, "chapter_id": 20700, "verse_number": "६-४३-४५", "content_sanskrit": "पुरातनस्नेहयुतौ पूर्वालंकारधारिणौ ।\nविमानमधिरूढौ तौ गतौ नाके मनोरमे ॥४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7000700045, "chapter_id": 20700, "verse_number": "६-४३-४६", "content_sanskrit": "देवेंद्रस्याग्रतो गत्वा प्रणामं चक्रतुर्मुदा ।\nतथाविधौ तु तौ दृष्ट्वा मघवा विस्मितोऽब्रवीत् ॥४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7000700046, "chapter_id": 20700, "verse_number": "६-४३-४७", "content_sanskrit": "इंद्र उवाच ।\nवद तं केन पुण्येन पिशाचत्वं हि वां गतौ ।\nमम शापं च संप्राप्तौ केन देवेन मोचितौ ॥४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7000700047, "chapter_id": 20700, "verse_number": "६-४३-४८", "content_sanskrit": "माल्यवानुवाच ।\nवासुदेवप्रसादेन जयायास्तु व्रतेन च ।\nपिशाचत्वं गतं स्वामिंस्तव भक्तिप्रभावतः ॥४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7000700048, "chapter_id": 20700, "verse_number": "६-४३-४९", "content_sanskrit": "इति श्रुत्वा तु मघवा प्रत्युवाच पुनस्तथा ।\nपवित्रौ पावनौ जातौ वंदनीयौ ममापि च ॥४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7000700049, "chapter_id": 20700, "verse_number": "६-४३-५०", "content_sanskrit": "हरिवासरकर्तारौ विष्णुभक्तिपरायणौ ।\nहरिवासरसंल्लीना ये च कृष्णपरायणाः ॥५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7000700050, "chapter_id": 20700, "verse_number": "६-४३-५१", "content_sanskrit": "अस्माकमपि मर्त्यास्ते पूज्याश्चैव न संशयः ।\nविहरस्व यथासौख्यं पुष्पदंत्या सुरालये ॥५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7000700051, "chapter_id": 20700, "verse_number": "६-४३-५२", "content_sanskrit": "कृष्ण उवाच ।\nएतस्मात्कारणाद्राजन्कर्त्तव्यो हरिवासरः ।\nजया तु राजशार्दूल ब्रह्महत्यापहारिणी ॥५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7000700052, "chapter_id": 20700, "verse_number": "६-४३-५३", "content_sanskrit": "सर्वदानानि तेनैव सर्वयज्ञा अशेषतः ।\nदत्तानि कारिताश्चैव जयायास्तु व्रतं कृतम् ॥५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7000700053, "chapter_id": 20700, "verse_number": "६-४३-५४", "content_sanskrit": "कल्पकोटिर्भवेत्तावद्वैकुंठे मोदते ध्रुवम् ।\nपठनाच्छ्रवणाद्राजन्नग्निष्टोमफलं लभेत् ॥५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}]