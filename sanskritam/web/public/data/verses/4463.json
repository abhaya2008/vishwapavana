[{"id": 2159476, "chapter_id": 4463, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2159477, "chapter_id": 4463, "verse_number": "१", "content_sanskrit": "पुण्यं यशस्यमाख्यानं श्रुत्वा षोडशराजकम् ।\nअव्याहरन् नरपतिः तूष्णीमासीत् स सृञ्जयः\nतमब्रवीत् तदा दीनं नारदो भगवानृषिः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2159478, "chapter_id": 4463, "verse_number": "२", "content_sanskrit": "कच्चिन्मया व्याहृतं यद् हृदये तत् स्थितं तव ।\nआहोस्विदन्ततो नष्टं श्राद्धं शूद्रपताविव\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2159479, "chapter_id": 4463, "verse_number": "३", "content_sanskrit": "स एवमुक्तः प्रत्याह प्राञ्जलिः सृञ्जयस्तदा \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2159480, "chapter_id": 4463, "verse_number": "४", "content_sanskrit": "पुत्रशोकापहं श्रुत्वा धन्यमाख्यानमुत्तमम् ।\nराजर्षीणां पुराणानां यज्वनां दक्षिणावताम्\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2159481, "chapter_id": 4463, "verse_number": "", "content_sanskrit": "विस्मयेन हते शोके तमसीवार्कतेजसा ।\nविपाप्माऽस्म्यनु मां शाधि यदात्थ करवाणि तत्\t ।५।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2159482, "chapter_id": 4463, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2159483, "chapter_id": 4463, "verse_number": "६", "content_sanskrit": "दिष्ट्याऽपहतशोकस्त्वं वृणीष्व यदिहेच्छसि ।\nतत् ते सम्पत्स्यते सर्वं न मृषावादिनो वयम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2159484, "chapter_id": 4463, "verse_number": "", "content_sanskrit": "सृञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2159485, "chapter_id": 4463, "verse_number": "७", "content_sanskrit": "पावितोऽहमनेनैव प्रसन्नो यद् भवान् मम ।\nप्रसन्नो यस्य भगवान् न तस्यास्तीह दुर्लभम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2159486, "chapter_id": 4463, "verse_number": "", "content_sanskrit": "नारदः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2159487, "chapter_id": 4463, "verse_number": "८", "content_sanskrit": "पुनर्ददामि ते पुत्रं दस्युभिर्निहतं वृथा ।\nउद्धृत्य नरकात् कष्टात् पशुवत् प्रोक्षितं यथा\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2159488, "chapter_id": 4463, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2159489, "chapter_id": 4463, "verse_number": "९", "content_sanskrit": "प्रादुरासीत् ततः पुत्रः सृञ्जयस्याद्भुतप्रभः ।\nदत्तः प्रसन्नेन तदा ऋषिणा दिव्यवर्चसा\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2159490, "chapter_id": 4463, "verse_number": "१०", "content_sanskrit": "ततः सङ्गम्य पुत्रेण प्रीतिमानभवन्नृपः ।\nईजे च क्रतुभिर्मुख्यैः समाप्तवरदक्षिणैः\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2159491, "chapter_id": 4463, "verse_number": "११", "content_sanskrit": "अकृतास्त्रश्च हीनश्च नच सन्नाहकोविदः ।\nअयज्वा चानपत्यश्च ततोऽपि तनयः पुनः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2159492, "chapter_id": 4463, "verse_number": "१२", "content_sanskrit": "शूरो वीरः कृतास्त्रश्च प्रमथ्यारीन् सहस्रशः ।\nअभिमन्युर्गतः स्वर्गं सङ्ग्रामेऽभिमुखो हतः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2159493, "chapter_id": 4463, "verse_number": "१३", "content_sanskrit": "ब्रह्मचर्येण याँल्लोकान् प्रजया च श्रुतेन च ।\nइष्टैश्च क्रतुभिर्यान्ति तान् सौभद्रो गतोऽक्षयान्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2159494, "chapter_id": 4463, "verse_number": "१४", "content_sanskrit": "विद्वांसः कर्मभिः पुण्यैः लभन्ते स्वर्गमुत्तमम् ।\nनतु स्वर्गादयं लोकः काम्यते स्वर्गवासिभिः\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2159495, "chapter_id": 4463, "verse_number": "१५", "content_sanskrit": "तस्मात् स्वर्गं गतो राजन्नर्जुनस्य सुतो वशी ।\nन चेहानयितुं शक्यः किञ्चिदप्राप्यमीहताम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2159496, "chapter_id": 4463, "verse_number": "१६", "content_sanskrit": "यां योगिनो ध्यानविविक्तदर्शिनः\nप्रयान्ति यां चोत्तमयज्विनो जनाः ।\nतपोभिरुग्रैरनुयन्ति यां तथा\nतामक्षयां ते तनयो गतो गतिम्\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2159497, "chapter_id": 4463, "verse_number": "१७", "content_sanskrit": "एवं ज्ञात्वा स्थिरो भूत्वा मा शुचो धैर्यमाप्नुहि ।\nजीवन् हि पुरुषः शोच्यो न तु स्वर्गं गतोऽनघ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2159498, "chapter_id": 4463, "verse_number": "१८", "content_sanskrit": "स शोचानो ह्यघायुश्च अघमेवानुवर्तते ।\nतस्माच्छोकं परित्यज्य श्रेयसि प्रयतेद् बुधः\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2159499, "chapter_id": 4463, "verse_number": "१९", "content_sanskrit": "प्रहर्षं प्रीतिमानन्दं सुखमुत्सिक्तचित्तताम् ।\nएतदाहुर्बुधाः शौचमशौचं शोक उच्यते\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2159500, "chapter_id": 4463, "verse_number": "२०", "content_sanskrit": "एवं विद्वान् समुत्तिष्ठ सुमना भव मा शुचः ।\nश्रुतस्ते सम्भवो मृत्योः तपांस्यनुपमानि च\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2159501, "chapter_id": 4463, "verse_number": "२१", "content_sanskrit": "सर्वभूतसमत्वं च ब्रह्मणा चापि चोदितम् ।\nसृञ्जयस्य तु पुत्रोऽसौ मृतः सञ्जीवितः श्रुतः\nएवं विद्वन् महाराज मा शुचः साधयाम्यहम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2159502, "chapter_id": 4463, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2159503, "chapter_id": 4463, "verse_number": "२२", "content_sanskrit": "एतावदुक्त्वा भगवांस्तत्रैवान्तरधीयत \t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2159504, "chapter_id": 4463, "verse_number": "२३", "content_sanskrit": "वागीशाने भगवति व्यासेऽव्यक्तनभःप्रभे ।\nगते मतिमतां श्रेष्ठे समाश्वास्य युधिष्ठिरम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2159505, "chapter_id": 4463, "verse_number": "२४", "content_sanskrit": "सर्वेषां पार्थिवेन्द्राणां महेन्द्रप्रतिमौजसाम् ।\nन्यायाधिगतवित्तानां श्रुत्वा यज्ञेषु सम्पदः\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2159506, "chapter_id": 4463, "verse_number": "२५", "content_sanskrit": "सम्पूज्य मनसा विद्वान् निःशोकोऽभूद् युधिष्ठिरः ।\nपुनश्चाचिन्तयद् दीनः किंस्विद् वक्ष्ये धनञ्जयम्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2159507, "chapter_id": 4463, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि अष्टषष्टितमोऽध्यायः ॥ ६८ ॥\nअभिमन्युवधपर्वणि सप्तत्रिंशोऽध्यायः ॥ ३७ ॥\n॥ द्रोणसेनापत्ये तृतीयदिनयुद्धसमाप्तिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2159508, "chapter_id": 4463, "verse_number": "", "content_sanskrit": "॥ समाप्तम् अभिमन्युवधपर्व ॥\n– – ० – –", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]