[{"id": 7004949000, "chapter_id": 24949, "verse_number": "७-१-१३२-१", "content_sanskrit": "ईश्वर उवाच ।\nततो गच्छेन्महादेवि वैष्णवीं शक्तिमुत्तमाम् ।\nसोमेशादीशदिग्भागे नातिदूरे व्यवस्थिताम् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004949001, "chapter_id": 24949, "verse_number": "७-१-१३२-२", "content_sanskrit": "सिद्धलक्ष्मीति विख्याता ह्यत्र पीठाधिदेवता ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004949002, "chapter_id": 24949, "verse_number": "७-१-१३२-३", "content_sanskrit": "ब्रह्माण्डे प्रथमं पीठं यत्प्रभासं व्यवस्थितम् ।\nतत्र देवि महापीठे योगिन्यो भूचराः खगाः ।\nभैरवेण समे तास्तु क्रीडन्ते स्वेच्छया प्रिये ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004949003, "chapter_id": 24949, "verse_number": "७-१-१३२-४", "content_sanskrit": "जालंधरं महापीठं कामरूपं तथैव च ।\nश्रीमद्रुद्रनृसिंहं च चतुर्थं पीठमुत्तमम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004949004, "chapter_id": 24949, "verse_number": "७-१-१३२-५", "content_sanskrit": "रत्नवीर्यं महापीठं काश्मीरं पीठमेव च ।\nएतानि देवि पीठानि यो वेत्ति स च मन्त्रवित् ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004949005, "chapter_id": 24949, "verse_number": "७-१-१३२-६", "content_sanskrit": "सर्वेषां चैव पीठानामाधारं पीठमुत्तमम् ।\nसौराष्ट्रे तु महादेवि नाम्ना ख्यातं महोदयम् ।\nकामरूपधरं ज्ञानं यत्राद्यापि प्रवर्तते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004949006, "chapter_id": 24949, "verse_number": "७-१-१३२-७", "content_sanskrit": "तत्र पीठे स्थिता देवी महालक्ष्मीति विश्रुता ।\nसर्वपापप्रशमनी सर्वकार्यशुभप्रदा ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004949007, "chapter_id": 24949, "verse_number": "७-१-१३२-८", "content_sanskrit": "श्रीपञ्चम्यां नरो यस्तु पूजयेत्तां विधानतः ।\nगन्धपुष्पादिभिर्भक्त्या तस्यालक्ष्मीभयं कुतः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004949008, "chapter_id": 24949, "verse_number": "७-१-१३२-९", "content_sanskrit": "उत्तरां दिशमास्थाय महाल क्ष्म्यास्तु सन्निधौ ।\nयो जपेन्मन्त्रराज्ञीं तां सिद्धलक्ष्मीति विश्रुताम् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004949009, "chapter_id": 24949, "verse_number": "७-१-१३२-१०", "content_sanskrit": "लक्षजाप्यविधानेन दीक्षास्नानादिपूर्वकम् ।\nदशांशहोमसंयुक्तं त्रिमधुश्रीफलेसुभिः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004949010, "chapter_id": 24949, "verse_number": "७-१-१३२-११", "content_sanskrit": "एवं प्रत्यक्षतां याति तस्य लक्ष्मीर्न संशयः ।\nददाति वांछितां सिद्धिमिह लोके परत्र च ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004949011, "chapter_id": 24949, "verse_number": "७-१-१३२-१२", "content_sanskrit": "तृतीयायामथा ष्टम्यां चतुर्दश्यां विधानतः ।\nयस्तां पूजयते भक्त्या तस्य सिद्धिः करे स्थिता ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004949012, "chapter_id": 24949, "verse_number": "७-१-१३२-१३", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां सहितायां सप्तमे प्रभासखण्डे प्रथमे प्रभासक्षेत्रमाहात्म्ये सिद्धलक्ष्मीमाहात्म्यवर्णनंनाम द्वात्रिंशदुत्तरशततमोऽध्यायः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}]