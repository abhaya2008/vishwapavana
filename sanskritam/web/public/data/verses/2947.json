[{"id": 2091529, "chapter_id": 2947, "verse_number": "१३-७७-१", "content_sanskrit": "भीष्म उवाच।\nविपुलस्त्वकरोत्तीव्रं तपः कृत्वा गुरोर्वचः।\nतपोयुक्तमथात्मानममन्यत स वीर्यवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2091530, "chapter_id": 2947, "verse_number": "१३-७७-२", "content_sanskrit": "स तेन कर्मणा स्वर्गं पृथिवीं पृथिवीपते।\nचचार गतभीः प्रीतो लब्धकीर्तिवरो नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2091531, "chapter_id": 2947, "verse_number": "१३-७७-३", "content_sanskrit": "उभौ लोकौ जितौ चापि तथैवामन्यत प्रभुः।\nकर्मणा तेन कौरव्य तपसा विपुलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2091532, "chapter_id": 2947, "verse_number": "१३-७७-४", "content_sanskrit": "अथ काले व्यतिक्रान्ते कस्मिंश्चित्कुरुनन्दन।\nरुच्या भगिन्या आदानं प्रभूतदनधान्यवत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2091533, "chapter_id": 2947, "verse_number": "१३-७७-५", "content_sanskrit": "एतस्मिन्नेव काले तु दिव्या काचिद्वराङ्गना।\nबिभ्रती परमं रूपं जगामाथ विहायसा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2091534, "chapter_id": 2947, "verse_number": "१३-७७-६", "content_sanskrit": "तस्याः शरीरात्पुष्पाणि पतितानि महीतले।\nतस्याश्रमस्याविदूरे दिव्यगन्धानि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2091535, "chapter_id": 2947, "verse_number": "१३-७७-७", "content_sanskrit": "तान्यगृह्णात्ततो राजन्रुचिर्ललितलोचना।\nतदा निमन्त्रकस्तस्या अङ्गेभ्यः क्षिप्रमागमत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2091536, "chapter_id": 2947, "verse_number": "१३-७७-८", "content_sanskrit": "तस्या हि भगिनी तात ज्येष्ठा नाम्ना प्रभावती।\nभार्या चित्ररथस्याथ बभूवाङ्गेश्वरस्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2091537, "chapter_id": 2947, "verse_number": "१३-७७-९", "content_sanskrit": "पिनह्य तानि पुष्पाणि केशेषु वरवर्णिनी।\nआमन्त्रिता ततोऽगच्छद्रुचिरङ्गपतेर्गृहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2091538, "chapter_id": 2947, "verse_number": "१३-७७-१०", "content_sanskrit": "पुष्पाणि तानि दृष्ट्वा तु तदाङ्गेन्द्रवराङ्गना।\nभगिनीं चोदयामास पुष्पार्थे चारुलोचना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2091539, "chapter_id": 2947, "verse_number": "१३-७७-११", "content_sanskrit": "सा भर्त्रे सर्वमाचष्ट रुचिः सुरुचिरानना।\nभगिन्या भाषितं सर्वमृषिस्तच्चाभ्यनन्दत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2091540, "chapter_id": 2947, "verse_number": "१३-७७-१२", "content_sanskrit": "ततो विपुलमानाय्य देवशर्मा महातपाः।\nपुष्पार्थे चोदयामास गच्छगच्छेति भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2091541, "chapter_id": 2947, "verse_number": "१३-७७-१३", "content_sanskrit": "विपुलस्तु गुरोर्वाक्यमविचार्य महातपाः।\nस तथेत्यब्रवीद्राजंस्तं च देशं जगाम ह॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2091542, "chapter_id": 2947, "verse_number": "१३-७७-१४", "content_sanskrit": "यस्मिन्देशे तु तान्यासन्पतितानि नभस्तलात्।\nअम्लानान्यपि तत्रासन्कुसुमान्यपराण्यपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2091543, "chapter_id": 2947, "verse_number": "१३-७७-१५", "content_sanskrit": "स ततस्तानि जग्राह दिव्यानि रुचिराणि च।\nप्राप्तानि स्वेन तपसा दिव्यगन्धानि भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2091544, "chapter_id": 2947, "verse_number": "१३-७७-१६", "content_sanskrit": "सम्प्राप्य तानि प्रीतात्मा गुरोर्वचनकारकः।\nतदा जगाम तूर्णं च चम्पां चम्पकमालिनीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2091545, "chapter_id": 2947, "verse_number": "१३-७७-१७", "content_sanskrit": "स वने निर्जने तात ददर्श मिथुनं नृणाम्।\nचक्रवत्परिवर्तन्तं गृहीत्वा पाणिना करम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2091546, "chapter_id": 2947, "verse_number": "१३-७७-१८", "content_sanskrit": "तत्रैकस्तूर्णमगमत्तत्पदे च विवर्तयन्।\nएकस्तु न तदा राजंश्चक्रतुः कलहं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2091547, "chapter_id": 2947, "verse_number": "१३-७७-१९", "content_sanskrit": "त्वं शीघ्रं गच्छसीत्येकोऽब्रवीन्नेति तथाऽपरः।\nपतितेति च तौ राजन्परस्परमथोचतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2091548, "chapter_id": 2947, "verse_number": "१३-७७-२०", "content_sanskrit": "तयोर्विस्पर्धतोरेवं शपथोऽयमभूत्तदा।\nसहसोद्दिश्य विपुलं ततो वाक्यमथोचतुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2091549, "chapter_id": 2947, "verse_number": "१३-७७-२१", "content_sanskrit": "आवयोरनृतं प्राह यस्तस्याभूद्द्विजस्य वै।\nविपुलस्य परे लोके या गतिः सा भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2091550, "chapter_id": 2947, "verse_number": "१३-७७-२२", "content_sanskrit": "एतच्छ्रुत्वा तु विपुलो विषण्णवदनोऽभवत्।\nएवं तीव्रतपाश्चाहं कष्टश्चायं परिश्रमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2091551, "chapter_id": 2947, "verse_number": "१३-७७-२३", "content_sanskrit": "मिथुनस्यास्य किं मे स्यात्कृतं पापं यथा गतिः।\nअनिष्टा सर्वभूतानां कीर्तिताऽनेन मेऽद्य वै॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2091552, "chapter_id": 2947, "verse_number": "१३-७७-२४", "content_sanskrit": "एवं सञ्चिन्तयन्नेव विपुलो राजसत्तम।\nअवाङ्मुखो दीनमना दध्यौ दुष्कृतमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2091553, "chapter_id": 2947, "verse_number": "१३-७७-२५", "content_sanskrit": "ततः षडन्यान्पुरुषानक्षैः काञ्चनराजतैः।\nअपश्यद्दीव्यमानान्वै लोभामर्षान्वितांस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2091554, "chapter_id": 2947, "verse_number": "१३-७७-२६", "content_sanskrit": "कुर्वतः शपथं तेन यः कृतो मिथुनेन तु।\nविपुलं वै समुद्दिश्य तेपि वाक्यमथाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2091555, "chapter_id": 2947, "verse_number": "१३-७७-२७", "content_sanskrit": "लोभमास्थाय योऽस्माकं विषमं कर्तुमुत्सहेत्।\nविपुलस्य परे लोके या गतिस्तामवाप्नुयात्।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2091556, "chapter_id": 2947, "verse_number": "१३-७७-२८", "content_sanskrit": "एतच्छ्रुत्वा तु विपुलो नापश्यद्धर्मसङ्करम्॥\nजन्मप्रभृति कौरव्य कृतपूर्वमथात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2091557, "chapter_id": 2947, "verse_number": "१३-७७-२९", "content_sanskrit": "स प्रदध्यौ तथा राजन्नग्नावग्निरिवाहितः।\nदह्यमानेन मनसा शापं श्रुत्वा तथाविधम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2091558, "chapter_id": 2947, "verse_number": "१३-७७-३०", "content_sanskrit": "तस्य चिन्तयतस्तात बह्वीर्वाचो निशम्य तु।\nइदमासीन्मनसि च रुच्या रक्षणकारितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2091559, "chapter_id": 2947, "verse_number": "१३-७७-३१", "content_sanskrit": "लक्षणं लक्षणेनैव वदनं वदनेन च।\nविधाय न मया चोक्तं सत्यमेतद्गुरोस्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2091560, "chapter_id": 2947, "verse_number": "१३-७७-३२", "content_sanskrit": "एतदात्मनि कौरव्य दुष्कृतं विपुलस्तदा।\nअमन्यत महाभाग तथा तच्च न संशयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2091561, "chapter_id": 2947, "verse_number": "१३-७७-३३", "content_sanskrit": "स चम्पां नगरीमेत्य पुष्पाणि गुरवे ददौ।\nपूजयामास च गुरुं विधिवत्स गुरुप्रियः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2091562, "chapter_id": 2947, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि सप्तसप्ततितमोऽध्यायः॥१३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]