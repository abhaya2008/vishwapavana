[{"id": 2027914, "chapter_id": 1600, "verse_number": "३-२३८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2027915, "chapter_id": 1600, "verse_number": "३-२३८-१", "content_sanskrit": "धृतराष्ट्रस्य तद्वाक्यं निशम्य शकुनिस्तदा।\nदुर्योधनमिदं काले कर्णेन सहितोऽब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2027916, "chapter_id": 1600, "verse_number": "३-२३८-२", "content_sanskrit": "प्रव्राज्य पाण्डवान्वीरान्स्वेन वीर्येण भारत।\nभुङ्क्ष्वेमां पृथिवीमेको दिवि शम्बरहायथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2027917, "chapter_id": 1600, "verse_number": "३-२३८-३", "content_sanskrit": "`तवाद्यपृथिवी राजन्नखिला सागराम्बरा।\nसपर्वतवनाकारा सहस्थावरजङ्गमा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2027918, "chapter_id": 1600, "verse_number": "३-२३८-४", "content_sanskrit": "प्राच्याश्च दाक्षिणात्याश्च पतीच्योदीच्यवासिनः।\nकृताः करप्रदाः सर्वे राजानस्ते नाराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2027919, "chapter_id": 1600, "verse_number": "३-२३८-५", "content_sanskrit": "या हि सा दीप्यमानेव पाण्डवान्भजडते पुरा।\nसाऽद्यलक्ष्मीस्त्वया राजन्नवाप्ता भ्रातृभिः सह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2027920, "chapter_id": 1600, "verse_number": "३-२३८-६", "content_sanskrit": "इन्द्रप्रस्थगते यां तां दीप्यमानां युधिष्ठिरे।\nअपश्याम श्रियं राजन्सुचिरं शोककर्शिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2027921, "chapter_id": 1600, "verse_number": "३-२३८-७", "content_sanskrit": "सा तु बुद्धिबलेनेयं राज्ञस्तस्मात्तथाविधात्।\nत्वयाक्षिप्ता महाबाहो दीप्यमानेव दृश्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2027922, "chapter_id": 1600, "verse_number": "३-२३८-८", "content_sanskrit": "तथैव तव राजेन्द्रराजानः परवीरहन्।\nशासनेऽधिष्ठिताः सर्वेकिं कुर्म इति वादिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2027923, "chapter_id": 1600, "verse_number": "३-२३८-९", "content_sanskrit": "ते वयं पृथिवी राजन्निखिला सागराम्बरा।\nसपर्वतवना देवी सग्रामनगराकरा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2027924, "chapter_id": 1600, "verse_number": "३-२३८-१०", "content_sanskrit": "नानावनोद्देशवती पत्तनैरुपशोभिता।\n`नानाजनपदाकीर्णा स्फीतराष्ट्रा महाहला ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2027925, "chapter_id": 1600, "verse_number": "३-२३८-११", "content_sanskrit": "नन्द्यमानो द्विजै राजन्भासि नक्षत्रराडिव।\nपौरुषाद्दिवि देवेषु भ्राजसे रश्मिवानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2027926, "chapter_id": 1600, "verse_number": "३-२३८-१२", "content_sanskrit": "रुद्रैरिव यमो राजा मरुद्भिरिव वासवः।\nकुरुभिस्त्वं वृतो राजन्भासि नक्षत्रराडिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2027927, "chapter_id": 1600, "verse_number": "३-२३८-१३", "content_sanskrit": "यैः स्म ते नाद्रियेताज्ञा न च ये शासने स्थिताः।\nपश्यामस्ताञ्श्रिया हीनान्पाण्डवान्वनवासिनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2027928, "chapter_id": 1600, "verse_number": "३-२३८-१४", "content_sanskrit": "श्रूयते हि महाराजसरो द्वैतवनं प्रति।\nवसन्तः पाण्डवाः सार्धं ब्राह्मणैर्वनवासिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2027929, "chapter_id": 1600, "verse_number": "३-२३८-१५", "content_sanskrit": "सप्रयाहि महाराज श्रिया परमया युतः।\nतापयन्पाण्डुपुत्रांस्त्वं रश्मिवानिव तेजसा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2027930, "chapter_id": 1600, "verse_number": "३-२३८-१६", "content_sanskrit": "स्तितोराज्येऽच्युतान्राज्याच्छियाहीनाञ्छ्रियावृतः\nअसमृद्धान्समृद्धार्थः पश्य पाण्डुसुतान्नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2027931, "chapter_id": 1600, "verse_number": "३-२३८-१७", "content_sanskrit": "महाभिजनसंपन्नं भद्रे महति संस्थितम्।\nपाण्डवास्त्वाऽभिवीक्षन्तु ययातिमिव नाहुषां ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2027932, "chapter_id": 1600, "verse_number": "३-२३८-१८", "content_sanskrit": "यां श्रियं सुहृदश्चैव दुर्हृदश्च विशांपते।\nपश्यन्ति पौरुषैर्दीप्तां सा समर्था भवत्युत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2027933, "chapter_id": 1600, "verse_number": "३-२३८-१९", "content_sanskrit": "समस्थो विषमस्थान्हि दुर्हृदो योऽभिवीक्षते।\nजगतीस्थनिवाद्रिस्थः किमतः परमं सुखम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2027934, "chapter_id": 1600, "verse_number": "३-२३८-२०", "content_sanskrit": "न पुत्रधनलाभेन न राज्येनापि विन्दति।\nप्रीतिं नृपतिशार्दूल याममित्राधदर्शनात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2027935, "chapter_id": 1600, "verse_number": "३-२३८-२१", "content_sanskrit": "किंनु तस्य सुखं न स्यादाश्रमे यो धनंजयम्।\nअभिवीक्षेत सिद्धार्थो वल्कलाजिनवाससम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2027936, "chapter_id": 1600, "verse_number": "३-२३८-२२", "content_sanskrit": "सुवाससो हि ते भार्या वल्कलाजिनसंवृताम्।\nपश्यन्तु दुःखितां कृष्णां सा च निर्विद्यतां पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2027937, "chapter_id": 1600, "verse_number": "३-२३८-२३", "content_sanskrit": "विनिन्दतां तथाऽत्मानं जीवितं च धनच्युतम्।\n`दाराणां ते श्रियं दृष्ट्वा दीप्तामद्य जनाधिपा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2027938, "chapter_id": 1600, "verse_number": "३-२३८-२४", "content_sanskrit": "न तथा हिसभामध्ये तस्या भवितुमर्हति।\nवैमनस्यं यथा दृष्ट्वा तव भार्याः स्वलंकृताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2027939, "chapter_id": 1600, "verse_number": "३-२३८-२५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2027940, "chapter_id": 1600, "verse_number": "३-२३८-२५", "content_sanskrit": "एवमुक्त्वा तु राजानं कर्णः शकुनिना सह।\nतूष्णीं बभूवतुरुभौ दाक्यान्ते जनमेजय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2027941, "chapter_id": 1600, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाबारते अरण्यपर्वणि धोयात्रापर्वणि अष्टत्रिंशदधिकद्विशततमोऽध्यायः ॥ २३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]