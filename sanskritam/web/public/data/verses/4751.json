[{"id": 2177653, "chapter_id": 4751, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2177654, "chapter_id": 4751, "verse_number": "१", "content_sanskrit": "इङ्गितेनैव दाशार्हस्तस्याभिप्रायमादितः ।\nद्रौणेर्बुद्ध्वा महाबाहुरभ्यभाषत फल्गुनम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2177655, "chapter_id": 4751, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2177656, "chapter_id": 4751, "verse_number": "२", "content_sanskrit": "अर्जुनार्जुन यद्दिव्यमस्त्रं ते हृदि वर्तते ।\nद्रोणोपदिष्टं तस्यायं कालः सम्परिवर्तते\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2177657, "chapter_id": 4751, "verse_number": "३", "content_sanskrit": "भ्रातॄणामात्मनश्चैव परित्राणाय भारत ।\nविसृजैतत् त्वमप्याजावस्त्रमस्त्रनिवारणम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2177658, "chapter_id": 4751, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2177659, "chapter_id": 4751, "verse_number": "४", "content_sanskrit": "केशवेनैवमुक्तस्तु पाण्डवः परवीरहा ।\nरथादवातरत् तूर्णं प्रगृह्य सशरं धनुः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2177660, "chapter_id": 4751, "verse_number": "५", "content_sanskrit": "पूर्वमाचार्यपुत्राय ततोऽनन्तरमात्मने ।\nभ्रातॄणां चैव सर्वेषां स्वस्तीत्युक्त्वा परन्तपः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2177661, "chapter_id": 4751, "verse_number": "६", "content_sanskrit": "देवताभ्यो नमस्कृत्य गुरुभ्यश्चैव सर्वशः ।\nउत्ससर्ज शिवं ध्यायन्नस्त्रमस्त्रेण शाम्यताम्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2177662, "chapter_id": 4751, "verse_number": "७", "content_sanskrit": "ततस्तदस्त्रं सहसा सृष्टं गाण्डीवधन्वना ।\nप्रजज्वाल महाज्वालं युगान्तानलवर्चसम्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2177663, "chapter_id": 4751, "verse_number": "८", "content_sanskrit": "तथैव द्रोणपुत्रस्य तदस्त्रं तिग्मतेजसः ।\nप्रजज्वाल महाज्वालं तेजोमण्डलसंवृतम्\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2177664, "chapter_id": 4751, "verse_number": "९", "content_sanskrit": "निर्घाता बहवश्चासन् पेतुरुल्काः सहस्रशः ।\nमहद्भयं च भूतानां सर्वेषां समजायत\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2177665, "chapter_id": 4751, "verse_number": "१०", "content_sanskrit": "सशब्दमभवद्व्योम ज्वालामालाकुलं भृशम् ।\nचचाल च मही कृत्स्ना सपर्वतवनद्रुमा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2177666, "chapter_id": 4751, "verse_number": "११", "content_sanskrit": "तावस्त्रतेजसा लोकान् त्रासयन्तौ ततः स्थितौ\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2177667, "chapter_id": 4751, "verse_number": "१२", "content_sanskrit": "महर्षी सहितौ तत्र दर्शयामासतुस्तदा ।\nनारदः सर्वधर्मात्मा भरतानां पितामहः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2177668, "chapter_id": 4751, "verse_number": "१३", "content_sanskrit": "उभौ शमयितुं वीरौ भारद्वाजधनञ्जयौ\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2177669, "chapter_id": 4751, "verse_number": "१४", "content_sanskrit": "तौ मुनी सर्वधर्मज्ञौ सर्वभूतहितैषिणौ ।\nदीप्तयोरस्त्रयोर्मध्ये स्थितौ परमतेजसौ\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2177670, "chapter_id": 4751, "verse_number": "१५", "content_sanskrit": "तदन्तरमनाधृष्यावुपगम्य यशस्विनौ ।\nआस्तामृषिवरौ तत्र ज्वलिताविव पावकौ\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2177671, "chapter_id": 4751, "verse_number": "१६", "content_sanskrit": "प्राणभृद्भिरनाधृष्यौ देवदानवसम्मतौ ।\nअस्त्रतेजः शमयितुं लोकानां हितकाम्यया\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2177672, "chapter_id": 4751, "verse_number": "", "content_sanskrit": "ऋषी", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2177673, "chapter_id": 4751, "verse_number": "१७", "content_sanskrit": "नानाशस्त्रविदः पूर्वे ये व्यतीता महारथाः ।\nनैतदस्त्रं मनुष्येषु तैः प्रयुक्तं कथञ्चन\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2177674, "chapter_id": 4751, "verse_number": "१८", "content_sanskrit": "किमिदं साहसं वीरौ कृतवन्तौ महात्ययम्\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2177675, "chapter_id": 4751, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nऐषीकपर्वणि पञ्चमोऽध्यायः ॥५॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}]