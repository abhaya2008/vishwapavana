[{"id": 2186084, "chapter_id": 4951, "verse_number": "", "content_sanskrit": "भीष्मः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2186085, "chapter_id": 4951, "verse_number": "१", "content_sanskrit": "विद्वान् संस्कारयामास पार्थिवो राजधर्मणः ।\nगन्धैर्बहुभिरव्यग्रो दाहयामास तं द्विजम्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2186086, "chapter_id": 4951, "verse_number": "२", "content_sanskrit": "तस्य देवस्य वचनादिन्द्रस्य बकराडिह ।\nतेनैवामृतसिक्तश्च पुनः सञ्जीवितो बकः\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2186087, "chapter_id": 4951, "verse_number": "३", "content_sanskrit": "दग्धो राक्षसराजेन खगराजः प्रतापवान् ।\nचितायाः पार्श्वतो दोग्ध्री सुरभिः प्रीणयच्च तान् \t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2186088, "chapter_id": 4951, "verse_number": "४", "content_sanskrit": "तस्या वक्त्राच्च्युतः फेनो दुग्धमात्रं तदानघ ।\nसमीरणाहृतो यातः कृतान्ते राजधर्मणि ।\nदेवराजस्ततः प्राप्तो विरूपाक्षपुरं तदा\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2186089, "chapter_id": 4951, "verse_number": "५", "content_sanskrit": "विरूपाक्षोऽपि तं प्राप्तं देवराजं समागमत् ।\nकाश्यपस्य सुतो देव भ्राता मे जीवतामिति\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2186090, "chapter_id": 4951, "verse_number": "६", "content_sanskrit": "कौशिकस्त्वब्रवीत् सर्वं प्रीयमाणं पुनः पुनः ।\nब्रह्मणा व्याहृतो रोषाद् राजधर्मा कदाचन\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2186091, "chapter_id": 4951, "verse_number": "७", "content_sanskrit": "यस्मात् त्वं नागतो द्रष्टुं मम नित्यमिमां सभाम् ।\nतस्माद् बको भवान् भावी धर्मशीलः पुराणवित्\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2186092, "chapter_id": 4951, "verse_number": "८", "content_sanskrit": "आगमिष्यति ते वासं कदाचित् पापकर्मकृत् ।\nशबरावासगो विप्रः कृतघ्नो वृषलीपतिः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2186093, "chapter_id": 4951, "verse_number": "९", "content_sanskrit": "यदा निहन्ता मोक्षस्ते तदा भावीत्युवाच तम् ।\nतस्मादेव गतो लोकं ब्रह्मणः परमेष्ठिनः\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2186094, "chapter_id": 4951, "verse_number": "१०", "content_sanskrit": "राजधर्मापि तं प्राह सहस्राक्षमरिन्दमम् ।\nगौतमो ब्राह्मणः क्वासौ मुच्यतां मत्प्रियः सखा\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2186095, "chapter_id": 4951, "verse_number": "११", "content_sanskrit": "तस्य वाक्यं समाज्ञाय कौशिकः सुरसत्तमः ।\nसञ्जीवयित्वा सख्ये वै प्रादात् तं गौतमं तदा\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2186096, "chapter_id": 4951, "verse_number": "१२", "content_sanskrit": "प्रतीतः स गतः सौम्यो राजधर्मा स्वमालयम् ।\nनृशंसो गौतमो मुगक्तो मित्रध्रुक् पुरुषाधमः\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2186097, "chapter_id": 4951, "verse_number": "१३", "content_sanskrit": "स चापि निरयं प्राप्तो दुष्कृतिः कुलपांसनः ।\nएतच्छ्रुत्वा महद्वाक्यं सन्मध्ये नारदेरितम्\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2186098, "chapter_id": 4951, "verse_number": "१४", "content_sanskrit": "मयापि तव राजेन्द्र यथावदनुवर्णितम् ।\nब्रह्मघ्ने च सुरापे च चोरे भ्रष्टव्रते तथा\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2186099, "chapter_id": 4951, "verse_number": "१५", "content_sanskrit": "निष्कृतिर्विहिता राजन् कृतघ्ने नास्ति निष्कृतिः ।\nकुतः कृतघ्नस्य यशः कुतः स्थानं कुतः सुखम्\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2186100, "chapter_id": 4951, "verse_number": "१६", "content_sanskrit": "अश्रद्धेयः कृतघ्नो हि कृतघ्ने नास्ति निष्कृतिः ।\nमित्रद्रोहो न कर्तव्यः पुरुषेण विशेषतः \t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2186101, "chapter_id": 4951, "verse_number": "१७", "content_sanskrit": "मित्रध्रुङ् निरयं घोरं नरकं प्रतिपद्यते ।\nकृतज्ञेन सदा भाव्यं मित्रभावेन चानघ\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2186102, "chapter_id": 4951, "verse_number": "१८", "content_sanskrit": "मित्रात् प्रभवते सर्वं मित्रं धन्यमिति स्मृतम् ।\nअर्थाद्वा मित्रलाभाद्वा मित्रलाभो विशिष्यते\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2186103, "chapter_id": 4951, "verse_number": "१९", "content_sanskrit": "सुलभा मित्रतोऽर्थास्तु मित्रेण यतितुं क्षमम् ।\nमित्रं चाभिमतं स्निग्धं फलं चापि सतां फलम् ।\nसत्कारैः स्वजनोपेतैः पूजयेत विचक्षणः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2186104, "chapter_id": 4951, "verse_number": "२०", "content_sanskrit": "परित्याज्यो बुधैः पापः कृतघ्नो निरपत्रपः ।\nमित्रद्रोही कुलाङ्गारः पापकर्मा नराधमः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2186105, "chapter_id": 4951, "verse_number": "२१", "content_sanskrit": "एष धर्मभृतां श्रेष्ठ प्रोक्तः पापो मया तव ।\nमित्रद्रोही कृतघ्नो वै किं भूयः श्रोतुमिच्छसि \t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2186106, "chapter_id": 4951, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2186107, "chapter_id": 4951, "verse_number": "२२", "content_sanskrit": "एतच्छ्रुत्वा तदा वाक्यं भीष्मेणोक्तं महात्मना ।\nयुधिष्ठिरः प्रीतमना बभूव जनमेजय\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2186108, "chapter_id": 4951, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि आपद्धर्मे एकोनचत्वारिंशोऽध्यायः ॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2186109, "chapter_id": 4951, "verse_number": "", "content_sanskrit": "॥ समाप्तम् आपद्धर्मपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2186110, "chapter_id": 4951, "verse_number": "", "content_sanskrit": "॥ श्रीमध्वेशार्पणमस्तु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}]