[{"id": 7000472000, "chapter_id": 20472, "verse_number": "३-१९-१", "content_sanskrit": "नारद उवाच ।\nभार्गवेशं ततो गच्छेद्भक्त्या यत्र च विष्णुना ।\nहुंकारितास्तु देवेन दानवाः प्रलयं गताः॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7000472001, "chapter_id": 20472, "verse_number": "३-१९-२", "content_sanskrit": "तत्र स्नात्वा तु राजेंद्र सर्वपापैः प्रमुच्यते ।\nशुक्लतीर्थस्य चोत्पत्तिं शृणु त्वं पांडुनंदन॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7000472002, "chapter_id": 20472, "verse_number": "३-१९-३", "content_sanskrit": "हिमवच्छिखरे रम्ये नानाधातुविचित्रिते ।\nतरुणादित्यसंकाशे तप्तकांचनसंनिभे॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7000472003, "chapter_id": 20472, "verse_number": "३-१९-४", "content_sanskrit": "वज्रस्फटिकसोपाने चित्रपट्टशिलातले ।\nजांबूनदमये दिव्ये नाना पद्मोपशोभिते॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7000472004, "chapter_id": 20472, "verse_number": "३-१९-५", "content_sanskrit": "तत्रासीनं महादेवं सर्वज्ञं प्रभुमव्ययम् ।\nलोकानुग्राहकं शांतं गणवृंदैः समावृतम्॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7000472005, "chapter_id": 20472, "verse_number": "३-१९-६", "content_sanskrit": "स्कंदनंदिमहाकालैर्वीरभद्र गणादिभिः ।\nउमया सहितं देवं मार्कंडः परिपृच्छति॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7000472006, "chapter_id": 20472, "verse_number": "३-१९-७", "content_sanskrit": "देवदेव महादेव इन्द्र कामादि संस्तुत ।\nसंसारभवभीतोहं सुखोपायं ब्रवीहि मे॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7000472007, "chapter_id": 20472, "verse_number": "३-१९-८", "content_sanskrit": "भगवन्भूतभव्येश सर्वपापप्रणाशनम् ।\nतीर्थानां परमं तीर्थं तद्वदस्व महेश्वर॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7000472008, "chapter_id": 20472, "verse_number": "३-१९-९", "content_sanskrit": "ईश्वर उवाच ।\nशृणुविप्र महाभाग सर्वशास्त्रविशारद ।\nस्नानादि कुरु गच्छ त्वं ऋषिसंघैस्समावृतः॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7000472009, "chapter_id": 20472, "verse_number": "३-१९-१०", "content_sanskrit": "मन्वत्रि याज्ञवल्क्याश्च काश्यपश्चैव अंगिराः ।\nयमापस्तंब संवर्ताः कात्यायनबृहस्पती॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7000472010, "chapter_id": 20472, "verse_number": "३-१९-११", "content_sanskrit": "नारदो गौतमश्चैव पृच्छंति धर्मकांक्षिणः ।\nगंगाकनखले पुण्या प्रयागं पुष्करं गया॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7000472011, "chapter_id": 20472, "verse_number": "३-१९-१२", "content_sanskrit": "कुरुक्षेत्रं तु पुण्यं च राहुग्रस्ते दिवाकरे ।\nदिवा वा यदि वा रात्रौ शुक्लतीर्थं महाफलम्॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7000472012, "chapter_id": 20472, "verse_number": "३-१९-१३", "content_sanskrit": "दर्शनात्स्पर्शनाच्चैव स्नानाद्ध्यानात्तपोर्जनात् ।\nहोमाच्चैवोपवासाच्च शुक्लतीर्थफलं महत्॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7000472013, "chapter_id": 20472, "verse_number": "३-१९-१४", "content_sanskrit": "शुक्लतीर्थं महापुण्यं नद्यां तु संव्यवस्थितम् ।\nचाणिक्योनाम राजर्षिः सिद्धिं तत्र समागतः॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7000472014, "chapter_id": 20472, "verse_number": "३-१९-१५", "content_sanskrit": "एतत्क्षेत्रं समुत्पन्नं योजनावृत्तिसंस्थितम् ।\nशुक्लतीर्थं महापुण्यं सर्वपापप्रणाशनम्॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7000472015, "chapter_id": 20472, "verse_number": "३-१९-१६", "content_sanskrit": "पादपाग्रेण दृष्टेन ब्रह्महत्यां व्यपोहति ।\nअहमत्र ऋषिश्रेष्ठ तिष्ठामि ह्युमया सह॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7000472016, "chapter_id": 20472, "verse_number": "३-१९-१७", "content_sanskrit": "वैशाखे विमले मासि कृष्णपक्षे चतुर्दशी ।\nकैलासाच्चापि निर्गत्य तत्र संनिहितो ह्यहम्॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7000472017, "chapter_id": 20472, "verse_number": "३-१९-१८", "content_sanskrit": "देवकिन्नरगंधर्वाः सिद्धविद्याधरास्तथा ।\nगणाश्चाप्सरसो नागाः सर्वे देवाः समागताः॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7000472018, "chapter_id": 20472, "verse_number": "३-१९-१९", "content_sanskrit": "गगनस्थास्तु तिष्ठंति विमानैः सर्वकामकैः ।\nशुक्लतीर्थे तु राजेंद्र आगता धर्मकांक्षिणः॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7000472019, "chapter_id": 20472, "verse_number": "३-१९-२०", "content_sanskrit": "रजकेन यथा वस्त्रं शुक्लं भवति वारिणा ।\nआजन्मसंचितं पापं शुक्लतीर्थे व्यपोहति॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7000472020, "chapter_id": 20472, "verse_number": "३-१९-२१", "content_sanskrit": "स्नानं दानं महापुण्यं मार्कंड ऋषिसत्तम ।\nशुक्लतीर्थात्परं तीर्थं न भूतं न भविष्यति॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7000472021, "chapter_id": 20472, "verse_number": "३-१९-२२", "content_sanskrit": "पूर्वे वयसि कर्माणि कृत्वा पापानि मानवः ।\nअहोरात्रोपवासेन शुक्लतीर्थे व्यपोहति॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7000472022, "chapter_id": 20472, "verse_number": "३-१९-२३", "content_sanskrit": "तपसा ब्रह्मचर्येण यज्ञैर्दानेन वा पुनः ।\nदेवदानेन या पुष्टिर्न सा क्रतुशतैरपि॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7000472023, "chapter_id": 20472, "verse_number": "३-१९-२४", "content_sanskrit": "कार्तिकस्य च मासस्य कृष्णपक्षे चतुर्दशी ।\nघृतेन स्नापयेद्देवमुपोष्य परमेश्वरम्॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7000472024, "chapter_id": 20472, "verse_number": "३-१९-२५", "content_sanskrit": "एकविंशत्कुलोपेतो न च्यवेच्चैश्वरात्पदात् ।\nशुक्लतीर्थं परं तीर्थमृषिसिद्धनिषेवितम्॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7000472025, "chapter_id": 20472, "verse_number": "३-१९-२६", "content_sanskrit": "तत्र स्नात्वा ततो राजन्पुनर्जन्म न विद्यते ।\nस्नात्वा वै शुक्लतीर्थेपि अर्चयेद्वृषभध्वजम्॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7000472026, "chapter_id": 20472, "verse_number": "३-१९-२७", "content_sanskrit": "जागरं कारयेत्तत्र नृत्यगीतादिमंगलैः ।\nप्रभाते शुक्लतीर्थे तु स्नानं वै देवतार्चनम्॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7000472027, "chapter_id": 20472, "verse_number": "३-१९-२८", "content_sanskrit": "आचार्यं भोजयेत्पश्चाच्छिवव्रतपरः शुचिः ।\nभोजनं च यथाशक्त्या वित्तशाठ्यं न कारयेत्॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7000472028, "chapter_id": 20472, "verse_number": "३-१९-२९", "content_sanskrit": "प्रदक्षिणं ततः कृत्वा शनैर्देवांतिकं व्रजेत् ।\nएवं वै कुरुते यस्तु तस्य पुण्यफलं शृणु॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7000472029, "chapter_id": 20472, "verse_number": "३-१९-३०", "content_sanskrit": "दिव्ययानसमारूढस्तूयमानोऽप्सरोगणैः ।\nशिवतुल्यबलोपेतस्तिष्ठत्याभूतसंप्लवम्॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7000472030, "chapter_id": 20472, "verse_number": "३-१९-३१", "content_sanskrit": "शुक्लतीर्थे तु या नारी ददाति कनकं शुभम् ।\nघृतेन स्नापयेद्देवं कुमारं चाभिपूजयेत्॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7000472031, "chapter_id": 20472, "verse_number": "३-१९-३२", "content_sanskrit": "एवं या कुरुते भक्त्या तस्याः पुण्यफलं शृणु ।\nमोदते देवलोकस्था यावदिंद्राश्चतुर्दश॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7000472032, "chapter_id": 20472, "verse_number": "३-१९-३३", "content_sanskrit": "अयने वा चतुर्दश्यां संक्रांतौ विषुवे तथा ।\nस्नात्वा तु सोपवासः स निर्जितात्मा समाहितः॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7000472033, "chapter_id": 20472, "verse_number": "३-१९-३४", "content_sanskrit": "दानं दद्याद्यथाशक्त्या प्रीयेतां हरिशंकरौ ।\nशुक्लतीर्थप्रभावेण सर्वं भवति चाक्षयम्॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7000472034, "chapter_id": 20472, "verse_number": "३-१९-३५", "content_sanskrit": "अनाथं दुर्गतं विप्रं नाथवंतमथापि वा ।\nउद्वाहयति यस्तीर्थे तस्य पुण्यफलं शृणु॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7000472035, "chapter_id": 20472, "verse_number": "३-१९-३६", "content_sanskrit": "यावत्तद्रोमसंख्या तु तत्प्रसूतिकुलेषु च ।\nतावद्वर्षसहस्राणि शिवलोके महीयते॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}]