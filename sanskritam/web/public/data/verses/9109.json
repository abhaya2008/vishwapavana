[{"id": 5000109000, "chapter_id": 9109, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अयोध्याकाण्डे द्वात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000109001, "chapter_id": 9109, "verse_number": "२-३२-१", "content_sanskrit": "ततः शासनमाज्ञाय भ्रातुः प्रियकरं हितम्।\nगत्वा स प्रविवेशाशु सुयज्ञस्य निवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000109002, "chapter_id": 9109, "verse_number": "२-३२-२", "content_sanskrit": "तं विप्रमग्न्यगारस्थं वन्दित्वा लक्ष्मणोऽब्रवीत्।\nसखेऽभ्यागच्छ पश्य त्वं वेश्म दुष्करकारिणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000109003, "chapter_id": 9109, "verse_number": "२-३२-३", "content_sanskrit": "ततः संध्यामुपास्थाय गत्वा सौमित्रिणा सह।\nऋद्धं स प्राविशल्लक्ष्म्या रम्यं रामनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000109004, "chapter_id": 9109, "verse_number": "२-३२-५", "content_sanskrit": "जातरूपमयैर्मुख्यैरङ्गदैः कुण्डलैः शुभैः।\nसहेमसूत्रैर्मणिभिः केयूरैर्वलयैरपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000109005, "chapter_id": 9109, "verse_number": "२-३२-६", "content_sanskrit": "अन्यैश्च रत्नैर्बहुभिः काकुत्स्थः प्रत्यपूजयत्।\nसुयज्ञं स तदोवाच रामः सीताप्रचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000109006, "chapter_id": 9109, "verse_number": "२-३२-७", "content_sanskrit": "हारं च हेमसूत्रं च भार्यायै सौम्य हारय।\nरशनां चाथ सा सीता दातुमिच्छति ते सखी ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000109007, "chapter_id": 9109, "verse_number": "२-३२-८", "content_sanskrit": "अङ्गदानि च चित्राणि केयूराणि शुभानि च।\nप्रयच्छति सखी तुभ्यं भार्यायै गच्छती वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000109008, "chapter_id": 9109, "verse_number": "२-३२-९", "content_sanskrit": "पर्यङ्कमग्र्यास्तरणं नानारत्नविभूषितम्।\nतमपीच्छति वैदेही प्रतिष्ठापयितुं त्वयि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000109009, "chapter_id": 9109, "verse_number": "२-३२-१०", "content_sanskrit": "नागः शत्रुंजयो नाम मातुलोऽयं ददौ मम।\nतं ते निष्कसहस्रेण ददामि द्विजपुङ्गव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000109010, "chapter_id": 9109, "verse_number": "२-३२-११", "content_sanskrit": "इत्युक्तः स तु रामेण सुयज्ञः प्रतिगृह्य तत्।\nरामलक्ष्मणसीतानां प्रयुयोजाशिषः शिवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000109011, "chapter_id": 9109, "verse_number": "२-३२-१२", "content_sanskrit": "अथ भ्रातरमव्यग्रं प्रियं रामः प्रियंवदम्।\nसौमित्रिं तमुवाचेदं ब्रह्मेव त्रिदशेश्वरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000109012, "chapter_id": 9109, "verse_number": "२-३२-१३", "content_sanskrit": "अगस्त्यं कौशिकं चैव तावुभौ ब्राह्मणोत्तमौ।\nअर्चयाहूय सौमित्रे रत्नैः सस्यमिवाम्बुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000109013, "chapter_id": 9109, "verse_number": "२-३२-१४", "content_sanskrit": "तर्पयस्व महाबाहो गोसहस्रेण राघव।\nसुवर्णरजतैश्चैव मणिभिश्च महाधनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000109014, "chapter_id": 9109, "verse_number": "२-३२-१५", "content_sanskrit": "कौसल्यां च य आशीर्भिर्भक्तः पर्युपतिष्ठति।\nआचार्यस्तैत्तिरीयाणामभिरूपश्च वेदवित् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000109015, "chapter_id": 9109, "verse_number": "२-३२-१६", "content_sanskrit": "तस्य यानं च दासीश्च सौमित्रे सम्प्रदापय।\nकौशेयानि च वस्त्राणि यावत् तुष्यति स द्विजः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000109016, "chapter_id": 9109, "verse_number": "२-३२-१७", "content_sanskrit": "सूतश्चित्ररथश्चार्यः सचिवः सुचिरोषितः।\nतोषयैनं महार्हैश्च रत्नैर्वस्त्रैर्धनैस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000109017, "chapter_id": 9109, "verse_number": "२-३२-१८", "content_sanskrit": "पशुकाभिश्च सर्वाभिर्गवां दशशतेन च।\nये चेमे कठकालापा बहवो दण्डमाणवाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000109018, "chapter_id": 9109, "verse_number": "२-३२-१९", "content_sanskrit": "नित्यस्वाध्यायशीलत्वान्नान्यत् कुर्वन्ति किंचन।\nअलसाः स्वादुकामाश्च महतां चापि सम्मताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000109019, "chapter_id": 9109, "verse_number": "२-३२-२०", "content_sanskrit": "तेषामशीतियानानि रत्नपूर्णानि दापय।\nशालिवाहसहस्रं च द्वे शते भद्रकांस्तथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000109020, "chapter_id": 9109, "verse_number": "२-३२-२१", "content_sanskrit": "व्यञ्जनार्थं च सौमित्रे गोसहस्रमुपाकुरु।\nमेखलीनां महासङ्घः कौसल्यां समुपस्थितः।\nतेषां सहस्रं सौमित्रे प्रत्येकं सम्प्रदापय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000109021, "chapter_id": 9109, "verse_number": "२-३२-२२", "content_sanskrit": "अम्बा यथा नो नन्देच्च कौसल्या मम दक्षिणाम्।\nतथा द्विजातींस्तान् सर्वाल्ँलक्ष्मणार्चय सर्वशः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000109022, "chapter_id": 9109, "verse_number": "२-३२-२३", "content_sanskrit": "ततः पुरुषशार्दूलस्तद् धनं लक्ष्मणः स्वयम्।\nयथोक्तं ब्राह्मणेन्द्राणामददाद् धनदो यथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000109023, "chapter_id": 9109, "verse_number": "२-३२-२४", "content_sanskrit": "अथाब्रवीद् बाष्पगलांस्तिष्ठतश्चोपजीविनः।\nस प्रदाय बहुद्रव्यमेकैकस्योपजीवनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000109024, "chapter_id": 9109, "verse_number": "२-३२-२५", "content_sanskrit": "लक्ष्मणस्य च यद् वेश्म गृहं च यदिदं मम।\nअशून्यं कार्यमेकैकं यावदागमनं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000109025, "chapter_id": 9109, "verse_number": "२-३२-२६", "content_sanskrit": "इत्युक्त्वा दुःखितं सर्वं जनं तमुपजीविनम्।\nउवाचेदं धनाध्यक्षं धनमानीयतां मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000109026, "chapter_id": 9109, "verse_number": "२-३२-२७", "content_sanskrit": "ततोऽस्य धनमाजह्रुः सर्व एवोपजीविनः।\nस राशिः सुमहांस्तत्र दर्शनीयो ह्यदृश्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000109027, "chapter_id": 9109, "verse_number": "२-३२-२८", "content_sanskrit": "ततः स पुरुषव्याघ्रस्तद् धनं सहलक्ष्मणः।\nद्विजेभ्यो बालवृद्धेभ्यः कृपणेभ्यो ह्यदापयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000109028, "chapter_id": 9109, "verse_number": "२-३२-२९", "content_sanskrit": "तत्रासीत् पिङ्गलो गार्ग्यस्त्रिजटो नाम वै द्विजः।\nक्षतवृत्तिर्वने नित्यं फालकुद्दाललाङ्गली ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000109029, "chapter_id": 9109, "verse_number": "२-३२-३०", "content_sanskrit": "तं वृद्धं तरुणी भार्या बालानादाय दारकान्।\nअब्रवीद् ब्राह्मणं वाक्यं स्त्रीणां भर्ता हि देवता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000109030, "chapter_id": 9109, "verse_number": "२-३२-३१", "content_sanskrit": "अपास्य फालं कुद्दालं कुरुष्व वचनं मम।\nरामं दर्शय धर्मज्ञं यदि किंचिदवाप्स्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000109031, "chapter_id": 9109, "verse_number": "२-३२-३२", "content_sanskrit": "स भार्याया वचः श्रुत्वा शाटीमाच्छाद्य दुश्छदाम्।\nस प्रातिष्ठत पन्थानं यत्र रामनिवेशनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000109032, "chapter_id": 9109, "verse_number": "२-३२-३३", "content_sanskrit": "भृग्वङ्गिरःसमं दीप्त्या त्रिजटं जनसंसदि।\nआपञ्चमायाः कक्ष्याया नैतं कश्चिदवारयत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000109033, "chapter_id": 9109, "verse_number": "२-३२-३४", "content_sanskrit": "स राममासाद्य तदा त्रिजटो वाक्यमब्रवीत्।\nनिर्धनो बहुपुत्रोऽस्मि राजपुत्र महाबल ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000109034, "chapter_id": 9109, "verse_number": "२-३२-३५", "content_sanskrit": "क्षतवृत्तिर्वने नित्यं प्रत्यवेक्षस्व मामिति।\nतमुवाच ततो रामः परिहाससमन्वितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000109035, "chapter_id": 9109, "verse_number": "२-३२-३६", "content_sanskrit": "गवां सहस्रमप्येकं न च विश्राणितं मया।\nपरिक्षिपसि दण्डेन यावत्तावदवाप्स्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000109036, "chapter_id": 9109, "verse_number": "२-३२-३७", "content_sanskrit": "स शाटीं परितः कट्यां सम्भ्रान्तः परिवेष्ट्य ताम्।\nआविध्य दण्डं चिक्षेप सर्वप्राणेन वेगतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000109037, "chapter_id": 9109, "verse_number": "२-३२-३८", "content_sanskrit": "स तीर्त्वा सरयूपारं दण्डस्तस्य कराच्च्युतः।\nगोव्रजे बहुसाहस्रे पपातोक्षणसंनिधौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000109038, "chapter_id": 9109, "verse_number": "२-३२-३९", "content_sanskrit": "तं परिष्वज्य धर्मात्मा आ तस्मात् सरयूतटात्।\nआनयामास ता गावस्त्रिजटस्याश्रमं प्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000109039, "chapter_id": 9109, "verse_number": "२-३२-४०", "content_sanskrit": "उवाच च तदा रामस्तं गार्ग्यमभिसान्त्वयन्।\nमन्युर्न खलु कर्तव्यः परिहासो ह्ययं मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000109040, "chapter_id": 9109, "verse_number": "२-३२-४१", "content_sanskrit": "इदं हि तेजस्तव यद् दुरत्ययं\nतदेव जिज्ञासितुमिच्छता मया।\nइमं भवानर्थमभिप्रचोदितो\nवृणीष्व किंचेदपरं व्यवस्यसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000109041, "chapter_id": 9109, "verse_number": "२-३२-४२", "content_sanskrit": "ब्रवीमि सत्येन न ते स्म यन्त्रणां\nधनं हि यद्यन्मम विप्रकारणात्।\nभवत्सु सम्यक्प्रतिपादनेन\nमयार्जितं चैव यशस्करं भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000109042, "chapter_id": 9109, "verse_number": "२-३२-४३", "content_sanskrit": "ततः सभार्यस्त्रिजटो महामुनि-\nर्गवामनीकं प्रतिगृह्य मोदितः।\nयशोबलप्रीतिसुखोपबृंहिणी-\nस्तदाशिषः प्रत्यवदन्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000109043, "chapter_id": 9109, "verse_number": "२-३२-४४", "content_sanskrit": "स चापि रामः प्रतिपूर्णपौरुषो\nमहाधनं धर्मबलैरुपार्जितम्।\nनियोजयामास सुहृज्जने चिराद्\nयथार्हसम्मानवचः प्रचोदितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000109044, "chapter_id": 9109, "verse_number": "२-३२-४५", "content_sanskrit": "द्विजः सुहृद् भृत्यजनोऽथवा तदा\nदरिद्रभिक्षाचरणश्च यो भवेत्।\nन तत्र कश्चिन्न बभूव तर्पितो\nयथार्हसम्माननदानसम्भ्रमैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000109045, "chapter_id": 9109, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अयोध्याकाण्डे द्वात्रिंशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}]