[{"id": 2180209, "chapter_id": 4816, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2180210, "chapter_id": 4816, "verse_number": "१", "content_sanskrit": "तूष्णीम्भूतं तु राजानं शोचमानं युधिष्ठिरम् ।\nतपस्वी धर्मतत्त्वज्ञः कृष्णद्वैपायनोऽब्रवीत्\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2180211, "chapter_id": 4816, "verse_number": "२", "content_sanskrit": "प्रजानां पालनं धर्मो राज्ञां राजीवलोचन ।\nधर्मः प्रमाणं लोकस्य नित्यं धर्मानुवर्तनम्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2180212, "chapter_id": 4816, "verse_number": "३", "content_sanskrit": "अनुतिष्ठस्व वै राजन् पितृपैतामहं पदम् ।\nब्राह्मणेषु च यो धर्मः स नित्यो वेदनिश्चितः\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2180213, "chapter_id": 4816, "verse_number": "४", "content_sanskrit": "तत् प्रमाणं प्रमाणानां शाश्वतं भरतर्षभ ।\nतस्य धर्मस्य कृत्स्नस्य क्षत्रियः परिरक्षिता\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2180214, "chapter_id": 4816, "verse_number": "५", "content_sanskrit": "तथा यः प्रतिहन्त्यस्य शासनं विषये नरः ।\nस बाहुभ्यां विनिग्राह्यो लोकयात्राविघातकः\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2180215, "chapter_id": 4816, "verse_number": "६", "content_sanskrit": "प्रमाणमप्रमाणं यः कुर्यान्मोहवशं गतः ।\nभृत्यो वा यदि वा पुत्रस्तपस्वी वापि कश्चन ।\nपापान् सर्वैरुपायैस्तान् नियच्छेद् घातयेत वा\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2180216, "chapter_id": 4816, "verse_number": "७", "content_sanskrit": "अतोऽन्यथा वर्तमानो राजा प्राप्नोति किल्बिषम् ।\nधर्मं विनश्यमानं हि यो न रक्षेत् स धर्महा\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2180217, "chapter_id": 4816, "verse_number": "८", "content_sanskrit": "ते त्वया धर्महन्तारो निहताः सपदानुगाः ।\nस्वधर्मे वर्तमानस्त्वं किन्नु शोचसि पाण्डव ।\nराजा हि हन्याद् दद्याच्च प्रजा रक्षेच्च धर्मतः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2180218, "chapter_id": 4816, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2180219, "chapter_id": 4816, "verse_number": "९", "content_sanskrit": "न तेऽभिशङ्के वचनं यद् ब्रवीषि तपोधन ।\nअपरोक्षो हि ते धर्मः सर्वधर्मभृतां वर\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2180220, "chapter_id": 4816, "verse_number": "१०", "content_sanskrit": "मया ह्यवध्या बहवो घातिता राज्यकारणात् ।\nतान्यकार्याणि मे ब्रह्मन् दहन्ति च तपन्ति च\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2180221, "chapter_id": 4816, "verse_number": "", "content_sanskrit": "व्यासः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2180222, "chapter_id": 4816, "verse_number": "११", "content_sanskrit": "ईश्वरो वा भवेत् कर्ता पुरुषो वापि भारत ।\nभद्रे वा वर्तते लोके कर्मजं वा फलं स्मृतम्\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2180223, "chapter_id": 4816, "verse_number": "१२", "content_sanskrit": "ईश्वरेण नियुक्ता हि साध्वसाधु च पार्थिव ।\nकुर्वन्ति पुरुषाः कर्म फलमीश्वरगामि तत्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2180224, "chapter_id": 4816, "verse_number": "१३", "content_sanskrit": "यथा हि पुरुषश्छिन्द्याद् वृक्षं परशुना वने ।\nछेत्तुरेव भवेत् पापं परशोर्न कथञ्चन\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2180225, "chapter_id": 4816, "verse_number": "१४", "content_sanskrit": "अथवा तदुपादानात् प्राप्नुयुः कर्मणः फलम् ।\nदण्डशस्त्रकृतं पापं पुरुषे तन्न विद्यते\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2180226, "chapter_id": 4816, "verse_number": "१५", "content_sanskrit": "नचैतदिष्टं कौन्तेय यदन्येन फलं कृतम् ।\nप्राप्नुयादिति तस्माच्च ईश्वरे तन्निवेशय\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2180227, "chapter_id": 4816, "verse_number": "१६", "content_sanskrit": "अथवा पुरुषः कर्ता कर्मणोः शुभपापयोः ।\nन परं विद्यते स्मादेवमन्यच्छुभं कुरु\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2180228, "chapter_id": 4816, "verse_number": "१७", "content_sanskrit": "नहि कश्चिद् क्वचिद् राजन् दिष्टान् प्रतिनिवर्तते ।\nदण्डशास्त्रकृतं पापं पुरुषे तन्न विद्यते \t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2180229, "chapter_id": 4816, "verse_number": "१८", "content_sanskrit": "यदि वा मन्यसे राजन् हठे सर्वं प्रतिष्ठितम् ।\nएवमप्यशुभं कर्म न भूतं न भविष्यति\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2180230, "chapter_id": 4816, "verse_number": "१९", "content_sanskrit": "अथाभिपत्तिर्लोकस्य कर्तव्या पुण्यपापयोः ।\nअभिपन्नमिदं लोके राज्ञामुद्यतदण्डनम्\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2180231, "chapter_id": 4816, "verse_number": "२०", "content_sanskrit": "अद्यापि लोके कर्माणि समावर्तन्त भारत ।\nशुभाशुभफलं चेमे प्राप्नुवन्तीति मे मतिः\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2180232, "chapter_id": 4816, "verse_number": "२१", "content_sanskrit": "एवं सत्यं शुभादेशं कर्मणस्तत्फलं ध्रुवम् ।\nत्यज तद् राजशार्दूल मैवं शोके मनः कृथाः\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2180233, "chapter_id": 4816, "verse_number": "२२", "content_sanskrit": "स्वधर्मे वर्तमानस्य सापवादेऽपि भारत ।\nएवमात्मपरित्यागस्तव राजन्न शोभनः\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2180234, "chapter_id": 4816, "verse_number": "२३", "content_sanskrit": "विहितानीह कौन्तेय प्रायश्चित्तानि कर्मिणाम् ।\nशरीरवांस्तानि कुर्यादशरीरः पराभवेत्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2180235, "chapter_id": 4816, "verse_number": "२४", "content_sanskrit": "तद् राजन् जीवमानस्त्वं प्रायश्चित्तं चरिष्यसि ।\nप्रायश्चित्तमकृत्वा तु प्रेत्य तप्तासि भारत\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2180236, "chapter_id": 4816, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2180237, "chapter_id": 4816, "verse_number": "२५", "content_sanskrit": "हताः पुत्राश्च पौत्राश्च भ्रातरः पितरस्तथा ।\nश्वशुरा गुरवश्चैव मातुलाः सपितामहाः\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2180238, "chapter_id": 4816, "verse_number": "२६", "content_sanskrit": "क्षत्रियाश्च महात्मानः सम्बन्धिसुहृदस्तथा ।\nवयस्या ज्ञातयश्चैव भ्रातरश्च पितामह\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2180239, "chapter_id": 4816, "verse_number": "२७", "content_sanskrit": "बहवश्च मनुष्येन्द्रा नानादेशसमागताः ।\nघातिता राज्यलुब्धेन मयैकेन पितामह\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2180240, "chapter_id": 4816, "verse_number": "२८", "content_sanskrit": "तांस्तादृशानहं हत्वा धर्मनित्यान् महीक्षितः ।\nअसकृत् सोमपान् वीरान् किं प्राप्स्यामि तपोधन\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2180241, "chapter_id": 4816, "verse_number": "२९", "content_sanskrit": "दह्याम्यनिशमद्याहं चिन्तयानः पुनःपुनः ।\nहीनां पार्थिवसिंहैस्तैः श्रीमद्भिः पृथिवीमिमाम्\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2180242, "chapter_id": 4816, "verse_number": "३०", "content_sanskrit": "दृष्ट्वा ज्ञातिवधं गोरं हतांश्च शतशः परान् ।\nकोटिशश्च नरानन्यान् परितप्ये पितामह\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2180243, "chapter_id": 4816, "verse_number": "३१", "content_sanskrit": "का नु तासां वरस्त्रीणामवस्थाद्य भविष्यति ।\nविहीनानां स्वतनयैः पतिभिर्भ्रातृभिस्तथा\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2180244, "chapter_id": 4816, "verse_number": "३२", "content_sanskrit": "अस्मानन्तकरान् घोरान् पाण्डवान् वृष्णिसंहितान् ।\nआक्रोशन्त्यः कृशा दीना निपतन्त्यश्च भूतले\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2180245, "chapter_id": 4816, "verse_number": "३३", "content_sanskrit": "अपश्यन्त्यः पितॄन् भ्रातॄन् पतीन् पुत्रांश्च योषितः ।\nत्यक्त्वा प्राणान् प्रियान् सर्वान् गमिष्यन्ति यमक्षयम्\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2180246, "chapter_id": 4816, "verse_number": "३४", "content_sanskrit": "वत्सलत्वाद् द्विजश्रेष्ठ तत्र मे नास्ति संशयः ।\nव्यक्तं सौक्ष्म्याच्च धर्मस्य प्राप्स्यामः स्त्रीवधं वयम्\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2180247, "chapter_id": 4816, "verse_number": "३५", "content_sanskrit": "ते वयं सुहृदो हत्वा कृत्वा पापमनन्तकम् ।\nनरके निपतिष्यामो ह्यधःशिरस एव च\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2180248, "chapter_id": 4816, "verse_number": "३६", "content_sanskrit": "शरीराणि विमोक्ष्यामस्तपसोग्रेण सत्तम ।\nआश्रमांश्च विशेषांस्त्वं ममाचक्ष्व पितामह\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2180249, "chapter_id": 4816, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nशान्तिपर्वणि राजधर्मे व्यासवाक्यं नाम त्रयस्त्रिंशोऽध्यायः ॥ ३३ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}]