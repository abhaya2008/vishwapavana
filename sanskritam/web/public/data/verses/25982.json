[{"id": 7005982000, "chapter_id": 25982, "verse_number": "१-१६५-१", "content_sanskrit": "धन्वन्तरिरुवाच । क्रिमयश्च द्विधा प्रोक्ता बाह्यभ्यन्तभेदतः ।\nबहिर्मलकफासृग्विट्जन्मभेदाच्चतुर्विधाः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7005982001, "chapter_id": 25982, "verse_number": "१-१६५-२", "content_sanskrit": "नामतो विंशतिविधा बाह्यास्तत्र मलोद्भवाः। ।\nतिलप्रमाणसंस्थानवर्णाः केशाम्बराश्रयाः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7005982002, "chapter_id": 25982, "verse_number": "१-१६५-३", "content_sanskrit": "बहुपादाश्च सूक्ष्माश्च यूका लिक्षाश्च नामतः ।\nद्विधा ते कोष्ठपिडिकाः कण्डूगण्डान्प्रकुर्वते ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7005982003, "chapter_id": 25982, "verse_number": "१-१६५-४", "content_sanskrit": "कुष्ठैकहेतवोऽन्तर्जाः श्लेष्मजा बाह्सम्भवाः ।\nमधुरान्नगुडक्षीरदधिमत्स्यनवौदनैः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7005982004, "chapter_id": 25982, "verse_number": "१-१६५-५", "content_sanskrit": "कफादामाशये जाता वृद्धाः सर्पन्ति सर्वत ।\nपृथुब्रध्ननिभाः केचित्केचिद्गण्डूपदोपमाः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7005982005, "chapter_id": 25982, "verse_number": "१-१६५-६", "content_sanskrit": "रूढधान्याङ्कुराकारास्तनुदीर्घास्तथाणवः ।\nश्वेतास्ताम्रावभासाश्च नामतः सप्तधा तु ते ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7005982006, "chapter_id": 25982, "verse_number": "१-१६५-७", "content_sanskrit": "अन्त्रादा उदरावेष्टा हृदयादा महागुदाः ।\nच्युरवो दर्भकुसुमाः सुगन्धास्ते च कुर्वते ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7005982007, "chapter_id": 25982, "verse_number": "१-१६५-८", "content_sanskrit": "हृल्लासमास्यश्रवणमविपाकमरोचकम् ।\nमूर्छाच्छर्दिज्वरानाहकार्श्यक्षवथुपीनसान् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7005982008, "chapter_id": 25982, "verse_number": "१-१६५-९", "content_sanskrit": "रक्तवाहिशिरास्थानरक्तजा जन्तवोऽणवः ।\nअपादा वृत्तताम्राश्च सौक्ष्म्यात्केचिददर्शनाः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7005982009, "chapter_id": 25982, "verse_number": "१-१६५-१०", "content_sanskrit": "केशादा रोमविध्वंसा रोमद्वीपा उदुम्बराः ।\nषट्ते कुष्ठैककर्माणः सहसौरसमातरः ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7005982010, "chapter_id": 25982, "verse_number": "१-१६५-११", "content_sanskrit": "पक्वाशये पुरीषोत्था जायन्तेऽथोविसर्पिणः ।\nवृद्धास्ते स्युर्भवेयुश्च ते यदामाशयोन्मुखाः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7005982011, "chapter_id": 25982, "verse_number": "१-१६५-१२", "content_sanskrit": "तदास्योद्गारनिः श्वामविड्गन्धानुविधायिन। ।\nपृथुवृत्ततनुस्थूलाः श्यावपीतसितासिताः ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7005982012, "chapter_id": 25982, "verse_number": "१-१६५-१३", "content_sanskrit": "ते पञ्चनाम्ना क्रिमयः ककेरुकमकेरुकाः ।\nसौसुरादाः सशूलाख्या लेलिहा जनयन्ति हि ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7005982013, "chapter_id": 25982, "verse_number": "१-१६५-१४", "content_sanskrit": "वङ्भेदशूलविष्टम्भकार्श्यपारुष्यपाण्डुताः ।\nरोमहर्षाग्निसदनं गुदकण्डूंर्विमार्गगाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}]