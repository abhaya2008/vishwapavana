[{"id": 7004702000, "chapter_id": 24702, "verse_number": "६-१६४-१", "content_sanskrit": "सूत उवाच ।\nएतस्मिन्नंतरे पुष्पः प्रहृष्टेनान्तरात्मना ।\nचंडशर्मगृहं गत्वा दिष्ट्यादिष्ट्येति चाब्रवीत् ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004702001, "chapter_id": 24702, "verse_number": "६-१६४-२", "content_sanskrit": "विवर्णवदनं दृष्ट्वा वाष्पपूर्णेक्षणं तदा ।\nबान्धवैः सहितं सर्वैर्दारैर्भृत्यैस्तथा सुतैः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004702002, "chapter_id": 24702, "verse_number": "६-१६४-३", "content_sanskrit": "पुष्प उवाच ।\nतवार्थे च मया सूर्यः कायत्यागेन तोषितः ।\nपतितत्त्वं न ते काये तत्प्रसादाद्भविष्यति ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004702003, "chapter_id": 24702, "verse_number": "६-१६४-४", "content_sanskrit": "तव पुत्राश्च पौत्राश्च ये भविष्यंति वंशजाः ।\nनागराणां च ते सर्वे भविष्यंति गुणाधिकाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004702004, "chapter_id": 24702, "verse_number": "६-१६४-५", "content_sanskrit": "तस्मादुत्तिष्ठ गच्छामो नदीं पुण्यां सरस्वतीम् ।\nतस्यास्तटे निवासाय कृत्वा चैवाश्रमं द्विज ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004702005, "chapter_id": 24702, "verse_number": "६-१६४-६", "content_sanskrit": "त्वया सह वसिष्यामि अहमेव न संशयः ।\nअस्ति मे विपुलं वित्तं ये चान्ये तेऽनुयायिनः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004702006, "chapter_id": 24702, "verse_number": "६-१६४-७", "content_sanskrit": "तान्सर्वान्पोषयिष्यामि त्यज्यतां मानसो ज्वरः ।\nतच्छ्रुत्वा चण्डशर्मा तु पुत्रैर्बंधुभिरन्वितः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004702007, "chapter_id": 24702, "verse_number": "६-१६४-८", "content_sanskrit": "सरस्वतीं समुद्दिश्य निष्क्रांतो नगरात्ततः ।\nस्थानं प्रदक्षिणीकृत्य नमस्कृत्य सुदुःखितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004702008, "chapter_id": 24702, "verse_number": "६-१६४-९", "content_sanskrit": "बाष्पपूर्णेक्षणो दीन उत्तराभिमुखो ययौ ।\nपुष्पेण सहितश्चैव मुहुर्मुहुः प्रबोधितः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004702009, "chapter_id": 24702, "verse_number": "६-१६४-१०", "content_sanskrit": "ततः सरस्वतीं प्राप्य पुण्यां शीतजलां नदीम् ।\nसेवितां मुनिसंघैस्तां लोलकल्लोलमालिनीम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004702010, "chapter_id": 24702, "verse_number": "६-१६४-११", "content_sanskrit": "तस्या दक्षिणकूले स निवासमकरोत्तदा ।\nपुष्पस्य मतिमास्थाय बन्धुभिः सकलैर्वृतः ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004702011, "chapter_id": 24702, "verse_number": "६-१६४-१२", "content_sanskrit": "तस्यासीन्नगरस्थस्य प्रतिज्ञा चण्डशर्मणः ।\nसप्तविंशति भिर्लिंगैर्दृष्टैभोक्ष्याम्यहं सदा ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004702012, "chapter_id": 24702, "verse_number": "६-१६४-१३", "content_sanskrit": "तां च संस्मरतस्तस्य प्रतिज्ञां पूर्वसंचिताम् ।\nहृदयं दह्यते तस्य दिवानक्तं द्विजोत्तमाः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004702013, "chapter_id": 24702, "verse_number": "६-१६४-१४", "content_sanskrit": "स च स्नात्वा सरस्वत्यां शुचिर्भूत्वा समाहितः ।\nषडक्षरस्य मन्त्रस्य जपं चक्रे पृथक्पृथक् ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004702014, "chapter_id": 24702, "verse_number": "६-१६४-१५", "content_sanskrit": "नाम चोच्चार्य लिंगस्य नमस्कारान्तमादधे ।\nकर्दमेन द्विजश्रेष्ठाः पंचांगुलशतेन च ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004702015, "chapter_id": 24702, "verse_number": "६-१६४-१६", "content_sanskrit": "संस्थाप्य पूजयेद्भक्त्या पुष्पधूपानुलेपनैः ।\nप्राणरुद्राञ्जपन्पश्चाच्छ्रद्धया परया युतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004702016, "chapter_id": 24702, "verse_number": "६-१६४-१७", "content_sanskrit": "दुःस्थितं सुस्थितं वापि शिवलिंगं न चालयेत् ।\nइति मत्वा द्विजेन्द्रोऽसौ नैव तानि विसर्जयेत् ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004702017, "chapter_id": 24702, "verse_number": "६-१६४-१८", "content_sanskrit": "उपर्युपरि तेषां च कर्दमेन द्विजोत्तमाः ।\nचक्रे लिंगानि नित्यं स सप्तविंशतिसंख्यया ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004702018, "chapter_id": 24702, "verse_number": "६-१६४-१९", "content_sanskrit": "ततः कालेन महता जातः कर्दमपर्वतः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004702019, "chapter_id": 24702, "verse_number": "६-१६४-२०", "content_sanskrit": "अथ तुष्टो महादेवस्तस्य भक्त्यतिरेकतः ।\nनिर्भिद्य धरणीपृष्ठं तस्य लिंगमदर्शयत् ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004702020, "chapter_id": 24702, "verse_number": "६-१६४-२१", "content_sanskrit": "अब्रवीत्सादरं तं च मेघगम्भीरया गिरा ।\nचण्डशर्मन्प्रतुष्टोस्मि तव भक्त्याऽनया द्विज ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004702021, "chapter_id": 24702, "verse_number": "६-१६४-२२", "content_sanskrit": "तस्माल्लिंगमिदं नित्यं पूजयस्व प्रभक्तितः ।\nसप्तविंशतिलिंगानां यतः फलमवाप्स्यसि ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004702022, "chapter_id": 24702, "verse_number": "६-१६४-२३", "content_sanskrit": "अन्योपि च नरो भक्त्या यश्चैनं पूजयिष्यति ।\nसप्तविंशतिलिंगानां सोऽपि श्रेयोऽभिलप्स्यति ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004702023, "chapter_id": 24702, "verse_number": "६-१६४-२४", "content_sanskrit": "एवमुक्त्वा स भगवांस्ततश्चादर्शनं गतः ।\nचंडशर्मापि तं हृष्टः पूजयामास तत्त्वतः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004702024, "chapter_id": 24702, "verse_number": "६-१६४-२५", "content_sanskrit": "प्रासादं कारयामास तस्य लिंगस्य शोभनम् ।\nनाम चक्रे ततस्तस्य विचार्य च मुहुर्मुहुः ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004702025, "chapter_id": 24702, "verse_number": "६-१६४-२६", "content_sanskrit": "नगरस्थित लिंगानां यस्मात्संस्मरणात्स्थितः ।\nनागरेश्वरसंज्ञस्तु तस्मादेष भविष्यति ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004702026, "chapter_id": 24702, "verse_number": "६-१६४-२७", "content_sanskrit": "सूत उवाच ।\nएवं संस्थाप्य तल्लिंगं चंडशर्मा द्विजोत्तमाः ।\nआराधयामास तदा पुष्पधूपानुलेपनैः ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004702027, "chapter_id": 24702, "verse_number": "६-१६४-२८", "content_sanskrit": "सप्तविंशतिलिंगानां प्राप्नोति च तथा फलम् ।\nपूजितानां द्विजश्रेष्ठा नगरे यानि तानि च ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004702028, "chapter_id": 24702, "verse_number": "६-१६४-२९", "content_sanskrit": "ततः कालेन महता नागरेश्वरतुष्टितः ।\nशिवलोकं गतः साक्षाद्यानमध्ये निवेशितः ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004702029, "chapter_id": 24702, "verse_number": "६-१६४-३०", "content_sanskrit": "पुष्पोपि स्थापयामास पुष्पादित्यमथापरम् ।\nपुण्ये सरस्वतीतीरे ततः पूजापरोऽभवत् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004702030, "chapter_id": 24702, "verse_number": "६-१६४-३१", "content_sanskrit": "तस्यापि दर्शनं गत्वा प्रीत्या वचनमब्रवीत् ।\nपुष्प तुष्टोस्मि भद्रं ते वरं प्रार्थय सुव्रत ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004702031, "chapter_id": 24702, "verse_number": "६-१६४-३२", "content_sanskrit": "अदेयमपि दास्यामि तस्मात्प्रार्थय मा चिरम् ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004702032, "chapter_id": 24702, "verse_number": "६-१६४-३३", "content_sanskrit": "पुष्प उवाच ।\nयदि तुष्टोऽसि मे देव यदि देयो वरो मम ।\nतद्देहि याचमानस्य मम यद्धृदि संस्थितम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004702033, "chapter_id": 24702, "verse_number": "६-१६४-३४", "content_sanskrit": "चमत्कारपुरे देव तव या मूर्तयः स्थिताः ।\nद्वादशैव प्रमाणेन पूज्याः सर्वदिवौकसाम् ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004702034, "chapter_id": 24702, "verse_number": "६-१६४-३५", "content_sanskrit": "तासां पूजाफलं कृत्स्नं संप्राप्नोतु नरो भुवि ।\nयः पूजयति मूर्तिं ते यैषा संस्थापिता मया ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004702035, "chapter_id": 24702, "verse_number": "६-१६४-३६", "content_sanskrit": "नागरादित्य इत्येषा ख्याता भवतु भूतले ।\nयेयं सरस्वतीतीरे प्रासादे स्थापिता मया ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004702036, "chapter_id": 24702, "verse_number": "६-१६४-३७", "content_sanskrit": "सूत उवाच ।\nस तथेति प्रतिज्ञाय गतश्चादर्शनं रविः ।\nदीपवद्ब्राह्मणश्रेष्ठास्तदद्भुतमिवा भवत् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004702037, "chapter_id": 24702, "verse_number": "६-१६४-३८", "content_sanskrit": "ततः कालेन महता पुष्पोपि द्विजसत्तमाः ।\nसूर्यलोकमनुप्राप्तो विमानेन सुवर्चसा ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004702038, "chapter_id": 24702, "verse_number": "६-१६४-३९", "content_sanskrit": "शाकम्भरीति विख्याता भार्याऽसीच्चंडशर्मणः ।\nतया संस्थापिता दुर्गा सरस्वत्याः शुभे तटे ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004702039, "chapter_id": 24702, "verse_number": "६-१६४-४०", "content_sanskrit": "आराधिताऽथ सद्भक्त्या दिवानक्तं द्विजोत्तमाः ।\nततस्तुष्टा वरं तस्याः सा ददौ द्विजसत्तमाः ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004702040, "chapter_id": 24702, "verse_number": "६-१६४-४१", "content_sanskrit": "पुत्रि तुष्टास्मि भद्रं ते शाकंभरि प्रगृह्यताम् ।\nवरं यत्ते सदाभीष्टं मत्प्रसादादसंशयम् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004702041, "chapter_id": 24702, "verse_number": "६-१६४-४२", "content_sanskrit": "शाकम्भर्युवाच ।\nचतुःषष्टिगणा देवि मातृणां ये व्यवस्थिताः ।\nचमत्कारपुरे ख्याता हास्यात्तुष्टिं व्रजंति याः ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004702042, "chapter_id": 24702, "verse_number": "६-१६४-४३", "content_sanskrit": "या रात्रौ बलिदानेन जाते वृद्धौ ततः परम् ।\nतत्सर्वं जायतां पुण्यं यस्ते मूर्तिं प्रपूजयेत् ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004702043, "chapter_id": 24702, "verse_number": "६-१६४-४४", "content_sanskrit": "अत्रागत्य नदीतीरे यैषा संस्थापिता मया ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004702044, "chapter_id": 24702, "verse_number": "६-१६४-४५", "content_sanskrit": "श्रीदेव्युवाच ।\nआश्विनस्य सिते पक्षे महानवमिसंज्ञिते ।\nयो ममाग्रे समागत्य पूजयिष्यति भक्तितः ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004702045, "chapter_id": 24702, "verse_number": "६-१६४-४६", "content_sanskrit": "तस्य कृत्स्नं फलं सद्यो भविष्यति न संशयः ।\nनागरस्य विशेषेण सत्यमेतन्मयोदितम् ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004702046, "chapter_id": 24702, "verse_number": "६-१६४-४७", "content_sanskrit": "एवमुक्त्वा तु सा देवी ततश्चादर्शनं गता ।\nतस्या नाम्ना च सा देवी प्रोक्ता शाकम्भरी भुवि ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004702047, "chapter_id": 24702, "verse_number": "६-१६४-४८", "content_sanskrit": "वृद्धेरनंतरं तस्या यः पूजां कुरुते नरः ।\nतस्य वृद्धेर्न विघ्नः स्यात्कदाचिद्द्विजसत्तमाः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004702048, "chapter_id": 24702, "verse_number": "६-१६४-४९", "content_sanskrit": "इति श्रीस्कांदे महापुराण एकाशीतिसाहस्र्यां संहितायां षष्ठे नागरखण्डे ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004702049, "chapter_id": 24702, "verse_number": "६-१६४-५०", "content_sanskrit": "श्रीहाटकेश्वरक्षेत्रमाहात्म्ये नागरेश्वरनागरादित्यशाकम्भर्युत्पत्तिवर्णनंनामचतुःषष्ट्युत्तरशततमोऽध्यायः ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}]