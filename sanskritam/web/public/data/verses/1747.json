[{"id": 2034642, "chapter_id": 1747, "verse_number": "४-७०-०x", "content_sanskrit": "वैशम्पायन उवाच ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2034643, "chapter_id": 1747, "verse_number": "४-७०-१", "content_sanskrit": "प्रस्थाप्य सेनां कन्याश्च गणिकाश्च स्वलंकृताः।\nमत्स्यराजो महाराजः प्रहृष्ट इदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2034644, "chapter_id": 1747, "verse_number": "४-७०-२", "content_sanskrit": "व्रिगर्ताः कुरवः सर्वे संग्रामे निर्जिता मया।\nप्रविश्यान्तःपुरं हृष्टा द्यूतं दीव्याम ब्राह्मण ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2034645, "chapter_id": 1747, "verse_number": "४-७०-३", "content_sanskrit": "अक्षानाहर सैरन्ध्रि आसनं चोपकल्पय।\nआदाय व्यजनं त्वं च पार्श्वतोऽनन्तरा भव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2034646, "chapter_id": 1747, "verse_number": "४-७०-४", "content_sanskrit": "तं तथावादिनं दृष्ट्वा पाण्डवः प्रत्यभापत।\nन देवितव्यं हृष्टेन कितवेनेति नः श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2034647, "chapter_id": 1747, "verse_number": "४-७०-५", "content_sanskrit": "न त्वामद्य मुदा युक्तमहं देवितुमुत्सहे ।\nप्रियं तु ते चिकीर्पामि वर्ततां यदि रोचते।\nद्यूतं कर्तुं न वाञ्छामि नरेन्द्र जनसंसदि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2034648, "chapter_id": 1747, "verse_number": "४-७०-६x", "content_sanskrit": "विराट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2034649, "chapter_id": 1747, "verse_number": "४-७०-६", "content_sanskrit": "स्त्रियो गावो हिरण्यं च यच्चान्यद्वसु किंचन।\nन मे किंचित्त्वया कार्यमन्तरेणापि देवितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2034650, "chapter_id": 1747, "verse_number": "४-७०-७x", "content_sanskrit": "कङ्क उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2034651, "chapter_id": 1747, "verse_number": "४-७०-७", "content_sanskrit": "किं ते द्यूतेन राजेन्द्र बहुदोषेण मानद।\nदेवने बहवो दोषास्तस्मात्तत्परिवर्जयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2034652, "chapter_id": 1747, "verse_number": "४-७०-८", "content_sanskrit": "श्रुतो वा यदि वा दृष्टो धर्मराजो युधिष्ठिरः ।\nस राज्यं धनमक्षय्यं पणमेकममन्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2034653, "chapter_id": 1747, "verse_number": "४-७०-९", "content_sanskrit": "कृष्णां च भार्यां दयितां भ्रातॄंश्च त्रिदशोपमान्।\nनिःसंशयं स कितवः पश्चात्तप्यति पाण्डवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2034654, "chapter_id": 1747, "verse_number": "४-७०-१०", "content_sanskrit": "विविधानां च रत्नानां धनानां च पराजये।\nअभीप्सितविनाशश्च वाक्पारुष्यमनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2034655, "chapter_id": 1747, "verse_number": "४-७०-११", "content_sanskrit": "अविश्वास्यं बुधैर्नित्यमेकाह्ना द्रव्यनाशनम्।\nद्यूते हारितवान्सर्वं तस्माद्द्यूतं न रोचये ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2034656, "chapter_id": 1747, "verse_number": "४-७०-१२", "content_sanskrit": "अथवा मन्यसे राजन्दीव्याव यदि रोचते।\nएवमाभाष्य वाक्यैस्तु क्रीडतस्तौ नरोत्तमौ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2034657, "chapter_id": 1747, "verse_number": "४-७०-१३", "content_sanskrit": "प्रवर्तमाने द्यूते तु मात्स्यः पाण्डवमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2034658, "chapter_id": 1747, "verse_number": "४-७०-१४", "content_sanskrit": "पश्य पुत्रेण मे युद्धे तादृशाः कुरवो जिताः ।\nकुरवोऽतिरथाः सर्वे देवैरपि सुदुर्जयाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2034659, "chapter_id": 1747, "verse_number": "४-७०-१५", "content_sanskrit": "ततोऽब्रवीद्धर्मराजो द्यूते मात्स्यं युधिष्ठिरः।\nदिष्ट्या ते विजिता गावः कुरवश्च पराजिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2034660, "chapter_id": 1747, "verse_number": "४-७०-१६", "content_sanskrit": "अत्यद्भुततमं मन्ये उत्तरश्चेत्कूरूञ्जयेत्।\nयन्ता बृहन्नला यस्य स कथंचिद्विजेष्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2034661, "chapter_id": 1747, "verse_number": "४-७०-१७", "content_sanskrit": "ततो विराटः क्षुभितो मन्युना च परिप्लुतः।\nउवाच वचनं क्रुद्धः परिव्राजमनन्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2034662, "chapter_id": 1747, "verse_number": "४-७०-१८", "content_sanskrit": "तादृशेन तु योधेन महेष्वासेन धीमता।\nकुरवो निर्जिता युद्धे तत्र किं ब्राह्मणाद्भुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2034663, "chapter_id": 1747, "verse_number": "४-७०-१९x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2034664, "chapter_id": 1747, "verse_number": "४-७०-१९", "content_sanskrit": "समं षण्डेन मे पुत्रं ब्रह्मबन्धो प्रशंससि।\nवाच्यावाच्यं न जानीषे नूनं मामवमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2034665, "chapter_id": 1747, "verse_number": "४-७०-२०x", "content_sanskrit": "विराट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2034666, "chapter_id": 1747, "verse_number": "४-७०-२०", "content_sanskrit": "समं षण्डेन मे पुत्रं ब्रह्मबन्धो प्रशंससि।\nवाच्यावाच्यं न जानीषे नूनं मामवमन्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2034667, "chapter_id": 1747, "verse_number": "४-७०-२१", "content_sanskrit": "पुमांसो बहवो दृष्टाः सूताश्च बहवो मया।\nविक्रम्य यन्ता योद्धा च न मे दृष्टः कदाचन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2034668, "chapter_id": 1747, "verse_number": "४-७०-२२", "content_sanskrit": "विप्रियं न चरेद्राज्ञामनुकूलं प्रियं वदेत्।\nआचरन्विप्रियं राज्ञां न जातु सुखमेधते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2034669, "chapter_id": 1747, "verse_number": "४-७०-२३", "content_sanskrit": "वयस्यत्वात्तु ते सर्वमपराधमिमं क्षमे।\nनेदृशीं प्रवदर्वाचं यदि जीवितुमिच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2034670, "chapter_id": 1747, "verse_number": "४-७०-२४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2034671, "chapter_id": 1747, "verse_number": "४-७०-२४", "content_sanskrit": "ततोऽब्रवीत्पुनः कङ्कः प्रहस्य कुरुवर्धनः ।\nबृहन्नलाया सजेन्द्र धुष्यतां नगरे जयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2034672, "chapter_id": 1747, "verse_number": "४-७०-२५", "content_sanskrit": "उत्तरेण तु सारथ्यं कृतं नूनं भविष्यति।\nनिमित्तं किंचिदुत्पन्नं तर्कश्चापि दृढो मम।\nयतो जानामि राजेन्द्र नान्यथा तद्भविष्यति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2034673, "chapter_id": 1747, "verse_number": "४-७०-२६", "content_sanskrit": "कुरवोऽपि महावीर्या देवैरपि सुदुर्जयाः।\nससोमवरुणादित्यैः सयक्षेशहुताशनैः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2034674, "chapter_id": 1747, "verse_number": "४-७०-२७", "content_sanskrit": "यत्र शान्तनवो भीष्मो द्रोणकर्णौ सुदुर्जयौ।\nअश्वत्थामा विकर्णश्च सोमदत्तो जयद्रथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2034675, "chapter_id": 1747, "verse_number": "४-७०-२८", "content_sanskrit": "भूरिश्रवाः शलो भूरिर्जलसन्धिश्च वीर्यवान्।\nदुर्योधनो दुष्प्रसहो दुःशासनविविंशती ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2034676, "chapter_id": 1747, "verse_number": "४-७०-२९", "content_sanskrit": "वृषसेनोऽश्ववेगश्च वायुवेगसुवर्चसौ ।\nबाह्लीकः शूरसेनश्च युयुत्सुश्च परन्तपः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2034677, "chapter_id": 1747, "verse_number": "४-७०-३०", "content_sanskrit": "सौबलः शकुनिश्चैव द्युमत्सेनश्च साल्वराट् ।\nअन्ये च बहवः शूरा नानाजनपदेश्वराः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2034678, "chapter_id": 1747, "verse_number": "४-७०-३१", "content_sanskrit": "कृपेणाचार्यमुख्येन सहिताः कुरवो नृपाः।\nसञ्जकार्मुकनिस्त्रिंशा रथिनो रथयूथपाः।\nअन्ये चैव महावीर्या राजपुत्रा महारथाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2034679, "chapter_id": 1747, "verse_number": "४-७०-३२", "content_sanskrit": "मरुद्गणैः परिवृतः साक्षादपि पुरंदरः ।\nतद्बलं न जयेत्क्रुद्धो भीष्मद्रोणादिभिर्वृतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2034680, "chapter_id": 1747, "verse_number": "४-७०-३३", "content_sanskrit": "कस्तद्बृहन्नलादन्यो मनुष्यः प्रतियोत्स्यति।\nयस्य बाहुबले तुल्यो न भविष्यति कश्चन ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2034681, "chapter_id": 1747, "verse_number": "४-७०-३४", "content_sanskrit": "अतीव समरं दृष्ट्वा हर्षो यस्याभिवर्धते।\nकिमेवं पुरुषो लोको दिवि वा भुवि विद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2034682, "chapter_id": 1747, "verse_number": "४-७०-३५x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2034683, "chapter_id": 1747, "verse_number": "४-७०-३५", "content_sanskrit": "तेन संक्षुभितो राजा दीर्यमाणेन चेतसा ।\nअब्रवीद्वचनं क्रूरमजानन्वै युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2034684, "chapter_id": 1747, "verse_number": "४-७०-३६", "content_sanskrit": "कङ्ख मा ब्रूहि मे वाक्यं प्रतिकूलं द्विजोत्तम ।\nबहुशः प्रतिषिद्धस्त्वं न च वाचं नियच्छसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2034685, "chapter_id": 1747, "verse_number": "४-७०-३७", "content_sanskrit": "नियन्ता चेन्न विद्येत न कश्चिद्धर्ममाचरेत्।\nइति प्रक्षुभितो राजा सोऽक्षेणाभ्यहनद्भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2034686, "chapter_id": 1747, "verse_number": "४-७०-३८", "content_sanskrit": "तस्य तक्षकभोगाभं बाहुमुत्क्षिप्य दक्षिणम्।\nविराटः प्राहनत्क्रुद्धः कर्णमाश्रित्य दक्षिणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2034687, "chapter_id": 1747, "verse_number": "४-७०-३९", "content_sanskrit": "मुखे युधिष्ठिरं कोपान्मैवमित्यवभर्त्सयन्।\nबलवत्प्रतिविद्धस्य नस्तः शोणितमास्रवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2034688, "chapter_id": 1747, "verse_number": "४-७०-४०", "content_sanskrit": "अक्षेणाभिहतो राजा विराटेन युधिष्ठिरः ।\nतूष्णीमासीन्महाबाहुः कृष्णां पश्यन्सुदुःखिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2034689, "chapter_id": 1747, "verse_number": "४-७०-४१", "content_sanskrit": "तस्य रक्तोत्पलनिभं शिरसः शोणितं तदा।\nप्रावर्तत महाबाहोरभिघातान्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2034690, "chapter_id": 1747, "verse_number": "४-७०-४२", "content_sanskrit": "तदप्राप्तं महीं पार्थः पाणिभ्यां समधारयत्।\nअवैक्षत च धर्मात्मा द्रौपदीं पार्श्वतः स्थिताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2034691, "chapter_id": 1747, "verse_number": "४-७०-४३", "content_sanskrit": "सा वेदनामभिज्ञाय भर्तुश्चित्तवशानुगा।\nसा विषण्णा च भीता च क्रुद्धा च द्रुपदात्मजा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2034692, "chapter_id": 1747, "verse_number": "४-७०-४४", "content_sanskrit": "बाष्पं नियम्य कृच्छ्रेण भर्तुर्निःश्रेयसैषिणी ।\nउत्तरीयेण सूक्ष्मेण तूर्णं जग्राह शोणितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2034693, "chapter_id": 1747, "verse_number": "४-७०-४५", "content_sanskrit": "निगृह्य रक्तं वस्त्रेण सैरन्ध्री दुःखमोहिता।\nसौवर्णं गृह्य भृङ्गारं शोणितं तदपामृजत् ।\nयुधिष्ठिरस्य राजेन्द्र द्रुपदेन्द्रसुता तदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2034694, "chapter_id": 1747, "verse_number": "४-७०-४६x", "content_sanskrit": "विराट उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2034695, "chapter_id": 1747, "verse_number": "४-७०-४६", "content_sanskrit": "सैरन्ध्रि किमिदं रक्तमुत्तरीयेण गृह्यते।\nकोत्र हेतुर्विशालाक्षि तन्मप्राचक्ष्व तत्वतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2034696, "chapter_id": 1747, "verse_number": "४-७०-४७x", "content_sanskrit": "सैरन्ध्र्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2034697, "chapter_id": 1747, "verse_number": "४-७०-४७", "content_sanskrit": "रक्तबिन्दनि यावन्ति कङ्कस्य धरणीतले।\nतावद्वर्षाणि राष्ट्रे ते अनावृष्टिर्भविष्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2034698, "chapter_id": 1747, "verse_number": "४-७०-४८", "content_sanskrit": "एतन्निमित्तं मात्स्येन्द्र कङ्कस्य रुधिरं मया।\nगृहीतमुत्तरीयेण विनाशो मा भवेत्तव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2034699, "chapter_id": 1747, "verse_number": "४-७०-४९", "content_sanskrit": "यतीशं यो विहन्येत तस्यायुर्विनशिष्यति।\nयो यतीशं नियम्येत सहस्रं यातना यमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2034700, "chapter_id": 1747, "verse_number": "४-७०-५०", "content_sanskrit": "यतौ रक्तं दर्शयति यावत्पांसुरगृह्यत।\nतावन्तः पितृलोकस्थाः पितरः प्रपतन्त्यधः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2034701, "chapter_id": 1747, "verse_number": "४-७०-५१", "content_sanskrit": "इति ज्ञात्वा विराटेन्द्र धृतं रक्तं च वाससा।\nमया तव हितार्थाय त्वयि प्रणयकारणात् ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2034702, "chapter_id": 1747, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते विराटपर्वणि गोग्रहणपर्वणि सप्ततितमोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}]