[{"id": 2071803, "chapter_id": 2515, "verse_number": "१२-२०-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2071804, "chapter_id": 2515, "verse_number": "१२-२०-१", "content_sanskrit": "अस्मिन्वाक्यान्तरे वक्ता देवस्थानो महातपाः।\nअभिनीततरं वाक्यमित्युवाच युधिष्ठिरम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2071805, "chapter_id": 2515, "verse_number": "१२-२०-२x", "content_sanskrit": "देवस्थान उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2071806, "chapter_id": 2515, "verse_number": "१२-२०-२", "content_sanskrit": "यद्वचः फल्गुनेनोक्तं न ज्यायोऽस्ति धनादिति।\nअत्र ते वर्तयिष्यामि तदेकान्तमनाः शृणु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2071807, "chapter_id": 2515, "verse_number": "१२-२०-३", "content_sanskrit": "अजातशत्रो धर्मेण कृत्स्ना ते वसुधा जिता।\nतां जित्वा च वृथा राजन्न परित्यक्तुमर्हसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2071808, "chapter_id": 2515, "verse_number": "१२-२०-४", "content_sanskrit": "चतुष्पदी हि निःश्रेणी ब्रह्मण्येषा प्रतिष्ठिता।\nतां क्रमेण महाबाहो यथावज्जय पार्थिव।\nतस्मात्पार्थ महायज्ञैर्यजस्व बहुदक्षिणैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2071809, "chapter_id": 2515, "verse_number": "१२-२०-५", "content_sanskrit": "स्वाध्याययज्ञा ऋषयो ज्ञानयज्ञास्तथाऽपरे।\nकर्मनिष्ठाश्च बुद्ध्यर्थास्तपोनिष्ठाश्च पार्थिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2071810, "chapter_id": 2515, "verse_number": "१२-२०-६", "content_sanskrit": "वैखानसानां कौन्तेय वचनं श्रूयते यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2071811, "chapter_id": 2515, "verse_number": "१२-२०-७", "content_sanskrit": "ईहेत धनहेतोर्यस्तस्यानीहा गरीयसी।\nभूयान्दोषो हि वर्धेत यस्तत्कर्म समाश्रयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2071812, "chapter_id": 2515, "verse_number": "१२-२०-८", "content_sanskrit": "कृत्स्नं च धनसंहारं कुर्वन्ति विधिकारणात्।\nआत्मना तृपितो बुद्ध्या भ्रूणहत्यां न बुध्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2071813, "chapter_id": 2515, "verse_number": "१२-२०-९", "content_sanskrit": "अनर्हते यद्ददाति न ददाति यदर्हते।\nअर्हानर्हापरिज्ञानाद्दानधर्मोऽपि दुष्करः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2071814, "chapter_id": 2515, "verse_number": "१२-२०-१०", "content_sanskrit": "यज्ञाय सृष्टानि धनानि धात्रा\nयज्ञादिष्टः पुरुषो रक्षिता च।\nतस्मात्सर्वं यज्ञ एवोपयोज्यं\nधनं ततोऽनन्तर एव कामः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2071815, "chapter_id": 2515, "verse_number": "१२-२०-११", "content_sanskrit": "यज्ञैरिन्द्रो विविधै रत्नवद्भि\nर्देवान्सर्वानभ्ययाद्भूरितेजाः।\nतेनेन्द्रत्वं प्राप्य विभ्राजतेऽसौ\nतस्माद्यज्ञे सर्वमेवोपयोज्यम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2071816, "chapter_id": 2515, "verse_number": "१२-२०-१२", "content_sanskrit": "महादेवः सर्वयज्ञे महात्मा\nहुत्वाऽऽत्मानं देवदेवो बभूव।\nविश्वाँल्लोकान्व्याप्य विष्टभ्य कीर्त्या\nविराजते द्युतिमान्कृत्तिवासाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2071817, "chapter_id": 2515, "verse_number": "१२-२०-१३", "content_sanskrit": "आविक्षितः पार्थिवोऽसौ मरुत्तो\nवृद्ध्या शक्रं योऽजयद्देवराजम्।\nयज्ञे यस्य श्रीः स्वयं सन्निविष्टा\nयस्मिन्भाण्डं काञ्चनं सर्वमासीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2071818, "chapter_id": 2515, "verse_number": "१२-२०-१४", "content_sanskrit": "हरिश्चन्द्रः पार्थिवेन्द्रः श्रुतस्ते\nयज्ञैरिष्ट्वा पुण्यभाग्वीतशोकः।\nऋद्ध्या शक्रं योऽजयन्मानुषः सं\nस्तस्माद्यज्ञे सर्वमेवोपयोज्यम्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2071819, "chapter_id": 2515, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि राजधर्मपर्वणि विंशोऽध्यायः॥ २०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}]