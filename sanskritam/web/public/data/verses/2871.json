[{"id": 2087857, "chapter_id": 2871, "verse_number": "१३-१-०x", "content_sanskrit": "॥ श्रीवेदव्यासाय नमः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2087858, "chapter_id": 2871, "verse_number": "१३-१-१", "content_sanskrit": "नारायणं नमस्कृत्य नरं चैव नरोत्तमम्।\nदेवीं सरस्वतीं चैव(व्यासं)ततो जयमुदीरयेत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2087859, "chapter_id": 2871, "verse_number": "१३-१-१x", "content_sanskrit": "वैशम्पायन उवाच।\n`शरतल्पे महात्मानं शयानमपराजितम्।\nयुधिष्ठिर उपागम्य प्रणिपत्येदमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2087860, "chapter_id": 2871, "verse_number": "१३-१-२", "content_sanskrit": "शमो बहुविधाकारः सूक्ष्म उक्तः पितामह।\nन च मे हृदये शान्तिरस्ति श्रुत्वेदमीदृशम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2087861, "chapter_id": 2871, "verse_number": "१३-१-३", "content_sanskrit": "अस्मिन्नर्थे बहुविधा शान्तिरुक्ता पितामह।\nस्वकृतात्का नु शान्ति स्याच्छमाद्बहुविधादपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2087862, "chapter_id": 2871, "verse_number": "१३-१-४", "content_sanskrit": "शराचितं शरीरं हि तीव्रव्रणमुदीक्ष्य ते।\nशमं नोपलभे वीर दुष्कृतान्येव चिन्तयन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2087863, "chapter_id": 2871, "verse_number": "१३-१-५", "content_sanskrit": "रुधिरेणावसिक्ताङ्गं प्रस्रवन्तं यथाचलम्।\nत्वां दृष्ट्वा पुरुषव्याघ्र सीदे वर्षास्विवाम्बुजम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2087864, "chapter_id": 2871, "verse_number": "१३-१-६", "content_sanskrit": "अतः कष्टतरं किन्नु मत्कृते यत्पितामहः।\nइमामवस्थां `गमितः प्रत्यमित्रै रणाजिरे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2087865, "chapter_id": 2871, "verse_number": "१३-१-७", "content_sanskrit": "तथा चान्ये नृपतयः सहपुत्राः सबान्धवाः।\nमत्कृते निधनं प्राप्ताः किन्नु कष्टतरं ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2087866, "chapter_id": 2871, "verse_number": "१३-१-८", "content_sanskrit": "वयं हि धार्तराष्ट्राश्च काममन्युवशं गताः।\nकृत्वेदं निन्दितं कर्म प्राप्स्यामः कां गतिं नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2087867, "chapter_id": 2871, "verse_number": "१३-१-९", "content_sanskrit": "इदं तु धार्तराष्ट्रास्य श्रेयो मन्ये जनाधिप।\nइमामवस्थां संप्राप्तं यदसौ त्वां न पश्यति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2087868, "chapter_id": 2871, "verse_number": "१३-१-१०", "content_sanskrit": "सोऽहमार्तिकरो राजन्सुहृद्वधकरस्तथा।\nन शान्तिमधिगच्छामि पश्यंस्त्वां दुःखितं क्षितौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2087869, "chapter_id": 2871, "verse_number": "१३-१-११", "content_sanskrit": "दुर्योधनो हि समरे सहसैन्यः सहानुजः।\nनिहतः क्षत्रधर्मेऽस्मिन्दुसत्मा कुलपांसनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2087870, "chapter_id": 2871, "verse_number": "१३-१-१२", "content_sanskrit": "न स पश्यति दुष्टात्मा त्वामद्य पतितं क्षितौ।\nअतः श्रेयो मृतं मन्ये नेह जीवितमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2087871, "chapter_id": 2871, "verse_number": "१३-१-१३", "content_sanskrit": "अहं हि समरे वीर गमितः शत्रुभिः क्षयम्।\nअभविष्यं यदि पुरा सह भ्रातृभिरच्युत।\nन त्वामेवं सुदुःखार्तमद्राक्षं सायकार्दितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2087872, "chapter_id": 2871, "verse_number": "१३-१-१४", "content_sanskrit": "नूनं हि पापकर्माणो धात्रा सृष्टाः स्म हे नृप॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2087873, "chapter_id": 2871, "verse_number": "१३-१-१५", "content_sanskrit": "अन्यस्मिन्नपि लोके वै यथा मुच्येम किल्बिषात्।\nतथा प्रशाधि मां राजन्मम चेदिच्छसि प्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2087874, "chapter_id": 2871, "verse_number": "१३-१-१६x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2087875, "chapter_id": 2871, "verse_number": "१३-१-१६", "content_sanskrit": "परतन्त्रं कथं हेतुमात्मानमनु पश्यसि।\nकर्मणां हि महाभाग सूक्ष्मं ह्येतदतीन्द्रियम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2087876, "chapter_id": 2871, "verse_number": "१३-१-१७", "content_sanskrit": "अत्राप्युदाहरन्तीममितिहासं पुरातनम्।\nसंवादं मृत्युगौतम्योः काललुब्धकपन्नगैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2087877, "chapter_id": 2871, "verse_number": "१३-१-१८", "content_sanskrit": "गौतमी नाम काऽप्यासीत्स्थविरा शमसंयुता।\nसर्पेण दष्टं स्वं पुत्रमपश्यद्गतचेतनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2087878, "chapter_id": 2871, "verse_number": "१३-१-१९", "content_sanskrit": "अथ तं स्नायुपाशेन बद्ध्वा सर्पममर्षितः।\nलुब्धकोऽर्जुनको नाम नाम गौतम्याः समुपानयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2087879, "chapter_id": 2871, "verse_number": "१३-१-२०", "content_sanskrit": "तां चाब्रवीदयं ते स पुत्रहा पन्नगाधमः।\nब्रहि क्षिप्रं महाभागे वध्यतां केन हेतुना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2087880, "chapter_id": 2871, "verse_number": "१३-१-२१", "content_sanskrit": "अग्नौ प्रक्षिप्यतामेष च्छिद्यतां खण्डशोपि वा।\nन ह्यं बालहा पापश्चिरं जीवितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2087881, "chapter_id": 2871, "verse_number": "१३-१-२२x", "content_sanskrit": "गौतम्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2087882, "chapter_id": 2871, "verse_number": "१३-१-२२", "content_sanskrit": "विसृजैनमबुद्धिस्त्वमवध्योऽर्जुनक त्वया।\nको ह्यात्मानं गुरुं कुर्यात्प्राप्तव्ये सति चिन्तयन्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2087883, "chapter_id": 2871, "verse_number": "१३-१-२३", "content_sanskrit": "प्लवन्ते धर्मलघवो लोकेऽम्भसि यथा प्लवाः।\nमज्जन्ति पापगुरवः शस्त्रं स्कन्नमिवोदके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2087884, "chapter_id": 2871, "verse_number": "१३-१-२४", "content_sanskrit": "नास्यामृतत्वं भवितैवं हतेऽस्मि-\nञ्जीवत्यस्मिन्कोऽत्ययः स्यादयं ते।\nअस्योत्सर्गे प्राणयुक्तस्य जन्तो-\nर्मृत्युं लोके को न गच्छेदनन्ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2087885, "chapter_id": 2871, "verse_number": "१३-१-२५x", "content_sanskrit": "लुब्धक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2087886, "chapter_id": 2871, "verse_number": "१३-१-२५", "content_sanskrit": "जानाम्यहं नेह गुणागुणज्ञाः\nसदायुक्ता गुरवो वै भवन्ति।\nस्वर्गस्य ते सूपदेशा भवन्ति\nतस्मात्क्षुद्रं सर्पमेनं हनिष्ये॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2087887, "chapter_id": 2871, "verse_number": "१३-१-२६", "content_sanskrit": "शममीप्सन्तः कालयोगं त्यजन्ति\nसद्यः शुचं त्वर्थविदस्त्यजन्ति।\nश्रियः क्षयः शोचतां नित्यशो हि\nतस्माच्छुचं मुञ्च हते भुजङ्गे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2087888, "chapter_id": 2871, "verse_number": "१३-१-२७x", "content_sanskrit": "गौतम्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2087889, "chapter_id": 2871, "verse_number": "१३-१-२७", "content_sanskrit": "न चैवार्तिर्विद्यतेऽस्मद्विधानां\nधर्मात्मानः सर्वदा सञ्जना हि।\nनित्यायस्तो बालजनो न चाहं\nधर्मोपैति प्रभवाम्यस्य नाहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2087890, "chapter_id": 2871, "verse_number": "१३-१-२८", "content_sanskrit": "न ब्राह्मणानां कोपोऽस्ति कुतः कोपाच्च यातना।\nमार्दवात्क्षम्यतां साधो मुच्यतामेष पन्नगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2087891, "chapter_id": 2871, "verse_number": "१३-१-२९x", "content_sanskrit": "लुब्धक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2087892, "chapter_id": 2871, "verse_number": "१३-१-२९", "content_sanskrit": "हत्वा लाभः श्रेय एवाव्ययः स्या-\nत्सद्योलाभःस्याद्बलिभ्यः प्रशस्तः।\nकालाल्लाभो यस्तु सद्यो भवेत\nश्रेयोलाभः कुत्सिते त्वीदृशि स्यात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2087893, "chapter_id": 2871, "verse_number": "१३-१-३०x", "content_sanskrit": "गौतम्युवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2087894, "chapter_id": 2871, "verse_number": "१३-१-३०", "content_sanskrit": "काऽर्थप्राप्तिर्गृह्य शत्रुं निहत्य\nका कामाप्तिः प्राप्य शत्रुं न मुक्त्वा।\nकस्मात्सौम्याहं न क्षमे नो भुजङ्गे\nमोक्षार्थं वा कस्य हेतोर्न कुर्याम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2087895, "chapter_id": 2871, "verse_number": "१३-१-३१x", "content_sanskrit": "लुब्धक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2087896, "chapter_id": 2871, "verse_number": "१३-१-३१", "content_sanskrit": "अस्मादेकाद्बहवो रक्षितव्या\nनैको बहुभ्यो गौतमि रक्षितव्यः।\nकृतागसं धर्महेतोस्त्यजन्ति\nसरीसृपं पापमिमं त्यज त्वम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2087897, "chapter_id": 2871, "verse_number": "१३-१-३२x", "content_sanskrit": "गौतम्युवाय", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2087898, "chapter_id": 2871, "verse_number": "१३-१-३२", "content_sanskrit": "नास्मिन्हते पन्नगे पुत्रको मे\nसम्प्राप्स्यते लुब्धक जीवितं वै।\nगुणं चान्यं नास्य वधे प्रपश्ये\nतस्मात्सर्पं लुब्धक मुञ्च जीवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2087899, "chapter_id": 2871, "verse_number": "१३-१-३३x", "content_sanskrit": "लुब्धक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2087900, "chapter_id": 2871, "verse_number": "१३-१-३३", "content_sanskrit": "वृत्रं हत्वा देवराट् श्रेष्ठभाग्वै\nयज्ञं हत्वा भागमवाप चैव।\nशूली देवो देववृत्तं चर त्वं\nक्षिप्रं सर्पं जहि मा भूत्ते विशङ्का॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2087901, "chapter_id": 2871, "verse_number": "१३-१-३४x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2087902, "chapter_id": 2871, "verse_number": "१३-१-३४", "content_sanskrit": "असकृत्प्रोच्यमानाऽपि गौतमी भुजगं प्रति।\nलुब्धकेन महाभागा सा पापे नाकरोन्मतिम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2087903, "chapter_id": 2871, "verse_number": "१३-१-३५", "content_sanskrit": "ईषदुच्छ्वसमानस्तु कृच्छ्रात्संस्तभ्य पन्नगः।\nउत्ससर्ज गिरं मन्दां मानुषीं पाशपीडितः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2087904, "chapter_id": 2871, "verse_number": "१३-१-३६x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2087905, "chapter_id": 2871, "verse_number": "१३-१-३६", "content_sanskrit": "को न्वर्जुनक दोषोऽत्र विद्यते मम बालिश।\nअस्वतन्त्रं हि मां मृत्युर्विवशं यदचूचुदत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2087906, "chapter_id": 2871, "verse_number": "१३-१-३७", "content_sanskrit": "तस्यायं वचनाद्दष्टो न कोपेन न काम्यया।\nतस्य तत्किल्बिषं लुब्ध विद्यते यदि किञ्चन।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2087907, "chapter_id": 2871, "verse_number": "१३-१-३८x", "content_sanskrit": "लुब्धक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2087908, "chapter_id": 2871, "verse_number": "१३-१-३८", "content_sanskrit": "यद्यन्यवशगेनेदं कृतं ते पन्नगाशुभम्।\nकारणं वै त्वमप्यत्र तस्मात्त्वमपि किल्बिषी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2087909, "chapter_id": 2871, "verse_number": "१३-१-३९", "content_sanskrit": "मृत्पात्रस्य क्रियायां हि दण्डचक्रादयो यथा।\nकारणत्वे प्रकल्प्यन्ते तथा त्वमपि पन्नग॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2087910, "chapter_id": 2871, "verse_number": "१३-१-४०", "content_sanskrit": "किल्बिषी चापि मे वध्यः किल्बिषी चासि पन्नग।\nआत्मानं कारणं ह्यत्र त्वमाख्यासि भुजङ्गम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2087911, "chapter_id": 2871, "verse_number": "१३-१-४१x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2087912, "chapter_id": 2871, "verse_number": "१३-१-४१", "content_sanskrit": "सर्व एते ह्यस्ववशा दण्डचक्रादयो यथा।\nतथाहमपि तस्मान्मे नैष दोषो मतस्तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2087913, "chapter_id": 2871, "verse_number": "१३-१-४२", "content_sanskrit": "अथवा मतमेतत्ते तेप्यन्योऽन्यप्रयोजकाः।\nकार्यकारणसन्देहो भवत्यन्योन्यचोदनात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2087914, "chapter_id": 2871, "verse_number": "१३-१-४३", "content_sanskrit": "एवं सति न दोषो मे नास्मि वध्यो न किल्बिषी।\nकिल्बिषं समवाये स्यान्मन्यसे यदि किल्बिषम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2087915, "chapter_id": 2871, "verse_number": "१३-१-४४x", "content_sanskrit": "लुब्धक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2087916, "chapter_id": 2871, "verse_number": "१३-१-४४", "content_sanskrit": "कारणं यदि स्याद्वै न कर्ता स्यास्त्वमप्युत।\nविनाशे कारणं त्वं च तस्माद्वध्योऽसि मे मतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2087917, "chapter_id": 2871, "verse_number": "१३-१-४५", "content_sanskrit": "असत्यपि कृते कार्ये नेह पन्नग लिप्यते।\nतस्मान्नात्रैव हेतुः स्याद्वध्यः किं बहु भाषसे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2087918, "chapter_id": 2871, "verse_number": "१३-१-४६x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2087919, "chapter_id": 2871, "verse_number": "१३-१-४६", "content_sanskrit": "कार्याभावे क्रिया न स्यात्सत्यसत्यपि कारणे।\nतस्मात्समेऽस्मिन्हेतौ मे वाच्यो हेतुर्विशेषतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2087920, "chapter_id": 2871, "verse_number": "१३-१-४७", "content_sanskrit": "यद्यहं कारणत्वेन मतो लुब्धक तत्त्वतः।\nअन्यः प्रयोक्तास्यादत्र किन्नु जन्तुविनाशने॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2087921, "chapter_id": 2871, "verse_number": "१३-१-४८x", "content_sanskrit": "लुब्धक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2087922, "chapter_id": 2871, "verse_number": "१३-१-४८", "content_sanskrit": "वध्यस्त्वं मम दुर्बुद्धे बालघाती नृशंसकृत्।\nभाषसे किं बहु पुनर्वध्यः सन्पन्नगाधम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2087923, "chapter_id": 2871, "verse_number": "१३-१-४९x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2087924, "chapter_id": 2871, "verse_number": "१३-१-४९", "content_sanskrit": "यथा हवींषि जुह्वाना मखे वै लुब्धकर्त्विजः।\nन फलं प्राप्नुवन्त्यत्र फलयोगे तथा ह्यहम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2087925, "chapter_id": 2871, "verse_number": "१३-१-५०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2087926, "chapter_id": 2871, "verse_number": "१३-१-५०", "content_sanskrit": "तथा ब्रुवति तस्मिंस्तु पन्नगे मृत्युचोदिते।\nआजगाम ततो मृत्युः पन्नगं चाब्रवीदिदम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2087927, "chapter_id": 2871, "verse_number": "१३-१-५१", "content_sanskrit": "प्रचोदितोऽहं कालेन पन्नग त्वामचूचुदम्।\nविनाशहेतुर्नास्य त्वमहं न प्राणिनः शिशोः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2087928, "chapter_id": 2871, "verse_number": "१३-१-५२", "content_sanskrit": "यथा वायुर्जलधरान्विकर्षति ततस्ततः।\nतद्वज्जलदवत्सर्प कालस्याहं वशानुगः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2087929, "chapter_id": 2871, "verse_number": "१३-१-५३", "content_sanskrit": "सात्विका राजसाश्चैव तामसा ये च केचन।\nभावाः कालात्मकाः सर्वे प्रवर्तन्तेह जन्तुषु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2087930, "chapter_id": 2871, "verse_number": "१३-१-५४", "content_sanskrit": "जङ्गमाः स्थावराश्चैव दिवि वा यदि वा भुवि।\nसर्वे कालात्मकाः सर्प कालात्मकमिदं जगत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2087931, "chapter_id": 2871, "verse_number": "१३-१-५५", "content_sanskrit": "प्रवृत्तयश्च लोके या तथैव च निवृत्तयः।\nतासां विकृतयो याश्च सर्वं कालात्मकं स्मृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2087932, "chapter_id": 2871, "verse_number": "१३-१-५६", "content_sanskrit": "आदित्यश्चन्द्रमा विष्णुरापो वायुः शतक्रतुः।\nअग्निः खं पृथिवी मित्रः पर्जन्यो वसवोऽदितिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2087933, "chapter_id": 2871, "verse_number": "१३-१-५७", "content_sanskrit": "सरितः सागराश्चैव भावाभावौ च पन्नग।\nसर्वे कालेन सृज्यन्ते ह्रियन्ते च पुनःपुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}, {"id": 2087934, "chapter_id": 2871, "verse_number": "१३-१-५८", "content_sanskrit": "एवं ज्ञात्वा कथं मां सदोषं सर्प मन्यसे।\nअथ चैवं गते दोषे मयि त्वमपि दोषवान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 78}, {"id": 2087935, "chapter_id": 2871, "verse_number": "१३-१-५९x", "content_sanskrit": "सर्प उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 79}, {"id": 2087936, "chapter_id": 2871, "verse_number": "१३-१-५९", "content_sanskrit": "निर्दोषं दोषवन्तं वा न त्वां मृत्यो ब्रवीम्यहम्।\nत्वयाऽहं चोदित इति ब्रवीम्येतावदेव तु॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 80}, {"id": 2087937, "chapter_id": 2871, "verse_number": "१३-१-६०", "content_sanskrit": "यदि काले तु दोषोऽस्ति यदि तत्रापि नेष्यते।\nदोषो नैव परीक्ष्यो मे न ह्यत्राधिकृता वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 81}, {"id": 2087938, "chapter_id": 2871, "verse_number": "१३-१-६१", "content_sanskrit": "निर्मोक्षस्त्वस्य दोषस्य मया कार्यो यथा तथा।\nमृत्योरपि न दोषः स्यादिति मेऽत्र प्रयोजनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 82}, {"id": 2087939, "chapter_id": 2871, "verse_number": "१३-१-६२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 83}, {"id": 2087940, "chapter_id": 2871, "verse_number": "१३-१-६२", "content_sanskrit": "सर्पोऽथार्जुनकं प्राह श्रुतं ते मृत्युभाषितम्।\nनानागसं मां पाशेन सन्तापयितुमर्हसि।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 84}, {"id": 2087941, "chapter_id": 2871, "verse_number": "१३-१-६३x", "content_sanskrit": "लुब्धक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 85}, {"id": 2087942, "chapter_id": 2871, "verse_number": "१३-१-६३", "content_sanskrit": "मृत्योः श्रुतं मे वचनं तव चैव भुजङ्गम।\nनैव तावददोषत्वं भवति त्वयि पन्नग॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 86}, {"id": 2087943, "chapter_id": 2871, "verse_number": "१३-१-६४", "content_sanskrit": "मृत्युस्त्वं चैव हेतुर्हि बालस्यास्य विनाशने।\nउभयं कारणं मन्ये न कारणमकारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 87}, {"id": 2087944, "chapter_id": 2871, "verse_number": "१३-१-६५", "content_sanskrit": "धिङ्भृत्युं च दुरात्मानं क्रूरं दुःखकरं सताम्।\nत्वां चैवाहं वधिष्यामि परपापस्य कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 88}, {"id": 2087945, "chapter_id": 2871, "verse_number": "१३-१-६६x", "content_sanskrit": "मृत्युरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 89}, {"id": 2087946, "chapter_id": 2871, "verse_number": "१३-१-६६", "content_sanskrit": "विवशौ कालवशगावावां निर्दिष्टकारिणौ।\nनावां दोषेण गन्तव्यौ यदि सम्यक्प्रपश्यसि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 90}, {"id": 2087947, "chapter_id": 2871, "verse_number": "१३-१-६७x", "content_sanskrit": "लुब्धक उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 91}, {"id": 2087948, "chapter_id": 2871, "verse_number": "१३-१-६७", "content_sanskrit": "युवामुभौ कालवशौ यदि मे मृत्युपन्नगौ।\nहर्षक्रोधौ यथा स्यातामेतदिच्छामि वेदितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 92}, {"id": 2087949, "chapter_id": 2871, "verse_number": "१३-१-६८x", "content_sanskrit": "मृत्युरुवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 93}, {"id": 2087950, "chapter_id": 2871, "verse_number": "१३-१-६८", "content_sanskrit": "या काचिदेव चेष्टा स्यान्सर्वा कालप्रचोदिता।\nपूर्वमेवैतदुक्तं हि मया लुब्धक तत्वतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 94}, {"id": 2087951, "chapter_id": 2871, "verse_number": "१३-१-६९", "content_sanskrit": "तस्मादुभौ कालवशावावां निर्दिष्टकारिणौ।\nनावां दोपेण गन्तव्यौ त्वया लुब्धक कर्हिचित्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 95}, {"id": 2087952, "chapter_id": 2871, "verse_number": "१३-१-७०x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 96}, {"id": 2087953, "chapter_id": 2871, "verse_number": "१३-१-७०", "content_sanskrit": "अथोपगम्य कालस्तु तस्मिन्धर्मार्थसंशये।\nअब्रवीत्पन्नगं मृत्युं लुब्धं चार्जुनकं तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 97}, {"id": 2087954, "chapter_id": 2871, "verse_number": "१३-१-७१", "content_sanskrit": "न ह्यहं नाप्ययं मृत्युर्नायं लुब्धक पन्नगः।\nकिल्बिषी जन्तुमरणे न वयं हि प्रयोजकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 98}, {"id": 2087955, "chapter_id": 2871, "verse_number": "१३-१-७२", "content_sanskrit": "अकरोद्यदयं कर्म तन्नोऽर्जुनक चोदकम्।\nविनाशहेतुर्नान्योऽस्य वध्यतेऽयं स्वकर्मणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 99}, {"id": 2087956, "chapter_id": 2871, "verse_number": "१३-१-७३", "content_sanskrit": "यदनेन कृतं कर्म तेनायं निधनं गतः।\nविनाशहेतुः कर्मास्य सर्वे कर्मवशा वयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 100}, {"id": 2087957, "chapter_id": 2871, "verse_number": "१३-१-७४", "content_sanskrit": "कर्मदायादवाँल्लोकः कर्मसम्बन्धलक्षणः।\nकर्माणि चोदयन्तीह यथान्योन्यं तथावयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 101}, {"id": 2087958, "chapter_id": 2871, "verse_number": "१३-१-७५", "content_sanskrit": "यथा मृत्पिण्डतः कर्ता कुरुते यद्यदिच्छति।\nएवमात्मकृतं कर्म मानवः प्रतिपद्यते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 102}, {"id": 2087959, "chapter_id": 2871, "verse_number": "१३-१-७६", "content_sanskrit": "यथा च्छायातपौ नित्यं सुसम्बद्धौ निरन्तरम्।\nतथा कर्म च कर्ता च सम्बद्धावात्मकर्मभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 103}, {"id": 2087960, "chapter_id": 2871, "verse_number": "१३-१-७७", "content_sanskrit": "एवं नाहं न वै मृत्युर्न सर्पो न तथा भव न्।\nन चेयं ब्राह्मणी वृद्धा शिशुरेवात्र कारणम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 104}, {"id": 2087961, "chapter_id": 2871, "verse_number": "१३-१-७८", "content_sanskrit": "तस्मिंस्तथा ब्रुवाणे तु ब्राह्मणी गौतमी नृप।\nस्वकर्मप्रत्ययाँल्लोकान्मत्वाऽर्जुनकमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 105}, {"id": 2087962, "chapter_id": 2871, "verse_number": "१३-१-७९", "content_sanskrit": "नैव कालो न भुजगो न मृत्युरिह कारणम्।\nस्वकर्मभिरयं बालः कालेन निधं गतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 106}, {"id": 2087963, "chapter_id": 2871, "verse_number": "१३-१-८०", "content_sanskrit": "मया च तत्कृतं कर्म येनायं मे मृतः सुतः।\nयातु कालस्तथा मृत्युर्मुञ्चार्जुनक पन्नगम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 107}, {"id": 2087964, "chapter_id": 2871, "verse_number": "१३-१-८१x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 108}, {"id": 2087965, "chapter_id": 2871, "verse_number": "१३-१-८१", "content_sanskrit": "ततो यथागतं जग्मुर्मृत्युः कालोऽथ पन्नगः।\nअभूद्विशोकोऽर्जुनको विशोका चैव गौतमी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 109}, {"id": 2087966, "chapter_id": 2871, "verse_number": "१३-१-८२", "content_sanskrit": "एतच्छ्रुत्वा शमं गच्छ मा भूः शोकपरो नृप।\nस्वकर्मप्रत्ययाँल्लोकांस्त्रीन्विद्धि समितिंजय॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 110}, {"id": 2087967, "chapter_id": 2871, "verse_number": "१३-१-८३", "content_sanskrit": "नैव त्वया कृतं कर्म नापि दुर्योधनेन वै।\nकालेनैतत्कृतं विद्धि निहता येन पार्थिवाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 111}, {"id": 2087968, "chapter_id": 2871, "verse_number": "१३-१-८४x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 112}, {"id": 2087969, "chapter_id": 2871, "verse_number": "१३-१-८४", "content_sanskrit": "इत्येतद्वचनं श्रुत्वा बभूव विगतज्वरः।\nयुधिष्ठरो महातेजाः पप्रच्छेदं च धर्मवित्॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 113}, {"id": 2087970, "chapter_id": 2871, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते अनुशासनपर्वणि दानधर्मपर्वणि प्रथमोऽध्यायः॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 114}]