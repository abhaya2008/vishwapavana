[{"id": 900007480, "chapter_id": 8562, "verse_number": "143.1", "content_sanskrit": "भिद्यते हृदयग्रन्थिश्छिद्यन्ते सर्वसंशयाः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900007481, "chapter_id": 8562, "verse_number": "143.2", "content_sanskrit": "न च पाशुपताद्युक्तशिवादीनामनुग्रहात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900007482, "chapter_id": 8562, "verse_number": "143.3", "content_sanskrit": "नान्यः पन्था इति ह्युक्तं पुरुषज्ञानतः श्रुतौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900007483, "chapter_id": 8562, "verse_number": "143.4", "content_sanskrit": "सर्वे निमेषा जज्ञिरे विद्युतः पुरुषादधि", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900007484, "chapter_id": 8562, "verse_number": "143.5", "content_sanskrit": "न तस्येशे कश्चन तस्य नाम महद्यशः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900007485, "chapter_id": 8562, "verse_number": "143.6", "content_sanskrit": "समाधिकस्य राहित्यान्नोपचारपुमानसौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 900007486, "chapter_id": 8562, "verse_number": "143.7", "content_sanskrit": "समाधिकस्य राहित्यान्नोपचारपुमानसौ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 900007487, "chapter_id": 8562, "verse_number": "143.8", "content_sanskrit": "पुरुष एवेदं सर्वं यद्भूतं यच्च भव्यम्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 900007488, "chapter_id": 8562, "verse_number": "143.9", "content_sanskrit": "अमृतेशानवचनात्सर्वस्येशानतोदिता", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 900007489, "chapter_id": 8562, "verse_number": "143.10", "content_sanskrit": "यदि सर्वत्वमुदितमुतेश इति तद्वृथा", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 900007490, "chapter_id": 8562, "verse_number": "143.11", "content_sanskrit": "पुरुषेणैवेदं व्याप्तमिति ब्राह्मणं चाह तं प्रति", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 900007491, "chapter_id": 8562, "verse_number": "143.12", "content_sanskrit": "एतावानस्य महिमेति महिम्नो वचो हि तत्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 900007492, "chapter_id": 8562, "verse_number": "143.13", "content_sanskrit": "सोऽमृतस्याभयस्येशो मर्त्यमन्नं यदत्यगात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 900007493, "chapter_id": 8562, "verse_number": "143.14", "content_sanskrit": "सोऽमृतस्याभयस्येशो मर्त्यमन्नं यदत्यगात्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 900007494, "chapter_id": 8562, "verse_number": "143.15", "content_sanskrit": "अतो विष्णुपरिज्ञानादेव मुक्तिर्न चान्यतः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]