[{"id": 2043240, "chapter_id": 1966, "verse_number": "६-१५-०x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2043241, "chapter_id": 1966, "verse_number": "६-१५-१", "content_sanskrit": "त्वद्युक्तोऽयमनुप्रश्नो महाराज यथार्हसि।\nन तु दुर्योधने दोषमिममासङ्क्तुमर्हसि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2043242, "chapter_id": 1966, "verse_number": "६-१५-२", "content_sanskrit": "य आत्मनो दुश्चरितादशुभं प्राप्नुयान्नरः।\nएनसा तेन नान्यं स उपाशङ्कितुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2043243, "chapter_id": 1966, "verse_number": "६-१५-३", "content_sanskrit": "महाराज मनुष्येषु निन्द्यं यः सर्वमाचरेत्।\nस वध्यः सर्वलोकस्य निन्दितानि समाचरन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2043244, "chapter_id": 1966, "verse_number": "६-१५-४", "content_sanskrit": "निकारो निकृतिप्रज्ञैः पाण्डवैस्त्वत्प्रतीक्षया ।\nअनुभूतः सहामात्यैः क्षान्तश्च सुचिरं वने ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2043245, "chapter_id": 1966, "verse_number": "६-१५-५", "content_sanskrit": "हयानां च गजानां च राज्ञां चामिततेजसाम्।\nप्रत्यक्षं यन्मया दृष्टं दृष्टं योगबलेन च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2043246, "chapter_id": 1966, "verse_number": "६-१५-६", "content_sanskrit": "शृणु तत्पृथिवीपाल मा च शोके मनः कृथाः ।\nदिष्टमेतत्पुरा नूनमिदमेव नराधिप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2043247, "chapter_id": 1966, "verse_number": "६-१५-७", "content_sanskrit": "नमस्कृत्वा प्रवक्ष्यामि पाराशर्याय धीमते।\nयस्य प्रसादाद्दिव्यं तत्प्राप्तं ज्ञानमनुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2043248, "chapter_id": 1966, "verse_number": "६-१५-८", "content_sanskrit": "दृष्टिश्चातीन्द्रिया राजन्दूराच्छ्रवणमेव च ।\nपरचित्तस्य विज्ञानमतीतानागतस्य च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2043249, "chapter_id": 1966, "verse_number": "६-१५-९", "content_sanskrit": "व्युत्थितोत्पत्तिविज्ञानमाकाशे च गतिः शुभा ।\nअस्त्रैरसङ्गो युद्धेषु वरदानान्महात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2043250, "chapter_id": 1966, "verse_number": "६-१५-१०", "content_sanskrit": "श्रृणु मे विस्तरेणेदं विचित्रं परमाद्भुतम् ।\nभरतानामभूद्युद्धं यथा तद्रोमहर्षणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2043251, "chapter_id": 1966, "verse_number": "६-१५-११", "content_sanskrit": "तेष्वनीकेषु यत्तेषु व्यूढेषु च विधानतः ।\nदुर्योधनो महाराज दुःशासनमथाब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2043252, "chapter_id": 1966, "verse_number": "६-१५-१२", "content_sanskrit": "दुःशासन रथास्तूर्णं युज्यन्तां भीष्मरक्षिणः।\nअनीकानि च सर्वाणि शीघ्रं त्वमनुचोदय ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2043253, "chapter_id": 1966, "verse_number": "६-१५-१३", "content_sanskrit": "अयं स मामभिप्राप्तो वर्षपूगाभिचिन्तितः ।\nपाण्डवानां ससैन्यानां कुरूणां च समागमः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2043254, "chapter_id": 1966, "verse_number": "६-१५-१४", "content_sanskrit": "नातः कार्यतमं मन्ये रणे भीष्मस्य रक्षणात्।\nहन्युद्गुप्तो ह्यसौ पार्थान्सोमकांश्च ससृञ्जयान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2043255, "chapter_id": 1966, "verse_number": "६-१५-१५", "content_sanskrit": "अब्रवीच्च विशुद्धात्मा नाहं हन्यां शिखण्डिनाम् ।\nश्रूयते स्त्री ह्यसौ पूर्वं तस्मादूर्त्यो रणे मम ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2043256, "chapter_id": 1966, "verse_number": "६-१५-१६", "content_sanskrit": "तस्माद्भीष्मो रक्षितव्यो विशेषेणेति मे मतिः।\nशिखण्डिनो वधे यत्ताः सर्वे तिष्ठन्तु मामकाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2043257, "chapter_id": 1966, "verse_number": "६-१५-१७", "content_sanskrit": "तथा प्राच्याः प्रतीच्याश्च दाक्षिणात्योत्तरापथाः ।\nसर्वथाऽस्त्रेषु कुशलास्ते रक्षन्तु पितामहम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2043258, "chapter_id": 1966, "verse_number": "६-१५-१८", "content_sanskrit": "अरक्ष्यमाणं हि वृको हन्यात्सिंहं महाबलम् ।\nमा सिंहं जम्बुकेनेव घातयामः शिखण्डिना ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2043259, "chapter_id": 1966, "verse_number": "६-१५-१९", "content_sanskrit": "वामं चक्रं युधामन्युरुत्तमौजाश्च दक्षिणम्।\nगोप्तारौ फाल्गुनं प्राप्तौ फाल्गुनोपि शिखण्डिनः ।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2043260, "chapter_id": 1966, "verse_number": "६-१५-२०", "content_sanskrit": "संरक्ष्यमाणः पार्थेन भीष्मेण च विवर्जितः ।\nयथा न हन्याद्गाङ्गेयं दुःशासन तथा कुरु ॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2043261, "chapter_id": 1966, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते भीष्मपर्वणि भगवद्गीतापर्वणि पञ्चदशोऽध्यायः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}]