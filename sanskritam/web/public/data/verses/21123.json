[{"id": 7001123000, "chapter_id": 21123, "verse_number": "२-२-१४-१", "content_sanskrit": "ब्रह्मोवाच ।\nएतस्मिन्नन्तरे देवमुने लोकपितामह ।\nतत्रागममहं प्रीत्या ज्ञात्वा तच्चरितं द्रुतम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7001123001, "chapter_id": 21123, "verse_number": "२-२-१४-२", "content_sanskrit": "असांत्वयमहं दक्षं पूर्ववत्सुविचक्षणः ।\nअकार्षं तेन सुस्नेहं तव सुप्रीतिमावहन्॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7001123002, "chapter_id": 21123, "verse_number": "२-२-१४-३", "content_sanskrit": "स्वात्मजं मुनिवर्यं त्वां सुप्रीत्या देववल्लभम् ।\nसमाश्वास्य समादाय प्रत्यपद्ये स्वधाम ह॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7001123003, "chapter_id": 21123, "verse_number": "२-२-१४-४", "content_sanskrit": "ततः प्रजापतिर्दक्षोऽनुनीतो मे निजस्त्रियाम् ।\nजनयामास दुहितॄस्सुभगाः षष्टिसंमिताः॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7001123004, "chapter_id": 21123, "verse_number": "२-२-१४-५", "content_sanskrit": "तासां विवाहकृतवान्धर्मादिभिरतंद्रितः ।\nतदेव शृणु सुप्रीत्या प्रवदामि मुनीश्वर॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7001123005, "chapter_id": 21123, "verse_number": "२-२-१४-६", "content_sanskrit": "ददौ दश सुता दक्षो धर्माय विधिवन्मुने ।\nत्रयोदश कश्यपाय मुनये त्रिनवेंदवे॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7001123006, "chapter_id": 21123, "verse_number": "२-२-१४-७", "content_sanskrit": "भूतांगिरः कृशाश्वेभ्यो द्वेद्वे पुत्री प्रदत्तवान् ।\nतार्क्ष्याय चापरः कन्या प्रसूतिप्रसवैर्यतः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7001123007, "chapter_id": 21123, "verse_number": "२-२-१४-८", "content_sanskrit": "त्रिलोकाः पूरितास्तन्नो वर्ण्यते व्यासतो भयात्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7001123008, "chapter_id": 21123, "verse_number": "२-२-१४-९", "content_sanskrit": "केचिद्वदंति तां ज्येष्ठां मध्यमां चापरे शिवाम् ।\nसर्वानन्तरजां केचित्कल्पभेदात्त्रयं च सत॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7001123009, "chapter_id": 21123, "verse_number": "२-२-१४-१०", "content_sanskrit": "अनंतरं सुतोत्पत्तेः सपत्नीकः प्रजापतिः ।\nदक्षो दधौ सुप्रीत्मा तां मनसा जगदम्बिकाम्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7001123010, "chapter_id": 21123, "verse_number": "२-२-१४-११", "content_sanskrit": "अतः प्रेम्णा च तुष्टाव गिरा गद्गदया हि सः ।\nभूयोभूयो नमस्कृत्य सांजलिर्विनयान्वितः॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7001123011, "chapter_id": 21123, "verse_number": "२-२-१४-१२", "content_sanskrit": "सन्तुष्टा सा तदा देवी विचारं मनसीति च ।\nचक्रेऽवतारं वीरिण्यां कुर्यां पणविपूर्तये॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7001123012, "chapter_id": 21123, "verse_number": "२-२-१४-१३", "content_sanskrit": "अथ सोवास मनसि दक्षस्य जगदम्बिका ।\nविललास तदातीव स दक्षो मुनिसत्तम॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7001123013, "chapter_id": 21123, "verse_number": "२-२-१४-१४", "content_sanskrit": "सुमुहूर्तेनाथ दक्षोऽपि स्वपत्न्यां निदधे मुदा ।\nदक्षपत्न्यास्तदा चित्ते शिवोवास दयान्विता॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7001123014, "chapter_id": 21123, "verse_number": "२-२-१४-१५", "content_sanskrit": "आविर्बभूवुश्चिह्नानि दोहदस्याखिलानि वै॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7001123015, "chapter_id": 21123, "verse_number": "२-२-१४-१६", "content_sanskrit": "विरेजे वीरिणी तात हृष्टचित्ताधिका च सा ।\nशिवावासप्रभावात्तु महामंगल रूपिणी॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7001123016, "chapter_id": 21123, "verse_number": "२-२-१४-१७", "content_sanskrit": "कुलस्य संपदश्चैव श्रुतेश्चित्तसमुन्नतेः ।\nव्यधत्त सुक्रिया दक्षः प्रीत्या पुंसवनादिकाः॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7001123017, "chapter_id": 21123, "verse_number": "२-२-१४-१८", "content_sanskrit": "उत्सवोतीव संजातस्तदा तेषु च कर्मसु ।\nवित्तं ददौ द्विजातिभ्यो यथाकामं प्रजापतिः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7001123018, "chapter_id": 21123, "verse_number": "२-२-१४-१९", "content_sanskrit": "अथ तस्मिन्नवसरे सर्वे हर्यादयस्सुराः ।\nज्ञात्वा गर्भगतां देवीं वीरिण्यास्ते मुदं ययुः॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7001123019, "chapter_id": 21123, "verse_number": "२-२-१४-२०", "content_sanskrit": "तत्रागत्य च सर्वे ते तुष्टुवुर्जगदम्बिकाम् ।\nलोकोपकारकरिणीं प्रणम्य च मुहुर्मुहुः॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7001123020, "chapter_id": 21123, "verse_number": "२-२-१४-२१", "content_sanskrit": "कृत्वा ततस्ते बहुधा प्रशंसां हृष्टमानसाः ।\nदक्षप्रजापतेश्चैव वीरिण्यास्स्वगृहं ययुः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7001123021, "chapter_id": 21123, "verse_number": "२-२-१४-२२", "content_sanskrit": "गतेषु नवमासेषु कारयित्वा च लौकिकीम् ।\nगतिं शिवा च पूर्णे सा दशमे मासि नारद॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7001123022, "chapter_id": 21123, "verse_number": "२-२-१४-२३", "content_sanskrit": "आविर्बभूव पुरतो मातुस्सद्यस्तदा मुने ।\nमुहूर्ते सुखदे चन्द्रग्रहतारानुकूलके॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7001123023, "chapter_id": 21123, "verse_number": "२-२-१४-२४", "content_sanskrit": "तस्यां तु जातमात्रायां सुप्रीतोऽसौ प्रजापतिः ।\nसैव देवीति तां मेने दृष्ट्वा तां तेजसोल्बणाम्॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7001123024, "chapter_id": 21123, "verse_number": "२-२-१४-२५", "content_sanskrit": "तदाभूत्पुष्पसद्वृष्टिर्मेघाश्च ववृषुर्जलम् ।\nदिशश्शांता द्रुतं तस्यां जातायां च मुनीश्वर॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7001123025, "chapter_id": 21123, "verse_number": "२-२-१४-२६", "content_sanskrit": "अवादयंत त्रिदशाश्शुभवाद्यानि खे गताः ।\nजज्ज्वलुश्चाग्नयश्शांताः सर्वमासीत्सुमंगलम्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7001123026, "chapter_id": 21123, "verse_number": "२-२-१४-२७", "content_sanskrit": "वीरिणोसंभवां दृष्ट्वा दक्षस्तां जगदम्बिकाम् ।\nनमस्कृत्य करौ बद्ध्वा बहु तुष्टाव भक्तितः॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7001123027, "chapter_id": 21123, "verse_number": "२-२-१४-२८", "content_sanskrit": "दक्ष उवाच ।\nमहेशानि नमस्तुभ्यं जगदम्बे सनातनि ।\nकृपां कुरु महादेवि सत्ये सत्यस्वरूपिणि॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7001123028, "chapter_id": 21123, "verse_number": "२-२-१४-२९", "content_sanskrit": "शिवा शांता महामाया योगनिद्रा जगन्मयी ।\nया प्रोच्यते वेदविद्भिर्नमामि त्वां हितावहाम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7001123029, "chapter_id": 21123, "verse_number": "२-२-१४-३०", "content_sanskrit": "यया धाता जगत्सृष्टौ नियुक्तस्तां पुराकरोत् ।\nतां त्वां नमामि परमां जगद्धात्रीं महेश्वरीम्॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7001123030, "chapter_id": 21123, "verse_number": "२-२-१४-३१", "content_sanskrit": "यया विष्णुर्जगत्स्थित्यै नियुक्तस्तां सदाकरोत् ।\nतां त्वां नमामि परमां जगद्धात्रीं महेश्वरीम्॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7001123031, "chapter_id": 21123, "verse_number": "२-२-१४-३२", "content_sanskrit": "यया रुद्रो जगन्नाशे नियुक्तस्तां सदाकरोत् ।\nतां त्वां नमामि परमां जगद्धात्रीं महेश्वरीम्॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7001123032, "chapter_id": 21123, "verse_number": "२-२-१४-३३", "content_sanskrit": "रजस्सत्त्वतमोरूपां सर्वकार्यकरीं सदा ।\nत्रिदेवजननीं देवीं त्वां नमामि च तां शिवाम्॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7001123033, "chapter_id": 21123, "verse_number": "२-२-१४-३४", "content_sanskrit": "यस्त्वां विचिंतयेद्देवीं विद्याविद्यात्मिकां पराम् ।\nतस्य भुक्तिश्च मुक्तिश्च सदा करतले स्थिता॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7001123034, "chapter_id": 21123, "verse_number": "२-२-१४-३५", "content_sanskrit": "यस्त्वां प्रत्यक्षतो देवि शिवां पश्यति पावनीम् ।\nतस्यावश्यं भवेन्मुक्तिर्विद्याविद्याप्रकाशिका॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7001123035, "chapter_id": 21123, "verse_number": "२-२-१४-३६", "content_sanskrit": "ये स्तुवंति जगन्मातर्भवानीमंबिकेति च ।\nजगन्मयीति दुर्गेति सर्वं तेषां भविष्यति॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7001123036, "chapter_id": 21123, "verse_number": "२-२-१४-३७", "content_sanskrit": "ब्रह्मोवाच ।\nइति स्तुता जगन्माता शिवा दक्षेण धीमता ।\nतथोवाच तदा दक्षं यथा माता शृणोति न॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7001123037, "chapter_id": 21123, "verse_number": "२-२-१४-३८", "content_sanskrit": "सर्वं मुमोह तथ्यं च तथा दक्षः शृणोतु तत् ।\nनान्यस्तथा शिवा प्राह नानोतिः परमेश्वरी॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7001123038, "chapter_id": 21123, "verse_number": "२-२-१४-३९", "content_sanskrit": "देव्युवाच ।\nअहमाराधिता पूर्वं सुतार्थं ते प्रजापते ।\nईप्सितं तव सिद्धं तु तपो धारय संप्रति॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7001123039, "chapter_id": 21123, "verse_number": "२-२-१४-४०", "content_sanskrit": "ब्रह्मोवाच ।\nएवमुक्त्वा तदा देवी दक्षं च निजमायया ।\nआस्थाय शैशवं भावं जनन्यंते रुरोद सा॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7001123040, "chapter_id": 21123, "verse_number": "२-२-१४-४१", "content_sanskrit": "अथ तद्रोदनं श्रुत्वा स्त्रियो वाक्यं ससंभ्रमाः ।\nआगतास्तत्र सुप्रीत्या दास्योपि च ससंभ्रमाः॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7001123041, "chapter_id": 21123, "verse_number": "२-२-१४-४२", "content_sanskrit": "दृष्ट्वासिक्नीसुतारूपं ननन्दुस्सर्वयोषितः ।\nसर्वे पौरजनाश्चापि चक्रुर्जयरवं तदा॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7001123042, "chapter_id": 21123, "verse_number": "२-२-१४-४३", "content_sanskrit": "उत्सवश्च महानासीद्गानवाद्यपुरस्सरम् ।\nदक्षोसिक्नी मुदं लेभे शुभं दृष्ट्वा सुताननम्॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7001123043, "chapter_id": 21123, "verse_number": "२-२-१४-४४", "content_sanskrit": "दक्षः श्रुतिकुलाचारं चक्रे च विधिवत्तदा ।\nदानं ददौ द्विजातिभ्योन्येभ्यश्च द्रविणं तथा॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7001123044, "chapter_id": 21123, "verse_number": "२-२-१४-४५", "content_sanskrit": "बभूव सर्वतो गानं नर्तनं च यथोचितम् ।\nनेदुर्वाद्यानि बहुशस्सुमंगलपुरस्सरम्॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7001123045, "chapter_id": 21123, "verse_number": "२-२-१४-४६", "content_sanskrit": "अथ हर्यादयो देवास्सर्वे सानुचरास्तदा ।\nमुनिवृन्दैः समागत्योत्सवं चक्रुर्यथाविधि॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7001123046, "chapter_id": 21123, "verse_number": "२-२-१४-४७", "content_sanskrit": "दृष्ट्वा दक्षसुतामंबां जगतः परमेश्वरीम् ।\nनेमुः सविनयास्सर्वे तुष्टुवुश्च शुभैस्तवैः॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7001123047, "chapter_id": 21123, "verse_number": "२-२-१४-४८", "content_sanskrit": "ऊचुस्सर्वे प्रमुदिता गिरं जयजयात्मिकाम् ।\nप्रशशंसुर्मुदा दक्षं वीरिणीं च विशेषतः॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7001123048, "chapter_id": 21123, "verse_number": "२-२-१४-४९", "content_sanskrit": "तदोमेति नाम चक्रे तस्या दक्षस्तदाज्ञया ।\nप्रशस्तायास्सर्वगुणसत्त्वादपि मुदान्वितः॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7001123049, "chapter_id": 21123, "verse_number": "२-२-१४-५०", "content_sanskrit": "नामान्यन्यानि तस्यास्तु पश्चाज्जातानि लोकतः ।\nमहामंगलदान्येव दुःखघ्नानि विशेषतः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7001123050, "chapter_id": 21123, "verse_number": "२-२-१४-५१", "content_sanskrit": "दक्षस्तदा हरिं नत्वा मां सर्वानमरानपि ।\nमुनीनपि करौ बद्ध्वा स्तुत्वा चानर्च भक्तितः॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 7001123051, "chapter_id": 21123, "verse_number": "२-२-१४-५२", "content_sanskrit": "अथ विष्ण्वादयस्सर्वे सुप्रशस्याजनंदनम् ।\nप्रीत्या ययुस्वधामानि संस्मरन् सशिवं शिवम्॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 7001123052, "chapter_id": 21123, "verse_number": "२-२-१४-५३", "content_sanskrit": "अतस्तां च सुतां माता सुसंस्कृत्य यथोचितम् ।\nशिशुपानेन विधिना तस्यै स्तन्यादिकं ददौ॥ ५३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 7001123053, "chapter_id": 21123, "verse_number": "२-२-१४-५४", "content_sanskrit": "पालिता साथ वीरिण्या दक्षेण च महात्मना ।\nववृधे शुक्लपक्षस्य यथा शशिकलान्वहम्॥ ५४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 7001123054, "chapter_id": 21123, "verse_number": "२-२-१४-५५", "content_sanskrit": "तस्यां तु सद्गुणास्सर्वे विविशुर्द्विजसत्तम ।\nशैशवेपि यथा चन्द्रे कलास्सर्वा मनोहराः॥ ५५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 7001123055, "chapter_id": 21123, "verse_number": "२-२-१४-५६", "content_sanskrit": "आचरन्निजभावेन सखीमध्यगता यदा ।\nतदा लिलेख भर्गस्य प्रतिमामन्वहं मुहुः॥ ५६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 7001123056, "chapter_id": 21123, "verse_number": "२-२-१४-५७", "content_sanskrit": "यदा जगौ सुगीतानि शिवा बाल्योचितानि सा ।\nतदा स्थाणुं हरं रुद्रं सस्मार स्मरशासनम्॥ ५७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 7001123057, "chapter_id": 21123, "verse_number": "२-२-१४-५८", "content_sanskrit": "ववृधेतीव दंपत्योः प्रत्यहं करुणातुला ।\nतस्या बाल्येपि भक्तायास्तयोर्नित्यं मुहुर्मुहुः॥ ५८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 7001123058, "chapter_id": 21123, "verse_number": "२-२-१४-५९", "content_sanskrit": "सर्वबालागुणा क्रांतां सदा स्वालयकारिणीम् ।\nतोषयामास पितरौ नित्यंनित्यं मुहुर्मुहुः॥ ५९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}]