[{"id": 900001100, "chapter_id": 8212, "verse_number": "1.1", "content_sanskrit": "सुकेशा च भारद्वाजः शैब्यश्च सत्यकामः सौर्यायणी च गार्ग्यः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 900001101, "chapter_id": 8212, "verse_number": "1.2", "content_sanskrit": "अथ हैनं भार्गवो वैदर्भिः पप्रच्छ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 900001102, "chapter_id": 8212, "verse_number": "1.3", "content_sanskrit": "अथ हैनं कौसल्यश्चाश्वलायनः पप्रच्छ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 900001103, "chapter_id": 8212, "verse_number": "1.4", "content_sanskrit": "अथ हैनं सौर्यायणी गार्ग्यः पप्रच्छ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 900001104, "chapter_id": 8212, "verse_number": "1.5", "content_sanskrit": "अथ हैनं शैब्यः सत्यकामः पप्रच्छ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 900001105, "chapter_id": 8212, "verse_number": "1.6", "content_sanskrit": "अथ हैनं सुकेशा भारद्वाजः पप्रच्छ", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}]