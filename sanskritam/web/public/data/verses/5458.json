[{"id": 2208669, "chapter_id": 5458, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2208670, "chapter_id": 5458, "verse_number": "१", "content_sanskrit": "ततो ह्यचोदयत् कृष्णो युज्यतामिति दारुकम् ।\nमुहूर्तादिव चाचष्ट युक्तमित्येव दारुकः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2208671, "chapter_id": 5458, "verse_number": "२", "content_sanskrit": "तथैव चानुयात्राणि चोदयामास पाण्डवः ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2208672, "chapter_id": 5458, "verse_number": "३", "content_sanskrit": "सन्नह्यध्वं प्रयास्यामो नगरं गजसाह्वयम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2208673, "chapter_id": 5458, "verse_number": "४", "content_sanskrit": "इत्युक्ताः सैनिकास्ते तु सज्जीभूता विशाम्पते ।\nआचख्युः सज्जमित्येवं पार्थायामिततेजसे ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2208674, "chapter_id": 5458, "verse_number": "५", "content_sanskrit": "ततस्तौ रथमास्थाय प्रयातौ कृष्णपाण्डवौ ।\nतौ कुर्वाणौ कथाश्चित्राः प्रीयमाणौ विशाम्पते ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2208675, "chapter_id": 5458, "verse_number": "६", "content_sanskrit": "रथस्थं तं महातेजा वासुदेवं धनञ्जयः ।\nपुनरेवाब्रवीद् वाक्यमिदं भरतसत्तम ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2208676, "chapter_id": 5458, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2208677, "chapter_id": 5458, "verse_number": "७", "content_sanskrit": "त्वत्प्रसादाज्जयं प्राप्तो राजा वृष्णिकुलोद्वह ।\nनिहताः शत्रवश्चापि प्राप्तं राज्यमकण्टकम् ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2208678, "chapter_id": 5458, "verse_number": "८", "content_sanskrit": "नाथवन्तश्च भवता पाण्डवा मधुसूदन ।\nभवन्तं प्लवमासाद्य तीर्णाः स्म कुरुसागरम् ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2208679, "chapter_id": 5458, "verse_number": "९", "content_sanskrit": "भक्तान् त्वमाश्रितानस्मान् पालयामुत्र चेह च ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2208680, "chapter_id": 5458, "verse_number": "१०", "content_sanskrit": "विश्वकर्मन् नमस्तेऽस्तु विश्वात्मन् विश्वसम्भव ।\nयथाऽहं त्वां विजानामि तथा हि भगवान् मम ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2208681, "chapter_id": 5458, "verse_number": "११", "content_sanskrit": "त्वत्तेजःसम्भवो नित्यं हुताशो मधुसूदन ।\nरतिः क्रीडामयी तुभ्यं माया ते रोदसी विभो ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2208682, "chapter_id": 5458, "verse_number": "१२", "content_sanskrit": "त्वयि सर्वमिदं विश्वं यदिदं स्थाणुजङ्गमम् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2208683, "chapter_id": 5458, "verse_number": "१३", "content_sanskrit": "त्वं हि सर्वं विकुरुषे भूतग्रामं सनातनम् ।\nपृथिवीं चान्तरिक्षं च तथा स्थावरजङ्गमम् ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2208684, "chapter_id": 5458, "verse_number": "१४", "content_sanskrit": "हसितं तेऽमला ज्योत्स्ना ऋतवश्चेन्द्रियाणि च ।\nप्राणो वायुः सततगः क्रोधो मृत्युः सनातनः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2208685, "chapter_id": 5458, "verse_number": "१५", "content_sanskrit": "प्रसादे चापि पद्मा श्रीः नित्यं तव महामते ।\nरतिस्तुष्टिर्धृतिः क्षान्तिस्त्वयि चेदं चराचरम् ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2208686, "chapter_id": 5458, "verse_number": "१६", "content_sanskrit": "त्वमेव हि युगान्तेषु निधनं प्रोच्यतेऽनघ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2208687, "chapter_id": 5458, "verse_number": "१७", "content_sanskrit": "सुदीर्घेणापि कालेन न ते शक्या गुणा मया ।\nआत्मा च परमो वक्तुं नमस्ते नलिनेक्षण ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2208688, "chapter_id": 5458, "verse_number": "१८", "content_sanskrit": "विदितो मे सुदुर्धर्षं नारदाद् देवलात् तथा ।\nकृष्णद्वैपायनाच्चैव तथा कुरुपितामहात् ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2208689, "chapter_id": 5458, "verse_number": "१९", "content_sanskrit": "त्वयि सर्वं समासक्तं त्वमेवैको जनार्दनः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2208690, "chapter_id": 5458, "verse_number": "२०", "content_sanskrit": "यच्चानुग्रहसंयुक्तमेतदुक्तं त्वयाऽनघ ।\nएतत्सर्वमहं सम्यक् करिष्यामि जनार्दन ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2208691, "chapter_id": 5458, "verse_number": "२१", "content_sanskrit": "इदं चाद्भुतमव्यग्रं कृतमस्मत्प्रियेप्सया ।\nयत्पापा निहताः सङ्खे कौरव्या धृतराष्ट्रजाः ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2208692, "chapter_id": 5458, "verse_number": "२२", "content_sanskrit": "त्वया दग्धं हि तत्सैन्यं मया विजितमाहवे ।\nभवता तत्कृतं कर्म येनावाप्तो जयो मया ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2208693, "chapter_id": 5458, "verse_number": "२३", "content_sanskrit": "दुर्योधनस्य सङ्ग्रामे तव बुद्धिपराक्रमैः ।\nकर्णस्य च वधोपायो यथावत् सम्प्रदर्शितः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2208694, "chapter_id": 5458, "verse_number": "२४", "content_sanskrit": "सैन्धवस्य च पापस्य भूरिश्रवस एव च ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2208695, "chapter_id": 5458, "verse_number": "२५", "content_sanskrit": "तस्मात् त्वमेव सञ्चिन्त्य हितं कुरु यथा तथा ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2208696, "chapter_id": 5458, "verse_number": "२६", "content_sanskrit": "अहं च प्रीयमाणोऽस्मि त्वया देवकिनन्दन ।\nयदुक्तं तत्करिष्यामि न हि मेऽस्ति विचारणा ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2208697, "chapter_id": 5458, "verse_number": "२७", "content_sanskrit": "राजानं च समासाद्य धर्मात्मानं युधिष्ठिरम् ।\nचोदयिष्यामि धर्मज्ञ गमनार्थं तवानघ ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2208698, "chapter_id": 5458, "verse_number": "२८", "content_sanskrit": "रुचितं हि ममाप्येतद् द्वारकागमनं प्रति ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2208699, "chapter_id": 5458, "verse_number": "२९", "content_sanskrit": "द्रष्टासि नचिरादेव मातुलं मधुसूदन ।\nबलदेवं च दुर्धर्षं तथाऽन्यान् वृष्णिपुङ्गवान् ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2208700, "chapter_id": 5458, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2208701, "chapter_id": 5458, "verse_number": "३०", "content_sanskrit": "एवं सम्भाषमाणौ तौ प्राप्तौ वारणसाह्वयम् ।\nतथा विविशतुश्चोभौ सम्प्रहृष्टजनाकुलम् ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2208702, "chapter_id": 5458, "verse_number": "३१", "content_sanskrit": "तौ गत्वा धृतराष्ट्रस्य गृहं शक्रगृहोपमम् ।\nदृष्टवन्तौ महाराज धृतराष्ट्रं जनेश्वरम् ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2208703, "chapter_id": 5458, "verse_number": "३२", "content_sanskrit": "विदुरं च महाबुद्धिं राजानं च युधिष्ठिरम् ।\nभीमसेनं च दुर्धर्षं माद्रीपुत्रौ च पाण्डवौ ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2208704, "chapter_id": 5458, "verse_number": "३३", "content_sanskrit": "धृतराष्ट्रमुपासीनं युयुत्सुं चापराजितम् ।\nगान्धारीं च महाप्राज्ञां पृथां कृष्णां च भामिनीम् ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2208705, "chapter_id": 5458, "verse_number": "३४", "content_sanskrit": "सुभद्रां चापि ताः सर्वा भरतानां स्त्रियस्तथा ।\nदृष्टवन्तौ स्थिताः सर्वा गान्धारीं परिवार्य ते ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2208706, "chapter_id": 5458, "verse_number": "३५", "content_sanskrit": "ततः समेत्य राजानं धृतराष्ट्रमरिन्दमौ ।\nनिवेद्य नामधेये स्वे वन्देतां चरणौ ततः ॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2208707, "chapter_id": 5458, "verse_number": "३६", "content_sanskrit": "गान्धार्याश्च पृथायाश्च धर्मराजस्य धीमतः ।\nभीमस्य च ववन्दाते तथा पादौ महात्मनः ॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2208708, "chapter_id": 5458, "verse_number": "३७", "content_sanskrit": "परिष्वज्य महात्मानं वेश्यापुत्रं महारथम् ।\nक्षत्तारं चाभिसम्पूज्य पृष्ट्वा कुशलमव्ययम् ॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2208709, "chapter_id": 5458, "verse_number": "३८", "content_sanskrit": "तैः सार्धं नृपतिं वृद्धं उपासाते ततस्तु तौ ॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2208710, "chapter_id": 5458, "verse_number": "३९", "content_sanskrit": "ततो निशि महाराजो धृतराष्ट्रो जनेश्वरान् ।\nजनार्दनं च मेधावी व्यसर्जयत वै गृहान् ॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2208711, "chapter_id": 5458, "verse_number": "४०", "content_sanskrit": "तेऽनुज्ञाता नृपतिना ययुः स्वं स्वं निवेशनम् ।\nधनञ्जयगृहानेव ययौ कृष्णस्तु वीर्यवान् ॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2208712, "chapter_id": 5458, "verse_number": "४१", "content_sanskrit": "तत्रार्चितो यथान्यायं सर्वकामैरुपस्थितः ।\nकृष्णः सुष्वाप मेधावी धनञ्जयसहायवान् ॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2208713, "chapter_id": 5458, "verse_number": "४२", "content_sanskrit": "प्रभातायां तु शर्वर्यां कृतसर्वाह्निकक्रियौ ।\nधर्मराजस्य भवनं जग्मतुः परमार्चितौ ॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2208714, "chapter_id": 5458, "verse_number": "४३", "content_sanskrit": "यत्रास्ते तु सहामात्यो धर्मराजो महामनाः ॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2208715, "chapter_id": 5458, "verse_number": "४४", "content_sanskrit": "ततस्तु तत् प्रविश्याथ ददृशाते महाबलौ ।\nधर्मराजं तमासीनं देवराजमिवाश्विनौ ॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2208716, "chapter_id": 5458, "verse_number": "४५", "content_sanskrit": "तौ समासाद्य राजानं वार्ष्णेयकुरुपुङ्गवौ ।\nनिषीदतुरनुज्ञातौ प्रीयमाणेन तेन वै ॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2208717, "chapter_id": 5458, "verse_number": "४६", "content_sanskrit": "ततः स राजा मेधावी विवक्षू प्रेक्ष्य तावुभौ ।\nप्रोवाच वदतां श्रेष्ठौ वचनं राजसत्तमः ॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2208718, "chapter_id": 5458, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2208719, "chapter_id": 5458, "verse_number": "४७", "content_sanskrit": "विवक्षू हि युवां मन्ये वीरौ यदुकुरूद्वहौ ।\nब्रूतं कर्तास्मि सर्वं वां न चिरान्मां विचार्यताम् ॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2208720, "chapter_id": 5458, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2208721, "chapter_id": 5458, "verse_number": "४८", "content_sanskrit": "इत्युक्तः फल्गुनस्तत्र धर्मराजानमब्रवीत् ।\nविनीतवदुपागम्य वाक्यं वाक्यविशारदः ॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2208722, "chapter_id": 5458, "verse_number": "", "content_sanskrit": "अर्जुनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2208723, "chapter_id": 5458, "verse_number": "४९", "content_sanskrit": "अयं चिरोषितो राजन् वासुदेवः प्रतापवान् ।\nभवन्तं समनुज्ञाप्य पितरं द्रष्टुमिच्छति ॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2208724, "chapter_id": 5458, "verse_number": "५०", "content_sanskrit": "स गच्छत्वभ्यनुज्ञातो भवता यदि मन्यसे ।\nआनर्तनगरं वीरस्तदनुज्ञातुमर्हसि ॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2208725, "chapter_id": 5458, "verse_number": "", "content_sanskrit": "युधिष्ठिरः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2208726, "chapter_id": 5458, "verse_number": "५१", "content_sanskrit": "पुण्डरीकाक्ष भद्रं ते गच्छ त्वं मधुसूदन ।\nपुरीं द्वारावतीमद्य द्रष्टुं शूरसुतं विभुम् ॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2208727, "chapter_id": 5458, "verse_number": "५२", "content_sanskrit": "रोचते मे महाबाहो गमनं तव केशव ।\nमातुलश्चिरदृष्टस्ते त्वया देवी च देवकी ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2208728, "chapter_id": 5458, "verse_number": "५३", "content_sanskrit": "मातुलं वसुदेवं त्वं बलदेवं च माधव ।\nपूजयेथा महाप्राज्ञ मद् वाक्येन यथार्हतः ॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2208729, "chapter_id": 5458, "verse_number": "५४", "content_sanskrit": "स्मरेथाश्चापि मां नित्यं भीमं च बलिनां वरम् ।\nफल्गुनं नकुलं चैव सहदेवं च माधव ॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2208730, "chapter_id": 5458, "verse_number": "५५", "content_sanskrit": "आनर्तानवलोक्य त्वं पितरं च महाभुजम् ।\nवृष्णींश्च पुनरागच्छेः हयमेधे ममानघ ॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2208731, "chapter_id": 5458, "verse_number": "५६", "content_sanskrit": "सङ्गच्छ रत्नान्यादाय विविधानि वसूनि च ।\nयच्चाप्यन्यन्मनोज्ञं ते तच्चाप्यादत्स्व सात्वत ॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2208732, "chapter_id": 5458, "verse_number": "५७", "content_sanskrit": "इयं हि वसुधा सर्वा प्रसादात् तव माधव ।\nअस्मानुपागता वीर निहताश्चापि शत्रवः ॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2208733, "chapter_id": 5458, "verse_number": "५८", "content_sanskrit": "स्वर्गापवर्गविषयं त्वद्भक्तानां न दुर्लभम् ।\nसंसारगहने चेद्धपापाग्नेः प्रशमाम्बुद ॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2208734, "chapter_id": 5458, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2208735, "chapter_id": 5458, "verse_number": "५९", "content_sanskrit": "एवं ब्रुवति कौरव्ये धर्मराजे युधिष्ठिरे ।\nवासुदेवः परः पुंसामिदं वचनमब्रवीत् ॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2208736, "chapter_id": 5458, "verse_number": "", "content_sanskrit": "श्रीभगवान्", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2208737, "chapter_id": 5458, "verse_number": "६०", "content_sanskrit": "तवैव रत्नानि धनं च केवलं\nधरा च कृत्स्ना च महाभुजाद्य वै ।\nयदस्ति चान्यद् द्रविणं गृहेषु मे\nत्वमेव तस्येश्वर नित्यमीश्वरः ॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2208738, "chapter_id": 5458, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2208739, "chapter_id": 5458, "verse_number": "६१", "content_sanskrit": "तथेत्यथोक्तः प्रतिपूजितस्तदा\nगदाग्रजो धर्मसुतेन वीर्यवान् ।\nपितृष्वसारं त्वभिवाद्य सात्यकिं\nसम्पूजयंश्चाप्यगमत् प्रदक्षिणम् ॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2208740, "chapter_id": 5458, "verse_number": "६२", "content_sanskrit": "तया स सम्यक् प्रतिपूजितस्तदा\nतथैव सर्वैर्विदुरादिभिस्ततः ।\nविनिर्ययौ नागपुराद् गदाग्रजो\nरथेन दिव्येन चतुर्युजा हरिः ॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}, {"id": 2208741, "chapter_id": 5458, "verse_number": "६३", "content_sanskrit": "रथे सुभद्रामधिरोप्य भामिनीं\nयुधिष्ठिरस्यानुमते जनार्दनः ।\nपितृष्वसुश्चापि जनार्दनस्तदा\nविनिर्ययौ पौरजनाभिसत्कृतः ॥६३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 73}, {"id": 2208742, "chapter_id": 5458, "verse_number": "६४", "content_sanskrit": "तमन्वगाद् वानरवर्यकेतनः\nससात्यकी माद्रवतीसुतावपि ।\nअगाधबुद्धिर्विदुरश्च माधवं\nस्वयं च भीमो गजराजविक्रमः ॥६४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 74}, {"id": 2208743, "chapter_id": 5458, "verse_number": "६५", "content_sanskrit": "निवर्त्य वैतान् कुरुराष्ट्रवर्धनान्\nततश्च सर्वान् विदुरं च वीर्यवान् ।\nजनार्दनो दारुकमाह सत्वरः\nप्रचोदयाश्वानिति सात्यकिं तदा ॥६५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 75}, {"id": 2208744, "chapter_id": 5458, "verse_number": "६६", "content_sanskrit": "ततो ययौ शत्रुगणावमर्दनः\nशिनिप्रवीरानुगतो जनार्दनः ।\nयथा निहत्यारिगणं शतक्रतुः\nदिवं तथाऽऽनर्तपुरीं प्रतापवान् ॥६६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 76}, {"id": 2208745, "chapter_id": 5458, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि कृष्णस्य द्वारावतीगमनं नाम द्विपञ्चाशोऽध्यायः ॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 77}]