[{"id": 7006138000, "chapter_id": 26138, "verse_number": "१-१-४-१", "content_sanskrit": "सुत उवाच ।\nआत्मन्यवस्थिते व्यक्ते विकारे प्रतिसंहते ।\nसाधर्म्येणावतिष्ठेते प्रधानपुरुषौ तदा ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7006138001, "chapter_id": 26138, "verse_number": "१-१-४-२", "content_sanskrit": "तमःसत्त्व गुणावेतौ समत्वेन व्यवस्थितौ ।\nअनुद्रिक्तावनुचरौ तेन प्रोक्तौ परस्परम् ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7006138002, "chapter_id": 26138, "verse_number": "१-१-४-३", "content_sanskrit": "गुणसाम्ये लयो ज्ञेय आधिक्ये सृष्टिरुच्यते ।\nसत्त्ववृद्धौ स्थितिरभूद्ध्रुवं पद्म शिखास्थितम् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7006138003, "chapter_id": 26138, "verse_number": "१-१-४-४", "content_sanskrit": "यदा तमसि सत्त्वे च रजोप्यनुगतं स्थितम् ।\nरजः प्रवर्तकं तच्च बीजेष्विव यथा जलम् ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7006138004, "chapter_id": 26138, "verse_number": "१-१-४-५", "content_sanskrit": "गुणा वैषम्यमासाद्य प्रसंगेन प्रतिष्ठिताः ।\nगुणेभ्यः क्षोभ्यमाणेभ्यस्त्रयो ज्ञेया हि सादरे ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7006138005, "chapter_id": 26138, "verse_number": "१-१-४-६", "content_sanskrit": "शाश्वताः परमा गुह्याः सर्वात्मानः शरीरिणः ।\nसत्त्वं विष्णू रजो ब्रह्मा तमो रुद्रः प्रजापतिः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7006138006, "chapter_id": 26138, "verse_number": "१-१-४-७", "content_sanskrit": "रजःप्रकाशकोविष्णुर्ब्रह्मस्रष्टृत्वमाप्नुयात् ।\nजायते च यतश्चत्रा लोकसृष्टिर्महोजसः ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7006138007, "chapter_id": 26138, "verse_number": "१-१-४-८", "content_sanskrit": "तमःप्रकाशको विष्णुः कालत्वेन व्यवस्थितः ।\nसत्त्वप्रकाशको विष्णुः स्थितित्वेन व्यवस्थितः ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7006138008, "chapter_id": 26138, "verse_number": "१-१-४-९", "content_sanskrit": "एत एव त्रयो लोका एत एव त्रयो गुणाः ।\nएत एव त्रयो वेदा एत एव त्रजोऽग्नयः ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7006138009, "chapter_id": 26138, "verse_number": "१-१-४-१०", "content_sanskrit": "परस्परान्वया ह्येते परस्परमनुव्रताः ।\nपरस्परेण वर्तन्ते प्रेरयन्ति परस्परम् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7006138010, "chapter_id": 26138, "verse_number": "१-१-४-११", "content_sanskrit": "अन्योन्यं मिथुनं ह्येते अन्योन्यमुपजीविनः ।\nक्षणं वियोगो न ह्येषां न त्यजन्ति परस्परम् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7006138011, "chapter_id": 26138, "verse_number": "१-१-४-१२", "content_sanskrit": "प्रधानगुणवैषम्यात्सर्गकाले प्रवर्त्तते ।\nअदृष्टाधिष्ठितात्पूर्वे तस्मात्सदसदात्मकात् ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7006138012, "chapter_id": 26138, "verse_number": "१-१-४-१३", "content_sanskrit": "ब्रह्मा बुद्धित्वमिथुनं युगपत्संबभूव ह ।\nतस्मात्तमोव्यक्तमयं क्षेत्रज्ञो ब्रह्मसंज्ञकः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7006138013, "chapter_id": 26138, "verse_number": "१-१-४-१४", "content_sanskrit": "संसिद्धकार्यकरणो ब्रह्मग्रे समवर्त्तत ।\nतेजसाप्रतिमो धीमानव्यक्तः संप्रकाशकः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7006138014, "chapter_id": 26138, "verse_number": "१-१-४-१५", "content_sanskrit": "स वै शरीरप्रथमो धारणत्वव्यवस्थितः ।\nज्ञानेनाप्रतिमेनेह वैराग्येण च सप्ततिः ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7006138015, "chapter_id": 26138, "verse_number": "१-१-४-१६", "content_sanskrit": "अव्यक्तत्वाय तेनास्य मनसा यद्यदिच्छति ।\nवशीकृतत्वात्त्रैगुण्यात्सापेक्षत्वाच्च भावतः ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7006138016, "chapter_id": 26138, "verse_number": "१-१-४-१७", "content_sanskrit": "चतुर्मुखस्तु ब्रह्मत्वे कालत्वे चान्तकृद्भवः ।\nसहस्रमूर्धा पुरुषस्तिस्रोऽवस्थाःस्वयंभुवः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7006138017, "chapter_id": 26138, "verse_number": "१-१-४-१८", "content_sanskrit": "सर्वं रजश्च ब्रह्मत्वे कालत्वे चरजस्तमः ।\nसात्त्विकः पुरुषत्वे च गुणवृतं स्वयंभुवः ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7006138018, "chapter_id": 26138, "verse_number": "१-१-४-१९", "content_sanskrit": "ब्रह्मत्वे सृजते लोकान् कालत्वे संक्षयत्यपि ।\nपुरुषत्वे उदासीनस्तिस्रोऽवस्थाः स्वयंभुवः ॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7006138019, "chapter_id": 26138, "verse_number": "१-१-४-२०", "content_sanskrit": "ब्रह्मा कमल पत्राक्षः कालो जात्यञ्जनप्रभः ।\nपुरुषः पुण्डरीकाक्षो रूपेण परमात्मनः ॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7006138020, "chapter_id": 26138, "verse_number": "१-१-४-२१", "content_sanskrit": "एकधा स द्विधा चैव त्रिधा च बहुधा पुनः ।\nयोगीश्वरः शरीराणि करोति विकरोतिच ॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7006138021, "chapter_id": 26138, "verse_number": "१-१-४-२२", "content_sanskrit": "नानाकृतिक्रियारूपमाश्रयन्तिस्वलीलया ।\nत्रिधा यद्वर्तते लोके तस्मात्र्रिगुण उच्यते ॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7006138022, "chapter_id": 26138, "verse_number": "१-१-४-२३", "content_sanskrit": "चतुर्द्धा प्रविभक्तत्वाच्चतुर्व्यूहः प्रकीर्त्तितः ।\nयदा शेते तदार्धाते यद्भुङ्क्ते विषयान्प्रभुः ॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7006138023, "chapter_id": 26138, "verse_number": "१-१-४-२४", "content_sanskrit": "यत्स्वस्थाः सततं भावस्तस्मादात्मा निरूच्यते ।\nऋषिः सर्वगतश्चात्र शरीरे सोऽभ्ययात्प्रभुः ॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7006138024, "chapter_id": 26138, "verse_number": "१-१-४-२५", "content_sanskrit": "स्वामी सर्वस्य यत्सर्वंविष्णुः सर्वप्रवेशनात् ।\nभगवानग्रसद्भावान्नागो नागस्वसंश्रयात् ॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7006138025, "chapter_id": 26138, "verse_number": "१-१-४-२६", "content_sanskrit": "परमः संप्रहृष्टत्वाद्देवतादोमिति स्मृतिः ।\nसर्वज्ञः सर्वविज्ञानात्सर्वःसर्वंयतस्ततः ॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7006138026, "chapter_id": 26138, "verse_number": "१-१-४-२७", "content_sanskrit": "नराणां स्वापनं ब्रह्मा तस्मान्नारायणः स्मृतः ।\nत्रिधा विभज्य चात्मानं सकलः संप्रवर्त्तते ॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7006138027, "chapter_id": 26138, "verse_number": "१-१-४-२८", "content_sanskrit": "सृजते ग्रसते चैव पाल्यते च त्रिभिः स्वयम् ।\nसोऽग्रे हिरण्यगर्भः सन् प्रादुर्भूतः स्वयं प्रभुः ॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7006138028, "chapter_id": 26138, "verse_number": "१-१-४-२९", "content_sanskrit": "आद्यो हि स्ववशश्चैव अजातत्वादजः स्मृतः ।\nतस्माद्धिरण्यगर्भश्च पुराणेषु निरुच्यते ॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7006138029, "chapter_id": 26138, "verse_number": "१-१-४-३०", "content_sanskrit": "स्वयंभुवो निवृत्तस्य कालो वर्णाग्रतस्तु यः ।\nन शक्यः परिसंख्यातुं मनुवर्षशतैरपि ॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7006138030, "chapter_id": 26138, "verse_number": "१-१-४-३१", "content_sanskrit": "कल्पसंख्यानिवृत्तस्तु परार्धो ब्रह्मणः स्मृतः ।\nतावत्त्वे सोऽस्य कालोऽन्यस्तस्यान्ते प्रतिबुद्ध्यते ॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7006138031, "chapter_id": 26138, "verse_number": "१-१-४-३२", "content_sanskrit": "कोटिवर्षसहस्राणि गृहभूतानि यानि च ।\nसमतीतानि कल्पानां तावच्छेषात्परेतु ये ॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7006138032, "chapter_id": 26138, "verse_number": "१-१-४-३३", "content_sanskrit": "यत्स्वयं वर्त्तते कल्पो वाराहस्तन्निबोधत ।\nप्रथमं सांप्रतस्तेषां कल्पो वै वर्त्तते च यः ॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7006138033, "chapter_id": 26138, "verse_number": "१-१-४-३४", "content_sanskrit": "पूर्णे युगसहस्रे तु परिपाल्यं नरेश्वरैः ॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}]