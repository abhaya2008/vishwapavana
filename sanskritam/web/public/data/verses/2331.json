[{"id": 2062550, "chapter_id": 2331, "verse_number": "८-५२-०x", "content_sanskrit": "धृतराष्ट्र उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2062551, "chapter_id": 2331, "verse_number": "८-५२-१", "content_sanskrit": "कथं संशप्तकैः सार्धमर्जुनस्याभवद्रणः।\nसूतपुत्रस्य पाञ्चालैः कथं युद्धं प्रवर्तितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2062552, "chapter_id": 2331, "verse_number": "८-५२-२", "content_sanskrit": "अश्वत्थाम्नस्तु यद्युद्धमर्जुनस्य च सञ्जय।\nअन्येषां च मदीयानां पाण्डवैस्तद्ब्रवीहि मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2062553, "chapter_id": 2331, "verse_number": "८-५२-३x", "content_sanskrit": "सञ्जय उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2062554, "chapter_id": 2331, "verse_number": "८-५२-३", "content_sanskrit": "शृणु राजन्यथावृत्तं सङ्ग्रामं ब्रुवतो मम।\nवीराणां शत्रुभिः सार्धं देहपाप्मविनाशनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2062555, "chapter_id": 2331, "verse_number": "८-५२-४", "content_sanskrit": "पार्थः संशप्तकबलं प्रविश्यार्णवसन्निभम्।\nव्यक्षोभयदमित्रघ्नो महावात इवार्णवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2062556, "chapter_id": 2331, "verse_number": "८-५२-५", "content_sanskrit": "पूर्णचन्द्राभवक्राणि स्वक्षिभ्रूदशनानि च।\nशिरांस्युन्मथ्य वीराणां शितैर्भल्लैर्धनञ्जयः।\nसन्तस्तार क्षितिं क्षिप्रं विनालैर्नलिनैरिव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2062557, "chapter_id": 2331, "verse_number": "८-५२-६", "content_sanskrit": "सुवृत्तानायतान्पुष्टांश्चन्दनागुरुभूषितान्।\nसायुधान्सतलत्रांश्च पञ्चास्योरगसन्निभान्।\nबाहून्क्षुरैरमित्राणां चिच्छेद समरेऽर्जुनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2062558, "chapter_id": 2331, "verse_number": "८-५२-७", "content_sanskrit": "धुर्यान्धुर्योतरान्सूतान्ध्वजांश्चापानि सायकान्।\nपाणीन्नितान्तनिशितैर्भल्लैश्चिच्छेद पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2062559, "chapter_id": 2331, "verse_number": "८-५२-८", "content_sanskrit": "रथान्द्विपान्हयांश्चैव सारोहानर्जुनो युधि।\nशरैरनेकसाहस्रैर्निन्ये राजन्यमक्षयम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2062560, "chapter_id": 2331, "verse_number": "८-५२-९", "content_sanskrit": "तं प्रवीराः सुसंरब्धा नर्दमाना इवर्षभाः।\nवासितार्थमिव क्रुद्धमभिद्रुत्य महोत्कटाः।\nनिघ्न्तमभिजघ्नुस्ते शरैः शृङ्गैरिवर्षभाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2062561, "chapter_id": 2331, "verse_number": "८-५२-१०", "content_sanskrit": "तस्य तेषां च तद्युद्वमभवद्रोमहर्षणम्।\nत्रैलोक्यविजये यद्वद्दैत्यानां सह वज्रिणा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2062562, "chapter_id": 2331, "verse_number": "८-५२-११", "content_sanskrit": "अस्त्रैस्त्राणि संवार्य द्विषतां सर्वतोऽर्जुनः।\nइषुभिर्बहुभिस्तूर्णं विद्व्वा प्राणाञ्जहार सः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2062563, "chapter_id": 2331, "verse_number": "८-५२-१२", "content_sanskrit": "छिन्नत्रिवेणुचक्राक्षान्हतयोधान्ससारथीन्।\nविध्वस्तायुधतूणीरान्समुन्मथितकेतनान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2062564, "chapter_id": 2331, "verse_number": "८-५२-१३", "content_sanskrit": "सञ्छिन्नयोक्ररश्मीषान्वित्रिवेणून्विकूबरान्।\nविस्रस्तबन्धुरयुगान्विस्रस्ताक्षप्रमण्डलान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2062565, "chapter_id": 2331, "verse_number": "८-५२-१४", "content_sanskrit": "रथान्विशकलीकुर्वन्महाभ्राणीव मारुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2062566, "chapter_id": 2331, "verse_number": "८-५२-१५", "content_sanskrit": "विस्मापकं प्रेक्षकाणां द्विषतां भयवर्धनम्।\nमहारथसहस्रस्य समं कर्माकरोज्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2062567, "chapter_id": 2331, "verse_number": "८-५२-१६", "content_sanskrit": "सिद्धदेवर्षिसङ्घाश्च चारणाश्चापि तुष्टुवुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2062568, "chapter_id": 2331, "verse_number": "८-५२-१७", "content_sanskrit": "देवदुन्दुभयो नेदुः पुष्पवर्षाणि चापतन्।\nकेशवार्जुनयोर्मूर्ध्नि प्राह वाक्वाशरीरिणी॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2062569, "chapter_id": 2331, "verse_number": "८-५२-१८", "content_sanskrit": "चन्द्राग्न्यनिलसूर्याणां कान्तिदीप्तिबलद्युतीः।\nयौ सदा बिभ्रतुर्वीराविमौ तौ केशवार्जुनौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2062570, "chapter_id": 2331, "verse_number": "८-५२-१९", "content_sanskrit": "ब्रह्मेशानाविव पुरा वीरावेकरथे स्थितौ।\nसर्वभूतवरौ वीरौ नरनारायणाविमौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2062571, "chapter_id": 2331, "verse_number": "८-५२-२०", "content_sanskrit": "इत्येतन्महदाश्चर्यं दृष्ट्वा श्रुत्वा च भारत।\nअश्वत्थामा सुसङ्क्रुद्धः कृष्णावभ्यद्रवद्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2062572, "chapter_id": 2331, "verse_number": "८-५२-२१", "content_sanskrit": "अथ पाण्डवमस्यन्तममित्रान्तकराञ्छरान्।\nसेषुणा पाणिनाऽऽहूय प्रहसन्द्रौणिरब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2062573, "chapter_id": 2331, "verse_number": "८-५२-२२", "content_sanskrit": "यदि मां मन्यसे वीर प्राप्तमर्हमिहातिथिम्।\nततः सर्वात्मना त्वद्य युद्वातिथ्यं प्रयच्छ मे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2062574, "chapter_id": 2331, "verse_number": "८-५२-२३", "content_sanskrit": "एवमाचार्यपुत्रेण समाहूतो युयुत्सया।\nबहुमेनेऽर्जुनोऽऽत्मानमिति चाह जनार्दनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2062575, "chapter_id": 2331, "verse_number": "८-५२-२४", "content_sanskrit": "संशप्तकाश्च मे वध्या द्रौणिराह्वयते च माम्।\nयदत्रानन्तरं प्राप्तं शंस मे तद्वि माधव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2062576, "chapter_id": 2331, "verse_number": "८-५२-२५", "content_sanskrit": "आतिथ्यकर्माभ्युत्थाय दीयतां यदि मन्यसे।\nएवमुक्तोऽवहत्पार्थं कृष्णोद्रोणात्मजान्तिके॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2062577, "chapter_id": 2331, "verse_number": "८-५२-२६", "content_sanskrit": "शैक्ष्येण विधिनाऽऽहूतं वायुरिन्द्रमिवाध्वरे।\nतमामन्त्र्यैकमनसं केशवो द्रौणिमब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2062578, "chapter_id": 2331, "verse_number": "८-५२-२७", "content_sanskrit": "अश्वत्थामन्स्थिरो भूत्वा प्रहराशु सहस्व च।\nनिर्वेष्टुं भर्तृपिण्डं हि कालोऽयमुपजीविनाम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2062579, "chapter_id": 2331, "verse_number": "८-५२-२८", "content_sanskrit": "सूक्ष्मो विवादो विप्राणां सूक्ष्मौ क्षास्त्रौ जयाजयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2062580, "chapter_id": 2331, "verse_number": "८-५२-२९", "content_sanskrit": "नहि संक्षमसे मोहाद्दिव्यां पार्थस्य सत्क्रियाम्।\nसमाप्तिमिच्छन्युध्यस्व स्यिरो भूत्वाऽद्य पाण्डवं॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2062581, "chapter_id": 2331, "verse_number": "८-५२-३०", "content_sanskrit": "इत्युक्तो वासुदेवेन तथेत्युक्त्वा द्विजोत्तमः।\nविव्याध केशवं षष्ट्या नाराचैरर्जुनं त्रिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2062582, "chapter_id": 2331, "verse_number": "८-५२-३१", "content_sanskrit": "तस्यार्जुनः सुसङ्क्रुद्धस्त्रिभिर्बाणैः शरासनम्।\nचिच्छेदाथान्यदादत्त द्रौणिर्घोरतरं धनुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2062583, "chapter_id": 2331, "verse_number": "८-५२-३२", "content_sanskrit": "सज्यं कृत्वा निमेषाच्च विव्याधार्जुनकेशवौ।\nत्रिभिः शतैर्वासुदेवं सहस्रेण च पाण्डवम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2062584, "chapter_id": 2331, "verse_number": "८-५२-३३", "content_sanskrit": "ततः शरसहस्राणि प्रयुतान्यर्बुदानि च।\nससृजे द्रौणिरायस्तः स्तम्भयामास चार्जुनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2062585, "chapter_id": 2331, "verse_number": "८-५२-३४", "content_sanskrit": "इषुधेर्धनुषो ज्यायास्त्वङ्गुलिभ्यश्च मारिष।\nबाह्वोः कराभ्यामुरसो वदनाद्व्राणनेत्रतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2062586, "chapter_id": 2331, "verse_number": "८-५२-३५", "content_sanskrit": "कर्णाभ्यां शिरसोऽङ्गेभ्यो लोमवर्मभ्य एव च।\nरथध्वजाभ्यां च शरा निष्पेतुर्ब्रह्मवादिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2062587, "chapter_id": 2331, "verse_number": "८-५२-३६", "content_sanskrit": "शरजालेन महता बद्ध्वा माधवपाण्डवौ।\nननाद सुदितो द्रौणिर्महामेघौघनिःस्वनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2062588, "chapter_id": 2331, "verse_number": "८-५२-३७", "content_sanskrit": "`तैः पतद्भिर्महाराज द्रौणिमुक्तैः समन्ततः।\nसञ्छादितौ रथस्थौ तावुभौ कृष्णधनञ्जयौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2062589, "chapter_id": 2331, "verse_number": "८-५२-३८", "content_sanskrit": "दतः शरxxxxxxक्ष्णैर्भारद्वाजः प्रतापवान्।\nनिxxxxxचक्रे रथे माधवपाण्डवौ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2062590, "chapter_id": 2331, "verse_number": "८-५२-३९", "content_sanskrit": "xxxxजङ्गमं स्थावरं तथा।\nचराचरसा मोप्तारौ दृष्ट्वा सञ्छादितौ शरैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2062591, "chapter_id": 2331, "verse_number": "८-५२-४०", "content_sanskrit": "सिद्धचारxxxxxश्च संपेतुर्शै समन्ततः।\nअपि xxxxxxxx लोकानामिति चाब्रुवन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2062592, "chapter_id": 2331, "verse_number": "८-५२-४१", "content_sanskrit": "न मया xxxxxxxxxx राजन्दृष्टपृर्वः पराकमः।\nxxxxxxxxxxxx कृष्णो छादयतो रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2062593, "chapter_id": 2331, "verse_number": "८-५२-४२", "content_sanskrit": "xxxxxxxxxxxशब्दं रथानां त्रासनं रणे।\nxxxxxxxxxx राजन्सिंहस्य नदतो यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2062594, "chapter_id": 2331, "verse_number": "८-५२-४३", "content_sanskrit": "चरतो युद्धे सव्यं दक्षिणमस्यतः।\nविद्युदम्भोधरस्येव भ्राजमाना व्यदृश्यत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2062595, "chapter_id": 2331, "verse_number": "८-५२-४४", "content_sanskrit": "स तदा क्षिप्रकारी च दृढहस्तश्च पाण्डवः।\nप्रमोहं परमं गत्वा प्रेक्षन्नास्ते धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2062596, "chapter_id": 2331, "verse_number": "८-५२-४५", "content_sanskrit": "विक्रमं चरतो युद्धे सव्यं दक्षिणमस्यतः।\nविक्रमं च हृतं मेने आत्मनस्तेन संयुगे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2062597, "chapter_id": 2331, "verse_number": "८-५२-४६", "content_sanskrit": "अथास्य समरे राजन्वपुरासीत्सुदुर्दृशम्।\nद्रौणेस्तत्कुर्वतः कर्म यादृग्रूपं पिनाकिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2062598, "chapter_id": 2331, "verse_number": "८-५२-४७", "content_sanskrit": "वर्धमाने ततस्तत्र द्रोणपुत्रे विशाम्पते।\nहीयमाने च कौन्तेये कृष्णं रोषः समाविशत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2062599, "chapter_id": 2331, "verse_number": "८-५२-४८", "content_sanskrit": "स रोषान्निश्वसन्राजन्निर्दहन्निव चक्षुषा।\nद्रौणिं ददर्श सङ्ग्रामे फल्गुनं च मुहुर्मुहुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2062600, "chapter_id": 2331, "verse_number": "८-५२-४९", "content_sanskrit": "ततः कृष्णोऽब्रवीत्क्रुद्धः पार्थं सप्रणयं वचः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2062601, "chapter_id": 2331, "verse_number": "८-५२-५०", "content_sanskrit": "अत्यद्भुततमिदं पार्थ त्वयि पश्यामि संयुगे।\nयत्त्वां विशेषयत्याजौ द्रोणपुत्रोऽद्य भारत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2062602, "chapter_id": 2331, "verse_number": "८-५२-५१", "content_sanskrit": "कच्चित्ते गाण्डिवं हस्ते मुष्टिर्वा न व्यशीर्यत।\nकच्चिद्वीर्यं यथापूर्वं भुजयोर्वा बलं तव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2062603, "chapter_id": 2331, "verse_number": "८-५२-५२", "content_sanskrit": "उदीर्यमाणं हि रणे पश्यामि द्रौणिमाहवे।\nगुरुपुत्र इति ह्येनं मानयन्पाण्डवर्षभ।\nउपेक्षां मा कृथाः पार्थ नायं काल उपेक्षितुम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2062604, "chapter_id": 2331, "verse_number": "८-५२-५३x", "content_sanskrit": "अर्जुन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2062605, "chapter_id": 2331, "verse_number": "८-५२-५३", "content_sanskrit": "पश्य माधव दौरात्म्यं गुरुपुत्रस्य मां प्रति।\nवधं प्राप्तौ मन्यते नौ प्रावेश्य शवरेश्मनि।\nएषोस्मि हन्मि सङ्कल्पं शिक्षया च बलेन च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2062606, "chapter_id": 2331, "verse_number": "८-५२-५४", "content_sanskrit": "`एवमुक्त्वाऽस्य चिच्छेद भल्लैः कर्मारमार्जितैः।\nधनुश्छत्रं पताकां च रथशक्तिं गदां वराम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2062607, "chapter_id": 2331, "verse_number": "८-५२-५५", "content_sanskrit": "अश्वत्थाम्नः शरानस्ताञ्छित्त्वैकैकं त्रिधा त्रिधा।\nव्यधमद्भरतश्रेष्ठो नीहारमिव मारुतः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2062608, "chapter_id": 2331, "verse_number": "८-५२-५६", "content_sanskrit": "ततः संशप्तकान्भूयः साश्वसूतरथद्विपान्।\nध्वजपत्तिगणानुर्ग्रैर्बाणैर्विव्याध पाण्डवः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2062609, "chapter_id": 2331, "verse_number": "८-५२-५७", "content_sanskrit": "ये ये ददृशिरे तत्र यद्यद्रूपास्तदा जनाः।\nते ते तत्र शरैर्व्याप्तं मेनिरेऽऽत्मानमात्मना॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2062610, "chapter_id": 2331, "verse_number": "८-५२-५८", "content_sanskrit": "ते गाण्डीवप्रमुक्तास्तु नानारूपाः पतत्रिणः।\nक्रोशे साग्रे स्थिताञ्जघ्नुर्द्विपांश्च पुरुषान्रणे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2062611, "chapter_id": 2331, "verse_number": "८-५२-५९", "content_sanskrit": "भल्लैश्छिन्नाः कराः पेतुः करिणां मदवर्षिणाम्।\nयथा वने परशुभिर्निकृत्ताः शाल्मलिद्रुमाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2062612, "chapter_id": 2331, "verse_number": "८-५२-६०", "content_sanskrit": "पश्चात्तु शैलवत्पतुस्ते गजाः सह सादिभिः।\nवज्रिवज्रावमथिता यथैवाद्रिचयास्तथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2062613, "chapter_id": 2331, "verse_number": "८-५२-६१", "content_sanskrit": "गन्धर्वनगराकारान्रथांश्चैव सुकल्पितान्।\nविनीतैर्जवनैर्युक्तानास्थितान्युद्वदुर्मदैः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2062614, "chapter_id": 2331, "verse_number": "८-५२-६२", "content_sanskrit": "शरैर्विशकलीकुर्वन्नमित्रानभ्यवीवृषत्।\nस्वलङ्कृतानश्वसादीन्पत्तींश्चाहन्धनञ्जयः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2062615, "chapter_id": 2331, "verse_number": "८-५२-६३", "content_sanskrit": "धनञ्जययुगान्तार्कः संशप्तकमहार्णवम्।\nव्यशोषयत दुःशोषं तीक्ष्णैः शरगभस्तिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2062616, "chapter_id": 2331, "verse_number": "८-५२-६४", "content_sanskrit": "पुनर्द्रौणिमहाशैलं नाराचैर्वज्रसन्निभैः।\nनिर्बिभेद महावेगैस्त्वरन्वज्रीव पर्वतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2062617, "chapter_id": 2331, "verse_number": "८-५२-६५", "content_sanskrit": "तमाचार्यसुतः क्रुद्धः साश्वयन्तारमाशुगैः।\nयुयुत्सुरागमद्योद्धुं पार्थस्तानच्छिनच्छरान्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 2062618, "chapter_id": 2331, "verse_number": "८-५२-६६", "content_sanskrit": "ततः परमसङ्क्रुद्धः काण्डकोशमवासृजत्।\nअश्वत्थामाभिरूपाय गृहानतिथये यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 2062619, "chapter_id": 2331, "verse_number": "८-५२-६७", "content_sanskrit": "अथ संशप्तकांस्त्यक्त्वा पाण्डवो द्रौणिमभ्ययात्।\nअपाङ्क्तेयानिव त्यक्त्वा दाता पाङ्क्तेयमर्थिनम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}, {"id": 2062620, "chapter_id": 2331, "verse_number": "८-५२-६८", "content_sanskrit": "`स्थिताः संशप्तका राजन्दृष्ट्वा युद्वं महात्मनोः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 71}, {"id": 2062621, "chapter_id": 2331, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते कर्णपर्वणि सप्तदशदिवसयुद्धे द्विपञ्चाशोऽध्यायः॥ ५२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 72}]