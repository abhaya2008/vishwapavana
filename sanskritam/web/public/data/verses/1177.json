[{"id": 2009100, "chapter_id": 1177, "verse_number": "१-१७८-०x", "content_sanskrit": "वैशम्पायन उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2009101, "chapter_id": 1177, "verse_number": "१-१७८-१", "content_sanskrit": "ततः स भग्नपार्श्वाङ्गो नदित्वा भैरवं रवम्।\nशैलराजप्रतीकाशो गतासुरभवद्बकः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2009102, "chapter_id": 1177, "verse_number": "१-१७८-२", "content_sanskrit": "तेन शब्देन वित्रस्तो जनस्तस्याथ रक्षसः।\nनिष्पपात गृहाद्राजन्सहैव परिचारिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2009103, "chapter_id": 1177, "verse_number": "१-१७८-३", "content_sanskrit": "बकानुजस्तदा राजन्भीमं शरणमेयिवान्।\nततस्तु निहतं दृष्ट्वा राक्षसेन्द्रं महाबलम्।\nराक्षसाः परमत्रस्ता भीमं शऱणमाययुः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2009104, "chapter_id": 1177, "verse_number": "१-१७८-४", "content_sanskrit": "तान्भीतान्विगतज्ञानान्भीमः प्रहरतां वरः।\nसांत्वयामास बलवान्समये च न्यवेशयत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2009105, "chapter_id": 1177, "verse_number": "१-१७८-५", "content_sanskrit": "न हिंस्या मानुषा भूयो युष्माभिरिति कर्हिचित्।\nहिंसतां हि वधः शीघ्रमेवमेव भवेदिति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2009106, "chapter_id": 1177, "verse_number": "१-१७८-६", "content_sanskrit": "तस्य तद्वचनं श्रुत्वा तानि रक्षांसि भारत।\nएवमस्त्विति तं प्राहुर्जगृहुः समयं च तम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2009107, "chapter_id": 1177, "verse_number": "१-१७८-७", "content_sanskrit": "सगणस्तु बकभ्राता प्राणमत्पाण्डवं तदा।\nततः प्रभृति रक्षांसि तत्र सौम्यानि भारत।\nनगरे प्रत्यदृश्यन्त नरैर्नगरवासिभिः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2009108, "chapter_id": 1177, "verse_number": "१-१७८-८", "content_sanskrit": "ततो भीमस्तमादाय गतासुं पुरुषादकम्।\nनिष्कर्णनेत्रं निर्जिह्वं निःसंज्ञं कण्ठपीडनात्।\nकुर्वन्बहुविधां चेष्टां पुरद्वारमकर्षत॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2009109, "chapter_id": 1177, "verse_number": "१-१७८-९", "content_sanskrit": "द्वारदेशे विनिक्षिप्य पुरमागात्स मारुतिः।\nस एव राक्षसो नूनं पुनरायाति नः पुरीम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2009110, "chapter_id": 1177, "verse_number": "१-१७८-१०", "content_sanskrit": "सबालवृद्धाः पुरुषा इति भीताः प्रदुद्रुवुः।\nततो भीमो बकं हत्वा गत्वा ब्राह्मणवेश्म तत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2009111, "chapter_id": 1177, "verse_number": "१-१७८-११", "content_sanskrit": "बलीवर्दौ च शकटं ब्राह्मणाय न्यवेदयत्।\nतूष्णीमन्तर्गृहं गच्छेत्यभिधाय द्विजोत्तमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2009112, "chapter_id": 1177, "verse_number": "१-१७८-१२", "content_sanskrit": "मातृभ्रातृसमक्षं च गत्वा शयनमेव च।\nआचचक्षेऽथ तत्सर्वं रात्रौ युद्धमभूद्यथा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2009113, "chapter_id": 1177, "verse_number": "१-१७८-१३", "content_sanskrit": "ततो नरा विनिष्क्रान्ता नगरात्कल्यमेव तु।\nददृशुर्निहतं भूमौ राक्षसं रुधिरोक्षितम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2009114, "chapter_id": 1177, "verse_number": "१-१७८-१४", "content_sanskrit": "तमद्रिकूटसदृशं विनिकीर्णं भयानकम्।\nदृष्ट्वा संहृष्टरोमाणो बभूवुस्तत्र नागराः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2009115, "chapter_id": 1177, "verse_number": "१-१७८-१५", "content_sanskrit": "एकचक्रां ततो गत्वा प्रवृत्तिं प्रददुः पुरे।\nततः सहस्रशो राजन्नरा नगरवासिनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2009116, "chapter_id": 1177, "verse_number": "१-१७८-१६", "content_sanskrit": "तत्राजग्मुर्बकं द्रष्टुं सस्त्रीवृद्धकुमारकाः।\nततस्ते विस्मिताः सर्वे कर्म दृष्ट्वाऽतिमानुषम्।\nदैवतान्यर्चयाञ्चक्रुः प्रार्थितानि पुरा भयात्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2009117, "chapter_id": 1177, "verse_number": "१-१७८-१७", "content_sanskrit": "ततः प्रगणयामासुः कस्य वारोऽद्य भोजने।\nज्ञात्वा चागम्य तं विप्रं पप्रच्छुः सर्व एव ते॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2009118, "chapter_id": 1177, "verse_number": "१-१७८-१८", "content_sanskrit": "एवं पृष्टः स बहुशो रक्षमाणश्च पाण्डवान्।\nउवाच नागरान्सर्वानिदं विप्रर्षभस्तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2009119, "chapter_id": 1177, "verse_number": "१-१७९-१९x", "content_sanskrit": "ब्राह्मण उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2009120, "chapter_id": 1177, "verse_number": "१-१७८-१९", "content_sanskrit": "आज्ञापितं मामशने रुदन्तं सह बन्धुभिः।\nददर्श ब्राह्मणः कश्चिन्मन्त्रसिद्धो महामनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2009121, "chapter_id": 1177, "verse_number": "१-१७८-२०", "content_sanskrit": "परिपृच्छ्य स मां पूर्वं परिक्लेशं पुरस्य च।\nअब्रवीद्ब्राह्मणश्रेष्ठो विश्वास्य प्रहसन्निव॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2009122, "chapter_id": 1177, "verse_number": "१-१७८-२१", "content_sanskrit": "प्रापयिष्याम्यहं तस्मा अन्नमेतद्दुरात्मने।\nमन्निमित्तं भयं चापि न कार्यमिति चाब्रवीत्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2009123, "chapter_id": 1177, "verse_number": "१-१७८-२२", "content_sanskrit": "स तदन्नमुपादाय गतो बकवनं प्रति।\nतेन नूनं भवेदेतत्कर्म लोकहितं कृतम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2009124, "chapter_id": 1177, "verse_number": "१-१७८-२३", "content_sanskrit": "ततस्ते ब्राह्मणाः सर्वे क्षत्रियाश्च सुविस्मिताः।\nवैश्याः शूद्राश्च मुदिताश्चक्रुर्ब्रह्ममहं तदा॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2009125, "chapter_id": 1177, "verse_number": "१-१७८-२४", "content_sanskrit": "ततो जानपदाः सर्वे आजग्मुर्नगरं प्रति।\nतमद्भुततमं द्रष्टुं पार्थास्तत्रैव चावसन्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2009126, "chapter_id": 1177, "verse_number": "१-१७८-२५", "content_sanskrit": "वेत्रकीयगृहे सर्वे परिवार्य वृकोदरम्।\nविस्मयादभ्यगच्छन्त भीमं भीमपराक्रमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2009127, "chapter_id": 1177, "verse_number": "१-१७८-२६", "content_sanskrit": "न वै न संभवेत्सर्वं ब्राह्मणेषु महात्मसु।\nइति सत्कृत्य तं पौराः परिवव्रुः समन्ततः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2009128, "chapter_id": 1177, "verse_number": "१-१७८-२७", "content_sanskrit": "अयं त्राता हि खेदानां पितेव परमार्थतः।\nअस्य शुश्रूषवः पादौ परिचर्य उपास्महे॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2009129, "chapter_id": 1177, "verse_number": "१-१७८-२८", "content_sanskrit": "पशुमद्दधिमनच्चास्य वारं भक्तमुपाहरन्।\nतस्मिन्हते ते पुरुषा भीताः समनुबोधनाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2009130, "chapter_id": 1177, "verse_number": "१-१७८-२९", "content_sanskrit": "ततः संप्राद्रवन्पार्थाः सह मात्रा परन्तपाः।\nआगच्छन्नेकचक्रां ते गाण्डवाः संशितव्रताः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2009131, "chapter_id": 1177, "verse_number": "१-१७८-३०", "content_sanskrit": "वैदिकाध्ययने युक्ता जटिला ब्रह्मचारिणः।\nअवसंस्ते च तत्रापि ब्राह्मणस्य निवेशने।\nमात्रर सहैकचक्रायां दीर्घकालं सहोषिताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2009132, "chapter_id": 1177, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते आदिपर्वणि बकवधपर्वणि अष्टसप्तत्यधिकशततमोऽध्यायः॥ १७८ ॥ ॥ समाप्तं च बकवधपर्व ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}]