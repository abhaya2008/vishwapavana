[{"id": 7004456000, "chapter_id": 24456, "verse_number": "५-३-१५०-१", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nततो गच्छेन्महाराज कुसुमेश्वरमुत्तमम् ।\nदक्षिणे नर्मदाकूले उपपातकनाशनम्॥ १ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 7004456001, "chapter_id": 24456, "verse_number": "५-३-१५०-२", "content_sanskrit": "कामेन स्थापितो देवः कुसुमेश्वरसंज्ञितः ।\nख्यातः सर्वेषु लोकेषु देवदेवः सनातनः॥ २ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 7004456002, "chapter_id": 24456, "verse_number": "५-३-१५०-३", "content_sanskrit": "कामो मनोभवो विश्वः कुसुमायुधचापभृत् ।\nस कामान् ददाति सर्वान् पूजितो मीनकेतनः॥ ३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 7004456003, "chapter_id": 24456, "verse_number": "५-३-१५०-४", "content_sanskrit": "तेन निर्दग्धकायेन चाराध्य परमेश्वरम् ।\nअनङ्गेन तथा प्राप्तमङ्गित्वं नर्मदातटे॥ ४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 7004456004, "chapter_id": 24456, "verse_number": "५-३-१५०-५", "content_sanskrit": "युधिष्ठिर उवाच ।\nअङ्गिभृतस्य नाशत्वमनङ्गस्य तु मे वद ।\nन श्रुतं न च मे दृष्टं भूतपूर्वं कदाचन॥ ५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 7004456005, "chapter_id": 24456, "verse_number": "५-३-१५०-६", "content_sanskrit": "एतत्सर्वं यथा वृत्तमाचक्ष्व द्विजसत्तम ।\nश्रोतुमिच्छामि विप्रेन्द्र भीमार्जुनयमैः सह॥ ६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 7004456006, "chapter_id": 24456, "verse_number": "५-३-१५०-७", "content_sanskrit": "श्रीमार्कण्डेय उवाच ।\nआदौ कृतयुगे तात देवदेवो महेश्वरः ।\nतपश्चचार विपुलं गङ्गासागरसंस्थितः॥ ७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 7004456007, "chapter_id": 24456, "verse_number": "५-३-१५०-८", "content_sanskrit": "तेन सम्पादिता लोकास्तपसा ससुरासुराः ।\nजग्मुस्ते शरणं सर्वे देवदेवं शचीपतिम्॥ ८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 7004456008, "chapter_id": 24456, "verse_number": "५-३-१५०-९", "content_sanskrit": "व्यापकः सर्वभूतानां देवदेवो महेश्वरः ।\nसंतापयति लोकांस्त्रींस्तन्निवारय गोपते॥ ९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 7004456009, "chapter_id": 24456, "verse_number": "५-३-१५०-१०", "content_sanskrit": "श्रुत्वा तद्वचनं तेषां देवानां बलवृत्रहा ।\nचिन्तयामास मनसा तपोविघ्नायचादिशत्॥ १० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 7004456010, "chapter_id": 24456, "verse_number": "५-३-१५०-११", "content_sanskrit": "अप्सरां मेनकां रम्भां घृताचीं च तिलोत्तमाम् ।\nवसन्तं कोकिलं कामं दक्षिणानिलमुत्तमम्॥ ११ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 7004456011, "chapter_id": 24456, "verse_number": "५-३-१५०-१२", "content_sanskrit": "गत्वा तत्र महादेवं तपश्चरणतत्परम् ।\nक्षोभयध्वं यथान्यायं गङ्गासागरवासिनम्॥ १२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 7004456012, "chapter_id": 24456, "verse_number": "५-३-१५०-१३", "content_sanskrit": "एवमुक्तास्तु ते सर्वे देवराजेन भारत ।\nदेवाप्सरःसमोपेता जग्मुस्ते हरसन्निधौ॥ १३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 7004456013, "chapter_id": 24456, "verse_number": "५-३-१५०-१४", "content_sanskrit": "वसन्तमासे कुसुमाकराकुले मयूरदात्यूहसुकोकिलाकुले ।\nप्रनृत्य देवाप्सरगीतसंकुले प्रवाति वाते यमनैरृताकुले॥ १४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 7004456014, "chapter_id": 24456, "verse_number": "५-३-१५०-१५", "content_sanskrit": "तेन संमूर्छिताः सर्वे संसर्गाच्च खगोत्तमाः ।\nमधुमाधवगन्धेन सकिन्नरमहोरगाः॥ १५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 7004456015, "chapter_id": 24456, "verse_number": "५-३-१५०-१६", "content_sanskrit": "यावदालोकते तावत्तद्वनं व्याकुलीकृतम् ।\nवीक्षते मदनाविष्टं दशावस्थागतं जनम्॥ १६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 7004456016, "chapter_id": 24456, "verse_number": "५-३-१५०-१७", "content_sanskrit": "देवदेवोऽपि देवानामवस्थात्रितयं गतः ।\nसात्त्विकीं राजसीं राजंस्तामसीं तां शृणुष्व मे॥ १७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 7004456017, "chapter_id": 24456, "verse_number": "५-३-१५०-१८", "content_sanskrit": "एकं योगसमाधिना मुकुलितं चक्षुर्द्वितीयं पुनः पार्वत्या जघनस्थलस्तनतटे शृङ्गारभारालसम् ।\nअन्यद्दूरनिरस्तचापमदनक्रोधानलोद्दीपितं शम्भोर्भिन्नरसं समाधिसमये नेत्रत्रयं पातु वः॥ १८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 7004456018, "chapter_id": 24456, "verse_number": "५-३-१५०-१९", "content_sanskrit": "एवं दृष्टः स देवेन सशरः सशरासनः ।\nभस्मीभूतो गतः कामो विनाशः सर्वदेहिनाम्॥ १९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 7004456019, "chapter_id": 24456, "verse_number": "५-३-१५०-२०", "content_sanskrit": "कामं दृष्ट्वा क्षयं यातं तत्र देवाप्सरोगणाः ।\nभीता यथागतं सर्वे जग्मुश्चैव दिशो दश॥ २० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 7004456020, "chapter_id": 24456, "verse_number": "५-३-१५०-२१", "content_sanskrit": "कामेन रहिता लोकाः ससुरासुरमानवाः ।\nब्रह्माणं शरणं जग्मुर्देवा इन्द्रपुरोगमाः॥ २१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 7004456021, "chapter_id": 24456, "verse_number": "५-३-१५०-२२", "content_sanskrit": "सीदमानं जगद्दृष्ट्वा तमूचुः परमेष्ठिनम् ।\nजानासि त्वं जगच्छेषं प्रभो मैथुनसम्भवात्॥ २२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 7004456022, "chapter_id": 24456, "verse_number": "५-३-१५०-२३", "content_sanskrit": "प्रजाः सर्वा विशुष्यन्ति कामेन रहिता विभो॥ २३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 7004456023, "chapter_id": 24456, "verse_number": "५-३-१५०-२४", "content_sanskrit": "एतच्छ्रुत्वा वचस्तेषां देवानां प्रपितामहः ।\nजगाम सहितस्तत्र यत्र देवो महेश्वरः॥ २४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 7004456024, "chapter_id": 24456, "verse_number": "५-३-१५०-२५", "content_sanskrit": "अतोषयज्जगन्नाथं सर्वभूतमहेश्वरम् ।\nस्तुतिभिस्तण्डकैः स्तोत्रैर्वेदवेदाङ्गसम्भवैः॥ २५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 7004456025, "chapter_id": 24456, "verse_number": "५-३-१५०-२६", "content_sanskrit": "ततस्तुष्टो महादेवो देवानां परमेश्वरः ।\nउवाच मधुरां वाणीं देवान्ब्रह्मपुरोगमान्॥ २६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 7004456026, "chapter_id": 24456, "verse_number": "५-३-१५०-२७", "content_sanskrit": "किं कार्यं कश्च सन्तापः किं वागमनकारणम् ।\nदेवतानामृषीणां च कथ्यतां मम माचिरम्॥ २७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 7004456027, "chapter_id": 24456, "verse_number": "५-३-१५०-२८", "content_sanskrit": "देवा ऊचुः ।\nकामनाशाज्जगन्नाशो भवितायं चराचरे ।\nत्रैलोक्यं त्वं पुनः शम्भो उत्पादयितुमर्हसि॥ २८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 7004456028, "chapter_id": 24456, "verse_number": "५-३-१५०-२९", "content_sanskrit": "एतच्छ्रुत्वा वचस्तेषां विमृश्य परमेश्वरः ।\nचिन्तयामास कामस्य विग्रहं भुवि दुर्लभम्॥ २९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 7004456029, "chapter_id": 24456, "verse_number": "५-३-१५०-३०", "content_sanskrit": "आजगाम ततः शीघ्रमनङ्गो ह्यङ्गतां गतः ।\nप्राणदः सर्वभूतानां पश्यतां नृपसत्तम॥ ३० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 7004456030, "chapter_id": 24456, "verse_number": "५-३-१५०-३१", "content_sanskrit": "ततः शङ्खनिनादेन भेरीणां निःस्वनेन च ।\nअभ्यनन्दंस्ततो देवं सुरासुरमहोरगाः॥ ३१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 7004456031, "chapter_id": 24456, "verse_number": "५-३-१५०-३२", "content_sanskrit": "नमस्ते देवदेवेश कृतार्थाः सुरसत्तमाः ।\nविसर्जिताः पुनर्जग्मुर्यथागतमरिन्दम॥ ३२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 7004456032, "chapter_id": 24456, "verse_number": "५-३-१५०-३३", "content_sanskrit": "गतेषु सर्वदेवेषु कामदेवोऽपि भारत ।\nतपश्चचार विपुलं नर्मदातटमाश्रितः॥ ३३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 7004456033, "chapter_id": 24456, "verse_number": "५-३-१५०-३४", "content_sanskrit": "तपोजपकृशीभूतो दिव्यं वर्षशतं किल ।\nमहाभूतैर्विघ्नकरैः पीड्यमानः समन्ततः॥ ३४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 7004456034, "chapter_id": 24456, "verse_number": "५-३-१५०-३५", "content_sanskrit": "आत्मविघ्नविनाशार्थं संस्मृतः कुण्डलेश्वरः ।\nचकार रक्षां सर्वत्र शरपाते नृपोत्तम॥ ३५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 7004456035, "chapter_id": 24456, "verse_number": "५-३-१५०-३६", "content_sanskrit": "ततस्तुष्टो महादेवो दृढभक्त्या वरप्रदः ।\nवरेण छन्दयामास कामं कामविनाशनः॥ ३६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 7004456036, "chapter_id": 24456, "verse_number": "५-३-१५०-३७", "content_sanskrit": "ज्ञात्वा तुष्टं महादेवमुवाच झषकेतनः ।\nप्रणतः प्राञ्जलिर्भूत्वा देवदेवं त्रिलोचनम्॥ ३७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 7004456037, "chapter_id": 24456, "verse_number": "५-३-१५०-३८", "content_sanskrit": "यदि तुष्टोऽसि देवेश यदि देयो वरो मम ।\nअत्र तीर्थे जगन्नाथ सदा संनिहितो भव॥ ३८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 7004456038, "chapter_id": 24456, "verse_number": "५-३-१५०-३९", "content_sanskrit": "तथेति चोक्त्वा वचनं देवदेवो महेश्वरः ।\nजगामाकाशमाविश्य स्तूयमानोऽप्सरोगणैः॥ ३९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 7004456039, "chapter_id": 24456, "verse_number": "५-३-१५०-४०", "content_sanskrit": "गते चादर्शनं देवे कामदेवो जगद्गुरुम् ।\nस्थापयामास राजेन्द्र कुसुमेश्वरसंज्ञितम्॥ ४० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 7004456040, "chapter_id": 24456, "verse_number": "५-३-१५०-४१", "content_sanskrit": "तत्र तीर्थे तु यः स्नात्वा ह्युपवासपरायणः ।\nचैत्रमासे चतुर्दश्यां मदनस्य दिनेऽथवा॥ ४१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 7004456041, "chapter_id": 24456, "verse_number": "५-३-१५०-४२", "content_sanskrit": "प्रभाते विमले प्राप्ते स्नात्वा पूज्य दिवाकरम् ।\nतिलमिश्रेण तोयेन तर्पयेत्पितृदेवताः॥ ४२ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 7004456042, "chapter_id": 24456, "verse_number": "५-३-१५०-४३", "content_sanskrit": "कृत्वा स्नानं विधानेन पूजयित्वा च तं नृप ।\nपिण्डनिर्वपणं कुर्यात्तस्य पुण्यफलं शृणु॥ ४३ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 7004456043, "chapter_id": 24456, "verse_number": "५-३-१५०-४४", "content_sanskrit": "सत्त्रयाजिफलं यच्च लभते द्वादशाब्दिकम् ।\nपिण्डदानात्फलं तच्च लभते नात्र संशयः॥ ४४ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 7004456044, "chapter_id": 24456, "verse_number": "५-३-१५०-४५", "content_sanskrit": "अङ्कुल्लमूले यः पिण्डं पित्ःनुद्दिश्य दापयेत् ।\nतस्य ते द्वादशाब्दानि तृप्तिं यान्ति पितामहाः॥ ४५ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 7004456045, "chapter_id": 24456, "verse_number": "५-३-१५०-४६", "content_sanskrit": "कृमिकीटपतङ्गा ये तत्र तीर्थे युधिष्ठिर ।\nप्राप्नुवन्ति मृताः स्वर्गं किं पुनर्ये नरा मृताः॥ ४६ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 7004456046, "chapter_id": 24456, "verse_number": "५-३-१५०-४७", "content_sanskrit": "संन्यासं कुरुते योऽत्र जितक्रोधो जितेन्द्रियः ।\nकुसुमेशे नरो भक्त्या स गच्छेच्छिवमन्दिरम्॥ ४७ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 7004456047, "chapter_id": 24456, "verse_number": "५-३-१५०-४८", "content_sanskrit": "तत्र दिव्याप्सरोभिश्च देवगन्धर्वगायनैः ।\nक्रीडते सेव्यमानस्तु कल्पकोटिशतं नृप॥ ४८ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 7004456048, "chapter_id": 24456, "verse_number": "५-३-१५०-४९", "content_sanskrit": "पूर्णे चैव ततः काल इह मानुष्यतां गतः ।\nजायते राजराजेन्द्रैः पूज्यमानो नृपो महान्॥ ४९ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 7004456049, "chapter_id": 24456, "verse_number": "५-३-१५०-५०", "content_sanskrit": "सुरूपः सुभगो वाग्मी विक्रान्तो मतिमाञ्छुचिः ।\nजीवेद्वर्षशतं साग्रं सर्वव्याधिविवर्जितः॥ ५० ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 7004456050, "chapter_id": 24456, "verse_number": "५-३-१५०-५१", "content_sanskrit": "एतत्पुण्यं पापहरं तीर्थकोटिशताधिकम् ।\nकुसुमेशेति विख्यातं सर्वदेवनमस्कृतम्॥ ५१ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}]