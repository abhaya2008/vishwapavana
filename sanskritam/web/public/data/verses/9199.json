[{"id": 5000199000, "chapter_id": 9199, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे अरण्यकाण्डे तृतीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000199001, "chapter_id": 9199, "verse_number": "३-३-१", "content_sanskrit": "अथोवाच पुनर्वाक्यं विराधः पूरयन् वनम्।\nपृच्छतो मम हि ब्रूतं कौ युवां क्व गमिष्यथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000199002, "chapter_id": 9199, "verse_number": "३-३-२", "content_sanskrit": "तमुवाच ततो रामो राक्षसं ज्वलिताननम्।\nपृच्छन्तं सुमहातेजा इक्ष्वाकुकुलमात्मनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000199003, "chapter_id": 9199, "verse_number": "३-३-३", "content_sanskrit": "क्षत्रियौ वृत्तसम्पन्नौ विद्धि नौ वनगोचरौ।\nत्वां तु वेदितुमिच्छावः कस्त्वं चरसि दण्डकान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000199004, "chapter_id": 9199, "verse_number": "३-३-४", "content_sanskrit": "तमुवाच विराधस्तु रामं सत्यपराक्रमम्।\nहन्त वक्ष्यामि ते राजन् निबोध मम राघव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000199005, "chapter_id": 9199, "verse_number": "३-३-५", "content_sanskrit": "पुत्रः किल जवस्याहं माता मम शतह्रदा।\nविराध इति मामाहुः पृथिव्यां सर्वराक्षसाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000199006, "chapter_id": 9199, "verse_number": "३-३-६", "content_sanskrit": "तपसा चाभिसम्प्राप्ता ब्रह्मणो हि प्रसादजा।\nशस्त्रेणावध्यता लोकेऽच्छेद्याभेद्यत्वमेव च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000199007, "chapter_id": 9199, "verse_number": "३-३-७", "content_sanskrit": "उत्सृज्य प्रमदामेनामनपेक्षौ यथागतम्।\nत्वरमाणौ पलायेथां न वां जीवितमाददे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000199008, "chapter_id": 9199, "verse_number": "३-३-८", "content_sanskrit": "तं रामः प्रत्युवाचेदं कोपसंरक्तलोचनः।\nराक्षसं विकृताकारं विराधं पापचेतसम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000199009, "chapter_id": 9199, "verse_number": "३-३-९", "content_sanskrit": "क्षुद्र धिक् त्वां तु हीनार्थं मृत्युमन्वेषसे ध्रुवम्।\nरणे प्राप्स्यसि संतिष्ठ न मे जीवन् विमोक्ष्यसे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000199010, "chapter_id": 9199, "verse_number": "३-३-१०", "content_sanskrit": "ततः सज्यं धनुः कृत्वा रामः सुनिशितान् शरान्।\nसुशीघ्रमभिसंधाय राक्षसं निजघान ह ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000199011, "chapter_id": 9199, "verse_number": "३-३-११", "content_sanskrit": "धनुषा ज्यागुणवता सप्त बाणान् मुमोच ह।\nरुक्मपुङ्खान् महावेगान् सुपर्णानिलतुल्यगान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000199012, "chapter_id": 9199, "verse_number": "३-३-१२", "content_sanskrit": "ते शरीरं विराधस्य भित्त्वा बर्हिणवाससः।\nनिपेतुः शोणितादिग्धा धरण्यां पावकोपमाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000199013, "chapter_id": 9199, "verse_number": "३-३-१३", "content_sanskrit": "स विद्धो न्यस्य वैदेहीं शूलमुद्यम्य राक्षसः।\nअभ्यद्रवत् सुसंक्रुद्धस्तदा रामं सलक्ष्मणम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000199014, "chapter_id": 9199, "verse_number": "३-३-१४", "content_sanskrit": "स विनद्य महानादं शूलं शक्रध्वजोपमम्।\nप्रगृह्याशोभत तदा व्यात्तानन इवान्तकः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000199015, "chapter_id": 9199, "verse_number": "३-३-१५", "content_sanskrit": "अथ तौ भ्रातरौ दीप्तं शरवर्षं ववर्षतुः।\nविराधे राक्षसे तस्मिन् कालान्तकयमोपमे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000199016, "chapter_id": 9199, "verse_number": "३-३-१६", "content_sanskrit": "स प्रहस्य महारौद्रः स्थित्वाजृम्भत राक्षसः।\nजृम्भमाणस्य ते बाणाः कायान्निष्पेतुराशुगाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000199017, "chapter_id": 9199, "verse_number": "३-३-१७", "content_sanskrit": "स्पर्शात् तु वरदानेन प्राणान् संरोध्य राक्षसः।\nविराधः शूलमुद्यम्य राघवावभ्यधावत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000199018, "chapter_id": 9199, "verse_number": "३-३-१८", "content_sanskrit": "तच्छूलं वज्रसंकाशं गगने ज्वलनोपमम्।\nद्वाभ्यां शराभ्यां चिच्छेद रामः शस्त्रभृतां वरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000199019, "chapter_id": 9199, "verse_number": "३-३-१९", "content_sanskrit": "तद् रामविशिखैश्छिन्नं शूलं तस्यापतद् भुवि।\nपपाताशनिना छिन्नं मेरोरिव शिलातलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000199020, "chapter_id": 9199, "verse_number": "३-३-२०", "content_sanskrit": "तौ खड्गौ क्षिप्रमुद्यम्य कृष्णसर्पाविवोद्यतौ।\nतूर्णमापेततुस्तस्य तदा प्रहरतां बलात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000199021, "chapter_id": 9199, "verse_number": "३-३-२१", "content_sanskrit": "स वध्यमानः सुभृशं भुजाभ्यां परिगृह्य तौ।\nअप्रकम्प्यौ नरव्याघ्रौ रौद्रः प्रस्थातुमैच्छत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000199022, "chapter_id": 9199, "verse_number": "३-३-२२", "content_sanskrit": "तस्याभिप्रायमाज्ञाय रामो लक्ष्मणमब्रवीत्।\nवहत्वयमलं तावत् पथानेन तु राक्षसः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000199023, "chapter_id": 9199, "verse_number": "३-३-२३", "content_sanskrit": "यथा चेच्छति सौमित्रे तथा वहतु राक्षसः।\nअयमेव हि नः पन्था येन याति निशाचरः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000199024, "chapter_id": 9199, "verse_number": "३-३-२४", "content_sanskrit": "स तु स्वबलवीर्येण समुत्क्षिप्य निशाचरः।\nबालाविव स्कन्धगतौ चकारातिबलोद्धतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000199025, "chapter_id": 9199, "verse_number": "३-३-२५", "content_sanskrit": "तावारोप्य ततः स्कन्धं राघवौ रजनीचरः।\nविराधो विनदन् घोरं जगामाभिमुखो वनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000199026, "chapter_id": 9199, "verse_number": "३-३-२६", "content_sanskrit": "वनं महामेघनिभं प्रविष्टो\nद्रुमैर्महद्भिर्विविधैरुपेतम्।\nनानाविधैः पक्षिकुलैर्विचित्रं\nशिवायुतं व्यालमृगैर्विकीर्णम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000199027, "chapter_id": 9199, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये अरण्यकाण्डे तृतीयः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}]