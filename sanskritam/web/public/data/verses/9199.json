[{"id": 40014479, "chapter_id": 9199, "verse_number": "1", "content_sanskrit": "सबभूवकृशोराजामैथिलीकाममोहितः । असन्मानाच्चसुहृदांपापंपापेनकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 40014480, "chapter_id": 9199, "verse_number": "2", "content_sanskrit": "अतीतसमयेकालेतस्मिन्वैयुधिरावणः । अमात्यैश्चसुहृद्भिश्चप्राप्तकालममन्यत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 40014481, "chapter_id": 9199, "verse_number": "3", "content_sanskrit": "सहेमजालविततंमणिविद्रुमभूषितम् । उपगम्यविनीताश्वमारुरोहमहारथम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 40014482, "chapter_id": 9199, "verse_number": "4", "content_sanskrit": "तमास्थायरथश्रेष्ठंमहामेघसमस्वनम् । प्रययौरक्षसांश्रेष्ठोदशग्रीवस्सभांप्रति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 40014483, "chapter_id": 9199, "verse_number": "5", "content_sanskrit": "असिचर्मधरायोधास्सर्वायुधधरास्ततः । राक्षसाराक्षसेन्द्रस्यपुरस्तात्सम्प्रतस्थिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 40014484, "chapter_id": 9199, "verse_number": "6", "content_sanskrit": "नानाविकृतवेषाश्चनानाभूषणभूषिताः । पार्श्वतस्पृष्ठतश्चैनंपरिवार्यययुस्तत: ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 40014485, "chapter_id": 9199, "verse_number": "7", "content_sanskrit": "रथैश्चातिरथाश्शीघ्रंमत्तैश्चवरवारणैः । अनूत्पेतुर्दशग्रीवमाक्रीडद्भिश्चवाजिभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 40014486, "chapter_id": 9199, "verse_number": "8", "content_sanskrit": "गदापरिघहस्ताश्चशक्तितोमरपाणयः । परश्वथधराश्चान्येतथाऽन्येशूलपाणयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 40014487, "chapter_id": 9199, "verse_number": "9", "content_sanskrit": "ततस्तूर्यसहस्राणांसञ्जज्ञेनिस्स्वनोमहान् । तुमुलश्शङ्खशब्दश्चसभांगच्छतिरावणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 40014488, "chapter_id": 9199, "verse_number": "10", "content_sanskrit": "सनेमिघोषेणमहान्सहसाऽभिनिनादयन् । राजमार्गंश्रियाजुष्टंप्रतिपेदेमहारथः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 40014489, "chapter_id": 9199, "verse_number": "11", "content_sanskrit": "विमलंचातपत्राणांप्रगृहीतमशोभत । पाण्डुरंराक्षसेन्द्रस्यपूर्णस्ताराधिपोयथा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 40014490, "chapter_id": 9199, "verse_number": "12", "content_sanskrit": "हेममञ्जरिगर्भेचशुद्धस्फटिकविग्रहे । चामरव्यजनेतस्यरेजतुस्सव्यदक्षिणे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 40014491, "chapter_id": 9199, "verse_number": "13", "content_sanskrit": "तेकृताञ्जलयस्सर्वेरथस्थंपृथिवीस्थिताः । राक्षसाराक्षसश्रेष्ठंशिरोभिस्तंववन्दिरे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 40014492, "chapter_id": 9199, "verse_number": "14", "content_sanskrit": "राक्षसैस्त्सूयमानस्सञ्जयाशीर्भिररिन्दमः । आससादमहातेजास्सभांविरचितांतदा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 40014493, "chapter_id": 9199, "verse_number": "15", "content_sanskrit": "सुवर्णरजतास्तीर्णांविशुद्धस्फटिकान्तराम् । विराजमानोवपुषारुक्मपट्टोत्तरच्छदाम् ॥ तांपिशाचशतै: षङ्भिरभिगुप्तांसदाप्रभाम् । प्रविवेशमहातेजास्सुकृतांविश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 40014494, "chapter_id": 9199, "verse_number": "16", "content_sanskrit": "सुवर्णरजतास्तीर्णांविशुद्धस्फटिकान्तराम् । विराजमानोवपुषारुक्मपट्टोत्तरच्छदाम् ॥ तांपिशाचशतै: षङ्भिरभिगुप्तांसदाप्रभाम् । प्रविवेशमहातेजास्सुकृतांविश्वकर्मणा ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 40014495, "chapter_id": 9199, "verse_number": "17", "content_sanskrit": "तस्यांसवैडूर्यमयंप्रियकाजिनसम्वृतम् । महत्सोपाश्रयंभेजेरावणःपरमासनम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 40014496, "chapter_id": 9199, "verse_number": "18", "content_sanskrit": "तत: शशासेश्वरवद्दूतान्लघुपराक्रमान् । समानयतमेक्षिप्रमिहैतान्राक्षसानिति ।। कृत्यमस्तिमहज्जानेकर्तव्यमितिशत्रुभिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 40014497, "chapter_id": 9199, "verse_number": "19", "content_sanskrit": "राक्षसास्तद्वचश्श्रुत्वालङ्कायांपरिचक्रमुः ॥ अनुगेहमवस्थायविहारशयनेषुच । उद्यानेषुचरक्षांसिचोदयन्तोह्यभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 40014498, "chapter_id": 9199, "verse_number": "20", "content_sanskrit": "राक्षसास्तद्वचश्श्रुत्वालङ्कायांपरिचक्रमुः ॥ अनुगेहमवस्थायविहारशयनेषुच । उद्यानेषुचरक्षांसिचोदयन्तोह्यभीतवत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 40014499, "chapter_id": 9199, "verse_number": "21", "content_sanskrit": "तेरथान् रुचिरानेकेदृप्तानेकेपृथग्घयान् । नागानेकेऽधिरुरुहुर्जग्मुश्चैकेपदातयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 40014500, "chapter_id": 9199, "verse_number": "22", "content_sanskrit": "सापुरीपरमाकीर्णारथकुञ्जरवाजिभिः । सम्पतद्भिर्विरुरुचेगरुत्मद्भिरिवाम्बरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 40014501, "chapter_id": 9199, "verse_number": "23", "content_sanskrit": "तेवाहनाव्यवस्थाप्ययानानिविविधानिच । सभांपद्भिःप्रविविशुस्सिंहागिरिगुहामिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 40014502, "chapter_id": 9199, "verse_number": "24", "content_sanskrit": "राज्ञःपादौगृहीत्वातुराज्ञातेप्रतिपूजिताः । पीठेष्वन्येबृसीष्वन्येभूमौकेचिदुपाविशन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 40014503, "chapter_id": 9199, "verse_number": "25", "content_sanskrit": "तेसमेत्यसभायांवैराक्षसाराजशासनात् । यथार्हमुपतस्थुस्तेरावणंराक्षसाधिपम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 40014504, "chapter_id": 9199, "verse_number": "26", "content_sanskrit": "मन्त्रिणश्चयथामुख्यानिश्चयार्थेषुपण्डिताः । अमात्याश्चगुणोपेतास्सर्वज्ञाबुद्धिदर्शनाः ॥ समीयुस्तत्रशतशशूराश्चबहवस्तदा । सभायांहेमवर्णायांसर्वार्थस्यसुखायवै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 40014505, "chapter_id": 9199, "verse_number": "27", "content_sanskrit": "मन्त्रिणश्चयथामुख्यानिश्चयार्थेषुपण्डिताः । अमात्याश्चगुणोपेतास्सर्वज्ञाबुद्धिदर्शनाः ॥ समीयुस्तत्रशतशशूराश्चबहवस्तदा । सभायांहेमवर्णायांसर्वार्थस्यसुखायवै ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 40014506, "chapter_id": 9199, "verse_number": "28", "content_sanskrit": "ततोमहात्माविपुलंसुयुग्यंरथम्वरंहेमविचित्रिताङ्गम् । शुभंसमास्थायययौयशस्वीविभीषणस्संसदमग्रजस्य ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 40014507, "chapter_id": 9199, "verse_number": "29", "content_sanskrit": "सपूर्वजायावरजश्शशंसनामाथपश्चाश्चरणौववन्दे । शुकःप्रहस्तश्चतथैवतेभ्योददौयथार्हंपृथगासनानि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 40014508, "chapter_id": 9199, "verse_number": "30", "content_sanskrit": "सुवर्णनानामणिभूषणानांसुवाससांसंसदिराक्षसानाम् । तेषांपरार्घ्यागुरुचन्दनानांस्रजाश्चगन्धाःप्रववुस्समन्तात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 40014509, "chapter_id": 9199, "verse_number": "31", "content_sanskrit": "नचुक्रुशुर्नानृतमाहकश्चित्सभापदोनापिजजल्पुरुच्चैः । संसिद्धार्थास्सर्वएवोग्रवीर्याभर्तुस्सर्वेददृशुश्चाननंते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 40014510, "chapter_id": 9199, "verse_number": "32", "content_sanskrit": "सरावणश्शस्त्रभृतांमनस्विनांमहाबलानांसमितौमनस्वी । तस्यांसभायांप्रभयाचकाशेमध्येवसूनामिववज्रहस्तेः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}]