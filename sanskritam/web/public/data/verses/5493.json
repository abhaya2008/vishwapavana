[{"id": 2210061, "chapter_id": 5493, "verse_number": "", "content_sanskrit": "वैशम्पायनः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2210062, "chapter_id": 5493, "verse_number": "१", "content_sanskrit": "तस्मिन् यज्ञे प्रवृत्ते तु वाग्मिनो हेतुवादिनः ।\nहेतुवादान् बहून् प्राहुः परस्परजिगीषवः ॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2210063, "chapter_id": 5493, "verse_number": "२", "content_sanskrit": "ददृशुस्तं नृपतयो यज्ञस्य विधिमुत्तमम् ।\nदेवेन्द्रस्येव विहितं भीमेन कुरुनन्दन ॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2210064, "chapter_id": 5493, "verse_number": "३", "content_sanskrit": "ददृशुस्तोरणान्यत्र शातकुम्भमयानि ते ।\nशय्यासनविहारांश्च सुबहून् रत्नभूषितान् ॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2210065, "chapter_id": 5493, "verse_number": "४", "content_sanskrit": "घटान् पात्रीः कटाहानि कलशान् वर्धमानकान् ।\nन ते किञ्चिदसौवर्णमपश्यंस्तत्र पार्थिवाः ॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2210066, "chapter_id": 5493, "verse_number": "५", "content_sanskrit": "यूपांश्च शास्त्रविहितान् तारवान् हेमभूषितान् ।\nउपक्लृप्तान् यथाकालं विधिवद् भूरिवर्चसः ॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2210067, "chapter_id": 5493, "verse_number": "६", "content_sanskrit": "स्थलजा जलजा ये च पशवो ये च सम्भृताः ।\nसर्वानेव समानीतान् तानपश्यन्त भूमिपाः ॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2210068, "chapter_id": 5493, "verse_number": "७", "content_sanskrit": "गाश्चैव महिषीश्चैव तथा वृद्धस्त्रियोऽपि च ।\nऔदकानि च सत्वानि श्वापदानि वयांसि च ॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2210069, "chapter_id": 5493, "verse_number": "८", "content_sanskrit": "जरायुजान्यण्डजानि स्वेदजान्युद्भिदानि च ।\nपर्वतानुपवन्यानि भूतानि ददृशुश्च ते ॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2210070, "chapter_id": 5493, "verse_number": "९", "content_sanskrit": "सर्वे राजन् यथान्यायमानीता नृपशासनात् ॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2210071, "chapter_id": 5493, "verse_number": "१०", "content_sanskrit": "एवं प्रमुदितं सर्वं पशुगोधनधान्यतः ।\nयज्ञवाटं नृपा दृष्ट्वा परं विस्मयमागमन् ॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2210072, "chapter_id": 5493, "verse_number": "११", "content_sanskrit": "अनिशं दीयते च स्म तत्र भोज्यं पृथग्विधम् ।\nब्राह्मणानां विशां चैव बहुनिष्ठान्नमृद्धिमत् ॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2210073, "chapter_id": 5493, "verse_number": "१२", "content_sanskrit": "पूर्णे शतसहस्रे तु विप्राणां तत्र भुञ्जताम् ।\nदुन्दुभिर्मेघनिर्घोषो मुहुर्मुहुरताड्यत ॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2210074, "chapter_id": 5493, "verse_number": "१३", "content_sanskrit": "विननादासकृत् सोऽथ दिवसे दिवसे तथा ।\nएवं स ववृते यज्ञो धर्मराजस्य धीमतः ॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2210075, "chapter_id": 5493, "verse_number": "१४", "content_sanskrit": "अन्नस्य सुबहून् राजन्नुत्सर्गान् पर्वतोपमान् ।\nदधिकुल्याश्च ददृशु सर्पिषश्च ह्रदाञ्जनाः ॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2210076, "chapter_id": 5493, "verse_number": "१५", "content_sanskrit": "जम्बूद्वीपो हि सकलो नानाजानपदो जनः ।\nराजन्नदृश्यतैकस्थो राज्ञस्तस्य महाक्रतौ ॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2210077, "chapter_id": 5493, "verse_number": "१६", "content_sanskrit": "तत्र जातिसहस्राणि पुरुषाणां ततस्ततः ।\nगृहीत्वा धनमाजग्मुर्बहूनि भरतर्षभ ॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2210078, "chapter_id": 5493, "verse_number": "१७", "content_sanskrit": "राजानः स्रग्विणश्चापि सुमृष्टमणिकुण्डलाः ।\nपर्यवेषत् द्विजाग्र्यांस्तान् शतशोऽथ सहस्रशः ॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2210079, "chapter_id": 5493, "verse_number": "१८", "content_sanskrit": "विविधान्यन्नपानानि पुरुषा येऽनुयायिनः ।\nतेषां नृपोपभोग्यानि ब्राह्मणानां ददुः स्म ह ॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2210080, "chapter_id": 5493, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शतसहस्रिकायां संहितायां वैयासिक्याम् आश्वमेधिकपर्वणि अन्नादिपरिवेषणं नाम सप्ताशीतितमोऽध्यायः ॥८६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}]