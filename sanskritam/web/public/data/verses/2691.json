[{"id": 2079369, "chapter_id": 2691, "verse_number": "१२-१९६-०x", "content_sanskrit": "युधिष्ठिर उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2079370, "chapter_id": 2691, "verse_number": "१२-१९६-१", "content_sanskrit": "कीदृशं निरयं याति जापको वर्णयस्व मे।\nकौतूहलं हि राजन्मे तद्भवान्वक्तुमर्हति॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2079371, "chapter_id": 2691, "verse_number": "१२-१९६-२x", "content_sanskrit": "भीष्म उवाच।", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2079372, "chapter_id": 2691, "verse_number": "१२-१९६-२", "content_sanskrit": "धर्मस्यांशप्रसूतोऽसि धर्मज्ञोऽसि स्वभावतः।\nधर्ममूलाश्रयं वाक्यं शृणुष्वावहितोऽनघ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2079373, "chapter_id": 2691, "verse_number": "१२-१९६-३", "content_sanskrit": "अमूनि यानि स्थानानि देवानाममरात्मनाम्।\nनानासंस्थानवर्णानि नानारूपफलानि च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2079374, "chapter_id": 2691, "verse_number": "१२-१९६-४", "content_sanskrit": "दिव्यानि कामचारीणि विमानानि सभास्तथा।\nआक्रीडा विविधा राजन्पद्मिन्यश्चामलोदकाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2079375, "chapter_id": 2691, "verse_number": "१२-१९६-५", "content_sanskrit": "चतुर्णां लोकपालानां शुक्रस्याथ बृहस्पतेः।\nमरुतां विश्वदेवानां साध्यानामश्विनोरपि॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2079376, "chapter_id": 2691, "verse_number": "१२-१९६-६", "content_sanskrit": "रुद्रादित्यवसूनां च तथाऽन्येषां दिवौकसाम्।\nएते वै निरयास्तात स्थानस्य परमात्मनः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2079377, "chapter_id": 2691, "verse_number": "१२-१९६-७", "content_sanskrit": "अभयं चानिमित्तं च न च क्लेशभयावृतम्।\nद्वाभ्यां मुक्तं त्रिभिर्मुक्तमष्टाभिस्त्रिभिरेव च॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2079378, "chapter_id": 2691, "verse_number": "१२-१९६-८", "content_sanskrit": "चतुर्लक्षणवर्जं तु चतुष्कारणवर्जितम्।\nअप्रहर्षमनानन्दमशोकं विगतक्लमम्॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2079379, "chapter_id": 2691, "verse_number": "१२-१९६-९", "content_sanskrit": "कालः संपच्यते तत्र कालस्तत्र न वै प्रभुः।\nस कालस्य प्रभू राजन्सर्वस्यापि तथेश्वरः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2079380, "chapter_id": 2691, "verse_number": "१२-१९६-१०", "content_sanskrit": "`एतद्वै ब्रह्मणः स्थाने जापकस्य महात्मनः।\nतत्रस्थं परमात्मानं ध्यायन्वै सुसमाहितः।\nहिरण्यगर्भः सायुज्यं प्राप्नुयाद्वा नृपोत्तम॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2079381, "chapter_id": 2691, "verse_number": "१२-१९६-११", "content_sanskrit": "आत्मकेवलतां प्राप्तस्तत्र गत्वा न शोचति।\nईदृशं परमं स्थानं निरयास्ते च तादृशाः॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2079382, "chapter_id": 2691, "verse_number": "१२-१९६-१२", "content_sanskrit": "एते ते निरयाः प्रोक्ताः सर्व एव यथातथम्।\nतस्य स्थानवरस्येह सर्वे निरयसंज्ञिताः॥ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2079383, "chapter_id": 2691, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमन्महाभारते शान्तिपर्वणि मोक्षधर्मपर्वणि षण्णवत्यधिकशततमोऽध्यायः॥ १९६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}]