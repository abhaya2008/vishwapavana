[{"id": 5000424000, "chapter_id": 9424, "verse_number": null, "content_sanskrit": "श्रीमद्वाल्मीकियरामायणे युद्धकाण्डे सप्तदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 5000424001, "chapter_id": 9424, "verse_number": "६-१७-१", "content_sanskrit": "इत्युक्त्वा परुषं वाक्यं रावणं रावणानुजः।\nआजगाम मुहूर्तेन यत्र रामः सलक्ष्मणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 5000424002, "chapter_id": 9424, "verse_number": "६-१७-२", "content_sanskrit": "तं मेरुशिखराकारं दीप्तामिव शतह्रदाम्।\nगगनस्थं महीस्थास्ते ददृशुर्वानराधिपाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 5000424003, "chapter_id": 9424, "verse_number": "६-१७-३", "content_sanskrit": "ते चाप्यनुचरास्तस्य चत्वारो भीमविक्रमाः।\nतेऽपि वर्मायुधोपेता भूषणोत्तमभूषिताः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 5000424004, "chapter_id": 9424, "verse_number": "६-१७-४", "content_sanskrit": "स च मेघाचलप्रख्यो वज्रायुधसमप्रभः।\nवरायुधधरो वीरो दिव्याभरणभूषितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 5000424005, "chapter_id": 9424, "verse_number": "६-१७-५", "content_sanskrit": "तमात्मपञ्चमं दृष्ट्वा सुग्रीवो वानराधिपः।\nवानरैः सह दुर्धर्षश्चिन्तयामास बुद्धिमान् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 5000424006, "chapter_id": 9424, "verse_number": "६-१७-६", "content_sanskrit": "चिन्तयित्वा मुहूर्तं तु वानरांस्तानुवाच ह।\nहनुमत्प्रमुखान् सर्वानिदं वचनमुत्तमम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 5000424007, "chapter_id": 9424, "verse_number": "६-१७-७", "content_sanskrit": "एष सर्वायुधोपेतश्चतुर्भिः सह राक्षसैः।\nराक्षसोभ्येति पश्यध्वमस्मान् हन्तुं न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 5000424008, "chapter_id": 9424, "verse_number": "६-१७-८", "content_sanskrit": "सुग्रीवस्य वचः श्रुत्वा सर्वे ते वानरोत्तमाः।\nसालानुद्यम्य शैलांश्च इदं वचनमब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 5000424009, "chapter_id": 9424, "verse_number": "६-१७-९", "content_sanskrit": "शीघ्रं व्यादिश नो राजन् वधायैषां दुरात्मनाम्।\nनिपतन्ति हता यावद् धरण्यामल्पचेतनाः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 5000424010, "chapter_id": 9424, "verse_number": "६-१७-१०", "content_sanskrit": "तेषां सम्भाषमाणानामन्योन्यं स विभीषणः।\nउत्तरं तीरमासाद्य खस्थ एव व्यतिष्ठत ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 5000424011, "chapter_id": 9424, "verse_number": "६-१७-११", "content_sanskrit": "स उवाच महाप्राज्ञः स्वरेण महता महान्।\nसुग्रीवं तांश्च सम्प्रेक्ष्य खस्थ एव विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 5000424012, "chapter_id": 9424, "verse_number": "६-१७-१२", "content_sanskrit": "रावणो नाम दुर्वृत्तो राक्षसो राक्षसेश्वरः।\nतस्याहमनुजो भ्राता विभीषण इति श्रुतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 5000424013, "chapter_id": 9424, "verse_number": "६-१७-१३", "content_sanskrit": "तेन सीता जनस्थानाद् हृता हत्वा जटायुषम्।\nरुद्धा च विवशा दीना राक्षसीभिः सुरक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 5000424014, "chapter_id": 9424, "verse_number": "६-१७-१४", "content_sanskrit": "तमहं हेतुभिर्वाक्यैर्विविधैश्च न्यदर्शयम्।\nसाधु निर्यात्यतां सीता रामायेति पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 5000424015, "chapter_id": 9424, "verse_number": "६-१७-१५", "content_sanskrit": "स च न प्रतिजग्राह रावणः कालचोदितः।\nउच्यमानं हितं वाक्यं विपरीत इवौषधम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 5000424016, "chapter_id": 9424, "verse_number": "६-१७-१६", "content_sanskrit": "सोऽहं परुषितस्तेन दासवच्चावमानितः।\nत्यक्त्वा पुत्रांश्च दारांश्च राघवं शरणं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 5000424017, "chapter_id": 9424, "verse_number": "६-१७-१७", "content_sanskrit": "निवेदयत मां क्षिप्रं राघवाय महात्मने।\nसर्वलोकशरण्याय विभीषणमुपस्थितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 5000424018, "chapter_id": 9424, "verse_number": "६-१७-१८", "content_sanskrit": "एतत्तु वचनं श्रुत्वा सुग्रीवो लघुविक्रमः।\nलक्ष्मणस्याग्रतो रामं संरब्धमिदमब्रवीत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 5000424019, "chapter_id": 9424, "verse_number": "६-१७-१९", "content_sanskrit": "प्रविष्टः शत्रुसैन्यं हि प्राप्तः शत्रुरतर्कितः।\nनिहन्यादन्तरं लब्ध्वा उलूको वायसानिव ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 5000424020, "chapter_id": 9424, "verse_number": "६-१७-२०", "content_sanskrit": "मन्त्रे व्यूहे नये चारे युक्तो भवितुमर्हसि।\nवानराणां च भद्रं ते परेषां च परंतप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 5000424021, "chapter_id": 9424, "verse_number": "६-१७-२१", "content_sanskrit": "अन्तर्धानगता ह्येते राक्षसाः कामरूपिणः।\nशूराश्च निकृतिज्ञाश्च तेषां जातु न विश्वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 5000424022, "chapter_id": 9424, "verse_number": "६-१७-२२", "content_sanskrit": "प्रणिधी राक्षसेन्द्रस्य रावणस्य भवेदयम्।\nअनुप्रविश्य सोऽस्मासु भेदं कुर्यान्न संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 5000424023, "chapter_id": 9424, "verse_number": "६-१७-२३", "content_sanskrit": "अथ वा स्वयमेवैष छिद्रमासाद्य बुद्धिमान्।\nअनुप्रविश्य विश्वस्ते कदाचित् प्रहरेदपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 5000424024, "chapter_id": 9424, "verse_number": "६-१७-२४", "content_sanskrit": "मित्राटविबलं चैव मौलभृत्यबलं तथा।\nसर्वमेतद् बलं ग्राह्यं वर्जयित्वा द्विषद्बलम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 5000424025, "chapter_id": 9424, "verse_number": "६-१७-२५", "content_sanskrit": "प्रकृत्या राक्षसो ह्येष भ्रातामित्रस्य वै प्रभो।\nआगतश्च रिपुः साक्षात् कथमस्मिंश्च विश्वसेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 5000424026, "chapter_id": 9424, "verse_number": "६-१७-२६", "content_sanskrit": "रावणस्यानुजो भ्राता विभीषण इति श्रुतः।\nचतुर्भिः सह रक्षोभिर्भवन्तं शरणं गतः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 5000424027, "chapter_id": 9424, "verse_number": "६-१७-२७", "content_sanskrit": "रावणेन प्रणीतं हि तमवेहि विभीषणम्।\nतस्याहं निग्रहं मन्ये क्षमं क्षमवतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 5000424028, "chapter_id": 9424, "verse_number": "६-१७-२८", "content_sanskrit": "राक्षसो जिह्मया बुद्ध्या संदिष्टोऽयमिहागतः।\nप्रहर्तुं मायया छन्नो विश्वस्ते त्वयि चानघ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 5000424029, "chapter_id": 9424, "verse_number": "६-१७-२९", "content_sanskrit": "वध्यतामेष तीव्रेण दण्डेन सचिवैः सह।\nरावणस्य नृशंसस्य भ्राता ह्येष विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 5000424030, "chapter_id": 9424, "verse_number": "६-१७-३०", "content_sanskrit": "एवमुक्त्वा तु तं रामं संरब्धो वाहिनीपतिः।\nवाक्यज्ञो वाक्यकुशलं ततो मौनमुपागमत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 5000424031, "chapter_id": 9424, "verse_number": "६-१७-३१", "content_sanskrit": "सुग्रीवस्य तु तद् वाक्यं श्रुत्वा रामो महाबलः।\nसमीपस्थानुवाचेदं हनुमत्प्रमुखान् कपीन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 5000424032, "chapter_id": 9424, "verse_number": "६-१७-३२", "content_sanskrit": "यदुक्तं कपिराजेन रावणावरजं प्रति।\nवाक्यं हेतुमदत्यर्थं भवद्भिरपि च श्रुतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 5000424033, "chapter_id": 9424, "verse_number": "६-१७-३३", "content_sanskrit": "सुहृदामर्थकृच्छ्रेषु युक्तं बुद्धिमता सदा।\nसमर्थेनोपसंदेष्टुं शाश्वतीं भूतिमिच्छता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 5000424034, "chapter_id": 9424, "verse_number": "६-१७-३४", "content_sanskrit": "इत्येवं परिपृष्टास्ते स्वं स्वं मतमतन्द्रिताः।\nसोपचारं तदा राममूचुः प्रियचिकीर्षवः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 5000424035, "chapter_id": 9424, "verse_number": "६-१७-३५", "content_sanskrit": "अज्ञातं नास्ति ते किंचित् त्रिषु लोकेषु राघव।\nआत्मानं पूजयन् राम पृच्छस्यस्मान् सुहृत्तया ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 5000424036, "chapter_id": 9424, "verse_number": "६-१७-३६", "content_sanskrit": "त्वं हि सत्यव्रतः शूरो धार्मिको दृढविक्रमः।\nपरीक्ष्यकारी स्मृतिमान् निसृष्टात्मा सुहृत्सु च ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 5000424037, "chapter_id": 9424, "verse_number": "६-१७-३७", "content_sanskrit": "तस्मादेकैकशस्तावद् ब्रुवन्तु सचिवास्तव।\nहेतुतो मतिसम्पन्नाः समर्थाश्च पुनः पुनः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 5000424038, "chapter_id": 9424, "verse_number": "६-१७-३८", "content_sanskrit": "इत्युक्ते राघवायाथ मतिमानङ्गदोऽग्रतः।\nविभीषणपरीक्षार्थमुवाच वचनं हरिः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 5000424039, "chapter_id": 9424, "verse_number": "६-१७-३९", "content_sanskrit": "शत्रोः सकाशात् सम्प्राप्तः सर्वथा तर्क्य एव हि।\nविश्वासनीयः सहसा न कर्तव्यो विभीषणः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 5000424040, "chapter_id": 9424, "verse_number": "६-१७-४०", "content_sanskrit": "छादयित्वाऽऽत्मभावं हि चरन्ति शठबुद्धयः।\nप्रहरन्ति च रन्ध्रेषु सोऽनर्थः सुमहान् भवेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 5000424041, "chapter_id": 9424, "verse_number": "६-१७-४१", "content_sanskrit": "अर्थानर्थौ विनिश्चित्य व्यवसायं भजेत ह।\nगुणतः संग्रहं कुर्याद् दोषतस्तु विसर्जयेत् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 5000424042, "chapter_id": 9424, "verse_number": "६-१७-४२", "content_sanskrit": "यदि दोषो महांस्तस्मिंस्त्यज्यतामविशङ्कितम्।\nगुणान् वापि बहून् ज्ञात्वा संग्रहः क्रियतां नृप ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 5000424043, "chapter_id": 9424, "verse_number": "६-१७-४३", "content_sanskrit": "शरभस्त्वथ निश्चित्य सार्थं वचनमब्रवीत्।\nक्षिप्रमस्मिन् नरव्याघ्र चारः प्रतिविधीयताम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 5000424044, "chapter_id": 9424, "verse_number": "६-१७-४४", "content_sanskrit": "प्रणिधाय हि चारेण यथावत् सूक्ष्मबुद्धिना।\nपरीक्ष्य च ततः कार्यो यथान्यायं परिग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 5000424045, "chapter_id": 9424, "verse_number": "६-१७-४५", "content_sanskrit": "जाम्बवांस्त्वथ सम्प्रेक्ष्य शास्त्रबुद्ध्या विचक्षणः।\nवाक्यं विज्ञापयामास गुणवद् दोषवर्जितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 5000424046, "chapter_id": 9424, "verse_number": "६-१७-४६", "content_sanskrit": "बद्धवैराच्च पापाच्च राक्षसेन्द्राद् विभीषणः।\nअदेशकाले सम्प्राप्तः सर्वथा शंक्यतामयम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 5000424047, "chapter_id": 9424, "verse_number": "६-१७-४७", "content_sanskrit": "ततो मैन्दस्तु सम्प्रेक्ष्य नयापनयकोविदः।\nवाक्यं वचनसम्पन्नो बभाषे हेतुमत्तरम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 5000424048, "chapter_id": 9424, "verse_number": "६-१७-४८", "content_sanskrit": "अनुजो नाम तस्यैष रावणस्य विभीषणः।\nपृच्छ्यतां मधुरेणायं शनैर्नरपतीश्वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 5000424049, "chapter_id": 9424, "verse_number": "६-१७-४९", "content_sanskrit": "भावमस्य तु विज्ञाय तत्त्वतस्तं करिष्यसि।\nयदि दुष्टो न दुष्टो वा बुद्धिपूर्वं नरर्षभ ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 5000424050, "chapter_id": 9424, "verse_number": "६-१७-५०", "content_sanskrit": "अथ संस्कारसम्पन्नो हनूमान् सचिवोत्तमः।\nउवाच वचनं श्लक्ष्णमर्थवन्मधुरं लघु ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 5000424051, "chapter_id": 9424, "verse_number": "६-१७-५१", "content_sanskrit": "न भवन्तं मतिश्रेष्ठं समर्थं वदतां वरम्।\nअतिशाययितुं शक्तो बृहस्पतिरपि ब्रुवन् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 5000424052, "chapter_id": 9424, "verse_number": "६-१७-५२", "content_sanskrit": "न वादान्नापि संघर्षान्नाधिक्यान्न च कामतः।\nवक्ष्यामि वचनं राजन् यथार्थं राम गौरवात् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 5000424053, "chapter_id": 9424, "verse_number": "६-१७-५३", "content_sanskrit": "अर्थानर्थनिमित्तं हि यदुक्तं सचिवैस्तव।\nतत्र दोषं प्रपश्यामि क्रिया नह्युपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 5000424054, "chapter_id": 9424, "verse_number": "६-१७-५४", "content_sanskrit": "ऋते नियोगात् सामर्थ्यमवबोद्धुं न शक्यते।\nसहसा विनियोगोऽपि दोषवान् प्रतिभाति मे ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 5000424055, "chapter_id": 9424, "verse_number": "६-१७-५५", "content_sanskrit": "चारप्रणिहितं युक्तं यदुक्तं सचिवैस्तव।\nअर्थस्यासम्भवात् तत्र कारणं नोपपद्यते ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 5000424056, "chapter_id": 9424, "verse_number": "६-१७-५६", "content_sanskrit": "अदेशकाले सम्प्राप्त इत्ययं यद् विभीषणः।\nविवक्षा तत्र मेऽस्तीयं तां निबोध यथामति ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 5000424057, "chapter_id": 9424, "verse_number": "६-१७-५७", "content_sanskrit": "एष देशश्च कालश्च भवतीह यथा तथा।\nपुरुषात् पुरुषं प्राप्य तथा दोषगुणावपि ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 5000424058, "chapter_id": 9424, "verse_number": "६-१७-५८", "content_sanskrit": "दौरात्म्यं रावणे दृष्ट्वा विक्रमं च तथा त्वयि।\nयुक्तमागमनं ह्यत्र सदृशं तस्य बुद्धितः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 5000424059, "chapter_id": 9424, "verse_number": "६-१७-५९", "content_sanskrit": "अज्ञातरूपैः पुरुषैः स राजन् पृच्छ्यतामिति।\nयदुक्तमत्र मे प्रेक्षा काचिदस्ति समीक्षिता ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 5000424060, "chapter_id": 9424, "verse_number": "६-१७-६०", "content_sanskrit": "पृच्छ्यमानो विशङ्केत सहसा बुद्धिमान् वचः।\nतत्र मित्रं प्रदुष्येत मिथ्या पृष्टं सुखागतम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 5000424061, "chapter_id": 9424, "verse_number": "६-१७-६१", "content_sanskrit": "अशक्यं सहसा राजन् भावो बोद्धुं परस्य वै।\nअन्तरेण स्वरैर्भिन्नैर्नैपुण्यं पश्यतां भृशम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 5000424062, "chapter_id": 9424, "verse_number": "६-१७-६२", "content_sanskrit": "न त्वस्य ब्रुवतो जातु लक्ष्यते दुष्टभावता।\nप्रसन्नं वदनं चापि तस्मान्मे नास्ति संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 5000424063, "chapter_id": 9424, "verse_number": "६-१७-६३", "content_sanskrit": "अशङ्कितमतिः स्वस्थो न शठः परिसर्पति।\nन चास्य दुष्टवागस्ति तस्मान्मे नास्ति संशयः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 5000424064, "chapter_id": 9424, "verse_number": "६-१७-६४", "content_sanskrit": "आकारश्छाद्यमानोऽपि न शक्यो विनिगूहितुम्।\nबलाद्धि विवृणोत्येव भावमन्तर्गतं नृणाम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 5000424065, "chapter_id": 9424, "verse_number": "६-१७-६५", "content_sanskrit": "देशकालोपपन्नं च कार्यं कार्यविदां वर।\nसफलं कुरुते क्षिप्रं प्रयोगेणाभिसंहितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 5000424066, "chapter_id": 9424, "verse_number": "६-१७-६६", "content_sanskrit": "उद्योगं तव सम्प्रेक्ष्य मिथ्यावृत्तं च रावणम्।\nवालिनं च हतं श्रुत्वा सुग्रीवं चाभिषेचितम् ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 5000424067, "chapter_id": 9424, "verse_number": "६-१७-६७", "content_sanskrit": "राज्यं प्रार्थयमानस्तु बुद्धिपूर्वमिहागतः।\nएतावत् तु पुरस्कृत्य युज्यते तस्य संग्रहः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}, {"id": 5000424068, "chapter_id": 9424, "verse_number": "६-१७-६८", "content_sanskrit": "यथाशक्ति मयोक्तं तु राक्षसस्यार्जवं प्रति।\nप्रमाणं त्वं हि शेषस्य श्रुत्वा बुद्धिमतां वर ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 69}, {"id": 5000424069, "chapter_id": 9424, "verse_number": null, "content_sanskrit": "इत्यार्षे श्रीमद्रामायणे वाल्मीकीये आदिकाव्ये युद्धकाण्डे सप्तदशः सर्गः ॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 70}]