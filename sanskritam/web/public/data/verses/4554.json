[{"id": 2164969, "chapter_id": 4554, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 1}, {"id": 2164970, "chapter_id": 4554, "verse_number": "१", "content_sanskrit": "ततः कर्णो रणे दृष्ट्वा पार्षतं परवीरहा ।\nआजघानोरसि शरैर्दशभिर्मर्मभेदिभिः\t॥१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 2}, {"id": 2164971, "chapter_id": 4554, "verse_number": "२", "content_sanskrit": "प्रतिविव्याध तं तूर्णं धृष्टद्युम्नोऽपि मारिष ।\nपञ्चभिः सायकैर्हृष्टस्तिष्ठ तिष्ठेति चाब्रवीत्\t॥२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 3}, {"id": 2164972, "chapter_id": 4554, "verse_number": "३", "content_sanskrit": "तावन्योन्यं शरैः सङ्खे सञ्छाद्य सुमहारथौ ।\nपुनः पूर्णायतोत्सृष्टैर्विव्यधाते परस्परम्\t॥३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 4}, {"id": 2164973, "chapter_id": 4554, "verse_number": "४", "content_sanskrit": "ततः पाञ्चालमुख्यस्य धृष्टद्युम्नस्य संयुगे ।\nसारथिं चतुरश्चाश्वान् कर्णो विव्याध सायकैः\t॥४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 5}, {"id": 2164974, "chapter_id": 4554, "verse_number": "५", "content_sanskrit": "कार्मुकप्रवरं चास्य प्रचिच्छेद शितैः शरैः ।\nसारथिं चास्य भल्लेन रथनीडादपातयत्\t॥५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 6}, {"id": 2164975, "chapter_id": 4554, "verse_number": "६", "content_sanskrit": "धृष्टद्युम्नस्तु विरथो हताश्वो हतसारथिः ।\nगृहीत्वा परिघं घोरं कर्णस्याश्वानपीपिषत्\t॥६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 7}, {"id": 2164976, "chapter_id": 4554, "verse_number": "७", "content_sanskrit": "विद्धश्च बहुभिस्तेन शरैराशीविषोपमैः ।\nततो युधिष्ठिरानीकं पद्भ्यामेवान्ववर्तत ।\nआरुरोह रथं चापि सहदेवस्य मारिष\t॥७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 8}, {"id": 2164977, "chapter_id": 4554, "verse_number": "८", "content_sanskrit": "कर्णस्यापि रथे वाहानन्यान् सूतो न्ययोजयत् ।\nशङ्खवर्णान् महावेगान् सैन्धवान् साधुवाहिनः\t॥८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 9}, {"id": 2164978, "chapter_id": 4554, "verse_number": "९", "content_sanskrit": "लब्धलक्ष्यस्तु राधेयः पाञ्चालानां महारथान् ।\nअभ्यपीडयदायस्तः शरैर्मेघ इवाचलान्\t॥९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 10}, {"id": 2164979, "chapter_id": 4554, "verse_number": "१०", "content_sanskrit": "सा पीड्यमाना कर्णेन पाञ्चालानां महाचमूः ।\nसम्प्राद्रवत् सुसन्त्रस्ता सिंहेनेवार्दिता मृगी\t॥१०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 11}, {"id": 2164980, "chapter_id": 4554, "verse_number": "११", "content_sanskrit": "पतितास्तुरगेभ्यश्च गजेभ्यश्च महीतळे ।\nरथेभ्यश्च नरास्तूर्णमदृश्यन्त ततस्ततः\t॥११॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 12}, {"id": 2164981, "chapter_id": 4554, "verse_number": "१२", "content_sanskrit": "धावमानस्य योधस्य क्षुरप्रैः स महामृधे ।\nबाहू चिच्छेद वै कर्णः शिरश्चैव सकुण्डलम्\t॥१२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 13}, {"id": 2164982, "chapter_id": 4554, "verse_number": "१३", "content_sanskrit": "ऊरू चिच्छेद चान्यस्य गजस्थस्य विशांपते ।\nवाजिपृष्ठगतस्यापि भूमिष्ठस्य च मारिष\t॥१३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 14}, {"id": 2164983, "chapter_id": 4554, "verse_number": "१४", "content_sanskrit": "नाज्ञासिषुर्धावमाना बहवश्च महारथाः ।\nसञ्छिन्नान्यात्मगात्राणि वाहनानि च संयुगे\t॥१४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 15}, {"id": 2164984, "chapter_id": 4554, "verse_number": "१५", "content_sanskrit": "ते वध्यमानाः समरे पाञ्चालाः सृञ्जयैः सह ।\nतृणप्रस्पन्दनाच्चापि सूतपुत्रं स्म मेनिरे\t॥१५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 16}, {"id": 2164985, "chapter_id": 4554, "verse_number": "१६", "content_sanskrit": "अपि स्वं समरे योधं धावमानं विचेतसः ।\nकर्णमेवाभ्यमन्यन्त ततो भीता द्रवन्ति ते\t॥१६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 17}, {"id": 2164986, "chapter_id": 4554, "verse_number": "१७", "content_sanskrit": "तान्यनीकानि भग्नानि द्रवमाणानि भारत ।\nअभ्यद्रवद् द्रुतं कर्णः पृष्ठतो विकिरन् शरान्\t॥१७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 18}, {"id": 2164987, "chapter_id": 4554, "verse_number": "१८", "content_sanskrit": "अवेक्षमाणास्तेऽन्योन्यं सुसम्मूढा विचेतसः ।\nनाशक्नुवन्नवस्थातुं काल्यमाना महात्मना\t॥१८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 19}, {"id": 2164988, "chapter_id": 4554, "verse_number": "१९", "content_sanskrit": "कर्णेनाभ्याहता राजन् पाञ्चालाः परमेषुभिः ।\nद्रोणेन च दिशः सर्वा वीक्षमाणाः प्रदुद्रुवुः\t॥१९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 20}, {"id": 2164989, "chapter_id": 4554, "verse_number": "२०", "content_sanskrit": "ततो युधिष्ठिरो राजा स्वसैन्यं प्रेक्ष्य विद्रुतम् ।\nअपयाने मतिं कृत्वा फल्गुनं वाक्यमब्रवीत्\t॥२०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 21}, {"id": 2164990, "chapter_id": 4554, "verse_number": "२१", "content_sanskrit": "पश्य कर्णं महेष्वासं धनुष्पाणिमवस्थितम् ।\nनिशीथे दारुणे काले तपन्तमिव भास्करम्\t॥२१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 22}, {"id": 2164991, "chapter_id": 4554, "verse_number": "२२", "content_sanskrit": "कर्णसायकनुन्नानां क्रोशतामेष निस्वनः ।\nअनिशं श्रूयते पार्थ त्वद्बन्धूनामनाथवत्\t॥२२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 23}, {"id": 2164992, "chapter_id": 4554, "verse_number": "२३", "content_sanskrit": "यथा विसृजतश्चास्य सन्दधानस्य चाशुगान् ।\nपश्यामि जयविक्रान्तं क्षपयिष्यति नो ध्रुवम्\t॥२३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 24}, {"id": 2164993, "chapter_id": 4554, "verse_number": "२४", "content_sanskrit": "यदत्रानन्तरं कार्यं प्राप्तकालं प्रपश्यसि ।\nकर्णस्य वधसंयुक्तं तत् कुरुष्व धनञ्जय\t॥२४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 25}, {"id": 2164994, "chapter_id": 4554, "verse_number": "२५", "content_sanskrit": "एवमुक्तो महाबाहुः पार्थः कृष्णमथाब्रवीत् ।\nभीतः कुन्तीसुतो राजा राधेयस्यातिविक्रमात्\t॥२५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 26}, {"id": 2164995, "chapter_id": 4554, "verse_number": "२६", "content_sanskrit": "एवं गते प्राप्तकालं कर्णानीके पुनः पुनः ।\nभवान् व्यवस्यतां क्षिप्रं द्रवते हि वरूथिनी\t॥२६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 27}, {"id": 2164996, "chapter_id": 4554, "verse_number": "२७", "content_sanskrit": "द्रोणसायकनुन्नानां भग्नानां मधुसूदन ।\nकर्णेन त्रास्यमानानामवस्थानं न विद्यते\t॥२७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 28}, {"id": 2164997, "chapter_id": 4554, "verse_number": "२८", "content_sanskrit": "पश्यामि च तथा कर्णं विचरन्तमभीतवत् ।\nद्रवमाणान् रथोदारान् किरन्तं विशिखैः शितैः\t॥२८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 29}, {"id": 2164998, "chapter_id": 4554, "verse_number": "२९", "content_sanskrit": "नैतदस्योत्सहे सोढुं चरितं रणमूर्धनि ।\nप्रत्यक्षं वृष्णिशार्दूल पादस्पर्शमिवोरगः\t॥२९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 30}, {"id": 2164999, "chapter_id": 4554, "verse_number": "३०", "content_sanskrit": "स भवानत्र यात्वाशु यत्र कर्णो महारथः ।\nअहमेनं वधिष्यामि मां वैष मधुसूदन\t॥३०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 31}, {"id": 2165000, "chapter_id": 4554, "verse_number": "", "content_sanskrit": "वासुदेवः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 32}, {"id": 2165001, "chapter_id": 4554, "verse_number": "३१", "content_sanskrit": "पश्यामि कर्णं कौन्तेय देवराजमिवाहवे ।\nविचरन्तं नरव्याघ्रमतिमानुषविक्रमम्\t॥३१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 33}, {"id": 2165002, "chapter_id": 4554, "verse_number": "३२", "content_sanskrit": "नैतस्यान्योऽस्ति समरे प्रत्युद्याता धनञ्जय ।\nऋते त्वां पुरुषव्याघ्र राक्षसाद्वा घटोत्कचात्\t॥३२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 34}, {"id": 2165003, "chapter_id": 4554, "verse_number": "३३", "content_sanskrit": "न तु तावदहं मन्ये प्राप्तकालं तवानघ ।\nसमागमं महाबाहो सूतपुत्रेण संयुगे\t॥३३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 35}, {"id": 2165004, "chapter_id": 4554, "verse_number": "३४", "content_sanskrit": "दीप्यमाना महोल्केव तिष्ठत्यस्य हि वासवी ।\nत्वदर्थं हि महाबाहो रौद्ररूपं बिभर्ति च\t॥३४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 36}, {"id": 2165005, "chapter_id": 4554, "verse_number": "३५", "content_sanskrit": "घटोत्कचस्तु राधेयं प्रत्युद्यातु महाबलः ।\nस हि भीमेन बलिना जातः सुरपराक्रमः\t॥३५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 37}, {"id": 2165006, "chapter_id": 4554, "verse_number": "३६", "content_sanskrit": "तस्मिन्नस्त्राणि दिव्यानि राक्षसान्यासुराणि च ।\nसततं चानुरक्तो वो हितैषी च घटोत्कचः ।\nविजेष्यति रणे कर्णमिति मे नात्र संशयः\t॥३६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 38}, {"id": 2165007, "chapter_id": 4554, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 39}, {"id": 2165008, "chapter_id": 4554, "verse_number": "३७", "content_sanskrit": "एवमुक्त्वा महाबाहुः पार्थं पुष्करलोचनः ।\nआजुहावाथ तद्रक्षः तच्चासीत् प्रादुरग्रतः ।\nकवची स शरी खड्गी सधन्वा च विशांपते\t॥३७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 40}, {"id": 2165009, "chapter_id": 4554, "verse_number": "३८", "content_sanskrit": "अभिवाद्य ततः कृष्णं पाण्डवं च धनञ्जयम् ।\nअब्रवीत् तं तदा हृष्टस्त्वयमस्म्यनुशाधि माम्\t॥३८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 41}, {"id": 2165010, "chapter_id": 4554, "verse_number": "३९", "content_sanskrit": "ततस्तं मेघसङ्काशं दीप्तास्यं दीप्तकुण्डलम् ।\nअभ्यभाषत हैडिम्बं दाशार्हः प्रहसन्निव\t॥३९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 42}, {"id": 2165011, "chapter_id": 4554, "verse_number": "४०", "content_sanskrit": "घटोत्कच विजानीहि यत्त्वां वक्ष्यामि पुत्रक ।\nप्राप्तो विक्रमकालोऽयं तव नान्यस्य कस्यचित्\t॥४०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 43}, {"id": 2165012, "chapter_id": 4554, "verse_number": "४१", "content_sanskrit": "स भवान् मज्जमानानां बन्धूनां त्वं प्लवो यथा ।\nविविधानि तवास्त्राणि सन्ति माया च राक्षसी\t॥४१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 44}, {"id": 2165013, "chapter_id": 4554, "verse_number": "४२", "content_sanskrit": "पश्य कर्णेन हैडिम्ब पाण्डवानामनीकिनी ।\nकाल्यमाना यथा गावः पालेन रणमूर्धनि\t॥४२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 45}, {"id": 2165014, "chapter_id": 4554, "verse_number": "४३", "content_sanskrit": "एष कर्णो महेष्वासो मतिमान् दृढविक्रमः ।\nपाण्डवानामनीकेषु निहन्ति क्षत्रियर्षभान्\t॥४३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 46}, {"id": 2165015, "chapter_id": 4554, "verse_number": "४४", "content_sanskrit": "किरन्तः शरवर्षाणि महान्ति दृढधन्विनः ।\nन शक्नुवन्त्यवस्थातुं पीड्यमानाः शरार्चिषा\t॥४४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 47}, {"id": 2165016, "chapter_id": 4554, "verse_number": "४५", "content_sanskrit": "निशीथे सूतपुत्रेण शरवर्षेण पीडिताः ।\nएते द्रवन्ति पाञ्चालाः सिंहस्येव भयान्मृगाः\t॥४५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 48}, {"id": 2165017, "chapter_id": 4554, "verse_number": "४६", "content_sanskrit": "एतस्यैवं प्रवृद्धस्य सूतपुत्रस्य संयुगे ।\nनिषेद्धा विद्यते नान्यस्त्वदृते भीमविक्रम\t॥४६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 49}, {"id": 2165018, "chapter_id": 4554, "verse_number": "४७", "content_sanskrit": "स त्वं कुरु महाबाहो कर्म युक्तमिहात्मनः ।\nमातुलानां पितॄणां च तेजसोऽस्त्रबलस्य च\t॥४७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 50}, {"id": 2165019, "chapter_id": 4554, "verse_number": "४८", "content_sanskrit": "एतदर्थं हि हैडिम्ब पुत्रानिच्छन्ति मानवाः ।\nकथं नस्तारयेद्दुःखात् स त्वं तारय बान्धवान्\t॥४८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 51}, {"id": 2165020, "chapter_id": 4554, "verse_number": "४९", "content_sanskrit": "तव ह्यस्त्रबलं भीमं मायाश्च तव दुस्तराः ।\nसङ्ग्रामे युद्ध्यमानस्य सततं भीमनन्दन\t॥४९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 52}, {"id": 2165021, "chapter_id": 4554, "verse_number": "५०", "content_sanskrit": "पाण्डवानां प्रभग्नानां कर्णेन शितसायकैः ।\nमज्जतां धार्तराष्ट्रेषु भव पारं परन्तप\t॥५०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 53}, {"id": 2165022, "chapter_id": 4554, "verse_number": "५१", "content_sanskrit": "रात्रौ हि राक्षसा भूयो भवन्त्यमितविक्रमाः ।\nबलवन्तः सुदुर्धर्षाः शूरा विक्रान्तचारिणः\t॥५१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 54}, {"id": 2165023, "chapter_id": 4554, "verse_number": "५२", "content_sanskrit": "जहि कर्णं महेष्वासं निशीथे मायया रणे ।\nपार्था द्रोणं वधिष्यन्ति धृष्टद्युम्नपुरोगमाः\t॥५२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 55}, {"id": 2165024, "chapter_id": 4554, "verse_number": "५३", "content_sanskrit": "केशवस्य वचः श्रुत्वा बीभत्सुरपि राक्षसम् ।\nअभ्यभाषत कौरव्य घटोत्कचमरिन्दमम्\t॥५३॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 56}, {"id": 2165025, "chapter_id": 4554, "verse_number": "५४", "content_sanskrit": "घटोत्कच भवांश्चैव दीर्घबाहुश्च सात्यकिः ।\nमतौ मे सर्वसैन्येषु भीमसेनश्च पाण्डवः\t॥५४॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 57}, {"id": 2165026, "chapter_id": 4554, "verse_number": "५५", "content_sanskrit": "स भवान् यातु कर्णेन द्वैरथं युद्ध्यतां निशि ।\nसात्यकिः पृष्ठगोपस्ते भविष्यति महारथः\t॥५५॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 58}, {"id": 2165027, "chapter_id": 4554, "verse_number": "५६", "content_sanskrit": "जहि कर्णं रणे शूरं सात्वतेन सहायवान् ।\nयथेन्द्रस्तारकं पूर्वं स्कन्देन सह जघ्निवान्\t॥५६॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 59}, {"id": 2165028, "chapter_id": 4554, "verse_number": "", "content_sanskrit": "घटोत्कचः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 60}, {"id": 2165029, "chapter_id": 4554, "verse_number": "५७", "content_sanskrit": "अलमेवास्मि कर्णाय द्रोणायालं च सत्तम ।\nअन्येषां क्षत्रियाणां च कृतास्त्राणां महात्मनाम्\t॥५७॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 61}, {"id": 2165030, "chapter_id": 4554, "verse_number": "५८", "content_sanskrit": "अद्य दास्यामि सङ्ग्रामं सूतपुत्राय तं निशि ।\nयं जनाः सम्प्रवक्ष्यन्ति यावद् भूमिर्धरिष्यति\t॥५८॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 62}, {"id": 2165031, "chapter_id": 4554, "verse_number": "५९", "content_sanskrit": "न चात्र शूरान् मोक्ष्यामि न भीतान्न कृताञ्जलीन् ।\nसर्वानेव वधिष्यामि राक्षसं धर्ममास्थितः\t॥५९॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 63}, {"id": 2165032, "chapter_id": 4554, "verse_number": "", "content_sanskrit": "सञ्जयः", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 64}, {"id": 2165033, "chapter_id": 4554, "verse_number": "६०", "content_sanskrit": "एवमुक्त्वा महाबाहुर्हैडिम्बः परवीरहा ।\nअभ्ययात् तुमुले कर्णं तव सैन्यं विभीषयन्\t॥६०॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 65}, {"id": 2165034, "chapter_id": 4554, "verse_number": "६१", "content_sanskrit": "तमापतन्तं सङ्क्रुद्धं दीप्तास्यमिव पन्नगम् ।\nअभ्यस्यन् परमेष्वासः प्रतिजग्राह सूतजः\t॥६१॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 66}, {"id": 2165035, "chapter_id": 4554, "verse_number": "६२", "content_sanskrit": "तयोः समभवद् युद्धं कर्णराक्षसयोर्निशि ।\nगर्जतो राजशार्दूल शक्रप्रह्रादयोरिव\t॥६२॥", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 67}, {"id": 2165036, "chapter_id": 4554, "verse_number": "समाप्तिः", "content_sanskrit": "इति श्रीमहाभारते शतसहस्रिकायां संहितायां वैयासिक्यां\nद्रोणपर्वणि एकोनषष्ट्यधिकशततमोऽध्यायः ॥ १५९ ॥\nघटोत्कचवधपर्वणि षड्विंशोऽध्यायः ॥ २६ ॥\n––०––", "padaccheda": "", "anvaya": "", "meaning_sanskrit": "", "meaning_english": "", "audio_url": null, "display_order": 68}]